extension ProgramSignatures
	function sweptLayoutDeclaredAt(site ConformanceClauseDeclSite) returns StructLayout throws MapError
		let layout = self.ownLayoutAtSlot(try self.structSlots.get(site.declName))

		if not layout.declFilePath.equals(site.path) 'theRegistryHoldsAnotherDeclaration'
			throw MapError.keyNotFound
		end 'theRegistryHoldsAnotherDeclaration'

		return layout
	end 'sweptLayoutDeclaredAt'

	// ⭐⭐ **THE DECLARED-CONFORMANCE INDEX AS THIS PHASE CAN SEE IT — the same map `ConformanceCheck` builds,
	// from the only store that exists this early.** `declaredConformanceIndex(project)` reads
	// `project.conformances`, which the REAL PARSE fills; a CONDITIONAL extension's `where` clause has to be
	// decided inside `queryProgramSignatures`, before any file is parsed, so this reads the sweep's own column
	// on both declaration kinds (`StructLayout.conformsTo`, `EnumLayout.conformsTo`) instead, and
	// `typeExtensionConformances` for the unconditional `implements` of an extension of a type or primitive
	// (an enum's or union's extension `implements` is in its `EnumLayout.conformsTo`). It is the
	// roster a `where T is I` verdict is decided against, so a kind missing from it is a kind that conforms
	// nowhere this early. Two STORES of the declarations, at two moments — but one map type
	// and one predicate (`typeConformsTo`), so what "conforms" MEANS is stated once.
	//
	// Memoized for `declaredConformanceIndex`'s reason: a conditional extension asks it once per conformer per
	// constraint, and rebuilding per question would be O(questions x declarations).
	export function sweptConformanceIndex() returns DeclaredConformanceMap
		if self.settledDeclarations().sweptConformancesBuilt 'alreadyBuilt'
			return self.settledDeclarations().sweptConformances
		end 'alreadyBuilt'

		let declared = self.clauseConformanceIndex()

		for (typeName, extensionInterfaces) in self.settledDeclarations().typeExtensionConformances 'eachTypeExtensionConformer'
			let interfaces = InterfaceNameSet.create()
			copyDeclaredInterfaces(declared, typeName: typeName, into: interfaces)

			for interfaceName in extensionInterfaces 'eachInterface'
				interfaces.insert(interfaceName)
			end 'eachInterface'

			declared.upsert(typeName, value: interfaces)
		end 'eachTypeExtensionConformer'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.sweptConformances = declared
		ownDeclarations.sweptConformancesBuilt = true
		return declared
	end 'sweptConformanceIndex'

	function declaresAnyInterface(typeName ByteArray) returns bool
		return self.sweptConformanceIndex().contains(typeName)
	end 'declaresAnyInterface'

	function clauseConformanceIndex() returns DeclaredConformanceMap
		let declared = DeclaredConformanceMap.create()

		for name in self.settledDeclarations().structNamesInDeclOrder 'eachDeclaredType'
			let layout = try self.registeredLayout(name) otherwise panic("ProgramSignatures.clauseConformanceIndex: `structNamesInDeclOrder` holds '{String.from(name)}' with no entry in `structTypes` — `recordStruct` writes both in one act")
			recordSweptConformances(declared, name: name, conformsTo: layout.conformsTo)
		end 'eachDeclaredType'

		for (enumName, enumLayout) in self.settledDeclarations().enumTypes 'eachDeclaredEnum'
			recordSweptConformances(declared, name: enumName, conformsTo: enumLayout.conformsTo)
		end 'eachDeclaredEnum'

		return declared
	end 'clauseConformanceIndex'

	// ⭐⭐ **FILE ONE `extension <T> implements <I…>` AGAINST ONE CONFORMER.** Written by
	// `Parser.foldExtensionDeclarationInto` for every conformer of every extension that declares a
	// conformance — the same (conformer, interfaces) pairs `Parser.recordExtensionConformance` will later put
	// into `project.conformances`, minus the per-conformer `where` verdict, which is what makes this a
	// SUPERSET rather than a copy. See `extensionDeclaredConformances` for why the superset is the direction
	// its one reader needs.
	export function recordExtensionDeclaredConformances(conformer ByteArray, declares InterfaceConformanceArray)
		if declares.isEmpty() 'declaresNoConformance'
			return
		end 'declaresNoConformance'

		self.mainThreadSettled().extensionDeclaredConformances.upsert(conformer, value: interfaceNamesDeclaredBy(self.settledDeclarations().extensionDeclaredConformances, conformer: conformer, declares: declares))
		self.mixExtensionConformance(conformer, names: conformanceInterfaceNames(declares))
		self.mainThreadSettled().conformerIndex.forgetExtensionConformers()
	end 'recordExtensionDeclaredConformances'

	// An enum's or union's names join its own `conformsTo`, so every reader of that column sees them. A
	// `type`'s `conformsTo` is paired by index with `conformanceBindings`, so a type's or primitive's names go
	// to `typeExtensionConformances` instead.
	export function recordConformancesOfATypeExtension(conformer ByteArray, declares InterfaceConformanceArray)
		if declares.isEmpty() 'declaresNoConformance'
			return
		end 'declaresNoConformance'

		let names = conformanceInterfaceNames(declares)

		self.mixExtensionConformance(conformer, names: names)
		self.forgetConformanceMemos()

		let registered = try self.mainThreadSettled().enumTypes.get(conformer) otherwise 'aTypeOrPrimitive'
			self.mainThreadSettled().typeExtensionConformances.upsert(conformer, value: interfaceNamesDeclaredBy(self.settledDeclarations().typeExtensionConformances, conformer: conformer, declares: declares))
			return
		end 'aTypeOrPrimitive'

		let enumLayout = registered.clone()
		enumLayout.recordConformances(namesNotYetDeclared(enumLayout.conformsTo, extra: names))
		fileEnumLayout(self.mainThreadSettled().enumTypes, layout: enumLayout)
	end 'recordConformancesOfATypeExtension'

	// An extension's `implements` moves no name and no value, so this mix is what carries an edit of it to
	// the reader's parse memo.
	function mixExtensionConformance(conformer ByteArray, names NameRoster)
		self.hash = mixDeclaredConformances(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeExtensionConformance), bytes: conformer), conformsTo: names, shape: SignatureDiscriminator.declShapeExtensionConformance)
	end 'mixExtensionConformance'

	function forgetConformanceMemos()
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.sweptConformancesBuilt = false
		ownDeclarations.conformerIndex = DeclaredConformerIndex.unbuilt()
	end 'forgetConformanceMemos'

	// ⭐⭐ **WHAT AN `extension <Name>` IS AN EXTENSION *OF* — the one place the two doors part company**
	// (conditional extensions). Both halves of the mechanism ask it and neither may decide for itself: the
	// fold publishes signatures against this answer and the real parse emits bodies against it.
	//
	// An interface and a type may not share a name (`checkTypeSymbolNamespace`, E3006), so the two arms are
	// mutually exclusive and the order they are asked in cannot matter. The type arm is asked first only
	// because `structSlots` is the cheaper lookup.
	export function extensionTargetOf(targetName ByteArray) returns ExtensionTarget
		if let target = try self.typeExtensionTargetOf(targetName) 'aTypeOrPrimitive'
			return target
		end 'aTypeOrPrimitive'

		match lookupInterface(self.settledDeclarations().interfaces, name: targetName) 'iface'
			found(iface) then return ExtensionTarget.interfaceExtension(iface.associatedTypeNames, conformers: self.declaredConformerIndex().structConformersOf(targetName))
			notFound then return ExtensionTarget.undeclaredTarget
		end 'iface'
	end 'extensionTargetOf'

	export function typeExtensionTargetOf(targetName ByteArray) returns ExtensionTarget throws AbsentError
		// ⭐⭐ **A PRIMITIVE IS ITS OWN SOLE CONFORMER — the same answer a non-generic declared `type` gets one
		// arm down, and deliberately the SAME union case rather than a fourth one.** Everything that
		// reads an extension target asks it for two things and only two: `extensionTargetConformers` (which
		// types get the methods) and `extensionTargetParamNames` (what vocabulary the `where` clause may name).
		// A primitive answers both exactly as a non-generic type does — itself, and nothing — so a case of its
		// own would be a fourth arm at every one of those readers whose body is `typeExtension`'s, plus a third
		// arm at `extensionConformerVerdict`, `noteTypeExtensionWitnessConstraints` and
		// `openExtensionBodyScope`. The departure a new case would BUY is nowhere.
		//
		// ⚠ **THE `typeExtension` PATH IS THE ONE THAT REACHES NO `StructLayout` LOOKUP, WHICH IS WHY THIS IS
		// SOUND AND THE INTERFACE PATH WOULD NOT BE.** `Parser.conformerAssociatedBindings` PANICS on a
		// conformer `structOf` misses, and it is reached only from the `interfaceExtension` arms of
		// `openExtensionBodyScope` and `extensionConformerVerdict`; both return before it for a
		// `typeExtension`. The two lookups this arm's conformer DOES reach —
		// `typeExtensionWitnessConstraints` and `structDeclaresTypeParams` — both answer an undeclared name
		// with the shared empty / `false` by construction.
		//
		// ⭐⭐ **AND ARM ORDERING IS THE WEAKER OF THE TWO GUARANTEES — THE STRONGER ONE IS THAT A PRIMITIVE
		// CANNOT BE AN INTERFACE CONFORMER AT ALL, which is worth stating because the
		// paragraph above would go stale the day someone reorders those arms.**
		// `DeclaredConformerIndex.structConformersOf` is grouped from `structNamesInDeclOrder` alone, so
		// `int` is not in any interface's conformer set and `conformerAssociatedBindings` is never handed
		// one however the arms are asked. ⇒ an `extension <SomeInterface>` publishes NOTHING onto a
		// primitive, even one whose `extension int implements <SomeInterface>` was accepted here — the
		// call is a clean `E2015 'int' has no method named …`, never a wrong answer. That is the same
		// documented gap `structConformersOf`'s own ⚠ grants `enum` and `union`, and it is a REFUSAL, so
		// it is a capability that is absent rather than half-built.
		// ⚠ **ASKED FIRST, AND NOTHING CAN SHADOW IT, BECAUSE THE THREE NAMES ARE KEYWORDS** (`KeywordTable`):
		// no declaration can bind `int`, `float` or `bool`, so there is no struct and no interface for this to
		// pre-empt. `byte` is an ordinary identifier and is NOT in this table (`primitiveTagOfTypeName` states
		// why), so a user's `type byte` still resolves through the struct arm below.
		if primitiveTagOfTypeName(targetName) != ValueTypeTag.unresolved 'aPrimitive'
			return ExtensionTarget.typeExtension(freeze NameRoster.create(0), conformers: rosterOfOneName(targetName))
		end 'aPrimitive'

		if let layout = try self.registeredLayout(targetName) 'aDeclaredType'
			return ExtensionTarget.typeExtension(layout.typeParamNames, conformers: rosterOfOneName(targetName))
		end 'aDeclaredType'

		if self.containsEnumInAnyFile(targetName) 'anEnumOrUnion'
			return ExtensionTarget.typeExtension(freeze NameRoster.create(0), conformers: rosterOfOneName(targetName))
		end 'anEnumOrUnion'

		throw AbsentError.absent
	end 'typeExtensionTargetOf'

	// The `where` constraints declared on `typeName`, in source order — the witness-slot
	// order. Empty for a non-generic, unconstrained, or undeclared type. Read by the E3017 instantiation
	// check (does each concrete argument conform?) and the witness lowering (which interface / concrete type
	// each hidden witness parameter carries).
	//
	// An undeclared type answers the SHARED empty rather than a fresh one: this sits on the per-call-site path
	// that decides whether to append witness arguments (`witnessConstraintsOfMethod`), where the answer for
	// almost every call in a program is "none".
	export function structWhereConstraints(typeName ByteArray) returns WhereConstraintArray
		let layout = try self.registeredLayout(typeName) otherwise return WhereConstraintArray.create(0)
		return layout.whereConstraints
	end 'structWhereConstraints'

	export function structRegionBounds(typeName ByteArray) returns RegionBoundArray
		let layout = try self.registeredLayout(typeName) otherwise return RegionBoundArray.create(0)
		return layout.regionBounds
	end 'structRegionBounds'

	// The `uses` parameter names of a declared type, in declaration order — the list a `typeParameter` token
	// is resolved against. Read by `Parser.scanFixedElementCountNeedsInto`, which scans an EXTENSION body in its
	// TARGET's scope and so has no `uses` clause of its own to parse. An undeclared name answers the SHARED
	// empty, which is also what a non-generic type's layout already holds.
	export function structTypeParamsOf(typeName ByteArray) returns immutable NameRoster
		let layout = try self.registeredLayout(typeName) otherwise return freeze NameRoster.create(0)
		return layout.typeParamNames
	end 'structTypeParamsOf'

	// ⭐ **DOES `typeName` DECLARE TYPE PARAMETERS — i.e. is it GENERIC?** The whole-program form of the
	// question `Parser.openTypeParamScope` answers locally, for an asker that holds a name rather than a
	// layout. An UNDECLARED name answers `false`.
	export function structDeclaresTypeParams(typeName ByteArray) returns bool
		let layout = try self.registeredLayout(typeName) otherwise return false
		return not layout.typeParamNames.isEmpty()
	end 'structDeclaresTypeParams'

	export function hasNoInstanceToTakeHiddenArgumentsFrom(callee ByteArray, takesReceiver bool) returns bool
		return not takesReceiver and not self.calleeReturnsItsDeclaringType(callee)
	end 'hasNoInstanceToTakeHiddenArgumentsFrom'

	// ⭐⭐ **DOES `callee` CARRY THE HIDDEN FIXED-ELEMENT-COUNT PARAMETER?** — asked of the solved count
	// fixpoint under the qualified `Type.method` key, by both sides of the ABI.
	export function functionReadsFixedElementCount(callee ByteArray) returns bool
		return self.nameIsInNeedSet(self.settledDeclarations().fixedElementCountNeeds, callee: callee)
	end 'functionReadsFixedElementCount'

	// The sets are keyed by the declared `Type.method`, and a callee asked under a minted name (`mintedName`'s
	// `#` join) retries its base name: every such name shares its base's answer, at both ends of the ABI.
	function nameIsInNeedSet(needs DescriptorNeedNameSet, callee ByteArray) returns bool
		if needs.count() == 0 'nothingIsNeeded'
			return false
		end 'nothingIsNeeded'

		return needs.contains(callee) or needs.contains(genericTemplateName(callee))
	end 'nameIsInNeedSet'

	// Does ANY method in the whole program read a fixed element count — the allocation-free gate
	// `parseFunction` opens with, because asking the question itself needs the qualified name built.
	export function anyFunctionReadsFixedElementCount() returns bool
		return self.settledDeclarations().fixedElementCountNeeds.count() != 0
	end 'anyFunctionReadsFixedElementCount'

	export function recordFixedElementCountNeeds(needs DescriptorNeedNameSet)
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.fixedElementCountNeeds = needs
	end 'recordFixedElementCountNeeds'

	// ⭐⭐ **THE WITNESS CONSTRAINTS THE INSTANCE METHOD `callee` CARRIES — the ONE answer both the reservation
	// side and the supply side of the dictionary-passing ABI resolve a callee by.** Its enclosing type's own
	// `where` clause, UNIONED with the clause a TYPE EXTENSION added, in that order. Asked with the qualified
	// `Type.method` name.
	//
	// ⛔⛔ **THE EXTENSION'S CLAUSE MAY NOT *REPLACE* THE TYPE'S. THAT IS NOT SAFE "BY CONSTRUCTION" — IT IS
	// SAFE ONLY WHERE THE EXTENSION'S CLAUSE HAPPENS TO CONTAIN
	// THE TYPE'S**, and the two shapes that break it are the two the corpus does not write:
	//   • an UNCONDITIONAL `extension Pair` on a `where`-constrained type chooses the EMPTY clause, so the body
	//     reserves 0 witness slots while every caller passes 2 — **MEASURED: compiles clean, 2,646 bytes, and
	//     the binary access-violates after its first line of output**;
	//   • a clause DISJOINT from the type's (`extension Pair where A is Comparable`) reserves 1 where the body's
	//     own callee wants 2 — **MEASURED: `panic at RegisterAllocator.maxon:1906, colorOpForward: use of
	//     value 3 before it was colored`**, a compiler crash whose cause is nowhere near the allocator.
	// A witness-slot count is ABI, so a reservation and a supply that disagree is an argument-register
	// mismatch and not a type error: nothing downstream can notice.
	//
	// ⭐ **THE TWO CLAUSES ARE UNIONED, NEVER REPLACED.** The enclosing type's constraints are
	// collected unconditionally and the extension's are appended, de-duplicated.
	//
	// ⭐⭐ **AND THE UNION IS TAKEN IN ONE PLACE THAT BOTH SIDES CALL** (`typeExtensionWitnessConstraints`),
	// never computed a second time at the reservation door — the same fact derived twice is the defect this
	// replaced, not the cure for it. See that function for the order argument and for why it is
	// declaration-order independent.
	//
	// ⛔⛔ **THE EXTENSION CLAUSE IS A PARAMETER BECAUSE ITS SOURCE DEPENDS ON WHICH NAME THE ASKER HOLDS,
	// AND READING IT HERE OFF THE CALLEE IS A SEGFAULT.** `extensionMethodConstraints` is keyed by the DECLARED
	// `<Conformer>.<method>`; `FuncSignature.extensionConstraints` owns the rule.
	//
	// ⇒ each asker states where its clause came from, and there are exactly two honest sources:
	//   • **the PARSE-TIME gates**, which hold the BARE name deliberately (a call is dispatched before its
	//     arguments are read) ⇒ `extensionMethodConstraintsOf(callee)`, the declaration sweep's answer;
	//   • **everything after the merge**, which holds a REGISTRATION name ⇒ that name's own
	//     `FuncSignature.extensionConstraints`, recorded by the parse that minted the name.
	export function witnessConstraintsOfMethod(callee ByteArray, extensionConstraints WhereConstraintArray) returns WhereConstraintArray
		return match self.functionDeclaringType(callee) 'declaring'
			method(typeName) gives self.typeExtensionWitnessConstraints(typeName, extensionConstraints: extensionConstraints)
			freeFunction or
			undeclared gives WhereConstraintArray.create(0)
		end 'declaring'
	end 'witnessConstraintsOfMethod'

	// ⭐⭐ **THE WITNESS-SLOT LIST OF A TYPE `typeName` WHOSE METHOD ALSO CARRIES THE EXTENSION CLAUSE
	// `extensionConstraints` — the ONE derived list the RESERVATION side and the SUPPLY side of the
	// dictionary-passing ABI both read.** `Parser.openTypeExtensionBodyScope` opens the body with it (so
	// `witnessReserveFor` reserves exactly these slots) and `witnessConstraintsOfMethod` answers with it (so
	// `LowerMaxonToStd.appendWitnessArgs` fills exactly these slots). Both hand it the SAME two inputs — the
	// extension's target type, and the extension's own clause as `noteTypeExtensionWitnessConstraints` filed it
	// — so the two lists are not merely equal, they are one call.
	//
	// ⭐ **THE TYPE'S OWN CONSTRAINTS COME FIRST, IN DECLARATION ORDER, AND THAT ORDER IS LOAD-BEARING.** A
	// PLAIN method of the type carries exactly the type's list, so the type's list must be a PREFIX of an
	// extension method's — that is precisely the premise `LowerMaxonToStd.forwardCallerWitness` rests on when
	// an extension body drives another method on `self` and forwards slot `i` to slot `i`. Appending the extras
	// after is the only order that makes every such prefix align by construction rather than by luck. (It was
	// luck: with the extension's own source order chosen, `extension Pair where A is Equatable and Comparable,
	// B is Equatable` handed its callee the `A is Comparable` table where `B is Equatable` belonged, and the
	// program was green only because it never followed slot 1.)
	//
	// ⭐ **DE-DUPLICATED AGAINST WHAT IS ALREADY RESERVED**, so an extension that restates one of the type's own
	// constraints — the shape the replace-rule was accidentally right for — reserves one slot for it and not
	// two. The scan is against the list being BUILT rather than against the type's alone, so a clause that
	// repeats itself cannot reserve a slot twice either.
	//
	// ⚠ **IT IS ORDER-INDEPENDENT BECAUSE OF WHERE IT IS ASKED FROM, NOT BECAUSE OF A FALLBACK.** Both callers
	// run after `ProgramSignatures.allFilesFolded`: an extension's header is read by
	// `Queries.foldExtensionDeclarations`, which waits for every file's declarations for its own older reason
	// (`extensionTargetOf` cannot say what `extension Pair` even extends until `Pair` is folded), and the real
	// parse runs later still. So `structWhereConstraints` is complete at both doors and an `extension` written
	// ABOVE the `type` it extends reserves the same slots as one written below. There is deliberately no
	// "type's clause not available yet" arm: it would be the second source of truth this function exists to
	// remove.
	//
	// The unconditional arm returns the type's own array rather than a copy of it — the answer for every method
	// in a program that declares no conditional extension, which is the whole corpus but one spec.
	export function typeExtensionWitnessConstraints(typeName ByteArray, extensionConstraints WhereConstraintArray) returns WhereConstraintArray
		let declared = self.structWhereConstraints(typeName)

		if extensionConstraints.isEmpty() 'unconditional'
			return declared
		end 'unconditional'

		let reserved = WhereConstraintArray.create(declared.count() + extensionConstraints.count(), zeroed: false)
		reserved.append(declared)

		for constraint in extensionConstraints 'eachExtra'
			if whereConstraintListReserves(reserved, constraint: constraint) 'alreadyReserved'
				continue
			end 'alreadyReserved'

			reserved.push(constraint)
		end 'eachExtra'

		return reserved
	end 'typeExtensionWitnessConstraints'

	// ⭐ The constraints `callee` carries that came from a conditional TYPE EXTENSION rather than from its
	// type's own declaration — empty for every other method. The same map read as above, asked a DIFFERENT
	// question and separated for a reason: a type's own `where` constraints are validated at the
	// INSTANTIATION site (E3017, `checkWhereConstraints`), so by the time a call is typed there is nothing
	// left to check about them. An extension's are validated nowhere — the extension is CONDITIONAL, so an
	// instance that fails them is perfectly legal and merely does not have the method — which makes the CALL
	// the only place the question can be asked. See `Parser.requireReceiverSatisfiesExtensionConstraints`.
	export function extensionMethodConstraintsOf(callee ByteArray) returns WhereConstraintArray
		let constraints = try self.settledDeclarations().extensionMethodConstraints.get(callee) otherwise return WhereConstraintArray.create(0)
		return constraints
	end 'extensionMethodConstraintsOf'

	// File the witness constraints of one TYPE-extension method, and the SIGNATURE it was published with, in
	// one act — see `ExtensionMethodConstraintMap`.
	export function recordExtensionMethodConstraints(callee ByteArray, constraints WhereConstraintArray)
		self.mainThreadSettled().extensionMethodConstraints.upsert(callee, value: constraints)
	end 'recordExtensionMethodConstraints'

	// ⭐ **THE `where` CLAUSE A CONDITIONAL TYPE EXTENSION'S REFUSAL QUOTES**, rendered against the OWNER
	// type's own `uses` list — which is the list a `WhereConstraint.typeParamIndex` is a position in. Written
	// here rather than at a refusal site because every raiser of `conditionalExtensionWithheld`
	// (`Parser.requireReceiverSatisfiesExtensionConstraints` among them) quotes the same sentence about the
	// same clause, and a second spelling of the lookup is a second chance to render a different one.
	//
	// A type carrying constraints but absent from the struct registry is unreachable: the constraints were
	// filed under a method OF that type (`Parser.noteTypeExtensionWitnessConstraints`).
	export function renderExtensionClause(typeName ByteArray, constraints WhereConstraintArray) returns String
		match self.structInAnyFile(typeName) 'layout'
			declared(layout) then return renderWhereConstraints(constraints, paramNames: layout.typeParamNames)
			undeclared then panic("ProgramSignatures.renderExtensionClause: '{String.from(typeName)}' carries conditional-extension constraints but is in no struct registry — the constraints were filed under a method of that type")
		end 'layout'
	end 'renderExtensionClause'

	// File one conditional extension method withheld from one conformer — see `ConditionalExtensionSkip`.
	// FIRST-WINS: two extensions withholding a same-named method from one type leave the first reason, which
	// is the one whose `where` clause the author reads first going down the file.
	export function recordConditionalExtensionSkip(callee ByteArray, skip ConditionalExtensionSkip)
		if self.mainThreadSettled().conditionalExtensionSkips.contains(callee) 'alreadyExplained'
			return
		end 'alreadyExplained'

		self.mainThreadSettled().conditionalExtensionSkips.upsert(callee, value: skip)
	end 'recordConditionalExtensionSkip'

	// Why `callee` does not exist, when the reason is that a conditional extension withheld it. `none` for
	// every other missing method, which is the overwhelming majority — an ordinary typo.
	export function conditionalExtensionSkipOf(callee ByteArray) returns ConditionalExtensionSkipLookup
		if let skip = try self.settledDeclarations().conditionalExtensionSkips.get(callee) 'withheld'
			return ConditionalExtensionSkipLookup.withheld(skip)
		end 'withheld'

		return ConditionalExtensionSkipLookup.notWithheld
	end 'conditionalExtensionSkipOf'

	// Every `Base with Args` instantiation site with its source anchor — the list the E3017
	// where-constraint check walks. A constraint-free base's sites are cheaply skipped (its `whereConstraints`
	// is empty), so this is the whole instantiation set, not a pre-filtered one.
	export function instantiationSites() returns GenericInstantiationSiteArray
		return self.settledDeclarations().genericAliasSites
	end 'instantiationSites'

	export function genericWithSites() returns GenericWithSiteArray
		return self.settledDeclarations().genericWithSites
	end 'genericWithSites'

	// ⭐⭐ **THE INSTANTIATIONS A TOP-LEVEL LITERAL INFERRED — the THIRD list `checkWhereConstraints` walks.**
	// A `var m = [k: v]` interns a real `Map with (K, V)` from its first pair, with a real source position and
	// no type name anywhere in the program: the token SWEEP reads `typealias` declarations and cannot see one,
	// and `Project.inferredInstantiationSites` cannot hold it either, because an initializer parse is a
	// THROWAWAY `Parser` (`probeRecordInitializer`) whose artifact is never committed. So it is recorded here,
	// on the index that parse already holds, and read by the same one loop over the same one rule.
	//
	// ⚠ **THE ORDERING IS WHAT MAKES THIS SOUND, and it is stated by `managedGlobals`' own panic:**
	// *"`evaluateInitializers` runs to completion inside `queryProgramSignatures`"* — which `Compiler.maxon`
	// runs at its line 304, where `checkWhereConstraints` is at 350. Every top-level initializer is therefore
	// walked, and every site it infers recorded, strictly before the check reads them.
	export function constInferredInstantiationSites() returns GenericInstantiationSiteArray
		return self.settledDeclarations().constLiteralSites
	end 'constInferredInstantiationSites'

	// ⭐⭐ **WHICH ASSOCIATED POSITIONS THIS PROGRAM HOLDS AT AN INTERFACE — one walk of the instantiation
	// sites, with every declaration in and no file yet parsed.**
	//
	// A use site writing `Bag with (Integer, IntegerCursor)`, where `IntegerCursor` denotes an INTERFACE, is
	// not restating a fact the conformances already carry: the conformances say `UpBag` binds `UpCursor` and
	// `DownBag` binds `DownCursor`, and NOTHING in them says the program means to hold those values
	// existentially rather than at one concrete type. That is the one thing a `with` argument genuinely adds,
	// and it is why this is a record where `instanceDenotedType`'s header argues a concrete argument must not
	// be one — a concrete argument is checked against the conformances (E3125), an interface argument
	// DECLARES the position's ABI binding, and the conformers' own bindings are the types widened into it.
	//
	// ⚠ **IT MUST RUN BEFORE THE PARSE, because the parse is what TYPES a dispatch** — a requirement whose
	// result is a held associated type mints an `interfaceRef` result and pairs it with a witness loaded from
	// the receiver's table, and nothing downstream of the parser can retype that. The instantiation sites are
	// complete at the end of the fold (`readGenericInstanceAlias` is the ONE reader of a written
	// `Base with Args`, and it records a site for every one carrying a source anchor), so the answer is
	// whole-program at exactly the moment it is first needed.
	//
	// ⚠ **AFTER `foldInterfaceDeclarations` AND `normalizeSweptInterfaceTypes`**: the first is what fills the
	// interface registry `instanceArgHeldInterfaceName` asks, and the second settles the one spelling every other
	// reader sees. A FIRST-WINS record — two sites naming different interfaces for one position are E3125's
	// to report, which needs the settled answer to compare against, so the settle may not refuse.
	export function settleAssociatedTypeHoldings()
		if self.settledDeclarations().interfaces.entries.count() == 0 'noInterfaceIsDeclared'
			return
		end 'noInterfaceIsDeclared'

		for site in self.settledDeclarations().genericAliasSites 'eachSite'
			self.noteAssociatedTypeHoldings(site.gid)
		end 'eachSite'
	end 'settleAssociatedTypeHoldings'

	// The holdings ONE instantiation site declares. A site over a `type` base declares none, and neither does
	// an argument naming anything but an interface — the overwhelming majority, so both are one test.
	function noteAssociatedTypeHoldings(gid GenericInstanceId)
		let base = self.genericInstanceBaseName(gid)

		match lookupInterface(self.settledDeclarations().interfaces, name: base) 'base'
			notFound then return
			found(iface) then self.noteAssociatedTypeHoldingsOf(gid, base: base, iface: iface)
		end 'base'
	end 'noteAssociatedTypeHoldings'

	// The per-position walk of ONE interface-based site, split from the base test above so the `found` arm is
	// a call rather than a body — the shape every `lookupInterface` reader in this file uses.
	function noteAssociatedTypeHoldingsOf(gid GenericInstanceId, base ByteArray, iface IrInterface)
		// A site may bind FEWER arguments than the interface declares (E3016's to report), so the walk is
		// bounded by both — reading past either would be a slot with no position or a position with no name.
		let bound = self.genericInstanceArgCount(gid)

		for position in 0 upto iface.associatedTypeNames.count() 'eachAssociatedType'
			if position >= bound 'boundNothingHere'
				break
			end 'boundNothingHere'

			if let held = try self.instanceArgHeldInterfaceName(gid, position: position) 'namesAnInterface'
				self.recordAssociatedTypeHolding(base, associatedCount: iface.associatedTypeNames.count(), position: position, heldAt: held)
			end 'namesAnInterface'
		end 'eachAssociatedType'
	end 'noteAssociatedTypeHoldingsOf'

	// File one holding, FIRST-WINS (see `settleAssociatedTypeHoldings` for why this may not refuse). The
	// per-interface row is allocated at its full associated-type WIDTH on first write, so a position that no
	// site holds reads as `unheld` at its own index rather than needing a second, dense numbering — the
	// same argument `witnessAssociatedSlotOffset` makes about the witness table's own slot block.
	// ⚠ **THE ROW IS MUTATED AND THEN STORED, NEVER STORED AND THEN MUTATED.** An `Array` is COPY-ON-WRITE, so
	// a row handed to `upsert` and kept as a local is two owners of one buffer: the very next `set` forks it,
	// and the map keeps the row as it was. MEASURED — the holding was recorded, `associatedTypeHeldAt` found
	// the row, and every position in it was still empty.
	function recordAssociatedTypeHolding(interfaceName ByteArray, associatedCount ElementIndex, position ElementIndex, heldAt ByteArray)
		let row = self.associatedTypeHoldingRow(interfaceName, associatedCount: associatedCount)

		if (try row.get(position) otherwise panic("recordAssociatedTypeHolding: row.get OOB at {position} below width {row.count()} — the row is allocated at the interface's associated-type count and the caller bounds `position` by it")).isHeld() 'alreadySettled'
			return
		end 'alreadySettled'

		try row.set(position, value: AssociatedHolding.heldAt(heldAt)) otherwise panic("recordAssociatedTypeHolding: row.set OOB at {position} below width {row.count()} — the read one line above succeeded at the same index")
		self.mainThreadSettled().associatedTypeHoldings.upsert(interfaceName, value: row)
	end 'recordAssociatedTypeHolding'

	// This interface's row, or a fresh one at its full associated-type WIDTH — see
	// `AssociatedTypeHoldingMap` for why the row is wide rather than dense, and `recordAssociatedTypeHolding`
	// for why a fresh row is NOT filed here.
	function associatedTypeHoldingRow(interfaceName ByteArray, associatedCount ElementIndex) returns AssociatedHoldingArray
		if let existing = try self.mainThreadSettled().associatedTypeHoldings.get(interfaceName) 'alreadyHoldsSomething'
			return existing
		end 'alreadyHoldsSomething'

		let fresh = AssociatedHoldingArray.create(associatedCount, zeroed: false)

		for _ in 0 upto associatedCount 'eachPosition'
			fresh.push(AssociatedHolding.unheld)
		end 'eachPosition'

		return fresh
	end 'associatedTypeHoldingRow'

	// ⭐ **THE INTERFACE A RECORDED TYPE ARGUMENT DENOTES, IN EVERY SPELLING THE SWEEP CAN LEAVE IT IN** —
	// `MapError.keyNotFound` when it denotes none, which is every ordinary type argument.
	//
	// ⚠ **THREE SPELLINGS, AND WHICH ONE ARRIVES IS A FACT ABOUT DECLARATION ORDER RATHER THAN ABOUT THE
	// PROGRAM.** `parseTypeReference` runs during the SWEEP, where the interface registry is still empty, so a
	// bare `Cursor` is left a `named`; an alias `IntegerCursor` whose own declaration was already swept
	// resolves through `instanceDenotedType` and — the registry being empty — arrives as the
	// `genericInstance` over `Cursor` rather than as the existential; and one swept later arrives as a
	// `named` too, to be resolved through the alias registry. Handling only the spelling a test happened to
	// produce would make the feature depend on the order two `typealias` lines were written in.
	// The interface instance `gid`'s argument at `position` denotes; `MapError.keyNotFound` when it denotes
	// none. TWO readers, and one derivation between them: the SETTLE, which records the holding this declares,
	// and E3125, which refuses a second site claiming a different one. Asking two different ways would let a
	// site declare a holding under one reading and be checked against another.
	export function instanceArgHeldInterfaceName(gid GenericInstanceId, position ElementIndex) returns immutable ByteArray throws MapError
		return match try self.heldArgOf(self.substitutedInstanceArg(gid, position: position)) 'denoted'
			instantiated(held) gives self.nameOfId(typeNameIdOf(self.instanceDenotedType(held, into: self.typeNames)))
			bare(name) gives name
		end 'denoted'
	end 'instanceArgHeldInterfaceName'

	// ⭐⭐ **THE SAME ARGUMENT, READ FOR ITS `with` ARGUMENTS RATHER THAN FOR ITS NAME.** A holding is a
	// fact about the interface NAME and that is all E3125 and the settle need; a DISPATCH through the held
	// value needs more, because a requirement returning the held interface's own associated type has to be
	// typed against whatever THIS site bound that position to. `Cursor` alone cannot say what `Element` is;
	// `Cursor with Element` can. `MapError.keyNotFound` for a bare interface name, which genuinely binds
	// nothing. TWO readers: `Parser.associatedReturnThroughReceiverInstance`, which carries the nested
	// arguments onto the held value so a dispatch on it can be typed, and
	// `SemanticCheck.heldPositionNestedClaim`, which is what makes the conformer keep them.
	export function instanceArgHeldInstance(gid GenericInstanceId, position ElementIndex) returns GenericInstanceId throws MapError
		match try self.heldArgOf(self.substitutedInstanceArg(gid, position: position)) 'denoted'
			instantiated(held) then return held
			bare then throw MapError.keyNotFound
		end 'denoted'
	end 'instanceArgHeldInstance'

	// The ONE reading of a recorded type argument that denotes an interface, in every spelling the sweep can
	// leave it in (see the header above) — split from its two askers because they want two different halves of
	// it and a second walk of those three spellings is exactly the declaration-order dependence that header
	// warns about.
	function heldArgOf(arg MaxonType) returns HeldAssociatedArg throws MapError
		if maxonTypeTag(arg) == ValueTypeTag.genericInstance 'anInstanceOverSomeBase'
			let held = genericInstanceIdOf(arg)

			if maxonTypeTag(self.instanceDenotedType(held, into: self.typeNames)) != ValueTypeTag.interfaceRef 'aStructInstance'
				throw MapError.keyNotFound
			end 'aStructInstance'

			return HeldAssociatedArg.instantiated(held)
		end 'anInstanceOverSomeBase'

		if maxonTypeTag(arg) == ValueTypeTag.interfaceRef 'alreadyAnExistential'
			return HeldAssociatedArg.bare(self.nameOfId(typeNameIdOf(arg)))
		end 'alreadyAnExistential'

		// The `named` half is `sweptInterfaceTypeOf`'s exactly — a bare interface name, or an alias whose base
		// is one — and is asked rather than re-written, so a spelling admitted for a struct FIELD and a
		// spelling admitted here cannot come to differ. It runs FIRST so a `named` that denotes no interface at
		// all still leaves by that door's throw; only past it is the written name asked whether it was an
		// ALIAS, which is the half that carries arguments where a bare interface name carries none.
		// ⚠ `CompilerOwnedDeclFilePath`: a held ASSOCIATED type argument is read off an interned INSTANCE, so
		// there is no file that wrote it — the reader with no file (see that constant's header).
		let denotedInterface = try self.sweptInterfaceTypeOf(arg, readerFilePath: CompilerOwnedDeclFilePath)
		let written = self.nameOfId(typeNameIdOf(arg))

		if self.isGenericAliasInAnyFile(written) 'anAliasCarriesArguments'
			return HeldAssociatedArg.instantiated(self.bareGenericAliasInstance(written))
		end 'anAliasCarriesArguments'

		return HeldAssociatedArg.bare(self.nameOfId(typeNameIdOf(denotedInterface)))
	end 'heldArgOf'

	// Does this program hold ANY of `interfaceName`'s associated positions at an interface? The gate on the
	// witness table's associated slot BLOCK, so a program that does not use the feature mints exactly the
	// bytes it always did — and one map probe on a name, with no key to join.
	export function interfaceHoldsAnAssociatedType(interfaceName ByteArray) returns bool
		return self.settledDeclarations().associatedTypeHoldings.contains(interfaceName)
	end 'interfaceHoldsAnAssociatedType'

	// The interface `interfaceName`'s associated type at `position` is held at; `absent` when
	// that position is held at nothing, which is every position of every interface in a program that does not
	// write an interface as a `with` argument.
	export function associatedTypeHeldAt(interfaceName ByteArray, position ElementIndex) returns immutable ByteArray throws AbsentError
		let row = try self.settledDeclarations().associatedTypeHoldings.get(interfaceName) otherwise throw AbsentError.absent

		if position >= row.count() 'pastThisInterfacesPositions'
			throw AbsentError.absent
		end 'pastThisInterfacesPositions'

		let held = try row.get(position) otherwise panic("associatedTypeHeldAt: row.get OOB at {position} below width {row.count()} — the guard above excludes it")

		return try held.interfaceName()
	end 'associatedTypeHeldAt'

	// Built on `associatedTypeHeldAt` so the two cannot disagree.
	//
	// It is NOT `interfaceHoldsAnAssociatedType` with a position bolted on: that one asks whether the interface
	// holds ANY position (the gate on the witness table's whole associated-slot block), and answering it for one
	// position would skip every position of an interface that holds a DIFFERENT one.
	export function associatedTypeIsHeldAt(interfaceName ByteArray, position ElementIndex) returns bool
		try self.associatedTypeHeldAt(interfaceName, position: position) otherwise return false
		return true
	end 'associatedTypeIsHeldAt'

	// The COMPILED name of instance `gid`'s type argument at `position` — `mangleTypeArg`'s
	// answer, so a struct/named arg reads as its bare name and a NESTED instance as its mangled form.
	//
	// ⚠ **IT IS THE `.rdata`-LABEL SPELLING AND ITS ONE CALLER WANTS EXACTLY THAT**: `ParseStaging`'s
	// E3006 pair-collision message, where the compiled join is the SUBJECT of the sentence (see
	// `renderInstantiation`). A diagnostic that names a type argument asks `instanceArgDisplayName`
	// instead, because `Box_Leaf` is a string no source line holds; this one keeps the mint because
	// the mint is what collided.
	export function instanceArgCompiledName(gid GenericInstanceId, position ElementIndex) returns immutable ByteArray
		return freeze self.mangleTypeArg(self.substitutedInstanceArg(gid, position: position)).toByteArray()
	end 'instanceArgCompiledName'

	// ⭐⭐ **HOW A DIAGNOSTIC SPELLS ONE OF AN INSTANCE'S TYPE ARGUMENTS — the display twin of
	// `instanceArgCompiledName`, under the ruling that a diagnostic names a type by the `typealias` the
	// author wrote.**
	// Read by every message that quotes a type argument: the generic call's `expected` side
	// (`SemanticCheck.checkTypeParameterArgsAt`), the E3017 `where`-constraint violation, and the withheld
	// conditional-extension refusal.
	//
	// ⚠ **THE NESTED-INSTANCE ARM IS THE WHOLE DIFFERENCE**, and the rest is not written a second time. Every
	// other arm of the compiled renderer already answers with something an author wrote — a struct or a ranged
	// alias by its own name, a primitive by its keyword — so there is one rule there and it stays in one place.
	// MEASURED without it, on a program declaring `typealias LeafBox = Box with Leaf`:
	// `argument type mismatch for 'v': expected 'Box_Leaf', got 'OtherBox'` — one sentence spelling one of its
	// two types the compiler's way and the other the author's.
	//
	// It DELEGATES rather than re-spelling `mangleTypeArg(arg)`, which costs a second `substitutedInstanceArg`
	// — a bounds-checked array read of an already-built type, on a path that only a REJECTED program reaches.
	// A second copy of the compiled rule for that is the trade this codebase does not make.
	//
	// ⛔⛔ **THE OPAQUE ARM PRINTS THE PARAMETER'S NAME.** `mangleTypeArg` spells a type-parameter argument as
	// its DIGEST — `T5a05ccf53759d5f6` — and its own header says why that is right THERE: it is a lookup key,
	// injective and build-order stable. It is not a type name, and no source line holds it.
	export function instanceArgDisplayName(gid GenericInstanceId, position ElementIndex) returns immutable ByteArray
		let arg = self.substitutedInstanceArg(gid, position: position)

		if maxonTypeTag(arg) == ValueTypeTag.genericInstance 'nestedInstance'
			return self.instanceDisplayName(genericInstanceIdOf(arg))
		end 'nestedInstance'

		if maxonTypeTag(arg) == ValueTypeTag.typeParameter 'opaqueParam'
			let owner = try self.typeParamOwnerOf(typeParamIdOf(arg)) otherwise panic("ProgramSignatures.instanceArgDisplayName: type-parameter token {typeNameIdOf(arg)} has no owner — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds, so a token with none was minted inside a declaration neither fold saw")
			return owner.paramName
		end 'opaqueParam'

		return self.instanceArgCompiledName(gid, position: position)
	end 'instanceArgDisplayName'

	export function instanceArgRequirement(gid GenericInstanceId, position ElementIndex) returns RequirementType
		return self.instanceArgTypeRequirement(self.substitutedInstanceArg(gid, position: position))
	end 'instanceArgRequirement'

	export function instanceArgTypeRequirement(arg MaxonType) returns RequirementType
		if maxonTypeTag(arg) == ValueTypeTag.named and self.isGenericAliasInAnyFile(self.nameOfId(typeNameIdOf(arg))) 'aGenericAliasSpelling'
			return RequirementType.create(RequirementTypeIdentity.genericInstance(self.bareGenericAliasInstance(self.nameOfId(typeNameIdOf(arg)))), brand: EmptySourceText)
		end 'aGenericAliasSpelling'

		return requirementTypeOfDeclared(arg, names: self.typeNames, brand: EmptySourceText)
	end 'instanceArgTypeRequirement'

	// A `nominal` name is completed in the file that declared the requirement or binding, never the reader's:
	// two files may declare one name as two types.
	export function fileCompleteRequirement(requirement RequirementType, declFilePath FilePath) returns RequirementType
		return match requirement.identity 'identity'
			nominal(name) gives RequirementType.create(RequirementTypeIdentity.nominal(self.declaredIdentityOfSpelling(name, declFilePath: declFilePath)), brand: requirement.brand)
			void or
			selfType or
			typeParameter or
			genericInstance or
			builtin gives requirement.clone()
		end 'identity'
	end 'fileCompleteRequirement'

	export function requirementDisplay(requirement RequirementType) returns String
		return match requirement.identity 'identity'
			nominal(name) gives self.aliasIdentityDisplay(name)
			genericInstance(id) gives self.instanceSourceDisplay(id)
			builtin(tag) gives primitiveTypeTagName(tag)
			typeParameter(token) gives String.from(self.requirementTypeParameterName(token))
			void panic("ProgramSignatures.requirementDisplay: a void requirement names no type")
			selfType panic("ProgramSignatures.requirementDisplay: `Self` names the receiver's own type, which only the receiver can say")
		end 'identity'
	end 'requirementDisplay'

	export function conformerNameOfRequirement(binding RequirementType, readerFilePath FilePath) returns immutable ByteArray
		return match binding.identity 'identity'
			nominal(name) gives freeze self.conformerNameOfDeclaredName(name, readerFilePath: readerFilePath).toByteArray()
			genericInstance(id) gives freeze self.conformerNameOfInstanceSpelling(id, spelling: self.canonicalInstanceName(id)).toByteArray()
			builtin(tag) gives freeze primitiveTypeTagName(tag).toByteArray()
			typeParameter(token) gives self.requirementTypeParameterName(token)
			void or
			selfType panic("ProgramSignatures.conformerNameOfRequirement: a conformance binds an associated type to a declared type, never to `void` or `Self`")
		end 'identity'
	end 'conformerNameOfRequirement'

	function requirementTypeParameterName(token TypeParamId) returns immutable ByteArray
		return (try self.typeParamOwnerOf(token) otherwise panic("ProgramSignatures.requirementTypeParameterName: type-parameter token {token} has no owner — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds")).paramName
	end 'requirementTypeParameterName'

	// How many type arguments instance `gid` carries — `Box with String` ⇒ 1, `Pair with (A, B)` ⇒ 2.
	// The BOUND on `instanceArgCompiledName`/`instanceArgDisplayName`/`substitutedInstanceArg`'s `position`,
	// for a reader that walks
	// an instance's whole argument list rather than one constrained parameter of it
	// (`renderInstantiation`, which spells a colliding instantiation back out in source form).
	//
	// ⚠ It is NOT `genericInstanceFieldCount`, which is the BASE STRUCT's field count: the two agree for
	// a plain generic struct and disagree for the builtin bases, where `Array with Integer` has one type
	// argument and no base struct at all (`genericInstanceFieldCount` panics on it).
	export function genericInstanceArgCount(gid GenericInstanceId) returns ElementIndex
		return self.rowArgs(gid).count()
	end 'genericInstanceArgCount'

	export function typeParameterPositionIn(instance GenericInstanceId, declared MaxonType) returns ElementIndex throws AbsentError
		if maxonTypeTag(declared) != ValueTypeTag.typeParameter 'notATypeParameter'
			throw AbsentError.absent
		end 'notATypeParameter'

		let base = self.genericInstanceBaseName(instance)
		return try typeParamPositionIn(typeParamIdOf(declared), declarationName: base, paramNames: self.structTypeParamsOf(base)) otherwise throw AbsentError.absent
	end 'typeParameterPositionIn'

	export function genericInstanceArgQualifier(gid GenericInstanceId, position ElementIndex) returns GenericArgQualifier
		return self.rowShape(gid).argQualifierAt(position)
	end 'genericInstanceArgQualifier'

	export function typeParameterSlotIn(instance GenericInstanceId, declared MaxonType) returns (ElementIndex, GenericArgQualifier) throws AbsentError
		let position = try self.typeParameterPositionIn(instance, declared: declared)
		return (position, self.storedSlotQualifier(instance, position: position))
	end 'typeParameterSlotIn'

	function storedSlotQualifier(gid GenericInstanceId, position ElementIndex) returns GenericArgQualifier
		if position == ContainerElementArgPosition and self.isKeyedContainerBase(self.genericInstanceBaseName(gid)) 'aStoredKey'
			return GenericArgQualifier.frozen
		end 'aStoredKey'

		return self.genericInstanceArgQualifier(gid, position: position)
	end 'storedSlotQualifier'

	function isKeyedContainerBase(baseName ByteArray) returns bool
		return baseName.equals(MapBuiltinBaseName) or baseName.equals(SetBuiltinBaseName)
	end 'isKeyedContainerBase'

	export function typeParameterIsFrozenIn(instance GenericInstanceId, declared MaxonType) returns bool
		let slot = try self.typeParameterSlotIn(instance, declared: declared) otherwise return false
		return slot.1 == GenericArgQualifier.frozen
	end 'typeParameterIsFrozenIn'

	export function declaredReturnTypeOf(callee ByteArray, into TypeNameInterner) returns MaxonReturnType throws AbsentError
		match self.returnTypeOf(callee, into: into) 'callee'
			declared(returnType) then return returnType
			undeclared then throw AbsentError.absent
		end 'callee'
	end 'declaredReturnTypeOf'

	export function declaredValueReturnOf(callee ByteArray, into TypeNameInterner) returns MaxonType throws AbsentError
		let returnType = try self.declaredReturnTypeOf(callee, into: into)
		return try valueTypeOfReturn(returnType)
	end 'declaredValueReturnOf'

	// Library members only: a user member whose declared return is a type parameter may hand back its
	// argument (`echo`) rather than an element, so the declared shape alone would refuse a legal program.
	// `CapabilityCallCheck.handsBackAFrozenSlotElement` answers user members from their body summaries.
	export function storedElementPositionOf(callee ByteArray, instance GenericInstanceId, declared MaxonType) returns ElementIndex throws AbsentError
		let position = try self.typeParameterPositionIn(instance, declared: declared)

		if not self.declaredByTheCorpus(self.declaringFileOf(callee)) 'aMemberTheLibraryDidNotWrite'
			throw AbsentError.absent
		end 'aMemberTheLibraryDidNotWrite'

		return position
	end 'storedElementPositionOf'

	export function iteratedElementQualifier(id GenericInstanceId) returns GenericArgQualifier
		return self.genericInstanceArgQualifier(id, position: MapValueArgPosition if self.genericInstanceBaseName(id).equals(MapBuiltinBaseName) else ContainerElementArgPosition)
	end 'iteratedElementQualifier'

	export function containerElementIsFrozen(id GenericInstanceId) returns bool
		return self.genericInstanceArgQualifier(id, position: ContainerElementArgPosition) == GenericArgQualifier.frozen
	end 'containerElementIsFrozen'

	// Is `name` a declared `type` — the `bool` half of `structOf`, and a HOT-PATH allocation guard, the
	// twin of `containsEnum`. `structOf` returns a `DeclaredStruct`, a Maxon union VALUE that boxes on
	// its `undeclared` case as much as any other, so a caller that only needs "is it a struct?" for the
	// COMMON no answer (`resolveNamedStruct` asks it of every `named` parameter/return type,
	// most of them ranged int aliases) must not pay that box just to throw it away. A `Map.contains`
	// allocates nothing.
	// ⚠⚠ **`InAnyFile` IS A WARNING IN THE NAME.** This registry is keyed by the BARE name and answers
	// for the whole program, so once a `type` in one file and a `typealias` in another may both stand
	// (`typeNamePairMayCoexist`) a bare read claims the name for every file. The reader-aware twin is
	// `containsStructFor`; the suffix is what makes choosing between them a decision the COMPILER
	// forces at every call site instead of one a human list has to remember. Where a caller genuinely
	// has no reading file — the managed classifiers, the drop and clone routers — this spelling is the
	// right one and says so in the source.
	export function containsStructInAnyFile(name ByteArray) returns bool
		return self.hasRegisteredLayout(name)
	end 'containsStructInAnyFile'

	// ⭐⭐ **CAN A VALUE OF `type name` EXIST AT ALL?** — the question a base that is a STRUCT-TYPED SELF-FIELD
	// ALIAS is admitted or refused on (`Parser.structBaseOfReceiver`).
	//
	// Maxon has no `null`, no optional and no partial initialization, so building a struct means supplying a
	// value for EVERY field, and a field of struct type means first building THAT struct. A CYCLE in the
	// struct-typed-field graph is therefore an infinite regress, and nothing on one — or reaching one — can
	// ever exist. `type Node` with `var next as Node` is the one-node case; `A.b as B` with `B.a as A` is the
	// same fact spread over two declarations, and it is not "self-referential" in any way a name comparison
	// could tell apart. That is why this walks the GRAPH rather than asking whether a field's type equals its
	// enclosing type: the two questions agree on the one-node case and part company on every longer one.
	//
	// ⚠ **AN UNDECLARED NAME ANSWERS `false`, AND THE TEST IS WRITTEN HERE, AT THE ENTRY.** It cannot be
	// proven constructible, and this is a gate whose safe direction is refusal. It is the ENTRY's business
	// because it is the only place a name can arrive unvetted: the walk itself only ever recurses into a name
	// it has just proved declared, so the same test inside the recursion would be dead code that reads as a
	// live policy — and deleting the walk's own `hasRegisteredLayout` as "redundant with this one" would
	// silently make every scalar, String and enum field answer `false`.
	//
	// ⚠ **WHAT IT DELIBERATELY DOES NOT CHASE: a type ARGUMENT that closes the cycle** — `var b as Box with
	// Outer` inside `type Outer`, in EITHER of the two spellings such a field arrives in. A directly-tagged
	// `genericInstance` is not an aggregate NAME at all, so the walk's tag guard skips it; a generic ALIAS
	// (`typealias OuterBox = Box with Outer`, `var b as OuterBox`) arrives as a bare `named` — the sweep
	// recorded the field before the alias was interned (`denotesArrayInstance` and `declaredSlotType` both
	// state it) — so it passes the tag guard and is skipped one line later by `hasRegisteredLayout`, which a
	// generic alias's name is not in. Same verdict, different door.
	//
	// The direction is CHOSEN, not overlooked: the other arm of that trade treats every generic-instance
	// field as undecided, which false-REFUSES a base inside any type that merely holds an `IntArray` beside a
	// struct field — a program that runs. Over-admitting here only lets a base compile inside a type nothing
	// can construct, so the code lowered for it is correct and unreachable. It costs a false accept of dead
	// code, never a wrong answer.
	export function structTypeIsConstructible(name ByteArray) returns bool
		if not self.hasRegisteredLayout(name) 'notDeclared'
			return false
		end 'notDeclared'

		return self.structIsConstructibleWithin(name, visiting: StructNameSet.create(), proven: StructNameSet.create())
	end 'structTypeIsConstructible'

	// The walk `structTypeIsConstructible` is. `visiting` holds the types whose own proof is still OPEN, so a
	// name reached while it is in there IS the cycle; `proven` holds the types already proven constructible.
	// Precondition: `name` is a declared struct — every entry into this walk is gated on
	// `hasRegisteredLayout`, at the exported door above and at the field recursion below.
	//
	// ⚠ **`visiting` IS NEVER UNMARKED, AND `proven` IS WHAT MAKES THAT CORRECT rather than merely cheap.** A
	// name is never removed, because the only way a type's proof ends without settling it is the `false` that
	// abandons the whole query — so an unsettled name in `visiting` is always an open chain. `proven` is
	// therefore consulted FIRST: a diamond in the field graph (two fields of one type) re-enters a name that is
	// still in `visiting` from the branch that finished it, and reading that as a cycle would refuse a struct
	// that builds fine. Together they also make the walk linear in the graph rather than once per path into
	// each node.
	//
	// ⚠ **THE TWO SETS ARE A REAL DIFFERENCE FROM `typeSupportsDeepClone`'s ONE**, which walks this same field
	// graph with a single `ClonerSet` and answers `true` on a re-entry: a recursive type IS clonable, because
	// the synthesized cloner recurses at RUN time through the same field. Here a re-entry is the infinite
	// regress itself and must answer `false`, so "in flight" and "proven" cannot share one set.
	//
	// A field's type is classified over `self.typeNames` — the interner a layout's field types were minted
	// against (`structFieldIsManaged`'s discipline) — and through `denotedSlotAggregateName`, so a TUPLE-alias
	// field answers under the tuple's own name exactly as it does for every other classifier that reads a raw
	// layout field type. A slot naming no declared struct forces no construction and is skipped: a scalar, a
	// String, a function, an opaque type parameter and a generic instance all have values that need no further
	// struct to exist.
	function structIsConstructibleWithin(name ByteArray, visiting StructNameSet, proven StructNameSet) returns bool
		if proven.contains(name) 'alreadyProven'
			return true
		end 'alreadyProven'

		if visiting.contains(name) 'closesTheCycle'
			return false
		end 'closesTheCycle'

		let layout = try self.registeredLayout(name) otherwise panic("ProgramSignatures.structIsConstructibleWithin: no `type {String.from(name)}` is declared — `structTypeIsConstructible` gates the entry and the field recursion gates itself on `structTypes.contains`")

		visiting.insert(name)

		for i in 0 upto layout.fieldCount() 'eachField'
			let declared = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.structIsConstructibleWithin: fieldTypes.get OOB at {i} for `type {String.from(name)}`, which declares {layout.fieldCount()}")

			// A field declared with the ENCLOSING type's own name arrives as a `structRef`
			// (`Parser.enclosingSelfType`); every other struct-typed field arrives as a bare `named`, because
			// the declaration SWEEP that recorded it ran before anything could say what the name denoted.
			// Both spellings are one question, so both are asked here.
			if not tagMayNameAggregate(maxonTypeTag(declared)) 'namesNoAggregate'
				continue
			end 'namesNoAggregate'

			// LOAD-BEARING TWICE: it skips the slots that name no struct at all (a ranged alias, an enum, a
			// generic alias), and it is what proves the recursion's precondition.
			let fieldStruct = self.denotedSlotAggregateName(declared)

			if self.hasRegisteredLayout(fieldStruct) and not self.structIsConstructibleWithin(fieldStruct, visiting: visiting, proven: proven) 'fieldCannotBeBuilt'
				return false
			end 'fieldCannotBeBuilt'
		end 'eachField'

		proven.insert(name)
		return true
	end 'structIsConstructibleWithin'

	// The `StringIndex` layout, for the parser's field reads (`slice`'s two byte positions, and the two
	// accessor arms). It PANICS rather than answering when the type is absent, because the declaration it
	// comes from is `stdlib/String.maxon`'s and that module is LISTED unconditionally — so a miss is not a
	// program that happens not to use indices, it is a corpus the loader failed to fold.
	//
	// ⚠ **THERE IS NO `registerStringIndexType`, AND ITS ABSENCE IS THE POINT.** Registering the type would
	// mean walking every token of every file for one of the four producer method names, purely
	// to decide whether to upsert a compiler-owned layout the compiler itself wrote. The corpus declares the
	// type, so the ordinary declaration fold registers it in every program and there is nothing to decide —
	// no probe, no bit, and no second layout.
	export function stringIndexLayoutOrPanic() returns StructLayout
		return try self.registeredLayout(StringIndexTypeName) otherwise panic("ProgramSignatures.stringIndexLayoutOrPanic: `{String.from(StringIndexTypeName)}` is not registered — it is declared by `stdlib/String.maxon`, which `StdlibLoader` loads into every program, so the declaration fold has not run or has dropped it")
	end 'stringIndexLayoutOrPanic'

	// ⭐⭐ **THE ASSERTION `Project.ManagedMemorySlotCount` HAS OWED SINCE THE ENVELOPE COLLAPSE, PAID NOW
	// THAT BOTH DESCRIPTIONS EXIST IN EVERY COMPILE.** That constant's header recorded the debt
	// in so many words: *"the product is not yet checked against the record the runtime reads, because there
	// is nothing to check it against until `stdlib/String.maxon` is listed … the moment a corpus layout is
	// registered under that name, it and `StringRuntime`'s six offsets become two descriptions of one record
	// — and that assertion belongs with the listing"*. Both declaring modules are loaded unconditionally now
	// (`StdlibLoader` takes all of `stdlib/`), so the two descriptions are always both present, and this is
	// what holds them together. It is `managedFileLayout`'s check one type over, with the halves swapped:
	// there the compiler STATES the shape and the runtime writes it, here the CORPUS states it.
	//
	// ⭐ **IT CHECKS THE FIELD *COUNT*, AND THAT IS THE CLAUSE THAT EARNS THE FUNCTION.** The offsets are the
	// obvious half and the easy half; the dangerous half is a field the fused record has NO SLOT FOR.
	// `Parser.emitFusedWrapperLiteral` takes `managed` as its source and `singleByteGraphemesFlag` as its
	// flag and **passes on nothing else** — so a third field added to `type String`, or a second to
	// `type Character`, would be accepted by the parser, discarded at construction, and read back as whatever
	// the record's producer happened to write at its offset. `Parser.requireFusedWrapperTag`'s header carries
	// that defect MEASURED, for conformers of other NAMES: *"`Self{flag: false}` read back TRUE — exit 7 on a
	// program whose only literal wrote `false`, no fault, no leak, no diagnostic"*, with the drop and the
	// clone — both built from the DECLARED field list — then reading past the fused record's end
	// (0xC0000005). That refusal structurally cannot cover `String` and `Character`, because those are
	// exactly the two names it must ADMIT. This is their half of it.
	//
	// ⚠ **A PANIC, NOT A DIAGNOSTIC, AND `Project.requireCorpusDeclaredEnum` IS THE PRECEDENT.** What could
	// make it fire is an edit to a LISTED corpus module, and there is no degraded answer available: the
	// compiler would go on minting a record shape the corpus no longer declares. A user interface named for
	// a literal marker would also fire it, by renaming the library's `implements` away from the name
	// `Project.isBuiltinManagedWrapperInterface` tests; those names are compiler-owned
	// (`TypeResolution.isCompilerOwnedTypeName`) to keep every user program out of it.
	//
	// ⚠ **`Character`'s DECLARED SIZE IS 48 AND THE RECORD IT MINTS IS 56, AND THAT IS EXPLAINED RATHER THAN
	// CHECKED.** `type Character` declares the inline `managed` alone, so the layout's own `sizeBytes()` stops
	// at the whole buffer record, while the record `StringRuntime.emitAllocOwnedInlineString` builds for it is
	// `StringRecordBytes` wide — ONE encoder serves both wrappers and it always writes the flag at `@48`.
	// Nothing reads that slot for a Character, and nothing allocates one from `sizeBytes()`: a fused literal
	// routes to `__str_from_bytes`, never to `emitOwnedStructBox` (MEASURED — `sizeof(Character)` is 8, the
	// pointer a Character value IS, and `sizeof(String)` is `StringRecordBytes` off the byte-record path, so
	// neither reads this size). ⚠ What must hold is the property that MAKES it inert: the field count.
	export function checkFusedWrapperRecordLayouts()
		// `String` — two fields: the inline `managed` occupying the whole buffer record, then the flag at `@48`.
		let string = self.corpusDeclaredFusedWrapper(StringConformerName)
		requireInlineManagedFieldFirst(string)

		if string.fieldCount() != StringDeclaredFieldCount 'stringFieldCount'
			panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(StringConformerName)}` declares {string.fieldCount()} fields and the fused record has slots for {StringDeclaredFieldCount} — `emitFusedWrapperLiteral` passes on `managed` and `{String.from(SingleByteGraphemesFieldName)}` and NOTHING ELSE, so any further field is silently discarded at construction and read back as whatever the record's producer wrote at its offset")
		end 'stringFieldCount'

		let flagIndex = try string.indexOfField(SingleByteGraphemesFieldName) otherwise panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(StringConformerName)}` declares no `{String.from(SingleByteGraphemesFieldName)}` field, so `emitFusedWrapperLiteral` would classify every literal's bytes instead of using the flag the corpus states — the record's slot behind its embedded buffer record IS that field, and the compiler reads the corpus's spelling rather than inventing one")

		if string.offsetOfField(flagIndex) != StringSingleByteGraphemesOffset 'flagOffset'
			panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(StringConformerName)}` puts `{String.from(SingleByteGraphemesFieldName)}` at {string.offsetOfField(flagIndex)} but every producer and reader of the record uses {StringSingleByteGraphemesOffset} — the corpus's declared shape and the record the compiler mints have drifted")
		end 'flagOffset'

		if string.sizeBytes() != StringRecordBytes 'recordSize'
			panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(StringConformerName)}` lays out {string.sizeBytes()} bytes but the record the compiler mints for it is {StringRecordBytes} — the corpus's declared shape and the record the compiler mints have drifted")
		end 'recordSize'

		// `Character` — the inline `managed` alone. See this function's header for why its declared size stops
		// short of the record it mints, and why the FIELD COUNT is what has to hold instead.
		let character = self.corpusDeclaredFusedWrapper(CharacterConformerName)
		requireInlineManagedFieldFirst(character)

		if character.fieldCount() != CharacterDeclaredFieldCount 'characterFieldCount'
			panic("ProgramSignatures.checkFusedWrapperRecordLayouts: `type {String.from(CharacterConformerName)}` declares {character.fieldCount()} fields and the fused record has a slot for {CharacterDeclaredFieldCount} — `emitFusedWrapperLiteral` takes `managed` and passes on nothing else, so any further field is silently discarded at construction")
		end 'characterFieldCount'
	end 'checkFusedWrapperRecordLayouts'

	// The corpus declaration behind one of the two byte records. Absent, this is not a program that happens
	// not to use strings — `StdlibLoader` loads every module under `stdlib/`, both declaring modules
	// included — so what reaches here is that declaration deleted, or its file gone from the checkout.
	// `stringIndexLayoutOrPanic`'s argument, two type names over.
	function corpusDeclaredFusedWrapper(typeName ByteArray) returns StructLayout
		return try self.registeredLayout(typeName) otherwise panic("ProgramSignatures.checkFusedWrapperRecordLayouts: this compile declares no `type {String.from(typeName)}`, and the compiler mints that type's record FROM the corpus's declaration rather than transcribing it — the module declaring it must be present under `stdlib/` and must still declare it")
	end 'corpusDeclaredFusedWrapper'

	// ⭐ **REGISTER THE COMPILER-OWNED `__ManagedFile` TYPE** — the last of these, called by the
	// declaration SWEEP when a file's tokens name a producer (`Parser.atManagedFileProducer`).
	// Idempotent, so the sweep is the WRITE and every parser read is a pure read.
	//
	// ⚠ It registers under the name the SOURCE SPELLS (`__ManagedFile`): see `ManagedFileTypeName` —
	// this type MUST be namable in a parameter and a field, and the corpus requires it.
	export function registerManagedFileType()
		// `__ManagedMemory` is an ALIAS, not a layout — see `ManagedMemoryTypeName`. Registered through the
		// SAME `genericAliases` map a user `typealias` folds into, so a
		// `__ManagedMemory` annotation reaches the ordinary `Array` paths with nothing special-cased.
		//
		// ⚠⚠ **"NOTHING SPECIAL-CASED" STOPS SHORT OF THE BUFFER SURFACE.** The surface is
		// decided by PROVENANCE on a `ValueId` (`Parser.valueIsBufferSurface`), and this alias folds the
		// SPELLING away — so a value bound by a parameter, a struct field or a return type written
		// `__ManagedMemory` was indistinguishable from a `ByteArray` and took the `Array` surface. Measured
		// 2026-07-31: `function f(m __ManagedMemory)` with `m.push(7)`/`m.count()` compiled, linked and RAN,
		// while `m.length()` was refused as an unknown `Array` method — the roster exactly inverted.
		// ⇒ Each of those three declaration sites now carries the pre-erasure spelling to the site that binds
		// the value (`Parser.declaredSurfaceAt` / `markDeclaredSurface`); the return half's
		// column is `declaredReturnSurfaces` in THIS index, since a callee may be in another file. Type
		// resolution is untouched: `__ManagedMemory` still resolves to `Array with Byte`, which is what keeps
		// a `ByteArray` argument assignable to a `__ManagedMemory` parameter.
		// Upserted before the early return below because the two registrations are independent: the alias
		// must exist even on a second call that finds the layout already there.
		// ⚠ **THE BARE INSTANCE, DELIBERATELY.** This entry has no declaring file — the compiler minted
		// it, not a source line — so it is the one generic alias whose element must stay UNSCOPED in the
		// table: `__ManagedMemory` means "a raw byte buffer as the READER's `Byte` is declared", and the
		// reader's spelling is applied at the read (`genericAliasInstanceFrom`). Scoping it here would pick
		// one file's `Byte` for every file in the program, which is the whole defect being repaired.
		self.mainThreadSettled().genericAliases.upsert(ManagedMemoryTypeName, value: self.bareArrayByteInstance())

		if self.hasRegisteredLayout(ManagedFileTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'

		self.addRegisteredLayout(managedFileLayout())
	end 'registerManagedFileType'

	// The `__ManagedFile` layout, held to the runtime's own constants by the same drift check
	// `managedDirectoryLayout` uses and for the same reason — the front end states the shape here, the runtime
	// writes the handle through `ManagedFileHandleOffset`, and two readers of one shape is the pair that
	// drifts. ⚠ Nothing but this check ties the 8-byte handle struct to the block size the runtime
	// allocates.
	function managedFileLayout() returns StructLayout
		let layout = StructLayout.createCompilerOwned(ManagedFileTypeName)
		layout.addField(ManagedFileHandleFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)

		if layout.offsetOfField(ManagedFileHandleFieldIndex) != ManagedFileHandleOffset 'offsetDrift'
			panic("managedFileLayout: the struct layout puts `_handle` at {layout.offsetOfField(ManagedFileHandleFieldIndex)} but the runtime reads it at {ManagedFileHandleOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'

		if layout.sizeBytes() as FullRangeInt != ManagedFileBoxBytes 'sizeDrift'
			panic("managedFileLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedFileBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'

		return layout
	end 'managedFileLayout'

	// ⭐ **REGISTER THE COMPILER-OWNED `__ManagedDirectory` TYPE** — `registerManagedFileType`'s twin,
	// called by the declaration SWEEP when a file's tokens name it (`Parser.atManagedDirectoryProducer`).
	// Idempotent, so the sweep is the WRITE and every parser read is a pure read.
	//
	// ⚠⚠ **IT INTERNS `Array with Byte`, AND THAT IS NOT REDUNDANT WITH THE FILE FAMILY'S UPSERT.**
	// `filename()` and `currentPath()` PRODUCE a `__ManagedMemory` without the program ever naming one:
	// `let cwd = try __ManagedDirectory.currentPath()` writes no `__ManagedMemory` token, no `b"…"` literal
	// and (until the next line) no `.toByteArray()`, so none of the sweep's existing byte-instance triggers
	// fires and the parser — which may only READ the registry — would have no instance to tag the result
	// with. Over-interned rather than missed, which is this sweep's standing discipline.
	// ⚠ The `__ManagedMemory` ALIAS itself is `registerManagedFileType`'s to upsert and is not repeated here:
	// a file that annotates one has written the name, which is what that probe matches on.
	export function registerManagedDirectoryType()
		_ = self.bareArrayByteInstance()

		if self.hasRegisteredLayout(ManagedDirectoryTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'

		self.addRegisteredLayout(managedDirectoryLayout())
	end 'registerManagedDirectoryType'

	// The `__ManagedDirectory` layout, held to the runtime's own constants by the same drift check
	// `managedFileLayout` uses and for the same reason. ⚠ The check earns more here: nothing else ties the
	// front-end shape and the block `__mm_alloc` reserves together.
	function managedDirectoryLayout() returns StructLayout
		let layout = StructLayout.createCompilerOwned(ManagedDirectoryTypeName)
		layout.addField(ManagedDirectoryBlockFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)

		if layout.offsetOfField(ManagedDirectoryBlockFieldIndex) != ManagedDirectoryBlockOffset 'offsetDrift'
			panic("managedDirectoryLayout: the struct layout puts `_block` at {layout.offsetOfField(ManagedDirectoryBlockFieldIndex)} but the runtime reads it at {ManagedDirectoryBlockOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'

		if layout.sizeBytes() as FullRangeInt != ManagedDirectoryBoxBytes 'sizeDrift'
			panic("managedDirectoryLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedDirectoryBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'

		return layout
	end 'managedDirectoryLayout'

	// ⭐ **REGISTER THE COMPILER-OWNED `__ManagedSocket` TYPE** — `registerManagedFileType`'s twin, called by
	// the declaration SWEEP when a file's tokens name it (`Parser.atManagedSocketProducer`). Idempotent, so
	// the sweep is the WRITE and every parser read is a pure read.
	//
	// ⚠ It interns the byte instance for the SAME reason `registerManagedDirectoryType` does: a socket
	// signature is written in terms of `__ManagedMemory` (`tcpConnect`'s host, `sendFrom`'s and `recv`'s
	// buffer), and a program can reach one without writing any of the sweep's other byte-instance triggers.
	// ⚠ The `__ManagedMemory` ALIAS itself is `registerManagedFileType`'s to upsert and is not repeated here:
	// a file that annotates one has written the name, which is what that probe matches on.
	export function registerManagedSocketType()
		_ = self.bareArrayByteInstance()

		if self.hasRegisteredLayout(ManagedSocketTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'

		self.addRegisteredLayout(managedSocketLayout())
	end 'registerManagedSocketType'

	// The `__ManagedSocket` layout, held to the runtime's own constants by the same drift check
	// `managedFileLayout` uses and for the same reason — the front end states the shape here, the runtime
	// writes the socket through `ManagedSocketHandleOffset`, and two readers of one shape is the pair that
	// drifts.
	function managedSocketLayout() returns StructLayout
		let layout = StructLayout.createCompilerOwned(ManagedSocketTypeName)
		layout.addField(ManagedSocketHandleFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)

		if layout.offsetOfField(ManagedSocketHandleFieldIndex) != ManagedSocketHandleOffset 'offsetDrift'
			panic("managedSocketLayout: the struct layout puts `_handle` at {layout.offsetOfField(ManagedSocketHandleFieldIndex)} but the runtime reads it at {ManagedSocketHandleOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'

		if layout.sizeBytes() as FullRangeInt != ManagedSocketBoxBytes 'sizeDrift'
			panic("managedSocketLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedSocketBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'

		return layout
	end 'managedSocketLayout'

	export function registerManagedHostResourceTypes()
		if self.hasRegisteredLayout(ManagedPagesTypeName) 'alreadyRegistered'
			return
		end 'alreadyRegistered'

		self.addRegisteredLayout(managedPagesLayout())
		self.addRegisteredLayout(managedHandleLayout())
		self.addRegisteredLayout(managedPinLayout())
	end 'registerManagedHostResourceTypes'

	function managedPagesLayout() returns StructLayout
		let layout = StructLayout.createCompilerOwned(ManagedPagesTypeName)
		layout.addField(ManagedPagesBaseFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)
		layout.addField(ManagedPagesBytesFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)

		if layout.offsetOfField(ManagedPagesBaseFieldIndex) != ManagedPagesBaseOffset 'baseDrift'
			panic("managedPagesLayout: the struct layout puts `_base` at {layout.offsetOfField(ManagedPagesBaseFieldIndex)} but the runtime reads it at {ManagedPagesBaseOffset} — the front end's shape and the runtime's field access have drifted")
		end 'baseDrift'

		if layout.offsetOfField(ManagedPagesBytesFieldIndex) != ManagedPagesBytesOffset 'bytesDrift'
			panic("managedPagesLayout: the struct layout puts `_bytes` at {layout.offsetOfField(ManagedPagesBytesFieldIndex)} but the runtime reads it at {ManagedPagesBytesOffset} — the front end's shape and the runtime's field access have drifted")
		end 'bytesDrift'

		if layout.sizeBytes() as FullRangeInt != ManagedPagesBoxBytes 'sizeDrift'
			panic("managedPagesLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedPagesBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'

		return layout
	end 'managedPagesLayout'

	function managedHandleLayout() returns StructLayout
		let layout = StructLayout.createCompilerOwned(ManagedHandleTypeName)
		layout.addField(ManagedHandleWordFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)

		if layout.offsetOfField(ManagedHandleWordFieldIndex) != ManagedHandleWordOffset 'offsetDrift'
			panic("managedHandleLayout: the struct layout puts `_handle` at {layout.offsetOfField(ManagedHandleWordFieldIndex)} but the runtime reads it at {ManagedHandleWordOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'

		if layout.sizeBytes() as FullRangeInt != ManagedHandleBoxBytes 'sizeDrift'
			panic("managedHandleLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedHandleBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'

		return layout
	end 'managedHandleLayout'

	function managedPinLayout() returns StructLayout
		let layout = StructLayout.createCompilerOwned(ManagedPinTypeName)
		layout.addField(ManagedPinTokenFieldName, declaredType: MaxonType.integer, mutable: true, tier: Visibility.unexported, defaultValue: FieldDefault.none, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed)

		if layout.offsetOfField(ManagedPinTokenFieldIndex) != ManagedPinTokenOffset 'offsetDrift'
			panic("managedPinLayout: the struct layout puts `_token` at {layout.offsetOfField(ManagedPinTokenFieldIndex)} but the runtime reads it at {ManagedPinTokenOffset} — the front end's shape and the runtime's field access have drifted")
		end 'offsetDrift'

		if layout.sizeBytes() as FullRangeInt != ManagedPinBoxBytes 'sizeDrift'
			panic("managedPinLayout: the struct layout is {layout.sizeBytes()} bytes but the runtime allocates {ManagedPinBoxBytes} — the box the runtime builds and the shape the front end states have drifted")
		end 'sizeDrift'

		return layout
	end 'managedPinLayout'

	// The `Set with Character` instance a `CharSet from [...]` constructs — the
	// `builtinInstanceForElement` twin. Keyed as `MaxonType.character`, the SAME arg a
	// `typealias CharSet = Set with Character` interns, so the instance a `from` literal builds and the one the
	// corpus alias names share ONE gid and are type-identical. Idempotent.
	export function setInstanceForCharacter() returns GenericInstanceId
		let args = MaxonTypeArray.create(1, zeroed: false)
		args.push(MaxonType.character)
		return self.internRow(self.typeNames.intern(SetBuiltinBaseName), args: args)
	end 'setInstanceForCharacter'

	// --- Synthesized TUPLE types ---
	//
	// ⭐ **THE PARSER IS THE ONLY PRODUCER, AND IT REGISTERS INTO THIS INDEX DIRECTLY.** The other
	// compiler-owned layouts (`__ManagedFile`, `__ManagedDirectory`) are registered by the declaration SWEEP,
	// because a TOKEN scan can see the name that produces one. A tuple's identity is its ELEMENT TYPES, and
	// those are known only where the expression is parsed — `let t = (10, 32)` is two `integer`s and a token
	// scan cannot say so — so the sweep cannot pre-register the set. The registration is nevertheless safe on
	// exactly the terms that make the sweep-then-read discipline work elsewhere: the layout is a PURE FUNCTION
	// of the name (which is a pure function of the element types), and the write is idempotent, so no ordering
	// between files, and no interleaving of a parallel fan-out, can produce two different answers.
	//
	// The parser records the SAME layout into its `FileParseArtifact` as well, so `mergeArtifact` commits it
	// to `project.structTypes` — the registry `installStructDestructors` walks. Two registries, exactly as a
	// DECLARED `type` lives in both and for the reason `StructLayout`'s header states.
	//
	// ⚠ **THE STANDING OBLIGATION THAT COMES WITH THAT, FOR WHOEVER BUILDS THE INCREMENTAL DRIVER.** The two
	// registries are rebuilt on DIFFERENT triggers — `project.structTypes` at every merge (from artifacts
	// that may be cache HITS), this index whenever any file's bytes change — and a tuple minted only inside a
	// function BODY is registered here by the PARSE. So a rebuild in which a body-only edit to one file
	// leaves another file's parse memoized would hand `installStructDestructors` a layout this index has
	// never seen, and its `structHasManagedField(name)` would panic. A DECLARED tuple is never missing: the
	// sweep re-runs `parseTypeReference` over every declaration on every rebuild.
	//
	// It is UNREACHABLE today and was measured so, not assumed: nothing runs the full pipeline twice on one
	// `Project` — `build` and each spec-test worker construct a fresh one, and `verify-warm-rebuild` drives
	// the front end alone (`WarmGoal.merged`) for its cache and invalidation probes (`compileColdOnce`
	// takes its own `Project`). The fix when that changes is to derive the destructor installer's per-field questions from
	// the layout it ALREADY HOLDS instead of re-asking this index by name; a restoration pass that no code
	// path can exercise would be the unread-index shape the query spine's header warns about.

	// ⭐ **INTERN THE TUPLE TYPE OF `elements`, and answer with its MANGLED NAME.** The one door a tuple type
	// is minted through — a `(a, b)` literal, a `(T, U)` type annotation, a `typealias Pair = (…)` — so every
	// spelling of one tuple type lands on ONE layout.
	//
	// ⭐⭐ **IT CANONICALIZES, AND ONLY ONCE `tupleNamesAreCanonical`.** A ranged alias is keyed
	// on the declaration its spelling's file sees (`canonicalTupleElement`). It cannot be done
	// during the SWEEP: `Integer`'s own declaration may be below the function, or in a file not yet
	// folded, so the alias registry has no answer yet. A sweep-minted name is therefore the SOURCE spelling
	// (`__Tuple2.Integer.Integer`), and `adoptType` — the ONE door this index's types cross out of — rewrites
	// it to the canonical one at every read. That is the identical arrangement `declaredSlotType`'s three
	// re-tags already live under, and for the identical reason.
	// ⚠ **THE ELEMENT REJECTIONS FIRE ONLY IN THE REAL PARSE, and that is the standing sweep discipline
	// rather than a hole.** During the sweep a generic-instance / function / inner alias is still a bare
	// `named` (its registry is being built), so the canonical form the rejections are asked about does not
	// exist yet — a sweep-time verdict would be decided by file order. The sweep therefore records whatever
	// spelling it sees, the real parse asks the question with the whole program in hand, and a program that
	// fails it is rejected before anything downstream reads the tuple. The sweep's spelling is registered but
	// never referenced, exactly like the instances `internLiteralContainerInstances` over-interns.
	//
	// ⚠ **`slotScopeFilePath` IS THE FILE THAT WROTE THE ELEMENT LIST, and it is what makes a tuple's identity
	// a statement about the program rather than about the filesystem.** Every spelling reaching here —
	// a `(a, b)` literal, a `(T, U)` annotation, a `typealias Pair = (…)` — was written in exactly one file,
	// and an element naming a CONTESTED generic alias means what that file means by it. See
	// `tupleStructLayout` for why the minted layout carries it too.
	export function internTupleType(elements MaxonTypeArray, written NameRoster, capabilities ParamCapabilityArray, from TypeNameInterner, slotScopeFilePath FilePath) returns immutable ByteArray throws TupleElementRejection
		let interned = MaxonTypeArray.create(elements.count(), zeroed: false)

		for i in 0 upto elements.count() 'eachElement'
			let adopted = self.adoptTypeFrom(try elements.get(i) otherwise panic("internTupleType: elements.get OOB at {i} below count {elements.count()}"), from: from)

			if not self.tupleNamesAreCanonical() 'tolerantSweep'
				interned.push(adopted)
				continue
			end 'tolerantSweep'

			try requireTupleElementType(adopted, position: i as FieldIndex)
			interned.push(self.canonicalTupleElement(adopted, slotScopeFilePath: slotScopeFilePath))
		end 'eachElement'

		return self.registerTupleLayout(interned, written: written, capabilities: capabilities, declFilePath: slotScopeFilePath)
	end 'internTupleType'

	function registeredLayout(name ByteArray) returns StructLayout throws MapError
		return self.layoutAtSlot(try self.slotOfLayout(name))
	end 'registeredLayout'

	function slotOfLayout(name ByteArray) returns ElementIndex throws MapError
		if self.baseline.overlaid and not self.structSlots.contains(name) 'inTheBaseline'
			return try self.baseTables().structSlots.get(name)
		end 'inTheBaseline'

		return try self.structSlots.get(name)
	end 'slotOfLayout'

	function hasRegisteredLayout(name ByteArray) returns bool
		if self.structSlots.contains(name) 'ownLayout'
			return true
		end 'ownLayout'

		return self.baseline.overlaid and self.baseTables().structSlots.contains(name)
	end 'hasRegisteredLayout'

	function registeredLayoutCount() returns ElementIndex
		if self.baseline.overlaid 'overlaid'
			return self.structSlots.count() + self.baseTables().structSlots.count()
		end 'overlaid'

		return self.structSlots.count()
	end 'registeredLayoutCount'

	function baselineMintedLayoutCount() returns ElementIndex
		if not self.baseline.overlaid 'notOverlaid'
			return 0
		end 'notOverlaid'

		return self.baseTables().mintedTupleLayouts.count()
	end 'baselineMintedLayoutCount'

	function mintedLayoutCount() returns ElementIndex
		return self.baselineMintedLayoutCount() + self.mintedTupleLayouts.count()
	end 'mintedLayoutCount'

	function requireWholeProgramIndex(site String)
		if self.baseline.overlaid 'overlaid'
			panic("ProgramSignatures.{site}: a parse's overlay holds only the rows the parse minted over its shared template, and this walks the whole program — it belongs to the settle and the fold, which run on the index itself")
		end 'overlaid'
	end 'requireWholeProgramIndex'

	function layoutAtSlot(slot ElementIndex) returns StructLayout
		let swept = self.settledDeclarations().structLayouts.count()
		let baselineMinted = self.baselineMintedLayoutCount()

		if slot >= swept and slot - swept < baselineMinted 'aBaselineTuple'
			return try self.baseTables().mintedTupleLayouts.get(slot - swept) otherwise panic("ProgramSignatures.layoutAtSlot: slot {slot} is below the {baselineMinted} tuples the template minted and the array does not hold it")
		end 'aBaselineTuple'

		return self.layoutIn(self.settledDeclarations().structLayouts, slot: slot, skipping: baselineMinted)
	end 'layoutAtSlot'

	function ownLayoutAtSlot(slot ElementIndex) returns StructLayout
		return self.layoutIn(self.mainThreadSettled().structLayouts, slot: slot, skipping: 0)
	end 'ownLayoutAtSlot'

	function layoutIn(sweptLayouts StructLayoutArray, slot ElementIndex, skipping ElementIndex) returns StructLayout
		let swept = sweptLayouts.count()

		if slot < swept 'aSweptLayout'
			return try sweptLayouts.get(slot) otherwise panic("ProgramSignatures.layoutIn: slot {slot} is below the {swept} swept layouts and the array does not hold it")
		end 'aSweptLayout'

		return try self.mintedTupleLayouts.get(slot - swept - skipping) otherwise panic("ProgramSignatures.layoutIn: slot {slot} is past the {swept} swept layouts and the {self.mintedLayoutCount()} minted tuples")
	end 'layoutIn'

	function addRegisteredLayout(layout StructLayout)
		if self.baseline.settled 'mintedPastTheBaseline'
			self.structSlots.upsert(layout.name, value: self.settledDeclarations().structLayouts.count() + self.mintedLayoutCount())
			self.mintedTupleLayouts.push(layout)
			self.journal.noteTupleName(layout.name)
		end 'mintedPastTheBaseline' else 'sweptWithTheDeclarations'
			self.structSlots.upsert(layout.name, value: self.settledDeclarations().structLayouts.count())
			self.mainThreadSettled().structLayouts.push(layout)
		end 'sweptWithTheDeclarations'
	end 'addRegisteredLayout'

	// Register the layout for an already-interned, already-canonical element list and answer its name.
	// Idempotent — a second mint of the same tuple type is a `contains` hit that builds nothing.
	//
	// ⚠ **THE FIRST MINTER'S FILE IS THE ONE THE LAYOUT KEEPS, and `sweepScopedTupleName` is what makes that
	// exact rather than a race.** A CANONICAL element list holds resolved types, so every file that reaches
	// that name means the same thing by it and the path is never consulted to say otherwise — one layout,
	// one file, no ambiguity. A SWEEP spelling still holds bare `named`s, so it is keyed per file and there
	// is again exactly one minter.
	function registerTupleLayout(elements MaxonTypeArray, written NameRoster, capabilities ParamCapabilityArray, declFilePath FilePath) returns immutable ByteArray
		let instanceBrands = instanceBrandsOf(elements, written: written)
		let name = self.tupleLayoutNameOf(elements, instanceBrands: instanceBrands, capabilities: capabilities, declFilePath: declFilePath)

		if not self.hasRegisteredLayout(name) 'notRegisteredYet'
			self.mintTupleLayout(elements, instanceBrands: instanceBrands, capabilities: capabilities, declFilePath: declFilePath)
		end 'notRegisteredYet'

		return name
	end 'registerTupleLayout'

	function tupleLayoutNameOf(elements MaxonTypeArray, instanceBrands NameRoster, capabilities ParamCapabilityArray, declFilePath FilePath) returns immutable ByteArray
		return self.sweepScopedTupleName(self.tupleTypeNameOf(elements, instanceBrands: instanceBrands, capabilities: capabilities), declFilePath: declFilePath)
	end 'tupleLayoutNameOf'

	function mintTupleLayout(elements MaxonTypeArray, instanceBrands NameRoster, capabilities ParamCapabilityArray, declFilePath FilePath)
		let name = self.tupleLayoutNameOf(elements, instanceBrands: instanceBrands, capabilities: capabilities, declFilePath: declFilePath)

		// The layout owns its copies: a parse hands in its own types and path, and a layout the journal later removes stays
		// in its map slot.
		self.registerTupleLayoutAs(name, elements: elements.clone(), brands: self.tupleElementBrands(elements, instanceBrands: instanceBrands, declFilePath: declFilePath), instanceBrands: instanceBrands, capabilities: capabilities.clone(), declFilePath: declFilePath.clone())
	end 'mintTupleLayout'

	function registerTupleLayoutAs(name ByteArray, elements MaxonTypeArray, brands NameRoster, instanceBrands NameRoster, capabilities ParamCapabilityArray, declFilePath FilePath)
		self.addRegisteredLayout(tupleStructLayout(name, elements: elements, brands: brands, capabilities: capabilities, declFilePath: declFilePath))
		self.recordTupleElementToken(name)
		self.recordSeparatorBearingElementTokens(elements, instanceBrands: instanceBrands)
	end 'registerTupleLayoutAs'

	export function settleSweptTupleElementBrands()
		self.requireWholeProgramIndex("settleSweptTupleElementBrands")

		for (name, slot) in self.structSlots 'eachLayout'
			if not isTupleTypeName(name) 'notATuple'
				continue
			end 'notATuple'

			let layout = self.ownLayoutAtSlot(slot)
			let brands = self.tupleElementBrands(layout.fieldTypes, instanceBrands: instanceBrandsOf(layout.fieldTypes, written: self.writtenBrandsOf(layout, types: layout.fieldTypes)), declFilePath: layout.declFilePath)

			for i in 0 upto brands.count() 'eachElement'
				let brand = try brands.get(i) otherwise panic("ProgramSignatures.settleSweptTupleElementBrands: brands.get OOB at {i} below count {brands.count()}")
				layout.rebrandField(i as FieldIndex, declaredBrand: brand)
			end 'eachElement'
		end 'eachLayout'
	end 'settleSweptTupleElementBrands'

	function tupleElementBrands(elements MaxonTypeArray, instanceBrands NameRoster, declFilePath FilePath) returns NameRoster
		let brands = NameRoster.create(elements.count(), zeroed: false)

		for i in 0 upto elements.count() 'eachElement'
			let element = try elements.get(i) otherwise panic("tupleElementBrands: elements.get OOB at {i} below count {elements.count()}")
			let instanceBrand = try instanceBrands.get(i) otherwise panic("tupleElementBrands: instanceBrands.get OOB at {i} below count {instanceBrands.count()}")

			if not instanceBrand.isEmpty() 'anInstanceAlias'
				brands.push(instanceBrand)
				continue
			end 'anInstanceAlias'

			brands.push(self.nameOfId(typeNameIdOf(element)) if self.typeIsARangedAlias(element, slotScopeFilePath: declFilePath) else (ExitCodeBuiltinName if maxonTypeTag(element) == ValueTypeTag.exitCode else EmptySourceText))
		end 'eachElement'

		return brands
	end 'tupleElementBrands'

	function writtenBrandsOf(layout StructLayout, types MaxonTypeArray) returns NameRoster
		let written = NameRoster.create(types.count(), zeroed: false)

		for i in 0 upto types.count() 'eachElement'
			let element = try types.get(i) otherwise panic("writtenBrandsOf: types.get OOB at {i} below count {types.count()}")

			if maxonTypeTag(element) == ValueTypeTag.named 'aSweptSpelling'
				written.push(self.genericBrandOfWritten(self.nameOfId(typeNameIdOf(element)), readerFilePath: layout.declFilePath))
				continue
			end 'aSweptSpelling'

			written.push(layout.fieldDeclaredBrand(i as FieldIndex))
		end 'eachElement'

		return written
	end 'writtenBrandsOf'

	// The ledger half of a separator-bearing element's citation: `tupleElementName` derives the token and
	// never writes, so the collision check lives at the one mutation site a tuple type has. One spelling cited
	// by many tuples is recorded once and re-asked harmlessly; only a DIFFERENT owner of the same token stops.
	function recordSeparatorBearingElementTokens(elements MaxonTypeArray, instanceBrands NameRoster)
		for i in 0 upto elements.count() 'eachElement'
			let element = try elements.get(i) otherwise panic("recordSeparatorBearingElementTokens: elements.get OOB at {i} below count {elements.count()}")

			match self.tupleElementCitationOf(element, brand: try instanceBrands.get(i) otherwise panic("recordSeparatorBearingElementTokens: instanceBrands.get OOB at {i} below count {instanceBrands.count()}")) 'citation'
				nestedTuple or
				asSpelled then break
				separatorBearing(spelling) then self.recordSeparatorBearingToken(spelling)
			end 'citation'
		end 'eachElement'
	end 'recordSeparatorBearingElementTokens'

	function recordSeparatorBearingToken(spelling ByteArray)
		let token = tupleElementTokenFor(spelling)

		if let owner = try self.ownerOfToken(token) 'tokenAlreadyOwned'
			if owner.equals(spelling) 'thisSpellingsOwnToken'
				return
			end 'thisSpellingsOwnToken'

			panic("ProgramSignatures.recordSeparatorBearingToken: the element token `{String.from(token)}` already cites `{String.from(owner)}` and the element spelling `{String.from(spelling)}` digests to it too. That is a genuine 64-bit digest collision, and two tuples over the two would spell one name. See `tupleElementTokenFor` for the width this rests on")
		end 'tokenAlreadyOwned'

		self.tupleElementTokenOwners.upsert(token, value: spelling)

		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteSeparatorBearingToken(token)
		end 'pastTheBaseline'
	end 'recordSeparatorBearingToken'

	// ⭐⭐ **THE INJECTIVITY LEDGER — where the digest's one assumption stops being assumed.** The token
	// itself is computed, not allocated: see `tupleElementTokenFor` for what it is, why it is bounded, why it
	// is a pure function of the program and why it is 64 bits wide. What this door adds is the record of WHICH
	// name each live token belongs to, the refusal to hand one token to two names, and the memo that keeps
	// every later reader from re-deriving what was just derived here.
	//
	// ⚠ **IT IS THE SAME GUARD THE MINT-ORDERED ORDINAL CARRIED, RE-DERIVED FOR THE NEW KEY, not a new one.**
	// That version tested `tupleElementTokens.contains(name)` and rested on the FORWARD map alone: with the
	// map's own size as the ordinal, a second mint under one name would have handed TWO layouts ONE token. The
	// invariant it protected is unchanged — two registered layouts must never share one citation, because two
	// element lists spelling one enclosing name is precisely the non-injective join `TupleElementSeparator`
	// exists to bar, with the drop cascade taken from whichever registered last. What changed is how it can be
	// VIOLATED: a computed token repeats not by counting twice but by two distinct names digesting alike, and
	// that question can only be asked of the REVERSE map, which is why one exists.
	//
	// **The two maps are written in ONE act**, which is the property both readers rest on: a name in the
	// forward map has had its token checked, and a token in the reverse map has an owner. A divergence stops
	// the compile at the next read rather than silently repeating a citation.
	//
	// The collision arm cannot fire in practice (`tupleElementTokenFor` carries the probability), and it is
	// written anyway because the alternative is a silent wrong answer of exactly the kind this file's join
	// rules exist to make impossible.
	function recordTupleElementToken(name ByteArray)
		let token = tupleElementTokenFor(name)

		if let owner = try self.ownerOfToken(token) 'tokenAlreadyOwned'
			panic("ProgramSignatures.recordTupleElementToken: the element token `{String.from(token)}` already cites `{String.from(owner)}` and registering `{String.from(name)}` would give the same token a second owner. If the two names DIFFER this is a genuine 64-bit digest collision (with another tuple type, or with a separator-bearing element spelling), and one of them would be cited by a name the other owns. If they are the SAME name the maps have diverged, because `registerTupleLayout` returns early for a name `structTypes` already holds. Either way two layouts would share one citation, which is the non-injective join `TupleElementSeparator` exists to bar")
		end 'tokenAlreadyOwned'

		self.tupleElementTokens.upsert(name, value: token)
		self.tupleElementTokenOwners.upsert(token, value: name)
	end 'recordTupleElementToken'

	// The element token `name` is cited by. Two questions, two probes, and NEITHER allocates: that the layout
	// is registered at all, and that the token leads back to the very
	// name it is filed under.
	//
	// ⚠ **THE SECOND PROBE IS AN ASSERTION, NOT A SECOND COLLISION DETECTOR.** The owners map has two writers
	// and both refuse a token another owner holds BEFORE writing: `recordTupleElementToken` refuses any prior
	// owner, and `recordSeparatorBearingToken` any owner other than its own spelling — which no tuple name can
	// be, since a tuple is cited as `nestedTuple` and never as a spelling. So `tupleElementTokens[n] = t`
	// implies `tupleElementTokenOwners[t] = n` by construction and both arms below are unreachable on every
	// program. They fail loudly at the next citation if a third writer breaks that. Do not cite them as the
	// reason the digest is injective — the two writers are.
	function tupleElementTokenOf(name ByteArray) returns immutable ByteArray
		let token = try self.tokenOfTuple(name) otherwise panic("ProgramSignatures.tupleElementTokenOf: the nested tuple `{String.from(name)}` has no element token — every tuple `structRef` in the compiler names a layout `registerTupleLayout` minted, and that is where its token is recorded with it")
		let owner = try self.ownerOfToken(token) otherwise panic("ProgramSignatures.tupleElementTokenOf: the element token `{String.from(token)}` filed under `{String.from(name)}` has no owner — `recordTupleElementToken` writes both maps in one act, so this is a divergence between them")

		if not owner.equals(name) 'aDigestCollision'
			panic("ProgramSignatures.tupleElementTokenOf: the element token `{String.from(token)}` filed under `{String.from(name)}` is owned by `{String.from(owner)}` — two distinct tuple types share one token, so citing this one would name the other. See `tupleElementTokenFor` for the width that argument rests on")
		end 'aDigestCollision'

		return token
	end 'tupleElementTokenOf'

	// ⭐⭐ **THE TYPE-PARAMETER INJECTIVITY LEDGER — `recordTupleElementToken`'s twin, one digest over.**
	// The token itself is computed rather than allocated (`typeParamTokenFor` carries what it is and why it is
	// 64 bits); what this adds is the record of WHICH declaration each live token belongs to, and the refusal
	// to let two distinct parameters share one identity.
	//
	// ⭐ **CALLED ONCE PER DECLARED PARAMETER, AT THE FOLD, BY EXACTLY TWO DOORS** — `recordStruct` for a
	// `type`'s `uses` list and `recordInterfaceDeclaration` for an `interface`'s associated types. Those are
	// the two declarations `Parser.parseTypeReference` can mint a `typeParameter` inside (an extension body
	// borrows its TARGET's list, which is one of them), and both fold before any file is parsed — so the map
	// is complete and READ-ONLY by the time the parse fan-out asks it.
	//
	// ⚠ **A RE-RECORD OF THE SAME PARAMETER IS NOT A COLLISION, AND TELLING THE TWO APART IS THE WHOLE JOB.**
	// Two files may declare `type Box uses T` — that is E3006's business, reported with a position, and it
	// must not become a compiler panic here. So a repeat that names the same `(declaring type, parameter)` is
	// kept as it stands (the FIRST record wins, and the two agree on everything a reader asks except possibly
	// a position the duplicate declaration itself disagrees about). A repeat naming a DIFFERENT parameter is a
	// genuine 64-bit collision: two type parameters would share one identity, one instance key and one
	// diagnostic name — so it STOPS the compile.
	function recordTypeParamToken(declaringTypeName ByteArray, paramName ByteArray, position ElementIndex)
		let token = typeParamTokenFor(declaringTypeName, paramName: paramName)
		let owner = TypeParamOwner.create(declaringTypeName, paramName: paramName, position: position)

		if let existing = try self.mainThreadSettled().typeParamOwners.get(token) 'tokenAlreadyOwned'
			if not existing.namesTheSameParameterAs(owner) 'aDigestCollision'
				panic("ProgramSignatures.recordTypeParamToken: type parameter `{String.from(paramName)}` of `{String.from(declaringTypeName)}` digests to the same token as `{String.from(existing.paramName)}` of `{String.from(existing.declaringTypeName)}`. This is a genuine 64-bit digest collision between two DISTINCT type parameters, and admitting it would give them one identity — one `GenericInstanceRegistry` key for `Array with` each of them, and one entry in the display index, which would conflate two distinct type parameters. See `typeParamTokenFor` for the width this rests on")
			end 'aDigestCollision'

			return
		end 'tokenAlreadyOwned'

		self.mainThreadSettled().typeParamOwners.upsert(token, value: owner)
	end 'recordTypeParamToken'

	// ⭐ **WHAT MINTED `token` — the door for a caller holding NOTHING BUT THE TOKEN.** An instance query
	// reads a `typeParameter` off a base struct's field column or a shared method signature and has no
	// declaration in hand; this is where it learns whose parameter that is and at which position, in one
	// lookup. `typeParamPositionIn` is the OTHER direction, for a caller that DOES hold the declaration and
	// therefore needs no registry at all (see there for why both must exist).
	//
	// Absence is a THROW, not a panic, because one of its two callers is allowed to ask about a token it may
	// not own: `anyInstanceTypeArgHasKind` answers `false` for a token no declaration filed, for the reason a
	// base with no instance bucket answers `false` — nothing instantiates it, so no instantiation classifies
	// anything. The other caller, `opaqueTypeParamPosition`, treats absence as an invariant break and says so
	// with its own `otherwise panic`.
	// ⚠ The tolerant caller is NOT `Parser.isEnclosingTypeParam`: **that function does not call this one** —
	// it re-spells the token against the enclosing declaration's own names through `typeParamPositionIn`,
	// which is the whole reason both doors exist.
	export function typeParamOwnerOf(token TypeParamId) returns TypeParamOwner throws MapError
		return try self.settledDeclarations().typeParamOwners.get(token)
	end 'typeParamOwnerOf'

	// ⭐⭐ **ONE SWEEP KEY PER (SPELLING, FILE) — because a sweep spelling is NOT a whole-program identity and
	// a canonical name is.** A canonical name is derived from RESOLVED elements, so every file that
	// reaches it means the same thing by it; that property is what every reader of a tuple type rests on and
	// nothing here touches it. A sweep spelling is the opposite: its elements are still the bare names the
	// source wrote, because the registries that say what those names MEAN are being built while the sweep
	// runs. So `__Tuple2.Bag.int` written in two files whose `Bag` declarations disagree is two types wearing
	// one key — and the layout that key holds carries ONE declaring file, which is what
	// `resolveRecordedGenericAliasTypes` rescopes its elements against and what `canonicalTupleName` walks
	// them with.
	//
	// ⛔ MEASURED with the key shared: the file that folded SECOND could not construct its own field —
	// `E3005: cannot assign '__Tuple2.Array_String.int' to variable 'Holder.q' of type
	// '__Tuple2.Array_Num.int'`. A wrong answer decided by directory order.
	//
	// ⚠⚠ **THE FIRST MINTER KEEPS THE PLAIN KEY, AND THE SUFFIX IS AN ORDINAL RATHER THAN THE PATH.** Both
	// halves are corrections of a version that qualified every sweep key with `declFilePath`, and each has
	// its own reason:
	//   • **A PATH IS NOT A LEGAL ELEMENT-NAME FRAGMENT.** A sweep key can be embedded as an ELEMENT of
	//     another tuple's name (`canonicalTupleName`'s re-entry does exactly that), and the element join
	//     is `.` — which every path contains. It is also host-dependent, so it would print differently on
	//     every machine.
	//   • **THE FIRST MINTER MUST BE UNSUFFIXED**, because that same re-entry is the one place a sweep key
	//     reaches a user-visible type name. MEASURED: with every key suffixed,
	//     `tuples/error.self-referential-tuple-alias` rendered `…P.Int#<fragment>…` in its E3005. A single
	//     file spelling a tuple — which is that case, and the overwhelming common one — now takes the plain
	//     key and no message moves.
	//
	// The join is `mintedName`'s for `paramDefaultHelperName`'s reason: `#` appears in no
	// source identifier and in no canonical element name, so the key is unspellable, `isTupleTypeName` still
	// recognizes it by its intact prefix, and the digits cannot hold the element separator.
	function sweepScopedTupleName(name immutable ByteArray, declFilePath FilePath) returns immutable ByteArray
		if self.tupleNamesAreCanonical() 'aCanonicalIdentity'
			return name
		end 'aCanonicalIdentity'

		if self.tupleKeyIsAvailableTo(name, declFilePath: declFilePath) 'theFirstMintOfThisSpelling'
			return name
		end 'theFirstMintOfThisSpelling'

		// Every candidate this walk passes over is held by a layout of ANOTHER file, so the registry itself
		// bounds the search: there cannot be more taken candidates than there are registered layouts.
		for claimed in FirstLaterFileTupleOrdinal upto self.registeredLayoutCount() + 1 'eachLaterFilesMint'
			let candidate = mintedName(name, suffix: "{claimed}".toByteArray())

			if self.tupleKeyIsAvailableTo(candidate, declFilePath: declFilePath) 'free'
				return candidate
			end 'free'
		end 'eachLaterFilesMint'

		panic("ProgramSignatures.sweepScopedTupleName: every candidate key for the sweep spelling `{String.from(name)}` through #{self.structSlots.count()} is held by another file's layout, which cannot happen — each taken candidate occupies a registered layout of its own, so the walk is bounded by the registry's own size")
	end 'sweepScopedTupleName'

	// Is `candidate` a key this file may register its tuple layout under — free, or already this file's own
	// mint? A second mint of one spelling by one file is the ordinary case (a `typealias` and a field
	// annotation spelling the same element list), and it must land on that file's existing layout rather
	// than on a fresh suffix.
	function tupleKeyIsAvailableTo(candidate ByteArray, declFilePath FilePath) returns bool
		let existing = try self.registeredLayout(candidate) otherwise return true
		return existing.declFilePath.equals(declFilePath)
	end 'tupleKeyIsAvailableTo'

	// `__Tuple<N>.<e0>.<e1>…` — the mangled name of a tuple over `elements`. See `TupleElementSeparator` for
	// why the arity leads and why the join is `.`.
	function tupleTypeNameOf(elements MaxonTypeArray, instanceBrands NameRoster, capabilities ParamCapabilityArray) returns immutable ByteArray
		var out = tupleTypeNameHead(elements.count() as FieldIndex)

		for i in 0 upto elements.count() 'eachElement'
			out.append(TupleElementSeparator)
			out.append(self.tupleElementName(try elements.get(i) otherwise panic("tupleTypeNameOf: elements.get OOB at {i} below count {elements.count()}"), brand: try instanceBrands.get(i) otherwise panic("tupleTypeNameOf: instanceBrands.get OOB at {i} below count {instanceBrands.count()}")))
		end 'eachElement'

		out.append(tupleCapabilitySuffix(capabilities, count: elements.count()))
		return freeze out.toByteArray()
	end 'tupleTypeNameOf'

	// The mangled spelling of ONE canonical element. `mangleTypeArg` — the index's structural, build-stable
	// renderer — answers every tag but two.
	//
	// ⭐ **A NESTED TUPLE IS CITED BY ITS TOKEN, NEVER BY ITS NAME** — see `tupleElementTokenFor` for the
	// asymptote that buys and for why a digest of the nested name is a complete identity here. The token's
	// OWNER is on record by the time it is asked for: a nested element is a REGISTERED layout, and the only
	// two producers of one — a `(…)` written inside a `(…)`, which the parser interns innermost-first, and
	// `canonicalTupleStructRef`, which registers the canonical form before handing back its `structRef` —
	// both register before the enclosing name is built.
	//
	// ⚠ **A `function`-TYPED ELEMENT IS THE OTHER EXCEPTION, because `mangleTypeArg` renders every function
	// type as the bare tag name `function`.** That is correct for a descriptor label (a code pointer is a code
	// pointer) and WRONG for an identity: `(UnaryOp, int)` and `(BinaryOp, int)` would spell one name, and a
	// value of one would then be accepted where the other is declared. A function type carries its governing
	// alias NAME, so that is what rides here.
	//
	// ⭐ **A SPELLING THAT HOLDS THE SEPARATOR IS CITED BY ITS TOKEN TOO, SO THE JOIN IS INJECTIVE FOR EVERY
	// ELEMENT.** Companion types are registered under dotted names (`Calc.handle`, `Calc.divide.sendError`,
	// `Shape.unionCases`), and a generic instance renders its arguments inline (`Promise_int_Calc.handle`),
	// so a legal element can hold `.`. Its digest token holds none, and its head is the spelling's first
	// segment rather than a `__Tuple<N>`, so it cannot be mistaken for a nested tuple's citation.
	function tupleElementName(element MaxonType, brand ByteArray) returns String
		return match self.tupleElementCitationOf(element, brand: brand) 'citation'
			nestedTuple(name) gives String.from(self.tupleElementTokenOf(name))
			separatorBearing(spelling) gives String.from(tupleElementTokenFor(spelling))
			asSpelled(spelling) gives spelling
		end 'citation'
	end 'tupleElementName'

	function tupleElementCitationOf(element MaxonType, brand ByteArray) returns TupleElementCitation
		let tag = maxonTypeTag(element)

		if tagNamesADeclaredType(tag) 'aStructRef'
			let name = self.nameOfId(typeNameIdOf(element))

			if isTupleTypeName(name) 'nestedTuple'
				return TupleElementCitation.nestedTuple(name)
			end 'nestedTuple'
		end 'aStructRef'

		let mangled = String.from(self.nameOfId(typeNameIdOf(element))) if tag == ValueTypeTag.function else self.mangleTypeArg(element)
		let spelling = mangled if brand.isEmpty() else "{mangled}{TupleElementBrandMark}{String.from(brand)}"

		if spelling.contains(TupleElementSeparator) 'holdsTheSeparator'
			return TupleElementCitation.separatorBearing(freeze spelling.toByteArray())
		end 'holdsTheSeparator'

		return TupleElementCitation.asSpelled(spelling)
	end 'tupleElementCitationOf'

	// ⭐ **THE CANONICAL FORM OF ONE TUPLE ELEMENT — what a tuple's IDENTITY is keyed on.**
	//
	// A ranged alias, int or float, stays `named`: every tuple element keeps its alias as a struct
	// field does, so `(Tally, int)` and `(int, int)` are two tuples. It is keyed on the declaration
	// the spelling's own file sees (`rangeScopedDeclaredName`), so two files' same-named aliases stay
	// two elements.
	//
	// Every other element routes through `declaredSlotType`, the SAME door a struct FIELD's declared
	// type comes out of, so a tuple element and a field of the same declared type can never be
	// classified differently — a function alias becomes `function`, a generic-instance alias becomes
	// `genericInstance`.
	//
	// A `named` denoting a declared `type` is re-tagged `structRef` by `declaredSlotType` itself, so the
	// tuple's field type routes to the struct's own drop — and, the re-tag happening THERE rather than at the
	// bottom of this function, it then reaches `canonicalTupleStructRef` and a NESTED-tuple
	// element spelled by name canonicalizes like every other `structRef`. A `named` denoting an enum/union
	// stays `named`, which is the tag a union value carries.
	//
	// ⚠⚠ **AN ELEMENT IS RESOLVED IN THE FILE THAT SPELLED IT, NEVER AS A STRANGER.** *"A tuple is
	// compiler-synthesized, so it has no honest file, so every
	// element resolves as a file declaring none of the name would"* is true of the tuple's IDENTITY and
	// false of its element SPELLINGS — `(Bag, Num)` is written in one file, and where `Bag` is a contested
	// generic alias the stranger's reading is a THIRD answer, agreeing with neither declaration.
	//
	// ⭐ **THE CANONICAL NAME STAYS A WHOLE-PROGRAM KEY, and per-file resolution is what makes it one.** The
	// key is derived from the RESOLVED elements, so two files that mean the same thing by `(Bag, Num)` walk to
	// identical element types and therefore to one name — a tuple stays STRUCTURAL wherever the language says
	// the spellings agree. Two files that mean different things by it get two types, which is not a split of
	// one type but the two types the program always had. `__ManagedMemory` inside a tuple therefore means what
	// the SPELLING'S OWN FILE means by `Byte`, exactly as the same spelling in a struct field does.
	function canonicalTupleElement(element MaxonType, slotScopeFilePath FilePath) returns MaxonType
		if self.typeIsARangedAlias(element, slotScopeFilePath: slotScopeFilePath) 'aRangedAlias'
			return self.rangeScopedTupleElement(element, slotScopeFilePath: slotScopeFilePath)
		end 'aRangedAlias'

		let declared = self.declaredSlotType(element, into: self.typeNames, slotScopeFilePath: slotScopeFilePath)

		if maxonTypeTag(declared) != ValueTypeTag.named 'notNamed'
			return self.canonicalTupleStructRef(declared)
		end 'notNamed'

		return declared
	end 'canonicalTupleElement'

	function rangeScopedTupleElement(element MaxonType, slotScopeFilePath FilePath) returns MaxonType
		let name = self.nameOfId(typeNameIdOf(element))
		let scoped = self.rangeScopedDeclaredName(name, readerFilePath: slotScopeFilePath)

		if scoped.equals(name) 'thisFileNamesTheBareDeclaration'
			return element
		end 'thisFileNamesTheBareDeclaration'

		return MaxonType.named(self.typeNames.intern(scoped))
	end 'rangeScopedTupleElement'

	export function typeIsARangedAlias(t MaxonType, slotScopeFilePath FilePath) returns bool
		if maxonTypeTag(t) != ValueTypeTag.named 'notAnAlias'
			return false
		end 'notAnAlias'

		return self.aliasNamedIsRanged(self.nameOfId(typeNameIdOf(t)), slotScopeFilePath: slotScopeFilePath)
	end 'typeIsARangedAlias'

	export function typeNamesANumericIdentity(t MaxonType, slotScopeFilePath FilePath) returns bool
		return maxonTypeTag(t) == ValueTypeTag.exitCode or self.typeIsARangedAlias(t, slotScopeFilePath: slotScopeFilePath)
	end 'typeNamesANumericIdentity'

	export function aliasNamedIsRanged(name ByteArray, slotScopeFilePath FilePath) returns bool
		match self.fileScopedOrInnerAliasNamed(name, readerFilePath: slotScopeFilePath) 'alias'
			declared then return true
			undeclared then return false
		end 'alias'
	end 'aliasNamedIsRanged'

	// ⭐ **THE `MaxonType`-LEVEL TWIN OF `canonicalNameOfStruct`: a tuple `structRef` under a SWEEP spelling
	// answered as the canonical one, everything else itself.** One derivation, two readers — a NESTED tuple
	// ELEMENT (`canonicalTupleElement`, whose recursion this terminates: each step strips one nesting level
	// off a type written in finite source) and a generic instance's stored ARGUMENT (`containerElementType`).
	// Both ask the same question about the same tag, and the `allFilesFolded` gate that says whether a
	// canonical form exists yet lives once, in `canonicalNameOfStruct`, rather than at each asker.
	function canonicalTupleStructRef(element MaxonType) returns MaxonType
		if not tagNamesADeclaredType(maxonTypeTag(element)) 'notStruct'
			return element
		end 'notStruct'

		let name = self.nameOfId(typeNameIdOf(element))
		let canonical = self.canonicalNameOfStruct(name)

		if canonical.equals(name) 'alreadyCanonical'
			return element
		end 'alreadyCanonical'

		return MaxonType.structRef(self.typeNames.intern(canonical))
	end 'canonicalTupleStructRef'

	// ⭐ **THE CANONICAL TUPLE NAME FOR A NAME THE SWEEP MINTED.** Re-canonicalizes the registered layout's
	// element list under `tupleNamesAreCanonical`, registers the canonical layout if it is new, and
	// MEMOIZES — so the rewrite `adoptType` performs at every read costs one map hit after the first.
	// A name that is already canonical maps to itself, which is what makes the memo cover both directions.
	function canonicalTupleName(name immutable ByteArray) returns immutable ByteArray
		if let memoized = try self.canonicalTupleMemo(name) 'alreadyDerived'
			return name if memoized.isEmpty() else memoized
		end 'alreadyDerived'

		let layout = try self.registeredLayout(name) otherwise panic("ProgramSignatures.canonicalTupleName: `{String.from(name)}` is not registered — every tuple `structRef` in the compiler was minted by `internTupleType`, which registers the layout before it hands the name back")

		// ⚠⚠ **SEEDED BEFORE THE WALK WITH AN EMPTY NAME, WHICH A HIT READS AS THE NAME ITSELF — THE MEMO IS
		// ALSO THIS WALK'S RE-ENTRY MARKER.**
		// Every other element this walk descends into strips one nesting level off a type written in finite
		// source, which is the argument `canonicalTupleStructRef` terminates on. A tuple-ALIAS element does
		// not: `declaredSlotType` resolves it to its target, and an alias NAME can name the very tuple being
		// canonicalized — `typealias P = (P, Int)` registers `__Tuple2.P.int`, whose element 0 is `named("P")`,
		// whose target is `__Tuple2.P.int`. Re-entry therefore resolves that element to the SWEEP spelling it
		// already carries, and the infinite type is refused downstream by the return check instead of by the
		// stack running out. The
		// real answer replaces the seed below, and a walk that never re-enters never reads it.
		self.tupleCanonicalNames.upsert(layout.name, value: EmptySourceText)

		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteCanonicalTupleName(layout.name)
		end 'pastTheBaseline'

		// ⭐ **THE SCOPE FILE COMES OFF THE LAYOUT, because a SWEEP-minted spelling still holds bare `named`
		// elements and this is the walk that resolves them.** It is the file that wrote the element list
		// — see `tupleStructLayout` — and it rides on to the canonical layout so a re-entrant walk scopes the
		// same way the first one did.
		let canonical = MaxonTypeArray.create(layout.fieldTypes.count(), zeroed: false)

		for element in layout.fieldTypes 'eachElement'
			canonical.push(self.canonicalTupleElement(element, slotScopeFilePath: layout.declFilePath))
		end 'eachElement'

		let canonicalName = self.registerTupleLayout(canonical, written: self.writtenBrandsOf(layout, types: layout.fieldTypes), capabilities: tupleItemCapabilitiesOf(layout), declFilePath: layout.declFilePath)
		self.tupleCanonicalNames.upsert(layout.name, value: canonicalName)
		return canonicalName
	end 'canonicalTupleName'

	// Record `typealias <name> = (<elements>)`. Written by BOTH the declaration sweep and the real
	// parse from the same reader, exactly as every other alias registry is; the value is whichever
	// spelling the writing pass could produce, and `tupleAliasTargetFrom`/`tupleAliasTargetInAnyFile`
	// canonicalize on the way out.
	export function recordTupleAlias(name ByteArray, tupleName ByteArray, declFilePath FilePath, visibility Visibility, capability ParamCapability = ParamCapability.unmarked)
		// Copies, for `registerTupleLayout`'s reason.
		self.writeTupleAlias(name, alias: DeclaredTupleAlias.create(tupleName, claim: self.typeNameClaim(TypeDeclKind.tupleAlias, visibility: visibility, declFilePath: declFilePath.clone()), capability: capability))
	end 'recordTupleAlias'

	export function capabilityOfSpelledType(written ParamCapability, spelling ByteArray, readerFilePath FilePath) returns ParamCapability
		if written != ParamCapability.unmarked or spelling.isEmpty() 'writtenOrNoAlias'
			return written
		end 'writtenOrNoAlias'

		return self.aliasCapabilityOf(spelling, readerFilePath: readerFilePath)
	end 'capabilityOfSpelledType'

	function declaredParamCapability(declaration SweptDeclaration, position ElementIndex) returns ParamCapability
		let written = try declaration.paramCapabilities.get(position) otherwise panic("declaredParamCapability: paramCapabilities.get OOB at {position} below {declaration.paramCapabilities.count()} — the sweep records one capability beside every parameter type")
		return self.capabilityOfSpelledType(written, spelling: declaration.paramSpellingAt(position), readerFilePath: declaration.declFilePath)
	end 'declaredParamCapability'

	export function aliasCapabilityOf(name ByteArray, readerFilePath FilePath) returns ParamCapability
		let key = self.bareWrittenKey(name, readerFilePath: readerFilePath)

		if not self.holdsTupleAlias(key) 'notARecordAlias'
			return ParamCapability.unmarked
		end 'notARecordAlias'

		return self.scopedTupleAlias(key, readerFilePath: readerFilePath).capability
	end 'aliasCapabilityOf'

	// The one writer of `tupleAliases` and of the claimant index derived from it, journaling the values a
	// write past the baseline replaces.
	function writeTupleAlias(name ByteArray, alias DeclaredTupleAlias)
		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteTupleAliasWrite(name, prior: priorTupleAliasAt(self.tupleAliases, name: name), priorClaimants: priorTupleAliasClaimantsAt(self.multiplyDeclaredTupleAliases, name: name, declPath: alias.claim.declFilePath.toString()))
		end 'pastTheBaseline' else 'beforeTheBaseline'
			self.hash = Hasher.combined(mixDeclaringTier(mixBytes(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeTupleAlias), bytes: name), bytes: alias.tupleName), visibility: alias.claim.visibility, declFilePath: alias.claim.declFilePath), value: alias.capability.ordinal as HashDigest)
		end 'beforeTheBaseline'

		// Ahead of the `upsert`: the incumbent `indexTupleAliasDeclaration` reads is the declaration this one
		// displaces, and after the upsert every name would look singly declared.
		self.indexTupleAliasDeclaration(name, alias: alias)
		self.tupleAliases.upsert(name, value: alias)
	end 'writeTupleAlias'

	// The incumbent is filed WITH the newcomer for `RangedAliasRegistry.record`'s reason — see the "every
	// declaration or none" note there.
	//
	// ⚠ Past the baseline this either CREATES an entry, which the journal undoes by removing the name, or
	// adds exactly one `(name, declaringFile)` cell to one that already exists, which it undoes by that cell.
	// A call that came to touch two cells of an existing entry would leave one of them behind at the restore.
	function indexTupleAliasDeclaration(name ByteArray, alias DeclaredTupleAlias)
		let sole = try self.aliasNamed(name) otherwise return
		let declPath = alias.claim.declFilePath.toString()
		let byFile = try self.multiplyDeclaredTupleAliases.get(name) otherwise self.baselineClaimantsCopy(name)

		if byFile.count() == 0 'secondDeclarationOfThisName'
			let solePath = sole.claim.declFilePath.toString()

			if solePath.equals(declPath) 'oneFileWroteBoth'
				return
			end 'oneFileWroteBoth'

			byFile.upsert(solePath, value: sole)
		end 'secondDeclarationOfThisName'

		byFile.upsert(declPath, value: alias)
		self.multiplyDeclaredTupleAliases.upsert(name, value: byFile)
	end 'indexTupleAliasDeclaration'

	// Is `name` a TUPLE typealias? THE hot-path guard `parseTypeReference` asks of every bare type name, so
	// it must allocate nothing (`Map.contains`) — the `isGenericAlias` twin.
	export function isTupleAliasInAnyFile(name ByteArray) returns bool
		return self.holdsTupleAlias(name)
	end 'isTupleAliasInAnyFile'

	// ⭐⭐ **THE NAME A DECLARED POSITION'S `named` TYPE ACTUALLY DENOTES — a tuple typealias answered as the
	// tuple's own canonical name, every other name as itself. THE one home of that resolution.**
	//
	// A tuple alias mints no identity, so `Pair` is not a registered anything: `containsStruct` says no,
	// `enumOf` says no, and every classifier that reads a RAW layout field type (`typeIsManaged`, the drop
	// callee, the clone strategy, the deep-clone gate) reached its `undeclared` arm on it. It arrives under
	// the alias spelling exactly when the declaration SWEEP recorded the position before the alias's own file
	// was walked — which is a fact about the filesystem's walk order and not about the program.
	//
	// ⚠ It is written ONCE and asked at each classifier rather than resolved into the layout, because those
	// classifiers are deliberately allocation-free over the index's own interner (see `structFieldIsManaged`)
	// and a rewritten layout would be a second copy of the declaration that could drift from the first.
	export function denotedAggregateName(name immutable ByteArray) returns immutable ByteArray
		return self.tupleAliasTargetInAnyFile(name) if self.isTupleAliasInAnyFile(name) else name
	end 'denotedAggregateName'

	export function denotedAggregateNameFrom(name immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		return self.tupleAliasTargetFrom(name, readerFilePath: readerFilePath) if self.isAliasOfFormFor(name, readerFilePath: readerFilePath, wanted: FormAliasKind.tuple) else name
	end 'denotedAggregateNameFrom'

	// **CAN A RAW SLOT TYPE'S TAG NAME A DECLARED AGGREGATE?** — a `structRef` (what a resolved reference
	// carries, and what `Parser.enclosingSelfType` mints for a type's own name) or a bare `named` (what the
	// declaration SWEEP records, having run before anything could say what the name denoted). Every other tag
	// names no struct, union or tuple, so the resolution below has nothing to look up.
	//
	// ⭐ **WRITTEN ONCE BECAUSE FOUR DOORS ASK IT AND HAD COME TO SPELL IT FOUR WAYS** — `tagNamesADeclaredType(tag)
	// or tag == ValueTypeTag.named`, each of its two De Morgan negations, and `tag == ValueTypeTag.named or
	// tag == ValueTypeTag.structRef`. `Parser.tagCarriesStructLayout` is the same shape for the same reason and
	// its header states the cost of the alternative: a third tag taught to one spelling and not the others is
	// a wrong answer at whichever door was not updated, with no compile error at either.
	//
	// ⚠ `typeIsManaged` deliberately does NOT ask it. Its `structRef` arm has already answered by the time
	// it tests `named`, so its remaining test is "is this the ONE tag still undecided?" — a different
	// question that happens to mention the same tags.
	export function tagMayNameAggregate(tag ValueTypeTag) returns bool
		return tagNamesADeclaredType(tag) or tag == ValueTypeTag.named
	end 'tagMayNameAggregate'

	// **THE DECLARED NAME A RAW SLOT TYPE DENOTES, over THIS index's own interner** — a tuple typealias
	// answered as the tuple's own canonical name, every other name as itself. Precondition:
	// `tagMayNameAggregate(maxonTypeTag(t))`, which is what makes the id a name's.
	//
	// ⭐ The `denotedAggregateName(nameOfId(…))` pair was open-coded at four doors — the type-argument size,
	// the type-argument ownership classifier, the deep-clone gate and the constructibility walk — one of them
	// spelling `nameOfId`'s body out again with a second panic string for the identical invariant. The comment
	// at `typeArgIsOwned` says these must not diverge and records what it cost when they did (a silent wrong
	// `sizeof`, then a false E2015 on a program the other walk order ran); a shared call is that rule enforced
	// rather than restated.
	//
	// ⚠ **`typeIsManaged` IS NOT ONE OF THEM, AND MUST NOT BECOME ONE.** It takes the interner as a PARAMETER
	// (`from`) because a type that crossed into a file-local artifact table has to be read against THAT table;
	// its header records both directions in which resolving it against `self.typeNames` instead was measured
	// to give a silent wrong answer.
	function denotedSlotAggregateName(t MaxonType) returns immutable ByteArray
		return self.denotedAggregateName(self.nameOfId(typeNameIdOf(t)))
	end 'denotedSlotAggregateName'

	// The tuple type `name` aliases, CANONICAL. Precondition: `isTupleAliasInAnyFile(name)`.
	export function tupleAliasTargetInAnyFile(name ByteArray) returns immutable ByteArray
		return self.canonicalNameOfStruct(self.bareTupleAlias(name).tupleName)
	end 'tupleAliasTargetInAnyFile'

	export function tupleAliasTargetFrom(name ByteArray, readerFilePath FilePath) returns immutable ByteArray
		return self.canonicalNameOfStruct(self.tupleAliasNamed(name, readerFilePath: readerFilePath).tupleName)
	end 'tupleAliasTargetFrom'

	export function tupleAliasDenotedType(name ByteArray, readerFilePath FilePath, into TypeNameInterner) returns MaxonType
		let alias = self.tupleAliasNamed(name, readerFilePath: readerFilePath)

		if self.tupleAliasStandsForAGenericAlias(alias) 'aCapabilityOverAGenericAlias'
			return self.instanceDenotedType(self.genericAliasInstanceFrom(alias.tupleName, readerFilePath: alias.claim.declFilePath), into: into)
		end 'aCapabilityOverAGenericAlias'

		return MaxonType.structRef(into.intern(self.canonicalNameOfStruct(alias.tupleName)))
	end 'tupleAliasDenotedType'

	export function tupleAliasNamesAGenericAlias(name ByteArray, readerFilePath FilePath) returns bool
		return self.tupleAliasStandsForAGenericAlias(self.tupleAliasNamed(name, readerFilePath: readerFilePath))
	end 'tupleAliasNamesAGenericAlias'

	function tupleAliasStandsForAGenericAlias(alias DeclaredTupleAlias) returns bool
		return alias.capability != ParamCapability.unmarked and self.allFilesFolded and self.isAliasOfFormFor(alias.tupleName, readerFilePath: alias.claim.declFilePath, wanted: FormAliasKind.generic)
	end 'tupleAliasStandsForAGenericAlias'

	function tupleAliasNamed(name ByteArray, readerFilePath FilePath) returns DeclaredTupleAlias
		if not containsQualifier(name) 'aBareName'
			return self.tupleAliasUnder(self.bareWrittenKey(name, readerFilePath: readerFilePath), readerFilePath: readerFilePath, written: name)
		end 'aBareName'

		let written = self.writtenAlias(name, readerFilePath: readerFilePath, wanted: WantedAliasKinds.tuple)
		return self.tupleAliasUnder(written.keyOf(), readerFilePath: written.meaningFileOf(), written: name)
	end 'tupleAliasNamed'

	function tupleAliasUnder(key ByteArray, readerFilePath FilePath, written ByteArray) returns DeclaredTupleAlias
		if not self.holdsTupleAlias(key) 'noDeclarationUnderThisKey'
			panic("ProgramSignatures.tupleAliasNamed: '{String.from(written)}' names no single visible tuple alias — every caller asked `isAliasOfFormFor` of it first")
		end 'noDeclarationUnderThisKey'

		return self.scopedTupleAlias(key, readerFilePath: readerFilePath)
	end 'tupleAliasUnder'

	export function tupleAliasIsDeclaredIn(name ByteArray, readerFilePath FilePath) returns bool
		return self.scopedTupleAlias(name, readerFilePath: readerFilePath).claim.declFilePath.toString().equals(readerFilePath.toString())
	end 'tupleAliasIsDeclaredIn'

	// The tiers are `RangedAliasRegistry.lookup`'s, which holds the roster of every copy of this rule and the
	// reason they cannot be one function.
	function scopedTupleAlias(name ByteArray, readerFilePath FilePath) returns DeclaredTupleAlias
		if let byFile = try self.claimantsOf(name) 'contested'
			if let own = try byFile.get(readerFilePath.toString()) 'readersOwnFile'
				return own
			end 'readersOwnFile'

			return self.scopedTupleClaimant(byFile, readerFilePath: readerFilePath)
		end 'contested'

		return self.bareTupleAlias(name)
	end 'scopedTupleAlias'

	function scopedTupleClaimant(byFile TupleAliasByDeclaringFile, readerFilePath FilePath) returns DeclaredTupleAlias
		let claims = TypeNameClaimArray.create(byFile.count(), zeroed: false)

		for (_, claimant) in byFile 'eachClaimant'
			claims.push(claimant.claim)
		end 'eachClaimant'

		return try byFile.get(self.settledDeclarations().typeAliases.provenance.rankedDeclaringPath(claims, readerPath: readerFilePath.toString())) otherwise panic("ProgramSignatures.scopedTupleClaimant: the ranked declaring file is one of the files these claims were built from")
	end 'scopedTupleClaimant'

	function bareTupleAlias(name ByteArray) returns DeclaredTupleAlias
		return try self.aliasNamed(name) otherwise panic("ProgramSignatures.bareTupleAlias: '{String.from(name)}' is not a tuple typealias — every caller asks `isTupleAlias` first")
	end 'bareTupleAlias'

	// A tuple's field type ADOPTED into `into` — `fieldTypeOf`'s answer for every element at once, which is
	// what the parser needs to build the artifact's own copy of the layout (`ParseStaging.rewriteTypeIds` rewrites
	// an artifact layout's field types in place, so the index's copy may never be shared with it).
	export function adoptTupleLayout(name ByteArray, into TypeNameInterner) returns StructLayout
		let layout = try self.registeredLayout(name) otherwise panic("ProgramSignatures.adoptTupleLayout: `{String.from(name)}` is not registered — every caller reached here with a name `internTupleType` handed back")
		let adopted = MaxonTypeArray.create(layout.fieldTypes.count(), zeroed: false)

		for element in layout.fieldTypes 'eachElement'
			adopted.push(self.adoptType(element, into: into))
		end 'eachElement'

		return tupleStructLayout(name, elements: adopted, brands: layout.fieldDeclaredBrands.clone(), capabilities: tupleItemCapabilitiesOf(layout), declFilePath: layout.declFilePath)
	end 'adoptTupleLayout'

	// ⭐ **THE MIRROR OF `adoptType`: re-intern an id-bearing type INTO this index's own table.** `adoptType`
	// is the door this index's ids leave by; this is the one they arrive by, and the parser is its only caller
	// (a tuple's element types are minted against the FILE's interner and the layout registered here must not
	// carry a foreign id — the ID PROBLEM in this file's header). By NAME, never by raw id, exactly as its
	// mirror is.
	export function adoptTypeFrom(t MaxonType, from TypeNameInterner) returns MaxonType
		return match t 'r'
			named(id) gives MaxonType.named(self.typeNames.intern(foreignNameOf(from, id: id)))
			structRef(id) gives MaxonType.structRef(self.typeNames.intern(foreignNameOf(from, id: id)))
			function(id) gives MaxonType.function(self.typeNames.intern(foreignNameOf(from, id: id)))

			// Everything else carries no per-file interner id — a primitive, a `String`/`Character` (no name
			// at all), a type-parameter DIGEST (a pure function of source text, so global) and a
			// whole-program `GenericInstanceId` — so it crosses unchanged, exactly as `adoptType`'s own arms
			// state.
			boolean or
			integer or
			float or
			exitCode or
			unresolved or
			string or
			typeParameter or
			genericInstance or
			character or
			cstring gives t

			// An existential carries the INTERFACE's per-file interner id, so it arrives by NAME exactly as
			// `named`/`structRef`/`function` do.
			interfaceRef(id) gives MaxonType.interfaceRef(self.typeNames.intern(foreignNameOf(from, id: id)))
		end 'r'
	end 'adoptTypeFrom'

	// --- Generic-instance queries ---

	// Is `name` a declared generic-instance TYPEALIAS (`IntBox`)? THE hot-path guard the parser asks of
	// every type reference and every qualified-call base, so it must allocate nothing (`Map.contains`).
	export function isGenericAliasInAnyFile(name ByteArray) returns bool
		return self.settledDeclarations().genericAliases.contains(name)
	end 'isGenericAliasInAnyFile'

	// ⭐⭐ **THE FILE-LESS DOOR, AND IT REFUSES A CONTESTED NAME RATHER THAN GUESSING.** Precondition:
	// `isGenericAliasInAnyFile(name)`.
	//
	// Its callers are the ones that structurally cannot name a reader: the drop/clone cascades and the
	// layout-field probes, which read an instance's SHAPE (is it an `Array`? is its element managed? what is
	// its base?) off a struct FIELD's declared type. A field's type is recorded by the declaration SWEEP, as a
	// bare `named("Slots")` — the alias is not interned yet — and a `StructLayout` reaching those free
	// functions has no path travelling with it.
	//
	// ⚠ **A BARE ANSWER IS NOT SAFE HERE, AND THE DIFFERENCE IS A WILD FREE.** A range qualifier
	// changes only WHICH DECLARATION of one element name is meant — never the tag, the base or the
	// managed-ness — but two files' `typealias Bag` share nothing of the kind: one may be an `Array
	// with String` and the other an `Array with Num`, so the bare last-wins answer would route a
	// buffer of integers to `__destruct_Array_String` and free each element as a pointer. That is why
	// `settleGenericAliasContest` resolves every RECORDED field type against its own declaring file —
	// and why a spelling it missed must arrive here as a loud panic rather than as a plausible id.
	//
	// ⚠ **A CALLER THAT CANNOT NAME A READER *AND* CANNOT BE HANDED A LIVE SPELLING ASKS
	// `genericAliasSpellingIsSuperseded` FIRST** — the reader-free CLASSIFIERS, which whole-program walks drive
	// over an append-only registry that still holds pre-settle instances. That is not a bypass of this refusal;
	// it is the one case where the refusal is right and the caller must nevertheless not stop. See there.
	export function genericAliasInstanceInAnyFile(name ByteArray) returns GenericInstanceId
		if self.genericAliasSpellingIsSuperseded(name) 'contestedAndThisDoorNamesNoReader'
			panic("ProgramSignatures.genericAliasInstanceInAnyFile: '{String.from(name)}' is declared by two files over different instances, and this door names no reader to choose between them — `settleGenericAliasContest` resolves every recorded declared type against its declaring file, so a spelling reaching here is one that pass does not cover")
		end 'contestedAndThisDoorNamesNoReader'

		return self.bareGenericAliasInstance(name)
	end 'genericAliasInstanceInAnyFile'

	// ⭐⭐ **IS A GENERIC-ALIAS SPELLING ONE THE CONTEST HAS ALREADY REPLACED — i.e. is the instance carrying it
	// SUPERSEDED?** Precondition: `isGenericAliasInAnyFile(name)`.
	//
	// **THIS IS THE OTHER HALF OF `genericAliasInstance`'s REFUSAL, and it exists because a WHOLE-PROGRAM WALK
	// legitimately meets what that door legitimately refuses.** An instance's TYPE ARGUMENT is stored once, by
	// whichever pass first met `Box with Bag`, and the declaration SWEEP meets it before any contest can be
	// known — so `args[0]` is a bare `named("Bag")`. `settleGenericAliasContest` then re-interns every
	// declaration and every instantiation site SCOPED (`fileScopedArg` rewrites exactly such a `named` to that
	// file's mint), and the real parse resolves every written `Bag` through `genericAliasInstanceFrom`; the
	// registry is APPEND-ONLY, so the pre-settle instance stays in the by-base bucket beside its scoped
	// replacements. It is the registry's MEMORY of a spelling, not an instantiation the program has —
	// `IrModule.ops`' orphans under `liveOpIndices` are the same shape and the same rule.
	//
	// ⚠ **A CLASSIFIER THAT MEETS ONE MUST CONTRIBUTE NOTHING, NOT GUESS.** The two declarations of `Bag`
	// genuinely differ, and the reader-free classifiers (`typeArgIsOwned`, `typeSupportsDeepClone`) are read
	// by disjunctions over instantiations, where the scoped siblings in the
	// same bucket already carry the real answers. Each therefore returns ITS OWN identity for "classifies
	// nothing" — `false` for "nothing is consumed through a spelling no call site can name", `true` for
	// "nothing is refused for a spelling no copy site can name" — which is the answer the same program written
	// in ONE file gives, verified both ways.
	//
	// ⛔ The identity a caller needs is a property of the FOLD (`anyInstanceTypeArgHasKind` is an OR, so it
	// is `false`), never of a door's own polarity. `typeIsManaged` answers managed of a superseded spelling,
	// so a door built on it asks `typeArgSpellingIsSuperseded` itself, or the orphan votes a kind no live
	// instantiation has.
	//
	// ⚠ **MEASURED, and it is not hypothetical**: two files declaring `typealias Bag = Array with
	// <different element>` plus a `typealias BB = Box with Bag` reached `genericAliasInstance`'s refusal from
	// `noteDestructorUsage`'s opaque-element drop rooting while the single-file program compiles. The `Container with Bag`
	// deep-clone twin reaches it from `requireOpaqueArrayCopyable`.
	function genericAliasSpellingIsSuperseded(name ByteArray) returns bool
		match self.settledDeclarations().contestedGenericAliases 'index'
			unwritten then return false
			entries(byName) then return byName.contains(name)
		end 'index'
	end 'genericAliasSpellingIsSuperseded'

	// ⭐⭐ **THE INSTANCE A GENERIC-ALIAS NAME DENOTES TO A READER THAT NAMES NO FILE — THE THREE-QUESTION
	// SEQUENCE, ONCE.** Is the name an alias at all and has the CONTEST superseded this spelling —
	// both `namesALiveGenericAlias` — and only then the refusing door. Every reader-free classifier
	// wants exactly that composition, and written out at each of them it is the ORDER that drifts:
	// asking `genericAliasInstanceInAnyFile` before the superseded probe turns a whole-program walk
	// over the append-only registry into a panic (the probe's own header records two such walks),
	// and skipping the probe altogether makes a contested name a wrong TYPE rather than a compile
	// error.
	//
	// `throws` is `Map.get`'s own channel and carries BOTH negative answers, which is what every caller but
	// one wants. `typeSupportsDeepClone` is the exception and keeps its own outer `isGenericAliasInAnyFile`,
	// because it owes a THIRD answer: a name that is no alias falls through to the aggregate walk, while a
	// superseded one is admitted.
	export function liveGenericAliasInstance(name ByteArray) returns GenericInstanceId throws MapError
		if not self.namesALiveGenericAlias(name) 'namesNoLiveInstance'
			throw MapError.keyNotFound
		end 'namesNoLiveInstance'

		return self.genericAliasInstanceInAnyFile(name)
	end 'liveGenericAliasInstance'

	export function namesALiveGenericAlias(name ByteArray) returns bool
		return self.isGenericAliasInAnyFile(name) and not self.genericAliasSpellingIsSuperseded(name)
	end 'namesALiveGenericAlias'

	// ⚠ The second conjunct is not redundant of the first. `aliasNameIsDisagreedWith` holds every name
	// more than one DECLARATION mentions and compares no instances, so it catches two declarations that
	// denote the same one — without it each would credit the other and a true E3062 would be dropped.
	function namesTheSoleGenericAliasDeclaration(name ByteArray) returns bool
		return self.namesALiveGenericAlias(name) and not self.aliasNameIsDisagreedWith(name)
	end 'namesTheSoleGenericAliasDeclaration'

	// ⭐⭐ **THE SAME QUESTION ASKED OF A TYPE RATHER THAN A NAME** — for a classifier door that holds a
	// type and no `name`. It is the SAME fact and not a second one: it bottoms out in `genericAliasSpellingIsSuperseded` above, which is
	// the only reader of `contestedGenericAliases` for this purpose, so a change to what "superseded" means
	// cannot reach one door and miss the other. A tag that cannot name an alias at all answers `false` without
	// touching the interner, exactly as `typeArgIsOwned`'s own `tagMayNameAggregate` early-out does.
	function typeArgSpellingIsSuperseded(t MaxonType) returns bool
		if not tagMayNameAggregate(maxonTypeTag(t)) 'cannotNameAGenericAlias'
			return false
		end 'cannotNameAGenericAlias'

		let name = self.denotedSlotAggregateName(t)
		return self.isGenericAliasInAnyFile(name) and self.genericAliasSpellingIsSuperseded(name)
	end 'typeArgSpellingIsSuperseded'

	// The raw map read, with no contest test — the tier `scopedGenericAliasInstance` falls through to, and
	// the one `genericAliasInstance` guards. Split so the guard has exactly one bypass and it is named.
	function bareGenericAliasInstance(name ByteArray) returns GenericInstanceId
		return try self.settledDeclarations().genericAliases.get(name) otherwise panic("ProgramSignatures.bareGenericAliasInstance: '{String.from(name)}' is not a generic-instance alias — every caller asks isGenericAlias first")
	end 'bareGenericAliasInstance'

	// ⭐⭐ **THE INSTANCE A GENERIC-INSTANCE ALIAS NAMES, AS `readerFilePath` MEANS IT** — the door
	// the PARSER asks through, at every one of its alias resolutions, so a file's `__ManagedMemory`, its
	// `ByteArray.create(0)` and its `b"…"` literal cannot come to mean three different strides, and so its own
	// `typealias Slots = Array with Big` is what `Slots` means in it.
	//
	// It is a composition and not a third rule: WHICH DECLARATION is `scopedGenericAliasInstance`'s answer,
	// and WHOSE contested names are spelled `fileScopedInstance`'s way. Both are identities in a program with no
	// contest, which is every program in the corpus.
	export function genericAliasInstanceFrom(name ByteArray, readerFilePath FilePath) returns GenericInstanceId
		let written = self.writtenAlias(name, readerFilePath: readerFilePath, wanted: WantedAliasKinds.generic)

		return self.genericAliasInstanceUnder(written.keyOf(), readerFilePath: written.meaningFileOf(), written: name)
	end 'genericAliasInstanceFrom'

	function genericAliasInstanceUnder(key ByteArray, readerFilePath FilePath, written ByteArray) returns GenericInstanceId
		if let interfacesOwn = try self.settledDeclarations().interfaceAliases.get(key) 'anInterfacesOwnAlias'
			return interfacesOwn
		end 'anInterfacesOwnAlias'

		if not self.settledDeclarations().genericAliases.contains(key) 'noDeclarationUnderThisKey'
			panic("ProgramSignatures.genericAliasInstanceFrom: '{String.from(written)}' names no single visible generic alias — every caller asked `isAliasOfFormFor` of it first")
		end 'noDeclarationUnderThisKey'

		return self.fileScopedInstance(self.scopedGenericAliasInstance(key, readerFilePath: readerFilePath), filePath: readerFilePath)
	end 'genericAliasInstanceUnder'

	function genericAliasMintFor(name ByteArray, readerFilePath FilePath) returns immutable ByteArray
		let byFile = try self.genericAliasClaimantsOf(name) otherwise panic("ProgramSignatures.genericAliasMintFor: '{String.from(name)}' is not a contested generic alias, and only a contested name has a mint per declaration")
		let mints = try self.settledDeclarations().genericAliasMints.get(name) otherwise panic("ProgramSignatures.genericAliasMintFor: '{String.from(name)}' is contested and its mints were never recorded — `recordGenericAliasContest` files both together")

		match self.declaringFileMeantBy(name, byFile: byFile, readerFilePath: readerFilePath) 'meant'
			declaredIn(declPath) then return try mints.get(declPath) otherwise panic("ProgramSignatures.genericAliasMintFor: '{String.from(name)}' resolved to a declaration in '{declPath}', which holds no mint")
			unresolved then panic("ProgramSignatures.genericAliasMintFor: '{String.from(name)}' is contested and resolves to no declaration from '{readerFilePath.toString()}'")
		end 'meant'
	end 'genericAliasMintFor'

	function declaringFileMeantBy(name ByteArray, byFile GenericAliasByDeclaringFile, readerFilePath FilePath) returns MeantGenericDeclaration
		if byFile.contains(readerFilePath.toString()) 'readersOwnFile'
			return MeantGenericDeclaration.declaredIn(readerFilePath.toString())
		end 'readersOwnFile'

		match self.contestedGenericAliasDecl(name, readerFilePath: readerFilePath, participants: byFile) 'scoped'
			declared(decl) then return MeantGenericDeclaration.declaredIn(decl.filePath.toString())
			undeclared then return MeantGenericDeclaration.unresolved
		end 'scoped'
	end 'declaringFileMeantBy'

	// ⭐⭐ **WHICH DECLARATION OF `name` DOES `readerFilePath` MEAN?** — the reader's OWN file's
	// declaration first, then one the reader may actually NAME, and only then anyone else's, over the
	// generic-alias registry. The rule, the reason each tier is there and the roster of every copy of it live
	// at `RangedAliasRegistry.lookup`.
	//
	// ⚠ **AN UNCONTESTED NAME COSTS ONE MISS ON AN EMPTY MAP AND ALLOCATES NOTHING** — in particular
	// `readerFilePath.toString()` is built only after the contest probe HITS. That is
	// `RangedAliasRegistry.lookup`'s discipline and it matters for the same reason: this is asked at every
	// generic-alias type reference and every `IntArray.create()` base.
	function scopedGenericAliasInstance(name ByteArray, readerFilePath FilePath) returns GenericInstanceId
		if let byFile = try self.genericAliasClaimantsOf(name) 'contested'
			match self.declaringFileMeantBy(name, byFile: byFile, readerFilePath: readerFilePath) 'meant'
				declaredIn(declPath) then return try byFile.get(declPath) otherwise panic("ProgramSignatures.scopedGenericAliasInstance: '{String.from(name)}' resolved to a declaration in '{declPath}', which is not one of the files declaring it")
				unresolved then break
			end 'meant'
		end 'contested'

		return self.bareGenericAliasInstance(name)
	end 'scopedGenericAliasInstance'

	// The base STRUCT name a generic-instance id refers to (`Box` for `Box with Integer`) — what
	// `Parser.parseQualifiedCall` rewrites `IntBox.create` to `Box.create` through. The instance's
	// ARGUMENT types are not exposed: a member type is never SUBSTITUTED (a `T`
	// stays opaque), so nothing reads them out — the checks that need them (arity, managed) read them
	// straight off the parser-local `MaxonType` list at the instantiation site.
	export function genericInstanceBaseName(id GenericInstanceId) returns immutable ByteArray
		return self.nameOfId(self.genericInstanceBaseId(id))
	end 'genericInstanceBaseName'

	export function genericInstanceBaseId(id GenericInstanceId) returns TypeNameId
		return self.rowBaseId(id)
	end 'genericInstanceBaseId'

	// ⭐⭐ **THE TYPE A DECLARED NAME DENOTES WHEN THAT NAME MAY BE AN ALIAS FOR A GENERIC INSTANCE** —
	// `Bag.BagIter`, on a `typealias BagIter = BagIterator with Element`, answers `BagIterator`; every other
	// name answers ITSELF. `denotedAggregateName`'s convention one registry over, and it exists for the same
	// reason: a DECLARATION is filed under the type that declares it (`BagIterator.current`), and an alias is
	// not one of that type's names, so a question asked of an alias-spelled type's own declarations resolves
	// to nothing at all unless it comes through here first.
	//
	// ⛔⛔ **THE MISS IS THE NAME AND NOT `EmptySourceText`, WHICH IS THE WHOLE POINT.** The caller asks one
	// question of one name; if the two spellings of a cursor had to be routed by the caller they would be two
	// code paths, and this project's signature bug is exactly a mechanism that answers one spelling and not
	// its twin.
	//
	// ⭐⭐ **IT IS ALSO THE STRUCT A QUALIFIED CALL'S METHOD IS DECLARED ON** — a generic-instance alias
	// dispatches its statics to the BASE struct (The compiler compiles ONE body per generic type, so
	// `IntBox.create` links to `@Box.create`, byte-identical to the equivalent monomorphic call), and
	// every other name is already its own base. Two copies of one resolution is this project's
	// signature bug in the shape that bites hardest: the alias tiers here are
	// `scopedGenericAliasInstance`'s
	// three and `fileScopedInstance`'s rescope, and a fourth tier taught to one copy would resolve `BagIter`
	// to one base where the call that links against it mangles to another — a wrong SYMBOL, with no compile
	// error at either door.
	export function denotedGenericBaseName(name immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if not self.isAliasOfFormFor(name, readerFilePath: readerFilePath, wanted: FormAliasKind.generic) 'namesNoInstance'
			return name
		end 'namesNoInstance'

		return self.genericInstanceBaseName(self.genericAliasInstanceFrom(name, readerFilePath: readerFilePath))
	end 'denotedGenericBaseName'

	// ⭐ **IS INSTANCE `id` A GREEN-THREAD HANDLE RATHER THAN A BOX?** The one base whose values
	// own no `__mm_alloc` record — see `PromiseType.maxon`, which carries the whole argument. It lives HERE,
	// beside the base-name read, because `typeIsManaged` and `classifyUnionPayload` are both in this file and
	// both must answer it identically; the free function `typeIsPromiseStorage` is the same question asked of
	// a `MaxonType` rather than of an id, and it routes through this.
	export function instanceIsPromiseHandle(id GenericInstanceId) returns bool
		return self.genericInstanceBaseName(id).equals(PromiseTypeName)
	end 'instanceIsPromiseHandle'

	// ⭐⭐ **WHAT AN INSTANCE DENOTES IN A TYPE POSITION — AND OVER AN `interface` BASE THAT IS AN
	// EXISTENTIAL, NOT A BOX.** `Seq with Integer` names the fat pointer `Seq`, held with `Element` bound;
	// `Box with Integer` names `Box`'s box. Both are written `Base with Args`, and only the base's FORM tells
	// them apart, so the split lives here rather than at each of the three type-resolution doors that mint an
	// instance (`Parser.parseTypeReference`'s alias arm and its inner-alias arm, `Parser.resolveNamedAlias`).
	//
	// ⭐⭐ **THE `with` ARGUMENTS ARE NOT CARRIED ON THE EXISTENTIAL, AND THAT IS THE MECHANISM RATHER THAN A
	// GAP.** An interface this program DISPATCHES through has exactly ONE binding per associated type across
	// the whole program — that is E3119, and it is forced by dictionary-passing: the shared body is compiled
	// once, against one type, and every other conformer reinterprets those bits. Producing an existential IS
	// such a dispatch. So the binding is a function of the interface NAME, the conformances are where the
	// program states it (`StructLayout.conformanceBindings`, folded by `associatedAbiBindingOf`), and a copy
	// riding on the type would be one fact written twice with nothing keeping the two honest. What a use site
	// writes is therefore a CLAIM, verified whole-program by
	// `ConformanceCheck.checkInterfaceInstantiationBindings` (E3125) — never a second source of truth. The one
	// argument shape that is REFUSED outright rather than checked is one naming another interface: see
	// `Parser.DeclaredStoragePosition.associatedTypeBinding`, which is a second witness table and not a claim.
	//
	// ⚠ **`into` IS THE READER'S OWN INTERNER**, exactly as `interfaceNameOfType`'s is: the parser holds its
	// file's, this index holds its own, and an id minted in one is meaningless in the other.
	export function instanceDenotedType(gid GenericInstanceId, into TypeNameInterner) returns MaxonType
		let base = self.genericInstanceBaseName(gid)

		// `isInterfaceName`, NOT a bare `interfaces.entries.contains`: it is the ONE door, and it answers for
		// the SYNTHESIZED protocols (`Stringable`, `Hashable`, …) as well as for the user registry.
		if isInterfaceName(self.settledDeclarations().interfaces, name: base) 'anInterfaceInstance'
			return MaxonType.interfaceRef(into.intern(base))
		end 'anInterfaceInstance'

		return MaxonType.genericInstance(gid)
	end 'instanceDenotedType'

	// ⭐⭐ **THE INSTANCE A BARE GENERIC TYPE NAME DENOTES INSIDE A TYPE-PARAMETER SCOPE** — `Inner`
	// written in `type Outer uses T`'s body IS `Inner with Outer.T`. The compiler compiles ONE body per generic type,
	// so a member of `Outer` that names another generic type without arguments names it at the parameters the
	// body itself is written in: the arguments are not ABSENT, they are the enclosing scope's. It is the
	// declaration-view sibling of `genericAliasInstanceFrom` — that door answers for a name a `typealias`
	// bound to CONCRETE arguments, this one for a name the SCOPE binds.
	//
	// ⭐ **THE BINDING IS BY PARAMETER NAME, ALL-OR-NOTHING**: each of the named type's own `uses`
	// names must be one the scope declares, or nothing is minted at all. The MEMBERSHIP test is the
	// caller's (`Parser.scopeBindsEveryTypeParam`) because only the caller holds the scope; this door
	// mints, and mints only. It lives in the index rather than at a use site so there is one copy of
	// the algorithm.
	//
	// ⚠ **THE ARGUMENT AT POSITION `i` CITES THE SCOPE PARAMETER OF THE SAME SPELLING, NEVER POSITION `i` OF
	// THE SCOPE.** A parameter's identity is a digest of `(declaring type, parameter name)`, so the
	// argument list is built by looking each of the BASE's names up in the scope — a positional pairing would
	// bind `Inner`'s sole `T` to whatever the enclosing type happens to declare first, which for
	// `type MyMap uses Key, Value` naming a one-parameter helper is a silently wrong type.
	//
	// ⚠ No `shape`: a sized base (`FixedArray`) is a BUILTIN with no `StructLayout`, so it never reaches the
	// mint — the gate is `structTypeParamsOf`, which answers the shared empty for every name no `type`
	// declares.
	//
	// ⭐⭐ **THREE SCOPES ASK IT AND THEY ARE NOT THE SAME SCOPE**, which is why the scope arrives as a pair of
	// parameters rather than being read off any one of them:
	//   • the DECLARATION the cursor is inside — `Parser.bareGenericInstanceInScope`, for a written type
	//     reference (`returns Inner`) and a static-call base (`Inner.make(…)`);
	//   • the CALLEE's declaring type — `Parser.promoteBareGenericResultToCalleeScope`, because a call is typed
	//     from the token SWEEP's `returnTypeOf`, which records every bare generic name as a plain `named`;
	//   • the FIELD's declaring struct — `fieldTypeOf`, for the same reason one layer down: the layout this
	//     index holds is the SWEPT one;
	//   • the callee's declaring type AGAIN, from the SURFACE side — `declarationViewInstanceOf`, which needs
	//     the same instance the second asker mints and reads it a pass earlier, off the receiver's own base.
	export function scopedGenericInstanceOf(name ByteArray, declaringTypeName ByteArray, scopeParamNames NameRoster) returns ScopedGenericInstance
		// ⛔ **THE SCOPE'S OWN TYPE MEANS `Self`, NOT AN INSTANCE OVER ITS OWN PARAMETERS**, and that holds for
		// all three askers at once: the type's own name in its own body, a `Self`-returning method reached
		// through a receiver of that type, and a field of the very type declaring it. It is
		// `Parser.parseTypeReference`'s ARM ORDER — `namesEnclosingType` answers well above the scoped arm —
		// stated once for the doors that have no arms to order. ⚠ MEASURED without it
		// (`self-type-member-expression/static-call-through-Self-in-a-generic-type`): `Self.make(x)` inside
		// `type Box uses T` minted `Box with Box.T` and its result stopped satisfying `twice() returns Self` —
		// **`E3005: Cannot return 'Box_Tae9ed0372d6f16dc' from function declared to return 'Box'`**.
		if name.equals(declaringTypeName) 'ownNameMeansSelf'
			return ScopedGenericInstance.notInScope
		end 'ownNameMeansSelf'

		// ⚠ **GATED ON `allFilesFolded` for `Parser.parseTypeReference`'s stated reason**: the struct registry
		// is one the declaration SWEEP is still filling, so an ungated answer would depend on the order the
		// loader walked the disk. During the sweep every one of these names stays the bare `named` it always
		// was — which is exactly the answer the READ doors above exist to repair.
		if not self.allFilesFolded 'registryStillFilling'
			return ScopedGenericInstance.notInScope
		end 'registryStillFilling'

		// A NON-GENERIC declared type, and every name no `type` declares at all, answer the shared empty here —
		// so the whole generics-free corpus pays one map probe and allocates nothing.
		let baseParams = self.structTypeParamsOf(name)

		if baseParams.isEmpty() or not scopeBindsEveryTypeParam(baseParams, scopeParamNames: scopeParamNames) 'notBoundByThisScope'
			return ScopedGenericInstance.notInScope
		end 'notBoundByThisScope'

		return ScopedGenericInstance.instance(self.instanceOverScopeParams(name, scopeOwner: declaringTypeName, params: baseParams))
	end 'scopedGenericInstanceOf'

	// The mint the door above ends in, and the one below IS. `params` are the BASE's own `uses` names and
	// `scopeOwner` is whose parameters they cite — see the door's header for why those are two arguments and
	// not one, and why a positional pairing would be a silently wrong type.
	function instanceOverScopeParams(name ByteArray, scopeOwner ByteArray, params NameRoster) returns GenericInstanceId
		let args = MaxonTypeArray.create(params.count(), zeroed: false)

		for paramName in params 'eachParam'
			args.push(MaxonType.typeParameter(typeParamTokenFor(scopeOwner, paramName: paramName)))
		end 'eachParam'

		return self.internRow(self.typeNames.intern(name), args: args)
	end 'instanceOverScopeParams'

	// ⭐⭐ **WHAT `Self` DENOTES INSIDE A GENERIC CONTAINER WHOSE RECORD THE COMPILER ALREADY OWNS** —
	// the instance over the declaration's OWN parameters, which is exactly what the door above refuses to
	// build at its `ownNameMeansSelf` guard.
	//
	// ⚠ **THAT GUARD IS NOT BEING WEAKENED; ITS PREMISE SIMPLY DOES NOT HOLD FOR THIS ONE SHAPE.** The guard
	// says the type's own name in its own body means `Self`, and `Parser.enclosingSelfType` answers `Self`
	// with the base `structRef` — correct for an ordinary generic, whose body is compiled ONCE over the base
	// and whose results are retyped at the call site (`retypeGenericAliasConstructorResult`). A container the
	// compiler owns the RECORD of has no base box to be a `structRef` to: `Array with T` and
	// `__ManagedMemory with T` are one `GenericInstanceId` (`canonicalGenericBaseName`), so a value of it
	// inside the body is the buffer record, dropped by `__managed_decref` and not by any struct cascade. Answering
	// `structRef` there would be the byte-record defect `Parser.requireFusedWrapperTag` documents, one
	// genericity up: bytes of one record, identity of another.
	//
	// Precondition: `declarationIsTheManagedRecord` below, which is what establishes that the name is declared and
	// generic — so `structTypeParamsOf` is non-empty here and the instance has the arity its base was checked at.
	export function ownRecordSelfInstance(name ByteArray) returns GenericInstanceId
		return self.instanceOverScopeParams(name, scopeOwner: name, params: self.structTypeParamsOf(name))
	end 'ownRecordSelfInstance'

	// ⭐⭐ **IS `name`'s DECLARATION THE `__ManagedMemory` RECORD THIS COMPILER ALREADY OWNS?** — TWO facts,
	// the second of them a question about the FIELD rather than about the field's name.
	//
	// ⚠ **THE SHAPE HALF MUST NOT BE A QUESTION ABOUT A NAME.** Asking
	// `isArrayBaseName(name)` and then only that the declaration has a SOLE field which is
	// `inlineManagedFieldIndex() == 0` asks about the field's NAME (`managed`) and
	// the declaration's MARKER, never about the field's TYPE (`StructLayout.isInlineManagedField`). So a
	// `type Array uses Element implements BuiltinArrayLiteral` whose sole field is `var managed as Num`
	// answers TRUE, and `Parser.emitFusedWrapperLiteral`'s identity arm hands the raw `Num` back as the
	// array — bytes of one record, identity of another, which is the very hazard
	// `Parser.requireFusedWrapperTag` documents. MEASURED: that program is
	// refused only by the accident of a later type compare, as
	// **`E3005 … Cannot return 'int' from function declared to return 'struct'`**, a sentence about a
	// RETURN in a program whose fault is a field.
	//
	// ⇒ **THE SHAPE IS NOW: a SOLE field, and that field a `__ManagedMemory` under a declaration generic
	// enough to be one.** `firstFieldIsItsOwnBuffer` below is everything except the SOLE, split out because
	// `Parser.emitFusedWrapperLiteral` needs it that way — a declaration that has that field AND a second one
	// is the record with something extra bolted on, which earns its own positioned refusal rather than the
	// "the compiler owns no record for this name" sentence a stranger meets.
	//
	// ⚠⚠ **THE NAME HALF STAYS.** It is not "is this declaration
	// called `Array`" — it is "is this declaration the one `canonicalGenericBaseName` FOLDS `__ManagedMemory`
	// ONTO", and today that fold's target is a constant, so the two coincide. Drop it and a stranger's
	// `type Bag uses E implements BuiltinArrayLiteral` whose sole field is `__ManagedMemory with E` passes
	// the shape — but its field's instance is `Array with E`, the RECORD declaration's, not `Bag with E`, so
	// the identity arm hands back a value of a type `Self` is not and the clean positioned refusal
	// `Parser.requireFusedWrapperTag` gives it today degrades to an `E3005` about a return. The half that
	// CAN be structural has been made structural; the other half becomes so on the day the fold learns its
	// target from the conformance rather than from a constant, and then this line is the one that goes.
	//
	// ⚠ **IT LIVES HERE, NOT IN THE PARSER, BECAUSE THE INDEX ITSELF HAS TO ASK IT.** It serves the
	// parser's construction doors, and `typeParamOwnershipProtocol` asks it (through
	// `declarationsValueIsTheManagedRecord`) to decide whether a DESCRIPTOR carries ownership words, and a second spelling of "is this declaration the
	// record?" is exactly how the construction door and the descriptor stamp would come to disagree
	// about one type — with the disagreement spending itself as a double free rather than a
	// diagnostic.
	export function declarationIsTheManagedRecord(name ByteArray) returns bool
		return match self.structInAnyFile(name) 'declaration'
			declared(layout) gives layout.fieldCount() == 1 and self.firstFieldIsItsOwnBuffer(layout)
			undeclared gives false
		end 'declaration'
	end 'declarationIsTheManagedRecord'

	// ⭐⭐ **IS THIS DECLARATION'S FIRST FIELD A `__ManagedMemory`, UNDER A DECLARATION GENERIC ENOUGH TO BE
	// ONE?** — the shape half of the predicate above, and the ADMISSION gate of
	// `Parser.emitFusedWrapperLiteral`'s identity arm.
	//
	// ⚠⚠ **IT ASKS THE DECLARED SURFACE AND NOT THE FIELD'S `MaxonType`, AND THAT IS FORCED BY *WHEN* IT IS
	// ASKED.** The same question arrives at more than one resolution stage — the declaration sweep (through
	// `Parser.enclosingSelfType`) and the real parse — and the column holds a different thing at each: on
	// `stdlib/Array.maxon`'s own shape `fieldTypes[0]` can still be `named('Array.ElementMemory')`, the INNER
	// alias, because only a TOP-LEVEL generic alias is retyped by `resolveRecordedGenericAliasTypes`. A test
	// over the resolved instance therefore answers "how far the index had got", which is the class of bug
	// `Parser.declaredSurfaceAt` records for the tuple mask. The SURFACE is recorded from the SOURCE at
	// declaration time and reads the same at every stage (`SurfaceBitIsBuffer`).
	//
	// ⚠ **THE TYPE-PARAMETER CLAUSE IS WHAT KEEPS A NON-GENERIC CONFORMER OUT.** The record is generic over
	// its element by construction, so a `type Holder implements BuiltinArrayLiteral` whose field is the BARE
	// `__ManagedMemory` — a genuine buffer surface — is still not it, and must go on meeting
	// `Parser.requireFusedWrapperTag`'s sentence
	// (`array-declared-record.error.a-conformer-of-another-name-is-still-refused` pins that boundary).
	//
	// ⚠ **WHAT IT DOES NOT SEPARATE, NAMED RATHER THAN LEFT UNSAID**: a generic declaration whose field is
	// the bare `__ManagedMemory` (i.e. `Array with Byte`) also has the buffer surface, so it is admitted
	// here and refused one step later by the type compare against `Self`
	// (`Cannot return 'Array_Byte' from function declared to return 'Array_T…'`, MEASURED). That is a
	// REFUSAL with a poor noun, not a miscompile: the value's bytes and its type agree, they simply are not
	// the element the declaration promised. Separating it needs the alias's ARGUMENT, which is recorded on
	// `GenericAliasEntry` and has no by-name reader today.
	// ⭐⭐ **IS THIS DECLARATION THE RECORD OF A SIZED CONTAINER THE COMPILER SERVES — i.e. is it
	// `stdlib/FixedArray.maxon`'s own?** The predicate above answers for the ARRAY record, whose name is the
	// fold target of `__ManagedMemory`; this one answers for the container whose record IS an array's and whose
	// identity carries a second coordinate the array has no column for — the SIZE
	// (`GenericInstanceRegistry.fixedSizes`, see `FixedArrayBuiltinBaseName`).
	//
	// ⚠ **IT IS THE SAME SHAPE TEST AND A DIFFERENT NAME TEST, WHICH IS WHY IT IS NOT A WIDENING OF ITS
	// SIBLING.** `firstFieldIsItsOwnBuffer` gates the identity that hands the buffer back AS the array, and
	// widening it would make `isArrayBaseName` answer for `FixedArray` — which is exactly the wrong answer
	// `ProgramSignatures.noteArrayLiteralConformer`'s skip and `Parser.requireNameIsNotABuiltinContainerBase`
	// exist to prevent: a fixed-size container on the growable surface (`push`, `resize`) under its own name.
	// The value this admits is RETYPED to the declaration's own `Self` by its caller, so it never leaves that
	// door wearing the array's identity.
	// ⭐⭐⭐ **IS A *VALUE* OF THIS DECLARATION THE COMPILER'S OWN MANAGED RECORD?** — the question every
	// value-side door asks, and it is NOT `declarationIsTheManagedRecord`, which bundles a second one.
	//
	// That predicate answers *"is this the declaration `__ManagedMemory` FOLDS ONTO"* as well as *"is a value
	// of it the record"*, and for `stdlib/FixedArray.maxon` those two come apart: a `FixedArray`'s value IS the fused
	// 48-byte record — same bytes, same `__managed_decref` — while the fold target stays `Array`, because a
	// `__ManagedMemory with T` written anywhere is an array and not a fixed array (a fixed array's identity carries a
	// SIZE the buffer has no column for). Four doors want the FIRST question, and answering them with the
	// bundled one is what made `stdlib/FixedArray.maxon:48`'s `managed` read take the `String` path and come back
	// as a synthesized BYTE buffer: **`E3005 … expected 'FixedArray.ElementMemory', got 'Array___ManagedByte'`**,
	// which is `emitFieldLoad`'s own header's two silent wrongs (the element and the type parameter) arriving
	// as a diagnostic only by luck.
	export function declarationsValueIsTheManagedRecord(name ByteArray) returns bool
		return self.declarationIsTheManagedRecord(name) or self.declarationIsASizedContainerRecordNamed(name)
	end 'declarationsValueIsTheManagedRecord'

	// The BY-NAME form of the predicate below — `Parser.enclosingSelfType` holds a name and not a layout, and a
	// second reading of "is this the sized container's record?" is how the construction door and the `Self`
	// resolver would come to disagree about one declaration (`declarationIsTheManagedRecord`'s own reason for
	// living in this index rather than in the parser).
	export function declarationIsASizedContainerRecordNamed(name ByteArray) returns bool
		return match self.structInAnyFile(name) 'declaration'
			declared(layout) gives layout.fieldCount() == 1 and self.declarationIsASizedContainerRecord(layout)
			undeclared gives false
		end 'declaration'
	end 'declarationIsASizedContainerRecordNamed'

	// ⛔⛔ **IT IS THE CORPUS'S DECLARATION AND NOT ANY DECLARATION OF THAT NAME, WHICH IS THE WHOLE
	// DIFFERENCE BETWEEN THIS AND `isFixedArrayBaseName`.** That predicate is deliberately WIDE — it
	// answers for the container's own name AND for this compile's mint of it — because it decides what
	// a `FixedArray with N T` MEANS. This one decides who owns the RECORD, and a user's
	// `type FixedArray uses Element implements BuiltinArrayLiteral` is shaped identically to the corpus's
	// to the field: same sole `managed`, same `__ManagedMemory with Element`. Admitting it is the
	// wrong answer `Parser.requireNameIsNotABuiltinContainerBase` exists to refuse — a user fixed array
	// grown from three elements to nine through `push`/`resize`, compiling clean.
	//
	// ⚠ **MEASURED when this read `isFixedArrayBaseName`**: the delegating user conformer in
	// `array-declared-record.error.a-conformer-named-for-a-container-that-constructs-nothing-…` had its
	// `returns Self` answered with the RECORD instance, so its own `return FixedArray.init(managed)` was refused
	// **`E3005 Cannot return 'FixedArray' from function declared to return 'FixedArray_T…'`** — a sentence about the
	// user's own two lines, where the case pins the roster refusal three lines further down.
	//
	// ⭐ **THE CORPUS'S SPELLING IS `IrInterfaceMap.libraryNameOf`'s ANSWER, WHICH IS THE CONTEST WRITTEN
	// DOWN ONCE**: bare `FixedArray` when nothing contests it, and this compile's `__FixedArray` mint when a user program declares
	// the name — at which point the bare name is the USER's type and must not reach here.
	export function declarationIsASizedContainerRecord(layout StructLayout) returns bool
		if not layout.name.equals(self.settledDeclarations().interfaces.libraryNameOf(FixedArrayBuiltinBaseName)) or self.structTypeParamsOf(layout.name).count() != FixedArrayTypeParamCount 'notTheSizedContainersDeclaration'
			return false
		end 'notTheSizedContainersDeclaration'

		return self.declaredFieldsBeginWithABuffer(layout)
	end 'declarationIsASizedContainerRecord'

	export function firstFieldIsItsOwnBuffer(layout StructLayout) returns bool
		if not self.isArrayBaseName(layout.name) or self.structTypeParamsOf(layout.name).count() != ArrayTypeParamCount 'notTheRecordDeclaration'
			return false
		end 'notTheRecordDeclaration'

		return self.declaredFieldsBeginWithABuffer(layout)
	end 'firstFieldIsItsOwnBuffer'

	// ⭐ **DOES THIS DECLARATION'S FIRST FIELD NAME A `__ManagedMemory` IN THE SOURCE?** — the surface half
	// above, on its own, because `Parser.requireArrayMarkerDeclaresTheBuffer` asks exactly the NEGATION of it
	// and must not re-spell it: that refusal's whole sentence is "your first field is not a buffer", and a
	// second reading of "is it?" is how a refusal comes to be raised about a declaration that satisfies the
	// door it was refused by.
	export function declaredFieldsBeginWithABuffer(layout StructLayout) returns bool
		// ⚠ **TWO HALVES, AND DROPPING EITHER IS A WRONG ANSWER.** `inlineManagedFieldIndex` is the LAYOUT
		// half — is field 0 the one the envelope collapse embeds WHOLE, which it decides from the field's
		// name and the declaration's marker (`StructLayout.isInlineManagedField`). The surface is the TYPE
		// half — did the source name a `__ManagedMemory` there. A field named anything else has an 8-byte
		// POINTER slot however it is typed, so an identity on it would hand back a buffer where the record
		// holds a pointer to one; and a `managed` of any other type is the defect this predicate exists to
		// close.
		let managedIndex = try layout.inlineManagedFieldIndex() otherwise return false

		if managedIndex != 0 'field0IsNotEmbeddedWhole'
			return false
		end 'field0IsNotEmbeddedWhole'

		return surfaceIsBuffer(self.fieldSurfaceOf(layout, index: 0))
	end 'declaredFieldsBeginWithABuffer'

	// ⭐⭐ **IS `id` THE INSTANCE `declarationName` MAKES OVER ITS OWN PARAMETERS — i.e. what `Self` denotes
	// inside it?** The RECOGNIZER for what `ownRecordSelfInstance` MINTS, and it is a separate
	// function because its caller may not intern: `IrInterface.renderDeclaredTypeName` runs inside the
	// conformance check and re-spells a type against a declaration's own names rather than looking one
	// up, exactly as its `typeParameter` arm already does. Minting there to compare would put a write
	// on a read path.
	//
	// ⚠ **THE ARGUMENTS ARE CHECKED AND NOT ONLY THE BASE NAME.** `type Array uses Element` may perfectly
	// well mention an `Array with Byte`, which is NOT `Self` — rendering that as the bare declaration name
	// would make a genuinely different signature compare equal, a wrong ACCEPTANCE with nothing to report it.
	export function instanceIsDeclarationSelf(id GenericInstanceId, declarationName ByteArray, paramNames NameRoster) returns bool
		if not self.genericInstanceBaseName(id).equals(declarationName) 'anotherBase'
			return false
		end 'anotherBase'

		let args = self.rowArgs(id)

		if args.count() != paramNames.count() 'anotherArity'
			return false
		end 'anotherArity'

		for i in 0 upto paramNames.count() 'eachArg'
			let arg = try args.get(i) otherwise panic("ProgramSignatures.instanceIsDeclarationSelf: instanceArgs.get OOB at {i} — the count was just compared")
			let paramName = try paramNames.get(i) otherwise panic("ProgramSignatures.instanceIsDeclarationSelf: paramNames.get OOB at {i} — the count was just compared")

			if maxonTypeTag(arg) != ValueTypeTag.typeParameter or typeNameIdOf(arg) != typeParamTokenFor(declarationName, paramName: paramName) as TypeNameId 'notItsOwnParameter'
				return false
			end 'notItsOwnParameter'
		end 'eachArg'

		return true
	end 'instanceIsDeclarationSelf'

	// The registry keeps a declaration's own instance (`Box with T`) nested, because the composed create
	// route and the descriptor tables read it. The shared body is compiled once over the base, where `Self` is
	// `structRef(Box)`, so a declared type read back is mapped to that spelling here; unmapped, the two
	// spellings of one type refuse each other (E3005). A declaration whose value is the managed record is left
	// alone: its `Self` is the instance (`ownRecordSelfInstance`).
	export function declarationViewOfOwnInstance(t MaxonType, into TypeNameInterner) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.genericInstance 'notAnInstance'
			return t
		end 'notAnInstance'

		let id = genericInstanceIdOf(t)
		let base = self.genericInstanceBaseName(id)

		if not self.instanceIsDeclarationSelf(id, declarationName: base, paramNames: self.structTypeParamsOf(base)) or self.declarationsValueIsTheManagedRecord(base) 'notADeclarationsOwnInstance'
			return t
		end 'notADeclarationsOwnInstance'

		return MaxonType.structRef(into.intern(base))
	end 'declarationViewOfOwnInstance'

	// --- The `Array` builtin generic ---
	//
	// `Array` is a BUILTIN generic type with one type parameter `Element` — there is no `type Array uses
	// Element` declaration (The compiler does not read stdlib; the managed-memory runtime is synthesized like String's). So
	// its instances (`Array with Integer`) intern like any other, but they have no base `StructLayout`, and
	// every `genericInstance*` method that would read one (`baseLayoutOf`, box size, per-instance drop) must
	// special-case them. The box is a FIXED 48-byte record (`ManagedRecordBytes`, see ManagedMemoryRuntime), not
	// `fieldCount·8`. The one home of "is this instance an `Array`?" so no site respells the base name.

	// Is `name` the builtin `Array` type — the base of every array instance.
	//
	// ⭐⭐ **A CONTESTED `Array` MOVED INTO THE RESERVED SPACE IS STILL THAT BASE NAME.** When a user
	// program declares its own `type Array`, `contestStdlibTypeName` renames the CORPUS declaration to
	// `__Array` so the user's spelling wins the bare name — and this predicate, keyed on the spelling alone,
	// then answered FALSE about `stdlib/Array.maxon`'s own declaration. MEASURED: **`E2015 … '__Array'
	// implements 'BuiltinArrayLiteral' … the compiler mints that record only for the two names it owns the record FOR`**
	// at `stdlib/Array.maxon:111`, i.e. the compiler refusing the very file whose record it owns, in 21 cases.
	//
	// ⚠ **THE SPELLING MOVED; THE IDENTITY DID NOT, AND THE IDENTITY IS WHAT THIS ANSWERS.** It rests on
	// `Array with T` and `__ManagedMemory with T` being one `GenericInstanceId`, a fact about the DECLARATION
	// rather than about the six bytes it currently goes by. Both names answer true at once and must: the
	// user's `Array` is a container it declared, and `declarationIsTheManagedRecord` tells the two apart by SHAPE,
	// exactly as it already had to for a user `Array` with no contest at all.
	//
	// ⚠ **`Array` IS THE ONE CONTESTED NAME THIS BITES, WHICH IS WHY ITS SIBLINGS TAKE NO SUCH ARM.**
	// `Map` and `Set` are off the builtin roster entirely, because a corpus `Map` is an
	// ordinary declared generic and nothing about it is served by name. An `Array` never stops being
	// compiler-owned — its record IS its buffer — so its surface is served by name for as long as it exists.
	//
	// ⭐⭐ **AND THE NAMES ARE DISCOVERED FROM THE MARKER, NOT SPELLED HERE.** The first arm is
	// every `type <Name> … implements BuiltinArrayLiteral` the program declares — the corpus's, a user's own
	// `Array` under a contest, and a conformer of any other name. The second is that corpus declaration
	// MOVED, which is a name no declaration spells in its own source.
	export function isArrayBaseName(name ByteArray) returns bool
		if name.equals(self.settledDeclarations().corpusArrayRecordName.name) 'theRecordsOwnName'
			return true
		end 'theRecordsOwnName'

		// ⚠ **THE SET IS BEHIND A BOOL, AND THAT BOOL IS FALSE FOR THE WHOLE EXISTING CORPUS.** This predicate
		// sits on every array question in the program and the set lookup is not free, so a program that
		// declares no conformer of its own pays one bool test for the widening — the same gate
		// `IrInterfaceMap.hasLibraryRenames` puts in front of the contest's own costs.
		if self.hasNonCorpusArrayConformer and self.declaresTheArrayLiteralMarker(name) 'anotherDeclaredConformer'
			return true
		end 'anotherDeclaredConformer'

		// The shape test, for `Parser.requireUnreservedName`'s measured reason: no ordinary name can reach the
		// contest's mint, so the prefix rules the remaining question out before the map is consulted.
		if not isCompilerReservedName(name) 'notAMintedName'
			return false
		end 'notAMintedName'

		return name.equals(self.arrayRecordBaseName())
	end 'isArrayBaseName'

	// ⭐⭐ **THE NAME(S) AN `Array` DECLARATION GOES BY IN THIS COMPILE — the ENUMERATION behind the predicate
	// above.** One normally. TWO when a user program declares its own container: the user's under the
	// bare `Array` and `stdlib/Array.maxon`'s under this compile's mint.
	//
	// ⚠ **IT IS FOR THE ASKER THAT NEEDS EVERY DECLARATION.** A door holding a resolved receiver reads its
	// own declaration off the instance (`genericInstanceBaseName`, which is exact);
	// `Parser.refuseArrayMemberTheOtherDeclarationCarries` asks about the OTHER one, so it walks the union.
	export function arrayDeclarationNames() returns NameRoster
		let names = NameRoster.create(0)

		for name in self.settledDeclarations().arrayLiteralConformers 'eachDeclaredConformer'
			names.push(name)
		end 'eachDeclaredConformer'

		if not self.declaresTheArrayLiteralMarker(self.settledDeclarations().corpusArrayRecordName.name) 'theCompilerMintsTheRecordItself'
			names.push(self.settledDeclarations().corpusArrayRecordName.name)
		end 'theCompilerMintsTheRecordItself'

		let corpus = self.arrayRecordBaseName()

		if not corpus.equals(self.settledDeclarations().corpusArrayRecordName.name) 'theCorpusDeclarationMoved'
			names.push(corpus)
		end 'theCorpusDeclarationMoved'

		return names
	end 'arrayDeclarationNames'

	// Is generic instance `id` an `Array with T`? (Reads the base NAME, which needs no base struct.)
	export function isArrayInstance(id GenericInstanceId) returns bool
		return self.isArrayBaseName(self.genericInstanceBaseName(id))
	end 'isArrayInstance'

	export function isCorpusArrayInstance(id GenericInstanceId) returns bool
		return self.genericInstanceBaseName(id).equals(self.arrayRecordBaseName())
	end 'isCorpusArrayInstance'

	// ⭐⭐ **DOES THIS (tag, id) PAIR DENOTE AN `Array with T`? — the ONE home of the two-part test, and the
	// TAG HALF IS THE LOAD-BEARING ONE.** `isArrayInstance` above takes a `GenericInstanceId`,
	// and a `TypeNameId` is the SAME numeric space: handed a plain `named` id it walks the instance registry
	// at that number and can answer TRUE about an instance the caller never had — a wrong answer, never a
	// compile error, because both spellings type-check (`Parser.typeIsArrayInstance` carries the measurement).
	//
	// ⚠ **SO THE TAG TEST MAY NOT BE A CONVENTION THAT EVERY CALLER REMEMBERS.** It was spelled out at SEVEN
	// sites across `Parser` and this file — five value/receiver doors, a declared-TYPE door and two byte
	// doors — each free to drift from the others, and a site that dropped the tag half would look exactly
	// like the six that kept it. One home, so "remembering" is not a thing a caller can fail to do.
	export function isArrayInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.isArrayInstance(nameId as GenericInstanceId)
	end 'isArrayInstanceAt'

	// The element TYPE of a ONE-ARGUMENT container instance — `Array with T` or `List with T` — its sole type
	// argument, in this index's own interner.
	//
	// ⚠ **IT SERVES BOTH CONTAINERS AND IS NOT `Array`-SPECIFIC, WHICH IS WHY IT DOES NOT WEAR THAT NAME.**
	// The canonicalization below is a fact about how an INSTANCE ARGUMENT is stored, not about what holds it,
	// and a `List with Tagged` hits the identical unresolved-symbol panic through its own
	// `element_drop@24` stamp. A second `listElementType` would be this whole header copied — and what
	// matters is the one line of canonicalization, which is exactly the line a copy drops.
	//
	// ⭐⭐ **A TUPLE ARGUMENT IS CANONICALIZED ON THE WAY OUT, and that rewrite is `canonicalInstanceArg`'s
	// — this function is a CALLER of it, not a second home for it.** MEASURED, not argued:
	// `typealias Tagged = (Num, String)` is folded by the SWEEP, which spells its elements the way the source
	// did, so `typealias TaggedArray = Array with Tagged` stored `structRef(__Tuple2.Num.String)` — while
	// every VALUE the array holds carries the canonical `__Tuple2.int.String`, and only THAT layout reaches
	// `installStructDestructors` (an artifact records only what the real parse minted). The `element_destroy@40`
	// stamp therefore named `__destruct___Tuple2.Num.String` and the x64 backend died on the unresolved
	// symbol — `panic … resolveCallFixups: call to unknown function`. Every semantic fact the
	// array derives from its element — managed-ness, the drop callee, the clone strategy, the element size —
	// reads the layout the elements ACTUALLY carry.
	//
	// ⚠ **THE INSTANCE'S OWN COMPILED NAME IS DELIBERATELY NOT CANONICALIZED**: `mangleGenericInstance` reads
	// `instanceArgs` directly. Rewriting it there would give a sweep-spelled instance and a canonically-spelled
	// one the SAME symbol while they remain two gids — the `E3006 duplicate definition` shape
	// `builtinInstanceForNamedElement` documents. That the two stay two TYPES is a known residual:
	// `Array with Tagged` and an `Array` of the same tuple minted from a literal do not unify, reported as an
	// honest argument-type mismatch naming both spellings. Unifying them means MERGING two gids in the
	// registry, which is a change to instance identity itself and not something a read door may make.
	export function containerElementType(id GenericInstanceId) returns MaxonType
		return self.canonicalInstanceArgAt(id, position: ContainerElementArgPosition)
	end 'containerElementType'

	// ⭐ **THE CANONICAL CONFORMER NAME OF A CONTAINER'S ELEMENT** — the key its conformance answer
	// (`ConformanceCheck.typeConformsTo`), its `__witness_<conformer>.<Iface>` table and its
	// `<conformer>.<method>` impl symbol are all filed under. `Integer` reduces to `int`, a struct keeps its
	// own name; the reduction is `conformerNameOfType`'s, shared with the hash-table key path, so an
	// `Array with Integer` and a `Set with Integer` cannot name two different `int` tables.
	//
	// ⚠ It goes through `containerElementType` rather than through `conformerTypeArgName(id, position: 0)`,
	// and that is not a spelling preference: the element accessor CANONICALIZES a tuple `structRef` (see its
	// header for the unresolved-symbol crash that fix is), and a witness label minted off the un-canonical
	// spelling would name a table nothing registers.
	//
	// One question, whatever the caller does with it: `arrayElementConstraintCheck` asks it to decide whether
	// `Array`'s conditional conformance holds on this receiver at all — and through it the front end's
	// withholding and the conformer-name reduction. The readers are deliberately NOT counted here: a number
	// beside the thing it counts is one edit away from being wrong.
	export function containerElementConformerName(id GenericInstanceId) returns String
		return self.conformerNameOfType(self.containerElementType(id), idsFrom: self.typeNames, readerFilePath: CompilerOwnedDeclFilePath)
	end 'containerElementConformerName'

	// ⭐⭐ **DOES A CONTAINER INSTANCE'S ELEMENT SATISFY A CONDITIONAL EXTENSION'S `where` CLAUSE? — THE ONE
	// WALK, FOR EVERY DOOR THAT ASKS (array-hashable; unified at the tick's review).** `Array`'s conditional
	// conformance is asked at doors whose CONSEQUENCES differ — the front end WITHHOLDS a method
	// (`Parser.requireArrayConformanceAvailable`), the reduction collapses the instance's conformer name to
	// `Array` (`arrayElementCarriesConformance`, and through it every `__witness_Array.*` stamp, every
	// admitted hash-table key and every `where T is Hashable` slot) — and a second copy of the walk lets those
	// two answer differently with nothing failing to compile: `a == b` refused while the same array is still
	// stamped and keyed, or the reverse. One walk, and each caller keeps only its own consequence.
	//
	// ⭐ **IT IS THE `where` HALF OF THE CONFORMANCE, ASKED AT THE ONE PLACE THAT STILL HAS AN INSTANCE.**
	// Everything downstream of `conformerNameOfType` works in NAMES — a name cannot carry an element — so the
	// conditional half has to be discharged by the reduction itself; see that function's `Array` arm.
	//
	// ⭐ **THE CLAUSE IS A PARAMETER SO THAT THIS WALK NEVER STATES ONE.** `Array`'s compiler-owned clause is
	// the conformance's `where Element is Hashable and Equatable`; `contains`'s `where Element is
	// Equatable` is the corpus extension's that declares it. See `Parser.arrayWhereClause`.
	//
	// It answers in `ExtensionConstraintCheck`, the verdict a USER's conditional extension is filtered by
	// (`ConformanceCheck.checkExtensionConstraints`), so the compiler-owned clause and the parsed one are
	// reported through one shape: the failing arm carries the constraint and the binding every diagnostic
	// here names, and a caller cannot reach for either after a `satisfied`.
	//
	// ⚠ An OPAQUE element (`Array with T` inside a generic body) satisfies the clause exactly when
	// `T`'s own `where` clause promises each interface (`opaqueParamDischarge`): every instantiation
	// then binds `T` to a conforming type.
	//
	// ⚠ **IT IS MUTUALLY RECURSIVE and terminates on ELEMENT-NESTING DEPTH**: `containerElementConformerName`
	// -> `conformerNameOfType` -> `instanceConformerReduction` -> `arrayElementCarriesConformance` ->
	// here, which is how an `Array with (Array with E)` gets the inner array's own conditional conformance
	// decided before the outer's. Each hop strictly descends into an ELEMENT, and a type cannot contain
	// itself (a self-naming typealias is E2012 before any of this runs — MEASURED), so there is no cycle to
	// guard against.
	export function arrayElementConstraintCheck(id GenericInstanceId, clauseInterfaces NameRoster) returns ExtensionConstraintCheck
		let elementType = self.containerElementType(id)

		if maxonTypeTag(elementType) == ValueTypeTag.typeParameter 'anOpaqueElement'
			return self.opaqueElementConstraintCheck(id, elementType: elementType, clauseInterfaces: clauseInterfaces)
		end 'anOpaqueElement'

		let element = freeze self.containerElementConformerName(id).toByteArray()

		for interfaceName in clauseInterfaces 'eachConstraint'
			if not typeConformsTo(self.sweptConformanceIndex(), interfaces: self.settledDeclarations().interfaces, typeName: element, interfaceName: interfaceName, discovered: self.discoveredConformerOf(element)) 'violates'
				return ExtensionConstraintCheck.unmet(interfaceName, bindingName: element)
			end 'violates'
		end 'eachConstraint'

		return ExtensionConstraintCheck.satisfied
	end 'arrayElementConstraintCheck'

	function opaqueElementConstraintCheck(id GenericInstanceId, elementType MaxonType, clauseInterfaces NameRoster) returns ExtensionConstraintCheck
		for interfaceName in clauseInterfaces 'eachConstraint'
			if not opaqueConstraintIsDischarged(opaqueParamDischarge(self, interfaces: self.interfaceMap(), token: typeParamIdOf(elementType), interfaceName: interfaceName)) 'unpromised'
				return ExtensionConstraintCheck.unmet(interfaceName, bindingName: self.instanceArgDisplayName(id, position: ContainerElementArgPosition))
			end 'unpromised'
		end 'eachConstraint'

		return ExtensionConstraintCheck.satisfied
	end 'opaqueElementConstraintCheck'

	// ⭐⭐ **DOES THIS ARRAY INSTANCE'S ELEMENT SATISFY `Array`'s CONDITIONAL CONFORMANCE (array-hashable)?**
	// — `where Element is Hashable and Equatable`, read off `arrayConformanceProtocolNames` so the clause
	// enforced here, the clause a withheld method is refused with, and the row
	// `IrInterface.isIntrinsicBuiltinConformance` states for the array record are one list.
	export function arrayElementCarriesConformance(id GenericInstanceId) returns bool
		return match self.arrayElementConstraintCheck(id, clauseInterfaces: self.arrayConformanceProtocolNames()) 'clause'
			satisfied gives true
			unmet gives false
		end 'clause'
	end 'arrayElementCarriesConformance'

	// Byte equality is element equality only where equal values have equal bits and every value equals
	// itself — never a float (`0.0 == -0.0`, `NaN != NaN`) and never an element that declares its own
	// `equals`. Admitting one would make `__managed_eq` and the stdlib body give two answers for one
	// pair.
	export function arrayEqualityIsBitwise(id GenericInstanceId) returns bool
		return match self.arrayElementClass(id) 'class'
			integer or
			namedValue or
			booleanOrExitCode gives not self.elementDeclaresItsOwn(self.containerElementType(id), member: EqualsMethodName)
			floatValue or
			notBitwise gives false
		end 'class'
	end 'arrayEqualityIsBitwise'

	function isLibraryArrayInstance(id GenericInstanceId) returns bool
		return self.isArrayInstance(id) and self.genericInstanceBaseName(id).equals(self.arrayRecordBaseName())
	end 'isLibraryArrayInstance'

	function isInlineSlotOfLibraryArray(id GenericInstanceId) returns bool
		return self.isLibraryArrayInstance(id) and not self.typeOccupiesAPointerSlot(self.containerElementType(id)) and not self.containerElementIsOpaque(id)
	end 'isInlineSlotOfLibraryArray'

	function arrayElementClass(id GenericInstanceId) returns ArrayElementClass
		if not self.isInlineSlotOfLibraryArray(id) 'notAnInlineSlot'
			return ArrayElementClass.notBitwise
		end 'notAnInlineSlot'

		let element = self.containerElementType(id)

		return match maxonTypeTag(element) 'tag'
			boolean or
			exitCode gives ArrayElementClass.booleanOrExitCode
			integer gives ArrayElementClass.integer
			named gives self.namedElementClass(self.nameOfId(typeNameIdOf(element)))
			float or
			unresolved or
			void or
			structRef or
			string or
			function or
			typeParameter or
			genericInstance or
			character or
			interfaceRef or
			cstring gives ArrayElementClass.notBitwise
		end 'tag'
	end 'arrayElementClass'

	function nameIsAnUndeclaredByteElement(name ByteArray) returns bool
		return isByteElementName(name) and not self.settledDeclarations().typeAliases.anyFileDeclares(name) and not self.containsEnumInAnyFile(name)
	end 'nameIsAnUndeclaredByteElement'

	function namedElementClass(name ByteArray) returns ArrayElementClass
		if self.nameIsAnUndeclaredByteElement(name) 'theUndeclaredByteElement'
			return ArrayElementClass.namedValue
		end 'theUndeclaredByteElement'

		if not self.settledDeclarations().typeAliases.anyFileDeclares(name) 'noFileDeclaresIt'
			return ArrayElementClass.notBitwise
		end 'noFileDeclaresIt'

		return ArrayElementClass.floatValue if self.settledDeclarations().typeAliases.declaredAsFloatInAnyFile(name) else ArrayElementClass.namedValue
	end 'namedElementClass'

	function elementDeclaresItsOwn(element MaxonType, member ByteArray) returns bool
		return self.userDeclaresMember(self.conformerNameOfType(element, idsFrom: self.typeNames, readerFilePath: CompilerOwnedDeclFilePath).toByteArray(), member: member)
	end 'elementDeclaresItsOwn'

	function elementLoadsAsItsValue(id GenericInstanceId) returns bool
		if self.arrayElementSize(id) >= ThirtyTwoBitElementBytes 'aWordOrWider'
			return true
		end 'aWordOrWider'

		return match self.elementIntegerValueRange(id, readerFilePath: CompilerOwnedDeclFilePath) 'range'
			notIntegerValued gives false
			inclusive(low, _) gives low >= 0
		end 'range'
	end 'elementLoadsAsItsValue'

	export function arrayBitwiseKind(id GenericInstanceId) returns ArrayBitwiseKind
		return match self.arrayElementClass(id) 'class'
			notBitwise gives ArrayBitwiseKind.neither
			floatValue gives self.floatArrayBitwiseKind(id)
			integer gives self.afterUserDeclarations(id, natural: ArrayBitwiseKind.equalsAndHash)
			namedValue gives self.afterUserDeclarations(id, natural: ArrayBitwiseKind.equalsAndHash if self.elementLoadsAsItsValue(id) else ArrayBitwiseKind.equalsOnly)
			booleanOrExitCode gives self.afterUserDeclarations(id, natural: ArrayBitwiseKind.equalsOnly)
		end 'class'
	end 'arrayBitwiseKind'

	function floatArrayBitwiseKind(id GenericInstanceId) returns ArrayBitwiseKind
		if self.arrayElementIsMachineWord(id) and not self.elementDeclaresItsOwn(self.containerElementType(id), member: HashMethodName) 'hashedByFloatBits'
			return ArrayBitwiseKind.floatHashOnly
		end 'hashedByFloatBits'

		return ArrayBitwiseKind.neither
	end 'floatArrayBitwiseKind'

	function afterUserDeclarations(id GenericInstanceId, natural ArrayBitwiseKind) returns ArrayBitwiseKind
		let element = self.containerElementType(id)

		if self.elementDeclaresItsOwn(element, member: EqualsMethodName) 'theProgramOwnsEquals'
			return ArrayBitwiseKind.neither
		end 'theProgramOwnsEquals'

		if natural == ArrayBitwiseKind.equalsAndHash and self.elementDeclaresItsOwn(element, member: HashMethodName) 'theProgramOwnsHash'
			return ArrayBitwiseKind.equalsOnly
		end 'theProgramOwnsHash'

		if natural == ArrayBitwiseKind.equalsAndHash 'hashedNatively'
			self.requireNativeHashSlotWidth(id)
		end 'hashedNatively'

		return natural
	end 'afterUserDeclarations'

	function requireNativeHashSlotWidth(id GenericInstanceId)
		let stride = self.arrayElementSize(id)

		if stride < 0 or stride == EightBitElementBytes or stride == SixteenBitElementBytes or stride == ThirtyTwoBitElementBytes or stride == SixtyFourBitElementBytes 'onTheLadder'
			return
		end 'onTheLadder'

		panic("SignatureIndex.requireNativeHashSlotWidth: an array element slot of {stride} bytes is hashed natively, but only 1, 2, 4 and 8-byte slots and sub-byte packed slots load zero-extended inside [-2^32, 2^32), where the native hash and the stdlib body agree")
	end 'requireNativeHashSlotWidth'

	export function calleeIsArrayRecordMember(callee ByteArray, member ByteArray) returns bool
		return qualifiedNameIs(callee, typeName: self.arrayRecordBaseName(), member: member)
	end 'calleeIsArrayRecordMember'

	// ⭐⭐ **THE DECLARED RANGE OF AN `Array` INSTANCE'S ELEMENT, AS `readerFilePath` RESOLVES IT** — the
	// BOUNDS twin of `arrayElementSize`, and the question a value being stored INTO the instance has to be
	// asked (`Parser.requireByteStringBlobFitsItsElement`).
	//
	// ⚠ **IT READS THE ELEMENT OFF THE INSTANCE RATHER THAN RE-DERIVING THE NAME, AND THAT IS THE POINT.**
	// `Byte` is a name a program may declare, so a range-contested one wears the reader's own mint
	// (`RangedAliasRegistry.rangeScopedName`) by the time it is an instance's type argument. Spelling the
	// element a second time here — `aliasOf(ByteElementTypeName, …)` at the call site — would be a second
	// derivation of a fact the instance already carries, free to disagree with the very `arrayElementSize`
	// its answer is paired with. One instance, one element, one range.
	//
	// A non-`named` element (an `int`, a `String`, a nested instance) is `undeclared`: there is no ranged
	// alias to have bounds, which is the same answer a `named` element no file declares gets, and both mean
	// "no declared range constrains this element" to every caller.
	export function arrayElementAliasOf(id GenericInstanceId, readerFilePath FilePath) returns DeclaredAlias
		let element = self.containerElementType(id)

		if maxonTypeTag(element) != ValueTypeTag.named 'notANamedElement'
			return DeclaredAlias.undeclared
		end 'notANamedElement'

		return self.settledDeclarations().typeAliases.lookup(self.nameOfId(typeNameIdOf(element)), readerFilePath: readerFilePath)
	end 'arrayElementAliasOf'

	// --- The `Set` generic ---
	//
	// The hash-table twin of the `Array` section above. `stdlib/Set.maxon` declares `Set`, so a `Set
	// with T` is an ordinary declared generic instance with a real `StructLayout`, a
	// `__destruct_Set_<T>` cascade and corpus `create`/`insert`/`contains`/`remove`/`count` bodies.

	// ⇒ **THE SHAPE QUESTIONS ARE THE ONLY ONES**: `isSetShapedInstance` and `isMapShapedInstanceAt`
	// ask what the container IS, off the base NAME. Every `Set` and `Map` is served by its declared
	// record, so there is no second regime for a predicate to choose between.

	// ⭐⭐ **DOES INSTANCE `id` DENOTE THE `Set` CONTAINER — WHOEVER SERVES IT?** The SHAPE question,
	// `isMapShapedInstanceAt`'s twin. `Parser.namesContainerInstanceAlias` asks it of a `from` head: asked
	// which runtime serves the set instead, every alias head reads as no construction and `CharSet from ['x']`
	// is **`E2004: Undefined variable 'CharSet'`**.
	//
	// ⚠ It takes a bare `GenericInstanceId` where the `Map` twin takes a (tag, id) pair, because its caller
	// holds an instance the ALIAS REGISTRY handed back (`genericAliasInstanceFrom`) rather than a value's
	// (tag, nameId) columns — so the numeric-space hazard `isArrayInstanceAt` exists for cannot arise here.
	export function isSetShapedInstance(id GenericInstanceId) returns bool
		return self.genericInstanceBaseName(id).equals(SetBuiltinBaseName)
	end 'isSetShapedInstance'

	// ⭐⭐ **THE TWO QUESTIONS A CONTAINER COLUMN ASKS OF ITS SLOT TYPE, keyed on the TYPE and not on the
	// container.** An `Array`'s element, a `Set`'s key, a `Map`'s key and a `Map`'s VALUE are four columns
	// asking one pair of questions — *does this slot own heap?* and *what drops it?* — and the answer must be
	// the same for all four or a value moved in through one door and dropped through another leaks or
	// double-frees. `Map` has TWO independently managed columns, so the pair is keyed on the type: a
	// per-container `…KeyIsManaged` / `…KeyDropCallee` pair would be written twice in one type.
	//
	// The drop callee is the SHARED `managedFieldDropCallee`, so a column's stamped destructor equals the drop
	// a managed FIELD of the same type gets — the moved-in value and the dropped value agree by construction.
	// Precondition of the second: `typeOwesDrop`, which also admits a promise slot.
	export function slotTypeIsManaged(slotType MaxonType) returns bool
		return self.typeIsManaged(slotType, from: self.typeNames)
	end 'slotTypeIsManaged'

	export function slotTypeDropCallee(slotType MaxonType) returns immutable ByteArray
		return managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: slotType)
	end 'slotTypeDropCallee'

	// ⭐ **IS THIS `named` TYPE A DECLARED BOXED UNION — the one `named` whose storage is not in doubt?** Every
	// case of such a union is a single heap pointer, which is what lets it occupy a one-word record slot while
	// the other `named` records (a tuple alias, a generic alias) may not until something re-tags them.
	// `denotedSlotType` deliberately re-tags neither enum nor union, and says why: a `named` IS their type.
	//
	// ⚠ Gated on the NON-ALLOCATING `containsEnum` twin, for `undeclaredNamedElementSlot`'s measured reason —
	// `enumOf` boxes a `DeclaredEnum` even to answer `undeclared`.
	function namedTypeIsBoxedUnion(valueType MaxonType) returns bool
		let name = try self.typeNames.nameOf(typeNameIdOf(valueType)) otherwise return false
		return self.containsEnumInAnyFile(name) and self.declaredEnumIsBoxed(name)
	end 'namedTypeIsBoxedUnion'

	// ⭐⭐ **DOES A SLOT THAT IS EXACTLY ONE MACHINE WORD WIDE HOLD THIS TYPE? — the admission rule a
	// `List`/`__ManagedList` ELEMENT and a `Map`'s VALUE column both ask, stated once.** Both slots are one
	// word (`ListRuntime`'s `value@16`, the map's value buffer stride) and both are torn down by the SAME
	// stamped destructor (`Parser.columnDestroyValue` → `slotTypeDropCallee` above), so the set of types they
	// admit is one set: a MANAGED type (String / Character / struct / boxed union / instance / nested
	// container, each held as its 8-byte heap pointer) or a WORD-SHAPED one (`int`, a ranged-int alias, a
	// declared enum, a function alias, `bool`, `Character`… — all stored inline).
	//
	// ⚠ **A `Map`'s VALUE MUST NOT BE ASKED THE KEY'S QUESTION — THAT REFUSES PROGRAMS THE SAME
	// COMPILER RUNS ONE CONTAINER OVER.** A key gate is a three-name whitelist because the probe HASHES and
	// COMPARES the key through its `Hashable`/`Equatable`
	// witnesses, and those are the types a witness can carry. A value is never hashed and never compared: it
	// is stored and dropped, which is the whole of what this asks. Held to the key's rule, an enum value
	// (`/specs/map.md:map-literal-with-enum-values`) and a function value
	// (`:function-valued.dispatch`) would be refused while `List with TokenKind` and
	// `Array with UnaryOp` — the same word, the same stamp — compile and run.
	//
	// ⚠ It is NOT the opaque question: a `typeParameter` slot answers false here only incidentally, and its
	// refusal says something different (there is no destructor to stamp at all), so its askers test
	// `slotTypeIsOpaque` FIRST and say so in their own words.
	//
	// ⛔⛔ **THIS SAYS WHAT MAY *BE* A COLUMN; `TypeRules.columnValueTagMatches` SAYS WHAT MAY BE *WRITTEN* TO
	// ONE. WIDEN THIS AND GO THERE.** They are two facts in two files with nothing but each other's headers
	// holding them together, and a tag admitted here that no arm answers there is admitted at the `typealias`
	// and refused at every write, with a sentence that argues against itself: `boolean` is admitted here, so
	// that predicate answers it in its own arm, and without one `m.upsert("a", value: true)` would read
	// *"this `Map`'s value is a bool — got a 'bool' value"*.
	export function slotTypeFitsOneWord(slotType MaxonType) returns bool
		if self.slotTypeIsManaged(slotType) 'managedSlot'
			return true
		end 'managedSlot'

		let tag = maxonTypeTag(slotType)
		return tagIsIntegral(tag) or tag == ValueTypeTag.boolean or tag == ValueTypeTag.character
	end 'slotTypeFitsOneWord'

	// Is a container slot's declared type an OPAQUE TYPE PARAMETER — a `T` from an enclosing generic type's
	// shared body (`type W uses T { var xs as List with T }`), rather than a concrete type? A concrete slot
	// knows its destructor at the construction site (the `funcAddr` stamp); an opaque `T` does not — its
	// destructor lives in the enclosing instance's LAYOUT DESCRIPTOR and is read from `destroyFunc@40` at run
	// time, which is why every asker BRANCHES on this rather than composing a static stamp
	// (`requireStaticColumnStamp` is what makes forgetting to branch loud).
	export function slotTypeIsOpaque(slotType MaxonType) returns bool
		return maxonTypeTag(slotType) == ValueTypeTag.typeParameter
	end 'slotTypeIsOpaque'

	// --- The `Map` generic ---
	//
	// ⭐ **A `Map with (Key, Value)` IS THE `Set` ABOVE WITH A PARALLEL VALUE COLUMN**, declared by
	// `stdlib/Map.maxon`. What is different here is exactly the ARITY — two type arguments instead of
	// one — so every `Set` door above that reads "the sole argument" splits in two: a KEY half (which
	// must be `Hashable`/`Equatable`, since the probe hashes and compares it) and a VALUE half (which
	// needs only a drop callee).

	// ⭐⭐ **DOES THIS (tag, id) DENOTE THE `Map` CONTAINER — WHOEVER SERVES IT?** The SHAPE question, and the
	// only one there is: there is no synthesized `Map` record for a counterpart predicate to ask about.
	//
	// ⚠ **A DOOR THAT WANTS THE SHAPE MUST NOT BE HANDED THE RUNTIME.**
	// `inferredIntColumnBoundaryAdmits` asks how many COLUMNS a container has, so that a
	// `[1: 1]` literal's inferred `Map with (int, int)` reaches a parameter declared through a
	// `typealias IntMap = Map with (Integer, Integer)`. That has nothing to do with which runtime serves the
	// record: a door that asked a runtime question there would answer `E3005: argument type mismatch for 'm':
	// expected 'IntMap', got 'Map_int_int'` for `map.md`'s `for-in.nested` and `tuples`'
	// `for-in-over-map-allocates-no-tuple`.
	//
	// ⇒ **A DOOR MUST ASK WHAT THE CONTAINER *IS*, NEVER WHAT WILL EXECUTE IT.**
	export function isMapShapedInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.genericInstanceBaseName(nameId as GenericInstanceId).equals(MapBuiltinBaseName)
	end 'isMapShapedInstanceAt'

	// The KEY type of `Map with (K, V)` — type argument 0, the one the probe hashes and compares.
	export function mapKeyType(id GenericInstanceId) returns MaxonType
		let args = self.rowArgs(id)
		return try args.get(HashTableKeyArgPosition) otherwise panic("ProgramSignatures.mapKeyType: `Map` instance {id} has no key type argument — arity (2) was checked at instantiation")
	end 'mapKeyType'

	// The VALUE type of `Map with (K, V)` — type argument 1, which the table only stores and drops.
	export function mapValueType(id GenericInstanceId) returns MaxonType
		let args = self.rowArgs(id)
		return try args.get(MapValueArgPosition) otherwise panic("ProgramSignatures.mapValueType: `Map` instance {id} has no value type argument — arity (2) was checked at instantiation")
	end 'mapValueType'

	// --- The `__ManagedList` builtin generic and its node handle ---
	//
	// The `List`'s own chain under the surface that exposes nodes (see `ManagedListBuiltinBaseName`). Every
	// type-level fact it has is a `List`'s — the element through `containerElementType`, the box through
	// `ListRecordBytes`, the drop through `__list_decref` — so what lives here is only the identity: which
	// base name it is, and the same for the NODE handle whose element it shares.

	// Is `name` the builtin `__ManagedList` type — the base of every managed-list instance.
	export function isManagedListBaseName(name ByteArray) returns bool
		return name.equals(ManagedListBuiltinBaseName)
	end 'isManagedListBaseName'

	// Is generic instance `id` a `__ManagedList with T`? (Reads the base NAME, which needs no base struct.)
	export function isManagedListInstance(id GenericInstanceId) returns bool
		return self.isManagedListBaseName(self.genericInstanceBaseName(id))
	end 'isManagedListInstance'

	// ⭐ **DOES THIS (tag, id) PAIR DENOTE A `__ManagedList with T`?** — `isArrayInstanceAt`'s twin, needed for
	// its measured reason: a `TypeNameId` and a `GenericInstanceId` share one numeric space, so the id alone
	// can answer TRUE about an instance the caller never had. Its caller is the receiver dispatch, which
	// holds a value's (tag, nameId) pair.
	export function isManagedListInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.isManagedListInstance(nameId as GenericInstanceId)
	end 'isManagedListInstanceAt'

	// Is `name` the builtin `__ManagedListNode` type — the base of every node handle.
	export function isManagedListNodeBaseName(name ByteArray) returns bool
		return name.equals(ManagedListNodeBuiltinBaseName)
	end 'isManagedListNodeBaseName'

	// Is generic instance `id` a `__ManagedListNode with T`?
	export function isManagedListNodeInstance(id GenericInstanceId) returns bool
		return self.isManagedListNodeBaseName(self.genericInstanceBaseName(id))
	end 'isManagedListNodeInstance'

	// ⭐ **DOES THIS (tag, id) PAIR DENOTE A NODE HANDLE?** — the receiver dispatch's door, and the (tag, id)
	// form for `isArrayInstanceAt`'s reason.
	export function isManagedListNodeInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.isManagedListNodeInstance(nameId as GenericInstanceId)
	end 'isManagedListNodeInstanceAt'

	// ⭐ **THE NODE-HANDLE INSTANCE FOR A MANAGED LIST'S ELEMENT** — what an insertion's result is typed
	// with. It is derived from the LIST's instance rather than taken from the caller, so the element a node
	// reads back through `value()` is by construction the element the list holds.
	export function managedListNodeInstanceFor(listGiid GenericInstanceId) returns GenericInstanceId
		return self.builtinInstanceForElement(ManagedListNodeBuiltinBaseName, element: self.containerElementType(listGiid))
	end 'managedListNodeInstanceFor'

	// --- The `__ManagedMemoryCursor` builtin generic ---

	// Is `name` the builtin `__ManagedMemoryCursor` type — the base of every cursor.
	export function isManagedMemoryCursorBaseName(name ByteArray) returns bool
		return name.equals(ManagedMemoryCursorBuiltinBaseName)
	end 'isManagedMemoryCursorBaseName'

	// Is generic instance `id` a `__ManagedMemoryCursor with T`?
	export function isManagedMemoryCursorInstance(id GenericInstanceId) returns bool
		return self.isManagedMemoryCursorBaseName(self.genericInstanceBaseName(id))
	end 'isManagedMemoryCursorInstance'

	// ⭐ **DOES THIS (tag, id) PAIR DENOTE A CURSOR?** — the receiver dispatch's door, and the (tag, id) form
	// for `isArrayInstanceAt`'s measured reason: a `TypeNameId` and a `GenericInstanceId` share one numeric
	// space, so the id alone can answer TRUE about an instance the caller never had.
	export function isManagedMemoryCursorInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.isManagedMemoryCursorInstance(nameId as GenericInstanceId)
	end 'isManagedMemoryCursorInstanceAt'

	// ⭐ **THE CURSOR INSTANCE FOR A BUFFER'S ELEMENT** — what `createCursor()`'s result is typed with.
	// Derived from the SOURCE's instance rather than taken from the caller, so the element a `current()` reads
	// back is by construction the element the buffer holds — `managedListNodeInstanceFor`'s rule, and for the
	// same reason.
	export function managedMemoryCursorInstanceFor(sourceGiid GenericInstanceId) returns GenericInstanceId
		return self.builtinInstanceForElement(ManagedMemoryCursorBuiltinBaseName, element: self.containerElementType(sourceGiid))
	end 'managedMemoryCursorInstanceFor'

	// --- The `FixedArray` builtin generic ---
	//
	// The FIXED-SIZE array (see `FixedArrayBuiltinBaseName`). Its element is read through the shared
	// `containerElementType`, its stride through the shared `arrayElementSize`, its box and its drop through
	// the `Array` rows of the two routers — so the only `FixedArray`-specific type-level facts are these three
	// predicates and the SIZE below.

	// Is `name` the builtin `FixedArray` type — the base of every fixed array instance.
	// ⚠⚠ **IT ANSWERS FOR THE CONTEST'S MINT TOO, BECAUSE `stdlib/FixedArray.maxon` IS LISTED.** A listed
	// module's declaration is renamed into the reserved space when a USER program
	// declares the same type name (`contestStdlibTypeName`), and `Parser.shadowRenamedTokens` rewrites the
	// stdlib file's own identifier tokens with it — so inside `stdlib/Sha2.maxon` the base of
	// `typealias Sha2State = FixedArray with 8 Sha2Word` becomes `__FixedArray`. Read by the pre-contest spelling
	// alone, `Parser.readSizedBaseElementCount` declines to read the COUNT and the `8` is parsed as a
	// type: **E2010 `Expected 'a type' but got '8'` on that library line**, in any program whose only
	// offence is declaring a `type FixedArray` of its own — a library line no user wrote, refused because of
	// one.
	//
	// ⭐ It is `isArrayBaseName`'s shape, minus that predicate's discovered-conformer clause: the sized
	// container has no second declaration to find, only the corpus's and this compile's mint of it. The
	// reserved-prefix test comes first for the same measured reason — no ordinary name can reach the mint, so
	// the shape rules the map lookup out before it is made.
	export function isFixedArrayBaseName(name ByteArray) returns bool
		if name.equals(FixedArrayBuiltinBaseName) 'theContainersOwnName'
			return true
		end 'theContainersOwnName'

		if not isCompilerReservedName(name) 'notAMintedName'
			return false
		end 'notAMintedName'

		return name.equals(self.settledDeclarations().interfaces.libraryNameOf(FixedArrayBuiltinBaseName))
	end 'isFixedArrayBaseName'

	// Is generic instance `id` a `FixedArray with N T`? (Reads the base NAME, which needs no base struct.)
	export function isFixedArrayInstance(id GenericInstanceId) returns bool
		return self.isFixedArrayBaseName(self.genericInstanceBaseName(id))
	end 'isFixedArrayInstance'

	// Is instance `id`'s value the fused managed buffer record, born through `__managed_create`? A `FixedArray`'s
	// record is an `Array`'s — the two differ in what may be done to them, not in how the bytes sit — so its
	// create, size, drop, clone and transfer walks are the same entries for both.
	export function isManagedBufferRecordInstance(id GenericInstanceId) returns bool
		return self.isArrayInstance(id) or self.isFixedArrayInstance(id)
	end 'isManagedBufferRecordInstance'

	export function isManagedBufferRecordInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.isManagedBufferRecordInstance(nameId as GenericInstanceId)
	end 'isManagedBufferRecordInstanceAt'

	// ⭐ **DOES THIS (tag, id) PAIR DENOTE A `FixedArray with N T`?** — `isArrayInstanceAt`'s twin, and it exists
	// for that function's MEASURED reason and not for symmetry: a `TypeNameId` and a `GenericInstanceId` share
	// one numeric space, so `isFixedArrayInstance` handed a plain `named` id can answer TRUE about an instance the
	// caller never had. Both callers (the receiver dispatch and the `for … in` source test) hold a value's
	// (tag, nameId) pair, which is exactly the shape that hazard bites.
	export function isFixedArrayInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.isFixedArrayInstance(nameId as GenericInstanceId)
	end 'isFixedArrayInstanceAt'

	// ⭐ **HOW MANY ELEMENTS INSTANCE `id` HOLDS** — the second coordinate of a sized instance's
	// identity; an unsized or runtime-sized one throws `unsized`.
	export function genericInstanceFixedCount(id GenericInstanceId) returns FixedElementCount throws InstanceSizeLookup
		return try self.rowFixedCount(id)
	end 'genericInstanceFixedCount'

	export function isRuntimeSizedFixedArrayAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return match self.elementCountSourceOf(tag, nameId: nameId) 'source'
			inTheRecord gives true
			stated or
			callerSlot gives false
		end 'source'
	end 'isRuntimeSizedFixedArrayAt'

	// ⭐⭐ **WHERE THE ELEMENT COUNT OF A VALUE TYPED AT `(tag, nameId)` COMES FROM — the ONE question
	// every asker of the hidden fixed-element-count argument shares.** The instance states it
	// (`stated`), the value's record holds it (`inTheRecord`, a runtime-sized instance), or the
	// emitting function's caller supplies it (`callerSlot`, every other type, the sized container's
	// own countless `Self` included). `LowerMaxonToStd.emitFixedElementCountOfReceiver` and the
	// `Parser` doors (`requireFixedElementCountSourceForForwarding`,
	// `requireACountSourceForAStaticCall` and the closure-environment reader) branch on its answer,
	// and no asker may restate it: they disagree in both directions without a compile error, a refusal
	// wider than the emit rejecting a legal program and a narrower one letting the call through to
	// `forwardCallerFixedElementCount`'s abort.
	//
	// ⛔ Asked as the (tag, id) PAIR for `isFixedArrayInstanceAt`'s measured reason — a `TypeNameId`
	// and a `GenericInstanceId` share one numeric space, so the id half alone can answer about an
	// instance the caller never had.
	export function elementCountSourceOf(tag ValueTypeTag, nameId TypeNameId) returns ElementCountSource
		if tag != ValueTypeTag.genericInstance 'notAnInstance'
			return ElementCountSource.callerSlot
		end 'notAnInstance'

		return match self.rowShape(nameId as GenericInstanceId) 'shape'
			sized(count) gives ElementCountSource.stated(count)
			runtimeSized gives ElementCountSource.inTheRecord
			unsized or
			frozenArgs gives ElementCountSource.callerSlot
		end 'shape'
	end 'elementCountSourceOf'

	// The `FixedArray with <size> <element>` instance — the SIZED twin of `builtinInstanceForElement`,
	// and the one door that mints one. Its callers are the alias fold (`recordGenericAlias`, off a
	// declaration), the declaration sweep's `FixedArray from […]` pre-intern, and the parse itself for
	// a constant-length `create(n)` and a `from […]` through a runtime-sized alias. The parse's mints
	// land in its band (`GenericInstanceRegistry.parseBandOpen`), which the merge renumbers into the
	// one registry, so one instance has one id across files.
	export function fixedArrayInstanceForElement(element MaxonType, size FixedElementCount) returns GenericInstanceId
		let args = MaxonTypeArray.create(1, zeroed: false)
		args.push(element)
		return self.internRow(self.typeNames.intern(FixedArrayBuiltinBaseName), args: args, shape: InstanceShape.sized(size))
	end 'fixedArrayInstanceForElement'

	// ⚠ There is deliberately no `mapKeyIsManaged` / `mapValueIsManaged` / `setKeyIsManaged` beside these two
	// selectors. A map carries TWO independently stamped destructors (`keyDrop@40`, `valueDrop@56`) — a
	// `Map with (String, Int)` owns heap keys and trivial values — and a per-column predicate is a second place
	// that has to know which type argument is the key. Every caller already holds the column TYPE (from
	// `mapKeyType` / `mapValueType`) and asks its question of that type.

	// Is a SINGLE-ELEMENT container's element itself managed (String / struct / boxed union / nested container)?
	// A trivial element (int / Byte / ranged-int / bool) is stored inline and owns nothing.
	//
	// ⚠ **`container`, NOT `array`, AND THE NAME IS LOAD-BEARING.** It reads through
	// `containerElementType`, so a `List` giid answers here exactly as an `Array` one does — and
	// `Parser.dispatchManagedListNodeMethod` and the list move-in/borrow doors ask it that way.
	export function containerElementIsManaged(id GenericInstanceId) returns bool
		return self.typeIsManaged(self.containerElementType(id), from: self.typeNames)
	end 'containerElementIsManaged'

	// ⭐⭐ **IS THE ELEMENT STORED AS AN ADDRESS RATHER THAN INLINE? — the STORAGE question, which "is it an
	// `__mm` box" answered until a promise stopped being one.** Two populations and one width: a managed box,
	// whose slot holds a refcounted pointer; and a GREEN-THREAD HANDLE, whose slot holds a pointer into the
	// scheduler's own slab that `__gt_promise_drop` reclaims and no refcount owns (`PromiseType.maxon`).
	//
	// ⛔⛔ **`elementStrideOfType` ASKS THE OWNERSHIP QUESTION, OR A LEGAL PROGRAM PANICS THE COMPILER.**
	// `typealias Ps = Array with Promise with (Integer, MathError)` (the element spelled INLINE)
	// reached `trivialElementSlot` with a `genericInstance`, because `containerElementIsManaged` is
	// `typeIsManaged`, and `typeIsManaged`'s own instance arm answers `false` for a promise handle by
	// design — *"an `Array with Promise` answers `false` there and `true` here"*, in
	// `containerElementOwesDrop`'s words. `trivialElementSlot` then sized an aggregate through
	// `primitiveTypeByteSize` and **panicked**: `a `genericInstance` is an aggregate — size it through
	// its base StructLayout.sizeBytes`. ⚠ The TWO-STEP spelling (`typealias P = Promise with (…)` then
	// `Array with P`) compiled and ran correctly the whole time, so this was one meaning with two
	// answers.
	//
	// ⚠ **`arrayElementMayBeConstantBlob` ONE FUNCTION DOWN STILL ASKS THE NARROW QUESTION, AND ITS OWN STATED
	// REASON IS THIS ONE** — *"a MANAGED element's slot holds a POINTER … and an address the loader chooses is
	// not a value a compile-time image can contain"*, which is as true of a scheduler-slab address. It is not
	// changed here because no program can reach the difference: a promise is never a compile-time constant, so
	// `everyElementIsAKnownConstant` refuses the blob before that predicate's answer is used. A latent second
	// face, not a live one.
	function typeOccupiesAPointerSlot(element MaxonType) returns bool
		return self.typeIsManaged(element, from: self.typeNames) or self.typeIsAGreenThreadHandle(element, from: self.typeNames)
	end 'typeOccupiesAPointerSlot'

	// ⭐ **DOES THIS CONTAINER'S ELEMENT OWE A DROP?** The instance-keyed spelling of `typeOwesDrop`, and the
	// question the ELEMENT DESTRUCTOR STAMP must ask — `containerElementIsManaged` is the narrower "is the
	// element an `__mm` box", which is right for deciding a retain or a clone and wrong for deciding whether
	// the record's `element_destroy@40` walk has anything to do. An `Array with Promise` answers `false`
	// there and `true` here: a stamp of 0 skips the walk, and the container dies holding live green
	// threads.
	export function containerElementOwesDrop(id GenericInstanceId) returns bool
		return self.typeOwesDrop(self.containerElementType(id), from: self.typeNames)
	end 'containerElementOwesDrop'

	// Is this container's element a green-thread handle? Asked where the element's drop is not a refcount —
	// the vacate doors and the copy refusals — rather than where it merely owes one.
	export function containerElementIsAGreenThreadHandle(id GenericInstanceId) returns bool
		return self.typeIsAGreenThreadHandle(self.containerElementType(id), from: self.typeNames)
	end 'containerElementIsAGreenThreadHandle'

	// Is instance `id`'s type argument at `position` a green-thread handle?
	export function instanceArgIsAGreenThreadHandle(id GenericInstanceId, position ElementIndex) returns bool
		return self.typeIsAGreenThreadHandle(self.substitutedInstanceArg(id, position: position), from: self.typeNames)
	end 'instanceArgIsAGreenThreadHandle'

	// Is a SINGLE-ELEMENT container's element an OPAQUE TYPE PARAMETER? The instance-keyed
	// spelling of `slotTypeIsOpaque` above, which carries the reason — a `Map`'s VALUE column asks the same
	// question of a slot no `containerElementType` names, so the rule lives on the TYPE and this reads it
	// through the element door.
	export function containerElementIsOpaque(id GenericInstanceId) returns bool
		return self.slotTypeIsOpaque(self.containerElementType(id))
	end 'containerElementIsOpaque'

	// Can a record be stored into a value of this instance? Yes when a type argument is a record, or opaque and
	// so possibly one. An `Array with Byte` answers no.
	export function instanceArgsMayHoldARecord(id GenericInstanceId, textIsARecord bool) returns bool
		for position in 0 upto self.genericInstanceArgCount(id) 'eachArg'
			let argument = self.substitutedInstanceArg(id, position: position)

			if not textIsARecord and tagIsByteRecord(maxonTypeTag(argument)) 'aValueType'
				continue
			end 'aValueType'

			if self.slotTypeIsOpaque(argument) or self.typeIsManaged(argument, from: self.typeNames) 'aRecord'
				return true
			end 'aRecord'
		end 'eachArg'

		return false
	end 'instanceArgsMayHoldARecord'

	// ⭐⭐ **AN OPAQUE ELEMENT ANSWERS `false` TO `containerElementIsManaged`, AND THE CLONE SIDE ACTED ON THAT
	// ANSWER — SO THIS IS THE QUESTION IT SHOULD HAVE ASKED.** `containerElementIsManaged` is
	// `typeIsManaged` of the element, and `typeIsManaged` of a bare `typeParameter` is `false` — not because
	// the element owns nothing, but because a shared body cannot say what it owns. The two clone doors read
	// that `false` as *"a trivial element, so the record's own words ARE the copy"*, while the instance the
	// program actually builds stamps `element_drop@24` from the enclosing descriptor's `destroyFunc@40` and
	// that word can be live.
	//
	// ⛔⛔ **MEASURED, `0xC0000005`.** The door is a container whose element is opaque while the container is
	// NOT itself opaque — a container of containers. `type Bag uses Element` holding
	// `typealias Outer = Array with (Array with Element)`, cloned inside its own shared body at
	// `Bag with String`: the OUTER array's element is a `genericInstance`, so `containerElementIsOpaque` is
	// false for it and it takes the CONCRETE copy path (`Parser.requireArrayElementCopyable` +
	// `arrayElementCloneValue`) rather than the opaque one — and the per-element cloner that path resolves for
	// the INNER `Array with Element` is `__managed_clone`, a word-for-word buffer copy that retains no element.
	// Both the source and the copy then cascaded `__str_decref` over the same records: the program printed its
	// row count and **died at teardown**. ⇒ *"not reachable today"* was a statement about the doors that had
	// been TRIED, and it aged the way a blocker note ages.
	//
	// ⭐ **IT IS NOT A BARE `containerElementIsOpaque`, BECAUSE THAT WOULD REFUSE A PROGRAM THAT OWES
	// NOTHING.** The cost lands only where some instantiation makes the element own a record; a `Bag` every
	// `with` in the program instantiates at an `int` copies its inner buffers correctly with no cloner at all,
	// and refusing it would be the false reject `instanceWithTypeArgKind`'s header names as the one direction
	// a refusal may not err in. So the opacity is the ROUTING and `managedElement` — a REFUSING kind, which is
	// what this is — is the verdict.
	export function containerOpaqueElementCanBeManaged(id GenericInstanceId) returns bool
		let element = self.containerElementType(id)

		if not self.slotTypeIsOpaque(element) 'notOpaque'
			return false
		end 'notOpaque'

		return self.anyInstanceTypeArgHasKind(typeParamIdOf(element), kind: TypeArgInstantiationKind.managedElement)
	end 'containerOpaqueElementCanBeManaged'

	// ⭐⭐ **IS THIS COLUMN'S ELEMENT A RECORD WHOSE RELEASE IS A FACT ABOUT AN INSTANTIATION THE SHARED BODY
	// CANNOT NAME?** The sibling of the question above, one level of nesting over: there the element
	// IS the enclosing type's parameter, here the element is an INSTANCE written over it (`Box with
	// Element` inside `type Bag uses Element`), and the two are separated by exactly the fact that a
	// column's element destructor is a SYMBOL and a `destroyFunc@40` is a WORD.
	//
	// ⛔⛔ **MEASURED, `0xC0000005`, AND IT IS THE ROW'S OWN REPRO.** `type Bag uses Element` holding
	// `typealias BoxArray = Array with (Box with Element)`, filled through `items.push(EBox.create(x, …))` at
	// `Bag with String`, whose payload is a heap `String` that dies at its producer's scope exit: the box holds
	// a pointer nobody took a reference to, and the read faults. **AND TAKING THE REFERENCE IS NOT THE CURE** —
	// measured at the same time, with the store-side retain in place the identical program exits **101**,
	// because the array is stamped `__managed_create(8, __mm_decref)` and the box is freed without its slot
	// being released. The destructor that WOULD release it (`__destruct_Box_String`) exists — `Box with String`
	// is interned by the substitution — but a shared body can name only the DECLARATION VIEW's, and that one
	// reads its own bare `T` field through `typeIsManaged` and is told the field owns nothing. A create whose
	// element is composed over the caller's parameters reads the per-instantiation destructor out of the
	// descriptor table instead (`containerCreateRoute`); this predicate is what a statically stamped create is
	// refused on.
	//
	// ⭐ **THE OPACITY IS THE ROUTING AND THE INSTANTIATION IS THE VERDICT** — `containerOpaqueElementCanBeManaged`'s
	// discipline, for its reason. A `Bag` every `with` in the program instantiates at an `int` holds boxes whose
	// bare `T` field owns nothing at run time, so its column is correct as it stands and refusing it would be a
	// false reject. Only a field the instance leaves OPAQUE counts: one the enclosing instantiation already
	// substituted to a concrete type has a statically nameable drop and is exactly what a concrete
	// `Array with (Box with String)` does correctly today.
	export function columnElementOwnsAnUnnameableSlot(columnType MaxonType) returns bool
		// ⚠ **THE ELEMENT OF A CONTAINER DECLARED AT AN INNER ALIAS ARRIVES AS A BARE `named`, NOT AS AN
		// INSTANCE, AND THE FIRST CUT OF THIS ANSWERED `false` FOR EVERY SHAPE IT EXISTS TO REFUSE.** A
		// generic body's `typealias EBox = Box with Element` is re-interned per enclosing instantiation, so
		// what `containerElementType` hands back inside the shared body is `named("Bag.EBox")` — MEASURED:
		// `tag=named`, and the walk below never ran. It is resolved exactly as `denotesArrayInstance` resolves
		// the same shape one question over, through the FILE-LESS alias door, because a column type reaching
		// here travels with no reader path.
		let tag = maxonTypeTag(columnType)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceRestsAnUnnameableSlot(genericInstanceIdOf(columnType))
		end 'anInstance'

		if tag != ValueTypeTag.named 'namesNoInstance'
			return self.slotOwnsASlotOfKind(columnType, kind: TypeArgInstantiationKind.managedElement, visited: ClonerSet.create())
		end 'namesNoInstance'

		let name = self.nameOfId(typeNameIdOf(columnType))

		// A superseded spelling votes nothing, for `typeArgIsManagedElement`'s reason: this is a REFUSAL, and
		// a contested alias name no reader can reach is not an instantiation of anything.
		return self.instanceRestsAnUnnameableSlot(try self.liveGenericAliasInstance(name) otherwise return false)
	end 'columnElementOwnsAnUnnameableSlot'

	// ⭐⭐ **THE SAME QUESTION ASKED OF AN INSTANCE IN HAND, AND THE ONE PLACE THE WALK'S CYCLE SET IS
	// SEEDED.** Seeding lives HERE and not at an asker, so a second door cannot arrive with
	// a set of its own.
	export function instanceRestsAnUnnameableSlot(id GenericInstanceId) returns bool
		if not self.instanceCanRestASlotAtAParameter(id) 'nothingToWalk'
			return false
		end 'nothingToWalk'

		return self.instanceOwnsASlotOfKind(id, kind: TypeArgInstantiationKind.managedElement, visited: ClonerSet.create())
	end 'instanceRestsAnUnnameableSlot'

	// ⭐⭐⭐ **THE EMISSION TWIN OF THE REFUSAL ABOVE — does `id` rest a slot the DICTIONARY DESTRUCTOR
	// must release?** One walk, one recursion, one cycle set; the KIND is the only thing that varies,
	// exactly as `instanceWithTypeArgKind`'s header says of the three gates it serves.
	//
	// ⛔⛔ **AND THE KIND IS `retainedFeed`, NOT `managedElement`, BECAUSE THIS IS THE RELEASE HALF OF THE
	// RETAIN.** `typeParamFeedCanOwnAReference` — the gate on whether a shared body takes a reference into such
	// a record at all — reads `retainedFeed`, which reads EVERY interned row; `managedElement` is a REFUSING
	// kind and skips a speculative row and a row E3017 already owns (`kindIsARefusal`). A reference taken
	// through a row this walk had skipped would be a reference nothing releases, which is exit 101 — so the
	// retain's gate and the release's gate are one kind, read at the two ends.
	//
	// ⚠ Over-approximating is free in this direction and that is the whole argument for reading every row: the
	// release it emits is `__drop_type_param` against `destroyFunc@40`, which is **0** for an instantiation
	// owing nothing and is therefore inert on exactly the rows a refusal would have had to exclude.
	export function instanceRestsARetainedSlot(id GenericInstanceId) returns bool
		if not self.instanceCanRestASlotAtAParameter(id) 'nothingToWalk'
			return false
		end 'nothingToWalk'

		return self.instanceOwnsASlotOfKind(id, kind: TypeArgInstantiationKind.retainedFeed, visited: ClonerSet.create())
	end 'instanceRestsARetainedSlot'

	// Is substituted instance field `index` still standing at a BARE type parameter — the slot the dictionary
	// destructor releases through `__drop_type_param` rather than through a symbol? Asked over
	// `substituteInstanceFieldType` for `genericInstanceFieldIsManaged`'s reason: the cascade's field KIND and
	// its field CALLEE must classify one type.
	export function genericInstanceFieldIsOpaque(id GenericInstanceId, index FieldIndex) returns bool
		return maxonTypeTag(self.substituteInstanceFieldType(id, index: index)) == ValueTypeTag.typeParameter
	end 'genericInstanceFieldIsOpaque'

	// ⭐⭐ **WHICH DICTIONARY BLOCK RELEASES OPAQUE FIELD `index`, IN THE ENCLOSING BODY'S OWN `uses`-LIST
	// TERMS.** The substituted field type names a parameter of the type whose SHARED BODY holds the descriptor
	// — `BagIter with Element`'s `slot` substitutes to `Bag`'s `Element`, and `Bag.contains` is the frame that
	// drops the record — so the position read here and the block the caller's descriptor lays out are the same
	// number by construction. That is what lets the destructor take the WHOLE descriptor and index its own
	// blocks, instead of the caller having to pre-offset one: a PERMUTED instance (`Pair with (U, T)` inside
	// `Holder uses T, U`) is served for free, where a single forwarded block base could not express it.
	export function genericInstanceFieldOpaqueBlockOffset(id GenericInstanceId, index FieldIndex) returns ByteOffset
		return layoutBlockOffsetFor(self.opaqueTypeParamPosition(self.substituteInstanceFieldType(id, index: index)))
	end 'genericInstanceFieldOpaqueBlockOffset'

	// ⭐⭐ **THE WALK'S TWO ALLOCATION-FREE PRECONDITIONS, ASKED BEFORE ITS CYCLE SET EXISTS.** A fully
	// CONCRETE instance resolves its own destructor at the create site — the whole point of the
	// declaration-view/instance split — and a BUILTIN element-bearing record (`__ManagedMemory with Element`,
	// `__ManagedList with Element`) has no declared field list to walk at all: its element destructor IS the
	// descriptor's `destroyFunc@40`, which is the mechanism these questions exist to reason about one level up.
	// The CLONE side of that same element is `containerOpaqueElementCanBeManaged`'s.
	//
	// ⚡ **IT IS ASKED AT THE TWO SEEDS AS WELL AS INSIDE THE WALK, and the recursion is why it must be both
	// places rather than either.** The seeds pay for a `ClonerSet` before the walk can decline, and
	// `Parser.instanceBoxDropCallee` asks one of them at EVERY generic-instance drop in the program — where
	// the answer is `false` for essentially all of them, an `Array with Byte` or a `Box with String` having no
	// parameter left to rest anything at. The walk needs it too, for a nested slot that is concrete. One
	// function, so a fix to either reading cannot reach one and miss the other.
	function instanceCanRestASlotAtAParameter(id GenericInstanceId) returns bool
		return self.instanceIsBuiltOnATypeParameter(id) and self.genericInstanceHasBaseLayout(id)
	end 'instanceCanRestASlotAtAParameter'

	// The instance-in-hand half of the two questions above — does `id` own a slot AT a parameter this instance
	// leaves OPAQUE, which some instantiation of that parameter's owner classifies as `kind`? The REFUSAL asks
	// it at `managedElement` and the dictionary destructor's EMISSION asks it at `retainedFeed`; nothing else
	// about the walk differs, so the kind rides rather than the walk being written twice
	// (`instanceWithTypeArgKind`'s discipline, one level up).
	//
	// ⛔⛔ **IT READS THE SUBSTITUTED COLUMN, NOT THE RAW ONE — MEASURED `0xC0000005` THE OTHER WAY.** The raw
	// field list only ever names a slot's DECLARED spelling, so a field typed
	// through an inner alias arrives as a bare `named("Box.TInner")` and a field typed at a NESTED INSTANCE
	// over the parameter (`type Box uses T { let inner as Inner with T }`) is a `genericInstance` — neither is
	// a `typeParameter`, so a scan that tested only `slotTypeIsOpaque` of the declared column skipped both and
	// answered `false`. MEASURED on `Array with (Box with Element)` at `Bag with String`, where `Box` holds an
	// `Inner with T` rather than a bare `T`: the column was stamped `__destruct_Box_T<hash>` — the DECLARATION
	// VIEW's — the store kept a raw borrow, and the program **segfaulted at the read**, exactly the fault the
	// refusal above exists to prevent, one level of nesting further in.
	//
	// ⇒ The column is resolved and substituted through `substituteInstanceFieldType`, which is the ONE
	// derivation `genericInstanceFieldIsManaged`, `genericInstanceFieldDropCallee` and
	// `genericInstanceFieldCascadeStrategy` already share — its own header carries the exit-101 leak a separate,
	// hand-rolled reading of the same column produced. A refusal deriving that column its own way is free to
	// disagree with the destructor it is refusing on behalf of, which is what happened here.
	function instanceOwnsASlotOfKind(id GenericInstanceId, kind TypeArgInstantiationKind, visited ClonerSet) returns bool
		if not self.instanceCanRestASlotAtAParameter(id) 'nothingToWalk'
			return false
		end 'nothingToWalk'

		// The cycle break is `declaredInstanceSupportsDeepClone`'s, for its reason and in its set: the mangled
		// instance name lives behind the reserved `__` prefix no declaration may take. A cycle answers "owns
		// nothing" because a type that owns itself is E4014's to refuse, not this refusal's to guess at.
		let mangled = self.mangleGenericInstance(id)

		if visited.contains(mangled) 'alreadyWalked'
			return false
		end 'alreadyWalked'

		visited.insert(mangled)

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if self.slotOwnsASlotOfKind(self.substituteInstanceFieldType(id, index: i), kind: kind, visited: visited) 'someInstantiationOwnsIt'
				return true
			end 'someInstantiationOwnsIt'
		end 'eachField'

		return false
	end 'instanceOwnsASlotOfKind'

	// One slot of the walk above, as the instance holding it SEES that slot. A slot still standing at a bare
	// parameter is the answer — it is the one whose release is a fact about an instantiation no SYMBOL in this
	// body can name; a slot at a nested instance recurses, because the record that instance stands for is
	// freed by the same declaration-view destructor and carries the same word; a tuple recurses into each
	// element; and every other tag is a concrete leaf whose drop the create site resolves for itself.
	// A generic alias spelling (`named`) is resolved first: read as a leaf it answers false and the
	// instance's release skips its dictionary destructor.
	function slotOwnsASlotOfKind(slotAsWritten MaxonType, kind TypeArgInstantiationKind, visited ClonerSet) returns bool
		let slot = self.typeArgumentType(slotAsWritten)

		if self.slotTypeIsOpaque(slot) 'aBareParameterSlot'
			return self.anyInstanceTypeArgHasKind(typeParamIdOf(slot), kind: kind)
		end 'aBareParameterSlot'

		if maxonTypeTag(slot) == ValueTypeTag.genericInstance 'aNestedInstance'
			return self.instanceOwnsASlotOfKind(genericInstanceIdOf(slot), kind: kind, visited: visited)
		end 'aNestedInstance'

		let elements = try self.tupleElementTypesOf(slot) otherwise return false

		for element in elements 'eachTupleElement'
			if self.slotOwnsASlotOfKind(element, kind: kind, visited: visited) 'anElementOwnsIt'
				return true
			end 'anElementOwnsIt'
		end 'eachTupleElement'

		return false
	end 'slotOwnsASlotOfKind'

	// The element type's name AS A DIAGNOSTIC PRINTS IT (`Slot`, `String`). It lives here because
	// `typeNames` is this index's own interner and is not the parser's to reach into; the parser holds
	// a per-FILE interner, and an element type id from `containerElementType` belongs to this one.
	export function arrayElementDisplayName(id GenericInstanceId) returns String
		return self.typeDisplayName(self.containerElementType(id))
	end 'arrayElementDisplayName'

	export function displayNameOfAggregate(tag ValueTypeTag, aggregate ByteArray) returns String
		if aggregate.isEmpty() 'aScalar'
			return typeTagName(tag)
		end 'aScalar'

		return self.aliasIdentityDisplay(aggregate)
	end 'displayNameOfAggregate'

	export function tupleDisplayNoted(shown String, identity ByteArray, otherShown String, otherIdentity ByteArray) returns String
		if not shown.equals(otherShown) or not isTupleTypeName(identity) or not isTupleTypeName(otherIdentity) 'nothingToTellApart'
			return shown
		end 'nothingToTellApart'

		let layout = self.registeredTupleLayoutNamed(identity)
		let otherLayout = self.registeredTupleLayoutNamed(otherIdentity)

		if layout.fieldCount() != otherLayout.fieldCount() 'twoShapesPrintAlike'
			panic("ProgramSignatures.tupleDisplayNoted: '{shown}' and '{otherShown}' print alike, so both tuples hold one element count — these hold {layout.fieldCount()} and {otherLayout.fieldCount()}")
		end 'twoShapesPrintAlike'

		let names = StringArray.create(layout.fieldCount(), zeroed: false)

		for i in 0 upto layout.fieldCount() 'eachElement'
			let elementShown = self.tupleElementDisplayName(layout, index: i as FieldIndex)
			let otherElementShown = self.tupleElementDisplayName(otherLayout, index: i as FieldIndex)
			names.push("{elementShown}{self.elementNote(layout, index: i as FieldIndex, shown: elementShown, otherShown: otherElementShown)}")
		end 'eachElement'

		return "({joinedWith(names, separator: TypeArgumentSeparator)})"
	end 'tupleDisplayNoted'

	function elementNote(layout StructLayout, index FieldIndex, shown String, otherShown String) returns String
		let element = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.elementNote: fieldTypes.get OOB at {index} below count {layout.fieldCount()}")

		if maxonTypeTag(element) == ValueTypeTag.genericInstance 'anInstance'
			return self.contestedTypeNote(ValueTypeTag.genericInstance, nameId: typeNameIdOf(element), brand: layout.fieldDeclaredBrand(index), identity: EmptySourceText, shown: shown, otherShown: otherShown)
		end 'anInstance'

		if maxonTypeTag(element) == ValueTypeTag.named 'anAlias'
			return self.declaredInNote(self.nameOfId(typeNameIdOf(element)), shown: shown, otherShown: otherShown)
		end 'anAlias'

		return ""
	end 'elementNote'

	export function typeDisplayName(t MaxonType) returns String
		let layout = try self.tupleLayoutOf(t) otherwise return maxonTypeDisplayName(t, typeNames: self.typeNames, signatures: self)
		let names = StringArray.create(layout.fieldCount(), zeroed: false)

		for i in 0 upto layout.fieldCount() 'eachElement'
			names.push(self.tupleElementDisplayName(layout, index: i as FieldIndex))
		end 'eachElement'

		return "({joinedWith(names, separator: TypeArgumentSeparator)})"
	end 'typeDisplayName'

	function tupleElementDisplayName(layout StructLayout, index FieldIndex) returns String
		let element = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.tupleElementDisplayName: fieldTypes.get OOB at {index} below count {layout.fieldCount()}")
		let brand = layout.fieldDeclaredBrand(index)

		let word = "{String.from(ImmutableCapabilityWord)} " if layout.fieldTypeSites.capabilityAt(index) == ParamCapability.immutable else ""

		if maxonTypeTag(element) == ValueTypeTag.genericInstance and brandIsTheType(brand) 'aBrandedInstance'
			return "{word}{String.from(self.brandDisplayName(brand, gid: genericInstanceIdOf(element)))}"
		end 'aBrandedInstance'

		return "{word}{self.typeDisplayName(element)}"
	end 'tupleElementDisplayName'

	// ⭐ **THE SOLE PRODUCER OF THE STRIDE HALF OF `element_size@24`** — the number every array helper strides
	// by at run time and every same-shape check compares; `arrayElementStamp` adds the signed-slot flag to it
	// and is the sole producer of the whole word every `__managed_create` is stamped with. A MANAGED element
	// (String / struct / union / instance / nested Array) is a heap box stored as an 8-byte POINTER
	// (`ManagedArrayElementBytes`), so its slot is the pointer, NOT the element's full logical size — the
	// drop walk destroys the pointer, the accessors load/store it. A TRIVIAL element is stored inline, at
	// the width `trivialElementSlot` gives it. `genericInstanceArgElementStamp` asks the same question of a
	// descriptor's type argument through `elementStrideOfType`, so the two cannot differ.
	//
	// ⚠ **IT IS NOT THE SOURCE `sizeof`, AND IT DOES NOT ROUTE THROUGH THE LOGICAL-SIZE DOOR.** Both of the
	// storage rules above diverge from `sizeof`: a `String` element's slot is 8 where its `sizeof` is the
	// 48-byte record, and a `Byte` element's slot is 1 where `sizeof(Byte)` is a machine word. One door
	// forces one answer on two questions — see `typeLogicalByteSize`, which is the other.
	//
	// ⚠⚠ **ITS ANSWER IS SIGNED, BECAUSE `element_size@24` CARRIES TWO LADDERS IN ONE FIELD** — a positive
	// byte stride, or a NEGATIVE sub-byte bit width (`elementStrideOf`, which owns the encoding). Every
	// caller of this function wants the stride and not the unpacked byte width, which is what keeps it one
	// function: `arrayElementStamp` carries it into the stamp every create site writes,
	// `isBytePackedArrayInstance` asks `== 1` and must answer NO
	// for a packed element, `arrayElementIsMachineWord` asks `== 8`, the append same-shape test compares
	// two of them, and the raw-byte doors have to refuse a slot that is not byte-addressable at all. A
	// second "unpacked byte width" accessor beside this one would be a second producer of a stride, which
	// is the shape this function's own name exists to prevent.
	export function arrayElementSize(id GenericInstanceId) returns ElementStride
		return self.elementStrideOfType(self.containerElementType(id))
	end 'arrayElementSize'

	export function arrayElementStamp(id GenericInstanceId) returns ElementStamp
		return self.elementStampOfType(self.containerElementType(id))
	end 'arrayElementStamp'

	export function genericInstanceArgElementStamp(id GenericInstanceId, position ElementIndex) returns ElementStamp
		return self.elementStampOfType(self.descriptorArgumentAt(id, position: position))
	end 'genericInstanceArgElementStamp'

	function elementStampOfType(element MaxonType) returns ElementStamp
		return elementStampOf(self.elementStrideOfType(element), signed: self.elementIsSignedNarrow(element))
	end 'elementStampOfType'

	function elementIsSignedNarrow(element MaxonType) returns bool
		if maxonTypeTag(element) != ValueTypeTag.named 'notANamedLeaf'
			return false
		end 'notANamedLeaf'

		return match self.narrowSignedSlotOf(self.nameOfId(typeNameIdOf(element))) 'slot'
			fromBytes gives true
			notASignExtension gives false
		end 'slot'
	end 'elementIsSignedNarrow'

	function elementStrideOfType(element MaxonType) returns ElementStride
		// ⚠ **THE STORAGE QUESTION AND NOT THE REFCOUNT ONE** — see `typeOccupiesAPointerSlot`,
		// whose header carries the compiler panic that measured the difference.
		if self.typeOccupiesAPointerSlot(element) 'storedAsAnAddress'
			return ManagedArrayElementBytes
		end 'storedAsAnAddress'

		return elementStrideOf(self.elementPackingOfType(element), storageBytes: self.trivialElementSlot(element).bytes)
	end 'elementStrideOfType'

	// ⭐⭐ **IS THIS TYPE STORED IN A NARROW SIGNED SLOT, AND HOW WIDE? (`enum-narrow-storage`.)** The runtime's
	// element load is shared by every array in the program, and it sign-extends a slot only when the record's
	// stamp carries `SignedElementStampFlag` (`elementStampOfType` sets it from this answer); every other slot
	// zero-extends. The parser asks the same question again for the reads it re-signs itself. This is that
	// fact, asked where the width was decided.
	//
	// ⭐⭐ **IT IS A QUESTION ABOUT THE TYPE AND NOT ABOUT THE CONTAINER, WHICH IS WHAT LETS TWO DOORS SHARE
	// IT — AND THE REASON IS THAT THE EXTENSION IS THE IDENTITY ON A CORRECT VALUE.** The slot was chosen to
	// hold every value the type admits, so every legitimate value already sits inside the signed range the
	// extension maps onto itself; applying it to a value that was never truncated cannot change it. So a
	// reader does not have to establish that its value CAME from a narrow slot — only that it COULD have —
	// and `Parser.emitContainerElementAccessor` (the direct element read) and
	// `Parser.typeResultThroughInstance` (a value handed back through the opaque word by a shared corpus body,
	// which is how `pop`/`last`/`remove` and a cursor's `current()` read one) ask the identical question.
	//
	// ⛔⛔ **IT TAKES A NAME AND NOT A `MaxonType`, AND THAT IS THE WHOLE POINT: IDS DO NOT TRAVEL BETWEEN
	// INTERNERS, NAMES DO.** There are two interners — this index's, and the per-FILE table each parser holds
	// — and they assign ids in their own insertion orders. Every caller of this query holds a type the PARSER
	// re-interned (`containerSlotValueType`, `slotTypeThroughReceiver`), so handing its id to an index-space
	// lookup is right exactly while the two orderings coincide and silently wrong the moment they drift. That
	// is the wrong-interner read of which `slotTypeThroughReceiver` documents three measured faces — so the signature
	// is what refuses it here, not a comment.
	//
	// ⚠ **MEASURED, before the signature refused it:** `[Offset.behind, …].first()`
	// over a three-case enum at `-200 … 200` answered `-200` in a program that also declared
	// `typealias Offsets = Array with Offset` and **65336** in one that did not. Same source, same slot, same
	// ladder — the extra declaration only changed which order the two interners assigned ids in.
	//
	// ⚠ **ONLY A `named` LEAF CAN ANSWER YES, which is why the callers guard on the tag before spelling a
	// name.** Every other trivial tag is unsigned or a full word (`trivialElementSlot`'s own arm says so), and a
	// managed value's slot is a pointer, which is never read as a small negative number. A sub-byte PACKED
	// element answers no through the same route: packing exists only for a ZERO-BASED range
	// (`rangedAliasPackedBits` refuses any other), so its masked read IS its value.
	export function narrowSignedSlotOf(name ByteArray) returns SignExtendSlot
		let slot = self.namedTypeStorageSlot(name)
		return SignExtendSlot.fromBytes(slot.bytes) if slot.signExtends else SignExtendSlot.notASignExtension
	end 'narrowSignedSlotOf'

	// ⭐ **MAY A CONSTANT LITERAL OF THIS INSTANCE'S ELEMENTS BE LAID DOWN AS ONE `.rdata` BLOB?** — the
	// question the constant array literal's blob path turns on (`Parser.parseArrayLiteral`). A blob is the
	// elements' STORED bytes concatenated at `arrayElementSize`'s stride, so an element qualifies exactly
	// when its stored form IS its value, and only two kinds fail that:
	//   • a MANAGED element's slot holds a POINTER to a heap box, and an address the loader chooses is not
	//     a value a compile-time image can contain;
	//   • an OPAQUE type parameter's slot is a machine word whose content depends on the concrete instance
	//     the shared body is called with, so there is no ONE image to lay down.
	// Everything else stores its own value inline at a stride this index already answers — `bool`, a
	// sub-byte-packed ranged alias, a narrow enum tag, `integer`, `ExitCode`, a function pointer.
	//
	// ⚠ **ANSWERING YES IS NOT THE SAME AS REACHING A BLOB, and `float` is the case that shows it.** This
	// predicate admits a float or function element to the COLLECT path; whether that path then lays a blob
	// down is `everyElementIsAKnownConstant`'s question, and that one is the integer domain only. So a
	// `[1.5, 2.5]` literal collects and then builds through `__managed_create` + pushes like any other.
	//
	// ⚠⚠ **IT ASKED "IS THE ELEMENT NARROWER THAN A MACHINE WORD" UNTIL THIS SPEC, AND THAT EXCLUDED THE
	// MACHINE WORD FOR A REASON NO PROGRAM COULD SEE — output stability.**
	// `specs/codegen-internals.md` states the rule with no width in it (*"Constant array literals
	// (declared with `let`) are stored in the `.rdata` section"*) and pins `[10, 20, 30]` as
	// `i64[] 10, 20, 30`; under the narrow gate that literal reached `__managed_create` + three
	// `__managed_push` and the section held no such bytes AT ALL. Width was never the question;
	// whether the slot owns its own bytes is.
	export function arrayElementMayBeConstantBlob(id GenericInstanceId) returns bool
		return not self.containerElementIsManaged(id) and not self.containerElementIsOpaque(id)
	end 'arrayElementMayBeConstantBlob'

	// ⭐⭐ **IS THIS ELEMENT TYPE SUB-BYTE PACKED, AND HOW WIDE — THE ONE HOME OF THE PACKING RULE.**
	// `ElementPacking.byteStrided` for every element a byte or wider. The stamp above is derived from
	// it, and so is every runtime decision downstream, so "does this array pack?" is asked here or not
	// at all.
	//
	// The three arms are the whole rule:
	//   • a MANAGED element is an 8-byte pointer to a heap box — there is nothing to narrow, and the drop
	//     walk addresses each slot;
	//   • `bool` is the 1-bit case, and it is an ARM of this classifier rather than a mechanism beside it.
	//     That is what `specs/bool-bit-packing.md` and `specs/ranged-int-bit-packing.md` mean by "the same
	//     machinery extends to any non-negative ranged-integer typealias": there is one packed runtime, and
	//     `bool` reaches it by being `bits == 1`;
	//   • a `named` element is a ranged alias, answered whole-program (`packedBitsInEveryFile`) for the
	//     reason its byte twin is: the instance is interned on the NAME, so it has ONE stride.
	// Every other trivial tag — `integer`, `float`, `ExitCode` — is a byte or wider.
	//
	// ⭐ **THE DECISION IS MADE AT `__managed_create`, NOT AT FIRST `grow`, AND `LayoutDescriptor`'s
	// `bit1=bitPacked` FLAG IS RESERVED.** The create sites already hold the CONCRETE instance — the parser
	// mints it (`Parser.emitArrayCreateOp`), for a global's initializer as for a body — so the record is
	// never briefly unpacked and there is no second stamp site to disagree at. An opaque FixedArray create
	// reads its stride from the descriptor's `elementStride@72`, which is this same rule applied to the
	// descriptor's type argument.
	function elementPackingOfType(element MaxonType) returns ElementPacking
		if self.typeIsManaged(element, from: self.typeNames) 'managed'
			return ElementPacking.byteStrided
		end 'managed'

		let tag = maxonTypeTag(element)

		if tag == ValueTypeTag.boolean 'theOneBitCase'
			return BooleanPacking
		end 'theOneBitCase'

		if tag != ValueTypeTag.named 'notARangedAlias'
			return ElementPacking.byteStrided
		end 'notARangedAlias'

		return self.settledDeclarations().typeAliases.packedBitsInEveryFile(self.nameOfId(typeNameIdOf(element)))
	end 'elementPackingOfType'

	// ⭐ **DOES INSTANCE `id`'s ELEMENT STRIDE A FULL MACHINE WORD** — the question a door asks when it reads a
	// buffer ONE WORD PER SLOT and so cannot walk a byte-PACKED element (`Parser.parseListFromConstruction`,
	// whose `__list_from` copies the source array's slots into single-word nodes).
	//
	// It lives HERE, beside the producer, because it is a comparison between two answers this file already
	// owns: `arrayElementSize` above and `ManagedArrayElementBytes`. Written at the call site it would be a
	// THIRD transcription of the machine word — the header on `ManagedMemoryWordElementSize` names the two
	// this compiler admits — and a transcription is what drifts when a width is not what a door assumed.
	export function arrayElementIsMachineWord(id GenericInstanceId) returns bool
		return self.arrayElementSize(id) == ManagedArrayElementBytes
	end 'arrayElementIsMachineWord'

	// ⭐⭐ **IS THIS VALUE — OR THIS DECLARED TYPE — A BYTE-PACKED BUFFER?** The ONE stride question
	// every byte door in the compiler asks, asked in ONE place. An `Array with T` whose element strides ONE
	// byte IS a raw byte buffer whatever its element is CALLED: the record's `element_size@24` is 1, every
	// accessor moves by one byte, and the bytes it holds are just bytes.
	//
	// ⚠ **IT IS A STRIDE FACT AND NOT A NAME FACT, BECAUSE the compiler HAS TWO NAMES FOR A BYTE AND THE USER RULING
	// KEEPS THEM DISTINCT.** `Byte` is the user-visible element a `b"…"` literal, a `ByteArray` and
	// `__ManagedMemory` share; `__ManagedByte` is the compiler-owned element EVERY compiler-synthesized byte
	// buffer wears (see `SynthesizedByteElementName` for the two measurements that minted it). They are two
	// instances on purpose — a user may declare `Byte`, and a compiler-minted buffer's stride may not follow —
	// and they meet at a BOUNDARY, which is what this predicate lets a door recognize.
	//
	// The (tag, id) pair is asked through `isArrayInstanceAt`, which is where the tag half's reason lives.
	export function isBytePackedArrayInstance(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.isArrayInstanceAt(tag, nameId: nameId) and self.stridesOneByte(nameId as GenericInstanceId)
	end 'isBytePackedArrayInstance'

	export function isBytePackedBufferRecordInstance(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.isManagedBufferRecordInstanceAt(tag, nameId: nameId) and self.stridesOneByte(nameId as GenericInstanceId)
	end 'isBytePackedBufferRecordInstance'

	function stridesOneByte(id GenericInstanceId) returns bool
		return self.arrayElementSize(id) == (ByteStringElementSize as ElementStride)
	end 'stridesOneByte'

	function arrayElementIsNamed(tag ValueTypeTag, nameId TypeNameId, name ByteArray) returns bool
		return (try self.arrayNamedElementName(tag, nameId: nameId) otherwise return false).equals(name)
	end 'arrayElementIsNamed'

	// ⭐ **WHAT AN `Array` INSTANCE CALLS ITS ELEMENT, when the element is a `named` LEAF** — `absent`
	// for every other (tag, id) pair: a pair that is not an Array instance at all, and an Array over a
	// String / struct / nested instance, each name no element this file could mistake for a byte. One
	// walk, asked once per side of the door below, so the two sides cannot come to disagree about
	// where an element's name is read from.
	//
	// ⚠ It reads the element NAME rather than comparing the instance against `internSynthesizedByteInstance()`,
	// because that function WRITES: asking it would mint the view instance into `genericInstances` in every
	// program whose only reason to ask is a diagnostic it is about to raise, and an instance the sweep never
	// interned is one no mangled-name or witness walk expects to find.
	function arrayNamedElementName(tag ValueTypeTag, nameId TypeNameId) returns immutable ByteArray throws AbsentError
		if not self.isArrayInstanceAt(tag, nameId: nameId) 'notAnArrayInstance'
			throw AbsentError.absent
		end 'notAnArrayInstance'

		let element = self.containerElementType(nameId as GenericInstanceId)

		if maxonTypeTag(element) != ValueTypeTag.named 'notANamedElement'
			throw AbsentError.absent
		end 'notANamedElement'

		return self.nameOfId(typeNameIdOf(element))
	end 'arrayNamedElementName'

	// ⭐⭐ **THE BYTE-ELEMENT BOUNDARY DOOR** — the one place a value of one byte element type is
	// admitted where the other is declared, and the whole of what the user ruling *"the two byte element types
	// stay DISTINCT and convert at the BOUNDARY"* means in code. `stdlib/File.maxon:140-146` is what asks:
	// `String.addressableBytes()` yields `Array with __ManagedByte` and `FileWriter.open(path __ManagedMemory)`
	// declares `Array with Byte`, and both are the same 1-byte record.
	//
	// **THE ARRIVING SIDE IS AN IDENTITY TEST OVER THE ROSTER `isByteElementName` HOLDS. THE DECLARED SIDE IS
	// THREE TESTS — NAME, BOUNDS, STRIDE — AND EACH ONE IS THE ONLY REFUSAL ON ITS OWN MEASURED PROGRAM:**
	//
	//   • **The declared side's NAME test.** A program that declares `typealias Small = int(0 to 200)` gets a
	//     byte-PACKED `Array with Small` for free (`rangedAliasStorageBytes`), and a declared side that asked
	//     only the stride admitted a String's byte view into it — `b.get(0)`, an accessor typed
	//     `int(0 to 200)`, then read back **223** with no diagnostic (MEASURED). A one-byte slot
	//     is not a byte. What may be declared here is one of the compiler's TWO byte element names and nothing else.
	//   • **The declared side's BOUNDS test** (`RangedAliasRegistry.holdsEveryByteInEveryFile`). A program
	//     that declares `typealias Byte = int(0 to 200)` puts the SAME range on the ROSTER, and the roster is
	//     a question about the NAME — deliberately, because the base-name strip is what keeps
	//     `stdlib/File.maxon` compiling under a contested `Byte` (`isByteElementName`). So the name test says
	//     yes, the stride test says yes, and the program reads back **223 with no diagnostic** out of
	//     an element declared `int(0 to 200)` (`takes(<a cwd buffer>)` with
	//     `typealias Byte = int(0 to 200)`; rename the alias to `Small` and it was correctly refused, so the
	//     defect needed only the most natural name there is). A buffer the COMPILER minted is a run of RAW
	//     bytes; what receives one must admit every value a byte has, and this is where that is asked.
	//   • **The declared side's STRIDE test.** A program that declares `typealias Byte = int(0 to 1000)` makes
	//     every `Array with Byte` — including the one `__ManagedMemory` names — genuinely stride TWO, so the
	//     NAME is on the roster, the BOUNDS hold every byte, and the record is still not a byte buffer.
	//     Adopting a stride-1 view into it would hand every accessor a record it reads at the wrong width: a
	//     silent wrong answer, not a refusal. The stride test refuses exactly there, and it is LIVE —
	//     measured raising `expected 'Array_Byte', got 'Array___ManagedByte'` on that program.
	//
	// ⇒ the three are INDEPENDENT: `int(0 to 200)` clears name and stride but not bounds; `int(0 to 1000)`
	// clears name and bounds but not stride; `Small = int(0 to 255)` clears bounds and stride but not name.
	//
	// ✅ **THE `b"…"` ENTRANCE IS CLOSED.** A literal's every byte is
	// range-checked against its element's DECLARED bounds at the one rule function both of the literal's
	// doorways ask (`Parser.requireByteStringBlobFitsItsElement`), reported as E3005. The wide half of that
	// same rule is the E2015 the paragraph below describes; the two are one function, not two.
	//
	// ✅ **AND THE RAW-BYTE FILLS ARE CLOSED TOO, AT A RULE OF THEIR OWN RATHER THAN AT THIS DOOR.**
	// `String.toByteArray()` / `.bytes()` (`Parser.parseByteView`), the buffer surface's `setByte` and
	// `__ManagedFile.read` all write bytes that exist only at RUN TIME into a record typed
	// `internArrayByteInstance(<the reading file>)` — the USER's `Byte` — so none of them mints
	// `SynthesizedByteElementName` and this door never sees any of them. Unguarded, all three are silent
	// wrong answers (195, 223, 223) under `typealias Byte = int(0 to 100)`.
	// ⛔ **BUT THE CURE IS *NOT* TO MINT `__ManagedByte` AT THOSE PRODUCERS, AND THAT IS MEASURED RATHER
	// THAN PREFERRED.** A byte view is not a buffer of this element's kind: `emitArrayCreateOp` stamps its
	// `element_size@24` from the very instance it is typed as, so a wide `Byte` gives it a genuinely stride-2
	// record that `__str_to_bytes` fills at that stride — correct today, and the STRIDE bullet above is
	// exactly what would refuse a retyped stride-1 view at every declared byte-array position. The element
	// belongs to the program; only its BOUNDS were never asked. ⇒ `Parser.requireRawByteFillFitsItsElement`
	// asks the same `rangeHoldsEveryByte` this door's BOUNDS bullet asks, one quantifier tighter (the reading
	// file's own mint rather than every declaration of the name), and reports E3117.
	//
	// ⚠⚠ **THE ARRIVING SIDE IS AN IDENTITY TEST AND NOT A STRIDE TEST, AND THE DIFFERENCE IS A
	// TYPE HOLE MEASURED BEFORE IT SHIPPED.** "Both sides byte-packed" reads as the symmetric rule and is
	// WRONG: `rangedAliasStorageBytes` gives EVERY range that fits `u8.max` a 1-byte slot, so
	// `typealias Small = int(0 to 200)` makes `Array with Small` byte-packed too — and a symmetric door would
	// admit a `Small` buffer wherever a `Byte` one is declared, in ordinary USER code, silently erasing a
	// nominal distinction `namedAggregatesConflict` refuses today. The stride is what the RECORD says; the
	// element's declared RANGE is what it does not, and a 1-byte element is not a byte just because it fits in
	// one. `specs/bytearray-element-size.md`'s `byte-packed-alias-is-not-interchangeable-with-byte` pins it.
	// ⇒ what may cross is exactly ONE thing: `__ManagedByte`, which is `__`-RESERVED and carries no range of
	// its own for a declared `Byte` to contradict — a compiler-minted byte buffer is bytes
	// (`SynthesizedByteElementName`).
	//
	// ⭐⭐ **IT IS ASKED AT EVERY COERCION SITE, THROUGH `aggregatesConflict`.** Compiler-synthesized
	// byte buffers are parsed out of ORDINARY USER SOURCE
	// (`__ManagedDirectory.filename`/`currentPath`, `__Builtins.commandLineArg`), so every door a
	// value crosses refuses a legal program without it — the call argument
	// (`SemanticCheck.checkOneArgType`), `return`, reassignment, `otherwise`, a match arm's merge, a
	// struct-literal / union-payload store, and a generic call's type-parameter argument. All are
	// load-bearing and pinned. The shortest program that needs it is four lines:
	//
	//     function cwd() returns __ManagedMemory
	//         return try __ManagedDirectory.currentPath() otherwise panic("cwd")
	//     end 'cwd'
	//
	// ⇒ the door is folded into `aggregatesConflict`, which every one of those sites already asked and which
	// now takes each side's (tag, nameId) beside its aggregate NAME. That shape is forced: the name those
	// sites compare is spelled against the asker's interner (`aggregateNameIn`, `typeArgAggregateName`), so
	// it cannot be re-derived here — but the pair CAN be passed, because a `genericInstance`'s id is
	// whole-program in every interner. Spelling
	// `namedAggregatesConflict(…) and not byteBufferBoundaryAdmits(…)` at each site instead would be the
	// one-fact-two-answers shape this door exists to end, and is exactly how the sites came to disagree.
	// `specs/bytearray-element-size.md`'s `a-synthesized-buffer-crosses-every-declared-byte-buffer-door`
	// pins six of them in one program.
	//
	// ⭐⭐ **ONE MORE DOOR DOES *NOT* COME THROUGH `aggregatesConflict` — `Parser.requireSameArrayInstance`.**
	// `ByteArray.init(managed)` has a rule of its own (the argument's generic instance must EQUAL the
	// receiver alias's, which is element-agnostic and strictly stronger than the byte rule), so it asks raw
	// instance equality rather than an aggregate comparison — and therefore inherits none of the rules
	// above. It refused `StdinSource.readSome`'s `ByteArray.init(__Builtins.readStdin(most))` with `E3005
	// expected '__ManagedMemory with Byte', got 'Array___ManagedByte'` — a legal module — so it asks THIS
	// function directly, after its own equality test.
	// ⚠ **THAT ASYMMETRY IS THE THING TO KEEP IN VIEW WHEN ANOTHER DOOR ARRIVES**: the rest ride
	// `aggregatesConflict` and are covered by construction, this one asks here by name. A new
	// whole-container coercion rule spelled as raw instance equality is invisible to the others.
	// `specs/array-init.md`'s `a-synthesized-byte-buffer-adopts` and
	// `error.a-synthesized-buffer-is-refused-at-a-narrowed-byte` pin it (admission and the BOUNDS
	// refusal that keeps it honest).
	// ⚠ Not to be confused with `append`'s "NINTH COERCION SITE" one function down: that site is deliberately
	// NOT one of these doors (see its own ⚠ paragraph).
	export function byteBufferBoundaryAdmits(declaredTag ValueTypeTag, declaredNameId TypeNameId, gotTag ValueTypeTag, gotNameId TypeNameId) returns bool
		let declaredElement = try self.arrayNamedElementName(declaredTag, nameId: declaredNameId) otherwise return false

		if not self.declaredByteElementHoldsEveryByte(declaredElement) 'declaredElementIsNotAByteElement'
			return false
		end 'declaredElementIsNotAByteElement'

		if not self.isBytePackedArrayInstance(declaredTag, nameId: declaredNameId) 'declaredRecordDoesNotStrideOneByte'
			return false
		end 'declaredRecordDoesNotStrideOneByte'

		return self.arrayElementIsNamed(gotTag, nameId: gotNameId, name: SynthesizedByteElementName)
	end 'byteBufferBoundaryAdmits'

	// ⭐⭐ **THE INFERRED-INT-COLUMN BOUNDARY — the byte door's twin, and the second place two DIFFERENT
	// container instances denote one record.** `[10, 20, 30]` names no element type: the author wrote three
	// integers and the compiler picked `Array with integer` for them (`internBuiltinIntegerInstance`). A
	// declared `typealias Integer = int(i64.min to i64.max)` + `Array with Integer` — the idiom nearly every
	// spec file in the tree opens with — is a DIFFERENT instance by name, so `IntList.create([10, 20, 30])`
	// was `E3005 expected 'Array_Integer', got 'Array_int'` on a program that must compile — the literal's
	// element is inferred from the position it sits in.
	//
	// ⚠ **THE ARRIVING SIDE IS THE COMPILER'S OWN INFERENCE, AND THAT ASYMMETRY IS THE WHOLE LICENCE.** An
	// `integer` column is the one column type NO author spelled — every column a user writes arrives
	// `named`/`structRef`/`string` — so admitting it commits nothing the author decided. Two AUTHOR-written
	// spellings stay nominal in both directions, exactly as they do at the byte boundary and for the same
	// reason: The compiler compares declared aggregates by NAME, and this door is about a value that has no name to
	// compare.
	//
	// ⚠ **THE DECLARED SIDE MUST ADD NOTHING TO `int`, AND THAT ONE TEST COVERS BOTH WAYS IT COULD.**
	// `spansEveryIntInEveryFile` demands the full i64 span, which settles the VALUE SET (no value a literal
	// can hold is out of range, so nothing goes unchecked) and, as a consequence rather than a second
	// condition, the SLOT (`rangedAliasStorageBytes` gives the full span the machine word, which is the stride
	// the arriving record was created with). A narrower alias — `Byte`, `int(0 to 100)` — fails it and keeps
	// the refusal it has today, which is the right answer: its record would stride differently and its range
	// would go unchecked.
	//
	// ⚠⚠ **A `Map` HAS TWO COLUMNS AND THE DOOR KNEW ONLY ABOUT ONE, WHICH REFUSED `/specs/map.md`'s OWN
	// PROGRAM.** `for-in.nested` writes `typealias IntMap = Map with (Integer, Integer)` and passes it a
	// `[1: 1, 2: 2, 3: 3]` literal — `E3005 expected 'IntMap', got 'Map_int_int'`, the identical sentence the
	// `Array` half of this door was built to stop, one container over. The literal's map is inferred exactly
	// as the literal's array is (`Parser.parseMapLiteralBody` reads both column types off the first pair), so
	// the LICENCE is unchanged and only the ARITY is: every column must independently denote one slot.
	//
	// A column pair that is simply IDENTICAL denotes one slot too. For a two-column `Map` that is what keeps
	// `["a": 1]` reaching a `Map with (String, Integer)`: one column inferred, one written by the author, and
	// refusing the pair because of the half that AGREES would be arbitrary.
	//
	// ⛔ ***"For a single-column `Array` that clause can never fire — identical columns mean identical
	// instances"* IS FALSE.** A program declaring its own `type Array` leaves TWO `Array` declarations live —
	// its own under the bare name and the corpus's under this compile's mint (`contestStdlibTypeName`) — so
	// `Array with String` and `__Array with String` are DIFFERENT instances with IDENTICAL columns, and the
	// clause fires for a single-column container after all.
	//
	// ⚠ **IT IS ADMITTING THE RIGHT THING, WHICH IS WHY THE ANSWER IS NOT A NARROWING.**
	// `declarationIsTheManagedRecord` admits an `Array` declaration ONLY in the sole-field-and-that-field-the-buffer
	// shape, so two such declarations over one element denote one record to the byte — same stride, same drop,
	// same clone — which is the very question this door exists to answer. Refusing the pair would leave a
	// program with its own container unable to call `String.from`, `String.split` or `toByteArray` at all,
	// for a nominal distinction with nothing behind it. `specs/array-declared-record.md` pins both
	// crossings, beside the two refusals that show the MEMBER surfaces staying apart.
	function inferredIntColumnBoundaryAdmits(declaredTag ValueTypeTag, declaredNameId TypeNameId, gotTag ValueTypeTag, gotNameId TypeNameId) returns bool
		if self.isArrayInstanceAt(gotTag, nameId: gotNameId) and self.isArrayInstanceAt(declaredTag, nameId: declaredNameId) 'bothAreArrayInstances'
			return self.instancesShareAShape(declaredNameId, gotNameId: gotNameId) and self.columnsDenoteOneSlot(self.containerElementType(declaredNameId as GenericInstanceId), gotColumn: self.containerElementType(gotNameId as GenericInstanceId))
		end 'bothAreArrayInstances'

		// The SHAPE predicate, not the runtime one: this arm is about a container having two columns, which is
		// true of the corpus `Map` exactly as it was of the synthesized one. See `isMapShapedInstanceAt`.
		if self.isMapShapedInstanceAt(gotTag, nameId: gotNameId) and self.isMapShapedInstanceAt(declaredTag, nameId: declaredNameId) 'bothAreMapInstances'
			return self.instancesShareAShape(declaredNameId, gotNameId: gotNameId) and self.columnsDenoteOneSlot(self.mapKeyType(declaredNameId as GenericInstanceId), gotColumn: self.mapKeyType(gotNameId as GenericInstanceId)) and self.columnsDenoteOneSlot(self.mapValueType(declaredNameId as GenericInstanceId), gotColumn: self.mapValueType(gotNameId as GenericInstanceId))
		end 'bothAreMapInstances'

		return false
	end 'inferredIntColumnBoundaryAdmits'

	export function joinedFixedArrayArgument(held MaxonType, next MaxonType) returns MaxonType
		if self.sizedFixedArrayWidens(maxonTypeTag(next), declaredNameId: typeNameIdOf(next), gotTag: maxonTypeTag(held), gotNameId: typeNameIdOf(held)) 'theLaterArgumentIsRuntimeSized'
			return next
		end 'theLaterArgumentIsRuntimeSized'

		return held
	end 'joinedFixedArrayArgument'

	export function sizedFixedArrayWidens(declaredTag ValueTypeTag, declaredNameId TypeNameId, gotTag ValueTypeTag, gotNameId TypeNameId) returns bool
		if not self.isFixedArrayInstanceAt(declaredTag, nameId: declaredNameId) or not self.isFixedArrayInstanceAt(gotTag, nameId: gotNameId) 'notTwoFixedArrays'
			return false
		end 'notTwoFixedArrays'

		if not self.rowShape(declaredNameId as GenericInstanceId).isRuntimeSized() or not self.rowShape(gotNameId as GenericInstanceId).isSized() 'notRuntimeSizedFromSized'
			return false
		end 'notRuntimeSizedFromSized'

		return self.columnsDenoteOneSlot(self.containerElementType(declaredNameId as GenericInstanceId), gotColumn: self.containerElementType(gotNameId as GenericInstanceId))
	end 'sizedFixedArrayWidens'

	export function gotSideNote(gotTag ValueTypeTag, gotNameId TypeNameId, gotBrand ByteArray, gotIdentity ByteArray, gotShown String, declaredTag ValueTypeTag, declaredNameId TypeNameId, declaredShown String) returns String
		return "{self.contestedTypeNote(gotTag, nameId: gotNameId, brand: gotBrand, identity: gotIdentity, shown: gotShown, otherShown: declaredShown)}{self.runtimeSizedLengthNote(declaredTag, declaredNameId: declaredNameId, gotTag: gotTag, gotNameId: gotNameId)}"
	end 'gotSideNote'

	function runtimeSizedLengthNote(declaredTag ValueTypeTag, declaredNameId TypeNameId, gotTag ValueTypeTag, gotNameId TypeNameId) returns String
		if not self.isFixedArrayInstanceAt(declaredTag, nameId: declaredNameId) or not self.isFixedArrayInstanceAt(gotTag, nameId: gotNameId) 'notTwoFixedArrays'
			return ""
		end 'notTwoFixedArrays'

		if not self.rowShape(declaredNameId as GenericInstanceId).isSized() or not self.rowShape(gotNameId as GenericInstanceId).isRuntimeSized() 'notSizedFromRuntimeSized'
			return ""
		end 'notSizedFromRuntimeSized'

		return " — a runtime-sized fixed array's length is not part of its type; build it with a constant length"
	end 'runtimeSizedLengthNote'

	function instancesShareAShape(declaredNameId TypeNameId, gotNameId TypeNameId) returns bool
		return self.rowShape(declaredNameId as GenericInstanceId).sameAs(self.rowShape(gotNameId as GenericInstanceId))
	end 'instancesShareAShape'

	// ⭐ **ONE COLUMN OF THE DOOR ABOVE.** Two columns denote one slot when they are the SAME type — compared
	// on the (tag, id) pair `GenericInstanceRegistry.instanceKey` already treats as a type's whole identity,
	// so this cannot call two types one where the interner calls them two — or when the arriving one is the
	// compiler's own `integer` inference and the declared one is a ranged alias that adds nothing to `int`.
	//
	// A name NO file declares as a ranged alias is a struct / union / interface column, which an integer slot
	// is not, so a registry miss (`spansEveryIntInEveryFile`'s `MapError`) answers false.
	function columnsDenoteOneSlot(declaredColumn MaxonType, gotColumn MaxonType) returns bool
		if maxonTypeTag(declaredColumn) == maxonTypeTag(gotColumn) and typeNameIdOf(declaredColumn) == typeNameIdOf(gotColumn) 'oneAndTheSameType'
			return true
		end 'oneAndTheSameType'

		if maxonTypeTag(gotColumn) != ValueTypeTag.integer 'gotColumnWasNamedByTheAuthor'
			return false
		end 'gotColumnWasNamedByTheAuthor'

		if maxonTypeTag(declaredColumn) != ValueTypeTag.named 'declaredColumnIsNotANamedLeaf'
			return false
		end 'declaredColumnIsNotANamedLeaf'

		return try self.settledDeclarations().typeAliases.spansEveryIntInEveryFile(self.nameOfId(typeNameIdOf(declaredColumn))) otherwise false
	end 'columnsDenoteOneSlot'

	// ⭐⭐ **MAY THE SLOT RESTATE THIS LITERAL'S ELEMENT COLUMN? — `columnsDenoteOneSlot`'s LICENCE, ASKED OF
	// THE TWO INSTANCES RATHER THAN OF ONE.** Both halves are load-bearing and each refuses a different
	// program:
	//
	//   • the ARRIVING column must be the compiler's own `integer` inference, the one column type NO author
	//     spelled — every column a user writes arrives `named`, `structRef`, `string` or `float`, so
	//     restating one would overrule the source. It is the line the brand rule draws for a whole value
	//     (an unbranded literal fits any brand, a branded value fits only its own), drawn at the element;
	//   • the DECLARED column must be a ranged alias, because that is the only thing an `integer` column can
	//     BE restated as. A `String`, struct, float or nested-container element is not a wider spelling of an
	//     int, so `[1, 2]` at an `Array with String` parameter is not a literal to rebuild — it is the wrong
	//     argument, and it keeps the positioned `E3005 … expected 'Words', got 'Array_int'` it earns.
	//
	// ⚠ **ONE HALF ALONE IS A WORSE DIAGNOSTIC, MEASURED.** Asked of the arriving column only, a literal of
	// `Octet`s at a `ByteArray` parameter and a literal of ints at a `String`-element one were both adopted
	// and then re-refused element by element, losing the argument's own sentence.
	//
	// A nested-container column is restated only to the instance the declared column already denotes. The
	// literal adopts the declared id rather than one canonical id for the two: `instanceArgBrand` reads the
	// raw argument, so only the declared id carries the brand its elements are held to.
	export function arrayElementMayBeRestated(declared GenericInstanceId, got GenericInstanceId) returns bool
		let gotElement = self.containerElementType(got)
		let gotTag = maxonTypeTag(gotElement)
		let declaredElement = self.containerElementType(declared)

		if gotTag == ValueTypeTag.integer 'anIntegerElement'
			return maxonTypeTag(declaredElement) == ValueTypeTag.named
		end 'anIntegerElement'

		if gotTag == ValueTypeTag.genericInstance 'aNestedContainerElement'
			let denoted = try self.denotedInstance(declaredElement) otherwise return false
			return denoted == genericInstanceIdOf(gotElement)
		end 'aNestedContainerElement'

		return gotTag == ValueTypeTag.function and self.slotTypeIsAFunctionValue(declaredElement)
	end 'arrayElementMayBeRestated'

	export function slotTypeIsAFunctionValue(slotType MaxonType) returns bool
		let tag = maxonTypeTag(slotType)

		if tag == ValueTypeTag.function 'aFunctionType'
			return true
		end 'aFunctionType'

		return tag == ValueTypeTag.named and self.isFunctionAliasInAnyFile(self.nameOfId(typeNameIdOf(slotType)))
	end 'slotTypeIsAFunctionValue'

	// IS THE DECLARED ELEMENT A BYTE ELEMENT? -- asked of its RANGE, deliberately not of its SPELLING.
	//
	// The byte boundary is about what a slot can HOLD: a one-byte stride whose every value is a byte
	// value. `typealias ByteVal = int(0 to u8.max)` strides and holds exactly as `Byte` does, and the
	// synthesized buffer behind a `String` must reach either. The range answers that for every
	// spelling at once, and it SUBSUMES a name test rather than dropping one: a name test answers
	// `true` for a name that is no ranged alias at all, so only a range can bound the door. Asked as
	// one question with no `otherwise true`, a non-alias element is refused whatever it is spelled.
	//
	// The compiler's own mint is admitted by name because it IS a name and not a declaration: nothing
	// registers `__ManagedByte` as a ranged typealias, so there is no range to ask about. It reaches here
	// only when both sides are compiler mints, which raw instance equality has already answered.
	function declaredByteElementHoldsEveryByte(element ByteArray) returns bool
		if sourceSpelledAliasName(element).equals(SynthesizedByteElementName) 'theCompilersOwnMint'
			return true
		end 'theCompilersOwnMint'

		return try self.settledDeclarations().typeAliases.holdsEveryByteInEveryFile(element) otherwise false
	end 'declaredByteElementHoldsEveryByte'

	// ⭐⭐ **MAY `append` COPY FROM THIS ARRAY INTO A RECEIVER OF `receiverGiid`? — THE NINTH COERCION
	// SITE, ASKED IN ONE PLACE FOR BOTH SURFACES OF THE RECORD.** `Array.append` and the buffer
	// surface's `append` are one operation with one precondition and two diagnostics
	// (`Parser.requireAppendArg`, whose `appendArgMismatch` picks the sentence by the type each
	// surface's SIGNATURE names).
	//
	// ⭐ **IT IS NOT THE WHOLE-ARRAY COERCION A DECLARED PARAMETER ASKS, AND THAT IS THE WHOLE SEPARATION.**
	// A parameter HANDS THE CONTAINER OVER — the callee may push into it, and what it pushes is read back
	// through the caller's element — so there the identity of the array is the question, and
	// `aggregatesConflict` refuses `Array_Small` at an `Array_Byte` parameter even though every `Small`
	// value fits a byte. `append` hands nothing over: the argument is BORROWED, its element VALUES are
	// copied into the receiver's own storage, and the receiver stays its own type. So the honest question
	// is the one a `push` of each element would ask — *may this value be stored in that element?* — asked
	// once for the whole run, because a bulk byte copy has nowhere to put the runtime range check a `push`
	// gets (`InsertRangeChecks`). MEASURED: `b.push(<a Small value>)` panics `Range check failed: value
	// outside typealias 'Byte'`, while `b.append(<the Smalls>)` copied the same 150 in silently.
	//
	// ⇒ **TWO QUESTIONS, BOTH ASKED, NEITHER STANDING IN FOR THE OTHER:**
	//
	//   • **REPRESENTATION** (`sameTrivialArrayShape`) — same managedness, same `element_size@24`. This is
	//     what makes `__managed_append`'s byte copy legal at all, and it is the test that was here ALONE. A
	//     width is not a type: it admits EVERY one-byte trivial element in the program, which is exactly
	//     how a `Small` (and a `bool`) walked into a `Bytes` and how two enums walked into each other.
	//   • **VALUE DOMAIN** (`trivialElementAdmitsEveryValueOf`) — every value the argument's element can
	//     hold must be a value the receiver's element admits. Asymmetric on purpose: a `Byte`
	//     (`int(0 to 100)`) source into a `Small` (`int(0 to 200)`) destination cannot produce an
	//     out-of-range read and stays legal, and refusing both directions would be over-refusal.
	//
	// ⚠ **AND THERE IS NO THIRD QUESTION — IN PARTICULAR NOT `byteBufferBoundaryAdmits`.** The
	// byte boundary is a NOMINAL whole-container door and is one-way by design: only `__ManagedByte` may be
	// adopted where a byte-holding `Byte` is DECLARED, never the reverse. `append` adopts nothing, so asking
	// it here imported that one-way-ness into a site with no reason for it — MEASURED, a `currentPath()`
	// buffer receiving an `Array with Byte` stops compiling as soon as that door is asked here,
	// the exact mirror of the acceptance case `a-byte-that-holds-every-byte-still-appends-a-synthesized-buffer`. The cure is not a second door in the
	// other direction: it is that the compiler-owned byte element HAS a value set
	// (`elementIntegerValueRange`), which makes the domain test answer both directions on its own. Asking
	// both would be one byte fact with two answers that nothing keeps in agreement — and the one that
	// diverges silently is the nominal door, because it admits rather than refuses.
	//
	// ⛔ **REPLACING THE FIRST WITH INSTANCE IDENTITY WOULD REFUSE A CORRECT PROGRAM.** `[1, 2, 3]` mints
	// `Array with int` (`internBuiltinIntegerInstance`) and `IntArray.create()` an `Array with Integer` —
	// two instances over ONE value set — and `arrays.md`'s `append-empty-to-nonempty` /
	// `append-nonempty-to-empty` join them. The domain test is what admits that pair without admitting the
	// pairs above; the giids genuinely differ and always will, because an instance interns on the element's
	// NAME.
	//
	export function arrayAppendArgAdmits(receiverGiid GenericInstanceId, argTag ValueTypeTag, argNameId TypeNameId, readerFilePath FilePath) returns bool
		if not self.isArrayInstanceAt(argTag, nameId: argNameId) 'notAnArrayAtAll'
			return false
		end 'notAnArrayAtAll'

		// A MANAGED receiver deep-clones each element through the RECEIVER's own `funcAddr(__clone_<E>)`
		// stamp and an OPAQUE one through the receiver's descriptor `copyFunc@32`; both are
		// receiver-specific, so nothing but the receiver's own instance fits. There is no representation to
		// share and no range to widen — the instance IS the question, which is why the two arms are one.
		//
		// ⚠ **THE `==` IS SAFE ONLY BECAUSE THE TAG TEST ABOVE HAS ALREADY RUN, AND THAT ORDER IS AN
		// INVARIANT, NOT AN ACCIDENT.** `TypeNameId` and `GenericInstanceId` share a numeric space
		// (`isArrayInstanceAt`'s own header), so comparing a bare name's number against an instance id can
		// answer TRUE by coincidence — never a compile error, and a non-`Array` argument would be admitted.
		// `isArrayInstanceAt` is what pins `argNameId` to a generic instance; hoisting this arm above it
		// would reintroduce that exact wrong answer.
		// ⚠ The opaque arm lives HERE and not as a separately spelled arm in `Parser.requireAppendArg`: it
		// states the SAME rule — identical giid — and two spellings of one rule are free to disagree.
		if self.containerElementIsManaged(receiverGiid) or self.containerElementIsOpaque(receiverGiid) 'receiverCopiesThroughItsOwnElement'
			return argNameId == receiverGiid as TypeNameId
		end 'receiverCopiesThroughItsOwnElement'

		if not self.sameTrivialArrayShape(receiverGiid, otherGiid: argNameId as GenericInstanceId) 'noSharedRepresentation'
			return false
		end 'noSharedRepresentation'

		return self.trivialElementAdmitsEveryValueOf(receiverGiid, sourceGiid: argNameId as GenericInstanceId, readerFilePath: readerFilePath)
	end 'arrayAppendArgAdmits'

	// Do two array instances hold TRIVIAL elements of the same storage width — the REPRESENTATION half of
	// the rule above, and the whole of what the byte copy itself requires. Kept as its own function because
	// it is the half that is NOT a statement about types, and the rule's header turns on saying so.
	function sameTrivialArrayShape(giid GenericInstanceId, otherGiid GenericInstanceId) returns bool
		return not self.containerElementIsManaged(otherGiid) and self.arrayElementSize(otherGiid) == self.arrayElementSize(giid)
	end 'sameTrivialArrayShape'

	// The VALUE-DOMAIN half. Two spellings of one element are one element, which the INSTANCE already
	// answers for — an `Array` instance interns on its element type, so equal giids are equal elements and
	// no bounds need be read at all. Everything else has to compare the two value sets.
	function trivialElementAdmitsEveryValueOf(destGiid GenericInstanceId, sourceGiid GenericInstanceId, readerFilePath FilePath) returns bool
		if destGiid == sourceGiid 'oneInstanceIsOneElement'
			return true
		end 'oneInstanceIsOneElement'

		// ⭐ **TWO ELEMENTS THE AUTHOR NAMED ARE TWO TYPES, AND THE VALUE DOMAIN IS NOT ASKED OF THEM.** `Bytes`
		// does not append into `Smalls` however the two ranges nest: `Byte` and `Small` are two types. What
		// the domain test still admits is a side NOBODY named — the compiler's own `int` inference behind a
		// `[1, 2, 3]` literal, and its own byte element behind a synthesized buffer — which decays against
		// any alias whose range holds every value the source can carry.
		if self.elementCarriesAnAuthorsAlias(sourceGiid) and self.elementCarriesAnAuthorsAlias(destGiid) 'twoNamedElementsAreTwoTypes'
			return false
		end 'twoNamedElementsAreTwoTypes'

		return match self.elementIntegerValueRange(destGiid, readerFilePath: readerFilePath) 'destination'
			notIntegerValued gives false
			inclusive(low, high) gives self.elementValuesFitWithin(sourceGiid, destLow: low, destHigh: high, readerFilePath: readerFilePath)
		end 'destination'
	end 'trivialElementAdmitsEveryValueOf'

	// The SOURCE side of that comparison, split out because one `match` can read only one side and a nested
	// pair would hide which side each arm speaks for — `requireRawByteFillFitsItsElement`'s shape, for its
	// reason.
	function elementCarriesAnAuthorsAlias(giid GenericInstanceId) returns bool
		let element = self.containerElementType(giid)
		return maxonTypeTag(element) == ValueTypeTag.named and not self.typeNames.equalsAt(typeNameIdOf(element), other: SynthesizedByteElementName)
	end 'elementCarriesAnAuthorsAlias'

	function elementValuesFitWithin(sourceGiid GenericInstanceId, destLow FullRangeInt, destHigh FullRangeInt, readerFilePath FilePath) returns bool
		return match self.elementIntegerValueRange(sourceGiid, readerFilePath: readerFilePath) 'source'
			notIntegerValued gives false
			inclusive(low, high) gives inclusiveRangeContains(destLow, destHigh: destHigh, sourceLow: low, sourceHigh: high)
		end 'source'
	end 'elementValuesFitWithin'

	// ⭐ **THE INCLUSIVE INTEGER VALUE SET AN ARRAY'S ELEMENT ADMITS, AS `readerFilePath` RESOLVES IT.**
	// Only two element kinds have one: a bare `int` (the machine word's whole signed range) and a ranged
	// INT alias (its declared bounds). A `bool`, an `ExitCode`, an enum, a function type, an opaque `T` and
	// a float alias each have `notIntegerValued` — not because they are exotic, but because there is no
	// value set for a range test to compare and their only honest admission is the instance identity the
	// caller has already tried.
	//
	// ⚠ The reader's own file is the right quantifier, and it is the one used for the same registry:
	// a range-CONTESTED name is qualified per claimant by the time it is an instance's type argument
	// (`RangedAliasRegistry.settleRangeContests`), so both sides of one `append` resolve the same way and
	// an uncontested name answers identically from every file.
	function elementIntegerValueRange(giid GenericInstanceId, readerFilePath FilePath) returns ElementIntegerRange
		if maxonTypeTag(self.containerElementType(giid)) == ValueTypeTag.integer 'aBareMachineWordInt'
			return ElementIntegerRange.inclusive(BareIntegerElementLow, high: BareIntegerElementHigh)
		end 'aBareMachineWordInt'

		// ⭐⭐ **THE COMPILER-OWNED BYTE ELEMENT HAS A VALUE SET — IT SIMPLY HAS NO DECLARATION TO READ IT
		// OFF, AND ANSWERING `notIntegerValued` MADE THE DOMAIN TEST ONE-WAY.** MEASURED: a
		// `currentPath()` buffer receiving an `Array with Byte` whose `Byte` is `int(0 to u8.max)` stops
		// compiling under that answer — `expected '__ManagedMemory', got 'Array_Byte'` — the
		// exact MIRROR of `a-byte-that-holds-every-byte-still-appends-a-synthesized-buffer`, an acceptance
		// case. Nothing can be read back out of range in either direction: both
		// elements admit exactly the byte values, so both appends are correct programs.
		//
		// ⚠ The two bounds are `Project.ByteValueSetLow`/`High` — the SAME pair `rangeHoldsEveryByte`
		// measures every declared byte element against, because a second spelling of them here would be a
		// second definition of what a byte is. `arrayAppendArgAdmits`'s header carries the rest of the
		// argument, including why no nominal door belongs beside this one.
		if self.arrayElementIsNamed(ValueTypeTag.genericInstance, nameId: giid as TypeNameId, name: SynthesizedByteElementName) 'aCompilerMintedBufferHoldsRawBytes'
			return ElementIntegerRange.inclusive(ByteValueSetLow, high: ByteValueSetHigh)
		end 'aCompilerMintedBufferHoldsRawBytes'

		return match self.arrayElementAliasOf(giid, readerFilePath: readerFilePath) 'element'
			undeclared gives ElementIntegerRange.notIntegerValued
			declared(alias) gives integerAliasValueRange(alias)
		end 'element'
	end 'elementIntegerValueRange'

	// ⭐⭐ **DOES THIS INSTANCE'S ELEMENT ADMIT EVERY BIT PATTERN OF ITS OWN SLOT? (E3118.)** The
	// question the buffer surface's RAW-BYTE WRITER has to ask, and it is one question at every stride:
	// `setByte` addresses a byte OFFSET, so on a record striding more than a byte it writes a FRAGMENT of an
	// element, and what the ARRAY surface reads back afterwards is an arbitrary UNSIGNED value of the whole
	// slot — the load of an unsigned slot zero-extends (`ManagedMemoryRuntime.emitStrideSlotLoad`), which is what
	// makes the slot's value set unsigned and makes this comparable at all.
	//
	// ⚠⚠ **IT IS NOT `rangeHoldsEveryByte` WIDENED, AND THE DIFFERENCE IS A MEASURED WRONG ANSWER IN EACH
	// DIRECTION.** "Admits every BYTE" is this answer at a ONE-byte slot and nothing more general: asked at a
	// wider slot it refuses a correct `Array with Int`, and asked
	// only at a one-byte slot it lets `typealias Wide = int(0 to 1000)` read back **57089** through an
	// accessor declared `int(0 to 1000)`. So the one-byte case ASKS that predicate rather than re-spelling
	// it, and every wider case asks the slot.
	//
	// ⭐ **THE ADMITTING DIRECTION MUST BE A PROOF.** This door lets RAW BYTES into a declared element, so an
	// element whose value set the compiler cannot compare — a `bool` (two values in a one-byte slot), an
	// `ExitCode` (a PLATFORM-DEPENDENT domain), an enum's ordinal, a float alias whose bounds are IEEE-754
	// bit patterns, an opaque `T`, a function pointer — is REFUSED rather than guessed at. That is
	// `rangeHoldsEveryByte`'s own conservative argument one quantifier out. A MANAGED element never reaches
	// here at all: `Parser.requireBufferBytesAreNotAPointer` (E3110) has refused it a line earlier, because
	// its bytes are an ADDRESS at every offset.
	export function elementAdmitsEverySlotValue(giid GenericInstanceId, readerFilePath FilePath) returns bool
		match self.elementIntegerValueRange(giid, readerFilePath: readerFilePath) 'valueSet'
			inclusive(low, high) then return rangeHoldsEverySlotValue(low, high: high, slotBytes: self.arrayElementSize(giid))
			notIntegerValued then return self.elementIsAByteNoFileDeclares(giid)
		end 'valueSet'
	end 'elementAdmitsEverySlotValue'

	// The ONE element with no value set that still admits every pattern of its slot: the `Byte` a `b"…"`
	// literal MINTS FOR ITSELF in a program that declares no such alias or enum. `undeclaredNamedElementSlot`
	// gives it a one-byte slot by construction and there is no declared range for a raw byte to fall outside
	// of — exactly the case `Parser.requireRawByteFillFitsItsElement` returns on, asked here of the slot
	// instead of the byte.
	//
	// ⚠ **THE DECLARATION IS ASKED AS WELL AS THE NAME, and dropping either half is a wrong acceptance.**
	// `isByteElementName` is a ROSTER over the two names the compiler gives a byte, so a `typealias Byte = float(…)`
	// is byte-NAMED and declared, and its bounds are IEEE-754 bit patterns no slot test can read; and a name
	// that is NOT on the roster and that no file declares is an ENUM or a boxed union's ordinal, which keeps
	// the machine word and admits only the ordinals its declaration lists. `__ManagedByte` cannot reach here
	// at all — `elementIntegerValueRange` hands it a byte's value set one arm up — so this is the literal's
	// own `Byte` alone.
	//
	// ⚠ The declaration is asked WHOLE-PROGRAM rather than of a reading file, and that is the quantifier the
	// SLOT has: `undeclaredNamedElementSlot` is reached exactly when `storageBytesInEveryFile` misses,
	// and it is the only thing that makes this element's slot one byte. Asking a file instead would accept a
	// name some OTHER file declares wide, whose slot is then that file's width and not a byte.
	function elementIsAByteNoFileDeclares(giid GenericInstanceId) returns bool
		let name = try self.arrayNamedElementName(ValueTypeTag.genericInstance, nameId: giid as TypeNameId) otherwise return false
		return self.nameIsAnUndeclaredByteElement(name)
	end 'elementIsAByteNoFileDeclares'

	// ⭐ **THE ONE PLACE A RANGED ALIAS'S DECLARED BOUNDS BECOME A STORAGE WIDTH.** A trivial element is
	// stored INLINE, so its slot is as wide as its values need and no wider: a `named` element is a ranged-
	// int alias sized by the width that holds every file's declaration of the name
	// (`RangedAliasRegistry.storageBytesInEveryFile`), and every other trivial tag is its
	// `primitiveTypeByteSize` (`integer`/`float` 8, `boolean` 1, `ExitCode` 4).
	//
	// A trivial element is never a generic instance — every container is a managed box, caught by the
	// `containerElementIsManaged` arm above — so this needs no interner walk past the element's own name.
	// The ONE aggregate it does carry is a declared type that packs inline: its value is the machine word
	// itself, which is exactly what makes `Array with T` a dense 8-byte element column.
	//
	// ⚠ A `named` element that the registry MISSES is not one case but three, and they do not share an answer
	// — `undeclaredNamedElementSlot` is where that split is written down. A payload-free enum takes the slot
	// its tags need; a boxed union keeps the machine word its pointer needs; the byte-string literal's own
	// `Array with Byte` is one byte.
	//
	// ⭐⭐ **IT ANSWERS A SLOT AND NOT A WIDTH, BECAUSE A NARROW SLOT IS TWO FACTS.** `enum-narrow-storage`
	// puts SIGNED values in narrow slots (`i8[] -1, 0, 1` is three bytes), and a reader of such a slot has to
	// sign-extend or it reads `255` for `-1`. Deriving the width here and the signedness somewhere else would
	// be one decision made twice over the same bounds, free to disagree precisely where it matters — so both
	// readers (`arrayElementStamp` for the stamp, `narrowSignedSlotOf` for the read) come through this.
	function trivialElementSlot(t MaxonType) returns StorageSlot
		let tag = maxonTypeTag(t)

		if tagNamesADeclaredType(tag) 'anInlinePackedRecord'
			return StorageSlot.machineWord()
		end 'anInlinePackedRecord'

		if tag != ValueTypeTag.named 'notAName'
			// Every non-`named` trivial tag is an UNSIGNED-or-full-word slot: `bool` (1), `ExitCode` (4, whose
			// domain is `0 to u32.max` at widest), and `integer`/`float`/function at the machine word. None can
			// be negative in a narrow slot, so none extends.
			//
			// ⚠ **AN `ExitCode` ARRAY ELEMENT REACHES THIS ARM ONLY WHEN NOTHING DECLARES THE NAME — and when
			// something does, it is a `named` LEAF and goes below.** E3118's registry doc records the measured
			// consequence of the two answers being read as one: a raw byte at offset 3 of an element compared
			// against an EIGHT-byte slot it does not occupy read back **3741319169**, and `stdlib/Process.maxon`
			// being a listed module is what made the alias registry the single answer. This arm is the tag-only
			// fallback, not the door that sizes a declared `ExitCode`.
			return StorageSlot.create(primitiveTypeByteSize(tag), signExtends: false)
		end 'notAName'

		return self.namedTypeStorageSlot(self.nameOfId(typeNameIdOf(t)))
	end 'trivialElementSlot'

	// ⭐⭐ **THE SLOT A `named` LEAF'S VALUES OCCUPY, KEYED BY NAME — and the NAME is the currency on purpose.**
	// A `MaxonType` carries an interned id, and there are TWO interners: this index's, and the per-FILE table a
	// parser holds. They assign ids in their own insertion orders, so an id crossed between them is right
	// exactly while the two coincide and silently wrong when they drift (`slotTypeThroughReceiver`
	// carries the three measured faces of it). A NAME cannot drift, which is what lets a caller holding a
	// FILE-space type ask this the same way `trivialElementSlot` asks it of an INDEX-space one.
	//
	// ⚠ **MEASURED, and it is exactly the hazard that header describes.** `narrowSignedSlotOf` first took a
	// `MaxonType` and was handed the parser's re-interned element type: `[Offset.behind, …].first()` over a
	// three-case enum at `-200 … 200` answered **65336** in a program with no `typealias Offsets` and `-200`
	// in one with it — the same source, the same slot, two interner orderings.
	export function namedTypeStorageSlot(name ByteArray) returns StorageSlot
		let declaredBytes = try self.settledDeclarations().typeAliases.storageBytesInEveryFile(name) otherwise 'noSuchAlias'
			return self.undeclaredNamedElementSlot(name)
		end 'noSuchAlias'

		// A ranged alias takes the UNSIGNED half of the ladder only — `rangedAliasStorageBytes` carries the two
		// reasons, and both are about that door rather than about the load.
		return StorageSlot.create(declaredBytes, signExtends: false)
	end 'namedTypeStorageSlot'

	// ⭐ **THE STORAGE SLOT OF A `named` ARRAY ELEMENT NO FILE DECLARES AS A RANGED ALIAS** — the MISS arm of
	// `trivialElementSlot`'s registry probe. It is a function and not a bare fallback because a miss means
	// THREE different things, and only one of them is the machine word:
	//
	//   • **`Byte`** — the `Array with Byte` instance a `b"…"` literal MINTS FOR ITSELF
	//     (`internArrayByteInstance`) in a program that declares no such alias or enum. No user type can name that
	//     instance (`Array with Byte` over an undeclared `Byte` does not resolve), so the literal's own record
	//     is the only one there is — and it is stamped byte-PACKED by construction (`ByteStringElementSize`).
	//     Answering the machine word here would leave this door and that record disagreeing about ONE
	//     instance's stride, which is the two-producer shape `arrayElementSize` exists to end.
	//   • **a PAYLOAD-FREE enum or union** — its value is a bare tag, and `enum-narrow-storage` narrows it to
	//     the slot that tag set needs.
	//   • **anything else** — a payload-bearing union, whose value is a heap POINTER or a tagged word
	//     and not a bare tag at all (`specs/array-enum-element-size.md` pins that stride at 8 for
	//     exactly such a union), or a name no declaration binds. `carriesPayloads` is asked and not
	//     assumed: it is the classifier that decides whether the slot holds a tag or an address, and
	//     reading a pointer out of a one-byte slot is not a narrower answer, it is a wrong one.
	// ⚠⚠ **AND A CROSS-KIND CONTESTED NAME CANNOT REACH IT WEARING THE WRONG MEANING, WHICH IS A PROPERTY
	// OF THE FAMILY RATHER THAN OF THIS DOOR.** It has no reading file — an element stride is read off an
	// interned instance, which no file owns — so the question is what can ARRIVE here as a bare `named`.
	// Every other kind is re-tagged before an element is interned: a struct to `structRef`, an interface to
	// `interfaceRef`, a function/generic/tuple alias to its own form (`Parser.parseTypeReference`,
	// `resolveNamedAlias`). That leaves exactly two — a RANGED alias, whose contested spelling
	// `RangedAliasRegistry.settleRangeContests`' `alsoScope` has already scoped per declaring file, and an
	// ENUM/UNION, which can only be contested against an alias and is then the pair's one nominal meaning.
	// So there is no second meaning left for a reader to take. ⛔ If a kind is ever allowed to reach an
	// element slot as a bare `named`, this argument stops holding and the stride becomes a guess.
	function undeclaredNamedElementSlot(name ByteArray) returns StorageSlot
		if self.nameIsAnUndeclaredByteElement(name) 'bytePacked'
			return StorageSlot.create(ByteStringElementSize as ByteOffset, signExtends: false)
		end 'bytePacked'

		// ⚠ Gated on the NON-ALLOCATING `contains` twin: `enumOf` boxes a `DeclaredEnum` even to say
		// `undeclared`, and this door is on `arrayElementSize`'s path —
		// asked for every `named` element in the program, nearly none of which is an enum.
		if not self.containsEnumInAnyFile(name) 'notANominalDeclaration'
			return StorageSlot.machineWord()
		end 'notANominalDeclaration'

		match self.enumInAnyFile(name) 'declaration'
			declared(layout) then return StorageSlot.machineWord() if layout.carriesPayloads() else payloadFreeEnumTagSlot(layout)
			undeclared then panic("undeclaredNamedElementSlot: containsEnum answered yes for '{String.from(name)}' but enumOf answered undeclared — the two read one registry under one key")
		end 'declaration'
	end 'undeclaredNamedElementSlot'

	// ⭐ **THE DESTRUCTOR STAMP ONE CONTAINER COLUMN IS BORN WITH** — the one decider for a body's `create()`
	// (rendered as a value by `Parser.columnDestroyValue`) and for a top-level container global's record
	// (carried to `ModuleInit`, which has no `ProgramSignatures` to ask), so the two records of one instance
	// name one destructor. A column that owes a drop carries the drop callee its teardown walk invokes
	// through a `callIndirect` on each live slot; any other carries 0 and its walk is skipped.
	//
	// ⚠ It asks `typeOwesDrop`, the ownership question, and not `slotTypeIsManaged`: a promise element is
	// not an `__mm` box, so the narrower predicate stamps 0, the walk is skipped, and every un-awaited
	// element's green thread outlives the container unreclaimed.
	//
	// ⚠ It is keyed on the column's TYPE and not on a `(giid, which-column)` pair: a `Map` has TWO of these
	// stamps, and a per-column copy is exactly how the key's and the value's teardown come to disagree about
	// what "managed" means.
	//
	// ⛔ **AN OPAQUE COLUMN HAS NO STAMP HERE — SEE `requireStaticColumnStamp`.**
	export function columnDestroyStamp(columnType MaxonType) returns ContainerCreateStamp
		self.requireStaticColumnStamp(columnType)

		if self.typeOwesDrop(columnType, from: self.typeNames) 'owesDrop'
			return ContainerCreateStamp.dropCallee(self.slotTypeDropCallee(columnType))
		end 'owesDrop'

		return ContainerCreateStamp.inline(TrivialDestructor)
	end 'columnDestroyStamp'

	// ⛔⛔ **THE ONE SENTENCE SAYING AN OPAQUE COLUMN HAS NO STATIC DESTRUCTOR STAMP.** `columnDestroyStamp`, the
	// one place a stamp is produced, ends in an `owes a drop → drop callee` / `otherwise → 0` pair, and **a 0
	// there is not a refusal, it is a leak that compiles**: the teardown walk reads `element_drop@24` (or
	// `element_destroy@40`) and skips a chain whose elements a managed instantiation really does own.
	//
	// ⭐ **AN OPAQUE COLUMN IS SERVED BY A BRANCH AT EACH CALLER, NOT BY A DIFFERENT ANSWER HERE.** An
	// opaque `create` reads `destroyFunc@40` off the enclosing instance's
	// threaded layout descriptor at RUN TIME
	// (`Parser.emitArrayCreateOp`'s `opaqueElement` route and `emitOpaqueChainCreateOp` →
	// `LowerMaxonToStd.appendOpaqueContainerCreate`), so whoever holds an opaque instance takes that
	// road *before* asking for a stamp. This panic is what makes "the caller branched" a checked
	// property of every caller rather than a convention one of them could drift out of — the same
	// discipline `isManagedBufferRecordInstance` states for the seed/emit pair.
	//
	// ⚠ A top-level global's record cannot reach it, for a structural reason worth writing down rather than
	// relying on: a `.data` global is not inside a generic body, so no type parameter is in scope for its
	// element — and `__module_init` carries no layout-descriptor parameter to read one from even if it were.
	// That is precisely why a silent 0 there would have gone unnoticed.
	function requireStaticColumnStamp(columnType MaxonType)
		if self.slotTypeIsOpaque(columnType) 'opaqueColumn'
			panic("ProgramSignatures.columnDestroyStamp: an OPAQUE type-parameter column has no statically known destructor to stamp — its `create` reads `destroyFunc@40` off the enclosing instance's layout descriptor at run time, so this producer's caller must branch on `containerElementIsOpaque` before asking. Stamping 0 here is not a refusal, it is a leak that compiles")
		end 'opaqueColumn'
	end 'requireStaticColumnStamp'

	// ⭐ **DOES THIS BUILTIN CONTAINER HAVE A `create()` AT ALL?** The one home of that question, so the body
	// door and the top-level door refuse the same instances. TWO builtins say no, and they say it for one
	// reason — nothing but another container's own method mints them: a `__ManagedListNode` handle, which only
	// a `__ManagedList` insertion links, and a `__ManagedMemoryCursor`, which only
	// `__ManagedMemory.createCursor()` hands out. Stated as the exceptions they are rather than by enumerating
	// the ones that do.
	//
	// ⛔⛔ **THE CURSOR HALF IS A USER-REACHABLE COMPILER PANIC IF MISSING**: admitting `typealias Cur =
	// __ManagedMemoryCursor with Int` then `Cur.create()` here sends it to
	// `Parser.requireContainerColumnTypes` — which has no cursor arm because a cursor has no columns
	// to gate — and its own *"a container admitted there owes an arm here"* panic. A cursor is *"the
	// SECOND type no source can construct"* (`ManagedMemoryCursorBuiltinBaseName`), and this predicate
	// is the door that has to know it.
	export function instanceHasBuiltinCreate(id GenericInstanceId) returns bool
		return not (self.isManagedListNodeInstance(id) or self.isManagedMemoryCursorInstance(id))
	end 'instanceHasBuiltinCreate'

	// ⭐⭐ **WHOSE CODE BUILDS THIS INSTANCE'S EMPTY RECORD — THE RUNTIME'S, OR THE PROGRAM'S?**
	//
	// ⚠ **IT IS THE COMPLEMENT OF THE BUILTIN ROSTER AND NOT A SECOND ROSTER**, which is what makes it
	// self-maintaining: striking a name from `isBuiltinGenericBaseName` makes this predicate answer true for
	// every instance of it with nothing here edited. A container
	// promoted or demoted moves both answers at once.
	//
	// ⭐⭐ **THE SIZED CONTAINER IS THE ONE NAME THE COMPLEMENT CANNOT ANSWER FOR.**
	// `stdlib/FixedArray.maxon` declares `create()` and `Parser` emits none,
	// so the PROGRAM builds a fixed array's record — yet `FixedArray` is on `isBuiltinGenericBaseName`, because
	// that predicate also decides what `FixedArray with 3 Int` MEANS (`baseStoresArgumentsInline`,
	// `readSizedBaseElementCount`, and the record the compiler synthesizes). The two facts are separate here;
	// taking the name off the roster outright would let this arm evaporate and the complement below answer
	// `FixedArray` correctly on its own.
	//
	// ⛔ **IT MUST NOT BE WIDENED TO "THE CORPUS DECLARES `<base>.create`", WHICH IS THE OBVIOUS SPELLING AND
	// IS WRONG.** `stdlib/Array.maxon` is LISTED and declares `Array.create` too, so that reading would route
	// every `IntArray.create()` — in a body and in `__module_init` alike — to a corpus body while
	// `Parser.emitOwnedContainerCreate` still has an `Array` arm that emits `__managed_create`, which is the
	// growable record's retirement (the `ARR` chain) and not this one. The question is whose CODE builds the
	// record, and for `Array` that is still the compiler's.
	//
	// ⛔⛔ **AND THE ARM IS `declarationIsASizedContainerRecordNamed`, NOT `isFixedArrayInstance`, WHICH WAS
	// MEASURED WRONG.** `isFixedArrayBaseName` is deliberately WIDE — it answers for the container's name AND for
	// this compile's mint of it, because it decides what `FixedArray with 3 Int` MEANS — so under a USER
	// `type FixedArray` it admits the user's declaration, whose base declares no `create` at all. **MEASURED, two
	// suite cases, both a value of type `unknown` rather than a diagnostic**:
	// `array-declared-record.error.a-conformer-named-for-a-container-that-constructs-nothing-…` read
	// *"a member access 'push' on a 'unknown' value"* where it pins the roster refusal, and
	// `generic-types.error.field-read-on-the-second-builtin-base-…` the same one field-side. That is the
	// failure `parseQualifiedCall`'s own container arm records — a container static falling through to a
	// callee no file declares. This predicate is the CORPUS's declaration and no other, which is the question
	// actually being asked: is the body that builds this record one this compile has.
	export function instanceCreateIsDeclared(id GenericInstanceId) returns bool
		if self.declarationIsASizedContainerRecordNamed(self.genericInstanceBaseName(id)) 'theSizedContainersCreateIsTheCorpuss'
			return true
		end 'theSizedContainersCreateIsTheCorpuss'

		return not self.isBuiltinGenericBaseName(self.genericInstanceBaseName(id))
	end 'instanceCreateIsDeclared'

	// ⭐⭐ **THE DECLARATION FILED UNDER `key`** — what a call site reads while its own file is being parsed.
	export function sweptDeclarationOf(key ByteArray) returns SweptDeclaration throws MapError
		return try self.settledDeclarations().sweptDeclarations.get(key)
	end 'sweptDeclarationOf'

	function declarationIsVisibleFrom(key ByteArray, declaration SweptDeclaration, readerFilePath FilePath) returns bool
		return declarationMayBeNamed(self, visibility: declaration.visibility, declFilePath: declaration.declFilePath, registeredName: key, readerFilePath: readerFilePath, callerName: EmptySourceText)
	end 'declarationIsVisibleFrom'

	function templateIsVisibleFrom(key ByteArray, template GenericFunctionTemplate, readerFilePath FilePath) returns bool
		return declarationMayBeNamed(self, visibility: template.visibility, declFilePath: template.declFilePath, registeredName: key, readerFilePath: readerFilePath, callerName: EmptySourceText)
	end 'templateIsVisibleFrom'

	function declaresAFunctionVisibleFrom(key ByteArray, readerFilePath FilePath) returns bool
		let declaration = try self.sweptDeclarationOf(key) otherwise return false
		return self.declarationIsVisibleFrom(key, declaration: declaration, readerFilePath: readerFilePath)
	end 'declaresAFunctionVisibleFrom'

	export function declaresAFreeFunctionVisibleFrom(key ByteArray, readerFilePath FilePath) returns bool
		return self.declaresAFunctionVisibleFrom(key, readerFilePath: readerFilePath) or self.declaresAGenericTemplateVisibleFrom(key, readerFilePath: readerFilePath)
	end 'declaresAFreeFunctionVisibleFrom'

	// Names no caller, so a conformance grant never makes a member visible here; `Parser.declarationNameableBy`
	// is the caller-aware form.
	function visibleDeclarationOf(callee ByteArray, readerFilePath FilePath) returns SweptDeclaration throws MapError
		let declaration = try self.sweptDeclarationOf(callee)

		if not self.declarationIsVisibleFrom(callee, declaration: declaration, readerFilePath: readerFilePath) 'hiddenFromThisReader'
			throw MapError.keyNotFound
		end 'hiddenFromThisReader'

		return declaration
	end 'visibleDeclarationOf'

	// ⭐⭐ **MAY `readerFilePath` NAME `callee`?** The function half of `Visibility`, answered off the sweep's
	// declarations and generic templates, which exist before `FunctionNameIndex` — what
	// `SemanticCheck.calleeVisibleFrom` reads for a call in a BODY. The rule the tiers are fed to is the one
	// `isVisibleFrom` already owns, so the two askers can disagree about no declaration they both see.
	//
	// A callee no file declares is VISIBLE: "there is no such function" is a different mistake, and the
	// caller reports it with its own sentence.
	//
	// The refusing TIER rides back with the verdict because the diagnostic is worded by it, and asking for it
	// separately would be a second lookup of the same key that could answer about a different declaration if
	// anything refiled the name in between.
	export function calleeVisibilityFrom(callee ByteArray, readerFilePath FilePath) returns SymbolVisibility
		let declaration = try self.sweptDeclarationOf(callee) otherwise return self.templateCalleeVisibilityFrom(callee, readerFilePath: readerFilePath)

		if self.declaresAFreeFunctionVisibleFrom(callee, readerFilePath: readerFilePath) 'someDeclarationIsNameable'
			return SymbolVisibility.visible
		end 'someDeclarationIsNameable'

		return SymbolVisibility.hidden(declaration.visibility)
	end 'calleeVisibilityFrom'

	function templateCalleeVisibilityFrom(callee ByteArray, readerFilePath FilePath) returns SymbolVisibility
		let templates = self.genericTemplatesOf(callee)

		if templates.count() == 0 'aRegisteredMemberName'
			let site = try self.settledDeclarations().funcDeclSites.get(callee) otherwise return SymbolVisibility.visible
			return self.symbolVisibility(site.visibility, declFilePath: site.declFilePath, readerFilePath: readerFilePath)
		end 'aRegisteredMemberName'

		if self.declaresAFreeFunctionVisibleFrom(callee, readerFilePath: readerFilePath) 'someTemplateIsNameable'
			return SymbolVisibility.visible
		end 'someTemplateIsNameable'

		let firstTemplate = try templates.get(0) otherwise panic("templateCalleeVisibilityFrom: '{String.from(callee)}' has no template, which the count test above ruled out")
		return SymbolVisibility.hidden(firstTemplate.visibility)
	end 'templateCalleeVisibilityFrom'

	// How a diagnostic spells a callee it has resolved: the name the source wrote, qualified by its
	// module namespace — `stdlib.Expect.equal`, never `Expect.equal` and never a contested function's
	// registration key.
	// `specs/testing-assertions.md`'s two `error.forgotten-try` cases pin both halves.
	//
	// Every declaration is qualified by its path relative to the compile root, so this is not a stdlib
	// special case. Registration names stay bare, because namespace-qualifying them is a resolution
	// decision taken only under contest, so the qualification is applied here, at the render. A callee
	// no file declares, and a root-level declaration, come back without a namespace.
	//
	// Every asker speaks about a declaration the compiler resolved — E3057 once
	// `throwsMap.contains(callee)` has proven the name, the signature-visibility check and the
	// unused-export audit — and that is the line: qualify a resolved declaration, never a name it
	// could not resolve. Applied at `SemanticCheck.callDiagnosticNoun`, the door every call diagnostic
	// shares, it would also qualify a name that resolved to nothing and name a symbol absent from the
	// program. E3055, E3008 and E3036 also speak about a resolved declaration but keep the bare
	// spelling; qualifying them moves ~50 pinned expectations across a dozen spec files.
	//
	// A callee is spelled through its declaration site; E3057 names the declaration it bound through that
	// declaration's own file (`diagnosticMemberSpelling`, from `SemanticCheck.boundCalleeSpelling`).
	export function diagnosticCalleeSpelling(callee ByteArray) returns immutable ByteArray
		let written = genericTemplateName(callee)
		let site = try self.declarationSiteOf(callee) otherwise return written
		return self.diagnosticMemberSpelling(callee, declFilePath: site.declFilePath)
	end 'diagnosticCalleeSpelling'

	export function diagnosticMemberSpelling(callee ByteArray, declFilePath FilePath) returns immutable ByteArray
		return self.diagnosticNameInFile(genericTemplateName(callee), declFilePath: declFilePath)
	end 'diagnosticMemberSpelling'

	export function diagnosticNameInFile(name ByteArray, declFilePath FilePath) returns immutable ByteArray
		let namespace = self.namespaceOf(declFilePath)

		if namespace.isEmpty() 'aRootLevelDeclaration'
			return name
		end 'aRootLevelDeclaration'

		return namespaceQualifiedName(namespace, name: name)
	end 'diagnosticNameInFile'

	// The element CLONE strategy for a managed-element container instance — the DUAL of
	// `slotTypeDropCallee`. The front end stamps `funcAddr(<the direct callee>)` into the `_managed`
	// array-copy call, exactly as it stamps `funcAddr(<the drop callee>)` into `element_destroy@40`. Routed
	// through the SAME `managedFieldCascadeStrategy` a managed FIELD of the element's type uses, so the element's
	// clone matches its own field-clone by construction. Precondition: `sourceCloneVerdictOfType`, which
	// guarantees the result is `direct` (an element cloner is invoked through `callIndirect`, a `(box) -> box`
	// shape a `managedElements`/`unsupported` strategy cannot satisfy).
	//
	// ⚠ **IT SERVES THE CHAIN TOO AND SO DOES NOT WEAR THE `Array` NAME** — `containerElementType`'s
	// own argument, one door along: the question is about a container's ELEMENT, not about what holds it, and a
	// `List with String`'s per-element cloner is resolved by exactly this call. A second `listElementCloneStrategy`
	// would be this header copied out with one word changed.
	export function containerElementCascadeStrategy(id GenericInstanceId, action CascadeAction) returns ManagedCascadeStrategy
		if action == CascadeAction.clone and self.containerElementIsFrozen(id) and frozenRecordIsSharedNotCopied(self, typeNames: self.typeNames, type: self.containerElementType(id)) 'immutableDataIsShared'
			return ManagedCascadeStrategy.direct(MmRetainName)
		end 'immutableDataIsShared'

		return managedFieldCascadeStrategy(self, typeNames: self.typeNames, fieldType: self.containerElementType(id), asElement: true, action: action)
	end 'containerElementCascadeStrategy'

	// ⭐ **IS THIS INSTANCE AN ELEMENT-BEARING RECORD THIS COMPILER OWNS** — the managed buffer (an `Array` or a
	// `FixedArray`) or the chain, whose copy and drop are a runtime WALK rather than a field cascade, and which
	// therefore have no base layout for the declared-instance walks to read. The negation is load-bearing:
	// `instanceGraphSupportsDeepClone` routes everything ELSE to the field walk, which refuses a layout-less
	// instance.
	export function isElementBearingRecordInstance(id GenericInstanceId) returns bool
		return self.isManagedBufferRecordInstance(id) or self.isManagedListInstance(id)
	end 'isElementBearingRecordInstance'

	// ⭐ **IS THIS INSTANCE A MANAGED-ELEMENT RECORD — the shape whose element cloner is the
	// one-argument THUNK?** One of those two records over an element that itself owns heap. Asked by
	// the two RUNTIME sides — the needs closure (`MmRuntime.noteInstanceCascadeNeeds`) and the
	// installer (`MmRuntime.installGenericInstanceCascades`) — off the SAME predicates the gate and
	// the strategy split on, so the gate, the strategy and the synthesis cannot come to disagree about
	// which instances have a thunk to build.
	export function isManagedElementRecordInstance(id GenericInstanceId) returns bool
		return self.isElementBearingRecordInstance(id) and self.containerElementIsManaged(id)
	end 'isManagedElementRecordInstance'

	// The FIELD-position copy of a managed-element record — the 2-argument
	// `<containerClone>(box, funcAddr(elementClone))` that IS the one-argument thunk's whole body. Asked by the
	// needs closure (`MmRuntime.noteInstanceCascadeNeeds`) and by the synthesis
	// (`MmRuntime.synthesizeElementRecordCloner`), so what the closure roots and what the body calls are ONE
	// answer rather than two derivations of it. Precondition: `isManagedElementRecordInstance`.
	export function elementRecordFieldCascadeStrategy(id GenericInstanceId, action CascadeAction) returns ManagedCascadeStrategy
		return instanceCascadeStrategy(self, id: id, asElement: false, action: action)
	end 'elementRecordFieldCascadeStrategy'

	// ⭐ **THE `<Base> with integer` INSTANCE FOR AN INFERRED-INT LITERAL CONSTRUCTION.** A bare `[…]` int-array
	// literal (`baseName` = `Array`) and a `Set from [ints]` construction (`baseName` = `Set`) both
	// infer their `integer` element from the literal, so neither has a typealias to intern its
	// instance from. The SWEEP interns the one well-known instance for its base whenever a file's
	// tokens contain the construct (`Parser.foldDeclaredSignaturesInto`: a `[` for the array, a `Set
	// from` for the set), and the parser reads the same giid back at construction time. Interning is
	// IDEMPOTENT — `TypeNameInterner.intern` and `GenericInstanceRegistry.intern` both return the
	// existing entry without mutating when present — so the sweep's call is the WRITE and every parser
	// call is a pure READ (the instance is always interned before any file is parsed, which keeps a
	// per-file parse from being the first to mutate the shared registry). This is the integer-element
	// instance only; a literal of any other element reaches its own instance through
	// `builtinInstanceForElement`. The `integer` element canonicalizes to the `int` conformer
	// (`conformerTypeArgName`), so the witnesses are `__witness_int.*`. It is deliberately NOT folded
	// into the content hash: a file gaining the construct re-parses on its OWN bytes, and no OTHER
	// file's meaning depends on this shared, deterministic instance.
	export function internBuiltinIntegerInstance(baseName ByteArray) returns GenericInstanceId
		return self.internRow(self.typeNames.intern(baseName), args: singletonInteger())
	end 'internBuiltinIntegerInstance'

	// ⭐ **THE `Array with Byte` INSTANCE FOR A `b"…"` BYTE-STRING LITERAL.** A byte-string
	// literal has no typealias to intern from (`b"hi"` names no type), so — like the `[…]` int-array literal
	// above — the SWEEP interns this ONE well-known instance whenever a file's tokens contain a byte-string
	// literal (`Parser.foldDeclaredSignaturesInto`), and the parser reads the giid back at literal time.
	// Interning is IDEMPOTENT, so the sweep is the WRITE and every parser call a pure READ. The element is
	// `named("Byte")` — the SAME reference a user `typealias ByteArray = Array with Byte` interns, so a
	// byte-string and a `ByteArray`-typed value share one gid and are type-identical.
	// ⚠ MEMOIZED — see `arrayByteInstance` for why the answer is stable and why the flag is a flag rather
	// than a sentinel. The first ask is still the WRITE that mints the instance, so the registry contents
	// (and every id derived from them) are exactly what they were before the memo existed.
	// ⚠⚠ **AND IT IS SCOPED TO THE READER, WHICH IS WHAT KEEPS E2015 HONEST.** `Byte` is a name a USER
	// program may declare, so "the `Array with Byte` instance" is not one thing in a program whose
	// declarations of `Byte` disagree about the range: `stdlib/File.maxon`'s byte buffer must stride 1 while
	// the reader that declared `int(0 to 1000)` must still meet the wall its own declaration builds. Pointing
	// this at a stride-1 compiler byte instead would make `Parser.requireByteStringBlobFitsItsElement`'s
	// stride clause — which reads this function's answer through `arrayElementSize`, one call away — see 1 in
	// every program, and `bytearray-element-size.md`'s two wide-`Byte` refusals would go green by losing their
	// premise rather than by being fixed. **Its BOUNDS clause rides the same instance and would lose the
	// same premise**, since `arrayElementAliasOf` reads the element off exactly this id. The environment is
	// the file of the author's integer alias the reader's bare `Byte` names; a nominal `Byte`, a non-integer
	// one and the library's own leave the literal on the library's element.
	export function internArrayByteInstance(readerFilePath FilePath) returns GenericInstanceId
		return self.fileScopedInstance(self.bareArrayByteInstance(), filePath: self.byteElementEnvironmentOf(readerFilePath))
	end 'internArrayByteInstance'

	function byteElementEnvironmentOf(readerFilePath FilePath) returns FilePath
		if self.writtenNameIsContestedAcrossKinds(ByteElementTypeName) and not self.writtenNameMeansARangedAliasHere(ByteElementTypeName, readerFilePath: readerFilePath) 'theReaderMeansANominal'
			return CompilerOwnedDeclFilePath
		end 'theReaderMeansANominal'

		match self.aliasOf(ByteElementTypeName, readerFilePath: readerFilePath) 'whatByteMeans'
			declared(alias) then return self.environmentOfByteAlias(alias)
			undeclared then return CompilerOwnedDeclFilePath
		end 'whatByteMeans'
	end 'byteElementEnvironmentOf'

	function environmentOfByteAlias(alias RangedTypeAlias) returns FilePath
		if maxonTypeTag(alias.underlying) != ValueTypeTag.integer or self.declaredByTheCorpus(alias.declFilePath) 'theLibrarysByteStands'
			return CompilerOwnedDeclFilePath
		end 'theLibrarysByteStands'

		return alias.declFilePath
	end 'environmentOfByteAlias'

	// The UNSCOPED instance the scoped answers above are all derived from — what the declaration SWEEP mints,
	// and the only form it can mint: the sweep is what DECIDES the contest, so it runs before there is a
	// reader's answer to give. Its two callers are the sweep's own registrations
	// (`Parser.foldDeclaredSignaturesInto`, `registerManagedFileType`/`registerManagedDirectoryType`); every
	// reader goes through `internArrayByteInstance` and gets its own file's.
	export function bareArrayByteInstance() returns GenericInstanceId
		if self.arrayByteInstanceComputed 'alreadyMinted'
			return self.arrayByteInstance
		end 'alreadyMinted'

		let args = MaxonTypeArray.create(1, zeroed: false)
		args.push(MaxonType.named(self.typeNames.intern(self.aliasFamilyIdentity(ByteElementTypeName))))
		self.arrayByteInstance = self.internRow(self.typeNames.intern(self.arrayRecordBaseName()), args: args)
		self.arrayByteInstanceComputed = true
		return self.arrayByteInstance
	end 'bareArrayByteInstance'

	// ⭐⭐ **DOES ANY NAME IN THIS PROGRAM HAVE DECLARATIONS THAT DISAGREE — ABOUT A RANGE, ABOUT A FUNCTION
	// SHAPE, ABOUT AN INSTANCE *OR* ABOUT A TUPLE?** Written ONCE: two spellings of one predicate is this
	// project's signature bug, and a door taught about a contest the other spelling does not know about is a
	// wrong answer with no compile error at either. ⚠ **THE NEXT CONTEST GOES HERE AND NOWHERE ELSE.**
	// `anythingNeedsScoping`, which `settleRangeScopedInstances` and `rekeyScopedGenericAliases` short-circuit
	// on, adds the generic aliases whose instances carry a name `argMayNeedScoping` rescopes.
	function anythingContested() returns bool
		return self.anyElementScopingContest() or self.anyGenericAliasNameContested() or self.anyTupleAliasNameContested()
	end 'anythingContested'

	function anyElementScopingContest() returns bool
		return self.settledDeclarations().typeAliases.anyRangeContest() or self.settledDeclarations().functionTypeAliases.anyShapeContest()
	end 'anyElementScopingContest'

	function scopedInstanceEnvironments() returns FilePathArray
		let environments = self.settledDeclarations().typeAliases.rangeContestEnvironments()

		for environment in self.settledDeclarations().functionTypeAliases.shapeContestEnvironments() 'eachShapeContestFile'
			environments.push(environment)
		end 'eachShapeContestFile'

		if environments.count() == 0 'onlyReaderIndependentNamesNeedScoping'
			environments.push(CompilerOwnedDeclFilePath)
		end 'onlyReaderIndependentNamesNeedScoping'

		return environments
	end 'scopedInstanceEnvironments'

	// ⭐⭐ **THE SAME INSTANCE, WITH EVERY CONTESTED NAME IN IT SPELLED THE WAY `filePath` MEANS IT**
	// — the ONE place a generic instance becomes a particular file's instance, so no door grows a qualifier
	// step of its own. `mangleGenericInstance` and `canonicalInstanceName` are structural over the args, so
	// both inherit the qualified spelling for free and neither learns anything about contests.
	//
	// ⭐⭐ **ONE WALK FOR EVERY CONTEST.** The leaves differ — a range- or declaration-contested ELEMENT, a
	// shape-contested function alias, an instance-contested GENERIC ALIAS, a TUPLE alias, a
	// directory-qualified name — and everything else is shared: which tags recurse,
	// which pass through, the re-intern, the "return `id` untouched" contract. Two copies of a RECURSION is
	// the shape where, the day a tag other than `genericInstance` starts carrying a nested instance, whoever
	// teaches one walk about it has no reason to look at the other — and the failure is a wrong instance
	// rather than a compile error.
	//
	// ⚠ **IT IS A PURE READ BY THE TIME A PARSE ASKS IT**, and that is a property `settleRangeScopedInstances`
	// and `settleGenericAliasContest` buy rather than one this function has: `intern` returns an existing id
	// without mutating, so every pair being pre-interned is what keeps a per-file parse from writing the
	// shared registry. The rescope is also IDEMPOTENT — a minted name is never itself contested, having
	// exactly one declaration by construction — so asking it of an already-scoped instance answers with the
	// same id and interns nothing.
	//
	// ⚠ **THE PARAMETER IS `filePath` AND NOT `readerFilePath`**, deliberately: at a parse it is the READER's,
	// at the settle it is the file that WROTE the declaration, and a parameter name true at some call sites
	// and false at others is the contract `declaredSlotType`'s header refuses for the same reason.
	//
	// ⛔⛔ **IT RE-INTERNS AN EXISTING INSTANCE, SO IT MUST CARRY EVERY PART OF THAT INSTANCE'S IDENTITY —
	// INCLUDING THE `shape`.** `intern`'s key is `(baseId, args, shape)`; this is the ONLY
	// call site that rebuilds one from an instance it already holds rather than from a declaration, so it is
	// the only one that can lose a component by simply not mentioning it — and `shape` DEFAULTS to
	// `unsized`, which is silent: a `FixedArray with 8 W` whose `W` two files disagree about would come back
	// SIZELESS, and `create()` would build a zero-length fixed array. `specs/typealias-file-scope.md`'s
	// `a-sized-fixed-array-keeps-its-element-count-when-its-element-is-contested` is the case.
	// ⚠ An `Array` case catches it only when it spells an `immutable` argument; on any other instance of a base
	// but `FixedArray` the omission is exactly a no-op.
	export function fileScopedInstance(id GenericInstanceId, filePath FilePath) returns GenericInstanceId
		if not self.argsMayNeedScoping(self.rowArgs(id)) 'nothingToScope'
			return id
		end 'nothingToScope'

		let scoped = self.scopedInstanceOver(id, filePath: filePath)

		if self.rowEscapesBaseline(id, scoped: scoped) 'aParseWroteTheSharedRegistry'
			panic("ProgramSignatures.fileScopedInstance: baseline instance {id} rescoped for '{filePath.toString()}' to instance {scoped}, a row only this parse holds — `settleRangeScopedInstances` interns every (instance, environment) pair, so a parse's rescope of a baseline instance is a lookup")
		end 'aParseWroteTheSharedRegistry'

		return scoped
	end 'fileScopedInstance'

	function scopedInstanceOver(id GenericInstanceId, filePath FilePath) returns GenericInstanceId
		return self.internRow(self.rowBaseId(id), args: self.fileScopedArgs(self.rowArgs(id), filePath: filePath), shape: self.rowShape(id))
	end 'scopedInstanceOver'

	function argsMayNeedScoping(args MaxonTypeArray) returns bool
		for arg in args 'eachArg'
			if self.argMayNeedScoping(arg) 'thisArgNeedsScoping'
				return true
			end 'thisArgNeedsScoping'
		end 'eachArg'

		return false
	end 'argsMayNeedScoping'

	function argMayNeedScoping(arg MaxonType) returns bool
		let tag = maxonTypeTag(arg)

		if tag == ValueTypeTag.genericInstance 'nested'
			return self.argsMayNeedScoping(self.rowArgs(genericInstanceIdOf(arg)))
		end 'nested'

		if tagNamesADeclaredType(tag) 'aRecord'
			let recordName = self.nameOfId(typeNameIdOf(arg))
			return isTupleTypeName(recordName) and not self.canonicalNameOfStruct(recordName).equals(recordName)
		end 'aRecord'

		if tag != ValueTypeTag.named 'carriesNoName'
			return false
		end 'carriesNoName'

		let name = self.nameOfId(typeNameIdOf(arg))
		let spelled = sourceSpelledAliasName(name)
		return containsQualifier(name) or self.settledDeclarations().typeAliases.namesAContestedRange(spelled) or self.settledDeclarations().functionTypeAliases.namesAContestedShape(spelled) or self.genericAliasSpellingIsSuperseded(spelled) or self.isTupleAliasInAnyFile(name)
	end 'argMayNeedScoping'

	function anyGenericAliasNeedsScoping() returns bool
		let declared = self.settledDeclarations().genericAliasDecls

		for entry in declared 'eachDeclaration'
			if self.argsMayNeedScoping(self.rowArgs(entry.internedInstance())) 'itsInstanceNeedsScoping'
				return true
			end 'itsInstanceNeedsScoping'
		end 'eachDeclaration'

		return false
	end 'anyGenericAliasNeedsScoping'

	function anythingNeedsScoping() returns bool
		return self.anythingContested() or self.anyGenericAliasNeedsScoping()
	end 'anythingNeedsScoping'

	function fileScopedArgs(args MaxonTypeArray, filePath FilePath) returns MaxonTypeArray
		let scoped = MaxonTypeArray.create(args.count(), zeroed: false)

		for arg in args 'eachArg'
			scoped.push(self.fileScopedArg(arg, filePath: filePath))
		end 'eachArg'

		return scoped
	end 'fileScopedArgs'

	// One type argument, scoped. A NESTED instance recurses — `Array with (Array with Byte)`'s inner element
	// belongs to the same file the outer one does — and every other tag passes through: only a `named` leaf
	// can name an alias at all (a struct, a tuple and an opaque type parameter carry no range and no instance,
	// and a primitive carries no name).
	function fileScopedArg(arg MaxonType, filePath FilePath) returns MaxonType
		let tag = maxonTypeTag(arg)

		if tag == ValueTypeTag.genericInstance 'nested'
			return MaxonType.genericInstance(self.scopedInstanceOver(genericInstanceIdOf(arg), filePath: filePath))
		end 'nested'

		if tagNamesADeclaredType(tag) 'aRecord'
			return self.canonicalTupleStructRef(arg)
		end 'aRecord'

		if tag != ValueTypeTag.named 'carriesNoAliasName'
			return arg
		end 'carriesNoAliasName'

		if let contestScoped = try self.contestScopedDeclaredType(arg, slotScopeFilePath: filePath) 'namesAContestedGenericAlias'
			return contestScoped
		end 'namesAContestedGenericAlias'

		let name = self.nameOfId(typeNameIdOf(arg))

		// ⭐ A TUPLE alias is resolved HERE rather than left as a `named` for a read door to repair: a generic
		// instance's type argument is interned ONCE and no later pass re-tags it, so two files that each write
		// `typealias XBox = Box with Pair` above their own `typealias Pair` would intern ONE instance carrying
		// a spelling that denotes neither file's tuple, and both files would be refused.
		if self.isAliasOfFormFor(name, readerFilePath: filePath, wanted: FormAliasKind.tuple) 'namesATupleAlias'
			return self.tupleAliasDenotedType(name, readerFilePath: filePath, into: self.typeNames)
		end 'namesATupleAlias'

		// ⚠ **A CROSS-KIND CONTESTED NAME IS SCOPED ONLY FOR A READER THAT MEANS THE ALIAS BY IT.** The
		// scoped spelling names one ranged DECLARATION, so handing it to a file whose own `type FullRangeInt`
		// is what it wrote would turn that file's array of STRUCTS into an array of integers — the very
		// wrong answer this scoping exists to stop, pointed the other way. A file that means the nominal
		// declaration keeps the bare name, which the reader-free cascade resolves to that declaration
		// (`declaredFormInAnyFile`, whose struct arm is first). Transparent to a pure RANGE contest, where
		// every declaration of the name is an alias and this always answers true.
		let scoped = self.rangeScopedDeclaredName(name, readerFilePath: filePath)

		if scoped.equals(name) 'thisFileNamesTheBareDeclaration'
			return arg
		end 'thisFileNamesTheBareDeclaration'

		return MaxonType.named(self.typeNames.intern(scoped))
	end 'fileScopedArg'

	function identityStandsForEveryReader(spelling ByteArray, identity ByteArray) returns bool
		return not containsQualifier(spelling) or isMintName(identity) or isAliasFamilyMint(identity) or self.nameIsDeclaredOnce(identity)
	end 'identityStandsForEveryReader'

	function nameIsDeclaredOnce(name ByteArray) returns bool
		var authors = 0 as Count
		let claims = self.typeNameClaimsOf(name)

		for claim in claims 'eachClaim'
			if not claim.declaredByTheCorpus 'anAuthorsDeclaration'
				authors = authors + 1
			end 'anAuthorsDeclaration'
		end 'eachClaim'

		return authors == 1 or (authors == 0 and claims.count() == 1)
	end 'nameIsDeclaredOnce'

	export function rangeScopedDeclaredName(name immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if self.settledDeclarations().typeAliases.nameTakesAnIdentity(name) 'everyDeclarationIsItsOwnElement'
			return self.rangedIdentityOrKey(name, declFilePath: readerFilePath)
		end 'everyDeclarationIsItsOwnElement'

		if not self.readerMeansKind(name, readerFilePath: readerFilePath, kind: TypeDeclKind.rangedAlias) 'thisFileMeansSomethingElseByTheName'
			return name
		end 'thisFileMeansSomethingElseByTheName'

		return self.settledDeclarations().typeAliases.rangeScopedName(name, readerFilePath: readerFilePath)
	end 'rangeScopedDeclaredName'

	function resolveGenericAliasBases()
		var resolvedAny = false

		for index in 0 upto self.settledDeclarations().genericAliasDecls.count() 'eachDeclaration'
			let entry = try self.mainThreadSettled().genericAliasDecls.get(index) otherwise panic("ProgramSignatures.resolveGenericAliasBases: genericAliasDecls.get OOB at {index} inside its own `upto` bound")
			let swept = entry.internedInstance()
			let meant = self.baseResolvedInstance(swept, filePath: entry.filePath)

			if meant == swept 'theBaseIsTheOneDeclared'
				continue
			end 'theBaseIsTheOneDeclared'

			try self.mainThreadSettled().genericAliasDecls.set(index, value: entry.recorded(meant)) otherwise panic("ProgramSignatures.resolveGenericAliasBases: genericAliasDecls.set OOB at {index} inside its own `upto` bound")
			resolvedAny = true
		end 'eachDeclaration'

		if not resolvedAny 'noBaseWasMeantDifferently'
			return
		end 'noBaseWasMeantDifferently'

		for entry in self.mainThreadSettled().genericAliasDecls 'eachRecordedDeclaration'
			self.mainThreadSettled().genericAliases.upsert(entry.aliasName, value: entry.internedInstance())
		end 'eachRecordedDeclaration'

		let sites = self.mainThreadSettled().genericAliasSites
		let meantSites = GenericInstantiationSiteArray.create(sites.count(), zeroed: false)

		for site in sites 'eachSite'
			meantSites.push(GenericInstantiationSite.create(self.baseResolvedInstance(site.gid, filePath: site.filePath), nameLine: site.nameLine, nameColumn: site.nameColumn, filePath: site.filePath))
		end 'eachSite'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.genericAliasSites = meantSites
	end 'resolveGenericAliasBases'

	function baseResolvedInstance(id GenericInstanceId, filePath FilePath) returns GenericInstanceId
		let baseId = self.rowBaseId(id)
		let meantBase = self.resolvedBaseId(baseId, filePath: filePath)
		let args = self.rowArgs(id)
		let meantArgs = MaxonTypeArray.create(0)
		var rebuilt = meantBase != baseId

		for position in 0 upto args.count() 'eachArg'
			var arg = try args.get(position) otherwise panic("ProgramSignatures.baseResolvedInstance: args.get OOB at {position} inside its own `upto` bound")

			if maxonTypeTag(arg) == ValueTypeTag.genericInstance 'aNestedInstance'
				let nested = genericInstanceIdOf(arg)
				let meantNested = self.baseResolvedInstance(nested, filePath: filePath)

				if meantNested != nested and not rebuilt 'theFirstChange'
					for earlier in 0 upto position 'eachEarlierArg'
						meantArgs.push(try args.get(earlier) otherwise panic("ProgramSignatures.baseResolvedInstance: args.get OOB at {earlier} below position {position}"))
					end 'eachEarlierArg'

					rebuilt = true
				end 'theFirstChange'

				arg = MaxonType.genericInstance(meantNested)
			end 'aNestedInstance'

			if rebuilt 'collectingTheMeantArgs'
				meantArgs.push(arg)
			end 'collectingTheMeantArgs'
		end 'eachArg'

		if not rebuilt 'everyBaseIsTheOneDeclared'
			return id
		end 'everyBaseIsTheOneDeclared'

		return self.internRow(meantBase, args: meantArgs, shape: self.rowShape(id))
	end 'baseResolvedInstance'

	function resolvedBaseId(baseId TypeNameId, filePath FilePath) returns TypeNameId
		let written = self.nameOfId(baseId)

		if containsQualifier(written) 'aDirectoryQualifiedBase'
			match lookupQualifiedType(self, written: written, readerFilePath: filePath) 'declaration'
				found(declaration) then return baseId if isTypeAliasDecl(declaration.kind) else self.typeNames.intern(declaration.name)
				ambiguous or
				missing then return baseId
			end 'declaration'
		end 'aDirectoryQualifiedBase'

		if self.writtenNameMeansAnAliasHere(written, readerFilePath: filePath) 'anAliasIsMeantNotAGenericType'
			return self.typeNames.intern(aliasFamilyMint(written))
		end 'anAliasIsMeantNotAGenericType'

		return baseId
	end 'resolvedBaseId'

	// ⭐⭐ **SETTLE THE RANGE CONTEST, RE-KEY EVERY DECLARED ALIAS TO ITS OWN FILE'S INSTANCE, AND INTERN
	// EVERY SCOPED VARIANT A PARSE COULD ASK FOR** — one pass, at the one moment the whole program is
	// known and nothing has read an instance yet.
	//
	// **THE THREE STEPS ARE THREE DIFFERENT PROBLEMS, AND ONLY THE FIRST IS A REGISTRY QUESTION:**
	//
	//   1. **The CONTEST** (`settleRangeContests`) — which names take a per-declaration identity or have
	//      declarations that disagree about the range, and the mint each gets. Everything below reads its
	//      answer.
	//   2. **THE ORDERING HAZARD** — `recordGenericAlias` runs DURING the sweep, so `typealias ByteArray =
	//      Array with Byte` was interned with the BARE element before any contest could be known. Repairing
	//      that is `rekeyScopedGenericAliases`', which runs after BOTH contests are settled because it
	//      applies both scopings; see there.
	//   3. **The PARSE MUST NOT WRITE.** Every (instance, reader environment) pair is interned here, so
	//      `fileScopedInstance` is a pure lookup from every parallel per-file parse.
	export function settleRangeScopedInstances()
		self.resolveGenericAliasBases()
		self.mainThreadSettled().typeAliases.settleRangeContests(self.crossKindScopedAliasNames())
		self.rangeContestsSettled = true

		if not self.anythingNeedsScoping() 'nothingInThisProgramNeedsScoping'
			return
		end 'nothingInThisProgramNeedsScoping'

		let swept = self.rowCount()
		let scopable = GenericInstanceIdArray.create(0)

		for id in 0 upto swept 'eachSweptInstance'
			if self.argsMayNeedScoping(self.rowArgs(id)) 'someArgMayBeScoped'
				scopable.push(id)
			end 'someArgMayBeScoped'
		end 'eachSweptInstance'

		for environment in self.scopedInstanceEnvironments() 'eachEnvironment'
			for id in scopable 'eachScopableInstance'
				_ = self.fileScopedInstance(id, filePath: environment)
			end 'eachScopableInstance'
		end 'eachEnvironment'
	end 'settleRangeScopedInstances'

	// ⭐⭐ **WHICH GENERIC-ALIAS NAMES DO TWO FILES DISAGREE ABOUT, AND WHAT DOES EACH FILE MEAN BY ONE?**
	// — one pass, at the one moment every declaration is in and no file has been parsed.
	//
	// **IT SETTLES THREE THINGS, AND THE THIRD IS THE ONE A SCOPED LOOKUP DOES NOT BUY:**
	//
	//   1. **The CONTEST** — `contestedGenericAliases`, the by-declaring-file index the parser's scoped read
	//      probes (`scopedGenericAliasInstance`). Which declaration a file that declares none of the name
	//      means is decided per read, by `scopedGenericAliasDecl`, not settled here.
	//   2. **THE MINT.** Each distinct instance of a contested name is registered under
	//      `instanceQualifiedAliasName` as an entry of its own, so a name that unambiguously denotes ONE of
	//      the declarations exists at all. It is NOT a second identity: `genericAliases` maps it to exactly
	//      the instance the source name resolves to in its declaring file, and the mangled symbol comes from
	//      the instance, so nothing minted here reaches emitted code.
	//   3. **THE RECORDED DECLARED TYPES** — `resolveRecordedGenericAliasTypes`. This is the half without
	//      which step 1 would be a REGRESSION rather than a fix; see there.
	//
	// ⚠ **IT RUNS AFTER `settleRangeScopedInstances` AND THE ORDER IS LOAD-BEARING.** The contest is decided
	// on the instance each declaration means IN ITS OWN FILE, and for an element two files declare over two
	// ranges that instance is the range-scoped one — so a `Bytes` whose `Byte` differs is contested
	// here precisely because the range settle already split the element. Reversed, every such pair
	// would look like one instance and nothing would be scoped.
	//
	// ⚠⚠ **IT IS A FIXPOINT, AND THE SECOND ROUND IS NOT HYPOTHETICAL — IT WAS A COMPILER PANIC.** An alias's
	// ARGUMENT may itself name a contested alias (`typealias Grid = Array with Slots`), and a nested `named`
	// argument is exactly the spelling the sweep leaves behind. Both files' `Grid` therefore interned to ONE
	// instance — `Array with named("Slots")` — so round one saw `Grid` AGREE while its element denoted two
	// different arrays, and `slotTypeDropCallee` takes that element straight into
	// `genericAliasInstance`'s refusal. Rescoping the arguments splits `Grid` in two, which makes `Grid`
	// contested, which can split a `Array with Grid` above it — so the walk repeats until a round contests
	// nothing new. It terminates because a name only ever moves from agreeing to contested and there are
	// finitely many of them; the counter below is a bound on that argument, not a heuristic.
	//
	// ⚠ **ON EVERY PROGRAM IN THE CORPUS THE FIXPOINT DOES NOT RUN AT ALL** — no generic-alias name is
	// mentioned by two declarations, so nothing can disagree, nothing is minted, and the contest indexes stay
	// the shared empties. That is not an optimization; it is the proof that nothing here can move an interned
	// instance or a symbol, and it is measured: with the gate, the contest costs the ladder NOTHING.
	// (Without it, the round's own first pass cost one map plus an entry per generic-alias NAME — +40
	// allocations at rung 0 rising to +452 at rung 5, for a question whose answer is "none".)
	// ⛔ **THE GATE WRAPS THE FIXPOINT AND NOT THE WHOLE FUNCTION.** `rekeyScopedGenericAliases` below
	// is the ONE place a declared alias is re-keyed to its declaring file's instance, for RANGES and
	// for ARGUMENTS both — so an early return in front of it on the GENERIC contest alone skips the
	// RANGE re-key too, and `bytearray-element-size/a-byte-two-files-disagree-about-is-two-types` (a
	// full-suite case) stops refusing.
	export function settleGenericAliasContest()
		if self.anyAliasNameIsDisagreedWith() 'someNameHasASECONDDeclarationToDisagreeWith'
			var rounds = 0 as GenericAliasRoundCount

			while self.settleGenericAliasContestRound() 'aRoundFoundANewContest'
				rounds = rounds + 1

				// ⛔ **THE DECLARATION GRAPH CYCLES — STOP AND RECORD IT, NEVER ABORT.** A round can only deepen
				// an argument that was still bare, so an ACYCLIC graph cannot outlast its own nesting depth and
				// that depth cannot exceed the declaration count. Past it, the walk is chasing a cycle and the
				// program is owed E3091; see `divergedGenericAliasDecl`, which `firstCyclicAliasDecl` answers
				// with. What the indexes hold at this point is the last round's, which is internally consistent
				// — every recorded declared type is still resolved against it below — it is simply not a
				// fixpoint, and no answer read out of it can be observed by a program that compiles.
				if rounds > self.settledDeclarations().genericAliasDecls.count() as GenericAliasRoundCount 'deeperThanTheDeclarationGraphCanNEST'
					self.divergedGenericAliasDecl = self.firstContestedDeclaration()
					break
				end 'deeperThanTheDeclarationGraphCanNEST'
			end 'aRoundFoundANewContest'
		end 'someNameHasASECONDDeclarationToDisagreeWith'

		self.indexSharedInstanceGenericAliases()
		self.rekeyScopedGenericAliases()
		self.resolveRecordedGenericAliasTypes()
	end 'settleGenericAliasContest'

	// The earliest declaration of a name the contest condemned — E3091's anchor when the fixpoint gives up. A
	// contested name is by construction one whose declarations the walk was still re-minting, so any of them
	// names a real participant in the cycle; the EARLIEST by file path, then line, is chosen so the
	// diagnostic does not depend on the order the files were folded in.
	function firstContestedDeclaration() returns AliasCycleResult
		var blamed = AliasCycleResult.none

		for i in 0 upto self.settledDeclarations().genericAliasDecls.count() 'eachDeclaration'
			let entry = try self.settledDeclarations().genericAliasDecls.get(i) otherwise panic("ProgramSignatures.firstContestedDeclaration: genericAliasDecls.get OOB at {i}")

			if self.genericAliasSpellingIsSuperseded(entry.aliasName) 'itsNameIsContested'
				blamed = self.earlierBlame(blamed, candidate: i)
			end 'itsNameIsContested'
		end 'eachDeclaration'

		match blamed 'blamed'
			at then return blamed
			none then panic("ProgramSignatures.firstContestedDeclaration: the contest fixpoint ran past its bound with no contested name — a round only continues after filing one")
		end 'blamed'
	end 'firstContestedDeclaration'

	function earlierBlame(held AliasCycleResult, candidate ElementIndex) returns AliasCycleResult
		let heldIndex = (try held.blamedIndex() otherwise return AliasCycleResult.at(candidate as FieldIndex)) as ElementIndex
		let heldEntry = try self.settledDeclarations().genericAliasDecls.get(heldIndex) otherwise panic("ProgramSignatures.earlierBlame: genericAliasDecls.get OOB at {heldIndex}")
		let candidateEntry = try self.settledDeclarations().genericAliasDecls.get(candidate) otherwise panic("ProgramSignatures.earlierBlame: genericAliasDecls.get OOB at {candidate}")

		return AliasCycleResult.at(candidate as FieldIndex) if aliasDeclaredBefore(candidateEntry, held: heldEntry) else held
	end 'earlierBlame'

	// One round of the fixpoint: group every declaration by name over the instance it means in its own file,
	// and (re)file every disagreeing name. A name two files declare where an author takes part is filed too:
	// each declaration is its own type even over one instance. Answers whether anything moved, which is the
	// loop's condition.
	//
	// ⚠ **A DISAGREEING NAME IS REFILED EVERY ROUND, NOT ONLY THE ROUND IT FIRST DISAGREED.** A name contested
	// in round 1 can still hold an argument that only becomes contested in round 2 (`Box with (M, Low)` vs
	// `Box with (M, High)` — the pair disagrees on the SECOND argument while `M` is still the ambiguous bare
	// spelling), so a "file it once" rule would leave that name's instances stale and take the element
	// straight into `genericAliasInstance`'s refusal.
	//
	// ⚠ **AND THE MOVEMENT TEST IS THE INSTANCE COUNT, NOT THE CONTEST SET, FOR EXACTLY THAT CASE** — a round
	// that rescopes an argument of an already-contested name adds no NAME while changing what that name
	// means. `intern` is idempotent, so a round that rescopes nothing new interns nothing new and the count
	// stands still: that is the fixpoint.
	//
	// ⚠⚠ **THE VERDICT AND THE INDEX ARE TWO PASSES.** Built as ONE pass — a `GenericAliasDeclarationGroup`
	// per name, accumulating the by-file map as it went — the round would cost a group, an inner map and a
	// `FilePath.toString()` **per generic-alias declaration in every program**, paid by every compile for a
	// question whose answer is "none". The first pass answers the verdict with one `GenericInstanceId` and
	// one declaring-file list per name a second declaration mentions; the second builds a group only for the
	// names that disagree, which is no names at all in the corpus.
	function settleGenericAliasContestRound() returns bool
		let instancesBefore = self.rowCount()
		let firstInstance = GenericAliasMap.create()
		let declaringFiles = DeclaringFilesByAliasName.create()

		let disagreeing = DisagreeingAliasNameSet.create()

		let declared = self.settledDeclarations().genericAliasDecls

		for entry in declared 'eachDeclaration'
			// Only a name a SECOND declaration mentions can disagree with anything, so the walk narrows to
			// those and the map it fills holds one entry per such name rather than one per alias in the
			// program — see `multiplyDeclaredGenericAliases`.
			if not self.aliasNameIsDisagreedWith(entry.aliasName) 'itIsTheOnlyDeclarationOfThisName'
				continue
			end 'itIsTheOnlyDeclarationOfThisName'

			let scoped = self.fileScopedInstance(entry.internedInstance(), filePath: entry.filePath)

			if let first = try firstInstance.get(entry.aliasName) 'anotherDeclarationCameFirst'
				let files = try declaringFiles.get(entry.aliasName) otherwise panic("ProgramSignatures.settleGenericAliasContestRound: '{String.from(entry.aliasName)}' has a first instance and no declaring files — the two maps are written together")

				if first != scoped 'twoInstances'
					disagreeing.insert(entry.aliasName)
				end 'twoInstances'

				if not files.contains(entry.filePath.toString()) 'anotherFile'
					files.push(entry.filePath.toString())
				end 'anotherFile'
			end 'anotherDeclarationCameFirst' else 'theFirstDeclarationOfThisName'
				let files = StringArray.create(0)
				files.push(entry.filePath.toString())
				firstInstance.upsert(entry.aliasName, value: scoped)
				declaringFiles.upsert(entry.aliasName, value: files)
			end 'theFirstDeclarationOfThisName'
		end 'eachDeclaration'

		for (aliasName, files) in declaringFiles 'eachDeclaredName'
			if files.count() > 1 and self.settledDeclarations().typeAliases.provenance.anAuthorDeclaresAny(files) 'twoFilesAnAuthorTakesPartIn'
				disagreeing.insert(aliasName)
			end 'twoFilesAnAuthorTakesPartIn'
		end 'eachDeclaredName'

		if disagreeing.count() == 0 'noNameInThisProgramDisagreesWithItself'
			return self.rowCount() != instancesBefore
		end 'noNameInThisProgramDisagreesWithItself'

		return self.recordGenericAliasContests(disagreeing) or self.rowCount() != instancesBefore
	end 'settleGenericAliasContestRound'

	// The second pass — build the full by-declaring-file group for each DISAGREEING name and file it. Answers
	// whether any of them is newly contested, which is half the fixpoint's condition.
	function recordGenericAliasContests(disagreeing DisagreeingAliasNameSet) returns bool
		let byName = GenericAliasDeclarationGroupMap.create()

		let declared = self.settledDeclarations().genericAliasDecls

		for entry in declared 'eachDeclaration'
			if not disagreeing.contains(entry.aliasName) 'itsDeclarationsAgree'
				continue
			end 'itsDeclarationsAgree'

			if not byName.contains(entry.aliasName) 'firstDeclarationOfThisName'
				byName.upsert(entry.aliasName, value: GenericAliasDeclarationGroup.create())
			end 'firstDeclarationOfThisName'

			let group = try byName.get(entry.aliasName) otherwise panic("ProgramSignatures.recordGenericAliasContests: '{String.from(entry.aliasName)}' was just seeded into the group map and is not there")
			group.record(self.fileScopedInstance(entry.internedInstance(), filePath: entry.filePath), declFilePath: entry.filePath, spellingBits: entry.spellingBits())
		end 'eachDeclaration'

		var foundANewContest = false

		for (aliasName, group) in byName 'eachName'
			foundANewContest = foundANewContest or not self.genericAliasSpellingIsSuperseded(aliasName)
			self.recordGenericAliasContest(aliasName, group: group)
		end 'eachName'

		return foundANewContest
	end 'recordGenericAliasContests'

	// ⭐⭐ **THE ORDERING HAZARD, REPAIRED ONCE FOR BOTH SCOPINGS.** `recordGenericAlias` runs DURING
	// the sweep, so `typealias ByteArray = Array with Byte` was interned with the bare element — and
	// `typealias Grid = Array with Slots` with the bare ARGUMENT — before either contest could be known.
	// Every source-declared alias is re-keyed here to the instance its OWN DECLARING FILE means, which is the
	// whole reason `genericAliasDecls` retains every entry.
	//
	// ⭐ The COMPILER-MINTED aliases are deliberately NOT in that array and so keep their unscoped instance:
	// `__ManagedMemory` has no declaring file and means "the READER's byte array", which is exactly what an
	// unscoped entry plus a scoped read gives it.
	//
	// ⭐ **ONE PASS FOR RANGES AND ARGUMENTS**, on the same last-wins rule, over the same array — two
	// copies would be free to disagree about which declaration an entry names. `fileScopedInstance` is
	// the one composition both want.
	//
	// Last-wins by declaration order, which is `genericAliases`' own rule for a name two files declare, so the
	// bare entry and the file it is scoped by name one declaration. The E3017 instantiation SITES are rebuilt
	// on the rule they already had — each carries its own file, so they need no last-wins rule at all.
	function rekeyScopedGenericAliases()
		if not self.anythingNeedsScoping() 'nothingInThisProgramNeedsScoping'
			return
		end 'nothingInThisProgramNeedsScoping'

		let declared = self.mainThreadSettled().genericAliasDecls

		for entry in declared 'eachDeclaration'
			self.mainThreadSettled().genericAliases.upsert(entry.aliasName, value: self.fileScopedInstance(entry.internedInstance(), filePath: entry.filePath))
		end 'eachDeclaration'

		let sites = self.mainThreadSettled().genericAliasSites
		let scoped = GenericInstantiationSiteArray.create(sites.count(), zeroed: false)

		for site in sites 'eachSite'
			scoped.push(GenericInstantiationSite.create(self.fileScopedInstance(site.gid, filePath: site.filePath), nameLine: site.nameLine, nameColumn: site.nameColumn, filePath: site.filePath))
		end 'eachSite'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.genericAliasSites = scoped
	end 'rekeyScopedGenericAliases'

	// File one contested name into both contest indexes and mint an entry per declaration. Both indexes
	// are installed HERE, at the single writer, so a program with no contest allocates neither.
	function recordGenericAliasContest(aliasName ByteArray, group GenericAliasDeclarationGroup)
		let byName = self.genericAliasContestsForWrite()
		byName.upsert(aliasName, value: group.byDeclaringFile)

		// ⭐ The MINT — one entry per DECLARATION. The spelling is derived from the instance, and two
		// declarations of one instance, which are two types, are told apart by fold position
		// (`ClaimantProvenance.ordinalMints`). It inherits the source declaration's BUFFER-SPELLING bits, which
		// are the two facts a `GenericInstanceId` structurally cannot carry (`Array with __ManagedMemory` and
		// `Array with ByteArray` are one instance, as are `__ManagedMemory with Byte` and `ByteArray`), and
		// losing either at a rewritten field type would change that field's member roster.
		//
		// ⚠ **BOTH SETS, because `retypeField` rewrites the name the READ DOOR derives from.**
		// `derivedAliasSurfaceBits` reads both, so a contested `typealias B = __ManagedMemory with Byte` would
		// otherwise have its field's surface erased by the very pass that scopes it.
		//
		// ⚠⚠ **THE BITS COME FROM *THIS INSTANCE'S* DECLARATIONS, NOT FROM THE CONTESTED NAME, AND THE
		// DIFFERENCE IS A WRONG ANSWER RATHER THAN A REFINEMENT.** The registries are keyed by bare alias NAME
		// and are whole-program, so `contains(aliasName)` answers "did ANY file's declaration of this name
		// write the buffer?" — and a contested name is precisely the case where the files DISAGREE: with
		// `typealias B = __ManagedMemory with Byte` in one file and `typealias B = Array with Int` in another,
		// `b.items.count()` on a field of the SECOND kind would be refused with the BUFFER's roster. The group
		// carries each instance's own spelling for exactly this, so each mint takes the answer its own
		// declaration wrote.
		let spellings = MintByDeclaringFile.create()

		for (declPath, instance) in group.byDeclaringFile 'eachSpelling'
			spellings.upsert(declPath, value: instanceQualifiedAliasName(aliasName, canonicalInstance: self.canonicalInstanceName(instance)))
		end 'eachSpelling'

		let mints = self.mainThreadSettled().typeAliases.provenance.ordinalMints(spellings)

		for (declPath, instance) in group.byDeclaringFile 'eachDeclaration'
			let mint = try mints.get(declPath) otherwise panic("ProgramSignatures.recordGenericAliasContest: '{String.from(aliasName)}' declared in '{declPath}' was spelled in the pass above")
			self.mainThreadSettled().genericAliases.upsert(mint, value: instance)
			let spelling = group.spellingBitsOf(instance)

			if (spelling and SurfaceBitElementIsBuffer) != 0 'elementNamesTheBuffer'
				self.mainThreadSettled().bufferElementAliases.insert(mint)
			end 'elementNamesTheBuffer'

			if (spelling and SurfaceBitIsBuffer) != 0 'baseNamesTheBuffer'
				self.mainThreadSettled().bufferSurfaceAliases.insert(mint)
			end 'baseNamesTheBuffer'
		end 'eachDeclaration'

		self.mainThreadSettled().genericAliasMints.upsert(aliasName, value: mints)
	end 'recordGenericAliasContest'

	// ⭐⭐ **RESOLVE EVERY RECORDED DECLARED TYPE THAT NAMES A CONTESTED ALIAS, AGAINST THE FILE THAT DECLARED
	// THE SLOT — the half that keeps the fix from being a wild free.** A ranged or function alias whose
	// declarations are each their own type, and an instance spelled with one, are rescoped the same way
	// (`contestScopedDeclaredType`), and so are a declaration's parameter types beside its return.
	//
	// A struct field and a union payload are recorded by the declaration SWEEP, which runs before any generic
	// alias is interned, so their declared type is a bare `named("Bag")`. The drop and clone cascades read
	// that column with NO reader file (`managedFieldDropCallee`, `managedFieldCascadeStrategy`,
	// `denotesArrayInstance`) — while everything was last-wins they simply agreed with the parser, and the
	// program was refused rather than miscompiled. Scope the parser alone and they DISAGREE: `Nums.items`, a
	// buffer of integers, would be routed to `__destruct_Array_String` and its elements freed as pointers.
	//
	// ⭐ **THE SPELLING IS REWRITTEN AND THE TAG IS NOT**, deliberately. Rewriting to `genericInstance(gid)`
	// is what `declaredSlotType` produces and would satisfy the cascades — but it DESTROYS the alias NAME, and
	// `fieldSurfaceOf` reads that name to derive BOTH of the position's buffer-spelling bits
	// (`derivedAliasSurfaceBits`), neither of which a gid can carry. A minted `named` keeps every name-keyed
	// reader on exactly the path it was on and changes only which declaration the name denotes.
	//
	// ⚠ **WHICH IS WHY THE MINT MUST INHERIT BOTH SPELLING SETS** — see `recordGenericAliasContest`, where the
	// two `insert`s sit together for the reason they sit together in `recordGenericAlias`.
	//
	// ⚠ **A SPELLING THIS PASS DOES NOT REACH IS A PANIC, NOT A WRONG ANSWER** — `genericAliasInstance`
	// refuses a contested name outright. That is the whole reason the file-less door has a guard rather than a
	// comment: the set of places a declared type is RECORDED is a thing this pass must get right, and getting
	// it wrong has to be loud.
	function resolveRecordedGenericAliasTypes()
		if not self.anyGenericAliasNameContested() and not self.settledDeclarations().typeAliases.anyIdentityContest() and not self.settledDeclarations().functionTypeAliases.anyShapeContest() 'noNameIsContested'
			return
		end 'noNameIsContested'

		self.rewriteRecordedSlotTypes(RecordedReturnTypeRule.contestScopedAlias)
		self.rewriteRecordedReturnTypes(RecordedReturnTypeRule.contestScopedAlias)
	end 'resolveRecordedGenericAliasTypes'

	// EVERY DECLARED SLOT THE SWEEP RECORDED A RESOLVED TYPE INTO, REWRITTEN UNDER ONE RULE -- a struct's
	// fields and an enum case's payloads. It is `rewriteRecordedReturnTypes`' sibling over the other half of
	// the recorded surface, and it takes the SAME rule enum so that a repair which has to reach both halves
	// names one rule twice rather than being written out twice. `contestScopedAlias` is such a repair.
	function rewriteRecordedSlotTypes(rule RecordedReturnTypeRule)
		self.requireWholeProgramIndex("rewriteRecordedSlotTypes")

		for (_, slot) in self.structSlots 'eachStruct'
			let layout = self.ownLayoutAtSlot(slot)

			for index in 0 upto layout.fieldCount() 'eachField'
				let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.rewriteRecordedSlotTypes: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}`")

				if let rewritten = try self.rewrittenSlotTypeUnder(rule, declared: declared, slotScopeFilePath: layout.declFilePath) 'theRuleClaimsIt'
					layout.retypeField(index, declaredType: rewritten)
				end 'theRuleClaimsIt'

				layout.rebrandField(index, declaredBrand: self.sharedInstanceMintOr(layout.fieldDeclaredBrand(index), readerFilePath: layout.declFilePath, fallback: layout.fieldDeclaredBrand(index)))
			end 'eachField'
		end 'eachStruct'

		let revisedEnums = EnumLayoutArray.create(0)

		for (_, layout) in self.mainThreadSettled().enumTypes 'eachEnum'
			revisedEnums.push(try self.revisedLayoutWithRecordedPayloads(rule, layout: layout) otherwise continue)
		end 'eachEnum'

		for revised in revisedEnums 'eachRevised'
			fileEnumLayout(self.mainThreadSettled().enumTypes, layout: revised)
		end 'eachRevised'
	end 'rewriteRecordedSlotTypes'

	// One recorded SLOT type under `rule`, or a refusal when the rule does not claim it. The one rule that
	// reaches a slot is spelled here; the two that exist only for a `returns` clause panic rather than
	// returning the type unchanged, because a caller asking a return-only rule about a field has made a
	// mistake that a silent identity would carry into the recorded layout.
	function rewrittenSlotTypeUnder(rule RecordedReturnTypeRule, declared MaxonType, slotScopeFilePath FilePath) returns MaxonType throws MapError
		match rule 'rule'
			contestScopedAlias then return try self.contestScopedDeclaredType(declared, slotScopeFilePath: slotScopeFilePath)
			declaredStruct then panic("ProgramSignatures.rewrittenSlotTypeUnder: `declaredStruct` is a recorded-RETURN rule and has no slot reading")
			declaredInterface then panic("ProgramSignatures.rewrittenSlotTypeUnder: `declaredInterface` is a recorded-RETURN rule and has no slot reading")
		end 'rule'
	end 'rewrittenSlotTypeUnder'

	// ⭐⭐ **THE ONE REWRITE OF `returnTypes`, AND THE THREE RULES THAT DRIVE IT.** Three whole-program
	// passes re-decide a recorded return type — the contest rescoping, the struct re-tag and the
	// interface re-tag — and each would otherwise spell out the same COLLECT-THEN-APPLY walk of the
	// same map, under the same key, reconstructing the same `MaxonReturnType.value`, with nothing
	// making the three agree: the keying rule stated below is a property of THE MAP and not of any one
	// pass, so a fourth pass copying the shape would have had to rediscover it, and a correction to
	// one copy would have reached one caller in three. The walk is one fact and lives here; what
	// differs between the three is a single line, and that line IS the rule
	// (`rewrittenReturnTypeUnder`).
	//
	// ⚠ **COLLECTED, THEN APPLIED**: it rewrites the very map it walks, and rewriting a container mid-walk
	// is the one shape a `for … in` cannot promise anything about. Both columns stay empty for every
	// program whose declarations the rule claims none of — which, for all three rules, is most of the
	// corpus.
	//
	// ⚠ **IT IS KEYED OFF `returnTypes` AND NOT OFF ANY FILE COLUMN**, so a name whose entry has since been
	// REFILED (a contested free function's namespace-qualified key, a stdlib shadow, a renamed default
	// helper) is rewritten under the key it actually lives at and never resurrected under the one it left.
	// The three refile sites move the file column with the return type for exactly that reason.
	export function rewriteRecordedReturnTypes(rule RecordedReturnTypeRule)
		let rewrittenCallees = NameRoster.create(0)
		let rewrittenReturns = MaxonTypeArray.create(0)

		for (callee, declared) in self.mainThreadSettled().returnTypes 'eachReturnType'
			if let rewritten = try self.rewrittenReturnTypeUnder(rule, declFilePath: self.recordedReturnDeclFileOf(callee), declared: declared) 'theRuleClaimsIt'
				rewrittenCallees.push(callee)
				rewrittenReturns.push(rewritten)
			end 'theRuleClaimsIt'
		end 'eachReturnType'

		for i in 0 upto rewrittenCallees.count() 'applyEach'
			let callee = try rewrittenCallees.get(i) otherwise panic("ProgramSignatures.rewriteRecordedReturnTypes: rewrittenCallees.get OOB at {i} below count {rewrittenCallees.count()}")
			let rewritten = try rewrittenReturns.get(i) otherwise panic("ProgramSignatures.rewriteRecordedReturnTypes: rewrittenReturns.get OOB at {i} — the two columns are pushed in lockstep")
			self.mainThreadSettled().returnTypes.upsert(callee, value: MaxonReturnType.value(rewritten))
		end 'applyEach'

		self.rewriteSweptDeclarationReturnTypes(rule)
	end 'rewriteRecordedReturnTypes'

	// ⭐⭐ **THE PER-DECLARATION RETURN TYPES ARE THE SAME FACT AS `returnTypes`, SO THEY ARE REWRITTEN BY THE
	// SAME THREE RULES IN THE SAME ACT.** `sweptDeclarations` keeps every declaration's own return
	// type, which makes it a SECOND COPY of a fact three whole-program passes re-decide after the sweep and
	// before any file is parsed. A copy no rewrite
	// reaches is this project's signature bug across a pass boundary, and here its divergence is a WRONG TYPE
	// at a parsed call rather than a diagnostic: `Parser.boundReturnOf` hands its answer straight
	// to `mintDeclaredCallResult`.
	//
	// ⚠ **THE DECLARING FILE IS THE DECLARATION'S OWN.** The contest rule resolves a contested generic alias
	// in the file that declared the FUNCTION, and `SweptDeclaration.declFilePath` states it directly, so each
	// declaration is rescoped in its own file's scope without a lookup in `funcReturnDeclFiles`.
	//
	// ⚠ COLLECT-THEN-APPLY, and REBUILD-THEN-ASSIGN, for the two reasons this file already states: a map may
	// not be rewritten mid-walk, and an `SweptDeclaration`'s fields are `let`, so a rewritten declaration is a
	// fresh record. A key whose declaration the rule does not claim keeps the record it already had.
	function rewriteSweptDeclarationReturnTypes(rule RecordedReturnTypeRule)
		let rewrittenKeys = NameRoster.create(0)
		let rewrittenDecls = SweptDeclarationArray.create(0)

		for (key, declaration) in self.mainThreadSettled().sweptDeclarations 'eachKey'
			if let rebuilt = try self.rewrittenSweptDeclarationUnder(rule, decl: declaration) 'theRuleClaimsIt'
				rewrittenKeys.push(key)
				rewrittenDecls.push(rebuilt)
			end 'theRuleClaimsIt'
		end 'eachKey'

		for i in 0 upto rewrittenKeys.count() 'applyEach'
			let key = try rewrittenKeys.get(i) otherwise panic("ProgramSignatures.rewriteSweptDeclarationReturnTypes: rewrittenKeys.get OOB at {i} below count {rewrittenKeys.count()}")
			let rebuilt = try rewrittenDecls.get(i) otherwise panic("ProgramSignatures.rewriteSweptDeclarationReturnTypes: rewrittenDecls.get OOB at {i} — the two columns are pushed in lockstep")
			self.mainThreadSettled().sweptDeclarations.upsert(key, value: rebuilt)
		end 'applyEach'
	end 'rewriteSweptDeclarationReturnTypes'

	// One declaration with `rule` applied, or `MapError.keyNotFound` when the rule claims NONE of it — the same
	// "absence is a throw" convention the rule bodies themselves use, so a key nothing changed keeps the record
	// it already had rather than an identical copy of it.
	function rewrittenSweptDeclarationUnder(rule RecordedReturnTypeRule, decl SweptDeclaration) returns SweptDeclaration throws MapError
		var member = decl
		var claimed = false

		if let rewritten = try self.rewrittenReturnTypeUnder(rule, declFilePath: decl.declFilePath, declared: decl.returnType) 'theRuleClaimsIt'
			member = member.withReturnType(MaxonReturnType.value(rewritten))
			claimed = true
		end 'theRuleClaimsIt'

		if let rewrittenParams = try self.rewrittenParamTypesUnder(rule, decl: decl) 'theRuleClaimsAParameter'
			member = member.withParamTypes(rewrittenParams)
			claimed = true
		end 'theRuleClaimsAParameter'

		if not claimed 'theRuleClaimsNoneOfIt'
			throw MapError.keyNotFound
		end 'theRuleClaimsNoneOfIt'

		return member
	end 'rewrittenSweptDeclarationUnder'

	function rewrittenParamTypesUnder(rule RecordedReturnTypeRule, decl SweptDeclaration) returns MaxonTypeArray throws MapError
		match rule 'rule'
			contestScopedAlias then break
			declaredStruct or
			declaredInterface then throw MapError.keyNotFound
		end 'rule'

		let rebuilt = MaxonTypeArray.create(decl.paramTypes.count(), zeroed: false)
		var claimed = false

		for declared in decl.paramTypes 'eachParameter'
			if let rewritten = try self.contestScopedDeclaredType(declared, slotScopeFilePath: decl.declFilePath) 'theRuleClaimsIt'
				rebuilt.push(rewritten)
				claimed = true
			end 'theRuleClaimsIt' else 'unchanged'
				rebuilt.push(declared)
			end 'unchanged'
		end 'eachParameter'

		if not claimed 'theRuleClaimsNone'
			throw MapError.keyNotFound
		end 'theRuleClaimsNone'

		return rebuilt
	end 'rewrittenParamTypesUnder'

	// ⭐ **THE FILE A RECORDED RETURN TYPE IS RESCOPED IN, or the STRANGER's when none is recorded.** A return
	// type with no recorded declaring file names nothing still to be resolved — `record` writes that column
	// iff `returnTypeNamesAType`, which is exactly the bare-`named` case — so the fallback is reached only by
	// an entry `contestScopedDeclaredType`'s own tag guard declines. It is the honest answer to "no file to
	// prefer" rather than a stand-in for one, and it is the spelling `aggregatesConflict` already uses for
	// that idea.
	// ⚠ **EXPORTED FOR THE PARSER'S READ DOOR AS WELL AS THIS FILE'S REWRITE.** A CALL SITE
	// repairs the callee's swept return type (`Parser.repairSweptType`), and that repair is scoped by the
	// same rule the rewrite below applies — the SLOT's declaring file. Read with the CALLER's file instead,
	// a coexisting name gives a callee's return two meanings: `fromA() returns Widget` over an unexported
	// ranged alias, called from a third file that declares neither, is a false E3005 — and through a field
	// read an integer is dereferenced as a record.
	export function recordedReturnDeclFileOf(callee ByteArray) returns FilePath
		return try self.settledDeclarations().funcReturnDeclFiles.get(callee) otherwise CompilerOwnedDeclFilePath
	end 'recordedReturnDeclFileOf'

	// The ONE line each rule contributes: the type this entry should now carry, or `MapError.keyNotFound`
	// when the rule does not claim it — the "absence is a throw" convention all three re-tags already
	// shared. A `match` rather than a chain, so a fourth rule cannot be added without being given a line.
	function rewrittenReturnTypeUnder(rule RecordedReturnTypeRule, declFilePath FilePath, declared MaxonReturnType) returns MaxonType throws MapError
		match rule 'rule'
			contestScopedAlias then return try self.contestScopedReturnType(declared, declFilePath: declFilePath)
			declaredStruct then return try self.sweptStructReturnOf(declared, declFilePath: declFilePath)
			declaredInterface then return try self.sweptInterfaceReturnOf(declared, declFilePath: declFilePath)
		end 'rule'
	end 'rewrittenReturnTypeUnder'

	// ⚠ **A function's RETURN type is resolved against the file that declared the FUNCTION, and THAT FILE IS
	// LOOKED UP BY THE TWO WALKS RATHER THAN HERE, because they know it from different places.**
	// `funcReturnDeclFiles` holds one file per KEY and a `SweptDeclaration` carries its OWN;
	// a lookup inside the rule would force both walks through the key's answer. `funcReturnDeclFiles` carries the
	// measurement of what the rule's absence costs — a `returns Bytes` crossing a file boundary takes the
	// CALLER's `Bytes`, and two element widths compare equal.

	// The `structRef` a swept `named` denotes; `MapError.keyNotFound` when the name denotes no struct BOX.
	// It follows `sweptInterfaceTypeOf`'s shape — the other recorded-return-type re-tag on this index —
	// including its "absence is a throw" convention, so both read as one kind of pass. A `void` return
	// names no type to re-tag, and a type that is already concrete is refused by the tag guard, which is
	// what makes this idempotent.
	function sweptStructReturnOf(declared MaxonReturnType, declFilePath FilePath) returns MaxonType throws MapError
		match declared 'shape'
			void then throw MapError.keyNotFound
			value(inner) then return try self.sweptStructTypeOf(inner, readerFilePath: declFilePath)
		end 'shape'
	end 'sweptStructReturnOf'

	// ⚠⚠ **IT RESOLVES THE NAME THROUGH `denotedAggregateName`, AND ASKING `containsStruct` OF THE RAW NAME
	// MADE THE ANSWER A PROPERTY OF THE DISK.** A TUPLE TYPEALIAS mints no identity — it
	// names the tuple's own canonical struct and nothing else — so `containsStructInAnyFile("Pair")` is false while
	// `containsStructInAnyFile("__Tuple2.Num.Num")` is true, and a rule reading the raw name declined every
	// `returns Pair`. That was invisible while the sweep happened to resolve it: `recordTupleAlias` writes
	// DURING the walk rather than at the end of a file (unlike every other alias registry), so a factory
	// whose file the walk reached AFTER the alias's file got a resolved `structRef` from
	// `Parser.parseTypeReference` and never needed this rule. **MEASURED, one directory, byte-identical
	// source, only the file NAMES changed:** with the alias's file sorting first the program compiled and
	// printed `11 22`; with the factory's file first the identical program was refused. Same program, two
	// answers, decided by a directory walk.
	//
	// `denotedAggregateName` is the one door that already answers "what does this name denote", and it is
	// the SAME door the drop router (`managedFieldDropCallee`) and every managed classifier ask — so what
	// this rule re-tags and what those route are one set by construction. For a declared `type` it is the
	// identity, and re-interning a name the table already holds returns the id it already had, which is why
	// no struct return moves.
	// ⚠⚠ **AND IT CLAIMS AN ALREADY-`structRef` TUPLE TOO, BECAUSE A SWEPT `structRef` IS NOT NECESSARILY
	// THE CANONICAL SPELLING.** `parseTypeReference`'s tuple arm is deliberately OUTSIDE
	// the `allFilesFolded` gate its neighbours sit behind, so during the sweep a `returns Tagged` already
	// resolves to `structRef` — through `tupleAliasTargetFrom` → `canonicalNameOfStruct`, which is itself gated
	// on `allFilesFolded` and therefore hands back the RAW spelling at that moment. The recorded type is
	// then concrete and WRONG-NAMED: `__Tuple2.String.Num` where every value of that tuple, and the
	// destructor synthesized for it, carry `__Tuple2.String.int`.
	//
	// **MEASURED:** `typealias Tagged = (String, Num)` with `Num = int(0 to 1000)`, built by a top-level
	// factory, died in the backend — `resolveCallFixups: call to unknown function
	// '__destruct___Tuple2.String.Num'` — while `(String, String)`, whose two spellings coincide, built and
	// ran. So the defect was never "a tuple owns heap"; it was the NAME, at a door that had not
	// canonicalized. This is the third such door and it takes the cure the other two already took —
	// `tuples.md`'s `array-of-managed-element-tuples-drops-each` records the second, in the same words.
	//
	// A tag guard alone would decline exactly the entries that need this most, which is why the shape below
	// is "what should this name be?" rather than "is this tag still bare?". Re-interning a name the table
	// already holds returns the id it already had, and a name already canonical maps to itself — so a
	// declared `type` and an already-canonical tuple both fall out through the `equals` test unmoved, and
	// the rule stays idempotent.
	function sweptStructTypeOf(declared MaxonType, readerFilePath FilePath) returns MaxonType throws MapError
		let tag = maxonTypeTag(declared)

		if not tagMayNameAggregate(tag) 'namesNoStructBox'
			throw MapError.keyNotFound
		end 'namesNoStructBox'

		let written = self.nameOfId(typeNameIdOf(declared))

		// `denotedAggregateNameFrom` resolves a tuple TYPEALIAS as `readerFilePath` means it;
		// `canonicalNameOfStruct` then settles which SPELLING of that tuple everything downstream uses. The
		// drop router and every managed classifier reach the same tuple through the project layout
		// `declaredSlotType` built, which is the door the type check reads too — so a tuple this re-tag and
		// those routes could disagree about is one the type check has already refused.
		let denoted = self.canonicalNameOfStruct(self.denotedAggregateNameFrom(written, readerFilePath: readerFilePath))

		// ⚠ **AND NOT WHERE AN ALIAS ANSWERS FOR THE DECLARING FILE.** `containsStruct` is bare and
		// whole-program, so once a `type Box` and a `typealias Box` in two files may both stand this re-tag
		// gave every file the struct. MEASURED inside `stdlib/`: `__int_fromString(…) returns FullRangeInt` was
		// rewritten to a USER program's `type FullRangeInt`, so `let result = try __int_fromString(input)` bound
		// a struct and `result < 0` was **E3005 'cannot compare struct with int'** — in a library file, three
		// passes downstream of the declaration that caused it.
		if not self.containsStructInAnyFile(denoted) or self.aliasShadowsNominalFor(written, readerFilePath: readerFilePath) 'namesNoStructBox'
			throw MapError.keyNotFound
		end 'namesNoStructBox'

		if tagNamesADeclaredType(tag) and denoted.equals(written) 'alreadyTheSpellingEveryoneUses'
			throw MapError.keyNotFound
		end 'alreadyTheSpellingEveryoneUses'

		return MaxonType.structRef(self.typeNames.intern(denoted))
	end 'sweptStructTypeOf'

	// ⭐⭐ **RE-TAG EVERY SWEPT `named` THAT DENOTES AN `interface` AS AN `interfaceRef` — the ONE
	// repair that makes the two type registries agree about what an interface annotation MEANS.**
	//
	// The declaration sweep records a struct field's and a function's declared type by running
	// `Parser.parseTypeReference` (`foldDeclaredSignaturesInto`), and the interface registry it would have to
	// consult is filled by `foldInterfaceDeclarations` — which runs at the very END of
	// `queryProgramSignatures`, after every file is swept. So a swept `Backend` is ALWAYS a bare `named`,
	// while the real parse (reading a complete registry) mints `interfaceRef`. That is not a cosmetic
	// difference: `StructLayout.offsetOfField` gives an existential field TWO slots and a `named` one, so the
	// two registries would disagree about a struct's SIZE and about where every field after the first
	// interface field lives — a wrong address rather than a diagnostic.
	//
	// ⚠ **IT IS A NORMALIZATION, NOT A SECOND RESOLUTION RULE.** It asks the same `lookupInterface` over the
	// same `interfaces` map that `parseTypeReference` and `TypeResolution.denotedNamedType` ask, so there is
	// one statement of "which names are interfaces" and three readers of it. Anything it misses stays a
	// `named` and is caught by the authority as E3011 — never silently sized wrong, because a `named` field
	// is one slot in BOTH registries.
	//
	// ⚠ **A PROGRAM THAT DECLARES NO INTERFACE PAYS ONE `Map.count()`.** The corpus is overwhelmingly of that
	// shape, and the walk below is O(structs × fields + functions) only when it can do something.
	export function normalizeSweptInterfaceTypes()
		self.requireWholeProgramIndex("normalizeSweptInterfaceTypes")

		if self.mainThreadSettled().interfaces.entries.count() == 0 'noInterfaceIsDeclared'
			return
		end 'noInterfaceIsDeclared'

		for (_, slot) in self.structSlots 'eachStruct'
			let layout = self.ownLayoutAtSlot(slot)

			for index in 0 upto layout.fieldCount() 'eachField'
				let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.normalizeSweptInterfaceTypes: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}`")

				if let asInterface = try self.sweptInterfaceTypeOf(declared, readerFilePath: layout.declFilePath) 'namesAnInterface'
					layout.retypeField(index, declaredType: asInterface)
				end 'namesAnInterface'
			end 'eachField'
		end 'eachStruct'

		// ⚠ **THE RETURN-TYPE HALF IS THE SHARED WALK AND THE FIELD HALF CANNOT BE.** A field re-tag writes
		// THROUGH a layout (`retypeField`) and touches no map, so it may run in place above; a return-type
		// re-tag rewrites the very map it walks, which is the collect-then-apply
		// `rewriteRecordedReturnTypes` states once for all three rules.
		self.rewriteRecordedReturnTypes(RecordedReturnTypeRule.declaredInterface)
	end 'normalizeSweptInterfaceTypes'

	export function settleInlineRecordGeometry()
		self.requireWholeProgramIndex("settleInlineRecordGeometry")

		let serviceStates = StructNameSet.create()

		for service in serviceCompanionRoster(self) 'eachService'
			serviceStates.insert(service)
		end 'eachService'

		// A spawned type's state is the cown's heap record — its receiver, the target of its
		// mutations, and what `__finish` drops — so it is never packed, whatever its fields.
		for (_, slot) in self.structSlots 'eachDeclaredType'
			let layout = self.ownLayoutAtSlot(slot)

			if serviceStates.contains(layout.name) 'aServiceState'
				continue
			end 'aServiceState'

			match self.inlineRecordShapeOf(layout) 'shape'
				notInline then continue
				packed(bitWidths) then layout.settleInlinePacking(bitWidths)
			end 'shape'
		end 'eachDeclaredType'

		self.inlineGeometrySettled = true

		let byId = BoolArray.create(self.typeNames.count(), zeroed: false)

		for id in 0 upto self.typeNames.count() 'eachInternedTypeName'
			byId.push(self.nameIsInlineRecord(self.nameOfId(id)))
		end 'eachInternedTypeName'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.inlineRecordByTypeNameId = byId
	end 'settleInlineRecordGeometry'

	function requireInlineRecordMemoIsWithinTheBaseline()
		if self.settledDeclarations().inlineRecordByTypeNameId.count() as TypeNameId > self.typeNames.baselineNameCount() 'memoPastTheBaseline'
			panic("ProgramSignatures.requireInlineRecordMemoIsWithinTheBaseline: the inline-record memo holds {self.settledDeclarations().inlineRecordByTypeNameId.count()} row(s) against an interner baseline of {self.typeNames.baselineNameCount()} — `TypeNameInterner.rewindTo(baselineTableMark())` recycles every id above the baseline after each parse, so a memoized row above it would answer about a name the id no longer denotes")
		end 'memoPastTheBaseline'
	end 'requireInlineRecordMemoIsWithinTheBaseline'

	// The memo is filled at the settle and ids keep being minted after it, so a row past its end is not an
	// error — the name probe answers those.
	function typeNameIdIsInlineRecord(id TypeNameId, from TypeNameInterner) returns bool
		if not (from is self.typeNames) 'aForeignInterner'
			return self.nameIsInlineRecord(foreignNameOf(from, id: id))
		end 'aForeignInterner'

		return try self.settledDeclarations().inlineRecordByTypeNameId.get(id) otherwise self.nameIsInlineRecord(self.nameOfId(id))
	end 'typeNameIdIsInlineRecord'

	function inlineRecordShapeOf(layout StructLayout) returns InlineRecordShape
		if layout.fieldCount() == 0 or layout.typeParamCount() != 0 or layout.whereConstraintCount() != 0 'shapeIsNotAPlainRecord'
			return InlineRecordShape.notInline
		end 'shapeIsNotAPlainRecord'

		if layout.conformsToBuiltinManagedWrapper() 'aFusedWrapper'
			return InlineRecordShape.notInline
		end 'aFusedWrapper'

		var total = 0 as FullRangeInt

		for index in 0 upto layout.fieldCount() 'eachField'
			if layout.fieldIsMutable(index) 'aWritableField'
				return InlineRecordShape.notInline
			end 'aWritableField'

			let bits = try self.inlineRecordFieldBits(layout, index: index) otherwise return InlineRecordShape.notInline
			total = total + (bits as FullRangeInt)
		end 'eachField'

		if total > (InlineRecordWordBits as FullRangeInt) 'pastTheWord'
			return InlineRecordShape.notInline
		end 'pastTheWord'

		let bitWidths = BitWidthArray.create(layout.fieldCount(), zeroed: false)

		for index in 0 upto layout.fieldCount() 'eachAcceptedField'
			bitWidths.push(try self.inlineRecordFieldBits(layout, index: index) otherwise panic("ProgramSignatures.inlineRecordShapeOf: field {index} of `type {String.from(layout.name)}` was accepted by the width pass and has no width in the collection pass — both read `inlineRecordFieldBits`"))
		end 'eachAcceptedField'

		return InlineRecordShape.packed(bitWidths)
	end 'inlineRecordShapeOf'

	function inlineRecordFieldBits(layout StructLayout, index FieldIndex) returns BitWidth throws InlineFieldLookup
		return try self.inlineFieldBitsOf(try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.inlineRecordFieldBits: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}` below its own count"), declFilePath: layout.declFilePath)
	end 'inlineRecordFieldBits'

	// ⚠ The alias is resolved AS THE DECLARING FILE SEES IT — the same door the field's own range check
	// uses. The file-less `*InEveryFile` doors fold the widest declaration of a name over the whole
	// program, so a user's `bits(32)` spelled `Sha2Word` would be sized by `stdlib/Sha2.maxon`'s
	// `bits(64)` `Sha2Word` instead: a silently wrong width, and a type that qualifies or not by what
	// another file happens to declare.
	//
	// An ENUM field reaches the `undeclared` arm and so is never admitted, which
	// `specs/ranged-int-bit-packing.md` requires: enums are not packed (`ir-specs/enum-narrow-storage.md`
	// owns their slot).
	function inlineFieldBitsOf(declared MaxonType, declFilePath FilePath) returns BitWidth throws InlineFieldLookup
		let tag = maxonTypeTag(declared)

		if tag == ValueTypeTag.boolean 'theOneBitCase'
			return (try packedWidthOf(BooleanPacking) otherwise panic("inlineFieldBitsOf: `BooleanPacking` is a packed width")) as BitWidth
		end 'theOneBitCase'

		if tag != ValueTypeTag.named 'namesNoRangedAlias'
			throw InlineFieldLookup.notPackable
		end 'namesNoRangedAlias'

		match self.settledDeclarations().typeAliases.lookup(self.nameOfId(typeNameIdOf(declared)), readerFilePath: declFilePath) 'resolved'
			undeclared then throw InlineFieldLookup.notPackable
			declared(alias) then return try inlineRangedAliasBits(alias)
		end 'resolved'
	end 'inlineFieldBitsOf'

	function foldedGlobalStdType(tag ValueTypeTag, typeName ByteArray, name ByteArray) returns StdType
		if tagNamesADeclaredType(tag) and not self.nameIsInlineRecord(typeName) 'aHeapRecordInAScalarSlot'
			panic("ProgramSignatures.foldedGlobalStdType: top-level binding '{String.from(name)}' folded to a `{String.from(typeName)}` constant, and that type does NOT pack inline into a word — a heap record's slot holds a POINTER `__module_init` fills, so a folded payload here would lay a box address down as image bytes")
		end 'aHeapRecordInAScalarSlot'

		return globalStdType(tag, name: name)
	end 'foldedGlobalStdType'

	export function inlineBitWidthsOf(name ByteArray) returns BitWidthArray
		return (try self.registeredLayout(name) otherwise panic("ProgramSignatures.inlineBitWidthsOf: `{String.from(name)}` is not a declared type — every caller asks `nameIsInlineRecord` first")).fieldBitWidths.clone()
	end 'inlineBitWidthsOf'

	export function nameIsInlineRecord(name ByteArray) returns bool
		return self.layoutPacksInlineIntoAWord(try self.registeredLayout(name) otherwise return false)
	end 'nameIsInlineRecord'

	export function layoutPacksInlineIntoAWord(layout StructLayout) returns bool
		if not self.inlineGeometrySettled 'askedBeforeTheSettle'
			panic("ProgramSignatures.layoutPacksInlineIntoAWord: asked whether `type {String.from(layout.name)}` packs inline into a word before `settleInlineRecordGeometry` ran — every layout answers `false` until the whole program is folded, so an answer read here would be a representation decision taken on an unsettled fact")
		end 'askedBeforeTheSettle'

		return layout.packsInlineIntoAWord
	end 'layoutPacksInlineIntoAWord'

	// The `interfaceRef` a swept `named` denotes; `MapError.keyNotFound` when the name is not an interface —
	// the single test `normalizeSweptInterfaceTypes` applies to a field type and to a return type, so the two
	// cannot come to disagree about which types it rewrites. A type that is already concrete (a `structRef`,
	// a primitive, an instance) is not a `named` and is refused by the tag guard. It follows
	// `contestScopedDeclaredType`'s shape — the other recorded-type re-tag on this index — including its
	// "absence is a throw" convention, so both read as one kind of pass.
	export function sweptInterfaceTypeOf(declared MaxonType, readerFilePath FilePath) returns MaxonType throws MapError
		if maxonTypeTag(declared) != ValueTypeTag.named 'namesNoInterface'
			throw MapError.keyNotFound
		end 'namesNoInterface'

		// `isInterfaceName` for `Parser.parseTypeReference`'s reason: this walks every field of every declared
		// struct and every return type, and only needs the answer.
		let id = typeNameIdOf(declared)
		let name = self.nameOfId(id)

		// The contest guard is `sweptStructTypeOf`'s, one registry over — see there.
		if self.nameDeclaresAnInterface(name) and not self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath) 'aBareInterfaceName'
			return MaxonType.interfaceRef(id)
		end 'aBareInterfaceName'

		// ⭐⭐ **AN INSTANCE OF AN INTERFACE IS AN EXISTENTIAL TOO, AND THE FIELD COLUMN IS WHERE MISSING IT
		// CORRUPTS RATHER THAN REFUSES.** `var seq as IntegerSeq` over `typealias IntegerSeq = Seq with Integer`
		// is a swept `named("IntegerSeq")` exactly as a bare `Seq` is a swept `named("Seq")`, and the real parse
		// mints `interfaceRef` for BOTH (`instanceDenotedType`). Left to `declaredSlotType`'s `genericAlias` arm
		// the field would be re-tagged `genericInstance` and budgeted ONE slot, while every reader of the type
		// loaded a witness at `+8` — the next field. So the instance half is repaired HERE, where the re-tag goes
		// through `retypeField` and rebuilds the two-slot prefix sum with it.
		if not self.isGenericAliasInAnyFile(name) 'namesNoInterface'
			throw MapError.keyNotFound
		end 'namesNoInterface'

		// The alias's own declaring file cannot be known from a type alone, and a CONTESTED alias is the only
		// name for which that matters; the base is what decides this question, and a contest is over the
		// ARGUMENTS of one base name (`settleGenericAliasContest`), never over the base.
		let asInstance = self.instanceDenotedType(self.bareGenericAliasInstance(name), into: self.typeNames)

		if maxonTypeTag(asInstance) != ValueTypeTag.interfaceRef 'aStructInstance'
			throw MapError.keyNotFound
		end 'aStructInstance'

		return asInstance
	end 'sweptInterfaceTypeOf'

	// Does an `interface` declaration hold `name`? Asked of the declaration SITES as well as the registry,
	// because a service's request union is synthesized before `foldInterfaceDeclarations` fills `interfaces`
	// (`settleCrossKindContests` reads the sites for the same reason).
	function nameDeclaresAnInterface(name ByteArray) returns bool
		return isInterfaceName(self.settledDeclarations().interfaces, name: name) or self.settledDeclarations().interfaceDeclSiteNames.contains(name)
	end 'nameDeclaresAnInterface'

	// ⭐⭐ **RE-TAG EVERY SWEPT `named` FIELD THAT IS A BARE GENERIC NAME AS THE INSTANCE ITS DECLARING SCOPE
	// BINDS — the field-column twin of the interface normalization above, and for the identical reason.**
	//
	// `Cell` written inside `type Holder uses T` means `Cell with Holder.T`, and that rule
	// (`scopedGenericInstanceOf`) is gated on `allFilesFolded` because the struct registry is still filling
	// while the declaration sweep reads it. So a swept field type is ALWAYS the bare `named("Cell")` — the
	// BASE's declaration view — while the real parse, reading a complete registry, records
	// `genericInstance(Cell with Holder.T)` for the very same field. One declaration, two registries, two
	// answers.
	//
	// ⛔⛔ **AND THE DROP CASCADE READ THE UNREPAIRED ONE, WHICH IS A LEAK WITH NO DIAGNOSTIC.**
	// `substituteInstanceFieldType` reads this column off `baseLayoutOf`, and `substituteThroughInstance`
	// passes a `named` through untouched (it has no name table) — so `Holder with String`'s cascade classifies
	// its `cell` field as the BASE `Cell`, whose only field is the opaque `T` and which therefore owns nothing.
	// The drop it emits is the trivial `__mm_decref`: the cell's BOX is reclaimed and the `String` the type
	// argument put inside it is stranded. **MEASURED without this normalization** — `Holder with String` built
	// from a `Cell with String` prints its answer and exits **101**, while the corpus's only case of the
	// shape (`bare-generic-name-as-a-field-type`) is over `Integer`, which has nothing to strand and so agrees.
	//
	// ⭐ **IT IS NORMALIZED HERE RATHER THAN REPAIRED AT EACH READER, AND THE THIRD READER IS WHY.** The field
	// READ already carried this rule inline (`fieldTypeOf`), the drop cascade did not, and the CLONE gate
	// (`structFieldsSupportDeepClone`) reads the same raw column a fourth time. Repairing the cascade would
	// have made three copies of one rule, and the copies decide ownership: a gate and a strategy that resolve a
	// name differently admit a clone nobody can emit, which is the failure `managedNameCascadeStrategy`'s own
	// header records. Recorded once, every reader of the column sees the instance and there is nothing left to
	// remember.
	//
	// ⚠ **STRUCT FIELDS ONLY, AND THAT IS A PROPERTY OF THE LANGUAGE RATHER THAN A GAP.** The rule needs a
	// binding SCOPE — the enclosing declaration's `uses` list — and only a struct layout carries one: a union
	// declared `uses` cannot be instantiated at all (`Maybe with String` is **E2055**, measured on this tree),
	// so a payload has no scope to bind against. A method's recorded RETURN type has the same gap and a
	// different cure already: `Parser.promoteBareGenericResultToCalleeScope` repairs it in the CALLEE's scope,
	// which is not this layout's and so is not this walk's to answer.
	//
	// ⚠ **A PROGRAM THAT DECLARES NO TYPE PARAMETER PAYS ONE `Map.count()`** — `normalizeSweptInterfaceTypes`'
	// gate, over the registry that answers the necessary condition here: no type parameter anywhere means no
	// scope binds anything.
	export function normalizeSweptScopedGenericFields()
		self.requireWholeProgramIndex("normalizeSweptScopedGenericFields")

		if self.mainThreadSettled().typeParamOwners.count() == 0 'noTypeParameterIsDeclared'
			return
		end 'noTypeParameterIsDeclared'

		for (_, slot) in self.structSlots 'eachStruct'
			let layout = self.ownLayoutAtSlot(slot)

			// A non-generic declaring type binds nothing, so it cannot make a bare name mean an instance —
			// `fieldTypeOf`'s own measured gate, which exists because `scopedGenericInstanceOf` returns a UNION
			// and Maxon heap-boxes even its payload-free arm.
			if layout.typeParamNames.isEmpty() 'scopeBindsNothing'
				continue
			end 'scopeBindsNothing'

			for index in 0 upto layout.fieldCount() 'eachField'
				let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.normalizeSweptScopedGenericFields: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}`")

				if let asInstance = try self.sweptScopedGenericFieldTypeOf(declared, layout: layout) 'namesABareGeneric'
					layout.retypeField(index, declaredType: asInstance)
				end 'namesABareGeneric'
			end 'eachField'
		end 'eachStruct'
	end 'normalizeSweptScopedGenericFields'

	// The instance a swept `named` field of `layout` denotes; `MapError.keyNotFound` when the name is not a
	// bare generic one — `sweptInterfaceTypeOf`'s shape, and its "absence is a throw" convention, so both
	// normalizations of this column read as one kind of pass. The RULE is `scopedGenericInstanceOf`'s, shared
	// with the READ doors that ask it of a different scope; what this adds is only which scope a FIELD is in.
	function sweptScopedGenericFieldTypeOf(declared MaxonType, layout StructLayout) returns MaxonType throws MapError
		if maxonTypeTag(declared) != ValueTypeTag.named 'namesNoBareGeneric'
			throw MapError.keyNotFound
		end 'namesNoBareGeneric'

		match self.scopedGenericInstanceOf(self.nameOfId(typeNameIdOf(declared)), declaringTypeName: layout.name, scopeParamNames: layout.typeParamNames) 'scoped'
			notInScope then throw MapError.keyNotFound
			instance(gid) then return MaxonType.genericInstance(gid)
		end 'scoped'
	end 'sweptScopedGenericFieldTypeOf'

	// The return-type wrapper of the test above: a `void` return names no type to re-tag.
	function sweptInterfaceReturnOf(declared MaxonReturnType, declFilePath FilePath) returns MaxonType throws MapError
		match declared 'shape'
			void then throw MapError.keyNotFound
			value(inner) then return try self.sweptInterfaceTypeOf(inner, readerFilePath: declFilePath)
		end 'shape'
	end 'sweptInterfaceReturnOf'

	// The `contestScopedDeclaredType` wrapper of the same shape — the return-type slot's spelling, resolved
	// against the file that DECLARED the function. See `funcReturnDeclFiles` for the wrong answer this
	// closes.
	function contestScopedReturnType(declared MaxonReturnType, declFilePath FilePath) returns MaxonType throws MapError
		match declared 'shape'
			void then throw MapError.keyNotFound
			value(inner) then return try self.contestScopedDeclaredType(inner, slotScopeFilePath: declFilePath)
		end 'shape'
	end 'contestScopedReturnType'

	// One union case's payload slots, rewritten by the rule above. Split out because a payload array is
	// replaced wholesale (`PayloadField` holds `let` columns), where a struct field column is retyped in place.
	function revisedLayoutWithRecordedPayloads(rule RecordedReturnTypeRule, layout EnumLayout) returns EnumLayout throws AbsentError
		let rewrites = PayloadFieldArrayArray.create(layout.caseCount(), zeroed: false)
		let claimed = BoolArray.create(layout.caseCount(), zeroed: false)
		var anyClaimed = false

		for caseIndex in 0 upto layout.caseCount() 'eachCase'
			let (rewritten, changed) = self.rewrittenPayloadsOf(rule, layout: layout, caseIndex: caseIndex)
			rewrites.push(rewritten)
			claimed.push(changed)
			anyClaimed = anyClaimed or changed
		end 'eachCase'

		if not anyClaimed 'nothingToRewrite'
			throw AbsentError.absent
		end 'nothingToRewrite'

		let revised = layout.clone()

		for caseIndex in 0 upto layout.caseCount() 'eachRevisedCase'
			let isClaimed = try claimed.get(caseIndex) otherwise panic("ProgramSignatures.revisedLayoutWithRecordedPayloads: claimed.get OOB at {caseIndex} below the case count")

			if isClaimed 'aClaimedCase'
				revised.retypeCasePayloads(caseIndex, payloads: try rewrites.get(caseIndex) otherwise panic("ProgramSignatures.revisedLayoutWithRecordedPayloads: rewrites.get OOB at {caseIndex} below the case count"))
			end 'aClaimedCase'
		end 'eachRevisedCase'

		return revised
	end 'revisedLayoutWithRecordedPayloads'

	function rewrittenPayloadsOf(rule RecordedReturnTypeRule, layout EnumLayout, caseIndex CaseIndex) returns (PayloadFieldArray, bool)
		let payloads = layout.payloadsAt(caseIndex)
		let rewritten = PayloadFieldArray.create(payloads.count(), zeroed: false)
		var changed = false

		for field in payloads 'eachSlot'
			if let resolved = try self.rewrittenSlotTypeUnder(rule, declared: field.declaredType, slotScopeFilePath: layout.declFilePath) 'theRuleClaimsIt'
				rewritten.push(PayloadField.create(field.name, declaredType: resolved, declaredSurface: field.declaredSurface, declaredBrand: self.sharedInstanceMintOr(field.declaredBrand, readerFilePath: layout.declFilePath, fallback: field.declaredBrand), capability: field.capability, typeSite: field.typeSite))
				changed = true
			end 'theRuleClaimsIt' else 'unchanged'
				rewritten.push(field)
			end 'unchanged'
		end 'eachSlot'

		return (rewritten, changed)
	end 'rewrittenPayloadsOf'

	// The declaration identity a recorded `named` or `function` type should carry, or the instance a recorded
	// instance should be, resolved against the file that declared the SLOT — or `MapError` when the recorded
	// type already is that, which is every declared type in every program in the corpus.
	//
	// ⚠ **THE SCOPE FILE IS THE SLOT'S DECLARING FILE AND NEVER A READER'S**, exactly as `declaredSlotType`'s
	// is: a field belongs to the file that wrote it, and a compiler-synthesized layout carries
	// `CompilerOwnedDeclFilePath`, which declares no alias and so resolves like a stranger — the tier-2/3
	// answer, which is the same answer for all of them.
	//
	// ⛔⛔ **A TUPLE'S ELEMENT IS *NOT* ONE OF THOSE.** A tuple is STRUCTURAL — the same spelling in two
	// files is ONE type — but its canonical name is derived from its RESOLVED elements, so two files
	// that mean the same thing by `(Bag, Num)` resolve to identical element types and land on ONE
	// name: structural identity is preserved BY per-file resolution, not despite it. Two files that
	// mean different things by `Bag` were never spelling one type, and a stranger's reading would be a
	// THIRD answer agreeing with neither file — the file that declared both `Bag` and `Pair = (Bag,
	// Num)` could not construct its own field (E3005, see `canonicalTupleElement`). A tuple layout
	// carries the file that SPELLED it (`tupleStructLayout`), so this pass re-scopes a sweep-minted
	// element list against that file like any other slot.
	function contestScopedDeclaredType(declared MaxonType, slotScopeFilePath FilePath) returns MaxonType throws MapError
		if maxonTypeTag(declared) == ValueTypeTag.genericInstance 'anInstanceSpelledWithAliases'
			let scoped = self.fileScopedInstance(genericInstanceIdOf(declared), filePath: slotScopeFilePath)

			if scoped == genericInstanceIdOf(declared) 'alreadyThisFilesInstance'
				throw MapError.keyNotFound
			end 'alreadyThisFilesInstance'

			return MaxonType.genericInstance(scoped)
		end 'anInstanceSpelledWithAliases'

		let tag = maxonTypeTag(declared)

		if tag != ValueTypeTag.function and tag != ValueTypeTag.named 'namesNoAlias'
			throw MapError.keyNotFound
		end 'namesNoAlias'

		let name = self.nameOfId(typeNameIdOf(declared))
		let identity = self.declaredIdentityOfSpelling(name, declFilePath: slotScopeFilePath)

		if identity.equals(name) or not self.identityStandsForEveryReader(name, identity: identity) 'noIdentityOfItsOwn'
			throw MapError.keyNotFound
		end 'noIdentityOfItsOwn'

		let identityId = self.typeNames.intern(identity)
		return MaxonType.function(identityId) if tag == ValueTypeTag.function else MaxonType.named(identityId)
	end 'contestScopedDeclaredType'

	// ⭐⭐ **THE TYPE A SPAWN'S PROMISE IS BORN WITH — `Promise with T` / `Promise with (T, E)` read off
	// the CALLEE.** `Parser.emitAsyncCall` mints its result at this instance, which is what makes every
	// integer position refuse a promise through the type check it already has, rather than through a roster
	// of positions somebody had to remember to write down.
	//
	// ⭐ **IT INTERNS IN THE INDEX'S OWN NAME SPACE, AND THAT IS THE WHOLE CORRECTNESS ARGUMENT.**
	// `genericInstances.intern` is keyed on `(typeNameId, args)`, so the gid a spawn gets must be the SAME
	// gid a user's `typealias IntPromise = Promise with Integer` resolves to — otherwise a spawn could not be
	// stored in the storage type that names it, and `promiseStorageThrows` would answer about one instance
	// while the await asked about another. Interning here, off `returnTypeOf`'s raw swept types and this
	// index's own `typeNames`, is what makes the two keys equal by construction instead of by coincidence.
	//
	// ⚠ **THE RESULT POSITION IS ALWAYS FILLED** — see `PromiseVoidResultName` for why a void thunk gets a
	// stand-in argument rather than a shorter instance.
	export function internPromiseInstanceForCallee(callee ByteArray) returns GenericInstanceId
		let result = try self.declaredReturnTypeOf(callee, into: self.typeNames) otherwise panic("internPromiseInstanceForCallee: '{String.from(callee)}' is declared by no file — `Parser.emitAsyncCall` mints such a spawn a deferred value and asks for no instance")

		return self.internPromiseInstanceReturning(result, callee: callee)
	end 'internPromiseInstanceForCallee'

	export function promiseAwaits(gid GenericInstanceId, returnType MaxonReturnType) returns bool
		return maxonTypesDenoteSame(self.substitutedInstanceArg(gid, position: PromiseResultArgPosition), b: self.promiseResultArgFor(returnType))
	end 'promiseAwaits'

	export function internPromiseInstanceReturning(result MaxonReturnType, callee ByteArray) returns GenericInstanceId
		return self.internPromiseInstanceOver(self.promiseResultArgFor(result), callee: callee)
	end 'internPromiseInstanceReturning'

	function internPromiseInstanceOver(resultArg MaxonType, callee ByteArray) returns GenericInstanceId
		let args = MaxonTypeArray.create(0)
		args.push(resultArg)

		let clause = self.throwsOf(callee)

		if throwsClauseIsThrowing(clause) 'throwing'
			let errorName = (try throwsClauseName(clause) otherwise panic("internPromiseInstanceOver: a clause `throwsClauseIsThrowing` accepted carries a name")).toByteArray()
			args.push(MaxonType.named(self.typeNames.intern(errorName)))
		end 'throwing'

		return self.internRow(self.typeNames.intern(PromiseTypeName), args: args)
	end 'internPromiseInstanceOver'

	// ⭐⭐ **THE TYPE A SERVICE REPLY'S CELL IS BORN WITH — `Promise with (T, E)` READ OFF THE
	// MESSAGE.** `Parser.mintServiceReplyCell` mints its cell at this instance, which is what makes
	// every integer position refuse a reply through the type check it already has: `return h.total()`
	// is E3005, `p + 1` is E2004, `takesInt(h.total())` is E3005 and `p.clone()` is E2015, none of
	// them enumerated
	// anywhere — the argument the spawn road rests on too.
	//
	// ⭐ **AND THE RESULT IS THE INSTANTIATION'S, NOT THE DECLARATION'S.** A generic service's
	// `peek() returns T` declares an opaque word; what comes back is whatever the `spawn` fixed `T` to, and
	// the cell is the only thing the AWAIT still holds when it needs to know — so the substitution happens
	// here, once, where the promise type is minted.
	export function internPromiseInstanceForReply(messageKey ByteArray, serviceInstance ServiceStateInstance) returns GenericInstanceId
		let result = try self.declaredReturnTypeOf(messageKey, into: self.typeNames) otherwise panic("internPromiseInstanceForReply: `{String.from(messageKey)}` declares no return type — a reply cell is minted for a declared message only")

		return self.internPromiseInstanceOver(self.replyResultArgThrough(self.promiseResultArgFor(result), messageKey: messageKey, serviceInstance: serviceInstance), callee: messageKey)
	end 'internPromiseInstanceForReply'

	// The result argument as the spawned instantiation fixes it. `promiseAggregateArgAsName` is re-applied
	// because the substitution can hand back a `structRef` where the opaque parameter was neither — see its
	// own header for the duplicate-definition that tag split cost.
	function replyResultArgThrough(arg MaxonType, messageKey ByteArray, serviceInstance ServiceStateInstance) returns MaxonType
		return self.promiseAggregateArgAsName(self.instanceResolvedSlotType(arg, declFilePath: self.recordedReturnDeclFileOf(messageKey), instance: serviceInstance))
	end 'replyResultArgThrough'

	// ⭐⭐⭐ **A DECLARED SLOT TYPE AS ONE INSTANTIATION FIXES IT — THE ONE HOME, because THREE sites read it
	// and each of them types one end of a service's reply.** The cell the send mints
	// (`internPromiseInstanceForReply`), the handler result `__behave` calls for
	// (`ServiceBehaviour.serviceHandlerReturnType`) and the value the await hands back
	// (`Parser.fixedReplyResultType`) are one type seen from three tiers; a depth this answered differently
	// at any of them is a reply the awaiter reads at a type the handler did not produce.
	//
	// ⛔⛔ **IT RESOLVES BEFORE IT SUBSTITUTES, AND THAT ORDER IS THE WHOLE OF WHAT WAS MISSING.**
	// `substituteThroughInstance` rewrites a `typeParameter` and recurses into a `genericInstance`'s
	// arguments — and passes a `named` LEAF through untouched, which is exactly how an INNER ALIAS arrives
	// (`export function all() returns TArray`, on `typealias TArray = Array with T`, is recorded as
	// `named("Box.TArray")`). MEASURED: the reply's own promise type rendered as
	// `Promise with (Box.TArray, MathError)` — an instantiation-free spelling no caller can name, which
	// made the correct storage type `E3005` against a type the source cannot write.
	//
	// ⚠ **A MONOMORPHIC SERVICE IS THE IDENTITY, DELIBERATELY.** There is no instantiation to fix anything,
	// so resolving here would move a type on a road this function does not own — every reply of every
	// non-generic service is typed exactly as it was.
	export function instanceResolvedSlotType(t MaxonType, declFilePath FilePath, instance ServiceStateInstance) returns MaxonType
		return match instance 'i'
			monomorphic gives t
			at(id) gives self.substituteThroughInstanceInterned(self.declaredSlotType(t, into: self.typeNames, slotScopeFilePath: declFilePath), id: id, interner: self.typeNames)
		end 'i'
	end 'instanceResolvedSlotType'

	// ⭐ **ONE INSTANCE OVER ANOTHER'S TYPE ARGUMENTS** — how a service's `<T>.handle` and its state box come
	// to name the same instantiation without either deriving it a second time from the source.
	export function internInstanceOverArgsOf(baseName ByteArray, likeInstance GenericInstanceId) returns GenericInstanceId
		return self.internGenericInstanceOf(baseName, args: self.rowArgs(likeInstance).clone())
	end 'internInstanceOverArgsOf'

	// The instance a bare generic base takes over `args` — the door a `spawn` interns its target through,
	// where a `typealias` reaches `recordGenericAlias` instead.
	export function internGenericInstanceOf(baseName ByteArray, args MaxonTypeArray) returns GenericInstanceId
		return self.internRow(self.typeNames.intern(baseName), args: args)
	end 'internGenericInstanceOf'

	// The result TYPE ARGUMENT for a promise over a thunk returning `returnType`. Split out so the void
	// stand-in has exactly one home; see `PromiseVoidResultName`.
	function promiseResultArgFor(returnType MaxonReturnType) returns MaxonType
		return match returnType 'r'
			void gives MaxonType.named(self.typeNames.intern(PromiseVoidResultName))
			value(inner) gives promiseAggregateArgAsName(inner)
		end 'r'
	end 'promiseResultArgFor'

	// ⛔⛔ **A DECLARED-TYPE RESULT CROSSES INTO THE INSTANCE AS A `named` LEAF, AND THAT IS THE WHOLE OF
	// WHAT MAKES THE TWO ROADS ONE INSTANCE (E3006).**
	//
	// `internPromiseInstanceForCallee`'s header rests the storage rule on the gid a `spawn` or a send gets
	// being the SAME gid an author's `typealias P = Promise with (T, E)` resolves to — and `intern`'s key is
	// the argument's whole `MaxonType`, TAG INCLUDED, not just its name id. A declared `returns Payload`
	// arrives from `returnTypes` tagged `structRef`; the same `Payload` written as a type ARGUMENT arrives
	// from the alias sweep tagged `named`. Two tags, ONE name id, and `mangleTypeArg` renders both as
	// `Payload` — so the two roads interned two instances that compile to one symbol, which is exactly the
	// pair collision `checkTypeSymbolNamespace` reports.
	//
	// ⚠ **MEASURED: it made every record-valued reply unstorable.** `typealias R = Promise with (Payload,
	// MathError)` beside a `spawn` was `error E3006: duplicate definition of
	// 'Promise_Payload_MathError' — the generic instantiations `Promise with (Payload, MathError)` and
	// `Promise with (Payload, MathError)` compile to that same name` — one sentence naming one type
	// twice, on a program with one of each. A SCALAR result never showed it: an `Integer` argument carries no
	// name and so no second tag, which is why the whole committed `Promise with (Integer, …)` family is green
	// over it.
	//
	// ⭐ **THE NAME SIDE IS UNCHANGED, so nothing emitted moves.** `mangleTypeArg` already answers with the
	// name for both tags (`tagMayNameAggregate`), so this re-tagging cannot rename a symbol or a
	// descriptor — it only stops one type being interned twice.
	function promiseAggregateArgAsName(inner MaxonType) returns MaxonType
		if not tagNamesADeclaredType(maxonTypeTag(inner)) 'namesNoDeclaredType'
			return inner
		end 'namesNoDeclaredType'

		return MaxonType.named(typeNameIdOf(inner))
	end 'promiseAggregateArgAsName'

	export function internSynthesizedByteInstance() returns GenericInstanceId
		let args = MaxonTypeArray.create(1, zeroed: false)
		args.push(MaxonType.named(self.typeNames.intern(SynthesizedByteElementName)))
		return self.internRow(self.typeNames.intern(self.arrayRecordBaseName()), args: args)
	end 'internSynthesizedByteInstance'

	// ⭐⭐ **WHICH `Array` INSTANCE A `__ManagedMemory.create(count, elementSize)` YIELDS** — the one
	// place the raw `elementSize` the source writes becomes a STATIC element type, and the reason it has to:
	// `mm.get(0)` and `mm.set(0, value: 300)` are typed off the instance's element, so `300` fits at element
	// size 8 and does not at 1 (`specs/managed-memory-builtin.md:setlength-then-get` writes exactly that).
	//
	// ⚠ **THE SPLIT IS `1 ⇒ Byte, ANYTHING ELSE ⇒ WORD`.** That is what the `element_size` field this size
	// lands in means: `sizeof(Element)`, 1 for `Byte` and 8 otherwise. ⚠ It is NOT the whole of what
	// `trivialElementSlot` can answer —
	// since `enum-narrow-storage` that ladder also hands out 2 and 4 for a narrow enum element — it is the
	// whole of what a source `elementSize` may NAME here, and the paragraph below is why.
	//
	// ⚠ **IT DELIBERATELY REFUSES NOTHING, INCLUDING A NON-POSITIVE SIZE.** `managed-memory-methods`'s
	// `managed-memory-error-variants` requires `__ManagedMemory.create(4, 0)` to COMPILE and report
	// `invalidAllocation` at RUN TIME — the buffer's own guard (`__managed_mem_create`) is where a size the
	// allocator cannot use is caught, and hoisting that into a parse-time refusal would turn a case the corpus
	// pins as a caught throw into a compile error. Which instance a doomed `create` was typed as is unobservable.
	//
	// ⚠⚠ **PRECONDITION: `managedMemoryElementSizeIsTypeable`.** It has no arm for a width the compiler has no element
	// type of, because there is no honest one — see that predicate for the wrong answer a missing `else`
	// gives.
	//
	// ⚠ **THE BYTE ARM IS SCOPED TO THE FILE THAT WROTE THE `create`**, which is what lets
	// `stdlib/File.maxon:71`'s `__ManagedMemory.create(size + extraBytes, 1)` be a genuinely byte-PACKED
	// buffer in a program whose own `Byte` is two bytes wide. A whole-program width gives that
	// buffer stride 2, and `file.read(managed, …)` three lines later refuses it — in a program that never
	// mentions `File`.
	//
	// ⚠⚠ **AND WHERE THE SCOPING CANNOT SAVE IT, THE CALLER NOW REFUSES.** A file that declares its own
	// wide `Byte` AND writes `create(n, 1)` asks for a byte-PACKED record — `__managed_mem_create` stamps
	// `element_size@24` from that argument — under the `Array with Byte` this arm hands back, which strides
	// what that same file declared. The two disagreed silently: `set(0, value: 300)` read back **44**. This
	// arm still answers, because the refusal is about the DISAGREEMENT and must name the instance it is
	// about; `Parser.requireManagedMemoryElementSize` is where it is raised, beside its two siblings.
	export function managedMemoryInstanceForElementSize(elementSize FullRangeInt, readerFilePath FilePath) returns GenericInstanceId
		if elementSize == ByteStringElementSize 'bytePacked'
			return self.internArrayByteInstance(readerFilePath)
		end 'bytePacked'

		return self.managedMemoryWordInstance()
	end 'managedMemoryInstanceForElementSize'

	export function managedMemoryWordInstance() returns GenericInstanceId
		return self.builtinInstanceForElement(self.arrayRecordBaseName(), element: self.libraryAliasType(FullRangeIntAliasName, into: self.typeNames))
	end 'managedMemoryWordInstance'

	// ⭐⭐ **CAN the compiler GIVE A BUFFER OF THIS ELEMENT WIDTH A TYPE AT ALL?** The gate the answer
	// above needs in front of it, reading the same two constants so the ACCEPTED set and the MAPPED set cannot
	// come to differ.
	//
	// ⚠ **A WIDTH WITH NO ELEMENT TYPE IS A SILENT WRONG ANSWER, NOT A ROUNDING, AND IT WAS MEASURED.** The
	// front end types `get`/`set` off the INSTANCE while the runtime strides by the record's `element_size@24`,
	// so a `create(4, elementSize: 4)` — typed as the machine-WORD instance, because that was the whole `else`
	// — accepted `mm.set(0, value: 5000000000)` against `int`'s range and stored four bytes of it:
	// `mm.get(0)` read back **705032704**. The two facts about one buffer disagreed, quietly, at run time.
	// ⇒ a source `elementSize` may name exactly the two widths this door can TYPE — a byte or a machine word —
	// because the width it names has to become a `MaxonType` for `get`/`set` to be typed off, and those are the
	// two the compiler has a binding for (`Byte`, `int`). ⚠ **THAT IS A BINDING GAP AND NOT A WIDTH GAP, AND SINCE
	// `enum-narrow-storage` THE DIFFERENCE IS REAL**: the element ladder now produces 2 and 4 for a narrow enum
	// element, so a 2- or 4-byte element TYPE exists — what does not exist is a way for `__ManagedMemory.create`
	// to name one, since a bare `elementSize: 2` says a width and never which type wears it. A diagnostic saying
	// so stays the honest answer until this door takes an element type rather than a number.
	//
	// ⚠ A NON-POSITIVE size is admitted, for the reason above: `create(4, 0)` must compile and throw
	// `invalidAllocation` at run time, and which instance a doomed `create` wore is unobservable.
	export function managedMemoryElementSizeIsTypeable(elementSize FullRangeInt) returns bool
		return elementSize <= ByteStringElementSize or elementSize == ManagedMemoryWordElementSize
	end 'managedMemoryElementSizeIsTypeable'

	// ⭐ **THE ONE-TYPE-ARGUMENT CONTAINER INSTANCE FOR AN ELEMENT TYPE NO TYPEALIAS NAMES.** A bare
	// `["a","b"]` / `[p1,p2]`, a `Set from ["…"]` and a `List from [p1, p2]` all build a container whose
	// element type is fixed by the ARRAY LITERAL rather than by a `typealias`, so the SWEEP over-interns the
	// possible element instances (`internLiteralContainerInstances`) and the parser looks up whichever the
	// first element resolves to. Idempotent, so the sweep is the WRITE and the parser a pure READ.
	//
	// ⚠ **IT IS ONE FUNCTION BECAUSE THE THREE CONTAINERS ARE ONE FACT** — per container it would be
	// three identical lines differing only in the base name. The KEYING is the load-bearing part (a
	// String as `MaxonType.string`, so a literal-built container and a typealias-backed one of the
	// same element share ONE gid), and it is exactly what a per-container copy would be free to get
	// subtly wrong.
	//
	// ⭐ **IT TAKES THE ELEMENT AS A RESOLVED `MaxonType`, NOT AS A NAME**, because `List from […]` reads its
	// element straight off the SOURCE ARRAY's instance (`containerElementType`) — already `MaxonType.string`
	// for a String, `named(<id>)` for a struct, a canonicalized `structRef` for a tuple. Going back through a
	// NAME would re-derive the `structRef`-vs-`named` choice `builtinInstanceForNamedElement` carries a
	// measured E3006 about, from an answer that already has it right.
	//
	// ⭐ **`asSpeculative` RIDES THROUGH TO THE REGISTRY'S MARK** (see `GenericInstanceRegistry.intern`).
	// It defaults to false — what every ordinary caller means, and the safe direction for one that forgets it,
	// since a genuine row is only ever mistaken for a guess by saying so explicitly. The sole `true` is
	// `internAggregateElementInstances`, whose whole output is guesses.
	export function builtinInstanceForElement(baseName ByteArray, element MaxonType, asSpeculative bool = false) returns GenericInstanceId
		let args = MaxonTypeArray.create(1, zeroed: false)
		args.push(self.canonicalInstanceArg(element))
		return self.internRow(self.typeNames.intern(baseName), args: args, asSpeculative: asSpeculative)
	end 'builtinInstanceForElement'

	// ⭐⭐ **ONE DECLARED STRUCT MUST REACH THE INTERN KEY IN ONE SPELLING — `named`, WHICH IS
	// `namedElementType`'s ANSWER AND THEREFORE THE CONVENTION.** `structRef` is the RESOLVED form of a
	// `named` that turned out to name a declared `type` (`TypeResolution.resolveNamedType`), so the two
	// DENOTE the same type while `GenericInstanceRegistry.instanceKey` — which compares the raw `(tag, id)`
	// — reads them as two. Two instances, one `mangleGenericInstance` (it reads only the NAME) ⇒ the exact
	// `E3006 duplicate definition of 'Array_<T>'` that `builtinInstanceForNamedElement`'s header measures for
	// the tuple spelling, arrived at from the other side.
	//
	// ⛔ A TOP-LEVEL map literal (`var table = [b"if": Info.create(…), …]`) has the const tier type its value
	// column from the factory's recorded return type — already `structRef` — where a body's `[…]` literal types
	// the same struct through `namedElementType` and gets `named`. The map's column arrays are interned from
	// those column types, so without this `Array with Info` exists twice once any `[<identifier>…]` literal
	// elsewhere makes the sweep intern the `named` one: `E3006 duplicate definition of 'Array_Info'`. The two
	// tiers are made to agree here, at the one door that builds a container's type arguments.
	//
	// ⚠ **A TUPLE'S `structRef` IS THE CANONICAL ONE AND IS LEFT ALONE** — `namedElementType`'s own split,
	// read back through the same `isTupleTypeName` predicate so the two cannot drift. A synthesized tuple has
	// no declaration to resolve `named` from, which is exactly why it is spelled `structRef` there.
	export function canonicalInstanceArg(arg MaxonType) returns MaxonType
		if maxonTypeTag(arg) != ValueTypeTag.structRef 'notAResolvedStruct'
			return arg
		end 'notAResolvedStruct'

		let nameId = typeNameIdOf(arg)
		return arg if internedNameIsATupleTypeName(self.typeNames, id: nameId) else MaxonType.named(nameId)
	end 'canonicalInstanceArg'

	// ⭐ **THE TWO-TYPE-ARGUMENT CONTAINER INSTANCE — the `Map` twin of `builtinInstanceForElement`.** A
	// `["a": 1]` literal fixes BOTH of its columns from its first pair, exactly as a `[…]` literal fixes its
	// element from its first element, so the same "the parser looks up whichever the source resolves to"
	// shape needs a door that takes two. The argument ORDER is the instance's identity — `HashTableKeyArgPosition`
	// then `MapValueArgPosition`, which `mapKeyType`/`mapValueType` read back — so the two are named parameters
	// rather than an array a caller could fill in the wrong order.
	export function builtinInstanceForColumns(baseName ByteArray, key MaxonType, value MaxonType) returns GenericInstanceId
		let args = MaxonTypeArray.create(2, zeroed: false)
		args.push(self.canonicalInstanceArg(key))
		args.push(self.canonicalInstanceArg(value))
		return self.internRow(self.typeNames.intern(baseName), args: args)
	end 'builtinInstanceForColumns'

	// ⭐⭐ **THE ELEMENT ARG MUST CARRY THE TAG A TYPE REFERENCE TO THAT NAME CARRIES**, because the
	// instance registry keys on `(tag, id)` while `mangleGenericInstance` reads only the NAME. Two tags for
	// one type therefore intern as TWO instances that compile to ONE symbol — which
	// `checkTypeSymbolNamespace` reports as `E3006 duplicate definition of 'Array_<T>'`, naming a
	// `typealias` the author wrote exactly once.
	//
	// A declared struct/union is `named` — that is what `Array with Item`'s alias arg is, which is why a
	// `[<Item>…]` literal and `ItemArray` have always been one type. A synthesized TUPLE is `structRef`:
	// `Parser.parseTypeReference` mints a tuple type that way at every spelling (`(Num, Num)`, and a tuple
	// `typealias` through `tupleAliasTargetFrom`), so `named` here would be a SECOND spelling of one type with
	// nothing to make the two agree. MEASURED: `typealias PairArray = Array with Pair` plus any
	// `[<identifier>…]` literal in the program was rejected with that spurious E3006.
	export function builtinInstanceForNamedElement(baseName ByteArray, element ByteArray, asSpeculative bool = false) returns GenericInstanceId
		return self.builtinInstanceForElement(baseName, element: self.namedElementType(element), asSpeculative: asSpeculative)
	end 'builtinInstanceForNamedElement'

	// The rule above, as the `MaxonType` itself — split out because a container ARGUMENT is not the only thing
	// that has to obey it: `Parser.literalColumnTypeFor` names the same type for a bracketed literal's column
	// and would otherwise carry a second copy of the tuple test, which is the exact shape the measured E3006
	// above came from.
	//
	// ⭐⭐ **A NAME THE PARSER SETTLES SYNTACTICALLY IS ANSWERED WITH THAT BUILTIN'S OWN ARM, NEVER WITH
	// `named`** — the tuple arm's identical defect, two types over, and the only reason it is not live today
	// is that the corpus's own `type String` / `type Character` are not listed yet.
	// `Parser.parseTypeReference` settles both names to `MaxonType.string` / `MaxonType.character` and NEVER
	// to `named`, so every type reference the source writes carries the builtin arm — while
	// `internAggregateElementInstances` over-interns one instance per name in `structSlots`, and the moment
	// those modules are listed those two names are IN it. A `named` answer here therefore minted a SECOND gid
	// for a type the parser already had, and `mangleTypeArg` reads only the NAME
	// (`primitiveTypeTagName(ValueTypeTag.character)` is literally `"Character"`), so the two gids compiled to
	// one symbol.
	//
	// ⇒ MEASURED on this tree, against `helpers/string/views.maxon` and `Character.maxon`:
	// `typealias CharArray = Array with Character` plus any `[<identifier>…]` literal was rejected with
	// **E3006 duplicate definition of 'Array_Character'**, blaming a `typealias` written once against an
	// instantiation appearing nowhere in the source. `String` is the same collision by the same route and
	// could not be driven to it at the time only because `stdlib/String.maxon` stopped parsing earlier — so
	// both arms landed together rather than leaving the twin for whoever cleared that wall to rediscover.
	//
	// Ahead of the tuple test because neither name can be a tuple's: `isTupleTypeName` keys on the reserved
	// `__Tuple` spelling, which E2051 bars a declaration from taking.
	//
	// ⚠ **NOT ROUTED THROUGH `TypeResolution.builtinTypeNameTag`, WHICH IS THE NEIGHBOURING TABLE ANSWERING A
	// DIFFERENT QUESTION.** That one serves the INTERNER-FREE REBUILD doors (a rendered interface return
	// string, a function typealias's stored `(tag, name)` pair), so it admits `ExitCode` — a name
	// `parseTypeReference` does NOT settle, which reaches here as `named` and must STAY `named`.
	// `denotedNamedType` draws the same line from the other side, admitting that one arm of the table and
	// refusing the rest for exactly this reason. It also carries no `Character` arm, so reusing it would have
	// cured `String` and left the twin.
	export function namedElementType(element ByteArray) returns MaxonType
		if element.equals(StringConformerName) 'theStringBuiltin'
			return MaxonType.string
		end 'theStringBuiltin'

		if element.equals(CharacterConformerName) 'theCharacterBuiltin'
			return MaxonType.character
		end 'theCharacterBuiltin'

		let elementId = self.typeNames.intern(element)
		return MaxonType.structRef(elementId) if isTupleTypeName(element) else MaxonType.named(elementId)
	end 'namedElementType'

	// ⭐⭐ **THE FUNCTION-VALUED TWIN OF `namedElementType`, AND IT EXISTS FOR THAT ONE'S STATED REASON: THE
	// INTERNER.** A container instance's type arguments live in THIS index's interner, and a `function` element
	// carries a `TypeNameId` like every other named type — so a caller holding only the parser's FILE-LOCAL id
	// cannot build the argument itself. It must hand over the NAME and let the registry that owns the ids do
	// the interning, exactly as the `named`/`structRef` arm above does.
	//
	// ⛔ **MEASURED, not defensive.** `Parser.literalColumnTypeFor` first built `MaxonType.function(<the
	// parser's own id>)` directly. The id was a valid id in the WRONG interner, so `[double, triple]` interned
	// an instance whose element named whatever that number meant here — and reading an element back out of it
	// (`ops.get(1)` then calling it) reported the governing name as **'Array'** and PANICKED
	// `functionValueReturnType`. It compiled and parsed cleanly right up to the call; nothing but running it
	// says which interner an id came from.
	export function functionElementType(element ByteArray) returns MaxonType
		return MaxonType.function(self.typeNames.intern(element))
	end 'functionElementType'

	// ⭐⭐ **THE NAME BEHIND A `function` TYPE THAT LIVES IN *THIS INDEX'S* SPACE — the read side of the door
	// above, and the crossing point for every caller holding an index-space type.** A function type is
	// governed by a NAME (see `MaxonType`'s `function` arm), the whole-program shape lookups are keyed by that
	// name, and `ProgramSignatures.typeNames` is a different table from `project.typeNames` with its own
	// insertion order — so an id from here means whatever name happens to sit at that number THERE. The rule
	// this states, once, for both readers: **names travel between interners; ids never do.**
	//
	// ⛔⛔ **BOTH READERS WERE CAUGHT BY IT, ONE LOUDLY AND ONE SILENTLY, WHICH IS WHY IT IS ONE DOOR.**
	//   • The CONTAINER COLUMN read a parser file-local id here and reported the governing name as `'Array'`,
	//     panicking `requireFunctionShapeOf` — a crash, so it was found immediately.
	//   • `SemanticCheck.checkTypeParameterArgsAt`'s SUBSTITUTED type argument read an index-space id through
	//     the PROJECT registry and worked, because the two tables happened to agree at that number. PROVEN by
	//     sabotage rather than by the passing case: `generic-type-parameter-slots.function-value-element`
	//     reaches the line with `id=3`, and id 3 is `UnaryOp` in both tables for that program. A read that is
	//     correct only while two independent insertion orders coincide is a wrong answer waiting for a third
	//     declaration, and no green case can tell the two apart.
	//
	// It is named for the SPACE and not for a caller ("container column" was its first name, and the second
	// caller is not a column) because the space is the whole of what it settles.
	// ⭐⭐ **THIS INDEX'S OWN NAME TABLE — for a caller holding a LAYOUT the index interned, whose field-type
	// ids therefore index this table and not the project's.** The reader below answers for ONE type; a
	// cascade walk resolves a whole layout's worth through a shared router that takes the interner as a
	// parameter (`managedFieldDropCallee`, `managedFieldCascadeStrategy`), and that parameter is the only
	// honest way to say which space the caller is in.
	//
	// ⛔⛔ **IT EXISTS BECAUSE THE TUPLE WALK RESOLVED FIELD TYPES AGAINST THE WRONG INTERNER.**
	// `MmRuntime.installStructRuntimeEntries` walks `project.structTypes` AND
	// `ProgramSignatures.tupleLayouts()` into one installer, and the installer resolved every field type
	// against `project.typeNames` — which is right for the first walk and a different table's number for
	// the second. MEASURED on this compiler's own source: the tuple `__Tuple2.Array_Byte.GlobalAliasReturnInfo`
	// has a `structRef` field at id 814, and id 814 in the PROJECT's table is `InstantNanos` — a ranged
	// alias — so the destructor synthesis panicked *"'InstantNanos' is a ranged typealias, a scalar, which
	// `typeIsManaged` never classifies managed"* on a field that is a struct. A misread that lands on a
	// DECLARED type instead would have emitted the wrong destructor silently, which is the half of #56 the
	// panic exists to keep unrepresentable.
	export function indexTypeNames() returns TypeNameInterner
		return self.typeNames
	end 'indexTypeNames'

	export function indexSpaceTypeName(indexSpaceType MaxonType) returns immutable ByteArray
		return try self.typeNames.nameOf(typeNameIdOf(indexSpaceType)) otherwise panic("ProgramSignatures.indexSpaceTypeName: type-name id {typeNameIdOf(indexSpaceType)} is not in this index's interner — a container column's type argument and an instance's substituted argument are both interned HERE, so an id that misses came from another table and every name it could answer would be the wrong one")
	end 'indexSpaceTypeName'

	// ⭐ **THE ALIAS AN INDEX-SPACE TYPE ARGUMENT SPELLS, or EMPTY for one that spells nothing** — the third
	// reader of the door above, and the one that made its name honest. A refusal naming a SCALAR type argument
	// owes the author's `typealias` (`Integer`) and not the class word its tag resolves to (`int`): it is the
	// same `declaredName` piece a CONCRETE parameter hands `paramDisplayName` off `sig.paramDeclaredNames`,
	// read for a type ARGUMENT instead. The message says `expected 'Integer'`, never `expected 'int'`.
	//
	// ⚠ **IT IS NOT `instanceArgDisplayName`, WHICH IS THE FULL DISPLAY RULE AND IS FAILURE-PATH ONLY** — that
	// one goes through `mangleTypeArg`, a `String` build plus a `toByteArray`, on the strength of *"a path that
	// only a REJECTED program reaches"*. Its caller here is reached by EVERY substituted scalar argument in the
	// program, so it reads the interned leaf directly: one dense read, no allocation. The two cannot disagree
	// about a `named` leaf — a ranged alias's compiled name IS its declared name — and every arg they would
	// disagree about (a nested instance, an opaque parameter) carries a nominal identity and is judged, and
	// spelled, by the arm above this one.
	export function indexScalarAliasName(indexSpaceType MaxonType) returns immutable ByteArray
		if maxonTypeTag(indexSpaceType) != ValueTypeTag.named 'spellsNoAlias'
			return EmptySourceText
		end 'spellsNoAlias'

		return self.indexSpaceTypeName(indexSpaceType)
	end 'indexScalarAliasName'

	// Over-intern `<base> with <T>` for the possible element types of an array literal whose elements the
	// sweep's tokens cannot name: a local identifier's type is unknowable there, so
	// `<base> with String` and one instance per declared struct/union are interned, and the parser looks up
	// whichever the first element resolves to. An UNREFERENCED instance gets no descriptor or destructor
	// synthesized (both gate on usage), so this is bounded registry entries — not codegen — and it leaves
	// int-only-array programs' emitted code untouched.
	//
	// ⚠ **TWO BASES ASK IT, and both ask it about the SAME literal.** An `[<identifier>…]` gives its `Array`
	// instance; a `List from [<identifier>…]` gives the `List` its members build, whose element type is the one
	// the FIRST member fixes (`Parser.parseListMemberList` asks `literalColumnTypeFor` for it, the same door
	// `arrayLiteralInstanceFor` asks) — so the names needed are identical by construction. One walk, told which
	// base: a second copy under a `List` name would have re-derived the whole measured asymptotic below, and
	// its `sawX` gate, for the same set.
	//
	// ⚠ **`List from […]` BUILDS NO INTERMEDIATE `Array`**, so there is no source array whose element type is
	// read back.
	// ⚠ **CALLED ONCE, AFTER THE LAST FILE FOLDS — NOT PER FILE, and that is a MEASURED asymptotic and not a
	// tidy-up.** The struct/union tables ACCUMULATE across the sweep, so a walk placed at each
	// `[<identifier>…]`-bearing file re-walks every type folded so far, at every such file: **O(files × types)**.
	// A dedup set inside the walk makes the *interning* O(types) — but not the WALK, whose
	// per-entry cost (a `MapIterator` entry tuple, a set probe) is paid whether or not the name is new. The
	// early-out that guards it is a count-equality that any freshly folded type defeats, so the common shape
	// — every file declaring a type AND using an array literal — defeats it at every file.
	//
	// ⇒ MEASURED, on 64→1024 files each declaring one `type S<k>` and holding one `[<identifier>…]` literal:
	//   `phase signatures` allocations went **×2.16, ×2.38, ×2.68, ×3.03** per DOUBLING (exact column, so this
	//   is not noise), against ×1.99 flat for the same files with no declared type. Hoisted here it reads
	//   ×1.99 flat. A tuple layout is registered under a mangled name, which makes tuples a SECOND producer
	//   of registered types and so a second way onto this ladder.
	//
	// ⚠ **THE HOIST IS SAFE, BUT IT IS NOT AN IDENTITY — IT CHANGES TWO THINGS, AND EACH HAS ITS OWN REASON
	// FOR BEING HARMLESS.** It does NOT "intern the identical SET":
	//
	//   • **THE SET GROWS.** Placed inside the sweep, the walk could only see the types folded SO FAR, so a
	//     struct/union declared in a file AFTER the last `[<identifier>…]`-bearing one was never over-interned
	//     at all. One final walk sees the whole program. The extra rows are registry entries and nothing more —
	//     a descriptor and a destructor are both synthesized on USAGE, and an over-interned instance nobody
	//     names has none — so the growth is bounded bookkeeping and reaches no emitted byte.
	//     ⛔ **"REACHES NO EMITTED BYTE" IS NOT "HARMLESS", AND THE DIFFERENCE WAS A WRONG REFUSAL.** A
	//     row here is also read by `instanceWithTypeArgKind`, whose copy gate REFUSES on it — which is why
	//     each row now carries whether anything NAMED it. See `internAggregateElementInstances`.
	//   • **THE GIDS MOVE.** A gid is intern ORDER, and these interns now all happen after the last file folds
	//     instead of interleaved with it, so every over-interned instance's gid shifts. Nothing DERIVES from a
	//     gid's numeric value — `mangleGenericInstance` is structural (base name + arg manglings) precisely so
	//     that a symbol is stable across cold and warm builds — and the one reader that walks the registry in
	//     gid order (`ParseStaging.checkTypeSymbolNamespace`) uses it only to decide which of a COLLIDING pair
	//     is blamed as the newcomer.
	//
	// What the hoist does rest on is that nothing between the sweep's last fold and this call READS a generic
	// instance — the sweep only records — so no reader can observe the difference between "interned early" and
	// "interned here".
	export function internLiteralContainerInstances()
		if self.sawAggregateArrayLiteral 'aggregateArrayLiteral'
			self.internAggregateElementInstances(self.arrayRecordBaseName())
		end 'aggregateArrayLiteral'

		// A `List from […]` needs the same set one base over: the construction's element type is the SOURCE
		// ARRAY's, which is exactly one of the names walked above. `List with integer` and `List with String`
		// are interned beside it by `internWellKnownContainerInstances`, as the `Set from` arm does — this
		// walk is the aggregate half, and only it needs every declared type.
		if self.sawListFromConstruction 'listFromConstruction'
			self.internAggregateElementInstances(ListBuiltinBaseName)
		end 'listFromConstruction'

		// `<Enum>.allCases` needs the ENUM half of that same set and nothing else — a case value is never a
		// struct and never a String — so it asks for the enum loop rather than for the whole walk.
		if self.sawEnumAllCasesAccess 'enumAllCases'
			self.internEnumElementInstances(self.arrayRecordBaseName())
		end 'enumAllCases'
	end 'internLiteralContainerInstances'

	// ⭐⭐⭐ **THE INSTANCES THE COMPILER MINTS BECAUSE THE SOURCE NAMED NO TYPE FOR THEM — ONCE PER PROGRAM,
	// AFTER THE STDLIB/USER CONTEST.** A `[…]`, a `b"…"`, a `.bytes()`, a `Set`/`List`/`FixedArray from […]`
	// and the three compiler-owned types all produce a value whose type no declaration in the program spells,
	// so the sweep interns it and the parser reads the giid back — the sweep-WRITES / parser-READS discipline
	// `internBuiltinIntegerInstance` states.
	//
	// ⚠⚠ **THE POSITION IS A CORRECTNESS ONE AND NOT A COST ONE, WHICH IS WHAT SEPARATES IT FROM
	// `internLiteralContainerInstances` ABOVE.** Run at the END OF EACH FILE'S FOLD instead, these interns
	// are wrong. The array-record arms take their base from `arrayRecordBaseName`, whose spelling the contest
	// may MOVE (`contestStdlibTypeName`), and the contest is decided BETWEEN the user and stdlib halves of the
	// sweep — so a user file asks before the answer exists and files a PROGRAM-WIDE memo
	// (`bareArrayByteInstance`) under the pre-contest bare name. In a program declaring its own `type Array`
	// that name is the PROGRAM's container: `b"Hi!".isEmpty()` is refused as a member the program's array
	// does not have. ⇒ ONE call, after both halves have folded, needs nothing derived a second time and
	// leaves the contest where it is.
	//
	// ⚠ **THE GIDS MOVE, AND THAT IS THE HOIST ABOVE'S ARGUMENT VERBATIM** — a gid is intern ORDER, nothing
	// derives from its numeric value (`mangleGenericInstance` is structural), and the sweep only RECORDS
	// between its last fold and this call, so no reader can observe "interned per file" from "interned here".
	// It runs BEFORE `settleRangeScopedInstances` because the file-scoped split reads these
	// instances, and the bare byte instance is the one every file-scoped answer is derived from.
	export function internWellKnownContainerInstances()
		if self.sawIntArrayLiteral 'intArrayLiteral'
			_ = self.internBuiltinIntegerInstance(self.arrayRecordBaseName())
		end 'intArrayLiteral'

		if self.sawByteStringLiteral 'byteStringLiteral'
			_ = self.bareArrayByteInstance()
		end 'byteStringLiteral'

		// The machine-word `__ManagedMemory` instance beside the byte one, because
		// `__ManagedMemory.create(n, elementSize: 8)` picks it (`managedMemoryInstanceForElementSize`) and the
		// parser may only READ the registry, never be the first to write it. It is OVER-interned (a file merely
		// NAMING `__ManagedMemory` registers the alias): over-register rather than miss.
		if self.settledDeclarations().genericAliases.contains(ManagedMemoryTypeName) 'managedMemoryNamed'
			_ = self.managedMemoryWordInstance()
		end 'managedMemoryNamed'

		if self.sawStringArrayLiteral 'stringArrayLiteral'
			_ = self.builtinInstanceForElement(self.arrayRecordBaseName(), element: MaxonType.string)
		end 'stringArrayLiteral'

		// A `Set from […]` infers its key type from the source array literal, which the sweep cannot see, so
		// BOTH well-known keys are over-interned and the parser reads back whichever the array resolves to —
		// exactly as `internLiteralContainerInstances` over-interns the array's own possible elements.
		if self.sawSetFromConstruction 'setFromConstruction'
			_ = self.internBuiltinIntegerInstance(SetBuiltinBaseName)
			_ = self.builtinInstanceForElement(SetBuiltinBaseName, element: MaxonType.string)
		end 'setFromConstruction'

		// The `List from […]` twin. Its declared-type half is the aggregate walk one function up, which needs
		// the whole type registry; these two scalars need only the base name.
		if self.sawListFromConstruction 'listFromConstruction'
			_ = self.internBuiltinIntegerInstance(ListBuiltinBaseName)
			_ = self.builtinInstanceForElement(ListBuiltinBaseName, element: MaxonType.string)
		end 'listFromConstruction'

		// PER SIZE, because a fixed array's size is half of its instance's identity, and over the three scalar
		// element types a literal can give one; a managed element's instance is minted by the parse
		// (`Parser.parseFixedArrayFromConstruction`), so there is no String or aggregate half to intern.
		for size in self.settledDeclarations().fixedArrayFromSizes 'eachFixedArraySize'
			_ = self.fixedArrayInstanceForElement(MaxonType.integer, size: size)
			_ = self.fixedArrayInstanceForElement(MaxonType.float, size: size)
			_ = self.fixedArrayInstanceForElement(MaxonType.boolean, size: size)
		end 'eachFixedArraySize'

		self.internAliasedFixedArrayLiteralArrays()

		// The three compiler-owned TYPES ride the same call, and for this function's own reason:
		// `registerManagedFileType`, `registerManagedDirectoryType` and `registerManagedSocketType` intern the
		// byte and word array instances themselves, so leaving them in the per-file fold would have left half
		// the defect in place.
		if self.sawManagedFileProducer 'managedFileProducer'
			self.registerManagedFileType()
		end 'managedFileProducer'

		if self.sawManagedDirectoryProducer 'managedDirectoryProducer'
			self.registerManagedDirectoryType()
		end 'managedDirectoryProducer'

		if self.sawManagedSocketProducer 'managedSocketProducer'
			self.registerManagedSocketType()
		end 'managedSocketProducer'

		if self.sawManagedHostResourceProducer 'managedHostResourceProducer'
			self.registerManagedHostResourceTypes()
		end 'managedHostResourceProducer'
	end 'internWellKnownContainerInstances'

	// ⛔⛔ **EVERY ROW THIS WALK MINTS IS A GUESS, AND ONE READER TOOK THEM FOR FACTS.** The header above
	// argues the rows are harmless because "a descriptor and a destructor are both synthesized on USAGE, and
	// an over-interned instance nobody names has none — so the growth is bounded bookkeeping and reaches no
	// emitted byte". That is true of EMISSION and beside the point for DIAGNOSIS:
	// `instanceWithTypeArgKind` walks this same registry, and the copy gate it serves
	// (`genericTypeFieldUncopyableInstantiation` ⇒ `Parser.requireOpaqueArrayCopyable`) reads a row as
	// evidence that the program CONTAINS an array of that element — then REFUSES on it.
	//
	// ⇒ MEASURED once `stdlib/Array.maxon`, `File.maxon` and `Directory.maxon` are listed. This walk minted
	// `Array with FileWriter`, `Array with FileReader`, `Array with Directory` and `Array with ArrayIterator`
	// — four uncopyable elements, none of them named by any program — and any ONE
	// of them refused `Array.clone`'s own `managed.slice` (`stdlib/Array.maxon:142`) for the WHOLE program.
	// `map.md`'s `literal.user-type-key` and `literal.user-type-key-escapes-its-builder` were rejected with a
	// sentence about `Box with String` on programs mentioning no `Box`, no file and no `CharacterSet`; a map
	// literal whose keys are a user struct is what puts the IDENTIFIER after the `[` that triggers the walk.
	//
	// The rows still have to exist — that is what this walk is for, and narrowing WHICH types it guesses at
	// would only move the line. So they are minted as before and MARKED instead: the registry records that
	// nothing named them (`GenericInstanceRegistry.speculative`), a later named intern clears the mark, and
	// the one gate that refuses skips what is still only a candidate.
	function internAggregateElementInstances(baseName ByteArray)
		self.requireWholeProgramIndex("internAggregateElementInstances")

		_ = self.builtinInstanceForElement(baseName, element: MaxonType.string, asSpeculative: true)

		for (name, _) in self.structSlots 'eachStruct'
			_ = self.builtinInstanceForNamedElement(baseName, element: name, asSpeculative: true)
		end 'eachStruct'

		self.internEnumElementInstances(baseName)
	end 'internAggregateElementInstances'

	// The ENUM half of the walk above, split out because `<Enum>.allCases` needs exactly it and nothing else.
	// SPECULATIVE for the walk's stated reason: every row is a guess about which enum was meant, and a guess
	// read as evidence that the program CONTAINS such an array is what the ⛔⛔ block above records. A real
	// `.allCases` read interns its own instance NAMED (`Parser.emitEnumAllCases`), which clears the mark on
	// the one row that was not a guess.
	function internEnumElementInstances(baseName ByteArray)
		for (name, _) in self.settledDeclarations().enumTypes 'eachEnum'
			_ = self.builtinInstanceForNamedElement(baseName, element: name, asSpeculative: true)
		end 'eachEnum'
	end 'internEnumElementInstances'

	// ⭐ **THE `Array` INSTANCE BEHIND EACH `FixedArray` ALIAS A `from` HEAD NAMES.** `Vec3 from [1, 2, 3]` builds
	// its record as an array literal at the alias's element and retypes it (`Parser.parseAliasedFixedArrayLiteral`),
	// and no declaration names that array — so it is interned here, before any parse reads it back.
	// SPECULATIVE because a head name is matched against every alias declaration of that name in any file; the
	// parse's own read confirms the one it uses.
	function internAliasedFixedArrayLiteralArrays()
		if self.settledDeclarations().fromHeadNames.count() == 0 'noFromHeads'
			return
		end 'noFromHeads'

		for i in 0 upto self.settledDeclarations().genericAliasDecls.count() 'eachAliasDecl'
			let decl = try self.settledDeclarations().genericAliasDecls.get(i) otherwise panic("internAliasedFixedArrayLiteralArrays: genericAliasDecls.get({i}) failed inside its own upto bound")
			let giid = decl.internedInstance()

			if self.settledDeclarations().fromHeadNames.contains(decl.aliasName) and self.isFixedArrayInstance(giid) 'aFixedArrayAliasHead'
				_ = self.builtinInstanceForElement(self.arrayRecordBaseName(), element: self.containerElementType(giid), asSpeculative: true)
			end 'aFixedArrayAliasHead'
		end 'eachAliasDecl'
	end 'internAliasedFixedArrayLiteralArrays'

	// ⭐⭐ **WHAT ONE FILE'S TOKENS SAY THE PROGRAM WILL MATERIALIZE — recorded, never acted on.** THE
	// one door the sweep files a well-known instance need through, so no arm can be half-moved back into the
	// per-file fold and no need can be noted twice under two spellings. Every parameter is a bit the sweep
	// already holds as a local at the one point it calls this; the whole answer is a union across files, which
	// is why each is OR-ed in rather than assigned.
	//
	// ⚠ **TEN PARAMETERS AND NOT TEN FUNCTIONS**: ten one-line setters is ten chances to add an
	// eleventh need and wire it at nine of the ten call sites. There is exactly one call site, so a need that
	// is not passed does not compile.
	export function noteWellKnownInstanceNeeds(intArrayLiteral bool, byteStringLiteral bool, stringArrayLiteral bool, aggregateArrayLiteral bool, enumAllCasesAccess bool, setFromConstruction bool, listFromConstruction bool, fixedArraySizes FixedSizeArray, headNames NameRoster, managedFileProducer bool, managedDirectoryProducer bool, managedSocketProducer bool, managedHostResourceProducer bool)
		self.sawIntArrayLiteral = self.sawIntArrayLiteral or intArrayLiteral
		self.sawByteStringLiteral = self.sawByteStringLiteral or byteStringLiteral
		self.sawStringArrayLiteral = self.sawStringArrayLiteral or stringArrayLiteral
		self.sawAggregateArrayLiteral = self.sawAggregateArrayLiteral or aggregateArrayLiteral
		self.sawEnumAllCasesAccess = self.sawEnumAllCasesAccess or enumAllCasesAccess
		self.sawSetFromConstruction = self.sawSetFromConstruction or setFromConstruction
		self.sawListFromConstruction = self.sawListFromConstruction or listFromConstruction
		self.sawManagedFileProducer = self.sawManagedFileProducer or managedFileProducer
		self.sawManagedDirectoryProducer = self.sawManagedDirectoryProducer or managedDirectoryProducer
		self.sawManagedSocketProducer = self.sawManagedSocketProducer or managedSocketProducer
		self.sawManagedHostResourceProducer = self.sawManagedHostResourceProducer or managedHostResourceProducer

		for size in fixedArraySizes 'eachFixedArraySize'
			self.mainThreadSettled().fixedArrayFromSizes.push(size)
		end 'eachFixedArraySize'

		for name in headNames 'eachFromHead'
			self.mainThreadSettled().fromHeadNames.insert(name)
		end 'eachFromHead'
	end 'noteWellKnownInstanceNeeds'

	// --- Layout-descriptor sizing ---
	//
	// The box byteSize of a concrete generic instance — its BASE struct's own layout (`Box with Integer`
	// has `Box`'s box), or the fixed 48-byte record for an `Array` (which has no base struct). A `T`
	// field is an opaque 8-byte slot like any other, so no argument is substituted into the layout and
	// the base struct's `sizeBytes` IS the instance's box size. This is the descriptor's `size@0` field, and
	// the interner-owning door lowering computes it through.
	export function genericInstanceBoxSize(id GenericInstanceId) returns ByteOffset
		if self.isManagedBufferRecordInstance(id) 'managedBuffer'
			return ManagedRecordBytes as ByteOffset
		end 'managedBuffer'

		// A `__ManagedList` instance's box is the fixed chain header `__list_create` allocates (see
		// `ManagedListBuiltinBaseName`); a declared `List`, `Set` or `Map` box is its base `StructLayout`'s.
		if self.isManagedListInstance(id) 'managedList'
			return ListRecordBytes as ByteOffset
		end 'managedList'

		// A node handle IS the node, so its "box" is the node the chain allocated — 40 bytes of `next`, `prev`,
		// `value`, `element_drop` and `owner`.
		if self.isManagedListNodeInstance(id) 'managedListNode'
			return ListNodeBytes as ByteOffset
		end 'managedListNode'

		// A cursor's box is its own 16-byte record — `source@0` plus `position@8`, and nothing else, because
		// it reads the source's `buffer`/`length`/`element_size` LIVE (see `ManagedMemoryRuntime.CursorRecordBytes`).
		if self.isManagedMemoryCursorInstance(id) 'managedMemoryCursor'
			return CursorRecordBytes as ByteOffset
		end 'managedMemoryCursor'

		match self.structInAnyFile(self.genericInstanceBaseName(id)) 'base'
			declared(layout) then return layout.sizeBytes()
			undeclared then panic("genericInstanceBoxSize: generic instance {id}'s base '{String.from(self.genericInstanceBaseName(id))}' is neither a builtin nor a declared struct, so it has no box — every caller opens with genericInstanceBaseIsKnown")
		end 'base'
	end 'genericInstanceBoxSize'

	export function genericInstanceArgLogicalSize(id GenericInstanceId, position ElementIndex) returns ByteOffset
		return self.typeLogicalByteSize(self.descriptorArgumentAt(id, position: position))
	end 'genericInstanceArgLogicalSize'

	// The canonical argument, the form `containerElementType` hands `arrayElementSize`, so a descriptor's
	// size and stride describe the same type the array's own create stamps.
	function descriptorArgumentAt(id GenericInstanceId, position ElementIndex) returns MaxonType
		let arg = self.canonicalInstanceArgAt(id, position: position)

		if self.typeIsBuiltOnATypeParameter(arg) 'aParametricArgument'
			panic("descriptorArgumentAt: argument {position} of instance {id} is built on a type parameter, so it has no size or stride to write into a descriptor")
		end 'aParametricArgument'

		return arg
	end 'descriptorArgumentAt'

	// The full source-level byte size of a type argument, resolved against THIS index's own interner. A
	// declared struct (stored `named` by the sweep, which does not resolve `structRef`) is its full box; a
	// nested generic instance is its base box; a `named` that is not a struct is a ranged alias (a machine
	// word); every other type is its `primitiveTypeByteSize`.
	//
	// ⚠ **THIS IS THE LOGICAL SIZE — `elementLogicalSize@56`, what `sizeof(T)` reads inside a shared
	// generic body — and it is NOT the array element STRIDE.** A ranged alias is a machine word here even
	// where `arrayElementSize` strides it in one byte, because the two answer different questions and the
	// descriptor header says so (`elementSize@16` vs `elementLogicalSize@56`, "DISTINCT and must stay so").
	// It must keep agreeing with the parser's concrete fold, `Parser.concreteSizeofBytes`, which sizes an
	// already-RESOLVED type and so cannot see an alias's bounds at all: narrowing here and not there made
	// `sizeof(T)` for `Sizer with Byte` answer 1 while `sizeof(Byte)` in the same program answered 8.
	function typeLogicalByteSize(t MaxonType) returns ByteOffset
		let tag = maxonTypeTag(t)

		if tagMayNameAggregate(tag) 'namedOrStruct'
			// ⭐⭐ **RESOLVED THROUGH `denotedAggregateName` — a TYPE ARGUMENT is a RAW stored
			// type, so this door reads a spelling no re-tag has passed over.** An instance's argument is
			// interned once, by whichever pass first met `Sizer with Pair`, and the declaration SWEEP meets it
			// with `parseTypeReference`'s tuple-alias arm answering `isTupleAliasInAnyFile("Pair")` — which is false
			// until the alias's OWN file is walked. So `args[0]` is `named("Pair")` when the two files arrive
			// in one order and `structRef(<the tuple>)` when they arrive in the other, and nothing downstream
			// re-tags it: `genericInstanceArgLogicalSize` hands it straight here.
			//
			// ⚠ **MEASURED** — the same two-file program staged in both walk orders: `sizeof(T)`
			// inside `Sizer with Pair` (`typealias Pair = (Integer, Integer)`) returned **16** with the alias
			// file walked first and **8** with it walked last. Both compiled, both ran, and the wrong one is
			// baked into `.rdata` as `elementLogicalSize@56` — a silent wrong ANSWER, not a diagnostic. The
			// unresolved name simply missed `structOf` and fell to `primitiveTypeByteSize(named)`, the
			// machine-word fallback that exists for an enum/union.
			match self.structInAnyFile(self.denotedSlotAggregateName(t)) 'lookup'
				declared(layout) then return layout.sizeBytes()
				undeclared then return primitiveTypeByteSize(tag)
			end 'lookup'
		end 'namedOrStruct'

		if tag == ValueTypeTag.genericInstance 'nested'
			return self.genericInstanceBoxSize(genericInstanceIdOf(t))
		end 'nested'

		return primitiveTypeByteSize(tag)
	end 'typeLogicalByteSize'

	// A structural, BUILD-STABLE mangling of a type argument for a descriptor's `.rdata` label —
	// `bool` ⇒ "bool", a declared `Pair` ⇒ "Pair", a nested `Box with Integer` ⇒ "Box_Integer". It is
	// derived from the argument's STRUCTURE (base name + args), never from a gid number, so the label is
	// identical across cold and warm builds (a gid's numeric value is a build-order artifact).
	//
	// ⭐ **THE CLAIM IS TOTAL.** The `namedOrStruct` arm answers a `structRef` NAMING A NESTED TUPLE
	// with the tuple's own NAME, and a tuple's name cites a nested element by a digest of the nested
	// tuple's own name (`ProgramSignatures.tupleElementTokenFor`), which is a pure function of the
	// program's structure and identical across cold and warm builds and across walk orders, so a tuple
	// argument satisfies the rule for the same reason every other tag does.
	//
	// ⚠ **THAT ARM IS UNPINNED.** No `TargetIr` pin carries such a label, so nothing here would go red
	// if the arm regressed. Absence of a red is not evidence that the arm cannot be reached.
	export function mangleTypeArg(t MaxonType) returns String
		let tag = maxonTypeTag(t)

		// ⚠ The NAME is read raw and NOT through `denotedSlotAggregateName`: this label must be the argument's
		// SOURCE spelling, and canonicalizing a tuple alias here would rename an emitted symbol. Only the TAG
		// question is shared.
		if tagMayNameAggregate(tag) 'namedOrStruct'
			return String.from(self.nameOfId(typeNameIdOf(t)))
		end 'namedOrStruct'

		if tag == ValueTypeTag.genericInstance 'nested'
			return String.from(self.mangleGenericInstance(genericInstanceIdOf(t)))
		end 'nested'

		// An OPAQUE type-parameter argument (`Array with T` inside a generic body) — its
		// instance `Array with <that parameter>` is interned like any other, so its structural mangling names
		// the parameter by its own TOKEN, which is a pure function of `(declaring type, parameter name)` and
		// therefore identical across cold and warm builds and across walk orders — the same property this
		// function's header demands of every other arm.
		//
		// ⛔ **A SPELLED POSITION (`T0`) WOULD BE THE COLLISION ITSELF WEARING A NAME.**
		// `HoldA`'s `Array with U` and `HoldB`'s `Array with V` both mangled to `Array_T0` — and, worse, both
		// built the same `instanceKey`, so they were not two names for two types but ONE interned type. See
		// `typeParamTokenFor`.
		//
		// Rendered in HEX, the same `0-9a-f` `tupleElementTokenFor` spells its digest in and for its reason:
		// the alphabet holds no `.` and no `#`, so the token cannot disturb the tuple element join or the
		// minted-name join, and it is injective in the id, which is all a lookup key needs. It is
		// only ever a LOOKUP key (the opaque array never gets a synthesized `__destruct_<mangled>` nor its own
		// descriptor — it drops through `__managed_decref` and reads the enclosing instance's descriptor), and no
		// `TargetIr` pin carries such a label.
		if tag == ValueTypeTag.typeParameter 'opaqueParam'
			return "T{(typeNameIdOf(t) as FullRangeInt):x}"
		end 'opaqueParam'

		// A `Promise` instance's result argument is the one position an interface type is interned at: a
		// service reply held at one (`internPromiseInstanceForReply`). A promise has no descriptor, so its
		// argument is spelled here as a name and never reaches descriptor labelling.
		if tag == ValueTypeTag.interfaceRef 'anInterface'
			return String.from(self.nameOfId(typeNameIdOf(t)))
		end 'anInterface'

		return primitiveTypeTagName(tag)
	end 'mangleTypeArg'

	// ⭐ **THE CANONICAL CONFORMER NAME OF A TYPE ARGUMENT.** A ranged int/float alias
	// (`Integer` = `int(0 to u32.max)`) collapses to its underlying primitive name (`int`) — the name its
	// INTRINSIC conformance (`int` implements `Hashable`/`Equatable`) and its witness table (`__witness_int.*`
	// → the synthesized `int.hash`/`int.equals` impls) are keyed by; a struct/String keeps its own name. The
	// ONE reducer shared by the E3017 where-constraint check (`typeConformsTo`) and witness-table
	// materialization (`materializeWitnessArg`), so the conformance lookup, the table label, and the impl
	// symbol cannot disagree on whether a `Box with Integer` conforms via `int`. Distinct from
	// `instanceArgDisplayName`, which keeps the SOURCE spelling (`Integer`) for the E3017 MESSAGE — this
	// canonicalizes only the identity the comparison rests on.
	export function conformerTypeArgName(gid GenericInstanceId, position ElementIndex) returns String
		// An instance's stored ARGUMENT was interned by this index, so its ids are this index's own.
		return self.conformerNameOfType(self.substitutedInstanceArg(gid, position: position), idsFrom: self.typeNames, readerFilePath: CompilerOwnedDeclFilePath)
	end 'conformerTypeArgName'

	// ⭐⭐ **THE INSTANCE THAT SAME ARGUMENT NAMES, WHEN IT NAMES ONE** — `conformerTypeArgName`'s
	// twin, and it has to be its twin: the name answers WHICH CONFORMANCE and this answers WHICH
	// INSTANTIATION, and a witness table for a dictionary-carrying conformance is keyed by both
	// (`LowerMaxonToStd.witnessTableInstanceFor`). Two spellings of "is this argument an instance?" is exactly
	// the shape that let one of them say no.
	//
	// ⛔⛔ **IT SAID NO FOR AN INSTANCE WRITTEN AS A `typealias`, AND THAT WAS A REFUSAL OF A LEGAL PROGRAM.**
	// The lowering asked only the TAG: a `Wrap with (Cur with Small, Small)` written inline carries the
	// argument as a `genericInstance` and got its per-instance table, while the identical program written
	// `typealias SmallCur = Cur with Small` … `Wrap with (SmallCur, Small)` carries it as a declared NAME,
	// reduced to the shared table — whose adapter then hands `Cur.current` a null dictionary, refused with
	// E3128. **MEASURED: the inline spelling compiles and answers 7; the alias spelling is refused.** The name
	// half never had that hole because it goes through `conformerNameOfType`, which resolves an aggregate tag
	// through the interner; this is that same resolution for the instance half.
	//
	// ⚠ **IT RESOLVES AGAINST THIS INDEX'S OWN INTERNER, WHICH IS WHY IT LIVES HERE AND NOT AT THE CALL
	// SITE.** A stored instance argument's `named`/`structRef` id is THIS index's; the lowering's
	// `project.typeNames` is a different id space, and resolving one against the other answers with whatever
	// name happens to sit at that number (`conformerNameOfType`'s header records the measured refusal that
	// produced).
	//
	// An argument that names no instance at all — `int`, a plain struct, a type parameter — THROWS, which is
	// the same "there is no instance here" answer `instanceOfDeclaredName` gives for a name that is not one.
	export function conformerTypeArgInstance(gid GenericInstanceId, position ElementIndex) returns GenericInstanceId throws MapError
		let arg = self.substitutedInstanceArg(gid, position: position)

		if maxonTypeTag(arg) == ValueTypeTag.genericInstance 'anInstanceById'
			return genericInstanceIdOf(arg)
		end 'anInstanceById'

		if not tagMayNameAggregate(maxonTypeTag(arg)) 'namesNoDeclaration'
			throw MapError.keyNotFound
		end 'namesNoDeclaration'

		return try self.instanceOfDeclaredName(try self.typeNames.nameOf(typeNameIdOf(arg)) otherwise panic("conformerTypeArgInstance: type-name id {typeNameIdOf(arg)} is not in this index's interner — an instance's stored argument was interned by this index, so its ids are this index's own"))
	end 'conformerTypeArgInstance'

	// ⭐ **THE CANONICAL CONFORMER NAME A TYPE REDUCES TO — the key every conformance answer, every
	// `__witness_<conformer>.<Iface>` label and every `<conformer>.<method>` impl symbol is filed under.**
	// Split out of `conformerTypeArgName` when the EXISTENTIAL widening doors needed the same reduction of a
	// type they hold DIRECTLY rather than of a generic instance's argument: a
	// value passed to an interface-typed parameter has a `MaxonType`, not a `(gid, position)`. Two spellings
	// of "which conformer is this?" would let a widening accept a type whose witness table is filed under a
	// name the lowering then fails to find.
	// ⚠⚠ **IT TAKES THE INTERNER THE TYPE'S IDS LIVE IN, AND THAT IS A CORRECTNESS PARAMETER RATHER THAN A
	// CONVENIENCE.** A `named`/`structRef` carries a PER-INTERNER id, and this index's table and the
	// PROJECT's are two different id spaces (the sweep builds one, `mergeArtifact` folds the artifacts' into
	// the other). Its two callers hold different ones: an instance's stored argument was interned HERE, while
	// an existential widening holds a value type whose ids were remapped project-global. Resolving a project
	// id against this index's table answers with whatever name happens to sit at that number — MEASURED, in
	// exactly the shape a whole-program answer fails in: `interface-param-declared-after-consumer` refused a
	// legal `X64Query implements OpQuery` because the two tables had interned in different orders.
	export function conformerNameOfType(t MaxonType, idsFrom TypeNameInterner, readerFilePath FilePath) returns String
		// The id-bearing arms are resolved against the CALLER's interner and then re-asked of this index BY
		// NAME — the same "names travel, ids do not" discipline `adoptType` states in full. Every other arm
		// (a primitive, a `GenericInstanceId`, a type-parameter TOKEN — a source-text digest) carries no
		// per-interner id, so it goes to the shared mangler untouched.
		if tagMayNameAggregate(maxonTypeTag(t)) 'namesAnAggregate'
			let name = try idsFrom.nameOf(typeNameIdOf(t)) otherwise panic("conformerNameOfType: type-name id {typeNameIdOf(t)} is not in the interner it was resolved against — pass the interner this type's ids live in")
			return self.conformerNameOfDeclaredName(name, readerFilePath: readerFilePath)
		end 'namesAnAggregate'

		// ⭐⭐ **EVERY CONFORMING `Array with E` REDUCES TO THE ONE CONFORMER `Array` (array-hashable)** — the
		// generic-instance analogue of `Integer` reducing to `int`, and it rests on the same property: the
		// impls it names are ELEMENT-INDEPENDENT. `Array.hash`/`Array.equals` walk the backing buffer's raw
		// bytes (`stdlib/Array.maxon:632-664`), so one pair of `.text` symbols and one pair of
		// `__witness_Array.*` tables answer for every array in the program, whatever it holds — where a
		// per-instance conformer name would mint an identical body per element type.
		//
		// ⚠⚠ **AND THE REDUCTION IS CONDITIONAL, WHICH IS THE WHOLE OF HOW A CONDITIONAL CONFORMANCE SURVIVES
		// A NAME-KEYED CONFORMANCE MODEL.** An `Array with <non-conforming element>` keeps its MANGLED
		// instance name, which no `implements` and no intrinsic row claims — so `where T is Hashable` refuses
		// it through the ordinary E3017 door, with no second predicate anywhere to keep in step. It is why
		// `isIntrinsicBuiltinConformance`'s `Array` arm may answer unconditionally.
		//
		// ⚠ The id-bearing arms above are settled first: this asks about a `genericInstance`, whose id is a
		// `GenericInstanceId` in THIS index's registry and carries no per-interner name.
		// ⚠ The TAG guard is spelled here rather than through `isArrayInstanceAt` because the conjunction
		// continues into the conformance half: routing it through that door would ask `isArrayInstance` twice
		// over one id. It is the same two-part test and the same reason for it — a `TypeNameId` and a
		// `GenericInstanceId` share a numeric space, so the tag is what makes the id question meaningful.
		if maxonTypeTag(t) == ValueTypeTag.genericInstance 'anInstance'
			// The UNREDUCED fallback here is the mangled instance name — a name no `implements` and no
			// intrinsic row claims — which is exactly how a non-conforming `Array with E` goes on being
			// refused through the ordinary E3017 door. This door holds no source spelling to answer with.
			match self.instanceConformerReduction(genericInstanceIdOf(t)) 'reduction'
				arrayBuiltin then return String.from(self.arrayRecordBaseName())
				declaredBase(baseName) then return String.from(baseName)
				unreduced then return self.mangleTypeArg(t)
			end 'reduction'
		end 'anInstance'

		return self.mangleTypeArg(t)
	end 'conformerNameOfType'

	// ⭐⭐ **THE CONFORMER NAME OF A GENERIC INSTANCE — the ONE answer, for the two doors that arrive with
	// different things in hand.** `conformerNameOfType` holds a resolved `genericInstance`;
	// `conformerNameOfDeclaredName` holds the NAME of a generic-instance typealias. That split is exactly the
	// one `instanceConformerReduction`'s array arm already exists for, and the reduction below has to live on
	// both sides of it for the same measured reason — see the note there.
	//
	// ⭐ **A DECLARED GENERIC REDUCES TO ITS BASE, because under dictionary-passing its conformance is a
	// property of the DECLARATION and its impls are ONE shared body.** `type MapIterator uses Key, Value
	// implements Iterator with Entry` compiles `MapIterator.current` once, over an opaque layout, and every
	// instantiation dispatches into that one symbol — so one `__witness_MapIterator.Iterator` table answers
	// for all of them, exactly as one `__witness_Array.*` pair answers for every array. A per-instance
	// conformer name would mint an identical table per instantiation AND, worse, name a conformer that no
	// `implements` clause claims: the registry is keyed by the DECLARED struct name, so a mangled instance
	// name misses it and a legal program is refused.
	//
	// ⚠ **MEASURED, on a program with no stdlib in it at all**: `type Wrapper uses T implements Named` +
	// `type Holder uses N where N is Named` + `Holder with (Wrapper with Integer)` is refused at `HEAD` with
	// *"E3017: Type 'IntWrapper' does not satisfy constraint 'Named' required by type parameter 'N' of
	// 'Holder'"* and runs here, printing `wrapped`. It is what `stdlib/Map.maxon`'s `Iterable` conformance
	// dies on too, one instance in — `WithIterIterator with (MapIterator with (Key, Value), …)`.
	//
	// ⚠⚠ **THE `where` CONSTRAINTS OF THE BASE ARE NOT WAIVED BY THIS, AND THAT IS WHY IT MAY BE
	// UNCONDITIONAL WHERE THE `Array` ARM IS NOT.** `MapIterator` carries its own `where Key is Hashable`, and
	// that clause is checked at the `MapIterator with (K, V)` instantiation SITE by `checkOneInstantiation`,
	// which walks every site in the program. The question here is a different one — *"does this declaration
	// implement that interface"* — and the answer to it does not depend on the arguments. `Array`'s arm is
	// conditional because `Array` has no declaration to read a `where` clause off: The compiler synthesizes it, so
	// its conditional conformance has nowhere else to live.
	//
	// A BUILTIN base (`Array`, `Set`, `List`, a `Map` while it is still synthesized) has no `StructLayout` to
	// declare anything, so it keeps the mangled name it always had and the arms above stay authoritative.
	// ⭐ **EXPORTED FOR `TypeCycleCheck.addInstanceConformerEdges`, WHICH MUST WALK THE VERY NODE A VALUE OF
	// AN INSTANCE WIDENS FROM.** That check credits an interface's conformers as graph edges, and a generic
	// base is a SINK there — its field types are opaque type parameters — while the argument that can close a
	// cycle lives in the instance. Asking the reduction rather than re-deriving it is what keeps "may this
	// value stand at that interface" and "what may that interface's field hold" one answer.
	//
	// ⚠ **THE CASE MATTERS TO THAT READER TOO, NOT ONLY THE NAME**: an `unreduced` instance conforms to
	// nothing, so it contributes no edge — the same fallback the diagnostic half needs, for a different reason.
	//
	// ⚠ **IT ANSWERS THE REDUCTION, NOT THE NAME, AND THE DIFFERENCE IS A DIAGNOSTIC THAT REGRESSED WHEN IT
	// DID ANSWER THE NAME.** The two doors share the RULE and emphatically do not share the FALLBACK: an
	// unreduced instance is its MANGLED name at `conformerNameOfType` (which holds no source spelling) and its
	// ALIAS's own name at `conformerNameOfDeclaredName` (which does, and whose name reaches an author).
	// MEASURED, with a single `String` return folding the two: `array-conditional-conformance-withheld`'s
	// nested case began reporting *"but 'Array_Opaque' does not implement 'Hashable'"* where the corpus pins
	// *"but 'OpaqueArr' does not implement 'Hashable'"* — the compiler's mangling shown to someone who wrote
	// a typealias. So the miss is a CASE the caller must handle, not a default this may pick.
	export function instanceConformerReduction(id GenericInstanceId) returns GenericInstanceConformer
		// ⛔⛔ **AN ARRAY IS DECIDED BY ITS `where` CLAUSE AND MAY NEVER FALL THROUGH TO `declaredBase`.**
		// The paragraph above rests on `Array` having no `StructLayout` — *"a BUILTIN base has no StructLayout
		// to declare anything, so it keeps the mangled name it always had"* — and listing `stdlib/Array.maxon`
		// ENDED that. `structInAnyFile("Array")` now answers `declared`, so a NON-conforming `Array with Opaque`
		// stopped falling through to `unreduced` and collapsed to the conformer `Array` instead — which
		// `stdlib/Array.maxon:632`'s `extension Array implements Hashable, Equatable where Element is Hashable
		// and Equatable` registers as a plain declared conformance, because `typeDeclaresInterface` works in
		// NAMES and a name cannot carry a `where` clause. The conditional half was therefore discharged by
		// nothing at all.
		//
		// ⇒ MEASURED, three cases of `array-conditional-conformance-withheld` at once: `Set with (Array with
		// Opaque)` and `Map with (Array with Opaque, Val)` go unrefused, and
		// `Array with (Array with Opaque)` SERVES `hash()`. A conditional conformance is granted to every
		// element in the language by one module joining the load.
		//
		// The distinction the `declaredBase` arm draws is between a base whose `where` clause constrains its
		// INSTANTIATION — `MapIterator`'s `where Key is Hashable`, which `checkOneInstantiation` rejects at the
		// site, so every instance that exists satisfies it and the conformance may be read off the declaration
		// — and a base whose conformance is itself CONDITIONAL. `Array with Opaque` is a perfectly legal
		// instantiation that simply is not `Hashable`, so no instantiation check speaks for it and the
		// reduction remains the only thing that can. Until the reduction is per-INTERFACE, `Array` is the one
		// base with such an extension and its own arm stays authoritative for it — including the FALLBACK,
		// which is the half that moved.
		if self.isLibraryArrayInstance(id) 'theConditionalConformanceIsAuthoritative'
			if self.arrayElementCarriesConformance(id) 'conformingArray'
				return GenericInstanceConformer.arrayBuiltin
			end 'conformingArray'

			return GenericInstanceConformer.unreduced
		end 'theConditionalConformanceIsAuthoritative'

		let baseName = self.genericInstanceBaseName(id)
		return match self.structInAnyFile(baseName) 'base'
			declared gives GenericInstanceConformer.declaredBase(baseName)
			undeclared gives GenericInstanceConformer.unreduced
		end 'base'
	end 'instanceConformerReduction'

	// The conformer a declared NAME reduces to: a ranged int/float alias collapses to its underlying
	// primitive's name (`Integer` -> `int`), which is what its intrinsic conformance and its `__witness_int.*`
	// tables are keyed by; every other name is its own conformer.
	export function conformerNameOfDeclaredName(name ByteArray, readerFilePath FilePath) returns String
		if let underlying = try self.aliasUnderlyingFor(name, readerFilePath: readerFilePath) 'rangedAlias'
			return primitiveTypeTagName(maxonTypeTag(underlying))
		end 'rangedAlias'

		// ⭐⭐ **A GENERIC-INSTANCE TYPEALIAS OVER A CONFORMING `Array` REDUCES TO THE `Array` CONFORMER
		// (array-hashable) — the ranged alias's rule one alias kind over, and it is NOT optional.** A generic
		// instance stores its type argument as the SOURCE spelling: `Map with (IntArr, Val)` holds
		// `named("IntArr")` exactly as it holds `named("Val")`, and both are reduced HERE rather than at
		// instantiation. Without this arm the key of `specs/array-hashable.md`'s `int-array-map-key` is
		// the conformer `IntArr` — a name nothing conforms under — so the very witness slot the reduction
		// exists to name is never reachable through an alias, which is the only way the corpus writes one.
		//
		// ⭐⭐ **AN INSTANCE ALSO ARRIVES AS ITS OWN CANONICAL RENDERING, AND THAT SPELLING REDUCES BY THE SAME
		// RULE** — both spellings are `instanceOfDeclaredName`'s to recognize, and that is where the two
		// arms, their ordering and the superseded guard live. A spelling it declines names no instance and
		// falls through to its own name, which conforms to nothing — the same answer a non-conforming array
		// gets, and the safe direction.
		if let instance = try self.instanceOfDeclaredName(name) 'namesAnInstance'
			return self.conformerNameOfInstanceSpelling(instance, spelling: name)
		end 'namesAnInstance'

		return String.from(name)
	end 'conformerNameOfDeclaredName'

	// ⭐⭐ **THE INSTANCE A DECLARED NAME NAMES, IN EITHER OF THE TWO SPELLINGS ONE CAN ARRIVE IN.** The first
	// arm answers for the spelling an AUTHOR wrote (`typealias IntUpCursor = UpCursor with Integer`); the
	// second for the spelling the COMPILER wrote (`UpCursor_Integer`), a canonical instance name.
	// `declaredNameIsManaged` carries the same pair for the ownership question, with the same sentence — *"a
	// generic instance arrives as its canonical name at some doors, and no registry is keyed by that"*.
	//
	// ⚠ The alias door is asked FIRST because it holds the author's spelling and the other the compiler's;
	// `renderedInstanceOfUnclaimedName` is what keeps a mint from outranking a DECLARATION.
	//
	// ⚠ **THE SUPERSEDED GUARD IS `genericAliasInstance`'s PRECONDITION, not caution.** That door refuses a
	// spelling two files contest, and a whole-program reader must ask this first (see there); a superseded
	// spelling names no instance, which is the safe direction — its caller then falls back to the name itself.
	export function instanceOfDeclaredName(name ByteArray) returns GenericInstanceId throws MapError
		if let alias = try self.liveGenericAliasInstance(name) 'genericInstanceAlias'
			return alias
		end 'genericInstanceAlias'

		return try self.renderedInstanceOfUnclaimedName(name)
	end 'instanceOfDeclaredName'

	// The reduction the two instance SPELLINGS share — an author's `typealias` and the compiler's own canonical
	// mint — written once so the two doors above cannot come to answer differently about one instance.
	//
	// ⚠ The UNREDUCED fallback is the CALLER'S spelling and never the mangled instance: the alias door holds
	// the name the author wrote, and that name reaches an author through the withheld-extension diagnostic
	// (`array-conditional-conformance-withheld`, which measured the regression when it fell through to the
	// mangler). Either way the answer conforms to nothing, which is the part that decides the program.
	function conformerNameOfInstanceSpelling(id GenericInstanceId, spelling ByteArray) returns String
		match self.instanceConformerReduction(id) 'reduction'
			arrayBuiltin then return String.from(self.arrayRecordBaseName())
			declaredBase(baseName) then return String.from(baseName)
			unreduced then return String.from(spelling)
		end 'reduction'
	end 'conformerNameOfInstanceSpelling'

	// ⭐ **HOW A DIAGNOSTIC SPELLS A DECLARED NAME — the name-keyed twin of `instanceDisplayName`.**
	// A conformance's recorded `withArgs` are RENDERED names, so a binding to a generic instance reaches every
	// message that prints one as `Tally_Integer`: the compiler's own canonical mint, which no source line
	// holds and which reads to an author as a type they never wrote. This is the same split
	// `conformerNameOfDeclaredName` is to `conformerNameOfType` — one door for a caller holding a NAME where
	// the other holds a type — and it exists for the reason `InstanceDisplayNameMap` states: a person did not
	// write `Array_String`.
	//
	// ⚠ **NOTHING MAY COMPARE TWO OF THESE**, exactly as `instanceDisplayName`'s header insists: two aliases
	// legitimately spell one type. Every comparison stays on `conformerNameOfDeclaredName`, which is the
	// identity; this answers only what gets printed.
	export function displaySpellingOfDeclaredName(name immutable ByteArray) returns immutable ByteArray
		if isMintName(name) 'aContestedDeclarationsMint'
			return freeze self.aliasIdentityDisplay(name).toByteArray()
		end 'aContestedDeclarationsMint'

		return self.instanceDisplayName(try self.renderedInstanceOfUnclaimedName(name) otherwise return name)
	end 'displaySpellingOfDeclaredName'

	// The structural mangling of a generic instance itself — `Box_Integer` for `Box with Integer` — the
	// base name joined to each argument's mangling. Shared by `mangleTypeArg` (a nested-instance argument)
	// and lowering's descriptor-label builder.
	//
	// ⚠ **DERIVED ONCE PER INSTANCE, AND THAT IS NOT A CONSTANT-FACTOR TIDY-UP** — the derivation is
	// RECURSIVE through `mangleTypeArg`'s nested arm, so re-deriving on every ask is quadratic in
	// nesting depth. `CompiledInstanceNameMap` carries the measurement.
	//
	// Returns the `ByteArray` six of the eight callers want (a symbol name is bytes, and each of those six
	// would otherwise convert on the spot); the two that want a `String` say so. It hands back the memo's own
	// handle, so an ask costs a retain rather than a rebuild — safe because every consumer either READS it
	// (a map key, a `Set.contains` probe) or builds a NEW string around it (`destructorSymbol`,
	// `String.from`), and none writes through it.
	//
	// ⭐⭐ **AND IT IS WHERE A CONTESTED NAME IS MOVED INTO THE RESERVED SPACE — AT THE SOLE PRODUCER,
	// NOT AT A LATER CHECK.** See `reservedIfDeclared`. Deriving the final name HERE is what lets
	// every consumer be a pure read: the PARSER is one of them (`decrefCalleeFor` bakes
	// `__destruct_<mangled>` into an emitted drop call), so a name revised after the parse would leave
	// `main` calling a symbol the destructor synthesis never emits. ⭐⭐ **THE STEM BOTH INSTANCE-NAME
	// BUILDERS START FROM — the base name, PLUS a sized container's COUNT, or `RuntimeSizedShapeTag`
	// for a runtime-sized one.** The two builders (`mangleGenericInstance`, the emitted symbol;
	// `canonicalNameWithin`, the comparison name) differ only in how they render an ARGUMENT, so the
	// head is written once and neither can come to disagree with the other about whether a size is
	// part of a type's name.
	//
	// ⚠ **WITHOUT THE COUNT, TWO LEGAL TYPES SHARE ONE NAME, AND IT IS NOT A COSMETIC CLASH.**
	// `FixedArray with 3 Int` and `FixedArray with 4 Int` are different types by construction (the
	// size is half of the instance key), and both mangled to `FixedArray_Int` — MEASURED: a program
	// declaring both is refused outright with **E3006 duplicate definition of 'FixedArray_Int' — the
	// generic instantiations `FixedArray with Int` and `FixedArray with Int` compile to that same
	// name**, a message naming one type twice. `ParseStaging`'s symbol check is what caught it, which
	// is exactly what that check is for. The tag keeps a runtime-sized instance from mangling like the
	// countless `Self` of the shared body or like any sized instance.
	function instanceNameStem(id GenericInstanceId) returns String
		var out = String.from(self.genericInstanceBaseName(id))

		match self.rowShape(id) 'shape'
			sized(size) then out.append("_{FixedSizeNameTag}{size}")
			runtimeSized then out.append("_{RuntimeSizedShapeTag}")
			unsized or
			frozenArgs then break
		end 'shape'

		return out
	end 'instanceNameStem'

	function frozenArgMarker(id GenericInstanceId, position ElementIndex, form InstanceNameForm) returns String
		let qualifier = self.rowShape(id).argQualifierAt(position)

		if qualifier == GenericArgQualifier.plain 'unqualified'
			return ""
		end 'unqualified'

		return match form 'form'
			canonical gives FrozenCanonicalPrefix
			written gives "{String.from(ImmutableCapabilityWord)} "
		end 'form'
	end 'frozenArgMarker'

	export function genericInstanceArgWrittenMarker(id GenericInstanceId, position ElementIndex) returns String
		return self.frozenArgMarker(id, position: position, form: InstanceNameForm.written)
	end 'genericInstanceArgWrittenMarker'

	export function mangleGenericInstance(id GenericInstanceId) returns immutable ByteArray
		if let derived = try self.compiledNameMemo(id) 'alreadyDerived'
			return derived
		end 'alreadyDerived'

		var out = self.instanceNameStem(id)

		for (iter, arg) in self.rowArgs(id).withIterator() 'eachArg'
			out.append("_")
			out.append(self.frozenArgMarker(id, position: iter.index(), form: InstanceNameForm.canonical))
			out.append(self.mangleTypeArg(arg))
		end 'eachArg'

		self.compiledInstanceNames.upsert(id, value: self.reservedIfDeclared(out))

		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteCompiledName(id)
		end 'pastTheBaseline'

		return try self.compiledInstanceNames.get(id) otherwise panic("ProgramSignatures.mangleGenericInstance: the name just filed for instance {id} is missing from the compiled-name memo")
	end 'mangleGenericInstance'

	// ⭐⭐ **RESERVED-SPACE DISJOINTNESS: A COMPILED INSTANCE NAME A DECLARATION ALSO CLAIMS IS MINTED
	// BEHIND `__` INSTEAD.**
	//
	// An instantiation has no source name, so the compiler builds one, and every per-type symbol the
	// backend emits is derived from that string — `__destruct_<name>`, `__layout_<name>`. A declared
	// `type Box_String` derives ITS symbols from the identical string, so `Box with String` and
	// `type Box_String` minted one `__destruct_Box_String` twice and the later install won: a LEAK when
	// the loser owned a field the winner does not drop, a SILENT SUCCESS when the two layouts happened to
	// agree. That was reported as E3006 — which made a program the language permits (a legal type name,
	// plus an instantiation the author may never have written: a bare `[Foo…]` literal interns
	// `Array with Foo`) fail to compile, naming an instantiation that appears nowhere in the source.
	//
	// `__` is ALREADY reserved — `E2051` refuses to DECLARE a name that starts with it — so a compiled
	// name minted behind it is one no declaration can hold, and the two halves of the namespace are
	// disjoint BY CONSTRUCTION rather than by a check — which is why no declaration-vs-instance check
	// is needed at all.
	//
	// ⚠ **AND IT IS WHY NOTHING HERE PROBES THE INSTANCE SET.** A minted name has to be disjoint from
	// every OTHER instance's compiled name too, and that falls out of the same reservation instead of a
	// second probe: `mangleGenericInstance` joins BASE-FIRST, no base may start with `__`, so no BARE
	// compiled name ever does — and two minted names are equal only when the bare names behind them are,
	// which is the pair collision `checkTypeSymbolNamespace` already reports over the FINAL names. See
	// `ReservedTypeNamePrefix` for why a non-reserved prefix would break exactly this, and
	// `nested-contest-mints-onto-a-second-contested-name` for the case that pins it.
	//
	// ⚠ **ON CONTEST ONLY, WHICH IS A COST DECISION.** Prefixing unconditionally would move the mangled
	// symbol of every instance it applies to. Minting only for a contest — which is an ERROR without
	// it — moves no name that ever compiled.
	//
	// ⚠ **RE-PROBED, NOT PREFIXED ONCE.** `__Box_String` could itself be declared, and the loop
	// TERMINATES because each pass makes the candidate strictly longer while the declaration set is
	// finite and fixed (the sweep is complete before any name is derived).
	//
	// Two instantiations that compile to ONE name are NOT cured by this and are not meant to be — `_` is a
	// legal name character, so the join is not injective (`Box with A_B` and `Box_A with B` both give
	// `Box_A_B`) and there is no declaration to move out of the way. That stays E3006, in
	// `checkTypeSymbolNamespace`.
	function reservedIfDeclared(bare String) returns immutable ByteArray
		var name = freeze bare.toByteArray()

		while self.claimsCompiledTypeName(name) 'contested'
			name = freeze "{String.from(ReservedTypeNamePrefix)}{String.from(name)}".toByteArray()
		end 'contested'

		return name
	end 'reservedIfDeclared'

	// ⭐ **DOES A DECLARATION ALREADY CLAIM THE COMPILED TYPE NAME `name`?** The declared half of the
	// compiled-name namespace, asked in ONE place: a `type` and an `enum`/`union` each mint
	// `__destruct_<name>` from their bare name (`installStructDestructors` / `installUnionDestructors`),
	// which is the identical string an instance's `__destruct_<mangled>` / `__layout_<mangled>` are built
	// from.
	//
	// ⚠ **AN `interface` AND A `typealias` ARE ABSENT, AND NEITHER IS AN OVERSIGHT.** Neither mints a
	// per-type symbol, so neither can collide with an instance and neither may displace one. An alias
	// mints nothing at all — an instance's methods are emitted under its BASE's name, which is why
	// `typealias Box_Integer = Box with Integer` is legal. An interface's only emitted artifact is
	// `__witness_<conformer>.<interface>`, whose head is the CONFORMER, so an `interface Box_String`
	// beside a `Box with String` shares no symbol with it.
	//
	// ⚠ **THE HEAD ARGUMENT ONLY EVER COVERED THE DECLARED HALF, WHICH IS THIS FUNCTION'S HALF, AND IT
	// STILL DOES.** It says nothing about one witness label against ANOTHER — and that half WAS broken,
	// silently: `_`-joined, `(A_B, C)` and `(A, B_C)` spelled one table. The cure is not a check here (a
	// witness table is minted during lowering, long after this sweep, and there is no declaration to move
	// aside) but the SEPARATOR — see `IrInterface.witnessTableLabel`. It also strengthens the claim above
	// by a second, independent route: a `.` occurs in no source identifier, hence in none of the `_`-joined
	// compiled instance names this function guards, so no witness label is spellable from the instance side
	// at all.
	// It reads THIS index's own registries and not `project.typeNameDecls`, because it is asked during
	// the signature sweep — before any file is parsed, which is the whole point (see
	// `mangleGenericInstance`). The two agree by construction for the kinds above: both are folded from
	// the same declarations, and a program whose sweep and parse disagree has a parse diagnostic and
	// fails the build regardless.
	function claimsCompiledTypeName(name ByteArray) returns bool
		return self.containsStructInAnyFile(name) or self.containsEnumInAnyFile(name)
	end 'claimsCompiledTypeName'

	// ⭐⭐ **THE ONE CANONICAL TYPE IDENTITY OF A GENERIC INSTANCE.** `mangleGenericInstance` names
	// the instance as it was INTERNED, and one type can be interned twice — `Box with N0` and
	// `Box with (Box with S0)` are the same type spelled two ways, and they compile to `Box_N0` and
	// `Box_Box_S0`. That duplicate is a separate matter; what must never exist is two
	// answers to "are these the same TYPE?", so every comparison site asks THIS, which resolves an
	// alias-named argument through the alias table and therefore gives both spellings ONE string.
	//
	// ⚠ **COMPARISON ONLY — it names nothing that is emitted.** The symbol names (`__destruct_<name>`,
	// `__layout_<name>`) and the E3006 compiled-name space keep asking `mangleGenericInstance`, so no
	// emitted byte moves. That separation is the whole reason this is a second function and a second memo
	// rather than a change to the first.
	// The EMPTY-path entry: the walk below memoizes every instance it names, so this only has to say that a
	// fresh ask starts with nothing open.
	export function canonicalInstanceName(id GenericInstanceId) returns immutable ByteArray
		let path = GenericInstanceIdArray.create(0)
		return self.canonicalNameWithin(id, path: path)
	end 'canonicalInstanceName'

	// The recursive half, carrying the instances already open on this walk.
	//
	// ⚠ **THE PATH GUARD IS LOAD-BEARING, because this runs in the PARSER** — `aggregateNameIn` asks it, and
	// the parse completes before `checkGenericAliasCycles` (E3091) refuses a cyclic alias. Resolving alias
	// arguments is exactly what makes `typealias A = Box with A` a cycle here, where `mangleTypeArg` never
	// followed one. On revisit it falls back to the INTERNED name, which terminates and is deterministic;
	// the program is refused moments later by E3091 regardless, so the fallback's only job is to get there.
	//
	// ⚠⚠ **IT MEMOIZES AT EVERY LEVEL, AND THAT IS A CUBIC — NOT A TIDY-UP.** Consulting the
	// memo only at the outermost ask and recursing raw beneath it makes naming instance `i` of an alias CHAIN
	// re-walk the whole chain and append a name of length O(i) at each level — O(i²) for one name, O(N³)
	// to name them all. MEASURED, A/B on a chain of N aliases each used to build a value: `semanticCheck` runs
	// 0.4 / 0.7 / 1.3 / 2.9 ms at N = 100/200/400/800 with no canonical namer at all (LINEAR) against
	// 12.3 / 53.5 / 303.8 / 1826.1 ms with an outermost-only memo (x4.4, x5.7, x6.0 per doubling — rising), a
	// 630x regression at N=800 that widens with N. Memoizing here walks the chain ONCE.
	//
	// A memo hit is the true canonical name whenever it matters. In an ACYCLIC graph the answer does not
	// depend on `path` at all, so a name derived under one walk is correct under every other. In a cyclic one
	// the guard can make a name path-dependent — but that program is refused by E3091 and emits nothing, and
	// `deriveInstanceNames` warms every instance in ascending id order before any check asks, so which walk
	// got there first is a property of the program rather than of the asking site.
	function canonicalNameWithin(id GenericInstanceId, path GenericInstanceIdArray) returns immutable ByteArray
		for open in path 'eachOpen'
			if open == id 'cyclic'
				return self.mangleGenericInstance(id)
			end 'cyclic'
		end 'eachOpen'

		if let derived = try self.canonicalNameMemo(id) 'alreadyDerived'
			return derived
		end 'alreadyDerived'

		path.push(id)
		var out = self.instanceNameStem(id)

		for (iter, arg) in self.rowArgs(id).withIterator() 'eachArg'
			out.append("_")
			out.append(self.frozenArgMarker(id, position: iter.index(), form: InstanceNameForm.canonical))
			out.append(self.canonicalTypeArgName(arg, path: path))
		end 'eachArg'

		_ = try path.pop() otherwise panic("canonicalNameWithin: path.pop on a path this call pushed to")

		self.canonicalInstanceNames.upsert(id, value: freeze out.toByteArray())

		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteCanonicalName(id)
		end 'pastTheBaseline'

		return try self.canonicalInstanceNames.get(id) otherwise panic("ProgramSignatures.canonicalNameWithin: the name just filed for instance {id} is missing from the canonical-name memo")
	end 'canonicalNameWithin'

	// One type argument in canonical form — `mangleTypeArg`'s comparison twin. It differs in exactly one arm:
	// a `named` leaf that names a generic-instance ALIAS becomes THAT instance's canonical name instead of
	// the alias's bare spelling, which is what collapses the two spellings of one type.
	//
	// ⚠ **THE EDGE IS `denotedInstance`'S AND IS NOT SPELLED AGAIN HERE.** "Which instance does
	// this type argument denote?" is ONE fact with three readers — this name, the identity + (tag, nameId)
	// pair `checkTypeParameterArgsAt` reads through `canonicalTypeArg`, and the E3091 cycle graph's edge
	// (through `denotedInstanceUnlessContested`).
	// Written out three times, a reader that learns an arm the others do not would call
	// `Box with Bytes` and `Box with (Array with Byte)` two types where another calls them one, silently,
	// in a name that mangled symbols are built from.
	function canonicalTypeArgName(t MaxonType, path GenericInstanceIdArray) returns String
		if let denoted = try self.denotedInstance(t) 'denotesAnInstance'
			return String.from(self.canonicalNameWithin(denoted, path: path))
		end 'denotesAnInstance'

		// A `named` leaf that denotes no instance is a declared aggregate or a ranged alias: its own name,
		// which is what `mangleTypeArg` would answer for it and is spelled here without the String round trip.
		//
		// ⛔ **THE ALIAS'S NAME, NEVER ITS RANGE.** Two aliases over one range are two types, so the name IS
		// the identity here — and this string is rendered into diagnostics through `instanceDisplayName`'s
		// fallback and through `aggregateNameIn`, where this tree's standing rule is that an alias is quoted
		// AS SOURCE SPELLS IT.
		if maxonTypeTag(t) == ValueTypeTag.named 'namedLeaf'
			return String.from(self.nameOfId(typeNameIdOf(t)))
		end 'namedLeaf'

		return self.mangleTypeArg(t)
	end 'canonicalTypeArgName'

	// ⭐ **DERIVE EVERY SWEPT INSTANCE'S NAMES NOW, SO THEY ARE PART OF THE SETTLED BASELINE.**
	//
	// `mangleGenericInstance` and `canonicalInstanceName` memoize by WRITING, and the parse asks both
	// (`aggregateNameIn`). Warmed here, a name a parse reads for a swept instance is baseline data every
	// file sees alike; a name derived for a row the parse itself mints is journaled and undone at the band's
	// close (`ProgramSignatures.closeParseBand`).
	export function deriveInstanceNames()
		// ⚠ **FIRST, because it composes `fileScopedInstance`, which INTERNS.** It cannot in fact intern
		// anything new — `settleGenericAliasContest`'s fixpoint runs until exactly this composition over
		// exactly this array stops adding instances — but ordering it ahead of the warming loop means the
		// warming loop covers whatever it produces, so a complete baseline does not rest on that argument holding.
		self.deriveInstanceDisplayNames()

		for id in 0 upto self.rowCount() 'eachInstance'
			_ = self.mangleGenericInstance(id)
			_ = self.canonicalInstanceName(id)
		end 'eachInstance'

		// The name→instance direction is a third thing the parse asks, so it joins the baseline beside the two
		// forward memos.
		self.indexCanonicalInstanceNames()
	end 'deriveInstanceNames'

	// ⭐⭐ **INSTANCE ⇒ THE `typealias` AN AUTHOR DECLARED FOR IT — the DISPLAY index (see
	// `InstanceDisplayNameMap`).** Derived from `genericAliasDecls`, which holds every SOURCE declaration and
	// deliberately holds no compiler-minted one (`rekeyScopedGenericAliases` states that split): a name only
	// counts here if a person wrote it, because the whole point of the index is to quote a person's own
	// spelling back at them.
	//
	// ⚠ **THE INSTANCE IS `fileScopedInstance`'d BY THE DECLARING FILE**, exactly as `rekeyScopedGenericAliases`
	// and the contest rounds scope it, so a `typealias Bytes = Array with Byte` in a program where two files
	// declare `Byte` differently is filed against the instance ITS OWN file means and not against whichever
	// bare one the sweep interned.
	//
	// ⚠ **FIRST DECLARATION WINS WHEN TWO NAMES DENOTE ONE INSTANCE** (`Bytes` and `stdlib/File.maxon`'s
	// `ByteArray` over the same `Byte`). Both spellings are TRUE of that one type, so there is nothing to
	// choose between them on correctness; declaration order settles it deterministically and needs no reader
	// file, which the parse-time askers would otherwise all have to supply.
	//
	// ⭐⭐ **A TYPE-SCOPED ALIAS LOSES TO AN UNSCOPED ONE, AND IT IS THE ONE PLACE IN THE COMPILER THAT RANKS
	// TWO TRUE NAMES** (⚖ USER RULING; `deriveInstanceDisplayNames` carries the other half of it).
	// `type Character`'s `typealias ByteMemory = __ManagedMemory with Byte` is a true name
	// for `Array with Byte` and a declaration a person wrote — so by the paragraph above it takes the display,
	// `stdlib/Character.maxon` sorting ahead of `stdlib/String.maxon` being the whole of why it beats
	// `String.maxon:23`'s file-scope `ByteArray`. But an inner alias is not a name the author of the refused
	// program could have WRITTEN — `stdlib/String.maxon:25` says exactly that about its own twin, which is why
	// that file declares a file-scope `ByteBuffer` beside it — so quoting `Character.ByteMemory` back at
	// someone who wrote `ByteArray` breaks the standing ruling that a diagnostic names a type THE WAY THE
	// AUTHOR WROTE IT. MEASURED without the ranking: three cases across `array-init` and
	// `bytearray-element-size` read `got 'Character.ByteMemory'` where `got 'ByteArray'` is correct.
	//
	// ⚠ **EXCLUDED FROM THE DISPLAY AND FROM NOTHING ELSE.** An inner alias goes on resolving exactly as it
	// did — `parseTypeReference`'s inner-alias arm, `scopedGenericAliasInstance`, the contest rounds and the
	// buffer-surface derivation all read `genericAliases`/`genericAliasDecls` and are untouched. What is being
	// said is only that it is not a SPELLING to hand back.
	//
	// ⭐⭐ **AND THE EXCLUSION IS CONDITIONAL, NOT ABSOLUTE — "ADMIT TYPE-SCOPED WHEN IT'S THE ONLY NAME"
	// (⚖ USER RULING).** It was written as an unconditional skip, and the fallback that left behind is
	// the CANONICAL MINT: an instance whose only declared name is type-scoped was quoted as
	// `Array_Tc458b93abe5c7098`. That serves nobody, and it is the very thing the display ruling was
	// reaching for — a diagnostic names a type THE WAY THE AUTHOR WROTE IT — turned against itself,
	// because when `Inner.UArr` is the only name the author CAN write, it is the way the author wrote
	// it. MEASURED: `generic-type-substitution/error.a-name-the-scope-does-not-bind-binds-nothing`
	// read `expected 'Array_Tc458b93abe5c7098', got 'Array_T4032a9ecb1272bfc'` where `expected
	// 'Inner.UArr', got 'Outer.OArr'` is correct.
	//
	// ⭐ **THE TYPE-SCOPED CASE IS PROTECTED BY CONSTRUCTION RATHER THAN BY A CARVE-OUT, AND THAT IS
	// WHY THE ROUNDS ARE SPLIT BY KIND.** `Character.ByteMemory` must not beat
	// `stdlib/String.maxon:23`'s file-scope `ByteArray`, which it would only because `Character.maxon`
	// sorts ahead of `String.maxon`. BOTH instances hold an unscoped spelling (`Array with Byte` is
	// `ByteArray` in five listed modules; `__ManagedMemory with Byte` is `String.maxon:28`'s
	// `ByteBuffer`, which that file declares for exactly this reason), so round one claims them and
	// round two never sees them. The four cases the ranking protects — `array-init`'s
	// `error.a-buffer-of-the-wrong-element` and `bytearray-element-size`'s
	// `a-byte-two-files-disagree-about-is-two-types`,
	// `a-buffer-field-refuses-another-files-byte-at-the-construction` and
	// `error.the-two-string-spellings-name-their-own-corpus-types` — go on reading `ByteArray`.
	//
	// ⚠ **AN UNSCOPED SPELLING WINS OVER A TYPE-SCOPED ONE ALWAYS, AND IT IS THE ROUND THAT DECIDES
	// THAT RATHER THAN THE WALK ORDER.** A single walk settles the contest between the two kinds by
	// which file the loader reaches first (the `Character.maxon`-before-`String.maxon` accident
	// above); settled by KIND it cannot vary with the filesystem. Within ONE kind the author's
	// declarations are walked before the library's, so a user alias names an instance whichever tier
	// was folded first, and within a tier first-declaration-wins walks `genericAliasDecls` in its
	// recorded order.
	function deriveInstanceDisplayNames()
		self.nameInstancesFromDeclarations(DisplayNameRound.unscoped, libraryTier: false)
		self.nameInstancesFromDeclarations(DisplayNameRound.unscoped, libraryTier: true)
		self.nameInstancesFromDeclarations(DisplayNameRound.typeScoped, libraryTier: false)
		self.nameInstancesFromDeclarations(DisplayNameRound.typeScoped, libraryTier: true)
	end 'deriveInstanceDisplayNames'

	// ONE ROUND of the walk above, over the declarations of a single scope kind and tier — the rounds
	// are the same rule applied to two populations, so they are one body and cannot come to disagree
	// about what naming an instance means. Round two is what "only name" is spelled as: an instance
	// round one claimed is already in the map, so `anEarlierDeclarationAlreadyNamedThisType` is
	// exactly the "an unscoped name exists" test, and no second index has to be built to answer it.
	function nameInstancesFromDeclarations(round DisplayNameRound, libraryTier bool)
		let declared = self.mainThreadSettled().genericAliasDecls

		for entry in declared 'eachDeclaration'
			let entryRound = DisplayNameRound.typeScoped if entry.typeScoped else DisplayNameRound.unscoped

			if entryRound != round or self.declaredByTheCorpus(entry.filePath) != libraryTier 'aDeclarationForTheOtherPass'
				continue
			end 'aDeclarationForTheOtherPass'

			let instance = self.fileScopedInstance(entry.internedInstance(), filePath: entry.filePath)

			// The FIRST declaration names the type. Two alias names for one instance are two BRANDS of it, and a
			// branded value prints its brand (`valueBrandIds`), so this spelling is read only for a value no alias
			// names.
			if self.mainThreadSettled().instanceDisplayNames.contains(instance) 'anEarlierDeclarationAlreadyNamedThisType'
				continue
			end 'anEarlierDeclarationAlreadyNamedThisType'

			self.mainThreadSettled().instanceDisplayNames.upsert(instance, value: self.unambiguousAliasSpelling(entry))
		end 'eachDeclaration'
	end 'nameInstancesFromDeclarations'

	// ⭐⭐ **THE AMBIGUITY RULE, AND IT IS THE USER'S (2026-08-04): "if a name is possibly ambiguous it needs
	// to contain its full namespace".** A declared alias is ambiguous EXACTLY when this program's declarations
	// of that name denote DIFFERENT types — which is not a fresh question, it is `contestedGenericAliases`,
	// already settled whole-program by `settleGenericAliasContest`. So the display asks the same index the
	// RESOLUTION asks, and a spelling can never claim to distinguish two types the compiler does not itself
	// hold apart.
	//
	// ⚠ **THE QUALIFIER IS THE NAMESPACE ONLY WHEN THE NAMESPACE ACTUALLY DISTINGUISHES THE CLAIMANTS.** A
	// non-exported `typealias` is FILE-local (`specs/duplicate-typealias.md`) and the compiler scopes a contested one
	// per DECLARING FILE (`GenericAliasByDeclaringFile`) — not per directory — so two files in one directory,
	// or two files in the ROOT (whose namespace is empty), share a namespace and a namespace-qualified
	// spelling would render `expected 'x.Bytes', got 'x.Bytes'`: a refusal with no content, which is the one
	// outcome this whole door exists to prevent.
	//
	// ⛔ **AND WHERE THE NAMESPACES DO NOT DISTINGUISH THEM, THE ANSWER IS THE BARE SOURCE SPELLING, NOT THE
	// FILE PATH.** A path joined into the name is the same contentless refusal one level down: the spec
	// harness normalises file names, so both sides render as the same `<fragment>.Bytes`. The declaring file
	// is real information, but it is a PROVENANCE NOTE beside the name (`originNote`) and never part of the
	// spelling — and a note is written only where two displays read alike, so a message the namespace already
	// disambiguated gets none.
	function unambiguousAliasSpelling(entry GenericAliasEntry) returns immutable ByteArray
		if not self.genericAliasSpellingIsSuperseded(entry.aliasName) 'onlyOneTypeInThisProgramWearsThisName'
			return entry.aliasName
		end 'onlyOneTypeInThisProgramWearsThisName'

		return freeze self.contestedDeclarationSpelling(entry.aliasName, declFilePath: entry.filePath).toByteArray()
	end 'unambiguousAliasSpelling'

	// The type name this callee's `returns` clause wrote; `absent` where it wrote none. The caller
	// decides whether that name is a generic alias — this index cannot be asked during the sweep that
	// fills it.
	export function returnAliasNameOf(callee ByteArray) returns immutable ByteArray throws AbsentError
		if self.settledDeclarations().funcReturnAliasNames.count() == 0 'noClauseInThisProgramWroteAName'
			throw AbsentError.absent
		end 'noClauseInThisProgramWroteAName'

		return try self.settledDeclarations().funcReturnAliasNames.get(callee) otherwise throw AbsentError.absent
	end 'returnAliasNameOf'

	export function returnInnerAliasOf(callee ByteArray, aliasName ByteArray) returns immutable ByteArray throws AbsentError
		let nested = try self.aliasNestedInDeclaringTypeOf(callee, aliasName: aliasName, declFilePath: self.recordedReturnDeclFileOf(callee))

		if not self.declaresInnerAlias(nested) 'notAnInnerAlias'
			throw AbsentError.absent
		end 'notAnInnerAlias'

		return nested
	end 'returnInnerAliasOf'

	export function returnNamesInnerAlias(callee ByteArray, aliasName ByteArray) returns bool
		let nested = try self.returnInnerAliasOf(callee, aliasName: aliasName) otherwise EmptySourceText

		return not nested.isEmpty()
	end 'returnNamesInnerAlias'

	// ⭐ **HOW A DIAGNOSTIC SPELLS A GENERIC INSTANCE** — the author's `typealias` when the program holds one,
	// else the canonical mint (see `InstanceDisplayNameMap` for why a miss is an answer). It is the DISPLAY
	// sibling of `canonicalInstanceName`, never a substitute for it: nothing may COMPARE two of these, because
	// two aliases legitimately spell one type — and a value one of them BRANDS prints that brand instead
	// (`Parser.valueDisplayTypeName`).
	export function instanceDisplayName(id GenericInstanceId) returns immutable ByteArray
		return try self.settledDeclarations().instanceDisplayNames.get(id) otherwise self.renderedInstanceWith(id, spelling: InstanceArgSpelling.asRange)
	end 'instanceDisplayName'

	function nameIsAnInternalSpelling(name ByteArray) returns bool
		return isMintName(name) or name.equals(SynthesizedByteElementName)
	end 'nameIsAnInternalSpelling'

	// An instance no alias spells, written the way the SOURCE would write it: `Array with int(0 to 255)`.
	//
	// ⚠ **SOURCE SYNTAX AND NOT THE `Base_Arg` MANGLING, because this is the one instance name a reader
	// cannot look up.** `Array_Byte` is recognizable: some file declares `Byte`. `Array_int$0_255` names
	// nothing an author can search for, and the `$` is a separator no source may contain.
	function renderedInstanceWith(id GenericInstanceId, spelling InstanceArgSpelling) returns immutable ByteArray
		let instanceArgs = self.rowArgs(id)
		let names = StringArray.create(instanceArgs.count(), zeroed: false)

		for (iter, arg) in instanceArgs.withIterator() 'eachArg'
			names.push("{self.frozenArgMarker(id, position: iter.index(), form: InstanceNameForm.written)}{String.from(self.displayedTypeArgName(arg, spelling: spelling))}")
		end 'eachArg'

		return self.writtenInstanceTextOver(self.instanceNameStem(id), args: names)
	end 'renderedInstanceWith'

	// One argument as a reader sees it. `asRange` renders a ranged alias as its RANGE, through
	// `rangeSourceSpelling` (the whole point -- its NAME is what the merge made ambiguous) and `asWritten` as the source spells it; a declaration's mint
	// reads as that declaration's source spelling either way. A nested instance recurses through the display
	// door, and anything else keeps the spelling `mangleTypeArg` gives it.
	function displayedTypeArgName(arg MaxonType, spelling InstanceArgSpelling) returns immutable ByteArray
		let tag = maxonTypeTag(arg)

		if tag == ValueTypeTag.genericInstance 'nested'
			return match spelling 'spelling'
				asRange gives self.instanceDisplayName(genericInstanceIdOf(arg))
				asWritten gives freeze self.instanceSourceDisplay(genericInstanceIdOf(arg)).toByteArray()
			end 'spelling'
		end 'nested'

		if tag == ValueTypeTag.named 'mayNameARangedAlias'
			let name = self.nameOfId(typeNameIdOf(arg))

			if self.nameIsAnInternalSpelling(name) 'aDeclarationsOwnMint'
				return freeze self.aliasIdentityDisplay(name).toByteArray()
			end 'aDeclarationsOwnMint'

			if spelling == InstanceArgSpelling.asWritten 'theNameAsWritten'
				return freeze self.aliasIdentityDisplay(name).toByteArray()
			end 'theNameAsWritten'

			return try self.settledDeclarations().typeAliases.uncontestedRangeSourceSpelling(name) otherwise freeze self.aliasIdentityDisplay(name).toByteArray()
		end 'mayNameARangedAlias'

		if tag == ValueTypeTag.typeParameter 'aDeclarationsParameter'
			let owner = try self.typeParamOwnerOf(typeParamIdOf(arg)) otherwise panic("ProgramSignatures.displayedTypeArgName: type-parameter token {typeParamIdOf(arg)} names no declaration's parameter — every token an instance holds was minted by one")
			return owner.paramName
		end 'aDeclarationsParameter'

		return freeze self.mangleTypeArg(arg).toByteArray()
	end 'displayedTypeArgName'

	// ⭐ **THE NOMINAL IDENTITY OF AN INSTANCE'S SUBSTITUTED TYPE ARGUMENT** — what a parameter
	// declared with the bare type parameter `T` actually demands at a call made through that instance. It is
	// the second source of the aggregate name `namedAggregatesConflict` compares, beside `aggregateNameIn`,
	// and its name is resolved against a DIFFERENT interner — an instance's argument types are interned
	// HERE, not in the merged `project.typeNames`. The comparison RULE is still
	// the single shared one, and so is the `named` arm's rule (`namedIdentityOf`); only the id-to-name step
	// is local.
	//
	// `EmptySourceText` for a scalar, a `String` or an opaque `typeParameter` argument: those carry no
	// nominal identity and meet their argument by TAG (`checkDeclaredType`). A ranged alias carries its
	// name, and a `Box with Integer` keeps accepting a plain `int` literal because an unnamed value decays.
	// ⚠ **EVERY TAG STATES ITS OWN ANSWER.** A trailing `return EmptySourceText` is a silent default landing
	// on the ONE rule that reads empty as a positive claim:
	// `namedAggregatesConflict` treats exactly-one-empty as "an aggregate meeting a SCALAR", so an
	// unhandled kind does not abstain — it asserts `scalar` and REJECTS a legal program. A tag appended to
	// `ValueTypeTag` must fail to compile here rather than inherit a wrong answer.
	// ⚠ **IT TAKES THE ALREADY-SUBSTITUTED, ALREADY-CANONICAL ARGUMENT, NOT `(gid, position)`.** Its one
	// caller (`SemanticCheck.checkTypeParameterArgsAt`) needs the same type THREE ways — this identity, the
	// (tag, nameId) pair the shared `aggregatesConflict` compares with, and the declared tag the scalar half
	// judges against — and `substitutedInstanceArg` returns a heap-boxed `MaxonType`. Asked here by
	// (gid, position) it was substituted once for this answer and again for the `structRef` arm, and a third
	// time at the caller. One substitution, resolved once through `canonicalTypeArg` and read three times, is
	// both fewer boxes and one resolution instead of two.
	// ⚠ **AND IT ASKS ON THE CALLING FILE'S BEHALF**: a name a `type` in one file and a `typealias` in
	// another both hold carries a nominal identity for one reader and none for the other.
	export function typeArgAggregateName(arg MaxonType, readerFilePath FilePath) returns immutable ByteArray
		match maxonTypeTag(arg) 'k'
			// No nominal identity: a scalar, a `String`, an opaque `T` and a function value all coerce by
			// TAG (`checkDeclaredType`), so `Box with Integer` keeps accepting a plain `42`.
			boolean or
			integer or
			float or
			exitCode or
			unresolved or
			string or
			function or
			typeParameter or

			// A Character argument carries no name — the builtin's identity is its tag, `string`'s answer.
			character or
			cstring then return EmptySourceText
			named then return self.namedIdentityOf(self.nameOfId(typeNameIdOf(arg)), readerFilePath: readerFilePath)
			void then panic("typeArgAggregateName: a type argument is `void` — a type argument is a TYPE, and the parser accepts no void one")

			// A struct argument is named by itself and a nested instance by its compiled name — the same two
			// spellings `mangleTypeArg` produces, which is why it is asked rather than re-derived.
			structRef then return freeze self.mangleTypeArg(arg).toByteArray()

			// CANONICAL, not `mangleTypeArg`: a nested instance's identity must match what the two
			// value-side extractors produce for the same type, whichever way it was spelled.
			genericInstance then return self.canonicalInstanceName(genericInstanceIdOf(arg))

			// An interface type is refused as a generic argument at the front end
			// (`Parser.checkGenericArgType`), so this arm is that refusal's backstop, exactly as
			// `primitiveTypeTagName`'s is.
			interfaceRef then panic("typeArgAggregateName: an interface type reached a generic type ARGUMENT — an element slot is one machine word and a fat pointer is two, so no container holds one")
		end 'k'
	end 'typeArgAggregateName'

	// ⭐⭐ **READ-TIME RESOLUTION OF A TYPE ARGUMENT SPELLED AS A GENERIC-INSTANCE ALIAS** — the type
	// argument as the thing it DENOTES, which for `Box with Bytes` is `Bytes`'s instance and not the name.
	//
	// `typealias N1 = Box with N0` records its argument as a plain `named(N0)` LEAF: only a syntactic
	// `Base with (…)` header becomes `genericInstance` at intern time, and the sweep records a file's
	// aliases at its END, so an alias named before it is interned cannot be seen there at all. Resolving it
	// HERE is what makes the two spellings agree — this runs from `semanticCheck`, long after the whole
	// sweep is folded, so the alias table is COMPLETE and the answer cannot depend on declaration or file
	// order. (`Box with N0` and `Box with (Box with S0)` still intern as two instances with two compiled
	// names; that duplicate is a separate matter. What matters for the comparison is the
	// TYPE ARGUMENT's identity, and both spellings yield `N0`'s instance — the same `Box_S0`.)
	//
	// ⭐ **IT HANDS BACK A TYPE AND NOT A NAME, AND THAT IS WHAT KEEPS THE RESOLUTION SINGLE.**
	// `checkTypeParameterArgsAt` wants the argument BOTH ways — the identity name (`typeArgAggregateName`)
	// and the (tag, nameId) pair the shared `aggregatesConflict` compares with — and a name-returning door
	// could serve only the first. Resolved to a name, `Box with Bytes`'s argument read `Array_Byte` for the
	// identity while its raw tag stayed `named`, so the byte-element boundary was asked about a name id that
	// is not an instance id and answered no: MEASURED, `MemBox.create(<a cwd buffer>)` refused
	// `expected 'Bytes'`.
	//
	// ⭐⭐ **IT IS THE ONLY SPELLING OF THAT EDGE, AND THREE READERS ASK IT.** The other two are
	// `canonicalTypeArgName` — the canonical instance NAME, which mangled
	// symbols and every nominal comparison are built from — and `buildInstanceArgGraph`, the E3091 cycle
	// graph. Spelled three times nothing makes them agree: an arm added to one (a tuple alias, a
	// namespace-qualified alias name, a per-file resolution) leaves the others calling `Box with Bytes` and
	// `Box with (Array with Byte)` two types where this one calls them one, with no compile error at any
	// site.
	//
	// ⚠ It cannot hang on a cyclic alias: `mangleGenericInstance` recurses only through `genericInstance`
	// args (`mangleTypeArg` returns a `named` arg's bare NAME without resolving it), and those nest
	// syntactically, so the recursion is bounded by source nesting depth. A cycle is refused earlier
	// anyway, by `firstCyclicAliasDecl` (E3091), which runs before the pipeline.
	export function canonicalTypeArg(arg MaxonType) returns MaxonType
		// A `genericInstance` already denotes itself, so it is handed back rather than re-boxed: the box
		// below is minted only where a NAME had to be turned into an instance.
		if maxonTypeTag(arg) != ValueTypeTag.named 'cannotSpellAnAlias'
			return arg
		end 'cannotSpellAnAlias'

		if let denoted = try self.denotedInstance(arg) 'namesAnInstance'
			return MaxonType.genericInstance(denoted)
		end 'namesAnInstance'

		return arg
	end 'canonicalTypeArg'

	// ⭐⭐ **THE EDGE ITSELF: WHICH INSTANCE DOES THIS TYPE ARGUMENT DENOTE?** — its own id when it IS an
	// instance, and the alias table's when it is a `named` leaf that names one. The `MaxonType`-returning
	// door above is this answer BOXED, for the one reader that needs a type; the two readers that need only
	// the id ask here and allocate nothing.
	//
	// ⚠ **THAT SPLIT IS WHY THERE IS A SECOND FUNCTION AND NOT A SECOND SPELLING.** Collapsing the id
	// readers onto `canonicalTypeArg` was MEASURED at +2 allocations / +32 bytes at every rung of the scale
	// ladder — a constant, from boxing an answer both of them immediately unwrapped. One fact, one place,
	// and the box only where a box is wanted.
	//
	// `throws` is `Map.get`'s own channel: "this argument denotes no instance" is the ordinary answer for a
	// scalar, a `String`, a struct or a plain ranged alias, and it is the caller's to interpret — the two
	// id readers skip the edge, and `canonicalTypeArg` hands the argument back unchanged.
	// ⚠ **FOR A CONTESTED NAME THIS ANSWERS THE LAST-WINS DECLARATION, AND THAT IS DELIBERATE.**
	// It bypasses `genericAliasInstance`'s refusal and `scopedGenericAliasInstance`'s tiers alike.
	// `buildInstanceArgGraph` walks EVERY interned instance, including the pre-re-key ones and the ones
	// earlier contest rounds superseded, whose arguments are still the bare spellings the sweep left, so it
	// asks `denotedInstanceUnlessContested` instead: a contested name means a different instance in each
	// file declaring it, and the last-wins one would be a stranger's edge.
	//
	// What it answers is which instance a type ARGUMENT denotes, for the structural readers — the canonical
	// type-argument name and the identity reads. It is written
	// down here rather than left to be rediscovered: this is the one place the "no plausible
	// answer without a file" rule is not applied, and the reason is that its callers have no file and no
	// program type to be wrong about.
	function denotedInstance(arg MaxonType) returns GenericInstanceId throws MapError
		if maxonTypeTag(arg) == ValueTypeTag.genericInstance 'itIsAnInstance'
			return genericInstanceIdOf(arg)
		end 'itIsAnInstance'

		// Only a `named` LEAF can spell an alias — a struct, a tuple and an opaque type parameter carry no
		// alias table entry, and a primitive carries no name at all.
		if maxonTypeTag(arg) != ValueTypeTag.named 'cannotSpellAnAlias'
			throw MapError.keyNotFound
		end 'cannotSpellAnAlias'

		return try self.settledDeclarations().genericAliases.get(self.nameOfId(typeNameIdOf(arg)))
	end 'denotedInstance'

	function denotedInstanceUnlessContested(arg MaxonType) returns GenericInstanceId throws MapError
		if maxonTypeTag(arg) == ValueTypeTag.named and self.genericAliasSpellingIsSuperseded(self.nameOfId(typeNameIdOf(arg))) 'meansDifferentThingsInDifferentFiles'
			throw MapError.keyNotFound
		end 'meansDifferentThingsInDifferentFiles'

		return try self.denotedInstance(arg)
	end 'denotedInstanceUnlessContested'

	// ⭐ **THE FIRST GENERIC ALIAS WHOSE TYPE ARGUMENTS LEAD BACK TO IT (E3091).** `typealias A = Box
	// with A` and the mutual `A = Box with B` / `B = Box with A` describe INFINITE types — no finite layout,
	// no finite compiled name — and without this check both compile clean and SEGFAULT at run time.
	//
	// Asked once per compile over the FINISHED table, so it needs none of the sweep's ordering: an alias
	// reaches itself or it does not, whatever order the files were swept in. The BLAME is the cyclic alias
	// declared earliest (file path, then line), so the alias reported is a property of the program, not of
	// fold order or a map's iteration.
	//
	// ⚠ **THE CYCLE SET IS COMPUTED ONCE FOR THE WHOLE GRAPH, NOT ONCE PER ALIAS — AND THAT IS A CUBIC
	// AVOIDED, NOT A TIDY-UP.** A per-alias reachability sweep walks, for every alias, the
	// instances its arguments reach, with a LINEAR scan of a `visited` array at every pop. On a chain of N
	// aliases (`N0 = Box with S0`, `N1 = Box with N0`, …) alias i reaches i instances and scans i entries per
	// pop, so the pass cost N x N x N. MEASURED, A/B in one worktree against the same tree with
	// only this check suppressed: the check alone cost 31 / 268 / 1,751 / 12,298 ms at N = 400 / 800 / 1,600 /
	// 3,200 — x8.6, x6.5, x7.0 per doubling, i.e. CUBIC, on programs that COMPILE (the rest of the compile
	// stayed flat at 139…197 ms across the same span). `nodesOnACycle` answers the same question for every
	// instance at once in O(instances + arguments): the same ladder now compiles in 149 / 197 / 307 ms at
	// N = 1,600 / 3,200 / 6,400 against a check-suppressed 143 / 194 / 295 ms, so the check costs 6 / 3 / 12 ms
	// and does not grow out of the noise floor.
	//
	// A program with no generic alias cannot have a cycle at all — only an alias edge can close one, since a
	// nested `Base with (Base with …)` argument nests syntactically and therefore finitely — so the whole
	// pass, graph included, is skipped rather than merely cheap.
	export function firstCyclicAliasDecl() returns AliasCycleResult
		if self.settledDeclarations().genericAliasDecls.count() == 0 'noAliasCanCloseACycle'
			return AliasCycleResult.none
		end 'noAliasCanCloseACycle'

		// ⭐ **A CYCLE THE GRAPH BELOW STRUCTURALLY CANNOT SEE** — it gives a `named` argument whose name
		// is contested no edge, so a cycle that exists only once each file's declarations are read as that
		// file's own is invisible here and is found instead by the contest fixpoint failing to converge. Asked FIRST because it is a fact already established, not a walk.
		match self.divergedGenericAliasDecl 'contestDiverged'
			at then return self.divergedGenericAliasDecl
			none then break
		end 'contestDiverged'

		let onCycle = nodesOnACycle(self.buildInstanceArgGraph())
		var blamed = AliasCycleResult.none

		for i in 0 upto self.settledDeclarations().genericAliasDecls.count() 'eachDecl'
			let entry = try self.settledDeclarations().genericAliasDecls.get(i) otherwise panic("firstCyclicAliasDecl: genericAliasDecls.get OOB at {i}")

			// ⚠ **THIS DECLARATION'S OWN INSTANCE, NOT THE BARE MAP'S.** Re-probing
			// `genericAliases` by name is last-wins across files — so for a name two files declare
			// differently the cycle verdict is read off a stranger's instance, and the E3091 anchor this
			// index feeds points at a declaration that may not be the cyclic one.
			let gid = entry.internedInstance()

			if (try onCycle.get(gid) otherwise panic("firstCyclicAliasDecl: alias '{String.from(entry.aliasName)}' names instance {gid}, outside the interner's own instance space")) 'cyclic'
				blamed = self.earlierBlame(blamed, candidate: i)
			end 'cyclic'
		end 'eachDecl'

		return blamed
	end 'firstCyclicAliasDecl'

	// The "instance ⇒ the instances its type arguments denote" graph, over the dense `GenericInstanceId`
	// space. BOTH edge kinds — a nested `genericInstance` argument, and a `named` leaf that names an alias —
	// are the one question `denotedInstance` answers, so this walk asks it (through
	// `denotedInstanceUnlessContested`, which drops a contested name) rather than restating the alias
	// lookup: the cycle check and the identity read traverse ONE graph rather than two views of it, and a
	// `named` leaf the alias door starts (or stops) resolving cannot become an edge here and not there.
	//
	// Built through the shared counting sort (`buildCsr`) like every other adjacency in this compiler, and
	// for the reason its header gives: a per-node array would be one refcounted heap object per instance.
	function buildInstanceArgGraph() returns CsrGraph
		let argOf = CsrColumn.create(0)
		let denotes = CsrColumn.create(0)

		for gid in 0 upto self.rowCount() 'eachInstance'
			for position in 0 upto self.genericInstanceArgCount(gid) 'eachArg'
				if let denoted = try self.denotedInstanceUnlessContested(self.substitutedInstanceArg(gid, position: position)) 'denotesAnInstance'
					argOf.push(gid as CsrIndex)
					denotes.push(denoted as CsrIndex)
				end 'denotesAnInstance'
			end 'eachArg'
		end 'eachInstance'

		return buildCsr(argOf, to: denotes, nodeCount: self.rowCount() as CsrIndex)
	end 'buildInstanceArgGraph'

	// ⭐⭐ **THE ALIAS NAMES ON THE CYCLE DECLARATION `index` CLOSES, IN WALK ORDER — or EMPTY when the
	// instance graph proves no cycle through it.** `specs/type-checking.md` states the diagnostic as
	// `Circular typealias dependency: A -> B -> A`, so the PATH is part of the answer rather than decoration:
	// it is the only thing that tells the mutual shape from the self one, and the canonical corpus has a case
	// for each. A message naming only the alias it was reported against says identical words for both.
	//
	// ⚠ **AN EMPTY ANSWER IS A REAL ANSWER, AND IT SELECTS THE OTHER DIAGNOSTIC.** `firstCyclicAliasDecl` has
	// a second door — a CROSS-FILE cycle this graph structurally cannot see, because it gives a contested
	// `named` argument no edge, caught instead by the contest fixpoint failing to converge
	// (`divergedGenericAliasDecl`). Nothing there proves a cycle or names its members, so there is no path to
	// render and `checkGenericAliasCycles` keeps E3091 and the sentence that says what IS known. The code and
	// the words follow from what the compiler can prove, and this function is what knows which.
	//
	// ⚠ **IT REBUILDS THE GRAPH, AND SCANS THE DECLARATION LIST PER NODE, DELIBERATELY** —
	// `instantiationAnchor`'s discipline and its reason: this is asked only once a cycle report is already
	// being written, never on a program that compiles, so an instance ⇒ alias index would cost every build to
	// serve none.
	export function aliasCyclePath(index FieldIndex) returns NameRoster
		let names = NameRoster.create(0)

		for gid in shortestCycleThrough(self.buildInstanceArgGraph(), start: self.genericAliasDeclAt(index).internedInstance() as CsrIndex) 'eachNodeOnTheCycle'
			// A NESTED instance (`Box with (Box with A)`) is interned but no `typealias` spells it, so it
			// has no name to contribute — the path names the declarations the author can go and edit.
			let name = try self.aliasNamingInstance(gid as GenericInstanceId) otherwise continue

			names.push(name)
		end 'eachNodeOnTheCycle'

		return names
	end 'aliasCyclePath'

	// The alias that NAMES an interned instance; `absent` when none does. Linear over the declaration
	// list for `aliasCyclePath`'s stated reason.
	function aliasNamingInstance(gid GenericInstanceId) returns immutable ByteArray throws AbsentError
		for i in 0 upto self.settledDeclarations().genericAliasDecls.count() 'eachDecl'
			let entry = try self.settledDeclarations().genericAliasDecls.get(i) otherwise panic("aliasNamingInstance: genericAliasDecls.get OOB at {i}")

			if entry.internedInstance() == gid 'namesIt'
				return entry.aliasName
			end 'namesIt'
		end 'eachDecl'

		throw AbsentError.absent
	end 'aliasNamingInstance'

	// The declaration record of alias `index`, for the cycle diagnostic's name and anchor.
	export function genericAliasDeclAt(index FieldIndex) returns GenericAliasEntry
		return try self.settledDeclarations().genericAliasDecls.get(index) otherwise panic("genericAliasDeclAt: genericAliasDecls.get OOB at {index}")
	end 'genericAliasDeclAt'

	// --- Bases without a `StructLayout`: the ONE predicate, and the ONE reason there are two of them ---
	//
	// ⭐⭐ **"IS THIS BASE SYNTHESIZED?" AND "IS THERE A LAYOUT TO WALK?" ARE DIFFERENT QUESTIONS, AND
	// CONFLATING THEM IS WHAT CRASHED THE COMPILER.** A generic instance's base has no `StructLayout` for
	// exactly two reasons, and they are not the same reason:
	//
	//   • **SYNTHESIZED** — a base `isBuiltinGenericBaseName` accepts (`Array`, `FixedArray`, the
	//     `__ManagedList` chain). The compiler emits their runtime records itself, so no declared
	//     layout is read for them — `stdlib/Array.maxon` declares `Array`, but its record IS its
	//     buffer. The type is LEGAL and the program is fine; it simply has no fields.
	//   • **UNDECLARED** — `Foo with Int`, `Int with Int`. Nothing declares the base at all. The program is
	//     MALFORMED, and `checkGenericSpellings` reports E2055 against the `with` that wrote it.
	//
	// Every walk over an instance's fields must stop for BOTH, because in both cases there are no fields to
	// read.
	//
	// So the stop condition is `not genericInstanceHasBaseLayout(id)`, written once, and it is exactly
	// `baseLayoutOf`'s precondition. The synthesized half keeps its own name because two callers genuinely
	// need to tell the reasons apart rather than merely stop: `Parser.structLayoutOfType`, whose
	// diagnostic must say "a builtin with no fields YET" for one and "no such type" for the other, and the
	// per-builtin routers below (`genericInstanceBoxSize`, `genericInstanceBoxDropCallee`), which do not stop
	// at all — they answer each builtin container differently from the others.

	// Is `name` a BUILTIN generic base — one the compiler synthesizes rather than reads a declaration for, so no
	// `StructLayout` exists for it and none is missing. The ONE home of the builtin-container disjunction —
	// every door that means "a container this compiler owns" asks here rather than re-spelling the names. (No
	// COUNT of them is written into that sentence: a roster kept in prose has nothing checking it.) It is
	// spelled as the record's arm plus the rest so that
	// the narrower question below is not a second copy of the same list.
	export function isBuiltinGenericBaseName(name ByteArray) returns bool
		return self.isArrayBaseName(name) or self.isBuiltinGenericBaseNameBesidesTheRecord(name)
	end 'isBuiltinGenericBaseName'

	// ⭐⭐ **THE SAME DISJUNCTION WITHOUT ITS `Array` ARM — the set of container names the compiler SERVES ITSELF AND
	// WHOSE INSTANCES ARE NOT THE MANAGED RECORD.** The split exists for one caller,
	// `noteArrayLiteralConformer`, and it is not a convenience: that function RUNS the discovery
	// `corpusArrayRecordName` is the answer to, so it cannot ask `isArrayBaseName` — the state it would read
	// is the one being built. Every arm here is a bare name comparison against a constant this file exports,
	// so it answers the same at any point in the compile.
	//
	// ⛔⛔ **WHAT IT KEEPS OUT, AND IT WAS A MEASURED WRONG ANSWER RATHER THAN A HAZARD.** `isArrayBaseName`'s
	// non-corpus widening admits ANY name a program declares `BuiltinArrayLiteral` on, which is right for a
	// user's own `Bag` and wrong for a name this compiler already serves a container under. **MEASURED on
	// `main` with no compiler edit at all**, from a user file declaring
	// `type FixedArray uses Element implements BuiltinArrayLiteral` beside an ordinary
	// `typealias Vec3 = FixedArray with 3 Num`: `Parser.dispatchMethodOnReceiver` asks the ARRAY arm before the
	// fixed array one, so `Vec3.create()` reported **count 0**, four `push`es took it to **4** and `resize(9)` to
	// **9** — a fixed-size container grown through its own type's name, no diagnostic. The `List` twin is the
	// same program with the name changed: `resize(9)`, a member the list roster does not carry, answered 9.
	//
	// ⚠ **AND THE OTHER HALF OF THE SAME FACT IS A TREE-WIDE REFUSAL, WHICH IS WHY ONE PREDICATE SERVES
	// BOTH.** A SECOND STDLIB conformer takes `corpusArrayRecordName` outright (last-stdlib-wins, see
	// `noteArrayLiteralConformer`), so listing `stdlib/FixedArray.maxon` made `isArrayBaseName(b"Array")` answer
	// FALSE and refused `stdlib/Array.maxon:111`'s own identity — `function main() returns ExitCode /
	// return 7` failed to compile. Loud where the user route is silent; one cause.
	//
	// ⚠ The `__`-prefixed three cannot be reached from a USER file (`Parser.requireUnreservedName`), and they
	// are here anyway because the set is the CLASS: `stdlib/Builtins.maxon` is the one module allowed those
	// names, so a corpus edit is exactly the route the `FixedArray` half of the measurement above came in by.
	//
	// ⛔⛔ **THIS IS NOT A FREE-STANDING ROSTER — `isBuiltinGenericBaseName` DERIVES FROM IT, SO A NAME ADDED
	// HERE JOINS THE SYNTHESIZED SET TOO, AND THAT SET'S CONSUMERS PANIC.** The membership rule for the wide
	// predicate is "the compiler SYNTHESIZES it, so no `StructLayout` exists"; the rule here is "the compiler serves a
	// container under the name and its instances are not the managed record". Today those two coincide on
	// every name but `Array`, which is what makes the derivation legal — they are not the same rule, and the
	// next container to be LISTED is where they come apart. **MEASURED (review)**: one extra arm here
	// for `Set` — a name the compiler still composes `Set.create` / `Set from […]` / `contains` from, but which
	// `stdlib/Set.maxon` DECLARES — turns an ordinary `typealias NumSet = Set with Num` into
	// `panic … builtinGenericTypeParamCount: 'Set' is not a synthesized builtin generic`, out of
	// `checkGenericSpellings`, on the first program compiled. `instanceCreateIsDeclared` and
	// `genericInstanceBoxDropCallee` read the wide predicate the same way.
	//
	// ⇒ **The panic is the reason this is a note and not a defect: the coupling is LOUD and immediate.** A
	// name that belongs in the narrow question but NOT in the synthesized one cannot be added here — it needs
	// the two rosters separated first, with the shared five lifted into a helper both read.
	//
	// ⭐⭐ **`List` IS NOT IN THIS DISJUNCTION.** The two rules
	// the block above says *"come apart at the next container to be LISTED"* did not have to come apart for
	// it: `stdlib/List.maxon` DECLARES `type List uses Element`, so the compiler neither synthesizes the record nor
	// serves the container, and `List` leaves BOTH questions at once — exactly as `Map` and `Set`
	// did. Striking the arm is therefore the entire edit at this door, and it moves five further answers with
	// it because each DERIVES from this one rather than repeating it: `instanceCreateIsDeclared` flips to
	// true, `builtinGenericTypeParamCount` reads the declaration's own `uses` list, `genericInstanceBoxSize`
	// reads the declared `StructLayout`, `genericInstanceBoxDropCallee` emits the instance's own
	// `__destruct_<mangled>` cascade, and `Parser.requireContainerIsCreatable` stops claiming `List.create()`.
	//
	// ⚠ **`__ManagedList` AND `__ManagedListNode` STAY, and that is not a leftover.** They are the
	// compiler-owned chain `stdlib/List.maxon` is written OVER (`var chain as __ManagedList with Element`),
	// `/specs/internal-types.md` puts their representation in the compiler, and no corpus file declares
	// either. The chain runtime they are served by is the same one — see `ListRuntime.maxon`.
	export function isBuiltinGenericBaseNameBesidesTheRecord(name ByteArray) returns bool
		return self.isFixedArrayBaseName(name) or self.isManagedListBaseName(name) or self.isManagedListNodeBaseName(name) or self.isManagedMemoryCursorBaseName(name)
	end 'isBuiltinGenericBaseNameBesidesTheRecord'

	// ⭐ **HOW MANY TYPE ARGUMENTS THE SYNTHESIZED GENERIC `name` TAKES** — the arity `checkGenericSpellings`
	// validates a `Base with …` against when there is no declaration to read one off.
	//
	// It sits DIRECTLY BESIDE the predicate above, and takes its precondition from it, because the two are one
	// fact: a per-builtin arm in `verdictOfDenotedBase` spelling the predicate and the count
	// together makes a new builtin generic two lists to widen in two files. Here the miss arm
	// is a `panic` naming the omission, so a name that answers yes above and has no arity here cannot compile a
	// program at all rather than silently skipping its arity check.
	export function builtinGenericTypeParamCount(name ByteArray) returns FieldIndex
		if self.isArrayBaseName(name) 'array'
			return ArrayTypeParamCount
		end 'array'

		// ⚠ **A `FixedArray`'s SIZE IS NOT COUNTED HERE, and that is what makes this arm a 1 rather than a 2.**
		// `FixedArray with 3 Int` supplies one TYPE argument; the 3 is consumed by `readSizedBaseElementCount` before
		// the argument list is parsed at all, so the `argCount` this is compared against never saw it.
		if self.isFixedArrayBaseName(name) 'fixedArray'
			return FixedArrayTypeParamCount
		end 'fixedArray'

		if self.isManagedListBaseName(name) 'managedList'
			return ManagedListTypeParamCount
		end 'managedList'

		if self.isManagedListNodeBaseName(name) 'managedListNode'
			return ManagedListNodeTypeParamCount
		end 'managedListNode'

		if self.isManagedMemoryCursorBaseName(name) 'managedMemoryCursor'
			return ManagedMemoryCursorTypeParamCount
		end 'managedMemoryCursor'

		panic("ProgramSignatures.builtinGenericTypeParamCount: `{String.from(name)}` is not a synthesized builtin generic — every caller opens with isBuiltinGenericBaseName, and a name that answers yes there owes an arity here")
	end 'builtinGenericTypeParamCount'

	export function declaresABaseRefusingTypeArgumentCount(base ByteArray, count ElementIndex) returns bool
		match self.structInAnyFile(base) 'declaration'
			declared(layout) then return not layoutAdmitsTypeArgumentCount(layout, count: count)
			undeclared then return false
		end 'declaration'
	end 'declaresABaseRefusingTypeArgumentCount'

	// Does instance `id`'s base struct have a declared `StructLayout` to read fields out of — the exact
	// precondition of `baseLayoutOf`, and the gate every instance FIELD WALK opens with. False for a
	// synthesized builtin (no declaration to carry one), for an undeclared base (E2055 already reported),
	// and for a type-argument count the base refuses (E2056 already reported).
	export function genericInstanceHasBaseLayout(id GenericInstanceId) returns bool
		let baseName = self.genericInstanceBaseName(id)

		if self.isBuiltinGenericBaseName(baseName) or not self.containsStructInAnyFile(baseName) 'noDeclaredBase'
			return false
		end 'noDeclaredBase'

		return not self.declaresABaseRefusingTypeArgumentCount(baseName, count: self.genericInstanceArgCount(id))
	end 'genericInstanceHasBaseLayout'

	// Is instance `id`'s base one this compiler KNOWS AT ALL — a builtin it synthesizes, or a `type` some
	// file declares. The UNDECLARED third of the split above, on its own.
	//
	// ⚠ **THIS IS NOT `genericInstanceHasBaseLayout` AND MUST NOT BE COLLAPSED INTO IT: THE TWO DISAGREE ON A
	// BUILTIN, WHICH IS KNOWN AND HAS NO FIELDS.** They are the preconditions of two different queries, and
	// each query needs its own:
	//
	//   • a FIELD WALK needs a layout, so `Array` stops it — `genericInstanceHasBaseLayout`.
	//   • `genericInstanceBoxSize` answers for a builtin (the fixed record) AND for a declared base (its
	//     box), and has nothing to say only for NEITHER — this one.
	//
	// Measured on the door that needed it: `sizeof(IntMap)` for `typealias IntMap = Map with (Int, Int)` died
	// inside `genericInstanceBoxSize` with a stack trace and no `error E….`, because `sizeof` folds at PARSE
	// time and the E2055 `checkGenericSpellings` reports comes whole-program, later.
	export function genericInstanceBaseIsKnown(id GenericInstanceId) returns bool
		let baseName = self.genericInstanceBaseName(id)
		return self.isBuiltinGenericBaseName(baseName) or self.containsStructInAnyFile(baseName)
	end 'genericInstanceBaseIsKnown'

	// --- Generic-instance managed drop ---
	//
	// A generic instance is a monomorphized base struct: its box is `Box`'s box, and a managed type
	// argument is MOVED into it (consumed at the concrete call site), so the box OWNS that content and
	// `__destruct_<mangled-instance>` drops it exactly once. These queries substitute the instance's args
	// for the base struct's type parameters and answer the drop cascade's three questions — is a field
	// managed, what drops it, at what offset — over THIS index's own interner (the args and the base
	// layout's field types both live in `self.typeNames`), so a caller never has to choose the interner.

	// The `StructLayout` of instance `id`'s base struct. Precondition: `genericInstanceHasBaseLayout(id)` —
	// an instance is interned for ANY base a `with` names, declared or not, so the caller opens the walk with
	// that gate. See its header for the two ways a base has no layout and why they are one stop condition.
	export function baseLayoutOf(id GenericInstanceId) returns StructLayout
		let baseName = self.genericInstanceBaseName(id)
		return try self.registeredLayout(baseName) otherwise panic("ProgramSignatures.baseLayoutOf: generic instance {id}'s base struct '{String.from(baseName)}' has no declared layout — every field walk opens with genericInstanceHasBaseLayout")
	end 'baseLayoutOf'

	// The fields of instance `id`'s record that hold a `__ManagedMemoryCursor` — what makes a record an ARRAY
	// iterator, whose position is an index into one buffer.
	export function managedCursorFieldsOf(id GenericInstanceId) returns CursorFieldIndexArray
		let fields = CursorFieldIndexArray.create(0)

		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToHoldOne'
			return fields
		end 'noFieldsToHoldOne'

		for index in 0 upto self.baseLayoutOf(id).fieldTypes.count() 'eachField'
			let fieldType = self.substituteInstanceFieldType(id, index: index as FieldIndex)

			if maxonTypeTag(fieldType) == ValueTypeTag.genericInstance and self.genericInstanceBaseName(genericInstanceIdOf(fieldType)).equals(ManagedMemoryCursorBuiltinBaseName) 'aCursorField'
				fields.push(index as FieldIndex)
			end 'aCursorField'
		end 'eachField'

		return fields
	end 'managedCursorFieldsOf'

	// ⭐ **THE SUBSCRIPT AN OPAQUE `typeParameter` TYPE STANDS FOR — the ONE door from a type-parameter TOKEN to
	// an instance-argument INDEX.** Every instance query below is subscripted by a POSITION in the
	// declaring type's `uses` list, and a `typeParameter`'s payload is an IDENTITY rather than that
	// position (see `MaxonDialect.TypeParamId` for the collision the position was). This is where the two meet,
	// and it is written once so that no caller re-derives it — `managedOpaqueArrayElementOf` and
	// `SemanticCheck.checkTypeParameterArgsAt` subscript through here.
	//
	// ⚠ **`substituteThroughInstance` DELIBERATELY DOES NOT, AND THAT IS NOT A SECOND DERIVATION.** It reads the
	// whole `TypeParamOwner` record because it needs the OWNER as well as the position — a token belonging to
	// another declaration must pass through unchanged rather than be indexed into this instance's argument list.
	// This function cannot answer that, by construction: it projects the record down to the position alone.
	//
	// A miss is an invariant break rather than a case: every token reaching an instance query was minted inside
	// a declaration the sweep folded, and `recordStruct` files a declaration's parameters ahead of every reason
	// it might drop the layout.
	export function opaqueTypeParamPosition(t MaxonType) returns ElementIndex
		if maxonTypeTag(t) != ValueTypeTag.typeParameter 'notATypeParameter'
			panic("ProgramSignatures.opaqueTypeParamPosition: asked for the `uses`-list position of a `{typeTagName(maxonTypeTag(t))}`, which names no type parameter — every caller tests the tag first")
		end 'notATypeParameter'

		return (try self.typeParamOwnerOf(typeParamIdOf(t)) otherwise panic("ProgramSignatures.opaqueTypeParamPosition: type-parameter token {typeNameIdOf(t)} has no owner — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds, so a token with none was minted inside a declaration neither fold saw")).position
	end 'opaqueTypeParamPosition'

	// ⭐ **IS THIS OPAQUE FORMAL A PARAMETER OF `typeName`'s OWN `uses` LIST?** — the record's OWNERSHIP half,
	// projected exactly as the function above projects its POSITION half, so a caller holding a token and a
	// declaration name never opens the record itself. A caller that needs both reads the record directly
	// (`substituteThroughInstance`), which is one lookup rather than two.
	//
	// A miss is an invariant break for `opaqueTypeParamPosition`'s reason: every token reaching an instance
	// query was minted inside a declaration the sweep folded.
	export function opaqueTypeParamDeclaredBy(t MaxonType, typeName ByteArray) returns bool
		if maxonTypeTag(t) != ValueTypeTag.typeParameter 'notATypeParameter'
			panic("ProgramSignatures.opaqueTypeParamDeclaredBy: asked which declaration owns a `{typeTagName(maxonTypeTag(t))}`, which names no type parameter — every caller tests the tag first")
		end 'notATypeParameter'

		return (try self.typeParamOwnerOf(typeParamIdOf(t)) otherwise panic("ProgramSignatures.opaqueTypeParamDeclaredBy: type-parameter token {typeNameIdOf(t)} has no owner — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds, so a token with none was minted inside a declaration neither fold saw")).declaringTypeName.equals(typeName)
	end 'opaqueTypeParamDeclaredBy'

	// ⭐⭐ **THE INSTANCE VIEW OF A TYPE THE SHARED GENERIC BODY SPELLS IN ITS DECLARATION VIEW — the ONE
	// substitution, read by every door that meets the two views at once.** The compiler compiles ONE body per
	// generic type, so a field, a parameter or a return inside `type HoldA uses T` is written in terms
	// of `T`, of `Self`, and of instances OVER those (`Array with T`) — and a concrete `HoldA with Num`
	// receiver fixes every one of them. Three doors need that answer, and each would otherwise hold its own,
	// shorter version of it:
	//
	//   • the DROP CASCADE (`substituteInstanceFieldType` below) — what a field holds, so what destroys it;
	//   • the FIELD READ (`Parser.emitFieldLoad`) — the type of the value a `b.items` produces;
	//   • the ARGUMENT CHECK (`SemanticCheck.checkArgTypes`) — the type a parameter accepts at this call.
	//
	// ⛔ **ALL THREE STOPPED AT A BARE `typeParameter`, AND THE PROGRAM THAT FALLS THROUGH THE GAP IS A LEGAL
	// ONE.** A field typed through an inner `typealias Items = Array with T` is a `genericInstance`,
	// not a `typeParameter`, so it was never substituted at all: `b.items` on a `HoldA with Num` kept
	// the shared body's `Array with T`, and handing it to `adopt(other Items)` on another `HoldA with
	// Num` was **`E3005: expected 'HoldANum.Items', got 'HoldA.Items'`** — a program handing a value
	// to a parameter of its own type, refused, though the language permits it. The other half of the
	// same gap is worse than a refusal: two DIFFERENT instances of one base (`HoldA with Num` and
	// `HoldA with String`) both read as `HoldA.Items`, so the wrong one is ACCEPTED into a field the
	// box then destroys under the other's element type.
	//
	// ⭐ **SUBSTITUTION RECURSES INTO `genericInstance` ARGUMENT LISTS**:
	// `Array with (Pair with Element)` becomes `Array with (Pair with Int)` under `Element -> Int`,
	// and the result is re-INTERNED, because the substituted instance may be a type the program never
	// spells. Interning is
	// keyed structurally, so the mint is idempotent and two doors substituting the same pair reach the
	// same `GenericInstanceId`; that identity is what lets the argument check compare them at all.
	//
	// ⚠ **THE `typeParameter` ARM IS GUARDED BY ITS OWNER, WHICH `opaqueTypeParamPosition` ALONE CANNOT BE.**
	// A parameter token identifies `(declaring type, parameter name)`, so `HoldA`'s `U` and `HoldB`'s
	// `V` are different tokens — and a token belonging to another declaration must pass through UNCHANGED
	// rather than be indexed into this instance's argument list by position. No caller can reach that today
	// (a body only ever spells its own parameters), which is exactly why the guard belongs to the function and
	// not to its callers.
	//
	// ⭐ **IT IS INTERNER-FREE, AND THAT IS WHY EVERY CALLER MAY HAND IT ITS OWN FILE'S TYPES.** Both arms key
	// on a WHOLE-PROGRAM payload — a `typeParameter` carries its `(declaring type, parameter name)` digest and
	// a `genericInstance` carries a registry id — while the type HANDED IN, whatever its tag, is only ever
	// read for those two. A `named` or a `structRef` at the top level is passed straight back. Inside an
	// interned instance's ARGUMENT list exactly two spellings resolve further: a `named` that denotes a LIVE
	// generic alias (`substituteArgThrough`) and a TUPLE `structRef` (`substituteThroughInstanceInterned`,
	// which hands every other `structRef` back unchanged). Both read THIS index's tables, which is where an
	// interned instance's arguments live in the first place — never a caller's.
	export function substituteThroughInstance(t MaxonType, id GenericInstanceId) returns MaxonType
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.typeParameter 'opaqueFormal'
			let owner = try self.typeParamOwnerOf(typeParamIdOf(t)) otherwise panic("ProgramSignatures.substituteThroughInstance: type-parameter token {typeNameIdOf(t)} has no owner — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds, so a token with none was minted inside a declaration neither fold saw")

			if not owner.declaringTypeName.equals(self.genericInstanceBaseName(id)) 'anotherDeclarationsParameter'
				return t
			end 'anotherDeclarationsParameter'

			return self.substitutedInstanceArg(id, position: owner.position)
		end 'opaqueFormal'

		if tag != ValueTypeTag.genericInstance 'carriesNoDeclarationView'
			return t
		end 'carriesNoDeclarationView'

		return self.substituteInstanceArgsThrough(genericInstanceIdOf(t), through: id, aliasHops: 0)
	end 'substituteThroughInstance'

	// The `genericInstance` arm of the substitution above: each argument resolved and substituted in turn
	// (`substituteArgThrough`), then the result RE-INTERNED so `Array with T` under `T -> Num` becomes the one
	// `Array with Num` every other door reaches.
	//
	// It returns the ORIGINAL instance when no argument moved, and that early return is what keeps the common
	// case allocation-free in the two senses that matter: a concrete field type (`Array with Item`) neither
	// mints a `MaxonType` box nor builds an intern key, and — because the answer is the same object — the field
	// read's caller can tell "this needed no instance view" from the answer itself rather than from a second
	// predicate over the same shape.
	//
	// ⛔ **AN ARGUMENT THAT IS A TUPLE CROSSES THROUGH THE INTERNED DOOR, NOT THE INTERNER-FREE ONE.** A
	// tuple is the one `structRef` whose identity CITES the declaring type's parameters, and
	// `substituteThroughInstance` passes every `structRef` through untouched because it has no name table. Asked
	// on an ARGUMENT that is a tuple, that silence is a wrong type rather than a missing optimization:
	// `Array with Map.Entry` under `Map -> (String, int)` stayed `Array with Map.Entry`, so the element of the
	// array `Iterable.map` returns never became concrete. MEASURED on `m.map(function(p) gives p)` — the closure
	// was typed with the DECLARATION-view tuple and refused against a correctly substituted parameter,
	// `expected 'fn(__Tuple2.String.int) …', got 'fn(__Tuple2.Tfcd8090be60770aa.T5d84c0fc6312cff6) …'`.
	//
	// The index's OWN interner is the right table here and needs no caller to supply one:
	// `instanceArgs` answers in this index's space, which is the same space
	// `substituteTupleThroughInstance` interns its result into. ⭐⭐ **A DECLARATION'S OWN `Self` IS
	// SIZE-POLYMORPHIC — IT ADOPTS THE RECEIVER'S COUNT, OR ITS RUNTIME-SIZED SHAPE.** A
	// `FixedArray`'s identity has a SECOND coordinate the args do not carry
	// (`GenericInstanceRegistry.fixedSizes`, see `FixedArrayBuiltinBaseName`), and `Self` inside `type
	// FixedArray uses Element` states none: it is `ownRecordSelfInstance`, interned `unsized`. So
	// substituting `Self` through a receiver mints `FixedArray_Int` while every value a program holds
	// is a `Vec3` — different keys, different ids, and a corpus method's `self` parameter that can
	// never match its own receiver (**`E3005 argument type mismatch for 'self': expected
	// 'FixedArray_Int', got 'Vec3'`**). ⇒ **the countless instance takes the count (or the
	// runtime-sized shape) of the receiver it is being viewed through.** One body serves every size,
	// which is cure (1) of the two `FixedArrayBuiltinBaseName` names; cure (2) — monomorphizing the
	// body per size — costs one copy of every member per distinct count in the program.
	//
	// ⚠ **IT IS NOT SIZE ERASURE, AND THE THREE CLAUSES ARE WHAT KEEP IT FROM BEING.** The count is
	// adopted only when the viewed instance STATES NO COUNT and is not runtime-sized (so a `FixedArray
	// with 4 Element` field keeps its 4, which is
	// `fixed-array.capacity-is-part-of-instance-identity`), only when it shares the receiver's BASE
	// (so a `FixedArray`'s own `Array with Element` buffer is untouched), and only from a receiver
	// that HAS a count or is runtime-sized. Two SIZED instances are never compared through here, so
	// `fixed-array.error.wrong-size-fixed-array-argument` goes on being refused: passing a `Vec3`
	// where a `Vec4` is declared is still two types.
	function substitutedShape(nested GenericInstanceId, through GenericInstanceId) returns InstanceShape
		let own = self.rowShape(nested)

		if own.isSized() or own.isRuntimeSized() or own.qualifiesArgs() 'itStatesItsOwnShape'
			return own
		end 'itStatesItsOwnShape'

		let viewed = self.rowShape(through)

		if (viewed.isSized() or viewed.isRuntimeSized()) and self.rowBaseId(nested) == self.rowBaseId(through) 'theSameSizedContainer'
			return viewed
		end 'theSameSizedContainer'

		return self.frozenArgsCarriedThrough(nested, through: through)
	end 'substitutedShape'

	function frozenArgsCarriedThrough(nested GenericInstanceId, through GenericInstanceId) returns InstanceShape
		let viewed = self.rowShape(through)

		if not viewed.qualifiesArgs() 'nothingToCarry'
			return InstanceShape.unsized
		end 'nothingToCarry'

		var carried = ArgQualifierMasks.none()

		for (iter, arg) in self.rowArgs(nested).withIterator() 'eachArg'
			let position = try self.typeParameterPositionIn(through, declared: arg) otherwise continue

			carried = carried.qualifying(iter.index() as FieldIndex, qualifier: viewed.argQualifierAt(position))
		end 'eachArg'

		return carried.shape()
	end 'frozenArgsCarriedThrough'

	function substituteInstanceArgsThrough(nested GenericInstanceId, through GenericInstanceId, aliasHops AliasHopCount) returns MaxonType
		let args = self.rowArgs(nested)
		let substituted = MaxonTypeArray.create(args.count(), zeroed: false)
		var moved = false

		for arg in args 'eachArg'
			let next = self.substituteArgThrough(arg, through: through, aliasHops: aliasHops)

			if not maxonTypesDenoteSame(next, b: arg) 'argMoved'
				moved = true
			end 'argMoved'

			substituted.push(next)
		end 'eachArg'

		// The fixed size travels with the re-intern for `GenericInstanceRegistry.intern`'s stated reason: a
		// caller re-interning an instance it already holds must carry every component of its key, and the one
		// silence can lose is this one. Which size that is, for a declaration's own `Self`, is
		// `substitutedShape`'s answer rather than the nested instance's own.
		let size = self.substitutedShape(nested, through: through)

		// ⚠ **THE EARLY RETURN TESTS BOTH COORDINATES, NOT ONLY THE ARGS.** A `FixedArray`'s identity is
		// (base, args, SIZE), so a substitution that moves no argument can still move the instance — the
		// declaration's own `Self` over its own parameter, reached through a receiver of that same parameter
		// at a stated count. Testing `moved` alone returned the countless instance for exactly that case.
		if not moved and size.sameAs(self.rowShape(nested)) 'nothingMoved'
			return MaxonType.genericInstance(nested)
		end 'nothingMoved'

		let substitutedId = self.internRow(self.rowBaseId(nested), args: substituted, shape: size)

		// ⭐ The instance this mints was written by nobody — `through` is the construct that forced it into
		// existence, and the only one an author can be shown. See `SubstitutedInstanceOriginMap`, including
		// why the edge is first-write-wins and why the `moved` early return above is what keeps this off the
		// path a concrete field type takes.
		self.recordSubstitutionOrigin(substitutedId, through: through)
		return MaxonType.genericInstance(substitutedId)
	end 'substituteInstanceArgsThrough'

	// The one writer of `substitutedInstanceOrigins`: first write wins.
	function recordSubstitutionOrigin(instance GenericInstanceId, through GenericInstanceId)
		if self.holdsOrigin(instance) 'alreadyOriginated'
			return
		end 'alreadyOriginated'

		self.substitutedInstanceOrigins.upsert(instance, value: through)

		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteOrigin(instance)
		end 'pastTheBaseline'
	end 'recordSubstitutionOrigin'

	// ⭐⭐ **ONE TYPE ARGUMENT, SUBSTITUTED — AND RESOLVED FIRST WHEN IT IS AN ALIAS NAME.** A generic alias
	// written as a bare NAME reaches its enclosing instance as a `named` LEAF: `resolveArgNode` records a type
	// argument during the declaration SWEEP, where `parseTypeReference`'s alias arms are shut off by
	// `allFilesFolded` so that no recorded type can depend on the order the files were walked in. So
	// `typealias EBoxArray = Array with EBox` interns as `Array with named("Bag.EBox")` where the inline
	// `Array with (Box with Element)` interns a real nested instance — and `substituteThroughInstance` passes
	// a `named` through untouched. Without the resolution below, the `Element` inside such an argument is
	// unreachable and every reader of the alias-spelled slot gets the DECLARATION view.
	//
	// ⭐ **THE RESOLUTION IS `liveGenericAliasInstance`, WHICH IS ALSO THE CLONE GATE'S**, so the two
	// reader-free roads cannot come to mean two different declarations of one contested name. It FAILS
	// CLOSED: a genuinely contested spelling panics rather than resolving last-wins, which is what this door
	// needs, its answer being a TYPE a program is checked against — two files' `typealias Bag` may be an
	// `Array with String` and an `Array with Num`.
	//
	// ⚠ **THE ORIGINAL SPELLING IS HANDED BACK WHENEVER THE INSTANCE FIXES NOTHING IN THE ARGUMENT**, so an
	// alias naming no type parameter keeps the id it was interned with. That is what holds the repair inside
	// the case it repairs: nothing that already compiled mints a different instance, a different canonical
	// name or a different `__destruct_` symbol.
	//
	// ⛔ **THE HOP BOUND IS WHAT MAKES A SELF-REFERENTIAL ALIAS TERMINATE.** The PARSE substitutes and the
	// alias cycle check runs after it — `canonicalNameWithin` carries a path guard for the same reason — so
	// `typealias Cyc = Array with Cyc` reached through a concrete receiver follows its own edge until the host
	// stack is gone. Every hop consumes one key of `genericAliases`, so a chain with more hops than that map
	// has keys has revisited one; leaving the argument unresolved there terminates, is a property of the
	// program rather than of the asking site, and gets the compile as far as whatever refuses it. Syntactic
	// nesting closes no loop and does not count against the bound.
	function substituteArgThrough(arg MaxonType, through GenericInstanceId, aliasHops AliasHopCount) returns MaxonType
		if maxonTypeTag(arg) != ValueTypeTag.named 'spellsNoAlias'
			return self.substituteThroughInstanceInterned(arg, id: through, interner: self.typeNames)
		end 'spellsNoAlias'

		if aliasHops >= self.settledDeclarations().genericAliases.count() as AliasHopCount 'moreHopsThanTheAliasTableHasKeys'
			return arg
		end 'moreHopsThanTheAliasTableHasKeys'

		let denoted = try self.liveGenericAliasInstance(self.nameOfId(typeNameIdOf(arg))) otherwise return arg
		let substitutedArg = self.substituteInstanceArgsThrough(denoted, through: through, aliasHops: aliasHops + 1)
		return arg if genericInstanceIdOf(substitutedArg) == denoted else substitutedArg
	end 'substituteArgThrough'

	// ⭐⭐ **A TUPLE'S INSTANCE VIEW — the third declaration-view shape, and the ONE that cannot ride
	// `substituteThroughInstance`.** `type MyMap uses Key, Value` and `type MyMapIterator uses Key, Value`
	// each write `typealias Entry = (Key, Value)`, and those are two DIFFERENT tuple types —
	// correctly so, because each cites its own declaring type's parameters (`__Tuple2.T7ec….T240…` against
	// `__Tuple2.Tf5a….T8af…`). They are the SAME type only at an instantiation that fixes both, which is
	// exactly what this reduces: `MyMapIterator.Entry` through a `MyMapIterator with (MyMap.Key, MyMap.Value)`
	// receiver IS `MyMap.Entry`. MEASURED without the reduction, on a shadow-renamed `stdlib/Map.maxon`:
	// **`E3005 stdlib/Interfaces.maxon:211:12: argument type mismatch for 'value': expected
	// '__Tuple2.T7ec7c1d76425e7ce.T240e2d961d3637ba', got '__Tuple2.Tf5ab22f57cf9dbd8.T8afb890bfc18c8d0'`** —
	// a sentence naming one type twice, the signature of a missing substitution.
	//
	// ⚠ **IT TAKES A NAME AND ANSWERS A NAME, AND THAT IS WHAT KEEPS `substituteThroughInstance` INTERNER-FREE.**
	// A tuple is a `structRef`, whose payload is an INTERNER-LOCAL id — the one arm that substitution passes
	// through untouched precisely because it would need a name table, and its three callers hold three
	// different ones. A tuple's IDENTITY is its canonical NAME, which is whole-program, so the name is what
	// crosses and the ids stay home. It is `typeArgAggregateName`'s discipline: both steps inside, so the
	// pairing is structural rather than conventional.
	//
	// ⚠ The elements are re-interned through `internTupleType`, which is what makes the answer the SAME name
	// every other door reaches for that element list rather than a second spelling of it. A rejection is an
	// invariant break, not a user error: every element came out of a layout this index already registered and
	// was only substituted, so an element that fails the tuple-element rule now failed it at the declaration.
	// ⭐⭐ **EVERY TUPLE LAYOUT THE WHOLE-PROGRAM INDEX HOLDS — because a SUBSTITUTED one is in no file's
	// artifact and so reaches `project.structTypes` through nothing.**
	//
	// A tuple the source SPELLS is interned while its file is parsed, lands in that file's
	// `artifact.structTypes`, and `ParseStaging.commitStructTypes` copies it into the project registry that
	// `MmRuntime.installStructDestructors` walks. A tuple minted by SUBSTITUTION has neither half: it is
	// created by `substituteTupleThroughInstance` at a CALL SITE, straight into this index, and no artifact
	// ever carries it.
	//
	// ⚠ **MEASURED, and the symptom is a compiler panic rather than a diagnostic**: with the corpus `Map`
	// live, `for (_, value) in m` over a `["a": 10]` walks `MapIterator.current()`, whose declared `Entry =
	// (Key, Value)` substitutes to `__Tuple2.String.int`. The parser emits the drop call for it; nothing
	// synthesizes the body; the backend stops at
	// `resolveCallFixups: call to unknown function '__destruct___Tuple2.String.int'`. A plain
	// `function pair() returns (String, Num)` in the same tree compiles and runs, which is what localizes it
	// to the substituted mint and not to tuples.
	//
	// It answers with the LAYOUTS rather than with the names, because its one caller needs the field list to
	// synthesize a cascade and a name would only send it back here. ⚠ **ONE CALLER, TWICE PER COMPILE**: the
	// clone side reads the same roster (`MmRuntime.installStructRuntimeEntries`) — once for the drop
	// entries and once for the clone entries, each behind that installer's own "is anything referenced at all"
	// gate, so a program that neither drops nor clones still walks this registry zero times.
	export function tupleLayouts() returns SettledStructLayoutArray
		self.requireWholeProgramIndex("tupleLayouts")

		let out = SettledStructLayoutArray.create(0)

		for (name, slot) in self.structSlots 'eachRegisteredType'
			if isTupleTypeName(name) 'aTuple'
				out.push(self.ownLayoutAtSlot(slot))
			end 'aTuple'
		end 'eachRegisteredType'

		return out
	end 'tupleLayouts'

	export function substituteTupleThroughInstance(tupleName ByteArray, id GenericInstanceId) returns immutable ByteArray
		let layout = try self.registeredLayout(self.canonicalNameOfStruct(tupleName)) otherwise panic("ProgramSignatures.substituteTupleThroughInstance: `{String.from(tupleName)}` is not registered — every tuple `structRef` in the compiler was minted by `internTupleType`, which registers the layout before it hands the name back")

		let substituted = MaxonTypeArray.create(layout.fieldCount(), zeroed: false)
		let substitutedBrands = NameRoster.create(layout.fieldCount(), zeroed: false)
		let substitutedCapabilities = tupleItemCapabilitiesOf(layout)
		let written = self.writtenBrandsOf(layout, types: layout.fieldTypes)
		var moved = false

		for i in 0 upto layout.fieldCount() 'eachElement'
			let element = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.substituteTupleThroughInstance: fieldTypes.get OOB at {i} below count {layout.fieldCount()}")
			let next = self.substituteThroughInstanceInterned(element, id: id, interner: self.typeNames)

			if self.typeParameterIsFrozenIn(id, declared: element) 'aFrozenArgument'
				try substitutedCapabilities.set(i, value: ParamCapability.immutable) otherwise panic("ProgramSignatures.substituteTupleThroughInstance: set OOB at {i} below count {layout.fieldCount()}")
			end 'aFrozenArgument'

			if not maxonTypesDenoteSame(next, b: element) 'elementMoved'
				moved = true
				substitutedBrands.push(EmptySourceText)
				substituted.push(next)
				continue
			end 'elementMoved'

			substitutedBrands.push(try written.get(i) otherwise panic("ProgramSignatures.substituteTupleThroughInstance: written.get OOB at {i} below count {written.count()}"))
			substituted.push(next)
		end 'eachElement'

		// The ORIGINAL name when nothing moved — `substituteInstanceArgsThrough`'s early return, one shape over,
		// and for its reason: a fully concrete tuple neither re-interns nor builds a name, and the caller can
		// tell "this needed no instance view" from the answer being the same bytes it asked about.
		if not moved 'noElementMoved'
			return tupleName
		end 'noElementMoved'

		// ⚠ **A REFUSAL HERE IS AN INVARIANT BREAK AND NOT A USER ERROR.** Substitution replaces type parameters
		// with the concrete types an instance already interned, and `requireTupleElementType` refuses only an
		// unresolved or void element — neither of which an instance's arguments can be.
		return try self.internTupleType(substituted, written: substitutedBrands, capabilities: substitutedCapabilities, from: self.typeNames, slotScopeFilePath: layout.declFilePath) otherwise (rejection) 'refused'
			panic("ProgramSignatures.substituteTupleThroughInstance: the instance view of `{String.from(tupleName)}` was refused as a tuple element list: {tupleElementRejectionSentence(rejection)}")
		end 'refused'
	end 'substituteTupleThroughInstance'

	export function tupleNameHoldsAFrozenItem(name ByteArray) returns bool
		let walking = WalkedTupleNameSet.create()
		let layout = self.registeredTupleLayoutNamed(name)
		return self.tupleItemsHoldAFrozenItemBeneath(layout, walking: walking)
	end 'tupleNameHoldsAFrozenItem'

	export function instanceHoldsAFrozenTupleItem(id GenericInstanceId) returns bool
		let walking = WalkedTupleNameSet.create()
		return self.instanceHoldsAFrozenItemBeneath(id, walking: walking)
	end 'instanceHoldsAFrozenTupleItem'

	function tupleItemsHoldAFrozenItemBeneath(layout StructLayout, walking mutable WalkedTupleNameSet) returns bool
		for i in 0 upto layout.fieldCount() 'eachItem'
			let element = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.tupleItemsHoldAFrozenItemBeneath: fieldTypes.get OOB at {i} below count {layout.fieldCount()}")

			if layout.fieldTypeSites.capabilityAt(i) == ParamCapability.immutable or self.typeHoldsAFrozenTupleItemBeneath(element, walking: walking) 'aFrozenItem'
				return true
			end 'aFrozenItem'
		end 'eachItem'

		return false
	end 'tupleItemsHoldAFrozenItemBeneath'

	function instanceHoldsAFrozenItemBeneath(id GenericInstanceId, walking mutable WalkedTupleNameSet) returns bool
		for arg in self.rowArgs(id) 'eachArgument'
			if self.typeHoldsAFrozenTupleItemBeneath(arg, walking: walking) 'aFrozenItem'
				return true
			end 'aFrozenItem'
		end 'eachArgument'

		return false
	end 'instanceHoldsAFrozenItemBeneath'

	// A tuple already on the walk answers false: a tuple alias naming itself is left to its own
	// diagnostic (E3005) rather than recursed into without end.
	function typeHoldsAFrozenTupleItemBeneath(t MaxonType, walking mutable WalkedTupleNameSet) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceHoldsAFrozenItemBeneath(genericInstanceIdOf(t), walking: walking)
		end 'anInstance'

		if tag != ValueTypeTag.structRef 'notARecord'
			return false
		end 'notARecord'

		let id = typeNameIdOf(t)

		if walking.contains(id) 'aTupleNamingItself'
			return false
		end 'aTupleNamingItself'

		let name = try self.typeNames.nameOf(id) otherwise panic("ProgramSignatures.typeHoldsAFrozenTupleItemBeneath: type-name id {id} is not in the index's own interner")

		if not isTupleTypeName(name) 'notATuple'
			return false
		end 'notATuple'

		walking.insert(id)
		let layout = self.registeredTupleLayoutNamed(name)
		return self.tupleItemsHoldAFrozenItemBeneath(layout, walking: walking)
	end 'typeHoldsAFrozenTupleItemBeneath'

	// ⭐⭐ **THE INSTANCE VIEW OF A DECLARATION-VIEW TYPE, TUPLE INCLUDED — the ONE home of the name/id split
	// the two substitutions above leave open.** `substituteThroughInstance` is deliberately interner-FREE, so it
	// passes a `structRef` through untouched; a TUPLE `structRef` is the one `structRef` whose identity CITES the
	// declaring type's parameters, and it crosses as a NAME rather than as an id. Composing the two therefore
	// needs a name table, and the composition is written HERE — once — rather than at each door that wants it.
	//
	// ⛔ **IT EXISTS BECAUSE THE COMPOSITION HAD ACQUIRED A SECOND SITE, which `Parser.slotTypeThroughReceiver`'s
	// own header had already named as the drift to prevent** (*"a second site holding the name/id split is the
	// drift the function below exists to prevent"*). That door serves the PARSER, in a file's interner; the
	// argument check needs the identical rule in the PROJECT's, and re-spelling it there would have made the
	// warning's own prediction come true.
	//
	// `interner` is read AND written: the declared name is looked up in it and the substituted tuple is interned
	// back into it, so a caller always gets an id its own table resolves. The type is returned UNCHANGED — the
	// same object — when the instance fixes nothing, which is the early-return contract both substitutions above
	// keep and which lets a caller tell "no instance view" from the answer itself.
	export function substituteThroughInstanceInterned(t MaxonType, id GenericInstanceId, interner TypeNameInterner) returns MaxonType
		if not tagNamesADeclaredType(maxonTypeTag(t)) 'notATuple'
			return self.substituteThroughInstance(t, id: id)
		end 'notATuple'

		let declaredName = try interner.nameOf(typeNameIdOf(t)) otherwise panic("ProgramSignatures.substituteThroughInstanceInterned: structRef id {typeNameIdOf(t)} is not in the interner it was read with — a caller must hand the table its own type was minted from")

		if not isTupleTypeName(declaredName) 'aPlainStruct'
			return t
		end 'aPlainStruct'

		let instanceView = self.substituteTupleThroughInstance(declaredName, id: id)
		return t if instanceView.equals(declaredName) else MaxonType.structRef(interner.intern(instanceView))
	end 'substituteThroughInstanceInterned'

	// The base struct's field `index` type as instance `id` sees it — `substituteThroughInstance` applied to the
	// declared field type. This is what turns `Box`'s opaque `value as T` into `String` for a `Box with String`,
	// and `HoldA`'s `items as Items` into `Array with Num` for a `HoldA with Num`, so the cascade can classify
	// and drop it. Arity was checked at instantiation (E2056), so a type-parameter field's position indexes the
	// args in range.
	//
	// ⛔⛔ **THE COLUMN IS RESOLVED BEFORE IT IS SUBSTITUTED, AND SKIPPING THAT STEP LEAKED THE `Array` SHAPE
	// ITSELF.** A field declared through an INNER generic alias — `typealias Inner = Cell with T` inside
	// `type Holder uses T`, which is exactly `stdlib/Array.maxon`'s `typealias ElementMemory = __ManagedMemory
	// with Element` — is recorded by the sweep as a bare `named("Holder.Inner")`, because the alias registry is
	// filled after the file is swept. `substituteThroughInstance` passes a `named` through untouched (it has no
	// name table), so the cascade classified the field by its ALIAS NAME: `declaredNameIsManaged` said "a
	// generic alias, so managed" and `managedNameDropCallee` resolved that alias to the UNSUBSTITUTED
	// `Cell with Holder.T`, whose own field is opaque and so owns nothing — the trivial `__mm_decref`.
	// **MEASURED**: a `Holder with String` over a `Cell with String` printed 47 and exited **101**.
	//
	// ⚠ **IT IS RESOLVED HERE AND THE COLUMN IS LEFT ALONE, WHICH IS THE OPPOSITE CHOICE FROM THE BARE
	// GENERIC NAME ONE DOOR OVER** (`normalizeSweptScopedGenericFields`, which rewrites the column). The
	// difference is what the spelling still carries: an alias NAME is what `fieldSurfaceOf` derives a
	// position's buffer-spelling bits from (`derivedAliasSurfaceBits`, and `Character.ByteMemory` is one), and
	// a `genericInstance` cannot hold it — `resolveRecordedGenericAliasTypes`' header states that trap for the
	// registry that already had to respect it. A bare generic NAME carries no such bit, so it may be recorded
	// resolved; an alias may only be resolved at the door that needs the type.
	export function substituteInstanceFieldType(id GenericInstanceId, index FieldIndex) returns MaxonType
		let layout = self.baseLayoutOf(id)
		let declared = self.declaredInstanceFieldType(layout, index: index)
		let substituted = self.substituteThroughInstanceInterned(declared, id: id, interner: self.typeNames)

		if maxonTypeTag(substituted) == ValueTypeTag.genericInstance and self.fieldDeclaredToGrowItsOwner(layout, index: index, declared: declared) 'anExpandingField'
			return declared
		end 'anExpandingField'

		return substituted
	end 'substituteInstanceFieldType'

	function expandedInstanceFieldType(id GenericInstanceId, index FieldIndex) returns MaxonType
		return self.substituteThroughInstanceInterned(self.declaredInstanceFieldType(self.baseLayoutOf(id), index: index), id: id, interner: self.typeNames)
	end 'expandedInstanceFieldType'

	function declaredInstanceFieldType(layout StructLayout, index FieldIndex) returns MaxonType
		let fieldType = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.declaredInstanceFieldType: field {index} out of range for the base struct")
		return self.declaredSlotType(fieldType, into: self.typeNames, slotScopeFilePath: layout.declFilePath)
	end 'declaredInstanceFieldType'

	function fieldDeclaredToGrowItsOwner(layout StructLayout, index FieldIndex, declared MaxonType) returns bool
		if maxonTypeTag(declared) != ValueTypeTag.genericInstance or self.instanceNestingDepth(genericInstanceIdOf(declared)) < GrowingFieldNestingFloor 'nothingCanGrow'
			return false
		end 'nothingCanGrow'

		return self.fieldTypeGrowsItsOwner(layout.name, fieldName: layout.fieldNameAt(index))
	end 'fieldDeclaredToGrowItsOwner'

	function instanceNestingDepth(id GenericInstanceId) returns InstanceNestingDepth
		var deepest = 0 as InstanceNestingDepth

		for position in 0 upto self.genericInstanceArgCount(id) 'eachArgument'
			let arg = self.denotedArg(id, position: position)

			if maxonTypeTag(arg) != ValueTypeTag.genericInstance 'aLeafArgument'
				continue
			end 'aLeafArgument'

			let depth = self.instanceNestingDepth(genericInstanceIdOf(arg))

			if depth > deepest 'deeper'
				deepest = depth
			end 'deeper'
		end 'eachArgument'

		return deepest + 1
	end 'instanceNestingDepth'

	// ⭐⭐ **ARE THIS INSTANCE'S TYPE ARGUMENTS A CONTIGUOUS, IN-ORDER RUN OF SOME GENERIC'S OWN PARAMETERS?**
	// `Cell with T` written inside `type Holder uses T` is one — argument 0 is the parameter at `uses`-list
	// position 0 — and so is `Cell with U` inside `Holder uses T, U`, whose run starts at position 1. It is the
	// exact condition under which a descriptor for this instance can be FORWARDED rather than built
	// (`MaxonToStdLowering.emitInstanceDescriptorAddr`): a descriptor is a run of per-parameter blocks, so one base
	// address serves the callee only while the caller's blocks line up with the callee's from some offset on.
	//
	// A PERMUTATION (`Slot with (V, K)`) and a MIXED list (`Pair with (Integer, T)`) are both absent.
	// Neither has a single base — the first would need the blocks re-ordered and the second has no block
	// at all for its concrete half — and a base for either would hand a callee a descriptor whose words
	// describe other types, which is a wrong destructor rather than a diagnostic.
	export function genericInstanceCallerParameterRunBase(gid GenericInstanceId) returns ElementIndex throws AbsentError
		let count = self.genericInstanceArgCount(gid)

		if count == 0 'noArguments'
			throw AbsentError.absent
		end 'noArguments'

		let first = self.instanceArgType(gid, position: FirstRunArgumentPosition)

		if maxonTypeTag(first) != ValueTypeTag.typeParameter 'firstArgumentIsAType'
			throw AbsentError.absent
		end 'firstArgumentIsAType'

		let base = self.opaqueTypeParamPosition(first)

		for position in FirstRunArgumentPosition + 1 upto count 'eachFurtherArg'
			let arg = self.instanceArgType(gid, position: position)

			if maxonTypeTag(arg) != ValueTypeTag.typeParameter 'concreteArgument'
				throw AbsentError.absent
			end 'concreteArgument'

			if self.opaqueTypeParamPosition(arg) != base + position 'notTheNextBlock'
				throw AbsentError.absent
			end 'notTheNextBlock'
		end 'eachFurtherArg'

		return base
	end 'genericInstanceCallerParameterRunBase'

	export function genericInstanceArgsBuildOnATypeParameter(gid GenericInstanceId) returns bool
		for position in 0 upto self.genericInstanceArgCount(gid) 'eachArg'
			let arg = self.instanceArgType(gid, position: position)

			if maxonTypeTag(arg) != ValueTypeTag.typeParameter and self.typeIsBuiltOnATypeParameter(arg) 'builtOnAParameter'
				return true
			end 'builtOnAParameter'
		end 'eachArg'

		return false
	end 'genericInstanceArgsBuildOnATypeParameter'

	export function instanceDescriptorIsComposedFromTheCaller(gid GenericInstanceId) returns bool
		try self.genericInstanceCallerParameterRunBase(gid) otherwise return self.instanceIsBuiltOnATypeParameter(gid)
		return false
	end 'instanceDescriptorIsComposedFromTheCaller'

	export function containerCreateRoute(gid GenericInstanceId) returns ContainerCreateRoute
		if self.containerElementIsOpaque(gid) 'opaqueElement'
			return ContainerCreateRoute.opaqueElement
		end 'opaqueElement'

		if self.instanceDescriptorIsComposedFromTheCaller(gid) 'composedFromTheCaller'
			return ContainerCreateRoute.composedFromTheCaller
		end 'composedFromTheCaller'

		return ContainerCreateRoute.staticStamp
	end 'containerCreateRoute'

	export function instanceIsBuiltOnATypeParameter(gid GenericInstanceId) returns bool
		_ = try self.firstTypeParameterInInstanceArgs(gid) otherwise return false
		return true
	end 'instanceIsBuiltOnATypeParameter'

	export function firstTypeParameterInInstanceArgs(gid GenericInstanceId) returns TypeParamId throws MapError
		for position in 0 upto self.genericInstanceArgCount(gid) 'eachArg'
			if let found = try self.firstTypeParameterIn(self.substitutedInstanceArg(gid, position: position)) 'mentionsOne'
				return found
			end 'mentionsOne'
		end 'eachArg'

		throw MapError.keyNotFound
	end 'firstTypeParameterInInstanceArgs'

	export function typeIsBuiltOnATypeParameter(t MaxonType) returns bool
		_ = try self.firstTypeParameterIn(t) otherwise return false
		return true
	end 'typeIsBuiltOnATypeParameter'

	function firstTypeParameterIn(t MaxonType) returns TypeParamId throws MapError
		let resolved = self.typeArgumentType(t)
		let tag = maxonTypeTag(resolved)

		if tag == ValueTypeTag.typeParameter 'theParameterItself'
			return typeParamIdOf(resolved)
		end 'theParameterItself'

		if tag == ValueTypeTag.genericInstance 'aNestedInstance'
			return try self.firstTypeParameterInInstanceArgs(genericInstanceIdOf(resolved))
		end 'aNestedInstance'

		let elements = try self.tupleElementTypesOf(resolved)

		for element in elements 'eachElement'
			if let found = try self.firstTypeParameterIn(element) 'mentionsOne'
				return found
			end 'mentionsOne'
		end 'eachElement'

		throw MapError.keyNotFound
	end 'firstTypeParameterIn'

	export function instanceArgsMentionTypeParameter(gid GenericInstanceId, param TypeParamId) returns bool
		for position in 0 upto self.genericInstanceArgCount(gid) 'eachArg'
			if self.typeMentionsTypeParameter(self.substitutedInstanceArg(gid, position: position), param: param) 'mentionsIt'
				return true
			end 'mentionsIt'
		end 'eachArg'

		return false
	end 'instanceArgsMentionTypeParameter'

	function typeMentionsTypeParameter(t MaxonType, param TypeParamId) returns bool
		let resolved = self.typeArgumentType(t)
		let tag = maxonTypeTag(resolved)

		if tag == ValueTypeTag.typeParameter 'theParameterItself'
			return typeParamIdOf(resolved) == param
		end 'theParameterItself'

		if tag == ValueTypeTag.genericInstance 'aNestedInstance'
			return self.instanceArgsMentionTypeParameter(genericInstanceIdOf(resolved), param: param)
		end 'aNestedInstance'

		let elements = try self.tupleElementTypesOf(resolved) otherwise return false

		for element in elements 'eachElement'
			if self.typeMentionsTypeParameter(element, param: param) 'mentionsIt'
				return true
			end 'mentionsIt'
		end 'eachElement'

		return false
	end 'typeMentionsTypeParameter'

	export function tupleElementTypesOf(t MaxonType) returns MaxonTypeArray throws MapError
		return (try self.tupleLayoutOf(t)).fieldTypes
	end 'tupleElementTypesOf'

	function tupleLayoutOf(t MaxonType) returns StructLayout throws MapError
		if not tagNamesADeclaredType(maxonTypeTag(t)) 'notADeclaredType'
			throw MapError.keyNotFound
		end 'notADeclaredType'

		return try self.tupleLayoutNamed(try self.typeNames.nameOf(typeNameIdOf(t)) otherwise panic("ProgramSignatures.tupleLayoutOf: type-name id {typeNameIdOf(t)} is not in the index's own interner, which every instance argument and field type is minted into"))
	end 'tupleLayoutOf'

	function tupleLayoutNamed(name ByteArray) returns StructLayout throws MapError
		if not isTupleTypeName(name) 'aPlainStruct'
			throw MapError.keyNotFound
		end 'aPlainStruct'

		return try self.registeredLayout(name) otherwise panic("ProgramSignatures.tupleLayoutNamed: tuple `{String.from(name)}` is not registered — `internTupleType` registers the layout before it hands the name back")
	end 'tupleLayoutNamed'

	export function aggregateNameIsBuiltOnATypeParameter(name ByteArray) returns bool
		let layout = try self.tupleLayoutNamed(name) otherwise return false

		for element in layout.fieldTypes 'eachElement'
			if self.typeIsBuiltOnATypeParameter(element) 'mentionsOne'
				return true
			end 'mentionsOne'
		end 'eachElement'

		return false
	end 'aggregateNameIsBuiltOnATypeParameter'

	// ⭐⭐ **IS EVERY ARGUMENT OF THIS INSTANCE A TYPE, ALL THE WAY DOWN?** — the question two mechanisms
	// ask for the same reason, which is that a PARAMETRIC instance names nothing a compile-time answer can be
	// built from:
	//
	//   • `LowerMaxonToStd.witnessTableInstanceFor` refuses to key a witness table by one, because the
	//     table's adapter would have to name the instance's descriptor and one witness per constrained
	//     argument, and neither exists for an argument that is still a type PARAMETER (its size IS the
	//     descriptor read the blob would have to contain, which is why `primitiveTypeByteSize` panics rather
	//     than guessing);
	//   • `ConformanceCheck.checkConstraintAssociatedBindings` refuses to COMPARE one, because a parametric
	//     rendering is a name in some declaration's own scope rather than a type identity — two spellings of
	//     "the tuple of my two parameters" written in two declarations differ character for character while
	//     denoting the same thing at every instantiation.
	//
	// ⚠ **THE WALK RECURSES, AND A SHALLOW TEST WOULD NOT BE ENOUGH.** `WithIterIterator with (MapIterator
	// with (Key, Value), Element)` inside `Map`'s own body has a `genericInstance` at position 0 whose OWN
	// arguments are `Map`'s parameters, so every argument at THIS level is a type and the instance is still
	// parametric. A shallow test calls such an instance concrete, and the witness table it then
	// permits fails to link on wasm.
	export function instanceArgsAreFullyConcrete(gid GenericInstanceId) returns bool
		return not self.instanceIsBuiltOnATypeParameter(gid)
	end 'instanceArgsAreFullyConcrete'

	// ⭐⭐ **THE SAME QUESTION OF AN ARGUMENT LIST NOTHING HAS INTERNED YET, and it exists because interning
	// to ask it is not free of consequence.** `genericInstances.intern` MINTS a row on a miss and, on a hit,
	// CLEARS the speculative mark a candidate walk left — *"the guess has since been confirmed by the
	// source"*. A caller that may DISCARD its answer confirms nothing, so it must decide before it interns;
	// `Parser.spawnFactoryConstructorInstance` is the one that must.
	export function argsAreFullyConcrete(args MaxonTypeArray) returns bool
		for arg in args 'eachArg'
			if not self.argIsFullyConcrete(arg) 'stillOpaque'
				return false
			end 'stillOpaque'
		end 'eachArg'

		return true
	end 'argsAreFullyConcrete'

	// ONE argument's half of both walks above — see `instanceArgsAreFullyConcrete` for why the recursion is
	// deep rather than shallow.
	export function argIsFullyConcrete(arg MaxonType) returns bool
		return not self.typeIsBuiltOnATypeParameter(arg)
	end 'argIsFullyConcrete'

	// Does the field reach `owner` again, through declared generics' fields, over arguments that
	// properly contain the ones it was reached with? Such a type needs a larger instance at every
	// depth (E3184).
	export function fieldTypeGrowsItsOwner(owner ByteArray, fieldName ByteArray) returns bool
		let paramNames = self.structTypeParamsOf(owner)

		if paramNames.isEmpty() 'notGeneric'
			return false
		end 'notGeneric'

		let fieldType = self.denotedType(try self.declaredSlotTypeOfField(owner, fieldName: fieldName) otherwise return false)
		let ownParameters = MaxonTypeArray.create(paramNames.count(), zeroed: false)

		for paramName in paramNames 'eachParameter'
			ownParameters.push(MaxonType.typeParameter(typeParamTokenFor(owner, paramName: paramName)))
		end 'eachParameter'

		if not self.typeWrapsAParameter(fieldType, parameters: ownParameters) 'nothingCanGrow'
			return false
		end 'nothingCanGrow'

		let path = GrowthPath.create(0)
		path.push(GrowthStep.create(owner, args: ownParameters))
		return self.typeGrowsOwner(fieldType, owner: owner, path: path, visited: ClonerSet.create())
	end 'fieldTypeGrowsItsOwner'

	export function declaredFieldTypeDisplayName(structName ByteArray, fieldName ByteArray) returns String
		return self.typeDisplayName(try self.declaredSlotTypeOfField(structName, fieldName: fieldName) otherwise panic("declaredFieldTypeDisplayName: '{String.from(structName)}' has no field '{String.from(fieldName)}' — the caller named a field it just read"))
	end 'declaredFieldTypeDisplayName'

	export function denotedArg(id GenericInstanceId, position ElementIndex) returns MaxonType
		return self.denotedType(self.substitutedInstanceArg(id, position: position))
	end 'denotedArg'

	function denotedType(type MaxonType) returns MaxonType
		let denoted = try self.denotedInstance(type) otherwise return type
		return MaxonType.genericInstance(denoted)
	end 'denotedType'

	function typeWrapsAParameter(type MaxonType, parameters MaxonTypeArray) returns bool
		if maxonTypeTag(type) != ValueTypeTag.genericInstance 'holdsNoInstance'
			return false
		end 'holdsNoInstance'

		let id = genericInstanceIdOf(type)
		let declared = self.genericInstanceHasBaseLayout(id)

		for position in 0 upto self.genericInstanceArgCount(id) 'eachArgument'
			let arg = self.denotedArg(id, position: position)

			if declared and maxonTypeTag(arg) == ValueTypeTag.genericInstance and self.typeMentionsAParameter(arg, parameters: parameters) 'aDeclaredGenericOverATermBuiltOnAParameter'
				return true
			end 'aDeclaredGenericOverATermBuiltOnAParameter'

			if self.typeWrapsAParameter(arg, parameters: parameters) 'deeper'
				return true
			end 'deeper'
		end 'eachArgument'

		return false
	end 'typeWrapsAParameter'

	function typeMentionsAParameter(type MaxonType, parameters MaxonTypeArray) returns bool
		for parameter in parameters 'eachParameter'
			if maxonTypesDenoteSame(type, b: parameter) or self.typeProperlyContains(type, inner: parameter) 'mentionsOne'
				return true
			end 'mentionsOne'
		end 'eachParameter'

		return false
	end 'typeMentionsAParameter'

	function typeProperlyContains(type MaxonType, inner MaxonType) returns bool
		if maxonTypeTag(type) != ValueTypeTag.genericInstance 'holdsNoInstance'
			return false
		end 'holdsNoInstance'

		let id = genericInstanceIdOf(type)

		for position in 0 upto self.genericInstanceArgCount(id) 'eachArgument'
			let arg = self.denotedArg(id, position: position)

			if maxonTypesDenoteSame(arg, b: inner) or self.typeProperlyContains(arg, inner: inner) 'inside'
				return true
			end 'inside'
		end 'eachArgument'

		return false
	end 'typeProperlyContains'

	function argsGrowOver(args MaxonTypeArray, earlier MaxonTypeArray) returns bool
		for arg in args 'eachArgument'
			for inner in earlier 'eachEarlier'
				if self.typeProperlyContains(arg, inner: inner) 'wrapsIt'
					return true
				end 'wrapsIt'
			end 'eachEarlier'
		end 'eachArgument'

		return false
	end 'argsGrowOver'

	function typeGrowsOwner(type MaxonType, owner ByteArray, path GrowthPath, visited ClonerSet) returns bool
		if maxonTypeTag(type) != ValueTypeTag.genericInstance 'holdsNoInstance'
			return false
		end 'holdsNoInstance'

		return self.instanceGrowsOwner(genericInstanceIdOf(type), owner: owner, path: path, visited: visited)
	end 'typeGrowsOwner'

	function instanceGrowsOwner(id GenericInstanceId, owner ByteArray, path GrowthPath, visited ClonerSet) returns bool
		let key = self.mangleGenericInstance(id)

		if visited.contains(key) 'alreadyWalked'
			return false
		end 'alreadyWalked'

		visited.insert(key)
		let base = self.genericInstanceBaseName(id)

		if self.genericInstanceHasBaseLayout(id) and not layoutTakesEveryTypeArgument(self.baseLayoutOf(id), count: self.genericInstanceArgCount(id)) 'aTypeArgumentIsOmitted'
			return false
		end 'aTypeArgumentIsOmitted'

		let argCount = self.genericInstanceArgCount(id)
		let args = MaxonTypeArray.create(argCount, zeroed: false)

		for position in 0 upto argCount 'eachArgument'
			args.push(self.denotedArg(id, position: position))
		end 'eachArgument'

		for step in path 'eachStep'
			if step.base.equals(base) and self.argsGrowOver(args, earlier: step.args) 'theSameTypeOverAGrowingTerm'
				return base.equals(owner)
			end 'theSameTypeOverAGrowingTerm'
		end 'eachStep'

		path.push(GrowthStep.create(base, args: args))
		let grows = self.instanceHoldsGrowth(id, owner: owner, path: path, visited: visited)
		_ = try path.pop() otherwise panic("instanceGrowsOwner: the step pushed above is on the path")
		return grows
	end 'instanceGrowsOwner'

	function instanceHoldsGrowth(id GenericInstanceId, owner ByteArray, path GrowthPath, visited ClonerSet) returns bool
		if self.genericInstanceHasBaseLayout(id) 'aDeclaredGeneric'
			for index in 0 upto self.genericInstanceFieldCount(id) 'eachField'
				if self.typeGrowsOwner(self.denotedType(self.expandedInstanceFieldType(id, index: index)), owner: owner, path: path, visited: visited) 'aFieldGrows'
					return true
				end 'aFieldGrows'
			end 'eachField'

			return false
		end 'aDeclaredGeneric'

		for position in 0 upto self.genericInstanceArgCount(id) 'eachArgument'
			if self.typeGrowsOwner(self.denotedArg(id, position: position), owner: owner, path: path, visited: visited) 'anElementGrows'
				return true
			end 'anElementGrows'
		end 'eachArgument'

		return false
	end 'instanceHoldsGrowth'

	export function constraintsNameABareTypeParameter(callee ByteArray, extensionConstraints WhereConstraintArray, gid GenericInstanceId) returns bool
		for constraint in self.witnessConstraintsOfMethod(callee, extensionConstraints: extensionConstraints) 'eachConstraint'
			if constraint.typeParamIndex < self.genericInstanceArgCount(gid) and maxonTypeTag(self.substitutedInstanceArg(gid, position: constraint.typeParamIndex)) == ValueTypeTag.typeParameter 'aBareParameter'
				return true
			end 'aBareParameter'
		end 'eachConstraint'

		return false
	end 'constraintsNameABareTypeParameter'

	// ⚠ **IT ANSWERS THE ARGUMENT'S TYPE AND NOT ITS SPELLING, AND THAT IS A LOSS A CALLER MAY HAVE TO REPAIR.**
	// `Array with __ManagedMemory` and `Array with ByteArray` are ONE instance, so the argument comes back
	// identical for both while the member ROSTER a value of it reaches differs. A caller that goes on to ask for
	// a roster wants `surfaceBitsThroughInstanceArg` beside this — see its header for why the fact rides the
	// VALUE and can never ride `id`.
	export function substitutedInstanceArg(id GenericInstanceId, position ElementIndex) returns MaxonType
		let args = self.rowArgs(id)
		return try args.get(position) otherwise panic("ProgramSignatures.substitutedInstanceArg: type-parameter position {position} out of range for instance {id}'s {args.count()} argument(s) — arity was checked at instantiation (E2056)")
	end 'substitutedInstanceArg'

	// ⭐⭐ **THE ARGUMENT AS A TYPE, WHERE THE READER ABOVE ANSWERS IT AS A SPELLING — and this is THE DOOR, not
	// one reader of it.** A generic instance's stored argument is the SECOND door this index's types
	// leave by (`adoptType` is the first), and a tuple is the one type whose SWEEP spelling and whose
	// whole-program CANONICAL name differ: the sweep records `(String, Integer)` as `__Tuple2.String.Integer`
	// because the alias registry that says what `Integer` means is still being built, while every VALUE the
	// program builds carries `__Tuple2.String.int`. Anything that goes on to NAME A PER-TYPE RUNTIME ENTRY off
	// the argument — a destructor, a retain, a cloner, a witness label — must read the canonical form, because
	// the canonical layout is the only one `ParseStaging.commitStructTypes` commits and so the only one the
	// installers' key space can contain.
	//
	// ⛔⛔ **A REWRITE AT ONE READER LEAVES THE OTHERS.** In `containerElementType` alone it fixes the
	// drop stamp (`__destruct___Tuple2.Num.String`) but not the descriptor's `copyFunc@32`, which
	// reads the argument through `managedOpaqueArrayElementOf` — MEASURED, a four-line program —
	// `typealias Pair = (String, Integer)`, `Array with Pair`, one push, one `.clone()` — died at
	// `bakeFuncAbs64Relocs: … '__clone___Tuple2.String.Integer' … was never installed`. A rewrite
	// installed at a reader is a rewrite the NEXT reader does not get, so it is installed at the door
	// instead and `containerElementType` is now one of its callers rather than its home.
	//
	// ⚠ **IT IS NOT `substitutedInstanceArg`, AND MERGING THE TWO WOULD RENAME AN EMITTED SYMBOL.**
	// `instanceArgCompiledName` → `mangleTypeArg` needs the argument's SOURCE spelling: canonicalizing there
	// would give a sweep-spelled instance and a canonically-spelled one ONE symbol while they remain two gids,
	// which is the `E3006 duplicate definition` shape `containerElementType`'s header records. Two questions,
	// two names — and the caller says which one it is asking.
	export function canonicalInstanceArgAt(id GenericInstanceId, position ElementIndex) returns MaxonType
		return self.canonicalTupleStructRef(self.substitutedInstanceArg(id, position: position))
	end 'canonicalInstanceArgAt'

	// Instance `id`'s concrete type argument at type-parameter `position` — what a `T`-typed field
	// read on a concrete receiver retypes to. `adoptType` re-interns it into the caller's interner. Arity was
	// checked at instantiation (E2056), so a type-parameter field's position indexes the args in range.
	export function instanceArgType(id GenericInstanceId, position ElementIndex) returns MaxonType
		return self.typeArgumentType(self.substitutedInstanceArg(id, position: position))
	end 'instanceArgType'

	function typeArgumentType(arg MaxonType) returns MaxonType
		let canonical = self.canonicalTupleStructRef(arg)

		if maxonTypeTag(canonical) == ValueTypeTag.named and not self.namesALiveGenericAlias(self.nameOfId(typeNameIdOf(canonical))) 'noLiveGenericAliasSpelling'
			return canonical
		end 'noLiveGenericAliasSpelling'

		return self.canonicalTypeArg(canonical)
	end 'typeArgumentType'

	// ⭐ **IS INSTANCE `id`'s ARGUMENT AT `position` A MANAGED TYPE?** — asked here rather than by the caller,
	// because `substitutedInstanceArg` returns a type in THIS INDEX's interner, so the only
	// table that can resolve its `named` id is `self.typeNames`, and that table is private. A caller doing the
	// two steps itself must either be handed the interner or adopt the type into its own first — and adopting
	// it is precisely the mistake, because the id then means whatever name happens to sit at that number in
	// the OTHER table. Keeping both steps inside makes the pairing structural instead of conventional, which
	// is the same move `typeArgAggregateName` above already makes.
	//
	// ⭐⭐ **ANSWERED OFF `typeOwnershipProtocol`, WHICH IS THE INVARIANT AND NOT A ROUTING CHOICE.**
	// The layout descriptor's `destroyFunc@40` gate is this, and its `retainFunc@64` is
	// `typeParamRetainCallee` → `typeOwnershipProtocol`; a reference is taken through one word and
	// released through the other, so **the two must be non-zero TOGETHER**, and two predicates cannot
	// promise that. They were two — this said `typeIsManaged` while the drop gate said
	// `typeArgIsOwned` — and a co-owned trivial aggregate fell between them: retained by the rehash,
	// released by nobody. Reading ONE decision is the arrangement the witness pair
	// `destroyFunc@8`/`retainFunc@16` already has off `existentialOwnershipProtocol`, which is why it
	// is spelled the same way here.
	// ⚠ **IT IS NAMED FOR THE DROP AND NOT FOR MANAGEDNESS, BECAUSE THE TWO PART AT THE PROMISE ARM.** A
	// green-thread argument is NOT managed — it is not an `__mm` box and may not be
	// retained or cloned — and it DOES owe the `destroyFunc@40` stamp this predicate gates. "Owes a drop" is
	// what the descriptor's drop word actually asks, so a narrower name here would be a false answer wearing
	// an accurate one.
	export function instanceArgOwesDrop(id GenericInstanceId, position ElementIndex) returns bool
		return match self.typeOwnershipProtocol(self.canonicalInstanceArgAt(id, position: position)) 'protocol'
			none gives false
			byteRecord or
			aggregate or
			greenThread or
			bufferRecord or
			sharedValue gives true
		end 'protocol'
	end 'instanceArgOwesDrop'

	// ⭐ **THE TYPE-CYCLE NODE INSTANCE `id`'s ARGUMENT AT `position` POINTS AT (E4014).** A container OWNS its
	// elements, so each argument is an ownership edge in `TypeCycleCheck`'s graph.
	//
	// ⚠ Here rather than at the caller for `instanceArgOwesDrop`'s stated reason: the argument's `named` id is
	// meaningless outside `self.typeNames`, and adopting it into the merged `project.typeNames` is exactly the
	// mistake — the id would then mean whatever name happens to sit at that number in the OTHER table.
	//
	// `denotedInstance` FIRST, because an argument may SPELL a container two ways — a nested
	// `genericInstance`, or a `named` leaf naming a `typealias` — and that door already answers both as one
	// question. It is the same door `buildInstanceArgGraph` asks, so the type-cycle graph and the alias-cycle
	// graph cannot come to disagree about which argument reaches a container.
	export function instanceArgCycleTarget(id GenericInstanceId, position ElementIndex) returns TypeCycleTarget
		let arg = self.substitutedInstanceArg(id, position: position)

		if let denoted = try self.denotedInstance(arg) 'spellsAContainer'
			return TypeCycleTarget.container(denoted)
		end 'spellsAContainer'

		return typeCycleTargetOf(arg, typeNames: self.typeNames)
	end 'instanceArgCycleTarget'

	// The number of fields instance `id` carries — its base struct's field count.
	export function genericInstanceFieldCount(id GenericInstanceId) returns FieldIndex
		return self.baseLayoutOf(id).fieldCount()
	end 'genericInstanceFieldCount'

	// The byte offset of instance field `index` in the box — its base struct's own field offset.
	export function genericInstanceFieldOffset(id GenericInstanceId, index FieldIndex) returns ByteOffset
		return self.baseLayoutOf(id).offsetOfField(index)
	end 'genericInstanceFieldOffset'

	// ⭐ **DOES A TYPE ARGUMENT REQUIRE A CALL-SITE CONSUME (a MOVE into the box)?** — the CONSUME boundary,
	// DELIBERATELY NARROWER than the box's own field DROP. A TRIVIAL type argument (a
	// scalar, or an all-scalar struct/instance like `Point`/`IntBox`) is NOT consumed: the caller keeps it
	// usable (`PointBox.create(p); … p.getX()`, `generic-trivial-struct-arg`). It answers yes ONLY for an
	// argument that itself owes a drop — a promise, a `String`, a struct WITH a managed field, a boxed union,
	// or a nested instance that owes one — which the box MOVES in and the caller may not reuse.
	//
	// ⚠ **THIS IS NOT THE DROP BOUNDARY.** A trivial `T` argument treated as a
	// pure BORROW — not consumed AND not dropped — dangles when the container OUTLIVES the borrowed
	// source (`var b = …; { let pInner = Point.create(…); b = PointBox.create(pInner) }; b.itemDigest()` frees
	// `pInner` at the inner scope while `b` still points at it — a use-after-free the witness dispatch makes
	// reachable). The ⚖ USER RULING fixes it by RETAIN, generalizing `__mm_retain`
	// co-ownership: a trivial struct/instance stored into a generic field is `__mm_retain`'d at the FEED
	// (`Parser.coOwnConcreteAggregateFeed`, reached from BOTH of `handleEscapingBorrowFeed`'s sinks — the
	// `Self{item: v}` constructor and the callee-storage `keys.set(…)` alike; a second sink taking no
	// reference is what makes a trivial-keyed `Map` lose every entry), so the box holds a
	// REAL second reference — CO-OWNED, not
	// borrowed. The DROP boundary is therefore `typeIsManaged` (`genericInstanceFieldOwesDrop`), which
	// releases that reference at the box's destruction, while THIS consume boundary stays put so the caller's
	// own `p` is still live and dropped once. So the three questions now split three ways on a trivial struct:
	// NOT consumed (borrowed-and-kept), YES dropped (co-owned via retain), and the retain fills the gap between
	// them — freed exactly once on every path. A managed argument is BOTH consumed and dropped; a
	// scalar is neither.
	export function typeArgIsOwned(t MaxonType) returns bool
		let tag = maxonTypeTag(t)

		if self.typeIsAGreenThreadHandle(t, from: self.typeNames) 'aGreenThread'
			return true
		end 'aGreenThread'

		// `tagIsByteRecord`: a Character argument is an owned record exactly as a String one is.
		if tagIsByteRecord(tag) 'byteRecord'
			return true
		end 'byteRecord'

		if tag == ValueTypeTag.genericInstance 'instance'
			return self.genericInstanceOwesADrop(genericInstanceIdOf(t))
		end 'instance'

		if not tagMayNameAggregate(tag) 'notNamedStruct'
			return false
		end 'notNamedStruct'

		// ⭐⭐ **RESOLVED THROUGH `denotedAggregateName`, AND IT MUST BE THE SAME RESOLUTION `typeIsManaged`
		// MAKES.** The two are read TOGETHER: managed and not owned is the borrowed, feed-retained class, so a
		// name the two answer about DIFFERENTLY does not
		// merely give a coarse answer — it manufactures a kind the type does not have. A tuple typealias
		// arrives here as a bare `named` for the reason `denotedAggregateName` states (a RAW instance
		// argument, interned by whichever pass first met `Box with Pair`, and the declaration SWEEP meets it
		// before the alias's own file is walked whenever the filesystem hands that file over second).
		let name = self.denotedSlotAggregateName(t)

		// ⭐⭐ **A GENERIC-INSTANCE ALIAS ANSWERS AS ITS INSTANCE.** `typealias N0 = Box with S0` mints no
		// identity of its own, so `structSlots` and `enumTypes` both miss it, while `typeIsManaged`'s own
		// `named` arm answers `true` for it. Answering `false` here would make `Box with N0` a borrowed,
		// feed-retained box even though `N0` owns a String through `S0` — an `__mm_incref` plus a destructor
		// where a MOVE is owed.
		//
		// ⭐⭐ **THE FORM COMES FROM `declaredFormOf`, THE ONE name→FORM ANSWER.** A declaration form that
		// `typeIsManaged` has an arm for and this cascade does not MANUFACTURES A KIND THE TYPE DOES NOT
		// HAVE. `typeIsManaged` (through `declaredNameIsManaged`) is an exhaustive `match` over
		// `TypeDeclKind`, so a NINTH form is a compile error there, and an `if` cascade here would go on
		// answering `false` for it in silence. The VERDICTS still differ per form — that is the whole
		// point of this boundary being narrower than the drop one, and every arm below says which way it
		// goes and why; what may not differ is which forms the two doors have HEARD OF.
		//
		// ⚠ The declared TYPES are asked ahead of the alias registries, in `declaredFormOf`'s order,
		// which is the order `typeIsManaged` takes: an ILL-FORMED program (one name in two registries,
		// E3006/E3061, reported by a whole-program check that runs AFTER this classifier has answered)
		// reaches the two boundaries on ONE path — the agreement this function's header demands.
		let form = try self.declaredFormInAnyFile(name) otherwise return false

		match form 'form'
			// NARROWER than the drop boundary on purpose: an all-scalar struct (`Point`) is co-owned by
			// RETAIN and not moved, so only a struct that owns managed heap is consumed.
			structType then return self.structHasManagedField(name)

			// A payload-free enum's value is its i64 tag — nothing to move. `carriesPayloads` is the same
			// bit the drop side routes on, through the same reader.
			enumType or
			unionType then return self.declaredEnumIsBoxed(name)

			// An interface-typed slot is `E3011 Unknown type` before anything classifies it. A ranged alias
			// IS its primitive and a function value is a bare code pointer; neither owns a record, so
			// neither is ever moved into a box.
			interfaceType or
			rangedAlias or
			functionAlias then return false

			// A SUPERSEDED spelling consumes nothing — no call site can name it. See
			// `genericAliasSpellingIsSuperseded`, which records the two walks that reach this arm with one.
			genericAlias then return self.genericInstanceOwesADrop(try self.liveGenericAliasInstance(name) otherwise return false)

			// A tuple IS a struct box, and `denotedSlotAggregateName` above has already resolved the alias to
			// the tuple's own canonical name — so this arm is reached only if that resolution is ever
			// narrowed, and it must then answer exactly as the struct arm does.
			tupleAlias then return self.structHasManagedField(self.tupleAliasTargetInAnyFile(name))
		end 'form'
	end 'typeArgIsOwned'

	// Does ANY interned instance of the type that DECLARES type parameter `param` classify its argument at
	// that parameter's position as `kind`? The ONE instance-registry read every
	// type-parameter-instantiation gate delegates to — so the lookup and the `position < args.count()` bound
	// are written once and cannot drift between gates. The per-kind predicate is the only thing that
	// varies, in `typeArgHasKind`.
	//
	// ⭐ **THROUGH THE BY-BASE INDEX, NOT A WHOLE-REGISTRY WALK.** Running
	// `0 upto genericInstances.count()` and comparing every instance's base NAME makes the gates
	// O(call sites × TOTAL instances) — a term that allocates nothing (`nameOf` borrows, `.equals` copies
	// nothing), so no memory instrument can show it. `byBase` is filed by the same `intern` that
	// assigns the ids, so this visits only THIS base's instances and the gates become O(instances of the
	// base). A base with no instantiation has no bucket, and that is the answer: nothing instantiates it,
	// so no instantiation classifies anything as `kind`.
	//
	// ⭐⭐ **IT TAKES ONE TOKEN AND NOT A `(baseName, position)` PAIR, WHICH IS THE REPRESENTATION ABSORBING
	// A HAND-PAIRING.** A bare `typeParameter` field type forces both callers to
	// supply the declaring type ALONGSIDE it from somewhere else — `Parser.requireOpaqueArrayCopyable`
	// from `self.enclosingType`, `Parser.emitOpaqueFieldReassign` from `layout.name` — so "which type's
	// parameter is this?" is answered twice, by two parties, and a caller that pairs the wrong two
	// scans another type's instantiations with no complaint from anywhere. The token carries both
	// halves, so the pairing is read out of ONE fact at ONE door.
	//
	// A token whose owner is not in the ledger, or whose declaring type has no interned instance, answers
	// `false` for the reason a base with no bucket does: nothing instantiates it, so no instantiation
	// classifies anything as `kind`.
	//
	// ⛔⛔ **NOT EVERY ROW IN THIS REGISTRY IS A FACT ABOUT THE PROGRAM, AND READING ONE AS EVIDENCE REFUSED
	// VALID PROGRAMS WHOLESALE.** `internAggregateElementInstances` MINTS a `<base> with T` for every
	// declared struct and union in the program whenever any file holds a `[<identifier>…]` literal — the token
	// sweep cannot name such a literal's element type, so it materializes every candidate. Those rows are a
	// materialization convenience; they are not the source saying that an array of that element exists. That
	// distinction did not matter while the walk's only readers chose an EMISSION (see
	// `internLiteralContainerInstances`, which argues the rows "reach no emitted byte" — true, and beside the
	// point), and it became load-bearing the moment a REFUSAL read the same rows.
	//
	// ⇒ MEASURED once `stdlib/Array.maxon`, `File.maxon` and `Directory.maxon` are listed: `Array.clone`'s own
	// `managed.slice` (`stdlib/Array.maxon:142`) is gated by `genericTypeFieldUncopyableInstantiation`, and
	// the speculative walk minted `Array with FileWriter`, `Array with FileReader`, `Array with Directory`,
	// and `Array with ArrayIterator` — each uncopyable, none named by any program.
	// One of them was enough to refuse **every** `clone`/`slice`/`append` in **every** program holding a
	// `[<identifier>…]`-shaped literal, with a sentence about `Box with String`. A `Map` literal whose keys are
	// a user struct is exactly that shape, which is how `map.md`'s two `literal.user-type-key` cases were
	// rejected on programs mentioning no `Box`, no file and no `CharacterSet`.
	//
	// ⚠ **ONLY THE REFUSAL IGNORES THEM — the two EMISSION gates deliberately still read every row**
	// (`kindIsARefusal`). Over-approximating there costs a descriptor-gated drop on a shape
	// that never occurs, which is a no-op at run time; under-approximating there would drop nothing where a
	// drop is owed. A refusal is the one direction where a phantom's cost is a wrong ANSWER.
	//
	// ⛔⛔ **AND A SECOND CLASS OF ROW IS NOT A FACT EITHER — ONE MINTED BY AN INSTANTIATION E3017
	// ALREADY OWNS.** A constraint-violating instantiation describes a program that will not exist, so
	// the inner aliases it substitutes are a CONSEQUENCE of the author's mistake rather than the
	// mistake.
	//
	// ⇒ MEASURED, and the cost is not a mis-worded answer but a SILENCED one: `Set with (Array with Opaque)`
	// mints `Array with (Array with Opaque)` for its buckets, `Array.clone`'s `managed.slice` was refused on
	// its behalf, and that refusal is a `SourceParseError` — so the file stopped, `checkWhereConstraints`
	// short-circuited on `projectHasErrors`, and the two E3017s naming the constraint the author actually
	// broke never spoke at all. The reader was told about `Box with String` and a per-instance cloner, on a
	// program whose fault is that `Opaque` implements neither `Hashable` nor `Equatable`.
	//
	// ⚠ The two filters are applied at DIFFERENT points of the loop below and that is deliberate: the
	// speculative one must run BEFORE the argument is classified (a phantom's argument must not be classified
	// at all), while this one runs AFTER a row has matched, so its chain walk and that walk's allocation stay
	// off every compile that refuses nothing.
	//
	// ⭐ **A REFUSAL KIND ANSWERS WITH WHERE THE MATCHED INSTANCE WAS WRITTEN (BLAME).** A bare `true` is
	// everything the two EMISSION gates need and one fact short of what a REFUSAL needs: the instantiation the
	// USER WROTE is the only source anchor to blame the refusal at (`instantiationSiteOf`). The site, not the
	// instance, is the answer because an instance id means nothing outside the parse that minted it, and the
	// answer is kept across the merge (`rowSetAnswer`). One walk answers both, so the two cannot disagree about
	// which instance matched.
	function instanceWithTypeArgKind(param TypeParamId, kind TypeArgInstantiationKind) returns TypeArgKindMatch
		// ⛔ **THIS IS THE ONE DOOR THAT READS ROWS THE PARSER IS STILL MINTING**, so an answer computed through it
		// is true of a moment rather than of the program — see `aggregateSupportsDeepClone`, which declines to keep
		// one. Marked on ARRIVAL rather than where a row is actually examined: a scan that matches nothing depends
		// on the rows present just as much as one that matches, and so does an early `noInstance` off a name the
		// interner does not hold YET.
		self.deepCloneWalkReadInstances = true

		match self.rowSetAnswer(RowSetQuery.typeArgKind(param, kind: kind)) 'answer'
			noInstance then return TypeArgKindMatch.noInstance
			instance(site) then return TypeArgKindMatch.instance(site)
			holds then panic("ProgramSignatures.instanceWithTypeArgKind: a type-argument-kind question was answered with a flag, which only the two flag questions are")
		end 'answer'
	end 'instanceWithTypeArgKind'

	// The walk behind `instanceWithTypeArgKind`, over the rows this index holds right now.
	function typeArgKindMatchOverTheRows(param TypeParamId, kind TypeArgInstantiationKind) returns TypeArgKindMatch
		let asked = TypeParamIdSet.create()
		return self.typeArgKindMatchThrough(param, kind: kind, asked: asked)
	end 'typeArgKindMatchOverTheRows'

	// ⭐⭐ **A ROW WRITTEN OVER ANOTHER DECLARATION'S PARAMETER STANDS FOR THAT PARAMETER'S EVERY INSTANTIATION.**
	// `type Outer uses T` holding `var inner as Box` interns `Box with Outer.T`, and `Outer with String` builds a
	// `Box with String` whether or not any parse ever interns that row — so, for a kind that follows a view
	// (`kindFollowsADeclarationView`), the row answers with whatever `Outer.T`'s own rows answer. Read as a bare
	// parameter instead, a shared `Box` body reassigning its field neither drops the old `String` nor reserves the
	// descriptor to drop it through. `asked` ends the walk a view over its own declaration's parameters closes.
	function typeArgKindMatchThrough(param TypeParamId, kind TypeArgInstantiationKind, asked TypeParamIdSet) returns TypeArgKindMatch
		if asked.contains(param) 'alreadyWalked'
			return TypeArgKindMatch.noInstance
		end 'alreadyWalked'

		asked.insert(param)
		let owner = try self.typeParamOwnerOf(param) otherwise return TypeArgKindMatch.noInstance
		let position = owner.position

		if let baseId = try self.typeNames.idOf(owner.declaringTypeName) 'namedType'
			if let siblings = try self.rowsOfBase(baseId) 'instantiated'
				for id in siblings 'eachInstance'
					if kindIsARefusal(kind) and self.rowIsSpeculative(id) 'nothingNamedIt'
						continue
					end 'nothingNamedIt'

					let args = self.rowArgs(id)

					if position >= args.count() 'noArgumentAtThePosition'
						continue
					end 'noArgumentAtThePosition'

					let arg = self.instanceArgType(id, position: position)

					if kindFollowsADeclarationView(kind) and maxonTypeTag(arg) == ValueTypeTag.typeParameter 'aDeclarationView'
						let viewed = self.typeArgKindMatchThrough(typeParamIdOf(arg), kind: kind, asked: asked)

						match viewed 'viewed'
							noInstance then continue
							instance then return viewed
						end 'viewed'
					end 'aDeclarationView'

					if not self.typeArgHasKind(arg, kind: kind) 'notThisKind'
						continue
					end 'notThisKind'

					if kindIsARefusal(kind) and self.instantiationChainViolatesItsWhereClause(id) 'aRowE3017AlreadyOwns'
						continue
					end 'aRowE3017AlreadyOwns'

					if self.isArrayBaseName(owner.declaringTypeName) and self.kindExemptsAnUncopiedInstance(kind, id: id) 'nothingCopiesIt'
						continue
					end 'nothingCopiesIt'

					return TypeArgKindMatch.instance(self.instantiationSiteOf(id) if kindIsARefusal(kind) else InstantiationSiteLookup.unwritten)
				end 'eachInstance'
			end 'instantiated'
		end 'namedType'

		return TypeArgKindMatch.noInstance
	end 'typeArgKindMatchThrough'

	// The bool the walk above deliberately is not, for the two EMISSION gates that need only membership.
	function anyInstanceTypeArgHasKind(param TypeParamId, kind TypeArgInstantiationKind) returns bool
		return match self.instanceWithTypeArgKind(param, kind: kind) 'match'
			noInstance gives false
			instance gives true
		end 'match'
	end 'anyInstanceTypeArgHasKind'

	// The per-kind argument predicate the instance-scan gates read (see `instanceWithTypeArgKind`). Each arm
	// reads off the SAME `typeArgIsOwned` / `typeIsManaged` / `typeSupportsDeepClone` boundary the
	// corresponding drop, consume or copy site decides on, so a gate and the emission it guards cannot disagree.
	function typeArgHasKind(t MaxonType, kind TypeArgInstantiationKind) returns bool
		match kind 'kind'
			consumeMoved then return self.typeArgIsOwned(t)
			uncopyableElement then return not self.typeSupportsDeepClone(t, visited: ClonerSet.create(), purpose: GraphCascadePurpose.deepClone)
			managedElement then return self.typeArgIsManagedElement(t)
			noZeroElement then return self.typeArgOwesDrop(t) or self.typeExcludesZero(t)
			retainedFeed then return self.typeIsManaged(t, from: self.typeNames)
			greenThreadElement or
			greenThreadFeed then return self.sourceCloneVerdictOfType(t) == SourceCloneVerdict.holdsAGreenThread
		end 'kind'
	end 'typeArgHasKind'

	// The gate on a shared body's reassignment of a bare `T` field: the displaced value's descriptor-gated
	// drop (`__drop_type_param`) and the borrowed new value's reference. With no instantiation in either
	// boundary the store is a plain one. It is the consume boundary OR the feed-retain one because a
	// borrowed trivial struct (`Box with Point`) is co-owned through the feed's retain and is in only the
	// second. A promise is in only the first: it owes the drop, and the descriptor's `retainFunc@64` is inert
	// for it (`retainCalleeForProtocol`), since `__mm_retain` on a scheduler slab pointer corrupts a header.
	export function genericTypeFieldHasManagedInstantiation(param TypeParamId) returns bool
		return self.anyInstanceTypeArgHasKind(param, kind: TypeArgInstantiationKind.consumeMoved) or self.typeParamFeedCanOwnAReference(param)
	end 'genericTypeFieldHasManagedInstantiation'

	// ⭐⭐ **IS GENERIC `typeName` INSTANTIATED IN THE PROGRAM THIS INDEX WAS SETTLED FOR?** The gate
	// on a shared body's store of a borrowed opaque value (`typeParamOwnerIsInstantiated`).
	//
	// ⭐ **WHETHER THE TYPE IS INSTANTIATED AT ALL IS ANSWERED OVER THE WHOLE PROGRAM, BY SETTLING TWICE.** The
	// sweep interns what declarations name; a type only an expression instantiates (`Box.create(5)`) is found by
	// the fold that merges the parse minting it, filed, and the index is settled again counting it
	// (`Queries.foldEveryFileInto`). So a parse is told what the settled index holds — never its own mints,
	// which would answer one body one way and another body another.
	export function genericTypeIsInstantiated(typeName ByteArray) returns bool
		if self.settledDeclarations().instantiatedByAParse.contains(typeName) 'aParseInstantiatedIt'
			return true
		end 'aParseInstantiatedIt'

		if not self.baseline.settled 'everyRowIsTheSweeps'
			return self.holdsARowOf(typeName)
		end 'everyRowIsTheSweeps'

		let baseId = try self.typeNames.idOf(typeName) otherwise return false
		return self.baseRowInstantiated(baseId)
	end 'genericTypeIsInstantiated'

	// Does this index hold any row of `typeName`, past its baseline included?
	function holdsARowOf(typeName ByteArray) returns bool
		let baseId = try self.typeNames.idOf(typeName) otherwise return false
		let siblings = try self.rowsOfBase(baseId) otherwise return false
		return not siblings.isEmpty()
	end 'holdsARowOf'

	// ⭐ **IS THE GENERIC THAT DECLARES `param` INSTANTIATED?** — the question above, asked of a
	// VALUE's own type-parameter token rather than of a declaration site's name. The token carries both halves
	// of "which type's parameter is this", which is exactly what lets the store ask it without being handed the
	// enclosing type from somewhere else — the pairing hazard `instanceWithTypeArgKind`'s header records.
	//
	// A token no ledger holds answers `false`, for `anyInstanceTypeArgHasKind`'s reason: nothing declares it,
	// so nothing instantiates it.
	export function typeParamOwnerIsInstantiated(param TypeParamId) returns bool
		let owner = try self.typeParamOwnerOf(param) otherwise return false
		return self.genericTypeIsInstantiated(owner.declaringTypeName)
	end 'typeParamOwnerIsInstantiated'

	// ⭐⭐ **CAN A BORROWED VALUE OF `param` OWE A REFERENCE AT ALL — is `retainFunc@64` non-zero for SOME
	// instantiation of the type that declares it?** The gate on the descriptor-mediated retain a
	// shared body owes when it hands its own borrowed `T` to a durable sink, and the STRONGER question
	// `typeParamOwnerIsInstantiated` deliberately is not.
	//
	// ⛔ **AND IT HAS TO BE ASKED, BECAUSE THE WEAK QUESTION REFUSES FOUR COMMITTED PROGRAMS** — MEASURED:
	// `own-name-in-a-generic-body-is-still-Self`, `generic-body-user-generic-inner-alias-create` and two
	// `self-type-member-expression` cases, every one a TRIVIAL instantiation owing no reference. Declining for
	// those emits nothing that would have DONE anything: `__retain_type_param` loads a zero word and hands
	// back the value it was given.
	export function typeParamFeedCanOwnAReference(param TypeParamId) returns bool
		return self.anyInstanceTypeArgHasKind(param, kind: TypeArgInstantiationKind.retainedFeed)
	end 'typeParamFeedCanOwnAReference'

	export function typeParamFeedGreenThreadInstantiation(param TypeParamId) returns TypeArgKindMatch
		return self.instanceWithTypeArgKind(param, kind: TypeArgInstantiationKind.greenThreadFeed)
	end 'typeParamFeedGreenThreadInstantiation'

	// ⭐⭐ **IS `t` A HEAP AGGREGATE?** It asks the one question `containerElementIsManaged` asks of a
	// concrete element — `typeIsManaged` — of an instantiation's argument instead.
	//
	// ⚠ **A SUPERSEDED SPELLING VOTES NOTHING, exactly as it does for the other REFUSING kind**
	// (`typeSupportsDeepClone`'s `genericAlias` arm, which carries the measurement): these classifiers are
	// driven by a whole-program walk over the registry's PRE-SETTLE memory, and a contested alias name no
	// reader can reach is not an instantiation of anything. Voting off one would refuse a program whose
	// single-file spelling compiles — the direction a refusal may not err in.
	export function typeArgIsManagedElement(t MaxonType) returns bool
		if self.typeArgSpellingIsSuperseded(t) 'theContestReplacedThisOne'
			return false
		end 'theContestReplacedThisOne'

		return self.typeIsManaged(t, from: self.typeNames)
	end 'typeArgIsManagedElement'

	// The `noZeroElement` kind asks this where `typeArgIsManagedElement` is too narrow: a promise is
	// not an `__mm` box and still has no zero value. A superseded spelling votes nothing, for the
	// reason given there.
	export function typeArgOwesDrop(t MaxonType) returns bool
		if self.typeArgSpellingIsSuperseded(t) 'theContestReplacedThisOne'
			return false
		end 'theContestReplacedThisOne'

		return self.typeOwesDrop(t, from: self.typeNames)
	end 'typeArgOwesDrop'

	export function typeExcludesZero(t MaxonType) returns bool
		if maxonTypeTag(t) != ValueTypeTag.named 'namesNoDeclaration'
			return false
		end 'namesNoDeclaration'

		let name = self.indexSpaceTypeName(t)
		let form = try self.declaredFormInAnyFile(name) otherwise return self.innerAliasExcludesZero(name)

		match form 'form'
			enumType or
			unionType then return self.enumNameExcludesZero(name)
			rangedAlias then return try self.settledDeclarations().typeAliases.excludesZeroInEveryFile(name) otherwise panic("ProgramSignatures.typeExcludesZero: `declaredFormInAnyFile` answered `rangedAlias` for '{String.from(name)}', which the alias registry holds")
			structType or
			interfaceType or
			functionAlias or
			genericAlias or
			tupleAlias then return false
		end 'form'
	end 'typeExcludesZero'

	function enumNameExcludesZero(name ByteArray) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise panic("ProgramSignatures.enumNameExcludesZero: `declaredFormInAnyFile` answered enum or union for '{String.from(name)}', which `enumTypes` holds")
		return not layout.declaresZeroTag()
	end 'enumNameExcludesZero'

	// A name no declaration holds has no zero rule to apply: it is either the byte element a `b"…"`
	// literal mints, which admits zero, or an unknown type that E3011 reports before lowering.
	function innerAliasExcludesZero(name ByteArray) returns bool
		return match self.innerAliasOf(name) 'inner'
			declared(alias) gives aliasExcludesZero(alias)
			undeclared gives false
		end 'inner'
	end 'innerAliasExcludesZero'

	// The element-copy refusal fires only for an `Array` instance some code copies, directly or through a
	// generic body that copies an array of its own parameter.
	function arrayInstanceMayBeCopied(id GenericInstanceId) returns bool
		if self.rowIsCopyDemanded(id) 'copiedWhereItIsWritten'
			return true
		end 'copiedWhereItIsWritten'

		return self.arrayInstanceIsCopiedByAGenericBody(id)
	end 'arrayInstanceMayBeCopied'

	function kindExemptsAnUncopiedInstance(kind TypeArgInstantiationKind, id GenericInstanceId) returns bool
		match kind 'kind'
			uncopyableElement then return not self.arrayInstanceMayBeCopied(id)

			// A copy written against a concrete instance is refused at the copy (`Parser.admitArrayCopy`),
			// so this kind answers only for a copy a generic body makes.
			greenThreadElement then return not self.arrayInstanceIsCopiedByAGenericBody(id)

			consumeMoved or
			managedElement or
			noZeroElement or
			retainedFeed or
			greenThreadFeed then return false
		end 'kind'
	end 'kindExemptsAnUncopiedInstance'

	function arrayInstanceIsCopiedByAGenericBody(id GenericInstanceId) returns bool
		for hop in self.instantiationOriginChain(id) 'eachEnclosingInstantiation'
			if self.genericBodyCopiesAnArrayOfItsParameter(self.genericInstanceBaseName(hop)) 'itsBodyCopies'
				return true
			end 'itsBodyCopies'
		end 'eachEnclosingInstantiation'

		return false
	end 'arrayInstanceIsCopiedByAGenericBody'

	function genericBodyCopiesAnArrayOfItsParameter(declaringTypeName ByteArray) returns bool
		for demanded in self.copyDemandedRowIds() 'eachDemanded'
			let args = self.rowArgs(demanded)

			if args.count() == 0 'noElement'
				continue
			end 'noElement'

			let element = try args.get(0) otherwise panic("ProgramSignatures.genericBodyCopiesAnArrayOfItsParameter: args.get OOB at 0 below a non-empty list")

			if maxonTypeTag(element) != ValueTypeTag.typeParameter 'notAParameter'
				continue
			end 'notAParameter'

			let owner = try self.typeParamOwnerOf(typeParamIdOf(element)) otherwise continue

			if owner.declaringTypeName.equals(declaringTypeName) 'itsOwnParameter'
				return true
			end 'itsOwnParameter'
		end 'eachDemanded'

		return false
	end 'genericBodyCopiesAnArrayOfItsParameter'

	export function noteArrayCopyDemanded(id GenericInstanceId)
		self.genericInstances.noteCopyDemanded(id)
	end 'noteArrayCopyDemanded'
end 'ProgramSignatures'
