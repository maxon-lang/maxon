module type WarmCounters
	module let allModuleHits as QueryCount
	module let allModuleMisses as QueryCount
	module let tokenHits as QueryCount
	module let tokenMisses as QueryCount
	module let activeTokenHits as QueryCount
	module let activeTokenMisses as QueryCount
	module let parseHits as QueryCount
	module let parseMisses as QueryCount
	module let signatureHits as QueryCount
	module let signatureMisses as QueryCount
	module let admittedLibraryFiles as QueryCount
	module let sharedTokenHits as QueryCount
	module let sharedParseHits as QueryCount
	module let sharedParseMisses as QueryCount
	module let sharedParsePublishes as QueryCount
	module let sharedParseDrifts as QueryCount
	module let sharedParseReusedFiles as QueryCount
	module let storeEntries as QueryCount
	module let storeParses as QueryCount

	module static function of(project Project) returns WarmCounters
		let db = project.db

		return Self{allModuleHits: db.allModuleHits, allModuleMisses: db.allModuleMisses, tokenHits: db.tokenHits, tokenMisses: db.tokenMisses, activeTokenHits: db.activeTokenHits, activeTokenMisses: db.activeTokenMisses, parseHits: db.parseHits, parseMisses: db.parseMisses, signatureHits: db.signatureHits, signatureMisses: db.signatureMisses, admittedLibraryFiles: db.shareableTokenHashes.count() as QueryCount, sharedTokenHits: db.sharedTokenHits, sharedParseHits: db.sharedParseHits, sharedParseMisses: db.sharedParseMisses, sharedParsePublishes: db.sharedParsePublishes, sharedParseDrifts: db.sharedParseDrifts, sharedParseReusedFiles: db.sharedParseReusedFiles.count() as QueryCount, storeEntries: sharedMemoEntryCount(project), storeParses: sharedParseEntryCount(project)}
	end 'of'
end 'WarmCounters'

module type WarmSource
	module let path as FilePath
	module let content as String
	module let library as bool

	static function create(path FilePath, content String, library bool) returns WarmSource
		return Self{path: path, content: content, library: library}
	end 'create'
end 'WarmSource'

module typealias WarmSourceArray = Array with WarmSource

module type WarmImage
	module let code as ByteArray
	module let rdata as ByteArray
	module let symdata as ByteArray
	module let data as ByteArray

	module static function of(result CodeResult) returns WarmImage
		return Self{code: result.code, rdata: result.rdata, symdata: result.symdata, data: result.dataPrelude}
	end 'of'

	module static function none() returns WarmImage
		return Self{code: ByteArray.create(0), rdata: ByteArray.create(0), symdata: ByteArray.create(0), data: ByteArray.create(0)}
	end 'none'
end 'WarmImage'

module type WarmProbe
	module let misses as QueryCount
	module let missed as ParseMissPathRoster

	static function of(misses QueryCount, missed ParseMissPathRoster) returns WarmProbe
		return Self{misses: misses, missed: missed}
	end 'of'
end 'WarmProbe'

module type WarmImmutability
	module let compared as Count
	module let digested as Count
	module let changes as ParseChangeArray

	static function of(compared Count, digested Count, changes ParseChangeArray) returns WarmImmutability
		return Self{compared: compared, digested: digested, changes: changes}
	end 'of'
end 'WarmImmutability'

export type WarmReading
	module let counters as WarmCounters
	module let diagnostics as DiagnosticArray
	module let lines as CapturedDiagnosticTextArray
	module let sources as WarmSourceArray
	module let refused as bool
	module let image as WarmImage
	module let probe as WarmProbe
	module let immutability as WarmImmutability
	module let sharing as LibraryParseSharing

	static function of(project Project, refused bool = false, sources WarmSourceArray = WarmSourceArray.create(0), image WarmImage = WarmImage.none(), probe WarmProbe = WarmProbe.of(0, missed: ParseMissPathRoster.create(0)), immutability WarmImmutability = WarmImmutability.of(0, digested: 0, changes: ParseChangeArray.create(0)), sharing LibraryParseSharing = LibraryParseSharing.undecided) returns WarmReading
		let sink = project.session.diagnostics
		let lines = sink.capturedLines
		sink.capturedLines = CapturedDiagnosticTextArray.create(0)

		return Self{counters: WarmCounters.of(project), diagnostics: project.diagnostics.clone(), lines: lines, sources: sources, refused: refused, image: image, probe: probe, immutability: immutability, sharing: sharing}
	end 'of'
end 'WarmReading'

export union WarmGoal
	codeResult(keepsImage bool)
	merged
end 'WarmGoal'

export union WarmLoadEdit
	none
	appendToLastAuthored(text String)
	replaceAuthored(first String, others String)
end 'WarmLoadEdit'

export union WarmStep
	load(slot String, input FilePath, target Target, defines DefineArray, edit WarmLoadEdit, debugInfo bool)
	edit(slot String, path FilePath, content String)
	compile(slot String, goal WarmGoal)
	probe(slot String)
	snapshot(slot String, tag String)
	compareParses(slot String, merged String, piped String, remerged String, repiped String, edited FilePath)
	read(slot String, sharing bool)

	module function word() returns String
		return match self 'step'
			load gives "load"
			edit gives "edit"
			compile gives "compile"
			probe gives "probe"
			snapshot gives "snapshot"
			compareParses gives "compare parses"
			read gives "read"
		end 'step'
	end 'word'
end 'WarmStep'

module function goalOfWarm(goal WarmGoal) returns CompileGoal
	return match goal 'goal'
		codeResult gives CompileGoal.codeResult
		merged gives CompileGoal.frontEnd(NamespaceDirectoryCheck.unchecked)
	end 'goal'
end 'goalOfWarm'

module function warmKeepsImage(goal WarmGoal) returns bool
	return match goal 'goal'
		codeResult(keepsImage) gives keepsImage
		merged gives false
	end 'goal'
end 'warmKeepsImage'

typealias WarmSlotMap = Map with (String, Project)
typealias ParseSnapshotMap = Map with (FilePath, ParseSnapshot)
typealias WarmSnapshotSets = Map with (String, ParseSnapshotMap)

module type WarmBench
	var projects as WarmSlotMap
	var snapshots as WarmSnapshotSets

	module static function create() returns WarmBench
		return Self{projects: WarmSlotMap.create(), snapshots: WarmSnapshotSets.create()}
	end 'create'

	module function projectIn(slot String) returns Project
		return try self.projects.get(slot) otherwise panic("WarmBench.projectIn: the slot '{slot}' holds no project — a gate loads a slot before any step names it")
	end 'projectIn'

	module function stepped(step WarmStep, memos SharedFileMemoMap) returns WarmReading throws CompileError
		match step 'step'
			load(slot, input, target, defines, edit, debugInfo) then return try self.loaded(slot, input: input, target: target, defines: defines, edit: edit, debugInfo: debugInfo, memos: memos)
			edit(slot, path, content) then return self.edited(slot, path: path, content: content)
			probe(slot) then return try self.probed(slot)
			snapshot(slot, tag) then return self.snapshotted(slot, tag: tag)
			compareParses(slot, merged, piped, remerged, repiped, edited) then return self.compared(slot, merged: merged, piped: piped, remerged: remerged, repiped: repiped, edited: edited)
			read(slot, sharing) then return try self.read(slot, sharing: sharing)
			compile then panic("WarmBench.stepped: a compile is the driver's own job, run on its pools")
		end 'step'
	end 'stepped'

	module function compiled(slot String, image WarmImage) returns WarmReading
		return WarmReading.of(self.projectIn(slot), image: image)
	end 'compiled'

	module function refused(slot String) returns WarmReading
		return WarmReading.of(self.projectIn(slot), refused: true)
	end 'refused'

	function loaded(slot String, input FilePath, target Target, defines DefineArray, edit WarmLoadEdit, debugInfo bool, memos SharedFileMemoMap) returns WarmReading throws CompileError
		let session = CompileSession.over(DriverSession.capturing(), fileMemos: memos)
		let project = try loadProject([input], target: target, session: session, defines: defines.clone())
		project.debugInfo = debugInfo

		try self.editedAtLoad(project, edit: edit)
		self.projects.upsert(slot.clone(), value: project)

		return WarmReading.of(project, sources: warmSourcesOf(project))
	end 'loaded'

	function editedAtLoad(project Project, edit WarmLoadEdit) throws CompileError
		match edit 'edit'
			none then return
			appendToLastAuthored(text) then try self.appendedToLastAuthored(project, text: text)
			replaceAuthored(first, others) then self.replacedAuthored(project, first: first, others: others)
		end 'edit'
	end 'editedAtLoad'

	function appendedToLastAuthored(project Project, text String) throws CompileError
		let last = try lastAuthoredSourceOf(project)
		fileChanged(project, path: last.path, content: "{last.content}\n{text}\n")
	end 'appendedToLastAuthored'

	function replacedAuthored(project Project, first String, others String)
		var firstPlaced = false

		for index in 0 upto project.db.sourcePaths.count() 'eachSource'
			let source = editableSourceAt(project, index: index)

			if source.library 'libraryFile'
				continue
			end 'libraryFile'

			fileChanged(project, path: source.path, content: others if firstPlaced else first)
			firstPlaced = true
		end 'eachSource'
	end 'replacedAuthored'

	function edited(slot String, path FilePath, content String) returns WarmReading
		let project = self.projectIn(slot)
		fileChanged(project, path: path, content: content)

		return WarmReading.of(project)
	end 'edited'

	function probed(slot String) returns WarmReading throws CompileError
		let project = self.projectIn(slot)
		let before = project.db.parseMisses
		project.db.parseMissPaths.clear()
		project.db.recordParseMissPaths = true

		try probeRebuildCacheHits(project) otherwise (err) 'probeFailed'
			project.db.recordParseMissPaths = false
			throw err
		end 'probeFailed'

		project.db.recordParseMissPaths = false

		return WarmReading.of(project, probe: WarmProbe.of(project.db.parseMisses - before, missed: project.db.parseMissPaths.clone()))
	end 'probed'

	function snapshotted(slot String, tag String) returns WarmReading
		let project = self.projectIn(slot)
		self.snapshots.upsert(tag.clone(), value: snapshotParses(project))

		return WarmReading.of(project)
	end 'snapshotted'

	function compared(slot String, merged String, piped String, remerged String, repiped String, edited FilePath) returns WarmReading
		let project = self.projectIn(slot)
		let verdict = reusedParsesVerdict(self.snapshotNamed(merged), piped: self.snapshotNamed(piped), remerged: self.snapshotNamed(remerged), repiped: self.snapshotNamed(repiped), editedPath: edited)

		return WarmReading.of(project, immutability: verdict)
	end 'compared'

	function snapshotNamed(tag String) returns ParseSnapshotMap
		return try self.snapshots.get(tag) otherwise panic("WarmBench.snapshotNamed: no snapshot was taken under '{tag}' — a gate snapshots before it compares")
	end 'snapshotNamed'

	function read(slot String, sharing bool) returns WarmReading throws CompileError
		let project = self.projectIn(slot)

		if not sharing 'noVerdict'
			return WarmReading.of(project, sources: warmSourcesOf(project))
		end 'noVerdict'

		let verdict = (try queryProgramSignatures(project)).libraryParseSharing

		return WarmReading.of(project, sources: warmSourcesOf(project), sharing: verdict)
	end 'read'
end 'WarmBench'

function editableSourceAt(project Project, index ElementIndex) returns WarmSource
	let listed = try project.db.sourcePaths.get(index) otherwise panic("editableSourceAt: index {index} is not below the project's {project.db.sourcePaths.count()} source files — loadSourceFiles throws noSourceFiles before an empty project reaches here")
	let path = try FilePath.from(listed.path) otherwise panic("editableSourceAt: that path came out of the project's own source list, so it cannot fail to re-parse as a path")
	let entry = try project.db.sourceFiles.get(path) otherwise panic("editableSourceAt: sourcePaths lists a file that sourceFiles has no entry for")

	return WarmSource.create(path, content: entry.content, library: isLibrarySourceFile(project, path: path))
end 'editableSourceAt'

function warmSourcesOf(project Project) returns WarmSourceArray
	let sources = WarmSourceArray.create(project.db.sourcePaths.count(), zeroed: false)

	for index in 0 upto project.db.sourcePaths.count() 'eachSource'
		sources.push(editableSourceAt(project, index: index))
	end 'eachSource'

	return sources
end 'warmSourcesOf'

function lastAuthoredSourceOf(project Project) returns WarmSource throws CompileError
	var index = project.db.sourcePaths.count()

	while index > 0 'fromTheEnd'
		index = index - 1
		let source = editableSourceAt(project, index: index)

		if not source.library 'authored'
			return source
		end 'authored'
	end 'fromTheEnd'

	throw CompileError.noSourceFiles(project.rootPath)
end 'lastAuthoredSourceOf'

let OpsPerDigest = 256
let BlocksPerDigest = 32

typealias PartDigestArray = Array with HashDigest

type ParseSnapshot
	export var artifact as FileParseArtifact
	export var digests as PartDigestArray

	static function create(artifact FileParseArtifact, digests PartDigestArray) returns ParseSnapshot
		return Self{artifact: artifact, digests: digests}
	end 'create'
end 'ParseSnapshot'

module typealias ParseChangeArray = Array with String

function snapshotParses(project Project) returns ParseSnapshotMap
	let snapshot = ParseSnapshotMap.create()

	for (path, memo) in project.db.parseCache 'eachParse'
		snapshot.upsert(path, value: ParseSnapshot.create(memo.value, digests: partDigests(memo.value)))
	end 'eachParse'

	return snapshot
end 'snapshotParses'

function digestOf(bytes ByteArray) returns HashDigest
	return Hasher.combinedBytes(Hasher.empty(), bytes: bytes)
end 'digestOf'

function partDigests(artifact FileParseArtifact) returns PartDigestArray
	let digests = PartDigestArray.create(0)

	for func in artifact.module.functions 'eachFunction'
		let one = IrFunctionArray.create(0)
		one.push(func)
		let writer = LibraryCacheWriter.create()
		cacheWriteIrFunctionArray(writer, value: one)
		digests.push(digestOf(writer.payload()))
	end 'eachFunction'

	for entry in artifact.rangeChecks 'eachRangeCheckEntry'
		let writer = LibraryCacheWriter.create()
		entry.checks.cacheWrite(writer)
		digests.push(digestOf(writer.payload()))
	end 'eachRangeCheckEntry'

	for layout in artifact.structTypes 'eachStructLayout'
		let one = StructLayoutArray.create(0)
		one.push(layout)
		let writer = LibraryCacheWriter.create()
		cacheWriteStructLayoutArray(writer, value: one)
		digests.push(digestOf(writer.payload()))
	end 'eachStructLayout'

	var first = 0 as ElementIndex

	while first < artifact.module.blocks.count() 'eachBlockChunk'
		let limit = chunkLimit(first, size: BlocksPerDigest, total: artifact.module.blocks.count())
		let chunk = IrBlockArray.create(limit - first, zeroed: false)

		for position in first upto limit 'eachBlock'
			chunk.push(try artifact.module.blocks.get(position) otherwise panic("partDigests: blocks.get OOB at {position}"))
		end 'eachBlock'

		let writer = LibraryCacheWriter.create()
		cacheWriteIrBlockArray(writer, value: chunk)
		digests.push(digestOf(writer.payload()))
		first = first + BlocksPerDigest
	end 'eachBlockChunk'

	first = 0

	while first < artifact.module.ops.count() 'eachOpChunk'
		let writer = LibraryCacheWriter.create()

		for position in first upto chunkLimit(first, size: OpsPerDigest, total: artifact.module.ops.count()) 'eachOp'
			cacheWriteMaxonOp(writer, value: try artifact.module.ops.get(position) otherwise panic("partDigests: ops.get OOB at {position}"))
		end 'eachOp'

		digests.push(digestOf(writer.payload()))
		first = first + OpsPerDigest
	end 'eachOpChunk'

	let whole = LibraryCacheWriter.create()
	artifact.cacheWrite(whole)
	digests.push(digestOf(whole.payload()))
	return digests
end 'partDigests'

function chunkLimit(first ElementIndex, size ElementIndex, total ElementIndex) returns ElementIndex
	let limit = first + size
	return total if limit > total else limit
end 'chunkLimit'

function chunkCount(total ElementIndex, size ElementIndex) returns ElementIndex
	var chunks = 0 as ElementIndex
	var covered = 0 as ElementIndex

	while covered < total 'eachChunk'
		chunks = chunks + 1
		covered = covered + size
	end 'eachChunk'

	return chunks
end 'chunkCount'

function describePart(artifact FileParseArtifact, index ElementIndex) returns String
	var rest = index

	if rest < artifact.module.functions.count() 'aFunction'
		let func = try artifact.module.functions.get(rest) otherwise panic("describePart: functions.get OOB at {rest}")
		return "function '{String.from(func.name)}'"
	end 'aFunction'

	rest = rest - artifact.module.functions.count()

	if rest < artifact.rangeChecks.count() 'aRangeCheckEntry'
		let entry = try artifact.rangeChecks.get(rest) otherwise panic("describePart: rangeChecks.get OOB at {rest}")
		return "range checks of '{String.from(entry.name)}'"
	end 'aRangeCheckEntry'

	rest = rest - artifact.rangeChecks.count()

	if rest < artifact.structTypes.count() 'aStructLayout'
		let layout = try artifact.structTypes.get(rest) otherwise panic("describePart: structTypes.get OOB at {rest}")
		return "struct layout '{String.from(layout.name)}'"
	end 'aStructLayout'

	rest = rest - artifact.structTypes.count()
	let blockChunks = chunkCount(artifact.module.blocks.count(), size: BlocksPerDigest)

	if rest < blockChunks 'aBlockChunk'
		return "blocks {rest * BlocksPerDigest} onward"
	end 'aBlockChunk'

	rest = rest - blockChunks
	let opChunks = chunkCount(artifact.module.ops.count(), size: OpsPerDigest)

	if rest < opChunks 'anOpChunk'
		return "ops {rest * OpsPerDigest} onward"
	end 'anOpChunk'

	return "a field of the artifact outside its functions, range checks, struct layouts, blocks and ops"
end 'describePart'

union ParseComparison
	unchanged
	changedAt(part ElementIndex)
	reshaped(before ElementIndex, after ElementIndex)
end 'ParseComparison'

function firstChangedPart(before PartDigestArray, after PartDigestArray) returns ParseComparison
	if before.count() != after.count() 'aPartAppearedOrVanished'
		return ParseComparison.reshaped(before.count(), after: after.count())
	end 'aPartAppearedOrVanished'

	for (iter, digest) in before.withIterator() 'eachPart'
		if digest != (try after.get(iter.index()) otherwise panic("firstChangedPart: after.get({iter.index()}) OOB below the shared count {after.count()}")) 'aPartMoved'
			return ParseComparison.changedAt(iter.index())
		end 'aPartMoved'
	end 'eachPart'

	return ParseComparison.unchanged
end 'firstChangedPart'

function noteChange(changes ParseChangeArray, path FilePath, stage String, before ParseSnapshot, after ParseSnapshot)
	match firstChangedPart(before.digests, after: after.digests) 'verdict'
		unchanged then return
		changedAt(part) then changes.push("{path.toString()} {stage}: {describePart(after.artifact, index: part)}")
		reshaped(held, now) then changes.push("{path.toString()} {stage}: it held {held} digested parts and now holds {now}")
	end 'verdict'
end 'noteChange'

let FirstPipelineStage = "was written by the first pipeline"
let RemergeStage = "was changed by the merge after the bytes-only edit, which moves no id and so owes the artifact no renumbering"
let SecondPipelineStage = "was written by the second pipeline"

function reusedParsesVerdict(merged ParseSnapshotMap, piped ParseSnapshotMap, remerged ParseSnapshotMap, repiped ParseSnapshotMap, editedPath FilePath) returns WarmImmutability
	var compared = 0 as Count
	var digested = 0 as Count
	let changes = ParseChangeArray.create(0)

	for (path, first) in merged 'eachParse'
		if path.equals(editedPath) 'theEditedFile'
			continue
		end 'theEditedFile'

		let afterPipeline = try piped.get(path) otherwise panic("reusedParsesVerdict: the parse of {path.toString()} left the memo during the first pipeline")
		let afterRemerge = try remerged.get(path) otherwise panic("reusedParsesVerdict: the parse of {path.toString()} left the memo across a bytes-only edit of another file")
		let afterSecond = try repiped.get(path) otherwise panic("reusedParsesVerdict: the parse of {path.toString()} left the memo during the second pipeline")
		compared = compared + 1
		digested = digested + first.digests.count()

		if not (afterPipeline.artifact is first.artifact and afterRemerge.artifact is first.artifact and afterSecond.artifact is first.artifact) 'reparsed'
			changes.push("{path.toString()} was parsed again although only another file was edited, so it is not a reused parse")
			continue
		end 'reparsed'

		noteChange(changes, path: path, stage: FirstPipelineStage, before: first, after: afterPipeline)
		noteChange(changes, path: path, stage: RemergeStage, before: afterPipeline, after: afterRemerge)
		noteChange(changes, path: path, stage: SecondPipelineStage, before: afterRemerge, after: afterSecond)
	end 'eachParse'

	return WarmImmutability.of(compared, digested: digested, changes: changes)
end 'reusedParsesVerdict'

module type WarmSession
	let driver as CompileDriver.handle
	let sink as DiagnosticSink

	module static function over(driver CompileDriver.handle, sink DiagnosticSink) returns WarmSession
		return Self{driver: driver, sink: sink}
	end 'over'

	module function load(slot String, input FilePath, target Target, defines DefineArray = DefineArray.create(0), edit WarmLoadEdit = WarmLoadEdit.none, debugInfo bool = false) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.load(slot, input: input, target: target, defines: defines.clone(), edit: edit, debugInfo: debugInfo))
	end 'load'

	module function edit(slot String, path FilePath, content String) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.edit(slot, path: path, content: content))
	end 'edit'

	module function tryCompile(slot String, goal WarmGoal) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.compile(slot, goal: goal))
	end 'tryCompile'

	module function compile(slot String, goal WarmGoal) returns WarmReading throws CompileError
		let reading = try self.tryCompile(slot, goal: goal)

		if reading.refused 'aRefusedProgram'
			throw CompileError.compileError
		end 'aRefusedProgram'

		return reading
	end 'compile'

	module function probe(slot String) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.probe(slot))
	end 'probe'

	module function snapshot(slot String, tag String) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.snapshot(slot, tag: tag))
	end 'snapshot'

	module function compareParses(slot String, merged String, piped String, remerged String, repiped String, edited FilePath) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.compareParses(slot, merged: merged, piped: piped, remerged: remerged, repiped: repiped, edited: edited))
	end 'compareParses'

	module function read(slot String, sharing bool = false) returns WarmReading throws CompileError
		return try self.stepped(WarmStep.read(slot, sharing: sharing))
	end 'read'

	function stepped(step WarmStep) returns WarmReading throws CompileError
		let request = freeze CompileRequest.create(DriverWork.warm(step.clone()), origin: ProjectOrigin.sources, target: detectHostTarget(), session: DriverSession.discarding())
		let answer = driverAnswerOf(self.driver, request: request)

		match answer.outcome 'outcome'
			warmed(reading) then return self.reported(reading)
			failed(error) then throw error
			built or
			checked or
			swept or
			claimed then panic("WarmSession.stepped: the driver answered a warm step with another kind of job")
		end 'outcome'
	end 'stepped'

	function reported(reading WarmReading) returns WarmReading
		self.sink.absorb(reading.lines)

		return reading
	end 'reported'
end 'WarmSession'
