typealias RewindMark = Array with ElementIndex

enum MemoTable
	declaredAliases
	rangedAliasTags
	castTargetTags
	elementSlots
	elementLiteralTargets
	globalMapColumns
	imageableVerdicts
	dropCallees
	functionHoldingAggregates
	functionHoldingInstances
	instanceViewAliases
	singleByteGraphemes
	boxedUnionAnswers
	usedTypeNames
	memberAccessedTypeNames
	filedTupleNames
end 'MemoTable'

type RewindClaims
	var claimed as FixedBoolArray

	static function create() returns RewindClaims
		return Self{claimed: FixedBoolArray.create(MemoTable.allCases.count())}
	end 'create'

	function claim(table MemoTable)
		if self.isClaimed(table) 'claimedTwice'
			panic("RewindClaims.claim: {table.name} is claimed by two tables — each MemoTable case is one table, or a rewind undoes one of them twice and the other never")
		end 'claimedTwice'

		try self.claimed.set(table.ordinal, value: true) otherwise panic("RewindClaims.claim: claimed.set OOB at {table.ordinal} — `claimed` holds one slot per MemoTable case")
	end 'claim'

	function requireEveryTableClaimed(lazily MemoTable)
		for table in MemoTable.allCases 'eachTable'
			if table != lazily and not self.isClaimed(table) 'unclaimed'
				panic("RewindClaims.requireEveryTableClaimed: {table.name} is claimed by no table — a MemoTable case with no table behind it is never marked or rewound")
			end 'unclaimed'
		end 'eachTable'
	end 'requireEveryTableClaimed'

	function isClaimed(table MemoTable) returns bool
		return try self.claimed.get(table.ordinal) otherwise panic("RewindClaims.isClaimed: claimed.get OOB at {table.ordinal} — `claimed` holds one slot per MemoTable case")
	end 'isClaimed'
end 'RewindClaims'

interface RewindLog
	function claimedTable() returns MemoTable
	function logCount() returns ElementIndex
	function rewindTo(mutable self, count ElementIndex)
end 'RewindLog'

function rewindLogCount(memo RewindLog, table MemoTable) returns ElementIndex
	requireClaimedAs(memo, table: table)
	return memo.logCount()
end 'rewindLogCount'

function rewindLogTo(memo mutable RewindLog, table MemoTable, count ElementIndex)
	requireClaimedAs(memo, table: table)
	memo.rewindTo(count)
end 'rewindLogTo'

function requireClaimedAs(memo RewindLog, table MemoTable)
	if memo.claimedTable() != table 'wrongMemo'
		panic("rewind dispatch: the {table.name} arm reached the memo that claimed {memo.claimedTable().name} — marking or rewinding it would leave {table.name} unmarked")
	end 'wrongMemo'
end 'requireClaimedAs'

type RewindableMemo uses Key, Value implements RewindLog where Key is Hashable and Equatable and Cloneable
	typealias Entries = Map with (Key, Value)
	typealias Filings = Array with Key

	var entries as Entries
	var filings as Filings
	var table as MemoTable

	static function create(claims RewindClaims, table MemoTable) returns Self
		claims.claim(table)
		return Self{entries: Entries.create(), filings: Filings.create(0), table: table}
	end 'create'

	function claimedTable() returns MemoTable
		return self.table
	end 'claimedTable'

	function get(key Key) returns Value throws MapError
		return try self.entries.get(key)
	end 'get'

	function contains(key Key) returns bool
		return self.entries.contains(key)
	end 'contains'

	function file(key Key, value Value)
		let filed = key.clone()
		try self.entries.insert(key, value: value) otherwise panic("RewindableMemo.file: the key is already filed — a rewind would drop the earlier answer along with this one")
		self.filings.push(filed)
	end 'file'

	function logCount() returns ElementIndex
		return self.filings.count()
	end 'logCount'

	function rewindTo(count ElementIndex)
		for position in count upto self.filings.count() 'eachFiledSince'
			_ = self.entries.remove(try self.filings.get(position) otherwise panic("RewindableMemo.rewindTo: filings.get OOB at {position}"))
		end 'eachFiledSince'

		self.filings.truncate(count)
	end 'rewindTo'
end 'RewindableMemo'

type RewindableNames implements RewindLog
	var roster as UsedTypeNameRoster
	var filings as NameRoster
	var table as MemoTable

	static function create(claims RewindClaims, table MemoTable) returns RewindableNames
		claims.claim(table)
		return Self{roster: noUsedTypeNames, filings: NameRoster.create(0), table: table}
	end 'create'

	function claimedTable() returns MemoTable
		return self.table
	end 'claimedTable'

	function contains(name ByteArray) returns bool
		match self.roster 'state'
			unwritten then return false
			entries(names) then return names.contains(name)
		end 'state'
	end 'contains'

	function insert(name immutable ByteArray)
		let names = self.namesForWrite()

		if names.contains(name) 'alreadyListed'
			return
		end 'alreadyListed'

		names.insert(name)
		self.filings.push(name)
	end 'insert'

	function published() returns UsedTypeNameRoster
		return self.roster
	end 'published'

	function logCount() returns ElementIndex
		return self.filings.count()
	end 'logCount'

	function rewindTo(count ElementIndex)
		if self.filings.count() <= count 'nothingFiledSince'
			return
		end 'nothingFiledSince'

		let names = self.namesForWrite()

		for position in count upto self.filings.count() 'eachFiledSince'
			_ = names.remove(try self.filings.get(position) otherwise panic("RewindableNames.rewindTo: filings.get OOB at {position}"))
		end 'eachFiledSince'

		self.filings.truncate(count)
	end 'rewindTo'

	function namesForWrite() returns UsedTypeNameSet
		match self.roster 'state'
			unwritten then break
			entries(names) then return names
		end 'state'

		let fresh = UsedTypeNameSet.create()
		self.roster = UsedTypeNameRoster.entries(fresh)

		return fresh
	end 'namesForWrite'
end 'RewindableNames'

type BoxedUnionAnswers implements RewindLog
	var answers as BoxedUnionAnswerArray
	var table as MemoTable

	static function create(claims RewindClaims) returns BoxedUnionAnswers
		claims.claim(MemoTable.boxedUnionAnswers)
		return Self{answers: BoxedUnionAnswerArray.create(0), table: MemoTable.boxedUnionAnswers}
	end 'create'

	function claimedTable() returns MemoTable
		return self.table
	end 'claimedTable'

	function answerFor(nameId TypeNameId) returns BoxedUnionAnswer
		if nameId >= self.answers.count() 'neverAsked'
			return BoxedUnionAnswer.unasked
		end 'neverAsked'

		return try self.answers.get(nameId) otherwise panic("BoxedUnionAnswers.answerFor: answers.get OOB at {nameId} below its own count")
	end 'answerFor'

	function file(nameId TypeNameId, boxed bool)
		self.answers.growFilled(nameId + 1, value: BoxedUnionAnswer.unasked)
		try self.answers.set(nameId, value: BoxedUnionAnswer.boxed if boxed else BoxedUnionAnswer.notBoxed) otherwise panic("BoxedUnionAnswers.file: answers.set OOB at {nameId} after growing past it")
	end 'file'

	function logCount() returns ElementIndex
		return self.answers.count()
	end 'logCount'

	function rewindTo(count ElementIndex)
		if self.answers.count() > count 'answersPastTheMark'
			self.answers.truncate(count)
		end 'answersPastTheMark'
	end 'rewindTo'
end 'BoxedUnionAnswers'
