// Compiler/TargetFacilities.maxon — WHICH HOST FACILITY A RUNTIME ENTRY NEEDS, AND WHICH TARGETS HAVE IT.
//
// ⭐⭐ **THE QUESTION A PORT POSES IS *DOES THIS TARGET PROVIDE THE FACILITY THIS CALLEE NEEDS?*, AND IT IS
// TWO INDEPENDENT FACTS** — a callee's requirement and a target's capability. Fused into one bool meaning
// *"x64-windows only"* there is no seam to land a family through: one family landing on a second target
// makes the answer wrong for every other family at once. They are separated here:
//
//   • `calleeHostFacility(callee)` — the callee's requirement, and the door to E3104. One `HostFacility` or
//     `none`; the per-family predicates it consults still live with their runtimes, so a band added to one
//     of them is still gated by construction rather than by memory.
//   • `targetProvidesFacility(target, facility)` — the target's capability. The table a BACKEND writes into
//     when it lands a family, and the ONE place a lane's progress is recorded.
//
// ⚠ **THE TWO ARE NOT IN LOCKSTEP, AND ONE ROW PROVES IT: A FACILITY MAY BE IN THE TABLE AND NOT IN
// `calleeHostFacility`.** `terminalDetection` is exactly that — its lane row is read by
// `TerminalRuntime.installTerminalRuntime` to pick a BODY rather than by this file to refuse a CALL, because
// the absence of terminal detection is an ANSWER ("not a terminal") where the absence of a file surface is
// not. See that enum case for the whole argument and for what it cost to learn. ⇒ A new facility must
// decide which of the two shapes it is; being in the enum does not by itself make it a refusal.
//
// ⚠ **THE TABLE IS THE BACKEND'S CLAIM AND MUST BE KEPT HONEST BY THE BACKEND.** A `true` here promises that
// the target's isel lowers every `StdOp` the facility's runtime bodies emit. Write one before the lowering
// exists and the E3104 stops firing while the backend still panics three tiers down, which is a worse
// answer than refusing the surface outright. The backends' own `panic` arms are the backstop for that
// mistake, never the user-facing rejection.
//
// ⚠ **A FACILITY IS NAMED FOR WHAT THE HOST PROVIDES, NOT FOR THE API THAT PROVIDES IT.** `wallClock` rather
// than `getSystemTimeAsFileTime`: two platforms answer the same question through different calls, and a
// facility named after one of them cannot be claimed by the other without reading as a lie.

// ⭐ THE HOST FACILITIES A MAXON PROGRAM CAN REACH — one case per band whose runtime bodies bottom out in
// `StdOp`s a backend must lower with real OS calls, i.e. per family whose absence a program can NOTICE.
//
// ⚠ **THIS LINE READ "one case per family whose absence is a REFUSAL", AND `terminalDetection` FALSIFIED
// IT.** For every other case here the absence leaves a program with no answer at all, and the honest
// response is E3104 at the call's own span. For that one the absence IS an answer, so its row picks a
// runtime BODY instead. What every case still shares is the sentence above: a `true` promises a lowering.
//
// ⚠ Deliberately NOT a case per runtime ENTRY POINT. `__gt_now_ns` and `__Builtins.currentTimeMs` are one
// facility asked twice, and a target that lowers the monotonic clock lowers both or neither — so splitting
// them would invite a table with two answers to one question.
// ⚠ EXPORTED, and a `module`/file-private narrowing will be REVERSED by the build: `SemanticCheck`
// reads this enum for the services gate (`requireTargetSupportsServiceEntry`), which asks this table
// rather than refusing blind. An unused-export sweep narrowed it once, after which that gate stopped
// compiling.
export enum HostFacility
	// The scheduler's monotonic counter (`osReadClock`) — `__gt_now_ns` and every `Clock.*` above it.
	monotonicClock

	// The calendar (`osReadWallClock`) — `__clock_now_unix_s`. Split from the monotonic clock because a
	// reading that steps backwards when NTP corrects a drift is useless to a deadline, which is the same
	// split `ClockRuntime`'s header makes for the same reason.
	wallClock

	// This thread's own CPU consumption (`osThreadCpuTicks`) — `__thread_cpu_ticks`. Its own facility
	// because its UNIT is platform-defined (TSC ticks vs nanoseconds) and its API is unrelated to either
	// clock above: a target can serve both wall and monotonic time and still have no per-thread cost clock,
	// which is exactly WASI's position.
	threadCpuClock

	// How long the MACHINE has been up (`osTickCountMs`) — `__uptime_ms`. Its own facility rather than a
	// corner of `wallClock`, on this enum's stated rule that a facility is named for what the HOST provides:
	// a monotonic count since boot and a calendar are different questions with different APIs, and the
	// answer to one says nothing about the other.
	//
	// ⚠ **THE ROW IS ABOUT AN INSTALL GATE, NOT ABOUT WHETHER A LANE CAN SPELL THE CALL.** Every POSIX lane
	// has a `mrt_host_tick_ms` chunk, and a lane that installs it only under `usesChildPipes` must answer `false`
	// here: the callee's `iatCall`/`callDirect` would then relocate against a chunk that is not in the image
	// for a program that reads the uptime and spawns nothing. A lane claims this row by gating the chunk on
	// the union of the op's producers, which is the "a `true` promises a lowering" rule this file's header
	// states.
	uptimeClock

	// A green thread's timed park — `__gt_sleep`, and so `sleep(ms)` through `stdlib/Sleep.maxon`.
	sleep

	// The cooperative reschedule (`__gt_resched`) — `Scheduler.yield()`. The scheduler's run-queue handoff
	// through `__gt_context_switch`, which is a hand-assembled per-CPU chunk rather than a lowering.
	reschedule

	// The green-thread substrate a `select` drives (`__gt_await_any`), and the whole `async`/`await` floor
	// under it.
	greenThreads

	// A child process — spawn, its three pipes, and the wait (`__gt_subp_*`, `__gt_process_run`,
	// `__gt_io_read`).
	subprocess

	// The file surface (`__mf_*`) — open, read, write, close, size, delete, rename, stat.
	managedFile

	// The directory surface (`__md_*`) — exists, create, current path, and the search walk.
	managedDirectory

	// The socket surface (`__sock_*`).
	managedSocket

	// The program's own argument vector (`__cl_*`). Its own facility rather than a corner of `processInfo`
	// because argv has a DIFFERENT SHAPE per platform — one unsplit string on Windows, a pre-split vector
	// under SysV — so a target serves it as a rung rather than as a lowering.
	commandLine

	// Standard input (`__con_*`).
	consoleStdin

	// The process's own IDENTITY: its executable path and its pid (`__proc_exe_path`, `__proc_pid`).
	processInfo

	// The process's own SCHEDULING PRIORITY (`__proc_bg_priority`). Its own facility rather than a corner of
	// `processInfo` because the two are a DIFFERENT KIND of question and the platforms split them that way:
	// reading an identity is one call that cannot fail, while lowering a priority is a WRITE whose SCOPE
	// disagrees across POSIX — `setpriority(PRIO_PROCESS, ...)` scopes to the process on Darwin and to the
	// calling THREAD on Linux, so on a Linux lane the two verbs are not the same verb at all
	// (`StdToArm64Conversion.lowerOsEnterBackgroundPriority` carries the argument, and the arm64-linux row in
	// `targetProvidesFacility` carries what that scope difference still leaves owed now that the lane has
	// worker Ms).
	//
	// ⚠ **THE SPLIT RECORDS THE DIFFERENCE IN KIND, NOT A SCHEDULE** — and because the two are separate
	// rows, a lane may serve the identity half rungs before it can serve the priority half.
	processPriority

	processLiveness

	// How many processors the machine has (`__cpu_count`).
	cpuCount

	// ⭐⭐ **PAGES FROM THE OS — reserve, commit, decommit and free (`StdOp.osAllocPages`,
	// `osReservePages`, `osCommitPages`, `osDecommitPages`, `osFreePages`).** One facility over all five
	// rather than one per verb, on this enum's stated rule that a facility is named for what the HOST
	// provides: the five are one page API per platform (`VirtualAlloc`/`VirtualFree`, `mmap`/`munmap`/
	// `madvise`, `memory.grow`), and a lane that lowers one lowers all of them or none.
	//
	// ⚠ **wasm32-wasi PROVIDES IT, AND ITS RESERVE IS ITS ALLOC.** Linear memory only ever GROWS and
	// `memory.grow` both takes the range and backs it, so there is no state between "not there" and "there"
	// for a reservation to occupy; the decommit and the free emit nothing. That is the honest translation of
	// a distinction the machine does not have, not a gap — see `StdOp.osReservePages`.
	pageMemory

	// ⭐ **AN OS MUTUAL-EXCLUSION LOCK over a region the caller owns (`StdOp.osLockInit`, `osLockEnter`,
	// `osLockLeave`).** Its own facility rather than a corner of `greenThreads`: the scheduler is the only
	// consumer today, but the object is a bare host primitive with no scheduler in it, and a lane can serve
	// one without the other.
	//
	// ⭐⭐ **wasm32-wasi PROVIDES IT VACUOUSLY, AND THAT IS AN ANSWER RATHER THAN A HOST OBJECT.** A WASI
	// component has one thread, so there is no second party to exclude — exclusion is already total, and the
	// honest lowering of all three ops is ZERO INSTRUCTIONS. Each has its own arm in `StdToWasm.emitBodyOp`
	// emitting nothing, which is what a `true` promises, exactly as `pageMemory`'s row states for its five.
	//
	// ⛔ **A wasm LANE WITH THREADS FALSIFIES THAT AND OWES A REAL LOWERING FIRST.** The emptiness follows
	// from the machine having one thread and from nothing else; a threaded component needs three real bodies,
	// and this row must go back to `false` until it has them.
	hostMutex

	// ⭐⭐ **PER-OS-THREAD STORAGE, READ AT AN OFFSET THE PROGRAM PUBLISHED (`StdOp.tlsSlotLoad`).** Its own
	// facility rather than a corner of `greenThreads`: the slot is a bare host primitive with no scheduler in
	// it, and the ALLOCATOR is the widest consumer — every allocation and every free begins by asking which
	// machine is running, which is one read of this slot.
	//
	// ⛔ **ITS ABSENCE IS PERMANENT WHERE THE MACHINE HAS ONE THREAD, AND A CONSTANT IS NOT AN ANSWER.** On
	// wasm32-wasi there is no second thread for storage to be per-thread OF, so `StdToWasm.emitBodyOp` panics
	// on the op rather than folding it — folding would silently hand every reader the same slot, which is
	// `currentThreadToken`'s note one arm over: a constant is the RIGHT answer for an IDENTITY and a WRONG one
	// for STORAGE.
	threadLocalSlot

	// Whether a standard stream is a TERMINAL (`__tty_*`). Its own facility rather than a corner of
	// `consoleStdin`, on this enum's stated rule that a facility is named for what the HOST provides:
	// reading standard input and asking the OS what KIND of object a handle is are two different questions
	// with two different APIs, and a lane can serve either without the other — Win32 answers the second with
	// `GetFileType` and POSIX with `isatty`, neither of which has anything to do with the read.
	//
	// ⭐⭐ **THE ONE ROW HERE THAT DOES NOT PRODUCE AN E3104, AND THE DIFFERENCE IS THE SHAPE OF THE
	// ABSENCE.** Every other facility's absence leaves a program with NO ANSWER — there is no honest `read
	// stdin` on a lane with no stdin — so `calleeHostFacility` maps those bands to a refusal at the call's
	// own span. The absence of terminal detection IS an answer: "this is not a terminal", the conservative
	// half, and what `--color=auto` resolved to everywhere before any of this existed. So this row is read
	// by `TerminalRuntime.installTerminalRuntime`, which emits the detecting body where it is `true` and a
	// `return 0` body where it is `false`, and the callee exists on every lane.
	//
	// ⛔ **THAT DISTINCTION WAS PAID FOR.** Mapped into `calleeHostFacility` like its neighbours, it made
	// The compiler UNBUILDABLE for arm64-macOS in a day: `Testing/TestRender` asks the question unconditionally,
	// `Testing/` is ordinary user code, and this gate is reachability-blind for user code by design.
	terminalDetection

	// A NAMED SHARED SECTION two processes both map (`__shm_*`). Its own facility rather than a corner of
	// `managedFile`, on this enum's stated rule that a facility is named for what the HOST provides:
	// publishing a section under a name and mapping it into another process is a different API from
	// reading a file, and a lane can serve either without the other.
	sharedMemory

	// ⭐⭐ **SAMPLING ANOTHER THREAD OF THIS PROCESS — the suspend/context/read/resume loop, the
	// high-resolution tick that drives it and the module map that names what it finds (`StdOp.osHostSample`).**
	// Its own facility rather than a corner of `processInfo`, on this enum's stated rule: reading one's own
	// identity is a call that cannot fail, while sampling walks ANOTHER thread's register file and copies
	// ANOTHER stack out of memory — a different question with a different API.
	//
	// ⛔⛔ **ITS ROW IS ABOUT A CPU AS WELL AS AN OS, WHICH NO OTHER ROW IN THIS TABLE IS.** A sampled
	// register file arrives as a `CONTEXT`, whose RIP/RSP/RBP offsets are x64's; on any other CPU those same
	// displacements name three unrelated words. So a lane claiming this row on the strength of `os(Windows)`
	// alone would not FAIL — it would symbolize garbage into a confident profile, which is the worst kind of
	// wrong answer a profiler can give. The table is keyed on a whole `Target` precisely so this can be said.
	processSampling
	debugAgent
end 'HostFacility'

// The answer `calleeHostFacility` returns. A union rather than a bool-plus-out-param so that "this callee
// needs nothing" is a case the caller must handle, not a sentinel it can forget to test.
union CalleeFacility
	needs(facility HostFacility)
	none
end 'CalleeFacility'

// ⭐ **WHICH HOST FACILITY THIS CALLEE NEEDS — the roster the E3104 gate reads.**
//
// **A NAME JOINS WHEN SOURCE NAMES IT AND THE PARSER ROUTES IT HERE.** A compiler-INSERTED `__gt_*` call
// (`__gt_promise_drop` at a scope exit, `__gt_io_park` inside an `__mf_*` body) is deliberately absent,
// because an E3104 against one of those names a runtime entry the user has never heard of at a span where
// they wrote nothing. `SemanticCheck.requireTargetSupportsCallee`'s header carries that argument in full,
// including the two `async-linearity` cases that measured it.
//
// ⚠ **THE ORDER OF THE TESTS IS NOT ARBITRARY WHERE TWO COULD MATCH.** They cannot today — every family
// predicate is a distinct prefix or an exact name — and the four individually-named scheduler entries are
// tested FIRST so that a prefix band added later cannot silently swallow one of them.
// ⭐⭐ **WHY EACH FAMILY IS ON THE ROSTER.** Several of the paragraphs below record a MEASUREMENT that is
// not re-derivable from the code. Where one says "x64-windows only", read "needs a facility whose providers
// are named in `targetProvidesFacility`": a family is on the roster for what it NEEDS, which no port
// changes.
//
// ⭐ **THE RUNTIME ENTRIES A SOURCE-WRITTEN BUILTIN LOWERS TO THAT ONLY A HOST FACILITY CAN PROVIDE.** The
// exact set `requireTargetSupportsCallee` refuses below (E3104), and the deliberate counterpart of
// `targetProvidesFacility` below it: one says what a CALLEE needs, the other what a TARGET has. It is
// also what `stdlibSubstrateEntries` ASKS to seed its fixpoint — that fixpoint propagates this answer
// through the stdlib call graph rather than keeping a second list of entries to drift from it.
//
//   • `__gt_now_ns` — `osReadClock`'s QueryPerformanceCounter/Frequency (`__Builtins.currentTimeNanos`,
//     `currentTimeMs`, and every `Clock.*` written against them);
//   • `__clock_*` — `osReadWallClock`'s GetSystemTimeAsFileTime (`__Builtins.currentUnixTimeSeconds`);
//   • `__gt_sleep` — the green-thread timer park, whose deadline is computed from that same `osReadClock`
//     reading (`__Builtins.sleep(ms)`, and so every `sleep(ms)` through `stdlib/Sleep.maxon`'s body).
//   • `__gt_resched` — the cooperative reschedule (`__Builtins.yield()`, and so every `Scheduler.yield()`
//     through `stdlib/Scheduler.maxon`'s body). It is the same scheduler: a run-queue handoff through
//     `__gt_context_switch`, falling back to `__gt_timer_check`, neither of which the other three backends
//     provide.
//   • `__cpu_*` — `osCpuCount`'s `GetActiveProcessorCount` (`__Builtins.cpuCount()`). The MACHINE query,
//     and the one whose band-mate is deliberately NOT here: `__sched_max_active_workers` asks the
//     SCHEDULER rather than the OS and its body is a constant return, so it lowers on every target. See
//     `CpuParallelRuntime`'s header for why one file wears two prefixes.
//   • `__thread_*` — `osThreadCpuTicks`'s `QueryThreadCycleTime` (`__Builtins.threadCpuTicks()`). The
//     THREAD-COST query, and `ClockRuntime`'s second band. Its own band-mate `__clock_*` is already here,
//     one bullet up; the two are split by which IMPORT they reach, not by whether they lower.
//
// ⚠ `__gt_io_park` — the filesystem yield — is deliberately ABSENT, and by this set's own rule: SOURCE never
// names it. It is reachable only from the `__mf_*`/`__md_*` bodies, and those are already refused below by
// their prefix tests, so gating it here would only let it be blamed for a call the user did write.
//
// It spans two runtime BANDS — the monotonic clock and the sleep park are `__gt_`-named because the
// SCHEDULER owns that counter and that timer heap (see `ClockRuntime.maxon`'s header) — which is why it is
// one named predicate rather than a prefix test at the call site.
//
// ⚠ **IT IS NOT `isGtRuntimeCallee`, AND THAT WIDER TEST WAS MEASURED WRONG.** The `__gt_` band also holds
// calls the compiler INSERTS rather than the user writes — `__gt_promise_drop` is emitted at a SCOPE EXIT
// for an un-awaited promise — and an E3104 against one of those names a runtime entry the user has never
// heard of, at a span where they wrote nothing, blaming the drop instead of the `async`. Measured on the
// wasm suite: two `async-linearity.error.*` cases, whose pinned diagnostic is the target-NEUTRAL
// double-await E3100, additionally reported "'__gt_promise_drop' has no wasm32-wasi implementation" at the
// closing `end`. So a name joins this set when SOURCE names it and the parser routes it here, never because
// it shares a prefix with one that does.
//
// ⚠ **STILL OUTSIDE IT: `async`/`await`.** Their `__gt_*` calls do not exist until lowering — the same
// blind spot `scanRuntimeUsage` documents — so no callee-name test can reach them and gating them honestly
// means gating the async OP KINDS, which is its own piece of work.
//
// ⭐⭐ **THE SUBPROCESS FAMILY IS IN IT, AND A DOOR LEFT OUT OF IT DIES AS A BACKEND PANIC RATHER THAN A
// DIAGNOSTIC.** All three doors a program can spawn a child through name their
// entry here — `__Builtins.runProcess` → `__gt_process_run`, `spawnReadLine` → `__gt_io_read`, and the whole
// `__gt_subp_` band behind the seven streaming builtins and the `__Builtins.subprocess*`
// intrinsics (`managedIsNull` sits in that band's parser table but is a heap predicate and lowers nowhere
// near it) —
// so a subprocess program on arm64/linux/wasm is refused at the call's own span instead of panicking three
// tiers down. Each satisfies this set's rule: SOURCE names the builtin and the parser routes it to exactly
// one entry.
//
// ⚠ The band test also admits FOUR entries no source line names — `__gt_subp_yield_read`,
// `__gt_subp_spawn_core`, `__gt_subp_str_from_bytes` and `__gt_subp_argv_cmdline` (count them off the
// `b"__gt_subp_` grep rather than off this sentence). That is harmless in a band this narrow, unlike in
// the wider `isGtRuntimeCallee` the paragraph above rejects, and the argument covers all four
// identically: every one of them is
// reachable only from another `__gt_subp_*` BODY. `checkCalls` walks Maxon-tier ops (user and stdlib source),
// never a hand-built Std graph, so there is no call site for the gate to blame at.
//
// --- the per-family arguments, written where each family joined ---
//
// The file-IO entries join the clock and sleep ones: `osFileOpenRead` lowers only where a lane has
// written it, and the backends that have not panic rather than fake it — so the program must be refused
// HERE, at the call's own span, before it reaches one.
// The directory entries join them on the same terms and by the same PREFIX test, so the whole
// eight-method surface is gated by construction rather than by a list somebody has to remember to extend.
// The command-line entries join on the same terms and by the same PREFIX test. ⚠ Their reason is one the
// four above do not have: argv is not merely UNIMPLEMENTED elsewhere, it has a DIFFERENT SHAPE elsewhere
// (one unsplit string on Windows, a pre-split vector under SysV), so serving another target is a rung
// rather than a lowering. `CommandLineRuntime`'s header carries it in full.
// The standard-input and executable-path entries join on the same terms and by the same PREFIX test, and
// each has a reason of its own beyond "unimplemented elsewhere" — the shape argument again, twice over.
// STANDARD INPUT has no HANDLE
// to fetch under POSIX or WASI (fd 0 *is* the handle; a component holds an input-stream resource), so
// `osStdHandle` has no work to do there. The EXECUTABLE PATH is read by three different OS APIs with three
// different retry protocols (`stdlib/Process.maxon:26-27`), and WASI has no analogue at all.
// `ConsoleRuntime`'s and `ProcessRuntime`'s headers carry each in full.
//
// ⭐⭐⭐ **FOUR OF THE PARAGRAPHS ABOVE CONCLUDE "A RUNG RATHER THAN A LOWERING", AND arm64-macOS SETTLES
// EACH OF THEM DIFFERENTLY — WHICH IS WHY THE REASONS STAY AND ONLY THE TABLE MOVES.** The `commandLine`
// argument is RIGHT: argv really is a different shape, and arm64-macOS serves it through a different Std
// GRAPH (`CommandLineRuntime.commandLineShape`) rather than a different lowering. The `consoleStdin`
// argument is HALF right: there really is no `GetStdHandle` under POSIX, and it does not follow that a
// rung is needed — an op with no OS work to do lowers to arithmetic, and `osStdHandle` is one
// subtraction. `managedFile` and `managedDirectory` are plain "unimplemented elsewhere", and that lane
// implements them — the directory half at real cost, because Win32 takes a GLOB where POSIX takes a
// DIRECTORY. ⇒ **A reason on this roster says what a callee NEEDS and never what a target HAS; only
// `targetProvidesFacility` says the second, which is why a landing edits one row and no paragraph.**
// The SUBPROCESS band joins on the same terms and by the same PREFIX test, so an entry point added to it
// later is gated by construction rather than by memory. Its own reason is stronger than "unimplemented
// elsewhere": `CreateProcessA`, three named pipes and an IOCP completion port are a WINDOWS shape, and
// WASI has no process-spawn primitive at all — so serving another target is a rung rather than a
// lowering, and on wasm it is not even that. `__Builtins.runProcess` and `spawnReadLine` are named individually
// because their entries live in the SCHEDULER band rather than behind the subprocess prefix.
// The SOCKET band joins on the same terms and by the same PREFIX test. Its own reason is the
// subprocess band's, one library over: `ws2_32.dll` is a Windows shape, and while WASI does have
// `wasi:sockets`, this slice is not wired to it — so serving another target is a rung rather than a
// lowering.
//
// ⛔⛔ **WITHOUT THIS ROW A LEGAL PROGRAM PANICS THE COMPILER.** MEASURED 2026-08-21,
// `__ManagedSocket.tcpConnect` built with `--target=wasm32-wasi`:
// `panic at StdToWasm.maxon:1624: emitBodyOp: \`osReadClock\` is x64-windows only` — the wasm backend
// tripping over the green-thread park the socket entry opens with, and naming a CLOCK op at a program
// that opened a socket. ⛔ **The surface without the floor is worse than neither**: names declared with
// no runtime behind them turn a clean `E3004` into a backend panic. That is why this predicate is the
// FLOOR: every non-x64-windows backend panics on these ops BY DESIGN, so the refusal has to happen here,
// at the call's own span, or it does not happen at all.
// The MACHINE query (`__Builtins.cpuCount` ⇒ `__cpu_count`) joins on the same terms and by the same
// PREFIX test. Its own reason is the SHAPE argument again: `GetActiveProcessorCount` and
// `sysconf(_SC_NPROCESSORS_ONLN)` are two APIs with two return conventions, and WASI has no
// processor-count primitive AT ALL — a component has no OS-thread concept to count. So on that lane the
// refusal is stronger than "not yet": a lowering there could only fabricate a number, and a fabricated
// core count is a silent wrong answer rather than a missing feature.
// ⚠ **ITS BAND-MATE `__sched_max_active_workers` IS DELIBERATELY ABSENT**, which is why the two wear
// different prefixes at all: that entry reaches no OS — its whole body is one `.data` load and a `ret`,
// which lowers on every target the compiler emits — so gating it would refuse a load.
// `specs/builtins-cpu-parallel.md` pins BOTH halves, because the refusal case alone cannot tell a
// live gate from a compiler that refuses the whole family.
// The THREAD-COST query (`__Builtins.threadCpuTicks` ⇒ `__thread_cpu_ticks`) joins on the same terms and
// by the same PREFIX test. Its own reason is the SHAPE argument once more: `QueryThreadCycleTime` answers
// TSC ticks through a `ULONG64*` while `clock_gettime(CLOCK_THREAD_CPUTIME_ID)` answers NANOSECONDS
// through a `timespec`, so a POSIX lane is a rung rather than a lowering — and WASI has no per-thread CPU
// clock at all. A lowering there could only fabricate a cost, which is the silent wrong answer the
// machine query's paragraph refuses one clause up.
// ⚠ **ITS BAND-MATE, THE `__mm_counter_*` READERS, IS DELIBERATELY ABSENT** for
// `__sched_max_active_workers`'s reason: each sums a column of the allocator's own state region, which
// lowers on every target the compiler emits, and the allocator that maintains those columns runs on all of
// them.
// `specs/builtins-mm-counters.md` pins that acceptance, which is what makes the refusal below a
// NARROW gate rather than a family-wide one.
// ⭐⭐ **THE SELECT (`__Builtins.awaitAny` ⇒ `__gt_await_any`) JOINS INDIVIDUALLY, LIKE ITS THREE
// SCHEDULER BAND-MATES ABOVE.** It is the whole green-thread substrate — a `TlsAlloc`'d current-P
// slot, a context switch, a poller — so on any other backend the program dies in a deliberate x64-windows
// gate that knows it is one (`StdToWasm: the P1.5 IOCP ops are x64-windows only`;
// `StdToX64Conversion: lowerTlsAlloc: TlsAlloc is x64-windows only`) rather than at its own span. That is
// exactly the shape the `async`/`await` band still has, whose entry points are NOT here; no further such
// door may be opened while it stands, so this intrinsic is named and the E3104 lands at the call.
// MEASURED on `--target=wasm32-wasi`: `error E3104: … it lowers to the runtime entry '__gt_await_any',
// which has no wasm32-wasi implementation`, at the call's own span
// (`specs/await-any.md`'s `error.rejected-on-wasm`, which reaches its subject through
// `__Builtins.parallelBoundary()` rather than `Scheduler.yield()` — the latter is on THIS roster and would
// have masked it four lines earlier).
//
// ⚠ **THE DOOR IS THIS PREDICATE AND NOT `requireTargetSupportsServiceEntry`, which serves the
// same class one construct over.** That twin exists for an op whose callee is MINTED AT LOWERING and
// which therefore reaches `checkCalls` with no name to key on. `awaitAny` is an ordinary named `call` op, so
// it arrives there carrying the very name this predicate keys on and needs no second door.
//
// The PROCESS-SAMPLING band joins on the same terms and by the same PREFIX test. Its own reason is the
// SHAPE argument in its sharpest form, and it is about a CPU rather than an OS: the sampled register file
// arrives as a Win32 `CONTEXT`, whose RIP/RSP/RBP displacements are x64's, so a lane claiming this row on
// the strength of `os(Windows)` alone would not fail — it would read three unrelated words as a program
// counter and a frame chain, and hand back a confident profile of nothing. macOS has the equivalent
// primitives behind `task_for_pid`, which is an ENTITLEMENT question rather than a coding one, and Linux's
// `ptrace` is a different mechanism with a stop protocol. Every one of those is a rung; none is a lowering.
//
function calleeHostFacility(callee ByteArray) returns CalleeFacility
	// The four scheduler entries named individually: their bands hold calls the compiler inserts, so a
	// prefix test over `__gt_` would blame a drop the user never wrote (measured — see the header above).
	if callee.equals(GtNowNsName) 'monotonic'
		return CalleeFacility.needs(HostFacility.monotonicClock)
	end 'monotonic'

	if callee.equals(GtSleepName) 'sleep'
		return CalleeFacility.needs(HostFacility.sleep)
	end 'sleep'

	if callee.equals(GtReschedName) 'resched'
		return CalleeFacility.needs(HostFacility.reschedule)
	end 'resched'

	if callee.equals(GtAwaitAnyName) 'select'
		return CalleeFacility.needs(HostFacility.greenThreads)
	end 'select'

	// ⭐⭐ **THE SCHEDULER-STATE QUERIES — the select's case exactly, one band over.** Each reads state only
	// `__sched_init_procs` builds, so asking one INSTALLS the whole scheduler (`RuntimeUsage.recordCallUsage`
	// routes every one to `recordGtUsage`), and a lane with no green-thread floor has no TLS slot for the
	// install to reach: without this arm the compiler would die in a runtime emitter that knows it is
	// x64-windows-only rather than refuse at the call. A builtin that turns on `usesGt` and is not named here is
	// a door left open.
	//
	// ⚠ **THE ROSTER IS THE ONE `RuntimeUsage` ASKS, NOT A SECOND COPY OF IT.** Both halves of what these
	// names mean — install the scheduler, require its floor — read `isSchedSubstrateQueryCallee`, which is why
	// a new one cannot arrive gated at one end and open at the other.
	//
	// ⚠ **THEIR BAND-MATE `__sched_max_active_workers` IS DELIBERATELY ABSENT**, for the reason the header's
	// paragraph on it gives: it is one `.data` load and a `ret`, which lowers on every target the compiler
	// emits, and it sets no `usesGt`. `specs/builtins-cpu-parallel.md` pins that acceptance, which is what keeps
	// this a NARROW gate rather than a family-wide one.
	if isSchedSubstrateQueryCallee(callee) 'schedStateQueries'
		return CalleeFacility.needs(HostFacility.greenThreads)
	end 'schedStateQueries'

	// The two subprocess surfaces whose entries live in the SCHEDULER band rather than behind the
	// `__gt_subp_` prefix, named individually for that reason.
	if callee.equals(GtProcessRunName) or callee.equals(IoReadName) 'spawnDoors'
		return CalleeFacility.needs(HostFacility.subprocess)
	end 'spawnDoors'

	if isSubprocessRuntimeCallee(callee) 'subprocessBand'
		return CalleeFacility.needs(HostFacility.subprocess)
	end 'subprocessBand'

	if isSharedMemoryRuntimeCallee(callee) 'sharedMemoryBand'
		return CalleeFacility.needs(HostFacility.sharedMemory)
	end 'sharedMemoryBand'

	if isProfileRuntimeCallee(callee) 'processSamplingBand'
		return CalleeFacility.needs(HostFacility.processSampling)
	end 'processSamplingBand'

	if isClockRuntimeCallee(callee) 'wallClockBand'
		return CalleeFacility.needs(HostFacility.wallClock)
	end 'wallClockBand'

	if isThreadCpuRuntimeCallee(callee) 'threadCpuBand'
		return CalleeFacility.needs(HostFacility.threadCpuClock)
	end 'threadCpuBand'

	if isUptimeRuntimeCallee(callee) 'uptimeBand'
		return CalleeFacility.needs(HostFacility.uptimeClock)
	end 'uptimeBand'

	if isManagedFileRuntimeCallee(callee) 'fileBand'
		return CalleeFacility.needs(HostFacility.managedFile)
	end 'fileBand'

	if isManagedDirectoryRuntimeCallee(callee) 'directoryBand'
		return CalleeFacility.needs(HostFacility.managedDirectory)
	end 'directoryBand'

	// ⚠ **THE LISTENER BAND NEEDS EXACTLY THE SOCKET SUBSTRATE AND NOTHING ELSE, SO IT SHARES THIS FACILITY
	// RATHER THAN NAMING A SECOND ONE.** A facility is what a LANE provides; binding and accepting are served
	// by every lane that serves connecting, and refused by the one that does not.
	if isManagedSocketRuntimeCallee(callee) or isManagedListenerRuntimeCallee(callee) 'socketBand'
		return CalleeFacility.needs(HostFacility.managedSocket)
	end 'socketBand'

	if isCommandLineRuntimeCallee(callee) 'argvBand'
		return CalleeFacility.needs(HostFacility.commandLine)
	end 'argvBand'

	if isConsoleRuntimeCallee(callee) 'stdinBand'
		return CalleeFacility.needs(HostFacility.consoleStdin)
	end 'stdinBand'

	// ⛔⛔ **THE `__tty_` BAND IS DELIBERATELY ABSENT FROM THIS FUNCTION, AND ITS FACILITY IS NOT.** It stood
	// here for a day, by the same PREFIX test as its neighbours, and it made this compiler unbuildable for
	// arm64-macOS — see `HostFacility.terminalDetection`, which carries the whole argument. The short of it:
	// this function refuses a call whose facility leaves the program with NO ANSWER, and a missing terminal
	// notion has one. `TerminalRuntime.installTerminalRuntime` reads the facility row instead and picks the
	// BODY, so the callee is present on every target and no lane can go red.

	// The priority write and the liveness probe, each named ahead of their own `__proc_` band for the
	// four scheduler entries' reason one screen up: a prefix band must not silently swallow a member
	// that answers a different facility. They are the two `__proc_` entries that do not read an
	// identity.
	if callee.equals(ProcessBackgroundPriorityName) 'priority'
		return CalleeFacility.needs(HostFacility.processPriority)
	end 'priority'

	if callee.equals(ProcessAliveName) 'liveness'
		return CalleeFacility.needs(HostFacility.processLiveness)
	end 'liveness'

	if isProcessRuntimeCallee(callee) 'processBand'
		return CalleeFacility.needs(HostFacility.processInfo)
	end 'processBand'

	if isCpuCountRuntimeCallee(callee) 'cpuCountBand'
		return CalleeFacility.needs(HostFacility.cpuCount)
	end 'cpuCountBand'

	// ⭐⭐ **A `__Raw` ROW ARRIVES HERE AS A SUBSTRATE ENTRY, NOT AS A CALLEE.** A `rawIntrinsic` op names no
	// callee at all (`MaxonDialect.maxonOpCalleeKind` answers `noCallee`), so nothing can ever CALL one of
	// these names — what reaches this door is the entry `StdlibSource.noteSubstrateRawIntrinsic` seeded a
	// crossing with, which is the row's own mangled spelling. The facility is the TABLE's answer rather than a
	// second copy of it, so the crossing and the op cannot disagree about what a lane owes.
	if isRawIntrinsicCallee(callee) and rawIntrinsicIsListed(callee) 'theRawFloor'
		return match rawHostFacilityOf(rawIntrinsicNamed(callee)) 'row'
			none gives CalleeFacility.none
			required(facility) gives CalleeFacility.needs(facility)
		end 'row'
	end 'theRawFloor'

	return CalleeFacility.none
end 'calleeHostFacility'

// ⭐ **THE TWO QUESTIONS FUSED BACK TOGETHER FOR THE ONE CALLER THAT WANTS THEM THAT WAY** — *"does this
// callee need a facility this target does not provide?"*, which is the E3104 verdict itself.
//
// ⚠ It is a COMPOSITION and not a third fact: both halves come from the two functions above, so a family
// that lands is recorded once, in the table, and this answer follows. A predicate shaped like this on the
// outside but undecomposable on the inside is what makes a partial landing inexpressible.
export function calleeNeedsFacilityTargetLacks(target Target, callee ByteArray) returns bool
	return match calleeHostFacility(callee) 'f'
		needs(facility) gives not targetProvidesFacility(target, facility: facility)
		none gives false
	end 'f'
end 'calleeNeedsFacilityTargetLacks'

// **IS THIS CALLEE ON THE ROSTER AT ALL?** — the TARGET-BLIND half, and the only question
// `StdlibSource.noteSubstrateCallee` may ask: its fixpoint records which entry each stdlib function
// reaches, a property of stdlib source that must not vary with the target being compiled for.
export function calleeHasHostFacility(callee ByteArray) returns bool
	return match calleeHostFacility(callee) 'f'
		needs gives true
		none gives false
	end 'f'
end 'calleeHasHostFacility'

// ⭐⭐ **THE CAPABILITY TABLE — what each backend has actually landed.**
//
// Read as *"target T provides facility F"*, and written by the backend that made it true. x64-windows is
// the one FULL row — it provides every facility, so its block answers `true` without asking which.
//
// ⚠ The three POSIX lanes, arm64-macOS, arm64-linux and x64-linux, provide every facility but
// `processSampling` and `debugAgent`, each `true` a landed family with real lowerings behind it:
// libSystem imports on macOS, raw syscalls on the two static Linux images. `processSampling` is
// `false` on all three because sampling is `osHostSample` reading an x64 `CONTEXT`, a mechanism
// none of them has (see each row). A premature `true` is worse than a `false`; this file's header
// says why.
//
// ⚠ **wasm32-wasi PROVIDES ONLY `pageMemory` AND `hostMutex`, AND SOME OF ITS `false`s ARE PERMANENT.** WASI
// has no process-spawn primitive and no per-thread CPU clock at all, so `subprocess` and `threadCpuClock`
// there are refusals of a different KIND from "not yet" — that distinction is carried by
// `SemanticCheck.targetCanHostSubprocess` and its E3074, which reads this table's subject and not its
// answer. One table, two consumers, no second copy.
export function targetProvidesFacility(target Target, facility HostFacility) returns bool
	if target.cpu == CpuArch.x64 and target.os == Os.windows 'theFullRow'
		return true
	end 'theFullRow'

	if target.cpu == CpuArch.arm64 and target.os == Os.macos 'darwinArm64'
		return match facility 'f'
			// ⚠ `hostMutex` is `true` because the lock chunk's gate, `PosixRuntime.posixUsesHostLock`,
			// covers every producer of the three ops, the allocator's included. A narrower gate is a `bl` to
			// a symbol the image never laid out: a link failure rather than a diagnostic. `uptimeClock`
			// rests on the same kind of union: `mrt_host_tick_ms` is gated on all three of its producers
			// (`appendArm64DarwinRuntimeChunks`), so a program that reads the uptime and spawns nothing
			// still carries the chunk it branches to.
			//
			// `reschedule` and `greenThreads` are `true` for arm64-macOS alone and not for arm64 generally,
			// which is why this table is keyed on a target rather than a CPU: every host object of the P/M
			// tier here is a pthread primitive, and the Linux lane links no libc to provide one.
			//
			// `subprocess` rests on shape forks rather than one lowering: an argument vector
			// (`SubprocessRuntime.SubprocessCommandShape`, because re-splitting a Win32-quoted line through
			// a shell would expand `$HOME` and glob `a*b`), a handle kind on every value the two handle ops
			// receive (`Arm64PosixRuntime.PosixHandleKindShift`, because a descriptor and a pointer are both
			// integers and `close` and `free` are not one call), and a read that completes in its caller
			// (`GtRuntime.IoCompletionShape`), parked on the kqueue through a non-blocking read end.
			//
			// ⚠ `managedSocket`: Darwin puts `sin_len` in byte 0 and `sin_family` in byte 1, so the
			// `sockaddr_in` the Windows spelling builds is accepted here by an `AF_UNSPEC` tolerance rather
			// than by being right (`ManagedSocketRuntime.sockaddrFamilyHalfword`).
			//
			// `terminalDetection` calls `isatty` and not the `ioctl` it is built from: Darwin's `ioctl` is
			// variadic, and AAPCS64 passes a variadic argument on the stack rather than in a register.
			monotonicClock or
				wallClock or
				threadCpuClock or
				sleep or
				managedFile or
				managedDirectory or
				commandLine or
				consoleStdin or
				processInfo or
				processPriority or
				processLiveness or
				cpuCount or
				pageMemory or
				hostMutex or
				threadLocalSlot or
				reschedule or
				greenThreads or
				subprocess or
				managedSocket or
				terminalDetection or
				sharedMemory or
				uptimeClock gives true

			// ⛔ `processSampling`: the register file is the wrong shape. `thread_get_state` answers an
			// `arm_thread_state64_t`, not a `CONTEXT`, so this is a port of the whole sample decoder rather
			// than a lowering of `osHostSample`; a `true` here would read three unrelated words as
			// RIP/RSP/RBP.
			processSampling or
				debugAgent gives false
		end 'f'
	end 'darwinArm64'

	if target.cpu == CpuArch.arm64 and target.os == Os.linux 'linuxArm64'
		return match facility 'f'
			// `monotonicClock` and `sleep` stand or fall with `greenThreads` (the x64-linux row states why).
			// The green-thread floor's host objects are `futex` twins of the macOS pthread sequences, under
			// the same `mrt_host_*` symbols. ⚠ The run-queue lock must stay recursive: `__slab_refill` takes
			// the slab's own lock twice, and a non-recursive lock hangs there. This lane is multi-M exactly
			// as arm64-macOS is, so `StdDialect`'s barrier-free `completed` publication is a live question
			// on both weakly-ordered lanes (that note carries the fix it is owed).
			//
			// `subprocess`: a failed exec is reported through an `O_CLOEXEC` status pipe, because the
			// failure happens in another process; without it `SubprocessError.spawnFailed` is unreachable
			// here.
			//
			// ⛔ `processPriority`: Linux scopes a nice value to the calling thread, and `clone` inherits its
			// creator's at birth, so an M that already existed when `__proc_bg_priority` ran keeps the
			// default nice. Closing it needs each M's tid in its P and a walk in a chunk; no spec reaches
			// it, because the specs read the value back on the calling thread. ⚠ The lowering folds
			// `getpriority`'s syscall bias (`LinuxRuntime.LinuxGetPriorityBias`): the raw call answers
			// `20 - nice`, and without the fold `answers-the-posix-nice-value` still passes, because
			// `20 - 10` is 10.
			//
			// `hostMutex` and `uptimeClock` are `true` for the arm64-macOS row's reason: their chunks' gates
			// cover every producer (`PosixRuntime.posixUsesHostLock`, and the union of `mrt_host_tick_ms`'s
			// three producers).
			//
			// ⚠ `managedSocket` resolves names in Std IR (`SocketResolveShape.builtinResolver`), and a
			// `true` here promises that every `StdOp` the facility emits is lowered, not `getaddrinfo`'s
			// reach: `A` records only, the first nameserver only, no `search`/`domain` suffixing, no CNAME
			// chasing and no timeout (its header states each). The resolver reads `/etc/hosts` and
			// `/etc/resolv.conf`, so the file surface is a dependency of the socket one, which is why
			// `LinuxRuntime.linuxOpensFiles` names the socket bit.
			//
			// `terminalDetection` reads `NO_COLOR` and `TERM` through `StdOp.osEnvRead`, which walks
			// `__mrt_envp`, a word only the entry stub fills. Every gate on that capture rides
			// `LinuxRuntime.linuxReadsEnvironment` rather than the scheduler's bit, because a
			// terminal-detecting program need not have a scheduler.
			commandLine or
				managedFile or
				managedDirectory or
				consoleStdin or
				monotonicClock or
				wallClock or
				threadCpuClock or
				sleep or
				reschedule or
				greenThreads or
				subprocess or
				processInfo or
				processPriority or
				processLiveness or
				cpuCount or
				pageMemory or
				hostMutex or
				threadLocalSlot or
				managedSocket or
				terminalDetection or
				sharedMemory or
				uptimeClock gives true

			// ⛔ `processSampling`: the arm64-macOS row's reason, plus this lane's own: `ptrace` and
			// `process_vm_readv` are a different sampling mechanism, and the register file they answer is
			// AArch64's rather than the x64 `CONTEXT` the sample decoder reads.
			processSampling or
				debugAgent gives false
		end 'f'
	end 'linuxArm64'

	if target.cpu == CpuArch.x64 and target.os == Os.linux 'linuxX64'
		return match facility 'f'
			// ⛔ `monotonicClock`, `sleep`, `reschedule`, `greenThreads` and `subprocess` are indivisible: a
			// lane provides all five or none, and flipping one alone makes a program that panics in the
			// isel.
			//
			//   * `monotonicClock` and `sleep` are reached only through `__gt_now_ns`/`__gt_sleep`, which
			//     are scheduler entries, so neither means anything without `greenThreads`.
			//   * `reschedule` is `__gt_context_switch`, a hand-assembled per-CPU chunk of the same floor.
			//   * `installGtRuntime` calls `buildGtProcessRun` unconditionally, so every green-thread
			//     program contains `__gt_process_run`, whose `osProcessSpawn` and `osProcessExitCode` need
			//     this lane's lowering, and dead-function elimination does not remove it from a program that
			//     spawns nothing. A `greenThreads` row with `subprocess` false compiles no `async` program
			//     at all.
			//
			// ⚠ `processPriority`: x86-64 has `getpriority` at 140 and `setpriority` at 141, the reverse of
			// AArch64, so a lane reusing the twin's constant would set when it meant to read
			// (`X64LinuxRuntime.X64LinuxSyscallGetPriority`). The arm64-linux row's gap for an M that
			// already existed, and its bias fold, hold here too.
			//
			// `threadCpuClock` reports nanoseconds where Windows reports TSC ticks, which
			// `__thread_cpu_ticks`' contract permits: it promises only that two readings may be subtracted.
			//
			// `hostMutex`, `uptimeClock`, `managedSocket` and `terminalDetection` are `true` for the
			// arm64-linux row's reasons. `LinuxRuntime.linuxReadsEnvironment` is the union over every
			// producer of `StdOp.osEnvRead` on this lane, so a new producer joins it there once rather than
			// at each lane's chunk list.
			commandLine or
				managedFile or
				managedDirectory or
				consoleStdin or
				wallClock or
				threadCpuClock or
				processInfo or
				cpuCount or
				pageMemory or
				hostMutex or
				threadLocalSlot or
				monotonicClock or
				sleep or
				reschedule or
				greenThreads or
				subprocess or
				processPriority or
				processLiveness or
				managedSocket or
				terminalDetection or
				sharedMemory or
				uptimeClock gives true

			// ⛔ `processSampling`: the CPU matches and the mechanism does not. The sample decoder would
			// port, but there is no suspend-and-read-context primitive to lower `osHostSample` onto: Linux's
			// equivalent is `ptrace` with a stop protocol, or `process_vm_readv` plus a signal.
			processSampling or
				debugAgent gives false
		end 'f'
	end 'linuxX64'

	if target.cpu == CpuArch.wasm32 and target.os == Os.wasi 'wasmWasi'
		return match facility 'f'
			// Every op of both facilities has an arm in `StdToWasm.emitBodyOp`, which is what a `true`
			// promises. `hostMutex`'s arms emit nothing, because one thread makes exclusion total; see its
			// `HostFacility` row for what a threaded wasm lane would owe.
			pageMemory or
				hostMutex gives true

			// ⛔ **THE REST ARE ABSENT, AND FOR TWO DIFFERENT KINDS OF REASON THIS COLUMN DOES NOT RECORD.**
			// A WASI component has one thread and no process-spawn primitive, so the green-thread floor,
			// the child-process band, the per-thread CPU clock and per-OS-thread STORAGE are permanent
			// refusals; the file, directory,
			// socket, argv, stdin, identity, priority, machine-query and named-section families are surfaces
			// nobody has ported. `SemanticCheck.targetCanHostSubprocess` is where the permanent half of that
			// distinction is written down, reading this table's SUBJECT rather than its answer.
			//
			// ⚠ `terminalDetection` is the row whose `false` is an ANSWER rather than a refusal:
			// `TerminalRuntime.installTerminalRuntime` reads it and builds a body answering "not a terminal".
			monotonicClock or
				wallClock or
				threadCpuClock or
				uptimeClock or
				sleep or
				reschedule or
				greenThreads or
				subprocess or
				managedFile or
				managedDirectory or
				managedSocket or
				commandLine or
				consoleStdin or
				processInfo or
				processPriority or
				processLiveness or
				cpuCount or
				threadLocalSlot or
				terminalDetection or
				sharedMemory or
				processSampling or
				debugAgent gives false
		end 'f'
	end 'wasmWasi'

	// Every CPU/OS pair the driver does not support. `Target` is a product of two enums, so most of its
	// combinations name no lane at all and none of them provides anything.
	return false
end 'targetProvidesFacility'

// ⭐⭐ **CAN THIS TARGET CARRY THE DebugStream PRODUCER? — the ONE producer of that fact.** Two parties ask
// it and they are in different trees: `Main.runBuild` refuses `--debugstream` at the command line, and the
// spec harness skips a capture case rather than compiling one. Spelled at each, it was a target pair written
// twice beside the table that already held the answer.
//
// It is a CONJUNCTION of facilities rather than a list of targets because that is what `__ds_init` actually
// needs: it attaches to a named shared section, and every entry it writes stamps the millisecond stopwatch.
// A lane that gains both gains the producer here by MEASUREMENT.
export function targetCanProduceDebugStream(target Target) returns bool
	return targetProvidesFacility(target, facility: HostFacility.sharedMemory) and targetProvidesFacility(target, facility: HostFacility.uptimeClock)
end 'targetCanProduceDebugStream'

// ⭐⭐ **CAN THIS TARGET CARRY THE COVERAGE COUNTER DUMP? — the ONE producer of that fact**, and the door
// `Main.runBuild` refuses `--coverage` through.
//
// ⛔ **IT IS NOT `calleeHostFacility`/E3104, AND MUST NOT BECOME ONE.** That door is keyed on a callee
// name the USER'S SOURCE wrote and reports at that call's own span; a build flag has no span, and
// blaming a compiler-inserted call for it is a defect this file records having made once already. A
// driver refusal is the honest shape, exactly as `--debugstream`'s is.
//
// It is a FACILITY read rather than a target list because that is what an instrumented binary actually
// needs: it writes its counter block to a file on its way out. The day a lane grows a file surface, this
// becomes true by MEASUREMENT rather than by someone remembering to widen a hard-coded pair.
export function targetCanMeasureCoverage(target Target) returns bool
	return targetProvidesFacility(target, facility: HostFacility.managedFile)
end 'targetCanMeasureCoverage'

// Whether the target's backend emits the inline frame records a panic backtrace names a spliced callee
// by (`BacktraceFormat`'s `__inlframes`, read by the two native frame printers). On wasm the frames are
// the engine's — there is no frame chain to walk and no printer of ours — so a trace raised inside a
// spliced body would lose the callee's frame with no record to restore it; the inliner refuses the
// splices whose trace could change there.
module function targetEmitsInlineFrameRecords(target Target) returns bool
	return match target.cpu 'cpu'
		x64 or
			arm64 gives true
		wasm32 gives false
	end 'cpu'
end 'targetEmitsInlineFrameRecords'

// How many OS threads a target can run inside one process, which is what the allocator's sharding
// reads: on `singleMachine` there is no thread-local slot to read and no second thread to serialise
// against, so the "which processor am I" walk is a constant and every lock and atomic guards nothing.
module enum MachineModel
	singleMachine
	multiMachine
end 'MachineModel'

// ⚠ Keyed on the whole target and enumerated, so a lane that gains threads must say so here before
// its allocator reads a TLS slot the backend refuses (`StdToWasm` panics on `tlsSlotLoad`).
module function machineModel(target Target) returns MachineModel
	if target.cpu == CpuArch.wasm32 and target.os == Os.wasi 'wasi'
		return MachineModel.singleMachine
	end 'wasi'

	if target.os == Os.windows or target.os == Os.linux or target.os == Os.macos 'threaded'
		return MachineModel.multiMachine
	end 'threaded'

	panic("machineModel: no machine model is stated for target {targetToString(target)}")
end 'machineModel'

// The per-function short-circuit `SemanticCheck.checkCalls` settles once and hands to every call
// op. A walk over `allCases` rather than `x64 and windows`, so a lane that completes the table
// becomes true here without anyone widening a hard-coded pair.
export function targetProvidesEveryFacility(target Target) returns bool
	for facility in HostFacility.allCases 'each'
		if not targetProvidesFacility(target, facility: facility) 'missing'
			return false
		end 'missing'
	end 'each'

	return true
end 'targetProvidesEveryFacility'
