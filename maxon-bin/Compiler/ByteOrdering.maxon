// Compiler/ByteOrdering.maxon — the ordinal byte ordering every table this compiler sorts by shares.

// ⭐ **ONE ORDERING, AND THAT IS THE REASON IT LIVES ALONE.** The formatter's file walk, the test report's
// path column, the debug-info name tables, the library cache's generated writers and the settle's table
// walks must all order by the same rule; separate copies of "compare the shared prefix, shorter name
// first" would be free to diverge, and a divergence would be a wrong ORDER at one of them rather than an
// error at any of them.
//
// ⚠ **THE MEASURE IS BYTES.** The orders these tables need are filesystem- and locale-neutral, and the
// reference implementations they are compared against compare units rather than collating text.
export function compareBytesOrdinally(left ByteArray, right ByteArray) returns Ordering
	let shared = left.count() if left.count() < right.count() else right.count()

	for i in 0 upto shared 'eachByte'
		let a = try left.get(i) otherwise panic("compareBytesOrdinally: get OOB at {i} below the shared length {shared}")
		let b = try right.get(i) otherwise panic("compareBytesOrdinally: get OOB at {i} below the shared length {shared}")

		if a != b 'differ'
			return Ordering.lessThan if a < b else Ordering.greaterThan
		end 'differ'
	end 'eachByte'

	return left.count().compare(right.count())
end 'compareBytesOrdinally'

// Order two discovered paths by their spelling. A `FilePath` is not `Comparable`, and the ordering wanted
// here is the filesystem-neutral one — the bytes, not a locale's idea of them (`compareBytesOrdinally`).
function comparePathSpelling(left FilePath, right FilePath) returns Ordering
	return compareBytesOrdinally(left.toString().toByteArray(), right: right.toString().toByteArray())
end 'comparePathSpelling'

// A `Map` or `Set` walk follows the process hash seed. One whose body registers a first-wins
// entry, interns a name, numbers an id, mints a layout or fills an array that is written or
// indexed sorts its keys first, here or by `sortUnstable()` for a value-ordered key, else the
// library cache's packs follow the seed; only a walk touching its own key's entry or folding a
// count, min or max may stay unordered.
function sortNamesInByteOrder(names NameRoster)
	names.sortUnstableBy(function(left immutable ByteArray, right immutable ByteArray) gives compareBytesOrdinally(left, right: right))
end 'sortNamesInByteOrder'

function structTypeNamesInByteOrder(project Project) returns NameRoster
	let names = NameRoster.create(project.structTypes.count(), zeroed: false)

	for (name, _) in project.structTypes 'eachStruct'
		names.push(name)
	end 'eachStruct'

	sortNamesInByteOrder(names)

	return names
end 'structTypeNamesInByteOrder'

function enumTypeNamesInByteOrder(project Project) returns NameRoster
	let names = NameRoster.create(project.enumTypes.count(), zeroed: false)

	for (name, _) in project.enumTypes 'eachEnumOrUnion'
		names.push(name)
	end 'eachEnumOrUnion'

	sortNamesInByteOrder(names)

	return names
end 'enumTypeNamesInByteOrder'

let DriveColonByte = 0x3A
