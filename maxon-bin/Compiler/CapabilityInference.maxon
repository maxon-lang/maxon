module enum ParamClass
	anyCapability
	mutableOnly
	immutableOnly
	both
	isolatedParam
end 'ParamClass'

typealias SettledCapabilityMap = Map with (ValueId, ValueCapability)

typealias ConstructionOpSet = Set with ElementIndex

typealias PhiArmMap = Map with (ValueId, ValueIdArray)

function phiArmsOfFunction(module MaxonModule, func IrFunction) returns PhiArmMap
	var arms = PhiArmMap.create()

	for blockRef in func.blockRefs 'eachBlock'
		let block = module.getBlock(blockRef)

		for edge in block.branchEdges 'eachEdge'
			let target = try module.getBlockByIdIn(func, id: edge.targetBlockId) otherwise continue

			for position in 0 upto edge.argIds.count() 'eachArgument'
				let phi = (try target.blockArgs.get(position) otherwise continue).valueId
				var known = try arms.get(phi) otherwise ValueIdArray.create(0)
				known.push(try edge.argIds.get(position) otherwise continue)
				arms.upsert(phi, value: known)
			end 'eachArgument'
		end 'eachEdge'
	end 'eachBlock'

	return arms
end 'phiArmsOfFunction'

function literalResultsOfFunction(module MaxonModule, func IrFunction) returns ValueMarkSet
	var literals = ValueMarkSet.create()

	for blockRef in func.blockRefs 'eachBlock'
		for opIdx in module.getBlock(blockRef).bodyOps() 'eachOp'
			let op = try module.ops.get(opIdx) otherwise panic("literalResultsOfFunction: ops.get OOB at {opIdx}")
			try requireLiteralOp(op) otherwise continue
			literals.insert(try maxonOpDefinedValue(op) otherwise panic("literalResultsOfFunction: a literal defines its result"))
		end 'eachOp'
	end 'eachBlock'

	return literals
end 'literalResultsOfFunction'

function exitChainPhisOfFunction(module MaxonModule, func IrFunction) returns ValueMarkSet
	var phis = ValueMarkSet.create()

	for blockRef in func.blockRefs 'eachBlock'
		let block = module.getBlock(blockRef)

		if block.role != BlockRole.exitChain 'ordinaryBlock'
			continue
		end 'ordinaryBlock'

		for arg in block.blockArgs 'eachArg'
			phis.insert(arg.valueId)
		end 'eachArg'
	end 'eachBlock'

	return phis
end 'exitChainPhisOfFunction'

typealias PausedOperandsByOp = Map with (ElementIndex, ParamPositionMask)

typealias SettlingDepthMap = Map with (ValueId, ElementIndex)

let NoOpenRead = u64.max as ElementIndex

function pausedOperandsOfFunction(func IrFunction) returns PausedOperandsByOp
	var paused = PausedOperandsByOp.create()
	let notes = func.capabilityNotes

	for slot in 0 upto notes.windowCallOps.count() 'eachWindowCall'
		let opIdx = try notes.windowCallOps.get(slot) otherwise panic("pausedOperandsOfFunction: windowCallOps.get OOB at {slot}")
		let operands = try notes.windowCallPausedOperands.get(slot) otherwise panic("pausedOperandsOfFunction: windowCallPausedOperands.get OOB at {slot} — the window columns are parallel")
		paused.upsert(opIdx, value: (try paused.get(opIdx) otherwise NoParamPositions) or operands)
	end 'eachWindowCall'

	return paused
end 'pausedOperandsOfFunction'

module type SettledMemo
	var capabilities as SettledCapabilityMap
	module let sources as ParamSources
	let phiArms as PhiArmMap
	let literals as ValueMarkSet
	let exitChainPhis as ValueMarkSet
	let settling as SettlingDepthMap
	var oldestOpenRead as ElementIndex
	let constructionOps as ConstructionOpSet
	let pausedOperands as PausedOperandsByOp

	module static function over(sources ParamSources) returns SettledMemo
		var constructionOps = ConstructionOpSet.create()

		for opIdx in sources.func.capabilityNotes.constructionOps 'eachConstructionOp'
			constructionOps.insert(opIdx)
		end 'eachConstructionOp'

		return Self{capabilities: SettledCapabilityMap.create(), sources: sources, phiArms: phiArmsOfFunction(sources.ir, func: sources.func), literals: literalResultsOfFunction(sources.ir, func: sources.func), exitChainPhis: exitChainPhisOfFunction(sources.ir, func: sources.func), settling: SettlingDepthMap.create(), oldestOpenRead: NoOpenRead, constructionOps: constructionOps, pausedOperands: pausedOperandsOfFunction(sources.func)}
	end 'over'

	module function buildsALiteral(opIdx ElementIndex) returns bool
		return self.constructionOps.contains(opIdx)
	end 'buildsALiteral'

	module function windowPausesOperand(opIdx ElementIndex, argIndex ParamCount) returns bool
		let paused = try self.pausedOperands.get(opIdx) otherwise return false
		return maskHasParam(paused, param: argIndex)
	end 'windowPausesOperand'

	module function beginSettling(value ValueId)
		self.settling.upsert(value, value: self.settling.count())
	end 'beginSettling'

	module function endSettling(value ValueId) returns bool
		let depth = try self.settling.get(value) otherwise panic("SettledMemo.endSettling: v{value} is not being settled")
		_ = self.settling.remove(value)

		if self.oldestOpenRead < depth 'dependsOnAnOpenValue'
			return false
		end 'dependsOnAnOpenValue'

		self.oldestOpenRead = NoOpenRead
		return true
	end 'endSettling'

	module function isSettling(value ValueId) returns bool
		return self.settling.contains(value)
	end 'isSettling'

	module function noteRead(value ValueId)
		let depth = try self.settling.get(value) otherwise return

		if depth < self.oldestOpenRead 'anOlderOpenValue'
			self.oldestOpenRead = depth
		end 'anOlderOpenValue'
	end 'noteRead'

	module function forget(value ValueId)
		_ = self.capabilities.remove(value)
	end 'forget'

	module function isAnExitChainPhi(value ValueId) returns bool
		return self.exitChainPhis.contains(value)
	end 'isAnExitChainPhi'

	module function definesALiteral(value ValueId) returns bool
		return self.literals.contains(value)
	end 'definesALiteral'

	module function mergesArms(value ValueId) returns bool
		return self.phiArms.contains(value)
	end 'mergesArms'

	module function armsOfPhi(value ValueId) returns ValueIdArray throws AbsentError
		return try self.phiArms.get(value) otherwise throw AbsentError.absent
	end 'armsOfPhi'

	module function settled(value ValueId) returns ValueCapability throws AbsentError
		return try self.capabilities.get(value) otherwise throw AbsentError.absent
	end 'settled'

	module function record(value ValueId, capability ValueCapability)
		self.capabilities.upsert(value, value: capability)
	end 'record'

	module function parameterBehind(value ValueId) returns ParamCount throws AbsentError
		let position = try self.sources.parameterBehind(value)

		if position >= self.sources.func.paramCount 'aCapturedSlot'
			throw AbsentError.absent
		end 'aCapturedSlot'

		return position
	end 'parameterBehind'

	module function unmarkedParameterBehind(project Project, value ValueId) returns ParamCount throws AbsentError
		let position = try self.parameterBehind(value)

		if not isAnUnmarkedParameter(project, func: self.sources.func, argId: valueIdAtParamPosition(position)) 'aDeclaredMarker'
			throw AbsentError.absent
		end 'aDeclaredMarker'

		return position
	end 'unmarkedParameterBehind'

	module function isAnUnmarkedParameterValue(project Project, value ValueId) returns bool
		let _ = try self.unmarkedParameterBehind(project, value: value) otherwise return false
		return true
	end 'isAnUnmarkedParameterValue'
end 'SettledMemo'

typealias SeedOriginKey = int(0 to 9223372036854775807)

enum SeedOriginKind
	frozen = 0
	mutable = 1
end 'SeedOriginKind'

function seedOriginKey(index ElementIndex, position ParamCount, mutable bool) returns SeedOriginKey
	let kind = SeedOriginKind.mutable if mutable else SeedOriginKind.frozen
	return (positionSlotKey(index, position: position as ElementIndex) as SeedOriginKey) * (SeedOriginKind.allCases.count() as SeedOriginKey) + (kind.rawValue as SeedOriginKey)
end 'seedOriginKey'

module type SeedOrigin
	module let line as LineNumber
	module let reason as String

	static function create(line LineNumber, reason String) returns SeedOrigin
		return Self{line: line, reason: reason}
	end 'create'
end 'SeedOrigin'

typealias SeedOriginMap = Map with (SeedOriginKey, SeedOrigin)

module type NeedHop
	module let callee as ElementIndex
	module let calleeParam as ParamCount

	static function create(callee ElementIndex, calleeParam ParamCount) returns NeedHop
		return Self{callee: callee, calleeParam: calleeParam}
	end 'create'
end 'NeedHop'

typealias NeedHopMap = Map with (PositionSlotKey, NeedHop)

module type NeedHops
	let tracked as bool
	var hops as NeedHopMap

	module static function tracking() returns NeedHops
		return Self{tracked: true, hops: NeedHopMap.create()}
	end 'tracking'

	module static function untracked() returns NeedHops
		return Self{tracked: false, hops: NeedHopMap.create()}
	end 'untracked'

	module function record(index ElementIndex, position ParamCount, callee ElementIndex, calleeParam ParamCount)
		if not self.tracked 'nothingToKeep'
			return
		end 'nothingToKeep'

		self.hops.upsert(positionSlotKey(index, position: position as ElementIndex), value: NeedHop.create(callee, calleeParam: calleeParam))
	end 'record'

	module function viaOf(index ElementIndex, position ParamCount) returns NeedHop throws AbsentError
		return try self.hops.get(positionSlotKey(index, position: position as ElementIndex)) otherwise throw AbsentError.absent
	end 'viaOf'
end 'NeedHops'

module type CapabilityFacts
	module var writtenHops as NeedHops
	module var frozenHops as NeedHops
	module var frozenSomeHops as NeedHops
	module var mutableOnly as ParamPositionMaskArray
	module var immutableOnly as ParamPositionMaskArray
	module var frozenInSomeInstance as ParamPositionMaskArray
	module var buildsRecordFrom as ParamPositionMaskArray
	module var directMutable as ParamPositionMaskArray
	module var directImmutable as ParamPositionMaskArray
	module var mayWait as BoolArray
	module var mayYield as BoolArray
	var seedOrigins as SeedOriginMap
	module var funcNames as FunctionNameIndex
	module var ir as MaxonModule

	module static function create(funcNames FunctionNameIndex, ir MaxonModule) returns CapabilityFacts
		let funcCount = funcNames.functions.count()
		return Self{writtenHops: NeedHops.tracking(), frozenHops: NeedHops.tracking(), frozenSomeHops: NeedHops.tracking(), mutableOnly: ParamPositionMaskArray.create(funcCount, zeroed: false), immutableOnly: ParamPositionMaskArray.create(funcCount, zeroed: false), frozenInSomeInstance: ParamPositionMaskArray.create(funcCount, zeroed: false), buildsRecordFrom: ParamPositionMaskArray.create(funcCount, zeroed: false), directMutable: ParamPositionMaskArray.create(0), directImmutable: ParamPositionMaskArray.create(0), mayWait: BoolArray.create(0), mayYield: BoolArray.create(0), seedOrigins: SeedOriginMap.create(), funcNames: funcNames, ir: ir}
	end 'create'

	function pinMutable(index ElementIndex, bits ParamPositionMask, line LineNumber, reason String)
		let before = try self.mutableOnly.get(index) otherwise panic("CapabilityFacts.pinMutable: mutableOnly.get OOB at {index}")
		self.noteSeedOrigins(index, fresh: bits and (bits xor before), mutable: true, line: line, reason: reason)
		orIntoMask(self.mutableOnly, index: index, bits: bits)
	end 'pinMutable'

	function pinFrozen(index ElementIndex, bits ParamPositionMask, elementsOfUnknownType bool, line LineNumber, reason String)
		let before = try self.frozenInSomeInstance.get(index) otherwise panic("CapabilityFacts.pinFrozen: frozenInSomeInstance.get OOB at {index}")
		self.noteSeedOrigins(index, fresh: bits and (bits xor before), mutable: false, line: line, reason: reason)
		orIntoMask(self.frozenInSomeInstance, index: index, bits: bits)

		if not elementsOfUnknownType 'aNeedOfTheDataItself'
			orIntoMask(self.immutableOnly, index: index, bits: bits)
		end 'aNeedOfTheDataItself'
	end 'pinFrozen'

	function noteSeedOrigins(index ElementIndex, fresh ParamPositionMask, mutable bool, line LineNumber, reason String)
		if fresh == NoParamPositions 'nothingNew'
			return
		end 'nothingNew'

		for position in 0 upto MaxAbiArgs 'eachPosition'
			if maskHasParam(fresh, param: position) 'aNewPin'
				self.seedOrigins.upsert(seedOriginKey(index, position: position, mutable: mutable), value: SeedOrigin.create(line, reason: reason))
			end 'aNewPin'
		end 'eachPosition'
	end 'noteSeedOrigins'

	module function seedOriginAt(index ElementIndex, position ParamCount, mutable bool) returns SeedOrigin throws AbsentError
		return try self.seedOrigins.get(seedOriginKey(index, position: position, mutable: mutable)) otherwise throw AbsentError.absent
	end 'seedOriginAt'

	module function frozenOnlyWhereRecordsAreHeld(index ElementIndex, position ParamCount) returns bool
		let inSome = maskHasParam(try self.frozenInSomeInstance.get(index) otherwise panic("CapabilityFacts.frozenOnlyWhereRecordsAreHeld: frozenInSomeInstance.get OOB at {index}"), param: position)
		let inEvery = maskHasParam(try self.immutableOnly.get(index) otherwise panic("CapabilityFacts.frozenOnlyWhereRecordsAreHeld: immutableOnly.get OOB at {index}"), param: position)
		return inSome and not inEvery
	end 'frozenOnlyWhereRecordsAreHeld'

	module function buildsRecordAt(index ElementIndex, position ParamCount) returns bool
		return maskHasParam(try self.buildsRecordFrom.get(index) otherwise panic("CapabilityFacts.buildsRecordAt: buildsRecordFrom.get OOB at {index}"), param: position)
	end 'buildsRecordAt'

	module function classAt(index ElementIndex, position ParamCount, declared ParamCapability) returns ParamClass
		return match declared 'capability'
			mutable gives ParamClass.mutableOnly
			immutable gives ParamClass.immutableOnly
			isolated gives ParamClass.isolatedParam
			unmarked gives self.inferredClassAt(index, position: position)
		end 'capability'
	end 'classAt'

	module function inferredClassAt(index ElementIndex, position ParamCount) returns ParamClass
		let needsMutable = maskHasParam(try self.mutableOnly.get(index) otherwise panic("CapabilityFacts.inferredClassAt: mutableOnly.get OOB at {index}"), param: position)
		let needsFrozen = maskHasParam(try self.immutableOnly.get(index) otherwise panic("CapabilityFacts.inferredClassAt: immutableOnly.get OOB at {index}"), param: position)

		if needsMutable and needsFrozen 'needsBoth'
			return ParamClass.both
		end 'needsBoth'

		if needsMutable 'writes'
			return ParamClass.mutableOnly
		end 'writes'

		return ParamClass.immutableOnly if needsFrozen else ParamClass.anyCapability
	end 'inferredClassAt'

	module function fixedCapabilityAt(index ElementIndex, position ParamCount) returns ValueCapability throws AbsentError
		match self.inferredClassAt(index, position: position) 'paramClass'
			mutableOnly then return ValueCapability.mutable
			immutableOnly then return ValueCapability.immutable
			anyCapability or
			both or
			isolatedParam then throw AbsentError.absent
		end 'paramClass'
	end 'fixedCapabilityAt'

	module function waits(index ElementIndex) returns bool
		return try self.mayWait.get(index) otherwise panic("CapabilityFacts.waits: mayWait.get OOB at {index}")
	end 'waits'

	module function yields(index ElementIndex) returns bool
		return try self.mayYield.get(index) otherwise panic("CapabilityFacts.yields: mayYield.get OOB at {index}")
	end 'yields'

	module function indexOf(callee ByteArray) returns ElementIndex throws AbsentError
		return try self.funcNames.byName.get(callee) otherwise throw AbsentError.absent
	end 'indexOf'
end 'CapabilityFacts'

module union CapabilityKnowledge
	notYet
	known(facts CapabilityFacts)
end 'CapabilityKnowledge'

function heldParamMaskOf(func IrFunction) returns ParamPositionMask
	var mask = NoParamPositions

	for param in func.capabilityNotes.heldParams 'eachHeldParam'
		mask = maskWithParam(mask, param: param)
	end 'eachHeldParam'

	return mask
end 'heldParamMaskOf'

module function declaredCapabilityAt(declared ParamCapabilityArray, position ParamCount) returns ParamCapability
	if position >= declared.count() 'pastTheDeclaredParameters'
		return ParamCapability.unmarked
	end 'pastTheDeclaredParameters'

	return try declared.get(position) otherwise panic("declaredCapabilityAt: declared.get OOB at {position} below the count just read")
end 'declaredCapabilityAt'

module function declaredCapabilityOf(sig FuncSignature, position ParamCount) returns ParamCapability
	if not sig.takesReceiver() 'noReceiver'
		return declaredCapabilityAt(sig.paramCapabilities, position: position)
	end 'noReceiver'

	if position == ReceiverParamPosition 'theReceiver'
		return sig.selfCapability
	end 'theReceiver'

	return declaredCapabilityAt(sig.paramCapabilities, position: position - 1)
end 'declaredCapabilityOf'

function declaredPositionMask(declared ParamCapabilityArray, capability ParamCapability) returns ParamPositionMask
	var mask = NoParamPositions

	for position in 0 upto declared.count() 'eachPosition'
		if declaredCapabilityAt(declared, position: position as ParamCount) == capability 'declaresIt'
			mask = maskWithParam(mask, param: position as ParamCount)
		end 'declaresIt'
	end 'eachPosition'

	return mask
end 'declaredPositionMask'

function isAnUnmarkedParameter(project Project, func IrFunction, argId ValueId) returns bool
	if argId >= valueIdAtParamPosition(func.paramCount) 'notAParameter'
		return false
	end 'notAParameter'

	if not project.funcSignatures.contains(func.name) 'aMintedFunction'
		return true
	end 'aMintedFunction'

	view sig = try project.funcSignatures.get(func.name) otherwise panic("isAnUnmarkedParameter: funcSignatures.get failed after contains for '{String.from(func.name)}'")
	return declaredCapabilityOf(sig, position: paramPositionOfValueId(argId)) == ParamCapability.unmarked
end 'isAnUnmarkedParameter'

module function argumentCapabilityOf(project Project, func IrFunction, argId ValueId) returns ValueCapability
	if argId < valueIdAtParamPosition(func.paramCount) 'aParameter'
		if let sig = try project.funcSignatures.get(func.name) 'aDeclaredSignature'
			match declaredCapabilityOf(sig, position: paramPositionOfValueId(argId)) 'declared'
				mutable then return ValueCapability.mutable
				immutable then return ValueCapability.immutable
				isolated then return ValueCapability.isolated
				unmarked then break
			end 'declared'
		end 'aDeclaredSignature'
	end 'aParameter'

	return try func.valueCapabilities.get(argId) otherwise panic("argumentCapabilityOf: valueCapabilities.get OOB at v{argId} of '{String.from(func.name)}' — the column is minted in lockstep with the type columns")
end 'argumentCapabilityOf'

function nameIsABoxedUnion(project Project, nameId TypeNameId) returns bool
	let name = try project.typeNames.nameOf(nameId) otherwise panic("nameIsABoxedUnion: nameOf failed at {nameId} — the id was minted against the project's interner")

	return programSignaturesIn(project, asker: "nameIsABoxedUnion").enumNameIsBoxed(name)
end 'nameIsABoxedUnion'

function tagAlwaysCarriesACapability(tag ValueTypeTag) returns bool
	return match tag 'tag'
		structRef or
		genericInstance or
		interfaceRef or
		function gives true
		typeParameter or
		named or
		integer or
		boolean or
		float or
		exitCode or
		unresolved or
		void or
		string or
		character or
		cstring gives false
	end 'tag'
end 'tagAlwaysCarriesACapability'

module function paramTagCarriesACapability(project Project, sig FuncSignature, func IrFunction, position ParamCount) returns bool
	let tag = maxonTypeTag(try func.maxonParamTypes.get(position) otherwise panic("paramTagCarriesACapability: maxonParamTypes.get OOB at {position} — a compared position names a parameter the function declares"))

	return tagAlwaysCarriesACapability(tag) or ((tag == ValueTypeTag.named or tag == ValueTypeTag.integer) and paramIsABoxedUnion(project, sig: sig, position: position))
end 'paramTagCarriesACapability'

function paramIsABoxedUnion(project Project, sig FuncSignature, position ParamCount) returns bool
	let aggregate = try sig.paramAggregateNames.get(position) otherwise return false

	return not aggregate.isEmpty() and programSignaturesIn(project, asker: "paramIsABoxedUnion").enumNameIsBoxed(aggregate)
end 'paramIsABoxedUnion'

module function valueCarriesACapability(project Project, func IrFunction, value ValueId) returns bool
	let tag = valueTagOf(func, value: value)

	return tagAlwaysCarriesACapability(tag) or tag == ValueTypeTag.typeParameter or (tag == ValueTypeTag.named and nameIsABoxedUnion(project, nameId: try func.valueNameIds.get(value) otherwise panic("valueCarriesACapability: valueNameIds.get OOB at v{value} of '{String.from(func.name)}' — the type columns are minted in lockstep")))
end 'valueCarriesACapability'

module function storedSlotTargetOf(project Project, module MaxonModule, funcNames FunctionNameIndex, provenance ProvenanceTracer, stored StoredSlotArg) returns (immutable ByteArray, String) throws AbsentError
	let op = try module.ops.get(stored.op) otherwise throw AbsentError.absent
	let parts = try directCallPartsOf(op)
	let callee = parts.0
	let labels = parts.2

	if not funcNames.byName.contains(callee) or not project.funcSignatures.contains(callee) 'aCalleeNoSummaryDescribes'
		return (callee, "argument {stored.argIndex}")
	end 'aCalleeNoSummaryDescribes'

	let calleeIndex = try funcNames.byName.get(callee) otherwise throw AbsentError.absent
	let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("storedSlotTargetOf: functions.get OOB at {calleeIndex}")
	view sig = try project.funcSignatures.get(callee) otherwise throw AbsentError.absent
	let position = try argSlotPosition(sig.paramNames, argIndex: stored.argIndex, label: try labels.get(stored.argIndex) otherwise throw AbsentError.absent) otherwise throw AbsentError.absent
	let parameterName = displayParamName(try sig.paramNames.get(position) otherwise throw AbsentError.absent)

	if bodyIsOpaqueToSummaries(calleeFunc, libraryFacts: project.libraryFacts) 'aBodyNoSummaryCanSee'
		return (callee, parameterName)
	end 'aBodyNoSummaryCanSee'

	if not maskHasParam(provenance.keptParameters(calleeIndex, paramCount: sig.paramCount()), param: position) 'notStoredByTheCallee'
		throw AbsentError.absent
	end 'notStoredByTheCallee'

	return (callee, parameterName)
end 'storedSlotTargetOf'

module function resultFromPositionCount(func IrFunction) returns ParamCount
	var count = 0 as ParamCount

	for position in 0 upto func.paramCount 'eachPosition'
		if maskHasParam(func.resultFromParamMask, param: position) 'fromThisOne'
			count = count + 1
		end 'fromThisOne'
	end 'eachPosition'

	return count
end 'resultFromPositionCount'

module function functionValueIsMutable(project Project, func IrFunction, value ValueId) returns bool
	view shape = try functionTypeRegistryOf(project).aliasShapes.get(functionValueGoverningName(project, func: func, value: value)) otherwise return false
	return shape.mutableFunction
end 'functionValueIsMutable'

module function inferCapabilities(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex, provenance ProvenanceTracer, provenanceWrites ProvenanceReceiverWrites, edges CallParamEdges, byCallee CsrGraph, paramSources ParamSourceIndex) returns CapabilityFacts
	let funcCount = funcNames.functions.count()
	var facts = CapabilityFacts.create(funcNames, ir: module)
	var waitSeeds = BoolArray.create(funcCount, zeroed: false)

	for i in 0 upto funcCount 'seed'
		let func = try funcNames.functions.get(i) otherwise panic("inferCapabilities: functions.get OOB at {i} below its own count")
		let writtenThroughAnAlias = try provenanceWrites.identity.get(i) otherwise panic("inferCapabilities: identity seed OOB at {i} — the column is built over `funcNames.functions`")
		let writtenWithinAnAlias = try provenanceWrites.within.get(i) otherwise panic("inferCapabilities: within seed OOB at {i} — the column is built over `funcNames.functions`")
		var declaredMutable = NoParamPositions
		var declaredImmutable = NoParamPositions

		if let sig = try project.funcSignatures.get(func.name) 'aDeclaredSignature'
			let declared = sig.shapeParamCapabilities()
			declaredMutable = declaredPositionMask(declared, capability: ParamCapability.mutable)
			declaredImmutable = declaredPositionMask(declared, capability: ParamCapability.immutable)
		end 'aDeclaredSignature'

		facts.mutableOnly.push(func.writtenParamMask or func.writesThroughParamMask or writtenThroughAnAlias or writtenWithinAnAlias or func.needsMutableParamMask or declaredMutable)
		facts.immutableOnly.push(func.needsFrozenParamMask or declaredImmutable)
		facts.frozenInSomeInstance.push(func.needsFrozenParamMask or declaredImmutable)
		facts.buildsRecordFrom.push(heldParamMaskOf(func))
		waitSeeds.push(blockingSeedOf(func, waits: true, libraryFacts: project.libraryFacts))
	end 'seed'

	var blockingEdges = BlockingEdges.create()
	collectCapabilitySeeds(project, module: module, signatures: signatures, funcNames: funcNames, provenance: provenance, facts: facts, blockingEdges: blockingEdges, paramSources: paramSources)

	facts.directMutable = facts.mutableOnly.clone()
	facts.directImmutable = facts.frozenInSomeInstance.clone()

	propagateParamMasks(facts.mutableOnly, edges: edges, byCallee: byCallee, need: PropagatedNeed.written, hops: facts.writtenHops)
	propagateParamMasks(facts.immutableOnly, edges: edges, byCallee: byCallee, need: PropagatedNeed.frozen, hops: facts.frozenHops)
	propagateParamMasks(facts.frozenInSomeInstance, edges: edges, byCallee: byCallee, need: PropagatedNeed.frozenIfRecordsHeld, hops: facts.frozenSomeHops)
	propagateParamMasks(facts.buildsRecordFrom, edges: edges, byCallee: byCallee, need: PropagatedNeed.written, hops: NeedHops.untracked())

	facts.mayWait = blockingEdges.markCallers(waitSeeds, nodeCount: funcCount as CsrIndex, waits: true)
	var yieldSeeds = BoolArray.create(funcCount, zeroed: false)

	for i in 0 upto funcCount 'yieldSeed'
		let func = try funcNames.functions.get(i) otherwise panic("inferCapabilities: functions.get OOB at {i} below its own count")
		yieldSeeds.push(blockingSeedOf(func, waits: false, libraryFacts: project.libraryFacts) or (try facts.mayWait.get(i) otherwise panic("inferCapabilities: mayWait.get OOB at {i}")))
	end 'yieldSeed'

	facts.mayYield = blockingEdges.markCallers(yieldSeeds, nodeCount: funcCount as CsrIndex, waits: false)
	settleRetainDoors(module, funcNames: funcNames, facts: facts)
	return facts
end 'inferCapabilities'

function settleRetainDoors(module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts)
	for funcIndex in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(funcIndex) otherwise panic("settleRetainDoors: functions.get OOB at {funcIndex} below its own count")

		if bodyIsUnreadable(func) 'nothingToRewrite'
			continue
		end 'nothingToRewrite'

		let notes = func.capabilityNotes
		var position = 0 as ElementIndex

		while position < notes.retainOps.count() 'eachDoor'
			let opIdx = try notes.retainOps.get(position) otherwise panic("settleRetainDoors: retainOps.get OOB at {position}")
			var frozen = true

			while position < notes.retainOps.count() and (try notes.retainOps.get(position) otherwise panic("settleRetainDoors: retainOps.get OOB at {position}")) == opIdx 'eachSourceOfTheDoor'
				let param = try notes.retainParams.get(position) otherwise panic("settleRetainDoors: retainParams.get OOB at {position} — the columns are pushed together")
				frozen = frozen and facts.inferredClassAt(funcIndex, position: param) == ParamClass.immutableOnly
				position = position + 1
			end 'eachSourceOfTheDoor'

			if not frozen 'stillMayBeWritten'
				continue
			end 'stillMayBeWritten'

			let op = try module.ops.get(opIdx) otherwise panic("settleRetainDoors: ops.get OOB at {opIdx}")

			if opIsDirectCallTo(op, callee: ManagedRetainName) 'aManagedRetain'
				try module.ops.set(opIdx, value: callWithCallee(op, callee: MmRetainName)) otherwise panic("settleRetainDoors: ops.set OOB at {opIdx}")
			end 'aManagedRetain'
		end 'eachDoor'
	end 'eachFunc'
end 'settleRetainDoors'

module enum CallEdgeKind
	call
	async
	spawn
end 'CallEdgeKind'

module function callEdgeOf(op MaxonOp) returns (immutable ByteArray, CallEdgeKind) throws AbsentError
	match op 'op'
		call(_, callee, _, _, _, _, _, _) then return (callee, CallEdgeKind.call)
		tryCall(_, _, callee, _, _, _, _, _, _) then return (callee, CallEdgeKind.call)
		asyncCall(_, callee, _, _, _, _, _, _) then return (callee, CallEdgeKind.async)
		serviceSpawn(_, _, _, _, callee, _, _, _, _, _, _, _) then return (callee, CallEdgeKind.spawn)
		default throws AbsentError.absent
	end 'op'
end 'callEdgeOf'

module function directCallPartsOf(op MaxonOp) returns (immutable ByteArray, ValueIdArray, NameRoster, SourceRangeArray, WriteBlameArray) throws AbsentError
	match op 'op'
		call(_, callee, args, argLabels, argRanges, argImmutableNames, _, _) then return (callee, args, argLabels, argRanges, argImmutableNames)
		tryCall(_, _, callee, args, argLabels, argRanges, argImmutableNames, _, _) then return (callee, args, argLabels, argRanges, argImmutableNames)
		asyncCall(_, callee, args, argLabels, argRanges, argImmutableNames, _, _) then return (callee, args, argLabels, argRanges, argImmutableNames)
		default throws AbsentError.absent
	end 'op'
end 'directCallPartsOf'

module function directCalleeOf(op MaxonOp) returns immutable ByteArray throws AbsentError
	let edge = try callEdgeOf(op)

	if edge.1 == CallEdgeKind.spawn 'aFactoryNotACall'
		throw AbsentError.absent
	end 'aFactoryNotACall'

	return edge.0
end 'directCalleeOf'

module enum CapabilityDoor
	inert
	directCall
	spawn
	functionValueCall
	witnessCall
	returned
end 'CapabilityDoor'

module function capabilityDoorOf(op MaxonOp) returns CapabilityDoor
	return match op 'op'
		call or
		tryCall or
		asyncCall gives CapabilityDoor.directCall
		serviceSpawn gives CapabilityDoor.spawn
		indirectCall gives CapabilityDoor.functionValueCall
		witnessDispatch or
		witnessTryDispatch gives CapabilityDoor.witnessCall
		ret gives CapabilityDoor.returned
		literal or
		retVoid or
		binOp or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		loadIndirect or
		storeIndirect or
		stringLiteral or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		panicAbortValue or
		errorFlagEncode or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdValue or
		holdEnd gives CapabilityDoor.inert
	end 'op'
end 'capabilityDoorOf'

module function witnessCallPartsOf(op MaxonOp) returns (ValueIdArray, WriteBlameArray, WitnessMethodIndex, ElementIndex) throws AbsentError
	match op 'op'
		witnessDispatch(_, args, argImmutableNames, _, methodIndex, interfaceDeclIndex, _, _) then return (args, argImmutableNames, methodIndex, interfaceDeclIndex)
		witnessTryDispatch(_, _, args, argImmutableNames, _, methodIndex, interfaceDeclIndex, _) then return (args, argImmutableNames, methodIndex, interfaceDeclIndex)
		default throws AbsentError.absent
	end 'op'
end 'witnessCallPartsOf'

module function edgeTransmits(kind CallEdgeKind, waits bool) returns bool
	return match kind 'kind'
		call or
		spawn gives true
		async gives waits
	end 'kind'
end 'edgeTransmits'

function closureCallEdgeOf(project Project, func IrFunction, op MaxonOp) returns (immutable ByteArray, CallEdgeKind) throws AbsentError
	match op 'op'
		indirectCall(_, callee, _, _) then return (functionValueGoverningName(project, func: func, value: callee), CallEdgeKind.call)
		default throws AbsentError.absent
	end 'op'
end 'closureCallEdgeOf'

module function callOrClosureEdgeOf(project Project, func IrFunction, op MaxonOp) returns (immutable ByteArray, CallEdgeKind) throws AbsentError
	if let edge = try callEdgeOf(op) 'aNamedCall'
		return edge
	end 'aNamedCall'

	return try closureCallEdgeOf(project, func: func, op: op)
end 'callOrClosureEdgeOf'

module function blockingSeedOf(func IrFunction, waits bool, libraryFacts LibraryFacts) returns bool
	if bodyIsUnreadable(func) 'aBodyNothingCanBeProvedAbout'
		return bodyIsOpaqueToSummaries(func, libraryFacts: libraryFacts) and not isRuntimeCallee(func.name)
	end 'aBodyNothingCanBeProvedAbout'

	return func.mayWaitSeed if waits else (func.mayYieldSeed or func.mayWaitSeed)
end 'blockingSeedOf'

type BlockingEdges
	var calls as CallGraphEdges
	var kinds as CallEdgeKindArray

	static function create() returns BlockingEdges
		return Self{calls: CallGraphEdges.create(), kinds: CallEdgeKindArray.create(0)}
	end 'create'

	function record(calleeIndex ElementIndex, callerIndex ElementIndex, kind CallEdgeKind)
		self.calls.record(calleeIndex, callerIndex: callerIndex)
		self.kinds.push(kind)
	end 'record'

	function markCallers(seeds BoolArray, nodeCount CsrIndex, waits bool) returns BoolArray
		var transmitted = CallGraphEdges.create()

		for row in 0 upto self.kinds.count() 'eachEdge'
			if edgeTransmits(try self.kinds.get(row) otherwise panic("BlockingEdges.markCallers: kinds.get OOB at {row}"), waits: waits) 'carriesTheMark'
				transmitted.record(try self.calls.calleeIndices.get(row) otherwise panic("BlockingEdges.markCallers: calleeIndices.get OOB at {row}"), callerIndex: try self.calls.callerIndices.get(row) otherwise panic("BlockingEdges.markCallers: callerIndices.get OOB at {row}"))
			end 'carriesTheMark'
		end 'eachEdge'

		return markSeededCallers(transmitted, seeds: seeds, nodeCount: nodeCount)
	end 'markCallers'
end 'BlockingEdges'

module typealias FixedCallEdgeKindArray = FixedArray with CallEdgeKind
module typealias CallEdgeKindArray = Array with CallEdgeKind

function collectCapabilitySeeds(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, blockingEdges BlockingEdges, paramSources ParamSourceIndex)
	var witnessSlots = WitnessSlotsByDeclIndex.create()

	for callerIndex in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(callerIndex) otherwise panic("collectCapabilitySeeds: functions.get OOB at {callerIndex} below its own count")

		if bodyIsUnreadable(func) 'nothingToRead'
			continue
		end 'nothingToRead'

		let sources = paramSources.of(callerIndex)

		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("collectCapabilitySeeds: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				let op = try module.ops.get(opIdx) otherwise panic("collectCapabilitySeeds: opIdx {opIdx} not in module.ops")
				noteBlockingEdgeOf(project, op: op, funcNames: funcNames, func: func, callerIndex: callerIndex, blockingEdges: blockingEdges)
				noteCapabilitySeedsOf(project, signatures: signatures, funcNames: funcNames, witnessSlots: witnessSlots, sources: sources, callerIndex: callerIndex, opIdx: opIdx, op: op, facts: facts)
			end 'eachOp'

			if block.hasTerminatorOp() 'aTerminator'
				noteReturnedResultSeed(project, sources: sources, callerIndex: callerIndex, opIdx: block.terminatorIndex(), facts: facts)
			end 'aTerminator'
		end 'eachBlock'

		noteStoredSlotSeeds(project, funcNames: funcNames, provenance: provenance, sources: sources, callerIndex: callerIndex, facts: facts)
		noteResultUseSeeds(project, sources: sources, callerIndex: callerIndex, facts: facts)
		noteResultWriteSeeds(project, sources: sources, callerIndex: callerIndex, facts: facts)
	end 'eachFunc'
end 'collectCapabilitySeeds'

module function opDefinesValue(module MaxonModule, opIdx ElementIndex, value ValueId) returns bool
	let op = try module.ops.get(opIdx) otherwise panic("opDefinesValue: ops.get OOB at {opIdx}")
	return (try maxonOpDefinedValue(op) otherwise return false) == value
end 'opDefinesValue'

module function firstOpDefiningSince(module MaxonModule, value ValueId, floor ElementIndex) returns ElementIndex throws AbsentError
	for opIdx in floor upto module.ops.count() 'eachNewOp'
		if opDefinesValue(module, opIdx: opIdx, value: value) 'theProducer'
			return opIdx
		end 'theProducer'
	end 'eachNewOp'

	throw AbsentError.absent
end 'firstOpDefiningSince'

module function callerParamMaskOf(project Project, sources ParamSources, value ValueId) returns ParamPositionMask
	var mask = NoParamPositions
	let reached = sources.maskOf(value)

	for param in 0 upto MaxAbiArgs 'eachSource'
		if maskHasParam(reached, param: param) and isAnUnmarkedParameter(project, func: sources.func, argId: valueIdAtParamPosition(param)) 'anUnmarkedSource'
			mask = maskWithParam(mask, param: param)
		end 'anUnmarkedSource'
	end 'eachSource'

	return mask
end 'callerParamMaskOf'

function valueIsOfUnknownType(func IrFunction, value ValueId) returns bool
	return valueTagOf(func, value: value) == ValueTypeTag.typeParameter
end 'valueIsOfUnknownType'

function slotNoun(slot ParamCapability) returns String
	return match slot 'slot'
		immutable gives "an `immutable` slot"
		unmarked or
		mutable gives "a writable slot"
		isolated gives "an `isolated` slot"
	end 'slot'
end 'slotNoun'

function noteResultSlotSeed(facts CapabilityFacts, slot ParamCapability, sources ParamPositionMask, callerIndex ElementIndex, valueOfUnknownType bool, line LineNumber, reason String)
	match slot 'slot'
		immutable then facts.pinFrozen(callerIndex, bits: sources, elementsOfUnknownType: valueOfUnknownType, line: line, reason: reason)
		unmarked or
		mutable then facts.pinMutable(callerIndex, bits: sources, line: line, reason: reason)
		isolated then break
	end 'slot'
end 'noteResultSlotSeed'

function resultUseReason(use ResultUse) returns String
	if use.sends 'aSend'
		return "a result read from it is sent to an `immutable` parameter"
	end 'aSend'

	return "a result read from it is stored in {slotNoun(use.slot)} ({use.place})"
end 'resultUseReason'

function noteResultUseSeeds(project Project, sources ParamSources, callerIndex ElementIndex, facts CapabilityFacts)
	for use in sources.func.capabilityNotes.resultUses 'eachResultUse'
		let defined = try maxonOpDefinedValue(try sources.ir.ops.get(use.op) otherwise panic("noteResultUseSeeds: ops.get OOB at {use.op}")) otherwise panic("noteResultUseSeeds: a result use names the call that defines the result")
		let reached = callerParamMaskOf(project, sources: sources, value: defined)

		if reached == NoParamPositions 'nothingToPin'
			continue
		end 'nothingToPin'

		noteResultSlotSeed(facts, slot: use.slot, sources: reached, callerIndex: callerIndex, valueOfUnknownType: valueIsOfUnknownType(sources.func, value: defined), line: use.line, reason: resultUseReason(use))
	end 'eachResultUse'
end 'noteResultUseSeeds'

function noteResultWriteSeeds(project Project, sources ParamSources, callerIndex ElementIndex, facts CapabilityFacts)
	let notes = sources.func.capabilityNotes

	for position in 0 upto notes.resultWriteOps.count() 'eachResultWrite'
		let opIdx = try notes.resultWriteOps.get(position) otherwise panic("noteResultWriteSeeds: resultWriteOps.get OOB at {position}")
		let defined = try maxonOpDefinedValue(try sources.ir.ops.get(opIdx) otherwise panic("noteResultWriteSeeds: ops.get OOB at {opIdx}")) otherwise continue
		let reached = callerParamMaskOf(project, sources: sources, value: defined)

		if reached == NoParamPositions 'nothingToPin'
			continue
		end 'nothingToPin'

		facts.pinMutable(callerIndex, bits: reached, line: try notes.resultWriteLines.get(position) otherwise panic("noteResultWriteSeeds: resultWriteLines.get OOB at {position}"), reason: "it is written through a result read from it")
	end 'eachResultWrite'
end 'noteResultWriteSeeds'

module function returnedResultValueOf(op MaxonOp) returns ValueId throws AbsentError
	match op 'op'
		ret(value) then return value
		default throws AbsentError.absent
	end 'op'
end 'returnedResultValueOf'

function noteReturnedResultSeed(project Project, sources ParamSources, callerIndex ElementIndex, opIdx ElementIndex, facts CapabilityFacts)
	let func = sources.func
	let retVal = try returnedResultValueOf(try sources.ir.ops.get(opIdx) otherwise panic("noteReturnedResultSeed: ops.get OOB at {opIdx}")) otherwise return

	view sig = try project.funcSignatures.get(func.name) otherwise return

	if sig.returnCapability != ResultCapability.immutable or func.capabilityNotes.undecidedResultOps.isEmpty() 'nothingToPin'
		return
	end 'nothingToPin'

	if not sources.isAResult(retVal) 'notAResult'
		return
	end 'notAResult'

	let reached = callerParamMaskOf(project, sources: sources, value: retVal)

	if reached == NoParamPositions 'nothingToPin'
		return
	end 'nothingToPin'

	facts.pinFrozen(callerIndex, bits: reached, elementsOfUnknownType: valueIsOfUnknownType(func, value: retVal), line: project.opRanges.get(opIdx).line, reason: "it returns a result read from it, and '{functionSourceName(project, func: func)}' declares `returns immutable`")
end 'noteReturnedResultSeed'

function storedSlotReason(target(immutable ByteArray, String), slot ParamCapability) returns String
	return "'{String.from(genericTemplateName(target.0))}' keeps a value read from it in {slotNoun(slot)} (its parameter '{target.1}')"
end 'storedSlotReason'

function noteStoredSlotSeeds(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, sources ParamSources, callerIndex ElementIndex, facts CapabilityFacts)
	for stored in sources.func.capabilityNotes.storedSlotArgs 'eachStoredSlotArg'
		let target = try storedSlotTargetOf(project, module: sources.ir, funcNames: funcNames, provenance: provenance, stored: stored) otherwise continue

		if not stored.undecided and not sources.isAResult(stored.argValue) 'judgedAtTheCall'
			continue
		end 'judgedAtTheCall'

		let reached = stored.sources if stored.undecided else callerParamMaskOf(project, sources: sources, value: stored.argValue)

		if reached == NoParamPositions 'nothingToPin'
			continue
		end 'nothingToPin'

		noteResultSlotSeed(facts, slot: stored.slot, sources: reached, callerIndex: callerIndex, valueOfUnknownType: valueIsOfUnknownType(sources.func, value: stored.argValue), line: stored.line, reason: storedSlotReason(target, slot: stored.slot))
	end 'eachStoredSlotArg'
end 'noteStoredSlotSeeds'

module function orIntoMask(masks ParamPositionMaskArray, index ElementIndex, bits ParamPositionMask)
	try masks.set(index, value: (try masks.get(index) otherwise panic("orIntoMask: masks.get OOB at {index}")) or bits) otherwise panic("orIntoMask: masks.set OOB at {index}")
end 'orIntoMask'

function noteBlockingEdgeOf(project Project, op MaxonOp, funcNames FunctionNameIndex, func IrFunction, callerIndex ElementIndex, blockingEdges BlockingEdges)
	let edge = try callOrClosureEdgeOf(project, func: func, op: op) otherwise return
	let calleeIndex = try funcNames.byName.get(edge.0) otherwise return
	blockingEdges.record(calleeIndex, callerIndex: callerIndex, kind: edge.1)
end 'noteBlockingEdgeOf'

function noteCapabilitySeedsOf(project Project, signatures ProgramSignatures, funcNames FunctionNameIndex, witnessSlots WitnessSlotsByDeclIndex, sources ParamSources, callerIndex ElementIndex, opIdx ElementIndex, op MaxonOp, facts CapabilityFacts)
	match capabilityDoorOf(op) 'door'
		inert or
		spawn or
		returned then break
		directCall then pinParamsJoinedWithWritableData(project, funcNames: funcNames, sources: sources, callerIndex: callerIndex, opIdx: opIdx, op: op, facts: facts)
		functionValueCall then noteFunctionValueCallSeeds(project, sources: sources, callerIndex: callerIndex, opIdx: opIdx, op: op, facts: facts)
		witnessCall then noteRequirementCallSeeds(project, signatures: signatures, witnessSlots: witnessSlots, sources: sources, callerIndex: callerIndex, opIdx: opIdx, op: op, facts: facts)
	end 'door'
end 'noteCapabilitySeedsOf'

function pinParamsJoinedWithWritableData(project Project, funcNames FunctionNameIndex, sources ParamSources, callerIndex ElementIndex, opIdx ElementIndex, op MaxonOp, facts CapabilityFacts)
	let func = sources.func
	let parts = try directCallPartsOf(op) otherwise panic("pinParamsJoinedWithWritableData: handed an op that is not a direct call")
	let callee = parts.0
	let args = parts.1
	let argLabels = parts.2
	let calleeIndex = try funcNames.byName.get(callee) otherwise return
	let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("pinParamsJoinedWithWritableData: functions.get OOB at {calleeIndex}")

	if resultFromPositionCount(calleeFunc) < 2 'adaptsToAtMostOne'
		return
	end 'adaptsToAtMostOne'

	let sig = try project.funcSignatures.get(callee) otherwise return
	var parameters = NoParamPositions
	var writable = false

	for i in 0 upto args.count() 'eachArg'
		let label = try argLabels.get(i) otherwise panic("pinParamsJoinedWithWritableData: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
		let position = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

		if not maskHasParam(calleeFunc.resultFromParamMask, param: position) 'notJoined'
			continue
		end 'notJoined'

		let argId = try args.get(i) otherwise panic("pinParamsJoinedWithWritableData: args.get OOB at {i} below its own count")

		if not valueCarriesACapability(project, func: func, value: argId) 'aValueHasNoCapabilityToJoin'
			continue
		end 'aValueHasNoCapabilityToJoin'

		let reached = callerParamMaskOf(project, sources: sources, value: argId)

		if reached != NoParamPositions 'anUnmarkedParameter'
			parameters = parameters or reached
			continue
		end 'anUnmarkedParameter'

		if argumentCapabilityOf(project, func: func, argId: argId) == ValueCapability.mutable 'writableData'
			writable = true
		end 'writableData'
	end 'eachArg'

	if writable 'pinsThem'
		facts.pinMutable(callerIndex, bits: parameters, line: project.opRanges.get(opIdx).line, reason: "it is joined with writable data in the call to '{String.from(genericTemplateName(callee))}', whose result takes the capability of its arguments")
	end 'pinsThem'
end 'pinParamsJoinedWithWritableData'

function noteFunctionValueCallSeeds(project Project, sources ParamSources, callerIndex ElementIndex, opIdx ElementIndex, op MaxonOp, facts CapabilityFacts)
	let func = sources.func

	let (calleeValue, args) = match op 'op'
		indirectCall(_, callee, args, _) gives (callee, args)
		default panic("noteFunctionValueCallSeeds: handed an op that is not an indirect call")
	end 'op'

	view shape = try functionTypeRegistryOf(project).aliasShapes.get(functionValueGoverningName(project, func: func, value: calleeValue)) otherwise return

	let line = project.opRanges.get(opIdx).line
	let boundary = aliasDisplayOf(project, name: functionValueGoverningName(project, func: func, value: calleeValue))

	if shape.mutableFunction 'aMutableFunction'
		facts.pinMutable(callerIndex, bits: callerParamMaskOf(project, sources: sources, value: calleeValue), line: line, reason: "it is a function value of '{boundary}', which declares `mutates captures`, called here")
	end 'aMutableFunction'

	for position in 0 upto userArityOfIndirectCall(args) 'eachArg'
		let argument = try args.get(position) otherwise panic("noteFunctionValueCallSeeds: args.get OOB at {position} below the supplied count")
		let declared = declaredCapabilityAt(shape.paramCapabilities, position: position as ParamCount)
		pinDeclaredSources(facts, declared: declared, index: callerIndex, sources: callerParamMaskOf(project, sources: sources, value: argument), valueOfUnknownType: valueIsOfUnknownType(func, value: argument), line: line, boundary: boundary)
	end 'eachArg'
end 'noteFunctionValueCallSeeds'

function noteRequirementCallSeeds(project Project, signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, sources ParamSources, callerIndex ElementIndex, opIdx ElementIndex, op MaxonOp, facts CapabilityFacts)
	let parts = try witnessCallPartsOf(op) otherwise panic("noteRequirementCallSeeds: handed an op that is not a witness dispatch")
	let args = parts.0
	let methodIndex = parts.2
	let interfaceDeclIndex = parts.3
	let slot = witnessSlotAt(signatures, interfaces: signatures.interfaceMap(), witnessSlots: witnessSlots, interfaceDeclIndex: interfaceDeclIndex, methodIndex: methodIndex)
	let method = slot.method
	let first = requirementFirstPosition(method)
	let line = project.opRanges.get(opIdx).line
	let boundary = "{String.from(slot.sourceInterfaceName)}.{String.from(method.name)}"

	for position in 0 upto args.count() 'eachArg'
		let argument = try args.get(position) otherwise panic("noteRequirementCallSeeds: args.get OOB at {position} below its own count")
		let declared = requirementCapabilityAt(method, position: position as ParamCount, first: first)
		pinDeclaredSources(facts, declared: declared, index: callerIndex, sources: callerParamMaskOf(project, sources: sources, value: argument), valueOfUnknownType: valueIsOfUnknownType(sources.func, value: argument), line: line, boundary: boundary)
	end 'eachArg'
end 'noteRequirementCallSeeds'

module function requirementCapabilityAt(method InterfaceMethodSig, position ParamCount, first ParamCount) returns ParamCapability
	if position < first 'theReceiver'
		return method.selfCapability
	end 'theReceiver'

	return declaredCapabilityAt(method.paramCapabilities, position: position - first)
end 'requirementCapabilityAt'

function pinDeclaredSources(facts CapabilityFacts, declared ParamCapability, index ElementIndex, sources ParamPositionMask, valueOfUnknownType bool, line LineNumber, boundary String)
	match declared 'capability'
		mutable then facts.pinMutable(index, bits: sources, line: line, reason: "it is passed to a `mutable` parameter of '{boundary}'")
		immutable then facts.pinFrozen(index, bits: sources, elementsOfUnknownType: valueOfUnknownType, line: line, reason: "it is passed to an `immutable` parameter of '{boundary}'")
		unmarked then orIntoMask(facts.buildsRecordFrom, index: index, bits: sources)
		isolated then break
	end 'capability'
end 'pinDeclaredSources'
