extension ProgramSignatures
	// ⭐ **DOES ANY INTERNED INSTANCE OF THE TYPE THAT DECLARES `param` MAKE THAT OPAQUE ARRAY ELEMENT
	// UNCOPYABLE?** The FRONT-END gate for an opaque `slice`/`clone`/`append`: the shared
	// body copies each element through the descriptor's single `copyFunc@32`, which can hold a cloner only for a
	// `direct`-clonable element (String / struct / boxed union / trivial-element array — a byte-blit copies a
	// TRIVIAL element correctly with no cloner at all). An instantiation whose argument is a MANAGED type
	// NOTHING can deep-clone — a compiler-owned aggregate, an existential, or a base-struct-less generic
	// instance with no runtime copy of its own (a cursor; a DECLARED generic's instance has its own
	// `__clone_<mangled>`, and a managed-element container its one-argument thunk) — has no `copyFunc`, so a
	// copy of it would byte-blit a managed pointer and double-free it; such an instantiation is rejected
	// with a positioned E2015 at the copy site rather than crash at descriptor emit. HOW the instances are found
	// is `instanceWithTypeArgKind`'s business and is described there once; what this gate adds is the KIND —
	// each instance's argument at that parameter's position read through the SAME
	// `typeSupportsDeepClone` the concrete element-copy gate (`sourceCloneVerdictOfType`)
	// uses, so the opaque reject and the concrete reject agree on what "deep-cloneable as an element" means. A
	// TRIVIAL argument is copyable (a byte blit), so it never triggers the reject.
	//
	// ⭐ It hands back a match and not a bool because it REFUSES: the instantiation's written site is what the
	// refusal is blamed at (`LibraryBlame`). See `instanceWithTypeArgKind`.
	export function genericTypeFieldUncopyableInstantiation(param TypeParamId) returns TypeArgKindMatch
		return self.instanceWithTypeArgKind(param, kind: TypeArgInstantiationKind.uncopyableElement)
	end 'genericTypeFieldUncopyableInstantiation'

	export function genericTypeFieldGreenThreadInstantiation(param TypeParamId) returns TypeArgKindMatch
		return self.instanceWithTypeArgKind(param, kind: TypeArgInstantiationKind.greenThreadElement)
	end 'genericTypeFieldGreenThreadInstantiation'

	export function genericTypeFieldNoZeroInstantiation(param TypeParamId) returns TypeArgKindMatch
		return self.instanceWithTypeArgKind(param, kind: TypeArgInstantiationKind.noZeroElement)
	end 'genericTypeFieldNoZeroInstantiation'

	// ⭐⭐ **WHERE THE PROGRAM WROTE THIS INSTANTIATION — the source anchor a library-body refusal is blamed
	// at (BLAME).** `genericAliasSites` is the whole-program list of every WRITTEN `Base with Args` carrying a
	// source anchor, built by the token sweep before any file is parsed, so this answer is available to the
	// PURE parser and rides the parse memo's key exactly as every other signature fact does.
	//
	// ⭐ **AN INSTANCE THE PROGRAM DID NOT WRITE IS FOLLOWED BACK TO ONE IT DID.** A generic body's inner
	// `typealias ElementArray = Array with Element` is re-interned per enclosing instance, so
	// `typealias NestedContainer = Container with Bag` mints `Array with Bag` — the instance that gets
	// refused, and one no author ever spelled. `substitutedInstanceOrigins` records the enclosing
	// instantiation each such mint came out of, and the walk chases that chain (an inner alias of an inner
	// alias is two hops) until it reaches something written.
	//
	// ⚠ Some instances still have neither: a compiler-minted alias has no declaring file at all, and an
	// instance whose enclosing instantiation was itself never written bottoms out unwritten. A caller that
	// finds nothing leaves the diagnostic where it was raised — the pre-BLAME behaviour, which loses
	// precision and nothing else.
	//
	// The scan is linear in the written instantiation sites per hop and runs only on the REFUSAL path, so it
	// costs a clean compile nothing; an index would be a map built for every program to serve the failing
	// ones.
	export function instantiationSiteOf(id GenericInstanceId) returns InstantiationSiteLookup
		for gid in self.instantiationOriginChain(id) 'eachHop'
			for site in self.settledDeclarations().genericAliasSites 'eachSite'
				if site.gid == gid 'written'
					return InstantiationSiteLookup.written(site)
				end 'written'
			end 'eachSite'
		end 'eachHop'

		return InstantiationSiteLookup.unwritten
	end 'instantiationSiteOf'

	// ⭐ **`id`, THEN EVERY ENCLOSING INSTANTIATION THAT MINTED IT** — the one chase up
	// `substitutedInstanceOrigins`, shared by the two questions that ask it: *where did the program WRITE
	// this?* (`instantiationSiteOf`) and *is any hop of it already refused by its own `where` clause?*
	// (`instantiationChainViolatesItsWhereClause`). Written once because the two must agree about which
	// instantiations an unwritten instance stands for, and because a termination argument stated twice is
	// one that comes to be true in only one of the two places.
	//
	// ⚠ The hop count is bounded by the origin map's size, because an origin chain is derived data and a
	// cycle in it must cost a lost answer rather than a hang.
	//
	// It ALLOCATES, so it is reached only from the two REFUSAL paths — one after a diagnostic is already
	// certain, one after a candidate instance has already matched an uncopyable/managed kind.
	export function instantiationOriginChain(id GenericInstanceId) returns GenericInstanceIdArray
		let chain = GenericInstanceIdArray.create(0)
		var current = id
		var hops = 0 as ElementIndex

		while (hops as EntryCount) <= self.originCount() 'followTheChain'
			chain.push(current)
			current = try self.originOf(current) otherwise return chain
			hops = hops + 1
		end 'followTheChain'

		return chain
	end 'instantiationOriginChain'

	// ⭐⭐ **IS THIS INSTANCE'S OWN `where` CLAUSE UNMET — i.e. is E3017 already this instantiation's
	// answer?** The one question a REFUSAL asks before reading a registry row: an instantiation the
	// constraint check owns describes a program that will not exist, so a diagnostic derived from the
	// rows it minted is a CONSEQUENCE reported in place of its CAUSE.
	//
	// The per-constraint verdict is `ConformanceCheck.instantiationMeetsConstraint`, the same one E3017 is
	// reported off, so the suppression and the report cannot come to disagree about which instantiations are
	// unsatisfiable.
	//
	// ⛔⛔ **IT ASKS THAT VERDICT TWICE, AND THE SECOND ASK IS WHAT MAKES THE SUPPRESSION SOUND.** A
	// suppression is only allowed to withhold a refusal because E3017 is going to speak instead, so
	// its index must be a SUPERSET of the one E3017 reads — a conformance the report can see and this cannot
	// means the refusal is withheld and nothing replaces it. `sweptConformanceIndex` alone is a strict SUBSET:
	// it holds the declarations' own clauses and an extension's unconditional `implements`, never a
	// conditional one (`extensionDeclaredConformances` holds every extension's). A weaker index yields MORE
	// `unmet` verdicts, not fewer.
	//
	// A base with no `where` clause — the whole non-generic-witness corpus — reads the SHARED empty
	// constraint list and iterates zero times.
	function instantiationViolatesItsOwnWhereClause(id GenericInstanceId) returns bool
		let constraints = self.structWhereConstraints(self.genericInstanceBaseName(id))

		for i in 0 upto constraints.count() 'eachConstraint'
			let constraint = try constraints.get(i) otherwise panic("ProgramSignatures.instantiationViolatesItsOwnWhereClause: whereConstraints.get OOB at {i} below count {constraints.count()}")

			if instantiationMeetsConstraint(self, interfaces: self.settledDeclarations().interfaces, declared: self.sweptConformanceIndex(), gid: id, constraint: constraint) 'metByADeclarationClause'
				continue
			end 'metByADeclarationClause'

			// The two indexes are asked separately rather than unioned into one map because
			// `typeDeclaresInterface` is a per-declared-name existential (a direct hit, else an `extends`
			// walk), so the OR of the two answers IS the answer over the union — and a union map would be an
			// allocation on a path every clean compile also walks.
			if instantiationMeetsConstraint(self, interfaces: self.settledDeclarations().interfaces, declared: self.settledDeclarations().extensionDeclaredConformances, gid: id, constraint: constraint) 'metByAnExtensionClause'
				continue
			end 'metByAnExtensionClause'

			return true
		end 'eachConstraint'

		return false
	end 'instantiationViolatesItsOwnWhereClause'

	// The chain form of the question above: `id` itself, or any instantiation it was substituted out of.
	// A `Set with (Array with Opaque)` mints `Array with (Array with Opaque)` for its buckets, and it is the
	// SET's clause that the program violated — the array the substitution minted violates nothing and has no
	// clause of its own to violate.
	function instantiationChainViolatesItsWhereClause(id GenericInstanceId) returns bool
		for gid in self.instantiationOriginChain(id) 'eachHop'
			if self.instantiationViolatesItsOwnWhereClause(gid) 'refusedAtThisHop'
				return true
			end 'refusedAtThisHop'
		end 'eachHop'

		return false
	end 'instantiationChainViolatesItsWhereClause'

	function declaredSlotTypeOfField(structName ByteArray, fieldName ByteArray) returns MaxonType throws AbsentError
		let layout = try self.registeredLayout(structName) otherwise throw AbsentError.absent
		let index = try layout.indexOfField(fieldName) otherwise throw AbsentError.absent

		return self.declaredSlotType(try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.declaredSlotTypeOfField: fieldTypes.get OOB at {index} despite index < fieldCount"), into: self.typeNames, slotScopeFilePath: layout.declFilePath)
	end 'declaredSlotTypeOfField'

	// Is instance field `index` a managed record once its args are substituted — the per-field drop gate's
	// managed half, to which `genericInstanceFieldOwesDrop` adds a promise.
	// A type-PARAMETER field is dropped iff its substituted argument is a HEAP AGGREGATE (`typeIsManaged`), the
	// SAME gate a DIRECT field uses. That is DELIBERATELY BROADER than the CONSUME boundary (`typeArgIsOwned`):
	// a trivial `Box with Point` is CO-OWNED, not consumed — its `Point` is `__mm_retain`'d at the FEED
	// (`Parser.coOwnConcreteAggregateFeed`), so the box holds a real second reference the caller keeps
	// usable (`generic-trivial-struct-arg`), and this decref RELEASES that reference at the box's destruction.
	// The retain and this drop are the two ends of one co-ownership (the `__mm_retain` thesis applied to
	// the generic-field escape — the RED `PointBox.create(pInner)` outliving `pInner`'s scope). The two
	// classifiers therefore differ exactly on a trivial struct/instance: consumed = borrowed-and-kept, dropped =
	// co-owned. A managed argument (`String`, an owning struct) is BOTH consumed and dropped, unchanged; a
	// scalar is neither.
	//
	// ⚠ **THE OPAQUE COLUMN'S TWIN OF THIS GATE IS `managedOpaqueArrayElementOf`, and it reads this
	// boundary too**, not the CONSUME one, or a `Map with (Point, …)` retains keys no column walk
	// releases. Both read `typeIsManaged` of the substituted argument — that header carries the
	// measurement.
	//
	// A shared-body reassignment keeps this balance only because its old-value drop
	// (`genericTypeFieldHasManagedInstantiation`) reads this boundary as well as the CONSUME one; on the
	// consume boundary alone it would leak every displaced co-owned trivial value.
	//
	// ⭐ **IT ASKS THE INSTANCE VIEW FOR *EVERY* FIELD, NOT ONLY FOR AN OPAQUE ONE.** Substituting only
	// a `typeParameter` field and reading the RAW declared type otherwise is two derivations that agree by
	// accident, because a `named` struct, a generic alias and a `genericInstance` are all managed in either
	// view. But the drop CALLEE (`genericInstanceFieldDropCallee`) and the drop KIND
	// (`genericInstanceFieldIsExistential`) both read the substituted type, and a third reading of the same
	// column is MEASURED: the alias arm resolves `Holder.Inner` to the unsubstituted `Cell with Holder.T` and
	// leaks (see `substituteInstanceFieldType`). One derivation, so the three cannot classify three types.
	export function genericInstanceFieldIsManaged(id GenericInstanceId, index FieldIndex) returns bool
		return self.typeIsManaged(self.substituteInstanceFieldType(id, index: index), from: self.typeNames)
	end 'genericInstanceFieldIsManaged'

	export function genericInstanceFieldOwesDrop(id GenericInstanceId, index FieldIndex) returns bool
		return self.typeOwesDrop(self.substituteInstanceFieldType(id, index: index), from: self.typeNames)
	end 'genericInstanceFieldOwesDrop'

	// The drop callee for managed instance field `index` — routed through the shared `managedFieldDropCallee`
	// over the SUBSTITUTED concrete type (a String → `__str_decref`, a struct/boxed-union → its
	// `__destruct_<T>`, a nested instance → its instance destructor). Precondition: the field is managed.
	export function genericInstanceFieldDropCallee(id GenericInstanceId, index FieldIndex) returns immutable ByteArray
		return managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: self.substituteInstanceFieldType(id, index: index))
	end 'genericInstanceFieldDropCallee'

	// ⭐ **THE CLONE TWIN OF `genericInstanceFieldDropCallee`**, routed through the SAME shared
	// `managedFieldCascadeStrategy` over the SAME substituted type — so a field the per-instance cloner copies is
	// a field the per-instance destructor releases, which is the property `ManagedCascadeStrategy`'s own header
	// calls for (a clone leaks if it is not dropped and double-frees if it is dropped twice, and ONE classifier
	// decides both). Precondition: the field is managed.
	export function genericInstanceFieldCascadeStrategy(id GenericInstanceId, index FieldIndex, action CascadeAction) returns ManagedCascadeStrategy
		return managedFieldCascadeStrategy(self, typeNames: self.typeNames, fieldType: self.substituteInstanceFieldType(id, index: index), asElement: false, action: action)
	end 'genericInstanceFieldCascadeStrategy'

	// ⭐⭐ **THE `(box) -> newBox` DEEP CLONE AN INSTANCE BOX TAKES — the copy a DURABLE SINK stamps into
	// `__mm_own_deep`.** It is `instanceCascadeStrategy`'s own answer, so a box copied at a sink and the same
	// box copied as a FIELD of some other record cannot be copied by two entries.
	//
	// The refusal is an invariant break rather than a reachable case: only an instance
	// `declaredContainerBoxIsImageData` admitted reaches this door, and that predicate already requires the
	// base layout `instanceCascadeStrategy` needs to answer `direct`.
	export function genericInstanceBoxCloneCallee(id GenericInstanceId) returns immutable ByteArray
		match instanceCascadeStrategy(self, id: id, asElement: false, action: CascadeAction.clone) 'strategy'
			direct(callee) then return callee
			managedElements then panic("ProgramSignatures.genericInstanceBoxCloneCallee: instance {id} copies through an element-bearing record's 2-argument entry, which no box co-own can call — `declaredContainerBoxIsImageData` admits no `Array`/chain box")
			unsupported or
			throughWitness then panic("ProgramSignatures.genericInstanceBoxCloneCallee: instance {id} has no deep cloner — `declaredContainerBoxIsImageData` requires the base layout that `__clone_<mangled>` cascades over")
		end 'strategy'
	end 'genericInstanceBoxCloneCallee'

	// Is substituted instance field `index` an existential — `structFieldIsExistential`'s instance twin, asked
	// over the SUBSTITUTED type for `genericInstanceFieldDropCallee`'s reason: the drop KIND and the drop
	// CALLEE must classify one type. A type ARGUMENT can never be an existential (`checkGenericArgType`
	// refuses one), so this only ever answers `true` for the base struct's own interface-typed field.
	export function genericInstanceFieldIsExistential(id GenericInstanceId, index FieldIndex) returns bool
		return maxonTypeTag(self.substituteInstanceFieldType(id, index: index)) == ValueTypeTag.interfaceRef
	end 'genericInstanceFieldIsExistential'

	// Does ANY field of instance `id` owe a drop once substituted (`typeOwesDrop`: a managed record or a
	// promise) — the gate deciding whether it needs a `__destruct_<instance>` cascade at all (else its box
	// drop is the trivial `__mm_decref`).
	export function genericInstanceOwesADrop(id GenericInstanceId) returns bool
		// A base-layout-less instance owns no field this cascade could drop. An `Array`/`Set` instance is
		// dropped through its own box-drop callee (`__managed_decref` / a `__destruct_<T>` cascade, routed by
		// `genericInstanceBoxDropCallee`), NOT a synthesized per-instance `__destruct_<mangled>`, so `false`
		// is the ANSWER and not a dodge; an UNDECLARED base has no fields at all. Either way the walk below
		// would read a layout that does not exist — see `genericInstanceHasBaseLayout`.
		//
		// ⚠⚠ **THE EARLY-OUT IS THIS WALK'S STRUCTURAL PRECONDITION, AND IT IS MEASURED RATHER THAN
		// CAUTIOUS.** Every walk over an instance's substituted fields owes it — the two destructor passes
		// (`MmRuntime.addNestedInstanceDestructors`, `MmRuntime.declareInstanceFieldDropNeeds`) reach one for
		// ANY instance whose `__destruct_<mangled>` is in the needed set, base struct or no base struct.
		// Measured on a compiler that had the guard on only one of a pair of such walks:
		// `panic ProgramSignatures.baseLayoutOf: generic instance 3's base struct 'Array' is not declared` —
		// a stack trace with no diagnostic at all.
		//
		// ⚠ The ROUTE that reaches it is closed by the reserved-space disjointness, and the guard stays
		// anyway. The route is a NAME collision: the needed set is keyed by symbol, so a declared
		// `type Array_Foo` owning a String puts `__destruct_Array_Foo` there and pulls the base-less
		// `Array with Foo` instance in behind it. That instance is `__Array_Foo` (`reservedIfDeclared`),
		// so the two names cannot meet — but the guard is the walk's precondition, not a patch on that one
		// route, and `declared-type-owning-a-string-named-like-an-array-instance` is the case that
		// re-measures it.
		if not self.genericInstanceHasBaseLayout(id) 'noFields'
			return false
		end 'noFields'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if self.genericInstanceFieldOwesDrop(id, index: i) 'owesADrop'
				return true
			end 'owesADrop'
		end 'eachField'

		return false
	end 'genericInstanceOwesADrop'

	// ⭐ **THE DROP CALLEE FOR AN OWNED INSTANCE BOX** — its own `__destruct_<mangled>` cascade when it owns
	// managed heap, else the trivial `__mm_decref`. The generic-instance twin of `unionBoxDropCallee`, and
	// the door `decrefCalleeFor` (a scope-exit drop) and a nested-instance field drop route through — over
	// this index's own interner, so a caller never misresolves the instance's substituted-field ids.
	export function genericInstanceBoxDropCallee(id GenericInstanceId) returns immutable ByteArray
		// ⭐⭐ **A PROMISE DROPS THROUGH `__gt_promise_drop`, AND IT IS THE ONE ARM HERE THAT IS NOT A BOX.**
		// Every other instance below names an `__mm` record and a refcount entry to release it with; a promise
		// names a green thread, and reclaiming it means unlinking it from the run queue or the timer store,
		// freeing its stack and CANCELLING it — which is what that entry does. Routing it to any of the
		// refcount entries would call `__mm_decref` on a pointer into the scheduler's slab, decrementing a
		// word that is not a refcount.
		//
		// ⚠ **IT IS FIRST DELIBERATELY.** The arms below are keyed on base-name predicates a promise answers
		// `false` to, so order is not load-bearing today — but this is the arm whose MISS is silent (a promise
		// falling through to the struct cascade drops a thread as though it were a record), and the cheapest
		// place to make that unrepresentable is the top.
		if self.instanceIsPromiseHandle(id) 'promise'
			return GtPromiseDropName
		end 'promise'

		// The managed buffer record (an `Array` or a `FixedArray`) drops through `__managed_decref`, which frees its
		// external element buffer — the one thing a generic `__mm_decref` cannot reach — and then the record.
		if self.isManagedBufferRecordInstance(id) 'managedBuffer'
			return ManagedDecrefName
		end 'managedBuffer'

		// A `__ManagedList` drops through `__list_decref`, the teardown that walks its nodes. A declared `List`,
		// `Set` or `Map` drops through its own `__destruct_<mangled>` cascade, which reaches the chain through its
		// field.
		if self.isManagedListInstance(id) 'managedList'
			return ListDecrefName
		end 'managedList'

		// ⭐ **A CURSOR DROPS THROUGH `__managed_cursor_decref` — the one builtin whose box owns a RECORD rather
		// than a buffer.** It releases the source it retained at creation (through `__managed_decref`, which is
		// what frees that record's own element buffer and walks its managed elements) and then reclaims the
		// 16-byte box. A generic `__mm_decref` here would free the cursor and strand the source's whole
		// allocation — the leak this router's fall-through panic exists to prevent.
		if self.isManagedMemoryCursorInstance(id) 'managedMemoryCursor'
			return ManagedCursorDecrefName
		end 'managedMemoryCursor'

		// ⭐⭐ **A NODE HANDLE DROPS THROUGH `__list_node_decref`, WHICH RELEASES THE NODE ITSELF.** Nodes are
		// refcounted and a handle is a second owner (rc=2). At the last owner that entry calls the node's own
		// stamped `element_drop@24`
		// and frees it; every unlink — `remove`, `clear`, the teardown walk — merely drops the CHAIN's reference.
		//
		// ⛔ **IT IS NOT A PANIC: *"the list owns its nodes and frees them in `__list_clear`,
		// so a node reaching this door was enrolled as an OWNED value and would be freed twice"* IS FALSE
		// IN BOTH HALVES.** `__list_clear` frees no node, and a node reaching
		// this door is enrolled as an owned value on purpose. ⚠ It is NOT `__mm_decref`: that frees the payload
		// and walks nothing, which would leak every managed element a surviving node still holds.
		if self.isManagedListNodeInstance(id) 'managedListNode'
			return ListNodeDecrefName
		end 'managedListNode'

		if self.instanceBaseIsSharedValue(id) 'sharedValue'
			return SharedValueBoxDropName
		end 'sharedValue'

		// ⭐ **THE OMISSION A ROUTER WOULD OTHERWISE SWALLOW, MADE LOUD** — its two sibling routers
		// (`builtinGenericTypeParamCount`, `genericInstanceBoxSize`) panic on a builtin they have no arm
		// for, and so does this one. A builtin base has NO layout, so `genericInstanceOwesADrop`
		// answers `false` for it by its own early-out and a fallthrough would hand back `__mm_decref` — which frees
		// the record and walks NOTHING, leaking every buffer, node and managed element the container links. A
		// leak with no diagnostic, in the one family where a fifth container is the expected next change.
		if self.isBuiltinGenericBaseName(self.genericInstanceBaseName(id)) 'builtinOwesADropCallee'
			panic("ProgramSignatures.genericInstanceBoxDropCallee: `{String.from(self.genericInstanceBaseName(id))}` is a synthesized builtin container with no drop-callee arm — a builtin's record is never reclaimed by __mm_decref, which would free the box and leak everything it links")
		end 'builtinOwesADropCallee'

		// A generic service's handle lands here, and it carries its instantiation, so the tag decides and no
		// name is asked. Its one field is the cown word (`buildServiceHandleStruct` panics on a second), so
		// it takes the plain decref, and the box's own destructor releases the cown.
		if self.genericInstanceOwesADrop(id) 'managed'
			return destructorSymbol(self.mangleGenericInstance(id))
		end 'managed'

		return MmDecrefName
	end 'genericInstanceBoxDropCallee'

	function dropDivergesOverTheRows(declaringTypeName ByteArray, index FieldIndex, sharedCallee ByteArray) returns bool
		for position in 0 upto self.genericInstanceCount() 'eachInstance'
			let id = self.rowIdAt(position)

			if not self.genericInstanceBaseName(id).equals(declaringTypeName) 'anotherBase'
				continue
			end 'anotherBase'

			// A layout-less instance of this base cannot exist (the name is a declared `type`), so the guard is
			// the walk's stated precondition rather than a case — `genericInstanceHasBaseLayout`'s rule, asked
			// where every other instance-field walk asks it.
			if not self.genericInstanceHasBaseLayout(id) 'noFields'
				continue
			end 'noFields'

			if not self.genericInstanceFieldOwesDrop(id, index: index) 'thisInstantiationOwesNoDrop'
				return true
			end 'thisInstantiationOwesNoDrop'

			if not self.genericInstanceFieldDropCallee(id, index: index).equals(sharedCallee) 'aDifferentCallee'
				return true
			end 'aDifferentCallee'
		end 'eachInstance'

		return false
	end 'dropDivergesOverTheRows'

	// Does instance `id`'s type argument at `position` OWN managed heap — the CALL-SITE CONSUME gate.
	// An owning argument is MOVED into the box (the box drops it, so the caller must not); a trivial argument
	// is BORROWED (`PointBox.create(p)` keeps `p` usable). It reads exactly
	// the `typeArgIsOwned` boundary the destructor drops on, so the consumed set equals the dropped set by
	// construction — no double-free, no leak.
	export function genericInstanceArgIsOwned(id GenericInstanceId, position ElementIndex) returns bool
		let args = self.rowArgs(id)

		if position >= args.count() 'oob'
			return false
		end 'oob'

		return self.typeArgIsOwned(try args.get(position) otherwise panic("ProgramSignatures.genericInstanceArgIsOwned: instanceArgs.get out of range at {position} despite position < count"))
	end 'genericInstanceArgIsOwned'

	// The number of interned generic instances — the iteration bound the B2 destructor-synthesis and
	// needs-closure passes walk (`0 upto genericInstanceCount()` enumerates every gid).
	export function genericInstanceCount() returns GenericInstanceId
		return self.rowCount()
	end 'genericInstanceCount'

	// The enum/union `name` denotes, declared in ANY file — `structOf`'s twin, and the door the
	// PARSER asks every enum question through: is this scrutinee an enum? what tag is a case? which
	// cases does an arm cover? The layout it hands back carries plain NAMES and INTS (no ids),
	// so every one of those questions is answered with no interner at all.
	export function enumInAnyFile(name ByteArray) returns DeclaredEnum
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise return DeclaredEnum.undeclared
		return DeclaredEnum.declared(layout)
	end 'enumInAnyFile'

	// The tag of the number behind a `named` value as `readerFilePath` reads it: `structRef` for a union,
	// `float` for a float-backed enum, `named` for anything else, including a name an alias answers for
	// in that file. A name nothing declares as an enum answers `named`: this is asked of every `named` value
	// in the program, and "there is no such enum" is not this answer's to report.
	//
	// ⚠ Read from `enumTypes` directly, not through `enumFor`, which boxes a `DeclaredEnum` — a heap object
	// even for `undeclared` — on a path that runs for both operands of every binary operator and
	// comparison and for every interpolation hole.
	export function enumOperandTagFor(name ByteArray, readerFilePath FilePath) returns ValueTypeTag
		if self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath) 'anotherDeclarationAnswersHere'
			return ValueTypeTag.named
		end 'anotherDeclarationAnswersHere'

		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise return ValueTypeTag.named

		if layout.isUnion 'aUnion'
			return ValueTypeTag.structRef
		end 'aUnion'

		return ValueTypeTag.float if layout.backing == EnumBacking.float else ValueTypeTag.named
	end 'enumOperandTagFor'

	// ⭐⭐ **WHICH DECLARATION FORM MINTED `name` — the ONE name→FORM answer, so a new form is a COMPILE ERROR
	// at every door that classifies a name instead of a coverage gap nothing reports.**
	//
	// Four doors would otherwise carry their own cascade over these registries — `denotedSlotType`,
	// `typeIsManaged`, `managedNameDropCallee` and `managedNameCascadeStrategy` — asking their registries in
	// DIFFERENT ORDERS, half of that residue safe by construction and half not, which is the whole reason
	// this exists:
	//
	//   • **The COVERAGE could disagree, and the failure had a definite shape.** A form taught to one door and
	//     not another reads MANAGED there and `false` here, so the field is moved in and **dropped by
	//     NOBODY** — a leak, exit 101 — while the converse double-frees. That is what this function closes.
	//   • **The ORDERS were held to be safe by construction, and MEASURING IT SHOWED THEY ARE NOT.** The
	//     argument was that an order decides something only for a name held by TWO registries at once, and no
	//     legal program can spell one: a second declaration of a type name is **E3006** and two `typealias`
	//     declarations of one name are **E3061**. Both codes exist and both fire — but they are reported by a
	//     whole-program CHECK that runs *after* these classifiers have already answered during the parse. So
	//     an ILL-FORMED program does put one name in two registries here, and the order picks between them.
	//
	// ⚠⚠ **THAT IS WHY DECLARED TYPES ARE ASKED BEFORE ALIASES, AND THE ORDER IS NOT A COST CHOICE.**
	// MEASURED on this branch, with the aliases asked first: `type Box … end` + `typealias Box = int(0 to 10)`
	// — `specs/type-name-collision.md`'s `error.type-then-typealias`, whose whole subject is that E3006
	// catches it — reached `Parser.decrefCalleeFor` for the STRUCT box it had just built, was told `Box` is a
	// ranged typealias, and **PANICKED inside `managedNameDropCallee` before E3006 could be printed**. Every
	// door's previous cascade asked `structTypes` ahead of every alias registry, so type-first is also the
	// order that leaves an ill-formed program on exactly the path it was already on until its diagnostic
	// lands. Within each group the order IS free, and is by expected frequency.
	//
	// ⚠⚠ **THIS IS THE ONE PLACE A NEW REGISTRY MUST BE TAUGHT, AND `TypeDeclKind` IS THE ONE PLACE A NEW
	// FORM MUST BE.** The guarantee the doors get is over `TypeDeclKind`'s CASES: add a case and every `match`
	// below fails to compile until it is handled. It is NOT over registries — a form recorded in a registry
	// this function never asks would answer `undeclared` at every door, silently. So a change that adds a
	// registry adds its arm HERE, in the same edit.
	//
	// ⚠ **NO RANGE ARMS OVER `TypeDeclKind` AT ANY DOOR, and that is a rule with teeth rather than taste.**
	// `typeDeclKeyword` and `isTypeAliasDecl` (`Project.maxon`) both use `rangedAlias to tupleAlias`, which
	// silently swallows a case inserted between the endpoints — the invariant `TypeDeclKind`'s own comment
	// records. A door that spelled a range would give up exactly the guarantee this function exists to
	// provide, so every arm below and at every reader is written out, including the ones that agree.
	//
	// ⚠ **IT IS ANSWERED ALLOCATION-FREE** — a payload-free enum is a scalar and every probe is a
	// `Map.contains` — because `typeIsManaged` reads it and must reach its `false` for a scalar field without
	// boxing (see that function's header, which prices the alternative).
	//
	// It THROWS for a name no registry holds rather than carrying an `undeclared` case, because that is not a
	// declaration FORM and `TypeDeclKind` may not gain one: `denotedSlotType` already answers exactly this way
	// (`MapError.keyNotFound`), and each door's fallthrough — an `adoptType` there, an enum lookup at the
	// payload classifier, `false` here — is the rest of the answer rather than a recovery path.
	// ⭐⭐ **WHAT `readerFilePath` MEANS BY THIS NAME — the cascade below, with the cross-KIND contest
	// applied.** Once a `type Box` in one file and a `typealias Box` in another may both stand
	// (`typeNamePairMayCoexist`), a FIRST-MATCH cascade over whole-program registries picks one of them for
	// every reader — the same defect `TypeResolution.denotedNamedType`'s arm order had, one registry family
	// over, and it is what made a union PAYLOAD declared `FullRangeInt` inside `stdlib/Builtins.maxon` a
	// user program's struct (E3005 at `__Builtins.bitsToFloat`, inside a library file). `crossKindContested`
	// is an empty-map probe in every program that contests nothing.
	//
	// ⚠ **THE DOOR TO ASK IS THE ONE THAT MATCHES THE QUESTION, AND THERE ARE TWO QUESTIONS.** This one is
	// *"what does this NAME mean HERE"* — a declared slot's type, a constant's field type. The other is
	// `declaredFormInAnyFile`: *"which registry holds this aggregate"*, asked by the memory-management
	// routers about a name their caller has ALREADY classified managed. Handing the MM tier this door was
	// measured and it PANICKED: `managedNameDropCallee` was told `FullRangeInt` was a ranged typealias — "a
	// scalar, which `typeIsManaged` never classifies managed" — for a value the parser had correctly typed
	// as the user's struct, because the MM tier has no reading file and took the stranger's tier.
	export function declaredFormOf(name ByteArray, readerFilePath FilePath) returns TypeDeclKind throws MapError
		if self.crossKindContested(name) 'severalKindsHoldIt'
			return self.contestedTypeNameKindFor(name, readerFilePath: readerFilePath)
		end 'severalKindsHoldIt'

		return try self.declaredFormInAnyFile(name)
	end 'declaredFormOf'

	// ⭐ **WHICH REGISTRY HOLDS `name` — first match, whole-program, no reader.** THE one cascade; the
	// reader-aware door above is this one plus the contest, so the two can never disagree about where a kind
	// lives.
	//
	// ⚠ **ITS CALLERS ARE THE ONES WITH NO READING FILE AND NO NEED OF ONE**: the memory-management routers
	// and the managed classifiers, which ask about a name the front end has already accepted and typed, and
	// which need the AGGREGATE registries' answer rather than what some file means by the spelling. The
	// struct arm is first, which is why a coexisting `type`/`typealias` pair answers `structType` here — the
	// only kind that can own a record, and therefore the only one the caller could have been asking about.
	export function declaredFormInAnyFile(name ByteArray) returns TypeDeclKind throws MapError
		if self.hasRegisteredLayout(name) 'structType'
			return TypeDeclKind.structType
		end 'structType'

		return try self.declaredFormPastStructTypes(name)
	end 'declaredFormInAnyFile'

	function declaredFormPastStructTypes(name ByteArray) returns TypeDeclKind throws MapError
		if let enumLayout = try self.settledDeclarations().enumTypes.get(name) 'enumOrUnion'
			return TypeDeclKind.unionType if enumLayout.isUnion else TypeDeclKind.enumType
		end 'enumOrUnion'

		if self.settledDeclarations().interfaces.entries.contains(name) 'interfaceType'
			return TypeDeclKind.interfaceType
		end 'interfaceType'

		if self.settledDeclarations().typeAliases.containsInAnyFile(name) 'rangedAlias'
			return TypeDeclKind.rangedAlias
		end 'rangedAlias'

		if self.settledDeclarations().genericAliases.contains(name) 'genericAlias'
			return TypeDeclKind.genericAlias
		end 'genericAlias'

		if self.holdsTupleAlias(name) 'tupleAlias'
			return TypeDeclKind.tupleAlias
		end 'tupleAlias'

		if self.settledDeclarations().functionTypeAliases.contains(name) 'functionAlias'
			return TypeDeclKind.functionAlias
		end 'functionAlias'

		throw MapError.keyNotFound
	end 'declaredFormPastStructTypes'

	// Is `name` a declared enum/union — the `bool` half of `enumOf`, and a HOT-PATH allocation guard.
	// `enumOf` returns a `DeclaredEnum`, a Maxon union VALUE that allocates a heap box on its
	// `undeclared` case as much as any other, so a caller that only needs "is it an enum?" for the
	// COMMON no answer (`parseDottedPrimary` asks it of every `Point.create(…)` static call) must not
	// pay `enumOf`'s box just to throw it away. A `Map.contains` allocates nothing.
	// The `containsStructInAnyFile` warning, one registry over — see there for why the name carries it.
	export function containsEnumInAnyFile(name ByteArray) returns bool
		return self.settledDeclarations().enumTypes.contains(name)
	end 'containsEnumInAnyFile'

	export function enumNameIsBoxed(name ByteArray) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise return false
		return layout.carriesPayloads()
	end 'enumNameIsBoxed'

	// ⭐ **THE ONE RUNTIME ENTRY THAT DROPS AN OWNED BOX OF UNION `unionName`** — `__destruct_<U>` for a
	// managed-payload union (its own tag-conditional cascade), the trivial `__mm_decref` for a scalar-only
	// one. BOTH doors that ask it come here: `decrefCalleeFor`'s scope-exit drop of a boxed union, and
	// `managedNameDropCallee`'s union arm for a boxed-union FIELD.
	//
	// ⚠ **IT TAKES A NAME, NOT A LAYOUT AND AN INTERNER, AND THAT IS THE WHOLE POINT.** The payload types
	// are resolved against `self.typeNames` — the interner they were minted against (a signatures layout's
	// payload ids live here, remapped in by `remapEnumLayoutPayloadTypes`) — and the interner is NOT the
	// caller's to choose. It went wrong TWICE, in the two doors, and each was fixed alone:
	//   • `decrefCalleeFor` passed its own ARTIFACT interner, which misread a managed payload whenever a
	//     ranged alias perturbed the interning order — `__mm_decref` for a managed-payload union (a LEAK) or
	//     a wrong `__destruct_<T>` (a wild-free).
	//   • `managedNameDropCallee`'s union arm passed the caller's `project.typeNames` against a SIGNATURES
	//     layout, which cross-file read a ranged-alias payload as MANAGED and demanded a `__destruct_<U>`
	//     that `installUnionDestructors` — asking over the correctly-paired PROJECT layout — never
	//     synthesized: `bl to unknown function '__destruct_Payloaded'`, a compiler panic on a valid
	//     two-file program. See `unionHasManagedPayload`.
	// One fact was spelled twice and only one copy was ever repaired. Taking the NAME leaves nothing for a
	// caller to get wrong, so the second copy cannot come back.
	//
	// The union is a precondition, not a case: both callers reached here through an `enumOf` that answered
	// `declared`.
	export function unionBoxDropCallee(unionName ByteArray) returns immutable ByteArray
		return destructorSymbol(unionName) if self.unionHasManagedPayload(unionName) else MmDecrefName
	end 'unionBoxDropCallee'

	// The DECLARED type of field `index` of struct `structName`, ADOPTED into `into` — the calling
	// file's own artifact interner. `returnTypeOf`'s exact shape and exact reason: a `named` type
	// crosses by NAME and is re-interned on arrival, so the id the parser stores is one its own
	// file's merge will resolve.
	//
	// ⚠ **IT TAKES THE LAYOUT AND NOT THE STRUCT NAME — see `fieldSurfaceOf` below for the measurement.**
	// EVERY caller reached this door holding the layout already (it is `emitFieldLoad`'s own parameter, and a
	// `FieldChainStep` carries one), so passing the NAME asked `structTypes` — a NAME-KEYED map — to hash a
	// string per field access to find a record the caller had in hand. For a TUPLE, whose canonical name grows
	// with its arity, that made a W-slot tuple read W times cost O(W²) bytes hashed.
	//
	// The index is a precondition, not a case: `index` is one `indexOfField` handed out.
	//
	// ⭐ **A FIELD TYPED BY A BARE GENERIC NAME IS ALREADY AN INSTANCE BY THE TIME THIS IS ASKED** — `var cell
	// as Cell` inside `type Holder uses T` is a `Cell with Holder.T`, and the column carries exactly that,
	// because `normalizeSweptScopedGenericFields` recorded it once with every file folded. This function used
	// to hold that rule INLINE, which made it the field READ's private answer to a question the drop cascade
	// and the clone gate ask of the same column — and the cascade, reading the raw swept `named`, dropped a
	// `Holder with String` through the base `Cell`'s classification and stranded the string (exit 101). One
	// recorded answer replaced three derivations; see that normalization for the measurement.
	//
	// ⛔ **`layout` IS ONE THIS INDEX HOLDS — its field-type ids index `self.typeNames`.** A file artifact's
	// copy (`adoptTupleLayout`, and every layout `remapArtifact` rewrites) carries the same names under
	// another numbering, and an id read against the wrong table answers a wrong NAME rather than a miss —
	// which is why `Parser.internTupleLayout` hands back the index's layout and not the copy it files.
	export function fieldTypeOf(layout StructLayout, index FieldIndex, into TypeNameInterner) returns MaxonType
		let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.fieldTypeOf: field {index} is out of range for `type {String.from(layout.name)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")

		return self.declaredSlotType(declared, into: into, slotScopeFilePath: layout.declFilePath)
	end 'fieldTypeOf'

	export function declaredFieldTypeName(layout StructLayout, index FieldIndex) returns immutable ByteArray throws MapError
		let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.declaredFieldTypeName: field {index} is out of range for `type {String.from(layout.name)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")

		if maxonTypeTag(declared) != ValueTypeTag.named 'namesNoAlias'
			throw MapError.keyNotFound
		end 'namesNoAlias'

		return self.nameOfId(typeNameIdOf(declared))
	end 'declaredFieldTypeName'

	// ⭐ **THE `Base with Args` INSTANCE AN INTERFACE-TYPED FIELD WAS DECLARED AT** — the field's twin of
	// `Parser.paramExistentialSitesOf`, read off the declared SPELLING the layout keeps, because the field's
	// type says only `interfaceRef(Base)`. An inner alias of the declaring type shadows a file-scope one of the
	// same spelling, the order `Parser.declaredExistentialInstanceAt` resolves a parameter's by. Empty for a
	// field that named no generic alias, which is every field but a parameterized existential's.
	export function fieldExistentialSites(layout StructLayout, index FieldIndex) returns GenericInstanceIdArray
		match layout.fieldSpelledName(index) 'spelling'
			unnamed then return GenericInstanceIdArray.create(0)
			named(name) then return self.existentialSitesSpelled(name, layout: layout)
		end 'spelling'
	end 'fieldExistentialSites'

	function existentialSitesSpelled(spelled immutable ByteArray, layout StructLayout) returns GenericInstanceIdArray
		let inner = joinQualifiedName(layout.name, member: spelled)
		let key = inner if self.declaresInnerAlias(inner) else spelled

		if not self.isAliasOfFormFor(key, readerFilePath: layout.declFilePath, wanted: FormAliasKind.generic) 'namesNoInstance'
			return GenericInstanceIdArray.create(0)
		end 'namesNoInstance'

		let sites = GenericInstanceIdArray.create(1, zeroed: false)
		sites.push(self.genericAliasInstanceFrom(key, readerFilePath: layout.declFilePath))
		return sites
	end 'existentialSitesSpelled'

	// ⭐ **THE UNION-PAYLOAD TWIN OF `fieldTypeOf`** — a payload slot's DECLARED type, resolved and
	// ADOPTED into `into`, scoped to the union's own declaring file for the reason `declaredSlotType`'s
	// header gives a struct field.
	//
	// ⛔ **THE THREE PARSER SITES THAT NEEDED IT SPELLED A BARE `adoptType` INSTEAD** — the construct's
	// lowerability check, the match-bind classification, and the payload LOAD's value type — so a payload
	// declared with a generic alias reached each of them still `named`, i.e. an INT. It is here rather
	// than in the parser for `fieldTypeOf`'s reason: the door a payload's type comes out of is a fact
	// about the LAYOUT, so it belongs beside the layout's other one.
	//
	// It takes the LAYOUT and not the union NAME for `fieldTypeOf`'s measured reason: every caller already
	// holds it, and a name-keyed fetch would hash a string per payload to find a record in hand.
	export function payloadTypeOf(field PayloadField, layout EnumLayout, into TypeNameInterner) returns MaxonType
		return self.declaredSlotType(field.declaredType, into: into, slotScopeFilePath: layout.declFilePath)
	end 'payloadTypeOf'

	// ⭐ **THE PRE-ERASURE `__ManagedMemory` SPELLING OF FIELD `index`** — `fieldTypeOf`'s twin
	// for the half a `MaxonType` cannot hold, and the door `Parser.emitFieldLoad` asks at the one site a
	// field read mints its value.
	//
	// ⚠ **THE SPLIT IS BY POSITION, NOT BY BIT, AND IT IS FORCED.** Only the TUPLE-SLOT mask is purely stored:
	// a slot must not consult an alias registry at a sweep-fed door at all, because a tuple's element types
	// are canonical by the time anything could repair one, so its answer would be *how far the sweep had got*
	// (`Parser.declaredSurfaceAt`'s `slotElementsFromAliases`). Both ROOT bits are stored AND derived, and
	// their union is the answer: the sweep can settle a root written with the LITERAL spelling
	// (`var buf as __ManagedMemory` is a token fact), and only the read door can settle one written with an
	// ALIAS — `var bufs as BufArray`, `var buf as ByteBuffer` — since at sweep time that alias is not yet
	// registered. So the derived half runs HERE, where every file is folded, off the alias NAME the swept
	// `named` type still carries.
	//
	// ⚠ **THE ELEMENT BIT ALONE IS NOT ENOUGH, AND THAT IS MEASURED.** *"The outright spelling … the SWEEP
	// could answer"* is true of the literal
	// spelling and FALSE of an alias for it. See `derivedAliasSurfaceBits`.
	//
	// ⚠ **IT TAKES THE LAYOUT AND NOT THE STRUCT NAME, WHICH IS A COST AND NOT A STYLE.** `structSlots` is
	// keyed by NAME, so re-resolving the layout here HASHES that name — and a TUPLE's canonical name grows with
	// its arity, so a W-slot tuple read W times costs O(W²) bytes hashed for a layout `emitFieldLoad` already
	// holds in hand. MEASURED against the name-taking shape: a wide-tuple probe (a W-slot tuple
	// parameter naming no buffer at all, every slot read once), parse CPU ticks minus this compile's ~6.0M
	// floor, interleaved min-of-3 against the merge-base binary —
	//
	//   W        100      200      400      800
	//   base    1.13M    3.25M   10.55M   38.24M     (`fieldTypeOf` alone, hashing the same name)
	//   +this   1.43M    4.28M   15.15M   52.29M     (+0.35M / +1.08M / +4.65M / +14.11M, x3.0 per DOUBLING)
	//   layout  0.89M    2.40M    7.32M   25.01M     (both doors handed the layout: -35% BELOW base)
	//
	// The name is not the caller's fact to give, which is why `fieldTypeOf` takes the layout too.
	//
	// The index is a precondition, not a case, exactly as it is for `fieldTypeOf`.
	export function fieldSurfaceOf(layout StructLayout, index FieldIndex) returns immutable DeclaredSurface
		let declared = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.fieldSurfaceOf: field {index} is out of range for `type {String.from(layout.name)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")

		return self.surfaceWithDerivedAliasBits(layout.fieldDeclaredSurface(index), declared: declared)
	end 'fieldSurfaceOf'

	// ⭐ **THE PRE-ERASURE `__ManagedMemory` SPELLING OF A UNION PAYLOAD** — `payloadTypeOf`'s twin
	// for the half a `MaxonType` cannot hold, and `fieldSurfaceOf`'s twin at the FIFTH declared position. The
	// door `Parser.emitUnionPayloadLoad` asks at the one site a `match` binding mints its value.
	//
	// ⚠ **IT TAKES THE FIELD ALONE where `fieldSurfaceOf` takes a layout and an index**, because a
	// `PayloadField` is a RECORD and not a set of parallel columns: both halves the answer needs — the stored
	// token facts, and the swept `named` the element bit is derived from — arrive in one value, so there is
	// nothing to look up and no pair that can fall out of lockstep.
	export function payloadSurfaceOf(field PayloadField) returns immutable DeclaredSurface
		return self.surfaceWithDerivedAliasBits(field.declaredSurface, declared: field.declaredType)
	end 'payloadSurfaceOf'

	// ⭐ **WHAT A SLOT'S DECLARED TYPE MEANS ONCE THE ALIAS REGISTRIES ARE KNOWN** — the door a struct
	// FIELD and an `Array` ELEMENT both come out of, ADOPTED into `into` (the calling file's own artifact
	// interner) exactly as `returnTypeOf` does.
	//
	// Every re-tag in `denotedSlotType` — the cascade this reads the name for — exists for the same reason:
	// the DECLARATION SWEEP that recorded
	// the slot ran before any alias was interned, so an alias-typed slot arrives as a bare `named` and the
	// registries are the only thing that can say what it is. Leaving one unresolved is not a cosmetic loss
	// — `named` reads as an INTEGER (`tagIsIntegral`), so a function slot admits an int, a generic-instance
	// slot loses its `count()`, and a float slot is stored as raw i64 bits.
	//
	// ⚠ **IT IS ONE FUNCTION BECAUSE THE ELEMENT DOOR HAD A PARTIAL COPY OF IT, AND THE PART THE COPY
	// DROPPED WAS REACHABLE.** `Parser.containerSlotValueType` spelled out the generic-alias re-tag and
	// neither of the other two, so an `Array with <function alias>` element stayed `named` — an INT. It
	// went unnoticed while nothing compared an element against its type; the moment the element-argument
	// check (`Parser.requireContainerElementType`) did, that `named` would have read a pushed function VALUE as
	// a function meeting an int slot and refused a program that must compile. A rule with two homes
	// drifts, and only the newer home's obligations reveal which half the older one was missing.
	//
	// ⚠⚠ **`slotScopeFilePath` IS WHICHEVER FILE *FIXES* THIS SLOT'S TYPE, AND FOR A FIELD THAT IS ITS
	// DECLARING FILE AND NEVER A READER'S — the difference there is a SILENT WRONG ANSWER.** The
	// generic-alias arm resolves a compiler-minted alias — `__ManagedMemory` — whose element is the
	// reader's `Byte` by design, so a range-contested program has two answers to choose from.
	//
	// **THE KINDS OF ASKER, AND WHY ONE PARAMETER SERVES THEM ALL.** They are not separate policies; they are
	// answers to the one question *"whose reading of a contested alias is this slot's identity?"*:
	//
	//   • **A struct FIELD** (`fieldTypeOf`) passes `StructLayout.declFilePath`. A field's type must be ONE
	//     type program-wide: scoped to the reader, file X could build `Holder{buf: <a stride-1 buffer>}` and
	//     file Y read `h.buf.get(0)` at stride 2 over that very record, with no diagnostic anywhere. Scoped
	//     to the declaration, the two files disagree at the CONSTRUCTION — nominally, loudly
	//     (MEASURED, both directions: `E3005 … expected 'Array_Byte$0_1000', got 'Array_Byte$0_255'`
	//     at the construction line, and the narrow declarer's own read striding 1 correctly) — and
	//     every read of the slot strides the way the record was stamped.
	//   • **An `Array` ELEMENT** (`Parser.containerSlotValueType`, `Parser.requireContainerElementType`) passes
	//     the PARSING FILE — which reads as "the reader's" and is not that at all. An array INSTANCE is
	//     declared in no file, so it has no declaring one to ask; what it has is the file its `giid` was
	//     already range-scoped FOR, one line earlier in the same parser, and that file is `self.filePath`.
	//     Passing anything else would let an element disagree with the very instance it was read out of.
	//   • **A GENERIC INSTANCE's TYPE ARGUMENT** (`Parser.slotTypeThroughReceiver`) passes the PARSING
	//     FILE for the `Array` ELEMENT's reason and not the struct FIELD's, and it is the same reason twice
	//     over: an instance is declared in no file, and its `giid` was already range-scoped FOR the reading
	//     file at the receiver's own mint. It is the door a `T`-typed field READ, a `T`-returning METHOD CALL
	//     and a `T`-typed field WRITE all learn what `T` is through, and it reached here as a bare `adoptType`
	//     — see that function for the three faces that cost. ⚠ The WRITE goes through the same door: a
	//     copy of `adoptType(substitutedInstanceArg(…))` beside it, resolved through a SECOND cascade
	//     with no generic-alias arm, turns a `Holder with IntBox` field write into a SCALAR store that
	//     drops nothing and moves nothing in. There is one cascade (`denotedSlotType`).
	//   • **A UNION PAYLOAD** (`payloadTypeOf`, and the classifier itself) passes `EnumLayout.declFilePath`,
	//     the struct FIELD's answer for the struct FIELD's reason — a payload's type must be ONE type
	//     program-wide, and the alias that governs it is the one visible where the UNION was declared, never
	//     where a `match` reads it. It is the SAME file `resolveRecordedGenericAliasTypes` already settled
	//     that payload's recorded column against, so the column and the classifier cannot come to mean
	//     two different declarations of one contested name.
	//   • **A TUPLE element** (`canonicalTupleElement`, `fieldTypeOf` over a tuple layout) passes the file that
	//     WROTE the element list — the sixth kind of asker, and the one this list did not have. A tuple
	//     is declared in no file, so it long carried `CompilerOwnedDeclFilePath`; but a SPELLING has a file
	//     even where a declaration does not, and the stranger's reading of `(Bag, Num)` is a third answer
	//     agreeing with neither declaration of a contested `Bag`. MEASURED: the file declaring `Bag` AND
	//     `Pair = (Bag, Num)` could not construct its own field. See `canonicalTupleElement`.
	//   • **A COMPILER-SYNTHESIZED layout** still carries `CompilerOwnedDeclFilePath`, the same probe a file
	//     declaring none of a contested name makes: a type no source spells resolves like a stranger, which is
	//     the one answer that is the same for every reader of it.
	//
	// ⚠ The parameter is NOT named `declFilePath`, deliberately: the two `Array` ELEMENT sites above have no
	// declaration to name, and a parameter whose name is true at some call sites and false at others is the
	// kind of contract a later edit satisfies literally and breaks in fact. (No COUNT is stated here on
	// purpose — this file has already shipped a wrong call-site count four times, and a number in prose is a
	// second derivation of something `grep -n 'declaredSlotType('` derives correctly every time.)
	export function declaredSlotType(declared MaxonType, into TypeNameInterner, slotScopeFilePath FilePath) returns MaxonType
		if maxonTypeTag(declared) == ValueTypeTag.named 'maybeAlias'
			if let denoted = try self.denotedSlotType(self.nameOfId(typeNameIdOf(declared)), into: into, slotScopeFilePath: slotScopeFilePath) 'theNameDenotesAnotherType'
				return denoted
			end 'theNameDenotesAnotherType'
		end 'maybeAlias'

		let adopted = self.adoptType(declared, into: into)

		if maxonTypeTag(adopted) != ValueTypeTag.genericInstance 'notAnInstance'
			return adopted
		end 'notAnInstance'

		return self.declarationViewOfOwnInstance(MaxonType.genericInstance(self.fileScopedInstance(genericInstanceIdOf(adopted), filePath: slotScopeFilePath)), into: into)
	end 'declaredSlotType'

	// ⭐⭐ **THE CASCADE ITSELF, KEYED BY THE NAME RATHER THAN BY AN ID — SO THE OTHER FAMILY OF ASKER CAN
	// SHARE IT.** `declaredSlotType` above holds an id minted against THIS index's interner; the
	// whole-program payload/field CLASSIFIERS hold one minted against `project.typeNames` or a file
	// artifact's, and an id is only a number without its table (`typeIsManaged`'s header records both
	// directions in which reading it against the wrong one is a silent wrong answer). A name is the one
	// currency both hold, so the cascade lives here and the id-keyed door is a two-line adapter over it.
	//
	// ⛔ **ONE CASCADE, BECAUSE A SECOND ONE'S GAP IS A READ-AFTER-FREE.** A payload classifier
	// resolving a `named` through a cascade of its own with no generic-alias arm files `Holder with
	// IntBox` as `undeclaredName` and takes the SCALAR store, so `h.item = IntBox.create(8)` reads
	// freed memory; a union PAYLOAD declared with a generic alias gets a false `E3011 Unknown type`
	// and a payload the construct never moved in.
	//
	// **`MapError` IS AN ANSWER, NOT A GAP.** Three names denote nothing this door can re-tag, and each is
	// deliberate: a ranged INT alias (its NAME is what carries the range and the signedness — see
	// `isFloatAliasFor`), an enum/union name (a `named` IS its type — a payload-free enum's value is its i64
	// tag and a boxed one's is its box), and a name no file declares (E3011's subject). All three are
	// correctly left as the bare `named` they arrived as, which is why the caller's fallthrough — an
	// `adoptType` here, an enum lookup at the payload classifier — is the rest of the answer and not a
	// recovery path.
	function denotedSlotType(name ByteArray, into TypeNameInterner, slotScopeFilePath FilePath) returns MaxonType throws MapError
		let form = try self.declaredFormOf(name, readerFilePath: slotScopeFilePath)

		match form 'form'
			// ⭐⭐ **A STRUCT-TYPED SLOT (`export var leaf as Leaf`) arrives as a `named` for the reason the
			// alias arms below do** — the SWEEP recorded the declaration before anything could say what the
			// name denoted — and without this re-tag `named` reads as an INTEGER:
			//   • `return self.leaf` from a `returns Leaf` method is `E3005 Cannot return 'int' from
			//     function declared to return 'struct'` — a false reject of a legal program;
			//   • `fieldStorageType` falls through to its undeclared-name recovery and types the field's
			//     `loadIndirect` `integer` (the same machine word, so no emitted byte moves);
			//   • `emitFieldLoad` records the read as a BOXED-UNION candidate, a slot its own header says a
			//     struct field never touches.
			// Re-interned into `into` by NAME exactly as `adoptType`'s `named` arm is.
			structType then return MaxonType.structRef(into.intern(name))

			// An enum/union name denotes nothing this door can re-tag, and that is an ANSWER: a `named` IS
			// its type — a payload-free enum's value is its i64 tag and a boxed one's is its box — so the
			// caller's fallthrough (an `adoptType` at `declaredSlotType`, an enum lookup at the payload
			// classifier) is the rest of the answer rather than a recovery path.
			enumType or
			unionType or

			// ⛔ An interface name must stay a `throw` too, because this door is a read and the slot count
			// is decided in the column. An interface-typed field is re-tagged once, by
			// `normalizeSweptInterfaceTypes`, which goes through `StructLayout.retypeField` and so rebuilds
			// the two-slot prefix sum with it. Answering `MaxonType.interfaceRef` here would hand
			// `Parser.emitFieldLoad` an `interfaceRef` for a field the layout budgeted one slot for: the
			// witness load at `offset + InterfaceWitnessHalfOffset` would read the next field, and every
			// later field's offset would be one slot short — a wrong answer at run time with no compile
			// error anywhere.
			//
			// The `functionAlias` arm below does re-tag, and is safe because it does not change a field's
			// slot count. ⚠ The `genericAlias` arm is only conditionally safe — an instance over an
			// `interface` base denotes an existential too, and that arm says so.
			interfaceType then throw MapError.keyNotFound

			// ⭐ A RANGED alias splits, and it is the ONLY arm that does: the FORM is one declaration
			// (`typealias X = <primitive>(range)`, which is why `TypeDeclKind` holds one case for both,
			// exactly as `typeDeclKeyword` gives all three alias forms one keyword), while what the slot
			// DENOTES differs by the underlying primitive. See `rangedAliasSlotType`.
			rangedAlias then return try self.rangedAliasSlotType(name, slotScopeFilePath: slotScopeFilePath)

			// A FUNCTION-typed slot (`export var op as UnaryOp`) arrives as a `named` — the SWEEP that
			// recorded its declaration ran before the function alias was known — so it is re-tagged
			// `function` HERE. One place, so every reader (a field READ, a `Self{op: op}`
			// construction check, the store-width query, a union PAYLOAD's class) sees a function VALUE and
			// not an int.
			functionAlias then return MaxonType.function(into.intern(self.declaredIdentityOfSpelling(name, declFilePath: slotScopeFilePath)))

			// A GENERIC-INSTANCE-typed slot (`export var ops as IntArray`, an `Array` instance) arrives as a
			// `named` for the same reason a function alias does, and is re-tagged `genericInstance` here.
			// One place, so every reader (a field READ, a `Self{ops: ops}` construction check, the array
			// method dispatch, the drop cascade) sees the instance and not an `int`. The gid is this index's
			// own, needing no interner remap.
			//
			// ⛔⛔ **UNLESS THE BASE IS AN `interface`, IN WHICH CASE IT IS THE ARM ABOVE.**
			// `instanceDenotedType` makes `Seq with Integer` the EXISTENTIAL `Seq`, so a field declared with such
			// an alias is a two-slot fat pointer that `normalizeSweptInterfaceTypes` re-tags through
			// `retypeField` — the same one place, for the same reason. Re-tagging it `genericInstance` here would
			// be the exact wrong answer the `interfaceType` arm's header describes, arriving through the alias
			// spelling instead of the bare one: one slot budgeted, a witness loaded from the next field.
			genericAlias then return try self.slotTypeOfGenericAlias(name, slotScopeFilePath: slotScopeFilePath)

			// ⭐ A TUPLE-ALIAS-typed slot (`export var p as Pair`, `typealias Pair = (Int, Int)`) is
			// re-tagged to the tuple's own `structRef` — the read-side twin of `parseTypeReference`'s
			// tuple-alias arm. A tuple alias mints NO identity of its own, so the tag carries the CANONICAL
			// tuple name and a `Pair`-typed slot and a `(Int, Int)`-typed one are ONE type, which is the
			// whole rule the alias form has.
			//
			// ⚠ **MEASURED** — without it, three of this door's readers answered by the filesystem's
			// walk order: `var p as Pair` was `E3005 cannot assign 'struct' to variable 'p' of type 'int'`,
			// a tuple SLOT spelled `(Pair, Int)` canonicalized to `__Tuple2.Pair.int` and read its own
			// element as an int, and `Array with Pair` refused the `push` of a matching literal — each on a
			// program the other walk order compiled and ran. It is also what retired
			// `classifyUnionPayload`'s own `denotedAggregateName` step: a tuple-alias payload is answered by
			// THIS arm, so the payload door does not pre-resolve a name the shared cascade resolves.
			tupleAlias then return self.tupleAliasDenotedType(name, readerFilePath: slotScopeFilePath, into: into)
		end 'form'
	end 'denotedSlotType'

	// What a slot declared with the GENERIC alias `name` denotes — its instance, or `MapError.keyNotFound`
	// when that instance is an EXISTENTIAL, which this door may not re-tag (see the `interfaceType` arm).
	// It asks `instanceDenotedType`, the one place the `type`/`interface` base split is made, rather than
	// re-testing the base here: a second reading of that split is a field sized one way and read the other.
	function slotTypeOfGenericAlias(name ByteArray, slotScopeFilePath FilePath) returns MaxonType throws MapError
		let denoted = self.instanceDenotedType(self.genericAliasInstanceFrom(name, readerFilePath: slotScopeFilePath), into: self.typeNames)

		if maxonTypeTag(denoted) == ValueTypeTag.interfaceRef 'anExistentialSlot'
			throw MapError.keyNotFound
		end 'anExistentialSlot'

		return denoted
	end 'slotTypeOfGenericAlias'

	// ⭐ What a slot declared with the RANGED alias `name` denotes — the one form whose declaration and whose
	// meaning part company.
	//
	// A ranged FLOAT alias (`export var mass as Weight`) is the one `named` whose VALUE is a genuine f64.
	// Left overloaded it reads as an INTEGER (`tagIsIntegral`), which made `Self{mass: 2.5}` a false E3009 on
	// legal code while `Self{mass: 3}` was admitted unconverted into a slot the store then wrote as an i64.
	// Re-tagged in the ONE door a field's type comes out of, so the construction check, the field READ, the
	// field WRITE and the store-width query all see the float and cannot disagree about it. It returns the
	// bare primitive and interns nothing: a `float` carries no name (`typeNameIdOf` is `UnnamedTypeId`), so
	// there is nothing to adopt. The RANGE is dropped exactly as `TypeResolution.resolveNamedType` drops it —
	// a float alias has no range check today.
	//
	// ⚠ An INT alias is deliberately NOT re-tagged: `named` already reads as an integer everywhere, and its
	// NAME is what carries the range and the signedness that `valueIsUnsigned` and the range checks read off
	// it. So it throws, exactly as the enum/union arms do, and for the same reason — it is an ANSWER.
	function rangedAliasSlotType(name ByteArray, slotScopeFilePath FilePath) returns MaxonType throws MapError
		if not tagIsFloat(maxonTypeTag(try self.aliasUnderlyingFor(name, readerFilePath: slotScopeFilePath))) 'integerAlias'
			throw MapError.keyNotFound
		end 'integerAlias'

		return MaxonType.float
	end 'rangedAliasSlotType'

	// Does field `index` of struct `structName` own DROPPABLE HEAP — a String, a struct, or a
	// payload-bearing (boxed) union? Drives the struct's `__destruct_<T>` drop CASCADE: every field this
	// answers `true` for is freed (through its own destructor / decref) when the struct box is torn
	// down, boxed-union fields included. It is answered ENTIRELY INSIDE this index — over
	// `self.typeNames`, the interner the layout's types were minted against — so it neither re-interns
	// the field type (no `adoptType`, unlike `fieldTypeOf`) nor boxes a
	// `DeclaredEnum`/`DeclaredStruct` to decide struct- or enum-hood: the `contains` guards answer
	// allocation-free, which matters because a scalar field (the overwhelming majority) must reach the
	// `false` return without allocating. A ranged int alias and a payload-free enum are scalars; a
	// `float`/`int`/`bool` is a scalar.
	//
	// The struct and index are preconditions, not cases — every caller reached here through a `structOf`
	// that answered `declared`, and `index` is one `indexOfField` handed out.
	// ⭐⭐ **WHICH OWNERSHIP PROTOCOL CONFORMER `typeName`'s VALUE HALF TAKES — the ONE decision both witness
	// ownership words are derived from**. See `ExistentialOwnershipProtocol` for
	// why it is one decision rather than two agreeing ones.
	//
	// ⚠ **THE BYTE-RECORD BUILTINS ARE ASKED FIRST BECAUSE NO REGISTRY HOLDS THEM.** A `String` or `Character`
	// widened to `Hashable`/`Equatable` is an intrinsic conformance (`isIntrinsicBuiltinConformance`) declared by
	// no file, so `declaredFormOf` answers nothing for it and the managed test below would call the one managed
	// thing in the language unmanaged — a leaked record for every existential-typed String field. `int`, `float`
	// and `bool` fall through to `none`, which is right: their value half is not a pointer at all.
	function existentialOwnershipProtocol(typeName ByteArray) returns ExistentialOwnershipProtocol
		if typeName.equals(StringConformerName) or typeName.equals(CharacterConformerName) 'byteRecord'
			return ExistentialOwnershipProtocol.byteRecord
		end 'byteRecord'

		if not self.declaredNameIsManaged(typeName) 'ownsNothing'
			return ExistentialOwnershipProtocol.none
		end 'ownsNothing'

		return ExistentialOwnershipProtocol.aggregate
	end 'existentialOwnershipProtocol'

	// ⭐⭐ **WHAT A WITNESS TABLE'S `destroyFunc@8` HOLDS FOR CONFORMER `typeName` — or EMPTY when the
	// conformer owns nothing droppable, which the table records as the 0 `__drop_existential` treats as
	// inert.** ONE answer, read by the site that STAMPS the reloc
	// (`LowerMaxonToStd.ensureWitnessTable`), and the stamped reloc is what roots its target
	// (`MmRuntime.noteRelocatedFunctionUsage`), so the symbol a table names and the symbol the pipeline
	// installs cannot come apart — the arrangement `typeParamDropCallee` already has for the layout
	// descriptor's `destroyFunc@40`.
	//
	// ⚠ **`inert` IS THE ANSWER** — "this conformer has no destructor" is a real
	// state of the world with a real encoding in the table (the zero word).
	export function existentialDestroyCallee(typeName ByteArray) returns OwnershipCallee
		match self.existentialOwnershipProtocol(typeName) 'protocol'
			byteRecord then return OwnershipCallee.named(StrDecrefName)

			// The NAME door never answers `bufferRecord` — a generic conformer takes a PER-INSTANCE table
			// (`LowerMaxonToStd.witnessRetainCallee`), so an `Array with X` reaches `instanceDropCallee` and
			// this door sees only non-generic names. The arms share a body rather than one panicking, because
			// what an Array record's drop IS is exactly what an aggregate's is.
			aggregate or
			bufferRecord or
			sharedValue then return OwnershipCallee.named(managedNameDropCallee(self, declaredName: self.denotedAggregateName(typeName)))

			// A conformer whose value half is a green thread releases it the one way a green thread is
			// released. Its `retainFunc@16` twin is 0 — see the protocol arm for why that pair is uneven here.
			greenThread then return OwnershipCallee.named(GtPromiseDropName)
			none then return OwnershipCallee.inert
		end 'protocol'
	end 'existentialDestroyCallee'

	// ⭐⭐ **WHAT A WITNESS TABLE'S `retainFunc@16` HOLDS FOR CONFORMER `typeName`** — the exact dual of
	// the destroy callee above, off the SAME protocol answer, so the two words are non-zero together
	// by construction.
	export function existentialRetainCallee(typeName ByteArray) returns OwnershipCallee
		return retainCalleeForProtocol(self.existentialOwnershipProtocol(typeName))
	end 'existentialRetainCallee'

	// ⭐⭐ **WHAT A LAYOUT DESCRIPTOR'S `retainFunc@64` HOLDS FOR INSTANCE `id`'s TYPE ARGUMENT AT
	// `position`** — the witness table's `retainFunc@16` asked of a generic's type ARGUMENT rather
	// than of an existential's conformer. Same three protocols, same callees, ONE speller
	// (`retainCalleeForProtocol`): the two words answer the identical question — *"how does a body
	// that cannot name this type take a reference to it?"* — and a second spelling is exactly how they
	// would come to disagree about a `String`, the one type whose answer is a COPY rather than an
	// incref.
	//
	// ⚠ **THE PROTOCOL IS READ OFF THE TYPE, NOT OFF A CONFORMER NAME, AND THE TWO ARE NOT INTERCHANGEABLE
	// HERE.** `conformerNameOfType` REDUCES a generic instance to its base (`Array with String` → `Array`,
	// which no `declaredFormOf` holds), because that is right for the CONFORMANCE question; routed through it,
	// a `Holder with (Array with String)` would answer `none` and store an array without a reference. This
	// asks `typeIsManaged`, which is the boundary the concrete record's destructor drops on.
	//
	// `inert` is the ANSWER for an argument that owns no record at all — a scalar, a ranged alias, a
	// payload-free enum: the zero word is what makes `__retain_type_param` inert, exactly as the
	// witness pair's zero makes `__retain_existential` inert.
	//
	// ⚠ **IT IS *NOT* `inert` FOR A "TRIVIAL" ARGUMENT.** An all-scalar STRUCT is trivial in the
	// CONSUME sense and is still a refcounted box, so its answer is `__mm_retain`. This word and
	// `destroyFunc@40` read one predicate (`instanceArgOwesDrop`), so they cannot differ on that
	// class.
	export function typeParamRetainCallee(id GenericInstanceId, position ElementIndex) returns OwnershipCallee
		let argument = self.canonicalInstanceArgAt(id, position: position)

		if maxonTypeTag(argument) == ValueTypeTag.named and self.unionNameIsUnboxed(foreignNameOf(self.typeNames, id: typeNameIdOf(argument))) 'aWordUnion'
			return OwnershipCallee.named(unionRetainSymbol(foreignNameOf(self.typeNames, id: typeNameIdOf(argument))))
		end 'aWordUnion'

		return retainCalleeForProtocol(self.typeParamOwnershipProtocol(id, position: position))
	end 'typeParamRetainCallee'

	// ⭐⭐ **THE SAME PAIR ASKED OF AN INSTANCE ITSELF RATHER THAN OF ITS TYPE ARGUMENT** — what a
	// PER-INSTANCE witness table's `destroyFunc@8`/`retainFunc@16` hold. The two above answer for a generic's
	// ARGUMENT (`Container with String`'s `String`); these answer for the instance (`Array with StrArr`), which
	// is the value an existential of that instance actually owns.
	//
	// ⛔⛔ **A BASE-KEYED TABLE CANNOT ANSWER THIS, AND THE GAP WAS A MEASURED LEAK.** The shared table's words
	// come from the conformer NAME (`existentialDestroyCallee("Array")`), which names a drop that does not
	// know the element — right for the ONE table a non-generic conformer has, and a partial answer for a
	// generic one. MEASURED on eleven lines with no `clone` in them: an
	// `Array with (Array with String)` widened into a `Cloneable` and dropped exited **101**, while the same
	// program over `Array with String` exited 0 — because a String LITERAL element is immortal rdata and hid
	// the missing walk. A per-instance table names the instance, so it can name the instance's own drop.
	//
	// The rule is `typeParamDropCallee`'s, on a type this holds directly rather than reads out of an
	// instance's argument list — same protocol, same two callees, same `inert` encoding
	// (`LowerMaxonToStd.stampOwnershipWord` leaves the zero every reader treats as inert).
	export function instanceDropCallee(id GenericInstanceId) returns OwnershipCallee
		return match self.typeOwnershipProtocol(MaxonType.genericInstance(id)) 'protocol'
			none gives OwnershipCallee.inert

			// `greenThread` joins the range rather than earning an arm: `managedFieldDropCallee` routes an
			// instance through `genericInstanceBoxDropCallee`, whose FIRST arm is the promise, so the callee
			// this hands back is already `__gt_promise_drop`. `bufferRecord` joins it for the same reason from
			// the other end: an Array record's drop is an aggregate's, and only its RETAIN is its own.
			byteRecord or
			aggregate or
			greenThread or
			bufferRecord or
			sharedValue gives OwnershipCallee.named(managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: MaxonType.genericInstance(id)))
		end 'protocol'
	end 'instanceDropCallee'

	export function instanceRetainCallee(id GenericInstanceId) returns OwnershipCallee
		return retainCalleeForProtocol(self.typeOwnershipProtocol(MaxonType.genericInstance(id)))
	end 'instanceRetainCallee'

	// ⭐⭐ **WHAT A WITNESS TABLE'S `shareWalkFunc@24` HOLDS FOR CONFORMER `typeName`** — the
	// walk a record of that type takes as a FIELD (a nested record is not proved sole by any compile-time rule,
	// so a no-reference box is still walked), off the same `existentialOwnershipProtocol` the destroy and
	// retain words are stamped from. `inert` is the ANSWER for a conformer that owns nothing, exactly
	// as it is for those two words; a conformer that owns something no walk can be built for answers
	// the abort entry, never the zero word that would read as "owns nothing".
	//
	// ⚠ **A GENERIC CONFORMER'S SHARED TABLE CANNOT BE WALKED**: it is keyed by the base name, whose walk skips
	// every slot standing at a type parameter, so walking it would miss whatever the instance put there. A
	// spawning program keys a concrete instance's table by the instance (`LowerMaxonToStd.witnessTableInstanceFor`),
	// so this answers only for a widening with no concrete instance in hand.
	export function existentialCascadeCallee(typeName ByteArray, action CascadeAction) returns OwnershipCallee
		match self.existentialOwnershipProtocol(typeName) 'protocol'
			none then return OwnershipCallee.inert
			byteRecord then return OwnershipCallee.named(byteRecordCascadeCallee(action))
			greenThread then return OwnershipCallee.named(cascadeUnsupportedEntry(action))
			aggregate or
			bufferRecord or
			sharedValue then return OwnershipCallee.named(self.aggregateConformerCascadeCallee(self.denotedAggregateName(typeName), action: action))
		end 'protocol'
	end 'existentialCascadeCallee'

	function aggregateConformerCascadeCallee(name ByteArray, action CascadeAction) returns immutable ByteArray
		if self.structDeclaresTypeParams(name) 'aGenericConformer'
			return cascadeUnsupportedEntry(action)
		end 'aGenericConformer'

		if not self.aggregateSupportsCascade(name, action: action) 'someNestedTypeHasNoEntry'
			return cascadeUnsupportedEntry(action)
		end 'someNestedTypeHasNoEntry'

		return witnessCascadeCalleeOf(managedNameCascadeStrategy(self, declaredName: name, asElement: true, action: action), action: action)
	end 'aggregateConformerCascadeCallee'

	// The same two words for a PER-INSTANCE table, which names the instance and can therefore walk it.
	export function instanceExistentialCascadeCallee(id GenericInstanceId, action CascadeAction) returns OwnershipCallee
		match self.typeOwnershipProtocol(MaxonType.genericInstance(id)) 'protocol'
			none then return OwnershipCallee.inert
			greenThread then return OwnershipCallee.named(cascadeUnsupportedEntry(action))
			byteRecord or
			aggregate or
			bufferRecord or
			sharedValue then return OwnershipCallee.named(self.instanceConformerCascadeCallee(id, action: action))
		end 'protocol'
	end 'instanceExistentialCascadeCallee'

	function instanceConformerCascadeCallee(id GenericInstanceId, action CascadeAction) returns immutable ByteArray
		if not self.instanceSupportsCascade(id, action: action) 'someNestedTypeHasNoEntry'
			return cascadeUnsupportedEntry(action)
		end 'someNestedTypeHasNoEntry'

		return witnessCascadeCalleeOf(instanceCascadeStrategy(self, id: id, asElement: true, action: action), action: action)
	end 'instanceConformerCascadeCallee'

	// ⭐⭐ **THE ONE ANSWER BOTH OF A DESCRIPTOR BLOCK'S OWNERSHIP WORDS ARE A SPELLING OF (found at review)** —
	// `retainFunc@64` through `retainCalleeForProtocol`, `destroyFunc@40` through `typeParamDropCallee`. Written
	// once so the pair is non-zero TOGETHER by construction rather than by two gates agreeing, which is what
	// the witness table's `destroyFunc@8`/`retainFunc@16` have off one `existentialOwnershipProtocol` and what
	// these two twice failed to have.
	//
	// ⛔ **A BUILTIN CONTAINER'S DESCRIPTOR CARRIES NEITHER, BECAUSE NO SHARED BODY READS ONE OUT OF IT.**
	// These two words are consumed only by `__retain_type_param` / `__drop_type_param`, which are handed the
	// block of the ENCLOSING GENERIC INSTANCE the compiled-once body belongs to — and a SYNTHESIZED
	// `Array`/`Set`/`Map` record has no such body: it is served by the runtime off its own stamps. Stamping them
	// on an `Array with String` would bake relocations nothing loads, and the callee they name is a HEAP one,
	// so `MmRuntime.noteRelocatedFunctionUsage`, which roots every relocated callee, would then set `usesHeap`
	// for programs that allocate nothing.
	//
	// ⭐⭐⭐ **BUT "AN `Array` HAS NO SHARED BODY" IS FALSE, AND THE GAP IS A DOUBLE FREE.** A gate of
	// `genericInstanceHasBaseLayout` alone rests on the premise quoted above, that only a declared
	// NON-builtin generic is compiled once per instantiation. A record-collapsed `type Array uses Element`, and
	// `type FixedArray uses Element` (a value of it is the same record), is both at once: the record is the
	// compiler's, and the METHODS are a shared body the corpus declares — so
	// `Array.at`'s `return try managed.get(i)`, and `FixedArray.get`'s, emits `__retain_type_param(descriptor, element)`, reads a ZERO
	// `retainFunc@64`, and hands the caller a BORROW where the hand-off convention promises a `+1`.
	// **MEASURED: `let head = a.at(0)` over an `Array with String` prints the right answer and then takes a
	// SEGFAULT at teardown** — `main`'s `__str_decref` and the array's own element walk freeing one record
	// twice. `emitOwnedValueReturn`'s opaque arm does its job; the word it dispatches through is 0.
	//
	// ⇒ The gate is "does a shared body read this block?", and a record-collapsed conformer answers yes. The
	// size argument above is untouched: a program that does not DECLARE `type Array` or `type FixedArray` gets
	// `undeclared` from `declarationsValueIsTheManagedRecord` and the same zero words it always had.
	function typeParamOwnershipProtocol(id GenericInstanceId, position ElementIndex) returns ExistentialOwnershipProtocol
		if not (self.genericInstanceHasBaseLayout(id) or self.declarationsValueIsTheManagedRecord(self.genericInstanceBaseName(id))) 'noSharedBodyReadsThisBlock'
			return ExistentialOwnershipProtocol.none
		end 'noSharedBodyReadsThisBlock'

		return self.typeOwnershipProtocol(self.canonicalInstanceArgAt(id, position: position))
	end 'typeParamOwnershipProtocol'

	// ⭐⭐ **WHAT A LAYOUT DESCRIPTOR'S `destroyFunc@40` HOLDS FOR INSTANCE `id`'s TYPE ARGUMENT AT
	// `position`** — the exact dual of the retain word above, off the SAME `typeOwnershipProtocol`
	// answer about the SAME substituted argument, so **the two words are non-zero TOGETHER BY
	// CONSTRUCTION** rather than by two predicates agreeing — except `greenThread`, whose retain word
	// is 0 because a promise is never co-owned (`retainCalleeForProtocol`) and whose drop word is not.
	// That is the invariant `managedOpaqueArrayElementOf` states, and the arrangement the witness
	// table's `destroyFunc@8`/`retainFunc@16` pair holds.
	//
	// ⛔⛔ **NEITHER WORD MAY BE GATED ON THE BASE'S FIELD LIST.** `retainFunc@64` is a fact about the
	// ARGUMENT, and a generic that stores a borrowed `T` into a record it builds needs no `T`-typed field at
	// all: `type Pack uses T` with only `var n as Integer`, an instance method doing `let pair = (t, n)` over a
	// borrowed `T`. The store takes `__str_clone` through `retainFunc@64` at `Pack with String`, and
	// `emitOpaqueSlotReleases` calls `__drop_type_param`, which reads this word — a zero here leaks (exit 101).
	//
	// ⭐ An opaque `Array with T` built as a LOCAL rather than held as a field reads this word too: the shared
	// body's `__managed_create` takes its `element_destroy@40` from it, and a zero leaves that array's elements
	// unwalked.
	//
	// `inert` is the ANSWER for an argument that owns no record: `stampOwnershipWord` leaves the
	// zero both `__drop_type_param` and the array walk treat as inert — the identical encoding the retain uses.
	export function typeParamDropCallee(id GenericInstanceId, position ElementIndex) returns OwnershipCallee
		return match self.typeParamOwnershipProtocol(id, position: position) 'protocol'
			none gives OwnershipCallee.inert

			// See `instanceDropCallee` — the promise routes itself through `genericInstanceBoxDropCallee`, and
			// an Array record's drop is an aggregate's.
			byteRecord or
			aggregate or
			greenThread or
			bufferRecord or
			sharedValue gives OwnershipCallee.named(managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: self.canonicalInstanceArgAt(id, position: position)))
		end 'protocol'
	end 'typeParamDropCallee'

	// ⭐⭐ **WHICH OWNERSHIP PROTOCOL A TYPE'S VALUE TAKES — `existentialOwnershipProtocol`'s TYPE-KEYED
	// DOOR.** ONE rule, two entries, the arrangement `conformerNameOfType` /
	// `conformerNameOfDeclaredName` already has and for the same reason: an existential widening holds a
	// CONFORMER NAME, a generic instance holds a resolved `MaxonType` argument, and neither can cheaply become
	// the other. The rule is the same in both spellings — a byte record first (its representation, not a
	// registry, is what decides it), then the one managed classifier, then aggregate.
	//
	// ⚠ The byte-record test is a TAG here where the name door tests two names, and that is the same test:
	// `tagIsByteRecord` is exactly "String or Character", and a name door has no tag to read.
	//
	// ⛔⛔ **AND IT CARRIES THE SUPERSEDED GUARD, WHICH IS THE FOURTH DOOR TO NEED ONE.** A
	// spelling two files contest names no reader (`genericAliasSpellingIsSuperseded`), so the rule that door
	// states applies here unchanged: **a classifier that meets one contributes NOTHING rather than guessing.**
	// `typeIsManaged`'s `named` arm ends in `isGenericAliasInAnyFile(name)` and says MANAGED of such a spelling, and
	// "managed" is spent HERE on naming a per-type callee — which for a contested alias is exactly the
	// `genericAliasInstance` refusal, reached as a compiler PANIC instead of the diagnostic the program had
	// already earned. `none` is the identity: both descriptor words stay 0 and both runtime entries are inert,
	// which is what a doomed program's descriptor should hold.
	//
	// ⚠ **MEASURED, on three committed `typealias-file-scope` cases**: widening the descriptor's
	// DROP gate to this boundary without the guard put a contested `Bag`/`N0` through
	// `typeParamDropCallee` → `managedFieldDropCallee` → `managedNameDropCallee`, and
	// `noteDestructorUsage` died at `SignatureIndex.maxon`'s refusal with a stack trace where two `error.`
	// cases expect an E2015 and one expects a clean compile.
	//
	// ⛔⛔ **AND AN INTERFACE-TYPED ARGUMENT IS THE FIFTH DOOR TO NEED THE SAME GUARD, FOR THE SAME REASON.** `declaredNameIsManaged` answers `true` of an interface NAME deliberately — that arm
	// serves `existentialDestroyCallee`, whose caller has already routed on a tag — so "managed" reaches here
	// for a `Box with Named`, and "managed" is spent HERE on naming a per-type callee that an existential does
	// not have: it is released through `__drop_existential(witness, value)`, and a descriptor word carries no
	// witness. MEASURED: without the guard `typealias NamedBox = Box with Named` dies in `noteDestructorUsage` with
	// `managedNameDropCallee: 'Named' is an interface` and a stack trace, where the program has earned a positioned
	// **E2015** naming the fat pointer. That is `managedOpaqueArrayElementOf`'s own recorded failure
	// (`genericInstanceHasBaseLayout`, "the build already doomed") arriving at this boundary.
	function typeOwnershipProtocol(t MaxonType) returns ExistentialOwnershipProtocol
		if tagIsByteRecord(maxonTypeTag(t)) 'byteRecord'
			return ExistentialOwnershipProtocol.byteRecord
		end 'byteRecord'

		if self.typeArgSpellingIsSuperseded(t) 'theContestReplacedThisOne'
			return ExistentialOwnershipProtocol.none
		end 'theContestReplacedThisOne'

		// ⭐ ASKED BEFORE `typeIsManaged`, which answers `false` for a promise — it is not a box — and would
		// therefore hand back `none`, the protocol that owns NOTHING. A promise owns a thread.
		if self.typeIsAGreenThreadHandle(t, from: self.typeNames) 'aGreenThread'
			return ExistentialOwnershipProtocol.greenThread
		end 'aGreenThread'

		if not self.typeIsManaged(t, from: self.typeNames) 'ownsNothing'
			return ExistentialOwnershipProtocol.none
		end 'ownsNothing'

		if self.typeDenotesInterface(t) 'anExistentialHasNoStaticProtocol'
			return ExistentialOwnershipProtocol.none
		end 'anExistentialHasNoStaticProtocol'

		// ⭐ **AN `Array` INSTANCE IS THE ONE MANAGED SHAPE WHOSE RECORD MAY BE IMAGE DATA**, so it takes the
		// protocol whose retain asks the record rather than assuming a refcount — see the case's own note.
		// Asked LAST, past every arm that answers about something other than a box, so it narrows the
		// aggregate answer and changes no other.
		//
		// ⚠ **THROUGH `denotedInstance`, NOT OFF THE TAG.** An argument may SPELL the container as a generic
		// ALIAS — `ByteArray` is a `named` leaf, not a `genericInstance` — and the tag test MEASURED as an
		// access violation on exactly that spelling: the compiler's own `TypeNameInterner`'s `Map with
		// (ByteArray, TypeNameId)` retained a `.rdata` key through `__retain_type_param` during a rehash.
		let denoted = try self.denotedInstance(t) otherwise return ExistentialOwnershipProtocol.aggregate

		if self.instanceBaseIsSharedValue(denoted) 'aSharedValue'
			return ExistentialOwnershipProtocol.sharedValue
		end 'aSharedValue'

		if self.isArrayInstance(denoted) 'aBufferRecord'
			return ExistentialOwnershipProtocol.bufferRecord
		end 'aBufferRecord'

		return ExistentialOwnershipProtocol.aggregate
	end 'typeOwnershipProtocol'

	// Is `t` a value held at an INTERFACE type — a two-word fat pointer whose retain and release are its
	// WITNESS's and not any name a descriptor word can hold? BOTH spellings, because a generic type ARGUMENT
	// is a third producer of slot types that `normalizeSweptInterfaceTypes` does not re-tag: the real parse
	// mints `interfaceRef`, and `Box with Named`'s argument arrives as a bare `named` — which is exactly the
	// spelling `managedNameDropCallee`'s panic says cannot exist.
	function typeDenotesInterface(t MaxonType) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.interfaceRef 'taggedExistential'
			return true
		end 'taggedExistential'

		if not tagMayNameAggregate(tag) 'namesNoDeclaration'
			return false
		end 'namesNoDeclaration'

		let form = try self.declaredFormInAnyFile(self.denotedSlotAggregateName(t)) otherwise return false
		return form == TypeDeclKind.interfaceType
	end 'typeDenotesInterface'

	// ⭐⭐ **WHICH STORAGE POSITION A `Base with Args` ARGUMENT OCCUPIES — decided from the BASE, once, and
	// passed down.** A `type` base's arguments are its container's element slots; an `interface` base's are the
	// associated-type BINDINGS of an existential (`ProgramSignatures.instanceDenotedType`). Only the base can
	// tell them apart, and `parseGenericArgNode` sees an argument, so the answer travels with the walk exactly
	// as `inlineElement` does — and for the same reason: it is a fact about the base, and re-deriving it per
	// argument would be the same lookup done N times.
	//
	// ⚠ **IT CARRIES THE INTERFACE NAME AND NOT MERELY THE FACT, because the binding arm's refusal is about
	// the ASSOCIATED TYPE at that position** — which requirement writes it, and where.
	//
	// ⚠ **THE `allFilesFolded` GATE IS THE ONE `parseTypeReference`'s interface arm carries**, and it costs
	// this door nothing: during the declaration SWEEP the interface registry is EMPTY, so the sweep answers
	// `containerElement` — and it cannot refuse on that answer either, because an interface-typed argument
	// resolves to a bare `named` in the sweep and never reaches the existential test at all.
	function genericArgSlotOf(baseName ByteArray) returns GenericArgSlot
		if self.allFilesFolded and isInterfaceName(self.settledDeclarations().interfaces, name: baseName) 'anInterfaceInstance'
			return GenericArgSlot.associatedTypeBinding(baseName)
		end 'anInterfaceInstance'

		return GenericArgSlot.containerElement
	end 'genericArgSlotOf'

	// The one decision a written argument (`Parser.requireCarryableGenericArg`), a use of an instance
	// (`genericInstanceIsRefused`) and a conformer's binding all ask, so a refused instance is E2015
	// once, where it is written or bound, and every use of it defers.
	function genericArgumentIsRefused(slot GenericArgSlot, argumentIsAnInterface bool, position ElementIndex) returns bool
		if not self.allFilesFolded or not argumentIsAnInterface 'admitted'
			return false
		end 'admitted'

		return match slot 'slot'
			containerElement gives true
			associatedTypeBinding(interfaceName) gives self.associatedTypeIsTakenByARequirement(interfaceName, position: position)
		end 'slot'
	end 'genericArgumentIsRefused'

	function associatedTypeIsTakenByARequirement(interfaceName ByteArray, position ElementIndex) returns bool
		match lookupInterface(self.settledDeclarations().interfaces, name: interfaceName) 'base'
			notFound then return false
			found(iface) then return position < iface.associatedTypeNames.count() and requirementTakesAssociatedType(self.settledDeclarations().interfaces, iface: iface, position: position, signatures: self)
		end 'base'
	end 'associatedTypeIsTakenByARequirement'

	export function genericInstanceIsRefused(id GenericInstanceId) returns bool
		if not self.allFilesFolded or self.instanceIsPromiseHandle(id) 'nothingToRefuse'
			return false
		end 'nothingToRefuse'

		let slot = self.genericArgSlotOf(self.genericInstanceBaseName(id))

		for position in 0 upto self.genericInstanceArgCount(id) 'eachArgument'
			let argument = self.substitutedInstanceArg(id, position: position)

			if maxonTypeTag(argument) == ValueTypeTag.genericInstance and self.genericInstanceIsRefused(genericInstanceIdOf(argument)) 'aRefusedArgument'
				return true
			end 'aRefusedArgument'

			if self.genericArgumentIsRefused(slot, argumentIsAnInterface: self.typeDenotesInterface(argument), position: position) 'aRefusedPosition'
				return true
			end 'aRefusedPosition'
		end 'eachArgument'

		return false
	end 'genericInstanceIsRefused'

	// Is struct field `index` declared at an INTERFACE type — the two-slot fat pointer whose drop is
	// `__drop_existential` rather than a statically named callee? Asked through
	// the index (not off a caller's own layout) so the destructor cascade, the `usesDropExistential` gate and
	// the struct-clone refusal all read ONE answer.
	export function structFieldIsExistential(structName ByteArray, index FieldIndex) returns bool
		return maxonTypeTag(self.structFieldDeclaredType(structName, index: index)) == ValueTypeTag.interfaceRef
	end 'structFieldIsExistential'

	// ⛔⛔ **ASKED ON THE DECLARING STRUCT'S BEHALF, AND THE READER-FREE DOOR HERE WAS A WILD DECREF.**
	// `typeIsManagedFor`'s header calls the struct-field cascade and the destructor stamp "genuinely
	// file-less" callers. They are not: a field's declared type is a name spelled in the struct's OWN file,
	// so the file that decides what it means is `layout.declFilePath` — the same reader `resolveTypes`
	// already passes for the field types themselves (`TypeResolution.checkStructFieldTypes`).
	//
	// MEASURED with a name-only control: `stdlib/Builtins.maxon`'s `type __UnsignedDigitStep` declares
	// `public var quotient as FullRangeInt`, its own unexported `typealias FullRangeInt = int(...)`. A user
	// program declaring `type FullRangeInt` made this door read the USER's struct, so the module's integer
	// field was classified managed, `__destruct___UnsignedDigitStep` was synthesized over it, and every
	// integer format spec — `"{n:x}"`, `"{n:X}"`, `"{n:o}"`, `"{n:b}"`, `"{n:d}"` — decref'd a digit as a
	// pointer: **exit 0xC0000005 on x64 and a trap on wasm, with no diagnostic and no output**, against a
	// control of 11. The IR diff is one line, `call $__mm_decref` becoming
	// `call $__destruct___UnsignedDigitStep`.
	export function structFieldIsManaged(structName ByteArray, index FieldIndex) returns bool
		let layout = self.structLayoutOf(structName)
		return self.typeIsManagedFor(self.layoutFieldType(layout, structName: structName, index: index), from: self.typeNames, readerFilePath: layout.declFilePath)
	end 'structFieldIsManaged'

	// ⭐ **THE OWNERSHIP PROJECTION OF THE FIELD QUESTION — what a DESTRUCTOR must ask**. A promise
	// field is not managed (not a box, never retained, never cloned) and does owe a reclaim, so the
	// synthesized `__destruct_<T>` has to walk it. Asking `structFieldIsManaged` there is what left a
	// `type Holder { let p as IntPromise }` with no destructor at all.
	// Reader-aware for the same reason and by the same file as `structFieldIsManaged` above — the two must
	// agree about a contested name or a slot is dropped by nobody, or by everybody twice.
	export function structFieldOwesDrop(structName ByteArray, index FieldIndex) returns bool
		let layout = self.structLayoutOf(structName)
		return self.typeOwesDropFor(self.layoutFieldType(layout, structName: structName, index: index), from: self.typeNames, readerFilePath: layout.declFilePath)
	end 'structFieldOwesDrop'

	// THE declared-record layout for `structName`, read off THIS index's own registry. The preamble every
	// by-name struct question shares, written once because it was written SIX times, each copy carrying its
	// own panic message saying the same one thing. A miss is a precondition rather than a case: the name
	// came from a `structOf` the caller already asked.
	function structLayoutOf(structName ByteArray) returns StructLayout
		return try self.registeredLayout(structName) otherwise panic("ProgramSignatures.structLayoutOf: no `type {String.from(structName)}` is declared — every caller resolves the name before asking")
	end 'structLayoutOf'

	// Field `index` off a layout the caller already holds — for the doors that need the layout's
	// `declFilePath` too and would otherwise fetch it twice.
	function layoutFieldType(layout StructLayout, structName ByteArray, index FieldIndex) returns MaxonType
		return try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.fieldTypeOf: field {index} is out of range for `type {String.from(structName)}`, which declares {layout.fieldCount()} — every index handed out came from `indexOfField`")
	end 'layoutFieldType'

	// The DECLARED type of struct field `index`.
	//
	// ⚠ **THIS DOOR IS READER-FREE AND ITS CALLERS MUST NOT ASK A MANAGEDNESS QUESTION THROUGH IT** — the
	// two that did are `structFieldIsManaged`/`structFieldOwesDrop` above, which now read the layout
	// themselves so they can name the reader. A caller that only wants the TAG (existential, opaque) is
	// unaffected: a tag is not contestable.
	export function uniqueCauseOf(structName ByteArray) returns UniqueCause
		return self.aggregateUniqueCause(structName, visited: NameRoster.create(0))
	end 'uniqueCauseOf'

	function uniqueHeldName(fieldType MaxonType) returns immutable ByteArray
		let tag = maxonTypeTag(fieldType)

		if tag == ValueTypeTag.named or tag == ValueTypeTag.structRef 'aNamedRecord'
			return self.nameOfId(typeNameIdOf(fieldType))
		end 'aNamedRecord'

		return freeze self.typeDisplayName(fieldType).toByteArray()
	end 'uniqueHeldName'

	export function typeNameHoldsAUnique(name ByteArray) returns bool
		let key = self.uniqueHoldingKeyOf(name)

		if let answered = try self.uniqueAnswerFor(key) 'alreadyAnswered'
			return answered
		end 'alreadyAnswered'

		let answer = self.aggregateUniqueCause(name, visited: NameRoster.create(0)).holdsAUnique()
		self.rememberUniqueHolding(key, answer: answer)

		return answer
	end 'typeNameHoldsAUnique'

	export function valueUniqueCause(tag ValueTypeTag, nameId TypeNameId, from TypeNameInterner) returns UniqueCause
		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceUniqueCause(nameId as GenericInstanceId, visited: NameRoster.create(0))
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return UniqueCause.none
		end 'notAnAggregate'

		return self.aggregateUniqueCause(try from.nameOf(nameId) otherwise panic("ProgramSignatures.valueUniqueCause: type-name id {nameId} is not in the interner the caller named"), visited: NameRoster.create(0))
	end 'valueUniqueCause'

	export function valueHoldsAUnique(tag ValueTypeTag, nameId TypeNameId, from TypeNameInterner) returns bool
		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceHoldsAUniqueValue(nameId as GenericInstanceId)
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		return self.typeNameHoldsAUnique(try from.nameOf(nameId) otherwise panic("ProgramSignatures.valueHoldsAUnique: type-name id {nameId} is not in the interner the caller named"))
	end 'valueHoldsAUnique'

	export function instanceHoldsAUniqueValue(id GenericInstanceId) returns bool
		let key = self.uniqueHoldingKeyOf(self.mangleGenericInstance(id))

		if let answered = try self.uniqueAnswerFor(key) 'alreadyAnswered'
			return answered
		end 'alreadyAnswered'

		let answer = self.instanceUniqueCause(id, visited: NameRoster.create(0)).holdsAUnique()
		self.rememberUniqueHolding(key, answer: answer)

		return answer
	end 'instanceHoldsAUniqueValue'

	function rememberUniqueHolding(key ByteArray, answer bool)
		if not self.allFilesFolded 'declarationsAreIncomplete'
			return
		end 'declarationsAreIncomplete'

		self.uniqueTypeAnswers.upsert(key, value: answer)

		if self.baseline.settled 'pastTheBaseline'
			self.journal.noteUniqueTypeAnswer(key)
		end 'pastTheBaseline'
	end 'rememberUniqueHolding'

	function uniqueHoldingKeyOf(name immutable ByteArray) returns immutable ByteArray
		let key = ByteArray.create(UniqueHoldingKeyPrefix.count() + name.count(), zeroed: false) as isolated ByteArray
		key.append(UniqueHoldingKeyPrefix)
		key.append(name)

		return freeze key
	end 'uniqueHoldingKeyOf'

	export function valueIsLinear(tag ValueTypeTag, nameId TypeNameId, from TypeNameInterner) returns bool
		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceIsLinear(nameId as GenericInstanceId)
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		return self.aggregateIsLinear(try from.nameOf(nameId) otherwise panic("ProgramSignatures.valueIsLinear: type-name id {nameId} is not in the interner the caller named"), visited: NameRoster.create(0))
	end 'valueIsLinear'

	export function typeIsLinear(type MaxonType) returns bool
		return self.typeIsLinearWalking(type, visited: NameRoster.create(0))
	end 'typeIsLinear'

	function typeIsLinearWalking(type MaxonType, visited NameRoster) returns bool
		let tag = maxonTypeTag(type)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceIsLinear(genericInstanceIdOf(type))
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		let name = self.denotedSlotAggregateName(type)

		if self.isFunctionAliasInAnyFile(name) 'aFunctionAlias'
			return false
		end 'aFunctionAlias'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			let live = try self.liveGenericAliasInstance(name) otherwise return false
			return self.instanceIsLinear(live)
		end 'genericAlias'

		return self.aggregateIsLinear(name, visited: visited)
	end 'typeIsLinearWalking'

	function instanceIsLinear(id GenericInstanceId) returns bool
		if self.instanceIsPromiseHandle(id) or self.isElementBearingRecordInstance(id) or not self.genericInstanceHasBaseLayout(id) 'neverLinear'
			return false
		end 'neverLinear'

		return self.baseLayoutOf(id).isLinear
	end 'instanceIsLinear'

	function aggregateIsLinear(name ByteArray, visited NameRoster) returns bool
		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedSocket or
			managedPages or
			managedHandle or
			managedPin or
			serviceHandle then return false

			userDeclared then break
		end 'compilerOwned'

		if visited.contains(name) 'alreadyWalked'
			return false
		end 'alreadyWalked'

		visited.push(name)

		if self.containsStructInAnyFile(name) 'aStruct'
			return self.structLayoutOf(name).isLinear
		end 'aStruct'

		match self.enumInAnyFile(name) 'union'
			declared(layout) then return self.unionPayloadsAreLinear(layout, visited: visited)
			undeclared then return false
		end 'union'
	end 'aggregateIsLinear'

	function unionPayloadsAreLinear(layout EnumLayout, visited NameRoster) returns bool
		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachPayload'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.unionPayloadsAreLinear: payloadsAt count disagrees with get at {fi}")

				if self.typeIsLinearWalking(field.declaredType, visited: visited) 'aLinearPayload'
					return true
				end 'aLinearPayload'
			end 'eachPayload'
		end 'eachCase'

		return false
	end 'unionPayloadsAreLinear'

	function typeUniqueCause(type MaxonType, visited NameRoster) returns UniqueCause
		let tag = maxonTypeTag(type)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceUniqueCause(genericInstanceIdOf(type), visited: visited)
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return UniqueCause.none
		end 'notAnAggregate'

		let name = self.denotedSlotAggregateName(type)

		if self.isFunctionAliasInAnyFile(name) 'aFunctionAlias'
			return UniqueCause.none
		end 'aFunctionAlias'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			let live = try self.liveGenericAliasInstance(name) otherwise return UniqueCause.none
			return self.instanceUniqueCause(live, visited: visited)
		end 'genericAlias'

		return self.aggregateUniqueCause(name, visited: visited)
	end 'typeUniqueCause'

	function aggregateUniqueCause(name ByteArray, visited NameRoster) returns UniqueCause
		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedSocket or
			managedPages or
			managedHandle or
			managedPin then return UniqueCause.declared

			serviceHandle then return UniqueCause.none
			userDeclared then break
		end 'compilerOwned'

		if visited.contains(name) 'alreadyWalked'
			return UniqueCause.none
		end 'alreadyWalked'

		visited.push(name)

		if self.containsStructInAnyFile(name) 'aStruct'
			let layout = self.structLayoutOf(name)

			if layout.isUnique 'declaredUnique'
				return UniqueCause.declared
			end 'declaredUnique'

			for i in 0 upto layout.fieldCount() 'eachField'
				let fieldType = self.layoutFieldType(layout, structName: name, index: i)

				if self.typeUniqueCause(fieldType, visited: visited).holdsAUnique() 'aUniqueField'
					return UniqueCause.holds(try layout.fieldNames.get(i) otherwise panic("aggregateUniqueCause: fieldNames.get OOB at {i}"), held: self.uniqueHeldName(fieldType))
				end 'aUniqueField'
			end 'eachField'

			return UniqueCause.none
		end 'aStruct'

		match self.enumInAnyFile(name) 'union'
			declared(layout) then return self.unionPayloadsUniqueCause(layout, visited: visited)
			undeclared then return UniqueCause.none
		end 'union'
	end 'aggregateUniqueCause'

	function instanceUniqueCause(id GenericInstanceId, visited NameRoster) returns UniqueCause
		if self.instanceIsPromiseHandle(id) 'aPromise'
			return UniqueCause.none
		end 'aPromise'

		let mangled = self.mangleGenericInstance(id)

		if visited.contains(mangled) 'alreadyWalked'
			return UniqueCause.none
		end 'alreadyWalked'

		visited.push(mangled)

		if self.isElementBearingRecordInstance(id) 'anElementRecord'
			let element = self.containerElementType(id)

			if self.typeUniqueCause(element, visited: visited).holdsAUnique() 'aUniqueElement'
				return UniqueCause.holds(ElementCauseField, held: self.uniqueHeldName(element))
			end 'aUniqueElement'

			return UniqueCause.none
		end 'anElementRecord'

		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToRead'
			return UniqueCause.none
		end 'noFieldsToRead'

		if self.baseLayoutOf(id).isUnique 'declaredUnique'
			return UniqueCause.declared
		end 'declaredUnique'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			let fieldType = self.substituteInstanceFieldType(id, index: i)

			if self.typeUniqueCause(fieldType, visited: visited).holdsAUnique() 'aUniqueField'
				return UniqueCause.holds(try self.baseLayoutOf(id).fieldNames.get(i) otherwise panic("instanceUniqueCause: fieldNames.get OOB at {i}"), held: self.uniqueHeldName(fieldType))
			end 'aUniqueField'
		end 'eachField'

		return UniqueCause.none
	end 'instanceUniqueCause'

	function unionPayloadsUniqueCause(layout EnumLayout, visited NameRoster) returns UniqueCause
		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachPayload'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.unionPayloadsUniqueCause: payloadsAt count disagrees with get at {fi}")

				if self.typeUniqueCause(field.declaredType, visited: visited).holdsAUnique() 'aUniquePayload'
					return UniqueCause.holds(field.name, held: self.uniqueHeldName(field.declaredType))
				end 'aUniquePayload'
			end 'eachPayload'
		end 'eachCase'

		return UniqueCause.none
	end 'unionPayloadsUniqueCause'

	export function instanceArgMeetsRegionBound(gid GenericInstanceId, position ElementIndex, kind RegionBoundKind) returns bool
		let argument = self.substitutedInstanceArg(gid, position: position)

		if maxonTypeTag(argument) == ValueTypeTag.typeParameter or self.typeIsAValueOrHandle(argument) 'needsNoOwner'
			return true
		end 'needsNoOwner'

		let unique = self.instanceArgIsUnique(gid, position: position)

		return match kind 'kind'
			isolated gives unique
			sendable gives not unique and self.genericInstanceArgQualifier(gid, position: position) == GenericArgQualifier.frozen
		end 'kind'
	end 'instanceArgMeetsRegionBound'

	export function instanceArgIsLinear(gid GenericInstanceId, position ElementIndex) returns bool
		return self.typeIsLinear(self.substitutedInstanceArg(gid, position: position))
	end 'instanceArgIsLinear'

	export function instanceArgIsUnique(gid GenericInstanceId, position ElementIndex) returns bool
		return self.typeUniqueCause(self.substitutedInstanceArg(gid, position: position), visited: NameRoster.create(0)).holdsAUnique()
	end 'instanceArgIsUnique'

	function typeIsAValueOrHandle(type MaxonType) returns bool
		let tag = maxonTypeTag(type)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceBaseIsServiceHandle(genericInstanceIdOf(type))
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'aScalarOrText'
			return true
		end 'aScalarOrText'

		let name = self.denotedSlotAggregateName(type)

		if self.isAnyServiceHandle(name) 'aServiceHandle'
			return true
		end 'aServiceHandle'

		if self.containsStructInAnyFile(name) 'aRecord'
			return false
		end 'aRecord'

		match self.enumInAnyFile(name) 'enumeration'
			declared(layout) then return self.enumCarriesNoPayload(layout)
			undeclared then return not self.nameDeclaresAnInterface(name)
		end 'enumeration'
	end 'typeIsAValueOrHandle'

	function enumCarriesNoPayload(layout EnumLayout) returns bool
		for ci in 0 upto layout.caseCount() 'eachCase'
			if not layout.payloadsAt(ci).isEmpty() 'aPayload'
				return false
			end 'aPayload'
		end 'eachCase'

		return true
	end 'enumCarriesNoPayload'

	function structFieldDeclaredType(structName ByteArray, index FieldIndex) returns MaxonType
		return self.layoutFieldType(self.structLayoutOf(structName), structName: structName, index: index)
	end 'structFieldDeclaredType'

	// ⭐ **IS STRUCT FIELD `index` STANDING AT A BARE TYPE PARAMETER?** The declared-record twin of
	// `genericInstanceFieldIsOpaque`, and the field `typeIsManaged` answers `false` for — so a caller asking
	// "is this managed?" skips exactly the slot whose release is a run-time descriptor read.
	export function structFieldIsOpaque(structName ByteArray, index FieldIndex) returns bool
		return maxonTypeTag(self.structFieldDeclaredType(structName, index: index)) == ValueTypeTag.typeParameter
	end 'structFieldIsOpaque'

	// The descriptor BLOCK that field's release reads — the `uses`-list position of the parameter the slot
	// stands at, exactly as `genericInstanceFieldOpaqueBlockOffset` gives for an instance's slot.
	// Precondition: `structFieldIsOpaque`.
	export function structFieldOpaqueBlockOffset(structName ByteArray, index FieldIndex) returns ByteOffset
		return layoutBlockOffsetFor(self.opaqueTypeParamPosition(self.structFieldDeclaredType(structName, index: index)))
	end 'structFieldOpaqueBlockOffset'

	// ⭐⭐ **WHICH DECLARATION'S `uses` LIST A DECLARED RECORD'S OPAQUE SLOTS INDEX INTO, OR THAT IT
	// RESTS NONE.** The declared-record twin of `instanceRestsARetainedSlot`, and it exists because a
	// TUPLE of a generic's own parameters — `typealias Pair = (K, V)` inside `type Holder uses K, V`,
	// and `stdlib/Map.maxon`'s `Entry` — is a `structRef` and reaches none of that family, so the
	// reference its stores take through `retainFunc@64` has no release at all in a body that is itself
	// shared.
	//
	// ⛔⛔ **IT CARRIES THE DECLARATION RATHER THAN ANSWERING A BARE `bool`, BECAUSE THE RETAIN AND THE RELEASE
	// MUST READ ONE `uses` LIST AND NOT TWO.** The store that put a reference in the
	// slot read a BLOCK of whatever descriptor the BUILDING body was handed; a release that indexed a DIFFERENT
	// declaration's parameter positions into the descriptor the DROPPING body happens to hold would be releasing
	// against another type's `uses` list — an over-release (exit 139). A body only ever carries its
	// own enclosing type's descriptor, so the drop site admits this record only when the declaration
	// named here IS that type.
	//
	// A slot counts whether it stands at a bare parameter or rests one through a nested declaration view
	// (`restingSlotOwnerName`); the view's parameter names the declaration either way.
	export function recordOpaqueSlotDeclaration(structName ByteArray) returns OpaqueSlotDeclaration
		let layout = self.structLayoutOf(structName)

		for i in 0 upto layout.fieldCount() 'firstRestingSlot'
			if let owner = try self.restingSlotOwnerName(structName, index: i) 'restsASlot'
				self.requireRemainingOpaqueSlotsAgree(structName, from: (i + 1) as FieldIndex, owner: owner)
				return OpaqueSlotDeclaration.declaredBy(owner)
			end 'restsASlot'
		end 'firstRestingSlot'

		return OpaqueSlotDeclaration.none
	end 'recordOpaqueSlotDeclaration'

	export function structFieldRestingNestedView(structName ByteArray, index FieldIndex) returns MaxonType throws MapError
		return try self.viewRestingARetainedSlot(self.structFieldDeclaredType(structName, index: index))
	end 'structFieldRestingNestedView'

	export function viewRestingARetainedSlot(slotType MaxonType) returns MaxonType throws MapError
		let resolved = self.typeArgumentType(slotType)

		if maxonTypeTag(resolved) == ValueTypeTag.genericInstance 'aNestedInstance'
			if not self.instanceRestsARetainedSlot(genericInstanceIdOf(resolved)) 'restsNothing'
				throw MapError.keyNotFound
			end 'restsNothing'

			return resolved
		end 'aNestedInstance'

		_ = try self.tupleElementTypesOf(resolved)

		if not self.slotOwnsASlotOfKind(resolved, kind: TypeArgInstantiationKind.retainedFeed, visited: ClonerSet.create()) 'aTupleRestingNothing'
			throw MapError.keyNotFound
		end 'aTupleRestingNothing'

		return resolved
	end 'viewRestingARetainedSlot'

	export function viewDictionaryDestructorSubject(view MaxonType) returns immutable ByteArray
		if maxonTypeTag(view) == ValueTypeTag.genericInstance 'anInstance'
			return self.mangleGenericInstance(genericInstanceIdOf(view))
		end 'anInstance'

		return self.nameOfId(typeNameIdOf(view))
	end 'viewDictionaryDestructorSubject'

	function restingSlotOwnerName(structName ByteArray, index FieldIndex) returns immutable ByteArray throws MapError
		if self.structFieldIsOpaque(structName, index: index) 'aBareParameterSlot'
			return self.typeParamDeclaringTypeName(typeParamIdOf(self.structFieldDeclaredType(structName, index: index)))
		end 'aBareParameterSlot'

		return self.typeParamDeclaringTypeName(try self.firstTypeParameterIn(try self.structFieldRestingNestedView(structName, index: index)))
	end 'restingSlotOwnerName'

	export function instanceParameterOwnerName(gid GenericInstanceId) returns immutable ByteArray throws MapError
		return self.typeParamDeclaringTypeName(try self.firstTypeParameterInInstanceArgs(gid))
	end 'instanceParameterOwnerName'

	function typeParamDeclaringTypeName(param TypeParamId) returns immutable ByteArray
		return (try self.typeParamOwnerOf(param) otherwise panic("ProgramSignatures.typeParamDeclaringTypeName: type-parameter token {param} has no owner — `recordStruct` files every declared parameter as the sweep folds")).declaringTypeName
	end 'typeParamDeclaringTypeName'

	// Every remaining opaque slot of `structName` must stand at a parameter of `owner`. A record is written
	// inside ONE declaration, so every parameter it can name is that declaration's — CHECKED rather than
	// assumed, because two owners would mean one descriptor laying out two `uses` lists, and the cascade would
	// release half the record against the wrong one: a wild free with no diagnostic anywhere.
	function requireRemainingOpaqueSlotsAgree(structName ByteArray, from FieldIndex, owner ByteArray)
		let layout = self.structLayoutOf(structName)

		for i in from upto layout.fieldCount() 'eachLaterField'
			let other = try self.restingSlotOwnerName(structName, index: i) otherwise continue

			if not other.equals(owner) 'twoDeclarations'
				panic("ProgramSignatures.requireRemainingOpaqueSlotsAgree: `{String.from(structName)}` rests slots at parameters of BOTH `{String.from(owner)}` and `{String.from(other)}` — a record is written inside one declaration and can name only its parameters, so one layout descriptor cannot lay out both")
			end 'twoDeclarations'
		end 'eachLaterField'
	end 'requireRemainingOpaqueSlotsAgree'

	// ⭐ **DOES A TYPE DENOTE AN `Array` INSTANCE — DIRECTLY OR THROUGH A GENERIC-ALIAS NAME?** A layout's
	// field type is recorded by the SWEEP, before interning, so an `items as IntArr` field arrives as
	// `named("IntArr")` where an `items as Array with Int` field arrives already tagged `genericInstance`;
	// a generic instance's stored type ARGUMENT carries the same two spellings for the same reason
	// (`conformerNameOfDeclaredName`'s alias arm). One resolution serves both, so a rule written for one
	// spelling cannot miss the other.
	//
	// ⚠ **A SUPERSEDED SPELLING ANSWERS `false` RATHER THAN REACHING `genericAliasInstance` (which PANICS on
	// one).** That door refuses a name two files contest because it can name no reader to choose between
	// them, and a whole-program reader must ask this first — the arrangement `conformerNameOfDeclaredName`
	// states in full. Answering "not an array" is the safe direction and the same one that door takes: it
	// costs a contested field its array treatment, where reaching the panic costs the user their compile.
	export function denotesArrayInstance(t MaxonType) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.genericInstance 'instance'
			return self.isArrayInstance(genericInstanceIdOf(t))
		end 'instance'

		if tag != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		let name = self.nameOfId(typeNameIdOf(t))
		return self.isArrayInstance(try self.liveGenericAliasInstance(name) otherwise return false)
	end 'denotesArrayInstance'

	// The `Array` instance the type above denotes. Precondition: `denotesArrayInstance(t)`, so exactly the
	// two spellings it admits reach here.
	export function denotedArrayInstance(t MaxonType) returns GenericInstanceId
		if maxonTypeTag(t) == ValueTypeTag.genericInstance 'instance'
			return genericInstanceIdOf(t)
		end 'instance'

		return self.genericAliasInstanceInAnyFile(self.nameOfId(typeNameIdOf(t)))
	end 'denotedArrayInstance'

	// ⭐ **DOES A MANAGED-OPAQUE-ARRAY-HOLDING INSTANCE HAVE A DEEP-CLONEABLE ELEMENT?**
	// The GATE on the descriptor `copyFunc@32` stamp — the CLONE dual of the drop word's gate
	// (`typeParamDropCallee`'s `inert` answer), and the stamp is its only reader (the cloner is
	// DCE-rooted off the stamp itself, by `MmRuntime.noteRelocatedFunctionUsage`). `copyFunc@32` is
	// stamped, and the element's `__clone_<T>` SYNTHESIZED, only when the element is deep-cloneable by the
	// single-`(box) -> newBox` mechanism: a String / boxed-union / struct / trivial-element-array element WHOSE WHOLE
	// reachable type graph is itself clonable. It MUST read the SAME full-graph classifier the front-end reject
	// (`genericTypeFieldUncopyableInstantiation`) and the concrete gate (`sourceCloneVerdictOfType`) use —
	// `typeSupportsDeepClone` — NOT merely the element's TOP-LEVEL clone strategy. The reason is the
	// stamp+root synthesizes the cloner UNCONDITIONALLY for every copyable-opaque instance, INCLUDING in a program
	// that never copies (drop-only) and so never reaches the copy-site reject: a struct/union element that is
	// `direct` at the top but owns a non-clonable field (a `Box with __ManagedFile`, a struct holding one)
	// would then root a `__clone_<T>` the cloner synthesizer cannot build and PANIC on a valid drop-only program
	// (`noteFieldCascadeNeeds`). Reading the full-graph classifier keeps the stamp/root envelope and the reject
	// envelope IDENTICAL, so neither can admit a cloner the other forbids. A non-clonable element's `copyFunc@32`
	// stays 0 — and such an instance is NEVER copied (a base that copies its opaque array with such an
	// instantiation is rejected at the front end off this identical classifier), so the 0 slot is never read. A
	// DROP-only instance of a non-clonable shape (`Container with (Array with String)`, dropped but never copied)
	// thus stamps `destroyFunc@40` but not `copyFunc@32`, exactly right — its element still DROPs through
	// `__managed_decref`, which needs no single-function-pointer form. Reads the SAME `managedOpaqueArrayElementOf`
	// walk as the drop stamp, so the two agree on which element they mean.
	function genericInstanceOpaqueArrayElementIsCopyable(id GenericInstanceId, position ElementIndex, uses InstanceParameterUses) returns bool
		let visited = ClonerSet.create()

		match self.managedOpaqueArrayElementOf(id, position: position, uses: uses) 'element'
			present(element) then return self.elementTypeSupportsCascade(element, visited: visited, purpose: GraphCascadePurpose.deepClone)
			absent then return false
		end 'element'
	end 'genericInstanceOpaqueArrayElementIsCopyable'

	// ⭐ **THE `.text` ELEMENT CLONER to bake into a managed-opaque-array-holding instance's descriptor
	// `copyFunc@32`** — the CLONE analogue of `typeParamDropCallee`. The
	// direct `(box) -> newBox` clone callee of the array's SUBSTITUTED element (a String → `__str_clone`, a
	// managed struct/union → its `__clone_<T>`, a trivial-element nested Array → `__managed_clone`), which the shared
	// opaque-copy wrapper reads back and `callIndirect`s per element. Routed through the SAME
	// `managedFieldCascadeStrategy` a concrete `Array with String` element uses (`containerElementCascadeStrategy`), so
	// the opaque stamp and the concrete stamp name the identical cloner. Precondition:
	// `genericInstanceOpaqueArrayElementIsCopyable(id)` — a `managedElements`/`unsupported` element panics as an
	// invariant break, exactly as `Parser.arrayElementCloneValue` does for the concrete top-level element.
	function managedOpaqueArrayElementCloneCallee(id GenericInstanceId, position ElementIndex, uses InstanceParameterUses) returns immutable ByteArray
		match self.managedOpaqueArrayElementOf(id, position: position, uses: uses) 'element'
			present(element) then return directCascadeCalleeOf(managedFieldCascadeStrategy(self, typeNames: self.typeNames, fieldType: element, asElement: true, action: CascadeAction.clone))
			absent then panic("ProgramSignatures.managedOpaqueArrayElementCloneCallee: instance {id} holds no managed opaque field at type-parameter position {position} — every caller gates on genericInstanceOpaqueArrayElementIsCopyable")
		end 'element'
	end 'managedOpaqueArrayElementCloneCallee'

	// The SUBSTITUTED type of an opaque field at type parameter `position` — the ONE walk the `copyFunc@32`
	// gate (`genericInstanceOpaqueArrayElementIsCopyable`) and its cloner (`managedOpaqueArrayElementCloneCallee`)
	// read, so neither can drift to a different field. It finds a substituted argument in TWO field shapes,
	// both resolved here so ONE stamp serves both: an opaque `Array with T` ELEMENT and a
	// BARE opaque `T` field. It also follows the parameter into every instance that takes it
	// as an argument (`InstanceParameterUses`), so a column one declaration down — an `Inner with T` field
	// whose own base holds `Array with T` — is found as well.
	// (The public predicates keep their "Array" names for their
	// out-of-tree call sites; the mechanism spans array elements AND bare fields.)
	//
	// ⛔⛔ **IT DOES NOT GATE `destroyFunc@40`, AND GATING IT HERE IS A LEAK.** The drop word is a
	// fact about the type ARGUMENT and this walk is a fact about the base's FIELD LIST — so a generic that
	// builds a record out of a borrowed `T` without ever declaring a `T`-typed field takes a reference through
	// `retainFunc@64` and releases it through a zero. `typeParamDropCallee` is the word's gate and its callee,
	// off the SAME `typeOwnershipProtocol` the retain reads; the paragraphs below measure the two wrong
	// answers of that same pair. The CLONE word stays here because
	// a clone genuinely is about the array COLUMN and not about the argument.
	//
	// ⛔⛔ **IT MAY NOT TAKE THE FIRST MANAGED OPAQUE FIELD OF ANY POSITION — THAT IS A WILD FREE.**
	// One descriptor carrying one `destroyFunc@40` makes a two-parameter generic's two columns share one
	// destructor: `type Pairs uses Key, Value` holding `Array with Key` and `Array with Value`, instantiated
	// `(String, Integer)`, stamps `__str_decref` on BOTH — the program prints the right answer and exits 139
	// at teardown, freeing its `Integer` column's words as String records. The descriptor is one block PER
	// PARAMETER (`layoutBlockOffsetFor`) and this walk answers for ONE of them, so a column is stamped with its
	// OWN argument's destructor or with nothing.
	//
	// ⛔⛔ **AND IT GATES ON THE *DROP* BOUNDARY (`instanceArgOwesDrop`), NOT ON THE *CONSUME* ONE
	// (`genericInstanceArgIsOwned`), WHICH IS A SILENT WRONG ANSWER.** The two
	// questions differ on EXACTLY one class, the co-owned trivial aggregate (managed,
	// not owned) — an all-scalar struct key, a trivial generic instance — and a `destroyFunc@40` read off the
	// narrow one leaves that class with a **RETAIN AND NO RELEASE**. The two words are stamped from one
	// descriptor a few lines apart, so two different predicates there means `retainFunc@64`
	// (`typeParamRetainCallee` → `typeOwnershipProtocol` → `typeIsManaged`) saying `__mm_retain` of a trivial
	// struct while this says "nothing to drop": `Map.grow()`'s rehash increfs every key through
	// `__retain_type_param` and the new column's element walk releases none of them.
	//
	// ⚠ **MEASURED, and it is a WRONG ANSWER with exit 0 and no diagnostic**: `Map with (Point, Val)` over an
	// all-scalar `Point`, filled in a LOOP, prints `total 0` where `total 15` is correct — `count()`
	// right, every key in the column dangling, because the caller BORROWED (the consume boundary is narrow by
	// design and stays so) and nothing on either side ever took a reference. See
	// `specs/map.md`'s `trivial-key-column-survives-rehash`.
	//
	// ⇒ **THE INVARIANT, recorded here because this is the walk that broke it TWICE: `destroyFunc@40` and
	// `retainFunc@64` are non-zero TOGETHER.** Two different FIELD questions behind one ARGUMENT
	// question leak; they are one expression apiece over one `typeOwnershipProtocol`
	// (`typeParamDropCallee` / `typeParamRetainCallee`), which is the arrangement the witness table's
	// `destroyFunc@8`/`retainFunc@16` pair has always held off one `existentialOwnershipProtocol`. A
	// reference taken through one word and released through the other cannot be balanced by two
	// predicates — in EITHER of their two halves.
	function managedOpaqueArrayElementOf(id GenericInstanceId, position ElementIndex, uses InstanceParameterUses) returns ManagedOpaqueArrayElement
		if not self.instanceArgOwesDrop(id, position: position) 'nothingToClone'
			return ManagedOpaqueArrayElement.absent
		end 'nothingToClone'

		uses.extendOver(self)
		let visited = OpaqueColumnReachSet.create()

		if not self.instanceParameterReachesAnOpaqueColumn(id, position: position, visited: visited, uses: uses) 'noColumnHoldsIt'
			return ManagedOpaqueArrayElement.absent
		end 'noColumnHoldsIt'

		return ManagedOpaqueArrayElement.present(self.canonicalInstanceArgAt(id, position: position))
	end 'managedOpaqueArrayElementOf'

	function instanceParameterReachesAnOpaqueColumn(id GenericInstanceId, position ElementIndex, visited OpaqueColumnReachSet, uses InstanceParameterUses) returns bool
		if self.instanceHoldsAnOpaqueColumnAt(id, position: position) 'aColumnOfItsOwn'
			return true
		end 'aColumnOfItsOwn'

		let parameter = parameterReachKey(self.genericInstanceBaseName(id), position: position)

		if visited.contains(parameter) 'alreadyWalked'
			return false
		end 'alreadyWalked'

		visited.insert(parameter)
		let sites = try uses.sitesOf(parameter) otherwise return false

		for site in sites 'eachSite'
			if self.instanceParameterReachesAnOpaqueColumn(site.instance, position: site.position, visited: visited, uses: uses) 'reachesThroughANestedInstance'
				return true
			end 'reachesThroughANestedInstance'
		end 'eachSite'

		return false
	end 'instanceParameterReachesAnOpaqueColumn'

	function parameterKeyOfInstanceArg(id GenericInstanceId, position ElementIndex) returns immutable ByteArray throws MapError
		let arg = self.instanceArgType(id, position: position)

		if maxonTypeTag(arg) != ValueTypeTag.typeParameter 'notAParameter'
			throw MapError.keyNotFound
		end 'notAParameter'

		let owner = try self.typeParamOwnerOf(typeParamIdOf(arg)) otherwise panic("ProgramSignatures.parameterKeyOfInstanceArg: type-parameter token {typeNameIdOf(arg)} has no owner — every declared parameter is filed as the sweep folds")
		return parameterReachKey(owner.declaringTypeName, position: owner.position)
	end 'parameterKeyOfInstanceArg'

	function instanceHoldsAnOpaqueColumnAt(id GenericInstanceId, position ElementIndex) returns bool
		// ⚠ **THIS IS THE SITE THE UNDECLARED HALF OF THE GATE WAS MEASURED ON.** The pre-pipeline root that
		// called this over EVERY interned instance is gone (see `MmRuntime.noteDestructorUsage`), but
		// `ensureLayoutDescriptor` still asks it of whatever a `with` named: a `Set with Int` (synthesized — no base struct to
		// iterate) and equally a `Map with (Int, Int)` or a misspelled `Foo with Int` (undeclared — E2055
		// already recorded, the build already doomed). Both hold no managed opaque `T` field, and both used
		// to reach `baseLayoutOf` below; the second killed the compiler with a stack trace instead of
		// printing the diagnostic it had already written. See `genericInstanceHasBaseLayout`.
		//
		// ⭐⭐ **AN `Array with T` IS ITS OWN COLUMN, AND THE FIELD WALK BELOW CANNOT SEE THAT.**
		// `stdlib/Array.maxon`'s one field is `managed as __ManagedMemory with Element`, which the envelope
		// collapse makes `Array with Element` — the very shape the `arrayField` arm below looks for — but
		// `Array` is a BUILTIN generic base, so `genericInstanceHasBaseLayout` stops the walk before it can
		// look (its header states that split, deliberately: a builtin has no declared layout to iterate). The
		// answer is not "absent", it is the instance's own type ARGUMENT: an `Array with String` holds
		// `String`s and nothing else, whatever a file does or does not declare.
		//
		// ⚠ **MEASURED as a DOUBLE FREE the day `stdlib/Array.maxon`'s own bodies started serving the calls.**
		// `slice`/`append` inside `type Array` are a SHARED generic body over an opaque `Element`, so they
		// emit `__managed_slice_opaque`/`__managed_append_opaque`, each of which branches on `copyFunc@32`. With this walk answering absent, the slot stayed 0 for `Array with String` too, the
		// wrapper took its TRIVIAL branch — a COW view that retains no ELEMENT — and both the view and its
		// parent then cascaded `__str_decref` over the same records: **0xC0000005 at teardown**, measured on
		// `Array with String`, `Array with <struct>`, `Array with <enum>` and `Array with <union>` alike, and
		// on 25 `array-slice-managed-elements` / `array-clone-managed-elements` / `array-sort` cases (a
		// corpus `Array.clone` reaches this walk through its own `managed.slice(0, len)`). The concrete
		// surface never showed any of it, because a concrete receiver picks `__managed_slice_managed` at
		// the call site and never reads a descriptor.
		//
		// ⚠ **POSITION 0 IS NOT AN ASSUMPTION**: an `Array` takes exactly one type parameter, so its element
		// is its only argument, and a `position` past that finds nothing exactly as the field walk would.
		//
		// ⛔⛔ **AND THE ELEMENT IS THE ARGUMENT'S CANONICAL FORM, NOT ITS SWEEP SPELLING.**
		// `managedOpaqueArrayElementOf` answers `canonicalInstanceArg`, because this walk's whole output is
		// spent on NAMING A
		// PER-TYPE RUNTIME ENTRY — the `copyFunc@32` cloner and the deep-clone gate in front of it — and only
		// the canonical tuple layout is committed to the registry `installStructCascades` walks. Answering the
		// raw spelling stamped `__clone___Tuple2.String.Integer` into the descriptor of an
		// `Array with (String, Integer)` and the PE writer died with `it was never installed`.
		if self.isArrayInstance(id) 'theArrayIsTheColumn'
			return position == 0
		end 'theArrayIsTheColumn'

		if not self.genericInstanceHasBaseLayout(id) 'noFields'
			return false
		end 'noFields'

		let layout = self.baseLayoutOf(id)

		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldType = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.instanceHoldsAnOpaqueColumnAt: fieldTypes.get OOB at {i}")

			// An opaque `Array with T` field: the descriptor drops each ELEMENT.
			if self.denotesArrayInstance(fieldType) 'arrayField'
				let element = self.containerElementType(self.denotedArrayInstance(fieldType))

				if maxonTypeTag(element) == ValueTypeTag.typeParameter 'opaqueElement'
					if self.opaqueTypeParamPosition(element) == position 'thisPositionsColumn'
						return true
					end 'thisPositionsColumn'
				end 'opaqueElement'

				continue
			end 'arrayField'

			// A BARE opaque `T` field (`saved as Element`): a reassignment drops the field ITSELF through the
			// SAME block's `destroyFunc@40` — that parameter's argument destructor, exactly as
			// above.
			if maxonTypeTag(fieldType) == ValueTypeTag.typeParameter and self.opaqueTypeParamPosition(fieldType) == position 'opaqueBareField'
				return true
			end 'opaqueBareField'
		end 'eachField'

		return false
	end 'instanceHoldsAnOpaqueColumnAt'

	// ⭐ **THE ONE "does this type own droppable heap?" CLASSIFIER.** A String (`__str_decref`), a struct
	// box (a struct is always a heap box, dropped through its `__destruct_<T>` or the trivial
	// `__mm_decref`), a boxed union, a GENERIC INSTANCE (a base-struct box, dropped through its own
	// instance destructor or `__mm_decref`) and a function value (`__mm_decref`) are managed; a scalar
	// (int/bool/float/ExitCode, a ranged alias, a payload-free enum) and an opaque type PARAMETER (a
	// borrow) are not. `structFieldIsManaged` (a struct field) and the generic-instance field
	// classification delegate here, so "managed" means ONE thing across struct and instance — the
	// dropped set, the moved-in set and the usage gates agree by construction.
	//
	// ⚠ **`classifyUnionPayload` DOES NOT DELEGATE HERE.** It is a
	// SECOND implementation of the same question and a deliberate one: it must name the KIND (String vs
	// struct vs nested union vs float) and carry the storage type, where this answers a `bool`
	// ALLOCATION-FREE — which is exactly why neither is folded into the other
	// (`Parser.requireContainerElementType`'s header prices the alternative at one `PayloadClass` box per
	// trivial-element `push` site, and this door must reach its `false` for a scalar field without boxing a
	// `DeclaredStruct`). Delegating here to `denotedSlotType` would cost an `into.intern` per read, so it
	// deliberately does not.
	//
	// ⛔ **A DISAGREEMENT IS A READ-AFTER-FREE** — a `Holder with IntBox` field MANAGED here and
	// `undeclaredName` there. The name cascade is `denotedSlotType`'s, and what is written twice is
	// only its *projection* — this one to a `bool`, that one through the shared door to a type.
	//
	// ⭐⭐ **AND THE COVERAGE IS BY CONSTRUCTION: BOTH PROJECTIONS READ ONE `declaredFormOf`.**
	// The name half of this door is `declaredNameIsManaged`, an EXHAUSTIVE `match` over `TypeDeclKind`, and
	// so is `denotedSlotType`'s. Neither has a cascade of its own to fall out of step, and a ninth
	// declaration form is a COMPILE ERROR at both rather than a residual: a FORM taught to one and not the
	// other reads MANAGED there and `false` here, so the field
	// is moved in and dropped by NOBODY — a leak, exit 101 — while the converse double-frees.
	//
	// ⛔⛔ **THE *ORDERS* ARE NOT SAFE BY CONSTRUCTION, AND THAT IS MEASURED.** The tempting argument is that
	// differing registry orders decide something only for a name held by TWO registries at once, which
	// **E3006** and **E3061** refuse. Both codes do fire — but they are reported by a whole-program CHECK
	// that runs *after* these classifiers have already answered during the parse, so an ILL-FORMED program
	// DOES put one name in two registries here. MEASURED: with the alias registries asked first,
	// `type Box … end` + `typealias Box = int(0 to 10)` reaches `Parser.decrefCalleeFor` for the struct box
	// it has just built and PANICS before E3006 can print. That is why `declaredFormOf` asks declared
	// TYPES before aliases, and why the order is not a cost choice. **Do not re-derive that argument from
	// the codes' existence: the codes are late.**
	//
	// ⚠⚠ **`from` IS THE INTERNER `fieldType`'s `named` ID WAS MINTED AGAINST, AND IT IS A PARAMETER
	// BECAUSE THE ANSWER IS OTHERWISE DECIDED BY INTERNING ORDER.** A `named` type is only a NUMBER; the
	// name — and with it struct-hood, union-hood and alias-hood — comes out of the table that assigned it.
	// This index's own callers pass `self.typeNames`; a caller holding a type that has been ADOPTED into a
	// file-local artifact interner (`fieldTypeOf(…, into:)`) passes THAT one. It is the same discipline
	// `classifyUnionPayload`, `managedFieldDropCallee` and `foreignNameOf` already state — a type crossing
	// into this index carries the interner named alongside it.
	//
	// An artifact-interned id resolved against `self.typeNames` classifies by whatever name holds that
	// NUMBER in the program-wide table, silently and in both directions: a scalar alias or
	// payload-free `enum` field reads MANAGED and a legal read is refused, and a boxed-UNION field
	// reads SCALAR and a read out of a temporary is left holding a freed box. A single-file program
	// cannot show it, because its two tables are folded in the same order and every id coincides. Both
	// directions are pinned by `specs/cross-file-field-classification.md`.
	//
	// It is answered allocation-free for the overwhelming scalar-field majority — a tag test, then
	// `declaredFormOf`'s `Map.contains`/`Map.get` probes over a payload-free enum, which is a scalar — which
	// matters because a scalar field must reach the `false` return without boxing a
	// `DeclaredStruct`/`DeclaredEnum`. That is why the form answer is an enum and not a `DeclaredEnum`-shaped
	// union, and why `declaredEnumIsBoxed` reads `enumTypes` directly rather than through `enumOf`.

	// ⭐⭐ **"DOES A CONTEST HAND *THIS* READER A PLAIN SCALAR BY THIS NAME?"** — narrower than
	// `readerMeansKind`, and the difference is the whole of it: that door answers `true` for an UNCONTESTED
	// name (one kind holds it, so the reader means that kind), which is exactly the wrong answer for a
	// caller asking "may I ignore what the whole-program registry says". This one is false unless a contest
	// is really in play.
	export function contestGivesThisReaderAScalar(name ByteArray, readerFilePath FilePath) returns bool
		if not self.crossKindContested(name) 'oneKindHoldsTheName'
			return false
		end 'oneKindHoldsTheName'

		return self.contestedTypeNameKindFor(name, readerFilePath: readerFilePath) == TypeDeclKind.rangedAlias
	end 'contestGivesThisReaderAScalar'

	// ⭐⭐ **`typeIsManaged` ASKED ON A FILE'S BEHALF — and ONLY its `named` arm can differ.**
	//
	// ⛔⛔ **MEASURED, twice, with name-only controls.** A `mutable` (by-reference) parameter declared with a
	// contested name reaches the MM tier as a bare `named`, and `declaredNameIsManaged` answered off the
	// OTHER file's declaration: `useA(mutable c Container)` doing `c = 4`, in a file whose `Container` is
	// `int(0 to 5)`, emitted `__mm_incref` on the literal 4 and `__mm_decref` on a header at address 2 —
	// **exit 139** against a control of 7, for a boxed-union claimant AND for a `type Widget` one. The panic
	// string two blocks up in the same function still read *"outside typealias 'Container'"*: the compiler
	// knew it was a ranged alias while the MM tier disagreed, inside one function body.
	//
	// ⭐ **THE BOUND — why this is a sibling and not a reader threaded through the whole tier.** A bare
	// `named` reaching a PARSER caller is either (a) the reader's own RANGED alias or (b) the reader's own
	// enum/union; every other kind the reader could mean is re-tagged before the MM tier sees it, by doors
	// that are already reader-aware (`resolveNamedStruct`→`structRef`, `isAliasOfFormFor`→`genericInstance`
	// or `structRef`, the interface arm→`interfaceRef`, `resolveFloatAliasType`→`float`). And
	// (b) is safe: the only arm of `declaredFormInAnyFile` that could steal an enum name is `structSlots`,
	// and `type X` + `enum X` are two NOMINALS that never coexist. So the one correction owed is (a), and
	// `declaredNameIsManaged` keeps the reader-free contract its own header argues for — which is what the
	// genuinely file-less callers (containers, struct-field cascades, destructor stamps) need.
	//
	// ⚠⚠ **THE LEAK DUAL IS UNMEASURED, AND THAT IS SAID OUT LOUD RATHER THAN ASSUMED.** The argument that a
	// reader meaning a MANAGED kind can never be told "unmanaged" is that the two `false` arms
	// (`rangedAlias`, `functionAlias`) sit after every managed arm in `declaredFormInAnyFile`, and that a
	// reader meaning a tuple or generic alias never arrives here as `named` because those are re-tagged.
	// **That is reasoning, not a measurement.** ⚠ ONE construction was attempted and did NOT reach this door:
	// a `typealias Pair = (Coord, Coord)` against another file'''s `typealias Pair = int(0 to 5)`, reassigned
	// by reference so the cell asks the tier — the tuple side re-tagged to `structRef` before arrival and the
	// program matched its name-only control exactly (exit 14 both ways). The two candidate pairs are
	// (ranged, tuple) and (ranged, generic), since every earlier arm of `declaredFormInAnyFile` is a nominal
	// kind that cannot coexist with a nominal; both are re-tagged, which is the argument. ⇒ If a kind is ever
	// allowed to reach the MM tier as a bare `named`, this property stops holding and the failure would be a
	// LEAK (exit 101) rather than a fault — quieter than every defect this family has produced so far.
	export function typeIsManagedFor(fieldType MaxonType, from TypeNameInterner, readerFilePath FilePath) returns bool
		if self.namedTypeIsThisReadersScalar(fieldType, from: from, readerFilePath: readerFilePath) 'thisFileMeansAScalar'
			return false
		end 'thisFileMeansAScalar'

		return self.typeIsManaged(fieldType, from: from)
	end 'typeIsManagedFor'

	// `typeOwesDrop` on a file's behalf — the ownership projection of the door above, corrected in the same
	// one place, so a caller that must choose between the two (see `typeOwesDrop`) still chooses between two
	// doors that agree about a contested name.
	export function typeOwesDropFor(fieldType MaxonType, from TypeNameInterner, readerFilePath FilePath) returns bool
		if self.namedTypeIsThisReadersScalar(fieldType, from: from, readerFilePath: readerFilePath) 'thisFileMeansAScalar'
			return false
		end 'thisFileMeansAScalar'

		return self.typeOwesDrop(fieldType, from: from)
	end 'typeOwesDropFor'

	// The one correction both doors above make, written once: is this a bare `named` whose name a CONTEST
	// hands this reader as a plain scalar? Every other tag, and every uncontested name, falls through.
	function namedTypeIsThisReadersScalar(fieldType MaxonType, from TypeNameInterner, readerFilePath FilePath) returns bool
		if maxonTypeTag(fieldType) != ValueTypeTag.named 'carriesNoContestableName'
			return false
		end 'carriesNoContestableName'

		return self.contestGivesThisReaderAScalar(self.denotedAggregateName(foreignNameOf(from, id: typeNameIdOf(fieldType))), readerFilePath: readerFilePath)
	end 'namedTypeIsThisReadersScalar'

	export function typeIsManaged(fieldType MaxonType, from TypeNameInterner) returns bool
		let tag = maxonTypeTag(fieldType)

		// `tagIsByteRecord`: "does this own heap?" is a question about the REPRESENTATION, and a Character
		// owns exactly the record a String does. This is the root every other managed classifier delegates
		// to, so answering "no" here would leak a Character field, element and payload at once.
		if tagIsByteRecord(tag) 'aByteRecord'
			return true
		end 'aByteRecord'

		if tagNamesADeclaredType(tag) 'aDeclaredType'
			return not self.typeNameIdIsInlineRecord(typeNameIdOf(fieldType), from: from)
		end 'aDeclaredType'

		// ⭐ **EVERY GENERIC INSTANCE IS A BASE-STRUCT BOX — EXCEPT THE ONE THAT IS A GREEN-THREAD
		// HANDLE.** `Promise with T` / `Promise with (T, E)` names a pointer into the scheduler's own
		// slab, reclaimed by `__gt_promise_drop` and never by a refcount, so a slot holding one owes no
		// CLONE and no RETAIN. The whole argument is on `PromiseType.maxon`.
		//
		// ⛔⛔ **BUT THIS ARM DOES NOT SAY "OWES NO DROP" — THAT THIRD IS A LEAK.** "Not
		// refcounted" and "owes nothing" are different facts, and reading the first as the second
		// stamps `element_destroy@40 = 0` on every `Array with Promise` and leaves `structHasManagedField`
		// blind to a promise field: the container dies, its elements' threads are never reclaimed, and
		// the GT live count reports the leak as exit **75**. A promise owes exactly one drop, taken through
		// `__gt_promise_drop`. ⇒ **`typeIsManaged` is the NARROW question (is this an `__mm` box — may it
		// be retained, may it be cloned) and `typeOwesDrop` below is the OWNERSHIP question**; a destructor
		// stamp must ask the latter.
		if tag == ValueTypeTag.genericInstance 'instance'
			return not self.instanceIsPromiseHandle(genericInstanceIdOf(fieldType))
		end 'instance'

		// ⭐ **AN EXISTENTIAL IS MANAGED, AND IT IS THE ONE MANAGED SLOT WHOSE DESTRUCTOR IS A RUN-TIME
		// FACT.** Its VALUE half is whatever the conformer's record is — a heap box for
		// every user conformer — so the slot owes exactly one drop, taken through `__drop_existential` off the
		// witness's `destroyFunc@8` (0 for an `int`/`bool`/`float` conformer, which is what makes a
		// scalar-conformer existential inert rather than a wild free). Answering `false` here is what leaked
		// every interface-typed field: `structHasManagedField` skips the type, no cascade is synthesized, and
		// the conformer is never released.
		if tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.function 'existentialOrFunction'
			return true
		end 'existentialOrFunction'

		if tag != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		// The lookup below is keyed by the NAME, so it is interner-independent once the name is in hand —
		// `classifyUnionPayload`'s arrangement, for its reason.
		// ⭐ A TUPLE-ALIAS field (`export var p as Pair`) resolves to the tuple's own name here, so the
		// struct arm answers it — a tuple IS a struct box, and left unresolved it read as a scalar, the
		// field was dropped by nobody and the program exited 101 on the leak gate. See `denotedAggregateName`.
		return self.declaredNameIsManaged(self.denotedAggregateName(foreignNameOf(from, id: typeNameIdOf(fieldType))))
	end 'typeIsManaged'

	// ⭐⭐ **"DOES A SLOT OF THIS TYPE OWE A DROP?" — THE OWNERSHIP PROJECTION, AND THE ONE A DESTRUCTOR
	// STAMP MUST ASK.** It is `typeIsManaged` widened by exactly one case: a green-thread handle, which is
	// not an `__mm` box (so it may not be retained or cloned) and DOES owe a reclaim (so a container, a
	// struct field, a union payload or a generic type-argument slot holding one must drop it).
	//
	// ⚠ **THE TWO ARE DELIBERATELY NOT ONE PREDICATE, AND MERGING THEM BREAKS ONE CALLER OR THE OTHER.**
	// Answer `typeIsManaged` where a stamp is owed and the thread leaks (exit 75); answer
	// `typeOwesDrop` where a RETAIN is emitted and `__mm_retain` is called on a pointer into the scheduler's
	// slab, corrupting a header that is not a header. Every caller therefore has to choose, and the choice
	// is legible: **retain/clone/"is this a box" → `typeIsManaged`; destructor stamp / drop routing /
	// "must this slot be reclaimed" → `typeOwesDrop`.**
	export function typeOwesDrop(fieldType MaxonType, from TypeNameInterner) returns bool
		if self.typeIsManaged(fieldType, from: from) 'aManagedRecord'
			return true
		end 'aManagedRecord'

		return self.typeIsAGreenThreadHandle(fieldType, from: from)
	end 'typeOwesDrop'

	// Is this type a promise — the one slot that owes a drop without being a box?
	//
	// ⛔⛔ **IT TAKES THE INTERNER AND RESOLVES A NAME, OR THE STAMP IS INERT.** `typealias IntPromise =
	// Promise with Integer` reaches every classifier tagged `named`, NOT `genericInstance`, so a
	// tag-only test answered `false` for the exact spelling every real program uses. MEASURED: with
	// the stamp switched to `typeOwesDrop` and this predicate tag-only, `__managed_create` was still
	// emitted `movRegImm32 rdx, 0` — a green fix over an unchanged wrong answer. `typeIsManaged`'s
	// `genericAlias` arm carries the same warning in prose (*"it is needed at BOTH because a
	// `typealias StrPromise = Promise with String` reaches this door by NAME"*); this is that warning
	// obeyed.
	export function typeIsAGreenThreadHandle(fieldType MaxonType, from TypeNameInterner) returns bool
		let tag = maxonTypeTag(fieldType)

		if tag == ValueTypeTag.genericInstance 'instance'
			return self.instanceIsPromiseHandle(genericInstanceIdOf(fieldType))
		end 'instance'

		if tag != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		return self.declaredNameIsAGreenThreadHandle(self.denotedAggregateName(foreignNameOf(from, id: typeNameIdOf(fieldType))))
	end 'typeIsAGreenThreadHandle'

	// Does a value of the tuple `name` carry a promise in some element, at any nesting depth? A tuple that does
	// hands a green thread over exactly as the promise itself would.
	export function tupleCarriesAGreenThreadHandle(name ByteArray) returns bool
		let layout = try self.registeredLayout(name) otherwise panic("ProgramSignatures.tupleCarriesAGreenThreadHandle: `{String.from(name)}` is not registered — every tuple `structRef` names a layout `internTupleType` registered")

		for element in layout.fieldTypes 'eachElement'
			if self.typeIsAGreenThreadHandle(element, from: self.typeNames) 'aPromise'
				return true
			end 'aPromise'

			if tagNamesADeclaredType(maxonTypeTag(element)) and internedNameIsATupleTypeName(self.typeNames, id: typeNameIdOf(element)) and self.tupleCarriesAGreenThreadHandle(self.nameOfId(typeNameIdOf(element))) 'aNestedTupleCarriesOne'
				return true
			end 'aNestedTupleCarriesOne'
		end 'eachElement'

		return false
	end 'tupleCarriesAGreenThreadHandle'

	// The NAME half, mirroring `declaredNameIsManaged`'s two promise exemptions exactly — a canonical mint
	// (`Promise_Integer`) and a `genericAlias` (`IntPromise`). It is the same two arms read in the POSITIVE
	// direction, which is why it is written beside them: an exemption added there and not here would make a
	// promise unmanaged AND undroppable, a leak.
	function declaredNameIsAGreenThreadHandle(name ByteArray) returns bool
		if self.isCanonicalInstanceName(name) 'aRenderedInstance'
			return self.renderedNameIsPromiseHandle(name)
		end 'aRenderedInstance'

		return match try self.declaredFormInAnyFile(name) otherwise return false 'form'
			structType or
			enumType or
			unionType or
			interfaceType or
			rangedAlias or
			functionAlias or
			tupleAlias gives false
			genericAlias gives self.instanceIsPromiseHandle(self.bareGenericAliasInstance(name))
		end 'form'
	end 'declaredNameIsAGreenThreadHandle'

	// Is `name` the CANONICAL rendering of an interned generic instance? The registry is keyed by the
	// instance's structural KEY and its canonical NAME is derived, so the reverse direction needs an index of
	// its own — `canonicalInstanceNameIndex`, whose header carries the measurement of the quadratic the walk
	// this replaces was running. ONE probe now, over an index kept complete by `indexCanonicalInstanceNames`.
	export function isCanonicalInstanceName(name ByteArray) returns bool
		self.indexCanonicalInstanceNames()
		return self.canonicalIndexHolds(name)
	end 'isCanonicalInstanceName'

	// ⭐ **WHICH INSTANCE `name` IS THE CANONICAL RENDERING OF, *IF NO DECLARATION CLAIMS THE SPELLING*** —
	// the half of the same probe that carries the id, for the callers that must go on to ask something of the
	// instance itself (its base declaration, its drop, its display spelling). `MapError.keyNotFound` for a
	// name no instance renders to, which is every ordinary declared name: the miss is the common case here
	// and never an invariant violation.
	//
	// ⛔⛔ **THE PRECEDENCE IS THE WHOLE OF THIS DOOR, AND WITHOUT IT THE MINT WINS AND THE PROGRAM FAULTS.**
	// A canonical mint is not a reserved spelling: `specs/type-name-collision.md` writes
	// `type Box_String` beside a `Box with String`, and every one of its cases is about those two claimants
	// staying DIFFERENT objects with different cascades. Let the mint win and a DECLARED struct's drop, clone
	// or conformance is routed through the INSTANCE's — MEASURED, with the index asked ahead of the
	// registries: six of that spec's cases went red at once, two LEAKING (exit 101) and four FAULTING
	// (0xC0000005). `declaredFormOf`'s own header states the identical rule one rank up — declared types are
	// asked before aliases, and *"the order is not a cost choice"* — and this is that rule's last rank: a
	// declaration of ANY form outranks a name the compiler minted.
	export function renderedInstanceOfUnclaimedName(name ByteArray) returns GenericInstanceId throws MapError
		if self.nameIsDeclared(name) 'aDeclarationClaimsTheSpelling'
			throw MapError.keyNotFound
		end 'aDeclarationClaimsTheSpelling'

		self.indexCanonicalInstanceNames()
		return try self.canonicalIndexed(name)
	end 'renderedInstanceOfUnclaimedName'

	// Does ANY declaration claim this spelling? The bool half of `declaredFormOf`, for the callers that need
	// the PRECEDENCE and not the form. Every arm answers `true` because the form is not the question; they
	// are written out rather than collapsed to a range for `declaredFormOf`'s own stated reason — a case
	// appended to `TypeDeclKind` must fail to compile here rather than be swallowed.
	export function nameIsDeclared(name ByteArray) returns bool
		return match try self.declaredFormInAnyFile(name) otherwise return false 'form'
			structType or
			enumType or
			unionType or
			interfaceType or
			rangedAlias or
			functionAlias or
			genericAlias or
			tupleAlias gives true
		end 'form'
	end 'nameIsDeclared'

	// Bring `canonicalInstanceNameIndex` up to date with every instance interned so far — the SOLE writer of
	// that index and of its watermark, so "which ids are in it" is one fact rather than two.
	//
	// ⚠ A write past the settled baseline — a parse's own rows, or a merge's — is journaled with the entry it
	// replaced, so `rewindJournaledWrites` puts the index back exactly.
	function indexCanonicalInstanceNames()
		while self.canonicalNamesIndexedThrough < self.rowCount() 'eachNewInstance'
			let id = self.rowIdAt(self.canonicalNamesIndexedThrough)
			let name = self.canonicalInstanceName(id)

			if self.baseline.settled 'pastTheBaseline'
				self.journal.noteCanonicalIndexWrite(name, prior: priorInstanceAt(self.canonicalInstanceNameIndex, name: name))
			end 'pastTheBaseline'

			self.canonicalInstanceNameIndex.upsert(name, value: id)
			self.canonicalNamesIndexedThrough = self.canonicalNamesIndexedThrough + 1
		end 'eachNewInstance'
	end 'indexCanonicalInstanceNames'

	// ⭐⭐ **DOES A VALUE OF THIS DECLARED NAME OCCUPY MORE THAN ONE MACHINE WORD?** The WIDTH question, and
	// it is a different one from `declaredNameIsManaged`'s ownership question — an existential is neither
	// refcounted nor one word. Exactly one declared form answers yes: an INTERFACE type, whose value is the
	// 16-byte fat pointer `(value, witness)`.
	//
	// ⚠ The ownership door answers `false` for an interface, so reading this fact off it lets E3120
	// admit an associated type bound to an interface NAME: the requirement's impl receives one word
	// where the fat pointer's two are passed, and the program faults.
	export function declaredNameIsFatPointer(name ByteArray) returns bool
		match try self.declaredFormInAnyFile(name) otherwise return false 'form'
			interfaceType then return true
			structType or
			enumType or
			unionType or
			rangedAlias or
			functionAlias or

			// ⚠ **`genericAlias` STAYS `false` EVEN THOUGH `IntegerSeq = Seq with Integer` DENOTES AN
			// EXISTENTIAL, and the reason is that this door never meets that spelling.** Its callers pass a
			// binding's `nominal` identity or an instance's canonical name, and an existential alias's
			// identity is its interface's name (`requirementTypeOfDeclared`'s `interfaceRef` arm), so the
			// alias reaches the `interfaceType` arm above under the bare name. Answering it here as well
			// would be a second reading of one fact, reachable by nothing;
			// `parameterized-existential.error.associated-type-bound-to-an-existential-alias` pins the
			// identity this rests on.
			genericAlias or
			tupleAlias then return false
		end 'form'
	end 'declaredNameIsFatPointer'

	// Does a slot declared with the bare NAME `name` own droppable heap — the name half of `typeIsManaged`,
	// over the ONE name→FORM answer (`declaredFormOf`) so a new form cannot read managed at one door and
	// scalar here.
	//
	// A name no registry holds is not managed: it is E3011's subject, and a slot the front end refuses owns
	// nothing to drop.
	//
	// ⚠ **ALLOCATION-FREE PER ASK, WHICH IS `typeIsManaged`'S STANDING OBLIGATION — but AMORTIZED, not
	// literal, and the difference is worth one sentence.** `isCanonicalInstanceName` below tops up
	// `canonicalInstanceNameIndex` before it probes, and topping up allocates: one `Set` entry, plus
	// whatever `canonicalInstanceName` mints, per instance interned since the last ask. That is bounded by
	// the instance COUNT over the whole compile rather than by the number of asks, and `deriveInstanceNames`
	// has already driven it to completion before the parse — the fan-out this obligation exists for — so
	// every ask on the hot path is genuinely a probe. It is not a literal allocation-free guarantee.
	export function declaredNameIsManaged(name ByteArray) returns bool
		// ⚠ **A GENERIC INSTANCE ARRIVES AS ITS CANONICAL NAME AT SOME DOORS, AND NO REGISTRY IS KEYED BY
		// THAT.** `genericAliases` holds the ALIAS (`IntBox`); `renderDeclaredTypeName` renders an
		// instance as `canonicalInstanceName` (`Box_Integer`), which `declaredFormOf` matches nothing for
		// — so the walk below would fall through to `return false` and call a heap box unmanaged, and
		// `implements Maker with IntBox` would leak (exit 101). Asked FIRST because it is the one form
		// whose name the registries cannot see, and answered `true` for the same reason the
		// `genericAlias` arm below is: an instance is a heap box — an `Array`'s record and buffer, a
		// `Box`'s box.
		if self.isCanonicalInstanceName(name) 'aRenderedInstance'
			return not self.renderedNameIsPromiseHandle(name)
		end 'aRenderedInstance'

		if let layout = try self.registeredLayout(name) 'aDeclaredType'
			return not self.layoutPacksInlineIntoAWord(layout)
		end 'aDeclaredType'

		let form = try self.declaredFormPastStructTypes(name) otherwise return false

		match form 'form'
			structType then panic("ProgramSignatures.declaredNameIsManaged: `declaredFormPastStructTypes('{String.from(name)}')` answered `structType` — that door starts BELOW the struct registry, which the probe above already read")

			// A payload-free enum's value IS its i64 tag — a scalar; a payload-bearing one's is a heap box
			// or a tagged word. `carriesPayloads` is the same bit `unionBoxDropCallee` routes on, so what is
			// called managed here is exactly what gets a drop there.
			enumType or
			unionType then return self.declaredEnumIsBoxed(name)

			// ⭐ An interface-typed slot owns its conformer's record — the same answer `typeIsManaged`'s
			// `interfaceRef` arm gives, which is where the reasoning lives. This arm is reached by NAME
			// rather than by tag: a conformer name handed to `existentialDestroyCallee`, and any `named`
			// annotation `normalizeSweptInterfaceTypes` did not re-tag.
			interfaceType or

			// A tuple IS a struct box. `denotedAggregateName` above resolves a tuple alias to the tuple's own
			// canonical name before this is asked, so this arm is reached only if that resolution is ever
			// narrowed — and it must then still answer `true`, or the tuple leaks (exit 101).
			tupleAlias or
			functionAlias then return true

			// A ranged int or float alias IS its primitive — a scalar either way.
			rangedAlias then return false

			// A generic instance is a heap box — an `Array`'s record + buffer, a `Box`'s box — so it is
			// managed and dropped by the owning struct's cascade. ⚠ EXCEPT a `Promise` instance, whose value
			// is a green-thread handle owning no record — the same exemption the `genericInstance`
			// TAG arm above makes, and it is needed at BOTH because a `typealias StrPromise = Promise with
			// String` reaches this door by NAME. `bareGenericAliasInstance` is total under this arm's own
			// precondition (`declaredFormOf` answered `genericAlias`, which is `genericAliases.contains`).
			genericAlias then return not self.instanceIsPromiseHandle(self.bareGenericAliasInstance(name))
		end 'form'
	end 'declaredNameIsManaged'

	// Is the CANONICAL mint `name` (`Promise_String`) the rendering of a promise-handle instance?
	// The canonical-name arm of `declaredNameIsManaged` needs the id its own probe already found; a name the
	// index cannot resolve is not an instance at all, so it is a box by that arm's own default.
	function renderedNameIsPromiseHandle(name ByteArray) returns bool
		return self.instanceIsPromiseHandle(try self.renderedInstanceOfUnclaimedName(name) otherwise return false)
	end 'renderedNameIsPromiseHandle'

	// Is the declared enum/union `name` BOXED (some case carries a payload)? The layout lookup split out so
	// the two `declaredFormOf` arms that need it share one spelling, and answered over `enumTypes` directly
	// rather than through `enumOf`, which boxes a `DeclaredEnum` — `typeIsManaged` must not allocate.
	// The declaration is a precondition: only a `declaredFormOf` that answered `enumType`/`unionType` gets here.
	function declaredEnumIsBoxed(name ByteArray) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise panic("ProgramSignatures.declaredEnumIsBoxed: `declaredFormOf({String.from(name)})` answered enum/union but `enumTypes.get` failed — the form is derived from that very table")
		return layout.carriesPayloads()
	end 'declaredEnumIsBoxed'

	// Does struct `structName` own droppable heap in ANY field — the union-side `unionHasManagedField`
	// generalised to a struct, and the gate that decides whether the struct needs a `__destruct_<Struct>`
	// cascade at all (a scalar-only struct's drop is the trivial `__mm_decref`). Answered over the index's
	// own interner, allocation-free per scalar field, exactly as `structFieldIsManaged` is — it is the loop
	// around that per-field predicate, kept ONE function so the destructor synthesis, its usage gate and the
	// caller-side drop routing agree on what "managed" means by construction.
	//
	// The struct is a precondition, not a case: every caller reached here through a `structOf` that answered
	// `declared`.
	// ⭐ **DOES THIS STRUCT OWE A DESTRUCTOR AT ALL?** The gate `installOneStructDestructor` and
	// `structBoxDropCallee` read — the OWNERSHIP twin of `structHasManagedField`. A struct whose only owning
	// field is a promise answers `false` there and `true` here, and the difference is a leak: the destructor
	// is never synthesized and the field's green thread dies with the box (exit 75, no `__destruct_<T>` in
	// the emitted IR at all).
	export function structHasFieldOwingDrop(structName ByteArray) returns bool
		return self.structHasFieldSatisfying(structName, owning: FieldOwnershipQuestion.owesDrop)
	end 'structHasFieldOwingDrop'

	export function structHasManagedField(structName ByteArray) returns bool
		return self.structHasFieldSatisfying(structName, owning: FieldOwnershipQuestion.isAManagedRecord)
	end 'structHasManagedField'

	// A tuple none of whose elements owes a drop, the only kind a shallow copy gives value semantics.
	// `Parser.valueIsCopyableTuple` and the E3217 predicate (`recordNeedsACapabilityWord`) both ask
	// it, so a tuple the parser copies at a hand-off is a value to the capability rule too.
	//
	// ⛔ **A SLOT STANDING AT A BARE TYPE PARAMETER IS NOT A TRIVIAL ELEMENT, AND
	// `structHasFieldOwingDrop` CANNOT SEE IT.** `typeIsManaged` answers `false` for a
	// `typeParameter`, so `recordRestsAnOpaqueSlot` is asked beside it: a `(K, V)` tuple read as
	// copyable takes a second pointer to a reference the source record owns, and one of the two
	// releases it.
	export function nameIsACopyableTuple(name ByteArray) returns bool
		return isTupleTypeName(name) and not self.structHasFieldOwingDrop(name) and not self.recordRestsAnOpaqueSlot(name)
	end 'nameIsACopyableTuple'

	// ⭐ **THE WALK, WRITTEN ONCE.** The two questions above differ in ONE predicate and in nothing else — the
	// registry fetch, its panic, the loop and the `false` fallthrough were identical, which is the shape this
	// file's own `structFieldDeclaredType` header calls out (*"written once because it was written three
	// times and each copy carried its own two panic messages saying the same two things"*). A third ownership
	// question later adds an arm here rather than a fourth copy of the loop.
	function structHasFieldSatisfying(structName ByteArray, owning FieldOwnershipQuestion) returns bool
		let layout = self.structLayoutOf(structName)

		for i in 0 upto layout.fieldCount() 'eachField'
			let holds = match owning 'question'
				owesDrop gives self.structFieldOwesDrop(structName, index: i)
				isAManagedRecord gives self.structFieldIsManaged(structName, index: i)
			end 'question'

			if holds 'satisfied'
				return true
			end 'satisfied'
		end 'eachField'

		return false
	end 'structHasFieldSatisfying'

	// ⭐ **THE UNION TWIN OF `structHasManagedField`, AND BY NAME FOR THE IDENTICAL REASON**: the layout comes
	// out of THIS index's own `enumTypes` and is read over THIS index's own interner, so a caller cannot pair
	// a layout from one registry with an interner from another. The free `unionHasManagedField` still takes
	// both, because its other callers legitimately hold a PROJECT layout and pass `project.typeNames` — a
	// correctly-matched pair. This is the entry for a caller that holds only a NAME.
	//
	// ⚠⚠ **A LAYOUT-AND-FOREIGN-INTERNER PAIRING IS A REACHABLE COMPILER PANIC ON A VALID PROGRAM,
	// MEASURED.** `managedNameDropCallee`'s STRUCT arm already asked by name
	// (`structHasManagedField`); its UNION arm fetched `enumInAnyFile(name)`'s layout — a SIGNATURES
	// layout — and resolved that layout's payload ids against the CALLER's `project.typeNames`. In ONE
	// file the two tables fold in the same order and every id coincides; ACROSS files they diverge, so
	// a `some(v Num)` payload whose `Num` is a ranged alias misresolved and the union read MANAGED,
	// demanding a `__destruct_<U>` — while `installUnionDestructors` asked the SAME question over the
	// correctly-paired PROJECT layout, read SCALAR, and synthesized nothing. The two answers then
	// linked against each other:
	//   `panic at Arm64Backend: arm64ResolveCallFixups: bl to unknown function '__destruct_Payloaded'`
	// on a two-file program containing no error at all. It is the interner mismatch — the one
	// `managedStructFieldDropCallee` closed for the struct arm — surviving in the arm nobody closed it for,
	// and it is the same "an id is only a number without its table" defect one door along. Asking by
	// NAME makes the mispairing UNREPRESENTABLE rather than correct-by-convention.
	//
	// The union is a precondition, not a case: the sole caller reached here through an `enumOf` that answered
	// `declared`.
	export function unionHasManagedPayload(unionName ByteArray) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(unionName) otherwise panic("ProgramSignatures.unionHasManagedPayload: no `union {String.from(unionName)}` is declared — the caller asks `enumOf` first")
		return unionHasManagedField(self, typeNames: self.typeNames, layout: layout)
	end 'unionHasManagedPayload'

	export function unionNameIsUnboxedFor(unionName ByteArray, readerFilePath FilePath) returns bool
		match self.enumFor(unionName, readerFilePath: readerFilePath) 'declaration'
			declared(layout) then return self.unionRepresentation(layout) == UnionRepresentation.word
			undeclared then return false
		end 'declaration'
	end 'unionNameIsUnboxedFor'

	export function unionRepresentation(layout EnumLayout) returns UnionRepresentation
		return unionRepresentationOf(self, typeNames: self.typeNames, layout: layout)
	end 'unionRepresentation'

	// Answers for the name's single registry entry whichever file asks, so it is only for a caller
	// with no reading file; a name two files declare differently needs `unionNameIsUnboxedFor`.
	export function unionNameIsUnboxed(unionName ByteArray) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(unionName) otherwise return false
		return self.unionRepresentation(layout) == UnionRepresentation.word
	end 'unionNameIsUnboxed'

	function declaredStructLayoutOf(name ByteArray) returns StructLayout throws AbsentError
		if not self.containsStructInAnyFile(name) 'notAStruct'
			throw AbsentError.absent
		end 'notAStruct'

		return self.structLayoutOf(name)
	end 'declaredStructLayoutOf'

	export function fieldNameAtOffset(name ByteArray, offset ByteOffset) returns immutable ByteArray throws AbsentError
		let layout = try self.declaredStructLayoutOf(name)
		return layout.fieldNameAt(try layoutFieldAtOffset(layout, offset: offset))
	end 'fieldNameAtOffset'

	export function declaredFieldHoldsStoredKeys(name ByteArray, offset ByteOffset) returns bool
		if not self.containsStructInAnyFile(name) 'notAStruct'
			return false
		end 'notAStruct'

		return storedKeyColumnIsAt(name, layout: self.structLayoutOf(name), offset: offset)
	end 'declaredFieldHoldsStoredKeys'

	export function instanceFieldHoldsStoredKeys(id GenericInstanceId, offset ByteOffset) returns bool
		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToRead'
			return false
		end 'noFieldsToRead'

		return storedKeyColumnIsAt(self.genericInstanceBaseName(id), layout: self.baseLayoutOf(id), offset: offset)
	end 'instanceFieldHoldsStoredKeys'

	export function declaredFieldSlotIsImmutable(name ByteArray, offset ByteOffset) returns bool
		if not self.containsStructInAnyFile(name) 'notAStruct'
			return false
		end 'notAStruct'

		return layoutSlotIsImmutable(self.structLayoutOf(name), offset: offset)
	end 'declaredFieldSlotIsImmutable'

	export function unionPayloadSlotIsImmutable(unionName ByteArray, caseKey FullRangeInt, offset ByteOffset) returns bool
		let enumLayout = try self.settledDeclarations().enumTypes.get(unionName) otherwise return false
		return casePayloadSlotIsImmutable(enumLayout, caseKey: caseKey, keyedByWord: self.unionRepresentation(enumLayout) == UnionRepresentation.word, offset: offset)
	end 'unionPayloadSlotIsImmutable'

	export function instanceFieldSlotIsImmutable(id GenericInstanceId, offset ByteOffset) returns bool
		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToRead'
			return false
		end 'noFieldsToRead'

		return layoutSlotIsImmutable(self.baseLayoutOf(id), offset: offset)
	end 'instanceFieldSlotIsImmutable'

	// An instance's kind is its `canonicalInstanceName`, the spelling every kind comparison uses.
	// `mangleGenericInstance` differs when a type argument is an alias of an instance, and a kind
	// spelled that way matches no `HeldRecordKinds` entry, so a payload of that instance goes
	// unseen.
	export function heldRecordKindOfTag(tag ValueTypeTag, nameId TypeNameId, from TypeNameInterner) returns immutable ByteArray throws MapError
		if tagIsByteRecord(tag) 'aByteRecord'
			return HeldByteRecordKind
		end 'aByteRecord'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.canonicalInstanceName(nameId as GenericInstanceId)
		end 'anInstance'

		if not tagMayNameAggregate(tag) 'namesNoAggregate'
			throw MapError.keyNotFound
		end 'namesNoAggregate'

		return try self.heldRecordKindOfDeclaredName(try from.nameOf(nameId) otherwise throw MapError.keyNotFound)
	end 'heldRecordKindOfTag'

	export function aggregateTypeIsImmutable(name ByteArray) returns bool
		return self.aggregateNameIsImmutable(name, visited: ClonerSet.create())
	end 'aggregateTypeIsImmutable'

	function aggregateNameIsImmutable(name ByteArray, visited ClonerSet) returns bool
		if self.containsEnumInAnyFile(name) 'aUnion'
			return self.declaredUnionIsImmutable(name, visited: visited)
		end 'aUnion'

		if not self.containsStructInAnyFile(name) 'notAStruct'
			return false
		end 'notAStruct'

		return self.declaredLayoutIsImmutable(name, layout: self.structLayoutOf(name), visited: visited)
	end 'aggregateNameIsImmutable'

	// The one answer to whether a write through a root can change a record of `kind`. A byte record is
	// a value and never writable state. A name a declaration and an instance both spell is one kind,
	// so it is answered writable. Placement and identity ask without it, because a by-reference write
	// of a String reaches its holder.
	function recordKindIsWritableState(kind ByteArray) returns bool
		if kind.equals(HeldByteRecordKind) 'aByteRecord'
			return false
		end 'aByteRecord'

		if self.isCanonicalInstanceName(kind) 'anInstance'
			return not self.genericInstanceIsImmutable(try self.renderedInstanceOfUnclaimedName(kind) otherwise return true)
		end 'anInstance'

		return not self.aggregateTypeIsImmutable(kind)
	end 'recordKindIsWritableState'

	// `Promise` and `SharedValue` declare only `let` fields, but each names run-time state (a green
	// thread, a shared cell) written underneath it, so its all-`let` layout must not make it shared
	// like a value.
	function layoutDeclaresOnlyLets(name ByteArray, layout StructLayout) returns bool
		if name.equals(PromiseTypeName) or name.equals(SharedValueTypeName) 'aCompilerOwnedHandle'
			return false
		end 'aCompilerOwnedHandle'

		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedSocket or
			managedPages or
			managedHandle or
			managedPin or
			serviceHandle then return false

			userDeclared then break
		end 'compilerOwned'

		for writable in layout.fieldMutable 'eachField'
			if writable 'aVarField'
				return false
			end 'aVarField'
		end 'eachField'

		return true
	end 'layoutDeclaresOnlyLets'

	function declaredLayoutIsImmutable(name ByteArray, layout StructLayout, visited ClonerSet) returns bool
		if not self.layoutDeclaresOnlyLets(name, layout: layout) 'aVarFieldOrHandle'
			return false
		end 'aVarFieldOrHandle'

		if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
			return true
		end 'alreadyInFlight'

		for i in 0 upto layout.fieldCount() 'eachField'
			if layout.fieldTypeSites.capabilityAt(i) == ParamCapability.immutable 'aFrozenSlot'
				continue
			end 'aFrozenSlot'

			if not self.slotTypeIsImmutable(self.layoutFieldType(layout, structName: name, index: i), visited: visited) 'aWritableField'
				return false
			end 'aWritableField'
		end 'eachField'

		return true
	end 'declaredLayoutIsImmutable'

	function declaredUnionIsImmutable(name ByteArray, visited ClonerSet) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise panic("ProgramSignatures.declaredUnionIsImmutable: `{String.from(name)}` is not a declared union or enum — every caller asked `containsEnumInAnyFile` first")

		if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
			return true
		end 'alreadyInFlight'

		for ci in 0 upto layout.caseCount() 'eachCase'
			for field in layout.payloadsAt(ci) 'eachPayload'
				if field.capability == ParamCapability.immutable 'aFrozenPayload'
					continue
				end 'aFrozenPayload'

				if not self.slotTypeIsImmutable(field.declaredType, visited: visited) 'aWritablePayload'
					return false
				end 'aWritablePayload'
			end 'eachPayload'
		end 'eachCase'

		return true
	end 'declaredUnionIsImmutable'

	export function genericInstanceIsImmutable(id GenericInstanceId) returns bool
		return self.instanceIsImmutable(id, visited: ClonerSet.create())
	end 'genericInstanceIsImmutable'

	function instanceIsImmutable(id GenericInstanceId, visited ClonerSet) returns bool
		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToRead'
			return false
		end 'noFieldsToRead'

		if not self.layoutDeclaresOnlyLets(self.genericInstanceBaseName(id), layout: self.baseLayoutOf(id)) 'aVarFieldOrHandle'
			return false
		end 'aVarFieldOrHandle'

		if not self.cloneWalkMayDescendInto(self.mangleGenericInstance(id), visited: visited) 'alreadyInFlight'
			return true
		end 'alreadyInFlight'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if not self.slotTypeIsImmutable(self.substituteInstanceFieldType(id, index: i), visited: visited) 'aWritableField'
				return false
			end 'aWritableField'
		end 'eachField'

		return true
	end 'instanceIsImmutable'

	function instanceSlotIsImmutable(id GenericInstanceId, visited ClonerSet) returns bool
		if self.instanceBaseIsServiceHandle(id) or self.genericInstanceBaseName(id).equals(SharedValueTypeName) 'aShareableHandle'
			return true
		end 'aShareableHandle'

		return self.instanceIsImmutable(id, visited: visited)
	end 'instanceSlotIsImmutable'

	function slotTypeIsImmutable(type MaxonType, visited ClonerSet) returns bool
		let tag = maxonTypeTag(type)

		if tagIsByteRecord(tag) 'text'
			return true
		end 'text'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceSlotIsImmutable(genericInstanceIdOf(type), visited: visited)
		end 'anInstance'

		if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.function 'opaque'
			return false
		end 'opaque'

		if not self.tagMayNameAggregate(tag) 'aScalar'
			return true
		end 'aScalar'

		let name = self.denotedSlotAggregateName(type)

		if self.isFunctionAliasInAnyFile(name) or self.nameDeclaresAnInterface(name) 'opaqueByName'
			return false
		end 'opaqueByName'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			return self.instanceSlotIsImmutable(try self.liveGenericAliasInstance(name) otherwise return false, visited: visited)
		end 'genericAlias'

		if self.isAnyServiceHandle(name) or (not self.containsStructInAnyFile(name) and not self.containsEnumInAnyFile(name)) 'aValue'
			return true
		end 'aValue'

		return self.aggregateNameIsImmutable(name, visited: visited)
	end 'slotTypeIsImmutable'

	function sourceCloneVerdictOfType(t MaxonType) returns SourceCloneVerdict
		if self.typeSupportsDeepClone(t, visited: ClonerSet.create(), purpose: GraphCascadePurpose.sourceClone) 'cloneable'
			return SourceCloneVerdict.cloneable
		end 'cloneable'

		return refusedSourceCloneVerdict(self.typeSupportsDeepClone(t, visited: ClonerSet.create(), purpose: GraphCascadePurpose.deepClone))
	end 'sourceCloneVerdictOfType'

	function sourceCloneVerdictOfAggregate(name ByteArray) returns SourceCloneVerdict
		if self.aggregateNameSupportsDeepClone(name, visited: ClonerSet.create(), purpose: GraphCascadePurpose.sourceClone) 'cloneable'
			return SourceCloneVerdict.cloneable
		end 'cloneable'

		return refusedSourceCloneVerdict(self.aggregateSupportsDeepClone(name))
	end 'sourceCloneVerdictOfAggregate'

	// ⭐ **CAN A DECLARED STRUCT BE DEEP-CLONED?**
	// The gate and `synthesizeStructCascade` must agree, or the synthesizer meets an `unsupported`
	// field on a program the front end accepted and PANICS — a compiler crash on valid-looking input
	// (see `managedNameCascadeStrategy`, which records the measured one).
	//
	// It asks by NAME, not by `MaxonType`, because the caller holds a `StructLayout` or an `EnumLayout` and
	// the ids in a parser artifact's interner are not this index's — the mispairing this file's
	// `unionHasManagedPayload` header calls unrepresentable when the question is asked by name. A STRUCT and a
	// UNION reach it alike, which is why it is named for the aggregate and not for one of them: both source
	// `.clone()` doors (`Parser.emitSynthesizedStructClone`, `Parser.emitSynthesizedUnionClone`) gate on the
	// same walk through `sourceCloneVerdictOfAggregate`, and `aggregateNameSupportsDeepClone` below routes
	// each to its own field/payload walk.
	//
	// ⚠ **IT GOES THROUGH `aggregateNameSupportsDeepClone`, WHICH IS THE WHOLE OF WHAT
	// `typeSupportsDeepClone` DOES ONCE IT HOLDS A NAME.** Calling the field walk directly skips the
	// compiler-owned arm, which leaves this gate and the element gate disagreeing about `CharacterSet`
	// / `__ManagedFile` / `__ManagedDirectory`. The cycle-break seeding comes free with it: that
	// function inserts the name before it walks, so `type Node { var next as Node }` terminates on the
	// same break.
	//
	// ⛔⛔ **THE MEMO BELONGS HERE AND NOWHERE DEEPER.** `aggregateNameSupportsDeepClone`'s answer is computed
	// under the cycle break — a name already in flight is ASSUMED clonable so the walk terminates — so its
	// result is true only of the walk that asked it and is not a stand-alone fact about the name. Only this
	// entry, where `visited` is FRESH, holds an answer that stands on its own.
	//
	// ⛔⛔ **THE ANSWER MOVES DURING ONE COMPILE, SO ONLY THE ANSWERS THAT CANNOT MOVE ARE KEPT.** The
	// declarations behind the walk are settled before parsing (`recordStruct` and `recordGenericAlias` are the
	// SWEEP’s; `Queries.maxon` settles the alias registry with no file yet parsed) — but
	// `instanceGraphSupportsDeepClone`’s trivial-element arm answers `not containerOpaqueElementCanBeManaged`,
	// which SCANS the interned instances of a base (`anyInstanceTypeArgHasKind`) and skips speculative rows,
	// and `Parser.internGenericInstanceOf` both mints rows and clears speculative marks DURING parsing. So for
	// a name whose field graph reaches `Array with <a bare type parameter>` the true answer differs between two
	// asks. Freezing the first would be a spurious E2015, or a `direct` stamp whose cascade cannot be built —
	// the very panic the gate this memo sits under exists to prevent.
	// ⇒ **SO AN ANSWER IS KEPT ONLY WHEN THE WALK THAT PRODUCED IT NEVER READ A ROW SET.** The two doors that
	// do — `instanceWithTypeArgKind` and `genericTypeIsInstantiated` — mark `deepCloneWalkReadInstances`, and a
	// marked walk’s answer is returned and thrown away. Nothing that survives here can go stale, so nothing has
	// to be invalidated: the volatile answers are never written rather than written and chased. That is correct
	// by CONSTRUCTION rather than by an argument about which pass writes when — the kind of argument that reads
	// true and is falsified by the next caller.
	//
	// ⛔ **AND IT IS NOT AN OPTIMIZATION OF A RARE PATH.** The gate is reached, through
	// `valueIsAnImageableDeepBox`, from every borrowed value that reaches a DURABLE SINK
	// (`Parser.coOwnConcreteRecordForSink`) and every record retain (`Parser.emitRetainCall`,
	// `Parser.holdRetainPlan`), not once per `.clone()` token, so its population is every consumed argument,
	// field store, element push and retain in the program. The cost it removes is
	// measured in `docs/optimization-log.md`, on `tests/ladders/genclonegate.sh`.
	export function aggregateSupportsDeepClone(aggregateName ByteArray) returns bool
		return self.memoizedAggregateCascadeAnswer(aggregateName, purpose: GraphCascadePurpose.deepClone, answers: self.deepCloneAnswers)
	end 'aggregateSupportsDeepClone'

	// The gate above asked for a TRANSFER, which admits a value held at an interface type whose conformers all cross.
	export function aggregateSupportsTransfer(aggregateName ByteArray, kind TransferKind) returns bool
		return match kind 'kind'
			send gives self.aggregateNameSupportsDeepClone(aggregateName, visited: ClonerSet.create(), purpose: GraphCascadePurpose.send)
			share gives self.memoizedAggregateCascadeAnswer(aggregateName, purpose: GraphCascadePurpose.shareWalk, answers: self.shareWalkAnswers)
		end 'kind'
	end 'aggregateSupportsTransfer'

	// The memo the entries above share; `answers` is the purpose's own map.
	function memoizedAggregateCascadeAnswer(aggregateName ByteArray, purpose GraphCascadePurpose, answers DeepCloneAnswerMap) returns bool
		if let walked = try self.cascadeAnswerFor(aggregateName, purpose: purpose) 'alreadyAnswered'
			return walked
		end 'alreadyAnswered'

		let inFlight = self.inFlightCascadeWalkDepthOf(aggregateName)

		if inFlight.reached 'alreadyInFlight'
			return self.noteCascadeWalkBreakAt(inFlight.depth)
		end 'alreadyInFlight'

		let frame = self.openCascadeWalk()
		self.cascadeWalkRoots.push(aggregateName)
		let answer = self.aggregateNameSupportsDeepClone(aggregateName, visited: ClonerSet.create(), purpose: purpose)
		self.cascadeWalkRoots.truncate(frame.depth)

		if self.closeCascadeWalk(frame) 'restsOnDeclarationsAlone'
			answers.upsert(aggregateName, value: answer)

			if self.baseline.settled 'pastTheBaseline'
				self.journal.noteCascadeAnswer(aggregateName, purpose: purpose)
			end 'pastTheBaseline'
		end 'restsOnDeclarationsAlone'

		return answer
	end 'memoizedAggregateCascadeAnswer'

	// A linear scan rather than a set membership test, because the answer wanted is the DEPTH the name is in
	// flight at and a set cannot give it — and that depth is the whole of the keep rule in `closeCascadeWalk`.
	// The stack holds one entry per NESTED walk, not per name visited.
	function inFlightCascadeWalkDepthOf(name ByteArray) returns CascadeWalkBreak
		for i in 0 upto self.cascadeWalkRoots.count() 'eachRoot'
			let root = try self.cascadeWalkRoots.get(i) otherwise panic("ProgramSignatures.inFlightCascadeWalkDepthOf: cascadeWalkRoots.get OOB at {i} below count {self.cascadeWalkRoots.count()}")

			if root.equals(name) 'thisRoot'
				return CascadeWalkBreak.atDepth(i)
			end 'thisRoot'
		end 'eachRoot'

		return CascadeWalkBreak.nothingBroke()
	end 'inFlightCascadeWalkDepthOf'

	function noteCascadeWalkBreakAt(reachedDepth ElementIndex) returns bool
		self.cascadeBreakReached = CascadeWalkBreak.atDepth(reachedDepth).shallowerOf(self.cascadeBreakReached)
		return true
	end 'noteCascadeWalkBreakAt'

	function noteCascadeWalkBreakAtEnclosingRoot() returns bool
		if self.cascadeWalkRoots.count() == 0 'noWalkIsRooted'
			return true
		end 'noWalkIsRooted'

		return self.noteCascadeWalkBreakAt(self.cascadeWalkRoots.count() - 1)
	end 'noteCascadeWalkBreakAtEnclosingRoot'

	// The read mark and the break are CLEARED for the walk about to run and SAVED for the one around it: each
	// describes the walk in flight, and clearing without saving drops an enclosing walk's own — letting IT keep
	// an answer resting on a registry read or an optimistic break it really took. `closeCascadeWalk` merges
	// them back.
	export function openCascadeWalk() returns CascadeWalkFrame
		let frame = CascadeWalkFrame.create(self.cascadeWalkRoots.count(), enclosingRead: self.deepCloneWalkReadInstances, enclosingBreak: self.cascadeBreakReached)
		self.deepCloneWalkReadInstances = false
		self.cascadeBreakReached = CascadeWalkBreak.nothingBroke()
		return frame
	end 'openCascadeWalk'

	// ⭐⭐ **WHETHER THIS WALK MAY KEEP ITS ANSWER — and the rule is the SCC head.** A walk that meets a name
	// already in flight answers `true` and goes on, so its result stands on an assumption about a walk nobody
	// has finished. A break taken against THIS walk's own root is the ordinary self-cycle the `visited`
	// convention is entitled to memoize: a type that reaches itself is cloneable exactly when the rest of it
	// is. A break against an ANCESTOR's root is not — that assumption belongs to a question still open, and
	// keeping the answer would publish a verdict every later asker of this name reads. The break is merged
	// OUTWARD as a minimum, so only the walk rooted at the broken-into name keeps anything.
	//
	// A walk that read the instance registry keeps nothing either way: its answer is contingent on rows still
	// being minted.
	export function closeCascadeWalk(frame CascadeWalkFrame) returns bool
		let thisWalkRead = self.deepCloneWalkReadInstances
		let thisWalkBreak = self.cascadeBreakReached
		self.deepCloneWalkReadInstances = frame.enclosingRead or thisWalkRead
		self.cascadeBreakReached = frame.enclosingBreak.shallowerOf(thisWalkBreak)
		return not thisWalkRead and thisWalkBreak.restsWithin(frame.depth)
	end 'closeCascadeWalk'

	function interfaceConformersSupportDeepClone(interfaceName ByteArray, visited ClonerSet) returns bool
		if let answered = try self.interfaceCloneAnswerFor(interfaceName) 'alreadyAnswered'
			return answered
		end 'alreadyAnswered'

		if not self.cloneWalkMayDescendInto(interfaceName, visited: visited) 'alreadyInFlight'
			return self.noteCascadeWalkBreakAtEnclosingRoot()
		end 'alreadyInFlight'

		let frame = self.openCascadeWalk()
		let answer = match self.uncloneableConformerOf(interfaceName) 'blame'
			none gives true
			conformer gives false
		end 'blame'

		if self.closeCascadeWalk(frame) 'restsOnDeclarationsAlone'
			self.interfaceCloneAnswers.upsert(interfaceName, value: answer)

			if self.baseline.settled 'pastTheBaseline'
				self.journal.noteInterfaceCloneAnswer(interfaceName)
			end 'pastTheBaseline'
		end 'restsOnDeclarationsAlone'

		return answer
	end 'interfaceConformersSupportDeepClone'

	// ⭐ **ONE VERDICT SERVES THE GATE AND THE DIAGNOSTIC**: the gate is "this answered none", and the refusal
	// names the conformer it answered with. A second copy of the question drifts both ways — a refusal able to
	// name nobody, and a clone admitted over a conformer only one of the two rosters reaches.
	function uncloneableConformerOf(interfaceName ByteArray) returns ConformerCloneBlame
		for conformer in self.witnessConformersOf(interfaceName) 'eachConformer'
			if not self.conformerSupportsDeepClone(conformer) 'uncloneable'
				return ConformerCloneBlame.conformer(conformer)
			end 'uncloneable'
		end 'eachConformer'

		return ConformerCloneBlame.none
	end 'uncloneableConformerOf'

	// Every conformer a witness dispatch can reach, each listed once: the declaration's `implements` clause and
	// the extensions', both `extends`-transitive through `typeDeclaresInterface` — an `extension T implements
	// Derived` is a conformer of `Derived`'s BASE too, and a roster blind to either half admits a clone whose
	// witness word aborts. A conformer both halves reach, such as an enum named by its extension's
	// `implements`, is why the roster is deduplicated.
	export function witnessConformersOf(interfaceName ByteArray) returns NameRoster
		let reached = self.declaredConformerIndex().conformersOf(interfaceName)
		self.conformerIndexWithExtensions().appendExtensionConformersOf(interfaceName, into: reached)

		let seen = DeclaredTypeNameSet.create()
		let conformers = NameRoster.create(reached.count(), zeroed: false)

		for conformer in reached 'eachReached'
			if seen.contains(conformer) 'alreadyListed'
				continue
			end 'alreadyListed'

			seen.insert(conformer)
			conformers.push(conformer)
		end 'eachReached'

		return conformers
	end 'witnessConformersOf'

	// ⭐⭐ **THE GATE READS THE VERY WORD THE TABLE WILL HOLD**, so this file's standing rule — a name the gate
	// and the strategy disagreed about would admit a clone nobody can emit — holds here by IDENTITY rather than
	// by two walks agreeing. A structural re-derivation of "can this conformer be cloned?" would be a second
	// copy free to drift, and the drift's form is a witness word that aborts under a `.clone()` the front end
	// accepted.
	export function conformerSupportsDeepClone(typeName ByteArray) returns bool
		return not self.existentialCascadeCallee(typeName, action: CascadeAction.clone).names(MmCloneUncloneableName)
	end 'conformerSupportsDeepClone'

	export function anyRecordHoldsAnInterfaceValue() returns bool
		if self.recordsHoldingAnInterfaceValueCounted 'alreadyCounted'
			return self.someRecordHoldsAnInterfaceValue
		end 'alreadyCounted'

		self.someRecordHoldsAnInterfaceValue = self.walkForAnInterfaceValuedSlot()
		self.recordsHoldingAnInterfaceValueCounted = true
		return self.someRecordHoldsAnInterfaceValue
	end 'anyRecordHoldsAnInterfaceValue'

	function slotsHoldAnInterfaceValue(slots StructSlotMap) returns bool
		for (name, slot) in slots 'eachRegisteredType'
			if self.layoutHoldsAnInterfaceValuedSlot(name, layout: self.layoutAtSlot(slot)) 'anExistentialSlot'
				return true
			end 'anExistentialSlot'
		end 'eachRegisteredType'

		return false
	end 'slotsHoldAnInterfaceValue'

	function layoutHoldsAnInterfaceValuedSlot(name ByteArray, layout StructLayout) returns bool
		for i in 0 upto layout.fieldCount() 'eachField'
			if maxonTypeTag(layoutFieldType(layout, structName: name, index: i)) == ValueTypeTag.interfaceRef 'anExistentialSlot'
				return true
			end 'anExistentialSlot'
		end 'eachField'

		return false
	end 'layoutHoldsAnInterfaceValuedSlot'

	// ⭐⭐ **THE CLONE WORD'S STAMP GATE, AND IT MAY OVER-APPROXIMATE BUT NEVER UNDER-APPROXIMATE.** It exists
	// for the reason `spawnsAnyService` gates the walk words: stamped unconditionally, every conformer's
	// `__clone_<T>` would be rooted in every program that merely declares an interface. Answering `true` where
	// nothing needs it costs those bytes.
	//
	// ⚠ **ANSWERING `false` WHERE SOMETHING DOES IS A SILENT DOUBLE FREE**, which is why the sweep is over the
	// CLONER INSTALLER's own roster — `structTypes`, tuples included, plus `enumTypes` payloads — and never
	// `structNamesInDeclOrder`. A record the installer reaches and this misses takes a zero clone word.
	function walkForAnInterfaceValuedSlot() returns bool
		if self.baseline.overlaid and self.slotsHoldAnInterfaceValue(self.baseTables().structSlots) 'aBaselineType'
			return true
		end 'aBaselineType'

		if self.slotsHoldAnInterfaceValue(self.structSlots) 'anOwnType'
			return true
		end 'anOwnType'

		for (_, enumLayout) in self.settledDeclarations().enumTypes 'eachDeclaredEnum'
			for ci in 0 upto enumLayout.caseCount() 'eachCase'
				let payloads = enumLayout.payloadsAt(ci)

				for fi in 0 upto payloads.count() 'eachPayload'
					let field = try payloads.get(fi) otherwise panic("ProgramSignatures.walkForAnInterfaceValuedSlot: payloadsAt count disagrees with get at {fi}")

					if maxonTypeTag(field.declaredType) == ValueTypeTag.interfaceRef 'anExistentialPayload'
						return true
					end 'anExistentialPayload'
				end 'eachPayload'
			end 'eachCase'
		end 'eachDeclaredEnum'

		return false
	end 'walkForAnInterfaceValuedSlot'

	// ⭐ **THE BLAME HALF OF THE CLONE GATE — the field, the interface and the conformer a refusal names.** It
	// descends the slot shapes `typeSupportsDeepClone` descends (a struct field, a union payload, a container
	// element, a declared generic instance) because it must reach every existential that walk can refuse: a
	// shape it stops short of answers `none`, and the refusal falls back to wording that names no conformer at
	// all. `specs/memory-safety.md`'s clone-refusal cases pin which one comes out.
	export function uncloneableExistentialIn(name ByteArray) returns UncloneableExistentialSlot
		return self.uncloneableExistentialInAggregate(self.denotedAggregateName(name), visited: ClonerSet.create())
	end 'uncloneableExistentialIn'

	export function uncloneableExistentialInElementOf(id GenericInstanceId) returns UncloneableExistentialSlot
		return self.uncloneableExistentialInSlot(self.containerElementType(id), visited: ClonerSet.create())
	end 'uncloneableExistentialInElementOf'

	function uncloneableExistentialInSlot(slotType MaxonType, visited ClonerSet) returns UncloneableExistentialSlot
		let tag = maxonTypeTag(slotType)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			let id = genericInstanceIdOf(slotType)

			if not self.isElementBearingRecordInstance(id) 'notAnElementRecord'
				return UncloneableExistentialSlot.none
			end 'notAnElementRecord'

			return self.uncloneableExistentialInSlot(self.containerElementType(id), visited: visited)
		end 'anInstance'

		if not tagMayNameAggregate(tag) 'notAnAggregateSlot'
			return UncloneableExistentialSlot.none
		end 'notAnAggregateSlot'

		return self.uncloneableExistentialInAggregate(self.denotedSlotAggregateName(slotType), visited: visited)
	end 'uncloneableExistentialInSlot'

	function uncloneableExistentialInAggregate(name ByteArray, visited ClonerSet) returns UncloneableExistentialSlot
		if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
			return UncloneableExistentialSlot.none
		end 'alreadyInFlight'

		if not self.containsStructInAnyFile(name) 'notAStruct'
			return self.uncloneableExistentialInUnion(name, visited: visited)
		end 'notAStruct'

		let layout = self.structLayoutOf(name)

		for i in 0 upto layout.fieldCount() 'eachField'
			if not self.structFieldIsManaged(name, index: i) 'scalar'
				continue
			end 'scalar'

			let found = self.uncloneableExistentialAtField(layout, structName: name, index: i, visited: visited)

			match found 'found'
				slot then return found
				none then break
			end 'found'
		end 'eachField'

		return UncloneableExistentialSlot.none
	end 'uncloneableExistentialInAggregate'

	function uncloneableExistentialInUnion(name ByteArray, visited ClonerSet) returns UncloneableExistentialSlot
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise return UncloneableExistentialSlot.none

		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachPayload'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.uncloneableExistentialInUnion: payloadsAt count disagrees with get at {fi}")
				let found = self.uncloneableExistentialInSlot(field.declaredType, visited: visited)

				match found 'found'
					slot then return found
					none then break
				end 'found'
			end 'eachPayload'
		end 'eachCase'

		return UncloneableExistentialSlot.none
	end 'uncloneableExistentialInUnion'

	function uncloneableExistentialAtField(layout StructLayout, structName ByteArray, index FieldIndex, visited ClonerSet) returns UncloneableExistentialSlot
		let fieldType = layoutFieldType(layout, structName: structName, index: index)

		if maxonTypeTag(fieldType) != ValueTypeTag.interfaceRef 'notAnExistential'
			return self.uncloneableExistentialInSlot(fieldType, visited: visited)
		end 'notAnExistential'

		let interfaceName = self.nameOfId(typeNameIdOf(fieldType))

		return match self.uncloneableConformerOf(interfaceName) 'blame'
			none gives UncloneableExistentialSlot.none
			conformer(conformerName) gives UncloneableExistentialSlot.slot(structName, fieldName: layout.fieldNameAt(index), interfaceName: interfaceName, conformerName: conformerName)
		end 'blame'
	end 'uncloneableExistentialAtField'

	export function uncloneableConformerReason(typeName ByteArray) returns String
		if self.structDeclaresTypeParams(typeName) 'aGenericConformer'
			return "is a GENERIC type, whose clone this compiler mints per declared type only"
		end 'aGenericConformer'

		match self.osHandleOwnedBy(self.denotedAggregateName(typeName), visited: ClonerSet.create()) 'handle'
			handle(handleName) then return "owns an OS handle (`{String.from(handleName)}`) and cannot be duplicated"
			pin(pinName) then return "owns a machine pin (`{String.from(pinName)}`) and cannot be duplicated"
			none then break
		end 'handle'

		return "owns a field this compiler cannot deep-clone"
	end 'uncloneableConformerReason'

	function osHandleOwnedBy(name ByteArray, visited ClonerSet) returns OwnedOsHandle
		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedSocket or
			managedPages or
			managedHandle then return OwnedOsHandle.handle(name)
			managedPin then return OwnedOsHandle.pin(name)

			serviceHandle or
			userDeclared then break
		end 'compilerOwned'

		if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
			return OwnedOsHandle.none
		end 'alreadyInFlight'

		if not self.containsStructInAnyFile(name) 'notAStruct'
			return self.osHandleInUnion(name, visited: visited)
		end 'notAStruct'

		let layout = self.structLayoutOf(name)

		for i in 0 upto layout.fieldCount() 'eachField'
			let nested = self.osHandleInSlot(layoutFieldType(layout, structName: name, index: i), visited: visited)

			match nested 'nested'
				handle or
				pin then return nested
				none then break
			end 'nested'
		end 'eachField'

		return OwnedOsHandle.none
	end 'osHandleOwnedBy'

	export function slotOwnsAnOsHandle(slotType MaxonType) returns bool
		return match self.osHandleInSlot(slotType, visited: ClonerSet.create()) 'owned'
			handle or
			pin gives true
			none gives false
		end 'owned'
	end 'slotOwnsAnOsHandle'

	function osHandleInSlot(slotType MaxonType, visited ClonerSet) returns OwnedOsHandle
		let tag = maxonTypeTag(slotType)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.osHandleInInstance(genericInstanceIdOf(slotType), visited: visited)
		end 'anInstance'

		if not tagMayNameAggregate(tag) 'notAnAggregateSlot'
			return OwnedOsHandle.none
		end 'notAnAggregateSlot'

		return self.osHandleOwnedBy(self.denotedSlotAggregateName(slotType), visited: visited)
	end 'osHandleInSlot'

	function osHandleInInstance(id GenericInstanceId, visited ClonerSet) returns OwnedOsHandle
		if self.isElementBearingRecordInstance(id) 'anElementRecord'
			return self.osHandleInSlot(self.containerElementType(id), visited: visited)
		end 'anElementRecord'

		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToWalk'
			return OwnedOsHandle.none
		end 'noFieldsToWalk'

		if not self.cloneWalkMayDescendInto(self.mangleGenericInstance(id), visited: visited) 'alreadyInFlight'
			return OwnedOsHandle.none
		end 'alreadyInFlight'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			let nested = self.osHandleInSlot(self.substituteInstanceFieldType(id, index: i), visited: visited)

			match nested 'nested'
				handle or
				pin then return nested
				none then break
			end 'nested'
		end 'eachField'

		return OwnedOsHandle.none
	end 'osHandleInInstance'

	function osHandleInUnion(name ByteArray, visited ClonerSet) returns OwnedOsHandle
		let layout = try self.settledDeclarations().enumTypes.get(name) otherwise return OwnedOsHandle.none

		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachPayload'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.osHandleInUnion: payloadsAt count disagrees with get at {fi}")
				let nested = self.osHandleInSlot(field.declaredType, visited: visited)

				match nested 'nested'
					handle or
					pin then return nested
					none then break
				end 'nested'
			end 'eachPayload'
		end 'eachCase'

		return OwnedOsHandle.none
	end 'osHandleInUnion'

	// The INSTANCE twin of `aggregateSupportsTransfer`, the one the transfer door reads about a container.
	// It is the same full-graph walk keyed by instance rather than by name, which is what a value tagged
	// `genericInstance` has — asking it by base NAME would answer about the declaration and not about the
	// substituted element.
	export function instanceSupportsTransfer(id GenericInstanceId, kind TransferKind) returns bool
		return self.instanceGraphSupportsDeepClone(id, visited: ClonerSet.create(), purpose: transferPurposeOf(kind, pastFunctionValues: false))
	end 'instanceSupportsTransfer'

	function aggregateSupportsCascade(aggregateName ByteArray, action CascadeAction) returns bool
		return match action 'action'
			clone gives self.aggregateSupportsDeepClone(aggregateName)
			shareWalk gives self.aggregateSupportsTransfer(aggregateName, kind: TransferKind.share)
		end 'action'
	end 'aggregateSupportsCascade'

	function instanceSupportsCascade(id GenericInstanceId, action CascadeAction) returns bool
		return match action 'action'
			clone gives self.instanceGraphSupportsDeepClone(id, visited: ClonerSet.create(), purpose: GraphCascadePurpose.deepClone)
			shareWalk gives self.instanceSupportsTransfer(id, kind: TransferKind.share)
		end 'action'
	end 'instanceSupportsCascade'

	// ⭐⭐ **HOW A GRAPH IS MADE SAFE FOR ANOTHER GREEN THREAD TO HOLD — OR THE NOUN FOR WHY IT CANNOT.** A SEND
	// moves its value, so it is never walked: the answer is `closed`, or the refusal of a graph that may not
	// cross at all. A SHARE marks the graph shared, so it is walked. The door a message parameter, a reply, a
	// freeze and a module `let` all ask, so they cannot come to treat one type differently or refuse it in
	// different words. The gate and the strategy are answered together: a gate that admitted a type no
	// installer builds a walk for would name a missing symbol.
	//
	// ⚠ **`asElement: true` IS WHAT MAKES THE WALK A CALLEE WITH NO ELEMENT WALK.** A walk is emitted as
	// `callee(value)`, so a managed-element container resolves to its per-instance thunk rather than to
	// the record entry that takes one.
	export function transferWalkOf(subject TransferSubject, kind TransferKind, readerFilePath FilePath) returns TransferWalk
		return match subject 'subject'
			byteRecord gives byteRecordTransferWalk(kind)
			instance(id) gives self.instanceTransferWalk(id, kind: kind)
			existential(interfaceName) gives self.existentialTransferWalk(interfaceName, kind: kind)
			opaqueParameter gives TransferWalk.refused("an opaque type parameter, whose slots the send site cannot see")
			nameless gives TransferWalk.refused("a managed value whose record carries no name here, so what it holds cannot be read")
			functionValue gives TransferWalk.refused(FunctionValueCrossingNoun)
			aggregate(name) gives self.aggregateTransferWalk(name, kind: kind, readerFilePath: readerFilePath)
		end 'subject'
	end 'transferWalkOf'

	function instanceGraphHoldsAPromise(id GenericInstanceId) returns bool
		return self.typeReachesAPromise(MaxonType.genericInstance(id), visited: ClonerSet.create())
	end 'instanceGraphHoldsAPromise'

	function aggregateGraphHoldsAPromise(name ByteArray) returns bool
		return self.aggregateReachesAPromise(name, visited: ClonerSet.create())
	end 'aggregateGraphHoldsAPromise'

	function typeHoldsAPromise(type MaxonType) returns bool
		return self.typeReachesAPromise(type, visited: ClonerSet.create())
	end 'typeHoldsAPromise'

	function transferSubjectHoldsAPromise(subject TransferSubject) returns bool
		return match subject 'subject'
			instance(id) gives self.instanceGraphHoldsAPromise(id)
			aggregate(name) gives self.aggregateGraphHoldsAPromise(name)
			byteRecord or
			existential or
			opaqueParameter or
			nameless or
			functionValue gives false
		end 'subject'
	end 'transferSubjectHoldsAPromise'

	// `type` is in this index's interner (`Parser.spawnTypeArgumentOfValue`), never a file's.
	export function typeNamesTheBareBase(type MaxonType, base ByteArray) returns bool
		let tag = maxonTypeTag(type)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			let id = genericInstanceIdOf(type)

			for position in 0 upto self.genericInstanceArgCount(id) 'eachArg'
				if self.typeNamesTheBareBase(self.substitutedInstanceArg(id, position: position), base: base) 'anArgumentNamesIt'
					return true
				end 'anArgumentNamesIt'
			end 'eachArg'

			return false
		end 'anInstance'

		if not tagNamesADeclaredType(tag) 'namesNoType'
			return false
		end 'namesNoType'

		return self.aggregateNamesTheBareBase(self.nameOfId(typeNameIdOf(type)), base: base)
	end 'typeNamesTheBareBase'

	function aggregateNamesTheBareBase(rawName ByteArray, base ByteArray) returns bool
		let name = self.denotedAggregateName(rawName)

		if name.equals(base) 'theBareBase'
			return true
		end 'theBareBase'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			let live = try self.liveGenericAliasInstance(name) otherwise return false
			return self.typeNamesTheBareBase(MaxonType.genericInstance(live), base: base)
		end 'genericAlias'

		let tupleName = self.canonicalNameOfStruct(name)

		if not isTupleTypeName(tupleName) 'notATuple'
			return false
		end 'notATuple'

		let layout = self.structLayoutOf(tupleName)

		for i in 0 upto layout.fieldCount() 'eachElement'
			if self.typeNamesTheBareBase(try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.typeNamesTheBareBase: fieldTypes.get OOB at {i}"), base: base) 'anElementNamesIt'
				return true
			end 'anElementNamesIt'
		end 'eachElement'

		return false
	end 'aggregateNamesTheBareBase'

	function typeReachesAPromise(type MaxonType, visited ClonerSet) returns bool
		if self.typeIsAGreenThreadHandle(type, from: self.typeNames) 'aPromise'
			return true
		end 'aPromise'

		if not self.typeOwesDrop(type, from: self.typeNames) 'ownsNothing'
			return false
		end 'ownsNothing'

		let tag = maxonTypeTag(type)

		if tagIsByteRecord(tag) 'noPromiseInBytes'
			return false
		end 'noPromiseInBytes'

		if tag == ValueTypeTag.genericInstance 'instance'
			return self.instanceReachesAPromise(genericInstanceIdOf(type), visited: visited)
		end 'instance'

		if tag == ValueTypeTag.interfaceRef 'anExistential'
			return self.anyConformerReachesAPromise(self.nameOfId(typeNameIdOf(type)), visited: visited)
		end 'anExistential'

		if not tagMayNameAggregate(tag) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		let name = self.denotedSlotAggregateName(type)

		if self.isFunctionAliasInAnyFile(name) 'aFunctionAlias'
			return false
		end 'aFunctionAlias'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			let live = try self.liveGenericAliasInstance(name) otherwise return false

			if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
				return false
			end 'alreadyInFlight'

			return self.instanceReachesAPromise(live, visited: visited)
		end 'genericAlias'

		return self.aggregateReachesAPromise(name, visited: visited)
	end 'typeReachesAPromise'

	function aggregateReachesAPromise(name ByteArray, visited ClonerSet) returns bool
		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedSocket or
			managedPages or
			managedHandle or
			managedPin or
			serviceHandle then return false

			userDeclared then break
		end 'compilerOwned'

		if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
			return false
		end 'alreadyInFlight'

		if self.containsStructInAnyFile(name) 'struct'
			return self.structFieldsReachAPromise(name, visited: visited)
		end 'struct'

		match self.enumInAnyFile(name) 'union'
			declared(layout) then return self.unionPayloadsReachAPromise(layout, visited: visited)
			undeclared then return false
		end 'union'
	end 'aggregateReachesAPromise'

	function instanceReachesAPromise(id GenericInstanceId, visited ClonerSet) returns bool
		if self.instanceIsPromiseHandle(id) 'aPromise'
			return true
		end 'aPromise'

		if self.isElementBearingRecordInstance(id) 'anElementRecord'
			return self.typeReachesAPromise(self.containerElementType(id), visited: visited)
		end 'anElementRecord'

		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToRead'
			return false
		end 'noFieldsToRead'

		if not self.cloneWalkMayDescendInto(self.mangleGenericInstance(id), visited: visited) 'alreadyInFlight'
			return false
		end 'alreadyInFlight'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if self.typeReachesAPromise(self.substituteInstanceFieldType(id, index: i), visited: visited) 'aPromiseField'
				return true
			end 'aPromiseField'
		end 'eachField'

		return false
	end 'instanceReachesAPromise'

	function structFieldsReachAPromise(structName ByteArray, visited ClonerSet) returns bool
		let layout = self.structLayoutOf(structName)

		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldType = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.structFieldsReachAPromise: fieldTypes.get OOB at {i}")

			if self.typeReachesAPromise(fieldType, visited: visited) 'aPromiseField'
				return true
			end 'aPromiseField'
		end 'eachField'

		return false
	end 'structFieldsReachAPromise'

	function unionPayloadsReachAPromise(layout EnumLayout, visited ClonerSet) returns bool
		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachPayload'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.unionPayloadsReachAPromise: payloadsAt count disagrees with get at {fi}")

				if self.typeReachesAPromise(field.declaredType, visited: visited) 'aPromisePayload'
					return true
				end 'aPromisePayload'
			end 'eachPayload'
		end 'eachCase'

		return false
	end 'unionPayloadsReachAPromise'

	function anyConformerReachesAPromise(interfaceName ByteArray, visited ClonerSet) returns bool
		if not self.cloneWalkMayDescendInto(interfaceName, visited: visited) 'alreadyInFlight'
			return false
		end 'alreadyInFlight'

		for conformer in self.witnessConformersOf(interfaceName) 'eachConformer'
			if self.aggregateReachesAPromise(conformer, visited: visited) 'aPromiseConformer'
				return true
			end 'aPromiseConformer'
		end 'eachConformer'

		return false
	end 'anyConformerReachesAPromise'

	function existentialTransferWalk(interfaceName ByteArray, kind TransferKind) returns TransferWalk
		if kind == TransferKind.share 'walkedThroughItsWitness'
			return TransferWalk.walkedThroughWitness(existentialCascadeEntry(CascadeAction.shareWalk))
		end 'walkedThroughItsWitness'

		return match self.unsendableConformerOf(interfaceName, visited: ClonerSet.create()) 'blame'
			none gives TransferWalk.closed
			conformer(name) gives TransferWalk.refused("a `{String.from(interfaceName)}` held at an interface type, whose conformer `{String.from(name)}` cannot cross to another green thread")
		end 'blame'
	end 'existentialTransferWalk'

	function everyConformerIsSendable(interfaceName ByteArray, visited ClonerSet) returns bool
		return match self.unsendableConformerOf(interfaceName, visited: visited) 'blame'
			none gives true
			conformer gives false
		end 'blame'
	end 'everyConformerIsSendable'

	function unsendableConformerOf(interfaceName ByteArray, visited ClonerSet) returns UnsendableConformer
		if not self.cloneWalkMayDescendInto(interfaceName, visited: visited) 'alreadyInFlight'
			return UnsendableConformer.none
		end 'alreadyInFlight'

		for conformer in self.witnessConformersOf(interfaceName) 'eachConformer'
			if not self.aggregateNameSupportsDeepClone(conformer, visited: visited, purpose: GraphCascadePurpose.send) 'cannotCross'
				return UnsendableConformer.conformer(conformer)
			end 'cannotCross'
		end 'eachConformer'

		return UnsendableConformer.none
	end 'unsendableConformerOf'

	function instanceTransferWalk(id GenericInstanceId, kind TransferKind) returns TransferWalk
		let display = String.from(self.instanceDisplayName(id))

		if kind == TransferKind.share and self.instanceGraphHoldsAPromise(id) 'aSharedPromise'
			return TransferWalk.refused("a `{display}` whose graph reaches {PromiseSharedNoun}")
		end 'aSharedPromise'

		if not self.instanceSupportsTransfer(id, kind: kind) 'someNestedTypeHasNoWalk'
			return unwalkableTransfer(display, kind: kind, onlyFunctionValuesBlockIt: self.instanceGraphSupportsDeepClone(id, visited: ClonerSet.create(), purpose: transferPurposeOf(kind, pastFunctionValues: true)))
		end 'someNestedTypeHasNoWalk'

		match kind 'kind'
			send then return TransferWalk.closed
			share then return transferWalkFrom(instanceCascadeStrategy(self, id: id, asElement: true, action: CascadeAction.shareWalk), display: display)
		end 'kind'
	end 'instanceTransferWalk'

	// What a `structRef` or `named` subject walks, split on which registry declares its name: `emitEnumBox` tags a
	// boxed union's box `named` too.
	function aggregateTransferWalk(name ByteArray, kind TransferKind, readerFilePath FilePath) returns TransferWalk
		if self.isFunctionAliasInAnyFile(name) 'aFunctionValue'
			return TransferWalk.refused(FunctionValueCrossingNoun)
		end 'aFunctionValue'

		// Asked before the record checks: a bare socket box holds no managed field, so it would take the
		// unwalked move below and cross without its owners being counted.
		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedSocket then return socketTransferWalk(String.from(name), kind: kind)

			managedFile or
			managedDirectory or
			managedPages or
			managedHandle or
			managedPin or
			serviceHandle or
			userDeclared then break
		end 'compilerOwned'

		if self.containsEnumFor(name, readerFilePath: readerFilePath) 'aUnionBox'
			return self.declaredAggregateTransferWalk(name, kind: kind)
		end 'aUnionBox'

		if not self.containsStructFor(name, readerFilePath: readerFilePath) 'noSuchRecord'
			return TransferWalk.refused("a managed value of `{String.from(name)}`, which no declaration this rule can read describes")
		end 'noSuchRecord'

		// A record packed inline is a word and owns no heap; a walk over it would dereference the word as
		// a box, and `__module_init` would crash sharing a value `default` whose fields pack.
		if self.nameIsInlineRecord(name) 'aWordRecord'
			return TransferWalk.closed
		end 'aWordRecord'

		if kind == TransferKind.share and self.aggregateGraphHoldsAPromise(name) 'aSharedPromise'
			return TransferWalk.refused("a `{String.from(name)}` whose graph reaches {PromiseSharedNoun}")
		end 'aSharedPromise'

		// `structHasManagedField` cannot see a slot standing at a bare type parameter, and a reference handed to a
		// second green thread through one would be walked by nobody.
		if self.recordRestsAnOpaqueSlot(name) 'anOpaqueSlot'
			return TransferWalk.refused("a `type {String.from(name)}` with a slot standing at a bare type parameter, whose managed-ness the send cannot see")
		end 'anOpaqueSlot'

		return self.declaredAggregateTransferWalk(name, kind: kind)
	end 'aggregateTransferWalk'

	function socketTransferWalk(display String, kind TransferKind) returns TransferWalk
		return match kind 'kind'
			send gives TransferWalk.closed
			share gives transferWalkFrom(ManagedCascadeStrategy.unsupported, display: display)
		end 'kind'
	end 'socketTransferWalk'

	function declaredAggregateTransferWalk(name ByteArray, kind TransferKind) returns TransferWalk
		if not self.aggregateSupportsTransfer(name, kind: kind) 'someNestedTypeHasNoWalk'
			return unwalkableTransfer(String.from(name), kind: kind, onlyFunctionValuesBlockIt: self.aggregateNameSupportsDeepClone(name, visited: ClonerSet.create(), purpose: transferPurposeOf(kind, pastFunctionValues: true)))
		end 'someNestedTypeHasNoWalk'

		match kind 'kind'
			send then return TransferWalk.closed
			share then return transferWalkFrom(managedNameCascadeStrategy(self, declaredName: name, asElement: true, action: CascadeAction.shareWalk), display: String.from(name))
		end 'kind'
	end 'declaredAggregateTransferWalk'

	// ⭐ **DOES `name` DENOTE A RECORD WITH A SLOT STANDING AT A BARE TYPE PARAMETER, AND WHOSE `uses` LIST DOES IT
	// INDEX?** The guard belongs with the lookup, which panics for a name that denotes no record.
	export function opaqueSlotDeclarationOf(name ByteArray) returns OpaqueSlotDeclaration
		if not self.containsStructInAnyFile(name) 'namesNoRecord'
			return OpaqueSlotDeclaration.none
		end 'namesNoRecord'

		return self.recordOpaqueSlotDeclaration(name)
	end 'opaqueSlotDeclarationOf'

	export function recordRestsAnOpaqueSlot(name ByteArray) returns bool
		return match self.opaqueSlotDeclarationOf(name) 'restsASlot'
			none gives false
			declaredBy gives true
		end 'restsASlot'
	end 'recordRestsAnOpaqueSlot'

	// Recursively: can a value of `type` be deep-cloned? A scalar owns no heap (nothing to clone), and a promise
	// is such a leaf to every purpose but `sourceClone`, which refuses it; a String is a `direct` leaf; a
	// struct/union is clonable iff every field/payload owing a drop is; an Array or chain is clonable iff its
	// element is; a non-Array generic instance (`Box with String`) is clonable iff every one of its
	// SUBSTITUTED fields is. `visited`
	// holds every name already in flight — aggregate, generic-alias and mangled-instance alike — and breaks a
	// recursive type (`type Node { var next as Node }`, `typealias Cyc = Array with Cyc`). See
	// `cloneWalkMayDescendInto`, the one door all three arms mark through.
	//
	// ⭐⭐ **THERE IS NO `asElement` PARAMETER, AND ITS ABSENCE IS THE POINT.** Such a parameter is `true`
	// wherever `type` is reached as an ARRAY ELEMENT — invoked through `callIndirect(fn, elem)`, so reachable
	// only by a SINGLE `(box) -> newBox` callee — and it REFUSES the one shape whose copy is a 2-argument call:
	// a managed-element container (`Array with (Array with String)`). That restriction is about the ARITY of an
	// entry point and not about the copy being impossible, and a per-instance one-argument THUNK closes it
	// (`elementRecordCascadeStrategy` mints the symbol, `MmRuntime.synthesizeElementRecordCloner` emits the body).
	// ⇒ **every deep-cloneable type has a `direct` 1-arg callee**, which is the argument
	// `declaredInstanceSupportsDeepClone`'s header makes for `__clone_<mangled>`, generalized to the
	// two element-bearing records. A parameter that cannot change an answer is worse than absent: it
	// tells a later reader the two positions differ.
	function typeSupportsDeepClone(type MaxonType, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		let tag = maxonTypeTag(type)

		if not self.typeIsManaged(type, from: self.typeNames) 'trivialLeaf'
			return not purposeRefusesAGreenThread(purpose) or not self.typeIsAGreenThreadHandle(type, from: self.typeNames)
		end 'trivialLeaf'

		if tagIsByteRecord(tag) 'byteRecord'
			return true
		end 'byteRecord'

		if tag == ValueTypeTag.genericInstance 'instance'
			return self.instanceGraphSupportsDeepClone(genericInstanceIdOf(type), visited: visited, purpose: purpose)
		end 'instance'

		if tag == ValueTypeTag.function 'aFunctionValue'
			return purposeCrossesAFunctionValue(purpose)
		end 'aFunctionValue'

		// ⭐ **A SHAPE A WALK AND A CLONE ANSWER DIFFERENTLY, AND THE ASYMMETRY IS THE CLOSED WORLD.** A
		// walk refuses nothing here: which conformer the value holds is a run-time fact, and a conformer
		// with no walk aborts at the crossing (`MmRuntime.MmWalkUnwalkableName`). A clone is refused at
		// COMPILE time instead, because its answer IS knowable — every conformer of the interface in the
		// program has to be deep-cloneable, and the program's roster of them is closed.
		if tag == ValueTypeTag.interfaceRef 'anExistential'
			let interfaceName = self.nameOfId(typeNameIdOf(type))

			return match purposeGatesAnExistential(purpose) 'gate'
				walkedThroughTheWitness gives true
				everyConformerSendable gives self.everyConformerIsSendable(interfaceName, visited: visited)
				everyConformerCloneable gives self.interfaceConformersSupportDeepClone(interfaceName, visited: visited)
			end 'gate'
		end 'anExistential'

		if not tagMayNameAggregate(tag) 'notManagedRef'
			return false
		end 'notManagedRef'

		// Resolved through `denotedSlotAggregateName`, the same door the clone strategy this gate admits reads
		// (`managedFieldCascadeStrategy`) — a name the gate and the strategy disagreed about would admit a clone
		// nobody can emit.
		let name = self.denotedSlotAggregateName(type)

		if self.isFunctionAliasInAnyFile(name) 'aFunctionAlias'
			return purposeCrossesAFunctionValue(purpose)
		end 'aFunctionAlias'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			// A SUPERSEDED spelling refuses nothing — no copy site can name it. `typeArgIsOwned`'s twin guard,
			// off the SAME predicate: both are reader-free classifiers that a whole-program walk drives over the
			// registry's pre-settle memory, and this one was ALREADY reachable — a two-file
			// `typealias Bag = Array with <different element>` with `typealias NestedContainer = Container with
			// Bag` took `requireOpaqueArrayCopyable` straight into `genericAliasInstance`'s refusal on a program
			// whose single-file spelling compiles. See `genericAliasSpellingIsSuperseded`.
			let live = try self.liveGenericAliasInstance(name) otherwise return true

			if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
				return true
			end 'alreadyInFlight'

			return self.instanceGraphSupportsDeepClone(live, visited: visited, purpose: purpose)
		end 'genericAlias'

		// ⛔ **A COMPILER-OWNED AGGREGATE IS NOT DEEP-CLONEABLE, AND THE GATE HAS TO SAY SO — its layout is
		// REGISTERED, so `containsStruct` below says yes and the walk would happily report its scalar-only
		// field list as clonable.** MEASURED without this arm: `type Holder { export var f as
		// __ManagedFile }` + `Array with Holder` + `a.clone()` reaches the backend and panics
		// `resolveCallFixups: call to unknown function '__clone___ManagedFile'`, because nothing synthesizes a
		// `__clone_<T>` for a type declared in no file. `managedNameCascadeStrategy` answers `unsupported` for
		// exactly these three names, and this is the arm that makes the two agree — which is what this
		// function's own header calls for: a name the gate and the strategy disagreed about would admit a
		// clone nobody can emit. The refusal the front end then reports is `requireArrayElementCopyable`'s
		// positioned E2015.
		//
		// It is a REFUSAL and not a gap: an OS handle cannot be deep-copied at all — duplicating one hands two
		// owners a descriptor whose `__mf_destruct` closes it once.
		return self.aggregateNameSupportsDeepClone(name, visited: visited, purpose: purpose)
	end 'typeSupportsDeepClone'

	// ⭐⭐ **THE CLONE WALK'S CYCLE BREAK — THE ONE HOME FOR ALL THREE OF ITS ARMS**: the aggregate NAME
	// (`aggregateNameSupportsDeepClone`), the generic-alias NAME (`typeSupportsDeepClone`) and the MANGLED
	// INSTANCE name (`declaredInstanceSupportsDeepClone`). One `visited` set serves the three because their
	// namespaces are disjoint by construction — a mangled name carries the reserved `__` prefix no
	// declaration may take.
	//
	// ⛔⛔ **EVERY ARM MUST MARK, OR THE WALK CANNOT TERMINATE.** The alias arm descends through
	// `instanceGraphSupportsDeepClone` into the container's ELEMENT, which for `typealias Cyc = Array with
	// Cyc` is `Cyc` again, so an unmarked name re-enters `typeSupportsDeepClone` at the same name forever — a
	// host stack overflow with no diagnostic at all. An alias merely DECLARED is enough to reach it: the gate
	// is asked over the interned instances, not over the uses.
	//
	// ⚠ **A NAME IN FLIGHT IS ASSUMED CLONABLE, AND FOR A CYCLIC ALIAS THAT ANSWER IS NEVER ACTED ON.** For
	// a recursive STRUCT (`type Node { var next as Node }`) it is simply true, and the synthesized cloner
	// recurses at run time through the same field. A cyclic ALIAS describes an infinite type, so `true` would
	// be wrong to act on — what makes it safe is the PIPELINE ORDER and not the diagnostic:
	// `checkGenericAliasCycles` runs at the declaration-check phase ahead of the backend, nothing between
	// this walk and there synthesizes a cloner, and the check reports NOTHING when the project already
	// carries an error (`ParseStaging.checkGenericAliasCycles`) — so this break must hold for a cyclic
	// program that never sees E2012 at all.
	function cloneWalkMayDescendInto(name ByteArray, visited ClonerSet) returns bool
		if visited.contains(name) 'alreadyOnThisWalk'
			return false
		end 'alreadyOnThisWalk'

		visited.insert(name)
		return true
	end 'cloneWalkMayDescendInto'

	// ⭐ **THE SAME QUESTION ASKED OF A RESOLVED AGGREGATE *NAME*** — the compiler-owned refusal, the cycle
	// break, and the struct/union field walk, which is everything `typeSupportsDeepClone` does once it has a
	// name in hand.
	//
	// ⚠ **IT IS SPLIT OUT SO THE SOURCE-LEVEL `.clone()` GATE AND THE ARRAY-ELEMENT GATE ASK ONE FUNCTION.**
	// A caller that went straight to the field walk would skip the compiler-owned arm, and the two would then
	// disagree about `CharacterSet` / `__ManagedFile` / `__ManagedDirectory` — the exact three names the arm
	// above records a measured backend panic for (`call to unknown function '__clone___ManagedFile'`).
	// Receiver arms in `dispatchMethodOnReceiver` intercept those types before a clone reaches this walk, so
	// such a divergence would be LATENT; a divergence held shut by an unrelated dispatch order is the shape
	// this file keeps paying for.
	function aggregateNameSupportsDeepClone(name ByteArray, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedPages or
			managedHandle or
			managedPin then return false

			managedSocket then return purposeAdmitsAnOsSocket(purpose)

			// A handle's clone is a real entry (`managedNameCascadeStrategy`), so the GATE must admit what the
			// STRATEGY answers — this arm and that one are the divergence this function exists to prevent.
			serviceHandle then return true
			userDeclared then break
		end 'compilerOwned'

		if not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyInFlight'
			return true
		end 'alreadyInFlight'

		if self.containsStructInAnyFile(name) 'struct'
			return self.structFieldsSupportDeepClone(name, visited: visited, purpose: purpose)
		end 'struct'

		match self.enumInAnyFile(name) 'union'
			declared(layout) then return self.unionPayloadsSupportDeepClone(layout, visited: visited, purpose: purpose)
			undeclared then return false
		end 'union'
	end 'aggregateNameSupportsDeepClone'

	// An ELEMENT-BEARING RECORD instance recurses into its element (a trivial one is a leaf; a managed
	// one must itself be deep-cloneable); any other instance (`Box with String`) walks its own SUBSTITUTED
	// fields, exactly as a declared struct walks its declared ones.
	//
	// ⭐ **THE CHAIN IS SUCH A RECORD AND IS ADMITTED BY THE SAME ARM** — it has no base layout to walk
	// either, and its copy is `__list_clone` / `__list_clone_managed`, whose two shapes are exactly the two this
	// arm already distinguishes. Answering it below, in the field walk, is what refused every
	// `Array with (List with Integer)`: a layout-less instance was read as *"no cloner exists"* when what was
	// missing was only a FIELD LIST, which a record does not have and does not need. The gate and
	// `elementRecordCascadeStrategy` split on one predicate pair (`isManagedListInstance` /
	// `containerElementIsManaged`) so neither can admit what the other cannot emit — and it is the
	// `__ManagedList` predicate on BOTH sides since `List` was retired, because a declared `List with T`
	// box HAS a field list and therefore belongs in the walk below.
	function instanceGraphSupportsDeepClone(id GenericInstanceId, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		if not self.isElementBearingRecordInstance(id) 'notAnElementRecord'
			return self.declaredInstanceSupportsDeepClone(id, visited: visited, purpose: purpose)
		end 'notAnElementRecord'

		if not self.containerElementIsManaged(id) 'trivialElement'
			// The gate half of `elementRecordCascadeStrategy`'s refusal — see
			// `containerOpaqueElementCanBeManaged` for the measurement and
			// `elementRecordCascadeStrategy` for why the two move together or not at all.
			return self.typeSupportsDeepClone(self.containerElementType(id), visited: visited, purpose: purpose) and not self.containerOpaqueElementCanBeManaged(id)
		end 'trivialElement'

		// A managed-element record clones its elements through `<containerClone>(field, funcAddr(elementClone))`
		// — a 2-arg call, which `callIndirect(fn, elem)` cannot reach. ⭐ **THE ELEMENT POSITION IS SERVED
		// BY A PER-INSTANCE ONE-ARGUMENT THUNK** (`MmRuntime.synthesizeElementRecordCloner`), whose whole body is
		// that 2-arg call, so the arity is no reason to refuse and this arm asks the SAME question in
		// both positions. `elementRecordCascadeStrategy` mints the thunk's symbol on exactly this envelope.
		return self.elementTypeSupportsCascade(self.containerElementType(id), visited: visited, purpose: purpose)
	end 'instanceGraphSupportsDeepClone'

	// ⭐⭐ **CAN A NON-`Array` GENERIC INSTANCE BE DEEP-CLONED?** `structFieldsSupportDeepClone`'s
	// instance twin, and the exact gate `installGenericInstanceCascades` synthesizes to — the two agree so the
	// synthesizer never meets an `unsupported` field on a program the front end accepted.
	//
	// ⚠ **AN INSTANCE THAT CLONES AT ALL CLONES AS AN ELEMENT TOO**, because `__clone_<mangled>` is the single
	// `(box) -> newBox` shape a `callIndirect(fn, elem)` needs — the same shape a declared struct's `__clone_<T>`
	// is. That argument holds for every shape, which is why there is no `asElement` parameter on the gate —
	// see `typeSupportsDeepClone`, which carries it.
	//
	// ⛔ **A BASE-LAYOUT-LESS INSTANCE IS REFUSED, AND IT IS THE SAME GATE THE DROP SIDE OPENS WITH.** A cursor
	// instance has no base struct to read fields out of (`genericInstanceHasBaseLayout`), so nothing synthesizes
	// a per-instance cloner for it and `instanceCascadeStrategy` answers `unsupported` at the same tier — a name
	// the gate and the strategy disagreed about would admit a clone nobody can emit.
	//
	// ⚠ **THE ELEMENT-BEARING RECORDS NEVER REACH HERE.** The managed buffer (`Array`, `FixedArray`) and the chain
	// have no base layout and need none: their copy is a runtime WALK, not a field cascade, and the caller's own
	// arm takes them (`isElementBearingRecordInstance`). Read as "refused" here, a `FixedArray` field or payload
	// would make its whole enclosing type uncopyable for want of a field list its record does not have.
	//
	// The cycle break is `cloneWalkMayDescendInto`'s, keyed by the MANGLED INSTANCE NAME in the same `visited`
	// set the two NAME arms use — sound because the namespaces are disjoint BY CONSTRUCTION:
	// `mangleGenericInstance` mints a contested name behind the reserved `__` prefix no declaration may take
	// (see its header). The key is built BEFORE the probe and so is paid on every instance node of every clone
	// walk, which is the one cost the shared break does not remove: a mangled name is derived from the
	// instance and there is no cheaper key that is still disjoint from the declared names sharing the set.
	function declaredInstanceSupportsDeepClone(id GenericInstanceId, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		if not self.genericInstanceHasBaseLayout(id) 'noSynthesizedCloner'
			return false
		end 'noSynthesizedCloner'

		if not self.cloneWalkMayDescendInto(self.mangleGenericInstance(id), visited: visited) 'alreadyInFlight'
			return true
		end 'alreadyInFlight'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			// The SUBSTITUTED type, which is what the synthesized body clones — `genericInstanceFieldDropCallee`
			// reads the same column for the same reason: the gate and the emitter must classify one type.
			let fieldType = self.substituteInstanceFieldType(id, index: i)

			if not self.typeOwesDrop(fieldType, from: self.typeNames) 'scalar'
				continue
			end 'scalar'

			if not self.typeSupportsDeepClone(fieldType, visited: visited, purpose: purpose) 'unsupportedField'
				return false
			end 'unsupportedField'
		end 'eachField'

		return true
	end 'declaredInstanceSupportsDeepClone'

	// ⭐ **A CONTAINER ELEMENT HELD AT AN INTERFACE TYPE IS REFUSED FOR BOTH PURPOSES, WHERE A FIELD IS ADMITTED
	// FOR BOTH** — the asymmetry is the slot and not the type. An element rides `callIndirect(fn, elem)`, which
	// carries ONE word; a fat pointer is two, and the witness half has nowhere to ride. A FIELD's witness half
	// sits in the box beside its value half, so the entry can read it back out.
	function elementTypeSupportsCascade(element MaxonType, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		if maxonTypeTag(element) == ValueTypeTag.interfaceRef 'aFatPointerElement'
			return false
		end 'aFatPointerElement'

		return self.typeSupportsDeepClone(element, visited: visited, purpose: purpose)
	end 'elementTypeSupportsCascade'

	function structFieldsSupportDeepClone(structName ByteArray, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		let layout = self.structLayoutOf(structName)

		for i in 0 upto layout.fieldCount() 'eachField'
			if not self.structFieldOwesDrop(structName, index: i) 'scalar'
				continue
			end 'scalar'

			let fieldType = try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.structFieldsSupportDeepClone: fieldTypes.get OOB at {i}")

			if not self.typeSupportsDeepClone(fieldType, visited: visited, purpose: purpose) 'unsupportedField'
				return false
			end 'unsupportedField'
		end 'eachField'

		return true
	end 'structFieldsSupportDeepClone'

	function unionPayloadsSupportDeepClone(layout EnumLayout, visited ClonerSet, purpose GraphCascadePurpose) returns bool
		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachField'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.unionPayloadsSupportDeepClone: payloadsAt count disagrees with get at {fi}")

				let payloadClass = classifyUnionPayload(self, typeNames: self.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)

				if not payloadClassIsManaged(payloadClass) and not payloadClassIsAGreenThread(payloadClass) 'scalar'
					continue
				end 'scalar'

				if not self.typeSupportsDeepClone(field.declaredType, visited: visited, purpose: purpose) 'unsupportedPayload'
					return false
				end 'unsupportedPayload'
			end 'eachField'
		end 'eachCase'

		return true
	end 'unionPayloadsSupportDeepClone'

	// ⭐ **THE KINDS OF RECORD THAT MAY LIE WITHIN A RECORD OF AGGREGATE `name`, OR OF INSTANCE `id`, AT ANY
	// DEPTH.** Asked by NAME for `unionHasManagedPayload`'s reason: the ids in a parser artifact's interner are not
	// this index's. The record's own kind is not among them unless it holds one of its own.
	export function recordKindsWithinAggregate(name ByteArray) returns HeldRecordKinds
		return self.walkRecordKindsWithinAggregate(name, visited: ClonerSet.create(), settledFree: ClonerSet.create())
	end 'recordKindsWithinAggregate'

	function walkRecordKindsWithinAggregate(name ByteArray, visited ClonerSet, settledFree ClonerSet) returns HeldRecordKinds
		let within = HeldRecordKinds.create()
		let denoted = self.denotedAggregateName(name)

		if self.isGenericAliasInAnyFile(denoted) 'anInstanceByItsAlias'
			self.addRecordKindsWithinGenericAlias(denoted, within: within, visited: visited, settledFree: settledFree)
			return within
		end 'anInstanceByItsAlias'

		self.addRecordKindsWithinAggregate(denoted, within: within, visited: visited, settledFree: settledFree)
		return within
	end 'walkRecordKindsWithinAggregate'

	// The kind a record of declared type `name` is, as `HeldRecordKinds` names it. A superseded generic alias,
	// which no value can have, throws.
	export function heldRecordKindOfDeclaredName(name ByteArray) returns immutable ByteArray throws MapError
		let denoted = self.denotedAggregateName(name)

		if self.isGenericAliasInAnyFile(denoted) 'anInstanceByItsAlias'
			return self.canonicalInstanceName(try self.liveGenericAliasInstance(denoted))
		end 'anInstanceByItsAlias'

		return HeldTupleKind if isTupleTypeName(denoted) else denoted
	end 'heldRecordKindOfDeclaredName'

	// The kinds of record a slot of any of `types` is or holds, at any depth.
	export function recordKindsOfTypes(types MaxonTypeArray) returns HeldRecordKinds
		let kinds = HeldRecordKinds.create()
		let visited = ClonerSet.create()
		let settledFree = ClonerSet.create()

		for slotType in types 'eachType'
			self.addRecordKindsOfType(slotType, within: kinds, visited: visited, settledFree: settledFree)
		end 'eachType'

		return kinds
	end 'recordKindsOfTypes'

	// May a value of `t` reach a function value? An opaque type and an interface value may hold anything.
	//
	// `settledFree` gathers every record a walk proved holds no function, and later walks skip
	// them. That is sound only because this question reads `anything` alone: a skipped record's
	// kinds are missing from the walk, so a caller that reads `kinds` must hand the walk an empty set.
	export function typeMayHoldAFunction(t MaxonType, from TypeNameInterner, settledFree ClonerSet) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.function or tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef 'opaqueOrAFunction'
			return true
		end 'opaqueOrAFunction'

		let visited = ClonerSet.create()

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.settleFunctionHolding(self.walkRecordKindsWithinInstance(genericInstanceIdOf(t), visited: visited, settledFree: settledFree), visited: visited, settledFree: settledFree)
		end 'anInstance'

		if tagIsByteRecord(tag) or not tagMayNameAggregate(tag) or not self.typeIsManaged(t, from: from) 'noRecordOfItsOwn'
			return false
		end 'noRecordOfItsOwn'

		return self.settleFunctionHolding(self.walkRecordKindsWithinAggregate(try from.nameOf(typeNameIdOf(t)) otherwise panic("ProgramSignatures.typeMayHoldAFunction: type name {typeNameIdOf(t)} is not interned in the table it was handed with"), visited: visited, settledFree: settledFree), visited: visited, settledFree: settledFree)
	end 'typeMayHoldAFunction'

	function settleFunctionHolding(within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet) returns bool
		if within.anything 'holdsOne'
			return true
		end 'holdsOne'

		for name in visited 'eachWalkedRecord'
			settledFree.insert(name)
		end 'eachWalkedRecord'

		return false
	end 'settleFunctionHolding'

	export function containerElementMayHoldAFunction(id GenericInstanceId) returns bool
		return self.containerElementIsOpaque(id) or self.typeMayHoldAFunction(self.containerElementType(id), from: self.typeNames, settledFree: ClonerSet.create())
	end 'containerElementMayHoldAFunction'

	export function recordKindsWithinInstance(id GenericInstanceId) returns HeldRecordKinds
		return self.walkRecordKindsWithinInstance(id, visited: ClonerSet.create(), settledFree: ClonerSet.create())
	end 'recordKindsWithinInstance'

	function walkRecordKindsWithinInstance(id GenericInstanceId, visited ClonerSet, settledFree ClonerSet) returns HeldRecordKinds
		let within = HeldRecordKinds.create()
		self.addRecordKindsWithinInstance(id, within: within, visited: visited, settledFree: settledFree)
		return within
	end 'walkRecordKindsWithinInstance'

	// The kind of record a slot of `type` holds, and every kind within it.
	function addRecordKindsOfType(type MaxonType, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		let tag = maxonTypeTag(type)

		if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.function 'opaque'
			within.anything = true
			return
		end 'opaque'

		if tagIsByteRecord(tag) 'bytes'
			within.kinds.insert(HeldByteRecordKind)
			return
		end 'bytes'

		if tag == ValueTypeTag.genericInstance 'instance'
			self.addRecordKindsOfInstance(genericInstanceIdOf(type), within: within, visited: visited, settledFree: settledFree)
			return
		end 'instance'

		if not tagMayNameAggregate(tag) 'aScalar'
			return
		end 'aScalar'

		let name = self.denotedSlotAggregateName(type)

		// The compiler-minted byte element is declared nowhere, so the lookup below would report it as
		// holding anything.
		if name.equals(SynthesizedByteElementName) 'aCompilerMintedByte'
			return
		end 'aCompilerMintedByte'

		let form = try self.declaredFormInAnyFile(name) otherwise 'undeclared'
			within.anything = true
			return
		end 'undeclared'

		match form 'form'
			structType or
			tupleAlias then self.addRecordKindsOfAggregate(name, within: within, visited: visited, settledFree: settledFree)

			enumType or
			unionType then self.addRecordKindsOfUnion(name, within: within, visited: visited, settledFree: settledFree)

			// A ranged alias IS its primitive.
			rangedAlias then return

			// An existential may hold any conformer, and a function value's environment any capture.
			interfaceType or
			functionAlias then within.anything = true

			genericAlias then self.addRecordKindsOfGenericAlias(name, within: within, visited: visited, settledFree: settledFree)
		end 'form'
	end 'addRecordKindsOfType'

	function addRecordKindsOfAggregate(name immutable ByteArray, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		within.kinds.insert(HeldTupleKind if isTupleTypeName(name) else name)
		self.addRecordKindsWithinAggregate(name, within: within, visited: visited, settledFree: settledFree)
	end 'addRecordKindsOfAggregate'

	// A payload-free enum's value is its tag; a boxed one is a record.
	function addRecordKindsOfUnion(name ByteArray, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		if self.declaredEnumIsBoxed(name) 'aRecord'
			self.addRecordKindsOfAggregate(name, within: within, visited: visited, settledFree: settledFree)
		end 'aRecord'
	end 'addRecordKindsOfUnion'

	// A superseded spelling no slot can name stands for any record.
	function addRecordKindsOfGenericAlias(name ByteArray, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		let live = try self.liveGenericAliasInstance(name) otherwise 'superseded'
			within.anything = true
			return
		end 'superseded'

		self.addRecordKindsOfInstance(live, within: within, visited: visited, settledFree: settledFree)
	end 'addRecordKindsOfGenericAlias'

	function addRecordKindsWithinGenericAlias(name ByteArray, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		let live = try self.liveGenericAliasInstance(name) otherwise 'superseded'
			within.anything = true
			return
		end 'superseded'

		self.addRecordKindsWithinInstance(live, within: within, visited: visited, settledFree: settledFree)
	end 'addRecordKindsWithinGenericAlias'

	function addRecordKindsOfInstance(id GenericInstanceId, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		within.kinds.insert(self.canonicalInstanceName(id))
		self.addRecordKindsWithinInstance(id, within: within, visited: visited, settledFree: settledFree)
	end 'addRecordKindsOfInstance'

	function addRecordKindsWithinAggregate(name ByteArray, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		if settledFree.contains(name) or not self.cloneWalkMayDescendInto(name, visited: visited) 'alreadyWalked'
			return
		end 'alreadyWalked'

		match compilerOwnedAggregateOf(self, name: name) 'compilerOwned'
			managedFile or
			managedDirectory or
			managedSocket or
			managedPages or
			managedHandle or
			managedPin or
			serviceHandle then within.anything = true

			userDeclared then self.addRecordKindsWithinDeclaration(name, within: within, visited: visited, settledFree: settledFree)
		end 'compilerOwned'
	end 'addRecordKindsWithinAggregate'

	function addRecordKindsWithinDeclaration(name ByteArray, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		if self.containsStructInAnyFile(name) 'struct'
			for fieldType in self.structLayoutOf(name).fieldTypes 'eachField'
				self.addRecordKindsOfType(fieldType, within: within, visited: visited, settledFree: settledFree)
			end 'eachField'

			return
		end 'struct'

		match self.enumInAnyFile(name) 'union'
			declared(layout) then self.addRecordKindsWithinPayloads(layout, within: within, visited: visited, settledFree: settledFree)
			undeclared then within.anything = true
		end 'union'
	end 'addRecordKindsWithinDeclaration'

	function addRecordKindsWithinPayloads(layout EnumLayout, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		for ci in 0 upto layout.caseCount() 'eachCase'
			for field in layout.payloadsAt(ci) 'eachField'
				self.addRecordKindsOfType(field.declaredType, within: within, visited: visited, settledFree: settledFree)
			end 'eachField'
		end 'eachCase'
	end 'addRecordKindsWithinPayloads'

	// A container holds its type arguments, and a declared generic only its fields: an argument no
	// field holds is phantom, and walking the arguments too never ends on a type that nests itself
	// over them. A green-thread handle's result waits in the scheduler, where any record may.
	function addRecordKindsWithinInstance(id GenericInstanceId, within HeldRecordKinds, visited ClonerSet, settledFree ClonerSet)
		if self.instanceIsPromiseHandle(id) 'aHandle'
			within.anything = true
			return
		end 'aHandle'

		let key = self.mangleGenericInstance(id)

		if settledFree.contains(key) or not self.cloneWalkMayDescendInto(key, visited: visited) 'alreadyWalked'
			return
		end 'alreadyWalked'

		if self.genericInstanceHasBaseLayout(id) 'aDeclaredGeneric'
			for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
				self.addRecordKindsOfType(self.substituteInstanceFieldType(id, index: i), within: within, visited: visited, settledFree: settledFree)
			end 'eachField'

			return
		end 'aDeclaredGeneric'

		for position in 0 upto self.genericInstanceArgCount(id) 'eachArgument'
			self.addRecordKindsOfType(self.substitutedInstanceArg(id, position: position), within: within, visited: visited, settledFree: settledFree)
		end 'eachArgument'
	end 'addRecordKindsWithinInstance'

	// The declared return type of `callee`, ADOPTED into `into` — the calling file's own artifact
	// interner. THE one door out of this index (see the header): a `named` type crosses by NAME and
	// is re-interned on arrival, so the id the parser stores is one its own file's merge will
	// resolve.
	export function returnTypeOf(callee ByteArray, into TypeNameInterner) returns CalleeReturn
		let declared = try self.settledDeclarations().returnTypes.get(callee) otherwise return CalleeReturn.undeclared
		return CalleeReturn.declared(self.adoptReturnType(declared, into: into))
	end 'returnTypeOf'

	export function declaredReturnAliasOf(callee ByteArray) returns DeclaredAlias
		match try self.settledDeclarations().returnTypes.get(callee) otherwise return DeclaredAlias.undeclared 'declared'
			void then return DeclaredAlias.undeclared
			value(inner) then return self.namedReturnAliasOf(inner, callee: callee)
		end 'declared'
	end 'declaredReturnAliasOf'

	// ⚠ The reader is the callee's OWN declaring file, never the caller's. `recordedReturnDeclFileOf`
	// carries why: a return type resolves against the file that declared the function, and reading it
	// from the call site gives one callee's return two meanings wherever the name coexists.
	function namedReturnAliasOf(inner MaxonType, callee ByteArray) returns DeclaredAlias
		if maxonTypeTag(inner) != ValueTypeTag.named 'namesNoAlias'
			return DeclaredAlias.undeclared
		end 'namesNoAlias'

		return self.aliasOf(self.nameOfId(typeNameIdOf(inner)), readerFilePath: self.recordedReturnDeclFileOf(callee))
	end 'namedReturnAliasOf'

	// ⭐⭐ **DOES `callee` RETURN THE TYPE THAT DECLARES IT — i.e. is it a `Self`-returning CONSTRUCTOR? THE
	// ONE HOME, because both sides of a hidden ABI block read it.** A static has no `self`, so its
	// dictionary columns — the layout descriptor and the constraint witnesses —
	// are sourced at the CALL SITE from the call's RESULT, and that is the concrete instance only when the
	// static returns its own type (`retypeGenericAliasConstructorResult`). `Parser.witnessReserveFor`
	// RESERVES the block on this answer and `ProgramSignatures.witnessParamCountForCallee` SUPPLIES it on the
	// same answer, so the two cannot size the block differently — which they must not, because a witness-slot
	// count is ABI and a mismatch is an argument-register disagreement nothing downstream can notice
	// (`witnessConstraintsOfMethod`'s header records what two such disagreements cost).
	//
	// ⚠ **IT READS THE DECLARED RETURN TYPE, NOT `FuncSignature.returnAggregateName`.** That column states
	// *"the identity that does NOT survive resolution"* and is therefore EMPTY for a struct return by design
	// (`Parser.erasedAggregateNameOf`) — measured: reading it here answered `false` for
	// `stdlib/Map.maxon`'s `static function init(…) returns Self`, so the parser reserved two witness slots
	// and the lowering bound none, and the body's first forward panicked.
	//
	// Allocation-free: it compares the interned NAME in this index's own table rather than adopting the type
	// into a caller's interner, because the question is about identity and not about a type crossing out.
	export function calleeReturnsItsDeclaringType(callee ByteArray) returns bool
		return match self.functionDeclaringType(callee) 'declaring'
			method(typeName) gives self.declaredReturnNamesStruct(callee, typeName: typeName)
			freeFunction or
			undeclared gives false
		end 'declaring'
	end 'calleeReturnsItsDeclaringType'

	// The tail of the question above, split out because a `match` arm may not open one.
	function declaredReturnNamesStruct(callee ByteArray, typeName ByteArray) returns bool
		match try self.settledDeclarations().returnTypes.get(callee) otherwise return false 'declared'
			void then return false
			value(inner) then return maxonTypeTag(inner) == ValueTypeTag.structRef and self.typeNames.equalsAt(typeNameIdOf(inner), other: typeName)
		end 'declared'
	end 'declaredReturnNamesStruct'

	// The number of witness parameters the CALLEE `callee` reserves: its witness-constraint count when it has
	// an instance to take them from or is a static that may carry them, zero otherwise. A static of the second
	// kind keeps them only while it carries the descriptor (`witnessSlotsCarriedBy`). Both the callee side
	// (append witness arguments) and the current-function side (bind witness parameters) read this ONE rule,
	// so they cannot drift on how many witnesses a call passes — and it is the count OF the very list
	// `appendWitnessArgs` then walks (`ProgramSignatures.witnessConstraintsOfMethod`), rather than a second
	// lookup that could answer for a different list.
	export function witnessParamCountForCallee(callee ByteArray, sig FuncSignature) returns ParamCount
		if self.hasNoInstanceToTakeHiddenArgumentsFrom(callee, takesReceiver: self.declaredCalleeTakesReceiver(callee)) and not self.staticMayCarryWitnessSlots(callee) 'noWitnessSource'
			return 0
		end 'noWitnessSource'

		return self.witnessConstraintsOfMethod(callee, extensionConstraints: sig.extensionConstraints).count()
	end 'witnessParamCountForCallee'

	export function witnessSlotsCarriedBy(callee ByteArray, sig FuncSignature, staticCarriesTheDescriptor bool) returns ParamCount
		let counted = self.witnessParamCountForCallee(callee, sig: sig)

		if counted != 0 and self.hasNoInstanceToTakeHiddenArgumentsFrom(callee, takesReceiver: self.declaredCalleeTakesReceiver(callee)) and not staticCarriesTheDescriptor 'aStaticThatCarriesNone'
			return 0
		end 'aStaticThatCarriesNone'

		return counted
	end 'witnessSlotsCarriedBy'

	export function staticMayCarryWitnessSlots(callee ByteArray) returns bool
		return self.hasNoInstanceToTakeHiddenArgumentsFrom(callee, takesReceiver: false) and not isFieldDefaultHelperName(callee)
	end 'staticMayCarryWitnessSlots'

	function declarationSiteOf(callee ByteArray) returns FunctionDeclSite throws AbsentError
		let sites = self.settledDeclarations().funcDeclSites

		if let direct = try sites.get(callee) 'declaredUnderThisName'
			return direct
		end 'declaredUnderThisName'

		if isParamDefaultHelperName(callee) 'aParamDefaultHelper'
			let setHelper = paramDefaultHelperNameOnMember(callee, member: genericTemplateName(paramDefaultCalleeSpelling(callee)))
			return try sites.get(setHelper) otherwise throw AbsentError.absent
		end 'aParamDefaultHelper'

		let setKey = genericTemplateName(callee)

		if let member = try sites.get(setKey) 'aMemberOfADeclaredSet'
			return member
		end 'aMemberOfADeclaredSet'

		let templates = try self.settledDeclarations().genericTemplates.get(setKey) otherwise throw AbsentError.absent
		let template = try templates.get(0) otherwise throw AbsentError.absent
		return FunctionDeclSite.create(template.visibility, declFilePath: template.declFilePath, takesReceiver: template.takesReceiver, nameLine: template.line, nameColumn: template.column, enclosingTypeName: template.enclosingTypeName)
	end 'declarationSiteOf'

	function isOwnedByTheCompiler(callee ByteArray) returns bool
		return (isCompilerInternalCallee(callee) and not isParamDefaultHelperName(callee) and not isFieldDefaultHelperName(callee)) or isServiceBehaveSymbol(callee) or isServiceFinishSymbol(callee)
	end 'isOwnedByTheCompiler'

	export function calleeMayCarryALayoutDescriptor(callee ByteArray) returns bool
		return match self.functionDeclaringType(callee) 'declaring'
			method(typeName) gives self.declaringTypeMayCarryADescriptor(typeName)
			freeFunction or
			undeclared gives false
		end 'declaring'
	end 'calleeMayCarryALayoutDescriptor'

	function declaringTypeMayCarryADescriptor(typeName ByteArray) returns bool
		if let layout = try self.registeredLayout(typeName) 'aStruct'
			return not layout.typeParamNames.isEmpty()
		end 'aStruct'

		if primitiveTagOfTypeName(typeName) != ValueTypeTag.unresolved 'aPrimitiveExtension'
			return false
		end 'aPrimitiveExtension'

		let form = try self.declaredFormInAnyFile(typeName) otherwise panic("declaringTypeMayCarryADescriptor: a function is declared on '{String.from(typeName)}', which no file declares as a type")

		match form 'form'
			enumType or
			unionType or
			interfaceType then return false
			structType or
			rangedAlias or
			functionAlias or
			genericAlias or
			tupleAlias then panic("declaringTypeMayCarryADescriptor: a function is declared on '{String.from(typeName)}', which the sweep records as a {form.name} and not as a type with a registered layout")
		end 'form'
	end 'declaringTypeMayCarryADescriptor'

	export function functionDeclaringType(funcName immutable ByteArray) returns DeclaringType
		var declared = funcName

		if isLiftedClosureName(funcName) 'aLiftedClosure'
			declared = self.liftedFunctionHostOf(funcName)
		end 'aLiftedClosure'

		if let site = try self.declarationSiteOf(declared) 'declaredBySource'
			if site.enclosingTypeName.isEmpty() 'aFreeFunction'
				return DeclaringType.freeFunction
			end 'aFreeFunction'

			return DeclaringType.method(site.enclosingTypeName)
		end 'declaredBySource'

		if self.isOwnedByTheCompiler(declared) 'noSourceByConstruction'
			return DeclaringType.freeFunction
		end 'noSourceByConstruction'

		if let typeName = try self.typeOfSynthesizedMember(declared) 'aMemberTheCompilerSynthesizes'
			return DeclaringType.method(typeName)
		end 'aMemberTheCompilerSynthesizes'

		return DeclaringType.undeclared
	end 'functionDeclaringType'

	function typeOfSynthesizedMember(name ByteArray) returns immutable ByteArray throws AbsentError
		match splitQualifiedName(name) 'qualified'
			notQualified then throw AbsentError.absent
			parts(typeName, _) then return try self.declaredTypeNamed(typeName)
		end 'qualified'
	end 'typeOfSynthesizedMember'

	function declaredTypeNamed(typeName immutable ByteArray) returns immutable ByteArray throws AbsentError
		if self.hasRegisteredLayout(typeName) or primitiveTagOfTypeName(typeName) != ValueTypeTag.unresolved 'aStructOrPrimitive'
			return typeName
		end 'aStructOrPrimitive'

		let form = try self.declaredFormInAnyFile(typeName) otherwise throw AbsentError.absent

		match form 'form'
			structType or
			enumType or
			unionType or
			interfaceType then return typeName
			rangedAlias or
			functionAlias or
			genericAlias or
			tupleAlias then throw AbsentError.absent
		end 'form'
	end 'declaredTypeNamed'

	// `declFilePath` is the file declaring `callee`: it decides whether the member is the program's or the
	// library's when both declare the name.
	export function aliasNestedInDeclaringTypeOf(callee ByteArray, aliasName ByteArray, declFilePath FilePath) returns immutable ByteArray throws AbsentError
		match self.functionDeclaringType(callee) 'declaring'
			method(typeName) then return joinQualifiedName(typeName, member: self.innerAliasMemberFor(typeName, member: aliasName, inExtensionBody: true, readerPath: declFilePath))
			freeFunction or
			undeclared then throw AbsentError.absent
		end 'declaring'
	end 'aliasNestedInDeclaringTypeOf'

	export function declaredCalleeTakesReceiver(callee ByteArray) returns bool
		match self.calleeReceiverOf(callee) 'receiver'
			takesReceiver then return true
			takesNone then return false
			undeclared then panic("declaredCalleeTakesReceiver: '{String.from(callee)}' has a signature and no declaration site and is neither a lifted closure nor a name the compiler owns — every caller reaches this after SemanticCheck has refused an undefined callee")
		end 'receiver'
	end 'declaredCalleeTakesReceiver'

	export function calleeReceiverOf(callee ByteArray) returns CalleeReceiver
		if isLiftedClosureName(callee) 'aClosureCarriesItsRecordNotAReceiver'
			return CalleeReceiver.takesNone
		end 'aClosureCarriesItsRecordNotAReceiver'

		if let site = try self.declarationSiteOf(callee) 'declaredBySource'
			return CalleeReceiver.takesReceiver if site.takesReceiver else CalleeReceiver.takesNone
		end 'declaredBySource'

		if self.isOwnedByTheCompiler(callee) 'noSourceByConstruction'
			return CalleeReceiver.takesNone
		end 'noSourceByConstruction'

		return CalleeReceiver.undeclared
	end 'calleeReceiverOf'

	export function callBuildsTheInstanceOfItsOwnType(callee ByteArray, instance GenericInstanceId) returns bool
		return match self.functionDeclaringType(callee) 'declaring'
			method(typeName) gives self.genericInstanceBaseName(instance).equals(typeName)
			freeFunction or
			undeclared gives false
		end 'declaring'
	end 'callBuildsTheInstanceOfItsOwnType'

	function precedesTheKeptSite(key ByteArray, declFilePath FilePath, nameLine LineNumber, nameColumn ColumnNumber) returns bool
		let kept = try self.declaredSiteOf(key) otherwise return false

		return SourceSite.of(declFilePath, line: nameLine, column: nameColumn).precedes(SourceSite.of(kept.declFilePath, line: kept.nameLine, column: kept.nameColumn))
	end 'precedesTheKeptSite'

	export function declaredSiteOf(key ByteArray) returns FunctionDeclSite throws AbsentError
		return try self.settledDeclarations().funcDeclSites.get(key) otherwise throw AbsentError.absent
	end 'declaredSiteOf'

	// Whether the declaration the sweep kept for `key` is not the one written at this position.
	// `funcDeclSites` keeps the first declaration filed, so every later one answers true; a key nothing
	// has filed answers false.
	export function keyBelongsToAnotherDeclaration(key ByteArray, declFilePath FilePath, line LineNumber, column ColumnNumber) returns bool
		let site = try self.declaredSiteOf(key) otherwise return false

		return not (site.declFilePath.equals(declFilePath) and site.nameLine == line and site.nameColumn == column)
	end 'keyBelongsToAnotherDeclaration'

	export function typeDeclaresField(typeName ByteArray, fieldName ByteArray) returns bool
		let layout = try self.registeredLayout(typeName) otherwise return false

		return layout.fieldNames.contains(fieldName)
	end 'typeDeclaresField'

	// The `bool` half of `returnTypeOf`, which adopts the return type into the asker's interner: that
	// allocates and needs an interner the asker may not hold, and a `Map.contains` needs neither. A
	// method is asked by its mangled key (`Widget.byteLength`), the key the index files it under.
	export function declaresCallee(callee ByteArray) returns bool
		return self.settledDeclarations().returnTypes.contains(callee)
	end 'declaresCallee'

	export function functionTypedBindingVisibleFrom(name ByteArray, readerFilePath FilePath, into TypeNameInterner) returns bool
		if not self.topLevelBindingVisibleFrom(name, readerFilePath: readerFilePath) 'noBindingOfThisName'
			return false
		end 'noBindingOfThisName'

		return match self.globalDeclFor(name, readerFilePath: readerFilePath, into: into) 'binding'
			found(_, valueType, _) gives maxonTypeTag(valueType) == ValueTypeTag.function
			notFound or
			poisoned gives false
		end 'binding'
	end 'functionTypedBindingVisibleFrom'

	export function siblingKindFrom(written ByteArray, enclosingTypeName ByteArray, walked WalkedSibling) returns SiblingKind
		if enclosingTypeName.isEmpty() 'notInATypeBody'
			return SiblingKind.notASibling
		end 'notInATypeBody'

		match walked 'walked'
			takesReceiver then return SiblingKind.instanceSibling
			takesNoReceiver then return SiblingKind.staticSibling
			notWalked then break
		end 'walked'

		let sibling = qualifiedMethodName(enclosingTypeName, methodName: written)

		if self.declaresCallee(sibling) 'indexedSibling'
			return SiblingKind.instanceSibling if self.declaredMethodTakesReceiver(sibling) else SiblingKind.staticSibling
		end 'indexedSibling'

		let template = try self.genericTemplatesOf(sibling).get(0) otherwise return SiblingKind.notASibling
		return SiblingKind.instanceSibling if template.takesReceiver else SiblingKind.staticSibling
	end 'siblingKindFrom'

	export function bareNameKindFrom(written ByteArray, readerFilePath FilePath) returns BareCallKind
		if self.isContestedFreeFunction(written) 'severalDirectoriesDeclareIt'
			return match self.resolveBareFunctionName(written, readerFilePath: readerFilePath) 'resolution'
				declaration gives BareCallKind.declaredVisible
				ambiguous gives BareCallKind.ambiguous
				undeclared gives self.invisibleBareNameKind(written, readerFilePath: readerFilePath)
			end 'resolution'
		end 'severalDirectoriesDeclareIt'

		if self.declaresCallee(written) and self.declaresAFunctionVisibleFrom(written, readerFilePath: readerFilePath) 'aVisibleDeclaration'
			return BareCallKind.declaredVisible
		end 'aVisibleDeclaration'

		return self.invisibleBareNameKind(written, readerFilePath: readerFilePath)
	end 'bareNameKindFrom'

	function invisibleBareNameKind(written ByteArray, readerFilePath FilePath) returns BareCallKind
		if self.declaresAGenericTemplateVisibleFrom(written, readerFilePath: readerFilePath) 'aVisibleTemplate'
			return BareCallKind.genericTemplate
		end 'aVisibleTemplate'

		if isBareBuiltinCallee(written) 'aBuiltin'
			return BareCallKind.builtin
		end 'aBuiltin'

		return BareCallKind.declaredHidden if self.declaresCallee(written) or self.isGenericFunctionKey(written) else BareCallKind.undeclared
	end 'invisibleBareNameKind'

	// The one answer to "does a call to this name have a definition", for the parser's deferral doors.
	// `declaresCallee` goes first: it is one map lookup, and
	// `isCompilerInternalCallee` can allocate.
	export function definesCallee(callee ByteArray) returns bool
		return self.declaresCallee(callee) or isCompilerInternalCallee(callee)
	end 'definesCallee'

	// ⭐⭐ **DOES `typeName` SUPPLY THE CURSOR PROTOCOL A `for … in` OVER A USER TYPE LOWERS TO?**
	// (conditional extensions) — `current()`, which yields the element the trip is positioned on, and a
	// THROWING `advance()`, whose throw is how the walk ends. Both must be declared on the type itself:
	// a DIRECT-CALL source dispatches statically, so the loop emits `<typeName>.current` /
	// `<typeName>.advance` and the declarations ARE what makes the loop expressible.
	//
	// ⚠ **IT ANSWERS FOR THE DIRECT-CALL RECEIVER ONLY; the witness-dispatched one is
	// `Parser.surfaceDeclaresCursorProtocol`'s other arm.** A dispatched receiver's protocol is a REQUIREMENT,
	// which no callee registry holds, so that arm reads the transitive slot list instead. The ONE part of the
	// rule shared between them is the error type, written once as `throwsClauseIsIterationError`.
	//
	// ⛔ **AND THE REST OF THE RULE IS NOT SHARED — THIS SIDE TESTS EXISTENCE AND THE CLAUSE, AND NOTHING
	// ELSE.** The dispatched arm additionally requires the requirement to take a receiver and to declare no
	// parameters (`witnessProtocolTarget`); this one cannot, because `declaresCallee` is a NAME lookup and no
	// per-callee arity is stored to ask. So a `current(at Index)` beside a throwing `advance()` is admitted
	// here and then reported downstream by `emitCall` as **`E3036: 'Weird.current' expects 2 argument(s) but 1
	// were provided`** (MEASURED) — an argument count against a call the author never wrote, where this door
	// exists to give a clean E2015. That is a REAL gap on this side and it predates the dispatched arm; it is
	// recorded here rather than papered over, because the shape of the fix is a per-callee arity the index
	// does not carry.
	//
	// ⭐⭐ **STRUCTURAL, NOT A CONFORMANCE.** A bare `type IntList` with the two methods and NO `implements`
	// clause at all must compile and run `for item in self`, so an interface requirement here would be a
	// false REJECT — and it would buy nothing: the two direct calls are all the lowering needs, and a
	// conformance cannot make a missing method appear.
	//
	// ⚠⚠ **THE `advance()` THROW IS PART OF THE SHAPE, AND SO IS THE ERROR TYPE IT NAMES.** The loop's ONLY
	// exit is that throw (`Parser.parseForStatement`'s cursor step carries the error flag as the header's
	// block-arg), so a non-throwing `advance()` would spin forever — and the loop ABSORBS the thrown value
	// without binding it, which is safe for `IterationError` (compiler-owned, payload-FREE, so the throw
	// hands over a scalar tag and there is nothing to release) and would LEAK for an error enum carrying a
	// managed payload. Pinning the clause to `IterationError` is what makes the absorption sound by
	// construction rather than by a rule somewhere else remembering to check the payload — and it is
	// verbatim what `stdlib/Interfaces.maxon:145` declares, so it narrows nothing a conforming type writes.
	export function declaresCursorProtocol(typeName ByteArray) returns bool
		if not self.declaresCallee(qualifiedMethodName(typeName, methodName: CurrentMethodName)) 'noCurrent'
			return false
		end 'noCurrent'

		let advance = qualifiedMethodName(typeName, methodName: AdvanceMethodName)

		if not self.declaresCallee(advance) 'noAdvance'
			return false
		end 'noAdvance'

		return throwsClauseIsIterationError(self.throwsOf(advance))
	end 'declaresCursorProtocol'

	// ⭐⭐ **DOES `typeName` SUPPLY THE `Iterable` HALF OF THE TRAVERSAL PROTOCOL?** — a
	// `createIterator()` a `for … in` can call once, in the preheader, to obtain the cursor it then walks
	// through `declaresCursorProtocol`'s two names. `declaresCursorProtocol`'s twin, and STRUCTURAL for its
	// exact reason: a direct-call source dispatches statically, so what the loop needs is the declaration, and
	// a `createIterator` on a type carrying no `implements` clause at all is accepted. The
	// existential's half is `Parser.surfaceIterableFactory`, split from this the same way and for the same
	// reason.
	//
	// The EXISTENCE half is this store's; the classification of what the declaration THROWS is
	// `iterableFactoryFromClause`'s, shared with the existential door that reads the same fact off an
	// interface requirement instead of off a declared callee.
	export function iterableFactory(typeName ByteArray) returns IterableFactory
		let create = qualifiedMethodName(typeName, methodName: CreateIteratorMethodName)

		if not self.declaresCallee(create) 'noFactory'
			return IterableFactory.notDeclared
		end 'noFactory'

		return iterableFactoryFromClause(self.throwsOf(create))
	end 'iterableFactory'

	// ⭐⭐ **DOES `written` RESOLVE AS A DIRECTORY-QUALIFIED FREE CALL — THE WHOLE RULE, IN ONE PLACE?**
	// It is asked of the WHOLE assembled dotted name (`utils.helper`, `lib.inner.deepHelper`), never of its
	// head alone. It is reached only through `resolveQualifiedFunctionName`, so every position a chain is
	// written in reads one answer.
	//
	// **THE TYPE READING WINS WHEREVER THERE IS ONE**, which is the `declaresCallee` half: a `type utils` with
	// a `static helper` keeps `utils.helper()`, so a directory may be named after a type and no existing call
	// moves.
	//
	// ⛔ **ASKING ABOUT THE HEAD ALONE IS THE DESIGN THAT DOES NOT WORK, and it is worth stating because it is
	// the obvious one.** "Is `utils` a known namespace?" invents an ambiguity nothing else has — a
	// directory `feature/` beside a `type feature` would then have two readings of `feature.f()` with
	// nothing to choose between them. The ASSEMBLED name has one reading: it is either a key here or
	// it is not, exactly as `Wrapper.Idx` and `api.Score` are keys in one map and never compete.
	//
	// A contested free function is registered under its `<directory>~name` mint, so the written
	// `lib.inner.pick` is never a registered key and `declaresCallee` does not veto it.
	function resolvesAsNamespaceQualifiedFunction(written ByteArray) returns bool
		if not self.settledDeclarations().namespaceQualifiedFunctions.contains(written) 'noDirectoryDeclaresIt'
			return false
		end 'noDirectoryDeclaresIt'

		return not (self.declaresCallee(written) or self.isGenericFunctionKey(written))
	end 'resolvesAsNamespaceQualifiedFunction'

	export function adoptReturnType(rt MaxonReturnType, into TypeNameInterner) returns MaxonReturnType
		return match rt 'r'
			void gives rt
			value(inner) gives self.adoptValueReturn(rt, inner: inner, into: into)
		end 'r'
	end 'adoptReturnType'

	// Only the ID-BEARING arms are rebuilt. Every other return type is already interner-free, and
	// the STORED union is handed straight back — which is what keeps the per-call path from
	// allocating a fresh `MaxonReturnType` for every `returns bool` in the program (a Maxon union
	// value is a heap object, every case — see MaxonDialect's ValueTypeTag header).
	//
	// ⚠ It cannot simply delegate to `adoptType` and re-wrap unconditionally: that would CONSTRUCT a
	// `MaxonReturnType.value(...)` for every callee in the program, id-bearing or not, which is the
	// allocation the `rt` pass-through exists to avoid. So the id-free arms answer with `rt` here,
	// and `adoptType` answers with `t` there — two functions, one rule, each returning the union it
	// was actually handed.
	//
	// ⚠ The two id-bearing arms are written out, NOT collapsed to a `named to structRef` range:
	// `exitCode` and `unresolved` sit BETWEEN them in `MaxonType`, so that range would silently
	// swallow both and re-wrap them into a freshly allocated union,
	// costing an allocation rather than a wrong answer this time.
	function adoptValueReturn(rt MaxonReturnType, inner MaxonType, into TypeNameInterner) returns MaxonReturnType
		return match inner 'r'
			named or
			structRef or

			// A function return type carries its governing name id, so it re-interns like `named`.
			function or

			// A type-parameter or generic-instance return type (`get() returns T`) carries no per-file
			// interner id (a source-derived digest, a whole-program giid), so it crosses files unchanged;
			// routing it through `adoptType` keeps the one crossing door.
			typeParameter or
			genericInstance or

			// An existential return type carries the interface's per-file interner id, so it re-interns
			// like `named`. This is the crossing that makes `let p = f.make()` in another file name the
			// same interface the declaring file did — which is what the result's dispatch resolves its
			// slot against.
			interfaceRef gives MaxonReturnType.value(self.adoptType(inner, into: into))

			// A `String`, `Character` or primitive return type carries no interned name, so it crosses files
			// unchanged.
			boolean or
			integer or
			float or
			exitCode or
			unresolved or
			string or
			character or
			cstring gives rt
		end 'r'
	end 'adoptValueReturn'

	// Re-intern the name an id-bearing `MaxonType` carries into `into`, so the type is
	// indistinguishable from one the calling file had parsed itself. THE one place this index's ids
	// cross out of it (see the header's ID PROBLEM); its callers — `fieldTypeOf`, `adoptValueReturn`
	// (for `returnTypeOf`), and the parser's union-payload sites — re-intern a member/return/payload
	// type by NAME, and none re-derives it. It re-interns by NAME, never leaking a raw id, so the
	// returned type's id belongs to `into` and the "an id may not leave this type" invariant holds.
	//
	// Exported for the union-payload sites: unlike a struct field or a return type, a union payload's
	// `declaredType` is already in the caller's hand (it fetched the layout and walked `payloadsAt`),
	// so it needs this bare crossing rather than a name+index fetch door like `fieldTypeOf`. Routing
	// those sites through here is what keeps a signatures-interner payload id from being classified /
	// minted against the parser's own interner.
	export function adoptType(t MaxonType, into TypeNameInterner) returns MaxonType
		return match t 'r'
			named(id) gives MaxonType.named(into.intern(self.nameOfId(id)))

			// ⭐ **A TUPLE `structRef` IS CANONICALIZED ON THE WAY OUT, and this door is where it has
			// to be.** A tuple minted by the DECLARATION SWEEP names its elements the way the source spelled
			// them, because the registries that say what those spellings MEAN are still being built when the
			// sweep runs (see `internTupleType`). Every sweep-recorded type reaches a reader through here — a
			// call RESULT via `adoptValueReturn`, a struct FIELD via `declaredSlotType` — so rewriting it once,
			// here, is what makes `let t = makePair(…)` and a locally-built `(10, 32)` the same type. It is the
			// same arrangement `declaredSlotType`'s re-tags live under, one tier down.
			structRef(id) gives MaxonType.structRef(into.intern(self.canonicalNameOfStruct(self.nameOfId(id))))

			// A `String`, a `Character` and a primitive carry no name id, so they pass through unchanged.
			boolean or
			integer or
			float or
			exitCode or
			unresolved or
			string or

			// A type-parameter reference and a generic instance carry GLOBAL ids — a `(declaring type,
			// parameter name)` DIGEST, a pure function of source text, and a `GenericInstanceId` keyed on
			// THIS index's own registry — not per-file interner ids, so there is nothing to remap.
			typeParameter or
			genericInstance or
			character or
			cstring gives t

			// A FUNCTION value carries its governing name id, re-interned by NAME like `named`.
			function(id) gives MaxonType.function(into.intern(self.nameOfId(id)))

			// An existential carries the INTERFACE's name id, re-interned by NAME like `named` — which is
			// what lets a field declared at an interface type and a call returning one cross into a reader's
			// own interner and still name the interface the dispatch resolves against.
			interfaceRef(id) gives MaxonType.interfaceRef(into.intern(self.nameOfId(id)))
		end 'r'
	end 'adoptType'

	// Mix one declaration into the running hash: the function's NAME, then its return type's SHAPE,
	// then — for a named type — that TYPE's name. Names, never ids: an id depends on the order the
	// index happened to intern in, so hashing one would let a new declaration in an unrelated file
	// shift every later id and invalidate every parse memo in the project for nothing.
	//
	// ⚠ **THE BUFFER SPELLING MUST RIDE, AND IT IS THE ONE FACT HERE THE RETURN TYPE CANNOT CARRY.**
	// `returns __ManagedMemory` and `returns ByteArray` resolve to the SAME `genericInstance`, so
	// `mixReturnType` folds them identically — an edit from one to the other would move no hash, and every
	// caller's parse memo would stay valid while what its calls MEAN had changed. Its own discriminator pair,
	// for `declShapeAlias`'s reason.
	//
	// ⚠ **THE VISIBILITY TIER MUST RIDE TOO, for `recordAlias`'s reason one declaration kind over.** Adding or
	// removing `export` on a `static function` changes whether ANOTHER file's `var db = Database.create()`
	// compiles at all, and that decision is baked into that file's memoized parse. The whole ORDINAL rather than an exported bit, exactly as `recordAlias` states: a new tier
	// rides automatically.
	//
	// ⚠ **THE RECEIVER BIT MUST RIDE, for the visibility tier's reason exactly.** Adding or removing `static`
	// on a method decides whether a bare `helper()` in ANOTHER file's `extension` body resolves — and, when it
	// does, whether the call carries the enclosing `self` — so the answer is baked into that file's memoized
	// parse and the key that memo is validated against has to move with it.
	function mixDeclaration(state HashDigest, name ByteArray, returnType MaxonReturnType, declaredSurface DeclaredSurface, visibility Visibility, declFilePath FilePath, takesReceiver bool, opaqueParams OpaqueParamInfo, paramNames NameRoster, paramTypes MaxonTypeArray, paramSpellings NameRoster, paramDefaults ParamPositionMask, selfCapability ParamCapability, paramCapabilities ParamCapabilityArray, returnCapability ResultCapability) returns HashDigest
		let named = self.mixReturnType(mixBytes(state, bytes: name), returnType: returnType)
		let tiered = mixDeclaringTier(mixSurface(Hasher.combined(named, value: SignatureDiscriminator.returnShapeSurface), surface: declaredSurface), visibility: visibility, declFilePath: declFilePath)
		let received = mixOpaqueParams(Hasher.combined(tiered, value: SignatureDiscriminator.receiverShapePresent if takesReceiver else SignatureDiscriminator.receiverShapeAbsent), opaqueParams: opaqueParams)
		let spelled = Hasher.combined(mixCapabilities(Hasher.combined(received, value: SignatureDiscriminator.declShapeHeaderSpelling), params: paramCapabilities, result: returnCapability), value: selfCapability.ordinal as HashDigest)
		return self.mixDeclaredParams(spelled, paramNames: paramNames, paramTypes: paramTypes, paramSpellings: paramSpellings, paramDefaults: paramDefaults)
	end 'mixDeclaration'

	function mixDeclaredParams(state HashDigest, paramNames NameRoster, paramTypes MaxonTypeArray, paramSpellings NameRoster, paramDefaults ParamPositionMask) returns HashDigest
		if paramNames.isEmpty() 'declaresNoParameter'
			return state
		end 'declaresNoParameter'

		var mixed = Hasher.combined(state, value: SignatureDiscriminator.declShapeDeclaredParams)

		for i in 0 upto paramNames.count() 'eachParameter'
			let paramName = try paramNames.get(i) otherwise panic("mixDeclaredParams: paramNames.get OOB at {i} despite i < count")
			let paramType = try paramTypes.get(i) otherwise panic("mixDeclaredParams: paramTypes.get OOB at {i} — the sweep pushes a parameter's name and type in lockstep")
			let brand = try paramSpellings.get(i) otherwise panic("mixDeclaredParams: paramSpellings.get OOB at {i} — the sweep pushes a parameter's spelling beside its type")
			let defaultBit = SignatureDiscriminator.defaultBitSet if maskHasParam(paramDefaults, param: i as ParamCount) else SignatureDiscriminator.defaultBitClear
			mixed = Hasher.combined(self.mixType(mixBytes(mixBytes(mixed, bytes: paramName), bytes: brand), t: paramType), value: defaultBit)
		end 'eachParameter'

		return mixed
	end 'mixDeclaredParams'

	// ⭐ The opaque-parameter half of a declaration's hash — see `declShapeOpaqueParams` for what a
	// reader copies out of it. A declaration that takes no bare type parameter mixes NOTHING, so every
	// program without a generic type hashes as though this mix did not exist: absence is the answer here
	// too, and `recordThrows` skips a non-throwing clause for the same reason.
	function mixOpaqueParams(state HashDigest, opaqueParams OpaqueParamInfo) returns HashDigest
		if not opaqueParams.declaresATypeParameterParam() 'takesNoBareTypeParameter'
			return state
		end 'takesNoBareTypeParameter'

		var mixed = Hasher.combined(state, value: SignatureDiscriminator.declShapeOpaqueParams)

		for i in 0 upto opaqueParams.paramNames.count() 'eachSlot'
			let paramName = try opaqueParams.paramNames.get(i) otherwise panic("mixOpaqueParams: paramNames.get OOB at {i} despite i < count")

			// A concrete slot hashes as `typeParamCount`, which no `uses` position equals, so it cannot collide
			// with a type-parameter slot.
			let slotDigest = (try opaqueParams.positionAt(i as ParamCount) otherwise opaqueParams.typeParamCount) as HashDigest
			mixed = Hasher.combined(mixBytes(mixed, bytes: paramName), value: slotDigest)
		end 'eachSlot'

		return Hasher.combined(mixed, value: opaqueParams.typeParamCount as HashDigest)
	end 'mixOpaqueParams'

	function mixReturnType(state HashDigest, returnType MaxonReturnType) returns HashDigest
		return match returnType 'r'
			void gives Hasher.combined(state, value: SignatureDiscriminator.returnShapeVoid)
			value(inner) gives self.mixType(Hasher.combined(state, value: SignatureDiscriminator.returnShapeValue), t: inner)
		end 'r'
	end 'mixReturnType'

	function mixType(state HashDigest, t MaxonType) returns HashDigest
		return match t 'r'
			boolean gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeBoolean)
			integer gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeInteger)
			float gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeFloat)
			named(id) gives mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeNamed), bytes: self.nameOfId(id))
			exitCode gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeExitCode)

			// `Parser.parseTypeReference` produces only `named` and the three primitive keywords, so
			// a SCANNED signature can never carry `unresolved` — TypeResolution is what mints those,
			// and it runs long after this. The arm exists because the match is exhaustive, and it
			// hashes rather than panicking so that a future producer of `unresolved` signatures is a
			// cache-key question, not a crash.
			unresolved gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeUnresolved)

			// A struct reference, which a scanned signature very much CAN carry: `static function
			// create(…) returns Self` inside `type Point` is recorded as `structRef(Point)` by
			// `Parser.parseTypeReference`, so every declared factory in the program hashes through
			// here. Its own shape (see `typeShapeStructRef`) and then its NAME — never its id, for
			// `mixDeclaration`'s reason.
			structRef(id) gives mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeStructRef), bytes: self.nameOfId(id))

			// A `String` — its own shape, and no name to mix (a builtin carries none). A
			// signature declaring `returns String` hashes distinctly from every other return type.
			string gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeString)

			// A FUNCTION value — its own shape, then its governing NAME (never its id, for
			// `mixDeclaration`'s reason).
			function(id) gives mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeFunction), bytes: self.nameOfId(id))

			// A TYPE-PARAMETER reference — its own shape, then its TOKEN. ⚠ **THE ONE ARM THAT MIXES
			// AN `id` RATHER THAN A NAME, AND FOR A GOOD REASON.** `mixDeclaration`'s
			// rule is names-never-ids because an INTERN-ORDER id shifts when an unrelated file declares
			// something; a type-parameter token is not an intern-order id at all, it is a digest of the two
			// NAMES (`typeParamTokenFor`), so mixing it IS mixing those names — it moves when and only when
			// the declaring type or the parameter is renamed, which is exactly when a reader's memo must
			// move. It also finally hashes `uses A, B`'s `returns A` apart from ANOTHER type's `returns X`,
			// where the position hashed them alike.
			typeParameter(id) gives Hasher.combined(Hasher.combined(state, value: SignatureDiscriminator.typeShapeTypeParameter), value: id as HashDigest)

			// A GENERIC INSTANCE — its own shape, then its base NAME (never its id) and each ARG's
			// shape (recursed), so `Box with Integer` and `Box with Bool` hash apart. `mixGenericInstance`
			// reads the `(baseId, args)` payload out of THIS index's own registry.
			genericInstance(id) gives self.mixGenericInstance(Hasher.combined(state, value: SignatureDiscriminator.typeShapeGenericInstance), id: id)

			// A `Character` — its own shape, and no name to mix. It hashes DISTINCTLY from
			// `string`: the two share a record but not a type (see `typeShapeCharacter`).
			character gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeCharacter)

			// An EXISTENTIAL — its own shape, then the INTERFACE's name (never its id, for `mixDeclaration`'s
			// reason). A signature declaring `returns Producer` must hash apart from one declaring
			// `returns Consumer`: the two pick different witness slots at every dispatch of the result.
			interfaceRef(id) gives mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeInterfaceRef), bytes: self.nameOfId(id))
			cstring gives Hasher.combined(state, value: SignatureDiscriminator.typeShapeCstring)
		end 'r'
	end 'mixType'

	// Fold a generic instance's base name and args into the hash — the recursive half of `mixType`'s
	// `genericInstance` arm, split out because it decodes the registry and folds a list.
	function mixGenericInstance(state HashDigest, id GenericInstanceId) returns HashDigest
		var out = mixBytes(state, bytes: self.nameOfId(self.rowBaseId(id)))

		for arg in self.rowArgs(id) 'eachArg'
			out = self.mixType(out, t: arg)
		end 'eachArg'

		return out
	end 'mixGenericInstance'

	// A struct name as a READER outside this index must see it: a TUPLE name is canonicalized, every
	// other name is itself. Before `tupleNamesAreCanonical`, every read sees the spelling the sweep
	// minted.
	export function canonicalNameOfStruct(name immutable ByteArray) returns immutable ByteArray
		if not self.tupleNamesAreCanonical() or not isTupleTypeName(name) 'notACanonicalizableTuple'
			return name
		end 'notACanonicalizableTuple'

		return self.canonicalTupleName(name)
	end 'canonicalNameOfStruct'

	// Before `allFilesFolded` a tuple's canonical form is not computable. Before
	// `settleRangeScopedInstances` it is computable but can be wrong: which declaration of a contested
	// ranged alias a file means is not settled, and the service companions
	// `Queries.closeDeclarationFold` synthesizes in between would canonicalize, and memoize, a
	// message parameter's tuple over a sibling module's elements.
	function tupleNamesAreCanonical() returns bool
		return self.allFilesFolded and self.rangeContestsSettled
	end 'tupleNamesAreCanonical'

	function nameOfId(id TypeNameId) returns immutable ByteArray
		return try self.typeNames.nameOf(id) otherwise panic("ProgramSignatures: type-name id {id} is not in this index's own interner — every id it stores was minted by foldFile's fold into that table")
	end 'nameOfId'

	export function typeNameTable() returns TypeNameInterner
		return self.typeNames
	end 'typeNameTable'

	// Publishes a clone: the sweep's own records are also held by tokens, paths and the `Project`,
	// and publishing a record held elsewhere aborts the compile (exit 96). A published graph may not
	// reach one record twice either, so the clone's alias registries hold their own equal copy of
	// `fileModuleDirectories`; nothing writes either copy after the settle.
	export function publishedDeclarations() returns SettledDeclarationsCell
		if let held = try self.published.get(0) 'alreadyPublished'
			return held.clone()
		end 'alreadyPublished'

		let cell = SettledDeclarationsCell.create(SettledDeclarationsBox.create(self.settledDeclarations().clone()))
		self.published.push(cell.clone())

		return cell
	end 'publishedDeclarations'

	// The view cache is released first: the clones below copy it too.
	//
	// ⚠ One expression, so no named local holds a second reference to a part of the published graph:
	// the publish walks it for soleness, and a record reached twice aborts the compile (exit 96).
	export function workerTemplate(os Os) returns IndexTemplateCell
		self.releaseTypeNameViews()

		return IndexTemplateCell.create(IndexTemplate.create(ProgramSignatures.reassembled(self, tables: IndexTables.fresh(TypeNameInterner.createForSource(0), liveDefaultKeyNames: self.liveDefaultKeyNames), baseline: self.baseline, own: OwnedDeclarations.held(SettledDeclarations.create(os)), shared: freeze SettledDeclarations.unused()).clone(), base: IndexBase.create(self.aliasedTables().clone(), names: self.typeNames.frozenNames())))
	end 'workerTemplate'

	function aliasedTables() returns IndexTables
		return IndexTables.create(self.structSlots, mintedTupleLayouts: self.mintedTupleLayouts, published: self.published, genericInstances: self.genericInstances, compiledInstanceNames: self.compiledInstanceNames, canonicalInstanceNames: self.canonicalInstanceNames, substitutedInstanceOrigins: self.substitutedInstanceOrigins, canonicalInstanceNameIndex: self.canonicalInstanceNameIndex, tupleCanonicalNames: self.tupleCanonicalNames, tupleElementTokens: self.tupleElementTokens, tupleElementTokenOwners: self.tupleElementTokenOwners, tupleAliases: self.tupleAliases, multiplyDeclaredTupleAliases: self.multiplyDeclaredTupleAliases, cascadeWalkRoots: self.cascadeWalkRoots, cascadeBreakReached: self.cascadeBreakReached, interfaceCloneAnswers: self.interfaceCloneAnswers, uniqueTypeAnswers: self.uniqueTypeAnswers, typeNames: self.typeNames, crossFileConstantReads: self.crossFileConstantReads, deepCloneAnswers: self.deepCloneAnswers, shareWalkAnswers: self.shareWalkAnswers, witnessByRefMasks: self.witnessByRefMasks, functionValuedFieldNames: self.functionValuedFieldNames, liveDefaultKeyNames: self.liveDefaultKeyNames)
	end 'aliasedTables'

	export function releaseTypeNameViews()
		self.typeNames.releaseViewCache()
	end 'releaseTypeNameViews'

	function baseOf() returns immutable IndexBase
		return match self.baseline.base 'base'
			none panic("ProgramSignatures.baseOf: this index is not a parse's overlay — only an overlay reads through a shared base")
			over(base) gives base
		end 'base'
	end 'baseOf'

	function baseTables() returns immutable IndexTables
		return self.baseOf().tables
	end 'baseTables'

	function rowArgs(id GenericInstanceId) returns MaxonTypeArray
		if self.baseline.overlaid and id < BandInstanceIdBase 'aBaselineRow'
			return self.baseTables().genericInstances.instanceArgs(id)
		end 'aBaselineRow'

		return self.genericInstances.instanceArgs(id)
	end 'rowArgs'

	function rowBaseId(id GenericInstanceId) returns TypeNameId
		if self.baseline.overlaid and id < BandInstanceIdBase 'aBaselineRow'
			return self.baseTables().genericInstances.instanceBaseId(id)
		end 'aBaselineRow'

		return self.genericInstances.instanceBaseId(id)
	end 'rowBaseId'

	function rowShape(id GenericInstanceId) returns InstanceShape
		if self.baseline.overlaid and id < BandInstanceIdBase 'aBaselineRow'
			return self.baseTables().genericInstances.instanceShape(id)
		end 'aBaselineRow'

		return self.genericInstances.instanceShape(id)
	end 'rowShape'

	function rowFixedCount(id GenericInstanceId) returns FixedElementCount throws InstanceSizeLookup
		if self.baseline.overlaid and id < BandInstanceIdBase 'aBaselineRow'
			return try self.baseTables().genericInstances.instanceFixedCount(id)
		end 'aBaselineRow'

		return try self.genericInstances.instanceFixedCount(id)
	end 'rowFixedCount'

	function rowIsSpeculative(id GenericInstanceId) returns bool
		if self.baseline.overlaid and id < BandInstanceIdBase 'aBaselineRow'
			return not self.genericInstances.namedByThisParse(id) and self.baseTables().genericInstances.instanceIsSpeculative(id)
		end 'aBaselineRow'

		return self.genericInstances.instanceIsSpeculative(id)
	end 'rowIsSpeculative'

	function internRow(baseId TypeNameId, args MaxonTypeArray, shape InstanceShape = InstanceShape.unsized, asSpeculative bool = false) returns GenericInstanceId
		if self.baseline.overlaid 'overlaid'
			if let existing = try self.baseTables().genericInstances.find(baseId, args: args, shape: shape) 'aBaselineRow'
				if not asSpeculative and self.baseTables().genericInstances.instanceIsSpeculative(existing) 'namedByThisParse'
					self.genericInstances.noteBaselineRowNamed(existing)
				end 'namedByThisParse'

				return existing
			end 'aBaselineRow'
		end 'overlaid'

		return self.genericInstances.intern(baseId, args: args, shape: shape, asSpeculative: asSpeculative)
	end 'internRow'

	function findRow(baseId TypeNameId, args MaxonTypeArray, shape InstanceShape) returns GenericInstanceId throws MapError
		if self.baseline.overlaid and not self.genericInstances.holdsInstance(baseId, args: args, shape: shape) 'inTheBaseline'
			return try self.baseTables().genericInstances.find(baseId, args: args, shape: shape)
		end 'inTheBaseline'

		return try self.genericInstances.find(baseId, args: args, shape: shape)
	end 'findRow'

	function holdsRow(baseId TypeNameId, args MaxonTypeArray, shape InstanceShape) returns bool
		return self.genericInstances.holdsInstance(baseId, args: args, shape: shape) or (self.baseline.overlaid and self.baseTables().genericInstances.holdsInstance(baseId, args: args, shape: shape))
	end 'holdsRow'

	function baselineRowCount() returns GenericInstanceId
		if not self.baseline.overlaid 'notOverlaid'
			return 0
		end 'notOverlaid'

		return self.baseTables().genericInstances.count()
	end 'baselineRowCount'

	function rowCount() returns GenericInstanceId
		return self.baselineRowCount() + self.genericInstances.count()
	end 'rowCount'

	function rowIdAt(position GenericInstanceId) returns GenericInstanceId
		let baselineRows = self.baselineRowCount()

		if position < baselineRows 'aBaselineRow'
			return position
		end 'aBaselineRow'

		return self.genericInstances.idAtPosition(position - baselineRows)
	end 'rowIdAt'

	function rowsOfBase(baseId TypeNameId) returns GenericInstanceIdArray throws MapError
		if not self.baseline.overlaid 'notOverlaid'
			return try self.genericInstances.instancesOfBase(baseId)
		end 'notOverlaid'

		if let owned = try self.genericInstances.instancesOfBase(baseId) 'ownRows'
			let joined = GenericInstanceIdArray.create(0)

			if let baselineRows = try self.baseTables().genericInstances.instancesOfBase(baseId) 'baselineRows'
				for id in baselineRows 'eachBaselineRow'
					joined.push(id)
				end 'eachBaselineRow'
			end 'baselineRows'

			for id in owned 'eachOwnRow'
				joined.push(id)
			end 'eachOwnRow'

			return joined
		end 'ownRows'

		return try self.baseTables().genericInstances.instancesOfBase(baseId)
	end 'rowsOfBase'

	function rowIsCopyDemanded(id GenericInstanceId) returns bool
		return self.genericInstances.instanceIsCopyDemanded(id) or (self.baseline.overlaid and self.baseTables().genericInstances.instanceIsCopyDemanded(id))
	end 'rowIsCopyDemanded'

	function copyDemandedRowIds() returns GenericInstanceIdArray
		let ids = GenericInstanceIdArray.create(0)

		if self.baseline.overlaid 'overlaid'
			for id in self.baseTables().genericInstances.copyDemandedIds() 'eachBaselineDemand'
				ids.push(id)
			end 'eachBaselineDemand'
		end 'overlaid'

		for id in self.genericInstances.copyDemandedIds() 'eachOwnDemand'
			ids.push(id)
		end 'eachOwnDemand'

		return ids
	end 'copyDemandedRowIds'

	function rowEscapesBaseline(id GenericInstanceId, scoped GenericInstanceId) returns bool
		if not self.baseline.overlaid 'notOverlaid'
			return self.genericInstances.rescopeEscapesBaseline(id, scoped: scoped)
		end 'notOverlaid'

		let baselineRows = self.baselineRowCount()
		return id < baselineRows and scoped >= baselineRows
	end 'rowEscapesBaseline'

	function baseRowInstantiated(baseId TypeNameId) returns bool
		if self.baseline.overlaid 'overlaid'
			return self.baseTables().genericInstances.baseInstantiatedAtBaseline(baseId)
		end 'overlaid'

		return self.genericInstances.baseInstantiatedAtBaseline(baseId)
	end 'baseRowInstantiated'

	function witnessMaskTable() returns WitnessByRefMaskMap
		if self.baseline.overlaid 'overlaid'
			return self.baseTables().witnessByRefMasks
		end 'overlaid'

		return self.witnessByRefMasks
	end 'witnessMaskTable'

	function functionValuedFieldNameTable() returns BareNameSet
		if self.baseline.overlaid 'overlaid'
			return self.baseTables().functionValuedFieldNames
		end 'overlaid'

		return self.functionValuedFieldNames
	end 'functionValuedFieldNameTable'

	function canonicalTupleMemo(name ByteArray) returns immutable ByteArray throws MapError
		if self.baseline.overlaid and not self.tupleCanonicalNames.contains(name) 'inTheBaseline'
			return try self.baseTables().tupleCanonicalNames.get(name)
		end 'inTheBaseline'

		return try self.tupleCanonicalNames.get(name)
	end 'canonicalTupleMemo'

	function ownerOfToken(token ByteArray) returns immutable ByteArray throws MapError
		if self.baseline.overlaid and not self.tupleElementTokenOwners.contains(token) 'inTheBaseline'
			return try self.baseTables().tupleElementTokenOwners.get(token)
		end 'inTheBaseline'

		return try self.tupleElementTokenOwners.get(token)
	end 'ownerOfToken'

	function tokenOfTuple(name ByteArray) returns immutable ByteArray throws MapError
		if self.baseline.overlaid and not self.tupleElementTokens.contains(name) 'inTheBaseline'
			return try self.baseTables().tupleElementTokens.get(name)
		end 'inTheBaseline'

		return try self.tupleElementTokens.get(name)
	end 'tokenOfTuple'

	function aliasNamed(name ByteArray) returns DeclaredTupleAlias throws MapError
		if self.baseline.overlaid and not self.tupleAliases.contains(name) 'inTheBaseline'
			return try self.baseTables().tupleAliases.get(name)
		end 'inTheBaseline'

		return try self.tupleAliases.get(name)
	end 'aliasNamed'

	function holdsTupleAlias(name ByteArray) returns bool
		return self.tupleAliases.contains(name) or (self.baseline.overlaid and self.baseTables().tupleAliases.contains(name))
	end 'holdsTupleAlias'

	function claimantsOf(name ByteArray) returns TupleAliasByDeclaringFile throws MapError
		if self.baseline.overlaid and not self.multiplyDeclaredTupleAliases.contains(name) 'inTheBaseline'
			return try self.baseTables().multiplyDeclaredTupleAliases.get(name)
		end 'inTheBaseline'

		return try self.multiplyDeclaredTupleAliases.get(name)
	end 'claimantsOf'

	// The claimant column is written in place, so an overlay starts its own from a copy of the base's;
	// the base's column is never written.
	function baselineClaimantsCopy(name ByteArray) returns TupleAliasByDeclaringFile
		if not self.baseline.overlaid 'notOverlaid'
			return TupleAliasByDeclaringFile.create()
		end 'notOverlaid'

		let baselineHeld = try self.baseTables().multiplyDeclaredTupleAliases.get(name) otherwise return TupleAliasByDeclaringFile.create()
		return baselineHeld.clone()
	end 'baselineClaimantsCopy'

	function anyMultiplyDeclaredTupleAlias() returns bool
		return self.multiplyDeclaredTupleAliases.count() > 0 or (self.baseline.overlaid and self.baseTables().multiplyDeclaredTupleAliases.count() > 0)
	end 'anyMultiplyDeclaredTupleAlias'

	function holdsOrigin(instance GenericInstanceId) returns bool
		return self.substitutedInstanceOrigins.contains(instance) or (self.baseline.overlaid and self.baseTables().substitutedInstanceOrigins.contains(instance))
	end 'holdsOrigin'

	function originOf(instance GenericInstanceId) returns GenericInstanceId throws MapError
		if self.baseline.overlaid and not self.substitutedInstanceOrigins.contains(instance) 'inTheBaseline'
			return try self.baseTables().substitutedInstanceOrigins.get(instance)
		end 'inTheBaseline'

		return try self.substitutedInstanceOrigins.get(instance)
	end 'originOf'

	function originCount() returns EntryCount
		if self.baseline.overlaid 'overlaid'
			return self.substitutedInstanceOrigins.count() + self.baseTables().substitutedInstanceOrigins.count()
		end 'overlaid'

		return self.substitutedInstanceOrigins.count()
	end 'originCount'

	function compiledNameMemo(id GenericInstanceId) returns immutable ByteArray throws MapError
		if self.baseline.overlaid and not self.compiledInstanceNames.contains(id) 'inTheBaseline'
			return try self.baseTables().compiledInstanceNames.get(id)
		end 'inTheBaseline'

		return try self.compiledInstanceNames.get(id)
	end 'compiledNameMemo'

	function canonicalNameMemo(id GenericInstanceId) returns immutable ByteArray throws MapError
		if self.baseline.overlaid and not self.canonicalInstanceNames.contains(id) 'inTheBaseline'
			return try self.baseTables().canonicalInstanceNames.get(id)
		end 'inTheBaseline'

		return try self.canonicalInstanceNames.get(id)
	end 'canonicalNameMemo'

	function canonicalIndexHolds(name ByteArray) returns bool
		return self.canonicalInstanceNameIndex.contains(name) or (self.baseline.overlaid and self.baseTables().canonicalInstanceNameIndex.contains(name))
	end 'canonicalIndexHolds'

	function canonicalIndexed(name ByteArray) returns GenericInstanceId throws MapError
		if self.baseline.overlaid and not self.canonicalInstanceNameIndex.contains(name) 'inTheBaseline'
			return try self.baseTables().canonicalInstanceNameIndex.get(name)
		end 'inTheBaseline'

		return try self.canonicalInstanceNameIndex.get(name)
	end 'canonicalIndexed'

	function uniqueAnswerFor(key ByteArray) returns bool throws MapError
		if self.baseline.overlaid and not self.uniqueTypeAnswers.contains(key) 'inTheBaseline'
			return try self.baseTables().uniqueTypeAnswers.get(key)
		end 'inTheBaseline'

		return try self.uniqueTypeAnswers.get(key)
	end 'uniqueAnswerFor'

	function interfaceCloneAnswerFor(interfaceName ByteArray) returns bool throws MapError
		if self.baseline.overlaid and not self.interfaceCloneAnswers.contains(interfaceName) 'inTheBaseline'
			return try self.baseTables().interfaceCloneAnswers.get(interfaceName)
		end 'inTheBaseline'

		return try self.interfaceCloneAnswers.get(interfaceName)
	end 'interfaceCloneAnswerFor'

	function cascadeAnswerFor(aggregateName ByteArray, purpose GraphCascadePurpose) returns bool throws MapError
		if self.baseline.overlaid and not self.ownCascadeAnswers(purpose).contains(aggregateName) 'inTheBaseline'
			return try self.baselineCascadeAnswers(purpose).get(aggregateName)
		end 'inTheBaseline'

		return try self.ownCascadeAnswers(purpose).get(aggregateName)
	end 'cascadeAnswerFor'

	function ownCascadeAnswers(purpose GraphCascadePurpose) returns DeepCloneAnswerMap
		return cascadeAnswerMapFor(purpose, deepClone: self.deepCloneAnswers, shareWalk: self.shareWalkAnswers)
	end 'ownCascadeAnswers'

	function baselineCascadeAnswers(purpose GraphCascadePurpose) returns DeepCloneAnswerMap
		return cascadeAnswerMapFor(purpose, deepClone: self.baseTables().deepCloneAnswers, shareWalk: self.baseTables().shareWalkAnswers)
	end 'baselineCascadeAnswers'

	// --- THE SETTLED BASELINE (B2) ---

	// Settle the index a parse reads. Every whole-program answer a parse could otherwise compute and keep is
	// computed here first, so no parse writes one, and the instance rows are mixed into `hash`: a parse's
	// output holds instance ids, so a parse memo keyed on a hash that did not move when the rows did would
	// hand a warm rebuild ids that name other instances.
	export function settleBaseline()
		self.attributeHashEventsTo(HashEventSource.whole)
		self.indexGenericAliasDeclarations()
		self.indexInterfaceDeclarationSites()
		self.settleTypeNameClaimIndex()
		self.closeGlobalAliasReturns()
		self.publishByRefNames()
		self.settleByRefConventions()
		self.closeFreshReturnForwards()
		self.closeForwardedStores()
		self.closeIsolatedParamConsumes()
		self.closeLinearParamConsumes()
		_ = self.sweptConformanceIndex()
		_ = self.conformerIndexWithExtensions()
		self.indexCanonicalInstanceNames()

		let noExcludedNames = HashDigestSet.create()

		// The instance rows and the name table feed the author chain alone: a shared library parse is
		// rebased onto whatever ids they hold, so they stay out of its key. The body-scan facts feed both
		// chains, the library one without what the author declared.
		self.attributeHashEventsTo(HashEventSource.author)
		self.hash = self.mixInstanceRows(self.hash, upTo: self.rowCount())

		// Which methods carry the hidden descriptor and count parameters is decided by scanning BODIES, so an edit
		// that leaves every declaration alone can still change the ABI a caller's parse emits against.
		self.hash = self.mixBodyScanFacts(self.hash, excluding: noExcludedNames, instances: self.genericInstancesDigest)
		self.hash = self.mixTypeNameTable(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeTypeNameTable), upTo: self.typeNames.count())

		self.attributeHashEventsTo(HashEventSource.whole)
		self.hash = self.mixBodyScanFacts(self.hash, excluding: self.settledDeclarations().authorDeclaredNames, instances: self.libraryTemplateInstancesDigest())
		self.finishHashChains()

		self.genericInstances.settleBaseline()
		self.typeNames.settleBaseline()
		self.requireInlineRecordMemoIsWithinTheBaseline()
		self.journal = IndexJournal.create()
		self.baseline = IndexBaseline.create(self.crossFileConstantReads.count(), canonicalNamesIndexedThrough: self.canonicalNamesIndexedThrough, arrayByteInstance: self.arrayByteInstance, arrayByteInstanceComputed: self.arrayByteInstanceComputed, deepCloneWalkReadInstances: self.deepCloneWalkReadInstances, someRecordHoldsAnInterfaceValue: self.someRecordHoldsAnInterfaceValue, recordsHoldingAnInterfaceValueCounted: self.recordsHoldingAnInterfaceValueCounted, fingerprint: self.fingerprint(FingerprintDetail.valuesOnly))
	end 'settleBaseline'

	function mixBodyScanFacts(state HashDigest, excluding HashDigestSet, instances HashDigest) returns HashDigest
		var out = mixNameSet(Hasher.combined(state, value: DeclShapeFixedElementCountNeeds), names: self.settledDeclarations().fixedElementCountNeeds, excluding: excluding)
		out = Hasher.combined(Hasher.combined(out, value: DeclShapeInstantiatedByAParse), value: self.instantiatedDigestExcluding(excluding))
		return Hasher.combined(self.mixGenericTemplates(Hasher.combined(out, value: DeclShapeGenericInstances), excluding: excluding), value: instances)
	end 'mixBodyScanFacts'

	function libraryTemplateInstancesDigest() returns HashDigest
		var members = Hasher.empty()

		for (name, instance) in self.settledDeclarations().genericInstancesByName 'eachInstance'
			if self.declaredByTheSharedCorpusAt(declaringFileOfSite(instance.siteKey)) 'anInstanceOfALibraryTemplate'
				members = members xor mixBytes(Hasher.empty(), bytes: name)
			end 'anInstanceOfALibraryTemplate'
		end 'eachInstance'

		return members
	end 'libraryTemplateInstancesDigest'

	// Before any declaration is folded: every whole-program answer computed from here on counts these types as
	// instantiated, and the settled hash carries them, so a parse memo keyed on it moves when they do.
	export function adoptInstantiatedByAParse(filed InstantiatedByAParse)
		let names = InstantiatedTypeNameSet.create()

		for name in filed.names 'eachFiled'
			names.insert(name)
		end 'eachFiled'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.instantiatedByAParse = names
	end 'adoptInstantiatedByAParse'

	export function adoptGenericFunctionInstances(filed RequestedGenericInstances)
		let bySite = GenericFunctionInstancesBySite.create()
		let byName = GenericFunctionInstanceMap.create()

		for (name, instance) in filed.byName 'eachFiled'
			byName.upsert(name, value: instance)
			let atSite = try bySite.get(instance.siteKey) otherwise GenericFunctionInstanceArray.create(0)
			atSite.push(instance)
			bySite.upsert(instance.siteKey, value: atSite)
		end 'eachFiled'

		// A template's instances share one body region in `Parser.readFunction`, and the first to refuse
		// abandons it for the rest, so this order decides which instance reports.
		for (_, atSite) in bySite 'eachSite'
			atSite.sortBy(function(left GenericFunctionInstance, right GenericFunctionInstance) gives compareBytesOrdinally(left.instanceName, right: right.instanceName))
		end 'eachSite'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.genericInstancesBySite = bySite
		ownDeclarations.genericInstancesByName = byName
		self.genericInstancesDigest = filed.filed.digest
	end 'adoptGenericFunctionInstances'

	export function adoptRequestedTupleLayouts(filed RequestedTupleTypesMap, from TypeNameInterner)
		for (_, tupleTypes) in filed 'eachInstance'
			if not self.holdsAnUnregisteredLayout(tupleTypes.layouts) 'everyTupleIsHere'
				continue
			end 'everyTupleIsHere'

			let instances = self.internFootprintInstances(tupleTypes.footprint)

			for layout in tupleTypes.layouts 'eachLayout'
				if self.hasRegisteredLayout(layout.name) 'alreadyRegistered'
					continue
				end 'alreadyRegistered'

				let elements = MaxonTypeArray.create(layout.fieldTypes.count(), zeroed: false)

				for element in layout.fieldTypes 'eachElement'
					elements.push(self.adoptRequestedTupleElement(element, from: from, instances: instances))
				end 'eachElement'

				self.registerTupleLayoutAs(layout.name, elements: elements, brands: layout.fieldDeclaredBrands, instanceBrands: instanceBrandsOf(elements, written: layout.fieldDeclaredBrands), capabilities: tupleItemCapabilitiesOf(layout), declFilePath: layout.declFilePath)
			end 'eachLayout'
		end 'eachInstance'
	end 'adoptRequestedTupleLayouts'

	function holdsAnUnregisteredLayout(layouts StructLayoutArray) returns bool
		for layout in layouts 'eachLayout'
			if not self.hasRegisteredLayout(layout.name) 'notRegistered'
				return true
			end 'notRegistered'
		end 'eachLayout'

		return false
	end 'holdsAnUnregisteredLayout'

	function adoptRequestedTupleElement(element MaxonType, from TypeNameInterner, instances GenericInstanceIdMap) returns MaxonType
		if maxonTypeTag(element) != ValueTypeTag.genericInstance 'notAnInstance'
			return self.adoptTypeFrom(element, from: from)
		end 'notAnInstance'

		return MaxonType.genericInstance(try instances.get(genericInstanceIdOf(element)) otherwise panic("ProgramSignatures.adoptRequestedTupleElement: instance {genericInstanceIdOf(element)} is in no row of the footprint filed beside its layout — `footprintOf` closes over every instance the layouts hold"))
	end 'adoptRequestedTupleElement'

	// Each row is re-interned through its names: `row.id` and the ids in its args belong to the
	// index that built the footprint, and mean another instance, or none, in this one.
	function internFootprintInstances(footprint ParseFootprint) returns GenericInstanceIdMap
		let names = NameIdMap.create()
		var highest = 0 as TypeNameId

		for (position, id) in footprint.nameIds.withIterator() 'eachName'
			names.upsert(id, value: self.typeNames.intern(try footprint.nameBytes.get(position.index()) otherwise panic("ProgramSignatures.internFootprintInstances: nameBytes.get OOB at {position.index()} — the footprint's two name columns are filled together")))

			if id > highest 'aNewHighest'
				highest = id
			end 'aNewHighest'
		end 'eachName'

		let instances = GenericInstanceIdMap.create()
		let remap = self.footprintRemap(names, highest: highest, instances: instances)

		for row in footprint.rows 'eachRow'
			self.requireRowNamesAreListed(row, names: names)
			instances.upsert(row.id, value: self.internRow(remap.applyName(row.baseId), args: remapMaxonTypes(row.args, remap: remap), shape: row.shape, asSpeculative: row.speculative))
		end 'eachRow'

		return instances
	end 'internFootprintInstances'

	function requireRowNamesAreListed(row FootprintRow, names NameIdMap)
		let watcher = rowMentions(row.baseId, args: row.args)

		for id in watcher.seenNames 'eachName'
			if not names.contains(id) 'anUnlistedName'
				panic("ProgramSignatures.requireRowNamesAreListed: instance row {row.id} mentions type name id {id}, which its footprint's name table does not list — `footprintOf` files every name its rows mention, and `footprintRemap` would hand an unlisted id back unmoved")
			end 'anUnlistedName'
		end 'eachName'
	end 'requireRowNamesAreListed'

	export function genericTemplateKeys() returns NameRoster
		let keys = NameRoster.create(self.settledDeclarations().genericTemplates.count(), zeroed: false)

		for (key, _) in self.settledDeclarations().genericTemplates 'eachTemplate'
			keys.push(key)
		end 'eachTemplate'

		return keys
	end 'genericTemplateKeys'

	export function recordGenericFunctionTemplate(template GenericFunctionTemplate)
		let site = template.siteKey()

		if self.mainThreadSettled().sweptGenericSites.contains(site) 'sweptAlready'
			return
		end 'sweptAlready'

		self.mainThreadSettled().sweptGenericSites.insert(site)

		let templates = try self.mainThreadSettled().genericTemplates.get(template.key) otherwise GenericFunctionTemplateArray.create(0)
		templates.push(template)
		self.mainThreadSettled().genericTemplates.upsert(template.key, value: templates)
	end 'recordGenericFunctionTemplate'

	export function declaresGenericFunctions() returns bool
		return self.settledDeclarations().genericTemplates.count() > 0
	end 'declaresGenericFunctions'

	export function isGenericFunctionKey(key ByteArray) returns bool
		return self.settledDeclarations().genericTemplates.contains(key)
	end 'isGenericFunctionKey'

	export function genericTemplatesOf(key ByteArray) returns GenericFunctionTemplateArray
		return try self.settledDeclarations().genericTemplates.get(key) otherwise GenericFunctionTemplateArray.create(0)
	end 'genericTemplatesOf'

	export function genericNameIsDeclaredTwiceInOneDirectory(key ByteArray) returns bool
		let seenSites = DeclaringSiteSet.create()
		let directories = DeclaringDirectorySet.create()

		for template in self.genericTemplatesOf(key) 'eachTemplate'
			if sharesADirectoryWithAnEarlierDeclaration(seenSites, directories: directories, siteKey: template.siteKey(), directory: self.moduleDirectoryOf(template.declFilePath)) 'aSecondDeclaration'
				return true
			end 'aSecondDeclaration'
		end 'eachTemplate'

		let site = try self.declaredSiteOf(key) otherwise return false

		return sharesADirectoryWithAnEarlierDeclaration(seenSites, directories: directories, siteKey: declarationSiteKey(site.declFilePath, line: site.nameLine, column: site.nameColumn), directory: self.moduleDirectoryOf(site.declFilePath))
	end 'genericNameIsDeclaredTwiceInOneDirectory'

	export function settleContestedGenericTemplates()
		for (bareName, _) in self.mainThreadSettled().contestedFreeFunctions 'eachContestedName'
			let templates = try self.mainThreadSettled().genericTemplates.get(bareName) otherwise continue
			let staying = GenericFunctionTemplateArray.create(0)

			for template in templates 'eachTemplate'
				let registration = freeFunctionRegistrationName(bareName, moduleDirectory: self.moduleDirectoryOf(template.declFilePath))

				if registration.equals(bareName) 'theRootKeepsTheBareKey'
					staying.push(template)
					continue
				end 'theRootKeepsTheBareKey'

				let filed = try self.mainThreadSettled().genericTemplates.get(registration) otherwise GenericFunctionTemplateArray.create(0)
				filed.push(template.keyedAs(registration))
				self.mainThreadSettled().genericTemplates.upsert(registration, value: filed)
			end 'eachTemplate'

			if staying.isEmpty() 'noRootTemplate'
				_ = self.mainThreadSettled().genericTemplates.remove(bareName)
				continue
			end 'noRootTemplate'

			self.mainThreadSettled().genericTemplates.upsert(bareName, value: staying)
		end 'eachContestedName'
	end 'settleContestedGenericTemplates'

	function declaresAGenericTemplateVisibleFrom(key ByteArray, readerFilePath FilePath) returns bool
		for template in self.genericTemplatesOf(key) 'eachTemplate'
			if self.templateIsVisibleFrom(key, template: template, readerFilePath: readerFilePath) 'visible'
				return true
			end 'visible'
		end 'eachTemplate'

		return false
	end 'declaresAGenericTemplateVisibleFrom'

	export function genericInstanceCountAt(siteKey ByteArray) returns ElementIndex
		let filed = try self.settledDeclarations().genericInstancesBySite.get(siteKey) otherwise return 0
		return filed.count()
	end 'genericInstanceCountAt'

	export function genericInstanceAt(siteKey ByteArray, position ElementIndex) returns GenericFunctionInstance
		let filed = try self.settledDeclarations().genericInstancesBySite.get(siteKey) otherwise panic("ProgramSignatures.genericInstanceAt: no instance is filed at '{String.from(siteKey)}' — `genericInstanceCountAt` counted them")
		let instance = try filed.get(position) otherwise panic("ProgramSignatures.genericInstanceAt: position {position} of {filed.count()} instances at '{String.from(siteKey)}'")
		return GenericFunctionInstance.create(instance.templateKey, siteKey: instance.siteKey, arguments: instance.arguments.clone(), instanceName: instance.instanceName)
	end 'genericInstanceAt'

	export function genericInstanceOriginOf(name ByteArray) returns GenericInstanceOrigin
		if let instance = try self.settledDeclarations().genericInstancesByName.get(name) 'aFiledInstance'
			return GenericInstanceOrigin.instanceOf(instance.templateKey)
		end 'aFiledInstance'

		return GenericInstanceOrigin.notAnInstance
	end 'genericInstanceOriginOf'

	export function declaredNameOf(name immutable ByteArray) returns immutable ByteArray
		return match self.genericInstanceOriginOf(name) 'origin'
			instanceOf(templateKey) gives templateKey
			notAnInstance gives name
		end 'origin'
	end 'declaredNameOf'

	function namesALiftingHost(name ByteArray) returns bool
		if self.settledDeclarations().genericInstancesByName.contains(name) or self.settledDeclarations().interfaceExtensionMembers.contains(name) 'aHostItself'
			return true
		end 'aHostItself'

		let owner = try paramDefaultHelperOwnerOf(name) otherwise return false
		return self.namesALiftingHost(owner)
	end 'namesALiftingHost'

	// The LONGEST prefix that names a host, because an instance's name can hold the separator itself — a
	// declaration's mint spelled in its type arguments — and the first segment alone would cut it short.
	function liftedFunctionHostOf(name ByteArray) returns immutable ByteArray
		let segments = String.from(name).split(CompilerMintSeparator)
		var host = liftedFunctionHost(segments, name: name)
		var prefix = String.from(host)

		for position in 1 upto segments.count() 'eachLiftedSegment'
			prefix.append("{CompilerMintSeparator}{try segments.get(position) otherwise panic("liftedFunctionHostOf: segments.get OOB at {position} inside its own count()")}")
			let candidate = freeze prefix.toByteArray()

			if self.namesALiftingHost(candidate) 'aLongerHost'
				host = candidate
			end 'aLongerHost'
		end 'eachLiftedSegment'

		return host
	end 'liftedFunctionHostOf'

	export function declaredFunctionDisplay(name ByteArray) returns FunctionDisplay
		if isGlobalInitializerName(name) 'aGlobalInitializer'
			return FunctionDisplay.named("initializer of {globalInitializerBindingOf(name)}")
		end 'aGlobalInitializer'

		if name.equals(ConstInitializerFunctionName) 'aConstInitializer'
			return FunctionDisplay.named("initializer")
		end 'aConstInitializer'

		let host = self.liftedFunctionHostOf(name)
		let lifted = try name.slice(host.count(), endIndex: name.count()) otherwise panic("declaredFunctionDisplay: '{String.from(host)}' is a prefix of '{String.from(name)}' and cannot reach past its end")

		return FunctionDisplay.named("{String.from(self.declaredNameOf(host))}{String.from(lifted)}")
	end 'declaredFunctionDisplay'

	export function functionDisplay(func IrFunction, authoredPath FilePath) returns FunctionDisplay
		if isLiftedClosureName(func.name) 'aClosureLiteral'
			return closureSiteDisplay(authoredPath, line: func.nameLine, column: func.nameColumn)
		end 'aClosureLiteral'

		return self.declaredFunctionDisplay(func.name)
	end 'functionDisplay'

	export function isGenericInstanceName(name ByteArray) returns bool
		return self.settledDeclarations().genericInstancesByName.contains(name)
	end 'isGenericInstanceName'

	export function genericTemplateRoster() returns GenericFunctionTemplateArray
		let roster = GenericFunctionTemplateArray.create(0)

		for (_, templates) in self.settledDeclarations().genericTemplates 'eachKey'
			for template in templates 'eachTemplate'
				roster.push(template)
			end 'eachTemplate'
		end 'eachKey'

		return roster
	end 'genericTemplateRoster'

	export function genericInstanceBindsParam(callee ByteArray, position ParamCount) returns bool
		let instance = try self.settledDeclarations().genericInstancesByName.get(callee) otherwise return false
		let template = self.templateOfInstance(instance)
		let column = try columnOfCallPosition(template.takesReceiver, position: position) otherwise return false
		let slot = try template.paramSlots.get(column) otherwise panic("ProgramSignatures.genericInstanceBindsParam: position {position} is past the {template.paramSlots.count()} parameters of '{String.from(callee)}'")
		return slot == GenericParamSlot.typeParameter
	end 'genericInstanceBindsParam'

	// A closure lifted out of a generic copy or an interface extension body is named `<host>$…`, and
	// the grant is its host's: asked of the lifted name itself, a closure would lose the calls its
	// host may make.
	export function interfaceSurfaceGrantsCall(functionName ByteArray, callee ByteArray) returns bool
		let host = self.liftedFunctionHostOf(functionName)

		if let member = try self.settledDeclarations().interfaceExtensionMembers.get(host) 'anInterfaceExtensionBody'
			if self.interfaceSurfaceDeclares(member.interfaceName, conformer: member.conformer, callee: callee, caller: host) 'theExtendedInterfacesSurface'
				return true
			end 'theExtendedInterfacesSurface'
		end 'anInterfaceExtensionBody'

		return self.genericInstanceCallsARequirement(host, callee: callee)
	end 'interfaceSurfaceGrantsCall'

	function genericInstanceCallsARequirement(instanceName ByteArray, callee ByteArray) returns bool
		let instance = try self.settledDeclarations().genericInstancesByName.get(instanceName) otherwise return false
		let template = self.templateOfInstance(instance)

		for constraint in template.constraints 'eachConstraint'
			let argument = try instance.arguments.get(constraint.typeParamIndex) otherwise panic("ProgramSignatures.genericInstanceCallsARequirement: constraint on type parameter {constraint.typeParamIndex} is past the {instance.arguments.count()} arguments of '{String.from(instanceName)}'")

			if self.interfaceSurfaceDeclares(constraint.interfaceName, conformer: argument.spelling(), callee: callee, caller: instanceName) 'theConstraintsSurface'
				return true
			end 'theConstraintsSurface'
		end 'eachConstraint'

		return false
	end 'genericInstanceCallsARequirement'

	function interfaceSurfaceDeclares(interfaceName ByteArray, conformer ByteArray, callee ByteArray, caller ByteArray) returns bool
		return self.interfaceRequires(interfaceName, conformer: conformer, callee: callee, caller: caller) or self.constraintExtensionDeclares(interfaceName, conformer: conformer, callee: callee)
	end 'interfaceSurfaceDeclares'

	function interfaceRequires(interfaceName ByteArray, conformer ByteArray, callee ByteArray, caller ByteArray) returns bool
		let requirements = try self.interfaceRequirementSlots(interfaceName) otherwise panic("ProgramSignatures.interfaceRequires: '{String.from(caller)}' reaches its callees through '{String.from(interfaceName)}', which declares no interface")

		for requirement in requirements 'eachRequirement'
			if callee.equals(qualifiedMethodName(conformer, methodName: requirement.method.name)) 'satisfiesTheConstraint'
				return true
			end 'satisfiesTheConstraint'
		end 'eachRequirement'

		return false
	end 'interfaceRequires'

	// An extension member of a constraint interface is part of that interface's surface, so a generic
	// copy may call it exactly as it calls a requirement.
	function constraintExtensionDeclares(interfaceName ByteArray, conformer ByteArray, callee ByteArray) returns bool
		let member = try self.settledDeclarations().interfaceExtensionMembers.get(callee) otherwise return false
		return member.conformer.equals(conformer) and conformanceSatisfiesInterface(self.settledDeclarations().interfaces, declaredName: interfaceName, wanted: member.interfaceName)
	end 'constraintExtensionDeclares'

	function templateOfInstance(instance GenericFunctionInstance) returns GenericFunctionTemplate
		let templates = try self.settledDeclarations().genericTemplates.get(instance.templateKey) otherwise panic("ProgramSignatures.templateOfInstance: the instance '{String.from(instance.instanceName)}' is filed under the template key '{String.from(instance.templateKey)}', which declares no template")

		for template in templates 'eachTemplate'
			if template.siteKey().equals(instance.siteKey) 'itsDeclaration'
				return template
			end 'itsDeclaration'
		end 'eachTemplate'

		panic("ProgramSignatures.templateOfInstance: no template of '{String.from(instance.templateKey)}' is declared at '{String.from(instance.siteKey)}', where the instance '{String.from(instance.instanceName)}' was inferred")
	end 'templateOfInstance'

	function mixGenericTemplates(state HashDigest, excluding HashDigestSet) returns HashDigest
		var mixed = state

		for (key, templates) in self.settledDeclarations().genericTemplates 'eachKey'
			if nameIsExcluded(key, excluded: excluding) 'anExcludedFunction'
				continue
			end 'anExcludedFunction'

			for template in templates 'eachTemplate'
				mixed = mixBytes(Hasher.combined(mixed, value: DeclShapeGenericTemplate), bytes: self.genericInstanceNameOf(template, arguments: GenericFunctionArgumentArray.create(0)))
				mixed = mixBytes(mixed, bytes: key)

				for slot in template.paramSlots 'eachSlot'
					mixed = Hasher.combined(mixed, value: slot.ordinal as HashDigest)
				end 'eachSlot'

				for index in template.paramTypeParams 'eachIndex'
					mixed = Hasher.combined(mixed, value: index as HashDigest)
				end 'eachIndex'

				for name in template.paramNames 'eachName'
					mixed = mixBytes(mixed, bytes: name)
				end 'eachName'

				for constraint in template.constraints 'eachConstraint'
					mixed = mixBytes(Hasher.combined(mixed, value: constraint.typeParamIndex as HashDigest), bytes: constraint.interfaceName)
				end 'eachConstraint'
			end 'eachTemplate'
		end 'eachKey'

		return mixed
	end 'mixGenericTemplates'

	// The generic types this merged index holds a row of that its settle did not count as instantiated — what a fold
	// files into `QueryDatabase.InstantiatedByAParse`. Every generic type records a type-parameter owner, so the roster is
	// read from those owners.
	export function typesNewlyInstantiatedByAParse() returns NameRoster
		let found = NameRoster.create(0)
		let asked = InstantiatedTypeNameSet.create()

		for (_, owner) in self.settledDeclarations().typeParamOwners 'eachOwner'
			if asked.contains(owner.declaringTypeName) 'askedAlready'
				continue
			end 'askedAlready'

			asked.insert(owner.declaringTypeName)

			if self.holdsARowOf(owner.declaringTypeName) and not self.genericTypeIsInstantiated(owner.declaringTypeName) 'aParseInstantiatedIt'
				found.push(owner.declaringTypeName)
			end 'aParseInstantiatedIt'
		end 'eachOwner'

		return found
	end 'typesNewlyInstantiatedByAParse'

	// The filed types this merged index gives no reason to file: no row instantiates one, or the settle's own rows
	// already do. Asked only of a fold every file merged — a refused fold's missing rows are no evidence.
	export function typesFiledNeedlessly() returns NameRoster
		let needless = NameRoster.create(0)

		for name in self.settledDeclarations().instantiatedByAParse 'eachFiled'
			let baseId = try self.typeNames.idOf(name) otherwise 'undeclared'
				needless.push(name)
				continue
			end 'undeclared'

			if not self.holdsARowOf(name) or self.baseRowInstantiated(baseId) 'needless'
				needless.push(name)
			end 'needless'
		end 'eachFiled'

		return needless
	end 'typesFiledNeedlessly'

	// Open a parse's band: from here to `closeParseBand`, every instance row it mints is handed out from
	// `BandInstanceIdBase`, and every other write is journaled for the close to collect and undo.
	//
	// ⛔ **NOT ON AN INDEX A FOLD HAS MERGED INTO.** The merged rows are what every pass after the front end reads, so
	// they cannot be undone for one more parse; a file's parse is asked for after the fold only as a memo hit.
	export function openParseBand(overrides RowSetOverrideTable)
		if self.holdsAMerge 'mergedInto'
			panic("ProgramSignatures.openParseBand: a parse was opened on an index a fold has merged every file into — a parse reads the settled baseline, which only `restoreBaseline` puts back, so a file's parse asked for after the fold must be a memo hit")
		end 'mergedInto'

		if self.baseline.overlaid 'overlaid'
			self.requireOverlayIsClean()
		end 'overlaid' else 'onTheIndexItself'
			self.requireAtBaseline("the start of a parse")
		end 'onTheIndexItself'

		self.genericInstances.openParseBand()
		self.rowSetLog = RowSetLog.open(overrides)
	end 'openParseBand'

	function requireOverlayIsClean()
		if self.rowCount() != self.baselineRowCount() or self.typeNames.count() != self.typeNames.baselineNameCount() or self.mintedTupleLayouts.count() != 0 or self.structSlots.count() != 0 'dirty'
			panic("ProgramSignatures.openParseBand: a parse's overlay was opened holding the rows of an earlier parse — `closeParseBand` empties it")
		end 'dirty'
	end 'requireOverlayIsClean'

	// Everything the parse wrote, in the parse's own id space — then the index put back to its
	// baseline: the index itself is checked field by field (`requireAtBaseline`), an overlay's tables
	// are emptied. What is handed out shares no record with the index: it rides the parse's artifact,
	// which crosses back from a pool worker.
	export function closeParseBand(filePath FilePath) returns LocalInstanceMints
		let typeNameBaseline = self.typeNames.baselineNameCount()
		let bandNames = self.typeNames.namesSinceBaseline()
		let tupleLayouts = StructLayoutArray.create(self.journal.tupleNames.count(), zeroed: false)

		for name in self.journal.tupleNames 'eachMintedTuple'
			tupleLayouts.push((try self.registeredLayout(name) otherwise panic("ProgramSignatures.closeParseBand: the journal lists tuple `{String.from(name)}` and `structSlots` does not hold it")).clone())
		end 'eachMintedTuple'

		let origins = SubstitutionOriginArray.create(self.journal.originIds.count(), zeroed: false)

		for instance in self.journal.originIds 'eachOrigin'
			origins.push(SubstitutionOrigin.create(instance, through: try self.substitutedInstanceOrigins.get(instance) otherwise panic("ProgramSignatures.closeParseBand: the journal lists an origin for {instance} and the map does not hold it")))
		end 'eachOrigin'

		let constantReads = NameInFileArray.create(self.crossFileConstantReads.count() - self.baseline.crossFileConstantReadCount, zeroed: false)

		for position in self.baseline.crossFileConstantReadCount upto self.crossFileConstantReads.count() 'eachRead'
			constantReads.push(try self.crossFileConstantReads.get(position) otherwise panic("ProgramSignatures.closeParseBand: crossFileConstantReads.get OOB at {position}"))
		end 'eachRead'

		let bandAliases = TupleAliasRecordArray.create(self.journal.tupleAliasWrites.count(), zeroed: false)

		for write in self.journal.tupleAliasWrites 'eachAliasWrite'
			bandAliases.push(TupleAliasRecord.create(write.name, alias: (try self.aliasNamed(write.name) otherwise panic("ProgramSignatures.closeParseBand: the journal lists tuple alias `{String.from(write.name)}` and the map does not hold it")).clone()))
		end 'eachAliasWrite'

		let log = self.rowSetLog
		self.rowSetLog = RowSetLog.closed()
		let band = self.genericInstances.closeParseBand()

		if self.baseline.overlaid 'overlaid'
			self.resetOverlayTables()
		end 'overlaid' else 'onTheIndexItself'
			self.rewindJournaledWrites(self.baselineBandMark())
			self.requireAtBaseline("the parse of {filePath.toString()}")
		end 'onTheIndexItself'

		return LocalInstanceMints.create(bandNames, typeNameBaseline: typeNameBaseline, rows: band.rows, namedRows: band.namedRows, copyDemandedRows: band.copyDemandedRows, tupleLayouts: tupleLayouts, substitutionOrigins: origins, constantReads: constantReads, tupleAliases: bandAliases, rowSetAnswers: log.told)
	end 'closeParseBand'

	// Undo every merge since the settle, so the fold that follows redoes them from its artifacts.
	export function restoreBaseline()
		self.genericInstances.restoreBaseline()
		self.rewindJournaledWrites(self.baselineBandMark())
		self.holdsAMerge = false
		self.requireAtBaseline("the start of a fold")
	end 'restoreBaseline'

	export function beginMerge()
		self.holdsAMerge = true
	end 'beginMerge'

	// ⭐ **THE GUARD.** A write the journal does not list survives a restore; this names the field it moved.
	function requireAtBaseline(site String)
		if not self.baseline.settled 'unsettled'
			panic("ProgramSignatures: {site} reached an index that was never settled — `queryProgramSignatures` settles it before it hands it out")
		end 'unsettled'

		match self.baseline.fingerprint.firstMove(self.fingerprint(FingerprintDetail.valuesOnly)) 'moved'
			none then return
			value(position, was, now) then panic("ProgramSignatures: at {site}, `{self.fingerprint(FingerprintDetail.withLabels).valueLabel(position)}` holds {now} where the settled index held {was} — a write past the baseline that no restore undoes. A parse may not write the index it shares with every other parse, and a merge's writes must all be journaled")
			digest(position) then panic("ProgramSignatures: at {site}, `{self.fingerprint(FingerprintDetail.withLabels).digestLabel(position)}` moved from the settled index's — a write past the baseline that no restore undoes")
		end 'moved'
	end 'requireAtBaseline'

	function markParseBand() returns ParseBandMark
		return ParseBandMark.create(self.genericInstances.markParseBand(), journal: self.journal.mark(), crossFileConstantReads: self.crossFileConstantReads.count(), mintedTupleLayouts: self.mintedTupleLayouts.count(), typeNames: self.typeNames.markTable(), told: self.rowSetLog.told.order.count(), canonicalNamesIndexedThrough: self.canonicalNamesIndexedThrough, arrayByteInstance: self.arrayByteInstance, arrayByteInstanceComputed: self.arrayByteInstanceComputed, deepCloneWalkReadInstances: self.deepCloneWalkReadInstances, someRecordHoldsAnInterfaceValue: self.someRecordHoldsAnInterfaceValue, recordsHoldingAnInterfaceValueCounted: self.recordsHoldingAnInterfaceValueCounted)
	end 'markParseBand'

	function baselineBandMark() returns ParseBandMark
		return ParseBandMark.create(self.genericInstances.baselineMark(), journal: JournalMark.empty(), crossFileConstantReads: self.baseline.crossFileConstantReadCount, mintedTupleLayouts: 0, typeNames: self.typeNames.baselineTableMark(), told: 0, canonicalNamesIndexedThrough: self.baseline.canonicalNamesIndexedThrough, arrayByteInstance: self.baseline.arrayByteInstance, arrayByteInstanceComputed: self.baseline.arrayByteInstanceComputed, deepCloneWalkReadInstances: self.baseline.deepCloneWalkReadInstances, someRecordHoldsAnInterfaceValue: self.baseline.someRecordHoldsAnInterfaceValue, recordsHoldingAnInterfaceValueCounted: self.baseline.recordsHoldingAnInterfaceValueCounted)
	end 'baselineBandMark'

	function rewindParseBand(mark ParseBandMark)
		self.genericInstances.rewindParseBand(mark.instances)
		self.rewindJournaledWrites(mark)

		for position in mark.told upto self.rowSetLog.told.order.count() 'eachQuestionSince'
			_ = self.rowSetLog.told.records.remove(try self.rowSetLog.told.order.get(position) otherwise panic("ProgramSignatures.rewindParseBand: told.order.get OOB at {position}"))
		end 'eachQuestionSince'

		self.rowSetLog.told.order.truncate(mark.told)
		self.requireBandIsAt(mark)
	end 'rewindParseBand'

	function requireBandIsAt(mark ParseBandMark)
		let now = self.markParseBand()
		requireRewoundCount("journal", now: now.journal.total(), marked: mark.journal.total())
		requireRewoundCount("instance rows", now: now.instances.rows, marked: mark.instances.rows)
		requireRewoundCount("named instance rows", now: now.instances.named, marked: mark.instances.named)
		requireRewoundCount("copy-demanded instance rows", now: now.instances.copyDemanded, marked: mark.instances.copyDemanded)
		requireRewoundCount("crossFileConstantReads", now: now.crossFileConstantReads, marked: mark.crossFileConstantReads)
		requireRewoundCount("mintedTupleLayouts", now: now.mintedTupleLayouts, marked: mark.mintedTupleLayouts)
		requireRewoundCount("typeNames", now: now.typeNames, marked: mark.typeNames)
		requireRewoundCount("row-set questions", now: now.told, marked: mark.told)
	end 'requireBandIsAt'

	function rewindJournaledWrites(mark ParseBandMark)
		self.restoreCanonicalIndex(mark.journal.canonicalIndexWrites)

		for position in mark.journal.compiledNameIds upto self.journal.compiledNameIds.count() 'eachCompiledName'
			_ = self.compiledInstanceNames.remove(try self.journal.compiledNameIds.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: compiledNameIds.get OOB at {position}"))
		end 'eachCompiledName'

		for position in mark.journal.canonicalNameIds upto self.journal.canonicalNameIds.count() 'eachCanonicalName'
			_ = self.canonicalInstanceNames.remove(try self.journal.canonicalNameIds.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: canonicalNameIds.get OOB at {position}"))
		end 'eachCanonicalName'

		for position in mark.journal.originIds upto self.journal.originIds.count() 'eachOrigin'
			_ = self.substitutedInstanceOrigins.remove(try self.journal.originIds.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: originIds.get OOB at {position}"))
		end 'eachOrigin'

		self.restoreTupleAliases(mark.journal.tupleAliasWrites)

		for position in mark.journal.tupleNames upto self.journal.tupleNames.count() 'eachTuple'
			let name = try self.journal.tupleNames.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: tupleNames.get OOB at {position}")
			_ = self.structSlots.remove(name)
			_ = self.tupleElementTokenOwners.remove(tupleElementTokenFor(name))
			_ = self.tupleElementTokens.remove(name)
		end 'eachTuple'

		self.mintedTupleLayouts.truncate(mark.mintedTupleLayouts)

		for position in mark.journal.separatorBearingTokens upto self.journal.separatorBearingTokens.count() 'eachSeparatorBearingToken'
			_ = self.tupleElementTokenOwners.remove(try self.journal.separatorBearingTokens.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: separatorBearingTokens.get OOB at {position}"))
		end 'eachSeparatorBearingToken'

		for position in mark.journal.canonicalTupleNames upto self.journal.canonicalTupleNames.count() 'eachCanonicalTuple'
			_ = self.tupleCanonicalNames.remove(try self.journal.canonicalTupleNames.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: canonicalTupleNames.get OOB at {position}"))
		end 'eachCanonicalTuple'

		for position in mark.journal.deepCloneNames upto self.journal.deepCloneNames.count() 'eachDeepCloneAnswer'
			_ = self.deepCloneAnswers.remove(try self.journal.deepCloneNames.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: deepCloneNames.get OOB at {position}"))
		end 'eachDeepCloneAnswer'

		for position in mark.journal.shareWalkNames upto self.journal.shareWalkNames.count() 'eachShareWalkAnswer'
			_ = self.shareWalkAnswers.remove(try self.journal.shareWalkNames.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: shareWalkNames.get OOB at {position}"))
		end 'eachShareWalkAnswer'

		for position in mark.journal.interfaceCloneNames upto self.journal.interfaceCloneNames.count() 'eachInterfaceCloneAnswer'
			_ = self.interfaceCloneAnswers.remove(try self.journal.interfaceCloneNames.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: interfaceCloneNames.get OOB at {position}"))
		end 'eachInterfaceCloneAnswer'

		for position in mark.journal.uniqueTypeNames upto self.journal.uniqueTypeNames.count() 'eachUniqueTypeAnswer'
			_ = self.uniqueTypeAnswers.remove(try self.journal.uniqueTypeNames.get(position) otherwise panic("ProgramSignatures.rewindJournaledWrites: uniqueTypeNames.get OOB at {position}"))
		end 'eachUniqueTypeAnswer'

		self.restoreScalarsTo(mark)
	end 'rewindJournaledWrites'

	function resetOverlayTables()
		self.structSlots = StructSlotMap.create()
		self.mintedTupleLayouts = StructLayoutArray.create(0)
		self.compiledInstanceNames = CompiledInstanceNameMap.create()
		self.canonicalInstanceNames = CanonicalInstanceNameMap.create()
		self.substitutedInstanceOrigins = SubstitutedInstanceOriginMap.create()
		self.canonicalInstanceNameIndex = CanonicalInstanceNameIndex.create()
		self.tupleCanonicalNames = TupleCanonicalNameMap.create()
		self.tupleElementTokens = TupleElementTokenMap.create()
		self.tupleElementTokenOwners = TupleElementTokenOwnerMap.create()
		self.tupleAliases = DeclaredTupleAliasMap.create()
		self.multiplyDeclaredTupleAliases = MultiplyDeclaredTupleAliasMap.create()
		self.interfaceCloneAnswers = DeepCloneAnswerMap.create()
		self.uniqueTypeAnswers = DeepCloneAnswerMap.create()
		self.deepCloneAnswers = DeepCloneAnswerMap.create()
		self.shareWalkAnswers = DeepCloneAnswerMap.create()
		self.restoreScalarsTo(self.baselineBandMark())
	end 'resetOverlayTables'

	function restoreScalarsTo(mark ParseBandMark)
		self.crossFileConstantReads.truncate(mark.crossFileConstantReads)
		self.canonicalNamesIndexedThrough = mark.canonicalNamesIndexedThrough
		self.arrayByteInstance = mark.arrayByteInstance
		self.arrayByteInstanceComputed = mark.arrayByteInstanceComputed
		self.deepCloneWalkReadInstances = mark.deepCloneWalkReadInstances
		self.someRecordHoldsAnInterfaceValue = mark.someRecordHoldsAnInterfaceValue
		self.recordsHoldingAnInterfaceValueCounted = mark.recordsHoldingAnInterfaceValueCounted
		self.typeNames.rewindTo(mark.typeNames)
		self.journal.truncateTo(mark.journal)
	end 'restoreScalarsTo'

	// In reverse, so a name written twice ends at the value it held before the first write.
	function restoreCanonicalIndex(first ElementIndex)
		var position = self.journal.canonicalIndexWrites.count()

		while position > first 'eachWriteFromTheEnd'
			position = position - 1
			let write = try self.journal.canonicalIndexWrites.get(position) otherwise panic("ProgramSignatures.restoreCanonicalIndex: canonicalIndexWrites.get OOB at {position}")

			match write.prior 'prior'
				absent then _ = self.canonicalInstanceNameIndex.remove(write.name)
				held(id) then self.canonicalInstanceNameIndex.upsert(write.name, value: id)
			end 'prior'
		end 'eachWriteFromTheEnd'
	end 'restoreCanonicalIndex'

	function restoreTupleAliasClaimant(name ByteArray, declPath String, prior PriorTupleAlias)
		let byFile = try self.multiplyDeclaredTupleAliases.get(name) otherwise panic("ProgramSignatures.restoreTupleAliasClaimant: the journal holds a claimant column for tuple alias `{String.from(name)}` and the roster does not hold the name — a `fileEntry` column is written only where the roster already held it, and no write between that column and this restore removes a name")

		match prior 'prior'
			absent then _ = byFile.remove(declPath)
			held(alias) then byFile.upsert(declPath, value: alias)
		end 'prior'

		self.multiplyDeclaredTupleAliases.upsert(name, value: byFile)
	end 'restoreTupleAliasClaimant'

	// In reverse, for `restoreCanonicalIndex`'s reason.
	function restoreTupleAliases(first ElementIndex)
		var position = self.journal.tupleAliasWrites.count()

		while position > first 'eachWriteFromTheEnd'
			position = position - 1
			let write = try self.journal.tupleAliasWrites.get(position) otherwise panic("ProgramSignatures.restoreTupleAliases: tupleAliasWrites.get OOB at {position}")

			match write.prior 'prior'
				absent then _ = self.tupleAliases.remove(write.name)
				held(alias) then self.tupleAliases.upsert(write.name, value: alias)
			end 'prior'

			match write.priorClaimants 'priorClaimants'
				nameAbsent then _ = self.multiplyDeclaredTupleAliases.remove(write.name)
				fileEntry(declPath, prior) then self.restoreTupleAliasClaimant(write.name, declPath: declPath, prior: prior)
			end 'priorClaimants'
		end 'eachWriteFromTheEnd'
	end 'restoreTupleAliases'

	// ⭐⭐ **FOLD ONE PARSE'S MINTS INTO THE INDEX, IN SOURCE-PATH ORDER.** Each row is interned by its
	// structure, so a row two files minted is one row and its id is the first minter's — the numbering a
	// serial parse in source-path order gives. Answers the id each row now has, in row order.
	export function adoptParseMints(mints LocalInstanceMints) returns GenericInstanceIdArray
		let names = TypeNameIdArray.create(mints.typeNames.count(), zeroed: false)

		for name in mints.typeNames 'eachName'
			names.push(self.typeNames.intern(name))
		end 'eachName'

		let instances = GenericInstanceIdMap.create()
		let adopted = GenericInstanceIdArray.create(mints.rows.count(), zeroed: false)

		// Shares `instances`, so a row's arguments are remapped through every row adopted before it.
		let remap = TypeIdRemap.create(names, namesBase: mints.typeNameBaseline, instances: instances)

		for (position, row) in mints.rows.withIterator() 'eachRow'
			let id = self.internRow(remap.applyName(row.baseId), args: remapMaxonTypes(row.args, remap: remap), shape: row.shape, asSpeculative: row.speculative)
			instances.upsert(BandInstanceIdBase + (position.index() as GenericInstanceId), value: id)
			adopted.push(id)
		end 'eachRow'

		for layout in mints.tupleLayouts 'eachTuple'
			let remapped = remapMaxonTypes(layout.fieldTypes, remap: remap)
			let registered = self.registerTupleLayout(remapped, written: self.writtenBrandsOf(layout, types: remapped), capabilities: tupleItemCapabilitiesOf(layout), declFilePath: layout.declFilePath)

			if not registered.equals(layout.name) 'renamedByTheMerge'
				panic("ProgramSignatures.adoptParseMints: tuple `{String.from(layout.name)}` registered as `{String.from(registered)}` — a tuple's name is built from its elements' names, which no renumbering moves")
			end 'renamedByTheMerge'
		end 'eachTuple'

		for id in mints.namedRows 'eachNamed'
			self.genericInstances.markNamed(id)
		end 'eachNamed'

		for id in mints.copyDemandedRows 'eachCopyDemanded'
			self.genericInstances.markCopyDemanded(remap.applyInstance(id))
		end 'eachCopyDemanded'

		for origin in mints.substitutionOrigins 'eachOrigin'
			self.recordSubstitutionOrigin(remap.applyInstance(origin.instance), through: remap.applyInstance(origin.through))
		end 'eachOrigin'

		for read in mints.constantReads 'eachRead'
			self.crossFileConstantReads.push(read)
		end 'eachRead'

		for record in mints.tupleAliases 'eachAlias'
			self.writeTupleAlias(record.name, alias: record.alias)
		end 'eachAlias'

		return adopted
	end 'adoptParseMints'

	// ⭐⭐ **A ROW-SET QUESTION IS ANSWERED FROM THE ROWS ONE PARSE CAN SEE, AND THE ANSWER IS KEPT.** Whether any
	// instance of a base classifies its argument a certain way, whether a field's drop diverges across
	// instantiations — each is a question about rows EVERY file's parse mints, and
	// one parse sees only the baseline and its own rows so far. So the parse records what it was told, the merge
	// re-asks it over the whole program (`rowSetAnswersThatMoved`), and a file told something the whole program
	// disagrees with is parsed again with the whole program's answer standing in (`RowSetOverrideTable`).
	function rowSetAnswer(query RowSetQuery) returns RowSetAnswer
		if not self.rowSetLog.parsing 'noParseIsAsking'
			return self.answerOverTheRows(query)
		end 'noParseIsAsking'

		let key = rowSetQueryKey(query)
		let answer = try self.rowSetLog.overrides.answerFor(key) otherwise self.answerOverTheRows(query)
		self.rowSetLog.note(key, query: query, answer: answer)
		return answer
	end 'rowSetAnswer'

	function answerOverTheRows(query RowSetQuery) returns RowSetAnswer
		match query 'query'
			typeArgKind(param, kind) then return rowSetAnswerOfMatch(self.typeArgKindMatchOverTheRows(param, kind: kind))
			dropDiverges(typeName, index, sharedCallee) then return RowSetAnswer.holds(self.dropDivergesOverTheRows(typeName, index: index, sharedCallee: sharedCallee))
		end 'query'
	end 'answerOverTheRows'

	// Re-ask every question one parse recorded over the rows this index holds now — every file's, after the
	// merge — and file the whole program's answer into `overrides` wherever it is stronger than what the parse
	// was told. Answers whether anything was filed. `complete` carries answers already asked this fold, so a
	// question many files asked is walked once.
	//
	// ⭐ **EVERY ANSWER IS MONOTONE IN THE ROWS, AND THE ROWS ONLY GROW.** Each question is existential over the
	// rows ("some instance…"), a merge holds every row the parse saw, and an override only ever raises an answer —
	// so the whole program is never weaker than what a parse was told, and that is checked here rather than
	// assumed. An answer of equal strength stands whatever site it names: a site is blame for a refusal, which
	// ends the compile before any comparison.
	export function rowSetAnswersThatMoved(filePath FilePath, mints LocalInstanceMints, overrides RowSetOverrideTable, complete RowSetAnswerMap) returns bool
		var moved = false

		for key in mints.rowSetAnswers.order 'eachQuestion'
			let told = try mints.rowSetAnswers.records.get(key) otherwise panic("ProgramSignatures.rowSetAnswersThatMoved: the log orders a question it holds no record of")
			let whole = self.completeRowSetAnswer(key, query: told.query, complete: complete)
			let toldHolds = rowSetAnswerIsAffirmative(told.answer)

			if toldHolds == rowSetAnswerIsAffirmative(whole) 'theWholeProgramAgrees'
				continue
			end 'theWholeProgramAgrees'

			if toldHolds 'theWholeProgramIsWeaker'
				panic("ProgramSignatures.rowSetAnswersThatMoved: {filePath.toString()} asked {self.rowSetQueryDisplay(told.query)} and was told {rowSetAnswerDisplay(told.answer)}, but the whole program's rows answer {rowSetAnswerDisplay(whole)} — every row a parse sees is merged, and an override only raises an answer, so the rows shrank between the parse and the merge")
			end 'theWholeProgramIsWeaker'

			overrides.stand(key, answer: whole)
			moved = true
		end 'eachQuestion'

		return moved
	end 'rowSetAnswersThatMoved'

	function rowSetQueryDisplay(query RowSetQuery) returns String
		match query 'query'
			typeArgKind(param, kind) then return "whether an instance's argument at {self.typeParamDisplay(param)} is {kind.name}"
			dropDiverges(typeName, index, sharedCallee) then return "whether field {index} of '{String.from(typeName)}' drops through something other than '{String.from(sharedCallee)}'"
		end 'query'
	end 'rowSetQueryDisplay'

	function typeParamDisplay(param TypeParamId) returns String
		let owner = try self.typeParamOwnerOf(param) otherwise panic("ProgramSignatures.typeParamDisplay: a row-set question was asked about type-parameter token {param}, which no declaration minted")
		return "'{String.from(owner.declaringTypeName)}.{String.from(owner.paramName)}'"
	end 'typeParamDisplay'

	function completeRowSetAnswer(key ByteArray, query RowSetQuery, complete RowSetAnswerMap) returns RowSetAnswer
		if let asked = try complete.get(key) 'alreadyAsked'
			return asked
		end 'alreadyAsked'

		let answer = self.answerOverTheRows(query)
		complete.upsert(key, value: answer)
		return answer
	end 'completeRowSetAnswer'

	// Every container's size and every scalar's value — what a write the journal missed moves.
	function fingerprint(detail FingerprintDetail) returns IndexFingerprint
		let fingerprint = IndexFingerprint.create(detail)
		let declarations = self.settledDeclarations()
		fingerprint.noteDigest("hash", digest: self.hash)
		fingerprint.note("returnTypes", value: declarations.returnTypes.count())
		declarations.typeAliases.noteFingerprint(fingerprint, group: "typeAliases")
		declarations.functionTypeAliases.noteFingerprint(fingerprint, group: "functionTypeAliases")
		fingerprint.note("structLayouts", value: declarations.structLayouts.count() as EntryCount)
		fingerprint.note("structSlots", value: self.structSlots.count())
		fingerprint.note("mintedTupleLayouts", value: self.mintedTupleLayouts.count() as EntryCount)
		fingerprint.note("structNamesInDeclOrder", value: declarations.structNamesInDeclOrder.count() as EntryCount)
		fingerprint.note("enumTypes", value: declarations.enumTypes.count())
		fingerprint.note("genericAliasDecls", value: declarations.genericAliasDecls.count() as EntryCount)
		self.genericInstances.noteFingerprint(fingerprint, group: "genericInstances")
		fingerprint.note("compiledInstanceNames", value: self.compiledInstanceNames.count())
		fingerprint.note("canonicalInstanceNames", value: self.canonicalInstanceNames.count())
		fingerprint.note("instanceDisplayNames", value: declarations.instanceDisplayNames.count())
		fingerprint.note("funcReturnAliasNames", value: declarations.funcReturnAliasNames.count())
		fingerprint.note("substitutedInstanceOrigins", value: self.substitutedInstanceOrigins.count())
		fingerprint.note("canonicalInstanceNameIndex", value: self.canonicalInstanceNameIndex.count())
		fingerprint.note("canonicalNamesIndexedThrough", value: self.canonicalNamesIndexedThrough as EntryCount)
		fingerprint.note("tupleCanonicalNames", value: self.tupleCanonicalNames.count())
		fingerprint.note("tupleElementTokens", value: self.tupleElementTokens.count())
		fingerprint.note("tupleElementTokenOwners", value: self.tupleElementTokenOwners.count())
		fingerprint.note("typeParamOwners", value: declarations.typeParamOwners.count())
		fingerprint.note("tupleAliases", value: self.tupleAliases.count())
		fingerprint.note("multiplyDeclaredTupleAliases", value: self.multiplyDeclaredTupleAliases.count())
		fingerprint.note("crossKindContests", value: crossKindContestCount(declarations.crossKindContests))
		fingerprint.note("typeNameClaimIndex", value: typeNameClaimIndexCount(declarations.typeNameClaimIndex))
		fingerprint.noteFlag("sawAggregateArrayLiteral", flag: self.sawAggregateArrayLiteral)
		fingerprint.noteFlag("sawListFromConstruction", flag: self.sawListFromConstruction)
		fingerprint.noteFlag("sawEnumAllCasesAccess", flag: self.sawEnumAllCasesAccess)
		fingerprint.noteFlag("sawIntArrayLiteral", flag: self.sawIntArrayLiteral)
		fingerprint.noteFlag("sawByteStringLiteral", flag: self.sawByteStringLiteral)
		fingerprint.noteFlag("sawStringArrayLiteral", flag: self.sawStringArrayLiteral)
		fingerprint.noteFlag("sawSetFromConstruction", flag: self.sawSetFromConstruction)
		fingerprint.noteFlag("sawManagedFileProducer", flag: self.sawManagedFileProducer)
		fingerprint.noteFlag("sawManagedDirectoryProducer", flag: self.sawManagedDirectoryProducer)
		fingerprint.noteFlag("sawManagedSocketProducer", flag: self.sawManagedSocketProducer)
		fingerprint.noteFlag("sawManagedHostResourceProducer", flag: self.sawManagedHostResourceProducer)
		fingerprint.note("fixedArrayFromSizes", value: declarations.fixedArrayFromSizes.count() as EntryCount)
		fingerprint.note("genericAliases", value: declarations.genericAliases.count())
		fingerprint.note("interfaceAliases", value: declarations.interfaceAliases.count())
		fingerprint.note("interfaceAliasOwners", value: declarations.interfaceAliasOwners.count())
		fingerprint.note("contestedGenericAliases", value: genericAliasContestCount(declarations.contestedGenericAliases))
		fingerprint.note("multiplyDeclaredGenericAliases", value: disagreeingAliasNameCount(declarations.multiplyDeclaredGenericAliases))
		fingerprint.note("sharedInstanceGenericAliases", value: declarations.sharedInstanceGenericAliases.count())
		fingerprint.note("genericAliasMints", value: declarations.genericAliasMints.count())
		fingerprint.note("divergedGenericAliasDecl", value: aliasCycleValue(self.divergedGenericAliasDecl))
		fingerprint.note("genericAliasSites", value: declarations.genericAliasSites.count() as EntryCount)
		fingerprint.note("genericWithSites", value: declarations.genericWithSites.count() as EntryCount)
		fingerprint.note("constLiteralSites", value: declarations.constLiteralSites.count() as EntryCount)
		fingerprint.note("innerAliases", value: declarations.innerAliases.count())
		fingerprint.note("extensionInnerAliasMembers", value: declarations.extensionInnerAliasMembers.count())
		fingerprint.note("extensionInnerAliasKeepers", value: declarations.extensionInnerAliasKeepers.count())
		fingerprint.note("typeBodyInnerAliasMembers", value: declarations.typeBodyInnerAliasMembers.count())
		fingerprint.note("authorShadowedInnerAliases", value: declarations.authorShadowedInnerAliases.count())
		fingerprint.note("nestedFunctionAliasMembers", value: declarations.nestedFunctionAliasMembers.count())
		fingerprint.note("pendingImplementsClauses", value: declarations.pendingImplementsClauses.count() as EntryCount)
		fingerprint.note("implementsParents", value: declarations.implementsParents.count())
		fingerprint.note("implementsVerdicts", value: declarations.implementsVerdicts.count())
		fingerprint.note("droppedSignatures", value: declarations.droppedSignatures.count())
		fingerprint.note("methodInnerAliasParams", value: declarations.methodInnerAliasParams.count())
		fingerprint.note("interfaces", value: declarations.interfaces.entries.count())
		fingerprint.note("interfaceNamesInDeclOrder", value: declarations.interfaceNamesInDeclOrder.count() as EntryCount)
		fingerprint.note("interfaceDeclIndexByName", value: declarations.interfaceDeclIndexByName.count())
		fingerprint.note("interfaceDeclSites", value: declarations.interfaceDeclSites.count() as EntryCount)
		fingerprint.note("interfaceDeclSiteNames", value: declarations.interfaceDeclSiteNames.count())
		fingerprint.note("extensionDeclSites", value: declarations.extensionDeclSites.count() as EntryCount)
		fingerprint.note("conformanceClauseSites", value: declarations.conformanceClauseSites.count() as EntryCount)
		fingerprint.note("descriptorScanSites", value: declarations.descriptorScanSites.count() as EntryCount)
		fingerprint.note("fixedElementCountNeeds", value: declarations.fixedElementCountNeeds.count())
		fingerprint.note("conditionalExtensionSkips", value: declarations.conditionalExtensionSkips.count())
		fingerprint.note("associatedTypeHoldings", value: declarations.associatedTypeHoldings.count())
		fingerprint.note("sweptConformances", value: declarations.sweptConformances.count())
		fingerprint.noteFlag("sweptConformancesBuilt", flag: declarations.sweptConformancesBuilt)
		fingerprint.note("conformerIndex", value: declarations.conformerIndex.rosterCount())
		fingerprint.noteFlag("conformerIndexBuilt", flag: declarations.conformerIndex.built)
		fingerprint.noteFlag("recordsHoldingAnInterfaceValueCounted", flag: self.recordsHoldingAnInterfaceValueCounted)
		fingerprint.noteFlag("someRecordHoldsAnInterfaceValue", flag: self.someRecordHoldsAnInterfaceValue)
		fingerprint.note("extensionDeclaredConformances", value: declarations.extensionDeclaredConformances.count())
		fingerprint.note("typeExtensionConformances", value: declarations.typeExtensionConformances.count())
		fingerprint.note("extensionMethodConstraints", value: declarations.extensionMethodConstraints.count())
		self.typeNames.noteFingerprint(fingerprint, group: "typeNames")
		fingerprint.note("decls", value: declarations.decls.count() as EntryCount)
		fingerprint.note("crossFileConstantReads", value: self.crossFileConstantReads.count() as EntryCount)
		fingerprint.note("declIndex", value: declarations.declIndex.count())
		fingerprint.note("funcParamConsumes", value: declarations.funcParamConsumes.count())
		fingerprint.note("declParamConsumes", value: declarations.declParamConsumes.count())
		fingerprint.note("funcParamReassigns", value: declarations.funcParamReassigns.count())
		fingerprint.note("byRefSitesOfKey", value: declarations.byRefSitesOfKey.count())
		fingerprint.noteFlag("sawMutableMarker", flag: declarations.sawMutableMarker)
		fingerprint.noteFlag("sawMutableFunctionValue", flag: declarations.sawMutableFunctionValue)

		fingerprint.noteFlag("byRefNamesPublished", flag: self.byRefNamesPublished)
		fingerprint.noteFlag("byRefMasksSettled", flag: self.byRefMasksSettled)
		fingerprint.note("functionValuedFieldNames", value: self.functionValuedFieldNames.count())
		fingerprint.note("funcGlobalAliasReturns", value: declarations.funcGlobalAliasReturns.count())
		fingerprint.noteFlag("sawGlobalNameReturn", flag: self.sawGlobalNameReturn)
		fingerprint.note("globalAliasReturnKeys", value: declarations.globalAliasReturnKeys.count())
		fingerprint.noteFlag("globalAliasReturnsClosed", flag: self.globalAliasReturnsClosed)
		fingerprint.note("byRefBareNames", value: declarations.byRefBareNames.count())
		fingerprint.note("corpusHandOffsByCallee", value: declarations.corpusHandOffsByCallee.count())
		fingerprint.note("corpusIndirectHandOffs", value: declarations.corpusIndirectHandOffs.count())
		fingerprint.note("freeFunctionByRefPositions", value: declarations.freeFunctionByRefPositions.count())
		fingerprint.note("deepCloneAnswers", value: self.deepCloneAnswers.count())
		fingerprint.note("interfaceCloneAnswers", value: self.interfaceCloneAnswers.count())
		fingerprint.note("uniqueTypeAnswers", value: self.uniqueTypeAnswers.count())
		fingerprint.note("shareWalkAnswers", value: self.shareWalkAnswers.count())
		fingerprint.noteFlag("deepCloneWalkReadInstances", flag: self.deepCloneWalkReadInstances)
		fingerprint.note("funcThrows", value: declarations.funcThrows.count())
		fingerprint.note("funcDiverges", value: declarations.funcDiverges.count())
		fingerprint.note("funcAlwaysThrows", value: declarations.funcAlwaysThrows.count())
		fingerprint.note("funcReturnsFreshRecord", value: declarations.funcReturnsFreshRecord.count())
		fingerprint.note("funcFreshReturnForwards", value: declarations.funcFreshReturnForwards.count())
		fingerprint.noteFlag("freshReturnForwardsClosed", flag: self.freshReturnForwardsClosed)
		fingerprint.noteFlag("forwardedStoresClosed", flag: self.forwardedStoresClosed)
		fingerprint.note("funcConstructsFromParams", value: declarations.funcConstructsFromParams.count())
		fingerprint.note("funcReturnsReceiverField", value: declarations.funcReturnsReceiverField.count())
		fingerprint.note("funcReturnsParameter", value: declarations.funcReturnsParameter.count())
