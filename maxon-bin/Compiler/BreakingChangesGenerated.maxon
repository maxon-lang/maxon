// @generated by website/scripts/sync-docs.mjs from RELEASE_NOTES.md (its release headings and the "Breaking changes" entries under them); edit that document and run the script, never this file
export let UnreleasedVersion = "Unreleased"
export let ReleasedVersions = ["0.5.0", "0.4.0", "0.3.1", "0.3.0", "0.2.2", "0.2.1", "0.2.0", "0.1.1", "0.1.0"]
export let BreakingChangeVersions = ["Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.2.0", "0.1.1", "0.1.1", "0.1.1", "0.1.1"]
export let BreakingChangeDescriptions = ["`InputSource.delayed(data)` is removed, with the fixed one-second stdin feed it stood for.", "A `with` list names at most 64 type arguments; a longer one is E2015.", "A call whose argument wears an alias binds the overload declared over that alias, even where another overload takes the argument's primitive type exactly: beside `f(n Small)` and `f(n Integer)`, `f(x as Small)` binds `f(n Small)`.", "`Vector` is renamed `FixedArray`, and its iterator typealias `Vector.VectorIter` is `FixedArray.FixedArrayIter`; `Vector with 3 Int` is an unknown type (E2010).", "A `FixedArray` `get` or `set` whose index is proven inside the size — a constant, a value whose ranged type lies inside, or a counted-loop counter between compile-time bounds — cannot throw, so a `try` on it is E3055.", "A `module`, `export` or `public` top-level `let` or `var`, or `static let` or `static var` member, whose type is less visible than the binding is E3167 (`exported constant 'api.BIG' names file-private enum 'Status' in its type`). The type is the one the initializer gives it, inferred or not, and includes the typealias the initializer was spelled through (`50 as Small`, `Tallies.create()`).", "Every other surface a declaration exposes is held to E3167 too: an instance field marked `module`, `export` or `public` (at the narrower of its own and its type's tier), a union case's payloads, a typealias's target, an `implements` clause and its `with` arguments, a type's or generic function's `where` clause, an interface's `extends` clause, and a struct-backed enum's backing record (`exported field 'api.Holder.mode' names file-private enum 'Mode' in its type`).", "A constant `FixedArray` index at or past the size is E3005 at compile time.", "A divide or `mod` whose divisor is proven non-zero by a counted loop's bounds or a range computed from them (`100 / i` in `for i in 1 upto 10`) cannot throw, so a `try` on it is E3055.", "`URL.host()` answers an IP literal without its brackets (`::1` for `http://[::1]/`), where it answered `[::1]`; the new `URL.authorityHost()` answers the bracketed spelling. An `HttpRequest`'s URL read in a handler follows the same rule.", "`DerError` has two more cases, `invalidBoolean` and `invalidString`, so a `match` over it that lists every case is no longer exhaustive.", "An interface requirement returning one typealias of a generic instance is not met by a method returning another typealias of that instance (E3016), as a parameter already was not.", "A declared type named like a generic instance (`type Array_Byte`) and the instance itself (`ByteArray`) no longer meet each other's interface requirements (E3016).", "An argument passed through an interface value or a `where` constraint is checked against the requirement's declared type as a direct call's is: a value of another generic instance, of another typealias of the same instance, or a non-`Character`/`CString` value for a `Character` or `CString` parameter is E3005.", "The result of a call through an interface keeps the requirement's typealias, so passing it where another typealias of the same instance is expected is E3005.", "A call's result wears the typealias its callee returns as the callee's declaring file resolves it, a directory-qualified `returns alpha.Numbers` included, so passing it where another declaration of that alias name is expected is E3005.", "A `match` payload binding wears the typealias its payload was declared with, as the union's declaring file resolves it, so passing it where another typealias of the same instance is expected is E3005.", "A tuple holding a value read out of a `let` field, a `let` payload or a read-only element is read-only wherever it goes, a tuple a call returns included. Binding it, or one of its read-only elements, to a `var`, assigning it to existing `var` names, storing it into a `var` field or an array, or passing it to a function that writes it is E3078 (E3159 for the call); each of these compiled before.", "Passing a `let` to a function whose result holds a closure capturing that parameter — in a container, a record or bare — is E3078, also when the result is bound by a `let` and the closure only reads.", "An element of another enum stored into an array by `push`, `set`, `insert` or `fill`, or written in an array literal, is refused (E3005).", "An array-literal element of another brand is refused (E3005), as `push` refuses one: a `B` value in a `[...]` written at an `Array with A` slot.", "An array-literal element of another type is E3005, where it was E2015.", "A member of your own type named `pop`, `remove`, `removeFirst` or `removeLast` that hands back a promise is judged by its body, and one that returns a borrow (`self.items.last()`) is E3141; so is a generic static that hands back a promise one of its arguments still holds.", "A static called on a bare generic name whose result is written over a type parameter no argument fixes (`Holder.make()` declared `returns T`) is E3162.", "`Type.method` written without its call — a static or instance method, a static the compiler provides (`int.fromString`), or a requirement through a type parameter — is E2078, where it was E2010, E2004 or, at module scope, E2015.", "A static a primitive (`int.nope()`, `byte.nope()`), a compiler-owned type (`String`, `__ManagedFile`) or a builtin container alias does not have is E2073, reported at the member, where it was E2015, or E3004 for `byte`.", "A member read through a ranged, function or tuple alias, an interface, a type parameter or a directory that does not declare it is E2073, where it was E2010 (`Expected 'min or max'`).", "A `static` requirement called through a type parameter (`T.make()`) is E3116, where it was E3004.", "Assigning to a method (`Ops.twice = f`) is E2013, where it was E2004.", "A primitive's static called in a module-level initializer (`let n = int.fromString(\"5\")`) is E2015, where it was E2004.", "A function whose shape differs from the declared function type, stored into a field (`h.op = f`, `self.op = f`, a struct literal), a tuple element (`t.0 = f`) or an array element (`push`, `set`, a typed array literal), is E3005.", "A `?`, `;`, `|`, `&`, `$`, `%`, `~`, `^`, backtick, control character or non-ASCII character outside a string literal or a comment is E1010 (`Unexpected character`); the lexer skipped it before.", "A `spawn` of an overloaded factory and an `async` call of an overloaded function bind the overload their arguments fit, as any call does: two overloads that fit equally are E3007, and the bound overload alone decides which arguments move (a promise included) and which type arguments a generic factory fixes.", "Beside a generic function of the same name, a non-generic overload binds a literal, a negated literal, a loop counter or a value computed from them that lies inside its parameter's alias, and the generic binds one known to leave it.", "A literal cast to the alias of the non-generic overload it already binds (`describe(5 as Score)` beside a generic `describe`) is E3010.", "A fresh tuple or record that holds a record a `var` of the function, or a module `var`, may still write is E3078 when it is stored into a `let` field, a `let` payload or a `readonly` element, or passed to a parameter that stores it there (`Frozen.create((Box.create(1), id(p)))` with `p` a `var` written later); it compiled before, with the `let` field's contents writable through `p`. A `let` bound to a fresh tuple or record holding a module `var`'s record that is written later is E3188 (`let t = (Box.create(1), gBox)`).", "A function value fits a function type only by variance: a read-only parameter may be wider than the type's, a parameter the program writes by reference must be the same type, and a result may be narrower. A function whose read-only parameter is narrower, whose written parameter differs, or whose result is wider than the function type it is stored or passed as — a ranged alias, or a bare `int` in the type's declaration, against a function over a narrower alias — is E3005, or E3009 as an `as` cast.", "A closure literal bound by `let` or `var`, or written where no function type is declared, has an unranged result, so it no longer fits a function type declaring a ranged result (E3005); a closure written at a parameter, returned value, struct field, field write, variable write or union payload of a function type takes that type's parameter and result types, as it did at a parameter.", "A call through a function value is checked against the function type the value is held at, not against the function behind it: after `let f = one as Bin`, `f(3)` against a two-parameter `Bin` is E3036 beside the cast's E3009, where only the E3009 was reported.", "`HttpError` and `HttpServerError` are unions, each with a new case `tlsFailed(error TlsError)`, so a `match` over either that lists every case is no longer exhaustive, and `==` or `!=` on one is E3066.", "`HttpClient` fetches an `https` URL over TLS, on port 443 unless the URL names one, where it threw `HttpError.unsupportedScheme`; the error is now thrown only for a scheme that is neither `http` nor `https`.", "Two `extension` bodies in a program that declare the same nested `typealias` for one type are E3061 at the later declaration, in one file or two, over one instance or two, and for every conformer of an interface extension; the compiler kept whichever declaration it reached last and gave the other extension's own signatures that instance without a word.", "A `type` or `interface` body that declares the same nested `typealias` twice is E3061 at the second declaration, for the generic-instance, ranged, function and tuple forms; the compiler kept the last declaration and gave the first one's own signatures that meaning without a word.", "An `extension` of a type that declares a nested `typealias` the type's own body declares is E3061 at the extension's declaration, in any file and for a standard-library type's members too, as an extension method of the type's own method's name is E3176. An interface extension's nested `typealias` yields to a conforming type's own declaration of the same name, and the extension's methods compiled for that type read the type's; they read the extension's alias while callers saw the type's.", "A nested `typealias` that a program's `extension` declares under the name of one a library `extension` of the same type declares (`ElementArray`, `SortComparator` or `NodePower` on `Array`, `ElementTransform` on `Iterable`) is the program's own member: the program's extension bodies and the callers of its methods read the program's declaration, where an extension body that wrote the name read the library's and the library's bodies could read the program's. A second file's extension naming a member the first file leaves without a visibility modifier is E3008.", "`TlsListener.accept()` returns once the TCP connection is accepted, and the stream runs its handshake on its first `send`, `recv` or `shutdownWrite`, or on the new `handshake()`, as Go's `Conn.Handshake` does. A failed handshake is thrown from that call, not from `accept()`, and the options' handshake deadline bounds the handshake from that call. A read or write deadline set on the stream before then applies once the handshake completes.", "`TlsStream.protocol()`, `cipherSuite()`, `applicationProtocol()` and `peerCertificates()` throw `TlsError`, `handshakePending` until the handshake has completed, and `TlsError` has that case, so a `match` over it that lists every case is no longer exhaustive. `HttpTransport.security()` throws `TlsError` the same way.", "`HttpServer.serve` moves each connection, a `TcpClient` or a `TlsStream`, to a green thread of its own, so a client that stalls and a handler that computes delay only their own connection, and it returns once every connection it took has finished. The handler is one value every connection reads at once, so it is read-only: a handler whose methods write its fields is E3138 where `serve` sends it to a connection's thread, in `stdlib/HttpServer.maxon`, and a handler that holds an OS handle, a function value or a promise, or that the calling function also shares with a coroutine, stops the program with exit code 96. What the handler wrote in place is no longer shared between requests or visible to the caller.", "A cast whose operand is itself a cast, `x as A as B` or `(x as A) as B`, is E2079.", "A file-scope `let` or `static` initializer whose operator combines two different typealiases with no common ancestor (`let t = a + b` over a `Small` and a `Tally`, a comparison, `and`, `or`, `xor` or `mod`) is E3005, as it is in a function body.", "A file-scope constant derived from aliased operands carries their typealias, as the same expression does in a function body: with `let a = 5 as Small`, `let s = a + a` is a `Small`, so passing `s` where a `Tally` is required is E3005 and casting it to `Small` again is E3010.", "A file-scope `let` initialized by a cast literal (`let Base = 2 as Wide`) whose readers include another file-scope initializer that takes the plain constant (`let S = Base as Small`) is E3010, as a read in a function body is.", "A bare call to an instance method of the enclosing type from a `static` method, a file-scope initializer or a `static var` initializer is E3193, with or without arguments: a first argument there is never the receiver (`bump(m)` with `m` a `Maker` no longer fills `self`).", "In a type that declares a `static` and an instance method of one name, a bare call from an instance method or its closures calls the instance method, whichever is declared first: with `function getValue()` declared before `static function getValue()`, a bare `getValue()` in an instance method is `self.getValue()`.", "A `union` value is refused as an operand of an arithmetic, bitwise or shift operator, of unary `-` or `not`, and as a condition, as a struct is: `n + Shape.empty` is E2004 (`Cannot operate on int and Shape`).", "`TlsClient.connect`'s `deadlineMs` parameter is renamed `dialDeadlineMs` and bounds only the TCP connection, where it used to bound the connection and the handshake each; the handshake is bounded by the new `TlsClientOptions.setHandshakeDeadline(milliseconds)`, 30 seconds by default as `TlsServerOptions` already is, where a client with no `deadlineMs` waited without a limit. A handshake that outlasts it throws `handshakeTimedOut`. `HttpClient` caps the handshake deadline at what is left of the exchange's timeout.", "A message parameter, a message reply or a `spawn` factory argument whose type can hold a promise is E3135: a record with a promise in a field, a union with a case carrying one, or an array or list of promises, empty or not; so is a bare promise handed to a factory. A coroutine belongs to the strand that started it, so a promise that crossed was dropped, awaited or cancelled by a strand that does not own it, and these programs compiled and aborted with `fatal error: promise dropped by a machine that does not hold its strand`. A service's own state may still hold the promises its handlers start.", "`spawn Type.factory(args)` runs the factory on the new service's own green thread instead of on the spawner's, and its arguments move there the way a message's do. A coroutine the factory starts therefore belongs to the service's strand, so a factory may keep promises in the state it builds. Programs that compiled before are refused. A binding passed to a factory is moved whether or not the factory keeps it, so reading it after the `spawn` is E3102, and a borrowed argument crosses on a message argument's terms, so one read out of a `var` field or a container is E3138 even where the factory does not keep it. A factory, or a function it calls, is held to the rules a message handler is: reading or writing a module-level or `static` `var` is E3143, reading a module-level `let` no share walk can mark is E3163, and awaiting a reply in a cycle of services is E3139. A factory argument held at an opaque type parameter (a `T` value inside a generic function) is E2015.", "A generic body the program instantiates with a promise, or a type holding one, is held to a promise's rules: a `T` parameter it stores in a record twice, or inside a loop, is E3102, and a closure in it that stores or returns a captured `T` is E3141.", "The `ByteWord` alias is removed; `readOrderedWord` returns, and `appendOrderedWord` takes, an `OrderedWord`, the same `bits(64)`.", "A typealias's identity is its declaration rather than its spelling: two declarations of one name are two types even over the same range, and a value crossing between them is refused.", "A bare type name that reaches more than one visible declaration is E3063 in every file, including a file that declares one of them.", "A typealias declared inside a type is private to its file unless it carries its own visibility modifier, and naming a file-private one from another file, bare or qualified, is E3008.", "E3167 checks every type a signature names, an interface's requirements and the types a named alias reaches included, so a signature that was accepted can be refused.", "Discarding the result of a pure function (E3064) is refused in more programs: a function that writes only into values it created, one that calls a closure it can name, a search through a container's `withIterator()`, and a `Map` or `Set` lookup.", "A program that declares `BuiltinStringLiteral`, `BuiltinCharLiteral` or `BuiltinArrayLiteral` is refused (E2015).", "Only a `.maxproj` marks a project for the language server; a file with no `.maxproj` above it is checked alone against the standard library, and nothing else of its directory is loaded for it.", "`Utf8ByteCount`, `CodepointCount` and `Utf16UnitCount` are removed.", "`==` on two values of a generic type calls the type's `equals`, and is E3005 when the type declares none.", "Writing through a module `let`'s record handed back by a function, and copying a `let`'s field into a `var`, are refused (E3159, E3078).", "A copy that reaches a promise (a `List.clone`, or a generic type copying an array of promises) is E3141, and a borrowed argument (a parameter, a field, an element) passed as a kept argument to a `spawn` factory is E3138.", "A generic type nested in itself through its own instances is E3184.", "A project is marked by `<name>.maxproj`, which replaces `build.maxon`; tasks live in `<name>.maxtasks`, and test files are `<name>.maxtest`, no longer `*.test.maxon`. `build.maxon` and `*.test.maxon` are no longer read.", "`maxon run <file>` is `maxon execute <file>`; `maxon run <task>` now runs a task from the `.maxtasks` file.", "Every command-line option is long-form, and the `-o`, `-t`, `--compiler`, `--version`, `-V`, `--help` and `-h` spellings are removed. An option given to a command that does not take it is refused, and so is a bad `--log=` value.", "`maxon test --filter=` may be repeated, and a pattern that matches no test ends the run.", "`Runtime.yield()` and `Runtime.processorCount()` are `Scheduler.yield()` and `Scheduler.processorCount()`.", "The trace-key recorder that was `Log` is `TraceCapture`, and `Log` is now a structured logger.", "Arguments to an `async` call or a service message, and the managed locals a closure captures, are moved; reading one afterwards is a compile error (E3102). The `let`-argument freeze and E3160 are gone.", "A bare type name with more than one visible declaration is an error (E3063) rather than a silent pick.", "A hidden type is hidden at every place a type can be named, along with its fields and methods (E3008).", "A function's parameter, return and `throws` types must be at least as visible as the function (E3167).", "A function that declares `throws` must be able to throw (E3168).", "Casting a literal to the type its destination already declares is an error (E3010).", "An array index must be the array's `ElementIndex` (a `String` index is refused), `count()` of an array is an `ElementIndex`, and several public stdlib aliases are merged into `ElementIndex`, `EntryCount`, `BytePos`, `Byte` and `NetworkPort`.", "An or-pattern binding is refused on any case that does not bind it (E3129).", "A typealias declared inside a type or extension is a nominal type, and a private ranged alias belongs to its file.", "A path holding a NUL names no file, and a NUL in a subprocess's program, argument, working directory, environment or redirect path refuses the spawn with `spawnFailed`; a host holding a NUL, or an empty host, is `resolveFailed`.", "E3099, E3105 and E3160 are removed.", "A `let` argument to a service message is lent rather than moved, and a write reaching a lent graph through another path is refused (E3160).", "A callee that writes a field of its parameter is refused at the call when the caller's binding is a `let`.", "A handler over a combined error that carries a boxed member must match the error exactly once (E3161).", "`HttpClient` refuses any scheme but `http` before it connects, with `HttpError.unsupportedScheme`; an `https` URL was sent as plaintext to port 80 before.", "A missing executable is `SubprocessError.executableNotFound` on every operating system, and a working directory that does not exist now fails the spawn where Linux ignored it.", "A build manifest's `debug_info` is honoured, a manifest build takes the tree lock and applies the same build-option refusals a command-line build does, and a malformed manifest field (a non-string `version` or source, a define with no `=`, a non-array `defines`) is refused.", "`optimize` in a build manifest is removed.", "Mutating a value that a live `let` can still observe is refused, however the value was reached (through a call's result, a closure, an interface method or a union payload as well as a direct field); a write through a method or a field that could reach such a record is E3159.", "The `--version` and `-V` flags are withdrawn in favour of `maxon version`, and the `--help` and `-h` flags in favour of `maxon help`.", "`Build.buildOne` in a build manifest is renamed `Build.build`.", "`maxon fmt` separates groups of declarations with one blank line at every nesting depth, so a file formatted by 0.1.0 is rewritten.", "On Linux and macOS, starting a program that cannot be found raises `SubprocessError.executableNotFound` instead of `spawnFailed`."]
export let BreakingChangeFixes = ["to feed a child after it prints a marker, run it as a `StreamingSubprocess`, read its stdout with `tryReadStdoutLine()` until the marker line, then `writeStdinLine(...)` and `closeStdin()`; where the child only needs to block on stdin, use `InputSource.hold`.", "group the arguments into a smaller number of types, such as a record type passed as one argument.", "cast the argument to the parameter type of the overload you want, such as `f(x as Integer)`.", "rename `Vector` to `FixedArray` and `VectorIter` to `FixedArrayIter`.", "drop the `try … otherwise` and write the call bare.", "widen the type to the binding's tier (`export enum Status`, `export typealias Small`, or `public` for a `public` binding), or narrow the binding (`let BIG` without `export`).", "widen the named type to the surface's tier (`export enum Mode`), or narrow the surface (drop the `export` from `export var mode as Mode`).", "correct the index, or pass a deliberate out-of-range index through a value computed at run time.", "drop the `try … otherwise` and write the divide bare.", "call `authorityHost()` where the brackets are wanted, such as building an authority or a `Host` header by hand; code that stripped the brackets itself can drop that step.", "add arms for `invalidBoolean` and `invalidString`.", "declare the method's return with the requirement's own typealias.", "declare the method with the type the requirement names, or rename the declared type.", "pass a value of the requirement's type, re-branding an instance with `as` (`xs as IntArray`).", "re-brand the result with `as`, or declare the destination with the requirement's typealias.", "convert the result with `as`, or declare the destination with the typealias the callee returns.", "convert the binding with `as`, or declare the parameter with the payload's typealias.", "bind it with `let`, or take a `.clone()` of the elements.", "pass a `clone()`.", "store a value of the element's own enum.", "re-brand the element with `as` (`[b as A]`).", "expect E3005 wherever a script or test matches the code.", "return what a library `pop`/`remove` takes out of the field, or have the declaration the call binds take that argument.", "call it through a typealias that names the instance (`typealias IntHolder = Holder with Integer`).", "pass a closure that calls it, `function(n) gives Ops.twice(n)`.", "call a static the type provides; expect E2073 wherever a script or test matches the code.", "read the member through the type that declares it; only a sized type has `.min` and `.max`.", "call the static on a concrete type that implements the interface.", "store the function value in a `var` or a `static var`.", "compute the value in a function, or write it as a literal.", "store a function whose parameters and result match the declared function type, or change the declared type.", "delete the character, or move it into a string literal or a comment.", "give the arguments types, or labels, that fit exactly one overload.", "cast the argument to the type the generic should take (`describe(5 as Other)`).", "drop the cast.", "hold a `.clone()` of the record, or a record of its own.", "declare the function with the function type's parameter and result types.", "write the closure where the function type is declared, or end its body in a cast to the result alias (`function(n Integer) gives (n + 1) as Byte`).", "call the value with the arguments of the type it is held at.", "add an arm for `tlsFailed`, and replace a comparison such as `e == HttpError.timedOut` with a `match` on `e` that names the case.", "a program that relied on the refusal checks the scheme itself before the call; one that now reaches a server over TLS handles `HttpError.tlsFailed`, and passes `tls:` to `HttpClient.send` to trust its own roots.", "rename one of the two members, or declare it in one extension and name it from the other.", "rename one of the two members, or delete the declaration that is not meant.", "rename the extension's member, or delete it and use the type's own.", "write the extension bodies for the member the program declares, or rename it to keep the library's.", "handle handshake errors where the stream is first used, or call `handshake()` right after `accept()`.", "call the four with `try`, after `handshake()` on a stream from `accept()`; add an arm for `handshakePending`.", "keep what connections share, or what the caller reads after `serve`, in a service the handler holds a handle to (`CountingHandler.create(visits.clone())`), declare the handler's fields `let`, and build the handler where `serve` is called.", "cast directly to the final type (`x as B`), or, when both steps do work (a range check, then a reinterpretation as `bits(n)`), bind the first: `let a = x as A`, then `a as B`.", "cast one side with `as` (`a + (b as Small)`).", "cast with `as` where the other typealias is required (`f(s as Tally)`), and drop a cast to the typealias the constant already carries.", "write the bare literal (`let Base = 2`).", "call it on a value (`m.bump()`) or pass the receiver explicitly (`Maker.bump(m)`).", "write `Box.getValue()`, qualified by the type's name, where the static method is meant.", "read the union with `match`, or its tag with `.ordinal` or `.rawValue`; declare an `enum` where the values are meant to be numbers.", "rename `deadlineMs:` to `dialDeadlineMs:` at each `TlsClient.connect` call, and call `options.setHandshakeDeadline(...)` where the old `deadlineMs` also had to bound the handshake (`0` waits without a limit).", "`await` the promise and send, return or pass the result it yields.", "pass `binding.clone()` to keep reading the binding, and `.clone()` a borrowed argument; keep the value in a field of the service and reach it through a message; break the await cycle as E3139's entry describes; spawn from a function of a concrete type.", "store the parameter once, outside any loop, and hand the closure the value as a parameter.", "write `OrderedWord` wherever `ByteWord` appeared.", "declare the alias once and share it, or cast the value across (`x as Name`).", "qualify the name as the message lists (`dir.Name`, `export.Name`, `stdlib.Name`), or rename one declaration.", "give the alias a visibility modifier (`module`, `export` or `public`).", "raise the type to the function's visibility, or narrow the function to the type's.", "use the result, or remove the call.", "rename the declaration.", "add a `<name>.maxproj` file at the project root (`maxon init` writes one).", "use `Count`.", "declare `equals` on the type.", "bind the value with `var`, or write through a `clone()`.", "`await` the promise and copy the value it holds; pass a `spawn` factory a fresh value or a `clone()`.", "declare the field over the type's own parameters (`Nest with T`), or remove the recursion.", "rename `build.maxon` to `<name>.maxproj` (its targets are the exported functions of no parameters returning `ExitCode`, run with `maxon build <target>`), move task functions into `<name>.maxtasks`, and rename each `*.test.maxon` to `*.maxtest`.", "replace `maxon run <file>` with `maxon execute <file>` in scripts and CI. `maxon <file>.maxon` and `#!/usr/bin/env maxon` are unchanged.", "use `--output=` for `-o` and `--filter=` for `-t`, `maxon version` for `--version`, and `maxon help [<command>]` for `--help`, and drop `--compiler=` from `spec-test` command lines (it compiles every case in its own process). `maxon help <command>` lists the options a command takes.", "remove or correct the pattern that matches nothing.", "rename the calls.", "call `TraceCapture.trace`, `startCapture`, `stopCapture` and `fired` where the program called the same functions on `Log`.", "send or capture a `clone()` when the program still needs the value, or stop reading it after the send.", "qualify it with its directory, `stdlib.` or `export.`, or rename one declaration.", "export the declaration, or reach it through an exported function or interface.", "raise the 