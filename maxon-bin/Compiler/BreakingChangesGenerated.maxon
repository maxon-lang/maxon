// @generated by website/scripts/sync-docs.mjs from RELEASE_NOTES.md (its release headings and the "Breaking changes" entries under them); edit that document and run the script, never this file
export let UnreleasedVersion = "Unreleased"
export let ReleasedVersions = ["0.5.0", "0.4.0", "0.3.1", "0.3.0", "0.2.2", "0.2.1", "0.2.0", "0.1.1", "0.1.0"]
export let BreakingChangeVersions = ["Unreleased", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.2.0", "0.1.1", "0.1.1", "0.1.1", "0.1.1"]
export let BreakingChangeDescriptions = ["Passing a `let` to a function whose result holds a closure capturing that parameter — in a container, a record or bare — is E3078, also when the result is bound by a `let` and the closure only reads.", "A typealias's identity is its declaration rather than its spelling: two declarations of one name are two types even over the same range, and a value crossing between them is refused.", "A bare type name that reaches more than one visible declaration is E3063 in every file, including a file that declares one of them.", "A typealias declared inside a type is private to its file unless it carries its own visibility modifier, and naming a file-private one from another file, bare or qualified, is E3008.", "E3167 checks every type a signature names, an interface's requirements and the types a named alias reaches included, so a signature that was accepted can be refused.", "Discarding the result of a pure function (E3064) is refused in more programs: a function that writes only into values it created, one that calls a closure it can name, a search through a container's `withIterator()`, and a `Map` or `Set` lookup.", "A program that declares `BuiltinStringLiteral`, `BuiltinCharLiteral` or `BuiltinArrayLiteral` is refused (E2015).", "Only a `.maxproj` marks a project for the language server; a file with no `.maxproj` above it is checked alone against the standard library, and nothing else of its directory is loaded for it.", "`Utf8ByteCount`, `CodepointCount` and `Utf16UnitCount` are removed.", "`==` on two values of a generic type calls the type's `equals`, and is E3005 when the type declares none.", "Writing through a module `let`'s record handed back by a function, and copying a `let`'s field into a `var`, are refused (E3159, E3078).", "A copy that reaches a promise (a `List.clone`, or a generic type copying an array of promises) is E3141, and a borrowed argument (a parameter, a field, an element) passed as a kept argument to a `spawn` factory is E3138.", "A generic type nested in itself through its own instances is E3184.", "A project is marked by `<name>.maxproj`, which replaces `build.maxon`; tasks live in `<name>.maxtasks`, and test files are `<name>.maxtest`, no longer `*.test.maxon`. `build.maxon` and `*.test.maxon` are no longer read.", "`maxon run <file>` is `maxon execute <file>`; `maxon run <task>` now runs a task from the `.maxtasks` file.", "Every command-line option is long-form, and the `-o`, `-t`, `--compiler`, `--version`, `-V`, `--help` and `-h` spellings are removed. An option given to a command that does not take it is refused, and so is a bad `--log=` value.", "`maxon test --filter=` may be repeated, and a pattern that matches no test ends the run.", "`Runtime.yield()` and `Runtime.processorCount()` are `Scheduler.yield()` and `Scheduler.processorCount()`.", "The trace-key recorder that was `Log` is `TraceCapture`, and `Log` is now a structured logger.", "Arguments to an `async` call or a service message, and the managed locals a closure captures, are moved; reading one afterwards is a compile error (E3102). The `let`-argument freeze and E3160 are gone.", "A bare type name with more than one visible declaration is an error (E3063) rather than a silent pick.", "A hidden type is hidden at every place a type can be named, along with its fields and methods (E3008).", "A function's parameter, return and `throws` types must be at least as visible as the function (E3167).", "A function that declares `throws` must be able to throw (E3168).", "Casting a literal to the type its destination already declares is an error (E3010).", "An array index must be the array's `ElementIndex` (a `String` index is refused), `count()` of an array is an `ElementIndex`, and several public stdlib aliases are merged into `ElementIndex`, `EntryCount`, `BytePos`, `Byte` and `NetworkPort`.", "An or-pattern binding is refused on any case that does not bind it (E3129).", "A typealias declared inside a type or extension is a nominal type, and a private ranged alias belongs to its file.", "A path holding a NUL names no file, and a NUL in a subprocess's program, argument, working directory, environment or redirect path refuses the spawn with `spawnFailed`; a host holding a NUL, or an empty host, is `resolveFailed`.", "E3099, E3105 and E3160 are removed.", "A `let` argument to a service message is lent rather than moved, and a write reaching a lent graph through another path is refused (E3160).", "A callee that writes a field of its parameter is refused at the call when the caller's binding is a `let`.", "A handler over a combined error that carries a boxed member must match the error exactly once (E3161).", "`HttpClient` refuses any scheme but `http` before it connects, with `HttpError.unsupportedScheme`; an `https` URL was sent as plaintext to port 80 before.", "A missing executable is `SubprocessError.executableNotFound` on every operating system, and a working directory that does not exist now fails the spawn where Linux ignored it.", "A build manifest's `debug_info` is honoured, a manifest build takes the tree lock and applies the same build-option refusals a command-line build does, and a malformed manifest field (a non-string `version` or source, a define with no `=`, a non-array `defines`) is refused.", "`optimize` in a build manifest is removed.", "Mutating a value that a live `let` can still observe is refused, however the value was reached (through a call's result, a closure, an interface method or a union payload as well as a direct field); a write through a method or a field that could reach such a record is E3159.", "The `--version` and `-V` flags are withdrawn in favour of `maxon version`, and the `--help` and `-h` flags in favour of `maxon help`.", "`Build.buildOne` in a build manifest is renamed `Build.build`.", "`maxon fmt` separates groups of declarations with one blank line at every nesting depth, so a file formatted by 0.1.0 is rewritten.", "On Linux and macOS, starting a program that cannot be found raises `SubprocessError.executableNotFound` instead of `spawnFailed`."]
export let BreakingChangeFixes = ["pass a `clone()`.", "declare the alias once and share it, or cast the value across (`x as Name`).", "qualify the name as the message lists (`dir.Name`, `export.Name`, `stdlib.Name`), or rename one declaration.", "give the alias a visibility modifier (`module`, `export` or `public`).", "raise the type to the function's visibility, or narrow the function to the type's.", "use the result, or remove the call.", "rename the declaration.", "add a `<name>.maxproj` file at the project root (`maxon init` writes one).", "use `Count`.", "declare `equals` on the type.", "bind the value with `var`, or write through a `clone()`.", "`await` the promise and copy the value it holds; pass a `spawn` factory a fresh value or a `clone()`.", "declare the field over the type's own parameters (`Nest with T`), or remove the recursion.", "rename `build.maxon` to `<name>.maxproj` (its targets are the exported functions of no parameters returning `ExitCode`, run with `maxon build <target>`), move task functions into `<name>.maxtasks`, and rename each `*.test.maxon` to `*.maxtest`.", "replace `maxon run <file>` with `maxon execute <file>` in scripts and CI. `maxon <file>.maxon` and `#!/usr/bin/env maxon` are unchanged.", "use `--output=` for `-o` and `--filter=` for `-t`, `maxon version` for `--version`, and `maxon help [<command>]` for `--help`, and drop `--compiler=` from `spec-test` command lines (it compiles every case in its own process). `maxon help <command>` lists the options a command takes.", "remove or correct the pattern that matches nothing.", "rename the calls.", "call `TraceCapture.trace`, `startCapture`, `stopCapture` and `fired` where the program called the same functions on `Log`.", "send or capture a `clone()` when the program still needs the value, or stop reading it after the send.", "qualify it with its directory, `stdlib.` or `export.`, or rename one declaration.", "export the declaration, or reach it through an exported function or interface.", "raise the type to the function's visibility, or narrow the function to the type's.", "remove the `throws` clause, or throw from the body.", "remove the cast.", "index with an `ElementIndex` (cast with `as ElementIndex`), read a string through its views (`bytes()`, `codepoints()`, `utf16()`), and use the merged alias names.", "give the case that disagrees its own arm, or rename the colliding binding.", "cast values between the alias and another type (`x as Name`), and give an alias that other files use a visibility modifier.", "do not pass NUL or empty strings; handle `spawnFailed` and `resolveFailed`.", "delete any reference to these codes from scripts, tests and documentation that match on them.", "write through a `clone()`, or send a `var`, a temporary or a literal, which still move. (0.4.0 replaces lending with moves for every argument.)", "declare the caller's binding `var`, or pass a `clone()`.", "match the error once and bind in its arms whatever the rest of the handler needs.", "use an `http` URL (the client has no TLS), and handle `unsupportedScheme`.", "handle `executableNotFound` where the program handled `spawnFailed` for a missing program, and pass an existing working directory or none.", "correct the field the error names (`sources` and `defines` are lists of strings, a define is `name=value`, `version` is a dotted string), and set `debug_info` to what the build should have; see Describing a build in the CLI reference.", "delete it.", "bind the value with `var`, or write to a `clone()`.", "run `maxon version` and `maxon help [<command>]`.", "call `Build.build` with the same arguments.", "run `maxon fmt` over the project and keep the result.", "handle `executableNotFound` where the program handled `spawnFailed` for a missing program."]
