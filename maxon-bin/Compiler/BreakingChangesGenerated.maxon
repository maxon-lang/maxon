// @generated by website/scripts/sync-docs.mjs from RELEASE_NOTES.md (its release headings and the "Breaking changes" entries under them); edit that document and run the script, never this file
export let UnreleasedVersion = "Unreleased"
export let ReleasedVersions = ["0.5.0", "0.4.0", "0.3.1", "0.3.0", "0.2.2", "0.2.1", "0.2.0", "0.1.1", "0.1.0"]
export let BreakingChangeVersions = ["Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "Unreleased", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.5.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.4.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.3.0", "0.2.0", "0.1.1", "0.1.1", "0.1.1", "0.1.1"]
export let BreakingChangeDescriptions = ["`DerError` has two more cases, `invalidBoolean` and `invalidString`, so a `match` over it that lists every case is no longer exhaustive.", "An interface requirement returning one typealias of a generic instance is not met by a method returning another typealias of that instance (E3016), as a parameter already was not.", "A declared type named like a generic instance (`type Array_Byte`) and the instance itself (`ByteArray`) no longer meet each other's interface requirements (E3016).", "An argument passed through an interface value or a `where` constraint is checked against the requirement's declared type as a direct call's is: a value of another generic instance, of another typealias of the same instance, or a non-`Character`/`CString` value for a `Character` or `CString` parameter is E3005.", "The result of a call through an interface keeps the requirement's typealias, so passing it where another typealias of the same instance is expected is E3005.", "A call's result wears the typealias its callee returns as the callee's declaring file resolves it, a directory-qualified `returns alpha.Numbers` included, so passing it where another declaration of that alias name is expected is E3005.", "A `match` payload binding wears the typealias its payload was declared with, as the union's declaring file resolves it, so passing it where another typealias of the same instance is expected is E3005.", "A tuple holding a value read out of a `let` field, a `let` payload or a read-only element is read-only wherever it goes, a tuple a call returns included. Binding it, or one of its read-only elements, to a `var`, assigning it to existing `var` names, storing it into a `var` field or an array, or passing it to a function that writes it is E3078 (E3159 for the call); each of these compiled before.", "Passing a `let` to a function whose result holds a closure capturing that parameter — in a container, a record or bare — is E3078, also when the result is bound by a `let` and the closure only reads.", "An element of another enum stored into an array by `push`, `set`, `insert` or `fill`, or written in an array literal, is refused (E3005).", "An array-literal element of another brand is refused (E3005), as `push` refuses one: a `B` value in a `[...]` written at an `Array with A` slot.", "An array-literal element of another type is E3005, where it was E2015.", "A member of your own type named `pop`, `remove`, `removeFirst` or `removeLast` that hands back a promise is judged by its body, and one that returns a borrow (`self.items.last()`) is E3141; so is a generic static that hands back a promise one of its arguments still holds.", "A static called on a bare generic name whose result is written over a type parameter no argument fixes (`Holder.make()` declared `returns T`) is E3162.", "`Type.method` written without its call — a static or instance method, a static the compiler provides (`int.fromString`), or a requirement through a type parameter — is E2078, where it was E2010, E2004 or, at module scope, E2015.", "A static a primitive (`int.nope()`, `byte.nope()`), a compiler-owned type (`String`, `__ManagedFile`) or a builtin container alias does not have is E2073, reported at the member, where it was E2015, or E3004 for `byte`.", "A member read through a ranged, function or tuple alias, an interface, a type parameter or a directory that does not declare it is E2073, where it was E2010 (`Expected 'min or max'`).", "A `static` requirement called through a type parameter (`T.make()`) is E3116, where it was E3004.", "Assigning to a method (`Ops.twice = f`) is E2013, where it was E2004.", "A primitive's static called in a module-level initializer (`let n = int.fromString(\"5\")`) is E2015, where it was E2004.", "A function whose shape differs from the declared function type, stored into a field (`h.op = f`, `self.op = f`, a struct literal), a tuple element (`t.0 = f`) or an array element (`push`, `set`, a typed array literal), is E3005.", "A `?`, `;`, `|`, `&`, `$`, `%`, `~`, `^`, backtick, control character or non-ASCII character outside a string literal or a comment is E1010 (`Unexpected character`); the lexer skipped it before.", "A `spawn` of an overloaded factory and an `async` call of an overloaded function bind the overload their arguments fit, as any call does: two overloads that fit equally are E3007, and the bound overload alone decides which arguments move (a promise included) and which type arguments a generic factory fixes.", "Beside a generic function of the same name, a non-generic overload binds a literal, a negated literal, a loop counter or a value computed from them that lies inside its parameter's alias, and the generic binds one known to leave it.", "A literal cast to the alias of the non-generic overload it already binds (`describe(5 as Score)` beside a generic `describe`) is E3010.", "A fresh tuple or record that holds a record a `var` of the function, or a module `var`, may still write is E3078 when it is stored into a `let` field, a `let` payload or a `readonly` element, or passed to a parameter that stores it there (`Frozen.create((Box.create(1), id(p)))` with `p` a `var` written later); it compiled before, with the `let` field's contents writable through `p`. A `let` bound to a fresh tuple or record holding a module `var`'s record that is written later is E3188 (`let t = (Box.create(1), gBox)`).", "A function value fits a function type only by variance: a read-only parameter may be wider than the type's, a parameter the program writes by reference must be the same type, and a result may be narrower. A function whose read-only parameter is narrower, whose written parameter differs, or whose result is wider than the function type it is stored or passed as — a ranged alias, or a bare `int` in the type's declaration, against a function over a narrower alias — is E3005, or E3009 as an `as` cast.", "A closure literal bound by `let` or `var`, or written where no function type is declared, has an unranged result, so it no longer fits a function type declaring a ranged result (E3005); a closure written at a parameter, returned value, struct field, field write, variable write or union payload of a function type takes that type's parameter and result types, as it did at a parameter.", "A call through a function value is checked against the function type the value is held at, not against the function behind it: after `let f = one as Bin`, `f(3)` against a two-parameter `Bin` is E3036 beside the cast's E3009, where only the E3009 was reported.", "`HttpError` and `HttpServerError` are unions, each with a new case `tlsFailed(error TlsError)`, so a `match` over either that lists every case is no longer exhaustive, and `==` or `!=` on one is E3066.", "`HttpClient` fetches an `https` URL over TLS, on port 443 unless the URL names one, where it threw `HttpError.unsupportedScheme`; the error is now thrown only for a scheme that is neither `http` nor `https`.", "A typealias's identity is its declaration rather than its spelling: two declarations of one name are two types even over the same range, and a value crossing between them is refused.", "A bare type name that reaches more than one visible declaration is E3063 in every file, including a file that declares one of them.", "A typealias declared inside a type is private to its file unless it carries its own visibility modifier, and naming a file-private one from another file, bare or qualified, is E3008.", "E3167 checks every type a signature names, an interface's requirements and the types a named alias reaches included, so a signature that was accepted can be refused.", "Discarding the result of a pure function (E3064) is refused in more programs: a function that writes only into values it created, one that calls a closure it can name, a search through a container's `withIterator()`, and a `Map` or `Set` lookup.", "A program that declares `BuiltinStringLiteral`, `BuiltinCharLiteral` or `BuiltinArrayLiteral` is refused (E2015).", "Only a `.maxproj` marks a project for the language server; a file with no `.maxproj` above it is checked alone against the standard library, and nothing else of its directory is loaded for it.", "`Utf8ByteCount`, `CodepointCount` and `Utf16UnitCount` are removed.", "`==` on two values of a generic type calls the type's `equals`, and is E3005 when the type declares none.", "Writing through a module `let`'s record handed back by a function, and copying a `let`'s field into a `var`, are refused (E3159, E3078).", "A copy that reaches a promise (a `List.clone`, or a generic type copying an array of promises) is E3141, and a borrowed argument (a parameter, a field, an element) passed as a kept argument to a `spawn` factory is E3138.", "A generic type nested in itself through its own instances is E3184.", "A project is marked by `<name>.maxproj`, which replaces `build.maxon`; tasks live in `<name>.maxtasks`, and test files are `<name>.maxtest`, no longer `*.test.maxon`. `build.maxon` and `*.test.maxon` are no longer read.", "`maxon run <file>` is `maxon execute <file>`; `maxon run <task>` now runs a task from the `.maxtasks` file.", "Every command-line option is long-form, and the `-o`, `-t`, `--compiler`, `--version`, `-V`, `--help` and `-h` spellings are removed. An option given to a command that does not take it is refused, and so is a bad `--log=` value.", "`maxon test --filter=` may be repeated, and a pattern that matches no test ends the run.", "`Runtime.yield()` and `Runtime.processorCount()` are `Scheduler.yield()` and `Scheduler.processorCount()`.", "The trace-key recorder that was `Log` is `TraceCapture`, and `Log` is now a structured logger.", "Arguments to an `async` call or a service message, and the managed locals a closure captures, are moved; reading one afterwards is a compile error (E3102). The `let`-argument freeze and E3160 are gone.", "A bare type name with more than one visible declaration is an error (E3063) rather than a silent pick.", "A hidden type is hidden at every place a type can be named, along with its fields and methods (E3008).", "A function's parameter, return and `throws` types must be at least as visible as the function (E3167).", "A function that declares `throws` must be able to throw (E3168).", "Casting a literal to the type its destination already declares is an error (E3010).", "An array index must be the array's `ElementIndex` (a `String` index is refused), `count()` of an array is an `ElementIndex`, and several public stdlib aliases are merged into `ElementIndex`, `EntryCount`, `BytePos`, `Byte` and `NetworkPort`.", "An or-pattern binding is refused on any case that does not bind it (E3129).", "A typealias declared inside a type or extension is a nominal type, and a private ranged alias belongs to its file.", "A path holding a NUL names no file, and a NUL in a subprocess's program, argument, working directory, environment or redirect path refuses the spawn with `spawnFailed`; a host holding a NUL, or an empty host, is `resolveFailed`.", "E3099, E3105 and E3160 are removed.", "A `let` argument to a service message is lent rather than moved, and a write reaching a lent graph through another path is refused (E3160).", "A callee that writes a field of its parameter is refused at the call when the caller's binding is a `let`.", "A handler over a combined error that carries a boxed member must match the error exactly once (E3161).", "`HttpClient` refuses any scheme but `http` before it connects, with `HttpError.unsupportedScheme`; an `https` URL was sent as plaintext to port 80 before.", "A missing executable is `SubprocessError.executableNotFound` on every operating system, and a working directory that does not exist now fails the spawn where Linux ignored it.", "A build manifest's `debug_info` is honoured, a manifest build takes the tree lock and applies the same build-option refusals a command-line build does, and a malformed manifest field (a non-string `version` or source, a define with no `=`, a non-array `defines`) is refused.", "`optimize` in a build manifest is removed.", "Mutating a value that a live `let` can still observe is refused, however the value was reached (through a call's result, a closure, an interface method or a union payload as well as a direct field); a write through a method or a field that could reach such a record is E3159.", "The `--version` and `-V` flags are withdrawn in favour of `maxon version`, and the `--help` and `-h` flags in favour of `maxon help`.", "`Build.buildOne` in a build manifest is renamed `Build.build`.", "`maxon fmt` separates groups of declarations with one blank line at every nesting depth, so a file formatted by 0.1.0 is rewritten.", "On Linux and macOS, starting a program that cannot be found raises `SubprocessError.executableNotFound` instead of `spawnFailed`."]
export let BreakingChangeFixes = ["add arms for `invalidBoolean` and `invalidString`.", "declare the method's return with the requirement's own typealias.", "declare the method with the type the requirement names, or rename the declared type.", "pass a value of the requirement's type, re-branding an instance with `as` (`xs as IntArray`).", "re-brand the result with `as`, or declare the destination with the requirement's typealias.", "convert the result with `as`, or declare the destination with the typealias the callee returns.", "convert the binding with `as`, or declare the parameter with the payload's typealias.", "bind it with `let`, or take a `.clone()` of the elements.", "pass a `clone()`.", "store a value of the element's own enum.", "re-brand the element with `as` (`[b as A]`).", "expect E3005 wherever a script or test matches the code.", "return what a library `pop`/`remove` takes out of the field, or have the declaration the call binds take that argument.", "call it through a typealias that names the instance (`typealias IntHolder = Holder with Integer`).", "pass a closure that calls it, `function(n) gives Ops.twice(n)`.", "call a static the type provides; expect E2073 wherever a script or test matches the code.", "read the member through the type that declares it; only a sized type has `.min` and `.max`.", "call the static on a concrete type that implements the interface.", "store the function value in a `var` or a `static var`.", "compute the value in a function, or write it as a literal.", "store a function whose parameters and result match the declared function type, or change the declared type.", "delete the character, or move it into a string literal or a comment.", "give the arguments types, or labels, that fit exactly one overload.", "cast the argument to the type the generic should take (`describe(5 as Other)`).", "drop the cast.", "hold a `.clone()` of the record, or a record of its own.", "declare the function with the function type's parameter and result types.", "write the closure where the function type is declared, or end its body in a cast to the result alias (`function(n Integer) gives (n + 1) as Byte`).", "call the value with the arguments of the type it is held at.", "add an arm for `tlsFailed`, and replace a comparison such as `e == HttpError.timedOut` with a `match` on `e` that names the case.", "a program that relied on the refusal checks the scheme itself before the call; one that now reaches a server over TLS handles `HttpError.tlsFailed`, and passes `tls:` to `HttpClient.send` to trust its own roots.", "declare the alias once and share it, or cast the value across (`x as Name`).", "qualify the name as the message lists (`dir.Name`, `export.Name`, `stdlib.Name`), or rename one declaration.", "give the alias a visibility modifier (`module`, `export` or `public`).", "raise the type to the function's visibility, or narrow the function to the type's.", "use the result, or remove the call.", "rename the declaration.", "add a `<name>.maxproj` file at the project root (`maxon init` writes one).", "use `Count`.", "declare `equals` on the type.", "bind the value with `var`, or write through a `clone()`.", "`await` the promise and copy the value it holds; pass a `spawn` factory a fresh value or a `clone()`.", "declare the field over the type's own parameters (`Nest with T`), or remove the recursion.", "rename `build.maxon` to `<name>.maxproj` (its targets are the exported functions of no parameters returning `ExitCode`, run with `maxon build <target>`), move task functions into `<name>.maxtasks`, and rename each `*.test.maxon` to `*.maxtest`.", "replace `maxon run <file>` with `maxon execute <file>` in scripts and CI. `maxon <file>.maxon` and `#!/usr/bin/env maxon` are unchanged.", "use `--output=` for `-o` and `--filter=` for `-t`, `maxon version` for `--version`, and `maxon help [<command>]` for `--help`, and drop `--compiler=` from `spec-test` command lines (it compiles every case in its own process). `maxon help <command>` lists the options a command takes.", "remove or correct the pattern that matches nothing.", "rename the calls.", "call `TraceCapture.trace`, `startCapture`, `stopCapture` and `fired` where the program called the same functions on `Log`.", "send or capture a `clone()` when the program still needs the value, or stop reading it after the send.", "qualify it with its directory, `stdlib.` or `export.`, or rename one declaration.", "export the declaration, or reach it through an exported function or interface.", "raise the type to the function's visibility, or narrow the function to the type's.", "remove the `throws` clause, or throw from the body.", "remove the cast.", "index with an `ElementIndex` (cast with `as ElementIndex`), read a string through its views (`bytes()`, `codepoints()`, `utf16()`), and use the merged alias names.", "give the case that disagrees its own arm, or rename the colliding binding.", "cast values between the alias and another type (`x as Name`), and give an alias that other files use a visibility modifier.", "do not pass NUL or empty strings; handle `spawnFailed` and `resolveFailed`.", "delete any reference to these codes from scripts, tests and documentation that match on them.", "write through a `clone()`, or send a `var`, a temporary or a literal, which still move. (0.4.0 replaces lending with moves for every argument.)", "declare the caller's binding `var`, or pass a `clone()`.", "match the error once and bind in its arms whatever the rest of the handler needs.", "use an `http` URL (the client has no TLS), and handle `unsupportedScheme`.", "handle `executableNotFound` where the program handled `spawnFailed` for a missing program, and pass an existing working directory or none.", "correct the field the error names (`sources` and `defines` are lists of strings, a define is `name=value`, `version` is a dotted string), and set `debug_info` to what the build should have; see Describing a build in the CLI reference.", "delete it.", "bind the value with `var`, or write to a `clone()`.", "run `maxon version` and `maxon help [<command>]`.", "call `Build.build` with the same arguments.", "run `maxon fmt` over the project and keep the result.", "handle `executableNotFound` where the program handled `spawnFailed` for a missing program."]
