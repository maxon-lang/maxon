typealias CandidateIndexArray = Array with ElementIndex
typealias CandidateAdjacency = Array with CandidateIndexArray
typealias CandidateIndexByLineMap = Map with (LineNumber, CandidateIndexArray)
typealias CandidateIndexByNameMap = Map with (ByteArray, CandidateIndexArray)
typealias CandidateIndexByTokenMap = Map with (ElementIndex, ElementIndex)
typealias CandidateNameMap = Map with (ElementIndex, immutable ByteArray)
typealias CandidateLimitMap = Map with (ElementIndex, ElementIndex)
typealias SpellingCount = int(0 to u64.max)
typealias SpellingCountMap = Map with (ByteArray, SpellingCount)
typealias WatchedNameSet = Set with ByteArray
typealias AuditedPathSet = Set with String
typealias FilePrivateCandidateArray = Array with FilePrivateCandidate
typealias CandidatesByFileMap = Map with (String, FilePrivateCandidateArray)
typealias KnownPositionSet = Set with String

// How far a declaration's own text reaches: a function, type, enum, union or interface runs to its closing
// `end`, labelled or not; a constant to the end of its initializer. A name spelled inside the extent is a use BY
// that declaration, which counts only while the declaration is live.
union CandidateExtent
	untilDeclarationEnd
	initializer(limit ElementIndex)
end 'CandidateExtent'

union ExtentOwner
	none
	candidate(index ElementIndex)
end 'ExtentOwner'

type FilePrivateCandidate
	export let noun as String
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export let extent as CandidateExtent

	static function create(noun String, nameLine LineNumber, nameColumn ColumnNumber, extent CandidateExtent) returns FilePrivateCandidate
		return Self{noun: noun, nameLine: nameLine, nameColumn: nameColumn, extent: extent}
	end 'create'
end 'FilePrivateCandidate'

type CandidatePool
	export let byFile as CandidatesByFileMap
	export let auditedPaths as AuditedPathSet
	export let known as KnownPositionSet

	static function create(auditedPaths AuditedPathSet) returns CandidatePool
		return Self{byFile: CandidatesByFileMap.create(), auditedPaths: auditedPaths, known: KnownPositionSet.create()}
	end 'create'

	function add(path FilePath, candidate FilePrivateCandidate)
		let key = path.toString()

		if not self.auditedPaths.contains(key) 'notAudited'
			return
		end 'notAudited'

		let position = "{key}:{candidate.nameLine}:{candidate.nameColumn}"

		if self.known.contains(position) 'theSameDeclaration'
			return
		end 'theSameDeclaration'

		self.known.insert(position)
		var inFile = try self.byFile.get(key) otherwise FilePrivateCandidateArray.create(0)
		inFile.push(candidate)
		self.byFile.upsert(key, value: inFile)
	end 'add'
end 'CandidatePool'

type LocatedDeclarations
	export let declarationAt as CandidateIndexByTokenMap
	export let candidatesNamed as CandidateIndexByNameMap
	export let names as CandidateNameMap
	export let limits as CandidateLimitMap

	static function create(declarationAt CandidateIndexByTokenMap, candidatesNamed CandidateIndexByNameMap, names CandidateNameMap, limits CandidateLimitMap) returns LocatedDeclarations
		return Self{declarationAt: declarationAt, candidatesNamed: candidatesNamed, names: names, limits: limits}
	end 'create'

	function nameOf(index ElementIndex) returns immutable ByteArray
		return try self.names.get(index) otherwise panic("LocatedDeclarations.nameOf: candidate {index} has no located name — locateDeclarations names every candidate")
	end 'nameOf'

	function ownerAt(owner ExtentOwner, at ElementIndex) returns ExtentOwner
		match owner 'who'
			none then return owner
			candidate(index) then return ExtentOwner.none if at >= self.limitOf(index) else owner
		end 'who'
	end 'ownerAt'

	function limitOf(index ElementIndex) returns ElementIndex
		return try self.limits.get(index) otherwise panic("LocatedDeclarations.limitOf: candidate {index} has no extent limit — locateDeclarations bounds every candidate")
	end 'limitOf'
end 'LocatedDeclarations'

type UsageGraph
	export let live as BoolArray
	export let usesOf as CandidateAdjacency

	static function create(count ElementIndex) returns UsageGraph
		var usesOf = CandidateAdjacency.create(count, zeroed: false)

		for _ in 0 upto count 'eachCandidate'
			usesOf.push(CandidateIndexArray.create(0))
		end 'eachCandidate'

		return Self{live: BoolArray.create(count), usesOf: usesOf}
	end 'create'

	function isLive(index ElementIndex) returns bool
		return try self.live.get(index) otherwise panic("UsageGraph.isLive: candidate {index} is outside the {self.live.count()} the graph was made for")
	end 'isLive'

	function markLive(index ElementIndex)
		try self.live.set(index, value: true) otherwise panic("UsageGraph.markLive: candidate {index} is outside the {self.live.count()} the graph was made for")
	end 'markLive'

	function recordUse(owner ExtentOwner, target ElementIndex)
		match owner 'who'
			none then self.markLive(target)
			candidate(user) then self.addEdge(user, target: target)
		end 'who'
	end 'recordUse'

	function addEdge(user ElementIndex, target ElementIndex)
		let targets = self.usesBy(user)
		targets.push(target)
	end 'addEdge'

	function usesBy(user ElementIndex) returns CandidateIndexArray
		return try self.usesOf.get(user) otherwise panic("UsageGraph.usesBy: candidate {user} is outside the {self.usesOf.count()} the graph was made for")
	end 'usesBy'

	// Every candidate is queued once, when it first becomes live, so each edge is read once however the
	// declarations are ordered in the file.
	function propagate()
		var followed = CandidateIndexArray.create(0)

		for index in 0 upto self.live.count() 'eachCandidate'
			if self.isLive(index) 'aSeed'
				followed.push(index)
			end 'aSeed'
		end 'eachCandidate'

		var next = 0 as ElementIndex

		while next < followed.count() 'untilEveryLiveCandidateIsFollowed'
			let user = try followed.get(next) otherwise panic("UsageGraph.propagate: queue position {next} is outside the {followed.count()} reached")
			next = next + 1

			for target in self.usesBy(user) 'eachUse'
				if not self.isLive(target) 'newlyReached'
					self.markLive(target)
					followed.push(target)
				end 'newlyReached'
			end 'eachUse'
		end 'untilEveryLiveCandidateIsFollowed'
	end 'propagate'
end 'UsageGraph'

// Reports each file-private top-level declaration nothing live in its file names. Liveness is decided per
// file over its active tokens: a name spelled outside every candidate's extent makes the candidate live, a
// name spelled inside one is an edge from that candidate, and `propagate` follows the edges from the live
// set. It waits for a program with no other error because a refused use would hide its reader.
module function checkUnusedFilePrivate(project Project, module MaxonModule, signatures ProgramSignatures) throws CompileError
	if projectHasErrors(project) 'aRefusedUseHidesAReader'
		return
	end 'aRefusedUseHidesAReader'

	let sources = splitSourcePaths(project)
	var auditedFiles = FilePathArray.create(0)
	var auditedPaths = AuditedPathSet.create()

	for path in sources.userFiles 'eachUserFile'
		auditedFiles.push(path)
		auditedPaths.insert(path.toString())
	end 'eachUserFile'

	if project.stdlibBodies == LibraryBodies.every 'theLibraryIsTheSubject'
		for path in sources.stdlibFiles 'eachLibraryFile'
			auditedFiles.push(path)
			auditedPaths.insert(path.toString())
		end 'eachLibraryFile'
	end 'theLibraryIsTheSubject'

	let entryPoints = try entryPointNamesOf(project, userFiles: sources.userFiles)
	let pool = CandidatePool.create(auditedPaths)
	gatherFunctionCandidates(module, signatures: signatures, entryPoints: entryPoints, pool: pool)
	gatherTemplateCandidates(signatures, pool: pool)
	gatherConstantCandidates(signatures, pool: pool)
	try gatherTypeCandidates(project, signatures: signatures, files: auditedFiles, pool: pool)

	for path in auditedFiles 'eachAuditedFile'
		let inFile = try pool.byFile.get(path.toString()) otherwise continue
		try requireStillWanted(project)
		try auditFile(project, signatures: signatures, path: path, candidates: inFile)
	end 'eachAuditedFile'
end 'checkUnusedFilePrivate'

function gatherFunctionCandidates(module MaxonModule, signatures ProgramSignatures, entryPoints EntryPointNameSet, pool CandidatePool)
	for func in module.functions 'eachFunc'
		if func.visibility != Visibility.file or func.isCompilerBuilt() 'notAnAuthorsFilePrivateFunction'
			continue
		end 'notAnAuthorsFilePrivateFunction'

		if entryPoints.contains(func.name) or isTestFunctionName(func.name) or isSynthesizedName(signatures, name: func.name) or signatures.isGenericInstanceName(func.name) 'reachedWithoutASourceName'
			continue
		end 'reachedWithoutASourceName'

		if not declaresAFreeFunction(signatures, name: func.name) 'aMemberOrUndeclared'
			continue
		end 'aMemberOrUndeclared'

		pool.add(func.sourceFilePath, candidate: FilePrivateCandidate.create("function", nameLine: func.nameLine, nameColumn: func.nameColumn, extent: CandidateExtent.untilDeclarationEnd))
	end 'eachFunc'
end 'gatherFunctionCandidates'

function declaresAFreeFunction(signatures ProgramSignatures, name ByteArray) returns bool
	return match signatures.functionDeclaringType(name) 'declaring'
		freeFunction gives true
		method or
		undeclared gives false
	end 'declaring'
end 'declaresAFreeFunction'

function gatherTemplateCandidates(signatures ProgramSignatures, pool CandidatePool)
	for template in signatures.genericTemplateRoster() 'eachTemplate'
		if template.visibility != Visibility.file or not template.enclosingTypeName.isEmpty() or isSynthesizedName(signatures, name: template.key) 'notAnAuthorsFilePrivateFunction'
			continue
		end 'notAnAuthorsFilePrivateFunction'

		pool.add(template.declFilePath, candidate: FilePrivateCandidate.create("function", nameLine: template.line, nameColumn: template.column, extent: CandidateExtent.untilDeclarationEnd))
	end 'eachTemplate'
end 'gatherTemplateCandidates'

function gatherConstantCandidates(signatures ProgramSignatures, pool CandidatePool)
	for i in 0 upto signatures.topLevelDeclCount() 'eachDecl'
		view decl = signatures.declAt(i)

		if decl.visibility != Visibility.file or decl.scope.isType() or isSynthesizedName(signatures, name: decl.name) 'notAnAuthorsFilePrivateConstant'
			continue
		end 'notAnAuthorsFilePrivateConstant'

		pool.add(decl.declFilePath, candidate: FilePrivateCandidate.create("constant", nameLine: decl.nameLine, nameColumn: decl.nameColumn, extent: CandidateExtent.initializer(decl.initEnd)))
	end 'eachDecl'
end 'gatherConstantCandidates'

function gatherTypeCandidates(project Project, signatures ProgramSignatures, files FilePathArray, pool CandidatePool) throws CompileError
	for path in files 'eachFile'
		view artifact = try queryParseOps(project, path: path)

		for decl in artifact.typeNameDecls 'eachTypeName'
			if decl.claim.visibility != Visibility.file or isTypeAliasDecl(decl.claim.kind) or isSynthesizedName(signatures, name: decl.name) 'notAnAuthorsFilePrivateType'
				continue
			end 'notAnAuthorsFilePrivateType'

			pool.add(path, candidate: FilePrivateCandidate.create(typeDeclKeyword(decl.claim.kind), nameLine: decl.nameLine, nameColumn: decl.nameColumn, extent: CandidateExtent.untilDeclarationEnd))
		end 'eachTypeName'
	end 'eachFile'
end 'gatherTypeCandidates'

function auditFile(project Project, signatures ProgramSignatures, path FilePath, candidates FilePrivateCandidateArray) throws CompileError
	view tokens = try queryActiveTokens(project, path: path)
	var reader = structuralFileReader(project, signatures: signatures, path: path, tokens: tokens)
	let located = locateDeclarations(tokens, candidates: candidates, path: path, reader: reader)
	let conditional = try conditionalSpellingsOf(project, path: path)
	let watched = watchedNamesOf(located, conditional: conditional)
	let activeCounts = SpellingCountMap.create()
	let graph = UsageGraph.create(candidates.count())

	traceUsage(tokens, located: located, watched: watched, activeCounts: activeCounts, graph: graph)

	if watched.count() > 0 'someNameIsSpelledInAConditionalRegion'
		try creditNamesSpelledOutsideTheActiveArms(project, path: path, located: located, watched: watched, activeCounts: activeCounts, graph: graph)
	end 'someNameIsSpelledInAConditionalRegion'

	graph.propagate()

	// Candidates arrive in gather order; `diagnosticsInSourceOrder` places the reports by file, line and column.
	for index in 0 upto candidates.count() 'eachCandidate'
		if graph.isLive(index) 'reached'
			continue
		end 'reached'

		let candidate = try candidates.get(index) otherwise panic("auditFile: candidate {index} is outside the {candidates.count()} this file holds")
		reportPositioned(project, code: ErrorCode.semanticUnusedFilePrivateDeclaration, message: "unused {candidate.noun}: '{String.from(located.nameOf(index))}' is file-private and nothing live in this file names it; delete it", line: candidate.nameLine, column: candidate.nameColumn, filePath: path)
	end 'eachCandidate'
end 'auditFile'

function locateDeclarations(tokens TokenArray, candidates FilePrivateCandidateArray, path FilePath, reader mutable Parser) returns LocatedDeclarations
	var onLine = CandidateIndexByLineMap.create()

	for position in 0 upto candidates.count() 'eachCandidate'
		let candidate = try candidates.get(position) otherwise panic("locateDeclarations: candidate {position} is outside the {candidates.count()} this file holds")
		var sharing = try onLine.get(candidate.nameLine) otherwise CandidateIndexArray.create(0)
		sharing.push(position)
		onLine.upsert(candidate.nameLine, value: sharing)
	end 'eachCandidate'

	var declarationAt = CandidateIndexByTokenMap.create()
	var candidatesNamed = CandidateIndexByNameMap.create()
	var names = CandidateNameMap.create()
	var limits = CandidateLimitMap.create()

	for at in 0 upto tokens.count() 'eachToken'
		let token = try tokens.get(at) otherwise panic("locateDeclarations: token {at} is outside the {tokens.count()} of {path.toString()}")

		if not tokenCanBeAName(token) 'notAName'
			continue
		end 'notAName'

		let sharing = try onLine.get(token.line) otherwise continue

		for position in sharing 'eachOnThisLine'
			let candidate = try candidates.get(position) otherwise panic("locateDeclarations: candidate {position} is outside the {candidates.count()} this file holds")

			if candidate.nameColumn != token.column 'anotherName'
				continue
			end 'anotherName'

			var named = try candidatesNamed.get(token.value) otherwise CandidateIndexArray.create(0)
			named.push(position)
			candidatesNamed.upsert(token.value, value: named)
			declarationAt.upsert(at, value: position)
			names.upsert(position, value: token.value)
			limits.upsert(position, value: extentLimitOf(candidate.extent, nameAt: at, tokens: tokens, reader: reader))
		end 'eachOnThisLine'
	end 'eachToken'

	if names.count() != candidates.count() 'aDeclarationHasNoToken'
		panic("locateDeclarations: {path.toString()} registers {candidates.count()} file-private declarations but names a token for {names.count()} of them — a registry position the active tokens do not carry")
	end 'aDeclarationHasNoToken'

	return LocatedDeclarations.create(declarationAt, candidatesNamed: candidatesNamed, names: names, limits: limits)
end 'locateDeclarations'

// The parser's own closer for the declaration, so an `#if`-indented body or a bare `end` ends it exactly.
function extentLimitOf(extent CandidateExtent, nameAt ElementIndex, tokens TokenArray, reader mutable Parser) returns ElementIndex
	match extent 'extent'
		initializer(limit) then return limit
		untilDeclarationEnd then return reader.typeBodyCloserAfter(nameAt - 1, membersHaveBodies: tokenKindAt(tokens, index: nameAt - 1) != TokenKind.interface) + 1
	end 'extent'
end 'extentLimitOf'

function watchedNamesOf(located LocatedDeclarations, conditional NameRoster) returns WatchedNameSet
	var watched = WatchedNameSet.create()

	for spelling in conditional 'eachSpelling'
		if located.candidatesNamed.contains(spelling) 'aCandidateName'
			watched.insert(spelling)
		end 'aCandidateName'
	end 'eachSpelling'

	return watched
end 'watchedNamesOf'

function traceUsage(tokens TokenArray, located LocatedDeclarations, watched WatchedNameSet, activeCounts SpellingCountMap, graph UsageGraph)
	var owner = ExtentOwner.none

	for at in 0 upto tokens.count() 'eachToken'
		let token = try tokens.get(at) otherwise panic("traceUsage: token {at} is outside the {tokens.count()} it walks")

		if not tokenCanBeAName(token) 'notAName'
			continue
		end 'notAName'

		let targets = try located.candidatesNamed.get(token.value) otherwise continue

		if watched.contains(token.value) 'countedAgainstTheRawStream'
			countSpelling(activeCounts, name: token.value)
		end 'countedAgainstTheRawStream'

		if let declared = try located.declarationAt.get(at) 'itsDeclaration'
			owner = ExtentOwner.candidate(declared)
			continue
		end 'itsDeclaration'

		owner = located.ownerAt(owner, at: at)

		for target in targets 'eachTarget'
			graph.recordUse(owner, target: target)
		end 'eachTarget'
	end 'eachToken'
end 'traceUsage'

function countSpelling(counts SpellingCountMap, name ByteArray)
	let seen = try counts.get(name) otherwise 0 as SpellingCount
	counts.upsert(name, value: seen + 1)
end 'countSpelling'

// The active tokens omit a branch of `#if` the target excludes. A watched name spelled more often in the raw
// tokens than in the active ones is used there, so a declaration used under one `#if os(...)` branch is
// live on every target.
function creditNamesSpelledOutsideTheActiveArms(project Project, path FilePath, located LocatedDeclarations, watched WatchedNameSet, activeCounts SpellingCountMap, graph UsageGraph) throws CompileError
	let rawCounts = SpellingCountMap.create()
	view rawTokens = try queryTokens(project, path: path)

	for token in rawTokens 'eachRawToken'
		if tokenCanBeAName(token) and watched.contains(token.value) 'aWatchedName'
			countSpelling(rawCounts, name: token.value)
		end 'aWatchedName'
	end 'eachRawToken'

	for (name, rawCount) in rawCounts 'eachWatchedName'
		let activeCount = try activeCounts.get(name) otherwise 0 as SpellingCount

		if rawCount <= activeCount 'everySpellingIsActive'
			continue
		end 'everySpellingIsActive'

		let targets = try located.candidatesNamed.get(name) otherwise panic("creditNamesSpelledOutsideTheActiveArms: watched name '{String.from(name)}' names no candidate")

		for target in targets 'eachTarget'
			graph.markLive(target)
		end 'eachTarget'
	end 'eachWatchedName'
end 'creditNamesSpelledOutsideTheActiveArms'
