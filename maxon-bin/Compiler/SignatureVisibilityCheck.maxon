typealias ReportedTypeNameSet = Set with ByteArray

let ReadingFileSeenPrefix = "reading "
let NoTypeParameters = NameRoster.create()

union SignatureSpelling
	callee
	inDeclaringFile
end 'SignatureSpelling'

export enum SignatureSubjectKind
	declaredFunction
	constantBinding
	variableBinding
	instanceField
	unionCase
	structDeclaration
	enumDeclaration
	unionDeclaration
	interfaceDeclaration
	aliasDeclaration
end 'SignatureSubjectKind'

module function bindingSubjectKind(mutable bool) returns SignatureSubjectKind
	return SignatureSubjectKind.variableBinding if mutable else SignatureSubjectKind.constantBinding
end 'bindingSubjectKind'

function declarationSubjectKind(kind TypeDeclKind) returns SignatureSubjectKind
	return match kind 'kind'
		structType gives SignatureSubjectKind.structDeclaration
		enumType gives SignatureSubjectKind.enumDeclaration
		unionType gives SignatureSubjectKind.unionDeclaration
		interfaceType gives SignatureSubjectKind.interfaceDeclaration
		rangedAlias or
		functionAlias or
		genericAlias or
		tupleAlias gives SignatureSubjectKind.aliasDeclaration
	end 'kind'
end 'declarationSubjectKind'

module function subjectNoun(kind SignatureSubjectKind) returns String
	return match kind 'kind'
		declaredFunction gives "function"
		constantBinding gives "constant"
		variableBinding gives "variable"
		instanceField gives "field"
		unionCase gives "union case"
		structDeclaration gives "type"
		enumDeclaration gives "enum"
		unionDeclaration gives "union"
		interfaceDeclaration gives "interface"
		aliasDeclaration gives "typealias"
	end 'kind'
end 'subjectNoun'

type SignatureSubject
	export let kind as SignatureSubjectKind
	export let spelling as SignatureSpelling
	export let tier as Visibility
	export let readerFilePath as FilePath

	// Where E3167 is reported: the declaration's own file, kept by `readingFrom` while `readerFilePath`
	// moves into each alias the walk passes through.
	export let reportFilePath as FilePath
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber
	export let enclosing as EnclosingType
	export let declaredName as ByteArray
	export let typeParameters as NameRoster

	static function create(spelling SignatureSpelling, tier Visibility, readerFilePath FilePath, nameLine LineNumber, nameColumn ColumnNumber, enclosing EnclosingType, declaredName ByteArray, kind SignatureSubjectKind) returns SignatureSubject
		return Self{kind: kind, spelling: spelling, tier: tier, readerFilePath: readerFilePath, reportFilePath: readerFilePath, nameLine: nameLine, nameColumn: nameColumn, enclosing: enclosing, declaredName: declaredName, typeParameters: NoTypeParameters}
	end 'create'

	function readingFrom(declFilePath FilePath) returns SignatureSubject
		return Self{kind: self.kind, spelling: self.spelling, tier: self.tier, readerFilePath: declFilePath, reportFilePath: self.reportFilePath, nameLine: self.nameLine, nameColumn: self.nameColumn, enclosing: EnclosingType.none, declaredName: self.declaredName, typeParameters: NoTypeParameters}
	end 'readingFrom'

	function scopedToTypeParameters(names NameRoster) returns SignatureSubject
		return Self{kind: self.kind, spelling: self.spelling, tier: self.tier, readerFilePath: self.readerFilePath, reportFilePath: self.reportFilePath, nameLine: self.nameLine, nameColumn: self.nameColumn, enclosing: self.enclosing, declaredName: self.declaredName, typeParameters: names}
	end 'scopedToTypeParameters'

	function namesATypeParameter(name ByteArray) returns bool
		return self.typeParameters.contains(name)
	end 'namesATypeParameter'

	function seenKey(name ByteArray) returns ByteArray
		if self.readerFilePath.equals(self.reportFilePath) 'theSubjectsOwnFile'
			return name
		end 'theSubjectsOwnFile'

		return fileScopedDeclKey("{ReadingFileSeenPrefix}{String.from(name)}".toByteArray(), declFilePath: self.readerFilePath)
	end 'seenKey'
end 'SignatureSubject'

union EnclosingType
	none
	named(let typeName ByteArray)
end 'EnclosingType'

function subjectDisplay(signatures ProgramSignatures, subject SignatureSubject) returns String
	return match subject.spelling 'spelling'
		callee gives String.from(signatures.diagnosticCalleeSpelling(subject.declaredName))
		inDeclaringFile gives String.from(signatures.diagnosticNameInFile(subject.declaredName, declFilePath: subject.reportFilePath))
	end 'spelling'
end 'subjectDisplay'

// Carried as a union and rendered only where a diagnostic is reported: the phrase is one String per
// parameter of every audited signature, on a walk that reports nothing in nearly every compile.
union SignaturePosition
	parameter(let name ByteArray)
	returnType
	throwsClause
	declaredType
	payload(let name ByteArray)
	aliasTarget
	backingRecord
	implementsClause
	whereClause
	extendsClause
end 'SignaturePosition'

function positionText(where SignaturePosition) returns String
	return match where 'position'
		parameter(name) gives "in the type of parameter '{String.from(name)}'"
		returnType gives "in its return type"
		throwsClause gives "in its throws clause"
		declaredType gives "in its type"
		payload(name) gives "in the type of payload '{String.from(name)}'"
		aliasTarget gives "in its target"
		backingRecord gives "in its backing record"
		implementsClause gives "in its implements clause"
		whereClause gives "in its where clause"
		extendsClause gives "in its extends clause"
	end 'position'
end 'positionText'

function enclosingTypeOf(declaredName ByteArray) returns EnclosingType
	return match splitQualifiedName(declaredName) 'split'
		notQualified gives EnclosingType.none
		parts(owner, _) gives EnclosingType.named(owner)
	end 'split'
end 'enclosingTypeOf'

function namesTheEnclosingType(enclosing EnclosingType, name ByteArray) returns bool
	return match enclosing 'enclosing'
		none gives false
		named(typeName) gives typeName.equals(name)
	end 'enclosing'
end 'namesTheEnclosingType'

module function checkSignatureVisibility(project Project, module MaxonModule, signatures ProgramSignatures)
	// A warm project checks again, and a demand left by a signature its sources no longer declare
	// would still excuse an E3092.
	project.signatureTypeDemands = SignatureTypeDemandArray.create()

	for func in module.functions 'eachFunc'
		checkDeclaredSignature(project, signatures: signatures, func: func)
	end 'eachFunc'

	checkInterfaceRequirements(project, signatures: signatures)
	checkDeclaredBindings(project, signatures: signatures)
	checkGenericTemplates(project, signatures: signatures)
	checkConformanceClauses(project, signatures: signatures)
	checkDeclaredTypes(project, signatures: signatures)
end 'checkSignatureVisibility'

function checkDeclaredTypes(project Project, signatures ProgramSignatures)
	for decl in project.typeNameDecls.declarations() 'eachTypeName'
		checkTypeDeclaration(project, signatures: signatures, decl: decl)
	end 'eachTypeName'
end 'checkDeclaredTypes'

function checkTypeDeclaration(project Project, signatures ProgramSignatures, decl TypeNameDecl)
	if decl.claim.declaredByTheCorpus or isSynthesizedName(decl.name) 'noDeclarationAnAuthorWrote'
		return
	end 'noDeclarationAnAuthorWrote'

	match decl.claim.kind 'kind'
		structType then checkStructDeclaration(project, signatures: signatures, decl: decl)
		enumType or
		unionType then checkEnumDeclaration(project, signatures: signatures, decl: decl)
		interfaceType then checkInterfaceExtends(project, signatures: signatures, decl: decl)
		functionAlias or
		genericAlias or
		tupleAlias then checkAliasTarget(project, signatures: signatures, decl: decl)
		rangedAlias then return
	end 'kind'
end 'checkTypeDeclaration'

function declarationSubject(decl TypeNameDecl, tier Visibility) returns SignatureSubject
	return SignatureSubject.create(SignatureSpelling.inDeclaringFile, tier: tier, readerFilePath: decl.claim.declFilePath, nameLine: decl.nameLine, nameColumn: decl.nameColumn, enclosing: enclosingTypeOf(decl.name), declaredName: decl.name, kind: declarationSubjectKind(decl.claim.kind))
end 'declarationSubject'

function memberSubject(decl TypeNameDecl, tier Visibility, memberName ByteArray, site PositionKey, kind SignatureSubjectKind) returns SignatureSubject
	let (line, column) = writtenTypeAnchor(site, decl: decl)

	return SignatureSubject.create(SignatureSpelling.inDeclaringFile, tier: tier, readerFilePath: decl.claim.declFilePath, nameLine: line, nameColumn: column, enclosing: EnclosingType.named(decl.name), declaredName: qualifiedMethodName(decl.name, methodName: memberName), kind: kind)
end 'memberSubject'

function writtenTypeAnchor(site PositionKey, decl TypeNameDecl) returns (LineNumber, ColumnNumber)
	let line = positionKeyLine(site)
	let column = positionKeyColumn(site)

	if namesASourcePosition(line, column: column) 'theTypeWasWritten'
		return (line, column)
	end 'theTypeWasWritten'

	return (decl.nameLine, decl.nameColumn)
end 'writtenTypeAnchor'

function checkStructDeclaration(project Project, signatures ProgramSignatures, decl TypeNameDecl)
	match signatures.structFor(decl.name, readerFilePath: decl.claim.declFilePath) 'aStruct'
		undeclared then return
		declared(layout) then checkStructLayout(project, signatures: signatures, decl: decl, layout: layout)
	end 'aStruct'
end 'checkStructDeclaration'

function checkStructLayout(project Project, signatures ProgramSignatures, decl TypeNameDecl, layout StructLayout)
	if layout.visibility == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateType'
		return
	end 'noTypeCanBeNarrowerThanAFilePrivateType'

	if not layout.declFilePath.equals(decl.claim.declFilePath) 'anotherFilesDeclarationOfThisName'
		return
	end 'anotherFilesDeclarationOfThisName'

	checkConstraints(project, signatures: signatures, subject: declarationSubject(decl, tier: layout.visibility), constraints: layout.whereConstraints)
	checkEveryField(project, signatures: signatures, decl: decl, layout: layout)
end 'checkStructLayout'

function checkEveryField(project Project, signatures ProgramSignatures, decl TypeNameDecl, layout StructLayout)
	var fieldTypeNames = signatures.indexTypeNames()

	for position in 0 upto layout.fieldCount() 'eachField'
		let tier = narrowerTier(layout.fieldTier(position), other: layout.visibility)

		if tier == Visibility.file 'noCallerCanReadIt'
			continue
		end 'noCallerCanReadIt'

		let fieldName = try layout.fieldNames.get(position) otherwise panic("checkEveryField: fieldNames.get OOB at {position} inside its own `upto` bound")
		let declared = try layout.fieldTypes.get(position) otherwise panic("checkEveryField: `type {String.from(layout.name)}` names {layout.fieldNames.count()} field(s) and carries {layout.fieldTypes.count()} field type(s) — `StructLayout.addField` writes the columns in lockstep")
		let subject = memberSubject(decl, tier: tier, memberName: fieldName, site: layout.fieldTypeSites.siteAt(position), kind: SignatureSubjectKind.instanceField).scopedToTypeParameters(layout.typeParamNames.clone())
		var seen = ReportedTypeNameSet.create()
		walkSignatureType(project, signatures: signatures, subject: subject, where: SignaturePosition.declaredType, declared: declared, typeNames: fieldTypeNames, seen: seen)
		walkSpelledBrand(project, signatures: signatures, subject: subject, where: SignaturePosition.declaredType, brand: layout.fieldDeclaredBrand(position), seen: seen)
	end 'eachField'
end 'checkEveryField'

function checkEnumDeclaration(project Project, signatures ProgramSignatures, decl TypeNameDecl)
	match signatures.enumFor(decl.name, readerFilePath: decl.claim.declFilePath) 'anEnum'
		undeclared then return
		declared(layout) then checkEnumLayout(project, signatures: signatures, decl: decl, layout: layout)
	end 'anEnum'
end 'checkEnumDeclaration'

function checkEnumLayout(project Project, signatures ProgramSignatures, decl TypeNameDecl, layout EnumLayout)
	if layout.visibility == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateType'
		return
	end 'noTypeCanBeNarrowerThanAFilePrivateType'

	if not layout.declFilePath.equals(decl.claim.declFilePath) 'anotherFilesDeclarationOfThisName'
		return
	end 'anotherFilesDeclarationOfThisName'

	checkBackingRecord(project, signatures: signatures, subject: declarationSubject(decl, tier: layout.visibility), backing: layout.backingStruct)
	checkEveryPayload(project, signatures: signatures, decl: decl, layout: layout)
end 'checkEnumLayout'

function checkBackingRecord(project Project, signatures ProgramSignatures, subject SignatureSubject, backing EnumBackingStruct)
	match backing 'backing'
		none then return
		declared(typeName) then walkSignatureTypeName(project, signatures: signatures, subject: subject, where: SignaturePosition.backingRecord, name: typeName, seen: ReportedTypeNameSet.create())
	end 'backing'
end 'checkBackingRecord'

function checkEveryPayload(project Project, signatures ProgramSignatures, decl TypeNameDecl, layout EnumLayout)
	var payloadTypeNames = signatures.indexTypeNames()

	for index in 0 upto layout.caseCount() 'eachCase'
		let caseName = try layout.caseNames.get(index) otherwise panic("checkEveryPayload: caseNames.get OOB at {index} inside its own `upto` bound")

		for payload in layout.payloadsAt(index) 'eachPayload'
			let subject = memberSubject(decl, tier: layout.visibility, memberName: caseName, site: payload.typeSite, kind: SignatureSubjectKind.unionCase)
			var seen = ReportedTypeNameSet.create()
			walkSignatureType(project, signatures: signatures, subject: subject, where: SignaturePosition.payload(payload.name), declared: payload.declaredType, typeNames: payloadTypeNames, seen: seen)
			walkSpelledBrand(project, signatures: signatures, subject: subject, where: SignaturePosition.payload(payload.name), brand: payload.declaredBrand, seen: seen)
		end 'eachPayload'
	end 'eachCase'
end 'checkEveryPayload'

function checkInterfaceExtends(project Project, signatures ProgramSignatures, decl TypeNameDecl)
	if decl.claim.visibility == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateInterface'
		return
	end 'noTypeCanBeNarrowerThanAFilePrivateInterface'

	view interfaces = signatures.interfaceMap()

	match lookupInterface(interfaces, name: decl.name) 'declared'
		notFound then return
		found(declared) then walkExtendedInterfaces(project, signatures: signatures, subject: declarationSubject(decl, tier: decl.claim.visibility), extended: declared.extendsInterfaces)
	end 'declared'
end 'checkInterfaceExtends'

function walkExtendedInterfaces(project Project, signatures ProgramSignatures, subject SignatureSubject, extended NameRoster)
	var seen = ReportedTypeNameSet.create()

	for name in extended 'eachExtended'
		walkSignatureTypeName(project, signatures: signatures, subject: subject, where: SignaturePosition.extendsClause, name: name, seen: seen)
	end 'eachExtended'
end 'walkExtendedInterfaces'

function checkAliasTarget(project Project, signatures ProgramSignatures, decl TypeNameDecl)
	if decl.claim.visibility == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateAlias'
		return
	end 'noTypeCanBeNarrowerThanAFilePrivateAlias'

	let subject = declarationSubject(decl, tier: decl.claim.visibility)
	var seen = ReportedTypeNameSet.create()

	match declarationDenotedBy(signatures, subject: subject, name: decl.name) 'aDeclaration'
		undeclared then return
		declared(kind, _, declFilePath) then walkThroughAlias(project, signatures: signatures, subject: subject, where: SignaturePosition.aliasTarget, name: decl.name, kind: kind, declFilePath: declFilePath, seen: seen)
	end 'aDeclaration'
end 'checkAliasTarget'

function checkConformanceClauses(project Project, signatures ProgramSignatures)
	for conformance in project.conformances 'eachConformance'
		if signatures.declaredByTheCorpus(conformance.filePath) 'aLibraryDeclaration'
			continue
		end 'aLibraryDeclaration'

		match signatures.declaredTypeNameIn(conformance.typeName, readerFilePath: conformance.filePath) 'declared'
			undeclared then continue
			declared(kind, visibility, declFilePath) then checkConformingType(project, signatures: signatures, conformance: conformance, kind: kind, visibility: visibility, declFilePath: declFilePath)
		end 'declared'
	end 'eachConformance'
end 'checkConformanceClauses'

function checkConformingType(project Project, signatures ProgramSignatures, conformance ConformanceDecl, kind TypeDeclKind, visibility Visibility, declFilePath FilePath)
	if visibility == Visibility.file or signatures.declaredByTheCorpus(declFilePath) 'noTypeAnAuthorMadeAndOthersCanName'
		return
	end 'noTypeAnAuthorMadeAndOthersCanName'

	let subject = SignatureSubject.create(SignatureSpelling.inDeclaringFile, tier: visibility, readerFilePath: conformance.filePath, nameLine: conformance.nameLine, nameColumn: conformance.nameColumn, enclosing: enclosingTypeOf(conformance.typeName), declaredName: conformance.typeName, kind: declarationSubjectKind(kind)).scopedToTypeParameters(typeParametersOf(signatures, typeName: conformance.typeName, readerFilePath: conformance.filePath))
	var seen = ReportedTypeNameSet.create()

	for entry in conformance.interfaces 'eachInterface'
		walkSignatureTypeName(project, signatures: signatures, subject: subject, where: SignaturePosition.implementsClause, name: entry.interfaceName, seen: seen)

		for spelling in entry.withArgSpellings 'eachArgument'
			walkSignatureTypeName(project, signatures: signatures, subject: subject, where: SignaturePosition.implementsClause, name: spelling, seen: seen)
		end 'eachArgument'
	end 'eachInterface'
end 'checkConformingType'

function typeParametersOf(signatures ProgramSignatures, typeName ByteArray, readerFilePath FilePath) returns NameRoster
	return match signatures.structFor(typeName, readerFilePath: readerFilePath) 'aStruct'
		declared(layout) gives layout.typeParamNames
		undeclared gives NoTypeParameters
	end 'aStruct'
end 'typeParametersOf'

function checkGenericTemplates(project Project, signatures ProgramSignatures)
	for template in signatures.genericTemplateRoster() 'eachTemplate'
		if template.visibility == Visibility.file or template.constraints.count() == 0 or isSynthesizedName(template.key) or signatures.declaredByTheCorpus(template.declFilePath) 'noConstraintAnAuthorWroteOnAReachableFunction'
			continue
		end 'noConstraintAnAuthorWroteOnAReachableFunction'

		let subject = SignatureSubject.create(SignatureSpelling.callee, tier: template.visibility, readerFilePath: template.declFilePath, nameLine: template.line, nameColumn: template.column, enclosing: enclosingTypeOf(template.key), declaredName: template.key, kind: SignatureSubjectKind.declaredFunction)
		checkConstraints(project, signatures: signatures, subject: subject, constraints: template.constraints)
	end 'eachTemplate'
end 'checkGenericTemplates'

function checkConstraints(project Project, signatures ProgramSignatures, subject SignatureSubject, constraints WhereConstraintArray)
	var seen = ReportedTypeNameSet.create()

	for constraint in constraints 'eachConstraint'
		walkSignatureTypeName(project, signatures: signatures, subject: subject, where: SignaturePosition.whereClause, name: constraint.interfaceName, seen: seen)

		for bound in constraint.associatedBindingTypes 'eachBinding'
			walkRequirementType(project, signatures: signatures, subject: subject, where: SignaturePosition.whereClause, required: bound, seen: seen)
		end 'eachBinding'
	end 'eachConstraint'
end 'checkConstraints'

function walkRequirementType(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, required RequirementType, seen ReportedTypeNameSet)
	match required.identity 'identity'
		nominal(name) then walkSignatureTypeName(project, signatures: signatures, subject: subject, where: where, name: name, seen: seen)
		genericInstance(id) then walkInstanceArguments(project, signatures: signatures, subject: subject, where: where, id: id, seen: seen)
		void or
		selfType or
		typeParameter or
		builtin then return
	end 'identity'
end 'walkRequirementType'

function walkSpelledBrand(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, brand ByteArray, seen ReportedTypeNameSet)
	if brand.isEmpty() 'spelledNoAlias'
		return
	end 'spelledNoAlias'

	walkSignatureTypeName(project, signatures: signatures, subject: subject, where: where, name: brand, seen: seen)
end 'walkSpelledBrand'

function checkDeclaredBindings(project Project, signatures ProgramSignatures)
	var bindingTypeNames = signatures.indexTypeNames()

	for index in 0 upto signatures.topLevelDeclCount() 'eachBinding'
		view decl = signatures.declAt(index)

		if decl.visibility == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateBinding'
			continue
		end 'noTypeCanBeNarrowerThanAFilePrivateBinding'

		if isSynthesizedName(decl.name) 'noBindingAnAuthorWrote'
			continue
		end 'noBindingAnAuthorWrote'

		let claim = try signatures.bindingTypeClaimAt(index, into: bindingTypeNames) otherwise continue
		let subject = SignatureSubject.create(SignatureSpelling.inDeclaringFile, tier: decl.visibility, readerFilePath: decl.declFilePath, nameLine: decl.nameLine, nameColumn: decl.nameColumn, enclosing: enclosingTypeOf(decl.name), declaredName: decl.name, kind: bindingSubjectKind(decl.mutable))
		var seen = ReportedTypeNameSet.create()
		walkSignatureType(project, signatures: signatures, subject: subject, where: SignaturePosition.declaredType, declared: claim.valueType, typeNames: bindingTypeNames, seen: seen)
		walkSpelledBrand(project, signatures: signatures, subject: subject, where: SignaturePosition.declaredType, brand: claim.brand, seen: seen)
	end 'eachBinding'
end 'checkDeclaredBindings'

// An interface requirement is no `IrFunction` — it has no body and belongs to no module — so the walk
// over `module.functions` cannot reach one. It is reached through the declaration site instead, at the tier the interface
// itself was written with.
function checkInterfaceRequirements(project Project, signatures ProgramSignatures)
	view interfaces = signatures.interfaceMap()

	for site in signatures.interfaceDeclarationSites() 'eachInterface'
		if site.visibility == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateInterface'
			continue
		end 'noTypeCanBeNarrowerThanAFilePrivateInterface'

		let name = try site.name.declaredName() otherwise continue

		match lookupInterface(interfaces, name: name) 'declared'
			notFound then continue
			found(declared) then checkEveryRequirement(project, signatures: signatures, site: site, name: name, declared: declared)
		end 'declared'
	end 'eachInterface'
end 'checkInterfaceRequirements'

function checkEveryRequirement(project Project, signatures ProgramSignatures, site InterfaceDeclSite, name ByteArray, declared IrInterface)
	for method in declared.methods 'eachRequirement'
		checkOneRequirement(project, signatures: signatures, site: site, name: name, method: method)
	end 'eachRequirement'
end 'checkEveryRequirement'

function checkOneRequirement(project Project, signatures ProgramSignatures, site InterfaceDeclSite, name ByteArray, method InterfaceMethodSig)
	let subject = SignatureSubject.create(SignatureSpelling.inDeclaringFile, tier: site.visibility, readerFilePath: site.path, nameLine: method.nameLine, nameColumn: method.nameColumn, enclosing: EnclosingType.named(name), declaredName: qualifiedMethodName(name, methodName: method.name), kind: SignatureSubjectKind.declaredFunction)

	for position in 0 upto method.paramNames.count() 'eachParam'
		let paramName = try method.paramNames.get(position) otherwise panic("checkOneRequirement: paramNames.get OOB at {position} inside its own `upto` bound")
		var seenInParam = ReportedTypeNameSet.create()
		walkWrittenTypeNames(project, signatures: signatures, subject: subject, where: SignaturePosition.parameter(paramName), written: method.written, position: position, seen: seenInParam)
	end 'eachParam'

	var seenInReturn = ReportedTypeNameSet.create()
	walkWrittenTypeNames(project, signatures: signatures, subject: subject, where: SignaturePosition.returnType, written: method.written, position: method.paramNames.count(), seen: seenInReturn)

	checkThrowsType(project, signatures: signatures, subject: subject, clause: method.throwsClause)
end 'checkOneRequirement'

// On a service's instance method `export` means "this is a message", and a message can be sent no
// further than a handle to its service travels, so its surface is capped at the service type's tier.
// Without the cap a file-private service could not name its own types in its messages.
function declaredTierOf(signatures ProgramSignatures, func IrFunction) returns Visibility
	if func.visibility == Visibility.file 'noMessageTierCanNarrowIt'
		return func.visibility
	end 'noMessageTierCanNarrowIt'

	if let message = try signatures.serviceMessageOf(func.name) 'aMessage'
		return narrowerTier(func.visibility, other: spawnTargetLayoutOf(signatures, typeName: message.typeName).visibility)
	end 'aMessage'

	return func.visibility
end 'declaredTierOf'

function checkDeclaredSignature(project Project, signatures ProgramSignatures, func IrFunction)
	let tier = declaredTierOf(signatures, func: func)

	if tier == Visibility.file 'noTypeCanBeNarrowerThanAFilePrivateFunction'
		return
	end 'noTypeCanBeNarrowerThanAFilePrivateFunction'

	if func.isCompilerBuilt() 'synthesizedAndSpellsNothingAnAuthorWrote'
		return
	end 'synthesizedAndSpellsNothingAnAuthorWrote'

	if isSynthesizedName(func.name) 'noSignatureAnAuthorWrote'
		return
	end 'noSignatureAnAuthorWrote'

	if signatures.isGenericInstanceName(func.name) 'aSubstitutedSignatureNoAuthorWrote'
		return
	end 'aSubstitutedSignatureNoAuthorWrote'

	if not project.funcSignatures.contains(func.name) 'noDeclaredSignatureToWalk'
		return
	end 'noDeclaredSignatureToWalk'

	view sig = try project.funcSignatures.get(func.name) otherwise panic("checkSignatureVisibility: contains({String.from(func.name)}) is true on the line above but get failed")
	let subject = SignatureSubject.create(SignatureSpelling.callee, tier: tier, readerFilePath: func.sourceFilePath, nameLine: func.nameLine, nameColumn: func.nameColumn, enclosing: enclosingTypeOf(func.name), declaredName: func.name, kind: SignatureSubjectKind.declaredFunction)

	checkParameterTypes(project, signatures: signatures, subject: subject, sig: sig)
	checkReturnType(project, signatures: signatures, subject: subject, returned: func.maxonReturnType, sig: sig)
	checkThrowsType(project, signatures: signatures, subject: subject, clause: func.throwsTypeName)
	checkConstraints(project, signatures: signatures, subject: subject, constraints: sig.extensionConstraints)
end 'checkDeclaredSignature'

function checkParameterTypes(project Project, signatures ProgramSignatures, subject SignatureSubject, sig FuncSignature)
	for position in 0 upto sig.paramNames.count() 'eachParam'
		let name = try sig.paramNames.get(position) otherwise panic("checkParameterTypes: paramNames.get OOB at {position} inside its own `upto` bound")

		if name.equals(SelfParamName) 'theImplicitReceiverIsNotAWrittenSignatureType'
			continue
		end 'theImplicitReceiverIsNotAWrittenSignatureType'

		let declared = try sig.paramTypes.get(position) otherwise panic("checkParameterTypes: '{String.from(subject.declaredName)}' names {sig.paramNames.count()} parameter(s) and carries {sig.paramTypes.count()} parameter type(s) — `FuncSignature` holds the two columns in parallel")
		var seen = ReportedTypeNameSet.create()
		walkSignatureType(project, signatures: signatures, subject: subject, where: SignaturePosition.parameter(name), declared: declared, typeNames: project.typeNames, seen: seen)
		walkWrittenTypeNames(project, signatures: signatures, subject: subject, where: SignaturePosition.parameter(name), written: sig.writtenTypeNames, position: position, seen: seen)
	end 'eachParam'
end 'checkParameterTypes'

function checkReturnType(project Project, signatures ProgramSignatures, subject SignatureSubject, returned MaxonReturnType, sig FuncSignature)
	var seen = ReportedTypeNameSet.create()

	match returned 'ret'
		void then return
		value(inner) then walkSignatureType(project, signatures: signatures, subject: subject, where: SignaturePosition.returnType, declared: inner, typeNames: project.typeNames, seen: seen)
	end 'ret'

	walkWrittenTypeNames(project, signatures: signatures, subject: subject, where: SignaturePosition.returnType, written: sig.writtenTypeNames, position: sig.paramNames.count(), seen: seen)
end 'checkReturnType'

function walkWrittenTypeNames(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, written WrittenTypeNames, position ElementIndex, seen ReportedTypeNameSet)
	walkWrittenNameRange(project, signatures: signatures, subject: subject, where: where, written: written, from: written.beginOf(position), to: written.endOf(position), seen: seen)
end 'walkWrittenTypeNames'

function walkWrittenNameRange(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, written WrittenTypeNames, from ElementIndex, to ElementIndex, seen ReportedTypeNameSet)
	for at in from upto to 'eachWrittenName'
		walkSignatureTypeName(project, signatures: signatures, subject: subject, where: where, name: written.nameAt(at), seen: seen)
	end 'eachWrittenName'
end 'walkWrittenNameRange'

function checkThrowsType(project Project, signatures ProgramSignatures, subject SignatureSubject, clause ThrowsClause)
	var seen = ReportedTypeNameSet.create()

	match clause 'clause'
		none then return
		throwing(declared) then walkSignatureTypeName(project, signatures: signatures, subject: subject, where: SignaturePosition.throwsClause, name: declared.toByteArray(), seen: seen)
	end 'clause'
end 'checkThrowsType'

// ⚠ `typeNames` is the interner the type in hand was minted against, and the two that reach here are
// different tables: a declared signature carries `project.typeNames`, and a binding, a field, a payload, a
// tuple's element or a generic instance's argument carries `signatures.indexTypeNames()`. One id names two
// different types across them, so a caller that passed the other one would judge a type the signature
// never wrote.
function walkSignatureType(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, declared MaxonType, typeNames TypeNameInterner, seen ReportedTypeNameSet)
	match declared 'type'
		named(id) then walkSignatureTypeId(project, signatures: signatures, subject: subject, where: where, nameId: id, typeNames: typeNames, seen: seen)
		structRef(id) then walkSignatureTypeId(project, signatures: signatures, subject: subject, where: where, nameId: id, typeNames: typeNames, seen: seen)
		interfaceRef(id) then walkSignatureTypeId(project, signatures: signatures, subject: subject, where: where, nameId: id, typeNames: typeNames, seen: seen)
		function(id) then walkSignatureTypeId(project, signatures: signatures, subject: subject, where: where, nameId: id, typeNames: typeNames, seen: seen)
		genericInstance(id) then walkInstanceArguments(project, signatures: signatures, subject: subject, where: where, id: id, seen: seen)
		typeParameter or
		boolean or
		integer or
		float or
		exitCode or
		unresolved or
		string or
		character or
		cstring then return
	end 'type'
end 'walkSignatureType'

function walkSignatureTypeId(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, nameId TypeNameId, typeNames TypeNameInterner, seen ReportedTypeNameSet)
	if nameId == UnnamedTypeId 'namesNoDeclaration'
		return
	end 'namesNoDeclaration'

	let name = try typeNames.nameOf(nameId) otherwise return
	walkSignatureTypeName(project, signatures: signatures, subject: subject, where: where, name: name, seen: seen)
end 'walkSignatureTypeId'

function walkSignatureTypeName(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, name ByteArray, seen ReportedTypeNameSet)
	if subject.namesATypeParameter(name) 'aTypeParameterNamesNoDeclaration'
		return
	end 'aTypeParameterNamesNoDeclaration'

	let askedKey = subject.seenKey(name)

	if seen.contains(askedKey) 'alreadyAskedInThisPosition'
		return
	end 'alreadyAskedInThisPosition'

	seen.insert(askedKey)

	if isTupleTypeName(name) 'aTupleNamesNoDeclarationOfItsOwn'
		walkTupleElements(project, signatures: signatures, subject: subject, where: where, name: name, seen: seen)
		return
	end 'aTupleNamesNoDeclarationOfItsOwn'

	match declarationDenotedBy(signatures, subject: subject, name: name) 'aDeclaration'
		undeclared then return
		declared(kind, visibility, declFilePath) then judgeDeclaredType(project, signatures: signatures, subject: subject, where: where, name: name, kind: kind, visibility: visibility, declFilePath: declFilePath, seen: seen)
	end 'aDeclaration'
end 'walkSignatureTypeName'

// A signature that names its own enclosing type — `Self` in a factory — means that type's declaration and
// no other. The reader-scoped door would answer with whatever alias of the name the declaring file can
// see, which in a program where some other type nests an alias of that name is a different declaration
// and a different tier.
function declarationDenotedBy(signatures ProgramSignatures, subject SignatureSubject, name ByteArray) returns DeclaredTypeName
	match declarationReadBy(signatures, subject: subject, name: name) 'aDeclaration'
		undeclared then return declarationOfIdentity(signatures, name: name)
		declared(kind, visibility, declFilePath) then return DeclaredTypeName.declared(kind, visibility: visibility, declFilePath: declFilePath)
	end 'aDeclaration'
end 'declarationDenotedBy'

function declarationReadBy(signatures ProgramSignatures, subject SignatureSubject, name ByteArray) returns DeclaredTypeName
	if not namesTheEnclosingType(subject.enclosing, name: name) 'notTheEnclosingTypesOwnName'
		return signatures.declaredTypeNameIn(name, readerFilePath: subject.readerFilePath)
	end 'notTheEnclosingTypesOwnName'

	match signatures.nominalTypeNameIn(name) 'theEnclosingTypeItself'
		undeclared then return signatures.declaredTypeNameIn(name, readerFilePath: subject.readerFilePath)
		declared(kind, visibility, declFilePath) then return DeclaredTypeName.declared(kind, visibility: visibility, declFilePath: declFilePath)
	end 'theEnclosingTypeItself'
end 'declarationReadBy'

function declarationOfIdentity(signatures ProgramSignatures, name ByteArray) returns DeclaredTypeName
	if not isMintName(name) 'anIdentityNamesNoDeclarationOfItsOwn'
		return DeclaredTypeName.undeclared
	end 'anIdentityNamesNoDeclarationOfItsOwn'

	return match signatures.declaringFileOfIdentity(name) 'declaringFile'
		declaredIn(declFilePath) gives signatures.declaredTypeNameIn(sourceSpelledAliasName(name), readerFilePath: declFilePath)
		nothingMeant or
		unspecified gives DeclaredTypeName.undeclared
	end 'declaringFile'
end 'declarationOfIdentity'

function judgeDeclaredType(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, name ByteArray, kind TypeDeclKind, visibility Visibility, declFilePath FilePath, seen ReportedTypeNameSet)
	if declFilePath.equals(CompilerOwnedDeclFilePath) 'noAuthorWroteAModifierForIt'
		return
	end 'noAuthorWroteAModifierForIt'

	// A monomorphized library body carries its `stdlib/` file as its source with an author's type
	// substituted into the signature, and no library source can have written that name down. Without this
	// the author's own file-private type earns E3167 against a library function they never wrote.
	if signatures.declaredByTheCorpus(subject.reportFilePath) and not signatures.declaredByTheCorpus(declFilePath) 'aLibrarySignatureCannotHaveWrittenAnAuthorsName'
		return
	end 'aLibrarySignatureCannotHaveWrittenAnAuthorsName'

	let isInner = signatures.namesAnInnerAliasOfAnyForm(name)
	let base = signatures.writtenAliasBase(name)
	let declarationKey = fileScopedDeclKey(name if isInner else base, declFilePath: declFilePath)

	if seen.contains(declarationKey) 'thisDeclarationIsAlreadyJudgedInThisPosition'
		return
	end 'thisDeclarationIsAlreadyJudgedInThisPosition'

	seen.insert(declarationKey)

	if not isInner 'aFileScopeDeclarationTheAuditTracks'
		project.signatureTypeDemands.push(SignatureTypeDemand.create(subject.declaredName, demandingKind: subject.kind, demandingTier: subject.tier, typeName: demandedDeclarationName(signatures, written: name, base: base), declFilePath: declFilePath))
	end 'aFileScopeDeclarationTheAuditTracks'

	if not tierIsAtLeastAsVisible(visibility, floor: subject.tier) 'narrowerThanTheDeclarationThatNamesIt'
		reportPositioned(project, code: ErrorCode.semanticSignatureTypeLessVisibleThanDeclaration, message: "{visibilityTierWord(subject.tier)} {subjectNoun(subject.kind)} '{subjectDisplay(signatures, subject: subject)}' names {visibilityTierWord(visibility)} {declaredTypeNoun(kind)} '{sourceSpelledAliasText(base if isInner else name)}' {positionText(where)}", line: subject.nameLine, column: subject.nameColumn, filePath: subject.reportFilePath)
		return
	end 'narrowerThanTheDeclarationThatNamesIt'

	walkThroughAlias(project, signatures: signatures, subject: subject, where: where, name: name, kind: kind, declFilePath: declFilePath, seen: seen)
end 'judgeDeclaredType'

function demandedDeclarationName(signatures ProgramSignatures, written ByteArray, base ByteArray) returns ByteArray
	if signatures.isServiceHandle(written) 'aHandleIsItsServicesTier'
		return signatures.serviceOfHandle(written)
	end 'aHandleIsItsServicesTier'

	return base
end 'demandedDeclarationName'

function walkThroughAlias(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, name ByteArray, kind TypeDeclKind, declFilePath FilePath, seen ReportedTypeNameSet)
	let inside = subject.readingFrom(declFilePath)

	match kind 'kind'
		genericAlias then walkInstanceArguments(project, signatures: signatures, subject: inside, where: where, id: signatures.genericAliasInstanceFrom(name, readerFilePath: subject.readerFilePath), seen: seen)
		functionAlias then walkFunctionAliasShape(project, signatures: signatures, subject: subject, inside: inside, where: where, name: name, seen: seen)
		tupleAlias then walkSignatureTypeName(project, signatures: signatures, subject: inside, where: where, name: signatures.scopedTupleAlias(name, readerFilePath: subject.readerFilePath).tupleName, seen: seen)
		structType or
		enumType or
		unionType or
		interfaceType or
		rangedAlias then return
	end 'kind'
end 'walkThroughAlias'

function walkFunctionAliasShape(project Project, signatures ProgramSignatures, subject SignatureSubject, inside SignatureSubject, where SignaturePosition, name ByteArray, seen ReportedTypeNameSet)
	match signatures.functionAliasFrom(name, readerFilePath: subject.readerFilePath) 'aFunctionAlias'
		undeclared then return
		declared(alias) then walkWrittenNameRange(project, signatures: signatures, subject: inside, where: where, written: alias.written, from: 0, to: alias.written.names.count(), seen: seen)
	end 'aFunctionAlias'
end 'walkFunctionAliasShape'

function walkTupleElements(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, name ByteArray, seen ReportedTypeNameSet)
	match signatures.structFor(name, readerFilePath: subject.readerFilePath) 'aTupleLayout'
		undeclared then return
		declared(layout) then walkEveryElement(project, signatures: signatures, subject: subject, where: where, layout: layout, seen: seen)
	end 'aTupleLayout'
end 'walkTupleElements'

function walkEveryElement(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, layout StructLayout, seen ReportedTypeNameSet)
	var elementTypeNames = signatures.indexTypeNames()

	for position in 0 upto layout.fieldCount() 'eachElement'
		let element = try layout.fieldTypes.get(position) otherwise panic("walkEveryElement: fieldTypes.get OOB at {position} inside its own `upto` bound")
		walkSignatureType(project, signatures: signatures, subject: subject, where: where, declared: element, typeNames: elementTypeNames, seen: seen)
		walkSpelledBrand(project, signatures: signatures, subject: subject, where: where, brand: layout.fieldDeclaredBrand(position), seen: seen)
	end 'eachElement'
end 'walkEveryElement'

function walkInstanceArguments(project Project, signatures ProgramSignatures, subject SignatureSubject, where SignaturePosition, id GenericInstanceId, seen ReportedTypeNameSet)
	var argumentTypeNames = signatures.indexTypeNames()
	walkSignatureTypeName(project, signatures: signatures, subject: subject, where: where, name: signatures.genericInstanceBaseName(id), seen: seen)

	for position in 0 upto signatures.genericInstanceArgCount(id) 'eachArgument'
		walkSignatureType(project, signatures: signatures, subject: subject, where: where, declared: signatures.substitutedInstanceArg(id, position: position), typeNames: argumentTypeNames, seen: seen)
	end 'eachArgument'
end 'walkInstanceArguments'

function declaredTypeNoun(kind TypeDeclKind) returns String
	return match kind 'kind'
		structType gives "type"
		enumType gives "enum"
		unionType gives "union"
		interfaceType gives "interface"
		rangedAlias or
		functionAlias or
		genericAlias or
		tupleAlias gives "typealias"
	end 'kind'
end 'declaredTypeNoun'
