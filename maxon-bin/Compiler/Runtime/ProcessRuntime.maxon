// Runtime/ProcessRuntime.maxon — the process family's COMPILER-SIDE VOCABULARY: the three entry-point names
// the parser emits calls to, the band test that decides which targets may run them, and the ONE body still
// built as IR here.
//
// ⭐ **WHAT THE FAMILY SERVES — THREE `__Builtins` INTRINSICS ABOUT THE RUNNING PROCESS.**
// `stdlib/Process.maxon`'s `executablePath()` bottoms out in `__Builtins.executablePath()`;
// `Compiler/TreeLock.maxon`'s lock token bottoms out in `__Builtins.currentProcessId()`; and
// `Main.runSpecTest` calls `__Builtins.enterBackgroundPriority()` before it spawns a worker pool. Only the
// first has a stdlib wrapper: a declaration whose whole body is one intrinsic call is the thin wrapper the
// house rules forbid. Nothing else in the language reaches these entry points.
//
// ⛔⛔ **TWO OF THE THREE BODIES ARE RUNTIME SOURCE AND THIS ONE IS NOT, AND THE LINE IS A MECHANISM RATHER
// THAN AN APPETITE.** `runtime/Process.maxon` writes `__proc_pid` and `__proc_bg_priority`, each one `__Raw`
// op the tier can spell. `__proc_exe_path` cannot follow yet: it allocates a raw buffer, grows it and builds
// an `__ManagedMemory` answer, so as tier source it would CALL other runtime entries — and `scanRuntimeUsage`
// walks every runtime body in every program, so a call inside one would set that family's bit for a program
// dead-function elimination sweeps the body out of. That vacuity holds only while every tier body calls
// nothing but `__Raw`, which names no callee. The allocator's own migration is what answers it.
//
// ⭐ **TWO HOST FACILITIES, AND WHICH TARGETS HAVE EACH IS `TargetFacilities`' TO SAY.** A target that has
// neither refuses at the call site with the EXISTING `E3104 targetUnsupportedConstruct`.
//
// ⚠⚠ **THE `__proc_` PREFIX DOES NOT ANSWER FOR THE WHOLE BAND.** The two IDENTITY reads answer
// `processInfo` by that prefix; the PRIORITY write answers `processPriority`, which `calleeHostFacility`
// tests for by NAME ahead of the band. The split records a difference in KIND rather than a schedule:
// reading an identity is one call that cannot fail, while the write's POSIX scope disagrees —
// `setpriority` scopes to the process on Darwin and to the calling THREAD on Linux — so a lane can serve
// the reads without serving the write, and one answer for three entries would make the whole band wait on
// the narrowest of them. ⇒ **A fourth entry point is still covered by construction, and it will answer
// `processInfo`** — which is right for another identity read and wrong for another write, so a write joins
// by name.
//
// ⚠ The executable-path fill is a Std loop rather than a lowering because the three OS APIs
// disagree on their own shape. `stdlib/Process.maxon` names all three — `GetModuleFileNameW` on
// Windows, `_NSGetExecutablePath` on macOS, `/proc/self/exe` on Linux. The first fills a caller's
// buffer and answers a count; the second takes an in-out size, signals "too small" through a `-1`
// return plus a rewritten size, leaves that size unchanged on success (so the length must be
// measured) and answers a path that "may be a symbolic link and not the real file"; the third is a
// symlink that must be `readlink`'d and is not NUL-terminated. The Std tier is target-neutral, so
// each backend translates its own convention into `osExecutablePath`'s and the one retry loop,
// `PathFillRuntime.emitGrowingPathFill`, serves all three. wasm is refused for a stronger
// reason: WASI has no executable-path primitive at all. A component has no image path to report,
// and `args_get[0]` is whatever the host chose to pass rather than a resolved path — so a lowering
// there could only be a plausible wrong answer, which is worse than a refusal because `File.exists`
// on it would simply say false and the program would blame itself.

// The `__proc_` prefix that identifies every process runtime entry point, and the one `SemanticCheck` reads
// for E3104 through `TargetFacilities.calleeHostFacility`.
let ProcessRuntimePrefix = b"__proc_"

// ⭐ **THE THREE ENTRY POINTS.** Only the first is built below; the other two are declared in
// `runtime/Process.maxon` and reached by a call the parser emits from the `__Builtins` spelling.
export let ProcessExecutablePathName = b"__proc_exe_path"
export let ProcessNamespaceName = b"__proc_namespace"
export let ProcessCurrentPidName = b"__proc_pid"

// ⭐ **THE ONE THE PREFIX DOES NOT ANSWER FOR.** It is refused by E3104 on a target that cannot lower
// it, but through `processPriority` rather than `processInfo` — see the header for why a WRITE whose scope
// differs per platform cannot be fused to the two identity reads.
export let ProcessBackgroundPriorityName = b"__proc_bg_priority"

export let ProcessAliveName = b"__proc_alive"

let ProcessDescendantsVerbTrack = 0
export let ProcessDescendantsVerbEnd = 1
export let ProcessDescendantsVerbSeal = 2

export let ProcessEndDescendantsTextName = b"__proc_end_descendants_text"

export let DescendantsEnvName = b"MAXON_TRACK_DESCENDANTS"
export let SpecMarkerWrapper = "@@maxon-spec@@"
export let DescendantsFrameTag = "!"
export let DescendantsFrameTokenSeparator = "\t"
export let ProcessDescendantGateName = b"__proc_descendant_gate"

let DescendantsEnvValueUnits = 32
let DescendantsArmedMark = 0x41
export let DescendantsInertMark = 0x44
export let EnvEntrySeparator = 0x3D

// A descendant's name is the host's, and every byte outside this range becomes `?`: a newline in it
// would end the framed report line early and hand the rest to the case's own stderr.
export let DescendantsNameFirstPrintable = 0x20
export let DescendantsNameLastPrintable = 0x7E
export let DescendantsNameReplacement = 0x3F
let DescendantGateReportBytes = 65536
let DescendantGateLineEnd = 10
let DescendantTokenLengthOffset = 0
let DescendantTokenBytesOffset = 8
let DescendantTokenMarkOffset = DescendantTokenBytesOffset - 1

// `__proc_exe_path() -> arrRec`: a fresh owned `__ManagedMemory` holding the running image's
// absolute path, which the caller frees.
//
// A refused fill answers the empty buffer rather than throwing, the intrinsic's documented contract
// (`/specs/builtins-type.md`: "empty buffer when unavailable").
//
// `_NSGetExecutablePath` rewrites its in-out size to the one it needs, and `osExecutablePath`
// carries no channel for that number: a channel only one lane can fill would make this
// target-neutral graph ask which target it compiles for. That lane answers "too small" and pays at
// most one extra doubling (`Arm64DarwinRuntime.buildArm64DarwinExePathChunk`).
//
// The raw buffer is a scratch allocation this function owns end to end: it is freed on the one
// exit, and what the caller receives is the independent `__ManagedMemory` copy.
function buildProcessFill(module StdModule, name ByteArray, fill PathFill)
	let func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create(0))
	let ids = ValueMinter.create(0)

	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	let attempt = module.addBlock(func, label: b"pxattempt", heat: BlockHeat.normal)
	let fitTest = module.addBlock(func, label: b"pxfit", heat: BlockHeat.normal)
	let grow = module.addBlock(func, label: b"pxgrow", heat: BlockHeat.normal)
	let unavailable = module.addBlock(func, label: b"pxnone", heat: BlockHeat.normal)
	let copyOut = module.addBlock(func, label: b"pxcopy", heat: BlockHeat.normal)

	let (buffer, _, _) = emitGrowingPathFill(module, cur: entry, attempt: attempt, fitTest: fitTest, grow: grow, fill: fill, whenRefused: unavailable, whenFits: copyOut, ids: ids)

	// Unavailable: make the buffer the empty string and take the ordinary copy-out.
	let encoding = pathFillEncoding(module, fill: fill)
	emitStoreNulUnit(module, block: unavailable, base: buffer, encoding: encoding, ids: ids)
	module.setTerminator(unavailable, op: StdOp.branch(copyOut.id))

	let record = ids.mint()
	let built = emitTextToManaged(module, func: func, cur: copyOut, cstr: buffer, record: record, encoding: encoding, ids: ids)
	emitRawFree(module, block: built, ptr: buffer, ids: ids)
	module.setTerminator(built, op: StdOp.ret(record))

	module.functions.push(func)
end 'buildProcessFill'

// ⚠ **THE GUARD IS PER ENTRY, NOT PER FILE**, and one entry is left to guard: the path walk drags in
// `usesHeap` AND `usesManagedMemory`, i.e. the whole managed-memory runtime installed as one closure, so a
// program whose only introspection is a pid must not reach it. The other two entries need no guard here at
// all — their bodies are tier source, and dead-function elimination decides whether each survives.
export function installProcessRuntime(module StdModule, usage RuntimeUsage, gatesDescendants bool)
	if usage.usesExecutablePath 'executablePath'
		buildProcessFill(module, name: ProcessExecutablePathName, fill: PathFill.executablePath)
	end 'executablePath'

	if usage.usesProcessNamespace 'processNamespace'
		buildProcessFill(module, name: ProcessNamespaceName, fill: PathFill.processNamespace)
	end 'processNamespace'

	if gatesDescendants 'descendantGate'
		buildProcessDescendantGate(module)
	end 'descendantGate'
end 'installProcessRuntime'

// A program that calls `Process.endDescendants` tracks from bring-up whatever the variable holds,
// so its first call also finds the processes it started before that call.
export enum DescendantArming
	untracked
	trackedOnToken
	trackedFromStart
end 'DescendantArming'

export function descendantArmingOf(usage RuntimeUsage) returns DescendantArming
	if usage.callsEndDescendants 'callsTheApi'
		return DescendantArming.trackedFromStart
	end 'callsTheApi'

	return DescendantArming.trackedOnToken if usage.usesProcessDescendants else DescendantArming.untracked
end 'descendantArmingOf'

// Only a value starting `A` arms the gate, and the seal flips that `A` to `D` in place: children
// inherit the variable, which the macOS audit looks for in their environments, and do not arm a
// tracker of their own.
function emitArmDescendantTracking(module StdModule, func IrFunction, cur IrBlock, target Target, arming DescendantArming, ids ValueMinter) returns IrBlock
	if arming == DescendantArming.untracked 'nothingCanBeLeft'
		return cur
	end 'nothingCanBeLeft'

	let read = module.addBlock(func, label: b"descread", heat: BlockHeat.normal)
	let grow = module.addBlock(func, label: b"descgrow", heat: BlockHeat.cold)
	let inspect = module.addBlock(func, label: b"descinspect", heat: BlockHeat.normal)
	let readFirst = module.addBlock(func, label: b"descreadfirst", heat: BlockHeat.normal)
	let unmarked = module.addBlock(func, label: b"descunmarked", heat: BlockHeat.normal)
	let armed = module.addBlock(func, label: b"descarmed", heat: BlockHeat.normal)
	let release = module.addBlock(func, label: b"descrelease", heat: BlockHeat.normal)

	let firstCapacity = emitConst(module, block: cur, value: DescendantsEnvValueUnits, ids: ids)
	let name = emitLiteralHostString(module, block: cur, ids: ids, text: DescendantsEnvName)
	let firstValue = emitSlabAlloc(module, block: cur, bytes: emitByteCountOfUnits(module, block: cur, units: firstCapacity, encoding: module.hostText, ids: ids), kind: SlabBufferKind.environmentValue, ids: ids)
	let value = ids.mint()
	let capacity = ids.mint()
	read.blockArgs.push(IrBlockArg.create(value, argType: StdType.i64))
	read.blockArgs.push(IrBlockArg.create(capacity, argType: StdType.i64))
	emitBranchCarrying(module, from: cur, to: read, values: twoArgs(firstValue, second: firstCapacity))

	let written = ids.mint()
	module.appendOp(read, op: StdOp.osEnvRead(written, namePtrId: name, bufPtrId: value, bufLenId: capacity))
	emitBranchOnCompareValues(module, block: read, a: written, pred: StdCmpPred.lt, b: capacity, whenTrue: inspect, whenFalse: grow, ids: ids)

	emitSlabFree(module, block: grow, ptr: value, kind: SlabBufferKind.environmentValue, ids: ids)
	let grown = emitSlabAlloc(module, block: grow, bytes: emitByteCountOfUnits(module, block: grow, units: written, encoding: module.hostText, ids: ids), kind: SlabBufferKind.environmentValue, ids: ids)
	emitBranchCarrying(module, from: grow, to: read, values: twoArgs(grown, second: written))

	emitBranchOnCompare(module, block: inspect, value: written, pred: StdCmpPred.ne, against: 0, whenTrue: readFirst, whenFalse: unmarked, ids: ids)

	let zero = emitConst(module, block: readFirst, value: 0, ids: ids)
	let first = emitHostUnit(module, block: readFirst, base: value, unitIndex: zero, ids: ids)
	let marked = emitCompareWithConstant(module, block: readFirst, value: first, pred: StdCmpPred.eq, against: DescendantsArmedMark, ids: ids)
	module.setTerminator(readFirst, op: StdOp.condBranch(marked, thenBlockId: armed.id, elseBlockId: unmarked.id))

	let capture = emitCaptureArmedToken(module, cur: armed, name: name, units: written, ids: ids)
	emitArmAction(module, func: func, cur: armed, target: target, name: name, value: value, release: release, token: ArmingToken.captured(capture), ids: ids)

	match arming 'withoutToken'
		trackedFromStart then emitArmAction(module, func: func, cur: unmarked, target: target, name: name, value: value, release: release, token: ArmingToken.absent, ids: ids)
		trackedOnToken then module.setTerminator(unmarked, op: StdOp.branch(release.id))
		untracked then panic("emitArmDescendantTracking: an untracked program emits no arming")
	end 'withoutToken'

	emitSlabFree(module, block: release, ptr: value, kind: SlabBufferKind.environmentValue, ids: ids)
	emitSlabFree(module, block: release, ptr: name, kind: SlabBufferKind.hostText, ids: ids)

	return release
end 'emitArmDescendantTracking'

union ArmingToken
	absent
	captured(copy ValueId)
end 'ArmingToken'

// The record holds a length word at `DescendantTokenLengthOffset` and the token bytes from
// `DescendantTokenBytesOffset`. The read starts one byte early, so the length store overwrites the
// `A` mark and the token follows it. The capture precedes `emitArmAction` because the Track verb
// rewrites the variable to `D<pid>` on macOS, after which the harness's token can no longer be read.
function emitCaptureArmedToken(module StdModule, cur IrBlock, name ValueId, units ValueId, ids ValueMinter) returns ValueId
	let header = emitConst(module, block: cur, value: DescendantTokenBytesOffset, ids: ids)
	let total = emitBin(module, block: cur, a: units, b: header, opcode: StdBinOpcode.add, ids: ids)
	let capture = emitSlabAlloc(module, block: cur, bytes: total, kind: SlabBufferKind.environmentValue, ids: ids)
	let one = emitConst(module, block: cur, value: 1, ids: ids)
	let markOffset = emitConst(module, block: cur, value: DescendantTokenMarkOffset, ids: ids)
	let markAddress = emitBin(module, block: cur, a: capture, b: markOffset, opcode: StdBinOpcode.add, ids: ids)
	let readCapacity = emitBin(module, block: cur, a: units, b: one, opcode: StdBinOpcode.add, ids: ids)
	_ = emitHostEnvReadAscii(module, block: cur, name: name, valueBuf: markAddress, capacity: readCapacity, ids: ids)
	let tokenLength = emitBin(module, block: cur, a: units, b: one, opcode: StdBinOpcode.sub, ids: ids)

	emitStoreField(module, block: cur, record: capture, offset: DescendantTokenLengthOffset, value: tokenLength)

	return capture
end 'emitCaptureArmedToken'

function emitArmAction(module StdModule, func IrFunction, cur IrBlock, target Target, name ValueId, value ValueId, release IrBlock, token ArmingToken, ids ValueMinter)
	if not targetProvidesFacility(target, facility: HostFacility.processDescendants) 'noFacility'
		emitRuntimeFatal(module, func: func, block: cur, fatal: RuntimeFatal.descendantTrackingUnavailable, ids: ids)
		return
	end 'noFacility'

	let tracked = module.addBlock(func, label: b"desctracked", heat: BlockHeat.normal)
	let trackRefused = module.addBlock(func, label: b"desctrackrefused", heat: BlockHeat.cold)

	let verb = emitConst(module, block: cur, value: ProcessDescendantsVerbTrack, ids: ids)
	let nothing = emitConst(module, block: cur, value: 0, ids: ids)
	let answer = ids.mint()
	module.appendOp(cur, op: StdOp.osDescendants(answer, verbId: verb, bufId: nothing, capId: nothing))
	emitBranchOnCompare(module, block: cur, value: answer, pred: StdCmpPred.ne, against: 0, whenTrue: trackRefused, whenFalse: tracked, ids: ids)
	emitRuntimeFatal(module, func: func, block: trackRefused, fatal: RuntimeFatal.descendantTrackingUnavailable, ids: ids)

	match token 'token'
		absent then module.setTerminator(tracked, op: StdOp.branch(release.id))
		captured(copy) then emitSealAndPublishToken(module, func: func, tracked: tracked, target: target, name: name, value: value, release: release, copy: copy, ids: ids)
	end 'token'
end 'emitArmAction'

function emitSealAndPublishToken(module StdModule, func IrFunction, tracked IrBlock, target Target, name ValueId, value ValueId, release IrBlock, copy ValueId, ids ValueMinter)
	let sealed = module.addBlock(func, label: b"descsealed", heat: BlockHeat.normal)

	match environmentSnapshotShape(target) 'seal'
		nulSeparatedBlock then emitSealThroughHostCall(module, func: func, cur: tracked, name: name, value: value, sealed: sealed, ids: ids)
		pointerVector then emitSealInEnvironmentVector(module, func: func, cur: tracked, sealed: sealed, ids: ids)
		hostEntryList then panic("emitArmAction: a lane that receives its environment as a host list provides no descendant tracking, so it has no token to seal")
	end 'seal'

	emitStoreGlobalWord(module, block: sealed, label: SchedDescendantsArmedLabel, value: copy, ids: ids)
	module.setTerminator(sealed, op: StdOp.branch(release.id))
end 'emitSealAndPublishToken'

function emitSealThroughHostCall(module StdModule, func IrFunction, cur IrBlock, name ValueId, value ValueId, sealed IrBlock, ids ValueMinter)
	let refused = module.addBlock(func, label: b"descsealrefused", heat: BlockHeat.cold)

	let zero = emitConst(module, block: cur, value: 0, ids: ids)
	let inert = emitConst(module, block: cur, value: DescendantsInertMark, ids: ids)
	emitStoreByte(module, block: cur, base: value, index: zero, value: inert, ids: ids)

	let verb = emitConst(module, block: cur, value: ProcessDescendantsVerbSeal, ids: ids)
	let answer = ids.mint()
	module.appendOp(cur, op: StdOp.osDescendants(answer, verbId: verb, bufId: name, capId: value))
	emitBranchOnCompare(module, block: cur, value: answer, pred: StdCmpPred.ne, against: 0, whenTrue: refused, whenFalse: sealed, ids: ids)
	emitRuntimeFatal(module, func: func, block: refused, fatal: RuntimeFatal.descendantTokenUnsealable, ids: ids)
end 'emitSealThroughHostCall'

function emitSealInEnvironmentVector(module StdModule, func IrFunction, cur IrBlock, sealed IrBlock, ids ValueMinter)
	let scan = module.addBlock(func, label: b"descenvscan", heat: BlockHeat.normal)
	let inspect = module.addBlock(func, label: b"descenvinspect", heat: BlockHeat.normal)
	let matched = module.addBlock(func, label: b"descenvmatched", heat: BlockHeat.normal)
	let advance = module.addBlock(func, label: b"descenvnext", heat: BlockHeat.normal)
	let missing = module.addBlock(func, label: b"descenvmissing", heat: BlockHeat.cold)

	let vector = ids.mint()
	module.appendOp(cur, op: StdOp.osEnvBlock(vector))
	let firstIndex = emitConst(module, block: cur, value: 0, ids: ids)
	let index = ids.mint()
	scan.blockArgs.push(IrBlockArg.create(index, argType: StdType.i64))
	emitBranchOnCompare(module, block: cur, value: vector, pred: StdCmpPred.eq, against: 0, whenTrue: missing, whenFalse: scan, ids: ids)
	pushBranchEdge(cur, to: scan, values: argsOf(firstIndex))

	let stride = emitConst(module, block: scan, value: EnvPointerStride, ids: ids)
	let displacement = emitBin(module, block: scan, a: index, b: stride, opcode: StdBinOpcode.mul, ids: ids)
	let slot = emitBin(module, block: scan, a: vector, b: displacement, opcode: StdBinOpcode.add, ids: ids)
	let entry = emitLoadField(module, block: scan, record: slot, offset: 0, ids: ids)
	emitBranchOnCompare(module, block: scan, value: entry, pred: StdCmpPred.eq, against: 0, whenTrue: missing, whenFalse: inspect, ids: ids)

	let sameName = emitCStringStartsWithLiteral(module, block: inspect, cstr: entry, literal: DescendantsEnvName, ids: ids)
	let separated = emitByteAtEquals(module, block: inspect, cstr: entry, index: DescendantsEnvName.count() as FullRangeInt, expected: EnvEntrySeparator, ids: ids)
	let isOurs = emitBin(module, block: inspect, a: sameName, b: separated, opcode: StdBinOpcode.bitAnd, ids: ids)
	module.setTerminator(inspect, op: StdOp.condBranch(isOurs, thenBlockId: matched.id, elseBlockId: advance.id))

	let valueIndex = emitConst(module, block: matched, value: (DescendantsEnvName.count() + 1) as FullRangeInt, ids: ids)
	let inert = emitConst(module, block: matched, value: DescendantsInertMark, ids: ids)
	emitStoreByte(module, block: matched, base: entry, index: valueIndex, value: inert, ids: ids)
	module.setTerminator(matched, op: StdOp.branch(sealed.id))

	let one = emitConst(module, block: advance, value: 1, ids: ids)
	let next = emitBin(module, block: advance, a: index, b: one, opcode: StdBinOpcode.add, ids: ids)
	emitBranchCarrying(module, from: advance, to: scan, values: argsOf(next))

	emitRuntimeFatal(module, func: func, block: missing, fatal: RuntimeFatal.descendantTokenUnsealable, ids: ids)
end 'emitSealInEnvironmentVector'

export function armedDescendantsValue(token String) returns String
	let value = token.toByteArray()

	value.insert(0, value: DescendantsArmedMark as Byte)

	return String.from(value)
end 'armedDescendantsValue'

export function descendantsFramePrefix() returns String
	return "{SpecMarkerWrapper}{DescendantsFrameTag}"
end 'descendantsFramePrefix'

// The exit code passes through untouched; the verdict is the framed lines on stderr, which the spec and
// test harnesses read (`StderrAudit`). The audit follows `gtQuiesce`, so a child a green thread is
// still awaiting has ended and is not reported. Each frame is assembled whole and written in one
// stderr write, so a live child writing to the same stream cannot split it.
function buildProcessDescendantGate(module StdModule)
	let func = IrFunction.createFromStd(ProcessDescendantGateName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), needsGreenThreadStackGuard: true)
	let ids = ValueMinter.create(1)

	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	let unarmed = module.addBlock(func, label: b"gateunarmed", heat: BlockHeat.normal)
	let audit = module.addBlock(func, label: b"gateaudit", heat: BlockHeat.normal)
	let listed = module.addBlock(func, label: b"gatelisted", heat: BlockHeat.normal)
	let unlisted = module.addBlock(func, label: b"gateunlisted", heat: BlockHeat.cold)
	let capped = module.addBlock(func, label: b"gatecapped", heat: BlockHeat.cold)
	let scanStart = module.addBlock(func, label: b"gatescan", heat: BlockHeat.normal)
	let scanHeader = module.addBlock(func, label: b"gatescanhdr", heat: BlockHeat.normal)
	let scanLook = module.addBlock(func, label: b"gatescanlook", heat: BlockHeat.normal)
	let scanByte = module.addBlock(func, label: b"gatescanbyte", heat: BlockHeat.normal)
	let scanLine = module.addBlock(func, label: b"gatescanline", heat: BlockHeat.normal)
	let scanStep = module.addBlock(func, label: b"gatescanstep", heat: BlockHeat.normal)
	let finished = module.addBlock(func, label: b"gatedone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let code = 0 as ValueId
	let armed = emitLoadGlobalWord(module, block: entry, label: SchedDescendantsArmedLabel, ids: ids)
	emitBranchOnCompare(module, block: entry, value: armed, pred: StdCmpPred.eq, against: 0, whenTrue: unarmed, whenFalse: audit, ids: ids)
	module.setTerminator(unarmed, op: StdOp.ret(code))

	module.appendOp(audit, op: StdOp.call(ids.mint(), callee: GtQuiesceName, args: ValueIdArray.create(0)))
	let capacity = emitConst(module, block: audit, value: DescendantGateReportBytes, ids: ids)
	let report = emitSlabAlloc(module, block: audit, bytes: capacity, kind: SlabBufferKind.hostText, ids: ids)
	let framePrefix = descendantsFramePrefix().toByteArray()
	let prefix = emitLiteralCString(module, block: audit, ids: ids, text: framePrefix)
	let separatorBytes = DescendantsFrameTokenSeparator.toByteArray()
	let separatorByte = try separatorBytes.get(0) otherwise panic("buildProcessDescendantGate: the frame token separator is not empty")
	let verb = emitConst(module, block: audit, value: ProcessDescendantsVerbEnd, ids: ids)
	let needed = ids.mint()
	module.appendOp(audit, op: StdOp.osDescendants(needed, verbId: verb, bufId: report, capId: capacity))
	emitBranchOnCompare(module, block: audit, value: needed, pred: StdCmpPred.lt, against: 0, whenTrue: unlisted, whenFalse: listed, ids: ids)
	emitRuntimeFatal(module, func: func, block: unlisted, fatal: RuntimeFatal.descendantListingFailed, ids: ids)

	emitBranchOnCompareValues(module, block: listed, a: needed, pred: StdCmpPred.gt, b: capacity, whenTrue: capped, whenFalse: scanStart, ids: ids)
	emitRuntimeFatal(module, func: func, block: capped, fatal: RuntimeFatal.descendantReportTruncated, ids: ids)

	let tokenLength = emitLoadField(module, block: scanStart, record: armed, offset: DescendantTokenLengthOffset, ids: ids)
	let tokenOffset = emitConst(module, block: scanStart, value: DescendantTokenBytesOffset, ids: ids)
	let token = emitBin(module, block: scanStart, a: armed, b: tokenOffset, opcode: StdBinOpcode.add, ids: ids)

	let index = ids.mint()
	let lineStart = ids.mint()
	scanHeader.blockArgs.push(IrBlockArg.create(index, argType: StdType.i64))
	scanHeader.blockArgs.push(IrBlockArg.create(lineStart, argType: StdType.i64))
	let origin = emitConst(module, block: scanStart, value: 0, ids: ids)
	emitBranchCarrying(module, from: scanStart, to: scanHeader, values: twoArgs(origin, second: origin))

	emitBranchOnCompareValues(module, block: scanHeader, a: index, pred: StdCmpPred.ge, b: needed, whenTrue: finished, whenFalse: scanLook, ids: ids)
	let byte = emitLoadByteIndexed(module, block: scanLook, base: report, index: index, ids: ids)
	emitBranchOnCompare(module, block: scanLook, value: byte, pred: StdCmpPred.eq, against: 0, whenTrue: finished, whenFalse: scanByte, ids: ids)
	emitBranchOnCompare(module, block: scanByte, value: byte, pred: StdCmpPred.eq, against: DescendantGateLineEnd, whenTrue: scanLine, whenFalse: scanStep, ids: ids)

	let prefixLength = emitConst(module, block: scanLine, value: framePrefix.count() as FullRangeInt, ids: ids)
	let one = emitConst(module, block: scanLine, value: 1, ids: ids)
	let lineEnd = emitBin(module, block: scanLine, a: index, b: one, opcode: StdBinOpcode.add, ids: ids)
	let lineAddress = emitBin(module, block: scanLine, a: report, b: lineStart, opcode: StdBinOpcode.add, ids: ids)
	let lineLength = emitBin(module, block: scanLine, a: index, b: lineStart, opcode: StdBinOpcode.sub, ids: ids)

	let beforeToken = emitBin(module, block: scanLine, a: prefixLength, b: lineLength, opcode: StdBinOpcode.add, ids: ids)
	let throughSeparator = emitBin(module, block: scanLine, a: beforeToken, b: one, opcode: StdBinOpcode.add, ids: ids)
	let throughToken = emitBin(module, block: scanLine, a: throughSeparator, b: tokenLength, opcode: StdBinOpcode.add, ids: ids)
	let frameLength = emitBin(module, block: scanLine, a: throughToken, b: one, opcode: StdBinOpcode.add, ids: ids)
	let frame = emitSlabAlloc(module, block: scanLine, bytes: frameLength, kind: SlabBufferKind.hostText, ids: ids)
	let nameAddress = emitBin(module, block: scanLine, a: frame, b: prefixLength, opcode: StdBinOpcode.add, ids: ids)
	let separatorAddress = emitBin(module, block: scanLine, a: frame, b: beforeToken, opcode: StdBinOpcode.add, ids: ids)
	let tokenAddress = emitBin(module, block: scanLine, a: frame, b: throughSeparator, opcode: StdBinOpcode.add, ids: ids)
	let terminatorAddress = emitBin(module, block: scanLine, a: frame, b: throughToken, opcode: StdBinOpcode.add, ids: ids)
	let zero = emitConst(module, block: scanLine, value: 0, ids: ids)
	let separator = emitConst(module, block: scanLine, value: separatorByte as FullRangeInt, ids: ids)
	let lineFeed = emitConst(module, block: scanLine, value: DescendantGateLineEnd, ids: ids)

	let prefixCopied = emitForwardCopy(module, func: func, cur: scanLine, dest: frame, src: prefix, byteCount: prefixLength, ids: ids)
	let nameCopied = emitForwardCopy(module, func: func, cur: prefixCopied, dest: nameAddress, src: lineAddress, byteCount: lineLength, ids: ids)
	emitStoreByte(module, block: nameCopied, base: separatorAddress, index: zero, value: separator, ids: ids)

	let tokenCopied = emitForwardCopy(module, func: func, cur: nameCopied, dest: tokenAddress, src: token, byteCount: tokenLength, ids: ids)
	emitStoreByte(module, block: tokenCopied, base: terminatorAddress, index: zero, value: lineFeed, ids: ids)
	module.appendOp(tokenCopied, op: StdOp.osWriteStderr(ids.mint(), bufId: frame, lenId: frameLength))
	emitSlabFree(module, block: tokenCopied, ptr: frame, kind: SlabBufferKind.hostText, ids: ids)
	emitBranchCarrying(module, from: tokenCopied, to: scanHeader, values: twoArgs(lineEnd, second: lineEnd))

	let stepOne = emitConst(module, block: scanStep, value: 1, ids: ids)
	let nextIndex = emitBin(module, block: scanStep, a: index, b: stepOne, opcode: StdBinOpcode.add, ids: ids)
	emitBranchCarrying(module, from: scanStep, to: scanHeader, values: twoArgs(nextIndex, second: lineStart))

	emitSlabFree(module, block: finished, ptr: report, kind: SlabBufferKind.hostText, ids: ids)
	emitSlabFree(module, block: finished, ptr: prefix, kind: SlabBufferKind.hostText, ids: ids)
	emitSlabFree(module, block: finished, ptr: armed, kind: SlabBufferKind.environmentValue, ids: ids)
	module.setTerminator(finished, op: StdOp.ret(code))

	module.functions.push(func)
end 'buildProcessDescendantGate'

// ⭐ **THE FAMILY'S BAND, AND IT ANSWERS FOR THE `processInfo` HALF.** `calleeHostFacility` reads it AFTER
// its by-name test for the priority write, so the write never reaches here. A PREFIX test rather than an
// `equals` against a roster of names, for `isCommandLineRuntimeCallee`'s reason: a further identity read is
// then covered by construction instead of having to be remembered at two sites.
// `specs/process-id.md:rejected-on-wasm` is the case that pins the E3104 `__proc_pid` earns by prefix alone.
//
// ⚠ **`scanRuntimeUsage` DOES NOT READ THIS ONE.** It asks for the path walk by NAME, because a prefix is
// the right test for "may this target run it at all" — one answer for the family — and the wrong test for
// "must this program carry it", which is per entry point and costs wildly different amounts here.
export function isProcessRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: ProcessRuntimePrefix)
end 'isProcessRuntimeCallee'

export let ProcessTierFileName = "Process.maxon"

export function checkProcessDescendantsVerbs(signatures ProgramSignatures, tierPath FilePath)
	let pins = TierGeometryPinArray.create(0)
	pins.push(TierGeometryPin.create("the end verb", here: ProcessDescendantsVerbEnd, named: "DescendantsVerbEnd"))
	requireTierGeometryAgrees(pins, signatures: signatures, tierPath: tierPath, emitterFile: "Compiler/Runtime/ProcessRuntime.maxon", layer: "checkProcessDescendantsVerbs")
end 'checkProcessDescendantsVerbs'

export function isProcessDescendantsRuntimeCallee(callee ByteArray) returns bool
	return callee.equals(ProcessEndDescendantsTextName)
end 'isProcessDescendantsRuntimeCallee'
