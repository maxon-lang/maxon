// Runtime/MmRuntime.maxon — the emitted memory-management runtime (Workstream R, slice R1).
//
// ⭐ THIS IS A BUILDER-BUILT `StdModule`, NOT HAND-ASSEMBLED BYTES, and that was a decision taken
// on purpose rather than by inertia (PLAN.md's R1 box exists to force exactly this). The panic
// runtime (P1.0d.3) IS hand-assembled, and that was right for it: the OS calls a VEH thunk with a
// raw ABI, so there is no Maxon-level spelling of "read CONTEXT.Rip". The allocator is not such a
// case — it needs only ordinary calls, arithmetic, loads and stores. Building it as `StdOp`s means
// it gets register allocation, the frame layout, and target-independence for FREE, and every later
// slice of the runtime is IR rather than opcodes. `mrt_start`
// (`BackendDispatch.prependEntryStub`) already proves the builder path end-to-end at the Target
// tier; this is the same idea one tier up.
//
// ⭐⭐ **THE ALLOCATOR IS NOT HERE.** It is `SlabRuntime.maxon` (Go's 68-class ladder, spans with a
// hybrid free list and virgin bump region, an mcache at full shard width, an OS-direct tier) over
// `SlabArena.maxon`'s chunk arena. What lives here is the BOX layer: the header, the refcount, the
// destructor cascade and the leak gate.
//
// ⭐⭐ **AND THERE IS EXACTLY ONE ALLOCATOR IN THE EMITTED RUNTIME.** A second one in this file —
// size-classed free lists in a `.data`-rooted table serving a repeat box out of their own buckets and
// asking `__slab_alloc` only on a miss — would be two size-class ladders, two reuse policies and two
// places a box can be live. `__mm_alloc` asks `__slab_alloc` for the WHOLE box (header + payload) and
// `__mm_free` hands that same pointer to `__slab_free`; the span the slot came from knows its class, so
// the box layer computes none.
//
// ⚠ **THE WHOLE SIZE DOMAIN IS RECLAIMED, WHICH IS GO'S BOUNDARY.** The slab recycles up to
// `SlabMaxSmallSize` (32 KiB, the whole box) through spans and serves everything above it from its own
// mapping — which `__slab_free` hands BACK to the OS. `specs/slab-allocator.md`'s
// `an-os-direct-buffer-round-trips` and `os-direct-mappings-coexist` are what stand behind that second
// half.
//
// ⚠ **A `--debugstream` BUILD RECYCLES TOO, AND ITS TRACE STAYS UNAMBIGUOUS**, so it needs no
// non-recycling fork: the packed id is stamped PER ALLOCATION, not per address (it pre-increments
// `__ds_alloc_id`), and `__mm_free` emits its event BEFORE the reclaim — so a reused address reads
// `free(id=7)` … `alloc(id=9)` in that order and no two live boxes ever share an id. MEASURED on
// `multicore-stress/alloc-torture.maxon --small` under `MAXON_MAX_PROCS=1`: 840 allocations with 840
// DISTINCT ids, 840 frees naming exactly those ids, 0 events dropped.
//
// ⭐ **AND THE FILE OWNS BOTH HALVES OF A MANAGED VALUE'S LIFECYCLE: the per-type DESTRUCTOR cascade
// (`__destruct_<T>`) and its DEEP-CLONE dual (`__clone_<T>`).** The two walk the same field graph in
// opposite directions, close over the same `CascadeWorklist`, and `noteRelocatedFunctionUsage` re-enters
// both — so a change to what "a managed field" means is one file, not two.

// The header sits IMMEDIATELY BEFORE the user pointer, so a managed pointer is usable as a plain
// pointer: `p.x` is `[p+0]`, and nothing downstream needs to know a header exists. The layout is
// `[-24] destructor · [-16] size · [-8] refcount`, expressed from the header BASE
// because `ByteOffset` is `int(0 to u64.max)` — UNSIGNED — so a negative displacement is not
// representable in a `loadIndirect`. The header is addressed as `ptr - HeaderBytes` once and read
// at positive offsets from there, which costs one `sub` per header access and keeps the offset
// type honest. (Making `ByteOffset` signed was the alternative and is wrong: it is shared with the
// PE writer, where a file offset genuinely cannot be negative.)
//
// ⚠ THREE WORDS, NOT FOUR. The MM-TRACE `packedId` word is paid for only in a `--debugstream`
// build, where it sits BELOW the three fields rather than among them (`DebugStreamPackedIdBytes`):
// an unconditional word would be 8 bytes of nothing on every allocation in a program nobody is
// tracing.
let HeaderDestructorOffset = 0 as ByteOffset

// ⭐⭐ **THE SIZE FIELD HOLDS THE SIZE THE CALLER ASKED FOR, AND SINCE S4 THAT IS ITS ONLY MEANING.**
// Between S2 and S4 it held the ROUNDED size instead, because `__mm_free` recovered the free-list bucket
// by SHIFTING it and a caller's 40 would have returned a 40-byte box to the 48-byte bucket. The span now
// knows the class, so nothing asks this field a question about the ALLOCATOR — the one reader left is
// `__mm_free`'s poison range, which wants exactly the bytes the caller could write, and `[ptr + size,
// slot end)` is slack the caller never saw. One fact, one place: what the program asked for.
let HeaderSizeOffset = 8 as ByteOffset

// ⭐ **THE HEADER GEOMETRY IS PRIVATE TO THIS FILE, AND STAYS THAT WAY.** Every reader outside it —
// `StringRuntime.__str_decref`, `ManagedMemoryRuntime.__managed_cow_detach`, the struct/union/instance destructor
// cascades — reaches the refcount through the exported BUILDERS below (`emitRefcountCheckToLastOwner`,
// `emitIsSharedAllocation`), never by respelling `ptr - HeaderBytes + HeaderRefcountOffset`. That is what
// makes "where the refcount lives" one fact rather than one per caller: a header that grew a field would
// be a change to `emitHeaderBase` and nothing else, and a caller that got it wrong could not compile.
let HeaderRefcountOffset = 16 as ByteOffset
let HeaderBytes = 24

// ⭐⭐ **THE `--debugstream` PREFIX WORD — `(alloc_id << 16 | tag_index)`, AND IT SITS *BELOW* THE HEADER
// ON PURPOSE (Workstream O3).** `mm_incref`/`mm_decref`/`mm_free` know only a POINTER, so the id and the
// type tag an mm-trace event needs must live in the box; `__mm_alloc` is the one place that knows both.
//
// ⚠ **PUTTING IT BELOW THE THREE EXISTING FIELDS RATHER THAN AMONG THEM IS THE WHOLE OF WHY THIS IS A
// SMALL CHANGE.** `ptr - HeaderBytes` still addresses `destructor`/`size`/`refcount` at exactly the
// offsets they have always had, so `emitHeaderBase` and every reader that goes through it — including
// `StringRuntime` and `ManagedMemoryRuntime`, which reach the refcount through this file's exported
// builders — are untouched. Only `__mm_alloc` (which computes the total and the payload offset) and
// `emitLoadPackedId` below know the word exists.
//
// ⚠⚠ **IT IS PRESENT ONLY UNDER `--debugstream`.** A normal build's box is 24 bytes of header exactly as
// before, which is half of the compile-time gating rule (`DebugStreamRuntime`'s header states the other
// half): 8 bytes on EVERY allocation in the language is not a price a debug instrument may charge a
// program that is not being traced.
let DebugStreamPackedIdBytes = 8

// The bytes `__mm_alloc` prepends to the payload — the header, plus the DebugStream word when this build
// carries one. ONE derivation, read by the allocation itself and by `emitLoadPackedId`, so the two cannot
// disagree about where the payload starts. (`emitBoxAllocationBase` walks the SAME distance in two hops,
// from a header base a caller already holds, so an untraced build spends no op on a displacement of zero;
// both routes come out of `HeaderBytes` and `DebugStreamPackedIdBytes` and there is no third number.)
function boxPrefixBytes(debugStream bool) returns ParsedInt
	// ⚠ THE PARENTHESES ARE LOAD-BEARING. `a + b if c else d` binds as `a + (b if c else d)`, so the
	// unparenthesized form returned `HeaderBytes + HeaderBytes` on an UNTRACED build — a 48-byte prefix
	// where every box has always had 24. It compiled, it linked, and it was found only by the
	// byte-identical check against a control build.
	return (HeaderBytes + DebugStreamPackedIdBytes) if debugStream else HeaderBytes
end 'boxPrefixBytes'

// ⭐⭐ **THE REFCOUNT AN IMAGE RECORD'S SYNTHETIC HEADER CARRIES — the mark that says "this box was never
// allocated", for a record of ANY SHAPE.**
//
// `BufferOwnership.emitRecordIsImmortal` can only mark a `__ManagedMemory`-shaped record, because it reads
// `capacity@16` — a slot a user struct does not have, where offset 16 is whatever the author declared. The
// mark for an arbitrary record therefore has to live OUTSIDE it, and the allocation header every managed
// box is addressed through is the one thing every record shape shares.
//
// ⚠ **THE VALUE'S PROPERTIES ARE WHAT MATTER.** 2^62 is positive, far from 0, far from
// wrapping and unreachable by a real count — a program cannot hold 2^62 owners of one box — so no
// arithmetic on a live refcount arrives at it and no pointer-shaped guard mistakes it for an address.
let MmImmortalRefcount = 4611686018427387904 as ParsedInt  // 0x4000_0000_0000_0000 = 2^62

// ⭐⭐ **THE MARK A LENT RECORD'S COUNT CARRIES — the word is `mark + owners - 1` from the lend on.** A lend adds
// it once, on the sender's own green thread at the walk's first meeting of the record (`emitBoxWalkStep`), and from
// then on every step of that count is ATOMIC, because a second green thread may hold the record.
//
// ⚠ **THE VALUE'S PROPERTIES ARE WHAT MATTER.** A counted word stays below it — its transient `-1` after the
// last owner leaves is below it too, the compare being signed — and a shared count stays below
// `MmImmortalRefcount`, because no program holds 2^61 owners of one box. So ONE signed compare tells a
// counted box from the other two, and the counted box is the common one.
let MmSharedRefcountMark = 2305843009213693952 as ParsedInt  // 0x2000_0000_0000_0000 = 2^61

// A header field is one machine word: the three offsets above are eight apart because of it, and the
// DebugStream prefix word below them is the same width.
let HeaderSlotBytes = 8 as BytePos

// `destructor@0` for a record that has none, and the packed id of a box that was never allocated — both
// zero, and named apart because they answer different questions in the two slots they fill.
export let NoDestructor = 0 as ParsedInt
let NoAllocationId = 0 as ParsedInt

// ⭐⭐ **THE SYNTHETIC ALLOCATION HEADER AN IMAGE RECORD IS REGISTERED BEHIND** — the bytes that sit in
// `.rdata` immediately before the record, so that `ptr - HeaderBytes` reaches a header saying "immortal"
// rather than whatever payload the section packer happened to place there.
//
// ⚠ **THE SIZE COMES FROM `boxPrefixBytes`, THE VERY FUNCTION `__mm_alloc` SIZES ITS OWN PREFIX WITH.** A
// `--debugstream` build carries the packed-id word BELOW the three fields, so the prefix is 32 there and 24
// otherwise; a header minted at a literal 24 would leave a traced build reading an image record's id out of
// the `.rdata` payload in front of it.
//
// ⭐⭐ **`size@8` IS THE RECORD'S OWN BYTE COUNT, AND ITS ONE READER IS `__mm_own`'s COPY ARM.** A durable
// sink handed an image record must be given a PRIVATE box instead, and the extent of that copy has to come
// from somewhere a runtime can read; the header is the only thing every record shape shares.
//
// ⛔ **IT IS ALSO WHAT A MISSED IMMORTALITY TEST WOULD USE, AND NO VALUE MAKES THAT ARM SAFE**: `__mm_free`
// would hand `__slab_free` an `.rdata` address whatever this word said. So the field is TRUE, and the
// guarantee is the test at the release door (`emitRefcountCheckToLastOwner`) — `__mm_free`'s own header
// states why the test cannot live there instead.
//
// The packed-id word a traced build carries is zero: an image record has no allocation id because it was
// never allocated, and nothing reads it — every mm-trace event is emitted past a test that has already sent
// an immortal record home.
//
// Each slot is appended at its named offset and the appender refuses to write it anywhere else, so the
// offsets the runtime loads by and the offsets this writes are one set of constants that cannot drift —
// `BufferOwnership.appendRecordSlot`'s discipline, applied to the header the record is addressed through.
export function immortalBoxHeaderBytes(debugStream bool, recordBytes ParsedInt) returns ByteArray
	var header = ByteArray.create()

	if debugStream 'tracedBuild'
		header.append(scalarImage(NoAllocationId, byteCount: HeaderSlotBytes))
	end 'tracedBuild'

	let base = header.count() as ByteOffset
	appendHeaderSlot(header, base: base, expectedOffset: HeaderDestructorOffset, value: NoDestructor)
	appendHeaderSlot(header, base: base, expectedOffset: HeaderSizeOffset, value: recordBytes)
	appendHeaderSlot(header, base: base, expectedOffset: HeaderRefcountOffset, value: MmImmortalRefcount)

	if header.count() != boxPrefixBytes(debugStream) 'sizeDrift'
		panic("immortalBoxHeaderBytes: assembled {header.count()} bytes, not the {boxPrefixBytes(debugStream)} `__mm_alloc` prepends — an image record addressed through a header of the wrong width reads its neighbour's bytes")
	end 'sizeDrift'

	return header
end 'immortalBoxHeaderBytes'

// Where inside an image record's `.rdata` payload the record itself begins — the bytes the header above
// spends, and therefore where the payload's LABEL points. Derived from `boxPrefixBytes`, the same number
// `immortalBoxHeaderBytes` asserts its own length against, so an address and the bytes at it cannot drift.
export function immortalBoxHeaderSize(debugStream bool) returns ByteOffset
	return boxPrefixBytes(debugStream) as ByteOffset
end 'immortalBoxHeaderSize'

// Append one header word at `expectedOffset` from the header BASE, refusing to write it anywhere else.
function appendHeaderSlot(header ByteArray, base ByteOffset, expectedOffset ByteOffset, value ParsedInt)
	if (header.count() as ByteOffset) - base != expectedOffset 'offsetDrift'
		panic("appendHeaderSlot: a header field is being written at offset {(header.count() as ByteOffset) - base} but its constant says {expectedOffset} — the header layout the runtime reads and this writes have drifted")
	end 'offsetDrift'

	header.append(scalarImage(value, byteCount: HeaderSlotBytes))
end 'appendHeaderSlot'

// ⭐⭐ **WHICH OF THE THREE KINDS OF COUNT A BOX'S HEADER HOLDS — the ONE home of that routing, and of which
// way round each `condBranch` goes.** `word` is the box's refcount word:
//
//   • COUNTED — below `MmSharedRefcountMark`. One green thread owns the box, so its count steps PLAIN.
//   • IMMORTAL — exactly `MmImmortalRefcount`. Image data in `.rdata`: nothing may write the header, and there
//     is nothing to count, because the record outlives every owner.
//   • SHARED — a lend marked it. Its count steps ATOMICALLY, and its graph is frozen.
//
// Every door that touches a header routes through here: the owner-count step (`emitStepOwnerCount`, which
// every acquire and every release takes) and the walk step (`emitBoxWalkStep`, which every soleness and share
// walk takes).
//
// ⛔⛔ **IT IS NOT `BufferOwnership.emitRecordIsImmortal` AND THE TWO ARE NEVER INTERCHANGEABLE.** That one
// asks a RECORD question at `capacity@16` and is safe only on a `__ManagedMemory`-shaped record; this asks a
// BOX question at the header and is safe only on a pointer `__mm_alloc` returned or an image record
// registered behind `immortalBoxHeaderBytes`. The joint invariant that keeps them from disagreeing is
// `BufferOwnership.immortalRecordPayload`'s: a capacity-bearing image record carries BOTH marks.
//
// ⚠ Written once for `emitRefuseNonOwnedFillTarget`'s stated reason: swap two edges in one copy and that door
// stops guarding while its twins keep working, so nothing goes red — and what goes wrong then is a write into
// a read-only page, or a lost update on a count two green threads step.
function emitRouteOnRefcountWord(module StdModule, func IrFunction, block IrBlock, word ValueId, counted IrBlock, immortal IrBlock, shared IrBlock, ids ValueMinter)
	var uncounted = module.addBlock(func, label: b"uncounted", heat: BlockHeat.normal)

	let isCounted = emitIsCountedWord(module, block: block, word: word, ids: ids)
	module.setTerminator(block, op: StdOp.condBranch(isCounted, thenBlockId: counted.id, elseBlockId: uncounted.id))

	let sentinel = emitConst(module, block: uncounted, value: MmImmortalRefcount, ids: ids)
	let isImmortal = emitCmp(module, block: uncounted, a: word, b: sentinel, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(uncounted, op: StdOp.condBranch(isImmortal, thenBlockId: immortal.id, elseBlockId: shared.id))
end 'emitRouteOnRefcountWord'

// ⛔⛔ **THE SIZE-CLASSED FREE LISTS STOOD HERE AND WENT WITH THE CUTOVER (S4).** They were a
// 16-byte-granular bucket table (`__mm_free_lists`, its 128 KB array committed lazily by
// `__mm_free_lists_base`, threaded LIFO through each dead box's own payload) and they existed for one
// stated reason: the allocator BENEATH them reclaimed nothing, so a program's peak RSS was its TOTAL
// allocation rather than its LIVE one — which is what the slab now has to hold on its own.
//
// They are gone rather than kept beside the slab because a second size-class ladder over a real one is not
// a cache, it is a FORK: two granularities, two reuse policies, and a dead box whose bytes could be live in
// either. What replaced each piece is one layer down — the rounding is `emitSlabClassIndex`'s reverse-table
// read, the bucket is the owning span's own free list, and the lazily-committed table is `__slab_state`.

// ⭐⭐ **THE BOX LAYER KEEPS NO `.data` WORD.** Its counters — the leak gate's live count and the two
// traffic columns `__Builtins.mm*()` read — are the TRACKED trio of the slab's per-row traffic columns
// (`SlabRuntime.SlabTrafficColumn`), stepped by `__mm_alloc`/`__mm_free` on the calling thread's own row
// and summed by a reader. A `.data` word would be one shared counter every thread steps, and every heap
// program's golden renders the `data {` table it would sit in.
//
// ⭐⭐ **TWO LAYERS, NESTED: EVERY BOX IS ALSO A SLAB REQUEST.** The RAW trio counts every request at the
// slab doors, boxes included; the TRACKED trio counts boxes at the box doors. The public raw readers
// answer raw − tracked (`buildMmCounterAccessors`), so the layers they report are disjoint while the
// allocator carries ONE door per shape. `__mm_alloc_bytes` records the PAYLOAD the caller asked for,
// so the raw reader also subtracts the box prefix per box to keep its answer the header-free volume.

export let MmIncrefName = b"__mm_incref"
export let MmRetainName = b"__mm_retain"

// ⭐⭐ **`__mm_own(box) -> box` — the co-own a DURABLE SINK owes a plain box: `__mm_retain` for a heap one
// and a private COPY for an image record.** See `buildMmOwn` for the defect the plain incref was.
export let MmOwnName = b"__mm_own"

// ⭐⭐ **`__mm_own_deep(box, cloner) -> box` — the co-own a DURABLE SINK owes a box whose SLOTS address
// other records.** `__mm_own`'s blit is sound only for a box of scalars; see `buildMmOwnDeep`.
export let MmOwnDeepName = b"__mm_own_deep"
export let MmAllocName = b"__mm_alloc"
export let MmDecrefName = b"__mm_decref"
export let MmFreeName = b"__mm_free"
export let MmLeakCheckName = b"__mm_leak_check"

// ⭐⭐ **THE SIX MEMORY-TRAFFIC COUNTER ACCESSORS — the floor of `__Builtins.mmAllocTotal()` and its five
// siblings.** Each walks one figure over every row, PER LAYER, because only the raw live count can say
// whether a header-free BUFFER leaked.
//
// ⛔ **FOUR OF THE SIX ARE DIFFERENCES, SO A BRACKET CANNOT BE TAKEN OVER THEM.** A live figure is a total
// less its frees, and a raw figure is the raw column less the tracked one — two columns a box steps at two
// different instants — so a reading taken while another thread allocates can stand below an earlier one.
// The process-wide totals below are the figures a delta can be taken over while other threads run.
//
// ⭐ **THEY WEAR THE `__mm_` PREFIX ON PURPOSE, WHICH IS WHAT DECLARES THE HEAP DEPENDENCY.**
// `isRuntimeCallee` matches them, so a program that reads a counter carries the allocator whose state that
// counter IS. The columns are maintained in every heap program; a reader is what `DeadFunctionElimination`
// keeps only where something calls it.

export let MmCounterAllocTotalName = b"__mm_counter_alloc_total"
export let MmCounterAllocLiveName = b"__mm_counter_alloc_live"
export let MmCounterAllocBytesName = b"__mm_counter_alloc_bytes"
export let MmCounterRawAllocTotalName = b"__mm_counter_raw_alloc_total"
export let MmCounterRawAllocLiveName = b"__mm_counter_raw_alloc_live"
export let MmCounterRawAllocBytesName = b"__mm_counter_raw_alloc_bytes"

// Bucket `i`'s cumulative allocation count and bytes. Nothing subtracts a free, so these are CHURN and
// never a level: a phase's share of them is the difference of two readings.
export let MmCounterAllocTotalByTagName = b"__mm_counter_alloc_total_by_tag"
export let MmCounterAllocBytesByTagName = b"__mm_counter_alloc_bytes_by_tag"

let AllocTallyReaderArity = 1 as ParamCount
let AllocTallyBucketParamPosition = 0 as ParamCount
let AllocTallyLowestBucket = 0 as ParsedInt
let MachineWordSignShift = 63 as ParsedInt

// ⭐⭐⭐ **THE THREE PER-THREAD COLUMNS — allocations, frees and bytes asked of ONE GREEN THREAD.** Every
// process-wide figure counts every thread's traffic, so a bracket opened inside a pool worker would count
// every other worker's. `GtRuntime.GtOffThreadAllocs` carries the ownership argument that lets them be
// stepped unlocked.
//
// ⚠ **THEY SUM BOTH LAYERS, where the six above are per-layer**, because each is one green thread's share of
// a process-wide total below (`CombinedCount`): `PhaseProbe` brackets a pool worker with these and a
// main-thread phase with those, and the two must be one unit. They count frees rather than a live figure
// because a live count per green thread would be meaningless: a thread does not own the boxes it
// allocated, and it may exit with them alive and in use.
//
// They wear the `__mm_counter_` prefix for their siblings' reason: it is what turns on the allocation-path
// maintenance those columns oblige, and what makes a program that reads one carry the allocator it reads.
export let MmCounterThreadAllocsName = b"__mm_counter_thread_allocs"
export let MmCounterThreadFreesName = b"__mm_counter_thread_frees"
export let MmCounterThreadAllocBytesName = b"__mm_counter_thread_alloc_bytes"

// ⭐⭐⭐ **THE THREE PROCESS-WIDE TOTALS — the per-thread three asked of the whole process.** Each is ONE
// raw column summed over every row, with no subtraction anywhere: the raw columns count every slab request,
// boxes included, so each already covers both layers. Every word summed only rises, and a later reading
// loads each row after an earlier one did, so it is never below the earlier one whatever other threads are
// doing — the difference of two cannot go negative.
//
// ⚠ **THE BYTE TOTAL COUNTS A BOX's HEADER WITH ITS PAYLOAD**, exactly as the per-thread byte column does.
// The header-free volume (`mmAllocBytes + mmRawAllocBytes`) is not a total that only rises: a box credits its
// whole request to the raw layer first and then subtracts the header back out at its tracked step, so a
// reading between the two stands above one taken after.
export let MmCounterProcessAllocsName = b"__mm_counter_process_allocs"
export let MmCounterProcessFreesName = b"__mm_counter_process_frees"
export let MmCounterProcessAllocBytesName = b"__mm_counter_process_alloc_bytes"

// ⭐ **`__mm_is_null(ptr)` — IS THIS `__ManagedMemory` THE NULL SENTINEL?** The floor of
// `__Builtins.managedIsNull(mm)`, whose only corpus caller is `stdlib/Subprocess.maxon:487` testing the
// answer of a runtime lookup that may find nothing. It is an `__mm_` operation rather than a subprocess
// one because the question it asks is about a HEAP RECORD and about nothing else — any producer that can
// answer "no record" is a legitimate caller.
export let MmIsNullName = b"__mm_is_null"

// ⭐ **THE COPY-ON-WRITE DETACH, SHARED BY THE STRING AND ARRAY RECORDS** — `__managed_cow_detach` and
// `__managed_append` both reach it rather than each spelling the detach itself. Its NAME lives here, with the
// other `__mm_*` names, because this is the one list of them and `isRuntimeCallee`'s prefix rule is stated
// three lines below; its BODY is built in `BufferOwnership`, which owns the record layout it reads and the
// ownership encoding it republishes. See `buildMmCowDetach` for why it is an `__mm_` operation at all.
export let MmCowDetachName = b"__mm_cow_detach"

// ⭐ **THE NAME OF A MANAGED-PAYLOAD UNION'S SYNTHESIZED DESTRUCTOR — `__destruct_<UnionName>`** (P1.3
// slice 2). It is `__`-prefixed, so `isCompilerInternalCallee` routes its call past the user-function
// checks — no file declares it. ONE speller, so the DROP site (`Parser.decrefCalleeFor`), the USAGE scan
// (`recordCallUsage`) and the SYNTHESIS (`installUnionDestructors`) name it identically and cannot drift.
export let DestructorPrefix = b"__destruct_"

export function destructorSymbol(unionName ByteArray) returns ByteArray
	return "{String.from(DestructorPrefix)}{String.from(unionName)}".toByteArray()
end 'destructorSymbol'

// ⭐⭐⭐ **THE NAME OF A DECLARATION VIEW'S *DICTIONARY* DESTRUCTOR — `__destruct_dict_<mangled>(descriptor,
// box)` (BATCH41).** The `__destruct_<mangled>` a CONCRETE instance gets is a one-argument cascade whose every
// field drop is a symbol; a DECLARATION VIEW (`BagIter with Element` inside `type Bag uses Element`) has a
// field whose release is not a symbol at all but the enclosing instantiation's `destroyFunc@40`, so its
// cascade takes the layout descriptor as a SECOND parameter and releases that field through
// `__drop_type_param`.
//
// ⭐ **The compiler DOES NOT MONOMORPHIZE, AND THIS IS THAT SENTENCE APPLIED TO THE DROP.** The obvious alternative —
// mint `__destruct_BagIter_String` per instantiation and reach it through a table of per-instance descriptor
// pointers hanging off the enclosing blob — is the MONOMORPHIZING answer: it needs a new descriptor word, a
// blob, an ordering agreement between the party that writes the blob and the party that indexes it, and it
// re-derives at run time what the dictionary already carries. One shared body reading the dictionary it was
// handed is the same answer `sizeof(T)`, `__drop_type_param` and the opaque container create all take, and it
// costs no `.rdata` and no index.
//
// ⚠ **IT KEEPS THE `__destruct_` PREFIX ON PURPOSE**: `insertIfDestructorSymbol`, `recordCallUsage` and
// `TargetPrinter`'s runtime-symbol test all key on that prefix, and a family that needed each of them widened
// by hand is a family a fourth reader would miss. The infix is what tells the two apart where they must be
// told apart — the DROP site (`Parser.decrefCalleeFor`), the descriptor prepend
// (`LowerMaxonToStd.lowerRuntimeCall`) and the SYNTHESIS below.
let DictionaryDestructorPrefix = b"__destruct_dict_"

export function dictionaryDestructorSymbol(mangledInstanceName ByteArray) returns ByteArray
	return "{String.from(DictionaryDestructorPrefix)}{String.from(mangledInstanceName)}".toByteArray()
end 'dictionaryDestructorSymbol'

// Is `callee` one of the two-argument dictionary destructors above? The ONE test, read by the drop site's
// descriptor-reservation check and by the lowering that prepends the descriptor — a second spelling of it is
// how a call could come to be emitted with one argument and lowered with two.
export function isDictionaryDestructorCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: DictionaryDestructorPrefix)
end 'isDictionaryDestructorCallee'

// The dictionary destructor's signature, stated once: `(descriptor, box) -> void`, both machine words. The
// two parameter NUMBERS are named because the synthesis has to hand the descriptor's `ValueId` to every
// field drop that reads it, and a bare `0`/`1` there would read as an ordinal of something else. The plain
// one-argument cascade's box is named beside them so the two shapes are one table rather than a constant
// against a literal.
let DictionaryDestructorParamCount = 2 as ParamCount
let DictionaryDestructorDescriptorParam = 0 as ValueId
let DictionaryDestructorBoxParam = 1 as ValueId
let PlainDestructorParamCount = 1 as ParamCount
let PlainDestructorBoxParam = 0 as ValueId

// ⭐ **THE NAME OF A CONCRETE TYPE'S SYNTHESIZED DEEP-CLONER — `__clone_<TypeName>`** (P1.7 slice 3b-vi-b), the
// `(box) -> newBox` DUAL of `__destruct_<TypeName>`. `__`-prefixed, so `isCompilerInternalCallee` routes its
// call/`funcAddr` past the user-function checks and no file declares it. ONE speller, so the STAMP site
// (`Parser.arrayElementCloneValue` / the struct/union field cascade), the USAGE scan (`recordCallUsage`) and
// the SYNTHESIS (`installStructCascades`/`installUnionCascades`) name it identically and cannot drift — exactly as
// `DestructorPrefix`/`destructorSymbol` pair for the drop family.
export let ClonerPrefix = b"__clone_"

export function clonerSymbol(typeName ByteArray) returns ByteArray
	return "{String.from(ClonerPrefix)}{String.from(typeName)}".toByteArray()
end 'clonerSymbol'

// ⭐⭐ **THE NAME OF A CONCRETE TYPE'S SYNTHESIZED SOLENESS WALK — `__sole_<TypeName>`**, the THIRD
// per-type cascade beside the drop and the clone. Its `(box, visits) -> visits` body proves at run time what no
// compile-time tier can: that no COUNTED record reachable from `box` has an owner outside the graph, so the
// whole graph may MOVE to another green thread. A record the graph reaches several times is legal when those
// references are all its owners; one with an owner the walk never meets aborts
// (`RuntimeAbort.transferredRecordNotSole`, from `__mm_walk_settle`). A shared copy-on-write BUFFER is detached,
// because a move is a write-like event. `__`-prefixed for `ClonerPrefix`'s reason, and one speller for the same
// three parties.
export let SoleWalkPrefix = b"__sole_"

export function soleWalkSymbol(typeName ByteArray) returns ByteArray
	return "{String.from(SoleWalkPrefix)}{String.from(typeName)}".toByteArray()
end 'soleWalkSymbol'

// ⭐⭐ **THE NAME OF A CONCRETE TYPE'S SYNTHESIZED SHARE WALK — `__share_<TypeName>`**, the soleness walk's
// twin for a LEND. Its `(box, visits) -> visits` body marks every record reachable from `box` shared
// (`MmSharedRefcountMark`), so the sender may keep its reference while another green thread reads the same
// graph and every count in it steps atomically. A counted record with an owner outside the graph aborts exactly
// as the move's walk does: that owner is a path to a write the freeze cannot see.
export let ShareWalkPrefix = b"__share_"

export function shareWalkSymbol(typeName ByteArray) returns ByteArray
	return "{String.from(ShareWalkPrefix)}{String.from(typeName)}".toByteArray()
end 'shareWalkSymbol'

// ⭐ **`__mm_sole_box(box, visits)` / `__mm_share_box(box, visits)` — ONE BOX'S WALK STEP AS AN ENTRY OF ITS
// OWN**, for the one record with no synthesized per-type walk: a SERVICE HANDLE box, which holds one machine word
// and no managed field. Every other walk splices the same step inline (`emitBoxWalkStep`), because it must
// branch on the step's answer and an entry answering only a visit table cannot tell it where to go.
export let MmSoleBoxName = b"__mm_sole_box"
export let MmShareBoxName = b"__mm_share_box"

// ⭐⭐ **`__mm_sole_existential(witness, value, visits) -> visits` / `__mm_share_existential(…)` — THE WALK OF A
// VALUE HELD AT AN INTERFACE TYPE.** Which conformer the value half is, and therefore which per-type walk it
// takes, is a run-time fact, so each entry reads its word out of the witness table
// (`IrInterface.WitnessSoleWalkFuncOffset` / `WitnessShareWalkFuncOffset`) and calls it on the value — the
// `__drop_existential` shape, and built by the same emitter (`ManagedMemoryRuntime.buildRecordGatedAction`). A
// zero word is a conformer that owns nothing to walk.
export let MmSoleExistentialName = b"__mm_sole_existential"
export let MmShareExistentialName = b"__mm_share_existential"

// ⭐⭐ **`__mm_walk_unwalkable(value, visits)` — WHAT A WITNESS TABLE'S WALK WORD NAMES FOR A CONFORMER NO WALK CAN BE
// BUILT FOR** (a generic conformer, whose shared table names no instance; a record reaching an OS handle; a
// promise). A value held at an interface type is walked through whatever conformer it holds at run time, so
// the compile-time refusal the concrete doors make cannot be made about it; the abort is that refusal's
// run-time form, taken before anything crosses. A zero word would read as a conformer that owns nothing.
export let MmWalkUnwalkableName = b"__mm_walk_unwalkable"

// ⭐⭐ **`__mm_clone_existential(witness, value) -> value'` — THE DEEP COPY OF A VALUE HELD AT AN INTERFACE
// TYPE.** The walk pair's shape one word along (`IrInterface.WitnessCloneFuncOffset`), built by the same
// emitter. The inert path answers `value` itself, which IS the copy for a conformer that owns nothing: its
// value half is not a pointer (`existentialOwnershipProtocol.none`), so the two owners share no box.
export let MmCloneExistentialName = b"__mm_clone_existential"

// ⭐⭐ **`__mm_clone_uncloneable(value)` — WHAT A WITNESS TABLE'S CLONE WORD NAMES FOR A CONFORMER NOTHING CAN
// DEEP-COPY**, the `__mm_walk_unwalkable` of the clone cascade and unreachable for the same reason: the front
// end admits a clone only where every conformer of the interface can be deep-cloned, so reaching this entry
// says the conformer roster the gate read missed one.
//
// ⚠ **A ZERO WORD WOULD BE WORSE THAN AN ABORT HERE**, and this is the whole reason the entry exists: zero
// already means "owns nothing", whose inert path answers the value it was handed, so an uncloneable conformer
// would hand two owners ONE box with one reference — freed twice, with nothing said.
export let MmCloneUncloneableName = b"__mm_clone_uncloneable"

// The prefix every HEAP runtime entry point shares — the single test for "does this program touch the
// heap at all?", which `StringRuntime.scanRuntimeUsage` reads for its `usesHeap` bit.
let RuntimeCallPrefix = b"__mm_"

// ⭐ **IS THIS CALLEE A HEAP-RUNTIME ENTRY POINT?** The `__mm_`-only test that decides whether the
// program carries the ALLOCATOR + the leak check. It is DELIBERATELY narrower than
// `isCompilerInternalCallee` (below): a call to any `__mm_*` entry point implies the whole heap
// runtime (`__mm_alloc` calls `__slab_alloc`, `__mm_decref` calls `__mm_free`, the leak check reads
// the counter the others maintain), while a `__print_string`/`__str_eq` call implies NEITHER — a
// print-only program must not drag in the heap floor or the leak gate.
//
// A runtime entry point is DECLARED BY NOTHING — built at the Std tier after lowering — so the `__`
// prefix is what makes deciding it by NAME safe: Maxon reserves `__` for compiler-internal names, so
// no user function can collide. It is the same reservation `TargetPrinter.isRuntimeFunction` keeps the
// runtime out of the spec goldens by.
export function isRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: RuntimeCallPrefix)
end 'isRuntimeCallee'

// The prefix Maxon reserves for compiler-internal names — every runtime entry point the compiler
// EMITS (`__mm_alloc`, `__print_string`, `__str_eq`, …) starts with it. The reservation is enforced
// at parse time (E2051), so no user name can collide.
//
// ⭐ **THE RESERVATION IS ENFORCED AT BOTH ENDS, AND IT TAKES BOTH** (OPEN.md #35, CLOSED; completed by
// P1.0b step 2). Two separate rules bound what a `__` callee can be:
//
//   1. **No `__` name may be DECLARED, outside the ONE module that declares the reserved space** —
//      E2051, `Parser.requireUnreservedName`, at all eight binding sites, pinned by
//      `reserved-double-underscore.md`. Without it a user could declare and call a `__`-prefixed
//      function, and this predicate would route that call past `validateCall`'s arity/label checks — a
//      silent miscompile.
//   2. **No `__` name may be CALLED from source unless it names a recognized intrinsic — or the module
//      that declares the reserved space is calling a name it declares (D6/A1r)** — E3004,
//      `Parser.requireCalleeIsNotReservedName`, at the two source call doors (`emitCall`,
//      `emitAsyncCall`), pinned by `builtins-clock.md` and `reserved-double-underscore.md`.
//
// ⚠ **RULE 1 ALONE IS NOT ENOUGH, AND THIS PREDICATE SPENT A LONG TIME BELIEVING IT WAS.** A callee need
// not be DECLARED anywhere to be WRITTEN — `__whatever()` names nothing, so E2051 never fires, and the
// early return in `SemanticCheck.validateCall` then waved it past every unknown-callee check. It reached
// the linker, or lowering, and PANICKED with neither a file nor a line (three measured shapes:
// `resolveCallFixups: call to unknown function`, `lowerAsyncCall: … has no signature`,
// `valueTagToStdType: an 'unresolved' tag reached lowering`). Rule 2 is what bounds the family.
//
// ⚠⚠ **WHAT THE TWO RULES DO *NOT* GIVE IS "A `__` CALLEE IS COMPILER-OWNED" — rule 1's own exemption is
// why**, and reading them as if they did is what `isSignaturelessCompilerCallee` exists to stop. Since D6
// there is a `__` name with a DECLARATION behind it, and since A1r there is a call to one; such a call is
// an ordinary user function call that happens to wear the prefix. "Compiler-owned" is therefore the
// REGISTRY's answer, not the name's — see below.
let CompilerInternalPrefix = b"__"

// ⭐ **DOES THIS CALLEE WEAR THE COMPILER'S PREFIX?** The GENERAL predicate — a superset of
// `isRuntimeCallee`. It answers about the NAME's SHAPE and nothing else, which since D6/A1r is strictly less
// than "is this callee the compiler's own": for that, ask `isSignaturelessCompilerCallee` below.
//
// ⚠ **ITS THREE REMAINING DIRECT READERS ALL WANT THE SHAPE, and two of them because "declared" is already
// ruled out where they stand.** `Parser.requireCalleeIsNotReservedName` needs the raw shape as its GATE (the
// declaration exemption is its second clause, so the shape and the exemption cannot be one test);
// `Parser.requireThrowingNamedTryTarget`'s builtin arm sits BEHIND `declaresCallee`, so a name reaching it is
// undeclared by construction; and `StdLoweringShared.requireRuntimeChunkCallee` sits behind "no Std function
// in the merged module", which a declared-and-referenced function cannot be. Every other reader wants the
// registry's answer, and asks for it by name — see below.
//
// It is DISTINCT FROM `isRuntimeCallee` (which stays `__mm_`-only) because the two answer different
// questions. `isRuntimeCallee` decides whether the program carries the HEAP RUNTIME + leak check — a
// print-only or string-`==`-only program must NOT, so that decision cannot widen to every `__` name.
// This one decides only "skip the user-function checks", which is true of `__print_string`/`__str_eq`
// just as much as of `__mm_alloc`.
//
// ⭐⭐ **"COMPILER-OWNED" IS NOT THE SAME FACT AS "`__`-PREFIXED", AND THE SECOND CLAUSE IS WHERE THEY PART.**
// The synthesized builtin-conformance impls (`int.compare` and its siblings — the roster is
// `isIntrinsicBuiltinConformance`'s, not restated here, because a copy of it at a READER is exactly what
// went stale twice) are as compiler-owned as `__str_eq` — no file declares them, and they are
// built at the Std tier after the pipeline — but they deliberately wear NO prefix, because a witness-table
// reloc has to name a real `.text` symbol (`BuiltinConformanceRuntime`'s header). The prefix test was
// therefore ALREADY wrong about them; it simply never mattered while nothing called one by NAME. Direct
// dispatch (`i.compare(j)`) does, and the first reader to notice reported **E3004 "call to undefined
// function 'int.compare'"** against a call the user never wrote — the exact failure this predicate exists to
// prevent for `__mm_alloc`.
//
// ⚠ The second clause covers exactly the qualifiers a direct dispatch can be emitted under — `int.`,
// `float.`, `bool.` and, since BATCH2 slice 2, `String.` — and that bound is load-bearing rather than
// conservative. See `isBuiltinConformanceImplName` for the two DIFFERENT things that make it sound: the
// three primitives are keywords, while `String.` rests on the name being reserved from user declarations
// (`TypeResolution.isCompilerOwnedTypeName`).
//
// ⚠ **IT COSTS ~23 ALLOCATIONS A CALL, AND IT SITS ON THE PER-CALL PATH** of `validateCall` and
// `lowerCall`: the second clause reaches `isBuiltinConformanceImplName`, which SLICES the name apart
// through `splitQualifiedName` rather than comparing it in place. Measured at 22.3/23.2/23.8 per call
// across scale rungs 0-2. A caller that can ask a cheaper question first must do so — the runtime-tier
// admit-list in `SemanticCheck.calleeVisibleFrom` asks the ordinary visibility rule first for exactly
// this reason, which is worth ~150,000 allocations at rung 3.
export function isCompilerInternalCallee(callee ByteArray) returns bool
	return not (reservedCalleeReasonOf(callee) == ReservedCalleeReason.notReserved)
end 'isCompilerInternalCallee'

// ⭐ **THE FAULT PROBE'S ENTRY POINT** (`runtime/FaultProbe.maxon`). Named for the machine event it
// provokes, which is also the frame name the backtrace prints — a case that pins the frame list pins this
// spelling, so the name cannot be moved into a band a shape test would recognise.
//
// It is read by `Parser`, which lowers `__Builtins.forceSegfault()` to a call naming it and refuses any
// other file a free-function declaration of it, and by the classifier below.
//
// ⚠ **ONE NAME, NOT A FAMILY TEST.** A `__fault_` band would be unreachable: the tier declares this entry
// and nothing else, and a second one would be refused a `__` name nowhere — so a band would be a disjunct
// that cannot be true, which is the shape a reader mistakes for coverage.
export let ForceSegfaultName = b"maxon_force_segfault"

// ⭐⭐ **WHY A CALLEE IS THE COMPILER'S OWN — the two clauses above, told apart rather than summed (W55).**
// The predicate answers *whether*; a REFUSAL has to say *why*, and deriving the two separately is how the
// gate and its sentence came to disagree: `Parser.requireCalleeIsNotReservedName` refused on the OR and then
// explained every refusal with the FIRST clause's reason, so a synthesized impl named directly reported
// **`E3004 call to undefined function 'String.compare': the '__' prefix names a compiler intrinsic`** about
// a name carrying no `__` at all. One classifier, asked once, removes the second derivation rather than
// keeping it in step.
//
// ⚠ **THE TWO CLAUSES ARE DISJOINT AND THE ORDER IS THEREFORE NOT A PRECEDENCE.** A synthesized impl is
// `<conformer>.<method>` over `int`/`float`/`bool`/`String`, none of which can wear the reserved prefix
// (three are keywords; `String` is refused to any declaration by `TypeResolution.isCompilerOwnedTypeName`),
// so no callee answers both and neither clause can mask the other.
export enum ReservedCalleeReason
	// An ordinary callee: the name is the program's to declare, and this gate has nothing to say about it.
	notReserved

	// `__`-prefixed. E2051 forbids DECLARING one, so no signature can ever arrive for it.
	compilerInternalPrefix

	// A builtin-conformance impl the compiler synthesizes (`int.compare`, `String.hash`). It wears no prefix
	// — a witness-table reloc needs a real `.text` symbol — and no file declares it, so it is compiler-owned
	// for a reason the name's SHAPE cannot show.
	synthesizedConformanceImpl

	// The FAULT PROBE (`maxon_force_segfault`). It wears no prefix either, and for a reason of its own: the
	// name is the FRAME a backtrace prints, so it is a user-visible string both compilers spell the same way
	// and it cannot be renamed to fit a shape test. `runtime/FaultProbe.maxon` declares it, so it DOES carry
	// a signature — which is why `isSignaturelessCompilerCallee` below answers `false` for it, exactly as it
	// does for every other runtime-tier entry. ⚠ This arm is also what keeps
	// `SemanticCheck.calleeVisibleFrom`'s tier admit-list sound for an entry wearing no prefix.
	faultProbeEntry
end 'ReservedCalleeReason'

export function reservedCalleeReasonOf(callee ByteArray) returns ReservedCalleeReason
	if bytesStartWith(callee, prefix: CompilerInternalPrefix) 'wearsTheReservedPrefix'
		return ReservedCalleeReason.compilerInternalPrefix
	end 'wearsTheReservedPrefix'

	if isBuiltinConformanceImplName(callee) 'aSynthesizedImpl'
		return ReservedCalleeReason.synthesizedConformanceImpl
	end 'aSynthesizedImpl'

	if callee.equals(ForceSegfaultName) 'theFaultProbe'
		return ReservedCalleeReason.faultProbeEntry
	end 'theFaultProbe'

	return ReservedCalleeReason.notReserved
end 'reservedCalleeReasonOf'

// ⭐⭐ **DOES THIS CALLEE HAVE NO DECLARED SIGNATURE FOR THE USER-FUNCTION CHECKS TO READ?** Equivalently:
// **is it a name the COMPILER EMITTED**, since a compiler-emitted symbol is built at the Std tier, long after
// the merge that fills `funcSignatures`, and so can never be in it. Both readings are one predicate on
// purpose — they were two spellings of one fact, and a project whose signature bug is ONE FACT WRITTEN TWICE
// does not get to keep them apart.
//
// **The readers, and which reading each takes:**
//
//   • *"nothing to check against"* — `SemanticCheck.validateCall` and `validatePlainCall` (no E3004, no
//     arity/label/type checks), `SemanticCheck.directCallArgEscapes` (the closure-escape slot `validateCall`
//     returns before), `LowerMaxonToStd.lowerCall` / `lowerTryCall` (no signature slotting — the compiler
//     wrote its arguments positionally).
//   • *"the compiler emitted it"* — `LowerMaxonToStd.lowerFunctionRef` and `FnRefThunk.noteFnRefTarget` (a
//     bare `.text` address for a drop-walk `callIndirect(ptr)`, versus the uniform-ABI `__fnref_` thunk a
//     USER function value needs), and `StringRuntime.recordFunctionRefUsage` (does this reference install a
//     runtime floor?). ⚠ **THESE THREE WERE LEFT ON THE PREFIX BY A1r AND ONE OF THEM WAS REACHABLY WRONG** —
//     see `lowerFunctionRef` for the `wasm trap: indirect call type mismatch` it measured.
//
// ⚠ **THEY USED TO ASK IT BY PREFIX, AND D6/A1r BROKE THAT PROXY.** "`__`-prefixed" stood in for "no file
// declares it" only while NO file could declare such a name. D6 exempted `stdlib/Builtins.maxon` at the
// declaration door (`Parser.requireUnreservedName`) and A1r exempted it at the two CALL doors, so a
// `__int_fromString` written in that module is now a call to a REGISTERED function — with parameter names,
// declared types and a `throws` clause every ordinary call is checked against.
//
// ⚠⚠ Left keyed on the prefix it waves that call past all of them, and **BOTH HALVES ARE MEASURED, on the
// flag-only door, against `stdlib/Builtins.maxon` itself**: `__int_fromString()` with its one argument
// OMITTED drew NO DIAGNOSTIC AT ALL (the whole file passed every check, and the only complaint left was
// `E3001: No 'main' function found`), and neither did a BARE `__int_fromString(input)` — a throwing call
// with no `try`, whose error flag nothing would then have read. Both now report (E3036, E3057). That
// silent-acceptance is the same shape the reservation was introduced to close
// (`CompilerInternalPrefix`'s rule 1, `__add(7)`, exit 65543), which is why the fact this predicate states
// is the REGISTRY's answer and not the name's.
//
// A BUILDER-BUILT callee is still in no registry (`__mm_alloc`, `__print_string`, `int.compare` are built at
// the Std tier, long after the merge that fills `funcSignatures`), so its answer is unchanged. The registry
// probe runs ONLY for a `__`/builtin-conformance/fault-probe name, behind the allocation-free prefix test.
//
// ⚠⚠ **A `runtime/` TIER ENTRY IS COMPILER-OWNED AND *DOES* HAVE A SIGNATURE, so this answers `false` for
// one — which is the right answer at every reader above.** Its body is Maxon source, so the ordinary
// arity/label/type battery has something real to check the compiler's own emitted call against, the lowering
// slots its arguments through a declared signature, and a function VALUE of it gets the uniform-ABI
// `__fnref_` thunk rather than a bare `.text` address. ⇒ **THIS PREDICATE IS "BUILDER-BUILT", NOT
// "COMPILER-OWNED"**; the second question is `isCompilerInternalCallee`'s.
export function isSignaturelessCompilerCallee(callee ByteArray, funcSignatures FuncSignatureMap) returns bool
	return isCompilerInternalCallee(callee) and not funcSignatures.contains(callee)
end 'isSignaturelessCompilerCallee'

// A per-function dense ValueId minter. The parser mints ids the same way and for the same reason
// (ARCHITECTURE → "Value numbering is born here"): a ValueId IS a dense function-local index, so
// every column the backend sizes by `blockArgIdBound` pays for the highest id minted. Parameters
// occupy `0..paramCount-1` by construction — the Std `param` op's contract — so the counter starts
// there rather than at zero.
export type ValueMinter
	var next as ValueId

	export static function create(paramCount ParamCount) returns ValueMinter
		return Self{next: valueIdAtParamPosition(paramCount)}
	end 'create'

	// A minter over a function that already holds values: the first id it hands out is `next`.
	export static function resuming(next ValueId) returns ValueMinter
		return Self{next: next}
	end 'resuming'

	export function mint() returns ValueId
		let id = self.next
		self.next = self.next + 1
		return id
	end 'mint'

	// The id the next `mint` answers — what a pass reads before and after an expansion to file the ids
	// it minted as one derived range (`ValueOriginTable.recordDerivedRange`).
	export function nextId() returns ValueId
		return self.next
	end 'nextId'
end 'ValueMinter'

// Install the runtime into the lowered Std module. Called only when `moduleUsesHeap` held.
//
// The functions are APPENDED, not prepended: only `mrt_start` must lay out first (its `.text`
// offset is the PE entry point), and that is `augmentWithRuntime`'s job at the Target tier. Order
// among the rest is free.
//
// ⚠ `__mm_incref` IS CONDITIONAL, not in the unconditional list. Every function above has a caller in
// every heap-using program (a drop calls `__mm_decref`, which calls `__mm_free`; the exit path calls the
// leak check), so installing them together costs nothing dead. `__mm_incref` does NOT: a heap program
// that never takes a SECOND owner never references it, and it would be 31 unreachable bytes there. It now
// has TWO consumers — the managed-memory runtime's zero-copy view (`usesManagedMemory`) and the parser's `try … otherwise`
// phi reconciliation (`usesIncref`, a `call __mm_incref` `scanRuntimeUsage` sees directly) — so it is
// built here, under either bit, rather than by `installManagedMemoryRuntime` alone: the parser can emit it in a
// program that touches no array. Same "vocabulary ships with its consumer" rule, one home now that the
// consumers are two files apart.
//
// ⚠ `__mm_retain` IS CONDITIONAL for the same reason, under its OWN bit. Its one consumer is the parser
// co-owning a borrowed managed-aggregate parameter into a `var` (`var q = p`, OPEN #40) — a `call
// __mm_retain` `scanRuntimeUsage` sees directly (`usesRetain`). It is NOT folded under `usesIncref`
// despite both being increfs: the two functions have independent callers (an array/`try` program
// references `__mm_incref` but never `__mm_retain`, and vice versa), so folding either bit into the
// other would install an unreachable copy of the unused one in the program that references only the other.
export function installMmRuntime(module StdModule, usage RuntimeUsage, target Target)
	// The slab itself is `SlabRuntime.maxon`'s, installed beside the page layer it sits on
	// (`Compiler.compileToCodeResult`); this file builds the box layer over it.
	let model = machineModel(target)

	buildMmAlloc(module, model: model)
	buildMmDecref(module)
	buildMmFree(module, model: model)
	buildMmLeakCheck(module, usage: usage)
	buildMmCounterAccessors(module, model: model)

	if usage.usesIncref or usage.usesManagedMemory 'incref'
		buildMmIncref(module)
	end 'incref'

	if usage.usesRetain 'retain'
		buildMmRetain(module)
	end 'retain'

	if usage.usesMmOwn 'own'
		buildMmOwn(module)
	end 'own'

	if usage.usesMmOwnDeep 'ownDeep'
		buildMmOwnDeep(module)
	end 'ownDeep'

	if usage.usesMmIsNull 'isNull'
		buildMmIsNull(module)
	end 'isNull'

	// The handle's walk entries, under the bit every producer of a walk turns on — a program that crosses
	// nothing to a green thread must not carry them.
	if usage.usesSoleWalk 'soleBox'
		buildMmBoxWalk(module, action: CascadeAction.soleWalk)
		buildRecordGatedAction(module, symbolName: MmSoleExistentialName, wordOffset: WitnessSoleWalkFuncOffset, action: RecordGatedAction.walkThroughWord)
	end 'soleBox'

	if usage.usesShareWalk 'shareBox'
		buildMmBoxWalk(module, action: CascadeAction.shareWalk)
		buildMmShareBuffer(module)
		buildRecordGatedAction(module, symbolName: MmShareExistentialName, wordOffset: WitnessShareWalkFuncOffset, action: RecordGatedAction.walkThroughWord)
	end 'shareBox'

	if usage.usesCloneExistential 'cloneExistential'
		buildRecordGatedAction(module, symbolName: MmCloneExistentialName, wordOffset: WitnessCloneFuncOffset, action: RecordGatedAction.retainThroughWord)
	end 'cloneExistential'

	if usage.usesCloneUncloneable 'cloneUncloneable'
		buildAbortingRuntimeEntry(module, symbolName: MmCloneUncloneableName, paramCount: SingleValueEntryParamCount, paramTypes: oneI64Param(), abort: RuntimeAbort.existentialNotCloneable)
	end 'cloneUncloneable'

	if usage.usesSoleWalk or usage.usesShareWalk 'visitTable'
		installWalkVisitTable(module)
		buildAbortingRuntimeEntry(module, symbolName: MmWalkUnwalkableName, paramCount: WalkParamCount, paramTypes: twoI64Params(), abort: RuntimeAbort.transferredRecordNotSole)
	end 'visitTable'

	// ⚠ `__mm_cow_detach` IS CONDITIONAL under its ONE remaining caller's bit — `__managed_cow_detach`, under
	// `usesManagedMemory` — so that a program reaching no array does not carry it dead. It is still built HERE
	// rather than by the managed-memory runtime: installing it twice would emit two copies of one function, and the
	// home is what makes a SECOND caller one `or` rather than a second installation.
	//
	// ⚠ **A TERM MAY LEAVE THIS CONDITION ONLY WHEN ITS PRODUCER GOES WITH IT.** The corpus reaches this
	// detach through `__managed_append` -> `__managed_reserve` -> `__managed_grow`, which is under
	// `usesManagedMemory` already. Shedding a term whose producer still exists leaves a call unresolved in
	// exactly the program that uses only that side, which is the failure this condition prevents.
	if usage.usesManagedMemory 'cowDetach'
		buildMmCowDetach(module)
	end 'cowDetach'
end 'installMmRuntime'

// One i64 parameter — the shape five of the six runtime functions share. Exported: the String
// runtime's `__print_string` (one string pointer) shares it, so it is the same helper rather than a
// second copy.
export function oneI64Param() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.i64)
	return types
end 'oneI64Param'

// Two i64 parameters — `__mm_alloc(size, destructor)` and the String runtime's `__str_eq(a, b)`.
export function twoI64Params() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.i64)
	types.push(StdType.i64)
	return types
end 'twoI64Params'

// One f64 parameter — the synthesized `float.hash(self)` (P1.7a's last slice). The f64 sibling of
// `oneI64Param`, and it exists for `twoF64Params`' reason: the DECLARED f64 is what makes the ABI
// agree at both ends, `calleeParamClass` routing the argument into an XMM register and `lowerParam`
// capturing it from one.
export function oneF64Param() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.f64)
	return types
end 'oneF64Param'

// Two f64 parameters — the synthesized `float.equals(self, other)` / `float.compare(self, other)`
// (P1.7a slice 2b-iii). It joins the i64 family here rather than beside its caller for that family's
// reason, and the DECLARED f64 is what makes the ABI agree at both ends: `calleeParamClass` reads these
// types to route each ARGUMENT into an XMM register, and `lowerParam` reads them to capture it from one.
export function twoF64Params() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.f64)
	types.push(StdType.f64)
	return types
end 'twoF64Params'

// Three i64 parameters — `__str_copy(dest, src, len)` and the managed-memory runtime's `__managed_set(arr, index,
// value)` / `__managed_mem_set(mem, index, value)`. Shared here so a runtime builder does not mint its own.
export function threeI64Params() returns StdTypeArray
	var types = StdTypeArray.create()
	types.push(StdType.i64)
	types.push(StdType.i64)
	types.push(StdType.i64)
	return types
end 'threeI64Params'

// Four i64 parameters — the managed-memory runtime's `__managed_slice_managed(arr, start, end, cloneFn)`, plus
// `__managed_zero_elems` / `__managed_slice_opaque` beside it. It joins the 1/2/3-param
// family here (rather than beside a single caller) because more than one entry needs it.
export function fourI64Params() returns StdTypeArray
	var types = threeI64Params()
	types.push(StdType.i64)
	return types
end 'fourI64Params'

// Five i64 parameters — the rung below `sixI64Params`, which is the ladder's only consumer of it.
function fiveI64Params() returns StdTypeArray
	var types = fourI64Params()
	types.push(StdType.i64)
	return types
end 'fiveI64Params'

// Six i64 parameters — `__managed_move_elems(dest, destIndex, src, srcIndex, count, elementSize)`.
export function sixI64Params() returns StdTypeArray
	var types = fiveI64Params()
	types.push(StdType.i64)
	return types
end 'sixI64Params'

// ⭐ **FOURTEEN i64 PARAMETERS — `__gt_subp_attached_spawn`'s, and the contract's own arity.** It joins the
// ladder rather than a derived `i64Params(count)` — the shape the note below rejects — because fourteen is
// a SOURCE FACT here in exactly the sense that note requires: `stdlib/Subprocess.maxon`'s spawn call passes
// fourteen arguments because the contract has fourteen slots. The count and the list are one statement,
// made once.
export function fourteenI64Params() returns StdTypeArray
	var types = sixI64Params()

	for _ in 0 upto SpawnContractExtraParams 'each'
		types.push(StdType.i64)
	end 'each'

	return types
end 'fourteenI64Params'

// The fourteen-argument spawn contract's arity, and how many of them the six-parameter base is short.
export let SubprocessSpawnParamCount = 14 as ParamCount
let SpawnContractExtraParams = 8 as ParamCount

// ⚠ **`i64Params(count)` STOOD HERE AND WENT AT W129's REVIEW, WITH ITS ONLY CALLER.** The named ladder
// above is right for an entry whose arity IS a source fact — `__mm_alloc` takes two because it takes two.
// It was wrong for one whose arity was a SUM the threading computed (`__cs_contains`: two explicit
// arguments, a layout descriptor, and one witness table per key constraint), because there the count and
// the list are two statements of one number paired by hand, and the hand pairing is what silently survives
// a change to either summand. **NO ENTRY POINT HAS A DERIVED ARITY TODAY** — the last one that did went
// with the `__cs_*` runtime (W129) — so the ladder is complete, and a future derived-arity entry brings the
// deriving helper back rather than writing a count beside a list.

// Emit the `param` ops an entry block owes. A Std function's parameters are materialized once, at
// entry, by the op whose `role` is `param` — the backend turns each into the move that captures the
// incoming ABI register into its virtual register. Parameter `k` is ValueId `k`. All-i64: every
// hand-assembled runtime chunk uses the GPR-only internal ABI. A chunk with a NON-i64 parameter (a
// `__fnref_` thunk forwarding a float — P1.5 #78) uses `emitTypedParams` instead.
export function emitParams(module StdModule, block IrBlock, count ParamCount)
	for k in 0 upto count 'each'
		module.appendOp(block, op: StdOp.param(k as ValueId, index: k, paramType: StdType.i64))
	end 'each'
end 'emitParams'

// Emit the `param` ops for a synthesized function whose parameters are NOT all i64 — the `__fnref_` thunk,
// whose float user parameters must be captured from a float argument register (P1.5 #78). Parameter `k` is
// ValueId `k`, typed `paramTypes[k]`, so the value-class column classes it in the file its type names and
// the entry capture reads it from the matching ABI register. The all-i64 twin of `emitParams`, for the one
// runtime builder whose parameter files vary.
export function emitTypedParams(module StdModule, block IrBlock, paramTypes StdTypeArray)
	for k in 0 upto paramTypes.count() 'each'
		let paramType = try paramTypes.get(k) otherwise panic("emitTypedParams: paramTypes.get OOB at {k}")
		module.appendOp(block, op: StdOp.param(k, index: k, paramType: paramType))
	end 'each'
end 'emitTypedParams'

// --- The single-op emit helpers every runtime builder shares ---
//
// Each is one `StdOp` over one block, minted into a fresh value. They live HERE, beside `emitParams`
// and `argsOf`, because three files build Std graphs by hand (`MmRuntime`, `StringRuntime`,
// `ManagedMemoryRuntime`) plus the two shared homes over them (`BufferOwnership`, `RuntimeAbort`), and a
// `ids.mint()` + `module.appendOp` pair written out at each of a few hundred sites is the same four
// tokens of noise every time. They were `ManagedMemoryRuntime`'s private helpers until `BufferOwnership` and the
// String runtime needed the same four ops to ask the same questions of the same record slots.

// Load `record`'s field at `offset` into a fresh value.
export function emitLoadField(module StdModule, block IrBlock, record ValueId, offset ByteOffset, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(v, addrId: record, offset: offset, valueType: StdType.i64))
	return v
end 'emitLoadField'

// Store `value` into `record`'s field at `offset`.
export function emitStoreField(module StdModule, block IrBlock, record ValueId, offset ByteOffset, value ValueId)
	module.appendOp(block, op: StdOp.storeIndirect(record, offset: offset, valueId: value, valueType: StdType.i64))
end 'emitStoreField'

// ⭐⭐ **THE ADDRESS OF `record`'s FIELD AT `offset` — what an ATOMIC has to be handed (G2).**
// `loadIndirect`/`storeIndirect` carry a field displacement and so never need this; `StdOp.atomicCas` and
// `StdOp.atomicRmw` deliberately carry none — an atomic names ONE word and nothing else, which is stated at
// those ops — so every atomic on a struct field has to compute the address first: a SHARED box's refcount
// word (`emitAdjustRefcount`, through `emitFieldAccumulate`), `SchedRuntime`'s P fields and `GtRuntime`'s
// releaser slot are the same arithmetic over three different structs.
export function emitFieldAddr(module StdModule, block IrBlock, record ValueId, offset ByteOffset, ids ValueMinter) returns ValueId
	let displacement = emitConst(module, block: block, value: offset as ParsedInt, ids: ids)
	return emitBin(module, block: block, a: record, b: displacement, opcode: StdBinOpcode.add, ids: ids)
end 'emitFieldAddr'

// ⭐⭐ **A VALUE RAISED TO THE NEXT MULTIPLE OF A POWER-OF-TWO WIDTH — `(value + width - 1) and -width`.**
// Two layers of the allocator round to two DIFFERENT widths and neither of them owns the idiom: the
// OS-direct tier rounds a BYTE COUNT up to a whole `SlabPageBytes` chunk, and `__slab_arena_new` rounds the
// BASE `osReservePages` answered up to a whole commit granule. Written once, with the width as an argument,
// because the second copy's failure mode is not a wrong shape — it is the right shape carrying the wrong
// width, which reads correct at both sites and is a silent misalignment at one of them.
//
// ⚠ **`width` MUST BE A POWER OF TWO, AND THAT IS ASKED HERE RATHER THAN LEFT TO THE CALLER'S OWN CHECK.**
// `-width` is the "clear the low bits" mask only then, and a width that is not one raises to a boundary that
// does not exist — silently, in emitted code, on whichever lane happens to exercise it. Today's two widths
// are each proven a power of two by their own geometry check, against the shift that divides by them
// (`checkSlabClassTable` for `SlabPageBytes`, `checkSlabArenaGeometry` for the commit granule); this is what
// makes a THIRD caller arriving with some other width a compile failure instead of a misaligned pointer,
// since nothing about those two checks reaches this signature.
//
// ⚠ **THE COMPILER HAS ITS OWN `alignUp` (`Targets/Shared/BinaryHelpers.maxon`) AND THE TWO CANNOT BE ONE.**
// That one answers a NUMBER at compile time for the binary writers; this one APPENDS OPS that answer at run
// time — different tier, different types, no body they could share. They are the same formula in its two
// spellings (`and not (a - 1)` there, `and -a` here — identical for a power of two on two's complement), so
// they are named for each other here rather than left to be found: a reader who changes one should know the
// other exists.
export function emitAlignUp(module StdModule, block IrBlock, value ValueId, width ParsedInt, ids ValueMinter) returns ValueId
	if not isPowerOfTwo(width) 'widthNotAPowerOfTwo'
		panic("emitAlignUp: a width of {width} is not a positive power of two, so `-{width}` is not the mask that clears its low bits")
	end 'widthNotAPowerOfTwo'

	let bias = emitConst(module, block: block, value: width - 1, ids: ids)
	let raised = emitBin(module, block: block, a: value, b: bias, opcode: StdBinOpcode.add, ids: ids)
	let mask = emitConst(module, block: block, value: -width, ids: ids)
	return emitBin(module, block: block, a: raised, b: mask, opcode: StdBinOpcode.bitAnd, ids: ids)
end 'emitAlignUp'

// ⭐ **ONE MACHINE-WORD SLOT — the stride every WORD-INDEXED buffer in the runtime uses.** A hash table's
// `keys`/`states`/`hashes`/`values` columns, and the element buffer of any `Array` whose element is a managed
// POINTER or a machine-word int, all address slot `i` at `base + i·8`.
let WordSlotBytes = 8 as ParsedInt

// The byte address of word slot `index` in a parallel buffer — `base + index · WordSlotBytes`.
//
// ⚠ **IT LIVES HERE, WITH THE OTHER SINGLE-OP EMIT HELPERS, BECAUSE THE HASH TABLE WAS NEVER ITS ONLY
// CALLER.** It was the deleted `HashTableRuntime`'s `emitHtSlotAddr` — but a `from`-construction already reads an ARRAY's element
// buffer through it, which is what identifies it as a word-slot fact rather than a hash-table one, and
// `__list_from` reads the same buffer the same way. A second copy under a list-shaped name would have been
// "the address of word slot i" written down twice, over the same buffers.
// ⚠ **IT IS `export`ED AGAIN AS OF S2, AND THE REASON IS A THIRD COPY THAT HAD ALREADY APPEARED.** The
// slab's page layer wrote its own `emitWordSlotAddress` for the bitmap and the reverse map's six index
// computations, with a comment saying outright that this one *"IS THE SAME ARITHMETIC AND IS NOT REACHABLE
// FROM HERE — it is private"*; the object layer above it then wanted the same three ops for the mcentral
// heads, the mcache rows and the packed class-geometry table. Two copies of "the address of word slot i"
// is what the header above says this function exists to prevent, so the answer is to make it reachable
// rather than to write it a third time. (`SlabArena`'s copy can fold into this one; it is that file's
// change to make.)
export function emitWordSlotAddr(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	let slotBytes = emitConst(module, block: block, value: WordSlotBytes, ids: ids)
	let offset = emitBin(module, block: block, a: index, b: slotBytes, opcode: StdBinOpcode.mul, ids: ids)
	return emitBin(module, block: block, a: base, b: offset, opcode: StdBinOpcode.add, ids: ids)
end 'emitWordSlotAddr'

// Load slot `index` (one i64 word) of parallel buffer `base`.
export function emitWordSlotLoad(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	return emitLoadField(module, block: block, record: emitWordSlotAddr(module, block: block, base: base, index: index, ids: ids), offset: 0, ids: ids)
end 'emitWordSlotLoad'

// Store `value` into slot `index` (one i64 word) of parallel buffer `base`.
function emitWordSlotStore(module StdModule, block IrBlock, base ValueId, index ValueId, value ValueId, ids ValueMinter)
	emitStoreField(module, block: block, record: emitWordSlotAddr(module, block: block, base: base, index: index, ids: ids), offset: 0, value: value)
end 'emitWordSlotStore'

// ⭐⭐ **NULL A SLOT WHOSE ELEMENT HAS BEEN MOVED OUT OF A BORROWED ARRAY — AND ONLY WHEN THE NULL MEANS
// SOMETHING.** `__list_from` drains an array the caller still owns: each element is
// handed to the new container, and the source slot is then nulled so the array's OWN `__managed_decref` walk
// does not drop a key the container now owns. This is that step, written once for both.
//
// ⛔⛔ **THE GUARD IS THE WHOLE POINT, AND WITHOUT IT THIS IS A WILD WRITE INTO READ-ONLY MEMORY.** The
// array's decref walk drops slots only when the record carries a per-element destructor
// (`element_destroy@40 != 0`), so for a TRIVIAL element the null does no work — which makes storing it
// unconditionally look harmless. It is harmless only while every array reaching the call sites is
// heap-allocated, and an all-constant array literal is an owned record over an IMMORTAL `.rdata` blob
// (`LowerMaxonToStd.lowerConstArrayLiteral`): `Set from [1, 2, 3]` drains one straight into `.rdata` —
// **exit 0xC0000005, 13 cases**.
//
// ⭐ **AND THE TWO CONDITIONS COINCIDE EXACTLY, WHICH IS WHY THIS GUARD IS A CURE AND NOT A PATCH.** A
// record may have an immortal buffer only if its element stores its own bytes
// (`SignatureIndex.arrayElementMayBeConstantBlob` refuses a managed or opaque element), and such a record's
// `element_destroy@40` is never written — `lowerConstArrayLiteral` leaves it at the zero `__mm_alloc`
// guarantees. So *immortal ⇒ trivial ⇒ guarded out*: the store that could reach read-only memory is
// precisely the store that was doing nothing. Nothing that was doing work is skipped.
//
// ⚠ It is a RUN-TIME test and cannot be a compile-time one: one program's `__list_from` serves every
// `Set from […]` in it, so a program with both an int-keyed and a String-keyed set needs both answers from
// one body.
//
// It returns the block execution continues in, because it FORKS: the caller goes on emitting into that.
export function emitMovedOutSlotClear(module StdModule, func IrFunction, block IrBlock, base ValueId, index ValueId, elemDrop ValueId, ids ValueMinter) returns IrBlock
	var clear = module.addBlock(func, label: b"clearmoved", heat: BlockHeat.normal)
	let resume = module.addBlock(func, label: b"moveddone", heat: BlockHeat.normal)

	let noDrop = emitConst(module, block: block, value: 0, ids: ids)
	let ownsElements = emitCmp(module, block: block, a: elemDrop, b: noDrop, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(block, op: StdOp.condBranch(ownsElements, thenBlockId: clear.id, elseBlockId: resume.id))

	let nullSlot = emitConst(module, block: clear, value: 0, ids: ids)
	emitWordSlotStore(module, block: clear, base: base, index: index, value: nullSlot, ids: ids)
	module.setTerminator(clear, op: StdOp.branch(resume.id))

	return resume
end 'emitMovedOutSlotClear'

// `a <op> b` into a fresh value.
export function emitBin(module StdModule, block IrBlock, a ValueId, b ValueId, opcode StdBinOpcode, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.binOp(v, lhs: a, rhs: b, opcode: opcode, operandType: StdType.i64))
	return v
end 'emitBin'

// `callee(args)` into a fresh value — a call the compiler MINTS into a body it is building, which is the
// only way the appended band reaches a `runtime/` tier entry: no walk over source call edges can see one,
// so the edge is declared (`StdlibSource.runtimeTierFileIsCompilerCalled`) and minted here.
export function emitRuntimeCall(module StdModule, block IrBlock, callee ByteArray, args ValueIdArray, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.call(v, callee: callee, args: args))
	return v
end 'emitRuntimeCall'

// `<op> operand` into a fresh value. `operandType` is the SOURCE's type, never the result's — the
// distinction `StdUnaryOpcode`'s header makes in full, and the reason it is a required argument here
// rather than defaulting to i64 the way `emitCmp`'s does: the ONE caller today
// (`BuiltinConformanceRuntime.buildFloatHash`) reads an f64 and writes an i64, so a defaulted i64
// would be wrong on the only use this helper has.
export function emitUnary(module StdModule, block IrBlock, operand ValueId, opcode StdUnaryOpcode, operandType StdType, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.unaryOp(v, operand: operand, opcode: opcode, operandType: operandType))
	return v
end 'emitUnary'

// ⭐⭐ **`[label] += delta` AS ONE INDIVISIBLE STEP — THE ONE SPELLING OF A `.data` COUNTER UPDATE.**
// Every `.data` counter word an emitted program maintains comes through here: the `--debugstream`
// allocation-id mint and the scheduler's counters (`GtRuntime`'s live count, trace dispenser, in-flight read
// count and pipe-name uniquifier, `__sched_nmspinning`, `__sched_active_workers`). One spelling of `load /
// combine / store` is one chance to read one slot and store another instead of ten.
//
// ⭐⭐ **`multiM` IS "CAN A SECOND OS THREAD STEP THIS WORD", AND ON `false` THE STEP IS A PLAIN
// LOAD/ADD/STORE.** `atomicRmw` is a `lock`-prefixed RMW on x64 — a full barrier and a locked cache-line
// round trip. A word every machine steps loses an update the moment two Ms credit it at once, and
// `__gt_live_count` is what the green-thread gate reads (exit 75), so a lost update is a leak reported that
// did not happen, or one hidden that did. A word stepped only under `__sched_lock`
// (`emitSchedStepLockedCount`) is the plain arm's caller.
//
// ⛔ **THE REFCOUNT DOOR'S CHOICE IS NOT THIS BIT.** What `emitAdjustRefcount` steps is a word inside a BOX,
// and whether a second green thread can step it is a fact about the BOX — counted or shared, read off the
// word itself at run time — never about `MAXON_MAX_PROCS`.
//
// ⛔⛔ **`multiM` HAS NO DEFAULT.** `= true` is the answer that is never WRONG — only ever slower — which is
// exactly what makes omitting it UNDETECTABLE: a counter added tomorrow without the argument would put a
// `lock add` on a single-writer word, and no spec, no leak gate and no fixpoint would go red. A default whose
// omission nothing can observe is a decision the compiler stops asking for. Compare `emitCmp`'s
// `operandType`, which keeps its default precisely because a wrong one fails a float spec on the spot.
//
// ⚠ **BOTH ARMS ANSWER THE *PRIOR* VALUE, NOT THE UPDATED ONE, AND THE ASYMMETRY IS PAID FOR IN CODE
// SIZE.** That is `StdOp.atomicRmw`'s contract, and adopting it verbatim is what lets the x64 isel pick
// `lock add` — no destination register at all — for the callers that discard the answer, against the
// `lock xadd` plus an allocator-supplied copy a read result forces (`lowerAtomicRmw` states the saving).
// The callers that want the number they just minted apply the delta again, which costs one ALU op on a
// cold path. The plain arm keeps the same contract so that no caller has to know which arm it got.
export function emitGlobalAccumulate(module StdModule, block IrBlock, label ByteArray, delta ValueId, multiM bool, ids ValueMinter) returns ValueId
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(addr, label: label))

	if not multiM 'soleThread'
		let current = emitLoadField(module, block: block, record: addr, offset: 0, ids: ids)
		let stepped = emitBin(module, block: block, a: current, b: delta, opcode: StdBinOpcode.add, ids: ids)
		emitStoreField(module, block: block, record: addr, offset: 0, value: stepped)
		return current
	end 'soleThread'

	let prior = ids.mint()
	module.appendOp(block, op: StdOp.atomicRmw(prior, addrId: addr, operandId: delta, opcode: StdAtomicRmwOpcode.add))
	return prior
end 'emitGlobalAccumulate'

// ⭐⭐ **`record.field += delta`, ANSWERING THE COUNT AS IT STOOD BEFORE — `emitGlobalAccumulate`'s twin, one
// STORAGE CLASS over.** That one steps a `.data` word reached through `globalAddr`; this one steps a word
// inside a record the caller already holds a pointer to, which is what every PER-PROCESSOR counter is (the
// `SchedRuntime.POff*Count` words `buildSchedPerProcSum` sums). Its contract is that one's in every respect a
// caller can observe: `multiM` has no default, and BOTH arms answer the PRIOR value so no caller has to know
// which arm it got.
//
// ⛔⛔ **THE SEQUENCE IS WRITTEN ONCE AND THE DECISION STAYS AN ARGUMENT EVERY CALLER STATES.** Most per-P
// counters are single-writer — a P counts its own steals, sysmon is the only party that retakes — and take the
// plain load/add/store; the remote-free count is MPSC by construction and takes an `atomicRmw`. ⚠ **The
// wrong choice does not fail loudly**: a plain step on a contended word LOSES COUNTS and answers a number
// that is merely too small, so the choice is never made by copying whichever neighbour a caller happened to
// read.
export function emitFieldAccumulate(module StdModule, block IrBlock, record ValueId, offset ByteOffset, delta ValueId, multiM bool, ids ValueMinter) returns ValueId
	if not multiM 'soleWriter'
		let current = emitLoadField(module, block: block, record: record, offset: offset, ids: ids)
		let stepped = emitBin(module, block: block, a: current, b: delta, opcode: StdBinOpcode.add, ids: ids)
		emitStoreField(module, block: block, record: record, offset: offset, value: stepped)

		return current
	end 'soleWriter'

	// The address is minted BEFORE the result, which is the order the hand-written site had and the order
	// `emitFieldAddr`'s own two ops force: a `ValueMinter` hands out ids in emission order.
	let addr = emitFieldAddr(module, block: block, record: record, offset: offset, ids: ids)
	let prior = ids.mint()
	module.appendOp(block, op: StdOp.atomicRmw(prior, addrId: addr, operandId: delta, opcode: StdAtomicRmwOpcode.add))

	return prior
end 'emitFieldAccumulate'

// ⭐ **A NUL-TERMINATED C STRING IN A FRESH SLAB REGION — the shape every Win32 `A` entry point takes.**
// One `__slab_alloc` of `len + 1`, one `u8` store per byte, and the terminator is the allocator's own zero
// (the `+ 1` is what reserves the byte for it). The region is the caller's, and a caller that runs more than
// once per process gives it back.
//
// It lives here rather than with any one runtime family because "a literal as a C string" is a property of
// the Std tier and of Win32's ABI: the scheduler, the poller and the subprocess runner all spell one.
export function emitLiteralCString(module StdModule, block IrBlock, ids ValueMinter, text ByteArray) returns ValueId
	let sizeConst = emitConst(module, block: block, value: text.count() + 1, ids: ids)
	let buf = ids.mint()
	module.appendOp(block, op: StdOp.call(buf, callee: SlabAllocName, args: argsOf(sizeConst)))
	emitStoreLiteralBytes(module, block: block, base: buf, offset: 0, text: text, ids: ids)
	return buf
end 'emitLiteralCString'

// `text` stored byte by byte at `base + offset`. No terminator is written: every caller stores into a
// zeroed region sized one byte past the text.
export function emitStoreLiteralBytes(module StdModule, block IrBlock, base ValueId, offset ByteOffset, text ByteArray, ids ValueMinter)
	for k in 0 upto text.count() 'each'
		let ch = try text.get(k) otherwise panic("emitStoreLiteralBytes: text.get OOB at {k}")
		let byteConst = emitConst(module, block: block, value: ch as ParsedInt, ids: ids)
		module.appendOp(block, op: StdOp.storeIndirect(base, offset: offset + (k as ByteOffset), valueId: byteConst, valueType: StdType.u8))
	end 'each'
end 'emitStoreLiteralBytes'

// ⭐ **A `.data` MACHINE WORD, LOADED / STORED — the two-op pair, stated once.** `globalAddr` is
// `isPure: true` and freely rematerializable, so a caller that does both around one word pays nothing for
// asking twice; the readers that hoist the address across a load-then-store pair are deliberately left
// alone, because there a hoist only widens a live range.
export function emitLoadGlobalWord(module StdModule, block IrBlock, label ByteArray, ids ValueMinter) returns ValueId
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(addr, label: label))
	return emitLoadField(module, block: block, record: addr, offset: 0, ids: ids)
end 'emitLoadGlobalWord'

export function emitLoadAcquireField(module StdModule, block IrBlock, record ValueId, offset ByteOffset, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadAcquire(v, addrId: record, offset: offset, valueType: StdType.i64))
	return v
end 'emitLoadAcquireField'

export function emitLoadAcquireGlobalWord(module StdModule, block IrBlock, label ByteArray, ids ValueMinter) returns ValueId
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(addr, label: label))
	return emitLoadAcquireField(module, block: block, record: addr, offset: 0, ids: ids)
end 'emitLoadAcquireGlobalWord'

export function emitStoreGlobalWord(module StdModule, block IrBlock, label ByteArray, value ValueId, ids ValueMinter)
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(addr, label: label))
	emitStoreField(module, block: block, record: addr, offset: 0, value: value)
end 'emitStoreGlobalWord'

// `emitStoreGlobalWord` with RELEASE ordering, the writer an `emitLoadAcquireGlobalWord` reader pairs with.
export function emitStoreReleaseGlobalWord(module StdModule, block IrBlock, label ByteArray, value ValueId, ids ValueMinter)
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(addr, label: label))
	module.appendOp(block, op: StdOp.storeRelease(addr, offset: 0, valueId: value, valueType: StdType.i64))
end 'emitStoreReleaseGlobalWord'

// ⭐ **THE DECIMAL ALPHABET, ONE DECLARATION.** A radix and the ASCII codes that bound a digit — facts about
// base ten and about ASCII, belonging to neither the String runtime that renders integers nor the scheduler
// that parses an environment variable. ⚠ They were `StringRuntime`'s (`DecimalRadix`, `AsciiZeroDigit`) and
// `SchedRuntime` declared a SECOND `DecimalRadix` under the identical name; two `let`s of one number in one
// namespace is the shape `maxon flat-namespace check` exists to catch one level up.
export let DecimalRadix = 10 as ParsedInt
export let AsciiZeroDigit = 0x30 as ParsedInt
export let AsciiNineDigit = 0x39 as ParsedInt

// ⭐⭐ **THE BYTES AN OS LOCK NEEDS — the region a caller allocates and `osLockInit` initializes IN PLACE.**
// ⚠ Declared once because getting it wrong is not a compile error: the OS writes its struct into whatever it
// is handed, so an under-allocated region corrupts whatever the allocator put after it. Three runtime
// families allocate one (the scheduler's run-queue lock, the DebugStream ring's, and the slab's own state
// header, whose layout is computed from this number).
//
// ⭐ **IT IS THE MAXIMUM OVER THE TARGETS THIS COMPILER SERVES, NOT A PER-TARGET ANSWER, AND THAT IS
// DELIBERATE (MAC3).** A Win64 `CRITICAL_SECTION` is 40 bytes; a Darwin `pthread_mutex_t` is 64 (MEASURED on
// this host). Making the number target-dependent would make `SlabRuntime.SlabStateMcentralOffset` — a
// top-level `let` deriving a STRUCT LAYOUT from it — target-dependent too, which is a layout fork paid for by
// every allocation in the program to save 24 bytes on ONE lock per family. So there is one number, sized for
// the widest lock, and each backend ASSERTS that its own primitive fits (`Arm64DarwinRuntime`'s
// `assertDarwinLockFits`) rather than trusting this comment.
export let OsLockBytes = 64 as ParsedInt

// A fresh i64 constant.
export function emitConst(module StdModule, block IrBlock, value ParsedInt, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.const(v, value: value, valueType: StdType.i64))
	return v
end 'emitConst'

// `a <pred> b` into a fresh value (a flag).
//
// ⚠ `operandType` DEFAULTS to i64 rather than being spelled at each of its eighty-odd call sites, and the
// default is the GPR-only internal ABI this file's `emitParams` already states: every hand-assembled runtime
// chunk compares machine words. The only callers that do not are the FLOAT builtin-conformance impls
// (`BuiltinConformanceRuntime.buildFloatCompare` and `buildBuiltinEquals` under an f64 operand), and they
// pass `operandType` explicitly. Parameterized rather than FORKED into an `emitFloatCmp`: a fork would be
// this three-line body copied, so the day `StdOp.cmp` gains a field only one copy would learn about it.
export function emitCmp(module StdModule, block IrBlock, a ValueId, b ValueId, pred StdCmpPred, ids ValueMinter, operandType StdType = StdType.i64) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.cmp(v, lhs: a, rhs: b, pred: pred, operandType: operandType))
	return v
end 'emitCmp'

// ⭐⭐ **THE TWO EXITS OF EVERY THROWING RUNTIME FUNCTION, ONE HOME.** A throwing runtime body ends in the
// dual-register `errorReturn(value, flag)` ABI — `flag == NoErrorFlag` on the success edge, `ordinal +
// ErrorFlagOrdinalBias` on the failure edge — and every family needs both spellings.
//
// ⚠ **THEY WERE COPIED, AND THE COPY IS EXACTLY THE PAIR THIS PROJECT KEEPS FINDING DRIFTED.**
// `ManagedMemoryRuntime` had `emitErrorReturn`/`emitOkReturn` and `ManagedFileRuntime` had
// `emitManagedFileThrow`/`emitManagedFileOk` — the same two three-line bodies under two names, and R4.3
// would have made it three. They join the single-op emit helpers above for their reason: `MmRuntime` is the
// runtime's base layer and every family already draws on it, so homing them here needs no new dependency.
//
// ⚠ A VOID throwing function passes a 0 through `value` that the ABI never moves (a void
// `emitReturnValueMove` emits nothing); only the flag register is read.
export function emitErrorReturn(module StdModule, block IrBlock, flag ParsedInt, ids ValueMinter)
	let zeroVal = emitConst(module, block: block, value: 0, ids: ids)
	let flagVal = emitConst(module, block: block, value: flag, ids: ids)
	module.setTerminator(block, op: StdOp.errorReturn(zeroVal, errorFlagId: flagVal))
end 'emitErrorReturn'

// A successful throwing return: `errorReturn(value, 0)`. See `emitErrorReturn` for why the pair lives here.
export function emitOkReturn(module StdModule, block IrBlock, value ValueId, ids ValueMinter)
	let flag = emitConst(module, block: block, value: NoErrorFlag, ids: ids)
	module.setTerminator(block, op: StdOp.errorReturn(value, errorFlagId: flag))
end 'emitOkReturn'

// ⭐ **THE SUCCESS EXIT OF A THROWING *VOID* FUNCTION — the ok return with the placeholder the ABI never
// moves.** It is not a wrapper around `emitOkReturn`: what it adds is the 0, and that 0 is the whole of the
// duplication it removes. `__managed_set_length`, `__managed_set_byte`, `__managed_mem_grow`,
// `__md_create` and `__mf_*`'s void pair both end this way, and each spelled the same two
// statements out — one fact written down seven times, whose failure mode is a family that "returns void"
// with a garbage flag register the day the placeholder is written differently.
export function emitVoidOkReturn(module StdModule, block IrBlock, ids ValueMinter)
	let nothing = emitConst(module, block: block, value: 0, ids: ids)
	emitOkReturn(module, block: block, value: nothing, ids: ids)
end 'emitVoidOkReturn'

// Terminate `block` with `ret <constant>` — the shape EVERY runtime PREDICATE ends in, because there is no
// `setcc` at this tier: a verdict is a constant-returning block off a fused compare, one block per answer.
// A predicate therefore returns a CONSTANT from its own block rather than the compare's flag value directly
// — the shape the backend is exercised on, and the tier's shape rather than any one predicate's.
//
// ⚠ It lives with the single-op emit helpers, for `emitErrorReturn`'s stated reason: a helper about the STD
// TIER's lack of a `setcc` is the property of no one predicate family, and every family that answers a bool
// this way reaches it here rather than spelling the two statements out.
export function emitConstReturn(module StdModule, block IrBlock, value ParsedInt, ids ValueMinter)
	let result = emitConst(module, block: block, value: value, ids: ids)
	module.setTerminator(block, op: StdOp.ret(result))
end 'emitConstReturn'

// ⚠ **THE TWO BYTE LOADS AND `__str_copy` LIVE HERE, NOT IN `StringRuntime`.** They join the single-op
// emit helpers above for `emitConstReturn`'s stated reason, one family further out: a `u8` LOAD and a byte
// BLIT are properties of the Std tier, not of a String. `GraphemeRuntime`'s decoders and segmenter want
// them, and so do `Parser`'s interpolation, `GtRuntime`'s subprocess buffers, `__mm_to_cstring`'s copy path
// and every `emitBuildOwnedInlineString` blit — TWO files each owning "the ONE spelling" is what the header
// below exists to prevent. The callee KEEPS its `__str_copy` spelling: a runtime symbol's name is baked
// into goldens and into `RuntimeUsage`'s bit.

// The blit's callee name. `__`-prefixed compiler-internal (no E3004, no signature slotting) and NOT
// `__mm_`-prefixed, so `isRuntimeCallee` leaves it out of the heap decision — it allocates nothing, and a
// program that only blits bytes must not carry the allocator or the leak gate.
//
// ⚠ It is spelled `__str_copy` and stays spelled that way though it lives here now and has never been a
// String's: the name is baked into every committed golden that installs it and into `RuntimeUsage`'s
// `usesStrCopy` bit, so changing it would be a codegen change dressed as a rename.
export let StrCopyName = b"__str_copy"

// ⭐ **ONE BYTE AT `addr` — THE `u8` LOAD SPELLING FOR EVERY RUNTIME BUILDER**, so a widened read is a
// one-line change rather than a sweep of every byte-walking loop.
export function emitLoadByteAt(module StdModule, block IrBlock, addr ValueId, ids ValueMinter) returns ValueId
	let v = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(v, addrId: addr, offset: 0, valueType: StdType.u8))
	return v
end 'emitLoadByteAt'

// One byte at `base[index]` — the address add plus the `u8` load, the shape every byte-walking loop that
// does NOT also need the address repeats (the compare loop's two operands, the grapheme runtime's
// byte-view fill, the classifying scan in `__str_from_bytes`).
export function emitLoadByteIndexed(module StdModule, block IrBlock, base ValueId, index ValueId, ids ValueMinter) returns ValueId
	return emitLoadByteAt(module, block: block, addr: emitBin(module, block: block, a: base, b: index, opcode: StdBinOpcode.add, ids: ids), ids: ids)
end 'emitLoadByteIndexed'

// `__str_copy(dest, src, len)` — blit `len` bytes from `src` into `dest`. An emitted loop rather than a
// `rep movsb`/memcpy op because there is no memory-move op in the Std tier (`system` holds only
// `osAllocPages`/`osWriteStdout`), and a loop needs nothing the tier lacks.
//
// ⭐⭐ **ITS BODY IS `emitForwardCopy`, WHICH IS THE WHOLE FUNCTION.** Hand-building the header-guarded
// byte loop the two copy helpers in `ManagedMemoryRuntime` build would be one shape written down three
// times, in the three places a wider store would have to land at once. It is the LOW-ADDRESS-FIRST copy
// those helpers are: a machine word per trip and a byte tail. MEASURED on this tree's own
// self-compile (`--emit-ir`, `callDirect __str_copy`): 23,745 call sites — every String interpolation part
// and every String clone in the compiler — which makes it the most-called loop the language emits.
//
// ⚠ **THE FORWARD DIRECTION IS SOUND HERE BY CONSTRUCTION, NOT BY LUCK.** Every `__str_copy` writes into a
// FRESH record's inline buffer or a scratch allocation and reads from a different one, so `dest` and `src`
// name disjoint allocations and no overlap rule applies — see `emitForwardCopy` for the rule that does apply
// when they can be the same buffer.
export function buildStrCopy(module StdModule)
	var func = IrFunction.createFromStd(StrCopyName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 3)
	let dest = 0 as ValueId
	let src = 1 as ValueId
	let len = 2 as ValueId

	var done = emitForwardCopy(module, func: func, cur: entry, dest: dest, src: src, byteCount: len, ids: ids)
	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildStrCopy'

// ⭐ **THE TWO WORDS A STD-TIER PREDICATE RETURNS — 1 for yes, 0 for no — WRITTEN DOWN ONCE.** They live
// beside `emitConstReturn` because they are the same fact it is: with no `setcc` at this tier a bool is a
// returned CONSTANT, and which constant means true is not a property of any one runtime family.
//
// ⚠ **THIS WAS FIVE NAMED PAIRS AND TWO PAIRS OF BARE LITERALS, FOR ONE FACT.** `StrPredicateTrue`/`False`,
// `GraphemeTrue`/`False`, `EqualsTrue`/`False`, `ContainsFound`/`Missing`,
// and raw `0`/`1` at the hash-table and set `contains` returns. Each copy carried the same argument — that a
// caller must not read one function's "true" as another's "false" — while being the very thing that could
// make them disagree. The per-family pairs declined to share only because the HELPER was not shared either;
// now that it is, the constants ride the same base layer every runtime family already depends on.
export let PredicateTrue = 1 as ParsedInt
export let PredicateFalse = 0 as ParsedInt

// ⭐ **THE TWO DELTAS EVERY COUNTER AND REFCOUNT STEP IN THE EMITTED RUNTIME USES.** Named rather than
// written as a bare `1` and a bare `-1` at the sites that step a counter or a refcount by one: the two are
// one keystroke apart, and at a call site whose only other argument is a LABEL there is nothing else in the
// line to say which direction was meant. They are `ParsedInt` deltas fed to a plain `binOp add` — a counted
// box's refcount step and a single-writer counter — or to `StdOp.atomicRmw`'s `add` — a shared box's refcount
// step and a multi-M counter — which answers identically. That is why a debit is a NEGATIVE addend and not a
// second opcode: see `StdAtomicRmwOpcode`, which has one member for exactly this reason.
export let OneMore = 1 as ParsedInt
export let OneFewer = -1 as ParsedInt

// ⭐⭐ **THE COUNTED LOOP EVERY RUNTIME WALK IS, WRITTEN DOWN ONCE.** `i` from `from` up to (but excluding)
// `to`, stepping by whatever the caller closes it with: a header carrying the induction variable as its own
// block arg, a BODY the caller fills, an exit the caller terminates, and the back edge. A runtime function
// has no parser, so this on-the-fly SSA shape is built by hand — and it was built by hand, identically, in
// every loop-emitting builder of both runtime layers.
//
// ⭐ **IT IS TWO CALLS AND NOT ONE, BECAUSE THE BODY IS THE PART THAT VARIES — AND SOME BODIES BRANCH.**
// `openCountedLoop` hands back the body block; the caller emits its per-iteration work, which may thread
// through blocks of its own; `closeCountedLoop` is told the block that work ENDED in and puts the increment
// and the back edge there. That is what lets `__managed_fill`'s three stride arms share ONE loop shape when
// two of them are a single store and the third is a packed read-modify-write with a byte loop inside it.
export type CountedLoop
	// The loop header. The caller never emits into it — `openCountedLoop` has already terminated it.
	export var header as IrBlock

	// Where the caller emits this iteration's work.
	export var body as IrBlock

	// Where control lands once the count is exhausted. UN-terminated: the exit is the caller's.
	export var done as IrBlock

	// The induction variable — the header's block arg, readable in `body` and in every block it threads into.
	export var index as ValueId

	export static function create(header IrBlock, body IrBlock, done IrBlock, index ValueId) returns CountedLoop
		return Self{header: header, body: body, done: done, index: index}
	end 'create'
end 'CountedLoop'

// Open a counted loop off `cur`: terminate it with the entry edge carrying `from`, and mint the three
// blocks. A range whose `to` is at or below `from` runs ZERO times — the header's `>=` already holds on the
// entry edge — which is what makes an empty walk cost one compare rather than a guard of its own.
//
// `label` prefixes the three block labels (`<label>h`, `<label>b`, `<label>d`) so a function holding several
// loops reads back as several loops under `--emit-ir-runtime`.
export function openCountedLoop(module StdModule, func IrFunction, cur IrBlock, from ValueId, to ValueId, label ByteArray, ids ValueMinter) returns CountedLoop
	var header = module.addBlock(func, label: "{String.from(label)}h".toByteArray(), heat: BlockHeat.normal)
	var body = module.addBlock(func, label: "{String.from(label)}b".toByteArray(), heat: BlockHeat.normal)
	let done = module.addBlock(func, label: "{String.from(label)}d".toByteArray(), heat: BlockHeat.normal)

	module.setTerminator(cur, op: StdOp.branch(header.id))
	let i = ids.mint()
	header.blockArgs.push(IrBlockArg.create(i, argType: StdType.i64))
	cur.branchEdges.push(BranchEdge.create(header.id, argIds: argsOf(from)))

	let atEnd = emitCmp(module, block: header, a: i, b: to, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(header, op: StdOp.condBranch(atEnd, thenBlockId: done.id, elseBlockId: body.id))

	return CountedLoop.create(header, body: body, done: done, index: i)
end 'openCountedLoop'

// Close a counted loop: `tail` is the block the caller's per-iteration work ENDED in (`loop.body` when that
// work was straight-line), and this puts the increment and the back edge there.
//
// ⭐ **THE INCREMENT IS THE IMMEDIATE FORM, AND THAT IS DELIBERATE RATHER THAN A SHORTHAND.** It is the very
// op `foldConstOperands` produces, minted by the one party that already knows the operand is a compile-time
// constant — so the fold has nothing to find here, and the emitted trip carries one `add` rather than a
// `movRegImm32` AND an add, in the hottest loops the language has.
//
// ⛔ **THIS PARAGRAPH SAID THE RUNTIME "IS NEVER SHOWN `foldConstOperands`", AND EC3-H FALSIFIED THAT IN
// THE SAME RUNG THAT WROTE IT** — a second fold runs over exactly the appended band now
// (`Compiler.compileToCodeResult`'s install block owns that fact). The CHOICE survives its dead reason: an
// op the builder can mint directly is one the fold does not have to find, classify, rewrite and then DCE
// the `const` of. Do not read the correction as licence to spell a runtime constant as `const` + `binOp`.
export function closeCountedLoop(module StdModule, loop CountedLoop, tail IrBlock, step Imm32, ids ValueMinter)
	let next = ids.mint()
	module.appendOp(tail, op: StdOp.binOpImm(next, lhs: loop.index, imm: step, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.setTerminator(tail, op: StdOp.branch(loop.header.id))
	tail.branchEdges.push(BranchEdge.create(loop.header.id, argIds: argsOf(next)))
end 'closeCountedLoop'

// `byteCount and -8` — how many of `byteCount`'s bytes a run of WHOLE machine words covers. Derived from the
// word size rather than written as a `-8` beside it: the mask and the step of the word loop are one fact.
let WholeWordsMask = -(MachineWordBytes as ParsedInt)

// The step of a counted loop that advances ONE item per trip — one byte, one element, one slot. Named
// because `closeCountedLoop`'s step is a WIDTH everywhere else in this family (a word copy steps eight), so
// a bare 1 beside a `MachineWordBytes` reads as a width that happens to be small rather than as "the next
// one".
export let SingleStep = 1 as Imm32

// ⭐⭐ **THE WORD/TAIL PARTITION EVERY EMITTED CONTIGUOUS COPY RUNS ON, DERIVED IN ONE PLACE.** A
// range of `byteCount` bytes splits into `[0, byteCount and -8)`, which whole machine words cover exactly,
// and `[byteCount and -8, byteCount)`, the `byteCount mod 8` left over. `openWordTailSplit` emits that
// split's guard and its one piece of arithmetic; the caller emits the two runs, in whatever ORDER its
// direction needs, and branches its last one into `done`.
//
// ⭐ **THE SPLIT AND THE RUNS ARE SEPARATE CALLS BECAUSE THE ORDER IS THE PART THAT VARIES.** A
// low-address-first copy (`emitForwardCopy`) runs the words then the tail; an overlap-safe HIGH-address-first
// copy (`emitBackwardCopy`) must run the TAIL first, since it sits at the top of the range and a backward move
// has to touch the highest bytes before anything overwrites them. One partition, two orders — so the
// partition is what is shared.
//
// ⚠ **THE CONTIGUOUS FILL IS NOT A CALLER, AND FOR ONE RUNG (EC3-F) IT WAS THIS FAMILY'S THIRD.** A fill has
// been `StdOp.memFill` since the allocator rung — one op, lowered by each target as a size ladder of its own
// (`encodeX64MemFill`, `arm64MemFill`, wasm's `memory.fill`) — so `buildMmFree`'s poison, the slab's
// recycled-slot zeroer and `buildManagedZeroElems`'s byte arm build no loop here. The partition stays for
// the copies, which have a SOURCE as well as a destination and no op in the dialect.
//
// ⚠ **UNALIGNED WORD ACCESSES ARE WHAT MAKE THE WORD RUN LEGAL AT ALL, AND EVERY TARGET THIS COMPILER
// EMITS PERMITS THEM.** x64 and arm64 allow them on normal memory, and wasm's `i64.load`/`i64.store` memarg
// alignment is a HINT that never changes what the access does. Every address this family is handed is an
// arbitrary interior one — an element slot, a payload pointer, a String record's inline buffer — so this is
// not a precondition the callers have to satisfy but the reason no alignment fixup is needed anywhere.
export type WordTailSplit
	// Where the caller emits its runs. Reached only when `byteCount > 0`.
	export var run as IrBlock

	// The continuation, un-terminated: the caller's last run branches into it. The empty-range door also
	// lands here, so a caller threads exactly one exit.
	export var done as IrBlock

	// `byteCount and -8` — the end of the word run and the start of the byte tail, the one boundary both
	// runs read.
	export var wordEnd as ValueId

	export static function create(run IrBlock, done IrBlock, wordEnd ValueId) returns WordTailSplit
		return Self{run: run, done: done, wordEnd: wordEnd}
	end 'create'
end 'WordTailSplit'

// Open the word/tail split off `cur`, labelling its two blocks `<label>run` and `<label>d`.
//
// ⚠ **THE `byteCount <= 0` DOOR IS A CORRECTNESS GUARD, NOT A FAST PATH FOR THE EMPTY RANGE.** A NEGATIVE
// count masks to a NEGATIVE word end, and the byte tail would then walk `[byteCount and -8, byteCount)` —
// touching up to seven bytes BEFORE `dest`. The single byte loops this family replaces were safe under that
// by accident (their `i >= byteCount` held at once), and memory-writing primitives under every array move
// and String copy do not get to lose that. No caller passes one today; the guard is what keeps that from
// being load-bearing. It absorbs the empty range (a zero-length `__str_copy`, a move of no elements) on the
// way past.
export function openWordTailSplit(module StdModule, func IrFunction, cur IrBlock, byteCount ValueId, label ByteArray, ids ValueMinter) returns WordTailSplit
	var run = module.addBlock(func, label: "{String.from(label)}run".toByteArray(), heat: BlockHeat.normal)
	let done = module.addBlock(func, label: "{String.from(label)}d".toByteArray(), heat: BlockHeat.normal)

	let nothing = emitConst(module, block: cur, value: 0, ids: ids)
	let empty = emitCmp(module, block: cur, a: byteCount, b: nothing, pred: StdCmpPred.le, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(empty, thenBlockId: done.id, elseBlockId: run.id))

	let wordMask = emitConst(module, block: run, value: WholeWordsMask, ids: ids)
	let wordEnd = emitBin(module, block: run, a: byteCount, b: wordMask, opcode: StdBinOpcode.bitAnd, ids: ids)

	return WordTailSplit.create(run, done: done, wordEnd: wordEnd)
end 'openWordTailSplit'

// Close the split: `tail` is the block the caller's LAST run ended in, and this branches it into the
// continuation and answers that continuation. `closeCountedLoop`'s counterpart one level up.
//
// It exists so that no caller has to know HOW the two exits meet. The empty-range door and the completed
// runs land in the same block by a plain branch today; a caller that spelled `branch(split.done.id)` itself
// would be a third party stating that, in two places, for a join it does not own.
export function closeWordTailSplit(module StdModule, split WordTailSplit, tail IrBlock) returns IrBlock
	module.setTerminator(tail, op: StdOp.branch(split.done.id))

	return split.done
end 'closeWordTailSplit'

// `__mm_alloc(size, destructor) -> ptr` — a managed box: a header plus `size` bytes of payload.
//
// The returned pointer addresses the PAYLOAD, so a struct's field `i` is at `[ptr + i*8]` and the
// header is invisible to every consumer. `destructor` is stored for `__mm_free` to find; for a
// trivially-owned struct it is **0**, and that is not a placeholder — nothing about a struct of
// scalars needs to run at death, so there is no function to point at. (Synthesizing an empty one
// just to have a non-null pointer would be a function with no reason to exist.)
//
// ⭐⭐ **THE WHOLE BOX IS ONE SLAB REQUEST, AND THE BOX LAYER COMPUTES NO SIZE CLASS OF ITS OWN (S4).**
// `header + payload` goes to `__slab_alloc`, which picks the class, hands back a slot of at least that many
// bytes and REMEMBERS which span it came from; `__mm_free` gives that same pointer back and the span
// answers which class the slot belongs to, so nothing shifts a rounded size out of the header. The
// header records what the CALLER asked for (see `HeaderSizeOffset`) and the slack between it and the end of
// the slot is the allocator's business, exactly as the slack inside a size class is.
//
// ⚠ **A TRACED BUILD AND A NORMAL ONE SHARE ONE BODY SHAPE**, differing only in the tag argument below.
function buildMmAlloc(module StdModule, model MachineModel)
	// ⚠ **THE ARITY IS THE FLAG'S, AND THAT IS WHY EVERY CALL SITE GOES THROUGH `emitMmAllocCall`.** A
	// `--debugstream` build takes a THIRD argument — the allocation's tag index — because a tag cannot be
	// recovered from a pointer later and this is the only moment it is known. A normal build takes two, so
	// its emitted call sites carry nothing of the flag.
	let debugStream = module.debugStream
	let paramCount = 3 if debugStream else 2
	let paramTypes = threeI64Params() if debugStream else twoI64Params()
	var func = IrFunction.createFromStd(MmAllocName, returnType: StdReturnType.value(StdType.i64), paramCount: paramCount, paramTypes: paramTypes, returnLine: 0)
	var ids = ValueMinter.create(paramCount)

	var block = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: block, count: paramCount)
	let size = 0 as ValueId
	let destructor = 1 as ValueId
	let tagIndex = 2 as ValueId

	let headerConst = ids.mint()
	module.appendOp(block, op: StdOp.const(headerConst, value: boxPrefixBytes(debugStream), valueType: StdType.i64))
	let total = ids.mint()
	module.appendOp(block, op: StdOp.binOp(total, lhs: size, rhs: headerConst, opcode: StdBinOpcode.add, operandType: StdType.i64))
	let allocation = ids.mint()
	module.appendOp(block, op: StdOp.call(allocation, callee: SlabAllocName, args: argsOf(total)))

	// The DebugStream prefix word, when this build has one: `(alloc_id << 16) | tag_index`, stamped once
	// here and read back by every later event on this box. `alloc_id` PRE-increments a monotonic counter,
	// so the first allocation is #1 and a zero packed id can only ever mean "never stamped".
	//
	// ⭐ **THAT PRE-INCREMENT IS ALSO WHAT MAKES A RECYCLED ADDRESS LEGIBLE IN A TRACE**: the id belongs to
	// the ALLOCATION and never to the address, so an address handed out twice carries two ids and the
	// `mm_free` that separates them names the first.
	//
	// ⚠⚠ **`payloadOffset` REUSES `headerConst` WHEN THE BUILD IS UNTRACED, AND THAT IS NOT A
	// MICRO-OPTIMISATION — IT IS THE BYTE-IDENTICAL RULE.** With no prefix word the two distances are the
	// same number, and minting a SECOND `const HeaderBytes` for the payload offset is one more op in
	// `__mm_alloc`: the register allocator then makes different choices and every heap program's `.text`
	// moves, against thousands of committed fragment goldens. (Measured on O3's first byte-identical check:
	// identical printed IR, 1084 differing bytes in the linked image.) Under the flag the two genuinely
	// differ — the total includes the prefix word, the payload offset does not — so the second constant is
	// minted there and only there.
	var payloadOffset = headerConst
	var base = allocation
	var packedId = 0 as ValueId

	if debugStream 'stampPackedId'
		let one = emitConst(module, block: block, value: OneMore, ids: ids)

		// ⚠ The mint wants the id it just TOOK, and `emitGlobalAccumulate` answers the one before it (that
		// function's header says why the prior value is the contract), so the step is re-applied here. Ids
		// still run 1, 2, 3 in allocation order. Atomic in every traced build: an id must be unique across
		// every thread, and a traced build is an instrument that pays for its own exactness.
		let priorAllocId = emitGlobalAccumulate(module, block: block, label: DsAllocIdLabel, delta: one, multiM: true, ids: ids)
		let allocId = emitBin(module, block: block, a: priorAllocId, b: one, opcode: StdBinOpcode.add, ids: ids)
		let shift = emitConst(module, block: block, value: DsMmPackedIdShift, ids: ids)
		let shifted = emitBin(module, block: block, a: allocId, b: shift, opcode: StdBinOpcode.shl, ids: ids)
		packedId = emitBin(module, block: block, a: shifted, b: tagIndex, opcode: StdBinOpcode.bitOr, ids: ids)
		module.appendOp(block, op: StdOp.storeIndirect(allocation, offset: 0, valueId: packedId, valueType: StdType.i64))

		let prefix = emitConst(module, block: block, value: DebugStreamPackedIdBytes, ids: ids)
		base = emitBin(module, block: block, a: allocation, b: prefix, opcode: StdBinOpcode.add, ids: ids)
		payloadOffset = emitConst(module, block: block, value: HeaderBytes, ids: ids)

		emitAllocTallyStep(module, block: block, tagIndex: tagIndex, size: size, ids: ids)
	end 'stampPackedId'

	module.appendOp(block, op: StdOp.storeIndirect(base, offset: HeaderDestructorOffset, valueId: destructor, valueType: StdType.i64))
	module.appendOp(block, op: StdOp.storeIndirect(base, offset: HeaderSizeOffset, valueId: size, valueType: StdType.i64))

	// ⭐ THE REFCOUNT IS NOT WRITTEN, AND ITS ABSENCE IS THE ZEROING CONTRACT DOING ITS JOB. The slab
	// guarantees zeroed memory — a VIRGIN slot because its pages came straight from the OS, a RECYCLED one
	// because `__slab_alloc`'s recycled arm re-zeroes the whole slot on the way out — and 0 is exactly the
	// initial refcount this model wants (see `__mm_decref`: 0 means ONE owner). Storing it anyway would be the
	// caller re-establishing a guarantee the allocator already makes, which is the habit that lets a
	// non-zeroing allocator survive its own bugs: every call site "handles" it locally, so nobody fixes
	// the allocator. If this line ever becomes necessary, the allocator is broken, not this function.

	// The TRACKED columns, on the calling thread's row. `size` and not `total`: the figure is the payload
	// the caller asked for, so it does not move when the header does and is identical across a traced and
	// an untraced build. The region is committed — the `__slab_alloc` above committed it — so the base is
	// a plain load.
	block = emitTrackedTrafficStep(module, func: func, cur: block, model: model, event: SlabTrafficEvent.alloc(size), ids: ids)

	let payload = ids.mint()
	module.appendOp(block, op: StdOp.binOp(payload, lhs: base, rhs: payloadOffset, opcode: StdBinOpcode.add, operandType: StdType.i64))

	var out = emitMmAllocEvent(module, func: func, block: block, packedId: packedId, size: size, ids: ids)
	module.setTerminator(out, op: StdOp.ret(payload))

	module.functions.push(func)
end 'buildMmAlloc'

// ⭐ **THE `__mm_alloc` CALL EMISSION FOR EVERY BOX BUILT AS ALREADY-LOWERED `StdOp`s — a String record, an
// array record, its element buffer, a list node, a user struct — so `__mm_alloc(size, destructor[, tag])`
// has one spelling at this tier.** The Maxon→Std lowering has the other, `LowerMaxonToStd.appendMmAllocTag`,
// which cannot come through here: it mints from its own dense per-function counter rather than a
// `ValueMinter`, and the two headers name each other so the flag-dependent arity moves in both.
// `Parser.emitBoxAlloc`'s header already argued the point for the three call sites it consolidated
// ("an added or reordered alloc argument that reached three of those call sites and missed the fourth
// would corrupt that box silently"); `--debugstream` is that added argument, and it reaches fifteen.
//
// ⛔⛔ **AND A COMMENT IS NOT WHAT KEEPS A SITE ON THIS ROAD.**
// `StdDialect.assertCallsMatchCalleeArity` checks every emitted call in the finished module against its
// callee's parameter count, on every compile, so a site that spells its own two-argument `StdOp.call` is
// refused by name in a traced build rather than silently handing the callee a register nothing wrote.
//
// The TAG names what the box IS. A runtime chunk knows that statically and passes a fixed roster case; a
// USER allocation's is interned from its own result type at the lowering (see `LowerMaxonToStd`'s
// `__mm_alloc` arm), which is the only tier that can see it.
export function emitMmAllocCall(module StdModule, block IrBlock, result ValueId, size ValueId, destructor ValueId, tag ParsedInt, ids ValueMinter)
	if not module.debugStream 'untracedBuild'
		module.appendOp(block, op: StdOp.call(result, callee: MmAllocName, args: twoArgs(size, second: destructor)))
		return
	end 'untracedBuild'

	let tagIndex = emitConst(module, block: block, value: tag, ids: ids)
	module.appendOp(block, op: StdOp.call(result, callee: MmAllocName, args: threeArgs(size, second: destructor, third: tagIndex)))
end 'emitMmAllocCall'

// ⭐ **THE `--debugstream` PREFIX WORD'S ADDRESS — `ptr - (HeaderBytes + DebugStreamPackedIdBytes)`.**
// The one place the word's position is expressed, exactly as `emitHeaderBase` is for the header itself,
// and asked ONLY by the three event emitters below. See `DebugStreamPackedIdBytes` for why it sits below
// the header rather than among its fields.
function emitLoadPackedId(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let prefixConst = emitConst(module, block: block, value: boxPrefixBytes(true), ids: ids)
	let packedIdAddr = emitBin(module, block: block, a: ptr, b: prefixConst, opcode: StdBinOpcode.sub, ids: ids)
	return emitLoadField(module, block: block, record: packedIdAddr, offset: 0, ids: ids)
end 'emitLoadPackedId'

// ⭐⭐ **THE FOUR EVENT EMITTERS, AND EVERY ONE OF THEM ASKS `module.debugStream` ITSELF.**
//
// ⚠⚠ **THAT GATE IS NOT REDUNDANT WITH `emitMmEvent`'S — `emitMmEvent` HAS NONE, DELIBERATELY.** The
// arguments these pass cost OPS to compute (a refcount load, a packed-id load, a plus-one), and those ops
// would be emitted before a gate inside `emitMmEvent` could decline them — which is not a cosmetic
// difference: a `globalAddr __ds_base` emitted into an untraced build names a `.data` slot that build
// never laid out, and the backend PANICS at the relocation. (Measured, on the first byte-identical check
// of this rung: `buildMmAlloc` called `emitMmEvent` directly and every heap program failed to link.) So
// the compile-time gate lives at each of the four, where the arguments are built.
//
// ⭐ **AND THE `owners - 1` CONVENTION IS TRANSLATED HERE.**
//
// The compiler stores `owners - 1` in the refcount word — a box is born at 0 meaning ONE owner
// (`emitRefcountCheckToLastOwner` argues why). That convention is PRIVATE to this file, and the wire's
// `rc=` field is not: the monitor's reader means OWNER COUNT by it. So the translation happens once, here,
// rather than leaking a storage detail into the trace.
//
// ⚠ **DECREF IS THE SUBTLE ONE, AND ITS EXPRESSION IS UNIFORM ONLY BECAUSE OF AN IDENTITY.** On the
// SHARED path the stored count goes `n -> n-1`, so owners go `n+1 -> n`; on the LAST-OWNER path the box
// dies and owners go `1 -> 0`. Both are `owners_after == stored_BEFORE` — the shared case by arithmetic,
// the last-owner case because the stored value is 0 there. That identity is why the event is emitted ONCE,
// in the block before the branch, instead of once per arm.
//
// ⭐ **SINCE G2 THAT PRIOR COUNT IS HANDED IN RATHER THAN RE-READ, AND IT IS STILL THE ONLY WAY TO GET IT.**
// The decrement happens before the branch and answers the value it displaced
// (`emitRefcountCheckToLastOwner`), so the trace reports the count THIS decref displaced. G2's reason was
// that another M could move the word in between; EC10 removed that M and the conclusion is unchanged for a
// nearer one — the decrement has already STORED the new count, so a re-read answers the count after this
// event rather than before it.
//
// The alloc event, with the requested USER size as its value — never the total, so the number in the
// trace is the one the caller asked for and stays comparable across a header that grows. It is the one
// emitter that takes the packed id as a VALUE rather than reading it back out of the box: `__mm_alloc` has
// just computed it, and re-loading what is already in a register would be the only place in this family
// where the box is read for something the caller knows.
function emitMmAllocEvent(module StdModule, func IrFunction, block IrBlock, packedId ValueId, size ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmAlloc, packedId: packedId, value: size, ids: ids)
end 'emitMmAllocEvent'

function emitMmDecrefEvent(module StdModule, func IrFunction, block IrBlock, ptr ValueId, priorCount ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	let packedId = emitLoadPackedId(module, block: block, ptr: ptr, ids: ids)
	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmDecref, packedId: packedId, value: priorCount, ids: ids)
end 'emitMmDecrefEvent'

// Called with the count the increment DISPLACED, so the word now holds `priorCount + 1` and owners are that
// plus one again — the `owners - 1` convention applied to the value this build actually wrote, rather than
// to a re-read that another M may already have moved.
function emitMmIncrefEvent(module StdModule, func IrFunction, block IrBlock, ptr ValueId, priorCount ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	let one = emitConst(module, block: block, value: OneMore, ids: ids)
	let stored = emitBin(module, block: block, a: priorCount, b: one, opcode: StdBinOpcode.add, ids: ids)
	let ownersAfter = emitBin(module, block: block, a: stored, b: one, opcode: StdBinOpcode.add, ids: ids)
	let packedId = emitLoadPackedId(module, block: block, ptr: ptr, ids: ids)
	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmIncref, packedId: packedId, value: ownersAfter, ids: ids)
end 'emitMmIncrefEvent'

// A free carries no value: the box has no size to report that the alloc did not already, and no refcount
// left to report at all. The wire's value slot is unused for this event and the monitor never reads it.
function emitMmFreeEvent(module StdModule, func IrFunction, block IrBlock, ptr ValueId, ids ValueMinter) returns IrBlock
	if not module.debugStream 'untracedBuild'
		return block
	end 'untracedBuild'

	let packedId = emitLoadPackedId(module, block: block, ptr: ptr, ids: ids)
	let unused = emitConst(module, block: block, value: 0, ids: ids)
	return emitMmEvent(module, func: func, block: block, eventType: DsEvMmFree, packedId: packedId, value: unused, ids: ids)
end 'emitMmFreeEvent'

// ⭐ **`__mm_incref(ptr)` — ONE MORE OWNER.**
//
// ⭐ **ITS FIRST CONSUMER IS `__managed_slice`'s ZERO-COPY VIEW.** A view is a second owner of the parent's
// ELEMENT BUFFER — a separate `__mm_alloc` allocation from either record — so taking a slice increfs that
// buffer and dropping (or detaching) a view decrefs it. What is counted is the buffer, not the record: a
// buffer's non-zero count means "someone else may be reading these bytes" — a view, or a lend that shared
// them — which is precisely what `__managed_cow_detach` must ask before an in-place write.
//
// ⭐ **AN IMAGE RECORD LEAVES AT THE TOP, UNCOUNTED.** Its header is in `.rdata`, so a read-modify-write would
// be a write into a read-only page; and there is nothing to count — the record outlives every owner. The
// paired release is `emitRefcountCheckToLastOwner`'s own immortal arm, which is what keeps the skip from
// being a leak.
//
// There is no overflow check: a program cannot hold 2^61 owners of one box.
function buildMmIncref(module StdModule)
	var func = IrFunction.createFromStd(MmIncrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var immortal = module.addBlock(func, label: b"immortal", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId

	var owned = emitOneMoreOwner(module, func: func, entry: entry, ptr: ptr, immortal: immortal, ids: ids)
	module.setTerminator(immortal, op: StdOp.retVoid)
	module.setTerminator(owned, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmIncref'

// ⭐ **`__mm_retain(ptr) -> ptr` — ONE MORE OWNER, HANDING BACK A FRESH SSA NAME FOR THE SAME BOX.**
//
// The incref twin of `buildMmIncref`, differing only in that it RETURNS the pointer. The parser needs both
// halves at once to co-own a BORROWED managed-aggregate parameter into a `var` (`var q = p`): the incref makes
// `q` a second owner of the caller's box, and the RETURN gives `q` a ValueId DISTINCT from `p`'s. That
// distinct name is load-bearing: were `q` to reuse `p`'s ValueId while owned, a later re-borrow of `p`
// (`let r = p`) would `poisonMoveSource`-match `q` and wrongly poison it (see `Parser.retainBorrowedAggregate`).
// The box is otherwise untouched, so the aggregate's aliasing (`q.x = 100` shows through) is preserved.
//
// ⭐ **AN IMAGE RECORD IS HANDED STRAIGHT BACK, UNCOUNTED**, for `buildMmIncref`'s reasons.
function buildMmRetain(module StdModule)
	var func = IrFunction.createFromStd(MmRetainName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var immortal = module.addBlock(func, label: b"immortal", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId

	var owned = emitOneMoreOwner(module, func: func, entry: entry, ptr: ptr, immortal: immortal, ids: ids)
	module.setTerminator(immortal, op: StdOp.ret(ptr))
	module.setTerminator(owned, op: StdOp.ret(ptr))

	module.functions.push(func)
end 'buildMmRetain'

// ⭐⭐⭐ **`__mm_own(box) -> box` — TAKE OWNERSHIP OF A PLAIN BOX A DURABLE SINK IS ABOUT TO HOLD, COPYING IT
// WHEN IT IS IMAGE DATA.**
//
// ⛔⛔ **THE PLAIN `__mm_incref` IS BALANCED FOR REFCOUNTING AND WRONG FOR WRITABILITY, AND THAT IS THE
// DEFECT THIS EXISTS TO CLOSE.** An imaged struct's box lives in `.rdata` and its incref does nothing, so
// the sink comes to own a READ-ONLY record and the first field write through it faults on x64 and silently
// corrupts the image on wasm, which has no read-only section. MEASURED, two routes: a struct field
// (`Holder.create(Seed)` then `h.m.next = 9`) and a container feed (`xs.push(Seed)` then a write through the
// element) — an access violation each. It is `ManagedMemoryRuntime.__managed_retain`'s fork, over the shape
// whose provenance is in the HEADER rather than in `capacity@16`.
//
// ⚠ **THE FORK IS AT RUN TIME BECAUSE PROVENANCE IS NOT A COMPILE-TIME FACT** — a merge phi may join an
// imaged record with a heap one, which is the reading `LiteralArgPromotion`'s header already records for the
// String half of the same question.
//
// ⛔⛔ **A BYTE BLIT IS THE WHOLE CLONE, AND ONLY BECAUSE THE CALLER GATES THE BOXES THAT REACH IT.** An
// imaged struct MAY hold a slot addressing another image object — an empty column, a nested box — and a blit
// leaves the copy's slot addressing the `.rdata` one, so the second owner writes the image through one more
// indirection. `Parser.valueIsAnImageableDeepBox` sends exactly those boxes to `__mm_own_deep` instead, and
// what is left here owns no slot a second owner could be wrong about; `destructor@0` is trivial for the same
// reason.
function buildMmOwn(module StdModule)
	var func = IrFunction.createFromStd(MmOwnName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var copy = module.addBlock(func, label: b"copy", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let box = 0 as ValueId

	var owned = emitOneMoreOwner(module, func: func, entry: entry, ptr: box, immortal: copy, ids: ids)

	let header = emitHeaderBase(module, block: copy, ptr: box, ids: ids)
	let size = emitLoadField(module, block: copy, record: header, offset: HeaderSizeOffset, ids: ids)
	let trivial = emitConst(module, block: copy, value: TrivialDestructor, ids: ids)
	let fresh = ids.mint()
	emitMmAllocCall(module, block: copy, result: fresh, size: size, destructor: trivial, tag: mmTagIndex(MmTag.Untagged), ids: ids)
	module.appendOp(copy, op: StdOp.call(ids.mint(), callee: StrCopyName, args: threeArgs(fresh, second: box, third: size)))
	module.setTerminator(copy, op: StdOp.ret(fresh))

	module.setTerminator(owned, op: StdOp.ret(box))

	module.functions.push(func)
end 'buildMmOwn'

// ⭐⭐⭐ **`__mm_own_deep(box, cloner) -> box` — `__mm_own` FOR A BOX WHOSE SLOTS ADDRESS OTHER RECORDS.**
// A declared generic's container (`Map`, `Set`, and every base written the way they are) is such a box, and
// so is a user struct whose fields hold one: an empty one of either is image data
// (`ProgramSignatures.declaredContainerBoxIsImageData` / `structBoxIsImageableWithSlots`), its slots hold
// the imaged empty columns, and a durable sink holding it writes a read-only page at the first `upsert` — a
// fault on x64 and, on wasm32-wasi, which has no read-only section, a silent rewrite of the constant that
// only the leak gate catches.
//
// ⛔⛔ **`__mm_own`'S BLIT CANNOT SERVE IT, ON BOTH HALVES.** That copy is sound only where every field of
// the imaged box is a scalar, which a container box's slots are not; and a blit leaves the copy's own slots
// addressing the `.rdata` columns, so the second owner writes the image through one more indirection. The
// copy must therefore be the instance's OWN deep cloner, which allocates a fresh box and replaces every
// managed slot with an independent record.
//
// ⚠ **THE CLONER IS AN ARGUMENT RATHER THAN A PER-INSTANCE ENTRY** for `__managed_clone_managed`'s reason
// one tier down: the fork, the count and the routing are one body over every instance, and only the
// `(box) -> newBox` differs. The caller stamps it as `funcAddr(__clone_<mangled>)`, which is what roots the
// synthesis (`RuntimeUsage.recordFunctionRefUsage`).
//
// ⚠ **AND THE FORK IS AT RUN TIME BECAUSE PROVENANCE IS NOT A COMPILE-TIME FACT** — a merge phi may join an
// imaged box with a heap one, exactly as `buildMmOwn`'s header records for the scalar-struct half.
function buildMmOwnDeep(module StdModule)
	var func = IrFunction.createFromStd(MmOwnDeepName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var cloned = module.addBlock(func, label: b"cloned", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let box = 0 as ValueId
	let cloner = 1 as ValueId

	var owned = emitOneMoreOwner(module, func: func, entry: entry, ptr: box, immortal: cloned, ids: ids)

	let fresh = ids.mint()
	module.appendOp(cloned, op: StdOp.callIndirect(fresh, calleeReg: cloner, resultType: StdReturnType.value(StdType.i64), argFloatMask: 0, args: argsOf(box)))
	module.setTerminator(cloned, op: StdOp.ret(fresh))

	module.setTerminator(owned, op: StdOp.ret(box))

	module.functions.push(func)
end 'buildMmOwnDeep'

// Take one more owner of `ptr` and trace it, continuing in the returned block; an image record leaves for
// `immortal` untouched. The acquire every incref-shaped entry makes, written once so the four cannot come to
// step or trace a count differently.
function emitOneMoreOwner(module StdModule, func IrFunction, entry IrBlock, ptr ValueId, immortal IrBlock, ids ValueMinter) returns IrBlock
	let step = emitStepOwnerCount(module, func: func, entry: entry, ptr: ptr, delta: OneMore, immortal: immortal, ids: ids)
	return emitMmIncrefEvent(module, func: func, block: step.block, ptr: ptr, priorCount: step.prior, ids: ids)
end 'emitOneMoreOwner'

// `__mm_sole_box(box, visits)` / `__mm_share_box(box, visits)` — the handle's walk step as an entry of its own
// (see `MmSoleBoxName`). A handle's box addresses no managed record, so there is nothing below it to descend into.
function buildMmBoxWalk(module StdModule, action CascadeAction)
	let body = beginWalkBody(module, name: serviceHandleCascadeCallee(action), scope: WalkScope.graph, walksElements: false, recursesPerLevel: false)
	let descend = emitBoxWalkStep(module, func: body.func, cursor: body.entry, box: WalkBoxParam, action: action, meeting: WalkMeeting.owner, stop: body.done, ids: body.ids)
	emitCascadeBranch(module, from: descend, to: body.done)
	finishWalkBody(module, body: body)
end 'buildMmBoxWalk'

// ⭐ **EVERY WALK ENTRY'S SIGNATURE.** Over a graph, `(box, visits) -> visits`, and `(box, visits, elementWalk) ->
// visits` for a container's per-element entry: `visits` is the visit table (`WalkVisitTable`), answered back
// because a meeting may create or grow it. Over one record, `(box)`: one record meets nothing twice.
export let WalkBoxParam = 0 as ValueId
let WalkVisitsParam = 1 as ValueId
let WalkElementWalkParam = 2 as ValueId
let SingleValueEntryParamCount = 1 as ParamCount
let WalkParamCount = 2 as ParamCount
let ElementWalkParamCount = 3 as ParamCount

// An entry whose whole body is an abort, and the caller states its arity because it must be the arity of the
// WORD it stands in for: it is reached through a `callIndirect` on a witness word, so a parameter list that
// merely fits the abort disagrees with the call — a disagreement wasm refuses as an invalid module.
function buildAbortingRuntimeEntry(module StdModule, symbolName ByteArray, paramCount ParamCount, paramTypes StdTypeArray, abort RuntimeAbort)
	var func = IrFunction.createFromStd(symbolName, returnType: StdReturnType.value(StdType.i64), paramCount: paramCount, paramTypes: paramTypes, returnLine: 0)
	var ids = ValueMinter.create(paramCount)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: paramCount)
	emitRuntimeAbort(module, func: func, block: entry, abort: abort, ids: ids)

	module.functions.push(func)
end 'buildAbortingRuntimeEntry'

// A walk over a graph carries exactly one value from block to block, its visit table; a walk over one record
// carries none.
let WalkCarriedValueCount = 1

// How much of a graph one walk entry sees.
export enum WalkScope
	// A graph that may reach one record along several paths, so its meetings are counted in a visit table.
	graph

	// One record, which the walk meets once.
	record
end 'WalkScope'

// ⭐ **WHICH REFERENCE TO A COUNTED RECORD A WALK HAS MET.** Both count against the record's owners; they differ in
// what an owner the walk never meets means. Behind an `owner` meeting it is a path to a write, and the hand-off
// aborts. Behind `view` meetings alone it is not: a view never writes, and an owner of the bytes writes only after
// it copies them out. So a record only views have met tolerates owners outside the graph, and a record an owner
// meets does not.
export enum WalkMeeting
	// A field, a slot, a payload or the root holding the record.
	owner

	// A byte view's reference to the allocation its bytes live in.
	view
end 'WalkMeeting'

function walkEntryParamCount(scope WalkScope, walksElements bool) returns ParamCount
	match scope 'scope'
		graph then return ElementWalkParamCount if walksElements else WalkParamCount
		record then break 'scope'
	end 'scope'

	if walksElements 'oneRecordHasNoElementWalk'
		panic("walkEntryParamCount: a walk over one record is handed no element walk")
	end 'oneRecordHasNoElementWalk'

	return SingleValueEntryParamCount
end 'walkEntryParamCount'

function walkScopeOf(cursor CascadeCursor) returns WalkScope
	if cursor.carried.count() == WalkCarriedValueCount 'carriesAVisitTable'
		return WalkScope.graph
	end 'carriesAVisitTable'

	if cursor.carried.count() == 0 'carriesNothing'
		return WalkScope.record
	end 'carriesNothing'

	panic("walkScopeOf: a cursor carrying {cursor.carried.count()} values is no walk's")
end 'walkScopeOf'

// ⭐ **WHERE A CASCADE BODY'S EMISSION CONTINUES, AND THE VALUES ITS BLOCKS CARRY FORWARD** — nothing for a
// clone or a walk over one record, the visit table for a walk over a graph. A join block takes each carried value
// as a block argument, so a value one arm replaces reaches the code after the join.
export type CascadeCursor
	export let block as IrBlock
	export let carried as ValueIdArray

	export static function create(block IrBlock, carried ValueIdArray) returns CascadeCursor
		return Self{block: block, carried: carried}
	end 'create'

	// The same carried values, continuing in `next` — sound only where they dominate `next`.
	export function at(next IrBlock) returns CascadeCursor
		return CascadeCursor.create(next, carried: self.carried)
	end 'at'

	export function visits() returns ValueId
		if self.carried.count() != WalkCarriedValueCount 'notAGraphWalk'
			panic("CascadeCursor.visits: this cursor carries {self.carried.count()} values, and only a graph walk's cursor carries its one visit table")
		end 'notAGraphWalk'

		return try self.carried.get(0) otherwise panic("CascadeCursor.visits: carried.get(0) OOB after the count test")
	end 'visits'
end 'CascadeCursor'

// Append one i64 block argument to `block` per value `template` holds, answering the argument ids in order.
export function appendCarriedBlockArgs(block IrBlock, template ValueIdArray, ids ValueMinter) returns ValueIdArray
	var args = ValueIdArray.create()

	for _ in template 'eachCarried'
		let arg = ids.mint()
		block.blockArgs.push(IrBlockArg.create(arg, argType: StdType.i64))
		args.push(arg)
	end 'eachCarried'

	return args
end 'appendCarriedBlockArgs'

// A fresh block that joins cursors carrying values shaped like `template`.
export function emitCascadeJoin(module StdModule, func IrFunction, label ByteArray, template ValueIdArray, ids ValueMinter) returns CascadeCursor
	var block = module.addBlock(func, label: label, heat: BlockHeat.normal)
	let carried = appendCarriedBlockArgs(block, template: template, ids: ids)
	return CascadeCursor.create(block, carried: carried)
end 'emitCascadeJoin'

// Terminate `from` with a branch to `to`, handing it `from`'s carried values.
export function emitCascadeBranch(module StdModule, from CascadeCursor, to CascadeCursor)
	module.setTerminator(from.block, op: StdOp.branch(to.block.id))
	pushCascadeEdge(from.block, to: to, values: from.carried)
end 'emitCascadeBranch'

// The block arguments `block`'s terminator hands `to` along that edge. A join carrying nothing takes no edge.
export function pushCascadeEdge(block IrBlock, to CascadeCursor, values ValueIdArray)
	if values.count() != to.carried.count() 'arityMismatch'
		panic("pushCascadeEdge: an edge hands {values.count()} values to a join that carries {to.carried.count()}")
	end 'arityMismatch'

	if values.count() == 0 'carriesNothing'
		return
	end 'carriesNothing'

	block.branchEdges.push(BranchEdge.create(to.block.id, argIds: values))
end 'pushCascadeEdge'

// A synthesized walk entry under construction: its function, its minter, the cursor its body starts at and the
// join every stop and the fall-through reach, which returns the visit table over a graph and nothing over one
// record.
export type WalkBody
	export let func as IrFunction
	export let ids as ValueMinter
	export let entry as CascadeCursor
	export let done as CascadeCursor
	export let scope as WalkScope
	let walksElements as bool

	static function create(func IrFunction, ids ValueMinter, entry CascadeCursor, done CascadeCursor, scope WalkScope, walksElements bool) returns WalkBody
		return Self{func: func, ids: ids, entry: entry, done: done, scope: scope, walksElements: walksElements}
	end 'create'

	// The per-element walk a container's entry is handed. An entry opened without one mints its own value at that id.
	export function elementWalk() returns ValueId
		if not self.walksElements 'noElementWalkParameter'
			panic("WalkBody.elementWalk: `{String.from(self.func.name)}` was opened without an element walk parameter")
		end 'noElementWalkParameter'

		return WalkElementWalkParam
	end 'elementWalk'
end 'WalkBody'

// Open a walk entry. `recursesPerLevel` is a per-type cascade's stack guard (`IrFunction.needsGreenThreadStackGuard`):
// its depth is the program's data graph, not the runtime's.
export function beginWalkBody(module StdModule, name ByteArray, scope WalkScope, walksElements bool, recursesPerLevel bool) returns WalkBody
	let paramCount = walkEntryParamCount(scope, walksElements: walksElements)
	var paramTypes = StdTypeArray.create()

	for _ in 0 upto paramCount 'eachParam'
		paramTypes.push(StdType.i64)
	end 'eachParam'

	var func = IrFunction.createFromStd(name, returnType: walkReturnType(scope), paramCount: paramCount, paramTypes: paramTypes, returnLine: 0, needsGreenThreadStackGuard: recursesPerLevel)
	var ids = ValueMinter.create(paramCount)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: paramCount)

	let start = CascadeCursor.create(entry, carried: walkCarriedValues(scope))
	let done = emitCascadeJoin(module, func: func, label: b"done", template: start.carried, ids: ids)
	return WalkBody.create(func, ids: ids, entry: start, done: done, scope: scope, walksElements: walksElements)
end 'beginWalkBody'

function walkReturnType(scope WalkScope) returns StdReturnType
	return match scope 'scope'
		graph gives StdReturnType.value(StdType.i64)
		record gives StdReturnType.void
	end 'scope'
end 'walkReturnType'

function walkCarriedValues(scope WalkScope) returns ValueIdArray
	return match scope 'scope'
		graph gives argsOf(WalkVisitsParam)
		record gives ValueIdArray.create()
	end 'scope'
end 'walkCarriedValues'

export function finishWalkBody(module StdModule, body WalkBody)
	match body.scope 'scope'
		graph then module.setTerminator(body.done.block, op: StdOp.ret(body.done.visits()))
		record then module.setTerminator(body.done.block, op: StdOp.retVoid)
	end 'scope'

	module.functions.push(body.func)
end 'finishWalkBody'

// ⭐⭐ **ONE MEETING OF A WALK WITH A RECORD — the ONE home of what either walk does at a header, spliced into
// every walk body.** Answers the cursor to continue in when the walk must go on below `box`, and branches to
// `stop` when nothing below it can need the walk:
//
//   • IMMORTAL — image data, and everything it reaches is image data too.
//   • SHARED — marking is CLOSED: the whole cone below a mark is marked and frozen, so a moved unit may
//     reference it and a second lend finds nothing left to mark. A share walk over a graph also counts the
//     meeting, since the mark may be its own (`__mm_walk_revisit`).
//   • COUNTED and sole — descends; the share walk first adds `MmSharedRefcountMark` with a PLAIN store, which is
//     sound because a counted record belongs to this green thread alone. One owner is met once, so no table is
//     touched.
//   • COUNTED with more owners — over a graph, the meeting is counted against its owners (`WalkVisitTable`):
//     descended at the first meeting, stopped at every later one, and `__mm_walk_settle` aborts once the walk
//     has returned on the owners it never met. Over one record the other owners are outside the graph, so an
//     `owner` meeting aborts on the spot and a `view` meeting marks.
export function emitBoxWalkStep(module StdModule, func IrFunction, cursor CascadeCursor, box ValueId, action CascadeAction, meeting WalkMeeting, stop CascadeCursor, ids ValueMinter) returns CascadeCursor
	var counted = module.addBlock(func, label: b"walkcounted", heat: BlockHeat.normal)
	var immortal = module.addBlock(func, label: b"walkimmortal", heat: BlockHeat.normal)
	var shared = module.addBlock(func, label: b"walkshared", heat: BlockHeat.normal)
	var sole = module.addBlock(func, label: b"walksole", heat: BlockHeat.normal)
	var several = module.addBlock(func, label: b"walkowned", heat: BlockHeat.normal)
	let descend = emitCascadeJoin(module, func: func, label: b"walkdescend", template: cursor.carried, ids: ids)

	let count = emitLoadRefcount(module, block: cursor.block, ptr: box, ids: ids)
	emitRouteOnRefcountWord(module, func: func, block: cursor.block, word: count.word, counted: counted, immortal: immortal, shared: shared, ids: ids)

	emitCascadeBranch(module, from: cursor.at(immortal), to: stop)

	let soleWord = emitConst(module, block: counted, value: SoleOwnerRefcount, ids: ids)
	let isSole = emitCmp(module, block: counted, a: count.word, b: soleWord, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(counted, op: StdOp.condBranch(isSole, thenBlockId: sole.id, elseBlockId: several.id))

	emitMarkedDescent(module, from: cursor.at(sole), count: count, action: action, descend: descend, ids: ids)

	match walkScopeOf(cursor) 'scope'
		graph then emitCountedMeetings(module, func: func, shared: cursor.at(shared), several: cursor.at(several), box: box, count: count, action: action, meeting: meeting, descend: descend, stop: stop, ids: ids)
		record then emitLoneMeetings(module, func: func, shared: cursor.at(shared), several: cursor.at(several), count: count, action: action, meeting: meeting, descend: descend, stop: stop, ids: ids)
	end 'scope'

	return descend
end 'emitBoxWalkStep'

// Mark a record a lend reaches first, then go on below it.
function emitMarkedDescent(module StdModule, from CascadeCursor, count RefcountWord, action CascadeAction, descend CascadeCursor, ids ValueMinter)
	emitMarkWhenLending(module, block: from.block, count: count, action: action, ids: ids)
	emitCascadeBranch(module, from: from, to: descend)
end 'emitMarkedDescent'

// A counted record of several owners and a shared record, over a graph.
function emitCountedMeetings(module StdModule, func IrFunction, shared CascadeCursor, several CascadeCursor, box ValueId, count RefcountWord, action CascadeAction, meeting WalkMeeting, descend CascadeCursor, stop CascadeCursor, ids ValueMinter)
	var firstMeeting = module.addBlock(func, label: b"walkfirst", heat: BlockHeat.normal)

	match action 'action'
		clone then panic("emitCountedMeetings: a clone copies every box it reaches and never meets one")
		soleWalk then emitSoleWalkMeetings(module, shared: shared, several: several, box: box, meeting: meeting, firstMeeting: firstMeeting, stop: stop, ids: ids)
		shareWalk then emitShareWalkMeetings(module, shared: shared, several: several, box: box, meeting: meeting, firstMeeting: firstMeeting, stop: stop, ids: ids)
	end 'action'

	let noted = emitWalkNote(module, block: firstMeeting, visits: several.visits(), record: box, ownersBesidesThis: count.word, meeting: meeting, ids: ids)
	emitMarkedDescent(module, from: CascadeCursor.create(firstMeeting, carried: argsOf(noted)), count: count, action: action, descend: descend, ids: ids)
end 'emitCountedMeetings'

// A move's walk never marks, so a shared record is one it did not reach first and it simply stops there; a
// counted record of several owners is descended only if no earlier meeting did.
function emitSoleWalkMeetings(module StdModule, shared CascadeCursor, several CascadeCursor, box ValueId, meeting WalkMeeting, firstMeeting IrBlock, stop CascadeCursor, ids ValueMinter)
	emitCascadeBranch(module, from: shared, to: stop)

	let met = emitWalkRevisit(module, block: several.block, visits: several.visits(), record: box, meeting: meeting, ids: ids)
	let notMet = emitConst(module, block: several.block, value: WalkNotMetBefore, ids: ids)
	let metBefore = emitCmp(module, block: several.block, a: met, b: notMet, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(several.block, op: StdOp.condBranch(metBefore, thenBlockId: stop.block.id, elseBlockId: firstMeeting.id))
	pushCascadeEdge(several.block, to: stop, values: several.carried)
end 'emitSoleWalkMeetings'

// A lend marks at the first meeting, so a counted record is always met for the first time, and a later meeting
// arrives as a shared record — counted if this walk marked it, left alone if an earlier lend did.
function emitShareWalkMeetings(module StdModule, shared CascadeCursor, several CascadeCursor, box ValueId, meeting WalkMeeting, firstMeeting IrBlock, stop CascadeCursor, ids ValueMinter)
	_ = emitWalkRevisit(module, block: shared.block, visits: shared.visits(), record: box, meeting: meeting, ids: ids)
	emitCascadeBranch(module, from: shared, to: stop)
	module.setTerminator(several.block, op: StdOp.branch(firstMeeting.id))
end 'emitShareWalkMeetings'

// A counted record of several owners and a shared record, over one record. A shared record is closed; the other
// owners of a counted one are outside the graph, which an owner meeting may not leave behind. A view meeting marks
// what a lend lends and leaves a move's detach to release its reference.
function emitLoneMeetings(module StdModule, func IrFunction, shared CascadeCursor, several CascadeCursor, count RefcountWord, action CascadeAction, meeting WalkMeeting, descend CascadeCursor, stop CascadeCursor, ids ValueMinter)
	emitCascadeBranch(module, from: shared, to: stop)

	match meeting 'meeting'
		owner then emitRuntimeAbort(module, func: func, block: several.block, abort: RuntimeAbort.transferredRecordNotSole, ids: ids)
		view then emitMarkedDescent(module, from: several, count: count, action: action, descend: descend, ids: ids)
	end 'meeting'
end 'emitLoneMeetings'

function emitMarkWhenLending(module StdModule, block IrBlock, count RefcountWord, action CascadeAction, ids ValueMinter)
	match action 'action'
		clone then panic("emitMarkWhenLending: a clone marks nothing")
		soleWalk then break 'action'
		shareWalk then emitAddSharedMark(module, block: block, count: count, ids: ids)
	end 'action'
end 'emitMarkWhenLending'

// ⭐ **`__mm_share_buffer(buffer)` — MARK THE ALLOCATION A LENT RECORD'S BYTES LIVE IN SHARED, WHATEVER ITS
// COUNT.** An owner's separate buffer, or a view's parent when the view is the whole lent graph: views step that
// count from any green thread once the record is lent. Other holders are not refused: each is a view, which
// copies before it writes, or an owner, which writes only after it copies the bytes out — so the bytes are
// read-only for all of them. An allocation already marked is left alone. A view's parent inside a larger graph
// is a meeting instead (`WalkMeeting.view`), because the parent may be a record the graph also owns.
export let MmShareBufferName = b"__mm_share_buffer"

function buildMmShareBuffer(module StdModule)
	var func = IrFunction.createFromStd(MmShareBufferName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var counted = module.addBlock(func, label: b"counted", heat: BlockHeat.normal)
	var done = module.addBlock(func, label: b"done", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let buffer = 0 as ValueId

	let count = emitLoadRefcount(module, block: entry, ptr: buffer, ids: ids)
	let isCounted = emitIsCountedWord(module, block: entry, word: count.word, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(isCounted, thenBlockId: counted.id, elseBlockId: done.id))

	emitAddSharedMark(module, block: counted, count: count, ids: ids)
	module.setTerminator(counted, op: StdOp.branch(done.id))
	module.setTerminator(done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmShareBuffer'

// `word < MmSharedRefcountMark` — does this refcount word belong to a COUNTED box? Signed, so a last owner's
// transient `-1` reads as counted too.
function emitIsCountedWord(module StdModule, block IrBlock, word ValueId, ids ValueMinter) returns ValueId
	let mark = emitConst(module, block: block, value: MmSharedRefcountMark, ids: ids)
	return emitCmp(module, block: block, a: word, b: mark, pred: StdCmpPred.lt, ids: ids)
end 'emitIsCountedWord'

// Mark a counted box shared: `word + MmSharedRefcountMark`, stored PLAIN. The caller has established that the
// box is counted, so nothing but this green thread can be stepping its count.
function emitAddSharedMark(module StdModule, block IrBlock, count RefcountWord, ids ValueMinter)
	let mark = emitConst(module, block: block, value: MmSharedRefcountMark, ids: ids)
	let marked = emitBin(module, block: block, a: count.word, b: mark, opcode: StdBinOpcode.add, ids: ids)
	emitStoreField(module, block: block, record: count.header, offset: HeaderRefcountOffset, value: marked)
end 'emitAddSharedMark'

// A box's header base and its refcount word as loaded there — what every door that routes on, steps or marks a
// count reads first. A record rather than two out-parameters, so a caller cannot store one box's word through
// another box's header.
type RefcountWord
	export let header as ValueId
	export let word as ValueId

	static function create(header ValueId, word ValueId) returns RefcountWord
		return Self{header: header, word: word}
	end 'create'
end 'RefcountWord'

// The refcount word of the box `ptr` addresses — `[ptr - HeaderBytes + HeaderRefcountOffset]`, through
// `emitHeaderBase`, so nothing outside this file has to know a header exists.
function emitLoadRefcount(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns RefcountWord
	let header = emitHeaderBase(module, block: block, ptr: ptr, ids: ids)
	return RefcountWord.create(header, word: emitLoadField(module, block: block, record: header, offset: HeaderRefcountOffset, ids: ids))
end 'emitLoadRefcount'

// What one owner's arrival or departure left behind: the block execution continues in, and the count as it
// stood BEFORE the step in the `owners - 1` convention, whichever kind of count the box keeps. A record
// rather than two out-parameters, so a caller cannot pair one step's block with another's count.
type OwnerCountStep
	export let block as IrBlock
	export let prior as ValueId

	static function create(block IrBlock, prior ValueId) returns OwnerCountStep
		return Self{block: block, prior: prior}
	end 'create'
end 'OwnerCountStep'

// ⭐⭐ **`owners += delta` ALONG WHICHEVER COUNT THE BOX KEEPS — the one way a refcount is stepped.** An image
// record leaves for `immortal` untouched; a counted box steps PLAIN and a shared one ATOMICALLY; both arms meet
// in the returned block answering the prior count with the mark taken off, so every caller decides "last
// owner" and reports the trace from one value and never learns which arm ran.
//
// ⭐ **IT ANSWERS THE PRIOR COUNT BECAUSE A DECREMENT CAN ONLY BE JUDGED BY WHAT IT DISPLACED.** The step has
// already stored the new count — and on the shared arm another green thread may have stepped it again since —
// so a re-read would ask "was I the last owner?" of the wrong number.
function emitStepOwnerCount(module StdModule, func IrFunction, entry IrBlock, ptr ValueId, delta ParsedInt, immortal IrBlock, ids ValueMinter) returns OwnerCountStep
	var counted = module.addBlock(func, label: b"counted", heat: BlockHeat.normal)
	var shared = module.addBlock(func, label: b"sharedcount", heat: BlockHeat.normal)
	var stepped = module.addBlock(func, label: b"stepped", heat: BlockHeat.normal)

	let count = emitLoadRefcount(module, block: entry, ptr: ptr, ids: ids)
	emitRouteOnRefcountWord(module, func: func, block: entry, word: count.word, counted: counted, immortal: immortal, shared: shared, ids: ids)

	let countedPrior = emitAdjustRefcount(module, block: counted, header: count.header, delta: delta, sharedCount: false, ids: ids)
	module.setTerminator(counted, op: StdOp.branch(stepped.id))
	counted.branchEdges.push(BranchEdge.create(stepped.id, argIds: argsOf(countedPrior)))

	let markedPrior = emitAdjustRefcount(module, block: shared, header: count.header, delta: delta, sharedCount: true, ids: ids)
	let mark = emitConst(module, block: shared, value: MmSharedRefcountMark, ids: ids)
	let sharedPrior = emitBin(module, block: shared, a: markedPrior, b: mark, opcode: StdBinOpcode.sub, ids: ids)
	module.setTerminator(shared, op: StdOp.branch(stepped.id))
	shared.branchEdges.push(BranchEdge.create(stepped.id, argIds: argsOf(sharedPrior)))

	let prior = ids.mint()
	stepped.blockArgs.push(IrBlockArg.create(prior, argType: StdType.i64))

	return OwnerCountStep.create(stepped, prior: prior)
end 'emitStepOwnerCount'

// ⭐⭐⭐ **`refcount += delta` ON THE HEADER AT `header`, ANSWERING THE WORD AS IT STOOD BEFORE — the one
// read-modify-write of a refcount.** Plain for a COUNTED box, atomic for a SHARED one, and the difference is
// the language's guarantee rather than a thread count:
//
// ⇒ **A COUNTED box has ONE owning green thread**, whose strand runs on one M at a time and changes machine
// only through `__sched_lock` — whose release and acquire order everything one machine did before everything
// the next does — so its read-modify-write has no concurrent second party at any `MAXON_MAX_PROCS`.
// `SchedRuntime.maxon`'s header states the invariant in full: an `async` frame is a COROUTINE of the green
// thread that called it, a member of its owner's strand. The two OS threads that are not an owner's M — the
// syscall monitor and an idle worker — never dereference a box.
//
// ⇒ **A SHARED box was lent**: a message took a reference to it while the sender kept its own, so two green
// threads — possibly on two Ms — step one count, and only an atomic step keeps it exact. A lost increment
// frees a record under a live holder (139) and a lost decrement leaks it (101);
// `specs/services.md`'s count torture is sixteen processors stepping one lent graph.
//
// ⚠ `scripts/multicore-stress/refcount-torture.maxon` (driven by `multicore-stress/refcount-race.sh`) is the
// committed control for the plain arm: N increfs and N decrefs of one word per round, which crashes the day a
// counted box gains a second green thread. THE EXIT CODE IS THE DISCRIMINATOR — 101 is the leak gate and 139
// a segfault; neither the program's answer nor `mmRawAllocLive()` moves.
//
// ⛔ **THE CALLER MUST HAVE ROUTED AWAY FROM AN IMMORTAL BOX FIRST.** The store is what makes an image
// record's header fatal: it lives in `.rdata`, so this is a write into a read-only page — a fault on x64 and a
// SILENT corruption on wasm, which has no read-only section. `emitStepOwnerCount` is the one caller.
function emitAdjustRefcount(module StdModule, block IrBlock, header ValueId, delta ParsedInt, sharedCount bool, ids ValueMinter) returns ValueId
	let step = emitConst(module, block: block, value: delta, ids: ids)
	return emitFieldAccumulate(module, block: block, record: header, offset: HeaderRefcountOffset, delta: step, multiM: sharedCount, ids: ids)
end 'emitAdjustRefcount'

// ⭐ **DOES ANYONE BESIDES THIS OWNER HOLD `ptr`?** — ⭐ **THE ONE HOME OF THE `owners - 1` CONVENTION.**
// A box is born at refcount 0 meaning ONE owner (see `emitRefcountCheckToLastOwner` for why), so "shared"
// is `rc != 0` and "sole owner" is its negation. Both readers of that convention derive from HERE:
// `emitRefcountCheckToLastOwner` branches on it, and `ManagedMemoryRuntime.__managed_cow_detach` asks it of an array's
// element BUFFER to decide whether a view is reading the bytes it is about to write.
//
// ⚠ Those two live in different files, which is exactly why this is a function and not a comment: were the
// convention ever to change to a plain owner count, a `rc != 0` open-coded in the managed-memory runtime would go on
// compiling and start answering the opposite question — a shared buffer mutated in place, which is a wrong
// answer and a corruption, not an error anything reports.
//
// ⚠ The caller must already know `ptr` is a pointer `__mm_alloc` RETURNED. An INTERIOR pointer (a view's
// `buffer@0`) has no header, and the word this reads would be the previous element's data.
export function emitIsSharedAllocation(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let rc = emitLoadRefcount(module, block: block, ptr: ptr, ids: ids).word
	let soleOwner = ids.mint()
	module.appendOp(block, op: StdOp.const(soleOwner, value: SoleOwnerRefcount, valueType: StdType.i64))
	let shared = ids.mint()
	module.appendOp(block, op: StdOp.cmp(shared, lhs: rc, rhs: soleOwner, pred: StdCmpPred.ne, operandType: StdType.i64))
	return shared
end 'emitIsSharedAllocation'

// The refcount word of a box with ONE owner — the `owners - 1` convention, stated once.
let SoleOwnerRefcount = 0 as ParsedInt

// The box whose refcount word `loadResultId` reads — `emitLoadRefcount`'s shape read back:
// `[ (ptr - HeaderBytes) + HeaderRefcountOffset ]`, the subtraction an immediate once
// `foldConstOperands` has run. The one way a reader outside this file learns which load is a
// refcount without learning the geometry, which stays private beside the emitter.
export function refcountLoadBox(reader StdShapeReader, loadResultId ValueId) returns ValueId throws StdShapeMismatch
	let header = try reader.fieldLoadBase(loadResultId, offset: HeaderRefcountOffset)

	if not reader.arithDefining(header) or not reader.arith.isBinaryArithImm() 'notAnImmediateSubtraction'
		throw StdShapeMismatch.notTheShape
	end 'notAnImmediateSubtraction'

	if reader.arith.opcode != StdBinOpcode.sub or reader.arith.imm != HeaderBytes 'notTheHeaderBase'
		throw StdShapeMismatch.notTheShape
	end 'notTheHeaderBase'

	return reader.arith.lhs
end 'refcountLoadBox'

// The box an `emitIsSharedAllocation` compare asks about, read back off the compare: `cmpImm ne
// <its refcount word>, SoleOwnerRefcount`.
export function sharedAllocationGuardBox(reader StdShapeReader, condId ValueId) returns ValueId throws StdShapeMismatch
	if not reader.compareImmDefining(condId, pred: StdCmpPred.ne, imm: SoleOwnerRefcount) 'notTheCompare'
		throw StdShapeMismatch.notTheShape
	end 'notTheCompare'

	return try refcountLoadBox(reader, loadResultId: reader.arith.lhs)
end 'sharedAllocationGuardBox'

// **THE RELEASE EVERY DECREF SHARES.** One owner leaves (`emitStepOwnerCount`); when the count it displaced
// says nobody else held the box this was the FINAL owner and control branches to `lastOwner` — the caller's
// block, which reclaims whatever it must before the memory dies — otherwise the box is kept. It fills `entry`
// and `lower` and wires them to the caller-supplied `lastOwner`; the caller creates all three blocks so their
// order — and thus its own last-owner blocks — is its to choose.
//
// ⭐ ONE HOME FOR THE RELEASE PROTOCOL, so `__mm_decref`, `StringRuntime.__str_decref`, every
// `__destruct_<T>` cascade and every other release door cannot drift on what "the last owner" means.
// `__str_decref` needs that SAME answer but must read a detached String's `parent`/`buffer` out of the record
// BEFORE the record is reclaimed, so it cannot call `__mm_decref` at runtime — it shares this BUILDER instead.
//
// ⭐ THE REFCOUNT IS `owners - 1`, NOT `owners`, AND THAT IS WHY `__mm_alloc` WRITES NOTHING. A box is born at
// refcount 0 meaning ONE owner, so the overwhelmingly common case — allocate, use, drop — touches the
// refcount word exactly once, on the way out. The cost is that "is this the last owner?" reads `prior == 0`
// rather than `prior == 1`, which looks like an off-by-one every time it is read and is not one.
//
// ⭐⭐ **IT DECREMENTS FIRST AND DECIDES FROM WHAT THE DECREMENT DISPLACED.** Reading the count, branching on it
// and only then lowering it is a check-then-act: two green threads each holding one of a shared box's two
// references would both observe two owners, both decrement, and the box would never be freed. A counted box
// has no second party, and the order still stands there for a nearer reason: the step has already stored the
// new count, so a re-read would ask the question of the wrong number.
//
// ⚠ There is no underflow check. A decref below zero means the compiler emitted more drops than owners, which
// is an OWNERSHIP bug, not a runtime condition; the signal comes for free from the leak counter going
// negative, which the exit check reads as nonzero.
//
// ⚠ **THE LAST OWNER LEAVES `-1` (or `mark - 1`) IN THE WORD, AND THAT IS SOUND BECAUSE NOTHING READS IT
// AGAIN.** The box is dead the instant that arm is taken: `__mm_free` reads the destructor and the SIZE out of
// the header, never the count, and the slot is poisoned and handed back to the slab before any other party
// can address it.
//
// ⚠ **THE `mm_decref` EVENT IS EMITTED ONCE, BEFORE THE BRANCH.** See `emitMmDecrefEvent` for the identity
// that makes one emission correct for both paths; it also leaves the caller's `lastOwner` block untouched by
// this function, which every caller relies on — they append their own reclaim ops into it.
//
// ⭐⭐ **THE IMMORTALITY TEST IS HERE, AHEAD OF THE READ-MODIFY-WRITE, AND THAT PLACEMENT IS WHAT MAKES IT COVER
// EVERY RELEASE PATH AT ONE COST.** An image record's box lives in `.rdata`, so the step's STORE is a write
// into a read-only page; this function is the one place every release passes through — `__mm_decref`,
// `__str_decref`, `__managed_decref`, `__managed_cursor_decref`, both list drops, the file/dir/socket box
// drops, every `__destruct_<T>` field cascade and every union destructor. It asks the HEADER question rather
// than `emitRecordIsImmortal`'s `capacity@16` one, because the records reaching here are of every shape.
//
// ⛔ **IT DOES NOT BELONG INSIDE `__mm_free`.** A synthetic header makes an image record look WELL-FORMED
// there: `__mm_free` would compute an allocation base and hand the slab an address it never handed out. The
// release door is where the box is still deciding whether to die, so that is where it must be turned back.
//
// ⚠ `func` is needed because the route and the event SPLIT `entry` into new blocks.
export function emitRefcountCheckToLastOwner(module StdModule, func IrFunction, entry IrBlock, lower IrBlock, record ValueId, lastOwner IrBlock, ids ValueMinter)
	var step = emitStepOwnerCount(module, func: func, entry: entry, ptr: record, delta: OneFewer, immortal: lower, ids: ids)
	var cur = emitMmDecrefEvent(module, func: func, block: step.block, ptr: record, priorCount: step.prior, ids: ids)

	let noOwnerLeft = emitConst(module, block: cur, value: SoleOwnerRefcount, ids: ids)
	let wasShared = emitCmp(module, block: cur, a: step.prior, b: noOwnerLeft, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(wasShared, thenBlockId: lower.id, elseBlockId: lastOwner.id))

	// ⚠ **`lower` HOLDS NO OPS AND IS THE EXIT FOR BOTH SURVIVING ARMS** — a box another owner still holds, and
	// an image record that has no count to lower. Neither has anything to do but return, and giving the
	// immortal arm a block of its own would be a second `retVoid` under a different name.
	module.setTerminator(lower, op: StdOp.retVoid)
end 'emitRefcountCheckToLastOwner'

// `__mm_is_null(ptr) -> 1 when the pointer is NULL, 0 otherwise` — the floor of
// `__Builtins.managedIsNull(mm)`.
//
// It is a POINTER test and nothing more: it dereferences nothing, so it is safe on exactly the value every
// other `__mm_*` entry would fault on. That is the whole of what it is for — a producer that can answer "no
// record" hands its caller something no drop may touch, and this is how the caller finds out.
function buildMmIsNull(module StdModule)
	var func = IrFunction.createFromStd(MmIsNullName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let isNull = emitCmp(module, block: entry, a: ptr, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.ret(isNull))

	module.functions.push(func)
end 'buildMmIsNull'

// `__mm_decref(ptr)` — one fewer owner; free at the last. The refcount read-modify-write is the
// shared `emitRefcountCheckToLastOwner`; this function supplies only the LAST-OWNER path — reclaim
// the box.
function buildMmDecref(module StdModule)
	var func = IrFunction.createFromStd(MmDecrefName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var release = module.addBlock(func, label: b"release", heat: BlockHeat.normal)
	var lower = module.addBlock(func, label: b"lower", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let ptr = 0 as ValueId

	emitRefcountCheckToLastOwner(module, func: func, entry: entry, lower: lower, record: ptr, lastOwner: release, ids: ids)

	let freed = ids.mint()
	module.appendOp(release, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(ptr)))
	module.setTerminator(release, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmDecref'

// The byte written over every freed payload. `0x3F` is chosen for what it does when a
// use-after-free READS the dead memory it should not have: as a small integer it is a
// conspicuous 63 (never the 0 a correct freshly-zeroed slot would hold), and as a POINTER a word
// of it is `0x3F3F3F3F3F3F3F3F` — a non-canonical x64 address, so dereferencing it FAULTS rather
// than silently reads. Either way the bug becomes loud at the read instead of invisible.
let PoisonByte = 0x3F

// ⭐⭐ **THE SLAB SLOT'S BASE FOR A BOX WHOSE PAYLOAD POINTER IS `ptr` — given the header base the caller
// already holds.** `__mm_alloc` asked the slab for the WHOLE box, so what `__slab_free` must be handed is
// what `__slab_alloc` answered: the header base in an ordinary build, and one word BELOW it where a
// `--debugstream` build's packed id sits (`DebugStreamPackedIdBytes`).
//
// ⚠ **IT TAKES THE HEADER BASE RATHER THAN THE PAYLOAD POINTER SO AN UNTRACED BUILD MINTS NOTHING.** The
// one caller has already computed `ptr - HeaderBytes` for the size load, and with no prefix word the two
// addresses are the same value — recomputing it from `ptr` would put a second `sub` on the free path of
// every heap operation in the language, for a distance of zero.
function emitBoxAllocationBase(module StdModule, block IrBlock, headerBase ValueId, ids ValueMinter) returns ValueId
	if not module.debugStream 'noPrefixWord'
		return headerBase
	end 'noPrefixWord'

	let prefix = emitConst(module, block: block, value: DebugStreamPackedIdBytes, ids: ids)
	return emitBin(module, block: block, a: headerBase, b: prefix, opcode: StdBinOpcode.sub, ids: ids)
end 'emitBoxAllocationBase'

// `__mm_free(ptr)` — the death of a box. Three things happen, in this order: the trace event, the live
// count drops (the one number the leak gate reads), the payload is POISONED, and the box goes back to the
// slab — which is where its bytes become somebody else's.
//
// ⭐ **POISON-ON-FREE, ALWAYS ON (Workstream R / #108).** A use-after-free that reads bytes nothing has
// overwritten returns exactly the value it wrote before the free, and is INVISIBLE to every test.
// Overwriting the payload with `PoisonByte` the instant it dies turns that whole class loud: a
// read-after-free returns 63 or faults on a poisoned pointer instead of stale-but-correct bytes. This is
// deliberately not a flag — it is unconditional, so the class cannot hide in a build nobody thought to
// enable it for, and so the committed suite is a standing gate against it. **The size is in the header**
// (`__mm_alloc` stored the CALLER's size at `HeaderSizeOffset`), so the poisoned range is exactly
// `[ptr, ptr + size)` — the payload the program could actually write, not the header (whose first word
// `__slab_free` is about to overwrite with a free-list link anyway) and not the slack past the request
// (which the slot's re-zero covers and no caller ever saw).
//
// ⭐⭐ **AND THEN IT GOES TO `__slab_free`, WHICH IS WHAT MAKES THE POISON PAIR WITH SOMETHING.** The
// two are the halves of one contract and they live one layer apart on purpose: the poison is a
// MANAGED-BOX discipline (it wants the caller's size, and it is meaningless for a green-thread stack), the
// re-zero is an ALLOCATOR obligation (`__slab_alloc`'s recycled arm memFills the whole slot, which is
// what lets `__mm_alloc` still decline to write the refcount). Neither can be folded into the other, and
// the invariant they hold between them is the one this file's alloc side leans on: **every box a caller
// sees is zero.**
//
// ⚠⚠ **A RECYCLE THEREFORE COSTS TWO PASSES OVER THE SAME BYTES — poison here, zero on the way out —
// and that is a STATED OPEN COST rather than something this rung argued away.** It is not paid on a VIRGIN
// slot, which is exactly the point of the slab's bump region: those bytes are OS-fresh, so the alloc side
// skips the fill and nothing ever poisoned them. It is paid in full on every reuse. The two halves cannot
// be collapsed into one pass without giving up either the poison (which is a debugging guarantee) or the
// per-slot zero (which is a correctness guarantee), so what is left is to know the price and not to
// pretend otherwise.
//
// ⚠ **THE OS-DIRECT ARM PAYS THE POISON FOR NOTHING**, since the mapping is about to be handed back to
// the OS whole. Skipping it would mean branching on the box's size on the path of every free in the
// language to save work on the rarest one; a box past `SlabMaxSmallSize` is at least 32 KiB, so the fill is
// also a rounding error against the `VirtualFree`/`munmap` that follows it.
//
// ⛔⛔ **THE IMMORTALITY TEST IS NOT HERE AND MUST NEVER BE MOVED HERE.** A synthetic header makes an image
// record look WELL-FORMED to this function: it would read a `size@8`, poison that range and hand
// `__slab_free` an `.rdata` address the allocator never returned — a failure that looks plausible rather
// than obvious. By the time control reaches a free the box has already been judged dead, so the judgement
// is what has to be right; the test therefore sits at the top of the release door
// (`emitRefcountCheckToLastOwner`), where a record is still deciding whether to die.
//
// ⭐ THE DESTRUCTOR CASCADE ALSO LANDS HERE AT P1.2 (still deferred): the header carries the destructor
// (`__mm_alloc` stored it at `HeaderDestructorOffset`); loading it and calling it through `callIndirect`
// before the poison is the local change. It is NOT written now — every struct at this rung is trivially
// owned, so the pointer is always 0 and the call would be emitted-but-never-taken, the `mintPhi` failure
// exactly.
function buildMmFree(module StdModule, model MachineModel)
	var func = IrFunction.createFromStd(MmFreeName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var start = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: start, count: 1)
	let ptr = 0 as ValueId

	// The `mm_free` event BEFORE the poison and before the reclaim, so the trace reports the death of the
	// box while its header is still the one that identifies it — and so a recycled address reads
	// `free(id=n)` ahead of the `alloc(id=m)` that takes it over, which is what keeps a traced build's
	// events unambiguous now that a traced build recycles.
	var entry = emitMmFreeEvent(module, func: func, block: start, ptr: ptr, ids: ids)

	// ⚠ **A FREE STEPS THE FREES COLUMN AND NOTHING ELSE.** The leak gate's live count is total less frees,
	// and every column only rises, so each deltas exactly across a bracket. A free path that walked the
	// total back would report a phase that allocated and released a million boxes as having done nothing.
	entry = emitTrackedTrafficStep(module, func: func, cur: entry, model: model, event: SlabTrafficEvent.free, ids: ids)

	// The payload size the alloc recorded in the header; the range to poison is exactly `[ptr, ptr + size)`.
	// The fill itself is the shared `StdOp.memFill` (the slab's recycled-slot zeroer and the array
	// capacity-slot eraser are its other callers) — a `size == 0` empty allocation poisons nothing.
	let header = emitHeaderBase(module, block: entry, ptr: ptr, ids: ids)
	let size = ids.mint()
	module.appendOp(entry, op: StdOp.loadIndirect(size, addrId: header, offset: HeaderSizeOffset, valueType: StdType.i64))
	module.appendOp(entry, op: StdOp.memFill(ptr, byteCountId: size, value: PoisonByte))

	// ⭐ **AND BACK TO THE SLAB, UNCONDITIONALLY.** There is one exit and no guard: `__slab_free` routes on
	// its own reverse map — a hit names the owning span and pushes the slot onto its free list, a MISS is
	// the OS-direct sentinel and the mapping goes back whole. The box layer knows neither which span nor
	// which tier, and asking would be a second copy of a routing decision the allocator already owns.
	//
	// ⚠ **THE POINTER IS THE SLAB SLOT'S BASE, NOT THE PAYLOAD.** It is exactly what `__slab_alloc`
	// answered, which is what `__slab_free` requires (it threads the free list through the SLOT's first
	// word, so an interior pointer would corrupt the slot it landed in and then be handed out as a base).
	let slot = emitBoxAllocationBase(module, block: entry, headerBase: header, ids: ids)
	emitSlabFree(module, block: entry, ptr: slot, ids: ids)
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMmFree'

// ⭐⭐ **ONE TRACKED EVENT ON THE CALLING THREAD'S ROW — the box doors' half of the traffic columns.** The
// shard walk is `SlabRuntime.emitSlabResolveShard`, the same walk the slab doors take; its two arms are two
// emissions of one credit, plain on a sole-writer row and atomic on the shared raw row. The calling green
// thread's own columns are NOT stepped here — the slab door under this one already did, once per request.
// Terminates `cur` and answers the block to continue in.
function emitTrackedTrafficStep(module StdModule, func IrFunction, cur IrBlock, model MachineModel, event SlabTrafficEvent, ids ValueMinter) returns IrBlock
	let done = module.addBlock(func, label: b"counted", heat: BlockHeat.normal)

	let state = emitSlabStateCommitted(module, block: cur, ids: ids)
	let arms = emitSlabResolveShard(module, func: func, cur: cur, state: state, model: model, need: SlabShardNeed.creditsOnly, traffic: ThreadTraffic.none, ids: ids, label: b"shard")

	emitSlabCreditBothArms(module, arms: arms, layer: SlabTrafficLayer.tracked, event: event, next: done, ids: ids)

	return done
end 'emitTrackedTrafficStep'

// ⭐⭐ **THE SIX PER-LAYER READERS, THE THREE PER-THREAD COLUMNS AND THE THREE PROCESS-WIDE TOTALS.** They
// are FUNCTIONS rather than an inline walk at the call site because that is the door every argumentless
// intrinsic in this compiler takes (`Parser.emitZeroArgIntrinsic`), and because the row walk stays one
// spelling (`SlabRuntime.emitSlabTrafficRead`).
//
// ⭐⭐ **THE RAW READERS ANSWER raw − tracked.** Every box is also a slab request, so the slab's raw
// columns count boxes too; subtracting the tracked column at READ time keeps the two reported layers
// disjoint while the allocator carries one door per shape. The byte column subtracts the box prefix per box
// as well, because the tracked byte column records the payload the caller asked for and the raw column the
// whole slot request.
//
// ⛔⛔ **EVERY ONE OF THEM IS ONE WALK, AND A LAYER'S SUBTRACTION HAPPENS INSIDE IT.** Each figure is a
// `SlabTrafficFigure` — an expression over a SINGLE row — so a difference reads its two columns together.
// Two walks would sample them thousands of loads apart, and the allocation that lands between them is
// credited to the subtrahend alone.
//
// All twelve are installed in every heap program and `DeadFunctionElimination` drops the ones nothing calls.
function buildMmCounterAccessors(module StdModule, model MachineModel)
	buildFigureReader(module, name: MmCounterAllocTotalName, figure: SlabTrafficFigure.column(SlabTrafficColumn.trackedTotal))
	buildFigureReader(module, name: MmCounterAllocLiveName, figure: SlabTrafficFigure.live(SlabTrafficLayer.tracked))
	buildFigureReader(module, name: MmCounterAllocBytesName, figure: SlabTrafficFigure.column(SlabTrafficColumn.trackedBytes))
	buildFigureReader(module, name: MmCounterRawAllocTotalName, figure: SlabTrafficFigure.disjoint(SlabTrafficColumn.rawTotal, tracked: SlabTrafficColumn.trackedTotal, prefixPerBox: 0))
	buildFigureReader(module, name: MmCounterRawAllocLiveName, figure: SlabTrafficFigure.disjointLive)
	buildFigureReader(module, name: MmCounterRawAllocBytesName, figure: SlabTrafficFigure.disjoint(SlabTrafficColumn.rawBytes, tracked: SlabTrafficColumn.trackedBytes, prefixPerBox: boxPrefixBytes(module.debugStream)))

	buildThreadCounterReader(module, name: MmCounterThreadAllocsName, model: model, count: CombinedCount.allocs)
	buildThreadCounterReader(module, name: MmCounterThreadFreesName, model: model, count: CombinedCount.frees)
	buildThreadCounterReader(module, name: MmCounterThreadAllocBytesName, model: model, count: CombinedCount.bytes)

	buildFigureReader(module, name: MmCounterProcessAllocsName, figure: processWideFigure(CombinedCount.allocs))
	buildFigureReader(module, name: MmCounterProcessFreesName, figure: processWideFigure(CombinedCount.frees))
	buildFigureReader(module, name: MmCounterProcessAllocBytesName, figure: processWideFigure(CombinedCount.bytes))

	buildAllocTallyReader(module, name: MmCounterAllocTotalByTagName, column: DsAllocTallyCountOffset)
	buildAllocTallyReader(module, name: MmCounterAllocBytesByTagName, column: DsAllocTallyBytesOffset)
end 'buildMmCounterAccessors'

// Only a traced build registers the tally's `.data` run, so an untraced one has no label to address and
// answers 0 — the figure an untraced build's own tag index stands for. Both ends of the index are checked
// because it arrives from user code, and they are two compares rather than one because `StdCmpPred` has no
// unsigned predicate to fold the negative side into the high one.
function buildAllocTallyReader(module StdModule, name ByteArray, column ByteOffset)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: AllocTallyReaderArity, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(AllocTallyReaderArity)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: AllocTallyReaderArity)

	if not module.debugStream 'untracedBuild'
		emitConstReturn(module, block: entry, value: 0, ids: ids)
		module.functions.push(func)
		return
	end 'untracedBuild'

	let bucket = valueIdAtParamPosition(AllocTallyBucketParamPosition)
	var aboveTheFloor = module.addBlock(func, label: b"above_floor", heat: BlockHeat.normal)
	var read = module.addBlock(func, label: b"read", heat: BlockHeat.normal)
	var outside = module.addBlock(func, label: b"outside", heat: BlockHeat.normal)

	let floor = emitConst(module, block: entry, value: AllocTallyLowestBucket, ids: ids)
	let notBelow = emitCmp(module, block: entry, a: bucket, b: floor, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(notBelow, thenBlockId: aboveTheFloor.id, elseBlockId: outside.id))

	let ceiling = emitConst(module, block: aboveTheFloor, value: SlabCensusTagBuckets, ids: ids)
	let inTable = emitCmp(module, block: aboveTheFloor, a: bucket, b: ceiling, pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(aboveTheFloor, op: StdOp.condBranch(inTable, thenBlockId: read.id, elseBlockId: outside.id))

	let row = emitAllocTallyRowAddr(module, block: read, bucket: bucket, ids: ids)
	let answer = emitLoadField(module, block: read, record: row, offset: column, ids: ids)
	module.setTerminator(read, op: StdOp.ret(answer))

	emitConstReturn(module, block: outside, value: 0, ids: ids)

	module.functions.push(func)
end 'buildAllocTallyReader'

function emitAllocTallyRowAddr(module StdModule, block IrBlock, bucket ValueId, ids ValueMinter) returns ValueId
	let shift = emitConst(module, block: block, value: DsAllocTallyBucketShift, ids: ids)
	let rowOffset = emitBin(module, block: block, a: bucket, b: shift, opcode: StdBinOpcode.shl, ids: ids)
	let base = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(base, label: DsAllocTallyLabel))

	return emitBin(module, block: block, a: base, b: rowOffset, opcode: StdBinOpcode.add, ids: ids)
end 'emitAllocTallyRowAddr'

// ⚠ The clamp to the last bucket is branchless because this is the body of every allocation a traced build
// makes, and it rests on `shr` being ARITHMETIC in the Std dialect: `room` is negative exactly for a tag
// past the table, so the sign bit smears into an all-ones mask and pulls the index back. Under a logical
// shift the mask is 1 and every overflowing tag steps the bucket one above the one it belongs in. Only the
// high side is clamped — every producer's tag is an enum ordinal, so it cannot arrive negative.
function emitAllocTallyStep(module StdModule, block IrBlock, tagIndex ValueId, size ValueId, ids ValueMinter)
	let lastBucket = emitConst(module, block: block, value: SlabCensusOverflowBucket, ids: ids)
	let room = emitBin(module, block: block, a: lastBucket, b: tagIndex, opcode: StdBinOpcode.sub, ids: ids)
	let signShift = emitConst(module, block: block, value: MachineWordSignShift, ids: ids)
	let overflowMask = emitBin(module, block: block, a: room, b: signShift, opcode: StdBinOpcode.shr, ids: ids)
	let pullBack = emitBin(module, block: block, a: overflowMask, b: room, opcode: StdBinOpcode.bitAnd, ids: ids)
	let bucket = emitBin(module, block: block, a: tagIndex, b: pullBack, opcode: StdBinOpcode.add, ids: ids)
	let row = emitAllocTallyRowAddr(module, block: block, bucket: bucket, ids: ids)

	_ = emitFieldAccumulate(module, block: block, record: row, offset: DsAllocTallyCountOffset, delta: emitConst(module, block: block, value: OneMore, ids: ids), multiM: true, ids: ids)
	_ = emitFieldAccumulate(module, block: block, record: row, offset: DsAllocTallyBytesOffset, delta: size, multiM: true, ids: ids)
end 'emitAllocTallyStep'

// `name() -> i64` — one figure walked over every row.
function buildFigureReader(module StdModule, name ByteArray, figure SlabTrafficFigure)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	let answer = ids.mint()
	var walked = emitSlabTrafficRead(module, func: func, cur: entry, figure: figure, answerId: answer, ids: ids, label: b"sum")
	module.setTerminator(walked, op: StdOp.ret(answer))

	module.functions.push(func)
end 'buildFigureReader'

// ⭐⭐ **WHICH BOTH-LAYER COUNT A READER ANSWERS** — the one fact that picks a green thread's field and the
// process's raw column alike, so a reader cannot pair one count's field with another count's column.
union CombinedCount
	allocs
	frees
	bytes
end 'CombinedCount'

function threadColumnOffset(count CombinedCount) returns ByteOffset
	return match count 'which'
		allocs gives GtOffThreadAllocs
		frees gives GtOffThreadFrees
		bytes gives GtOffThreadAllocBytes
	end 'which'
end 'threadColumnOffset'

// ⭐⭐ **`__mm_counter_thread_*()` — WHAT THE CALLING GREEN THREAD HAS ALLOCATED OR FREED.**
//
// It walks the scheduler word to the M, to its running GT, to that GT's OWNER, and answers the owner's
// field. The owner and not the running GT, because a coroutine is its owner's work: an `async` frame is a
// member of its owner's strand, so billing it to the coroutine would put a bracket's own allocations
// outside the bracket.
//
// A thread that has none of the three — no scheduler, no M, no running GT — is the one thread of
// execution, so *"what has the calling thread allocated"* is *"what has this process allocated"*, and the
// reader answers the walk the process-wide totals answer. That is an ANSWER rather than a fallback, and
// a 0 here would be a sentinel for "not applicable" in a family whose whole contract is that it reports
// numbers.
//
// ⛔ **AN UNCOMMITTED REGION TAKES THE PROCESS-WIDE ARM RATHER THAN COMMITTING ONE TO WALK.** The thread
// walk reads the scheduler word out of the region, so it cannot run without one — and a program that has
// never allocated has no scheduler either, which is the arm that answers 0 for every column.
function buildThreadCounterReader(module StdModule, name ByteArray, model MachineModel, count CombinedCount)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var walkThread = module.addBlock(func, label: b"walk", heat: BlockHeat.normal)
	var haveThread = module.addBlock(func, label: b"havethread", heat: BlockHeat.normal)
	var oneThreadOfExecution = module.addBlock(func, label: b"onethread", heat: BlockHeat.normal)

	let state = emitSlabStateCommitted(module, block: entry, ids: ids)
	let uncommitted = emitSlabStateUncommitted(module, block: entry, state: state, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(uncommitted, thenBlockId: oneThreadOfExecution.id, elseBlockId: walkThread.id))

	let thread = ids.mint()
	var ready = emitCurrentThreadOrZero(module, func: func, cur: walkThread, state: state, model: model, threadId: thread, ids: ids)
	let zero = emitConst(module, block: ready, value: 0, ids: ids)
	let noThread = emitCmp(module, block: ready, a: thread, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(ready, op: StdOp.condBranch(noThread, thenBlockId: oneThreadOfExecution.id, elseBlockId: haveThread.id))

	let field = emitLoadField(module, block: haveThread, record: thread, offset: threadColumnOffset(count), ids: ids)
	module.setTerminator(haveThread, op: StdOp.ret(field))

	let processWide = ids.mint()
	var walked = emitSlabTrafficRead(module, func: func, cur: oneThreadOfExecution, figure: processWideFigure(count), answerId: processWide, ids: ids, label: b"sum")
	module.setTerminator(walked, op: StdOp.ret(processWide))

	module.functions.push(func)
end 'buildThreadCounterReader'

// The process's figure for one count. The raw columns count every request, boxes included, so each is the
// raw column alone — which is exactly what the per-thread columns record, one green thread at a time.
function processWideFigure(count CombinedCount) returns SlabTrafficFigure
	return match count 'which'
		allocs gives SlabTrafficFigure.column(SlabTrafficColumn.rawTotal)
		frees gives SlabTrafficFigure.column(SlabTrafficColumn.rawFrees)
		bytes gives SlabTrafficFigure.column(SlabTrafficColumn.rawBytes)
	end 'which'
end 'processWideFigure'

// ⭐⭐ **THE GREEN THREAD THE CALLER'S ALLOCATIONS BELONG TO, or 0 when there is none.** It terminates
// `cur` and returns the block to continue in, whose single block argument is the answer — the shape every
// branching emit helper in this runtime uses, because the Std tier has no select. The walk starts at the
// slab's scheduler word rather than `__sched_tls_teb_offset`, because that `.data` word is laid out only
// in a program with a scheduler and this reader is built for every heap program.
function emitCurrentThreadOrZero(module StdModule, func IrFunction, cur IrBlock, state ValueId, model MachineModel, threadId ValueId, ids ValueMinter) returns IrBlock
	var merge = module.addBlock(func, label: b"thmerge", heat: BlockHeat.normal)
	merge.blockArgs.push(IrBlockArg.create(threadId, argType: StdType.i64))

	let noThread = emitConst(module, block: cur, value: 0, ids: ids)

	if model == MachineModel.singleMachine 'oneThread'
		module.setTerminator(cur, op: StdOp.branch(merge.id))
		cur.branchEdges.push(BranchEdge.create(merge.id, argIds: argsOf(noThread)))

		return merge
	end 'oneThread'

	var haveMachine = module.addBlock(func, label: b"thmachine", heat: BlockHeat.normal)
	var haveGt = module.addBlock(func, label: b"thgt", heat: BlockHeat.normal)

	let none = SlabBailEdge.create(merge, args: argsOf(noThread))
	let schedulerWord = emitSlabSchedulerWord(module, block: cur, state: state, model: model, ids: ids)
	let m = emitSlabMachineOrBail(module, func: func, cur: cur, schedulerWord: schedulerWord, haveMachine: haveMachine, noScheduler: none, noMachine: none, ids: ids, label: b"thwalk")
	let owner = emitSlabOwnerThreadOrBail(module, cur: haveMachine, m: m, haveOwner: haveGt, noThread: none, ids: ids)
	module.setTerminator(haveGt, op: StdOp.branch(merge.id))
	haveGt.branchEdges.push(BranchEdge.create(merge.id, argIds: argsOf(owner)))

	return merge
end 'emitCurrentThreadOrZero'

// ⭐⭐ **THE PER-UNION DESTRUCTOR CASCADE (P1.3 slice 2).** Synthesize `__destruct_<U>(box)` for every
// managed-payload union whose destructor is REFERENCED (`needed`, collected from the module's
// `__destruct_*` calls — install only what is used, exactly like the rest of the runtime). It is
// APPENDED already-lowered after the pipeline (like `installMmRuntime`); what runs over that appended band
// is stated once, in `Compiler.compileToCodeResult`'s install block.
//
// ⭐ **THERE IS NO HEADER DESTRUCTOR — dispatch is STATIC** — so THIS
// function statically emits each managed field's OWN drop (`__str_decref` for a String, `__mm_decref`
// for a struct box), routed off the SAME classifier the construct's move-in reads. The tag switch drops
// only the LIVE case's managed fields; a moved-out slot is null and its null-guard skips it (so a match
// that bound a payload OUT does not double-free it here).
export function installUnionDestructors(module StdModule, project Project, signatures ProgramSignatures, needed DestructorSet)
	for (_, layout) in project.enumTypes 'each'
		if not unionHasManagedField(signatures, typeNames: project.typeNames, layout: layout) 'noManaged'
			continue
		end 'noManaged'

		if not needed.contains(destructorSymbol(layout.name)) 'notReferenced'
			continue
		end 'notReferenced'

		synthesizeUnionDestructor(module, layout: layout, project: project, signatures: signatures)
	end 'each'
end 'installUnionDestructors'

// ⭐ **NOTE WHAT THE REFERENCED DESTRUCTORS TRANSITIVELY NEED**, for both structs and unions — their
// `__str_decref`/`__mm_free`/nested-`__destruct_<T>` calls live in Std bodies the Maxon-module
// `scanRuntimeUsage` cannot see, so they are DECLARED here. Two obligations:
//
//   1. **Close the needed set over NESTING.** A `__destruct_<Outer>` whose field is a managed struct/union
//      calls that field's OWN `__destruct_<Inner>`, which the module never mentions by name — so an inner
//      destructor referenced ONLY through a cascade would never be synthesized. `closeDestructorNeeds`
//      walks the referenced destructors' managed fields to a fixpoint, adding each nested destructor.
//   2. **Turn on the transitive runtime bits.** Every destructor frees the box (`__mm_free` — heap), and
//      one whose type directly owns a `String` field calls `__str_decref`.
//
// Called after `scanRuntimeUsage`, before `.data` layout reads `usesHeap` and `installStringRuntime` reads
// `usesStrDecref` — so the closed set and the bits are settled before anything they gate is built.
//
// ⛔⛔ **IT USED TO OPEN BY ROOTING EVERY MANAGED OPAQUE-`T` `Array` ELEMENT DESTRUCTOR THE DESCRIPTOR
// RELOCS *MIGHT* BAKE, AND THAT PREDICTION IS GONE (W17-c).** It walked the whole instance registry and rooted
// on `genericInstanceHasManagedOpaqueArrayField` alone — unconditional over the instances, by its own header
// — which is a prediction of what LOWERING will emit, made before lowering. Listing the `String`/`Character`
// cone put four instances of `stdlib/helpers/itertools/withIterator.maxon` in every program's registry
// (`WithIterIterator_ByteIterator_Byte` and its three siblings, from the views' `Iterable with (…)`
// conformances), so `return 0 as ExitCode` rooted `__destruct_ByteIterator`, `__destruct_CodepointIterator`,
// `__destruct_UTF16Iterator` and `__destruct_StringIterator`, and the struct loop below turned the heap on for
// a program that allocates nothing — the five `static-variables/data-section-*` pins, reading their `var` 24
// bytes past its true offset.
//
// ⭐ **THE ROOTED SET IS THE MEASURED ONE AND NOTHING PREDICTS IT**: `noteRelocatedFunctionUsage` roots
// every `.rdata` slot's callee off `pendingRdataRelocs` AFTER lowering — *"the rooted set is the RELOCATED
// set, literally"* — and `ensureLayoutDescriptor`'s `destroyFunc@40` stamp is one of those slots
// (`LowerMaxonToStd:1650`). Naming the same callee by prediction as well is one fact derived twice, one of
// them by guessing — and that holds for the clone side exactly as for the drop side.
export function noteDestructorUsage(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	closeDestructorNeeds(usage, project: project, signatures: signatures)
	declareDestructorCascadeNeeds(usage, project: project, signatures: signatures)
end 'noteDestructorUsage'

// Obligation 2 above — the transitive runtime bits every REFERENCED destructor's synthesized body needs —
// split out because it has TWO callers and must not be one of them's private tail. `noteRelocatedFunctionUsage`
// can put a `__destruct_<T>` in the set that no pre-pipeline walk saw, and a destructor whose `usesStrDecref`
// was never declared links against a `__str_decref` nothing installed.
//
// ⭐⭐ **EVERY BIT IS DERIVED FROM THE DROP CALLEE THE CASCADE WILL ACTUALLY EMIT, AND IT USED TO BE A
// HAND-WRITTEN LIST OF FIELD KINDS — WHICH IS THE SAME FACT WRITTEN TWICE, AND IT WAS WRONG IN ALL THREE ARMS
// AT ONCE.** The three arms asked `structHasStringField` / `structHasArrayField` /
// `unionHasManagedField(wantStringOnly: true)` / `genericInstanceHasStringField`: a fixed roster of the field
// kinds someone remembered, against a synthesis (`managedFieldDropCallee`) that routes SIX. A managed type
// whose drop has its own install bit — rather than one its own construction already turns on — therefore
// linked against nothing.
//
// ⚠ **`CharacterSet` WAS EXACTLY THAT TYPE, AND IT IS WHY THE DEFECT WAS OBSERVABLE (its runtime went at
// W129; the DEFECT class this states did not).** Its family had THREE
// bits (`usesCharSetMake`/`usesCharSetDecref`/`usesCharSetContains`), so `CharacterSet.whitespaces()` declared
// the MAKE and nothing else, and a set reached only through a cascade wanted a `__cs_decref` no install had
// been asked for. MEASURED on this tree at a struct field, at a union payload AND at a generic instance's
// substituted field — all three — `panic at X64Backend.maxon:2013: resolveCallFixups: call to unknown function
// '__cs_decref'`, with no diagnostic and no line. (`Set`/`Map`/`List`/`__ManagedFile`/`__ManagedDirectory`
// escaped only because each has ONE bit that constructing a value already sets; that is a property of their
// bit granularity, not of this walk, and it is not a property worth relying on.)
//
// ⇒ Each arm now walks its own managed fields, asks the SAME router the synthesis will ask, and hands the
// answer to `recordCallUsage` — the one callee-to-bit map, which also closes each family over what its own
// body calls. A drop callee this compiler can emit and this walk cannot account for is now unrepresentable
// rather than a list to remember to extend. It is also CHEAPER than what it replaces: the struct arm ran three
// full field walks (`structHasStringField`, `structHasArrayField`, `structHasExistentialField`) and now runs
// one.
//
// ⚠ **IT IS SAFE TO CALL `recordCallUsage` HERE, AND ONLY HERE, BECAUSE `closeDestructorNeeds` HAS ALREADY
// RUN.** That map INSERTS a `__destruct_<T>` callee into `neededDestructors` without queueing the cascade node
// that closes it over its own nesting — harmless once the closure is at its fixpoint (every such callee is
// already in the set, so the insert is a no-op), and a silently truncated closure if it ever ran first. Both
// callers order the two that way; a third must too.
function declareDestructorCascadeNeeds(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	for (_, layout) in project.structTypes 'eachStruct'
		if usage.neededDestructors.contains(destructorSymbol(layout.name)) 'referenced'
			usage.usesHeap = true
			declareStructFieldDropNeeds(usage, layout: layout, typeNames: project.typeNames, signatures: signatures)
		end 'referenced'

		// The record's DICTIONARY cascade's own bits (W183) — the struct arm of the instance pair below, and
		// like it the only walk that can turn on `__drop_type_param`'s install bit for this record.
		if usage.neededDestructors.contains(dictionaryDestructorSymbol(layout.name)) 'dictionaryReferenced'
			usage.usesHeap = true
			declareStructDictionaryDropNeeds(usage, layout: layout, project: project, signatures: signatures)
		end 'dictionaryReferenced'
	end 'eachStruct'

	for (_, layout) in project.enumTypes 'eachUnion'
		if usage.neededDestructors.contains(destructorSymbol(layout.name)) 'referenced'
			usage.usesHeap = true
			declareUnionPayloadDropNeeds(usage, layout: layout, project: project, signatures: signatures)
		end 'referenced'
	end 'eachUnion'

	// A REFERENCED managed generic instance's `__destruct_<mangled>` (P1.6-B2) frees its box (`__mm_free` —
	// heap) and calls each substituted field's own drop, both inside the synthesized body the Maxon scan cannot
	// see. A managed value inside a nested struct/instance field is dropped by that nested destructor, so only
	// a DIRECT substituted field is accounted for here.
	// ⚠ The walk below must be safe to ask of ANY instance, builtin included — see
	// `declareInstanceFieldDropNeeds`, which carries the no-layout guard. `neededDestructors` is keyed by
	// SYMBOL NAME, and a declared `type Array_Foo` would otherwise claim the very name `Array with Foo`
	// mangles to; that instance is minted as `__Array_Foo` instead (`reservedIfDeclared`), so the two cannot
	// meet. The guard is the walk's structural precondition regardless of which route reaches it.
	for id in 0 upto signatures.genericInstanceCount() 'eachInstance'
		let mangled = signatures.mangleGenericInstance(id)

		if usage.neededDestructors.contains(destructorSymbol(mangled)) 'referenced'
			usage.usesHeap = true
			declareInstanceFieldDropNeeds(usage, id: id, signatures: signatures)
		end 'referenced'

		// The DICTIONARY cascade's own bits (BATCH41). It frees its box like every other cascade, and it is
		// the ONE cascade that calls `__drop_type_param` — a runtime entry with its own install bit, which no
		// other walk here can turn on because no other cascade names it.
		if usage.neededDestructors.contains(dictionaryDestructorSymbol(mangled)) 'dictionaryReferenced'
			usage.usesHeap = true
			declareInstanceDictionaryDropNeeds(usage, id: id, signatures: signatures)
		end 'dictionaryReferenced'
	end 'eachInstance'
end 'declareDestructorCascadeNeeds'

// The struct arm's field walk — `addNestedStructDestructors`' bit-declaring dual, and deliberately its
// mirror image field for field: that one collects the nested SYMBOLS a cascade names, this one declares the
// runtime BITS the same callees need. Both ask `managedStructFieldDropCallee`, so the callee a field is
// accounted for under and the callee it is dropped through are one answer.
function declareStructFieldDropNeeds(usage RuntimeUsage, layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures)
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'

		// ⭐ **AN EXISTENTIAL FIELD NAMES NO CALLEE, so it is the one kind that cannot be derived and is
		// declared directly** (P1.7a-existentials slice 2). Its drop is `__drop_existential(witness, value)`,
		// read out of the witness table at run time, which `managedFieldDropCallee` refuses to answer for at
		// all — the same arm `addNestedStructDestructors` skips for the same reason, one question over.
		if signatures.structFieldIsExistential(layout.name, index: i) 'existential'
			usage.usesDropExistential = true
			continue
		end 'existential'

		recordCallUsage(managedStructFieldDropCallee(layout, index: i, typeNames: typeNames, signatures: signatures), usage: usage)
	end 'eachField'
end 'declareStructFieldDropNeeds'

// The dictionary twin of the walk above (W183) — `addNestedStructDictionaryDestructors`' bit-declaring dual,
// over the SAME `dictionaryStructFieldDropKind` classifier, so a field accounted for here is dropped through
// the callee it was accounted for under.
function declareStructDictionaryDropNeeds(usage RuntimeUsage, layout StructLayout, project Project, signatures ProgramSignatures)
	for i in 0 upto layout.fieldCount() 'eachField'
		match dictionaryStructFieldDropKind(layout, index: i, typeNames: project.typeNames, signatures: signatures) 'released'
			none then continue
			released(kind) then declareDropKindNeeds(usage, kind: kind)
		end 'released'
	end 'eachField'
end 'declareStructDictionaryDropNeeds'

// The union twin — `addNestedUnionDestructors`' bit-declaring dual, over the same payload classifier.
function declareUnionPayloadDropNeeds(usage RuntimeUsage, layout EnumLayout, project Project, signatures ProgramSignatures)
	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)

		for fi in 0 upto payloads.count() 'eachField'
			let field = try payloads.get(fi) otherwise panic("declareUnionPayloadDropNeeds: payloadsAt count disagrees with get at {fi}")
			let class = classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)

			if not payloadClassOwesDrop(class) 'scalar'
				continue
			end 'scalar'

			declareDropKindNeeds(usage, kind: payloadDropKind(signatures, typeNames: project.typeNames, field: field, class: class))
		end 'eachField'
	end 'eachCase'
end 'declareUnionPayloadDropNeeds'

// The instance twin — `addNestedInstanceDestructors`' bit-declaring dual, carrying that walk's own
// precondition: a layout-less instance (`Array`/`Set` and every undeclared base) synthesizes no cascade, and
// the field walk reads a base struct it does not have. See `genericInstanceHasBaseLayout` for why the
// early-out and the emptiness are one gate.
function declareInstanceFieldDropNeeds(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures)
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCascade'
		return
	end 'noSynthesizedCascade'

	// ⭐ **IT READS `instanceFieldDropKind` RATHER THAN RESTATING IT.** Asking the classifier's three
	// questions again in an `if` chain here — is the field managed, is it existential, what is its callee —
	// is one field classified in two places, agreeing today with nothing making them agree tomorrow. A field
	// is accounted for under exactly the callee the cascade drops it through.
	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'

		declareDropKindNeeds(usage, kind: instanceFieldDropKind(signatures, id: id, index: i))
	end 'eachField'
end 'declareInstanceFieldDropNeeds'

// The dictionary twin of the walk above — `addNestedInstanceDictionaryDestructors`' bit-declaring dual, over
// the SAME `dictionaryInstanceFieldDropKind` classifier, so a field accounted for here is dropped through the
// callee it was accounted for under.
function declareInstanceDictionaryDropNeeds(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures)
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCascade'
		return
	end 'noSynthesizedCascade'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		match dictionaryInstanceFieldDropKind(signatures, id: id, index: i) 'released'
			none then continue
			released(kind) then declareDropKindNeeds(usage, kind: kind)
		end 'released'
	end 'eachField'
end 'declareInstanceDictionaryDropNeeds'

// The runtime bits ONE released field's drop needs. `recordCallUsage` closes each family over what its own
// body calls, and it is what turns on `usesDropTypeParam` for the bare-parameter slot.
module function declareDropKindNeeds(usage RuntimeUsage, kind FieldDropKind)
	match kind 'kind'
		direct(callee) then recordCallUsage(callee, usage: usage)
		existential then usage.usesDropExistential = true
		throughDescriptor(callee, _, _) then recordCallUsage(callee, usage: usage)
	end 'kind'
end 'declareDropKindNeeds'

// ⭐⭐ **ROOT EVERY FUNCTION AN `.rdata` SLOT NAMES, AFTER LOWERING HAS FILLED THEM (P1.7a-existentials
// slice 2).** A witness table's `destroyFunc@8` and its method slots, and a layout descriptor's
// `destroyFunc@40`/`copyFunc@32`, are reached through DATA rather than through code: `__drop_existential`
// loads the word out of `.rdata` at run time and `callIndirect`s it, so nothing the module's call graph can
// see names it. The writer will bake a `.text` VA for every one of them, so every one must be INSTALLED.
//
// ⭐ **THE ROOTED SET IS THE RELOCATED SET, LITERALLY — read off the relocations rather than re-derived from
// the declarations that produced them.** It is had by CONSTRUCTION here, which matters because WHICH
// `(conformer, interface)` pairs get a table — and which instances get a layout descriptor — is decided
// during LOWERING, and no pre-pipeline walk can know it. That is why the two pre-pipeline PREDICTIONS of the
// descriptor's own `destroyFunc@40`/`copyFunc@32` targets are deleted (W17-c) rather than kept beside this:
// they asked the same question of the declarations and answered it for instances no program reaches. The first attempt rooted every DECLARED conformance instead, and every program has the stdlib's
// (`FilePath` and `URL` conform, reachable or not) — so `var flag = true` grew the three `__slab_*` `.data`
// globals and five `static-variables/data-section-*` cases read their bool 24 bytes off its true offset.
//
// ⚠ **IT MUST RUN AFTER THE PIPELINE AND BEFORE THE INSTALLS, AND THE ONE THING IT CANNOT REACH IS THE
// `.data` LAYOUT** (`globalData.layOut`, which reads `usesHeap` before lowering). That is sound rather than
// lucky: every callee an `.rdata` slot can name releases a HEAP record — a `__destruct_<T>`, `__mm_decref`,
// `__str_decref`, `__managed_decref` — so the program that named it allocated one, and `usesHeap` was already
// true when the layout was taken. The gate below says so rather than trusting it.
//
// Every name goes through `recordCallUsage`, the ONE callee→bit map, so each rooted symbol declares its own
// transitive floor exactly as a direct call to it would; `closeDestructorNeeds` then closes the cascades
// over their nesting, which is why this is the whole of `noteRelocatedFunctionUsage` and not a second copy of
// that closure. A slot naming a USER method (`Point.tag`) sets no bit — it is `.text` the DFE roots
// separately — and costs one prefix test.
//
// ⭐⭐ **THE CLOSURE IS RE-ENTERED ONLY IF THIS WALK ACTUALLY PUT A NEW DESTRUCTOR SYMBOL IN THE SET, AND
// UNGATED IT IS A SUPERLINEAR COST FOR NOTHING.** `noteDestructorUsage` has already run
// `closeDestructorNeeds` to a FIXPOINT, and that closure derives from exactly one input: the seed set. So a
// second run over an unchanged seed set re-expands the identical nodes, re-derives the identical symbols and
// re-sets bits that are already set — the definition of a no-op, at the price of the whole closure.
//
// ⚠ **THE PRICE IS NOT LINEAR, WHICH IS WHY A REDUNDANT RUN MATTERS.** One expansion of the drain costs
// `genericInstanceCount()` allocations (MEASURED on the scale ladder, exactly: 23 / 59 / 203 / 395 per
// expanded node at rungs 0 / 2 / 4 / 5, against instance registries of 23 / 59 / 203 / 395), so the closure
// as a whole is O(referenced cascades x instances) — QUADRATIC in program size. Ungated, this line costs
// +1,458 / +5,406 / +47,084 / +167,161 allocations at those rungs. The quadratic belongs to the closure
// rather than to this call site and is reported as measured debt; what belongs here is not paying it twice
// for nothing.
//
// The COUNT is the whole test because `neededDestructors` is insert-only: unchanged count ⟺ unchanged set.
// A reloc that names a `__destruct_<T>` — the case this function exists for, a witness table's
// `destroyFunc@8` pointing at a conformer's cascade — grows it and the closure runs exactly as before.
export function noteRelocatedFunctionUsage(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	let heapBefore = usage.usesHeap
	let destructorsBefore = usage.neededDestructors.count()
	let clonersBefore = usage.neededCloners.count()
	let soleWalksBefore = usage.neededSoleWalks.count()
	let shareWalksBefore = usage.neededShareWalks.count()

	for reloc in project.globalData.pendingRdataRelocs 'eachRdataSlot'
		recordCallUsage(reloc.funcName, usage: usage)
	end 'eachRdataSlot'

	// ⭐⭐ **BOTH CASCADES ARE RE-CLOSED, NOT JUST THE DROP ONE, AND THAT IS WHY NOTHING BEFORE THE PIPELINE
	// HAS TO PREDICT EITHER.** A layout descriptor stamps `destroyFunc@40` AND `copyFunc@32`
	// (`LowerMaxonToStd:1650`/`:1664`), so a reloc can be the FIRST mention of either a `__destruct_<T>` or a
	// `__clone_<T>` — and a cascade left unclosed is an inner destructor/cloner nothing synthesizes, plus a
	// `usesStrDecref`/`usesStrClone` nothing declares. Both closures are gated on their OWN set having grown,
	// for the superlinear reason below; both installers run after this call, so a set grown here is still in
	// time to be built.
	if usage.neededDestructors.count() > destructorsBefore 'newDropCascades'
		closeDestructorNeeds(usage, project: project, signatures: signatures)
		declareDestructorCascadeNeeds(usage, project: project, signatures: signatures)
	end 'newDropCascades'

	if usage.neededCloners.count() > clonersBefore 'newCloneCascades'
		noteCascadeUsage(usage, project: project, signatures: signatures, action: CascadeAction.clone)
	end 'newCloneCascades'

	// The two walks' twins of the arm above: a witness table's `soleWalkFunc@24`/`shareWalkFunc@32` name a
	// conformer's walk that no call in the module may reach.
	if usage.neededSoleWalks.count() > soleWalksBefore 'newSoleCascades'
		noteCascadeUsage(usage, project: project, signatures: signatures, action: CascadeAction.soleWalk)
	end 'newSoleCascades'

	if usage.neededShareWalks.count() > shareWalksBefore 'newShareCascades'
		noteCascadeUsage(usage, project: project, signatures: signatures, action: CascadeAction.shareWalk)
	end 'newShareCascades'

	// ⚠ **CHECKED LAST, BECAUSE THE TWO CLOSURES ABOVE ALSO SET THE BIT** — a referenced struct destructor
	// and a referenced cloner each declare the heap. Checking it against the reloc loop alone would leave
	// exactly the case this gate exists for unguarded.
	if usage.usesHeap and not heapBefore 'heapArrivedTooLate'
		panic("noteRelocatedFunctionUsage: an `.rdata` slot named a heap callee in a program whose `.data` layout was taken with `usesHeap` false — the runtime globals are laid out before lowering, so the layout is now short by their width. Every relocatable callee releases a heap record, so the program that named one must already have allocated one: a new relocation kind has broken that premise")
	end 'heapArrivedTooLate'
end 'noteRelocatedFunctionUsage'

// Grow `usage.neededDestructors` to a fixpoint over destructor NESTING: for every referenced managed
// struct/union/instance destructor, add the `__destruct_<T>` of each managed field that itself owns managed
// heap (a nested struct/union/instance), because that nested destructor is CALLED by the cascade but named
// nowhere the module scan can see. So `Box with (Box with String)`, reached only through the outer cascade,
// still gets the inner instance destructor synthesized.
//
// ⭐ Driven by the SHARED `CascadeWorklist` (`CascadeNeeds.maxon`) — the same engine that closes the two
// non-drop cascades (`noteCascadeUsage`, in this file). A closure per action is a `while changed` RE-SCAN of every declared type,
// which is one quadratic written down twice: a cascade chain of depth D costs D passes over all T types and
// re-mints every type's `__destruct_` symbol on each. Registration walks the node space ONCE, the drain
// expands each referenced node exactly once, and the loop needs no growth flag at all — the queue
// IS the growth signal. See that file for why the graph is demand-driven rather than built up front.
function closeDestructorNeeds(usage RuntimeUsage, project Project, signatures ProgramSignatures)
	// A program that drops no managed type has an EMPTY needed set, and a monotone closure over an empty
	// seed set can only stay empty — nothing derives a nested destructor from no destructor. Early-out then,
	// so registering the node space (a `destructorSymbol` per declared type and a `mangleGenericInstance` per
	// instance) is paid only by a program that actually drops something. This is the same early-out, for the
	// same reason, that the non-drop dual `noteCascadeUsage` opens with: without it every type's symbol is
	// re-minted twice on a compile that drops nothing at all.
	if usage.neededDestructors.count() == 0 'noDestructors'
		return
	end 'noDestructors'

	var work = CascadeWorklist.create()

	for (_, layout) in project.structTypes 'eachStruct'
		work.register(destructorSymbol(layout.name), node: CascadeNode.declaredStruct(layout))

		// The record's DICTIONARY cascade is a second node over the same layout, registered unconditionally
		// for the instance pair's reason: registering is cheap and says nothing, and only a SEEDED symbol is
		// ever expanded.
		work.register(dictionaryDestructorSymbol(layout.name), node: CascadeNode.declaredStructDictionary(layout))
	end 'eachStruct'

	for (_, layout) in project.enumTypes 'eachUnion'
		work.register(destructorSymbol(layout.name), node: CascadeNode.declaredUnion(layout))
	end 'eachUnion'

	// ⚠ A node is keyed by its SYMBOL, and whatever wins a key must be safe to EXPAND — see
	// `addNestedInstanceDestructors`. A declared `type Array_Foo` would otherwise register under the very
	// name an `Array with Foo` instance mangles to and the two would compete for one key; the reserved-space
	// disjointness (`reservedIfDeclared`) means a declaration and an instance cannot produce one symbol, and
	// only two INSTANCES can — which is E3006 and fails the build before this runs.
	for id in 0 upto signatures.genericInstanceCount() 'eachInstance'
		let mangled = signatures.mangleGenericInstance(id)
		work.register(destructorSymbol(mangled), node: CascadeNode.genericInstance(id))

		// The DICTIONARY destructor is a second node over the same instance, registered unconditionally for
		// `register`'s own reason: registration is cheap and says nothing, while EXPANDING is what turns on a
		// type's runtime bits, and only a seeded symbol is ever expanded.
		work.register(dictionaryDestructorSymbol(mangled), node: CascadeNode.genericInstanceDictionary(id))
	end 'eachInstance'

	work.seed(usage.neededDestructors as CascadeSymbolSet)

	while work.hasPending() 'drain'
		let node = work.take()

		match node 'node'
			declaredStruct(layout) then addNestedStructDestructors(usage, layout: layout, typeNames: project.typeNames, signatures: signatures, work: work)
			declaredStructDictionary(layout) then addNestedStructDictionaryDestructors(usage, layout: layout, project: project, signatures: signatures, work: work)
			declaredUnion(layout) then addNestedUnionDestructors(usage, layout: layout, project: project, signatures: signatures, work: work)
			genericInstance(id) then addNestedInstanceDestructors(usage, id: id, signatures: signatures, work: work)
			genericInstanceDictionary(id) then addNestedInstanceDictionaryDestructors(usage, id: id, signatures: signatures, work: work)
		end 'node'
	end 'drain'
end 'closeDestructorNeeds'

// The drop callee for MANAGED field `index` of PROJECT struct `layout` — its field-type id read off the
// project layout and resolved against `project.typeNames`, the ONE interner that layout's ids live in. SOLE
// home of that pairing: both the needs closure (`addNestedStructDestructors`) and the body synthesis
// (`synthesizeStructDestructor`) route through here, so neither can drift back to re-fetching a `signatures`
// layout and misresolving its id against `project.typeNames` — the OPEN #56 mismatch (a panic when the misread
// name was no declared type, a WRONG destructor when it happened to be one), now unrepresentable rather than
// re-asserted by a comment at each site. Precondition: the caller checked `structFieldIsManaged`.
function managedStructFieldDropCallee(layout StructLayout, index FieldIndex, typeNames TypeNameInterner, signatures ProgramSignatures) returns ByteArray
	let fieldType = try layout.fieldTypes.get(index) otherwise panic("managedStructFieldDropCallee: fieldTypes.get OOB at {index}")
	return managedFieldDropCallee(signatures, typeNames: typeNames, fieldType: fieldType)
end 'managedStructFieldDropCallee'

// Add the nested `__destruct_<T>` of each managed field of struct `layout` to the needed set, queueing each
// newly-needed cascade on `work` so its OWN nesting is closed in turn. A field whose drop callee is a
// destructor symbol (a managed struct/union) contributes its symbol; a String (`__str_decref`) or scalar-only
// box (`__mm_decref`) contributes none.
function addNestedStructDestructors(usage RuntimeUsage, layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures, work CascadeWorklist)
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'

		// ⭐ **AN EXISTENTIAL FIELD CONTRIBUTES NO *NESTED* SYMBOL, BECAUSE IT NAMES NONE (P1.7a-existentials
		// slice 2).** Its drop is `__drop_existential`, which reads the destructor out of the witness table at
		// run time — so there is no callee here to close the set over. The destructors those tables can name
		// are rooted from the RELOCATIONS instead (`noteRelocatedFunctionUsage`), which re-enters this closure
		// afterwards, so a conformer that owns a managed field still gets its own cascade expanded.
		if signatures.structFieldIsExistential(layout.name, index: i) 'existential'
			continue
		end 'existential'

		insertIfDestructorSymbol(usage, callee: managedStructFieldDropCallee(layout, index: i, typeNames: typeNames, signatures: signatures), work: work)
	end 'eachField'
end 'addNestedStructDestructors'

// The DICTIONARY twin of the walk above (W183) — add the nested cascade each released field of a record over
// the enclosing parameters names. It reads `dictionaryStructFieldDropKind` rather than restating it, exactly
// as its instance twin `addNestedInstanceDictionaryDestructors` reads that family's classifier: a
// bare-parameter slot names no symbol at all (its release is `__drop_type_param` against a WORD), and every
// other managed field names whatever its concrete drop callee names.
function addNestedStructDictionaryDestructors(usage RuntimeUsage, layout StructLayout, project Project, signatures ProgramSignatures, work CascadeWorklist)
	for i in 0 upto layout.fieldCount() 'eachField'
		match dictionaryStructFieldDropKind(layout, index: i, typeNames: project.typeNames, signatures: signatures) 'released'
			none then continue
			released(kind) then noteNestedCascadeOf(usage, kind: kind, work: work)
		end 'released'
	end 'eachField'
end 'addNestedStructDictionaryDestructors'

// The union twin of `addNestedStructDestructors` — add each managed payload field's nested destructor.
function addNestedUnionDestructors(usage RuntimeUsage, layout EnumLayout, project Project, signatures ProgramSignatures, work CascadeWorklist)
	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)

		for fi in 0 upto payloads.count() 'eachField'
			let field = try payloads.get(fi) otherwise panic("addNestedUnionDestructors: payloadsAt count disagrees with get at {fi}")
			let class = classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)

			if not payloadClassOwesDrop(class) 'scalar'
				continue
			end 'scalar'

			noteNestedCascadeOf(usage, kind: payloadDropKind(signatures, typeNames: project.typeNames, field: field, class: class), work: work)
		end 'eachField'
	end 'eachCase'
end 'addNestedUnionDestructors'

// The instance twin of `addNestedStructDestructors` (P1.6-B2) — add the nested `__destruct_<T>` of each
// managed SUBSTITUTED field of instance `id` (a nested struct/union/instance) to the needed set. A String
// field's `__str_decref` and a trivial box's `__mm_decref` are leaf drops and add nothing. No `project`:
// every fact is answered inside `signatures`, over its own interner.
function addNestedInstanceDestructors(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures, work CascadeWorklist)
	// ⚠ One of the three sites needing the no-layout early-out — `genericInstanceHasManagedField` and this
	// walk's own bit-declaring dual `declareInstanceFieldDropNeeds` are the others: a node is expanded as soon
	// as its SYMBOL is needed, and the field walk below reads a base struct a layout-less instance does not
	// have. Measured before the guard existed: `panic ProgramSignatures.baseLayoutOf`, no diagnostic. (The
	// route that reached it — a declared `type Array_Foo` expanding the base-less `Array with Foo` node
	// registered under the identical string — is closed by P1.7's `reservedIfDeclared`; the guard is the
	// walk's precondition either way.)
	//
	// Nothing is lost by returning: an `Array`/`Set` instance synthesizes no cascade for its nesting to
	// close over — its elements are dropped by `__managed_decref`, whose own element destructor is
	// rooted by the descriptor reloc that names it (`noteRelocatedFunctionUsage`) — and an UNDECLARED base has no fields to
	// nest through at all. See `ProgramSignatures.genericInstanceHasBaseLayout` for why those are one gate.
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCascade'
		return
	end 'noSynthesizedCascade'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'

		// An existential field names no nested symbol — `addNestedStructDestructors`' arm, for its reason.
		if signatures.genericInstanceFieldIsExistential(id, index: i) 'existential'
			continue
		end 'existential'

		insertIfDestructorSymbol(usage, callee: signatures.genericInstanceFieldDropCallee(id, index: i), work: work)
	end 'eachField'
end 'addNestedInstanceDestructors'

// The DICTIONARY twin of the walk above (BATCH41) — add the nested cascade each released field of a
// DECLARATION VIEW names. It differs from its twin in exactly what `dictionaryInstanceFieldDropKind` differs
// in, and it reads that classifier rather than restating it: a bare-parameter slot names no symbol at all
// (its release is `__drop_type_param` against a WORD), a nested declaration view names its own DICTIONARY
// destructor, and every other managed field names whatever its concrete drop callee names.
function addNestedInstanceDictionaryDestructors(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures, work CascadeWorklist)
	// `addNestedInstanceDestructors`' precondition, for its reason: a layout-less instance has no field list
	// to walk. It cannot be reached today — `instanceRestsARetainedSlot` opens with the same guard — and it is
	// the walk's precondition rather than a patch on the route that reaches it.
	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCascade'
		return
	end 'noSynthesizedCascade'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		match dictionaryInstanceFieldDropKind(signatures, id: id, index: i) 'released'
			none then continue
			released(kind) then noteNestedCascadeOf(usage, kind: kind, work: work)
		end 'released'
	end 'eachField'
end 'addNestedInstanceDictionaryDestructors'

// The nested cascade ONE released field names, whichever shape its release came in. An existential names
// none — `addNestedStructDestructors`' arm, for its reason.
function noteNestedCascadeOf(usage RuntimeUsage, kind FieldDropKind, work CascadeWorklist)
	match kind 'kind'
		direct(callee) then insertIfDestructorSymbol(usage, callee: callee, work: work)
		existential then usage.usesDropExistential = true
		throughDescriptor(callee, _, _) then insertIfDestructorSymbol(usage, callee: callee, work: work)
	end 'kind'
end 'noteNestedCascadeOf'

// Insert `callee` into the needed set iff it is a `__destruct_<T>` symbol not already present, and — only
// when it is NEWLY added — announce it to `work`, whose job is to find the declaration that symbol names and
// queue that declaration's own nested cascades. Announcing exactly on the newly-added edge is what makes the
// closure O(types + fields): a symbol can be new only once, so a node is queued at most once. A
// `__str_decref`/`__mm_decref` callee (a leaf drop) is not a destructor and is left out — only synthesized
// cascades are collected here.
function insertIfDestructorSymbol(usage RuntimeUsage, callee ByteArray, work CascadeWorklist)
	if not bytesStartWith(callee, prefix: DestructorPrefix) 'notDestructor'
		return
	end 'notDestructor'

	if usage.neededDestructors.contains(callee) 'present'
		return
	end 'present'

	usage.neededDestructors.insert(callee)
	work.discovered(callee)
end 'insertIfDestructorSymbol'

// Emit `__destruct_<U>(box)`:
//
//   entry + lower: the shared refcount RMW (`emitRefcountCheckToLastOwner`) — `rc == 0` is the last
//     owner and branches to `drop`; otherwise the count is lowered and the box kept.
//   drop:  load the tag, then a per-managed-case guard chain (`if tag == c_i` → drop c_i's fields).
//          A scalar/payload-free case is not in the chain — its tag falls through to `free`.
//   case:  drop each managed field behind a NULL-guard, then fall to `free`.
//   free:  `__mm_free(box)`; ret.
//
// A void `(i64) -> void` signature — the X64 backend discards nothing, and there is no `call_indirect`
// type tag to satisfy (static dispatch), so it needs no `i64` return.
function synthesizeUnionDestructor(module StdModule, layout EnumLayout, project Project, signatures ProgramSignatures)
	var func = IrFunction.createFromStd(destructorSymbol(layout.name), returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0, needsGreenThreadStackGuard: true)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var lower = module.addBlock(func, label: b"lower", heat: BlockHeat.normal)
	var drop = module.addBlock(func, label: b"drop", heat: BlockHeat.normal)
	var free = module.addBlock(func, label: b"free", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let box = 0 as ValueId

	emitRefcountCheckToLastOwner(module, func: func, entry: entry, lower: lower, record: box, lastOwner: drop, ids: ids)

	let tag = ids.mint()
	module.appendOp(drop, op: StdOp.loadIndirect(tag, addrId: box, offset: UnionTagOffset, valueType: StdType.i64))

	var cur = drop

	for ci in 0 upto layout.caseCount() 'eachCase'
		if not caseHasManagedField(signatures, typeNames: project.typeNames, layout: layout, ci: ci) 'scalarCase'
			continue
		end 'scalarCase'

		var caseBlock = module.addBlock(func, label: b"case", heat: BlockHeat.normal)
		var nextTest = module.addBlock(func, label: b"casetest", heat: BlockHeat.normal)
		let tagConst = ids.mint()
		module.appendOp(cur, op: StdOp.const(tagConst, value: layout.tagOfIndex(ci), valueType: StdType.i64))
		let isCase = ids.mint()
		module.appendOp(cur, op: StdOp.cmp(isCase, lhs: tag, rhs: tagConst, pred: StdCmpPred.eq, operandType: StdType.i64))
		module.setTerminator(cur, op: StdOp.condBranch(isCase, thenBlockId: caseBlock.id, elseBlockId: nextTest.id))
		emitManagedFieldDrops(module, startBlock: caseBlock, box: box, layout: layout, ci: ci, dest: free, project: project, signatures: signatures, ids: ids, func: func)
		cur = nextTest
	end 'eachCase'

	// The final else — a scalar / payload-free case's tag matched no managed case — falls to the free.
	module.setTerminator(cur, op: StdOp.branch(free.id))

	let freed = ids.mint()
	module.appendOp(free, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(box)))
	module.setTerminator(free, op: StdOp.retVoid)

	module.functions.push(func)
end 'synthesizeUnionDestructor'

// ⭐⭐ **THE PER-STRUCT DESTRUCTOR CASCADE (P1.4a wave 2).** The struct twin of `installUnionDestructors`:
// synthesize `__destruct_<Struct>(box)` for every struct that owns a managed field and whose destructor is
// REFERENCED. Appended already-lowered after the pipeline, like the union one; what runs over that appended
// band is stated once, in `Compiler.compileToCodeResult`'s install block.
// A struct has NO tag — every field is always present — so the cascade drops each managed field
// unconditionally (behind a null-guard) rather than under a tag switch.
//
// ⚠ **GATED ON ANY DESTRUCTOR BEING NEEDED AT ALL**, so a program that drops nothing does not walk the
// type registry to discover it needs nothing — `closeDestructorNeeds`' early-out, on the same set and for
// the same reason. ⚠ It stood BELOW the project walk until this rung's review, where it said this and gated
// only the SECOND of the two registries; the clone twin already gated both, which is the disagreement that
// made the two walks worth deriving once.
export function installStructDestructors(module StdModule, project Project, signatures ProgramSignatures, needed DestructorSet)
	if needed.count() == 0 'nothingDrops'
		return
	end 'nothingDrops'

	installStructRuntimeEntries(module, project: project, signatures: signatures, needed: needed as ReferencedEntrySymbols, kind: StructRuntimeEntryKind.destructor)
end 'installStructDestructors'

// ⭐⭐ **THE PER-RECORD *DICTIONARY* DESTRUCTOR CASCADE (W183)** — the declared-record twin of
// `installGenericInstanceDictionaryDestructors`, over the same roster the plain struct cascade walks. It
// exists for one record shape the instance family cannot reach: a TUPLE whose elements stand at the
// enclosing generic's own parameters (`typealias Pair = (K, V)`, `stdlib/Map.maxon`'s `Entry`), which is a
// `structRef` and not a `genericInstance`.
//
// ⛔⛔ **THE STORE INTO SUCH A RECORD ALREADY TAKES A REFERENCE AND NOTHING RELEASED IT — MEASURED, exit
// 101 on three cases of `generic-opaque-value-store` and on `interface-extensions/stdlib-map-on-map-with-
// function`.** `Parser.moveOpaqueValueInto` co-owns a borrowed opaque slot through `retainFunc@64` — for a
// `String` argument that word is `__str_clone`, so the record holds a fresh 58-byte record of its own — and
// a body that is ITSELF shared then dropped the box through the trivial `__mm_decref`, because
// `typeIsManaged` answers `false` for a bare parameter. A CONCRETE caller of the same shared body was fine
// all along: the tuple it takes back is `(String, Small)`, whose substituted `__destruct_` releases the slot.
export function installStructDictionaryDestructors(module StdModule, project Project, signatures ProgramSignatures, needed DestructorSet)
	if needed.count() == 0 'nothingDrops'
		return
	end 'nothingDrops'

	installStructRuntimeEntries(module, project: project, signatures: signatures, needed: needed as ReferencedEntrySymbols, kind: StructRuntimeEntryKind.dictionaryDestructor)
end 'installStructDictionaryDestructors'

// ⭐⭐ **WHICH PER-STRUCT RUNTIME ENTRY THE ONE LAYOUT WALK BELOW IS INSTALLING.** A discriminator rather than
// two walks, exactly as `ProgramSignatures.instanceOwnsASlotOfKind` takes a `TypeArgInstantiationKind`: the
// TRAVERSAL is the shared fact and the per-entry body is the difference, so the difference is what gets a
// name and the traversal is what gets written once.
union StructRuntimeEntryKind
	// `__destruct_<Struct>` — admitted only for a layout that owns a managed field.
	destructor

	// ⭐ `__destruct_dict_<Struct>(descriptor, box)` (W183) — admitted only for a layout resting a slot at a
	// bare type parameter, which is the one slot `structHasManagedField` cannot see. Its instance twin is
	// `installGenericInstanceDictionaryDestructors`.
	dictionaryDestructor

	// `__sole_<Struct>` — admitted for every referenced layout, managed fields or not: a scalar-only
	// box still has an owner count to prove, which is exactly what a cross to another green thread needs.
	soleWalk

	// `__share_<Struct>` — admitted for every referenced layout for the same reason: a scalar-only box still
	// has a count to mark.
	shareWalk

	// `__clone_<Struct>` — admitted for any referenced layout, managed fields or not.
	cloner
end 'StructRuntimeEntryKind'

// ⭐⭐ **THE ONE ROSTER OF LAYOUTS A PER-STRUCT RUNTIME ENTRY MAY BE SYNTHESIZED FOR — TWO REGISTRIES, ONE
// DERIVATION (review of W180).** The drop side and the clone side must never disagree about WHICH LAYOUTS
// EXIST, and the way they came to disagree is that each spelled the walk itself: W41 added the second
// registry to the drop side off a measured backend panic, W180 found the clone side still walking one
// registry and added the same loop again — a fix that reproduced the shape it was fixing. **A third source of
// layouts, or a fourth rule about which of the two wins, is now ONE edit; when it was two, the second copy
// did not exist for four months and the tell was `bakeFuncAbs64Relocs: … it was never installed`, a BACKEND
// PANIC rather than a diagnostic.** What stays per-entry is the ADMISSION TEST, which is genuinely different
// (`installOneStructDestructor` gates on a managed field, `installOneStructCascade` deliberately does not).
//
// ⭐⭐ **THE TUPLES, FROM THE INDEX — BECAUSE THE PROJECT REGISTRY NEVER RECEIVES A SUBSTITUTED ONE
// (W41).** `project.structTypes` is fed by `ParseStaging.commitStructTypes`, which copies each FILE
// ARTIFACT's own layouts, so it holds every tuple the source SPELLS and no tuple minted by SUBSTITUTION —
// `ProgramSignatures.substituteTupleThroughInstance` creates those at a CALL SITE, straight into the
// whole-program index. The parser emits the drop call either way, so the missing body is a BACKEND panic
// rather than a leak: **MEASURED, with the corpus `Map` live, `for (_, value) in m` over `["a": 10]` walks
// `MapIterator.current()`, whose declared `Entry = (Key, Value)` substitutes to `__Tuple2.String.int`, and
// the compile stops at `resolveCallFixups: call to unknown function '__destruct___Tuple2.String.int'`.** A
// plain `function pair() returns (String, Num)` in the same tree compiles and runs, which is what
// localizes it to the substituted mint rather than to tuples. The clone side's own measurement of the same
// hole is on `installStructCascades`.
//
// ⛔⛔ **A NAME THE PROJECT REGISTRY ALREADY HOLDS IS SKIPPED, AND LETTING THIS WALK OWN ALL TUPLES
// INSTEAD WAS A MEASURED REGRESSION (22 failures against 14).** The two registries are NOT two views of
// one table for a tuple: a sweep key is `(spelling, file)` and only a CANONICAL name is a whole-program
// identity, so the index can hold a layout whose elements were resolved in a different file's scope from
// the one `commitStructTypes` committed — see `ProgramSignatures`' A3v header, which records the wrong
// answer that shape already produced once. The project's entry is the authoritative resolved one wherever
// it exists; this walk supplies only what nothing committed.
function installStructRuntimeEntries(module StdModule, project Project, signatures ProgramSignatures, needed ReferencedEntrySymbols, kind StructRuntimeEntryKind)
	// ⚠⚠ **THE TWO WALKS HAND OVER LAYOUTS FROM TWO NAME SPACES, AND THE INTERNER TRAVELS WITH THE
	// LAYOUT.** A `project.structTypes` layout's field-type ids index `project.typeNames`; an INTERNED TUPLE
	// comes out of the signature index and its ids index that index's table. Resolving both against the
	// project's is OPEN #56 — see `ProgramSignatures.indexTypeNames` for the panic it produced on this
	// compiler's own source, and for why a misread that happens to land on a declared type is worse.
	for (_, layout) in project.structTypes 'each'
		installOneStructRuntimeEntry(module, layout: layout, typeNames: project.typeNames, project: project, signatures: signatures, needed: needed, kind: kind)
	end 'each'

	// ⚠ **THE SNAPSHOT IS NAMED, AND THAT IS WHAT MAKES THIS ONE STILL A `for … in`.** `tupleLayouts()`
	// BUILDS a fresh array, so this walk was always over a snapshot — but spelled inline the loop's E3070
	// subject was the chain's base, `signatures`, which `installOneStructRuntimeEntry` takes mutably. Naming
	// the snapshot moves the subject to a local nothing writes. It is NOT the index idiom the other 25 sites
	// took (⚖ ruling of 2026-08-26, canonical note at `IR/Std/ElimTrivialBlockArgs.elimTrivialBlockArgs`),
	// because the cause here is different: the array being walked is not the one being mutated.
	let internedTuples = signatures.tupleLayouts()

	for layout in internedTuples 'eachInternedTuple'
		if projectHasStructLayout(project, name: layout.name) 'committedAlready'
			continue
		end 'committedAlready'

		installOneStructRuntimeEntry(module, layout: layout, typeNames: signatures.indexTypeNames(), project: project, signatures: signatures, needed: needed, kind: kind)
	end 'eachInternedTuple'
end 'installStructRuntimeEntries'

// The one layout, under whichever entry the walk is installing. The arms below are the ONLY place the drop
// side and the two non-drop cascades part company, which is the property the shared walk exists to make
// visible.
function installOneStructRuntimeEntry(module StdModule, layout StructLayout, typeNames TypeNameInterner, project Project, signatures ProgramSignatures, needed ReferencedEntrySymbols, kind StructRuntimeEntryKind)
	match kind 'entry'
		destructor then installOneStructDestructor(module, layout: layout, typeNames: typeNames, signatures: signatures, needed: needed as DestructorSet)
		dictionaryDestructor then installOneStructDictionaryDestructor(module, layout: layout, typeNames: typeNames, signatures: signatures, needed: needed as DestructorSet)
		cloner then installOneStructCascade(module, layout: layout, typeNames: typeNames, project: project, signatures: signatures, needed: needed as CascadeSymbolSet, action: CascadeAction.clone)
		soleWalk then installOneStructCascade(module, layout: layout, typeNames: typeNames, project: project, signatures: signatures, needed: needed as CascadeSymbolSet, action: CascadeAction.soleWalk)
		shareWalk then installOneStructCascade(module, layout: layout, typeNames: typeNames, project: project, signatures: signatures, needed: needed as CascadeSymbolSet, action: CascadeAction.shareWalk)
	end 'entry'
end 'installOneStructRuntimeEntry'

// Has `ParseStaging.commitStructTypes` already committed a layout under this name? The membership half of
// the skip above, spelled as its own question because "the project registry is authoritative where it has an
// entry" is the rule, and a `try … otherwise false` inline would read as a lookup that happened to fail.
function projectHasStructLayout(project Project, name ByteArray) returns bool
	if let committed = try project.structTypes.get(name) 'found'
		return not committed.name.isEmpty()
	end 'found'

	return false
end 'projectHasStructLayout'

// One layout's cascade, or nothing when it is unreferenced or owns nothing droppable. Split out when the
// substituted-tuple walk landed (W41) so the two walks share one admission test rather than each spelling
// it — the shape where one of them comes to admit a layout the other would have declined.
function installOneStructDestructor(module StdModule, layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures, needed DestructorSet)
	if not signatures.structHasFieldOwingDrop(layout.name) 'noManaged'
		return
	end 'noManaged'

	if not needed.contains(destructorSymbol(layout.name)) 'notReferenced'
		return
	end 'notReferenced'

	synthesizeStructDestructor(module, layout: layout, typeNames: typeNames, signatures: signatures)
end 'installOneStructDestructor'

// Emit `__destruct_<Struct>(box)` — the field list is built here and the entry/lower/drop/free skeleton
// runs in the shared `emitFieldCascadeDestructor`:
//
//   drop:  drop each managed field, in declaration order, behind a NULL-guard (a moved-out field slot is
//          null), each through `managedFieldDropCallee`.
//
// A struct has NO tag — every field is always present — so the cascade drops unconditionally rather than
// under a tag switch. It shares its skeleton with the generic-instance cascade (P1.6-B2), which is the same
// tagless box shape over a substituted field list.
function synthesizeStructDestructor(module StdModule, layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures)
	var drops = ManagedFieldDropArray.create()

	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldOwesDrop(layout.name, index: i) 'scalarField'
			continue
		end 'scalarField'

		drops.push(ManagedFieldDrop.create(layout.offsetOfField(i), kind: structFieldDropKind(layout, index: i, typeNames: typeNames, signatures: signatures)))
	end 'eachField'

	emitFieldCascadeDestructor(module, symbolName: destructorSymbol(layout.name), drops: drops)
end 'synthesizeStructDestructor'

// The dictionary twin's admission (W183) — `installOneStructDestructor`'s shape with the one question that
// differs: not "does it own a managed field" (a bare parameter is not one) but "does it rest a slot at a
// parameter at all". `recordOpaqueSlotDeclaration` carries WHICH declaration's parameters; only the drop site
// has to check that, so here the presence is the whole test.
function installOneStructDictionaryDestructor(module StdModule, layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures, needed DestructorSet)
	match signatures.recordOpaqueSlotDeclaration(layout.name) 'restsASlot'
		none then return
		declaredBy then break 'restsASlot'
	end 'restsASlot'

	if not needed.contains(dictionaryDestructorSymbol(layout.name)) 'notReferenced'
		return
	end 'notReferenced'

	synthesizeStructDictionaryDestructor(module, layout: layout, typeNames: typeNames, signatures: signatures)
end 'installOneStructDictionaryDestructor'

// Emit `__destruct_dict_<Struct>(descriptor, box)` (W183) — `synthesizeStructDestructor` with the one field
// classifier that differs, exactly as `synthesizeGenericInstanceDictionaryDestructor` differs from
// `synthesizeGenericInstanceDestructor`. The skeleton (the refcount check to last owner, the null-guarded
// drops, the free) is the shared `emitFieldCascadeDestructor`, so this cascade releases at REFCOUNT ZERO like
// every other — which is what makes it safe for a record a shared frame is not the last owner of.
function synthesizeStructDictionaryDestructor(module StdModule, layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures)
	var drops = ManagedFieldDropArray.create()

	for i in 0 upto layout.fieldCount() 'eachField'
		match dictionaryStructFieldDropKind(layout, index: i, typeNames: typeNames, signatures: signatures) 'released'
			none then continue
			released(kind) then drops.push(ManagedFieldDrop.create(layout.offsetOfField(i), kind: kind))
		end 'released'
	end 'eachField'

	emitFieldCascadeDestructor(module, symbolName: dictionaryDestructorSymbol(layout.name), drops: drops, takesDescriptor: true)
end 'synthesizeStructDictionaryDestructor'

// HOW declared field `index` of a record over the enclosing parameters is released, or `none` for a field
// that owns nothing — `structFieldDropKind`'s dictionary twin, and the ONE classifier the synthesis above,
// the needs closure (`addNestedStructDictionaryDestructors`) and the runtime-bit declaration
// (`declareStructDictionaryDropNeeds`) all read. Its instance twin is `dictionaryInstanceFieldDropKind`, and
// the arm order is that one's for that one's reason: the slot at a bare parameter first, because
// `structFieldIsManaged` answers `false` for it and a managed test would skip it.
//
// ⛔⛔ **AND THE PROHIBITION ITS INSTANCE TWIN CARRIES IS THIS FUNCTION'S TOO — repeated here because THIS is
// where someone editing the declared-record cascade is typing.** A THIRD arm releasing a NESTED record
// through ITS OWN dictionary destructor at block 0 belongs in NEITHER: the record it would drop had its slots
// retained — if at all — against the parameter the NESTED type spells, while a cascade here releases them
// against the parameter they substitute to one level out, and MEASURED those disagree at exit **139** on a
// program the merge base runs at exit **0**. `dictionaryInstanceFieldDropKind`'s ⛔⛔ block carries the full
// measurement; the nested store is REFUSED instead (`Parser.requireStoredNestedViewDropIsNameable`).
//
// ⚠⚠ **THE TWO TWINS ARE A PARALLEL COPY AND NOTHING MAKES THEM AGREE.** Same three arms, same order, same
// two decisions, differing only in the accessor set and in the plain-kind fallback — and they are reached
// through DIFFERENT admission predicates (`instanceRestsARetainedSlot` against the mere presence of an opaque
// slot). Collapsing them onto one classifier over a `CascadeFieldSource{declaredStruct(layout), instance(id)}`
// is the right shape and would let the six near-identical walks share their loop; it is filed rather than
// done here because it lands in a cascade this rung had just repaired.
function dictionaryStructFieldDropKind(layout StructLayout, index FieldIndex, typeNames TypeNameInterner, signatures ProgramSignatures) returns FieldDropKindOption
	if signatures.structFieldIsOpaque(layout.name, index: index) 'aBareParameterSlot'
		return FieldDropKindOption.released(FieldDropKind.throughDescriptor(DropTypeParamName, descriptor: DictionaryDestructorDescriptorParam, blockOffset: signatures.structFieldOpaqueBlockOffset(layout.name, index: index)))
	end 'aBareParameterSlot'

	if not signatures.structFieldOwesDrop(layout.name, index: index) 'scalarField'
		return FieldDropKindOption.none
	end 'scalarField'

	return FieldDropKindOption.released(structFieldDropKind(layout, index: index, typeNames: typeNames, signatures: signatures))
end 'dictionaryStructFieldDropKind'

// HOW a payload that owes a drop is released — `structFieldDropKind`'s union twin. An interface-typed payload
// is a SERVICE REQUEST's message argument, whose witness half the request union carries in the next slot
// (`ServiceCompanions.serviceRequestPayloads`).
function payloadDropKind(signatures ProgramSignatures, typeNames TypeNameInterner, field PayloadField, class PayloadClass) returns FieldDropKind
	if payloadClassIsExistential(class) 'fatPointer'
		return FieldDropKind.existential(InterfaceWitnessHalfOffset)
	end 'fatPointer'

	return FieldDropKind.direct(managedFieldDropCallee(signatures, typeNames: typeNames, fieldType: field.declaredType))
end 'payloadDropKind'

// HOW struct field `index` is released — the `existential` kind for an interface-typed field
// (P1.7a-existentials slice 2), the statically resolved callee for every other. It is asked HERE, off the
// declared type, because the alternative is `managedFieldDropCallee` inventing a 1-argument callee for a
// slot whose destructor is a run-time fact; that function's own `interfaceRef` guard says so from the other
// side.
function structFieldDropKind(layout StructLayout, index FieldIndex, typeNames TypeNameInterner, signatures ProgramSignatures) returns FieldDropKind
	if signatures.structFieldIsExistential(layout.name, index: index) 'fatPointer'
		return FieldDropKind.existential(InterfaceWitnessHalfOffset)
	end 'fatPointer'

	return FieldDropKind.direct(managedStructFieldDropCallee(layout, index: index, typeNames: typeNames, signatures: signatures))
end 'structFieldDropKind'

// ⭐⭐ **THE PER-INSTANCE DESTRUCTOR CASCADE (P1.6-B2).** A generic instance is a monomorphized base struct
// that OWNS its managed type arguments (moved in at the concrete call site), so `__destruct_<mangled>` drops
// each SUBSTITUTED managed field then frees the box — `Box with String` drops the String, `Box with Holder`
// drops the Holder (through its own `__destruct_Holder`), `Box with (Box with String)` drops the inner box
// (through ITS instance destructor, which drops the String). The base struct's own `__destruct_Box` is NOT
// what a managed instance uses: `Box`'s shared body compiles once against opaque `T` (a borrow, dropping
// nothing), so a per-instance cascade is what makes the type-arg drop concrete. Installed for a REFERENCED
// managed instance only (like the struct/union cascades), appended already-lowered so it is never
// re-optimized. No `project` needed — the instance's every fact is answered inside `signatures`.
function synthesizeGenericInstanceDestructor(module StdModule, id GenericInstanceId, signatures ProgramSignatures)
	var drops = ManagedFieldDropArray.create()

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalarField'
			continue
		end 'scalarField'

		drops.push(ManagedFieldDrop.create(signatures.genericInstanceFieldOffset(id, index: i), kind: instanceFieldDropKind(signatures, id: id, index: i)))
	end 'eachField'

	emitFieldCascadeDestructor(module, symbolName: destructorSymbol(signatures.mangleGenericInstance(id)), drops: drops)
end 'synthesizeGenericInstanceDestructor'

// HOW substituted instance field `index` is released — `structFieldDropKind`'s instance twin, asked over the
// SUBSTITUTED type for the reason `genericInstanceFieldDropCallee` is: the two must classify one type.
//
// ⚠ It is not a formality that a type ARGUMENT can never be an existential (`checkGenericArgType` refuses
// one): the base struct's OWN interface-typed field — `type Box uses T` declaring a `var tag as Tagged`
// beside its `T` — is in this list too, and substitution leaves it exactly as declared.
function instanceFieldDropKind(signatures ProgramSignatures, id GenericInstanceId, index FieldIndex) returns FieldDropKind
	if signatures.genericInstanceFieldIsExistential(id, index: index) 'fatPointer'
		return FieldDropKind.existential(InterfaceWitnessHalfOffset)
	end 'fatPointer'

	return FieldDropKind.direct(signatures.genericInstanceFieldDropCallee(id, index: index))
end 'instanceFieldDropKind'

// ⭐ **THE PER-INSTANCE DESTRUCTOR INSTALLER (P1.6-B2)** — the generic-instance twin of
// `installStructDestructors`: synthesize `__destruct_<mangled>` for every managed instance whose destructor
// is REFERENCED (directly by a `decrefCalleeFor` scope-exit drop, or through a nested cascade
// `closeDestructorNeeds` grew the set over). Appended already-lowered after the pipeline.
export function installGenericInstanceDestructors(module StdModule, signatures ProgramSignatures, needed DestructorSet)
	for id in 0 upto signatures.genericInstanceCount() 'each'
		if not signatures.genericInstanceHasManagedField(id) 'noManaged'
			continue
		end 'noManaged'

		if not needed.contains(destructorSymbol(signatures.mangleGenericInstance(id))) 'notReferenced'
			continue
		end 'notReferenced'

		synthesizeGenericInstanceDestructor(module, id: id, signatures: signatures)
	end 'each'
end 'installGenericInstanceDestructors'

// ⭐⭐⭐ **THE DICTIONARY DESTRUCTOR CASCADE (BATCH41) — `__destruct_dict_<mangled>(descriptor, box)`, the drop
// a DECLARATION VIEW owes and no symbol could name.** `synthesizeGenericInstanceDestructor` above builds the
// cascade for a MONOMORPHIZED instance, whose every managed field has a statically resolved callee. This one
// builds it for the view a shared generic body actually holds — `BagIter with Element` inside
// `type Bag uses Element` — where the field standing at the bare parameter has no callee at all and its
// release is a WORD in the enclosing instantiation's layout descriptor.
//
// ⛔⛔ **IT EXISTS BECAUSE THE RELEASE IS A REFCOUNT FACT AND THE COMPILER HAS ONLY A STATIC ONE.** Emitting
// the release inline at the drop SITE was measured twice and is wrong in both directions: ungated it releases
// the slot of a record whose `__mm_decref` is not the last one (`generic-type-substitution`'s
// `bare-generic-name-as-a-managed-field-type` co-owns its `cell` into a field and then drops its own
// reference — six cases PANICKED at `appendTypeParamDescriptor`), and gated on `valueIsSoleHeapOwner` — the
// only predicate that says a decref is the last — it never fires on the shape it exists for
// (`generic-opaque-cursor-element`, back to three cases at exit 101). ⇒ **only the party that FREES the
// record can release what the record holds, and that party is its destructor.**
//
// ⚠ **THE FIELD SET IS THE SAME SET THE CONCRETE CASCADE DROPS, PLUS THE ONE `typeIsManaged` CANNOT SEE.** A
// concrete managed field of a declaration view (a `String`, a nested concrete instance) is dropped through
// exactly the callee `instanceFieldDropKind` gives it, so a record dropped through this cascade and the same
// record dropped through `__destruct_<Base>_<Arg>` release the identical set — which is what makes the two
// safe to coexist for one record shape: at refcount zero exactly one of them runs.
function synthesizeGenericInstanceDictionaryDestructor(module StdModule, id GenericInstanceId, signatures ProgramSignatures)
	var drops = ManagedFieldDropArray.create()

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		match dictionaryInstanceFieldDropKind(signatures, id: id, index: i) 'released'
			none then continue
			released(kind) then drops.push(ManagedFieldDrop.create(signatures.genericInstanceFieldOffset(id, index: i), kind: kind))
		end 'released'
	end 'eachField'

	emitFieldCascadeDestructor(module, symbolName: dictionaryDestructorSymbol(signatures.mangleGenericInstance(id)), drops: drops, takesDescriptor: true)
end 'synthesizeGenericInstanceDictionaryDestructor'

// HOW substituted field `index` of a declaration view is released, or `none` for a field that owns nothing —
// `instanceFieldDropKind`'s dictionary twin, and the ONE classifier the synthesis above, the needs closure
// (`addNestedInstanceDictionaryDestructors`) and the runtime-bit declaration
// (`declareInstanceDictionaryDropNeeds`) all read. Three of them asking the same question their own way is
// how a field would come to be dropped through one callee and accounted for under another.
//
// The order of the arms is the order of the questions: a slot still at a bare parameter first (it is the one
// `typeIsManaged` answers `false` for, so a managed test would skip it), then the ordinary managed field,
// then nothing.
//
// ⛔⛔ **A THIRD ARM STOOD BETWEEN THEM AND IS GONE (BATCH41 review): a NESTED DECLARATION VIEW released
// through ITS OWN dictionary destructor at block 0.** It was an over-release. The record it dropped had its
// slots RETAINED — if at all — in the nested type's own shared body, against the parameter THAT body spells,
// while this cascade releases them against the parameter they substitute to one level out; the two are
// different tokens with different instantiations, and MEASURED they disagree: exit **139** on a program the
// merge base runs at exit **0**. `kindWalksNestedInstances` carries the full measurement and the control that
// pins it. The nested store is refused instead (`Parser.requireStoredNestedViewDropIsNameable`), which is
// what the merge base did.
function dictionaryInstanceFieldDropKind(signatures ProgramSignatures, id GenericInstanceId, index FieldIndex) returns FieldDropKindOption
	if signatures.genericInstanceFieldIsOpaque(id, index: index) 'aBareParameterSlot'
		return FieldDropKindOption.released(FieldDropKind.throughDescriptor(DropTypeParamName, descriptor: DictionaryDestructorDescriptorParam, blockOffset: signatures.genericInstanceFieldOpaqueBlockOffset(id, index: index)))
	end 'aBareParameterSlot'

	if not signatures.genericInstanceFieldIsManaged(id, index: index) 'scalarField'
		return FieldDropKindOption.none
	end 'scalarField'

	return FieldDropKindOption.released(instanceFieldDropKind(signatures, id: id, index: index))
end 'dictionaryInstanceFieldDropKind'

// ⭐ **THE INSTALLER FOR THE FAMILY ABOVE** — `installGenericInstanceDestructors`' dictionary twin, gated on
// the same two questions: does this instance rest such a slot at all, and did anything REFERENCE its
// dictionary destructor (a drop site routed to it, or another cascade named it).
export function installGenericInstanceDictionaryDestructors(module StdModule, signatures ProgramSignatures, needed DestructorSet)
	for id in 0 upto signatures.genericInstanceCount() 'each'
		if not signatures.instanceRestsARetainedSlot(id) 'noRetainedSlot'
			continue
		end 'noRetainedSlot'

		if not needed.contains(dictionaryDestructorSymbol(signatures.mangleGenericInstance(id))) 'notReferenced'
			continue
		end 'notReferenced'

		synthesizeGenericInstanceDictionaryDestructor(module, id: id, signatures: signatures)
	end 'each'
end 'installGenericInstanceDictionaryDestructors'

// ⭐ **HOW ONE MANAGED SLOT IS RELEASED — the two shapes a field drop comes in.** Carried on
// `ManagedFieldDrop` so the offset and the release travel together and `emitNullGuardedDrop` decides between
// them ONCE, rather than each cascade builder deciding and then agreeing. Exported with that emitter, whose
// callers now include the async releaser's GT-struct slots.
export union FieldDropKind
	// The ordinary field: one machine word holding a managed pointer, released by a STATICALLY chosen
	// `(box) -> void` callee — `__str_decref`, `__mm_decref`, `__managed_decref`, a nested `__destruct_<T>`.
	direct(callee ByteArray)

	// ⭐ A value held at an INTERFACE TYPE: a fat pointer whose conformer — and therefore whose destructor — is
	// a RUN-TIME fact, so no static callee exists to name. The witness half at `+witnessDisplacement` from the
	// value half is loaded beside it and both go to `__drop_existential(witness, value)`, which reads the
	// table's `destroyFunc@8`. A struct field's two slots are adjacent (`IrInterface.InterfaceWitnessHalfOffset`);
	// a reply cell's are not (`GtRuntime.GtOffReplyWitness`).
	existential(witnessDisplacement ByteOffset)

	// ⭐⭐ **A field of a DECLARATION VIEW released through the DICTIONARY the cascade was handed (BATCH41)** —
	// `callee(descriptor + blockOffset, value)`. Two field shapes take it and they are one act, which is why
	// they are one arm rather than two: a slot still standing at a bare type parameter goes to
	// `__drop_type_param` at THAT parameter's block, and a slot at a nested declaration view goes to that
	// view's own `__destruct_dict_<mangled>` at block 0 — the whole descriptor, because the nested cascade
	// indexes its own blocks off the same `uses` list.
	//
	// ⚠ It carries the descriptor's `ValueId` rather than reading a well-known one, because it is a PARAMETER
	// of the cascade being emitted and nothing outside that emit knows its number.
	throughDescriptor(callee ByteArray, descriptor ValueId, blockOffset ByteOffset)
end 'FieldDropKind'

// ⭐ **A FIELD'S RELEASE, OR THAT IT HAS NONE** — the answer `dictionaryInstanceFieldDropKind` gives, where
// its concrete twin `instanceFieldDropKind` can assume its caller already filtered the scalars. The
// dictionary classifier cannot: the field it exists for is exactly the one `genericInstanceFieldIsManaged`
// answers `false` for, so the "is it released at all?" question and the "how?" question have to be settled
// together or the filter would have to know the answer before asking for it.
union FieldDropKindOption
	released(kind FieldDropKind)
	none
end 'FieldDropKindOption'

// One managed field a TAGLESS box destructor must drop: its byte offset in the box, and HOW it is released.
// The struct (P1.4a) and generic-instance (P1.6-B2) cascades each build a list of these and hand it to
// `emitFieldCascadeDestructor`, so the entry/lower/drop/free skeleton lives in ONE place.
type ManagedFieldDrop
	export let offset as ByteOffset
	export let kind as FieldDropKind

	static function create(offset ByteOffset, kind FieldDropKind) returns ManagedFieldDrop
		return Self{offset: offset, kind: kind}
	end 'create'
end 'ManagedFieldDrop'

typealias ManagedFieldDropArray = Array with ManagedFieldDrop

// Emit `<symbolName>(box)` for a TAGLESS box (a struct, or a monomorphized generic instance) — every field
// is always present, so the cascade drops each managed field unconditionally behind a null-guard (a
// moved-out slot is null and falls through), then frees the box:
//
//   entry + lower: the shared refcount RMW (`emitRefcountCheckToLastOwner`) — `rc == 0` is the last owner
//     and branches to `drop`; otherwise the count is lowered and the box kept.
//   drop:  each `drops` spec through `emitNullGuardedDrop`, then fall to `free`.
//   free:  `__mm_free(box)`; ret.
//
// A void `(i64) -> void` static-dispatch signature (the drop callee is picked statically, so there is no
// `call_indirect` type to satisfy and no `i64` return). It is the same
// skeleton the union cascade uses too, minus the tag switch — hence the shared `emitNullGuardedDrop`.
function emitFieldCascadeDestructor(module StdModule, symbolName ByteArray, drops ManagedFieldDropArray, takesDescriptor bool = false)
	let paramCount = DictionaryDestructorParamCount if takesDescriptor else PlainDestructorParamCount
	var func = IrFunction.createFromStd(symbolName, returnType: StdReturnType.void, paramCount: paramCount, paramTypes: twoI64Params() if takesDescriptor else oneI64Param(), returnLine: 0, needsGreenThreadStackGuard: true)
	var ids = ValueMinter.create(paramCount)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var lower = module.addBlock(func, label: b"lower", heat: BlockHeat.normal)
	var drop = module.addBlock(func, label: b"drop", heat: BlockHeat.normal)
	var free = module.addBlock(func, label: b"free", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: paramCount)
	let box = DictionaryDestructorBoxParam if takesDescriptor else PlainDestructorBoxParam

	emitRefcountCheckToLastOwner(module, func: func, entry: entry, lower: lower, record: box, lastOwner: drop, ids: ids)

	var cur = drop

	for spec in drops 'eachDrop'
		cur = emitNullGuardedDrop(module, cur: cur, box: box, offset: spec.offset, kind: spec.kind, ids: ids, func: func)
	end 'eachDrop'

	module.setTerminator(cur, op: StdOp.branch(free.id))

	let freed = ids.mint()
	module.appendOp(free, op: StdOp.call(freed, callee: MmFreeName, args: argsOf(box)))
	module.setTerminator(free, op: StdOp.retVoid)

	module.functions.push(func)
end 'emitFieldCascadeDestructor'

// Drop every MANAGED field of case `ci` from `startBlock`, each behind a NULL-guard (a moved-out slot is
// null and must not be decref'd as a bogus pointer), then branch to `dest`. The drop callee comes off
// `managedFieldDropCallee` — a String through `__str_decref`, a nested managed struct/union through ITS
// `__destruct_<T>`, a scalar-only struct/union box through `__mm_decref` — the SAME router the construct's
// drop routing reads, so the dropped set equals the moved-in set by construction.
function emitManagedFieldDrops(module StdModule, startBlock IrBlock, box ValueId, layout EnumLayout, ci CaseIndex, dest IrBlock, project Project, signatures ProgramSignatures, ids ValueMinter, func IrFunction)
	let payloads = layout.payloadsAt(ci)
	var cur = startBlock

	for fi in 0 upto payloads.count() 'eachField'
		let field = try payloads.get(fi) otherwise panic("emitManagedFieldDrops: payloadsAt count disagrees with get at {fi}")
		let class = classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)

		if not payloadClassOwesDrop(class) 'scalarField'
			continue
		end 'scalarField'

		cur = emitNullGuardedDrop(module, cur: cur, box: box, offset: layout.payloadSlotOffset(fi), kind: payloadDropKind(signatures, typeNames: project.typeNames, field: field, class: class), ids: ids, func: func)
	end 'eachField'

	module.setTerminator(cur, op: StdOp.branch(dest.id))
end 'emitManagedFieldDrops'

// Load the managed pointer at `box + offset`, and if it is non-null release it as `kind` says — the one
// null-guarded field-drop shape both the union tag-case cascade and the struct cascade emit, so the
// load/compare/branch geometry lives in ONE place. Returns the CONTINUATION block (where the caller
// resumes): a moved-out (null) slot skips the drop and falls straight through.
//
// ⚠ **THE NULL GUARD IS ON THE VALUE HALF FOR BOTH KINDS**, which is what an existential wants too: a
// moved-out existential slot is null exactly as a moved-out pointer slot is, and its witness half is then
// stale rather than merely unread. The witness load therefore sits INSIDE the drop block, where the value
// is already known live.
//
// ⭐ **`box` IS ANY BASE ADDRESS, NOT ONLY A MANAGED BOX**, which is why `Runtime/AsyncReleaser.maxon`'s
// per-callee releaser emits its argument / result / error drops through here over a GT STRUCT: the shape it
// needs — load at `base + offset`, drop it if non-null, continue — is this one exactly, and a second
// emitter there would be a copy nothing forces to agree with this one (a wild free or a leak, and a
// compile error at neither site).
export function emitNullGuardedDrop(module StdModule, cur IrBlock, box ValueId, offset ByteOffset, kind FieldDropKind, ids ValueMinter, func IrFunction) returns IrBlock
	let ptr = ids.mint()
	module.appendOp(cur, op: StdOp.loadIndirect(ptr, addrId: box, offset: offset, valueType: StdType.i64))
	let zero = ids.mint()
	module.appendOp(cur, op: StdOp.const(zero, value: 0, valueType: StdType.i64))
	let nonNull = ids.mint()
	module.appendOp(cur, op: StdOp.cmp(nonNull, lhs: ptr, rhs: zero, pred: StdCmpPred.ne, operandType: StdType.i64))
	var dropBlock = module.addBlock(func, label: b"decref", heat: BlockHeat.normal)
	let contBlock = module.addBlock(func, label: b"cont", heat: BlockHeat.normal)
	module.setTerminator(cur, op: StdOp.condBranch(nonNull, thenBlockId: dropBlock.id, elseBlockId: contBlock.id))

	let dropped = ids.mint()

	match kind 'k'
		direct(callee) then module.appendOp(dropBlock, op: StdOp.call(dropped, callee: callee, args: argsOf(ptr)))
		existential(witnessDisplacement) then emitExistentialFieldDrop(module, block: dropBlock, box: box, witnessOffset: offset + witnessDisplacement, value: ptr, dropped: dropped, ids: ids)
		throughDescriptor(callee, descriptor, blockOffset) then emitDictionaryFieldDrop(module, block: dropBlock, callee: callee, descriptor: descriptor, blockOffset: blockOffset, value: ptr, dropped: dropped, ids: ids)
	end 'k'

	module.setTerminator(dropBlock, op: StdOp.branch(contBlock.id))

	return contBlock
end 'emitNullGuardedDrop'

// Load the WITNESS half beside an already-live value half and release the pair through
// `__drop_existential(witness, value)` (P1.7a-existentials slice 2). Its own function because a `match` arm
// carries one statement and this shape is two; `dropped` is the caller's result slot, so the two kinds mint
// exactly one apiece.
function emitExistentialFieldDrop(module StdModule, block IrBlock, box ValueId, witnessOffset ByteOffset, value ValueId, dropped ValueId, ids ValueMinter)
	let witness = ids.mint()
	module.appendOp(block, op: StdOp.loadIndirect(witness, addrId: box, offset: witnessOffset, valueType: StdType.i64))
	module.appendOp(block, op: StdOp.call(dropped, callee: DropExistentialName, args: twoArgs(witness, second: value)))
end 'emitExistentialFieldDrop'

// Release an already-live field value through the dictionary the cascade was handed —
// `callee(descriptor + blockOffset, value)`. Block 0 IS the descriptor, so a single-parameter enclosing
// instance emits no arithmetic at all, exactly as `LowerMaxonToStd.descriptorBlockAddr` does not for its own
// callers: the two are the same address computation at the two tiers, and they agree because both spell it
// as "add the block offset, unless it is zero".
function emitDictionaryFieldDrop(module StdModule, block IrBlock, callee ByteArray, descriptor ValueId, blockOffset ByteOffset, value ValueId, dropped ValueId, ids ValueMinter)
	if blockOffset == 0 'theFirstBlockIsTheDescriptor'
		module.appendOp(block, op: StdOp.call(dropped, callee: callee, args: twoArgs(descriptor, second: value)))
		return
	end 'theFirstBlockIsTheDescriptor'

	let offsetConst = ids.mint()
	module.appendOp(block, op: StdOp.const(offsetConst, value: blockOffset as ParsedInt, valueType: StdType.i64))
	let blockAddr = ids.mint()
	module.appendOp(block, op: StdOp.binOp(blockAddr, lhs: descriptor, rhs: offsetConst, opcode: StdBinOpcode.add, operandType: StdType.i64))
	module.appendOp(block, op: StdOp.call(dropped, callee: callee, args: twoArgs(blockAddr, second: value)))
end 'emitDictionaryFieldDrop'

// --- The per-type cascades, the deep cloner and the two walks: the destructor cascade's dual ---

// Close what `action`'s referenced entries transitively need; the twin of `noteDestructorUsage`. A
// `__clone_<Struct>` calls `__str_clone` for a String field, a nested struct's or union's own
// `__clone_<T>`, and `__managed_clone`/`__managed_clone_managed` for an Array field, all inside a
// synthesized body the Maxon-module scan cannot see. So this closes the needed set over that
// nesting and turns on the transitive `usesStrClone`, `usesManagedMemory`, `usesManagedElementCopy`
// and `usesHeap` bits.
//
// Called after `scanRuntimeUsage`, which seeds `neededCloners` from the `funcAddr(__clone_<T>)`
// element-cloner stamps, and before `.data` layout reads `usesHeap` and `installStringRuntime`
// reads `usesStrClone`. `noteRelocatedFunctionUsage` re-enters it when the stamps lowering makes
// grow the set.
export function noteCascadeUsage(usage RuntimeUsage, project Project, signatures ProgramSignatures, action CascadeAction)
	// Most programs reference no cascade, and an empty set can only stay empty, so the per-type
	// symbol allocations below are paid only by a program that deep-clones or hands a graph to a
	// green thread.
	if cascadeNeededSet(usage, action: action).count() == 0 'noneReferenced'
		return
	end 'noneReferenced'

	// Closed by the shared `CascadeWorklist`, the engine that closes the drop dual
	// (`closeDestructorNeeds`), so each referenced node is expanded once. A `while changed` re-scan of
	// every declared type would be quadratic in the depth of a cascade chain.
	//
	// The node space is the drop side's exactly: a generic instance has a `__clone_<mangled>` beside
	// its `__destruct_<mangled>`, so the drain's instance arm is reachable here.
	var work = CascadeWorklist.create()

	for (_, layout) in project.structTypes 'eachStruct'
		work.register(perTypeCascadeSymbol(action, typeName: layout.name), node: CascadeNode.declaredStruct(layout))
	end 'eachStruct'

	for (_, layout) in project.enumTypes 'eachUnion'
		work.register(perTypeCascadeSymbol(action, typeName: layout.name), node: CascadeNode.declaredUnion(layout))
	end 'eachUnion'

	// The instance node space is registered under the symbol-key discipline the drop side states at
	// `closeDestructorNeeds`: a declaration and an instance cannot mint one symbol
	// (`reservedIfDeclared`), and two instances that do are E3006 and fail the build before this runs.
	for id in 0 upto signatures.genericInstanceCount() 'eachInstance'
		work.register(perTypeCascadeSymbol(action, typeName: signatures.mangleGenericInstance(id)), node: CascadeNode.genericInstance(id))
	end 'eachInstance'

	work.seed(cascadeNeededSet(usage, action: action))

	// Every cloner allocates a fresh box, so one referenced cloner anywhere means the program touches
	// the heap — a fact about the queue being non-empty, not about any single node in it. A walk
	// declares nothing here: its visit table's heap is declared by every `__mm_walk_settle` call, and
	// the entries it calls are recorded through `recordCallUsage` as the drain below reaches them.
	if action == CascadeAction.clone and work.hasPending() 'anyClonerReferenced'
		usage.usesHeap = true
	end 'anyClonerReferenced'

	while work.hasPending() 'drain'
		let node = work.take()

		match node 'node'
			declaredStruct(layout) then noteStructCascadeNeeds(usage, layout: layout, project: project, signatures: signatures, work: work, action: action)
			declaredUnion(layout) then noteUnionCascadeNeeds(usage, layout: layout, project: project, signatures: signatures, work: work, action: action)
			genericInstance(id) then noteInstanceCascadeNeeds(usage, id: id, signatures: signatures, work: work, action: action)

			// A dictionary node names a drop cascade and no cloner, so the clone closure has nothing to
			// expand through either. They are registered by the shared node space rather than by either
			// driver, so this arm is where that is said: a `declaredStruct`/`genericInstance` fallthrough
			// would give the same layout's clone needs a second, redundant expansion. Each variant is named
			// rather than spanned by a range, so a new variant is an unhandled case the compiler refuses.
			declaredStructDictionary or
				genericInstanceDictionary then continue
		end 'node'
	end 'drain'
end 'noteCascadeUsage'

// The needed-SYMBOL set `action` grows and this closure reads. READ-ONLY here: the insert is
// `recordCallUsage`'s, which routes a callee to its own family's set by prefix, so this selector cannot
// become a second place a symbol is filed.
function cascadeNeededSet(usage RuntimeUsage, action CascadeAction) returns CascadeSymbolSet
	return match action 'action'
		clone gives usage.neededCloners as CascadeSymbolSet
		soleWalk gives usage.neededSoleWalks as CascadeSymbolSet
		shareWalk gives usage.neededShareWalks as CascadeSymbolSet
	end 'action'
end 'cascadeNeededSet'

// The symbol prefix `action`'s per-type entries wear — what tells a NESTED cascade callee apart from a leaf
// (`__str_clone`, `__managed_sole`), which names no node in this graph.
function cascadeSymbolPrefix(action CascadeAction) returns ByteArray
	return match action 'action'
		clone gives ClonerPrefix
		soleWalk gives SoleWalkPrefix
		shareWalk gives ShareWalkPrefix
	end 'action'
end 'cascadeSymbolPrefix'

// ⭐ **INSTALL EVERY REFERENCED PER-TYPE ENTRY FOR ONE NON-DROP ACTION** — the union, struct and instance
// installers over the one needed set `action` reads, so the three families cannot be installed from three
// different sets.
export function installCascades(module StdModule, project Project, signatures ProgramSignatures, usage RuntimeUsage, action CascadeAction)
	let needed = cascadeNeededSet(usage, action: action)
	installUnionCascades(module, project: project, signatures: signatures, needed: needed, action: action)
	installStructCascades(module, project: project, signatures: signatures, needed: needed, action: action)
	installGenericInstanceCascades(module, project: project, signatures: signatures, needed: needed, action: action)
end 'installCascades'

// ⭐ The GENERIC-INSTANCE twin of `noteStructCascadeNeeds` (W162) — over each SUBSTITUTED managed field, and
// the exact clone dual of `addNestedInstanceDestructors`. It needs no `project`: every fact about an instance
// is answered inside `signatures`, over `signatures`' own interner.
//
// ⚠ The no-layout early-out is this walk's precondition, exactly as it is the drop twin's: a node is expanded
// as soon as its SYMBOL is needed, and the field walk reads a base struct a layout-less instance does not have.
// Nothing is lost by returning — `instanceCascadeStrategy` refuses such an instance at the same tier, so no
// referenced `__clone_<mangled>` can name one. ⭐ The ONE exception is the arm below it: the two
// element-bearing records are layout-less and DO have a cloner, so they are taken before that early-out
// rather than exempted from it.
function noteInstanceCascadeNeeds(usage RuntimeUsage, id GenericInstanceId, signatures ProgramSignatures, work CascadeWorklist, action CascadeAction)
	// ⭐ **A MANAGED-ELEMENT RECORD'S `__clone_<mangled>` IS THE ONE-ARGUMENT THUNK (G18), NOT A FIELD CASCADE.**
	// It has no field list to walk — it has no base layout at all — and its whole body is the container's own
	// 2-argument per-element copy, so its needs are exactly that FIELD-position strategy's: the container entry
	// (`__managed_clone_managed` / `__list_clone_managed`) and the ELEMENT's own cloner, which may itself be
	// another thunk one level down. Rooted through the shared `noteFieldCascadeNeeds` so the closure and
	// `synthesizeElementRecordCloner` read one strategy.
	if signatures.isManagedElementRecordInstance(id) 'theOneArgumentThunk'
		noteFieldCascadeNeeds(usage, strategy: signatures.elementRecordFieldCascadeStrategy(id, action: action), work: work, action: action)
		return
	end 'theOneArgumentThunk'

	if not signatures.genericInstanceHasBaseLayout(id) 'noSynthesizedCloner'
		return
	end 'noSynthesizedCloner'

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'

		noteFieldCascadeNeeds(usage, strategy: signatures.genericInstanceFieldCascadeStrategy(id, index: i, action: action), work: work, action: action)
	end 'eachField'
end 'noteInstanceCascadeNeeds'

// Turn on the transitive bits (and grow `neededCloners`) for every managed field of struct `layout`'s cloner,
// queueing each newly-needed cloner on `work` so its OWN nesting is closed in turn.
function noteStructCascadeNeeds(usage RuntimeUsage, layout StructLayout, project Project, signatures ProgramSignatures, work CascadeWorklist, action CascadeAction)
	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'

		let fieldType = try layout.fieldTypes.get(i) otherwise panic("noteStructCascadeNeeds: fieldTypes.get OOB at {i}")
		noteFieldCascadeNeeds(usage, strategy: managedFieldCascadeStrategy(signatures, typeNames: project.typeNames, fieldType: fieldType, asElement: false, action: action), work: work, action: action)
	end 'eachField'
end 'noteStructCascadeNeeds'

// The union twin of `noteStructCascadeNeeds` — over each managed payload of each case.
function noteUnionCascadeNeeds(usage RuntimeUsage, layout EnumLayout, project Project, signatures ProgramSignatures, work CascadeWorklist, action CascadeAction)
	for ci in 0 upto layout.caseCount() 'eachCase'
		let payloads = layout.payloadsAt(ci)

		for fi in 0 upto payloads.count() 'eachField'
			let field = try payloads.get(fi) otherwise panic("noteUnionCascadeNeeds: payloadsAt count disagrees with get at {fi}")

			if not payloadClassIsManaged(classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)) 'scalar'
				continue
			end 'scalar'

			noteFieldCascadeNeeds(usage, strategy: managedFieldCascadeStrategy(signatures, typeNames: project.typeNames, fieldType: field.declaredType, asElement: false, action: action), work: work, action: action)
		end 'eachField'
	end 'eachCase'
end 'noteUnionCascadeNeeds'

// Turn on the bits a managed field's clone STRATEGY needs, inserting a nested cloner into `neededCloners`.
function noteFieldCascadeNeeds(usage RuntimeUsage, strategy ManagedCascadeStrategy, work CascadeWorklist, action CascadeAction)
	match strategy 'strategy'
		direct(callee) then noteCascadeCalleeNeeds(usage, callee: callee, work: work, action: action)
		managedElements(containerEntry, elementEntry) then noteManagedElementsFieldNeeds(usage, containerEntry: containerEntry, elementEntry: elementEntry, work: work, action: action)

		// The conformer walks the entry calls through are named by witness-table relocations, which
		// `noteRelocatedFunctionUsage` roots; the entry itself is all this field adds.
		throughWitness(entry) then recordCallUsage(entry, usage: usage)
		unsupported then panic("noteFieldCascadeNeeds: an unsupported managed field strategy reached a cascade-needs closure — arrayElementSupportsDeepClone gates the front end for both actions, because the strategy's `unsupported` arms are action-independent")
	end 'strategy'
end 'noteFieldCascadeNeeds'

// A managed-element CONTAINER field clones through `containerClone(field, funcAddr(elementClone))` — route BOTH
// callees the synthesized cloner body will emit through the ONE usage map, so their bits are exactly a direct
// scan of those calls (no second spelling of "__managed_clone_managed → usesManagedElementCopy", and none of
// "__list_clone_managed → usesList" either — W173).
function noteManagedElementsFieldNeeds(usage RuntimeUsage, containerEntry ByteArray, elementEntry ByteArray, work CascadeWorklist, action CascadeAction)
	recordCallUsage(containerEntry, usage: usage)
	noteCascadeCalleeNeeds(usage, callee: elementEntry, work: work, action: action)
end 'noteManagedElementsFieldNeeds'

// A single `(box) -> newBox` clone callee the synthesized cloner will CALL: its usage bits are exactly what a
// direct scan of that call records, so route through `recordCallUsage` — THE ONE callee→bit map — rather than
// restating "__str_clone → usesStrClone+copy, __managed_clone → usesManagedMemory, __clone_<T> → neededCloners". A nested
// `__clone_<T>` that is NEWLY joined to `neededCloners` is announced to `work`, which queues the declaration
// that symbol names; announcing exactly on the newly-added edge is what makes the closure O(types + fields).
// The leaf callees (`__str_clone`, `__managed_clone`) name no cascade node and announce nothing.
function noteCascadeCalleeNeeds(usage RuntimeUsage, callee ByteArray, work CascadeWorklist, action CascadeAction)
	let grew = bytesStartWith(callee, prefix: cascadeSymbolPrefix(action)) and not cascadeNeededSet(usage, action: action).contains(callee)
	recordCallUsage(callee, usage: usage)

	if grew 'newlyNeeded'
		work.discovered(callee)
	end 'newlyNeeded'
end 'noteCascadeCalleeNeeds'

// ⭐ **THE PER-STRUCT CASCADE INSTALLER for either non-drop action** — the twin of `installStructDestructors`.
// Synthesize `__clone_<Struct>` / `__sole_<Struct>` for every struct whose entry is REFERENCED (directly by an
// element stamp or a transfer door's call, or through a nested cascade `noteCascadeUsage` grew the set over).
// Unlike the destructor installer there is NO managed-field gate: a scalar-only struct box still needs a
// fresh-box clone (the drop side's `__mm_decref` has no clone analogue) and still has an owner count to prove.
// Appended already-lowered after the pipeline, like the destructor cascades.
function installStructCascades(module StdModule, project Project, signatures ProgramSignatures, needed CascadeSymbolSet, action CascadeAction)
	if needed.count() == 0 'noneReferenced'
		return
	end 'noneReferenced'

	// ⭐⭐ **THE TUPLES ARE IN THE ROSTER, AND THEY WERE MISSING (W180).** `project.structTypes` carries every
	// tuple the source SPELLS and no tuple minted by SUBSTITUTION, because
	// `ProgramSignatures.substituteTupleThroughInstance` creates those at a CALL SITE straight into the
	// whole-program index. The drop side gained the index walk at W41 off a MEASURED backend panic; the clone
	// side kept a one-registry walk, so the two installers' key spaces differed and a `copyFunc@32` stamp could
	// name a cloner in neither. **MEASURED**: with the corpus `Map` live, `for e in ["a": "x"]` binds the
	// substituted `__Tuple2.String.String`, `let arr = [e]` infers an `Array` of it and `arr.clone()` stamped
	// `__clone___Tuple2.String.String` — `bakeFuncAbs64Relocs: … it was never installed`, on a program holding
	// no `typealias` at all. A drop and a clone that disagree about which layouts exist is the same defect
	// twice — so the roster is `installStructRuntimeEntries`, derived once, and neither side can grow a
	// registry the other does not see.
	installStructRuntimeEntries(module, project: project, signatures: signatures, needed: needed as ReferencedEntrySymbols, kind: structEntryKindOf(action))
end 'installStructCascades'

// Which entry of the shared struct roster `action` installs. The roster is walked once per KIND, so the two
// non-drop actions are two kinds over one walk rather than two walks.
function structEntryKindOf(action CascadeAction) returns StructRuntimeEntryKind
	return match action 'action'
		clone gives StructRuntimeEntryKind.cloner
		soleWalk gives StructRuntimeEntryKind.soleWalk
		shareWalk gives StructRuntimeEntryKind.shareWalk
	end 'action'
end 'structEntryKindOf'

// One admission test for both of `installStructRuntimeEntries`' walks and every non-drop action: an
// installer that admitted a layout another declined would let a strategy name a symbol nobody
// builds. It has no managed-field gate, unlike `installOneStructDestructor`: a scalar-only box
// still needs a fresh-box clone, because a clone must allocate where a trivial drop is just
// `__mm_decref`.
function installOneStructCascade(module StdModule, layout StructLayout, typeNames TypeNameInterner, project Project, signatures ProgramSignatures, needed CascadeSymbolSet, action CascadeAction)
	if not needed.contains(perTypeCascadeSymbol(action, typeName: layout.name)) 'notReferenced'
		return
	end 'notReferenced'

	module.spans.current = sourceSpanOf(project, filePath: layout.declFilePath, line: layout.declLine, column: layout.declColumn)
	synthesizeStructCascade(module, layout: layout, typeNames: typeNames, project: project, signatures: signatures, action: action)
	module.spans.current = NoSpanId
end 'installOneStructCascade'

function installUnionCascades(module StdModule, project Project, signatures ProgramSignatures, needed CascadeSymbolSet, action CascadeAction)
	if needed.count() == 0 'noneReferenced'
		return
	end 'noneReferenced'

	for (_, layout) in project.enumTypes 'each'
		if needed.contains(perTypeCascadeSymbol(action, typeName: layout.name)) 'referenced'
			module.spans.current = sourceSpanOf(project, filePath: layout.declFilePath, line: layout.declLine, column: layout.declColumn)
			synthesizeUnionCascade(module, layout: layout, project: project, signatures: signatures, action: action)
			module.spans.current = NoSpanId
		end 'referenced'
	end 'each'
end 'installUnionCascades'

// ⭐ **THE PER-INSTANCE CASCADE INSTALLER (W162)** — the twin of `installGenericInstanceDestructors`, and
// `installStructCascades`' instance twin. Synthesize `__clone_<mangled>` / `__sole_<mangled>` for every
// instance whose entry is REFERENCED (directly by an element stamp in a layout descriptor's `copyFunc@32` or
// by a transfer door's call, or through a nested cascade `noteCascadeUsage` grew the set over). Like the
// struct installer there is NO managed-field gate — a scalar-only instance box still needs a fresh-box clone
// and still has an owner count — but the base-layout gate IS one: a layout-less instance has no field list to
// cascade over, which `declaredInstanceSupportsDeepClone` refuses at the front end for BOTH actions.
function installGenericInstanceCascades(module StdModule, project Project, signatures ProgramSignatures, needed CascadeSymbolSet, action CascadeAction)
	if needed.count() == 0 'noneReferenced'
		return
	end 'noneReferenced'

	for id in 0 upto signatures.genericInstanceCount() 'each'
		// ⭐ **A MANAGED-ELEMENT RECORD HAS NO BASE LAYOUT AND STILL HAS AN ENTRY (G18)** — the one-argument
		// thunk, which is why the layout gate is a disjunct here rather than the loop's first word. Asked once
		// and reused below, so the roster and the routing read one answer.
		let isElementRecordThunk = signatures.isManagedElementRecordInstance(id)

		if not (isElementRecordThunk or signatures.genericInstanceHasBaseLayout(id)) 'noSynthesizedCascade'
			continue
		end 'noSynthesizedCascade'

		if not needed.contains(perTypeCascadeSymbol(action, typeName: signatures.mangleGenericInstance(id))) 'notReferenced'
			continue
		end 'notReferenced'

		if isElementRecordThunk 'theOneArgumentThunk'
			synthesizeElementRecordCascade(module, id: id, signatures: signatures, action: action)
			continue
		end 'theOneArgumentThunk'

		synthesizeGenericInstanceCascade(module, id: id, project: project, signatures: signatures, action: action)
	end 'each'
end 'installGenericInstanceCascades'

// ⭐⭐ **THE ONE-ARGUMENT ELEMENT-CLONER THUNK FOR A MANAGED-ELEMENT RECORD (G18)** — what makes
// `Array with (Array with String)` copyable at all. The record's copy is a 2-argument
// `<containerClone>(box, funcAddr(elementClone))`, and an ARRAY ELEMENT is invoked through
// `callIndirect(fn, elem)`, which passes exactly one. So the element's stamped `copyFunc@32` is this
// `(box) -> newBox` whose entire body is that call — the arity adapter, and nothing else.
//
// ⚠ **IT IS NOT A `emitFieldCascadeCloner` AND MUST NOT BECOME ONE.** That skeleton allocates a fresh box and
// BLITS the source's words before deep-cloning each managed field, which is right for a tagless box whose
// scalar fields must survive the copy. An element-bearing record has no field list and no base layout: the
// container entry it calls does its own `__managed_create`/`__list_create` and returns a full OWNER, so a blit
// here would duplicate a record header nobody owns and hand the result a second buffer pointer.
//
// ⚠ **NO NULL GUARD, DELIBERATELY.** The per-field cloner needs one because a moved-out slot holds 0
// (`emitManagedFieldCascade`); this thunk is reached only from `emitElementCloneRange`, which does the identical
// test one level up and never `callIndirect`s a null element. A second guard here would be a copy of that
// fact, and the copy is what would go stale.
//
// The strategy is `elementRecordFieldCascadeStrategy` — the SAME answer the needs closure rooted — emitted
// through the SAME `emitCloneCall` a struct field takes, so the two entry points of one operation cannot come
// to copy differently.
function synthesizeElementRecordCloner(module StdModule, id GenericInstanceId, signatures ProgramSignatures)
	var func = IrFunction.createFromStd(clonerSymbol(signatures.mangleGenericInstance(id)), returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0, needsGreenThreadStackGuard: true)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	let newBox = emitCloneCall(module, block: entry, oldPtr: src, strategy: signatures.elementRecordFieldCascadeStrategy(id, action: CascadeAction.clone), ids: ids)
	module.setTerminator(entry, op: StdOp.ret(newBox))
	module.functions.push(func)
end 'synthesizeElementRecordCloner'

// One managed field a TAGLESS box cloner must deep-copy: its byte offset in the box, and HOW it is copied.
// `ManagedFieldDrop`'s clone dual, and it exists for that one's reason — the struct (P1.7 slice 3b-vi-b) and
// generic-instance (W162) cloners each build a list of these and hand it to `emitFieldCascadeCloner`, so the
// alloc/blit/clone/ret skeleton lives in ONE place rather than once per shape of field list.
type ManagedFieldCascade
	export let offset as ByteOffset
	export let strategy as ManagedCascadeStrategy

	static function create(offset ByteOffset, strategy ManagedCascadeStrategy) returns ManagedFieldCascade
		return Self{offset: offset, strategy: strategy}
	end 'create'
end 'ManagedFieldCascade'

typealias ManagedFieldCascadeArray = Array with ManagedFieldCascade

// Emit `<symbolName>(src) -> newBox` for a TAGLESS box (a struct, or a monomorphized generic instance):
// `__mm_alloc` a fresh box, BLIT the whole record (every scalar field copied for free), then DEEP-CLONE each
// managed field in place — the blit's shallow pointer is replaced by an independent copy through the field's
// `ManagedCascadeStrategy`. A tagless box has no case discriminant, so every field is always present; the
// per-field null-guard (`emitManagedFieldCascade`) skips a moved-out (null) slot exactly as the destructor
// cascade's null-guard does. `emitFieldCascadeDestructor`'s dual, minus the refcount check: a clone never
// frees, it always allocates.
function emitFieldCascadeCloner(module StdModule, symbolName ByteArray, boxSize ByteOffset, tagName ByteArray, clones ManagedFieldCascadeArray, project Project)
	var func = IrFunction.createFromStd(symbolName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0, needsGreenThreadStackGuard: true)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	let size = emitConst(module, block: entry, value: boxSize as ParsedInt, ids: ids)
	let zeroDtor = emitConst(module, block: entry, value: TrivialElementDestroy, ids: ids)
	let newBox = ids.mint()
	emitMmAllocCall(module, block: entry, result: newBox, size: size, destructor: zeroDtor, tag: userTagIndex(project.globalData, name: tagName, debugStream: module.debugStream), ids: ids)
	var copied = emitForwardCopy(module, func: func, cur: entry, dest: newBox, src: src, byteCount: size, ids: ids)
	var cur = CascadeCursor.create(copied, carried: ValueIdArray.create())

	for spec in clones 'eachField'
		cur = emitManagedFieldCascade(module, func: func, cur: cur, box: newBox, offset: spec.offset, strategy: spec.strategy, action: CascadeAction.clone, ids: ids)
	end 'eachField'

	module.setTerminator(cur.block, op: StdOp.ret(newBox))
	module.functions.push(func)
end 'emitFieldCascadeCloner'

// ⭐⭐ **WHICH FIELDS OF DECLARED STRUCT `layout` A CASCADE VISITS, AND HOW — ONE DERIVATION FOR EVERY
// ACTION.** Resolved through the shared `managedFieldCascadeStrategy` over `project.typeNames`, the ONE
// interner that layout's field-type ids live in. Written once because the LIST is the thing that must not
// diverge: a field a clone deep-copies and a soleness walk skipped would be a co-owned record crossing to
// another green thread with nothing that reads as a bug at either site.
function structManagedFieldCascades(layout StructLayout, typeNames TypeNameInterner, signatures ProgramSignatures, action CascadeAction) returns ManagedFieldCascadeArray
	var specs = ManagedFieldCascadeArray.create()

	for i in 0 upto layout.fieldCount() 'eachField'
		if not signatures.structFieldIsManaged(layout.name, index: i) 'scalar'
			continue
		end 'scalar'

		let fieldType = try layout.fieldTypes.get(i) otherwise panic("structManagedFieldCascades: fieldTypes.get OOB at {i}")
		specs.push(ManagedFieldCascade.create(layout.offsetOfField(i), strategy: managedFieldCascadeStrategy(signatures, typeNames: typeNames, fieldType: fieldType, asElement: false, action: action)))
	end 'eachField'

	return specs
end 'structManagedFieldCascades'

// The instance twin of `structManagedFieldCascades`, over each SUBSTITUTED managed field. It needs no
// `project`: every fact about an instance is answered inside `signatures`, over `signatures`' own interner.
function instanceManagedFieldCascades(id GenericInstanceId, signatures ProgramSignatures, action CascadeAction) returns ManagedFieldCascadeArray
	var specs = ManagedFieldCascadeArray.create()

	for i in 0 upto signatures.genericInstanceFieldCount(id) 'eachField'
		if not signatures.genericInstanceFieldIsManaged(id, index: i) 'scalar'
			continue
		end 'scalar'

		specs.push(ManagedFieldCascade.create(signatures.genericInstanceFieldOffset(id, index: i), strategy: signatures.genericInstanceFieldCascadeStrategy(id, index: i, action: action)))
	end 'eachField'

	return specs
end 'instanceManagedFieldCascades'

// One declared struct's cascade for `action`, over the shared field list above.
function synthesizeStructCascade(module StdModule, layout StructLayout, typeNames TypeNameInterner, project Project, signatures ProgramSignatures, action CascadeAction)
	let specs = structManagedFieldCascades(layout, typeNames: typeNames, signatures: signatures, action: action)

	match action 'action'
		clone then emitFieldCascadeCloner(module, symbolName: clonerSymbol(layout.name), boxSize: layout.sizeBytes(), tagName: layout.name, clones: specs, project: project)
		soleWalk or
			shareWalk then emitFieldCascadeWalk(module, symbolName: perTypeCascadeSymbol(action, typeName: layout.name), walks: specs, action: action)
	end 'action'
end 'synthesizeStructCascade'

// ⭐⭐ **THE PER-INSTANCE DEEP-CLONER CASCADE (W162)** — the exact clone dual of
// `synthesizeGenericInstanceDestructor`, and the same relationship to `synthesizeStructCascade` that one has to
// `synthesizeStructDestructor`. A generic instance is a monomorphized base struct that OWNS its managed type
// arguments, so `__clone_<mangled>` allocates a fresh box of the BASE's size and deep-clones each SUBSTITUTED
// managed field — `Box with String` clones the String, `Box with Holder` clones the Holder (through its own
// `__clone_Holder`), `Box with (Box with String)` clones the inner box through ITS instance cloner. The base
// struct's own `__clone_Box` is NOT what a managed instance uses: `Box`'s shared body compiles once against
// opaque `T`, so a per-instance cascade is what makes the type-arg clone concrete.
//
// ⭐⭐ **AN INSTANCE OVER THE *ENCLOSING* BODY'S OWN TYPE PARAMETER (`Box with Element` inside
// `Bag uses Element`) CLONES AS A PURE BLIT, AND THAT IS BALANCED AGAINST WHAT THE DROP SIDE ACTUALLY DOES.**
// Its substituted `v` is a bare `typeParameter`, which `typeIsManaged` classifies scalar — so this walk emits
// NO field clone, exactly as `synthesizeGenericInstanceDestructor` emits no field drop and
// `genericInstanceBoxDropCallee` answers the trivial `__mm_decref`.
//
// ⚠ **WHAT MAKES THAT SAFE IS THAT BOTH SIDES ARE NO-OPS ON `v` — NOT THAT SOMETHING ELSE OWNS IT. READ THE
// EMITTED CODE BEFORE BUILDING ON THIS NOTE.** It first credited the balance to the enclosing instance's
// layout-descriptor protocol (`retainFunc@64` / `destroyFunc@40`), and that is NOT what this shape emits.
// MEASURED at W162's review with `--emit-ir-runtime` on `Bag with String`: `Bag.create` builds the element
// array as `__managed_create(8, __mm_decref)`, `Box.create` allocates each element box with a ZERO
// destructor, and `__clone_Box_T<hash>` is `__mm_alloc` + blit with no incref — so `v` is neither retained on
// the way in nor released on the way out, on EITHER side. The clone therefore takes no reference and frees
// none, which is why it can neither leak nor double-free. It is admissible for exactly that reason and for no
// stronger one.
//
// ⛔ The other half of that measurement is a PRE-EXISTING hole this rung neither opened nor widens: the
// enclosing body BORROWS the element it stores. A `Bag with String` whose caller's `String` dies before the
// read SEGFAULTS (139) — and it segfaults identically on a program with no
// cloner in it at all — so it belongs to the opaque type-parameter ownership protocol, not to this cascade.
// A leak check cannot settle it either way here: the spec case's payload is an `.rdata` literal, and
// `specs/generic-instance-clone.md` records that `e.v` cannot be read from outside the shared body.
//
// The MM tag is the instance's own mangled name, so a cloned box decodes in `MXDS_TAGS` as the instance it is
// — the same name `__mm_alloc` interns at the concrete construction site.
//
// ⚠ The two WALK arms emit nothing for a field standing at the ENCLOSING body's own type parameter: the
// substituted type is one `typeIsManaged` classifies scalar, so the shared field list above leaves it out —
// exactly as the clone emits no field copy and the destructor no field drop.
function synthesizeGenericInstanceCascade(module StdModule, id GenericInstanceId, project Project, signatures ProgramSignatures, action CascadeAction)
	let specs = instanceManagedFieldCascades(id, signatures: signatures, action: action)
	let mangled = signatures.mangleGenericInstance(id)

	match action 'action'
		clone then emitFieldCascadeCloner(module, symbolName: clonerSymbol(mangled), boxSize: signatures.genericInstanceBoxSize(id), tagName: mangled, clones: specs, project: project)
		soleWalk or
			shareWalk then emitFieldCascadeWalk(module, symbolName: perTypeCascadeSymbol(action, typeName: mangled), walks: specs, action: action)
	end 'action'
end 'synthesizeGenericInstanceCascade'

// Emit `__clone_<Union>(src) -> newBox`: `__mm_alloc` a fresh box, BLIT the whole box (the tag and every payload
// slot copied for free), then — behind a per-managed-case tag guard chain (the same shape
// `synthesizeUnionDestructor` uses) — DEEP-CLONE the LIVE case's managed payloads in place. A scalar-only union
// (no case owns a managed payload) is a pure blit, which is exactly the fresh independent box its element copy
// needs.
function synthesizeUnionCloner(module StdModule, layout EnumLayout, project Project, signatures ProgramSignatures)
	var func = IrFunction.createFromStd(clonerSymbol(layout.name), returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0, needsGreenThreadStackGuard: true)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var done = module.addBlock(func, label: b"done", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let src = 0 as ValueId

	let size = emitConst(module, block: entry, value: layout.boxSizeBytes() as ParsedInt, ids: ids)
	let zeroDtor = emitConst(module, block: entry, value: TrivialElementDestroy, ids: ids)
	let newBox = ids.mint()
	emitMmAllocCall(module, block: entry, result: newBox, size: size, destructor: zeroDtor, tag: userTagIndex(project.globalData, name: layout.name, debugStream: module.debugStream), ids: ids)
	var copied = emitForwardCopy(module, func: func, cur: entry, dest: newBox, src: src, byteCount: size, ids: ids)
	let start = CascadeCursor.create(copied, carried: ValueIdArray.create())
	let finish = start.at(done)

	let fellThrough = emitUnionManagedCaseChain(module, func: func, cur: start, box: newBox, layout: layout, dest: finish, project: project, signatures: signatures, action: CascadeAction.clone, ids: ids)

	emitCascadeBranch(module, from: fellThrough, to: finish)
	module.setTerminator(done, op: StdOp.ret(newBox))
	module.functions.push(func)
end 'synthesizeUnionCloner'

// ⭐⭐ **THE TAG-GUARD CHAIN EVERY UNION CASCADE WALKS — ONE DERIVATION FOR EVERY ACTION.** Load `box`'s tag,
// then for each case that owns a managed payload emit `tag == <case>` guarding that case's own field walk,
// every arm ending at `dest`. Returns the cursor the chain FALLS THROUGH in, which the caller terminates: a
// clone returns its fresh box there and a walk its visit table.
//
// The skip rule (`caseHasManagedField`) and the payload list below it are the facts that must not diverge —
// a case a clone deep-copies and a soleness walk skipped is a co-owned payload crossing to another green
// thread, which reads as nothing at either site.
function emitUnionManagedCaseChain(module StdModule, func IrFunction, cur CascadeCursor, box ValueId, layout EnumLayout, dest CascadeCursor, project Project, signatures ProgramSignatures, action CascadeAction, ids ValueMinter) returns CascadeCursor
	let tag = emitLoadField(module, block: cur.block, record: box, offset: UnionTagOffset, ids: ids)
	var chain = cur.block

	for ci in 0 upto layout.caseCount() 'eachCase'
		if not caseHasManagedField(signatures, typeNames: project.typeNames, layout: layout, ci: ci) 'scalarCase'
			continue
		end 'scalarCase'

		var caseBlock = module.addBlock(func, label: b"case", heat: BlockHeat.normal)
		var nextTest = module.addBlock(func, label: b"casetest", heat: BlockHeat.normal)
		let tagConst = emitConst(module, block: chain, value: layout.tagOfIndex(ci), ids: ids)
		let isCase = emitCmp(module, block: chain, a: tag, b: tagConst, pred: StdCmpPred.eq, ids: ids)
		module.setTerminator(chain, op: StdOp.condBranch(isCase, thenBlockId: caseBlock.id, elseBlockId: nextTest.id))
		emitManagedFieldCascades(module, func: func, start: cur.at(caseBlock), box: box, layout: layout, ci: ci, dest: dest, project: project, signatures: signatures, action: action, ids: ids)
		chain = nextTest
	end 'eachCase'

	return cur.at(chain)
end 'emitUnionManagedCaseChain'

// Cascade over every MANAGED payload of case `ci`, then branch to `dest`. The non-drop twin of
// `emitManagedFieldDrops`, and ONE walk for both actions: the payload classification decides WHICH slots a
// cascade touches, so a second copy of it could touch a different set.
function emitManagedFieldCascades(module StdModule, func IrFunction, start CascadeCursor, box ValueId, layout EnumLayout, ci CaseIndex, dest CascadeCursor, project Project, signatures ProgramSignatures, action CascadeAction, ids ValueMinter)
	let payloads = layout.payloadsAt(ci)
	var cur = start

	for fi in 0 upto payloads.count() 'eachField'
		let field = try payloads.get(fi) otherwise panic("emitManagedFieldCascades: payloadsAt count disagrees with get at {fi}")

		if not payloadClassIsManaged(classifyUnionPayload(signatures, typeNames: project.typeNames, fieldType: field.declaredType, slotScopeFilePath: layout.declFilePath)) 'scalar'
			continue
		end 'scalar'

		let strategy = managedFieldCascadeStrategy(signatures, typeNames: project.typeNames, fieldType: field.declaredType, asElement: false, action: action)
		cur = emitManagedFieldCascade(module, func: func, cur: cur, box: box, offset: layout.payloadSlotOffset(fi), strategy: strategy, action: action, ids: ids)
	end 'eachField'

	emitCascadeBranch(module, from: cur, to: dest)
end 'emitManagedFieldCascades'

// Load the pointer at `box + offset` and, when it is NON-NULL, spend the field's `strategy` on it; a
// moved-out (null) slot is skipped — the clone leaves the blit's own 0 in place and the walk has nothing to
// prove. The one null-guarded field shape the struct cascade and the union tag-case cascade both emit, for
// both actions, so the load/guard geometry and the null rule live in ONE place. Returns the CONTINUATION
// cursor.
function emitManagedFieldCascade(module StdModule, func IrFunction, cur CascadeCursor, box ValueId, offset ByteOffset, strategy ManagedCascadeStrategy, action CascadeAction, ids ValueMinter) returns CascadeCursor
	let oldPtr = emitLoadField(module, block: cur.block, record: box, offset: offset, ids: ids)
	let zero = emitConst(module, block: cur.block, value: 0, ids: ids)
	let nonNull = emitCmp(module, block: cur.block, a: oldPtr, b: zero, pred: StdCmpPred.ne, ids: ids)
	var visitBlock = module.addBlock(func, label: cascadeFieldBlockLabel(action), heat: BlockHeat.normal)
	let cont = emitCascadeJoin(module, func: func, label: b"cont", template: cur.carried, ids: ids)
	module.setTerminator(cur.block, op: StdOp.condBranch(nonNull, thenBlockId: visitBlock.id, elseBlockId: cont.block.id))
	pushCascadeEdge(cur.block, to: cont, values: cur.carried)

	let visited = emitFieldVisit(module, visit: cur.at(visitBlock), box: box, offset: offset, oldPtr: oldPtr, strategy: strategy, action: action, ids: ids)
	emitCascadeBranch(module, from: visited, to: cont)

	return cont
end 'emitManagedFieldCascade'

// One non-null managed field's action: a clone's fresh copy replaces the blit's shallow pointer in place, which
// is what makes the cloned box independent of the source; a walk hands the field its visit table and carries on
// with the one the field answers.
function emitFieldVisit(module StdModule, visit CascadeCursor, box ValueId, offset ByteOffset, oldPtr ValueId, strategy ManagedCascadeStrategy, action CascadeAction, ids ValueMinter) returns CascadeCursor
	match action 'action'
		clone then return emitClonedFieldStore(module, visit: visit, box: box, offset: offset, oldPtr: oldPtr, strategy: strategy, ids: ids)
		soleWalk or
			shareWalk then return CascadeCursor.create(visit.block, carried: argsOf(emitFieldWalkCall(module, block: visit.block, box: box, offset: offset, ptr: oldPtr, visits: visit.visits(), strategy: strategy, ids: ids)))
	end 'action'
end 'emitFieldVisit'

// A FIELD's walk: an interface-typed field reads its witness half beside the value half, and every other field
// takes `emitWalkCall`.
function emitFieldWalkCall(module StdModule, block IrBlock, box ValueId, offset ByteOffset, ptr ValueId, visits ValueId, strategy ManagedCascadeStrategy, ids ValueMinter) returns ValueId
	match strategy 'strategy'
		throughWitness(entry) then return emitWitnessReadWalk(module, block: block, box: box, offset: offset, value: ptr, visits: visits, entry: entry, ids: ids)
		direct or
			managedElements or
			unsupported then return emitWalkCall(module, block: block, ptr: ptr, visits: visits, strategy: strategy, ids: ids)
	end 'strategy'
end 'emitFieldWalkCall'

function emitClonedFieldStore(module StdModule, visit CascadeCursor, box ValueId, offset ByteOffset, oldPtr ValueId, strategy ManagedCascadeStrategy, ids ValueMinter) returns CascadeCursor
	let newPtr = emitFieldCloneCall(module, block: visit.block, box: box, offset: offset, oldPtr: oldPtr, strategy: strategy, ids: ids)
	emitStoreField(module, block: visit.block, record: box, offset: offset, value: newPtr)
	return visit
end 'emitClonedFieldStore'

function emitFieldCloneCall(module StdModule, block IrBlock, box ValueId, offset ByteOffset, oldPtr ValueId, strategy ManagedCascadeStrategy, ids ValueMinter) returns ValueId
	match strategy 'strategy'
		throughWitness(entry) then return emitWitnessReadClone(module, block: block, box: box, offset: offset, value: oldPtr, entry: entry, ids: ids)
		direct or
			managedElements or
			unsupported then return emitCloneCall(module, block: block, oldPtr: oldPtr, strategy: strategy, ids: ids)
	end 'strategy'
end 'emitFieldCloneCall'

// An interface-typed field's clone: `entry(witness, value)`, the witness read from the slot beside the value
// half. Only the value half is stored back (`emitClonedFieldStore`) — a copy holds the SAME conformer, so the
// witness half the record copy already carried is the right one.
function emitWitnessReadClone(module StdModule, block IrBlock, box ValueId, offset ByteOffset, value ValueId, entry ByteArray, ids ValueMinter) returns ValueId
	let witness = emitLoadField(module, block: block, record: box, offset: offset + InterfaceWitnessHalfOffset, ids: ids)
	return emitRuntimeCall(module, block: block, callee: entry, args: twoArgs(witness, second: value), ids: ids)
end 'emitWitnessReadClone'

// The label the guarded field block wears, so a dumped body still says which cascade it belongs to.
function cascadeFieldBlockLabel(action CascadeAction) returns ByteArray
	return match action 'action'
		clone gives b"clonefld"
		soleWalk gives b"solefld"
		shareWalk gives b"sharefld"
	end 'action'
end 'cascadeFieldBlockLabel'

// Emit the clone call for a managed field's `strategy` and return the fresh pointer. A `direct` callee is a
// plain 1-arg call; a `managedElements` field takes the element's `funcAddr` and calls its container's own
// per-element copy entry (`__managed_clone_managed` for the record, `__list_clone_managed` for the chain).
function emitCloneCall(module StdModule, block IrBlock, oldPtr ValueId, strategy ManagedCascadeStrategy, ids ValueMinter) returns ValueId
	match strategy 'strategy'
		direct(callee) then return emitDirectClone(module, block: block, oldPtr: oldPtr, callee: callee, ids: ids)
		managedElements(containerClone, elementClone) then return emitManagedElementsFieldClone(module, block: block, oldPtr: oldPtr, containerClone: containerClone, elementClone: elementClone, ids: ids)
		unsupported or
			throughWitness then panic("emitCloneCall: an uncopyable managed field strategy reached the cloner synthesis — typeSupportsDeepClone gates the front end for `GraphCascadePurpose.deepClone`")
	end 'strategy'
end 'emitCloneCall'

function emitDirectClone(module StdModule, block IrBlock, oldPtr ValueId, callee ByteArray, ids ValueMinter) returns ValueId
	let newPtr = ids.mint()
	module.appendOp(block, op: StdOp.call(newPtr, callee: callee, args: argsOf(oldPtr)))
	return newPtr
end 'emitDirectClone'

function emitManagedElementsFieldClone(module StdModule, block IrBlock, oldPtr ValueId, containerClone ByteArray, elementClone ByteArray, ids ValueMinter) returns ValueId
	let elemFn = ids.mint()
	module.appendOp(block, op: StdOp.funcAddr(elemFn, funcName: elementClone))
	let newPtr = ids.mint()
	module.appendOp(block, op: StdOp.call(newPtr, callee: containerClone, args: twoArgs(oldPtr, second: elemFn)))
	return newPtr
end 'emitManagedElementsFieldClone'

// --- The per-type WALK cascades — soleness and share — over the drop side's node space ---
//
// ⭐⭐ **EACH IS THE CLONE CASCADE'S SHAPE WITHOUT THE ALLOCATION.** `__sole_<T>(box, visits)` counts `box`'s
// owners in the moved graph and `__share_<T>(box, visits)` marks it shared, then each walks the SAME managed
// field list the cloner copies and the destructor releases — one classifier (`managedFieldCascadeStrategy`)
// routes all four, so a field a clone deep-copies is a field a move proves, a lend marks and a drop releases,
// and none of them can come to disagree about what a type holds.
//
// ⚠ **A WALK NEITHER RETAINS NOR RELEASES ANYTHING IN THE GRAPH.** It reads counts, marks them (share), may
// DETACH a shared copy-on-write buffer (sole, `__managed_sole`), and otherwise leaves the graph as it found it —
// which is what lets the sender's own reference, or the message's, be taken or handed over separately. The only
// memory it touches is its own visit table, which `__mm_walk_settle` frees.
//
// ⭐ **BOTH WALKS STOP WHERE `emitBoxWalkStep` SAYS NOTHING BELOW CAN NEED THEM** — at image data, at a
// shared box and at a record an earlier meeting already descended — which is what makes a second lend of one
// graph cost one box step, and a record reached twice cost one descent.

// One declared union's cascade for `action`. The bodies differ in what they leave behind — a fresh box or
// nothing — and share the tag-guard chain and the payload list through `emitUnionManagedCaseChain`.
function synthesizeUnionCascade(module StdModule, layout EnumLayout, project Project, signatures ProgramSignatures, action CascadeAction)
	match action 'action'
		clone then synthesizeUnionCloner(module, layout: layout, project: project, signatures: signatures)
		soleWalk or
			shareWalk then synthesizeUnionWalk(module, layout: layout, project: project, signatures: signatures, action: action)
	end 'action'
end 'synthesizeUnionCascade'

// A managed-element record's ONE-ARGUMENT thunk for `action`. Every body is the FIELD-position strategy of
// the same instance, read here so the entry points cannot resolve it two ways.
function synthesizeElementRecordCascade(module StdModule, id GenericInstanceId, signatures ProgramSignatures, action CascadeAction)
	match action 'action'
		clone then synthesizeElementRecordCloner(module, id: id, signatures: signatures)
		soleWalk or
			shareWalk then synthesizeElementRecordWalk(module, id: id, signatures: signatures, action: action)
	end 'action'
end 'synthesizeElementRecordCascade'

// ⭐ **THE ELEMENT-WALK THUNK for a managed-element record** — `synthesizeElementRecordCloner`'s twin, and it
// exists for that one's reason: an ARRAY ELEMENT is reached through `callIndirect(fn, elem, visits)`, while the
// record's own walk is the 3-argument `<containerWalk>(box, visits, funcAddr(elementWalk))`. No null guard,
// deliberately: `emitElementWalkRange` and `emitListElementWalk` each test the slot one level up and never
// `callIndirect` a null element.
function synthesizeElementRecordWalk(module StdModule, id GenericInstanceId, signatures ProgramSignatures, action CascadeAction)
	let body = beginWalkBody(module, name: perTypeCascadeSymbol(action, typeName: signatures.mangleGenericInstance(id)), scope: WalkScope.graph, walksElements: false, recursesPerLevel: true)
	let walked = emitWalkCall(module, block: body.entry.block, ptr: WalkBoxParam, visits: body.entry.visits(), strategy: signatures.elementRecordFieldCascadeStrategy(id, action: action), ids: body.ids)
	emitCascadeBranch(module, from: CascadeCursor.create(body.entry.block, carried: argsOf(walked)), to: body.done)
	finishWalkBody(module, body: body)
end 'synthesizeElementRecordWalk'

// Emit `<symbolName>(box, visits)` for a TAGLESS box (a struct, or a monomorphized generic instance): the box's
// own walk step, then each managed field behind the per-field null-guard a moved-out slot needs.
// `emitFieldCascadeDestructor`'s shape minus the free, and `emitFieldCascadeCloner`'s minus the allocation.
function emitFieldCascadeWalk(module StdModule, symbolName ByteArray, walks ManagedFieldCascadeArray, action CascadeAction)
	let body = beginWalkBody(module, name: symbolName, scope: WalkScope.graph, walksElements: false, recursesPerLevel: true)
	var cur = emitBoxWalkStep(module, func: body.func, cursor: body.entry, box: WalkBoxParam, action: action, meeting: WalkMeeting.owner, stop: body.done, ids: body.ids)

	for spec in walks 'eachField'
		cur = emitManagedFieldCascade(module, func: body.func, cur: cur, box: WalkBoxParam, offset: spec.offset, strategy: spec.strategy, action: action, ids: body.ids)
	end 'eachField'

	emitCascadeBranch(module, from: cur, to: body.done)
	finishWalkBody(module, body: body)
end 'emitFieldCascadeWalk'

// Emit `__sole_<Union>(box, visits)` / `__share_<Union>(box, visits)`: the box's own walk step, then — behind the
// tag-guard chain `synthesizeUnionCloner` walks — the LIVE case's managed payloads. A scalar-only union is the
// box step alone.
function synthesizeUnionWalk(module StdModule, layout EnumLayout, project Project, signatures ProgramSignatures, action CascadeAction)
	let body = beginWalkBody(module, name: perTypeCascadeSymbol(action, typeName: layout.name), scope: WalkScope.graph, walksElements: false, recursesPerLevel: true)
	let walked = emitBoxWalkStep(module, func: body.func, cursor: body.entry, box: WalkBoxParam, action: action, meeting: WalkMeeting.owner, stop: body.done, ids: body.ids)
	let fellThrough = emitUnionManagedCaseChain(module, func: body.func, cur: walked, box: WalkBoxParam, layout: layout, dest: body.done, project: project, signatures: signatures, action: action, ids: body.ids)

	emitCascadeBranch(module, from: fellThrough, to: body.done)
	finishWalkBody(module, body: body)
end 'synthesizeUnionWalk'

// An interface-typed field's walk: `entry(witness, value, visits)`, the witness read from the slot beside the value
// half, answering the visit table the conformer's walk hands back.
function emitWitnessReadWalk(module StdModule, block IrBlock, box ValueId, offset ByteOffset, value ValueId, visits ValueId, entry ByteArray, ids ValueMinter) returns ValueId
	let witness = emitLoadField(module, block: block, record: box, offset: offset + InterfaceWitnessHalfOffset, ids: ids)
	return emitRuntimeCall(module, block: block, callee: entry, args: threeArgs(witness, second: value, third: visits), ids: ids)
end 'emitWitnessReadWalk'

// Emit the walk call for a managed field's `strategy` — `emitCloneCall`'s twin — answering the visit table the
// callee hands back. A `direct` callee takes the box and the table; a `managedElements` field also takes the
// element's `funcAddr` and calls its container's own per-element walk entry.
function emitWalkCall(module StdModule, block IrBlock, ptr ValueId, visits ValueId, strategy ManagedCascadeStrategy, ids ValueMinter) returns ValueId
	match strategy 'strategy'
		direct(callee) then return emitRuntimeCall(module, block: block, callee: callee, args: twoArgs(ptr, second: visits), ids: ids)
		managedElements(containerWalk, elementWalk) then return emitManagedElementsFieldWalk(module, block: block, ptr: ptr, visits: visits, containerWalk: containerWalk, elementWalk: elementWalk, ids: ids)
		unsupported then panic("emitWalkCall: an unsupported managed field strategy reached a walk synthesis — typeSupportsDeepClone gates the front end for `GraphCascadePurpose.transferWalk`")
		throughWitness then panic("emitWalkCall: a witness-read walk reached a position with no witness beside it — only a FIELD holds one, and `emitFieldVisit` takes it there")
	end 'strategy'
end 'emitWalkCall'

function emitManagedElementsFieldWalk(module StdModule, block IrBlock, ptr ValueId, visits ValueId, containerWalk ByteArray, elementWalk ByteArray, ids ValueMinter) returns ValueId
	let elemFn = ids.mint()
	module.appendOp(block, op: StdOp.funcAddr(elemFn, funcName: elementWalk))
	return emitRuntimeCall(module, block: block, callee: containerWalk, args: threeArgs(ptr, second: visits, third: elemFn), ids: ids)
end 'emitManagedElementsFieldWalk'

// `__mm_leak_check(exitCode) -> exitCode` — the gate.
//
// ⭐ IT TAKES AND RETURNS THE EXIT CODE, which is what lets it sit on the exit path as a plain
// function rather than as a special case inside `mrt_start`. A clean program's code passes through
// untouched; a leaked one's is REPLACED by 101.
//
// It is a Std function and not hand-assembled bytes because it needs nothing a Std function lacks:
// a load, a compare, and two returns. It notably does NOT need to call `ExitProcess` — returning
// the code to `mrt_start`, which already makes that call, keeps the one OS-exit path in one place.
//
// The live count is the tracked layer's total less its frees, taken per row and summed over every row
// (`SlabRuntime.emitSlabTrafficRead`) — the columns `__mm_alloc`/`__mm_free` step on the calling thread's
// own row. A program that never allocated has no region at all and reads an honest 0 without committing
// one.
//
// ⭐ **IT IS EXACT BECAUSE THE EXIT PATH IS QUIET, NOT BECAUSE THE COUNT IS ONE WORD.** Summing 256 rows
// was never atomic, so a maintained live word could already be read across a concurrent allocate-here,
// free-there pair; what makes the gate sound is that `mrt_start` calls this after `main` has returned and
// the scheduler has stopped, and with the allocator quiet `total - frees` is exact for the same reason a
// maintained word would be.
//
// ⭐ UNDER `usesGt` IT ALSO GATES `__gt_live_count`. A green thread's record and seed stack come from the
// scheduler's record arena and `osAllocPages`, invisible to the live count, so the GT runtime keeps its
// own spawn/reclaim counter; this single OS-exit gate is the one home for every "must be
// reclaimed before a clean exit" check, so a clean HEAP count falls through to a SECOND, INDEPENDENT `!= 0`
// test on it. The two are never summed/OR'd into one count — a GT over-reclaim driving `__gt_live_count`
// negative must not cancel a heap under-release — and a GT leak reports a DISTINCT code
// (`RuntimeAbort.greenThreadLeak`, not `leakDetected`) so its diagnosis points at the GT counter. The extra
// load is gated on `usage.usesGt` because `__gt_live_count` only exists when the GT runtime is installed —
// and since `usesGt ⟹ usesHeap`, this gate is always present for a GT program, so no GT leak slips past it.
function buildMmLeakCheck(module StdModule, usage RuntimeUsage)
	var func = IrFunction.createFromStd(MmLeakCheckName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var start = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var leaked = module.addBlock(func, label: b"leaked", heat: BlockHeat.normal)
	var clean = module.addBlock(func, label: b"clean", heat: BlockHeat.normal)

	emitParams(module, block: start, count: 1)
	let exitCode = 0 as ValueId

	let count = ids.mint()
	var entry = emitSlabTrafficRead(module, func: func, cur: start, figure: SlabTrafficFigure.live(SlabTrafficLayer.tracked), answerId: count, ids: ids, label: b"live")
	let zeroConst = ids.mint()
	module.appendOp(entry, op: StdOp.const(zeroConst, value: 0, valueType: StdType.i64))

	// `!= 0` and not `> 0`: an over-release drives the count NEGATIVE, and a gate that only caught
	// under-release would report a clean run for a compiler emitting too many drops — the more
	// dangerous of the two bugs, since it is a use-after-free waiting for a free list to exist.
	let isLeaked = ids.mint()
	module.appendOp(entry, op: StdOp.cmp(isLeaked, lhs: count, rhs: zeroConst, pred: StdCmpPred.ne, operandType: StdType.i64))

	// A heap leak short-circuits to `leaked` (101) either way. When the GT runtime is present, a clean HEAP
	// count falls through to a SECOND check on `__gt_live_count` — two INDEPENDENT `!= 0` tests, never a
	// summed/OR'd single count. Without the GT runtime, the clean count goes straight to `clean`.
	if usage.usesGt 'gtGate'
		var checkGt = module.addBlock(func, label: b"checkgt", heat: BlockHeat.normal)
		var gtLeaked = module.addBlock(func, label: b"gtleaked", heat: BlockHeat.normal)
		module.setTerminator(entry, op: StdOp.condBranch(isLeaked, thenBlockId: leaked.id, elseBlockId: checkGt.id))
		let gtCountAddr = ids.mint()
		module.appendOp(checkGt, op: StdOp.globalAddr(gtCountAddr, label: GtLiveCountLabel))
		let gtCount = ids.mint()
		module.appendOp(checkGt, op: StdOp.loadIndirect(gtCount, addrId: gtCountAddr, offset: 0, valueType: StdType.i64))
		let gtIsLeaked = ids.mint()
		module.appendOp(checkGt, op: StdOp.cmp(gtIsLeaked, lhs: gtCount, rhs: zeroConst, pred: StdCmpPred.ne, operandType: StdType.i64))
		module.setTerminator(checkGt, op: StdOp.condBranch(gtIsLeaked, thenBlockId: gtLeaked.id, elseBlockId: clean.id))

		// A GT leak reports its OWN code — distinct from the heap 101 — so the diagnosis points at the GT
		// counter, not the heap one.
		let gtLeakCode = RuntimeAbort.greenThreadLeak.rawValue as ParsedInt
		let gtLeakConst = ids.mint()
		module.appendOp(gtLeaked, op: StdOp.const(gtLeakConst, value: gtLeakCode, valueType: StdType.i64))
		module.setTerminator(gtLeaked, op: StdOp.ret(gtLeakConst))
	end 'gtGate' else 'noGt'
		module.setTerminator(entry, op: StdOp.condBranch(isLeaked, thenBlockId: leaked.id, elseBlockId: clean.id))
	end 'noGt'

	let leakCode = RuntimeAbort.leakDetected.rawValue as ParsedInt
	let leakConst = ids.mint()
	module.appendOp(leaked, op: StdOp.const(leakConst, value: leakCode, valueType: StdType.i64))
	module.setTerminator(leaked, op: StdOp.ret(leakConst))

	module.setTerminator(clean, op: StdOp.ret(exitCode))

	module.functions.push(func)
end 'buildMmLeakCheck'

// `ptr - HeaderBytes` — the header's base address. Every header access goes through it, so the one
// place the payload/header relationship is expressed is here. See the header-layout note above for
// why this is a subtraction rather than a negative `loadIndirect` offset. Private, like the offsets it
// pairs with: callers outside this file reach the refcount through the exported builders instead.
function emitHeaderBase(module StdModule, block IrBlock, ptr ValueId, ids ValueMinter) returns ValueId
	let headerConst = ids.mint()
	module.appendOp(block, op: StdOp.const(headerConst, value: HeaderBytes, valueType: StdType.i64))
	let header = ids.mint()
	module.appendOp(block, op: StdOp.binOp(header, lhs: ptr, rhs: headerConst, opcode: StdBinOpcode.sub, operandType: StdType.i64))
	return header
end 'emitHeaderBase'

export function argsOf(only ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(only)
	return args
end 'argsOf'

// The two- and three-argument branch-edge / call-argument builders — `argsOf`'s pair and triple
// siblings, shared by the String, Array and GT runtimes (a `__mm_alloc(size, dtor)` is two, a
// `__str_copy(dest, src, len)` three). One home so the runtime builders do not each mint their own.
export function twoArgs(first ValueId, second ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	return args
end 'twoArgs'

export function threeArgs(first ValueId, second ValueId, third ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	return args
end 'threeArgs'

// Four positional call arguments — `__managed_slice_managed`. Homed here beside its `argsOf`/`twoArgs`/`threeArgs`
// siblings.
export function fourArgs(first ValueId, second ValueId, third ValueId, fourth ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	args.push(fourth)
	return args
end 'fourArgs'

// Five positional call arguments — `__gt_subp_yield_read(readEnd, buf, cap, bytesOutPtr, ownsPipe)`.
export function fiveArgs(first ValueId, second ValueId, third ValueId, fourth ValueId, fifth ValueId) returns ValueIdArray
	var args = ValueIdArray.create()
	args.push(first)
	args.push(second)
	args.push(third)
	args.push(fourth)
	args.push(fifth)
	return args
end 'fiveArgs'

// Six positional call arguments — `__ds_emit_log_event(nameId, cat, lvl, unitId, arg0, arg1)`, the widest
// entry the DebugStream producer writes. It joins the ladder for its siblings' stated reason: the arity is
// the CONTRACT's, and a call site building its own array would be that contract spelled a second time.
export function sixArgs(first ValueId, second ValueId, third ValueId, fourth ValueId, fifth ValueId, sixth ValueId) returns ValueIdArray
	var args = fiveArgs(first, second: second, third: third, fourth: fourth, fifth: fifth)
	args.push(sixth)
	return args
end 'sixArgs'
