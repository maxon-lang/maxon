// The OS certificate store behind `stdlib/TrustStore.maxon`: Windows' `ROOT` system store and macOS'
// trust-settings domains. Linux reads a bundle file and reaches none of these entries.
//
// `__trust_open() -> store` (0 when there is none), `__trust_next(store, cursor) -> cursor`,
// `__trust_certificate(store, cursor) -> ByteArray`, `__trust_verdict(store, cursor) -> verdict` and
// `__trust_close(store)`. A cursor is opaque: 0 starts the walk and 0 ends it, and
// `TrustStoreWalkFailed` (-1) answers a walk the host could not continue. On Windows a cursor is the
// `CERT_CONTEXT` that `CertEnumCertificatesInStore` frees when the walk steps past it, so
// `__trust_certificate` must run before the next `__trust_next`; `__trust_close` forces the store shut,
// which frees the context of a walk abandoned part-way. On macOS a cursor is a 1-based position over
// the certificates of the system, admin and user domains, in that order. A certificate with no bytes
// comes back as an empty array.
//
// A verdict tells `stdlib/TrustStore.maxon` what to do with the certificate at a cursor, and its
// values are restated there: `TrustVerdictIgnored` leaves it out, `TrustVerdictAccepted` takes it,
// `TrustVerdictRoot` takes it only when self-issued, `TrustVerdictNonRoot` only when not, and
// `TrustVerdictDenied` removes every equal certificate from the answer. The self-issued test belongs to
// the stdlib, which has a DER reader. Windows accepts every certificate. On macOS the system domain
// yields `TrustVerdictRoot`, and a certificate of the admin or user domain yields what its trust
// settings for the SSL policy say, `__trust_ssl_result`'s rules.
export let TrustStoreOpenName = b"__trust_open"
export let TrustStoreNextName = b"__trust_next"
export let TrustStoreCertificateName = b"__trust_certificate"
export let TrustStoreCloseName = b"__trust_close"
export let TrustStoreVerdictName = b"__trust_verdict"

let TrustStoreSslResultName = b"__trust_ssl_result"
let TrustStoreIsSslPolicyName = b"__trust_is_ssl_policy"

let TrustStoreRuntimePrefix = b"__trust_"

let TrustStoreRootNameSlot = 0 as SpillSlot
let TrustStoreRootTerminatorSlot = 1 as SpillSlot
let TrustStoreRootFrameBytes = 16
let TrustStoreScratchSlot = 0 as SpillSlot
let TrustStoreSettingsFrameBytes = 16
let TrustStoreOutOffset = 0
let TrustStoreNumberOffset = 8
let TrustStoreKeyNameOffset = TrustStoreOutOffset + WordBytes
let TrustStoreSlotWordOffset = 0
let TrustStoreHeaderStart = 0
let TrustStoreKeyNameStart = 0

let TrustStoreRootNameUtf16 = 0x0054004F004F0052
let TrustStoreRootTerminatorUtf16 = 0
let TrustStoreNoContext = 0
let TrustStoreNoArgument = 0
let TrustStoreSuccessStatus = 0
let TrustStoreFirstCursor = 1
let TrustStoreCursorStep = 1
let TrustStoreFirstMember = 0
let TrustStoreMemberStep = 1
let TrustStoreNoBytes = 0
let TrustStoreFalseFlag = 0
let TrustStoreNoCertificates = 0
let TrustStoreNoResult = 0
let TrustStoreNotSslPolicy = 0
let TrustStoreLowDwordMask = 0xFFFFFFFF
let TrustStoreBooleanMask = 0xFF
let TrustStoreForceClose = 1
let TrustStoreWalkFailed = -1
let CryptENotFound = 0x80092004

let CertContextEncodedOffset = 8
let CertContextEncodedLengthOffset = 16

let TrustVerdictIgnored = 0
let TrustVerdictAccepted = 1
let TrustVerdictRoot = 2
let TrustVerdictNonRoot = 3
let TrustVerdictDenied = 4

let SecDomainUser = 0
let SecDomainAdmin = 1
let SecDomainSystem = 2
let SecDomainCount = 3
let SecResultTrustRoot = 1
let SecResultTrustAsRoot = 2
let SecResultDeny = 3
let SecResultUnspecified = 4
let CfNumberSInt32Type = 3
let RtldDefault = -2
let WordBytes = 8
let TrustStoreByteRadix = 256

// The macOS store is a raw block: the three `CFArrayRef`s that `SecTrustSettingsCopyCertificates`
// answered (system, admin, user; 0 for a domain that answered nothing), their counts, then one word
// per `TrustStoreKey`. `__trust_close` releases whichever arrays are set and the keys the store
// owns.
let TrustStoreArraysOffset = TrustStoreHeaderStart
let TrustStoreCountsOffset = TrustStoreArraysOffset + SecDomainCount * WordBytes
let TrustStoreKeysOffset = TrustStoreCountsOffset + SecDomainCount * WordBytes
let CfStringEncodingUtf8 = 0x08000100

let TrustStoreKeyPolicyName = b"kSecTrustSettingsPolicy"
let TrustStoreKeyPolicyStringName = b"kSecTrustSettingsPolicyString"
let TrustStoreKeyResultName = b"kSecTrustSettingsResult"
let TrustStoreKeyPolicyOidName = b"kSecPolicyOid"
let TrustStoreKeyAppleSslName = b"kSecPolicyAppleSSL"

// Declaration order is each domain's word position in the store block. `emitTrustStoreTotal` reads
// `system` first and sums from `admin` on, so a reorder double-counts or drops a domain's certificates.
enum TrustStoreDomain
	system
	admin
	user
end 'TrustStoreDomain'

enum TrustStoreKey
	policy
	policyString
	result
	policyOid
	appleSsl
end 'TrustStoreKey'

function trustStoreKeyName(key TrustStoreKey) returns ByteArray
	return match key 'name'
		policy gives TrustStoreKeyPolicyName
		policyString gives TrustStoreKeyPolicyStringName
		result gives TrustStoreKeyResultName
		policyOid gives TrustStoreKeyPolicyOidName
		appleSsl gives TrustStoreKeyAppleSslName
	end 'name'
end 'trustStoreKeyName'

// The three trust-settings keys are `CFSTR` macros with no exported symbol, so `dlsym` answers null
// for them: open creates them, the store owns them, and they match because `CFDictionary` compares
// keys with `CFEqual`. The two policy keys are exported globals the store borrows and must never
// release.
function trustStoreKeyIsCreated(key TrustStoreKey) returns bool
	return match key 'created'
		policy or
		policyString or
		result gives true
		policyOid or
		appleSsl gives false
	end 'created'
end 'trustStoreKeyIsCreated'

function trustStoreKeyOffset(key TrustStoreKey) returns ByteOffset
	return trustStoreWordOffset(TrustStoreKeysOffset, word: key.ordinal as FullRangeInt)
end 'trustStoreKeyOffset'

function trustStoreHeaderWords() returns FullRangeInt
	return (TrustStoreKeysOffset / WordBytes + TrustStoreKey.allCases.count()) as FullRangeInt
end 'trustStoreHeaderWords'

function trustStoreKeyNameWords(key TrustStoreKey) returns FullRangeInt
	return ((trustStoreKeyName(key).count() + WordBytes) / WordBytes) as FullRangeInt
end 'trustStoreKeyNameWords'

function trustStoreOpenFrameBytes() returns StackSize
	var longest = 0 as FullRangeInt

	for key in TrustStoreKey.allCases 'eachKey'
		let words = trustStoreKeyNameWords(key)

		if words > longest 'longer'
			longest = words
		end 'longer'
	end 'eachKey'

	return trustStoreWordOffset(TrustStoreKeyNameOffset, word: longest) as StackSize
end 'trustStoreOpenFrameBytes'

export function isTrustStoreRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: TrustStoreRuntimePrefix)
end 'isTrustStoreRuntimeCallee'

function emitTrustStoreCall(module StdModule, block IrBlock, service HostProcessCall, a0 ValueId, a1 ValueId, ids ValueMinter) returns ValueId
	let unused = emitConst(module, block: block, value: TrustStoreNoArgument, ids: ids)

	return emitTrustStoreCall3(module, block: block, service: service, a0: a0, a1: a1, a2: unused, ids: ids)
end 'emitTrustStoreCall'

function emitTrustStoreCall3(module StdModule, block IrBlock, service HostProcessCall, a0 ValueId, a1 ValueId, a2 ValueId, ids ValueMinter) returns ValueId
	let unused = emitConst(module, block: block, value: TrustStoreNoArgument, ids: ids)

	return emitHostSample(module, block: block, service: service, a0: a0, a1: a1, a2: a2, a3: unused, a4: unused, a5: unused, ids: ids)
end 'emitTrustStoreCall3'

function emitTrustStoreBoolean(module StdModule, block IrBlock, raw ValueId, ids ValueMinter) returns ValueId
	return emitBin(module, block: block, a: raw, b: emitConst(module, block: block, value: TrustStoreBooleanMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
end 'emitTrustStoreBoolean'

function emitTrustStoreRuntimeCall(module StdModule, block IrBlock, callee ByteArray, args ValueIdArray, ids ValueMinter) returns ValueId
	let result = ids.mint()
	module.appendOp(block, op: StdOp.call(result, callee: callee, args: args))

	return result
end 'emitTrustStoreRuntimeCall'

function emitTrustStoreRelease(module StdModule, block IrBlock, object ValueId, ids ValueMinter)
	let unused = emitConst(module, block: block, value: TrustStoreNoArgument, ids: ids)

	_ = emitTrustStoreCall(module, block: block, service: HostProcessCall.cfRelease, a0: object, a1: unused, ids: ids)
end 'emitTrustStoreRelease'

function emitTrustStoreReleaseIfHeld(module StdModule, func IrFunction, cur IrBlock, held ValueId, done IrBlock, label ByteArray, ids ValueMinter)
	var release = module.addBlock(func, label: label, heat: BlockHeat.cold)

	emitBranchOnCompare(module, block: cur, value: held, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: release, whenFalse: done, ids: ids)
	emitTrustStoreRelease(module, block: release, object: held, ids: ids)
	module.setTerminator(release, op: StdOp.branch(done.id))
end 'emitTrustStoreReleaseIfHeld'

function emitFreshBytesRecord(module StdModule, func IrFunction, cur IrBlock, record ValueId, src ValueId, byteCount ValueId, ids ValueMinter) returns IrBlock
	let destination = emitManagedByteBuffer(module, block: cur, record: record, byteCount: byteCount, ids: ids)
	var copied = emitForwardCopy(module, func: func, cur: cur, dest: destination, src: src, byteCount: byteCount, ids: ids)
	emitStoreField(module, block: copied, record: record, offset: ManagedRecordLengthOffset, value: byteCount)

	return copied
end 'emitFreshBytesRecord'

function emitTrustStoreReleaseSlot(module StdModule, func IrFunction, cur IrBlock, store ValueId, offset ByteOffset, ids ValueMinter) returns IrBlock
	var next = module.addBlock(func, label: b"tsclosed", heat: BlockHeat.normal)

	let held = emitLoadField(module, block: cur, record: store, offset: offset, ids: ids)
	emitTrustStoreReleaseIfHeld(module, func: func, cur: cur, held: held, done: next, label: b"tsreleaseslot", ids: ids)

	return next
end 'emitTrustStoreReleaseSlot'

function buildWindowsTrustStoreClose(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreCloseName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param())
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let store = 0

	let closeFlags = emitConst(module, block: entry, value: TrustStoreForceClose, ids: ids)
	_ = emitTrustStoreCall(module, block: entry, service: HostProcessCall.certCloseStore, a0: store, a1: closeFlags, ids: ids)
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildWindowsTrustStoreClose'

function buildWindowsTrustStoreOpen(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreOpenName, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create())
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	func.stackSize = TrustStoreRootFrameBytes
	let namePtr = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(namePtr, slot: TrustStoreRootNameSlot))
	let terminatorPtr = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(terminatorPtr, slot: TrustStoreRootTerminatorSlot))

	let name = emitConst(module, block: entry, value: TrustStoreRootNameUtf16, ids: ids)
	let terminator = emitConst(module, block: entry, value: TrustStoreRootTerminatorUtf16, ids: ids)
	emitStoreField(module, block: entry, record: namePtr, offset: TrustStoreSlotWordOffset, value: name)
	emitStoreField(module, block: entry, record: terminatorPtr, offset: TrustStoreSlotWordOffset, value: terminator)

	let noProvider = emitConst(module, block: entry, value: TrustStoreNoContext, ids: ids)
	let store = emitTrustStoreCall(module, block: entry, service: HostProcessCall.certOpenRootStore, a0: noProvider, a1: namePtr, ids: ids)
	module.setTerminator(entry, op: StdOp.ret(store))

	module.functions.push(func)
end 'buildWindowsTrustStoreOpen'

function buildWindowsTrustStoreNext(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreNextName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var found = module.addBlock(func, label: b"tsfound", heat: BlockHeat.normal)
	var ended = module.addBlock(func, label: b"tsended", heat: BlockHeat.cold)
	var checkNoMoreFiles = module.addBlock(func, label: b"tscheck", heat: BlockHeat.cold)
	var failed = module.addBlock(func, label: b"tsfailed", heat: BlockHeat.cold)
	var complete = module.addBlock(func, label: b"tscomplete", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: 2)
	let store = 0
	let cursor = 1

	let next = emitTrustStoreCall(module, block: entry, service: HostProcessCall.certEnumCertificate, a0: store, a1: cursor, ids: ids)
	let reason = ids.mint()
	module.appendOp(entry, op: StdOp.osLastError(reason))
	emitBranchOnCompare(module, block: entry, value: next, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: found, whenFalse: ended, ids: ids)

	module.setTerminator(found, op: StdOp.ret(next))

	emitBranchOnCompare(module, block: ended, value: reason, pred: StdCmpPred.eq, against: CryptENotFound, whenTrue: complete, whenFalse: checkNoMoreFiles, ids: ids)
	emitBranchOnCompare(module, block: checkNoMoreFiles, value: reason, pred: StdCmpPred.eq, against: ErrorNoMoreFiles, whenTrue: complete, whenFalse: failed, ids: ids)

	emitConstReturn(module, block: complete, value: TrustStoreNoContext, ids: ids)
	emitConstReturn(module, block: failed, value: TrustStoreWalkFailed, ids: ids)

	module.functions.push(func)
end 'buildWindowsTrustStoreNext'

function buildWindowsTrustStoreCertificate(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreCertificateName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let cursor = 1

	let encoded = emitLoadField(module, block: entry, record: cursor, offset: CertContextEncodedOffset, ids: ids)

	// `cbCertEncoded` is a DWORD; the other half of the word read here is struct padding.
	let encodedWord = emitLoadField(module, block: entry, record: cursor, offset: CertContextEncodedLengthOffset, ids: ids)
	let lowDwordMask = emitConst(module, block: entry, value: TrustStoreLowDwordMask, ids: ids)
	let encodedBytes = emitBin(module, block: entry, a: encodedWord, b: lowDwordMask, opcode: StdBinOpcode.bitAnd, ids: ids)

	let record = ids.mint()
	var copied = emitFreshBytesRecord(module, func: func, cur: entry, record: record, src: encoded, byteCount: encodedBytes, ids: ids)
	module.setTerminator(copied, op: StdOp.ret(record))

	module.functions.push(func)
end 'buildWindowsTrustStoreCertificate'

function buildWindowsTrustStoreVerdict(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreVerdictName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())

	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	emitConstReturn(module, block: entry, value: TrustVerdictAccepted, ids: ids)

	module.functions.push(func)
end 'buildWindowsTrustStoreVerdict'

function installWindowsTrustStore(module StdModule)
	buildWindowsTrustStoreOpen(module)
	buildWindowsTrustStoreNext(module)
	buildWindowsTrustStoreCertificate(module)
	buildWindowsTrustStoreVerdict(module)
	buildWindowsTrustStoreClose(module)
end 'installWindowsTrustStore'

function trustStoreDomainConstant(domain TrustStoreDomain) returns FullRangeInt
	return match domain 'constant'
		system gives SecDomainSystem
		admin gives SecDomainAdmin
		user gives SecDomainUser
	end 'constant'
end 'trustStoreDomainConstant'

function trustStoreDomainWord(domain TrustStoreDomain) returns FullRangeInt
	return domain.ordinal as FullRangeInt
end 'trustStoreDomainWord'

function trustStoreWordOffset(base FullRangeInt, word FullRangeInt) returns ByteOffset
	return (base + word * WordBytes) as ByteOffset
end 'trustStoreWordOffset'

function trustStoreNameWord(name ByteArray, word FullRangeInt) returns FullRangeInt
	var packed = 0 as FullRangeInt

	for step in 0 upto WordBytes 'eachByte'
		let at = word * WordBytes + (WordBytes - 1 - step)
		let octet = try name.get(at as ElementIndex) otherwise 0

		packed = packed * TrustStoreByteRadix + (octet as FullRangeInt)
	end 'eachByte'

	return packed
end 'trustStoreNameWord'

function emitTrustStoreTotal(module StdModule, block IrBlock, store ValueId, ids ValueMinter) returns ValueId
	var total = emitLoadField(module, block: block, record: store, offset: trustStoreWordOffset(TrustStoreCountsOffset, word: trustStoreDomainWord(TrustStoreDomain.system)), ids: ids)

	for position in trustStoreDomainWord(TrustStoreDomain.admin) upto SecDomainCount 'eachCount'
		let count = emitLoadField(module, block: block, record: store, offset: trustStoreWordOffset(TrustStoreCountsOffset, word: position), ids: ids)
		total = emitBin(module, block: block, a: total, b: count, opcode: StdBinOpcode.add, ids: ids)
	end 'eachCount'

	return total
end 'emitTrustStoreTotal'

function emitTrustStoreCopyDomain(module StdModule, func IrFunction, cur IrBlock, header ValueId, scratch ValueId, domain TrustStoreDomain, ids ValueMinter) returns IrBlock
	let position = trustStoreDomainWord(domain)
	var copied = module.addBlock(func, label: "tscopied{position}".toByteArray(), heat: BlockHeat.normal)
	var counted = module.addBlock(func, label: "tscounted{position}".toByteArray(), heat: BlockHeat.normal)
	var next = module.addBlock(func, label: "tsdomain{position}".toByteArray(), heat: BlockHeat.normal)

	emitStoreField(module, block: cur, record: scratch, offset: TrustStoreOutOffset, value: emitConst(module, block: cur, value: TrustStoreNoContext, ids: ids))
	let domainConstant = emitConst(module, block: cur, value: trustStoreDomainConstant(domain), ids: ids)
	let status = emitTrustStoreCall(module, block: cur, service: HostProcessCall.secTrustSettingsCopyCertificates, a0: domainConstant, a1: scratch, ids: ids)
	emitBranchOnCompare(module, block: cur, value: status, pred: StdCmpPred.eq, against: TrustStoreSuccessStatus, whenTrue: copied, whenFalse: next, ids: ids)

	let array = emitLoadField(module, block: copied, record: scratch, offset: TrustStoreOutOffset, ids: ids)
	emitStoreField(module, block: copied, record: header, offset: trustStoreWordOffset(TrustStoreArraysOffset, word: position), value: array)
	emitBranchOnCompare(module, block: copied, value: array, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: counted, whenFalse: next, ids: ids)

	let unused = emitConst(module, block: counted, value: TrustStoreNoArgument, ids: ids)
	let count = emitTrustStoreCall(module, block: counted, service: HostProcessCall.cfArrayCount, a0: array, a1: unused, ids: ids)
	emitStoreField(module, block: counted, record: header, offset: trustStoreWordOffset(TrustStoreCountsOffset, word: position), value: count)
	module.setTerminator(counted, op: StdOp.branch(next.id))

	return next
end 'emitTrustStoreCopyDomain'

function emitTrustStoreKeyName(module StdModule, block IrBlock, scratch ValueId, key TrustStoreKey, ids ValueMinter) returns ValueId
	let name = trustStoreKeyName(key)
	let nameAt = emitBin(module, block: block, a: scratch, b: emitConst(module, block: block, value: TrustStoreKeyNameOffset, ids: ids), opcode: StdBinOpcode.add, ids: ids)

	for word in 0 upto trustStoreKeyNameWords(key) 'eachWord'
		emitStoreField(module, block: block, record: nameAt, offset: trustStoreWordOffset(TrustStoreKeyNameStart, word: word), value: emitConst(module, block: block, value: trustStoreNameWord(name, word: word), ids: ids))
	end 'eachWord'

	return nameAt
end 'emitTrustStoreKeyName'

function emitTrustStoreCreateKey(module StdModule, block IrBlock, nameAt ValueId, produced IrBlock, ids ValueMinter)
	let allocator = emitConst(module, block: block, value: TrustStoreNoContext, ids: ids)
	let encoding = emitConst(module, block: block, value: CfStringEncodingUtf8, ids: ids)
	let string = emitTrustStoreCall3(module, block: block, service: HostProcessCall.cfStringCreate, a0: allocator, a1: nameAt, a2: encoding, ids: ids)
	emitBranchCarrying(module, from: block, to: produced, values: argsOf(string))
end 'emitTrustStoreCreateKey'

function emitTrustStoreResolveKey(module StdModule, func IrFunction, cur IrBlock, nameAt ValueId, produced IrBlock, failed IrBlock, ids ValueMinter)
	var resolved = module.addBlock(func, label: b"tssymbol", heat: BlockHeat.normal)

	let defaultImage = emitConst(module, block: cur, value: RtldDefault, ids: ids)
	let address = emitTrustStoreCall(module, block: cur, service: HostProcessCall.lookupSymbol, a0: defaultImage, a1: nameAt, ids: ids)
	emitBranchOnCompare(module, block: cur, value: address, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: resolved, whenFalse: failed, ids: ids)

	let value = emitLoadField(module, block: resolved, record: address, offset: TrustStoreSlotWordOffset, ids: ids)
	emitBranchCarrying(module, from: resolved, to: produced, values: argsOf(value))
end 'emitTrustStoreResolveKey'

// A null key handed to a `CFDictionary` crashes, so a key that did not resolve fails the open.
function emitTrustStoreLoadKey(module StdModule, func IrFunction, cur IrBlock, header ValueId, scratch ValueId, key TrustStoreKey, failed IrBlock, ids ValueMinter) returns IrBlock
	var produced = module.addBlock(func, label: b"tskey", heat: BlockHeat.normal)
	var stored = module.addBlock(func, label: b"tskeystored", heat: BlockHeat.normal)

	let value = ids.mint()
	produced.blockArgs.push(IrBlockArg.create(value, argType: StdType.i64))

	let nameAt = emitTrustStoreKeyName(module, block: cur, scratch: scratch, key: key, ids: ids)

	if trustStoreKeyIsCreated(key) 'created'
		emitTrustStoreCreateKey(module, block: cur, nameAt: nameAt, produced: produced, ids: ids)
	end 'created' else 'exported'
		emitTrustStoreResolveKey(module, func: func, cur: cur, nameAt: nameAt, produced: produced, failed: failed, ids: ids)
	end 'exported'

	emitStoreField(module, block: produced, record: header, offset: trustStoreKeyOffset(key), value: value)
	emitBranchOnCompare(module, block: produced, value: value, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: stored, whenFalse: failed, ids: ids)

	return stored
end 'emitTrustStoreLoadKey'

// `__mm_alloc` does not zero, and a domain answering errSecNoTrustSettings writes neither its array
// nor its count, so every slot is cleared before the counts are summed or a failed open's
// `__trust_close` releases what is set.
function emitTrustStoreClearHeader(module StdModule, block IrBlock, header ValueId, ids ValueMinter)
	let cleared = emitConst(module, block: block, value: TrustStoreNoContext, ids: ids)

	for word in 0 upto trustStoreHeaderWords() 'eachWord'
		emitStoreField(module, block: block, record: header, offset: trustStoreWordOffset(TrustStoreHeaderStart, word: word), value: cleared)
	end 'eachWord'
end 'emitTrustStoreClearHeader'

function buildMacosTrustStoreOpen(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreOpenName, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create())
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var failed = module.addBlock(func, label: b"tsfailed", heat: BlockHeat.cold)
	var opened = module.addBlock(func, label: b"tsopened", heat: BlockHeat.normal)

	func.stackSize = trustStoreOpenFrameBytes()
	let scratch = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(scratch, slot: TrustStoreScratchSlot))
	let header = emitRawAlloc(module, block: entry, byteCount: emitConst(module, block: entry, value: trustStoreWordOffset(TrustStoreHeaderStart, word: trustStoreHeaderWords()) as FullRangeInt, ids: ids), ids: ids)

	emitTrustStoreClearHeader(module, block: entry, header: header, ids: ids)

	var cur = entry

	for domain in TrustStoreDomain.allCases 'eachDomain'
		cur = emitTrustStoreCopyDomain(module, func: func, cur: cur, header: header, scratch: scratch, domain: domain, ids: ids)
	end 'eachDomain'

	for key in TrustStoreKey.allCases 'eachKey'
		cur = emitTrustStoreLoadKey(module, func: func, cur: cur, header: header, scratch: scratch, key: key, failed: failed, ids: ids)
	end 'eachKey'

	let total = emitTrustStoreTotal(module, block: cur, store: header, ids: ids)
	emitBranchOnCompare(module, block: cur, value: total, pred: StdCmpPred.eq, against: TrustStoreNoCertificates, whenTrue: failed, whenFalse: opened, ids: ids)

	module.setTerminator(opened, op: StdOp.ret(header))

	_ = emitTrustStoreRuntimeCall(module, block: failed, callee: TrustStoreCloseName, args: argsOf(header), ids: ids)
	emitConstReturn(module, block: failed, value: TrustStoreNoContext, ids: ids)

	module.functions.push(func)
end 'buildMacosTrustStoreOpen'

function buildMacosTrustStoreNext(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreNextName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var advance = module.addBlock(func, label: b"tsadvance", heat: BlockHeat.normal)
	var finished = module.addBlock(func, label: b"tsfinished", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let store = 0
	let cursor = 1

	let total = emitTrustStoreTotal(module, block: entry, store: store, ids: ids)
	emitBranchOnCompareValues(module, block: entry, a: cursor, pred: StdCmpPred.lt, b: total, whenTrue: advance, whenFalse: finished, ids: ids)

	let step = emitConst(module, block: advance, value: TrustStoreCursorStep, ids: ids)
	let next = emitBin(module, block: advance, a: cursor, b: step, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(advance, op: StdOp.ret(next))

	emitConstReturn(module, block: finished, value: TrustStoreNoContext, ids: ids)

	module.functions.push(func)
end 'buildMacosTrustStoreNext'

function emitTrustEntry(module StdModule, func IrFunction, entry IrBlock, store ValueId, cursor ValueId, joined IrBlock, ids ValueMinter) returns (ValueId, ValueId, ValueId)
	var system = module.addBlock(func, label: b"tsfromsystem", heat: BlockHeat.normal)
	var beyondSystem = module.addBlock(func, label: b"tsbeyondsystem", heat: BlockHeat.normal)
	var admin = module.addBlock(func, label: b"tsfromadmin", heat: BlockHeat.normal)
	var user = module.addBlock(func, label: b"tsfromuser", heat: BlockHeat.normal)

	let arrayId = ids.mint()
	let indexId = ids.mint()
	let domainId = ids.mint()
	joined.blockArgs.push(IrBlockArg.create(arrayId, argType: StdType.i64))
	joined.blockArgs.push(IrBlockArg.create(indexId, argType: StdType.i64))
	joined.blockArgs.push(IrBlockArg.create(domainId, argType: StdType.i64))

	let firstCursor = emitConst(module, block: entry, value: TrustStoreFirstCursor, ids: ids)
	let position = emitBin(module, block: entry, a: cursor, b: firstCursor, opcode: StdBinOpcode.sub, ids: ids)
	let systemCount = emitLoadField(module, block: entry, record: store, offset: trustStoreWordOffset(TrustStoreCountsOffset, word: trustStoreDomainWord(TrustStoreDomain.system)), ids: ids)
	let adminCount = emitLoadField(module, block: entry, record: store, offset: trustStoreWordOffset(TrustStoreCountsOffset, word: trustStoreDomainWord(TrustStoreDomain.admin)), ids: ids)
	emitBranchOnCompareValues(module, block: entry, a: position, pred: StdCmpPred.lt, b: systemCount, whenTrue: system, whenFalse: beyondSystem, ids: ids)

	let systemArray = emitLoadField(module, block: system, record: store, offset: trustStoreWordOffset(TrustStoreArraysOffset, word: trustStoreDomainWord(TrustStoreDomain.system)), ids: ids)
	let systemDomain = emitConst(module, block: system, value: SecDomainSystem, ids: ids)
	emitBranchCarrying(module, from: system, to: joined, values: threeArgs(systemArray, second: position, third: systemDomain))

	let adminEnd = emitBin(module, block: beyondSystem, a: systemCount, b: adminCount, opcode: StdBinOpcode.add, ids: ids)
	emitBranchOnCompareValues(module, block: beyondSystem, a: position, pred: StdCmpPred.lt, b: adminEnd, whenTrue: admin, whenFalse: user, ids: ids)

	let adminArray = emitLoadField(module, block: admin, record: store, offset: trustStoreWordOffset(TrustStoreArraysOffset, word: trustStoreDomainWord(TrustStoreDomain.admin)), ids: ids)
	let adminIndex = emitBin(module, block: admin, a: position, b: systemCount, opcode: StdBinOpcode.sub, ids: ids)
	let adminDomain = emitConst(module, block: admin, value: SecDomainAdmin, ids: ids)
	emitBranchCarrying(module, from: admin, to: joined, values: threeArgs(adminArray, second: adminIndex, third: adminDomain))

	let userArray = emitLoadField(module, block: user, record: store, offset: trustStoreWordOffset(TrustStoreArraysOffset, word: trustStoreDomainWord(TrustStoreDomain.user)), ids: ids)
	let userIndex = emitBin(module, block: user, a: position, b: adminEnd, opcode: StdBinOpcode.sub, ids: ids)
	let userDomain = emitConst(module, block: user, value: SecDomainUser, ids: ids)
	emitBranchCarrying(module, from: user, to: joined, values: threeArgs(userArray, second: userIndex, third: userDomain))

	return (arrayId, indexId, domainId)
end 'emitTrustEntry'

function buildMacosTrustStoreCertificate(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreCertificateName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var located = module.addBlock(func, label: b"tslocated", heat: BlockHeat.normal)
	var present = module.addBlock(func, label: b"tspresent", heat: BlockHeat.normal)
	var absent = module.addBlock(func, label: b"tsabsent", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: 2)
	let store = 0
	let cursor = 1

	let (entryArray, entryIndex, _) = emitTrustEntry(module, func: func, entry: entry, store: store, cursor: cursor, joined: located, ids: ids)

	let unused = emitConst(module, block: located, value: TrustStoreNoArgument, ids: ids)
	let certificate = emitTrustStoreCall(module, block: located, service: HostProcessCall.cfArrayElement, a0: entryArray, a1: entryIndex, ids: ids)
	let data = emitTrustStoreCall(module, block: located, service: HostProcessCall.secCertificateCopyData, a0: certificate, a1: unused, ids: ids)
	emitBranchOnCompare(module, block: located, value: data, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: present, whenFalse: absent, ids: ids)

	let dataBytes = emitTrustStoreCall(module, block: present, service: HostProcessCall.cfDataLength, a0: data, a1: unused, ids: ids)
	let dataStart = emitTrustStoreCall(module, block: present, service: HostProcessCall.cfDataBytes, a0: data, a1: unused, ids: ids)
	let record = ids.mint()
	var copied = emitFreshBytesRecord(module, func: func, cur: present, record: record, src: dataStart, byteCount: dataBytes, ids: ids)
	emitTrustStoreRelease(module, block: copied, object: data, ids: ids)
	module.setTerminator(copied, op: StdOp.ret(record))

	let nothing = emitConst(module, block: absent, value: TrustStoreNoBytes, ids: ids)
	let emptyRecord = ids.mint()
	var emptied = emitFreshBytesRecord(module, func: func, cur: absent, record: emptyRecord, src: nothing, byteCount: nothing, ids: ids)
	module.setTerminator(emptied, op: StdOp.ret(emptyRecord))

	module.functions.push(func)
end 'buildMacosTrustStoreCertificate'

function buildMacosTrustStoreVerdict(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreVerdictName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var located = module.addBlock(func, label: b"tslocated", heat: BlockHeat.normal)
	var inSettings = module.addBlock(func, label: b"tsinsettings", heat: BlockHeat.normal)
	var evaluate = module.addBlock(func, label: b"tsevaluate", heat: BlockHeat.normal)
	var rootResult = module.addBlock(func, label: b"tsresultroot", heat: BlockHeat.normal)
	var checkAsRoot = module.addBlock(func, label: b"tscheckasroot", heat: BlockHeat.normal)
	var asRootResult = module.addBlock(func, label: b"tsresultasroot", heat: BlockHeat.normal)
	var checkDeny = module.addBlock(func, label: b"tscheckdeny", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let store = 0
	let cursor = 1

	let (entryArray, entryIndex, entryDomain) = emitTrustEntry(module, func: func, entry: entry, store: store, cursor: cursor, joined: located, ids: ids)

	var system = module.addBlock(func, label: b"tsissystem", heat: BlockHeat.normal)
	emitBranchOnCompare(module, block: located, value: entryDomain, pred: StdCmpPred.eq, against: SecDomainSystem, whenTrue: system, whenFalse: inSettings, ids: ids)
	emitConstReturn(module, block: system, value: TrustVerdictRoot, ids: ids)

	let unused = emitConst(module, block: inSettings, value: TrustStoreNoArgument, ids: ids)
	let certificate = emitTrustStoreCall(module, block: inSettings, service: HostProcessCall.cfArrayElement, a0: entryArray, a1: entryIndex, ids: ids)
	emitBranchOnCompare(module, block: inSettings, value: certificate, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: evaluate, whenFalse: checkDeny, ids: ids)

	let result = emitTrustStoreRuntimeCall(module, block: evaluate, callee: TrustStoreSslResultName, args: twoArgs(store, second: certificate), ids: ids)
	emitBranchOnCompare(module, block: evaluate, value: result, pred: StdCmpPred.eq, against: SecResultTrustRoot, whenTrue: rootResult, whenFalse: checkAsRoot, ids: ids)
	emitConstReturn(module, block: rootResult, value: TrustVerdictRoot, ids: ids)

	emitBranchOnCompare(module, block: checkAsRoot, value: result, pred: StdCmpPred.eq, against: SecResultTrustAsRoot, whenTrue: asRootResult, whenFalse: checkDeny, ids: ids)
	emitConstReturn(module, block: asRootResult, value: TrustVerdictNonRoot, ids: ids)

	var denied = module.addBlock(func, label: b"tsdenied", heat: BlockHeat.normal)
	var ignored = module.addBlock(func, label: b"tsignored", heat: BlockHeat.normal)
	let decision = ids.mint()
	checkDeny.blockArgs.push(IrBlockArg.create(decision, argType: StdType.i64))
	emitBranchOnCompare(module, block: checkDeny, value: decision, pred: StdCmpPred.eq, against: SecResultDeny, whenTrue: denied, whenFalse: ignored, ids: ids)
	emitConstReturn(module, block: denied, value: TrustVerdictDenied, ids: ids)
	emitConstReturn(module, block: ignored, value: TrustVerdictIgnored, ids: ids)

	pushBranchEdge(inSettings, to: checkDeny, values: argsOf(unused))
	pushBranchEdge(checkAsRoot, to: checkDeny, values: argsOf(result))

	module.functions.push(func)
end 'buildMacosTrustStoreVerdict'

function buildTrustSslPolicy(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreIsSslPolicyName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var named = module.addBlock(func, label: b"tspolicy", heat: BlockHeat.normal)
	var described = module.addBlock(func, label: b"tsproperties", heat: BlockHeat.normal)
	var hasOid = module.addBlock(func, label: b"tshasoid", heat: BlockHeat.normal)
	var noOid = module.addBlock(func, label: b"tsnooid", heat: BlockHeat.normal)
	var absentOid = module.addBlock(func, label: b"tsabsentoid", heat: BlockHeat.normal)
	var finish = module.addBlock(func, label: b"tspolicydone", heat: BlockHeat.normal)

	func.stackSize = TrustStoreSettingsFrameBytes
	emitParams(module, block: entry, count: 2)
	let store = 0
	let policy = 1

	let scratch = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(scratch, slot: TrustStoreScratchSlot))
	emitBranchOnCompare(module, block: entry, value: policy, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: named, whenFalse: noOid, ids: ids)

	let unused = emitConst(module, block: named, value: TrustStoreNoArgument, ids: ids)
	let properties = emitTrustStoreCall(module, block: named, service: HostProcessCall.secPolicyCopyProperties, a0: policy, a1: unused, ids: ids)
	emitBranchOnCompare(module, block: named, value: properties, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: described, whenFalse: noOid, ids: ids)

	emitStoreField(module, block: described, record: scratch, offset: TrustStoreOutOffset, value: emitConst(module, block: described, value: TrustStoreNoContext, ids: ids))
	let oidKey = emitLoadField(module, block: described, record: store, offset: trustStoreKeyOffset(TrustStoreKey.policyOid), ids: ids)
	let present = emitTrustStoreCall3(module, block: described, service: HostProcessCall.cfDictionaryGetValueIfPresent, a0: properties, a1: oidKey, a2: scratch, ids: ids)
	emitBranchOnCompare(module, block: described, value: emitTrustStoreBoolean(module, block: described, raw: present, ids: ids), pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: hasOid, whenFalse: absentOid, ids: ids)

	emitTrustStoreRelease(module, block: absentOid, object: properties, ids: ids)
	let absentFlag = emitConst(module, block: absentOid, value: TrustStoreFalseFlag, ids: ids)
	emitBranchCarrying(module, from: absentOid, to: finish, values: argsOf(absentFlag))

	let oidValue = emitLoadField(module, block: hasOid, record: scratch, offset: TrustStoreOutOffset, ids: ids)
	let sslValue = emitLoadField(module, block: hasOid, record: store, offset: trustStoreKeyOffset(TrustStoreKey.appleSsl), ids: ids)
	let equal = emitTrustStoreCall(module, block: hasOid, service: HostProcessCall.cfEqual, a0: oidValue, a1: sslValue, ids: ids)
	let equalFlag = emitTrustStoreBoolean(module, block: hasOid, raw: equal, ids: ids)
	emitTrustStoreRelease(module, block: hasOid, object: properties, ids: ids)
	emitBranchCarrying(module, from: hasOid, to: finish, values: argsOf(equalFlag))

	let notSsl = emitConst(module, block: noOid, value: TrustStoreFalseFlag, ids: ids)
	emitBranchCarrying(module, from: noOid, to: finish, values: argsOf(notSsl))

	let flag = ids.mint()
	finish.blockArgs.push(IrBlockArg.create(flag, argType: StdType.i64))
	module.setTerminator(finish, op: StdOp.ret(flag))

	module.functions.push(func)
end 'buildTrustSslPolicy'

// The SSL trust result of a certificate in the admin or user domain. The user domain's settings
// answer when they load and are non-null, otherwise the admin domain's; none leaves the result
// unspecified. An empty settings array is TrustRoot. In a non-empty one, a dictionary bound to another
// policy or to a policy string (a host name) is skipped, a missing result key reads TrustRoot, and the
// first TrustRoot, TrustAsRoot or Deny ends the walk. A walk that matched nothing is unspecified.
function buildTrustSslResult(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreSslResultName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var userAnswered = module.addBlock(func, label: b"tsuseranswered", heat: BlockHeat.normal)
	var askAdmin = module.addBlock(func, label: b"tsaskadmin", heat: BlockHeat.normal)
	var adminAnswered = module.addBlock(func, label: b"tsadminanswered", heat: BlockHeat.normal)
	var dropUser = module.addBlock(func, label: b"tsdropuser", heat: BlockHeat.normal)
	var dropAdmin = module.addBlock(func, label: b"tsdropadmin", heat: BlockHeat.normal)
	var settingsHeld = module.addBlock(func, label: b"tssettings", heat: BlockHeat.normal)
	var emptySettings = module.addBlock(func, label: b"tsemptysettings", heat: BlockHeat.normal)
	var walk = module.addBlock(func, label: b"tswalk", heat: BlockHeat.normal)
	var header = module.addBlock(func, label: b"tswalkheader", heat: BlockHeat.normal)
	var body = module.addBlock(func, label: b"tswalkbody", heat: BlockHeat.normal)
	var constrained = module.addBlock(func, label: b"tswalkpolicy", heat: BlockHeat.normal)
	var checkPolicyString = module.addBlock(func, label: b"tswalkpolicystring", heat: BlockHeat.normal)
	var readResult = module.addBlock(func, label: b"tswalkresult", heat: BlockHeat.normal)
	var numbered = module.addBlock(func, label: b"tswalknumber", heat: BlockHeat.normal)
	var defaulted = module.addBlock(func, label: b"tswalkdefault", heat: BlockHeat.normal)
	var decided = module.addBlock(func, label: b"tswalkdecided", heat: BlockHeat.normal)
	var checkHigh = module.addBlock(func, label: b"tswalkhigh", heat: BlockHeat.normal)
	var step = module.addBlock(func, label: b"tswalkstep", heat: BlockHeat.normal)
	var finished = module.addBlock(func, label: b"tswalkfinished", heat: BlockHeat.normal)
	var unmatched = module.addBlock(func, label: b"tswalkunmatched", heat: BlockHeat.normal)
	var walkExit = module.addBlock(func, label: b"tswalkexit", heat: BlockHeat.normal)
	var unspecified = module.addBlock(func, label: b"tsunspecified", heat: BlockHeat.normal)

	func.stackSize = TrustStoreSettingsFrameBytes
	emitParams(module, block: entry, count: 2)
	let store = 0
	let certificate = 1

	let scratch = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(scratch, slot: TrustStoreScratchSlot))

	emitStoreField(module, block: entry, record: scratch, offset: TrustStoreOutOffset, value: emitConst(module, block: entry, value: TrustStoreNoContext, ids: ids))
	let userDomain = emitConst(module, block: entry, value: SecDomainUser, ids: ids)
	let userStatus = emitTrustStoreCall3(module, block: entry, service: HostProcessCall.secTrustSettingsCopyTrustSettings, a0: certificate, a1: userDomain, a2: scratch, ids: ids)
	let userSettings = emitLoadField(module, block: entry, record: scratch, offset: TrustStoreOutOffset, ids: ids)
	emitBranchOnCompare(module, block: entry, value: userStatus, pred: StdCmpPred.eq, against: TrustStoreSuccessStatus, whenTrue: userAnswered, whenFalse: dropUser, ids: ids)
	emitBranchOnCompare(module, block: userAnswered, value: userSettings, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: settingsHeld, whenFalse: dropUser, ids: ids)
	pushBranchEdge(userAnswered, to: settingsHeld, values: argsOf(userSettings))

	emitTrustStoreReleaseIfHeld(module, func: func, cur: dropUser, held: userSettings, done: askAdmin, label: b"tsreleaseuser", ids: ids)

	emitStoreField(module, block: askAdmin, record: scratch, offset: TrustStoreOutOffset, value: emitConst(module, block: askAdmin, value: TrustStoreNoContext, ids: ids))
	let adminDomain = emitConst(module, block: askAdmin, value: SecDomainAdmin, ids: ids)
	let adminStatus = emitTrustStoreCall3(module, block: askAdmin, service: HostProcessCall.secTrustSettingsCopyTrustSettings, a0: certificate, a1: adminDomain, a2: scratch, ids: ids)
	let adminSettings = emitLoadField(module, block: askAdmin, record: scratch, offset: TrustStoreOutOffset, ids: ids)
	emitBranchOnCompare(module, block: askAdmin, value: adminStatus, pred: StdCmpPred.eq, against: TrustStoreSuccessStatus, whenTrue: adminAnswered, whenFalse: dropAdmin, ids: ids)
	emitBranchOnCompare(module, block: adminAnswered, value: adminSettings, pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: settingsHeld, whenFalse: dropAdmin, ids: ids)
	pushBranchEdge(adminAnswered, to: settingsHeld, values: argsOf(adminSettings))

	emitTrustStoreReleaseIfHeld(module, func: func, cur: dropAdmin, held: adminSettings, done: unspecified, label: b"tsreleaseadmin", ids: ids)

	let settings = ids.mint()
	settingsHeld.blockArgs.push(IrBlockArg.create(settings, argType: StdType.i64))
	let unused = emitConst(module, block: settingsHeld, value: TrustStoreNoArgument, ids: ids)
	let count = emitTrustStoreCall(module, block: settingsHeld, service: HostProcessCall.cfArrayCount, a0: settings, a1: unused, ids: ids)
	emitBranchOnCompare(module, block: settingsHeld, value: count, pred: StdCmpPred.eq, against: TrustStoreNoCertificates, whenTrue: emptySettings, whenFalse: walk, ids: ids)

	emitTrustStoreRelease(module, block: emptySettings, object: settings, ids: ids)
	emitConstReturn(module, block: emptySettings, value: SecResultTrustRoot, ids: ids)

	let first = emitConst(module, block: walk, value: TrustStoreFirstMember, ids: ids)
	emitBranchCarrying(module, from: walk, to: header, values: twoArgs(first, second: first))

	let member = ids.mint()
	let latest = ids.mint()
	header.blockArgs.push(IrBlockArg.create(member, argType: StdType.i64))
	header.blockArgs.push(IrBlockArg.create(latest, argType: StdType.i64))
	emitBranchOnCompareValues(module, block: header, a: member, pred: StdCmpPred.ge, b: count, whenTrue: finished, whenFalse: body, ids: ids)

	let setting = emitTrustStoreCall(module, block: body, service: HostProcessCall.cfArrayElement, a0: settings, a1: member, ids: ids)
	emitStoreField(module, block: body, record: scratch, offset: TrustStoreOutOffset, value: emitConst(module, block: body, value: TrustStoreNoContext, ids: ids))
	let policyKey = emitLoadField(module, block: body, record: store, offset: trustStoreKeyOffset(TrustStoreKey.policy), ids: ids)
	let policyPresent = emitTrustStoreCall3(module, block: body, service: HostProcessCall.cfDictionaryGetValueIfPresent, a0: setting, a1: policyKey, a2: scratch, ids: ids)
	emitBranchOnCompare(module, block: body, value: emitTrustStoreBoolean(module, block: body, raw: policyPresent, ids: ids), pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: constrained, whenFalse: checkPolicyString, ids: ids)

	let policy = emitLoadField(module, block: constrained, record: scratch, offset: TrustStoreOutOffset, ids: ids)
	let isSsl = emitTrustStoreRuntimeCall(module, block: constrained, callee: TrustStoreIsSslPolicyName, args: twoArgs(store, second: policy), ids: ids)
	emitBranchOnCompare(module, block: constrained, value: isSsl, pred: StdCmpPred.ne, against: TrustStoreNotSslPolicy, whenTrue: checkPolicyString, whenFalse: step, ids: ids)
	pushBranchEdge(constrained, to: step, values: argsOf(latest))

	let policyStringKey = emitLoadField(module, block: checkPolicyString, record: store, offset: trustStoreKeyOffset(TrustStoreKey.policyString), ids: ids)
	let hostnameBound = emitTrustStoreCall(module, block: checkPolicyString, service: HostProcessCall.cfDictionaryContainsKey, a0: setting, a1: policyStringKey, ids: ids)
	emitBranchOnCompare(module, block: checkPolicyString, value: emitTrustStoreBoolean(module, block: checkPolicyString, raw: hostnameBound, ids: ids), pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: step, whenFalse: readResult, ids: ids)
	pushBranchEdge(checkPolicyString, to: step, values: argsOf(latest))

	emitStoreField(module, block: readResult, record: scratch, offset: TrustStoreOutOffset, value: emitConst(module, block: readResult, value: TrustStoreNoContext, ids: ids))
	let resultKey = emitLoadField(module, block: readResult, record: store, offset: trustStoreKeyOffset(TrustStoreKey.result), ids: ids)
	let resultPresent = emitTrustStoreCall3(module, block: readResult, service: HostProcessCall.cfDictionaryGetValueIfPresent, a0: setting, a1: resultKey, a2: scratch, ids: ids)
	emitBranchOnCompare(module, block: readResult, value: emitTrustStoreBoolean(module, block: readResult, raw: resultPresent, ids: ids), pred: StdCmpPred.ne, against: TrustStoreNoContext, whenTrue: numbered, whenFalse: defaulted, ids: ids)

	let number = emitLoadField(module, block: numbered, record: scratch, offset: TrustStoreOutOffset, ids: ids)
	emitStoreField(module, block: numbered, record: scratch, offset: TrustStoreNumberOffset as ByteOffset, value: emitConst(module, block: numbered, value: TrustStoreNoContext, ids: ids))
	let numberAt = emitBin(module, block: numbered, a: scratch, b: emitConst(module, block: numbered, value: TrustStoreNumberOffset, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	let numberType = emitConst(module, block: numbered, value: CfNumberSInt32Type, ids: ids)
	_ = emitTrustStoreCall3(module, block: numbered, service: HostProcessCall.cfNumberGetValue, a0: number, a1: numberType, a2: numberAt, ids: ids)
	let wide = emitLoadField(module, block: numbered, record: scratch, offset: TrustStoreNumberOffset as ByteOffset, ids: ids)
	let narrow = emitBin(module, block: numbered, a: wide, b: emitConst(module, block: numbered, value: TrustStoreLowDwordMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	emitBranchCarrying(module, from: numbered, to: decided, values: argsOf(narrow))

	let assumed = emitConst(module, block: defaulted, value: SecResultTrustRoot, ids: ids)
	emitBranchCarrying(module, from: defaulted, to: decided, values: argsOf(assumed))

	let result = ids.mint()
	decided.blockArgs.push(IrBlockArg.create(result, argType: StdType.i64))
	emitBranchOnCompare(module, block: decided, value: result, pred: StdCmpPred.lt, against: SecResultTrustRoot, whenTrue: step, whenFalse: checkHigh, ids: ids)
	pushBranchEdge(decided, to: step, values: argsOf(result))
	emitBranchOnCompare(module, block: checkHigh, value: result, pred: StdCmpPred.gt, against: SecResultDeny, whenTrue: step, whenFalse: walkExit, ids: ids)
	pushBranchEdge(checkHigh, to: step, values: argsOf(result))
	pushBranchEdge(checkHigh, to: walkExit, values: argsOf(result))

	let carried = ids.mint()
	step.blockArgs.push(IrBlockArg.create(carried, argType: StdType.i64))
	let advanceBy = emitConst(module, block: step, value: TrustStoreMemberStep, ids: ids)
	let nextMember = emitBin(module, block: step, a: member, b: advanceBy, opcode: StdBinOpcode.add, ids: ids)
	emitBranchCarrying(module, from: step, to: header, values: twoArgs(nextMember, second: carried))

	emitBranchOnCompare(module, block: finished, value: latest, pred: StdCmpPred.eq, against: TrustStoreNoResult, whenTrue: unmatched, whenFalse: walkExit, ids: ids)
	pushBranchEdge(finished, to: walkExit, values: argsOf(latest))

	let fallback = emitConst(module, block: unmatched, value: SecResultUnspecified, ids: ids)
	emitBranchCarrying(module, from: unmatched, to: walkExit, values: argsOf(fallback))

	let answer = ids.mint()
	walkExit.blockArgs.push(IrBlockArg.create(answer, argType: StdType.i64))
	emitTrustStoreRelease(module, block: walkExit, object: settings, ids: ids)
	module.setTerminator(walkExit, op: StdOp.ret(answer))

	emitConstReturn(module, block: unspecified, value: SecResultUnspecified, ids: ids)

	module.functions.push(func)
end 'buildTrustSslResult'

function buildMacosTrustStoreClose(module StdModule)
	var func = IrFunction.createFromStd(TrustStoreCloseName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param())
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let store = 0

	var cur = entry

	for domain in TrustStoreDomain.allCases 'eachArray'
		cur = emitTrustStoreReleaseSlot(module, func: func, cur: cur, store: store, offset: trustStoreWordOffset(TrustStoreArraysOffset, word: trustStoreDomainWord(domain)), ids: ids)
	end 'eachArray'

	for key in TrustStoreKey.allCases 'eachKey'
		if trustStoreKeyIsCreated(key) 'created'
			cur = emitTrustStoreReleaseSlot(module, func: func, cur: cur, store: store, offset: trustStoreKeyOffset(key), ids: ids)
		end 'created'
	end 'eachKey'

	emitRawFree(module, block: cur, ptr: store, ids: ids)
	module.setTerminator(cur, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildMacosTrustStoreClose'

function installMacosTrustStore(module StdModule)
	if TrustStoreDomain.allCases.count() != SecDomainCount 'domainCount'
		panic("installMacosTrustStore: the store header is laid out for {SecDomainCount} domains and TrustStoreDomain names {TrustStoreDomain.allCases.count()}")
	end 'domainCount'

	buildMacosTrustStoreOpen(module)
	buildMacosTrustStoreNext(module)
	buildMacosTrustStoreCertificate(module)
	buildMacosTrustStoreVerdict(module)
	buildTrustSslResult(module)
	buildTrustSslPolicy(module)
	buildMacosTrustStoreClose(module)
end 'installMacosTrustStore'

export function installTrustStoreRuntime(module StdModule, usage RuntimeUsage, target Target)
	if not usage.usesTrustStore 'noTrustStore'
		return
	end 'noTrustStore'

	if not targetProvidesFacility(target, facility: HostFacility.trustStore) 'noSubstrate'
		return
	end 'noSubstrate'

	if target.os == Os.windows 'windows'
		installWindowsTrustStore(module)
	end 'windows' else if target.os == Os.macos 'macos'
		installMacosTrustStore(module)
	end 'macos' else 'noRoute'
		panic("installTrustStoreRuntime: {targetToString(target)} answers the trustStore facility true, but only Windows and macOS read their store through the runtime")
	end 'noRoute'
end 'installTrustStoreRuntime'
