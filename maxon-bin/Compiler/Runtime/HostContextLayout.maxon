let DebuggeeStdlibFileName = "Debuggee.maxon"
let SamplerStdlibFileName = "Sampler.maxon"

let Win64ContextFlagsOffsetName = "Win64ContextFlagsOffset"
let Win64ContextControlName = "Win64ContextControl"
let Win64ContextIntegerName = "Win64ContextInteger"
let Win64ContextRipOffsetName = "Win64ContextRipOffset"
let Win64ContextRspOffsetName = "Win64ContextRspOffset"
let Win64ContextRbpOffsetName = "Win64ContextRbpOffset"
let SuspendThreadFailedName = "SuspendThreadFailed"

let SampleContextRipOffsetName = "SampleContextRipOffset"
let SampleContextRspOffsetName = "SampleContextRspOffset"
let SampleContextRbpOffsetName = "SampleContextRbpOffset"
let ProfileRegionRecordBytesName = "ProfileRegionRecordBytes"
let ProfileRegionAllocationBaseOffsetName = "ProfileRegionAllocationBaseOffset"
let ProfileRegionSuspendedCyclesOffsetName = "ProfileRegionSuspendedCyclesOffset"
let ProfileSavedFrameCodeBaseOffsetName = "ProfileSavedFrameCodeBaseOffset"
let ProfileSavedFrameCodeBytesOffsetName = "ProfileSavedFrameCodeBytesOffset"
let ProfileSavedFrameSlotBaseOffsetName = "ProfileSavedFrameSlotBaseOffset"
let ProfileSavedFrameRecordFieldOffsetName = "ProfileSavedFrameRecordFieldOffset"
let ProfileSavedFrameCopyOffsetName = "ProfileSavedFrameCopyOffset"
let ProfileSavedFramePcWordName = "ProfileSavedFramePcWord"
let ProfileSavedFrameSpWordName = "ProfileSavedFrameSpWord"
let ProfileSavedFrameFpWordName = "ProfileSavedFrameFpWord"
let ProfileSavedFrameWindowBytesOffsetName = "ProfileSavedFrameWindowBytesOffset"
let ProfileSavedFrameFixedRecordOffsetName = "ProfileSavedFrameFixedRecordOffset"
let ProfileSavedFrameWindowAddressOffsetName = "ProfileSavedFrameWindowAddressOffset"
let ProfileSampleThreadGoneName = "ProfileSampleThreadGone"
let ProfileSampleNoRegistersName = "ProfileSampleNoRegisters"
let ProfileSampleCallingThreadName = "ProfileSampleCallingThread"

let MachSuccessName = "MachSuccess"
let MachStateStackPointerOffsetName = "MachStateStackPointerOffset"
let MachStateFramePointerOffsetName = "MachStateFramePointerOffset"
let MachStateProgramCounterOffsetName = "MachStateProgramCounterOffset"

// x4 of the thread state: the signal's ucontext argument, still in place at the trampoline's entry.
let MachStateSignalContextOffset = 32
let MachStateTrampolineOffsetName = "MachStateTrampolineOffset"
let MachStateLinkRegisterOffsetName = "MachStateLinkRegisterOffset"
let MachThreadStateCountUnitBytes = 4
let MachObjectTerminated = 37
let MachThreadInfoFlavorName = "MachThreadBasicInfo"
let MachThreadInfoWordsName = "MachThreadBasicInfoWords"
let StackReadChunkBytesName = "StackReadChunkBytes"

let Win64MbiBaseAddressOffset = 0
let Win64MbiRegionSizeOffset = 24
let Win64SavedFrameThreadInfoOffset = 128
let Win64SavedFrameWordsOffset = 176
let Win64SavedFrameRegionOffset = 192
let Win64SavedFrameRecordAddressOffset = 248
let MachArmThreadState64 = 6
let MachArmThreadState64Words = 68
let SeizedTablePidOffset = 0
let SeizedTablePinOffset = 16
let SeizedTableKilledOffset = 24
let TraceKillSignal = 9

let SeizedTableBytesName = "SeizedTableBytes"
let SeizedTableCountOffsetName = "SeizedTableCountOffset"
let SeizedTableThreadsOffsetName = "SeizedTableThreadsOffset"
let SeizedWordBytesName = "SeizedWordBytes"
let PtraceDetachName = "PtraceDetach"
let PtraceInterruptName = "PtraceInterrupt"
let TraceStopBudgetMillisName = "TraceStopBudgetMillis"

// The Win64 `CONTEXT` and region-record layout, the Mach thread-state layout and the ptrace seized-thread
// table that the runtime shares with `stdlib/Debuggee.maxon` and `stdlib/Sampler.maxon`, read from those
// files' own constants so the compiler holds no second copy to drift. The saved-frame scratch offsets
// (`Win64SavedFrame*Offset`) and the record size are the exception: they are held here and checked
// against the sampler's own words. Which sampler layout a lane reads is
// `ProfileRuntime.profileHostShapeOf`'s answer, the one the entries are built by.
export type HostContextLayout
	export var contextFlagsOffset as FullRangeInt
	export var contextControl as FullRangeInt
	export var contextInteger as FullRangeInt
	export var contextRipOffset as FullRangeInt
	export var contextRspOffset as FullRangeInt
	export var contextRbpOffset as FullRangeInt
	export var suspendThreadFailed as FullRangeInt
	export var regionRecordBytes as FullRangeInt
	export var mbiBaseAddressOffset as FullRangeInt
	export var regionAllocationBaseOffset as FullRangeInt
	export var mbiRegionSizeOffset as FullRangeInt
	export var regionSuspendedCyclesOffset as FullRangeInt
	export var savedFrameCodeBaseOffset as FullRangeInt
	export var savedFrameCodeBytesOffset as FullRangeInt
	export var savedFrameSlotBaseOffset as FullRangeInt
	export var savedFrameRecordFieldOffset as FullRangeInt
	export var savedFrameCopyOffset as FullRangeInt
	export var savedFrameRecordBytes as FullRangeInt
	export var savedFramePcWord as FullRangeInt
	export var savedFrameSpWord as FullRangeInt
	export var savedFrameWindowBytesOffset as FullRangeInt
	export var savedFrameThreadInfoOffset as FullRangeInt
	export var savedFrameWordsOffset as FullRangeInt
	export var savedFrameRegionOffset as FullRangeInt
	export var savedFrameFixedRecordOffset as FullRangeInt
	export var savedFrameRecordAddressOffset as FullRangeInt
	export var savedFrameWindowAddressOffset as FullRangeInt
	export var sampleThreadGone as FullRangeInt
	export var sampleNoRegisters as FullRangeInt
	export var sampleCallingThread as FullRangeInt
	export var machSuccess as FullRangeInt
	export var machThreadStateFlavor as FullRangeInt
	export var machThreadStateWords as FullRangeInt
	export var machStateStackPointerOffset as FullRangeInt
	export var machStateFramePointerOffset as FullRangeInt
	export var machStateProgramCounterOffset as FullRangeInt
	export var machStateSignalContextOffset as FullRangeInt
	export var machStateTrampolineOffset as FullRangeInt
	export var machContextPointerOffset as FullRangeInt
	export var machContextRegistersOffset as FullRangeInt
	export var machContextRegisterBytes as FullRangeInt
	export var machObjectTerminated as FullRangeInt
	export var machThreadInfoFlavor as FullRangeInt
	export var machThreadInfoWords as FullRangeInt
	export var machChunkBytes as FullRangeInt
	export var seizedTableBytes as FullRangeInt
	export var seizedPidOffset as FullRangeInt
	export var seizedCountOffset as FullRangeInt
	export var seizedPinOffset as FullRangeInt
	export var seizedKilledOffset as FullRangeInt
	export var seizedThreadsOffset as FullRangeInt
	export var seizedWordBytes as FullRangeInt
	export var traceKillSignal as FullRangeInt
	export var ptraceDetach as FullRangeInt
	export var ptraceInterrupt as FullRangeInt
	export var traceStopBudgetMillis as FullRangeInt

	export static function read(signatures ProgramSignatures, target Target, project Project) returns HostContextLayout
		let debuggee = librarySourcePath(project, fileName: DebuggeeStdlibFileName)
		let ripOffset = signatures.integerConstantIn(Win64ContextRipOffsetName, filePath: debuggee)
		let rspOffset = signatures.integerConstantIn(Win64ContextRspOffsetName, filePath: debuggee)
		let rbpOffset = signatures.integerConstantIn(Win64ContextRbpOffsetName, filePath: debuggee)

		let layout = Self.unread()
		layout.contextFlagsOffset = signatures.integerConstantIn(Win64ContextFlagsOffsetName, filePath: debuggee)
		layout.contextControl = signatures.integerConstantIn(Win64ContextControlName, filePath: debuggee)
		layout.contextInteger = signatures.integerConstantIn(Win64ContextIntegerName, filePath: debuggee)
		layout.contextRipOffset = ripOffset
		layout.contextRspOffset = rspOffset
		layout.contextRbpOffset = rbpOffset
		layout.suspendThreadFailed = signatures.integerConstantIn(SuspendThreadFailedName, filePath: debuggee)

		let shape = try profileHostShapeOf(target) otherwise 'noSampler'
			return layout
		end 'noSampler'

		let sampler = librarySourcePath(project, fileName: SamplerStdlibFileName)

		match shape 'shape'
			win32 then layout.readWin32Sampler(signatures, sampler: sampler, debuggeeRip: ripOffset, debuggeeRsp: rspOffset, debuggeeRbp: rbpOffset)
			mach then layout.readMachSampler(signatures, sampler: sampler)
			ptrace then layout.readPtraceSampler(signatures, sampler: sampler, debuggee: debuggee)
		end 'shape'

		return layout
	end 'read'

	function readWin32Sampler(signatures ProgramSignatures, sampler FilePath, debuggeeRip FullRangeInt, debuggeeRsp FullRangeInt, debuggeeRbp FullRangeInt)
		if signatures.integerConstantIn(SampleContextRipOffsetName, filePath: sampler) != debuggeeRip or signatures.integerConstantIn(SampleContextRspOffsetName, filePath: sampler) != debuggeeRsp or signatures.integerConstantIn(SampleContextRbpOffsetName, filePath: sampler) != debuggeeRbp 'contextOffsetsDrifted'
			panic("HostContextLayout.read: {SamplerStdlibFileName} states the CONTEXT register offsets differently from {DebuggeeStdlibFileName} — the debugger and the sampler read one Win64 CONTEXT record, so the two files' constants must agree")
		end 'contextOffsetsDrifted'

		self.regionRecordBytes = signatures.integerConstantIn(ProfileRegionRecordBytesName, filePath: sampler)
		self.mbiBaseAddressOffset = Win64MbiBaseAddressOffset
		self.regionAllocationBaseOffset = signatures.integerConstantIn(ProfileRegionAllocationBaseOffsetName, filePath: sampler)
		self.mbiRegionSizeOffset = Win64MbiRegionSizeOffset
		self.regionSuspendedCyclesOffset = signatures.integerConstantIn(ProfileRegionSuspendedCyclesOffsetName, filePath: sampler)
		self.savedFrameCodeBaseOffset = signatures.integerConstantIn(ProfileSavedFrameCodeBaseOffsetName, filePath: sampler)
		self.savedFrameCodeBytesOffset = signatures.integerConstantIn(ProfileSavedFrameCodeBytesOffsetName, filePath: sampler)
		self.savedFrameSlotBaseOffset = signatures.integerConstantIn(ProfileSavedFrameSlotBaseOffsetName, filePath: sampler)
		self.savedFrameRecordFieldOffset = signatures.integerConstantIn(ProfileSavedFrameRecordFieldOffsetName, filePath: sampler)
		self.savedFrameCopyOffset = signatures.integerConstantIn(ProfileSavedFrameCopyOffsetName, filePath: sampler)
		self.savedFrameRecordBytes = (MOffSavedFrameFp - MOffSavedFramePc + MachineWordBytes) as FullRangeInt
		self.savedFramePcWord = signatures.integerConstantIn(ProfileSavedFramePcWordName, filePath: sampler)
		self.savedFrameSpWord = signatures.integerConstantIn(ProfileSavedFrameSpWordName, filePath: sampler)
		self.savedFrameWindowBytesOffset = signatures.integerConstantIn(ProfileSavedFrameWindowBytesOffsetName, filePath: sampler)
		self.savedFrameFixedRecordOffset = signatures.integerConstantIn(ProfileSavedFrameFixedRecordOffsetName, filePath: sampler)
		self.savedFrameWindowAddressOffset = signatures.integerConstantIn(ProfileSavedFrameWindowAddressOffsetName, filePath: sampler)
		self.savedFrameThreadInfoOffset = Win64SavedFrameThreadInfoOffset
		self.savedFrameWordsOffset = Win64SavedFrameWordsOffset
		self.savedFrameRegionOffset = Win64SavedFrameRegionOffset
		self.savedFrameRecordAddressOffset = Win64SavedFrameRecordAddressOffset

		if (MOffSavedFrameSp - MOffSavedFramePc) as FullRangeInt != self.savedFrameSpWord - self.savedFramePcWord or (MOffSavedFrameFp - MOffSavedFramePc) as FullRangeInt != signatures.integerConstantIn(ProfileSavedFrameFpWordName, filePath: sampler) - self.savedFramePcWord or self.savedFrameCopyOffset + self.savedFrameRecordBytes > self.savedFrameWindowBytesOffset 'savedFrameDrifted'
			panic("HostContextLayout.readWin32Sampler: {SamplerStdlibFileName} lays out the saved frame's program counter, stack pointer and frame pointer differently from the machine record in SchedRuntime — `__prof_sample` copies the record's words into its scratch as one block, so the two layouts must agree")
		end 'savedFrameDrifted'

		if self.savedFrameThreadInfoOffset < self.savedFrameWindowBytesOffset + (MachineWordBytes as FullRangeInt) or self.savedFrameRegionOffset + self.regionRecordBytes > self.savedFrameFixedRecordOffset or self.savedFrameRecordAddressOffset + (MachineWordBytes as FullRangeInt) > self.savedFrameWindowAddressOffset 'savedFrameScratchOverlaps'
			panic("HostContextLayout.readWin32Sampler: the scratch words `__prof_sample` keeps for the saved frame (thread information, slot words, second region record, record address) overlap the ones {SamplerStdlibFileName} reads — the two files share one scratch block, so the offsets must not collide")
		end 'savedFrameScratchOverlaps'

		self.sampleThreadGone = signatures.integerConstantIn(ProfileSampleThreadGoneName, filePath: sampler)
		self.sampleNoRegisters = signatures.integerConstantIn(ProfileSampleNoRegistersName, filePath: sampler)
	end 'readWin32Sampler'

	function readMachSampler(signatures ProgramSignatures, sampler FilePath)
		self.sampleThreadGone = signatures.integerConstantIn(ProfileSampleThreadGoneName, filePath: sampler)
		self.sampleNoRegisters = signatures.integerConstantIn(ProfileSampleNoRegistersName, filePath: sampler)
		self.sampleCallingThread = signatures.integerConstantIn(ProfileSampleCallingThreadName, filePath: sampler)
		self.machSuccess = signatures.integerConstantIn(MachSuccessName, filePath: sampler)
		self.machThreadStateFlavor = MachArmThreadState64
		self.machThreadStateWords = MachArmThreadState64Words
		self.machStateStackPointerOffset = signatures.integerConstantIn(MachStateStackPointerOffsetName, filePath: sampler)
		self.machStateFramePointerOffset = signatures.integerConstantIn(MachStateFramePointerOffsetName, filePath: sampler)
		self.machStateProgramCounterOffset = signatures.integerConstantIn(MachStateProgramCounterOffsetName, filePath: sampler)
		self.machStateSignalContextOffset = MachStateSignalContextOffset
		self.machStateTrampolineOffset = signatures.integerConstantIn(MachStateTrampolineOffsetName, filePath: sampler)
		self.machContextPointerOffset = DarwinUcontextOffMcontext as FullRangeInt
		self.machContextRegistersOffset = DarwinMcontextOffSsFp as FullRangeInt
		self.machContextRegisterBytes = (DarwinMcontextOffSsPc as FullRangeInt) + (MachineWordBytes as FullRangeInt) - self.machContextRegistersOffset
		self.machObjectTerminated = MachObjectTerminated
		let linkRegisterOffset = signatures.integerConstantIn(MachStateLinkRegisterOffsetName, filePath: sampler)

		if (DarwinMcontextOffSsLr as FullRangeInt) - self.machContextRegistersOffset != linkRegisterOffset - self.machStateFramePointerOffset or (DarwinMcontextOffSsSp as FullRangeInt) - self.machContextRegistersOffset != self.machStateStackPointerOffset - self.machStateFramePointerOffset or (DarwinMcontextOffSsPc as FullRangeInt) - self.machContextRegistersOffset != self.machStateProgramCounterOffset - self.machStateFramePointerOffset 'registerRunsDiffer'
			panic("HostContextLayout.readMachSampler: {SamplerStdlibFileName} lays out the thread state's frame pointer, link register, stack pointer and program counter differently from the `mcontext64` thread state in Arm64FaultRuntime — `__prof_mach_sample` copies that run of registers from a signal context into the state record as one block, so the two layouts must agree")
		end 'registerRunsDiffer'

		if self.machStateTrampolineOffset < self.machThreadStateWords * MachThreadStateCountUnitBytes 'trampolineInsideState'
			panic("HostContextLayout.readMachSampler: {SamplerStdlibFileName} puts the trampoline word at {self.machStateTrampolineOffset}, inside the {self.machThreadStateWords * MachThreadStateCountUnitBytes} bytes `thread_get_state` writes, so reading the state would overwrite it")
		end 'trampolineInsideState'

		self.machThreadInfoFlavor = signatures.integerConstantIn(MachThreadInfoFlavorName, filePath: sampler)
		self.machThreadInfoWords = signatures.integerConstantIn(MachThreadInfoWordsName, filePath: sampler)
		self.machChunkBytes = signatures.integerConstantIn(StackReadChunkBytesName, filePath: sampler)
	end 'readMachSampler'

	function readPtraceSampler(signatures ProgramSignatures, sampler FilePath, debuggee FilePath)
		self.seizedTableBytes = signatures.integerConstantIn(SeizedTableBytesName, filePath: sampler)
		self.seizedPidOffset = SeizedTablePidOffset
		self.seizedCountOffset = signatures.integerConstantIn(SeizedTableCountOffsetName, filePath: sampler)
		self.seizedPinOffset = SeizedTablePinOffset
		self.seizedKilledOffset = SeizedTableKilledOffset
		self.seizedThreadsOffset = signatures.integerConstantIn(SeizedTableThreadsOffsetName, filePath: sampler)
		self.seizedWordBytes = signatures.integerConstantIn(SeizedWordBytesName, filePath: sampler)
		self.traceKillSignal = TraceKillSignal
		self.ptraceDetach = signatures.integerConstantIn(PtraceDetachName, filePath: debuggee)
		self.ptraceInterrupt = signatures.integerConstantIn(PtraceInterruptName, filePath: debuggee)
		self.traceStopBudgetMillis = signatures.integerConstantIn(TraceStopBudgetMillisName, filePath: sampler)
	end 'readPtraceSampler'

	export static function unread() returns HostContextLayout
		return Self{contextFlagsOffset: 0, contextControl: 0, contextInteger: 0, contextRipOffset: 0, contextRspOffset: 0, contextRbpOffset: 0, suspendThreadFailed: 0, regionRecordBytes: 0, mbiBaseAddressOffset: 0, regionAllocationBaseOffset: 0, mbiRegionSizeOffset: 0, regionSuspendedCyclesOffset: 0, savedFrameCodeBaseOffset: 0, savedFrameCodeBytesOffset: 0, savedFrameSlotBaseOffset: 0, savedFrameRecordFieldOffset: 0, savedFrameCopyOffset: 0, savedFrameRecordBytes: 0, savedFramePcWord: 0, savedFrameSpWord: 0, savedFrameWindowBytesOffset: 0, savedFrameThreadInfoOffset: 0, savedFrameWordsOffset: 0, savedFrameRegionOffset: 0, savedFrameFixedRecordOffset: 0, savedFrameRecordAddressOffset: 0, savedFrameWindowAddressOffset: 0, sampleThreadGone: 0, sampleNoRegisters: 0, sampleCallingThread: 0, machSuccess: 0, machThreadStateFlavor: 0, machThreadStateWords: 0, machStateStackPointerOffset: 0, machStateFramePointerOffset: 0, machStateProgramCounterOffset: 0, machStateSignalContextOffset: 0, machStateTrampolineOffset: 0, machContextPointerOffset: 0, machContextRegistersOffset: 0, machContextRegisterBytes: 0, machObjectTerminated: 0, machThreadInfoFlavor: 0, machThreadInfoWords: 0, machChunkBytes: 0, seizedTableBytes: 0, seizedPidOffset: 0, seizedCountOffset: 0, seizedPinOffset: 0, seizedKilledOffset: 0, seizedThreadsOffset: 0, seizedWordBytes: 0, traceKillSignal: 0, ptraceDetach: 0, ptraceInterrupt: 0, traceStopBudgetMillis: 0}
	end 'unread'
end 'HostContextLayout'
