let DebugHostRuntimePrefix = b"__dbgh_"

export let DebugHostReadMemoryName = b"__dbgh_read_memory"
export let DebugHostWriteMemoryName = b"__dbgh_write_memory"
export let DebugHostReadContextName = b"__dbgh_read_context"
export let DebugHostWriteContextName = b"__dbgh_write_context"
export let DebugHostWaitEventName = b"__dbgh_wait_event"
export let DebugHostContinueEventName = b"__dbgh_continue_event"
export let DebugHostBreakName = b"__dbgh_break"
export let DebugHostAttachName = b"__dbgh_attach"
export let DebugHostDetachName = b"__dbgh_detach"
export let DebugHostProtectName = b"__dbgh_protect"
export let DebugHostFlushCodeName = b"__dbgh_flush_code"
export let DebugHostCloseHandleName = b"__dbgh_close_handle"
export let DebugHostSuspendThreadName = b"__dbgh_suspend_thread"
export let DebugHostResumeThreadName = b"__dbgh_resume_thread"

export let DebugHostTraceRequestName = b"__dbgh_trace_request"
export let DebugHostTraceeReadName = b"__dbgh_tracee_read"
export let DebugHostAwaitTraceeName = b"__dbgh_await_tracee"
export let DebugHostThreadSignalName = b"__dbgh_thread_signal"
export let DebugHostProcessSignalName = b"__dbgh_process_signal"

let DebugHostOneWord = 1 as ParamCount
let DebugHostTwoWords = 2 as ParamCount
let DebugHostThreeWords = 3 as ParamCount
let DebugHostFourWords = 4 as ParamCount
let DebugHostFiveWords = 5 as ParamCount

export function isDebugHostRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: DebugHostRuntimePrefix)
end 'isDebugHostRuntimeCallee'

function debugHostParamTypes(count ParamCount) returns StdTypeArray
	if count == DebugHostOneWord 'oneWord'
		return oneI64Param()
	end 'oneWord'

	if count == DebugHostTwoWords 'twoWords'
		return twoI64Params()
	end 'twoWords'

	if count == DebugHostThreeWords 'threeWords'
		return threeI64Params()
	end 'threeWords'

	if count == DebugHostFourWords 'fourWords'
		return fourI64Params()
	end 'fourWords'

	if count == DebugHostFiveWords 'fiveWords'
		return fiveI64Params()
	end 'fiveWords'

	panic("debugHostParamTypes: no entry point of this family takes {count} words — the five shapes are {DebugHostOneWord}, {DebugHostTwoWords}, {DebugHostThreeWords}, {DebugHostFourWords} and {DebugHostFiveWords}")
end 'debugHostParamTypes'

function debugHostOperand(index ParamCount, count ParamCount, zero ValueId) returns ValueId
	return index as ValueId if index < count else zero
end 'debugHostOperand'

function buildDebugHostEntry(module StdModule, name ByteArray, words ParamCount, service HostProcessCall)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: words, paramTypes: debugHostParamTypes(words))
	var ids = ValueMinter.create(words)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: words)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)

	let answer = ids.mint()
	module.appendOp(entry, op: StdOp.osHostProcess(answer, service: service, a0Id: debugHostOperand(0, count: words, zero: zero), a1Id: debugHostOperand(1, count: words, zero: zero), a2Id: debugHostOperand(2, count: words, zero: zero), a3Id: debugHostOperand(3, count: words, zero: zero), a4Id: debugHostOperand(4, count: words, zero: zero), a5Id: zero))
	module.setTerminator(entry, op: StdOp.ret(answer))

	module.functions.push(func)
end 'buildDebugHostEntry'

export function installDebugHostRuntime(module StdModule, usage RuntimeUsage, target Target)
	if not usage.usesProcessDebug 'noProcessDebug'
		return
	end 'noProcessDebug'

	match debugHostShapeOf(target) 'shape'
		debugPort then installDebugPortEntries(module)
		processTrace then installProcessTraceEntries(module)
	end 'shape'
end 'installDebugHostRuntime'

union DebugHostShape
	debugPort
	processTrace
end 'DebugHostShape'

function debugHostShapeOf(target Target) returns DebugHostShape
	return match target.os 'os'
		windows gives DebugHostShape.debugPort
		linux gives DebugHostShape.processTrace

		macos or
		wasi panic("debugHostShapeOf: {targetToString(target)} provides neither a debug port nor ptrace, and `targetProvidesFacility` answers `processDebug` false for it — a program reaching here would be built asking for five trace-band entries this lane's runtime lays out no chunk for")
	end 'os'
end 'debugHostShapeOf'

function installProcessTraceEntries(module StdModule)
	buildDebugHostEntry(module, name: DebugHostTraceRequestName, words: DebugHostFourWords, service: HostProcessCall.traceRequest)
	buildDebugHostEntry(module, name: DebugHostTraceeReadName, words: DebugHostFiveWords, service: HostProcessCall.traceeMemoryRead)
	buildDebugHostEntry(module, name: DebugHostAwaitTraceeName, words: DebugHostThreeWords, service: HostProcessCall.awaitTracee)
	buildDebugHostEntry(module, name: DebugHostThreadSignalName, words: DebugHostThreeWords, service: HostProcessCall.threadGroupSignal)
	buildDebugHostEntry(module, name: DebugHostProcessSignalName, words: DebugHostTwoWords, service: HostProcessCall.processSignal)
end 'installProcessTraceEntries'

function installDebugPortEntries(module StdModule)
	buildDebugHostEntry(module, name: DebugHostReadMemoryName, words: DebugHostFiveWords, service: HostProcessCall.readProcessMemory)
	buildDebugHostEntry(module, name: DebugHostWriteMemoryName, words: DebugHostFiveWords, service: HostProcessCall.writeProcessMemory)
	buildDebugHostEntry(module, name: DebugHostReadContextName, words: DebugHostTwoWords, service: HostProcessCall.threadContext)
	buildDebugHostEntry(module, name: DebugHostWriteContextName, words: DebugHostTwoWords, service: HostProcessCall.writeThreadContext)
	buildDebugHostEntry(module, name: DebugHostWaitEventName, words: DebugHostTwoWords, service: HostProcessCall.waitForDebugEvent)
	buildDebugHostEntry(module, name: DebugHostContinueEventName, words: DebugHostThreeWords, service: HostProcessCall.continueDebugEvent)
	buildDebugHostEntry(module, name: DebugHostBreakName, words: DebugHostOneWord, service: HostProcessCall.breakProcess)
	buildDebugHostEntry(module, name: DebugHostAttachName, words: DebugHostOneWord, service: HostProcessCall.attachToProcess)
	buildDebugHostEntry(module, name: DebugHostDetachName, words: DebugHostOneWord, service: HostProcessCall.detachFromProcess)
	buildDebugHostEntry(module, name: DebugHostProtectName, words: DebugHostFiveWords, service: HostProcessCall.protectRegion)
	buildDebugHostEntry(module, name: DebugHostFlushCodeName, words: DebugHostThreeWords, service: HostProcessCall.flushCode)
	buildDebugHostEntry(module, name: DebugHostCloseHandleName, words: DebugHostOneWord, service: HostProcessCall.closeHandle)
	buildDebugHostEntry(module, name: DebugHostSuspendThreadName, words: DebugHostOneWord, service: HostProcessCall.suspendThread)
	buildDebugHostEntry(module, name: DebugHostResumeThreadName, words: DebugHostOneWord, service: HostProcessCall.resumeThread)
end 'installDebugPortEntries'
