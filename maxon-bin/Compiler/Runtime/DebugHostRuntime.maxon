let DebugHostRuntimePrefix = b"__dbgh_"

export let DebugHostReadMemoryName = b"__dbgh_read_memory"
export let DebugHostWriteMemoryName = b"__dbgh_write_memory"
export let DebugHostReadContextName = b"__dbgh_read_context"
export let DebugHostWriteContextName = b"__dbgh_write_context"
export let DebugHostWaitEventName = b"__dbgh_wait_event"
export let DebugHostContinueEventName = b"__dbgh_continue_event"
export let DebugHostBreakName = b"__dbgh_break"
export let DebugHostAttachName = b"__dbgh_attach"
export let DebugHostDetachName = b"__dbgh_detach"
export let DebugHostProtectName = b"__dbgh_protect"
export let DebugHostFlushCodeName = b"__dbgh_flush_code"
export let DebugHostCloseHandleName = b"__dbgh_close_handle"
export let DebugHostSuspendThreadName = b"__dbgh_suspend_thread"
export let DebugHostResumeThreadName = b"__dbgh_resume_thread"

export let DebugHostTraceRequestName = b"__dbgh_trace_request"
export let DebugHostTraceeReadName = b"__dbgh_tracee_read"
export let DebugHostAwaitTraceeName = b"__dbgh_await_tracee"
export let DebugHostThreadSignalName = b"__dbgh_thread_signal"
export let DebugHostProcessSignalName = b"__dbgh_process_signal"

export let HostProcessNoWords = 0 as ParamCount
let HostProcessOneWord = 1 as ParamCount
export let HostProcessTwoWords = 2 as ParamCount
export let HostProcessThreeWords = 3 as ParamCount
export let HostProcessFourWords = 4 as ParamCount
export let HostProcessFiveWords = 5 as ParamCount

export function isDebugHostRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: DebugHostRuntimePrefix)
end 'isDebugHostRuntimeCallee'

function hostProcessParamTypes(count ParamCount) returns StdTypeArray
	if count == HostProcessNoWords 'noWords'
		return StdTypeArray.create()
	end 'noWords'

	if count == HostProcessOneWord 'oneWord'
		return oneI64Param()
	end 'oneWord'

	if count == HostProcessTwoWords 'twoWords'
		return twoI64Params()
	end 'twoWords'

	if count == HostProcessThreeWords 'threeWords'
		return threeI64Params()
	end 'threeWords'

	if count == HostProcessFourWords 'fourWords'
		return fourI64Params()
	end 'fourWords'

	if count == HostProcessFiveWords 'fiveWords'
		return fiveI64Params()
	end 'fiveWords'

	panic("hostProcessParamTypes: no entry point of this family takes {count} words — the six shapes are {HostProcessNoWords}, {HostProcessOneWord}, {HostProcessTwoWords}, {HostProcessThreeWords}, {HostProcessFourWords} and {HostProcessFiveWords}")
end 'hostProcessParamTypes'

function hostProcessOperand(index ParamCount, count ParamCount, zero ValueId) returns ValueId
	return index as ValueId if index < count else zero
end 'hostProcessOperand'

export function buildHostProcessEntry(module StdModule, name ByteArray, words ParamCount, service HostProcessCall)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.value(StdType.i64), paramCount: words, paramTypes: hostProcessParamTypes(words))
	var ids = ValueMinter.create(words)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: words)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)

	let answer = ids.mint()
	module.appendOp(entry, op: StdOp.osHostProcess(answer, service: service, a0Id: hostProcessOperand(0, count: words, zero: zero), a1Id: hostProcessOperand(1, count: words, zero: zero), a2Id: hostProcessOperand(2, count: words, zero: zero), a3Id: hostProcessOperand(3, count: words, zero: zero), a4Id: hostProcessOperand(4, count: words, zero: zero), a5Id: hostProcessOperand(5, count: words, zero: zero)))
	module.setTerminator(entry, op: StdOp.ret(answer))

	module.functions.push(func)
end 'buildHostProcessEntry'

export function installDebugHostRuntime(module StdModule, usage RuntimeUsage, target Target)
	if not usage.usesProcessDebug 'noProcessDebug'
		return
	end 'noProcessDebug'

	match debugHostShapeOf(target) 'shape'
		debugPort then installDebugPortEntries(module)
		processTrace then installProcessTraceEntries(module)
	end 'shape'
end 'installDebugHostRuntime'

union DebugHostShape
	debugPort
	processTrace
end 'DebugHostShape'

function debugHostShapeOf(target Target) returns DebugHostShape
	return match target.os 'os'
		windows gives DebugHostShape.debugPort
		linux gives DebugHostShape.processTrace

		macos or
		wasi panic("debugHostShapeOf: {targetToString(target)} provides neither a debug port nor ptrace, and `targetProvidesFacility` answers `processDebug` false for it — a program reaching here would be built asking for five trace-band entries this lane's runtime lays out no chunk for")
	end 'os'
end 'debugHostShapeOf'

function installProcessTraceEntries(module StdModule)
	buildHostProcessEntry(module, name: DebugHostTraceRequestName, words: HostProcessFourWords, service: HostProcessCall.traceRequest)
	buildHostProcessEntry(module, name: DebugHostTraceeReadName, words: HostProcessFiveWords, service: HostProcessCall.traceeMemoryRead)
	buildHostProcessEntry(module, name: DebugHostAwaitTraceeName, words: HostProcessThreeWords, service: HostProcessCall.awaitTracee)
	buildHostProcessEntry(module, name: DebugHostThreadSignalName, words: HostProcessThreeWords, service: HostProcessCall.threadGroupSignal)
	buildHostProcessEntry(module, name: DebugHostProcessSignalName, words: HostProcessTwoWords, service: HostProcessCall.processSignal)
end 'installProcessTraceEntries'

function installDebugPortEntries(module StdModule)
	buildHostProcessEntry(module, name: DebugHostReadMemoryName, words: HostProcessFiveWords, service: HostProcessCall.readProcessMemory)
	buildHostProcessEntry(module, name: DebugHostWriteMemoryName, words: HostProcessFiveWords, service: HostProcessCall.writeProcessMemory)
	buildHostProcessEntry(module, name: DebugHostReadContextName, words: HostProcessTwoWords, service: HostProcessCall.threadContext)
	buildHostProcessEntry(module, name: DebugHostWriteContextName, words: HostProcessTwoWords, service: HostProcessCall.writeThreadContext)
	buildHostProcessEntry(module, name: DebugHostWaitEventName, words: HostProcessTwoWords, service: HostProcessCall.waitForDebugEvent)
	buildHostProcessEntry(module, name: DebugHostContinueEventName, words: HostProcessThreeWords, service: HostProcessCall.continueDebugEvent)
	buildHostProcessEntry(module, name: DebugHostBreakName, words: HostProcessOneWord, service: HostProcessCall.breakProcess)
	buildHostProcessEntry(module, name: DebugHostAttachName, words: HostProcessOneWord, service: HostProcessCall.attachToProcess)
	buildHostProcessEntry(module, name: DebugHostDetachName, words: HostProcessOneWord, service: HostProcessCall.detachFromProcess)
	buildHostProcessEntry(module, name: DebugHostProtectName, words: HostProcessFiveWords, service: HostProcessCall.protectRegion)
	buildHostProcessEntry(module, name: DebugHostFlushCodeName, words: HostProcessThreeWords, service: HostProcessCall.flushCode)
	buildHostProcessEntry(module, name: DebugHostCloseHandleName, words: HostProcessOneWord, service: HostProcessCall.closeHandle)
	buildHostProcessEntry(module, name: DebugHostSuspendThreadName, words: HostProcessOneWord, service: HostProcessCall.suspendThread)
	buildHostProcessEntry(module, name: DebugHostResumeThreadName, words: HostProcessOneWord, service: HostProcessCall.resumeThread)
end 'installDebugPortEntries'
