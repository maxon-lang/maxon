export let DbgCtlLabel = b"__dbg_ctl"

export let DebugAgentTierFileName = "DebugAgent.maxon"

export let DbgInitName = b"__dbg_init"
export let DbgOnTrapName = b"__dbg_on_trap"
export let DebugClaimStackName = b"__dbg_claim_stack"
export let DebugReleaseStackName = b"__dbg_release_stack"

// The service thread's entry. `__dbg_init` takes its address through `__Raw.dbgServiceEntryAddr()`, which
// is the edge that keeps it alive, so it needs no root of its own.
export let DbgServiceLoopName = b"__dbg_service_loop"

// The two the scheduler calls, both behind a `__dbg_ctl` test it emits: the carve's roster append and the
// hand-over's hold question. Those calls are minted long after the reach walk, so
// `StdlibSource.runtimeTierFileIsTheDebugAgent` is what credits them reached.
export let DbgGtCarvedName = b"__dbg_gt_carved"
export let DbgGtShouldHoldName = b"__dbg_gt_should_hold"

export function debugAgentRuntimeGlobals(usage RuntimeUsage) returns DataSectionEntryArray
	var out = DataSectionEntryArray.create()

	if not usage.usesDebugAgent 'noAgent'
		return out
	end 'noAgent'

	pushRuntimeGlobal(out, label: DbgCtlLabel, sharing: MultiMSharing.sealedBeforeWorkers, reach: DataReach.declared)
	return out
end 'debugAgentRuntimeGlobals'

export function checkDebugAgentGeometry(signatures ProgramSignatures, tierPath FilePath)
	requireTierGeometryAgrees(debugAgentTierPins(), signatures: signatures, tierPath: tierPath, emitterFile: "Compiler/Debug/DebugControlLayout.maxon", layer: "debug agent")

	if DbgOffRegisters + DbgRegisterSlots * DbgWordBytes > DbgOffBtCount 'registersOverrunTheBacktrace'
		panic("debug agent: {DbgRegisterSlots} register slots at {DbgOffRegisters} run past the backtrace header at {DbgOffBtCount}")
	end 'registersOverrunTheBacktrace'

	if DbgOffBtFrames + DbgMaxBacktraceFrames * DbgBacktraceFrameWords * DbgWordBytes > DbgOffReadLen 'framesOverrunTheReadHeader'
		panic("debug agent: {DbgMaxBacktraceFrames} backtrace frames at {DbgOffBtFrames} run past the read header at {DbgOffReadLen}")
	end 'framesOverrunTheReadHeader'

	if DbgOffReadBuf + DbgReadBufBytes > DbgOffConditionRecord 'readBufferOverrunsTheConditionRecord'
		panic("debug agent: a {DbgReadBufBytes}-byte read buffer at {DbgOffReadBuf} runs past the condition record at {DbgOffConditionRecord}")
	end 'readBufferOverrunsTheConditionRecord'

	if DbgOffConditionRecord + DbgConditionRecordWords * DbgWordBytes > DbgOffGtCount 'conditionRecordOverrunsTheTallies'
		panic("debug agent: a {DbgConditionRecordWords}-word condition record at {DbgOffConditionRecord} runs past the green-thread count at {DbgOffGtCount}")
	end 'conditionRecordOverrunsTheTallies'

	// These two words belong to a spec program and the agent never writes them: a case that needs the parent
	// and the child to name one word has nowhere else to put it, since a spec program cannot take the address
	// of its own variable and the mapped base of a `SharedSegment` is private to the stdlib.
	if DbgOffGtTruncated + DbgWordBytes > DbgOffSpecScratch or DbgOffSpecScratch + DbgSpecScratchWords * DbgWordBytes > DbgOffGtRecords 'theSpecBandIsNotWhereItWasReserved'
		panic("debug agent: the {DbgSpecScratchWords} words reserved for a spec program at {DbgOffSpecScratch} do not lie between the green-thread tallies ending at {DbgOffGtTruncated + DbgWordBytes} and the record array at {DbgOffGtRecords}")
	end 'theSpecBandIsNotWhereItWasReserved'

	if DbgOffGtRecords + DbgGtRecordCapacity * DbgGtRecordStride > DbgOffAgentPrivate 'recordsOverrunThePrivateWord'
		panic("debug agent: {DbgGtRecordCapacity} green-thread records of {DbgGtRecordStride} bytes at {DbgOffGtRecords} run past the agent's private word at {DbgOffAgentPrivate}")
	end 'recordsOverrunThePrivateWord'

	if DbgGtRecOffMachine + DbgWordBytes > DbgGtRecordStride 'aRecordDoesNotFitItsStride'
		panic("debug agent: a green-thread record's machine field at {DbgGtRecOffMachine} runs past its own {DbgGtRecordStride}-byte stride")
	end 'aRecordDoesNotFitItsStride'

	if DbgOffAgentPrivate + DbgWordBytes > DbgSegmentBytes 'privateWordOutsideTheSegment'
		panic("debug agent: the agent's private word at {DbgOffAgentPrivate} lies outside a {DbgSegmentBytes}-byte segment")
	end 'privateWordOutsideTheSegment'

	requireTierGeometryAgrees(debugAgentSymbolTablePins(), signatures: signatures, tierPath: tierPath, emitterFile: "Compiler/Targets/Shared/BacktraceFormat.maxon", layer: "debug agent")

	if DbgPrivOffHold + DbgHoldCapacity * DbgHoldSlotBytes > DbgPrivOffContext 'theHoldTableOverrunsTheContextBuffer'
		panic("debug agent: {DbgHoldCapacity} hold slots of {DbgHoldSlotBytes} bytes at {DbgPrivOffHold} run past the CONTEXT buffer at {DbgPrivOffContext}")
	end 'theHoldTableOverrunsTheContextBuffer'

	if DbgHoldOffStackBase + DbgWordBytes > DbgHoldSlotBytes 'aHoldsEpochOverrunsItsSlot'
		panic("debug agent: a hold's stack-base witness at {DbgHoldOffStackBase} runs past the {DbgHoldSlotBytes}-byte slot it lives in")
	end 'aHoldsEpochOverrunsItsSlot'

	if DbgPrivOffContext + DbgCtxBytes > DbgPrivOffHoldsPlaced 'theContextBufferOverrunsThePlacedHoldCount'
		panic("debug agent: a {DbgCtxBytes}-byte CONTEXT at {DbgPrivOffContext} runs past the placed-hold count at {DbgPrivOffHoldsPlaced}")
	end 'theContextBufferOverrunsThePlacedHoldCount'

	if DbgPrivOffHoldsPlaced + DbgWordBytes > DbgPrivOffBreakpoints 'thePlacedHoldCountOverrunsTheBreakpoints'
		panic("debug agent: the placed-hold count at {DbgPrivOffHoldsPlaced} runs past the breakpoint table at {DbgPrivOffBreakpoints}")
	end 'thePlacedHoldCountOverrunsTheBreakpoints'

	if DbgBpOffCondition + DbgCondRecOffLiteral + DbgWordBytes > DbgPrivBreakpointStride 'theConditionOverrunsTheEntry'
		panic("debug agent: a breakpoint's condition literal at {DbgBpOffCondition + DbgCondRecOffLiteral} runs past the {DbgPrivBreakpointStride}-byte entry it lives in")
	end 'theConditionOverrunsTheEntry'

	if DbgPrivOffBreakpoints + DbgBreakpointCapacity * DbgPrivBreakpointStride > DbgPrivOffGtRoster 'breakpointsOverrunTheRoster'
		panic("debug agent: {DbgBreakpointCapacity} breakpoint entries at {DbgPrivOffBreakpoints} run past the green-thread roster at {DbgPrivOffGtRoster}")
	end 'breakpointsOverrunTheRoster'

	if DbgPrivOffGtRoster + DbgGtRosterCapacity * DbgWordBytes > DbgPrivStackBase 'theRosterOverrunsTheAgentStack'
		panic("debug agent: a {DbgGtRosterCapacity}-entry roster at {DbgPrivOffGtRoster} runs past the agent stack at {DbgPrivStackBase}")
	end 'theRosterOverrunsTheAgentStack'

	if DbgPrivStackBase >= DbgPrivBytes - DbgAgentShadowBytes 'noStackLeft'
		panic("debug agent: the agent stack's floor at {DbgPrivStackBase} leaves no room below the top of a {DbgPrivBytes}-byte private block")
	end 'noStackLeft'

	if DbgBreakpointCapacity * DbgSlotBytes > DbgSlotPoolBytes 'slotsOverrunThePool'
		panic("debug agent: {DbgBreakpointCapacity} slots of {DbgSlotBytes} bytes do not fit a {DbgSlotPoolBytes}-byte pool")
	end 'slotsOverrunThePool'

	if DbgCallSlotBytes > DbgSlotBytes 'noRoomForADisplacedCall'
		panic("debug agent: a displaced direct call needs {DbgCallSlotBytes} bytes and a slot is {DbgSlotBytes}")
	end 'noRoomForADisplacedCall'

	if DbgJmpAbsoluteBytes >= DbgSlotBytes 'noRoomForADisplacedInstruction'
		panic("debug agent: an absolute jump of {DbgJmpAbsoluteBytes} bytes leaves no room in a {DbgSlotBytes}-byte slot for the instruction it returns from")
	end 'noRoomForADisplacedInstruction'

	if DbgClassIndirectCall <= DbgClassReturn or DbgClassIndirectJump <= DbgClassIndirectCall 'indirectClassesAreNotAboveTheSimulableOnes'
		panic("debug agent: the indirect classes {DbgClassIndirectCall} and {DbgClassIndirectJump} do not both lie above the simulable classes, which end at {DbgClassReturn} — the agent refuses every class above that bound, so an indirect one inside it would be armed and then run out of line")
	end 'indirectClassesAreNotAboveTheSimulableOnes'

	if cStringBytes(DbgEnvVarName).count() > DbgEnvNameWords * DbgWordBytes or DbgEnvNameWords * DbgWordBytes > DbgEnvNameBufferBytes 'theEnvNameDoesNotFitItsBuffer'
		panic("debug agent: `{DbgEnvVarName}` and its terminator do not fit the {DbgEnvNameWords} words the tier writes into a {DbgEnvNameBufferBytes}-byte buffer")
	end 'theEnvNameDoesNotFitItsBuffer'

	if DbgMaxReadLength > DbgReadBufBytes 'readCapAboveTheBuffer'
		panic("debug agent: a read of up to {DbgMaxReadLength} bytes does not fit the {DbgReadBufBytes}-byte buffer")
	end 'readCapAboveTheBuffer'
end 'checkDebugAgentGeometry'

let DbgWordBytes = 8

let DbgEnvNameWords = 2

let DbgByteBits = 8

function debugEnvNameWord(part ParsedInt) returns ParsedInt
	let bytes = cStringBytes(DbgEnvVarName)
	var word = 0 as ParsedInt

	for index in 0 upto DbgWordBytes 'eachByte'
		let at = part * DbgWordBytes + index

		if at < bytes.count() 'insideTheName'
			word = word + (((try bytes.get(at as ElementIndex) otherwise panic("debugEnvNameWord: byte {at} is below the {bytes.count()} `{DbgEnvVarName}` and its terminator occupy")) as ParsedInt) shl (index * DbgByteBits))
		end 'insideTheName'
	end 'eachByte'

	return word
end 'debugEnvNameWord'

function debugAgentSymbolTablePins() returns TierGeometryPinArray
	var out = TierGeometryPinArray.create()

	out.push(TierGeometryPin.create("the symbol table's entry array offset", here: SymtabOffEntries as ParsedInt, named: "DbgSymtabOffEntries"))
	out.push(TierGeometryPin.create("a symbol table column's bytes", here: SymbolTableColumnBytes, named: "DbgSymtabColumnBytes"))
	out.push(TierGeometryPin.create("a symbol table entry's bytes", here: SymbolTableEntryBytes, named: "DbgSymtabEntryBytes"))
	out.push(TierGeometryPin.create("a symbol table entry's code-offset mask", here: SymtabEntryCodeOffsetMask, named: "DbgSymtabEntryCodeOffsetMask"))
	return out
end 'debugAgentSymbolTablePins'

