	out.push(TierGeometryPin.create("the cooperative preemption request", here: GtStackGuardPreempt, named: "DbgGtStackGuardPreempt"))
	out.push(TierGeometryPin.create("a free signal claim", here: PreemptClaimFree, named: "DbgPreemptClaimFree"))
	out.push(TierGeometryPin.create("a held signal claim", here: PreemptClaimHeld, named: "DbgPreemptClaimHeld"))
	out.push(TierGeometryPin.create("a step's hold on the signal claim", here: DbgPreemptClaimStep, named: "DbgPreemptClaimStep"))

	return out
end 'debugAgentTierPins'
