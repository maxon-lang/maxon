	out.push(TierGeometryPin.create("the cooperative preemption request", here: GtStackGuardPreempt, named: "DbgGtStackGuardPreempt"))
	out.push(TierGeometryPin.create("a free signal claim", here: PreemptClaimFree, named: "DbgPreemptClaimFree"))
