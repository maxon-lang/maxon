export let DbgCtlLabel = b"__dbg_ctl"

export let DebugAgentTierFileName = "DebugAgent.maxon"

export let DbgInitName = b"__dbg_init"
export let DbgOnTrapName = b"__dbg_on_trap"
export let DebugClaimStackName = b"__dbg_claim_stack"
export let DebugReleaseStackName = b"__dbg_release_stack"

// The service thread's entry. `__dbg_init` takes its address through `__Raw.dbgServiceEntryAddr()`, which
// is the edge that keeps it alive, so it needs no root of its own.
export let DbgServiceLoopName = b"__dbg_service_loop"

// The three the scheduler calls: the carve's roster append and the hand-over's hold question, each
// behind a `__dbg_ctl` test it emits, and the preempt-safe check's planted-trap lookback. Those
// calls are minted long after the reach walk, so `StdlibSource.runtimeTierFileIsTheDebugAgent` is
// what credits them reached.
export let DbgGtCarvedName = b"__dbg_gt_carved"
export let DbgGtShouldHoldName = b"__dbg_gt_should_hold"
export let DbgTrapPlantedAtName = b"__dbg_trap_planted_at"

export function debugAgentRuntimeGlobals(usage RuntimeUsage) returns DataSectionEntryArray
	var out = DataSectionEntryArray.create()

	if not usage.usesDebugAgent 'noAgent'
		return out
	end 'noAgent'

	pushRuntimeGlobal(out, label: DbgCtlLabel, sharing: MultiMSharing.sealedBeforeWorkers, reach: DataReach.declared)
	return out
end 'debugAgentRuntimeGlobals'

export function checkDebugAgentGeometry(signatures ProgramSignatures, tierPath FilePath)
	requireTierGeometryAgrees(debugAgentTierPins(), signatures: signatures, tierPath: tierPath, emitterFile: "Compiler/Debug/DebugControlLayout.maxon", layer: "debug agent")

	requireRegionBetween(DbgOffStopFault, bytes: DbgWordBytes, what: "the stop's fault word", after: DbgOffStopFp + DbgWordBytes, afterWhat: "the stop's frame pointer at {DbgOffStopFp}", before: DbgOffRegisters, beforeWhat: "the register file")
	requireRegionBetween(DbgOffStopConditionMissed, bytes: DbgWordBytes, what: "the stop's missed-condition word", after: DbgOffStopFault + DbgWordBytes, afterWhat: "the stop's fault word at {DbgOffStopFault}", before: DbgOffRegisters, beforeWhat: "the register file")
	requireRegionBetween(DbgOffBtOuterFrame, bytes: DbgWordBytes, what: "the walk's outer frame word", after: DbgOffStopConditionMissed + DbgWordBytes, afterWhat: "the stop's missed-condition word at {DbgOffStopConditionMissed}", before: DbgOffRegisters, beforeWhat: "the register file")
	requireRegionBetween(DbgOffAckStopSeq, bytes: DbgWordBytes, what: "the answering stop's sequence word", after: DbgOffBtOuterFrame + DbgWordBytes, afterWhat: "the walk's outer frame word at {DbgOffBtOuterFrame}", before: DbgOffRegisters, beforeWhat: "the register file")

	requireRegionBefore(DbgOffRegisters, bytes: DbgRegisterSlots * DbgWordBytes, what: "{DbgRegisterSlots} register slots", before: DbgOffBtCount, beforeWhat: "the backtrace header")
	requireRegionBefore(DbgOffBtFrames, bytes: DbgMaxBacktraceFrames * DbgBacktraceFrameWords * DbgWordBytes, what: "{DbgMaxBacktraceFrames} backtrace frames", before: DbgOffReadLen, beforeWhat: "the read header")
	requireRegionBefore(DbgOffReadBuf, bytes: DbgReadBufBytes, what: "a {DbgReadBufBytes}-byte read buffer", before: DbgOffConditionRecord, beforeWhat: "the condition record")
	requireRegionBefore(DbgOffConditionRecord, bytes: DbgConditionRecordWords * DbgWordBytes, what: "a {DbgConditionRecordWords}-word condition record", before: DbgOffGtCount, beforeWhat: "the green-thread count")

	// These two words belong to a spec program and the agent never writes them: a case that needs the parent
	// and the child to name one word has nowhere else to put it, since a spec program cannot take the address
	// of its own variable and the mapped base of a `SharedSegment` is private to the stdlib.
	requireRegionBetween(DbgOffSpecScratch, bytes: DbgSpecScratchWords * DbgWordBytes, what: "the {DbgSpecScratchWords} words reserved for a spec program", after: DbgOffGtTruncated + DbgWordBytes, afterWhat: "the green-thread tallies", before: DbgOffGtRecords, beforeWhat: "the record array")

	requireRegionBefore(DbgOffGtRecords, bytes: DbgGtRecordCapacity * DbgGtRecordStride, what: "{DbgGtRecordCapacity} green-thread records of {DbgGtRecordStride} bytes", before: DbgOffAgentPrivate, beforeWhat: "the agent's private word")
	requireRegionBefore(DbgGtRecOffMachine, bytes: DbgWordBytes, what: "a green-thread record's machine field", before: DbgGtRecordStride, beforeWhat: "the end of its own stride")
	requireRegionBefore(DbgOffAgentPrivate, bytes: DbgWordBytes, what: "the agent's private word", before: DbgSegmentBytes, beforeWhat: "the end of the segment")

	requireTierGeometryAgrees(debugAgentSymbolTablePins(), signatures: signatures, tierPath: tierPath, emitterFile: "Compiler/Targets/Shared/BacktraceFormat.maxon", layer: "debug agent")

	requireRegionBefore(DbgPrivOffHold, bytes: DbgHoldCapacity * DbgHoldSlotBytes, what: "{DbgHoldCapacity} hold slots of {DbgHoldSlotBytes} bytes", before: DbgPrivOffContext, beforeWhat: "the CONTEXT buffer")
	requireRegionBefore(DbgHoldOffStackBase, bytes: DbgWordBytes, what: "a hold's stack-base witness", before: DbgHoldSlotBytes, beforeWhat: "the end of the slot it lives in")
	requireRegionBefore(DbgPrivOffContext, bytes: DbgCtxBytes, what: "a {DbgCtxBytes}-byte CONTEXT", before: DbgPrivOffHoldsPlaced, beforeWhat: "the placed-hold count")

	requireRegionBetween(DbgPrivOffStopLockOwner, bytes: DbgWordBytes, what: "the stop lock's owner word", after: DbgPrivOffContext + DbgCtxBytes, afterWhat: "the CONTEXT buffer ending at {DbgPrivOffContext + DbgCtxBytes}", before: DbgPrivOffHoldsPlaced, beforeWhat: "the placed-hold count")
	requireRegionBetween(DbgPrivOffReturnHold, bytes: DbgWordBytes, what: "the return point's hold word", after: DbgPrivOffContext + DbgCtxBytes, afterWhat: "the CONTEXT buffer ending at {DbgPrivOffContext + DbgCtxBytes}", before: DbgPrivOffStopLockOwner, beforeWhat: "the stop lock's owner word")

	if DbgPreemptClaimStep == PreemptClaimFree or DbgPreemptClaimStep == PreemptClaimHeld 'aStepHoldTheSchedulerCouldMistake'
		panic("debug agent: a step's hold on a machine's signal claim is {DbgPreemptClaimStep}, which the scheduler already means as a free ({PreemptClaimFree}) or a held ({PreemptClaimHeld}) claim")
	end 'aStepHoldTheSchedulerCouldMistake'

	if DbgClaimDeclined != 0 'theThunkTestsForZero'
		panic("debug agent: a declined stack claim is {DbgClaimDeclined}, but the trap thunk recognises a decline by testing the answer for zero")
	end 'theThunkTestsForZero'

	requireRegionBefore(DbgPrivOffHoldsPlaced, bytes: DbgWordBytes, what: "the placed-hold count", before: DbgPrivOffBreakpoints, beforeWhat: "the breakpoint table")
	requireRegionBefore(DbgBpOffCondition + DbgCondRecOffLiteral, bytes: DbgWordBytes, what: "a breakpoint's condition literal", before: DbgPrivBreakpointStride, beforeWhat: "the end of the entry it lives in")
	requireRegionBefore(DbgPrivOffBreakpoints, bytes: DbgBreakpointCapacity * DbgPrivBreakpointStride, what: "{DbgBreakpointCapacity} breakpoint entries", before: DbgPrivOffGtRoster, beforeWhat: "the green-thread roster")
	requireRegionBefore(DbgPrivOffGtRoster, bytes: DbgGtRosterCapacity * DbgWordBytes, what: "a {DbgGtRosterCapacity}-entry roster", before: DbgPrivOffFrame, beforeWhat: "the register-slot trap frame")
	requireRegionBefore(DbgPrivOffFrame, bytes: DbgRegisterSlots * DbgWordBytes, what: "the {DbgRegisterSlots}-slot trap frame", before: DbgPrivOffThreadFrame, beforeWhat: "the other-thread frame")
	requireRegionBefore(DbgPrivOffThreadFrame, bytes: DbgRegisterSlots * DbgWordBytes, what: "the {DbgRegisterSlots}-slot other-thread frame", before: DbgPrivStackBase, beforeWhat: "the agent stack")

	if DbgGprCount + DbgXmmCount > DbgRegFlags 'theVectorsRunIntoTheFlags'
		panic("debug agent: {DbgGprCount} general and {DbgXmmCount} vector slots run past the flags slot {DbgRegFlags}")
	end 'theVectorsRunIntoTheFlags'

	if DbgRegPc >= DbgRegisterSlots 'thePcIsOutsideTheFrame'
		panic("debug agent: the program counter's slot {DbgRegPc} is outside a {DbgRegisterSlots}-slot frame")
	end 'thePcIsOutsideTheFrame'

	if DbgPrivOffContext mod Win64ContextAlignment != 0 'theContextIsMisaligned'
		panic("debug agent: the CONTEXT buffer at {DbgPrivOffContext} is not {Win64ContextAlignment}-byte aligned, which GetThreadContext and SetThreadContext require")
	end 'theContextIsMisaligned'

	if DbgPrivStackBase >= DbgPrivBytes - DbgAgentShadowBytes 'noStackLeft'
		panic("debug agent: the agent stack's floor at {DbgPrivStackBase} leaves no room below the top of a {DbgPrivBytes}-byte private block")
	end 'noStackLeft'

	requireRegionBetween(DbgPrivOffPlantedMap, bytes: DbgWordBytes, what: "the planted map's word", after: DbgPrivOffContext + DbgCtxBytes, afterWhat: "the CONTEXT buffer ending at {DbgPrivOffContext + DbgCtxBytes}", before: DbgPrivOffReturnHold, beforeWhat: "the return point's hold word")

	if DbgSlotCapacity * DbgSlotBytes > DbgSlotPoolBytes 'slotsOverrunThePool'
		panic("debug agent: {DbgSlotCapacity} slots of {DbgSlotBytes} bytes do not fit a {DbgSlotPoolBytes}-byte pool")
	end 'slotsOverrunThePool'

	if DbgSlotCapacity < DbgBreakpointCapacity 'fewerSlotsThanBreakpoints'
		panic("debug agent: {DbgSlotCapacity} slots cannot give each of {DbgBreakpointCapacity} live breakpoints one of its own")
	end 'fewerSlotsThanBreakpoints'

	requireSlotHeadsFit()
	requireRegionBefore(DbgSlotTailAt, bytes: DbgSlotTailEnd - DbgSlotTailAt, what: "a slot's tail", before: DbgSlotBackAt, beforeWhat: "its return word")
	requireRegionBefore(DbgSlotBackAt, bytes: DbgWordBytes, what: "a slot's return word", before: DbgSlotExitsAt, beforeWhat: "its exit count")
	requireRegionBefore(DbgSlotExitsAt, bytes: DbgWordBytes, what: "a slot's exit count", before: DbgSlotSendsAt, beforeWhat: "its send count")
	requireRegionBefore(DbgSlotSendsAt, bytes: DbgWordBytes, what: "a slot's send count", before: DbgSlotOriginAt, beforeWhat: "its origin word")
	requireRegionBefore(DbgSlotOriginAt, bytes: DbgWordBytes, what: "a slot's origin word", before: DbgSlotClassWordAt, beforeWhat: "its class word")
	requireRegionBefore(DbgSlotClassWordAt, bytes: DbgWordBytes, what: "a slot's class word", before: DbgSlotFixupAt, beforeWhat: "its fixup word")
	requireRegionBefore(DbgSlotFixupAt, bytes: DbgWordBytes, what: "a slot's fixup word", before: DbgSlotBytes, beforeWhat: "the end of the slot")

	if DbgClassIndirectJump <= DbgClassIndirectCall 'theIndirectJumpIsNotAboveTheArmableClasses'
		panic("debug agent: the indirect-jump class {DbgClassIndirectJump} does not lie above the indirect-call class {DbgClassIndirectCall}, the last class the agent arms — the agent refuses every class above that bound, so an indirect jump inside it would be armed and then run out of line")
	end 'theIndirectJumpIsNotAboveTheArmableClasses'

	if cStringBytes(DbgEnvVarName).count() > DbgEnvNameWords * DbgWordBytes or DbgEnvNameWords * DbgWordBytes > DbgEnvNameBufferBytes 'theEnvNameDoesNotFitItsBuffer'
		panic("debug agent: `{DbgEnvVarName}` and its terminator do not fit the {DbgEnvNameWords} words the tier writes into a {DbgEnvNameBufferBytes}-byte buffer")
	end 'theEnvNameDoesNotFitItsBuffer'

	if DbgMaxReadLength > DbgReadBufBytes 'readCapAboveTheBuffer'
		panic("debug agent: a read of up to {DbgMaxReadLength} bytes does not fit the {DbgReadBufBytes}-byte buffer")
	end 'readCapAboveTheBuffer'
end 'checkDebugAgentGeometry'

function requireSlotHeadsFit()
	if DbgCallTrailEnd > DbgSlotHeadTrailBytes or DbgJmpShortBytes > DbgSlotHeadTrailBytes 'aTrailPastItsAllowance'
		panic("debug agent: a slot head may append {DbgSlotHeadTrailBytes} bytes to the instruction it displaces, and an indirect call's trail is {DbgCallTrailEnd}")
	end 'aTrailPastItsAllowance'

	requireRegionBefore(0, bytes: DbgMaxInstructionBytes + DbgSlotHeadTrailBytes, what: "the longest slot head", before: DbgSlotTailAt, beforeWhat: "the slot's tail")
	requireRegionBefore(0, bytes: DbgCallHeadEnd, what: "a displaced direct call's head", before: DbgSlotTailAt, beforeWhat: "the slot's tail")

	if DbgSlotTailFlagsAt > DbgShortJumpReach 'theTailIsPastAShortJump'
		panic("debug agent: a slot tail's flags push at {DbgSlotTailFlagsAt} is past the {DbgShortJumpReach} bytes a short jump from its head reaches")
	end 'theTailIsPastAShortJump'
end 'requireSlotHeadsFit'

function requireRegionBetween(start ParsedInt, bytes ParsedInt, what String, after ParsedInt, afterWhat String, before ParsedInt, beforeWhat String)
	if start < after 'belowItsGap'
		panic("debug agent: {what} at {start} lies below {afterWhat}, which ends at {after}")
	end 'belowItsGap'

	requireRegionBefore(start, bytes: bytes, what: what, before: before, beforeWhat: beforeWhat)
end 'requireRegionBetween'

function requireRegionBefore(start ParsedInt, bytes ParsedInt, what String, before ParsedInt, beforeWhat String)
	if start + bytes > before 'runsPastIt'
		panic("debug agent: {what} at {start} runs past {beforeWhat} at {before}")
	end 'runsPastIt'
end 'requireRegionBefore'

let DbgEnvNameWords = 2

let DbgByteBits = 8

function debugEnvNameWord(part ParsedInt) returns ParsedInt
	let bytes = cStringBytes(DbgEnvVarName)
	var word = 0 as ParsedInt

	for index in 0 upto DbgWordBytes 'eachByte'
		let at = part * DbgWordBytes + index

		if at < bytes.count() 'insideTheName'
			word = word + (((try bytes.get(at as ElementIndex) otherwise panic("debugEnvNameWord: byte {at} is below the {bytes.count()} `{DbgEnvVarName}` and its terminator occupy")) as ParsedInt) shl (index * DbgByteBits))
		end 'insideTheName'
	end 'eachByte'

	return word
end 'debugEnvNameWord'

function debugAgentSymbolTablePins() returns TierGeometryPinArray
	var out = TierGeometryPinArray.create()

	out.push(TierGeometryPin.create("the symbol table's entry array offset", here: SymtabOffEntries as ParsedInt, named: "DbgSymtabOffEntries"))
	out.push(TierGeometryPin.create("a symbol table column's bytes", here: SymbolTableColumnBytes, named: "DbgSymtabColumnBytes"))
	out.push(TierGeometryPin.create("a symbol table entry's bytes", here: SymbolTableEntryBytes, named: "DbgSymtabEntryBytes"))
	out.push(TierGeometryPin.create("a symbol table entry's code-offset mask", here: SymtabEntryCodeOffsetMask, named: "DbgSymtabEntryCodeOffsetMask"))
	out.push(TierGeometryPin.create("the symbol table's compiler-scaffolding bit", here: SymtabScaffoldingBit, named: "DbgSymtabScaffoldingBit"))
	return out
end 'debugAgentSymbolTablePins'

function debugAgentTierPins() returns TierGeometryPinArray
	var out = TierGeometryPinArray.create()

	out.push(TierGeometryPin.create("the control segment's magic", here: DbgMagicWord, named: "DbgMagic"))
	out.push(TierGeometryPin.create("the layout version", here: DbgLayoutVersion, named: "DbgLayoutVersion"))
	out.push(TierGeometryPin.create("the control segment's size", here: DbgSegmentBytes, named: "DbgSegmentBytes"))

	out.push(TierGeometryPin.create("the magic's offset", here: DbgOffMagic, named: "DbgOffMagic"))
	out.push(TierGeometryPin.create("the driver version's offset", here: DbgOffDriverVersion, named: "DbgOffDriverVersion"))
	out.push(TierGeometryPin.create("the agent version's offset", here: DbgOffAgentVersion, named: "DbgOffAgentVersion"))
	out.push(TierGeometryPin.create("the flags' offset", here: DbgOffFlags, named: "DbgOffFlags"))
	out.push(TierGeometryPin.create("the agent pid's offset", here: DbgOffAgentPid, named: "DbgOffAgentPid"))
	out.push(TierGeometryPin.create("the driver pid's offset", here: DbgOffDriverPid, named: "DbgOffDriverPid"))
	out.push(TierGeometryPin.create("the stop-at-entry offset", here: DbgOffStopAtEntry, named: "DbgOffStopAtEntry"))
	out.push(TierGeometryPin.create("the command sequence's offset", here: DbgOffCmdSeq, named: "DbgOffCmdSeq"))
	out.push(TierGeometryPin.create("the command's offset", here: DbgOffCmd, named: "DbgOffCmd"))
	out.push(TierGeometryPin.create("command argument 0's offset", here: DbgOffCmdArg0, named: "DbgOffCmdArg0"))
	out.push(TierGeometryPin.create("command argument 1's offset", here: DbgOffCmdArg1, named: "DbgOffCmdArg1"))
	out.push(TierGeometryPin.create("command argument 2's offset", here: DbgOffCmdArg2, named: "DbgOffCmdArg2"))
	out.push(TierGeometryPin.create("the ack sequence's offset", here: DbgOffAckSeq, named: "DbgOffAckSeq"))
	out.push(TierGeometryPin.create("the command result's offset", here: DbgOffCmdResult, named: "DbgOffCmdResult"))
	out.push(TierGeometryPin.create("the command refusal's offset", here: DbgOffCmdRefusal, named: "DbgOffCmdRefusal"))
	out.push(TierGeometryPin.create("the stop sequence's offset", here: DbgOffStopSeq, named: "DbgOffStopSeq"))
	out.push(TierGeometryPin.create("the stop reason's offset", here: DbgOffStopReason, named: "DbgOffStopReason"))
	out.push(TierGeometryPin.create("the stop machine's offset", here: DbgOffStopMachine, named: "DbgOffStopMachine"))
	out.push(TierGeometryPin.create("the stop green thread's offset", here: DbgOffStopGreenThread, named: "DbgOffStopGreenThread"))
	out.push(TierGeometryPin.create("the stop trace mark's offset", here: DbgOffStopTraceMark, named: "DbgOffStopTraceMark"))
	out.push(TierGeometryPin.create("the text base's offset", here: DbgOffTextBase, named: "DbgOffTextBase"))
	out.push(TierGeometryPin.create("the text size's offset", here: DbgOffTextSize, named: "DbgOffTextSize"))
	out.push(TierGeometryPin.create("the stop pc's offset", here: DbgOffStopPc, named: "DbgOffStopPc"))
	out.push(TierGeometryPin.create("the stop sp's offset", here: DbgOffStopSp, named: "DbgOffStopSp"))
	out.push(TierGeometryPin.create("the stop fp's offset", here: DbgOffStopFp, named: "DbgOffStopFp"))
	out.push(TierGeometryPin.create("the stop fault's offset", here: DbgOffStopFault, named: "DbgOffStopFault"))
	out.push(TierGeometryPin.create("the stop's missed-condition offset", here: DbgOffStopConditionMissed, named: "DbgOffStopConditionMissed"))
	out.push(TierGeometryPin.create("a stop whose condition was met", here: DbgStopConditionMet, named: "DbgStopConditionMet"))
	out.push(TierGeometryPin.create("a stop whose condition was missed", here: DbgStopConditionMissedYes, named: "DbgStopConditionMissedYes"))
	out.push(TierGeometryPin.create("the register file's offset", here: DbgOffRegisters, named: "DbgOffRegisters"))
	out.push(TierGeometryPin.create("the backtrace count's offset", here: DbgOffBtCount, named: "DbgOffBtCount"))
	out.push(TierGeometryPin.create("the backtrace truncation flag's offset", here: DbgOffBtTruncated, named: "DbgOffBtTruncated"))
	out.push(TierGeometryPin.create("the backtrace frames' offset", here: DbgOffBtFrames, named: "DbgOffBtFrames"))
	out.push(TierGeometryPin.create("the backtrace's outer frame offset", here: DbgOffBtOuterFrame, named: "DbgOffBtOuterFrame"))
	out.push(TierGeometryPin.create("the answering stop's sequence offset", here: DbgOffAckStopSeq, named: "DbgOffAckStopSeq"))
	out.push(TierGeometryPin.create("a command answered with nothing parked", here: DbgAnsweredLive, named: "DbgAnsweredLive"))
	out.push(TierGeometryPin.create("the read length's offset", here: DbgOffReadLen, named: "DbgOffReadLen"))
	out.push(TierGeometryPin.create("the read status's offset", here: DbgOffReadStatus, named: "DbgOffReadStatus"))
	out.push(TierGeometryPin.create("the read buffer's offset", here: DbgOffReadBuf, named: "DbgOffReadBuf"))
	out.push(TierGeometryPin.create("the agent's private word offset", here: DbgOffAgentPrivate, named: "DbgOffAgentPrivate"))

	out.push(TierGeometryPin.create("the register file's slots", here: DbgRegisterSlots, named: "DbgRegisterSlots"))
	out.push(TierGeometryPin.create("the backtrace cap", here: DbgMaxBacktraceFrames, named: "DbgMaxBacktraceFrames"))
	out.push(TierGeometryPin.create("a backtrace frame's words", here: DbgBacktraceFrameWords, named: "DbgBacktraceFrameWords"))
	out.push(TierGeometryPin.create("the read cap", here: DbgMaxReadLength, named: "DbgMaxReadLength"))

	out.push(TierGeometryPin.create("the agent-alive bit", here: DbgFlagAgentAlive, named: "DbgFlagAgentAlive"))
	out.push(TierGeometryPin.create("the stop-at-entry request", here: DbgStopAtEntryYes, named: "DbgStopAtEntryYes"))

	out.push(TierGeometryPin.create("the set-breakpoint command", here: DbgCmdSetBreakpoint, named: "DbgCmdSetBreakpoint"))
	out.push(TierGeometryPin.create("the clear-breakpoint command", here: DbgCmdClearBreakpoint, named: "DbgCmdClearBreakpoint"))
	out.push(TierGeometryPin.create("the continue command", here: DbgCmdContinue, named: "DbgCmdContinue"))
	out.push(TierGeometryPin.create("the backtrace command", here: DbgCmdBacktrace, named: "DbgCmdBacktrace"))
	out.push(TierGeometryPin.create("the read-memory command", here: DbgCmdReadMemory, named: "DbgCmdReadMemory"))
	out.push(TierGeometryPin.create("the step-instruction command", here: DbgCmdStepInstruction, named: "DbgCmdStepInstruction"))

	out.push(TierGeometryPin.create("the done result", here: DbgCmdResultDone, named: "DbgCmdResultDone"))
	out.push(TierGeometryPin.create("the refused result", here: DbgCmdResultRefused, named: "DbgCmdResultRefused"))

	out.push(TierGeometryPin.create("the entry stop reason", here: DbgStopReasonEntry, named: "DbgStopReasonEntry"))
	out.push(TierGeometryPin.create("the breakpoint stop reason", here: DbgStopReasonBreakpoint, named: "DbgStopReasonBreakpoint"))
	out.push(TierGeometryPin.create("the step stop reason", here: DbgStopReasonStep, named: "DbgStopReasonStep"))

	out.push(TierGeometryPin.create("the out-of-text refusal", here: DbgRefusalOutOfText, named: "DbgRefusalOutOfText"))
	out.push(TierGeometryPin.create("the runtime-symbol refusal", here: DbgRefusalInsideRuntimeSymbol, named: "DbgRefusalInsideRuntimeSymbol"))
	out.push(TierGeometryPin.create("the unclassified refusal", here: DbgRefusalUnclassified, named: "DbgRefusalUnclassified"))
	out.push(TierGeometryPin.create("the table-full refusal", here: DbgRefusalTableFull, named: "DbgRefusalTableFull"))
	out.push(TierGeometryPin.create("the no-such-breakpoint refusal", here: DbgRefusalNoSuchBreakpoint, named: "DbgRefusalNoSuchBreakpoint"))
	out.push(TierGeometryPin.create("the unknown-command refusal", here: DbgRefusalUnknownCommand, named: "DbgRefusalUnknownCommand"))
	out.push(TierGeometryPin.create("the not-stopped refusal", here: DbgRefusalNotStopped, named: "DbgRefusalNotStopped"))

	out.push(TierGeometryPin.create("the plain instruction class", here: DbgClassPlain, named: "DbgClassPlain"))
	out.push(TierGeometryPin.create("the pc-relative data class", here: DbgClassPcRelativeData, named: "DbgClassPcRelativeData"))
	out.push(TierGeometryPin.create("the direct-call class", here: DbgClassDirectCall, named: "DbgClassDirectCall"))
	out.push(TierGeometryPin.create("the direct-jump class", here: DbgClassDirectJump, named: "DbgClassDirectJump"))
	out.push(TierGeometryPin.create("the conditional-jump class", here: DbgClassConditionalJump, named: "DbgClassConditionalJump"))
	out.push(TierGeometryPin.create("the return class", here: DbgClassReturn, named: "DbgClassReturn"))
	out.push(TierGeometryPin.create("the class word's shift", here: DbgClassShift, named: "DbgClassShift"))
	out.push(TierGeometryPin.create("the class word's byte mask", here: DbgClassByteMask, named: "DbgClassByteMask"))
	out.push(TierGeometryPin.create("the condition nibble's shift", here: DbgCondShift, named: "DbgCondShift"))
	out.push(TierGeometryPin.create("the indirect-call class", here: DbgClassIndirectCall, named: "DbgClassIndirectCall"))
	out.push(TierGeometryPin.create("an indirect call's form shift", here: DbgCallFormShift, named: "DbgCallFormShift"))
	out.push(TierGeometryPin.create("the call-through-a-pc-relative-word form", here: DbgCallFormPcRelative, named: "DbgCallFormPcRelative"))
	out.push(TierGeometryPin.create("an indirect call's mod/rm position shift", here: DbgCallModRmShift, named: "DbgCallModRmShift"))

	out.push(TierGeometryPin.create("the breakpoint table's capacity", here: DbgBreakpointCapacity, named: "DbgBreakpointCapacity"))
	out.push(TierGeometryPin.create("the slot pool's capacity", here: DbgSlotCapacity, named: "DbgSlotCapacity"))
	out.push(TierGeometryPin.create("an out-of-line slot's bytes", here: DbgSlotBytes, named: "DbgSlotBytes"))
	out.push(TierGeometryPin.create("a slot's tail offset", here: DbgSlotTailAt, named: "DbgSlotTailAt"))
	out.push(TierGeometryPin.create("a slot tail's flags push", here: DbgSlotTailFlagsAt, named: "DbgSlotTailFlagsAt"))
	out.push(TierGeometryPin.create("a slot tail's exit increment", here: DbgSlotTailIncAt, named: "DbgSlotTailIncAt"))
	out.push(TierGeometryPin.create("a slot tail's flags pop", here: DbgSlotTailPopAt, named: "DbgSlotTailPopAt"))
	out.push(TierGeometryPin.create("a slot tail's return", here: DbgSlotTailReturnAt, named: "DbgSlotTailReturnAt"))
	out.push(TierGeometryPin.create("a displaced direct call's target push", here: DbgCallHeadTargetAt, named: "DbgCallHeadTargetAt"))
	out.push(TierGeometryPin.create("a displaced direct call's jump to the tail", here: DbgCallHeadJumpAt, named: "DbgCallHeadJumpAt"))
