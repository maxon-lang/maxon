	out.push(TierGeometryPin.create("the backtrace command", here: DbgCmdBacktrace, named: "DbgCmdBacktrace"))
	out.push(TierGeometryPin.create("the read-memory command", here: DbgCmdReadMemory, named: "DbgCmdReadMemory"))
	out.push(TierGeometryPin.create("the step-instruction command", here: DbgCmdStepInstruction, named: "DbgCmdStepInstruction"))

