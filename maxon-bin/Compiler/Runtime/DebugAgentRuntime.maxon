	out.push(TierGeometryPin.create("the indirect-push opcode", here: DbgPushIndirectOpcode, named: "DbgPushIndirectOpcode"))
	out.push(TierGeometryPin.create("the indirect-push mod/rm byte", here: DbgPushIndirectModRm, named: "DbgPushIndirectModRm"))
