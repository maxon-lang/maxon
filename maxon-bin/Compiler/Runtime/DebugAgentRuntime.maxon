	out.push(TierGeometryPin.create("the stop trace mark's offset", here: DbgOffStopTraceMark, named: "DbgOffStopTraceMark"))
	out.push(TierGeometryPin.create("the text base's offset", here: DbgOffTextBase, named: "DbgOffTextBase"))
	out.push(TierGeometryPin.create("the text size's offset", here: DbgOffTextSize, named: "DbgOffTextSize"))
	out.push(TierGeometryPin.create("the stop pc's offset", here: DbgOffStopPc, named: "DbgOffStopPc"))
	out.push(TierGeometryPin.create("the stop sp's offset", here: DbgOffStopSp, named: "DbgOffStopSp"))
	out.push(TierGeometryPin.create("the stop fp's offset", here: DbgOffStopFp, named: "DbgOffStopFp"))
	out.push(TierGeometryPin.create("the register file's offset", here: DbgOffRegisters, named: "DbgOffRegisters"))
	out.push(TierGeometryPin.create("the backtrace count's offset", here: DbgOffBtCount, named: "DbgOffBtCount"))
	out.push(TierGeometryPin.create("the backtrace truncation flag's offset", here: DbgOffBtTruncated, named: "DbgOffBtTruncated"))
	out.push(TierGeometryPin.create("the backtrace frames' offset", here: DbgOffBtFrames, named: "DbgOffBtFrames"))
	out.push(TierGeometryPin.create("the read length's offset", here: DbgOffReadLen, named: "DbgOffReadLen"))
	out.push(TierGeometryPin.create("the read status's offset", here: DbgOffReadStatus, named: "DbgOffReadStatus"))
	out.push(TierGeometryPin.create("the read buffer's offset", here: DbgOffReadBuf, named: "DbgOffReadBuf"))
	out.push(TierGeometryPin.create("the agent's private word offset", here: DbgOffAgentPrivate, named: "DbgOffAgentPrivate"))

	out.push(TierGeometryPin.create("the register file's slots", here: DbgRegisterSlots, named: "DbgRegisterSlots"))
	out.push(TierGeometryPin.create("the backtrace cap", here: DbgMaxBacktraceFrames, named: "DbgMaxBacktraceFrames"))
