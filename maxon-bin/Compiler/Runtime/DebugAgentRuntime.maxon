	out.push(TierGeometryPin.create("the return class", here: DbgClassReturn, named: "DbgClassReturn"))
	out.push(TierGeometryPin.create("the class word's shift", here: DbgClassShift, named: "DbgClassShift"))
	out.push(TierGeometryPin.create("the class word's byte mask", here: DbgClassByteMask, named: "DbgClassByteMask"))
	out.push(TierGeometryPin.create("the condition nibble's shift", here: DbgCondShift, named: "DbgCondShift"))

	out.push(TierGeometryPin.create("the breakpoint table's capacity", here: DbgBreakpointCapacity, named: "DbgBreakpointCapacity"))
	out.push(TierGeometryPin.create("an out-of-line slot's bytes", here: DbgSlotBytes, named: "DbgSlotBytes"))

	out.push(TierGeometryPin.create("the orphaned exit code", here: DbgOrphanedExitCode, named: "DbgOrphanedExitCode"))
	out.push(TierGeometryPin.create("the park poll interval", here: DbgParkPollIntervalMs, named: "DbgParkPollIntervalMs"))

	out.push(TierGeometryPin.create("the install-trap-handler verb", here: debugHostVerbCode(DebugHostVerb.installTrapHandler), named: "DbgVerbInstallTrapHandler"))
	out.push(TierGeometryPin.create("the protect-pages verb", here: debugHostVerbCode(DebugHostVerb.protectPages), named: "DbgVerbProtectPages"))
	out.push(TierGeometryPin.create("the flush-code verb", here: debugHostVerbCode(DebugHostVerb.flushCode), named: "DbgVerbFlushCode"))
	out.push(TierGeometryPin.create("the park-wait verb", here: debugHostVerbCode(DebugHostVerb.parkWait), named: "DbgVerbParkWait"))
