// Runtime/NetpollRuntime.maxon — the scheduler's POLLER: Go's netpoll (`vendor/go/src/runtime/netpoll_*.go`),
// the one blocking wait an idle process makes.
//
// ⭐⭐ **ONE MACHINE BLOCKS HERE, AND ONLY WHEN SOMETHING IS PENDING.** A machine with nothing to run that finds a
// timer (or a parked child) pending and no other machine already polling waits in `__np_poll` until the earliest
// deadline; every other idle machine parks on its own event with no timeout (`SchedRuntime.buildSchedLoop`'s
// idle tail). A deadline armed earlier than the one the poller waits for ends its wait through a BREAK
// (`__np_break`), which is the whole cost of waking on time.
//
// ⭐ **THE POLLER CARRIES ITS BREAK SOURCE, ONE SOURCE PER PARKED CHILD, ONE PER REGISTERED SOCKET, AND — ON
// THE COMPLETION-PORT LANE — ONE PER OVERLAPPED OPERATION IN FLIGHT.** A wait answers entries and the decode
// keys on each entry's token: the break token takes the break arm, the overlapped token names an operation
// through its `lpOverlapped`, and anything else is a source key whose readiness goes to the poll-descriptor
// band below.

// ⭐⭐ **HOW THIS TARGET'S POLLER REPORTS AN EVENT — the fact the decode keys on, as `IoCompletionShape` is for a
// read.** Each shape is one OS mechanism, and each reports a break its own way:
enum NetpollShape
	// Windows: a completion port. A break is a posted packet, consumed by receiving it; the wait answers a BOOL
	// and writes its entry count through the scratch word.
	completionPort

	// Linux: an epoll set holding a level-triggered eventfd. A break stays readable until a blocking poll reads
	// the eventfd's counter (`NetpollVerb.drainBreak`); the wait answers a count or a negative errno.
	epoll

	// macOS: a kqueue holding an `EVFILT_USER` event registered `EV_CLEAR`. A break is consumed by receiving it;
	// the wait answers a count or a negative errno.
	kqueue
end 'NetpollShape'

// Keyed on the OS: the mechanism is the platform's, and only the entry LAYOUT also depends on the CPU.
export function netpollShape(target Target) returns NetpollShape
	return match target.os 'os'
		windows gives NetpollShape.completionPort
		linux gives NetpollShape.epoll
		macos gives NetpollShape.kqueue
		wasi panic("netpollShape: wasm32-wasi has no scheduler to poll with — `targetProvidesFacility` denies `greenThreads` there, and reaching here means a scheduler install got past that gate")
	end 'os'
end 'netpollShape'

// ⭐ **ONE ENTRY OF THE BATCH A WAIT FILLS, AND THE WORD IN IT THAT NAMES ITS SOURCE** — the completion key, the
// `epoll_data`, the kevent's ident. x86-64's `struct epoll_event` is PACKED (12 bytes, data at 4) where
// AArch64's is naturally aligned (16, data at 8), which is the one place the CPU enters this file.
type NetpollEntryLayout
	export let entryBytes as ByteOffset
	export let sourceOffset as ByteOffset

	export static function create(entryBytes ByteOffset, sourceOffset ByteOffset) returns NetpollEntryLayout
		return Self{entryBytes: entryBytes, sourceOffset: sourceOffset}
	end 'create'
end 'NetpollEntryLayout'

// `OVERLAPPED_ENTRY` is `lpCompletionKey, lpOverlapped, Internal, dwNumberOfBytesTransferred` (32 bytes). The
// last three are read only by the pipe-read arm of the decode: a child's exit is posted by hand and carries
// none of them.
let CompletionEntryBytes = 32 as ByteOffset
let CompletionEntryKeyOffset = 0 as ByteOffset
let CompletionEntryOverlappedOffset = 8 as ByteOffset
let CompletionEntryStatusOffset = 16 as ByteOffset
let CompletionEntryTransferredOffset = 24 as ByteOffset
let EpollPackedEntryBytes = 12 as ByteOffset
let EpollPackedDataOffset = 4 as ByteOffset
let EpollAlignedEntryBytes = 16 as ByteOffset
let EpollAlignedDataOffset = 8 as ByteOffset

function netpollEntryLayout(target Target) returns NetpollEntryLayout
	return match netpollShape(target) 'shape'
		completionPort gives NetpollEntryLayout.create(CompletionEntryBytes, sourceOffset: CompletionEntryKeyOffset)
		epoll gives epollEntryLayout(target.cpu)
		kqueue gives NetpollEntryLayout.create(DarwinKeventBytes as ByteOffset, sourceOffset: DarwinKeventIdentOffset as ByteOffset)
	end 'shape'
end 'netpollEntryLayout'

function epollEntryLayout(cpu CpuArch) returns NetpollEntryLayout
	return match cpu 'cpu'
		x64 gives NetpollEntryLayout.create(EpollPackedEntryBytes, sourceOffset: EpollPackedDataOffset)
		arm64 gives NetpollEntryLayout.create(EpollAlignedEntryBytes, sourceOffset: EpollAlignedDataOffset)
		wasm32 panic("epollEntryLayout: wasm32 has no epoll — `netpollShape` refuses wasi before this is asked")
	end 'cpu'
end 'epollEntryLayout'

// How many entries one wait may answer — Go's batch on Windows and kqueue.
let NetpollBatchEntries = 64 as ParsedInt

// `__np_poll`'s frame: the scratch word (the Windows entry count, the epoll drain buffer) in slot 0, then the
// batch. It lives on the polling machine's OS-thread stack, which has room for it; no green thread polls.
let NetpollScratchSlot = 0 as SpillSlot
let NetpollEntriesSlot = 1 as SpillSlot

function netpollFrameBytes(layout NetpollEntryLayout) returns StackSize
	let batchSlots = runtimeFrameSlots(NetpollBatchEntries * (layout.entryBytes as ParsedInt))
	return ((NetpollEntriesSlot as StackSize) + batchSlots) * SpillSlotBytes
end 'netpollFrameBytes'

// ==========================================================================
// The `.data` words
// ==========================================================================

// The poller and its break source, created by `__np_init` in `__sched_init_procs` before any worker exists and
// never written again.
let NetpollPollerLabel = b"__np_poller"
let NetpollBreakLabel = b"__np_break"

// ⭐⭐ **"A BREAK IS IN FLIGHT" — Go's `netpollWakeSig`.** A raise wins it 0 → 1 before sending, so however many
// parties want the poller awake at once, one break is outstanding; the blocking poll that consumes that break
// takes it 1 → 0. A non-blocking poll that receives it re-sends it for the blocking one and leaves the word at
// 1, so the invariant is exact: the word is 1 exactly while one break is unconsumed.
let NetpollWakeSigLabel = b"__np_wake_sig"

export function netpollRuntimeGlobals() returns DataSectionEntryArray
	var out = DataSectionEntryArray.create()
	pushRuntimeGlobal(out, label: NetpollPollerLabel, sharing: MultiMSharing.sealedBeforeWorkers, reach: DataReach.walked)
	pushRuntimeGlobal(out, label: NetpollBreakLabel, sharing: MultiMSharing.sealedBeforeWorkers, reach: DataReach.walked)
	pushRuntimeGlobal(out, label: NetpollWakeSigLabel, sharing: MultiMSharing.atomicStep, reach: DataReach.walked)

	// The poll-descriptor table's base and capacity — see that band's header for why both move in one hold.
	pushRuntimeGlobal(out, label: NetpollPdTableLabel, sharing: MultiMSharing.underSchedLock, reach: DataReach.walked)
	pushRuntimeGlobal(out, label: NetpollPdCapLabel, sharing: MultiMSharing.underSchedLock, reach: DataReach.walked)
	pushRuntimeGlobal(out, label: NetpollWaitersLabel, sharing: MultiMSharing.publishedFromTheLock, reach: DataReach.walked)

	// The completion-port lane's source-key allocator — see `PdOffNextFreeKey`. Both words move inside ONE hold
	// of `__sched_lock`, exactly as the table's base and capacity do.
	pushRuntimeGlobal(out, label: NetpollSourceKeyFreeLabel, sharing: MultiMSharing.underSchedLock, reach: DataReach.walked)
	pushRuntimeGlobal(out, label: NetpollSourceKeyHighLabel, sharing: MultiMSharing.underSchedLock, reach: DataReach.walked)
	return out
end 'netpollRuntimeGlobals'

let WakeSigClear = 0 as ParsedInt
let WakeSigRaised = 1 as ParsedInt

// ==========================================================================
// Entry points
// ==========================================================================

// `__np_init()` — create the poller and its break source. Called by `__sched_init_procs`.
export let NetpollInitName = b"__np_init"

// `__np_poll(timeoutMs)` — wait until an event or `timeoutMs` (`WaitInfinite` for ever, 0 for a look), and
// consume what the wait answered. A wait with a timeout of 0 is Go's non-blocking poll: it takes nothing that
// belongs to the blocking poller. Called with no processor, by the one polling machine or by `__sysmon`.
export let NetpollPollName = b"__np_poll"

// `__np_break()` — Go's `netpollBreak`: end the blocking poller's wait early, once however many ask.
export let NetpollBreakName = b"__np_break"

export function installNetpollRuntime(module StdModule, target Target)
	buildNetpollInit(module, target: target)
	buildNetpollPoll(module, target: target)
	buildNetpollBreak(module, target: target)

	// The poll-descriptor band. It is built on every lane because the park kind it serves is dispatched by
	// `__gt_register_park` and `__gt_timer_check`, which every green-thread program contains.
	buildNetpollPdSlot(module)
	buildNetpollPdAdopt(module)
	buildNetpollGroupUnhook(module)
	buildNetpollPdWaitAny(module)
	buildNetpollPdRelease(module)
	buildNetpollPdDeadline(module)
	buildNetpollPdWait(module)
	buildNetpollPdCommit(module)
	buildNetpollPdExpire(module)
	buildNetpollPdDrop(module)
	buildNetpollPdReadyOne(module)
	buildNetpollFail(module)
	buildNetpollPdWake(module, target: target)
	buildNetpollPdOpBegin(module)
	buildNetpollPdMarkTimedOut(module)
	buildNetpollPdTimedOut(module)

	buildNetpollPdOpen(module, target: target)

	// The completion-port lane's own source allocator, the per-operation doors it feeds and the wake an
	// overlapped completion takes. The two POSIX lanes draw every source from the kernel's descriptor table and
	// their transfers complete in their caller, so none of it exists there.
	match netpollShape(target) 'minters'
		completionPort then buildNetpollSourceKeyBand(module)

		epoll or
			kqueue then break 'minters'
	end 'minters'

	// The child-exit band. Every lane has it: a parked child is a source on the poller everywhere.
	buildNetpollChildOpen(module, target: target)
	buildNetpollChildArm(module, target: target)
	buildNetpollChildClose(module, target: target)

	// The pipe band, likewise on every lane — the completion-port shape answers both doors with nothing to do.
	buildNetpollPipeOpen(module, target: target)
	buildNetpollPipeClose(module, target: target)
end 'installNetpollRuntime'

// Emit one `osNetpoll`, padding the operands `verb` does not read with a zero, and answer its raw result.
export function emitNetpoll(module StdModule, block IrBlock, verb NetpollVerb, operands ValueIdArray, ids ValueMinter) returns ValueId
	var padded = operands.clone()
	let unused = emitConst(module, block: block, value: 0, ids: ids)

	while padded.count() < NetpollOperandCount 'pad'
		padded.push(unused)
	end 'pad'

	let answer = ids.mint()
	module.appendOp(block, op: StdOp.osNetpoll(answer, verb: verb, a0Id: netpollOperand(padded, index: 0), a1Id: netpollOperand(padded, index: 1), a2Id: netpollOperand(padded, index: 2), a3Id: netpollOperand(padded, index: 3), a4Id: netpollOperand(padded, index: 4)))
	return answer
end 'emitNetpoll'

// `StdOp.osNetpoll`'s operand count.
let NetpollOperandCount = 5

// 1 when `answer` — every verb's but `wait`'s — reports a failure in this shape's vocabulary, else 0: a Win32
// handle or BOOL of 0, or a POSIX negative errno. `openTimer`'s POSIX answer is 0 by contract and never fails.
// ⭐⭐⭐ **A HOST REFUSAL THAT NAMES ONLY ITSELF COSTS ONE LANE RUN PER GUESS.** `netpollFailed` is a single
// exit code standing for fourteen verbs across three kernels, and the lanes that can raise it — a Mac, a
// Linux-hosted harness — are the ones nobody can attach a debugger to. So the abort SAYS which verb asked and
// what the host answered, on stderr, before it exits: one run then answers *"which call, and which errno"*
// instead of narrowing it by elimination.
//
// ⚠ **IT RENDERS THROUGH `__int_to_string` AND THAT IS A TRANSITIVE USAGE BIT**, declared at
// `RuntimeUsage.recordGtUsage` — this call is emitted by a BUILDER, and the Maxon-module scan that fills
// `RuntimeUsage` sees only what the parser emitted, never one tier down.
let NetpollFailName = b"__np_fail"

// The three literals of the line, and the frame slot its digits are rendered into. A stack slot rather than
// a `__slab_alloc`, because this runs on the way out of a process whose allocator may be why it is dying.
let NetpollFailVerbText = b"netpoll: verb "
let NetpollFailSubjectText = b" on "
let NetpollFailAnswerText = b" refused by the host, which answered "
let NetpollFailEndText = b"\n"
let NetpollFailDigitsBytes = 24 as StackSize
let NetpollFailDigitsSlot = 0 as SpillSlot

// `__np_fail(verb, answer)` — see `NetpollFailName`.
function buildNetpollFail(module StdModule)
	var func = IrFunction.createFromStd(NetpollFailName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let verb = 0 as ValueId
	let subject = 1 as ValueId
	let answer = 2 as ValueId

	func.stackSize = NetpollFailDigitsBytes
	let digits = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(digits, slot: NetpollFailDigitsSlot))

	emitNetpollFailText(module, block: entry, ids: ids, text: NetpollFailVerbText)
	emitNetpollFailNumber(module, block: entry, ids: ids, digits: digits, value: verb)
	emitNetpollFailText(module, block: entry, ids: ids, text: NetpollFailSubjectText)
	emitNetpollFailNumber(module, block: entry, ids: ids, digits: digits, value: subject)
	emitNetpollFailText(module, block: entry, ids: ids, text: NetpollFailAnswerText)
	emitNetpollFailNumber(module, block: entry, ids: ids, digits: digits, value: answer)
	emitNetpollFailText(module, block: entry, ids: ids, text: NetpollFailEndText)

	emitRuntimeAbort(module, func: func, block: entry, abort: RuntimeAbort.netpollFailed, ids: ids)
	module.functions.push(func)
end 'buildNetpollFail'

function emitNetpollFailText(module StdModule, block IrBlock, ids ValueMinter, text ByteArray)
	let buf = emitLiteralCString(module, block: block, ids: ids, text: text)
	module.appendOp(block, op: StdOp.osWriteStderr(ids.mint(), bufId: buf, lenId: emitConst(module, block: block, value: text.count(), ids: ids)))
end 'emitNetpollFailText'

function emitNetpollFailNumber(module StdModule, block IrBlock, ids ValueMinter, digits ValueId, value ValueId)
	let written = ids.mint()
	module.appendOp(block, op: StdOp.call(written, callee: IntToStringName, args: twoArgs(value, second: digits)))
	module.appendOp(block, op: StdOp.osWriteStderr(ids.mint(), bufId: digits, lenId: written))
end 'emitNetpollFailNumber'

// Raise the named failure from `block`, which never falls out of it.
//
// \u2b50\u2b50 **`subject` IS THE DESCRIPTOR THE VERB WAS ASKED ABOUT, AND IT SEPARATES TWO FAULTS ONE NUMBER
// CANNOT.** A plausible small integer says the call really was refused and the errno is the whole story; a
// huge or negative one says the operand never reached the chunk, or a register holding it was consumed before
// it was read \u2014 and a value that reads as a stack address names that shape outright. MEASURED: `armPipeSource`
// answered `-1` twice with no way to tell those apart, at ten minutes a round trip.
function emitNetpollFailWith(module StdModule, func IrFunction, block IrBlock, verb NetpollVerb, subject ValueId, answer ValueId, ids ValueMinter)
	let ordinal = verb.rawValue as ParsedInt
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollFailName, args: threeArgs(emitConst(module, block: block, value: ordinal, ids: ids), second: subject, third: answer)))
	emitRuntimeAbort(module, func: func, block: block, abort: RuntimeAbort.netpollFailed, ids: ids)
end 'emitNetpollFailWith'

function emitNetpollFailed(module StdModule, block IrBlock, shape NetpollShape, answer ValueId, ids ValueMinter) returns ValueId
	let zero = emitConst(module, block: block, value: 0, ids: ids)
	return match shape 'failure'
		completionPort gives emitCmp(module, block: block, a: answer, b: zero, pred: StdCmpPred.eq, ids: ids)
		epoll or
			kqueue gives emitCmp(module, block: block, a: answer, b: zero, pred: StdCmpPred.lt, ids: ids)
	end 'failure'
end 'emitNetpollFailed'

// Terminate `cur`: to the named failure when `answer` failed, else to `cont`.
function emitNetpollRequire(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, verb NetpollVerb, subject ValueId, answer ValueId, cont IrBlock, ids ValueMinter)
	var failed = module.addBlock(func, label: b"npfailed", heat: BlockHeat.normal)
	module.setTerminator(cur, op: StdOp.condBranch(emitNetpollFailed(module, block: cur, shape: shape, answer: answer, ids: ids), thenBlockId: failed.id, elseBlockId: cont.id))
	emitNetpollFailWith(module, func: func, block: failed, verb: verb, subject: subject, answer: answer, ids: ids)
end 'emitNetpollRequire'

// ⭐ **THE MONITOR'S SLEEP TIMER: HIGH RESOLUTION, OR THE ORDINARY ONE ON A HOST THAT PREDATES THE FLAG** —
// `ProfileRuntime.buildProfileTimerCreate`'s fallback, for its reason: the ordinary timer still sleeps, at the
// scheduler tick. Terminates `cur` and reaches `cont` with the timer as its one block argument, or aborts with
// `netpollFailed` when neither can be created. A POSIX lane's answer is never a failure.
export function emitNetpollOpenTimer(module StdModule, func IrFunction, cur IrBlock, target Target, cont IrBlock, ids ValueMinter)
	let shape = netpollShape(target)
	var coarse = module.addBlock(func, label: b"nptimercoarse", heat: BlockHeat.normal)

	let fine = emitNetpoll(module, block: cur, verb: NetpollVerb.openTimer, operands: argsOf(emitConst(module, block: cur, value: CreateWaitableTimerHighResolution, ids: ids)), ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(emitNetpollFailed(module, block: cur, shape: shape, answer: fine, ids: ids), thenBlockId: coarse.id, elseBlockId: cont.id))
	cur.branchEdges.push(BranchEdge.create(cont.id, argIds: argsOf(fine)))

	let plain = emitNetpoll(module, block: coarse, verb: NetpollVerb.openTimer, operands: argsOf(emitConst(module, block: coarse, value: CreateWaitableTimerOrdinary, ids: ids)), ids: ids)
	emitNetpollRequire(module, func: func, cur: coarse, shape: shape, verb: NetpollVerb.openTimer, subject: plain, answer: plain, cont: cont, ids: ids)
	coarse.branchEdges.push(BranchEdge.create(cont.id, argIds: argsOf(plain)))
end 'emitNetpollOpenTimer'

// `__np_init()` — see `NetpollInitName`.
function buildNetpollInit(module StdModule, target Target)
	let shape = netpollShape(target)
	var func = IrFunction.createFromStd(NetpollInitName, returnType: StdReturnType.void, paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var opened = module.addBlock(func, label: b"npopened", heat: BlockHeat.normal)
	var armed = module.addBlock(func, label: b"nparmed", heat: BlockHeat.normal)

	let poller = emitNetpoll(module, block: entry, verb: NetpollVerb.openPoller, operands: ValueIdArray.create(), ids: ids)
	emitNetpollRequire(module, func: func, cur: entry, shape: shape, verb: NetpollVerb.openPoller, subject: poller, answer: poller, cont: opened, ids: ids)

	emitStoreGlobalWord(module, block: opened, label: NetpollPollerLabel, value: poller, ids: ids)
	let breakSource = emitNetpoll(module, block: opened, verb: NetpollVerb.openBreak, operands: argsOf(poller), ids: ids)
	emitNetpollRequire(module, func: func, cur: opened, shape: shape, verb: NetpollVerb.armSource, subject: breakSource, answer: breakSource, cont: armed, ids: ids)

	emitStoreGlobalWord(module, block: armed, label: NetpollBreakLabel, value: breakSource, ids: ids)
	module.setTerminator(armed, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildNetpollInit'

// `__np_break()` — see `NetpollBreakName`.
function buildNetpollBreak(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollBreakName, returnType: StdReturnType.void, paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var raise = module.addBlock(func, label: b"npraise", heat: BlockHeat.normal)
	var raised = module.addBlock(func, label: b"npraised", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npdone", heat: BlockHeat.normal)

	let won = emitNetpollClaimWakeSig(module, block: entry, expected: WakeSigClear, replacement: WakeSigRaised, ids: ids)
	let inFlight = emitCasLostFlag(module, block: entry, result: won, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(inFlight, thenBlockId: doneBlock.id, elseBlockId: raise.id))

	emitNetpollRaise(module, func: func, cur: raise, shape: netpollShape(target), cont: raised, ids: ids)
	module.setTerminator(raised, op: StdOp.branch(doneBlock.id))

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollBreak'

// CAS `__np_wake_sig` from `expected` to `replacement`, answering the CAS's success boolean.
function emitNetpollClaimWakeSig(module StdModule, block IrBlock, expected ParsedInt, replacement ParsedInt, ids ValueMinter) returns ValueId
	let addr = ids.mint()
	module.appendOp(block, op: StdOp.globalAddr(addr, label: NetpollWakeSigLabel))
	let won = ids.mint()
	module.appendOp(block, op: StdOp.atomicCas(won, addrId: addr, expectedId: emitConst(module, block: block, value: expected, ids: ids), replacementId: emitConst(module, block: block, value: replacement, ids: ids)))
	return won
end 'emitNetpollClaimWakeSig'

// 1 when a CAS answered `AtomicCasFailed`.
function emitCasLostFlag(module StdModule, block IrBlock, result ValueId, ids ValueMinter) returns ValueId
	return emitCmp(module, block: block, a: result, b: emitConst(module, block: block, value: AtomicCasFailed, ids: ids), pred: StdCmpPred.eq, ids: ids)
end 'emitCasLostFlag'

// Send one break to the poller, whatever `__np_wake_sig` says — the caller has settled that. Terminates `cur`
// and continues at `cont`.
function emitNetpollRaise(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, cont IrBlock, ids ValueMinter)
	let poller = emitLoadGlobalWord(module, block: cur, label: NetpollPollerLabel, ids: ids)
	let breakSource = emitLoadGlobalWord(module, block: cur, label: NetpollBreakLabel, ids: ids)
	let answer = emitNetpoll(module, block: cur, verb: NetpollVerb.raiseBreak, operands: twoArgs(poller, second: breakSource), ids: ids)
	emitNetpollRequire(module, func: func, cur: cur, shape: shape, verb: NetpollVerb.raiseBreak, subject: breakSource, answer: answer, cont: cont, ids: ids)
end 'emitNetpollRaise'

// ⭐⭐⭐ **`__np_poll(timeoutMs)` — THE WAIT, AND THE ONE DECODE OF WHAT IT ANSWERED.**
//
// ⚠ **A BREAK BELONGS TO THE BLOCKING POLLER** (Go's `delay != 0`). A non-blocking poll that receives one — only
// `__sysmon`'s stale poll makes those — leaves it for the blocking one: the epoll shape simply does not read the
// eventfd, which stays readable, and the two shapes whose receive consumes the break send it again. Only the
// blocking poll clears `__np_wake_sig`, so a later raise is never swallowed by the coalescing.
function buildNetpollPoll(module StdModule, target Target)
	let shape = netpollShape(target)
	let layout = netpollEntryLayout(target)
	var func = IrFunction.createFromStd(NetpollPollName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)
	func.stackSize = netpollFrameBytes(layout)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var counted = module.addBlock(func, label: b"npcounted", heat: BlockHeat.normal)
	var entryBody = module.addBlock(func, label: b"npentry", heat: BlockHeat.normal)
	var consume = module.addBlock(func, label: b"npbreak", heat: BlockHeat.normal)
	var nextEntry = module.addBlock(func, label: b"npnext", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npdone", heat: BlockHeat.normal)
	var failedWait = module.addBlock(func, label: b"npwaitfailed", heat: BlockHeat.normal)
	var otherSource = module.addBlock(func, label: b"npother", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let timeoutMs = 0 as ValueId

	// The scratch word starts at zero: `GetQueuedCompletionStatusEx` writes a 32-bit count into its low half.
	let scratch = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(scratch, slot: NetpollScratchSlot))
	emitStoreField(module, block: entry, record: scratch, offset: 0, value: emitConst(module, block: entry, value: 0, ids: ids))
	let entries = ids.mint()
	module.appendOp(entry, op: StdOp.stackRecordAddr(entries, slot: NetpollEntriesSlot))
	let poller = emitLoadGlobalWord(module, block: entry, label: NetpollPollerLabel, ids: ids)
	let capacity = emitConst(module, block: entry, value: NetpollBatchEntries, ids: ids)
	let answer = emitNetpoll(module, block: entry, verb: NetpollVerb.wait, operands: fiveArgs(poller, second: entries, third: capacity, fourth: timeoutMs, fifth: scratch), ids: ids)

	let count = ids.mint()
	counted.blockArgs.push(IrBlockArg.create(count, argType: StdType.i64))
	emitNetpollWaitCount(module, func: func, cur: entry, shape: shape, answer: answer, scratch: scratch, counted: counted, failed: failedWait, ids: ids)

	// The walk over the batch: `index` from 0 to `count`.
	let index = ids.mint()
	var entryHdr = module.addBlock(func, label: b"nphdr", heat: BlockHeat.normal)
	entryHdr.blockArgs.push(IrBlockArg.create(index, argType: StdType.i64))
	let firstIndex = emitConst(module, block: counted, value: 0, ids: ids)
	module.setTerminator(counted, op: StdOp.branch(entryHdr.id))
	counted.branchEdges.push(BranchEdge.create(entryHdr.id, argIds: argsOf(firstIndex)))

	let walked = emitCmp(module, block: entryHdr, a: index, b: count, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(entryHdr, op: StdOp.condBranch(walked, thenBlockId: doneBlock.id, elseBlockId: entryBody.id))

	let stride = emitConst(module, block: entryBody, value: layout.entryBytes as ParsedInt, ids: ids)
	let entryAddr = emitBin(module, block: entryBody, a: entries, b: emitBin(module, block: entryBody, a: index, b: stride, opcode: StdBinOpcode.mul, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	let source = emitLoadField(module, block: entryBody, record: entryAddr, offset: layout.sourceOffset, ids: ids)
	let isBreak = emitCmp(module, block: entryBody, a: source, b: emitConst(module, block: entryBody, value: NetpollBreakToken, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entryBody, op: StdOp.condBranch(isBreak, thenBlockId: consume.id, elseBlockId: otherSource.id))

	emitNetpollConsumeBreak(module, func: func, cur: consume, shape: shape, timeoutMs: timeoutMs, cont: nextEntry, ids: ids)
	emitNetpollDecodeSource(module, func: func, cur: otherSource, shape: shape, entryAddr: entryAddr, key: source, cont: nextEntry, ids: ids)

	let nextIndex = emitBin(module, block: nextEntry, a: index, b: emitConst(module, block: nextEntry, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(nextEntry, op: StdOp.branch(entryHdr.id))
	nextEntry.branchEdges.push(BranchEdge.create(entryHdr.id, argIds: argsOf(nextIndex)))

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	emitNetpollFailWith(module, func: func, block: failedWait, verb: NetpollVerb.wait, subject: poller, answer: answer, ids: ids)

	module.functions.push(func)
end 'buildNetpollPoll'

// ⭐⭐⭐ **THE COMPLETION-PORT LANE HAS THREE PACKET SHAPES AND EACH IS NAMED HERE.** A break, a child's exit
// posted by hand, and an overlapped pipe read the kernel finished — and the two tokens are what tell them
// apart, because a source key is the only other thing the key word can hold. A POSIX poller reports one shape
// and reaches the readiness walk directly.
function emitNetpollDecodeSource(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, entryAddr ValueId, key ValueId, cont IrBlock, ids ValueMinter)
	match shape 'shape'
		epoll or
			kqueue then emitNetpollSourceReady(module, func: func, cur: cur, shape: shape, entryAddr: entryAddr, fd: key, cont: cont, label: b"npsockwake", ids: ids)

		completionPort then emitNetpollDecodeCompletion(module, func: func, cur: cur, shape: shape, entryAddr: entryAddr, key: key, cont: cont, ids: ids)
	end 'shape'
end 'emitNetpollDecodeSource'

// ⭐⭐ **AN OVERLAPPED OPERATION'S PACKET NAMES ITS OPERATION THROUGH `lpOverlapped`, NOT THROUGH ITS KEY.**
// The key is fixed when the handle joins the port, so every read on one pipe and every transfer on one socket
// carries the same one; the OVERLAPPED is embedded in the issuing green thread (`GtRuntime.GtOffOverlapped`),
// so CONTAINING_RECORD recovers exactly the thread whose buffer the kernel has finished with.
//
// ⚠ **THE TRANSFER IS TAKEN FROM THE PACKET RATHER THAN FROM THE OVERLAPPED.** `dwNumberOfBytesTransferred`
// and `Internal` are the documented fields of `OVERLAPPED_ENTRY`; the same two words inside an `OVERLAPPED` are
// an `IO_STATUS_BLOCK` whose high half is a union with a pointer, so the status is masked to its 32 bits.
//
// ⚠ **THE TWO STORES PRECEDE THE WAKE AND NEED NO LOCK.** They are the issuing thread's own words, and that
// thread is either still parked or not yet parked — either way it reads them only after `__np_op_wake` has
// readied it, which is a lock release later.
function emitNetpollDecodeCompletion(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, entryAddr ValueId, key ValueId, cont IrBlock, ids ValueMinter)
	var overlappedDone = module.addBlock(func, label: b"npovldone", heat: BlockHeat.normal)
	var childExit = module.addBlock(func, label: b"npchildexit", heat: BlockHeat.normal)
	var payWake = module.addBlock(func, label: b"npovlwake", heat: BlockHeat.normal)

	let isOverlapped = emitCmp(module, block: cur, a: key, b: emitConst(module, block: cur, value: NetpollOverlappedToken, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(isOverlapped, thenBlockId: overlappedDone.id, elseBlockId: childExit.id))

	let overlapped = emitLoadField(module, block: overlappedDone, record: entryAddr, offset: CompletionEntryOverlappedOffset, ids: ids)
	let gt = emitBin(module, block: overlappedDone, a: overlapped, b: emitConst(module, block: overlappedDone, value: GtOffOverlapped as ParsedInt, ids: ids), opcode: StdBinOpcode.sub, ids: ids)
	emitStoreField(module, block: overlappedDone, record: gt, offset: GtOffIoResult, value: emitLoadField(module, block: overlappedDone, record: entryAddr, offset: CompletionEntryTransferredOffset, ids: ids))
	let status = emitLoadField(module, block: overlappedDone, record: entryAddr, offset: CompletionEntryStatusOffset, ids: ids)
	emitStoreField(module, block: overlappedDone, record: gt, offset: GtOffIoStatus, value: emitBin(module, block: overlappedDone, a: status, b: emitConst(module, block: overlappedDone, value: NetpollStatusMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids))
	let debt = ids.mint()
	module.appendOp(overlappedDone, op: StdOp.call(debt, callee: NetpollOpWakeName, args: argsOf(gt)))
	emitSchedWakeIfOwed(module, cur: overlappedDone, owed: debt, wake: payWake, cont: cont, ids: ids)

	emitNetpollSourceReady(module, func: func, cur: childExit, shape: shape, entryAddr: entryAddr, fd: key, cont: cont, label: b"npsockwake", ids: ids)
end 'emitNetpollDecodeCompletion'

// An NTSTATUS is 32 bits in a word that is 64 — see `emitNetpollDecodeCompletion`.
let NetpollStatusMask = 4294967295 as ParsedInt

// ⭐⭐ **AN ENTRY THAT NAMES A SOURCE — a SOCKET or a CHILD on a POSIX lane, a CHILD or a pipe read on the
// completion-port one.** Every shape carries the same two facts (which source, and in which directions), each
// in its own field, so one readiness walk serves all three.
//
// ⚠ **THE WALK READIES ONTO THE GLOBAL QUEUE AND PAYS ITS OWN WAKE DEBT.** The polling machine holds no
// processor, so a thread it readies has no ring to go in; and its two callers differ — the idle tail looks for
// work itself the moment it returns, where `__sysmon`'s stale poll does not. Paying here is correct for both
// and costs the idle tail one needless wake.
function emitNetpollSourceReady(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, entryAddr ValueId, fd ValueId, cont IrBlock, label ByteArray, ids ValueMinter)
	var payWake = module.addBlock(func, label: label, heat: BlockHeat.normal)

	let ready = emitNetpollEntryReadiness(module, block: cur, shape: shape, entryAddr: entryAddr, ids: ids)
	let debt = ids.mint()
	module.appendOp(cur, op: StdOp.call(debt, callee: NetpollPdWakeName, args: threeArgs(fd, second: ready.readReady, third: ready.writeReady)))
	emitSchedWakeIfOwed(module, cur: cur, owed: debt, wake: payWake, cont: cont, ids: ids)
end 'emitNetpollSourceReady'

// ⭐ **WHICH DIRECTIONS ONE ENTRY REPORTS**, as a pair of 0/1 values — the second fact an entry carries beside
// its source, and the one the break arm never has to ask.
type NetpollReadiness
	export let readReady as ValueId
	export let writeReady as ValueId

	export static function create(readReady ValueId, writeReady ValueId) returns NetpollReadiness
		return Self{readReady: readReady, writeReady: writeReady}
	end 'create'
end 'NetpollReadiness'

function emitNetpollEntryReadiness(module StdModule, block IrBlock, shape NetpollShape, entryAddr ValueId, ids ValueMinter) returns NetpollReadiness
	return match shape 'shape'
		epoll gives emitEpollEntryReadiness(module, block: block, entryAddr: entryAddr, ids: ids)
		kqueue gives emitKeventEntryReadiness(module, block: block, entryAddr: entryAddr, ids: ids)

		// ⭐ **A PACKET CARRIES NO DIRECTIONS, AND THE ONLY ONE THAT REACHES THIS WALK DOES NOT NEED ANY.** What is
		// left here is a handle a thread-pool wait posted by hand — a child's exit, or a handshake's event — and
		// its one direction is read. An overlapped transfer takes `__np_op_wake` instead, which reads the
		// direction off the thread that issued it.
		completionPort gives NetpollReadiness.create(emitConst(module, block: block, value: 1, ids: ids), writeReady: emitConst(module, block: block, value: 0, ids: ids))
	end 'shape'
end 'emitNetpollEntryReadiness'

// ⚠ **`EPOLLERR` AND `EPOLLHUP` COUNT AS BOTH DIRECTIONS.** The kernel reports them whether or not the waiter
// asked for them, and a thread left parked on a descriptor that has failed is a wait nothing can end; the
// re-issued syscall is what turns the event into the operation's own errno.
function emitEpollEntryReadiness(module StdModule, block IrBlock, entryAddr ValueId, ids ValueMinter) returns NetpollReadiness
	let word = emitLoadField(module, block: block, record: entryAddr, offset: 0, ids: ids)
	let events = emitBin(module, block: block, a: word, b: emitConst(module, block: block, value: DwordMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	let readable = emitNetpollEventTest(module, block: block, events: events, mask: LinuxEpollIn + LinuxEpollErr + LinuxEpollHup + LinuxEpollRdHup, ids: ids)
	return NetpollReadiness.create(readable, writeReady: emitNetpollEventTest(module, block: block, events: events, mask: LinuxEpollOut + LinuxEpollErr + LinuxEpollHup, ids: ids))
end 'emitEpollEntryReadiness'

function emitNetpollEventTest(module StdModule, block IrBlock, events ValueId, mask ParsedInt, ids ValueMinter) returns ValueId
	let hit = emitBin(module, block: block, a: events, b: emitConst(module, block: block, value: mask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	return emitCmp(module, block: block, a: hit, b: emitConst(module, block: block, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
end 'emitNetpollEventTest'

// ⚠ **kqueue REPORTS ONE DIRECTION PER ENTRY**, because each direction is a registration of its own: the
// FILTER is the whole answer, where epoll packs both into one bitmask.
function emitKeventEntryReadiness(module StdModule, block IrBlock, entryAddr ValueId, ids ValueMinter) returns NetpollReadiness
	let word = emitLoadField(module, block: block, record: entryAddr, offset: DarwinKeventFilterOffset as ByteOffset, ids: ids)
	let filter = emitBin(module, block: block, a: word, b: emitConst(module, block: block, value: DarwinKeventFilterMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	let isRead = emitCmp(module, block: block, a: filter, b: emitConst(module, block: block, value: DarwinEvfiltRead and DarwinKeventFilterMask, ids: ids), pred: StdCmpPred.eq, ids: ids)
	return NetpollReadiness.create(isRead, writeReady: emitCmp(module, block: block, a: filter, b: emitConst(module, block: block, value: DarwinEvfiltWrite and DarwinKeventFilterMask, ids: ids), pred: StdCmpPred.eq, ids: ids))
end 'emitKeventEntryReadiness'

// ⭐ **HOW MANY ENTRIES THE WAIT FILLED, IN THIS SHAPE'S VOCABULARY.** Terminates `cur`: to `counted` with the
// count as its argument, or to `failed`. The POSIX chunks already answer an interrupted wait as 0 entries, so a
// negative answer there is a real failure. `GetQueuedCompletionStatusEx` answers FALSE for a timeout as well as
// for a failure, and `GetLastError` tells the two apart.
function emitNetpollWaitCount(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, answer ValueId, scratch ValueId, counted IrBlock, failed IrBlock, ids ValueMinter)
	let zero = emitConst(module, block: cur, value: 0, ids: ids)

	match shape 'decode'
		completionPort then emitNetpollCompletionCount(module, func: func, cur: cur, answer: answer, scratch: scratch, counted: counted, failed: failed, ids: ids)
		epoll or
			kqueue then emitBranchOnWaitFailure(module, cur: cur, failedTest: emitCmp(module, block: cur, a: answer, b: zero, pred: StdCmpPred.lt, ids: ids), failed: failed, counted: counted, count: answer)
	end 'decode'
end 'emitNetpollWaitCount'

function emitBranchOnWaitFailure(module StdModule, cur IrBlock, failedTest ValueId, failed IrBlock, counted IrBlock, count ValueId)
	module.setTerminator(cur, op: StdOp.condBranch(failedTest, thenBlockId: failed.id, elseBlockId: counted.id))
	cur.branchEdges.push(BranchEdge.create(counted.id, argIds: argsOf(count)))
end 'emitBranchOnWaitFailure'

function emitNetpollCompletionCount(module StdModule, func IrFunction, cur IrBlock, answer ValueId, scratch ValueId, counted IrBlock, failed IrBlock, ids ValueMinter)
	var dequeued = module.addBlock(func, label: b"npdequeued", heat: BlockHeat.normal)
	var empty = module.addBlock(func, label: b"npempty", heat: BlockHeat.normal)

	let zero = emitConst(module, block: cur, value: 0, ids: ids)
	let returnedFalse = emitCmp(module, block: cur, a: answer, b: zero, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(returnedFalse, thenBlockId: empty.id, elseBlockId: dequeued.id))

	let removed = emitLoadField(module, block: dequeued, record: scratch, offset: 0, ids: ids)
	module.setTerminator(dequeued, op: StdOp.branch(counted.id))
	dequeued.branchEdges.push(BranchEdge.create(counted.id, argIds: argsOf(removed)))

	let lastError = ids.mint()
	module.appendOp(empty, op: StdOp.osLastError(lastError))
	let timedOut = emitCmp(module, block: empty, a: lastError, b: emitConst(module, block: empty, value: WaitTimeout, ids: ids), pred: StdCmpPred.eq, ids: ids)
	let noEntries = emitConst(module, block: empty, value: 0, ids: ids)
	module.setTerminator(empty, op: StdOp.condBranch(timedOut, thenBlockId: counted.id, elseBlockId: failed.id))
	empty.branchEdges.push(BranchEdge.create(counted.id, argIds: argsOf(noEntries)))
end 'emitNetpollCompletionCount'

// ⭐ **ONE BREAK RECEIVED.** Terminates `cur` and continues at `cont`. See `buildNetpollPoll` for whose break it
// is; a blocking poll's clear of `__np_wake_sig` that finds the word already clear is a break no raise sent,
// which is `netpollFailed`'s case too — the coalescing has lost count and a later raise could be swallowed.
function emitNetpollConsumeBreak(module StdModule, func IrFunction, cur IrBlock, shape NetpollShape, timeoutMs ValueId, cont IrBlock, ids ValueMinter)
	var blocking = module.addBlock(func, label: b"npbreakblocking", heat: BlockHeat.normal)
	var passing = module.addBlock(func, label: b"npbreakpassing", heat: BlockHeat.normal)
	var cleared = module.addBlock(func, label: b"npbreakclear", heat: BlockHeat.normal)
	var lostCount = module.addBlock(func, label: b"npbreakunsent", heat: BlockHeat.normal)

	let isBlocking = emitCmp(module, block: cur, a: timeoutMs, b: emitConst(module, block: cur, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(isBlocking, thenBlockId: blocking.id, elseBlockId: passing.id))

	// The blocking poll takes the break: the epoll shape reads the counter back to zero, then the word clears.
	match shape 'take'
		epoll then emitNetpollDrain(module, func: func, cur: blocking, cont: cleared, ids: ids)
		completionPort or
			kqueue then module.setTerminator(blocking, op: StdOp.branch(cleared.id))
	end 'take'

	let won = emitNetpollClaimWakeSig(module, block: cleared, expected: WakeSigRaised, replacement: WakeSigClear, ids: ids)
	module.setTerminator(cleared, op: StdOp.condBranch(emitCasLostFlag(module, block: cleared, result: won, ids: ids), thenBlockId: lostCount.id, elseBlockId: cont.id))
	emitRuntimeAbort(module, func: func, block: lostCount, abort: RuntimeAbort.netpollFailed, ids: ids)

	// A non-blocking poll passes the break on.
	match shape 'pass'
		epoll then module.setTerminator(passing, op: StdOp.branch(cont.id))
		completionPort or
			kqueue then emitNetpollRaise(module, func: func, cur: passing, shape: shape, cont: cont, ids: ids)
	end 'pass'
end 'emitNetpollConsumeBreak'

// Read the eventfd's counter back to zero. Terminates `cur` and continues at `cont`.
//
// ⛔⛔ **A COUNTER ALREADY AT ZERO ANSWERS `EAGAIN`, AND THAT MEANS THE DRAIN IS DONE.** The descriptor is
// non-blocking, so a read finding nothing to take is the state this call exists to reach — not a refusal. It
// is the `openChildSource`/`ESRCH` shape exactly: a runtime path reading *"the thing already happened"* as
// *"the host refused me"*, and one that aborts a correct program only when the timing goes a particular way.
// The drain is `epoll`-only, so Linux's `EAGAIN` is the one number that can arrive here.
function emitNetpollDrain(module StdModule, func IrFunction, cur IrBlock, cont IrBlock, ids ValueMinter)
	var checked = module.addBlock(func, label: b"npdrainchk", heat: BlockHeat.normal)

	let breakSource = emitLoadGlobalWord(module, block: cur, label: NetpollBreakLabel, ids: ids)
	let answer = emitNetpoll(module, block: cur, verb: NetpollVerb.drainBreak, operands: argsOf(breakSource), ids: ids)
	let empty = emitCmp(module, block: cur, a: answer, b: emitConst(module, block: cur, value: 0 - LinuxErrnoWouldBlock, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(empty, thenBlockId: cont.id, elseBlockId: checked.id))

	emitNetpollRequire(module, func: func, cur: checked, shape: NetpollShape.epoll, verb: NetpollVerb.drainBreak, subject: breakSource, answer: answer, cont: cont, ids: ids)
end 'emitNetpollDrain'

// ==========================================================================
// THE POLL DESCRIPTORS — one record per registered socket, Go's `pollDesc`
// ==========================================================================
//
// ⭐⭐⭐ **THE TABLE IS KEYED BY FILE DESCRIPTOR AND THE SOCKET BOX DOES NOT CHANGE.** Go hangs a `pollDesc`
// off the `netFD` that owns it; here the owner is an 8-byte `__ManagedSocket` whose single `_handle` field is
// stated by a registered `StructLayout`, guarded against drift, and written down in committed spec prose — so
// growing it to carry a pointer would be one shape restated in four places. A POSIX descriptor is a small
// dense integer (`socket(2)` answers the lowest free one), so an fd-INDEXED array is an O(1) lookup and the
// box, the layout and the guard are all untouched.
//
// ⭐ **RECORDS ARE NEVER FREED — Go's `pollcache`.** A descriptor the OS reuses gets the record its previous
// owner had, reset at `__np_pd_open`; a free list would need exactly the races this band exists to avoid. The
// TABLE grows by doubling and hands the old region back.
//
// ⛔⛔ **EVERY WORD OF EVERY RECORD IS READ AND WRITTEN UNDER `__sched_lock`, AND THAT IS WHY THIS BAND HAS NO
// CAS IN IT.** Go's state machine is lock-free because its poller holds no lock of its own; here the four
// parties that move a direction word — the waiting green thread, its registration, the poller's readiness walk
// and the timer's expiry — each already hold the scheduler's lock or are one recursive entry away from it, and
// every critical section is a load and a store. A second discipline beside the one the timer store and the run
// queues already keep would be a second set of orderings to get right for no measured gain.

// ⭐ **THE RECORD.** `rg`/`wg` are Go's per-direction state words and `rd`/`wd` their deadlines; each pair is
// laid out so a DIRECTION is an index rather than a branch (`emitPdDirectionAddr`).
let PdSlotBytes = 8 as ParsedInt
let PdOffFd = 0 as ByteOffset
let PdOffRg = 8 as ByteOffset
let PdOffWg = 16 as ByteOffset
let PdOffRd = 24 as ByteOffset
let PdOffWd = 32 as ByteOffset

// ⭐⭐ **DID THE LAST OPERATION ON THIS DESCRIPTOR END IN ITS DEADLINE? — the durable fact behind
// `__ManagedSocket.timedOut()`, and Go's `net.Error.Timeout()` in one word.** It is NOT a direction word's
// `PdExpired`: that belongs to one wait and is settled by the wait it ends, where this one outlives the call so
// the surface above can ask about a failure it has already been handed. An operation clears it before its first
// attempt (`__np_pd_op_begin`), so it answers about THAT operation and never about an older one.
//
// ⛔ **IT IS SET ONLY WHILE THE RECORD IS STILL IN THE LIFE THE OPERATION BEGAN IN** (`__np_pd_mark_timed_out`,
// matching `PdOffGen` against the generation the begin answered). The late exit that stores it runs after a
// park of the thread's own, and by the time the thread resumes the descriptor may have been closed, reused and
// opened onto the same record — whose new owner would then read a deadline it never set.
let PdOffTimedOut = 40 as ByteOffset

// ⭐⭐ **WHICH LIFE OF THIS RECORD A PARKED THREAD BELONGS TO.** A record OUTLIVES the socket it was opened
// for: the release resets its words but the table slot goes on naming it, so `__np_pd_open` on a recycled
// descriptor hands the same record to the next socket. A thread the release READIED is still holding that
// record’s address and its direction word’s, and it settles that word when it resumes — over whatever the next
// owner has published there, which would strand a thread nothing can then wake. So every reset bumps this and
// every act that could touch another life of the record is behind a match against the generation the OPERATION
// began in (`__np_pd_op_begin`): the park's entry (`__np_pd_wait` refuses to mark a record that has moved on
// since the operation began, so a wait never publishes into the next owner's direction word), the resume’s
// settle, the PUBLICATION itself, which happens after the context switch and is the one a `PdWait` mark cannot
// tell apart across lives (`__np_pd_commit`, reading the thread’s copy at `GtRuntime.GtOffParkGen`), and the
// deadline mark (`__np_pd_mark_timed_out`). `__np_pd_expire` and `__np_pd_drop` need no stamp: each already
// asks whether the direction word still names ITS OWN thread, which is the same question asked of the only
// record they can act on.
let PdOffGen = 48 as ByteOffset

// ⭐ **THE FREE-LIST LINK FOR A SOURCE KEY NOBODY HOLDS, AND ONLY THE COMPLETION-PORT LANE EVER WRITES IT.** A
// POSIX lane draws a source key from the kernel's own descriptor table, which recycles it; Windows has no
// descriptor to draw — for a child, and for each overlapped read in flight — so `__np_src_key_alloc` allocates
// one and this word is where a released key waits for the next holder. It holds `key + 1`, so a zero is the end
// of the list rather than key zero.
let PdOffNextFreeKey = 56 as ByteOffset
let PdBytes = 64 as ParsedInt

// The values a direction word holds that are not a green thread. The first three are Go's `pdNil`, `pdReady`
// and `pdWait`: nothing, a readiness nobody has consumed, and a wait that is marked but not published
// (`__np_pd_commit`) — or, on a group member, held for a group wait that has ended (see `PdWoken`). A parked
// thread's record address is a heap pointer, so a word above `PdExpired`, the largest of them, is a published
// waiter (`emitPdIsWaiter`).
let PdNil = 0 as ParsedInt
let PdReady = 1 as ParsedInt
let PdWait = 2 as ParsedInt

// ⛔⛔ **A WAIT HOLDS ITS DIRECTION UNTIL ITS OWN THREAD RESUMES, NOT UNTIL SOMETHING READIES IT.** Whatever ends
// a wait readies the thread and leaves the verdict on the word — `PdWoken` for readiness, `PdExpired` for a
// deadline or a dropped promise — and only the resumed wait settles it (`emitNetpollSettleHold`). Until then
// the thread is still inside its wait, so a second wait on the word is the double wait
// `RuntimeAbort.netpollDoubleWait` refuses, exactly as one arriving while the first was published is. A word
// that read `PdNil` in that window would take the second waiter's publication, and the first thread's resume
// would erase it: a thread nothing can wake, with `__np_waiters` still counting it.
//
// ⭐ **`PdExpired` ABSORBS A LATER READINESS AND `PdWait` DOES NOT.** A deadline or a renounce that ended a wait
// is its answer — a renounced reader must not issue its call again on a descriptor nobody wants — while a
// group member the wait did not fire on is held as `PdWait`, so a readiness landing on it before the group
// resumes becomes `PdWoken` and is reported: the collect drain's child source reports exactly once.
let PdWoken = 3 as ParsedInt
let PdExpired = 4 as ParsedInt

// The two directions, as the index the pairs above are addressed by. EXPORTED because the socket band names
// the direction of every wait it makes.
export let NetpollModeRead = 0 as ParsedInt
export let NetpollModeWrite = 1 as ParsedInt

// What `__np_pd_wait` answers, with `NetpollWaitStale` below. The socket band's retry loops issue the call again
// on `NetpollWaitReady` alone; a child's wait has no retry and asks only whether it was ready, so both ends of
// the pair are exported.
export let NetpollWaitReady = 0 as ParsedInt
export let NetpollWaitTimedOut = 1 as ParsedInt

// ⛔⛔ **THE WAIT ENDED ON A RECORD THAT IS NO LONGER THIS THREAD’S, AND THE CALLER MUST NOT RETRY.** The
// generation test (`PdOffGen`) answers this when a release readied the waiter and the descriptor was then
// CLOSED and REUSED. It cannot be folded into `NetpollWaitReady`: the socket band decodes its descriptor once
// at function entry (`emitLiveSocketOrThrow`), so a retry would issue the syscall on a live descriptor that
// now belongs to ANOTHER socket — stealing its bytes when data is waiting, and parking on its record when not.
// The caller reports its own operation’s failure instead, with no syscall (`emitSocketWaitReady`).
export let NetpollWaitStale = 2 as ParsedInt

// The record table: how many indices the first allocation covers, and one pointer per slot. 64 covers a POSIX
// process's whole ordinary descriptor range; a Windows SOCKET is a handle value rather than a low dense index
// and its record sits at twice it (`emitNetpollDescriptorIndex`), so a program that opens one grows the table.
let PdTableSeedSlots = 64 as ParsedInt
let PdTableSlotBytes = 8 as ParsedInt

// The table's base and how many slots it has. Both move inside ONE hold of `__sched_lock`, which is what
// `MultiMSharing.underSchedLock` states: what is indivisible here is the PAIR, and no atomic can make a pair
// indivisible.
let NetpollPdTableLabel = b"__np_pd_table"
let NetpollPdCapLabel = b"__np_pd_cap"

// ⭐⭐ **HOW MANY GREEN THREADS ARE PUBLISHED ON A DIRECTION WORD RIGHT NOW — Go's `netpollWaiters`, and the
// one thing that makes a socket wait VISIBLE to the scheduler.** Two readers depend on it and both are
// correctness rather than tuning: `emitGtStoresPending` decides whether an idle machine blocks in the poller
// at all — without this, a process whose only pending work is a socket read has no timer and no child, so
// nobody would ever look — and `__sched_checkdead` would call that same process DEADLOCKED, because every
// machine really is idle and the event it waits for is outside this program.
export let NetpollWaitersLabel = b"__np_waiters"

// `__np_pd_slot(fd) -> pd | 0` — the bounds-checked lookup. `__sched_lock` held by the caller.
let NetpollPdSlotName = b"__np_pd_slot"

// `__np_pd_ready_one(pd, mode) -> wakeDebt` — one direction of a readiness event. `__sched_lock` held.
let NetpollPdReadyOneName = b"__np_pd_ready_one"

// `__np_pd_adopt(source)` — give this source a record, growing the table to reach it. The RECORD half of an
// open, without the registration: a child's source is registered by a verb of its own, and a minted
// per-operation source is registered by nothing, the operation's own packet being what reports it.
let NetpollPdAdoptName = b"__np_pd_adopt"

// `__np_pd_open(source, fd)` — give this descriptor a record at `source` and register the descriptor itself
// with the poller. Called once per socket, between `socket()` and `connect()`. The two arguments differ only
// where the record table has a second allocator in it — see `emitNetpollDescriptorIndex`.
export let NetpollPdOpenName = b"__np_pd_open"

// `__np_pd_release(fd)` — reset the record before the descriptor is closed, so the next owner of a recycled
// descriptor starts clean. The kernel takes a closed descriptor out of the poller itself.
export let NetpollPdReleaseName = b"__np_pd_release"

// `__np_pd_wait(fd, mode, gen) -> NetpollWaitReady | NetpollWaitTimedOut | NetpollWaitStale` — suspend the
// running green thread until this descriptor is ready in `mode`, or until that direction's deadline. `gen` is
// the generation the operation began in (`__np_pd_op_begin`); a record that has since moved to another life
// answers `NetpollWaitStale` before anything is marked or published.
let NetpollPdWaitName = b"__np_pd_wait"

// `__np_pd_deadline(fd, mode, ms)` — arm or clear one direction's deadline. `0` clears.
export let NetpollPdDeadlineName = b"__np_pd_deadline"

// `__np_pd_op_begin(fd) -> gen` / `__np_pd_mark_timed_out(fd, gen)` / `__np_pd_timed_out(fd) -> 0 | 1` — the
// deadline mark the socket surface reports through `__ManagedSocket.timedOut()`, and the generation discipline
// it is under (`PdOffTimedOut`). An operation begins by clearing the mark and taking the record's generation;
// the one exit a deadline produces stores the mark only while `PdOffGen` still equals that generation. The
// begin is also where every other surface takes the generation its wait carries. Nothing else reads or writes
// the mark.
let NetpollPdOpBeginName = b"__np_pd_op_begin"
let NetpollPdMarkTimedOutName = b"__np_pd_mark_timed_out"
export let NetpollPdTimedOutName = b"__np_pd_timed_out"

// `__np_pd_wake(fd, readReady, writeReady) -> wakeDebt` — the poller's readiness walk, whose one caller is the
// decode in this file. `__sched_lock` NOT held.
let NetpollPdWakeName = b"__np_pd_wake"

// `__np_pd_commit(gt) -> wakeDebt` — `__gt_register_park`'s netpoll arm: publish the parked thread into the
// direction word the poller will find it through, and arm its deadline. `__sched_lock` held.
export let NetpollPdCommitName = b"__np_pd_commit"

// `__np_pd_expire(gt) -> wakeDebt` — the deadline fired: take the thread off its direction word and mark why.
// `__sched_lock` held.
export let NetpollPdExpireName = b"__np_pd_expire"

// `__np_pd_drop(gt)` — the promise was dropped while its coroutine was parked here: take it off the poller,
// disarm its deadline and mark the wait EXPIRED, so its resumption answers `timedOut` rather than re-issuing a
// syscall on a descriptor nobody wants. The READY is the caller's (`GtRuntime.emitGtRenouncePark`), which is
// the half every park kind shares. `__sched_lock` held.
export let NetpollPdDropName = b"__np_pd_drop"

// ⭐ **IS THIS THREAD'S PARK NOTE A PAIR OR A LIST?** Its ARGUMENT is read as `(fd, mode)` for one source and
// as a group record for several, and the park KIND is the only thing that says which — so every door that
// decodes a note asks this first, and asks it the same way.
function emitNetpollBranchOnGroupPark(module StdModule, block IrBlock, gt ValueId, several IrBlock, one IrBlock, ids ValueMinter)
	let parkKind = emitLoadField(module, block: block, record: gt, offset: GtOffParkKind, ids: ids)
	let isGroup = emitCmp(module, block: block, a: parkKind, b: emitConst(module, block: block, value: GtParkKindNetpollAny, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(block, op: StdOp.condBranch(isGroup, thenBlockId: several.id, elseBlockId: one.id))
end 'emitNetpollBranchOnGroupPark'

// ⭐ **THE DIRECTION A SINGLE-SOURCE PARK NOTE NAMES, DECODED** — its record, which direction, and that
// direction's word.
type NetpollParkedDirection
	export let pd as ValueId
	export let mode as ValueId
	export let gpp as ValueId

	static function create(pd ValueId, mode ValueId, gpp ValueId) returns NetpollParkedDirection
		return Self{pd: pd, mode: mode, gpp: gpp}
	end 'create'
end 'NetpollParkedDirection'

// Decode `gt`'s single-source park note for the commit, the expiry and the drop alike. Terminates `cur`,
// continues at `known`, and the word's address is computed there. A missing record is a stop
// (`emitNetpollPdLookupOrAbort`): a quiet return would leave the thread published on a word nothing will clear.
function emitNetpollParkedDirection(module StdModule, func IrFunction, cur IrBlock, gt ValueId, known IrBlock, ids ValueMinter) returns NetpollParkedDirection
	let arg = emitLoadField(module, block: cur, record: gt, offset: GtOffParkArg, ids: ids)
	let mode = emitNetpollParkMode(module, block: cur, arg: arg, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: cur, fd: emitNetpollParkFd(module, block: cur, arg: arg, ids: ids), known: known, ids: ids)

	return NetpollParkedDirection.create(pd, mode: mode, gpp: emitPdDirectionAddr(module, block: known, pd: pd, base: PdOffRg, mode: mode, ids: ids))
end 'emitNetpollParkedDirection'

// ⭐⭐⭐ **A WAIT THAT ARMED NO DEADLINE MUST NOT PAY FOR A SEARCH THAT CAN ONLY FAIL.** Finding a
// `(gt, tag)` on the timer heap is a LINEAR SCAN (`GtRuntime.emitGtTimerStoreRemove`) held under
// `__sched_lock`, and a pair that is not on the heap scans to the END of it. A child, a pipe end and a socket
// read with no timeout arm NOTHING — and those are the high-frequency sources: one scan per child exit and
// one per `EAGAIN` would make every readiness cost O(live timers), so T sleepers draining M chunks from C
// children would pay O(T·(M+C)).
//
// ⭐⭐ **SO THE CANCEL ASKS EXACTLY WHAT THE ARM ASKED.** `__np_pd_commit`'s publish arm and
// `emitNetpollCommitGroup` both branch on `deadline != 0` before adding an entry, and this branches on the
// same word before looking for one. The word is still the arm's: between the commit and here nothing rewrites
// it but `__np_pd_deadline`, which removes and re-adds under the same rule, and `__np_pd_release`, which
// readies every waiter BEFORE it zeroes.
function emitNetpollDisarmDeadline(module StdModule, func IrFunction, ids ValueMinter, startBlock IrBlock, gt ValueId, deadline ValueId, tag ValueId, cont IrBlock)
	var scan = module.addBlock(func, label: b"npdisarmscan", heat: BlockHeat.normal)

	let armed = emitCmp(module, block: startBlock, a: deadline, b: emitConst(module, block: startBlock, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(startBlock, op: StdOp.condBranch(armed, thenBlockId: scan.id, elseBlockId: cont.id))
	emitGtTimerStoreRemove(module, func: func, ids: ids, startBlock: scan, gt: gt, tag: tag, cont: cont)
end 'emitNetpollDisarmDeadline'

// The deadline this direction's wait armed, or 0 for a wait that armed none.
function emitPdDeadline(module StdModule, block IrBlock, pd ValueId, mode ValueId, ids ValueMinter) returns ValueId
	let addr = emitPdDirectionAddr(module, block: block, pd: pd, base: PdOffRd, mode: mode, ids: ids)
	return emitLoadField(module, block: block, record: addr, offset: 0, ids: ids)
end 'emitPdDeadline'

// `&pd.rg`/`&pd.wg`, or `&pd.rd`/`&pd.wd` — `base` names the pair and `mode` the direction.
function emitPdDirectionAddr(module StdModule, block IrBlock, pd ValueId, base ByteOffset, mode ValueId, ids ValueMinter) returns ValueId
	let scaled = emitBin(module, block: block, a: mode, b: emitConst(module, block: block, value: PdSlotBytes, ids: ids), opcode: StdBinOpcode.mul, ids: ids)
	let offset = emitBin(module, block: block, a: emitConst(module, block: block, value: base as ParsedInt, ids: ids), b: scaled, opcode: StdBinOpcode.add, ids: ids)
	return emitBin(module, block: block, a: pd, b: offset, opcode: StdBinOpcode.add, ids: ids)
end 'emitPdDirectionAddr'

// Is this direction word a published waiter rather than one of the states — see `PdNil`.
function emitPdIsWaiter(module StdModule, block IrBlock, state ValueId, ids ValueMinter) returns ValueId
	return emitCmp(module, block: block, a: state, b: emitConst(module, block: block, value: PdExpired, ids: ids), pred: StdCmpPred.gt, ids: ids)
end 'emitPdIsWaiter'

// ⛔⛔ **DOES THE MARK A PARKED WAIT LEFT STILL STAND? — `__np_pd_commit`'s one test, asked of a single source
// and of each group member.** `PdWait` does not tell two lives of a record apart, so the generation the mark was
// made against (`markedGen`) is half of it. The commit runs after the context switch, and between the mark and
// here the descriptor may have been closed (the release resets the record and bumps its generation) and REUSED,
// with a new owner marking `PdWait` on the very same word. Publishing then would put this thread into the new
// owner's direction word, arm its deadline off a record it does not own, and step `__np_waiters` for a wait
// nothing will end — and the new owner's next operation would meet a waiter and abort `netpollDoubleWait`, on a
// program that did nothing wrong.
function emitPdMarkStands(module StdModule, block IrBlock, gpp ValueId, pd ValueId, markedGen ValueId, ids ValueMinter) returns ValueId
	let state = emitLoadField(module, block: block, record: gpp, offset: 0, ids: ids)
	let stillMarked = emitCmp(module, block: block, a: state, b: emitConst(module, block: block, value: PdWait, ids: ids), pred: StdCmpPred.eq, ids: ids)
	return emitBin(module, block: block, a: stillMarked, b: emitPdSameLife(module, block: block, pd: pd, gen: markedGen, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
end 'emitPdMarkStands'

// Is the record still in the life `gen` names — see `PdOffGen`. `__sched_lock` held.
function emitPdSameLife(module StdModule, block IrBlock, pd ValueId, gen ValueId, ids ValueMinter) returns ValueId
	return emitCmp(module, block: block, a: emitLoadField(module, block: block, record: pd, offset: PdOffGen, ids: ids), b: gen, pred: StdCmpPred.eq, ids: ids)
end 'emitPdSameLife'

// Take this direction's published waiter off its word and leave it `PdExpired` — the half `__np_pd_expire` and
// `__np_pd_drop` are the same, and a second spelling of it is a word one of them would eventually stop
// writing. `__sched_lock` held; READYING the thread is the caller's, because the two answer that differently.
function emitNetpollUnhookExpired(module StdModule, block IrBlock, gpp ValueId, ids ValueMinter)
	emitStoreField(module, block: block, record: gpp, offset: 0, value: emitConst(module, block: block, value: PdExpired, ids: ids))
	emitNetpollStepWaiters(module, block: block, delta: -1, ids: ids)
end 'emitNetpollUnhookExpired'

// ⭐⭐ **A RESUMED WAIT SETTLES THE WORD IT STILL HOLDS — see `PdWoken`.** In the life of the record the wait
// marked, the word can only hold one of the two verdicts its endings leave: `PdWoken`, which continues at
// `woken`, or `ended` — `PdExpired` for one source and `PdWait` for a group member that did not fire — which
// continues at `unwoken`. Either way the word goes back to `PdNil`. `__sched_lock` held.
//
// ⛔⛔ **ANY OTHER VALUE IS A RUNTIME BUG, AND CLEARING IT WOULD HIDE ONE.** A word still naming this thread
// is a published waiter some road readied without taking it off — clearing it would drop the thread without
// the `__np_waiters` debit its publication took. Anything else is another party writing a word only this
// thread may settle, and whatever it stood for would be lost with it.
function emitNetpollSettleHold(module StdModule, func IrFunction, cur IrBlock, gpp ValueId, ended ParsedInt, woken IrBlock, unwoken IrBlock, ids ValueMinter)
	var notWoken = module.addBlock(func, label: b"npholdnotwoken", heat: BlockHeat.normal)
	var notEnded = module.addBlock(func, label: b"npholdnotended", heat: BlockHeat.normal)
	var stillPublished = module.addBlock(func, label: b"npholdpublished", heat: BlockHeat.normal)
	var lost = module.addBlock(func, label: b"npholdlost", heat: BlockHeat.normal)

	let held = emitLoadField(module, block: cur, record: gpp, offset: 0, ids: ids)
	emitStoreField(module, block: cur, record: gpp, offset: 0, value: emitConst(module, block: cur, value: PdNil, ids: ids))
	let wasWoken = emitCmp(module, block: cur, a: held, b: emitConst(module, block: cur, value: PdWoken, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(wasWoken, thenBlockId: woken.id, elseBlockId: notWoken.id))

	let wasEnded = emitCmp(module, block: notWoken, a: held, b: emitConst(module, block: notWoken, value: ended, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(notWoken, op: StdOp.condBranch(wasEnded, thenBlockId: unwoken.id, elseBlockId: notEnded.id))

	let isSelf = emitCmp(module, block: notEnded, a: held, b: emitLoadCurrentGt(module, block: notEnded, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(notEnded, op: StdOp.condBranch(isSelf, thenBlockId: stillPublished.id, elseBlockId: lost.id))
	emitRuntimeAbort(module, func: func, block: stillPublished, abort: RuntimeAbort.netpollUnhookMissed, ids: ids)
	emitRuntimeAbort(module, func: func, block: lost, abort: RuntimeAbort.netpollHoldLost, ids: ids)
end 'emitNetpollSettleHold'

function emitNetpollStepWaiters(module StdModule, block IrBlock, delta ParsedInt, ids ValueMinter)
	let waiters = emitLoadAcquireGlobalWord(module, block: block, label: NetpollWaitersLabel, ids: ids)
	emitStoreReleaseGlobalWord(module, block: block, label: NetpollWaitersLabel, value: emitBin(module, block: block, a: waiters, b: emitConst(module, block: block, value: delta, ids: ids), opcode: StdBinOpcode.add, ids: ids), ids: ids)
end 'emitNetpollStepWaiters'

// The `(fd, mode)` pair a netpoll park carries in `GtOffParkArg`. A descriptor is non-negative, so the low bit
// is free for the direction and the pair fits one word — which is what lets the three parties that read a
// parked thread's note (the commit, the expiry and the drop) find its record without a second field.
function emitNetpollParkArg(module StdModule, block IrBlock, fd ValueId, mode ValueId, ids ValueMinter) returns ValueId
	let shifted = emitBin(module, block: block, a: fd, b: emitConst(module, block: block, value: 1, ids: ids), opcode: StdBinOpcode.shl, ids: ids)
	return emitBin(module, block: block, a: shifted, b: mode, opcode: StdBinOpcode.bitOr, ids: ids)
end 'emitNetpollParkArg'

// The descriptor and the direction a park note names — a single source's (`emitNetpollParkedDirection`) or one
// group member's (`emitNetpollGroupWalk`).
function emitNetpollParkFd(module StdModule, block IrBlock, arg ValueId, ids ValueMinter) returns ValueId
	return emitBin(module, block: block, a: arg, b: emitConst(module, block: block, value: 1, ids: ids), opcode: StdBinOpcode.shrLogical, ids: ids)
end 'emitNetpollParkFd'

function emitNetpollParkMode(module StdModule, block IrBlock, arg ValueId, ids ValueMinter) returns ValueId
	return emitBin(module, block: block, a: arg, b: emitConst(module, block: block, value: 1, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
end 'emitNetpollParkMode'

// `&table[fd]`. The caller has established that `fd` is inside the table.
function emitNetpollPdSlotAddr(module StdModule, block IrBlock, fd ValueId, ids ValueMinter) returns ValueId
	let table = emitLoadGlobalWord(module, block: block, label: NetpollPdTableLabel, ids: ids)
	let offset = emitBin(module, block: block, a: fd, b: emitConst(module, block: block, value: PdTableSlotBytes, ids: ids), opcode: StdBinOpcode.mul, ids: ids)
	return emitBin(module, block: block, a: table, b: offset, opcode: StdBinOpcode.add, ids: ids)
end 'emitNetpollPdSlotAddr'

// Call `__np_pd_slot(fd)` in `block` and answer the record.
function emitNetpollPdLookup(module StdModule, block IrBlock, fd ValueId, ids ValueMinter) returns ValueId
	let pd = ids.mint()
	module.appendOp(block, op: StdOp.call(pd, callee: NetpollPdSlotName, args: argsOf(fd)))
	return pd
end 'emitNetpollPdLookup'

// Look `fd`'s record up in `cur` and continue at `known` holding it; a descriptor with no record is the stop
// `RuntimeAbort.netpollUnknownSource`. Every caller holds a source some open gave a record and the table only
// ever GROWS (`__np_pd_adopt` doubles it), so a missing record is a runtime bug and a quiet answer would hide
// it: a park nothing can end, a thread left published on a word nothing will clear, a free list read out of a
// record that does not exist.
function emitNetpollPdLookupOrAbort(module StdModule, func IrFunction, cur IrBlock, fd ValueId, known IrBlock, ids ValueMinter) returns ValueId
	var noRecord = module.addBlock(func, label: b"npnopd", heat: BlockHeat.normal)

	let pd = emitNetpollPdLookup(module, block: cur, fd: fd, ids: ids)
	let haveRecord = emitCmp(module, block: cur, a: pd, b: emitConst(module, block: cur, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(haveRecord, thenBlockId: known.id, elseBlockId: noRecord.id))
	emitRuntimeAbort(module, func: func, block: noRecord, abort: RuntimeAbort.netpollUnknownSource, ids: ids)

	return pd
end 'emitNetpollPdLookupOrAbort'

// The socket band's and every other waiting surface's door to `__np_pd_op_begin`: an operation begins on
// `source`'s record here and carries the answered generation to its wait and, for a socket, to its late exit.
export function emitNetpollPdOpBegin(module StdModule, block IrBlock, source ValueId, ids ValueMinter) returns ValueId
	let gen = ids.mint()
	module.appendOp(block, op: StdOp.call(gen, callee: NetpollPdOpBeginName, args: argsOf(source)))
	return gen
end 'emitNetpollPdOpBegin'

export function emitNetpollPdMarkTimedOut(module StdModule, block IrBlock, source ValueId, gen ValueId, ids ValueMinter)
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollPdMarkTimedOutName, args: twoArgs(source, second: gen)))
end 'emitNetpollPdMarkTimedOut'

// Call `__np_pd_wait(source, mode, gen)` in `block` and answer its verdict.
export function emitNetpollPdWait(module StdModule, block IrBlock, source ValueId, mode ParsedInt, gen ValueId, ids ValueMinter) returns ValueId
	let verdict = ids.mint()
	module.appendOp(block, op: StdOp.call(verdict, callee: NetpollPdWaitName, args: threeArgs(source, second: emitConst(module, block: block, value: mode, ids: ids), third: gen)))
	return verdict
end 'emitNetpollPdWait'

// `__np_pd_slot(fd)` — see `NetpollPdSlotName`.
function buildNetpollPdSlot(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdSlotName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var inside = module.addBlock(func, label: b"npslotin", heat: BlockHeat.normal)
	var missing = module.addBlock(func, label: b"npslotnone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let cap = emitLoadGlobalWord(module, block: entry, label: NetpollPdCapLabel, ids: ids)
	let negative = emitCmp(module, block: entry, a: fd, b: zero, pred: StdCmpPred.lt, ids: ids)
	let past = emitCmp(module, block: entry, a: fd, b: cap, pred: StdCmpPred.ge, ids: ids)
	let outside = emitBin(module, block: entry, a: negative, b: past, opcode: StdBinOpcode.bitOr, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(outside, thenBlockId: missing.id, elseBlockId: inside.id))

	emitConstReturn(module, block: missing, value: 0, ids: ids)
	module.setTerminator(inside, op: StdOp.ret(emitLoadField(module, block: inside, record: emitNetpollPdSlotAddr(module, block: inside, fd: fd, ids: ids), offset: 0, ids: ids)))

	module.functions.push(func)
end 'buildNetpollPdSlot'

// `__np_pd_adopt(source)` — see `NetpollPdAdoptName`.
function buildNetpollPdAdopt(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdAdoptName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var notASource = module.addBlock(func, label: b"npadoptbad", heat: BlockHeat.normal)
	var indexed = module.addBlock(func, label: b"npadoptok", heat: BlockHeat.normal)
	var growPick = module.addBlock(func, label: b"npgrowpick", heat: BlockHeat.normal)
	var growSeed = module.addBlock(func, label: b"npgrowseed", heat: BlockHeat.normal)
	var growHdr = module.addBlock(func, label: b"npgrowhdr", heat: BlockHeat.normal)
	var growNext = module.addBlock(func, label: b"npgrownext", heat: BlockHeat.normal)
	var growDo = module.addBlock(func, label: b"npgrowdo", heat: BlockHeat.normal)
	var freeCheck = module.addBlock(func, label: b"npgrowfree", heat: BlockHeat.normal)
	var freeOld = module.addBlock(func, label: b"npgrowfreeold", heat: BlockHeat.normal)
	var haveSlot = module.addBlock(func, label: b"npslot", heat: BlockHeat.normal)
	var carve = module.addBlock(func, label: b"npcarve", heat: BlockHeat.normal)
	var reset = module.addBlock(func, label: b"npreset", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npopendone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	// ⛔⛔ **THE TABLE'S ONE WRITER BOUNDS ITS INDEX AT BOTH ENDS, WHERE THE GROW ONLY EVER BOUNDS THE TOP.**
	// `table + 8 * fd` is signed, so a value that is not a source addresses the words BEFORE the table and the
	// reset below hands one of them to `emitNetpollPdClear` as a record. `__np_pd_slot` already refuses a
	// negative on the reading side.
	let negative = emitCmp(module, block: entry, a: fd, b: emitConst(module, block: entry, value: 0, ids: ids), pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(negative, thenBlockId: notASource.id, elseBlockId: indexed.id))
	emitRuntimeAbort(module, func: func, block: notASource, abort: RuntimeAbort.netpollAdoptIndexIsNotASource, ids: ids)

	emitSchedLockEnter(module, block: indexed, ids: ids)
	let capBefore = emitLoadGlobalWord(module, block: indexed, label: NetpollPdCapLabel, ids: ids)
	let tooSmall = emitCmp(module, block: indexed, a: fd, b: capBefore, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(indexed, op: StdOp.condBranch(tooSmall, thenBlockId: growPick.id, elseBlockId: haveSlot.id))

	// Where the doubling starts: the seed for a table that does not exist yet, the current capacity otherwise.
	let unborn = emitCmp(module, block: growPick, a: capBefore, b: emitConst(module, block: growPick, value: 0, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(growPick, op: StdOp.condBranch(unborn, thenBlockId: growSeed.id, elseBlockId: growHdr.id))
	growPick.branchEdges.push(BranchEdge.create(growHdr.id, argIds: argsOf(capBefore)))
	module.setTerminator(growSeed, op: StdOp.branch(growHdr.id))
	growSeed.branchEdges.push(BranchEdge.create(growHdr.id, argIds: argsOf(emitConst(module, block: growSeed, value: PdTableSeedSlots, ids: ids))))

	// growHdr(c): double until the index fits. The walk is amortized against every adoption already inside the
	// capacity, and the table is indexed and never walked — so a sparse index space costs slots and no time. What
	// it costs in MEMORY is the whole span: one Windows handle drives a table of
	// `2^ceil(log2(2*handle)) * PdTableSlotBytes` bytes, of which everything below the live descriptors is
	// untouched.
	let candidate = ids.mint()
	growHdr.blockArgs.push(IrBlockArg.create(candidate, argType: StdType.i64))
	let fits = emitCmp(module, block: growHdr, a: candidate, b: fd, pred: StdCmpPred.gt, ids: ids)
	module.setTerminator(growHdr, op: StdOp.condBranch(fits, thenBlockId: growDo.id, elseBlockId: growNext.id))

	let doubled = emitBin(module, block: growNext, a: candidate, b: emitConst(module, block: growNext, value: 2, ids: ids), opcode: StdBinOpcode.mul, ids: ids)
	module.setTerminator(growNext, op: StdOp.branch(growHdr.id))
	growNext.branchEdges.push(BranchEdge.create(growHdr.id, argIds: argsOf(doubled)))

	let slotBytes = emitConst(module, block: growDo, value: PdTableSlotBytes, ids: ids)
	let newBytes = emitBin(module, block: growDo, a: candidate, b: slotBytes, opcode: StdBinOpcode.mul, ids: ids)
	let newBase = ids.mint()
	module.appendOp(growDo, op: StdOp.call(newBase, callee: SlabAllocName, args: argsOf(newBytes)))
	let oldBase = emitLoadGlobalWord(module, block: growDo, label: NetpollPdTableLabel, ids: ids)
	let liveBytes = emitBin(module, block: growDo, a: capBefore, b: slotBytes, opcode: StdBinOpcode.mul, ids: ids)
	var copied = emitForwardCopy(module, func: func, cur: growDo, dest: newBase, src: oldBase, byteCount: liveBytes, ids: ids)
	emitStoreGlobalWord(module, block: copied, label: NetpollPdTableLabel, value: newBase, ids: ids)
	emitStoreGlobalWord(module, block: copied, label: NetpollPdCapLabel, value: candidate, ids: ids)
	module.setTerminator(copied, op: StdOp.branch(freeCheck.id))

	// The FIRST grow has no region to hand back: the table is born here rather than in `__gt_init`, because a
	// program that opens no socket must not pay for one.
	let hadRegion = emitCmp(module, block: freeCheck, a: oldBase, b: emitConst(module, block: freeCheck, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(freeCheck, op: StdOp.condBranch(hadRegion, thenBlockId: freeOld.id, elseBlockId: haveSlot.id))
	emitSlabFree(module, block: freeOld, ptr: oldBase, ids: ids)
	module.setTerminator(freeOld, op: StdOp.branch(haveSlot.id))

	let slotAddr = emitNetpollPdSlotAddr(module, block: haveSlot, fd: fd, ids: ids)
	let existing = emitLoadField(module, block: haveSlot, record: slotAddr, offset: 0, ids: ids)
	let isNew = emitCmp(module, block: haveSlot, a: existing, b: emitConst(module, block: haveSlot, value: 0, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(haveSlot, op: StdOp.condBranch(isNew, thenBlockId: carve.id, elseBlockId: reset.id))
	haveSlot.branchEdges.push(BranchEdge.create(reset.id, argIds: argsOf(existing)))

	let carved = ids.mint()
	module.appendOp(carve, op: StdOp.call(carved, callee: SlabAllocName, args: argsOf(emitConst(module, block: carve, value: PdBytes, ids: ids))))
	emitStoreField(module, block: carve, record: slotAddr, offset: 0, value: carved)
	module.setTerminator(carve, op: StdOp.branch(reset.id))
	carve.branchEdges.push(BranchEdge.create(reset.id, argIds: argsOf(carved)))

	// A recycled descriptor inherits its predecessor's record, so every word is written rather than assumed.
	var payWake = module.addBlock(func, label: b"npopenwake", heat: BlockHeat.normal)
	let pd = ids.mint()
	reset.blockArgs.push(IrBlockArg.create(pd, argType: StdType.i64))
	let debt = emitNetpollPdClear(module, block: reset, pd: pd, ids: ids)
	emitStoreField(module, block: reset, record: pd, offset: PdOffFd, value: fd)
	emitSchedLockLeave(module, block: reset, ids: ids)
	emitSchedWakeIfOwed(module, cur: reset, owed: debt, wake: payWake, cont: doneBlock, ids: ids)

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPdAdopt'

// `__np_pd_open(fd)` — see `NetpollPdOpenName`.
//
// ⚠ **THE REGISTRATION IS OUTSIDE THE LOCK, AND IT FOLLOWS THE ADOPTION RATHER THAN PRECEDING IT.**
// `epoll_ctl`/`kevent` is a kernel call, and the record must be complete before it runs: a readiness event
// reaching `__np_pd_wake` for a source with no record is DROPPED, and for a source nothing can re-arm that
// would be a wait nothing ends.
function buildNetpollPdOpen(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollPdOpenName, returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npopendone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let source = 0 as ValueId
	let fd = 1 as ValueId

	module.appendOp(entry, op: StdOp.call(ids.mint(), callee: NetpollPdAdoptName, args: argsOf(source)))
	let poller = emitLoadGlobalWord(module, block: entry, label: NetpollPollerLabel, ids: ids)
	let armed = emitNetpoll(module, block: entry, verb: NetpollVerb.armSource, operands: twoArgs(poller, second: fd), ids: ids)
	emitNetpollRequire(module, func: func, cur: entry, shape: netpollShape(target), verb: NetpollVerb.armSource, subject: fd, answer: armed, cont: doneBlock, ids: ids)

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPdOpen'

// Both direction words, both deadlines and the timed-out mark back to their born state, and the record's next
// life opened. `fd` is NOT cleared: a record's descriptor is what it is for, and the release keeps it for a
// reader that wants to know whose record this was.
//
// ⛔⛔ **A PUBLISHED WAITER IS READIED, NEVER ZEROED, BECAUSE ZEROING IT WOULD BE A HANG.** A direction word
// holding a green thread is the ONLY pointer anything has to it: dropping it strands the thread AND skips the
// `__np_waiters` decrement its three balanced exits make — and that count feeds `emitGtStoresPending`, which
// gates both the poller's owed test and the exit drain's quiet term, while `__sched_checkdead` is prevented
// from calling a pending process deadlocked. So the failure would be a silent hang with the deadlock detector
// disarmed, which is the worst shape this runtime has.
//
// ⭐⭐ **AND THE STATE IS ORDINARY, SO THE ANSWER IS A WAKE AND NOT A STOP.** An `async` argument CO-OWNS the
// box it is handed (`Parser.coOwnConcreteRecordForSink` takes a reference, never a copy of the descriptor), and
// a coroutine that is PARKED while its owner RUNS is exactly the pair that holds one socket at once — so
// `client.close()` under a parked `recv` reaches here, on a program that did nothing wrong;
// `specs/netpoll-socket.md`'s `a-parked-reader-survives-its-owner-closing-the-socket` is that program.
// ⚠ **THE READIES NEED NO ACCOUNT OF WHICH ROUTES PUT A WAITER THERE**, and this arm deliberately offers
// none: it answers whatever it finds on the two direction words, so an enumeration of the roads to a second
// holder would be an unproven claim standing where the code needs no claim at all.
//
// ⚠ **THE READIED THREAD ISSUES NO FURTHER SYSCALL, BECAUSE WHAT IT READS IS THE GENERATION BUMP BELOW.** Its
// resumed `__np_pd_wait` finds a record that has moved on and answers `NetpollWaitStale`, which the operation
// reports as its own failure (`recvFailed`) without touching the descriptor — the number in its hand may name
// another socket by then. Zeroing the direction words therefore also discards a `PdExpired` no resume has read,
// so a wait whose deadline passed and whose socket was then closed reports the close; reporting a timeout
// would name the wrong cause for the same stop.
//
// The wake debt is the CALLER's to pay after its own lock release — `__gt_ready_locked`'s contract.
function emitNetpollPdClear(module StdModule, block IrBlock, pd ValueId, ids ValueMinter) returns ValueId
	let readDebt = ids.mint()
	module.appendOp(block, op: StdOp.call(readDebt, callee: NetpollPdReadyOneName, args: twoArgs(pd, second: emitConst(module, block: block, value: NetpollModeRead, ids: ids))))
	let writeDebt = ids.mint()
	module.appendOp(block, op: StdOp.call(writeDebt, callee: NetpollPdReadyOneName, args: twoArgs(pd, second: emitConst(module, block: block, value: NetpollModeWrite, ids: ids))))

	// After the readies, which leave `PdReady` on a direction nobody waited on — a record starting its next life
	// holding a readiness its new owner never earned would answer that owner's first wait at once.
	let zeroWord = emitConst(module, block: block, value: 0, ids: ids)
	emitStoreField(module, block: block, record: pd, offset: PdOffRg, value: zeroWord)
	emitStoreField(module, block: block, record: pd, offset: PdOffWg, value: zeroWord)
	emitStoreField(module, block: block, record: pd, offset: PdOffRd, value: zeroWord)
	emitStoreField(module, block: block, record: pd, offset: PdOffWd, value: zeroWord)
	emitStoreField(module, block: block, record: pd, offset: PdOffTimedOut, value: zeroWord)

	// The record's next life starts here, so a thread that parked on its previous one stops owning these words
	// — see `PdOffGen`. It is BUMPED and not zeroed because a snapshot can only tell one life from the next by
	// a value that DIFFERS between them, which a constant never would. A carve reaches here on `__slab_alloc`'s
	// zeroed bytes, which is also what lets the readies above read `PdNil` from a record nothing has written.
	let born = emitLoadField(module, block: block, record: pd, offset: PdOffGen, ids: ids)
	emitStoreField(module, block: block, record: pd, offset: PdOffGen, value: emitBin(module, block: block, a: born, b: emitConst(module, block: block, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids))

	return emitBin(module, block: block, a: readDebt, b: writeDebt, opcode: StdBinOpcode.bitOr, ids: ids)
end 'emitNetpollPdClear'

// `__np_pd_release(fd)` — see `NetpollPdReleaseName`. It pays its own wake debt because it owns its own lock
// scope, where `__np_pd_wake` hands one back to a caller that is still inside the poller's.
function buildNetpollPdRelease(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdReleaseName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var clear = module.addBlock(func, label: b"npclear", heat: BlockHeat.normal)
	var unlock = module.addBlock(func, label: b"nprelunlock", heat: BlockHeat.normal)
	var payWake = module.addBlock(func, label: b"nprelwake", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npreldone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookup(module, block: entry, fd: fd, ids: ids)
	let known = emitCmp(module, block: entry, a: pd, b: emitConst(module, block: entry, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(known, thenBlockId: clear.id, elseBlockId: unlock.id))
	entry.branchEdges.push(BranchEdge.create(unlock.id, argIds: argsOf(emitConst(module, block: entry, value: WakeDebtNone, ids: ids))))

	let debt = emitNetpollPdClear(module, block: clear, pd: pd, ids: ids)
	module.setTerminator(clear, op: StdOp.branch(unlock.id))
	clear.branchEdges.push(BranchEdge.create(unlock.id, argIds: argsOf(debt)))

	let owed = ids.mint()
	unlock.blockArgs.push(IrBlockArg.create(owed, argType: StdType.i64))
	emitSchedLockLeave(module, block: unlock, ids: ids)
	emitSchedWakeIfOwed(module, cur: unlock, owed: owed, wake: payWake, cont: doneBlock, ids: ids)

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPdRelease'

// ⭐⭐ **`__np_pd_deadline(fd, mode, ms)` — see `NetpollPdDeadlineName`.** The deadline is ABSOLUTE from the
// moment it is set, which is Go's semantics: it bounds the WAIT rather than each attempt inside it.
//
// ⭐ **A WAIT ALREADY IN FLIGHT IS RE-ARMED, NOT LEFT ON ITS OLD DEADLINE.** The timer entry was stamped with
// the absolute deadline that was current at `__np_pd_commit`; writing `pd.rd` alone would leave the store
// holding the old one, so the new deadline would take effect only at the NEXT park — a wrong answer, and one
// the word would not show. So a published waiter's entry is removed and re-added under the same lock, and the
// poller is told, because the new deadline may be earlier than every other pending.
//
// ⚠ **ONLY A PUBLISHED WAITER IS RE-ARMED, SO A WAIT ITS DEADLINE HAS ALREADY ENDED KEEPS ITS VERDICT.** Its
// word holds `PdExpired` until the thread resumes and answers it; a deadline set in that window cannot turn one
// that was missed into one that was met.
//
// ⚠ **THE RE-ARM NEEDS A SECOND GREEN THREAD HOLDING THE SAME SOCKET, AND A PROGRAM CAN BUILD ONE**: an
// `async` argument co-owns the box it is handed, so a deadline set by the owner can land on a wait a parked
// coroutine already published (`emitNetpollPdClear`).
function buildNetpollPdDeadline(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdDeadlineName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npdlknown", heat: BlockHeat.normal)
	var arm = module.addBlock(func, label: b"npdlarm", heat: BlockHeat.normal)
	var store = module.addBlock(func, label: b"npdlstore", heat: BlockHeat.normal)
	var rearm = module.addBlock(func, label: b"npdlrearm", heat: BlockHeat.normal)
	var groupMember = module.addBlock(func, label: b"npdlgroup", heat: BlockHeat.normal)
	var rearmOne = module.addBlock(func, label: b"npdlrearmone", heat: BlockHeat.normal)
	var disarmed = module.addBlock(func, label: b"npdldisarmed", heat: BlockHeat.normal)
	var rearmed = module.addBlock(func, label: b"npdlrearmed", heat: BlockHeat.normal)
	var stillArmed = module.addBlock(func, label: b"npdlstillarmed", heat: BlockHeat.normal)
	var tellPoller = module.addBlock(func, label: b"npdltell", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npdldone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let fd = 0 as ValueId
	let mode = 1 as ValueId
	let ms = 2 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookup(module, block: entry, fd: fd, ids: ids)
	let haveRecord = emitCmp(module, block: entry, a: pd, b: emitConst(module, block: entry, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(haveRecord, thenBlockId: known.id, elseBlockId: doneBlock.id))

	let previous = emitPdDeadline(module, block: known, pd: pd, mode: mode, ids: ids)
	let cleared = emitConst(module, block: known, value: 0, ids: ids)
	let clears = emitCmp(module, block: known, a: ms, b: cleared, pred: StdCmpPred.le, ids: ids)
	module.setTerminator(known, op: StdOp.condBranch(clears, thenBlockId: store.id, elseBlockId: arm.id))
	known.branchEdges.push(BranchEdge.create(store.id, argIds: argsOf(cleared)))

	let now = emitGtNowNs(module, block: arm, ids: ids)
	let delta = emitBin(module, block: arm, a: ms, b: emitConst(module, block: arm, value: NanosPerMilli, ids: ids), opcode: StdBinOpcode.mul, ids: ids)
	let deadline = emitBin(module, block: arm, a: now, b: delta, opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(arm, op: StdOp.branch(store.id))
	arm.branchEdges.push(BranchEdge.create(store.id, argIds: argsOf(deadline)))

	let value = ids.mint()
	store.blockArgs.push(IrBlockArg.create(value, argType: StdType.i64))
	emitStoreField(module, block: store, record: emitPdDirectionAddr(module, block: store, pd: pd, base: PdOffRd, mode: mode, ids: ids), offset: 0, value: value)
	let gpp = emitPdDirectionAddr(module, block: store, pd: pd, base: PdOffRg, mode: mode, ids: ids)
	let waiter = emitLoadField(module, block: store, record: gpp, offset: 0, ids: ids)
	module.setTerminator(store, op: StdOp.condBranch(emitPdIsWaiter(module, block: store, state: waiter, ids: ids), thenBlockId: rearm.id, elseBlockId: doneBlock.id))

	// ⛔⛔ **A MULTI-SOURCE WAIT OWNS ITS DEADLINE AND A MEMBER MAY NOT BE GIVEN ONE.** The group's deadline
	// is the group's own word under the group's tag, and `__gt_timer_check` admits exactly one entry per
	// `(thread, tag)`; a member's `pd.rd` is 0, so the disarm below would find nothing and this would add a
	// SECOND entry under a pair that already has one. Nothing calls it this way today — `ManagedSocketRuntime`
	// is the only caller — and a loud refusal is what keeps a future one from corrupting the heap quietly.
	let waiterKind = emitLoadField(module, block: rearm, record: waiter, offset: GtOffParkKind, ids: ids)
	let onAGroup = emitCmp(module, block: rearm, a: waiterKind, b: emitConst(module, block: rearm, value: GtParkKindNetpollAny, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(rearm, op: StdOp.condBranch(onAGroup, thenBlockId: groupMember.id, elseBlockId: rearmOne.id))
	emitRuntimeAbort(module, func: func, block: groupMember, abort: RuntimeAbort.netpollGroupMemberDeadline, ids: ids)

	// The old entry goes whatever the new deadline is — and only if the OLD deadline put one there, which is
	// why it is read before the store overwrites it. A new entry is added only when there IS a new one.
	let tag = emitTimerTagOfNetpollMode(module, block: rearmOne, mode: mode, ids: ids)
	emitNetpollDisarmDeadline(module, func: func, ids: ids, startBlock: rearmOne, gt: waiter, deadline: previous, tag: tag, cont: disarmed)
	let clearing = emitCmp(module, block: disarmed, a: value, b: emitConst(module, block: disarmed, value: 0, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(disarmed, op: StdOp.condBranch(clearing, thenBlockId: doneBlock.id, elseBlockId: rearmed.id))

	module.appendOp(rearmed, op: StdOp.call(ids.mint(), callee: GtTimerAddName, args: threeArgs(waiter, second: value, third: tag)))
	module.setTerminator(rearmed, op: StdOp.branch(stillArmed.id))

	// The poller waits for the earliest deadline there was when it claimed the role, so a new one that beats it
	// owes it a look — `__gt_register_park`'s netpoll arm owes the same one, for the same reason.
	emitSchedLockLeave(module, block: stillArmed, ids: ids)
	module.appendOp(stillArmed, op: StdOp.call(ids.mint(), callee: SchedWakeNetpollerName, args: argsOf(value)))
	module.setTerminator(stillArmed, op: StdOp.branch(tellPoller.id))
	module.setTerminator(tellPoller, op: StdOp.retVoid)

	emitSchedLockLeave(module, block: doneBlock, ids: ids)
	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPdDeadline'

// Leave `__sched_lock` and answer `verdict` — every exit `__np_pd_wait` takes while holding the lock.
function emitNetpollWaitAnswer(module StdModule, block IrBlock, verdict ParsedInt, ids ValueMinter)
	emitSchedLockLeave(module, block: block, ids: ids)
	emitConstReturn(module, block: block, value: verdict, ids: ids)
end 'emitNetpollWaitAnswer'

// ⛔ **WHETHER A WAIT MAY BEGIN ON THIS DIRECTION WORD — ONE RULE FOR THE SINGLE WAIT AND THE GROUP.** A
// `PdReady` is readiness that arrived before the wait did, CONSUMED into `ready` because the poller is
// edge-triggered: left set, it would answer a later wait the descriptor never became ready for. A `PdNil`
// continues at `free`. Every other value is a wait in progress — marked, published, or ended and not yet
// resumed (`PdWoken`, `PdExpired`) — and a second mark would take its word from it and lose one of the two
// threads, so it is a named stop rather than a silently lost thread. Terminates `cur`, leaving `ready` for the
// caller to answer from. `__sched_lock` held.
function emitNetpollBranchOnWaitStart(module StdModule, func IrFunction, cur IrBlock, gpp ValueId, ready IrBlock, free IrBlock, ids ValueMinter)
	var notReady = module.addBlock(func, label: b"npwsnotready", heat: BlockHeat.normal)
	var doubleWait = module.addBlock(func, label: b"npwsdouble", heat: BlockHeat.normal)

	let state = emitLoadField(module, block: cur, record: gpp, offset: 0, ids: ids)
	let isReady = emitCmp(module, block: cur, a: state, b: emitConst(module, block: cur, value: PdReady, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(isReady, thenBlockId: ready.id, elseBlockId: notReady.id))
	emitStoreField(module, block: ready, record: gpp, offset: 0, value: emitConst(module, block: ready, value: PdNil, ids: ids))

	let isFree = emitCmp(module, block: notReady, a: state, b: emitConst(module, block: notReady, value: PdNil, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(notReady, op: StdOp.condBranch(isFree, thenBlockId: free.id, elseBlockId: doubleWait.id))
	emitRuntimeAbort(module, func: func, block: doubleWait, abort: RuntimeAbort.netpollDoubleWait, ids: ids)
end 'emitNetpollBranchOnWaitStart'

// ⭐⭐⭐ **`__np_pd_wait(fd, mode, gen)` — THE SUSPENSION ITSELF.**
//
// ⛔⛔ **THE MARK AND THE PUBLICATION ARE TWO SEPARATE HOLDS, WITH THE CONTEXT SWITCH BETWEEN THEM** —
// `GtOffParkKind`'s standing invariant: a thread discoverable on the store that will wake it before
// `__gt_context_switch` has saved its registers can be resumed onto a stale SP by a second machine. So this
// marks the direction `PdWait`, releases, and parks; `__np_pd_commit` publishes the thread on the far side of
// the switch. A readiness event landing in the window finds `PdWait`, writes `PdWoken`, and the commit then
// declines to park at all.
//
// ⛔⛔ **A RECORD THAT HAS MOVED ON SINCE THE OPERATION BEGAN IS REFUSED BEFORE THE MARK.** The caller took
// `gen` at `__np_pd_op_begin` and has since issued its syscall on a descriptor number decoded once; a release
// between the two — another thread closing the socket — leaves that number naming the next owner's life of the
// same record, and a wait marked on it would be published into the next owner's direction word: the owner's
// readiness would wake this thread, and the owner's own wait would meet a waiter and abort
// `netpollDoubleWait` on a program that did nothing wrong.
function buildNetpollPdWait(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdWaitName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var look = module.addBlock(func, label: b"npwlook", heat: BlockHeat.normal)
	var begin = module.addBlock(func, label: b"npwbegin", heat: BlockHeat.normal)
	var takeReady = module.addBlock(func, label: b"npwready", heat: BlockHeat.normal)
	var checkDeadline = module.addBlock(func, label: b"npwdl", heat: BlockHeat.normal)
	var askClock = module.addBlock(func, label: b"npwclock", heat: BlockHeat.normal)
	var park = module.addBlock(func, label: b"npwpark", heat: BlockHeat.normal)
	var resumed = module.addBlock(func, label: b"npwresumed", heat: BlockHeat.normal)
	var stillOurs = module.addBlock(func, label: b"npwours", heat: BlockHeat.normal)
	var recycled = module.addBlock(func, label: b"npwrecycled", heat: BlockHeat.normal)
	var lateExit = module.addBlock(func, label: b"npwtimedout", heat: BlockHeat.normal)
	var readyExit = module.addBlock(func, label: b"npwok", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let fd = 0 as ValueId
	let mode = 1 as ValueId
	let gen = 2 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: entry, fd: fd, known: look, ids: ids)

	module.setTerminator(look, op: StdOp.condBranch(emitPdSameLife(module, block: look, pd: pd, gen: gen, ids: ids), thenBlockId: begin.id, elseBlockId: recycled.id))

	let gpp = emitPdDirectionAddr(module, block: begin, pd: pd, base: PdOffRg, mode: mode, ids: ids)
	emitNetpollBranchOnWaitStart(module, func: func, cur: begin, gpp: gpp, ready: takeReady, free: checkDeadline, ids: ids)
	emitNetpollWaitAnswer(module, block: takeReady, verdict: NetpollWaitReady, ids: ids)

	let deadline = emitPdDeadline(module, block: checkDeadline, pd: pd, mode: mode, ids: ids)
	let armed = emitCmp(module, block: checkDeadline, a: deadline, b: emitConst(module, block: checkDeadline, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(checkDeadline, op: StdOp.condBranch(armed, thenBlockId: askClock.id, elseBlockId: park.id))

	// A deadline already past ends the wait before it begins — the alternative is a park whose timer entry the
	// next walk fires immediately, which is the same answer for more work.
	let now = emitGtNowNs(module, block: askClock, ids: ids)
	let expired = emitCmp(module, block: askClock, a: deadline, b: now, pred: StdCmpPred.le, ids: ids)
	module.setTerminator(askClock, op: StdOp.condBranch(expired, thenBlockId: lateExit.id, elseBlockId: park.id))

	let parkArg = emitNetpollParkArg(module, block: park, fd: fd, mode: mode, ids: ids)
	emitStoreField(module, block: park, record: gpp, offset: 0, value: emitConst(module, block: park, value: PdWait, ids: ids))

	// The life this wait belongs to is `gen`: the hold taken at `entry` has kept the record in it since `look`
	// matched — see `PdOffGen`. It is stamped on the thread as well, because the PUBLICATION happens on the far
	// side of the switch in `__np_pd_commit`, which holds nothing but the thread (`GtRuntime.GtOffParkGen`).
	emitStoreField(module, block: park, record: emitLoadCurrentGt(module, block: park, ids: ids), offset: GtOffParkGen, value: gen)
	emitSchedLockLeave(module, block: park, ids: ids)
	emitGtPark(module, ids: ids, cur: park, kind: GtParkKindNetpoll, arg: parkArg, cont: resumed)

	// ⛔⛔ **THE WAIT IS OVER, BUT THE RECORD MAY NOT BE THIS THREAD’S ANY MORE.** A release readies its waiter
	// and resets the record while the table slot goes on naming it, so by the time this thread runs the
	// descriptor may have been closed, reused, and opened onto the SAME record — whose direction word now belongs
	// to another thread. Settling it would strand that thread or erase a verdict it has not yet read, so the
	// settle is behind the generation test (`PdOffGen`).
	emitSchedLockEnter(module, block: resumed, ids: ids)
	module.setTerminator(resumed, op: StdOp.condBranch(emitPdSameLife(module, block: resumed, pd: pd, gen: gen, ids: ids), thenBlockId: stillOurs.id, elseBlockId: recycled.id))

	emitNetpollSettleHold(module, func: func, cur: stillOurs, gpp: gpp, ended: PdExpired, woken: readyExit, unwoken: lateExit, ids: ids)

	// A record that has moved on — before the mark or under the park — owes this thread nothing, and the
	// caller may not be sent back to its syscall either, because the descriptor it holds may now be LIVE and
	// another socket’s. See `NetpollWaitStale`.
	emitNetpollWaitAnswer(module, block: recycled, verdict: NetpollWaitStale, ids: ids)

	emitNetpollWaitAnswer(module, block: lateExit, verdict: NetpollWaitTimedOut, ids: ids)
	emitNetpollWaitAnswer(module, block: readyExit, verdict: NetpollWaitReady, ids: ids)

	module.functions.push(func)
end 'buildNetpollPdWait'

// `__np_pd_commit(gt)` — see `NetpollPdCommitName`.
function buildNetpollPdCommit(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdCommitName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var groupArm = module.addBlock(func, label: b"npcgroup", heat: BlockHeat.normal)
	var single = module.addBlock(func, label: b"npcsingle", heat: BlockHeat.normal)
	var look = module.addBlock(func, label: b"npclook", heat: BlockHeat.normal)
	var resumeNow = module.addBlock(func, label: b"npcresume", heat: BlockHeat.normal)
	var publish = module.addBlock(func, label: b"npcpublish", heat: BlockHeat.normal)
	var armDeadline = module.addBlock(func, label: b"npcdl", heat: BlockHeat.normal)
	var parked = module.addBlock(func, label: b"npcparked", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let gt = 0 as ValueId

	emitNetpollBranchOnGroupPark(module, block: entry, gt: gt, several: groupArm, one: single, ids: ids)
	emitNetpollCommitGroup(module, func: func, cur: groupArm, gt: gt, resumeNow: resumeNow, parked: parked, ids: ids)

	let parkedOn = emitNetpollParkedDirection(module, func: func, cur: single, gt: gt, known: look, ids: ids)
	let pd = parkedOn.pd
	let mode = parkedOn.mode
	let gpp = parkedOn.gpp
	let ourMark = emitPdMarkStands(module, block: look, gpp: gpp, pd: pd, markedGen: emitLoadField(module, block: look, record: gt, offset: GtOffParkGen, ids: ids), ids: ids)
	module.setTerminator(look, op: StdOp.condBranch(ourMark, thenBlockId: publish.id, elseBlockId: resumeNow.id))

	// Readiness landed between the mark and this commit, so the thread is readied rather than left waiting for
	// a wake that has already happened — Go's `netpollblockcommit` answering false. A record that moved on
	// arrives here too, and the resumed `__np_pd_wait`'s own generation test answers `NetpollWaitStale`.
	module.setTerminator(resumeNow, op: StdOp.ret(emitGtReadyLocked(module, block: resumeNow, gt: gt, ids: ids)))

	emitStoreField(module, block: publish, record: gt, offset: GtOffStatus, value: emitConst(module, block: publish, value: GtStatusWaiting, ids: ids))
	emitStoreField(module, block: publish, record: gpp, offset: 0, value: gt)
	emitNetpollStepWaiters(module, block: publish, delta: 1, ids: ids)
	emitSchedCountNetpollBlock(module, block: publish, ids: ids)
	let deadline = emitPdDeadline(module, block: publish, pd: pd, mode: mode, ids: ids)
	let armed = emitCmp(module, block: publish, a: deadline, b: emitConst(module, block: publish, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(publish, op: StdOp.condBranch(armed, thenBlockId: armDeadline.id, elseBlockId: parked.id))

	// The deadline rides the scheduler's own timer heap, TAGGED with its direction so the removal that ends
	// this wait cannot take a `sleep` the same thread is holding.
	module.appendOp(armDeadline, op: StdOp.call(ids.mint(), callee: GtTimerAddName, args: threeArgs(gt, second: deadline, third: emitTimerTagOfNetpollMode(module, block: armDeadline, mode: mode, ids: ids))))
	module.setTerminator(armDeadline, op: StdOp.branch(parked.id))

	emitConstReturn(module, block: parked, value: WakeDebtNone, ids: ids)
	module.functions.push(func)
end 'buildNetpollPdCommit'

// `__np_pd_expire(gt)` — see `NetpollPdExpireName`.
function buildNetpollPdExpire(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdExpireName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var groupArm = module.addBlock(func, label: b"npxgroup", heat: BlockHeat.normal)
	var single = module.addBlock(func, label: b"npxsingle", heat: BlockHeat.normal)
	var look = module.addBlock(func, label: b"npxlook", heat: BlockHeat.normal)
	var gone = module.addBlock(func, label: b"npxgone", heat: BlockHeat.normal)
	var fire = module.addBlock(func, label: b"npxfire", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let gt = 0 as ValueId

	// ⭐ **A GROUP'S DEADLINE ENDS THE WHOLE WAIT AND MARKS NOTHING**, where a single source's marks the
	// direction it expired on: the caller of a multi-source wait re-reads every source anyway, so there is no
	// verdict for a mark to carry. The unhook is what makes the expiry safe — a member left holding this
	// thread would ready it a second time.
	emitNetpollBranchOnGroupPark(module, block: entry, gt: gt, several: groupArm, one: single, ids: ids)
	module.appendOp(groupArm, op: StdOp.call(ids.mint(), callee: NetpollGroupUnhookName, args: argsOf(gt)))
	module.setTerminator(groupArm, op: StdOp.ret(emitGtReadyLocked(module, block: groupArm, gt: gt, ids: ids)))

	// A word no longer naming this thread is one the readiness walk got to first, removing the entry with it —
	// the race's losing side, and nothing is owed.
	let parkedOn = emitNetpollParkedDirection(module, func: func, cur: single, gt: gt, known: look, ids: ids)
	let gpp = parkedOn.gpp
	let state = emitLoadField(module, block: look, record: gpp, offset: 0, ids: ids)
	let ours = emitCmp(module, block: look, a: state, b: gt, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(look, op: StdOp.condBranch(ours, thenBlockId: fire.id, elseBlockId: gone.id))
	emitConstReturn(module, block: gone, value: WakeDebtNone, ids: ids)

	emitNetpollUnhookExpired(module, block: fire, gpp: gpp, ids: ids)
	module.setTerminator(fire, op: StdOp.ret(emitGtReadyLocked(module, block: fire, gt: gt, ids: ids)))

	module.functions.push(func)
end 'buildNetpollPdExpire'

// ⭐⭐⭐ **`__np_pd_drop(gt)` — A DROPPED READER IS RENOUNCED, NOT ABANDONED.**
//
// ⚠ **THE ALTERNATIVE LEAKS THE FRAME, AND THAT IS MEASURED RATHER THAN FEARED.** A suspended green thread's
// locals cannot be unwound from outside — nothing walks a parked frame — so freeing the stack of a thread
// that will never resume strands every heap value its locals own: the socket box, the receive buffer, the
// client. A `sleep`-parked coroutine holding one `String` exits 101 by exactly the same road, which is what
// says the gap is the ABANDONMENT and not the poller.
//
// ⭐ **SO THIS IS THE AWAIT ARM's ANSWER, APPLIED TO A SOCKET WAIT** (`buildGtPromiseDrop`'s "a thread parked
// in an await is RENOUNCED"): take the thread off the direction word so no readiness event can reach it,
// disarm its deadline, and mark the wait EXPIRED. The caller readies it; it runs its own body out, its own
// frame's destructors free what it held, and its runner reclaims it — the queued arm's contract exactly.
function buildNetpollPdDrop(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdDropName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var groupArm = module.addBlock(func, label: b"npdgroup", heat: BlockHeat.normal)
	var single = module.addBlock(func, label: b"npdsingle", heat: BlockHeat.normal)
	var look = module.addBlock(func, label: b"npdlook", heat: BlockHeat.normal)
	var unhook = module.addBlock(func, label: b"npdunhook", heat: BlockHeat.normal)
	var disarm = module.addBlock(func, label: b"npddisarm", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npddone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let gt = 0 as ValueId

	// A GROUP is taken off every one of its members, and its deadline is the GROUP's rather than a direction's.
	emitNetpollBranchOnGroupPark(module, block: entry, gt: gt, several: groupArm, one: single, ids: ids)
	module.appendOp(groupArm, op: StdOp.call(ids.mint(), callee: NetpollGroupUnhookName, args: argsOf(gt)))
	let groupDeadline = emitNetpollGroupDeadline(module, block: groupArm, gt: gt, ids: ids)
	emitNetpollDisarmDeadline(module, func: func, ids: ids, startBlock: groupArm, gt: gt, deadline: groupDeadline, tag: emitNetpollGroupTimerTag(module, block: groupArm, ids: ids), cont: doneBlock)

	let parkedOn = emitNetpollParkedDirection(module, func: func, cur: single, gt: gt, known: look, ids: ids)
	let tag = emitTimerTagOfNetpollMode(module, block: look, mode: parkedOn.mode, ids: ids)
	let deadline = emitPdDeadline(module, block: look, pd: parkedOn.pd, mode: parkedOn.mode, ids: ids)
	let gpp = parkedOn.gpp
	let state = emitLoadField(module, block: look, record: gpp, offset: 0, ids: ids)
	let ours = emitCmp(module, block: look, a: state, b: gt, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(look, op: StdOp.condBranch(ours, thenBlockId: unhook.id, elseBlockId: disarm.id))

	emitNetpollUnhookExpired(module, block: unhook, gpp: gpp, ids: ids)
	module.setTerminator(unhook, op: StdOp.branch(disarm.id))

	// The deadline goes whether or not the direction still named this thread: a readiness wake that got there
	// first removed the entry already, and the scan then answers "not present" rather than taking another's.
	emitNetpollDisarmDeadline(module, func: func, ids: ids, startBlock: disarm, gt: gt, deadline: deadline, tag: tag, cont: doneBlock)
	module.setTerminator(doneBlock, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildNetpollPdDrop'

// `__np_pd_ready_one(pd, mode)` — see `NetpollPdReadyOneName`.
function buildNetpollPdReadyOne(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdReadyOneName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var notWaiter = module.addBlock(func, label: b"nprnowaiter", heat: BlockHeat.normal)
	var markWoken = module.addBlock(func, label: b"nprmarked", heat: BlockHeat.normal)
	var notMarked = module.addBlock(func, label: b"nprnotmarked", heat: BlockHeat.normal)
	var markReady = module.addBlock(func, label: b"nprmark", heat: BlockHeat.normal)
	var held = module.addBlock(func, label: b"nprheld", heat: BlockHeat.normal)
	var wake = module.addBlock(func, label: b"nprwake", heat: BlockHeat.normal)
	var unhookRest = module.addBlock(func, label: b"nprunhook", heat: BlockHeat.normal)
	var disarmTimer = module.addBlock(func, label: b"nprdisarm", heat: BlockHeat.normal)
	var readied = module.addBlock(func, label: b"nprreadied", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let pd = 0 as ValueId
	let mode = 1 as ValueId

	let gpp = emitPdDirectionAddr(module, block: entry, pd: pd, base: PdOffRg, mode: mode, ids: ids)
	let state = emitLoadField(module, block: entry, record: gpp, offset: 0, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(emitPdIsWaiter(module, block: entry, state: state, ids: ids), thenBlockId: wake.id, elseBlockId: notWaiter.id))

	// A marked word takes the verdict and stays held: a wait not yet published is then declined by its commit,
	// and a group member its ended wait still holds is reported when that wait resumes.
	let isMarked = emitCmp(module, block: notWaiter, a: state, b: emitConst(module, block: notWaiter, value: PdWait, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(notWaiter, op: StdOp.condBranch(isMarked, thenBlockId: markWoken.id, elseBlockId: notMarked.id))
	emitStoreField(module, block: markWoken, record: gpp, offset: 0, value: emitConst(module, block: markWoken, value: PdWoken, ids: ids))
	emitConstReturn(module, block: markWoken, value: WakeDebtNone, ids: ids)

	// Nobody is waiting yet. The readiness is REMEMBERED rather than dropped, because the poller is
	// edge-triggered: a wait that begins after this event would otherwise never be told.
	let isFree = emitCmp(module, block: notMarked, a: state, b: emitConst(module, block: notMarked, value: PdReady, ids: ids), pred: StdCmpPred.le, ids: ids)
	module.setTerminator(notMarked, op: StdOp.condBranch(isFree, thenBlockId: markReady.id, elseBlockId: held.id))
	emitStoreField(module, block: markReady, record: gpp, offset: 0, value: emitConst(module, block: markReady, value: PdReady, ids: ids))
	emitConstReturn(module, block: markReady, value: WakeDebtNone, ids: ids)

	// A word already holding its waiter's verdict keeps it: `PdWoken` is this event's answer already, and
	// `PdExpired` is an answer this event does not change — see `PdWoken`.
	emitConstReturn(module, block: held, value: WakeDebtNone, ids: ids)

	emitNetpollStepWaiters(module, block: wake, delta: -1, ids: ids)

	// ⛔⛔ **A THREAD WAITING ON SEVERAL SOURCES IS TAKEN OFF ALL OF THEM HERE.** Left published on the
	// others, the next readiness would ready a thread that is already running — a run queue holding one thread
	// twice. This hold of `__sched_lock` is what makes the take and the unhook one act.
	//
	// ⚠ **THE TWO SHAPES ARM THEIR DEADLINE ON DIFFERENT WORDS, SO EACH EDGE CARRIES ITS OWN.** A member's
	// `pd.rd` is 0 for every source a collect drain waits on; reading it for a GROUP would answer "nothing
	// armed" and strand the group's entry on the heap. The TAG is shared, because every group member is
	// watched for READING (`emitNetpollGroupSetMember`).
	//
	// ⭐ **THE WORD THAT FIRED IS LEFT `PdWoken` IN BOTH SHAPES** — the verdict the resumed wait settles, and for a
	// group the one account of which source ended the wait. It is written BEFORE the unhook, whose test is "does
	// this word still name the thread", so the member's waiter count is not paid back twice.
	emitStoreField(module, block: wake, record: gpp, offset: 0, value: emitConst(module, block: wake, value: PdWoken, ids: ids))
	let tag = emitTimerTagOfNetpollMode(module, block: wake, mode: mode, ids: ids)
	let ownDeadline = emitPdDeadline(module, block: wake, pd: pd, mode: mode, ids: ids)
	emitNetpollBranchOnGroupPark(module, block: wake, gt: state, several: unhookRest, one: disarmTimer, ids: ids)
	wake.branchEdges.push(BranchEdge.create(disarmTimer.id, argIds: argsOf(ownDeadline)))

	module.appendOp(unhookRest, op: StdOp.call(ids.mint(), callee: NetpollGroupUnhookName, args: argsOf(state)))
	let groupDeadline = emitNetpollGroupDeadline(module, block: unhookRest, gt: state, ids: ids)
	module.setTerminator(unhookRest, op: StdOp.branch(disarmTimer.id))
	unhookRest.branchEdges.push(BranchEdge.create(disarmTimer.id, argIds: argsOf(groupDeadline)))

	let deadline = ids.mint()
	disarmTimer.blockArgs.push(IrBlockArg.create(deadline, argType: StdType.i64))
	emitNetpollDisarmDeadline(module, func: func, ids: ids, startBlock: disarmTimer, gt: state, deadline: deadline, tag: tag, cont: readied)
	module.setTerminator(readied, op: StdOp.ret(emitGtReadyLocked(module, block: readied, gt: state, ids: ids)))

	module.functions.push(func)
end 'buildNetpollPdReadyOne'

// `__np_pd_wake(fd, readReady, writeReady)` — see `NetpollPdWakeName`.
// ⭐⭐ **WHAT THE POLLER HANDED BACK IS A DESCRIPTOR ON A POSIX LANE AND A STAMPED KEY ON A COMPLETION
// PORT** — see `NetpollKeyGenShift`. Only the low half indexes the record band.
function emitNetpollWakeIndex(module StdModule, block IrBlock, shape NetpollShape, key ValueId, ids ValueMinter) returns ValueId
	return match shape 'shape'
		epoll or
			kqueue gives key

		completionPort gives emitBin(module, block: block, a: key, b: emitConst(module, block: block, value: NetpollKeyIndexMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	end 'shape'
end 'emitNetpollWakeIndex'

// ⭐⭐⭐ **A PACKET FOR A SOURCE ALREADY GIVEN BACK NAMES NOTHING, AND DROPPING IT IS THE ANSWER.** A kernel
// stops reporting a CLOSED descriptor itself, so a POSIX lane has no such packet and this is a plain branch
// there. A completion packet outlives its child and the key is all it carries, so the generation rides in the
// key's high half and is compared here against the record's. Readying on a mismatch readies whoever holds that
// index NOW — on Windows the next child, whose waiter then reads `STILL_ACTIVE` off a live process.
function emitNetpollWakeGenerationGate(module StdModule, block IrBlock, shape NetpollShape, key ValueId, pd ValueId, live IrBlock, stale IrBlock, noDebt ValueId, ids ValueMinter)
	match shape 'shape'
		epoll or
			kqueue then module.setTerminator(block, op: StdOp.branch(live.id))

		completionPort then emitNetpollWakeCompareGeneration(module, block: block, key: key, pd: pd, live: live, stale: stale, noDebt: noDebt, ids: ids)
	end 'shape'
end 'emitNetpollWakeGenerationGate'

function emitNetpollWakeCompareGeneration(module StdModule, block IrBlock, key ValueId, pd ValueId, live IrBlock, stale IrBlock, noDebt ValueId, ids ValueMinter)
	let stamped = emitBin(module, block: block, a: key, b: emitConst(module, block: block, value: NetpollKeyGenShift, ids: ids), opcode: StdBinOpcode.shrLogical, ids: ids)
	module.setTerminator(block, op: StdOp.condBranch(emitPdSameLife(module, block: block, pd: pd, gen: stamped, ids: ids), thenBlockId: live.id, elseBlockId: stale.id))
	block.branchEdges.push(BranchEdge.create(stale.id, argIds: argsOf(noDebt)))
end 'emitNetpollWakeCompareGeneration'

function buildNetpollPdWake(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollPdWakeName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var current = module.addBlock(func, label: b"npwkcurrent", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npwkknown", heat: BlockHeat.normal)
	var doRead = module.addBlock(func, label: b"npwkread", heat: BlockHeat.normal)
	var afterRead = module.addBlock(func, label: b"npwkafterread", heat: BlockHeat.normal)
	var doWrite = module.addBlock(func, label: b"npwkwrite", heat: BlockHeat.normal)
	var afterWrite = module.addBlock(func, label: b"npwkafterwrite", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npwkdone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let fd = 0 as ValueId
	let readReady = 1 as ValueId
	let writeReady = 2 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let source = emitNetpollWakeIndex(module, block: entry, shape: netpollShape(target), key: fd, ids: ids)
	let pd = emitNetpollPdLookup(module, block: entry, fd: source, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let noDebt = emitConst(module, block: entry, value: WakeDebtNone, ids: ids)
	let haveRecord = emitCmp(module, block: entry, a: pd, b: zero, pred: StdCmpPred.ne, ids: ids)

	// A descriptor with no record is one whose socket has been closed: this event is its last, and there is
	// nothing left to wake.
	module.setTerminator(entry, op: StdOp.condBranch(haveRecord, thenBlockId: current.id, elseBlockId: doneBlock.id))
	entry.branchEdges.push(BranchEdge.create(doneBlock.id, argIds: argsOf(noDebt)))

	emitNetpollWakeGenerationGate(module, block: current, shape: netpollShape(target), key: fd, pd: pd, live: known, stale: doneBlock, noDebt: noDebt, ids: ids)

	let wantsRead = emitCmp(module, block: known, a: readReady, b: zero, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(known, op: StdOp.condBranch(wantsRead, thenBlockId: doRead.id, elseBlockId: afterRead.id))
	known.branchEdges.push(BranchEdge.create(afterRead.id, argIds: argsOf(noDebt)))

	let readDebt = ids.mint()
	module.appendOp(doRead, op: StdOp.call(readDebt, callee: NetpollPdReadyOneName, args: twoArgs(pd, second: emitConst(module, block: doRead, value: NetpollModeRead, ids: ids))))
	module.setTerminator(doRead, op: StdOp.branch(afterRead.id))
	doRead.branchEdges.push(BranchEdge.create(afterRead.id, argIds: argsOf(readDebt)))

	let debtSoFar = ids.mint()
	afterRead.blockArgs.push(IrBlockArg.create(debtSoFar, argType: StdType.i64))
	let wantsWrite = emitCmp(module, block: afterRead, a: writeReady, b: zero, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(afterRead, op: StdOp.condBranch(wantsWrite, thenBlockId: doWrite.id, elseBlockId: afterWrite.id))
	afterRead.branchEdges.push(BranchEdge.create(afterWrite.id, argIds: argsOf(debtSoFar)))

	let writeDebt = ids.mint()
	module.appendOp(doWrite, op: StdOp.call(writeDebt, callee: NetpollPdReadyOneName, args: twoArgs(pd, second: emitConst(module, block: doWrite, value: NetpollModeWrite, ids: ids))))
	let bothOwed = emitBin(module, block: doWrite, a: debtSoFar, b: writeDebt, opcode: StdBinOpcode.bitOr, ids: ids)
	module.setTerminator(doWrite, op: StdOp.branch(afterWrite.id))
	doWrite.branchEdges.push(BranchEdge.create(afterWrite.id, argIds: argsOf(bothOwed)))

	let owed = ids.mint()
	afterWrite.blockArgs.push(IrBlockArg.create(owed, argType: StdType.i64))
	module.setTerminator(afterWrite, op: StdOp.branch(doneBlock.id))
	afterWrite.branchEdges.push(BranchEdge.create(doneBlock.id, argIds: argsOf(owed)))

	let debt = ids.mint()
	doneBlock.blockArgs.push(IrBlockArg.create(debt, argType: StdType.i64))
	emitSchedLockLeave(module, block: doneBlock, ids: ids)
	module.setTerminator(doneBlock, op: StdOp.ret(debt))

	module.functions.push(func)
end 'buildNetpollPdWake'

// `__np_pd_op_begin(fd)` — see `NetpollPdOpBeginName`. A live source always has a record (`__np_pd_open` at a
// socket's birth, `__np_pd_adopt` for every minted source), so a missing one is the stop rather than a made-up
// generation.
function buildNetpollPdOpBegin(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdOpBeginName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npobknown", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: entry, fd: fd, known: known, ids: ids)

	emitStoreField(module, block: known, record: pd, offset: PdOffTimedOut, value: emitConst(module, block: known, value: 0, ids: ids))
	let gen = emitLoadField(module, block: known, record: pd, offset: PdOffGen, ids: ids)
	emitSchedLockLeave(module, block: known, ids: ids)
	module.setTerminator(known, op: StdOp.ret(gen))
	module.functions.push(func)
end 'buildNetpollPdOpBegin'

// `__np_pd_mark_timed_out(fd, gen)` — see `NetpollPdMarkTimedOutName`. Both arms reach the one unlock.
function buildNetpollPdMarkTimedOut(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdMarkTimedOutName, returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npmtknown", heat: BlockHeat.normal)
	var store = module.addBlock(func, label: b"npmtstore", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npmtdone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let fd = 0 as ValueId
	let gen = 1 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: entry, fd: fd, known: known, ids: ids)

	module.setTerminator(known, op: StdOp.condBranch(emitPdSameLife(module, block: known, pd: pd, gen: gen, ids: ids), thenBlockId: store.id, elseBlockId: doneBlock.id))

	emitStoreField(module, block: store, record: pd, offset: PdOffTimedOut, value: emitConst(module, block: store, value: 1, ids: ids))
	module.setTerminator(store, op: StdOp.branch(doneBlock.id))

	emitSchedLockLeave(module, block: doneBlock, ids: ids)
	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPdMarkTimedOut'

// `__np_pd_timed_out(fd)` — see `NetpollPdOpBeginName`. A descriptor with no record has made no wait and
// therefore missed no deadline.
function buildNetpollPdTimedOut(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdTimedOutName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"nptoknown", heat: BlockHeat.normal)
	var missing = module.addBlock(func, label: b"nptonone", heat: BlockHeat.normal)
	var answer = module.addBlock(func, label: b"nptoanswer", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookup(module, block: entry, fd: fd, ids: ids)
	let zero = emitConst(module, block: entry, value: 0, ids: ids)
	let haveRecord = emitCmp(module, block: entry, a: pd, b: zero, pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(haveRecord, thenBlockId: known.id, elseBlockId: missing.id))

	let mark = emitLoadField(module, block: known, record: pd, offset: PdOffTimedOut, ids: ids)
	module.setTerminator(known, op: StdOp.branch(answer.id))
	known.branchEdges.push(BranchEdge.create(answer.id, argIds: argsOf(mark)))
	module.setTerminator(missing, op: StdOp.branch(answer.id))
	missing.branchEdges.push(BranchEdge.create(answer.id, argIds: argsOf(zero)))

	let held = ids.mint()
	answer.blockArgs.push(IrBlockArg.create(held, argType: StdType.i64))
	emitSchedLockLeave(module, block: answer, ids: ids)
	module.setTerminator(answer, op: StdOp.ret(held))
	module.functions.push(func)
end 'buildNetpollPdTimedOut'

// ==========================================================================
// THE CHILD-EXIT SOURCE — a parked child is a poll descriptor, not a store
// ==========================================================================
//
// ⭐⭐⭐ **A CHILD JOINS THE POLLER AS A SOURCE OF ITS OWN, SO NOTHING CAPS THE POLLER'S WAIT FOR IT.** The
// band above already holds everything a wait needs — one waiter per direction, a deadline, a generation, and
// the published-waiter count the scheduler reads — and the only thing a child was ever missing is a NUMBER the
// poller can report it under. Each lane answers that differently and nothing below this file's edge has to
// care:
//
//   • **Linux** — `pidfd_open` answers a real descriptor that polls readable at exit.
//   • **macOS** — `EVFILT_PROC` keys on a pid, which shares one number space with descriptors, so the child's
//     exit is registered on a kqueue of its own and THAT kqueue's descriptor is the source.
//   • **Windows** — there is no descriptor to draw, so the key is allocated here and the thread pool posts a
//     packet under it (`NetpollVerb.armChildSource`).
//
// ⚠ **THE ORDER IS OPEN, ADOPT, ARM, AND IT IS NOT FREE TO VARY.** A readiness event for a source with no
// record is dropped (`__np_pd_wake`), and a child exits exactly once — so a registration made before the
// record exists is a wait nothing can end.

// ⭐⭐ **THE BAND WATCHES A WAITABLE HANDLE, AND A CHILD PROCESS IS ITS FIRST HOLDER RATHER THAN ITS ONLY
// ONE.** On the completion-port lane a source is minted and a thread-pool wait posts it when the handle
// signals, which is exactly what an asynchronous CONNECT needs too: `ManagedSocketRuntime` arms an event for
// `FD_CONNECT` and watches it through these three. On the two POSIX lanes the handle really is a child's, and
// a socket there is polled directly.
//
// ⛔ **THE OPEN AND THE ARM ARE FILE-PRIVATE, AND THAT IS WHAT KEEPS THE REFUSAL ANSWERED.** Every holder
// reaches them through `emitNetpollAcquireChildSource`, which is the one body that tests the arm's answer; a
// second spelling outside this file is how a refused registration becomes a park nothing can end.
//
// `__np_child_open(childHandle) -> source | -ESRCH` — mint this handle's poll source and give it a record. It
// aborts `netpollFailed` when the host refuses one, exactly as a socket the poller will not take does; a POSIX
// kernel's `-ESRCH` says the child is already gone and travels back in the source's place, having been given
// no record (`emitNetpollChildSourceFromHost`).
let NetpollChildOpenName = b"__np_child_open"

// `__np_child_arm(source, childHandle) -> token` — register the source with the poller. A 0 says the
// registration was refused; any other value is the token `__np_child_close` must be handed back.
let NetpollChildArmName = b"__np_child_arm"

// `__np_child_close(source, token)` — give the source and its registration back, and reset its record.
export let NetpollChildCloseName = b"__np_child_close"

// What a POSIX lane's arm answers on success. Its close takes the SOURCE back rather than a token, so the
// value only has to be distinguishable from the 0 that means refused.
let NetpollChildArmed = 1 as ParsedInt

// The completion-port lane's source-key allocator: the head of the free list (a key + 1, so 0 is "empty") and
// the lowest key never yet handed out. Its holders are a parked child and an overlapped read in flight.
let NetpollSourceKeyFreeLabel = b"__np_src_key_free"
let NetpollSourceKeyHighLabel = b"__np_src_key_high"

// ⭐⭐⭐ **A COMPLETION KEY CARRIES THE RECORD'S GENERATION IN ITS HIGH HALF, AND A STALE PACKET THEREFORE
// NAMES NOTHING.** The key is the ONLY thing a completion packet carries, so a record generation alone could
// not help: the walk would look the key up and find whatever record now holds that index. Put the generation
// IN the key and the walk can refuse it.
//
// ⛔⛔ **WITHOUT THIS, A STALE PACKET READIES THE WRONG CHILD AND `__gt_process_run` ANSWERS 259.** Two
// roads reach it, and neither is a race this thread can close by draining: a machine ALREADY blocked in
// `GetQueuedCompletionStatusEx(INFINITE)` on the same port is who the kernel hands the packet to FIRST, and
// its `__np_pd_wake` can be descheduled past this thread's release, key free, and a NEW child's open, arm and
// park — so it readies the new child's waiter, which then reads `STILL_ACTIVE` off a live process as an exit
// code. And the drain is bounded at `NetpollBatchEntries`, so with more packets than that queued this
// child's survives it anyway.
//
// ⚠ **32 BITS EACH IS NOT A COMPROMISE HERE.** An index is a dense allocator's counter and a generation is a
// per-record close count; neither approaches 2^32 in a process, and the break token is decoded BEFORE any
// key is split, so no stamped key can be mistaken for it.
let NetpollKeyGenShift = 32 as ParsedInt
let NetpollKeyIndexMask = 4294967295 as ParsedInt

// `__np_src_key_alloc() -> key` / `__np_src_key_release(key)` — the completion-port lane's stand-in for a
// descriptor table. `__sched_lock` is taken here, because the PAIR of words is what must move indivisibly.
let NetpollSourceKeyAllocName = b"__np_src_key_alloc"
let NetpollSourceKeyReleaseName = b"__np_src_key_release"

// ⭐⭐⭐ **ON A COMPLETION PORT THE POLL SOURCE IS THE OPERATION, NOT THE DESCRIPTOR — `__np_op_open() ->
// source` and `__np_op_close(source)`, the completion-port lane's answer to `__np_pd_open`.** A POSIX poller
// reports that a DESCRIPTOR became readable, so one record per descriptor is the whole of it; a port reports
// that an OPERATION finished, and two overlapped reads may be in flight on one pipe at once — a promise
// dropped mid-read stays parked until its cancellation lands, while the next caller is already issuing a fresh
// read on the same handle. One record per handle would meet that with `netpollDoubleWait`, on a program that
// did nothing wrong; one record per read gives each its own direction word for as long as the kernel owns its
// buffer.
//
// ⛔ **THE SOURCE IS OPENED BEFORE THE READ IS ISSUED, AND THAT ORDER IS THE WHOLE RACE.** A packet may be
// delivered the instant the read is issued — long before the thread reaches `__np_pd_wait` — and the decode
// finds its record through the STAMPED KEY the open writes onto the reading thread (`GtRuntime.GtOffIoSource`).
// Opened afterwards, the decode would read a word nobody had written yet. Readiness that arrives before the
// wait is what `__np_pd_wait`'s `PdReady` arm is for, so the early packet costs nothing.
let NetpollOpOpenName = b"__np_op_open"
let NetpollOpCloseName = b"__np_op_close"

// `__np_op_wake(gt) -> wakeDebt` — the decode's half of an overlapped completion: give back the record the
// issuing thread stamped on itself and ready it there. `__sched_lock` NOT held.
//
// ⛔⛔ **THE STAMP IS READ AND CLEARED UNDER THE LOCK, AND THAT IS WHAT LETS A THREAD RE-AIM A CANCELLED
// OPERATION.** A wait that ends any other way than in this packet — a deadline, a socket closed under it —
// leaves the kernel still holding the caller's buffer, so that thread CANCELS and then waits again on a source
// of its own. Both sides move `io_source` inside this one lock, so the thread either sees a zero (this packet
// got there first, and there is nothing left to wait for) or re-aims before the packet is decoded. A zero here
// therefore means exactly *"the kernel has finished with this operation"*, which is also what
// `__gt_promise_drop` reads it as.
let NetpollOpWakeName = b"__np_op_wake"

// `__np_op_aim(source, mode, handle)` — tell the running thread which record its next overlapped operation
// completes on, in which direction, and on which handle a cancellation must name it. The DESCRIPTOR twin of
// `__np_op_open`: a socket already has a record of its own, so nothing is minted and only the stamp is made.
let NetpollOpAimName = b"__np_op_aim"

// `__np_op_clear()` — take the aim back, for an operation the host refused to start: no packet is coming, so
// a stamp left standing would make `__gt_promise_drop` cancel an operation that does not exist.
let NetpollOpClearName = b"__np_op_clear"

// ⭐⭐⭐ **`__np_op_settle() -> source | 0` — WHAT A THREAD DOES WHEN ITS WAIT ENDED WITHOUT THE KERNEL'S
// ANSWER.** A deadline, or a socket closed under the operation, readies the thread while the kernel still owns
// its buffer and its OVERLAPPED — so the thread cancels and must then wait for the cancellation's own packet
// before it may return and let that memory go. It cannot wait on the record it was on: a release has reset it,
// and the next owner is entitled to it. So this mints a source of the thread's OWN and re-aims the operation at
// it, under the one lock `__np_op_wake` reads the aim inside. A 0 answers *"the packet was decoded already"*,
// and there is then nothing to wait for.
let NetpollOpSettleName = b"__np_op_settle"

// `__np_child_fired(source, timerFired)` — the thread pool's wait callback, which does nothing but forward the
// exit to the port under the child's key. Built only on the completion-port lane.
let NetpollChildFiredName = b"__np_child_fired"

// `__np_child_open(childHandle)` — see `NetpollChildOpenName`.
function buildNetpollChildOpen(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollChildOpenName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var adopt = module.addBlock(func, label: b"npchadopt", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let childHandle = 0 as ValueId

	let source = ids.mint()
	adopt.blockArgs.push(IrBlockArg.create(source, argType: StdType.i64))

	match netpollShape(target) 'mint'
		completionPort then emitNetpollSourceKeyFromAllocator(module, block: entry, cont: adopt, ids: ids)

		epoll or
			kqueue then emitNetpollChildSourceFromHost(module, func: func, cur: entry, target: target, childHandle: childHandle, cont: adopt, ids: ids)
	end 'mint'

	module.appendOp(adopt, op: StdOp.call(ids.mint(), callee: NetpollPdAdoptName, args: argsOf(source)))
	module.setTerminator(adopt, op: StdOp.ret(source))

	module.functions.push(func)
end 'buildNetpollChildOpen'

// The completion-port lane's source key: allocated here, because Windows has no descriptor table to draw a
// dense number from.
function emitNetpollSourceKeyFromAllocator(module StdModule, block IrBlock, cont IrBlock, ids ValueMinter)
	let key = ids.mint()
	module.appendOp(block, op: StdOp.call(key, callee: NetpollSourceKeyAllocName, args: ValueIdArray.create()))
	module.setTerminator(block, op: StdOp.branch(cont.id))
	block.branchEdges.push(BranchEdge.create(cont.id, argIds: argsOf(key)))
end 'emitNetpollSourceKeyFromAllocator'

// A POSIX lane's source key IS a descriptor the host mints, so a refusal is the host's — and the answer to
// *"this child can never be waited for"* is the one a socket the poller will not take already gets.
//
// ⛔ **`-ESRCH` TRAVELS BACK RATHER THAN ABORTING**: it says the child has already exited, which
// `emitNetpollAcquireChildSource` answers by reading the status. Every other negative is a real refusal.
//
// ⛔⛔ **AND IT RETURNS FROM `__np_child_open` HERE RATHER THAN JOINING `cont`, BECAUSE AN errno IS NOT AN
// INDEX.** `cont` is the block that gives the answer a RECORD, and `__np_pd_adopt` reads what it is handed as
// the record table's index: `-ESRCH` addresses the words BEFORE the table, and one of them is then handed to
// `emitNetpollPdClear` as a poll descriptor — a wild pointer readied as a green thread, or eight bytes
// belonging to something else overwritten with a fresh record's address. MEASURED on a loaded arm64-macos
// host as a SIGSEGV in `__np_pd_ready_one`, on a program that did nothing wrong.
function emitNetpollChildSourceFromHost(module StdModule, func IrFunction, cur IrBlock, target Target, childHandle ValueId, cont IrBlock, ids ValueMinter)
	var checked = module.addBlock(func, label: b"npchsrcchk", heat: BlockHeat.normal)
	var gone = module.addBlock(func, label: b"npchsrcgone", heat: BlockHeat.normal)

	let source = emitNetpoll(module, block: cur, verb: NetpollVerb.openChildSource, operands: argsOf(childHandle), ids: ids)
	let exited = emitCmp(module, block: cur, a: source, b: emitConst(module, block: cur, value: 0 - PosixErrnoNoSuchProcess, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(exited, thenBlockId: gone.id, elseBlockId: checked.id))
	module.setTerminator(gone, op: StdOp.ret(source))

	emitNetpollRequire(module, func: func, cur: checked, shape: netpollShape(target), verb: NetpollVerb.openChildSource, subject: childHandle, answer: source, cont: cont, ids: ids)
	checked.branchEdges.push(BranchEdge.create(cont.id, argIds: argsOf(source)))
end 'emitNetpollChildSourceFromHost'

// `__np_child_arm(source, childHandle)` — see `NetpollChildArmName`.
function buildNetpollChildArm(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollChildArmName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let source = 0 as ValueId
	let childHandle = 1 as ValueId

	let poller = emitLoadGlobalWord(module, block: entry, label: NetpollPollerLabel, ids: ids)

	match netpollShape(target) 'arm'
		// Windows answers the registered wait itself, and a 0 from `RegisterWaitForSingleObject` is already
		// this function's "refused" — so the host's answer IS the token.
		completionPort then emitNetpollArmChildOnPort(module, block: entry, poller: poller, source: source, childHandle: childHandle, ids: ids)

		epoll or
			kqueue then emitNetpollArmChildOnPosix(module, func: func, cur: entry, poller: poller, source: source, childHandle: childHandle, ids: ids)
	end 'arm'

	module.functions.push(func)
end 'buildNetpollChildArm'

// ⭐ **THE CONTEXT THE THREAD POOL HANDS BACK IS THE STAMPED KEY, NOT THE SOURCE.** `__np_child_fired` posts
// whatever it is given, so stamping here is the whole of it — the isel passes operand 1 through to the
// callback's `Context` argument either way, and the pd band keeps seeing a plain dense index.
function emitNetpollArmChildOnPort(module StdModule, block IrBlock, poller ValueId, source ValueId, childHandle ValueId, ids ValueMinter)
	let callback = ids.mint()
	module.appendOp(block, op: StdOp.funcAddr(callback, funcName: NetpollChildFiredName))
	let key = emitNetpollStampKey(module, block: block, source: source, ids: ids)
	module.setTerminator(block, op: StdOp.ret(emitNetpoll(module, block: block, verb: NetpollVerb.armChildSource, operands: fourArgs(poller, second: key, third: childHandle, fourth: callback), ids: ids)))
end 'emitNetpollArmChildOnPort'

// `source | (pd(source).gen << 32)` — the key a packet carries back, taken when the request is opened, armed or
// aimed. `__np_child_fired` posts whatever context it is handed, so stamping here is the whole of it: the isel
// passes operand 1 through to the callback's `Context` argument either way, and the pd band goes on seeing a
// plain dense index.
function emitNetpollStampKey(module StdModule, block IrBlock, source ValueId, ids ValueMinter) returns ValueId
	return emitNetpollStampKeyOfRecord(module, block: block, pd: emitNetpollPdLookup(module, block: block, fd: source, ids: ids), source: source, ids: ids)
end 'emitNetpollStampKey'

// The one spelling of the stamped key's layout, which `emitNetpollWakeCompareGeneration` decodes.
function emitNetpollStampKeyOfRecord(module StdModule, block IrBlock, pd ValueId, source ValueId, ids ValueMinter) returns ValueId
	let gen = emitLoadField(module, block: block, record: pd, offset: PdOffGen, ids: ids)
	let high = emitBin(module, block: block, a: gen, b: emitConst(module, block: block, value: NetpollKeyGenShift, ids: ids), opcode: StdBinOpcode.shl, ids: ids)
	return emitBin(module, block: block, a: high, b: source, opcode: StdBinOpcode.bitOr, ids: ids)
end 'emitNetpollStampKeyOfRecord'

// A POSIX registration answers 0 or a negative errno, which carries no token — so the token is a constant the
// close ignores, and the only fact travelling back is whether the kernel took the source.
//
// ⛔ **THE REFUSAL IS RAISED HERE, WHERE THE errno STILL EXISTS.** Answering 0 and leaving the caller to
// abort throws away the one fact worth having: `EINVAL`, `ESRCH` and `EBADF` are three different bugs on this
// path, and only the number tells them apart.
function emitNetpollArmChildOnPosix(module StdModule, func IrFunction, cur IrBlock, poller ValueId, source ValueId, childHandle ValueId, ids ValueMinter)
	var refused = module.addBlock(func, label: b"npchrefused", heat: BlockHeat.normal)
	var armed = module.addBlock(func, label: b"npcharmed", heat: BlockHeat.normal)

	let answer = emitNetpoll(module, block: cur, verb: NetpollVerb.armChildSource, operands: threeArgs(poller, second: source, third: childHandle), ids: ids)
	let failed = emitCmp(module, block: cur, a: answer, b: emitConst(module, block: cur, value: 0, ids: ids), pred: StdCmpPred.lt, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(failed, thenBlockId: refused.id, elseBlockId: armed.id))
	emitNetpollFailWith(module, func: func, block: refused, verb: NetpollVerb.armChildSource, subject: source, answer: answer, ids: ids)
	emitConstReturn(module, block: armed, value: NetpollChildArmed, ids: ids)
end 'emitNetpollArmChildOnPosix'

// `__np_child_close(source, token)` — see `NetpollChildCloseName`.
function buildNetpollChildClose(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollChildCloseName, returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npchdone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let source = 0 as ValueId
	let token = 1 as ValueId

	// ⛔⛔ **THE ORDER IS THE SHAPE'S, AND EACH HAS ITS OWN REASON FOR ITS OWN.**
	match netpollShape(target) 'give'
		completionPort then emitNetpollCloseChildOnPort(module, block: entry, source: source, token: token, cont: doneBlock, ids: ids)

		epoll or
			kqueue then emitNetpollCloseChildOnPosix(module, block: entry, source: source, cont: doneBlock, ids: ids)
	end 'give'

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollChildClose'

// ⭐⭐ **THE ORDER IS WHAT MAKES A KEY SAFE TO RECYCLE, AND NOTHING HAS TO BE DRAINED.** `UnregisterWaitEx`
// blocks until a callback already running has finished, so once it returns either the packet was posted or
// none ever will be; the RELEASE then bumps the record's generation, which is the half of the key a posted
// packet carries. A packet that beat the release is answered by whichever machine holds the port, and that
// machine's walk finds a generation that no longer matches and drops it — see `NetpollKeyGenShift`, which is
// why a poll of our own here would be neither necessary nor sufficient.
function emitNetpollCloseChildOnPort(module StdModule, block IrBlock, source ValueId, token ValueId, cont IrBlock, ids ValueMinter)
	emitNetpollUnwatchHandleOnPort(module, block: block, token: token, ids: ids)
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollPdReleaseName, args: argsOf(source)))
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollSourceKeyReleaseName, args: argsOf(source)))
	module.setTerminator(block, op: StdOp.branch(cont.id))
end 'emitNetpollCloseChildOnPort'

// ⭐ **GIVE A REGISTRATION BACK AND LEAVE THE RECORD IT READIES ALONE.** A watch armed on a DESCRIPTOR's own
// record must not release that record: the descriptor outlives the watch and its close is what owns it. Only
// a source minted for the watch is released, which `emitNetpollCloseChildOnPort` does around this call.
//
// ⚠ **THE COMPLETION-PORT LANE'S SPELLING**: `closeChildSource` takes the REGISTRATION TOKEN here where a
// POSIX lane's takes the source, so this door serves that lane alone.
export function emitNetpollUnwatchHandleOnPort(module StdModule, block IrBlock, token ValueId, ids ValueMinter)
	_ = emitNetpoll(module, block: block, verb: NetpollVerb.closeChildSource, operands: argsOf(token), ids: ids)
end 'emitNetpollUnwatchHandleOnPort'

// What `emitNetpollAcquireChildSource` hands back: the source a wait names, and the token its close takes.
export type NetpollChildSource
	export let source as ValueId
	export let token as ValueId

	static function create(source ValueId, token ValueId) returns NetpollChildSource
		return Self{source: source, token: token}
	end 'create'
end 'NetpollChildSource'

// ⭐⭐ **MAKE A CHILD A SOURCE ON THE POLLER, AND THE ORDER OF THE THREE STEPS IS THE CONTRACT.** The source
// is minted, given a record, and only then registered: an exit reported before the record exists would be
// dropped, and a child exits ONCE. `cur` is terminated and `cont` reached with the source armed.
//
// ⛔ A poller that will not take the source leaves the caller nothing to wait on, which is the stop a socket
// it will not take already gets — not a `RunProcessError`: the child spawned, and no caller could do anything
// with the distinction but abandon a process it can no longer hear from.
// ⛔⛔ **A CHILD THAT HAS ALREADY EXITED REACHES `gone`, AND THAT IS NOT A FAILURE.** The open answers
// `-ESRCH` for it (`PosixRuntime.PosixErrnoNoSuchProcess`), and the caller's answer is the one it would have
// reached anyway: read the status, which is still there to read. Aborting instead is the shape that has now
// cost this rung three rounds — a runtime path reading *"the thing already happened"* as *"the host refused
// me"*.
//
// ⚠ **THE WINDOWS LANE CANNOT REACH `gone` AND DOES NOT NEED TO.** Its open allocates a dense key and cannot
// fail this way, and `RegisterWaitForSingleObject` on an ALREADY-SIGNALLED handle fires the callback at once
// rather than refusing — so the packet is posted and the wait ends immediately, which is the same answer by a
// different road.
export function emitNetpollAcquireChildSource(module StdModule, func IrFunction, ids ValueMinter, cur IrBlock, hProcess ValueId, cont IrBlock, gone IrBlock) returns NetpollChildSource
	var opened = module.addBlock(func, label: b"npchopened", heat: BlockHeat.normal)

	let source = ids.mint()
	module.appendOp(cur, op: StdOp.call(source, callee: NetpollChildOpenName, args: argsOf(hProcess)))
	let exited = emitCmp(module, block: cur, a: source, b: emitConst(module, block: cur, value: 0 - PosixErrnoNoSuchProcess, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(exited, thenBlockId: gone.id, elseBlockId: opened.id))

	return NetpollChildSource.create(source, token: emitNetpollWatchHandleOnRecord(module, func: func, ids: ids, cur: opened, source: source, handle: hProcess, cont: cont))
end 'emitNetpollAcquireChildSource'

// ⭐⭐ **ARM A HANDLE'S SIGNAL ONTO A RECORD THAT ALREADY EXISTS.** `cur` is terminated and `cont` reached
// with the registration live, carrying the token its unregistration takes. What the signal then readies is
// the READ direction of `source`, because a hand-posted packet carries no directions of its own
// (`emitNetpollEntryReadiness`) — so a caller that hands its DESCRIPTOR's record here waits on that record
// with `__np_pd_wait` and is subject to the one-waiter-per-direction rule like any other reader.
//
// ⛔ **IT IS THE ONE BODY THAT TESTS THE ARM'S ANSWER.** A registration the poller refused, answered with a
// 0 the caller went on to wait behind, is a park nothing can end — so the refusal stops here, which is what a
// socket the poller will not take already gets.
export function emitNetpollWatchHandleOnRecord(module StdModule, func IrFunction, ids ValueMinter, cur IrBlock, source ValueId, handle ValueId, cont IrBlock) returns ValueId
	var refused = module.addBlock(func, label: b"npchrefused", heat: BlockHeat.normal)

	let token = ids.mint()
	module.appendOp(cur, op: StdOp.call(token, callee: NetpollChildArmName, args: twoArgs(source, second: handle)))
	let armed = emitCmp(module, block: cur, a: token, b: emitConst(module, block: cur, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(cur, op: StdOp.condBranch(armed, thenBlockId: cont.id, elseBlockId: refused.id))
	emitNetpollFailWith(module, func: func, block: refused, verb: NetpollVerb.armChildSource, subject: handle, answer: token, ids: ids)

	return token
end 'emitNetpollWatchHandleOnRecord'

// The record is reset BEFORE the descriptor is closed — the socket band's order, for its reason: a number the
// kernel hands to the next opener while this record is still live would leave two owners of one record.
// Closing is also what takes the source out of the poller, exactly as closing a socket is.
function emitNetpollCloseChildOnPosix(module StdModule, block IrBlock, source ValueId, cont IrBlock, ids ValueMinter)
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollPdReleaseName, args: argsOf(source)))
	_ = emitNetpoll(module, block: block, verb: NetpollVerb.closeChildSource, operands: argsOf(source), ids: ids)
	module.setTerminator(block, op: StdOp.branch(cont.id))
end 'emitNetpollCloseChildOnPosix'

// The completion-port lane's key allocator, the per-operation source doors it feeds, and the callback that
// posts under a key. Built only there — the two POSIX lanes take their keys from the kernel's descriptor table,
// their kernels report a child themselves, and a read there completes in its caller.
function buildNetpollSourceKeyBand(module StdModule)
	buildNetpollSourceKeyAlloc(module)
	buildNetpollSourceKeyRelease(module)
	buildNetpollOpOpen(module)
	buildNetpollOpClose(module)
	buildNetpollOpWake(module)
	buildNetpollOpAim(module)
	buildNetpollOpClear(module)
	buildNetpollOpSettle(module)
	buildNetpollChildFired(module)
end 'buildNetpollSourceKeyBand'

// `__np_src_key_alloc()` — see `NetpollSourceKeyAllocName`. A recycled key comes off the free list, which is
// threaded through the records themselves (`PdOffNextFreeKey`); otherwise the high-water mark steps.
function buildNetpollSourceKeyAlloc(module StdModule)
	var func = IrFunction.createFromStd(NetpollSourceKeyAllocName, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var reuse = module.addBlock(func, label: b"npkreuse", heat: BlockHeat.normal)
	var relink = module.addBlock(func, label: b"npkrelink", heat: BlockHeat.normal)
	var fresh = module.addBlock(func, label: b"npkfresh", heat: BlockHeat.normal)
	var answer = module.addBlock(func, label: b"npkanswer", heat: BlockHeat.normal)

	emitSchedLockEnter(module, block: entry, ids: ids)
	let head = emitLoadGlobalWord(module, block: entry, label: NetpollSourceKeyFreeLabel, ids: ids)
	let empty = emitCmp(module, block: entry, a: head, b: emitConst(module, block: entry, value: 0, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(empty, thenBlockId: fresh.id, elseBlockId: reuse.id))

	// A key on the free list without a record cannot arise: only `__np_src_key_release` puts one there, and every
	// key it is handed was adopted.
	let recycled = emitBin(module, block: reuse, a: head, b: emitConst(module, block: reuse, value: 1, ids: ids), opcode: StdBinOpcode.sub, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: reuse, fd: recycled, known: relink, ids: ids)

	emitStoreGlobalWord(module, block: relink, label: NetpollSourceKeyFreeLabel, value: emitLoadField(module, block: relink, record: pd, offset: PdOffNextFreeKey, ids: ids), ids: ids)
	module.setTerminator(relink, op: StdOp.branch(answer.id))
	relink.branchEdges.push(BranchEdge.create(answer.id, argIds: argsOf(recycled)))

	let high = emitLoadGlobalWord(module, block: fresh, label: NetpollSourceKeyHighLabel, ids: ids)
	emitStoreGlobalWord(module, block: fresh, label: NetpollSourceKeyHighLabel, value: emitBin(module, block: fresh, a: high, b: emitConst(module, block: fresh, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids), ids: ids)
	let minted = emitBin(module, block: fresh, a: emitBin(module, block: fresh, a: high, b: emitConst(module, block: fresh, value: 1, ids: ids), opcode: StdBinOpcode.shl, ids: ids), b: emitConst(module, block: fresh, value: 1, ids: ids), opcode: StdBinOpcode.bitOr, ids: ids)
	module.setTerminator(fresh, op: StdOp.branch(answer.id))
	fresh.branchEdges.push(BranchEdge.create(answer.id, argIds: argsOf(minted)))

	let key = ids.mint()
	answer.blockArgs.push(IrBlockArg.create(key, argType: StdType.i64))
	emitSchedLockLeave(module, block: answer, ids: ids)
	module.setTerminator(answer, op: StdOp.ret(key))

	module.functions.push(func)
end 'buildNetpollSourceKeyAlloc'

// `__np_src_key_release(key)` — see `NetpollSourceKeyReleaseName`.
function buildNetpollSourceKeyRelease(module StdModule)
	var func = IrFunction.createFromStd(NetpollSourceKeyReleaseName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npkrknown", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let key = 0 as ValueId

	// Every key handed here was adopted, and an adoption carves the record — so no record means a caller
	// released a key it never opened.
	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: entry, fd: key, known: known, ids: ids)

	emitStoreField(module, block: known, record: pd, offset: PdOffNextFreeKey, value: emitLoadGlobalWord(module, block: known, label: NetpollSourceKeyFreeLabel, ids: ids))
	emitStoreGlobalWord(module, block: known, label: NetpollSourceKeyFreeLabel, value: emitBin(module, block: known, a: key, b: emitConst(module, block: known, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids), ids: ids)
	emitSchedLockLeave(module, block: known, ids: ids)
	module.setTerminator(known, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildNetpollSourceKeyRelease'

// Open a poll source for the read this block is about to issue, and answer it. The caller is the reading green
// thread, so the stamped key lands on the thread the completion packet will name.
export function emitNetpollOpOpen(module StdModule, block IrBlock, ids ValueMinter) returns ValueId
	let source = ids.mint()
	module.appendOp(block, op: StdOp.call(source, callee: NetpollOpOpenName, args: ValueIdArray.create()))
	return source
end 'emitNetpollOpOpen'

// Give one back — see `NetpollOpOpenName`.
export function emitNetpollOpClose(module StdModule, block IrBlock, source ValueId, ids ValueMinter)
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollOpCloseName, args: argsOf(source)))
end 'emitNetpollOpClose'

// ⭐ **THE ONE POLLER, FOR A CALLER OUTSIDE THIS FILE.** A Windows pipe joins the port when it is CREATED, which
// is `GtRuntime`'s work rather than this band's — so the handle is read through a door rather than the label
// being exported, exactly as every other word of this file is reached.
export function emitNetpollPollerHandle(module StdModule, block IrBlock, ids ValueMinter) returns ValueId
	return emitLoadGlobalWord(module, block: block, label: NetpollPollerLabel, ids: ids)
end 'emitNetpollPollerHandle'

// `__np_op_open()` — see `NetpollOpOpenName`.
function buildNetpollOpOpen(module StdModule)
	var func = IrFunction.createFromStd(NetpollOpOpenName, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	let source = ids.mint()
	module.appendOp(entry, op: StdOp.call(source, callee: NetpollSourceKeyAllocName, args: ValueIdArray.create()))
	module.appendOp(entry, op: StdOp.call(ids.mint(), callee: NetpollPdAdoptName, args: argsOf(source)))

	// The stamp reads the record's generation outside the lock, which is safe because nobody else holds this
	// key: the allocator handed it to this thread and only `__np_op_close` gives it back.
	let key = emitNetpollStampKey(module, block: entry, source: source, ids: ids)
	emitStoreField(module, block: entry, record: emitLoadCurrentGt(module, block: entry, ids: ids), offset: GtOffIoSource, value: key)
	module.setTerminator(entry, op: StdOp.ret(source))

	module.functions.push(func)
end 'buildNetpollOpOpen'

// `__np_op_close(source)` — see `NetpollOpOpenName`. The guard on the thread goes first, because a promise
// dropped after it is cleared takes the ordinary deregistering arm and this thread is no longer parked by
// then. The release bumps the record's generation, so a packet that outlived the operation names nothing; the
// key then goes back for the next one.
function buildNetpollOpClose(module StdModule)
	var func = IrFunction.createFromStd(NetpollOpCloseName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let source = 0 as ValueId

	emitStoreField(module, block: entry, record: emitLoadCurrentGt(module, block: entry, ids: ids), offset: GtOffIoSource, value: emitConst(module, block: entry, value: 0, ids: ids))
	module.appendOp(entry, op: StdOp.call(ids.mint(), callee: NetpollPdReleaseName, args: argsOf(source)))
	module.appendOp(entry, op: StdOp.call(ids.mint(), callee: NetpollSourceKeyReleaseName, args: argsOf(source)))
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildNetpollOpClose'

// `__np_op_wake(gt)` — see `NetpollOpWakeName`.
function buildNetpollOpWake(module StdModule)
	var func = IrFunction.createFromStd(NetpollOpWakeName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var current = module.addBlock(func, label: b"npowcurrent", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npowknown", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npowdone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let gt = 0 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let key = emitLoadField(module, block: entry, record: gt, offset: GtOffIoSource, ids: ids)
	emitStoreField(module, block: entry, record: gt, offset: GtOffIoSource, value: emitConst(module, block: entry, value: 0, ids: ids))
	let mode = emitLoadField(module, block: entry, record: gt, offset: GtOffIoMode, ids: ids)
	let index = emitBin(module, block: entry, a: key, b: emitConst(module, block: entry, value: NetpollKeyIndexMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	let pd = emitNetpollPdLookup(module, block: entry, fd: index, ids: ids)
	let noDebt = emitConst(module, block: entry, value: WakeDebtNone, ids: ids)
	let haveRecord = emitCmp(module, block: entry, a: pd, b: emitConst(module, block: entry, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(haveRecord, thenBlockId: current.id, elseBlockId: doneBlock.id))
	entry.branchEdges.push(BranchEdge.create(doneBlock.id, argIds: argsOf(noDebt)))

	// A packet whose record has moved on names nothing: the thread that issued the operation has already been
	// readied by whatever reset the record, and the clear above is what tells it not to wait for this packet.
	emitNetpollWakeCompareGeneration(module, block: current, key: key, pd: pd, live: known, stale: doneBlock, noDebt: noDebt, ids: ids)

	let debt = ids.mint()
	module.appendOp(known, op: StdOp.call(debt, callee: NetpollPdReadyOneName, args: twoArgs(pd, second: mode)))
	module.setTerminator(known, op: StdOp.branch(doneBlock.id))
	known.branchEdges.push(BranchEdge.create(doneBlock.id, argIds: argsOf(debt)))

	let owed = ids.mint()
	doneBlock.blockArgs.push(IrBlockArg.create(owed, argType: StdType.i64))
	emitSchedLockLeave(module, block: doneBlock, ids: ids)
	module.setTerminator(doneBlock, op: StdOp.ret(owed))

	module.functions.push(func)
end 'buildNetpollOpWake'

// `__np_op_aim(source, mode, handle)` — see `NetpollOpAimName`. The generation is read under the lock because
// the record is the DESCRIPTOR's and a close on another machine may be resetting it.
function buildNetpollOpAim(module StdModule)
	var func = IrFunction.createFromStd(NetpollOpAimName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var known = module.addBlock(func, label: b"npoaknown", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let source = 0 as ValueId
	let mode = 1 as ValueId
	let handle = 2 as ValueId

	// An operation aimed at a record nobody opened would complete into a packet the decode drops, and the thread
	// would wait for a wake that cannot come.
	emitSchedLockEnter(module, block: entry, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: entry, fd: source, known: known, ids: ids)

	let gt = emitLoadCurrentGt(module, block: known, ids: ids)
	emitStoreField(module, block: known, record: gt, offset: GtOffIoMode, value: mode)
	emitStoreField(module, block: known, record: gt, offset: GtOffIoHandle, value: handle)
	emitStoreField(module, block: known, record: gt, offset: GtOffIoSource, value: emitNetpollStampKeyOfRecord(module, block: known, pd: pd, source: source, ids: ids))
	emitSchedLockLeave(module, block: known, ids: ids)
	module.setTerminator(known, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildNetpollOpAim'

// `__np_op_clear()` — see `NetpollOpClearName`.
function buildNetpollOpClear(module StdModule)
	var func = IrFunction.createFromStd(NetpollOpClearName, returnType: StdReturnType.void, paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitSchedLockEnter(module, block: entry, ids: ids)
	emitStoreField(module, block: entry, record: emitLoadCurrentGt(module, block: entry, ids: ids), offset: GtOffIoSource, value: emitConst(module, block: entry, value: 0, ids: ids))
	emitSchedLockLeave(module, block: entry, ids: ids)
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildNetpollOpClear'

// `__np_op_settle()` — see `NetpollOpSettleName`.
//
// ⚠ **THE MINT RUNS UNDER THIS HOLD, AND THE WAKE DEBT IT COULD HAND BACK IS PROVABLY NONE.** A key reaches
// the free list only from a close that has already readied the record's waiters, and a key past the high-water
// mark has no record at all — so `__np_pd_adopt`'s reset finds both directions empty and owes nothing.
function buildNetpollOpSettle(module StdModule)
	var func = IrFunction.createFromStd(NetpollOpSettleName, returnType: StdReturnType.value(StdType.i64), paramCount: 0, paramTypes: StdTypeArray.create(), returnLine: 0)
	var ids = ValueMinter.create(0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var mint = module.addBlock(func, label: b"npossmint", heat: BlockHeat.normal)
	var settled = module.addBlock(func, label: b"npossdone", heat: BlockHeat.normal)

	emitSchedLockEnter(module, block: entry, ids: ids)
	let aimed = emitLoadField(module, block: entry, record: emitLoadCurrentGt(module, block: entry, ids: ids), offset: GtOffIoSource, ids: ids)
	let inFlight = emitCmp(module, block: entry, a: aimed, b: emitConst(module, block: entry, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(inFlight, thenBlockId: mint.id, elseBlockId: settled.id))
	entry.branchEdges.push(BranchEdge.create(settled.id, argIds: argsOf(emitConst(module, block: entry, value: 0, ids: ids))))

	let source = emitNetpollOpOpen(module, block: mint, ids: ids)
	module.setTerminator(mint, op: StdOp.branch(settled.id))
	mint.branchEdges.push(BranchEdge.create(settled.id, argIds: argsOf(source)))

	let answer = ids.mint()
	settled.blockArgs.push(IrBlockArg.create(answer, argType: StdType.i64))
	emitSchedLockLeave(module, block: settled, ids: ids)
	module.setTerminator(settled, op: StdOp.ret(answer))

	module.functions.push(func)
end 'buildNetpollOpSettle'

// The three doors the socket band reaches the overlapped aim through — see each name's own note.
export function emitNetpollOpAim(module StdModule, block IrBlock, source ValueId, mode ParsedInt, handle ValueId, ids ValueMinter)
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollOpAimName, args: threeArgs(source, second: emitConst(module, block: block, value: mode, ids: ids), third: handle)))
end 'emitNetpollOpAim'

export function emitNetpollOpClear(module StdModule, block IrBlock, ids ValueMinter)
	module.appendOp(block, op: StdOp.call(ids.mint(), callee: NetpollOpClearName, args: ValueIdArray.create()))
end 'emitNetpollOpClear'

export function emitNetpollOpSettle(module StdModule, block IrBlock, ids ValueMinter) returns ValueId
	let source = ids.mint()
	module.appendOp(block, op: StdOp.call(source, callee: NetpollOpSettleName, args: ValueIdArray.create()))
	return source
end 'emitNetpollOpSettle'

// ⭐⭐⭐ **TWO ALLOCATORS SHARE ONE RECORD TABLE ON THE COMPLETION-PORT LANE, SO ITS INDEX SPACE IS SPLIT BY
// PARITY.** A POSIX poller keys every record by a descriptor the KERNEL allocated, so one space is the whole of
// it. Windows has no descriptor for a child or for an overlapped operation, so `__np_src_key_alloc` mints
// indices of its own — and a minted index equal to a live SOCKET handle would be two owners of one record, with
// a child's waiter readied by a socket's packet. So a minted key is ODD and a descriptor's record sits at TWICE
// the descriptor; the two runs can never meet, whatever values the host hands out.
export function emitNetpollDescriptorIndex(module StdModule, block IrBlock, target Target, fd ValueId, ids ValueMinter) returns ValueId
	return match netpollShape(target) 'shape'
		epoll or
			kqueue gives fd

		completionPort gives emitBin(module, block: block, a: fd, b: emitConst(module, block: block, value: 1, ids: ids), opcode: StdBinOpcode.shl, ids: ids)
	end 'shape'
end 'emitNetpollDescriptorIndex'

// `__np_child_fired(source, timerFired)` — see `NetpollChildFiredName`. It runs on a thread-pool thread that
// holds no processor and owns no green thread, which is why it does nothing but forward: the port is the one
// place every wake in this runtime already comes from.
//
// ⚠ **A POST THAT FAILS IS A WAIT NOTHING CAN END**, so it aborts rather than returning quietly.
function buildNetpollChildFired(module StdModule)
	var func = IrFunction.createFromStd(NetpollChildFiredName, returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var posted = module.addBlock(func, label: b"npcfposted", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let source = 0 as ValueId

	let poller = emitLoadGlobalWord(module, block: entry, label: NetpollPollerLabel, ids: ids)
	let answer = emitNetpoll(module, block: entry, verb: NetpollVerb.postChildExit, operands: twoArgs(poller, second: source), ids: ids)
	emitNetpollRequire(module, func: func, cur: entry, shape: NetpollShape.completionPort, verb: NetpollVerb.postChildExit, subject: source, answer: answer, cont: posted, ids: ids)

	module.setTerminator(posted, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollChildFired'

// ==========================================================================
// THE PIPE READ END — a child's stdout is a poll source too
// ==========================================================================
//
// ⭐⭐ **A GREEN THREAD READING A CHILD'S PIPE MUST NOT HOLD ITS MACHINE INSIDE `read(2)`**, which is the same
// requirement a socket read has and is met the same way: the descriptor is made non-blocking and registered,
// the read answers `EAGAIN`, and the caller parks on the record instead of blocking
// (`GtRuntime.__gt_subp_yield_read`).
//
// ⛔ **AN `EAGAIN` MUST NEVER REACH A CALLER THAT READS ZERO AS END OF STREAM.** Two sites latch a stream
// permanently on a zero-byte read — `emitSubpTopUpStream`'s `setEof` and `emitSubpDrainStream`'s `markDone` —
// and a merely-empty pipe answering the same 0 would close a stream the child is still writing to. So the
// EAGAIN is consumed BELOW them, by the park: the reader either answers bytes, a real end of stream, or a
// failure, exactly as it did while the descriptor was blocking.

// `__np_pipe_open(fd)` — take a pipe's read end off blocking and give it a poll record. Aborts
// `netpollFailed` when the host refuses, exactly as a socket the poller will not take does.
export let NetpollPipeOpenName = b"__np_pipe_open"

// `__np_pipe_close(fd)` — reset the record before the descriptor is closed. A thread still parked on it is
// READIED rather than stranded, which is `__np_pd_release`'s whole contract.
export let NetpollPipeCloseName = b"__np_pipe_close"

// `__np_pipe_open(fd)` — see `NetpollPipeOpenName`.
function buildNetpollPipeOpen(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollPipeOpenName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var havePipe = module.addBlock(func, label: b"nppipehave", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"nppipedone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	// A stream with no pipe carries a 0 read end (`PosixRuntime.PosixNoPipeDescriptor`), which is the one
	// descriptor number this runtime uses as an absence.
	emitNetpollBranchOnPipe(module, block: entry, fd: fd, present: havePipe, absent: doneBlock, ids: ids)

	match netpollShape(target) 'shape'
		// This lane's pipes are OVERLAPPED and joined the port under `NetpollOverlappedToken` when they were
		// created, so there is no descriptor to flag and no per-HANDLE registration to make: what a read parks
		// on is a source of its own, opened per operation by `__np_op_open`.
		completionPort then module.setTerminator(havePipe, op: StdOp.branch(doneBlock.id))

		epoll or
			kqueue then emitNetpollArmPipe(module, func: func, cur: havePipe, target: target, fd: fd, cont: doneBlock, ids: ids)
	end 'shape'

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPipeOpen'

// ⛔⛔ **TWO SYSCALLS MAY NOT ANSWER UNDER ONE VERB.** Preparing a pipe end is a flag change and then a
// registration, and when one abort code stands for both, the number the host gave names neither — which is
// the same information loss as discarding the errno, one level up. MEASURED: `armPipeSource` answered a bare
// `-1` from arm64-macos and cost a lane round trip that could not say which call had failed.
//
// ⇒ The flag is `armPipeSource` and the registration is `armChildSource`, which is exactly what a pipe end
// needs on every POSIX lane — one descriptor, read direction, edge-triggered — and is already written.
function emitNetpollArmPipe(module StdModule, func IrFunction, cur IrBlock, target Target, fd ValueId, cont IrBlock, ids ValueMinter)
	var registered = module.addBlock(func, label: b"nppipereg", heat: BlockHeat.normal)

	module.appendOp(cur, op: StdOp.call(ids.mint(), callee: NetpollPdAdoptName, args: argsOf(fd)))
	let flagged = emitNetpoll(module, block: cur, verb: NetpollVerb.armPipeSource, operands: argsOf(fd), ids: ids)
	emitNetpollRequire(module, func: func, cur: cur, shape: netpollShape(target), verb: NetpollVerb.armPipeSource, subject: fd, answer: flagged, cont: registered, ids: ids)

	let poller = emitLoadGlobalWord(module, block: registered, label: NetpollPollerLabel, ids: ids)
	let armed = emitNetpoll(module, block: registered, verb: NetpollVerb.armChildSource, operands: threeArgs(poller, second: fd, third: fd), ids: ids)
	emitNetpollRequire(module, func: func, cur: registered, shape: netpollShape(target), verb: NetpollVerb.armChildSource, subject: fd, answer: armed, cont: cont, ids: ids)
end 'emitNetpollArmPipe'

// `__np_pipe_close(fd)` — see `NetpollPipeCloseName`.
function buildNetpollPipeClose(module StdModule, target Target)
	var func = IrFunction.createFromStd(NetpollPipeCloseName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var havePipe = module.addBlock(func, label: b"nppipeclhave", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"nppipecldone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let fd = 0 as ValueId

	emitNetpollBranchOnPipe(module, block: entry, fd: fd, present: havePipe, absent: doneBlock, ids: ids)

	match netpollShape(target) 'shape'
		// Nothing was registered, so nothing is given back — see `__np_pipe_open`.
		completionPort then break 'shape'

		epoll or
			kqueue then module.appendOp(havePipe, op: StdOp.call(ids.mint(), callee: NetpollPdReleaseName, args: argsOf(fd)))
	end 'shape'

	module.setTerminator(havePipe, op: StdOp.branch(doneBlock.id))
	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollPipeClose'

// Terminate `block` on whether `fd` names a pipe end at all.
function emitNetpollBranchOnPipe(module StdModule, block IrBlock, fd ValueId, present IrBlock, absent IrBlock, ids ValueMinter)
	let exists = emitCmp(module, block: block, a: fd, b: emitConst(module, block: block, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(block, op: StdOp.condBranch(exists, thenBlockId: present.id, elseBlockId: absent.id))
end 'emitNetpollBranchOnPipe'

// ==========================================================================
// WAITING ON SEVERAL SOURCES AT ONCE — Go has a goroutine per stream; this has one thread
// ==========================================================================
//
// ⭐⭐⭐ **A DRAIN THAT OWNS TWO PIPES AND A CHILD MUST WAIT ON ALL THREE, AND EXACTLY ONE OF THEM MAY WAKE
// IT.** `SubprocessRuntime.__gt_subp_wait_collect` is the one caller: it cannot park on stdout alone, because a
// child filling its stderr pipe would then block for ever while nothing drained it, and it cannot park on the
// child alone for the mirror reason.
//
// ⭐⭐ **ONE THREAD IS PUBLISHED ON SEVERAL DIRECTION WORDS, AND THE FIRST READINESS TAKES IT OFF ALL OF
// THEM.** Every party that moves a direction word already holds `__sched_lock` (this band's header states why),
// so the take-and-unhook is one critical section, and a second readiness landing behind it finds a member held
// for the thread and leaves it `PdWoken`, which the resumed wait reports. Without the unhook the second event
// would ready a thread that is already running, which is a run queue holding one thread twice.
//
// ⭐⭐⭐ **THE WAIT ANSWERS WHICH MEMBERS IT FOUND READY, BECAUSE A READINESS IT CONSUMES IS NEVER REPORTED
// AGAIN.** The poller is edge-triggered, and a child source reports exactly one event in its life. A caller
// that could not tell which member ended its wait would have to re-derive "the child exited" from the host —
// and XNU can deliver `NOTE_EXIT` BEFORE `waitpid(WNOHANG)` is able to reap the child, so that re-derivation
// answers "running" and the caller parks again on a source with nothing left to say, for ever.
//
// ⚠ **A GROUP'S DEADLINE IS THE GROUP'S OWN WORD AND NEVER A MEMBER'S `pd.rd`/`pd.wd`** — see
// `GroupOffDeadline` for why one wait may hold only one timer entry.

// ⭐ **THE GROUP RECORD, WHICH THE CALLER OWNS.** `count` members follow, each the same `(fd, mode)` pair a
// single-source park carries in `GtOffParkArg`.
//
// ⭐⭐ **THE DEADLINE IS THE GROUP'S AND NOT A MEMBER'S**, where a single-source wait takes its own from
// `pd.rd`. A caller waiting on several sources is waiting for ONE of them, so a per-member deadline would be
// one timer entry per member for a wait that ends once — and `__gt_timer_check`'s entries are keyed by
// (thread, tag), which admits exactly one. `0` is no deadline, in the absolute nanoseconds the timer store
// keys on.
//
// `fired` is where a resumed wait gathers the members it found ready, one bit per member index; it is the
// wait's own scratch, written and read inside one hold of `__sched_lock`.
//
// `stale` is `__np_pd_wait_any`'s third answer: 1 when it refused the group because a member's record had left
// the life the caller began its operation in (`GroupSlotGen`), 0 on every other road. It is the caller's to
// read after a 0, which an expired or renounced wait also answers.
let GroupOffCount = 0 as ByteOffset
let GroupOffDeadline = 8 as ByteOffset
let GroupOffFired = 16 as ByteOffset
let GroupOffStale = 24 as ByteOffset
let GroupOffArgs = 32 as ByteOffset

// The most members a group may hold: `__np_pd_wait_any` answers one bit per member in a 64-bit word. EXPORTED
// so a caller sizing its group can be held to it where the size is chosen.
export let NetpollGroupMaxMembers = 64 as ParsedInt

// ⭐⭐⭐ **A MEMBER IS A PAIR, AND THE SECOND HALF IS THE RECORD'S GENERATION WHEN THE CALLER'S OPERATION
// BEGAN.** It is written at the build, by `emitNetpollGroupSetMember` from the `__np_pd_op_begin` the caller
// made on that source, and read by every walk: the life test at `__np_pd_wait_any`'s entry, the clear walk
// after the park, and `__np_pd_commit`'s test after the context switch. A single-source wait carries the same
// fact in `GtOffParkGen`; several sources need one EACH, because the members are different records and any one
// of them can be closed and reopened between the build and the lock, or while this thread is switched out.
//
// ⛔⛔ **A GENERATION TAKEN UNDER THE WAIT'S OWN LOCK WOULD BE THE NEXT OWNER'S.** The group is built without
// `__sched_lock`, so a release that lands between the build and the lock resets the record and bumps its
// generation, and a stamp read at the lock then agrees with the record it is about to mark — publishing this
// thread into the new owner's direction word (`emitPdMarkStands`). `subpRelease` is a public builtin,
// `__np_pipe_close` reaches `__np_pd_release`, and co-ownership of a handle under a parked operation is what the
// socket band documents as ordinary, so the stamp must predate the gap.
let GroupSlotArg = 0 as ByteOffset
let GroupSlotGen = 8 as ByteOffset
let GroupSlotBytes = 16 as ParsedInt

// The deadline a multi-source wait armed, or 0 for one that armed none — read off the group its park note
// names, which is `emitPdDeadline`'s question asked of the other park shape.
function emitNetpollGroupDeadline(module StdModule, block IrBlock, gt ValueId, ids ValueMinter) returns ValueId
	let group = emitLoadField(module, block: block, record: gt, offset: GtOffParkArg, ids: ids)
	return emitLoadField(module, block: block, record: group, offset: GroupOffDeadline, ids: ids)
end 'emitNetpollGroupDeadline'

// `__np_pd_wait_any(group) -> fired` — suspend the running green thread until ANY member of `group` is ready in
// its direction, and answer which members it found ready: bit `i` for member `i`. EXPORTED for the collect
// drain, its one caller.
export let NetpollPdWaitAnyName = b"__np_pd_wait_any"

// `__np_group_unhook(gt)` — take `gt` off every direction word of its group that still names it, leaving each
// held as `PdWait` until the wait resumes (see `PdWoken`). Called under `__sched_lock` by whatever ends the
// wait: a member's readiness, the group's deadline, or a dropped promise.
let NetpollGroupUnhookName = b"__np_group_unhook"

// EXPORTED so the caller can SIZE the record it owns: its header plus one slot per member.
export let NetpollGroupHeaderBytes = GroupOffArgs as ParsedInt
export let NetpollGroupSlotBytes = GroupSlotBytes

// `&group[index]` — the one place a member's address is computed, for the writer above and the walk below.
function emitNetpollGroupSlotAddr(module StdModule, block IrBlock, group ValueId, index ValueId, ids ValueMinter) returns ValueId
	let scaled = emitBin(module, block: block, a: index, b: emitConst(module, block: block, value: GroupSlotBytes, ids: ids), opcode: StdBinOpcode.mul, ids: ids)
	let offset = emitBin(module, block: block, a: emitConst(module, block: block, value: GroupOffArgs as ParsedInt, ids: ids), b: scaled, opcode: StdBinOpcode.add, ids: ids)
	return emitBin(module, block: block, a: group, b: offset, opcode: StdBinOpcode.add, ids: ids)
end 'emitNetpollGroupSlotAddr'

// Write one member into `group` at `index`: its `(fd, read)` pair and `gen`, the generation `__np_pd_op_begin`
// answered for `fd` (see `GroupSlotGen`). EXPORTED for the collect drain, which fills a group from whichever of
// its sources are still live.
export function emitNetpollGroupSetMember(module StdModule, block IrBlock, group ValueId, index ValueId, fd ValueId, gen ValueId, ids ValueMinter)
	let arg = emitNetpollParkArg(module, block: block, fd: fd, mode: emitConst(module, block: block, value: NetpollModeRead, ids: ids), ids: ids)
	let slot = emitNetpollGroupSlotAddr(module, block: block, group: group, index: index, ids: ids)
	emitStoreField(module, block: block, record: slot, offset: GroupSlotArg, value: arg)
	emitStoreField(module, block: block, record: slot, offset: GroupSlotGen, value: gen)
end 'emitNetpollGroupSetMember'

// Whether the last `__np_pd_wait_any` on `group` refused it for a member whose record left the caller's life —
// see `GroupOffStale`. EXPORTED for the same caller.
export function emitNetpollGroupStale(module StdModule, block IrBlock, group ValueId, ids ValueMinter) returns ValueId
	return emitLoadField(module, block: block, record: group, offset: GroupOffStale, ids: ids)
end 'emitNetpollGroupStale'

// EXPORTED for the same caller: how many members the group holds, and when the wait gives up.
export function emitNetpollGroupSetCount(module StdModule, block IrBlock, group ValueId, count ValueId)
	emitStoreField(module, block: block, record: group, offset: GroupOffCount, value: count)
end 'emitNetpollGroupSetCount'

export function emitNetpollGroupSetDeadline(module StdModule, block IrBlock, group ValueId, deadline ValueId)
	emitStoreField(module, block: block, record: group, offset: GroupOffDeadline, value: deadline)
end 'emitNetpollGroupSetDeadline'

// The tag a group's timer entry wears. EVERY MEMBER IS WATCHED FOR READING (`emitNetpollGroupSetMember`), and
// two things rest on that: the expiry cannot be mistaken for a `sleep` the same thread holds, and the readiness
// wake in `__np_pd_ready_one` — which removes the entry under the tag of the DIRECTION it woke on — reaches the
// group's. A member added for writing would leak a timer entry past the wait that armed it.
function emitNetpollGroupTimerTag(module StdModule, block IrBlock, ids ValueMinter) returns ValueId
	return emitTimerTagOfNetpollMode(module, block: block, mode: emitConst(module, block: block, value: NetpollModeRead, ids: ids), ids: ids)
end 'emitNetpollGroupTimerTag'

// ⭐ **ONE MEMBER, DECODED** — its slot in the group, the record it names, and the direction word inside it.
// The slot travels because the generation lives there.
type NetpollGroupMember
	export let slot as ValueId
	export let pd as ValueId
	export let gpp as ValueId

	static function create(slot ValueId, pd ValueId, gpp ValueId) returns NetpollGroupMember
		return Self{slot: slot, pd: pd, gpp: gpp}
	end 'create'
end 'NetpollGroupMember'

// ⭐ **THE WALK, WRITTEN ONCE BECAUSE THIS BAND REPEATS IT.** `pre` is entered once and seeds the index;
// `hdr` tests it against `count` and branches to `body` or to `exhausted`; `body` decodes the member and
// continues at `act`, whose own terminator the caller supplies; `next` steps the index and goes round.
type NetpollGroupWalk
	export let index as ValueId
	export let member as NetpollGroupMember

	static function create(index ValueId, member NetpollGroupMember) returns NetpollGroupWalk
		return Self{index: index, member: member}
	end 'create'
end 'NetpollGroupWalk'

// A member with no record is a group built out of a descriptor nobody opened, which is a wait nothing can end —
// the same stop `__np_pd_wait` makes for a single source.
function emitNetpollGroupWalk(module StdModule, func IrFunction, pre IrBlock, hdr IrBlock, body IrBlock, act IrBlock, exhausted IrBlock, group ValueId, count ValueId, ids ValueMinter) returns NetpollGroupWalk
	let first = emitConst(module, block: pre, value: 0, ids: ids)
	module.setTerminator(pre, op: StdOp.branch(hdr.id))
	pre.branchEdges.push(BranchEdge.create(hdr.id, argIds: argsOf(first)))

	let index = ids.mint()
	hdr.blockArgs.push(IrBlockArg.create(index, argType: StdType.i64))
	let atEnd = emitCmp(module, block: hdr, a: index, b: count, pred: StdCmpPred.ge, ids: ids)
	module.setTerminator(hdr, op: StdOp.condBranch(atEnd, thenBlockId: exhausted.id, elseBlockId: body.id))

	let slot = emitNetpollGroupSlotAddr(module, block: body, group: group, index: index, ids: ids)
	let arg = emitLoadField(module, block: body, record: slot, offset: GroupSlotArg, ids: ids)
	let mode = emitNetpollParkMode(module, block: body, arg: arg, ids: ids)
	let pd = emitNetpollPdLookupOrAbort(module, func: func, cur: body, fd: emitNetpollParkFd(module, block: body, arg: arg, ids: ids), known: act, ids: ids)

	return NetpollGroupWalk.create(index, member: NetpollGroupMember.create(slot, pd: pd, gpp: emitPdDirectionAddr(module, block: body, pd: pd, base: PdOffRg, mode: mode, ids: ids)))
end 'emitNetpollGroupWalk'

// The generation `member`'s record was in when the caller's operation began — see `GroupSlotGen`.
function emitNetpollMemberBeganGen(module StdModule, block IrBlock, member NetpollGroupMember, ids ValueMinter) returns ValueId
	return emitLoadField(module, block: block, record: member.slot, offset: GroupSlotGen, ids: ids)
end 'emitNetpollMemberBeganGen'

// Is `member`'s record still in the life the caller began in. `__sched_lock` held.
function emitNetpollMemberInBeganLife(module StdModule, block IrBlock, member NetpollGroupMember, ids ValueMinter) returns ValueId
	return emitPdSameLife(module, block: block, pd: member.pd, gen: emitNetpollMemberBeganGen(module, block: block, member: member, ids: ids), ids: ids)
end 'emitNetpollMemberInBeganLife'

// Member `index`'s bit in the answer `__np_pd_wait_any` gives.
function emitNetpollGroupMemberBit(module StdModule, block IrBlock, index ValueId, ids ValueMinter) returns ValueId
	return emitBin(module, block: block, a: emitConst(module, block: block, value: 1, ids: ids), b: index, opcode: StdBinOpcode.shl, ids: ids)
end 'emitNetpollGroupMemberBit'

// Close a walk: step the index in `next` and go round to `hdr`.
function emitNetpollGroupWalkEnd(module StdModule, next IrBlock, hdr IrBlock, index ValueId, ids ValueMinter)
	let stepped = emitBin(module, block: next, a: index, b: emitConst(module, block: next, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	module.setTerminator(next, op: StdOp.branch(hdr.id))
	next.branchEdges.push(BranchEdge.create(hdr.id, argIds: argsOf(stepped)))
end 'emitNetpollGroupWalkEnd'

// `__np_pd_wait_any(group)` — see `NetpollPdWaitAnyName`.
//
// ⭐ **THE LOOK, THE MARK AND THE SWITCH ARE THE SINGLE-SOURCE WAIT'S, WIDENED.** A member that is already
// ready is CONSUMED and the wait never begins; otherwise every member is marked `PdWait` and the publication
// happens after the context switch, in `__np_pd_commit`, exactly as it does for one source.
//
// ⭐⭐ **IT GIVES ONE OF THREE ANSWERS.** Every member whose readiness it consumed, and nothing else — the one
// found ready at the look, or, after a park, the one that ended it plus any whose readiness landed before the
// thread resumed; a consumed readiness is gone from the poller, so the answer is the caller's only record of
// it, and this band's header says what losing it costs. 0 after an expired or renounced wait, whose caller goes
// round its own loop as a renounced `__gt_sleep` does. And 0 with `GroupOffStale` set when a member's record
// has left the life the caller began its operation in (`GroupSlotGen`): the life test runs over EVERY member
// before any word is looked at or marked, under the one lock hold, so a refusal leaves no mark to undo and a
// group that passes it is marked against records the stamps still name. `__np_pd_wait` makes the same refusal
// of its one source; here the caller decides what a moved member means.
function buildNetpollPdWaitAny(module StdModule)
	var func = IrFunction.createFromStd(NetpollPdWaitAnyName, returnType: StdReturnType.value(StdType.i64), paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var lifeHdr = module.addBlock(func, label: b"npgalifehdr", heat: BlockHeat.normal)
	var lifeBody = module.addBlock(func, label: b"npgalifebody", heat: BlockHeat.normal)
	var lifeAct = module.addBlock(func, label: b"npgalifeact", heat: BlockHeat.normal)
	var lifeNext = module.addBlock(func, label: b"npgalifenext", heat: BlockHeat.normal)
	var refuse = module.addBlock(func, label: b"npgastale", heat: BlockHeat.normal)
	var lookPre = module.addBlock(func, label: b"npgalookpre", heat: BlockHeat.normal)
	var lookHdr = module.addBlock(func, label: b"npgalookhdr", heat: BlockHeat.normal)
	var lookBody = module.addBlock(func, label: b"npgalookbody", heat: BlockHeat.normal)
	var lookAct = module.addBlock(func, label: b"npgalookact", heat: BlockHeat.normal)
	var takeReady = module.addBlock(func, label: b"npgaready", heat: BlockHeat.normal)
	var lookNext = module.addBlock(func, label: b"npgalooknext", heat: BlockHeat.normal)
	var markPre = module.addBlock(func, label: b"npgamarkpre", heat: BlockHeat.normal)
	var markHdr = module.addBlock(func, label: b"npgamarkhdr", heat: BlockHeat.normal)
	var markBody = module.addBlock(func, label: b"npgamarkbody", heat: BlockHeat.normal)
	var markAct = module.addBlock(func, label: b"npgamarkact", heat: BlockHeat.normal)
	var park = module.addBlock(func, label: b"npgapark", heat: BlockHeat.normal)
	var resumed = module.addBlock(func, label: b"npgaresumed", heat: BlockHeat.normal)
	var clearHdr = module.addBlock(func, label: b"npgaclearhdr", heat: BlockHeat.normal)
	var clearBody = module.addBlock(func, label: b"npgaclearbody", heat: BlockHeat.normal)
	var clearAct = module.addBlock(func, label: b"npgaclearact", heat: BlockHeat.normal)
	var clearLive = module.addBlock(func, label: b"npgaclearlive", heat: BlockHeat.normal)
	var clearFired = module.addBlock(func, label: b"npgaclearfired", heat: BlockHeat.normal)
	var clearNext = module.addBlock(func, label: b"npgaclearnext", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npgadone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let group = 0 as ValueId

	emitSchedLockEnter(module, block: entry, ids: ids)
	let count = emitLoadField(module, block: entry, record: group, offset: GroupOffCount, ids: ids)
	emitStoreField(module, block: entry, record: group, offset: GroupOffStale, value: emitConst(module, block: entry, value: 0, ids: ids))

	// A member whose record left the caller's life refuses the whole group before any word is touched.
	let life = emitNetpollGroupWalk(module, func: func, pre: entry, hdr: lifeHdr, body: lifeBody, act: lifeAct, exhausted: lookPre, group: group, count: count, ids: ids)
	module.setTerminator(lifeAct, op: StdOp.condBranch(emitNetpollMemberInBeganLife(module, block: lifeAct, member: life.member, ids: ids), thenBlockId: lifeNext.id, elseBlockId: refuse.id))
	emitNetpollGroupWalkEnd(module, next: lifeNext, hdr: lifeHdr, index: life.index, ids: ids)

	emitStoreField(module, block: refuse, record: group, offset: GroupOffStale, value: emitConst(module, block: refuse, value: 1, ids: ids))
	emitSchedLockLeave(module, block: refuse, ids: ids)
	module.setTerminator(refuse, op: StdOp.ret(emitConst(module, block: refuse, value: 0, ids: ids)))

	let look = emitNetpollGroupWalk(module, func: func, pre: lookPre, hdr: lookHdr, body: lookBody, act: lookAct, exhausted: markPre, group: group, count: count, ids: ids)
	emitNetpollBranchOnWaitStart(module, func: func, cur: lookAct, gpp: look.member.gpp, ready: takeReady, free: lookNext, ids: ids)

	// The caller goes round its own loop rather than suspending.
	emitSchedLockLeave(module, block: takeReady, ids: ids)
	module.setTerminator(takeReady, op: StdOp.ret(emitNetpollGroupMemberBit(module, block: takeReady, index: look.index, ids: ids)))
	emitNetpollGroupWalkEnd(module, next: lookNext, hdr: lookHdr, index: look.index, ids: ids)

	// Nothing was ready: mark every member and switch out. The stamp the commit and the clear walk compare
	// against is the member's begin generation (`GroupSlotGen`), which the life test above found the record
	// still in, and the lock has been held since.
	let mark = emitNetpollGroupWalk(module, func: func, pre: markPre, hdr: markHdr, body: markBody, act: markAct, exhausted: park, group: group, count: count, ids: ids)
	emitStoreField(module, block: markAct, record: mark.member.gpp, offset: 0, value: emitConst(module, block: markAct, value: PdWait, ids: ids))
	emitNetpollGroupWalkEnd(module, next: markAct, hdr: markHdr, index: mark.index, ids: ids)

	emitSchedLockLeave(module, block: park, ids: ids)
	emitGtPark(module, ids: ids, cur: park, kind: GtParkKindNetpollAny, arg: group, cont: resumed)

	// The wait is over, and every member word still in the life the caller began in — the life this wait
	// marked, by the test above — is held for this thread and is this group's to settle
	// (`emitNetpollSettleHold`). A `PdWoken` is a readiness consumed here — the member that fired, one that
	// landed before the thread ran, or one that landed before the commit — so it is REPORTED as well as
	// cleared; a `PdWait` is a member nothing fired on. A word in another life belongs to that life's owner
	// and is not touched: the release that recycled it readied this thread and reset the words itself.
	emitSchedLockEnter(module, block: resumed, ids: ids)
	emitStoreField(module, block: resumed, record: group, offset: GroupOffFired, value: emitConst(module, block: resumed, value: 0, ids: ids))
	let clear = emitNetpollGroupWalk(module, func: func, pre: resumed, hdr: clearHdr, body: clearBody, act: clearAct, exhausted: doneBlock, group: group, count: count, ids: ids)
	module.setTerminator(clearAct, op: StdOp.condBranch(emitNetpollMemberInBeganLife(module, block: clearAct, member: clear.member, ids: ids), thenBlockId: clearLive.id, elseBlockId: clearNext.id))

	emitNetpollSettleHold(module, func: func, cur: clearLive, gpp: clear.member.gpp, ended: PdWait, woken: clearFired, unwoken: clearNext, ids: ids)

	let firedSoFar = emitLoadField(module, block: clearFired, record: group, offset: GroupOffFired, ids: ids)
	emitStoreField(module, block: clearFired, record: group, offset: GroupOffFired, value: emitBin(module, block: clearFired, a: firedSoFar, b: emitNetpollGroupMemberBit(module, block: clearFired, index: clear.index, ids: ids), opcode: StdBinOpcode.bitOr, ids: ids))
	module.setTerminator(clearFired, op: StdOp.branch(clearNext.id))
	emitNetpollGroupWalkEnd(module, next: clearNext, hdr: clearHdr, index: clear.index, ids: ids)

	let fired = emitLoadField(module, block: doneBlock, record: group, offset: GroupOffFired, ids: ids)
	emitSchedLockLeave(module, block: doneBlock, ids: ids)
	module.setTerminator(doneBlock, op: StdOp.ret(fired))

	module.functions.push(func)
end 'buildNetpollPdWaitAny'

// `__np_group_unhook(gt)` — see `NetpollGroupUnhookName`. A member whose readiness ended the wait already
// holds `PdWoken`, so the walk passes over it (`__np_pd_ready_one` says why it must).
function buildNetpollGroupUnhook(module StdModule)
	var func = IrFunction.createFromStd(NetpollGroupUnhookName, returnType: StdReturnType.void, paramCount: 1, paramTypes: oneI64Param(), returnLine: 0)
	var ids = ValueMinter.create(1)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var walkHdr = module.addBlock(func, label: b"npguhdr", heat: BlockHeat.normal)
	var walkBody = module.addBlock(func, label: b"npgubody", heat: BlockHeat.normal)
	var walkAct = module.addBlock(func, label: b"npguact", heat: BlockHeat.normal)
	var unhook = module.addBlock(func, label: b"npguunhook", heat: BlockHeat.normal)
	var walkNext = module.addBlock(func, label: b"npgunext", heat: BlockHeat.normal)
	var doneBlock = module.addBlock(func, label: b"npgudone", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 1)
	let gt = 0 as ValueId

	let group = emitLoadField(module, block: entry, record: gt, offset: GtOffParkArg, ids: ids)
	let count = emitLoadField(module, block: entry, record: group, offset: GroupOffCount, ids: ids)
	let walk = emitNetpollGroupWalk(module, func: func, pre: entry, hdr: walkHdr, body: walkBody, act: walkAct, exhausted: doneBlock, group: group, count: count, ids: ids)

	let state = emitLoadField(module, block: walkAct, record: walk.member.gpp, offset: 0, ids: ids)
	let stillOurs = emitCmp(module, block: walkAct, a: state, b: gt, pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(walkAct, op: StdOp.condBranch(stillOurs, thenBlockId: unhook.id, elseBlockId: walkNext.id))

	emitStoreField(module, block: unhook, record: walk.member.gpp, offset: 0, value: emitConst(module, block: unhook, value: PdWait, ids: ids))
	emitNetpollStepWaiters(module, block: unhook, delta: -1, ids: ids)
	module.setTerminator(unhook, op: StdOp.branch(walkNext.id))
	emitNetpollGroupWalkEnd(module, next: walkNext, hdr: walkHdr, index: walk.index, ids: ids)

	module.setTerminator(doneBlock, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildNetpollGroupUnhook'

// `__np_pd_commit`'s group arm: publish this thread into every member, or ready it when the mark it left is no
// longer on all of them — which is `__np_pd_commit`'s own resume-now case, asked of several words.
function emitNetpollCommitGroup(module StdModule, func IrFunction, cur IrBlock, gt ValueId, resumeNow IrBlock, parked IrBlock, ids ValueMinter)
	var testHdr = module.addBlock(func, label: b"npcghdr", heat: BlockHeat.normal)
	var testBody = module.addBlock(func, label: b"npcgbody", heat: BlockHeat.normal)
	var testAct = module.addBlock(func, label: b"npcgact", heat: BlockHeat.normal)
	var testNext = module.addBlock(func, label: b"npcgnext", heat: BlockHeat.normal)
	var publishPre = module.addBlock(func, label: b"npcgpubpre", heat: BlockHeat.normal)
	var publishHdr = module.addBlock(func, label: b"npcgpubhdr", heat: BlockHeat.normal)
	var publishBody = module.addBlock(func, label: b"npcgpubbody", heat: BlockHeat.normal)
	var publishAct = module.addBlock(func, label: b"npcgpubact", heat: BlockHeat.normal)
	var deadlineTest = module.addBlock(func, label: b"npcgdl", heat: BlockHeat.normal)
	var armDeadline = module.addBlock(func, label: b"npcgarm", heat: BlockHeat.normal)

	let group = emitLoadField(module, block: cur, record: gt, offset: GtOffParkArg, ids: ids)
	let count = emitLoadField(module, block: cur, record: group, offset: GroupOffCount, ids: ids)

	// Each member is asked against its begin generation (`GroupSlotGen`); one mark that no longer stands takes
	// `resumeNow`, whose wake the caller already pays for.
	let test = emitNetpollGroupWalk(module, func: func, pre: cur, hdr: testHdr, body: testBody, act: testAct, exhausted: publishPre, group: group, count: count, ids: ids)
	let ourMark = emitPdMarkStands(module, block: testAct, gpp: test.member.gpp, pd: test.member.pd, markedGen: emitNetpollMemberBeganGen(module, block: testAct, member: test.member, ids: ids), ids: ids)
	module.setTerminator(testAct, op: StdOp.condBranch(ourMark, thenBlockId: testNext.id, elseBlockId: resumeNow.id))
	emitNetpollGroupWalkEnd(module, next: testNext, hdr: testHdr, index: test.index, ids: ids)

	emitStoreField(module, block: publishPre, record: gt, offset: GtOffStatus, value: emitConst(module, block: publishPre, value: GtStatusWaiting, ids: ids))
	emitSchedCountNetpollBlock(module, block: publishPre, ids: ids)
	let publish = emitNetpollGroupWalk(module, func: func, pre: publishPre, hdr: publishHdr, body: publishBody, act: publishAct, exhausted: deadlineTest, group: group, count: count, ids: ids)
	emitStoreField(module, block: publishAct, record: publish.member.gpp, offset: 0, value: gt)
	emitNetpollStepWaiters(module, block: publishAct, delta: 1, ids: ids)
	emitNetpollGroupWalkEnd(module, next: publishAct, hdr: publishHdr, index: publish.index, ids: ids)

	// The deadline rides the scheduler's own timer heap, exactly as a single source's does — which is what lets
	// the caller's own clock keep running while it waits on sources that may never fire.
	let deadline = emitLoadField(module, block: deadlineTest, record: group, offset: GroupOffDeadline, ids: ids)
	let armed = emitCmp(module, block: deadlineTest, a: deadline, b: emitConst(module, block: deadlineTest, value: 0, ids: ids), pred: StdCmpPred.ne, ids: ids)
	module.setTerminator(deadlineTest, op: StdOp.condBranch(armed, thenBlockId: armDeadline.id, elseBlockId: parked.id))
	module.appendOp(armDeadline, op: StdOp.call(ids.mint(), callee: GtTimerAddName, args: threeArgs(gt, second: deadline, third: emitNetpollGroupTimerTag(module, block: armDeadline, ids: ids))))
	module.setTerminator(armDeadline, op: StdOp.branch(parked.id))
end 'emitNetpollCommitGroup'
