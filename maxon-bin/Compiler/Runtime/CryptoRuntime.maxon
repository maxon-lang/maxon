export let AesExpandKeyChunkName = b"mrt_aes_expand_key"
export let AesEncryptBlockChunkName = b"mrt_aes_encrypt_block"
export let AesDecryptBlockChunkName = b"mrt_aes_decrypt_block"
let AesCtrBlocks1ChunkName = b"mrt_aes_ctr_blocks_1"
let AesCtrBlocks2ChunkName = b"mrt_aes_ctr_blocks_2"
let AesCtrBlocks4ChunkName = b"mrt_aes_ctr_blocks_4"
let AesCtrBlocks8ChunkName = b"mrt_aes_ctr_blocks_8"
let AesGcmInitChunkName = b"mrt_aes_gcm_init"
let AesGcmHashChunkName = b"mrt_aes_gcm_hash"
let AesGcmEncryptChunkName = b"mrt_aes_gcm_encrypt"
let AesGcmDecryptChunkName = b"mrt_aes_gcm_decrypt"
let AesGcmFinishChunkName = b"mrt_aes_gcm_finish"

let AesCipherRuntimeCallPrefix = b"__cpufeat_aes_cipher_"
let AesCipherExpandKeyName = b"__cpufeat_aes_cipher_expand_key"
let AesCipherEncryptBlockName = b"__cpufeat_aes_cipher_encrypt_block"
let AesCipherDecryptBlockName = b"__cpufeat_aes_cipher_decrypt_block"
let AesCipherCtrXorName = b"__cpufeat_aes_cipher_ctr_xor"
let AesCipherGcmInitName = b"__cpufeat_aes_cipher_gcm_init"
let AesCipherGcmSealName = b"__cpufeat_aes_cipher_gcm_seal"
let AesCipherGcmOpenName = b"__cpufeat_aes_cipher_gcm_open"

export typealias AesCtrGroupBlocks = int(1 to 8)

export let AesCtrGroupCount = 4

export let AesBlockBytes = 16
export let AesRoundPairBytes = 2 * AesBlockBytes
let AesShortKeyBytes = 16
let AesLongKeyBytes = 32
let AesKeyAlignmentMask = 7
let AesKeyWordShift = 2
export let AesRoundsOverKeyWords = 6
export let AesShortRounds = 10
export let AesLongRounds = 14
export let AesMediumRounds = 12
export let AesFullRoundsBeforeLast = AesShortRounds - 1

// A schedule holds the encryption round keys followed by the decryption round keys, 16 bytes each per
// round. `stdlib/helpers/crypto/AesHardware.maxon` sizes its array to the same figure.
let AesScheduleBytesPerRound = 32
let AesScheduleRoundShift = 5
let AesScheduleHalfShift = 1
let AesRoundKeysOverRounds = 1
let AesScheduleMinBytes = (AesShortRounds + 1) * AesScheduleBytesPerRound
let AesScheduleMaxBytes = (AesLongRounds + 1) * AesScheduleBytesPerRound
let AesScheduleStepMask = 2 * AesScheduleBytesPerRound - 1
let AesScheduleStepResidue = AesScheduleBytesPerRound
export let AesFirstRoundConstant = 1
let AesByteLimit = 0xFF
let AesFieldReduction = 0x11B
let AesExpandKeyParams = 2
let AesBlockParams = 5
let AesCtrParams = 6
let AesGcmInitParams = 2
let AesGcmPassParams = 6

// A `cryptoRoutine` passes four arguments, so the counter offset of a counter-mode call and the length of
// a Galois-mode encrypt or decrypt call ride in the first one, above the round count in the low byte.
export let AesControlFieldShift = 8
export let AesControlRoundsMask = 0xFF

export let AesGcmTableBytes = 256

// The frame block of one message ends with the source pointer at `AesGcmSourceOffset`; a field
// placed past this size lies outside the frame the call reserves.
let AesGcmMessageBytes = 56
export let AesGcmCounterOffset = 16
export let AesGcmMaskOffset = 32
export let AesGcmSourceOffset = 48
let AesGcmTagBytes = 16
let AesGcmNonceBytes = 12
let AesGcmMaxMessageBytes = (u32.max - 1) * AesBlockBytes
let AesGcmMessageScratchSlot = 0 as SpillSlot
let AesGcmNonceTailOffset = AesGcmNonceBytes - (MachineWordBytes as FullRangeInt)
let AesGcmCounterWordOffset = AesGcmCounterOffset + AesCtrCounterWordOffset
let AesGcmFirstCounterWord = 0x01000000
let AesGcmWordShift = 3
let AesGcmKeyBlockMinBytes = AesGcmTableBytes + (AesShortRounds + 1) * AesBlockBytes
let AesGcmKeyBlockMaxBytes = AesGcmTableBytes + (AesLongRounds + 1) * AesBlockBytes
let AesGcmKeyBlockStepMask = 2 * AesBlockBytes - 1
let AesGcmKeyBlockStepResidue = AesBlockBytes
export let AesBlockShift = 4

// The counter is the last word of the counter block, big-endian, and wraps modulo 2^32 inside it
// without carrying into the nonce (GCM's inc32). The stdlib refuses a stream that would wrap before it
// calls.
export let AesCtrCounterWordBytes = 4
export let AesCtrCounterWordOffset = AesBlockBytes - AesCtrCounterWordBytes
export let AesCtrCounterLane = 3

export function nextAesRoundConstant(current MachineWord) returns MachineWord
	let doubled = current shl 1

	return (doubled xor AesFieldReduction) if doubled > AesByteLimit else doubled
end 'nextAesRoundConstant'

export enum AesCipherIntrinsic
	expandKey
	encryptBlock
	decryptBlock
	ctrXor
	gcmInit
	gcmSeal
	gcmOpen
end 'AesCipherIntrinsic'

// Every AES intrinsic writes its first operand and no other, so write-blame is noted for that one.
export let AesWrittenOperandPosition = 0
let AesBlockOutputAtPosition = 1
let AesBlockInputAtPosition = 4
let AesCtrBufferAtPosition = 1
let AesCtrCounterOffsetPosition = 4
let AesCtrBlocksPosition = 5
let AesGcmPassOutputAtPosition = 1

export let AesCipherBufferRequirement = "ByteArray"

function aesCipherIntrinsicName(intrinsic AesCipherIntrinsic) returns ByteArray
	return match intrinsic 'intrinsic'
		expandKey gives b"__Builtins.aesExpandKey"
		encryptBlock gives b"__Builtins.aesEncryptBlock"
		decryptBlock gives b"__Builtins.aesDecryptBlock"
		ctrXor gives b"__Builtins.aesCtrXor"
		gcmInit gives b"__Builtins.aesGcmInit"
		gcmSeal gives b"__Builtins.aesGcmSeal"
		gcmOpen gives b"__Builtins.aesGcmOpen"
	end 'intrinsic'
end 'aesCipherIntrinsicName'

export function aesCipherIntrinsicNamed(callee ByteArray) returns AesCipherIntrinsic throws AbsentError
	for intrinsic in AesCipherIntrinsic.allCases 'eachIntrinsic'
		if callee.equals(aesCipherIntrinsicName(intrinsic)) 'named'
			return intrinsic
		end 'named'
	end 'eachIntrinsic'

	throw AbsentError.absent
end 'aesCipherIntrinsicNamed'

export function isAesCipherIntrinsic(callee ByteArray) returns bool
	let intrinsic = try aesCipherIntrinsicNamed(callee) otherwise return false
	return callee.equals(aesCipherIntrinsicName(intrinsic))
end 'isAesCipherIntrinsic'

export function aesCipherRuntimeName(intrinsic AesCipherIntrinsic) returns ByteArray
	return match intrinsic 'intrinsic'
		expandKey gives AesCipherExpandKeyName
		encryptBlock gives AesCipherEncryptBlockName
		decryptBlock gives AesCipherDecryptBlockName
		ctrXor gives AesCipherCtrXorName
		gcmInit gives AesCipherGcmInitName
		gcmSeal gives AesCipherGcmSealName
		gcmOpen gives AesCipherGcmOpenName
	end 'intrinsic'
end 'aesCipherRuntimeName'

export function aesCipherArity(intrinsic AesCipherIntrinsic) returns ParamCount
	return match intrinsic 'intrinsic'
		expandKey gives AesExpandKeyParams
		encryptBlock or
		decryptBlock gives AesBlockParams
		ctrXor gives AesCtrParams
		gcmInit gives AesGcmInitParams
		gcmSeal or
		gcmOpen gives AesGcmPassParams
	end 'intrinsic'
end 'aesCipherArity'

export function aesCipherAnswersVerdict(intrinsic AesCipherIntrinsic) returns bool
	return match intrinsic 'intrinsic'
		gcmOpen gives true
		expandKey or
		encryptBlock or
		decryptBlock or
		ctrXor or
		gcmInit or
		gcmSeal gives false
	end 'intrinsic'
end 'aesCipherAnswersVerdict'

export function aesCipherOperandIsOffset(intrinsic AesCipherIntrinsic, index ParamCount) returns bool
	return match intrinsic 'intrinsic'
		expandKey or
		gcmInit gives false
		encryptBlock or
		decryptBlock gives index == AesBlockOutputAtPosition or index == AesBlockInputAtPosition
		ctrXor gives index == AesCtrBufferAtPosition or index == AesCtrCounterOffsetPosition or index == AesCtrBlocksPosition
		gcmSeal or
		gcmOpen gives index == AesGcmPassOutputAtPosition
	end 'intrinsic'
end 'aesCipherOperandIsOffset'

export function isHardwareAesRuntimeCallee(callee ByteArray) returns bool
	if not bytesStartWith(callee, prefix: AesCipherRuntimeCallPrefix) 'notInTheFamily'
		return false
	end 'notInTheFamily'

	for intrinsic in AesCipherIntrinsic.allCases 'eachIntrinsic'
		if callee.equals(aesCipherRuntimeName(intrinsic)) 'named'
			return true
		end 'named'
	end 'eachIntrinsic'

	return false
end 'isHardwareAesRuntimeCallee'

export function cryptoChunkName(routine CryptoRoutine) returns ByteArray
	return match routine 'routine'
		aesExpandKey gives AesExpandKeyChunkName
		aesEncryptBlock gives AesEncryptBlockChunkName
		aesDecryptBlock gives AesDecryptBlockChunkName
		aesCtrBlocks1 gives AesCtrBlocks1ChunkName
		aesCtrBlocks2 gives AesCtrBlocks2ChunkName
		aesCtrBlocks4 gives AesCtrBlocks4ChunkName
		aesCtrBlocks8 gives AesCtrBlocks8ChunkName
		aesGcmInit gives AesGcmInitChunkName
		aesGcmHash gives AesGcmHashChunkName
		aesGcmEncrypt gives AesGcmEncryptChunkName
		aesGcmDecrypt gives AesGcmDecryptChunkName
		aesGcmFinish gives AesGcmFinishChunkName
	end 'routine'
end 'cryptoChunkName'

export function aesCtrGroupBlocks(exponent FullRangeInt) returns AesCtrGroupBlocks
	return (1 shl exponent) as AesCtrGroupBlocks
end 'aesCtrGroupBlocks'

export function aesCtrRoutine(blocks AesCtrGroupBlocks) returns CryptoRoutine
	match blocks 'blocks'
		1 then return CryptoRoutine.aesCtrBlocks1
		2 then return CryptoRoutine.aesCtrBlocks2
		4 then return CryptoRoutine.aesCtrBlocks4
		8 then return CryptoRoutine.aesCtrBlocks8
		default panic("aesCtrRoutine: {blocks} is not a counter-mode group size; the sizes are 1, 2, 4 and 8")
	end 'blocks'
end 'aesCtrRoutine'

export function hardwareAesChunksAreEmitted(usage RuntimeUsage, target Target) returns bool
	return usage.usesHardwareAes and (target.cpu == CpuArch.x64 or target.cpu == CpuArch.arm64)
end 'hardwareAesChunksAreEmitted'

// The `mrt_aes_*` chunks check nothing: they read and write blocks, the bytes of a partial last block
// and round keys through the pointers they are given. These entries are the only bounds check, so every
// `cryptoRoutine` must be reached through one.
export function installCryptoRuntime(module StdModule, usage RuntimeUsage)
	if not usage.usesHardwareAes 'notAsked'
		return
	end 'notAsked'

	buildAesExpandKey(module)
	buildAesBlockRoutine(module, name: AesCipherEncryptBlockName, routine: CryptoRoutine.aesEncryptBlock)
	buildAesBlockRoutine(module, name: AesCipherDecryptBlockName, routine: CryptoRoutine.aesDecryptBlock)
	buildAesCtrXor(module)
	buildAesGcmInit(module)
	buildAesGcmPass(module, opening: false)
	buildAesGcmPass(module, opening: true)
end 'installCryptoRuntime'

enum AesSizedBuffer
	schedule
	keyBlock
end 'AesSizedBuffer'

type AesSizeLimits
	let prefix as String
	let minBytes as FullRangeInt
	let maxBytes as FullRangeInt
	let stepMask as FullRangeInt
	let stepResidue as FullRangeInt

	static function of(buffer AesSizedBuffer) returns AesSizeLimits
		return match buffer 'buffer'
			schedule gives Self{prefix: "sc", minBytes: AesScheduleMinBytes, maxBytes: AesScheduleMaxBytes, stepMask: AesScheduleStepMask, stepResidue: AesScheduleStepResidue}
			keyBlock gives Self{prefix: "kb", minBytes: AesGcmKeyBlockMinBytes, maxBytes: AesGcmKeyBlockMaxBytes, stepMask: AesGcmKeyBlockStepMask, stepResidue: AesGcmKeyBlockStepResidue}
		end 'buffer'
	end 'of'

	function emitGuards(module StdModule, func IrFunction, entry IrBlock, bytes ValueId, refused IrBlock, next IrBlock, ids ValueMinter)
		var bounded = module.addBlock(func, label: "{self.prefix}bounded".toByteArray(), heat: BlockHeat.normal)
		var stepped = module.addBlock(func, label: "{self.prefix}stepped".toByteArray(), heat: BlockHeat.normal)

		emitBranchOnCompare(module, block: entry, value: bytes, pred: StdCmpPred.lt, against: self.minBytes, whenTrue: refused, whenFalse: bounded, ids: ids)
		emitBranchOnCompare(module, block: bounded, value: bytes, pred: StdCmpPred.gt, against: self.maxBytes, whenTrue: refused, whenFalse: stepped, ids: ids)

		let step = emitBin(module, block: stepped, a: bytes, b: emitConst(module, block: stepped, value: self.stepMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
		emitBranchOnCompare(module, block: stepped, value: step, pred: StdCmpPred.ne, against: self.stepResidue, whenTrue: refused, whenFalse: next, ids: ids)
	end 'emitGuards'
end 'AesSizeLimits'

function emitLengthSpanGuards(module StdModule, func IrFunction, entry IrBlock, next IrBlock, refused IrBlock, arr ValueId, at ValueId, length ValueId, prefix String, ids ValueMinter)
	var inside = module.addBlock(func, label: "{prefix}inside".toByteArray(), heat: BlockHeat.normal)

	let bytes = emitLoadField(module, block: entry, record: arr, offset: ManagedRecordLengthOffset, ids: ids)
	emitBranchOnCompareValues(module, block: entry, a: at, pred: StdCmpPred.gt, b: bytes, whenTrue: refused, whenFalse: inside, ids: ids, operandType: StdType.u64)

	let remaining = emitBin(module, block: inside, a: bytes, b: at, opcode: StdBinOpcode.sub, ids: ids)
	emitBranchOnCompareValues(module, block: inside, a: remaining, pred: StdCmpPred.lt, b: length, whenTrue: refused, whenFalse: next, ids: ids, operandType: StdType.u64)
end 'emitLengthSpanGuards'

function emitRoundCount(module StdModule, block IrBlock, roundKeyBytes ValueId, shift FullRangeInt, ids ValueMinter) returns ValueId
	let roundKeys = emitBin(module, block: block, a: roundKeyBytes, b: emitConst(module, block: block, value: shift, ids: ids), opcode: StdBinOpcode.shrLogical, ids: ids)

	return emitBin(module, block: block, a: roundKeys, b: emitConst(module, block: block, value: AesRoundKeysOverRounds, ids: ids), opcode: StdBinOpcode.sub, ids: ids)
end 'emitRoundCount'

function emitGcmRounds(module StdModule, block IrBlock, keyBlockBytes ValueId, ids ValueMinter) returns ValueId
	let roundKeyBytes = emitBin(module, block: block, a: keyBlockBytes, b: emitConst(module, block: block, value: AesGcmTableBytes, ids: ids), opcode: StdBinOpcode.sub, ids: ids)

	return emitRoundCount(module, block: block, roundKeyBytes: roundKeyBytes, shift: AesBlockShift, ids: ids)
end 'emitGcmRounds'

function buildAesExpandKey(module StdModule)
	var func = IrFunction.createFromStd(AesCipherExpandKeyName, returnType: StdReturnType.void, paramCount: AesExpandKeyParams, paramTypes: twoI64Params())
	var ids = ValueMinter.create(AesExpandKeyParams)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var bounded = module.addBlock(func, label: b"akbounded", heat: BlockHeat.normal)
	var aligned = module.addBlock(func, label: b"akaligned", heat: BlockHeat.normal)
	var sized = module.addBlock(func, label: b"aksized", heat: BlockHeat.normal)
	var expand = module.addBlock(func, label: b"akexpand", heat: BlockHeat.normal)
	var bad = module.addBlock(func, label: b"akbad", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: AesExpandKeyParams)
	let schedule = 0
	let key = 1

	let keyBytes = emitLoadField(module, block: entry, record: key, offset: ManagedRecordLengthOffset, ids: ids)
	emitBranchOnCompare(module, block: entry, value: keyBytes, pred: StdCmpPred.lt, against: AesShortKeyBytes, whenTrue: bad, whenFalse: bounded, ids: ids)
	emitBranchOnCompare(module, block: bounded, value: keyBytes, pred: StdCmpPred.gt, against: AesLongKeyBytes, whenTrue: bad, whenFalse: aligned, ids: ids)

	let keyRemainder = emitBin(module, block: aligned, a: keyBytes, b: emitConst(module, block: aligned, value: AesKeyAlignmentMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	emitBranchOnCompare(module, block: aligned, value: keyRemainder, pred: StdCmpPred.ne, against: 0, whenTrue: bad, whenFalse: sized, ids: ids)

	let keyWords = emitBin(module, block: sized, a: keyBytes, b: emitConst(module, block: sized, value: AesKeyWordShift, ids: ids), opcode: StdBinOpcode.shrLogical, ids: ids)
	let rounds = emitBin(module, block: sized, a: keyWords, b: emitConst(module, block: sized, value: AesRoundsOverKeyWords, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	let scheduleBytes = emitLoadField(module, block: sized, record: schedule, offset: ManagedRecordLengthOffset, ids: ids)
	let roundKeys = emitBin(module, block: sized, a: rounds, b: emitConst(module, block: sized, value: 1, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	let expected = emitBin(module, block: sized, a: roundKeys, b: emitConst(module, block: sized, value: AesScheduleRoundShift, ids: ids), opcode: StdBinOpcode.shl, ids: ids)
	emitBranchOnCompareValues(module, block: sized, a: scheduleBytes, pred: StdCmpPred.ne, b: expected, whenTrue: bad, whenFalse: expand, ids: ids)

	expand = emitCowDetachWhenNeeded(module, func: func, block: expand, arr: schedule, prefix: "ak", ids: ids)
	let encryptionKeys = emitLoadField(module, block: expand, record: schedule, offset: ManagedRecordBufferOffset, ids: ids)
	let keyData = emitLoadField(module, block: expand, record: key, offset: ManagedRecordBufferOffset, ids: ids)
	let decryptionKeys = emitDecryptionKeys(module, block: expand, scheduleBytes: scheduleBytes, encryptionKeys: encryptionKeys, ids: ids)
	let answer = ids.mint()
	module.appendOp(expand, op: StdOp.cryptoRoutine(answer, routine: CryptoRoutine.aesExpandKey, a0Id: rounds, a1Id: keyData, a2Id: encryptionKeys, a3Id: decryptionKeys))
	module.setTerminator(expand, op: StdOp.retVoid)

	emitRuntimeFatal(module, func: func, block: bad, fatal: RuntimeFatal.cryptoBufferOutOfRange, ids: ids)

	module.functions.push(func)
end 'buildAesExpandKey'

function emitHalfSchedule(module StdModule, block IrBlock, scheduleBytes ValueId, ids ValueMinter) returns ValueId
	return emitBin(module, block: block, a: scheduleBytes, b: emitConst(module, block: block, value: AesScheduleHalfShift, ids: ids), opcode: StdBinOpcode.shrLogical, ids: ids)
end 'emitHalfSchedule'

function emitDecryptionKeys(module StdModule, block IrBlock, scheduleBytes ValueId, encryptionKeys ValueId, ids ValueMinter) returns ValueId
	let halfBytes = emitHalfSchedule(module, block: block, scheduleBytes: scheduleBytes, ids: ids)

	return emitBin(module, block: block, a: encryptionKeys, b: halfBytes, opcode: StdBinOpcode.add, ids: ids)
end 'emitDecryptionKeys'

function buildAesBlockRoutine(module StdModule, name ByteArray, routine CryptoRoutine)
	var func = IrFunction.createFromStd(name, returnType: StdReturnType.void, paramCount: AesBlockParams, paramTypes: fiveI64Params())
	var ids = ValueMinter.create(AesBlockParams)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var crypt = module.addBlock(func, label: b"abcrypt", heat: BlockHeat.normal)
	var bad = module.addBlock(func, label: b"abbad", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: AesBlockParams)
	let output = 0
	let outputAt = 1
	let schedule = 2
	let input = 3
	let inputAt = 4

	let scheduleBytes = emitLoadField(module, block: entry, record: schedule, offset: ManagedRecordLengthOffset, ids: ids)
	var outputSpan = module.addBlock(func, label: b"aboutput", heat: BlockHeat.normal)
	AesSizeLimits.of(AesSizedBuffer.schedule).emitGuards(module, func: func, entry: entry, bytes: scheduleBytes, refused: bad, next: outputSpan, ids: ids)

	var inputSpan = module.addBlock(func, label: b"abinput", heat: BlockHeat.normal)
	var outputInside = module.addBlock(func, label: b"abo", heat: BlockHeat.normal)
	emitSpanGuards(module, entry: outputSpan, inside: outputInside, next: inputSpan, refused: bad, arr: output, at: outputAt, byteCount: AesBlockBytes, ids: ids)
	var inputInside = module.addBlock(func, label: b"abi", heat: BlockHeat.normal)
	emitSpanGuards(module, entry: inputSpan, inside: inputInside, next: crypt, refused: bad, arr: input, at: inputAt, byteCount: AesBlockBytes, ids: ids)

	// The detach comes first so the data pointers below are read after it: an output that shares its
	// buffer would otherwise be written in place, and an input that is the output sees the new buffer.
	crypt = emitCowDetachWhenNeeded(module, func: func, block: crypt, arr: output, prefix: "ab", ids: ids)
	let rounds = emitRoundCount(module, block: crypt, roundKeyBytes: scheduleBytes, shift: AesScheduleRoundShift, ids: ids)
	let scheduleData = emitLoadField(module, block: crypt, record: schedule, offset: ManagedRecordBufferOffset, ids: ids)
	let keys = match routine 'keysOfTheRoutine'
		aesEncryptBlock gives scheduleData
		aesDecryptBlock gives emitDecryptionKeys(module, block: crypt, scheduleBytes: scheduleBytes, encryptionKeys: scheduleData, ids: ids)
		default panic("buildAesBlockRoutine: only the encrypt and decrypt routines are single AES blocks")
	end 'keysOfTheRoutine'

	let outputData = emitLoadField(module, block: crypt, record: output, offset: ManagedRecordBufferOffset, ids: ids)
	let inputData = emitLoadField(module, block: crypt, record: input, offset: ManagedRecordBufferOffset, ids: ids)
	let destination = emitBin(module, block: crypt, a: outputData, b: outputAt, opcode: StdBinOpcode.add, ids: ids)
	let source = emitBin(module, block: crypt, a: inputData, b: inputAt, opcode: StdBinOpcode.add, ids: ids)
	let answer = ids.mint()
	module.appendOp(crypt, op: StdOp.cryptoRoutine(answer, routine: routine, a0Id: rounds, a1Id: keys, a2Id: destination, a3Id: source))
	module.setTerminator(crypt, op: StdOp.retVoid)

	emitRuntimeFatal(module, func: func, block: bad, fatal: RuntimeFatal.cryptoBufferOutOfRange, ids: ids)

	module.functions.push(func)
end 'buildAesBlockRoutine'

function buildAesCtrXor(module StdModule)
	var func = IrFunction.createFromStd(AesCipherCtrXorName, returnType: StdReturnType.void, paramCount: AesCtrParams, paramTypes: sixI64Params())
	var ids = ValueMinter.create(AesCtrParams)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var counterCheck = module.addBlock(func, label: b"cxcounter", heat: BlockHeat.normal)
	var dispatch = module.addBlock(func, label: b"cxdispatch", heat: BlockHeat.normal)
	var bad = module.addBlock(func, label: b"cxbad", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: AesCtrParams)
	let buffer = 0
	let bufferAt = 1
	let schedule = 2
	let counterBlock = 3
	let counterOffset = 4
	let blocks = 5

	let scheduleBytes = emitLoadField(module, block: entry, record: schedule, offset: ManagedRecordLengthOffset, ids: ids)
	AesSizeLimits.of(AesSizedBuffer.schedule).emitGuards(module, func: func, entry: entry, bytes: scheduleBytes, refused: bad, next: counterCheck, ids: ids)

	let counterBytes = emitLoadField(module, block: counterCheck, record: counterBlock, offset: ManagedRecordLengthOffset, ids: ids)
	emitBranchOnCompare(module, block: counterCheck, value: counterBytes, pred: StdCmpPred.ne, against: AesBlockBytes, whenTrue: bad, whenFalse: dispatch, ids: ids)

	var probe = dispatch

	for exponent in 0 upto AesCtrGroupCount - 1 'eachProbedGroup'
		let group = aesCtrGroupBlocks(exponent)
		var arm = module.addBlock(func, label: "cxarm{group}".toByteArray(), heat: BlockHeat.normal)
		var unmatched = module.addBlock(func, label: "cxprobe{group}".toByteArray(), heat: BlockHeat.normal)

		emitBranchOnCompare(module, block: probe, value: blocks, pred: StdCmpPred.eq, against: group as FullRangeInt, whenTrue: arm, whenFalse: unmatched, ids: ids)
		buildAesCtrArm(module, func: func, arm: arm, group: group, buffer: buffer, bufferAt: bufferAt, schedule: schedule, scheduleBytes: scheduleBytes, counterBlock: counterBlock, counterOffset: counterOffset, refused: bad, ids: ids)
		probe = unmatched
	end 'eachProbedGroup'

	let widest = aesCtrGroupBlocks(AesCtrGroupCount - 1)
	var widestArm = module.addBlock(func, label: "cxarm{widest}".toByteArray(), heat: BlockHeat.normal)
	emitBranchOnCompare(module, block: probe, value: blocks, pred: StdCmpPred.eq, against: widest as FullRangeInt, whenTrue: widestArm, whenFalse: bad, ids: ids)
	buildAesCtrArm(module, func: func, arm: widestArm, group: widest, buffer: buffer, bufferAt: bufferAt, schedule: schedule, scheduleBytes: scheduleBytes, counterBlock: counterBlock, counterOffset: counterOffset, refused: bad, ids: ids)

	emitRuntimeFatal(module, func: func, block: bad, fatal: RuntimeFatal.cryptoBufferOutOfRange, ids: ids)

	module.functions.push(func)
end 'buildAesCtrXor'

function buildAesCtrArm(module StdModule, func IrFunction, arm IrBlock, group AesCtrGroupBlocks, buffer ValueId, bufferAt ValueId, schedule ValueId, scheduleBytes ValueId, counterBlock ValueId, counterOffset ValueId, refused IrBlock, ids ValueMinter)
	var inside = module.addBlock(func, label: "cxspan{group}".toByteArray(), heat: BlockHeat.normal)
	var crypt = module.addBlock(func, label: "cxcrypt{group}".toByteArray(), heat: BlockHeat.normal)
	emitSpanGuards(module, entry: arm, inside: inside, next: crypt, refused: refused, arr: buffer, at: bufferAt, byteCount: (group as FullRangeInt) * AesBlockBytes, ids: ids)

	crypt = emitCowDetachWhenNeeded(module, func: func, block: crypt, arr: buffer, prefix: "cx{group}", ids: ids)
	let rounds = emitRoundCount(module, block: crypt, roundKeyBytes: scheduleBytes, shift: AesScheduleRoundShift, ids: ids)
	let shiftedOffset = emitBin(module, block: crypt, a: counterOffset, b: emitConst(module, block: crypt, value: AesControlFieldShift, ids: ids), opcode: StdBinOpcode.shl, ids: ids)
	let control = emitBin(module, block: crypt, a: shiftedOffset, b: rounds, opcode: StdBinOpcode.bitOr, ids: ids)
	let scheduleData = emitLoadField(module, block: crypt, record: schedule, offset: ManagedRecordBufferOffset, ids: ids)
	let counterData = emitLoadField(module, block: crypt, record: counterBlock, offset: ManagedRecordBufferOffset, ids: ids)
	let bufferData = emitLoadField(module, block: crypt, record: buffer, offset: ManagedRecordBufferOffset, ids: ids)
	let destination = emitBin(module, block: crypt, a: bufferData, b: bufferAt, opcode: StdBinOpcode.add, ids: ids)
	let answer = ids.mint()
	module.appendOp(crypt, op: StdOp.cryptoRoutine(answer, routine: aesCtrRoutine(group), a0Id: control, a1Id: scheduleData, a2Id: counterData, a3Id: destination))
	module.setTerminator(crypt, op: StdOp.retVoid)
end 'buildAesCtrArm'

function buildAesGcmInit(module StdModule)
	var func = IrFunction.createFromStd(AesCipherGcmInitName, returnType: StdReturnType.void, paramCount: AesGcmInitParams, paramTypes: twoI64Params())
	var ids = ValueMinter.create(AesGcmInitParams)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var keyBlockCheck = module.addBlock(func, label: b"gikeyblock", heat: BlockHeat.normal)
	var crypt = module.addBlock(func, label: b"gicrypt", heat: BlockHeat.normal)
	var bad = module.addBlock(func, label: b"gibad", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: AesGcmInitParams)
	let keyBlock = 0
	let schedule = 1

	let scheduleBytes = emitLoadField(module, block: entry, record: schedule, offset: ManagedRecordLengthOffset, ids: ids)
	AesSizeLimits.of(AesSizedBuffer.schedule).emitGuards(module, func: func, entry: entry, bytes: scheduleBytes, refused: bad, next: keyBlockCheck, ids: ids)

	let keyBlockBytes = emitLoadField(module, block: keyBlockCheck, record: keyBlock, offset: ManagedRecordLengthOffset, ids: ids)
	let roundKeyBytes = emitHalfSchedule(module, block: keyBlockCheck, scheduleBytes: scheduleBytes, ids: ids)
	let expected = emitBin(module, block: keyBlockCheck, a: roundKeyBytes, b: emitConst(module, block: keyBlockCheck, value: AesGcmTableBytes, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	emitBranchOnCompareValues(module, block: keyBlockCheck, a: keyBlockBytes, pred: StdCmpPred.ne, b: expected, whenTrue: bad, whenFalse: crypt, ids: ids)

	crypt = emitCowDetachWhenNeeded(module, func: func, block: crypt, arr: keyBlock, prefix: "gi", ids: ids)
	let rounds = emitRoundCount(module, block: crypt, roundKeyBytes: scheduleBytes, shift: AesScheduleRoundShift, ids: ids)
	let keyData = emitLoadField(module, block: crypt, record: keyBlock, offset: ManagedRecordBufferOffset, ids: ids)
	let scheduleData = emitLoadField(module, block: crypt, record: schedule, offset: ManagedRecordBufferOffset, ids: ids)
	let unused = emitConst(module, block: crypt, value: 0, ids: ids)
	let answer = ids.mint()
	module.appendOp(crypt, op: StdOp.cryptoRoutine(answer, routine: CryptoRoutine.aesGcmInit, a0Id: rounds, a1Id: keyData, a2Id: scheduleData, a3Id: unused))
	module.setTerminator(crypt, op: StdOp.retVoid)

	emitRuntimeFatal(module, func: func, block: bad, fatal: RuntimeFatal.cryptoBufferOutOfRange, ids: ids)

	module.functions.push(func)
end 'buildAesGcmInit'

function emitChunkUnlessEmpty(module StdModule, func IrFunction, cur IrBlock, count ValueId, routine CryptoRoutine, a0 ValueId, a1 ValueId, a2 ValueId, a3 ValueId, prefix String, ids ValueMinter) returns IrBlock
	var run = module.addBlock(func, label: "{prefix}run".toByteArray(), heat: BlockHeat.normal)
	var joined = module.addBlock(func, label: "{prefix}done".toByteArray(), heat: BlockHeat.normal)

	emitBranchOnCompare(module, block: cur, value: count, pred: StdCmpPred.eq, against: 0, whenTrue: joined, whenFalse: run, ids: ids)
	module.appendOp(run, op: StdOp.cryptoRoutine(ids.mint(), routine: routine, a0Id: a0, a1Id: a1, a2Id: a2, a3Id: a3))
	module.setTerminator(run, op: StdOp.branch(joined.id))

	return joined
end 'emitChunkUnlessEmpty'

function emitClearGcmMessage(module StdModule, block IrBlock, message ValueId, ids ValueMinter)
	let zero = emitConst(module, block: block, value: 0, ids: ids)

	for word in 0 upto AesGcmMessageBytes shr AesGcmWordShift 'eachWord'
		emitStoreField(module, block: block, record: message, offset: (word * (MachineWordBytes as FullRangeInt)) as ByteOffset, value: zero)
	end 'eachWord'
end 'emitClearGcmMessage'

function emitGcmMessageStart(module StdModule, block IrBlock, message ValueId, nonceData ValueId, sourceData ValueId, ids ValueMinter)
	let zero = emitConst(module, block: block, value: 0, ids: ids)
	emitStoreField(module, block: block, record: message, offset: 0, value: zero)
	emitStoreField(module, block: block, record: message, offset: MachineWordBytes, value: zero)

	let nonceHead = emitLoadField(module, block: block, record: nonceData, offset: 0, ids: ids)
	let nonceTail = emitLoadField(module, block: block, record: nonceData, offset: AesGcmNonceTailOffset as ByteOffset, ids: ids)
	emitStoreField(module, block: block, record: message, offset: AesGcmCounterOffset, value: nonceHead)
	emitStoreField(module, block: block, record: message, offset: (AesGcmCounterOffset + AesGcmNonceTailOffset) as ByteOffset, value: nonceTail)
	emitStoreField(module, block: block, record: message, offset: AesGcmCounterWordOffset as ByteOffset, value: emitConst(module, block: block, value: AesGcmFirstCounterWord, ids: ids))
	emitStoreField(module, block: block, record: message, offset: AesGcmSourceOffset, value: sourceData)
end 'emitGcmMessageStart'

// Identical regions pass because each encrypt and decrypt chunk loads a run of blocks before it
// stores that run. Any other overlap would load bytes an earlier store replaced, so it is refused.
function emitGcmRegionsDoNotOverlap(module StdModule, func IrFunction, cur IrBlock, destination ValueId, destinationBytes ValueId, source ValueId, sourceBytes ValueId, refused IrBlock, next IrBlock, ids ValueMinter)
	var written = module.addBlock(func, label: b"gpwritten", heat: BlockHeat.normal)
	var apart = module.addBlock(func, label: b"gpapart", heat: BlockHeat.normal)
	var below = module.addBlock(func, label: b"gpbelow", heat: BlockHeat.normal)
	var above = module.addBlock(func, label: b"gpabove", heat: BlockHeat.normal)

	emitBranchOnCompare(module, block: cur, value: sourceBytes, pred: StdCmpPred.eq, against: 0, whenTrue: next, whenFalse: written, ids: ids)
	emitBranchOnCompare(module, block: written, value: destinationBytes, pred: StdCmpPred.eq, against: 0, whenTrue: next, whenFalse: apart, ids: ids)
	emitBranchOnCompareValues(module, block: apart, a: destination, pred: StdCmpPred.eq, b: source, whenTrue: next, whenFalse: below, ids: ids, operandType: StdType.u64)

	let destinationEnd = emitBin(module, block: below, a: destination, b: destinationBytes, opcode: StdBinOpcode.add, ids: ids)
	emitBranchOnCompareValues(module, block: below, a: destinationEnd, pred: StdCmpPred.le, b: source, whenTrue: next, whenFalse: above, ids: ids, operandType: StdType.u64)

	let sourceEnd = emitBin(module, block: above, a: source, b: sourceBytes, opcode: StdBinOpcode.add, ids: ids)
	emitBranchOnCompareValues(module, block: above, a: sourceEnd, pred: StdCmpPred.le, b: destination, whenTrue: next, whenFalse: refused, ids: ids, operandType: StdType.u64)
end 'emitGcmRegionsDoNotOverlap'

function buildAesGcmPass(module StdModule, opening bool)
	let name = AesCipherGcmOpenName if opening else AesCipherGcmSealName
	let returned = StdReturnType.value(builtinProtocolResultStdType(RequirementType.ofTag(ValueTypeTag.boolean))) if opening else StdReturnType.void
	var func = IrFunction.createFromStd(name, returnType: returned, paramCount: AesGcmPassParams, paramTypes: sixI64Params())
	var ids = ValueMinter.create(AesGcmPassParams)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var nonceCheck = module.addBlock(func, label: b"gpnonce", heat: BlockHeat.normal)
	var sourceCheck = module.addBlock(func, label: b"gpsource", heat: BlockHeat.normal)
	var measure = module.addBlock(func, label: b"gpmeasure", heat: BlockHeat.normal)
	var spanCheck = module.addBlock(func, label: b"gpspan", heat: BlockHeat.normal)
	var detach = module.addBlock(func, label: b"gpdetach", heat: BlockHeat.normal)
	var overlap = module.addBlock(func, label: b"gpoverlap", heat: BlockHeat.normal)
	var bad = module.addBlock(func, label: b"gpbad", heat: BlockHeat.cold)

	emitParams(module, block: entry, count: AesGcmPassParams)
	let output = 0
	let outputAt = 1
	let keyBlock = 2
	let nonce = 3
	let additionalData = 4
	let source = 5

	let keyBlockBytes = emitLoadField(module, block: entry, record: keyBlock, offset: ManagedRecordLengthOffset, ids: ids)
	AesSizeLimits.of(AesSizedBuffer.keyBlock).emitGuards(module, func: func, entry: entry, bytes: keyBlockBytes, refused: bad, next: nonceCheck, ids: ids)

	let nonceBytes = emitLoadField(module, block: nonceCheck, record: nonce, offset: ManagedRecordLengthOffset, ids: ids)
	emitBranchOnCompare(module, block: nonceCheck, value: nonceBytes, pred: StdCmpPred.ne, against: AesGcmNonceBytes, whenTrue: bad, whenFalse: sourceCheck, ids: ids)

	let sourceBytes = emitLoadField(module, block: sourceCheck, record: source, offset: ManagedRecordLengthOffset, ids: ids)

	if opening 'sealedSource'
		emitBranchOnCompare(module, block: sourceCheck, value: sourceBytes, pred: StdCmpPred.lt, against: AesGcmTagBytes, whenTrue: bad, whenFalse: measure, ids: ids)
	end 'sealedSource' else 'plainSource'
		module.setTerminator(sourceCheck, op: StdOp.branch(measure.id))
	end 'plainSource'

	var length = sourceBytes

	if opening 'subtractsTheTag'
		length = emitBin(module, block: measure, a: sourceBytes, b: emitConst(module, block: measure, value: AesGcmTagBytes, ids: ids), opcode: StdBinOpcode.sub, ids: ids)
	end 'subtractsTheTag'

	let longest = emitConst(module, block: measure, value: AesGcmMaxMessageBytes, ids: ids)
	emitBranchOnCompareValues(module, block: measure, a: length, pred: StdCmpPred.gt, b: longest, whenTrue: bad, whenFalse: spanCheck, ids: ids, operandType: StdType.u64)

	var outputBytes = length

	if not opening 'addsTheTag'
		outputBytes = emitBin(module, block: spanCheck, a: length, b: emitConst(module, block: spanCheck, value: AesGcmTagBytes, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	end 'addsTheTag'

	emitLengthSpanGuards(module, func: func, entry: spanCheck, next: detach, refused: bad, arr: output, at: outputAt, length: outputBytes, prefix: "gp", ids: ids)

	// Detaches before the data pointers below are read, for the reason `buildAesBlockRoutine` gives.
	var crypt = emitCowDetachWhenNeeded(module, func: func, block: detach, arr: output, prefix: "gp", ids: ids)
	func.stackSize = AesGcmMessageBytes

	let outputBase = emitLoadField(module, block: crypt, record: output, offset: ManagedRecordBufferOffset, ids: ids)
	let sourceBase = emitLoadField(module, block: crypt, record: source, offset: ManagedRecordBufferOffset, ids: ids)
	let region = emitBin(module, block: crypt, a: outputBase, b: outputAt, opcode: StdBinOpcode.add, ids: ids)
	emitGcmRegionsDoNotOverlap(module, func: func, cur: crypt, destination: region, destinationBytes: outputBytes, source: sourceBase, sourceBytes: sourceBytes, refused: bad, next: overlap, ids: ids)

	crypt = overlap
	let rounds = emitGcmRounds(module, block: crypt, keyBlockBytes: keyBlockBytes, ids: ids)
	let keyData = emitLoadField(module, block: crypt, record: keyBlock, offset: ManagedRecordBufferOffset, ids: ids)
	let nonceData = emitLoadField(module, block: crypt, record: nonce, offset: ManagedRecordBufferOffset, ids: ids)
	let additionalBase = emitLoadField(module, block: crypt, record: additionalData, offset: ManagedRecordBufferOffset, ids: ids)
	let additionalBytes = emitLoadField(module, block: crypt, record: additionalData, offset: ManagedRecordLengthOffset, ids: ids)

	let message = ids.mint()
	module.appendOp(crypt, op: StdOp.stackRecordAddr(message, slot: AesGcmMessageScratchSlot))
	emitGcmMessageStart(module, block: crypt, message: message, nonceData: nonceData, sourceData: sourceBase, ids: ids)

	let roundKeys = emitBin(module, block: crypt, a: keyData, b: emitConst(module, block: crypt, value: AesGcmTableBytes, ids: ids), opcode: StdBinOpcode.add, ids: ids)
	let counterBlock = emitFieldAddr(module, block: crypt, record: message, offset: AesGcmCounterOffset, ids: ids)
	let maskBlock = emitFieldAddr(module, block: crypt, record: message, offset: AesGcmMaskOffset, ids: ids)
	module.appendOp(crypt, op: StdOp.cryptoRoutine(ids.mint(), routine: CryptoRoutine.aesEncryptBlock, a0Id: rounds, a1Id: roundKeys, a2Id: maskBlock, a3Id: counterBlock))

	crypt = emitChunkUnlessEmpty(module, func: func, cur: crypt, count: additionalBytes, routine: CryptoRoutine.aesGcmHash, a0: additionalBytes, a1: keyData, a2: message, a3: additionalBase, prefix: "gh", ids: ids)

	let shiftedLength = emitBin(module, block: crypt, a: length, b: emitConst(module, block: crypt, value: AesControlFieldShift, ids: ids), opcode: StdBinOpcode.shl, ids: ids)
	let control = emitBin(module, block: crypt, a: shiftedLength, b: rounds, opcode: StdBinOpcode.bitOr, ids: ids)
	let routine = CryptoRoutine.aesGcmDecrypt if opening else CryptoRoutine.aesGcmEncrypt
	crypt = emitChunkUnlessEmpty(module, func: func, cur: crypt, count: length, routine: routine, a0: control, a1: keyData, a2: message, a3: region, prefix: "gc", ids: ids)

	module.appendOp(crypt, op: StdOp.cryptoRoutine(ids.mint(), routine: CryptoRoutine.aesGcmFinish, a0Id: additionalBytes, a1Id: keyData, a2Id: message, a3Id: length))

	let computedHigh = emitLoadField(module, block: crypt, record: message, offset: 0, ids: ids)
	let computedLow = emitLoadField(module, block: crypt, record: message, offset: MachineWordBytes, ids: ids)

	if not opening 'sealing'
		let tag = emitBin(module, block: crypt, a: region, b: length, opcode: StdBinOpcode.add, ids: ids)
		emitStoreField(module, block: crypt, record: tag, offset: 0, value: computedHigh)
		emitStoreField(module, block: crypt, record: tag, offset: MachineWordBytes, value: computedLow)
		emitClearGcmMessage(module, block: crypt, message: message, ids: ids)
		module.setTerminator(crypt, op: StdOp.retVoid)
	end 'sealing' else 'opening'
		var accepted = module.addBlock(func, label: b"gpaccepted", heat: BlockHeat.normal)
		var rejected = module.addBlock(func, label: b"gprejected", heat: BlockHeat.normal)
		let received = emitBin(module, block: crypt, a: sourceBase, b: length, opcode: StdBinOpcode.add, ids: ids)
		let receivedHigh = emitLoadField(module, block: crypt, record: received, offset: 0, ids: ids)
		let receivedLow = emitLoadField(module, block: crypt, record: received, offset: MachineWordBytes, ids: ids)
		let highDifference = emitBin(module, block: crypt, a: computedHigh, b: receivedHigh, opcode: StdBinOpcode.bitXor, ids: ids)
		let lowDifference = emitBin(module, block: crypt, a: computedLow, b: receivedLow, opcode: StdBinOpcode.bitXor, ids: ids)
		let difference = emitBin(module, block: crypt, a: highDifference, b: lowDifference, opcode: StdBinOpcode.bitOr, ids: ids)
		emitClearGcmMessage(module, block: crypt, message: message, ids: ids)
		emitBranchOnCompare(module, block: crypt, value: difference, pred: StdCmpPred.eq, against: 0, whenTrue: accepted, whenFalse: rejected, ids: ids)
		emitConstReturn(module, block: accepted, value: PredicateTrue, ids: ids)
		emitConstReturn(module, block: rejected, value: PredicateFalse, ids: ids)
	end 'opening'

	emitRuntimeFatal(module, func: func, block: bad, fatal: RuntimeFatal.cryptoBufferOutOfRange, ids: ids)

	module.functions.push(func)
end 'buildAesGcmPass'
