end 'buildRegistryServiceInstall'

function buildRegistryServiceRelease(module StdModule)
	var func = openRuntimeFunction(RegistryServiceReleaseName, paramCount: 1, returnsAWord: false)
	var ids = ValueMinter.create(1)
	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var dropIt = module.addBlock(func, label: b"regdrop", heat: BlockHeat.normal)
	var done = module.addBlock(func, label: b"regreleasedone", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let slot = 0

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	emitStoreField(module, block: entry, record: slot, offset: SharedValueHolderCellOffset, value: emitConst(module, block: entry, value: ReleasedHolder, ids: ids))
	emitLockWordLeave(module, block: entry, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	emitBranchOnCompare(module, block: entry, value: held, pred: StdCmpPred.eq, against: ReleasedHolder, whenTrue: done, whenFalse: dropIt, ids: ids)

	module.appendOp(dropIt, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(held)))
	module.setTerminator(dropIt, op: StdOp.branch(done.id))

	module.setTerminator(done, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildRegistryServiceRelease'

function buildRegistryServiceReplace(module StdModule, released ByteArray)
	var func = openRuntimeFunction(RegistryServiceReplaceName, paramCount: 3, returnsAWord: true)
	var ids = ValueMinter.create(3)
	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var compareTable = module.addBlock(func, label: b"regcomparetable", heat: BlockHeat.normal)
	var swap = module.addBlock(func, label: b"regswap", heat: BlockHeat.normal)
	var decline = module.addBlock(func, label: b"regdecline", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 3)
	let slot = 0
	let handle = 1
	let expected = 2

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	var live = emitHeldOrPanic(module, func: func, block: entry, held: held, released: released, holdsRegistryLock: true, ids: ids)
	emitBranchOnCompareValues(module, block: live, a: emitLoadField(module, block: live, record: held, offset: ServiceHandleMailboxOffset, ids: ids), pred: StdCmpPred.eq, b: emitLoadField(module, block: live, record: expected, offset: ServiceHandleMailboxOffset, ids: ids), whenTrue: compareTable, whenFalse: decline, ids: ids)

	emitBranchOnCompareValues(module, block: compareTable, a: emitLoadField(module, block: compareTable, record: held, offset: InterfaceHandleTableOffset, ids: ids), pred: StdCmpPred.eq, b: emitLoadField(module, block: compareTable, record: expected, offset: InterfaceHandleTableOffset, ids: ids), whenTrue: swap, whenFalse: decline, ids: ids)

	emitStoreField(module, block: swap, record: slot, offset: SharedValueHolderCellOffset, value: handle)
	emitLockWordLeave(module, block: swap, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.appendOp(swap, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(held)))
	module.setTerminator(swap, op: StdOp.ret(emitConst(module, block: swap, value: PublishedAnswer, ids: ids)))

	emitLockWordLeave(module, block: decline, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.appendOp(decline, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(handle)))
	module.setTerminator(decline, op: StdOp.ret(emitConst(module, block: decline, value: DeclinedAnswer, ids: ids)))
	module.functions.push(func)
end 'buildRegistryServiceReplace'
