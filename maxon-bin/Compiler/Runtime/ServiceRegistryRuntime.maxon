function buildRegistryServiceRelease(module StdModule)
	var func = openRuntimeFunction(RegistryServiceReleaseName, paramCount: 1, returnsAWord: false)
	var ids = ValueMinter.create(1)
	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var dropIt = module.addBlock(func, label: b"regdrop", heat: BlockHeat.normal)
	var done = module.addBlock(func, label: b"regreleasedone", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let slot = 0 as ValueId

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	emitStoreField(module, block: entry, record: slot, offset: SharedValueHolderCellOffset, value: emitConst(module, block: entry, value: ReleasedHolder, ids: ids))
	emitSchedLockLeave(module, block: entry, ids: ids)
	let wasReleased = emitCmp(module, block: entry, a: held, b: emitConst(module, block: entry, value: ReleasedHolder, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(wasReleased, thenBlockId: done.id, elseBlockId: dropIt.id))

	module.appendOp(dropIt, op: StdOp.call(ids.mint(), callee: MboxHandleDropBoxName, args: argsOf(held)))
	module.setTerminator(dropIt, op: StdOp.branch(done.id))

	module.setTerminator(done, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildRegistryServiceRelease'

function buildRegistryServiceReplace(module StdModule, released ByteArray)
	var func = openRuntimeFunction(RegistryServiceReplaceName, paramCount: 3, returnsAWord: true)
	var ids = ValueMinter.create(3)
	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var compareTable = module.addBlock(func, label: b"regcomparetable", heat: BlockHeat.normal)
	var swap = module.addBlock(func, label: b"regswap", heat: BlockHeat.normal)
	var decline = module.addBlock(func, label: b"regdecline", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 3)
	let slot = 0 as ValueId
	let handle = 1 as ValueId
	let expected = 2 as ValueId

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	var live = emitHeldOrPanic(module, func: func, block: entry, held: held, released: released, holdsSchedLock: true, ids: ids)
	let sameMailbox = emitCmp(module, block: live, a: emitLoadField(module, block: live, record: held, offset: ServiceHandleMailboxOffset, ids: ids), b: emitLoadField(module, block: live, record: expected, offset: ServiceHandleMailboxOffset, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(live, op: StdOp.condBranch(sameMailbox, thenBlockId: compareTable.id, elseBlockId: decline.id))

	let sameTable = emitCmp(module, block: compareTable, a: emitLoadField(module, block: compareTable, record: held, offset: InterfaceHandleTableOffset, ids: ids), b: emitLoadField(module, block: compareTable, record: expected, offset: InterfaceHandleTableOffset, ids: ids), pred: StdCmpPred.eq, ids: ids)
	module.setTerminator(compareTable, op: StdOp.condBranch(sameTable, thenBlockId: swap.id, elseBlockId: decline.id))

	emitStoreField(module, block: swap, record: slot, offset: SharedValueHolderCellOffset, value: handle)
	emitSchedLockLeave(module, block: swap, ids: ids)
	module.appendOp(swap, op: StdOp.call(ids.mint(), callee: MboxHandleDropBoxName, args: argsOf(held)))
	module.setTerminator(swap, op: StdOp.ret(emitConst(module, block: swap, value: PublishedAnswer, ids: ids)))

	emitSchedLockLeave(module, block: decline, ids: ids)
	module.appendOp(decline, op: StdOp.call(ids.mint(), callee: MboxHandleDropBoxName, args: argsOf(handle)))
	module.setTerminator(decline, op: StdOp.ret(emitConst(module, block: decline, value: DeclinedAnswer, ids: ids)))
	module.functions.push(func)
end 'buildRegistryServiceReplace'
