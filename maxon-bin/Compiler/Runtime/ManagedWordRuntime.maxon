export enum WordByteOrder
	littleEndian
	bigEndian
end 'WordByteOrder'

export enum WordAccess
	get
	put
end 'WordAccess'

export type OrderedWordIntrinsic
	export let access as WordAccess
	export let order as WordByteOrder

	export static function create(access WordAccess, order WordByteOrder) returns Self
		return Self{access: access, order: order}
	end 'create'
end 'OrderedWordIntrinsic'

export type WordEntry
	export let access as WordAccess
	export let order as WordByteOrder
	export let width as WordBytes

	export static function create(access WordAccess, order WordByteOrder, width WordBytes) returns Self
		return Self{access: access, order: order, width: width}
	end 'create'
end 'WordEntry'

let WordEntryPrefix = b"__managed_word_"
let OrderedWordIntrinsicPrefix = "__Builtins."
let WordBitsPerByte = 8
let WordByteMask = 0xFF
let WordZero = 0
let WordFirstByteIndex = 0

export function wordAccessType(width WordBytes) returns StdType
	return match width 'w'
		two gives StdType.u16
		four gives StdType.u32
		eight gives StdType.i64
	end 'w'
end 'wordAccessType'

function orderedWordIntrinsicName(intrinsic OrderedWordIntrinsic) returns ByteArray
	let verb = match intrinsic.access 'a'
		get gives "read"
		put gives "append"
	end 'a'

	let endian = match intrinsic.order 'o'
		littleEndian gives "LittleEndian"
		bigEndian gives "BigEndian"
	end 'o'

	return "{OrderedWordIntrinsicPrefix}{verb}{endian}".toByteArray()
end 'orderedWordIntrinsicName'

export function orderedWordIntrinsicNamed(callee ByteArray) returns OrderedWordIntrinsic throws AbsentError
	for access in WordAccess.allCases 'eachAccess'
		for order in WordByteOrder.allCases 'eachOrder'
			let intrinsic = OrderedWordIntrinsic.create(access, order: order)

			if callee.equals(orderedWordIntrinsicName(intrinsic)) 'named'
				return intrinsic
			end 'named'
		end 'eachOrder'
	end 'eachAccess'

	throw AbsentError.absent
end 'orderedWordIntrinsicNamed'

export function isOrderedWordIntrinsic(callee ByteArray) returns bool
	let intrinsic = try orderedWordIntrinsicNamed(callee) otherwise return false
	return callee.equals(orderedWordIntrinsicName(intrinsic))
end 'isOrderedWordIntrinsic'

export function wordBytesOfCount(count FullRangeInt) returns WordBytes throws AbsentError
	for width in WordBytes.allCases 'eachWidth'
		if wordByteCount(width) == count 'matches'
			return width
		end 'matches'
	end 'eachWidth'

	throw AbsentError.absent
end 'wordBytesOfCount'

export function wordEntryName(access WordAccess, order WordByteOrder, width WordBytes) returns ByteArray
	let verb = match access 'a'
		get gives "get"
		put gives "put"
	end 'a'

	let endian = match order 'o'
		littleEndian gives "le"
		bigEndian gives "be"
	end 'o'

	return "{String.from(WordEntryPrefix)}{verb}_{endian}{wordByteCount(width)}".toByteArray()
end 'wordEntryName'

export function wordEntryNamed(callee ByteArray) returns WordEntry throws AbsentError
	if not bytesStartWith(callee, prefix: WordEntryPrefix) 'notAWordEntry'
		throw AbsentError.absent
	end 'notAWordEntry'

	for access in WordAccess.allCases 'eachAccess'
		for order in WordByteOrder.allCases 'eachOrder'
			for width in WordBytes.allCases 'eachWidth'
				if callee.equals(wordEntryName(access, order: order, width: width)) 'named'
					return WordEntry.create(access, order: order, width: width)
				end 'named'
			end 'eachWidth'
		end 'eachOrder'
	end 'eachAccess'

	throw AbsentError.absent
end 'wordEntryNamed'

export function isWordGetCallee(callee ByteArray) returns bool
	let entry = try wordEntryNamed(callee) otherwise return false
	return entry.access == WordAccess.get
end 'isWordGetCallee'

export function isWordPutCallee(callee ByteArray) returns bool
	let entry = try wordEntryNamed(callee) otherwise return false
	return entry.access == WordAccess.put
end 'isWordPutCallee'

export function wordGetSourceMethodName(callee ByteArray) returns ByteArray
	let entry = try wordEntryNamed(callee) otherwise panic("wordGetSourceMethodName: '{String.from(callee)}' is not a word entry — this map is asked only behind `isWordGetCallee`")

	return orderedWordIntrinsicName(OrderedWordIntrinsic.create(entry.access, order: entry.order))
end 'wordGetSourceMethodName'

function emitWordByteShift(module StdModule, block IrBlock, index ValueId, order WordByteOrder, width WordBytes, ids ValueMinter) returns ValueId
	let position = match order 'o'
		littleEndian gives index
		bigEndian gives emitBin(module, block: block, a: emitConst(module, block: block, value: wordByteCount(width) - 1, ids: ids), b: index, opcode: StdBinOpcode.sub, ids: ids)
	end 'o'

	return emitBin(module, block: block, a: position, b: emitConst(module, block: block, value: WordBitsPerByte, ids: ids), opcode: StdBinOpcode.mul, ids: ids)
end 'emitWordByteShift'

export function installWordEntries(module StdModule)
	for width in WordBytes.allCases 'eachWidth'
		for order in WordByteOrder.allCases 'eachOrder'
			buildWordGet(module, order: order, width: width)
			buildWordPut(module, order: order, width: width)
		end 'eachOrder'
	end 'eachWidth'
end 'installWordEntries'

function buildWordGet(module StdModule, order WordByteOrder, width WordBytes)
	var func = IrFunction.createFromStd(wordEntryName(WordAccess.get, order: order, width: width), returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), throwsTypeName: arrayErrorThrows())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	var oob = module.addBlock(func, label: b"oob", heat: BlockHeat.normal)
	var short = module.addBlock(func, label: b"short", heat: BlockHeat.normal)
	var read = module.addBlock(func, label: b"read", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let arr = 0
	let at = 1

	emitSpanGuards(module, entry: entry, inside: short, next: read, refused: oob, arr: arr, at: at, byteCount: wordByteCount(width), ids: ids)
	emitOobReturn(module, block: oob, ids: ids)

	let first = emitConst(module, block: read, value: WordFirstByteIndex, ids: ids)
	let total = emitConst(module, block: read, value: wordByteCount(width), ids: ids)
	let empty = emitConst(module, block: read, value: WordZero, ids: ids)
	var loop = openCountedLoop(module, func: func, cur: read, from: first, to: total, label: b"wg", ids: ids, initial: argsOf(empty))

	let slot = emitBin(module, block: loop.body, a: at, b: loop.index, opcode: StdBinOpcode.add, ids: ids)
	let byte = ids.mint()
	module.appendOp(loop.body, op: StdOp.call(byte, callee: ManagedGetUncheckedName, args: twoArgs(arr, second: slot)))

	let shift = emitWordByteShift(module, block: loop.body, index: loop.index, order: order, width: width, ids: ids)
	let placed = emitBin(module, block: loop.body, a: byte, b: shift, opcode: StdBinOpcode.shl, ids: ids)
	let word = try loop.carried.get(0) otherwise panic("buildWordGet: the loop was opened with one carried value, the accumulated word")
	let merged = emitBin(module, block: loop.body, a: word, b: placed, opcode: StdBinOpcode.bitOr, ids: ids)
	closeCountedLoop(module, loop: loop, tail: loop.body, step: SingleStep, ids: ids, carriedNext: argsOf(merged))

	emitOkReturn(module, block: loop.done, value: word, ids: ids)

	module.functions.push(func)
end 'buildWordGet'

// Bounded as `at < length`, then `length - at >= byteCount`, and never as `at + byteCount <= length`: an
// `at` near `u64.max` would wrap that sum into range and reach outside the buffer.
export function emitSpanGuards(module StdModule, entry IrBlock, inside IrBlock, next IrBlock, refused IrBlock, arr ValueId, at ValueId, byteCount FullRangeInt, ids ValueMinter)
	let length = emitLoadField(module, block: entry, record: arr, offset: ManagedRecordLengthOffset, ids: ids)
	let pastEnd = emitIndexOutOfRange(module, block: entry, index: at, length: length, ids: ids)
	module.setTerminator(entry, op: StdOp.condBranch(pastEnd, thenBlockId: refused.id, elseBlockId: inside.id))

	let remaining = emitBin(module, block: inside, a: length, b: at, opcode: StdBinOpcode.sub, ids: ids)
	let tooShort = emitCompareWithConstant(module, block: inside, value: remaining, pred: StdCmpPred.lt, against: byteCount, ids: ids)
	module.setTerminator(inside, op: StdOp.condBranch(tooShort, thenBlockId: refused.id, elseBlockId: next.id))
end 'emitSpanGuards'

function buildWordPut(module StdModule, order WordByteOrder, width WordBytes)
	var func = IrFunction.createFromStd(wordEntryName(WordAccess.put, order: order, width: width), returnType: StdReturnType.void, paramCount: 2, paramTypes: twoI64Params())
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 2)
	let arr = 0
	let word = 1
	let count = wordByteCount(width)

	let first = emitConst(module, block: entry, value: WordFirstByteIndex, ids: ids)
	let total = emitConst(module, block: entry, value: count, ids: ids)
	var loop = openCountedLoop(module, func: func, cur: entry, from: first, to: total, label: b"wp", ids: ids)

	let shift = emitWordByteShift(module, block: loop.body, index: loop.index, order: order, width: width, ids: ids)
	let moved = emitBin(module, block: loop.body, a: word, b: shift, opcode: StdBinOpcode.shrLogical, ids: ids)
	let byte = emitBin(module, block: loop.body, a: moved, b: emitConst(module, block: loop.body, value: WordByteMask, ids: ids), opcode: StdBinOpcode.bitAnd, ids: ids)
	let pushed = ids.mint()
	module.appendOp(loop.body, op: StdOp.call(pushed, callee: ManagedPushName, args: twoArgs(arr, second: byte)))
	closeCountedLoop(module, loop: loop, tail: loop.body, step: SingleStep, ids: ids)

	module.setTerminator(loop.done, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildWordPut'
