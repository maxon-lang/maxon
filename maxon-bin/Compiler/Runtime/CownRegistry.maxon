// A service slot (`__reg_service_*`) is read and written under the registry's own lock
// (`RegistryLockLabel`), so a lookup takes its share of the cown before a concurrent register can
// drop the handle it read; an emitted line pays I/O anyway. Nothing allocates and no handle is
// dropped while that lock is held.
export let RegistryLockLabel = b"__maxon_registry_lock"

let ServiceRegistryRuntimePrefix = b"__reg_service_"
export let RegistryServiceCurrentName = b"__reg_service_current"
export let RegistryServiceRegisterName = b"__reg_service_register"
export let RegistryServiceReplaceName = b"__reg_service_replace"
export let RegistryServiceInstallName = b"__reg_service_install"
export let RegistryServiceReleaseName = b"__reg_service_release"

export function isServiceRegistryRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: ServiceRegistryRuntimePrefix)
end 'isServiceRegistryRuntimeCallee'

export function installServiceRegistryRuntime(module StdModule, globalData GlobalDataTable, usage RuntimeUsage)
	if not usage.usesServiceRegistry 'noServiceRegistry'
		return
	end 'noServiceRegistry'

	let released = releasedRegistryPanicLabel(globalData)
	buildRegistryServiceCurrent(module, released: released)
	buildRegistryServiceRegister(module, released: released)
	buildRegistryServiceReplace(module, released: released)
	buildRegistryServiceInstall(module)
	buildRegistryServiceRelease(module)
end 'installServiceRegistryRuntime'

let RegistryReleasedMessage = b"a `default` key was looked up or registered after the exit drain released the registry"

module function releasedRegistryPanicLabel(globalData GlobalDataTable) returns immutable ByteArray
	return registerPanicLabel(globalData, message: RegistryReleasedMessage)
end 'releasedRegistryPanicLabel'

module function emitHeldOrPanic(module StdModule, func IrFunction, block IrBlock, held ValueId, released ByteArray, holdsRegistryLock bool, ids ValueMinter) returns IrBlock
	let releasedBlock = module.addBlock(func, label: b"regreleased", heat: BlockHeat.cold)
	let live = module.addBlock(func, label: b"reglive", heat: BlockHeat.normal)
	emitBranchOnCompare(module, block: block, value: held, pred: StdCmpPred.eq, against: ReleasedHolder, whenTrue: releasedBlock, whenFalse: live, ids: ids)

	if holdsRegistryLock 'leaveTheLockFirst'
		emitLockWordLeave(module, block: releasedBlock, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	end 'leaveTheLockFirst'

	module.appendOp(releasedBlock, op: StdOp.osPanic(released))
	emitDeadTerminator(module, func: func, block: releasedBlock, ids: ids)
	return live
end 'emitHeldOrPanic'

function emitLockedSlotHandle(module StdModule, block IrBlock, slot ValueId, ids ValueMinter) returns ValueId
	emitLockWordEnter(module, block: block, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	return emitLoadField(module, block: block, record: slot, offset: SharedValueHolderCellOffset, ids: ids)
end 'emitLockedSlotHandle'

function buildRegistryServiceCurrent(module StdModule, released ByteArray)
	let func = openRuntimeFunction(RegistryServiceCurrentName, paramCount: 1, returnsAWord: true)
	let ids = ValueMinter.create(1)
	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let slot = 0

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	let live = emitHeldOrPanic(module, func: func, block: entry, held: held, released: released, holdsRegistryLock: true, ids: ids)
	let cown = emitLoadField(module, block: live, record: held, offset: ServiceHandleCownOffset, ids: ids)
	let table = emitLoadField(module, block: live, record: held, offset: InterfaceHandleTableOffset, ids: ids)
	_ = emitCownSharesStep(module, block: live, cown: cown, delta: CownShareUnit, ids: ids)
	emitLockWordLeave(module, block: live, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.setTerminator(live, op: StdOp.ret(emitInterfaceHandleBoxHolding(module, block: live, cown: cown, table: table, ids: ids)))
	module.functions.push(func)
end 'buildRegistryServiceCurrent'

function buildRegistryServiceRegister(module StdModule, released ByteArray)
	let func = openRuntimeFunction(RegistryServiceRegisterName, paramCount: 2, returnsAWord: false)
	let ids = ValueMinter.create(2)
	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 2)
	let slot = 0
	let handle = 1

	let replaced = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	let live = emitHeldOrPanic(module, func: func, block: entry, held: replaced, released: released, holdsRegistryLock: true, ids: ids)
	emitStoreField(module, block: live, record: slot, offset: SharedValueHolderCellOffset, value: handle)
	emitLockWordLeave(module, block: live, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.appendOp(live, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(replaced)))
	module.setTerminator(live, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildRegistryServiceRegister'

function buildRegistryServiceInstall(module StdModule)
	let func = openRuntimeFunction(RegistryServiceInstallName, paramCount: 2, returnsAWord: false)
	let ids = ValueMinter.create(2)
	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 2)

	emitLockWordEnter(module, block: entry, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	emitStoreField(module, block: entry, record: 0, offset: SharedValueHolderCellOffset, value: 1)
	emitLockWordLeave(module, block: entry, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.setTerminator(entry, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildRegistryServiceInstall'

function buildRegistryServiceRelease(module StdModule)
	let func = openRuntimeFunction(RegistryServiceReleaseName, paramCount: 1, returnsAWord: false)
	let ids = ValueMinter.create(1)
	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	let dropIt = module.addBlock(func, label: b"regdrop", heat: BlockHeat.normal)
	let done = module.addBlock(func, label: b"regreleasedone", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 1)
	let slot = 0

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	emitStoreField(module, block: entry, record: slot, offset: SharedValueHolderCellOffset, value: emitConst(module, block: entry, value: ReleasedHolder, ids: ids))
	emitLockWordLeave(module, block: entry, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	emitBranchOnCompare(module, block: entry, value: held, pred: StdCmpPred.eq, against: ReleasedHolder, whenTrue: done, whenFalse: dropIt, ids: ids)

	module.appendOp(dropIt, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(held)))
	module.setTerminator(dropIt, op: StdOp.branch(done.id))

	module.setTerminator(done, op: StdOp.retVoid)
	module.functions.push(func)
end 'buildRegistryServiceRelease'

function buildRegistryServiceReplace(module StdModule, released ByteArray)
	let func = openRuntimeFunction(RegistryServiceReplaceName, paramCount: 3, returnsAWord: true)
	let ids = ValueMinter.create(3)
	let entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)
	let compareTable = module.addBlock(func, label: b"regcomparetable", heat: BlockHeat.normal)
	let swap = module.addBlock(func, label: b"regswap", heat: BlockHeat.normal)
	let decline = module.addBlock(func, label: b"regdecline", heat: BlockHeat.normal)
	emitParams(module, block: entry, count: 3)
	let slot = 0
	let handle = 1
	let expected = 2

	let held = emitLockedSlotHandle(module, block: entry, slot: slot, ids: ids)
	let live = emitHeldOrPanic(module, func: func, block: entry, held: held, released: released, holdsRegistryLock: true, ids: ids)
	emitBranchOnCompareValues(module, block: live, a: emitLoadField(module, block: live, record: held, offset: ServiceHandleCownOffset, ids: ids), pred: StdCmpPred.eq, b: emitLoadField(module, block: live, record: expected, offset: ServiceHandleCownOffset, ids: ids), whenTrue: compareTable, whenFalse: decline, ids: ids)

	emitBranchOnCompareValues(module, block: compareTable, a: emitLoadField(module, block: compareTable, record: held, offset: InterfaceHandleTableOffset, ids: ids), pred: StdCmpPred.eq, b: emitLoadField(module, block: compareTable, record: expected, offset: InterfaceHandleTableOffset, ids: ids), whenTrue: swap, whenFalse: decline, ids: ids)

	emitStoreField(module, block: swap, record: slot, offset: SharedValueHolderCellOffset, value: handle)
	emitLockWordLeave(module, block: swap, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.appendOp(swap, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(held)))
	module.setTerminator(swap, op: StdOp.ret(emitConst(module, block: swap, value: PublishedAnswer, ids: ids)))

	emitLockWordLeave(module, block: decline, label: RegistryLockLabel, kind: RuntimeLockKind.exclusive, ids: ids)
	module.appendOp(decline, op: StdOp.call(ids.mint(), callee: MmDecrefName, args: argsOf(handle)))
	module.setTerminator(decline, op: StdOp.ret(emitConst(module, block: decline, value: DeclinedAnswer, ids: ids)))
	module.functions.push(func)
end 'buildRegistryServiceReplace'
