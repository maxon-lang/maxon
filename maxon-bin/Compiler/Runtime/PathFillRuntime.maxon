export let MaxPathBytes = 260 as FullRangeInt

let PhysicalPathFirstUnits = 4096 as FullRangeInt

let PathGrowthShift = 1

export union PathFill
	executablePath
	processNamespace
	currentDirectory
	systemDirectory
	windowsDirectory
	fullPath(source ValueId)
	extendablePath(source ValueId)
	finalPath(handle ValueId)
end 'PathFill'

export function pathFillEncoding(module StdModule, fill PathFill) returns HostTextEncoding
	return match fill 'fill'
		processNamespace gives HostTextEncoding.utf8
		executablePath or
		currentDirectory or
		systemDirectory or
		windowsDirectory or
		fullPath or
		extendablePath or
		finalPath gives module.hostText
	end 'fill'
end 'pathFillEncoding'

// One attempt's three-way verdict for a call that fills a caller's buffer and answers a count: `0`
// is a failure, `< capacity` means the answer is in the buffer with its NUL (`extendablePath` also
// needs room for the extended prefix), anything else means the buffer was too small. ⚠ The
// `written == 0` test comes first because a 0 also satisfies `< capacity`: the fit test alone would
// copy out a buffer the OS never wrote.
function emitFilledBufferVerdict(module StdModule, block IrBlock, check IrBlock, fill PathFill, written ValueId, capacity ValueId, whenRefused IrBlock, whenFits IrBlock, whenTooSmall IrBlock, ids ValueMinter)
	emitBranchOnCompare(module, block: block, value: written, pred: StdCmpPred.eq, against: 0, whenTrue: whenRefused, whenFalse: check, ids: ids)

	match fill 'fit'
		extendablePath then emitExtensionFitTest(module, check: check, written: written, capacity: capacity, whenFits: whenFits, whenTooSmall: whenTooSmall, ids: ids)
		executablePath or
		processNamespace or
		currentDirectory or
		systemDirectory or
		windowsDirectory or
		fullPath or
		finalPath then emitBranchOnCompareValues(module, block: check, a: written, pred: StdCmpPred.lt, b: capacity, whenTrue: whenFits, whenFalse: whenTooSmall, ids: ids)
	end 'fit'
end 'emitFilledBufferVerdict'

function emitExtensionFitTest(module StdModule, check IrBlock, written ValueId, capacity ValueId, whenFits IrBlock, whenTooSmall IrBlock, ids ValueMinter)
	let fits = emitRuntimeCall(module, block: check, callee: PathExtensionFitsName, args: twoArgs(written, second: capacity), ids: ids)

	emitBranchOnCompare(module, block: check, value: fits, pred: StdCmpPred.ne, against: 0, whenTrue: whenFits, whenFalse: whenTooSmall, ids: ids)
end 'emitExtensionFitTest'

// The one grow-and-retry path fill. Each too-small attempt doubles the buffer, because two of the
// fills name no size to retry at: `GetModuleFileNameW` answers the size it was given on truncation,
// and `getcwd` answers NULL with `ERANGE`. The retry lives in Std so no backend owns a buffer
// policy. The buffer is still allocated on both exits, the refused one included, and the caller
// frees it.
export function emitGrowingPathFill(module StdModule, cur IrBlock, attempt IrBlock, fitTest IrBlock, grow IrBlock, fill PathFill, whenRefused IrBlock, whenFits IrBlock, ids ValueMinter) returns (ValueId, ValueId, ValueId)
	let buffer = ids.mint()
	let capacity = ids.mint()
	pushI64BlockArgs(attempt, values: twoArgs(buffer, second: capacity))

	let firstSize = emitConst(module, block: cur, value: pathFillFirstUnits(fill), ids: ids)
	let encoding = pathFillEncoding(module, fill: fill)
	let firstBuf = emitRawAlloc(module, block: cur, byteCount: emitByteCountOfUnits(module, block: cur, units: firstSize, encoding: encoding, ids: ids), ids: ids)
	emitBranchCarrying(module, from: cur, to: attempt, values: twoArgs(firstBuf, second: firstSize))

	let written = ids.mint()
	emitPathFillOp(module, block: attempt, fill: fill, written: written, buffer: buffer, capacity: capacity, ids: ids)
	emitFilledBufferVerdict(module, block: attempt, check: fitTest, fill: fill, written: written, capacity: capacity, whenRefused: whenRefused, whenFits: whenFits, whenTooSmall: grow, ids: ids)

	emitRawFree(module, block: grow, ptr: buffer, ids: ids)
	let shift = emitConst(module, block: grow, value: PathGrowthShift, ids: ids)
	let grownCapacity = emitBin(module, block: grow, a: capacity, b: shift, opcode: StdBinOpcode.shl, ids: ids)
	let grownBuf = emitRawAlloc(module, block: grow, byteCount: emitByteCountOfUnits(module, block: grow, units: grownCapacity, encoding: encoding, ids: ids), ids: ids)
	emitBranchCarrying(module, from: grow, to: attempt, values: twoArgs(grownBuf, second: grownCapacity))
	return (buffer, written, capacity)
end 'emitGrowingPathFill'

function emitPathFillOp(module StdModule, block IrBlock, fill PathFill, written ValueId, buffer ValueId, capacity ValueId, ids ValueMinter)
	match fill 'fill'
		executablePath then module.appendOp(block, op: StdOp.osExecutablePath(written, bufLenId: capacity, bufPtrId: buffer))
		processNamespace then module.appendOp(block, op: StdOp.osProcessNamespace(written, bufLenId: capacity, bufPtrId: buffer))
		currentDirectory then emitParkedCurrentDirectoryFill(module, block: block, written: written, buffer: buffer, capacity: capacity, ids: ids)
		systemDirectory then emitDirectoryQuery(module, block: block, verb: PathQueryVerb.systemDirectory, written: written, buffer: buffer, capacity: capacity, ids: ids)
		windowsDirectory then emitDirectoryQuery(module, block: block, verb: PathQueryVerb.windowsDirectory, written: written, buffer: buffer, capacity: capacity, ids: ids)
		fullPath(source) then emitFullPathQuery(module, block: block, source: source, written: written, buffer: buffer, capacity: capacity)
		extendablePath(source) then emitFullPathQuery(module, block: block, source: source, written: written, buffer: buffer, capacity: capacity)
		finalPath(handle) then module.appendOp(block, op: StdOp.osPathQuery(written, verb: PathQueryVerb.finalPath, a0Id: handle, a1Id: capacity, a2Id: buffer))
	end 'fill'
end 'emitPathFillOp'

function emitFullPathQuery(module StdModule, block IrBlock, source ValueId, written ValueId, buffer ValueId, capacity ValueId)
	module.appendOp(block, op: StdOp.osPathQuery(written, verb: PathQueryVerb.fullPath, a0Id: source, a1Id: capacity, a2Id: buffer))
end 'emitFullPathQuery'

function pathFillFirstUnits(fill PathFill) returns FullRangeInt
	return match fill 'fill'
		finalPath gives PhysicalPathFirstUnits
		executablePath or
		processNamespace or
		currentDirectory or
		systemDirectory or
		windowsDirectory or
		fullPath or
		extendablePath gives MaxPathBytes
	end 'fill'
end 'pathFillFirstUnits'

function emitParkedCurrentDirectoryFill(module StdModule, block IrBlock, written ValueId, buffer ValueId, capacity ValueId, ids ValueMinter)
	emitIoPark(module, block: block, operation: GtIoOperation.fileExists, ids: ids)
	module.appendOp(block, op: StdOp.osDirCurrentPath(written, bufLenId: capacity, bufPtrId: buffer))
end 'emitParkedCurrentDirectoryFill'

function emitDirectoryQuery(module StdModule, block IrBlock, verb PathQueryVerb, written ValueId, buffer ValueId, capacity ValueId, ids ValueMinter)
	let unused = emitConst(module, block: block, value: 0, ids: ids)
	module.appendOp(block, op: StdOp.osPathQuery(written, verb: verb, a0Id: buffer, a1Id: capacity, a2Id: unused))
end 'emitDirectoryQuery'
