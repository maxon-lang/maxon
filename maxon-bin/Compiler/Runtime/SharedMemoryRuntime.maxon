// Runtime/SharedMemoryRuntime.maxon — a NAMED SECTION two processes both map, from the side that publishes
// or adopts it.
//
// ⭐ **WHAT IT SERVES.** `stdlib/SharedMemory.maxon`'s `SharedSegment` bottoms out in eight `__Builtins`
// intrinsics and nothing else in the language reaches these entry points. Everything above them — where the
// ring's header sits, how its cursors advance, what an entry packs into — is ordinary Maxon in the consumer
// that decodes the ring, exactly as the FILETIME arithmetic stays out of `osReadWallClock`.
//
// ⭐⭐ **IT IS THE OTHER HALF OF `DebugStreamRuntime`'s ATTACH, AND THE TWO CANNOT SHARE A DOOR.** A traced
// child OPENS a section by a name it reads out of its environment (`osOpenNamedSegment`); the process
// watching it CREATES that section, publishes the name, and reads what the child wrote. `OpenFileMappingA`
// answers NULL for a section that does not exist yet, so no ordering of the two processes lets the producer's
// op serve the consumer — see `StdOp.osCreateNamedSegment`.
//
// ⭐ **THE MAPPING IS `osMapNamedSegment`, REUSED UNCHANGED.** It takes a HANDLE and does not care which call
// minted it, so a created section maps through the same op an opened one does.
//
// ⚠ **THE LANES THAT SERVE THIS ARE `TargetFacilities.sharedMemory`'s, and a call site on any other is
// refused** with the existing `E3104 targetUnsupportedConstruct`, matched on the `__shm_` PREFIX — so an
// entry point added here later is gated by construction rather than by memory. The lowerings of the band's
// ops panic on a lane without the substrate, as a backstop for a compiler bug that got one past that
// refusal, never as the user-facing rejection.
//
// ⚠ **A POSIX TEARDOWN HAS ONE STEP WIN32 DOES NOT**, and it is the reason `__shm_close` takes the NAME:
// a Win32 section dies with its last handle and view, while a POSIX object outlives both until
// `shm_unlink` withdraws its name. See `StdOp.osUnpublishNamedSegment`.

// The `__shm_` prefix that identifies EVERY shared-memory runtime entry point — the one test
// `scanRuntimeUsage` reads to set `usesSharedMemory`, and the one `TargetFacilities` reads for E3104.
let SharedMemoryRuntimePrefix = b"__shm_"

// The eight entry points: the publish and the adopt, one mapping, three accessors over the mapped bytes, and
// two teardowns — the publisher's, which withdraws the name, and an adopter's, which leaves it. The accessors
// are entries rather than surface syntax because Maxon has no raw dereference: `readWord` is one acquire
// load at an address the language cannot otherwise name.
export let SharedMemoryCreateName = b"__shm_create"
export let SharedMemoryMapName = b"__shm_map"
export let SharedMemoryReadWordName = b"__shm_read_word"
export let SharedMemoryWriteWordName = b"__shm_write_word"
export let SharedMemoryCopyOutName = b"__shm_copy_out"
export let SharedMemoryCloseName = b"__shm_close"
export let SharedMemoryAdoptName = b"__shm_adopt"
export let SharedMemoryReleaseName = b"__shm_release"

// What the publish and the adopt answer instead of a handle. The stdlib decodes the raw values, and
// `checkSharedMemoryAnswers` pins them against its constants.
export enum SharedSegmentAnswer
	refused = 0
	nameTaken = -1
	notYetPublished = -2
end 'SharedSegmentAnswer'

enum Win32SegmentError
	fileNotFound = 2
	alreadyExists = 183
end 'Win32SegmentError'

let SharedMemoryStdlibFileName = "SharedMemory.maxon"

enum SegmentCall
	create
	adopt
	map
end 'SegmentCall'

function segmentCallName(call SegmentCall) returns ByteArray
	return match call 'name'
		create gives SharedMemoryCreateName
		adopt gives SharedMemoryAdoptName
		map gives SharedMemoryMapName
	end 'name'
end 'segmentCallName'

function segmentCallOp(call SegmentCall, result ValueId, first ValueId, bytes ValueId) returns StdOp
	return match call 'op'
		create gives StdOp.osCreateNamedSegment(result, namePtrId: first, sizeId: bytes)
		adopt gives StdOp.osAdoptNamedSegment(result, namePtrId: first, sizeId: bytes)
		map gives StdOp.osMapNamedSegment(result, handleId: first, sizeId: bytes)
	end 'op'
end 'segmentCallOp'

function buildSharedMemorySegmentCall(module StdModule, call SegmentCall, target Target)
	var func = IrFunction.createFromStd(segmentCallName(call), returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let first = 0 as ValueId
	let bytes = 1 as ValueId

	let answer = ids.mint()
	module.appendOp(entry, op: segmentCallOp(call, result: answer, first: first, bytes: bytes))

	if theStdBodyClassifiesTheAnswer(target) 'theStdBodyClassifies'
		match call 'classify'
			create then emitExclusiveCreateAnswer(module, func: func, entry: entry, handle: answer, ids: ids)
			adopt then emitAdoptAnswer(module, func: func, entry: entry, handle: answer, bytes: bytes, ids: ids)
			map then module.setTerminator(entry, op: StdOp.ret(answer))
		end 'classify'
	end 'theStdBodyClassifies' else 'theHostCallClassifies'
		module.setTerminator(entry, op: StdOp.ret(answer))
	end 'theHostCallClassifies'

	module.functions.push(func)
end 'buildSharedMemorySegmentCall'

// A POSIX lane's host chunk classifies its own answer, because it holds the errno; Win32's reason is
// `GetLastError`, which only a separate `osLastError` op reads, so the Std body classifies there.
function theStdBodyClassifiesTheAnswer(target Target) returns bool
	return match target.os 'os'
		windows gives true
		linux or
			macos gives false
		wasi panic("theStdBodyClassifiesTheAnswer: `targetProvidesFacility` denies `sharedMemory` on wasm32-wasi, so no `__shm_` body is built there")
	end 'os'
end 'theStdBodyClassifiesTheAnswer'

function emitLastErrorIs(module StdModule, block IrBlock, error Win32SegmentError, ids ValueMinter) returns ValueId
	let lastError = ids.mint()
	module.appendOp(block, op: StdOp.osLastError(lastError))
	return emitCmp(module, block: block, a: lastError, b: emitConst(module, block: block, value: error.rawValue, ids: ids), pred: StdCmpPred.eq, ids: ids)
end 'emitLastErrorIs'

function emitHandleIsNull(module StdModule, block IrBlock, handle ValueId, ids ValueMinter) returns ValueId
	return emitCmp(module, block: block, a: handle, b: emitConst(module, block: block, value: SharedSegmentAnswer.refused.rawValue, ids: ids), pred: StdCmpPred.eq, ids: ids)
end 'emitHandleIsNull'

// The Win32 adopt. Win32 reports no section's size through its handle, but `MapViewOfFile` refuses a view
// larger than the section, so a trial view of `bytes` is the size check; it is unmapped at once, and the
// stdlib maps the section again. A name not yet published is `ERROR_FILE_NOT_FOUND`.
function emitAdoptAnswer(module StdModule, func IrFunction, entry IrBlock, handle ValueId, bytes ValueId, ids ValueMinter)
	var notOpened = module.addBlock(func, label: b"shmnoopen", heat: BlockHeat.cold)
	var notYetPublished = module.addBlock(func, label: b"shmnotyet", heat: BlockHeat.cold)
	var opened = module.addBlock(func, label: b"shmopened", heat: BlockHeat.normal)
	var fits = module.addBlock(func, label: b"shmfits", heat: BlockHeat.normal)
	var tooSmall = module.addBlock(func, label: b"shmsmall", heat: BlockHeat.cold)

	module.setTerminator(entry, op: StdOp.condBranch(emitHandleIsNull(module, block: entry, handle: handle, ids: ids), thenBlockId: notOpened.id, elseBlockId: opened.id))

	module.setTerminator(notOpened, op: StdOp.condBranch(emitLastErrorIs(module, block: notOpened, error: Win32SegmentError.fileNotFound, ids: ids), thenBlockId: notYetPublished.id, elseBlockId: tooSmall.id))
	emitConstReturn(module, block: notYetPublished, value: SharedSegmentAnswer.notYetPublished.rawValue, ids: ids)

	let view = ids.mint()
	module.appendOp(opened, op: StdOp.osMapNamedSegment(view, handleId: handle, sizeId: bytes))
	module.setTerminator(opened, op: StdOp.condBranch(emitHandleIsNull(module, block: opened, handle: view, ids: ids), thenBlockId: tooSmall.id, elseBlockId: fits.id))

	module.appendOp(fits, op: StdOp.osUnmapNamedSegment(view, sizeId: bytes))
	module.setTerminator(fits, op: StdOp.ret(handle))

	module.appendOp(tooSmall, op: StdOp.osCloseHandle(handle))
	emitConstReturn(module, block: tooSmall, value: SharedSegmentAnswer.refused.rawValue, ids: ids)
end 'emitAdoptAnswer'

// `CreateFileMappingA` answers an existing section's handle with `ERROR_ALREADY_EXISTS` rather than failing.
// That section is the adopt road's to open, so this handle is closed and the answer is `nameTaken`.
function emitExclusiveCreateAnswer(module StdModule, func IrFunction, entry IrBlock, handle ValueId, ids ValueMinter)
	var created = module.addBlock(func, label: b"shmmade", heat: BlockHeat.normal)
	var existed = module.addBlock(func, label: b"shmexisted", heat: BlockHeat.cold)
	var answered = module.addBlock(func, label: b"shmanswer", heat: BlockHeat.normal)

	module.setTerminator(entry, op: StdOp.condBranch(emitHandleIsNull(module, block: entry, handle: handle, ids: ids), thenBlockId: answered.id, elseBlockId: created.id))
	module.setTerminator(created, op: StdOp.condBranch(emitLastErrorIs(module, block: created, error: Win32SegmentError.alreadyExists, ids: ids), thenBlockId: existed.id, elseBlockId: answered.id))

	module.appendOp(existed, op: StdOp.osCloseHandle(handle))
	emitConstReturn(module, block: existed, value: SharedSegmentAnswer.nameTaken.rawValue, ids: ids)

	module.setTerminator(answered, op: StdOp.ret(handle))
end 'emitExclusiveCreateAnswer'

// ⭐ `__shm_read_word(base, offset) -> word` and `__shm_write_word(base, offset, value)`.
//
// ⭐⭐ **THE OFFSET IS BYTES AND IS NEVER SCALED**, which is the contract `specs/shared-memory-builtins.md`
// pins: the ring's header and its records are laid out in bytes by a format neither process owns, so an
// accessor that multiplied by eight would put every consumer read one stride away from the producer's write.
//
// ⚠ **THE BOUND IS THE CALLER'S AND THERE IS NO CHECK HERE.** A view is `bytes` long and this reads a word at
// an arbitrary displacement inside it; a runtime guard would need the length, which is a fact the SEGMENT
// holds and this entry is not given. `stdlib/SharedMemory.maxon`'s ranged `SegmentOffset` is where the domain
// is stated.
//
// ⚠ The read is an acquire and the write a release because a word in the segment is how one process
// announces bytes to another, and no lock spans the two. `__shm_copy_out` stays plain: it is sound only
// after an acquire of the word that announced the range it copies.
function buildSharedMemoryReadWord(module StdModule)
	var func = IrFunction.createFromStd(SharedMemoryReadWordName, returnType: StdReturnType.value(StdType.i64), paramCount: 2, paramTypes: twoI64Params(), returnLine: 0)
	var ids = ValueMinter.create(2)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 2)
	let base = 0 as ValueId
	let offset = 1 as ValueId

	let addr = emitBin(module, block: entry, a: base, b: offset, opcode: StdBinOpcode.add, ids: ids)
	let word = emitLoadAcquireField(module, block: entry, record: addr, offset: 0, ids: ids)
	module.setTerminator(entry, op: StdOp.ret(word))

	module.functions.push(func)
end 'buildSharedMemoryReadWord'

function buildSharedMemoryWriteWord(module StdModule)
	var func = IrFunction.createFromStd(SharedMemoryWriteWordName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let base = 0 as ValueId
	let offset = 1 as ValueId
	let value = 2 as ValueId

	let addr = emitBin(module, block: entry, a: base, b: offset, opcode: StdBinOpcode.add, ids: ids)
	module.appendOp(entry, op: StdOp.storeRelease(addr, offset: 0, valueId: value, valueType: StdType.i64))
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildSharedMemoryWriteWord'

// ⭐ `__shm_copy_out(base, offset, byteCount) -> arrRec` — a FRESH owned `__ManagedMemory` holding a byte range
// lifted out of the mapping, and the caller drops it.
//
// ⭐ **IT IS A COPY AND NOT A VIEW, WHICH IS THE ONLY HONEST ANSWER.** The bytes belong to a section another
// process is writing; a record pointing INTO the mapping would answer differently on each read and would
// outlive `close()`. Copying is also what makes the answer an ordinary `ByteArray` a caller may keep.
//
// ⚠ The length must be PUBLISHED — `emitManagedByteBuffer` reserves capacity and leaves `length@8` at zero by
// `__managed_reserve`'s contract, so a copy that forgot the store would answer the empty array while holding
// the right bytes.
function buildSharedMemoryCopyOut(module StdModule)
	var func = IrFunction.createFromStd(SharedMemoryCopyOutName, returnType: StdReturnType.value(StdType.i64), paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)
	var ids = ValueMinter.create(3)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let base = 0 as ValueId
	let offset = 1 as ValueId
	let byteCount = 2 as ValueId

	let record = ids.mint()
	let destBuf = emitManagedByteBuffer(module, block: entry, record: record, byteCount: byteCount, ids: ids)
	let src = emitBin(module, block: entry, a: base, b: offset, opcode: StdBinOpcode.add, ids: ids)
	var copied = emitForwardCopy(module, func: func, cur: entry, dest: destBuf, src: src, byteCount: byteCount, ids: ids)
	emitStoreField(module, block: copied, record: record, offset: ManagedRecordLengthOffset, value: byteCount)
	module.setTerminator(copied, op: StdOp.ret(record))

	module.functions.push(func)
end 'buildSharedMemoryCopyOut'

// `__shm_close(handle, base, bytes, name)` — the publisher's teardown, which withdraws the name.
// `__shm_release` is an adopter's, which leaves the name to its publisher.
//
// ⚠ The length and the name travel because a POSIX teardown needs three steps where Win32 needs two.
// `UnmapViewOfFile` derives the extent from the base and `CloseHandle` takes the section's name with it;
// `munmap` is given a length, and a POSIX object outlives every descriptor and every mapping until
// `shm_unlink` removes its name. The segment is the only party that remembers either
// (`stdlib/SharedMemory.maxon`), and both operands are dead in the Win32 lowerings.
//
// A zero base is a no-op at the unmap, so a segment whose map failed tears down on this path untested.
function buildSharedMemoryClose(module StdModule)
	var func = IrFunction.createFromStd(SharedMemoryCloseName, returnType: StdReturnType.void, paramCount: 4, paramTypes: fourI64Params(), returnLine: 0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 4)
	let handle = 0 as ValueId
	let base = 1 as ValueId
	let bytes = 2 as ValueId
	let namePtr = 3 as ValueId

	emitSegmentRelease(module, block: entry, handle: handle, base: base, bytes: bytes)
	module.appendOp(entry, op: StdOp.osUnpublishNamedSegment(namePtr))
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildSharedMemoryClose'

function buildSharedMemoryRelease(module StdModule)
	var func = IrFunction.createFromStd(SharedMemoryReleaseName, returnType: StdReturnType.void, paramCount: 3, paramTypes: threeI64Params(), returnLine: 0)

	var entry = module.addBlock(func, label: b"entry", heat: BlockHeat.normal)

	emitParams(module, block: entry, count: 3)
	let handle = 0 as ValueId
	let base = 1 as ValueId
	let bytes = 2 as ValueId

	emitSegmentRelease(module, block: entry, handle: handle, base: base, bytes: bytes)
	module.setTerminator(entry, op: StdOp.retVoid)

	module.functions.push(func)
end 'buildSharedMemoryRelease'

// ⛔ The unmap comes first and both calls are needed. A section object stays alive while any view of it is
// mapped, so closing the handle alone keeps the section, its backing and its address range for the life of
// the process — silently, because nothing in the language counts an OS mapping.
function emitSegmentRelease(module StdModule, block IrBlock, handle ValueId, base ValueId, bytes ValueId)
	module.appendOp(block, op: StdOp.osUnmapNamedSegment(base, sizeId: bytes))
	module.appendOp(block, op: StdOp.osCloseHandle(handle))
end 'emitSegmentRelease'

export function installSharedMemoryRuntime(module StdModule, usage RuntimeUsage, target Target)
	if not usage.usesSharedMemory 'noSharedMemory'
		return
	end 'noSharedMemory'

	buildSharedMemorySegmentCall(module, call: SegmentCall.create, target: target)
	buildSharedMemorySegmentCall(module, call: SegmentCall.adopt, target: target)
	buildSharedMemorySegmentCall(module, call: SegmentCall.map, target: target)
	buildSharedMemoryReadWord(module)
	buildSharedMemoryWriteWord(module)
	buildSharedMemoryCopyOut(module)
	buildSharedMemoryClose(module)
	buildSharedMemoryRelease(module)
end 'installSharedMemoryRuntime'

export function checkSharedMemoryAnswers(signatures ProgramSignatures, stdlibPath FilePath)
	var pins = TierGeometryPinArray.create()
	pins.push(TierGeometryPin.create("the refused answer", here: SharedSegmentAnswer.refused.rawValue, named: "NoSection"))
	pins.push(TierGeometryPin.create("the name-taken answer", here: SharedSegmentAnswer.nameTaken.rawValue, named: "NameAlreadyPublished"))
	pins.push(TierGeometryPin.create("the not-yet-published answer", here: SharedSegmentAnswer.notYetPublished.rawValue, named: "NotYetPublished"))
	requireTierGeometryAgrees(pins, signatures: signatures, tierPath: stdlibPath, emitterFile: "SharedMemoryRuntime.maxon", layer: "checkSharedMemoryAnswers")
end 'checkSharedMemoryAnswers'

export function sharedMemoryStdlibFileName() returns String
	return SharedMemoryStdlibFileName
end 'sharedMemoryStdlibFileName'

// Every callee this file installs — what `scanRuntimeUsage` reads to set `usesSharedMemory`, and what
// `TargetFacilities.calleeHostFacility` refuses on a lane without the substrate. A PREFIX test rather than a
// six-way `or`, for `isConsoleRuntimeCallee`'s reason: a seventh entry point is then covered by construction
// instead of having to be remembered at two sites.
export function isSharedMemoryRuntimeCallee(callee ByteArray) returns bool
	return bytesStartWith(callee, prefix: SharedMemoryRuntimePrefix)
end 'isSharedMemoryRuntimeCallee'
