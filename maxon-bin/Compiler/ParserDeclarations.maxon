extension Parser
	// Parse the whole file into its artifact. Top-level loop: skip blank lines,
	// dispatch each declaration, stop at EOF.
	export function parseModule() returns FileParseArtifact throws SourceParseError
		// This walk is the one that reports unused typealiases at its end, so it is the one that collects
		// the uses. Set HERE rather than at `create`, because it is a property of which ENTRY POINT was
		// called and not of how the parser was built — the sweep and the real parse are built alike.
		self.isTheReportingWalk = true

		while true 'top'
			self.skipNewlines()

			if self.isEof() 'done'
				break
			end 'done'

			try self.readTopLevelDeclaration()
		end 'top'

		// ⭐ Every parameter default this file declared becomes a function HERE, with no declaration open
		// — see `parseDefaultHelpers` for why the drain is at the end and why it comes
		// before the unused-alias report below.
		try self.parseDefaultHelpers()

		// ⭐ AFTER THE HELPERS AND BEFORE ANYTHING ELSE REPORTS: the managed-value check is a question about every
		// function this file built, and a default helper is the last of them to be built.
		try self.requireNoManagedValueWasBuiltInRuntimeSource()

		// ⭐ AT THE END, AND ONLY AT THE END: "is this alias used?" is a question about the WHOLE file, so
		// it cannot be answered before the last declaration has been read. A file that threw never gets
		// here. One that abandoned a region still records its candidates, and the drain holds each whose
		// use may sit in the lost text (`TypeResolution.aSpellingOfTheAliasMayHaveBeenLost`).
		self.reportUnusedTypeAliases()

		// ⭐ **THE SAME SET, KEPT.** `reportUnusedTypeAliases` has just answered "did THIS file use its own
		// alias?" from `usedTypeNames`; `checkUnusedExports` asks "did any OTHER file use this one?", and
		// `ParseStaging.commitWrittenTypeNames` asks that of an unexported alias's own E3062.
		// Both are answered from the identical fact one scope wider. Published rather than re-derived — a
		// second walk looking for type references would be a second answer to what a written name denotes,
		// and the column that looked like an alternative (`IrFunction.valueNameIds`) is filler-bearing and
		// gave a measured wrong answer. It is the shared empty set unless this file wrote a type name, so a
		// file that names none costs nothing.
		self.artifact.usedTypeNames = self.memos.usedTypeNames.published()

		// ⭐ **THE OTHER HALF OF THE SAME PUBLICATION** — the types this file's field accesses required to be
		// VISIBLE, which no name it wrote can carry. Published beside the written names because
		// `checkUnusedExports` needs both to answer one question; kept apart because they are two facts (see
		// `ParseMemos.memberAccessedTypeNames`).
		self.artifact.memberAccessedTypeNames = self.memos.memberAccessedTypeNames.published()

		self.canonicalizeFunctionOrder()
		self.canonicalizeSignatureOrder()

		for position in 0 upto self.artifact.module.functions.count() 'eachFunction'
			let published = try self.artifact.module.functions.get(position) otherwise panic("parseModule: functions.get OOB at {position}")
			published.surrenderColumns()
		end 'eachFunction'

		return self.artifact
	end 'parseModule'

	function canonicalizeFunctionOrder()
		let module = self.artifact.module
		var ascending = true

		for i in 1 upto module.funcCount() 'eachAdjacentPair'
			if compareParsedFunctions(module.getFunc(i - 1), right: module.getFunc(i)) != Ordering.lessThan 'outOfOrder'
				ascending = false
			end 'outOfOrder'
		end 'eachAdjacentPair'

		if ascending 'alreadyCanonical'
			return
		end 'alreadyCanonical'

		let slots = FunctionSlotArray.create(module.funcCount(), zeroed: false)

		for i in 0 upto module.funcCount() 'eachFunction'
			slots.push(FunctionSlot.create(self.artifact.module.getFunc(i), oldIndex: i))
		end 'eachFunction'

		slots.sortBy(function(left FunctionSlot, right FunctionSlot) gives compareParsedFunctions(left.func, right: right.func))

		let sorted = IrFunctionArray.create(slots.count(), zeroed: false)
		let newIndexOfOld = FixedFuncIndexArray.create(slots.count())
		let live = BoolArray.create(slots.count(), zeroed: false)

		for position in 0 upto slots.count() 'eachPlaced'
			let slot = try slots.get(position) otherwise panic("canonicalizeFunctionOrder: slots.get OOB at {position}")
			sorted.push(slot.func)
			try newIndexOfOld.set(slot.oldIndex, value: position) otherwise panic("canonicalizeFunctionOrder: newIndexOfOld.set OOB at {slot.oldIndex}")
			live.push(true)
		end 'eachPlaced'

		self.artifact.module.functions = sorted
		self.artifact.valueOrigins.remapFunctionIndices(live, newIndexOfOld: newIndexOfOld)
		self.artifact.deferredChains.remapFunctionIndices(newIndexOfOld)
	end 'canonicalizeFunctionOrder'

	function canonicalizeSignatureOrder()
		self.artifact.funcSignatures.sortBy(function(left FuncSignatureEntry, right FuncSignatureEntry) gives compareFuncSignatureEntries(left, right: right))
		self.artifact.typeNameDecls.sortBy(function(left TypeNameDecl, right TypeNameDecl) gives compareTypeNameDecls(left, right: right))
		self.artifact.conformances.sortBy(function(left ConformanceDecl, right ConformanceDecl) gives compareConformanceDecls(left, right: right))
	end 'canonicalizeSignatureOrder'

	function readTopLevelDeclaration() throws SourceParseError
		let start = self.current()
		let key = positionKey(start.line, column: start.column)

		if self.abandonedRegions.contains(key) 'abandoned'
			self.skipAbandonedDeclaration()
			return
		end 'abandoned'

		self.recordReusedBlockLabels()

		let confinement = try self.confine(RegionKind.declaration) otherwise 'unconfined'
			try self.dispatchTopLevel()
			return
		end 'unconfined'

		let enclosing = self.enterRegion(AbandonableRegion.declaration(key))

		try self.dispatchTopLevel() otherwise (refusal) 'refused'
			try self.recoverRegion(refusal, confinement: confinement)
			self.skipAbandonedDeclaration()
			return
		end 'refused'

		self.openRegion = enclosing
	end 'readTopLevelDeclaration'

	function recoversRegions() returns bool
		return self.isTheReportingWalk and self.job.readsAuthorSource()
	end 'recoversRegions'

	function confine(kind RegionKind) returns Confinement throws AbsentError
		if not self.recoversRegions() 'unconfined'
			throw AbsentError.absent
		end 'unconfined'

		return Confinement.create(self.takeRewindMark(), kind: kind)
	end 'confine'

	function recoverRegion(refusal SourceParseError, confinement Confinement) throws SourceParseError
		if self.openRegion.kind() != confinement.kind 'anInnerRegionOwnsIt'
			throw refusal
		end 'anInnerRegionOwnsIt'

		let isLocal = refusalIsLocal(self, job: self.job, signatures: self.signatures)
		let region = try abandonedRegionFor(refusal, blame: self.libraryBlame, openRegion: self.openRegion, isLocal: isLocal, path: self.job.path) otherwise throw refusal

		if self.abandonedRegions.contains(region.key) 'refusedWhileSkipped'
			panic("Parser.recoverRegion: a region already abandoned refused again")
		end 'refusedWhileSkipped'

		self.rewindTo(confinement.mark)
		self.abandonedRegions.insert(region.key)
		self.artifact.abandonedRegions.push(region)
	end 'recoverRegion'

	function enterRegion(region AbandonableRegion) returns AbandonableRegion
		let enclosing = self.openRegion.clone()
		self.openRegion = region
		return enclosing
	end 'enterRegion'

	// ⭐ **WHAT AN ABORTED PARSE STILL KNOWS.** A `SourceParseError` no region confines stops the parse
	// mid-way, so its module, its spans and its value origins are half-built and must be thrown away:
	// the file contributes nothing to the merge but what this returns.
	//
	// The TYPE NAMES it declared are carried across, and not for symmetry — **because the parse error
	// is so often the collision's own CONSEQUENCE.** A `typealias Box` and a `type Box` in one file
	// make every `as Box` in it resolve to the struct, so the file dies on
	// `E3009: Cannot cast from int to struct` and the duplicate that caused it is never reported at
	// all: the diagnosis is suppressed by its own symptom, which is the exact failure
	// `commitTypeNameDecls` exists to end.
	//
	// It is sound because each entry is a FINISHED record — a name, a kind and a name-token position,
	// pushed by `dispatchTopLevel` only after its declaration parsed. There is no partial state in the
	// array to salvage, so there is nothing to decide about where the parse stopped. Copied rather
	// than aliased: two artifacts sharing one array is the hazard `IrBlock`'s header states, and this
	// path is cold.
	//
	// The regions abandoned before the parse stopped, and the refusal that stopped it, are carried as
	// well, so the memoized artifact reports them on every merge as the parse that filed it did.
	export function abortedParseArtifact(refusal ParseRefusal) returns FileParseArtifact
		let salvaged = FileParseArtifact.create(self.job.path, livesUnderStdlibDirectory: self.job.livesUnderStdlibDirectory, sourceBytes: sourceByteCountOf(self.tokens))

		for decl in self.artifact.typeNameDecls 'eachDecl'
			salvaged.typeNameDecls.push(decl)
		end 'eachDecl'

		for instance in self.artifact.genericInstanceRequests 'eachRequest'
			salvaged.genericInstanceRequests.push(instance)
		end 'eachRequest'

		for region in self.artifact.abandonedRegions 'eachRegion'
			salvaged.abandonedRegions.push(region)
		end 'eachRegion'

		salvaged.adoptHiddenTypeNames(self.artifact)
		salvaged.refusal = refusal
		return salvaged
	end 'abortedParseArtifact'

	function takeRewindMark() returns ParseRewindMark
		return ParseRewindMark.create(self.pos, openRegion: self.openRegion.clone(), blockStructureMisread: self.blockStructureMisread, libraryBlame: self.libraryBlame.clone(), atFileScope: not self.enclosingType.isType(), artifact: ArtifactMark.of(self.artifact), band: self.signatures.markParseBand(), memos: self.memos.mark(), heldAwaits: self.heldAwaits.count(), openByRefHandOffs: self.openByRefHandOffs.count(), closureEnclosingFrames: self.closureEnclosingFrames.count(), covMatchLines: self.covMatchLines.count(), covMatchCols: self.covMatchCols.count(), constEvalStack: self.constEvalStack.count(), mintedTests: self.mintedTests.count(), pendingDefaultHelpers: self.pendingDefaultHelpers.count(), pendingBareAliases: self.pendingBareAliases.count(), deferredPatternBindings: self.deferredPatternBindings.count(), declaredTypeAliases: self.declaredTypeAliasCount(), readsALaterConformer: self.readsALaterConformer)
	end 'takeRewindMark'

	function declaredTypeAliasCount() returns ElementIndex
		match self.declaredTypeAliases 'state'
			unwritten then return 0
			entries(recorded) then return recorded.count()
		end 'state'
	end 'declaredTypeAliasCount'

	function rewindTo(mark ParseRewindMark)
		self.memos.rewindTo(mark.memos)
		self.forgetRewoundCaches()
		self.artifact.rewindTo(mark.artifact)
		self.signatures.rewindParseBand(mark.band)
		self.truncateRewoundStacks(mark)

		// Reset rather than restored: sound only because every mark is taken between statements.
		// `bodyState` is not rewound at all: a body's mark is taken at function entry, and
		// `parseFunction` replays `readFunction`, which rebuilds it.
		self.statement = StatementSlots.quiescent()
		self.readsALaterConformer = mark.readsALaterConformer

		if mark.atFileScope 'betweenDeclarations'
			self.closeTypeParamScope()
			self.extensionInterfaceName = InterfaceName.none
			self.interfaceAliasScratch = self.anchors.interfaceAliases
		end 'betweenDeclarations'

		self.pos = mark.pos
		self.openRegion = mark.openRegion.clone()
		self.blockStructureMisread = mark.blockStructureMisread
		self.libraryBlame = mark.libraryBlame.clone()
		self.requireRewound(mark)
	end 'rewindTo'

	function forgetRewoundCaches()
		self.selfFieldTypes.clear()
		self.selfFieldTypesLayout.clear()
		self.forgetKindVerdicts()
	end 'forgetRewoundCaches'

	function truncateRewoundStacks(mark ParseRewindMark)
		self.heldAwaits.truncate(mark.heldAwaits)
		self.openByRefHandOffs.truncate(mark.openByRefHandOffs)
		self.closureEnclosingFrames.truncate(mark.closureEnclosingFrames)
		self.covMatchLines.truncate(mark.covMatchLines)
		self.covMatchCols.truncate(mark.covMatchCols)
		self.constEvalStack.truncate(mark.constEvalStack)
		self.mintedTests.truncate(mark.mintedTests)
		self.pendingBareAliases.truncate(mark.pendingBareAliases)
		self.deferredPatternBindings.truncate(mark.deferredPatternBindings)

		if self.pendingDefaultHelpers.count() > mark.pendingDefaultHelpers 'defaultsWereQueued'
			self.pendingDefaultHelpers.truncate(mark.pendingDefaultHelpers)
		end 'defaultsWereQueued'

		if self.declaredTypeAliasCount() > mark.declaredTypeAliases 'aliasesWereEnrolled'
			let recorded = self.declaredTypeAliasesForWrite()
			recorded.truncate(mark.declaredTypeAliases)
		end 'aliasesWereEnrolled'
	end 'truncateRewoundStacks'

	function requireRewound(mark ParseRewindMark)
		requireRewoundCount("parser pos", now: self.pos, marked: mark.pos)
		requireRewoundCount("parser heldAwaits", now: self.heldAwaits.count(), marked: mark.heldAwaits)
		requireRewoundCount("parser openByRefHandOffs", now: self.openByRefHandOffs.count(), marked: mark.openByRefHandOffs)
		requireRewoundCount("parser closureEnclosingFrames", now: self.closureEnclosingFrames.count(), marked: mark.closureEnclosingFrames)
		requireRewoundCount("parser covMatchLines", now: self.covMatchLines.count(), marked: mark.covMatchLines)
		requireRewoundCount("parser covMatchCols", now: self.covMatchCols.count(), marked: mark.covMatchCols)
		requireRewoundCount("parser constEvalStack", now: self.constEvalStack.count(), marked: mark.constEvalStack)
		requireRewoundCount("parser mintedTests", now: self.mintedTests.count(), marked: mark.mintedTests)
		requireRewoundCount("parser pendingDefaultHelpers", now: self.pendingDefaultHelpers.count(), marked: mark.pendingDefaultHelpers)
		requireRewoundCount("parser pendingBareAliases", now: self.pendingBareAliases.count(), marked: mark.pendingBareAliases)
		requireRewoundCount("parser deferredPatternBindings", now: self.deferredPatternBindings.count(), marked: mark.deferredPatternBindings)
		requireRewoundCount("parser declaredTypeAliases", now: self.declaredTypeAliasCount(), marked: mark.declaredTypeAliases)
	end 'requireRewound'

	function requestGenericInstance(instance GenericFunctionInstance)
		if self.requestedInstanceSiteKeys.contains(instance.instanceName) 'requestedAlready'
			return
		end 'requestedAlready'

		self.requestedInstanceSiteKeys.upsert(instance.instanceName, value: instance.siteKey)
		self.artifact.genericInstanceRequests.push(instance)
	end 'requestGenericInstance'

	function requestedInstanceSiteKey(instanceName ByteArray) returns immutable ByteArray throws AbsentError
		return try self.requestedInstanceSiteKeys.get(instanceName) otherwise throw AbsentError.absent
	end 'requestedInstanceSiteKey'

	// Sweep this file's tokens for every `function <name>(…) [returns <Type>]` it declares, and fold
	// what is found into the whole-program `index`. THE way the signature index is built
	// (`queryProgramSignatures` does this once per file, in source-path order); nothing else calls
	// it, and a Parser used for a sweep parses no body.
	//
	// It reads the return type through the SAME `parseOptionalReturnType` the real parse reads it
	// with. That shared routine is what keeps the sweep and the parse from drifting into two
	// opinions of what `returns X` means, which is the standing hazard of having a pre-scan at all.
	//
	// The FOLD happens here, not in the caller, because the ids the sweep interns are file-local —
	// they live in this Parser's own artifact interner, which is private and stays private. Handing
	// the caller the ids without the table they belong to is precisely the mistake this whole index
	// is built to avoid (see SignatureIndex's header on why a signature travels by name).
	//
	// Deliberately TOLERANT: it records only the exact `function NAME ( … ) returns TYPE` shape and
	// skips anything else without complaint. It is NOT a validator — the real parse runs afterwards
	// and produces the positioned diagnostic for whatever is malformed — and it must never become
	// one: a sweep that could VETO a call would reject a correct program the moment it failed to
	// recognize a declaration the parser accepts (see `CalleeReturn.undeclared`). It restores the
	// cursor, so it is invisible to everything downstream.
	export function foldDeclaredSignaturesInto(index ProgramSignatures, producers ProducerMask)
		self.collectsWithSites = true
		let entries = FuncReturnTypeEntryArray.create(0)

		// ⭐ Every `test` this file declares, for the ROSTER rather than for the type system — see
		// `recordScannedTest`. EMPTY for every file that is not a `.maxtest` file, which is every file of
		// every program that does not run `maxon test`.
		let testDecls = DiscoveredTestArray.create(0)

		// ⭐ A FILE-SCOPE declaration is never a service MESSAGE, and this array PROVES it rather than asserting
		// it: `recordScannedSignature` pushes only for a declaration that TAKES A RECEIVER, and
		// `declarationTakesReceiver` answers `false` for every declaration outside a `type` body. One per file, and
		// it ends every compile empty.
		let noMessageMethodsAtFileScope = NameRoster.create(0)
		let aliases = RangedTypeAliasArray.create(0)
		self.sweptImplementsClauses = AliasImplementsClauseArray.create(0)

		// ⭐ FUNCTION typealiases — recorded from the SAME token walk as the ranged ones, into
		// their own array (a function alias is not a ranged one). Folded whole-program so a function-typed
		// place resolves whether the alias is declared above, below, or in another file.
		let functionAliases = FunctionTypeAliasArray.create(0)

		// ⭐ Generic-instance typealiases — `IntBox = Box with Integer`, recorded from the same
		// token walk, folded whole-program so `IntBox.create` resolves to `Box.create` in any file.
		let genericAliases = GenericAliasEntryArray.create(0)
		let structs = StructLayoutArray.create(0)
		let enums = EnumLayoutArray.create(0)
		let bindings = TopLevelDeclArray.create(0)

		// ⭐ Per-function CONSUME bits — the argument-side dual of the return type, computed
		// from the SAME token walk. `recordScannedSignature` fills one entry per function whose body moves a
		// parameter into a struct field, so a call site can decide whether an owned argument is moved.
		let paramConsumes = ParamConsumeEntryArray.create(0)
		let paramReassigns = ParamReassignEntryArray.create(0)
		let globalAliasReturns = GlobalAliasReturnEntryArray.create(0)

		// ⭐ Per-function parameter DEFAULTS — the call-site dual of the return type, from
		// the SAME token walk. One entry per function that declares at least one default, so a call site can
		// decide whether an omitted argument is legal and which helper produces it.
		let paramDefaults = ParamDefaultEntryArray.create(0)

		// ⭐ Per-function `throws E` clauses — the call-site dual of the return type, from the SAME
		// token walk. One entry per THROWING function so a call site can decide whether it needs `try`.
		let throwsEntries = ThrowsClauseEntryArray.create(0)

		// ⭐ Per-function DIVERGENCE — recorded from the SAME token walk. One entry per function whose body
		// PROVABLY cannot return, so a bare call to it can be told that it ends its caller's block.
		let bodyFacts = SweptBodyFactEntryArray.create(0)

		// ⭐ Inner ranged typealiases — one entry per `typealias Idx` declared inside a generic type,
		// keyed whole-program by `base.member` so `Instance.Idx` resolves in any file.
		let innerAliases = InnerAliasEntryArray.create(0)

		// ⭐ Per-method inner-alias parameter info — one entry per method/factory that declares a bare
		// inner-alias parameter, read by the per-instance argument check at concrete call sites.
		let methodInnerAliasParams = MethodInnerAliasParamEntryArray.create(0)

		// ⭐ Interface declaration SITES — one entry per declared
		// `interface`, folded whole-program so a `where` constraint's interface and an `implements Duo with
		// Score, Weight` conformance both resolve whether `Duo` is declared above, below, or in another file.
		// A POSITION, not the declaration: see `recordScannedInterface`.
		let interfaceSites = InterfaceDeclSiteArray.create(0)

		// ⭐ Interface EXTENSION declaration SITES — one entry per `extension <Interface>`, folded whole-program
		// so `Queries.foldExtensionDeclarations` can publish each extension method's signature once the set of
		// CONFORMERS is complete. A POSITION, not the declaration: see `ExtensionDeclSite`.
		let extensionSites = ExtensionDeclSiteArray.create(0)

		// ⭐ CONFORMANCE CLAUSE sites — one entry per `type`/`enum`/`union` whose `implements` clause this
		// sweep could only read a PREFIX of, folded whole-program so a name written after a `with` still
		// reaches `conformsTo`. A POSITION, not the declaration: see `ConformanceClauseDeclSite`.
		let conformanceSites = ConformanceClauseDeclSiteArray.create(0)

		// ⭐ Every FREE function's DIRECTORY-QUALIFIED spelling — `utils.helper` for a `helper` declared
		// in `utils/` — so a `utils.helper()` written in another file can be told from a `Type.method` call of
		// the same token shape. Empty for a root-level file, which is every file in a single-directory program.
		let freeFunctionNames = NameRoster.create(0)

		let resume = self.pos
		self.pos = 0

		// ⚠ **BLOCK DEPTH, AND THE ONE ARM THAT NEEDS IT.** This loop walks every FREE-STANDING function's
		// body, and that is what makes it robust: it cannot miss a `function` keyword however malformed the
		// source around it is. `function` and `typealias` are reserved and appear nowhere but a declaration,
		// so their arms need no context at all.
		//
		// ⚠ **IT DOES NOT WALK EVERY TOKEN, AND AN ARM ADDED HERE MUST KNOW THAT.** The `type`, `enum`/
		// `union` and top-level-binding arms hand their whole construct to a `recordScanned*` routine and
		// resume PAST its `end`, so a `type`'s method bodies never reach this loop body at all. A probe that
		// must see every token belongs in its own walk (`fileNamesProducerMask`), not here — a
		// probe written as an arm here compiled, passed the whole suite, and took the compiler down
		// on the first program that used the feature inside a method.
		//
		// **`let` and `var` are different — they are the most common statements in any body.** So they,
		// and only they, are gated on depth 0. The counter tracks exactly the compiler's block syntax:
		// `function`/`if`/`while`/a non-`if` `else` open one, `end` closes one, and nothing else in the
		// parsed slice does either (a typealias, a binding, a return, a call and an assignment are all
		// single-line). The opener predicate is `opensBlockAt` — the one the loop scanner already uses —
		// rather than a second list of block keywords to fall out of step with it.
		//
		// The gate is BELT AND BRACES, not the guarantee: `declaredOutcome` panics if this scan
		// and the real parse ever disagree about which binding is top level.
		var depth = 0 as BlockDepth

		// A `[` token appears ONLY in an array literal (Maxon indexes with `.get()`, not `a[i]`), so seeing
		// one anywhere in the file's tokens means the program materializes an `Array with integer` literal.
		// The sweep interns that one well-known instance so the parser can read its giid back
		// at literal time (a bare literal has no typealias to intern from). Set here, acted on after the walk.
		var hasIntArrayLiteral = false

		// A `b"…"` token appears ONLY in a byte-string literal, so seeing one means the program materializes an
		// `Array with Byte`. The sweep interns that one well-known instance so the parser can
		// read its giid back at literal time (a byte-string, like a bare `[…]`, has no typealias to intern from).
		var hasByteStringLiteral = false

		// A MANAGED-element array literal: a `[` followed by a STRING literal is `Array with String`;
		// a `[` followed by an IDENTIFIER (a local whose type the sweep cannot see) may be a String / struct / union
		// element, so the possible aggregate instances are over-interned. The parser reads back whichever the first
		// element resolves to. A `[` + int-literal stays the int-array default and interns none of these.
		var hasStringArrayLiteral = false
		var hasAggregateArrayLiteral = false

		// A bare `Set` identifier followed by `from` is a `Set from [ints]` / `Set from ["…"]` construction
		// — the one `from`-construction the compiler parses. Its key type (int or String) is inferred from the array
		// literal, so — like a bare `[…]` — it has no typealias to intern its `Set with <key>` instance from; the
		// sweep over-interns BOTH well-known instances (int and String) for the parser to read back whichever the
		// source array resolves to. (The `[…]` of the literal itself sets `hasIntArrayLiteral` / `hasStringArrayLiteral`,
		// so the SOURCE array instance is interned too.) Set here, acted on after the walk.
		var hasSetFromLiteral = false

		// A bare `List` identifier followed by `from` is a `List from […]` construction. Its element type is the
		// array literal's, which the sweep cannot see, so the well-known scalar instances are interned here and
		// the AGGREGATE ones — one per declared struct/union — wait for the whole program
		// (`noteWellKnownInstanceNeeds`), exactly as the array literal's own do. Set here, acted on after the walk.
		var hasListFromLiteral = false

		// ⭐ **THE SIZES OF THIS FILE'S `FixedArray from […]` CONSTRUCTIONS.** A fixed array's instance is keyed by its
		// SIZE as well as its element (`SignatureIndex.FixedArrayBuiltinBaseName`), so — unlike every other
		// container's `from` — one flag cannot say which instances the file can name: the size is per SITE.
		// The sizes are collected here off the same token counter the parser will read back
		// (`arrayLiteralElementCountAt`) and handed whole to the note below, which is why this one need
		// carries a PAYLOAD where the others carry a bit. An aggregate element's instance is minted by the parse
		// (`parseFixedArrayFromConstruction`), so there is no declared-type half to walk.
		let fixedArrayFromSizes = FixedSizeArray.create(0)

		// ⭐ **THE HEAD NAMES OF THIS FILE'S `<Name> from […]` CONSTRUCTIONS.** A `FixedArray` ALIAS head builds its
		// record through an `Array` literal at the alias's element (`parseAliasedFixedArrayLiteral`), and which alias
		// a name denotes is known only once every file has folded — so the names are carried, and
		// `internWellKnownContainerInstances` interns the arrays behind the ones that turn out to be fixed arrays.
		let fromHeadNames = NameRoster.create(0)

		// A `.bytes()` — the byte view, which constructs the SAME `Array with Byte` instance a
		// `b"…"` literal does. Its instance has no typealias to intern from, so the sweep interns it and the
		// parser reads the giid back at construction time; and the sweep reads TOKENS and cannot know the
		// receiver is a String or a Character, so it OVER-interns — the same answer
		// `internLiteralContainerInstances` gives to the same limitation. An unreferenced instance has no
		// descriptor or destructor synthesized (both gate on usage), so it costs a registry entry and no codegen.
		// ⚠ Only a CHARACTER receiver reaches that emitter, so the over-intern is the
		// common case rather than the corner one — and it is still the right answer, for the reason above:
		// this walk reads tokens, and a token has no receiver.
		var hasByteViewCall = false

		// ⚠⚠ **A LAYOUT PROBE MAY NOT RIDE THE DECLARATION WALK BELOW, BECAUSE THAT WALK DOES NOT SEE EVERY
		// TOKEN.** `recordScannedType` consumes a whole `type` declaration — METHOD BODIES INCLUDED — and the
		// loop resumes past its `end` (`recordScannedEnum` is the same). A producer inside a method body is
		// therefore invisible to an arm written inside the loop, the layout goes unregistered, and the parser
		// reaches the box with no shape for it. MEASURED, on three separate programs and two separate crash
		// sites, for a `StringIndex` probe: `return text.slice(text.startIndex(),
		// length: 2)` in a method took the compiler down at `stringIndexLayoutOrPanic`, and a method that
		// merely BOUND an index took it down at `managedNameDropCallee` ("neither a declared struct nor a
		// declared enum/union"). So the probes get their OWN complete walk of the token array, which nothing
		// can skip.
		// ⇒ ONE such walk answers all of them (`fileNamesProducerMask`). The completeness the paragraph
		// above demands is a property of what the walk VISITS, not of how many walks there are.
		//
		// ⭐ **THE WALK'S ANSWER ARRIVES AS A PARAMETER, AND NOTHING ABOVE CHANGES.** It is
		// this file's own complete pass — `fileNamesProducerMask` is the only thing
		// that computes it — but the mask is a pure function of the token stream and an INTEGER, which
		// makes it the one thing this sweep produces that a memo can outlive a `Project` with. The caller
		// owns that memo because the caller is the one holding the file's content hash; see
		// `Queries.producerMaskFor`, which also states the one case it must not answer from.
		//
		// ⭐ **NEITHER `StringIndex` NOR `CharacterSet` IS AMONG THEM.** Each
		// one's producers live in a stdlib module that also DECLARES the type — so the layout arrives
		// through the ordinary declaration fold, in every program, and there is no probe to write.
		// The crash they were written against cannot recur for those types: there is
		// no per-file decision left to get wrong. The three below still name types the compiler owns outright.
		let hasManagedFileProducer = (producers and ManagedFileProducerBit) != 0
		let hasManagedDirectoryProducer = (producers and ManagedDirectoryProducerBit) != 0
		let hasManagedSocketProducer = (producers and ManagedSocketProducerBit) != 0
		let hasManagedHostResourceProducer = (producers and ManagedHostResourceProducerBit) != 0
		let hasAllCaseNamesAccess = (producers and AllCaseNamesProducerBit) != 0
		let hasAllCasesAccess = (producers and AllCasesProducerBit) != 0

		while not self.isEof() 'scan'
			if self.at(TokenKind.leftBracket) 'arrayLiteralToken'
				hasIntArrayLiteral = true
				let afterKind = self.kindAt(self.pos + 1)

				if afterKind == TokenKind.stringLiteral 'stringElement'
					hasStringArrayLiteral = true
				end 'stringElement'

				if afterKind == TokenKind.identifier 'aggregateElement'
					hasAggregateArrayLiteral = true
				end 'aggregateElement'
			end 'arrayLiteralToken'

			if self.at(TokenKind.byteStringLiteral) 'byteStringToken'
				hasByteStringLiteral = true
			end 'byteStringToken'

			if self.atContainerFromConstruction(FromHeadContainer.set) 'setFromToken'
				hasSetFromLiteral = true
			end 'setFromToken'

			if self.atContainerFromConstruction(FromHeadContainer.list) 'listFromToken'
				hasListFromLiteral = true
			end 'listFromToken'

			// A `FixedArray from […]`: record the literal's element COUNT, which is half of the instance the
			// parser will look up. A construction whose literal is unterminated is skipped here rather than
			// refused — the real parse reports it with a position (`arrayLiteralElementCountAt`), and the
			// sweep's job is to over-intern, never to diagnose.
			if self.atContainerFromConstruction(FromHeadContainer.fixedArray) and self.kindAt(self.pos + 2) == TokenKind.leftBracket 'fixedArrayFromToken'
				if let size = try self.arrayLiteralElementCountAt(self.pos + 2, anchor: self.current()) 'wellFormedLiteral'
					fixedArrayFromSizes.push(size)
				end 'wellFormedLiteral'
			end 'fixedArrayFromToken'

			if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.from and self.kindAt(self.pos + 2) == TokenKind.leftBracket 'fromHeadToken'
				fromHeadNames.push(self.current().value)
			end 'fromHeadToken'

			if self.atByteViewCall() 'bytesToken'
				hasByteViewCall = true
			end 'bytesToken'

			if depth == 0 and self.atTopLevelBindingKeyword() 'isTopLevelBinding'
				self.recordScannedBinding(bindings, qualifier: EnclosingTypeScope.fileScope, modifierAnchor: self.pos)
				continue
			end 'isTopLevelBinding'

			// A function DECLARATION — `function <name> (`, never a bare `function` keyword. A closure
			// literal spells the keyword and opens no block (see `functionDeclarationAt`); counted as a
			// declaration it would leave `depth` one too deep for the rest of the file, and every depth-0
			// gate below would stop firing.
			if self.functionDeclarationAt(self.pos) 'isFunction'
				// A function opens a block, closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParams, freeFunctionNameOut: freeFunctionNames, messageMethodNameOut: noMessageMethodsAtFileScope)
				continue
			end 'isFunction'

			// ⭐⭐ **A `test` DECLARATION — GATED ON DEPTH 0, AND UNLIKE `function` IT HAS TO BE.** `test` is an
			// ordinary IDENTIFIER (see `TestKeywordName`), and `match test 'check'` inside a body is the
			// identical two tokens — claimed here it would count a block open that the `match`'s own `end`
			// then closes, leaving `depth` one short for the rest of the file and every depth-0 gate above
			// silently stopping. At depth 0 nothing but a declaration can stand here, which is the same
			// argument the `type`/`enum` arms below make about their own reserved-but-nameable keywords.
			//
			// It opens a block closed by its own `end`, counted BEFORE the head is read exactly as the
			// `function` arm counts one; the body is then walked by this same loop.
			if depth == 0 and testDeclarationAt(self.tokens, index: self.pos) 'isTestDecl'
				depth = depth + 1
				self.recordScannedTest(entries, throwsEntries: throwsEntries, testDecls: testDecls)
				continue
			end 'isTestDecl'

			if self.atTypeAliasDeclaration() 'isTypeAlias'
				self.recordScannedTypeAlias(aliases, functionAliases: functionAliases, genericAliases: genericAliases)
				continue
			end 'isTypeAlias'

			// A `type` DECLARATION, and it is gated on depth 0 for `let`/`var`'s reason rather than
			// left ungated like `function`/`typealias`: `type` is reserved as a KEYWORD but is legal
			// as a PARAMETER NAME (`function f(type Integer)`), so a bare `type` token can appear
			// inside a parameter list. It cannot appear at depth 0 — the `function` arm above counts
			// the body open BEFORE `recordScannedSignature` reads it, and that routine skips the
			// parenthesized list wholesale — so at depth 0 a `type` token is a declaration and
			// nothing else.
			//
			// `recordScannedType` consumes the WHOLE declaration, cursor landing past its `end`, so
			// the loop's depth invariant is untouched by it and this stays ONE walk of the token
			// array. It consumes the `type` keyword before it can fail, so the cursor always
			// advances and this loop cannot spin.
			if depth == 0 and self.at(TokenKind.type) 'isTypeDecl'
				self.recordScannedType(structs, entries: entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, innerAliasOut: innerAliases, genericAliasOut: genericAliases, functionAliasOut: functionAliases, methodInnerAliasParamOut: methodInnerAliasParams, freeFunctionNameOut: freeFunctionNames, conformanceSiteOut: conformanceSites, bindingOut: bindings)
				continue
			end 'isTypeDecl'

			// An `enum`/`union` DECLARATION, gated on depth 0 for `type`'s exact reason: both are
			// reserved keywords that are nonetheless legal as PARAMETER NAMES, so a bare `enum`/`union`
			// token can sit inside a parameter list (which `recordScannedSignature` skips wholesale). At
			// depth 0 it is a declaration and nothing else. `recordScannedEnum` consumes the whole
			// declaration — cursor past its `end` — so the loop's depth invariant is untouched. The shape
			// itself is `enumDeclarationAt`'s, shared with the block-extent walk so the sweep and that walk
			// cannot disagree about where a case list begins.
			if depth == 0 and self.enumDeclarationAt(self.pos) 'isEnumDecl'
				self.recordScannedEnum(enums, entries: entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParams, freeFunctionNameOut: freeFunctionNames, conformanceSiteOut: conformanceSites, isUnion: self.at(TokenKind.union))
				continue
			end 'isEnumDecl'

			// An `interface` DECLARATION, gated on depth 0 like `type`/`enum`. It MUST be consumed whole
			// here (see `recordScannedInterface`): its bodiless method signatures would otherwise poison the
			// sweep's `function` arm and its block-depth counter.
			if depth == 0 and self.at(TokenKind.interface) 'isInterfaceDecl'
				self.recordScannedInterface(interfaceSites)
				continue
			end 'isInterfaceDecl'

			// An `extension` DECLARATION, gated on depth 0 like `type`/`enum`/`interface`. It MUST be consumed
			// whole here for `recordScannedInterface`'s reason turned inside out: its members ARE full method
			// bodies, so leaving them to the outer loop would register every one as a FREE function under its
			// bare name — `count`, not `IntList.count` — poisoning the whole-program return-type table with a
			// name no call site means.
			if depth == 0 and self.at(TokenKind.extension) 'isExtensionDecl'
				self.recordScannedExtension(extensionSites)
				continue
			end 'isExtensionDecl'

			depth = self.blockDepthAfterCursor(depth)
			self.advance()
		end 'scan'

		self.pos = resume

		index.foldFile(entries, aliases: aliases, implementsClauses: self.sweptImplementsClauses, functionAliases: functionAliases, structs: structs, enums: enums, genericAliasEntries: genericAliases, innerAliasEntries: innerAliases, methodInnerAliasParamEntries: methodInnerAliasParams, interfaceSites: interfaceSites, extensionSites: extensionSites, conformanceSites: conformanceSites, scanSites: self.descriptorScanSites, bindings: bindings, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, freeFunctionNames: freeFunctionNames, testDecls: testDecls, moduleDirectory: index.moduleDirectoryOf(self.job.path), filePath: self.job.path, fileStream: DeclTokenStream.create(PreparedTokens.create(self.tokens, respelledStarts: self.respelledStarts), job: self.job), fileTypeNames: self.artifact.typeNames, isStdlibSource: self.job.isStdlibSource)
		self.sweptImplementsClauses = AliasImplementsClauseArray.create(0)
		self.drainGenericWithSitesInto(index)

		// ⭐⭐ **WHAT THIS FILE'S TOKENS SAY THE PROGRAM WILL MATERIALIZE — NOTED, NEVER PERFORMED.**
		// Every one of these instances is one the COMPILER mints because the source names no type for it, so
		// each is a property of the PROGRAM and not of this file: a `b"…"` in two files asks for exactly what
		// one does. `ProgramSignatures.internWellKnownContainerInstances` performs the whole set once, after
		// both halves of the sweep have folded — which is what puts the array-record arms on the far side of
		// the stdlib/user CONTEST, the ordering their base name needs and could not have here.
		//
		// A `.bytes()` byte VIEW joins the byte-string literal's bit because it constructs the same
		// `Array with Byte`, and `<Enum>.allCaseNames` joins the string literal's for the same reason; neither
		// has a typealias of its own to intern from, which is the property this whole set shares.
		if (producers and MutableMarkerProducerBit) != 0 'declaresAMutableMarker'
			index.noteMutableMarkerDeclared()
		end 'declaresAMutableMarker'

		if (producers and MutableFunctionValueProducerBit) != 0 'declaresAMutableFunctionValue'
			index.noteMutableFunctionValueDeclared()
		end 'declaresAMutableFunctionValue'

		index.noteWellKnownInstanceNeeds(hasIntArrayLiteral, byteStringLiteral: hasByteStringLiteral or hasByteViewCall, stringArrayLiteral: hasStringArrayLiteral or hasAllCaseNamesAccess, aggregateArrayLiteral: hasAggregateArrayLiteral, enumAllCasesAccess: hasAllCasesAccess, setFromConstruction: hasSetFromLiteral, listFromConstruction: hasListFromLiteral, fixedArraySizes: fixedArrayFromSizes, headNames: fromHeadNames, managedFileProducer: hasManagedFileProducer, managedDirectoryProducer: hasManagedDirectoryProducer, managedSocketProducer: hasManagedSocketProducer, managedHostResourceProducer: hasManagedHostResourceProducer)
	end 'foldDeclaredSignaturesInto'

	// Is the cursor on a `let` or a `var` — the two keywords that introduce a top-level binding?
	//
	// ONE predicate, read by BOTH the declaration sweep's depth-0 gate and `dispatchTopLevel`'s
	// arm, for the reason `assignsAt` is one predicate: a keyword taught to one and not the other
	// would put the sweep's idea of what is a declaration and the parser's a keyword apart. The
	// sweep would not record the binding, and `declaredOutcome`'s drift guard would panic on a
	// program that is perfectly correct.
	function atTopLevelBindingKeyword() returns bool
		return self.at(TokenKind.let)
	end 'atTopLevelBindingKeyword'

	// ⭐ **DOES THE TOKEN AT `index` OPEN A FUNCTION DECLARATION — `function <name> (` — rather than
	// merely spell the `function` keyword?** The three-token shape IS the declaration: `parseFunction`
	// consumes `function`, a NAME and a parameter list in that order, and no clause may sit between them
	// (there is no generic-function `uses`). Two other things spell `function` and declare nothing:
	//
	//   • a CLOSURE LITERAL — `function(n Integer) gives n + c` — an expression, with no name, no `end`,
	//     and no block of its own;
	//   • an enum/union CASE NAME — `function` is a legal one (`keyword-as-case-name.md`), and READING one
	//     as a member puts the keyword in the middle of an expression.
	//
	// ⭐⭐ **THE THREE-TOKEN SHAPE IS NOT ENOUGH ON ITS OWN, AND TWO CLAUSES MAKE IT A DECLARATION:**
	//
	//   • **WHERE IT STANDS** (`declarationBeginsStatementIn`). A keyword-named case READ, followed by a
	//     word-shaped operator, followed by a parenthesized group spells `function` · <name> · `(`
	//     character for character: `if m == Marker.function and (flag or not flag) 'both'` puts `and` in
	//     the NAME slot and the group's `(` after it. MEASURED without the clause: every declaration after
	//     that line went unrecorded — a `union` declared below it earned **E2015 `a match pattern naming
	//     'found' … enum-case patterns arrive in a later wave`**, blaming an unbuilt feature for a type the
	//     index never received, and a top-level binding below it took `ProgramSignatures.recordedDeclFor`'s
	//     drift guard down as a compiler PANIC. It is the SEQUENCE and not the word `and`: any word-shaped
	//     operator (`or`, `xor`, `mod`, `is`) reaches it, which is why the cure is where a declaration may
	//     STAND rather than what may follow the keyword.
	//   • **WHAT ENCLOSES IT** (`keywordIsAName`). A match ARM spells its keyword-named case pattern at a
	//     position where a declaration may begin — `function gives (1 + 1)` is `function` · `gives` · `(`
	//     with a newline behind it — and `parseStatement` has no `function` arm, so a named function can
	//     never stand inside a match body. Only the enclosing construct separates the two, and only the
	//     block-extent walk's opener stack knows it, which is why the answer is read off that walk's memo
	//     instead of derived here. Unclaimed, the arm's `(1 + 1)` was counted as a parameter list and the
	//     two faults the first bullet measures both returned.
	//
	// ONE predicate, read by the whole-file declaration sweep, by `recordScannedType`'s body walk and by
	// `atEnumMethodStart`, for `atTopLevelBindingKeyword`'s reason: the sweep's `function` arm counts a
	// BLOCK OPEN that only a real declaration's `end` ever closes, so a keyword taught to one reader and
	// not another leaves the sweep's block depth permanently one too deep. Every later depth-0 gate then
	// fails to fire — a `type`/`enum`/`interface`/top-level `let` after a closure literal is simply never
	// recorded — and the drift guards that exist for exactly this (`requireConstructible`,
	// `ProgramSignatures.recordedDeclFor`) fire as a compiler PANIC on a correct program. Inside a type
	// body the same overshoot swallows the NEXT type's members into this one's layout, which is a wrong
	// ANSWER: the swallowed type's factory is registered under this type's name, so a call to it is typed
	// from the wrong signature.
	function functionDeclarationAt(index ElementIndex) returns bool
		return functionDeclarationShapeIn(self.tokens, index: index) and not self.keywordIsAName(index)
	end 'functionDeclarationAt'

	function topLevelDeclarationHeaders() returns TopLevelDeclarationHeaders
		let headers = TopLevelDeclarationHeaders.create()
		var depth = 0 as BlockDepth
		var at = 0 as ElementIndex

		while self.kindAt(at) != TokenKind.eof 'scan'
			if depth == 0 and topLevelBindingIn(self.tokens, index: at) 'aBinding'
				headers.bindings.push(TopLevelBindingHeader.create(self.tokenAt(at + 1).value, visibility: self.visibilityBefore(at)))
			end 'aBinding'

			if depth == 0 and typeDeclarationHeaderIn(self.tokens, index: at) 'aHeader'
				let kind = self.kindAt(at)

				if kind != TokenKind.extension 'declaresAName'
					let nameTok = self.tokenAt(at + 1)
					headers.types.push(TypeDeclarationHeader.create(nameTok.value, kind: self.headerDeclKind(at), visibility: self.visibilityBefore(at), nameLine: nameTok.line, nameColumn: nameTok.column))
				end 'declaresAName'

				if kind != TokenKind.typealias 'opensABody'
					at = self.typeBodyCloserAfter(at, membersHaveBodies: kind != TokenKind.interface) + 1
					continue
				end 'opensABody'
			end 'aHeader'

			if self.functionDeclarationAt(at) or (depth == 0 and testDeclarationAt(self.tokens, index: at)) 'aBodyOpens'
				depth = depth + 1
			end 'aBodyOpens' else 'anyOtherToken'
				depth = self.blockDepthAfter(at, depth: depth)
			end 'anyOtherToken'

			at = at + 1
		end 'scan'

		return headers
	end 'topLevelDeclarationHeaders'

	function headerDeclKind(index ElementIndex) returns TypeDeclKind
		match self.kindAt(index) 'keyword'
			type then return TypeDeclKind.structType
			enum then return TypeDeclKind.enumType
			union then return TypeDeclKind.unionType
			interface then return TypeDeclKind.interfaceType
			typealias then return self.aliasFormAt(index + 3)
			default panic("Parser.headerDeclKind: '{self.kindAt(index).rawValue}' opens no named type declaration — `typeDeclarationHeaderIn` admitted it")
		end 'keyword'
	end 'headerDeclKind'

	function aliasFormAt(rhs ElementIndex) returns TypeDeclKind
		if self.kindAt(rhs) == TokenKind.function 'aFunctionType'
			return TypeDeclKind.functionAlias
		end 'aFunctionType'

		if self.kindAt(rhs) == TokenKind.leftParen or self.capabilityAliasAt(rhs) 'aTuple'
			return TypeDeclKind.tupleAlias
		end 'aTuple'

		return TypeDeclKind.genericAlias if self.atGenericBaseName(rhs) else TypeDeclKind.rangedAlias
	end 'aliasFormAt'

	function typeBodyCloserAfter(header ElementIndex, membersHaveBodies bool) returns ElementIndex
		var depth = 0 as BlockDepth
		var q = header + 2

		while self.kindAt(q) != TokenKind.eof 'body'
			if depth == 0 and self.closesBlockAt(q) 'theBodyCloses'
				return q
			end 'theBodyCloses'

			if membersHaveBodies and self.functionDeclarationAt(q) 'aMethodOpens'
				depth = depth + 1
			end 'aMethodOpens' else 'anyOtherToken'
				depth = self.blockDepthAfter(q, depth: depth)
			end 'anyOtherToken'

			q = q + 1
		end 'body'

		return q
	end 'typeBodyCloserAfter'

	// Does an `enum`/`union` DECLARATION open at `index`? Both keywords are legal PARAMETER names, so the
	// keyword alone says nothing — `declarationBeginsStatementIn` is what makes it a declaration, exactly as
	// it is for `function`. ONE spelling, read by the declaration sweep and by the block-extent walk, whose
	// case-list rule rests on knowing where a member list begins.
	function enumDeclarationAt(index ElementIndex) returns bool
		let kind = self.kindAt(index)

		if kind != TokenKind.enum and kind != TokenKind.union 'notAnEnumKeyword'
			return false
		end 'notAnEnumKeyword'

		return declarationBeginsStatementIn(self.tokens, index: index) and self.kindAt(index + 1) == TokenKind.identifier
	end 'enumDeclarationAt'

	// ONE predicate, read by BOTH the declaration sweep (which notes the construction so its
	// well-known instances are over-interned) and `parsePrimary`'s construction arm, for the reason
	// `atTopLevelBindingKeyword` is one predicate. A function body's parse mints any other instance in
	// its band (`ProgramSignatures.openParseBand`), which the merge renumbers.
	function atContainerFromConstruction(container FromHeadContainer) returns bool
		if not (self.at(TokenKind.identifier) and self.peekKind() == TokenKind.from) 'notAFromConstruction'
			return false
		end 'notAFromConstruction'

		let head = self.constructionHeadName()
		return fromHeadIsTheBareBase(head, container: container) or self.namesContainerInstanceAlias(head, container: container)
	end 'atContainerFromConstruction'

	function atRefusedInstanceConstruction() returns bool
		if not (self.at(TokenKind.identifier) and self.peekKind() == TokenKind.from) 'notAFromConstruction'
			return false
		end 'notAFromConstruction'

		return self.aliasDenotesARefusedInstance(self.constructionHeadName())
	end 'atRefusedInstanceConstruction'

	function constructionHeadName() returns immutable ByteArray
		if self.qualifiedTypeBaseIsAt(self.pos) 'aQualifiedAliasHead'
			return self.qualifiedTypeBaseName()
		end 'aQualifiedAliasHead'

		return self.signatures.bareWrittenKey(self.current().value, readerFilePath: self.job.path)
	end 'constructionHeadName'

	function qualifiedTypeHeadAt(index ElementIndex, form TypeNameHeadForm) returns bool
		if not self.signatures.allFilesFolded or self.kindAt(index) != TokenKind.identifier or self.kindAt(index + 1) != TokenKind.dot or self.baseNamesAValueAt(index) 'notAQualifiedHead'
			return false
		end 'notAQualifiedHead'

		let dots = self.dottedChainLengthAt(index)

		if dots == 0 'noChain'
			return false
		end 'noChain'

		return match form 'form'
			reference gives true
			construction gives self.kindAt(index + dots * TokensPerQualifierSegment + 1) == TokenKind.from
		end 'form'
	end 'qualifiedTypeHeadAt'

	// Is the cursor on an `<alias> from` ARRAY construction — a name that aliases an `Array` INSTANCE,
	// immediately followed by `from`? `atContainerFromConstruction(FromHeadContainer.array)` asks its
	// ALIAS half, and ONLY that half (`fromHeadIsTheBareBase` answers no for `array`): a bare `Array
	// from […]` would state nothing the literal does not already carry, so it keeps falling through to
	// `E2004 Undefined variable 'Array'` exactly as `List`'s and `FixedArray`'s alias forms do.
	//
	// ⚠ **IT IS DELIBERATELY NOT READ BY THE DECLARATION SWEEP, WHERE THE THREE OTHER CONTAINERS
	// ARE.** The instance an alias head names was interned by its own `typealias ByteArray = Array
	// with Byte`, which the ordinary declaration fold registers whole-program before any function body
	// is parsed. There is nothing here for a sweep to pre-intern.

	// ⭐ **IS THE CURSOR ON A `<Type> from <literal>` CONSTRUCTION OF THIS FORM?** — the `Initable*Literal`
	// sugar, which is how `/specs` spells nearly every `FilePath` in the corpus (128 occurrences, and 31 of
	// `specs/filepath.md`'s own 40 cases).
	//
	// ⚠ **THE `<Type>` HALF IS "NAMES A DECLARED STRUCT".** A name no `type` declares must keep
	// falling through to `E2004 Undefined variable`, which is the answer for `Bogus from "hello"`.
	// Claiming the shape for any identifier would have replaced a correct diagnostic with a bespoke
	// one — the "no diagnostic moves" rule every arm added to `parsePrimary` is held to.
	//
	// ⚠ The collection heads — `Set`, `List`, `FixedArray` and their instance aliases, and an `Array` alias — are
	// asked first by `parsePrimary`, so the array form here serves only a declared `type` of the program's own.
	function atLiteralInitConstruction(form LiteralInitForm) returns bool
		if not (self.at(TokenKind.identifier) and self.peekKind() == TokenKind.from and self.kindAt(self.pos + 2) == literalInitOperandKind(form)) 'notTheShape'
			return false
		end 'notTheShape'

		return match self.signatures.structFor(self.current().value, readerFilePath: self.job.path) 'declared'
			declared gives true
			undeclared gives false
		end 'declared'
	end 'atLiteralInitConstruction'

	// A `.bytes(` at the cursor — the byte view, whose `Array with Byte` the sweep interns.
	//
	// ⚠ **IT DOES NOT ASK `.toByteArray(`, AND MAY NOT.** `String.toByteArray()` is `stdlib/String.maxon:156`,
	// which returns the CORPUS's own `ByteArray` — an instance the ordinary declaration fold registers in every
	// program — so asking the token here would over-intern the READING FILE's `Byte` for a call that never mints one.
	//
	// ⚠ It is asked for the whole file rather than per receiver: `Character.bytes()` is the one caller,
	// and the sweep's job is to over-intern, never to decide which receiver a token belongs to.
	function atByteViewCall() returns bool
		return self.atBuiltinMethodCall(ByteViewMethod)
	end 'atByteViewCall'

	// ⚠⚠ **WHAT AN UNREGISTERED FILE COSTS IS THE FACT EVERY PROBE ON THIS WALK RESTS ON.** MEASURED, by making a
	// `CharacterSet` probe answer `false` for every file: **8 red, every one of them a file that SPELLS `CharSet`**
	// (`error E2015: a field access on 'cs', which is declared 'unknown'` — `CharSet.create()` with no alias
	// to resolve), and nothing else. So what an unregistered file cost was **the alias and the gid, not a
	// crash**, and what the probe bought was the alias's instance interned by the sweep rather than by
	// the parse.
	// ⇒ The corpus declares the type and the alias, so both arrive through the ordinary
	// declaration fold and there is no per-file question left.
	//
	// ⚠ A missed `StringIndex` producer was measured to cost the compiler's LIFE rather than an interning
	// opportunity — the crash recorded at
	// `foldDeclaredSignaturesInto`'s probe block. **The two outcomes differ, so neither generalizes**: a
	// probe removed because its subject is corpus-declared is safe; one removed because it "looks unused" is
	// the crash.
	//
	// ⚠ Every probe here needs its OWN complete walk of the token array, because `foldDeclaredSignaturesInto`'s
	// loop is a DECLARATION walk: three of its arms (`recordScannedType`, `recordScannedEnum`,
	// `recordScannedBinding`) consume a construct whole and resume past its `end`, so a producer inside a
	// `type`'s method body never reaches the loop body. A question about the whole file is answered by reading
	// the whole file — and `fileNamesProducerMask` asks every probe on ONE such pass.

	// The `__ManagedFile` probe is `atManagedFileProducer`, the `__ManagedDirectory` one is
	// `atManagedDirectoryProducer` and the `__ManagedSocket` one is `atManagedSocketProducer`, all asked on
	// the same shared walk.

	// ⭐ **EVERY LAYOUT PROBE IN ONE WALK.**
	// Each probe needs its own COMPLETE pass over the tokens — the reason is stated at the call site and it
	// is a measured crash, not caution — but "complete" constrains WHAT is visited, not HOW MANY TIMES.
	// One walk per probe would walk the array once per question about the same tokens; this
	// asks every question per token and walks once, so the cost of the next probe is a compare rather than a
	// scan. It restores the cursor, so it is invisible to the caller.
	//
	// ⚠ It cannot stop at the first hit the way a single-probe walk does, because a later token may be the
	// only producer for a DIFFERENT probe — so it exits early only once every bit is satisfied. That makes
	// the worst case one full scan rather than one per probe, and the best case unchanged.
	//
	// Returns a bitmask rather than a struct because a struct literal is constructible only inside its own
	// type (E3076) and this needs no identity — the same reason `ParamPositionMask`/`ArgFloatMask` are masks.
	export function fileNamesProducerMask() returns ProducerMask
		let resume = self.pos
		self.pos = 0
		var mask = 0 as ProducerMask

		while not self.isEof() 'scan'
			if (mask and ManagedFileProducerBit) == 0 and self.atManagedFileProducer() 'mf'
				mask = (mask or ManagedFileProducerBit) as ProducerMask
			end 'mf'

			if (mask and ManagedDirectoryProducerBit) == 0 and self.atManagedDirectoryProducer() 'md'
				mask = (mask or ManagedDirectoryProducerBit) as ProducerMask
			end 'md'

			if (mask and ManagedSocketProducerBit) == 0 and self.atManagedSocketProducer() 'ms'
				mask = (mask or ManagedSocketProducerBit) as ProducerMask
			end 'ms'

			if (mask and ManagedHostResourceProducerBit) == 0 and self.atManagedHostResourceProducer() 'mh'
				mask = (mask or ManagedHostResourceProducerBit) as ProducerMask
			end 'mh'

			if (mask and AllCaseNamesProducerBit) == 0 and self.atStaticEnumMember(EnumAllCaseNamesMemberName) 'acn'
				mask = (mask or AllCaseNamesProducerBit) as ProducerMask
			end 'acn'

			if (mask and AllCasesProducerBit) == 0 and self.atStaticEnumMember(EnumAllCasesMemberName) 'ac'
				mask = (mask or AllCasesProducerBit) as ProducerMask
			end 'ac'

			if (mask and MutableMarkerProducerBit) == 0 and self.mutableMarkerAt(self.pos) 'mm'
				mask = (mask or MutableMarkerProducerBit) as ProducerMask
			end 'mm'

			if (mask and MutableFunctionValueProducerBit) == 0 and self.functionValueHeaderHasAMarkerAt(self.pos) 'mf'
				mask = (mask or MutableFunctionValueProducerBit) as ProducerMask
			end 'mf'

			if mask == AllProducerBits 'allFound'
				break
			end 'allFound'

			self.advance()
		end 'scan'

		self.pos = resume
		return mask
	end 'fileNamesProducerMask'

	// ⭐⭐ **IS THE CURSOR ON THE STATIC MEMBER NAMED `member`?** — asked by BOTH halves of every member of
	// this surface, and deliberately ONCE PER MEMBER: the SWEEP asks it to decide whether the file needs the
	// member's generic instance interned (`AllCaseNamesProducerBit`, `AllCasesProducerBit`), and
	// `parseEnumLiteral` asks it to decide whether to read that instance back. A shape one accepted and the
	// other declined would be a parse-time lookup for an instance nobody interned, so the two cannot be
	// allowed to spell it separately — one testing the token KIND as well as the name and the other only the name
	// would agree solely because that word cannot lex as anything but an identifier, which is a property of the
	// lexer rather than of either line.
	//
	// Asked of the MEMBER name alone and not of the `<base> .` in front of it, which is the same tolerance
	// every sweep probe has: it sees tokens, not types, so a local variable spelled `allCaseNames`
	// over-interns one registry entry and nothing more (an instance nobody names gets no descriptor and no
	// destructor — both gate on usage). Missing one, by contrast, costs the member its array at parse time.
	function atStaticEnumMember(member ByteArray) returns bool
		return self.at(TokenKind.identifier) and self.current().value.equals(member)
	end 'atStaticEnumMember'

	// ⭐ **IS THE CURSOR ON `unionCases .` — the companion HOP?** The trailing `.` is required and is what
	// separates the member from a case a union could (legally) name `unionCases`: `U.unionCases` alone denotes
	// a TYPE, which is not an expression, so the only expression spelling is `U.unionCases.<something>`.
	function atUnionCasesAccess() returns bool
		return self.atStaticEnumMember(UnionCasesMemberName) and self.kindAt(self.pos + 1) == TokenKind.dot
	end 'atUnionCasesAccess'

	// The `__ManagedFile` type name. Deliberately TOLERANT like every sweep probe: it sees the
	// identifier, not a type, so a file merely MENTIONING the name over-registers the layout rather than
	// missing one that is used.
	//
	// ⚠ **ONE probe, not one per position, and that is the point.** The corpus names this type in three
	// syntactically unrelated places — a static call (`__ManagedFile.openRead(…)`), a declared FIELD
	// (`export var file as __ManagedFile`) and a declared PARAMETER — and a probe per position is three
	// spellings of "this file needs the layout", the shape that drifts. The bare identifier covers all
	// three because every one of them writes the name.
	// ⚠ It matches EITHER name, because one call registers both (`registerManagedFileType` upserts the
	// `__ManagedMemory` alias alongside the `__ManagedFile` layout) and a file may name only the memory —
	// a helper taking `path __ManagedMemory` and forwarding it need never write `__ManagedFile`. Missing
	// that file would leave its parameter annotation unresolvable while the program that calls it compiles.
	function atManagedFileProducer() returns bool
		if not self.at(TokenKind.identifier) 'notAnIdentifier'
			return false
		end 'notAnIdentifier'

		return self.current().value.equals(ManagedFileTypeName) or self.current().value.equals(ManagedMemoryTypeName)
	end 'atManagedFileProducer'

	// The `__ManagedDirectory` type name — `atManagedFileProducer`'s twin, tolerant for its reason and
	// covering the same three positions with one bare-identifier test.
	//
	// ⚠ It is its OWN probe rather than a third name in the one above, because the two register DIFFERENT
	// things: a file that names only `__ManagedFile` must not acquire a `__ManagedDirectory` layout, and vice
	// versa. The `__ManagedMemory` alias every directory signature needs is registered by the file probe,
	// which already matches that name — so a directory-using file lights BOTH bits and needs no duplicate
	// upsert (see `ProgramSignatures.registerManagedDirectoryType`).
	function atManagedDirectoryProducer() returns bool
		if not self.at(TokenKind.identifier) 'notAnIdentifier'
			return false
		end 'notAnIdentifier'

		return self.current().value.equals(ManagedDirectoryTypeName)
	end 'atManagedDirectoryProducer'

	// The `__ManagedSocket` type name — `atManagedDirectoryProducer`'s twin, tolerant for its reason and
	// covering the same three positions (a static call, a declared FIELD, a declared PARAMETER) with one bare
	// identifier test. Its own probe rather than a third name in either sibling, because the three register
	// different layouts; the `__ManagedMemory` alias every socket signature needs is registered by the FILE
	// probe, which already matches that name.
	function atManagedSocketProducer() returns bool
		if not self.at(TokenKind.identifier) 'notAnIdentifier'
			return false
		end 'notAnIdentifier'

		return self.current().value.equals(ManagedSocketTypeName)
	end 'atManagedSocketProducer'

	function atManagedHostResourceProducer() returns bool
		if not self.at(TokenKind.identifier) 'notAnIdentifier'
			return false
		end 'notAnIdentifier'

		return isHostResourceHandleName(self.current().value)
	end 'atManagedHostResourceProducer'

	// Is the cursor on `. <name>`? The shape every "does this file call builtin method X?" sweep probe
	// asks, written once so a second probe cannot arrive with its own idea of what a method call looks
	// like. It is deliberately TOLERANT — it sees a token pair, not a receiver type — which is what makes
	// its callers OVER-intern rather than miss (see `hasByteViewCall`).
	function atBuiltinMethodCall(methodName ByteArray) returns bool
		return self.at(TokenKind.dot) and self.peekKind() == TokenKind.identifier and self.tokenAt(self.pos + 1).value.equals(methodName)
	end 'atBuiltinMethodCall'

	// The block depth after the token at the cursor. `end` FLOORS at zero rather than underflowing: a
	// stray `end` is malformed source, and the sweep is tolerant — the real parse reports it, with a
	// position. (`BlockDepth` is unsigned, so an underflow would not merely be wrong, it would take the
	// compiler down on a file it should have diagnosed.)
	function blockDepthAfterCursor(depth BlockDepth) returns BlockDepth
		if self.opensBlockAt(self.pos) 'opens'
			return depth + 1
		end 'opens'

		// `closesBlockAt` rather than a `TokenKind.end` test of its own: a keyword can be a NAME here (a
		// case-name arm `end gives …`, a member read `Kw.end`) and neither is a block close. The floor is
		// the only thing this adds — see the header.
		if self.closesBlockAt(self.pos) and depth > 0 'closes'
			return depth - 1
		end 'closes'

		return depth
	end 'blockDepthAfterCursor'

	// Cursor is AT a top-level `let`. Append the constant it declares.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the same
	// reason: a malformed declaration is the REAL parse's to report, with a position. It reads through
	// `readTopLevelBinding` — the routine the real parse reads with — so the two cannot drift on where
	// an initializer ends. That routine consumes the `let` keyword before it can fail, so the cursor
	// always advances and the caller's loop cannot spin.
	// ⚠ `qualifier` is what makes this ONE routine serve both the file-scope sweep arm and
	// `recordScannedType`'s `static` member arm — empty for the first, the enclosing type's name for
	// the second. A second recorder for static members would be a second answer to "what does the sweep
	// file this declaration under", and `declaredOutcome`'s drift guard PANICS when the real parse's answer
	// and the sweep's differ.
	//
	// ⚠ `modifierAnchor` is the declaration's FIRST keyword — the `let`/`var` at file scope, the `static`
	// inside a type body — because that is the token a visibility modifier sits immediately before. Handed
	// in rather than derived from the cursor for `visibilityBefore`'s own stated reason: the static form puts
	// a second modifier between the tier and the keyword this reader starts at.
	function recordScannedBinding(bindings TopLevelDeclArray, qualifier EnclosingTypeScope, modifierAnchor ElementIndex)
		let visibility = self.visibilityBefore(modifierAnchor)
		let decl = try self.readTopLevelBinding(visibility, qualifier: qualifier) otherwise return
		bindings.push(decl)
	end 'recordScannedBinding'

	// The visibility of the declaration whose KEYWORD sits at `keyword`, read from the token before it.
	//
	// Backwards, rather than by tracking an `export` flag forward across the scan loop: a flag would
	// have to be CLEARED on every token that is not a declaration, and the one clear that got missed
	// would silently export the next declaration — a visibility bug, which is a wrong answer about
	// what another file can see. `dispatchTopLevel` consumes `export` and the keyword adjacently, so
	// the previous token is exactly the modifier and nothing else can sit between them.
	//
	// ⚠ **IT TAKES THE KEYWORD'S INDEX RATHER THAN READING `self.pos - 1`, because ONE declaration form
	// puts a second modifier in between.** A method spells `export static function`, so its `function`
	// keyword's predecessor is `static` and the tier is one token further back — `recordScannedSignature`
	// hands the index it has already established that for, and the three callers whose cursor sits ON the
	// keyword hand `self.pos`.
	function visibilityBefore(keyword ElementIndex) returns Visibility
		if keyword == 0 'atFileStart'
			return Visibility.unexported
		end 'atFileStart'

		return visibilitySpelledBy(self.kindAt(keyword - 1))
	end 'visibilityBefore'

	// The tier of the `function` declaration whose NAME the cursor sits on — `visibilityBefore` positioned
	// past the one modifier that can sit between the tier and the keyword. `export static function create`
	// puts `static` where the tier would otherwise be, so a method's tier is one token further back; the
	// caller has already read that bit for the receiver question and hands it here rather than re-peeking.
	// ⭐⭐ **THE SWEEP'S HALF OF A `test` DECLARATION, and the two walks MUST agree about it.** The real parse
	// registers a test as an ordinary function named `__test_<sanitized>` that returns nothing and declares
	// `throws TestFailure`; this publishes exactly those facts whole-program, off the same one mint
	// (`testFunctionRegistrationName`), so nothing can file the declaration under a name the other never
	// writes.
	//
	// ⚠ **THE `throws` ENTRY IS THE LOAD-BEARING HALF.** A clause the source does not write is one the sweep
	// cannot read, and `ProgramSignatures.throwsOf` answers `none` for a name with no entry — which is what
	// a caller, the error-flag ABI and every gate keyed on "does this function throw?" would then read about
	// a function that does.
	//
	// ⚠ **NO `freeFunctionNameOut` ENTRY, DELIBERATELY.** That record exists to settle two contests about
	// what a written CALL means — `utils.helper()` as a directory-qualified free call, and one bare
	// name declared in two directories. Nothing calls a test: it is reached as a ROOT and by no edge,
	// so entering it in that contest could only make two directories' identically-named tests refuse each
	// other over a spelling no source can write.
	function recordScannedTest(entries FuncReturnTypeEntryArray, throwsEntries ThrowsClauseEntryArray, testDecls DiscoveredTestArray)
		// Cursor is ON the `test` keyword — `testDeclarationAt` established both tokens — so this lands on
		// the prose name, which is where `declaredFunctionVisibility` expects to be asked from.
		self.advance()
		let nameTok = self.current()
		let visibility = self.declaredFunctionVisibility(false)
		self.advance()

		let name = testFunctionRegistrationName(nameTok.value)
		entries.push(FuncReturnTypeEntry.create(name, returnType: MaxonReturnType.void, declaredSurface: plainDeclaredSurface(), visibility: visibility))
		throwsEntries.push(ThrowsClauseEntry.create(name, clause: ThrowsClause.throwing(TestImpliedThrowsTypeName)))

		// ⭐⭐ **THE ROSTER `maxon test` PRINTS IS MINTED HERE, BESIDE THE SIGNATURE, AND FROM THE SAME
		// TOKEN.** `DiscoveredTest` needs the mangled name, the prose, the file and the line, and this is
		// the one place all four are in hand at once — the mint is `name` above rather than a second call,
		// so the roster can never name a symbol the registries were never given. See `TestDiscovery`.
		testDecls.push(DiscoveredTest.create(name, displayName: String.from(nameTok.value), file: self.job.path, line: nameTok.line))
	end 'recordScannedTest'

	function declaredFunctionVisibility(hasStaticModifier bool) returns Visibility
		if self.pos == 0 'noKeywordBeforeTheName'
			return Visibility.unexported
		end 'noKeywordBeforeTheName'

		let keyword = self.pos - 1
		return self.visibilityBefore(keyword - 1) if hasStaticModifier else self.visibilityBefore(keyword)
	end 'declaredFunctionVisibility'

	// ⭐⭐ **RECORD A DROPPED SIGNATURE — BUT ONLY WHEN NOTHING ELSE WILL REPORT THE FAILURE.**
	//
	// ⛔⛔ **RECORDING EVERY DROP MADE E9002 CALL A USER'S TYPO A COMPILER BUG.** MEASURED: an
	// `export function broken() returns 42` inside an `extension Array`, used from another file, reported the
	// correct **E2010 `Expected 'a type' but got '42'`** AND, on the same run, an **E9002** whose own sentence
	// says malformed source cannot be the cause — the positioned report of the very thing it denied was two
	// lines above it. A 9xxx code asserting a compiler bug about a syntax error is worse than the silence it
	// replaced.
	//
	// ⇒ The discriminator is the ERROR, carried rather than inferred: `tupleElementRejected` is raised only by
	// `tupleElementError`, i.e. only by the whole-program index refusing a canonical element, and it is the
	// ONE failure the real parse does not raise again once every fold is complete. Everything else — a
	// malformed parameter list, a bad type token, an unrepresentable range — reaches the real parse moments
	// later and is reported there, with a position, which is what the tolerance was written for.
	//
	// ⚠ **THE `default` ARM RE-RAISES, WHICH IS THE ONLY SHAPE THE LANGUAGE ALLOWS AND ALSO THE RIGHT ONE.**
	// `SourceParseError` carries ~100 members and keeps gaining more, so enumerating them here would be a second
	// copy of the union, free to rot, in service of a question that is binary — and **E2046** refuses a
	// `default` that neither throws nor panics, in a VALUE match as much as a statement one (measured, both
	// spellings, on this tree). Re-raising says precisely what the arm means — *this failure is not mine to
	// attribute* — and hands it back to the tolerance that was always going to absorb it. The asymmetry is what
	// makes the classification safe in both directions: a failure wrongly re-raised merely restores the silence
	// this door replaced, while one wrongly recorded is the self-falsifying message above.
	function recordAttributableDrop(dropped SourceParseError, name ByteArray, nameTok Token) throws SourceParseError
		match dropped 'attributable'
			tupleElementRejected then self.signatures.recordDroppedSignature(name, dropped: DroppedSignature.create(nameTok.line, nameColumn: nameTok.column, filePath: self.job.path))
			default throws dropped
		end 'attributable'
	end 'recordAttributableDrop'

	// Cursor is just past `function`, ON the declared name. Append the declared return type of the
	// function that name introduces, if the declaration is well-formed enough to read one off.
	//
	// Both callers reach here only through `functionDeclarationAt`, so the `function` NAME `(` shape is
	// already established — this reader never re-asks it. (It stays TOLERANT past that point: a
	// malformed parameter list or return type is the real parse's to report, with a position.)
	//
	// The name is `declaredMethodName`'s, not the token's, so a factory inside `type Point` is
	// recorded under the very key `Point.create(3, y: 4)` will look it up by — see there.
	function readGenericTemplateAt(nameIndex ElementIndex) returns GenericFunctionTemplate throws SourceParseError
		let resume = self.pos
		let nameTok = self.tokenAt(nameIndex)
		let hasStaticModifier = nameIndex >= 1 and self.functionDeclIsStatic(nameIndex - 1)
		let takesReceiver = self.declarationTakesReceiver(hasStaticModifier)
		let key = self.declaredMethodName(nameTok)
		self.pos = nameIndex
		let visibility = self.declaredFunctionVisibility(hasStaticModifier)
		let open = nameIndex + 1
		let close = self.parenGroups.closeOf(self.tokens, open: open)

		self.pos = close + 1
		let typeParamNames = try self.readFunctionTypeParams()

		let paramNames = NameRoster.create(0)
		let paramSlots = GenericParamSlotArray.create(0)
		let paramTypeParams = TypeParamIndexArray.create(0)
		var q = parameterListStartIn(self.tokens, open: open)

		while self.kindAt(q) != TokenKind.rightParen 'eachParam'
			paramNames.push(self.tokenAt(q).value)
			let typeStart = self.paramTypeStartAfter(q)
			let typeEnd = self.skipParamType(typeStart)

			if let index = try self.bareTypeParamIndexIn(typeParamNames, typeStart: typeStart, typeEnd: typeEnd) 'namesATypeParameter'
				paramSlots.push(GenericParamSlot.typeParameter)
				paramTypeParams.push(index)
			end 'namesATypeParameter' else 'concrete'
				paramSlots.push(GenericParamSlot.concrete)
				paramTypeParams.push(ConcreteParamTypeParamIndex)
			end 'concrete'

			let itemEnd = self.paramItemEndFrom(typeEnd)

			if self.kindAt(itemEnd) != TokenKind.comma 'lastParam'
				break
			end 'lastParam'

			q = itemEnd + 1
		end 'eachParam'

		while not self.at(TokenKind.where) and not self.at(TokenKind.newline) and not self.isEof() 'toTheWhereClause'
			self.advance()
		end 'toTheWhereClause'

		var constraints = WhereConstraintArray.create(0)

		if self.at(TokenKind.where) 'constrained'
			let whereTok = self.current()
			let spelledBounds = RegionBoundArray.create(0)
			constraints = try self.readWhereClause(typeParamNames, owner: "'{String.from(key)}'", admitsAssociatedBindings: false, bounds: spelledBounds)
			try self.requireNoRegionBounds(spelledBounds, whereTok: whereTok, owner: "a function's `where` clause")
		end 'constrained'

		self.pos = resume

		return GenericFunctionTemplate.create(key, declFilePath: self.job.path, line: nameTok.line, column: nameTok.column, typeParamNames: typeParamNames, paramNames: paramNames, paramSlots: paramSlots, paramTypeParams: paramTypeParams, constraints: constraints, takesReceiver: takesReceiver, visibility: visibility, enclosingTypeName: self.enclosingTypeNameOrEmpty())
	end 'readGenericTemplateAt'

	function bareTypeParamIndexIn(typeParamNames NameRoster, typeStart ElementIndex, typeEnd ElementIndex) returns ElementIndex throws MapError
		if typeEnd != typeStart + 1 or self.kindAt(typeStart) != TokenKind.identifier 'notABareName'
			throw MapError.keyNotFound
		end 'notABareName'

		return try typeParamNames.positionOfName(self.tokenAt(typeStart).value)
	end 'bareTypeParamIndexIn'

	function recordScannedGenericTemplate(entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, bodyFacts SweptBodyFactEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut NameRoster, messageMethodNameOut NameRoster)
		let nameIndex = self.pos
		let template = try self.readGenericTemplateAt(nameIndex) otherwise 'malformedHead'
			self.pos = nameIndex
			self.skipWhereClauseToLineEnd()
			return
		end 'malformedHead'

		self.signatures.recordGenericFunctionTemplate(template)

		self.noteFreeFunctionName(self.tokenAt(nameIndex).value, into: freeFunctionNameOut)
		self.pos = nameIndex
		self.skipWhereClauseToLineEnd()
		self.recordTemplateParamReassigns(template, bareName: self.tokenAt(nameIndex).value, bodyStart: self.pos, paramsStart: nameIndex + 1, paramReassigns: paramReassigns)

		for position in 0 upto self.signatures.genericInstanceCountAt(template.siteKey()) 'eachInstance'
			self.openGenericInstance(template, position: position)
			self.pos = nameIndex
			self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut, messageMethodNameOut: messageMethodNameOut)
			self.closeGenericInstance()
		end 'eachInstance'

		self.pos = nameIndex
		self.skipWhereClauseToLineEnd()
	end 'recordScannedGenericTemplate'

	// A template's by-reference facts, read once from its own body and filed under its SITE key: every
	// instance shares the template's calling convention, and a call on an instance looks them up under that
	// key (`ProgramSignatures.byRefOfDeclaration`).
	function recordTemplateParamReassigns(template GenericFunctionTemplate, bareName immutable ByteArray, bodyStart ElementIndex, paramsStart ElementIndex, paramReassigns ParamReassignEntryArray)
		let markers = self.callAlignedMarkerFacts(paramsStart, takesReceiver: template.takesReceiver)

		if markers.written != NoParamPositions 'aMutableParameter'
			paramReassigns.push(ParamReassignEntry.create(template.siteKey(), site: template.siteKey(), info: ParamReassignInfo.create(sweptParamNamesFor(template.paramNames, takesReceiver: template.takesReceiver, selfCapability: ParamCapability.unmarked), writtenParams: markers.written, markerHeads: markers.heads, bareName: bareName, callability: self.declarationCallability())))
		end 'aMutableParameter'

		let unreadConsumes = ParamConsumeEntryArray.create(0)
		let unreadAliasReturns = GlobalAliasReturnEntryArray.create(0)
		let unreadBodyFacts = SweptBodyFactEntryArray.create(0)
		self.scanBodyFacts(template.siteKey(), declarationSite: template.siteKey(), funcBareName: bareName, paramNames: sweptParamNamesFor(template.paramNames, takesReceiver: template.takesReceiver, selfCapability: ParamCapability.unmarked), typeParamPositions: self.emptyTypeParamPositions, bodyStart: bodyStart, paramConsumes: unreadConsumes, globalAliasReturns: unreadAliasReturns, bodyFacts: unreadBodyFacts, declaresThrows: false, declaredSole: false, detectFieldStores: false, takesReceiver: template.takesReceiver, selfCapability: ParamCapability.unmarked, promiseCarriers: NoParamPositions, isolatedOpaqueParams: NoParamPositions)
	end 'recordTemplateParamReassigns'

	function openGenericInstance(template GenericFunctionTemplate, position ElementIndex)
		let instance = self.signatures.genericInstanceAt(template.siteKey(), position: position)
		self.genericBindings = GenericBindingScope.over(template.typeParamNames, bound: instance.arguments, constraints: template.constraints)
		self.genericInstanceName = GenericInstanceBody.named(instance.instanceName)
	end 'openGenericInstance'

	function closeGenericInstance()
		self.genericBindings = GenericBindingScope.empty()
		self.genericInstanceName = GenericInstanceBody.none
	end 'closeGenericInstance'

	function skipWhereClauseToLineEnd()
		while not self.at(TokenKind.newline) and not self.isEof() 'toLineEnd'
			self.advance()
		end 'toLineEnd'
	end 'skipWhereClauseToLineEnd'

	function noteFreeFunctionName(name ByteArray, into NameRoster)
		if not self.enclosingType.isType() and not name.equals(MainFunctionName) 'aFreeFunction'
			into.push(name)
		end 'aFreeFunction'
	end 'noteFreeFunctionName'

	function recordScannedSignature(entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, bodyFacts SweptBodyFactEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut NameRoster, messageMethodNameOut NameRoster)
		let nameTok = self.current()

		if not self.genericInstanceName.isInstance() and functionDeclaresTypeParamsIn(self.tokens, groups: self.parenGroups, nameIndex: self.pos) 'aGenericTemplate'
			self.recordScannedGenericTemplate(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut, messageMethodNameOut: messageMethodNameOut)
			return
		end 'aGenericTemplate'

		// ⚠ Captured NOW, at the name token: the caller has consumed `function` (at `pos - 1`), so its modifier —
		// if any — is the token before that, and `static` is what marks a receiver-less method. Read after the
		// params/return type are consumed, that peek would land inside the return type instead. Asked through the
		// SHARED `functionDeclIsStatic` (the `pos >= 1` guard keeps the `pos - 1` at the very start of a file from
		// underflowing; such a top-level `function` has an empty `enclosingType` anyway) so this scan and the
		// implicit-self sibling walk answer "does this method take `self`?" from one token-level test.
		let hasStaticModifier = self.pos >= 1 and self.functionDeclIsStatic(self.pos - 1)

		// ⭐ **THE DECLARATION'S OWN VISIBILITY TIER, from the SAME backwards read every other declaration
		// gets** — and it is captured here for `hasStaticModifier`'s reason, while the cursor still sits on the
		// name. `static` is the one modifier that comes BETWEEN `export` and the keyword (`export static
		// function`), so the tier is read one token further back when it is present; asking `visibilityBefore`
		// at the `function` token would answer `file` for every exported method in the program.
		let visibility = self.declaredFunctionVisibility(hasStaticModifier)

		// ⭐ Whether the declaration takes a receiver decides where its own parameters sit in a CALL's
		// argument list, so it is read here, once, and shared by the three facts below that are recorded
		// CALL-ALIGNED (the default scan, the consume scan) or that state the alignment itself (the entry).
		let takesReceiver = self.declarationTakesReceiver(hasStaticModifier)

		// ⭐⭐ **AND WHETHER THIS DECLARATION IS A SERVICE MESSAGE** — decided HERE, from the two facts read
		// above (the receiver and the visibility), because this is the one routine that reads both for every
		// declaration shape, and pushed onto the roster once the entry below is filed.
		// `StructLayout.messageMethodNames` owns what membership means; the caller owns whether the roster is
		// KEPT (only `recordScannedType`'s does — see each other call site for why it discards).
		let declaresAMessage = takesReceiver and isProgramWideTier(visibility) and not self.genericInstanceName.isInstance()

		self.advance()

		// The parameter list's `(` is captured before the skip so the param NAMES can be read back out of it
		// (`paramNamesIn`) — the CONSUME scan needs them, and `skipBalancedParens` only advances past them.
		let paramsStart = self.pos

		if not self.skipBalancedParens() 'malformedParams'
			return
		end 'malformedParams'

		if self.at(TokenKind.uses) 'aTypeParameterList'
			_ = try self.readFunctionTypeParams() otherwise return
		end 'aTypeParameterList'

		// ⭐ **THE RETURN TYPE's PRE-ERASURE SPELLING** — read before `parseOptionalReturnType` on
		// the next line destroys it. This is the SWEEP's copy, and it is the one a call site reads
		// (`ProgramSignatures.declaredReturnSurface`): the callee may be in another file, so only the
		// whole-program index can answer for it.
		let declaredSurface = self.returnDeclaredSurface()
		let returnAliasName = self.returnAliasSpelling()

		// ⭐ Read BEFORE the return type, so the drop below has a name to file itself under. It is a pure
		// function of the name token and the enclosing type, so reading it early cannot change what it answers.
		let funcName = try self.genericInstanceName.instanceName() otherwise self.declaredMethodName(nameTok)

		// ⭐⭐ **THE TOLERANCE STAYS, AND IT STOPS BEING SILENT FOR THE ONE FAILURE NOTHING ELSE REPORTS.** A
		// malformed return type is still the real parse's to report, with a position — this scan may not veto a
		// program it merely failed to recognize, and the drop is NOT recorded for it. But the same `otherwise`
		// was also absorbing a return type a DEFERRED fold could not canonicalize while the registries it fills
		// were still being filled, and the real parse never re-raises THAT: the method simply stops existing,
		// and the first symptom is a use of it refused as though nothing had been declared. That drop is
		// recorded, so the refusal that meets the missing member can name this declaration instead of a roster
		// (`SignatureIndex.DroppedSignature`).
		let qualifiedReturn = try self.parseOptionalReturnType() otherwise (dropped) 'droppedTheSignature'
			// Both exits publish nothing — the `otherwise` is the drop that door declined to attribute, which is
			// the malformed-source case the real parse reports with a position moments later.
			try self.recordAttributableDrop(dropped, name: funcName, nameTok: nameTok) otherwise return
			return
		end 'droppedTheSignature'

		let returnType = qualifiedReturn.returnType

		// ⭐⭐ **ONE WALK OF THE PARAMETER LIST, TWO WHOLE-PROGRAM FACTS.** The CONSUME/FEED scan (at the tail
		// of this routine, which needs the body's start) and the OPAQUE-PARAMETER record (which rides the
		// entry pushed on the next line) both read the SAME call-aligned names and the SAME per-parameter
		// type-parameter positions. Walking twice would be one declaration read two ways, with nothing
		// holding the two readings in agreement about where `self` sits — which is the alignment
		// `callAlignedInstanceParams` exists to state once.
		// ⭐⭐ **THE TWO CONSUMERS WANT TWO DIFFERENT THINGS OUT OF IT**: the swept declaration needs the SOURCE
		// list (`SweptDeclaration.paramNames`, receiver excluded), and the body sweep needs the CALL-ALIGNED one (`sweptParamNamesFor`). So the walk happens once and both are derived from it.
		//
		// A parameter can be type-parameter-typed ONLY inside a generic type's body (a non-empty `uses` list);
		// a top-level function and a non-generic type's method have none. Off the generic path the flags stay
		// empty and `paramNamesIn` skips the flag work — `TypeParamSlots` reads every missing index as a concrete slot.
		let inGenericScope = not self.enclosingTypeParams.isEmpty()
		let scannedTypeParamPositions = TypeParamSlots.create()

		if inGenericScope 'genericScope'
			if takesReceiver 'theReceiverOccupiesCallAlignedSlotZero'
				self.pushReceiverTypeParamSlot(scannedTypeParamPositions)
			end 'theReceiverOccupiesCallAlignedSlotZero'
		end 'genericScope'

		let sweptParamTypes = MaxonTypeArray.create(0)
		let sweptParamCapabilities = ParamCapabilityArray.create(0)
		let sweptParamSpellings = NameRoster.create(0)
		let declaredSelfCapability = self.receiverCapabilityAt(paramsStart)

		let sourceParamNames = self.paramNamesIn(paramsStart, typeParamPositionsOut: scannedTypeParamPositions, collectTypeParamFlags: inGenericScope, typesOut: sweptParamTypes, collectTypes: true, spellingsOut: sweptParamSpellings, capabilitiesOut: sweptParamCapabilities)
		let sweptTypeParamPositions = scannedTypeParamPositions
		let scannedParamNames = sweptParamNamesFor(sourceParamNames, takesReceiver: takesReceiver, selfCapability: declaredSelfCapability)
		let promiseCarriers = promiseCarrierPositions(sweptParamTypes, takesReceiver: takesReceiver)
		let sweptParamDefaults = self.paramDefaultMaskOf(paramsStart)
		let declaresDefaults = sweptParamDefaults != NoParamPositions
		let declaredMarkers = self.callAlignedMarkerFacts(paramsStart, takesReceiver: takesReceiver)

		if declaredMarkers.written != NoParamPositions and not self.genericInstanceName.isInstance() 'declaresMutableParams'
			paramReassigns.push(ParamReassignEntry.create(funcName, site: declarationSiteKey(self.job.path, line: nameTok.line, column: nameTok.column), info: ParamReassignInfo.create(scannedParamNames, writtenParams: declaredMarkers.written, markerHeads: declaredMarkers.heads, bareName: nameTok.value, callability: self.declarationCallability())))
		end 'declaresMutableParams'

		entries.push(FuncReturnTypeEntry.create(funcName, returnType: returnType, declaredSurface: declaredSurface, visibility: visibility, takesReceiver: takesReceiver, opaqueParams: self.opaqueParamsDeclaredBy(scannedParamNames, positions: sweptTypeParamPositions), paramNames: sourceParamNames, paramTypes: sweptParamTypes, paramSpellings: sweptParamSpellings, paramDefaults: sweptParamDefaults, returnAliasName: returnAliasName, nameLine: nameTok.line, nameColumn: nameTok.column, enclosingTypeName: self.enclosingTypeNameOrEmpty(), selfCapability: declaredSelfCapability, paramCapabilities: sweptParamCapabilities, returnCapability: qualifiedReturn.capability))

		if declaresAMessage 'aMessage'
			messageMethodNameOut.push(nameTok.value)
		end 'aMessage'

		// ⭐⭐ **EVERY FREE FUNCTION'S BARE NAME** — recorded
		// here, from the SAME token walk that records its return type, because it answers two questions only
		// the whole-program index can: is `utils.helper(…)` a directory-qualified free call or a static on a
		// `type utils`, and is this bare name declared as a free function in more than one directory?
		//
		// ⚠ **IT PUSHES THE BARE NAME, NOT THE QUALIFIED SPELLING, WHICH IS STRICTLY MORE
		// INFORMATION FOR STRICTLY LESS WORK.** `foldFile` mints the qualified spelling from the file's module
		// directory, which it needs anyway to decide the contest — so the join happens once, there, instead of
		// once here and again there. And there is no ROOT-level gate: a root declaration has no
		// qualified spelling but it is still a free function that CONTESTS a bare name, and excluding it here
		// would make the contest blind to exactly the declaration that wins it.
		//
		// A METHOD is excluded by the `enclosingType` test, not by inspecting `funcName`: it is already
		// keyed `Type.method`, whole-program and namespace-free. See
		// `ProgramSignatures.namespaceQualifiedFunctions`.
		//
		// ⚠ **`main` IS EXCLUDED.** The entry point is ONE name for the whole program: qualifying it would let
		// two directories each declare a `main` and turn a hard duplicate into two silently-accepted entry
		// points, neither of which `checkMainFunction` would find under the name it looks for.
		if not self.genericInstanceName.isInstance() 'notAnInstanceOfATemplate'
			self.noteFreeFunctionName(funcName, into: freeFunctionNameOut)
		end 'notAnInstanceOfATemplate'

		// ⭐ **PARAMETER DEFAULTS** — recorded from the SAME token walk, and the ONLY place
		// the whole program learns that a call may legally omit an argument. It also carries each
		// synthesized helper's RETURN TYPE, which is what lets a call site in another file type the
		// call it emits to that helper (`mintCallResult`) — and, since a default expression is a
		// `return` in every respect that matters here, its `let`-global-alias shape. Both ride the
		// `ParamDefaultEntry` rather than `entries` and `globalAliasReturns`: the helper's final name
		// waits on a contest only the fold can see (`ProgramSignatures.recordSweptDefaultHelpers`).
		if declaresDefaults 'someParameterDefaults'
			self.recordScannedParamDefaults(funcName, nameTok: nameTok, paramsStart: paramsStart, takesReceiver: takesReceiver, visibility: visibility, paramDefaults: paramDefaults)
		end 'someParameterDefaults'

		// The `throws E` clause follows the return type; parsed BEFORE the consume-scan so the cursor lands
		// past it. Only a THROWING function gets an entry (its absence is "does not throw"), mirroring
		// `paramConsumes` recording only consuming functions. Gated on the `throws` KEYWORD being present so
		// the overwhelmingly common non-throwing function allocates neither a `ThrowsClause.none` nor a
		// `ThrowsClauseEntry` — its cursor already sits at the block label with nothing to consume.
		// ⚠ **CAPTURED, BECAUSE A THROWING DECLARATION CAN NEVER BE A DIVERGING ONE**. A bare `try f()`
		// inside the body RE-THROWS to the caller and spells no `throw` of its own, so it is an exit path
		// the body walk below cannot see — and the `throws` clause is exactly the declaration-level
		// evidence that such a path may exist. Read here rather than re-probed at the scan, because the cursor
		// has moved past the clause by then.
		let declaresThrows = self.at(TokenKind.throws)

		if declaresThrows 'throwing'
			let throwsClause = try self.parseOptionalThrowsClause() otherwise return
			throwsEntries.push(ThrowsClauseEntry.create(funcName, clause: throwsClause))
		end 'throwing'

		if self.at(TokenKind.where) 'aWhereClause'
			self.skipWhereClauseToLineEnd()
		end 'aWhereClause'

		// ⭐ Record which SOURCE parameters are bare inner aliases, so the parser's per-instance
		// argument check can re-qualify them with a concrete receiver's instance alias at the call site. Only
		// inside a generic type that declares inner aliases, and only a method/factory that HAS such a parameter
		// gets an entry (the common case costs none). This is the ONE place the whole-program index learns a
		// method's inner-alias parameters — the return-type read above SKIPS the parameter list.
		//
		// ⚠⚠ **THE GATE IS THE DENOTATION DOOR'S OWN CONDITION, NOT THE BODY WALK'S SET, AND THE DIFFERENCE IS
		// A MISSING REFUSAL.** In an `extension` body a bare member resolves against the whole program
		// (`namesInnerAliasHere`), so the set below is EMPTY for a method that names a member some OTHER body
		// declared — and this gate then skipped the walk, the index learned no inner-alias parameter, and the
		// per-instance check had nothing to compare. **MEASURED, both spellings, on a program the type-body form
		// refuses: `WA.Idx` handed to a `WB` method compiled clean and returned 1** where the identical program
		// with the alias in `type Wrapper`'s own body is `E3005 … expected 'WB.Idx', got 'WA.Idx'`. It is
		// reachable with TWO `extension` bodies in ONE file as well as across files.
		// Both cases are `error.*-inner-alias-is-per-instance`.
		if self.scopeDeclaresAnInnerAlias() or self.innerAliasesFromIndex 'maybeInnerAliasParams'
			let innerAliasInfo = self.innerAliasParamsIn(paramsStart)

			if innerAliasInfo.hasInnerAliasMember() 'hasInnerAliasParam'
				methodInnerAliasParamOut.push(MethodInnerAliasParamEntry.create(funcName, info: innerAliasInfo))
			end 'hasInnerAliasParam'
		end 'maybeInnerAliasParams'

		// The cursor is now at the body start. Scan the body (peek-only, cursor untouched) for parameters
		// this function moves into durable storage — its CONSUME/FEED set.
		//
		// ⚠ **A RECEIVER-LESS function** (top-level function, `static` method) is scanned for BOTH the direct
		// struct-field store (`Self{f: p}`) and, inside a generic type, the type-parameter FEED; its source
		// parameter list already IS its call-site parameter list.
		//
		// ⚠ **AN INSTANCE method** (`push(item Element)`) prepends `self` as parameter 0 (`parseFunction`), so
		// the recorded facts must be CALL-ALIGNED — `SelfParamName` is prepended by the walk above so
		// `feeds[i]`/`bits[i]` name the same slot the receiver-prepending call site (`parseCallNamed`) does. A
		// direct `Self{f: p}` store in an instance method does not have to be scanned for
		// (`detectFieldStores: false`), because such a store never CONSUMES `p`.
		// ⚠ **A `Self{f: p}` STORE IS NOT A CONSUME**: it succeeds through CO-OWNERSHIP, and
		// `coOwnBorrowedForConsume` takes a second reference and deliberately does NOT poison the source
		// ("AND IT IS NOT A MOVE", at its own definition), so the parameter's consume facts are the same either
		// way. A change that made this position POISON its source would invalidate the skip.
		//
		// ⚠ **THE OPAQUE-`T` FEED SHAPES ARE SCANNED FOR ON BOTH SIDES.** A `static` that pushes its
		// type-parameter argument into a LOCAL `Array with T` and hands that array to the `Self` it returns feeds
		// just as durably as an instance method does, so `scanBodyFacts` probes for them whichever kind of
		// declaration it was handed — probing only under a literal `self` token would miss the static.
		//
		// ⭐⭐ **THE BY-REFERENCE COLUMNS COME OUT OF THE SAME WALK, OFF THE SAME NAME LIST.** A method that
		// forwards a parameter into a `mutable` one is as much a forwarder as a free function is, and a method
		// that awaits the promise it is handed owns it as much as a free function does — so both halves read every
		// declaration, through one call and one list.
		self.scanBodyFacts(funcName, declarationSite: declarationSiteKey(self.job.path, line: nameTok.line, column: nameTok.column), funcBareName: nameTok.value, paramNames: scannedParamNames, typeParamPositions: sweptTypeParamPositions, bodyStart: self.pos, paramConsumes: paramConsumes, globalAliasReturns: globalAliasReturns, bodyFacts: bodyFacts, declaresThrows: declaresThrows, declaredSole: qualifiedReturn.capability == ResultCapability.isolated, detectFieldStores: not takesReceiver, takesReceiver: takesReceiver, selfCapability: declaredSelfCapability, promiseCarriers: promiseCarriers, isolatedOpaqueParams: self.isolatedOpaqueParamMask(sweptTypeParamPositions, capabilities: sweptParamCapabilities, written: declaredMarkers.written, takesReceiver: takesReceiver))
	end 'recordScannedSignature'

	// ⭐ **THE DECLARATION'S OPAQUE-PARAMETER RECORD, OR "NONE"** — see `OpaqueParamInfo`
	// for what a call site does with it. An info is built only when at least one parameter genuinely names a
	// `uses` slot, so a generic type's methods that take no bare `T` cost nothing beyond this scan of an
	// array the sweep already filled, and a program with no generic type never enters the loop (the shared
	// empty positions array has no entries).
	function opaqueParamsDeclaredBy(paramNames NameRoster, positions TypeParamSlots) returns OpaqueParamInfo
		let typeParamCount = self.enclosingTypeParams.count()

		for i in 0 upto positions.count() 'eachParam'
			if positions.namesATypeParameter(i) 'namesATypeParameter'
				return OpaqueParamInfo.create(paramNames, positions: positions, typeParamCount: typeParamCount)
			end 'namesATypeParameter'
		end 'eachParam'

		return OpaqueParamInfo.none()
	end 'opaqueParamsDeclaredBy'

	// ⭐ **RECORD THIS FUNCTION'S PARAMETER DEFAULTS WHOLE-PROGRAM** — one
	// `ParamDefaultEntry` per function that declares at least one, and one `FuncReturnTypeEntry` per default
	// naming the synthesized helper that produces it (see `SignatureIndex.ParamDefaultInfo` for what the
	// helper is). Both must come from the SWEEP rather than from the real parse, because both answer a
	// question a CALL SITE asks about a callee that may be declared in another file: "may I omit this
	// argument?" and "what type does the helper I am about to call return?".
	//
	// The names are recorded CALL-ALIGNED — `SelfParamName` at slot 0 for an instance method — exactly as
	// `callAlignedInstanceParams` aligns the consume facts, and for that routine's reason: the call site
	// slots a label to a position in the list the RECEIVER-PREPENDING caller built. The helper's own name is
	// minted from the parameter's SOURCE position, which is the position `parseFunctionParameters` knows, so
	// the two ends of the mint need share nothing but `paramDefaultHelperName`.
	//
	// It is TOLERANT like every other routine on this walk: a parameter type it cannot read abandons the
	// whole function's defaults rather than publishing half of them, and the real parse reports the malformed
	// declaration with a position.
	//
	// A helper is published at the DECLARING function's own tier, which is the only true statement about it:
	// nobody writes its name, so no file can be refused it, and every call to it is the compiler's own mint.
	function recordScannedParamDefaults(funcName immutable ByteArray, nameTok Token, paramsStart ElementIndex, takesReceiver bool, visibility Visibility, paramDefaults ParamDefaultEntryArray)
		let names = NameRoster.create(0) as isolated NameRoster
		let producers = ParamDefaultProducerArray.create(0) as isolated ParamDefaultProducerArray
		let helpers = SweptDefaultHelperArray.create(0)

		if takesReceiver 'prependReceiver'
			names.push(SelfParamName)
			producers.push(ParamDefaultProducer.required)
		end 'prependReceiver'

		let resume = self.pos
		var q = parameterListStartIn(self.tokens, open: paramsStart)

		while true 'params'
			let paramName = self.tokenAt(q).value
			names.push(paramName)
			let typeStart = self.paramTypeStartAfter(q)
			let typeEnd = self.skipParamType(typeStart)
			let itemEnd = self.paramItemEndFrom(typeEnd)

			if self.kindAt(typeEnd) != TokenKind.equals 'noDefault'
				producers.push(ParamDefaultProducer.required)
			end 'noDefault' else 'hasDefault'
				let callerLocation = self.callerLocationDefaultAt(typeEnd, exprEnd: itemEnd)

				if isCallerLocationDefault(callerLocation) 'materializedAtEachCallSite'
					// ⭐ **A CALLER-LOCATION SLOT PUBLISHES THE KEYWORD AND NOTHING ELSE** — no helper
					// name, and so no `FuncReturnTypeEntry` either: there is no synthesized function whose
					// return type a caller could need. The parameter's own declared type is not read here
					// for the same reason, so a malformed one does not abandon this function's defaults on
					// the sweep's account — the real parse reports it with a position.
					producers.push(paramDefaultProducerOf(callerLocation))
				end 'materializedAtEachCallSite' else 'synthesizedHelper'
					// The helper RETURNS the parameter's declared type, so the default expression is typed and
					// range-checked against exactly what the parameter demands, by the ordinary `return` rules.
					self.pos = typeStart
					let paramType = try self.parseTypeReference(BarePrimitiveVoice.asAType) otherwise 'malformedType'
						self.pos = resume
						return
					end 'malformedType'

					// ⚠ **THE INDEX IS THE PARAMETER'S CALL-ALIGNED POSITION, NOT ITS SOURCE POSITION**, which for
					// an instance method differ by the prepended receiver. `producers.count()` IS that position
					// — one entry has been pushed per parameter already named, plus one for the receiver — and it
					// is also the index `ParamDefaultInfo.producerFor` is asked with, so the mint and the lookup
					// cannot key on different numbers. (They did: minted from the SOURCE index, a defaulted
					// instance method published `#0` and its declaration looked up `#1`, and the divergence
					// surfaced as a backend `call to unknown function` with no source position at all.)
					let slot = producers.count() as ParamCount
					let helperName = paramDefaultHelperName(funcName, paramIndex: slot)
					producers.push(ParamDefaultProducer.helper(helperName))

					// ⭐ **AND ITS PRE-ERASURE SPELLING RIDES TOO.** The helper's return type IS the
					// parameter's declared type, so if the parameter was written `__ManagedMemory` — or a TUPLE
					// with a buffer in a slot — the helper RETURNS that surface, and `emitCall`'s
					// `markDeclaredSurface` reads it off the whole-program index by callee name, which for this
					// callee is the entry pushed here. Hardcoded plain, a defaulted buffer parameter would hand
					// its call site a value bearing the `Array` member roster instead of the buffer's: a wrong
					// surface, which is a wrong answer rather than a compile error. Asked at `typeStart`, the one
					// place the spelling is still readable, through the same door `parseFunctionParameters` uses.
					// `slotElementsFromAliases: false` for `returnDeclaredSurface`'s reason, and it is the same
					// reason: this helper is published by the SWEEP, whose copy is the one the whole-program index
					// stores, so a SLOT's element bit read here would be how far the sweep had got.
					helpers.push(SweptDefaultHelper.create(slot, signature: FuncReturnTypeEntry.create(helperName, returnType: MaxonReturnType.value(paramType), declaredSurface: self.declaredSurfaceAt(typeStart, slotElementsFromAliases: false), visibility: visibility, enclosingTypeName: self.enclosingTypeNameOrEmpty(), returnCapability: resultCapabilityOf(self.paramCapabilityAt(self.paramCapabilityIndexAfter(q)))), aliasReturn: self.defaultHelperGlobalAliasReturn(helperName, valueStart: typeEnd + 1, exprEnd: itemEnd)))
				end 'synthesizedHelper'
			end 'hasDefault'

			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				break
			end 'endList'

			q = itemEnd + 1
		end 'params'

		self.pos = resume

		paramDefaults.push(ParamDefaultEntry.create(funcName, nameLine: nameTok.line, nameColumn: nameTok.column, info: ParamDefaultInfo.create(freeze names, producers: freeze producers), helpers: helpers))
	end 'recordScannedParamDefaults'

	// ⭐⭐ **THE `let`-GLOBAL ALIAS SEED FOR THE OTHER `return` IN THE LANGUAGE: A PARAMETER DEFAULT.** The captured expression becomes
	// the whole body of a synthesized nullary helper (`parseDefaultHelperBody`), so `f(p T = A)` hands its
	// caller precisely what `f(A)` hands it — and the two spellings must give the SAME answer to
	// "may this argument alias a `let` global's record?", which is the one thing a default may never differ from
	// the written-out argument in. Without this walk they differ in both directions:
	//
	//   • `f(p T = A)` naming the global BARE was refused outright — `ownedFormOfBorrowedValue` keeps its E2015
	//     for a helper the sweep never published, and the sweep read `return` statements only. That refusal is
	//     `ParseStaging.maxon:125` and `Project.maxon:648` in this compiler's own source, on a legal
	//     shape.
	//   • `f(p T = accessor())` naming one THROUGH A CALL was silently ACCEPTED and mutated the global, where
	//     the written-out `f(accessor())` beside it is E3207. A missed EDGE costs no refusal here, because the
	//     helper returns an already-owned call result and never reaches the promotion — so this door had to be
	//     opened for soundness and not only to lift a refusal.
	//
	// ⚠ Keyed by the name the fold files the helper under (`ProgramSignatures.recordSweptDefaultHelpers`).
	// A helper emitted under any other name has no entry here, so its
	// default is refused E2015 rather than admitted unmarked. That is the family rule holding in the one
	// place a key can be wrong: the sweep publishes ONE entry per key, and the direction it errs in is a
	// REFUSAL.
	//
	// ⚡ Four columns per default expression, unconditionally. The per-BODY twin had to be gated behind a
	// `sawAReturn` flag because every function in the program walks it; this one is reached only for a
	// parameter that declares an expression default, of which a program has tens.
	function defaultHelperGlobalAliasReturn(helperName immutable ByteArray, valueStart ElementIndex, exprEnd ElementIndex) returns DefaultHelperAliasReturn
		let returnedNames = NameRoster.create(0)
		let returnedHeads = NameRoster.create(0)
		let returnedAt = TokenIndexArray.create(0)
		let returnCalls = ForwardCallArray.create(0)
		self.noteReturnedGlobalOrForward(valueStart, regionEnd: SweptValueRegionEnd.atToken(exprEnd), returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls)

		// The same "states nothing, records nothing" gate `scanBodyFacts` raises, and it is nearly every
		// default: `= 0`, `= false`, `= ""`, `= Colour.red` all leave both columns empty.
		//
		// ⚠ **AND NO SHADOWING FILTER, WHICH IS A PROPERTY OF THE HELPER RATHER THAN AN OMISSION.**
		// `returnedNamesNotBoundHere` exists because a BODY may bind the name it returns; a default expression
		// is one expression parsed into a helper whose scope is created empty and whose parameter list is
		// empty (`parseDefaultHelperBody`), so there is nothing it could bind and no local for a name to
		// resolve to ahead of the global.
		if not GlobalAliasReturnInfo.statesAnything(returnedNames, returnCalls: returnCalls) 'statesNothing'
			return DefaultHelperAliasReturn.statesNothing
		end 'statesNothing'

		// `bareCallOnly` and no receiver: the helper is a free function whose name is in the reserved `__`
		// space with a `#` in it (`Project.paramDefaultHelperName`), so it wears its own node in the closure's
		// graph and no call any source can write reaches it. Its own forwarding EDGES are ordinary and are
		// what carries the mark up from a default that calls an accessor.
		return DefaultHelperAliasReturn.states(GlobalAliasReturnInfo.create(returnedNames, returnCalls: returnCalls, bareName: helperName, callability: DeclCallability.bareCallOnly, declFilePath: self.job.path))
	end 'defaultHelperGlobalAliasReturn'

	// Which source positions of the parameter list at `parenPos` declare a default — a peek-only,
	// allocation-free walk asked once per declared function.
	//
	// ⚠ It is a SEPARATE walk from `recordScannedParamDefaults`' and deliberately so: merged, every function
	// in the program would allocate the arrays that routine builds, on the sweep's hottest path, to
	// discover that the overwhelming majority declare no default at all. This is the same gate
	// `recordScannedSignature` puts in front of the `throws` clause and the inner-alias parameter info.
	function paramDefaultMaskOf(parenPos ElementIndex) returns ParamPositionMask
		var defaults = NoParamPositions

		let first = parameterListStartIn(self.tokens, open: parenPos)

		if self.kindAt(parenPos) != TokenKind.leftParen or self.kindAt(first) == TokenKind.rightParen 'noParams'
			return defaults
		end 'noParams'

		var q = first
		var position = 0 as ParamCount

		while true 'params'
			// A parameter past the mask's width is past the argument-slot ceiling too, which the real parse
			// refuses (E2015) whatever the defaults are.
			if position >= MaxAbiArgs 'pastTheMask'
				return defaults
			end 'pastTheMask'

			let typeEnd = self.skipParamType(self.paramTypeStartAfter(q))

			if self.kindAt(typeEnd) == TokenKind.equals 'aDefaultedParameter'
				defaults = maskWithParam(defaults, param: position)
			end 'aDefaultedParameter'

			let itemEnd = self.paramItemEndFrom(typeEnd)

			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				return defaults
			end 'endList'

			q = itemEnd + 1
			position = position + 1
		end 'params'

		panic("paramDefaultMaskOf: the parameter loop only exits by returning at the closing `)` or EOF")
	end 'paramDefaultMaskOf'

	// ⭐ **THE CALL-ALIGNED PARAMETER LIST of an instance method in a generic type** — `SelfParamName` at slot 0
	// (a concrete slot), then the source parameters, in the SAME order the receiver-prepending
	// call site pushes them (`parseCallNamed`), so a per-position consume/feed fact lands at the argument's own
	// call-site position. `typeParamPositionsOut` is filled in lockstep (self's concrete slot, then each source
	// parameter's declared position from `paramNamesIn`).
	//
	// ⚠ **THE ALIGNMENT IS SPELLED IN TWO SHARED PIECES, NOT IN THIS ONE PLACE, AND THE HEADER SAID OTHERWISE.**
	// `pushReceiverTypeParamSlot` is the POSITION half and `callAlignedFrom` the NAME half, and they must
	// straddle the parameter-list walk — so a caller that needs the walk's own SOURCE names back
	// (`recordScannedSignature`, for the swept declaration it publishes) cannot go through this wrapper and
	// calls the two halves itself. Neither half is written out at a call site, which is what keeps the two
	// scans from drifting on where `self` sits — a drift that would land a feed on the wrong parameter (a
	// wrong-consume double-free at the concrete call site). This wrapper is the transitive array-feed scan's
	// (`scanTypeMethodFeeds`) door onto them.
	function callAlignedInstanceParams(paramsStart ElementIndex, typeParamPositionsOut TypeParamSlots) returns NameRoster
		self.pushReceiverTypeParamSlot(typeParamPositionsOut)
		return callAlignedFrom(self.paramNamesIn(paramsStart, typeParamPositionsOut: typeParamPositionsOut, collectTypeParamFlags: true, typesOut: self.emptySweptParamTypes, collectTypes: false, spellingsOut: self.emptyParamSpellings, capabilitiesOut: ParamCapabilityArray.create(0)))
	end 'callAlignedInstanceParams'

	// The POSITION half of the alignment above — the receiver's slot-0 entry, which names no `uses` parameter
	// and so is a concrete slot. It is its own routine because the two halves cannot
	// be spelled together: this one has to be pushed BEFORE `paramNamesIn` appends the source parameters'
	// positions, while `callAlignedFrom` prepends to the NAMES the same walk returns. Two callers stand
	// between those two moments — this file's declaration sweep (`recordScannedSignature`, which needs the
	// SOURCE names back for the swept declaration) and `callAlignedInstanceParams` — so the receiver's slot is
	// pushed here once rather than written out at each.
	function pushReceiverTypeParamSlot(typeParamPositionsOut TypeParamSlots)
		typeParamPositionsOut.pushConcrete()
	end 'pushReceiverTypeParamSlot'

	// One walk over the body collects every fact the sweep publishes about it: which parameters it
	// takes ownership of (a field store, a promise consume door), hands on (a bare `return p`, a store of a
	// parameter that may hold a promise), feeds or passes by reference, and what it returns. They share the walk because it already
	// carries the bracket and block-depth state a second walk would have to rebuild.
	//
	// The ownership facts are a sound approximation, not an oracle. The callee-side move
	// (`moveInPayload`) refuses a parameter that is not enrolled owned, so an under-detected consume
	// is a clean E2015 rather than a double free; an over-detected one makes the callee own and drop
	// the value once while its caller was poisoned, which is stricter but sound. A parameter forwarded
	// to a consuming callee is left to the borrowed-value refusal, except one that may hold a promise: it
	// is recorded as a `ForwardedStore`, which `ProgramSignatures.closeForwardedStores` settles once every
	// file is in. A bare reference strips surrounding
	// parens as the real parse's `rhsWasBareLocalReference` does (`parenStrippedParamAt`), so the two
	// agree on what a bare-parameter value is.
	function scanBodyFacts(funcName immutable ByteArray, declarationSite immutable ByteArray, funcBareName ByteArray, paramNames NameRoster, typeParamPositions TypeParamSlots, bodyStart ElementIndex, paramConsumes ParamConsumeEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, bodyFacts SweptBodyFactEntryArray, declaresThrows bool, declaredSole bool, detectFieldStores bool, takesReceiver bool, selfCapability ParamCapability, promiseCarriers ParamPositionMask, isolatedOpaqueParams ParamPositionMask)
		// ⚠ **ONE CALL-ALIGNED NAME LIST, READ BY BOTH HALVES** (`sweptParamNamesFor` builds it). The consume
		// half and the by-reference half ask the same question of the same tokens — which parameter does this
		// name denote — and every declaration shape owes both answers: an instance method forwards a parameter
		// into a reassigning one exactly as a free function does
		// (`pass-by-reference.transitive-reassign-through-sibling-methods` is that program), and it owns the
		// promise it awaits exactly as a free function does.
		// ⭐ **THE WALK IS UNCONDITIONAL; THE PARAMETER PROBES ARE A SCOPE INSIDE IT.** The `let`-global alias question — does
		// this body RETURN a `let` global's record? — has nothing to do with parameters, and the functions that
		// ask it most are the receiverless zero-parameter accessors (`Box.get()`,
		// `CharacterSet.whitespaces`), so the walk must reach a body with no parameters at all. With the list
		// empty every parameter probe below is provably inert — each is gated on an index below a count of
		// zero, and the bracket stacks exist only to feed those probes — so such a body pays the token walk and
		// the return scan and nothing else. ⚠ Do not fold `scansParams` into the probes individually: keeping
		// it whole is what makes "what the parameter half costs" one predicate rather than five.
		let scansParams = paramNames.count() > 0

		// Every per-parameter bit column starts empty and is grown at the fact; see `setParamBit` for
		// why.
		let consumed = BoolArray.create(0) as isolated BoolArray
		var handedOn = BoolArray.create(0) as isolated BoolArray
		var forwardedStores = ForwardedStoreArray.create(0) as isolated ForwardedStoreArray

		// ⛔⛔ **WHICH PARAMETER NAMES DENOTE SOMETHING ELSE WHERE THE WALK IS STANDING.** A local that rebinds
		// a parameter's name takes the name with it, and EVERY fact read off a name has to stop there: a
		// consume attributed past the rebinding makes the caller move its argument in while the callee
		// releases the local instead, which LEAKS the argument (exit 101, no diagnostic anywhere), and a WRITE
		// attributed past it puts a by-reference cell under a parameter nothing writes — which refuses a `let`
		// argument at the call site (E3207) on a program that is legal.
		//
		// ⭐ **TWO COLUMNS, BECAUSE THE LANGUAGE HAS TWO BINDING SCOPES AND THEY EXPIRE ON DIFFERENT EVENTS.**
		// `let`/`var`/`for` and the destructuring forms bind for the rest of their BLOCK, so they expire when
		// the walk's depth comes back down. A match arm's payload (`success(v) then …`) and a closure's
		// parameters (`function(n T) gives …`) bind for a single expression, which is a LINE, so they expire
		// at the next newline. Recording the second kind in the first would leave an arm's payload shadowing
		// its SIBLING arms — and there the over-reach is a write the caller never sees, silently, where every
		// error in the other direction is a loud refusal.
		//
		// Both are grown at the first rebinding, so a body that shadows nothing carries two empty records.
		let shadowedInBlock = ParamShadowColumn.create(0)
		let shadowedOnLine = BoolArray.create(0)

		// ⭐ **THREE COLUMNS: the names this body RETURNS as a whole statement, their first SEGMENTS, and
		// the calls whose result it returns.** `returnedHeads` is the head of each name (`Box` of `Box.shared`),
		// which is what the shadowing filter compares against — a body that binds `Box` returns its own local,
		// not the global.
		//
		// ⚡ Each is FRESH rather than copy-on-written off a shared module-level empty: a column that MAY alias a
		// `let` global's record cannot be passed where it can be written (E3207), and the privatise flag that
		// would make the sharing safe is an invariant no analysis can see. A body with no `return` pays four
		// empty records for it.
		let returnedNames = NameRoster.create(0)
		let returnedHeads = NameRoster.create(0)
		let returnedAt = TokenIndexArray.create(0)
		let returnCalls = ForwardCallArray.create(0)

		// The type-parameter FEED column, EMPTY until a feed is actually recorded (`setParamFeed`) — a feed
		// requires a type-parameter-typed field, so a top-level function and a non-generic type's method (all of
		// them on the generics-free corpus) never grow it past zero and `typeParamFeedOf` reads every one of their
		// positions as `none`.
		let genericScope = self.enclosingTypeParams.count() > 0
		var feeds = TypeParamFeedArray.create(0) as isolated TypeParamFeedArray
		var any = false

		// The bracket stack: `true` for a `{` (struct literal), `false` for a `(`. A `[` is not pushed at all
		// (`trackBracketAt`). The innermost open bracket being a `{` is what distinguishes a struct-field `:`
		// from a labelled-call-argument one. ⚡ Both were SHARED EMPTIES for a body with no parameters to watch
		// — `trackBracketAt` is the only writer and it runs under `scansParams`, as does every reader — and
		// both are FRESH now, for the reason the deleted anchors' note records: `scansParams` is a flag, and a
		// name that may hold a `let` global's record may not be passed somewhere that writes it.
		let braceStack = BoolArray.create(0)
		let openBrackets = TokenIndexArray.create(0)
		var blockDepth = 0 as BlockDepth

		// ⭐⭐ **THE DIVERGENCE COLUMNS — the whole of "can this body return?", read off the same walk.** There are exactly
		// three ways out of a body that are not its tail: a `return`, a `throw`
		// (or the `otherwise throws` re-throw, which spells the OTHER keyword), and falling off the end. The
		// first two are tokens; the third is ruled out by the tail statement itself being a `panic`. The fourth
		// way — a bare `try f()` propagating the callee's error — is invisible here and is excluded at the
		// declaration by `declaresThrows`, which is the only evidence of it the sweep can hold.
		//
		// ⚠ **THE SAFE DIRECTION IS "IT RETURNS", AND EVERY UNCERTAINTY HERE RESOLVES THAT WAY.** A body this
		// declines to mark compiles exactly as it did before the fact existed; a body wrongly marked stops
		// emitting the edge control really takes, which is a wrong ANSWER with no diagnostic anywhere.
		var bodyCanExitBeforeItsTail = false

		// ⭐ **THE `return` HALF ON ITS OWN, for the can-only-throw rule.** The `panic` rule rules out all three exit keywords
		// together; the `throw` rule cannot, because its own tail spells one of them. A `return` is the only
		// keyword that is an exit NEITHER rule's tail can be, so it is the one that needs a column of its own.
		var bodySpellsAReturn = false

		// ⭐⭐ **THE FRESH-RETURN COLUMN: is EVERY `return` in this body a record literal written in the `return` itself?**
		// Seeded TRUE and only ever cleared, which is what makes it a UNIVERSAL claim over the returns rather
		// than an existential one — and it is published only alongside `bodySpellsAReturn`, so a body with no
		// `return` at all (a `void` function, a diverging one) states nothing rather than vacuously everything.
		var everyReturnIsAFreshRecord = true
		var everyReturnIsAReceiverField = true
		var everyReturnIsAFieldMoveOut = true
		let fieldMoveOutForwards = FreshReturnForwardArray.create(0)
		let fieldReturnedLocals = NameRoster.create(0)

		// The calls a forwarding `return` hands its answer straight back from, one per such return, and the
		// written NAME each one's resolution could lose to a binding of this body (`forwardHeads`, positioned by
		// `forwardHeadsAt`). Empty on every body that returns only record literals.
		let freshReturnForwards = FreshReturnForwardArray.create(0)
		let forwardHeads = NameRoster.create(0)
		let forwardHeadsAt = TokenIndexArray.create(0)

		// The names a `return <name>` hands back, each proved fresh or not after the walk
		// (`everyReturnedLocalHoldsAFreshRecord`), because its binding and every use can sit anywhere in the body.
		let returnedLocals = NameRoster.create(0)
		var atStatementStart = false
		var lastTopLevelStatement = bodyStart
		var sawATopLevelStatement = false

		// ⭐ The statement-count column: how many statements the body has at all. The construction fact is about a body that
		// is NOTHING BUT its `return`, and "the last statement is a return" cannot say that — a body whose
		// first statement mutates a parameter and whose second returns `Self{…}` matches it exactly.
		var topLevelStatements = 0 as Count
		var sawTheFunctionsOwnEnd = false

		var q = bodyStart

		while self.kindAt(q) != TokenKind.eof 'walk'
			// The function's own `end` (at block depth 0) closes the scan.
			if blockDepth == 0 and self.closesBlockAt(q) 'funcEnd'
				sawTheFunctionsOwnEnd = true
				self.noteDeclarationCloser(q, openingLabel: funcBareName, bodyStart: bodyStart)
				break
			end 'funcEnd'

			let kind = self.kindAt(q)

			// The body's statements are newline-separated, so the first token past the LAYOUT at BODY depth
			// opens a top-level statement. `atStatementStart` seeds FALSE rather than true: `bodyStart` is the
			// newline that ends a well-formed header, and a malformed declaration the tolerant sweep landed
			// mid-line on must not have that line read as a statement.
			//
			// ⚠ **A `///` DOC COMMENT IS LAYOUT HERE TOO, AND READING IT AS A STATEMENT WOULD BE SILENT.** It
			// is a token in this lexer but opens nothing, so a doc comment written as a body's LAST line would
			// otherwise become `lastTopLevelStatement` and quietly cost the `panic`/`throw` tail inferences
			// below — no diagnostic, just an exit edge the emitter stops eliding.
			if tokenKindIsSkippedLayout(kind) 'layout'
				atStatementStart = true
			end 'layout' else 'aRealToken'
				if blockDepth == 0 and atStatementStart 'aTopLevelStatementOpensHere'
					lastTopLevelStatement = q
					sawATopLevelStatement = true
					topLevelStatements = topLevelStatements + 1
				end 'aTopLevelStatementOpensHere'

				atStatementStart = false
			end 'aRealToken'

			// `throws` rides beside `throw` because they are two spellings of one exit: the divergent handler
			// form (`otherwise throws E.case`) and a `match` `default throws` both re-throw to the caller
			// without spelling `throw`. Both need an enclosing `throws` clause, so `declaresThrows` already
			// excludes every body that can hold one — this is the guard that keeps that true of a form the
			// grammar has not grown yet.
			if kind == TokenKind.return or kind == TokenKind.throw or kind == TokenKind.throws 'anExitThatIsNotTheTail'
				bodyCanExitBeforeItsTail = true
			end 'anExitThatIsNotTheTail'

			if kind == TokenKind.return 'aReturnAnywhereInThisBody'
				bodySpellsAReturn = true
			end 'aReturnAnywhereInThisBody'

			// ⭐⭐ **THE `let`-GLOBAL ALIAS SEED AND EDGE, both read off a `return` statement's own first tokens.** Probed here
			// rather than in a walk of its own because this walk already stands on every token of the body with
			// the block-depth state a second one would have to rebuild. AHEAD of the parameter probes because it
			// is the one fact this walk collects for a body that has no parameters at all.
			if kind == TokenKind.return 'returnStatement'
				self.noteReturnedGlobalOrForward(q + 1, regionEnd: sharedSweptValueLineEnd, returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls)

				// The fresh-return probe rides the same `return` token the `let`-global alias probe does, for that probe's reason: this walk already
				// stands on it, and a second walk would rebuild the block-depth state to reach the same tokens.
				//
				// ⚡ **ASKED ONLY WHILE THE CLAIM IS STILL ALIVE.** It is UNIVERSAL over the body's returns and only
				// ever cleared, so one unreadable return settles the declaration and every later probe is a token
				// walk whose answer nothing reads — and the probe is not free: it scans a record literal's or a
				// call's whole argument region looking for the match. A body returning something that is neither
				// pays one token compare.
				if everyReturnIsAFreshRecord and not self.noteFreshReturnShape(q + 1, forwards: freshReturnForwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, returnedLocals: returnedLocals) 'notAFreshRecord'
					everyReturnIsAFreshRecord = false
				end 'notAFreshRecord'

				if everyReturnIsAReceiverField and not self.returnedValueIsAReceiverField(q + 1) 'notAReceiverField'
					everyReturnIsAReceiverField = false
				end 'notAReceiverField'

				if everyReturnIsAFieldMoveOut and not self.noteFieldMoveOutReturn(q + 1, forwards: fieldMoveOutForwards, returnedLocals: fieldReturnedLocals) 'notAFieldMoveOut'
					everyReturnIsAFieldMoveOut = false
				end 'notAFieldMoveOut'
			end 'returnStatement'

			if scansParams 'aBodyWithParametersToWatch'
				// ⛔⛔ **A LOCAL THAT REBINDS A PARAMETER'S NAME ENDS THE PARAMETER'S CLAIM ON IT.** Read BEFORE
				// the bracket stacks move, so a `)` can still find its own opener — which is the only way a
				// match arm's payload is told from the call it is spelled identically to.
				self.noteParameterRebindingsAt(q, paramNames: paramNames, openBrackets: openBrackets, braceStack: braceStack, depth: blockDepth, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine)

				if kind == TokenKind.newline 'aLineEnded'
					clearParamBits(shadowedOnLine)
				end 'aLineEnded'

				self.trackBracketAt(q, braceStack: braceStack, openBrackets: openBrackets)

				// ⭐⭐ **A PROMISE CONSUME DOOR IS A CONSUME, exactly as a durable store is.** `await p` and
				// `p.cancel()` hand the parameter's green thread back to the runtime, so the frame that spells
				// either one is its owner and the caller must move it in. Ungated by `detectFieldStores`,
				// which excludes an instance method's `Self{f: p}` store on the grounds that such a store is
				// not a consume — a door is one wherever it is written.
				if let promiseDoorParam = try self.promiseConsumeDoorParamAt(q, paramNames: paramNames) 'opensAPromiseDoor'
					if paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: promiseDoorParam) 'consumedThroughAPromiseDoor'
						setParamBit(consumed, index: promiseDoorParam)
						any = true
					end 'consumedThroughAPromiseDoor'
				end 'opensAPromiseDoor'

				if let returnedParam = try self.handedBackParamAt(q, paramNames: paramNames) 'returnsAParameter'
					if paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: returnedParam) and maskHasParam(promiseCarriers, param: returnedParam) 'handedBackByAReturn'
						setParamBit(handedOn, index: returnedParam)
						any = true
					end 'handedBackByAReturn'
				end 'returnsAParameter'

				if self.notePromiseStoresAt(q, inMethod: takesReceiver, paramNames: paramNames, carriers: promiseCarriers, braceStack: braceStack, openBrackets: openBrackets, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine, handedOn: handedOn, forwardedStores: forwardedStores) 'storesAParameter'
					any = true
				end 'storesAParameter'

				if detectFieldStores and kind == TokenKind.colon and self.braceStackInnermostIsBrace(braceStack) 'fieldSep'
					if let idx = try self.consumedParamAfterColon(q, paramNames: paramNames) 'movesAParameter'
						if paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: idx) 'isParam'
							if let feedPos = try typeParamPositions.positionAt(idx) 'typeParamField'
								// ⭐ **A TYPE-PARAMETER-typed store is a FEED, not a plain consume.**
								// `Self{value: v}` on `type Box uses T` stores `v` into `T`, whose managed-ness the shared
								// body cannot see (it is opaque here). It is not excluded (the box would borrow, the caller keep
								// the +1); it records WHICH type parameter it feeds instead, so the CONCRETE call site — which
								// knows the instance's argument at that position — consumes it iff that argument OWNS managed
								// heap (`Box with String`) and borrows it otherwise (`Box with Point`).
								// The sink is the CONSTRUCTED VALUE: the store lands in a field of the `Self` this call
								// RETURNS, so the caller's value owns it and this frame must not be enrolled its owner.
								setParamFeed(feeds, index: idx, feed: TypeParamFeed.feeds(feedPos, sink: FeedSink.constructedValue))
								any = true
							end 'typeParamField' else 'plainField'
								// A NON-type-parameter field store (a monomorphic `Self{value: v}` into an `Integer` field,
								// or a direct `String`/struct field) — the callee OWNS it whatever the concrete type, so the
								// plain consume bit is set. A scalar argument makes it inert at the call site anyway.
								setParamBit(consumed, index: idx)
								any = true
							end 'plainField'
						end 'isParam'
					end 'movesAParameter'
				end 'fieldSep'

				// ⭐ **`items.push(item)` — AN OPAQUE-`T` `Array` MUTATOR IS A CALLEE-STORAGE FEED.**
				// A generic method that pushes/sets/inserts a type-parameter argument into an
				// `Array` moves that argument into that array, whose element the array OWNS (its `__managed_decref` walk
				// destroys it exactly once). The shared body cannot see the element's managed-ness — it is opaque
				// here — so the parameter is recorded as a FEED of the type parameter it fills, and the CONCRETE call
				// site consumes it iff that instance's argument owns managed heap (`Container with String`) and
				// borrows it otherwise (`Container with SmallInt`, byte-identical). Only a BARE type-parameter
				// argument is fed — a concrete element (a monomorphic `Array with String` field) already moves in at
				// the array call.
				//
				// A container MUTATOR call (`markOpaqueContainerMutatorFeeds`, receiver-blind) and a bare-field REASSIGNMENT
				// `self.saved = item` (`markOpaqueFieldReassignFeed`) are the two opaque-`T`
				// callee-storage shapes.
				//
				// ⚠ **THE REASSIGNMENT IS `self`-HEADED, AND NOT BECAUSE IMPLICIT SELF CANNOT SPELL IT**
				// (a bare field name
				// on the left of an `=` inside an instance method IS a store through the receiver, routed to
				// `parseSelfFieldAssignment` at the `binding.isSelfField` arm of the assignment parse). It is
				// `self`-headed because the SWEEP cannot tell the two apart: `self . <ident> =` is self-identifying,
				// while a bare `<ident> =` needs the enclosing type's FIELD NAMES, which are not merged into
				// `self.signatures` when this runs — and marking a local assignment as a feed would enrol a parameter
				// owned that nothing moves. So the implicit spelling records no feed.
				//
				// ⚡ Gated on `genericScope` because a feed needs a type-parameter-typed parameter and outside a
				// generic type there is none (every slot is concrete when `enclosingTypeParams` is empty) — so
				// the whole probe is skipped for every function on a generics-free program.
				if genericScope 'maybeOpaqueFeed'
					if self.markOpaqueContainerMutatorFeeds(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine) 'fedContainer'
						any = true
					end 'fedContainer'

					if kind == TokenKind.self and self.markOpaqueFieldReassignFeed(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine) 'fedField'
						any = true
					end 'fedField'
				end 'maybeOpaqueFeed'
			end 'aBodyWithParametersToWatch'

			// A rebinding lives only as long as the block that made it, so the depth coming DOWN is what hands
			// each name back to its parameter. Asked once per closing `end` rather than once per token, and free
			// on every body whose column is empty.
			let nextDepth = self.blockDepthAfter(q, depth: blockDepth)

			if nextDepth < blockDepth 'aBlockClosed'
				endParamShadowsDeeperThan(shadowedInBlock, depth: nextDepth)
			end 'aBlockClosed'

			blockDepth = nextDepth

			q = q + 1
		end 'walk'

		// ⭐⭐ **A BODY THAT CANNOT RETURN.** Every condition, in one place, because leaving any one of them
		// out is a MISCOMPILE rather than a missed diagnostic — see the columns' own header:
		//
		//   • the walk reached the declaration's OWN `end`, so the tail below really is the body's tail and
		//     not wherever a malformed body ran the scan off the end of the file;
		//   • the declaration states no `throws`, so no bare `try` inside it can propagate to the caller;
		//   • no `return`/`throw`/`throws` anywhere in it;
		//   • its LAST top-level statement is a `panic(…)`, which is what rules out falling off the end.
		//
		// ⚠ **THE TAIL TEST IS `panic (`, NOT THE KEYWORD ALONE.** A statement-position `panic` is the abort
		// statement whatever follows it, but the pairing is what says the scan is standing where it thinks it
		// is; a lone keyword at a line start is a malformed body the real parse is about to report.
		if sawTheFunctionsOwnEnd and not declaresThrows and not bodyCanExitBeforeItsTail and sawATopLevelStatement and self.kindAt(lastTopLevelStatement) == TokenKind.panic and self.kindAt(lastTopLevelStatement + 1) == TokenKind.leftParen 'neverReturns'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.leavesByPanicking))
		end 'neverReturns'

		// ⭐⭐ **A BODY THAT CAN ONLY EVER THROW.** The rule above one way out over, and every condition is
		// here for the same reason it is there — leaving one out is a MISCOMPILE, not a missed diagnostic:
		//
		//   • the walk reached the declaration's OWN `end`, so the tail below really is the body's tail;
		//   • the declaration DOES state `throws` — the inverse of the `panic` rule's column, and for the
		//     inverse reason. A tail `throw` needs the clause, so its absence means the scan is not standing in
		//     the body it thinks it is; and a bare `try` propagating a callee's error, which the `panic` rule
		//     must exclude because it cannot see it, needs no exclusion here — propagating IS throwing, one more
		//     way of leaving that is not a return;
		//   • no `return` anywhere in it. `throw`/`throws` are deliberately NOT excluded (the tail is one, and a
		//     `default throws` re-throw is another exit by the error edge), so this is the ONE column the two
		//     rules cannot share;
		//   • its LAST top-level statement is a `throw`, which is what rules out falling off the end.
		//
		// ⚠ **THE TAIL TEST NEEDS NO PAIRING TOKEN, WHERE THE `panic` ONE DOES.** `panic` is a call and its `(`
		// is what says the scan is standing on a statement rather than on a stray keyword; `throw` is a statement
		// keyword the grammar admits nowhere else, so its own kind carries that.
		if sawTheFunctionsOwnEnd and declaresThrows and not bodySpellsAReturn and sawATopLevelStatement and self.kindAt(lastTopLevelStatement) == TokenKind.throw 'alwaysThrows'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.leavesByThrowing))
		end 'alwaysThrows'

		// ⭐⭐ **EVERY `return` HANDS BACK A RECORD THIS BODY JUST BUILT.** Three conditions, and the second is
		// what stops the universal claim being vacuous:
		//
		//   • the walk reached the declaration's OWN `end`, so every `return` of this body was seen — the same
		//     condition the two rules above open with, and for the identical reason: a scan that ran off the end
		//     of a malformed body has not seen the statements it is about to make a claim over;
		//   • the body SPELLS a `return`. A body with none states nothing, because "every return is fresh" is
		//     trivially true of no returns at all and the caller would read it as a promise about a value;
		//   • every local a `return` names was bound to a fresh record and never handed a second reference.
		//
		// ⚠ **`throws` IS NOT EXCLUDED, UNLIKE THE `panic` RULE ONE PARAGRAPH UP.** A body that may throw still
		// hands back a fresh record on the path that returns one, and the caller adopting it is the only party
		// that reaches this fact — the error edge carries no value for it to be wrong about.
		if declaredSole 'theDeclarationSaysSole'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.returnsAFreshRecord))
		end 'theDeclarationSaysSole' else if sawTheFunctionsOwnEnd and bodySpellsAReturn and everyReturnIsAFreshRecord and (returnedLocals.count() == 0 or self.everyReturnedLocalHoldsAFreshRecord(returnedLocals, bodyStart: bodyStart, forwards: freshReturnForwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, boundParams: NameRoster.create(0), binding: ReturnedLocalBinding.freshRecord)) 'returnsAFreshRecord'
			// ⭐ **AN UNCONDITIONAL CLAIM ONLY WHEN NO RETURN FORWARDED.** With a forward in the list the body's
			// freshness is the CALLEES', and the one entry below says so — carrying every forwarding return's
			// call, closed whole-program by `ProgramSignatures.closeFreshReturnForwards`. Publishing both would be
			// a claim and a condition on the same declaration, and the unconditional one would win.
			if freshReturnForwards.count() == 0 'everyReturnBuiltItsOwn'
				bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.returnsAFreshRecord))
			end 'everyReturnBuiltItsOwn' else if self.noForwardHeadIsBoundHere(forwardHeads, forwardHeadsAt: forwardHeadsAt, bodyStart: bodyStart, paramNames: paramNames) 'someReturnHandedTheCalleesBack'
				bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.returnsAFreshRecordIfCalleeDoes(freshReturnForwards.clone())))
			end 'someReturnHandedTheCalleesBack'
		end 'returnsAFreshRecord'

		if sawTheFunctionsOwnEnd and bodySpellsAReturn and everyReturnIsAReceiverField and takesReceiver and paramNames.count() == 0 and not declaresThrows and not genericScope 'returnsAReceiverField'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.returnsAFieldOfItsReceiver))
		end 'returnsAReceiverField'

		if sawTheFunctionsOwnEnd and bodySpellsAReturn and everyReturnIsAFreshRecord and freshReturnForwards.count() == 0 and namesIncludeAParameter(returnedLocals, paramNames: paramNames) and self.everyReturnedLocalHoldsAFreshRecord(returnedLocals, bodyStart: bodyStart, forwards: freshReturnForwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, boundParams: paramNames, binding: ReturnedLocalBinding.freshRecord) 'returnsAParameterOrARecord'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.returnsAParameter))
		end 'returnsAParameterOrARecord'

		if sawTheFunctionsOwnEnd and bodySpellsAReturn and everyReturnIsAFieldMoveOut and (fieldReturnedLocals.count() == 0 or self.everyReturnedLocalHoldsAFreshRecord(fieldReturnedLocals, bodyStart: bodyStart, forwards: fieldMoveOutForwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, boundParams: NameRoster.create(0), binding: ReturnedLocalBinding.fieldMoveOut)) 'returnsAMovedOutElement'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.returnsAMovedOutElementIfFieldDoes(fieldMoveOutForwards)))
		end 'returnsAMovedOutElement'

		// ⭐⭐ **THE BODY IS THE CONSTRUCTION IT PERFORMS.** Five conditions, and every one of them is what
		// makes a CALL to this declaration substitutable by that construction:
		//
		//   • the walk reached the declaration's OWN `end`, so the statement below really is the whole body —
		//     the condition the three rules above open with, for their reason;
		//   • the body has exactly ONE top-level statement, so nothing runs before or after the construction;
		//   • that statement is a `return`, and `noteConstructsFromParams` proves the returned expression is a
		//     record literal writing each of this declaration's parameters into the field of its own name;
		//   • it declares no `throws`, so the call the fold removes has no error edge a caller was reading;
		//   • it takes NO RECEIVER. `Self{…}` is a static factory's shape, and an instance method's parameter
		//     list carries a receiver this scan's name list does not distinguish from a declared parameter.
		if sawTheFunctionsOwnEnd and not declaresThrows and not takesReceiver and topLevelStatements == 1 and self.kindAt(lastTopLevelStatement) == TokenKind.return and self.noteConstructsFromParams(lastTopLevelStatement + 1, paramNames: paramNames) 'constructsFromItsParameters'
			bodyFacts.push(SweptBodyFactEntry.create(funcName, takesReceiver: takesReceiver, fact: SweptBodyFact.constructsSelfFromItsParameters))
		end 'constructsFromItsParameters'

		if self.markIsolatedOpaqueParamFeeds(isolatedOpaqueParams, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: feeds) 'anIsolatedOpaqueParameter'
			any = true
		end 'anIsolatedOpaqueParameter'

		if selfCapability == ParamCapability.consuming 'aConsumingReceiver'
			setParamBit(consumed, index: ReceiverParamPosition)
			any = true
		end 'aConsumingReceiver'

		if any 'consumes'
			paramConsumes.push(ParamConsumeEntry.create(funcName, site: declarationSite, info: ParamConsumeInfo.create(paramNames, bits: freeze consumed, feeds: freeze feeds, handedOn: freeze handedOn, forwardedStores: freeze forwardedStores)))
		end 'consumes'

		// ⚡ **NOTHING IS BUILT FOR A BODY THAT STATES NOTHING** — the predicate is asked of the raw COLUMNS,
		// ahead of the record, because building the record to ask it cost a `GlobalAliasReturnInfo` and a
		// `DeclCallability` per swept declaration to discover that neither was wanted.
		if GlobalAliasReturnInfo.statesAnything(returnedNames, returnCalls: returnCalls) 'returnedANameOrACall'
			// ⭐ **THE SHADOWING FILTER RUNS ONLY FOR A BODY THAT RETURNED A BARE NAME** — not for one that
			// merely returns a call, and not at all for one that returns neither. See
			// `returnedNamesNotBoundHere` for what it decides and which way it errs.
			//
			// ⚠ **THIS USED TO SAY *"a handful of functions in a program and none at all in most"*, AND THAT
			// WAS NEVER MEASURED.** `return EmptySourceText` and `return SomeConstant` are ordinary, so the
			// population is bodies-returning-an-unbound-name, not accessors-returning-a-global — the same
			// over-estimate `sawGlobalNameReturn` makes, one tier down. What IS measured is the price: a
			// SECOND O(tokens) walk of the body plus two arrays, per such body. It stands because the
			// alternative — carrying the names bound so far through the first walk — costs a per-body set and
			// an insert per binder, which is more than one allocation-free re-walk.
			let unshadowed = self.returnedNamesNotBoundHere(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, bodyStart: bodyStart, paramNames: paramNames) if returnedNames.count() > 0 else returnedNames

			// Asked a second time because the FILTER can empty the name column: a body whose only `return` named
			// a local of its own states nothing after all, and must not reach the map.
			if GlobalAliasReturnInfo.statesAnything(unshadowed, returnCalls: returnCalls) 'mayHandBackAGlobalsRecord'
				globalAliasReturns.push(GlobalAliasReturnEntry.create(funcName, info: GlobalAliasReturnInfo.create(unshadowed, returnCalls: returnCalls, bareName: funcBareName, callability: self.declarationCallability(), declFilePath: self.job.path)))
			end 'mayHandBackAGlobalsRecord'
		end 'returnedANameOrACall'
	end 'scanBodyFacts'

	// ⭐⭐⭐ **DOES THIS `return` HAND BACK A RECORD THE `return` ITSELF BUILDS? — the whole freshness proof,
	// and it is a proof rather than a heuristic.** Two shapes are recognised as fresh by themselves:
	//
	//   `return <Name>{ … }`  — a struct literal, with the matching `}` the last token on the line.
	//   `return "…{x}…"`      — one interpolated String, ending the line.
	//
	// ⭐⭐ **WHY THOSE SHAPES NEED NOTHING ELSE READ.** A record literal or an interpolated String written IN the
	// return expression is allocated by this frame at that instant and handed over in the same expression: there is no statement
	// between its construction and the hand-off, so no `push`, no field store, no closure capture and no
	// consuming call can have taken a second reference to it. The caller adopting the `+1` is therefore that
	// allocation's SOLE owner — which is exactly what a send has to know, and exactly what
	// `Parser.enrolOwnedCallTemp` records it cannot know in general (*"telling a fresh-box return from a
	// co-owning one is a whole-program fact"*).
	//
	// ⭐⭐ **`return <local>` IS RECOGNISED PROVISIONALLY.** Statements can run between the construction and the
	// return, so the name is only noted here and decided after the walk, over the whole body
	// (`everyReturnedLocalHoldsAFreshRecord`).
	//
	// ⭐⭐ **`return <call>` IS RECOGNISED — AS A CONDITION, NOT A CLAIM.** The callee's own freshness decides
	// it, which only the whole-program close knows (`ProgramSignatures.closeFreshReturnForwards`), so the call
	// is pushed as WRITTEN and the caller ANDs it with the rest. Four spellings, each one a call whose target
	// the close can resolve the way the real parse does:
	//
	//   `name(…)`   `self.name(…)`   `Self.name(…)`   `Type.name(…)`
	//
	// optionally under `try`, alone or with `otherwise panic(…)` — the handler diverges, so the value is still
	// the call's. A receiver call `x.m(…)` states nothing: its target is `x`'s TYPE, which no token here holds.
	// A written name a body binding could take is filtered after the walk (`noForwardHeadIsBoundHere`).
	//
	// ⚠ **A MEMBER A COMPILER-OWNED RECORD'S ROSTER SERVES STATES NOTHING.** Inside `String`, `Character` or
	// the corpus `Array`, `self.m()` and a bare `m()` dispatch to the synthesized arm ahead of the declaration
	// a key would name — asked through `enclosingRosterServing`, the predicate `parseCall` dispatches on.
	//
	// ⚠⚠ **THE MATCHING `}` OR `)` MUST END THE LINE, AND THAT TEST IS NOT DECORATION.** `return Self{…} if c
	// else s` hands back the record on one path and a bound name on the other; `return wrap(Self{…})` hands
	// back whatever `wrap` chose to do with it. Both open with the admitted tokens and neither is fresh, so the
	// region-end test is what parts them.
	//
	// ⚠ It answers about ONE return; the caller ANDs it across every return in the body, so an unreadable
	// shape costs the whole declaration its claim. That is this family's rule (*"every ambiguity resolves
	// toward recording NOTHING"*) and here the wrong direction is a heap-corrupting move rather than a refusal.
	function noteFreshReturnShape(valueStart ElementIndex, forwards FreshReturnForwardArray, forwardHeads NameRoster, forwardHeadsAt TokenIndexArray, returnedLocals NameRoster) returns bool
		if self.noteReturnedLocalName(valueStart, returnedLocals: returnedLocals) 'aReturnedName'
			return true
		end 'aReturnedName'

		return self.noteFreshValueShape(valueStart, forwards: forwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt)
	end 'noteFreshReturnShape'

	function noteReturnedLocalName(valueStart ElementIndex, returnedLocals NameRoster) returns bool
		if self.kindAt(valueStart) != TokenKind.identifier or self.kindAt(valueStart + 1) != TokenKind.newline 'notAReturnedName'
			return false
		end 'notAReturnedName'

		let name = self.tokenAt(valueStart).value

		if not returnedLocals.contains(name) 'firstReturnOfThisName'
			returnedLocals.push(name)
		end 'firstReturnOfThisName'

		return true
	end 'noteReturnedLocalName'

	function valueIsOneInterpolatedString(valueStart ElementIndex) returns bool
		let last = try interpolatedLiteralLastFragment(self.tokens, first: valueStart) otherwise return false
		return self.kindAt(last + 1) == TokenKind.newline
	end 'valueIsOneInterpolatedString'

	// The shapes that are fresh where they are written — one interpolated String, the record literal and the
	// forwarding call above — asked of a `return`'s value and of the value a returned local is bound to.
	function noteFreshValueShape(valueStart ElementIndex, forwards FreshReturnForwardArray, forwardHeads NameRoster, forwardHeadsAt TokenIndexArray) returns bool
		if self.valueIsOneInterpolatedString(valueStart) 'aMintedString'
			return true
		end 'aMintedString'

		let tryWrapped = self.kindAt(valueStart) == TokenKind.try
		let callStart = valueStart + 1 if tryWrapped else valueStart

		// `tokenCanBeAName` admits `Self` along with every keyword-spelled type name, which is the SAME
		// admission the two `spawn` halves make — a factory writing `return Self{…}` and one writing
		// `return Calc{…}` are one declaration spelled two ways.
		if not tokenCanBeAName(self.tokenAt(callStart)) 'notANameAtAll'
			return false
		end 'notANameAtAll'

		let head = self.tokenAt(callStart)

		if not tryWrapped and self.kindAt(callStart + 1) == TokenKind.leftBrace 'aRecordLiteral'
			return self.groupEndsTheLine(callStart + 1, closer: TokenKind.rightBrace)
		end 'aRecordLiteral'

		if self.kindAt(callStart + 1) == TokenKind.leftParen 'anUnqualifiedCall'
			if not self.callEndsTheReturn(callStart + 1, tryWrapped: tryWrapped) or self.enclosingRosterServing(head.value, unfoldedTypeIsTheRecord: true) != EnclosingRoster.none 'notAResolvableForward'
				return false
			end 'notAResolvableForward'

			noteForwardResolvedByName(forwards, forward: FreshReturnForward.unqualified(self.enclosingType.clone(), name: head.value), forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, headAt: callStart, head: head.value)
			return true
		end 'anUnqualifiedCall'

		let member = callStart + 2
		let openParen = callStart + 3

		if self.kindAt(callStart + 1) != TokenKind.dot or not tokenCanBeAName(self.tokenAt(member)) or self.kindAt(openParen) != TokenKind.leftParen or not self.callEndsTheReturn(openParen, tryWrapped: tryWrapped) 'notADottedCallEndingTheReturn'
			return false
		end 'notADottedCallEndingTheReturn'

		let name = self.tokenAt(member).value

		if self.receiverNamesTheEnclosingTypeAt(callStart) 'ofTheEnclosingType'
			if not self.enclosingType.isType() or self.enclosingRosterServing(name, unfoldedTypeIsTheRecord: true) != EnclosingRoster.none 'notAResolvableForward'
				return false
			end 'notAResolvableForward'

			let forward = FreshReturnForward.ofEnclosingType(self.enclosingTypeName(), name: name, takesReceiver: head.kind == TokenKind.self)

			if head.kind == TokenKind.identifier 'aNameABindingCanShadow'
				noteForwardResolvedByName(forwards, forward: forward, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, headAt: callStart, head: head.value)
				return true
			end 'aNameABindingCanShadow'

			forwards.push(forward)
			return true
		end 'ofTheEnclosingType'

		if head.kind != TokenKind.identifier or self.enclosingTypeParams.contains(head.value) or self.namesInnerAliasHere(head.value) 'headMayNotNameAType'
			return false
		end 'headMayNotNameAType'

		noteForwardResolvedByName(forwards, forward: FreshReturnForward.ofNamedType(head.value, name: name), forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, headAt: callStart, head: head.value)
		return true
	end 'noteFreshValueShape'

	// ⭐⭐⭐ **IS EVERY RETURNED LOCAL THE ONLY REFERENCE TO WHAT IT WAS BOUND TO?** One walk of the body for
	// all of them. Each must be bound exactly once — as one of `boundParams`, or by a `let <name> = …` or
	// `var <name> = …` opening its line whose value `binding` admits (`bindingValueIsAdmitted`; a forwarding
	// call becomes a dependency like any other) — and every other token spelling the name must be one this
	// ADMIT-LIST names — anything else is a second reference or a use the list cannot vouch for, and costs
	// the claim:
	//
	//   • `return <name>` inside the binding's scope;
	//   • `<name>.f…` — a field read, or a store into the record's own field; a field's graph is marked shared at
	//     the send by the run-time walk, and only the ROOT's soleness is claimed here;
	//   • `<name>.f….m(…)` — a call whose receiver is a FIELD. `<name>.m(…)` is not admitted: an instance
	//     method is handed the record itself and may keep it;
	//   • a named-argument label or a record-literal field name that happens to spell it.
	//
	// So an argument, a bare read (`let b = <name>`), a reassignment, an interpolation of the whole record, a
	// `for`/`match` binder, and any use outside the binding's scope all retract. A body holding a closure
	// literal states nothing: a closure that reads even a field of a local captures the local itself.
	function everyReturnedLocalHoldsAFreshRecord(returnedLocals NameRoster, bodyStart ElementIndex, forwards FreshReturnForwardArray, forwardHeads NameRoster, forwardHeadsAt TokenIndexArray, boundParams NameRoster, binding ReturnedLocalBinding) returns bool
		let locals = ReturnedLocalArray.create(returnedLocals.count(), zeroed: false)

		for name in returnedLocals 'eachName'
			let local = ReturnedLocal.create(name)

			if boundParams.contains(name) 'aParameter'
				local.bind(0)
			end 'aParameter'

			locals.push(local)
		end 'eachName'

		var depth = 0 as BlockDepth
		let openGroupIsBracket = BoolArray.create(0)
		var q = bodyStart

		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)

			if depth == 0 and self.closesBlockAt(q) 'bodyEnds'
				break
			end 'bodyEnds'

			if kind == TokenKind.function 'aClosureLiteral'
				return false
			end 'aClosureLiteral'

			if q > bodyStart and kind == TokenKind.identifier and self.kindAt(q - 1) != TokenKind.dot 'aNameThatIsNotAMember'
				for local in locals 'eachLocal'
					if local.name.equals(self.tokenAt(q).value) and not self.localMentionKeepsItFresh(q, local: local, depth: depth, labelsAreSpelledHere: innermostGroupSpellsLabels(openGroupIsBracket), forwards: forwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt, binding: binding) 'aSecondReference'
						return false
					end 'aSecondReference'
				end 'eachLocal'
			end 'aNameThatIsNotAMember'

			trackGroupKindAt(kind, openGroupIsBracket: openGroupIsBracket)
			let depthAfter = self.blockDepthAfter(q, depth: depth)

			if depthAfter < depth 'aBlockClosed'
				for local in locals 'eachScope'
					local.closeScopeAbove(depthAfter)
				end 'eachScope'
			end 'aBlockClosed'

			depth = depthAfter
			q = q + 1
		end 'walk'

		for local in locals 'eachBinding'
			if not local.bound 'neverBoundInThisBody'
				return false
			end 'neverBoundInThisBody'
		end 'eachBinding'

		return true
	end 'everyReturnedLocalHoldsAFreshRecord'

	// One token spelling a returned local's name, classified against `everyReturnedLocalHoldsAFreshRecord`'s
	// admit-list. Its binding's value is judged where the binding is met, so a local bound to anything else — a
	// scalar counter is the common case — ends the walk there.
	function localMentionKeepsItFresh(at ElementIndex, local ReturnedLocal, depth BlockDepth, labelsAreSpelledHere bool, forwards FreshReturnForwardArray, forwardHeads NameRoster, forwardHeadsAt TokenIndexArray, binding ReturnedLocalBinding) returns bool
		let before = self.kindAt(at - 1)
		let after = self.kindAt(at + 1)

		// Inside a `[` the same spelling is a map literal's KEY, which stores the record.
		if labelsAreSpelledHere and after == TokenKind.colon and (before == TokenKind.comma or before == TokenKind.leftBrace or tokenKindIsSkippedLayout(before)) 'aLabelSpellingTheName'
			return true
		end 'aLabelSpellingTheName'

		if bindingKeywordSpells(before) and after == TokenKind.equals 'itsBinding'
			// A binding that does not open its line is a `match` arm's, scoped to that arm where the block depth
			// would carry it across the sibling arms.
			if local.bound or not tokenKindIsSkippedLayout(self.kindAt(at - 2)) or not self.bindingValueIsAdmitted(at + 2, binding: binding, forwards: forwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt) 'aSecondBindingOrNotAFreshValue'
				return false
			end 'aSecondBindingOrNotAFreshValue'

			local.bind(depth)
			return true
		end 'itsBinding'

		if not local.inScope 'aDifferentDeclarationOfTheName'
			return false
		end 'aDifferentDeclarationOfTheName'

		if before == TokenKind.return and after == TokenKind.newline 'returnedWhole'
			return true
		end 'returnedWhole'

		var memberHops = 0 as MemberHopCount
		var chainEnd = at + 1

		while self.kindAt(chainEnd) == TokenKind.dot and tokenCanBeAName(self.tokenAt(chainEnd + 1)) 'eachHop'
			memberHops = memberHops + 1
			chainEnd = chainEnd + 2
		end 'eachHop'

		if memberHops == 0 'usedWhole'
			return false
		end 'usedWhole'

		// In `<name>.f.m(…)` the last hop is the method, so a receiver that is a field needs two.
		return self.kindAt(chainEnd) != TokenKind.leftParen or memberHops >= HopsToCallOnAField
	end 'localMentionKeepsItFresh'

	function bindingValueIsAdmitted(valueStart ElementIndex, binding ReturnedLocalBinding, forwards FreshReturnForwardArray, forwardHeads NameRoster, forwardHeadsAt TokenIndexArray) returns bool
		return match binding 'binding'
			freshRecord gives self.noteFreshValueShape(valueStart, forwards: forwards, forwardHeads: forwardHeads, forwardHeadsAt: forwardHeadsAt)
			fieldMoveOut gives self.noteFieldMoveOutValue(valueStart, forwards: forwards)
		end 'binding'
	end 'bindingValueIsAdmitted'

	function noteFieldMoveOutReturn(valueStart ElementIndex, forwards FreshReturnForwardArray, returnedLocals NameRoster) returns bool
		if self.noteReturnedLocalName(valueStart, returnedLocals: returnedLocals) 'aReturnedName'
			return true
		end 'aReturnedName'

		return self.noteFieldMoveOutValue(valueStart, forwards: forwards)
	end 'noteFieldMoveOutReturn'

	function noteFieldMoveOutValue(valueStart ElementIndex, forwards FreshReturnForwardArray) returns bool
		let tryWrapped = self.kindAt(valueStart) == TokenKind.try
		let forward = try self.fieldMoveOutForward(valueStart + 1 if tryWrapped else valueStart, tryWrapped: tryWrapped) otherwise return false

		forwards.push(forward)
		return true
	end 'noteFieldMoveOutValue'

	function fieldMoveOutForward(callStart ElementIndex, tryWrapped bool) returns FreshReturnForward throws AbsentError
		if self.kindAt(callStart) != TokenKind.self or not self.enclosingType.isType() 'notAFieldOfTheReceiver'
			throw AbsentError.absent
		end 'notAFieldOfTheReceiver'

		let fields = NameRoster.create(0)
		var dot = callStart + 1

		while self.kindAt(dot) == TokenKind.dot and tokenCanBeAName(self.tokenAt(dot + 1)) 'eachHop'
			if self.kindAt(dot + 2) == TokenKind.leftParen 'theCall'
				if fields.count() == 0 or not self.containerMoveOutMethodAt(dot + 1) or not self.callEndsTheReturn(dot + 2, tryWrapped: tryWrapped) 'notAMoveOutThatEndsTheReturn'
					throw AbsentError.absent
				end 'notAMoveOutThatEndsTheReturn'

				return FreshReturnForward.ofFieldOfEnclosingType(self.enclosingTypeName(), fields: fields, name: self.tokenAt(dot + 1).value)
			end 'theCall'

			fields.push(self.tokenAt(dot + 1).value)
			dot = dot + 2
		end 'eachHop'

		throw AbsentError.absent
	end 'fieldMoveOutForward'

	// Does the call opening at `openParen` end the `return`? Its `)` ends the line, or — under `try` — is
	// followed by `otherwise panic(…)` that does.
	function callEndsTheReturn(openParen ElementIndex, tryWrapped bool) returns bool
		let closer = self.groupCloserAt(openParen)

		if self.kindAt(closer) != TokenKind.rightParen 'notClosedByItsParen'
			return false
		end 'notClosedByItsParen'

		let after = closer + 1

		if self.kindAt(after) == TokenKind.newline 'endsTheLine'
			return true
		end 'endsTheLine'

		return tryWrapped and self.kindAt(after) == TokenKind.otherwise and self.kindAt(after + 1) == TokenKind.panic and self.kindAt(after + 2) == TokenKind.leftParen and self.groupEndsTheLine(after + 2, closer: TokenKind.rightParen)
	end 'callEndsTheReturn'

	// Does any written name a forwarding `return` resolves by name denote a parameter or a local of this body
	// instead? Then it is a VALUE at that call — a closure, or an instance method's receiver — and no
	// declaration key describes what it hands back.
	function noForwardHeadIsBoundHere(forwardHeads NameRoster, forwardHeadsAt TokenIndexArray, bodyStart ElementIndex, paramNames NameRoster) returns bool
		if forwardHeads.count() == 0 'nothingResolvedByName'
			return true
		end 'nothingResolvedByName'

		return self.returnedNamesNotBoundHere(forwardHeads, returnedHeads: forwardHeads, returnedAt: forwardHeadsAt, bodyStart: bodyStart, paramNames: paramNames).count() == forwardHeads.count()
	end 'noForwardHeadIsBoundHere'

	// ⭐⭐⭐ **DOES THIS `return` HAND BACK A RECORD BUILT OUT OF THIS DECLARATION'S OWN PARAMETERS, AND NOTHING
	// ELSE? — the whole substitution proof.** Exactly one shape is recognised:
	//
	//   `return <Name>{ p0: p0, p1: p1, … }` — the declaration's parameters, in declaration order, each
	//   written into the field of its own name, with the matching `}` the last token on the line.
	//
	// ⭐⭐ **WHY THAT SHAPE AND NOTHING WIDER.** A caller's arguments are then the record's fields by a mapping
	// the tokens carry, so `T.create(7)` and `T{p0: 7}` describe the same bytes — which is what lets a
	// top-level `let` be IMAGED rather than built by `__module_init`. Admit a field whose value is an
	// EXPRESSION and the mapping needs an evaluator; admit a field named differently from its parameter and it
	// needs a second column to carry the correspondence; admit a body with a second statement and the
	// construction is no longer the whole of what the call does. Each is a real feature and none is this one.
	//
	// ⚠ **THE PARAMETER ORDER IS PART OF THE PROOF, not a convenience.** Reading field `k` against parameter
	// `k` is what makes the fact a bare bit rather than a published mapping — and a factory that permutes its
	// parameters into the fields simply states nothing, which is this family's rule: every ambiguity resolves
	// toward recording NOTHING, and the cost of a missed `true` is a global built before `main` exactly as it
	// was.
	//
	// ⚠ **EVERY PARAMETER MUST APPEAR AND NO OTHER FIELD MAY**, so a slot the literal fills from something
	// other than an argument is out of reach. A field the literal OMITS is not: it takes its declared default,
	// which the consumer resolves through `fieldDefaultFill` (`probedFieldDefaultSlot`).
	function noteConstructsFromParams(valueStart ElementIndex, paramNames NameRoster) returns bool
		if not tokenCanBeAName(self.tokenAt(valueStart)) 'notANameAtAll'
			return false
		end 'notANameAtAll'

		let openBrace = valueStart + 1

		if self.kindAt(openBrace) != TokenKind.leftBrace 'notARecordLiteral'
			return false
		end 'notARecordLiteral'

		if not self.groupEndsTheLine(openBrace, closer: TokenKind.rightBrace) 'somethingFollowsTheLiteral'
			return false
		end 'somethingFollowsTheLiteral'

		var matched = 0 as ElementIndex
		var q = openBrace + 1

		while self.kindAt(q) != TokenKind.rightBrace 'eachField'
			// A malformed body runs the scan to the file's `eof`; answering false there is the safe direction,
			// exactly as `groupEndsTheLine` answers for an unclosed group.
			if self.kindAt(q) == TokenKind.eof 'unclosedLiteral'
				return false
			end 'unclosedLiteral'

			if self.kindAt(q) == TokenKind.comma 'betweenFields'
				q = q + 1
				continue
			end 'betweenFields'

			if matched >= paramNames.count() 'moreFieldsThanParameters'
				return false
			end 'moreFieldsThanParameters'

			let wanted = try paramNames.get(matched) otherwise panic("noteConstructsFromParams: paramNames.get OOB at {matched} below a count just compared against")

			if not tokenIsTheNameIn(self.tokens, index: q, wanted: wanted) 'fieldIsNotTheParameter'
				return false
			end 'fieldIsNotTheParameter'

			if self.kindAt(q + 1) != TokenKind.colon 'notAFieldPair'
				return false
			end 'notAFieldPair'

			if not tokenIsTheNameIn(self.tokens, index: q + 2, wanted: wanted) 'valueIsNotTheParameter'
				return false
			end 'valueIsNotTheParameter'

			matched = matched + 1
			q = q + 3
		end 'eachField'

		return matched == paramNames.count()
	end 'noteConstructsFromParams'

	function returnedValueIsAReceiverField(valueStart ElementIndex) returns bool
		if self.kindAt(valueStart) != TokenKind.self 'notTheReceiver'
			return false
		end 'notTheReceiver'

		if self.kindAt(valueStart + 1) != TokenKind.dot 'notAMemberRead'
			return false
		end 'notAMemberRead'

		if self.kindAt(valueStart + 2) != TokenKind.identifier 'notAFieldName'
			return false
		end 'notAFieldName'

		return self.kindAt(valueStart + 3) == TokenKind.newline
	end 'returnedValueIsAReceiverField'

	// Does the group `openBracket` opens close with `closer`, and is that closer the last token on the line?
	// ⚠ **THE CLOSER IS CHECKED AND NOT ASSUMED, which is the whole reason it is a parameter**: a `return f(…)`
	// forward's match is a `)` and a record literal's is a `}`, and a walk that asserted one closer for both
	// would answer `false` for every call. A group a malformed body leaves unclosed answers `false`, the safe
	// direction: the tolerant sweep must never publish a fact about tokens the real parse will reject.
	function groupEndsTheLine(openBracket ElementIndex, closer TokenKind) returns bool
		let closing = self.groupCloserAt(openBracket)
		return self.kindAt(closing) == closer and self.kindAt(closing + 1) == TokenKind.newline
	end 'groupEndsTheLine'

	// The bracket that returns the group `openBracket` opens to depth zero, of whichever kind — or the file's
	// `eof`, where a malformed body leaves the group unclosed. Both are real tokens, so a caller comparing the
	// kind it expects answers `false` at the `eof` without a case of its own. It counts all three bracket
	// kinds, because a nested call or subscript carries brackets of its own (`Self{items: f(Inner{…})}`).
	function groupCloserAt(openBracket ElementIndex) returns ElementIndex
		var depth = 0 as NestingDepth
		var q = openBracket

		while self.kindAt(q) != TokenKind.eof 'scanForTheMatch'
			let kind = self.kindAt(q)

			if tokenKindOpensABracket(kind) 'opensGroup'
				depth = depth + 1
			end 'opensGroup'

			if tokenKindClosesABracket(kind) 'closesGroup'
				depth = depth - 1

				if depth == 0 'theMatch'
					return q
				end 'theMatch'
			end 'closesGroup'

			q = q + 1
		end 'scanForTheMatch'

		return q
	end 'groupCloserAt'

	// ⭐⭐ **THE `let`-GLOBAL ALIAS SEED AND EDGE, READ OFF ONE VALUE EXPRESSION.** Exactly five shapes are recognised, and
	// the region must hold nothing BUT the shape — its own end after a name, an opening `(` for a call:
	//
	//   • `<name>`            — a seed candidate, the name as written;
	//   • `<Type>.<member>`   — a seed candidate under the JOINED spelling, which is the key a static
	//                           member is looked up under (`parseStaticMemberAccess`);
	//   • `<name>(…)`         — a forwarding edge, bare;
	//   • `<recv>.<name>(…)`  — a forwarding edge through a receiver, or through `self` inside a type;
	//   • `<name> if <cond> else <arm>` — the INLINE CONDITIONAL, whose BOTH arms are candidates
	//                           because either may be the value. See below.
	//
	// ⭐⭐ **TWO DOORS ASK IT, AND THE ONLY THING THEY DIFFER IN IS WHERE THE REGION ENDS (`SweptValueRegionEnd`).**
	// A `return` statement is the obvious one. The other is a captured PARAMETER DEFAULT, which is a value
	// expression the compiler turns into a nullary helper whose entire body is `return <that expression>`
	// (`parseDefaultHelperBody`) — so `f(p T = A)` hands its caller exactly what `f(A)` hands it, and the
	// question "may this call's argument alias a `let` global's record?" has to have the same answer for both
	// spellings or a default stops being sugar for writing the argument out: `grow(names Names = shared())`
	// must be refused E3207 exactly where `grow(shared())` is.
	//
	// ⭐⭐ **BOTH ARMS OF THE CONDITIONAL ARE SEEDED, NEVER ONE.** `return table if
	// full else other`, with `table` a module `let`, is a `return` whose value IS a global's record on one
	// path, and the sweep cannot know which, so recording only the half it happened to read first would be a
	// fact about the parser rather than about the program.
	//
	// ⚠⚠ **ANYTHING ELSE RECORDS NOTHING, AND THAT IS SOUND BECAUSE OF THE FALLBACK RATHER THAN BECAUSE THE
	// LIST IS COMPLETE.** A value this does not recognise leaves the function's bit clear, and a clear bit
	// is precisely the condition under which `ownedFormOfBorrowedValue` keeps the ORIGINAL E2015 refusal at the
	// return — so a missed shape costs a REFUSAL, never a silent acceptance. The hazard runs the other way:
	// recording a shape whose value is not really the global's record would taint a caller's value and refuse a
	// write on a legal program. ⇒ **Every ambiguity resolves toward recording NOTHING**, which is why the
	// shape test is exact rather than "a value mentioning a name somewhere".
	//
	// The edge reuses `forwardCallOpeningAt` — the one place a call's tokens are turned into a `ForwardCall` —
	// so a return-forward and a parameter-forward cannot come to disagree about which declarations a spelling
	// can name.
	function noteReturnedGlobalOrForward(valueStart ElementIndex, regionEnd SweptValueRegionEnd, returnedNames NameRoster, returnedHeads NameRoster, returnedAt TokenIndexArray, returnCalls ForwardCallArray)
		if not tokenCanBeAName(self.tokenAt(valueStart)) 'notANameAtAll'
			return
		end 'notANameAtAll'

		if self.kindAt(valueStart + 1) == TokenKind.leftParen 'returnsABareCall'
			if let call = try self.forwardCallOpeningAt(valueStart + 1) 'aNamedCall'
				noteForwardCall(returnCalls, call: call)
			end 'aNamedCall'

			return
		end 'returnsABareCall'

		if self.sweptValueRegionEndsAt(valueStart + 1, regionEnd: regionEnd) 'returnsABareName'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: self.tokenAt(valueStart).value, head: self.tokenAt(valueStart).value, valueStart: valueStart)
			return
		end 'returnsABareName'

		// The INLINE CONDITIONAL. `valueStart + 1` being `if` fixes the THEN arm at exactly the one token the
		// region opens with, which the two tests above have already established is a name — so it is seeded
		// here on the same terms `returnsABareName` seeds its own, and the ELSE arm is read on those terms too.
		if self.kindAt(valueStart + 1) == TokenKind.if 'returnsAConditional'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: self.tokenAt(valueStart).value, head: self.tokenAt(valueStart).value, valueStart: valueStart)
			self.noteConditionalElseArm(valueStart + 2, regionEnd: regionEnd, returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls, valueStart: valueStart)
			return
		end 'returnsAConditional'

		if self.kindAt(valueStart + 1) != TokenKind.dot or not tokenCanBeAName(self.tokenAt(valueStart + 2)) 'notADottedShape'
			return
		end 'notADottedShape'

		if self.kindAt(valueStart + 3) == TokenKind.leftParen 'returnsADottedCall'
			if let call = try self.forwardCallOpeningAt(valueStart + 3) 'aNamedCall'
				noteForwardCall(returnCalls, call: call)
			end 'aNamedCall'

			return
		end 'returnsADottedCall'

		if self.sweptValueRegionEndsAt(valueStart + 3, regionEnd: regionEnd) 'returnsAStaticMember'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: qualifiedMethodName(self.tokenAt(valueStart).value, methodName: self.tokenAt(valueStart + 2).value), head: self.tokenAt(valueStart).value, valueStart: valueStart)
		end 'returnsAStaticMember'
	end 'noteReturnedGlobalOrForward'

	// ⭐ **HAS THE VALUE THE SWEEP IS READING RUN OUT AT `index`?** — the one place `SweptValueRegionEnd`'s two
	// answers are spent, so the recogniser's three "and nothing follows it" tests cannot come to mean different
	// things at the two doors. See the union for why the default door states a TOKEN where the return door
	// states a line.
	function sweptValueRegionEndsAt(index ElementIndex, regionEnd SweptValueRegionEnd) returns bool
		return match regionEnd 'ends'
			atLineEnd gives self.kindAt(index) == TokenKind.newline
			atToken(stop) gives index == stop
		end 'ends'
	end 'sweptValueRegionEndsAt'

	// ⭐ **THE ELSE ARM OF A RETURNED INLINE CONDITIONAL**, read on the SAME two terms the statement-level
	// shapes are read on — a bare name to the region's end, or a bare call — so an arm this admits is an
	// arm `noteReturnedGlobalOrForward` would have admitted had it stood alone.
	//
	// ⚠ **THE `else` IT LOOKS FOR IS AT BRACKET DEPTH ZERO, and everything else records NOTHING.** A
	// conditional nested inside the CONDITION (`return A if (x if y else z) else B`) puts an `else` behind a
	// paren, and one nested in the ELSE arm (`return A if x else B if y else C`) leaves an arm that is not a
	// bare name — both fall through recording nothing, which is this function's family rule: an unrecognised
	// shape costs a REFUSAL at the return, never a silent acceptance. The THEN arm is already seeded by the
	// caller either way, so a missed else arm cannot make the function's bit WRONG, only incomplete.
	function noteConditionalElseArm(condStart ElementIndex, regionEnd SweptValueRegionEnd, returnedNames NameRoster, returnedHeads NameRoster, returnedAt TokenIndexArray, returnCalls ForwardCallArray, valueStart ElementIndex)
		var depth = 0 as NestingDepth
		var q = condStart

		while not self.sweptValueRegionEndsAt(q, regionEnd: regionEnd) and self.kindAt(q) != TokenKind.eof 'scanForElse'
			let kind = self.kindAt(q)

			if tokenKindOpensABracket(kind) 'opensGroup'
				depth = depth + 1
			end 'opensGroup'

			if tokenKindClosesABracket(kind) 'closesGroup'
				depth = depth - 1
			end 'closesGroup'

			if depth == 0 and kind == TokenKind.else 'foundTheElse'
				self.noteConditionalArmValue(q + 1, regionEnd: regionEnd, returnedNames: returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, returnCalls: returnCalls, valueStart: valueStart)
				return
			end 'foundTheElse'

			q = q + 1
		end 'scanForElse'
	end 'noteConditionalElseArm'

	// One arm's VALUE, on the two terms above. Split from the scan so the admission rule is written once and
	// reads the same as the statement-level one it mirrors.
	function noteConditionalArmValue(armStart ElementIndex, regionEnd SweptValueRegionEnd, returnedNames NameRoster, returnedHeads NameRoster, returnedAt TokenIndexArray, returnCalls ForwardCallArray, valueStart ElementIndex)
		if not tokenCanBeAName(self.tokenAt(armStart)) 'notANameAtAll'
			return
		end 'notANameAtAll'

		if self.kindAt(armStart + 1) == TokenKind.leftParen 'aBareCall'
			if let call = try self.forwardCallOpeningAt(armStart + 1) 'aNamedCall'
				noteForwardCall(returnCalls, call: call)
			end 'aNamedCall'

			return
		end 'aBareCall'

		if self.sweptValueRegionEndsAt(armStart + 1, regionEnd: regionEnd) 'aBareName'
			noteReturnedCandidate(returnedNames, returnedHeads: returnedHeads, returnedAt: returnedAt, name: self.tokenAt(armStart).value, head: self.tokenAt(armStart).value, valueStart: valueStart)
		end 'aBareName'
	end 'noteConditionalArmValue'

	// ⭐⭐ **DROP EVERY RETURNED NAME THIS BODY BINDS ITSELF.** `function f() returns Names  let A = …
	//  return A  end` returns its own LOCAL, and the sweep — which has no scope — would otherwise file it as a
	// return of the global `A` and taint every caller's result. The real parse resolves a local first
	// (`parseVariableReference` asks `scope.contains` before any top-level probe), so this is what keeps the
	// swept fact agreeing with what the body will actually mean.
	//
	// ⚠ **THE BINDER TEST IS DELIBERATELY GENEROUS, AND THE DIRECTION IS THE POINT.** A name is treated as
	// bound when it follows `let`, `var`, `for`, `(` or `,` — which catches every binder form the language has
	// (a declaration, a loop variable, a caught-error binder, a `match` payload, a destructuring name) and also
	// catches plain call ARGUMENTS, which are not binders at all. Under-inclusion is the costly direction — a
	// spurious seed refuses a write on a legal program — so the SET errs the way it does on purpose. Do not
	// narrow it: a `match` payload `case(a, b)` is character for character a call, and no token test separates
	// them.
	//
	// ⛔⛔ **BUT THE OVER-INCLUSION IS NOT FREE.** *"It drops a seed, and a dropped seed falls back to the
	// E2015 refusal at the return"* is true, and it stops being acceptable the moment a real program is the
	// one refused: a function can return a name BARE on one path
	// and hand that same name to a call on the next line, so a POSITION-BLIND walk lets the argument mark
	// the candidate bound and the bare return is refused — on a legal program.
	//
	// ⭐ **THE CURE IS POSITION AND IT LEAVES THE SET ALONE** (`markBoundHead`, where the argument lives): a
	// binder can only shadow a `return` that comes AFTER it, because a name cannot resolve to a local at a
	// point before that local is declared. That is EXACT for the question, so it drops only FALSE shadowings —
	// which is why the generous set can stay generous.
	function returnedNamesNotBoundHere(returnedNames NameRoster, returnedHeads NameRoster, returnedAt TokenIndexArray, bodyStart ElementIndex, paramNames NameRoster) returns NameRoster
		// A PARAMETER shadows exactly as a local does, and it is known without walking anything.
		let bound = BoolArray.create(returnedHeads.count(), zeroed: false)

		for candidateHead in returnedHeads 'eachHead'
			bound.push(bodyNamesAParam(paramNames, name: candidateHead))
		end 'eachHead'

		var depth = 0 as BlockDepth
		var q = bodyStart

		while self.kindAt(q) != TokenKind.eof 'walk'
			if depth == 0 and self.closesBlockAt(q) 'bodyEnds'
				break
			end 'bodyEnds'

			if q > bodyStart and tokenCanBeAName(self.tokenAt(q)) and kindBindsTheNameAfterIt(self.kindAt(q - 1)) 'aBinderPosition'
				markBoundHead(returnedHeads, bound: bound, returnedAt: returnedAt, name: self.tokenAt(q).value, binderIndex: q)
			end 'aBinderPosition'

			depth = self.blockDepthAfter(q, depth: depth)
			q = q + 1
		end 'walk'

		let kept = NameRoster.create(0)

		for i in 0 upto returnedNames.count() 'eachCandidate'
			let shadowed = try bound.get(i) otherwise panic("returnedNamesNotBoundHere: bound.get({i}) OOB — the two columns are parallel by construction")

			if shadowed 'shadowed'
				continue
			end 'shadowed'

			kept.push(try returnedNames.get(i) otherwise panic("returnedNamesNotBoundHere: returnedNames.get({i}) OOB below its own count"))
		end 'eachCandidate'

		return kept
	end 'returnedNamesNotBoundHere'

	// ⭐⭐ **WHICH CALL SHAPES CAN NAME THE DECLARATION THE SWEEP IS STANDING ON** — decided here
	// because this is where both its inputs are. `enclosingType` says "a method" (the same test
	// `declaredMethodName` qualifies on, and the same name it qualifies WITH, so a `self.`-shaped edge and
	// this declaration join the identical two halves) and `namespace` says "this file has a directory route"
	// (the same test `recordScannedSignature` publishes a namespace-qualified spelling on). Neither survives
	// past this scan, and neither is derivable from the registration name: a root-level free function and a
	// method in a namespace-free program are both spelled bare.
	function declarationCallability() returns DeclCallability
		if let typeName = try self.enclosingType.typeName() 'aMethod'
			return DeclCallability.methodOf(typeName)
		end 'aMethod'

		return DeclCallability.bareCallOrDirectoryRoute if not self.job.namespace.isEmpty() else DeclCallability.bareCallOnly
	end 'declarationCallability'

	// ⭐ **THE NAME AT `namePos` IS BOUND HERE FOR THE REST OF ITS BLOCK — so if it is a parameter's, the
	// parameter's claim on it ends at this depth.** `setParamBit`'s twin for the block-scoped column, with the
	// name lookup folded in because every caller stands on a token rather than on an index.
	//
	// The FIRST rebinding wins: an inner block that rebinds a name an outer one already took must not shorten
	// the outer one's reach when the inner block closes.
	function noteParameterShadowedInBlock(namePos ElementIndex, paramNames NameRoster, depth BlockDepth, shadowedInBlock ParamShadowColumn)
		let position = try bodyParamPosition(paramNames, name: self.tokenAt(namePos).value) otherwise return
		let index = position as ParamCount

		while shadowedInBlock.count() as ParamCount <= index 'reach'
			shadowedInBlock.push(0)
		end 'reach'

		if (try shadowedInBlock.get(index) otherwise panic("noteParameterShadowedInBlock: get({index}) OOB despite the growth above reaching it")) != 0 'alreadyRebound'
			return
		end 'alreadyRebound'

		try shadowedInBlock.set(index, value: (depth + 1) as ParamShadowDepth) otherwise panic("noteParameterShadowedInBlock: set({index}) OOB despite the growth above reaching it")
	end 'noteParameterShadowedInBlock'

	// The LINE-scoped twin — a match arm's payload and a closure's parameter, which bind for one expression.
	// A plain bit, because a line has no depth to remember and the whole column is cleared at the newline.
	function noteParameterShadowedOnLine(namePos ElementIndex, paramNames NameRoster, shadowedOnLine BoolArray)
		let position = try bodyParamPosition(paramNames, name: self.tokenAt(namePos).value) otherwise return
		setParamBit(shadowedOnLine, index: position as ParamCount)
	end 'noteParameterShadowedOnLine'

	// ⭐ **A BLOCK HAS CLOSED, so every rebinding made inside it is out of scope and its parameter has its
	// name back.** The stored depth is the rebinding's own PLUS ONE, so a rebinding at depth `d` survives
	// exactly while the walk stands at `d` or deeper.
	function endParamShadowsDeeperThan(shadowedInBlock ParamShadowColumn, depth BlockDepth)
		for i in 0 upto shadowedInBlock.count() 'eachParam'
			if (try shadowedInBlock.get(i) otherwise panic("endParamShadowsDeeperThan: get({i}) OOB below its own count")) <= (depth + 1) as ParamShadowDepth 'stillInScope'
				continue
			end 'stillInScope'

			try shadowedInBlock.set(i, value: 0) otherwise panic("endParamShadowsDeeperThan: set({i}) OOB below its own count")
		end 'eachParam'
	end 'endParamShadowsDeeperThan'

	// The line-scoped column's expiry, spent at every newline the walk crosses. A body that binds nothing
	// pays one `count()` per line.
	function clearParamBits(column BoolArray)
		for i in 0 upto column.count() 'eachParam'
			try column.set(i, value: false) otherwise panic("clearParamBits: set({i}) OOB below its own count")
		end 'eachParam'
	end 'clearParamBits'

	// ⭐ **DOES THIS PARAMETER'S NAME STILL DENOTE THE PARAMETER WHERE THE WALK IS STANDING?** A position past
	// either column reads as "yes", exactly as `ParamConsumeInfo.isConsumed` reads a short `bits` as "not
	// consumed" — both are grown at the first rebinding, and most bodies make none.

	function functionValueSlotAt(opening ElementIndex, argument ElementIndex) returns FunctionValueSlot
		let starts = self.argumentStartsOf(opening)
		var position = 0 as ParamCount

		for start in starts 'eachArgument'
			if start <= argument and start != opening + 1 'beforeTheArgument'
				position = position + 1
			end 'beforeTheArgument'
		end 'eachArgument'

		return FunctionValueSlot.create(starts.count() as ParamCount, position: position)
	end 'functionValueSlotAt'

	function argumentStartsOf(opening ElementIndex) returns TokenIndexArray
		let starts = TokenIndexArray.create(0)
		let closing = self.parenGroups.closeOf(self.tokens, open: opening)
		var depth = 0 as NestingDepth

		if opening + 1 < closing 'anArgumentList'
			starts.push(opening + 1)
		end 'anArgumentList'

		for i in opening + 1 upto closing 'eachToken'
			let kind = self.kindAt(i)

			if kind == TokenKind.comma and depth == 0 'separates'
				starts.push(i + 1)
			end 'separates'

			depth = groupNestingAfter(kind, nesting: depth)
		end 'eachToken'

		return starts
	end 'argumentStartsOf'

	function paramNameStillDenotesTheParameter(shadowedInBlock ParamShadowColumn, shadowedOnLine BoolArray, index ParamCount) returns bool
		return (try shadowedInBlock.get(index) otherwise 0) == 0 and not (try shadowedOnLine.get(index) otherwise false)
	end 'paramNameStillDenotesTheParameter'

	// ⭐ `setParamFeed`'s READER twin for a bare feed column — does position `index` carry a feed? A position past
	// the end carries none, which is the same "absence is the answer" default `ParamConsumeInfo.typeParamFeedOf`
	// reads a short column under, and the reason a column need only reach its highest fact.
	//
	// ⚠ It answers the BOOLEAN rather than the `TypeParamFeed`, deliberately: a miss returning `TypeParamFeed.none`
	// would BOX a union value per unfed parameter of every method in the fixpoint — the same cost
	// `SignatureIndex.recordParamConsume` names when it reads its stored feeds directly rather than through
	// `typeParamFeedOf` — and `isFeed()` is the whole of what the one asker wants.
	function paramIsFed(column TypeParamFeedArray, index ParamCount) returns bool
		if index >= column.count() as ParamCount 'past'
			return false
		end 'past'

		return (try column.get(index) otherwise panic("paramIsFed: column.get OOB at {index} despite index < count")).isFeed()
	end 'paramIsFed'

	function scanFixedElementCountNeedsInto(site DescriptorScanSite, methodNames NameRoster, countSeeds DescriptorNeedMap, countCallees SelfCalleesMap)
		self.enterTypeScope(site.typeName, isEnum: false)
		self.enclosingTypeParams = self.signatures.structTypeParamsOf(site.typeName)
		var q = site.bodyStart
		let fieldNames = TypeMemberNames.create()

		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.closesBlockAt(q) 'bodyEnd'
				break
			end 'bodyEnd'

			if self.functionDeclarationAt(q) 'method'
				q = self.recordMethodCountNeeds(q, typeName: site.typeName, methodNames: methodNames, countSeeds: countSeeds, countCallees: countCallees)
				continue
			end 'method'

			if self.structFieldKeywordAt(q) 'field'
				q = self.recordFieldDefaultCountNeeds(q, typeName: site.typeName, fieldNames: fieldNames, methodNames: methodNames, countSeeds: countSeeds, countCallees: countCallees)
				continue
			end 'field'

			q = q + 1
		end 'walk'

		self.closeTypeParamScope()
	end 'scanFixedElementCountNeedsInto'

	function recordMethodCountNeeds(q ElementIndex, typeName ByteArray, methodNames NameRoster, countSeeds DescriptorNeedMap, countCallees SelfCalleesMap) returns ElementIndex
		let qualified = qualifiedMethodName(typeName, methodName: self.tokenAt(q + 1).value)
		let scan = self.scanFixedElementCountIn(q + 2, regionEnd: self.methodBodyEndFrom(q + 2))
		let alreadyContributed = countSeeds.contains(qualified)
		var readsACount = scan.readsFixedElementCount
		var countEdges = self.fixedElementCountEdgesFor(typeName, scan: scan)

		if alreadyContributed 'aSecondDeclarationWearingThisName'
			readsACount = readsACount or (try countSeeds.get(qualified) otherwise panic("recordMethodCountNeeds: '{String.from(qualified)}' is a seeded key by `contains` and absent by `get`"))
			countEdges = mergedEdgeRows(countEdges, previous: try countCallees.get(qualified) otherwise panic("recordMethodCountNeeds: '{String.from(qualified)}' has a count seed but no count-callee row — the two columns are written in one act"))
		end 'aSecondDeclarationWearingThisName'

		countSeeds.upsert(qualified, value: readsACount)
		countCallees.upsert(qualified, value: countEdges)

		if not alreadyContributed 'firstDeclarationWearingThisName'
			methodNames.push(qualified)
		end 'firstDeclarationWearingThisName'

		return scan.endPos
	end 'recordMethodCountNeeds'

	function recordFieldDefaultCountNeeds(q ElementIndex, typeName ByteArray, fieldNames TypeMemberNames, methodNames NameRoster, countSeeds DescriptorNeedMap, countCallees SelfCalleesMap) returns ElementIndex
		let afterModifier = pastVisibilityModifiers(self.tokens, index: q)
		let fieldName = self.tokenAt(afterModifier + 1).value
		let repeatsAField = fieldNames.contains(fieldName)
		fieldNames.upsert(fieldName, value: TypeMemberKind.field)

		var eq = afterModifier + 2

		while not tokenKindEndsALine(self.kindAt(eq)) and self.kindAt(eq) != TokenKind.equals 'findDefault'
			eq = eq + 1
		end 'findDefault'

		if self.kindAt(eq) != TokenKind.equals 'noDefault'
			return eq
		end 'noDefault'

		let regionEnd = statementEndIndexIn(self.tokens, start: eq + 1, blockShiftAt: ignoreBlocks)

		if repeatsAField 'aRepeatedField'
			return regionEnd
		end 'aRepeatedField'

		let helperName = fieldDefaultHelperName(typeName, fieldName: fieldName)
		let scan = self.scanFixedElementCountIn(eq + 1, regionEnd: regionEnd)

		countSeeds.upsert(helperName, value: scan.readsFixedElementCount)
		countCallees.upsert(helperName, value: self.fixedElementCountEdgesFor(typeName, scan: scan))
		methodNames.push(helperName)
		return regionEnd
	end 'recordFieldDefaultCountNeeds'

	function mergedEdgeRows(edges NameRoster, previous NameRoster) returns NameRoster
		if previous.count() == 0 'nothingToMerge'
			return edges
		end 'nothingToMerge'

		let merged = NameRoster.create(edges.count() + previous.count(), zeroed: false)
		merged.append(edges)
		merged.append(previous)
		return merged
	end 'mergedEdgeRows'

	// The bare sibling names a body calls on `self`, qualified to the type they are siblings OF — the join
	// that makes a `self.appendOps(…)` written in `extension Mergeable`'s body and the `appendOps` declared in
	// `type Container`'s body one node of one graph. A callee that is not a sibling at all (a free function, a
	// builtin) survives the join as a name no method wears and is dropped by the fixpoint's own index filter.
	function qualifiedSelfCallees(typeName ByteArray, callees NameRoster) returns NameRoster
		let qualified = NameRoster.create(callees.count(), zeroed: false)

		for callee in callees 'eachCallee'
			qualified.push(qualifiedMethodName(typeName, methodName: callee))
		end 'eachCallee'

		return qualified
	end 'qualifiedSelfCallees'

	// ⚠ **AN OVER-RESERVED COUNT REFUSES A LEGAL PROGRAM.** The slot's supply is the CALLER's, and a caller
	// holding an instance that states no count has nothing to give: it meets
	// `requireFixedElementCountSourceForForwarding`. So no cross-type edge is drawn: `slot.capacity()` inside
	// `type Holder uses Element` would make `Holder.size` reserve a count its `slot` already STATES.
	//
	// ⭐ **THE PRECISE RULE IS A FACT ABOUT WHERE A COUNT CAN BE READ AT ALL: only inside the SIZED
	// CONTAINER's own body.** `countof(Self)` requires it (`countofOperandIsTheOwnInstanceAt`) and so
	// does the `Self{}` that publishes the slots (`ownRecordLiteralOfTheSizedContainerAt`). Everywhere
	// else a receiver's instance STATES its count (a constant) or holds it in its record (a
	// runtime-sized instance), so the call site owes its caller nothing. So the count graph is the
	// container's own call graph and is EMPTY for every other type — which is also why this costs no
	// allocation where it says nothing.
	function fixedElementCountEdgesFor(typeName ByteArray, scan FixedElementCountScan) returns NameRoster
		if not self.signatures.isFixedArrayBaseName(typeName) 'notTheSizedContainersOwnBody'
			return NameRoster.create(0)
		end 'notTheSizedContainersOwnBody'

		let edges = self.qualifiedSelfCallees(typeName, callees: scan.callees)
		edges.append(scan.sizedContainerSelfCallees)
		return edges
	end 'fixedElementCountEdgesFor'

	// The token index just past the `end` that closes the method body opening at `bodyStart`. `depth` starts at
	// 1 because the method's own block is already open; EOF answers itself, which is what an unterminated body
	// (a program the real parse refuses with a position) leaves.
	function methodBodyEndFrom(bodyStart ElementIndex) returns ElementIndex
		var depth = 1 as BlockDepth
		var q = bodyStart

		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.opensBlockAt(q) 'opensBlock'
				depth = depth + 1
			end 'opensBlock' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					depth = depth - 1

					if depth == 0 'methodEnd'
						return q + 1
					end 'methodEnd'
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'

		return q
	end 'methodBodyEndFrom'

	function scanFixedElementCountIn(start ElementIndex, regionEnd ElementIndex) returns FixedElementCountScan
		var readsACount = false
		let callees = NameRoster.create(0)
		let chainedCallees = NameRoster.create(0)
		let selfTypedLocals = NameRoster.create(0)
		let insideTheSizedContainer = self.enclosedBySizedContainer()
		var q = start

		while q < regionEnd 'walk'
			let kind = self.kindAt(q)

			if (kind == TokenKind.countof and self.countofOperandIsTheOwnInstanceAt(q)) or self.ownRecordLiteralOfTheSizedContainerAt(q) 'readsTheCount'
				readsACount = true
			end 'readsTheCount'

			if kind == TokenKind.self and self.isSelfMethodCallAt(q) 'selfCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfCall'

			if insideTheSizedContainer and kind == TokenKind.dot and self.memberCallFollows(q) and q != 0 and self.kindAt(q - 1) == TokenKind.rightParen 'aChainedSelfCallInTheSizedContainer'
				chainedCallees.push(qualifiedMethodName(self.enclosingTypeName(), methodName: self.tokenAt(q + 1).value))
			end 'aChainedSelfCallInTheSizedContainer'

			if self.tokenNamesTheEnclosingTypeAt(q) and self.memberCallFollows(q + 1) 'selfTypeStaticCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfTypeStaticCall'

			if self.selfTypedLocalBoundAt(q) 'selfTypedBinding'
				selfTypedLocals.push(self.tokenAt(q + 1).value)
			end 'selfTypedBinding'

			if self.selfTypedParamDeclaredAt(q) 'selfTypedParam'
				selfTypedLocals.push(self.tokenAt(q).value)
			end 'selfTypedParam'

			if self.selfTypedLocalCallAt(q, locals: selfTypedLocals) 'selfTypedLocalCall'
				callees.push(self.tokenAt(q + 2).value)
			end 'selfTypedLocalCall'

			if tokenCanBeAName(self.tokenAt(q)) and not kindSpellsBlockStructure(kind) and self.isBareCallAt(q) 'bareCall'
				callees.push(self.tokenAt(q).value)
			end 'bareCall'

			q = q + 1
		end 'walk'

		return FixedElementCountScan.create(readsACount, callees: callees, sizedContainerSelfCallees: chainedCallees, endPos: regionEnd)
	end 'scanFixedElementCountIn'

	// The `Array` declaration names, memoized per file off the roster anchor — see `arrayDeclarationRoster`.
	function arrayDeclarationNames() returns NameRoster
		if self.arrayDeclarationRoster is self.anchors.declarationRoster 'firstAskInThisFile'
			self.arrayDeclarationRoster = self.signatures.arrayDeclarationNames()
		end 'firstAskInThisFile'

		return self.arrayDeclarationRoster
	end 'arrayDeclarationNames'

	// Is the token at `selfPos` the start of a `self.<method>(` call — the self-call the fixed-element-count
	// and array-feed fixpoints thread through? `self` `.` `<name>` `(`, four contiguous tokens — the tail asked through the
	// shared `memberCallFollows`, so a KEYWORD-named method (`self.to(item)`) is a self-call here too, and
	// so this scan cannot come to disagree with the statement dispatchers about what a call looks like. Missed,
	// the forward edge is never collected and the fixpoint leaves the forwarder's own argument borrowed.
	function isSelfMethodCallAt(selfPos ElementIndex) returns bool
		return self.memberCallFollows(selfPos + 1)
	end 'isSelfMethodCallAt'

	// ⭐⭐ **DOES `var|let <name> = Self{` OR `var|let <name> = Self.<static>(` BIND A LOCAL OF THE ENCLOSING
	// TYPE?** — the token shape that lets the fixed-element-count fixpoint see a call on a `Self`-typed
	// LOCAL as the self-call it is.
	//
	// ⛔ **IT IS A BINDING TEST AND DELIBERATELY NOT A RECEIVER-BLIND OVER-APPROXIMATION.** An over-reserved
	// count refuses a legal program (`fixedElementCountEdgesFor`), so a receiver-blind edge from a method
	// whose inner-container call merely SHARES A NAME with a count-reading sibling would turn a legal
	// program into a refused one. Reading the binding costs one name list and refuses nothing.
	//
	// A local later reassigned to something else only ever ADDS edges the fixpoint's own name filter may drop,
	// so the over-approximation that remains is in the sound direction.
	function selfTypedLocalBoundAt(q ElementIndex) returns bool
		let kind = self.kindAt(q)

		if not bindingKeywordSpells(kind) 'notABinding'
			return false
		end 'notABinding'

		if self.kindAt(q + 1) != TokenKind.identifier or self.kindAt(q + 2) != TokenKind.equals 'notAPlainInitializer'
			return false
		end 'notAPlainInitializer'

		if not self.tokenNamesTheEnclosingTypeAt(q + 3) 'notSelfValued'
			return false
		end 'notSelfValued'

		return self.kindAt(q + 4) == TokenKind.leftBrace or self.memberCallFollows(q + 4)
	end 'selfTypedLocalBoundAt'

	// Is the token at `q` a `<name> Self` PARAMETER DECLARATION — the other way a name in this body denotes a
	// value of the enclosing type? See the walk's own arm for why an identifier followed by `Self` can
	// only be that, and for the compiler abort the missing edge produced.
	function selfTypedParamDeclaredAt(q ElementIndex) returns bool
		return self.kindAt(q) == TokenKind.identifier and self.tokenNamesTheEnclosingTypeAt(q + 1) and not self.typeSpellingContinuesPast(q + 1)
	end 'selfTypedParamDeclaredAt'

	// Is the token at `q` a `<local>.<method>(` call whose receiver `selfTypedLocalBoundAt` recorded — the
	// self-call the line above makes visible. The name list is a handful of locals per body, so a scan is what
	// it costs.
	function selfTypedLocalCallAt(q ElementIndex, locals NameRoster) returns bool
		if self.kindAt(q) != TokenKind.identifier or not self.memberCallFollows(q + 1) 'notAMemberCall'
			return false
		end 'notAMemberCall'

		let receiver = self.tokenAt(q).value

		for name in locals 'eachLocal'
			if name.equals(receiver) 'hit'
				return true
			end 'hit'
		end 'eachLocal'

		return false
	end 'selfTypedLocalCallAt'

	// Is the identifier at `q` a BARE call `<identifier>(` — followed by `(` and NOT preceded by a `.` (which
	// would make it the member of a `receiver.method(…)` or a qualified `Type.method(…)` call, neither of which
	// is a bare self-call)? The callee is the identifier itself. Used by the fixed-element-count and array-feed
	// scans to treat an implicit-self bare sibling call as the `self.method(…)` it lowers to.
	function isBareCallAt(q ElementIndex) returns bool
		return self.kindAt(q + 1) == TokenKind.leftParen and (q == 0 or self.kindAt(q - 1) != TokenKind.dot)
	end 'isBareCallAt'

	// Does the `function` keyword at `functionTok` carry a `static` modifier — the token IMMEDIATELY before it?
	// `[export] static function` is the only member shape (`export` precedes `static`; `parseTypeMember`), so the
	// token adjacent to `function` is exactly the modifier or not. THE one token-level answer to "is this a
	// receiver-less method?", shared by the descriptor sweep (`recordScannedSignature`) and the implicit-self
	// sibling walk (`ensureSiblingReceivers`) so those two token scans cannot come to disagree about which
	// methods take `self`. The FORWARD twin is `parseTypeMember`'s `not isStatic`, which mints the actual
	// `SelfParamName` parameter every later reader recovers the fact from (`FuncSignature.takesReceiver`).
	function functionDeclIsStatic(functionTok ElementIndex) returns bool
		return functionTok > 0 and self.kindAt(functionTok - 1) == TokenKind.static
	end 'functionDeclIsStatic'

	// ⛔ **DOES A DECLARATION CARRYING `hasStaticModifier` TAKE A RECEIVER — the ONE place that conjunction is
	// spelled.** `static` alone does not answer it: a TOP-LEVEL function carries no modifier and takes no
	// receiver either, so the enclosing type has to be in the test. It is the fact both scans of a generic type's
	// methods align their per-parameter facts to — `recordScannedSignature` prepends `SelfParamName` at slot 0
	// iff this is true, and `feedScanParams` must prepend it in exactly the same cases or the transitive fixpoint
	// republishes a method's feeds one slot off its call site. Written twice, the two spellings agreed only
	// because `scanTypeMethodFeeds` runs where `enclosingType` is never empty — an accident of the caller, not a
	// property of the rule, and `callAlignedInstanceParams`' own header names the price of losing it (a feed that
	// fires on the wrong parameter, so a leak or a double-move).
	function declarationTakesReceiver(hasStaticModifier bool) returns bool
		return self.enclosingType.isType() and not hasStaticModifier
	end 'declarationTakesReceiver'

	// ⭐⭐ `Self{}` inside `type FixedArray uses Element` is the construction `stdlib/FixedArray.maxon`'s `create()`
	// IS, and a fixed-size container's record is born with all of its slots published — so that literal owes
	// a COUNT, which the declaration's own countless `Self` cannot state and every call site can.
	//
	// ⭐ **BOTH SPELLINGS, for `countofOperandIsTheOwnInstanceAt`'s reason** — `Self` and the container's own
	// name denote the same countless instance, and a check filed against one of them would be narrower than
	// the fact it is about. Emptiness is deliberately NOT tested: over-reserving costs one ignored
	// parameter where missing one aborts the compiler.
	function ownRecordLiteralOfTheSizedContainerAt(headPos ElementIndex) returns bool
		if not self.enclosedBySizedContainer() 'notTheSizedContainersOwnBody'
			return false
		end 'notTheSizedContainersOwnBody'

		if self.kindAt(headPos + 1) != TokenKind.leftBrace 'notALiteral'
			return false
		end 'notALiteral'

		return self.tokenNamesTheEnclosingTypeAt(headPos)
	end 'ownRecordLiteralOfTheSizedContainerAt'

	function receiverNamesTheEnclosingTypeAt(q ElementIndex) returns bool
		return self.kindAt(q) == TokenKind.self or self.tokenNamesTheEnclosingTypeAt(q)
	end 'receiverNamesTheEnclosingTypeAt'

	function tokenNamesTheEnclosingTypeAt(q ElementIndex) returns bool
		let tok = self.tokenAt(q)
		return tokenIsTheSelfType(tok) or (tok.kind == TokenKind.identifier and self.namesEnclosingType(tok.value))
	end 'tokenNamesTheEnclosingTypeAt'

	// Is the token at `q` a `<receiver> . <method> (` call HEAD — a preceding `.` and a following `(`? It
	// distinguishes a method call from a bare free call `pop(…)` without resolving the receiver, which a
	// sweep running before the body is parsed cannot do. Each caller pairs this shape with its own
	// method-name set.
	function isDotMethodCallHeadAt(q ElementIndex) returns bool
		return q != 0 and self.kindAt(q - 1) == TokenKind.dot and self.kindAt(q + 1) == TokenKind.leftParen
	end 'isDotMethodCallHeadAt'

	function containerMoveOutMethodAt(q ElementIndex) returns bool
		if not self.isDotMethodCallHeadAt(q) 'notMethodCall'
			return false
		end 'notMethodCall'

		return isElementMoveOutName(self.tokenAt(q).value)
	end 'containerMoveOutMethodAt'

	// ⭐ **THE `self . <field> =` REASSIGNMENT HEAD — ONE token-shape recognizer**, read by the sweep feed
	// (`markOpaqueFieldReassignFeed`), which adds its own tail (the RHS is a bare type-parameter parameter).
	// `self` is never a value, so a match here is always a field WRITE head, and the trailing `=` separates it from
	// a `self.<field>` READ (`x = self.saved`) and from a nested `self.a.b = …` (a `.`, not `=`, follows the field).
	function fieldReassignHeadAt(selfPos ElementIndex) returns bool
		return self.kindAt(selfPos + 1) == TokenKind.dot and self.kindAt(selfPos + 2) == TokenKind.identifier and self.kindAt(selfPos + 3) == TokenKind.equals
	end 'fieldReassignHeadAt'

	// Is the `countof` at `countofPos` a `countof(<the enclosing declaration's own instance>)` — the 4
	// contiguous tokens `countof ( Self )`, or the same with the type's OWN NAME in place of the keyword?
	// `parseCountof` consumes exactly this shape with no newline tolerance, so matching it
	// token-for-token keeps the count scan and the real parse in lockstep.
	//
	// ⭐ **BOTH SPELLINGS, BECAUSE `parseTypeReference` ANSWERS THE SAME TYPE FOR BOTH.** `Self` and the
	// enclosing type's own name both reach `enclosingSelfType`, which for a container whose record the
	// compiler owns is `ownRecordSelfInstance` — the countless instance whose count only the caller can
	// supply. A check filed against one spelling would be narrower than the fact it is about.
	//
	// ⚠ **AN OPERAND THIS CANNOT SEE IS A POSITIONED REFUSAL, NOT A COMPILER ABORT**: `parseCountof`
	// gates the read on the slot ACTUALLY being reserved, so a spelling that reaches the read without
	// passing here (an inner `typealias` naming the countless instance) is refused with a line and a
	// column rather than reaching the lowering's panic.
	//
	// ⛔ **AND IT ASKS WHETHER THE ENCLOSING TYPE IS THE SIZED CONTAINER, WHICH IS A NARROWING AND NOT
	// AN OVER-APPROXIMATION.** A reservation drags in
	// `requireACountSourceForAStaticCall` at every call — so a `countof(Self)` inside an ordinary
	// generic's `static function f() returns Int`, which `parseCountof` refuses as *"a type that
	// states no element count"*, would instead be refused at its calls for naming no sized instance: a
	// diagnostic about the wrong thing entirely. The narrowing cannot UNDER-match, which is the
	// direction that aborts the compiler: `enclosingSelfType` yields a countable instance for exactly
	// the names this admits, so every operand the parse serves passes here first.
	function countofOperandIsTheOwnInstanceAt(countofPos ElementIndex) returns bool
		if not self.enclosedBySizedContainer() 'notTheSizedContainersOwnBody'
			return false
		end 'notTheSizedContainersOwnBody'

		if self.kindAt(countofPos + 1) != TokenKind.leftParen 'noOpen'
			return false
		end 'noOpen'

		if self.kindAt(countofPos + 3) != TokenKind.rightParen 'noClose'
			return false
		end 'noClose'

		return self.tokenNamesTheEnclosingTypeAt(countofPos + 2)
	end 'countofOperandIsTheOwnInstanceAt'

	// Is the innermost OPEN bracket a `{` (a struct literal)? The stack's top decides whether a `:` is a
	// struct-field separator (yes) or a labelled call argument's (no).
	function braceStackInnermostIsBrace(braceStack BoolArray) returns bool
		if braceStack.count() == 0 'empty'
			return false
		end 'empty'

		return try braceStack.get(braceStack.count() - 1) otherwise panic("braceStackInnermostIsBrace: get OOB on non-empty stack")
	end 'braceStackInnermostIsBrace'

	// The parameter index of the VALUE that follows a struct-field `:` at `colonPos`; throws when the value
	// is not a bare parameter reference. The value runs to the field's `,`
	// or the literal's `}`; surrounding parens are stripped (matching `rhsWasBareLocalReference`), so
	// `f: p`, `f: (p)` and `f: ((p))` all name `p`, while `f: p + 1`, `f: g(p)` and `f: q.x` name none.
	function consumedParamAfterColon(colonPos ElementIndex, paramNames NameRoster) returns ParamCount throws MapError
		let (idx, past) = try self.parenStrippedParamAt(colonPos + 1, paramNames: paramNames)

		// The value must END here — the next token is the field separator `,` or the literal close `}`.
		// Anything else (`+`, `.`, `(`) means the parameter was READ inside a larger expression, not moved.
		if self.kindAt(past) == TokenKind.comma or self.kindAt(past) == TokenKind.rightBrace 'bareMove'
			return idx
		end 'bareMove'

		throw MapError.keyNotFound
	end 'consumedParamAfterColon'

	function mergeOperatorAt(index ElementIndex) returns bool
		return regionOperatorAt(self.tokens, index: index) and self.tokenAt(index).value.equals(MergeOperatorWord)
	end 'mergeOperatorAt'

	function parenStrippedParamAt(start ElementIndex, paramNames NameRoster) returns (ParamCount, ElementIndex) throws MapError
		var q = start

		if self.mergeOperatorAt(q) 'aMergedOperand'
			q = q + 1
		end 'aMergedOperand'

		var opens = 0 as Count

		while self.kindAt(q) == TokenKind.leftParen 'stripOpen'
			opens = opens + 1
			q = q + 1
		end 'stripOpen'

		// A parameter's name may be a keyword, so the reference is read through `tokenCanBeAName` rather
		// than `== identifier`. Otherwise `Self{value: from}` records no consume, and the caller keeps
		// its +1 while the box owns it too: a double free. It claims nothing extra, because a keyword
		// that names no parameter is dropped by the lookup below exactly as an unrelated identifier is.
		if not tokenCanBeAName(self.tokenAt(q)) 'notAName'
			throw MapError.keyNotFound
		end 'notAName'

		let idx = (try bodyParamPosition(paramNames, name: self.tokenAt(q).value)) as ParamCount

		q = q + 1

		var closes = 0 as Count

		while self.kindAt(q) == TokenKind.rightParen and closes < opens 'stripClose'
			closes = closes + 1
			q = q + 1
		end 'stripClose'

		if closes != opens 'unbalanced'
			throw MapError.keyNotFound
		end 'unbalanced'

		return (idx, q)
	end 'parenStrippedParamAt'

	// ⛔⛔ **THE DOORS A BODY HAS FOR TAKING A PARAMETER'S NAME AWAY FROM THE PARAMETER.** A door left out
	// leaves the sweep attributing a later consume to a name that no longer denotes the parameter, the caller
	// moves its argument in on that word, and the callee releases the local it really named — a leaked
	// argument, exit 101, with no diagnostic anywhere. The doors recognised are
	//
	//   • `let p = …` / `var p = …`, the `if let p = try …` form included;
	//   • `for p in …`, whose `for` has already opened the loop's block, so the rebinding is the loop's;
	//   • a BINDER LIST — `let (a, b) = …`, `var (a, b) = …`, `for (k, v) in …`, `try … otherwise (e) …` —
	//     recognised by the keyword in FRONT of the `(` (`binderListIsOpen`), never by the names inside it;
	//   • a MATCH ARM's payload (`success(v) then`) and a CLOSURE's parameters (`function(n T) gives …`),
	//     both read at their `)` by `notePatternRebindings`, and both LINE-scoped rather than block-scoped.
	//
	// ⚠ **ONE CATCH BINDER IS NOT ON THAT LIST AND MUST NOT BE ADDED BARE: `end '<label>' else (e) '<label>'`.**
	// `otherwise (` is unambiguous — the grammar reads it as the handler form and demands the block label —
	// but `else (` is also the TERNARY's parenthesised alternative (`a if c else (b + 1)`), so a bare `else`
	// arm in `binderListIsOpen` would mark `b` rebound and drop a real consume of it. The gap is narrow rather
	// than latent: a catch binder is typed as the callee's error enum, so it reaches no consume door with an
	// observable effect — `await`/`cancel` need a `Promise`, a type-parameter feed needs a generic, and a
	// by-reference forward is refused because the binder is immutable. Closing it needs a discriminator that
	// tells the two `else (` apart (the handler's is preceded by the `end` label), not a fourth keyword.
	//
	// ⚠ **THE MISSED DIRECTION IS THE COSTLY ONE HERE, WHICH IS THE OPPOSITE OF `kindBindsTheNameAfterIt`'s.**
	// That predicate may admit a plain call argument, because a spurious binding there only drops a
	// returned-name seed. A spurious binding HERE drops a consume, which is a clean E2015/E3141 refusal, while
	// a missed one is the leak above. So this names the shapes instead of being generous: `validate(p)` ahead
	// of a `Self{f: p}` is a call, and reading it as a binder would refuse a program that compiles.
	function noteParameterRebindingsAt(q ElementIndex, paramNames NameRoster, openBrackets TokenIndexArray, braceStack BoolArray, depth BlockDepth, shadowedInBlock ParamShadowColumn, shadowedOnLine BoolArray)
		if self.kindAt(q) == TokenKind.rightParen 'closesAListOfSomeKind'
			self.notePatternRebindings(q, paramNames: paramNames, openBrackets: openBrackets, braceStack: braceStack, shadowedOnLine: shadowedOnLine)
			return
		end 'closesAListOfSomeKind'

		if self.blockBindsTheNameAt(q, openBrackets: openBrackets, braceStack: braceStack) 'aBlockBinding'
			self.noteParameterShadowedInBlock(q, paramNames: paramNames, depth: depth, shadowedInBlock: shadowedInBlock)
		end 'aBlockBinding'
	end 'noteParameterRebindingsAt'

	function blockBindsTheNameAt(q ElementIndex, openBrackets TokenIndexArray, braceStack BoolArray) returns bool
		if q == 0 or not tokenCanBeAName(self.tokenAt(q)) 'notANamePosition'
			return false
		end 'notANamePosition'

		let prev = self.kindAt(q - 1)

		if bindingKeywordSpells(prev) or prev == TokenKind.for 'aDeclarationKeyword'
			return true
		end 'aDeclarationKeyword'

		return (prev == TokenKind.leftParen or prev == TokenKind.comma) and self.binderListIsOpen(openBrackets, braceStack: braceStack)
	end 'blockBindsTheNameAt'

	// Is the innermost open bracket a BINDER LIST's `(` — the destructuring and handler forms, whose keyword
	// sits in front of the paren? A `{` innermost is a struct literal, and a `(` with anything else in front
	// of it is a call, whose arguments bind nothing.
	function binderListIsOpen(openBrackets TokenIndexArray, braceStack BoolArray) returns bool
		if openBrackets.count() == 0 or self.braceStackInnermostIsBrace(braceStack) 'noOpenParen'
			return false
		end 'noOpenParen'

		let opener = try openBrackets.get(openBrackets.count() - 1) otherwise panic("binderListIsOpen: openBrackets.get OOB on a stack whose count was just read as non-zero")

		if opener == 0 'nothingInFrontOfIt'
			return false
		end 'nothingInFrontOfIt'

		let before = self.kindAt(opener - 1)
		return bindingKeywordSpells(before) or before == TokenKind.for or before == TokenKind.otherwise
	end 'binderListIsOpen'

	// ⭐ **A MATCH ARM'S PAYLOAD AND A CLOSURE'S PARAMETERS, read at the `)` that closes them.** Both spell
	// their binders exactly as a call spells its arguments, and the token that tells them apart sits PAST the
	// close: an arm continues `then` or `gives`, a closure `gives`. The grammar puts neither word there for
	// anything else, so a call's arguments cannot reach this.
	//
	// Both bind for ONE expression, and both spell it on one line — an arm is `pattern then <statement>`, a
	// closure `function(…) gives <expr>` — so these go in the LINE-scoped column. A `match`'s own block depth
	// would carry an arm's payload across its sibling arms, where it would suppress a write to the parameter
	// that those arms really do make.
	function notePatternRebindings(closePos ElementIndex, paramNames NameRoster, openBrackets TokenIndexArray, braceStack BoolArray, shadowedOnLine BoolArray)
		let opener = try self.patternBinderListClosedAt(closePos, openBrackets: openBrackets, braceStack: braceStack) otherwise return
		var p = opener + 1

		while p < closePos 'eachBinderPosition'
			if self.patternBinderAt(p) 'aBinder'
				self.noteParameterShadowedOnLine(p, paramNames: paramNames, shadowedOnLine: shadowedOnLine)
			end 'aBinder'

			p = p + 1
		end 'eachBinderPosition'
	end 'notePatternRebindings'

	function patternBinderListClosedAt(closePos ElementIndex, openBrackets TokenIndexArray, braceStack BoolArray) returns ElementIndex throws MapError
		let after = self.kindAt(closePos + 1)

		if after != TokenKind.then and after != TokenKind.gives 'neitherAnArmNorAClosure'
			throw MapError.keyNotFound
		end 'neitherAnArmNorAClosure'

		if openBrackets.count() == 0 or self.braceStackInnermostIsBrace(braceStack) 'noOpenParenToClose'
			throw MapError.keyNotFound
		end 'noOpenParenToClose'

		return try openBrackets.get(openBrackets.count() - 1) otherwise panic("patternBinderListClosedAt: openBrackets.get OOB on a stack whose count was just read as non-zero")
	end 'patternBinderListClosedAt'

	function patternBinderAt(p ElementIndex) returns bool
		let prev = self.kindAt(p - 1)
		return (prev == TokenKind.leftParen or prev == TokenKind.comma) and tokenCanBeAName(self.tokenAt(p))
	end 'patternBinderAt'

	// The parameter a promise consume door reclaims at `q`; throws when the token opens no such door.
	// `await p` takes the thread's result and `p.cancel()` takes nothing, and both
	// hand the green thread back to the runtime (`consumePromiseThread`). A frame that does that owns
	// the promise, exactly as one that stores or returns it does.
	//
	// It has to be swept because ownership is decided before the body is parsed: `bindParameters`
	// enrols a promise parameter owned only where `takesPromiseAt` says so, and a body that
	// awaits one nothing enrolled meets E3141 at its own `await`. The caller moves a promise argument
	// at exactly the positions the same predicate names (`transferConsumedArgs`), so a later read of
	// the source is E3102/E3142.
	function promiseConsumeDoorParamAt(q ElementIndex, paramNames NameRoster) returns ParamCount throws MapError
		if self.kindAt(q) == TokenKind.await 'awaitDoor'
			// The target must be the name alone, parens aside: `await p.inner`, `await f(p)` and `await
			// ps[i]` read through the parameter rather than moving it, and each is excluded by the token
			// that follows.
			let (idx, past) = try self.parenStrippedParamAt(q + 1, paramNames: paramNames)
			let after = self.kindAt(past)

			if after == TokenKind.dot or after == TokenKind.leftParen or after == TokenKind.leftBracket 'headsALargerExpression'
				throw MapError.keyNotFound
			end 'headsALargerExpression'

			return idx
		end 'awaitDoor'

		// `<receiver> . cancel ( )`, whose receiver is the token two before the method name. The empty
		// argument list pins the shape; `tokenCanBeAName` at the receiver rejects a chain
		// (`xs.get(0).cancel()` stands on a `)`), and the `.` test rejects a qualified one (`self.p.cancel()`),
		// neither of which names a parameter slot. The index floor keeps both probes inside the token array.
		if q >= PromiseCancelQualifierBack and self.isDotMethodCallHeadAt(q) and self.tokenAt(q).value.equals(PromiseCancelMethodName) and self.kindAt(q + 2) == TokenKind.rightParen and self.kindAt(q - PromiseCancelQualifierBack) != TokenKind.dot 'cancelDoor'
			return try self.bareParamReferenceAt(q - PromiseCancelReceiverBack, paramNames: paramNames)
		end 'cancelDoor'

		throw MapError.keyNotFound
	end 'promiseConsumeDoorParamAt'

	function notePromiseStoresAt(q ElementIndex, inMethod bool, paramNames NameRoster, carriers ParamPositionMask, braceStack BoolArray, openBrackets TokenIndexArray, shadowedInBlock ParamShadowColumn, shadowedOnLine BoolArray, handedOn mutable isolated BoolArray, forwardedStores mutable isolated ForwardedStoreArray) returns bool
		let shape = self.promiseStoreShapeAt(q, inMethod: inMethod, braceStack: braceStack, openBrackets: openBrackets)

		if shape == PromiseStoreShape.notAStore 'nothingStored'
			return false
		end 'nothingStored'

		var any = false

		for site in self.storedParamsAt(q, shape: shape, paramNames: paramNames) 'eachSite'
			if not paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: site.paramIndex) or not maskHasParam(carriers, param: site.paramIndex) 'notOneThatCanCarryAPromise'
				continue
			end 'notOneThatCanCarryAPromise'

			if site.shape == ForwardShape.outright 'storedOutright'
				setParamBit(handedOn, index: site.paramIndex)
			end 'storedOutright' else 'forwarded'
				forwardedStores.push(site)
			end 'forwarded'

			any = true
		end 'eachSite'

		return any
	end 'notePromiseStoresAt'

	// ⚠ `containerCall` resolves no receiver (`isContainerMoveInCallHeadAt`), so `x.push(p)` stores `p`
	// whatever `x` is: a user type whose `push` only reads its argument still takes the promise from the
	// caller, whose later use of it is E3102.
	function promiseStoreShapeAt(q ElementIndex, inMethod bool, braceStack BoolArray, openBrackets TokenIndexArray) returns PromiseStoreShape
		let kind = self.kindAt(q)

		if kind == TokenKind.colon and self.braceStackInnermostIsBrace(braceStack) 'fieldInit'
			return PromiseStoreShape.fieldInit
		end 'fieldInit'

		if kind == TokenKind.equals and self.assignmentHeadEndsAt(q, inMethod: inMethod) 'assignment'
			return PromiseStoreShape.assignment
		end 'assignment'

		if (kind == TokenKind.leftParen and self.tupleLiteralOpensAt(q)) or (kind == TokenKind.comma and self.insideATupleLiteral(braceStack, openBrackets: openBrackets)) 'tupleElement'
			return PromiseStoreShape.tupleElement
		end 'tupleElement'

		if kind == TokenKind.leftBracket and self.bracketOpensALiteralAt(q) 'literalElement'
			return PromiseStoreShape.literalElement
		end 'literalElement'

		if self.isContainerMoveInCallHeadAt(q) 'containerCall'
			return PromiseStoreShape.containerCall
		end 'containerCall'

		if self.isCallHeadAt(q) 'callHead'
			return PromiseStoreShape.callHead
		end 'callHead'

		return PromiseStoreShape.notAStore
	end 'promiseStoreShapeAt'

	function storedParamsAt(q ElementIndex, shape PromiseStoreShape, paramNames NameRoster) returns ForwardedStoreArray
		let found = ForwardedStoreArray.create(0)

		match shape 'shape'
			notAStore then break
			fieldInit then self.noteStoredOperand(found, start: q + 1, paramNames: paramNames, closer: TokenKind.rightBrace)
			tupleElement then self.noteStoredOperand(found, start: q + 1, paramNames: paramNames, closer: TokenKind.comma if self.kindAt(q) == TokenKind.leftParen else TokenKind.rightParen)
			assignment then self.noteAssignedOperand(found, start: q + 1, paramNames: paramNames)
			containerCall then self.noteOutrightOperands(found, argsStart: q + 2, paramNames: paramNames, nestsAllBrackets: true)
			literalElement then self.noteOutrightOperands(found, argsStart: q + 1, paramNames: paramNames, nestsAllBrackets: true)
			callHead then self.noteForwardedOperands(found, head: q, paramNames: paramNames)
		end 'shape'

		return found
	end 'storedParamsAt'

	function outrightStoreOf(parameter ParamCount) returns ForwardedStore
		return ForwardedStore.create(parameter, shape: ForwardShape.outright, typeName: EmptySourceText, memberName: EmptySourceText, column: 0, label: EmptySourceText, calleeParam: 0)
	end 'outrightStoreOf'

	function noteStoredOperand(found ForwardedStoreArray, start ElementIndex, paramNames NameRoster, closer TokenKind)
		let (index, past) = try self.parenStrippedParamAt(start, paramNames: paramNames) otherwise return

		if self.kindAt(past) == TokenKind.comma or self.kindAt(past) == closer 'aWholeOperand'
			found.push(self.outrightStoreOf(index))
		end 'aWholeOperand'
	end 'noteStoredOperand'

	function noteAssignedOperand(found ForwardedStoreArray, start ElementIndex, paramNames NameRoster)
		let (index, past) = try self.parenStrippedParamAt(start, paramNames: paramNames) otherwise return

		if self.statementEndsAt(past) 'aWholeStatement'
			found.push(self.outrightStoreOf(index))
		end 'aWholeStatement'
	end 'noteAssignedOperand'

	function noteOutrightOperands(found ForwardedStoreArray, argsStart ElementIndex, paramNames NameRoster, nestsAllBrackets bool)
		for arg in self.bareParamArgsIn(argsStart, paramNames: paramNames, nestsAllBrackets: nestsAllBrackets) 'eachBareParam'
			found.push(self.outrightStoreOf(arg.paramIndex))
		end 'eachBareParam'
	end 'noteOutrightOperands'

	function noteForwardedOperands(found ForwardedStoreArray, head ElementIndex, paramNames NameRoster)
		for arg in self.bareParamArgsIn(head + 2, paramNames: paramNames, nestsAllBrackets: true) 'eachBareParam'
			found.push(self.forwardedStoreOf(arg, head: head, paramNames: paramNames))
		end 'eachBareParam'
	end 'noteForwardedOperands'

	function forwardedStoreOf(arg BareParamArg, head ElementIndex, paramNames NameRoster) returns ForwardedStore
		let member = self.tokenAt(head).value
		let column = self.functionValueSlotAt(head + 1, argument: arg.valuePos).position
		let label = self.argLabelBefore(arg.valuePos)

		if self.kindAt(head - 1) != TokenKind.dot 'noReceiver'
			if let ownParameter = try bodyParamPosition(paramNames, name: member) 'aFunctionTypedParameter'
				return ForwardedStore.create(arg.paramIndex, shape: ForwardShape.throughParameter, typeName: EmptySourceText, memberName: member, column: column, label: label, calleeParam: ownParameter as ParamCount)
			end 'aFunctionTypedParameter'

			return ForwardedStore.create(arg.paramIndex, shape: ForwardShape.bare, typeName: EmptySourceText, memberName: member, column: column, label: label, calleeParam: 0)
		end 'noReceiver'

		let receiver = self.kindAt(head - 2)

		if receiver == TokenKind.self and self.enclosingType.isType() 'theReceiverItself'
			return ForwardedStore.create(arg.paramIndex, shape: ForwardShape.throughSelf, typeName: self.enclosingTypeName(), memberName: member, column: column, label: label, calleeParam: 0)
		end 'theReceiverItself'

		if receiver == TokenKind.selfType and self.enclosingType.isType() 'theEnclosingType'
			return ForwardedStore.create(arg.paramIndex, shape: ForwardShape.throughSelfType, typeName: self.enclosingTypeName(), memberName: member, column: column, label: label, calleeParam: 0)
		end 'theEnclosingType'

		if receiver == TokenKind.identifier and not self.isMemberAccessAt(head - 2) 'aLoneName'
			return ForwardedStore.create(arg.paramIndex, shape: ForwardShape.qualified, typeName: self.tokenAt(head - 2).value, memberName: member, column: column, label: label, calleeParam: 0)
		end 'aLoneName'

		return ForwardedStore.create(arg.paramIndex, shape: ForwardShape.throughReceiver, typeName: EmptySourceText, memberName: member, column: column, label: label, calleeParam: 0)
	end 'forwardedStoreOf'

	function isMemberAccessAt(namePos ElementIndex) returns bool
		return namePos > 0 and self.kindAt(namePos - 1) == TokenKind.dot
	end 'isMemberAccessAt'

	function isCallHeadAt(headPos ElementIndex) returns bool
		return headPos > 0 and self.kindAt(headPos) == TokenKind.identifier and self.kindAt(headPos + 1) == TokenKind.leftParen and self.kindAt(headPos - 1) != TokenKind.function
	end 'isCallHeadAt'

	function assignmentHeadEndsAt(equalsPos ElementIndex, inMethod bool) returns bool
		if equalsPos < 2 or not tokenCanBeAName(self.tokenAt(equalsPos - 1)) 'noTargetName'
			return false
		end 'noTargetName'

		let before = self.kindAt(equalsPos - 2)

		if before == TokenKind.dot 'aFieldOfSomething'
			return true
		end 'aFieldOfSomething'

		return inMethod and not bindingKeywordSpells(before) and before != TokenKind.as
	end 'assignmentHeadEndsAt'

	function bracketOpensALiteralAt(openPos ElementIndex) returns bool
		if openPos == 0 'noPrecedingToken'
			return false
		end 'noPrecedingToken'

		let before = self.kindAt(openPos - 1)
		return before == TokenKind.from or before == TokenKind.leftBracket or self.tupleLiteralOpensAt(openPos)
	end 'bracketOpensALiteralAt'

	function tupleLiteralOpensAt(openPos ElementIndex) returns bool
		if openPos == 0 'noPrecedingToken'
			return false
		end 'noPrecedingToken'

		let before = self.kindAt(openPos - 1)
		return before == TokenKind.equals or before == TokenKind.return or before == TokenKind.comma or before == TokenKind.leftParen or before == TokenKind.colon or before == TokenKind.gives or before == TokenKind.then
	end 'tupleLiteralOpensAt'

	function insideATupleLiteral(braceStack BoolArray, openBrackets TokenIndexArray) returns bool
		if openBrackets.count() == 0 or self.braceStackInnermostIsBrace(braceStack) 'noParenOpen'
			return false
		end 'noParenOpen'

		return self.tupleLiteralOpensAt(try openBrackets.get(openBrackets.count() - 1) otherwise panic("insideATupleLiteral: openBrackets.get OOB on a stack whose count was just read as non-zero"))
	end 'insideATupleLiteral'

	function handedBackParamAt(q ElementIndex, paramNames NameRoster) returns ParamCount throws MapError
		if self.kindAt(q) != TokenKind.return 'notAReturn'
			throw MapError.keyNotFound
		end 'notAReturn'

		let (idx, past) = try self.parenStrippedParamAt(q + 1, paramNames: paramNames)

		if self.statementEndsAt(past) 'aBareReturn'
			return idx
		end 'aBareReturn'

		throw MapError.keyNotFound
	end 'handedBackParamAt'

	// Read through `tokenCanBeAName` for `parenStrippedParamAt`'s reason: a parameter's name may be a
	// keyword.
	function bareParamReferenceAt(p ElementIndex, paramNames NameRoster) returns ParamCount throws MapError
		if not tokenCanBeAName(self.tokenAt(p)) 'notAName'
			throw MapError.keyNotFound
		end 'notAName'

		return (try bodyParamPosition(paramNames, name: self.tokenAt(p).value)) as ParamCount
	end 'bareParamReferenceAt'

	// ⭐⭐ **MARK EACH BARE TYPE-PARAMETER ARGUMENT of a `<receiver> . push/set/insert/upsert ( … )` CALL AS A
	// CALLEE-STORAGE FEED**, returning whether any was marked. Cursor `mutatorPos` is the
	// method-name token. `paramNames`/`typeParamPositions` are CALL-ALIGNED (self at slot 0 for an instance
	// method), so a feed lands at the argument's own call-site position. Only a BARE type-parameter argument is
	// fed (a `push`'s sole positional argument, a `set`/`insert`'s labelled `value:` element, an `upsert`'s
	// key and value); an index
	// expression, a chain or a `value` label token is not.
	//
	// ⚠⚠ **THE RECEIVER IS DELIBERATELY NOT RESOLVED.** Demanding a literal `self . <field> .` head would
	// recognize ONE of the spellings of one store: `items.push(item)` (implicit self — the SAME store, the bare
	// field read resolves to `self.items`) and `xs.push(first)` (a local array a static then hands to the `Self`
	// it returns) would both be invisible, and an unrecognized feed hands the array a BORROW the concrete call
	// site never transferred — freed by the array's one-shot element drop and by nobody else, which is
	// `0xC0000005` on an `.rdata` literal and a double free on a heap record.
	//
	// **What makes receiver-blindness SOUND is that the array owns its element wherever the array lives** — the
	// `__managed_decref` walk destroys each element exactly once whether the array is a field of `self`, a local, or
	// a parameter.
	//
	// ⚠ **A NON-ARRAY RECEIVER CAN REACH HERE.** A user generic type may declare its own `push(x T)`, and one
	// that merely BORROWS its argument marks that argument a feed here, which enrols it owned in a callee that
	// never moves it. Ownership still BALANCES — the
	// enrolled parameter is released once at the method's exit, through `__drop_type_param`, which makes the
	// method a layout carrier in lowering's carrier scan.
	function markOpaqueContainerMutatorFeeds(mutatorPos ElementIndex, paramNames NameRoster, typeParamPositions TypeParamSlots, feeds mutable isolated TypeParamFeedArray, shadowedInBlock ParamShadowColumn, shadowedOnLine BoolArray) returns bool
		if not self.isContainerMoveInCallHeadAt(mutatorPos) 'notMoveInCall'
			return false
		end 'notMoveInCall'

		var any = false

		for arg in self.bareTypeParamArgsIn(mutatorPos + 2, paramNames: paramNames, typeParamPositions: typeParamPositions) 'eachArg'
			// A feed is a consume, so it stops at a rebinding of the name exactly as the two direct doors do.
			if not paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: arg.paramIndex) 'aLocalOfThatNameNow'
				continue
			end 'aLocalOfThatNameNow'

			setParamFeed(feeds, index: arg.paramIndex, feed: TypeParamFeed.feeds(arg.typeParamPosition, sink: FeedSink.calleeStorage))
			any = true
		end 'eachArg'

		return any
	end 'markOpaqueContainerMutatorFeeds'

	// ⭐ **THE BARE TYPE-PARAMETER ARGUMENTS of ONE call's argument list** — the `bareParamArgsIn` arguments
	// whose parameter is type-parameter-typed (a plain-typed one cannot BE a feed).
	function bareTypeParamArgsIn(argsStart ElementIndex, paramNames NameRoster, typeParamPositions TypeParamSlots) returns BareTypeParamArgArray
		let found = BareTypeParamArgArray.create(0)

		for arg in self.bareParamArgsIn(argsStart, paramNames: paramNames, nestsAllBrackets: false) 'eachBareParam'
			if let typeParamPosition = try typeParamPositions.positionAt(arg.paramIndex) 'typeParamArg'
				found.push(BareTypeParamArg.create(arg.paramIndex, typeParamPosition: typeParamPosition, valuePos: arg.valuePos))
			end 'typeParamArg'
		end 'eachBareParam'

		return found
	end 'bareTypeParamArgsIn'

	// The bare parameter arguments of ONE call's argument list, whose first argument token is at `argsStart`
	// (just past the `(`, or past an array literal's `[`). An argument qualifies when it is the WHOLE of its argument slot (`isBareArgValueAt`
	// — so an index expression, a `.`-chain hop and a label token are all excluded) and names a caller
	// parameter. Nested parens — and with `nestsAllBrackets`, brackets and braces — are tracked so only
	// top-level arguments are considered.
	//
	// A parameter's name may be a KEYWORD, so the bare reference to it is one too — read through
	// `tokenCanBeAName`, `consumedParamAfterColon`'s rule and for its measured reason (a missed feed leaves the
	// concrete call site BORROWING a managed argument the owner then destroys).
	function bareParamArgsIn(argsStart ElementIndex, paramNames NameRoster, nestsAllBrackets bool) returns BareParamArgArray
		let found = BareParamArgArray.create(0)
		var depth = 1 as NestingDepth
		var p = argsStart

		while depth > 0 and self.kindAt(p) != TokenKind.eof 'args'
			let kind = self.kindAt(p)

			if kind == TokenKind.leftParen or (nestsAllBrackets and (kind == TokenKind.leftBracket or kind == TokenKind.leftBrace)) 'openNested'
				depth = depth + 1
			end 'openNested' else 'notOpen'
				if kind == TokenKind.rightParen or (nestsAllBrackets and (kind == TokenKind.rightBracket or kind == TokenKind.rightBrace)) 'closeArg'
					depth = depth - 1
				end 'closeArg' else 'notClose'
					if depth == 1 and tokenCanBeAName(self.tokenAt(p)) and self.isBareArgValueAt(p, inALiteral: nestsAllBrackets) 'candidate'
						if let position = try bodyParamPosition(paramNames, name: self.tokenAt(p).value) 'namesAParameter'
							found.push(BareParamArg.create(position as ParamCount, valuePos: p))
						end 'namesAParameter'
					end 'candidate'
				end 'notClose'
			end 'notOpen'

			p = p + 1
		end 'args'

		return found
	end 'bareParamArgsIn'

	// ⭐ **`self.<opaqueField> = param` — REASSIGNING A BARE OPAQUE-`T` FIELD IS A FEED.** A
	// generic instance method that reassigns a bare type-parameter field of `self` from a type-parameter argument
	// MOVES that argument into the field, whose opaque content the enclosing instance OWNS (its
	// `__destruct_<instance>` cascade, or the shared body's `__drop_type_param` on the next reassign, drops it).
	// The shared body cannot see the field's managed-ness — it is opaque here — so the parameter is recorded as a
	// FEED of the type parameter it fills, exactly like a `Self{field: v}` construction feed or a
	// `self.items.push(item)` array feed, and the CONCRETE call site consumes it iff that instance's argument owns
	// managed heap (`Box with String`) and borrows it otherwise (`Box with SmallInt`, byte-identical). Without
	// this the caller would BORROW the managed argument the box then destroys — a double-free (`0xC0000005`), the
	// field-store twin of the array-feed hole `recordTransitiveArrayFeeds` closes. The head test recognises
	// `self . <field> = <param>` where the RHS is a bare type-parameter parameter.
	function markOpaqueFieldReassignFeed(selfPos ElementIndex, paramNames NameRoster, typeParamPositions TypeParamSlots, feeds mutable isolated TypeParamFeedArray, shadowedInBlock ParamShadowColumn, shadowedOnLine BoolArray) returns bool
		// The field's opacity is NOT queried here: this runs in the SWEEP, before the struct layouts are merged
		// into `self.signatures` (exactly why `markOpaqueContainerMutatorFeeds` is purely token-based too). It need
		// not be — a type-parameter argument can be assigned ONLY to a type-parameter (opaque) field, so a bare
		// type-parameter RHS on a `self.<field> =` write IMPLIES the field is opaque; any non-opaque target is a
		// type error the real parse rejects before this feed can matter. The precise opacity + managed-ness check
		// lives in the emit (`emitOpaqueFieldReassign`), which runs in the real parse where the layout is known —
		// the two agree on a valid program, and disagree only on one the real parse already refuses.
		// The RHS is a PARAMETER reference, whose name may be a KEYWORD — `tokenCanBeAName`, for
		// `consumedParamAfterColon`'s measured reason. The FIELD name (`selfPos + 2`, inside
		// `fieldReassignHeadAt`) stays an identifier: a field DECLARATION admits no keyword.
		if not self.fieldReassignHeadAt(selfPos) or not tokenCanBeAName(self.tokenAt(selfPos + 4)) 'notReassignShape'
			return false
		end 'notReassignShape'

		// The RHS must be JUST the parameter — a `.`/`(` after it would make it `next.x`/`next(...)`, a type error
		// on an opaque value the parse rejects, but excluded here so no larger expression is misread as a move.
		if self.kindAt(selfPos + 5) == TokenKind.dot or self.kindAt(selfPos + 5) == TokenKind.leftParen 'notBareMove'
			return false
		end 'notBareMove'

		let position = try bodyParamPosition(paramNames, name: self.tokenAt(selfPos + 4).value) otherwise return false
		let idx = position as ParamCount

		let feedPos = try typeParamPositions.positionAt(idx) otherwise return false

		// A feed is a consume, so it stops at a rebinding of the name exactly as the two direct doors do.
		if not paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: idx) 'aLocalOfThatNameNow'
			return false
		end 'aLocalOfThatNameNow'

		setParamFeed(feeds, index: idx, feed: TypeParamFeed.feeds(feedPos, sink: FeedSink.calleeStorage))
		return true
	end 'markOpaqueFieldReassignFeed'

	function isolatedOpaqueParamMask(typeParamPositions TypeParamSlots, capabilities ParamCapabilityArray, written ParamPositionMask, takesReceiver bool) returns ParamPositionMask
		var mask = NoParamPositions
		let firstSource = 1 if takesReceiver else 0

		for (iter, capability) in capabilities.withIterator() 'eachParameter'
			let position = (iter.index() + firstSource) as ParamCount

			if capability == ParamCapability.isolated and typeParamPositions.namesATypeParameter(position) and not maskHasParam(written, param: position) 'anOwnedOpaqueRegion'
				mask = maskWithParam(mask, param: position)
			end 'anOwnedOpaqueRegion'
		end 'eachParameter'

		return mask
	end 'isolatedOpaqueParamMask'

	function markIsolatedOpaqueParamFeeds(isolatedOpaqueParams ParamPositionMask, paramNames NameRoster, typeParamPositions TypeParamSlots, feeds mutable isolated TypeParamFeedArray) returns bool
		var marked = false

		for position in 0 upto paramNames.count() 'eachPosition'
			if not maskHasParam(isolatedOpaqueParams, param: position as ParamCount) 'notIsolatedOpaque'
				continue
			end 'notIsolatedOpaque'

			let existing = try feeds.get(position) otherwise TypeParamFeed.none

			if existing.isFeed() 'alreadyFed'
				continue
			end 'alreadyFed'

			let feedPos = try typeParamPositions.positionAt(position as ParamCount) otherwise panic("markIsolatedOpaqueParamFeeds: position {position} is in the isolated-opaque mask and names no type parameter — the mask is built from the same slots")
			setParamFeed(feeds, index: position as ParamCount, feed: TypeParamFeed.feeds(feedPos, sink: FeedSink.constructedValue))
			marked = true
		end 'eachPosition'

		return marked
	end 'markIsolatedOpaqueParamFeeds'

	function isContainerMoveInCallHeadAt(mutatorPos ElementIndex) returns bool
		return self.isDotMethodCallHeadAt(mutatorPos) and tokenCanBeAName(self.tokenAt(mutatorPos)) and self.isContainerMoveInMutator(self.tokenAt(mutatorPos).value)
	end 'isContainerMoveInCallHeadAt'

	// The container mutators that MOVE an element in, all of which transfer ownership of that element to the
	// container: the `Array`'s `push` (its sole argument) and `set` / `insert` (their
	// labelled `value:` argument), the `Map`'s `upsert` (its key and its labelled `value:`), and the CHAIN's
	// four — `append` / `prepend` on the `List` surface, `insertFirst` / `insertLast` on the `__ManagedList`
	// one, each taking the element as its sole argument. `reserve`/`resize`/`clear` take no element, so none
	// feeds.
	//
	// ⚠ **`append` IS ALSO AN `Array` METHOD, WHERE IT BORROWS ANOTHER ARRAY RATHER THAN MOVING AN ELEMENT —
	// AND SHARING THE NAME COSTS NOTHING, BECAUSE BOTH READERS ASK A SECOND QUESTION THE ARRAY'S ANSWERS NO.**
	// `markOpaqueContainerMutatorFeeds` marks only a BARE TYPE-PARAMETER argument, and `xs.append(other)` hands
	// over an `Array with T`, never a `T`.
	//
	// ⚠ **`insert` IS HERE THOUGH IT IS NOT ON THE ROSTER**: a roster says which surface the compiler SERVES,
	// and this asks what a method DOES to its element. A corpus-served `insert` still takes ownership, so a
	// body forwarding its own `T` to `self.items.insert(i, value: item)` still feeds it — and this sweep
	// resolves no receiver, so it is over-approximate BY DESIGN.
	function isContainerMoveInMutator(name ByteArray) returns bool
		return name.equals(ArrayPushMethod) or name.equals(ArraySetMethod) or name.equals(InsertMethod) or name.equals(UpsertMethod) or self.isChainMoveInMutator(name)
	end 'isContainerMoveInMutator'

	// The chain's four END insertions, split out because they are the ones whose receiver is a
	// `List`/`__ManagedList` and because the two SURFACES spell the same act differently — `append`/`prepend`
	// link an element the caller never sees again, `insertFirst`/`insertLast` link it and hand back the node
	// handle. What both surfaces share is the only thing this asks: the chain becomes the element's sole owner,
	// released once by `element_drop@24` (`ListRuntime.maxon`), exactly as an array slot is by
	// `element_destroy@40`.
	//
	// ⚠ **`List.insert` IS A FIFTH CHAIN MOVE-IN AND IS DELIBERATELY NOT NAMED HERE** — it
	// is covered by the caller's own `InsertMethod` arm, which it matches on the very same constant. ⭐ **But
	// it is covered for a DIFFERENT REASON than the one the header above states for that arm**, and the
	// difference is worth writing down: that paragraph justifies `insert`'s presence as an over-approximation
	// for a CORPUS-SERVED `Array.insert` whose body takes ownership out of sight. `List.insert` is
	// compiler-emitted, and its ownership is not an approximation at all — `parseArraySet` calls
	// `moveElementIntoContainer` at the parse, so the chain provably becomes the owner. ⇒ The shared arm is EXACT for this spelling and over-approximate for the other; a name
	// added here would be a second claim about one byte string, which is what the caller's block refuses.
	function isChainMoveInMutator(name ByteArray) returns bool
		return name.equals(AppendMethod) or name.equals(ListPrependMethod) or name.equals(ManagedListInsertFirstMethod) or name.equals(ManagedListInsertLastMethod)
	end 'isChainMoveInMutator'

	// Is the identifier at `p` a BARE argument value — the whole of its argument slot? True iff it is bounded
	// by an argument delimiter on both sides: `(`, a top-level `,`, or a label `:` before it, and a `,` or the
	// closing `)` after it — and `inALiteral`, an array literal's `[` and `]` too. So `push(item)`'s `item` and
	// `set(i, value: item)`'s `item` match, while an index expression, a `.`-chain hop, or a label token
	// (`value`, which is followed by `:`) does not.
	function isBareArgValueAt(p ElementIndex, inALiteral bool) returns bool
		let operandStart = p - 1 if self.mergeOperatorAt(p - 1) else p
		let before = self.kindAt(operandStart - 1)
		let after = self.kindAt(p + 1)
		let leftBounded = before == TokenKind.leftParen or before == TokenKind.comma or before == TokenKind.colon or (inALiteral and before == TokenKind.leftBracket)
		let rightBounded = after == TokenKind.comma or after == TokenKind.rightParen or (inALiteral and after == TokenKind.rightBracket)
		return leftBounded and rightBounded
	end 'isBareArgValueAt'

	// ⭐ **CLOSE THE ARRAY-FEED RELATION OVER SELF-CALL FORWARDS** — after every method of a
	// generic type is scanned, a method M's parameter P is ALSO a type-parameter FEED when M forwards P (as a bare
	// argument) to a self-call `self.N(...)` whose corresponding parameter is itself a feed. Without this only the
	// method that DIRECTLY pushes into the array (`store`) is a feed, so a forwarder (`add(item){ self.store(item) }`)
	// leaves its OWN concrete call site (`sc.add("x")`) BORROWING the managed argument — which the owning array then
	// destroys, freeing a value nobody transferred (a double-free, `0xC0000005`). This is the per-parameter analogue
	// of `Queries.foldFixedElementCountNeeds`: a least fixpoint over the self-call graph, with FORWARD
	// edges (M's parameter -> N's parameter) rather than a per-method boolean, solved by the same linear
	// reverse-reachability BFS. It runs in the SWEEP — feeds are a whole-program `ParamConsumeInfo` fact a cross-file
	// concrete call site reads — after the method loop, so every sibling's parameter list is known for edge
	// resolution. A NON-generic type has no type parameter to feed, so it does nothing.
	function recordTransitiveArrayFeeds(paramConsumes ParamConsumeEntryArray, bodyStart ElementIndex, feedStart ElementIndex)
		if self.enclosingTypeParams.isEmpty() 'notGeneric'
			return
		end 'notGeneric'

		self.solveAndPublishTransitiveFeeds(self.scanTypeMethodFeeds(bodyStart), paramConsumes: paramConsumes, feedStart: feedStart)
	end 'recordTransitiveArrayFeeds'

	// Walk the generic type's body once, returning one `MethodFeedScan` per method — its parameters, direct
	// array-mutator feeds, and self-call forward edges. Mirrors `scanFixedElementCountNeedsInto`'s body walk: a
	// named `function <name>` opens a method whose whole body is scanned in one nested pass
	// (`scanOneMethodFeedSignals`), and the walk resumes past its `end`, so this outer loop only ever sees
	// member-level tokens.
	//
	// ⚠ **A `static` IS ALIGNED AS A `static`, NOT AS AN INSTANCE METHOD.** A static is not inert in the fixpoint:
	// it has no `self`, but it durably stores a type-parameter argument through a local `Array with T` it hands to
	// the `Self` it returns, so it can be published — and prepending `SelfParamName` to a receiverless parameter
	// list is not a harmless over-alignment: every call site slots its arguments against these very names
	// (`argSlotPosition`), so a published static would consume at the position one to the left of the one the
	// author wrote. So the list is built the way the SWEEP builds it, per method, through the one door that
	// spells each alignment (`feedScanParams`).
	function scanTypeMethodFeeds(bodyStart ElementIndex) returns MethodFeedScanArray
		let scans = MethodFeedScanArray.create(0)
		var q = bodyStart

		while self.kindAt(q) != TokenKind.eof 'walk'
			if self.closesBlockAt(q) 'typeEnd'
				break
			end 'typeEnd'

			if self.functionDeclarationAt(q) 'method'
				let typeParamPositions = TypeParamSlots.create()
				let takesReceiver = self.declarationTakesReceiver(self.functionDeclIsStatic(q))
				let paramNames = self.feedScanParams(q + 2, takesReceiver: takesReceiver, typeParamPositionsOut: typeParamPositions)
				let scan = self.scanOneMethodFeedSignals(q + 2, funcName: qualifiedMethodName(self.enclosingTypeName(), methodName: self.tokenAt(q + 1).value), site: declarationSiteKey(self.job.path, line: self.tokenAt(q + 1).line, column: self.tokenAt(q + 1).column), paramNames: paramNames, typeParamPositions: typeParamPositions, takesReceiver: takesReceiver)
				scans.push(scan)
				q = scan.endPos
				continue
			end 'method'

			q = q + 1
		end 'walk'

		return scans
	end 'scanTypeMethodFeeds'

	// The parameter list one method's feed facts are recorded against, aligned exactly as the SWEEP aligns them
	// (`recordScannedSignature`): CALL-aligned (`SelfParamName` at slot 0) for an instance method, and the plain
	// SOURCE list for a receiverless one, whose own parameter list already IS its call-site list. The transitive
	// fixpoint REPLACES the sweep's entry for a method that gains a feed, so the two alignments have to be the
	// same list — this is the one place that says which is which.
	function feedScanParams(paramsStart ElementIndex, takesReceiver bool, typeParamPositionsOut TypeParamSlots) returns NameRoster
		if not takesReceiver 'receiverless'
			return self.paramNamesIn(paramsStart, typeParamPositionsOut: typeParamPositionsOut, collectTypeParamFlags: true, typesOut: self.emptySweptParamTypes, collectTypes: false, spellingsOut: self.emptyParamSpellings, capabilitiesOut: ParamCapabilityArray.create(0))
		end 'receiverless'

		return self.callAlignedInstanceParams(paramsStart, typeParamPositionsOut: typeParamPositionsOut)
	end 'feedScanParams'

	// Scan ONE method's body — from `startPos` (the `(` of its parameter list) to its own `end` — for the array-feed
	// signals: the DIRECT array-mutator feeds it performs on ANY receiver (`items.push(param)`) and the
	// self-call forward edges out of it (`self.N(param)`, plus an implicit-self bare-sibling `N(param)`, which
	// lowers to the same self-call). `depth` starts at 1 because the method's own block is already open; the
	// parameter list and return type carry no `.mutator(` call, no `self.N` shape and no bare-sibling call, so
	// scanning from `startPos` costs one harmless pass over them.
	function scanOneMethodFeedSignals(startPos ElementIndex, funcName immutable ByteArray, site ByteArray, paramNames NameRoster, typeParamPositions TypeParamSlots, takesReceiver bool) returns MethodFeedScan
		var directFeeds = TypeParamFeedArray.create(0) as isolated TypeParamFeedArray
		let edges = ForwardFeedEdgeArray.create(0)

		// ⛔ **THE REBINDING COLUMNS AND THE BRACKET STACKS THEY ARE READ WITH — the same mechanism
		// `scanBodyFacts` keeps, through the same routine.** A feed IS a consume, so a name a local has taken
		// must stop feeding here for the reason it stops there: the concrete call site would move an argument
		// in that this body never stores. The two walks share `noteParameterRebindingsAt` so a door taught to
		// one is taught to both.
		let braceStack = BoolArray.create(0)
		let openBrackets = TokenIndexArray.create(0)
		let shadowedInBlock = ParamShadowColumn.create(0)
		let shadowedOnLine = BoolArray.create(0)
		var depth = 1 as BlockDepth
		var q = startPos

		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)
			self.noteParameterRebindingsAt(q, paramNames: paramNames, openBrackets: openBrackets, braceStack: braceStack, depth: depth, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine)

			if kind == TokenKind.newline 'aLineEnded'
				clearParamBits(shadowedOnLine)
			end 'aLineEnded'

			self.trackBracketAt(q, braceStack: braceStack, openBrackets: openBrackets)

			// `<receiver>.push/set/insert(param)` is a DIRECT feed wherever its receiver lives — probed at
			// every token, exactly as `scanBodyFacts` probes it, so the two seedings cannot disagree about what a
			// direct feed is.
			_ = self.markOpaqueContainerMutatorFeeds(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: directFeeds, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine)

			if kind == TokenKind.self 'selfToken'
				// `self.<opaqueField> = param` is a DIRECT feed too — seeded here so the transitive
				// closure marks a forwarder INTO a field-reassigning sibling as consuming its own argument.
				_ = self.markOpaqueFieldReassignFeed(q, paramNames: paramNames, typeParamPositions: typeParamPositions, feeds: directFeeds, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine)

				if self.isSelfMethodCallAt(q) 'selfCall'
					self.collectForwardFeedEdges(q + 4, calleeName: qualifiedMethodName(self.enclosingTypeName(), methodName: self.tokenAt(q + 2).value), paramNames: paramNames, typeParamPositions: typeParamPositions, edges: edges, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine)
				end 'selfCall'
			end 'selfToken' else 'notSelf'
				// A BARE sibling call `N(param)` lowers to `self.N(param)`, so it forwards exactly as an explicit
				// self-call does. The callee is qualified to `<enclosingType>.N`; a call to a name that is not a sibling
				// method is dropped by the fixpoint's name->index filter, so over-including here is harmless.
				// A sibling's name may be a KEYWORD, read through `tokenCanBeAName` minus the block-structure
				// kinds — the twin of `scanFixedElementCountIn`'s bare-call test.
				if tokenCanBeAName(self.tokenAt(q)) and not kindSpellsBlockStructure(kind) and self.isBareCallAt(q) 'bareCall'
					self.collectForwardFeedEdges(q + 2, calleeName: qualifiedMethodName(self.enclosingTypeName(), methodName: self.tokenAt(q).value), paramNames: paramNames, typeParamPositions: typeParamPositions, edges: edges, shadowedInBlock: shadowedInBlock, shadowedOnLine: shadowedOnLine)
				end 'bareCall'
			end 'notSelf'

			if self.opensBlockAt(q) 'opensBlock'
				depth = depth + 1
			end 'opensBlock' else 'notOpener'
				if self.closesBlockAt(q) 'closes'
					depth = depth - 1
					endParamShadowsDeeperThan(shadowedInBlock, depth: depth)

					if depth == 0 'methodEnd'
						return MethodFeedScan.create(funcName, site: site, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: merge directFeeds, edges: edges, takesReceiver: takesReceiver, endPos: q + 1)
					end 'methodEnd'
				end 'closes'
			end 'notOpener'

			q = q + 1
		end 'walk'

		return MethodFeedScan.create(funcName, site: site, paramNames: paramNames, typeParamPositions: typeParamPositions, directFeeds: merge directFeeds, edges: edges, takesReceiver: takesReceiver, endPos: q)
	end 'scanOneMethodFeedSignals'

	// Extract the self-call forward edges from ONE `self.N(...)` / bare-sibling `N(...)` call's argument list, whose
	// first argument token is at `argsStart` (just past the `(`). For each argument that is a BARE reference to a
	// caller parameter that is type-parameter-typed, append an edge to `calleeName` — positional (empty `argLabel`)
	// for the first argument, labelled (`argLabel:`) otherwise — for the fixpoint to resolve to the callee's own
	// parameter position. A non-parameter argument, an index expression, or a `.`-chain hop is not a bare forward and
	// is skipped; a plain-typed caller parameter cannot BE a feed, so it is skipped too — which is exactly what
	// `bareTypeParamArgsIn` answers, and the reason the walk lives there rather than here.
	function collectForwardFeedEdges(argsStart ElementIndex, calleeName ByteArray, paramNames NameRoster, typeParamPositions TypeParamSlots, edges ForwardFeedEdgeArray, shadowedInBlock ParamShadowColumn, shadowedOnLine BoolArray)
		for arg in self.bareTypeParamArgsIn(argsStart, paramNames: paramNames, typeParamPositions: typeParamPositions) 'eachArg'
			// A forwarded name a local has taken forwards the LOCAL, exactly as at the direct feed doors.
			if not paramNameStillDenotesTheParameter(shadowedInBlock, shadowedOnLine: shadowedOnLine, index: arg.paramIndex) 'aLocalOfThatNameNow'
				continue
			end 'aLocalOfThatNameNow'

			edges.push(ForwardFeedEdge.create(arg.paramIndex, calleeName: calleeName, argLabel: self.argLabelBefore(arg.valuePos)))
		end 'eachArg'
	end 'collectForwardFeedEdges'

	// The argument LABEL immediately before a bare argument value at `valuePos`, or `EmptySourceText` for the first
	// POSITIONAL argument. A labelled argument is `label : value`, so the label is two tokens back; a positional one
	// is bounded by `(` or `,`. Mirrors how a call site slots a labelled argument by name and the first argument by
	// position (`slotCallArgs`).
	// ⚠ A LABEL MAY BE SPELLED WITH A KEYWORD, because the PARAMETER it names may be
	// (`combine(1, enum: 2)`) — so the label token is read through `tokenCanBeAName`. Missed, the label read
	// as EMPTY, which means "the first POSITIONAL argument": the forward edge would resolve to the callee's
	// parameter 0 instead of the one actually named, and the fixpoint would mark the wrong parameter a feed.
	function argLabelBefore(valuePos ElementIndex) returns immutable ByteArray
		if self.kindAt(valuePos - 1) == TokenKind.colon and tokenCanBeAName(self.tokenAt(valuePos - 2)) 'labelled'
			return self.tokenAt(valuePos - 2).value
		end 'labelled'

		return EmptySourceText
	end 'argLabelBefore'

	// Solve the array-feed relation to its least fixpoint over the self-call forward edges, then publish each
	// method's transitive feeds into `paramConsumes`. A (method, parameter) NODE is a feed iff it directly feeds an
	// array mutator OR it forwards to a feed node — iff it can REACH a directly-fed node over the forward edges. So
	// REVERSE the edges (`buildCsr` with (callee, caller) SWAPPED, exactly as `solveFixedElementCountNeeds`) and mark
	// reachability BACKWARD from the seeds: each node enters the worklist at most once (the first time its bit flips
	// on) and each edge is walked once, for O(nodes + edges).
	function solveAndPublishTransitiveFeeds(scans MethodFeedScanArray, paramConsumes ParamConsumeEntryArray, feedStart ElementIndex)
		let methodCount = scans.count()

		// Dense method index per qualified name, and the per-method NODE base (prefix sum of call-aligned parameter
		// counts), so a `(method, parameter)` pair flattens into one dense CSR key space. `nodeMethod` is the inverse
		// (node -> its method), read when a newly-fed node marks its method for publishing.
		let nameToIndex = MethodIndexMap.create()
		let paramBase = CsrColumn.create(methodCount, zeroed: false)
		let nodeMethod = CsrColumn.create(0)
		var totalNodes = 0 as CsrIndex

		for i in 0 upto methodCount 'index'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB below count {methodCount}")
			nameToIndex.upsert(scan.funcName, value: i as CsrIndex)
			paramBase.push(totalNodes)

			for _ in 0 upto scan.paramNames.count() 'node'
				nodeMethod.push(i as CsrIndex)
			end 'node'

			totalNodes = totalNodes + scan.paramNames.count() as CsrIndex
		end 'index'

		// The REVERSED forward edges: a forward node edge (caller -> callee) is recorded as `callee -> caller`, so a
		// BFS from a fed node reaches the callers that forward INTO it. An edge to a name that is not a sibling
		// method, or to a callee parameter position out of range (a malformed call), is not a real edge and is
		// dropped — `buildCsr` counting-sorts the rest into the reverse adjacency in O(edges + nodes).
		let edgeCallee = CsrColumn.create(0)
		let edgeCaller = CsrColumn.create(0)

		for i in 0 upto methodCount 'edges'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB in edges")
			let callerBase = try paramBase.get(i) otherwise panic("solveAndPublishTransitiveFeeds: paramBase.get({i}) OOB")

			for edge in scan.edges 'edge'
				if let j = try nameToIndex.get(edge.calleeName) 'sibling'
					let calleeScan = try scans.get(j) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({j}) OOB for callee")
					let calleePos = try self.forwardEdgeCalleePos(edge, calleeScan: calleeScan) otherwise continue
					edgeCallee.push((try paramBase.get(j) otherwise panic("solveAndPublishTransitiveFeeds: paramBase.get({j}) OOB")) + (calleePos as CsrIndex))
					edgeCaller.push(callerBase + (edge.callerParamPos as CsrIndex))
				end 'sibling'
			end 'edge'
		end 'edges'

		let feedersOf = buildCsr(edgeCallee, to: edgeCaller, nodeCount: totalNodes)

		// Seed each DIRECTLY-fed node, then mark every node that REACHES one over the reversed forward edges — a
		// (method, parameter) node is a feed iff it directly feeds an array mutator or forwards (transitively) to a
		// feed node.
		let seeds = BoolArray.create(0)

		for i in 0 upto methodCount 'seedNodes'
			let scan = try scans.get(i) otherwise panic("solveAndPublishTransitiveFeeds: scans.get({i}) OOB in seed")

			for p in 0 upto scan.paramNames.count() 'param'
				seeds.push(paramIsFed(scan.directFeeds, index: p as ParamCount))
			end 'param'
		end 'seedNodes'

		let isFeed = reverseReachabilityMark(feedersOf, seeds: seeds)

		// A method must have its `paramConsumes` entry (re)written iff it GAINED a feed at a node that was not a
		// direct seed — a method whose feeds are entirely direct already carries the right entry from the sweep.
		let gained = FixedBoolArray.create(methodCount)

		for node in 0 upto totalNodes 'markGained'
			let transitively = (try isFeed.get(node) otherwise panic("solveAndPublishTransitiveFeeds: isFeed.get({node}) OOB")) and not (try seeds.get(node) otherwise panic("solveAndPublishTransitiveFeeds: seeds.get({node}) OOB"))

			if transitively 'gainedFeed'
				try gained.set((try nodeMethod.get(node) otherwise panic("solveAndPublishTransitiveFeeds: nodeMethod.get({node}) OOB")), value: true) otherwise panic("solveAndPublishTransitiveFeeds: gained.set OOB")
			end 'gainedFeed'
		end 'markGained'

		self.publishTransitiveFeeds(scans, paramBase: paramBase, isFeed: isFeed, gained: gained, paramConsumes: paramConsumes, feedStart: feedStart)
	end 'solveAndPublishTransitiveFeeds'

	// The callee's parameter position a forward edge targets: its FIRST user parameter for a positional argument,
	// or the labelled parameter's position otherwise — `argSlotPosition`, the same slotting a call site
	// applies. The first user parameter is slot 1 for an INSTANCE method (the receiver holds call-aligned
	// slot 0) and slot 0 for a receiverless one, which is why the scan carries `takesReceiver` rather than
	// assuming one.
	function forwardEdgeCalleePos(edge ForwardFeedEdge, calleeScan MethodFeedScan) returns ParamCount throws MapError
		let firstUserParam = (1 if calleeScan.takesReceiver else 0) as ParamCount
		return try argSlotPosition(calleeScan.paramNames, argIndex: firstUserParam, label: edge.argLabel)
	end 'forwardEdgeCalleePos'

	// Write each transitively-fed method's final feeds into `paramConsumes`. Only a method that GAINED a feed at a
	// non-directly-fed parameter is touched, so a type with no forwarder is byte-identical.
	//
	// ⚠ EVERY feed published here is a CALLEE-STORAGE one, and structurally so: the fixpoint's seeds are exactly
	// the two direct callee-storage shapes (`markOpaqueContainerMutatorFeeds`, `markOpaqueFieldReassignFeed`), and a
	// `Self{f: p}` CONSTRUCTOR feed is not a seed and has no forward edge, so nothing here can reach one. A
	// forwarder INTO callee storage owns its own argument for the same reason its callee does — it hands it on.
	function publishTransitiveFeeds(scans MethodFeedScanArray, paramBase CsrColumn, isFeed BoolArray, gained FixedBoolArray, paramConsumes ParamConsumeEntryArray, feedStart ElementIndex)
		for i in 0 upto scans.count() 'publish'
			if not (try gained.get(i) otherwise panic("publishTransitiveFeeds: gained.get({i}) OOB")) 'noGain'
				continue
			end 'noGain'

			let scan = try scans.get(i) otherwise panic("publishTransitiveFeeds: scans.get({i}) OOB")
			self.mergeGainedFeedsInto(paramConsumes, feedStart: feedStart, scan: scan, nodeBase: try paramBase.get(i) otherwise panic("publishTransitiveFeeds: paramBase.get({i}) OOB"), isFeed: isFeed)
		end 'publish'
	end 'publishTransitiveFeeds'

	// ⛔⛔ **THE SWEEP'S ENTRY IS THE BASE THE SOLVED FEEDS ARE MERGED ONTO — NOT A DRAFT TO BE THROWN AWAY.**
	// Replace this method's swept entry in place, or append a fresh one when the sweep filed none (a pure
	// forwarder). Only entries added since `feedStart` — this declaration's own methods — are searched, and method
	// names are whole-program unique, so the match is exact; ONE search serves both the READ of the swept facts and
	// the WRITE of the merged entry, so the two cannot come to disagree about which entry is this method's.
	//
	// ⚠ **IT DOES NOT REBUILD THE ENTRY FROM THE SOLVED NODES ALONE.** A RECEIVERLESS function can be published
	// here and is the one kind scanned with
	// `detectFieldStores: true`, so it is the one kind that carries facts this fixpoint never computes — its plain
	// consume bits AND its `Self{f: p}` CONSTRUCTOR feeds, which have no node here and so read as `none` off the
	// solved column. MEASURED: a `static of(first Element, single Element)` that FORWARDS `first` to a sibling that
	// pushes, and stores `single` into a type-parameter field, lost `single`'s constructor feed the moment `first`
	// made the method `gained` — the concrete call site then borrowed a `String` the box destroys, `0xC0000005`.
	// (Its direct-feed twin, one `xs.push(first)` instead of the forward, never entered here and was correct — a
	// difference no rule could justify.) So the fixpoint may only turn feeds ON.
	function mergeGainedFeedsInto(paramConsumes ParamConsumeEntryArray, feedStart ElementIndex, scan MethodFeedScan, nodeBase CsrIndex, isFeed BoolArray)
		for i in feedStart upto paramConsumes.count() 'find'
			let filed = try paramConsumes.get(i) otherwise panic("mergeGainedFeedsInto: paramConsumes.get({i}) OOB")

			if filed.site.equals(scan.site) 'match'
				try paramConsumes.set(i, value: ParamConsumeEntry.create(scan.funcName, site: scan.site, info: self.feedsMergedOnto(filed.info, scan: scan, nodeBase: nodeBase, isFeed: isFeed))) otherwise panic("mergeGainedFeedsInto: paramConsumes.set({i}) OOB")
				return
			end 'match'
		end 'find'

		// The sweep filed NOTHING for this method — a PURE forwarder, which neither consumes nor directly feeds.
		// An EMPTY facts record says exactly that and is not a placeholder: `isConsumed` / `typeParamFeedOf` read
		// every index past their own column as `false` / `none`, which is the content of "the sweep recorded
		// nothing here".
		paramConsumes.push(ParamConsumeEntry.create(scan.funcName, site: scan.site, info: self.feedsMergedOnto(ParamConsumeInfo.noFacts(scan.paramNames), scan: scan, nodeBase: nodeBase, isFeed: isFeed)))
	end 'mergeGainedFeedsInto'

	// `prior` with this method's solved feed nodes turned ON: a node the fixpoint marked becomes a CALLEE-STORAGE
	// feed, every other position keeps whatever the sweep put there. The plain consume bits ride across untouched —
	// the fixpoint has no opinion about them, and an opinion it does not hold must not be published as `false`.
	function feedsMergedOnto(prior ParamConsumeInfo, scan MethodFeedScan, nodeBase CsrIndex, isFeed BoolArray) returns ParamConsumeInfo
		let feeds = TypeParamFeedArray.create(0) as isolated TypeParamFeedArray

		for p in 0 upto scan.paramNames.count() 'buildFeeds'
			let feedParam = try isFeed.get(nodeBase + p) otherwise panic("feedsMergedOnto: isFeed.get OOB at ({nodeBase}+{p})")

			if feedParam 'feedParam'
				let feedPos = try scan.typeParamPositions.positionAt(p as ParamCount) otherwise panic("feedsMergedOnto: `{String.from(scan.funcName)}` parameter {p} is a fed node and names no type parameter — the fixpoint's seeds are type-parameter feeds and its edges start only at bare type-parameter arguments")
				feeds.push(TypeParamFeed.feeds(feedPos, sink: FeedSink.calleeStorage))
			end 'feedParam' else 'sweptParam'
				let swept = prior.typeParamFeedOf(p as ParamCount)
				feeds.push(swept)
			end 'sweptParam'
		end 'buildFeeds'

		return ParamConsumeInfo.create(scan.paramNames, bits: prior.bits, feeds: freeze feeds, handedOn: prior.handedOn, forwardedStores: prior.forwardedStores)
	end 'feedsMergedOnto'

	// ⭐ **READ A PARAMETER LIST IN ONE WALK** — the ordered NAMES out of the `(…)` beginning at
	// `parenPos` (returned), and IN THE SAME PASS the type-parameter POSITION each parameter's declared type
	// names (a concrete slot for a plain type), pushed into
	// `typeParamPositionsOut`. Peek-only (the cursor is untouched). Each parameter is `name Type`, so the
	// first token after `(` or a top-level `,` is the name and the type runs to the next top-level `,` or the
	// closing `)`; `skipParamType` finds that end (paren depth tracked, because a type may itself contain
	// parens — `int(0 to 100)`, `function(X) returns Y`).
	//
	// ⭐ **AND, ON THE SAME WALK, THE DECLARED TYPE ITSELF** (`typesOut`, with its written name in `spellingsOut`
	// — empty for a type that is not a name — both gated by `collectTypes` exactly as the positions are by
	// their own flag) — the CALL-side half of a swept declaration, read through `sweptParamTypeAt`.
	// It rides this walk rather than one of its own for the reason the positions do: `names[i]` and `types[i]`
	// describe the same parameter by construction.
	//
	// ⚠ **NAME AND TYPE-PARAM POSITION ARE PRODUCED TOGETHER, SO `names[i]` AND `positions[i]` ALWAYS
	// DESCRIBE THE SAME PARAMETER.** The consume scan reads the position to decide whether parameter `i` was
	// moved into a plain field (`Self{f: p}` — consumed), fed a type parameter (a concrete-site managed
	// consume), or merely aliased — a MISALIGNMENT would fire on the wrong parameter and leak or
	// double-move. Two independent walks would agree only by coincidence; ONE walk makes it structural. When
	// `collectTypeParamFlags` is false — every function OUTSIDE a generic type, i.e. all of them on the
	// generics-free corpus — the position work is skipped and `typeParamPositionsOut` is left untouched (the
	// caller passes the SHARED empty array, ⚡ so the hot path allocates no per-function array).
	//
	// ⚠ **`recordParamNameKeywords` DELIBERATELY DOES NOT SHARE THIS WALK, and that is not an oversight**
	// — see there: it needs a strictly COARSER answer that this grammar cannot give more cheaply, and a shared
	// walk that returned index COLUMNS measured **+7,794 allocations at rung 0 of the scale ladder, doubling
	// per rung**, because it put three heap objects on a once-per-function path.
	function paramNamesIn(parenPos ElementIndex, typeParamPositionsOut TypeParamSlots, collectTypeParamFlags bool, typesOut MaxonTypeArray, collectTypes bool, spellingsOut NameRoster, capabilitiesOut ParamCapabilityArray) returns NameRoster
		let names = NameRoster.create(0)
		var q = parenPos

		if self.kindAt(q) != TokenKind.leftParen 'noParens'
			return names
		end 'noParens'

		q = parameterListStartIn(self.tokens, open: parenPos)

		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return names
		end 'noParams'

		while true 'params'
			// The parameter's first token is its NAME (an identifier — or a keyword like `type`, which is a
			// legal parameter name; the type reader that follows is what tells them apart, and the sweep only
			// needs the text, not the kind).
			names.push(self.tokenAt(q).value)
			let typeStart = self.paramTypeStartAfter(q)
			let typeEnd = self.skipParamType(typeStart)

			if collectTypeParamFlags 'flag'
				self.pushParamTypeParamSlot(typeParamPositionsOut, typeStart: typeStart, typeEnd: typeEnd)
			end 'flag'

			if collectTypes 'collectsParamTypes'
				typesOut.push(self.sweptParamTypeAt(typeStart, typeEnd: typeEnd))
				capabilitiesOut.push(self.declaredParamCapabilityAt(q))

				let spellingSegments = self.dottedChainLengthAt(typeStart)

				if self.kindAt(typeStart) == TokenKind.identifier and typeEnd == typeStart + spellingSegments * TokensPerQualifierSegment + 1 'aNameType'
					spellingsOut.push(chainSpellingAt(self.tokens, at: typeStart, segments: spellingSegments))
				end 'aNameType' else 'anyOtherType'
					spellingsOut.push(EmptySourceText)
				end 'anyOtherType'
			end 'collectsParamTypes'

			// The TYPE ends at `typeEnd` and the PARAMETER may not — see `paramItemEndFrom`.
			let itemEnd = self.paramItemEndFrom(typeEnd)

			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				return names
			end 'endList'

			q = itemEnd + 1
		end 'params'

		panic("paramNamesIn: the parameter loop only exits by returning at the closing `)` or at EOF")
	end 'paramNamesIn'

	// The TYPE-PARAMETER POSITION the parameter type spanning `[typeStart, typeEnd)` names — a
	// SINGLE identifier (`typeEnd == typeStart + 1`) whose text is a `uses` parameter of the enclosing type
	// resolves to its position; anything else is a concrete slot. The consume scan reads it BOTH as "is it a
	// type parameter?" and as the feed position — one walk, one fact.
	function pushParamTypeParamSlot(slots TypeParamSlots, typeStart ElementIndex, typeEnd ElementIndex)
		if typeEnd == typeStart + 1 and self.kindAt(typeStart) == TokenKind.identifier 'singleIdent'
			if let position = try self.enclosingTypeParams.positionOfName(self.tokenAt(typeStart).value) 'namesAUsesParameter'
				slots.pushTypeParameter(position)
				return
			end 'namesAUsesParameter'
		end 'singleIdent'

		slots.pushConcrete()
	end 'pushParamTypeParamSlot'

	// ⭐⭐ **WHAT THE SWEEP PUBLISHES ABOUT ONE PARAMETER'S DECLARED TYPE — the CALL-side half of a swept
	// declaration** (`ProgramSignatures.sweptDeclarationOf`). It is read through `parseTypeReference`, the ONE type
	// reader this sweep already reads a `returns` clause with, so a parameter's swept type and its parsed one
	// cannot become two opinions of what a spelling means.
	//
	// ⚠⚠ **ONLY A SINGLE-TOKEN TYPE, A DOTTED NAME AND A TUPLE ARE READ, AND THAT BOUNDARY IS DELIBERATE.**
	// A tuple is read because a tuple literal argument takes its element types from the declared parameter
	// (`tupleTargetForArgument`); the real parse of that declaration registers the same tuple, so reading it
	// here moves only the ORDER of registration, and only in a program that declares a tuple parameter.
	//   • **COST** — this runs at every parameter of every declaration in the program, and a compound type is
	//     where the reader allocates.
	//   • **REGISTRATION ORDER** — reading a compound type REGISTERS it whole-program: `parseTupleTypeReference`
	//     interns the tuple through `ProgramSignatures.internTupleType`, which mints a canonical name and a
	//     layout on the index. Every registration the sweep makes moves the `GenericInstanceId` of every later
	//     one, and those ids decide mangled instance names and which claimant `checkTypeSymbolNamespace` calls
	//     the newcomer.
	//
	// A type it does not read is recorded as `MaxonType.unresolved` — the tag's own "no type is known here"
	// arm, never a stand-in for one — and `slottedMemberFeed` does not judge such a parameter.
	//
	// The cursor is saved and restored, so the peek-only contract of the walk that calls this holds.
	function sweptParamTypeAt(typeStart ElementIndex, typeEnd ElementIndex) returns MaxonType
		if typeEnd != typeStart + 1 and not self.paramTypeIsADottedName(typeStart, typeEnd: typeEnd) and self.kindAt(typeStart) != TokenKind.leftParen 'aCompoundTypeIsNotReadHere'
			return sharedUnreadParamType
		end 'aCompoundTypeIsNotReadHere'

		let saved = self.pos
		self.pos = typeStart

		// TOLERANT for `foldDeclaredSignaturesInto`'s reason: a type this reader cannot make sense of is the
		// REAL parse's to report, with a position, and a sweep that vetoed would reject a correct program.
		let swept = try self.parseTypeReference(BarePrimitiveVoice.asAType) otherwise sharedUnreadParamType
		self.pos = saved
		return swept
	end 'sweptParamTypeAt'

	// ⭐⭐ **A DOTTED NAME, THROUGH ANY NUMBER OF SEGMENTS, IS A COMPOUND SHAPE THE SWEEP DOES READ, AND
	// NEITHER REASON ABOVE APPLIES TO IT.** It registers nothing (a dotted name is a `named`, and only tuples
	// and generic instantiations mint), and it costs a token test per segment plus the one-token reader's own
	// work.
	//
	// ⛔ **AND WITHOUT IT A SERVICE CANNOT TAKE A HANDLE, WHICH THE DESIGN REQUIRES.** A message's parameters
	// ARE the payload fields of the synthesized request union (`ServiceCompanions.serviceRequestPayloads`
	// resolves each one), so a `run(sink Logger.handle)` recorded `unresolved` builds a payload declared
	// `unresolved` — and that reaches `classifyUnionPayload`'s panic.
	function paramTypeIsADottedName(typeStart ElementIndex, typeEnd ElementIndex) returns bool
		let dots = self.dottedChainLengthAt(typeStart)
		return dots > 0 and typeEnd == typeStart + dots * TokensPerQualifierSegment + 1
	end 'paramTypeIsADottedName'

	// ⭐ The inner-alias PARAMETER shape of the parameter list at `parenPos` — its SOURCE parameter
	// names and, per position, the bare inner-alias MEMBER (`Idx`) or `EmptySourceText`. It walks the list the
	// way `paramNamesIn` does (the ONE parameter grammar) but reads the TYPE token span rather than skipping
	// it. Only called inside a generic type that declares inner aliases.
	function innerAliasParamsIn(parenPos ElementIndex) returns InnerAliasParamInfo
		let names = NameRoster.create(0) as isolated NameRoster
		let members = InnerAliasMemberArray.create(0) as isolated InnerAliasMemberArray
		var q = parenPos

		if self.kindAt(q) != TokenKind.leftParen 'noParens'
			return InnerAliasParamInfo.create(freeze names, members: freeze members)
		end 'noParens'

		q = parameterListStartIn(self.tokens, open: parenPos)

		if self.kindAt(q) == TokenKind.rightParen 'noParams'
			return InnerAliasParamInfo.create(freeze names, members: freeze members)
		end 'noParams'

		while true 'params'
			let paramName = self.tokenAt(q).value
			names.push(paramName)
			let typeStart = self.paramTypeStartAfter(q)
			let typeEnd = self.skipParamType(typeStart)
			let member = self.innerAliasMemberOfParamType(typeStart, typeEnd: typeEnd)
			members.push(member)

			// The TYPE ends at `typeEnd` and the PARAMETER may not — see `paramItemEndFrom`.
			let itemEnd = self.paramItemEndFrom(typeEnd)

			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				return InnerAliasParamInfo.create(freeze names, members: freeze members)
			end 'endList'

			q = itemEnd + 1
		end 'params'

		panic("innerAliasParamsIn: the parameter loop only exits by returning at the closing `)` or at EOF")
	end 'innerAliasParamsIn'

	// The bare inner-alias MEMBER a parameter type spanning `[typeStart, typeEnd)` names, or
	// `InnerAliasMember.none`. A SINGLE identifier (`typeEnd == typeStart + 1`) that denotes an inner
	// alias here is a bare inner alias (`Idx`); anything else — a `T`, a plain alias, a qualified
	// `Inst.Idx`, a `function(…)` — is not one and reads as `none`.
	//
	// ⚠ **THE TEST IS `namesInnerAliasHere`, THE ONE HOME OF THAT QUESTION, AND NOT THE BODY WALK'S SET
	// DIRECTLY.** The set would make this door and `parseTypeReference`'s inner-alias arm two answers to one
	// written name: in an `extension` body the arm resolves a member declared elsewhere and this door would
	// not, so the parameter would carry the per-instance TYPE while the index carried no per-instance ENTRY
	// for it. See the gate in `recordScannedSignature`.
	function innerAliasMemberOfParamType(typeStart ElementIndex, typeEnd ElementIndex) returns InnerAliasMember
		if typeEnd == typeStart + 1 and self.kindAt(typeStart) == TokenKind.identifier and self.namesInnerAliasHere(self.tokenAt(typeStart).value) 'innerAlias'
			return InnerAliasMember.named(self.authorsMemberName(self.tokenAt(typeStart).value))
		end 'innerAlias'

		return InnerAliasMember.none
	end 'innerAliasMemberOfParamType'

	// Advance past ONE parameter's TYPE — from the token AFTER the parameter's name to the token that
	// ENDS the type: the `=` opening its DEFAULT VALUE, the `,` before the next parameter, the `)` closing
	// the list, or EOF on a malformed list. Balanced over nested `(...)` (a `function(…)`-typed parameter).
	//
	// ⚠ **THE `=` STOP IS NOT ONLY FOR THE DEFAULT WALK — IT IS WHAT KEEPS THE EXISTING SCANS CORRECT.**
	// Every caller reads the SPAN `[typeStart, typeEnd)` as the declared type:
	// `pushParamTypeParamSlot` calls a span of length 1 a bare type parameter, and
	// `innerAliasMemberOfParamType` reads its tokens. Left running to the `,`, `p T = 1` would hand both of
	// them a three-token "type" and a `uses`-parameter-typed parameter would stop being recognized as one
	// the moment it gained a default. No type reference can CONTAIN a top-level `=` — `int(0 to 100)` and
	// `function(X) returns Y` are the two shapes with internal structure and neither spells one — so the
	// stop is unambiguous.
	function skipParamType(fromType ElementIndex) returns ElementIndex
		var q = fromType
		var depth = 0 as NestingDepth

		while true 'skip'
			let kind = self.kindAt(q)

			if kind == TokenKind.eof 'malformed'
				return q
			end 'malformed'

			if kind == TokenKind.leftParen 'openType'
				depth = depth + 1
			end 'openType'

			if kind == TokenKind.rightParen 'closeType'
				if depth == 0 'endList'
					return q
				end 'endList'

				depth = depth - 1
			end 'closeType'

			if (kind == TokenKind.comma or kind == TokenKind.equals) and depth == 0 'endOfType'
				return q
			end 'endOfType'

			q = q + 1
		end 'skip'

		panic("skipParamType: the loop only exits by returning at `=`, `,`, `)` or EOF")
	end 'skipParamType'

	// ⭐ **THE TOKEN THAT ENDS ONE PARAMETER — ITS TYPE, PLUS ITS DEFAULT IF IT HAS ONE.** THE one stepper
	// every peek-only parameter-list walk advances by, and it exists because the alternative shipped a
	// SEGFAULT.
	//
	// ⚠⚠ **A WALK THAT STEPS BY `skipParamType` STOPS AT THE FIRST DEFAULTED PARAMETER AND SILENTLY REPORTS
	// A SHORT LIST.** `skipParamType` ends the TYPE, which for `tag Integer = 1, item T` is the `=` — not a
	// `,`, so the walk reads the list as finished and never sees `item`. A short parameter list is a
	// well-formed one, so nothing downstream notices: what is lost is the per-parameter OWNERSHIP fact those
	// walks exist to publish. MEASURED (`specs/param-default-list-walks.md`): with `item` dropped from
	// `scanBodyFacts`' view, a `Box uses T` constructor's type-parameter FEED went unrecorded, the concrete
	// call site did not consume the `String` it passed, caller and box both owned it — and the program died
	// with an access violation, against a control identical but for the default that answered 6.
	//
	// So the TYPE SPAN and the STEP are two different questions and are asked separately: a caller that
	// wants `[typeStart, typeEnd)` still calls `skipParamType`, and every caller that wants the NEXT
	// parameter calls this.
	function paramItemEndFrom(typeEnd ElementIndex) returns ElementIndex
		if self.kindAt(typeEnd) != TokenKind.equals 'noDefault'
			return typeEnd
		end 'noDefault'

		return self.expressionEndFrom(typeEnd + 1)
	end 'paramItemEndFrom'

	// The end of the expression starting at `start`, found at bracket depth 0 — the one walker a parameter
	// default, a record-literal field value and a binding's value all end by.
	//
	// ⚠ It does not stop at `=`: every caller starts one token past the `=` that opens the value, and Maxon
	// has no assignment expression.
	function expressionEndFrom(start ElementIndex) returns ElementIndex
		var depth = 0 as BracketDepth
		var q = start

		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)

			if declarationOpensAtHeadColumn(self.tokens, index: q) or (depth == 0 and (kind == TokenKind.comma or kind == TokenKind.returns or tokenKindClosesABracket(kind))) 'itemEnds'
				return q
			end 'itemEnds'

			if tokenKindOpensABracket(kind) 'opens'
				depth = depth + 1
			end 'opens' else if tokenKindClosesABracket(kind) 'closes'
				depth = depth - 1
			end 'closes'

			q = q + 1
		end 'walk'

		return q
	end 'expressionEndFrom'

	// ⭐⭐ **IS THIS PARAMETER DEFAULT ONE OF THE TWO CALLER-LOCATION KEYWORDS?** — asked of the token
	// region `(fromEquals, exprEnd)` a default occupies, by BOTH walks of a parameter list: the declaration
	// sweep, which publishes the slot's `ParamDefaultProducer`, and the real parse, which must mint no helper
	// for one. ONE classifier, for `sweptParamDefaultHelperName`'s reason — two walks answering this
	// differently give a call site a helper the drain never declares, or a drain a helper nothing calls.
	//
	// ⚠ **EXACTLY ONE TOKEN, NOT "CONTAINS ONE"** — `= __line__ + 1` is REFUSED rather than expanded
	// (see `requireNoEmbeddedCallerLocation`), and the reason is architectural rather than a reach
	// limit: the value must be materialized AT THE CALLER, and a caller cannot re-parse the declaring
	// file's tokens — that impossibility is the very property making the compiler's per-file parse a pure
	// function (`SignatureIndex.ParamDefaultInfo`). Accepting the arithmetic would mean replaying a
	// default's tokens at each call site.
	function callerLocationDefaultAt(fromEquals ElementIndex, exprEnd ElementIndex) returns CallerLocationDefault
		let onlyToken = fromEquals + 1

		if exprEnd != onlyToken + 1 or self.kindAt(onlyToken) != TokenKind.identifier 'notASingleName'
			return CallerLocationDefault.none
		end 'notASingleName'

		return callerLocationNamed(self.tokenAt(onlyToken).value)
	end 'callerLocationDefaultAt'

	// The refusal the classifier above owes the region it just called ORDINARY: a default that MENTIONS
	// `__line__`/`__file__` without being one. Asked only by the real parse — the sweep publishes a helper
	// for such a region and the parse then refuses the file, so the two never disagree about a program that
	// compiles.
	//
	// It is a separate diagnostic from E2060 and not that one reworded: E2060's sentence says the keyword is
	// legal only as a parameter default, and here it IS in one. What is wrong is the ARITHMETIC around it.
	function requireNoEmbeddedCallerLocation(fromEquals ElementIndex, exprEnd ElementIndex) throws SourceParseError
		var q = fromEquals + 1

		while q < exprEnd 'scan'
			if self.kindAt(q) == TokenKind.identifier 'aName'
				let tok = self.tokenAt(q)

				match callerLocationNamed(tok.value) 'keyword'
					none then break
					line or
					file then throw SourceParseError.unsupported("'{String.from(tok.value)}' inside a larger default expression — a caller-location default is materialized AT THE CALL SITE, from the caller's own position, and the declaring file's expression is not available there to evaluate around it. The whole default must be the keyword alone; do the arithmetic in the body", line: tok.line, column: tok.column)
				end 'keyword'
			end 'aName'

			q = q + 1
		end 'scan'
	end 'requireNoEmbeddedCallerLocation'

	// The name a `function <nameTok>` is DECLARED under: its own, at file scope; `Point.create`
	// inside `type Point`.
	//
	// It reads `enclosingType`, which BOTH the sweep and the real parse set (see that field), so
	// the key the index records and the key the `IrFunction` carries are one name derived one way.
	// The alternative — the sweep recording `create` and the parse declaring `Point.create` — is
	// not a subtle failure: every call would report E3004 against a name nothing declared.
	// ⭐⭐ **AND A FREE FUNCTION WHOSE BARE NAME IS CONTESTED ACROSS DIRECTORIES IS DECLARED UNDER ITS
	// MINT** — `alpha~duplicate` for a `duplicate` in `alpha/` when `beta/` declares one too, rendered
	// `alpha.duplicate` in diagnostics. The two declarations then have distinct signatures, distinct
	// `IrFunction`s and distinct emitted symbols rather than one of them silently winning.
	//
	// ⚠ **GATED ON `allFilesFolded`, and the two passes MUST answer differently here.** The declaration sweep
	// is what DISCOVERS the contest, so during it the answer is always the bare name — and `foldFile` moves
	// the sweep's own entries onto the qualified key at the moment it learns better. The real parse runs
	// against a complete index and mints the final name. Without the gate the answer would depend on how far
	// the sweep had got, which is a property of the filesystem's walk order.
	//
	// ⚠ **`main` IS NEVER CONTESTED**, so it never reaches the qualifying arm — `recordScannedSignature`
	// keeps the entry point out of the contest entirely, which is what leaves two `main`s a hard duplicate.
	function declaredMethodName(nameTok Token) returns immutable ByteArray
		if let typeName = try self.enclosingType.typeName() 'method'
			return qualifiedMethodName(typeName, methodName: nameTok.value)
		end 'method'

		if self.declaresAContestedFreeFunction(nameTok) 'contestedAcrossDirectories'
			return self.signatures.freeFunctionRegistrationName(nameTok.value, moduleDirectory: self.signatures.moduleDirectoryOf(self.job.path))
		end 'contestedAcrossDirectories'

		return nameTok.value
	end 'declaredMethodName'

	function declaresAContestedFreeFunction(nameTok Token) returns bool
		return not self.enclosingType.isType() and self.signatures.allFilesFolded and self.signatures.isContestedFreeFunction(nameTok.value)
	end 'declaresAContestedFreeFunction'

	// Cursor is AT `typealias`. Append the alias the declaration names, if it is well-formed enough
	// to read one off.
	//
	// TOLERANT, exactly as `recordScannedSignature` is, and for the same reason: a malformed alias
	// is the REAL parse's to report, with a position; a sweep that could veto would reject a correct
	// program the moment it failed to recognize something the parser accepts.
	//
	// It reads through `readTypeAliasDeclaration` — the very routine the real parse reads with — so
	// the sweep and the parse cannot drift into two opinions of what a range MEANS. That shared
	// routine consumes the `typealias` keyword before it can fail, so the cursor always advances and
	// the caller's loop cannot spin.
	//
	// The FORM it read is discarded here alone: the sweep's job is the registries, and the type-name
	// collision the form feeds is decided at the merge from the REAL parse's artifact (whose position
	// is the one a diagnostic must be anchored on).
	// ⚠ **THE SWEEP MUST READ THE `export` ITSELF**, because its walk skips the keyword as an ordinary
	// token and the visibility it drops is the one `RangedAliasRegistry.lookup` resolves by. The
	// cursor's `export` is consumed here rather than in the caller's loop for the same reason the
	// alias's whole grammar is read here: the two passes must agree about what a declaration SAYS, and
	// the fewer places that read a declaration, the fewer can disagree.
	function recordScannedTypeAlias(aliases RangedTypeAliasArray, functionAliases FunctionTypeAliasArray, genericAliases GenericAliasEntryArray)
		let visibility = try self.consumeOptionalVisibility() otherwise return
		_ = try self.readTypeAliasDeclaration(aliases, functionOut: functionAliases, genericOut: GenericAliasSink.collect(genericAliases), tupleOwner: TupleAliasOwner.fileScope, recordFunctionSignature: false, visibility: visibility) otherwise return
	end 'recordScannedTypeAlias'

	// Consume an optional leading `export` / `public` modifier and answer what it means. THE one reader of
	// those two — four walks meet it (the top-level dispatch, a type member, the declaration sweep's typealias
	// arm and its type-body scan) and each would otherwise spell the same four lines, which is one rule written
	// down four times in a file where a fifth walk is always about to be added.
	//
	// It THROWS, and the tolerant sweep's callers absorb that with `try … otherwise return` exactly as they
	// absorb a malformed declaration: a modifier conflict is the REAL parse's to report, with a position.
	function consumeOptionalVisibility() returns Visibility throws SourceParseError
		if self.at(TokenKind.export) 'exported'
			let exportTok = self.current()
			self.advance()

			// The anchor is the SECOND modifier's token and not the first: the modifier that cannot be there is
			// the one the message is about, and it is the oracle's position (`public-keyword`'s).
			try self.refuseSecondVisibilityModifier(VisibilityModifierWord.wordExport)
			try self.requireVisibilityFitsTheRuntimeTier(VisibilityModifierWord.wordExport, anchor: exportTok)

			return Visibility.global
		end 'exported'

		if self.at(TokenKind.public) 'publicApi'
			let publicTok = self.current()
			self.advance()
			try self.refuseSecondVisibilityModifier(VisibilityModifierWord.wordPublic)
			try self.requireVisibilityFitsTheRuntimeTier(VisibilityModifierWord.wordPublic, anchor: publicTok)

			return Visibility.public
		end 'publicApi'

		return Visibility.unexported
	end 'consumeOptionalVisibility'

	// A modifier has just been consumed; refuse a second one. Split out because there are now THREE words
	// and so three arms that would otherwise each re-spell "which other modifiers could be here", which is
	// the modifier SET written down a fourth time.
	function refuseSecondVisibilityModifier(consumed VisibilityModifierWord) throws SourceParseError
		if not visibilityModifierIn(self.tokens, index: self.pos) 'onlyOne'
			return
		end 'onlyOne'

		let tok = self.current()
		let offending = self.visibilityModifierWordAt(self.pos)

		// Sorted into `VisibilityModifierWord`'s declaration order, NOT the order they were written. Six
		// live cases pin `'export' and 'module' cannot be combined`, so `module export` must render exactly
		// what `export module` renders. The POSITION stays the offending token's either way.
		if consumed.ordinal <= offending.ordinal 'alreadyInOrder'
			throw SourceParseError.visibilityModifiersCombined(consumed, later: offending, line: tok.line, column: tok.column)
		end 'alreadyInOrder'

		throw SourceParseError.visibilityModifiersCombined(offending, later: consumed, line: tok.line, column: tok.column)
	end 'refuseSecondVisibilityModifier'

	// ⭐⭐ **A `runtime/` DECLARATION MAY NOT BE VISIBLE OUTSIDE THE TIER (E3154).** `runtime/` is loaded
	// into EVERY program, so a declaration at `export` (global) or at `public` contests names with the very
	// programs the tier is linked into — and the compiler compiling ITSELF is one of them, where a `runtime/`
	// alias and the compiler's own of that name render each other ambiguous (E3063). An unmarked declaration
	// is the widest tier that still gives the runtime the file-to-file sharing a runtime split across several
	// files needs, so the rule is a CEILING on visibility rather than two banned words.
	//
	// ⚠ It is stated at `consumeOptionalVisibility`, the file's ONE reader of `export`/`public`, and not at
	// `visibilityBefore`: that twin reads the modifier BACKWARDS for the sweep's type and enum arms and would
	// be a second position for one rule.
	//
	// ⚠ **ASKED ONLY ON THE REPORTING WALK, for `requireNoManagedTypeInRuntimeSource`'s reason.** The
	// declaration sweep reads the same modifier through this same door and absorbs a throw with
	// `try … otherwise return`, which would DROP the declaration from the signature registry — the `export`
	// would then surface as unrelated unknown-type errors wherever that name is spelled, rather than as this
	// refusal. The real parse reaches the same modifier and refuses the compile with the position.
	function requireVisibilityFitsTheRuntimeTier(keyword VisibilityModifierWord, anchor Token) throws SourceParseError
		if not self.job.isRuntimeSource or not self.isTheReportingWalk 'nothingToRefuse'
			return
		end 'nothingToRefuse'

		throw SourceParseError.wideVisibilityInRuntimeSource(keyword, line: anchor.line, column: anchor.column)
	end 'requireVisibilityFitsTheRuntimeTier'

	// Which modifier word sits at `index`. Only ever asked where `visibilityModifierIn` already answered
	// true, so a token that is none of the three is a caller bug rather than an input.
	function visibilityModifierWordAt(index ElementIndex) returns VisibilityModifierWord
		if self.kindAt(index) == TokenKind.export 'exported'
			return VisibilityModifierWord.wordExport
		end 'exported'

		if self.kindAt(index) == TokenKind.public 'publicApi'
			return VisibilityModifierWord.wordPublic
		end 'publicApi'

		panic("visibilityModifierWordAt: token at {index} is not a visibility modifier")
	end 'visibilityModifierWordAt'

	// ⭐⭐ **IS THE CURSOR ON THE `spawn` PREFIX OPERATOR?** An identifier spelled `spawn` is the
	// operator iff the next token past an optional `(capacity: …)` group opens a NAME, because two
	// adjacent name tokens begin no expression the grammar has. See `SpawnKeywordName` for the two
	// live declarations of the word that forbid a `KeywordTable` row.
	//
	// `Self` is admitted here and REFUSED inside `parseSpawn`, deliberately: `spawn Self.create()` is a
	// spelling that cannot be resolved (the whole-program discovery walk that decides which types are
	// services reads tokens with no type scope), and admitting it at the door is what lets it be refused in
	// its own words instead of dying as `E2001 unexpected token: 'Self'`.
	//
	// ⭐⭐ **THE THIRD CLAUSE ADMITS A KEYWORD AS A DECLARED NAME, AND ITS ABSENCE IS MEASURED.** A
	// bare `identifier` test refuses `spawn Reader.from(path)` outright, because `from` is a real keyword
	// (`Set from […]`) that `tokenCanBeAName` nonetheless admits in a NAME position, and
	// `stdlib/FilePath.maxon`'s `FilePath.from` declares exactly that shape — `static function
	// from(path String) returns Self`, a factory. MEASURED without this clause: `spawn String.from(b"x")` earned the SHAPE refusal
	// ("`spawn` is followed by a STATIC CALL on a type"), which is a sentence about a program the author did
	// not write.
	//
	// ⚠ **AND IT NEEDS THE DOT, WHERE THE FIRST TWO CLAUSES DO NOT.** `spawn work()` must be CLAIMED — it is
	// the commonest mistake and the one refusal that teaches the form — so an `identifier` alone is enough
	// there. A keyword alone is not: `spawn end` in a broken program would then earn a sentence about
	// services instead of the token error it is. Requiring the qualifier keeps the widening to exactly the
	// shape a keyword-named type produces.
	function atSpawnPrefix() returns bool
		if not tokenIsTheSpawnKeyword(self.tokenAt(self.pos)) 'notTheWord'
			return false
		end 'notTheWord'

		let targetIndex = spawnTargetIndexIn(self.tokens, spawnIndex: self.pos)
		let next = self.kindAt(targetIndex)

		if next == TokenKind.identifier or next == TokenKind.selfType 'anOrdinaryTypeName'
			return true
		end 'anOrdinaryTypeName'

		return tokenCanBeAName(self.tokenAt(targetIndex)) and self.kindAt(targetIndex + 1) == TokenKind.dot
	end 'atSpawnPrefix'

	// Replace the shared empty with a real array, once, on the first generic type this file declares. EMPTY
	// IS THE TEST because the shared instance is never mutated — the field is the shared one exactly while it
	// is empty — so the swap costs one comparison per generic type and one allocation per file that has any.
	function growDescriptorScanSites()
		if self.descriptorScanSites.count() != 0 'alreadyItsOwn'
			return
		end 'alreadyItsOwn'

		self.descriptorScanSites = DescriptorScanSiteArray.create(0)
	end 'growDescriptorScanSites'

	// Cursor is AT `type`. Append the struct it declares, plus a `FuncReturnTypeEntry` for each
	// method it declares, and leave the cursor PAST the declaration's `end`.
	//
	// TOLERANT, exactly as `recordScannedSignature` and `recordScannedTypeAlias` are, and for the
	// same reason: a malformed `type` is the REAL parse's to report, with a position. It shares
	// `readTypeHeader`, `atStructFieldKeyword`, `readStructFieldInto` and `recordScannedSignature`
	// with `parseTypeDeclaration`, so the sweep and the parse cannot drift on what a field IS, what
	// a method is CALLED, or where the declaration ENDS — the three facts they must agree on,
	// because the layout THIS pass records is the one the real parse reads every offset out of.
	//
	// ⚠ IT WALKS THE BODY ITSELF rather than letting the caller's loop do it, and the reason is the
	// depth-0 gate on fields: `export var x as Integer` is a FIELD at the type's top level and a
	// LOCAL BINDING one level down, and only a counter that knows where the type's body starts can
	// tell them apart. `depth` here is relative to the body — 0 is directly inside it — and
	// `blockDepthAfter` is the same opener/closer rule the caller counts with, so a method's `if`
	// and `while` nest correctly and its `end` cannot be mistaken for the type's.
	function recordScannedType(structs StructLayoutArray, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, bodyFacts SweptBodyFactEntryArray, innerAliasOut InnerAliasEntryArray, genericAliasOut GenericAliasEntryArray, functionAliasOut FunctionTypeAliasArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut NameRoster, conformanceSiteOut ConformanceClauseDeclSiteArray, bindingOut TopLevelDeclArray)
		// The DECLARATION keyword, taken before anything moves the cursor — the position
		// `Queries.foldConformanceClauses` puts a reader back down on. See `ConformanceClauseDeclSite`.
		let declStart = self.pos

		// ⚠ **THE SWEEP MUST READ THE MODIFIER ITSELF**, and BACKWARDS, exactly as `recordScannedBinding`
		// does: the caller's loop meets `export`/`public` as an ordinary token and steps over it, so the
		// cursor arrives here already on the `type` keyword. Read forwards it would answer `unexported` for every
		// declaration in the program — and the sweep's layout is the one the PARSER resolves every type name
		// against, so the two passes disagreeing about a tier is a wrong answer about what another file may
		// name.
		let visibility = self.visibilityBefore(self.pos)
		let header = try self.readTypeHeader() otherwise return
		let nameTok = header.nameTok
		self.enterTypeScope(nameTok.value, isEnum: false)
		self.scanBodyNestedAliases()

		let layout = StructLayout.create(nameTok.value, visibility: visibility, declFilePath: self.job.path)
		layout.declLine = nameTok.line
		layout.declColumn = nameTok.column
		layout.isLinear = typeBodyHoldsADestruct(self.tokens, from: self.pos)
		layout.isUnique = header.isUnique or layout.isLinear

		// ⭐ **THE TYPE'S MESSAGE ROSTER, COLLECTED ON THE ONE WALK THAT READS ITS MEMBERS IN ORDER** —
		// see `StructLayout.messageMethodNames`, which owns what membership means and why this sweep is the only
		// writer. Handed to `recordScannedSignature` so the tier and the receiver bit are read ONCE per
		// declaration, by the routine that already reads them, rather than re-derived at this arm.
		let messageMethods = NameRoster.create(0)

		// `uses T` — parsed here, in the tolerant sweep, exactly as `parseTypeDeclaration` does
		// it, so the scanned layout carries the SAME parameter list the real parse reads a field's
		// `typeParameter(token)` against. The cursor lands past the clause, at the type body the loop walks.
		self.openTypeParamScope(layout)

		// ⭐ **`implements I1, I2 [with …]` — THE NAMES AND THE FINAL `with` BINDINGS, AND THAT IS WHY IT IS
		// STILL NOT `parseImplementsClause`.** The sweep needs this for exactly one reader: an EXTENSION is
		// expanded onto every type whose clause names its interface — and, when the extension is CONDITIONAL,
		// only onto those whose bindings satisfy its `where` clause — and that expansion must land in the
		// whole-program signature index before any file is parsed. The real parse's `parseImplementsClause`
		// records the richer `ConformanceDecl` (bindings + POSITION) that `checkConformance` verifies from; see
		// `StructLayout.conformsTo` for why the two records are deliberately not one.
		//
		// ⚠ **AN UNPARENTHESIZED `with` STILL ENDS THE READ HERE, so `implements Container with Score, Other`
		// records `Container` alone.** Whether that comma opens a second ARGUMENT or a second INTERFACE is the
		// interface's `uses` ARITY, and the arity is a fact only the COMPLETE index holds — this walk is
		// what builds it. Reading it here as a second interface would be that same false reject in the other
		// direction, so the reader stops and the answer is a SUBSET of the clause.
		//
		// ⭐ **THAT SUBSET IS NOT THE FINAL ANSWER: THE POSITION IS RECORDED AND THE CLAUSE IS RE-READ
		// WHOLE-PROGRAM.** Without the re-read, a type that names an interface after a `with` receives none of
		// that interface's extensions, so the ORDER of a conformance clause changes what the program means.
		// `Queries.foldConformanceClauses` puts this same reader back down on `declStart` once
		// `foldInterfaceDeclarations` has made the arity knowable. See `ConformanceClauseDeclSite`.
		//
		// Tolerant like every other read on this walk: a malformed clause records no conformance and leaves
		// the positioned diagnostic to the real parse. The cursor is left wherever the read stopped, which the
		// body loop below steps over token by token.
		// ⚠ **ONLY A CLAUSE THAT WRITES A `with` DEFERS ANYTHING** (`implementsClauseBindsAnything`): the arity
		// this reader cannot know is consulted inside the `with` arm and nowhere else, so a clause without one
		// is read the same by both passes and the re-read would re-derive this answer.
		var headerDeferred = false

		if self.at(TokenKind.implements) and self.implementsClauseBindsAnything() 'deferredConformances'
			conformanceSiteOut.push(ConformanceClauseDeclSite.create(self.job.path, tokenPos: declStart, declName: nameTok.value, declIsEnum: false))
			headerDeferred = true
		end 'deferredConformances'

		self.openConformanceClauseAliasScope()
		let scannedConformances = try self.readOptionalImplementsClause() otherwise ScannedConformanceClause.declaringNothing()
		self.closeConformanceClauseAliasScope()
		layout.recordConformances(scannedConformances.names, bindings: scannedConformances.bindings)

		// The cursor now sits at the type body's first token — captured for the transitive array-feed post-pass
		//, which re-walks the body once EVERY method's parameter list is known. `feedStart` marks
		// the point in `paramConsumes` this type's own entries begin, so that post-pass patches only them.
		let bodyStart = self.pos
		let feedStart = paramConsumes.count()

		// ⭐ **AND THE SAME POSITION IS THE FIXED-ELEMENT-COUNT FIXPOINT'S SITE** — recorded only for the
		// SIZED CONTAINER, because a count can be read only inside its own body (`fixedElementCountEdgesFor`).
		if self.signatures.isFixedArrayBaseName(nameTok.value) 'aGenericType'
			self.growDescriptorScanSites()
			self.descriptorScanSites.push(DescriptorScanSite.create(self.job.path, bodyStart: bodyStart, typeName: nameTok.value))
		end 'aGenericType'

		var depth = 0 as BlockDepth

		while not self.isEof() 'body'
			// `closesBlockAt`, not a `TokenKind.end` test of its own — the sweep's twin of
			// `recordScannedInterface`'s fix, and for its reason. Unreachable here today (a member always
			// begins at `export`/`static`/`function`/`var`/`let`/`typealias`/`where`, so a method NAMED `end`
			// is never at this loop head), which is exactly why it must not be left resting on that: the one
			// place the "an `end` may be a NAME" rule lives is `closesBlockAt`, and a scan that spells the
			// test itself is the next reachable panic waiting for a member form to be added.
			if depth == 0 and self.closesBlockAt(self.pos) 'closesType'
				self.noteDeclarationCloser(self.pos, openingLabel: nameTok.value, bodyStart: bodyStart)
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closesType'

			// A NESTED (inner) typealias. Gated on depth 0 so a `typealias` inside a
			// method body is left to the outer walk. Read into `enclosingInnerAliases` (so the rest of the body's
			// bare references resolve while the sweep is still building the whole-program index) AND keyed
			// whole-program — a RANGED alias by `base.member` into `innerAliases`, a GENERIC-INSTANCE alias
			// (`Array with T`) under its base-qualified name into `genericAliases` (so `Container.ElementArray`
			// resolves the way a top-level `IntBox` does, and stays distinct from another type's `ElementArray`),
			// and — when the type is not generic and the member is not the type's own name — under its BARE
			// member too, which is the file-scope reading `publishNestedGenericAlias` carries the rule for.
			// Tolerant, like `readStructFieldInto`: a malformed nested alias is the real parse's to report, and
			// stopping here leaves the remaining tokens to the robust outer walk.
			if depth == 0 and self.atTypeAliasDeclaration() 'isInnerAlias'
				let nestedVisibility = try self.consumeOptionalVisibility() otherwise break
				let nestedNameTok = self.tokenAt(self.pos + 1)
				let nested = try self.readNestedTypeAlias(nestedVisibility, recordFunctionSignature: false, tupleOwner: TupleAliasOwner.enclosingType(self.enclosingTypeName())) otherwise break

				self.signatures.recordTypeBodyInnerAliasMember(joinQualifiedName(self.enclosingTypeName(), member: nestedNameTok.value))

				match nested 'nested'
					ranged(alias) then innerAliasOut.push(InnerAliasEntry.create(self.enclosingTypeName(), alias: self.nestedRangedAlias(alias)))
					genericInstance(entry) then self.publishNestedGenericAlias(entry, into: genericAliasOut)

					// A TUPLE alias is keyed whole-program by the reader itself, under the `<Type>.<member>` name
					// `TupleAliasOwner.enclosingType` just gave it — there is no per-declaration column for it to
					// land in, because it mints no identity of its own (see `NestedAliasResult`).
					tupleAlias then break

					// Into the FILE's function-alias array, the one a top-level `typealias Fn = function(…)`
					// lands in — under BOTH its bare name and `<Type>.<member>`, because a nested one declares
					// both scopes (see `publishNestedFunctionAlias`).
					functionAlias(alias) then self.publishNestedFunctionAlias(alias, keys: NestedAliasKeys.bareAndQualified, into: functionAliasOut)
				end 'nested'

				continue
			end 'isInnerAlias'

			// `where T is <Interface> …` at the type's top level — recorded on the swept
			// layout so `ProgramSignatures.recordStruct` hashes the constraints and the witness lowering /
			// E3017 read them off `structOf` (the sweep's layout is the whole-program one). Handled here in
			// the body loop rather than pre-consumed after `openTypeParamScope`, so it lands whether or not an
			// `implements` clause (which the loop tolerantly skips token-by-token) precedes it. Tolerant, like
			// `readStructFieldInto`: a malformed `where` is the real parse's to report.
			if depth == 0 and self.at(TokenKind.where) 'isWhere'
				let spelledBounds = RegionBoundArray.create(0)
				let constraints = try self.readWhereClause(self.enclosingTypeParams, owner: TypeWhereClauseOwner, admitsAssociatedBindings: true, bounds: spelledBounds) otherwise break
				layout.recordWhereConstraints(constraints)
				layout.recordRegionBounds(spelledBounds)

				if not headerDeferred and whereConstraintsBindAnything(constraints) 'theBindingsWaitForTheWholeProgram'
					conformanceSiteOut.push(ConformanceClauseDeclSite.create(self.job.path, tokenPos: declStart, declName: nameTok.value, declIsEnum: false))
					headerDeferred = true
				end 'theBindingsWaitForTheWholeProgram'

				continue
			end 'isWhere'

			// ⭐⭐ **`static let` — A TYPE-QUALIFIED TOP-LEVEL BINDING, swept exactly as a
			// file-scope one is.** It has to be recorded HERE and not by the caller's depth-0 gate for
			// `recordScannedType`'s own reason: this walk consumes the whole `type` declaration, so its members
			// are never offered to the outer loop — and the outer loop could not qualify the name in any case,
			// because only this walk knows which type encloses it.
			//
			// Gated on depth 0 like every other member arm, so a `static` token inside a METHOD BODY is left to
			// the token-by-token walk. `recordScannedBinding` is tolerant like every other reader on this walk:
			// a malformed declaration records nothing and the real parse reports it with a position.
			if depth == 0 and self.staticBindingKeywordAt(self.pos) 'isStaticBinding'
				// The `static` keyword's index is the anchor the visibility is read backwards from: `export
				// static let X` puts `static` where the modifier would otherwise be, exactly as it does for a
				// method (`declaredFunctionVisibility`). The cursor is then seated on the `let` itself,
				// which is where the shared binding reader begins.
				let modifierAnchor = pastVisibilityModifiers(self.tokens, index: self.pos)
				self.pos = modifierAnchor + 1
				self.recordScannedBinding(bindingOut, qualifier: self.enclosingType.clone(), modifierAnchor: modifierAnchor)
				continue
			end 'isStaticBinding'

			if depth == 0 and self.atStructFieldKeyword() 'isField'
				// Captured BEFORE the read so the field's own index is exact rather than derived from a
				// count that a failed read would leave standing still.
				let fieldIndex = layout.fieldCount()

				// A field the sweep cannot read leaves the layout SHORT, which would put every later
				// field at the wrong offset — so the scan stops rather than recording a layout it
				// knows is wrong. The real parse reports the malformed declaration properly.
				try self.readStructFieldInto(layout) otherwise break

				if layout.fieldCount() > fieldIndex 'aNewField'
					self.recordScannedFieldDefaultHelper(layout, index: fieldIndex, entries: entries)
				end 'aNewField'

				continue
			end 'isField'

			// A method DECLARATION, asked through the same `functionDeclarationAt` the outer sweep asks:
			// a closure literal in a method body spells `function` too, and counting it here overshoots
			// the type's `end` — the sweep then reads the NEXT declaration's members into THIS layout.
			if self.functionDeclarationAt(self.pos) 'isMethod'
				// The method opens a block closed by its own `end`. Counted BEFORE the signature is
				// read, because reading it moves the cursor past the `function` keyword — the caller's
				// loop does exactly this, for exactly this reason.
				depth = depth + 1
				self.advance()
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut, messageMethodNameOut: messageMethods)
				continue
			end 'isMethod'

			depth = self.blockDepthAfterCursor(depth)
			self.advance()
		end 'body'

		// Close the array-feed relation over self-call forwards once every method's parameter list
		// is scanned — marking a forwarder's parameter a feed so its OWN concrete call site consumes the managed
		// argument, exactly as the directly-pushing method's does. Runs before `closeTypeParamScope` so
		// `enclosingType`/`enclosingTypeParams` still name this type.
		self.recordTransitiveArrayFeeds(paramConsumes, bodyStart: bodyStart, feedStart: feedStart)

		// The roster is set WHOLESALE once every member has been read, on `recordTypeParams`' discipline: the
		// whole list is known at one moment, and a per-push write would leave a half-filled column standing on a
		// declaration the loop `break`s out of.
		layout.recordMessageMethods(messageMethods)

		structs.push(layout)
		self.closeTypeParamScope()
	end 'recordScannedType'

	// ⭐ **PUBLISH A FIELD DEFAULT'S SYNTHESIZED HELPER WHOLE-PROGRAM** — the field twin of
	// `recordScannedParamDefaults`' `entries.push`, and it is on this walk for that routine's exact reason:
	// the helper's RETURN TYPE is what the site that CALLS it needs to type the call it emits
	// (`mintCallResult`), and that site — `applyFieldDefaults`, inside a `Self{…}` — is reached by the real
	// parse long before the drain declares the helper's body. Only the sweep can answer ahead of it.
	//
	// It reads the LAST-READ field rather than being handed the facts, because `readStructFieldInto` is the
	// one shared field reader and must stay one: a second out-parameter on it would be a second place a
	// field's declared type is stated, and the layout it just wrote already holds every fact needed here.
	//
	// ⚠ **THE RETURN TYPE IS THE FIELD'S DECLARED TYPE AND THE SURFACE IS THE FIELD'S DECLARED
	// SPELLING**, both taken from that one write. That is what makes
	// `var buf = makeBuffer() as __ManagedMemory` hand its `Self{}` a value bearing the BUFFER's
	// member roster — hardcoded plain, the default would arrive wearing `Array`'s.
	//
	// ⚠ **THE TIER IS `file`, AND IT IS THE SAME `file` `parseDefaultHelper` STAMPS ON THE `IrFunction`** —
	// deliberately, because a helper's tier is asked of two different registries (this one through
	// `calleeVisibilityFrom`, the `IrFunction`'s through `SemanticCheck.calleeVisibleFrom`) and one
	// declaration must not answer two ways. It is TRUE rather than merely consistent: a struct literal may
	// only be written inside the type's own body, so every call is in the declaring file. Neither reader can
	// actually reach it — a minted callee is exempt from both — which is exactly why a disagreement here
	// would have gone unnoticed.
	function recordScannedFieldDefaultHelper(layout StructLayout, index FieldIndex, entries FuncReturnTypeEntryArray)
		match fieldDefaultFill(layout, index: index) 'declared'
			// A field with no default, and a LITERAL one, declare no function: the literal is emitted
			// straight into the box (`Parser.fillFieldDefault`) and there is nothing to call.
			none or
			literal then return
			callsHelper(helperName) then self.recordFieldDefaultHelperReturn(helperName, layout: layout, index: index, entries: entries)
		end 'declared'
	end 'recordScannedFieldDefaultHelper'

	// The entry both helper-shaped defaults declare. Its return type is the FIELD's declared type, which is
	// what binds an expression default by the ordinary `return` rules.
	function recordFieldDefaultHelperReturn(helperName immutable ByteArray, layout StructLayout, index FieldIndex, entries FuncReturnTypeEntryArray)
		entries.push(FuncReturnTypeEntry.create(helperName, returnType: MaxonReturnType.value(try layout.fieldTypes.get(index) otherwise panic("recordFieldDefaultHelperReturn: fieldTypes.get OOB at {index} for `type {String.from(layout.name)}`, whose field was just written by `readStructFieldInto`")), declaredSurface: layout.fieldDeclaredSurface(index), visibility: Visibility.unexported, enclosingTypeName: layout.name))
	end 'recordFieldDefaultHelperReturn'

	// ⭐ **CONSUME A WHOLE `interface` DECLARATION IN THE TOLERANT SWEEP** — the twin of
	// `recordScannedType`/`recordScannedEnum`, and it MUST walk the body itself for a sharp reason: an
	// interface method is a `function` SIGNATURE with NO body and NO `end`. Left to the sweep's outer loop,
	// each would trip the `function` arm — registering the method as a free function AND incrementing the
	// block-depth counter with no matching `end` to decrement it, corrupting the scan for the rest of the
	// file. So the whole declaration is consumed here and lands the cursor past the closing `end`. An
	// interface body opens no blocks, so the first `end` that is not a NAME closes it.
	//
	// ⭐⭐ **IT RECORDS WHERE THE DECLARATION IS, AND THAT IS ALL IT RECORDS.** A `type`'s layout and an
	// `interface`'s requirements are both read by files that may be parsed before the declaring one, so both
	// have to be whole-program — but they cannot be gathered the same way. A layout is id-free and can be built
	// the moment the sweep reads it; an interface REQUIREMENT is stored as a rendered SOURCE STRING, and one of
	// those spellings (`IrInterface.renderDeclaredTypeName`'s `genericInstance` arm) is a question only the
	// COMPLETE index can answer. Read here, `IntArray` would render as the raw alias name; read by the real
	// parse, as the canonical instance name — two spellings of one type, which is a false ACCEPT on the
	// conformance and a wrong formal at every witness dispatch.
	//
	// So the sweep contributes the ONE thing it uniquely has — the position, in a walk that already knows what
	// a top-level declaration is — and `Queries.foldInterfaceDeclarations` reads the declaration itself once
	// every file has folded. There is no per-header `uses`-arity read: the arity is
	// `associatedTypeNames.count()` on the declaration that pass records, and two sources of one fact would
	// be a second place to drift.
	//
	// ⚠⚠ **AND "NOT A NAME" IS THE WHOLE OF IT — asked through `closesBlockAt`, never `TokenKind.end`.**
	// A REQUIREMENT's name is a declared name (`parseInterfaceMethod` reads it with `consumeNameToken`), so
	// `function end() returns Integer` is a legal interface method — and a raw `end` test would stop the walk ON
	// THAT NAME, returning with the cursor mid-signature. The remaining signatures then fall to the sweep's
	// outer loop, which is exactly the corruption the paragraph above describes: each trips the `function`
	// arm and leaves `depth` one too deep, so every `depth == 0` gate — `type`, `enum`, `interface` — stop
	// firing for the REST OF THE FILE. MEASURED on an interface declaring `end()` plus two more requirements
	// ahead of a `type Cell`: **`panic: requireConstructible: type Cell is being parsed right now, but the
	// declaration sweep never recorded it`**. (With exactly ONE trailing requirement the stray `function`'s
	// +1 happened to cancel the interface's own `end`, so the file compiled — an accident of arithmetic, and
	// the reason this needed a THIRD requirement to show itself.) A keyword-named PARAMETER inside a
	// requirement (`function scale(end Integer)`) is covered by the same call, through
	// `keywordIsAName`'s declaration-name index.
	function recordScannedInterface(sites InterfaceDeclSiteArray)
		// The site is the cursor BEFORE the keyword is consumed, because that is where the reader has to be
		// put back down: `readInterfaceDeclaration` opens by consuming `interface`, exactly as the real parse
		// reaches it.
		// The NAME travels with the site (see `InterfaceDeclSite.name`) — read off the token after
		// the keyword, which is the same one `readInterfaceDeclaration` consumes. A malformed header carries
		// the empty name and records nothing the contest can act on, which is the tolerance every sweep entry
		// point keeps: the real parse reports it, with a position.
		sites.push(InterfaceDeclSite.create(self.job.path, tokenPos: self.pos, name: self.interfaceNameAt(self.pos + 1), visibility: self.visibilityBefore(self.pos)))

		try self.consume(TokenKind.interface) otherwise return

		while not self.isEof() 'body'
			if self.closesBlockAt(self.pos) 'closes'
				self.advance()
				self.skipOptionalLabel()
				return
			end 'closes'

			self.advance()
		end 'body'
	end 'recordScannedInterface'

	// ⭐⭐ **READ THE `interface` DECLARATION AT `tokenPos` INTO THE WHOLE-PROGRAM INDEX.** The second half
	// of `recordScannedInterface`, driven by `Queries.foldInterfaceDeclarations` once every file has folded —
	// which is the whole point of the split (see `recordScannedInterface`, and `InterfaceDeclSite`).
	//
	// It runs the parser's OWN `readInterfaceDeclaration`, the same function `parseInterfaceDeclaration` calls,
	// so there is exactly ONE builder of an `IrInterface` and the swept declaration cannot drift from the
	// parsed one — the discipline `recordScannedType` keeps with `readTypeHeader`, applied where the drift
	// would be silent rather than loud.
	//
	// TOLERANT, exactly as every other sweep entry point is: a declaration this cannot read records NOTHING and
	// leaves the positioned diagnostic to the real parse, which reaches the same tokens moments later and
	// refuses the program. What such an interface costs meanwhile is one unresolvable `with`-arity default and
	// one "not declared" reject at a dispatch — both on a build that is already failing.
	export function foldInterfaceDeclarationInto(index ProgramSignatures, tokenPos ElementIndex, visibility Visibility)
		self.collectsWithSites = true
		self.pos = tokenPos
		let iface = try self.readInterfaceDeclaration(false) otherwise 'malformed'
			self.clearPendingRequirementParam()
			self.drainGenericWithSitesInto(index)
			return
		end 'malformed'

		// The reader may have NOTED an interface-typed requirement parameter. The fold does not refuse — the
		// real parse does, with a position — so the note is dropped rather than carried into the next
		// declaration this same reader folds.
		self.clearPendingRequirementParam()
		let interfaceName = iface.name
		index.recordInterfaceDeclaration(iface, visibility: visibility)

		// ⭐ **AND THE BODY'S GENERIC-INSTANCE TYPEALIASES** — drained HERE and nowhere else, because
		// this is the one read of an interface that is allowed to write whole-program state. The reader's
		// own interner is handed over with them: their right-hand sides carry `MaxonType`s minted against
		// it, which only the index can remap into its own (`recordInterfaceAliases`).
		index.recordInterfaceAliases(self.interfaceAliasScratch, interfaceName: interfaceName, fileTypeNames: self.artifact.typeNames)
		self.drainGenericWithSitesInto(index)
	end 'foldInterfaceDeclarationInto'

	// ⭐⭐ **RE-READ THE `implements` CLAUSE OF THE DECLARATION AT `site.tokenPos`, NOW THAT THE ARITY THAT
	// ENDS A `with` IS KNOWN.** The second half of the note `recordScannedType` /`recordScannedEnum`
	// leave behind, driven by `Queries.foldConformanceClauses` — `foldInterfaceDeclarationInto`'s shape, one
	// declaration kind over, and for the sharper version of its reason: there the risk was two spellings of
	// one type, here it is a conformance that is not recorded at all, so the extensions of the interface
	// named after the `with` land on nobody.
	//
	// It runs the SAME `readOptionalImplementsClause` the sweep ran, so there is exactly one reader of this
	// grammar and the two passes cannot drift on what a clause SAYS — only on how much of it they can prove.
	// See that reader for the arity rule that makes one pass stop where the other continues.
	//
	// It re-reads a type's `where` clause too: a constraint's `with` bindings are settled identities only once
	// every file has folded (`declaredRequirementType`).
	//
	// ⚠ **A CLAUSE THIS CANNOT READ LEAVES THE SWEEP'S RECORD STANDING**, which is the one shape of tolerance
	// that fits here: the sweep's answer is a SUBSET of the clause, and `declaringNothing()` would be a WRONG
	// one. Nothing is closed on that path either — `enterTypeScope` assigns every per-declaration scope
	// unconditionally, so the next site cannot observe the failed one (`Queries.foldInterfaceDeclarations`
	// states the argument for the reader this pass shares with it).
	export function foldConformanceClauseInto(index ProgramSignatures, site ConformanceClauseDeclSite)
		self.pos = site.tokenPos

		// The declaration keyword the sweep stood on — `type`, `enum` or `union` — and the name after it.
		// Stepped over rather than read through `readTypeHeader`, which asserts the `type` keyword: one reader
		// serves both declaration kinds here, and WHICH keyword opened the declaration is a fact the re-read
		// has no use for. `declIsEnum` already carries the only distinction that matters, which registry the
		// answer is written to.
		self.advance()
		let nameTok = try self.consume(TokenKind.identifier) otherwise return
		self.enterTypeScope(nameTok.value, isEnum: site.declIsEnum)

		// ⚠ **THE `uses` CLAUSE IS RE-READ FOR ITS SCOPE ALONE, ONTO NO LAYOUT** — see `openTypeParamNames`,
		// which exists for this caller. A `with` argument is rendered against the declaration's own parameter
		// names (`type Box uses T implements Holder with T` binds `Element := T`), so the scope has to be
		// re-entered; the layout it would otherwise be stamped onto may belong to another declaration of the
		// same name, and that guard belongs in one place.
		_ = self.openTypeParamNames()

		self.openConformanceClauseAliasScope()
		let clause = try self.readOptionalImplementsClause() otherwise return
		self.closeConformanceClauseAliasScope()
		index.refoldConformanceClause(site, clause: clause)

		if site.declIsEnum or not self.at(TokenKind.where) 'noWhereClause'
			return
		end 'noWhereClause'

		let spelledBounds = RegionBoundArray.create(0)
		let constraints = try self.readWhereClause(self.enclosingTypeParams, owner: TypeWhereClauseOwner, admitsAssociatedBindings: true, bounds: spelledBounds) otherwise return
		index.refoldWhereConstraints(site, constraints: constraints)
	end 'foldConformanceClauseInto'

	// ⭐ **CONSUME A WHOLE `extension <Interface>` DECLARATION IN THE TOLERANT SWEEP** — the twin of
	// `recordScannedInterface`, recording a POSITION and nothing else for a reason that is stronger here than
	// there: an extension's methods are declared on the CONFORMERS of its interface, and a conformer may be
	// declared in a file this sweep has not reached. See `ExtensionDeclSite`.
	//
	// It walks the body itself and MUST: an extension member is a full method with its own `end`, so the
	// caller's loop would register each under its BARE name as a free function (see the arm that calls this).
	// The depth counter is `recordScannedType`'s — a named `function` opens a block the caller does not count,
	// `blockDepthAfter` counts the rest — and the terminator is asked through `closesBlockAt`, never a raw
	// `TokenKind.end`, because a method may be NAMED `end`.
	function recordScannedExtension(sites ExtensionDeclSiteArray)
		// The site is the cursor BEFORE the keyword is consumed, because that is where the two later passes
		// have to be put back down: both open by consuming `extension`, exactly as the real parse reaches it.
		// The TARGET does not travel with it — each pass reads the header for itself through the one reader
		// (`readExtensionHeader`); see `ExtensionDeclSite` for why a copy taken
		// here could not see a primitive keyword.
		sites.push(ExtensionDeclSite.create(self.job.path, tokenPos: self.pos))

		try self.consume(TokenKind.extension) otherwise return
		self.skipPastBlockEnd()
	end 'recordScannedExtension'

	// ⭐ **LAND THE CURSOR ON THE `end` THAT CLOSES THE BLOCK IT IS CURRENTLY INSIDE** — entered anywhere
	// within exactly one open block. `skipPastBlockEnd` below lands past that `end` and its optional label.
	//
	// FOUR walks need it and they must agree to the token, because they are four answers to "where does this
	// construct stop?": the tolerant sweep steps over a whole `extension`, the whole-program fold steps over
	// each of its METHOD BODIES after taking that method's signature, the fold's driver and the REAL parse
	// step over the whole declaration again after publishing / emitting each conformer's. A second spelling of
	// the extent is a resume point one token off, which reads the next declaration into this one.
	//
	// The depth counter is `recordScannedType`'s: a NAMED `function` opens a block `blockDepthAfter` does not
	// count (it knows `if`/`while`/`match`), a closure literal is `function(` with no name and no `end`, and a
	// closer is asked through `closesBlockAt` — never a raw `TokenKind.end` — because a method may be NAMED
	// `end`. An `extension` keyword is the block opener for its callers' purposes, so they enter with the
	// cursor just past it; the interface name after it is an identifier, which opens and closes nothing.
	//
	// The cursor stops ON the outermost block's `end`, so the real parse can judge the label behind it
	// (`consumeBlockEnd`); the tolerant walks step over both through `skipPastBlockEnd`.
	function advanceToOutermostBlockEnd()
		var depth = 1 as BlockDepth

		while not self.isEof() 'walk'
			if self.functionDeclarationAt(self.pos) 'opensAMethod'
				depth = depth + 1
				self.advance()
				continue
			end 'opensAMethod'

			if depth == 1 and self.closesBlockAt(self.pos) 'closesTheOutermost'
				return
			end 'closesTheOutermost'

			depth = self.blockDepthAfterCursor(depth)
			self.advance()
		end 'walk'
	end 'advanceToOutermostBlockEnd'

	function skipPastBlockEnd()
		self.advanceToOutermostBlockEnd()
		self.advance()
		self.skipOptionalLabel()
	end 'skipPastBlockEnd'

	// ⭐⭐ **WHICH NESTED `typealias` MEMBERS THIS EXTENSION BODY DECLARES, PUBLISHED ONTO EVERY
	// CONFORMER.** The first of the two passes `Queries.foldExtensionDeclarations` makes over the same
	// sites, and it exists because the second one RESOLVES type names while it fills the alias
	// registries: several files write `export extension Array`,
	// `stdlib/helpers/sort/insertionSort.maxon` declares `SortComparator` and the others spell it
	// bare, so whichever body the fold reached first would resolve that name differently from the ones
	// it reached later — a written name meaning what the directory walk says, which `StdlibLoader`'s
	// header rules out.
	//
	// ⚠ **IT READS THE HEADER RATHER THAN CARRYING THE CONFORMERS ON THE SITE**, because the conformer list is
	// `extensionTargetConformers`' and both later passes take it from there (`foldExtensionDeclarationInto`'s
	// own ⚠ says why the three must share one answer). A second copy travelling on the site would be that list
	// derived twice, and it could not be derived at the SWEEP in any case: an interface extension's conformers
	// are not known until every file has folded.
	//
	// TOLERANT, exactly as every other sweep entry point: a header it cannot read publishes nothing and leaves
	// the positioned diagnostic to the real parse.
	export function publishExtensionInnerAliases(index ProgramSignatures, site ExtensionDeclSite)
		self.pos = site.tokenPos
		let header = try self.readExtensionHeader() otherwise return

		self.scanBodyNestedAliases()
		let siteIsTheLibrarys = index.declaredByTheCorpus(self.job.path)

		let members = self.scannedPerInstanceAliases.declared()
		let functionMembers = self.scannedFunctionAliases.declared()
		self.clearBodyAliasScan()

		if members.isEmpty() and functionMembers.isEmpty() 'declaresNone'
			return
		end 'declaresNone'

		// ⚠ Published for EVERY conformer, including one a CONDITIONAL extension withholds its methods from.
		// That is deliberate and it is the one place this pass may not follow `foldExtensionDeclarationInto`'s
		// withheld rule: the verdict is what decides whether these declarations are that conformer's, and it is
		// taken per (extension, conformer) by the fold — which is the pass that then declines to publish them.
		// A set that had already applied the verdict would be answering a question this pass cannot yet ask,
		// and the cost of not applying it is bounded: `declaresInnerAlias` reports a name whose declaration the
		// fold withheld, in a body that receives no methods and emits nothing.
		for conformer in extensionTargetConformers(header.target) 'eachConformer'
			for member in members 'eachMember'
				let qualified = joinQualifiedName(conformer, member: member)
				index.recordExtensionInnerAliasMember(qualified)
				index.noteExtensionInnerAliasTier(qualified, library: siteIsTheLibrarys)
			end 'eachMember'

			for member in functionMembers 'eachFunctionMember'
				index.noteExtensionInnerAliasTier(joinQualifiedName(conformer, member: member), library: siteIsTheLibrarys)
			end 'eachFunctionMember'
		end 'eachConformer'
	end 'publishExtensionInnerAliases'

	export function foldExtensionConformanceInto(index ProgramSignatures, site ExtensionDeclSite)
		self.pos = site.tokenPos

		try self.consume(TokenKind.extension) otherwise return
		let nameTok = try self.consumeExtensionTargetName() otherwise return
		try index.typeExtensionTargetOf(nameTok.value) otherwise return
		let interfaces = try self.readImplementsList(ConformanceOwner.unchecked) otherwise return

		// A conditional conformance holds only for the conformers its clause admits, which the real parse
		// decides per conformer; filed here it would be declared for all of them.
		if self.at(TokenKind.where) 'aConditionalConformance'
			return
		end 'aConditionalConformance'

		index.recordConformancesOfATypeExtension(nameTok.value, declares: interfaces)
	end 'foldExtensionConformanceInto'

	// ⭐⭐ **PUBLISH THE `extension` AT `tokenPos` ONTO EVERY CONFORMER, IN THE WHOLE-PROGRAM INDEX.** The
	// second half of `recordScannedExtension`, driven by `Queries.foldExtensionDeclarations` once every file
	// has folded — which is the whole point of the split.
	//
	// ⭐ **IT IS THE SAME `recordScannedSignature` A `type`'s OWN METHOD GOES THROUGH, RUN ONCE PER
	// CONFORMER WITH `enclosingType` SET TO THAT CONFORMER.** So `function count() returns Integer` inside
	// `extension Countable` publishes exactly what `function count() returns Integer` written inside
	// `type IntList` would have published, under exactly the name `declaredMethodName` gives it —
	// `IntList.count`. Nothing downstream learns that extensions exist: a call site types `list.count()`
	// through the ordinary method door.
	//
	// ⚠ **THE CONFORMER LIST AND ITS ORDER ARE `conformersOf`'s, AND THE REAL PARSE WALKS THE IDENTICAL ONE.**
	// A signature published here with no body emitted there — or the reverse — is a link failure at best and
	// a call typed against the wrong declaration at worst, so the two halves share one answer rather than each
	// deriving "which types conform".
	//
	// TOLERANT, exactly as every other sweep entry point: a member it cannot read publishes nothing and
	// leaves the positioned diagnostic to the real parse, which reaches the same tokens moments later.
	export function foldExtensionDeclarationInto(index ProgramSignatures, site ExtensionDeclSite)
		let entries = FuncReturnTypeEntryArray.create(0)
		let paramConsumes = ParamConsumeEntryArray.create(0)
		let paramReassigns = ParamReassignEntryArray.create(0)
		let globalAliasReturns = GlobalAliasReturnEntryArray.create(0)
		let paramDefaults = ParamDefaultEntryArray.create(0)
		let throwsEntries = ThrowsClauseEntryArray.create(0)

		// ⭐ Per-function DIVERGENCE — recorded from the SAME token walk. One entry per function whose body
		// PROVABLY cannot return, so a bare call to it can be told that it ends its caller's block.
		let bodyFacts = SweptBodyFactEntryArray.create(0)
		let methodInnerAliasParamOut = MethodInnerAliasParamEntryArray.create(0)

		// ⭐⭐ **AN EXTENSION BODY'S NESTED TYPEALIASES, KEYED WHOLE-PROGRAM UNDER EACH CONFORMER.** They
		// must be, and the two things that follow otherwise are both real: a `typealias` member would END this walk, so
		// every method declared after one would publish no signature at all; and a generic-instance alias would reach
		// the real parse's `enclosingInnerAliases` without reaching `genericAliases`, so `ElementArray\{\}`
		// inside `stdlib/Interfaces.maxon`'s `extension Iterable` would be refused as "never keyed whole-program".
		// The keying is per CONFORMER and that is the whole of why it works: the interface's associated types
		// are substituted by this conformer's `with` bindings (`openExtensionBodyScope`), so `IntSeq`'s
		// `ElementArray` interns `Array with Integer` while another conformer's interns its own — the same
		// `<Type>.<member>` key a nested alias of a `type` body takes (`recordScannedType`).
		let innerAliasOut = InnerAliasEntryArray.create(0)
		let genericAliasOut = GenericAliasEntryArray.create(0)
		let functionAliasOut = FunctionTypeAliasArray.create(0)

		// An extension member is always a METHOD or a nested typealias (`enclosingType` is the conformer), so
		// nothing is ever pushed here — but `recordScannedSignature` writes through the parameter, and passing
		// a shared empty to a routine that MAY push is how a shared empty stops being empty.
		let freeFunctionNameOut = NameRoster.create(0)

		// ⭐ **AN EXTENSION BODY IS A FIXED-ELEMENT-COUNT SITE TOO, AND ITS ABSENCE IS A COMPILER ABORT.**
		// One per (extension body, SIZED CONTAINER conformer): the methods published here belong to that
		// conformer, so they sit in the same fixpoint — under the same `Type.method` keys — as the methods of
		// its own body. Any other conformer contributes none, for `recordScannedType`'s reason.
		let descriptorScanSiteOut = DescriptorScanSiteArray.create(0)

		self.pos = site.tokenPos

		// It cannot fail — the site was recorded AT this keyword — but the sweep's discipline is that a read it
		// cannot make publishes nothing rather than throwing.
		let header = try self.readExtensionHeader() otherwise return

		// Where each conformer's pass restarts — read ONCE, exactly as `parseExtensionDeclaration` does it, so
		// the header is not re-parsed per conformer and the two passes agree about where a body begins.
		let bodyStart = self.pos
		self.scanBodyNestedAliases()
		let functionAliasesOfTheBody = self.scannedFunctionAliases

		// Either read alone loses arity errors: the conformer loop's publish gates skip aliases and it
		// may run zero times, and this read fails an alias that resolves only in a conformer (`Self`).
		self.noteExtensionBodyGenericSpellings(header, bodyStart: bodyStart, members: self.scannedPerInstanceAliases.declared(), functionAliases: functionAliasesOfTheBody, index: index)

		// The whole `where` clause, rendered ONCE per declaration rather than per withheld method: it is a
		// property of the extension, and every skip this fold files quotes the same sentence.
		let clause = renderWhereConstraints(header.constraints, paramNames: extensionTargetParamNames(header.target))
		self.collectsWithSites = true

		for conformer in extensionTargetConformers(header.target) 'eachConformer'
			self.pos = bodyStart
			self.enterTypeScopeOf(conformer)
			self.scannedFunctionAliases = functionAliasesOfTheBody
			self.openExtensionBodyScope(header, conformer: conformer, index: index, pass: ExtensionBodyPass.sweep)

			// ⭐⭐ **THE CONFORMANCE THIS EXTENSION DECLARES IS FILED WHOLE-PROGRAM HERE, *BEFORE* THE VERDICT,
			// AND THE POSITION IS THE OPPOSITE OF `parseExtensionDeclaration`'s ON PURPOSE.**
			// There the record is the program's own answer to *"does this conformer implement this?"*, so it
			// must sit past the clause. This one exists for a SUPPRESSION
			// (`ProgramSignatures.instantiationViolatesItsOwnWhereClause`), which is sound only while its index
			// is a SUPERSET of the merged one the E3017 report reads — so an over-grant here can only withhold
			// a suppression and restore a loud over-refusal, where an under-grant is a silent accept. Filing
			// unconditionally is the direction that cannot fail quietly; see
			// `ProgramSignatures.extensionDeclaredConformances`.
			index.recordExtensionDeclaredConformances(conformer, declares: header.interfaces)

			// ⭐ **THE CONDITIONAL FILTER, TAKEN ONCE PER CONFORMER.** An INTERFACE extension's `where` clause
			// is checked against what this conformer binds the interface's associated types to; a TYPE
			// extension's is not checkable here at all (the parameters are bound per INSTANTIATION) and becomes
			// witness constraints instead — see `ExtensionTarget`. Both answers are pure functions of the
			// whole-program index, which is what lets `parseExtensionDeclaration` take the identical one.
			let verdict = self.extensionConformerVerdict(header, conformer: conformer, index: index)

			// ⭐⭐ **A WITHHELD CONFORMER GETS NO SITE, AND THAT GATE IS THE VERDICT'S — NOT A SECOND
			// RULE.** A CONDITIONAL extension the conformer does not satisfy publishes it no
			// methods at all: the fold files a `ConditionalExtensionSkip` instead of a signature, and the real
			// parse skips the conformer whole. Scanned anyway, this body files `<Conformer>.<method>` seeds for
			// methods that do not exist on that conformer — merged into a real method that already wears the
			// name, because the fixpoint's columns are keyed by that name alone.
			// It cannot be caught as a duplicate declaration either: a withheld method publishes no signature,
			// so E3006 never sees two.
			//
			// ⚠ The site is recorded HERE rather than beside `openExtensionBodyScope` for exactly that reason —
			// the verdict is what says whether these methods are this conformer's, and a site taken before it
			// is a scan of a body that was never this type's.
			if not extensionMethodsWithheld(verdict) and index.isFixedArrayBaseName(conformer) 'aGenericConformerThatKeepsThem'
				descriptorScanSiteOut.push(DescriptorScanSite.create(self.job.path, bodyStart: bodyStart, typeName: conformer))
			end 'aGenericConformerThatKeepsThem'

			while not self.isEof() 'members'
				self.skipNewlines()

				if self.closesBlockAt(self.pos) 'closesExtension'
					break
				end 'closesExtension'

				// The member header is read through the readers the real parse uses —
				// `consumeOptionalVisibility` and
				// `extensionMemberTakesReceiverAt` — so the sweep and the real parse cannot disagree about
				// which member takes a receiver. A member neither understands ends the scan for this conformer
				// rather than being stepped over: half a signature set is worse than none, and the real parse
				// refuses the declaration with a position.
				let memberVisibility = try self.consumeOptionalVisibility() otherwise break

				// A NESTED TYPEALIAS, read exactly as `recordScannedType` reads one and keyed under the SAME
				// `<Type>.<member>` name — the conformer's, because that is `enclosingType` here. It is read
				// BEFORE the `static` test because a nested alias takes no `static` (the real parse refuses one
				// that does), and continuing rather than breaking is what lets the methods below it publish.
				// Tolerant like every other read on this walk: a malformed alias publishes nothing and leaves the
				// positioned diagnostic to the real parse.
				if self.atTypeAliasDeclaration() 'nestedTypeAlias'
					// ⚠ **THE TUPLE FORM'S KEY IS DECIDED BY THE VERDICT, BEFORE THE READ, AND IT MUST BE** — the
					// `unpublished` owner is the "READ ALWAYS, PUBLISH ONLY WHEN THE EXTENSION IS THIS CONFORMER'S"
					// rule below, applied to the one alias form the READER publishes rather than the caller
					// (see `TupleAliasOwner`). Every other form is filed after the withheld test; this one cannot be.
					let nestedNameTok = self.tokenAt(self.pos + 1)

					// Published nowhere when the conformer's body declares the member: the real parse reads the
					// same verdict (`extensionAliasYieldsToTheTypesOwn`). A published copy would make the
					// extension's own signatures mean its alias while callers of the conformer see the
					// conformer's.
					let nestedIsTheTypesOwn = index.typeBodyDeclaresInnerAlias(joinQualifiedName(conformer, member: nestedNameTok.value))
					let nestedTupleOwner = TupleAliasOwner.unpublished if extensionMethodsWithheld(verdict) or nestedIsTheTypesOwn else TupleAliasOwner.enclosingType(conformer)
					self.extensionAssociated.heldUses.clear()
					let nested = try self.readNestedTypeAlias(memberVisibility, recordFunctionSignature: false, tupleOwner: nestedTupleOwner) otherwise break

					// ⚠ **READ ALWAYS, PUBLISH ONLY WHEN THE EXTENSION IS THIS CONFORMER'S** — the withheld
					// method rule applied to a declaration instead of a signature, and for its reason. The READ
					// must run whatever the verdict is, or the cursor lands somewhere a published one would not;
					// the PUBLISH must not, because a CONDITIONAL extension withheld from this conformer gives it
					// no members, and keying `Box.TagArray` anyway would make the extension's private vocabulary
					// nameable on a type that receives none of its methods (`parseTypeReference`'s inner-alias arm
					// resolves that spelling). The real parse skips the conformer whole, so nothing here would
					// have been looked up — which is precisely why it must not be published.
					if extensionMethodsWithheld(verdict) or nestedIsTheTypesOwn 'notThisConformers'
						continue
					end 'notThisConformers'

					if not self.job.isStdlibSource 'anAuthorsMember'
						let nestedQualified = joinQualifiedName(conformer, member: nestedNameTok.value)
						let nestedSite = self.extensionInnerAliasSiteAt(nestedNameTok)
						index.recordExtensionInnerAliasKeeper(nestedQualified, site: nestedSite)

						let keeper = try index.extensionInnerAliasKeeper(nestedQualified) otherwise panic("Parser.foldExtensionDeclarationInto: '{String.from(nestedQualified)}' has no keeper right after one was recorded for it")

						if nestedSite.compare(keeper) != Ordering.equalTo 'aRefusedDuplicate'
							continue
						end 'aRefusedDuplicate'
					end 'anAuthorsMember'

					for use in self.extensionAssociated.heldUses 'eachHeldUse'
						index.noteExtensionHeldArgument(conformer, interfaceName: header.nameTok.value, associatedPosition: use.associatedPosition, held: use.held)
					end 'eachHeldUse'

					match nested 'nested'
						ranged(alias) then innerAliasOut.push(InnerAliasEntry.create(self.enclosingTypeName(), alias: self.nestedRangedAlias(alias)))
						genericInstance(entry) then genericAliasOut.push(self.qualifiedInnerGenericAlias(entry))

						// Already keyed (or deliberately not) by the reader, off `nestedTupleOwner` above.
						tupleAlias then break

						// ⭐⭐ **AND THE FUNCTION FORM IS PER-CONFORMER TOO — IT IS THE READING INSIDE THE BODY THAT
						// IS, WHICH IS WHY IT TAKES A SECOND KEY RATHER THAN A DIFFERENT ONE.** `ElementTransform` is
						// `function(Byte) returns Byte` in `ByteView`'s fold and `function(Character) returns Character` in `String`'s,
						// so one key cannot hold both and `map`'s own body would stop type-checking once a third element type
						// joins them. Filed under BOTH names by `publishNestedFunctionAlias`: the bare one keeps
						// the file-scope reading a top-level `typealias Fn = function(…)` has, and the
						// `<conformer>.<member>` one is what the body resolves — the same `<Type>.<member>` key
						// the three per-instance forms above take, for the same reason.
						functionAlias(alias) then self.publishNestedFunctionAlias(alias, keys: self.nestedAliasKeys(self.extendedInterfaceName(header)), into: functionAliasOut)
					end 'nested'

					continue
				end 'nestedTypeAlias'

				let memberTakesReceiver = self.extensionMemberTakesReceiverAt(self.pos)

				if not memberTakesReceiver 'staticMember'
					self.advance()
				end 'staticMember'

				if not self.functionDeclarationAt(self.pos) 'notAMethod'
					break
				end 'notAMethod'

				self.advance()
				let methodName = self.current().value

				// Which witness parameters this method will carry, filed in the same act that publishes its
				// signature — see `ProgramSignatures.witnessConstraintsOfMethod`. Above the verdict because a
				// TYPE extension's methods are never withheld (its clause is not a filter), so this is not on
				// the withheld path at all.
				self.noteTypeExtensionWitnessConstraints(index, header: header, conformer: conformer, methodName: methodName)

				// A withheld method is still read, into arrays that are thrown away: the cursor must land where
				// a published one leaves it, and only the same reader guarantees that.
				//
				// The conformer's own member of the same kind shadows the extension's (see
				// `conformerDeclaresOwnMethod`), and the decision is taken here and recorded for the real
				// parse. A method is declared once per type, so an interface extension's member and a conformer's
				// own of one name would claim one symbol; without the shadow that is E3006, after the extension's
				// signature has already overwritten the type's in the index. The cost: a conformer's own member
				// hides the interface extension's of that name on that type. A TYPE extension's shadowed member is
				// recorded the same way and refused by the real parse as a duplicate (`parseExtensionDeclaration`).
				let qualifiedMethodName = qualifiedMethodName(conformer, methodName: methodName)
				let shadowed = index.conformerDeclaresOwnMethod(qualifiedMethodName, takesReceiver: memberTakesReceiver)

				if shadowed 'theConformerDeclaresItsOwn'
					index.noteExtensionShadowedMethod(qualifiedMethodName, takesReceiver: memberTakesReceiver)
				end 'theConformerDeclaresItsOwn'

				match verdict 'verdict'
					satisfied then self.publishOrShadowExtensionMethod(index, header: header, conformer: conformer, shadowed: shadowed, qualifiedMethodName: qualifiedMethodName, takesReceiver: memberTakesReceiver, entries: entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut)
					unmet(unmetInterfaceName, bindingName) then self.foldWithheldExtensionMethod(index, conformer: conformer, methodName: methodName, clause: clause, unmetInterfaceName: unmetInterfaceName, bindingName: bindingName, shadowed: shadowed)
				end 'verdict'

				// `recordScannedSignature` leaves the cursor at the method BODY's first token, i.e. inside the
				// one block the method's own `end` closes — exactly this walk's entry condition.
				self.skipPastBlockEnd()
			end 'members'

			self.closeTypeParamScope()
		end 'eachConformer'

		self.clearBodyAliasScan()
		self.publishPendingBareAliases(functionAliasOut)
		self.drainGenericWithSitesInto(index)

		// Folded through `ProgramSignatures.foldFile` — the SAME door a file's own declarations go through, so
		// there is one place that decides what a scanned signature means. Everything an extension does not
		// contribute is passed empty; the type-name interner is this reader's own artifact's, exactly as the
		// per-file sweep passes its own.
		index.foldFile(entries, aliases: RangedTypeAliasArray.create(0), implementsClauses: AliasImplementsClauseArray.create(0), functionAliases: functionAliasOut, structs: StructLayoutArray.create(0), enums: EnumLayoutArray.create(0), genericAliasEntries: genericAliasOut, innerAliasEntries: innerAliasOut, methodInnerAliasParamEntries: methodInnerAliasParamOut, interfaceSites: InterfaceDeclSiteArray.create(0), extensionSites: ExtensionDeclSiteArray.create(0), conformanceSites: ConformanceClauseDeclSiteArray.create(0), scanSites: descriptorScanSiteOut, bindings: TopLevelDeclArray.create(0), paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, freeFunctionNames: freeFunctionNameOut, testDecls: DiscoveredTestArray.create(0), moduleDirectory: index.moduleDirectoryOf(self.job.path), filePath: self.job.path, fileStream: DeclTokenStream.create(PreparedTokens.create(self.tokens, respelledStarts: self.respelledStarts), job: self.job), fileTypeNames: self.artifact.typeNames, isStdlibSource: self.job.isStdlibSource)
	end 'foldExtensionDeclarationInto'

	function noteExtensionBodyGenericSpellings(header ExtensionHeader, bodyStart ElementIndex, members NameRoster, functionAliases ScannedAliasNames, index ProgramSignatures)
		self.enterTypeScope(header.nameTok.value, isEnum: false)
		self.scannedFunctionAliases = functionAliases

		let associated = extensionTargetParamNames(header.target)

		if associated.count() != 0 'hasAssociatedTypes'
			self.enclosingTypeParams = associated
		end 'hasAssociatedTypes'

		for member in members 'eachMember'
			self.recordInnerAliasName(member)
		end 'eachMember'

		self.pos = bodyStart
		self.collectsWithSites = true
		var depth = 1 as BlockDepth

		while not self.isEof() 'walk'
			if self.functionDeclarationAt(self.pos) 'opensAMethod'
				depth = depth + 1
				self.advance()
				continue
			end 'opensAMethod'

			if depth == 1 and self.atTypeAliasDeclaration() 'aNestedAlias'
				try self.readExtensionNestedAliasForSpellings() otherwise 'unreadable'
					self.advance()
					continue
				end 'unreadable'

				continue
			end 'aNestedAlias'

			let closes = self.closesBlockAt(self.pos)
			depth = self.blockDepthAfterCursor(depth)
			self.advance()

			if closes and depth == 0 'closesTheDeclaration'
				break
			end 'closesTheDeclaration'
		end 'walk'

		self.closeTypeParamScope()
		self.drainGenericWithSitesInto(index)
	end 'noteExtensionBodyGenericSpellings'

	function readExtensionNestedAliasForSpellings() throws SourceParseError
		let visibility = try self.consumeOptionalVisibility()
		_ = try self.readNestedTypeAlias(visibility, recordFunctionSignature: false, tupleOwner: TupleAliasOwner.unpublished)
	end 'readExtensionNestedAliasForSpellings'

	function consumeExtensionTargetName() returns Token throws SourceParseError
		if self.dottedChainLengthAt(self.pos) > 0 'aQualifiedName'
			return try self.consumeQualifiedTypeName()
		end 'aQualifiedName'

		return try self.consumeTypeBaseToken()
	end 'consumeExtensionTargetName'

	// ⭐⭐ **`extension <Name> [where <constraints>]` — THE ONE READER OF THE HEADER, for the three passes that
	// meet it** (conditional extensions). The cursor enters on `extension` and lands on the body's first
	// token. Every fact the two later passes disagree about at their peril comes out of here: WHICH types get
	// the methods, under WHAT condition, and the NAME token a malformed clause is blamed on.
	//
	// ⚠ **THE `where` CLAUSE'S PARAMETER NAMES ARE THE TARGET'S, AND THE SCOPE IS OPENED AROUND THE CLAUSE
	// READ AND CLOSED AGAIN AT ITS END.** `readWhereClause` resolves each constrained name to a POSITION in
	// `enclosingTypeParams` and refuses a name that is not in it — which is exactly the check wanted here,
	// provided the list it checks against is the extended declaration's (an interface's associated types, a
	// type's `uses` list) and not whatever declaration the file was last inside. That is why the assignment is
	// here and not at the call sites: a caller that forgot it would not fail, it would resolve `Element`
	// against a stale list.
	//
	// ⛔⛔ **AND IT IS CLOSED AGAIN BECAUSE THIS IS THE ONE WRITER OF THAT FIELD THAT DOES NOT ALSO WRITE
	// `enclosingType`, AND THE TWO ARE READ AS A PAIR.** `parseTypeReference` mints a
	// `typeParameter` as `typeParamTokenFor(self.enclosingType, paramName: name)` for any `name` in
	// `enclosingTypeParams`, and `recordStruct`/`recordInterfaceDeclaration` file an owner for exactly the
	// pairs a DECLARATION makes. Left standing, this assignment publishes the target's parameter names under
	// an `enclosingType` that is not the target: for an INTERFACE EXTENSION NO TYPE IMPLEMENTS,
	// `extensionTargetConformers` is empty, the conformer loop that would call `enterTypeScope` never runs,
	// and the names stay live at FILE SCOPE for the rest of the parse. A later `Element` then compiles though
	// it names no declared type, or panics `ProgramSignatures.opaqueTypeParamPosition`, where the closed
	// window reports **E3011 Unknown type 'Element'**.
	//
	// ⚠ A `readWhereClause` that THROWS leaves the window open, and that is bounded rather than ignored: a
	// `SourceParseError` in the real parse either rewinds its declaration region to a mark taken at
	// file scope, which closes the window (`Parser.rewindTo`), or abandons the whole file
	// (`abortedParseArtifact`), and in the fold the throw is swallowed by
	// `foldExtensionDeclarationInto`'s `otherwise return`, whose only successor is the next site's own
	// call to this reader — which overwrites the field before anything reads it.
	function readExtensionHeader() returns ExtensionHeader throws SourceParseError
		try self.consume(TokenKind.extension)

		// ⭐ **THE TARGET IS READ THROUGH THE TYPE-BASE READER, NOT `consume(TokenKind.identifier)`.**
		// Three of Maxon's types are spelled with a KEYWORD (`KeywordTable`), so `extension int`
		// arrives here as `E2010 Expected identifier but got 'int'` — a refusal of the very declaration
		// `stdlib/PrimitiveExtensions.maxon` opens with. `typeBaseTokenAt` is ALREADY the compiler's one
		// answer to *"which token names a type here?"*: it re-mints a primitive keyword as an
		// identifier-kinded token carrying the keyword's own spelling, line, column and span, so every
		// reader below — `extensionTargetOf`, `enterTypeScope`, `declaredMethodName`, the `where`
		// clause's blame token — serves a primitive without learning that a keyword got here. Widening
		// this reader instead would have been a second table of "which keywords name types", which is the
		// one-fact-written-twice bug this file keeps paying for.
		//
		// ⚠ **AND IT IS WIDENED IN EXACTLY ONE PLACE BECAUSE THIS IS THE ONE READER** (see this function's
		// header): the pre-scan, the whole-program fold and the real parse all come through here, so the three
		// cannot come to disagree about whether `int` names a target.
		//
		// ⚠ It also admits `Self`, which the reader resolves to the enclosing declaration's name — and an
		// `extension` is always at file scope, so that path is `requireEnclosingTypeName`'s positioned
		// *"'Self' outside a type declaration"* rather than an `E2010`. A strictly better
		// sentence about the same rejected program; no case in the corpus writes it.
		let nameTok = try self.consumeExtensionTargetName()
		let target = self.signatures.extensionTargetOf(nameTok.value)

		// ⭐ **THE `implements` CLAUSE IS READ BEFORE THE `where`, WHICH IS THE ORDER THE LANGUAGE WRITES
		// THEM** (`extension Array implements Hashable, Equatable where Element is Hashable and Equatable`).
		// It reuses the `type` declaration's own reader — one grammar for one clause — so an associated-type
		// binding (`implements Iterable with (Element, Iter)`) means here exactly what it means there.
		let interfaces = try self.readImplementsList(ConformanceOwner.unchecked)

		if not self.at(TokenKind.where) 'unconditional'
			return ExtensionHeader.create(nameTok, target: target, interfaces: interfaces, constraints: WhereConstraintArray.create(0))
		end 'unconditional'

		self.enclosingTypeParams = extensionTargetParamNames(target)
		let whereTok = self.current()
		let spelledBounds = RegionBoundArray.create(0)
		let constraints = try self.readWhereClause(self.enclosingTypeParams, owner: TypeWhereClauseOwner, admitsAssociatedBindings: true, bounds: spelledBounds)
		try self.requireNoRegionBounds(spelledBounds, whereTok: whereTok, owner: "an `extension`'s `where` clause")
		self.enclosingTypeParams = self.emptyTypeParams

		return ExtensionHeader.create(nameTok, target: target, interfaces: interfaces, constraints: constraints)
	end 'readExtensionHeader'

	// The parser state an extension BODY is read under, for whichever door the extension came through — set
	// after `enterTypeScope(conformer)`, which deliberately clears every one of these.
	//
	// ⚠⚠ **AN INTERFACE EXTENSION'S BODY NEVER GETS THE *INTERFACE'S* ASSOCIATED NAMES AS TYPE PARAMETERS, AND
	// THAT IS NOT AN OMISSION.** Its `where` clause names those associated types, which this body may not
	// refer to as type PARAMETERS: they are bound concretely per conformer, and installing them in
	// `enclosingTypeParams` would make a written `Element` resolve to a parameter of the CONFORMER — a
	// different type, silently. Its constraints are a filter that has already been applied by the time this is
	// called (`extensionConformerVerdict`), so there is nothing left for the body to dispatch through either.
	//
	// ⭐ **WHAT THE ASSOCIATED NAMES GET INSTEAD IS THE CONFORMER'S BINDING** (conditional extensions), which is
	// available here for exactly the reason the parameter reading is wrong: this pass is monomorphizing for ONE
	// conformer, and that conformer's `implements … with …` says what its `Element` IS. See
	// `Parser.extensionAssociated` and the ⚠ in `parseTypeReference`.
	//
	// ⭐ **THE CONFORMER'S OWN `uses` PARAMETERS ARE A DIFFERENT LIST AND ARE INSTALLED** — see the block
	// at the assignment below for why the two are not the same fact, and for the two things that break
	// without it.
	function openExtensionBodyScope(header ExtensionHeader, conformer ByteArray, index ProgramSignatures, pass ExtensionBodyPass)
		// ⭐⭐ **AN EXTENSION BODY RESOLVES A BARE NESTED-ALIAS MEMBER AGAINST THE WHOLE PROGRAM, NOT AGAINST ITS
		// OWN BODY WALK** — set FIRST, ahead of the `undeclaredTarget` return, because it is a property of
		// being an extension body and not of which kind of target the extension has. See `namesInnerAliasHere`
		// for the rule and for why the type's OWN body deliberately does not get it.
		self.innerAliasesFromIndex = true

		match header.target 'target'
			interfaceExtension then self.openInterfaceExtensionBodyScope(header, conformer: conformer, index: index, pass: pass)
			undeclaredTarget then return

			// A TYPE extension's body IS inside the extended type's own parameter scope: `function matches(other
			// Item)` names the type's `uses` parameter, and `item == other` dispatches `Equatable.equals` through
			// the hidden witness the constraint reserves — the same two mechanisms a `where` clause written on
			// the `type` itself drives, reached through the same two fields. It installs NO substitution: its
			// parameters are bound per INSTANTIATION, so there is no single binding to substitute.
			typeExtension then self.openTypeExtensionBodyScope(header, index: index)
		end 'target'
	end 'openExtensionBodyScope'

	// ⭐ **THE INTERFACE-EXTENSION ARM'S BODY, WHICH USED TO BE THE TAIL THIS FUNCTION FELL OUT INTO.**
	//
	// ⛔⛔ **RETURNING A VOID CALL IS NOT VALID (user ruling, 2026-08-23), AND THE `typeExtension` ARM WAS
	// DOING IT.** `return self.openTypeExtensionBodyScope(…)` hands back a callee that declares no return
	// type — `specs/void-call-result.md` makes a void call's result unusable in every expression
	// position, `return <expr>` included. It was written that way because a `match` arm is exactly ONE
	// statement (`specs/match-statements.md`), so an arm could not both do its work AND leave the function
	// ahead of the tail below.
	//
	// ⭐ **THE CURE IS TO MAKE THE CLASSIFICATION TERMINAL** — every arm now CALLS and none falls out, so the
	// tail needs a name instead of a fallthrough. It is the same cure `LowerMaxonToStd`'s four residues took
	// (`appendRuntimeCall` / `appendThrowingCall` / `appendStdUnaryOp`), and for the same reason.
	function openInterfaceExtensionBodyScope(header ExtensionHeader, conformer ByteArray, index ProgramSignatures, pass ExtensionBodyPass)
		// ⭐⭐ **A GENERIC CONFORMER'S OWN `uses` PARAMETERS ARE INSTALLED, AND THAT IS NOT THE THING THE ⚠ ABOVE
		// FORBIDS.** What must never be installed is the INTERFACE's associated names — that would make a
		// written `Element` resolve to a parameter of the CONFORMER, a different type. These are the
		// CONFORMER's own names, and this body is being specialized for exactly that conformer: `Box.map` IS a
		// method of `type Box uses T`, so a `T` reachable here means `Box.T` and can mean nothing else. The
		// substitution and the scope compose rather than compete — `Element` is rewritten to the binding the
		// conformer wrote (`T`), and the scope is what then gives that name a type at all.
		//
		// ⛔ **WITHOUT IT, `extension Iterable`'s BODY CANNOT BE PARSED FOR ANY GENERIC CONFORMER** — its
		// `typealias ElementArray = Array with Element` substitutes to `Array with T` and `T` names nothing:
		// **`E3011 stdlib/Interfaces.maxon:195:38: Unknown type 'T'`**, five times, for a legal program the
		// oracle runs. That is why no generic type in the corpus implemented `Iterable` before this assignment
		// existed — the conformance was unrepresentable, not merely unused.
		//
		// ⛔⛔ **AND THE WITNESS SLOTS MUST BE INSTALLED IN THE SAME ACT, OR THE BODY RESERVES ZERO ARGUMENT
		// REGISTERS WHILE EVERY CALLER FILLS TWO.** The SUPPLY side answers
		// `witnessConstraintsOfMethod("Map.map")` → `typeExtensionWitnessConstraints("Map", …)`, which returns
		// the TYPE's own clause whether the method came from the type's body or from an interface extension —
		// an interface extension files no EXTRA constraints (`noteTypeExtensionWitnessConstraints`), but "adds
		// none" is not "carries none". Asked through the same one door the type extension asks through, so the
		// two sides remain one call and not two agreeing lists.
		//
		// ⚠ **MEASURED INDEPENDENTLY, ON A CONFORMER WHOSE OWN CLAUSE IS THE ONLY ONE THERE IS:**
		// `stdlib/Interfaces.maxon`'s `extension Iterator.advanceBy`, published onto a conformer declared
		// `where Key is Hashable and Equatable`, reserved zero witness slots while its `try self.advance()`
		// forwarded two — the precise shape `witnessConstraintsOfMethod`'s header records two crashes for.
		// The empty list is the extension's OWN side, which is empty for the reason above.
		self.enclosingTypeParams = index.structTypeParamsOf(conformer)
		self.enclosingWhereConstraints = index.typeExtensionWitnessConstraints(conformer, extensionConstraints: WhereConstraintArray.create(0))
		self.enclosingExtensionConstraints = WhereConstraintArray.create(0)

		// BOTH COLUMNS OR NEITHER — the length agreement `conformerAssociatedBindings` enforces has already
		// emptied a list that cannot be paired, so an empty one here means only "this conformer binds nothing
		// positionally" and installing it against a non-empty `associated` would invent the pairing that door
		// just refused.
		let associated = extensionTargetParamNames(header.target)
		let bindings = self.conformerAssociatedBindings(header, conformer: conformer, index: index)

		if associated.count() != bindings.types.count() 'noPositionalPairing'
			return
		end 'noPositionalPairing'

		self.extensionAssociated = ExtensionAssociatedScope.over(associated, bindings: bindings.types, bindingFilePath: self.extensionConformerLayout(conformer, index: index).declFilePath, pass: pass)
	end 'openInterfaceExtensionBodyScope'

	// The TYPE-extension half of the door above, split out so the interface half reads as one path rather than
	// as an early return threaded through a `match` arm.
	//
	// ⭐⭐ **THE WITNESS SLOTS THIS BODY RESERVES ARE THE ONES `ProgramSignatures.witnessConstraintsOfMethod`
	// ANSWERS WITH — the SAME call, not a second derivation of the same rule.** Installing
	// `header.constraints`, the extension's own clause, while the supply side falls back to the TYPE's `where`
	// clause makes the two lists agree only when the extension's happens to contain the type's, and where they
	// do not the body reserves fewer argument registers than every caller fills. See
	// `typeExtensionWitnessConstraints` for why the union is declaration-order independent.
	//
	// `header.nameTok.value` IS the extended type's name — the type arm of `extensionTargetOf` is taken only
	// when that name resolves in the struct registry, and the single conformer it publishes is that same name.
	function openTypeExtensionBodyScope(header ExtensionHeader, index ProgramSignatures)
		self.enclosingTypeParams = extensionTargetParamNames(header.target)
		self.enclosingWhereConstraints = index.typeExtensionWitnessConstraints(header.nameTok.value, extensionConstraints: header.constraints)
		self.enclosingExtensionConstraints = header.constraints
	end 'openTypeExtensionBodyScope'

	// What `conformer` binds the extended interface's associated types to — the same column
	// `extensionConformerVerdict` evaluates the `where` clause against (`StructLayout.bindingsForInterface`),
	// read through one accessor so the CONDITION a method is withheld under and the TYPES its body is parsed
	// with can never come from two different readings of one `implements` clause.
	//
	// ⚠⚠ **A LIST WHOSE LENGTH DISAGREES WITH THE INTERFACE'S ARITY IS EMPTIED HERE, AND THAT IS THE ONE
	// GATE** — gating in `openExtensionBodyScope` alone would leave `extensionConformerVerdict` reading the
	// same column UNGATED. Both pair POSITIONALLY (a body's substitution by index, a
	// `WhereConstraint.typeParamIndex` by index), so a surplus list makes the verdict read a NEIGHBOUR's
	// binding — `extension One where A is Comparable` asking about the first of two items rather than about
	// what `A` actually is. That is a wrong answer where the body scope's own gate gives a missing one, and
	// the two must not differ: this accessor's whole stated purpose is that the CONDITION and the TYPES come
	// from one reading.
	//
	// It is reachable on a clause that binds more or fewer types than the interface declares, which
	// E3016 or `checkParenthesizedConformanceArgs` refuses separately, and on a clause
	// `foldConformanceClauseInto` cannot re-read, which leaves the declaration sweep's arity-blind
	// record standing (`parenthesizedWithBindsOneTuple`). Emptied here, the consequence is a
	// conditional extension WITHHELD from that conformer and a body parsed with no substitution —
	// `readOptionalImplementsClause`'s standard, bounded and missing rather than wrong.
	function conformerAssociatedBindings(header ExtensionHeader, conformer ByteArray, index ProgramSignatures) returns ConformanceBinding
		return pairableConformanceBindings(self.extensionConformerLayout(conformer, index: index).bindingsForInterface(header.nameTok.value), associatedTypeNames: extensionTargetParamNames(header.target))
	end 'conformerAssociatedBindings'

	function extensionConformerLayout(conformer ByteArray, index ProgramSignatures) returns StructLayout
		match index.structInAnyFile(conformer) 'conformerLayout'
			declared(layout) then return layout
			undeclared then panic("Parser.extensionConformerLayout: conformer '{String.from(conformer)}' came out of `extensionTargetConformers`, which walks the struct registry this lookup misses")
		end 'conformerLayout'
	end 'extensionConformerLayout'

	// ⭐ **DOES THIS CONFORMER GET THE EXTENSION'S METHODS?** — the conditional filter, stated once for both
	// passes. See `ExtensionTarget` for why only the interface door has anything to decide.
	function extensionConformerVerdict(header ExtensionHeader, conformer ByteArray, index ProgramSignatures) returns ExtensionConstraintCheck
		if header.constraints.isEmpty() 'unconditional'
			return ExtensionConstraintCheck.satisfied
		end 'unconditional'

		match header.target 'target'
			// A type extension's parameters are bound per instantiation, not per conformer, so there is no
			// binding here to test: the constraints become witness parameters instead. An undeclared target
			// has no conformers and never reaches here.
			typeExtension or
			undeclaredTarget then return ExtensionConstraintCheck.satisfied
			interfaceExtension then break
		end 'target'

		// Through `conformerAssociatedBindings`, NOT a second `bindingsForInterface` of its own: that accessor
		// is where the positional-pairing gate lives, and this reader indexes the column exactly as the body
		// scope does. Reading the column directly is what let the two answer differently — see its header.
		return checkExtensionConstraints(index, constraints: header.constraints, bindings: self.conformerAssociatedBindings(header, conformer: conformer, index: index), readerFilePath: self.extensionConformerLayout(conformer, index: index).declFilePath)
	end 'extensionConformerVerdict'

	// File the witness constraints a TYPE-extension method adds ON TOP of its target type's own, under the
	// qualified name a call to it resolves to. A no-op for every other extension: an interface extension's
	// clause is a filter (its methods carry no witnesses), and an UNCONDITIONAL extension adds none.
	//
	// ⚠ "Adds none" is not "carries none": an unconditional extension on a `where`-constrained type
	// carries that type's witnesses like every other instance method of it, and
	// `ProgramSignatures.typeExtensionWitnessConstraints` recovers them from the type. Reading this
	// early return as "no witnesses" makes the body reserve no argument registers for what its
	// callers pass.
	function noteTypeExtensionWitnessConstraints(index ProgramSignatures, header ExtensionHeader, conformer ByteArray, methodName ByteArray)
		match header.target 'target'
			interfaceExtension or
			undeclaredTarget then return
			typeExtension then break
		end 'target'

		if header.constraints.isEmpty() 'unconditional'
			return
		end 'unconditional'

		index.recordExtensionMethodConstraints(qualifiedMethodName(conformer, methodName: methodName), constraints: header.constraints)
	end 'noteTypeExtensionWitnessConstraints'

	// ⭐ **PUBLISH THE EXTENSION METHOD, OR READ IT AND THROW THE SIGNATURE AWAY.** A SHADOWED method is
	// read exactly as a withheld one is — the cursor must land where a published one leaves it — and files no
	// `ConditionalExtensionSkip`, because nothing is missing: the conformer's own method wears the name, and a
	// call to it resolves through the ordinary member door with the ordinary diagnostics.
	//
	// The published name is noted so `conformerDeclaresOwnMethod` can tell a conformer's own declaration from
	// an extension's the next time it is asked — see that door for why the distinction is what keeps the
	// verdict independent of fold order.
	function publishOrShadowExtensionMethod(index ProgramSignatures, header ExtensionHeader, conformer ByteArray, shadowed bool, qualifiedMethodName ByteArray, takesReceiver bool, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, bodyFacts SweptBodyFactEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut NameRoster)
		if shadowed 'theConformerDeclaresItsOwn'
			self.recordScannedSignature(FuncReturnTypeEntryArray.create(0), paramConsumes: ParamConsumeEntryArray.create(0), paramReassigns: ParamReassignEntryArray.create(0), globalAliasReturns: GlobalAliasReturnEntryArray.create(0), paramDefaults: ParamDefaultEntryArray.create(0), throwsEntries: ThrowsClauseEntryArray.create(0), bodyFacts: SweptBodyFactEntryArray.create(0), methodInnerAliasParamOut: MethodInnerAliasParamEntryArray.create(0), freeFunctionNameOut: NameRoster.create(0), messageMethodNameOut: NameRoster.create(0))
			return
		end 'theConformerDeclaresItsOwn'

		// The DECLARING FILE and its PROVENANCE ride along, because a stdlib claimant against a user claimant is
		// not a contest at all: the user's declaration wins and this one is withheld.
		//
		// ⚠ **THE NOTE COMES FIRST, AND THE ORDER IS THE POINT** — it is what answers whether THIS declaration
		// is the one being withheld, and a signature published before asking would be a corpus signature
		// standing where the user's belongs whenever the sweep folds `stdlib/` last.
		index.noteExtensionPublishedMethod(qualifiedMethodName, takesReceiver: takesReceiver, declFilePath: self.job.path, isStdlibSource: self.job.isStdlibSource)

		if extensionTargetIsAnInterface(header.target) 'anInterfaceExtension'
			index.noteInterfaceExtensionMember(qualifiedMethodName, conformer: conformer, interfaceName: header.nameTok.value)
		end 'anInterfaceExtension'

		// ⚠ **AN EXTENSION METHOD IS NOT A MESSAGE**, so its roster contribution is discarded here rather
		// than threaded to the conformer's layout: `extension Countable` declares one body on every conformer, and
		// a service's variant order is a wire format its own declaration has to own. The two withheld arms above
		// discard for the same reason plus their own.
		self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut, messageMethodNameOut: NameRoster.create(0))
	end 'publishOrShadowExtensionMethod'

	// Read a WITHHELD method's signature into arrays that are discarded, and file why it is missing. The read
	// is what keeps the cursor where a published method's leaves it (see the call site); the filing is what
	// lets the call site say something better than "no such method".
	function foldWithheldExtensionMethod(index ProgramSignatures, conformer immutable ByteArray, methodName immutable ByteArray, clause String, unmetInterfaceName ByteArray, bindingName ByteArray, shadowed bool)
		self.recordScannedSignature(FuncReturnTypeEntryArray.create(0), paramConsumes: ParamConsumeEntryArray.create(0), paramReassigns: ParamReassignEntryArray.create(0), globalAliasReturns: GlobalAliasReturnEntryArray.create(0), paramDefaults: ParamDefaultEntryArray.create(0), throwsEntries: ThrowsClauseEntryArray.create(0), bodyFacts: SweptBodyFactEntryArray.create(0), methodInnerAliasParamOut: MethodInnerAliasParamEntryArray.create(0), freeFunctionNameOut: NameRoster.create(0), messageMethodNameOut: NameRoster.create(0))

		// The skip is keyed by the qualified name the conformer's own method also wears, so filing one for a
		// shadowed method would refuse every call to the conformer's method as E4006.
		if shadowed 'theConformersOwnMethodIsTheOneItsCallMeans'
			return
		end 'theConformersOwnMethodIsTheOneItsCallMeans'

		index.recordConditionalExtensionSkip(qualifiedMethodName(conformer, methodName: methodName), skip: ConditionalExtensionSkip.create(conformer, methodName: methodName, clause: clause, unmetInterfaceName: unmetInterfaceName, bindingName: bindingName))
	end 'foldWithheldExtensionMethod'

	// Cursor is AT `enum`/`union`. Append the enum/union it declares and leave the cursor PAST the
	// declaration's `end` — `recordScannedType`'s twin.
	//
	// TOLERANT, for `recordScannedType`'s reason: a malformed enum is the REAL parse's to report,
	// with a position. It shares `readEnumCaseInto` and `enumBodyEndsAt` with `parseEnumDeclaration`,
	// so the sweep and the parse cannot drift on how a case's TAG is assigned — the fact the parser
	// reads back at every `Color.red` and every `match`. `readEnumCaseInto` consumes the keyword
	// before it can fail (below), so the cursor always advances and the caller's loop cannot spin.
	//
	// It walks the body ITSELF (like `recordScannedType`) rather than letting the caller's loop do
	// it: a case named `end` means only `enumBodyEndsAt`'s label-lookahead rule can tell the
	// terminator from a case, which the caller's generic `blockDepthAfter` cannot.
	//
	// ⭐ **A METHOD MEMBER IS SCANNED, NOT SKIPPED**, through the same `recordScannedSignature`
	// `recordScannedType` uses — so `Direction.isNorth`'s return type is in the whole-program index before
	// any file is parsed, which is what types `d.isNorth()` at a call site in ANOTHER file.
	//
	// ⚠ **AND THAT IS WHY THIS WALK COUNTS BLOCK DEPTH.** A method's own `end 'isNorth'` is an `end`
	// followed by a character literal — byte-for-byte what `enumBodyEndsAt` recognizes as the ENUM's
	// terminator. Ungated by depth it would close the enum at the first method's `end`, truncating the case
	// list and leaving the rest of the method's body to be read as top-level declarations.
	function recordScannedEnum(enums EnumLayoutArray, entries FuncReturnTypeEntryArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, bodyFacts SweptBodyFactEntryArray, methodInnerAliasParamOut MethodInnerAliasParamEntryArray, freeFunctionNameOut NameRoster, conformanceSiteOut ConformanceClauseDeclSiteArray, isUnion bool)
		// Read BACKWARDS, before the keyword is consumed — see `recordScannedType` for why the sweep cannot
		// read this modifier forwards. `declStart` is that same position kept for the whole-program clause
		// re-read (`recordScannedType`'s twin, and `ConformanceClauseDeclSite`).
		let declStart = self.pos
		let visibility = self.visibilityBefore(self.pos)
		try self.consume(TokenKind.union if isUnion else TokenKind.enum) otherwise return
		let nameTok = try self.consume(TokenKind.identifier) otherwise return

		// ⭐ **AN ENUM'S CLAUSE IS TRUNCATED BY THE SAME `with` RULE AND IS RE-READ BY THE SAME PASS.**
		// It binds nothing an extension is evaluated against — an enum has no conditional extension — but a
		// LOST NAME is the same loss on both kinds: `enum E implements Marker with Tag, Error` would drop the
		// `Error` that `throws E` is narrowed against (`EnumLayout.conformsTo`).
		// Deferred on the same one condition the `type` half defers on — see `implementsClauseBindsAnything`.
		if self.at(TokenKind.implements) and self.implementsClauseBindsAnything() 'deferredConformances'
			conformanceSiteOut.push(ConformanceClauseDeclSite.create(self.job.path, tokenPos: declStart, declName: nameTok.value, declIsEnum: true))
		end 'deferredConformances'

		let scannedConformances = try self.readOptionalImplementsClause() otherwise return
		let conformsTo = scannedConformances.names
		self.enterTypeScope(nameTok.value, isEnum: true)

		let layout = EnumLayout.create(nameTok.value, isUnion: isUnion, conformsTo: conformsTo, visibility: visibility, declFilePath: self.job.path, backing: EnumBacking.unresolved)
		layout.declLine = nameTok.line
		layout.declColumn = nameTok.column
		let ledger = EnumCaseLedger.create()

		var depth = 0 as BlockDepth

		while not self.isEof() 'body'
			self.skipNewlines()

			if depth == 0 and self.enumBodyEndsAt(self.pos) 'closes'
				self.advance()
				self.skipOptionalLabel()
				break
			end 'closes'

			// A method (`[export] [static] function <name>(`) at the enum's own level. `function` ALONE is a
			// legal case name, so only a real method-start is one. The block it opens is counted BEFORE the
			// signature is read, because reading it moves the cursor past the `function` keyword — exactly as
			// `recordScannedType`'s method arm does, and for the same reason.
			if depth == 0 and self.atEnumMethodStart() 'method'
				self.pos = pastDeclarationModifiers(self.tokens, index: self.pos)
				depth = depth + 1
				self.advance()

				// ⚠ **AN ENUM/UNION METHOD IS NOT A MESSAGE** — a service is a declared `type`, reached through
				// `spawn <T>.<factory>()`, whose target test requires a struct declaration. So the roster this method
				// would contribute is discarded, exactly as an extension method's is.
				self.recordScannedSignature(entries, paramConsumes: paramConsumes, paramReassigns: paramReassigns, globalAliasReturns: globalAliasReturns, paramDefaults: paramDefaults, throwsEntries: throwsEntries, bodyFacts: bodyFacts, methodInnerAliasParamOut: methodInnerAliasParamOut, freeFunctionNameOut: freeFunctionNameOut, messageMethodNameOut: NameRoster.create(0))
				continue
			end 'method'

			if depth == 0 'caseMember'
				// A case the sweep cannot read leaves the layout SHORT, which would misassign every later
				// case's tag — so the scan stops rather than recording a layout it knows is wrong.
				try self.readEnumCaseInto(layout, ledger: ledger) otherwise break
				continue
			end 'caseMember'

			depth = self.blockDepthAfterCursor(depth)
			self.advance()

			// ⚠⚠ **A METHOD'S CLOSING `end` CARRIES ITS BLOCK LABEL, AND THIS WALK MUST EAT IT** — because the
			// token right after it is read as a MEMBER, and a label is a `charLiteral`. ⛔ Missing a ONE-character
			// label (`end 'a'`) silently declares a case `a` and fixes the enum's backing to `character`, since
			// such a case is legal implicitly-backed. A longer label aborts the scan as an invalid character
			// literal, which costs the rest of the type: with `end 'bump'` the sweep stops at the label, a SECOND
			// method's signature never reaches the whole-program index (`e.second()` types `unresolved` and PANICS
			// in lowering), and every case declared after a method is dropped from the layout.
			// `recordScannedType` needs no such step only because its depth-0 fall-through advances one token
			// instead of reading a member.
			//
			// Only the return to the enum's OWN level matters: a label on an inner `end 'spin'` leaves the walk
			// at depth > 0, where it is an ordinary token.
			if depth == 0 'memberClosed'
				self.skipOptionalLabel()
			end 'memberClosed'
		end 'body'

		enums.push(layout)
		appendUnionCasesCompanion(enums, layout: layout)
		self.closeTypeParamScope()
	end 'recordScannedEnum'

	// `type <Name>` — the two tokens every type declaration opens with, read by BOTH the tolerant
	// sweep and the real parse. One reader, so the two can never disagree about what a type is
	// CALLED, which is the name every method of it is declared under and every use of it resolves
	// through.
	function readTypeHeader() returns TypeHeader throws SourceParseError
		try self.consume(TokenKind.type)
		let nameTok = try self.consume(TokenKind.identifier)

		if not self.at(TokenKind.is) 'notUnique'
			return TypeHeader.create(nameTok, isUnique: false)
		end 'notUnique'

		self.advance()
		let wordTok = self.current()

		if wordTok.kind != TokenKind.identifier or not wordTok.value.equals(UniqueDeclarationWord) 'notTheWord'
			throw SourceParseError.unexpectedToken("`{String.from(UniqueDeclarationWord)}`", got: tokenDisplayText(wordTok), line: wordTok.line, column: wordTok.column)
		end 'notTheWord'

		self.advance()
		return TypeHeader.create(nameTok, isUnique: true)
	end 'readTypeHeader'

	function enterTypeScopeOf(name ByteArray)
		self.enterTypeScope(name, isEnum: self.signatures.containsEnumFor(name, readerFilePath: self.job.path))
	end 'enterTypeScopeOf'

	// ⭐ **ENTER THE SCOPE OF A NAMED DECLARATION — ITS NAME AND ITS KIND, WRITTEN IN ONE PLACE.** The
	// opening half of `closeTypeParamScope`, called by every door that reads a declaration's header: the
	// real parse and the tolerant sweep of a `type` and of an `enum`/`union`, and the interface parse.
	//
	// ⭐ **THE KIND RIDES WITH THE NAME BECAUSE THE TWO ARE ONE FACT** — "which declaration encloses the
	// cursor" — and a `structRef`-vs-`named` receiver type is decided from it (`enclosingSelfType`). Set
	// apart, an enum door that remembered to write the name and forgot the kind would give an enum's `self`
	// a struct's type: a receiver typed `structRef(Toggle)` against a `StructLayout` no file declares.
	//
	// It also resets the three PER-DECLARATION scopes, for the reason `closeTypeParamScope` restores them:
	// a sibling declaration's `Idx`, `T` or `where` constraint must not leak into this one. All three point
	// at their SHARED empty, so entering a scope allocates nothing.
	// ⚠ It takes the NAME and not the name TOKEN, because one caller has no token to give: an interface
	// extension enters the scope of each CONFORMING type in turn, and those names come from the whole-program
	// conformance relation rather than from any token in the extension's own file.
	function enterTypeScope(name ByteArray, isEnum bool)
		self.enclosingType = EnclosingTypeScope.typeBody(name)
		self.enclosingBodyIsWalkable = false
		self.enclosingTypeIsEnum = isEnum
		self.enclosingTypeParams = self.emptyTypeParams
		self.enclosingInnerAliases = noInnerAliases
		self.declaredNestedAliases = noInnerAliases
		self.clearBodyAliasScan()
		self.innerAliasesFromIndex = false
		self.enclosingWhereConstraints = WhereConstraintArray.create(0)
		self.enclosingExtensionConstraints = WhereConstraintArray.create(0)
		self.clearExtensionAssociatedTypes()
	end 'enterTypeScope'

	// Point both associated-type columns back at the shared empty — the FOURTH per-declaration scope, reset by
	// the same two doors as the other three. Its own function because both halves must move together: a
	// bindings list left standing beside a cleared name list is a substitution keyed by position against
	// nothing, which is exactly the shape that answers for the wrong conformer's binding.
	function clearExtensionAssociatedTypes()
		self.extensionAssociated = ExtensionAssociatedScope.empty()
	end 'clearExtensionAssociatedTypes'

	// ⭐ **WHAT THIS EXTENSION BODY'S CONFORMER BINDS `name` TO** (conditional extensions); it throws when
	// `name` is not an associated type of the extended interface. Outside an interface extension the columns
	// are the shared empty, so `parseTypeReference` asks unconditionally and falls back to the name the
	// author wrote.
	//
	// A linear scan: an interface declares a handful of associated types, so a per-parse name→binding map
	// would be a heap object bought to serve one or two lookups.
	function extensionAssociatedType(name ByteArray) returns MaxonType throws MapError
		let i = try self.extensionAssociated.names.positionOfName(name)
		let bound = try self.extensionAssociated.bindings.get(i) otherwise panic("extensionAssociatedType: the conformer binds nothing at associated-type position {i}, where the interface declares {self.extensionAssociated.names.count()} — `openExtensionBodyScope` installs the two columns only when their lengths agree")
		let repaired = self.repairSweptType(resolvedBindingType(bound, typeNames: self.artifact.typeNames, signatures: self.signatures), scopeFilePath: self.extensionAssociated.bindingFilePath)

		if self.extensionAssociated.pass == ExtensionBodyPass.sweep or maxonTypeTag(repaired) != ValueTypeTag.named 'keepsTheBareName'
			return repaired
		end 'keepsTheBareName'

		let bindingFilePath = self.extensionAssociated.bindingFilePath
		let identity = self.signatures.bareWrittenKey(self.internedName(typeNameIdOf(repaired)), readerFilePath: bindingFilePath)

		return try self.interfaceTypeOfIdentity(identity, readerFilePath: bindingFilePath) otherwise repaired
	end 'extensionAssociatedType'

	function interfaceTypeOfIdentity(identity immutable ByteArray, readerFilePath FilePath) returns MaxonType throws MapError
		if not self.signatures.allFilesFolded or not self.signatures.containsInterfaceFor(identity, readerFilePath: readerFilePath) 'namesNoInterface'
			throw MapError.keyNotFound
		end 'namesNoInterface'

		return MaxonType.interfaceRef(self.artifact.typeNames.intern(identity))
	end 'interfaceTypeOfIdentity'

	function genericBoundTypeName(name immutable ByteArray) returns immutable ByteArray
		return match self.genericBindingOf(name) 'binding'
			bound(argument) gives argument.name
			unbound gives name
		end 'binding'
	end 'genericBoundTypeName'

	function genericBoundType(name ByteArray) returns BoundGenericType
		return match self.genericBindingOf(name) 'binding'
			bound(argument) gives self.boundTypeOfGenericArgument(argument)
			unbound gives BoundGenericType.byName
		end 'binding'
	end 'genericBoundType'

	function boundTypeOfGenericArgument(argument GenericFunctionArgument) returns BoundGenericType
		return match argument.kind 'kind'
			integer gives BoundGenericType.resolved(MaxonType.integer)
			float gives BoundGenericType.resolved(MaxonType.float)
			boolean gives BoundGenericType.resolved(MaxonType.boolean)
			string gives BoundGenericType.resolved(MaxonType.string)
			character gives BoundGenericType.resolved(MaxonType.character)
			record gives BoundGenericType.resolved(MaxonType.structRef(self.artifact.typeNames.intern(argument.name)))
			rangedAlias or
			enumeration gives BoundGenericType.byName
		end 'kind'
	end 'boundTypeOfGenericArgument'

	function genericBindingOf(name ByteArray) returns GenericBinding
		let index = try self.genericBindings.names.positionOfName(name) otherwise return GenericBinding.unbound
		return GenericBinding.bound(try self.genericBindings.bound.get(index) otherwise panic("genericBindingOf: genericBindings.bound holds {self.genericBindings.bound.count()} entries for {self.genericBindings.names.count()} bound names"))
	end 'genericBindingOf'

	// ⭐ **OPEN A GENERIC TYPE'S PARAMETER SCOPE** — `type Box uses T` / `type Pair uses A, B`.
	// Called by BOTH `parseTypeDeclaration` and the tolerant sweep `recordScannedType` right after
	// `enterTypeScope`, so the two record the SAME parameter list (the one a field's `typeParameter(token)`
	// is meaningful against). It sets `self.enclosingTypeParams` — how `parseTypeReference` recognizes a
	// bare `T` — and stamps the names onto the layout so the whole-program arity check can read them off
	// `structOf`. The cursor lands past the clause (at the type body); a type with no `uses` leaves the
	// list empty and consumes nothing.
	//
	// Commas separate the names (`uses A, B`), NO parentheses (the oracle's grammar). The loop stops at
	// the first non-identifier (a newline opening the body), exactly as a top-level `uses` clause does.
	function openTypeParamScope(layout StructLayout)
		let names = self.openTypeParamNames()

		// A NON-GENERIC type allocates nothing: it keeps the layout's create-time empty `typeParamNames`
		// and keeps the shared empty list `enterTypeScope` has just pointed the parser at. Only a `uses`
		// clause builds a real list — which is the rare case, and absent from the scale corpus entirely.
		if names.isEmpty() 'noUses'
			return
		end 'noUses'

		layout.recordTypeParams(names)
	end 'openTypeParamScope'

	// ⭐ **THE `uses` READ ITSELF — THE SCOPE HALF OF THE DOOR ABOVE, WITHOUT THE LAYOUT.** The
	// whole-program conformance-clause re-read (`foldConformanceClauseInto`) has to re-enter a declaration's
	// parameter scope to render its `with` arguments, and it has NO layout to stamp: the registry's may belong
	// to a DIFFERENT declaration of the same name, which is the guard
	// `ProgramSignatures.refoldConformanceClause` carries and which must not be written twice.
	//
	// ⚠ Split rather than copied, so all three readers — the sweep, the real parse and the re-read — take the
	// SAME reading of `uses A, B`. That is the property `openTypeParamScope`'s header claims for the first two,
	// and a third walk of this grammar is exactly how a re-read would come to disagree about a parameter list
	// every field's `typeParameter(token)` is resolved against.
	//
	// Commas separate the names (`uses A, B`), NO parentheses (the oracle's grammar). The loop stops at
	// the first non-identifier (a newline opening the body), exactly as a top-level `uses` clause does.
	function openTypeParamNames() returns immutable NameRoster
		if not self.at(TokenKind.uses) 'noUses'
			return self.emptyTypeParams
		end 'noUses'

		self.advance()
		let names = self.readUsesNames()
		self.enclosingTypeParams = names
		return names
	end 'openTypeParamNames'

	function readUsesNames() returns immutable NameRoster
		let names = NameRoster.create(0) as isolated NameRoster

		while self.at(TokenKind.identifier) 'usesLoop'
			let paramTok = self.current()
			self.advance()
			names.push(paramTok.value)

			if not self.at(TokenKind.comma) 'doneUses'
				break
			end 'doneUses'

			self.advance()
		end 'usesLoop'

		return freeze names
	end 'readUsesNames'

	// Close the enclosing-type scope — clears `enclosingType`, its KIND and `enclosingTypeParams`
	// in lockstep, so a sibling type at file scope starts fresh and a bare `T` outside a generic body
	// resolves as an ordinary named type, not a stale parameter. Restores the SHARED empty list rather
	// than a fresh one, so closing a type scope allocates nothing.
	function closeTypeParamScope()
		self.enclosingType = EnclosingTypeScope.fileScope
		self.enclosingBodyIsWalkable = false

		// Cleared with the name it belongs to (see `enterTypeScope`): a stale `true` at file scope would tell
		// `enclosingSelfType` a `Self` it can no longer resolve at all is an enum's.
		self.enclosingTypeIsEnum = false
		self.enclosingTypeParams = self.emptyTypeParams

		// Restored to the SHARED empty in lockstep so a bare `Idx` at file scope, after a type that
		// declared one, resolves as an ordinary named type rather than a stale inner alias — and allocates
		// nothing, exactly as `emptyTypeParams` restores.
		self.enclosingInnerAliases = noInnerAliases
		self.declaredNestedAliases = noInnerAliases
		self.clearBodyAliasScan()

		// Restored in lockstep for the same reason, one layer up: a drained default's index-scoped answer must
		// not survive into the next declaration, where the set above is the only truth again.
		self.innerAliasesFromIndex = false

		// Restored in lockstep so a dispatch outside a constrained type body resolves against
		// no stale constraints — and allocates nothing, exactly as `emptyTypeParams` restores.
		self.enclosingWhereConstraints = WhereConstraintArray.create(0)
		self.enclosingExtensionConstraints = WhereConstraintArray.create(0)

		// Restored in lockstep for the identical reason (conditional extensions): the NEXT conformer's pass
		// over the same extension body installs its own bindings, and a `Element` left pointing at the previous
		// conformer's would be a silently wrong type rather than an error.
		self.clearExtensionAssociatedTypes()
	end 'closeTypeParamScope'

	// ⭐⭐ **THE ASSOCIATED-TYPE BINDINGS ONE `where` CONSTRAINT CARRIES — `where Source is Iterator with
	// Element`.** The `with` clause an `implements` line already carries, read by the SAME reader
	// (`readConformanceWithArg`), so a binding written on a constraint and the same binding written on a
	// conformance are one stored identity.
	//
	// ⚠ **A MULTI-BINDING `with` MUST BE PARENTHESIZED HERE, WHERE ON AN `implements` LINE IT NEED NOT BE —
	// and that is forced rather than chosen.** `parseConformanceWithArgs`' comma-continued spelling is bounded
	// by the interface's `uses` ARITY, and that arity is UNRESOLVABLE in the declaration sweep (which is the
	// pass whose layout `ProgramSignatures.structOf` answers from). An `implements` clause can defer — it
	// stops early and `skipRestOfImplementsClause` consumes the tail, costing at worst a conformance the real
	// parse re-reads. A `where` clause cannot: its constraint list IS the witness-slot numbering, so a sweep
	// that read `where T is Pair with A, B` as `T is Pair with A` and then tried to read `B` as a constrained
	// PARAMETER would abandon the clause and file a SHORTER slot list whole-program — a wrong ABI, not a
	// wrong message. Parentheses make the extent a token fact, so both passes read the same list.
	function readWhereConstraintBindings(interfaceName ByteArray) returns RequirementTypeArray throws SourceParseError
		let types = RequirementTypeArray.create(0)

		if self.at(TokenKind.leftParen) 'delimited'
			_ = try self.parseConformanceWithArgs(interfaceName, spellings: NameRoster.create(0), types: types, owner: ConformanceOwner.unchecked)
			return types
		end 'delimited'

		_ = try self.readConformanceWithArg(types)
		return types
	end 'readWhereConstraintBindings'

	// ⭐ **PARSE A `where <T> is <Interface> [with <Bindings>] [and <Interface> …]… [, <U> is …]…` CLAUSE.**
	// The
	// cursor sits on `where`. Each `<param> is <Interface>` records a `WhereConstraint`, in SOURCE ORDER —
	// and that order is the witness-slot order the dictionary-passing ABI threads, so it must be stable
	// between the tolerant sweep and the real parse (both call this). A conjunction `is A and B` and a comma
	// list `T is A, U is B` each flatten to one entry per (param, interface) pair. The constrained parameter
	// is resolved to its `uses`-list INDEX against `enclosingTypeParams` (set by `openTypeParamScope`); a name
	// that is not a declared type parameter is rejected — a `where` on a non-parameter has no witness slot to
	// fill. Returns the (possibly empty) constraint list; the caller records it on the layout.
	function readWhereClause(typeParamNames NameRoster, owner String, admitsAssociatedBindings bool, bounds RegionBoundArray) returns WhereConstraintArray throws SourceParseError
		try self.consume(TokenKind.where)
		let constraints = WhereConstraintArray.create(0)

		while true 'params'
			let paramTok = try self.consume(TokenKind.identifier)
			let paramIndex = try typeParamNames.positionOfName(paramTok.value) otherwise throw SourceParseError.unsupported("a `where` clause constrains '{String.from(paramTok.value)}', which is not a type parameter of {owner} — a constraint must name one of its `uses` parameters", line: paramTok.line, column: paramTok.column)

			try self.consume(TokenKind.is)

			while true 'interfaces'
				if self.atRegionBound() 'aRegionBound'
					bounds.push(RegionBound.create(paramIndex, kind: self.regionBoundKindHere()))
					self.advance()

					if not self.at(TokenKind.and) 'doneBounds'
						break
					end 'doneBounds'

					self.advance()
					continue
				end 'aRegionBound'

				let ifaceTok = try self.consumeConformedInterfaceName()

				if not self.at(TokenKind.with) 'bindsNothing'
					constraints.push(WhereConstraint.create(paramIndex, interfaceName: ifaceTok.value))
				end 'bindsNothing' else 'bindsAssociatedTypes'
					let bindingTypes = try self.readWrittenWhereConstraintBindings(ifaceTok.value, admitsAssociatedBindings: admitsAssociatedBindings)
					constraints.push(WhereConstraint.create(paramIndex, interfaceName: ifaceTok.value, associatedBindingTypes: bindingTypes))
				end 'bindsAssociatedTypes'

				if not self.at(TokenKind.and) 'doneInterfaces'
					break
				end 'doneInterfaces'

				self.advance()
			end 'interfaces'

			if not self.at(TokenKind.comma) 'doneParams'
				break
			end 'doneParams'

			self.advance()
		end 'params'

		return constraints
	end 'readWhereClause'

	function regionBoundKindHere() returns RegionBoundKind
		let word = self.current().value

		if word.equals(SendableBoundWord) 'sendable'
			return RegionBoundKind.sendable
		end 'sendable'

		if word.equals(IsolatedCapabilityWord) 'isolated'
			return RegionBoundKind.isolated
		end 'isolated'

		panic("regionBoundKindHere: `{String.from(word)}` is not a region bound word, and atRegionBound admits only the two")
	end 'regionBoundKindHere'

	function requireNoRegionBounds(bounds RegionBoundArray, whereTok Token, owner String) throws SourceParseError
		if bounds.isEmpty() 'nothingBounded'
			return
		end 'nothingBounded'

		throw self.regionRefusal(ErrorCode.semanticRegionBoundRefused, message: "{owner} cannot bound a type parameter with `sendable` or `isolated`: those bounds belong to a generic type's own `where` clause, where every instantiation is checked against them", line: whereTok.line, column: whereTok.column)
	end 'requireNoRegionBounds'

	function atRegionBound() returns bool
		let word = self.current()
		return word.kind == TokenKind.identifier and (word.value.equals(IsolatedCapabilityWord) or word.value.equals(SendableBoundWord))
	end 'atRegionBound'

	function readWrittenWhereConstraintBindings(interfaceName ByteArray, admitsAssociatedBindings bool) returns RequirementTypeArray throws SourceParseError
		if not admitsAssociatedBindings 'aGenericFunctionConstraint'
			let withTok = self.current()
			throw SourceParseError.unsupported("a `where` constraint of a generic function binding the interface's associated types with `with` — constrain the function by the interface alone", line: withTok.line, column: withTok.column)
		end 'aGenericFunctionConstraint'

		try self.consume(TokenKind.with)
		return try self.readWhereConstraintBindings(interfaceName)
	end 'readWrittenWhereConstraintBindings'

	// Is the cursor on a FIELD declaration — `[export] (let|var) <name> …`?
	//
	// It defers to `atTopLevelBindingKeyword` for the keyword test rather than respelling it, for
	// that predicate's own reason: `let` and `var` introduce a binding in three places now (file
	// scope, a type body, a function body), and a keyword taught to one spelling and not another
	// would put two readers of one grammar a token apart.
	function atStructFieldKeyword() returns bool
		return self.structFieldKeywordAt(self.pos)
	end 'atStructFieldKeyword'

	// The same question at an arbitrary INDEX, and the ONE place a field declaration's `[modifier] let|var`
	// head is recognized. `visibilityModifierIn`'s split, one door up, and for its reason: the
	// fixed-element-count scan walks a type body by index and parses nothing.
	function structFieldKeywordAt(index ElementIndex) returns bool
		let keyword = pastDeclarationModifiers(self.tokens, index: index)
		let kind = self.kindAt(keyword)

		// `scanFixedElementCountNeedsInto` steps token by token, so it also asks at the `let` of a
		// `static let`, where no modifier lies ahead; the backward look keeps that binding out of the fields.
		return (kind == TokenKind.let or kind == TokenKind.var) and not staticModifierEndsAt(self.tokens, index: keyword)
	end 'structFieldKeywordAt'

	// ⭐ **DOES A MEMBER DECLARATION OPENING AT `index` DECLARE TYPE-QUALIFIED MODULE STORAGE — `[export]
	// static let`?** The `static` prefix is the whole difference between this and
	// `structFieldKeywordAt` one door up, which is why the two are written as siblings: a `let`/`var`
	// WITHOUT `static` is a per-instance FIELD and one WITH it is one copy for the type, and the predicates
	// that tell a member list which it is read the same head from the same index.
	function staticBindingKeywordAt(index ElementIndex) returns bool
		let afterStatic = pastDeclarationModifiers(self.tokens, index: index)
		return afterStatic > pastVisibilityModifiers(self.tokens, index: index) and self.kindAt(pastVisibilityModifiers(self.tokens, index: afterStatic)) == TokenKind.let
	end 'staticBindingKeywordAt'

	// Read one field declaration into `layout`. THE one field reader, shared by the sweep and the real
	// parse, so `StructLayout`'s field ORDER (which IS the box's slot order — see
	// `StructLayout.offsetOfField`) is read exactly once from one grammar. Two readers would be free
	// to disagree about how many fields a type has, and the one that was wrong would place every later
	// field at the wrong offset: a silent out-of-bounds read, not a compile error. The tolerant sweep
	// swallows every throw here and leaves the positioned diagnostic to the real parse.
	//
	// A defaulted field's type is read off the default's TOKENS (`inferredFieldTypeAt`) because the
	// sweep fixes the layout's offsets from it before any initializer is evaluated.
	function readStructFieldInto(declared StructLayout) throws SourceParseError
		let visibility = try self.consumeOptionalVisibility()

		let mutable = self.at(TokenKind.var)
		try self.consume(TokenKind.var if mutable else TokenKind.let)

		let nameTok = try self.consume(TokenKind.identifier)
		let repeatsAField = declared.fieldNames.contains(nameTok.value)
		let layout = layoutReceivingField(declared, repeatsAField: repeatsAField)

		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try requireMemberCount((layout.fieldCount()) + 1, limit: MaxDeclaredMembers, members: "fields", anchor: nameTok)

		if self.at(TokenKind.as) 'annotated'
			try self.consume(TokenKind.as)
			let annotation = try self.readWrittenFieldTypeAt(self.pos, layout: layout, fieldName: nameTok.value, voice: BarePrimitiveVoice.asAType)
			try self.requireFieldLineEnd()
			layout.addField(nameTok.value, declaredType: annotation.fieldType, mutable: mutable, tier: visibility, defaultValue: FieldDefault.none, declaredSurface: annotation.declaredSurface, declaredBrand: annotation.declaredBrand, spelledName: annotation.spelledName, typeSite: annotation.typeSite)
			layout.fieldTypeSites.noteCapabilityOfLatest(annotation.capability)
			return
		end 'annotated'

		let equalsTok = self.current()
		let defaultEnd = statementEndIndexIn(self.tokens, start: self.pos + 1, blockShiftAt: ignoreBlocks)
		try self.consume(TokenKind.equals)

		let defaultStart = self.pos
		let defaultTok = self.current()

		// Before the inference, which would otherwise answer `let at = __line__` with E2004 and a remedy
		// that cannot make a caller-location keyword legal where there is no caller.
		try requireNotACallerLocationDefault(defaultTok.value, at: defaultTok)

		let inferred = try self.inferredFieldTypeAt(defaultStart, regionEnd: defaultEnd, layout: layout, fieldName: nameTok.value)
		let spelling = inferred.spelling
		try self.requireDefaultableFieldType(nameTok, equalsTok: equalsTok, layout: layout, fieldType: spelling.fieldType)

		let defaultValue = try self.readInferredFieldDefault(nameTok, layout: layout, inferred: inferred, defaultStart: defaultStart, defaultEnd: defaultEnd, repeatsAField: repeatsAField)
		layout.addField(nameTok.value, declaredType: spelling.fieldType, mutable: mutable, tier: visibility, defaultValue: defaultValue, declaredSurface: spelling.declaredSurface, declaredBrand: spelling.declaredBrand, spelledName: spelling.spelledName, typeSite: spelling.typeSite)
		layout.fieldTypeSites.noteCapabilityOfLatest(spelling.capability)
	end 'readStructFieldInto'

	// The spelling columns are read before `parseTypeReference`, which folds `__ManagedMemory` into
	// the very `genericInstance` a `ByteArray` field resolves to; read after, the buffer alias would
	// be gone. A tuple SLOT's element bit is held clear (`slotElementsFromAliases: false`) because the
	// SWEEP fills this column while the alias table is still being built — see `declaredSurfaceAt`.
	function readWrittenFieldTypeAt(typeStart ElementIndex, layout StructLayout, fieldName ByteArray, voice BarePrimitiveVoice) returns FieldTypeSpelling throws SourceParseError
		self.pos = typeStart

		let capabilityTok = self.current()
		let writtenCapability = try self.readParamCapability()
		let declaredSurface = self.declaredSurfaceAt(self.pos, slotElementsFromAliases: false)
		let declaredBrand = self.typeSpellingAt(self.pos)
		let spelledName = self.spelledTypeNameAt(self.pos)

		let fieldTypeTok = self.current()
		let fieldType = try self.parseTypeReference(voice)
		try self.requireCapabilityFits(writtenCapability, wordTok: capabilityTok, spelled: fieldType)
		try self.requireFieldTypeIsFinite(layout.name, fieldName: fieldName, anchor: fieldTypeTok)

		return FieldTypeSpelling.create(fieldType, declaredSurface: declaredSurface, declaredBrand: declaredBrand, spelledName: spelledName, typeSite: writtenTypeSiteOf(fieldTypeTok), capability: self.aliasCapabilityOr(writtenCapability, typeTok: fieldTypeTok))
	end 'readWrittenFieldTypeAt'

	function readMemberHeadFieldTypeAt(headStart ElementIndex, qualifierDots ElementIndex, layout StructLayout, fieldName ByteArray) returns FieldTypeSpelling throws SourceParseError
		self.pos = headStart

		let declaredSurface = self.declaredSurfaceAt(headStart, slotElementsFromAliases: false)
		let headName = self.tokenAt(headStart).value if qualifierDots == 0 else self.assembleDottedChainAt(headStart, dots: qualifierDots)

		let fieldTypeTok = self.current()
		let fieldType = try self.parseMemberHeadTypeReference(qualifierDots)
		try self.requireFieldTypeIsFinite(layout.name, fieldName: fieldName, anchor: fieldTypeTok)

		return FieldTypeSpelling.create(fieldType, declaredSurface: declaredSurface, declaredBrand: headName, spelledName: SpelledFieldName.named(headName), typeSite: writtenTypeSiteOf(fieldTypeTok))
	end 'readMemberHeadFieldTypeAt'

	function inferredFieldTypeAt(defaultStart ElementIndex, regionEnd ElementIndex, layout StructLayout, fieldName ByteArray) returns InferredFieldType throws SourceParseError
		if self.defaultRegionIsABoolLiteral(defaultStart, regionEnd: regionEnd) 'aBool'
			return InferredFieldType.create(FieldTypeSpelling.create(MaxonType.boolean, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed), valueEnd: regionEnd)
		end 'aBool'

		if self.defaultRegionIsAStringLiteral(defaultStart, regionEnd: regionEnd) 'aString'
			return InferredFieldType.create(FieldTypeSpelling.create(MaxonType.string, declaredSurface: plainDeclaredSurface(), declaredBrand: EmptySourceText, spelledName: SpelledFieldName.unnamed), valueEnd: regionEnd)
		end 'aString'

		if let castAt = try self.trailingCastIn(defaultStart, regionEnd: regionEnd) 'aCast'
			let target = try self.readWrittenFieldTypeAt(castAt + 1, layout: layout, fieldName: fieldName, voice: BarePrimitiveVoice.asACastTarget)
			try self.requireDefaultValueEnded(regionEnd)
			return InferredFieldType.create(target, valueEnd: castAt)
		end 'aCast'

		if let qualifierDots = try self.memberHeadQualifierDots(defaultStart, regionEnd: regionEnd) 'aMemberHead'
			return InferredFieldType.create(try self.readMemberHeadFieldTypeAt(defaultStart, qualifierDots: qualifierDots, layout: layout, fieldName: fieldName), valueEnd: regionEnd)
		end 'aMemberHead'

		let uninferrableTok = self.tokenAt(defaultStart)
		throw SourceParseError.uninferrableFieldDefault(uninferrableTok.line, column: uninferrableTok.column)
	end 'inferredFieldTypeAt'

	function readInferredFieldDefault(nameTok Token, layout StructLayout, inferred InferredFieldType, defaultStart ElementIndex, defaultEnd ElementIndex, repeatsAField bool) returns FieldDefault throws SourceParseError
		self.pos = defaultStart

		if self.defaultRegionIsLiteral(defaultStart, regionEnd: inferred.valueEnd) 'aLiteral'
			let given = try self.readFieldDefaultLiteral()
			try self.requireFieldDefaultType(nameTok, fieldType: inferred.spelling.fieldType, owner: SlotOwner.declaredBy(layout.name), given: given)
			self.pos = defaultEnd
			return FieldDefault.literal(given)
		end 'aLiteral'

		if repeatsAField 'aRepeatedField'
			self.pos = defaultEnd
			return FieldDefault.none
		end 'aRepeatedField'

		let bareCreate = self.defaultRegionIsAnEmptyCreate(defaultStart, regionEnd: defaultEnd)
		let helperName = self.captureFieldDefault(layout.name, fieldName: nameTok.value, fieldType: inferred.spelling.fieldType, capability: inferred.spelling.capability, regionEnd: defaultEnd)

		return FieldDefault.emptyCreateHelper(helperName) if bareCreate else FieldDefault.helper(helperName)
	end 'readInferredFieldDefault'

	// An annotated field takes no default: `var x as T = e` is E2010 here, pinned by
	// `specs/field-defaults.md`'s `error.annotation-with-default`, and `var x = e as T` is the
	// spelling.
	function requireFieldLineEnd() throws SourceParseError
		if tokenKindEndsALine(self.kindAt(self.pos)) 'fieldComplete'
			return
		end 'fieldComplete'

		let tok = self.current()
		throw SourceParseError.unexpectedToken(TokenKind.newline.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
	end 'requireFieldLineEnd'

	function requireDefaultValueEnded(regionEnd ElementIndex) throws SourceParseError
		if self.pos != regionEnd 'trailingTokens'
			let stray = self.current()
			throw SourceParseError.unexpectedToken("end of default value", got: tokenDisplayText(stray), line: stray.line, column: stray.column)
		end 'trailingTokens'
	end 'requireDefaultValueEnded'

	// A cast binds tighter than every binary operator, so `a + 1 as T` is `a + (1 as T)`: an operator
	// at depth 0 (`tokenKindMayPrecedeAFieldDefaultCast`) means the cast is not the whole default and
	// gives no type.
	function trailingCastIn(start ElementIndex, regionEnd ElementIndex) returns ElementIndex throws AbsentError
		var depth = 0 as NestingDepth
		var castAt = regionEnd
		var q = start

		while q < regionEnd 'scan'
			let kind = self.kindAt(q)

			if tokenKindOpensAGroup(kind) 'opens'
				depth = depth + 1
			end 'opens' else if tokenKindClosesAGroup(kind) 'closes'
				depth = depth - 1
			end 'closes' else if depth == 0 and kind == TokenKind.as 'aCast'
				castAt = q
			end 'aCast' else if depth == 0 and not tokenKindMayPrecedeAFieldDefaultCast(kind, leading: q == start) 'notAnOperandOfACast'
				throw AbsentError.absent
			end 'notAnOperandOfACast'

			q = q + 1
		end 'scan'

		if depth != 0 or castAt == regionEnd or castAt == start or castAt + 1 == regionEnd 'noCastWithAnOperandAndATarget'
			throw AbsentError.absent
		end 'noCastWithAnOperandAndATarget'

		return castAt
	end 'trailingCastIn'

	function memberHeadQualifierDots(start ElementIndex, regionEnd ElementIndex) returns ElementIndex throws AbsentError
		if not self.defaultRegionIsAMemberHead(start, regionEnd: regionEnd) 'notAMemberHead'
			throw AbsentError.absent
		end 'notAMemberHead'

		return (self.dottedChainLengthAt(start) - 1)
	end 'memberHeadQualifierDots'

	function defaultRegionIsAMemberHead(start ElementIndex, regionEnd ElementIndex) returns bool
		let chainDots = self.dottedChainLengthAt(start)

		if chainDots == 0 'noMember'
			return false
		end 'noMember'

		let afterChain = start + chainDots * TokensPerQualifierSegment + 1

		return afterChain == regionEnd or (self.kindAt(afterChain) == TokenKind.leftParen and self.parenGroups.closeOf(self.tokens, open: afterChain) + 1 == regionEnd)
	end 'defaultRegionIsAMemberHead'

	function defaultRegionNamesItsOwnType(start ElementIndex, regionEnd ElementIndex) returns bool
		return self.defaultRegionIsABoolLiteral(start, regionEnd: regionEnd) or self.defaultRegionIsAStringLiteral(start, regionEnd: regionEnd) or self.defaultRegionIsAMemberHead(start, regionEnd: regionEnd)
	end 'defaultRegionNamesItsOwnType'

	function defaultRegionIsABoolLiteral(start ElementIndex, regionEnd ElementIndex) returns bool
		let kind = self.kindAt(start)
		return (kind == TokenKind.true or kind == TokenKind.false) and start + 1 == regionEnd
	end 'defaultRegionIsABoolLiteral'

	function defaultRegionIsAStringLiteral(start ElementIndex, regionEnd ElementIndex) returns bool
		if self.kindAt(start) != TokenKind.stringLiteral 'notAString'
			return false
		end 'notAString'

		let lastFragment = try interpolatedLiteralLastFragment(self.tokens, first: start) otherwise start
		return lastFragment + 1 == regionEnd
	end 'defaultRegionIsAStringLiteral'

	function requireFieldTypeIsFinite(ownerName ByteArray, fieldName ByteArray, anchor Token) throws SourceParseError
		if not self.signatures.allFilesFolded or not self.signatures.fieldTypeGrowsItsOwner(ownerName, fieldName: fieldName) 'nothingGrows'
			return
		end 'nothingGrows'

		throw SourceParseError.genericTypeGrowsWithoutBound(String.from(ownerName), fieldName: String.from(fieldName), typeName: self.signatures.declaredFieldTypeDisplayName(ownerName, fieldName: fieldName), line: anchor.line, column: anchor.column)
	end 'requireFieldTypeIsFinite'

	// ⛔⛔ **A FIELD DECLARED AT A TYPE PARAMETER MAY NOT CARRY A DEFAULT — OF EITHER FORM.**
	// `type Box uses T … var value = <anything> as T` is not a missing feature: a default is produced
	// ONCE, from this type's SHARED body, where `T` is an opaque 8-byte word. No literal and no
	// expression in that body can produce a value OF `T` — the concrete type is not known until an
	// instantiation, and two instantiations may pick different ones — so whatever the default produces
	// is stored into a slot whose real type somebody else decides later.
	//
	// ⚠ **A DEFAULT ON A FIELD DECLARED AT A TYPE PARAMETER IS A MEMORY-SAFETY BUG.** `type Box uses T
	// … var value = makeIt() as T` (returning an `Integer`) instantiated as `Box with String`
	// compiles, and the field read then treats the integer 9 as a String record — an access violation
	// (`0xC0000005`). The LITERAL form (`0 as T`) is the identical fault, which is why the refusal
	// is written here — against the field's declared TYPE, before either default form is read — rather
	// than on the expression arm alone. One rule, one place, both forms.
	//
	// It refuses at the `=`, because the `=` is what has to go: the field itself is perfectly legal, and the
	// cure is either a concrete type or a value supplied at each `Self{…}`.
	//
	// ⚠ Thrown from the SHARED field reader, so the tolerant sweep swallows it (`otherwise break`) and
	// the real parse raises it with a position — `requireUnreservedName`'s arrangement.
	function requireDefaultableFieldType(nameTok Token, equalsTok Token, layout StructLayout, fieldType MaxonType) throws SourceParseError
		if maxonTypeTag(fieldType) != ValueTypeTag.typeParameter 'aConcreteSlot'
			return
		end 'aConcreteSlot'

		let paramName = String.from(self.typeParamDisplayName(typeParamIdOf(fieldType)))
		throw SourceParseError.unsupported("a default value on field '{String.from(nameTok.value)}' of `type {String.from(layout.name)}`, whose declared type is the type parameter '{paramName}' — a default is produced by a function compiled ONCE from this type's shared body, where '{paramName}' is an opaque word, so nothing written there can produce a value of it, and each instantiation may bind it to a different type. Declare the field at a concrete type, or give it a value at every struct literal of '{String.from(layout.name)}'", line: equalsTok.line, column: equalsTok.column)
	end 'requireDefaultableFieldType'

	// ⭐ **IS THE DEFAULT OCCUPYING `[start, regionEnd)` EXACTLY A LITERAL — `5`, `50.0`, `true`, optionally
	// signed — AND NOTHING ELSE?** THE dispatch between a field default's two forms, asked once per
	// defaulted field, before either reader runs. It is a TOKEN-SHAPE test and can be nothing else: the
	// answer decides which of the two doors reads the tokens, so it must be decidable without reading them.
	//
	// ⚠ **THE WHOLE REGION MUST BE THE LITERAL, WHICH IS WHY IT COMPARES AGAINST `regionEnd`.** `= 7 + 1`
	// opens with a literal token and is not one, and taking the literal door on the strength of the first
	// token would consume the `7` and abandon the rest — the exact silent drop this test exists to prevent.
	//
	// ⚠ **A LEADING `-` IS A SIGN, AND ONLY A NUMBER HAS ONE.** `-true` is not a signed literal, it is
	// a negation applied to a bool: an EXPRESSION, which goes to a helper (where it earns the ordinary
	// type error).
	function defaultRegionIsLiteral(start ElementIndex, regionEnd ElementIndex) returns bool
		var q = start
		var signed = false

		if self.kindAt(q) == TokenKind.minus 'sign'
			signed = true
			q = q + 1
		end 'sign'

		let kind = self.kindAt(q)
		let isNumber = kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral
		let isBool = kind == TokenKind.true or kind == TokenKind.false

		if not (isNumber or (isBool and not signed)) 'notALiteralToken'
			return false
		end 'notALiteralToken'

		return q + 1 == regionEnd
	end 'defaultRegionIsLiteral'

	// ⭐⭐ **IS THE DEFAULT EXACTLY AN EMPTY `<Type>.create()` (`create(0)` and `create(0, zeroed: …)` build the
	// same array) — the one expression shape whose RESULT a reader in another file can describe without running
	// it (`FieldDefault.emptyCreateHelper`)?** The `emptyCreateTokenCount` tokens and the region's end, so a
	// nonzero capacity, a receiver or anything trailing answers no.
	//
	// ⚠ **IT ASKS ONLY ABOUT THE TOKENS, and every question about WHAT the name denotes is the reader's.**
	// This walk is shared with the declaration SWEEP, which may not resolve an alias at all: what the shape
	// buys is the guarantee that the value is whatever `create` builds, and the field's own declared type
	// is what says which container that is.
	function defaultRegionIsAnEmptyCreate(start ElementIndex, regionEnd ElementIndex) returns bool
		let length = try emptyCreateTokenCount(self.tokens, start: start) otherwise return false

		return start + length == regionEnd
	end 'defaultRegionIsAnEmptyCreate'

	// Capture one field's `= <expression>` for the drain and leave the cursor at the token that ENDS it, so
	// the field reader resumes exactly as it would have without a default. The cursor arrives just PAST the
	// `=`. It answers the helper's NAME, because the LAYOUT must carry the same bytes
	// (`FieldDefault.helper`) — minted once, here, and handed to both.
	//
	// ⚠ **THE DECLARATION SWEEP CAPTURES TOO, AND THAT IS DELIBERATE RATHER THAN AN OVERSIGHT.**
	// `readStructFieldInto` is SHARED by the tolerant sweep and the real parse (its header says why it must
	// be), and only the real parse ever DRAINS — `parseModule` is the sole drain site, and a Parser used for
	// a sweep never reaches it, so the sweep's captures are discarded with the sweep's Parser. Gating this
	// on "which pass am I?" would put a second answer to that question in this file; the first is
	// `requireFieldDefaultType`'s `allFilesFolded`, and it is about something else entirely (whether the
	// INDEX is complete). The cost is one record per defaulted field on a walk that already builds a
	// `StructLayout` per type.
	function captureFieldDefault(typeName ByteArray, fieldName ByteArray, fieldType MaxonType, capability ParamCapability, regionEnd ElementIndex) returns immutable ByteArray
		let helperName = fieldDefaultHelperName(typeName, fieldName: fieldName)
		self.pendingDefaultHelpers = materializedPendingDefaultHelpers(self.pendingDefaultHelpers, anchor: self.anchors.pendingDefaultHelpers)
		self.pendingDefaultHelpers.push(PendingDefaultHelper.create(DefaultHelperOwner.field(helperName, place: "{String.from(typeName)}.{String.from(fieldName)}", capability: capability), declaredType: fieldType, exprStart: self.pos, exprEnd: regionEnd, enclosingType: self.enclosingType.clone()))
		self.pos = regionEnd
		return helperName
	end 'captureFieldDefault'

	// ⭐ **THE VERDICT ON A FIELD'S LITERAL DEFAULT, ASKED ONLY WHERE IT CAN BE ANSWERED.** `as Integer =
	// 50.0` is the same lossy coercion `var x as Integer` then `x = 50.0` is, so it is the same
	// `requireAssignable` — but the DECLARED type may be a ranged-alias NAME, and a name reads as an
	// INTEGER (`tagIsIntegral`) until the alias registry can resolve it.
	//
	// ⚠ **`allFilesFolded` IS THE GATE**, the same one `checkGenericArgType` sits behind and for the
	// identical reason: during the sweep this index is still being BUILT
	// (`Queries.queryProgramSignatures` hands the sweeper the index it is filling), so an alias that is
	// genuinely a `float(low to high)` reads as undeclared and the verdict is not merely discarded, it is
	// systematically WRONG — `as Weight = 2.5` would be refused as a lossy float→int conversion, which is
	// a rejection of legal code. The sweep is not a validator; the real parse is the only reader that
	// reports, and it is on the far side of the fold, so it resolves the alias and decides.
	function requireFieldDefaultType(nameTok Token, fieldType MaxonType, owner SlotOwner, given ConstValue) throws SourceParseError
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		try self.requireAssignable(nameTok, value: given.tag, valueNameId: UnnamedTypeId, valueBrandId: UnnamedTypeId, declared: self.floatResolvedTag(maxonTypeTag(fieldType), nameId: typeNameIdOf(fieldType)), declaredNameId: typeNameIdOf(fieldType), door: FunctionTypeDoor.field, placeOwner: owner, voice: SlotMismatchVoice.assignedPlace)
	end 'requireFieldDefaultType'

	// The literal a field default is, as the SAME tagged pair a folded top-level constant is — its
	// VALUE and its TAG, off one token, returned together so a caller cannot read one without the
	// other. `constantValueType` turns the tag into the field's declared type, which is the point:
	// shape 2 above derives that type from nothing but this token.
	//
	// It is a `ConstValue` and not a private record because it IS one — payload plus tag — and the
	// tag→`MaxonType` mapping already exists for the other producer of folded literals. A second
	// pair would have been a second answer to "what type is an integer literal".
	//
	// ⭐ **TYPE INFERENCE HERE IS A TOKEN-KIND LOOKUP, NOT CONSTANT EVALUATION**, and it has to be: the
	// type must be known when `ProgramSignatures.recordStruct` hashes the layout, and that runs inside
	// the declaration SWEEP — before `evaluateInitializers` has folded a single constant. A token kind
	// is available at scan time; a constant's value is not.
	//
	// The three literal DECODERS are the emitting path's own (`intLiteralValue`, `__float_bitsFromText`,
	// `BoolTrueValue`): a field default must read a literal exactly as a function body reads it.
	// ⚠ **ITS PRECONDITION IS `defaultRegionIsLiteral`, AND THE FINAL PANIC IS WHAT SAYS SO.** Both callers
	// ask that question first, because the ANSWER decides which door reads the tokens at all; reaching the
	// bottom of this function means the classifier and the reader disagree about what a literal is, which is
	// a compiler defect and not a program the source can write.
	function readFieldDefaultLiteral() returns ConstValue throws SourceParseError
		let negated = self.at(TokenKind.minus)

		if negated 'signed'
			self.advance()
		end 'signed'

		if self.at(TokenKind.intLiteral) 'intLit'
			let tok = try self.consume(TokenKind.intLiteral)

			// The written-negative mark a body's `-<intLiteral>` carries (`ConstValue.writtenNegative`): a
			// default flows into the field's declared range at every struct literal that omits it, so it meets
			// the same door and owes the same fact.
			let value = try self.intLiteralValue(tok, negated: negated)
			return ConstValue.ofIntLiteral(value, negated: negated)
		end 'intLit'

		if self.at(TokenKind.floatLiteral) 'floatLit'
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try self.floatLiteralBits(tok)
			return ConstValue.create(negatedFloatBits(bits) if negated else bits, tag: ValueTypeTag.float)
		end 'floatLit'

		// `= true` / `= false`. It cannot be NEGATED here — `defaultRegionIsLiteral` refuses a signed bool
		// as the expression it is — so no second refusal is written for it.
		if self.at(TokenKind.true) or self.at(TokenKind.false) 'boolLit'
			let isTrue = self.at(TokenKind.true)
			self.advance()
			return ConstValue.create(BoolTrueValue if isTrue else BoolFalseValue, tag: ValueTypeTag.boolean)
		end 'boolLit'

		panic("readFieldDefaultLiteral: the default at token {self.pos} is not a literal, but `defaultRegionIsLiteral` said it was — the classifier that routes a field default and the reader that decodes it have come apart on which token kinds a literal is")
	end 'readFieldDefaultLiteral'

	// Advance past a balanced `( … )` starting at the cursor. Returns false — leaving the
	// cursor where it was — when the token stream does not hold one, which the real parse will report
	// properly.
	function skipBalancedParens() returns bool
		if not self.at(TokenKind.leftParen) 'noParen'
			return false
		end 'noParen'

		let closeIndex = self.parenGroups.closeOf(self.tokens, open: self.pos)

		// An unterminated group answers the EOF index, so this test is exact rather than a proxy: on a
		// match the answer IS the `)`, and the cursor lands one past it.
		if self.kindAt(closeIndex) != TokenKind.rightParen 'unbalanced'
			return false
		end 'unbalanced'

		self.pos = closeIndex + 1
		return true
	end 'skipBalancedParens'

	function readFunctionTypeParams() returns immutable NameRoster throws SourceParseError
		try self.consume(TokenKind.uses)
		let names = self.readUsesNames()

		if names.isEmpty() 'noTypeParameterNamed'
			try self.consume(TokenKind.identifier)
			panic("readFunctionTypeParams: the cursor is not on an identifier, so consuming one throws")
		end 'noTypeParameterNamed'

		return names
	end 'readFunctionTypeParams'

	// One top-level declaration: an optional `export`, then a `function`, a `typealias` in any of its
	// three forms, a `type`, an `enum`, a `union`, an `interface`, an `extension`, or a `let`/`var` binding.
	// Anything else is rejected with a positioned error.
	//
	// ⭐ **`visibility` IS LOAD-BEARING FOR A TYPEALIAS TOO.** It decides two things, and neither could be
	// answered without it:
	//
	//   • **REACHABILITY** — a non-exported alias is invisible to a file outside its directory's subtree,
	//     which `export-keyword/error.non-exported-typealias-cross-file` pins as E3008 at the cast target.
	//     A stdlib alias is nameable from a program by the `public` it carries, so the visibility test has
	//     no special case in it at all.
	//   • **WHETHER AN UNUSED ALIAS CAN BE REPORTED** — an exported one cannot (E3062,
	//     `reportUnusedTypeAliases`).
	//
	// It reaches the ranged registry through `readTypeAliasDeclaration` and the E3062 candidate list
	// through `recordTypeName`, from this one local — so the two records cannot come to disagree about
	// what the source wrote.
	//
	// A `type`'s visibility RIDES ITS LAYOUT. Dropping it here would make every declared type nameable from
	// every file whatever it wrote, because `project.structTypes` is whole-program. Its METHODS each carry
	// their own, read at the member (see `parseTypeMember`), because that is where the source writes it.
	function dispatchTopLevel() throws SourceParseError
		let visibility = try self.consumeOptionalVisibility()

		// ⭐ **THE ONE PLACE THAT SEES ALL FIVE TYPE-MINTING KEYWORDS**, which is why the type-name
		// declaration record is taken here and not inside each of the five parsers: the record's whole
		// value is that its ORDER is the file's source order ACROSS kinds, and no per-kind site can
		// know that. The name token sits one past the keyword in every one of the five grammars, so its
		// INDEX is captured before the dispatch (each of those parsers leaves the cursor past its own
		// `end`) and the token itself is fetched only on the paths that record one — a `function` or a
		// `let` pays a scalar add and nothing else. The record is pushed only if the declaration
		// PARSED: a malformed one is the SourceParseError's, and must not claim a name.
		let nameIndex = self.pos + 1

		if self.at(TokenKind.function) 'isFunction'
			// A FILE-scope function takes no receiver: there is no enclosing type for one to be.
			try self.parseFunction(visibility, takesReceiver: false, form: DeclaredHeadForm.declaredFunction)
		end 'isFunction' else if testDeclarationAt(self.tokens, index: self.pos) 'isTest'
			// ⭐ **THE DECLARATION POSITION HALF OF `test`'s CONTEXTUAL RULE, and this arm IS that half.**
			// `testDeclarationAt` asks only about the two tokens; standing here is what says the cursor is
			// somewhere a declaration may begin, which is the other half and the one that tells `test 'x'`
			// apart from `match test 'check'`. It takes no receiver for a file-scope function's reason, and
			// it mints no type name — a test declares a FUNCTION, so there is no `recordTypeName`.
			try self.parseFunction(visibility, takesReceiver: false, form: DeclaredHeadForm.testDeclaration)
		end 'isTest' else if self.at(TokenKind.typealias) 'isTypeAlias'
			let form = try self.readTypeAliasDeclaration(self.artifact.typeAliases, functionOut: self.artifact.functionTypeAliases, genericOut: GenericAliasSink.discard, tupleOwner: TupleAliasOwner.fileScope, recordFunctionSignature: true, visibility: visibility)
			self.recordTypeName(nameIndex, kind: form, visibility: visibility)
		end 'isTypeAlias' else if self.at(TokenKind.type) 'isTypeDecl'
			try self.parseTypeDeclaration(visibility)
			self.recordTypeName(nameIndex, kind: TypeDeclKind.structType, visibility: visibility)
		end 'isTypeDecl' else if self.at(TokenKind.enum) or self.at(TokenKind.union) 'isEnumDecl'
			let isUnion = self.at(TokenKind.union)
			try self.parseEnumDeclaration(isUnion, visibility: visibility)
			self.recordTypeName(nameIndex, kind: TypeDeclKind.unionType if isUnion else TypeDeclKind.enumType, visibility: visibility)
		end 'isEnumDecl' else if self.at(TokenKind.interface) 'isInterfaceDecl'
			try self.parseInterfaceDeclaration()
			self.recordTypeName(nameIndex, kind: TypeDeclKind.interfaceType, visibility: visibility)
		end 'isInterfaceDecl' else if self.at(TokenKind.extension) 'isExtensionDecl'
			// It mints NO type name, so no `recordTypeName` — an extension names nothing, it adds methods to
			// types other declarations named. See `parseExtensionDeclaration`.
			try self.parseExtensionDeclaration()
		end 'isExtensionDecl' else if self.atTopLevelBindingKeyword() 'isBinding'
			// The declaration EMITS NOTHING — for a `var` exactly as for a `let`. A constant inlines at
			// every read; a var's slot is laid down by the backend from the arena
			// (`ProgramSignatures.declaredGlobals`), and its every read and write is emitted at the USE
			// site. So there is nothing for the real parse to build here either way, only something for
			// it to REPORT.
			let decl = try self.readTopLevelBinding(visibility, qualifier: EnclosingTypeScope.fileScope)
			try self.raiseBindingFailure(decl)
		end 'isBinding' else if defaultDeclarationAt(self.tokens, index: self.pos) 'isDefault'
			try self.parseDefaultDeclaration()
		end 'isDefault' else 'notADeclaration'
			let tok = self.current()
			throw SourceParseError.expectedDeclaration(tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notADeclaration'
	end 'dispatchTopLevel'

	// File the type name a top-level declaration just minted, for the whole-program duplicate check
	// `commitTypeNameDecls` makes at the merge. The position is the NAME token's — the collision blames
	// the declaration the author wrote, never the keyword and never the incumbent. Takes the token's
	// INDEX rather than the token, because the cursor has already moved past the declaration by the
	// time this is called and `dispatchTopLevel` must not pay for a token it may never record.
	// It ALSO enrols a non-exported typealias as an E3062 candidate, because this is the one site that
	// holds all three facts at once — the name token, the FORM (only a `typealias` is a candidate;
	// `isTypeAliasDecl` is the one place that classification lives), and the visibility the source
	// wrote. Splitting it out would mean fetching the same token twice off the same index.
	//
	// ⚠ **`visibility` TRAVELS ON THE RECORD.** Reading it for the E3062 candidate list below and then
	// dropping it makes the whole-program duplicate check visibility-blind BY CONSTRUCTION — an unexported
	// alias, reachable from one directory's subtree, refused as a duplicate of a declaration in a file that
	// could never name it. It is the modifier the source wrote, for every layer.
	//
	// ⚠ Only a TOP-LEVEL alias is a candidate. A nested one (`typealias Idx = …` inside a `type` body)
	// never reaches here — `parseTypeMember` reads it — and it is deliberately not enrolled elsewhere:
	// it is a member of a type, not a declaration of a file, and its uses are the type's.
	function recordTypeName(nameIndex ElementIndex, kind TypeDeclKind, visibility Visibility)
		let nameTok = self.tokenAt(nameIndex)
		self.artifact.typeNameDecls.push(TypeNameDecl.create(nameTok.value, claim: TypeNameClaim.create(kind, declFilePath: self.job.path, visibility: visibility, declaredByTheCorpus: self.job.isStdlibSource), nameLine: nameTok.line, nameColumn: nameTok.column))

		// ⚠ The library declares no candidate: "is this alias used?" would be answered by WHICH PROGRAM is
		// being compiled, and a per-file check whose answer moves with the caller is not a check. The same
		// three library aliases are clean when the compiler is the program and a finding when a one-file
		// user program is.
		if self.job.isStdlibSource or self.job.isRuntimeSource or not isTypeAliasDecl(kind) or visibility != Visibility.unexported 'notAnUnusedCandidate'
			return
		end 'notAnUnusedCandidate'

		let recorded = self.declaredTypeAliasesForWrite()
		recorded.push(DeferredNameDiagnostic.create(nameTok.value, filePath: self.job.path, line: nameTok.line, column: nameTok.column))
	end 'recordTypeName'

	// ⭐ **RECORD THAT THIS FILE WROTE A TYPE NAME IN A TYPE POSITION — the E3062 "used" half.**
	//
	// ⚠ **THE RULE IS A LITERAL NAME IN A TYPE POSITION, AND NOTHING ELSE.** In particular, being
	// IMPLICITLY INFERABLE is not a use: a bare `[1, 2, 3]` literal in a file that declares `typealias
	// IntArray = Array with Integer` COULD be inferred as that alias, and the alias is still reported
	// unused, because implicit binding masks real unused-typealias mistakes.
	// `arrays/error.unused-array-typealias` pins exactly that program.
	//
	// ⭐ **THREE SITES, and they are three because that is how many DOORS there are, not because a list
	// was drawn up.** Hand-maintained call sites scattered through the parser are a completeness risk
	// — a new type position silently forgets to mark — so a use is recorded where a name is RESOLVED:
	//
	//   1. `parseTypeReference` — the ONE type-reference parser, reached by every parameter type, return
	//      type, field and payload type, generic type ARGUMENT, function-alias signature, `sizeof(T)`
	//      operand and body `as` cast target. Ten call sites, one hook.
	//   2. `parseQualifiedCall` — `IntArray.create()`. A generic-instance alias is very often named ONLY
	//      here, and this base name is a raw token that never reaches (1).
	//   3. A TYPE NAME A TOP-LEVEL INITIALIZER WRITES, met by an initializer parser (`initializerRole` not
	//      `ordinary`) — filed program-wide (`ProgramSignatures.namesTypeInConstInitializer`), because
	//      that parser's artifact is discarded and it runs before the declaring file is parsed.
	//
	// It takes NAMES indiscriminately — a struct name, an interface name, a type parameter — because a
	// recording site does not know what a written name denotes and must not have to ask. The filtering
	// happens at `reportUnusedTypeAliases`, against this file's own declarations, and again at the merge
	// against the whole program's (`ParseStaging.commitWrittenTypeNames`).
	function recordTypeNameUse(name ByteArray)
		if self.job.initializerRole != InitializerRole.ordinary 'aConstantInitializer'
			self.signatures.recordConstInitializerTypeName(name, declFilePath: self.job.path)
			return
		end 'aConstantInitializer'

		if not self.isTheReportingWalk 'notTheReportingWalk'
			return
		end 'notTheReportingWalk'

		self.memos.usedTypeNames.insert(self.innerAliasKeyOrName(name))
	end 'recordTypeNameUse'

	function requireInnerAliasNameable(qualifiedInner ByteArray, written ByteArray, anchor Token) throws SourceParseError
		if not self.signatures.allFilesFolded 'theSweepHoldsNoDeclarationYet'
			return
		end 'theSweepHoldsNoDeclarationYet'

		try self.requireTypeNameVerdictNameable(typeNameVerdictOf(self.signatures.innerAliasHidingFrom(qualifiedInner, readerFilePath: self.job.path), noun: written, anchor: anchor))
	end 'requireInnerAliasNameable'

	function innerAliasKeyOrName(name immutable ByteArray) returns immutable ByteArray
		if self.namesInnerAliasHere(name) or self.namesThisBodysNestedFunctionAlias(name) 'aBodysInnerAlias'
			return self.innerAliasKey(name)
		end 'aBodysInnerAlias'

		return name
	end 'innerAliasKeyOrName'

	// Recorded under the name as WRITTEN: the unused-alias check (E3062) asks about that name, not
	// about the family the base resolved to.
	function recordBaseTypeNameUse(baseIndex ElementIndex, resolved Token)
		let written = self.tokenAt(baseIndex)

		if written.kind == TokenKind.identifier and not self.qualifiedTypeBaseIsAt(baseIndex) 'aWrittenName'
			self.recordTypeNameUse(written.value)
			return
		end 'aWrittenName'

		self.recordTypeNameUse(resolved.value)
	end 'recordBaseTypeNameUse'

	function recordQualifiedTypeNameUse(name ByteArray)
		match splitQualifiedName(name) 'member'
			notQualified then self.recordTypeNameUse(name)
			parts(_, member) then self.recordQualifiedAndMemberTypeName(name, member: member)
		end 'member'
	end 'recordQualifiedTypeNameUse'

	function recordQualifiedAndMemberTypeName(qualified ByteArray, member ByteArray)
		if not self.signatures.namesAnInnerAliasOfAnyForm(qualified) 'aDirectoryQualifiedMember'
			self.recordTypeNameUse(member)
		end 'aDirectoryQualifiedMember'

		self.recordTypeNameUse(qualified)
	end 'recordQualifiedAndMemberTypeName'

	// ⭐ **A TYPE THIS FILE REACHED INTO — `recordTypeNameUse`'s twin for the fact a written name cannot
	// carry.** Two call sites, one per family of reach and each stating its own rule: `requireFieldAccessible`
	// (a struct's field) and `emitEnumDispatchKey` (an enum's or union's tag). The copy-on-write shape and the
	// `isTheReportingWalk` gate are its twin's, for its twin's reason — `parseModule` is the only walk whose
	// artifact anyone reads these sets off, so any other one would hash into a set it discards.
	// Sharing ONE empty singleton with `usedTypeNames` is deliberate: the seed is an identity test, so a
	// second empty of the same type would be a fact to remember rather than one to derive.
	function recordMemberAccessedTypeName(name ByteArray)
		if not self.isTheReportingWalk 'notTheReportingWalk'
			return
		end 'notTheReportingWalk'

		self.memos.memberAccessedTypeNames.insert(name)
	end 'recordMemberAccessedTypeName'

	// ⭐ **E3062 CANDIDATES, ONCE PER FILE, AT THE END OF ITS PARSE** — every non-exported top-level
	// typealias whose name this file never wrote in a type position, in DECLARATION order.
	//
	// The report is not made here: it is recorded and drained after every file is parsed, for the
	// ordering reason `DeferredNameDiagnostic`'s header states in full. The drain credits a candidate
	// another file of its subtree names (`ParseStaging.commitWrittenTypeNames`).
	//
	// ⚠ An EXPORTED alias is exempt. The exemption is applied at `recordTypeName`, so an exported
	// alias is never even a candidate.
	function reportUnusedTypeAliases()
		match self.declaredTypeAliases 'walk'
			unwritten then return
			entries(recorded) then self.reportEachUnusedTypeAlias(recorded)
		end 'walk'
	end 'reportUnusedTypeAliases'

	// The walk behind the door above — its own function because a `match` arm may not open a `for`, and a
	// file that declared no candidate never reaches it.
	function reportEachUnusedTypeAlias(recorded DeferredNameDiagnosticArray)
		for candidate in recorded 'each'
			if self.memos.usedTypeNames.contains(candidate.name) 'usedInABody'
				continue
			end 'usedInABody'

			// The third door, asked SECOND because it costs a composite key where the set above costs a
			// hash of bytes already in hand — and asked once per unexported alias DECLARED, which is
			// the smallest population any of the three is asked of.
			if self.signatures.namesTypeInConstInitializer(candidate.name, declFilePath: self.job.path) 'usedByAConstant'
				continue
			end 'usedByAConstant'

			self.artifact.recordUnusedTypeAlias(candidate)
		end 'each'
	end 'reportEachUnusedTypeAlias'

	// ⭐ A TOP-LEVEL `let` IS A COMPILE-TIME CONSTANT, AND THE DECLARATION IS WHERE ITS DIAGNOSTIC
	// LANDS — but not where its VALUE is computed.
	//
	// The declaration itself emits NO op and reserves NO storage. The whole-program sweep already
	// folded this initializer to a number (`ProgramSignatures.evaluateInitializers`), and every USE
	// inlines that number as an ordinary `literal` (`readFoldedConstant`). So there is nothing
	// left for the real parse to build — only something for it to REPORT, if the fold failed.
	//
	// That split is why the value is not simply computed here: this file's parse can see this file's
	// initializer, and neither a forward reference (`let TOTAL = FIRST + SECOND` above `FIRST`) nor a
	// cross-file `export let` is visible to it. Both are ordinary in the corpus, so the fold has to
	// happen where every declaration is already in view, and that is the sweep.
	//
	// A DECL WHOSE FOLD FAILED IS REPORTED HERE, AND EXACTLY ONCE. `poisoned` is silent on purpose —
	// its defect belongs to another declaration, which reports it (see `TopLevelConstant.poisoned`).
	//
	// `declaredOutcome` carries the DRIFT GUARD: a `let` the real parse dispatches at top
	// level must be one the sweep recorded, and a miss panics rather than compiling.
	function raiseBindingFailure(decl TopLevelDecl) throws SourceParseError
		let key = positionKey(decl.nameLine, column: decl.nameColumn)

		if self.abandonedRegions.contains(key) 'abandoned'
			return
		end 'abandoned'

		let confinement = try self.confine(RegionKind.binding) otherwise 'unconfined'
			try self.reportBindingFailure(decl)
			return
		end 'unconfined'

		let extentEnd = self.tokenAt(decl.initEnd)
		let enclosing = self.enterRegion(AbandonableRegion.binding(key, extentEnd: positionKey(extentEnd.line, column: extentEnd.column)))

		try self.reportBindingFailure(decl) otherwise (refusal) 'refused'
			try self.recoverRegion(refusal, confinement: confinement)
			return
		end 'refused'

		self.openRegion = enclosing
	end 'raiseBindingFailure'

	function reportBindingFailure(decl TopLevelDecl) throws SourceParseError
		try self.requireInitializerNamesNoRegistry(decl)

		// A REDECLARATION is reported HERE, at the declaration its key does not hold — the top-level twin
		// of the duplicate-FUNCTION E3006 `commitFuncSignatures` raises. Checked BEFORE the outcome match
		// because a duplicate is an error independent of whether the held declaration's initializer
		// also failed: that failure reports at the held declaration's own statement, this at the other.
		if self.signatures.isRedeclaredBinding(decl) 'redeclared'
			throw SourceParseError.duplicateTopLevelDeclaration(String.from(decl.name), incumbentKeyword: BindingKeyword, line: decl.nameLine, column: decl.nameColumn)
		end 'redeclared'

		// ⚠ The outcome is bound to a local before the match, and the payload is thrown from
		// `throwRecordedConstantError` rather than from the arm. Neither is style: matching the call
		// directly and throwing the arm's binding crashes the compiled compiler with
		// `mm_incref called with NULL pointer`, because the temporary scrutinee's box is dropped while
		// the payload it lent out is still in flight.
		let outcome = self.signatures.declaredOutcome(decl)

		match outcome 'outcome'
			// Nothing a top-level binding can fold to is unstorable: a scalar occupies its `.data` slot as a
			// value, a managed one as a pointer `__module_init` fills before `main`. `globalStdType` is the
			// one home of that enumeration.
			storedRecord(valueType, _, _, _) then try self.parseGlobalInitializer(decl, valueType: valueType)
			value or
			poisoned or
			managedValue or
			imagedRecord or
			imagedBox then break
			failed(error) then try self.reportRecordedConstantError(error)
			unvalidatedRecord then try self.parseGlobalInitializer(decl, valueType: MaxonType.unresolved)
			deferredRecord or
			pending or
			evaluating then panic("Parser.reportBindingFailure: top-level binding '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`, before any file is parsed")
		end 'outcome'
	end 'reportBindingFailure'

	function parseGlobalInitializer(decl TopLevelDecl, valueType MaxonType) throws SourceParseError
		let resume = self.pos
		let name = self.signatures.initializerFunctionNameOf(decl)
		self.statement.initializerBinding = decl.name.clone()
		self.statement.initializerClosureHost = self.signatures.initializerClosureHostOf(decl)
		self.pos = decl.initStart
		let anchor = self.current()
		let unresolved = maxonTypeTag(valueType) == ValueTypeTag.unresolved
		let returnType = MaxonReturnType.void if unresolved else MaxonReturnType.value(self.signatures.adoptType(valueType, into: self.artifact.typeNames))

		let initializer = self.openSynthesizedNullaryBody(name, returnType: returnType, anchor: anchor, visibility: Visibility.global)
		let entry = self.bodyState.currentBlock

		if not self.job.buildsBodies 'bodyNotReached'
			initializer.bodyStatus = BodyStatus.skippedAsUnreached
			self.artifact.unbuiltBodies.push(UnbuiltBody.create(decl.initStart, limit: decl.initEnd))
			self.emitBodyTerminator(entry, op: MaxonOp.retVoid, range: SourceRange.ofToken(anchor))
		end 'bodyNotReached' else 'bodyReached'
			if unresolved 'anUnresolvedInitializer'
				_ = try self.parseExpression(initializer, block: entry)
				self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.retVoid, range: SourceRange.ofToken(anchor))
			end 'anUnresolvedInitializer' else 'aResolvedInitializer'
				try self.parseCheckedValueReturn(initializer, block: entry, anchor: anchor)
			end 'aResolvedInitializer'

			try self.requireInitializerEnded(decl)
		end 'bodyReached'

		self.publishExistentialInstances(initializer)
		initializer.valueMintedSole = self.mintedSoleColumn()
		self.publishDebugLocals(initializer)
		self.artifact.recordFuncSignature(name, signature: FuncSignature.create(NameRoster.create(0), paramTypes: MaxonTypeArray.create(0), paramAggregateNames: NameRoster.create(0), paramDeclaredNames: NameRoster.create(0), returnAggregateName: self.erasedAggregateNameOfReturn(returnType), returnBrand: EmptySourceText, paramExistentialSites: ParamExistentialSiteArray.create(0), returnExistentialSites: GenericInstanceIdArray.create(0), extensionConstraints: WhereConstraintArray.create(0), writtenTypeNames: WrittenTypeNames.none(), selfSpelledParams: NoParamPositions, offeredResultAlias: EmptySourceText, byRefParams: NoParamPositions), returnType: returnType, nameLine: anchor.line, nameColumn: anchor.column, sourceFilePath: self.job.path, synthesized: true)
		self.commitRangeChecks(name)
		self.pos = resume
	end 'parseGlobalInitializer'

	function requireInitializerNamesNoRegistry(decl TopLevelDecl) throws SourceParseError
		if not self.signatures.declaresADefault() 'noRegistryToReach'
			return
		end 'noRegistryToReach'

		for i in decl.initStart upto decl.initEnd 'eachToken'
			if not self.registryCallAt(i as ElementIndex) 'notARegistryCall'
				continue
			end 'notARegistryCall'

			let keyTok = self.tokenAt(i as ElementIndex)
			throw SourceParseError.registryRefused(ErrorCode.registryReachedFromGlobalInitializer, explanation: registryReachedFromInitializerMessage(keyTok.value, member: self.tokenAt(i + 2).value, globalName: decl.name), line: keyTok.line, column: keyTok.column, note: DiagnosticNote.none)
		end 'eachToken'
	end 'requireInitializerNamesNoRegistry'

	function requireNoRegistryMemberOnAKey(nameTok Token, takesReceiver bool) throws SourceParseError
		if takesReceiver or not self.enclosingType.isType() or not self.signatures.declaresADefault() or not registryMemberIsNamed(nameTok.value) 'notAKeysRegistryMember'
			return
		end 'notAKeysRegistryMember'

		let declaration = try self.signatures.winningDefaultOf(self.enclosingTypeName()) otherwise return
		let key = String.from(self.enclosingTypeName())
		throw SourceParseError.registryRefused(ErrorCode.registryKeyDeclaresARegistryMember, explanation: "`{key}` is a `default` key, so `{key}.{String.from(RegistryCurrentMemberName)}` and `{key}.{String.from(RegistryRegisterMemberName)}` are the registry's — its own static `{String.from(nameTok.value)}` would be hidden; rename it", line: nameTok.line, column: nameTok.column, note: DiagnosticNote.at("the `default` for `{key}`", line: declaration.keyLine, column: declaration.keyColumn, filePath: declaration.declFilePath))
	end 'requireNoRegistryMemberOnAKey'

	function registryCallAt(index ElementIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier or self.kindAt(index + 1) != TokenKind.dot or self.kindAt(index + 3) != TokenKind.leftParen 'notTheShape'
			return false
		end 'notTheShape'

		if index > 0 and self.kindAt(index - 1) == TokenKind.dot 'aMemberOfSomethingElse'
			return false
		end 'aMemberOfSomethingElse'

		return registryMemberIsNamed(self.tokenAt(index + 2).value) and self.signatures.declaresDefaultFor(self.tokenAt(index).value)
	end 'registryCallAt'

	function parseDefaultDeclaration() throws SourceParseError
		let declaration = defaultDeclarationFrom(self.tokens, index: self.pos, path: self.job.path, isStdlibSource: self.job.isStdlibSource)
		let keyTok = self.tokenAt(self.pos + 1)

		if let kept = try self.signatures.keptDefaultBeside(declaration) 'declaredTwice'
			throw SourceParseError.registryRefused(ErrorCode.registryDuplicateDefault, explanation: "two `default` declarations for `{String.from(declaration.key)}` in one program — delete one of them", line: keyTok.line, column: keyTok.column, note: DiagnosticNote.at("the other `default` for `{String.from(declaration.key)}`", line: kept.keyLine, column: kept.keyColumn, filePath: kept.declFilePath))
		end 'declaredTwice'

		let returnType = try self.defaultKeyValueType(declaration, keyTok: keyTok)

		if not (self.signatures.defaultKeyIsLive(declaration.key) and self.signatures.defaultDeclarationWins(declaration)) 'nothingBuildsIt'
			self.pos = declaration.exprEnd
			return
		end 'nothingBuildsIt'

		try self.parseDefaultInitializer(declaration, returnType: returnType)
	end 'parseDefaultDeclaration'

	function defaultKeyValueType(declaration DefaultDeclaration, keyTok Token) returns MaxonType throws SourceParseError
		if self.signatures.defaultKeyIsAService(declaration.key) 'aServiceKey'
			try self.requireDefaultSpawnsAnImplementer(declaration, keyTok: keyTok)
			return MaxonType.structRef(self.artifact.typeNames.intern(serviceHandleCompanionName(declaration.key)))
		end 'aServiceKey'

		if not self.signatures.containsStructFor(declaration.key, readerFilePath: self.job.path) 'namesNoType'
			throw SourceParseError.unknownTypeName(self.signatures.aliasIdentityDisplay(declaration.key), line: keyTok.line, column: keyTok.column)
		end 'namesNoType'

		try self.requireShareableRegistryValue(declaration.key, anchor: keyTok)
		return MaxonType.structRef(self.artifact.typeNames.intern(declaration.key))
	end 'defaultKeyValueType'

	function requireDefaultSpawnsAnImplementer(declaration DefaultDeclaration, keyTok Token) throws SourceParseError
		let spawnTok = self.tokenAt(declaration.exprStart)
		let targetIndex = spawnTargetIndexIn(self.tokens, spawnIndex: declaration.exprStart)

		if not tokenIsTheSpawnKeyword(spawnTok) or self.dottedChainLengthAt(targetIndex) == 0 or not self.chainCallFollowsAt(targetIndex) 'buildsNoService'
			throw SourceParseError.registryRefused(ErrorCode.registryDefaultServiceDoesNotImplementKey, explanation: "the `default` for `{String.from(declaration.key)}` builds no service — `{String.from(declaration.key)}` is an interface, so its default must `spawn` a type that implements it", line: keyTok.line, column: keyTok.column, note: DiagnosticNote.none)
		end 'buildsNoService'

		let spawnedType = (try self.spawnedTypeAt(targetIndex, spawnTok: spawnTok)).typeName()

		if self.signatures.typeImplementsInterface(spawnedType, interfaceName: declaration.key) and self.signatures.isInterfaceHandle(serviceHandleCompanionName(declaration.key)) 'implementsIt'
			return
		end 'implementsIt'

		throw SourceParseError.registryRefused(ErrorCode.registryDefaultServiceDoesNotImplementKey, explanation: "the `default` for `{String.from(declaration.key)}` spawns `{String.from(spawnedType)}`, which does not implement `{String.from(declaration.key)}` — declare `type {String.from(spawnedType)} implements {String.from(declaration.key)}`, or spawn a type that does", line: keyTok.line, column: keyTok.column, note: DiagnosticNote.none)
	end 'requireDefaultSpawnsAnImplementer'

	function requireShareableRegistryValue(typeName ByteArray, anchor Token) throws SourceParseError
		try self.requireRegistryValueDeclared(typeName, anchor: anchor)

		let subject = transferSubjectOf(ValueTypeTag.structRef, nameId: self.artifact.typeNames.intern(typeName), typeNames: self.artifact.typeNames)

		match self.signatures.transferWalkOf(subject, kind: TransferKind.share, readerFilePath: self.job.path) 'walk'
			closed or
			walkedBy or
			walkedThroughWitness then return
			refused(noun) then throw self.unshareableRegistryValueError(typeName, reason: "it is {noun}", anchor: anchor)
		end 'walk'
	end 'requireShareableRegistryValue'

	function requireShareableSharedValue(aliasName ByteArray, baseTok Token) throws SourceParseError
		let element = self.sharedValueElementType(self.signatures.genericAliasInstanceFrom(aliasName, readerFilePath: self.job.path))

		let tag = maxonTypeTag(element)

		if tagIsByteRecord(tag) or not self.signatures.typeIsManagedFor(element, from: self.artifact.typeNames, readerFilePath: self.job.path) 'anImmutableWordOrString'
			return
		end 'anImmutableWordOrString'

		if tagNamesADeclaredType(tag) or tag == ValueTypeTag.named 'aNamedType'
			let name = self.internedName(typeNameIdOf(element))

			if self.signatures.containsStructFor(name, readerFilePath: self.job.path) 'aRecord'
				try self.requireShareableRegistryValue(name, anchor: baseTok)
				return
			end 'aRecord'

			if self.signatures.isAnyServiceHandle(name) 'aHandle'
				return
			end 'aHandle'
		end 'aNamedType'

		throw self.unshareableRegistryValueError(self.displayTypeNameOf(tag, nameId: typeNameIdOf(element)).toByteArray(), reason: "it is neither a record, a `String`, a handle nor a scalar", anchor: baseTok)
	end 'requireShareableSharedValue'

	function requireRegistryValueDeclared(typeName ByteArray, anchor Token) throws SourceParseError
		match self.signatures.structFor(typeName, readerFilePath: self.job.path) 'declared'
			declared then return
			undeclared then throw SourceParseError.unknownTypeName(self.signatures.aliasIdentityDisplay(typeName), line: anchor.line, column: anchor.column)
		end 'declared'
	end 'requireRegistryValueDeclared'

	function unshareableRegistryValueError(typeName ByteArray, reason String, anchor Token) returns SourceParseError
		return SourceParseError.registryRefused(ErrorCode.registryValueNotShareable, explanation: "`{String.from(typeName)}` cannot be a registry value or a `SharedValue`: {reason} — a shared value is read by every thread at once, so a share walk must be able to mark everything it reaches", line: anchor.line, column: anchor.column, note: DiagnosticNote.none)
	end 'unshareableRegistryValueError'

	function parseDefaultInitializer(declaration DefaultDeclaration, returnType MaxonType) throws SourceParseError
		let name = defaultInitializerName(declaration.key)
		self.pos = declaration.exprStart
		let anchor = self.current()
		let declaredReturn = MaxonReturnType.value(returnType)

		self.beginDeclaredBody(0, returnSpelling: EmptySourceText, returnBrand: EmptySourceText, returnAlias: self.anchors.undeclaredAlias, paramSites: RangeCheckParamSiteArray.create(0), layoutParam: HiddenWordParam.none, countParam: HiddenWordParam.none, nascentSelfFactory: false, kind: EnclosingBodyKind.declaredFunction, witnessParamBase: 0, witnessParamCount: 0)

		let initializer = IrFunction.create(name, maxonReturnType: declaredReturn, paramCount: 0, maxonParamTypes: MaxonTypeArray.create(0), typeSites: self.anchors.functions.noTypeSites, valueTags: self.bodyState.valueTags, valueNameIds: self.bodyState.valueNameIds, valueBrandIds: self.bodyState.valueBrandIds, valueCapabilities: self.bodyState.valueCapabilities, valueMintedSole: self.anchors.functions.mintedSole, valueWitnessIds: self.bodyState.valueWitnessIds, declaredAt: SourcePosition.declaredAt(self.job.path, nameTok: anchor), placeholders: self.anchors.functions, throwsTypeName: ThrowsClause.none)
		initializer.visibility = Visibility.global

		let initializerIndex = self.artifact.module.funcCount()
		self.artifact.module.pushFunc(initializer)
		self.artifact.currentFuncIndex = initializerIndex

		let entry = self.artifact.module.addBlock(initializer, label: b"entry", heat: BlockHeat.normal)
		self.bodyState.currentBlock = entry

		try self.parseCheckedValueReturn(initializer, block: entry, anchor: anchor)

		try self.requireDefaultValueEnded(declaration.exprEnd)

		self.publishExistentialInstances(initializer)
		initializer.valueMintedSole = self.mintedSoleColumn()
		self.publishDebugLocals(initializer)
		self.artifact.recordFuncSignature(name, signature: FuncSignature.create(NameRoster.create(0), paramTypes: MaxonTypeArray.create(0), paramAggregateNames: NameRoster.create(0), paramDeclaredNames: NameRoster.create(0), returnAggregateName: self.erasedAggregateNameOfReturn(declaredReturn), returnBrand: EmptySourceText, paramExistentialSites: ParamExistentialSiteArray.create(0), returnExistentialSites: GenericInstanceIdArray.create(0), extensionConstraints: WhereConstraintArray.create(0), writtenTypeNames: WrittenTypeNames.none(), selfSpelledParams: NoParamPositions, offeredResultAlias: EmptySourceText, byRefParams: NoParamPositions), returnType: declaredReturn, nameLine: anchor.line, nameColumn: anchor.column, sourceFilePath: self.job.path, synthesized: true)
		self.commitRangeChecks(name)
	end 'parseDefaultInitializer'

	function parseRegistryCall(func IrFunction, keyTok Token, resultUsed bool) returns ValueId throws SourceParseError
		try self.consume(TokenKind.dot)
		let memberTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)

		let key = keyTok.value
		let isService = self.signatures.defaultKeyIsAService(key)
		let defaultIsRefused = isService and not self.signatures.isInterfaceHandle(serviceHandleCompanionName(key))
		let valueType = self.registryValueTypeOf(key, isService: isService)

		if memberTok.value.equals(RegistryCurrentMemberName) 'aLookup'
			let rparenTok = try self.consume(TokenKind.rightParen)

			if defaultIsRefused 'aLookupOfARefusedDefault'
				return self.mintDeferredValue()
			end 'aLookupOfARefusedDefault'

			let range = SourceRange.between(keyTok, last: rparenTok)
			let slot = self.emitRegistrySlot(key, member: RegistryCurrentMemberName, range: range)

			if isService 'aServiceLookup'
				return self.emitOwnedRuntimeResult(RegistryServiceCurrentName, args: argsOf(slot), resultTag: maxonTypeTag(valueType), resultNameId: typeNameIdOf(valueType), range: range)
			end 'aServiceLookup'

			return self.emitSharedValueRead(slot, valueType: valueType, range: range)
		end 'aLookup'

		let argTok = self.current()
		let given = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let replacement = try self.parseRegistryReplacement(func)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let range = SourceRange.between(keyTok, last: rparenTok)

		try self.requireRegistryResultMatchesReplacement(replacement, resultUsed: resultUsed, memberTok: memberTok)

		if defaultIsRefused 'aRegistrationOfARefusedDefault'
			return self.mintDeferredValue()
		end 'aRegistrationOfARefusedDefault'

		let slot = self.emitRegistrySlot(key, member: RegistryRegisterMemberName, range: range)

		if isService 'aServiceRegister'
			return try self.emitServiceRegistration(slot, handleType: valueType, given: given, replacement: replacement, argTok: argTok, range: range)
		end 'aServiceRegister'

		return try self.emitSharedValuePublish(slot, valueType: valueType, given: given, replacement: replacement, publishedTo: key, argTok: argTok, range: range)
	end 'parseRegistryCall'

	// Recorded before the `globalAddr` it keys: a site is filed under the op the next append creates,
	// and that op carries the call's whole range, which is where E3173 reports.
	function emitRegistrySlot(key immutable ByteArray, member immutable ByteArray, range SourceRange) returns ValueId
		self.artifact.recordRegistryUseSite(RegistryUseSite.create(key, member: member))
		return self.emitGlobalAddr(defaultSlotLabel(key), range: range)
	end 'emitRegistrySlot'

	function registryValueTypeOf(key ByteArray, isService bool) returns MaxonType
		let name = serviceHandleCompanionName(key) if isService else key
		return MaxonType.structRef(self.artifact.typeNames.intern(name))
	end 'registryValueTypeOf'

	function parseRegistryReplacement(func IrFunction) returns RegistryReplacement throws SourceParseError
		if not self.at(TokenKind.comma) 'unconditional'
			return RegistryReplacement.unconditional
		end 'unconditional'

		try self.consume(TokenKind.comma)
		let labelTok = try self.consume(TokenKind.identifier)

		if not labelTok.value.equals(RegistryReplacingLabel) 'notTheReplacingLabel'
			throw SourceParseError.unexpectedToken("`{String.from(RegistryReplacingLabel)}:`", got: tokenDisplayText(labelTok), line: labelTok.line, column: labelTok.column)
		end 'notTheReplacingLabel'

		try self.consume(TokenKind.colon)
		let old = try self.parseExpression(func, block: self.bodyState.currentBlock)
		return RegistryReplacement.replacing(old)
	end 'parseRegistryReplacement'

	function requireRegistryResultMatchesReplacement(replacement RegistryReplacement, resultUsed bool, memberTok Token) throws SourceParseError
		match replacement 'replacement'
			replacing then return
			unconditional then break
		end 'replacement'

		if resultUsed 'aValueOfAVoidCall'
			throw SourceParseError.unsupported("`{String.from(memberTok.value)}(…)` without `replacing:` returns nothing — only the conditional form answers whether it replaced the value", line: memberTok.line, column: memberTok.column)
		end 'aValueOfAVoidCall'
	end 'requireRegistryResultMatchesReplacement'

	function emitSharedValueRead(holder ValueId, valueType MaxonType, range SourceRange) returns ValueId
		let result = self.emitRuntimeCall(SharedValueCurrentName, args: argsOf(holder), resultTag: maxonTypeTag(valueType), resultNameId: typeNameIdOf(valueType), range: range)

		if self.valueIsManagedHeap(result) 'aCountedReference'
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.coOwned)
			self.setValueCapability(result, capability: ValueCapability.immutable)
			self.bodyState.immutableSlotReads = withValueMarked(self.bodyState.immutableSlotReads, value: result)
		end 'aCountedReference'

		return result
	end 'emitSharedValueRead'

	function emitServiceRegistration(slot ValueId, handleType MaxonType, given ValueId, replacement RegistryReplacement, argTok Token, range SourceRange) returns ValueId throws SourceParseError
		let handle = try self.registryHandleOf(given, handleType: handleType, argTok: argTok)

		// A clone, so the slot holds a box only the registry owns: the slot's box is released on whichever
		// thread replaces it, while the caller's box takes a plain unshared decrement. A box both held would
		// lose a count update, and that count alone decides when the cown closes and is freed.
		let stored = self.emitRuntimeCall(serviceHandleClonerOf(self.signatures, handleName: self.valueTypeName(handle)), args: argsOf(handle), resultTag: self.tagOf(handle), resultNameId: self.valueNameId(handle), range: range)

		return match replacement 'replacement'
			unconditional gives self.emitRuntimeCall(RegistryServiceRegisterName, args: twoArgs(slot, second: stored), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			replacing(old) gives self.emitRuntimeCall(RegistryServiceReplaceName, args: threeArgs(slot, second: stored, third: try self.registryHandleOf(old, handleType: handleType, argTok: argTok)), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'replacement'
	end 'emitServiceRegistration'

	function registryHandleOf(given ValueId, handleType MaxonType, argTok Token) returns ValueId throws SourceParseError
		let handle = self.interfaceHandleOf(given, declared: handleType, first: argTok, last: argTok)
		try self.requireManagedValueMatches(handleType, isString: false, value: handle, placeDoor: FunctionTypeDoor.payload, placeName: RegistryRegisterMemberName, placeOwner: SlotOwner.unowned, placeBrand: EmptySourceText, placeSpelling: EmptySourceText, voice: SlotMismatchVoice.containerElementArgument, anchor: argTok)
		return handle
	end 'registryHandleOf'

	function emitSharedValuePublish(holder ValueId, valueType MaxonType, given ValueId, replacement RegistryReplacement, publishedTo ByteArray, argTok Token, range SourceRange) returns ValueId throws SourceParseError
		let published = try self.publishableValue(given, valueType: valueType, key: publishedTo, placeName: RegistryPublishMemberName, argTok: argTok)

		return match replacement 'replacement'
			unconditional gives self.emitRuntimeCall(SharedValuePublishName, args: twoArgs(holder, second: published), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			replacing(old) gives self.emitRuntimeCall(SharedValueReplaceName, args: threeArgs(holder, second: published, third: old), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'replacement'
	end 'emitSharedValuePublish'

	function publishableValue(given ValueId, valueType MaxonType, key ByteArray, placeName ByteArray, argTok Token) returns ValueId throws SourceParseError
		try self.requireManagedValueMatches(valueType, isString: tagIsByteRecord(maxonTypeTag(valueType)), value: given, placeDoor: FunctionTypeDoor.payload, placeName: placeName, placeOwner: SlotOwner.unowned, placeBrand: EmptySourceText, placeSpelling: EmptySourceText, voice: SlotMismatchVoice.containerElementArgument, anchor: argTok)
		try self.requirePublishedValueNamedOnce(given, key: key, argTok: argTok)
		return try self.handOff(SoleHandedOffPosition, value: given, door: ThreadHandOffDoor.publish(key), anchor: argTok)
	end 'publishableValue'

	// ⚠ The ownership proof in `handOffTakeOf` reads a fresh-return mark that survives an
	// immutable rebind (`let b = a`), so a value two live names bind would pass it; counting the names
	// refuses that.
	function requirePublishedValueNamedOnce(value ValueId, key ByteArray, argTok Token) throws SourceParseError
		var names = 0 as Count

		for (_, binding) in self.bodyState.scope.allVars() 'eachBinding'
			if binding.isLiveNameOf(value) 'aLiveName'
				names = names + 1
			end 'aLiveName'
		end 'eachBinding'

		if names > 1 'aliased'
			throw registryNotSolelyOwnedError(key, anchor: argTok)
		end 'aliased'
	end 'requirePublishedValueNamedOnce'

	function interfaceHandleOf(value ValueId, declared MaxonType, first Token, last Token) returns ValueId
		if not self.handleWidensToSlot(value, declared: declared) 'noConversion'
			return value
		end 'noConversion'

		return self.emitInterfaceHandleConversion(value, target: self.internedName(typeNameIdOf(declared)), first: first, last: last)
	end 'interfaceHandleOf'

	function interfaceHandleNamed(value ValueId, target ByteArray, first Token, last Token) returns ValueId
		if not self.handleWidensToName(value, target: target) 'noConversion'
			return value
		end 'noConversion'

		return self.emitInterfaceHandleConversion(value, target: target, first: first, last: last)
	end 'interfaceHandleNamed'

	function handleWidensToSlot(value ValueId, declared MaxonType) returns bool
		if not self.signatures.declaresAnInterfaceHandle() 'noInterfaceHandle'
			return false
		end 'noInterfaceHandle'

		let slotTag = maxonTypeTag(declared)

		if not (slotTag == ValueTypeTag.structRef or slotTag == ValueTypeTag.named) 'notAHandleSlot'
			return false
		end 'notAHandleSlot'

		return self.handleWidensToName(value, target: self.internedName(typeNameIdOf(declared)))
	end 'handleWidensToSlot'

	function handleWidensToName(value ValueId, target ByteArray) returns bool
		return self.signatures.declaresAnInterfaceHandle() and self.tagOf(value) == ValueTypeTag.structRef and self.signatures.serviceHandleWidensTo(self.valueTypeName(value), interfaceHandleName: target)
	end 'handleWidensToName'

	function emitInterfaceHandleConversion(value ValueId, target ByteArray, first Token, last Token) returns ValueId
		let conversion = interfaceHandleConversionName(self.signatures.serviceOfHandle(self.valueTypeName(value)), interfaceName: self.signatures.interfaceOfHandle(target))
		return self.emitOwnedRuntimeResult(conversion, args: argsOf(value), resultTag: ValueTypeTag.structRef, resultNameId: self.artifact.typeNames.intern(target), range: SourceRange.between(first, last: last))
	end 'emitInterfaceHandleConversion'

	function dispatchOnSharedValue(func IrFunction, holder ValueId, baseTok Token, resultUsed bool) returns ValueId throws SourceParseError
		let memberTok = try self.consume(TokenKind.identifier)
		let valueType = self.sharedValueElementType(self.valueInstanceId(holder))
		try self.consume(TokenKind.leftParen)

		if memberTok.value.equals(RegistryCurrentMemberName) 'aLookup'
			let rparenTok = try self.consume(TokenKind.rightParen)
			return self.emitSharedValueRead(holder, valueType: valueType, range: SourceRange.between(baseTok, last: rparenTok))
		end 'aLookup'

		if memberTok.value.equals(CloneMethodName) 'aSecondHolder'
			let rparenTok = try self.consume(TokenKind.rightParen)
			return self.emitOwnedRuntimeResult(SharedValueBoxCloneName, args: argsOf(holder), resultTag: self.tagOf(holder), resultNameId: self.valueNameId(holder), range: SourceRange.between(baseTok, last: rparenTok))
		end 'aSecondHolder'

		if not memberTok.value.equals(RegistryPublishMemberName) 'notAMember'
			throw SourceParseError.unknownField(String.from(SharedValueTypeName), fieldName: String.from(memberTok.value), line: memberTok.line, column: memberTok.column)
		end 'notAMember'

		let argTok = self.current()
		let given = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let replacement = try self.parseRegistryReplacement(func)
		let rparenTok = try self.consume(TokenKind.rightParen)
		try self.requireRegistryResultMatchesReplacement(replacement, resultUsed: resultUsed, memberTok: memberTok)
		return try self.emitSharedValuePublish(holder, valueType: valueType, given: given, replacement: replacement, publishedTo: self.internedName(typeNameIdOf(valueType)), argTok: argTok, range: SourceRange.between(baseTok, last: rparenTok))
	end 'dispatchOnSharedValue'

	function sharedValueElementType(giid GenericInstanceId) returns MaxonType
		return self.resolvedSlotType(self.signatures.sharedValueElementOf(giid))
	end 'sharedValueElementType'

	function parseSharedValueCreate(func IrFunction, typeTok Token, giid GenericInstanceId) returns ValueId throws SourceParseError
		try self.consume(TokenKind.dot)
		let memberTok = try self.consume(TokenKind.identifier)

		if not memberTok.value.equals(RegistryCreateMemberName) 'notTheFactory'
			panic("parseSharedValueCreate: '{String.from(memberTok.value)}' passed `surfaceStaticOf` and is not the factory — the roster and this reader read one list")
		end 'notTheFactory'

		try self.consume(TokenKind.leftParen)
		let argTok = self.current()
		let given = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let range = SourceRange.between(typeTok, last: rparenTok)
		let valueType = self.sharedValueElementType(giid)

		let published = try self.publishableValue(given, valueType: valueType, key: typeTok.value, placeName: RegistryCreateMemberName, argTok: argTok)

		match self.signatures.registryValueKindOf(self.signatures.sharedValueElementOf(giid), readerFilePath: self.job.path) 'kind'
			service then panic("parseSharedValueCreate: a `SharedValue` holds a value, and `registryValueKindOf` answers `service` for no value type")
			value(dropCallee, retainCallee, _) then return self.emitOwnedRuntimeResult(SharedValueBoxCreateName, args: threeArgs(published, second: self.emitOptionalFuncAddr(dropCallee, range: range), third: self.emitOptionalFuncAddr(retainCallee, range: range)), resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
		end 'kind'
	end 'parseSharedValueCreate'

	function emitOptionalFuncAddr(callee OwnershipCallee, range SourceRange) returns ValueId
		return match callee 'callee'
			inert gives self.emitLiteral(NoRuntimeFunction, valueType: MaxonType.integer, range: range)
			named(name) gives self.emitCodeAddress(name, range: range)
		end 'callee'
	end 'emitOptionalFuncAddr'

	function widenArgsToInterfaceHandles(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token, rparenTok Token)
		if not self.signatures.declaresAnInterfaceHandle() 'noInterfaceHandle'
			return
		end 'noInterfaceHandle'

		let decl = try self.declarationNameableHere(callee) otherwise return
		self.widenArgsToDeclaration(decl, args: args, argLabels: argLabels, anchor: anchor, rparenTok: rparenTok)
	end 'widenArgsToInterfaceHandles'

	function widenArgsToDeclaration(decl SweptDeclaration, args ValueIdArray, argLabels NameRoster, anchor Token, rparenTok Token)
		let receiverArgs = 1 if decl.takesReceiver else 0

		for i in receiverArgs upto args.count() 'eachSourceArg'
			let label = try argLabels.get(i) otherwise panic("widenArgsToDeclaration: argLabels.get OOB at {i} — args and argLabels are pushed in lockstep")
			let slot = try argSlotPosition(decl.paramNames, argIndex: (i - receiverArgs) as ParamCount, label: label) otherwise continue
			let swept = try decl.paramTypes.get(slot) otherwise panic("widenArgsToDeclaration: paramTypes.get OOB at {slot} — the sweep records one type per parameter name")
			let given = try args.get(i) otherwise panic("widenArgsToDeclaration: args.get OOB at {i}")
			try args.set(i, value: self.interfaceHandleOf(given, declared: self.sweptParamType(swept, scopeFilePath: decl.declFilePath), first: anchor, last: rparenTok)) otherwise panic("widenArgsToDeclaration: args.set OOB at {i}")
		end 'eachSourceArg'
	end 'widenArgsToDeclaration'

	function widenFunctionValueArgs(governing TypeNameId, args ValueIdArray, anchor Token, rparenTok Token)
		if not self.signatures.declaresAnInterfaceHandle() 'noInterfaceHandle'
			return
		end 'noInterfaceHandle'

		for (position, declared) in self.functionValueShape(governing).paramTypes.withIterator() 'eachParam'
			let i = position.index()
			let given = try args.get(i) otherwise break
			try args.set(i, value: self.interfaceHandleOf(given, declared: declared, first: anchor, last: rparenTok)) otherwise panic("widenFunctionValueArgs: args.set OOB at {i}")
		end 'eachParam'
	end 'widenFunctionValueArgs'

	function widenWitnessArgs(target WitnessDispatchTarget, args ValueIdArray, first Token, last Token)
		if not self.signatures.declaresAnInterfaceHandle() 'noInterfaceHandle'
			return
		end 'noInterfaceHandle'

		for (position, formal) in target.paramTypes.withIterator() 'eachFormal'
			let i = position.index() + WitnessReceiverArgCount
			let given = try args.get(i) otherwise panic("widenWitnessArgs: args.get OOB at {i} — a dispatch reaching here has the receiver plus one actual per formal")

			if valueIsMarked(self.bodyState.argumentStorage, value: given) 'aCellIsNotAHandle'
				continue
			end 'aCellIsNotAHandle'

			let handleName = try formal.nominalName() otherwise continue
			try args.set(i, value: self.interfaceHandleNamed(given, target: handleName, first: first, last: last)) otherwise panic("widenWitnessArgs: args.set OOB at {i}")
		end 'eachFormal'
	end 'widenWitnessArgs'

	// Re-raise a diagnostic the declaration sweep recorded earlier, on another file's behalf. It exists only to
	// give the borrowed payload a scope of its own — see `raiseBindingFailure`.
	function throwRecordedConstantError(error SourceParseError) throws SourceParseError
		throw error
	end 'throwRecordedConstantError'

	function reportRecordedConstantError(error SourceParseError) throws SourceParseError
		let finding = try self.recordedSecondaryFinding(error) otherwise 'aRefusal'
			try self.throwRecordedConstantError(error)
			return
		end 'aRefusal'

		self.artifact.secondaryDiagnostics.push(finding)
	end 'reportRecordedConstantError'

	function recordedSecondaryFinding(error SourceParseError) returns Diagnostic throws AbsentError
		match error 'kind'
			registryRefused(code, explanation, line, column, _) then return try self.secondaryFindingAt(code, message: explanation, line: line, column: column)
			default throws AbsentError.absent
		end 'kind'
	end 'recordedSecondaryFinding'

	function secondaryFindingAt(code ErrorCode, message String, line LineNumber, column ColumnNumber) returns Diagnostic throws AbsentError
		match findingStandingOf(code) 'standing'
			primary then throw AbsentError.absent
			secondary then return Diagnostic.create(code, message: message, line: line, column: column, filePath: self.job.path)
		end 'standing'
	end 'secondaryFindingAt'

	// Read a top-level binding declaration: `[export] (let|var) <NAME> = <expression>`.
	//
	// It READS and does not RECORD, for exactly `readTypeAliasDeclaration`'s reason: it has two
	// callers that record differently. The tolerant declaration sweep folds what it reads into the
	// whole-program index (`recordScannedBinding`); the real parse reads it only to ask that index
	// what the initializer came to, and to raise the answer as a POSITIONED diagnostic if it failed.
	//
	// One reader, so the sweep and the parse can never drift on where an initializer ENDS — which is
	// the one thing they must agree on, because the range this returns is the range every initializer
	// parse reads. Two scanners would put the sweep's idea of the initializer and the parser's idea of it a
	// token apart, and the sweep would fold a different expression than the one the user wrote.
	//
	// ⭐⭐ **A `static let` MEMBER OF A `type` BODY READS THROUGH IT TOO, WHICH IS
	// THE WHOLE OF THAT FEATURE'S STORAGE MODEL.** `qualifier` is empty at file scope and the enclosing
	// type's name inside a `type` body, so a static member is a top-level binding whose NAME is
	// `Counter.count` — and every downstream mechanism (the initializer fold, the `.data` arena, the
	// `__module_init` store, dead-global elimination, the read and write doors) is keyed by that name and
	// needed no teaching at all. See `declaredBindingName` for why the qualification IS the per-type
	// identity rather than something built beside it.
	function readTopLevelBinding(visibility Visibility, qualifier EnclosingTypeScope) returns TopLevelDecl throws SourceParseError
		try self.consume(TokenKind.let)
		let nameTok = try self.consume(TokenKind.identifier)

		// The BARE name is what the reserved test sees, exactly as `parseFunction` checks `create` rather
		// than `Point.create`: the qualifier is the compiler's, not the author's, and a `__`-prefixed
		// member is the mistake being looked for.
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.consume(TokenKind.equals)

		let initStart = self.pos
		let initEnd = statementEndIndexIn(self.tokens, start: initStart, blockShiftAt: ignoreBlocks)
		self.pos = initEnd

		// ⭐ **THE SCOPE IS READ OFF THE QUALIFIER, HERE, WHERE IT IS A PARAMETER** — the caller states which
		// body it is reading (`parseTypeMember` passes the enclosing type, the file-scope dispatcher passes
		// nothing), so the fact is recorded at the one place that is TOLD it rather than inferred later from
		// the shape of the name. See `TopLevelDecl.scope` for why the two positions differ at all.
		return TopLevelDecl.create(self.declaredBindingName(qualifier, nameTok: nameTok), visibility: visibility, declFilePath: self.job.path, initStart: initStart, initEnd: initEnd, initRange: SourceRange.ofToken(self.tokenAt(initStart)), nameLine: nameTok.line, nameColumn: nameTok.column, scope: qualifier.clone(), declaredByTheCorpus: self.job.isStdlibSource)
	end 'readTopLevelBinding'

	// ⭐ **THE STORAGE NAME A BINDING DECLARATION CLAIMS — bare at file scope, `Type.member` inside a `type`
	// body.** The same construction `declaredMethodName` gives a method, because a static member and a
	// static method are qualified by the same thing for the same reason: the enclosing type is the scope the
	// name lives in. `TypeA.value` and `TypeB.value` are therefore two slots BY CONSTRUCTION, with no
	// per-type disambiguation left to get wrong.
	//
	// ⚠ It deliberately does NOT route through `declaredMethodName`, which also applies the free-function
	// DIRECTORY CONTEST. That rule is about two directories declaring one callable name; a top-level
	// binding's mint arrives in its declaration's name token (`authorMintedTokens`), so borrowing the contest
	// here would give a static member a mint no read door looks it up under.
	function declaredBindingName(qualifier EnclosingTypeScope, nameTok Token) returns immutable ByteArray
		return match qualifier 'qualifier'
			fileScope gives nameTok.value
			typeBody(typeName) gives qualifiedMethodName(typeName, methodName: nameTok.value)
		end 'qualifier'
	end 'declaredBindingName'

	// Parse a ranged typealias declaration: `typealias <Name> = int(<low> to|upto <high>)` or
	// `typealias <Name> = float(<low> to <high>)`. Nearly every real Maxon file opens with one —
	// `int` is almost never written bare in a type position (specs/ranged-typealias.md) — so this
	// is the declaration that gates most of the corpus.
	//
	// It emits NO op: an alias is a DECLARATION, and its whole effect is the registry entry its caller
	// records, which TypeResolution substitutes for every `MaxonType.named` use of the name. The DECLARATION
	// is nonetheless the type — two aliases over one range are two types, and `as` is the door between them
	// — because the identity is read off the value and signature columns BEFORE that substitution
	// (`ProgramSignatures.rangedIdentityOfSpelling`). A use in a type position interns that identity
	// (`parseTypeReference`).
	//
	// It READS and PUSHES into the caller's arrays, because it has two callers that collect differently:
	// the real parse files the alias in this file's artifact arrays, and the whole-program declaration
	// sweep folds it into its own arrays. One reader, so the two can never disagree about what a range
	// means. A typealias is EITHER a ranged numeric one (into `rangedOut`) or a FUNCTION one (into
	// `functionOut`), and pushing into the target array directly avoids boxing a discriminated-union
	// return on the per-typealias path (nearly every file opens with a `typealias`, so it is a hot one).
	//
	// The RANGE is enforced as a bound: a narrowing conversion into a ranged alias is checked at run time
	// (see `RangeCheckArgSite`). It is also read by more than the
	// registry — a range whose low bound is 0 declares an UNSIGNED type, and that decides how every
	// `shr` on a value of it fills (TypeRules' `rangeIsUnsigned`).
	//
	// It RETURNS THE FORM it read, and that is not a convenience: the three forms denote three
	// different things and only the ranged one is resolved per declaring FILE, so a duplicate-name
	// rule has to tell them apart (`TypeNameRegistry`). The alternative — the caller inferring the
	// form from which array grew, or re-deciding it off the tokens — would be a second copy of the
	// discrimination this function already makes, which is this project's signature bug.
	// `visibility` reaches the RANGED form's registry entry and the GENERIC-INSTANCE form's,
	// because those are the two alias registries a cross-file reference is resolved through
	// (`RangedAliasRegistry.lookup`, `ProgramSignatures.scopedGenericAliasInstance`). Both apply it at the
	// READ and not as a key, for the reason `RangedAliasRegistry`'s header gives. A FUNCTION alias
	// mints its nominal identity in a whole-program registry with no visibility reader — and that registry
	// has the cross-file defect, and curing it needs more than a scoped lookup: a function alias resolves
	// to `MaxonType.function(<the alias NAME>)`, so two files' declarations stay ONE type however the lookup
	// is scoped. See `ProgramSignatures.contestedGenericAliases`.
	function readTypeAliasDeclaration(rangedOut RangedTypeAliasArray, functionOut FunctionTypeAliasArray, genericOut GenericAliasSink, tupleOwner TupleAliasOwner, recordFunctionSignature bool, visibility Visibility) returns TypeDeclKind throws SourceParseError
		try self.consume(TokenKind.typealias)
		let writtenTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(writtenTok, declaredName: writtenTok.value)
		let nameTok = self.aliasFamilyDeclarationToken(writtenTok, owner: tupleOwner)
		try self.consume(TokenKind.equals)

		let form = self.aliasFormAt(self.pos)

		match form 'form'
			functionAlias then try self.readFunctionAliasForm(writtenTok, nameTok: nameTok, functionOut: functionOut, recordFunctionSignature: recordFunctionSignature, visibility: visibility)
			genericAlias then try self.readGenericAliasForm(writtenTok, nameTok: nameTok, genericOut: genericOut, recordFunctionSignature: recordFunctionSignature, visibility: visibility)
			tupleAlias then try self.readTupleAliasForm(nameTok, tupleOwner: tupleOwner, visibility: visibility)
			rangedAlias then try self.readRangedAliasForm(writtenTok, nameTok: nameTok, rangedOut: rangedOut, tupleOwner: tupleOwner, recordFunctionSignature: recordFunctionSignature, visibility: visibility)
			structType or
			enumType or
			unionType or
			interfaceType then panic("Parser.readTypeAliasDeclaration: `aliasFormAt` answered the nominal kind {form.name}, and it answers only the four alias forms")
		end 'form'

		return form
	end 'readTypeAliasDeclaration'

	function mutatesCapturesAt(index ElementIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier or self.kindAt(index + 1) != TokenKind.identifier 'notTwoWords'
			return false
		end 'notTwoWords'

		return self.tokenAt(index).value.equals(MutatesClauseWord) and self.tokenAt(index + 1).value.equals(CapturesClauseWord)
	end 'mutatesCapturesAt'

	function capabilityAliasAt(index ElementIndex) returns bool
		let capability = self.paramCapabilityAt(index)
		return capability == ParamCapability.isolated or capability == ParamCapability.immutable
	end 'capabilityAliasAt'

	function readFunctionAliasForm(writtenTok Token, nameTok Token, functionOut FunctionTypeAliasArray, recordFunctionSignature bool, visibility Visibility) throws SourceParseError
		// A FUNCTION typealias — `function(paramTypes) [returns T]`. The literal `function(…)`
		// form is legal ONLY as a typealias RHS (the spec), so this is the one place it is parsed as a
		// type. It records its own registry (`FunctionTypeAlias`), not the ranged one.
		// `recordFunctionSignature` is the REAL parse's signal that the signature facts only it can read — its
		// `#81` display string, its storability refusals and its aggregate names — are wanted; the sweep and the
		// nested-alias reader pass false (see `readFunctionTypeAlias`).
		// A function alias mints a NOMINAL identity (`resolveNamedAlias` re-tags a `named` reference to
		// `function`), so it may not take a compiler-owned type name — unlike the ranged form below, which
		// erases, and unlike the generic-instance form below, which names an instance rather than minting
		// one. See `requireTypeNameNotCompilerOwned`.
		try self.requireTypeNameNotCompilerOwned(writtenTok, declares: DeclaredTypeMeaning.nominalIdentity)
		let functionAlias = try self.readFunctionTypeAlias(nameTok, recordSignature: recordFunctionSignature, visibility: visibility)
		functionOut.push(functionAlias)
		self.pushNamespaceQualifiedFunctionAlias(functionOut, alias: functionAlias, writtenName: writtenTok.value)
	end 'readFunctionAliasForm'

	function readGenericAliasForm(writtenTok Token, nameTok Token, genericOut GenericAliasSink, recordFunctionSignature bool, visibility Visibility) throws SourceParseError
		// A GENERIC-INSTANCE typealias — `IntBox = Box with Integer`. Recognized by a base
		// identifier followed by `with`. It records its own registry (`GenericAliasEntry`), not the
		// ranged one, and (in the REAL parse) checks the instantiation's arity and managed arguments.
		// ⭐⭐ **THE ONE FORM WHOSE MEANING HAS TO BE *READ* BEFORE THE COMPILER-OWNED RULE CAN BE ASKED**
		// (spec-port `lazy-static`). A generic-instance alias mints no identity — it NAMES the instance its
		// base and arguments intern to (`resolveNamedAlias` re-tags a `named` reference to
		// `genericInstance`) — so a redeclaration of an owned name AGREES exactly when that instance is the
		// compiler's own, which is a fact about the RHS. Hence: read the alias, then judge it.
		//
		// ⚠ **AND THE ENTRY IS PUSHED ONLY AFTER THE VERDICT**, so a refused declaration reaches no registry:
		// pushing first would leave the SWEEP holding a contested alias whose diagnostic the real parse raises
		// later, i.e. a registry describing a program the compiler rejected.
		let baseTok = self.current()
		let entry = try self.readGenericInstanceAlias(nameTok, visibility: visibility)
		try self.requireTypeNameNotCompilerOwned(writtenTok, declares: DeclaredTypeMeaning.genericInstance(entry.baseName, args: entry.args, argCount: entry.argCount))

		if recordFunctionSignature and entry.baseName.equals(SharedValueTypeName) 'aSharedValueInstance'
			try self.requireShareableSharedValue(nameTok.value, baseTok: baseTok)
		end 'aSharedValueInstance'

		match genericOut 'sink'
			discard then break
			collect(out) then out.push(entry)
		end 'sink'
	end 'readGenericAliasForm'

	function readTupleAliasForm(nameTok Token, tupleOwner TupleAliasOwner, visibility Visibility) throws SourceParseError
		// A TUPLE typealias — `typealias Pair = (Num, Num)`. Its RHS is a tuple TYPE, read by the same
		// `parseTupleTypeReference` a parameter or return annotation uses, so a tuple written as an alias and
		// one written inline are ONE type. Like the RANGED form and unlike the function/generic ones it mints
		// no nominal identity — a `Pair` reference resolves straight through to the tuple's `structRef` — so
		// `requireTypeNameNotCompilerOwned` does not apply to it either.
		if self.capabilityAliasAt(self.pos) 'aCapabilityAlias'
			try self.readCapabilityAliasForm(nameTok, tupleOwner: tupleOwner, visibility: visibility)
			return
		end 'aCapabilityAlias'

		let tupleType = try self.parseTupleTypeReference(BarePrimitiveVoice.admitted)
		let target = try self.artifact.typeNames.nameOf(typeNameIdOf(tupleType)) otherwise panic("readTypeAliasDeclaration: the tuple type just minted for this alias carries an id that is not in this file's interner — `parseTupleTypeReference` interns its name into exactly that table")

		// The KEY is the caller's, never this reader's — see `TupleAliasOwner`. The tuple itself is
		// interned above whatever the owner says, because the ELEMENTS have to be validated on every read
		// or a malformed nested alias inside a withheld extension body would go unreported.
		self.publishTupleAlias(nameTok, tupleOwner: tupleOwner, target: target, visibility: visibility, capability: ParamCapability.unmarked)
	end 'readTupleAliasForm'

	function readCapabilityAliasForm(nameTok Token, tupleOwner TupleAliasOwner, visibility Visibility) throws SourceParseError
		let capabilityTok = self.current()
		let capability = try self.readParamCapability()
		let targetTok = self.current()

		if targetTok.kind == TokenKind.int or targetTok.kind == TokenKind.float or targetTok.kind == TokenKind.bool 'aPrimitiveBelongsToNoRegion'
			throw notATypeError(capabilityTok)
		end 'aPrimitiveBelongsToNoRegion'

		if targetTok.kind == TokenKind.leftParen 'aTupleIsNotAName'
			throw self.capabilityAliasTargetRefusal(capabilityTok)
		end 'aTupleIsNotAName'

		let spelled = try self.parseTypeReference(BarePrimitiveVoice.asAType)
		let tag = maxonTypeTag(spelled)
		let overAGenericAlias = tag == ValueTypeTag.genericInstance and targetTok.kind == TokenKind.identifier and self.signatures.isAliasOfFormFor(targetTok.value, readerFilePath: self.job.path, wanted: FormAliasKind.generic)

		if tag != ValueTypeTag.named and tag != ValueTypeTag.structRef and not overAGenericAlias 'notARecordName'
			throw self.capabilityAliasTargetRefusal(capabilityTok)
		end 'notARecordName'

		try self.requireCapabilityFits(capability, wordTok: capabilityTok, spelled: spelled)
		self.publishTupleAlias(nameTok, tupleOwner: tupleOwner, target: self.capabilityAliasTarget(spelled, targetTok: targetTok, overAGenericAlias: overAGenericAlias), visibility: visibility, capability: capability)
	end 'readCapabilityAliasForm'

	function capabilityAliasTargetRefusal(capabilityTok Token) returns SourceParseError
		return SourceParseError.unsupported("`{String.from(capabilityTok.value)}` on a typealias target that is not the name of a record type or of a generic alias", line: capabilityTok.line, column: capabilityTok.column)
	end 'capabilityAliasTargetRefusal'

	function capabilityAliasTarget(spelled MaxonType, targetTok Token, overAGenericAlias bool) returns immutable ByteArray
		if overAGenericAlias 'theAliasName'
			return targetTok.value
		end 'theAliasName'

		return try self.artifact.typeNames.nameOf(typeNameIdOf(spelled)) otherwise panic("capabilityAliasTarget: the record type just read carries an id that is not in this file's interner")
	end 'capabilityAliasTarget'

	function publishTupleAlias(nameTok Token, tupleOwner TupleAliasOwner, target ByteArray, visibility Visibility, capability ParamCapability)
		match tupleOwner 'owner'
			fileScope then self.signatures.recordTupleAlias(nameTok.value, tupleName: target, declFilePath: self.job.path, visibility: visibility, capability: capability)
			enclosingType(owner) then self.signatures.recordTupleAlias(joinQualifiedName(owner, member: self.authorsMemberName(nameTok.value)), tupleName: target, declFilePath: self.job.path, visibility: visibility, capability: capability)
			unpublished then break
		end 'owner'
	end 'publishTupleAlias'

	function readRangedAliasForm(writtenTok Token, nameTok Token, rangedOut RangedTypeAliasArray, tupleOwner TupleAliasOwner, recordFunctionSignature bool, visibility Visibility) throws SourceParseError
		// `int(...)` or `float(...)`. A `bool` alias has no range and a generic alias (`Array with T`)
		// is handled above — each remaining RHS is rejected here, naming its own gap, rather than
		// being mapped onto a numeric path where it would silently mean something else. The two
		// numeric forms differ ONLY in how their bounds read (int literals + `<int>.min/.max` versus
		// float literals + `f32`/`f64.min/.max`), so `isFloat` threads through the shared bound parser
		// rather than forking it.
		// ⭐⭐ **A RAW BIT-PATTERN ALIAS — `typealias Hash = bits(64)`, and the point is what it is NOT.**
		// `bits(n)` is a PATTERN: it admits every value n bits can hold, so its door is guarded by the
		// WIDTH alone — vacuously at 64, which is exactly what an address, a hash, a mask or a wrapped
		// relocation displacement needs. An `int(...)` alias is a QUANTITY, and its door refuses a value
		// that arrived from a signed domain, because a negative is not a quantity.
		//
		// ⚠ **THE TWO ARE INDISTINGUISHABLE BY RANGE AT 64** — both store `(0, UnsignedFullUpperPattern)`
		// — so the declaration carries its `RangedAliasDomain` (`pattern(width)` here) and every rule
		// that must tell them apart reads it.
		//
		// ⚠ **GUARDED ON THE NEXT TOKEN BEING `(`**, for `bareSizedType`'s reason one line down: `bits` is
		// an ordinary identifier, so `typealias Bits = SomeOtherType` must still reach the named path.
		if self.at(TokenKind.identifier) and self.current().value.equals(BitsTypeName) and self.kindAt(self.pos + 1) == TokenKind.leftParen 'bitsAlias'
			try self.consume(TokenKind.identifier)
			try self.consume(TokenKind.leftParen)
			let widthTok = try self.consume(TokenKind.intLiteral)
			let width = try self.intLiteralValue(widthTok, negated: false)
			try self.consume(TokenKind.rightParen)

			if not isLegalBitWidth(width) 'illegalWidth'
				throw SourceParseError.illegalBitWidth(width, line: widthTok.line, column: widthTok.column)
			end 'illegalWidth'

			let bitsTier = visibility
			let top = rawPatternUpperBound(width)

			// Refused above unless it is one of the seven legal widths, every one of which is inside
			// `BitWidth`'s own range — so this cast's guard can only ever be dead code.
			let bitWidth = width as BitWidth
			rangedOut.push(RangedTypeAlias.create(nameTok.value, underlying: MaxonType.integer, low: 0, high: top, visibility: bitsTier, declFilePath: self.job.path, nameLine: nameTok.line, nameColumn: nameTok.column, domain: RangedAliasDomain.pattern(bitWidth)))
			self.pushNamespaceQualifiedAlias(rangedOut, nameTok: writtenTok, underlying: MaxonType.integer, low: 0, high: top, tier: bitsTier, domain: RangedAliasDomain.pattern(bitWidth))

			return
		end 'bitsAlias'

		let isFloat = self.at(TokenKind.float)

		if not self.at(TokenKind.int) and not isFloat 'notNumeric'
			let tok = self.current()

			// ⭐ A BARE SIZED TYPE (`typealias Integer = i64`) gets its OWN diagnostic, not the generic
			// "unsupported" below, because it is not a missing feature — it is a rule, and the rule
			// comes with the rewrite that satisfies it. `i64` names a WIDTH and no RANGE, and every
			// reader the compiler has asks a ranged alias for its bounds, so the shorthand would mint a type
			// whose narrowing check has nothing to check against.
			//
			// ⚠ **GUARDED ON THE NEXT TOKEN NOT BEING `.`**: the sized names are also the qualifiers
			// of a range BOUND, and a diagnostic that fired on the first token of `i64.min` would
			// refuse the very syntax it recommends.
			if tok.kind == TokenKind.identifier and self.kindAt(self.pos + 1) != TokenKind.dot and isSizedTypeName(tok.value) 'bareSizedType'
				throw SourceParseError.bareSizedTypeAlias(String.from(tok.value), line: tok.line, column: tok.column)
			end 'bareSizedType'

			throw unsupportedTypeAliasRhs(tok)
		end 'notNumeric'

		// The `int`/`float` keyword itself — the anchor for both range diagnostics below, taken before it
		// is consumed. The blame is this token and not a bound's own, because the defect is the RANGE and
		// neither end is more at fault than the other.
		let primitiveTok = self.current()

		if isFloat 'consumeFloat'
			try self.consume(TokenKind.float)
		end 'consumeFloat' else 'consumeInt'
			try self.consume(TokenKind.int)
		end 'consumeInt'

		try self.consume(TokenKind.leftParen)
		let low = try self.parseRangeBound(isFloat)
		let high = try self.parseRangeUpperBound(isFloat)
		try self.consume(TokenKind.rightParen)
		try self.requireRepresentableRange(primitiveTok, low: low, high: high, isFloat: isFloat)

		let underlying = MaxonType.float if isFloat else MaxonType.integer
		let tier = visibility
		rangedOut.push(RangedTypeAlias.create(nameTok.value, underlying: underlying, low: low.value, high: high.value, visibility: tier, declFilePath: self.job.path, nameLine: nameTok.line, nameColumn: nameTok.column))
		self.pushNamespaceQualifiedAlias(rangedOut, nameTok: writtenTok, underlying: underlying, low: low.value, high: high.value, tier: tier)

		if self.at(TokenKind.implements) 'anImplementsClause'
			try self.readAliasImplementsClause(nameTok, tier: tier, isFloat: isFloat, low: low.value, high: high.value, tupleOwner: tupleOwner, resolveNow: recordFunctionSignature)
		end 'anImplementsClause'
	end 'readRangedAliasForm'

	function readAliasImplementsClause(nameTok Token, tier Visibility, isFloat bool, low FullRangeInt, high FullRangeInt, tupleOwner TupleAliasOwner, resolveNow bool) throws SourceParseError
		let implementsTok = try self.consume(TokenKind.implements)
		let parentIndex = self.pos
		let parentTok = try self.consume(TokenKind.identifier)
		let parentDots = self.dottedChainLengthAt(parentIndex)
		let writtenParent = self.assembleDottedChainAt(parentIndex, dots: parentDots) if parentDots > 0 else parentTok.value
		let parentName = writtenParent if parentDots > 0 else self.signatures.bareWrittenKey(parentTok.value, readerFilePath: self.job.path)

		for _ in 0 upto parentDots 'eachParentSegment'
			try self.consume(TokenKind.dot)
			self.advance()
		end 'eachParentSegment'

		if not tupleOwner.isFileScope() 'insideATypeBody'
			throw SourceParseError.unsupported("an `implements` clause on a typealias declared inside a type body (only a file-scope typealias implements another)", line: implementsTok.line, column: implementsTok.column)
		end 'insideATypeBody'

		if not resolveNow 'theDeclarationSweep'
			self.sweptImplementsClauses.push(AliasImplementsClause.create(nameTok.value, parentName: parentName, visibility: tier, declFilePath: self.job.path, isFloat: isFloat, low: low, high: high))
			return
		end 'theDeclarationSweep'

		if parentDots > 0 'aQualifiedParent'
			_ = try self.resolvedTypeChainAt(parentIndex, anchor: parentTok, use: ChainUse.typeReference)
		end 'aQualifiedParent' else 'aBareParent'
			try self.requireNameableTypeNameAt(parentIndex, written: writtenParent, anchor: parentTok)
		end 'aBareParent'

		try requireImplementsClauseHolds(self.signatures.aliasImplementsVerdictOf(nameTok.value, declFilePath: self.job.path), nameTok: nameTok, parentName: writtenParent, parentTok: parentTok)
		self.recordQualifiedTypeNameUse(writtenParent)
	end 'readAliasImplementsClause'

	function requireNameableTypeNameAt(index ElementIndex, written ByteArray, anchor Token) throws SourceParseError
		try self.settleTypeNameVerdict(try self.typeNameVerdictAt(index, written: written, anchor: anchor))
	end 'requireNameableTypeNameAt'

	function notedTypeChain(declaration ChainType, consumed ElementIndex, anchor Token) returns QualifiedTypeChain throws SourceParseError
		try self.settleTypeNameVerdict(self.chainTypeVerdict(declaration, anchor: anchor))
		return QualifiedTypeChain.declared(declaration, consumed: consumed)
	end 'notedTypeChain'

	function resolvedTypeChainAt(headIndex ElementIndex, anchor Token, use ChainUse) returns QualifiedTypeChain throws SourceParseError
		match self.resolveChainAt(headIndex, use: use) 'chain'
			declaredType(declaration, consumed) then return try self.notedTypeChain(declaration, consumed: consumed, anchor: anchor)
			ambiguous(written, candidates) then throw ambiguousTypeNameRefusal(written, candidates: candidates, anchor: anchor)
			unqualified then return QualifiedTypeChain.notQualified
			value or
			declaredFunction or
			nothing then panic("Parser.resolvedTypeChainAt: `resolveChain` answered a type-position chain with a value, a function or nothing — it answers those only for a chain ending in a member")
		end 'chain'
	end 'resolvedTypeChainAt'

	function typeNameVerdictAt(index ElementIndex, written ByteArray, anchor Token) returns TypeNameVerdict throws SourceParseError
		if not self.signatures.allFilesFolded 'theIndexIsStillBeingBuilt'
			return TypeNameVerdict.nameable
		end 'theIndexIsStillBeingBuilt'

		if self.qualifiedTypeBaseIsAt(index) 'anEnteredQualifiedBase'
			return TypeNameVerdict.nameable
		end 'anEnteredQualifiedBase'

		return try self.bareTypeNameVerdict(written, anchor: anchor)
	end 'typeNameVerdictAt'

	// ⭐⭐ **THE DIRECTORY-QUALIFIED MIRROR OF A RANGED TYPEALIAS** — `api/types.maxon`'s `Score` is
	// filed a SECOND time under `api.Score`, which is what makes `50 as api.Score` resolve to THAT
	// declaration's range rather than to whichever same-named one the bare lookup happened to win with.
	//
	// ⭐ **IT IS A SECOND DECLARATION IN THE SAME ARRAY, AND THAT IS THE WHOLE DESIGN.** `readTypeAliasDeclaration`
	// is the ONE reader of the typealias grammar — the tolerant sweep and the real parse both come through it —
	// so one push here reaches BOTH ranged-alias registries (`ProgramSignatures.typeAliases` via `foldFile`,
	// `Project.typeAliases` via `commitTypeAliases`) and every door they already have answers for the qualified
	// key with no new code: the scoped `lookup`, the visibility test `aliasVisibleFrom`, the erasure
	// `underlyingFor`, the whole-program stride `storageBytesInEveryFile`, the parse-memo hash. A
	// dedicated qualified index would have had to re-implement each of those, and would have been free to
	// disagree with them.
	//
	// ⚠ **THE MIRROR IS NOT A DUPLICATE DECLARATION.** `commitTypeNameDecls` owns E3061 and reads a different
	// array.
	function pushNamespaceQualifiedAlias(rangedOut RangedTypeAliasArray, nameTok Token, underlying MaxonType, low FullRangeInt, high FullRangeInt, tier Visibility, domain RangedAliasDomain = RangedAliasDomain.quantity)
		rangedOut.push(RangedTypeAlias.create(namespaceQualifiedName(qualifierForNamespace(self.job.namespace), name: nameTok.value), underlying: underlying, low: low, high: high, visibility: tier, declFilePath: self.job.path, nameLine: nameTok.line, nameColumn: nameTok.column, domain: domain))
	end 'pushNamespaceQualifiedAlias'

	// ⭐⭐ **THE FUNCTION FORM'S DIRECTORY-QUALIFIED MIRROR — the ranged one's twin, one registry over.**
	// `api.Score` and `legacy.Score` are how E3063 tells the author to disambiguate a bare `Score`, and the
	// cure has to reach whichever FORM each declaration was written in: once two files may declare one name
	// in two different forms (`typeNamePairMayCoexist`), the qualified spelling of the FUNCTION one was a
	// name no registry held and `legacy.Score` in a parameter position was **E3011 Unknown type**.
	function pushNamespaceQualifiedFunctionAlias(functionOut FunctionTypeAliasArray, alias FunctionTypeAlias, writtenName ByteArray)
		functionOut.push(alias.underName(namespaceQualifiedName(qualifierForNamespace(self.job.namespace), name: writtenName)))
	end 'pushNamespaceQualifiedFunctionAlias'

	function aliasFamilyDeclarationToken(writtenTok Token, owner TupleAliasOwner) returns Token
		if not owner.isFileScope() or not self.signatures.isAliasFamilyBesideANominal(writtenTok.value) 'itsWrittenNameIsItsIdentity'
			return writtenTok
		end 'itsWrittenNameIsItsIdentity'

		return Token.create(TokenKind.identifier, line: writtenTok.line, column: writtenTok.column, value: aliasFamilyMint(writtenTok.value), startByte: writtenTok.startByte, endByte: writtenTok.endByte)
	end 'aliasFamilyDeclarationToken'

	// ⭐ **CAN A SINGLE 64-BIT TYPE HOLD THIS DECLARED RANGE?** Checked at the declaration — the only
	// place the answer is still knowable, because `RangedTypeAlias` stores the bounds as raw 64-bit
	// patterns and a bound above `i64.max` rides as a negative one (see `ParsedRangeBound`).
	//
	// ⚠ **THE ORDER OF THE TWO IS DELIBERATE AND IT IS PINNED.** `int(i64.min to u64.max)` fails both
	// tests, and the MISMATCH is the sharper fact: the author named two types, and once that is fixed
	// the representability question does not arise. Reporting unrepresentability first would describe
	// a consequence and leave the cause unnamed. `error.unrepresentable-range` pins the order.
	function requireRepresentableRange(primitiveTok Token, low ParsedRangeBound, high ParsedRangeBound, isFloat bool) throws SourceParseError
		// Two TYPE-QUALIFIED ends naming different types. A LITERAL end names no type at all and is
		// compatible with every qualifier — `int(0 to i32.max)` is legal and common — which is why the
		// test is "both are qualified AND they disagree" and not "they disagree".
		if let lowType = try low.qualifier.typeName() 'aTypedLowEnd'
			if let highType = try high.qualifier.typeName() 'aTypedHighEnd'
				if not lowType.equals(highType) 'mismatchedBoundTypes'
					throw SourceParseError.mismatchedRangeBoundTypes(low.spellingUnder(lowType), high: high.spellingUnder(highType), line: primitiveTok.line, column: primitiveTok.column)
				end 'mismatchedBoundTypes'
			end 'aTypedHighEnd'
		end 'aTypedLowEnd'

		// ⚠ INTEGER ALIASES ONLY. A float bound's `value` is an IEEE-754 BIT PATTERN, so a negative
		// float has its sign bit set and reads `< 0` here while meaning nothing of the sort; and
		// `exceedsSignedMax` cannot fire in a float alias anyway, since a `u64.max` bound there is the
		// integer bound `float(...)` deliberately tolerates. Testing it would be comparing a bit
		// pattern with a count.
		if isFloat 'floatAlias'
			return
		end 'floatAlias'

		// Every range reader takes a negative lower as signed and a negative upper over a non-negative
		// lower as above `i64.max` (`rangeIsUnsignedTopped`). A lower above `i64.max`, or a negative lower
		// with an upper above it, needs 65 bits; a written-negative upper over a non-negative lower is
		// empty. Left unchecked, each would be read as a range nobody wrote.
		if low.exceedsSignedMax 'lowerBoundAboveTheSignedTop'
			throw SourceParseError.integerRangeLowerBoundAboveSignedMax(low.writtenText(), line: primitiveTok.line, column: primitiveTok.column)
		end 'lowerBoundAboveTheSignedTop'

		if low.value < 0 and high.exceedsSignedMax 'unrepresentable'
			throw SourceParseError.unrepresentableIntegerRange(low.value, high: high.writtenText(), line: primitiveTok.line, column: primitiveTok.column)
		end 'unrepresentable'

		if low.value >= 0 and high.value < 0 and not high.exceedsSignedMax 'empty'
			throw SourceParseError.emptyIntegerRange(low.value, high: high.value, line: primitiveTok.line, column: primitiveTok.column)
		end 'empty'
	end 'requireRepresentableRange'

	// Is the cursor at a typealias declaration — `typealias …`, or the `export typealias …` the spec
	// writes? A peek only; the caller consumes. Shared by the two walks that must recognize the form
	// WITHOUT having consumed the `export` first: the type-body scan (nested aliases) and the
	// declaration sweep, whose loop treats `export` as an ordinary token.
	function atTypeAliasDeclaration() returns bool
		if visibilityModifierIn(self.tokens, index: self.pos) 'modified'
			return self.kindAt(self.pos + 1) == TokenKind.typealias
		end 'modified'

		return self.at(TokenKind.typealias)
	end 'atTypeAliasDeclaration'

	// ⭐ **READ ONE NESTED (INNER) TYPEALIAS** — `typealias Idx = int(0 to
	// u64.max)`, `typealias ElementArray = Array with T`, `typealias Entry = (Key, Value)` or
	// `typealias Fn = function(Integer) returns Integer` inside a type body. The cursor sits at `typealias`
	// (any `export` is consumed by the caller, which is why the visibility is passed rather than read). It
	// reuses `readTypeAliasDeclaration` — the ONE typealias grammar the sweep and the real parse share —
	// which routes each RHS into its own out-array. The three PER-INSTANCE forms record their bare member
	// into `enclosingInnerAliases` so the rest of the body's bare references resolve; the FUNCTION form does
	// not, because it is a file-scope declaration written inside a body and its name must mean the same thing
	// on both sides of the type's `end` (see `NestedAliasResult`). The caller keys the returned shape.
	//
	// ⚠ **NOTHING HERE IS GATED ON THE ENCLOSING TYPE BEING GENERIC** — `parseTypeMember`
	// and the sweep's body walk reach this for a plain `type Config` exactly as for a `type Container uses T`.
	//
	// ⭐⭐ **THE TUPLE FORM IS ADMITTED TOO, AND IT IS A ROUTING JOB.** The reader, the interning and the resolution
	// are the file-scope tuple alias's own; what a nested one adds is the
	// per-type KEY (`TupleAliasOwner`), the `enclosingInnerAliases` membership, and the tuple arm in
	// `parseTypeReference`'s inner-alias lookup. It is `stdlib/Map.maxon:20`'s first line of body.
	function readNestedTypeAlias(visibility Visibility, recordFunctionSignature bool, tupleOwner TupleAliasOwner) returns NestedAliasResult throws SourceParseError
		// The MEMBER name, peeked before the shared reader consumes it — the grammar `atTypeAliasDeclaration`
		// already rests on (`typealias` then the name), and `recordScannedExtension` reads its target the same
		// way. The tuple form is the one shape that hands back no declaration to take a name off, and it needs
		// one for exactly the reason the other two per-instance forms do: `enclosingInnerAliases`.
		let memberNameIndex = self.pos + 1
		let ranged = RangedTypeAliasArray.create(0)
		let functionAliases = FunctionTypeAliasArray.create(0)
		let generics = GenericAliasEntryArray.create(0)

		// The FORM comes from the reader that decided it, never from which array grew: that inference
		// would be a second copy of a discrimination `readTypeAliasDeclaration` already makes, free to
		// drift the day a fifth form appears.
		let form = try self.readTypeAliasDeclaration(ranged, functionOut: functionAliases, genericOut: GenericAliasSink.collect(generics), tupleOwner: tupleOwner, recordFunctionSignature: recordFunctionSignature, visibility: visibility)

		// A generic-instance nested alias (`Array with T`) — recorded by `readGenericInstanceAlias` into
		// `generics`. Its instance is PARTIALLY OPAQUE (`Array with typeParameter(token)`), keyed whole-program by
		// the caller under its base-qualified name so a same-named inner alias of another generic type stays
		// distinct, exactly as a ranged inner alias is.
		if form == TypeDeclKind.genericAlias 'genericInstance'
			let entry = try generics.get(0) otherwise panic("readNestedTypeAlias: the generic-instance form was read but generics.get(0) failed")
			self.recordInnerAliasName(entry.aliasName)
			return NestedAliasResult.genericInstance(entry)
		end 'genericInstance'

		// A TUPLE nested alias (`(Key, Value)`) — already keyed whole-program by the reader under the name
		// `tupleOwner` names, so all that is left is the membership every per-instance form records.
		if form == TypeDeclKind.tupleAlias 'tupleAlias'
			if let member = try self.identifierNameAt(memberNameIndex) 'aNamedMember'
				self.recordInnerAliasName(member)
			end 'aNamedMember'

			return NestedAliasResult.tupleAlias
		end 'tupleAlias'

		// A FUNCTION nested alias. It is NOT entered into `enclosingInnerAliases`, and that is because
		// membership in that set means "a MEMBER of this type", which routes a `Name{…}` literal
		// (`parseInnerAliasLiteral`) and files the per-instance parameter entries a concrete receiver
		// re-qualifies (`innerAliasMemberOfParamType`) — a function alias is neither constructible nor
		// per-instance, so both would be wrong answers. Its `<Type>.<member>` reading is served instead by the
		// registry itself, which the CALLER files it into under both names (`publishNestedFunctionAlias`).
		if form == TypeDeclKind.functionAlias 'functionAlias'
			return NestedAliasResult.functionAlias(try functionAliases.get(0) otherwise panic("readNestedTypeAlias: the function form was read but functionAliases.get(0) failed"))
		end 'functionAlias'

		// The RANGED form is the one remaining nested shape. A nominal kind cannot reach here at all,
		// `typealias` being the only keyword this reader consumes, so anything else is a form
		// `readTypeAliasDeclaration` grew and this enumeration did not.
		if form != TypeDeclKind.rangedAlias 'unroutedForm'
			panic("readNestedTypeAlias: `readTypeAliasDeclaration` read the form '{form.rawValue}', which this reader routes nowhere — every RHS form it can return needs an arm here or a nested declaration of it is silently dropped")
		end 'unroutedForm'

		let alias = try ranged.get(0) otherwise panic("readNestedTypeAlias: the ranged form was read but ranged.get(0) failed")
		self.recordInnerAliasName(alias.name)
		return NestedAliasResult.ranged(alias)
	end 'readNestedTypeAlias'

	// ⭐ **KEEP ONE `interface`-SCOPED GENERIC-INSTANCE TYPEALIAS FOR THE FOLD.** It is re-keyed under
	// `<Interface>.<member>` by the SAME `qualifiedInnerGenericAlias` a `type` body's nested alias goes
	// through — one re-keying rule, and it is what keeps two interfaces declaring `ElementArray` distinct.
	// COPY-ON-WRITE off the shared empty, `recordInnerAliasName`'s discipline for its reason.
	function noteInterfaceAlias(entry GenericAliasEntry)
		if self.interfaceAliasScratch is self.anchors.interfaceAliases 'stillShared'
			self.interfaceAliasScratch = GenericAliasEntryArray.create(0)
		end 'stillShared'

		self.interfaceAliasScratch.push(self.qualifiedInnerGenericAlias(entry))
	end 'noteInterfaceAlias'

	// Record a nested alias's bare member into `enclosingInnerAliases` so the rest of the body's bare
	// references resolve. COPY-ON-WRITE off the shared empty set: only a type that actually declares a nested
	// typealias gets its own set here, so the generics-free corpus never allocates one (the reset points at
	// the shared one). Shared by both nested-alias shapes, so ranged and generic aliases enter the set the
	// same way.
	function recordInnerAliasName(name ByteArray)
		let declared = self.innerAliasesForWrite()
		declared.insert(name)
	end 'recordInnerAliasName'

	// ⭐⭐ **A CONFORMANCE ARGUMENT MAY NAME THE TYPE'S OWN NESTED TYPEALIAS, AND THE CLAUSE IS READ BEFORE
	// THE BODY THAT DECLARES IT.** `stdlib/Map.maxon` writes
	// `type Map … implements Iterable with (Entry, MapIterator)` and declares `typealias Entry = (Key, Value)`
	// on its first body line; `type MapIterator … implements Iterator with Entry` does the same. An
	// `implements` clause is part of the HEADER, so at the moment `readConformanceWithArg` renders `Entry`
	// the body has not been read — in EITHER pass — and the binding was recorded as the BARE member, which is
	// not the name a nested alias is keyed under and not the name the declared type renders to.
	// **MEASURED: `E3016 … current() returns __Tuple2.T38ee….Taebb… (expected current() returns Entry)`** —
	// the two sides of ONE type, spelled two ways.
	//
	// ⇒ The names are pre-scanned out of the body the clause belongs to and put in scope FOR THE CLAUSE ONLY.
	// Not for the body: `closeConformanceClauseAliasScope` puts the shared empty back, and the body records
	// each alias as it reaches it exactly as before, so a bare name inside a method still resolves against the
	// aliases DECLARED ABOVE IT and nothing about the body's scoping moves.
	//
	// ⚠ It is the ONE repair of this ordering, deliberately, and not one per reader. A binding is compared
	// ACROSS conformers (`associatedAbiBindingOf` refuses two conformers that bind one associated type
	// differently) and substituted at three tiers, so a resolver bolted onto any one of them would leave the
	// others reading a name the first had already decided meant something else.
	//
	// ⚠ Gated on `implements` AND on the clause actually writing a `with`, so only a declaration that binds
	// something walks — a type with no conformance clause, which is nearly every type, pays one token test,
	// and one whose clause binds nothing pays a walk of the clause LINE instead of a walk of its BODY.
	function openConformanceClauseAliasScope()
		if not self.at(TokenKind.implements) 'declaresNoConformance'
			return
		end 'declaresNoConformance'

		if not self.implementsClauseBindsAnything() 'bindsNothingToResolve'
			return
		end 'bindsNothingToResolve'

		let scannedByTheSweep = self.bodyAliasesScanned

		if not scannedByTheSweep 'notYetScanned'
			self.scanBodyNestedAliases()
		end 'notYetScanned'

		for member in self.scannedPerInstanceAliases.declared() 'eachMember'
			self.recordInnerAliasName(member)
		end 'eachMember'

		if not scannedByTheSweep 'scanIsOnlyForTheClause'
			self.clearBodyAliasScan()
		end 'scanIsOnlyForTheClause'
	end 'openConformanceClauseAliasScope'

	export function methodKeysOfAnUndeclaredExtension(site ExtensionDeclSite, into NameRoster)
		self.pos = site.tokenPos
		let header = try self.readExtensionHeader() otherwise return

		match header.target 'target'
			undeclaredTarget then break
			interfaceExtension or
			typeExtension then return
		end 'target'

		var depth = 1 as BlockDepth

		while not self.isEof() 'walk'
			if self.functionDeclarationAt(self.pos) 'opensAMethod'
				if depth == 1 'aMember'
					into.push(joinQualifiedName(header.nameTok.value, member: self.tokenAt(self.pos + 1).value))
				end 'aMember'

				depth = depth + 1
				self.advance()
				continue
			end 'opensAMethod'

			let closes = self.closesBlockAt(self.pos)
			depth = self.blockDepthAfterCursor(depth)
			self.advance()

			if closes and depth == 0 'closesTheDeclaration'
				return
			end 'closesTheDeclaration'
		end 'walk'
	end 'methodKeysOfAnUndeclaredExtension'

	// ⭐⭐ **THE PER-INSTANCE NESTED `typealias` MEMBERS DECLARED AT THE TOP LEVEL OF THE BLOCK THE CURSOR IS
	// CURRENTLY INSIDE** — a PEEK-shaped walk that reads names and resolves nothing, shared by the two passes
	// that need the scope before the declarations (`openConformanceClauseAliasScope`, which needs it for the
	// `implements` clause written ABOVE the body, and `publishExtensionInnerAliases`, which needs it for
	// every OTHER FILE's `extension` body over the same type). It leaves the cursor just past the block's own
	// `end`; a caller that must resume where it started saves and restores `self.pos` itself.
	//
	// The extent rule is `advanceToOutermostBlockEnd`'s, to the token, and for its reason: a NAMED `function`
	// opens a block `blockDepthAfter` does not count, the closer test is taken BEFORE the counter moves, and a closer
	// is asked through `closesBlockAt` because a member may be NAMED `end`. `depth` starts at 1 because
	// both callers enter INSIDE exactly one open block.
	//
	// ⚠ **THE FUNCTION FORM GOES TO `functionInto`, NOT `into`**: a nested `typealias Fn = function(…)` is a
	// file-scope name written inside a body and never enters the per-instance scope (`readNestedTypeAlias`'s
	// own arm says why). The test is the one token `readTypeAliasDeclaration` discriminates the form on, asked
	// of the same position.
	function collectNestedAliasMembersInBody()
		var depth = 1 as BlockDepth

		while not self.isEof() 'walk'
			if self.functionDeclarationAt(self.pos) 'opensAMethod'
				depth = depth + 1
				self.advance()
				continue
			end 'opensAMethod'

			if let member = try self.nestedAliasNameAt(self.pos) 'aNestedAlias'
				if depth == 1 and not self.nestedAliasIsAFunctionType(self.pos) 'perInstanceNestedAlias'
					let perInstance = self.scannedPerInstanceAliasesForWrite()
					perInstance.push(member)
				end 'perInstanceNestedAlias' else if depth == 1 'aFunctionNestedAlias'
					let functionForm = self.scannedFunctionAliasesForWrite()
					functionForm.push(member)
				end 'aFunctionNestedAlias'
			end 'aNestedAlias'

			let closes = self.closesBlockAt(self.pos)
			depth = self.blockDepthAfterCursor(depth)
			self.advance()

			if closes and depth == 0 'closesTheDeclaration'
				return
			end 'closesTheDeclaration'
		end 'walk'
	end 'collectNestedAliasMembersInBody'

	function scanBodyNestedAliases()
		let resume = self.pos
		self.clearBodyAliasScan()
		self.collectNestedAliasMembersInBody()
		self.pos = resume
		self.bodyAliasesScanned = true
	end 'scanBodyNestedAliases'

	function clearBodyAliasScan()
		self.scannedPerInstanceAliases = noScannedAliasNames
		self.scannedFunctionAliases = noScannedAliasNames
		self.bodyAliasesScanned = false
	end 'clearBodyAliasScan'

	function scannedPerInstanceAliasesForWrite() returns NameRoster
		match self.scannedPerInstanceAliases 'state'
			unwritten then break
			entries(names) then return names
		end 'state'

		let fresh = NameRoster.create(0)
		self.scannedPerInstanceAliases = ScannedAliasNames.entries(fresh)
		return fresh
	end 'scannedPerInstanceAliasesForWrite'

	function scannedFunctionAliasesForWrite() returns NameRoster
		match self.scannedFunctionAliases 'state'
			unwritten then break
			entries(names) then return names
		end 'state'

		let fresh = NameRoster.create(0)
		self.scannedFunctionAliases = ScannedAliasNames.entries(fresh)
		return fresh
	end 'scannedFunctionAliasesForWrite'

	// Does the nested `typealias` declaration starting at `index` — one `nestedAliasNameAt` has already
	// recognized — have a function type on its right-hand side, `function(…)`? A PEEK, walking the same
	// header shape that reader walks (an optional visibility modifier, `typealias`, the member name) and
	// then the `=`.
	//
	// ⚠ It reads the one token `readTypeAliasDeclaration` discriminates the function form on, at the position
	// that reader would read it, so a peek and the read cannot disagree about which form a declaration is.
	function nestedAliasIsAFunctionType(index ElementIndex) returns bool
		let at = pastVisibilityModifiers(self.tokens, index: index)

		// `typealias` at `at`, the member name at `at + 1`, and the `=` at `at + 2` — a malformed declaration
		// that lacks the `=` is not any form, and the real parse reports it with a position.
		if self.kindAt(at + 2) != TokenKind.equals 'noRightHandSide'
			return false
		end 'noRightHandSide'

		return self.kindAt(at + 3) == TokenKind.function
	end 'nestedAliasIsAFunctionType'

	// ⭐⭐ **DOES THE `implements` CLAUSE AT THE CURSOR WRITE A `with` ANYWHERE? — the one question that decides
	// whether the clause is INDEX-DEPENDENT at all.** Two readers ask it and both take the same two things off
	// a `false`: `openConformanceClauseAliasScope` skips the pre-scan of the declaration's whole BODY (nothing
	// in it can be named by a clause that names no argument), and `recordScannedType`/`recordScannedEnum` skip
	// the `ConformanceClauseDeclSite` (`readOptionalImplementsClause` consults the interface arity only inside
	// its `with` arm, so a clause without one is read identically by the sweep and by the whole-program
	// re-read, and `Queries.foldConformanceClauses` would re-derive the sweep's own answer).
	//
	// ⚠ **IT IS SOUND IN ONE DIRECTION ONLY, WHICH IS THE DIRECTION BOTH CALLERS NEED.** The walk stops at the
	// header's `newline`, and `readOptionalImplementsClause` cannot consume past one — its interface loop
	// continues only on a `comma` — so a `false` PROVES the clause holds no `with`. A `true` may come from a
	// `with` in the `where` clause that follows on the same line, which costs the pre-scan and the decl site a `false` skips, and
	// nothing else.
	function implementsClauseBindsAnything() returns bool
		var at = self.pos

		while not tokenKindEndsALine(self.kindAt(at)) 'theHeaderLine'
			if self.kindAt(at) == TokenKind.with 'bindsOne'
				return true
			end 'bindsOne'

			at = at + 1
		end 'theHeaderLine'

		return false
	end 'implementsClauseBindsAnything'

	// Put the shared empty set back after the clause — see the door above for why the pre-scanned names are
	// deliberately NOT left in scope for the body.
	function closeConformanceClauseAliasScope()
		self.enclosingInnerAliases = noInnerAliases
	end 'closeConformanceClauseAliasScope'

	// The MEMBER a nested typealias declaration starting at `index` names, or `AbsentError` when the
	// token is not one. A PEEK — the pre-scan above must not consume — and it reads the header in the order
	// `atTypeAliasDeclaration` recognizes it: an optional visibility modifier, then `typealias <name>`.
	function nestedAliasNameAt(index ElementIndex) returns immutable ByteArray throws AbsentError
		let at = pastVisibilityModifiers(self.tokens, index: index)

		if self.kindAt(at) != TokenKind.typealias 'notATypeAlias'
			throw AbsentError.absent
		end 'notATypeAlias'

		return try self.identifierNameAt(at + 1)
	end 'nestedAliasNameAt'

	// Re-key a nested generic-instance alias entry under its BASE-QUALIFIED name (`Container.ElementArray`)
	// before the sweep folds it whole-program. `readGenericInstanceAlias` records the BARE
	// member (`ElementArray`), but a bare member collides with a same-named inner alias of another generic
	// type, so it is qualified with the enclosing type — the SAME name `parseTypeReference`'s inner-alias arm
	// stamps the field type with (`joinQualifiedName`), so the field's stored `named("Container.ElementArray")`
	// and this `genericAliases` key are one string.
	//
	// ⚠ It is only HALF of what a `type` body's nested alias is published under — see
	// `publishNestedGenericAlias`, which files this copy plus, for a plain type, a bare file-scope one.
	//
	// ⚠ **IT RE-KEYS AND RECORDS THE SCOPING — `scopedToEnclosingType`, not a rebuild through `create`.** A
	// nested alias is a declaration a person wrote in a file, and every fact `readGenericInstanceAlias`
	// captured about it (its declaring FILE above all, but also its visibility, its `FixedArray` size and its
	// anchors) is as true of it under the qualified name as under the bare one. Rebuilding would take `create`'s
	// defaults for all of them and file the entry as declared by the file `""`, which
	// `deriveInstanceDisplayNames` panics on — see `GenericAliasEntry.scopedToEnclosingType`. The ONE
	// thing that does change beside the name is `typeScoped`, the fact this call site is the sole evidence of.
	function qualifiedInnerGenericAlias(entry GenericAliasEntry) returns GenericAliasEntry
		return entry.scopedToEnclosingType(self.innerAliasKey(entry.aliasName))
	end 'qualifiedInnerGenericAlias'

	// ⭐⭐ **A NESTED GENERIC-INSTANCE ALIAS OF A PLAIN `type` IS PUBLISHED UNDER TWO KEYS** —
	// `publishNestedFunctionAlias`'s twin one alias FORM over, and the two must not be asymmetric. A nested
	// `typealias Fn = function(…)` is filed under BOTH its bare name and `<Type>.<member>`, the bare one
	// being *"the file-scope reading this form has always had"*; a nested `typealias Bag = Array with Num`
	// filed under the qualified name ALONE would leave a member of a non-generic type with no spelling outside
	// its own body, and every signature built on it with none either:
	// `stdlib/Directory.maxon:12`'s `FilePathArray` is what `Directory.list` RETURNS, and no other file could
	// write that type — `FilePathArray.create(0)` would type its result `unknown` (E2015 at the next member
	// access) and `returns FilePathArray` would be E3011.
	//
	// ⚠⚠ **A GENERIC TYPE'S MEMBER GETS NO BARE KEY, AND THE PRICE OF PUBLISHING ONE IS MEASURED RATHER
	// THAN FEARED.** Such a member is PER-INSTANCE — `Wrapper with A`'s `Idx` and `Wrapper with B`'s are
	// distinct types (`per-instance-typealias.md`'s `wrong-instance-error`) — so there is no one type for a
	// file-scope name to denote, and the entry it would file names the enclosing type's own PARAMETER.
	// MEASURED on the ungated build: a free function writing `firstOf(b Bag)` over `type Holder uses T`'s
	// `Bag = Array with T` was not refused but MISCOMPILED, reaching the layout-descriptor refusal
	// (*"takes a reference to a borrowed type-parameter value"*) for a program whose actual defect is that
	// `Bag` names nothing outside `Holder`. `stdlib` alone would have filed FIVE disagreeing `ElementArray`
	// declarations (`Array.maxon:561`, `Builtins.maxon:56`, `Interfaces.maxon:195`, `List.maxon:13`,
	// `Set.maxon:12`) — a contest over a name no program can legally write.
	//
	// ⚠⚠ **AND A MEMBER SPELLED LIKE ITS OWN TYPE GETS NONE EITHER, WHICH IS `namesEnclosingType`'s RULE
	// READ AT THE PUBLISH DOOR RATHER THAN A SECOND ONE.** `inner-alias-construction.md`'s
	// `an-inner-alias-shadowing-its-own-type` pins that `type Holder` declaring `typealias Holder = Array with
	// …` still means the TYPE at `Holder.create()`; a bare key makes that declaration indistinguishable from
	// a file-scope alias, which WINS at the static door (`inner-alias-shadowing-another-type-wins-at-the-static
	// -door`). MEASURED: all three of that spec's shadowing cases went red, `Holder.create()` building the
	// array. The read door already refuses the name for this reason — asking the same predicate here is what
	// keeps the two from drifting.
	//
	// ⚠ **ONLY A `type` BODY REACHES THIS — an `extension` body is deliberately left publishing the
	// qualified key alone.** `foldExtensionDeclarationInto` publishes a body once per CONFORMER
	// (`extensionTargetConformers`), so a bare key filed from there is ONE name for N declarations that are
	// allowed to disagree: `stdlib/Interfaces.maxon`'s `extension Iterable` would file `ElementArray` as
	// `Array with Character` for `String` and `Array with Byte` for `ByteView`, from one file, which no
	// contest can separate. That is the eleven-signature shape of the function form, which
	// that form carries as a wart rather than as a thing to copy. Nothing needs it: an extension's member is
	// already spelled from any `extension` over the same type through the `<Type>.<member>` key
	// (`per-instance-typealias.md`'s `cross-file-extension-declares-the-generic-instance-member`).
	function publishNestedGenericAlias(entry GenericAliasEntry, into GenericAliasEntryArray)
		into.push(self.qualifiedInnerGenericAlias(entry))

		if not self.enclosingTypeParams.isEmpty() 'aGenericTypesMemberIsPerInstance'
			return
		end 'aGenericTypesMemberIsPerInstance'

		if self.namesEnclosingType(entry.aliasName) 'theTypesOwnNameStillMeansTheType'
			return
		end 'theTypesOwnNameStillMeansTheType'

		into.push(entry.asBareFileScopeName())
	end 'publishNestedGenericAlias'

	// ⭐⭐ **A NESTED FUNCTION ALIAS IS PUBLISHED UNDER TWO KEYS, AND THEY ANSWER TWO DIFFERENT
	// QUESTIONS.** The BARE name is the file-scope reading this form has always had and which the corpus pins —
	// `specs/ownership.md`'s `closure-captures-borrow` declares `FnTypeAlias1` inside `type Config` and
	// names it from a FREE function below the type, and `specs/type-name-collision.md`'s form table calls
	// the function-alias registry "bare, whole-program". The `<Type>.<member>` name is the reading INSIDE the
	// declaring body.
	//
	// ⛔ **RE-KEYING INSTEAD OF ADDING IS WRONG** — it deletes the file-scope
	// reading and reddens `closure-captures-borrow`. The two keys are not one fact written twice: they are
	// allowed to disagree, and on `stdlib/Interfaces.maxon` they DO. That body is read once per CONFORMER
	// with that conformer's substitution (`foldExtensionDeclarationInto`), so eleven folds write eleven
	// signatures — `function(Byte) returns Byte` for `ByteView`, `function(Character) returns Character` for
	// `String`, `function(Entry) returns Entry` for `Map`. Under one key the last fold would win and `map`'s own
	// body would stop type-checking: `result.push(transform(item))` would be **`E3005 … expected 'Byte', got
	// 'Character'`**, which would take every `Map` literal in the suite with it (66 cases). The qualified key gives
	// each fold its own identity, which is exactly what the three PER-INSTANCE nested forms already have.
	//
	// ⚠ **PUBLISHING BOTH IS ALSO WHAT MAKES THE READ DOOR'S GATE EXACT AND FREE** — `parseTypeReference`
	// probes the qualified key only after the BARE one has hit, which is sound precisely because a nested
	// declaration always files both. See there.
	//
	// The bare key stays LAST-WINS across declarations: that is the cross-file "two function aliases with
	// different signatures" case `specs/type-name-collision.md` calls out of scope. An interface extension
	// is the exception in WHICH one wins: its bare entries, one per conformer, are held in
	// `pendingBareAliases` and published by `publishPendingBareAliases` sorted by conformer name, so the
	// winner does not depend on library file order or declaration order.
	//
	// ⚠ **THE NON-EMPTY PRECONDITION IS CHECKED, NOT MERELY WRITTEN DOWN** — `namespaceQualifiedName`'s guard
	// for its reason. All three callers are inside a type or extension body and cannot reach here otherwise,
	// which is exactly why a fourth that forgot would file `.Fn` — a key no source can spell, unreachable
	// behind the read door's own `isEmpty` gate, and red nowhere. Once per DECLARATION, so the test is free.
	function publishNestedFunctionAlias(alias FunctionTypeAlias, keys NestedAliasKeys, into FunctionTypeAliasArray)
		if not self.enclosingType.isType() 'noEnclosingType'
			panic("publishNestedFunctionAlias: nested function typealias '{String.from(alias.name)}' was published with an EMPTY enclosing type — every caller reads a `type`/`extension` BODY, where `enterTypeScope` has set one")
		end 'noEnclosingType'

		let qualified = self.innerAliasKey(alias.name)

		match keys 'keys'
			bareAndQualified then into.push(alias)
			bareInCanonicalOrder then self.pendingBareAliases.push(ConformerBareAlias.create(self.enclosingTypeName(), alias: alias))
		end 'keys'

		into.push(alias.underName(qualified))
		self.signatures.recordNestedFunctionAlias(qualified)
	end 'publishNestedFunctionAlias'

	function nestedAliasKeys(extendedInterface InterfaceName) returns NestedAliasKeys
		return NestedAliasKeys.bareInCanonicalOrder if extendedInterface.isNamed() else NestedAliasKeys.bareAndQualified
	end 'nestedAliasKeys'

	function publishPendingBareAliases(into FunctionTypeAliasArray)
		self.pendingBareAliases.sortBy(function(left, right) gives compareBytesOrdinally(left.conformer, right: right.conformer))

		for pending in self.pendingBareAliases 'eachPending'
			into.push(pending.alias)
		end 'eachPending'

		self.pendingBareAliases.clear()
	end 'publishPendingBareAliases'

	// ⭐ **A GENERIC-INSTANCE TYPEALIAS** — `typealias IntBox = Box with Integer`. The cursor
	// sits on the base identifier. It RECORDS the instance into `genericOut` (which `foldFile` interns
	// into the whole-program `GenericInstanceRegistry`).
	//
	// ⚠ **IT RETURNS THE ENTRY RATHER THAN PUSHING IT** (spec-port `lazy-static`): the compiler-owned-name
	// rule needs the alias's MEANING — its base and its arguments — and must be able to refuse the
	// declaration after reading it, which a reader that had already filed it could not allow.
	function readGenericInstanceAlias(aliasTok Token, visibility Visibility) returns GenericAliasEntry throws SourceParseError
		let base = try self.consumeGenericBaseName()
		try self.consume(TokenKind.with)

		// ⭐ **ARGUMENT 0's PRE-ERASURE SPELLING**, read with the cursor still on it — `parseGenericArgNodes`
		// below reaches `parseTypeReference`, whose generic-alias arm folds `__ManagedMemory` into the very
		// `genericInstance(Array with Byte)` a `ByteArray` argument resolves to. For an `Array` base argument 0
		// is the ELEMENT, so this is the whole of what tells `Array with __ManagedMemory` from
		// `Array with ByteArray` — one instance, two spellings. See `GenericAliasEntry.elementIsBuffer`.
		// ⭐ **A SIZED BASE EATS ITS COUNT BEFORE THE ARGUMENT LIST** — `FixedArray with 3 Int`. The count is a
		// VALUE, not a type argument (see `FixedArrayBuiltinBaseName`), so it is consumed here and the list below
		// reads the ONE type argument `builtinGenericTypeParamCount` validates against. Read in the SWEEP as
		// well as the real parse, because the sweep is what interns the instance and the size is half of that
		// instance's identity — a sweep that skipped it would file every `FixedArray with N Int` under one gid.
		let shape = try self.readSizedBaseElementCount(base.written)
		let elementIsBuffer = self.firstGenericArgSpellingDenotesBuffer()

		// ⭐ **`__ManagedMemory with T` INTERNS AS `Array with T`** — one record, one instance; see
		// `canonicalGenericBaseName`. The SPELLING is kept only as `baseIsBuffer`, which decides the member
		// surface every declared position naming this alias takes.
		let baseIsBuffer = base.written.equals(ManagedMemoryTypeName)
		let baseName = self.canonicalGenericBaseNameInThisFile(base.denoted)
		let args = GenericArgNodeArray.create(0)
		let argsStart = self.pos
		let (argCount, qualified) = try self.parseGenericArgNodes(args, baseName: baseName, inlineElement: self.baseStoresArgumentsInline(baseName), bareCommaList: true, slot: self.signatures.genericArgSlotOf(baseName))
		let selfRef = self.selfNamingArgToken(aliasTok, argsStart: argsStart)
		self.noteGenericSpelling(base, baseName: baseName, argCount: argCount)

		return GenericAliasEntry.create(aliasTok.value, baseName: baseName, argCount: argCount, args: args, elementIsBuffer: elementIsBuffer, baseIsBuffer: baseIsBuffer, anchor: GenericAliasAnchor.declaredAt(aliasTok.line, nameColumn: aliasTok.column, selfRefLine: selfRef.line, selfRefColumn: selfRef.column), filePath: self.job.path, visibility: visibility, shape: qualified if qualified.qualifiesArgs() else shape)
	end 'readGenericInstanceAlias'

	// ⭐⭐ **A GENERIC BASE MAY BE A QUALIFIED NAME, AND A SERVICE'S `<T>.handle` IS THE ONE THAT IS.** The
	// companion is minted under the dotted name an author writes, so an instantiation of it
	// (`Box.handle with String`) has to read both halves — and it is what gives a declared slot something to
	// say. Asked at an INDEX rather than at the cursor because both gates that admit a base are lookaheads.
	function atGenericBaseName(at ElementIndex) returns bool
		if self.kindAt(at) != TokenKind.identifier 'notAName'
			return false
		end 'notAName'

		if self.kindAt(at + 1) == TokenKind.with 'anUnqualifiedBase'
			return true
		end 'anUnqualifiedBase'

		return self.kindAt(at + 1) == TokenKind.dot and self.kindAt(at + 2) == TokenKind.identifier and self.kindAt(at + 3) == TokenKind.with
	end 'atGenericBaseName'

	// The base itself, cursor left ON the `with`. Written once because the TOP-LEVEL alias and a NESTED
	// argument each read one, and a gate that admitted a qualified base at only one of them would parse half
	// the spellings of one type.
	function consumeGenericBaseName() returns GenericBaseName throws SourceParseError
		let headIndex = self.pos
		let baseTok = try self.consume(TokenKind.identifier)
		try self.requireTypeSpellingIsNotRawBuffer(baseTok)

		if not self.at(TokenKind.dot) 'unqualified'
			return GenericBaseName.create(baseTok, written: baseTok.value, denoted: baseTok.value)
		end 'unqualified'

		try self.consume(TokenKind.dot)
		let memberTok = try self.consume(TokenKind.identifier)
		let written = joinQualifiedName(baseTok.value, member: memberTok.value)
		return GenericBaseName.create(baseTok, written: written, denoted: try self.denotedQualifiedGenericBase(headIndex, written: written, anchor: baseTok))
	end 'consumeGenericBaseName'

	function denotedQualifiedGenericBase(headIndex ElementIndex, written immutable ByteArray, anchor Token) returns immutable ByteArray throws SourceParseError
		if not self.signatures.allFilesFolded 'theSweepHoldsNoDeclarationYet'
			return written
		end 'theSweepHoldsNoDeclarationYet'

		let chain = try self.resolvedTypeChainAt(headIndex, anchor: anchor, use: ChainUse.typeReference)

		match chain 'chain'
			declared then self.recordTypeNameUse(written)
			notQualified then break
		end 'chain'

		return chain.denotedName(written)
	end 'denotedQualifiedGenericBase'

	// ⭐ **THE TOKEN AT WHICH THIS DECLARATION NAMES ITSELF** — the second `A` of `typealias A = Array with A`.
	// It is the word the author has to change, and it is the anchor `specs/type-checking.md` blames a
	// SELF-cycle at (column 26 of that line), against the alias NAME for a cycle that runs through other
	// aliases. See `GenericAliasEntry.selfRefLine` for why the position must be captured here.
	//
	// It SCANS the argument tokens rather than threading the alias name down through `parseGenericArgNodes`,
	// so a NESTED occurrence (`typealias A = Box with (Box with A)`) is found by the same three lines that
	// find a top-level one. The span is one declaration's argument list — a handful of tokens, compared
	// without allocating.
	//
	// **Falls back to the alias's own name token**, which is every declaration that is not a self-reference:
	// the entry stores an ANCHOR and never an absence, so no reader downstream has to decode one.
	function selfNamingArgToken(aliasTok Token, argsStart ElementIndex) returns Token
		for i in argsStart upto self.pos 'eachArgumentToken'
			let tok = self.tokenAt(i)

			if tok.kind == TokenKind.identifier and tok.value.equals(aliasTok.value) 'namesItself'
				return tok
			end 'namesItself'
		end 'eachArgumentToken'

		return aliasTok
	end 'selfNamingArgToken'

	// ⭐⭐ **THE ELEMENT COUNT OF A SIZED CONTAINER SPELLING, cursor just past `with`** —
	// `InstanceShape.unsized` for every base that is not sized, which is every base but `FixedArray`, and
	// for those the cursor does not move.
	//
	// ⚠ **A MISSING OR UNUSABLE COUNT IS RECORDED, NOT THROWN**: this is a whole-program semantic verdict
	// about a declaration, not a token the grammar cannot consume, so it must not abort the file's parse. `FixedArray with Int` goes on to parse `Int` as the element
	// and interns an instance nothing can reach, because a recorded diagnostic gates the build.
	//
	// ⚠ **AND IT IS SILENT DURING THE SWEEP.** The sweep re-reads none
	// of its diagnostics (`queryProgramSignatures` throws its artifact away) and the real parse re-reads every
	// one of these declarations, so recording here would build a positioned `Diagnostic` plus an interpolated
	// message per sized alias for an answer nothing reads.
	// ⭐⭐ **DOES BASE `name` STORE ITS TYPE ARGUMENT AS AN INLINE BUFFER SLOT, rather than in a
	// dictionary-passed type-parameter slot — the ONE home of `checkGenericArgType`'s rule-1 exemption.**
	//
	// ⚠ **IT IS ONE HOME BECAUSE THE ANSWER IS NEEDED AT BOTH `Base with …` DOORS — the top-level alias and
	// the NESTED argument — and a widening applied to only one is a SILENT DIVERGENCE IN A REFUSAL** (review
	// finding 3): with the derivation spelled at each site, `FixedArray with 2 Real` would stop earning E2062
	// while `Box with (FixedArray with 2 Real)` went on earning it, or the reverse, with nothing to say which is
	// the rule. `checkGenericArgType`'s header promises the exemption widens in one line; this is that line.
	//
	// ⚠ **IT IS A ROSTER OF THE BASES WHOSE FLOAT SLOT IS MEASURED, NOT `isBuiltinGenericBaseName`.**
	// `Set` and `Map` hash their key and `List` boxes its payload, and each already REFUSES a float in its
	// own terms at its own door (E2015, naming the container and the slot). Admitting them here would delete
	// a DECLARATION-site diagnostic in exchange for a later one at the first method call — and for a
	// declared-but-unused alias, for none at all.
	function baseStoresArgumentsInline(name ByteArray) returns bool
		return self.signatures.isFixedArrayBaseName(name) or self.signatures.isArrayBaseName(name)
	end 'baseStoresArgumentsInline'

	// ⭐⭐⭐ **THE WHOLE OF `__ManagedMemory`'s FOLD, AND ITS TARGET IS *DISCOVERED*.** A written
	// `__ManagedMemory with T` and the array record's `<Name> with T` are ONE `GenericInstanceId` (see
	// `ManagedMemoryTypeName`); this decides which `<Name>`, and it reads the answer off the
	// `BuiltinArrayLiteral` conformance rather than from a constant. Three arms, and each one is a different
	// question:
	//
	//   • **NOT the buffer spelling** — nothing to fold. Every other base name arrived as a TOKEN and has
	//     already been through the stdlib rename, so it is returned untouched.
	//   • **INSIDE A CONFORMER'S OWN BODY, the conformer.** `type Bag uses Element implements
	//     BuiltinArrayLiteral` whose sole field is a `__ManagedMemory with Element` IS that record, so its
	//     field's instance must be `Bag`'s own and not the corpus declaration's — otherwise the identity
	//     `Parser.emitFusedWrapperLiteral` performs hands back a value of a type `Self` is not.
	//     `enclosingType` is the DECLARING TOKEN, so inside `stdlib/Array.maxon` under a contest it is already
	//     `__Array` and this arm needs no rename of its own.
	//   • **OTHERWISE, the corpus's declaration, as THIS FILE spells it.** A user file spells it bare;
	//     a stdlib file spells it under the contest's mint.
	//
	// ⛔ **THE THIRD ARM MAY NOT BE THE ENCLOSING CONFORMER WIDENED TO THE FILE, AND THE MEASUREMENT
	// SAYS SO.** Under a user `type Array` the corpus declaration is `__Array`, so `stdlib/String.maxon`'s
	// `typealias ByteBuffer = __ManagedMemory with Byte` folded to a bare `Array with Byte` — the USER's
	// container — while the same file's `ByteArray = Array with Byte` had been rewritten to
	// `__Array with Byte`. MEASURED: **`E3005 stdlib/String.maxon:160:20: argument type mismatch for
	// 'managed': expected '__ManagedMemory with Byte', got 'ByteBuffer'`**, i.e. one record with two ids,
	// which is exactly what the fold exists to prevent. A `__ManagedMemory` outside every conformer is the
	// record the stdlib's own signatures are written against, and that is the corpus's declaration whatever
	// else the program declares.
	function canonicalGenericBaseNameInThisFile(baseName immutable ByteArray) returns immutable ByteArray
		if not baseName.equals(ManagedMemoryTypeName) 'notTheBufferSpelling'
			return baseName
		end 'notTheBufferSpelling'

		if let typeName = try self.enclosingType.typeName() 'insideAType'
			if self.signatures.isArrayBaseName(typeName) 'theConformersOwnBody'
				return typeName
			end 'theConformersOwnBody'
		end 'insideAType'

		return self.signatures.arrayRecordBaseNameIn(self.job.isStdlibSource)
	end 'canonicalGenericBaseNameInThisFile'

	function readSizedBaseElementCount(baseName ByteArray) returns InstanceShape throws SourceParseError
		if not self.signatures.isFixedArrayBaseName(baseName) 'unsizedBase'
			return InstanceShape.unsized
		end 'unsizedBase'

		if not self.at(TokenKind.intLiteral) 'noCount'
			if self.atMisspelledElementCount() 'aMisspelledCount'
				try self.refuseMisspelledElementCount()
				return InstanceShape.unsized
			end 'aMisspelledCount'

			return InstanceShape.runtimeSized
		end 'noCount'

		let countTok = try self.consume(TokenKind.intLiteral)
		let count = try self.intLiteralValue(countTok, negated: false)

		if count < (MinFixedElementCount as FullRangeInt) or count > (MaxFixedElementCount as FullRangeInt) 'outOfRange'
			self.recordSizedBaseCountRefusal(countTok, fault: "its element count is {count}")
			return InstanceShape.unsized
		end 'outOfRange'

		return InstanceShape.sized(count as FixedElementCount)
	end 'readSizedBaseElementCount'

	function atMisspelledElementCount() returns bool
		let kind = self.current().kind

		if kind == TokenKind.floatLiteral or kind == TokenKind.minus or kind == TokenKind.plus 'aNumberNoCountIs'
			return true
		end 'aNumberNoCountIs'

		return kind == TokenKind.identifier and self.peekKind() == TokenKind.identifier
	end 'atMisspelledElementCount'

	function refuseMisspelledElementCount() throws SourceParseError
		let firstTok = try self.consume(self.current().kind)
		var spelling = tokenDisplayText(firstTok)

		if (firstTok.kind == TokenKind.minus or firstTok.kind == TokenKind.plus) and (self.at(TokenKind.intLiteral) or self.at(TokenKind.floatLiteral)) 'aSignedCount'
			spelling = "{spelling}{tokenDisplayText(self.current())}"
			try self.consume(self.current().kind)
		end 'aSignedCount'

		self.recordSizedBaseCountRefusal(firstTok, fault: "the element count of a `{String.from(FixedArrayBuiltinBaseName)}` type is an integer literal, not `{spelling}`")
	end 'refuseMisspelledElementCount'

	// The ONE wording of E2069, shared by every fault that reaches it (a written count outside the
	// usable range, a count spelled as anything but an integer literal, a constant `create` length
	// outside that range) so a reader meets one sentence about one rule however the program went
	// wrong.
	//
	// ⚠ It takes only the token to BLAME. The base it names is `FixedArrayBuiltinBaseName` and cannot
	// be anything else — every caller is already inside a `FixedArray` spelling or construction — so
	// the base token passed in alongside the constant would be one name written twice, free to
	// disagree with itself in a single sentence.
	function recordSizedBaseCountRefusal(spelledAt Token, fault String)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		self.recordArtifactDiagnostic(ErrorCode.fixedArraySizeMalformed, message: "A `{String.from(FixedArrayBuiltinBaseName)}` element count runs from {MinFixedElementCount} to {MaxFixedElementCount}, and {fault}", range: SourceRange.ofToken(spelledAt))
	end 'recordSizedBaseCountRefusal'

	// Was the FIRST type argument of the `Base with …` at the cursor spelled `__ManagedMemory`? The
	// cursor sits just past `with`, so the answer is the token there — or the one after it for the
	// parenthesized list form, whose `(` is not an argument. Asked HERE rather than inside
	// `parseGenericArgNode`, because that routine also reads NESTED instances' arguments, where "argument 0 of
	// the alias being declared" is not a question it can answer.
	function firstGenericArgSpellingDenotesBuffer() returns bool
		if self.at(TokenKind.leftParen) 'parenthesizedArgList'
			return self.typeSpellingAtDenotesBuffer(self.pos + 1)
		end 'parenthesizedArgList'

		return self.typeSpellingAtDenotesBuffer(self.pos)
	end 'firstGenericArgSpellingDenotesBuffer'

	// Record a whole-program semantic DIAGNOSTIC the pure parser detected, WITHOUT unwinding the parse
	// — the parser twin of `reportPositioned`, writing into the artifact (which `mergeArtifact`
	// folds into `project.diagnostics`, or onto the secondary roster for a secondary finding) rather
	// than into `project`, so the pure-parser invariant holds.
	//
	// It takes the SPAN and not the token, because a reporter may hold one without holding the other: a
	// parameter's name token is consumed inside `parseFunctionParameters` and only its `SourceRange`
	// survives into `bindParameters`, where E3012's candidate is recorded. A `Diagnostic` wants a line and
	// a column in any case, which is exactly what a range carries.
	function recordArtifactDiagnostic(code ErrorCode, message String, range SourceRange)
		let diagnostic = Diagnostic.create(code, message: message, line: range.line, column: range.column, filePath: self.artifact.filePath)

		match findingStandingOf(code) 'standing'
			primary then self.artifact.diagnostics.push(diagnostic)
			secondary then self.artifact.secondaryDiagnostics.push(diagnostic)
		end 'standing'
	end 'recordArtifactDiagnostic'

	// ⭐ **`inlineElement` SAYS THE ARGUMENT NAMES AN ELEMENT STORED INLINE IN A BUFFER, WHICH IS THE ONE
	// THING THAT DECIDES WHETHER A FLOAT MAY BE IT** — see `checkGenericArgType`'s rule 1. It is a fact about
	// the BASE, so it is passed down from the base that was read rather than re-derived per argument, and a
	// NESTED instance recomputes it from its own base (a `FixedArray with 2 (Box with FullRangeFloat)` puts
	// `FullRangeFloat` in a declared generic's slot, not in a buffer).
	function parseGenericArgNodes(nodes GenericArgNodeArray, baseName ByteArray, inlineElement bool, bareCommaList bool, slot GenericArgSlot) returns (FieldIndex, InstanceShape) throws SourceParseError
		var spelled = ArgQualifierMasks.none()

		if not self.at(TokenKind.leftParen) 'unparenthesized'
			let firstQualifier = try self.parseGenericArgNode(nodes, baseName: baseName, inlineElement: inlineElement, slot: slot, position: 0)
			spelled = spelled.qualifying(0, qualifier: firstQualifier)

			// ⭐⭐ **`Map with String, UnaryOp` IS THE SAME LIST `Map with (String, UnaryOp)` SPELLS, AND
			// `/specs/map.md:function-valued.dispatch` WRITES IT WITHOUT THE PARENS.** The parenthesized form
			// already parsed; the bare one stopped after argument 0 and left the `,` for the DECLARATION reader,
			// which reported it as `E2001 Expected function declaration, got ','` — a complaint about the next
			// top-level declaration, on a line that declares a two-argument instance. Two spellings of one type
			// must reach one arity, so the comma continues the list here.
			//
			// ⚠ **AND ONLY WHERE THE LIST IS THE DECLARATION'S OWN — `bareCommaList`, which the NESTED caller
			// passes false.** Inside a parenthesized list a comma belongs to the ENCLOSING list, so a greedy
			// nested reading would turn `Box with (Map with String, Int)` from a two-argument `Box` into a
			// one-argument `Box` over a two-argument `Map` — the same tokens, two meanings, decided by whichever
			// reader ran first. The outermost list of a `typealias` is terminated by the end of the declaration
			// and has no such second claimant, which is exactly why the form is unambiguous there and nowhere else.
			if not bareCommaList 'oneArgumentOnly'
				return (1, spelled.shape())
			end 'oneArgumentOnly'

			var bareCount = 1 as FieldIndex

			while self.at(TokenKind.comma) 'moreBareArgs'
				try self.consume(TokenKind.comma)
				try self.requireGenericArgPositionFits(bareCount)
				let laterQualifier = try self.parseGenericArgNode(nodes, baseName: baseName, inlineElement: inlineElement, slot: slot, position: bareCount)
				spelled = spelled.qualifying(bareCount, qualifier: laterQualifier)

				bareCount = bareCount + 1
			end 'moreBareArgs'

			return (bareCount, spelled.shape())
		end 'unparenthesized'

		try self.consume(TokenKind.leftParen)
		var count = 0 as FieldIndex

		while true 'argLoop'
			try self.requireGenericArgPositionFits(count)
			let qualifier = try self.parseGenericArgNode(nodes, baseName: baseName, inlineElement: inlineElement, slot: slot, position: count)

			spelled = spelled.qualifying(count, qualifier: qualifier)

			count = count + 1

			if not self.at(TokenKind.comma) 'doneArgs'
				break
			end 'doneArgs'

			try self.consume(TokenKind.comma)
		end 'argLoop'

		try self.consume(TokenKind.rightParen)

		return (count, spelled.shape())
	end 'parseGenericArgNodes'

	function requireGenericArgPositionFits(position FieldIndex) throws SourceParseError
		if position < MaxGenericTypeArgs as FieldIndex 'withinTheMask'
			return
		end 'withinTheMask'

		let tok = self.current()
		throw SourceParseError.unsupported("a type-argument list with more than {MaxGenericTypeArgs} arguments — an argument spelled `{String.from(ImmutableCapabilityWord)}` are recorded as one bit per position of a {MaxGenericTypeArgs}-bit mask, so an instance has no position to record a later argument at", line: tok.line, column: tok.column)
	end 'requireGenericArgPositionFits'

	function mutableMarkerAt(index ElementIndex) returns bool
		return self.qualifiers.qualifiesAt(index) and self.tokenAt(index).value.equals(MutableMarkerWord) and self.kindAt(index + 1) != TokenKind.self
	end 'mutableMarkerAt'

	function functionValueHeaderHasAMarkerAt(index ElementIndex) returns bool
		if self.kindAt(index) != TokenKind.function or self.kindAt(index + 1) != TokenKind.leftParen 'notAFunctionValueHeader'
			return false
		end 'notAFunctionValueHeader'

		var depth = 0 as NestingDepth
		var q = index + 1

		while self.kindAt(q) != TokenKind.eof 'walk'
			let kind = self.kindAt(q)

			if kind == TokenKind.leftParen 'opens'
				depth = depth + 1
			end 'opens' else if kind == TokenKind.rightParen 'closes'
				depth = depth - 1

				if depth == 0 'headerEnds'
					return false
				end 'headerEnds'
			end 'closes' else if depth == 1 and self.mutableMarkerAt(q) 'aMarker'
				return true
			end 'aMarker'

			q = q + 1
		end 'walk'

		return false
	end 'functionValueHeaderHasAMarkerAt'

	function paramMarkerAt(nameIndex ElementIndex) returns bool
		return self.mutableMarkerAt(nameIndex + 1)
	end 'paramMarkerAt'

	function declaredParamCapabilityAt(nameIndex ElementIndex) returns ParamCapability
		let afterMarker = nameIndex + 2 if self.paramMarkerAt(nameIndex) else nameIndex + 1
		let written = self.paramCapabilityAt(afterMarker)

		if written == ParamCapability.unmarked and self.paramMarkerAt(nameIndex) 'markedOnly'
			return ParamCapability.mutable
		end 'markedOnly'

		return written
	end 'declaredParamCapabilityAt'

	function paramCapabilityIndexAfter(nameIndex ElementIndex) returns ElementIndex
		return nameIndex + 2 if self.paramMarkerAt(nameIndex) else nameIndex + 1
	end 'paramCapabilityIndexAfter'

	function paramTypeStartAfter(nameIndex ElementIndex) returns ElementIndex
		let afterMarker = self.paramCapabilityIndexAfter(nameIndex)
		return afterMarker + 1 if self.paramCapabilityAt(afterMarker) != ParamCapability.unmarked else afterMarker
	end 'paramTypeStartAfter'

	function markedTypeTakesAReference(spelled MaxonType) returns bool
		let tag = maxonTypeTag(spelled)
		return match tag 'tag'
			named or
			structRef or
			interfaceRef gives self.signatures.markedHeadTakesAReference(self.internedName(typeNameIdOf(spelled)), readerFilePath: self.job.path)
			genericInstance gives self.signatures.markedGenericInstanceTakesAReference(genericInstanceIdOf(spelled), readerFilePath: self.job.path)
			boolean or
			integer or
			float or
			exitCode or
			unresolved or
			void or
			string or
			typeParameter or
			character or
			cstring or
			function gives true
		end 'tag'
	end 'markedTypeTakesAReference'

	function byReferenceMarkersOf(markers BoolArray, paramTypes MaxonTypeArray, capabilities ParamCapabilityArray) returns ParamPositionMask
		var mask = NoParamPositions

		for (iter, marked) in markers.withIterator() 'eachParam'
			let headTakesAReference = self.markedTypeTakesAReference(try paramTypes.get(iter.index()) otherwise panic("byReferenceMarkersOf: paramTypes.get OOB at {iter.index()} below the {paramTypes.count()} parameters"))

			if marked and markedParamTakesAReference(try capabilities.get(iter.index()) otherwise panic("byReferenceMarkersOf: capabilities.get OOB at {iter.index()} below the {capabilities.count()} parameters"), headTakesAReference: headTakesAReference) 'aReferenceParameter'
				mask = maskWithParam(mask, param: iter.index() as ParamCount)
			end 'aReferenceParameter'
		end 'eachParam'

		return mask
	end 'byReferenceMarkersOf'

	function markedParamTypeHead(nameIndex ElementIndex) returns immutable ByteArray
		if self.declaredParamCapabilityAt(nameIndex) != ParamCapability.mutable 'aCapabilityWordDecidesIt'
			return EmptySourceText
		end 'aCapabilityWordDecidesIt'

		let typeStart = self.paramTypeStartAfter(nameIndex)

		if self.kindAt(typeStart) == TokenKind.selfType 'theEnclosingType'
			return self.enclosingTypeNameOrEmpty()
		end 'theEnclosingType'

		if self.kindAt(typeStart) != TokenKind.identifier 'notANamedType'
			return EmptySourceText
		end 'notANamedType'

		return chainSpellingAt(self.tokens, at: typeStart, segments: self.dottedChainLengthAt(typeStart))
	end 'markedParamTypeHead'

	function paramMarkerFactsOf(parenPos ElementIndex, firstPosition ParamCount) returns ParamMarkerFacts
		var written = NoParamPositions
		let heads = NameRoster.create(0)

		for _ in 0 upto firstPosition 'theReceiverSlots'
			heads.push(EmptySourceText)
		end 'theReceiverSlots'

		let first = parameterListStartIn(self.tokens, open: parenPos)

		if self.kindAt(parenPos) != TokenKind.leftParen or self.kindAt(first) == TokenKind.rightParen 'noParams'
			return ParamMarkerFacts.create(written, heads: heads)
		end 'noParams'

		var q = first
		var position = firstPosition

		while true 'params'
			if position >= MaxAbiArgs 'pastTheMask'
				return ParamMarkerFacts.create(written, heads: heads)
			end 'pastTheMask'

			if self.paramMarkerAt(q) 'aMarkedParameter'
				written = maskWithParam(written, param: position)
				heads.push(self.markedParamTypeHead(q))
			end 'aMarkedParameter' else 'anUnmarkedParameter'
				heads.push(EmptySourceText)
			end 'anUnmarkedParameter'

			let itemEnd = self.paramItemEndFrom(self.skipParamType(self.paramTypeStartAfter(q)))

			if self.kindAt(itemEnd) != TokenKind.comma 'endList'
				return ParamMarkerFacts.create(written, heads: heads)
			end 'endList'

			q = itemEnd + 1
			position = position + 1
		end 'params'

		panic("paramMarkerFactsOf: the parameter loop only exits by returning at the closing `)` or EOF")
	end 'paramMarkerFactsOf'

	function callAlignedMarkerFacts(parenPos ElementIndex, takesReceiver bool) returns ParamMarkerFacts
		var first = 0 as ParamCount

		if takesReceiver 'theReceiverTakesSlotZero'
			first = 1
		end 'theReceiverTakesSlotZero'

		return self.paramMarkerFactsOf(parenPos, firstPosition: first)
	end 'callAlignedMarkerFacts'

	function qualifierWordAt(index ElementIndex) returns immutable ByteArray throws AbsentError
		if not self.qualifiers.qualifiesAt(index) 'notAQualifierPosition'
			throw AbsentError.absent
		end 'notAQualifierPosition'

		return self.tokenAt(index).value
	end 'qualifierWordAt'

	function paramCapabilityAt(index ElementIndex) returns ParamCapability
		let word = try self.qualifierWordAt(index) otherwise return ParamCapability.unmarked
		return try capabilityOfWord(word) otherwise ParamCapability.unmarked
	end 'paramCapabilityAt'

	function readParamCapability() returns ParamCapability throws SourceParseError
		let capability = self.paramCapabilityAt(self.pos)

		if capability == ParamCapability.unmarked 'unqualified'
			return ParamCapability.unmarked
		end 'unqualified'

		try self.consume(TokenKind.identifier)
		return capability
	end 'readParamCapability'

	function typeAdmitsACapability(spelled MaxonType) returns bool
		if not self.signatures.allFilesFolded 'theSweep'
			return true
		end 'theSweep'

		let tag = maxonTypeTag(spelled)

		if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef 'aParameterOrExistential'
			return true
		end 'aParameterOrExistential'

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return not self.signatures.genericInstanceBaseName(genericInstanceIdOf(spelled)).equals(PromiseTypeName)
		end 'anInstance'

		if tag != ValueTypeTag.structRef and tag != ValueTypeTag.named 'notARecordTag'
			return false
		end 'notARecordTag'

		let name = self.internedName(typeNameIdOf(spelled))

		// A union with a payload holds a record and is a region of its own; a payload-free one, like an enum, is
		// a bare tag with nothing to qualify.
		if self.signatures.containsEnumInAnyFile(name) 'aUnion'
			return self.signatures.enumNameIsBoxed(name)
		end 'aUnion'

		return self.signatures.containsStructInAnyFile(name) and not self.signatures.isServiceHandle(name)
	end 'typeAdmitsACapability'

	function requireCapabilityFits(capability ParamCapability, wordTok Token, spelled MaxonType) throws SourceParseError
		if capability == ParamCapability.unmarked or self.typeAdmitsACapability(spelled) 'fits'
			return
		end 'fits'

		throw notATypeError(wordTok)
	end 'requireCapabilityFits'

	function readCapabilityQualifiedType(voice BarePrimitiveVoice) returns (MaxonType, ParamCapability) throws SourceParseError
		let wordTok = self.current()
		let written = try self.readParamCapability()
		let typeTok = self.current()
		let spelled = try self.parseTypeReference(voice)

		try self.requireCapabilityFits(written, wordTok: wordTok, spelled: spelled)

		return (spelled, self.aliasCapabilityOr(written, typeTok: typeTok))
	end 'readCapabilityQualifiedType'

	function aliasCapabilityOr(written ParamCapability, typeTok Token) returns ParamCapability
		let spelling = typeTok.value if typeTok.kind == TokenKind.identifier else EmptySourceText
		return self.signatures.capabilityOfSpelledType(written, spelling: spelling, readerFilePath: self.job.path)
	end 'aliasCapabilityOr'

	function containerElementTakesAQualifier(baseName ByteArray, position FieldIndex) returns bool
		if baseName.equals(MapBuiltinBaseName) 'aMap'
			return position == MapValueArgPosition
		end 'aMap'

		return (baseName.equals(ListBuiltinBaseName) or self.signatures.isArrayBaseName(baseName)) and position == 0
	end 'containerElementTakesAQualifier'

	function frozenMayQualify(baseName ByteArray, position FieldIndex, inlineElement bool, slot GenericArgSlot) returns bool
		if self.containerElementTakesAQualifier(baseName, position: position) 'anElementOrValue'
			return true
		end 'anElementOrValue'

		if inlineElement or baseName.equals(MapBuiltinBaseName) or baseName.equals(SetBuiltinBaseName) or baseName.equals(PromiseTypeName) 'aStorageNoDoorGuards'
			return false
		end 'aStorageNoDoorGuards'

		return match slot 'slot'
			containerElement gives true
			associatedTypeBinding gives false
		end 'slot'
	end 'frozenMayQualify'

	function requireQualifierAllowedAt(qualifier GenericArgQualifier, baseName ByteArray, position FieldIndex, inlineElement bool, slot GenericArgSlot, tok Token) throws SourceParseError
		match qualifier 'qualifier'
			frozen then try self.requireFrozenAllowedAt(baseName, position: position, inlineElement: inlineElement, slot: slot, tok: tok)
			plain then panic("requireQualifierAllowedAt: an unqualified argument has no word to place")
		end 'qualifier'
	end 'requireQualifierAllowedAt'

	function requireFrozenAllowedAt(baseName ByteArray, position FieldIndex, inlineElement bool, slot GenericArgSlot, tok Token) throws SourceParseError
		if self.frozenMayQualify(baseName, position: position, inlineElement: inlineElement, slot: slot) 'aStoreTheDoorsGuard'
			return
		end 'aStoreTheDoorsGuard'

		throw notATypeError(tok)
	end 'requireFrozenAllowedAt'

	// ⭐ **ONE generic-instance argument** — a LEAF type reference (`Integer`, `Point`,
	// `String`), or a NESTED instance `Inner with (…)`, since managed instances are owned and dropped. A
	// nested instance's gid is not known at parse time (interning lives in `recordGenericAlias`), so it is
	// FLATTENED pre-order: an `instanceHeader(base, k)` node followed by its `k` args' nodes. Its own `with`
	// is noted here as the outer one is, so `checkGenericSpellings` judges a malformed nested base
	// (`Box with (Plain with Integer)`, wrong arity) too. The header is pushed BEFORE its sub-args (parsed
	// into a temp so the header's count is known), preserving pre-order.
	function parseGenericArgNode(nodes GenericArgNodeArray, baseName ByteArray, inlineElement bool, slot GenericArgSlot, position FieldIndex) returns GenericArgQualifier throws SourceParseError
		let qualifierTok = self.current()
		let written = self.paramCapabilityAt(self.pos)

		if written == ParamCapability.isolated or written == ParamCapability.mutable 'aRegionOwningArgument'
			throw notATypeError(qualifierTok)
		end 'aRegionOwningArgument'

		var qualifier = GenericArgQualifier.plain

		if self.peekKind() != TokenKind.leftParen 'notAListQualifier'
			if written == ParamCapability.immutable 'spelledFrozen'
				qualifier = GenericArgQualifier.frozen
			end 'spelledFrozen'
		end 'notAListQualifier'

		if qualifier != GenericArgQualifier.plain 'qualified'
			try self.requireQualifierAllowedAt(qualifier, baseName: baseName, position: position, inlineElement: inlineElement, slot: slot, tok: qualifierTok)
			try self.consume(TokenKind.identifier)
		end 'qualified'

		if self.atGenericBaseName(self.pos) 'nested'
			let base = try self.consumeGenericBaseName()
			try self.consume(TokenKind.with)

			// ⭐ **A NESTED INSTANCE READS ITS SIZE THROUGH THE SAME DOOR THE TOP-LEVEL ONE DOES (review
			// finding 5).** Without it `typealias X = Box with (FixedArray with 3 Int)` died as
			// `E2010 Expected 'a type' but got 'integer literal'` — the raw token complaint the top-level
			// spelling stopped giving the moment `FixedArray` existed — instead of reaching E2069 or the element
			// gate. This arm had already been taught the OTHER `FixedArray`-specific fact (`inlineElement` below),
			// so the asymmetry was an omission and not a decision.
			let subSize = try self.readSizedBaseElementCount(base.written)

			// The canonical base, for the top-level arm's reason: a nested `__ManagedMemory with T` must
			// intern to the same instance a nested `Array with T` does, or one record has two ids.
			let subBaseName = self.canonicalGenericBaseNameInThisFile(base.denoted)
			let subNodes = GenericArgNodeArray.create(0)
			let (subCount, subQualified) = try self.parseGenericArgNodes(subNodes, baseName: subBaseName, inlineElement: self.baseStoresArgumentsInline(subBaseName), bareCommaList: false, slot: self.signatures.genericArgSlotOf(subBaseName))
			self.noteGenericSpelling(base, baseName: subBaseName, argCount: subCount)
			nodes.push(GenericArgNode.instanceHeader(subBaseName, argCount: subCount, shape: subQualified if subQualified.qualifiesArgs() else subSize))
			nodes.append(subNodes)
			return qualifier
		end 'nested'

		let argTok = self.current()
		let argType = try self.parseTypeReference(BarePrimitiveVoice.admitted)

		if not self.namesAnExtensionAssociatedType(argTok) 'aBindingJudgedAtItsConformer'
			try self.requireCarryableGenericArg(argType, slot: slot, position: position, argTok: argTok)
		end 'aBindingJudgedAtItsConformer'

		self.noteInterfaceBindingHeldAsArgument(argType, argTok: argTok, baseName: baseName, position: position)
		self.checkGenericArgType(argType, argTok: argTok, inlineElement: inlineElement)

		if self.argDenotesTheEnclosingGenericType(argType) 'theEnclosingGenericType'
			self.pushEnclosingInstanceNodes(nodes)
			return qualifier
		end 'theEnclosingGenericType'

		nodes.push(GenericArgNode.leaf(argType))
		return qualifier
	end 'parseGenericArgNode'

	// `Self` in a generic body is the bare base (`enclosingSelfType`; `scopedGenericInstanceOf` says why), which
	// carries no `T`. As a type argument it is written over the type's own parameters instead: a container of
	// the bare base takes the static create route, whose shallow element drop leaks each element's managed
	// fields.
	function argDenotesTheEnclosingGenericType(argType MaxonType) returns bool
		if maxonTypeTag(argType) != ValueTypeTag.structRef or self.enclosingTypeParams.isEmpty() or not self.enclosingType.isType() 'notAGenericBodyStruct'
			return false
		end 'notAGenericBodyStruct'

		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(argType)) otherwise panic("argDenotesTheEnclosingGenericType: a `structRef` argument's id is not in this file's interner — `parseTypeReference` interned it from a name in the same table")
		return self.namesEnclosingType(name)
	end 'argDenotesTheEnclosingGenericType'

	function pushEnclosingInstanceNodes(nodes GenericArgNodeArray)
		let owner = self.enclosingTypeName()
		nodes.push(GenericArgNode.instanceHeader(owner, argCount: self.enclosingTypeParams.count() as FieldIndex, shape: InstanceShape.unsized))

		for paramName in self.enclosingTypeParams 'eachParameter'
			nodes.push(GenericArgNode.leaf(MaxonType.typeParameter(typeParamTokenFor(owner, paramName: paramName))))
		end 'eachParameter'
	end 'pushEnclosingInstanceNodes'

	// ⭐ **WHAT A TYPE ARGUMENT MAY BE — THREE RULES, AND THE ORDER IS LOAD-BEARING, NOT TIDINESS.**
	//
	// **1. It may not resolve to `float` (E2062) UNLESS IT NAMES AN INLINE BUFFER ELEMENT** — bare or through
	// a ranged float alias. A COMPILER limitation, not a language rule: dictionary-passing gives a type
	// parameter a general-purpose slot, which a float cannot travel in. ONE rule with ONE message, decided at
	// TWO points, and each placement is forced. The BARE keyword goes before rule 2, because a bare `float`
	// satisfies rule 2 as well and rule 2's workaround is a trap for it. The ALIAS goes after rule 3 — a name
	// must denote something before it can denote a float, and rule 3's answer already carries the domain, so
	// asking there is free where asking separately is a heap box per argument.
	//
	// ⭐⭐ **THE `inlineElement` EXEMPTION, AND WHAT IT IS AND IS NOT.** The rule's own stated reason is about a
	// TYPE PARAMETER's opaque slot; a `FixedArray with 2 Real`'s element is not one — it is a stride in a buffer,
	// written and read as its 64 BITS (`containerElementWord` / `containerSlotValueType`), which is machinery
	// this port had to build for `/specs/fixed-array.md`'s float cases and which works. So the exemption is exactly
	// as wide as the reason is narrow.
	//
	// ⚠⚠ **`Array` IS IN IT TOO, BECAUSE THE COMPILER ALREADY MINTS AND RUNS THE VERY INSTANCE THE
	// REFUSAL NAMED.** `[1.5, 2.5]` types as `Array with float` — the literal's instance is minted rather
	// than read off a `Base with Args`, so it never reached this check — and that instance stores, loads,
	// clones and iterates end to end. Refusing the same type when a program NAMES it would be a POLICY rather
	// than a limitation, and an expensive one: without a nameable element type a float array cannot leave the
	// expression that built it. E2062's stated reason — an opaque 8-byte
	// general-purpose slot — is simply not true of a buffer stride. `Box with float`, where it IS true,
	// still earns the refusal, and `error.float-type-arg` still pins that.
	//
	// **2. It may not be a BARE NUMERIC KEYWORD (E2061).** A bare `int` is minted CONCRETE by
	// `parseTypeReference`, so it too is answered before the `named` cascade it never enters.
	//
	// **3. If it NAMES something, that name must denote a type (E3011).** `checkGenericSpellings` judges
	// the BASE and the ARITY and nothing else, so without this rule `typealias BadArray = Array with
	// UnknownType` compiles, runs and returns an answer — a silent acceptance of a program naming a type the program does not have,
	// which is the one class of defect a suite cannot catch by being green. The runnable oracle rejects it,
	// and so does this.
	//
	// Rule 3 asks `denotedNamedType` — the ONE cascade every reader of a named type asks — so an
	// argument and a cast target can never come to disagree about what a name means. Only a `named` type can
	// be in question THERE: `parseTypeReference` has already answered every spelling it settles syntactically
	// (`Self`, the enclosing type's own name, `String`, a type PARAMETER, a bare inner alias, a
	// generic-instance alias, a function alias, the primitive keywords) with a concrete arm, and a
	// `typeParameter`/`genericInstance`/`structRef` argument is exactly the legal case that must not be
	// refused. Which is precisely why rules 1 and 2 cannot be expressed as extra arms of that cascade — the
	// tags they reject are ones the cascade is never reached for.
	//
	// ⚠ **RECORDED, NOT THROWN, AND NOT COMPUTED AT ALL UNTIL THE INDEX IS WHOLE-PROGRAM**
	// (`signatures.allFilesFolded`). A throw would abort the file's parse over a semantic verdict. And a
	// generic-instance or function alias declared later in the program — or anywhere in this file, whose
	// own declarations fold only after its whole token walk — legitimately reads "undeclared" during the
	// sweep, so the sweep's verdict is not merely discarded, it is systematically wrong.
	//
	// ⚠ **A `b"…"` BYTE-STRING NEEDS NO EXEMPTION, and that is a property of where its instance comes from.**
	// The compiler MINTS `Array with Byte` for a byte-string literal (`internArrayByteInstance`) rather than
	// reading it off a `Base with Args` in source, so a byte string never reaches this check at all. A program
	// that WRITES `Array with Byte` declares its own `typealias Byte = int(0 to u8.max)` — a ranged alias the
	// cascade resolves — which is exactly what `undeclaredNamedElementSlot` means when it says no user
	// type can name the literal's own instance.
	function checkGenericArgType(argType MaxonType, argTok Token, inlineElement bool)
		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		let tag = maxonTypeTag(argType)

		// ⭐ **A FLOAT TYPE ARGUMENT IS REFUSED, HOWEVER IT IS SPELLED (E2062).** The compiler DICTIONARY-PASSES
		// rather than monomorphizing, so a type parameter is one opaque 8-byte GENERAL-PURPOSE slot; a float
		// is born in XMM and has no way to travel through it. Both spellings reach the same x64
		// cross-register-file assertion — MEASURED: bare `Box with float` and `Box with Real` over
		// `typealias Real = float(f64.min to f64.max)` panic identically — so refusing only the bare keyword
		// would leave the panic reachable through the very alias E2061 recommends.
		//
		// ⚠ **THE BARE ARM IS ASKED BEFORE E2061, AND THAT ORDER IS THE POINT, not a tidy-up.** A bare
		// `float` satisfies BOTH rules — `tagIsBareNumericKeyword` genuinely admits it, which is what makes
		// this a resolved OVERLAP rather than two disjoint tests in an arbitrary sequence — and E2061's
		// advice ("declare a ranged typealias") is TRUE for `int` and a TRAP for `float`. Asking float first
		// is what stops this compiler from routing a reader into a crash with its own diagnostic, and
		// `error.float-type-arg` is the spec case that turns RED the moment the two arms are swapped. The
		// ALIAS spelling is decided further down instead, off the name cascade's own answer — see there for
		// why that is the cheap place and not merely the late one.
		//
		// ⭐ **ON A BUFFER BASE THE OVERLAP RESOLVES THE OTHER WAY, AND IT DOES SO BY ITSELF.** The
		// exemption drops this arm, E2061 takes the bare keyword back, and its advice is not a trap
		// there but a working program: `Array with float` is E2061, and the `typealias Real = float(…)` it
		// recommends compiles. Two rules, one keyword, and which one answers is decided by whether the
		// workaround exists — pinned in both directions by `error.bare-float-type-arg-on-a-buffer-base` and
		// `error.float-type-arg`.
		//
		// ⚠ **A DELIBERATE DIVERGENCE FROM BOTH REFERENCES**, which accept a float type argument because
		// they MONOMORPHIZE — the instantiation gets a genuine f64 slot and the question never arises. This
		// is a COMPILER limitation, not a language rule, so the message names no workaround:
		// there is none. It retires when a float register class for descriptor-typed values lands,
		// and until then the diagnostic is what makes that a decision someone takes rather than a panic
		// someone trips over.
		if tagIsFloat(tag) and not inlineElement 'bareFloatArg'
			self.recordArtifactDiagnostic(ErrorCode.genericFloatTypeArg, message: floatTypeArgMessage(typeTagName(tag)), range: SourceRange.ofToken(argTok))
			return
		end 'bareFloatArg'

		// ⭐ **A BARE `int` IS NOT A TYPE ARGUMENT (E2061)** — the ranged-typealias rule reaching the one
		// type position that never enforced it. Everywhere else a numeric domain must be DECLARED
		// (`typealias Integer = int(i64.min to i64.max)`); a `with` clause let the keyword straight through,
		// and it was silently ACCEPTED. `bool` is DELIBERATELY ADMITTED — it is already a constrained type,
		// with no range to name — as are `String`, a user type, a type PARAMETER, a nested instance, and the
		// ranged INT alias this message names, which is verified to work.
		//
		// It is a TAG test, and it has to be: a bare keyword is minted CONCRETE by `parseTypeReference`
		// (`MaxonType.integer`, never `named`), so it never reached the name cascade below — which is
		// exactly what hid it.
		//
		// ⚠ **IT ASKS FOR THE WHOLE SET — `int` AND `float` — AND RELIES ON THE ARM ABOVE HAVING TAKEN THE
		// FLOAT.** Narrowing this guard to `tagIsInteger` would state the rule as "the bare numeric keywords,
		// minus whatever an earlier arm happened to claim", which reads identically whether the author knew
		// about the overlap or never heard of it — and it would make the ordering above unfalsifiable, since
		// two disjoint equality tests can be swapped with no effect at all. Stated whole, a swap is a
		// behaviour change the suite catches.
		if tagIsBareNumericKeyword(tag) 'barePrimitive'
			// ⚠ **REPORTED AT THE OFFENDING ARGUMENT, NOT AT THE ALIAS NAME — a deliberate divergence from the
			// oracle**, which passes its `aliasNameToken` (`RejectBarePrimitiveTypeArgs`, all three call
			// sites) and so points at the name LEFT of the `=`, away from the token that has to change. Two
			// reasons the argument wins: the E3011 arm below already reports at `argTok`, so one function
			// would otherwise answer one question from two columns; and no corpus case asserts the column.
			let spelling = typeTagName(tag)
			self.recordArtifactDiagnostic(ErrorCode.genericBarePrimitiveArg, message: "Cannot use bare type '{spelling}' as a type argument; use a ranged typealias instead (e.g. typealias MyType = {spelling}(...))", range: SourceRange.ofToken(argTok))
			return
		end 'barePrimitive'

		if tag != ValueTypeTag.named 'alreadyConcrete'
			return
		end 'alreadyConcrete'

		let nameId = typeNameIdOf(argType)
		let name = self.internedName(nameId)
		let denoted = try denotedNamedType(self.signatures, name: name, id: nameId, readerFilePath: self.job.path) otherwise 'undeclared'
			self.recordArtifactDiagnostic(ErrorCode.unknownType, message: unknownTypeMessage(self.signatures.aliasIdentityDisplay(name)), range: SourceRange.ofToken(argTok))
			return
		end 'undeclared'

		// ⭐ **THE FLOAT RULE'S SECOND SPELLING (E2062), READ OFF THE CASCADE'S OWN ANSWER** — a ranged FLOAT
		// alias, whose `named` tag says nothing about the domain behind it. It is asked HERE, after E3011
		// rather than beside the bare arm above, for two reasons and both are load-bearing:
		//
		// **1. A name must denote something before it can denote a float.** The domain of a name the program
		// does not declare is a question with no answer, and E3011 is the honest verdict.
		//
		// **2. HERE IT COSTS NOTHING, WHERE ASKING SEPARATELY COST ONE HEAP BOX PER ARGUMENT.**
		// `denotedNamedType` erases a plain ranged alias to its UNDERLYING primitive, so the answer is
		// already in its result — and this call was being made anyway, its value discarded into `_`. The
		// obvious alternative, `resolveFloatAliasType`, reaches the registry through `aliasOf`, which hands
		// back a payload union Maxon HEAP-BOXES per call; `denotedNamedType` deliberately goes through
		// `aliasUnderlyingFor` instead, which hands back the primitive rather than a `DeclaredAlias`
		// that would be heap-boxed per call. MEASURED on the scale
		// ladder: the separate lookup cost **+16 / +30 / +58 allocations of 16 bytes** over three steps — one
		// box per named type argument, linear in the program — and reading it off the cascade is delta-ZERO.
		//
		// A declared `enum`/`union` erases to `integer` here (a float-BACKED enum too — its bits ARE an i64)
		// and a struct stays `structRef`, so `float` reaches this test only from a genuine float alias.
		if tagIsFloat(maxonTypeTag(denoted)) and not inlineElement 'floatAliasArg'
			// Named by the ALIAS the source wrote, not by `float`: a reader told "cannot use 'float'" about a
			// line that says `FullRangeFloat` would have to work out which of its aliases is meant.
			self.recordArtifactDiagnostic(ErrorCode.genericFloatTypeArg, message: floatTypeArgMessage(self.signatures.aliasIdentityDisplay(name)), range: SourceRange.ofToken(argTok))
			return
		end 'floatAliasArg'
	end 'checkGenericArgType'

	// The ONE wording of "a float type argument is not supported yet", shared by the two spellings that
	// reach it — the bare `float` keyword and a ranged float alias. They are decided at different points of
	// `checkGenericArgType` (one syntactically, one off the name cascade) and must not be free to drift into
	// two texts for one rule; `spelling` is the only thing that legitimately differs between them.
	function floatTypeArgMessage(spelling String) returns String
		return "Cannot use '{spelling}' as a type argument: a float type argument is not supported yet. A type parameter is an opaque 8-byte general-purpose slot under the compiler's dictionary-passing, and a float value travels in a floating-point register, so it has no way through"
	end 'floatTypeArgMessage'

	// Pushed above the `allFilesFolded` gate because only sweep folds drain this sink, and every fold exit
	// drains it whether or not it publishes: a site skipped either way is an arity error never reported.
	function noteGenericSpelling(base GenericBaseName, baseName ByteArray, argCount FieldIndex)
		if self.collectsWithSites 'aSweepReader'
			self.readGenericWithSites.push(GenericWithSite.create(self.job.path, written: base.written, baseName: baseName, argCount: argCount, line: base.anchor.line, column: base.anchor.column))
		end 'aSweepReader'

		if not self.signatures.allFilesFolded 'indexStillBuilding'
			return
		end 'indexStillBuilding'

		if self.signatures.isBuiltinGenericBaseName(baseName) or containsQualifier(base.written) 'noAliasCanBeMeant'
			return
		end 'noAliasCanBeMeant'

		if self.signatures.writtenNameMeansAnAliasHere(baseName, readerFilePath: self.job.path) 'anAliasIsMeantNotAGenericType'
			self.recordTypeNameUse(base.written)
		end 'anAliasIsMeantNotAGenericType'
	end 'noteGenericSpelling'

	function drainGenericWithSitesInto(index ProgramSignatures)
		index.recordGenericWithSites(self.readGenericWithSites)
		self.readGenericWithSites.clear()
		self.collectsWithSites = false
	end 'drainGenericWithSitesInto'

	function genericArgumentCountRefusal(layout StructLayout, supplied ElementIndex, baseTok Token) returns SourceParseError
		return self.genericBaseRefusal(genericArgumentCountCode(layout), message: genericArgumentCountMessage(layout, supplied: supplied as FieldIndex), tok: baseTok)
	end 'genericArgumentCountRefusal'

	function undeclaredGenericBaseRefusal(typeName ByteArray, tok Token) returns SourceParseError
		return self.genericBaseRefusal(ErrorCode.genericBaseNotGeneric, message: baseNotGenericMessage(typeName), tok: tok)
	end 'undeclaredGenericBaseRefusal'

	// The thrown twin of a reported E2055 or E2056: `Queries.reportedArityMessages` drops it as a consequence
	// only when its message equals the reported one, so `message` must spell the base exactly as the
	// reported diagnostic does.
	function genericBaseRefusal(code ErrorCode, message String, tok Token) returns SourceParseError
		return SourceParseError.genericArgumentCountRefused(code, explanation: message, line: tok.line, column: tok.column)
	end 'genericBaseRefusal'

	// Parse `function(paramTypes) [returns T]` on a typealias RHS, the cursor sitting on
	// `function`. The whole declared SIGNATURE is stored INTERNER-FREE (a tag + a name per parameter and for
	// the return) so it rides the no-remap fold, plus the type names the author wrote, which E3167 and the
	// unused-export audit judge. An absent `returns` clause is a void function type.
	//
	// ⚠ **ONLY THE REAL PARSE MAY VETO OR CLASSIFY, and that is a property of the SWEEP rather than an
	// optimization.** `parseTypeReference` answers a type spelling differently during the whole-program token
	// sweep — `isFunctionAliasFor`/`isAliasOfFormFor` consult the very registries the sweep is still
	// building, so a parameter spelled with a function or generic alias reads back as a bare `named`
	// there. The sweep and the nested-alias reader therefore pass `recordSignature: false`: their copy
	// carries every slot's tag and identity columns as the sweep read them, and no storability refusal
	// or aggregate name. Whole-program consumers read the real parse's copy in
	// `project.functionTypeAliases`; a reader of the sweep's copy repairs its `named` leaves from
	// `declFilePath`.
	function readFunctionTypeAlias(nameTok Token, recordSignature bool, visibility Visibility) returns FunctionTypeAlias throws SourceParseError
		try self.consume(TokenKind.function)
		try self.consume(TokenKind.leftParen)

		// Two lists off one parse: the `MaxonType`s the display string renders (this file's interner ids, used
		// and dropped here) and the interner-free `(tag, name)` pairs the alias stores. The empty arrays a
		// sweep still constructs grow no heap buffer — an `Array`'s backing storage is allocated lazily on the
		// first `push`, which a sweep never makes.
		let paramTypes = MaxonTypeArray.create(0)
		let declaredParams = FunctionAliasParamArray.create(0) as isolated FunctionAliasParamArray

		// ⭐⭐ **THE ONE PARAMETER FACT BOTH PASSES CAN MINT — see `FunctionTypeAlias.paramSpelling`.** Folded
		// UNCONDITIONALLY, outside every `recordSignature` gate below, because the SWEEP's copy is the only one
		// the whole-program index ever receives and the hash is the only thing this is for.
		var paramSpelling = Hasher.empty()
		let writtenNames = NameRoster.create(0)
		let writtenEnds = WrittenTypeNameEnds.create(0)
		var typeSites = DeclaredTypeSites.create() as isolated DeclaredTypeSites

		if not self.at(TokenKind.rightParen) 'params'
			while true 'paramLoop'
				let paramAnchor = self.tokenAt(self.pos)
				let paramStart = self.pos
				let (paramType, paramCapability, paramName, paramMarked) = try self.readFunctionTypeParam(writtenNames, sites: typeSites)

				// ⛔⛔ **THE BOUNDARY IS FOLDED HERE AND IT IS THE WHOLE ARITY.** Without it the digest is a flat
				// fold of token texts in which the GROUPING — the only thing the separator means — is absent:
				// `function(A, B)` (two parameters) and `function(A B)` (ONE parameter NAMED `A` of type `B`)
				// fold the identical sequence and MEASURED the identical value, `-5381244596860584822` both ways,
				// with the alias name and the return slot unchanged — so the alias's whole hash contribution
				// collided across an edit that changes ARITY, which is what `checkIndirectCallArgs` refuses on and
				// what `paramFloatMask` builds its register classes from. Widening the range over the comma does
				// NOT fix it: a punctuator's text is empty (see `mixWrittenTokens`). It is folded AFTER each
				// parameter rather than between them so the count of boundaries IS the count of parameters, which
				// the tolerant sweep can supply without a counter it does not keep.
				paramSpelling = Hasher.combined(self.mixWrittenTokens(paramSpelling, from: paramStart, to: self.pos), value: FunctionAliasParamBoundary)

				if recordSignature 'collectParam'
					// ⭐ REFUSED HERE, and `recordSignature` is what keeps the tolerant declaration sweep out of it: the
					// sweep passes `false` and must never veto, exactly as it must not for the six sibling positions.
					// This is the ONLY place a function type's parameter list is parsed — an inline `function(...)` in a
					// parameter position is E2010 — so one call site covers the position.
					try self.requireStorableDeclaredType(paramType, position: DeclaredStoragePosition.functionTypeParameter, line: paramAnchor.line, column: paramAnchor.column)
					paramTypes.push(paramType)
				end 'collectParam'

				// The one parameter fact the sweep cannot read identically, for `returnAggregateName`'s reason below.
				let paramAggregateName = self.erasedAggregateNameOf(paramType) if recordSignature else EmptySourceText

				// ⭐ **BOTH PASSES RECORD THE SLOT, EACH AS IT READS IT** — the return slot's arrangement. The sweep's
				// copy is the only one a call site in ANOTHER file can reach while that file is parsed, and a closure
				// literal written at a parameter of this type takes its parameter types from it
				// (`Parser.closureParamOfferAt`), repairing the tolerant `named` leaves from `declFilePath`.
				let storedParam = self.storedFunctionAliasParam(paramType, name: paramName, aggregateName: paramAggregateName, capability: paramCapability, marked: paramMarked)
				declaredParams.push(storedParam)
				writtenEnds.push(writtenNames.count())

				if not self.at(TokenKind.comma) 'endParams'
					break
				end 'endParams'

				try self.consume(TokenKind.comma)
			end 'paramLoop'
		end 'params'

		try self.consume(TokenKind.rightParen)

		let returned = try self.readFunctionTypeReturn(writtenNames, sites: typeSites, recordSignature: recordSignature)
		let mutableFunction = self.mutatesCapturesAt(self.pos)

		if mutableFunction 'aMutatesCapturesClause'
			self.advance()
			self.advance()
		end 'aMutatesCapturesClause'

		writtenEnds.push(writtenNames.count())
		let written = WrittenTypeNames.none() if writtenNames.isEmpty() else WrittenTypeNames.create(writtenNames, ends: writtenEnds)
		return FunctionTypeAlias.create(nameTok.value, returnTag: returned.tag, returnTypeName: returned.typeName, returnIdentity: returned.identity, returnAggregateName: returned.aggregateName, returnCapability: returned.capability, paramTypes: freeze declaredParams, paramSpelling: paramSpelling, declFilePath: self.job.path, visibility: visibility, written: written, typeSites: freeze typeSites, mutableFunction: mutableFunction)
	end 'readFunctionTypeAlias'

	function readFunctionTypeReturn(writtenNames NameRoster, sites mutable isolated DeclaredTypeSites, recordSignature bool) returns FunctionTypeReturn throws SourceParseError
		if not self.at(TokenKind.returns) 'hasNoReturn'
			return FunctionTypeReturn.absent()
		end 'hasNoReturn'

		let returnsTok = try self.consume(TokenKind.returns)
		let capabilityTok = self.current()
		let writtenCapability = try self.readParamCapability()
		self.appendAuditedTypeNamesHere(writtenNames)

		sites.noteWrittenReturnType(self.current())

		let returnTypeTok = self.current()
		let returnType = try self.parseTypeReference(BarePrimitiveVoice.admitted)
		try self.requireCapabilityFits(writtenCapability, wordTok: capabilityTok, spelled: returnType)
		let capability = resultCapabilityOf(self.aliasCapabilityOr(writtenCapability, typeTok: returnTypeTok))

		if recordSignature 'realParse'
			// The RETURN half of this position, and since the return ABI landed it is its OWN position:
			// a declared function's return now WRITES the second register, and a call through a function
			// value cannot read it (`callIndirect` declares one result). Gated on `recordSignature`
			// exactly as the parameter half above is: the sweep may not veto.
			try self.requireStorableDeclaredType(returnType, position: DeclaredStoragePosition.functionTypeReturnType, line: returnsTok.line, column: returnsTok.column)
		end 'realParse'

		// ⚠ Gated with the parameter half, and NOT beside the unconditional columns below,
		// because it is the one fact of the four the sweep cannot read identically: `erasedAggregateNameOf`
		// classifies through `self.signatures`, the registry the sweep is still filling. The sweep's copy
		// of an alias carries the return TAG and no identity, which is exactly what it can honestly say.
		let aggregateName = self.erasedAggregateNameOf(returnType) if recordSignature else EmptySourceText

		// ⭐ UNCONDITIONAL, unlike the aggregate name above, and that is the digest's whole property: the
		// token is a pure function of two SOURCE SPELLINGS (`ProgramSignatures.typeParamTokenFor`), so the
		// tolerant sweep mints the identical one without consulting the registry it is still building.

		// ⭐ **UNCONDITIONAL, AND IT MUST SIT EXACTLY WHERE `returnTag` DOES — beside it, never inside the
		// `recordSignature` gate.** The tag is what says this column means anything, so a pass that mints
		// the tag and skips the column would hand `maxonTypeOfStoredTypeName` a `genericInstance` with no
		// identity, which is the panic. One line, one act: whoever tags, carries.
		//
		// ⚠ **THE SWEEP AND THE REAL PARSE DO NOT HAVE TO AGREE ABOUT THE TAG HERE, AND FOR A GENERIC
		// ALIAS THEY DELIBERATELY DO NOT** — `parseTypeReference`'s alias registries sit behind
		// `allFilesFolded`, so a swept `returns FieldArray` keeps its bare `named` in every file order (see
		// that gate's own argument) and the sweep's copy carries no gid at all. That asymmetry is
		// pre-existing and is exactly what `FunctionTypeAlias.paramTypes` already documents for the
		// parameter half; this column inherits it rather than adding to it.
		return FunctionTypeReturn.create(maxonTypeTag(returnType), typeName: self.functionAliasTypeName(returnType), identity: functionAliasSlotIdentity(returnType), aggregateName: aggregateName, capability: capability)
	end 'readFunctionTypeReturn'

	// ⭐ **THE TOKENS BETWEEN TWO CURSOR POSITIONS, FOLDED INTO A DIGEST — a fact about the SOURCE and about
	// nothing else.** It reads token TEXT and consults no registry (`parseTypeReference`'s answer is never
	// asked), which is what lets the declaration sweep and the real parse mint the identical value for one
	// written declaration — the property `FunctionTypeAlias.paramSpelling` needs and that no RESOLVED fact
	// about a parameter has.
	//
	// ⚠ **IT IS BLIND TO LAYOUT, AND THE REASON IS THE SAME ONE FOR EVERY KIND OF IT: THE RANGE CANNOT HOLD
	// ANY.** The range lies inside a function type's parentheses, where the lexer drops every
	// `newline` and `///` (`Lexer.dropBracketedLayout`), so reformatting cannot move the digest.
	// Whitespace and indentation are not tokens at all.
	//
	// ⛔ **DO NOT REST THAT ON "COMMENTS ARE NOT TOKENS", WHICH IS FALSE.** `//` and `/* … */` are dropped by
	// the lexer, but a `///` leading its line is emitted (the formatter and the LSP read it back), and it
	// CARRIES TEXT — so a doc comment inside a folded range would change the digest, and the declaration
	// sweep and the real parse mint identical values only because the lexer drops one inside the
	// parentheses.
	//
	// ⛔⛔ **IT FOLDS TOKEN TEXT AND PUNCTUATORS CARRY NONE, SO A CALLER MUST SUPPLY EVERY SEPARATOR ITSELF.**
	// `Token.value` is `EmptySourceText` for every punctuator (`Lexer.maxon`: a token whose text is implied by
	// its KIND carries the one shared empty slice), so a `,` or a `.` inside a range contributes NOTHING and
	// widening a range to include one buys nothing at all. **`dottedChainText` is the one other walk over a
	// token range in this file and it re-inserts the `.` explicitly for exactly this reason** — the codebase
	// had already learned this, and the first version of this walk was the one that did not compensate. See
	// `FunctionAliasParamBoundary` for the collision that cost.
	function mixWrittenTokens(state HashDigest, from ElementIndex, to ElementIndex) returns HashDigest
		var out = state

		for i in from upto to 'eachToken'
			out = mixBytes(out, bytes: self.tokenAt(i).value)
		end 'eachToken'

		return out
	end 'mixWrittenTokens'

	// One parameter of a function-type signature — an optional NAME, an optional capability word (`mutable`,
	// `isolated` or `immutable`), and its type. A `name Type` param is one where an identifier that is not a
	// capability word is followed by
	// another type-starting token (`function(x Score)`); otherwise the token IS the type (`function(Integer)`,
	// `function(Integer, Integer)`).
	function readFunctionTypeParam(writtenNames NameRoster, sites mutable isolated DeclaredTypeSites) returns (MaxonType, ParamCapability, immutable ByteArray, bool) throws SourceParseError
		let named = self.at(TokenKind.identifier) and typeStartsWith(self.peekKind()) and self.paramCapabilityAt(self.pos) == ParamCapability.unmarked and not self.mutableMarkerAt(self.pos)
		let name = self.tokenAt(self.pos).value if named else EmptySourceText

		if named 'namedParam'
			try self.consume(TokenKind.identifier)
		end 'namedParam'

		let marked = self.mutableMarkerAt(self.pos)

		if marked 'aMarkedParameter'
			self.advance()
		end 'aMarkedParameter'

		let capabilityTok = self.current()
		let writtenCapability = try self.readParamCapability()
		self.appendAuditedTypeNamesHere(writtenNames)

		sites.noteWrittenType(self.current())

		let typeTok = self.current()
		let spelled = try self.parseTypeReference(BarePrimitiveVoice.admitted)

		if writtenCapability != ParamCapability.mutable 'notTheByReferenceWord'
			try self.requireCapabilityFits(writtenCapability, wordTok: capabilityTok, spelled: spelled)
		end 'notTheByReferenceWord'

		let capability = ParamCapability.mutable if marked and writtenCapability == ParamCapability.unmarked else self.aliasCapabilityOr(writtenCapability, typeTok: typeTok)
		return (spelled, capability, name, marked)
	end 'readFunctionTypeParam'

	function isLibrarySource() returns bool
		return self.job.isStdlibSource or self.job.isRuntimeSource
	end 'isLibrarySource'

	function appendAuditedTypeNamesHere(names NameRoster)
		if self.isLibrarySource() 'aLibraryFilesOwnSpelling'
			return
		end 'aLibraryFilesOwnSpelling'

		self.appendWrittenTypeNamesAt(self.pos, ownTypeParams: NameRoster.create(0), into: names)
	end 'appendAuditedTypeNamesHere'

	// The interned NAME behind one type in a function alias's declared signature — a PARAMETER's or the
	// RETURN's — stored so the type can be re-interned into any reader's own interner (see
	// FunctionTypeAlias). A primitive (`bool`/`int`/`float`/`ExitCode`/`void`) carries no name and yields the
	// empty string. ONE extractor for both halves of the signature: they are stored the same way, so a second
	// copy of this match is a second answer waiting to disagree.
	function functionAliasTypeName(declared MaxonType) returns immutable ByteArray
		return match declared 'k'
			named(id) gives self.internedName(id)
			structRef(id) gives self.internedName(id)
			function(id) gives self.internedName(id)

			// An existential DOES carry a re-internable name — the interface's — so a function alias whose
			// parameter or result is declared at an interface type round-trips through a reader's interner
			// exactly as a `structRef` one does.
			interfaceRef(id) gives self.internedName(id)
			boolean or
			integer or
			float or
			exitCode or
			unresolved or
			string or

			// A type parameter's id is a token digest and a generic instance's a `GenericInstanceId`,
			// neither re-internable, so each identity travels in its own column
			// (`FunctionAliasParam.typeParamToken`, `.genericInstanceId`). The empty name here cannot be
			// told from a primitive's and rebuilds as id 0; read alone it refuses the declaration for a
			// type parameter and is a silent wrong answer for an instance.
			typeParameter or
			genericInstance or
			character or
			cstring gives EmptySourceText
		end 'k'
	end 'functionAliasTypeName'

	// The `to <high>` / `upto <high>` half of a range, returned as an INCLUSIVE upper
	// bound: `upto` is exclusive, so it normalizes to `high - 1` here and the registry
	// keeps exactly one representation of a range (`0 upto 10` and `0 to 9` are the same
	// alias, which is what the language says they are).
	//
	// `i64.min` has no `upto` form — its exclusive bound would be one BELOW the smallest
	// representable value. Rejected with a positioned error, because the subtraction that
	// normalizes it would otherwise underflow `FullRangeInt` and take the COMPILER down on a
	// source file it should merely have diagnosed.
	function parseRangeUpperBound(isFloat bool) returns ParsedRangeBound throws SourceParseError
		if self.at(TokenKind.upto) 'exclusive'
			let uptoTok = try self.consume(TokenKind.upto)

			// `upto` normalizes to an inclusive `high - 1` (below) — INTEGER arithmetic on the bound.
			// A float bound is an IEEE-754 bit pattern, not a count, so `bits - 1` is nonsense on it,
			// and no float alias in the corpus uses `upto`. Rejected rather than mis-normalized; a
			// float exclusive bound is a concern only for the range check that would read it.
			if isFloat 'floatExclusive'
				throw SourceParseError.unsupported("an exclusive `upto` upper bound on a float typealias — a float bound is a bit pattern with no integer predecessor; use `to`", line: uptoTok.line, column: uptoTok.column)
			end 'floatExclusive'

			let bound = try self.parseRangeBound(isFloat)

			if bound.exceedsSignedMax and bound.value == I64MinBound 'landsOnTheSignedTop'
				return bound.withValue(I64MaxBound, aboveSignedMax: false)
			end 'landsOnTheSignedTop'

			if bound.value == I64MinBound and not bound.exceedsSignedMax 'unrepresentable'
				throw SourceParseError.unsupported("an exclusive upper bound of i64.min — its inclusive form is one below the smallest 64-bit integer, so the range is empty and not representable", line: uptoTok.line, column: uptoTok.column)
			end 'unrepresentable'

			return bound.withValue(bound.value - 1, aboveSignedMax: bound.exceedsSignedMax)
		end 'exclusive'

		try self.consume(TokenKind.to)
		return try self.parseRangeBound(isFloat)
	end 'parseRangeUpperBound'

	// One endpoint of a range. For an INT alias: an integer literal (`0`, `-273`, `0xFFFF`) or a
	// type-qualified bound (`i64.min`, `u32.max`). For a FLOAT alias (`isFloat`): a float literal or a
	// float type-qualified bound — see `parseFloatRangeBound`. The two endpoints of one range are
	// parsed with the same `isFloat`, so a range cannot mix an int and a float bound.
	function parseRangeBound(isFloat bool) returns ParsedRangeBound throws SourceParseError
		if isFloat 'float'
			return try self.parseFloatRangeBound()
		end 'float'

		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.intLiteral)
			return ParsedRangeBound.literal(try self.intLiteralValue(tok, negated: true), exceedsSignedMax: false)
		end 'negative'

		if self.at(TokenKind.intLiteral) 'literal'
			let tok = try self.consume(TokenKind.intLiteral)
			let value = try self.intLiteralValue(tok, negated: false)
			return ParsedRangeBound.literal(value, exceedsSignedMax: value < 0)
		end 'literal'

		return try self.parseTypeQualifiedBound(false)
	end 'parseRangeBound'

	// One endpoint of a FLOAT range: a float literal (`0.0`, `100.0`, `-2.5`) or a type-qualified
	// float bound (`f32.min`, `f64.max`). The value is the endpoint's IEEE-754 **f64** bit pattern,
	// carried in the same `FullRangeInt` an integer bound uses — a float alias resolves to
	// `MaxonType.float` = f64, so its bounds are f64 bits (`RangedTypeAlias`). The literal path reuses
	// the one float decoder `parseFloatLiteral` does (`__float_bitsFromText`), so `0.0` reads the same bits
	// in a bound as in an expression. A negated literal FLIPS the sign bit (`negatedFloatBits`) rather
	// than subtracting: `0 - bits` on a bit pattern would be nonsense (see `NumberParsing.FloatSignBit`).
	function parseFloatRangeBound() returns ParsedRangeBound throws SourceParseError
		if self.at(TokenKind.minus) 'negative'
			try self.consume(TokenKind.minus)
			let tok = try self.consume(TokenKind.floatLiteral)
			let bits = try self.floatLiteralBits(tok)
			return ParsedRangeBound.literal(negatedFloatBits(bits), exceedsSignedMax: false)
		end 'negative'

		if self.at(TokenKind.floatLiteral) 'literal'
			let tok = try self.consume(TokenKind.floatLiteral)
			return ParsedRangeBound.literal(try self.floatLiteralBits(tok), exceedsSignedMax: false)
		end 'literal'

		return try self.parseTypeQualifiedBound(true)
	end 'parseFloatRangeBound'

	// Convert an integer-literal token's text to its value, re-raising NumberParsing's
	// overflow as a POSITIONED parse error. THE one place a literal's text becomes a
	// number: the expression parser (`parseIntLiteral`) and the range-bound parser both
	// come through it, so how a literal is read — the radix prefixes it accepts, the
	// overflow it rejects — cannot come to mean one thing in `return 42` and another in
	// `int(0 to 42)`.
	//
	// `negated` routes to `parseNegatedInt` rather than negating the result: `i64.min`'s
	// magnitude does not fit a POSITIVE i64, so negating after the fact would overflow on
	// the one bound that most needs to work.
	//
	// ⚠ An unnegated literal above `i64.max` comes back as its NEGATIVE pattern, and a caller that
	// reads it as signed answers about a negative number the source never wrote.
	function intLiteralValue(tok Token, negated bool) returns FullRangeInt throws SourceParseError
		if negated 'negative'
			return try parseNegatedInt(tok.value) otherwise (err) 'rejected'
				throw self.literalDecodeError(err, tok: tok, isFloat: false)
			end 'rejected'
		end 'negative'

		return try parseIntegerLiteral(tok.value) otherwise (err) 'rejected'
			throw self.literalDecodeError(err, tok: tok, isFloat: false)
		end 'rejected'
	end 'intLiteralValue'

	// The float twin of `intLiteralValue`: THE one place a float literal's text becomes BITS. Six sites want
	// it — a field default, both float range bounds, an enum raw value, a constant initializer and the
	// expression parser — and each spelling `try <the reader>(tok.value) otherwise throw …` for itself is the
	// same fact written down six times.
	//
	// ⭐ **THE READER ANSWERS WITH A RESULT AND THIS IS WHERE IT BECOMES A `ParserError`.**
	// `__float_bitsFromText` lives in `stdlib/Builtins.maxon` and deliberately does not throw (a stdlib
	// error enum is language surface — see `__FloatTextResult`), so its two failure arms are named in the
	// compiler's own vocabulary exactly once, HERE, and go on to the same `literalDecodeError` the
	// integer path uses. Mapping them anywhere else would be a second opinion about which diagnostic a
	// bad literal deserves.
	//
	// ⭐⭐ **SPELLED `float.bitsFromText`, BECAUSE THIS FILE MAY NOT WRITE THE RESERVED NAME.** To the
	// compiler compiling it, `Compiler/Parser.maxon` is an ordinary user program, and
	// `requireCalleeIsNotReservedName` — the rule this very file states — refuses a `__` callee written
	// out in a file that does not DECLARE it. The primitive-static spelling mints exactly those bytes
	// (`primitiveStaticCallee`), so it links to the same body through the door the rule leaves open.
	// `NumberParsing.scalarConstantText` — the reader in this direction's mirror, and this file's
	// neighbour — spells the printer the same way. See `specs/reserved-double-underscore.md`'s
	// primitive-static pair.
	function floatLiteralBits(tok Token) returns FullRangeInt throws SourceParseError
		match float.bitsFromText(String.from(tok.value)) 'decoded'
			bits(value) then return value
			overflow then throw self.literalDecodeError(ParserError.overflow, tok: tok, isFloat: true)

			// Reachable from source — `1.5.3` is the shape. See `literalDecodeError`.
			malformed then throw self.literalDecodeError(ParserError.malformed, tok: tok, isFloat: true)
		end 'decoded'
	end 'floatLiteralBits'

	// Turn a NumberParsing failure into the POSITIONED parse error that reports it, quoting the
	// token's RAW TEXT — the radix prefix and `_` separators the source wrote, which the decoded
	// value can no longer say.
	//
	// ⛔⛔ **`malformed` IS REPORTED, AND IT USED TO PANIC.** The panic asserted this arm was
	// unreachable from source — "`Lexer.scanNumber` hands a literal token nothing but digits, `_`,
	// `.`, `e`/`E` and an exponent sign, so a rejection means the lexer and the reader have diverged,
	// a compiler defect rather than a program's". **The premise was false.** The lexer's trailing-byte
	// rule appended a SECOND `.` to a token that already carried a fraction, so `1.5.3` arrived here
	// as `1.5.` and CRASHED the compiler; `1.5.`, `1..5` and `1.5e2.3` did the same. That hole is now
	// closed in the lexer too (see `scanNumber`'s `not isFloat` clause), and BOTH layers are fixed
	// deliberately: a parser that cannot answer "this literal is not well-formed" with a position is a
	// parser whose caller's leniency has nowhere to surface, which is exactly how the lexer's went
	// unnoticed. A diagnostic here costs nothing and stops the next one being a crash.
	function literalDecodeError(err ParserError, tok Token, isFloat bool) returns SourceParseError
		let literal = String.from(tok.value)

		match err 'kind'
			overflow then break
			malformed then return SourceParseError.malformedNumericLiteral(literal, line: tok.line, column: tok.column)
		end 'kind'

		return SourceParseError.floatLiteralOverflow(literal, line: tok.line, column: tok.column) if isFloat else SourceParseError.integerOverflow(literal, line: tok.line, column: tok.column)
	end 'literalDecodeError'

	// A type-qualified numeric bound — `<sized>.min` / `<sized>.max`, three tokens
	// (identifier, `.`, identifier). Shared by the range-declaration parser and the
	// expression parser, which meet the same three tokens in two positions. `isFloat` is the
	// caller's domain: true only for the bound of a `float(...)` alias, where an `f32`/`f64` bound
	// is what is wanted; false for an int alias and for expression position (`let x = u16.max`),
	// where a float bound has no integer value to carry and is rejected.
	function parseTypeQualifiedBound(isFloat bool) returns ParsedRangeBound throws SourceParseError
		// Read through `consumeTypeBaseToken` for the reason every other type-named base is: a `Self.max`
		// bound must report what the same program spelled `<TypeName>.max` reports ("expected a sized
		// numeric type … but got 'Box'"), not an E2010 about the keyword.
		let typeTok = try self.consumeTypeBaseToken()

		if not isSizedTypeName(typeTok.value) 'notASizedBase'
			throw SourceParseError.unexpectedToken("a sized numeric type (u8/u16/u32/u64/i8/i16/i32/i64/f32/f64)", got: tokenDisplayText(typeTok), line: typeTok.line, column: typeTok.column)
		end 'notASizedBase'

		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		let wantMax = try self.boundFieldIsMax(fieldTok)

		match sizedTypeBound(typeTok.value, wantMax: wantMax) 'resolve'
			// An integer bound is accepted in every position — including a `float(...)` alias, where
			// `float(0.0 to i64.max)` is as malformed as an out-of-order int range and left equally
			// unchecked (no range check reads the bound; this matches the int path's
			// existing laxness rather than adding a validation the int path does not have).
			value(bound) then return ParsedRangeBound.qualified(bound, qualifier: typeTok.value, isMax: wantMax)
			floatBound(bits) then return ParsedRangeBound.qualified(try floatBoundInFloatAlias(bits, isFloat: isFloat, typeTok: typeTok, fieldTok: fieldTok), qualifier: typeTok.value, isMax: wantMax)
			notASizedType then panic("parseTypeQualifiedBound: '{String.from(typeTok.value)}' passed `isSizedTypeName` and `sizedTypeBound` answers notASizedType — the two read one table")
		end 'resolve'
	end 'parseTypeQualifiedBound'

	// True for `.max`, false for `.min`. Any other field name is a positioned error —
	// a sized type exposes exactly these two bounds.
	function boundFieldIsMax(fieldTok Token) returns bool throws SourceParseError
		if fieldTok.value.equals(MaxBoundField) 'max'
			return true
		end 'max'

		if fieldTok.value.equals(MinBoundField) 'min'
			return false
		end 'min'

		// ⚠ **UNQUOTED, BECAUSE THE QUOTES ARE `expectationDisplayText`'s TO ADD.** An expectation passed in
		// already quoted is quoted again by the renderer, and the message then carries a doubled pair around a
		// doubly-quoted string — what a second site deciding presentation looks like from the outside.
		throw SourceParseError.unexpectedToken("min or max", got: tokenDisplayText(fieldTok), line: fieldTok.line, column: fieldTok.column)
	end 'boundFieldIsMax'

	// Parse a struct type declaration:
	//
	//     type Point
	//         export var x as Integer
	//         export var y as Integer
	//         static function create(x Integer, y Integer) returns Self
	//             return Self{x: x, y: y}
	//         end 'create'
	//     end 'Point'
	//
	// ⭐ **THE DECLARATION EMITS NOTHING** — no op, no storage, no code. A `type` is a LAYOUT, and
	// its whole effect is the `StructLayout` recorded below, which `Self{…}` sizes its `__mm_alloc`
	// from and `p.x` reads its offsets out of. Its METHODS are ordinary functions, named
	// `Point.create` (`declaredMethodName`) and built by the very same `parseFunction` a free
	// function is: there is no method table, no receiver, and nothing for a call to dispatch
	// through. That is the whole of `static function`.
	//
	// ⚠ **THE LAYOUT IS RECORDED AFTER THE BODY, AND NOTHING IN THE BODY READS IT.** `Self{x: x, y:
	// y}` inside `create` needs the field list — and it asks `signatures.structOf`, the WHOLE-PROGRAM
	// sweep, which is complete before this file's parse begins. So there is no ordering hazard, and
	// deliberately no half-built artifact registry for a method body to race: a `type` whose fields
	// are declared BELOW its methods parses identically to one that declares them above.
	function parseTypeDeclaration(visibility Visibility) throws SourceParseError
		let header = try self.readTypeHeader()
		let nameTok = header.nameTok

		// The real parse alone rejects a reserved `type __T` or a compiler-owned `type Ordering` —
		// `readTypeHeader` stays a pure reader shared with the tolerant sweep, which is not a validator
		// (see `recordScannedType`).
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.requireTypeNameNotCompilerOwned(nameTok, declares: DeclaredTypeMeaning.nominalIdentity)
		self.enterTypeScope(nameTok.value, isEnum: false)

		let layout = StructLayout.create(nameTok.value, visibility: visibility, declFilePath: self.job.path)
		layout.declLine = nameTok.line
		layout.declColumn = nameTok.column
		layout.isLinear = typeBodyHoldsADestruct(self.tokens, from: self.pos)
		layout.isUnique = header.isUnique or layout.isLinear

		// `uses T` — parsed here so `parseTypeReference` recognizes `T` in the fields and
		// methods below, and the arity check reads the list off the recorded layout.
		self.openTypeParamScope(layout)

		// `implements I1, I2` — parsed AFTER `uses` per the grammar
		// `type Name [uses …] [implements …]`. Records a whole-program ConformanceDecl (anchored on the
		// type NAME token) that `checkConformance` validates; the declaration itself emits nothing.
		self.openConformanceClauseAliasScope()
		_ = try self.parseImplementsClause(nameTok)
		self.closeConformanceClauseAliasScope()

		// `where T is <Interface> …` — parsed AFTER `implements` per the grammar
		// `type Name uses T [implements I] where T is C`. The constraints are set on `enclosingWhereConstraints`
		// (so the body parse below recognizes a `self.item.digest()` witness dispatch and reserves witness
		// parameters) AND recorded on the layout (so the instantiation-site check validates `Box with Point`).
		if self.at(TokenKind.where) 'whereClause'
			let spelledBounds = RegionBoundArray.create(0)
			let constraints = try self.readWhereClause(self.enclosingTypeParams, owner: TypeWhereClauseOwner, admitsAssociatedBindings: true, bounds: spelledBounds)
			self.enclosingWhereConstraints = constraints
			layout.recordWhereConstraints(constraints)
			layout.recordRegionBounds(spelledBounds)
		end 'whereClause'

		// The cursor sits at the type body start; remember it so the lazy sibling-receiver walk (#65) can begin
		// here once a method body's bare call needs it. The memo is invalidated implicitly — its key still names
		// the previous type, so the first call in this body rebuilds against this start.
		self.enclosingTypeBodyStart = self.pos
		self.enclosingBodyIsWalkable = true

		let memberNames = TypeMemberNames.create()

		while true 'members'
			let atEnd = try self.atDeclarationBodyEnd()

			if atEnd 'closes'
				break
			end 'closes'

			if self.atStructFieldKeyword() 'isField'
				let fieldNameTok = self.tokenAt(pastVisibilityModifiers(self.tokens, index: self.pos) + 1)
				self.noteMemberName(memberNames, nameTok: fieldNameTok, kind: TypeMemberKind.field, typeName: nameTok.value)
				try self.readStructFieldInto(layout)
				try self.requireFieldHoldsNoLinearValue(layout, fieldTok: fieldNameTok)
				continue
			end 'isField'

			if let methodTok = try self.typeMemberMethodNameToken() 'aMethod'
				self.noteMemberName(memberNames, nameTok: methodTok, kind: TypeMemberKind.method, typeName: nameTok.value)
			end 'aMethod'

			try self.parseTypeMember(MemberList.typeBody)
		end 'members'

		try self.consumeBlockEnd(nameTok.value, labelIsRequired: false)

		self.artifact.recordStructType(layout)
		self.contributeServiceCompanions(layout.name)
		self.closeTypeParamScope()
	end 'parseTypeDeclaration'

	// ⭐⭐⭐ **A SERVICE'S COMPANIONS ARE THIS FILE'S CONTRIBUTION TOO, AND A LAYOUT IN ONLY ONE OF THE TWO
	// REGISTRIES IS WHAT THE INSTALLERS CANNOT SURVIVE.** `synthesizeServiceCompanions` registers
	// the pair on the SIGNATURE INDEX, which is what makes `Calc.handle` a nameable type. But
	// `installUnionDestructors` and `installStructDestructors` walk `project.enumTypes` / `project.structTypes`
	// — the registries a FILE contributes to — and a layout absent there is a `__destruct_<T>` the backend
	// cannot resolve. MEASURED as exactly that: `call to unknown function '__destruct_Counter.request'` on
	// `services/two-instances-are-independent`, whose request union owns a `Counter.handle` payload.
	//
	// It is `internTupleLayout`'s arrangement, one synthesis over and for its stated reason: *"both
	// registrations happen here, together, because a layout in one and not the other is what makes the
	// destructor installer ask a question the index cannot answer."*
	//
	// ⚠⚠ **THE PAIR IS REBUILT AGAINST THIS FILE'S INTERNER RATHER THAN COPIED FROM THE INDEX.**
	// A payload type carries a `TypeNameId`, which is only a number without its table, and `mergeArtifact`
	// remaps an artifact's ids as THIS FILE'S. Handing it the index's layout would file the index's numbers
	// under the file's remap: a payload declared `Counter.handle` resolving to whatever name that id happens to
	// hold here. `buildServiceRequestUnion` takes the interner as a parameter for exactly this, so what is
	// shared is the BUILDER and not the record.
	//
	// ⚠ It runs at the DECLARING file's `type` — the one file that is guaranteed to exist for a service, and
	// the file the memo re-parses when a `spawn` elsewhere mints the companions (the sweep's own hash moves,
	// which is `synthesizeServiceCompanions`' recorded argument for why the cross-file case works at all).
	function requireTypeDeclaresAFinalizer(nameTok Token) throws SourceParseError
		if self.enclosingType.isType() and (try self.enclosingLayout(nameTok)).isLinear 'theTypeHasAFinalizer'
			return
		end 'theTypeHasAFinalizer'

		throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "`consuming self` belongs to a method of a `type` that declares a finalizer, and no method of '{String.from(self.enclosingTypeNameOrEmpty())}' contains `destruct self`", line: nameTok.line, column: nameTok.column)
	end 'requireTypeDeclaresAFinalizer'

	function requireFieldHoldsNoLinearValue(layout StructLayout, fieldTok Token) throws SourceParseError
		let swept = try self.enclosingLayout(fieldTok)
		let declared = try swept.fieldTypes.get(layout.fieldCount() - 1) otherwise panic("requireFieldHoldsNoLinearValue: the field `readStructFieldInto` just read has a place in the swept layout")

		if self.signatures.typeIsLinear(declared) 'aLinearField'
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "the field '{String.from(fieldTok.value)}' holds a linear value, and a linear value {LinearValueResidence}: a field would keep it past the code that must consume it", line: fieldTok.line, column: fieldTok.column)
		end 'aLinearField'
	end 'requireFieldHoldsNoLinearValue'

	function noteMemberName(memberNames TypeMemberNames, nameTok Token, kind TypeMemberKind, typeName ByteArray)
		if let earlier = try memberNames.get(nameTok.value) 'aNameAlreadyDeclared'
			if earlier != kind 'oneOfEach'
				self.recordArtifactDiagnostic(ErrorCode.duplicateDefinition, message: fieldAndMethodMessage(nameTok.value, typeName: typeName), range: SourceRange.ofToken(nameTok))
				return
			end 'oneOfEach'

			match kind 'sameKind'
				field then self.recordArtifactDiagnostic(ErrorCode.duplicateDefinition, message: duplicateFieldMessage(nameTok.value, typeName: typeName), range: SourceRange.ofToken(nameTok))
				method then return
			end 'sameKind'

			return
		end 'aNameAlreadyDeclared'

		memberNames.upsert(nameTok.value, value: kind)
	end 'noteMemberName'

	function typeMemberMethodNameToken() returns Token throws AbsentError
		let at = pastDeclarationModifiers(self.tokens, index: self.pos)

		if not self.functionDeclarationAt(at) 'notAMethod'
			throw AbsentError.absent
		end 'notAMethod'

		return self.tokenAt(at + 1)
	end 'typeMemberMethodNameToken'

	function declaredBefore(declFilePath FilePath, line LineNumber, column ColumnNumber, nameTok Token) returns bool
		if not declFilePath.equals(self.job.path) 'anotherFile'
			return self.signatures.declaredByTheCorpus(declFilePath) == self.job.isStdlibSource and precedesInPathOrder(declFilePath, other: self.job.path)
		end 'anotherFile'

		return line < nameTok.line or (line == nameTok.line and column < nameTok.column)
	end 'declaredBefore'

	function duplicateGenericDeclaration(key ByteArray, nameTok Token) returns SourceParseError
		return SourceParseError.duplicateDeclaration(duplicateDeclarationMessage(key), line: nameTok.line, column: nameTok.column)
	end 'duplicateGenericDeclaration'

	// Refuses the later of two declarations of one generic key — two templates, or a template and a plain
	// function — because the registries are keyed by name and hold one entry per key, so the second has no
	// entry to live in. `TopLevelNameScope.maxon`'s ledger judges the cross-family pairs this cannot see.
	function requireGenericNameDeclaredOnce(template GenericFunctionTemplate, nameTok Token) throws SourceParseError
		for other in self.signatures.genericTemplatesOf(template.key) 'eachTemplate'
			if self.declaredBefore(other.declFilePath, line: other.line, column: other.column, nameTok: nameTok) 'anEarlierTemplate'
				throw self.duplicateGenericDeclaration(template.key, nameTok: nameTok)
			end 'anEarlierTemplate'
		end 'eachTemplate'

		let site = try self.signatures.declaredSiteOf(template.key) otherwise return

		if self.declaredBefore(site.declFilePath, line: site.nameLine, column: site.nameColumn, nameTok: nameTok) 'anEarlierFunction'
			throw self.duplicateGenericDeclaration(template.key, nameTok: nameTok)
		end 'anEarlierFunction'
	end 'requireGenericNameDeclaredOnce'

	function requireNoEarlierGenericTemplate(key ByteArray, nameTok Token) throws SourceParseError
		if self.genericInstanceName.isInstance() 'anInstanceOfATemplate'
			return
		end 'anInstanceOfATemplate'

		for template in self.signatures.genericTemplatesOf(key) 'eachTemplate'
			if self.declaredBefore(template.declFilePath, line: template.line, column: template.column, nameTok: nameTok) 'anEarlierTemplate'
				throw self.duplicateGenericDeclaration(key, nameTok: nameTok)
			end 'anEarlierTemplate'
		end 'eachTemplate'
	end 'requireNoEarlierGenericTemplate'

	function contributeServiceCompanions(typeName ByteArray)
		// The handle's EXISTENCE is what says this type is a service: the sweep mints one for every accepted
		// spawn target and for nothing else, so this is the roster asked through the registry that holds it.
		if not self.signatures.containsStructInAnyFile(serviceHandleCompanionName(typeName)) 'notASpawnedService'
			return
		end 'notASpawnedService'

		// Both are this file's own copies: a builder reads names, paths and parameter lists off the index's records.
		self.artifact.recordStructType(buildServiceHandleStruct(self.signatures, typeName: typeName))

		// Through `recordEnumType`, which is also what appends the `unionCases` companion — so a request union
		// reaches `project.enumTypes` with the same three-layout shape an author's boxed union does.
		self.artifact.recordEnumType(buildServiceRequestUnion(self.signatures, typeName: typeName, into: self.artifact.typeNames))
		self.contributeSendErrors(buildServiceSendErrors(self.signatures, typeName: typeName, into: self.artifact.typeNames))
	end 'contributeServiceCompanions'

	function contributeInterfaceSendErrors(interfaceName ByteArray)
		if not self.signatures.containsStructInAnyFile(serviceHandleCompanionName(interfaceName)) 'noHandle'
			return
		end 'noHandle'

		match self.signatures.interfaceDeclarationOf(interfaceName) 'site'
			declared(_, visibility, declFilePath) then self.contributeSendErrors(buildInterfaceSendErrors(self.signatures, interfaceName: interfaceName, visibility: visibility, declFilePath: declFilePath, into: self.artifact.typeNames))
			undeclared then panic("contributeInterfaceSendErrors: `{String.from(interfaceName)}` has a handle, so the sweep recorded its declaration site")
		end 'site'
	end 'contributeInterfaceSendErrors'

	function contributeSendErrors(errors EnumLayoutArray)
		for layout in errors 'eachSendError'
			self.artifact.recordEnumType(layout)
		end 'eachSendError'
	end 'contributeSendErrors'

	// The member list's TERMINATOR test, shared by a `type` body and an `extension` body: blank lines are
	// skipped, an `end` closes, and EOF is the unterminated-declaration throw. The two bodies differ only in
	// what a member may BE — one may declare storage and the other may not — so only the loop BODY is theirs.
	function atDeclarationBodyEnd() returns bool throws SourceParseError
		self.skipNewlines()

		if self.at(TokenKind.end) 'closes'
			return true
		end 'closes'

		if self.isEof() 'eof'
			let tok = self.current()
			throw SourceParseError.unexpectedEof(tok.line, column: tok.column)
		end 'eof'

		return false
	end 'atDeclarationBodyEnd'
end 'Parser'
