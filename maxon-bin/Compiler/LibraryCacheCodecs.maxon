type ViewEntry
	let facts as RawStreamFacts
	var view as SharedBuildView

	static function create(facts RawStreamFacts, view SharedBuildView) returns ViewEntry
		return Self{facts: facts, view: view}
	end 'create'
end 'ViewEntry'

function encodedSourceSpellings(writer LibraryCacheWriter, spellings NameRoster)
	writer.unsigned(spellings.count() as CacheUnsigned)

	for spelling in spellings 'eachSpelling'
		writer.bytes(spelling)
	end 'eachSpelling'
end 'encodedSourceSpellings'

function decodedSourceSpellings(reader LibraryCacheReader) returns NameRoster throws LibraryCacheDamage
	let count = try reader.count()
	let spellings = NameRoster.create(count, zeroed: false)

	for _ in 0 upto count 'eachSpelling'
		let spelling = try reader.bytes()
		spellings.push(spelling)
	end 'eachSpelling'

	return spellings
end 'decodedSourceSpellings'

function encodedSpellingCounts(writer LibraryCacheWriter, counts SpellingCountArray)
	writer.unsigned(counts.count() as CacheUnsigned)

	for count in counts 'eachCount'
		writer.unsigned(count as CacheUnsigned)
	end 'eachCount'
end 'encodedSpellingCounts'

function decodedSpellingCounts(reader LibraryCacheReader, expected ElementIndex) returns SpellingCountArray throws LibraryCacheDamage
	let count = try reader.count()

	if count != expected 'notOneCountPerSpelling'
		throw LibraryCacheDamage.outOfRange
	end 'notOneCountPerSpelling'

	let counts = SpellingCountArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachCount'
		counts.push((try reader.unsigned()) as SpellingCount)
	end 'eachCount'

	return counts
end 'decodedSpellingCounts'

function encodedViewSection(facts RawStreamFacts, view SharedBuildView) returns immutable ByteArray
	let writer = LibraryCacheWriter.create()
	encodedSourceSpellings(writer, spellings: facts.declaredTypeNames)
	encodedSourceSpellings(writer, spellings: facts.reservedSpellings)
	encodedSourceSpellings(writer, spellings: facts.conditionalSpellings.names)
	encodedSpellingCounts(writer, counts: facts.conditionalSpellings.rawCounts)
	writer.flag(view.producerMaskComputed)
	writer.unsigned(view.producerMask as CacheUnsigned)
	cacheWriteTokenArray(writer, value: view.activeTokens)

	return writer.payload()
end 'encodedViewSection'

function decodedViewSection(reader LibraryCacheReader, buildKey BuildKey) returns ViewEntry throws LibraryCacheDamage
	let names = try decodedSourceSpellings(reader)
	let reserved = try decodedSourceSpellings(reader)
	let conditional = try decodedSourceSpellings(reader)
	let conditionalCounts = try decodedSpellingCounts(reader, expected: conditional.count())
	let maskComputed = try reader.flag()
	let mask = try cacheReadProducerMask(reader)
	let tokens = try cacheReadTokenArray(reader)
	try reader.finished()

	return ViewEntry.create(RawStreamFacts.create(names, reservedSpellings: reserved, conditionalSpellings: ConditionalSpellings.create(conditional, rawCounts: conditionalCounts)), view: SharedBuildView.restored(buildKey, activeTokens: tokens, producerMask: mask, producerMaskComputed: maskComputed))
end 'decodedViewSection'

function cacheWriteSourceParseError(writer LibraryCacheWriter, value SourceParseError)
	writer.unsigned(value.ordinal as CacheUnsigned)
	writer.refuse()
end 'cacheWriteSourceParseError'

function cacheReadSourceParseError(_ LibraryCacheReader) returns SourceParseError throws LibraryCacheDamage
	throw LibraryCacheDamage.unrepresentable
end 'cacheReadSourceParseError'

function encodedBaseline(declarations LibraryDeclarations, key HashDigest) returns immutable ByteArray throws LibraryCacheDamage
	let writer = LibraryCacheWriter.create()
	writer.unsigned(key as CacheUnsigned)
	cacheWriteFilePathArray(writer, value: declarations.manifest.deferred)
	cacheWriteFilePathArray(writer, value: declarations.manifest.streamed)
	cacheWriteNameRoster(writer, value: declarations.manifest.templates)
	declarations.signatures.cacheWrite(writer)

	if writer.refused() 'aCaseTheFormatDoesNotCarry'
		throw LibraryCacheDamage.unrepresentable
	end 'aCaseTheFormatDoesNotCarry'

	return writer.sealed()
end 'encodedBaseline'

function decodedManifest(reader LibraryCacheReader, key HashDigest) returns LibraryManifest throws LibraryCacheDamage
	try requireKey(reader, expected: key)
	let deferred = try cacheReadFilePathArray(reader)
	let streamed = try cacheReadFilePathArray(reader)
	let templates = try cacheReadNameRoster(reader)

	return LibraryManifest.create(deferred, streamed: streamed, templates: templates)
end 'decodedManifest'

function decodedHeldBaseline(image immutable ByteArray, start ElementIndex, endIndex ElementIndex, key HashDigest, kind LibraryEntryKind, entryClass LibraryEntryClass) returns HeldBaseline throws LibraryCacheDamage
	let reader = LibraryCacheReader.over(image, start: start, endIndex: endIndex)
	let manifest = try decodedManifest(reader, key: key)
	let signatures = try decodedSignatures(reader)
	signatures.releaseTypeNameViews()

	return HeldBaseline.create(key, kind: kind, entryClass: entryClass, declarations: LibraryDeclarations.create(signatures, manifest: manifest))
end 'decodedHeldBaseline'

function decodedSignatures(reader LibraryCacheReader) returns ProgramSignatures throws LibraryCacheDamage
	let signatures = try ProgramSignatures.cacheRead(reader)
	try reader.finished()
	signatures.shareModuleDirectoriesWithProvenance()

	return signatures
end 'decodedSignatures'

function encodedParseSection(held SharedLibraryParse) returns immutable ByteArray throws LibraryCacheDamage
	let writer = LibraryCacheWriter.create()
	cacheWriteSharedLibraryParse(writer, value: held)

	if writer.refused() 'aCaseTheFormatDoesNotCarry'
		throw LibraryCacheDamage.unrepresentable
	end 'aCaseTheFormatDoesNotCarry'

	return writer.payload()
end 'encodedParseSection'

function decodedParseSection(image immutable ByteArray, start ElementIndex, endIndex ElementIndex, variant HashDigest, key HashDigest) returns SharedLibraryParse throws LibraryCacheDamage
	let reader = LibraryCacheReader.over(image, start: start, endIndex: endIndex)
	let held = try cacheReadSharedLibraryParse(reader, variant: variant, key: key)
	try reader.finished()

	return held
end 'decodedParseSection'

function decodedStashedParse(payload immutable ByteArray, variant HashDigest, key HashDigest, contentHash HashDigest) returns SharedLibraryParse
	return try decodedParseSection(payload, start: 0, endIndex: payload.count(), variant: variant, key: key) otherwise (damage) 'undecodable'
		panic("decodedStashedParse: the section this compile encoded for {contentHash} does not decode: {damage.displayReason()}")
	end 'undecodable'
end 'decodedStashedParse'

function encodedAuditFindings(findings UnusedFindingArray, key HashDigest) returns immutable ByteArray
	let writer = LibraryCacheWriter.create()
	writer.unsigned(key as CacheUnsigned)
	writer.unsigned(findings.count() as CacheUnsigned)

	for finding in findings 'eachFinding'
		writer.text(finding.noun)
		writer.text(finding.name)
		writer.text(finding.filePath.toString())
		writer.unsigned(finding.nameLine as CacheUnsigned)
		writer.unsigned(finding.nameColumn as CacheUnsigned)
	end 'eachFinding'

	return writer.sealed()
end 'encodedAuditFindings'

function decodedAuditFindings(reader LibraryCacheReader, key HashDigest) returns UnusedFindingArray throws LibraryCacheDamage
	try requireKey(reader, expected: key)

	let count = try reader.count()
	let findings = UnusedFindingArray.create(count, zeroed: false)

	for _ in 0 upto count 'eachFinding'
		let noun = try reader.text()
		let name = try reader.text()
		let filePath = try reader.path()
		let nameLine = (try reader.unsigned()) as LineNumber
		let nameColumn = (try reader.unsigned()) as ColumnNumber
		findings.push(UnusedFinding.create(noun, name: name, filePath: filePath, nameLine: nameLine, nameColumn: nameColumn))
	end 'eachFinding'

	try reader.finished()

	return findings
end 'decodedAuditFindings'

function cacheWriteTypeNameInterner(writer LibraryCacheWriter, value TypeNameInterner)
	writer.unsigned(value.count() as CacheUnsigned)

	for id in 0 upto value.count() 'eachName'
		writer.bytes(try value.nameOf(id) otherwise panic("cacheWriteTypeNameInterner: id {id} is below the interner's count {value.count()} and has no name"))
	end 'eachName'
end 'cacheWriteTypeNameInterner'

function cacheReadTypeNameInterner(reader LibraryCacheReader) returns TypeNameInterner throws LibraryCacheDamage
	let count = try reader.count()
	let interner = TypeNameInterner.createForSource(0)

	for position in 0 upto count 'eachName'
		let id = interner.intern(try reader.bytes())

		if id != position as TypeNameId 'aNameRepeated'
			throw LibraryCacheDamage.repeatedName
		end 'aNameRepeated'
	end 'eachName'

	return interner
end 'cacheReadTypeNameInterner'

function cacheWriteToken(writer LibraryCacheWriter, value Token)
	writer.unsigned(value.kind.ordinal as CacheUnsigned)
	writer.bytes(value.value)
	writer.unsigned(value.line as CacheUnsigned)
	writer.unsigned(value.column as CacheUnsigned)
	writer.unsigned(value.startByte as CacheUnsigned)
	writer.unsigned(value.endByte as CacheUnsigned)
end 'cacheWriteToken'

function cacheReadToken(reader LibraryCacheReader) returns Token throws LibraryCacheDamage
	let kind = try cacheReadTokenKind(reader)
	let value = try reader.bytes()
	let line = (try reader.unsigned()) as LineNumber
	let column = (try reader.unsigned()) as ColumnNumber
	let startByte = (try reader.unsigned()) as ByteOffset
	let endByte = (try reader.unsigned()) as ByteOffset

	return Token.create(kind, line: line, column: column, value: value, startByte: startByte, endByte: endByte)
end 'cacheReadToken'

function cacheWriteSharedLibraryParse(writer LibraryCacheWriter, value SharedLibraryParse)
	writer.unsigned(value.variantOf() as CacheUnsigned)
	writer.unsigned(value.keyOf() as CacheUnsigned)
	value.footprint.cacheWrite(writer)
	value.artifact.cacheWrite(writer)
end 'cacheWriteSharedLibraryParse'

function cacheReadSharedLibraryParse(reader LibraryCacheReader, variant HashDigest, key HashDigest) returns SharedLibraryParse throws LibraryCacheDamage
	try requireKey(reader, expected: variant)
	try requireKey(reader, expected: key)

	let footprint = try ParseFootprint.cacheRead(reader)
	let artifact = try FileParseArtifact.cacheRead(reader)

	return SharedLibraryParse.create(variant, key: key, footprint: footprint, artifact: artifact)
end 'cacheReadSharedLibraryParse'

function cacheWriteFixedElementCountColumn(writer LibraryCacheWriter, value FixedElementCountColumn)
	writer.unsigned(value.count() as CacheUnsigned)

	for position in 0 upto value.count() 'eachEntry'
		let held = value.holds(position)
		writer.flag(held)

		if held 'aHeldCount'
			writer.unsigned((try value.get(position) otherwise panic("cacheWriteFixedElementCountColumn: entry {position} is held and absent at once")) as CacheUnsigned)
		end 'aHeldCount'
	end 'eachEntry'
end 'cacheWriteFixedElementCountColumn'

function cacheReadFixedElementCountColumn(reader LibraryCacheReader) returns FixedElementCountColumn throws LibraryCacheDamage
	let count = try reader.count()
	let column = FixedElementCountColumn.create()

	for _ in 0 upto count 'eachEntry'
		let held = try reader.flag()

		if held 'aHeldCount'
			column.push(try cacheReadFixedElementCount(reader))
			continue
		end 'aHeldCount'

		column.pushAbsent()
	end 'eachEntry'

	return column
end 'cacheReadFixedElementCountColumn'

function requireKey(reader LibraryCacheReader, expected HashDigest) throws LibraryCacheDamage
	let carried = try reader.unsigned()

	if carried != expected as CacheUnsigned 'aDifferentEntry'
		throw LibraryCacheDamage.anotherEntry
	end 'aDifferentEntry'
end 'requireKey'
