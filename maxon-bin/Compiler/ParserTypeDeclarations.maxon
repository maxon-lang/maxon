		let declaringType = try scope.typeName() otherwise 'writtenAtFileScope'
			self.closeTypeParamScope()
			return
		end 'writtenAtFileScope'

		self.enterTypeScopeOf(declaringType)

		// An ENUM declares no `uses` clause and no `where` clause, and an undeclared name reaches here only
		// from a program the real parse is already refusing — both leave the empty scopes `enterTypeScope`
		// just installed, which is exactly what those declarations have.
		match self.signatures.structFor(declaringType, readerFilePath: self.job.path) 'declaringType'
			declared(layout) then self.installDeclaringTypeScope(layout)
			undeclared then break
		end 'declaringType'

		self.innerAliasesFromIndex = true
	end 'restoreDeclaringTypeScope'

	// The two per-declaration scopes a `StructLayout` carries, installed together because `enterTypeScope`
	// resets them together. The lists are the layout's own — the same aliasing `openTypeParamScope` already
	// creates between the parser field and the layout it stamps.
