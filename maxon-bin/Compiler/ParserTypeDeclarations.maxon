		// leaves the declaring function's pair standing (see `parseClosureExpression`).
		self.beginDeclaredBody((helperParamCount + layoutReserve) as ValueId, returnSpelling: EmptySourceText, returnBrand: EmptySourceText, returnAlias: self.rangedReturnAlias(returnType), paramSites: RangeCheckParamSiteArray.create(0), layoutParam: layoutParamOf(mayCarryALayoutDescriptor, paramCount: helperParamCount + layoutReserve), countParam: fixedElementCountParamOf(needsCountParam, paramCount: helperParamCount, witnessParamCount: 0), nascentSelfFactory: false, kind: EnclosingBodyKind.declaredFunction, witnessParamBase: 0, witnessParamCount: 0)

		let helper = IrFunction.create(helperName, maxonReturnType: returnType, paramCount: helperParamCount, maxonParamTypes: MaxonTypeArray.create(0), typeSites: self.anchors.functions.noTypeSites, valueTags: self.bodyState.valueTags, valueNameIds: self.bodyState.valueNameIds, valueBrandIds: self.bodyState.valueBrandIds, valueCapabilities: self.bodyState.valueCapabilities, valueMintedSole: self.anchors.functions.mintedSole, valueWitnessIds: self.bodyState.valueWitnessIds, declaredAt: SourcePosition.declaredAt(self.job.path, nameTok: anchor), placeholders: self.anchors.functions, throwsTypeName: ThrowsClause.none)

		// The tier the OWNER decided (`parseDefaultHelper`), which is the one fact about a helper that is not
		// the same for both doors: a parameter's is reachable from every file, a field's from exactly one.
		helper.visibility = visibility

		let helperIndex = self.artifact.module.funcCount()
		self.artifact.module.pushFunc(helper)
		self.artifact.currentFuncIndex = helperIndex

		self.seedHiddenWordParam(self.bodyState.fixedElementCountParam, anchor: anchor)

		self.seedLayoutReserve(helper, firstId: helperParamCount, reserve: layoutReserve, anchor: anchor)

		let entry = self.artifact.module.addBlock(helper, label: b"entry", heat: BlockHeat.normal)
		self.bodyState.currentBlock = entry

		return helper
	end 'openSynthesizedNullaryBody'

	// The cast that is the whole of a field default is what gives the field its type, so `applyCast`
	// exempts it from E3010 even when the value already carries that alias. A cast on an operand that
	// names its own type (`KeyArray.create(0) as KeyArray`, `"x" as String`) gives the field nothing
	// and stays E3010.
	function wholeFieldDefaultCastOf(pending PendingDefaultHelper) returns WholeInitializerCast
		match pending.owner 'owner'
			parameter then return WholeInitializerCast.none
			field then break
		end 'owner'

		let castAt = try self.trailingCastIn(pending.exprStart, regionEnd: pending.exprEnd) otherwise return WholeInitializerCast.none

		if self.defaultRegionNamesItsOwnType(pending.exprStart, regionEnd: castAt) 'theOperandAlreadyGivesTheType'
			return WholeInitializerCast.none
		end 'theOperandAlreadyGivesTheType'

		let castTok = self.tokenAt(castAt)
		return WholeInitializerCast.at(castTok.line, column: castTok.column)
	end 'wholeFieldDefaultCastOf'

	function castIsTheWholeOfAFieldDefault(asTok Token) returns bool
		return match self.bodyState.wholeFieldDefaultCast 'cast'
			none gives false
			at(line, column) gives asTok.line == line and asTok.column == column
		end 'cast'
	end 'castIsTheWholeOfAFieldDefault'

	// Bind each parameter name to its reserved SSA ValueId in the fresh function
	// scope: parameter `i` is ValueId `i` (the ids 0..paramCount-1 the value
	// numbering reserved). Bound as an immutable value binding, so a body reference
	// resolves to the parameter value and a reassignment of an unmarked parameter is rejected as immutable.
	//
	// A parameter of an instance method may COLLIDE with a field of the enclosing type — `function
	// bump(count Integer)` inside a `type Counter` that declares `count`. The aliases are already in
	// scope by now (see `parseFunction`), so `declareValueBinding` refuses it and this is where that
	// refusal becomes E3006, anchored on the PARAMETER's own name token, which is the declaration that
	// has to change.
	// Install one parameter's binding — cell-resident when it arrives by reference, an ordinary value binding
	// otherwise. One fork, at the one site that binds a parameter, so "what kind of binding is a parameter?"
	// has a single answer and the `ScopeError` both kinds can raise is caught once at the caller.
	function declareParameterOrCellBinding(paramName ByteArray, paramType MaxonType, paramKind BindingKind, paramIsByRef bool, paramValue ValueId, brandId TypeNameId) returns VarInfo throws ScopeError
		if paramIsByRef 'arrivesAsACellAddress'
			// ⚠ **THE FLOAT ALIAS IS COLLAPSED HERE AND NOWHERE LATER.** A `var` local's `varType` is the type
			// of its INITIALIZER, which is already resolved; a parameter's is the DECLARED spelling, so a
			// `typealias Float = float(…)` parameter arrives as `named(Float)`. Every reader of a cell
			// binding's type — the load's mint, the store's width, the assignment's coercion — needs the
			// machine class, and `x = 99.0` on such a parameter was E3009 ("cannot implicitly convert 'float'
			// to 'int'") until this resolved it. A ranged INT alias stays `named` on purpose: its NAME is what
			// carries the signedness `valueIsUnsigned` reads.
			return try self.bodyState.scope.declareCellBinding(paramName, varType: self.resolveFloatAliasType(paramType, scopeFilePath: self.job.path), kind: paramKind, cell: paramValue, epoch: self.mintCellEpoch(CellOccupantExclusivity.coOwned), isParameter: true, crossesByReference: true, brandId: brandId)
		end 'arrivesAsACellAddress'

		return try self.bodyState.scope.declareParameterBinding(paramName, varType: paramType, kind: paramKind, value: paramValue, brandId: brandId)
	end 'declareParameterOrCellBinding'

	function bindParameters(func IrFunction, consume CalleeConsume, paramNames NameRoster, paramTypes MaxonTypeArray, paramRanges SourceRangeArray, paramSurfaces DeclaredSurfaceArray, paramTypeStarts TokenIndexArray) throws SourceParseError
		if not isLiftedClosureName(func.name) 'aDeclaredBody'
			self.genericParameterNames = NameRoster.create(0)
		end 'aDeclaredBody'

		for i in 0 upto paramNames.count() 'eachParam'
			let param = i as ParamCount
			let paramId = i as ValueId
			let paramName = try paramNames.get(i) otherwise panic("bindParameters: paramNames.get OOB at {i}")

			if not isLiftedClosureName(func.name) and self.genericBindings.names.contains(self.tokenAt(paramTypeStartAt(paramTypeStarts, position: i)).value) 'declaredAtATypeParameter'
				self.genericParameterNames.push(paramName)
			end 'declaredAtATypeParameter'

			let paramType = self.deferredWhenRefused(try paramTypes.get(i) otherwise panic("bindParameters: paramTypes.get OOB at {i}"))
			let paramRange = try paramRanges.get(i) otherwise panic("bindParameters: paramRanges.get OOB at {i}")

			// ⚠ THE LOOP-PHI TOKEN SCAN DEPENDS ON THIS BEING `let`, AND NOTHING ELSE SAYS SO.
			//
			// `assignedBindingsIn` decides which vars a loop carries a phi for by scanning TOKENS for
			// `identifier =` (`assignsAt`). That is exhaustive only while EVERY write to a mutable
			// binding wears that shape — and a `var` (mutating) PARAMETER does not: its write is
			// `mutate(p)` at the CALL SITE, with no `=` anywhere in the loop for the scan to find.
			// The loop would mint no phi for `p`, and `p` would silently RESET to its entry value
			// on every iteration. A wrong answer, and one no drift guard can catch: unlike the extent
			// mismatch `assertScanAligned` catches, the loop's EXTENT would still be perfectly correct.
			//
			// **The assert is on the KIND ACTUALLY BEING PASSED, at the site that passes it** — not
			// on the constant somewhere else. A real `var`-parameter feature is per-parameter, so it
			// replaces the right-hand side here with `paramIsVar.get(i)`; a tripwire that tested
			// `ParameterBindingKind` would simply stop being read at that moment and never fire,
			// shipping the reset it exists to stop. This one trips on any spelling, because whatever
			// is bound mutable has to come through this line.
			//
			// The other write forms are covered differently: one that IS a statement (`a.b = x`,
			// `x += 1`) has to be taught to `parseStatement`, and `assignsAt`'s comment is the
			// standing instruction to teach the scan in the same edit. A mutating parameter is the
			// case that instruction cannot reach, because it is not a statement at all.
			// ⭐⭐ **IS THIS PARAMETER PASSED BY REFERENCE?** The whole-program answer, asked of the
			// declaration sweep under the name the SOURCE wrote — exactly as the consume facts below are.
			//
			// ⚠ **IT IS ASKED AT POSITION `i` OF THE CALL-ALIGNED LIST, WHICH IS THIS LOOP'S OWN INDEX.** An
			// instance method's `paramNames` already carries `__self` at 0 by the time it reaches here
			// (`parseFunction` prepends it), which is the same alignment the sweep recorded and the same one a
			// receiver-prepending call site slots against.
			let paramIsByRef = maskHasParam(func.reassignedParamMask, param: param)

			// E3207's seed for a `mutable` parameter. `writtenParamMask` answers "does passing an
			// immutable binding HERE make it an error?", and a parameter the declaration marks `mutable` is the
			// plainest possible yes: `let n = 5` handed to a `setTo99(x)` whose parameter `x` is marked must be
			// refused, which is `pass-by-reference.let-to-mutating-param-error`. From there the existing
			// machinery does the rest — `buildParamMutationSummary` closes it over the call graph and
			// `checkCallArguments` reports it. The mark is the whole test: `paramIsByRef` reads
			// the declared mask (`reassignedParamMask`) and no other column.
			if paramIsByRef 'aMutableParameter'
				func.writtenParamMask = maskWithParam(func.writtenParamMask, param: param)
			end 'aMutableParameter'

			// ⚠ **THE VALUE COLUMN KEEPS THE DECLARED TYPE, DELIBERATELY.** ValueId `i` physically holds a
			// cell's ADDRESS, and retyping it to `integer` to say so would make
			// every tier above the lowering read a `Node` parameter as an `int`, and `SemanticCheck.checkArgTypes`
			// would refuse all five transitive cases with `expected 'Node', got 'int'`. The representation is the
			// LOWERING's to know (`LowerMaxonToStd.stdTypeOf`, off `reassignedParamMask`); the type is
			// everyone else's.

			// ⚠ THE LOOP-PHI TOKEN SCAN STILL DEPENDS ON THIS BEING FALSE, AND A BY-REFERENCE PARAMETER NEEDS NO
			// MUTABLE BINDING.
			//
			// A by-reference parameter is NOT bound mutable. It is bound CELL-RESIDENT (below), which takes it
			// out of the phi-tracked class altogether: its name denotes a heap cell whose POINTER is
			// loop-invariant, and its value is read out of memory at each use rather than carried by a block
			// argument. So the phi `assignedBindingsIn` cannot mint for `mutate(p)` at a call site is a phi
			// nothing wants, and the hazard below is answered by construction instead of by widening the scan.
			// That is why the tripwire stands: it catches the thing it was written to catch, and
			// a real `var` parameter would still be wrong for exactly the reason it says.
			let paramKind = ParameterBindingKind

			if paramKind != BindingKind.let 'writesThisScanCannotSee'
				panic("bindParameters: parameter '{String.from(paramName)}' is being bound MUTABLE, but `assignedBindingsIn` finds a loop's carried vars by scanning tokens for `identifier =` — and a `var` parameter is written by `mutate(p)` at the CALL SITE, leaving no `=` for that scan to find. The loop would mint no phi and the parameter would silently reset to its entry value every iteration. Teach `assignsAt`/`assignedBindingsIn` the new write form before binding a parameter mutable.")
			end 'writesThisScanCannotSee'

			// ⭐⭐ **THE THIRD SIGN-EXTENSION DOOR: A PARAMETER MAY ARRIVE RAW OUT OF A NARROW SIGNED SLOT
			// (`enum-narrow-storage`).** The other two answer *"a value coming OUT of a call"* —
			// `emitContainerElementAccessor` for a compiler-emitted element read,
			// `typeResultThroughInstance` for one a corpus body hands back. Neither stands in front of the
			// third shape: a shared corpus body reads a slot with the zero-extending element load and passes
			// the raw word INTO user code as an ARGUMENT, through a function value or a witness call. The
			// body is compiled once against an opaque `Element` and cannot extend it; the caller cannot
			// reach inside the loop that does the read. **The callee's own entry is the one place that can,
			// and it is COMPLETE rather than an enumeration: every value that enters a function from
			// somewhere other than its own reads is a parameter.**
			//
			// ⚠ **MEASURED, and the wrong answer was not only a printed number.** `a.sortBy(cmpSig)` over
			// `Signal { minus = -1 }` — `Array.sortBy`'s comparator carries no conformance
			// constraint, so it is the cheapest reach — had `driftQuicksort`'s `managed.get(scan)` hand
			// `-1` to the user's comparator as **255**, so the comparator saw a value no case of its own
			// type has AND the resulting ORDER was wrong. `stdlib/helpers/sort/*` reaches this shape at
			// five sites and `stdlib/Array.maxon`'s `contains` reaches it through witness dispatch.
			//
			// ⚠ **IT IS SAFE ON A PARAMETER THAT WAS ALREADY CORRECT** — the extension is the identity on
			// every value of the type, because the slot was chosen to hold every one of them
			// (`ProgramSignatures.narrowSignedSlotOf`'s header). So this needs no test for where the
			// argument came from, which is exactly what makes one door enough for all the routes.
			//
			// ⚠ The SLOT keeps ValueId `i` and only the NAME binds to the extended value: the surface mark,
			// the existential instance and the declaration span below are facts about the parameter's own
			// slot, and a narrow signed enum can be none of the things they describe.
			//
			// ⚠ Gated on `buildsBodies` because an UNREACHED stdlib body is skipped whole a few lines after
			// this returns (`skipUnreachedFunctionBody`), and emitting into its entry block would leave an
			// op in a body nothing parses — the same byte-neutrality rule `lowerMaxonToStd` and
			// `insertRangeChecks` both shut their doors onto.
			// ⚠ **A BY-REFERENCE PARAMETER TAKES ITS RAW SLOT AND SKIPS THE SIGN EXTENSION, WHICH IS NOT AN
			// OPTIMIZATION.** The extension exists to widen a value that arrived out of a NARROW SIGNED SLOT;
			// a by-reference parameter carries an ADDRESS, so extending it would sign-extend a pointer. It is
			// also unnecessary: the value is read out of a cell that stores a full machine word
			// (`wordSlotStorageType`), so nothing narrows it on the way in.
			let paramValue = paramId if paramIsByRef else self.narrowSignedParamValue(paramId, paramType: paramType, range: paramRange)

			// E3153 at the SIGNATURE, and NOT the spelled-type door's duplicate: a LIFTED CLOSURE's parameters
			// reach here too, and a `map` transform's may spell no type at all — `parameterTypeOrOffered`
			// takes it from the container's element, so `parseTypeReference` never sees it.
			try self.requireNoManagedValueInRuntimeSource(paramName, value: paramValue, line: paramRange.line, column: paramRange.column)

			// ⭐⭐ **A BY-REFERENCE PARAMETER'S VALUE *IS* THE CELL** — the caller allocated it and the caller owns
			// it, so this frame binds the name to that address and never drops it. Reads become `loadIndirect`
			// through it and the rebind a `storeIndirect`, which is what makes the caller observe the write.
			// `isParameter` still rides: it answers "may the container this name denotes be written?", which is
			// a question a by-reference parameter answers exactly as any other parameter does.
			// ⭐ THE BRAND THE DECLARATION SPELLED (`xs Xs`), stamped on the parameter's own slot and carried by the
			// binding: the callee's body reads it at every door, and the caller's half is the signature's
			// `paramDeclaredNames` column (`paramDeclaredNamesOf`), read off the same token.
			let paramBrand = self.declaredBrandAt(paramTypeStartAt(paramTypeStarts, position: i), resolved: paramType)
			self.brandValue(paramId, brand: paramBrand)

			// Parameter `i` owns ValueId `i`; record its declaration span so the register-pressure
			// diagnostic can resolve the parameter to source (it is minted by no op — see
			// ParamOriginTable — so it has no `emitOp` origin).
			self.artifact.recordParamOrigin(paramId, range: paramRange)

			// After the origin, which a `_` parameter's slot still needs: only its name goes unbound.
			if paramName.equals(DiscardBindingName) 'aDiscardedParameter'
				if not paramIsByRef and consume.isConsumedAt(param) and self.valueIsManagedHeap(paramId) 'aRegionNobodyReads'
					self.markValueOwnsHeap(paramId, exclusivity: OwnedHeapExclusivity.coOwned)
					self.enrolOwnedBinding(VarInfo.createValueBinding(DiscardBindingName, varType: paramType, kind: BindingKind.let, boundValue: paramId))
				end 'aRegionNobodyReads'

				continue
			end 'aDiscardedParameter'

			let binding = try self.declareParameterOrCellBinding(paramName, paramType: paramType, paramKind: paramKind, paramIsByRef: paramIsByRef, paramValue: paramValue, brandId: self.brandIdOf(paramId)) otherwise throw SourceParseError.localShadowsSelfField(String.from(paramName), typeName: String.from(self.enclosingTypeName()), line: paramRange.line, column: paramRange.column)

			// ⭐ **E3012 CANDIDATE: A DECLARED PARAMETER MUST BE READ** (`reportUnusedBindings`). `__self` is not
			// a candidate, and that is not a policy choice: it is the RECEIVER the parser itself pushed, which no
			// source token declares and a bare field read never mentions, so every instance method would report it.
			self.trackDebugLocal(binding)

			if self.job.recordsEditorFacts and not paramName.equals(SelfParamName) 'anEditedParameter'
				self.noteEditorBinding(binding, line: paramRange.line, column: paramRange.column)
			end 'anEditedParameter'

			if not paramName.equals(SelfParamName) 'checkedForUse'
				self.bodyState.unusedCandidates.push(UnusedBindingCandidate.create(binding, nameRange: paramRange, kind: UnusedBindingKind.parameter, declToken: self.pos))
			end 'checkedForUse'

			// ⭐ **A PARAMETER THAT NAMED `__ManagedMemory` DENOTES THE BUFFER THERE** — the spelling
			// was read at the declaration (`parseFunctionParameters`) and this is the site that BINDS the value it
			// named, so this is where the fact becomes the marks `dispatchArrayMethod` and `emitFieldLoad` read.
			// Parameter `i` owns ValueId `i`, which is what makes the column's index the value's.
			self.markDeclaredSurface(paramId, declared: try paramSurfaces.get(i) otherwise panic("bindParameters: paramSurfaces.get OOB at {i} — a parameter's columns are built in lockstep"))

			// ⛔⛔ **NO SIZED-CONTAINER MARK IS WRITTEN HERE, BECAUSE A DECLARATION-KEYED MARK IS A
			// MEASURED OVER-REFUSAL.** A parameter spelled `ElementMemory` inside the sized
			// container's declaration looks like the record and is not necessarily one: `managed.slice(0, 2)`
			// mints a fresh VIEW whose type is the SAME `__ManagedMemory with Element`, so a declaration-keyed
			// mark cannot tell the two apart and would mark the view as well. MEASURED: passing a slice to a
			// `FixedArray` helper that calls `clear()` on it was refused *"this buffer is a `FixedArray`'s own
			// record"* — a legal program refused by a FALSE sentence, while the identical `s.clear()` written
			// in place compiled and ran (exit 30). ⇒ The fact is CARRIED, never inferred: the mark lives on
			// the value that `bufferSurfaceOfDeclaredRecord` minted.
			// ⭐ **AND THE OTHER FACT THE DECLARATION HELD AND THE TYPE COLUMNS CANNOT** — a parameter
			// declared at a PARAMETERIZED interface type carries `interfaceRef(Base)` and nothing about what
			// `Base`'s associated positions were bound to, which is what a dispatch on it needs to type an
			// associated-type result. Gated on the tag so no other parameter pays a lookup: only an existential
			// can have `with` arguments to have lost.
			if maxonTypeTag(paramType) == ValueTypeTag.interfaceRef 'declaredAtAnInterface'
				let paramTypeStart = paramTypeStartAt(paramTypeStarts, position: i)

				if let claim = try self.declaredExistentialInstanceAt(paramTypeStart) 'namesAnInstantiation'
					self.recordValueExistentialInstance(paramId, claim: claim)
				end 'namesAnInstantiation'
			end 'declaredAtAnInterface'

			// ⭐ **A CONSUMED MANAGED PARAMETER IS ENROLLED AS OWNED**. The consume analysis
			// marked it moved-into-durable-storage, so the caller transfers ownership at the call site and
			// this function OWNS the value: it is enrolled exactly as an owned local, so `moveInPayload`
			// accepts moving it into a field (an owned bare-local reference is poisoned), and if it is NOT
			// moved on some path `emitFunctionExit` drops it once at function exit — sound whether the analysis
			// was exact or over-approximated. A SCALAR consumed param owns no heap and is left borrowed (its
			// consume bit is inert), so it is never enrolled — a decref of an integer would corrupt the count.
			//
			// ⚠ **CO-OWNED, NOT SOLE, AND THE DIFFERENCE IS A SEGFAULT THIS FRAME CANNOT SEE.** The caller
			// transfers a consumed argument either by MOVING an owned value or by `coOwnBorrowedForConsume`'s
			// `__mm_incref` of a borrowed one, and which it chose is a fact about the CALL SITE, not about this
			// signature — the same boundary the transitive-consume fixpoint sits on. So a `match` on a consumed
			// union parameter must RETAIN its payload rather than null the slot, or an incref-transferring caller
			// re-reads a hole (measured on the sibling shapes; see `OwnedHeapExclusivity`).
			// ⚠ **A BY-REFERENCE PARAMETER IS NEVER ENROLLED OWNED, AND THE `not paramIsByRef` IS LOAD-BEARING
			// RATHER THAN BELT-AND-BRACES.** The cell belongs to the CALLER's frame; dropping it here would free
			// the caller's storage out from under it. The retype above already makes `valueIsManagedHeap` answer
			// false for it — the value is an `integer` now — but that is a consequence of how the address is
			// typed, not a statement of the ownership rule, and a future retype would silently take the guard with
			// it. The rule is stated where it is decided.
			if not paramIsByRef and consume.isConsumedAt(param) and self.valueIsManagedHeap(paramId) 'consumedManaged'
				self.markValueOwnsHeap(paramId, exclusivity: OwnedHeapExclusivity.coOwned)
				self.enrolOwnedBinding(binding)
			end 'consumedManaged'

			// A promise parameter is owned by the callee exactly where `takesPromiseAt` says so: a
			// body that moves it on (into a field or a container, through `await` or `cancel`, or to a
			// callee that takes it) or hands it back with a `return` takes ownership and must drop it on a path that does not; a body that
			// only looks at it leaves it with the caller. The caller's move asks the same predicate
			// (`transferConsumedArgs`), so the green thread has one owner.
			//
			// Owning a peeked parameter would cancel the caller's thread at the callee's exit while the
			// caller, and any container it was read out of, still named it; the promise would never complete
			// (`promise-peek.md`: the peek is a question, never a step).
			//
			// An unowned, slotless promise is a borrow, which `requireConsumedPromiseIsOwned` refuses to let
			// a consume door or a `return` reclaim.
			if not paramIsByRef and consume.takesPromiseAt(param) and self.valueIsPromise(paramId) 'aPromiseParameter'
				self.markValuePromise(paramId)
				self.enrolOwnedBinding(binding)
			end 'aPromiseParameter'

			// ⭐ **A CONSUMED OPAQUE TYPE-PARAMETER FEED PARAMETER IS ENROLLED AS OWNED**. A
			// feed parameter (`push(item Element)` moving `item` into `self.items`, or a sibling forwarder the
			// transitive fixpoint marked) is CONSUMED at its concrete call site — the callee OWNS the value — but
			// its `typeParameter` tag fails `valueIsManagedHeap` (opaque here), so the branch above never enrols
			// it. Enrol it now so the SHARED body move-tracks it: a `self.items.push(item)` / consuming
			// `self.N(item)` forward MOVES it (poisons the binding, a second use → E3102), and if it is left LIVE
			// on some path `emitScopeDrops` / the join reconciliation drop it once through the descriptor-gated
			// `__drop_type_param` (0 destructor for a trivial instantiation → inert). An always-moved feed
			// (`push`) is `movedFrom` at exit, so no drop is emitted and the shared body's rendered Target
			// IR is unchanged — only a method that can drop becomes a layout carrier
			// (`MaxonToStdLowering.planLayoutCarriers`).
			//
			// ⚠⚠ **IT ASKS THE FEED'S SINK, NOT WHETHER THE FUNCTION HAS A RECEIVER.** A callee-storage feed
			// is moved into that storage. A `Self{value: v}` CONSTRUCTOR feed is CO-OWNED instead: each
			// store of it into a record takes its own reference (`opaqueSlotTakesItsOwnReference`) and this
			// frame settles its own per path (`FeedDropGuard`), so a throw before the store still drops
			// the consumed argument and two records built from it hold two references. A constructor feed
			// is kept only when some instantiation can owe a reference (`typeParamFeedCanOwnAReference`)
			// or hold a green thread (`typeParamHoldsAGreenThread`); any other is left to the call
			// site (`constructorFeedParams`). No by-reference feed is kept: it holds the caller's cell
			// address, and enrolling it would release that address. A has-a-receiver test standing
			// in for that distinction would be exact only while the recognizer saw `self`-headed stores
			// alone; a STATIC that pushes its argument into a local `Array with T` and hands that array to
			// the `Self` it returns feeds CALLEE STORAGE with no receiver at all, and reading the receiver
			// there would leave the caller transferring a value nobody drops (a leak). The sink is recorded,
			// so this reads it.
			//
			// Gated on the opaque `typeParameter` tag as well: a feed parameter is type-parameter-typed by
			// construction (`markOpaqueContainerMutatorFeeds` marks only such a parameter), so the tag test
			// is redundant with the feed — but it makes this branch PROVABLY exclusive of the managed branch
			// above (which needs `valueIsManagedHeap`, false for a `typeParameter`), so no parameter is ever
			// enrolled twice, and it pins the drop router's `typeParameter` arm to exactly what is enrolled
			// here.
			//
			// Co-owned for the branch above's reason, which does not depend on the tag: a feed parameter's
			// concrete call site may have increfed a borrow to pay for the slot.
			let feed = consume.feedAt(param)

			if self.tagOf(paramId) == ValueTypeTag.typeParameter and feed.isFeed() 'opaqueFeed'
				let constructed = not feed.answers(FeedSinkQuery.calleeStorageSink)
				let feedTypeParam = self.valueTypeParamId(paramId)
				let feedMayBeMoved = constructed and self.typeParamHoldsAGreenThread(feedTypeParam)
				let keptByThisFrame = not paramIsByRef and (not constructed or feedMayBeMoved or self.signatures.typeParamFeedCanOwnAReference(feedTypeParam))

				if keptByThisFrame 'enrolled'
					self.markValueOwnsHeap(paramId, exclusivity: OwnedHeapExclusivity.coOwned)
					self.enrolOwnedBinding(binding)

					if constructed 'constructedFeed'
						self.bodyState.coOwningFeedParams = withValueMarked(self.bodyState.coOwningFeedParams, value: paramId)
						self.enrolFeedDropGuard(paramId)
					end 'constructedFeed'
				end 'enrolled' else if constructed 'settledByTheCaller'
					self.bodyState.constructorFeedParams = withValueMarked(self.bodyState.constructorFeedParams, value: paramId)
				end 'settledByTheCaller'
			end 'opaqueFeed'

			if not paramIsByRef and not binding.isEnrolled and self.valueHoldsAUniqueRecord(paramValue) 'aLentUnique'
				self.bodyState.lentUniqueParams.push(paramValue)
				self.bodyState.lentUniqueParamNames.push(paramName)
			end 'aLentUnique'
		end 'eachParam'
	end 'bindParameters'

	function enrolFeedDropGuard(feed ValueId)
		let guard = self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
		self.enrolOwnedBinding(VarInfo.createValueBinding(FeedDropGuardName, varType: MaxonType.integer, kind: BindingKind.let, boundValue: guard))
		self.bodyState.feedDropGuards.push(FeedDropGuard.create(feed, guard: guard))
	end 'enrolFeedDropGuard'

	function feedGuardedBy(guard ValueId) returns ValueId throws AbsentError
		for entry in self.bodyState.feedDropGuards 'eachGuard'
			if entry.guard == guard 'thisGuard'
				return entry.feed
			end 'thisGuard'
		end 'eachGuard'

		throw AbsentError.absent
	end 'feedGuardedBy'

	function feedIsGuarded(feed ValueId) returns bool
		for entry in self.bodyState.feedDropGuards 'eachGuard'
			if entry.feed == feed 'thisFeed'
				return true
			end 'thisFeed'
		end 'eachGuard'

		return false
	end 'feedIsGuarded'

	// `stayUnsettled` leaves a guard a loop would carry live, because moving a pre-loop binding
	// inside a loop body is unsound (`bindingIndexEscapesLoop`). That is sound only where no
	// instantiation holds a green thread, so `__reclaim_type_param` never destroys; a green-thread
	// feed's store is a real move instead (`noteFeedStored`), which the loop refuses with E3102.
	function settleFeedDropGuardOf(feed ValueId, loopCarried LoopCarriedGuards)
		for entry in self.bodyState.feedDropGuards 'eachGuard'
			if entry.feed != feed 'anotherFeed'
				continue
			end 'anotherFeed'

			let index = try self.liveOwnerIndexOf(entry.guard) otherwise return

			if loopCarried == LoopCarriedGuards.stayUnsettled and self.bindingIndexEscapesLoop(index) 'aLoopWouldCarryIt'
				return
			end 'aLoopWouldCarryIt'

			let owned = try self.bodyState.ownedBindings.get(index) otherwise panic("settleFeedDropGuardOf: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf`")
			owned.setMovedFrom(true, ledger: self.bodyState.moveLedger)
			return
		end 'eachGuard'
	end 'settleFeedDropGuardOf'

	function typeParamHoldsAGreenThread(param TypeParamId) returns bool
		return match self.signatures.typeParamFeedGreenThreadInstantiation(param) 'greenThread'
			noInstance gives false
			instance gives true
		end 'greenThread'
	end 'typeParamHoldsAGreenThread'

	// Where `T` can hold a green thread the store is a real move, so the move machinery refuses a
	// second store or a loop store (E3102). The release right after the caller's retain hands the
	// record the frame's own reference: a no-op for a promise, and what keeps a String or aggregate
	// instantiation from leaking one.
	function noteFeedStored(feed ValueId, range SourceRange)
		if not valueIsMarked(self.bodyState.coOwningFeedParams, value: feed) 'notAKeptFeed'
			return
		end 'notAKeptFeed'

		if self.typeParamHoldsAGreenThread(self.valueTypeParamId(feed)) 'aMovedInstantiation'
			self.emitOwnershipRuntimeCall(ReleaseTypeParamName, args: argsOf(feed), range: range)
			self.moveOwnedValueOut(feed)
			return
		end 'aMovedInstantiation'

		self.settleFeedDropGuardOf(feed, loopCarried: LoopCarriedGuards.stayUnsettled)
	end 'noteFeedStored'

	function capturedNameOf(value ValueId) returns ByteArray throws AbsentError
		match self.bodyState.capturedSlots 'column'
			unwritten then throw AbsentError.absent
			entries(bySlot) then return (try self.bodyState.captureNames.get(try bySlot.get(value) otherwise throw AbsentError.absent) otherwise throw AbsentError.absent).clone()
		end 'column'
	end 'capturedNameOf'

	// Keyed on the capture rather than the feed: a closure's captured opaque `T` is not a recognised
	// feed, so no drop guard or move tracks it, and a closure run twice would give one promise away
	// twice.
	function requireCapturedOpaqueHoldsNoGreenThread(value ValueId, range SourceRange) throws SourceParseError
		let door = try self.capturedNameOf(value) otherwise return

		match self.signatures.typeParamFeedGreenThreadInstantiation(self.valueTypeParamId(value)) 'greenThread'
			noInstance then return
			instance(site) then try self.refuseCaptureOfAnInstantiation(site, door: door, range: range)
		end 'greenThread'
	end 'requireCapturedOpaqueHoldsNoGreenThread'

	function refuseCaptureOfAnInstantiation(site InstantiationSiteLookup, door ByteArray, range SourceRange) throws SourceParseError
		self.blameLibraryRefusalOnInstantiation(site)
		throw capturedPromiseRefusal(range, door: door)
	end 'refuseCaptureOfAnInstantiation'

	// ⭐⭐ **SEED AND WIRE THE COMPANION WITNESS PARAMETERS** — one hidden machine word per
	// interface-typed user parameter not taken by reference (its cell carries the witness), appended
	// as a block, pointed at from the user parameter's own dense column.
	//
	// ⚠ **THEY ARE APPENDED AFTER THE USER PARAMETERS, AND THE ORDER IS THE WHOLE ABI:**
	// `[user][existentialWitness][count][constraintWitness][layout]`. Every hidden parameter BELOW
	// this one is addressed from the END (`fixedElementCountSlotValueId`, `witnessBlockStartValueId`,
	// `layoutDescriptorSlotValueId`), so this block moves none of them.
	//
	// The companion is UNNAMED: `bindParameters` never binds it, and only the widening (caller side) and the
	// dispatch (callee side) read it, by position.
	function bindExistentialWitnessParams(paramTypes MaxonTypeArray, paramRanges SourceRangeArray, userParamCount ParamCount, byReference ParamPositionMask)
		var witnessSlot = userParamCount

		for i in 0 upto userParamCount 'eachParam'
			let paramType = try paramTypes.get(i) otherwise panic("bindExistentialWitnessParams: paramTypes.get OOB at {i}")

			if not paramCarriesAnExistentialWitness(paramType, param: i, byReference: byReference) 'noWitnessCompanion'
				continue
			end 'noWitnessCompanion'

			// Seeding pushes to every value column, so it must precede the pairing set.
			self.recordValueType(MaxonType.integer)
			self.pairInterfaceWitness(i as ValueId, witness: witnessSlot as ValueId)
			let paramRange = try paramRanges.get(i) otherwise panic("bindExistentialWitnessParams: paramRanges.get OOB at {i}")
			self.artifact.recordParamOrigin(witnessSlot as ValueId, range: paramRange)
			witnessSlot = witnessSlot + 1
		end 'eachParam'
	end 'bindExistentialWitnessParams'

	// Is `value` a managed HEAP value — a struct box, a String, or a boxed union — the kinds a consumed
	// parameter can own (and this function must drop) and a consumed argument must transfer? A ranged-alias /
	// `int` / `bool` owns no heap. This is the one owned-temp adoption test, so `enrolOwnedCallTemp` routes
	// through it rather than re-spelling the three tags. A managed heap value is a BYTE RECORD (a String or a
	// Character) or a non-text aggregate, so it is derived from `valueIsNonTextAggregate` to keep the
	// aggregate half stated once.
	//
	// ⚠ **`tagIsByteRecord`, NOT `tagIsText` — THIS IS THE LEAK SITE.** It is the single test that decides
	// whether a freshly minted value is ADOPTED as an owned temporary and therefore ever dropped. Spelled
	// `tagIsText` it answers "no" for a Character, and every Character a program produces — every trip of
	// `for c in s` — is allocated and never freed (measured by sabotage: exit 101).
	// ⭐⭐ **NO MANAGED VALUE MAY BE NAMED IN A `runtime/` SOURCE FILE (E3153).** The reference-counting
	// pass emits `__mm_incref` / `__mm_decref` around such a value, into the very tier this file DEFINES: the
	// runtime function managing a `String` would be lowered with bookkeeping that calls the function being
	// lowered, a circularity with no fixed point.
	//
	// ⚠ **IT IS ASKED AT THE NAME, WHICH IS WHY IT SITS AT THE BINDING DOOR AND NOT AT A LATER PASS.** Asked
	// downstream, the legality of a runtime file would turn on which optimizations happened to elide its
	// retains — a file that compiles or not depending on the inliner.
	//
	// The predicate is `valueIsManagedHeap`, the compiler's own answer to "does this value own heap": a
	// String, a Character, a struct box, a boxed union and an existential are all one, and a ranged alias or
	// a `bool` is not. Sharing it is what stops this rule from acquiring a second, drifting idea of what
	// "managed" means.
	//
	// ⚠ **A FUNCTION VALUE IS ONE OF THEM, AND AN IMMORTAL ONE IS EXEMPT.** A function reference and a
	// non-capturing closure are immortal `.rdata` records no count touches
	// (`valueIsImmortalFunction`); the record a CAPTURING closure builds is a fact about the value and
	// not its type, recorded where it is built (`noteClosureRecordInRuntimeSource`).
	//
	// ⚠ **THIS IS THE HALF THAT ANSWERS FOR A VALUE WHOSE TYPE THE AUTHOR NEVER WROTE** — an inferred local,
	// a `map` transform's hinted parameter. A SPELLED type is `requireNoManagedTypeInRuntimeSource`'s, asked
	// at the one door every written type comes through, and that is what covers a field and a return.
	//
	// ⚠ **ITS TWO CALLERS ARE NOT EVERY BINDING DOOR, AND THEY DO NOT HAVE TO BE.** A loop variable, a
	// closure-captured cell, a caught error and a match payload each bind a name through their own door, and
	// an unnamed managed TEMPORARY binds nothing at all; none of them reaches this line. What refuses those
	// is `noteManagedValueInRuntimeSource`, asked at the two writers of the value type columns, which every
	// value passes whatever bound it. This door survives it because a BOUND NAME is a sharper sentence than
	// a construct — it names the thing the author has to change — and never because it is needed for cover.
	function requireNoManagedValueInRuntimeSource(name ByteArray, value ValueId, line LineNumber, column ColumnNumber) throws SourceParseError
		if not self.job.isRuntimeSource or not self.valueIsManagedHeap(value) or self.valueIsImmortalFunction(value) 'nothingToRefuse'
			return
		end 'nothingToRefuse'

		throw SourceParseError.managedValueInRuntimeSource(String.from(name), typeName: self.valueDisplayTypeName(value), line: line, column: column)
	end 'requireNoManagedValueInRuntimeSource'

	// ⭐⭐ **THE COMPLETE HALF OF E3153 — asked of the VALUE, at the two sites that write a value's type.** A binding
	// form is a list and a list rots; `mintValue` and `retypeValue` are the whole of how a value acquires a
	// type, so a managed one cannot enter a runtime file unseen. `retypeValue` is not a duplicate of the
	// mint: a caught error is minted `integer` for its zero test and becomes its union type there, so the
	// mint alone would admit exactly the door a `try`/`otherwise` binding opens.
	//
	// FIRST wins and later ones are dropped — the earliest is the one the author reaches first, and the
	// refusal is a throw, so a second could never be reported anyway.
	function noteManagedValueInRuntimeSource(value ValueId)
		if not self.runtimeSourceHasNoRecordedOffence() 'nothingToRecord'
			return
		end 'nothingToRecord'

		if not self.valueIsManagedHeap(value) or self.tagOf(value) == ValueTypeTag.function 'ownsNoHeapAtItsMint'
			return
		end 'ownsNoHeapAtItsMint'

		self.recordManagedValueInRuntimeSource(value)
	end 'noteManagedValueInRuntimeSource'

	function noteClosureRecordInRuntimeSource(value ValueId)
		if not self.runtimeSourceHasNoRecordedOffence() 'nothingToRecord'
			return
		end 'nothingToRecord'

		self.recordManagedValueInRuntimeSource(value)
	end 'noteClosureRecordInRuntimeSource'

	// Is this a runtime file whose first offence is still ahead of it? Spelled out rather than folded into
	// each caller's guard so that `mintValue`'s test — paid by every value in every file — is one field read.
	function runtimeSourceHasNoRecordedOffence() returns bool
		return self.job.isRuntimeSource and not self.runtimeSourceOffence.isRecorded()
	end 'runtimeSourceHasNoRecordedOffence'

	function recordManagedValueInRuntimeSource(value ValueId)
		self.runtimeSourceOffence = RuntimeSourceOffence.recorded(self.valueDisplayTypeName(value), value: value, funcIndex: self.artifact.currentFuncIndex, anchorIndex: self.pos)
	end 'recordManagedValueInRuntimeSource'

	// The refusal the recording door defers to, raised once per file at the end of `parseModule` — the one
	// point at which every function of the file, its lifted closures and its default helpers among them, has
	// been built.
	function requireNoManagedValueWasBuiltInRuntimeSource() throws SourceParseError
		match self.runtimeSourceOffence 'offence'
			none then return
			recorded(typeName, value, funcIndex, anchorIndex) then throw self.managedValueBuiltInRuntimeSourceError(typeName, value: value, funcIndex: funcIndex, anchorIndex: anchorIndex)
		end 'offence'
	end 'requireNoManagedValueWasBuiltInRuntimeSource'

	// Where the recorded value was built: its defining op's span, or — for a value no op defines, which a
	// merge phi is — the cursor the mint stood at.
	function managedValueBuiltInRuntimeSourceError(typeName String, value ValueId, funcIndex ElementIndex, anchorIndex ElementIndex) returns SourceParseError
		let span = self.runtimeManagedValueSpan(value, funcIndex: funcIndex, anchorIndex: anchorIndex)
		return SourceParseError.managedValueBuiltInRuntimeSource(typeName.clone(), line: span.line, column: span.column)
	end 'managedValueBuiltInRuntimeSourceError'

	function runtimeManagedValueSpan(value ValueId, funcIndex ElementIndex, anchorIndex ElementIndex) returns SourceRange
		match self.artifact.valueOrigins.lookup(funcIndex, valueId: value) 'origin'
			none then break
			found(opIndex) then return self.artifact.opRanges.get(opIndex)
		end 'origin'

		return SourceRange.ofToken(self.tokenAt(anchorIndex))
	end 'runtimeManagedValueSpan'

	function valueIsManagedHeap(value ValueId) returns bool
		return tagIsByteRecord(self.tagOf(value)) or self.valueIsNonTextAggregate(value)
	end 'valueIsManagedHeap'

	// Is `value` a managed heap AGGREGATE — a struct box or a boxed union — but NOT a String? An aggregate
	// has no cheap owning COPY (unlike a String, which promotes with the fused-record blit
	// `promoteToOwnedString`), so a borrowed one becomes owned only by CO-OWNERSHIP — an `__mm_retain`
	// incref of the shared box (`retainBorrowedAggregate`).
	//
	// ⭐ **ALL THREE DOORS SPEND IT, AND CO-OWNING ACROSS A CALL BOUNDARY NEEDS NO CROSS-CALL CONSUME.**
	// The `var q = p` binding spends it in-frame. The two HAND-OFF sites — `return <borrowed aggregate>`
	// (`emitOwnedValueReturn`) and a borrowed-aggregate `gives`/ternary arm merged into an owned result phi
	// (`promoteBorrowedGive`) — spend it across a call boundary, which needs no cross-call consume. The
	// refcount is what makes the difference: the callee increfs
	// before the `ret`, the caller adopts and decrefs once, and the borrow's own owner never notices — the
	// same balance the in-frame binding gets, with the two halves in different frames. What genuinely needs
	// the cross-call consume is a MOVE, where the source must be poisoned so exactly one owner remains
	// (`moveManagedValueInto`, still a clean refusal for a borrowed aggregate).
	// ⭐ **AN EXISTENTIAL IS ONE.** Its VALUE half is a conformer's record, which
	// has no cheap owning copy either — a fat pointer cannot be deep-copied without knowing the dynamic type
	// — so it becomes owned by exactly the same CO-OWNERSHIP the aggregates above use, and `retainBorrowedAggregate`
	// carries its witness across the retain. Reading it as a trivial scalar is what leaves a consumed
	// existential parameter unenrolled (`bindParameters`), so the callee owns a reference nothing dropped.
	function valueIsNonTextAggregate(value ValueId) returns bool
		let tag = self.tagOf(value)

		// A generic INSTANCE (`Sizer with bool`) is a heap box exactly like a plain `structRef`: a
		// pointer to a refcounted record with a baked destructor. It carries the SAME managed-aggregate
		// obligations — owned, dropped once at scope exit, never handed off borrowed-as-owned — so it joins
		// the boundary here rather than being read as a trivial scalar and leaked.
		return self.valueIsAHeapRecord(value) or self.instanceValueIsAManagedRecord(tag, value: value) or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.function or self.valueIsBoxedUnion(value)
	end 'valueIsNonTextAggregate'

	// ⚠ The split every REPRESENTATIONAL door asks, and `valueIsNonTextAggregate` above is why it has to
	// exist: an inline record's value is a WORD, so enrolling one as an aggregate puts it under ownership,
	// retain, drop and move — an `__mm_incref` of a bit pattern, with no diagnostic anywhere. The tag alone
	// cannot tell the two apart; only the named type's layout can (`tagNamesADeclaredType`).
	function valueIsAnInlineRecord(value ValueId) returns bool
		return tagNamesADeclaredType(self.tagOf(value)) and self.signatures.nameIsInlineRecord(self.valueTypeName(value))
	end 'valueIsAnInlineRecord'

	function valueIsAHeapRecord(value ValueId) returns bool
		return tagNamesADeclaredType(self.tagOf(value)) and not self.signatures.nameIsInlineRecord(self.valueTypeName(value))
	end 'valueIsAHeapRecord'

	// ⭐⭐ **THE ONE EXCEPTION TO "A GENERIC INSTANCE IS A REFCOUNTED BOX": A PROMISE.** `Promise with T` is a
	// generic instance like any other to the type system, and is NOT a `__mm_alloc` record at run time — its
	// value is a pointer into the SCHEDULER'S OWN SLAB, whose lifetime is the green thread's and is
	// discharged by `__gt_promise_drop`, never by a refcount. `PromiseType.maxon`'s first fact states it, and
	// `ProgramSignatures.typeIsManaged` says it about the TYPE; this is the same statement
	// about a VALUE, and the two must not come to disagree.
	//
	// ⛔ **WITHOUT IT, TYPING THE PROMISE TURNS EVERY OWNERSHIP DOOR INTO A WRONG ANSWER AT ONCE.** MEASURED
	// the moment `emitAsyncCall` began minting at the instance: `__mm_retain` on a GT pointer at `var q = p`,
	// `__mm_decref` on one at every scope exit, and a COMPILER PANIC out of `pushMergedEdgeValue` — *"the
	// merged binding's phi owns its heap but the incoming edge value does not"* — because a promise reaching
	// a merge was suddenly a managed aggregate on one side of the join and not the other. 28 of the 139
	// `async` cases went red on that one predicate.
	//
	// ⚠ It asks the TYPE (`typeIsPromiseStorage`), never the ownership MARK. Whether this frame owns the
	// thread is a different question with a different door (`valueOwnsGreenThread`); what is being decided
	// here is whether the value is a box, and a promise is not one whoever owns it.
	function instanceValueIsAManagedRecord(tag ValueTypeTag, value ValueId) returns bool
		if tag != ValueTypeTag.genericInstance 'notAnInstance'
			return false
		end 'notAnInstance'

		return not typeIsPromiseStorage(self.signatures, t: self.typeOf(value))
	end 'instanceValueIsAManagedRecord'

	// `returns <Type>`, with an optional capability word (`mutable`, `isolated` or `immutable`), or nothing (void). The return type
	// flows to the registry (for SemanticCheck) and to lowering (via the function signature).
	function parseOptionalReturnType() returns QualifiedReturn throws SourceParseError
		if not self.at(TokenKind.returns) 'noReturns'
			return QualifiedReturn.create(MaxonReturnType.void, capability: ResultCapability.unmarked)
		end 'noReturns'

		try self.consume(TokenKind.returns)
		let (spelled, capability) = try self.readCapabilityQualifiedType(BarePrimitiveVoice.asAType)
		return QualifiedReturn.create(MaxonReturnType.value(spelled), capability: resultCapabilityOf(capability))
	end 'parseOptionalReturnType'

	// The `throws E` clause that follows a function's return type. `E` is the name of a payload-free
	// enum conforming to `Error` (validated later, in SemanticCheck; the sweep and the real parse are
	// tolerant). Read by BOTH the declaration sweep (`recordScannedSignature`, whole-program) and the real
	// parse (`parseFunction`, which stamps `func.throwsTypeName`), so the throws fact is captured once and
	// shared, exactly as `parseOptionalReturnType` is.
	//
	// ⭐⭐ **THE NAME MAY BE A DOTTED CHAIN.** `BNF_SYNTAX.md:241` says `throws_clause = 'throws' type_ref`, and a
	// type reference is a chain, so `throws Store.keep.sendError` — a send's error type, which is a registered
	// union — is one name; a reader that consumed exactly ONE identifier would die on `E2001: unexpected token: '.'`.
	//
	// ⭐ **IT IS THE *SAME* WALK `parseTypeReference`'s qualified arm uses**, `dottedChainLengthAt` /
	// `assembleDottedChainAt`, rather than a hand-rolled loop — which is what admits a KEYWORD standing as a
	// segment (the keyword-as-a-name rule) here exactly as it is admitted there. The walk is purely syntactic and asks no
	// registry, so the tolerant sweep and the real parse still answer identically, and all three callers get
	// the one reader's answer.
	function parseOptionalThrowsClause() returns ThrowsClause throws SourceParseError
		if not self.at(TokenKind.throws) 'noThrows'
			return ThrowsClause.none
		end 'noThrows'

		try self.consume(TokenKind.throws)

		let headIndex = self.pos

		// Read BEFORE the consume below, which moves the cursor off the head the walk counts from.
		let qualifierDots = self.dottedChainLengthAt(headIndex)
		let nameTok = try self.consume(TokenKind.identifier)

		if qualifierDots == 0 'aBareName'
			try self.requireNameableTypeNameAt(headIndex, written: nameTok.value, anchor: nameTok)

			return ThrowsClause.throwing(String.from(self.signatures.bareWrittenKey(nameTok.value, readerFilePath: self.job.path)))
		end 'aBareName'

		// Stops PAST the final segment, as the type-reference walk does: nothing downstream of a `throws`
		// clause consumes that token either. `advance` and not `consume(identifier)`, because a segment may be
		// a keyword standing as a name.
		let qualified = self.assembleDottedChainAt(headIndex, dots: qualifierDots)
		let chain = try self.resolvedTypeChainAt(headIndex, anchor: nameTok, use: ChainUse.typeReference)

		for _ in 0 upto qualifierDots 'eachSegment'
			try self.consume(TokenKind.dot)
			self.advance()
		end 'eachSegment'

		return ThrowsClause.throwing(String.from(chain.denotedName(qualified)))
	end 'parseOptionalThrowsClause'

	// ⛔ **A DECLARATION HEADER ENDS AT THE END OF ITS LINE** — a function signature once its optional
	// `returns` and `throws` clauses have been offered, an `enum`/`union` header once its optional
	// `implements` clause has. A token still standing belongs to no part of the header, and the body starts
	// on the next line. `function foo() int` (the `returns` keyword omitted) and `enum Colour int` (a backing
	// type the language infers from the raw values) are the shapes this names; without the check the first
	// reaches the statement dispatcher and the second is read as a CASE.
	//
	// ⚠ **IT IS A CHECK HERE AND NOT A REFUSAL INSIDE THE CLAUSE READERS:** `parseOptionalReturnType` runs
	// BEFORE the `throws` clause, so to leave `function f() throws E` alone it would have to know the
	// follow set of `)` — the grammar's order, written down a second time. The readers are also shared with
	// the TOLERANT declaration sweep, whose `otherwise return` would swallow the refusal and report nothing;
	// the real parse holds the position and reports.
	//
	// EOF is admitted so a source truncated mid-declaration keeps reaching the missing-`end` diagnostic,
	// which says more about it than "unexpected token".
	function requireDeclarationHeaderLineEnd() throws SourceParseError
		if tokenKindEndsALine(self.kindAt(self.pos)) 'headerComplete'
			return
		end 'headerComplete'

		let tok = self.current()
		throw SourceParseError.strayToken(tokenDisplayText(tok), line: tok.line, column: tok.column)
	end 'requireDeclarationHeaderLineEnd'

	// The optional `implements <Interface>` clause as the TOLERANT DECLARATION SWEEP reads it, on either
	// declaration kind, and as `Queries.foldConformanceClauses` re-reads it whole-program. The real parse
	// reads the same grammar through `readImplementsList`, which is the only reader that can be positioned
	// on a declaration whose ConformanceDecl is filed.
	//
	// A COMMA LIST, matching `parseImplementsClause`'s: `enum E implements Error, Debuggable` names two.
	// A declaration that implements nothing returns the SHARED empty, so the common case allocates nothing.
	//
	// ⭐ **IT ALSO READS THE `with <TypeArgs>` OF EVERY NAME THAT CARRIES ONE** (conditional extensions). The
	// bindings are what a conditional extension's `where` clause is evaluated against
	// (`StructLayout.conformanceBindings`), and they are read through `parseConformanceWithArgs` — the SAME
	// reader the real parse's `parseOneConformance` uses — rather than a second walk of the same grammar.
	//
	// ⭐⭐ **WHERE ONE `with` ENDS IS THE INTERFACE'S `uses` ARITY, SO THE CLAUSE'S EXTENT IS A WHOLE-PROGRAM
	// FACT — AND THAT IS WHY THIS READER STOPS EARLY IN THE SWEEP AND NOWHERE ELSE.** Whether the comma
	// after `with Score` opens a second ARGUMENT or a second INTERFACE is decided by `Score`'s interface's
	// arity, which only the complete index holds. One of this function's three callers runs with that index
	// whole (`Queries.foldConformanceClauses`); the two DECLARATION SWEEP arms do not, because the sweep is
	// what builds it.
	//
	// So the loop asks the fact itself rather than being told which pass it is in: it continues past a `with`
	// exactly when the boundary is UNAMBIGUOUS — the arguments were parenthesized (the `)` ends them whatever
	// the arity is), or the arity RESOLVED. In the sweep no arity resolves, so an unparenthesized `with` ends
	// the clause; a misspelled interface ends it in every pass, which is the same
	// bounded outcome and a program the whole-program `E3015 … implements unknown interface` already names.
	//
	// ⛔ **CONTINUING WITHOUT THE ARITY WOULD TRADE A MISSING CONFORMANCE FOR A WRONG ONE**, which is strictly
	// worse: `implements Pair with A, B` against `interface Pair uses First, Second` would file `B` as an
	// INTERFACE and produce a spurious `E3015 … implements unknown interface 'B'` on a legal program — the
	// same bug in the other direction. The deferral (`ConformanceClauseDeclSite`) exists precisely so the
	// sweep never has to guess.
	//
	// ⚠⚠ **STOPPING EARLY IS ABOUT MEANING, NEVER ABOUT THE CURSOR — the remainder is always CONSUMED
	// (`skipRestOfImplementsClause`).** Leaving it standing is a WRONG ANSWER on an `enum` rather than a
	// missing one: `recordScannedEnum` resumes its CASE walk at whatever token this stops on, so
	// `enum Slow implements Tagged with Code, Error` has its case list read out of the clause's own tail —
	// ⛔ `error E3034: unknown enum case: 'tooSmall'` on a program whose only fault is the ORDER of its
	// clause, where `implements Error, Tagged with Code` compiles and runs. `recordScannedType` escapes it
	// only because a stray identifier at a type's top level is skipped rather than read as a member.
	function readOptionalImplementsClause() returns ScannedConformanceClause throws SourceParseError
		if not self.at(TokenKind.implements) 'noImplements'
			return ScannedConformanceClause.declaringNothing()
		end 'noImplements'

		try self.consume(TokenKind.implements)

		let names = NameRoster.create(0)

		// One entry per NAME, so the two columns pair by index (`StructLayout.conformanceBindings`). Built
		// eagerly rather than on the first `with`: the clause that binds nothing at all is the one that never
		// reaches here, and it takes the shared empty from `declaringNothing` above.
		let bindings = ConformanceBindingArray.create(0)

		while true 'moreInterfaces'
			let nameTok = try self.consumeConformedInterfaceName()
			names.push(nameTok.value)

			if self.at(TokenKind.with) 'bindsAssociatedTypes'
				try self.consume(TokenKind.with)

				// Read BEFORE the arguments, because the reader consumes the `(` that is the answer.
				let delimited = self.at(TokenKind.leftParen)
				let spellings = NameRoster.create(0)
				let types = RequirementTypeArray.create(0)
				_ = try self.parseConformanceWithArgs(nameTok.value, spellings: spellings, types: types, owner: ConformanceOwner.unchecked)
				bindings.push(ConformanceBinding.create(spellings, types: types))

				if not delimited and not self.conformanceArityResolves(nameTok.value) 'theArityIsNotKnownYet'
					self.skipRestOfImplementsClause()
					break
				end 'theArityIsNotKnownYet'
			end 'bindsAssociatedTypes' else 'bindsNothing'
				bindings.push(ConformanceBinding.none())
			end 'bindsNothing'

			if not self.at(TokenKind.comma) 'lastInterface'
				break
			end 'lastInterface'

			try self.consume(TokenKind.comma)
		end 'moreInterfaces'

		return ScannedConformanceClause.create(names, bindings: bindings)
	end 'readOptionalImplementsClause'

	// ⭐⭐ **CONSUME THE CLAUSE ITEMS THE READER ABOVE COULD NOT INTERPRET — the half of "stop here" that is
	// about the CURSOR.** Every caller resumes at whatever token the clause read leaves, and one of them
	// (`recordScannedEnum`) reads the next token as a CASE, so a clause tail left standing becomes part of the
	// declaration. See the header above for the measured `E3034`.
	//
	// ⭐ **IT IS EXACT WITHOUT THE ARITY, WHICH IS THE WHOLE REASON A SKIP CAN GO WHERE A READ CANNOT.** The
	// two readings of `… with A, B` disagree about what `B` MEANS — a second argument or a second interface —
	// and agree exactly on the TOKENS it occupies: a comma, then a name, then an optional `with` and its
	// arguments. So this walks that shape and cannot be wrong either way.
	//
	// ⚠ **IT ADVANCES ONLY WHILE IT IS ON A COMMA**, which is what keeps it out of the declaration's body: a
	// case written on the header's own line (`enum E implements A with X  red green end`) follows no comma, so
	// the walk stops on `red` and the case walk reads it, exactly as it would after a fully interpreted clause.
	function skipRestOfImplementsClause()
		while self.at(TokenKind.comma) 'anotherClauseItem'
			self.advance()

			if not self.at(TokenKind.identifier) 'namesNothing'
				return
			end 'namesNothing'

			self.advance()
			self.skipQualifierSegments()

			if not self.at(TokenKind.with) 'bindsNothing'
				continue
			end 'bindsNothing'

			self.advance()
			self.skipOneConformanceArgument()
		end 'anotherClauseItem'
	end 'skipRestOfImplementsClause'

	// The ONE argument that follows a `with` in the skip above — a parenthesized group, or a leaf type
	// reference and its dotted chain. A FURTHER argument, if the interface takes one, arrives as the comma the
	// caller's loop is already written around, so the two spellings of a multi-argument `with` need no
	// distinction here either.
	function skipOneConformanceArgument()
		if self.skipBalancedParens() 'delimited'
			return
		end 'delimited'

		self.advance()
		self.skipQualifierSegments()
	end 'skipOneConformanceArgument'

	function skipQualifierSegments()
		while self.at(TokenKind.dot) and self.peekKind() == TokenKind.identifier 'dottedChain'
			self.advance()
			self.advance()
		end 'dottedChain'
	end 'skipQualifierSegments'

	function consumeConformedInterfaceName() returns Token throws SourceParseError
		if self.dottedChainLengthAt(self.pos) > 0 'aQualifiedName'
			return try self.consumeQualifiedTypeName()
		end 'aQualifiedName'

		let headIndex = self.pos
		let headTok = try self.consume(TokenKind.identifier)
		try self.requireNameableTypeNameAt(headIndex, written: headTok.value, anchor: headTok)

		return headTok
	end 'consumeConformedInterfaceName'

	function consumeQualifiedTypeName() returns Token throws SourceParseError
		let headIndex = self.pos
		let headTok = try self.consume(TokenKind.identifier)
		let qualifierDots = self.dottedChainLengthAt(headIndex)
		let written = self.assembleDottedChainAt(headIndex, dots: qualifierDots)
		let chain = try self.resolvedTypeChainAt(headIndex, anchor: headTok, use: ChainUse.typeReference)
		var lastEnd = headTok.endByte

		for _ in 0 upto qualifierDots 'eachSegment'
			try self.consume(TokenKind.dot)
			lastEnd = self.current().endByte
			self.advance()
		end 'eachSegment'

		return Token.create(TokenKind.identifier, line: headTok.line, column: headTok.column, value: chain.denotedName(written), startByte: headTok.startByte, endByte: lastEnd)
	end 'consumeQualifiedTypeName'

	// Does the program state `interfaceName`'s `uses` arity YET? — the one question that decides whether an
	// unparenthesized `with` has a knowable end (see `readOptionalImplementsClause`). It is the ARITY DOOR's
	// own union read for its other half: `interfaceUsesArity` wants the number and substitutes a default when
	// there is none, while this wants to know whether there IS one, and folding the two would hide the
	// default's presence behind a count that looks like an answer.
	function conformanceArityResolves(interfaceName ByteArray) returns bool
		match self.conformanceUsesArity(interfaceName) 'arity'
			declared then return true
			unresolvable then return false
		end 'arity'
	end 'conformanceArityResolves'

	// A type reference: a bare identifier (a named type like `ExitCode`,
	// interned into the artifact's local interner) or a bare primitive keyword.
	// Ranged, generic and qualified forms are read by the arms below.
	//
	// ⭐ **`Self` — AND THE ENCLOSING TYPE'S OWN NAME — RESOLVE TO THE ENCLOSING DECLARATION'S OWN TYPE
	// HERE, SYNTACTICALLY** (`enclosingSelfType`: a `structRef` inside a `type`, a `named` inside an
	// `enum`/`union`). Every other identifier stays `named` and is resolved later, by `TypeResolution`
	// against the project registry. The asymmetry is not a shortcut, it is the only thing that WORKS:
	//
	//   • **This routine runs in BOTH passes.** The tolerant declaration sweep reads a signature
	//     through it (`recordScannedSignature`) while the whole-program index is still being BUILT,
	//     so it cannot ask "is `Point` a declared type?" — the answer depends on how far the sweep
	//     has got, which would make a declaration's recorded return type depend on its POSITION.
	//   • **`Self` needs no index.** It means the type whose body encloses it, which is a fact about
	//     the TOKENS, so both passes answer it identically and neither has to look anything up.
	//
	// So `static function create(…) returns Self` is `structRef(Point)` in the sweep and in the
	// parse, and a call's result is typed exactly (`mintCallResult` reads the sweep). That is what
	// `let p = Point.create(3, y: 4)` needs to know `p` is a Point at all.
	function readTypeReference(voice BarePrimitiveVoice) returns MaxonType throws SourceParseError
		// A TUPLE TYPE — `(Integer, Integer)`. Asked first because `(` opens nothing else in a type
		// position: the one other parenthesized type form, `function(…)`, is introduced by its own keyword and
		// is read by `readFunctionTypeAlias` before this is ever reached.
		if self.at(TokenKind.leftParen) 'tupleType'
			return try self.parseTupleTypeReference(voice)
		end 'tupleType'

		if self.at(TokenKind.selfType) 'selfType'
			let tok = try self.consume(TokenKind.selfType)
			return try self.enclosingSelfType(tok)
		end 'selfType'

		if self.at(TokenKind.identifier) 'named'
			return try self.readNamedTypeReference(self.dottedChainLengthAt(self.pos))
		end 'named'

		// ⭐⭐ **THE RANGED-TYPEALIAS RULE'S ONE DOOR.** `int` and `float` name a DOMAIN and no RANGE, and every
		// reader the compiler has asks a ranged alias for its bounds — so outside the positions `voice` admits, the
		// keyword must travel through a named alias. `docs/LANGUAGE_REFERENCE.md:438` has said so since long
		// before the compiler enforced it, and the oracle has enforced it at every type position all along; The compiler
		// checked only ONE position (a generic type argument, E2061) and let the keyword through everywhere
		// else. `stdlib/` — compiled BY the oracle — has zero violations; `specs`, authored against the
		// unenforced compiler, had ~1200.
		//
		// **ONE ARM FOR BOTH SPELLINGS**, where this replaced two: the set is then written once and no later
		// edit can give the guard to `int` and not to `float`.
		//
		// ⚠ **`bool` AND `cstring` KEEP THEIR OWN ARMS BELOW, AND THAT SEPARATION IS WHAT SAYS THE RULE DOES
		// NOT REACH THEM.** `bool` is already a constrained type with nothing to range. `cstring` mints
		// `MaxonType.integer` — the same tag a bare `int` does — so this rule can only ever be asked of the
		// TOKEN; see `keywordIsARangedPrimitive`'s header for what a tag-side spelling would cost.
		if keywordIsARangedPrimitive(self.current()) 'aBareRangedPrimitive'
			let tok = self.current()
			try requireNotABarePrimitive(tok, voice: voice)
			self.advance()

			return MaxonType.float if tok.kind == TokenKind.float else MaxonType.integer
		end 'aBareRangedPrimitive'

		if self.at(TokenKind.bool) 'primBool'
			try self.consume(TokenKind.bool)
			return MaxonType.boolean
		end 'primBool'

		// ⭐⭐ **`cstring` — A NUL-TERMINATED BYTE POINTER, AND A TYPE OF ITS OWN.** The Lexer carries the
		// keyword (its help text tells an author to *"produce one with `String.cstr()` or
		// `__ManagedMemory.toCString()`"*), and those two doors plus a `__Builtins.*` parameter that
		// immediately `strlen`s one are the whole of where it appears.
		//
		// ⚠ **IT DOES NOT RESOLVE TO `integer`.** A `cstring` IS a raw address — no length, no capacity,
		// no ownership — and the compiler types every other such address `integer`, which costs nothing
		// until a pair like `__Builtins.subprocessResolveOnPath(path cstring)` and
		// `__Builtins.subprocessGetPid(pid i64)` (`stdlib/Subprocess.maxon`) is within reach of user code. Erased, each accepts the
		// other's argument: `subprocessResolveOnPath(42)` and `subprocessGetPid(s.cstr())` both compile
		// clean.
		//
		// ⇒ It is a `ValueTypeTag`, and its whole cost is one arm per exhaustive match — every one of
		// which the compiler demanded by name. Its WIDTH is unchanged (`valueTagToStdType` gives the machine
		// word every pointer gets); what the tag buys is the TYPE RULE, which no width can express.
		if self.at(TokenKind.cstring) 'cstringPointer'
			try self.requireCStringTypeIsLibraryTier(self.current())
			try self.consume(TokenKind.cstring)
			return MaxonType.cstring
		end 'cstringPointer'

		throw notATypeError(self.current())
	end 'readTypeReference'

	function qualifiedTypeReference(declaration ChainType, consumed ElementIndex, headIndex ElementIndex, qualifierDots ElementIndex, anchor Token) returns MaxonType throws SourceParseError
		if consumed != qualifierDots 'aMemberTypeOfTheDeclaredType'
			self.recordTypeNameUse(declaration.written)
			return try self.memberTypeReference(self.ownedMemberSpelling(declaration.name, headIndex: headIndex, consumed: consumed, qualifierDots: qualifierDots), anchor: anchor)
		end 'aMemberTypeOfTheDeclaredType'

		if isTypeAliasDecl(declaration.kind) and not self.signatures.allFilesFolded 'anAliasWhoseIdentityTheFoldSettles'
			return try self.memberTypeReference(declaration.written, anchor: anchor)
		end 'anAliasWhoseIdentityTheFoldSettles'

		if isTypeAliasDecl(declaration.kind) 'anAliasReference'
			self.recordQualifiedTypeNameUse(declaration.written)
			try self.requireInnerAliasNameable(declaration.written, written: declaration.written, anchor: anchor)
		end 'anAliasReference' else 'aNominalReference'
			self.recordTypeNameUse(declaration.written)
		end 'aNominalReference'

		return self.namespaceQualifiedType(declaration.kind, declFilePath: declaration.declFilePath, name: declaration.name)
	end 'qualifiedTypeReference'

	function ownedMemberSpelling(owner immutable ByteArray, headIndex ElementIndex, consumed ElementIndex, qualifierDots ElementIndex) returns immutable ByteArray
		var spelled = owner

		for segment in consumed + 1 upto qualifierDots + 1 'eachMemberSegment'
			spelled = joinQualifiedName(spelled, member: chainMemberAt(self.tokens, at: headIndex, segment: segment))
		end 'eachMemberSegment'

		return spelled
	end 'ownedMemberSpelling'

	function memberTypeReference(qualified ByteArray, anchor Token) returns MaxonType throws SourceParseError
		self.recordQualifiedTypeNameUse(qualified)
		try self.requireInnerAliasNameable(qualified, written: qualified, anchor: anchor)

		if self.signatures.allFilesFolded and self.signatures.isGenericAliasInAnyFile(qualified) 'aQualifiedInnerGenericAlias'
			return self.genericAliasDenotedType(qualified, readerFilePath: self.job.path)
		end 'aQualifiedInnerGenericAlias'

		return MaxonType.named(self.artifact.typeNames.intern(qualified))
	end 'memberTypeReference'

	function readNamedTypeReference(qualifierDots ElementIndex) returns MaxonType throws SourceParseError
		// The head's INDEX, taken before the cursor moves: the dotted-chain walk below is indexed from
		// the head, exactly as the CALL door's is, so both ask `dottedChainLengthAt` the same question
		// about the same token.
		let headIndex = self.pos
		let tok = try self.consume(TokenKind.identifier)

		// ⭐⭐ **AN INTERFACE EXTENSION'S ASSOCIATED TYPE IS THE CONFORMER'S BINDING FOR IT (conditional
		// extensions).** `extension HasItems where Element is Equatable` writing `function has(target
		// Element)` is parsed once per conformer, and `IntList implements HasItems with Integer` binds
		// `Element` to `Integer` — so what the body means by `Element` is the binding's stored type, resolved
		// in the file the binding was written in.
		//
		// ⚠⚠ **IT IS *NOT* AN ENTRY IN `enclosingTypeParams`, AND THE DIFFERENCE IS A SILENT WRONG TYPE.**
		// Installing the interface's associated names as type parameters would make `Element` resolve to
		// `typeParameter(0)` — position 0 of the CONFORMER's own `uses` list, a different type entirely, and
		// one nothing downstream would question. The binding keeps an alias a ranged alias and a struct a
		// struct.
		//
		// ⚠ **BARE NAMES ONLY.** A dotted chain's head is a namespace or an instance
		// (`lib.fmt.Score`, `StrWrapper.Idx`), never an associated type, and rewriting one would retarget a
		// qualified reference at a name that has nothing to do with it. A TYPE extension installs no
		// bindings at all (its parameters are per-instantiation, and `enclosingTypeParams` is the right
		// mechanism there) — see `openExtensionBodyScope`.
		if qualifierDots == 0 and self.genericBindings.names.count() != 0 'insideAGenericInstance'
			match self.genericBoundType(tok.value) 'binding'
				resolved(bound) then return bound
				byName then break
			end 'binding'
		end 'insideAGenericInstance'

		if qualifierDots == 0 'anUnqualifiedName'
			if let bound = try self.extensionAssociatedType(tok.value) 'anAssociatedName'
				return bound
			end 'anAssociatedName'
		end 'anUnqualifiedName'

		let name = tok.value if qualifierDots > 0 else self.genericBoundTypeName(tok.value)

		// Recorded HERE, above every arm, rather than in the arm that finally decides what the name
		// denotes: a name written in a type position is a USE whichever way it resolves, and hooking
		// the arms instead would need one hook per arm and would silently miss the next one added.
		// It records the SUBSTITUTED name, because that is the declaration a use of `Element` keeps alive.
		self.recordTypeNameUse(name)

		if qualifierDots == 0 'unqualifiedSpelling'
			try self.requireTypeSpellingIsNotRawBuffer(tok)
		end 'unqualifiedSpelling'

		// ⭐ A QUALIFIED PER-INSTANCE ALIAS REFERENCE — `StrWrapper.Idx` in a type position. An
		// identifier followed by `.` and another identifier is `Instance.Member`, the ONE dotted type form,
		// so this peek precedes every bare-identifier arm below (the `.` is what tells a qualified reference
		// from a plain one). It resolves to `named(join)` in BOTH passes — the SHAPE is enough, needing no
		// registry, so the tolerant sweep and the real parse answer identically while the index is still
		// building. TypeResolution erases a registered per-instance `X.Y` to `integer` (keeping the nominal
		// name in the value column) and reports an unregistered one as E3011.
		//
		// ⭐⭐ **THE WALK IS GREEDY AND CONSUMES EVERY `.identifier` PAIR, which is what admits a
		// MULTI-SEGMENT NAMESPACE — `lib.fmt.Score`.** It stays purely SYNTACTIC, asking no registry, so
		// the tolerant sweep and the real parse still answer identically; `TypeResolution` decides what the
		// assembled name denotes (a per-instance `X.Y`, a directory-qualified alias, or E3011).
		//
		// ⚠ **GREEDY CANNOT CHANGE A PROGRAM THAT ALREADY COMPILED**, and that is why no lookahead gate is
		// needed: the one-dot version already consumed a dot unconditionally, so the only inputs this
		// touches are chains of THREE or more segments — and every one of those was already a parse that
		// minted `named("a.b")` and then met a dangling `.c` with no rule for it. There is no type position
		// in the grammar where a type reference may legally be followed by `.<name>`: an `as` cast is
		// not a postfix operator here (`parseCast` ends at its target), and a return clause, a
		// parameter, a field and a generic argument are each closed by their own follower.
		//
		// ⭐⭐ **IT IS THE *SAME* WALK THE CALL DOOR USES — ONE `dottedChainLengthAt`, ONE
		// `assembleDottedChainAt`, NOT TWO.** A hand-rolled loop here would demand
		// `TokenKind.identifier` of every segment while the call walk asks `tokenCanBeAName`, and the two
		// would spell the same rule differently with nothing to make them agree. ⛔ MEASURED on the divergence:
		// with a module directory `lib/from/`, `lib.from.helper()` COMPILED AND RAN while
		// `21 as lib.from.Score` was refused `E3011: Unknown type 'lib'` — a wrong REJECTION quoting a
		// fragment of the name, for a declaration `pushNamespaceQualifiedAlias` had filed under exactly the
		// key the author wrote. A directory name is a FILESYSTEM name and owes the lexer nothing, so the
		// segments of a namespace are `tokenCanBeAName`'s question in BOTH positions or the mirror is
		// reachable from one of them only. Pinned by
		// `namespace-qualified-resolution/keyword-named-directory-segment-resolves-in-both-positions`.
		if qualifierDots > 0 'qualifiedMember'
			let qualified = self.assembleDottedChainAt(headIndex, dots: qualifierDots)
			try self.requireAliasIsNotRawBuffer(qualified, written: qualified, anchor: tok)

			// Stops PAST the final segment, unlike `parseNamespaceQualifiedCall`'s twin loop: nothing
			// downstream of a type reference consumes that token, where a call hands it to `parseCallNamed`.
			// `advance` and not `consume(identifier)` — a segment may be a keyword standing as a name,
			// which is the whole point of sharing the walk above.
			for _ in 0 upto qualifierDots 'eachSegment'
				try self.consume(TokenKind.dot)
				self.advance()
			end 'eachSegment'

			let chain = try self.resolvedTypeChainAt(headIndex, anchor: tok, use: ChainUse.typeOrMemberType)

			match chain 'chain'
				declared(declaration, consumed) then return try self.qualifiedTypeReference(declaration, consumed: consumed, headIndex: headIndex, qualifierDots: qualifierDots, anchor: tok)
				notQualified then return try self.memberTypeReference(qualified, anchor: tok)
			end 'chain'
		end 'qualifiedMember'

		// The `String` and `Character` BUILTINS — recognized SYNTACTICALLY, like `Self` below, so they
		// need no registry and both the declaration sweep and the real parse answer them identically.
		// Each resolves to its OWN `MaxonType` arm (`string` / `character`, NEVER `named`), which is what
		// tags a `String`/`Character` parameter's value at parse time and keeps every `named`-reading rule
		// from treating a record pointer as a ranged int.
		//
		// ⭐ The two names are ONE TABLE (`byteRecordTagOfTypeName`) rather than an arm each, because
		// `enclosingSelfType` must reach the SAME answer for the SAME name — see
		// there, and see the table for the 25 wrong rejections a disagreement costs.
		let byteRecord = byteRecordTagOfTypeName(name)

		if byteRecord != ValueTypeTag.unresolved 'builtinByteRecord'
			return maxonTypeOfTag(byteRecord, nameId: UnnamedTypeId)
		end 'builtinByteRecord'

		// ⭐⭐ **THE BARE `CharacterSet` NAME FALLS THROUGH TO THE ORDINARY STRUCT REGISTRY, BECAUSE
		// `stdlib/CharacterSet.maxon` IS WHAT PUTS IT THERE.** No arm here answers
		// `structRef(__CharacterSet)`, the reserved spelling the compiler registered its own layout under:
		// two layouts under two keys is the hazard. An arm that did would resolve every
		// `chars CharacterSet` parameter in `stdlib/String.maxon` to `__CharacterSet` while
		// the corpus statics returned the declared `CharacterSet`, which is **`E3005 expected
		// 'CharacterSet', got '__CharacterSet'`** on `"  x  ".trim()`.
		// The type's own name inside its own body means what `Self` means — for an `enum Toggle`'s
		// `function flip() returns Toggle` exactly as for a `type Point`'s `returns Point`. Both
		// spellings are legal Maxon and they must not resolve differently, because a struct's own name
		// left `named` would type `create`'s result as an integer and `p.x` would fail against the very
		// type that declared it.
		if self.namesEnclosingType(name) 'ownName'
			return try self.enclosingSelfType(tok)
		end 'ownName'

		// A GENERIC TYPE PARAMETER — a bare `T` inside `type Box uses T`. Recognized by NAME
		// against the enclosing type's `uses` list, so the tolerant sweep and the real parse answer it
		// identically without a registry (like `Self`). It resolves to an opaque i64 — NEVER `named`, for
		// the reason `structRef`/`string`/`function` are their own arms: the rules that read `named` treat
		// it as a ranged int, and a `T` is neither numeric nor a declared type. There is no shadowing
		// question here: a type param name equal to a declared type name is not in the corpus,
		// and the param wins here (it is the innermost scope).
		//
		// ⭐⭐ **THE IDENTITY IS `(THIS DECLARATION, THIS NAME)` AND NOT THE POSITION.** A position
		// made `HoldA`'s first parameter and `HoldB`'s the same value, so `Array with U` and `Array with V`
		// interned as one instance — see `ProgramSignatures.typeParamTokenFor` for the measured wrong
		// answer that produced. **`self.enclosingType` IS the owner at all three of the doors that install
		// a parameter scope**, and that is a property of the doors rather than an assumption here: a
		// `type`'s own body (`openTypeParamScope`) and an `interface`'s (`readInterfaceDeclaration`) are
		// each inside the declaration that names the parameters, and a TYPE EXTENSION's body
		// (`openTypeExtensionBodyScope`) installs the TARGET's list under `enterTypeScope(conformer)` —
		// where the conformer of a `typeExtension` IS the extended type (`extensionTargetOf` builds the
		// conformer list as the target alone), which is exactly what makes an extension's `T` the same `T`
		// as the type's own. An INTERFACE extension's body (`openExtensionBodyScope`) is the fourth door
		// and it installs the CONFORMER's list under `enterTypeScope(conformer)` — never the interface's
		// associated names, which reach a body as the conformer's binding (`extensionAssociatedType`).
		//
		// ⚠ The digest is a pure function of the two names, so the tolerant sweep and the real parse
		// compute the SAME token with no registry between them — which is the property this arm's
		// "without a registry" sentence rests on and which an intern-order id would break.
		if self.enclosingTypeParams.contains(name) 'typeParam'
			return MaxonType.typeParameter(typeParamTokenFor(self.enclosingTypeName(), paramName: name))
		end 'typeParam'

		// A BARE INNER ALIAS — `Idx` OR `ElementArray` inside `type Wrapper`.
		// Recognized by NAME against `enclosingInnerAliases` (populated while THIS type's body is parsed, so
		// the sweep and the real parse agree without the whole-program registries, which the sweep has not
		// folded yet). It resolves under its BASE-QUALIFIED name (`Wrapper.Idx`), NEVER the bare member (which
		// collides with a same-named inner alias of another generic type). Two shapes: a GENERIC-INSTANCE
		// inner alias (`ElementArray = Array with T`) resolves to `genericInstance(gid)` in the REAL parse
		// (the index is complete), the read-side twin of the top-level generic-alias arm below — so the field
		// type is a genericInstance TypeResolution leaves concrete, not a `named` it would reject as E3011. A
		// RANGED inner alias stays `named("Wrapper.Idx")` (TypeResolution erases it to `integer`, and the
		// method-return retype re-qualifies it at the call site). During the SWEEP both stay `named`, on the
		// `allFilesFolded` gate the block below argues for — and the sweep's field type is re-tagged at
		// every read. ⚠ Here the gate is a RESTATEMENT rather than a change: an inner alias is folded with
		// its enclosing type at `foldFile`, i.e. when the file it is DECLARED IN ends, and this arm only
		// fires inside that same type's body — so the registry already answered no throughout the sweep of
		// every WELL-FORMED program. What the gate removes is the one way it could have answered yes: a
		// SECOND file declaring a type of the same name, which the tolerant sweep folds without complaint
		// and the real parse rejects later.
		if self.namesInnerAliasHere(name) 'innerAlias'
			let qualifiedInner = self.innerAliasKey(name)
			try self.requireAliasIsNotRawBuffer(qualifiedInner, written: tok.value, anchor: tok)

			if name.equals(tok.value) and not self.namesAnEnclosingInnerAlias(name) 'aMemberAnotherBodyDeclaredAndTheAuthorWrote'
				try self.requireInnerAliasNameable(qualifiedInner, written: name, anchor: tok)
			end 'aMemberAnotherBodyDeclaredAndTheAuthorWrote'

			if self.signatures.allFilesFolded and self.signatures.isGenericAliasInAnyFile(qualifiedInner) 'genericInnerAlias'
				return self.genericAliasDenotedType(qualifiedInner, readerFilePath: self.job.path)
			end 'genericInnerAlias'

			// A TUPLE inner alias — `Entry` inside `type Map uses Key, Value`. It resolves STRAIGHT
			// THROUGH to the interned tuple's own `structRef`, which is what makes an `Entry`-typed slot and a
			// `(Key, Value)`-typed one one type. UNGATED by `allFilesFolded` because `recordTupleAlias` writes
			// DURING the walk: the resolved answer is the common case here and the bare `named` the rare one.
			if self.signatures.isTupleAliasInAnyFile(qualifiedInner) 'tupleInnerAlias'
				return self.signatures.tupleAliasDenotedType(qualifiedInner, readerFilePath: self.job.path, into: self.artifact.typeNames)
			end 'tupleInnerAlias'

			return MaxonType.named(self.artifact.typeNames.intern(qualifiedInner))
		end 'innerAlias'

		// ⭐⭐ **THE PER-FILE ALIAS REGISTRIES ARE READ IN THE REAL PARSE ONLY, AND `allFilesFolded` IS WHAT
		// MAKES THAT TRUE RATHER THAN MERELY CLAIMED.** Both arms below ask a registry the declaration
		// SWEEP is still filling, and the sweep reaches both: `foldDeclaredSignaturesInto` parses no BODY,
		// but it reads declared TYPES — a struct field, a return clause, a generic alias's arguments —
		// through this very routine, holding the `ProgramSignatures` it is filling (`Queries.foldOneFileInto`).
		//
		// ⚠ **UNGATED, THE ANSWER WOULD BE A PROPERTY OF THE DISK, NOT OF THE PROGRAM.** Both registries
		// are written by `foldFile`, which runs when a file's whole token walk ENDS — so an alias declared
		// in the file being swept reads as undeclared, but one declared in a file the walk reached EARLIER
		// is already registered. The walk's order is the filesystem's and the loader deliberately does not
		// sort it (`StdlibLoader`'s header).
		//
		// ⇒ Gated, the sweep answers from the TOKENS ALONE and records the same bare `named` whatever the
		// walk's order. A swept `named` is exactly what the READ doors exist to repair
		// (`ProgramSignatures.declaredSlotType` for a field / array element / tuple element,
		// `resolveNamedAlias` for a call result), and they are the only route that repairs it.
		//
		// ⚠ **THE TUPLE-ALIAS ARM BELOW IS DELIBERATELY OUTSIDE THIS GATE — the asymmetry is in WHEN the
		// registry is written.** `recordTupleAlias` writes DURING the walk, not at
		// `foldFile`, so for a tuple alias the sweep's RESOLVED answer is the common case and the bare
		// `named` is the rare cross-file one. Gating it would move every `Array with <a tuple alias>` onto
		// that rare spelling, and a generic instance's stored ARGUMENT is read RAW by the index doors
		// (element size, mangled name, canonical name, owned-ness, the instantiation-kind gates), so gating
		// it changes the emitted element size in `tuples/value-tuple-escaping-into-array-stays-heap` and
		// the answer of `tuples/array-of-managed-element-tuples-drops-each`. Its cross-file order dependence
		// is real and is fixed at the READ doors instead; see `ProgramSignatures.declaredSlotType`.
		//
		// ⚠ Every OTHER reader of these registries runs in the real parse only — a call base, a cast
		// target, an instantiation check — so it needs no gate; a gate there would assert something that
		// cannot be false.
		// ⭐⭐ **AMBIGUITY IS DECIDED BEFORE THE FORM ARMS.** Two files may export one name in two FORMS
		// (`typeNamePairMayCoexist`), and the function-alias arm below would CLAIM such a name and return —
		// so `50 as Score`, with a ranged `api.Score` and a function `legacy.Score` both in scope, would be
		// **E3009 `Cannot cast from int to function`** instead of the E3063 that names both candidates. The
		// question is "could this reference mean more than one declaration", which is prior to what any one
		// of them denotes.
		if self.scannedFunctionAliases.holds(name) 'sweptBodyFunctionAlias'
			return MaxonType.named(self.artifact.typeNames.intern(self.innerAliasKey(name)))
		end 'sweptBodyFunctionAlias'

		if self.namesThisBodysNestedFunctionAlias(name) 'thisBodysOwnFunctionAlias'
			return self.functionAliasType(self.innerAliasKey(name), readerFilePath: self.job.path)
		end 'thisBodysOwnFunctionAlias'

		try self.requireUnambiguousTypeName(name, anchor: tok)
		let identity = self.signatures.bareWrittenKey(name, readerFilePath: self.job.path)

		// ⭐⭐ **AN `interface` NAME IN A TYPE POSITION IS AN EXISTENTIAL** —
		// `function useIt(b Backend)`, `let t as Tagged`, `returns Producer`. It resolves to
		// `interfaceRef`, the fat pointer, and NOT to the bare `named` the fallthrough would give: a
		// `named` reads as a ranged INT everywhere the type rules ask (`TypeRules.typeClassOf`'s stated
		// theorem), which is what would make an interface-typed field *"cannot assign 'struct' to variable 'b'
		// of type 'int'"*.
		//
		// ⚠ **GATED ON `allFilesFolded` FOR THE BLOCK BELOW'S REASON, AND WITH A SHARPER EDGE OF ITS OWN.**
		// `foldInterfaceDeclarations` runs at the very END of `queryProgramSignatures` — after the flag is
		// set — so during the declaration SWEEP this registry is not merely incomplete, it is EMPTY. A
		// swept annotation is therefore always a bare `named`, whatever the file order, which is exactly
		// the order-independence the block below argues for; `normalizeSweptInterfaceTypes` is the READ-door
		// repair that turns those back into `interfaceRef` once the registry is whole, the same
		// arrangement `declaredSlotType`'s re-tags live under.
		//
		// ⚠ It cannot answer differently for the ONE parse that runs while the registry is still filling —
		// `readInterfaceDeclaration` itself, re-seeking each `interface` site — because an interface
		// method's types are stored as RENDERED SOURCE STRINGS and `maxonTypeName` spells `named(id)` and
		// `interfaceRef(id)` identically. A requirement's rendered signature is therefore the same bytes
		// whichever arm produced it, which is what conformance compares.
		//
		// `lookupInterface` rather than a bare map probe: it is the ONE lookup rule, and it is what puts
		// the SYNTHESIZED protocol interfaces (`Stringable`, `Hashable`, …) on the same footing as the
		// user-declared ones — a `function show(s Stringable)` is an existential exactly as a
		// `function run(b Backend)` is.
		// ⚠ `isInterfaceName`, NOT `lookupInterface`: this runs on EVERY type annotation in the program and
		// only needs the ANSWER, and a union return is heap-boxed even for its `notFound` case — measured
		// at +24,396 allocations in `phase:parse` at the ladder's step 5, doubling per step, on a corpus
		// with no interface in it. See `builtinInterfaceKind`.
		// ⚠ `aliasShadowsNominalFor` for `resolveNamedStruct`'s reason, one registry over: an interface name
		// is whole-program, and a file whose own `typealias Tolerance` coexists with a user
		// `interface Tolerance` means its own.
		if let asInterface = try self.interfaceTypeOfIdentity(identity, readerFilePath: self.job.path) 'wholeProgramInterfaceRegistry'
			return asInterface
		end 'wholeProgramInterfaceRegistry'

		if self.signatures.allFilesFolded 'wholeProgramAliasRegistries'
			// A GENERIC-INSTANCE ALIAS — `IntBox` where `typealias IntBox = Box with Integer`.
			// It resolves to `genericInstance(giid)`, the read-side twin of the function-alias arm below —
			// or, over an `interface` base, to the EXISTENTIAL that instance denotes. `instanceDenotedType`
			// is the one place that split is made; the arm ABOVE is the bare-name half of the same fact.
			// The reader-aware form probes (`isAliasOfFormFor` and `isFunctionAliasFor`) rather than the bare
			// ones: two files may declare one name in two alias FORMS, and each means its own. The QUALIFIED
			// spellings above and inside the function arm stay bare, and that is structural rather than an
			// omission — a nominal type name is an identifier and holds no `.`, so `Wrapper.Idx` can be
			// claimed by no second kind and can never be contested.
			if self.signatures.isAliasOfFormFor(identity, readerFilePath: self.job.path, wanted: FormAliasKind.generic) 'genericAlias'
				return self.genericAliasDenotedType(identity, readerFilePath: self.job.path)
			end 'genericAlias'

			// A FUNCTION typealias name resolves to a `function` type, NEVER a `named` one — so
			// a param/field/return declared with a function alias carries the `function` tag, which is what
			// makes a function value assignable to it and an indirect call reach it.
			if self.signatures.isFunctionAliasFor(identity, readerFilePath: self.job.path) 'functionAlias'
				return self.functionAliasType(identity, readerFilePath: self.job.path)
			end 'functionAlias'
		end 'wholeProgramAliasRegistries'

		// A TUPLE typealias — `Pair` where `typealias Pair = (Num, Num)`. It resolves STRAIGHT
		// THROUGH to the tuple's own `structRef`, minting no identity of its own, which is what makes a
		// `Pair`-typed slot and a `(Num, Num)`-typed one the same type. `tupleAliasTargetFrom`
		// canonicalizes, so a target the SWEEP registered under the source spelling answers under the
		// canonical one.
		if self.signatures.isAliasOfFormFor(identity, readerFilePath: self.job.path, wanted: FormAliasKind.tuple) and self.tupleAliasMeaningIsSettled(identity) 'tupleAlias'
			return self.signatures.tupleAliasDenotedType(identity, readerFilePath: self.job.path, into: self.artifact.typeNames)
		end 'tupleAlias'

		// ⭐⭐ **A BARE GENERIC TYPE NAME INSIDE A TYPE-PARAMETER SCOPE IS THAT TYPE AT THIS SCOPE'S
		// PARAMETERS** — `returns Inner` inside `type Outer uses T` is `Inner with Outer.T`, and
		// `WithIterIterator with Iter, Element` inside an interface extension specialized for a generic
		// conformer reaches this arm at its ARGUMENTS. It sits below every arm that binds a name more
		// tightly — the enclosing type's own name, a type PARAMETER, an inner alias, a generic/function/tuple
		// alias — because each of those is a nearer scope and this one only answers a name none of them
		// claimed. It stays ABOVE the `named` fallthrough because that is the DECLARATION view (a type whose
		// parameters nothing bound), which is precisely the reading this arm exists to replace.
		//
		// The `count()` gate is `bareGenericInstanceInScope`'s cost obligation, stated at that door: every
		// type annotation in the program passes this line, and outside a generic body there is no scope for
		// the question to have an answer in.
		if self.enclosingTypeParams.count() != 0 'insideATypeParameterScope'
			match self.bareGenericInstanceInScope(name) 'scoped'
				instance(gid) then return MaxonType.genericInstance(gid)
				none then break
			end 'scoped'
		end 'insideATypeParameterScope'

		return MaxonType.named(self.artifact.typeNames.intern(self.signatures.declaredIdentityOfSpelling(identity, declFilePath: self.job.path)))
	end 'readNamedTypeReference'

	// ⭐⭐ **THE ONE DOOR EVERY TYPE A FILE SPELLS COMES THROUGH — a parameter, a return, a field, a payload,
	// a declared local, a cast target, a generic argument, a tuple element.** The runtime tier's managed-type
	// refusal (E3153) is asked HERE and nowhere else for that reason: a rule spelled at the individual
	// declaration sites is a rule that the next declaration form added does not inherit.
	// ⚠ The anchor is an INDEX and not the token: this runs once per type reference in the program, and a
	// Token copy on that path would be paid by every file to serve a rule only `runtime/` can break.
	function parseTypeReference(voice BarePrimitiveVoice) returns MaxonType throws SourceParseError
		if self.paramCapabilityAt(self.pos) != ParamCapability.unmarked 'aCapabilityWithNothingToQualify'
			throw notATypeError(self.current())
		end 'aCapabilityWithNothingToQualify'

		let anchorIndex = self.pos
		let spelled = try self.readTypeReference(voice)
		try self.requireNoManagedTypeInRuntimeSource(spelled, anchorIndex: anchorIndex)

		return spelled
	end 'parseTypeReference'

	function parseMemberHeadTypeReference(qualifierDots ElementIndex) returns MaxonType throws SourceParseError
		let anchorIndex = self.pos
		let spelled = try self.readNamedTypeReference(qualifierDots)
		try self.requireNoManagedTypeInRuntimeSource(spelled, anchorIndex: anchorIndex)

		return spelled
	end 'parseMemberHeadTypeReference'

	// ⭐⭐ **THE RUNTIME TIER'S MANAGED REFUSAL AT A SPELLED TYPE — the half that no VALUE can answer.**
	// A `type` declared in `runtime/` with a `String` field, and a runtime function whose return type is
	// managed, both put a refcounted value into the tier that DEFINES `__mm_incref`/`__mm_decref`; neither
	// binds a name, so `requireNoManagedValueInRuntimeSource` never sees them.
	//
	// ⚠ **ASKED ONLY ON THE REPORTING WALK.** The declaration sweep reads the same types through the same
	// door and absorbs a throw with `try … otherwise return`, which would drop the declaration instead of
	// naming the fault — and it reads them while the whole-program index is still being built, so its answer
	// to "is this name managed?" would depend on how far the sweep had got.
	function requireNoManagedTypeInRuntimeSource(spelled MaxonType, anchorIndex ElementIndex) throws SourceParseError
		if not self.job.isRuntimeSource or not self.isTheReportingWalk 'nothingToRefuse'
			return
		end 'nothingToRefuse'

		if not self.signatures.typeIsManagedFor(spelled, from: self.artifact.typeNames, readerFilePath: self.job.path) 'ownsNoHeap'
			return
		end 'ownsNoHeap'

		let anchor = self.tokenAt(anchorIndex)
		throw SourceParseError.managedTypeInRuntimeSource(maxonTypeName(spelled, typeNames: self.artifact.typeNames), line: anchor.line, column: anchor.column)
	end 'requireNoManagedTypeInRuntimeSource'

	function rawSurfaceIsRefusedHere() returns bool
		return (self.isTheReportingWalk or self.job.initializerRole != InitializerRole.ordinary) and tierRefusesTheRawSurface(self.job.livesUnderStdlibDirectory, isRuntimeSource: self.job.isRuntimeSource)
	end 'rawSurfaceIsRefusedHere'

	function rawSurfaceRefusal(door RawSurfaceDoor, anchor Token) returns SourceParseError
		return SourceParseError.rawSurfaceOutsideLibraryTier(door, line: anchor.line, column: anchor.column)
	end 'rawSurfaceRefusal'

	function requireCalleeIsNotRawSurface(callee immutable ByteArray, anchor Token) throws SourceParseError
		if not self.rawSurfaceIsRefusedHere() 'libraryTier'
			return
		end 'libraryTier'

		if isBuiltinsIntrinsicCallee(callee) 'aRawIntrinsic'
			let member = freeze try callee.slice(BuiltinsQualifierPrefix.count(), endIndex: callee.count()) otherwise panic("requireCalleeIsNotRawSurface: '{String.from(callee)}' starts with the {BuiltinsQualifierPrefix.count()}-byte prefix, so it is not shorter than it")
			throw self.rawSurfaceRefusal(RawSurfaceDoor.builtinsCall(member), anchor: anchor)
		end 'aRawIntrinsic'

		if callee.equals(StringCStrMethodName) 'theCStringView'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.cstringView, anchor: anchor)
		end 'theCStringView'
	end 'requireCalleeIsNotRawSurface'

	function requireTypeSpellingIsNotRawBuffer(spelledAt Token) throws SourceParseError
		if not self.rawSurfaceIsRefusedHere() 'libraryTier'
			return
		end 'libraryTier'

		if spelledAt.value.equals(ManagedMemoryCursorBuiltinBaseName) 'theCursorType'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.cursorType(spelledAt.value), anchor: spelledAt)
		end 'theCursorType'

		if spelledAt.value.equals(ManagedMemoryTypeName) 'theBufferType'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.bufferType(spelledAt.value), anchor: spelledAt)
		end 'theBufferType'

		if isRawHandleName(spelledAt.value) 'anOsHandleType'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.handleType(spelledAt.value), anchor: spelledAt)
		end 'anOsHandleType'
	end 'requireTypeSpellingIsNotRawBuffer'

	function requireAliasIsNotRawBuffer(key ByteArray, written ByteArray, anchor Token) throws SourceParseError
		if not self.rawSurfaceIsRefusedHere() 'nothingToAsk'
			return
		end 'nothingToAsk'

		if not self.signatures.allFilesFolded 'indexStillBuilding'
			panic("requireAliasIsNotRawBuffer: asked of '{String.from(key)}' on the reporting walk while the index is still being built — the reporting walk runs only after every file is folded")
		end 'indexStillBuilding'

		if self.signatures.aliasDenotesBufferSurface(key, readerFilePath: self.job.path) 'aBufferAlias'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.bufferType(written), anchor: anchor)
		end 'aBufferAlias'
	end 'requireAliasIsNotRawBuffer'

	function requireCStringTypeIsLibraryTier(spelledAt Token) throws SourceParseError
		if self.rawSurfaceIsRefusedHere() 'refused'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.cstringType, anchor: spelledAt)
		end 'refused'
	end 'requireCStringTypeIsLibraryTier'

	function requireArrayMemberIsNotRawSurface(methodTok Token, onABuffer bool) throws SourceParseError
		if not self.rawSurfaceIsRefusedHere() 'libraryTier'
			return
		end 'libraryTier'

		if methodTok.value.equals(ManagedMemoryFieldName) 'theBufferField'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.managedField, anchor: methodTok)
		end 'theBufferField'

		if onABuffer 'aBufferMember'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.bufferMember(methodTok.value), anchor: methodTok)
		end 'aBufferMember'
	end 'requireArrayMemberIsNotRawSurface'

	function requireCursorMemberIsNotRawSurface(methodTok Token) throws SourceParseError
		if self.rawSurfaceIsRefusedHere() 'refused'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.cursorMember(methodTok.value), anchor: methodTok)
		end 'refused'
	end 'requireCursorMemberIsNotRawSurface'

	// The type naming the declaration currently being read, for `Self` and for its own name.
	// `anchor` is only the token a diagnostic points at.
	//
	// ⭐ **A STRUCT'S IS `structRef`, AN ENUM'S IS `named` — the SAME split `TypeResolution` makes** (a
	// declared `type` keeps its nominal id, a declared `enum`/`union` erases to `integer`, because an enum
	// value IS its tag or its box pointer and nothing downstream needs to know which enum it was). The two
	// must agree: a `named` receiver is what `dispatchMethodOnBinding` routes an enum method call on and
	// what `parseMatchCommon` recognizes a `match self` scrutinee by, while a `structRef` one would be sent
	// to `requireStructBase` to resolve a `StructLayout` no enum declares.
	//
	// The kind is read off `enclosingTypeIsEnum` rather than the signature index for that field's stated
	// reason: this routine answers in the tolerant SWEEP too, where the enum being declared is not folded.
	//
	// ⭐⭐ **A BYTE RECORD IS NEITHER, AND ASKING FIRST IS THE WHOLE POINT.** The corpus's `type String`
	// and `type Character` declare the two types the compiler already owns, so `Self` — and the implicit
	// receiver every instance method of those bodies carries — is the BUILTIN, not a struct that happens to
	// bear its name. `parseTypeReference` settles the written spelling `String` that way one routine over
	// (`byteRecordTagOfTypeName`, which this asks so the two cannot answer one name two ways); without this
	// arm `self` reached a `s String` parameter as a `structRef` and was refused against its own type. The
	// table carries the measurement.
	function enclosingSelfType(anchor Token) returns MaxonType throws SourceParseError
		let name = try self.requireEnclosingTypeName(anchor)

		// ⭐⭐ **A PRIMITIVE IS THE THIRD KIND OF BUILTIN VALUE TYPE `Self` CAN NAME, AND IT JOINS THE
		// BYTE RECORDS' ARM RATHER THAN GETTING ONE OF ITS OWN.** `extension int` enters this body with
		// `enclosingType` = `int`, so `equals(other Self)`, `compare(other Self)` and `clone() returns Self` all
		// resolve through here — and the `structRef` below would hand every one of them a reference to a type no
		// registry holds. Answering `MaxonType.named(…)` for a primitive is the failure to avoid: an
		// `extension float` body then declares its `__self` as a NAMED Float rather than the float primitive and
		// `"{self}"` interpolation breaks.
		//
		// The two tables stay APART — four other doors need "is this name a BYTE RECORD?" and must not start
		// admitting `int` — while the QUESTION is asked once, because what this reader wants is neither table
		// but their union: *"does this name denote a builtin value type, and which tag?"*
		let byteRecord = byteRecordTagOfTypeName(name)
		let builtinValueTag = primitiveTagOfTypeName(name) if byteRecord == ValueTypeTag.unresolved else byteRecord

		if builtinValueTag != ValueTypeTag.unresolved 'theBuiltinValueType'
			return maxonTypeOfTag(builtinValueTag, nameId: UnnamedTypeId)
		end 'theBuiltinValueType'

		// ⭐⭐ **THE GENERIC TWIN OF THE ARM ABOVE: `Self` INSIDE `type Array` IS THE INSTANCE.** A
		// non-generic byte record answers with its TAG for the reason `ProgramSignatures.ownRecordSelfInstance`
		// states in full — a value of it is the compiler's own record, not a box built from declared fields —
		// and `Array` is that same fact with a type parameter on it. The base `structRef` below is right only
		// for a declaration that HAS a base box; `Array with T` is its `__ManagedMemory with T`, so a
		// `structRef(Array)` would give `clone()`'s result a struct cascade over the buffer record.
		// ⚠ **AND THE SIZED CONTAINER IS THE SAME FACT WITH A SECOND COORDINATE ON IT.** `Self` inside
		// `stdlib/FixedArray.maxon` is the declaration's own instance for exactly the reason above — a `FixedArray`'s
		// value IS the compiler's fused record — and answering `structRef(FixedArray)` would give `init`'s
		// `return Self{managed: managed}` **`E3005 Cannot return 'FixedArray_T…' from function declared to return
		// 'FixedArray'`**: the literal produced the instance, the declared return produced the base box, and the two
		// are the same type under two spellings. The countless instance it answers with is what
		// `substitutedShape` then gives the receiver's SIZE at a call.
		if self.signatures.declarationsValueIsTheManagedRecord(name) 'theCompilersOwnGenericRecord'
			return MaxonType.genericInstance(self.signatures.ownRecordSelfInstance(name))
		end 'theCompilersOwnGenericRecord'

		let id = self.artifact.typeNames.intern(name)
		return MaxonType.named(id) if self.enclosingTypeIsEnum else MaxonType.structRef(id)
	end 'enclosingSelfType'

	// **THE NAME `Self` DENOTES** — the enclosing declaration's own. One reader for both positions the
	// keyword stands in: the TYPE position above, and the EXPRESSION position (`typeBaseTokenAt`). They
	// must not disagree, since `returns Self` and `Self.create(…)` in one body name one type.
	// `anchor` is only the token a diagnostic points at.
	//
	// A `Self` at FILE SCOPE has no type to refer to. It is a positioned `unsupported` rather than a
	// panic because the source can perfectly well write one, and it is not `unexpectedToken` because
	// `Self` is a type reference — it simply names nothing here.
	function enclosingTypeName() returns immutable ByteArray
		return try self.enclosingType.typeName() otherwise panic("Parser.enclosingTypeName: asked for the enclosing type at {self.pos}, which is at file scope — every asker is inside a type or extension body")
	end 'enclosingTypeName'

	function enclosedBySizedContainer() returns bool
		return self.signatures.isFixedArrayBaseName(try self.enclosingType.typeName() otherwise return false)
	end 'enclosedBySizedContainer'

	function renderScopedTypeName(t MaxonType) returns immutable ByteArray
		let typeName = try self.enclosingType.typeName() otherwise return renderTypeNameOutsideAnyDeclaration(t, typeNames: self.artifact.typeNames, signatures: self.signatures)
		return renderDeclaredTypeName(t, declarationName: typeName, typeParamNames: self.enclosingTypeParams, typeNames: self.artifact.typeNames, signatures: self.signatures)
	end 'renderScopedTypeName'

	function requireEnclosingTypeName(anchor Token) returns immutable ByteArray throws SourceParseError
		return try self.enclosingType.typeName() otherwise throw SourceParseError.unsupported("'{anchor.kind.rawValue}' outside a type declaration (`Self` names the type whose body encloses it, and there is none here)", line: anchor.line, column: anchor.column)
	end 'requireEnclosingTypeName'

	// Does `name` name the type currently being declared? False at file scope, where there is no
	// enclosing type for any name to be — which is what makes the `isEmpty` test load-bearing
	// rather than an optimization: without it a file-scope `EmptySourceText` would match nothing
	// anyway, but only by accident of no identifier being empty.
	function namesEnclosingType(name ByteArray) returns bool
		return self.enclosingType.names(name)
	end 'namesEnclosingType'

	// The number of hidden witness parameters a function of the enclosing type carries — one per
	// `where` constraint of a constrained generic type, for every method that has somewhere to source
	// them FROM. For an instance method and a `Self`-returning static the reservation is uniform, a
	// pure function of the declaration's shape and the type's constraint count; any other static
	// reserves them conditionally, and lowering keeps them only while it carries the descriptor
	// (`ProgramSignatures.witnessSlotsCarriedBy`).
	//
	// ⭐ **AND A `Self`-RETURNING STATIC HAS SOMEWHERE, EXACTLY AS IT DOES FOR THE LAYOUT DESCRIPTOR.**
	// A static has no `self`, so gating on `takesReceiver` alone would exclude it — but a static that returns
	// the enclosing type builds the concrete instance, and the parser retypes its RESULT to that instance
	// (`retypeGenericAliasConstructorResult`), so the call site can materialize each witness table from the
	// result's type argument. It is the SAME source `LowerMaxonToStd.layoutSourceOf` reads the descriptor
	// off, and the two are reserved on the same terms. `stdlib/Map.maxon`'s static `init` — which builds a
	// `Self{…}` and calls a key-hashing method on it — is what a `takesReceiver` gate leaves `Map.init`
	// carrying 0 witness parameters and asked to forward slot 0, which is a panic in `forwardCallerWitness`.
	//
	// ⚠ **THE SUPPLY SIDE IS `ProgramSignatures.witnessParamCountForCallee`, AND BOTH ASK THE SAME TWO
	// PREDICATES** (`hasNoInstanceToTakeHiddenArgumentsFrom`, `staticMayCarryWitnessSlots`). A witness-slot
	// count is ABI: a reservation and
	// a supply that disagree is an argument-register mismatch nothing downstream can notice
	// (`witnessConstraintsOfMethod`'s header records what two such disagreements cost), so the test is
	// asked in ONE place rather than spelled on each side.
	function witnessReserveFor(takesReceiver bool, registrationName ByteArray) returns WitnessReserve
		let constraintCount = self.enclosingWhereConstraints.count() as ParamCount

		if constraintCount == 0 'unconstrainedType'
			return WitnessReserve.none()
		end 'unconstrainedType'

		if not self.signatures.hasNoInstanceToTakeHiddenArgumentsFrom(registrationName, takesReceiver: takesReceiver) 'somewhereToSourceThem'
			return WitnessReserve.create(constraintCount, conditional: 0)
		end 'somewhereToSourceThem'

		if not self.signatures.staticMayCarryWitnessSlots(registrationName) 'noConditionalWitnesses'
			return WitnessReserve.none()
		end 'noConditionalWitnesses'

		return WitnessReserve.create(0, conditional: constraintCount)
	end 'witnessReserveFor'

	function seedLayoutReserve(func IrFunction, firstId ParamCount, reserve ParamCount, anchor Token)
		for r in 0 upto reserve 'eachReserved'
			self.seedHiddenIntegerParam((firstId + r) as ValueId, anchor: anchor)
		end 'eachReserved'

		func.layoutReserve = reserve
	end 'seedLayoutReserve'

	// ⭐⭐ **THE INSTANCE A BARE GENERIC TYPE NAME DENOTES AT THE CURSOR, or `none`** — `Inner` written
	// inside `type Outer uses T` means `Inner with Outer.T`, at a TYPE reference (`returns Inner`,
	// `var v as Inner`, a `with` ARGUMENT), at a STATIC CALL base (`Inner.make(items)`), and — through the
	// first of those — in an `implements … with (…)` clause. Reading the name as a plain `named("Inner")`,
	// the base struct's DECLARATION view, is a type whose parameters nothing has bound: `Inner.make`'s
	// `Array with Inner.T` parameter and the caller's `Array with Outer.T` argument are then two instances
	// with no relation, and the legal program is **`E3005: expected 'Inner.TArr', got 'Outer.OArr'`**.
	//
	// The RULE is `ProgramSignatures.scopedGenericInstanceOf`'s, shared with the two read doors that ask it of
	// a different scope; what this adds is only which scope the CURSOR is in, and the `ConstructorInstance` the
	// call door speaks in.
	//
	// ⚠ **THE CALLER GATES ON `enclosingTypeParams` BEING NON-EMPTY**, and that gate is why this may be asked
	// at every type annotation in the program: a union return is heap-boxed even for its payload-free arm
	// (see `parseTypeReference`'s `isInterfaceName` note, measured at +24,396 allocations), so the whole
	// generics-free corpus — and every non-generic body in a generic program — must not reach the call at all.
	function bareGenericInstanceInScope(name ByteArray) returns ConstructorInstance
		let typeName = try self.enclosingType.typeName() otherwise return ConstructorInstance.none

		match self.signatures.scopedGenericInstanceOf(name, declaringTypeName: typeName, scopeParamNames: self.enclosingTypeParams) 'scoped'
			notInScope then return ConstructorInstance.none
			instance(gid) then return ConstructorInstance.instance(gid)
		end 'scoped'
	end 'bareGenericInstanceInScope'

	// ⭐⭐ **A CALL RESULT NAMING A BARE GENERIC TYPE IS READ IN THE CALLEE'S OWN SCOPE** — the READ-DOOR
	// repair of a swept return type, and the reason the type-reference arm alone is not enough.
	//
	// ⚠ **`mintCallResult` TYPES A CALL FROM THE TOKEN SWEEP — `returnTypeOf` — NEVER FROM THE REAL
	// PARSE**, and the sweep answers every bare generic name as a plain `named` — deliberately, on the
	// `allFilesFolded` gate `parseTypeReference` argues for at length, because a registry answer
	// during the sweep is a property of the loader's walk order. So `MyMap.createIterator() returns
	// MyMapIterator` reaches its CALL SITE as `MyMapIterator`, the base, and everything the receiver's
	// instance could have fixed about it is already gone.
	//
	// ⭐ **THE SCOPE IS THE CALLEE'S DECLARING TYPE, NOT THE CALLER'S** — `MyMapIterator` written in `MyMap`'s
	// body means `MyMapIterator with (MyMap.Key, MyMap.Value)` whoever is calling, and the caller's own
	// parameters have nothing to do with it. `typeCallResultThroughInstance` then fixes THAT with the call's
	// concrete instance, which is the second half and a different question.
	function promoteBareGenericResultToCalleeScope(result ValueId, source CallInstanceSource)
		if not self.resultNamesADeclaredType(result) 'namesNoDeclaredType'
			return
		end 'namesNoDeclaredType'

		// A dispatched receiver has no callee scope either: its result was typed off the interface
		// requirement (`mintWitnessDispatchResult`), which is already concrete, and an interface's name
		// is not a struct any type-parameter registry answers for.
		let declaringType = try self.declaringTypeOfSource(source) otherwise return

		// ⚠ **THE COST GATE, and it is the same one `ProgramSignatures.fieldTypeOf` spells for its own door**:
		// this runs at every method call in the program whose result names a declared type, and the answer is a
		// UNION Maxon heap-boxes even for its payload-free arm. A NON-GENERIC declaring type binds nothing, so
		// every call in the generics-free corpus leaves here rather than allocating to be told so.
		let scopeParamNames = self.signatures.structTypeParamsOf(declaringType)

		if scopeParamNames.isEmpty() 'calleeDeclaresNoTypeParameters'
			return
		end 'calleeDeclaresNoTypeParameters'

		match self.signatures.scopedGenericInstanceOf(self.internedName(self.valueNameId(result)), declaringTypeName: declaringType, scopeParamNames: scopeParamNames) 'scoped'
			notInScope then break
			instance(gid) then self.retypeValue(result, valueType: MaxonType.genericInstance(gid))
		end 'scoped'
	end 'promoteBareGenericResultToCalleeScope'

	function resultNamesADeclaredType(result ValueId) returns bool
		let resultTag = self.tagOf(result)
		return resultTag == ValueTypeTag.named or tagNamesADeclaredType(resultTag)
	end 'resultNamesADeclaredType'

	function declaringTypeOfSource(source CallInstanceSource) returns immutable ByteArray throws AbsentError
		match source 'source'
			receiver(value) then return self.signatures.genericInstanceBaseName(self.valueInstanceId(value))
			qualifier(gid) then return self.signatures.genericInstanceBaseName(gid)
			scopeOnly(typeName) then return typeName
			nowhere then throw AbsentError.absent
		end 'source'
	end 'declaringTypeOfSource'

	// ⭐⭐ **DOES THE WRITTEN NAME `name` DENOTE AN INNER `typealias` OF THE BODY BEING PARSED — the ONE home
	// of that question.** THREE doors ask it and they must not answer one written name with two
	// different types: `parseTypeReference`'s inner-alias arm (a field type, a return clause), the STRUCT
	// LITERAL door (`parseStructLiteral`) and the STATIC CALL door (`parseQualifiedCall`).
	//
	// ⛔ **THE ENCLOSING TYPE'S OWN NAME AND ITS TYPE PARAMETERS BOTH WIN OVER AN ALIAS SHADOWING THEM**, and
	// that is `parseTypeReference`'s ARM ORDER read out as a predicate rather than a precedence chosen here:
	// that routine answers the type's own name (`enclosingSelfType`) and then a bare `T`
	// (`typeParameter(token)`) BEFORE it consults `enclosingInnerAliases`. So `type Holder uses Element`
	// declaring `typealias Element = Array with ExitCode` means the PARAMETER at `var items as Element`, and
	// it has to mean the parameter at `Element{}` and `Element.create()` too.
	//
	// With the two value doors deciding for themselves, `Element{}` built an ARRAY and its record was
	// accepted into a `typeParameter` field, so one declaration denoted two types in one body and the
	// only complaint came at the READ (`self.items.count()` refused for a method the parameter's
	// constraints do not provide — a diagnostic about the slot, not about the store). There is no
	// acceptance to match: a plain `T{}` with no alias in sight is E3076, which is what this predicate
	// hands the shadowed spelling back to.
	//
	// ⚠ At `parseTypeReference` the first two tests are already settled by the arms above it and are asked
	// again only so that the three doors share ONE predicate: a fourth clause added here reaches every door
	// that resolves a written name, which is exactly what the arm order could not guarantee.
	// ⭐⭐ **DOES THIS WRITTEN SPELLING DENOTE THE `__ManagedMemory` BUFFER? — THE LITERAL NAME, A FILE-SCOPE
	// ALIAS, *OR* AN INNER ONE.** The third is what `stdlib/Character.maxon:172` needs: its
	// `typealias ByteMemory = __ManagedMemory with Byte` is declared INSIDE `type Character`, so the registry
	// holds it under `Character.ByteMemory` while the call site writes the bare `ByteMemory`, and a lookup of
	// the bare name misses. `ByteMemory.create(1, 1)` then routed to `parseArrayStaticCall` and met
	// `E2010 Expected ')' but got '1'` against `Array.create()`'s no arguments.
	//
	// ⚠ **IT QUALIFIES THE SAME WAY `parseTypeReference` DOES, AND THAT IS THE WHOLE POINT** — one
	// construction of an inner alias's registry key (`joinQualifiedName(enclosingType, member:)`), gated by
	// the one predicate that says a bare name IS an inner alias here. A second spelling of that join is how a
	// type position and a call position come to disagree about what one written word denotes.
	// ⚠ **THE INNER-ALIAS PROBE IS GATED ON `enclosingType` BEING NON-EMPTY, NOT ON `namesInnerAliasHere`.**
	// The bare probe comes first because a file-scope alias is the common case; the join is skipped at file
	// scope, where `enclosingType` is empty and the key it would build cannot exist. `namesInnerAliasHere`
	// would be the stricter test and is the wrong one HERE: it consults the body walk's live alias set, which
	// a DECLARATION position (a parameter, a return clause) is read outside of.
	// ⚠⚠ **THE ALIAS REGISTRIES ARE READ IN THE REAL PARSE ONLY, ON `allFilesFolded` — the gate
	// `parseTypeReference`'s own alias arms sit behind, arriving here for the same two reasons.**
	//   1. **UNGATED, THE ANSWER WOULD BE A PROPERTY OF THE DISK.** Both sets are written by
	//      `recordGenericAlias`, which `foldFile` calls when a file's token walk ENDS — so during the sweep an
	//      alias declared in the file being swept reads as absent while one declared in a file the walk
	//      reached EARLIER does not, and the SWEEP's answer is the one the whole-program column stores.
	//   2. **AND THE STORED ANSWER IS REDUNDANT FOR AN ALIAS, WHICH IS WHAT MAKES THE GATE FREE.** Because
	//      `parseTypeReference` is gated on `allFilesFolded` too, a swept alias-typed position keeps its bare
	//      `named` in EVERY file order, so `ProgramSignatures.derivedAliasSurfaceBits` answers for it at the
	//      read door in every order. What the sweep would store for an alias could only ever AGREE with the
	//      derivation or be WRONG, because it reads a whole-program set for a FILE-SCOPED name.
	// ⇒ The sweep answers from the TOKENS ALONE (the reserved spelling, which is a token fact and needs no
	// registry), and the doors only the real parse reaches — a PARAMETER, a static call — ask the registries
	// where they are complete and can be scoped.
	//
	// ⚠ **AND THE READ IS SCOPED TO THIS FILE.** A plain `typealias` is file-local, so two files may each
	// declare `B` and mean different things; these sets are keyed by the bare name with no file in the key.
	// With `typealias B = __ManagedMemory with Byte` in one file and `typealias B = Array with Int` in
	// another, an unscoped read would give the second file's own `B` the BUFFER's surface — its parameter
	// refusing `count`, and its `B.create()` routing to the buffer's two-argument static.
	function spellingDenotesBufferSurface(spelling ByteArray, nameReader FilePath) returns bool
		if spelling.equals(ManagedMemoryTypeName) 'spelledTheReservedNameItself'
			return true
		end 'spelledTheReservedNameItself'

		if not self.signatures.allFilesFolded 'sweepAnswersFromTokensAlone'
			return false
		end 'sweepAnswersFromTokensAlone'

		if self.signatures.aliasDenotesBufferSurface(spelling, readerFilePath: nameReader) 'aFileScopeAlias'
			return true
		end 'aFileScopeAlias'

		return self.enclosingType.isType() and self.signatures.aliasDenotesBufferSurface(self.innerAliasKey(spelling), readerFilePath: nameReader)
	end 'spellingDenotesBufferSurface'

	function namesInnerAliasHere(name ByteArray) returns bool
		if self.namesEnclosingType(name) 'ownName'
			return false
		end 'ownName'

		if self.enclosingTypeParams.contains(name) 'typeParam'
			return false
		end 'typeParam'

		// ⭐⭐ **TWO POSITIONS ANSWER FROM THE WHOLE-PROGRAM REGISTRIES INSTEAD OF FROM THIS BODY'S OWN WALK, AND
		// THEY ARE ONE MECHANISM.** Both ask the identical `<Type>.<member>` question, so they widen
		// nothing: `declaresInnerAlias` is keyed by the enclosing type, and it answers about exactly the
		// declarations a body walk would have recorded.
		//   • A drained DEFAULT expression — the set below is gone, because the body walk that built it
		//     closed with its declaration (`restoreDeclaringTypeScope`).
		//   • An EXTENSION body — the set below holds only what THIS body declared, and a nested `typealias` is a
		//     MEMBER of the extended type, so every `extension` over that type may spell it whatever file it
		//     lives in. `stdlib/helpers/sort/` is the case: several files write `export extension Array`,
		//     `insertionSort.maxon` declares `SortComparator` and the others spell it bare.
		//
		// ⛔ **THESE NAMES ARE NOT FLAT AND PROGRAM-WIDE.** An extension's `typealias` written into a
		// program-wide table under its BARE name makes `SortComparator` nameable from any file at file scope,
		// and no such table can diagnose two types declaring one member name. The key is
		// `<Type>.<member>` for exactly that reason (`qualifiedInnerGenericAlias`), and the whole of this
		// widening is the ENCLOSING TYPE's own members — so `Array.SortComparator` reaches an `extension
		// Array` in any file and reaches nothing else anywhere.
		//
		// ⚠ **THE TYPE'S OWN BODY IS NOT GIVEN THIS, AND THAT IS THE PASS STRUCTURE RATHER THAN A PREFERENCE.**
		// A `type` body's signatures are read during the per-file declaration sweep, which runs BEFORE
		// `Queries.foldExtensionDeclarations` publishes any extension's members — so a `type Foo` body granted
		// the probe would resolve a written name one way in the sweep and another in the real parse, which is
		// one declaration recorded under two spellings. An extension body is read only by the two passes that
		// both run after the pre-pass, so for it the two readings agree by construction.
		if self.innerAliasesFromIndex and self.enclosingType.isType() and self.signatures.declaresInnerAlias(joinQualifiedName(self.enclosingTypeName(), member: name)) 'aMemberDeclaredElsewhere'
			return true
		end 'aMemberDeclaredElsewhere'

		return self.namesAnEnclosingInnerAlias(name)
	end 'namesInnerAliasHere'

	// ⭐⭐ **THE WHOLE-PROGRAM `genericAliases` KEY A WRITTEN BASE NAME DENOTES — the one home of "which
	// registration is this spelling?" for the static-call doors.** A file-scope generic alias is keyed
	// under its own name (`IntBox`); an INNER one under the enclosing type's, base-qualified
	// (`Plain.IntPair`) — `recordScannedType` and `foldExtensionDeclarationInto` both re-key it through
	// `qualifiedInnerGenericAlias`, because a bare member collides with another type's same-named alias.
	// A caller here holds the name the AUTHOR wrote, which is the bare member for both.
	//
	// ⛔ **ASKING THE BARE NAME IS A SILENT WRONG ANSWER, NOT A REFUSAL.** `parseQualifiedCall` makes
	// four alias-driven decisions and every one of them misses for an inner alias over a USER generic
	// base, so `IntPair.create(9)` would mangle onto a callee no file declares and `mintCallResult` would type
	// the value `unresolved`. The program would then be refused for a field access on `unknown` — one door
	// past E3076's own advice to write exactly that call. That program is legal and exits 9.
	//
	// A name that is not an inner alias here, and one the declaration sweep did not key, are both handed back
	// unchanged — the callers' file-scope reading, and the tolerant sweep's `no` for every name.
	function genericAliasKeyFor(name immutable ByteArray) returns immutable ByteArray
		if not self.namesInnerAliasHere(name) 'notInnerAlias'
			return name
		end 'notInnerAlias'

		let qualified = self.innerAliasKey(name)

		if not self.signatures.isGenericAliasInAnyFile(qualified) 'notKeyedWholeProgram'
			return name
		end 'notKeyedWholeProgram'

		return qualified
	end 'genericAliasKeyFor'

	// ⭐ **RESOLVE A `named` FUNCTION-ALIAS REFERENCE TO `function`** — the read-side twin of
	// `resolveNamedStruct`, for the types the WHOLE-PROGRAM signature index hands back as `named` because
	// the SWEEP that recorded them ran before the function alias was known: a call RESULT
	// (`returnTypeOf` → `let f = pickDouble()`) and a struct-FIELD read (`fieldTypeOf` → `let f = h.op`).
	// `parseTypeReference` already re-tags a PARAMETER/return/annotation directly (the sweep is complete
	// by the real parse), so this catches only the sweep-sourced types. A `named` that is neither a function
	// alias (`function`) NOR a generic-instance alias (`genericInstance(gid)` — `returns StrBox`, so
	// `let b = make()` binds a real generic instance with its type-arg managed drop, not an opaque `named` a
	// field access rejects) NOR a TUPLE alias (`structRef`), and every non-`named` type, pass through
	// untouched. The SWEEP records a return type before the index knows its aliases, so all three arrive here
	// `named`. Two files may hold one name in different kinds, so `denotedAliasForm` decides which form the
	// name denotes for `scopeFilePath`, idempotent and foldable alongside
	// `resolveNamedStruct`/`resolveFloatAliasType`.
	// `scopeFilePath` is `resolveNamedStruct`'s, for its reason — this is the same repair one registry over.
	function resolveNamedAlias(t MaxonType, scopeFilePath FilePath) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notNamed'
			return t
		end 'notNamed'

		let id = typeNameIdOf(t)
		let name = try self.artifact.typeNames.nameOf(id) otherwise panic("resolveNamedAlias: a `named` type's id is not in this file's interner — `parseTypeReference`/`fieldTypeOf` interned it from a name in the same table")

		return try denotedAliasForm(self.signatures, name: name, readerFilePath: scopeFilePath, into: self.artifact.typeNames) otherwise t
	end 'resolveNamedAlias'

	// ⭐ **WHAT A GENERIC-ALIAS NAME DENOTES IN A TYPE POSITION** — the instance it was bound to, resolved
	// through the one door that decides whether that instance is a BOX or an EXISTENTIAL
	// (`instanceDenotedType`). Three type-resolution arms spelled this same two-call join — the inner-alias
	// arm, the file-scope alias arm and the sweep repair — which is three chances for one of them to keep
	// reading a `genericInstance` after the split moved.
	//
	// ⚠ **THE `isGenericAlias` GATE STAYS AT EACH ARM RATHER THAN MOVING IN HERE, AND THAT IS A MEASURED
	// CHOICE.** This runs on the path `parseTypeReference` takes for every type annotation in the program; a
	// door answering "or nothing" would return a union, and a union return is heap-boxed even for its miss
	// case — the same +24,396 allocations at step 5 that `isInterfaceName` is spelled the narrow way for, one
	// arm above. The gate is a bool and costs nothing; only the JOIN is shared.
	//
	// ⚠ `readerFilePath` is the file whose gate admitted the name. Resolving in a different file than the
	// gate asked about hands back a homonym's instance on a legal program.
	function genericAliasDenotedType(name ByteArray, readerFilePath FilePath) returns MaxonType
		return self.signatures.instanceDenotedType(self.signatures.genericAliasInstanceFrom(name, readerFilePath: readerFilePath), into: self.artifact.typeNames)
	end 'genericAliasDenotedType'

	// During the SWEEP only one answer about a tuple alias is knowable: a declaration already read in the
	// reader's own file is FINAL, because a second same-file declaration of the name is E3061. Any other
	// answer is provisional — a later file may declare the name too — so the arm leaves a bare `named` for the
	// read doors to repair rather than pinning whichever declaration the walk had reached. The blunt
	// `allFilesFolded` gate its neighbours take would refuse the knowable answer along with the rest.
	function tupleAliasMeaningIsSettled(name ByteArray) returns bool
		return self.signatures.allFilesFolded or self.signatures.tupleAliasIsDeclaredIn(name, readerFilePath: self.job.path)
	end 'tupleAliasMeaningIsSettled'

	// `resolveNamedStruct` folded over a parameter-type list — the whole struct-`named` → `structRef`
	// rewrite for one function's parameters, done ONCE after they are parsed so every downstream reader
	// (the value-tag seeding, the binding types, the recorded signature) sees the same resolved list.
	function resolveNamedStructAll(types MaxonTypeArray) returns MaxonTypeArray
		let resolved = MaxonTypeArray.create(types.count(), zeroed: false)

		for t in types 'each'
			resolved.push(resolveNamedStruct(t, typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: self.job.path))
		end 'each'

		return resolved
	end 'resolveNamedStructAll'

	// `resolveNamedStruct` for a return type: a `returns Pair` resolves its inner struct-`named` to
	// `structRef` so `parseReturnStatement`'s declared-type check agrees with the `structRef` a factory's
	// `return Self{…}` hands back, and so the recorded signature matches the call site's adopted result.
	function resolveNamedStructReturn(rt MaxonReturnType) returns MaxonReturnType
		return match rt 'r'
			void gives rt
			value(inner) gives MaxonReturnType.value(resolveNamedStruct(inner, typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: self.job.path))
		end 'r'
	end 'resolveNamedStructReturn'

	// Does `returnType` name the ENCLOSING type — `Self`, the base struct, `structRef` after
	// `resolveNamedStructReturn`? Compared by interned id in `self.artifact.typeNames` — the interner
	// both the resolved return type and `self.enclosingType` live in — so no `nameOf` round-trip is
	// needed.
	//
	// ⭐⭐ **AND A `Self` THAT RESOLVED TO AN INSTANCE ANSWERS TRUE TOO.** `enclosingSelfType` gives a
	// container whose record the compiler owns the INSTANCE over its own parameters rather than the
	// base `structRef`, so `stdlib/Array.maxon`'s `static function from(source) returns Self` arrives
	// here as a `genericInstance`, and it returns `Self` all the same. The question this asks stays
	// the same; only the two spellings `Self` can take have to be read, and an ORDINARY generic still
	// cannot reach the second one, so nothing else's answer moves.
	function returnsEnclosingType(returnType MaxonReturnType) returns bool
		return match returnType 'r'
			void gives false
			value(inner) gives self.typeIsEnclosingType(inner)
		end 'r'
	end 'returnsEnclosingType'

	// The two spellings of "this type IS the enclosing declaration", split out so the `match` above stays one
	// expression per arm. The instance half compares BASE NAMES: a `genericInstance` id lives in the
	// signature index's own space, not in `self.artifact.typeNames`, so there is no id to compare.
	function typeIsEnclosingType(t MaxonType) returns bool
		let typeName = try self.enclosingType.typeName() otherwise return false
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.structRef 'theBaseBox'
			return typeNameIdOf(t) == self.artifact.typeNames.intern(typeName)
		end 'theBaseBox'

		return tag == ValueTypeTag.genericInstance and self.signatures.genericInstanceBaseName(genericInstanceIdOf(t)).equals(typeName)
	end 'typeIsEnclosingType'

	// Statement list until the closing `end`, emitting into `block`. Returns the block
	// the LAST statement left control in — the same `block` for straight-line code, but
	// an `if` moves control into its continuation block, so subsequent statements (and
	// the caller) must follow it. `func` is threaded so control-flow statements can
	// create successor blocks. Blank lines separate statements.
	function parseStatements(func IrFunction, block IrBlock) returns IrBlock throws SourceParseError
		var current = block
		self.bodyState.statementNesting = self.bodyState.statementNesting + 1

		// ⭐⭐ **E3071 LIVES HERE BECAUSE THIS IS THE ONE STATEMENT-LIST LOOP** — a function body and every
		// nested block body (`parseBlockBody`) both come through it, so the dead-code rule is stated once for
		// the whole language. See `statementFormRole` for the roster and `PrecedingTerminator` for why
		// the keyword's own bytes are what travels.
		var preceding = PrecedingTerminator.none
		var sharesItsLine = false

		while true 'stmts'
			self.skipNewlines()
			let closes = self.closesBlockAt(self.pos)

			if sharesItsLine 'afterAStatementOnItsLine'
				let shared = self.current()

				if not closes 'aStatementSharesIt'
					_ = try self.readStatementOpening(preceding, entersItsChain: false)
				end 'aStatementSharesIt'

				throw lineSharedRefusal(LineEndingConstruct.statement, got: shared)
			end 'afterAStatementOnItsLine'

			if closes 'endBlock'
				break
			end 'endBlock'

			if self.isEof() 'eof'
				let tok = self.current()
				throw SourceParseError.unexpectedEof(tok.line, column: tok.column)
			end 'eof'

			// A real statement follows a terminator in THIS block, so control can never reach it (E3071).
			// Asked after the `end` and EOF tests, both of which are the block ending rather than a statement:
			// a terminator as the block's LAST statement is the ordinary shape, and a truncated body is
			// `unexpectedEof`'s to report, not this one's.
			//
			// `preceding` is recorded BEFORE the statement is parsed, off its form, so the next iteration
			// can refuse whatever follows it.
			let head = try self.readStatementOpening(preceding, entersItsChain: true)
			preceding = PrecedingTerminator.keyword(head.opening.value) if statementFormRole(head.form) == StatementRole.terminator else PrecedingTerminator.none
			current = try self.parseStatement(func, block: current, head: head)
			sharesItsLine = not tokenKindEndsALine(self.kindAt(self.pos))
		end 'stmts'

		self.bodyState.statementNesting = self.bodyState.statementNesting - 1
		return current
	end 'parseStatements'

	function parseStatement(func IrFunction, block IrBlock, head StatementHead) returns IrBlock throws SourceParseError
		let windowFloor = self.statementWindowFloor()
		self.bodyState.operandOrder.enterStatement()
		let next = try self.parseStatementBody(func, block: block, head: head)
		self.bodyState.operandOrder.leaveStatement()
		try self.requireNoDeferredRefusal()
		self.closeWindowsTo(windowFloor)
		return next
	end 'parseStatement'

	// One statement. Returns the block subsequent statements continue in.
	//
	// EVERY arm returns `self.bodyState.currentBlock`, not `block`, and that is required:
	// a short-circuit `and`/`or` anywhere inside a statement's EXPRESSION leaves
	// control in a fresh merge block, so even a "straight-line" statement — a `let`, an
	// assignment, a bare call — can move it. Returning the incoming `block` would send the
	// next statement's ops to a block control has already left, which reads as a wild
	// miscompile (ops stranded on a dead path) rather than as a parse error.
	//
	// `break`/`continue` are the two that genuinely cannot move it: neither takes an
	// expression. They still route through the same return so there is ONE rule here rather
	// than an exception to remember.
	function parseStatementBody(func IrFunction, block IrBlock, head StatementHead) returns IrBlock throws SourceParseError
		self.bodyState.currentBlock = block
		let lateFloor = self.bodyState.lateReads.count()
		self.bodyState.statementStart = self.pos
		self.forgetStatementFacts()

		// The statement's first token — the anchor `drainPendingTemps` gives the drops it emits (no source
		// token spawns a drop). Captured before parsing advances the cursor.
		let stmtTok = head.opening

		// ⭐ **`--coverage`: ONE COUNTER AT THE HEAD OF EVERY USER STATEMENT, ahead of the statement's own
		// ops** — so a statement whose code a later pass deletes still reports the count its line really
		// achieved, which a line table built from surviving code alone cannot. This is the ONE statement
		// dispatcher, so no statement shape can be instrumented in one form and silently not in another.
		if self.coverageActive() 'instrumentThisStatement'
			self.mintCovPoint(block, funcName: func.name, flags: MxdbgCovFlagStatement, line: stmtTok.line, col: stmtTok.column, branchLine: 0, branchCol: 0)
		end 'instrumentThisStatement'

		let form = head.form

		if form == StatementForm.ret 'ret'
			try self.parseReturnStatement(func, block: block)
		end 'ret' else if form == StatementForm.bindingDecl 'bindingDecl'
			try self.parseBinding(func, block: block, kind: bindingKindOfKeyword(stmtTok.kind), heapAnnotated: false)
		end 'bindingDecl' else if form == StatementForm.annotatedDecl 'annotatedDecl'
			// `@heap let p = Point.create(1, y: 2)` — an ANNOTATED binding. The `@` is the only token that opens
			// one and it opens nothing else, so the arm sits beside the two bindings it decorates.
			try self.parseAnnotatedBinding(func, block: block)
		end 'annotatedDecl' else if form == StatementForm.ifStmt 'ifStmt'
			return try self.parseIfStatement(func, block: block)
		end 'ifStmt' else if form == StatementForm.whileStmt 'whileStmt'
			return try self.parseWhileStatement(func, block: block)
		end 'whileStmt' else if form == StatementForm.forStmt 'forStmt'
			return try self.parseForStatement(func)
		end 'forStmt' else if form == StatementForm.modifyStmt 'modifyStmt'
			return try self.parseModifyStatement(func, block: block)
		end 'modifyStmt' else if form == StatementForm.acquireStmt 'acquireStmt'
			return try self.parseAcquireStatement(func)
		end 'acquireStmt' else if form == StatementForm.matchStmt 'matchStmt'
			return try self.parseMatchStatement(func, block: block)
		end 'matchStmt' else if form == StatementForm.breakStmt 'breakStmt'
			try self.parseBreakStatement(func, block: block)
		end 'breakStmt' else if form == StatementForm.continueStmt 'continueStmt'
			try self.parseContinueStatement(block)
		end 'continueStmt' else if form == StatementForm.throwStmt 'throwStmt'
			try self.parseThrowStatement(func, block: block)
		end 'throwStmt' else if form == StatementForm.tryStmt 'tryStmt'
			// The BLOCK form (`try 'label' … end 'label' otherwise (e) 'h' … end 'h'`) is a statement and
			// nothing else — it groups statements and yields no value — so it forks HERE, off the same
			// label lookahead the extent scan reads (`charLiteralOpensTryBlockIn`, which is also where the label-vs-
			// character-receiver rule lives). `parseTry` keeps its own refusal of the form for the EXPRESSION
			// position that still cannot take it.
			if charLiteralOpensTryBlockIn(self.tokens, index: self.pos + 1) 'blockForm'
				return try self.parseTryBlockStatement(func, block: block)
			end 'blockForm'

			// A `try` in statement position — its value is discarded; the forms are the propagate,
			// the control-flow `otherwise`s, `otherwise ignore`, and the block handlers.
			_ = try self.parseTry(func, resultUsed: false)
		end 'tryStmt' else if form == StatementForm.panicStmt 'panicStmt'
			try self.parsePanicStatement(func, block: block)
		end 'panicStmt' else if form == StatementForm.awaitStmt 'awaitStmt'
			// ⭐ **`await p` ON A LINE OF ITS OWN** — a VOID async awaited for its EFFECT. The await IS the
			// synchronization point and there is nothing to bind: a void async's await yields a void-tagged
			// value, so no binding and no expression position can host it. That is the same "this is the
			// position that wants no value" argument every bare-call arm above makes, and it is the reason a
			// void `async` was spawnable but not awaitable — `async-await.void` and `async-await.nested-void`
			// died here as `E2001: unexpected token: 'await'` while the spawn one line above them compiled.
			//
			// A NON-void result written here is discarded like any other bare call's, and the statement's
			// `drainPendingTemps` tail releases it if it owns heap. `try await p otherwise …` is NOT this arm:
			// it opens with `try` and `tryStmt` above claims it.
			_ = try self.parseAwait(func)
		end 'awaitStmt' else if form == StatementForm.destructStmt 'destructStmt'
			try self.parseDestructStatement()
		end 'destructStmt' else if form == StatementForm.tupleAssign 'tupleAssign'
			// `(x, let y) = f()` — a statement-level TUPLE ASSIGNMENT (`specs/tuple-assign.md`): one
			// right-hand side, evaluated once, distributed positionally over targets that rebind, declare or
			// discard. It is the only statement in the grammar that opens with `(`, and the predicate — not
			// this arm — is where that claim is stated and defended. See `tupleAssignEqualsIn`.
			try self.parseTupleAssignment(func, block: block)
		end 'tupleAssign' else if form == StatementForm.assign 'assign'
			// An identifier followed by `=` is a reassignment. The two-token lookahead
			// keeps a bare identifier from being mis-parsed as an incomplete assignment.
			// Through `assignsAt`, which is also what decides a loop's carried vars — see there.
			try self.parseAssignment(func, block: block)
		end 'assign' else if form == StatementForm.selfFieldAssign 'selfFieldAssign'
			// `self.count = 5` — the explicit spelling of a self-field store. Its own predicate for
			// `fieldAssignsAt`'s reason: it assigns no BINDING, so `assignedBindingsIn` must not see it.
			// (The BARE spelling, `count = 5`, matches `assignsAt` and is routed above — see there
			// for why the scan finding `count` is harmless.)
			try self.parseExplicitSelfFieldAssignment(func, block: block)
		end 'selfFieldAssign' else if form == StatementForm.staticMemberAssign 'staticMemberAssign'
			// `Counter.count = 42` — a write to a static member, refused as an assignment to an immutable
			// binding. Its own arm, ahead of
			// `fieldAssignsAt`, whose token shape it shares EXACTLY: what tells the two apart is that this base
			// names a TYPE and that one a VALUE, which is the same separation `methodCallsAt` draws between
			// `c.increment()` and `Point.create()`. Left to the field arm it reaches `requireStructBase` and is
			// refused as a chain through a binding nothing declared.
			//
			// `assignedBindingsIn` reads only `assignsAt`, and must not see this one for `fieldAssignsAt`'s
			// reason: it assigns no BINDING, so a loop writing a static must mint no header phi for it — every
			// read of the slot is a fresh `loadIndirect` (`emitGlobalLoad`), exactly as for a file-scope `var`.
			try self.parseStaticMemberAssignment(func, block: block)
		end 'staticMemberAssign' else if form == StatementForm.refusedStaticStore 'refusedStaticStore'
			// `Counter.hits = 9` where the roster refuses the member. Directly beneath the arm that takes the
			// LEGAL store and above the field arm, which is the same separation that pair already draws: a
			// base naming a TYPE is never a chain through a binding, so the field arm's refusal would name
			// the wrong mistake. See `staticStoreRefusedAt`.
			try self.refuseStaticMemberStore()
		end 'refusedStaticStore' else if form == StatementForm.fieldAssign 'fieldAssign'
			// `p.x = 5` — a store THROUGH a binding rather than a rebinding of one. Its own
			// predicate, and `assignedBindingsIn` reads only `assignsAt`: see `assignsAt` for why
			// widening that one instead would have minted the loop's phi for the FIELD's name.
			try self.parseFieldAssignment(func, block: block)
		end 'fieldAssign' else if form == StatementForm.methodCallStmt 'methodCallStmt'
			// `c.increment()` / `self.increment()` — a method call for its EFFECT. Void methods are
			// most of what a type declares, and this is the only position that wants no value, so
			// `resultUsed: false` is what makes them callable at all.
			//
			// A FUNCTION-TYPED FIELD reached the same way (`h.op()`, `self.op()`) is NOT a method (#97):
			// `dispatchMethodOnBase` LOADS the field (a `function` value) and leaves the trailing `(args)` for the
			// postfix loop, exactly as it does in expression position. `parsePostfix` applies it as an INDIRECT call
			// (the #68/#78 lowering), so the trailing `(` is not left to be misread as a `( statement` on the next
			// iteration. A real method call consumes its own `(args)`, so `parsePostfix` then sees no trailing `(`
			// and is a no-op — the emitted IR of every existing method-call statement is unchanged.
			//
			// E3064's METHOD-CALL door, in the shape every dotted call statement shares: the anchor is read
			// before the cursor leaves the chain, the floor before the call emits anything.
			let methodAnchor = self.dottedCallNameToken(self.pos)
			let methodTempFloor = self.bodyState.pendingTempDrops.count()
			let methodOpFloor = self.artifact.module.ops.count()
			let operandStart = self.bodyState.operandOrder.eventCount()
			let methodResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseMethodCall(func, resultUsed: false), resultUsed: false)
			try self.finishCallStatement(func, result: methodResult, opFloor: methodOpFloor, tempFloor: methodTempFloor, anchor: methodAnchor)
		end 'methodCallStmt' else if form == StatementForm.fieldChainMethodStmt 'fieldChainMethodStmt'
			// `b.ops.push(1)` / `o.inner.op()` — a call reached through a ≥2-hop field chain, on an ARRAY FIELD's
			// method or a FUNCTION-typed FIELD (#97). `methodCallsAt` covers only the one-hop `b.push(…)` / `h.op()`;
			// this is the chain case, dispatched for effect (`resultUsed: false`). A function field's trailing
			// `(args)` goes through `parsePostfix` exactly as the one-hop `methodCallStmt` above.
			let chainAnchor = self.dottedCallNameToken(self.pos)
			let chainTempFloor = self.bodyState.pendingTempDrops.count()
			let chainOpFloor = self.artifact.module.ops.count()
			let chainResult = try self.parseFieldChainCall(func, resultUsed: false)
			try self.finishCallStatement(func, result: chainResult, opFloor: chainOpFloor, tempFloor: chainTempFloor, anchor: chainAnchor)
		end 'fieldChainMethodStmt' else if form == StatementForm.staticMemberCallStmt 'staticMemberCallStmt'
			// `Names.items.push(9)` — a method called for its EFFECT on a static member's record. The
			// expression door reaches the same reader through `parseDottedPrimary`'s static arm; a statement
			// has no arm that claims a dotted form, so it needs one of its own — exactly as
			// `methodCallStmt` and `fieldChainMethodStmt` each do. Without it the canonical spelling of the
			// only mutation a managed static supports died as `E2015: Unsupported: identifier statement`.
			// With field hops between the member and the method (`Registry.current.items.push(9)`),
			// `parsePostfix` applies the rest of the chain, as the expression form does.
			let staticAnchor = self.dottedCallNameToken(self.pos)
			let staticTempFloor = self.bodyState.pendingTempDrops.count()
			let staticOpFloor = self.artifact.module.ops.count()
			let operandStart = self.bodyState.operandOrder.eventCount()
			let staticResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseStaticMemberAccess(func, baseTok: try self.typeBaseTokenAt(self.pos), resultUsed: false), resultUsed: false)
			try self.finishCallStatement(func, result: staticResult, opFloor: staticOpFloor, tempFloor: staticTempFloor, anchor: staticAnchor)
		end 'staticMemberCallStmt' else if form == StatementForm.qualifiedStaticCallStmt 'qualifiedStaticCallStmt'
			// ⭐ `Clock.tick()` / `__Builtins.sleep(ms)` / `__ManagedFile.statFree(buffer)` — A STATIC CALLED
			// ON A LINE OF ITS OWN, and `statFree` is the case that makes the position load-bearing rather
			// than a convenience: it is the ONLY thing that can release the raw block `stat` hands back, and
			// it is void and non-throwing, so a statement is the only position it can be written in. Without
			// this arm the canonical spelling (`stdlib/File.maxon:186`) died as
			// `E2015: Unsupported: identifier statement` and every successful `stat` leaked 48 bytes — exit
			// 101, measured. The void-and-THROWING pair (`delete`/`rename`) never
			// needed it: a `try` statement is their own form.
			//
			// This is the position `stdlib/Sleep.maxon` needs — the module every source-level `sleep(ms)`
			// resolves to: its whole body is `__Builtins.sleep(milliseconds)` on a line of its own.
			//
			// A member the table does NOT recognize falls through `parseCallNamed` to `emitCall`, whose
			// reserved-callee rejection reports the positioned E3004 (`requireCalleeIsNotReservedName`) —
			// so this door widens no name, it only routes them to the same answer expression position
			// already gives.
			//
			// ⭐⭐ **E3064/E3065's STATIC-CALL door, and why the predicate needs no return-type test of its
			// own**: `recordDiscardedCallResult` drops a void result on the floor and files everything else
			// for `SemanticCheck.checkDiscardedResults` to judge. So a bare `Point.create()` is
			// **E3064 `result of pure function 'Point.create' must be used`** and an impure `Clock.tick()` is
			// **E3065** — the oracle's pair of answers for the same two programs.
			let staticCallAnchor = self.dottedCallNameToken(self.pos)
			let staticCallTempFloor = self.bodyState.pendingTempDrops.count()
			let staticCallOpFloor = self.artifact.module.ops.count()
			let operandStart = self.bodyState.operandOrder.eventCount()
			let staticCallResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseQualifiedCall(func, resultUsed: false), resultUsed: false)
			try self.finishCallStatement(func, result: staticCallResult, opFloor: staticCallOpFloor, tempFloor: staticCallTempFloor, anchor: staticCallAnchor)
		end 'qualifiedStaticCallStmt' else if form == StatementForm.namespaceQualifiedCallStmt 'namespaceQualifiedCallStmt'
			// ⭐ **`utils.shout()` / `lib.inner.shout()` ON A LINE OF ITS OWN** — a FREE call written with
			// a directory qualifier, and a free call is exactly what `callStmt` below already admits: the
			// result is discarded, `resultUsed: false` is what makes a VOID one legal here, and the
			// statement's `drainPendingTemps` tail releases an owned result nothing took. Without this arm the
			// canonical spelling died as `E2015: Unsupported: identifier statement` — `callStmt`'s lookahead
			// is `identifier (`, which a qualifier's `.` fails — so a namespaced module could declare a void
			// function nobody outside its own directory could call.
			// Pinned by `namespaces/namespace-qualified-void-call-statement`.
			//
			// ⚠ **IT IS NOT `Point.create()`'s CASE, AND THE RECOGNIZER IS WHAT KEEPS THEM APART.** A static
			// call is `qualifiedStaticCallStmt`'s one arm up, and `resolvesAsNamespaceQualifiedFunction`
			// declines any chain a `Type.method` key already wears, so this arm never sees one.
			//
			// Through `parsePostfix` for `directCallStmt`'s reason: a call whose RESULT is a function value can
			// carry a trailing `(args)`, which the postfix loop applies as an indirect call. A plain direct
			// call leaves none, so this is a no-op for every ordinary namespace-qualified statement.
			let qualifiedAnchor = self.dottedCallNameToken(self.pos)
			let qualifiedTempFloor = self.bodyState.pendingTempDrops.count()
			let qualifiedOpFloor = self.artifact.module.ops.count()
			let operandStart = self.bodyState.operandOrder.eventCount()
			let qualifiedResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseNamespaceQualifiedCall(func, chain: head.chain, resultUsed: false), resultUsed: false)
			try self.finishCallStatement(func, result: qualifiedResult, opFloor: qualifiedOpFloor, tempFloor: qualifiedTempFloor, anchor: qualifiedAnchor)
		end 'namespaceQualifiedCallStmt' else if form == StatementForm.valueHeadedCallStmt 'valueHeadedCallStmt'
			let valueAnchor = self.dottedCallNameToken(self.pos)
			let valueTempFloor = self.bodyState.pendingTempDrops.count()
			let valueOpFloor = self.artifact.module.ops.count()
			let operandStart = self.bodyState.operandOrder.eventCount()
			let valueResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseVariableReference(), resultUsed: false)
			try self.finishCallStatement(func, result: valueResult, opFloor: valueOpFloor, tempFloor: valueTempFloor, anchor: valueAnchor)
		end 'valueHeadedCallStmt' else if form == StatementForm.parenthesizedCallStmt 'parenthesizedCallStmt'
			let groupAnchor = self.current()
			let groupTempFloor = self.bodyState.pendingTempDrops.count()
			let groupOpFloor = self.artifact.module.ops.count()
			let operandStart = self.bodyState.operandOrder.eventCount()
			let groupResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseParenthesizedExpression(func), resultUsed: false)
			try self.finishCallStatement(func, result: groupResult, opFloor: groupOpFloor, tempFloor: groupTempFloor, anchor: groupAnchor)
		end 'parenthesizedCallStmt' else if form == StatementForm.spawnStmt 'spawnStmt'
			// ⭐ **`spawn Calc.create()` ON A LINE OF ITS OWN** — a service started for its EFFECT, its handle
			// discarded. It needs an arm of its own for `namespaceQualifiedCallStmt`'s reason one arm up: the
			// `callStmt` lookahead below is `identifier (`, which `spawn Calc` fails, so without this the
			// canonical spelling would die as `E2001 unexpected token: 'spawn'` rather than reaching the
			// reader that can say what is wrong with it.
			//
			// ⚠ It is the SAME reader as the expression position's, so the two cannot come to disagree about
			// what a spawn is or which refusal it earns — `parseAwait`'s single-homing argument exactly.
			_ = try self.parseSpawn(func, handling: SpawnStartHandling.routed)
		end 'spawnStmt' else if form == StatementForm.callStmt 'callStmt'
			// An identifier followed by `(` is a bare-call statement — the call is evaluated for its
			// effect and its result discarded. `resultUsed: false` is what makes a VOID call legal
			// HERE and nowhere else: this is the position that wants no value.
			//
			// A FUNCTION-TYPED LOCAL called here (`let cb = doIt; cb()`) is an INDIRECT call through the
			// value — the SAME diversion `parsePrimary` makes in expression position.
			// Resolve it as a variable reference and let `parsePostfix` apply the trailing `(args)` as an
			// indirect call, exactly as the expression path does; its result — void, or a value discarded
			// here like any other bare-call statement — is dropped by the statement's `drainPendingTemps`
			// tail when it owns heap. Treating `cb` as a direct call instead is what misreported it E3004.
			if self.calleeIsFunctionTypedLocal() 'functionLocalCallStmt'
				let operandStart = self.bodyState.operandOrder.eventCount()
				_ = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseVariableReference(), resultUsed: false)
			end 'functionLocalCallStmt' else 'directCallStmt'
				// A trailing `(` on the call's RESULT is a call-result callee (`getFn()()`) — the result is itself a
				// `function` value, applied by `parsePostfix` as an indirect call, the statement-position twin of the
				// value-position `pick()(21)` (#97). A plain direct call leaves no trailing `(`, so `parsePostfix` is a
				// no-op and every existing direct-call statement lowers to the same IR.
				let calleeTok = self.current()
				let callTempFloor = self.bodyState.pendingTempDrops.count()

				// A module-wide floor, for `parseTupleAssignment`'s reason: the call may have left the cursor on a
				// block it forked, and two blocks' op COUNTS compare to nothing.
				let callOpFloor = self.artifact.module.ops.count()
				let operandStart = self.bodyState.operandOrder.eventCount()
				let callResult = try self.parsePostfix(func, operandStart: operandStart, value: try self.parseCall(func, resultUsed: false), resultUsed: false)

				// E3064's bare-call door: the statement took none of what the call produced. Probed before
				// `terminateAfterDivergingCall` moves the parser into a dead block the probe would read
				// instead.
				try self.finishCallStatement(func, result: callResult, opFloor: callOpFloor, tempFloor: callTempFloor, anchor: calleeTok)
				self.terminateAfterDivergingCall(func, calleeTok: calleeTok, tempFloor: callTempFloor)
			end 'directCallStmt'
		end 'callStmt' else if form == StatementForm.memberExprStmt 'memberExprStmt'
			// `h.op` / `arr.managed` / `Self.make(1)` — a MEMBER ACCESS written on a line of its own. Every
			// arm above has already declined it (no `=` to make it a store, no `(args)` shape any of the call
			// dispatchers claims), and what is left is a WELL-FORMED EXPRESSION refused for a reason that
			// belongs to statement position alone: a field read is a BORROW with no one here to borrow for,
			// and a `Self`-based call is a statement the ORACLE has no grammar for either (`E2001` there,
			// measured).
			//
			// ⚠ The guard asks only what FOLLOWS, deliberately, where the `callStmt` arm above also pins the
			// current token to an identifier. A member access's receiver is not always one — `"abc".foo()`
			// and `Self.make(1)` both arrive here — so keying on the receiver's kind would sort a literal
			// receiver into the arm below and change a verdict this port has no case for. Reading the
			// lookahead alone makes the split CONSERVATIVE by construction: every token followed by `.`
			// keeps the exact sentence it had before this arm existed, and only tokens that are not
			// move.
			//
			// That is why this arm keeps E2015 while the one below does not. Both refusals are in force,
			// but only this one is PROVISIONAL: it stands until the ownership rules decide what a discarded
			// box or an unclaimed borrow costs, so "a shape the compiler does not lower HERE YET" is literally
			// what E2015 means for it — where the arm below is refused permanently, which E2015 cannot say.
			// Three specs pin this sentence
			// (`first-class-functions`, `managed-memory-methods`, `self-type-member-expression`) and its
			// category-not-text wording is theirs, not this port's.
			let memberTok = self.current()

			// ⭐ **A BASE THAT NAMES NOTHING IS A DEFECT IN THE NAME, NOT IN THE STATEMENT.** `arr.reserve(8)`
			// after the arm holding `var arr` has closed spells a name with no binding anywhere, and E2015's
			// sentence — a shape this compiler does not lower yet — is false of it: no relaxation makes an
			// undefined name legal. It takes `undefinedVariable`, the SAME refusal an expression-position read
			// of that name takes, from the same producer. `baseNamesNothingAt` decides it, and every base that
			// names something real still reaches the refusal below.
			if self.baseNamesNothingAt(self.pos) 'undefinedBase'
				throw SourceParseError.undefinedVariable(String.from(memberTok.value), line: memberTok.line, column: memberTok.column)
			end 'undefinedBase'

			throw SourceParseError.unsupported("{memberTok.kind.rawValue} statement", line: memberTok.line, column: memberTok.column)
		end 'memberExprStmt' else 'refusedOnSight'
			panic("parseStatement: '{form}' is refused on sight by `readStatementOpening`, which every caller asks before this dispatch")
		end 'refusedOnSight'

		self.settleLateReads(lateFloor)
		try self.requireSendSettled()
		try self.requireNoPendingCapability(stmtTok)

		// Drop the statement's unconsumed owned temporaries. `print("{x}")` created an interpolation
		// result `print` only borrowed, so this statement owns it and it dies here; a binding has already
		// taken its result out (`parseBinding` cleared it).
		//
		// Guarded on the block not being terminated: a release emitted after a terminator lands in the
		// next block the parser opens, where the temporary's definitions need not dominate, and a decref
		// of an uninitialized slot on a path that never built it is a wrong program, not merely a leak.
		// See `drainPendingTemps`' region list.
		//
		// So every terminating statement that carries an expression drains its own temporaries before its
		// terminator. This list is the whole argument, so keep it complete:
		//   • `return wrap("v{x}")` — `parseReturnStatement` → `emitHandoffExit`, ahead of the `ret`.
		//   • `throw E.p(len("v{x}"))` — `emitThrowError` → the same routine, ahead of the `throwError`.
		//   • `panic("v{x}")` — `parsePanicStatement`, ahead of the abort op, from the statement's own
		//     floor (a match arm's scrutinee temporary sits below it and must survive) and with no scope
		//     drops, control never leaving `mrt_panic`.
		//   • `abort("v{x}")` where `abort` never returns, `try fail("v{x}")` where `fail` only
		//     throws, and a bare `fail("v{x}")` a test body's implied handler takes —
		//     `endBlockAfterUnreachableTail`, on `panic`'s terms.
		//   • `break`/`continue` — nothing to drain: they carry no expression, so they build no temporary.
		//
		// The `count() > 0` half keeps a statement that built no temporary from paying anything:
		// `drainPendingTemps` reallocates the list, so calling it per statement would be one allocation
		// on every line of the whole compiler.
		if not self.bodyState.currentBlock.isTerminated() and self.bodyState.pendingTempDrops.count() > 0 'dropTemps'
			self.drainPendingTemps(WholeStatementTempFloor, anchor: stmtTok)
		end 'dropTemps'

		return self.bodyState.currentBlock
	end 'parseStatementBody'

	function parenthesizedCallStatementAt(open ElementIndex) returns bool
		if self.kindAt(open) != TokenKind.leftParen 'notAGroup'
			return false
		end 'notAGroup'

		var at = self.parenGroups.closeOf(self.tokens, open: open) + 1
		var endsInACall = false

		while self.kindAt(at) == TokenKind.dot 'eachHop'
			at = at + TokensPerQualifierSegment
			endsInACall = self.kindAt(at) == TokenKind.leftParen

			if endsInACall 'aCallHop'
				at = self.parenGroups.closeOf(self.tokens, open: at) + 1
			end 'aCallHop'
		end 'eachHop'

		return endsInACall
	end 'parenthesizedCallStatementAt'

	// Tested in `parseStatement`'s arm order, and the comments on those arms argue that order: a
	// form tested earlier claims every statement a later one would also match.
	function statementFormAt(chain ChainResolution) returns StatementForm
		if self.at(TokenKind.return) 'ret'
			return StatementForm.ret
		end 'ret'

		if bindingKeywordSpells(self.current().kind) 'bindingDecl'
			return StatementForm.bindingDecl
		end 'bindingDecl'

		if self.at(TokenKind.at) 'annotatedDecl'
			return StatementForm.annotatedDecl
		end 'annotatedDecl'

		if self.at(TokenKind.if) 'ifStmt'
			return StatementForm.ifStmt
		end 'ifStmt'

		if self.at(TokenKind.while) 'whileStmt'
			return StatementForm.whileStmt
		end 'whileStmt'

		if self.at(TokenKind.for) 'forStmt'
			return StatementForm.forStmt
		end 'forStmt'

		if self.at(TokenKind.modify) 'modifyStmt'
			return StatementForm.modifyStmt
		end 'modifyStmt'

		if self.at(TokenKind.acquire) 'acquireStmt'
			return StatementForm.acquireStmt
		end 'acquireStmt'

		if self.at(TokenKind.match) 'matchStmt'
			return StatementForm.matchStmt
		end 'matchStmt'

		if self.at(TokenKind.break) 'breakStmt'
			return StatementForm.breakStmt
		end 'breakStmt'

		if self.at(TokenKind.continue) 'continueStmt'
			return StatementForm.continueStmt
		end 'continueStmt'

		if self.at(TokenKind.throw) 'throwStmt'
			return StatementForm.throwStmt
		end 'throwStmt'

		if self.at(TokenKind.try) 'tryStmt'
			return StatementForm.tryStmt
		end 'tryStmt'

		if self.at(TokenKind.panic) 'panicStmt'
			return StatementForm.panicStmt
		end 'panicStmt'

		if self.at(TokenKind.await) 'awaitStmt'
			return StatementForm.awaitStmt
		end 'awaitStmt'

		if destructStatementAt(self.tokens, index: self.pos) 'destructStmt'
			return StatementForm.destructStmt
		end 'destructStmt'

		if tupleAssignEqualsIn(self.tokens, open: self.pos) != self.pos 'tupleAssign'
			return StatementForm.tupleAssign
		end 'tupleAssign'

		if self.parenthesizedCallStatementAt(self.pos) 'parenthesizedCallStmt'
			return StatementForm.parenthesizedCallStmt
		end 'parenthesizedCallStmt'

		if self.assignsAt(self.pos) 'assign'
			return StatementForm.assign
		end 'assign'

		if self.selfFieldAssignsAt(self.pos) 'selfFieldAssign'
			return StatementForm.selfFieldAssign
		end 'selfFieldAssign'

		if self.staticMemberAssignsAt(self.pos) 'staticMemberAssign'
			return StatementForm.staticMemberAssign
		end 'staticMemberAssign'

		if self.staticStoreRefusedAt(self.pos) 'refusedStaticStore'
			return StatementForm.refusedStaticStore
		end 'refusedStaticStore'

		if self.fieldAssignsAt(self.pos) 'fieldAssign'
			return StatementForm.fieldAssign
		end 'fieldAssign'

		if self.methodCallsAt(self.pos) or self.arrayManagedMemberCallAt(self.pos) 'methodCallStmt'
			return StatementForm.methodCallStmt
		end 'methodCallStmt'

		if self.fieldChainMethodCallAt(self.pos) 'fieldChainMethodStmt'
			return StatementForm.fieldChainMethodStmt
		end 'fieldChainMethodStmt'

		if self.staticMemberCallsAt(self.pos) 'staticMemberCallStmt'
			return StatementForm.staticMemberCallStmt
		end 'staticMemberCallStmt'

		if self.qualifiedStaticCallsAt(self.pos) 'qualifiedStaticCallStmt'
			return StatementForm.qualifiedStaticCallStmt
		end 'qualifiedStaticCallStmt'

		if self.chainIsADirectoryQualifiedCall(chain) 'namespaceQualifiedCallStmt'
			return StatementForm.namespaceQualifiedCallStmt
		end 'namespaceQualifiedCallStmt'

		if self.chainHeadsAValue(chain) and self.chainCallFollowsAt(self.pos) 'valueHeadedCallStmt'
			return StatementForm.valueHeadedCallStmt
		end 'valueHeadedCallStmt'

		if self.atSpawnPrefix() 'spawnStmt'
			return StatementForm.spawnStmt
		end 'spawnStmt'

		if self.at(TokenKind.identifier) and self.peekKind() == TokenKind.leftParen 'callStmt'
			return StatementForm.callStmt
		end 'callStmt'

		if self.peekKind() == TokenKind.dot 'memberExprStmt'
			return StatementForm.memberExprStmt
		end 'memberExprStmt'

		return StatementForm.strayStatementToken
	end 'statementFormAt'

	// The order of these refusals decides which error a line earns, and `specs/if-statements.md` pins
	// it: a statement's position (E3071) is judged before its content (E3067). A token sharing a line
	// is asked with `entersItsChain: false`, because entering a chain can refuse a name past that
	// token, which would beat the line's E2001.
	function readStatementOpening(preceding PrecedingTerminator, entersItsChain bool) returns StatementHead throws SourceParseError
		let opening = self.current()
		try self.refuseStrayOtherwise()
		try self.refuseUnreachableStatement(preceding, at: opening)

		// E3067, before the dispatch and before any op is emitted: this statement's TOKENS may already say
		// it does nothing. See `rejectDegenerateAssignment` for the rule and for what it deliberately lets
		// through — it is asked here, once, rather than by each of the three assignment arms it spans.
		try self.rejectDegenerateAssignment(self.pos)

		// Before every arm: a chain naming a declared type leaves the cursor on that type's token, so each arm
		// reads `sub.Calc.ping()` as it reads `Calc.ping()`.
		let chain = self.resolveQualifiedChainAtCursor(MethodQualifierDots)

		if entersItsChain 'entersItsChain'
			try self.enterResolvedChain(chain)
		end 'entersItsChain'

		let form = self.statementFormAt(chain)
		try self.refuseStatementOnSight(form)
		return StatementHead.create(opening, chain: chain, form: form)
	end 'readStatementOpening'

	// An `otherwise` with no `try` to attach to (`let v = f() otherwise 0`). Reaches here as a
	// statement starter after the preceding expression completed. Renders as E3058.
	function refuseStrayOtherwise() throws SourceParseError
		if not self.at(TokenKind.otherwise) 'noStrayOtherwise'
			return
		end 'noStrayOtherwise'

		let otherwiseTok = self.current()
		throw SourceParseError.otherwiseWithoutTry(otherwiseTok.line, column: otherwiseTok.column)
	end 'refuseStrayOtherwise'

	// A bare `foo` on a line of its own, a `retur x` typo, a `test` that meant `test()`. Every form
	// `statementFormAt` tests has declined the token and it opens no construct of its own — and no
	// future feature makes any of these legal, which is the one verdict E2015 ("a construct this
	// compiler does not implement yet") cannot carry. E2001 is the code the registry already claims
	// for a token the grammar has no position for. Same fault and same fix as `dispatchTopLevel`'s
	// fall-through one scope up, and the same second defect to avoid with it: `tok.kind.rawValue` is
	// the token's CATEGORY, which is not a string any reader can search the file
	// for. `tokenDisplayText` is the one reader that resolves a token's text — see its definition
	// (`Lexer.maxon`) for why reading `.value` directly is not the same thing.
	function refuseStatementOnSight(form StatementForm) throws SourceParseError
		if statementFormRole(form) != StatementRole.refusedOnSight 'opensAStatement'
			return
		end 'opensAStatement'

		let tok = self.current()
		throw SourceParseError.strayToken(tokenDisplayText(tok), line: tok.line, column: tok.column)
	end 'refuseStatementOnSight'

	function refuseArmAfterDefault(sawDefault bool) throws SourceParseError
		if not sawDefault 'noDefaultYet'
			return
		end 'noDefaultYet'

		let strayTok = self.current()
		throw SourceParseError.matchDefaultNotLast(strayTok.line, column: strayTok.column)
	end 'refuseArmAfterDefault'

	function refuseUnreachableStatement(preceding PrecedingTerminator, at Token) throws SourceParseError
		match preceding 'dead'
			none then return
			keyword(name) then throw SourceParseError.unreachableCode(String.from(name), line: at.line, column: at.column)
		end 'dead'
	end 'refuseUnreachableStatement'

	// ⭐⭐ **`@heap let p = Point.create(1, y: 2)` — THE HEAP ANNOTATION (`specs/ownership.md`), WHICH
	// THE COMPILER ACCEPTS, VALIDATES, AND THEN LOWERS AS A PLAIN BINDING.** It asks the compiler to
	// heap-allocate the decorated local instead of promoting it to the stack — a request the compiler has
	// nothing to do about, because **every struct in the compiler IS a heap box** (`Self{…}` emits an
	// `__mm_alloc`; see `valueIsNonTextAggregate`) and there is no stack-promotion pass to opt out of.
	// So the annotation is honoured by construction, and the no-op lowering is honest rather than merely
	// sufficient.
	//
	// ⚠ **WHAT IS NOT A NO-OP IS THE VALIDATION.** An unrecognized annotation, an `@heap` decorating something
	// that is not a binding and an `@heap` on a value that owns no heap are all refused — see
	// the three `SourceParseError` arms. Accepting the token and ignoring what
	// follows it would make `@hepa let x = 5` a silently-honoured typo.
	function parseAnnotatedBinding(func IrFunction, block IrBlock) throws SourceParseError
		let atTok = try self.consume(TokenKind.at)

		let annotationTok = self.current()

		if annotationTok.kind != TokenKind.identifier or not annotationTok.value.equals(HeapAnnotationName) 'unknownAnnotation'
			throw SourceParseError.unknownAnnotation(tokenDisplayText(annotationTok), line: atTok.line, column: atTok.column)
		end 'unknownAnnotation'

		try self.consume(TokenKind.identifier)

		if not self.at(TokenKind.var) and not self.at(TokenKind.let) 'notABinding'
			throw SourceParseError.heapAnnotationWithoutBinding(atTok.line, column: atTok.column)
		end 'notABinding'

		try self.parseBinding(func, block: block, kind: bindingKindOfKeyword(self.current().kind), heapAnnotated: true)
	end 'parseAnnotatedBinding'

	// Parse a `let`/`var` binding: `let <name> = <expr>`. A type
	// annotation is rejected: a `:` after the name makes the `=` consume fail with E2010
	// (`Expected '=' but got ':'`), which IS the `variables.md` type-annotation
	// contract, so no explicit `:` check is needed. The initializer's SSA value is
	// bound to the name in the scope, so a later reference resolves straight to it
	// (no slot, no load/store — see Scope.declareValueBinding). `kind`
	// distinguishes `var` and `let`: only a `var` may be reassigned, and only a `var`
	// carries a loop-carried phi.
	//
	// The binding lands in the INNERMOST open scope frame, so a declaration inside an
	// `if`/`while` body is gone at its `end` — and may legally SHADOW an outer binding
	// of the same name while it lives (specs/block-scoping.md).
	// The binding takes the initializer's INFERRED type, not a hardcoded `integer`: `let flag = a > b` binds a
	// `bool`, and `flag and other` short-circuits only if the parser knows so.
	//
	// `heapAnnotated` is true only for the `@heap` spelling (`parseAnnotatedBinding` above), and its whole
	// effect is the refusal below — the annotation changes no IR.
	function parseBinding(func IrFunction, block IrBlock, kind BindingKind, heapAnnotated bool) throws SourceParseError
		let keywordTok = self.current()
		let mutable = kind == BindingKind.var

		try self.consume(keywordTok.kind)

		// ⭐ **`let (x, y) = <a tuple>` — DESTRUCTURING.** Recognized by the `(` where a name belongs:
		// no other binding form opens with one, so the two grammars are disjoint at the first token.
		//
		// `@heap` owes this path no check: a destructuring initializer must BE a tuple
		// (`requireDestructurableTuple`), a tuple is a heap record, so the annotation is satisfied by
		// construction and the refusal below could never fire here.
		if self.at(TokenKind.leftParen) 'destructure'
			try self.parseDestructuringBinding(func, block: block, kind: kind, keywordTok: keywordTok)
			return
		end 'destructure'

		let nameTok = try self.consume(TokenKind.identifier)
		try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
		try self.consume(TokenKind.equals)
		let rhsStart = self.pos
		let value = try self.parseBindingInitializer(func, block: block, kind: kind)

		try self.requireNoUniqueAlias(value, action: "bind '{String.from(nameTok.value)}' to", anchor: nameTok)
		try self.settleBindingCapability(value, rhsStart: rhsStart, nameTok: nameTok)

		try self.requireVarNotBornFromABareNumber(value, kind: kind, anchor: self.tokenAt(rhsStart))
		try self.requireLetNotBornFromAnUnboundedNumber(value, kind: kind, anchor: self.tokenAt(rhsStart))

		// ⭐ **`@heap` ON A VALUE THAT OWNS NO HEAP IS REFUSED** — the annotation asks for a box, and for
		// an `int` there is none to force. See the `heapAnnotationOnNonRecord` union arm for why the
		// admissible set is `valueIsManagedHeap`'s rather than the narrower "struct literals".
		if heapAnnotated and not self.valueIsManagedHeap(value) 'annotatedNonRecord'
			throw SourceParseError.heapAnnotationOnNonRecord(String.from(nameTok.value), tag: self.valueKindWord(value), line: nameTok.line, column: nameTok.column)
		end 'annotatedNonRecord'

		// WHOSE storage did the initializer reach into — `let u = t` (the binding itself) or `let u = t.x`
		// (a field of it) — and empty for every other RHS, which mints a fresh value owned by nobody.
		// Captured here, off the token position, so the move poison does not run on a consume
		// (see `rhsRootLocalName`).
		let sourceName = self.rhsRootLocalName(rhsStart)
		let sourceReadsAField = self.rhsSpanReadsAField(rhsStart)

		if not mutable 'anImmutableTuple'
			self.freezeLiteralTuple(value)
		end 'anImmutableTuple'

		try self.declareInitializedBinding(nameTok, value: value, sourceName: sourceName, sourceReadsAField: sourceReadsAField, kind: kind)

		self.noteBodyBindingDeclared(nameTok, kind: kind, boundFromContainerLiteral: self.rhsIsAContainerLiteral(rhsStart))

		if kind == BindingKind.let 'aConstantCandidate'
			self.registerLetCast(nameTok, initializer: value, first: rhsStart)
		end 'aConstantCandidate'
	end 'parseBinding'

	function parseBindingInitializer(func IrFunction, block IrBlock, kind BindingKind) returns ValueId throws SourceParseError
		let initializerStart = self.pos
		self.bodyState.imagedLetInitializerStart = initializerStart if kind == BindingKind.let else NoImagedLetInitializer
		let value = try self.parseExpression(func, block: block)
		self.bodyState.imagedLetInitializerStart = NoImagedLetInitializer
		try self.requireByReferenceIsolatedStaysPut(func, value: value, at: self.tokenAt(initializerStart))
		return value
	end 'parseBindingInitializer'

	function recordVarBirthSite(value ValueId, anchor Token)
		let tag = self.tagOf(value)

		if tag != ValueTypeTag.named and not (tagIsFloat(tag) and self.valueNameId(value) != UnnamedTypeId) 'namesNoAlias'
			return
		end 'namesNoAlias'

		self.recordRangeCheckSite(value, destination: self.valueSlotType(value), line: anchor.line, column: anchor.column)
	end 'recordVarBirthSite'

	function requireVarNotBornFromABareNumber(value ValueId, kind BindingKind, anchor Token) throws SourceParseError
		if kind == BindingKind.var and self.valueIsABareNumber(value) 'aBareNumberVar'
			throw SourceParseError.varStartsFromBareNumber(anchor.line, column: anchor.column)
		end 'aBareNumberVar'
	end 'requireVarNotBornFromABareNumber'

	function forgetLiteralColumns(value ValueId)
		match self.bodyState.literalColumns 'state'
			unwritten then return
			entries(filed) then _ = filed.remove(value)
		end 'state'
	end 'forgetLiteralColumns'

	function requireLetNotBornFromAnUnboundedNumber(value ValueId, kind BindingKind, anchor Token) throws SourceParseError
		if kind != BindingKind.var and self.valueIsAnUnboundedPlainNumber(value) 'anUnboundedNumberLet'
			throw SourceParseError.letStartsFromUnboundedNumber(anchor.line, column: anchor.column)
		end 'anUnboundedNumberLet'
	end 'requireLetNotBornFromAnUnboundedNumber'

	function valueIsAnUnboundedPlainNumber(value ValueId) returns bool
		if self.valueNameId(value) != UnnamedTypeId 'aNamedValue'
			return false
		end 'aNamedValue'

		let tag = self.tagOf(value)

		if tag == ValueTypeTag.float 'aFloat'
			return not self.floatConstIsKnown(value) and not self.valueHasFloatRange(value)
		end 'aFloat'

		return tag == ValueTypeTag.integer and not self.constIsKnown(value) and not valueIsMarked(self.bodyState.literalCounters, value: value) and not valueIsMarked(self.bodyState.undecidedMerges, value: value) and not self.valueHasProvenIntRange(value)
	end 'valueIsAnUnboundedPlainNumber'

	function valueHasProvenIntRange(value ValueId) returns bool
		return match self.bodyState.countedValueRanges 'column'
			unwritten gives false
			entries(proven) gives proven.contains(value)
		end 'column'
	end 'valueHasProvenIntRange'

	function valueIsABareNumber(value ValueId) returns bool
		let tag = self.tagOf(value)

		if tag == ValueTypeTag.genericInstance 'aContainer'
			return self.instanceHoldsBareNumbers(self.valueInstanceId(value))
		end 'aContainer'

		if tag == ValueTypeTag.structRef and self.valueTypeNameIsATuple(value) 'aTuple'
			return self.tupleHoldsBareNumbers(self.valueTypeName(value))
		end 'aTuple'

		return self.valueIsAPlainNumber(value)
	end 'valueIsABareNumber'

	function instanceHoldsBareNumbers(instance GenericInstanceId) returns bool
		if self.signatures.isMapShapedInstanceAt(ValueTypeTag.genericInstance, nameId: instance as TypeNameId) 'aMap'
			return typeIsABareNumber(self.signatures.mapKeyType(instance)) or typeIsABareNumber(self.signatures.mapValueType(instance))
		end 'aMap'

		return self.arrayInstanceHoldsBareNumbers(instance)
	end 'instanceHoldsBareNumbers'

	function tupleHoldsBareNumbers(name ByteArray) returns bool
		for declared in self.registeredTupleLayout(name).fieldTypes 'eachField'
			if typeIsABareNumber(declared) 'aBareField'
				return true
			end 'aBareField'
		end 'eachField'

		return false
	end 'tupleHoldsBareNumbers'

	function valueIsAnAliasedNumber(value ValueId) returns bool
		return not self.valueIsDeferred(value) and typeClassAdmits(TypeClass.numeric, tag: self.tagOf(value)) and not self.valueIsAPlainNumber(value)
	end 'valueIsAnAliasedNumber'

	function valueIsAPlainNumber(value ValueId) returns bool
		let tag = self.tagOf(value)
		return (tag == ValueTypeTag.integer or tag == ValueTypeTag.float) and self.valueNameId(value) == UnnamedTypeId
	end 'valueIsAPlainNumber'

	function arrayInstanceHoldsBareNumbers(instance GenericInstanceId) returns bool
		if not self.signatures.isArrayInstance(instance) 'notAnArray'
			return false
		end 'notAnArray'

		return typeIsABareNumber(self.signatures.containerElementType(instance))
	end 'arrayInstanceHoldsBareNumbers'

	// ⭐ **IS `value` NO RECORD A WRITE CAN REACH?** A scalar, a payload-free enum and a function value are no record,
	// and a string literal is an immortal one every door copies before anything writes it. An opaque `T` may be a
	// record.
	function valueIsNoRecordAWriteReaches(value ValueId) returns bool
		return not self.valueMayNameARecord(value) or self.valueIsAMintedStringLiteral(value) or typeIsPromiseStorage(self.signatures, t: self.typeOf(value))
	end 'valueIsNoRecordAWriteReaches'

	function valueHoldsNoWritableRecordWithin(value ValueId) returns bool
		if self.tagOf(value) == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.recordKindsWithinInstance(self.valueInstanceId(value)).holdsNoWritableRecord(self.kindWritability)
		end 'anInstance'

		if not self.signatures.tagMayNameAggregate(self.tagOf(value)) 'anyOtherKind'
			return false
		end 'anyOtherKind'

		return self.signatures.recordKindsWithinAggregate(self.valueTypeName(value)).holdsNoWritableRecord(self.kindWritability)
	end 'valueHoldsNoWritableRecordWithin'

	export function forgetKindVerdicts()
		self.kindWritability = RecordKindWritability.of(self.signatures)
	end 'forgetKindVerdicts'

	function valueMayNameARecord(value ValueId) returns bool
		return self.valueIsManagedHeap(value) or self.tagOf(value) == ValueTypeTag.typeParameter
	end 'valueMayNameARecord'

	// ⭐ **CAN NO MUTABLE DOOR ASK ABOUT `value`?** When it is no record a write reaches, or when it IS an immutable
	// record (`valueIsAnImmutableAggregate`), which nothing writes. Handing either over moves nothing.
	function recordNeverMeetsADoor(value ValueId) returns bool
		return self.valueIsNoRecordAWriteReaches(value) or self.valueIsAnImmutableAggregate(value)
	end 'recordNeverMeetsADoor'

	function valueIsAnImmutableAggregate(value ValueId) returns bool
		return self.kindWritability.namesAnImmutableAggregate(self.tagOf(value), nameId: self.valueNameId(value), from: self.artifact.typeNames)
	end 'valueIsAnImmutableAggregate'

	// A read out of an overwritable slot or an element is held whatever its root: a parameter root keeps
	// the box alive, not the field's occupant, so a later store to that field frees what this binding names.
	function bindingHoldsAStorageRead(value ValueId, boundValue ValueId, sourceReadsAField bool, sourceName SourceBinding) returns bool
		if self.valueIsOwnedHeap(boundValue) or self.valueNeedsNoHold(value) 'nothingToHold'
			return false
		end 'nothingToHold'

		if not self.valueIsManagedHeap(value) and self.tagOf(value) != ValueTypeTag.typeParameter 'ownsNoHeap'
			return false
		end 'ownsNoHeap'

		return self.valueIsAStorageRead(value) or (sourceReadsAField and self.fieldReadRootIsRebindable(sourceName))
	end 'bindingHoldsAStorageRead'

	function holdBindingRead(value ValueId, name ByteArray, range SourceRange) returns ValueId
		if self.valueNeedsNoHold(value) 'nothingToHold'
			return value
		end 'nothingToHold'

		let held = self.emitHoldMarker(value, kind: HoldKind.binding, range: range)

		if self.holdReplacesItsSource(value) 'theBindingNamesTheReference'
			self.noteReadHeldByABinding(value)
			return held
		end 'theBindingNamesTheReference'

		self.enrolHeldRead(value, held: held, name: name)
		return value
	end 'holdBindingRead'

	function holdReplacesItsSource(value ValueId) returns bool
		let tag = self.tagOf(value)
		return tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef
	end 'holdReplacesItsSource'

	function enrolHeldRead(value ValueId, held ValueId, name ByteArray)
		self.enrolOwnedBinding(VarInfo.createValueBinding(name, varType: self.typeOf(held), kind: BindingKind.let, boundValue: held))
		self.noteReadHeldByABinding(value)
	end 'enrolHeldRead'

	function noteReadHeldByABinding(value ValueId)
		unmarkValue(self.bodyState.elementReads, value: value)
		self.noteReadHeld(value)
	end 'noteReadHeldByABinding'

	function noteReadHeld(value ValueId)
		self.bodyState.heldReads = withValueMarked(self.bodyState.heldReads, value: value)
	end 'noteReadHeld'

	function readIsHeld(value ValueId) returns bool
		return valueIsMarked(self.bodyState.heldReads, value: value)
	end 'readIsHeld'

	function holdIsOwed(value ValueId) returns bool
		if self.valueNeedsNoHold(value) or self.valueIsOwnedHeap(value) or self.readIsHeld(value) 'nothingToHold'
			return false
		end 'nothingToHold'

		return self.valueMayNameARecord(value)
	end 'holdIsOwed'

	function emitHoldMarker(source ValueId, kind HoldKind, range SourceRange) returns ValueId
		let (held, holdOp) = self.openHold(source, kind: kind, range: range)
		self.emitBodyOp(self.bodyState.currentBlock, op: holdOp, range: range)
		return held
	end 'emitHoldMarker'

	function openHold(source ValueId, kind HoldKind, range SourceRange) returns (ValueId, MaxonOp)
		let plan = self.holdRetainPlan(source, range: range)
		let held = self.mintValue(self.tagOf(source), nameId: self.valueNameId(source))

		if kind != HoldKind.loopSource 'aSecondOwner'
			self.markValueCoOwnsHeap(source)
		end 'aSecondOwner'

		self.markValueOwnsHeap(held, exclusivity: OwnedHeapExclusivity.coOwned)
		self.carryInterfaceWitness(held, from: source)
		self.carryFromSharedRecord(held, from: source, source: self.bodyState, path: ValueCarryPath.value)
		self.holdKindsForWrite().upsert(held, value: kind)
		self.carryHeldRegionFacts(held, source: source)
		return (held, MaxonOp.holdValue(held, held: source, callee: plan.callee, args: plan.args, kind: kind))
	end 'openHold'

	function carryHeldRegionFacts(held ValueId, source ValueId)
		let capability = self.capabilityOfValue(source)

		if capabilityIsReadOnly(capability) 'readOnlyData'
			self.setValueCapability(held, capability: capability)
		end 'readOnlyData'

		self.carryParamSources(held, source: source)
	end 'carryHeldRegionFacts'

	function carryParamSources(target ValueId, source ValueId)
		let sources = self.paramSourcesOf(self.bodyFunction(), value: source)

		if sources != NoParamPositions 'aParametersData'
			self.regionFactsForWrite().paramSources.carry(target, source: source, sources: sources)
		end 'aParametersData'
	end 'carryParamSources'

	function holdRetainPlan(source ValueId, range SourceRange) returns HoldRetainPlan
		let tag = self.tagOf(source)

		if tag == ValueTypeTag.typeParameter 'anOpaqueRecord'
			return HoldRetainPlan.create(RetainTypeParamName, args: argsOf(source))
		end 'anOpaqueRecord'

		if tagIsByteRecord(tag) 'aByteRecord'
			return HoldRetainPlan.create(StrRetainName, args: argsOf(source))
		end 'aByteRecord'

		if tag == ValueTypeTag.interfaceRef 'anExistential'
			return HoldRetainPlan.create(RetainExistentialName, args: twoArgs(self.witnessOfValue(source), second: source))
		end 'anExistential'

		if self.valueIsAnImageableDeepBox(source) 'aBoxWithPointerSlots'
			return HoldRetainPlan.create(MmOwnDeepName, args: twoArgs(source, second: self.emitCodeAddress(self.deepBoxCloneCallee(source), range: range)))
		end 'aBoxWithPointerSlots'

		return HoldRetainPlan.create(self.signatures.retainCalleeOf(tag, nameId: self.valueNameId(source), from: self.artifact.typeNames, result: RetainResult.freshName, readerFilePath: self.job.path), args: argsOf(source))
	end 'holdRetainPlan'

	function holdKindsForWrite() returns HoldKindMap
		match self.bodyState.holdKinds 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = HoldKindMap.create()
		self.bodyState.holdKinds = HoldKindColumn.entries(fresh)
		return fresh
	end 'holdKindsForWrite'

	function holdKindOf(value ValueId) returns HoldKindLookup
		match self.bodyState.holdKinds 'state'
			unwritten then return HoldKindLookup.none
			entries(table) then return HoldKindLookup.found(try table.get(value) otherwise return HoldKindLookup.none)
		end 'state'
	end 'holdKindOf'

	function emitHoldEnd(held ValueId, kind HoldKind, callee ByteArray, args ValueIdArray, range SourceRange)
		let result = self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.holdEnd(result, held: held, callee: callee, args: args, kind: kind), range: range)
	end 'emitHoldEnd'

	function fieldReadRootIsRebindable(root SourceBinding) returns bool
		let rootName = try root.localName() otherwise return false
		let rootBinding = self.bodyState.scope.getInfo(rootName)

		if rootBinding.isParameter and not rootBinding.isCellBinding 'heldByTheCaller'
			return false
		end 'heldByTheCaller'

		return rootBinding.isMutable() or not rootBinding.isSelfField
	end 'fieldReadRootIsRebindable'

	// ⭐ **E3077 / E3012 CANDIDATE: A BODY `var` THE AUTHOR WROTE.** Enrolled at this door and the destructuring
	// ELEMENT: `declareInitializedBinding`'s third caller declares the destructuring TEMP, a name the compiler
	// mints, and no diagnostic telling an author what to change may name it.
	//
	// ⚠ A body `let` IS enrolled since the 2026-08-19 ruling — see `UnusedBindingKind.mutableLocal` for the
	// blocker that stood here and the IR measurement that refuted it.
	//
	// ⭐ `_` is the discard and is exempt, exactly as it is in a `for` header (`declareLoopVariable`).
	// It binds a name the source never intends to read.
	//
	// The binding is read back out of the scope rather than threaded out of the declaration: the declaration
	// door has more callers than this rule has candidates, so a return value would make the others carry a
	// binding nothing reads.
	//
	// ⚠ **THE ENROLMENT DOORS ARE NARROWER THAN THE DECLARATION DOORS, and the third one is not the temp.**
	// `parseBoundThenBody` declares `if var x = try f()`'s binding through `declareInitializedBinding`
	// directly, so a bound-then `var` is a candidate for NEITHER rule. That is the safe direction — a missed
	// diagnostic, never a refused program — and it is written down here because "two doors" reads like an
	// exhaustive claim otherwise.
	function noteBodyBindingDeclared(nameTok Token, kind BindingKind, boundFromContainerLiteral bool)
		if nameTok.value.equals(DiscardBindingName) 'notACandidateName'
			return
		end 'notACandidateName'

		let unusedKind = UnusedBindingKind.mutableLocal if kind == BindingKind.var else UnusedBindingKind.immutableLocal
		self.bodyState.unusedCandidates.push(UnusedBindingCandidate.create(self.bodyState.scope.getInfo(nameTok.value), nameRange: SourceRange.ofToken(nameTok), kind: unusedKind, declToken: self.pos, boundFromContainerLiteral: boundFromContainerLiteral))
	end 'noteBodyBindingDeclared'

	function rhsIsAContainerLiteral(rhsStart ElementIndex) returns bool
		return self.kindAt(rhsStart) == TokenKind.leftBracket or (self.kindAt(rhsStart + 1) == TokenKind.from and self.kindAt(rhsStart + 2) == TokenKind.leftBracket)
	end 'rhsIsAContainerLiteral'

	function bindsAnUndecidedBorrowedResult(value ValueId) returns bool
		return self.valueSettlesAfterParsing(value) and self.effectiveCapabilityOf(value) != ValueCapability.immutable
	end 'bindsAnUndecidedBorrowedResult'

	function sourceRootIsAnImmutableName(sourceName SourceBinding) returns bool
		let name = try sourceName.localName() otherwise return false
		let root = self.bodyState.scope.getInfo(name)

		return not (root.isMutable() or root.isParameter or root.isCellBinding or root.isSelfField) or self.regionFactsForRead().cellRefusedRoots.contains(root.boundValue)
	end 'sourceRootIsAnImmutableName'

	// ⭐ **BIND ONE NAME TO ONE ALREADY-PARSED INITIALIZER — the whole declaration half of a `let`/`var`.**
	// Shared with destructuring: `let (x, y) = t` declares N names from
	// N field loads and every one of them owes exactly what a single binding owes — the borrowed-managed
	// promotion, the self-field shadow check, the mutable-var enrolment, the
	// owned/promise enrolment and the move-on-bind poison. A second copy of that list is not a duplication
	// risk in the abstract; it is the concrete way a destructured `String` element comes to be dropped twice
	// or not at all.
	function declareInitializedBinding(nameTok Token, value ValueId, sourceName SourceBinding, sourceReadsAField bool, kind BindingKind) throws SourceParseError
		let mutable = kind == BindingKind.var

		try self.requireNoManagedValueInRuntimeSource(nameTok.value, value: value, line: nameTok.line, column: nameTok.column)
		self.shedOperandAliasSet(value)

		if mutable 'aVarIsBornThroughARangeDoor'
			self.recordVarBirthSite(value, anchor: nameTok)
		end 'aVarIsBornThroughARangeDoor'

		// A bare read of a local is the only initializer that can MOVE an owned value out of an existing
		// binding — a field read of one mints a fresh borrowed pointer that is the value of no binding.
		let rhsWasBareLocal = sourceName.isLocal() and not sourceReadsAField

		// ⭐ **A MUTABLE BORROWED MANAGED BINDING IS PROMOTED TO OWNED AT ITS DECLARATION.** A `var` whose
		// initializer is a BORROWED managed value (a `"literal"` rdata String, or a struct/union PARAMETER —
		// both hold a managed tag yet own nothing) is made to own a droppable value here, at ITS OWN scope:
		//
		//   • a String COPIES into a writable owned heap record — `var s = "hi"` binds an immortal READ-ONLY
		//     rdata record `s.append(…)` cannot grow in place, so it is copied (value semantics).
		//   • a struct/union INCREFS the shared box — an aggregate has no cheap owning copy and its
		//     alias is observable (`q.x = 100` must show through to the caller), so it stays the SAME box with
		//     one more owner (reference semantics).
		//
		// Promoting at the DECLARATION is what enrols the binding as owned at the depth it is declared. Left
		// borrowed, a later `q = <owned>` inside a NESTED block would be the FIRST thing to make it own a
		// drop, and `reassignBindingValue`'s `borrowedToOwned` would enrol it at the INNER block's depth — so
		// the fresh box would drop at that block's `end` while the binding (declared outer) is read past it: a
		// use-after-free (the String append-in-nested-loop hazard, and its aggregate twin). The
		// retain/copy balances on every path: a reassignment decrefs/drops the promoted value, and an untaken
		// branch leaves the scope-exit drop to reclaim it — net zero, so the caller stays the owner of an
		// aggregate box. An already-OWNED initializer (`var s = "{x}"`, `var p = Point.create(…)`, a move
		// `var q = t`) is left untouched by the `not valueIsOwnedHeap` guard. The promotion makes the binding
		// a fresh CONSUME, not a bare-local move.
		//
		// ⭐⭐ **AND A `let` NEEDS IT TOO WHEN THE VALUE CAME OUT OF A REBINDABLE SLOT.** The `mutable`
		// gate alone rested on "a `let` is never reassigned", which answers the wrong half: the hazard is not
		// this BINDING being rebound, it is the STORAGE the value was read out of being rebound underneath it.
		// A mutable field is exactly that storage, its store drops the old occupant, and the
		// immutable binding then names freed memory — the segfault `Map.grow()`'s four `let old… = <field>`
		// binds hit, where the runnable oracle increfs at the same point and prints the answer. The two gates
		// are ONE question asked of two things — "can the value under this name be dropped while the name is
		// live" — so they share the one promotion door and the one `not valueIsOwnedHeap` guard.
		//
		// ⚠ **THE MARK IS NOT THE AUTHORITY ON WHAT PROMOTION MEANS.** `promoteBorrowedToOwned` keeps that:
		// a String COPIES (an `__mm_retain` of a byte record is the measured wrong cure — an immortal `.rdata`
		// literal admits no incref), an aggregate INCREFS, an existential goes through its witness's
		// `retainFunc@16`. This decides only WHETHER a promotion is owed.
		var boundValue = value
		var boundBareLocal = rhsWasBareLocal

		if (mutable or valueIsMarked(self.bodyState.overwritableSlotReads, value: value) or self.bindsAnUndecidedBorrowedResult(value)) and self.valueIsManagedHeap(value) and not self.valueIsOwnedHeap(value) 'promoteBorrowedBinding'
			boundValue = try self.promoteBorrowedToOwned(value, door: BorrowLaunderDoor.binding, range: SourceRange.ofToken(nameTok))
			boundBareLocal = false
		end 'promoteBorrowedBinding' else if mutable and not rhsWasBareLocal and tagIsByteRecord(self.tagOf(value)) and self.valueIsOwnedHeap(value) and not self.valueIsSoleHeapOwner(value) 'unshareTheBoundRecord'
			boundValue = self.unsharedByteRecord(value, range: SourceRange.ofToken(nameTok))
		end 'unshareTheBoundRecord'

		if (not mutable or self.tagOf(value) == ValueTypeTag.typeParameter) and self.bindingHoldsAStorageRead(value, boundValue: boundValue, sourceReadsAField: sourceReadsAField, sourceName: sourceName) 'holdTheStorageRead'
			let named = self.holdBindingRead(value, name: nameTok.value, range: SourceRange.ofToken(nameTok))

			if named != value 'theBindingNamesTheReference'
				boundValue = named
				boundBareLocal = false
			end 'theBindingNamesTheReference'
		end 'holdTheStorageRead'

		// ⭐ **A `var` TAKING AN IMMUTABLE NAME'S RECORD HOLDS A REFERENCE OF ITS OWN.** The source keeps the drop
		// it owes and this name owns what it took from here.
		if boundBareLocal and self.bindingTakesItsOwnReference(kind, sourceName: sourceName, value: value) and self.valueIsOwnedHeap(value) 'coOwnTheSourceRecord'
			boundValue = self.coOwnImmutableRebindSource(value, range: SourceRange.ofToken(nameTok))
			boundBareLocal = false
		end 'coOwnTheSourceRecord'

		if boundValue != value 'aReboundValue'
			self.carryCapability(value, target: boundValue)
			self.carryImmutableSlotRead(value, target: boundValue)

			if self.capabilityOfValue(boundValue) == ProvisionalForAUse and self.valueSettlesAfterParsing(value) 'readOnlyUntilSettled'
				self.registerRebindAlias(value, target: boundValue)
			end 'readOnlyUntilSettled'
		end 'aReboundValue'

		if not mutable and sourceReadsAField and self.sourceRootIsAnImmutableName(sourceName) 'anAliasOfAnImmutableHolder'
			let table = self.regionFactsForWrite()
			table.cellRefusedRoots.insert(value)
			table.cellRefusedRoots.insert(boundValue)
		end 'anAliasOfAnImmutableHolder'

		if mutable 'aWritableName'
			self.forgetLiteralColumns(boundValue)
		end 'aWritableName'

		// ⭐⭐ **A `var` ANOTHER FRAME MUST BE ABLE TO WRITE LIVES IN A CELL FROM ITS DECLARATION.**
		// Taken here, before the ordinary value binding, because the cell has to dominate every read of the
		// name — there is no later point at which the representation could be changed, since the reads
		// already emitted would be reading an SSA value nobody writes to.
		//
		// ⚠ A `let` never qualifies and the gate is not merely an optimization: an immutable binding cannot
		// be reassigned by its own frame, and passing one to a parameter a callee reassigns is E3207 — so a
		// cell for it would be storage nothing could ever legally write.
		if mutable and self.nameLivesInACell(nameTok.value) 'livesInACell'
			self.requireTheHandOffWalkKeysTheCell(nameTok)
			try self.declareCellLocal(nameTok, boundValue: boundValue, rhsWasBareLocal: boundBareLocal)
			return
		end 'livesInACell'

		// A local taking the name of a field of the enclosing type is E3006, not a shadow — see
		// `Scope.declareValueBinding`. Anchored on the LOCAL's name token: the field is fine, the
		// local is what has to be renamed.
		let binding = try self.bodyState.scope.declareValueBinding(nameTok.value, varType: self.typeOf(boundValue), kind: kind, value: boundValue, brandId: self.brandIdOf(boundValue)) otherwise throw SourceParseError.localShadowsSelfField(String.from(nameTok.value), typeName: String.from(self.enclosingTypeName()), line: nameTok.line, column: nameTok.column)
		self.keyAdoptableLocal(nameTok, kind: kind, value: boundValue)
		self.trackDebugLocal(binding)

		if self.job.recordsEditorFacts 'anEditedDocument'
			self.noteEditorBinding(binding, line: nameTok.line, column: nameTok.column)
		end 'anEditedDocument'

		if mutable 'trackVar'
			// Record `var`s in declaration order so loop headers can mint phis for every
			// mutable binding in scope (on-the-fly SSA). `let`s never join — they
			// cannot be reassigned, so they carry no loop-carried phi.
			self.pushMutableVar(binding)
		end 'trackVar'

		// ⭐ **A BINDING OWNS A DROP IFF ITS VALUE OWNS DROPPABLE HEAP** (`valueIsOwnedHeap` — a struct
		// box, a boxed union, an owned interpolation/promotion String, an adopted call result), so it
		// joins the list every scope exit drops (see `ownedBindings`). `let` and `var` alike: ownership is
		// a property of the VALUE, never the mutability — `var p = Point.create(…)` owns exactly what a
		// `let` one does.
		//
		// It keys on the PROVENANCE BIT, not the type tag, and that is what tells an owned box from a
		// BORROWED one: `let s = "hi"` (an immortal rdata literal) and `let q = a` where `a` is a struct
		// PARAMETER (a borrowed pointer) both hold a struct/String tag yet own nothing — no bit, so the
		// binding is borrowed and never dropped. `let u = t` from an already-owned binding DOES own (the
		// bit rides the value), and MOVES it (below). The day a struct arrives from somewhere other than a
		// factory call, its producer set the same bit, and this asks no new question.
		if self.valueIsOwnedHeap(boundValue) 'trackOwned'
			// ⭐⭐ **AN IMMUTABLE REBIND IS A SECOND REFERENCE, NOT A MOVE (the ownership ruling, 2026-08-04).**
			// Maxon is single-ownership and everything is a reference; `clone()` is the only copy. What makes
			// `let b = a` SAFE is mutability, not linearity — neither name can be written through, so the two
			// cannot observe each other changing and the value is simply reachable by two names. So `b` binds
			// `a`'s value, `a` is NOT poisoned, and both stay readable: `specs/ownership.md`'s `local-alias`.
			//
			// ⭐ **ONE DROP, AND IT IS STILL THE OWNER'S — no refcount traffic.** The alias is NOT enrolled in
			// `ownedBindings`, so `scopeReleasesAbove` never sees it and the ONE drop stays where it already was:
			// at the owner's scope exit. That is sound without any liveness analysis because a binding can only
			// be declared AFTER the name it reads, in that name's scope or one nested inside it — so the owner
			// always outlives every alias of it, structurally. It is the same shape a borrowed binding
			// (`let q = <a struct parameter>`) already had; what changed is which initializers reach it.
			//
			// ⚠ **A MUTABLE SOURCE STILL MOVES**, and that is the ruling's own rationale read the other way: if
			// `a` is a `var`, a second name for its value CAN observe a write through the first, so there is no
			// aliasing to be safe. `a = <other>` would then drop the box this binding still names.
			//
			// ⚠ **IT ASKS `mutable`, NOT WHETHER THE SOURCE'S STORAGE IS WRITABLE.** The question is whether the
			// source can LOSE its value while the alias still names it. Only a rebind can do that, and only a
			// `var` can be rebound — a parameter is E2013 — so a consumed owned parameter is a perfectly safe
			// thing to alias.
			if boundBareLocal and self.nameAliasesItsSource(kind, sourceName: sourceName, value: value) 'aliasImmutableSource'
				// `poisonMoveSource` must now consider more than the owned set: a consume of this value
				// (`f(b)`, `return b`) poisons its OWNER, and this name would go on reading a value the callee
				// took. The flag keeps that scan off every function that mints no alias — the overwhelming
				// majority — rather than paying a symbol-table walk per move everywhere.
				self.bodyState.functionMintedValueAliases = true
			end 'aliasImmutableSource' else 'takeOwnership'
				// ⭐ **MOVE-ON-BIND.** If the initializer was a bare reference to an ALREADY-owned MUTABLE
				// binding (`var t` + `let u = t`), `boundValue` is that binding's value: it MOVES to this new
				// one. Poison the source so a later read of it is use-after-move and only the new owner drops
				// the value. A fresh owned temp (`build()`, `"{x}"`, a promoted mutable-string copy) is held by
				// no binding, so nothing is poisoned — that is a CONSUME (move-in), not a source-poisoning
				// move. Gated on `boundBareLocal`, so a consume never pays the owner lookup; run BEFORE the
				// push below, so the lookup cannot find this new binding (it aliases the same value).
				if boundBareLocal 'moveOnBind'
					self.poisonMoveSource(boundValue)
				end 'moveOnBind'

				self.enrolOwnedBinding(binding)

				// Ownership TRANSFERS from the statement to the binding, so the statement must no longer drop
				// it — a second drop of the box the binding now owns is a double-free. A struct box is never in
				// the pending list (only `emitStringInterp` enrolls); an owned interpolation result is, so this
				// is what moves its drop from statement-end to scope-exit.
				self.removeFromPendingTemps(boundValue)
			end 'takeOwnership'
		end 'trackOwned' else 'aBorrowedValue'
			if boundBareLocal 'rebindsABorrowedName'
				self.noteLentUniqueMoved(boundValue)
			end 'rebindsABorrowedName'
		end 'aBorrowedValue'

		// ⭐ **A PROMISE BINDING OWNS A GREEN THREAD, the dual of the E3100 linear-await check.**
		// `let/var p = async f()` enrols the spawn as an owned value, so the SAME scope-exit / re-arm / branch-
		// reconciliation machinery that drops an owned heap box (`emitScopeDrops`, `reconcileMovesAtMerge`,
		// `reassignBindingValue`) drops (and cancels) the thread — through `__gt_promise_drop` — on every path
		// that does not `await` it. `await` marks it moved (`consumePromiseThread`), so an awaited path skips it.
		//
		// ⚠ **AN ALIAS (`let q = p`, `boundBareLocal`) IS NOT A SECOND OWNER.** A promise ALIASES rather than
		// moves (linearity keys on the shared thread ValueId — `await p; await q` is one thread awaited twice),
		// so `q` binds `p`'s value verbatim and is NOT enrolled: exactly the spawn binding drops the one thread
		// once. This is why promises are enrolled separately from `valueIsOwnedHeap` (which move-poisons a bare-
		// local RHS) rather than folded into it. A promise is never `valueIsOwnedHeap`, so the two are disjoint.
		if self.valueOwnsGreenThread(boundValue) and not boundBareLocal 'trackPromise'
			self.enrolOwnedBinding(binding)
			self.removeFromPendingTemps(boundValue)
		end 'trackPromise'
	end 'declareInitializedBinding'

	function valueHoldsAUniqueRecord(value ValueId) returns bool
		if not self.valueIsNonTextAggregate(value) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		return self.signatures.valueHoldsAUnique(self.tagOf(value), nameId: self.valueNameId(value), from: self.artifact.typeNames)
	end 'valueHoldsAUniqueRecord'

	function valueIsAUniqueStorageRead(value ValueId) returns bool
		return (self.valueIsAStorageRead(value) or self.valueIsASlotRead(value)) and self.valueHoldsAUniqueRecord(value)
	end 'valueIsAUniqueStorageRead'

	function valueIsAUniqueAlias(value ValueId) returns bool
		return self.valueIsAUniqueStorageRead(value) or self.regionFactsForRead().lentUniques.contains(value)
	end 'valueIsAUniqueAlias'

	function requireNoUniqueAlias(value ValueId, action String, anchor Token) throws SourceParseError
		if not self.valueIsAUniqueAlias(value) 'noUniqueAliased'
			return
		end 'noUniqueAliased'

		throw self.regionRefusal(ErrorCode.semanticUniqueValueRefused, message: uniqueAliasMessage(action), line: anchor.line, column: anchor.column)
	end 'requireNoUniqueAlias'

	function argumentNamesALocal(valueStart ElementIndex) returns bool
		try self.bareBindingNamedBy(valueStart).localName() otherwise return false
		return true
	end 'argumentNamesALocal'

	// ⭐⭐ **`let (x, y) = <a tuple>` — DESTRUCTURING, DESUGARED TO A HIDDEN BINDING PLUS ONE FIELD LOAD
	// PER NAME.** There is nothing here a `let tmp = t` followed by `let x = tmp._0` does not already
	// mean.
	//
	// ⭐ **THE HIDDEN BINDING IS AN OWNERSHIP OBLIGATION, NOT A CONVENIENCE.** The RHS is a freshly built
	// tuple BOX that some binding has to drop; the element names cannot, because a `_N` field read is a
	// BORROW (`emitFieldLoad` never marks the loaded value owned-heap) and N of them would drop the same
	// String N times. So the box is bound to a name the source cannot spell, that name enters the ordinary
	// owned-binding list, and the box dies at scope exit exactly as `let t = (…)` makes it die — while the
	// elements stay borrows that are valid for precisely as long.
	//
	// It runs the SAME `declareInitializedBinding` an ordinary `let` does — for the temp and for every
	// element — so nothing about a destructured binding is special downstream.

	// ⭐ **`( x , y , … )` — THE NAME LIST OF A DESTRUCTURING PATTERN, cursor on the `(`.** Two constructs
	// spell it: a `let`/`var` binding and a `for … in` loop variable (`for (key, value) in m`), and they are
	// one pattern rather than two — `_` discards a position in both, every name is checked against the
	// reserved set in both, and both refuse a one-name pattern with the same sentence.
	//
	// The ARITY is refused here, before the source is even parsed, so `let (x) = …` and `for (x) in …` are
	// each read as the malformed destructure they are rather than as a type error about whatever follows.
	// The sentence names `let`, which is the spelling every reader of it has written; a `for` header that
	// wanted one name simply omits the parens.
	function parseDestructuringNames(keywordTok Token) returns TokenArray throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let nameToks = TokenArray.create(0)

		while not self.at(TokenKind.rightParen) 'collectNames'
			let nameTok = try self.consume(TokenKind.identifier)
			try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
			nameToks.push(nameTok)

			if not self.at(TokenKind.comma) 'lastName'
				break
			end 'lastName'

			try self.consume(TokenKind.comma)
		end 'collectNames'

		try self.consume(TokenKind.rightParen)

		try requireMemberCount(nameToks.count(), limit: MaxDeclaredMembers, members: "tuple destructuring names", anchor: keywordTok)

		if nameToks.count() < MinTupleArity 'tooFewNames'
			throw SourceParseError.unsupported("a destructuring binding of {nameToks.count()} name(s) (a tuple has at least {MinTupleArity} elements, so `let (x) = …` names no destructurable shape — write `let x = …`)", line: keywordTok.line, column: keywordTok.column)
		end 'tooFewNames'

		return nameToks
	end 'parseDestructuringNames'

	function parseDestructuringBinding(func IrFunction, block IrBlock, kind BindingKind, keywordTok Token) throws SourceParseError
		let mutable = kind == BindingKind.var
		let nameToks = try self.parseDestructuringNames(keywordTok)

		try self.consume(TokenKind.equals)
		let rhsStart = self.pos
		let value = try self.parseBindingInitializer(func, block: block, kind: kind)
		let source = try self.requireDestructurableTuple(value, nameToks: nameToks, keywordTok: keywordTok, patternSubject: BindingPatternSubject, sourceNoun: BindingPatternSourceNoun, needsClause: BindingPatternNeedsClause)

		if not mutable 'anImmutableTuple'
			self.freezeLiteralTuple(value)
		end 'anImmutableTuple'

		// WHICH local the initializer reached into, read once for the whole destructure — the temp's move
		// source, and the root every ELEMENT reaches a field of.
		let sourceName = self.rhsRootLocalName(rhsStart)

		// The hidden binding takes the SOURCE's keyword: a `var (x, y) = …` element may be reassigned, and a
		// reassignment of an element rebinds only that name — the box itself is never written through, so the
		// temp's mutability is inert and simply matches what the author wrote.
		//
		// ⚠ Because it is inert, no refusal may be keyed on the temp's mutability: its name appears in no
		// source file. The temp still supplies the move source (`boundBareLocal`).
		let tempTok = Token.create(TokenKind.identifier, line: keywordTok.line, column: keywordTok.column, value: freeze "{DestructureTempPrefix}{keywordTok.line}_{keywordTok.column}".toByteArray())
		try self.declareInitializedBinding(tempTok, value: value, sourceName: sourceName, sourceReadsAField: self.rhsSpanReadsAField(rhsStart), kind: kind)

		for i in 0 upto nameToks.count() 'eachName'
			let nameTok = try nameToks.get(i) otherwise panic("parseDestructuringBinding: nameToks.get OOB at {i} below count {nameToks.count()}")

			if nameTok.value.equals(DiscardBindingName) 'aDiscardedElement'
				continue
			end 'aDiscardedElement'

			try self.declareDestructuredElement(nameTok, element: self.destructuredElement(value, source: source, index: i as FieldIndex, range: SourceRange.between(keywordTok, last: nameTok)), kind: kind)
		end 'eachName'
	end 'parseDestructuringBinding'

	// ⭐ **ONE DESTRUCTURED ELEMENT, BOUND TO THE NAME THAT NAMES IT** — shared by the DECLARING pattern
	// (`let (x, y) = t`, once per name) and by a tuple ASSIGNMENT's `let`/`var` target (`(x, let y) = f()`),
	// which are the same three obligations in the same order. Written twice, an element of one form would
	// come to be enrolled for a rule the other's is not.
	function declareDestructuredElement(nameTok Token, element ValueId, kind BindingKind) throws SourceParseError
		try self.requireVarNotBornFromABareNumber(element, kind: kind, anchor: nameTok)

		// No source name for the DECLARATION: a field load is a fresh borrowed value held by no binding,
		// so there is nothing for the move poison to find.
		try self.declareInitializedBinding(nameTok, value: element, sourceName: SourceBinding.none, sourceReadsAField: false, kind: kind)

		if self.valueHoldsAUniqueRecord(element) 'aLentUnique'
			let table = self.regionFactsForWrite()
			table.destructuredUniques.insert(element)
			table.destructuredUniques.insert(self.bodyState.scope.getInfo(nameTok.value).boundValue)
		end 'aLentUnique'

		self.noteBodyBindingDeclared(nameTok, kind: kind, boundFromContainerLiteral: false)
	end 'declareDestructuredElement'

	// ⭐⭐ **`(x, let y) = makePair(10, b: 32)` — STATEMENT-LEVEL TUPLE ASSIGNMENT (`specs/tuple-assign.md`),
	// lowered as ONE evaluation of the right-hand side plus one field read per target.** It is the
	// DECLARING destructure with the per-position question widened: each target either REBINDS a binding
	// already in scope, DECLARES a fresh one, or DISCARDS its element. Everything else it does —  the hidden
	// owner of the box, the borrowed field reads, the per-element declaration — is `parseDestructuringBinding`'s,
	// shared rather than restated.
	//
	// ⭐ **THE RIGHT-HAND SIDE IS EVALUATED EXACTLY ONCE, AND THE HIDDEN BINDING IS WHAT MAKES THAT TRUE
	// RATHER THAN MERELY INTENDED.** Every target reads a FIELD of the one value the expression produced, so
	// `(a, b) = step(a)` inside a loop calls `step` once per trip whatever the arity —  and `a` on the
	// right-hand side is read before any target is written, because the whole expression is parsed and
	// emitted ahead of the distribution loop below.
	//
	// ⭐ **AND THE HIDDEN BINDING IS AN OWNERSHIP OBLIGATION, exactly as it is for the declaring form.** The
	// right-hand side is a tuple BOX somebody has to drop; the targets cannot, because a `_N` field read is a
	// BORROW (`emitFieldLoad` never marks the loaded value owned-heap) and N of them would drop one managed
	// element N times. So the box is bound to a name the source cannot spell, which drops it at scope exit —
	// and that is also why a `_` DISCARD owes nothing at all: it reads no field, and the element it declined
	// to read was never its to release.
	//
	// ⚠ **THE TEMP IS DECLARED IMMUTABLE, where the declaring form hands it the author's keyword.** There is
	// no author keyword here — the mutability is per TARGET — and the temp's own is inert either way (nothing
	// rebinds it; the box is never written through). Immutable is the honest spelling of "nothing rebinds
	// this", and it is the same value `let (x, y) = …` passes.
	//
	// ⭐⭐ **"THE BOX HAS AN OWNER" IS NOT THE WHOLE OWNERSHIP QUESTION HERE, AND THIS IS THE ONE PLACE
	// IT IS NOT — CAN A TARGET OUTLIVE THAT OWNER?** The declaring form never has to ask: its names
	// are declared in the same scope as its temp, so they die together. An ASSIGNMENT can name a
	// binding declared in an ENCLOSING scope, and the temp dies at the END of the block the statement
	// sits in — so a target holding a borrow of the temp's box would be read after the box was
	// released. MEASURED, on the shape that would expose it (a loop rebinding an outer `var s` from a
	// `(String, String)` per trip, then 40 further allocations to REUSE any freed slab before `s` is
	// printed): **the right string, exit 0, no 101**.
	//
	// It is right because a REBINDING target does not hold a borrow at all: `completeLocalRebind` →
	// `reassignBindingValue` gives the binding a value it owns (a borrowed managed element is promoted — a
	// String COPIES, an aggregate increfs), which is the same promotion `s = <a field read>` performs. The
	// borrow is consumed inside the statement; nothing of the temp's survives it. A DECLARING target's name is
	// scoped with the temp, exactly as in the declaring form.
	function parseTupleAssignment(func IrFunction, block IrBlock) throws SourceParseError
		let openTok = self.current()
		let openIndex = self.pos
		let equalsIndex = tupleAssignEqualsIn(self.tokens, open: openIndex)
		let targetIndices = self.tupleAssignTargetIndices(openIndex, equalsIndex: equalsIndex)
		try requireMemberCount(targetIndices.count(), limit: MaxDeclaredMembers, members: "tuple assignment targets", anchor: openTok)

		// Past `( … ) =` in one step. The predicate has already read every token of the head and the walk
		// above has already split it into targets, so consuming them one at a time here would be that same
		// grammar walked a third time — and the third copy is the one that gets taught a new target shape
		// last.
		self.pos = equalsIndex + 1

		// ONE pass over the targets before the right-hand side exists, answering both questions that have to be
		// settled before it is parsed: the reserved-name refusal (so `(x, let __y) = f()` is refused as the bad
		// declaration it is, rather than after a call was emitted) and whether EVERY target discards (E3064's
		// door, below). A rebinding target names a binding that was checked at its own declaration.
		var everyTargetDiscards = true

		for k in 0 upto targetIndices.count() 'eachTargetBeforeTheRhs'
			let nameIndex = try targetIndices.get(k) otherwise panic("parseTupleAssignment: targetIndices.get OOB at {k} below count {targetIndices.count()}")
			let target = self.tupleAssignTargetAt(nameIndex)

			if tupleAssignTargetDiscards(target) 'discarded'
				continue
			end 'discarded'

			everyTargetDiscards = false

			if tupleAssignTargetDeclares(target) 'declaringTarget'
				let nameTok = self.tokenAt(nameIndex)
				try self.requireUnreservedName(nameTok, declaredName: nameTok.value)
			end 'declaringTarget'
		end 'eachTargetBeforeTheRhs'

		let rhsStart = self.pos

		// ⭐ **A MODULE-WIDE OP INDEX, NOT A PER-BLOCK COUNT — the genuine analogue of
		// `rewriteLastCallToTryCall`'s `targetOpFloor`.** The producer probe compares against the block the
		// expression ENDED on, which a `try` or a ternary may have forked; two different blocks' op COUNTS
		// compare to nothing at all, and the fresh block's small count silently skipped the enrolment. Op
		// indices are global to the module, so this floor means the same thing on whatever block the
		// expression left the cursor.
		let opFloor = self.artifact.module.ops.count()
		let value = try self.parseExpression(func, block: block)

		// ⚠ **PROBED IMMEDIATELY, RECORDED LATER.** The producer is "the last op this statement emitted", and
		// the temp's declaration below can emit one of its own (a borrowed-managed promotion) — which would
		// put a `__mm_retain` where the call is expected. So the callee is read here and the pending site is
		// filed only once the statement is known to be well formed, below: a program the arity check is about
		// to refuse must not leave an E3064 site behind in the artifact.
		var discardedCallee = DiscardedCallee.notACall

		if everyTargetDiscards 'nothingTookAnElement'
			discardedCallee = self.directCallProducing(value, opFloor: opFloor)
		end 'nothingTookAnElement'

		let source = try self.requireTupleLayout(value, keywordTok: openTok, patternSubject: AssignPatternSubject, sourceNoun: AssignPatternSourceNoun, needsClause: AssignPatternNeedsClause)

		match source 'source'
			tuple(layout) then try self.requireAssignsEveryElement(layout, targetIndices: targetIndices, openTok: openTok)
			deferred then break
		end 'source'

		self.recordDiscardOf(discardedCallee, anchor: openTok, door: DiscardDoor.explicitDiscard)

		// WHICH local the right-hand side reached into, read once for the whole statement — the temp's move
		// source, and the root every DECLARING target reaches a field of (see `declareDestructuredElement`).
		let sourceName = self.rhsRootLocalName(rhsStart)

		let tempTok = Token.create(TokenKind.identifier, line: openTok.line, column: openTok.column, value: freeze "{DestructureTempPrefix}{openTok.line}_{openTok.column}".toByteArray())
		try self.declareInitializedBinding(tempTok, value: value, sourceName: sourceName, sourceReadsAField: self.rhsSpanReadsAField(rhsStart), kind: BindingKind.let)

		for i in 0 upto targetIndices.count() 'eachTarget'
			let nameIndex = try targetIndices.get(i) otherwise panic("parseTupleAssignment: targetIndices.get OOB at {i} below count {targetIndices.count()}")
			let target = self.tupleAssignTargetAt(nameIndex)
			let nameTok = self.tokenAt(nameIndex)

			// Asked BEFORE the read, which is the whole of what a discard costs: no field load, no store, no
			// binding — see the ownership paragraph in this function's header.
			if tupleAssignTargetDiscards(target) 'discarded'
				continue
			end 'discarded'

			let element = self.destructuredElement(value, source: source, index: i as FieldIndex, range: SourceRange.between(openTok, last: nameTok))

			match target 'kind'
				declares(kind) then try self.declareDestructuredElement(nameTok, element: element, kind: kind)
				rebinds then try self.rebindTupleAssignTarget(func, nameTok: nameTok, element: element, valueStart: rhsStart, valueEnd: self.pos)
				discards then panic("parseTupleAssignment: `tupleAssignTargetDiscards` already continued past every discard, so this arm names a case that cannot reach it")
			end 'kind'
		end 'eachTarget'
	end 'parseTupleAssignment'

	// E3005, positioned on the `(` — where the author decided how many targets to write. It is not the
	// E2015 the two declaring patterns raise for the same shape of mistake (`requireTupleLayout` says
	// why): this sentence and this code are pinned byte for byte by `specs/tuple-assign.md`.
	function requireAssignsEveryElement(layout StructLayout, targetIndices TokenIndexArray, openTok Token) throws SourceParseError
		if (layout.fieldCount()) != targetIndices.count() 'arityMismatch'
			throw SourceParseError.tupleAssignArityMismatch(layout.fieldCount(), targets: targetIndices.count(), line: openTok.line, column: openTok.column)
		end 'arityMismatch'
	end 'requireAssignsEveryElement'

	// ⭐⭐ **DID THIS STATEMENT CALL, SPAWN OR AWAIT ANYTHING — E3067's QUESTION, AND DELIBERATELY NOT
	// `directCallProducing`'s.** That probe names the ONE callee whose result went unused, and its misses are
	// harmless to E3064: a producer it cannot identify is silence. The SAME miss is a REFUSAL here, and it is
	// wrong — a DIVERGING fallback launders the value past that probe entirely: `otherwise panic(…)` never
	// rejoins, so the value is no merge block ARGUMENT and `directCallProducing`'s gate declines before the
	// backward walk that follows a merging `otherwise 0`. MEASURED both ways on a PURE callee — `otherwise 0`
	// answers E3064, `otherwise panic(…)` compiles clean — and 54 statements are the second shape, 52 in
	// `maxon-bin/` and 2 in `stdlib/`. So the discard
	// asks the weaker question whose misses are safe: did any op the statement emitted CALL
	// (`OpCategory.callFree` / `callMethod` — `call`, `tryCall`, `indirectCall`, the witness dispatches) or
	// suspend (`OpCategory.awaiting` — `asyncCall`, `await`, `tryAwait`, the service ops)?
	//
	// ⚠ **LOOSER THAN THE ORACLE IN TWO PLACES, AND BOTH ARE DELIBERATE.** `_ = f() + 1` and
	// `_ = f() if c else 0` are E3067 there (its rule is "the LAST op is a call") and legal here — a call did
	// happen, so the discard is about something. And `_ = async f()` / `_ = await p`, which the oracle also
	// refuses, are the spellings `async-promise-drop.md` and the await corpus are ABOUT: a spawn owns a green
	// thread and an await consumes one, so both are effects, and the oracle refuses them only because a
	// green-thread op is not a `MaxonCallOp` in ITS ir. Refusing here would falsify committed specs to copy an
	// implementation detail.
	function statementCallsOrAwaits(opFloor ElementIndex) returns bool
		let opCount = self.artifact.module.ops.count()

		for idx in opFloor upto opCount 'eachOpThisStatementEmitted'
			let op = try self.artifact.module.ops.get(idx) otherwise panic("statementCallsOrAwaits: opRef {idx} below the count just read is not in module.ops")

			if opCallsOrSuspends(op) 'thisOneDid'
				return true
			end 'thisOneDid'
		end 'eachOpThisStatementEmitted'

		return false
	end 'statementCallsOrAwaits'

	// ⭐⭐ **A BARE BINDING NAME IS THE ONE CALL-FREE DISCARD THAT SAYS SOMETHING, AND REFUSING IT WOULD
	// MAKE TWO RULES JOINTLY UNSATISFIABLE.** E3012 requires every binding to be named by the body; `_
	// = p` is the only spelling that names one without using it. Delete the `_ = p` from a
	// spawned-and-never-awaited promise and E3012 reports `unused variable: 'p'`, so a program that
	// must hold the binding to scope exit would have nowhere left to stand.
	//
	// EXACTLY ONE NAME TOKEN, resolving to a live binding. A longer right-hand side has already named its
	// root (`_ = c.count` names `c`) so it acknowledges nothing a bare `c` would not, and is refused with the
	// rest; a top-level binding is under no E3012 and needs no acknowledgement either.
	function rhsIsABareBinding(rhsStart ElementIndex) returns bool
		if self.pos != rhsStart + 1 'theRightHandSideIsNotOneToken'
			return false
		end 'theRightHandSideIsNotOneToken'

		let tok = self.tokenAt(rhsStart)

		return tokenCanBeAName(tok) and self.bodyState.scope.contains(tok.value)
	end 'rhsIsABareBinding'

	// Which call produced the right-hand side: the half of E3064's door the parser can answer.
	// `(_, _) = makePair(10, b: 32)` uses nothing the call produced, so the statement is a call written for an
	// effect; whether the callee has one is a whole-program question, judged by
	// `SemanticCheck.checkDiscardedResults` from the site the caller files (see `PendingDiscardedResult`).
	//
	// A right-hand side that is not a direct call answers `notACall`, and that is the rule: `(_, _) =
	// (1, 2)` has no callee whose result went unused. The producer is found the way the `try` rewrite
	// finds its target (`opProducingTheValue`), so a `+`, a group or a bare name all decline it.
	//
	// It reads `self.bodyState.currentBlock` fresh rather than the block it was handed: an expression may have
	// forked (a `try`, a ternary, a routed call), and the op that produced the value is on the block
	// the expression ended on. The floor being a module-wide op index is what makes that safe — see
	// the caller.
	function directCallProducing(value ValueId, opFloor ElementIndex) returns DiscardedCallee
		let atTheEnd = match self.opProducingTheValue(opFloor) 'producer'
			noOwnOp gives DiscardedCallee.notACall
			at(opIdx) gives self.directCallDefining(opIdx, value: value)
		end 'producer'

		if discardedCalleeIsACall(atTheEnd) 'theLastOpIsTheCall'
			return atTheEnd
		end 'theLastOpIsTheCall'

		// Otherwise the value came through a fork (see `tryChannelCallAbove`). Only a merge argument asks
		// for any try-channel call, having no defining op to compare; every other value asks for the call
		// defining it, because a merge block goes on accepting ops, and a statement whose argument forks
		// ends on a block holding its own producer. Asking for any call there would report the void
		// `push` in `digits.push(try src.get(i) otherwise panic(…))` as a discarded `Array.get`.
		if self.valueIsArgOfCurrentBlock(value) 'aMergeTheForkLaundered'
			return self.tryChannelCallAbove(opFloor, wanted: TryChannelResult.anyValue)
		end 'aMergeTheForkLaundered'

		return self.tryChannelCallAbove(opFloor, wanted: TryChannelResult.definedValue(value))
	end 'directCallProducing'

	// Did the statement's expression FORK and merge into the block it ended on, handing back that merge's
	// block ARGUMENT? That is the one shape whose producer no op in the block defines.
	function valueIsArgOfCurrentBlock(value ValueId) returns bool
		for arg in self.bodyState.currentBlock.blockArgs 'eachArg'
			if arg.valueId == value 'theMergeHandedThisBack'
				return true
			end 'theMergeHandedThisBack'
		end 'eachArg'

		return false
	end 'valueIsArgOfCurrentBlock'

	// A routed or `try`ed call is not the last op of its statement: the expression forks, leaving the
	// `tryCall` and its branch on an earlier block, and hands back either the call's own result (a
	// routed call's ok edge continues the statement) or a block argument the two arms of a `try …
	// otherwise` merged into. So the callee is found by walking this statement's ops back from the
	// end, bounded by `opFloor`, a module-wide index that cannot reach a previous statement's call.
	//
	// A `throws` clause is not an effect, so this shape cannot be declined on the reasoning that a
	// throwing callee is never effect-free: `EffectSummaryBuilder.walkOp` counts neither a throw nor
	// a panic, and a throwing pure callee's discarded result is reportable
	// (`specs/discarded-results.md`'s `try-pure-let-discard`).
	function tryChannelCallAbove(opFloor ElementIndex, wanted TryChannelResult) returns DiscardedCallee
		var idx = self.artifact.module.ops.count()

		while idx > opFloor 'scanThisStatementBackwards'
			idx = idx - 1
			let producer = tryChannelCallOf(self.routableOpAt(idx), opIndex: idx, wanted: wanted)

			if discardedCalleeIsACall(producer) 'theStatementMadeThisCall'
				return producer
			end 'theStatementMadeThisCall'
		end 'scanThisStatementBackwards'

		return DiscardedCallee.notACall
	end 'tryChannelCallAbove'

	// ⭐⭐ **THE DISCARD DOOR THE TWO STATEMENT POSITIONS SHARE — a bare `f()` line and `_ = f()`.** Both
	// evaluate a call and take none of what it produced, so both file the site `SemanticCheck` judges; what
	// differs is the anchor token, which is each door's own statement start, and the `DiscardDoor` that
	// separates E3064's verdict from E3065's.
	//
	// ⚠ **A VOID RESULT IS NOT A DISCARD.** A `void` callee is seeded effectful anyway
	// (`EffectSummaryBuilder.verdicts`), so filing one could never fire — but every bare void statement in every
	// program would still pay for a record and for the whole-program summary those records switch on.
	function recordDiscardedCallResult(value ValueId, opFloor ElementIndex, anchor Token, door DiscardDoor)
		let producer = self.directCallProducing(value, opFloor: opFloor)

		if self.tagOf(value) == ValueTypeTag.void 'theCallPromisedNothing'
			return
		end 'theCallPromisedNothing'

		self.recordDiscardOf(producer, anchor: anchor, door: door)
	end 'recordDiscardedCallResult'

	// File a probed producer, if it was a call at all. The ANCHOR is the statement's own token — where the
	// author decided to take nothing — rather than the callee's, which is what makes `_ = double(5)` report at
	// the `_` and a bare `double(5)` at the name.
	//
	// The SUBJECT is the source member behind a lowered runtime read (`lastRuntimeRead`) and
	// `DiscardSubject.none` for every other producer: a declared callee is its
	// own subject and `SemanticCheck.checkDiscardedResults` reports it under the name it is keyed by.
	function recordDiscardOf(producer DiscardedCallee, anchor Token, door DiscardDoor)
		match producer 'usedNothing'
			named(_, result, opIndex) then self.artifact.recordDiscardedResult(PendingDiscardedResult.create(opIndex, door: door, subject: self.runtimeReadSubjectOf(result), line: anchor.line, column: anchor.column, filePath: self.job.path))
			notACall then break
		end 'usedNothing'
	end 'recordDiscardOf'

	// ⭐⭐ **WHERE E3064 POINTS AT A CALL STATEMENT — THE CALLED NAME, WHICH IS THE LAST NAME OF THE
	// CHAIN THE `(` FOLLOWS.** One rule for every call-statement door, dotted or not: `arr.count()`
	// blames `count`, `b.ops.count()` blames `count`, `utils.twice(4)` blames `twice`, and a bare
	// `double(5)` blames `double` — the zero-hop chain, which is the same walk with nothing to walk.
	// The anchor is the METHOD, never the receiver.
	//
	// ⚠ `directCallStmt` files its `calleeTok` rather than calling this: on a bare name the two are the SAME
	// token, and that door already holds it for `terminateAfterDivergingCall`.
	//
	// It must be asked BEFORE the door parses, while the cursor is still on the chain's base.
	function dottedCallNameToken(index ElementIndex) returns Token
		let chainEnd = self.fieldChainEndAfter(index, minHops: AnyFieldHops)

		if chainEnd == index 'notAName'
			panic("dottedCallNameToken: token {index} opens no name chain — every call-statement door that asks this has already matched a name there")
		end 'notAName'

		return self.tokenAt(chainEnd - 1)
	end 'dottedCallNameToken'

	// Say which SOURCE member the runtime read just emitted serves (see `lastRuntimeRead`). Called by
	// the arm that lowered it, with the value it is about to hand back.
	function noteRuntimeReadMember(result ValueId, typeName ByteArray, methodName ByteArray)
		self.bodyState.lastRuntimeRead = LastRuntimeRead.read(result, typeName: typeName, methodName: methodName)
	end 'noteRuntimeReadMember'

	// The `Type.member` spelling behind `result`, or `DiscardSubject.none` when the last runtime read
	// this parse lowered was about a different value — see the `lastRuntimeRead` field for why one
	// slot answers this honestly.
	function runtimeReadSubjectOf(result ValueId) returns DiscardSubject
		return match self.bodyState.lastRuntimeRead 'runtimeRead'
			none gives DiscardSubject.none
			read(readResult, typeName, methodName) gives DiscardSubject.runtimeRead(qualifiedMethodName(typeName, methodName: methodName)) if readResult == result else DiscardSubject.none
		end 'runtimeRead'
	end 'runtimeReadSubjectOf'

	// The identifier token of each target of a confirmed list, in source order. Every identifier in the span
	// IS a target's name and nothing else is one — a qualifier is a KEYWORD and a separator is a comma — so
	// this is the walk in full, and the k-th identifier is the k-th tuple element's target.
	function tupleAssignTargetIndices(openIndex ElementIndex, equalsIndex ElementIndex) returns TokenIndexArray
		let indices = TokenIndexArray.create(0)
		var i = openIndex + 1

		while i < equalsIndex 'eachToken'
			if self.kindAt(i) == TokenKind.identifier 'targetName'
				indices.push(i)
			end 'targetName'

			i = i + 1
		end 'eachToken'

		return indices
	end 'tupleAssignTargetIndices'

	// ⭐ **A BARE TARGET IS THE ASSIGNMENT `x = <that element>`, and it goes through the same door.** Everything
	// a rebind owes — the E3012 mention, the mutability refusal (E2013), the type and
	// aggregate-identity checks and the cell store — is `parseAssignment`'s and is
	// asked here through the same two routines, in the same order.
	//
	// ⚠ **`rhsWasBareLocal` IS FALSE, and that is a fact rather than a simplification.** The value is a FIELD
	// LOAD — a fresh borrowed pointer that is the value of no binding — so there is no source binding for the
	// move poison to find, exactly as `declareDestructuredElement` passes no source name for the same reason.
	//
	// ⚠ **AND `integerizedOperand` IS NOT ASKED, where `parseAssignment` asks it.** That coercion turns a
	// CHARACTER LITERAL right-hand side into its codepoint for an integral target (`b = '0'`), and it is keyed
	// on the RHS's TOKEN SPAN. A tuple element has no span of its own — it is a field of an already-built box,
	// and a tuple element is never a bare character literal at this point — so there is nothing here for it to
	// convert. Stated because its absence otherwise reads as an omission.
	//
	// ⚠ **A NAME REPEATED ACROSS TARGETS (`(x, x) = f()`) IS NOT DIAGNOSED: both stores run, the last
	// wins.** Consistent rather than overlooked — `x = a` then `x = b` on two lines is legal Maxon and
	// means the same thing.
	//
	// ⛔ **A TARGET THAT DOES NOT NAME A LOCAL IS REFUSED, NOT QUIETLY REDIRECTED.** A self field
	// (`count = 1` inside a method) is written through a DIFFERENT store — `emitCheckedSelfFieldStore` —
	// which parses its own right-hand side, which a tuple assignment has already evaluated. Routing such a name to the local rebind instead
	// would silently rebind the field's ALIAS and never write the receiver's storage: a wrong answer, not a
	// missing feature. E2015 is exactly "a shape this compiler does not lower HERE yet"; the name that
	// resolves to nothing at all keeps the E2004/E2013 answer a plain `x = …` gives it.
	function rebindTupleAssignTarget(func IrFunction, nameTok Token, element ValueId, valueStart ElementIndex, valueEnd ElementIndex) throws SourceParseError
		if not self.bodyState.scope.contains(nameTok.value) 'notALocal'
			match self.signatures.globalDeclFor(nameTok.value, readerFilePath: self.job.path, into: self.artifact.typeNames) 'global'
				found or
				poisoned then throw SourceParseError.unsupported("a tuple-assignment target naming the module-scope binding '{String.from(nameTok.value)}' (a module binding is written through a different store, which parses its own right-hand side; assign the element to a local and store that)", line: nameTok.line, column: nameTok.column)
				notFound then try self.rejectNonGlobalAssignment(nameTok)
			end 'global'
		end 'notALocal'

		let binding = self.bodyState.scope.getInfo(nameTok.value)
		self.markBindingReferenced(binding)

		if binding.isSelfField 'selfField'
			throw SourceParseError.unsupported("a tuple-assignment target naming the field '{String.from(nameTok.value)}' of the enclosing type (a field is written through the receiver by a different store, which parses its own right-hand side; assign the element to a local and store that)", line: nameTok.line, column: nameTok.column)
		end 'selfField'

		try self.requireMutableBinding(binding, nameTok: nameTok)
		try self.completeLocalRebind(func, binding: binding, nameTok: nameTok, written: element, rhsBareLocalName: SourceBinding.none, valueStart: valueStart, valueEnd: valueEnd)
	end 'rebindTupleAssignTarget'

	// A destructuring pattern over `nameToks` needs a tuple (never a declared struct — its fields have
	// names the author would have to write) whose element count is the name count. A deferred value
	// passes both checks unasked: the E3004 at its call explains it. Both refusals are positioned on
	// the construct's keyword, which is where the author decides how many names to write.
	//
	// The construct's nouns are the caller's, as `parseHashTableColumnArg` takes its subject, because
	// only the caller knows which construct is speaking: a `for (a, b) in xs` header has no binding,
	// initializer or right-hand side for a fixed sentence to name. The `let` triple keeps both
	// sentences byte-identical to their committed pins.
	function requireDestructurableTuple(value ValueId, nameToks TokenArray, keywordTok Token, patternSubject String, sourceNoun String, needsClause String) returns DestructuredSource throws SourceParseError
		let source = try self.requireTupleLayout(value, keywordTok: keywordTok, patternSubject: patternSubject, sourceNoun: sourceNoun, needsClause: needsClause)

		match source 'source'
			tuple(layout) then try self.requireNamesEveryElement(layout, nameToks: nameToks, keywordTok: keywordTok, patternSubject: patternSubject)
			deferred then break
		end 'source'

		return source
	end 'requireDestructurableTuple'

	function requireNamesEveryElement(layout StructLayout, nameToks TokenArray, keywordTok Token, patternSubject String) throws SourceParseError
		if (layout.fieldCount()) != nameToks.count() 'arityMismatch'
			throw SourceParseError.unsupported("{patternSubject} of {nameToks.count()} names against a tuple of {layout.fieldCount()} elements (every element must be named)", line: keywordTok.line, column: keywordTok.column)
		end 'arityMismatch'
	end 'requireNamesEveryElement'

	// ⭐ **THE "IT MUST BE A TUPLE" HALF, ON ITS OWN, because a THIRD construct spells the pattern and does
	// NOT share the arity sentence.** A statement-level tuple ASSIGNMENT (`(x, y) = f()`) asks exactly this
	// question of its right-hand side, and then asks a different arity question: the canonical
	// `specs/tuple-assign.md` pins its count mismatch as **E3005** with its own wording, where the two
	// DECLARING patterns above pin E2015 with theirs (`specs/tuples.md`). Two committed sentences under
	// two committed codes, so the split is where they actually differ and nowhere else — the non-tuple
	// refusal stays one sentence assembled from the caller's nouns.
	function requireTupleLayout(value ValueId, keywordTok Token, patternSubject String, sourceNoun String, needsClause String) returns DestructuredSource throws SourceParseError
		if self.valueIsDeferred(value) 'aDeferredCallResult'
			return DestructuredSource.deferred
		end 'aDeferredCallResult'

		if not tagNamesADeclaredType(self.tagOf(value)) or not self.valueTypeNameIsATuple(value) 'notATuple'
			throw SourceParseError.unsupported("{patternSubject} of a '{self.valueKindWord(value)}' {sourceNoun} (only a TUPLE can be destructured — {needsClause})", line: keywordTok.line, column: keywordTok.column)
		end 'notATuple'

		return DestructuredSource.tuple(self.registeredTupleLayout(self.valueTypeName(value)))
	end 'requireTupleLayout'

	// A deferred source mints a fresh value per element: E3012 is counted per binding, so two names
	// sharing one ValueId would be one binding to everything downstream.
	function destructuredElement(value ValueId, source DestructuredSource, index FieldIndex, range SourceRange) returns ValueId
		return match source 'source'
			tuple(layout) gives self.emitFieldLoad(value, layout: layout, index: index, range: range)
			deferred gives self.mintDeferredValue()
		end 'source'
	end 'destructuredElement'

	// ⭐ **IS `value` A TUPLE THIS RUNG MAY COPY?** — a tuple `structRef` none of whose elements owes a drop.
	// The test is `ProgramSignatures.nameIsACopyableTuple`, so its askers cannot come to disagree about which
	// tuples have value semantics — a disagreement that would not be a missed case but a record freed twice
	// or not at all. The askers here are the durable-storage move-in (`moveManagedValueInto`),
	// `promoteBorrowedToOwned`, which asks it for the whole HAND-OFF family at once (a `return`, a
	// closure `gives`, a `match`/ternary arm, a `try … otherwise` fallback), and `greenThreadTakeOf`,
	// which copies a trivial tuple leaving this green thread.
	// ⚠ `transferConsumedArg` deliberately does NOT ask this: a consuming argument stays on this
	// green thread and co-owns a borrowed trivial tuple, because a tuple aliases at a binding
	// (`var q = t; q.1 = 55` writes through `t`, and a closure capturing `t` sees the write).
	//
	// The probe is `structHasFieldOwingDrop`, not `structHasManagedField`: a promise element is no heap box,
	// but its green thread has one owner, so a copy of its tuple would drop it while the original holds it.
	function valueIsCopyableTuple(value ValueId) returns bool
		if not tagNamesADeclaredType(self.tagOf(value)) 'notAStruct'
			return false
		end 'notAStruct'

		return self.signatures.nameIsACopyableTuple(self.valueTypeName(value))
	end 'valueIsCopyableTuple'

	// A fresh record holding the same elements as `value` — the copy `valueIsCopyableTuple` licenses. It is
	// `emitStructLiteral`'s box, filled from a load per element instead of from parsed values, so the
	// allocation, the size and the per-slot offsets come from the one layout both routines read. The result
	// is an OWNED temporary of the statement, like any freshly built box.
	function copyTupleValue(value ValueId, range SourceRange) returns ValueId
		let layout = self.registeredTupleLayout(self.valueTypeName(value))
		let box = self.emitOwnedStructBox(layout, range: range)

		for i in 0 upto layout.fieldCount() 'eachElement'
			self.emitFieldStore(box, layout: layout, index: i, value: self.emitFieldLoad(value, layout: layout, index: i, range: range), range: range)
		end 'eachElement'

		self.carryValueFacts(box, from: value, source: self.bodyState, path: ValueCarryPath.value)
		return box
	end 'copyTupleValue'

	// De-listed from the statement's pending drops: the sink owns the copy, and a statement-end
	// `__mm_decref` on it would free a record the sink still holds.
	function copyTupleForSink(value ValueId, range SourceRange) returns ValueId
		let copied = self.copyTupleValue(value, range: range)
		self.removeFromPendingTemps(copied)
		return copied
	end 'copyTupleForSink'

	// The interned TYPE NAME a `structRef`/`named`-tagged value carries — the pair `internedName` and
	// `valueNameId` spell together, wherever a value's NOMINAL identity is what decides something.
	function valueTypeName(value ValueId) returns immutable ByteArray
		return self.internedName(self.valueNameId(value))
	end 'valueTypeName'

	function valueTypeNameIsATuple(value ValueId) returns bool
		return internedNameIsATupleTypeName(self.artifact.typeNames, id: self.valueNameId(value))
	end 'valueTypeNameIsATuple'

	// Open a lexical block — an `if` / `else` / `while` body. THREE things are scoped to
	// it and must be opened and closed TOGETHER: the Scope frame its declarations land
	// in, the height of the mutable-binding list, and the height of the owned-binding
	// list. A `var` that leaves scope must also leave the first, or the next merge
	// snapshot would mint a phi for a binding no source line can name; a struct binding
	// that leaves scope must leave the second, or a later `return` would emit a
	// `__mm_decref` for a name that is gone — a DOUBLE FREE if the block already
	// returned through it. Returns the mark `closeBlock` unwinds to.
	//
	// ONE mark serves both lists, and that is sound rather than a shortcut: both are
	// append-only stacks pushed at a declaration and drained here, so their heights move
	// together with the block structure. It is not one mark serving two INDICES — each
	// list is drained to its own recorded height (see `BlockMark`).
	function openBlock() returns BlockMark
		self.bodyState.scope.pushScope()
		return BlockMark.create(self.bodyState.mutableVars.count(), ownedCount: self.bodyState.ownedBindings.count(), debugOpenCount: self.bodyState.debugOpenSlots.count(), orderFactHeight: self.bodyState.orderFacts.height())
	end 'openBlock'

	// Close a lexical block: drop its declarations out of scope (restoring anything they
	// shadowed), its `var`s off the mutable-binding list, and its owned bindings off the
	// owned list.
	//
	// ⚠ **IT EMITS NO DROP.** The `__mm_decref` for a
	// block-local owned binding — `if c 'b' let s = build(1) end 'b'` — is emitted by the code that
	// makes control LEAVE the block, keyed on HOW it leaves: a fall-through drops it in `parseBlockBody`
	// (before this pops it), a `break`/`continue` in `parseBreakStatement`/`parseContinueStatement`
	// (down to the enclosing loop's height), a `return` in `emitFunctionExit` (the whole scope). That
	// placement is what avoids a double free or use-after-free: each edge that leaves the block alive
	// drops exactly once, and a terminated
	// edge has already dropped, so this routine only unwinds the TRACKING lists and emits nothing.
	function closeBlock(mark BlockMark, endsIn IrBlock)
		self.bodyState.scope.popScope()

		while self.bodyState.mutableVars.count() > mark.mutableCount 'drainVars'
			self.popMutableVar()
		end 'drainVars'

		self.truncateOwnedBindings(mark.ownedCount)
		self.bodyState.orderFacts.forgetAbove(mark.orderFactHeight)
		self.closeDebugScopes(mark, endsIn: endsIn)
	end 'closeBlock'

	function closeDebugScopes(mark BlockMark, endsIn IrBlock)
		self.closeDebugScopesAbove(mark.debugOpenCount, endsIn: endsIn)
	end 'closeDebugScopes'

	function closeDebugScopesAbove(floor ElementIndex, endsIn IrBlock)
		while self.bodyState.debugOpenSlots.count() > floor 'eachBindingAboveTheFloor'
			let slot = try self.bodyState.debugOpenSlots.pop() otherwise panic("closeDebugScopesAbove: debugOpenSlots.pop failed above the height {floor}")
			let record = try self.bodyState.debugLocals.get(slot) otherwise panic("closeDebugScopesAbove: debug-local slot {slot} is past the {self.bodyState.debugLocals.count()} this function has recorded")
			record.noteScopeExit(endsIn.id)
		end 'eachBindingAboveTheFloor'
	end 'closeDebugScopesAbove'

	function noteDebugScopeExits(floor ElementIndex, leavingFrom IrBlock)
		for at in floor upto self.bodyState.debugOpenSlots.count() 'eachOpenBinding'
			let slot = try self.bodyState.debugOpenSlots.get(at) otherwise panic("noteDebugScopeExits: debugOpenSlots.get OOB at {at}")
			let record = try self.bodyState.debugLocals.get(slot) otherwise panic("noteDebugScopeExits: debug-local slot {slot} is past the {self.bodyState.debugLocals.count()} this function has recorded")
			record.noteScopeExit(leavingFrom.id)
		end 'eachOpenBinding'
	end 'noteDebugScopeExits'

	// Push a `var` onto the mutable-binding stack, and onto the two structures that index it.
	// THE ONE PLACE ALL THREE GROW, so they cannot grow apart: the shadow column is written before
	// the name index, because the position it records is the one the name index is about to lose.
	function pushMutableVar(binding VarInfo)
		// Copy-on-write off the shared empty shadow column before the first push — see
		// `ParserAnchors.mutableVarShadowed`. The name index below carries a spelled state and is installed
		// by its own door, so this guard speaks for the array alone.
		if self.bodyState.mutableVarShadowed is self.anchors.mutableVarShadowed 'firstVarInThisFunction'
			self.bodyState.mutableVarShadowed = MutableVarShadowColumn.create(0)
		end 'firstVarInThisFunction'

		self.bodyState.mutableVarShadowed.push(self.innermostMutableVar(binding.name))
		let position = self.bodyState.mutableVars.count()
		let byName = self.mutableVarIndexForWrite()
		byName.upsert(binding.name, value: position)
		self.bodyState.mutableVars.push(binding)
	end 'pushMutableVar'

	// Pop the innermost `var` off all three, restoring whatever name it shadowed. The twin of
	// `pushMutableVar` and the ONE place all three shrink.
	//
	// ⚠ It relies on the stack being STRICTLY LIFO — the popped binding's name must be the one the
	// index currently maps to this position. `openBlock`/`closeBlock` are the only things that move
	// the height, and they nest, so it is; a mid-stack removal would desync the index instead.
	function popMutableVar()
		let dropped = try self.bodyState.mutableVars.pop() otherwise panic("popMutableVar: mutableVars.pop failed on a non-empty stack")
		let shadowed = try self.bodyState.mutableVarShadowed.pop() otherwise panic("popMutableVar: the shadow column ran out before `mutableVars` did — the two grew apart")

		let byName = self.mutableVarIndexForWrite()

		match shadowed 'restore'
			none then _ = byName.remove(dropped.name)
			at(position) then byName.upsert(dropped.name, value: position)
		end 'restore'
	end 'popMutableVar'

	// Where the innermost mutable binding named `name` sits in `mutableVars`, or `InnermostMutableVar.none` when
	// no `var` of that name is in scope (a `let`, a self-field, a payload binding, an undeclared name
	// — none of which can carry a phi).
	function innermostMutableVar(name ByteArray) returns InnermostMutableVar
		match self.bodyState.mutableVarInnermost 'function'
			unwritten then return InnermostMutableVar.none
			entries(byName) then return innermostMutableVarIn(byName, name: name)
		end 'function'
	end 'innermostMutableVar'

	// Parse a lexical block's statements into `block`, through its closing `end [label]`.
	// The ONE place a block body is parsed, so the scope frame is opened and closed in
	// one place too: an `if` body, an `else` body, a `while`/`for` body and a block-form
	// `otherwise` handler all come through here. The caller has already consumed the
	// block's opening label and passes it as `label`.
	//
	// Returns the block the body's last statement left control in (which is `block`
	// itself only for straight-line code — a nested `if` moves control into its
	// continuation).
	//
	// ⭐ **AN EMPTY LABELLED BLOCK IS E3082**, and it is checked HERE because this is the one routine
	// that sees a NESTED block's statements — which is also exactly why a FUNCTION body is exempt
	// (`function doNothing() end 'doNothing'` is legal, `empty-block.md`'s `valid-empty-function`).
	// The exemption is therefore structural rather than a carve-out anyone has to remember. The check
	// runs before the scope frame opens, so the throw leaves no half-opened block behind, and it is
	// anchored on the closing `end` — where the missing statements would have gone. A body holding
	// only a COMMENT reads as empty, and the spec's own documentation example is exactly that program.
	//
	// ⚠ **THAT HOLDS BECAUSE THE PARSER SKIPS COMMENTS, NOT BECAUSE THE LEXER DROPS THEM.** `//` and
	// `/* … */` are dropped; a `///` doc comment reaches the parser, and this body reads it as empty only because the
	// `skipNewlines` above steps over it (`tokenKindIsSkippedLayout`). Sever that and a block holding one
	// doc-comment line silently stops being empty, so E3082 stops firing on it.
	function parseBlockBody(func IrFunction, block IrBlock, label ByteArray) returns IrBlock throws SourceParseError
		self.skipNewlines()

		if self.at(TokenKind.end) 'emptyBlock'
			let endTok = self.current()
			throw SourceParseError.emptyBlock(String.from(label), line: endTok.line, column: endTok.column)
		end 'emptyBlock'

		let mark = self.openBlock()
		let bodyEnd = try self.parseStatements(func, block: block)

		// ⭐ **DROP THE BLOCK'S OWN OWNED BINDINGS ON FALL-THROUGH** — a `let s = build(i)` inside an
		// `if`/`while` body dies at the block's `end`, so a loop body drops per iteration. Only the
		// bindings the block itself declared (above `mark.ownedCount`); the outer ones drop when THEIR
		// block closes. Emitted into `bodyEnd` — which IS `self.bodyState.currentBlock`, as `parseStatements`
		// threads it — BEFORE `closeBlock` pops them off the list, and before the caller
		// (`parseIfStatement`/`parseWhileStatement`) emits the block's exit jump, so the drops precede
		// the continuation branch / back-edge.
		//
		// ⚠ Skipped on a TERMINATED `bodyEnd`: a `return`/`break`/`continue` on every path has already
		// emitted its own drops (the whole scope, or down to the enclosing loop), so dropping again here
		// would double-free. `isTerminated()` is the
		// guard that makes this an addition rather than that bug.
		if not bodyEnd.isTerminated() 'dropBlockOwned'
			// ⚠ **TWO THINGS HAPPEN HERE AND THEY ARE NOT ONE THING** — which is what this line looked
			// like when the destination was implicit. `emitScopeDrops` is told WHERE THE DROPS GO by its
			// parameter; this assignment is the PARSER'S POSITION, and the header's claim that "`bodyEnd`
			// IS `self.bodyState.currentBlock`, as `parseStatements` threads it" is not true of every body: a block
			// whose last statement is an `if` leaves `currentBlock` behind at that `if`'s continuation, and
			// this re-sync is what put it back. It was invisible while one assignment served both roles —
			// MEASURED when `emitScopeDrops` began restoring what it borrowed: `block-condition-temporaries`'s
			// `if-inside-a-try-handler` left its `ifcont` with no terminator at all, because the code that
			// branches a fallen-through handler to the merge reads `currentBlock`.
			self.bodyState.currentBlock = bodyEnd
			self.emitScopeDrops(bodyEnd, floor: mark.ownedCount, anchor: self.current())
		end 'dropBlockOwned'

		// Published for `parseWhileStatement`'s drift guard — the cursor is ON the `end` here,
		// which is the one place the block's closing token index is known.
		self.statement.lastBlockBodyEnd = self.pos
		try self.consumeBlockEnd(label, labelIsRequired: false)
		self.closeBlock(mark, endsIn: bodyEnd)
		return bodyEnd
	end 'parseBlockBody'

	// Parse a reassignment `<name> = <expr>`. The target must be a declared
	// `var`; a `let` target is E2013, an undeclared name is `undefinedVariable`. The
	// RHS is evaluated FIRST (so `x = x + 1` reads the old `x`), then the binding's
	// current SSA value is rebound to the result via `Scope.setValue` — the read-
	// after-write model that makes a later reference see the new value. No slot,
	// no store op: the value model is on-the-fly SSA (the reassignment is just a
	// rebinding of the variable's current ValueId, and the loop machinery inserts
	// phis where the rebinding crosses a control-flow merge).
	//
	// **THE ASSIGNED VALUE MUST AGREE WITH THE BINDING'S DECLARED TYPE, AND THAT CHECK IS WHAT
	// MAKES EVERY MERGE PHI'S TYPE TRUE.** A binding's type is fixed where it is declared
	// (`var x = 5` is an int) and `VarInfo.varType` holds it; a reassignment does not redeclare
	// it. There are therefore TWO records of a value's type — the per-VALUE column
	// (`self.bodyState.valueTags`, which follows the value) and the per-BINDING one (`varType`, frozen at
	// the declaration) — and they meet in exactly one place: `mintPhiForBinding`, which stamps
	// a merge phi with the BINDING's type while the phi carries the REASSIGNED value.
	//
	// So without this check the binding type is a LIE that the phi launders into the value
	// column, and every rule downstream reads the lie and is satisfied:
	//
	//     var x = 5
	//     if c 'b'
	//         x = false        // unchecked: the binding still claims `int`
	//     end 'b'
	//     return x + 1         // the phi is tagged `integer`, so `+` sees two ints — and adds
	//                          // a bool. THE ENTIRE RUNG, defeated by one `if`.
	//
	// Checking the ASSIGNMENT — one statement — makes all three phi mint sites (if-merge, loop
	// header, loop exit) sound BY CONSTRUCTION, with no per-edge check anywhere. Deriving each
	// phi's tag from its incoming values instead cannot work: the loop-header phi is minted
	// EAGERLY, before the body that writes those values has been parsed.
	//
	// The assignment type check is made HERE, at the statement that introduces the contradiction —
	// like the `if <int>` rule, and for the same reason. Left to the use site, a laundered `var x = 5`
	// / `x = true` surfaces in the Maxon→Std lowering as an INTERNAL error, with no source position.
	function parseAssignment(func IrFunction, block IrBlock) throws SourceParseError
		let nameTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)
		try self.requireAssignmentAllowedInWindows(nameTok)

		// `_ = <expr>` — a DISCARD assignment: evaluate the RHS for its effect and throw the value away. `_`
		// binds nothing (`DiscardBindingName`, the same discard the match-payload `walk(_)` uses), so at file
		// scope and in any function declaring no `_` parameter it would otherwise reach `undefinedVariable`.
		// ⚠ It IS a scope binding inside a function that declares one — a `_` parameter is installed like any
		// other (`bindParameters`) — so this test runs FIRST for a reason: reaching `scope.contains` would make
		// `_ = f()` a rebinding of that parameter (E2013, a parameter is immutable) instead of the discard the
		// language says it is. The arm is the rule, not a fallback. An owned RHS temporary drops at
		// statement end through `drainPendingTemps`, exactly as a bare-call statement's result does. This is
		// the value-position twin of the bare-call statement, reached by `_ = try arr.pop() otherwise 0` and
		// any `_ = f(…)`.
		if nameTok.value.equals(DiscardBindingName) 'discardResult'
			let discardOpFloor = self.artifact.module.ops.count()
			let discardDeferralFloor = self.artifact.deferredChains.count()
			let rhsStart = self.pos
			let discarded = try self.parseExpression(func, block: block)

			// E3067's `_ =` door: the discard opts out of a verdict on an effect, so there must be one.
			// `_ = 42`, `_ = c.name`, `_ = a + b` and `_ = round(1.5)` compute a value nothing would
			// complain about. A call on a deferred value emits no op, so its `deferredChains` row counts
			// as one. Any call in the statement counts, as any op does for `statementCallsOrAwaits`, where
			// the `try` door asks whether the target value itself is a call.
			//
			// A `void` right-hand side cannot reach here — `_ = f()` on a void callee is E2004 from the
			// expression itself — so the void guard `recordDiscardedCallResult` carries for the
			// bare-statement door is not repeated.
			if not self.statementCallsOrAwaits(discardOpFloor) and not self.rhsIsABareBinding(rhsStart) and not self.artifact.deferredChains.recordsACallAbove(discardDeferralFloor) 'nothingWasCalled'
				throw SourceParseError.discardExpectsACall(nameTok.line, column: nameTok.column)
			end 'nothingWasCalled'

			// ⭐ E3064's `_ =` door. `_` does not license a discard of a result nobody reads — it only says the
			// author meant it — so a pure callee is refused here exactly as it is one statement over, anchored on
			// the `_` the author wrote.
			self.recordDiscardedCallResult(discarded, opFloor: discardOpFloor, anchor: nameTok, door: DiscardDoor.explicitDiscard)
			self.noteDiscardedReply(discarded, opFloor: discardOpFloor)
			return
		end 'discardResult'

		if not self.bodyState.scope.contains(nameTok.value) 'undeclared'
			// Not a local. It may still name a top-level binding — a `var` (a STORE) or a `let` (an
			// error, and a DIFFERENT error from "undefined"). LOCAL FIRST, exactly as
			// `parseVariableReference` resolves a read: a local `var` shadows a top-level one, so the
			// top level is consulted only once the name has failed to resolve as a local.
			try self.parseTopLevelAssignment(func, block: block, nameTok: nameTok)
			return
		end 'undeclared'

		// `var`, because the write is RECORDED on the binding below — a `let` here is a store through an
		// immutable local (E2013).
		let binding = self.bodyState.scope.getInfo(nameTok.value)
		try self.requireNotLentToACoroutine(binding, nameTok: nameTok)

		// ⭐ **A WRITE IS A MENTION, AND E3012 COUNTS MENTIONS.** MEASURED against the runnable oracle, both
		// directions on the same three-line program: `var x = 1` alone is `unused variable: 'x'`, and
		// `var x = 1` + `x = 2` compiles and exits 0. So a reassignment satisfies the check even though it
		// reads nothing — which is the honest rule, because the author DID have to name the binding, and the
		// diagnostic's job is to find declarations nothing in the body refers to.
		//
		// It is written here rather than in `requireBindingLive` because a write must NOT go through that
		// guard: an assignment REVIVES a moved-from binding, and routing it there would reject `t = <expr>`
		// after a move as use-after-move (see `parseVariableReference`'s note that the READ site is the only
		// caller). Third door, same chokepoint — see `VarInfo.referenced`.
		self.markBindingReferenced(binding)

		// A bare field name inside an instance method — `count = count + 1`. It is a STORE through
		// the receiver, not a rebinding of anything, so it asks the field's mutability rather than
		// this binding's (see `parseSelfFieldAssignment`) and never reaches `setValue` below.
		if binding.isSelfField 'selfField'
			try self.parseSelfFieldAssignment(func, block: block, nameTok: nameTok, binding: binding)
			return
		end 'selfField'

		try self.requireMutableBinding(binding, nameTok: nameTok)

		let rhsStart = self.pos
		self.stateDeclaredLiteralTarget(binding.varType, scopeFilePath: self.job.path, valueStart: rhsStart)
		let parsedValue = try self.parseExpression(func, block: block)
		try self.requireAssignmentAllowedInWindows(nameTok)

		// WHICH local the RHS was a bare reference to (`s = t`), empty for every other RHS. Only that shape
		// can MOVE an owned value out of a source binding; every other RHS is a consume. The NAME rather
		// than the bool, because the rebind asks two questions of it — may this poison anything, and was
		// that local declared `let` (`rebindSourceIsAnImmutableAlias`) — and one walk answers both. Captured
		// off the token position, before any further token is consumed (see `rhsBareLocalSourceName`).
		let rhsBareLocalName = self.rhsBareLocalSourceName(rhsStart)

		// ⭐ AN ASSIGNMENT IS AN INTEGER-EXPECTING POSITION when the binding declares an integral type, so a
		// character literal RHS coerces to its codepoint — `b = '0'` into a `var b Byte`. A `Character` binding
		// needs nothing: the literal already IS one. See `integerizedOperand`.
		let declaredTag = maxonTypeTag(binding.varType)
		let value = try self.integerizedOperand(parsedValue, expected: declaredTag, start: rhsStart, pastEnd: self.pos)

		try self.completeLocalRebind(func, binding: binding, nameTok: nameTok, written: value, rhsBareLocalName: rhsBareLocalName, valueStart: rhsStart, valueEnd: self.pos)
	end 'parseAssignment'

	// ⭐⭐ **A LOCAL REBIND, FROM THE TYPE CHECK TO THE STORE — everything `x = <expr>` still owes once its
	// value exists.** SHARED with a tuple assignment's bare target, which arrives here holding an element of
	// an already-evaluated tuple rather than a freshly parsed expression. A second copy of this list is not
	// a duplication risk in the abstract: it is the concrete way a rebind comes to skip the aggregate-retype
	// refusal, or to store past a cell, or to leave a mutated payload unwritten.
	//
	// ⚠ **THE CHECK THAT RUNS *BEFORE* THE RIGHT-HAND SIDE IS DELIBERATELY NOT IN HERE** —
	// `requireMutableBinding` is asked by each caller at ITS OWN point. For
	// `parseAssignment` that point is before the RHS is parsed, and moving it after would reorder two true
	// complaints about one statement (`let x = 0` / `x = nosuch()` reports E2013 today, the RHS's error
	// afterwards). A tuple assignment cannot ask it there — its RHS is evaluated once, ahead of every
	// target — so it asks it per target, in target order, which is the order its own pins read in.
	function completeLocalRebind(func IrFunction, binding VarInfo, nameTok Token, written ValueId, rhsBareLocalName SourceBinding, valueStart ElementIndex, valueEnd ElementIndex) throws SourceParseError
		let value = try self.destinationTemporary(written, declared: binding.varType, anchor: nameTok)
		let declaredTag = maxonTypeTag(binding.varType)
		let valueTag = self.tagOf(value)

		// The binding keeps its declared type across a rebind, so `x = 3` into a `var x = 0.0` rebinds to
		// a widened float. Without the coercion `x == 3.0` on the next line would be refused E3005, and a
		// rebind inside a loop would feed an i64 and an f64 into one header phi.
		let assigned = try self.assignableValue(nameTok, value: value, declared: declaredTag, declaredNameId: typeNameIdOf(self.bindingDeclaredType(binding)), door: FunctionTypeDoor.variable, placeOwner: SlotOwner.unowned, voice: SlotMismatchVoice.assignedPlace)

		// Reassigning a `var` to the wrong named aggregate — a different struct/union, or an aggregate
		// where the binding declares a scalar — is a retype the tag check above cannot see
		// (`structRef == structRef` for any two structs; a boxed union and a ranged-int alias share
		// `named`), and the overwritten box would later be dropped under the binding's declared
		// destructor. `assignableValue` stays tag-based because it is shared with the global-store and
		// field callers. Identity is the interned name, exact, read off the parsed value: a widening only
		// ever produces a float scalar, whose aggregate name is empty either way.
		//
		// ⚠ The two names decide the verdict and do not spell it: for a generic instance they are the
		// canonical `Box_Leaf`, which no source line holds. The message renders through
		// `displayTypeNameOf`, as the argument voice does, so the author's `LeafBox` is what both say.
		let declaredAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: declaredTag, nameId: typeNameIdOf(binding.varType), readerFilePath: self.job.path)
		let assignedAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: valueTag, nameId: self.valueNameId(value), readerFilePath: self.job.path)
		let declaredBrand = self.internedName(binding.brandId)

		if self.signatures.aggregatesConflict(declaredAggregate, expectedTag: declaredTag, expectedNameId: typeNameIdOf(binding.varType), expectedBrand: declaredBrand, got: assignedAggregate, gotTag: valueTag, gotNameId: self.valueNameId(value), gotBrand: self.brandOf(value), readerFilePath: self.job.path) 'aggregateReassignMismatch'
			let declaredShown = self.brandedDisplayTypeName(declaredTag, nameId: typeNameIdOf(binding.varType), brand: declaredBrand)
			let paired = self.pairedDisplays(value, declaredTag: declaredTag, declaredNameId: typeNameIdOf(binding.varType), declaredBrand: declaredBrand, declaredIdentity: declaredAggregate, declaredShown: declaredShown)
			try self.refuseUnlessDeferred(SourceParseError.assignTypeMismatch(assignedPlacePhrase(FunctionTypeDoor.variable, name: nameTok.value, owner: SlotOwner.unowned), got: paired.got, gotNote: paired.gotNote, expected: paired.declared, expectedNote: paired.declaredNote, line: nameTok.line, column: nameTok.column, crossesRange: self.signatures.crossesIntegerRange(declaredTag, expected: declaredAggregate, gotTag: valueTag, got: assignedAggregate)), value: value)

			// The local takes the deferred value, so its later reads raise no E3142/E3102 behind the
			// E3004 the deferral waits for.
			if not binding.isCellBinding 'aLocalTakesTheDeferredValue'
				try self.reassignBindingValue(func, binding: binding, nameTok: nameTok, value: value, rhsBareLocalName: rhsBareLocalName)
			end 'aLocalTakesTheDeferredValue'

			return
		end 'aggregateReassignMismatch'

		self.adoptFirstBrandedStore(binding, value: value, nameTok: nameTok)

		if not declaredBrand.isEmpty() and valueTag == ValueTypeTag.genericInstance 'aBrandedVarMayMeetAnUnadoptedRead'
			self.recordUnadoptedBrandDoor(value, expected: declaredBrand, door: FunctionTypeDoor.variable, placeName: nameTok.value, owner: SlotOwner.unowned, anchor: nameTok)
		end 'aBrandedVarMayMeetAnUnadoptedRead'

		// ⭐ A FRESH UNBRANDED VALUE STORED INTO A BRANDED BINDING TAKES THE BINDING'S BRAND — `ys = [2]` leaves
		// `ys` a `Ys` for every later reader. A bare local on the right keeps its own (unbranded) value: stamping
		// it would rebrand the other binding too.
		if not rhsBareLocalName.isLocal() 'aFreshValue'
			self.brandValue(value, brand: declaredBrand)
		end 'aFreshValue'

		self.stampDeclaredFunctionType(assigned, binding: binding, sourceIsBareLocal: rhsBareLocalName.isLocal())

		let stored = self.storedValueNamedByBinding(assigned, binding: binding, nameTok: nameTok, sourceIsBareLocal: rhsBareLocalName.isLocal())
		try self.requireAssignmentFitsVariable(binding, value: written, valueStart: valueStart, valueEnd: valueEnd)

		if not rhsBareLocalName.isLocal() and valueIsMarked(self.bodyState.unsignedMaxLiterals, value: stored) and maxonTypeTag(binding.varType) == ValueTypeTag.named and self.declaresARangedAlias(self.declaredAliasOfType(binding.varType), t: binding.varType) 'anUnsignedLiteralTakesTheBindingsAlias'
			self.recordValueDeclaredAliasId(stored, aliasId: typeNameIdOf(binding.varType))
		end 'anUnsignedLiteralTakesTheBindingsAlias'

		// ⭐⭐ **A CELL-RESIDENT BINDING IS REBOUND BY STORING, NOT BY `Scope.setValue`.** It never
		// reaches `reassignBindingValue`: that routine's whole job is to move a binding from one SSA value to
		// another and release what the old one owned, and a cell binding holds no SSA value to move — its
		// contents live in memory, where a later read will find them. The release of the displaced occupant is
		// the same obligation, discharged against the memory rather than against a value id.
		if binding.isCellBinding 'livesInACell'
			try self.reassignCellBinding(func, binding: binding, nameTok: nameTok, value: stored, rhsBareLocalName: rhsBareLocalName)
			return
		end 'livesInACell'

		try self.reassignBindingValue(func, binding: binding, nameTok: nameTok, value: stored, rhsBareLocalName: rhsBareLocalName)
	end 'completeLocalRebind'

	function stampDeclaredFunctionType(value ValueId, binding VarInfo, sourceIsBareLocal bool)
		if sourceIsBareLocal or self.tagOf(value) != ValueTypeTag.function or maxonTypeTag(binding.varType) != ValueTypeTag.function 'nothingToStamp'
			return
		end 'nothingToStamp'

		let declared = binding.brandId if binding.brandId != UnnamedTypeId else typeNameIdOf(binding.varType)
		try self.bodyState.valueBrandIds.set(value, value: declared) otherwise panic("stampDeclaredFunctionType: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
	end 'stampDeclaredFunctionType'

	function adoptFirstBrandedStore(binding VarInfo, value ValueId, nameTok Token)
		let brand = self.brandIdOf(value)

		if binding.brandId != UnnamedTypeId or self.tagOf(value) != ValueTypeTag.genericInstance 'nothingToAdopt'
			return
		end 'nothingToAdopt'

		if brand != UnnamedTypeId 'aBrandedStore'
			self.bodyState.scope.adoptBrand(binding.name, brandId: brand)
		end 'aBrandedStore'

		if not binding.brandKey.isEmpty() 'aVarOthersMayAlsoStoreInto'
			self.recordAdoptableStore(binding.brandKey, declaredBrand: EmptySourceText, valueType: binding.varType, value: value, phrase: assignedPlacePhrase(FunctionTypeDoor.variable, name: nameTok.value, owner: SlotOwner.unowned), anchor: nameTok)
		end 'aVarOthersMayAlsoStoreInto'
	end 'adoptFirstBrandedStore'

	function storedValueNamedByBinding(value ValueId, binding VarInfo, nameTok Token, sourceIsBareLocal bool) returns ValueId
		let declaredType = self.bindingDeclaredType(binding)
		let declaredAlias = self.declaredAliasOfType(declaredType)
		let alias = try self.rangeCheckedAlias(declaredAlias, t: declaredType) otherwise return value
		self.recordRangedTargetSite(value, target: alias, line: nameTok.line, column: nameTok.column)
		return self.nameValueAsDeclaredType(value, targetType: declaredType, targetAlias: declaredAlias, opTok: nameTok, sourceIsBareLocal: sourceIsBareLocal, mustCarryTargetType: false)
	end 'storedValueNamedByBinding'

	function bindingDeclaredType(binding VarInfo) returns MaxonType
		if tagIsFloat(maxonTypeTag(binding.varType)) and self.valueNameId(binding.boundValue) != UnnamedTypeId 'aFloatAliasBinding'
			return MaxonType.named(self.valueNameId(binding.boundValue))
		end 'aFloatAliasBinding'

		return binding.varType
	end 'bindingDeclaredType'

	function valueIsAnUnboxedUnion(value ValueId) returns bool
		if self.tagOf(value) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		let decl = self.enumMatchFor(value)
		return enumMatchIsDeclared(decl) and self.signatures.unionRepresentation(requireEnumLayout(decl)) == UnionRepresentation.word
	end 'valueIsAnUnboxedUnion'

	// ⭐ **REBIND A `var` TO A NEW VALUE, RELEASING WHAT IT OWNED.** The rebinding half is one line —
	// `Scope.setValue` — but a `var` that owns a heap allocation (an owned interpolation String, a
	// struct box) must DROP that allocation as it is overwritten, or it leaks: a binding's scope-exit
	// drop only ever reaches the LAST value it was assigned, so every earlier one is lost.
	//
	// A missed drop leaks every overwritten value, and a wrong one double-frees and reads freed memory,
	// because `__mm_free` reclaims.
	//
	// ⚠ **OWNERSHIP IS BINDING-LEVEL: `wasOwned` reads membership in `ownedBindings` (`bindingIsOwned`),
	// NEVER `valueIsOwnedHeap(oldValue)`.** A loop-carried `var`'s current value is a header phi, and a
	// phi carries no owned-heap provenance bit (the bit rides the value flowing INTO the merge, not the
	// merge) — so the value column reads `false` for a binding the loop genuinely owns, and the
	// overwritten allocation would leak every iteration. Membership is the only record that survives the
	// phi. `newIsOwned` is `valueIsOwnedHeap` — the SAME predicate `parseBinding` enrols a fresh binding by —
	// so the reassign and the declaration cannot drift on what "owned" means.
	//
	// ⚠ **AN OWNED BINDING STAYS OWNED — a borrowed RHS is PROMOTED to an owned copy rather than the
	// binding being removed from `ownedBindings`.** Removal would be a middle-of-stack delete, and
	// `ownedBindings` is a STACK whose heights the block/loop drop marks (`BlockMark.ownedCount`,
	// `LoopContext.ownedFloor`) index into: reassigning an OUTER owned `var` to a literal inside a
	// nested block would delete a below-mark entry, shift every block-local drop down one slot, and
	// strand a block-local binding to be dropped at function exit on a path where its value is not even
	// defined (a register-allocator "use dominates def" panic, verified). Promoting the literal to an
	// owned heap copy — the SAME fused-record copy the `binding` door itself makes (`promoteToOwnedString`;
	// a borrowed `return` RETAINS instead) —
	// keeps every reassignment of an owned binding a uniform owned→owned: the binding never moves, and
	// an `if`/loop merge is handled by the phi machinery exactly as for any other carried value.
	// ⭐ **ALLOCATE A CELL — one machine word on the heap, with the trivial destructor every the compiler box carries.**
	// The ONE allocation site, shared by a cell-resident LOCAL and an r-value SCRATCH cell, so the two cannot
	// come to disagree about a cell's size or its drop.
	//
	// ⚠ **HEAP AND NOT A STACK SLOT, WHICH IS THE RUNG'S RULED DESIGN AND NOT A CONVENIENCE.** The compiler
	// has no addressable locals — a binding is an SSA value, there is no `stackAddr` and no mem2reg —
	// so there is no stack address to hand a callee; and `wasm32-wasi` cannot take the address of a
	// local at all, so a stack-slot design would have to box into linear memory there anyway.
	// ⭐⭐ **THE CELL VALUE IS TYPED AS WHAT IT HOLDS, NOT AS THE POINTER IT IS — AND THAT IS THE DECISION
	// THAT KEEPS EVERY TYPE RULE IN THE COMPILER WORKING ON A CELL-RESIDENT BINDING.** The cell stands for the
	// binding, and the binding's type is its declared one, so `SemanticCheck.checkArgTypes` compares a `Node`
	// against a `Node` at a by-reference argument, `enumMemberReadableOff` still sees a `named` value where an
	// enum accessor is legal, and `requireStructBase` still finds a layout. MEASURED as the alternative:
	// tagged `integer`, every one of those read the ADDRESS's type and answered about the wrong thing —
	// `argument type mismatch for 'cur': expected 'Node', got 'int'` on six cases and
	// `a field access on 'c', which is declared 'int'` on a seventh.
	//
	// ⚠ **THE ONE READER THAT MUST NOT BELIEVE IT IS THE DROP ROUTER, AND IT IS HANDLED WHERE IT LIVES.**
	// `decrefCalleeFor` routes on the tag, so a `Node`-tagged cell would be freed through `__destruct_Node` —
	// running a struct's cascade over a cell. `emitScopeRelease`'s cell arm therefore frees the box
	// EXPLICITLY (`__mm_decref`) instead of asking the router, and releases the occupant through
	// `emitCellOccupantRelease`, which hands the router the LOADED record — the value the router is actually
	// right about — and releases a promise occupant in place.
	//
	// The ABI is unaffected: which parameters are addresses is `IrFunction.reassignedParamMask`'s answer, and
	// the lowering reads that rather than a tag.
	function allocateCell(declared MaxonType, range SourceRange) returns ValueId
		return self.emitRuntimeCall(ParameterCellAllocName, args: ValueIdArray.create(0), resultTag: maxonTypeTag(declared), resultNameId: typeNameIdOf(declared), range: range)
	end 'allocateCell'

	// Move `value` into a freshly allocated cell and hand the cell back — the shared body of the two things
	// that put a value into one for the first time: a cell-resident LOCAL's initializer and an r-value
	// SCRATCH cell's spill. Both owe the identical three steps (allocate, take ownership, store), and the
	// ownership step is the one that must not be written twice: a managed value moved into durable storage
	// has to be de-listed from the statement's pending drops, or the statement end frees what the cell holds.
	// A scratch cell that only lends a promise skips the take and fills through `fillCellWith`.
	function fillFreshCell(value ValueId, declared MaxonType, crossesByReference bool, rhsWasBareLocal bool, anchor Token) returns FilledCell throws SourceParseError
		let stored = try self.valueACellTakes(value, varType: declared, crossesByReference: crossesByReference, rhsWasBareLocal: rhsWasBareLocal, anchor: anchor)
		return self.fillCellWith(value, stored: stored, declared: declared, anchor: anchor)
	end 'fillFreshCell'

	function fillCellWith(value ValueId, stored ValueId, declared MaxonType, anchor Token) returns FilledCell
		let range = SourceRange.ofToken(anchor)
		let cell = self.allocateCell(declared, range: range)
		self.wearAliasOf(cell, source: value)

		self.storeCellOccupant(cell, cellType: declared, value: stored, range: range)

		// The FIRST value into a cell hands it the occupant's facts and the incoming value's brand. The brand is
		// asked of `value` rather than of `stored`, because the ownership move above mints the occupant.
		self.wearBrandIfUnbranded(cell, brand: self.brandIdOf(value))
		self.carryFromSharedRecord(cell, from: stored, source: self.bodyState, path: ValueCarryPath.cellStore)

		self.markValueOwnsHeap(cell, exclusivity: OwnedHeapExclusivity.sole)
		return FilledCell.create(cell, epoch: self.mintCellEpoch(self.storedOccupantExclusivity(stored)))
	end 'fillCellWith'

	function storedOccupantExclusivity(stored ValueId) returns CellOccupantExclusivity
		return CellOccupantExclusivity.sole if self.valueIsSolelyOwnedHere(stored) else CellOccupantExclusivity.coOwned
	end 'storedOccupantExclusivity'

	// ⭐⭐ **DECLARE A CELL-RESIDENT LOCAL.** The cell is this frame's: it is enrolled in
	// `ownedBindings`, so `emitScopeRelease` releases what it holds and then frees it — the two-step drop that
	// header describes.
	//
	// ⚠ **IT IS DELIBERATELY NOT PUSHED INTO `mutableVars`, AND THAT IS THE POINT OF THE WHOLE DESIGN.** A
	// loop header mints a phi for every mutable binding in scope that the token scan sees assigned; a cell
	// binding must mint NONE, because its name denotes a pointer that never changes and its value lives in
	// memory. Tracking it would hand `mintLoopHeaderPhis` a binding whose `boundValue` is the CELL and
	// let the header rebind that — turning the address into a phi of addresses, one per iteration, of
	// which only the first is real.
	//
	// ⚠ The E3012 candidacy is owed exactly as it is by a value
	// binding: it is the same declaration wearing a different representation, and it asks
	// nothing about how a name is stored.
	// ⚠ It returns NOTHING, deliberately. Handing the binding back lets its one caller — a VOID function —
	// write `return try self.declareCellLocal(…)`, producing an owned `VarInfo` that nothing drops: an
	// `MM leak: 7 allocation(s) remain` in the COMPILER, on every program that declares a cell-resident
	// local. Nothing wants the binding back; the scope and `ownedBindings` both hold it.
	function declareCellLocal(nameTok Token, boundValue ValueId, rhsWasBareLocal bool) throws SourceParseError
		let declared = self.typeOf(boundValue)
		let crossesByReference = true
		let filled = try self.fillFreshCell(boundValue, declared: declared, crossesByReference: crossesByReference, rhsWasBareLocal: rhsWasBareLocal, anchor: nameTok)
		self.carryCapability(boundValue, target: filled.cell)
		let binding = try self.bodyState.scope.declareCellBinding(nameTok.value, varType: declared, kind: BindingKind.var, cell: filled.cell, epoch: filled.epoch, isParameter: false, crossesByReference: crossesByReference, brandId: self.brandIdOf(boundValue)) otherwise throw SourceParseError.localShadowsSelfField(String.from(nameTok.value), typeName: String.from(self.enclosingTypeName()), line: nameTok.line, column: nameTok.column)
		self.keyAdoptableLocal(nameTok, kind: BindingKind.var, value: boundValue)
		self.trackDebugLocal(binding)
		self.enrolOwnedBinding(binding)
	end 'declareCellLocal'

	// ⭐⭐ **SPILL AN R-VALUE INTO A SCRATCH CELL FOR A BY-REFERENCE ARGUMENT** — `reassign(41)`,
	// `reassign(makeVal())`, `reassign(Node.create(1))`. An r-value has no caller-side binding and therefore no
	// cell, but the callee's ABI still expects an address, so the caller materializes one.
	//
	// ⭐ **THE SLOT IS AN ANONYMOUS CELL BINDING, NOT A THIRD KIND OF TEMPORARY**, which is what gives
	// it a correct drop for free: `emitScopeRelease` already releases a cell's occupant and then the
	// cell, so the FINAL occupant — whether the callee replaced it or not — is released exactly once. A
	// promise some binding or slot still owns is LENT instead: the cell holds the handle without taking it,
	// is marked in `borrowedScratchCells`, and releases only its box.
	// This shape identifies the slot by WHAT IT IS rather than by an id ordering, so there is no sweep to
	// widen and no uninitialised stack to decref —
	// the cell is written by the spill before anything can read it, and it is a fresh allocation
	// rather than a slot the entry zero-init loop might or might not cover. `buildClosureEnv`'s env
	// block is the same "anonymous owned thing on the binding stack" shape.
	//
	// ⚠ It drops at the enclosing BLOCK's exit rather than at the statement's, which is later than strictly
	// needed and is the conservative direction: the callee may have stored the argument somewhere the caller
	// still reads through this statement, and a block is the smallest region the drop machinery indexes.
	function materializeByRefScratchCell(value ValueId, cellType MaxonType, anchor Token) returns ValueId throws SourceParseError
		// The call site reaches here only when the argument did NOT resolve to a cell-resident binding, so an
		// owned value moves in as an r-value and moves nothing out of another name.
		let lendsAPromise = self.cellHoldsAPromise(cellType) and self.valueIsPromise(value) and not self.pendingTempsContain(value)

		let filled = self.fillCellWith(value, stored: value, declared: cellType, anchor: anchor) if lendsAPromise else try self.fillFreshCell(value, declared: cellType, crossesByReference: true, rhsWasBareLocal: false, anchor: anchor)

		if lendsAPromise 'theCellOnlyLendsTheHandle'
			self.bodyState.borrowedScratchCells = withValueMarked(self.bodyState.borrowedScratchCells, value: filled.cell)
		end 'theCellOnlyLendsTheHandle'

		self.enrolOwnedBinding(VarInfo.createCellBinding(EmptySourceText, varType: cellType, kind: BindingKind.let, cell: filled.cell, epoch: filled.epoch, isParameter: false, crossesByReference: true))
		self.bodyState.scratchCellFills = withScratchCellFill(self.bodyState.scratchCellFills, cell: filled.cell, value: value)
		return filled.cell
	end 'materializeByRefScratchCell'

	function argumentValueOf(argValue ValueId, anchor Token) returns ValueId
		if not valueIsMarked(self.bodyState.argumentStorage, value: argValue) 'handedAsAValue'
			return argValue
		end 'handedAsAValue'

		if let filled = try self.scratchCellFillOf(argValue) 'aScratchCellsOwnFill'
			return filled
		end 'aScratchCellsOwnFill'

		return self.emitCellLoad(self.typeOf(argValue), box: argValue, range: SourceRange.ofToken(anchor))
	end 'argumentValueOf'

	function valueHandedThrough(argValue ValueId) returns ValueId
		return try self.scratchCellFillOf(argValue) otherwise argValue
	end 'valueHandedThrough'

	function scratchCellFillOf(cell ValueId) returns ValueId throws AbsentError
		match self.bodyState.scratchCellFills 'state'
			unwritten then throw AbsentError.absent
			entries(fills) then return try fills.get(cell) otherwise throw AbsentError.absent
		end 'state'
	end 'scratchCellFillOf'

	// The one ownership test the fill, the rebind and the scope drop share, so a cell never releases what it
	// did not take; the scope drop also skips the occupant of a cell that only lends a promise
	// (`borrowedScratchCells`). An opaque `T` cell whose owner type nothing instantiates owns nothing: no call site can
	// supply the descriptor its take and release would go through.
	function cellOwnsItsOccupant(varType MaxonType, crossesByReference bool) returns bool
		if maxonTypeTag(varType) == ValueTypeTag.typeParameter 'anOpaqueOccupant'
			return crossesByReference and self.signatures.typeParamOwnerIsInstantiated(typeParamIdOf(varType))
		end 'anOpaqueOccupant'

		return self.signatures.typeOwesDropFor(varType, from: self.artifact.typeNames, readerFilePath: self.job.path)
	end 'cellOwnsItsOccupant'

	function cellHoldsAPromise(varType MaxonType) returns bool
		return self.signatures.typeIsAGreenThreadHandle(varType, from: self.artifact.typeNames)
	end 'cellHoldsAPromise'

	function emitCellOccupantRelease(varType MaxonType, box ValueId, range SourceRange)
		self.releaseDisplacedCellOccupant(varType, displaced: self.displacedCellOccupant(varType, box: box, range: range), box: box, range: range)
	end 'emitCellOccupantRelease'

	function displacedCellOccupant(varType MaxonType, box ValueId, range SourceRange) returns ValueId
		if self.cellHoldsAPromise(varType) 'aPromiseOccupant'
			return self.emitIndirectLoad(MaxonType.integer, box: box, offset: ParameterCellValueOffset, storageType: MaxonType.integer, range: range)
		end 'aPromiseOccupant'

		return self.emitCellLoad(varType, box: box, range: range)
	end 'displacedCellOccupant'

	function releaseDisplacedCellOccupant(varType MaxonType, displaced ValueId, box ValueId, range SourceRange)
		if self.cellHoldsAPromise(varType) 'aPromiseOccupant'
			self.emitPromiseRelease(displaced, range: range)
			self.retireEveryPendingReadOfSlot(box, index: self.emitLiteral(ParameterCellValueOffset as FullRangeInt, valueType: MaxonType.integer, range: range))
			return
		end 'aPromiseOccupant'

		self.emitDecref(displaced, range: range)
	end 'releaseDisplacedCellOccupant'

	function valueACellTakes(value ValueId, varType MaxonType, crossesByReference bool, rhsWasBareLocal bool, anchor Token) returns ValueId throws SourceParseError
		if not self.cellOwnsItsOccupant(varType, crossesByReference: crossesByReference) 'ownsNothing'
			return value
		end 'ownsNothing'

		if self.cellHoldsAPromise(varType) 'aPromiseOccupant'
			return try self.storedPromiseValue(value, storage: genericInstanceIdOf(self.resolvedSlotType(varType)), anchor: anchor, range: SourceRange.ofToken(anchor))
		end 'aPromiseOccupant'

		let taken = try self.ownedValueACellTakes(value, varType: varType, rhsWasBareLocal: rhsWasBareLocal, anchor: anchor)
		self.carryValueFacts(taken, from: value, source: self.bodyState, path: ValueCarryPath.value)
		return taken
	end 'valueACellTakes'

	function ownedValueACellTakes(value ValueId, varType MaxonType, rhsWasBareLocal bool, anchor Token) returns ValueId throws SourceParseError
		if maxonTypeTag(varType) == ValueTypeTag.typeParameter 'throughTheDescriptor'
			return try self.moveOpaqueValueInto(value, argBareLocal: rhsWasBareLocal, slot: DurableOpaqueSlot.inCell, range: SourceRange.ofToken(anchor))
		end 'throughTheDescriptor'

		let range = SourceRange.ofToken(anchor)
		let moved = try self.moveManagedValueInto(value, argBareLocal: rhsWasBareLocal, isString: tagIsByteRecord(maxonTypeTag(varType)), range: range)

		return self.unsharedStoredByteRecord(moved, range: range)
	end 'ownedValueACellTakes'

	// ⭐⭐ **REBIND A CELL-RESIDENT BINDING — THE WRITE A CALLER OBSERVES.** A durable slot's write is THREE
	// things and not one — take ownership of the new value, RELEASE the record the slot was holding, then
	// store.
	//
	// ⚠ **THE ORDER IS LOAD-BEARING IN BOTH DIRECTIONS.** The release must come AFTER the new value is settled
	// (`n = Node.create(n.value + 1)` reads the old occupant while building the new one) and BEFORE the store
	// overwrites the only pointer to it. `reassignBindingValue`'s own header states the same rule for a `var`:
	// *"release the overwritten allocation BEFORE the rebind, while `oldValue` still names it"*.
	//
	// ⚠ **THE DISPLACED VALUE IS LOADED RATHER THAN REMEMBERED.** A cell's occupant
	// may have been written by a CALLEE through the very pointer this binding holds, so an SSA value the parser
	// captured earlier is not what the cell contains — releasing that would free a record the cell no longer
	// holds and leak the one it does. The load is what the cell actually holds at this instant, which is the
	// only thing a release may act on. (`emitOpaqueSlotReleases` reaches the identical conclusion for a
	// writable tuple slot.)
	//
	// ⚠ **A CELL THAT OWNS NOTHING (`cellOwnsItsOccupant`) IS A BARE STORE.** No release is owed and none is
	// emitted, so a by-reference `int`, `float`, `bool`, byte or enum parameter costs exactly one
	// `storeIndirect` per rebind. An owning opaque `T` cell takes and releases through the descriptor.
	function reassignCellBinding(func IrFunction, binding VarInfo, nameTok Token, value ValueId, rhsBareLocalName SourceBinding) throws SourceParseError
		let range = SourceRange.ofToken(nameTok)

		let crossesByReference = binding.cellCrossesByReference

		func.storedParamMask = func.storedParamMask or self.paramMaskOfValue(func, value: binding.boundValue)

		let stored = binding

		if not self.cellOwnsItsOccupant(binding.varType, crossesByReference: crossesByReference) 'scalarCell'
			stored.cellEpoch = CellEpoch.current(self.mintCellEpoch(CellOccupantExclusivity.coOwned))
			stored.noteWritten(self.bodyState.moveLedger)
			self.emitCellStore(binding, value: value, range: range)
			return
		end 'scalarCell'

		// The cell is DURABLE STORAGE, exactly as a global's slot or a struct field is, so the new value is
		// stored through the one door all of them share: a borrowed RHS (an element read out of a container, a
		// String literal) is promoted to something the cell may own and drop, and an owned temporary is de-listed
		// from the statement's pending drops so the statement end does not free what the cell now holds.
		//
		// ⭐⭐ **AND AN OWNED VALUE A LIVE BINDING KEEPS IS CO-OWNED — SO THIS IS THE ONE REBIND THAT IS NOT A
		// MOVE (⚖ user ruling, 2026-08-12).** `byRefParam = t` reads as a rebind and is a durable STORE, because
		// the cell is the CALLER's storage and outlives this frame: the caller will read what is written here
		// long after `t`'s scope has ended. So the cell takes its own reference and `t` stays live with its own
		// — where a plain local rebind (`s = t`, `reassignBindingValue`) still MOVES, the new name inheriting the
		// drop the old one owed. `moveManagedValueInto`'s header states the rule and names this exception; the
		// two are stated together because "a rebind moves" is true of one door and false of this one.
		let owned = try self.valueACellTakes(value, varType: binding.varType, crossesByReference: crossesByReference, rhsWasBareLocal: rhsBareLocalName.isLocal(), anchor: nameTok)

		let displaced = self.displacedCellOccupant(binding.varType, box: binding.boundValue, range: range)
		self.emitCellStore(binding, value: owned, range: range)
		self.releaseDisplacedCellOccupant(binding.varType, displaced: displaced, box: binding.boundValue, range: range)
		stored.cellEpoch = CellEpoch.current(self.mintCellEpoch(self.storedOccupantExclusivity(owned)))
		stored.noteWritten(self.bodyState.moveLedger)
		stored.revive(self.bodyState.moveLedger)
	end 'reassignCellBinding'

	// The binding STAYS in `ownedBindings` (mid-stack removal would desync the block/loop drop marks),
	// so it is marked MOVED to make `emitScopeDrops` skip it — a value owning nothing must not be
	// `__mm_decref`'d.
	//
	// ⚠ **READS STILL WORK, AND THAT RESTS ON `setValue` RUNNING FIRST.** `requireUnmovedAtUse`'s
	// escape excludes a PROMISE-valued binding, so what admits this one is that `setValue` has ALREADY
	// re-pointed `boundValue` at the new value: the binding being asked about is no longer a promise.
	// (A consume record an earlier `await` made is keyed on the OLD value and stays there — correctly,
	// since an alias may still name that thread.)
	function rebindToAValueOwningNothing(binding VarInfo, nameTok Token, value ValueId)
		self.recordDebugRebindByName(nameTok.value, value: value)
		self.bodyState.scope.setValue(nameTok.value, value: value, ledger: self.bodyState.moveLedger)
		binding.setMovedFrom(true, ledger: self.bodyState.moveLedger)
		binding.partiallyMoved = false
		self.removeFromPendingTemps(value)
	end 'rebindToAValueOwningNothing'

	function reassignBindingValue(func IrFunction, binding VarInfo, nameTok Token, value ValueId, rhsBareLocalName SourceBinding) throws SourceParseError
		try self.requireNoUniqueAlias(value, action: "assign to '{String.from(nameTok.value)}'", anchor: nameTok)
		let oldValue = binding.boundValue
		let rhsWasBareLocal = rhsBareLocalName.isLocal()

		// ⭐⭐ **AN IMMUTABLE SOURCE ALIASES WHERE A MUTABLE ONE MOVES (the ownership ruling, 2026-08-04),
		// AND THIS DOOR IS WHERE THE DECLARATION ONE'S EXEMPTION WAS MISSING.** Read once, here, because the
		// two halves of what it means are spent far apart: the poison below is SKIPPED, and the reference
		// that skip makes this binding owe is taken at the promotion point.
		let aliasesImmutableSource = rhsWasBareLocal and self.nameAliasesItsSource(BindingKind.var, sourceName: rhsBareLocalName, value: value)

		// A SELF-REBIND OF A LIVE BINDING — it is assigned the value it already holds AND still owns, so
		// the value and its ownership are both unchanged: nothing to drop and nothing to reclassify.
		// Guarding here is also what keeps a loop self-assign — where `oldValue` is a provenance-free phi —
		// from being misread and re-tracked (the phi carries no owned-heap bit, so the general path would
		// `promoteBorrowed` it), and prevents a drop-then-keep (decref'ing a value the binding still holds).
		//
		// ⚠ **THE TEST IS VALUE IDENTITY, NOT SPELLING, AND THE SPELLING `s = s` NO LONGER REACHES IT** —
		// it is refused at the door as E3067 (see `rejectDegenerateAssignment`).
		//
		// ⭐⭐ **BUT VALUE IDENTITY ALONE IS THE WRONG QUESTION WHEN THE BINDING IS MOVED-FROM — THAT IS
		// OWNERSHIP BEING HANDED BACK, THE EXACT OPPOSITE OF A NO-OP.** A move does not mint a value, it
		// re-homes one: `var b = a` gives `b` `a`'s very ValueId, so `a = b` satisfies `oldValue == value`
		// while meaning *`a` owns it again and `b` must not*. Eliding it left BOTH halves undone — `a`
		// still poisoned (E3102 on the next read of it) and `b` still live — i.e. a statement with no
		// effect whatsoever. `specs/optimizer-refcount.md`'s whole-program baseline is the pin.
		//
		// The gate sends only that shape down the general path below, which already does the entire job
		// and adds no refcount traffic (the value genuinely does not change): `moveOnAssign` poisons the
		// source, `wasOwned` is false so nothing is decref'd, `inOwnedSet` is true so the revived binding
		// is not re-enrolled, and the revive clears the bit — one box, still exactly one drop, now owed by
		// this binding instead of the source's.
		if oldValue == value and not binding.movedFrom 'selfAssign'
			self.recordDebugRebindByName(nameTok.value, value: value)
			self.bodyState.scope.setValue(nameTok.value, value: value, ledger: self.bodyState.moveLedger)
			return
		end 'selfAssign'

		// ⭐ **RE-ARM A PROMISE BINDING.** A promise is a scalar green-thread handle with a
		// bespoke drop (`__gt_promise_drop`), never COW-promoted — so a binding that owns (or receives) a
		// thread MUST be handled here, before the heap move/promotion path below (which would `promoteBorrowed`
		// a scalar and panic).
		let oldIsPromise = self.valueOwnsGreenThread(oldValue)
		let newIsPromise = self.valueOwnsGreenThread(value)

		if oldIsPromise or newIsPromise 'promiseReassign'
			// ⚠ **"STILL OWNS A LIVE THREAD" IS READ FROM MEMBERSHIP, NOT `valueOwnsGreenThread(oldValue)`.** A
			// loop-header / if-merge phi carries no promise mark, so the value bit is phi-BLIND — a re-armed
			// `var p` across a merge holds that unmarked phi as `oldValue`. Membership is the SAME source the
			// heap path reads for exactly this reason (`wasOwned` below), which single-sources the drop
			// decision so promise- and heap-provenance cannot drift across a phi again.
			let ownsLiveThread = not binding.movedFrom and self.bindingIsOwned(binding)

			// `p = q` — rebinding a promise binding to an ALIAS is refused: it would give one thread two owners
			// (a double drop) or orphan this binding's own thread. A fresh `async` spawn is the only legal
			// promise RHS; `await` one name before re-binding.
			if newIsPromise and rhsWasBareLocal 'aliasRebind'
				throw SourceParseError.unsupported("a promise binding ('{String.from(nameTok.value)}') cannot be re-armed from another promise binding — only a fresh `async` spawn may re-arm it; `await` one name before re-binding", line: nameTok.line, column: nameTok.column)
			end 'aliasRebind'

			// ⭐ **FINDING 2 — re-arming would DROP a thread another name still ALIASES.** `let q = p` gives
			// this binding's thread a second name without enrolling it (a promise aliases, it does not move);
			// re-arming `p` here drops the thread while `q` still names it, so a later `await q` reclaims freed
			// memory — a UAF E3100 cannot catch (it is not a double await). Refuse it (a compile error, not a
			// miscompile). Gated on `ownsLiveThread`, so a re-arm AFTER the thread was awaited (the committed
			// `double-await-alias-outlives-rebind`, whose re-arm drops nothing) stays a linearity check, not this.
			if ownsLiveThread and self.promiseThreadHasLiveAlias(func, reArmedName: nameTok.value, thread: oldValue) 'aliasedThreadRearm'
				throw SourceParseError.unsupported("cannot re-arm the promise binding ('{String.from(nameTok.value)}'): its green thread is still named by an alias, so dropping it here would leave that alias dangling — `await` through one name before re-arming", line: nameTok.line, column: nameTok.column)
			end 'aliasedThreadRearm'

			// Drop (cancel) the old thread iff this binding still OWNS a live one — membership-based, so it
			// fires even when `oldValue` is a phi (a re-armed `var` across a loop / branch). A binding whose
			// thread an `await` consumed (`movedFrom`) owns nothing, so reassigning it to a scalar is fine and
			// drops nothing. `emitDecref` routes an owned promise to `__gt_promise_drop`.
			if ownsLiveThread 'dropOldThread'
				self.emitDecref(oldValue, range: SourceRange.ofToken(nameTok))
			end 'dropOldThread'

			if not newIsPromise 'becameScalar'
				// A non-promise value (`p = 5` after a consuming `await`, or after the live thread was dropped
				// just above): the binding now owns nothing droppable.
				self.rebindToAValueOwningNothing(binding, nameTok: nameTok, value: value)
				return
			end 'becameScalar'

			let alreadyInSet = self.bindingIsOwned(binding) or binding.movedFrom
			self.recordDebugRebindByName(nameTok.value, value: value)
			self.bodyState.scope.setValue(nameTok.value, value: value, ledger: self.bodyState.moveLedger)

			// The binding owns the fresh thread — revive it for reads and its scope-exit drop, and enrol
			// once (a re-armed promise is already in the set as a moved ghost; a non-promise binding first
			// taking a promise — `var x = 5; x = async f()` — joins now).
			binding.revive(self.bodyState.moveLedger)
			binding.partiallyMoved = false

			if not alreadyInSet 'enrolPromise'
				self.enrolOwnedBinding(binding)
			end 'enrolPromise'

			self.removeFromPendingTemps(value)
			return
		end 'promiseReassign'

		// ⭐ **MOVE-ON-ASSIGN.** A bare reference to an ALREADY-owned MUTABLE binding as the RHS (`s = t`)
		// MOVES that value: poison the source so a later read of it is use-after-move and only the new owner
		// drops the value. A fresh owned temp is held by no binding — a CONSUME, not a move. Gated on
		// `rhsWasBareLocal`, so a consume never pays the owner lookup; run BEFORE `setValue` below, so
		// the lookup matches the SOURCE's value rather than this binding's (which `setValue` is about to
		// overwrite with the moved value).
		//
		// ⭐⭐ **AN IMMUTABLE SOURCE IS EXEMPT, EXACTLY AS IT IS AT THE DECLARATION DOOR.** `a = t` over a
		// `let t` is a second REFERENCE (`rebindSourceIsAnImmutableAlias`), so nothing is poisoned and every
		// name stays readable — the loop the harness's `parseProgramArgs` is built from hands ONE
		// per-iteration `let next` to two outer cursors and only ever reads all three. It also drops the
		// loop-escape refusal `poisonOwningBinding` raises, and that is the refusal becoming inapplicable
		// rather than being suppressed: it exists because a MOVE across a back edge has no reconciliation,
		// and an alias has nothing to reconcile — each iteration takes one reference and releases the one
		// the previous iteration took.
		if rhsWasBareLocal and not aliasesImmutableSource 'moveOnAssign'
			self.poisonMoveSource(value)
		end 'moveOnAssign'

		// Is `binding` a LIVE owner (owes a drop of `oldValue`), and/or already enrolled in
		// `ownedBindings`? `binding.movedFrom` is read DIRECTLY, not via `bindingIsOwned`: a moved-from
		// binding shares its stale `boundValue` with the binding it moved to, so a value-keyed membership
		// test would find that new owner and wrongly report the moved-from binding as still owning a
		// drop. A moved-from binding owns NOTHING (its value belongs to its new owner), so it drops
		// nothing here — but it IS still in `ownedBindings`, so a revive must not re-enrol it.
		let wasMovedFrom = binding.movedFrom
		let wasOwned = not wasMovedFrom and self.bindingIsOwned(binding)
		let inOwnedSet = wasOwned or wasMovedFrom

		if inOwnedSet and self.valueIsDeferred(value) 'aDeferredValueOwnsNothing'
			if wasOwned 'dropOldOwner'
				self.emitDecref(oldValue, range: SourceRange.ofToken(nameTok))
			end 'dropOldOwner'

			self.rebindToAValueOwningNothing(binding, nameTok: nameTok, value: value)
			return
		end 'aDeferredValueOwnsNothing'

		// Promote a borrowed value assigned to a binding that is (or stays) in the owned set, so the
		// binding keeps owning a droppable one rather than being deleted from the middle of the
		// owned-binding stack (see the header): a borrowed String (`s = "literal"`, or a moved-from
		// String revived with one) or a borrowed struct/union (`q = p2` over two borrowed parameters of
		// one aggregate type). It is the same `promoteBorrowedToOwned` the declaration routes through,
		// so the two sites cannot answer the String-vs-aggregate question differently: string-promoting
		// a borrowed struct here blits its fields as a fused String record, a silent miscompile.
		let sourceValueIsOwned = self.valueIsOwnedHeap(value)
		var newValue = value
		var newIsOwned = sourceValueIsOwned

		if inOwnedSet and self.borrowedValueOwesAHandoffReference(value) 'promoteBorrowed'
			newValue = try self.promoteBorrowedToOwned(value, door: BorrowLaunderDoor.binding, range: SourceRange.ofToken(nameTok))
			newIsOwned = true
		end 'promoteBorrowed' else if not rhsWasBareLocal and tagIsByteRecord(self.tagOf(value)) and sourceValueIsOwned and not self.valueIsSoleHeapOwner(value) 'unshareTheAssignedRecord'
			newValue = self.unsharedByteRecord(value, range: SourceRange.ofToken(nameTok))
		end 'unshareTheAssignedRecord'

		// ⭐⭐ **THE REFERENCE THE SKIPPED POISON LEFT THIS BINDING OWING.** An immutable source keeps the
		// drop it has always owed, so this binding — enrolled below, or already in the owned set — cannot
		// INHERIT one and must hold its own (`coOwnImmutableRebindSource`). Two names, two references, two
		// releases: without it the alias and its source both drop one box, which the leak gate reports as
		// exit 101, and the destination may be the LONGER-LIVED of the two (an outer `var` taking a
		// loop-body `let`), so nothing here can lean on the source outliving it the way the declaration
		// door does.
		//
		// ⚠ It reads the SOURCE value's ownership, not `newIsOwned`, which is what makes it exclusive with
		// the promotion above by construction rather than by ordering: that arm runs only on a BORROWED
		// value and has already minted a reference this binding owns outright, so a retain on top of its
		// result would leak exactly one box.
		if aliasesImmutableSource and sourceValueIsOwned 'coOwnImmutableSource'
			newValue = self.coOwnImmutableRebindSource(value, range: SourceRange.ofToken(nameTok))
		end 'coOwnImmutableSource'

		// Release the overwritten allocation BEFORE the rebind, while `oldValue` still names it. Only a
		// LIVE owner has one to release: a moved-from binding's old value belongs to the binding it moved
		// to, which drops it — decref-ing it here would double-free.
		if wasOwned 'dropOld'
			self.emitDecref(oldValue, range: SourceRange.ofToken(nameTok))
		end 'dropOld'

		if newValue != value 'aReboundValue'
			self.carryCapabilityToAlias(value, target: newValue)
			self.carryImmutableSlotRead(value, target: newValue)
		end 'aReboundValue'

		self.recordDebugRebindByName(nameTok.value, value: newValue)
		self.bodyState.scope.setValue(nameTok.value, value: newValue, ledger: self.bodyState.moveLedger)

		// A WRITE REVIVES the binding: it owns `newValue` now, so a later read of it is legal again. Both
		// move states are cleared — `partiallyMoved` no less than `movedFrom`, because a reassignment gives
		// the binding a WHOLE fresh value (no moved-out slots), so a scrutinee consumed by an earlier
		// binding-match is fully live once overwritten. Clearing only `movedFrom` left `requireBindingLive`
		// (which rejects on EITHER flag) refusing every use of a reassigned `var` union — an over-rejection
		// of a valid program.
		binding.revive(self.bodyState.moveLedger)
		binding.partiallyMoved = false

		if newIsOwned 'trackNew'
			if not inOwnedSet 'borrowedToOwned'
				// A genuinely borrowed binding (`var s = ""; s = build(1)`) joins the owned set. A binding
				// already in the set — a live owner, or a moved-from ghost being revived — must NOT be
				// pushed again, or scope exit would decref `newValue` twice.
				self.enrolOwnedBinding(binding)
			end 'borrowedToOwned'

			// The new owned value is the binding's to drop at scope exit, so the STATEMENT must not also
			// drop it: a call/interpolation/promotion result is enrolled as a pending temp, and draining
			// it too would be a double-free (and, before the scope-exit drop, a use-after-free).
			self.removeFromPendingTemps(newValue)
		end 'trackNew'
	end 'reassignBindingValue'

	// Assign to a name that is not a local: a top-level `let` (E2013 — assigning to a constant), or
	// nothing (E2004).
	//
	// ⚠ **HAVING A SLOT IS NOT PERMISSION TO WRITE ONE**. `globalDeclFor` answers "which slot
	// does this name denote?", and an array `let` has an answer to that — its value is a heap record, so it
	// is STORED and read through its slot. A module binding is never writable, so a `found` is E2013 and
	// `xs = [3, 4]` is refused. `specs/static-variables.md`'s `top-level-let-struct-reassign-error` pins the
	// diagnostic.
	// ⭐ **AND A STATIC MEMBER'S STORE IS THE SAME STATEMENT**, reached with a name token spelling
	// `Counter.count` (`staticMemberNameToken`). A stored `static let` finds its slot, an inlined one is a
	// constant, and both get the E2013 a top-level `let` gets; a misspelled member is undefined. Nothing
	// here distinguishes the two storage shapes, which is the point.
	function parseTopLevelAssignment(func IrFunction, block IrBlock, nameTok Token) throws SourceParseError
		match self.signatures.globalDeclFor(nameTok.value, readerFilePath: self.job.path, into: self.artifact.typeNames) 'global'
			found then throw assignToImmutableError(nameTok)
			notFound then try self.rejectNonGlobalAssignment(nameTok)
			poisoned then _ = try self.parseExpression(func, block: block)
		end 'global'
	end 'parseTopLevelAssignment'

	// `Counter.count = 42` — consume the `<Type> . <member> =` head and hand the write to
	// `parseTopLevelAssignment` under the qualified name. The base is read through `typeBaseTokenAt`, the ONE reader of a
	// type-naming base, so `Self.count = 1` inside a static method is the same statement written the other
	// way and needs no arm of its own.
	//
	// `staticMemberAssignsAt` has already established the shape and the resolution, so the reads below cannot
	// fail — the `otherwise panic` says so rather than inventing a second refusal for a program the
	// dispatcher would never have sent here.
	function parseStaticMemberAssignment(func IrFunction, block IrBlock) throws SourceParseError
		let baseTok = try self.typeBaseTokenAt(self.pos) otherwise panic("parseStaticMemberAssignment: the base at the cursor does not name a type, but `staticMemberAssignsAt` read it as one to resolve this member")
		let nameTok = self.staticMemberNameToken(baseTok, memberTok: self.tokenAt(self.pos + TokensPerQualifierSegment))

		// Past `<base> . <member>` — the base token, then one qualifier segment.
		self.pos = self.pos + TokensPerQualifierSegment + 1
		try self.consume(TokenKind.equals)

		try self.parseTopLevelAssignment(func, block: block, nameTok: nameTok)
	end 'parseStaticMemberAssignment'

	// **THE MUTABILITY RULE FOR A LOCAL BINDING — TWO DOORS, BECAUSE THE TWO STATEMENTS THAT WRITE A
	// BINDING WRITE TWO DIFFERENT THINGS.** The reassignment `x = 5` gives the NAME a new value; the field
	// store `p.x = 5` leaves the name alone and writes the RECORD it denotes. They agree about every
	// binding kind but one, and they are kept together here so the disagreement is READ rather than
	// rediscovered.
	//
	// ⭐⭐ **THE ONE DISAGREEMENT IS A PARAMETER, AND IT IS A RULING RATHER THAN A RELAXATION** (⚖ user
	// ruling): **parameters BORROW by default, and a borrow's POINTEE is writable even
	// though the binding itself is not rebindable.** A struct parameter holds a pointer to the
	// CALLER's box (`LowerMaxonToStd`), so `state.flag = 7` inside `function scan(state State)` writes
	// the record the caller handed over — which is what by-reference means: `state.flag = 7` on a
	// PARAMETER compiles and the caller sees the write, while `s.flag = 7` on a `let` LOCAL is E2013.
	// Refusing both from one door conflates *"cannot rebind the reference"* with *"cannot write
	// through it"*.
	//
	// ⛔ **THE REBIND IS NOT RELAXED WITH IT, AND MUST NOT BE.** `p = Point.create(…)` on a parameter
	// stays E2013: rebinding needs a per-call cell for the name, which the compiler does not have, and
	// `bindParameters` PANICS on a `ParameterBindingKind` other than `let` because `assignedBindingsIn`'s
	// loop-phi token scan is exhaustive only while parameters are immutable. So the split lives in the
	// PERMISSION, per operation.
	//
	// ⚠ What the two doors DO share is single-sourced rather than restated: the E2013 mint
	// (`assignToImmutableError`) and the E3077 evidence (`markMutabilityExercised`). A future answer to what "writable" means — a captured
	// closure variable, a moved-from binding under static ownership — belongs in the predicate both
	// read, never in one door. Spelling the rule at four sites and reading `VarInfo.isMutable()` in
	// unrelated places is how it drifts.

	function functionIsAServiceFactory(func IrFunction) returns bool
		for candidate in self.signatures.serviceSpawnCandidates() 'eachCandidate'
			if func.name.equals(qualifiedMethodName(candidate.typeName, methodName: candidate.member)) 'theFactory'
				return true
			end 'theFactory'
		end 'eachCandidate'

		return false
	end 'functionIsAServiceFactory'

	function requireNoMarkedMessageOrFactoryParameter(func IrFunction, markerTokens TokenIndexArray) throws SourceParseError
		if func.reassignedParamMask == NoParamPositions or not self.signatures.spawnsAnyService() 'nothingIsMarkedOrNoServiceExists'
			return
		end 'nothingIsMarkedOrNoServiceExists'

		if not self.signatures.namesAServiceMessage(func.name) and not self.functionIsAServiceFactory(func) 'neitherAMessageNorAFactory'
			return
		end 'neitherAMessageNorAFactory'

		let firstMarker = try markerTokens.get(0) otherwise panic("requireNoMarkedMessageOrFactoryParameter: a function with a marked parameter records the marker's token")

		throw notATypeError(self.tokenAt(firstMarker))
	end 'requireNoMarkedMessageOrFactoryParameter'

	function parameterReassignKindOf(binding VarInfo) returns ParameterReassignKind
		let tag = maxonTypeTag(binding.varType)

		if tag == ValueTypeTag.typeParameter or self.genericParameterNames.contains(binding.name) 'aGenericParameter'
			return ParameterReassignKind.genericParameter
		end 'aGenericParameter'

		if tag == ValueTypeTag.structRef or tag == ValueTypeTag.genericInstance or tag == ValueTypeTag.interfaceRef 'aRecordParameter'
			return ParameterReassignKind.recordParameter
		end 'aRecordParameter'

		return ParameterReassignKind.valueParameter
	end 'parameterReassignKindOf'

	function requireParameterMayBeReassigned(binding VarInfo, nameTok Token) throws SourceParseError
		let kind = self.parameterReassignKindOf(binding)

		if kind != ParameterReassignKind.valueParameter or not binding.isCellBinding 'cannotBeReassigned'
			throw parameterReassignError(nameTok, kind: kind)
		end 'cannotBeReassigned'
	end 'requireParameterMayBeReassigned'

	function textMemberRewritesItsReceiverHere(tag ValueTypeTag, member ByteArray) returns bool
		if not tagIsByteRecord(tag) or not textMemberRewritesItsReceiver(member) 'notARewritingMember'
			return false
		end 'notARewritingMember'

		// A member this file cannot call is refused as E3008; checking its receiver too would
		// displace that diagnostic.
		return match self.signatures.calleeVisibilityFrom(qualifiedMethodName(self.byteRecordLayoutName(tag), methodName: member), readerFilePath: self.job.path) 'visibility'
			visible gives true
			hidden gives false
		end 'visibility'
	end 'textMemberRewritesItsReceiverHere'

	function requireTextReceiverIsRebindable(binding VarInfo, baseTok Token, methodTok Token) throws SourceParseError
		if binding.isParameter and not binding.name.equals(SelfParamName) 'anUnmarkedParameter'
			try self.requireParameterMayBeReassigned(binding, nameTok: baseTok)
			return
		end 'anUnmarkedParameter'

		if binding.isMutable() or binding.isCellBinding or binding.isSelfField or binding.name.equals(SelfParamName) 'aRebindableName'
			return
		end 'aRebindableName'

		throw SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: letPassedToMutableParameterMessage(String.from(baseTok.value), parameter: WrittenParameter.named(SelfParamName)), line: methodTok.line, column: methodTok.column, note: DiagnosticNote.none)
	end 'requireTextReceiverIsRebindable'

	function requireMutableBinding(binding VarInfo, nameTok Token) throws SourceParseError
		// ⭐⭐ **THE CELL RANK STANDS BESIDE THE `var` ONE, WHICH IS A THIRD ANSWER RATHER THAN A
		// RELAXATION OF THE SECOND.** A by-reference parameter is bound IMMUTABLE — `ParameterBindingKind` is
		// `let` and the `bindParameters` tripwire stands — yet `x = 99` on it is exactly what the
		// language means by pass-by-reference. It is legal because the write is not a REBIND of an SSA name at
		// all: it is a `storeIndirect` into the caller's cell, so the loop-phi exhaustiveness argument
		// `binding.isMutable()` protects is not engaged.
		//
		// A LOCAL cell is always a `var`, so it satisfies both conjuncts and this changes nothing for it; the
		// only binding the second conjunct admits that the first did not is a by-reference PARAMETER.
		if binding.isParameter 'aParameter'
			try self.requireParameterMayBeReassigned(binding, nameTok: nameTok)
		end 'aParameter'

		if not (binding.isMutable() or binding.isCellBinding) 'immutable'
			throw assignToImmutableError(nameTok)
		end 'immutable'

		// ⭐ **E3077's FIRST DOOR, and it is this one BECAUSE it is the one that refuses.** A write that gets
		// past here is a write a `let` would not have survived, which is exactly the fact E3077 needs — so
		// the rule reads the enforcement rather than re-deriving from the syntax which statements are writes.
		self.markMutabilityExercised(binding)
	end 'requireMutableBinding'

	function valueIsAnImmortalImageRecord(value ValueId) returns bool
		return valueIsMarked(self.bodyState.imageRecordReads, value: value)
	end 'valueIsAnImmortalImageRecord'

	function valueIsAPayloadFreeWord(value ValueId) returns bool
		return self.valueIsAnImmortalImageRecord(value) and self.valueIsAnUnboxedUnion(value)
	end 'valueIsAPayloadFreeWord'

	function markImageRecordRead(value ValueId)
		self.bodyState.imageRecordReads = withValueMarked(self.bodyState.imageRecordReads, value: value)
	end 'markImageRecordRead'

	function forgetImageRecordMark(value ValueId)
		unmarkValue(self.bodyState.imageRecordReads, value: value)
	end 'forgetImageRecordMark'

	function carryImageRecordMark(to ValueId, from ValueId, source FunctionBodyState, path ValueCarryPath)
		if not pathKeepsTheRecord(path) or tagIsByteRecord(self.tagOf(to)) 'notTheSameImage'
			return
		end 'notTheSameImage'

		self.bodyState.imageRecordReads = withMarkCarried(self.bodyState.imageRecordReads, to: to, source: source.imageRecordReads, from: from)
	end 'carryImageRecordMark'

	function carryImageRecordMarkToRead(source ValueId, read ValueId)
		if self.valueIsAnImmortalImageRecord(source) and self.valueIsNonTextAggregate(read) 'outOfAnImageRecord'
			self.markImageRecordRead(read)
		end 'outOfAnImageRecord'
	end 'carryImageRecordMarkToRead'

	function requireWritableInstance(step FieldChainStep) throws SourceParseError
		if not self.valueIsCopyableTuple(step.box) 'notATuple'
			return
		end 'notATuple'

		if not self.immutableReceiverNameOf(step.baseBinding, baseTok: step.baseTok).isEmpty() 'aLetTuple'
			throw assignToImmutableError(step.baseTok)
		end 'aLetTuple'

		self.markMutabilityExercised(step.baseBinding)
	end 'requireWritableInstance'

	// May this file call a reserved `__` name at all: the call door's half of the question
	// (`requireCalleeIsNotReservedName`). Two
	// provenances answer yes, and neither is a spelling: `declaresCompilerInternalNames` (a `runtime/`
	// file, or one of the stdlib modules that declare the reserved space), and a non-empty
	// `compilerMintedNames` (this compile wrote part of the file, `Queries.compilerMintedNamesIn`).
	//
	// ⚠ Both are only half an exemption: the door conjoins `declaresCallee`, so what is granted is "a
	// `__` name some file in this program declares", never "any `__` name". That conjunction is why
	// the second provenance may be read per file on this side: a generated dispatcher calls names its
	// own file does not declare (the entry's helper type, the per-file runner one file over).
	//
	// ⚠ It is not the declaration door's predicate. A staged `.maxtest` file is the author's bytes
	// with a dispatcher appended, and file-grained at the declaration door it would hand the author
	// the reserved space; `requireUnreservedName` asks about the name, and only this door asks about
	// the file.
	function fileMayUseReservedNames() returns bool
		return self.job.declaresCompilerInternalNames or not self.job.compilerMintedNames.isEmpty()
	end 'fileMayUseReservedNames'

	// What a user may not declare, in one place. Two reservations, both raised as E2051 at the
	// declared name — the token the user has to change: a name starting with `ReservedTypeNamePrefix`, and
	// the implicit receiver's own name, `self` (`ReceiverSourceSpelling`; see `bindsInto` for the one
	// namespace it is legal in).
	//
	// ⚠ It is called at 18 binding sites — function/method name, parameter, top-level and body
	// `let`/`var`, destructuring names, loop-variable pattern, `if` binder, caught-error binders, a
	// `match` arm's payload bindings, `type` name, struct field, union payload field, `typealias`
	// name, interface name, enum/union case — one call at each. A site that stops asking is a silent
	// hole (a user `__` name accepted there), and nothing else about such a site looks wrong, so the
	// count is written down to be checked.
	//
	// ⚠ `declaredName` is passed and is not `nameTok.value`: an implicitly backed enum case
	// `enum E { "\x5f\x5fx" }` declares `__x` (the decoded content every `indexOfCase` matches) while
	// its token's text does not start with the prefix. The token is here for the position only, and
	// the message names what was declared rather than how it was spelled.
	//
	// It sees only source tokens, so it cannot reject the compiler's own `__` functions (`__mm_alloc`,
	// `__destruct_*`), which `IrFunction.createFromStd` builds without the parser. That keeps them out
	// of `funcSignatures`, which is the fact `MmRuntime.isSignaturelessCompilerCallee` reads — a
	// registry answer, because with the exemptions below the prefix alone does not decide it.
	function requireUnreservedName(nameTok Token, declaredName ByteArray, bindsInto DeclaredNameNamespace = DeclaredNameNamespace.shadowsTheReceiver) throws SourceParseError
		// The files that declare the reserved space are exempt (`declaresCompilerInternalNames`:
		// `runtime/`, `stdlib/Builtins.maxon`, the type-system bridge to compiler intrinsics, and
		// `stdlib/Testing.maxon`), so the reservation holds everywhere a user can write. The exemption is
		// on the file rather than a per-name allowlist, which would have to be kept in lockstep with a
		// file it does not live in.
		//
		// ⚠ It is this file-grained provenance and not `fileMayUseReservedNames`: that predicate is the
		// call door's, and it also answers yes for a file this compile wrote only part of — every
		// `maxon test` build stages the author's own `.maxtest` file with a generated dispatcher
		// appended. That file's generated declarations pass by name, at the `compilerMintedNames` arm
		// below.
		if self.job.declaresCompilerInternalNames 'aFileWhoseEveryByteIsTheCompilersBridge'
			// An exempt file still may not declare `__line__` or `__file__`: they are reserved words, not
			// merely reserved-prefix names (`specs/source-location-defaults.md`: "no program can declare or
			// shadow them"). Asked inside the branch because every other file refuses both on the prefix
			// rule.
			try requireNotACallerLocationDefault(declaredName, at: nameTok)
			return
		end 'aFileWhoseEveryByteIsTheCompilersBridge'

		// The implicit receiver's own name (`specs/reserved-self.md`). `self` is not a `__` name, so the
		// prefix test's early-out would wave it through; it is asked here because this is the one place
		// every binding site asks whether a declaration may take a name. Unrefused,
		// `function configure(self int)` surfaces downstream as E3012 or E2001, both in the wrong place.
		// It sits below the file exemption, beside the `__` rule; no exempt file declares a binding named
		// `self`, so the placement decides nothing today.
		if namespaceShadowsTheReceiver(bindsInto) and declaredName.equals(ReceiverSourceSpelling) 'theImplicitReceiversName'
			throw SourceParseError.reservedReceiverName(nameTok.line, column: nameTok.column)
		end 'theImplicitReceiversName'

		// The rule's own test comes first because this runs once per declared name in every file, and the
		// two exemptions below are linear scans (`isMintedLibraryName`'s also allocates): asked
		// first, they would cost `sites × renames` at every stdlib declaration. The scale ladder cannot
		// see a regression here, because its corpus contests no name.
		if not isCompilerReservedName(declaredName) 'notReserved'
			return
		end 'notReserved'

		// A name this compile minted is not a name the author wrote. A contested stdlib declaration is
		// renamed into the reserved space on the file's identifier tokens, so `stdlib/Clock.maxon`'s
		// `type Clock` reaches here as `__Clock`. The exemption is "this exact name is one this compile
		// minted", asked of the rename table, and not "a stdlib file may declare `__` names".
		//
		// ⚠ It is scoped to the token's provenance (`mintIsTheCompilersAt`) because `shadowRenamedTokens`
		// rewrites only library tokens: a minted name reaching here from a user file, or from a scriptlib
		// token the rename did not write, is the author typing `__Clock`, which E2051 exists to refuse.
		if self.mintIsTheCompilersAt(nameTok) and self.signatures.interfaceMap().isMintedLibraryName(declaredName) 'theCompilersOwnMint'
			return
		end 'theCompilersOwnMint'

		// A name this compile generated into this file is not the author's either: `maxon test`'s stager
		// appends a dispatcher declaring `__maxon_test_file_<N>` to a copy of each test file and writes
		// an entry file declaring `__MaxonTestRun`, `__MaxonTestIndex` and `__maxon_test_main`
		// (`TestDispatcher.mintedNamesForDispatcher` / `mintedNamesForEntry`).
		//
		// ⚠ Per name, not per file and not by line: a staged `.maxtest` file is the author's bytes with
		// generated bytes appended, so a file-grained exemption would let an author's
		// `function __sneaky()` compile under `maxon test` while `maxon build` refuses it
		// (`tests/test-fixtures/reserved-name-refused`), and "below the author's last line" holds only
		// while nothing is prepended.
		if mintedNamesInclude(self.job.compilerMintedNames, name: declaredName) 'thisCompilesOwnGeneratedDeclaration'
			return
		end 'thisCompilesOwnGeneratedDeclaration'

		throw SourceParseError.reservedIdentifier(String.from(declaredName), line: nameTok.line, column: nameTok.column)
	end 'requireUnreservedName'

	function mintIsTheCompilersAt(token Token) returns bool
		return self.everySpellingIsTheCompilers() or self.wasRespelled(token)
	end 'mintIsTheCompilersAt'

	// A scriptlib file carries `isStdlibSource`, but its author may never write a `__` name, and the
	// rename's mints sit among the author's own bytes. Asking `isStdlibSource` alone here would admit a
	// hand-typed `__Clock` in a package.
	function everySpellingIsTheCompilers() returns bool
		return self.job.isStdlibSource and not self.job.isScriptlibSource
	end 'everySpellingIsTheCompilers'

	// Keyed by start byte, which every synthetic token shares at 0. No identifier starts at byte 0,
	// since every file opens with a keyword, so a synthetic token never reads as respelled.
	function wasRespelled(token Token) returns bool
		return self.respelledStarts.contains(token.startByte)
	end 'wasRespelled'

	function staticCallHeadMint(baseIndex ElementIndex, typeTok Token) returns CalleeMint
		return CalleeMint.resolvedStaticTypeQualifier if self.qualifiedTypeBaseIsAt(baseIndex) or self.wasRespelled(typeTok) else CalleeMint.notMinted
	end 'staticCallHeadMint'

	// ⭐ **THE "UNKNOWN INTRINSIC" ARM OF THE `__Builtins` TABLE — AND OF EVERY OTHER RESERVED CALLEE.**
	//
	// `__` is reserved for compiler internals: `E2051` refuses to DECLARE such a name, and the compiler emits
	// its own calls to them through `emitRuntimeCall`, never through here. So a `__`-prefixed callee arriving
	// at one of the two SOURCE call doors (`emitCall`, `emitAsyncCall`) either matched the intrinsic table
	// above — in which case it was already lowered and never reached this — or names nothing at all.
	//
	// ⚠ The check is here and not in SemanticCheck because only the parser knows which of its doors
	// a name came through: by the time SemanticCheck runs, a `call __mm_decref` the parser emitted
	// and a `call __whatever` the user wrote are the same `MaxonOp.call`.
	// `SemanticCheck.validateCall` returns early on a signatureless `__` callee
	// (`calleeIsBuilderBuilt`) unless it is a member of a minted library type
	// (`ProgramSignatures.isMemberOfAMintedLibraryType`), which it reports as E4006. Any other `__`
	// callee this door admits reaches lowering unvalidated and fails there with no file or line.
	//
	// The door is ajar for the files that declare the reserved space, and only for names some file
	// declares. Those files, the `runtime/` tier and the stdlib modules
	// `Queries.declaresCompilerInternalNames` names, are let past `requireUnreservedName` on the
	// DECLARATION side, and the CALL side reads the same one bit the declaration side does
	// (`declaresCompilerInternalNames`, an identity compare against each exempt module's
	// `<stdlibDir>/<name>` — never a basename). A rule stated on one side of a name lapses on the
	// other: `stdlib/Builtins.maxon` could declare `__int_fromString` and then not call it.
	//
	// ⚠ **THE `declaresCallee` CLAUSE IS THE OTHER HALF, AND WITHOUT IT THE EXEMPTION IS FAR WIDER THAN THE
	// DECLARATION SIDE'S.**
	// The declaration exemption admits the names those files WRITE; a bare file test here would admit every
	// name they do not — `__mm_free()`, `__gt_spawn()`, `__nosuch()` — none of which any file declares, all of
	// which would then sail past SemanticCheck (nothing to look up) into the backend. So the exemption is "a
	// name some file declares", which is the call-side dual of the declaration exemption, and a typo in one of
	// those files gets the positioned E3004 below rather than a backend panic with no position.
	//
	// ⚠ This door asks `ProgramSignatures` (swept from every file's tokens; a parser holds no
	// `Project`), and `SemanticCheck.validateCall` asks `project.funcSignatures` (folded from parsed
	// declarations), skipping arity/label/type validation when the answer is no. So a `__` name this
	// door admits and that registry lacks would be admitted and unvalidated. Both registries are
	// derived from function declarations. `Parser.requireSweptDeclaration` (E9003) refuses a parsed
	// declaration the sweep lacks; the direction this door relies on, a swept name the parse does not
	// register, has no check, because SemanticCheck cannot tell a source-written `__` callee from a
	// compiler-emitted one.
	function requireCalleeIsNotReservedName(callee ByteArray, anchor Token, mint CalleeMint) throws SourceParseError
		// ⭐⭐ **THE `__Raw` PRIVILEGE IS THE TIER'S, AND THIS IS THE ONE DOOR BOTH CALL FORMS FUNNEL THROUGH**
		// — `emitCall` and `emitAsyncCall` — so the refusal cannot hold at one spelling and lapse at the other.
		// A LISTED member called FROM a runtime file never arrives here at all: `parseCallNamed`'s table arm
		// lowers it. What reaches this line is either the call from outside the tier, refused by name, or an
		// unlisted member, which falls through to the ordinary E3004 below whichever file wrote it.
		if isRawIntrinsicCallee(callee) and not self.job.isRuntimeSource 'theRawFloorIsTheRuntimesAlone'
			throw SourceParseError.rawIntrinsicOutsideRuntimeTier(String.from(callee), line: anchor.line, column: anchor.column)
		end 'theRawFloorIsTheRuntimesAlone'

		// ⭐ **ASKED ONCE AND CARRIED, NOT ASKED AGAIN TO EXPLAIN.** The classifier's answer IS the refusal's
		// reason, so there is one derivation and nothing to keep in step. A reason derived independently of the
		// gate is how `String.compare` comes to be refused for a `__` prefix it does not carry.
		let reason = reservedCalleeReasonOf(callee)

		if reason == ReservedCalleeReason.notReserved 'ordinaryCallee'
			return
		end 'ordinaryCallee'

		// `<conformer>.<method>` names both the symbol `BuiltinConformanceRuntime` mints for a witness
		// slot and the legal static spelling of a declared instance method (`String.hash("a")` is
		// `"a".hash()`, and `stdlib/String.maxon` declares `hash()` and `equals()`). So the
		// synthesized-impl clause is the compiler's only while no file declares the method; conjoined with
		// `declaresCallee` like the clauses below, it refuses a `<conformer>.<method>` no file declares,
		// which no signature could validate. Sound while the two registries agree (see this function's
		// header): a callee `funcSignatures` contains is not `isSignaturelessCompilerCallee`, so
		// SemanticCheck validates it and `lowerCall` slots its arguments against the declaration.
		if reason == ReservedCalleeReason.synthesizedConformanceImpl and self.signatures.declaresCallee(callee) 'theCorpusOwnDeclarationNamedStatically'
			return
		end 'theCorpusOwnDeclarationNamedStatically'

		// ⭐⭐ **THE THIRD KIND OF EXEMPTION: THE NAME IS RESERVED AND THE AUTHOR DID NOT WRITE IT.**
		// The two clauses below both key on a FILE — "which file is calling?" — because every other `__`
		// callee reaching this door is bytes the author typed, so the file is the only variable. A
		// `<primitive>.<method>(…)` call is one whose callee the COMPILER spelled, out of a source name
		// with no `__` in it, so no file fact can tell it from a typed one: `CalleeMint` is that fact, and
		// it is stated by the one routine that mints such a name (`parseQualifiedCall`'s primitive arm).
		//
		// ⚠ **`declaresCallee` IS CONJOINED FOR THE OTHER TWO CLAUSES' REASON**, not as belt-and-braces: the
		// mint says the compiler owns the head, and this says the program actually has that function. The mint
		// site already refuses an undeclared primitive static in the AUTHOR'S OWN SPELLING (it must — this
		// message would name `__int_frobnicate`, a symbol nobody wrote), so a `minted` callee that is not
		// declared is a drift between that check and this one, and lands here rather than in the backend.
		if mint == CalleeMint.primitiveStatic and self.signatures.declaresCallee(callee) 'theCompilersOwnPrimitiveStaticMint'
			return
		end 'theCompilersOwnPrimitiveStaticMint'

		// ⭐ **THE FOURTH KIND OF EXEMPTION: A DEFAULT VALUE'S HELPER** — a PARAMETER's or a
		// FIELD's, which are one exemption because they are one mechanism and one mistake. It is the
		// `primitiveStatic` clause one mint over, and conjoined with `declaresCallee` for its exact reason: the
		// mint says the compiler spelled the callee, and this says the program actually contains that function.
		// Both helpers are declared by the SWEEP (`recordScannedParamDefaults` / `recordScannedFieldDefaultHelper`
		// publish their return types), so a mint whose helper is absent is a drift between the sweep and the
		// fill and lands here rather than in the backend.
		if calleeMintIsDefaultHelper(mint) and self.signatures.declaresCallee(callee) 'theCompilersOwnDefaultHelperMint'
			return
		end 'theCompilersOwnDefaultHelperMint'

		if self.fileMayUseReservedNames() and self.signatures.declaresCallee(callee) 'theReservedSpacesOwnDeclaration'
			return
		end 'theReservedSpacesOwnDeclaration'

		// ⭐ **THE CALL-SIDE HALF OF THE SHADOW MINT** — `requireUnreservedName`'s arm, one door
		// over, and the SAME conjunction the `fileMayUseReservedNames` clause above states rather than a second
		// rule. `stdlib/Clock.maxon`'s own
		// `Clock.nowMs()` becomes `__Clock.nowMs()` when a user program declares `type Clock`, so a `__` callee
		// can be a name the compiler itself minted for a declaration that genuinely exists. Both clauses are
		// load-bearing for that clause's stated reason: the mint says the compiler owns the head, and `declaresCallee`
		// says the program actually has that function — a mint-only door would admit `__Clock.whatever`.
		//
		// ⚠⚠ **AND THE THIRD CLAUSE IS THAT THE HEAD IS NOT BYTES THE AUTHOR TYPED, FOR `requireUnreservedName`'s
		// REASON.** A `__Clock.nowMs()` the author wrote out in a USER file is the author
		// reaching into the reserved space, and the rule this whole mechanism states is that the moved name is
		// one "no user program can reach" by NAME
		// (`stdlib-user-shadows.error.the-mint-is-not-reachable-from-user-code` holds that shut).
		//
		// ⭐⭐ **BUT "THE AUTHOR TYPED IT" IS NOT "THE FILE IS A USER FILE", AND READ AS IF IT WERE, THIS CLAUSE
		// WOULD MAKE THE MOVED DECLARATION UNUSABLE.** The contest's soundness argument is about NAME
		// reachability (`Queries.contestStdlibDeclarationsAgainstUserNames`) — and a VALUE crosses the same file
		// boundary a name does not. `stdlib/Directory.maxon`'s `currentPath()` hands user code a `FilePath`,
		// which under a user `type FilePath` is a `__FilePath`, and a method call on it spells its callee out of
		// that resolved TYPE: **`E3004 … '__FilePath.join': the '__' prefix names a compiler intrinsic`**, about
		// a callee no author wrote and a function the program declares. Two different meanings on one spelling —
		// the `__` the compiler RESERVED and the `__` this compile MINTED.
		//
		// ⇒ The clause is the PROVENANCE OF THE HEAD, of which the stdlib file test is one case
		// (`everySpellingIsTheCompilers`): a stdlib file's identifier tokens were rewritten by the contest
		// before this parse saw them, so nothing it spells is the author's. The other is
		// `CalleeMint.resolvedTypeQualifier` or `resolvedStaticTypeQualifier`, stated by the doors that
		// join a resolved type name, or a head the rename respelled in a scriptlib file
		// (`staticCallHeadMint`), to a written member. It is a
		// per-SITE fact for `CalleeMint`'s standing reason: the two spellings build the identical callee
		// bytes, so no name-keyed rule can tell them apart.
		//
		// The disjunction is first because both halves are a few compares while `isMintedStdlibShadowCallee` is
		// the allocating table scan this function's own header keeps off the common path.
		if (self.everySpellingIsTheCompilers() or mintHeadIsTheCompilers(mint)) and self.signatures.isMintedStdlibShadowCallee(callee) and self.signatures.declaresCallee(callee) 'theCompilersOwnMint'
			return
		end 'theCompilersOwnMint'

		// A member the respelled library type does not declare is SemanticCheck's to report (E4006); see
		// `SemanticCheck.calleeIsBuilderBuilt`, which asks the same predicate.
		if self.signatures.isMemberOfAMintedLibraryType(callee, mint: mint) 'aMissOnAMintedTypeIsSemanticChecks'
			return
		end 'aMissOnAMintedTypeIsSemanticChecks'

		throw SourceParseError.unknownCompilerIntrinsic(String.from(callee), reason: reason, line: anchor.line, column: anchor.column)
	end 'requireCalleeIsNotReservedName'

	// ⭐⭐ **A DECLARATION MAY NOT TAKE THE FAULT PROBE'S NAME IN THE *FREE-FUNCTION* NAME SPACE.**
	// `requireUnreservedName`'s second sibling, and a sibling for `requireTypeNameNotCompilerOwned`'s exact
	// reason: `__` is reserved at EVERY declaration, while `maxon_force_segfault` is reserved only where a
	// declaration would mint a FREE-FUNCTION SYMBOL under the bare name. That is the one name space the
	// compiler's own entry point occupies — `runtime/FaultProbe.maxon` declares it, and the backtrace prints
	// the name, so it can never move into the `__` band a shape test would recognise.
	//
	// ⛔ **THE HAZARD IS THE FREE-FUNCTION DIRECTORY CONTEST, WHICH IS WHY NOTHING ELSE IS REFUSED.** A second
	// free function of the bare name makes it contested across directories, and `declaredMethodName` then files
	// the TIER's declaration as `runtime.maxon_force_segfault` — leaving the bare call the compiler emits bound
	// to the program's own function, which does not fault. `FunctionNameIndex.refuseDuplicateFunctionName`
	// cannot report it: it tells the two sides apart by one of them having no source file, and the tier
	// declares its body in source, so both sides are parsed.
	//
	// ⚠ **A LOCAL, A PARAMETER, A FIELD, AN ENUM OR UNION CASE AND A *METHOD* MAY ALL TAKE THE WORD, AND
	// MUST.** None of them enters the free-function name space, so none can reach `isContestedFreeFunction`
	// and none costs the compiler its symbol — a method is already keyed `Type.maxon_force_segfault`. Refusing
	// them would buy nothing and refuse legal programs, which is the line `reserved-self.md` draws for `self`
	// one rule over. `specs/safety.md`'s `force-segfault-name-is-free-outside-the-function-space` pins the
	// legal side and `error.force-segfault-name-is-reserved` the refused one.
	//
	// ⚠ The gate is `enclosingType.isEmpty()` — the fact `declaredMethodName` reads to decide whether to
	// qualify — and the subject is the BARE token rather than that qualified answer: under a live contest the
	// author's own declaration is filed as `sub.maxon_force_segfault`, so the qualified spelling is exactly
	// what a contest has already hidden the collision behind.
	function requireFreeFunctionNameIsNotTheFaultProbe(nameTok Token) throws SourceParseError
		// The tier declares it, and `stdlib/Builtins.maxon` / `stdlib/Testing.maxon` are the compiler's own
		// bridge files — `requireUnreservedName`'s exemption, asked here so one provenance answers both doors.
		if self.job.declaresCompilerInternalNames 'aFileWhoseEveryByteIsTheCompilersBridge'
			return
		end 'aFileWhoseEveryByteIsTheCompilersBridge'

		if self.enclosingType.isType() 'aMethodIsKeyedByItsType'
			return
		end 'aMethodIsKeyedByItsType'

		if not nameTok.value.equals(ForceSegfaultName) 'anOrdinaryName'
			return
		end 'anOrdinaryName'

		throw SourceParseError.reservedFaultProbeName(nameTok.line, column: nameTok.column)
	end 'requireFreeFunctionNameIsNotTheFaultProbe'

	// ⭐ **A DECLARATION MAY NOT GIVE A COMPILER-OWNED TYPE NAME A *NOMINAL* IDENTITY.**
	// `requireUnreservedName`'s sibling, and the two are separate rules over separate name sets rather than one
	// combined check, because they govern different things: `__` is reserved at EVERY declaration (a local, a
	// field, a function, an enum case), while `Ordering`/`HashValue`/`ExitCode` are reserved only where a
	// declaration would mint a TYPE IDENTITY under the name — `let Ordering = 5` binds a value and collides
	// with nothing.
	//
	// ⚠ **NOMINAL is the precise line, and a RANGED typealias is deliberately on the legal side of it.** A
	// `type`, an `enum`/`union`, a FUNCTION typealias and a GENERIC-INSTANCE typealias each make the name mean
	// a distinct thing the parser re-tags a `named` reference INTO (`structRef`, an enum layout, `function`,
	// `genericInstance`) — and that is precisely where the parser and `resolveNamedType` come to disagree about
	// a compiler-owned name (see `TypeResolution.isCompilerOwnedTypeName` for the measured 0xC0000005). A
	// RANGED alias mints no identity at all: it ERASES to `integer`/`float`, which is what the builtin does
	// too, so the two answers agree and there is nothing to refuse. `specs/generic-type-nested-array-
	// typealias.md` declares `typealias ExitCode = int(0 to 125)` in all 27 of its cases and is correct to.
	//
	// ⭐⭐ **THE CORPUS MAY DECLARE THESE NAMES — IT IS WHERE THEY COME FROM.** The reservation says a
	// name has ONE meaning, not that the compiler must be the one to write it down: `stdlib/Interfaces.maxon`
	// declares `Ordering` and `IterationError`, and the compiler READS those declarations rather than
	// carrying a second transcription of them (`Project.requireCorpusDeclaredEnum`, the
	// `__Managed*Error` precedent). Refusing the corpus here would refuse the very file the layout is
	// read from.
	//
	// ⚠ **THE BIT IS `livesUnderStdlibDirectory`, NOT `isStdlibSource`, AND THE DIFFERENCE IS A COMMAND THE
	// STDLIB AUTHOR RUNS.** `isStdlibSource` answers a VISIBILITY question and deliberately hands a project ROOTED
	// under `stdlib/` its own files back as the USER's, so gated on it, `maxon build stdlib/Interfaces.maxon`
	// — the readiness probe `StdlibLoader`'s collision rule prescribes — would refuse the module it is checking.
	// Being the declaring site of a compiler-owned name is a property of the FILE, never of how a command
	// line spelled the project.
	//
	// ⚠ It admits stdlib source WHOLESALE rather than mapping each name to one module, and that is exact rather
	// than loose: a second listed module declaring the same name is an ordinary duplicate definition (E3006,
	// `commitFuncSignatures`' twin for types), which is a LOUDER answer than a per-name allowlist could give and
	// one that already exists. What this door owes is only that a USER file may not mint the identity.
	//
	// ⛔⛔ **IT ASKS THE ONE PREDICATE INSTEAD OF RE-SPELLING THE CONJUNCTION, AND THIS DOOR IS *WHY* THAT
	// PREDICATE EXISTS.** Three sites decide the identical question — this one, which
	// DIAGNOSES, and the two registries that DROP (`Project.upsertDeclaredEnum`,
	// `ProgramSignatures.recordStruct`). The two registries share it because a disagreement between THIS
	// door and one of them cost two reachable compiler PANICS: it admitted `stdlib/String.maxon`'s
	// declaration while `recordStruct` threw the layout away, so the parse walked into a body whose layout
	// no longer existed. Leaving `isCompilerOwnedTypeName(…) and not <corpus>` written out a third time here
	// would leave the rule with two homes again — and the next edit to either one is the same crash. **The
	// BIT is this parser's** (`livesUnderStdlibDirectory`, for the reason two paragraphs up); **the RULE
	// over it is `Project.declarationContestsACompilerOwnedName`'s, and only its.**
	//
	// ⭐⭐ **AND IT IS A CONTEST ONLY IF THE DECLARATION *DISAGREES*** (spec-port `lazy-static`). The caller
	// states what its declaration makes the name MEAN, and the rule compares that against the meaning the
	// compiler already holds — see `Project.declarationContestsACompilerOwnedName` and `DeclaredTypeMeaning`.
	// Three of the four doors below mint a NOMINAL identity and so can never agree; the generic-instance
	// alias can, and is the one that had been refusing `typealias CharSet = Set with Character` — the
	// reference's own line.
	function requireTypeNameNotCompilerOwned(nameTok Token, declares DeclaredTypeMeaning) throws SourceParseError
		if not declarationContestsACompilerOwnedName(nameTok.value, declaredByTheCorpus: self.job.livesUnderStdlibDirectory, declares: declares) 'notAContest'
			return
		end 'notAContest'

		throw SourceParseError.declarationTakesCompilerOwnedTypeName(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
	end 'requireTypeNameNotCompilerOwned'

	// ⭐⭐ **THE PARSER-TIER COERCION, PAID.** `TypeRules.widensIntToFloat` states the obligation an `ok`
	// verdict leaves behind; this is the ONE place the parser discharges it for an SSA value, and every
	// parser-tier coercion site routes through here rather than restating the rule. That is the whole
	// shape of the bug it closes: six doors each asked `checkDeclaredType`, accepted `ok`, and then went
	// on using the value they already held — an i64 in a GPR meeting a slot declared f64.
	//
	// `promoteToFloat` is the primitive (a `cvtsi2sd`, via `MaxonUnaryOp.promoteToFloat`) and it is
	// idempotent, so the guard is about the DECLARED side, not the value's: without it a `return 3` from
	// a `returns int` would convert too.
	//
	// ⚠ It is the PARSER's promotion and deliberately not the Std tier's. The compiler has exactly two promotion
	// primitives and the split is forced: `LowerMaxonToStd.floatDomainCrossedArg` converts a call ARGUMENT,
	// whose callee signature is a whole-program fact the parser may not have; every site below is intra-file —
	// a `return` against its own function's declared type, a field against a layout already in hand, a
	// binding against its own declaration — so all of them promote HERE, off the `valueTags` column, with
	// no second table.
	function coerceToDeclared(value ValueId, declared ValueTypeTag, anchor Token) returns ValueId
		if not widensIntToFloat(self.tagOf(value), declared: declared) 'noWidening'
			return value
		end 'noWidening'

		// ⚠⚠ **THE RULE CANNOT TELL THE TWO `named` KINDS APART, AND ONLY AN INVARIANT HELD ELSEWHERE DOES.**
		// `widensIntToFloat` answers TRUE for a `named` value meeting a `float`, because `tagIsIntegral`
		// answers TRUE for every `named`. That is exactly RIGHT for a ranged INT alias — `var z = 0.0` then
		// `z = aCount` must convert — and CATASTROPHIC for a ranged FLOAT alias, whose value is already an
		// f64: a `cvtsi2sd` over its bit pattern is a silent wrong answer by ~300 orders of magnitude, not a
		// diagnostic. One tag, two representations, and the RULE sees only the tag.
		//
		// What actually keeps them apart is that no float-alias VALUE ever carries a `named` tag: every
		// producer lifts it to `float` first — `resolveFloatAliasType` at a parameter binding, a call result
		// and a closure capture, `ProgramSignatures.fieldTypeOf`'s float-alias arm at a field. So a `named`
		// float alias arriving HERE means a producer was added without that lift, which is a compiler bug and
		// never a program's.
		//
		// It is a PANIC and not a comment because the comment is what failed: `widensIntToFloat`'s own header
		// offered the `ok` verdict as the safeguard, and the verdict is no safeguard at all —
		// `checkDeclaredType(named, float)` answers `ok` and hands the conversion straight through. The next
		// producer to mint a float-alias value gets a named site instead of a number.
		if self.tagOf(value) == ValueTypeTag.named and self.namedIsFloatAlias(self.valueNameId(value)) 'unliftedFloatAlias'
			panic("Parser.coerceToDeclared: value v{value} is tagged `named` for the ranged FLOAT alias '{String.from(self.valueTypeName(value))}' and reached the int->float widening — every producer of a float-alias value must lift its tag through `resolveFloatAliasType` or `ProgramSignatures.fieldTypeOf` first, or this emits a `cvtsi2sd` over an f64 bit pattern")
		end 'unliftedFloatAlias'

		return self.promoteToFloat(value, opTok: anchor)
	end 'coerceToDeclared'

	// **CHECK AN ASSIGNED VALUE AGAINST ITS DECLARED SLOT AND HAND BACK THE VALUE THAT SLOT WANTS** — the
	// verdict and the coercion in ONE call, so a caller cannot take the `ok` and forget the conversion.
	// `voice` is the SENTENCE the refusal is told in and nothing else — see `SlotMismatchVoice`.
	// A local `var` rebind goes through it, and so does a field or container
	// element whose slot is unmanaged; a managed slot is `requireManagedValueMatches`'.
	//
	// It returns a value rather than nothing precisely because the caller must REBIND: the promoted id is
	// a different SSA value from the one that was parsed, and a caller that stored the original would
	// store the raw integer bits.
	//
	// ⚠ **EVERY ARGUMENT IT TAKES IS A SCALAR, AND THAT IS MEASURED RATHER THAN STYLISTIC.** This is one of
	// the hottest paths in the parser — every `var` rebind, every struct-literal field and every field write
	// — so what crosses the boundary is what the program pays per assignment. The
	// declared type arrives as the `(tag, nameId)` PAIR every other type-deciding door in this file takes
	// rather than a noun STRING: threading a string on into the function-type door costs
	// one allocation per call, for a record almost every call then discards. See `FunctionTypeDoor`.
	//
	// ⚠ **`placeOwner` IS THE ONE NON-SCALAR, AND IT IS A BORROWED NAME THAT ALREADY EXISTS — never a built
	// one.** A FIELD is worded `field 'x' of 'Point'`, so the declaring type is part of the place and the
	// field doors pass `layout.name`; every other door passes `EmptySourceText`. Building a `String.from(…)`
	// place EAGERLY instead costs one discarded allocation per payload and container-element site, on paths
	// whose voice quotes no place at all — a cost that grows with the corpus.
	function assignableValue(nameTok Token, value ValueId, declared ValueTypeTag, declaredNameId TypeNameId, door FunctionTypeDoor, placeOwner SlotOwner, voice SlotMismatchVoice) returns ValueId throws SourceParseError
		let got = self.tagOf(value)
		try self.requireAssignable(nameTok, value: got, valueNameId: self.valueNameId(value), valueBrandId: self.brandIdOf(value), declared: declared, declaredNameId: declaredNameId, door: door, placeOwner: placeOwner, voice: voice)
		self.admitUnsignedLiteralIntoSlot(value, slot: declared, slotNameId: declaredNameId)

		if isFunctionTypeDoor(declared, got: got) 'functionTypeDoor'
			self.recordFunctionStoreDoor(declaredNameId, value: value, door: door, placeName: nameTok.value, placeOwner: placeOwner, anchor: nameTok)
		end 'functionTypeDoor'

		return self.coerceToDeclared(value, declared: declared, anchor: nameTok)
	end 'assignableValue'

	// The VERDICT rule for an ASSIGNMENT — the local path, the global one, the struct-literal field, the
	// field write and the field DEFAULT all ask it, and none of them restates it. A global is no less able
	// to be handed a bool where it declared an int, or a float where it declared an int, than a local is;
	// every one of them anchors the diagnostic on the assigned NAME and names its own PLACE (the `door`,
	// whose noun `functionTypeDoorNoun` renders — and renders only where a diagnostic is built).
	//
	// ⚠ It is the verdict ALONE, and it is asked DIRECTLY by exactly one caller: the site holding a
	// parse-time CONSTANT rather than an SSA value (a struct field's literal default), which pays the
	// widening the verdict licenses in the constant's own representation. Every site holding a VALUE asks
	// `assignableValue` — this plus that conversion, in one call, so the two halves cannot come apart.
	function requireAssignable(nameTok Token, value ValueTypeTag, valueNameId TypeNameId, valueBrandId TypeNameId, declared ValueTypeTag, declaredNameId TypeNameId, door FunctionTypeDoor, placeOwner SlotOwner, voice SlotMismatchVoice) throws SourceParseError
		match self.declaredSlotVerdict(value, gotNameId: valueNameId, declared: declared, declaredNameId: declaredNameId) 'declared'
			ok then break
			mismatch then throw self.slotMismatchError(voice, placeDoor: door, placeName: nameTok.value, placeOwner: placeOwner, placeBrand: EmptySourceText, placeSpelling: EmptySourceText, got: self.brandedDisplayTypeName(value, nameId: valueNameId, brand: self.internedName(valueBrandId)), gotNote: "", resolvedExpected: self.declaredSlotDisplayName(declared, nameId: declaredNameId, fallback: typeTagName(declared)), expectedNote: "", declared: declared, declaredNameId: declaredNameId, line: nameTok.line, column: nameTok.column, crossesRange: false)
			narrowsFloatToInt then throw SourceParseError.implicitNarrowing(self.brandedDisplayTypeName(value, nameId: valueNameId, brand: self.internedName(valueBrandId)), targetType: self.declaredSlotDisplayName(declared, nameId: declaredNameId, fallback: typeTagName(declared)), line: nameTok.line, column: nameTok.column)

			// A FUNCTION VALUE into a NON-function place — the spec's specific E3005 ("cannot
			// assign a value of type 'function' to {noun} '{name}', which holds '{held}'"). The noun comes
			// from the DOOR the caller named, so this site and the function-type check word one place alike.
			functionIntoNonFunction then throw SourceParseError.functionValueIntoNonFunction(functionMisusePlacePhrase(door, name: nameTok.value, owner: placeOwner), heldType: self.declaredSlotDisplayName(declared, nameId: declaredNameId, fallback: typeTagName(declared)), line: nameTok.line, column: nameTok.column)
		end 'declared'
	end 'requireAssignable'
end 'Parser'
