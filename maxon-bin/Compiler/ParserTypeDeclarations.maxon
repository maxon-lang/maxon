	// which comes only after every file has parsed. The sweep published defaults for the kept declaration
	// alone, so this one's drain would find no helper at its parameter's position and panic first
	// (`requireSweptHelperName`).
	function requireDeclarationIsTheSweepsKept(name ByteArray, declaredAt Token) throws SourceParseError
		if self.signatures.keyBelongsToAnotherDeclaration(name, declFilePath: self.job.path, line: declaredAt.line, column: declaredAt.column) 'aLaterDeclaration'
