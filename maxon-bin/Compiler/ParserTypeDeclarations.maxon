		if self.pendingDefaultHelpers.isEmpty() 'noDefaults'
			return
		end 'noDefaults'

		let resume = self.pos

		for pendingIndex in 0 upto self.pendingDefaultHelpers.count() 'eachDefault'
			try self.parseDefaultHelper(try self.pendingDefaultHelpers.get(pendingIndex) otherwise panic("parseDefaultHelpers: pendingIndex {pendingIndex} is below self.pendingDefaultHelpers.count()"))
		end 'eachDefault'

		self.pos = resume

