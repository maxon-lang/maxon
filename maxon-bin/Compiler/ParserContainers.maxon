extension Parser
	// ⭐ **THE RECORD IS BORN WITH ITS SLOTS PUBLISHED** — one `__managed_create_fixed(elementSize,
	// count, count, elementDestroy)` yields a zeroed buffer of `count` elements and a length of
	// `count`, which together are exactly *"zero-initialized, N elements"*. `count` is the type's, or
	// for a runtime-sized instance the `create(n)` argument carried in `sizing`. `element_destroy@40`
	// carries the element's destructor (0 for a scalar element). The call writes nothing but
	// the record it returns, so `SemanticCheck.containerReadCallee` lists it as effect-free and a
	// discarded `create()` is E3064.
	//
	// ⚠ **NOT `__managed_mem_create(N, elementSize)`, WHICH WOULD OTHERWISE BE THE OBVIOUS FIT.** That entry
	// is THROWING (`isManagedMemoryMemberCallee` — it reports `invalidAllocation` for a size the allocator
	// cannot use), so a `create()` built on it is **E3057 throwing function requires try: 'create'** on
	// every one of `/specs/fixed-array.md`'s cases, which write a bare `create()`.
	// `__managed_create_fixed` throws nothing.
	//
	// ⚠⚠ **A MANAGED ELEMENT'S PUBLISHED SLOTS ARE NULL UNTIL THE FILL THAT FOLLOWS THIS CALL WRITES THEM,
	// AND EVERY ACCESSOR DEREFERENCES A NULL MANAGED SLOT.** A plain `create` of a managed element is
	// refused (E3106) by `requireSizedContainerElementType`, so the only construction of one that reaches
	// here is `create(value:)`, whose `emitCreateFill` follows at once. Do not add a caller that publishes
	// a managed element's slots and reads them before a fill.
	function emitSizedContainerRecord(giid GenericInstanceId, anchor Token, range SourceRange, sizing ValueIdArray) returns ValueId throws SourceParseError
		if sizing.count() != 0 'sizedByTheCaller'
			match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: giid as TypeNameId) 'sizingOwner'
				inTheRecord then return try self.emitArrayCreateOp(giid, range: range, sizing: sizing)
				stated or
				callerSlot then panic("emitSizedContainerRecord: a caller sized a fixed array whose count the type states or the caller's slot carries — only a runtime-sized instance takes its sizing from the call that builds it")
			end 'sizingOwner'
		end 'sizedByTheCaller'

		let count = try self.fixedElementCountValue(giid, anchor: anchor)
		return try self.emitArrayCreateOp(giid, range: range, sizing: twoArgs(count, second: count))
	end 'emitSizedContainerRecord'

	// What each container says when the author names a static it does not have. A per-container ROUTER rather
	// than a name threaded into one template, because the tails are not the same sentence with a noun swapped —
	// a node handle and a cursor are constructible by NOTHING, where a chain is `create()`-only.
	//
	// ⚠ `List` and `FixedArray` have no arm here. Each declaring module carries the type, so a bad static on
	// either is the ordinary
	// `E3004 call to undefined function '<Base>.<method>'` every declared type answers with, and this router
	// is never reached for one — `parseQualifiedCall`'s container interception asks `instanceCreateIsDeclared`
	// and lets both fall through to the declared-static road.
	function containerStaticSurfaceSentence(giid GenericInstanceId, method ByteArray) returns String
		if self.signatures.isManagedListInstance(giid) 'managedList'
			return "`{String.from(ManagedListBuiltinBaseName)}` static method '{String.from(method)}' — the compiler provides `{String.from(CreateMethod)}()` only"
		end 'managedList'

		// ⛔ A NODE HANDLE HAS NO STATIC SURFACE AT ALL — not even `create()` — so its sentence names the
		// method the author wrote and offers nothing in its place. It lives here rather than beside either gate
		// because this is where "what does this container offer?" is answered, and both doors that refuse a
		// node read it from here.
		if self.signatures.isManagedListNodeInstance(giid) 'nodeHandle'
			return "`{String.from(ManagedListNodeBuiltinBaseName)}` static method '{String.from(method)}' — a node handle has no static surface at all, not even `{String.from(CreateMethod)}()`: one exists only because a `{String.from(ManagedListBuiltinBaseName)}` insertion linked it, and `insertFirst`/`insertLast` hand back the handle"
		end 'nodeHandle'

		// ⛔⛔ **A CURSOR IS THE NODE HANDLE'S TWIN AND NEEDS ITS OWN ARM — WITHOUT ONE A BAD STATIC ON IT IS A
		// USER-REACHABLE COMPILER PANIC.** `ManagedMemoryCursorBuiltinBaseName`'s own header states
		// the fact (*"the SECOND type no source can construct — only `__ManagedMemory.createCursor()` mints
		// one"*), and the cursor is on `isBuiltinGenericBaseNameBesidesTheRecord`, so
		// `typealias Cur = __ManagedMemoryCursor with Int` + `Cur.frobnicate()` would reach this panic and
		// `Cur.create()` would reach `requireContainerColumnTypes`' panic — both a stack trace in front of
		// an author. It is the roster-written-twice shape: a container on the builtin roster must be told to each
		// "what does this container offer" door.
		if self.signatures.isManagedMemoryCursorInstance(giid) 'cursor'
			return "`{String.from(ManagedMemoryCursorBuiltinBaseName)}` static method '{String.from(method)}' — a cursor has no static surface at all, not even `{String.from(CreateMethod)}()`: one exists only because a `{String.from(ManagedMemoryTypeName)}` handed it out, and `{String.from(ManagedMemoryCreateCursorMethod)}()` is what mints one"
		end 'cursor'

		panic("Parser.containerStaticSurfaceSentence: generic instance {giid} is not a builtin container — every caller opens with the builtin-base test `requireContainerIsCreatable` makes, and a container admitted there owes a sentence here")
	end 'containerStaticSurfaceSentence'

	// Gate this container's element/column types and emit its `create` — ONE router, so the gate and the emit
	// cannot come to disagree about which container they are serving. The gate anchors its diagnostic on the
	// ALIAS token (the type the author wrote is what is inadmissible), the emit spans alias→method.
	function gateAndEmitContainerCreate(giid GenericInstanceId, aliasTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.requireContainerIsCreatable(giid, aliasTok: aliasTok)

		// ⚠ **THERE IS NO `FixedArray` ARM, BECAUSE THE create WHOSE ANSWER IS THE SIZE — which
		// `countof(Self)` is what lets a shared corpus body name — IS DECLARED BY
		// `stdlib/FixedArray.maxon`.** `Vec3.create()` never reaches this router:
		// `instanceCreateIsDeclared` answers TRUE for it and both create doors take the declared road
		// instead. A runtime-sized `Buf.create(n)` is built by `parseRuntimeSizedFixedArrayCreate` and
		// misses it too.
		if self.signatures.isManagedListInstance(giid) 'managedList'
			return try self.emitListCreateOp(giid, range: range)
		end 'managedList'

		panic("Parser.gateAndEmitContainerCreate: generic instance {giid} is not a create-only builtin container — every caller opens with the builtin-base test `requireContainerIsCreatable` makes, and a container admitted there owes a gate and an emit here")
	end 'gateAndEmitContainerCreate'

	// ⭐⭐ **MAY `<Alias>.create()` BE WRITTEN FOR THIS BUILTIN CONTAINER — the WHOLE gate.** It anchors every
	// diagnostic on the ALIAS token: the type the author wrote is what is inadmissible. Two steps, in the
	// order a reader would ask them — does this container have a `create`, and are its columns admissible.
	//
	// ⚠ **PRECONDITION: THE INSTANCE'S BASE IS A BUILTIN CONTAINER**, which the caller establishes
	// (`isBuiltinGenericBaseName` at `parseBuiltinContainerStaticCall`'s call sites). A DECLARED generic is
	// not refused here: it has a real `create()` static to call.
	// A break of the precondition is not silent: `instanceHasBuiltinCreate` admits anything that is not a node
	// handle, and `requireContainerColumnTypes` below then meets its named panic.
	function requireContainerIsCreatable(giid GenericInstanceId, aliasTok Token) throws SourceParseError
		// ⛔ A NODE HANDLE IS NOT CONSTRUCTIBLE — only an insertion mints one — so a `typealias N =
		// __ManagedListNode with T` + `N.create()` is refused with the sentence
		// `containerStaticSurfaceSentence` owns, rather than reaching either router's panic, which is about a
		// container they forgot rather than one that has no create.
		if not self.signatures.instanceHasBuiltinCreate(giid) 'noCreate'
			throw missingStaticMember(self.containerStaticSurfaceSentence(giid, method: CreateMethod), anchor: aliasTok)
		end 'noCreate'

		try self.requireContainerColumnTypes(giid, aliasTok: aliasTok)
	end 'requireContainerIsCreatable'

	// ⭐⭐ **THE SIZED CONTAINER'S ELEMENT RULE, ASKED AT A CONSTRUCTION THAT IS A CALL TO A DECLARED
	// `create()`.** With `stdlib/FixedArray.maxon` owning that create the gate has no emit to ride on, and the
	// rule it enforces is untouched by who writes the body — **a zeroed slot is an ELEMENT only for an
	// element whose zero is a value**, and the corpus `create()` publishes N of them. Left unasked, a managed
	// element gives `count()` answering N while every `get` reports an empty slot, and a `for … in` read
	// dereferencing the nulls (0xC0000005).
	//
	// ⚠ **IT IS ASKED OF THE INSTANCE BEING CONSTRUCTED AND NOT OF THE STATIC BEING CALLED**, because
	// `init(managed)` adopts a buffer into the same inadmissible record that `create()` would publish — the
	// element is a fact about the TYPE, and the construction is where a type with no admissible element
	// stops being an abstraction. Every other constructed generic returns immediately, so a `StrMap.create()`
	// pays one instance-registry read.
	function requireConstructedFixedArrayElementType(constructed ConstructorInstance, aliasTok Token) throws SourceParseError
		match constructed 'constructed'
			none then return
			instance(gid) then try self.requireSizedContainerElementType(gid, aliasTok: aliasTok)
		end 'constructed'
	end 'requireConstructedFixedArrayElementType'

	function fixedArrayStatesItsCount(giid GenericInstanceId) returns bool
		return match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: giid as TypeNameId) 'source'
			stated gives true
			inTheRecord or
			callerSlot gives false
		end 'source'
	end 'fixedArrayStatesItsCount'

	// The rule itself, given a resolved instance — written once because the BODY door holds a
	// `ConstructorInstance` and the TOP-LEVEL door holds a bare id, and a second copy of "is this a fixed array,
	// and is its element admissible" is how one position would come to admit what the other refuses.
	function requireSizedContainerElementType(giid GenericInstanceId, aliasTok Token) throws SourceParseError
		if not self.signatures.isFixedArrayInstance(giid) 'notTheSizedContainer'
			return
		end 'notTheSizedContainer'

		try self.requireFixedArrayElementType(giid, tok: aliasTok)

		try self.requireArrayGrowthHasZeroElement(giid, tok: aliasTok, refusal: ZeroElementRefusal.fixedArrayCreate)
	end 'requireSizedContainerElementType'

	// ⭐ **THE ELEMENT/COLUMN GATE ONE CONTAINER'S `create` PASSES.** Its caller has already established that
	// the instance is a builtin container with a `create`, so this is a TOTAL router over the THREE that have
	// one: `Array` alone has no column rule (its element rule is the instance's own) and says so by returning,
	// and a FOURTH container whose rule someone forgets meets the panic rather than passing ungated.
	//
	// ⚠ **THE COUNT HERE IS THE NUMBER OF ARMS THIS ROUTER OWES, NOT THE SIZE OF THE BUILTIN ROSTER** (see
	// `ProgramSignatures.instanceHasBuiltinCreate`). A count written beside a router is a roster written
	// twice; the arm count is the only number this text can check.
	function requireContainerColumnTypes(giid GenericInstanceId, aliasTok Token) throws SourceParseError
		if self.signatures.isArrayInstance(giid) 'array'
			return
		end 'array'

		if self.signatures.isManagedListInstance(giid) 'managedList'
			try self.requireListElementType(giid, tok: aliasTok)
			return
		end 'managedList'

		panic("Parser.requireContainerColumnTypes: generic instance {giid} is a builtin container with a `{String.from(CreateMethod)}` and no column rule — `requireContainerIsCreatable` admitted it, and a container admitted there owes an arm here even if that arm is `Array`'s bare return")
	end 'requireContainerColumnTypes'

	// ⭐⭐ **THE EMPTY CONTAINER EVERY MEMBER-BY-MEMBER DOOR STARTS FROM — the corpus type's own `create()`.**
	// Its callers are the `CharacterSet` member set (a preset's seed and a `CharSet from […]`), the corpus arm
	// of `Set from […]`, a `[k: v]` map literal, and `List from […]`.
	function emitContainerLiteralCreate(baseName ByteArray, giid GenericInstanceId, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		self.bodyState.emittedCall = EmittedCallOp.none
		let container = try self.emitContainerConstructorCall(baseName, method: CreateMethod, giid: giid, args: ValueIdArray.create(0), mint: CalleeMint.notMinted, anchor: anchor, range: range)
		self.noteEmittedCallAsALiteral()
		return container
	end 'emitContainerLiteralCreate'

	function noteEmittedCallAsALiteral()
		if let opIdx = try self.bodyState.emittedCall.opIndex() 'aCallWasEmitted'
			self.bodyState.literalCallOps.push(opIdx)
		end 'aCallWasEmitted'
	end 'noteEmittedCallAsALiteral'

	// ⭐⭐ **THE RESULT IS ALREADY ENROLLED AS AN OWNED TEMPORARY, SO NO CALLER MAY TRACK IT.** `emitCall`
	// classifies its result +1 owned by the call machinery itself (`enrolOwnedCallTemp`); a caller that
	// tracked it as well would enrol ONE record twice and drop it twice.
	function emitContainerConstructorCall(baseName ByteArray, method ByteArray, giid GenericInstanceId, args ValueIdArray, mint CalleeMint, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		let argLabels = emptyArgLabels(args)
		let argRanges = uniformArgRanges(args, range: range)
		let container = try self.emitCall(qualifiedMethodName(baseName, methodName: method), anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: anchor, resultUsed: true, constructorInstance: ConstructorInstance.instance(giid), mint: mint, places: self.placesOfArguments(args, anchor: anchor))

		// ⭐ **THE RESULT IS THE INSTANCE, AND SAYING SO IS THE CALLER'S JOB — `emitCall` does not do it.**
		// `constructorInstance` is read by the CONSUME side alone; the type half is this separate step, exactly
		// as `parseQualifiedCall` does it after its own `parseCallNamed`. Without it `<Base>.create` hands back
		// the shared body's base `structRef`, which `LowerMaxonToStd.layoutSourceOf` answers by forwarding a
		// descriptor the calling frame does not carry. A literal has no written alias to carry provenance from,
		// which is what the empty name means here.
		self.retypeGenericAliasConstructorResult(container, gid: giid, aliasName: EmptySourceText)
		self.markFreshWhenInputsClean(container, inputs: args)
		return container
	end 'emitContainerConstructorCall'

	// ⭐ **ONE MEMBER INTO A MEMBER-BY-MEMBER CONTAINER LITERAL — `emitContainerLiteralCreate`'s twin.** The
	// call is a VOID mutator; the container OWNS the value from here, and the declared parameter
	// (`Set.insert(element Element)`, `List.append(value Element)`) is what says so. Both declare it
	// POSITIONALLY, so the desugared call spells no label — the half `emitMapLiteralUpsert` has to spell and
	// this one must not, which is the one thing that keeps that function separate from this one.
	//
	// ⛔ **ONE FUNCTION SERVES BOTH CONTAINERS.** A `Set` insert and a `List` append differ in the base
	// name and the method name and in nothing else — not in the ownership rule, which is the
	// load-bearing part: a SECOND, parse-time move here is the LEAK `parseSetMemberList`'s `consume:
	// false` note measures, and a copy is free to add one back.
	function emitContainerLiteralElement(baseName ByteArray, method ByteArray, container ValueId, value ValueId, anchor Token, range SourceRange) throws SourceParseError
		let args = twoArgs(container, second: value)
		let argLabels = emptyArgLabels(args)
		let argRanges = uniformArgRanges(args, range: range)
		self.bodyState.emittedCall = EmittedCallOp.none
		_ = try self.emitCall(qualifiedMethodName(baseName, methodName: method), anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: anchor, resultUsed: false, constructorInstance: self.receiverConstructorInstance(container), mint: CalleeMint.notMinted, places: self.placesOfArguments(args, anchor: anchor))
		self.noteEmittedCallAsALiteral()
	end 'emitContainerLiteralElement'

	function parseContainerFromArray(func IrFunction, headTok Token, container FromHeadContainer) returns ValueId throws SourceParseError
		let sourceTok = self.current()
		let source = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if self.valueIsDeferred(source) 'aDeferredSource'
			return self.mintDeferredValue()
		end 'aDeferredSource'

		let giid = try self.containerInstanceFromArray(source, headTok: headTok, sourceTok: sourceTok, container: container)

		let built = try self.emitContainerConstructorCall(fromHeadBaseName(container), method: InitMethod, giid: giid, args: argsOf(source), mint: CalleeMint.fromConstructionInit, anchor: headTok, range: SourceRange.ofToken(sourceTok))
		self.noteEmittedCallAsALiteral()
		return built
	end 'parseContainerFromArray'

	// The alias's element is checked here rather than by `init`'s argument check, so the E3005 names
	// `source`, not `init`'s own `arr`; `specs/set.md` and `specs/list.md` pin that wording.
	function containerInstanceFromArray(source ValueId, headTok Token, sourceTok Token, container FromHeadContainer) returns GenericInstanceId throws SourceParseError
		if self.namesContainerInstanceAlias(headTok.value, container: container) 'statedByAlias'
			let giid = self.signatures.genericAliasInstanceFrom(headTok.value, readerFilePath: self.job.path)
			let headElement = self.signatures.containerElementType(giid)
			let expected = "{FromSourceArrayNoun} with {self.signatures.typeDisplayName(headElement)}"
			let sourceElement = try self.arraySourceElement(source, expected: expected, sourceTok: sourceTok)

			if not maxonTypesDenoteSame(headElement, b: sourceElement) 'anotherElement'
				throw self.fromSourceMismatch(source, expected: expected, sourceTok: sourceTok)
			end 'anotherElement'

			return giid
		end 'statedByAlias'

		// The array's exact element, never a normalized one: an `Array with Code` strides 1, and
		// `Set with integer`'s `init` would read it as a stride-8 array.
		return self.inferredContainerInstance(container, element: try self.arraySourceElement(source, expected: FromSourceArrayNoun, sourceTok: sourceTok), head: headTok)
	end 'containerInstanceFromArray'

	function inferredContainerInstance(container FromHeadContainer, element MaxonType, head Token) returns GenericInstanceId
		let giid = self.signatures.builtinInstanceForElement(fromHeadBaseName(container), element: element)
		self.recordInferredInstantiation(giid, at: head)
		return giid
	end 'inferredContainerInstance'

	function arraySourceElement(source ValueId, expected String, sourceTok Token) returns MaxonType throws SourceParseError
		if not self.valueIsAnArray(source) 'notAnArray'
			throw self.fromSourceMismatch(source, expected: expected, sourceTok: sourceTok)
		end 'notAnArray'

		return self.signatures.containerElementType(self.valueInstanceId(source))
	end 'arraySourceElement'

	function fromSourceMismatch(source ValueId, expected String, sourceTok Token) returns SourceParseError
		return SourceParseError.builtinArgumentType(String.from(FromSourceParamName), expected: expected, got: self.valueDisplayTypeName(source), line: sourceTok.line, column: sourceTok.column, expectedNote: "", crossesRange: false)
	end 'fromSourceMismatch'

	// ⚠⚠ **A SET MEMBER IS NEVER MOVED AT THE PARSE, AND NO `__set_create(elemDrop)` IS EMITTED.** The corpus
	// `Set.insert` declares its parameter, so the ORDINARY call machinery decides the move — and doing BOTH is
	// a LEAK, not belt-and-braces (a parse-time move DRAINS the value from the statement's pending drops, so
	// the call then takes its own reference and the statement releases nothing). Callers hand `Set.insert`
	// the member as it was parsed.
	//
	// A declared `Set` builds its own fields in its own `create()`, so the record's `keyDrop@40` is not stamped here.

	// ⛔ **AN OPAQUE COLUMN HAS NO STAMP HERE** — its destructor is the enclosing instance's
	// descriptor `destroyFunc@40`, read at run time, so each create branches to its opaque form before
	// asking. See `ProgramSignatures.requireStaticColumnStamp`, which is the one sentence saying so.
	function columnDestroyValue(columnType MaxonType, range SourceRange) returns ValueId
		return match self.signatures.columnDestroyStamp(columnType) 'stamp'
			inline(value) gives self.emitLiteral(value, valueType: MaxonType.integer, range: range)
			dropCallee(callee) gives self.emitCodeAddress(callee, range: range)
		end 'stamp'
	end 'columnDestroyValue'

	// ⛔⛔ **A COLUMN WHOSE ELEMENT IS A RECORD OVER THE ENCLOSING TYPE PARAMETER HAS NO STATIC DESTRUCTOR TO
	// STAMP.** `ProgramSignatures.columnDestroyStamp` ends in `owes a drop → drop callee` / `otherwise → 0`, and
	// for `Array with (Box with Element)` inside `type Bag uses Element` the drop arm answers `__mm_decref` —
	// because `Box with Element`'s own bare `T` field reads NOT MANAGED through `typeIsManaged`, which is the
	// one question a shared body cannot answer. Stamping it would free the record and leave the slot it holds.
	//
	// A create whose element is composed over the caller's parameters never reaches here: it goes out without a
	// stamp (`ProgramSignatures.containerCreateRoute`) and the lowering reads one out of the descriptor table.
	// What reaches here is a create the route stamps statically, and it is refused.
	//
	// ⭐ It is asked at the two CREATE sites and not inside `columnDestroyValue`, because `columnDestroyStamp`
	// is also reached for a top-level global's record, where the shape is structurally impossible (a `.data`
	// global is not inside a generic body) — `requireStaticColumnStamp`'s stated arrangement, one door over.
	function requireColumnDropIsNameable(giid GenericInstanceId, range SourceRange) throws SourceParseError
		if not self.signatures.columnElementOwnsAnUnnameableSlot(self.signatures.containerElementType(giid)) 'nameable'
			return
		end 'nameable'

		throw SourceParseError.unsupported("a container whose element is '{self.signatures.arrayElementDisplayName(giid)}' — a generic instance or tuple written over this type's OWN parameter, resting (itself, or through an instance it holds) a slot declared AT that parameter — cannot be created with a destructor stamped at compile time: a container stamps ONE machine word as its element destructor, and the only word that releases such a slot at every instantiation is read out of the enclosing instance's layout descriptor, which a create stamped this way does not read. Construct the container through an inner typealias (`<Alias>.create()` or `<Alias>\{\}`), whose create reads the destructor out of the enclosing instance's layout descriptor; or hold the values in a container of the type PARAMETER itself (`Array with <type parameter>`); or build the container in a method of a concrete instantiation", line: range.line, column: range.column)
	end 'requireColumnDropIsNameable'

	// ⚠ **THERE IS NO HASH-TABLE KEY ROSTER, AND
	// `specs/array-conditional-conformance-withheld.md` SAYS SO IN ITS OWN WORDS**
	// (*"the roster is gone, and any `Hashable + Equatable` type is a key"*): `stdlib/Map.maxon` and
	// `stdlib/Set.maxon` declare `where Key is Hashable and Equatable`, so a bad key is the ordinary
	// `where`-constraint refusal at the INSTANTIATION (`checkWhereConstraints`) — which NAMES the constraint
	// that failed instead of reciting a roster, and admits any conforming user type (`map.md`'s
	// `a-user-type-can-be-a-map-key`).

	// Is `name` a typealias for an instance of `container` — the alias form of a `from` construction's head?
	// Asked of the whole-program index, which is complete in the real parse; during the tolerant sweep every
	// alias answers no, which is sound because the sweep's artifact is discarded, and because the instance an
	// alias names was interned by its own declaration.
	//
	// ⚠ **EACH CONTAINER IS ASKED ITS OWN WAY, NOT BY ONE BASE-NAME COMPARE.** `isArrayInstance` also admits
	// the compiler's own minted `__Array_<T>` spellings (`SignatureIndex.isArrayBaseName`), which a name
	// equality would answer `false` for.
	//
	// ⚠⚠ **THE *SHAPE* QUESTION, NEVER THE RUNTIME ONE.** `CharSet from ['x']` is a construction
	// whoever serves the container, so a `Set` is asked `isSetShapedInstance`; asked which runtime executes
	// it, every alias head fell through to **`E2004: Undefined variable 'CharSet'`**.
	function consumeConstructionHead() returns Token throws SourceParseError
		let head = try self.readTypeNameHead(TypeNameHeadForm.construction)
		try self.settleTypeNameVerdict(head.verdict)

		if head.identity.equals(head.token.value) 'writtenNameIsItsIdentity'
			return head.token
		end 'writtenNameIsItsIdentity'

		return Token.create(TokenKind.identifier, line: head.token.line, column: head.token.column, value: head.identity, startByte: head.token.startByte, endByte: head.token.endByte)
	end 'consumeConstructionHead'

	function readTypeNameHead(form TypeNameHeadForm) returns TypeNameHead throws SourceParseError
		let head = try self.typeNameHeadAtCursor()

		match form 'form'
			reference then return head
			construction then break
		end 'form'

		try self.consume(TokenKind.from)
		return head
	end 'readTypeNameHead'

	function typeNameHeadAtCursor() returns TypeNameHead throws SourceParseError
		let headIndex = self.pos
		self.noteTypeNameMention(headIndex)

		if self.qualifiedTypeBaseIsAt(headIndex) 'anEnteredQualifiedBase'
			let baseTok = try self.typeBaseTokenAt(headIndex)
			self.advance()
			return TypeNameHead.create(baseTok, identity: baseTok.value, verdict: TypeNameVerdict.nameable)
		end 'anEnteredQualifiedBase'

		let headTok = try self.consume(TokenKind.identifier)
		let verdict = try self.typeNameVerdictAt(headIndex, written: headTok.value, anchor: headTok)
		return TypeNameHead.create(headTok, identity: self.signatures.bareWrittenKey(headTok.value, readerFilePath: self.job.path), verdict: verdict)
	end 'typeNameHeadAtCursor'

	function noteTypeNameMention(index ElementIndex)
		if self.qualifiedTypeBaseIsAt(index) 'anEnteredQualifiedBase'
			return
		end 'anEnteredQualifiedBase'

		self.recordTypeNameUse(self.tokenAt(index).value)
	end 'noteTypeNameMention'

	function namesContainerInstanceAlias(name ByteArray, container FromHeadContainer) returns bool
		if not self.signatures.isAliasOfFormFor(name, readerFilePath: self.job.path, wanted: FormAliasKind.generic) 'notAGenericAlias'
			return false
		end 'notAGenericAlias'

		let giid = self.signatures.genericAliasInstanceFrom(name, readerFilePath: self.job.path)

		return match container 'container'
			set gives self.signatures.isSetShapedInstance(giid)
			list gives self.signatures.genericInstanceBaseName(giid).equals(ListBuiltinBaseName)
			fixedArray gives self.signatures.isFixedArrayInstance(giid)
			array gives self.signatures.isArrayInstance(giid)
		end 'container'
	end 'namesContainerInstanceAlias'

	// ⭐⭐ **`ByteArray from [10, 20, 30]` — AND IT EMITS NOT ONE RUNTIME OP OF ITS OWN**, `FixedArray from […]`'s
	// property and for the same reason: the array literal already builds exactly the record an `Array` is. It
	// does not even need that construction's RETYPE, because the instance was known BEFORE the literal was
	// parsed and the literal was built at it — the head's whole contribution is the `ArrayLiteralElementSource`
	// it hands down.
	//
	// ⭐ **WHICH IS THE POINT: THE ELEMENT TYPE IS THE ONE THING A `[…]` CANNOT STATE FOR ITSELF.** `[10, 20,
	// 30]` is an `Array with integer` striding 8; the same three tokens under a head naming `Array with Byte`
	// are three bytes. That is the same job `CharSet from ['x', 'y', 'z']` does for a `Set` — the alias supplies
	// what the bracket list cannot — and it is why `List`/`FixedArray` have no alias form: a list's and a fixed array's
	// element are whatever the literal's elements already are.
	//
	// The head NAMES a type, so it is a use for the E3062 unused-type check — the hook
	// `parseLiteralInitConstruction` takes for the same reason: this form never reaches
	// `parseTypeReference` either.
	function parseArrayFromConstruction(func IrFunction) returns ValueId throws SourceParseError
		let headTok = try self.consumeConstructionHead()

		// The source must be an array literal `[…]`, as it must for a `FixedArray` head.
		if not self.at(TokenKind.leftBracket) 'notArrayLiteral'
			let srcTok = self.current()
			throw SourceParseError.unsupported("`{String.from(headTok.value)} from` requires an array literal `[…]` — `{String.from(headTok.value)} from <expr>` for another source is not a construction", line: srcTok.line, column: srcTok.column)
		end 'notArrayLiteral'

		return try self.parseArrayLiteral(func, element: ArrayLiteralElementSource.stated(self.signatures.genericAliasInstanceFrom(headTok.value, readerFilePath: self.job.path)))
	end 'parseArrayFromConstruction'

	// ⭐ **`Set from [1, 2, 3]` OR `Set from <array>`.** The cursor sits on the head identifier. A
	// source that is not a bracketed list is a call of `Set.init` (`parseContainerFromArray`). A
	// bracketed list forks on what the members ARE: a `Set with Character` reads them as character
	// literals (`parseCharacterMemberSetLiteral`), and every other key type reads them as ordinary
	// expressions (`parseSetMemberList`). Both literal forks desugar to `Set.create()` plus one
	// `Set.insert` per member.
	function parseSetFromConstruction(func IrFunction) returns ValueId throws SourceParseError
		let setTok = try self.consumeConstructionHead()

		if not self.at(TokenKind.leftBracket) 'notArrayLiteral'
			return try self.parseContainerFromArray(func, headTok: setTok, container: FromHeadContainer.set)
		end 'notArrayLiteral'

		// ⭐ **A CHARACTER-KEYED SET IS BUILT MEMBER BY MEMBER, NOT THROUGH AN ARRAY.** Every
		// other key type infers its instance from the array literal's ELEMENT type — but a single-byte
		// character literal materializes as an INT (The compiler types one by its byte width), so `['x','y','z']`
		// would infer `Array with integer` and a `Set with int` of byte values. The ALIAS states the key type
		// the elements cannot, so the bracket list is read as members directly and each element adopts
		// `Character` the way every other Character-expecting position makes a literal adopt it.
		if self.namesContainerInstanceAlias(setTok.value, container: FromHeadContainer.set) and self.signatures.genericAliasInstanceFrom(setTok.value, readerFilePath: self.job.path) == self.signatures.setInstanceForCharacter() 'characterKeyed'
			return try self.parseCharacterMemberSetLiteral(func, anchor: setTok, range: SourceRange.ofToken(setTok))
		end 'characterKeyed'

		// A literal is built member by member, which spares the intermediate `Array` record `Set.init`
		// would take; `Map` takes the same route one container over.
		return try self.parseSetMemberList(func, setTok: setTok)
	end 'parseSetFromConstruction'

	// ⭐⭐ **`Set from [m0, m1, …]` ONTO A DECLARED `Set` — `Set.create()` plus one `Set.insert` per
	// member.** The cursor sits on the `[`. Under an alias head the alias fixes the instance and
	// `Set.insert` types every member. Under the bare base name the FIRST member fixes the element
	// type and therefore the instance, exactly as `parseMapLiteralBody`'s first pair fixes both of its
	// columns, and every later member is held to that type through the SHARED hash-table column door —
	// so a mixed literal is refused with the sentence a written `s.insert(x)` of the wrong type
	// already gets.
	//
	// ⚠ **NO MEMBER IS MOVED AT THE PARSE.** The corpus `Set.insert` declares its
	// parameter, so the ORDINARY call machinery decides the move — see the note below `emitContainerLiteralCreate` for the leak
	// a second, parse-time move produces.
	function parseSetMemberList(func IrFunction, setTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(setTok)
		try self.consume(TokenKind.leftBracket)

		// An EMPTY literal names no element, so there is no instance to create — and unlike an array literal,
		// which has `[]`'s own int default, a set's element must satisfy `Set`'s `where` clause before a
		// witness can be threaded. The alias form is the spelling that states a key type, so it is what the
		// refusal points at.
		if self.at(TokenKind.rightBracket) 'noMembers'
			throw SourceParseError.unsupported("`{String.from(SetBuiltinBaseName)} from []` states no {HashTableKeyColumnNoun} type — an empty set is `<alias>.{String.from(CreateMethod)}()` over a `{String.from(SetBuiltinBaseName)} with <{HashTableKeyColumnNoun}>` alias", line: setTok.line, column: setTok.column)
		end 'noMembers'

		let firstTok = self.current()
		let first = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if self.valueIsDeferred(first) 'aDeferredFirstMember'
			return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
		end 'aDeferredFirstMember'

		let statedByAlias = self.namesContainerInstanceAlias(setTok.value, container: FromHeadContainer.set)
		let giid = try self.memberListInstance(setTok, container: FromHeadContainer.set, statedByAlias: statedByAlias, first: first, firstTok: firstTok, literalKind: SetLiteralSubject, columnNoun: HashTableKeyColumnNoun)

		let set = try self.emitContainerLiteralCreate(SetBuiltinBaseName, giid: giid, anchor: setTok, range: range)
		try self.emitContainerLiteralElement(SetBuiltinBaseName, method: InsertMethod, container: set, value: first, anchor: setTok, range: range)
		var signs = try self.foldColumnSign(ColumnSigns.unseen, value: first, anchor: firstTok)

		let declaredType = self.resolvedSlotType(self.signatures.containerElementType(giid))
		let declared = maxonTypeTag(declaredType)
		let identity = self.declaredColumnIdentity(declaredType)

		while try self.atAnotherLiteralEntry() 'moreMembers'
			let memberTok = self.current()
			let member = try self.parseSetLiteralMember(func, statedByAlias: statedByAlias, declaredType: declaredType, columnSubject: "`{String.from(SetBuiltinBaseName)} with {columnTypeName(declared, identity: identity)}` requires {articledColumnTypeName(declared, identity: identity)} {HashTableKeyColumnNoun}")

			if self.valueIsDeferred(member) 'aDeferredMember'
				return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
			end 'aDeferredMember'

			signs = try self.foldColumnSign(signs, value: member, anchor: memberTok)

			try self.emitContainerLiteralElement(SetBuiltinBaseName, method: InsertMethod, container: set, value: member, anchor: setTok, range: range)
		end 'moreMembers'

		try self.consume(TokenKind.rightBracket)
		return set
	end 'parseSetMemberList'

	function parseSetLiteralMember(func IrFunction, statedByAlias bool, declaredType MaxonType, columnSubject String) returns ValueId throws SourceParseError
		if statedByAlias 'typedByTheInsert'
			return try self.parseExpression(func, block: self.bodyState.currentBlock)
		end 'typedByTheInsert'

		return try self.parseHashTableColumnArg(func, declaredType: declaredType, columnSubject: columnSubject)
	end 'parseSetLiteralMember'

	// ⭐⭐ **`FilePath from "C:\\x.txt"` — THE `InitableFromStringLiteral` CONSTRUCTION, WHICH IS SUGAR
	// AND NOTHING MORE.** It is exactly `<Type>.init(<the literal as a String>)`, which is what the
	// interface itself says (`stdlib/Builtins.maxon:40` — `static function init(value String) returns
	// Self`).
	//
	// ⭐ **SO IT REUSES `emitCall`, and that is the whole implementation.** The callee is the SAME
	// `qualifiedMethodName(<Type>, "init")` a written-out `FilePath.init("…")` builds — verified by running
	// both spellings side by side — so the result type, the arity and argument checks, the ownership of the
	// returned struct and the E3004 for a type with no `init` are the ones every other static call gets, and
	// none of them learns that this sugar exists. A bespoke emit here would be a second static-call path.
	//
	// ⚠ **THE LITERAL GOES THROUGH `parseStringLiteral`, NOT A RAW TOKEN DECODE**, so an INTERPOLATED
	// `Type from "a{n}b"` materializes its String the one way every other String expression does. The
	// reference does the same (`EmitStringLiteralWithInterpolation`); decoding the token here would have been
	// a second literal decoder that silently dropped the interpolation.
	//
	// ⚠ **THE CONFORMANCE IS NOT CHECKED HERE, AND IT CANNOT BE.** `implements InitableFromStringLiteral` is
	// recorded when the type's OWN file is parsed, and the compiler orders files only by source path — so the answer
	// at this cursor depends on which file came first. The site is RECORDED and the verdict taken after the
	// merge (`ConformanceCheck.checkLiteralInitConformance`), which is `checkWhereConstraints`' shape and its
	// reason. The site's anchor is the TYPE NAME token, where the oracle anchors the same E3005.
	function parseLiteralInitConstruction(func IrFunction, form LiteralInitForm) returns ValueId throws SourceParseError
		let typeTok = try self.consumeConstructionHead()

		let callee = qualifiedMethodName(typeTok.value, methodName: InitMethod)
		let literalTok = self.current()
		let literalStart = self.pos
		let value = try self.parseLiteralInitOperand(func, form: form, callee: callee)

		let args = ValueIdArray.create(0)
		let argLabels = NameRoster.create(0)
		let argRanges = SourceRangeArray.create(0)
		let argImmutableNames = NameRoster.create(0)

		// Filled and DISCARDED: a literal-init call emits a real `MaxonOp.call`, so SemanticCheck types its one
		// argument against `init`'s signature and no refusal here needs a token of its own.
		let argAnchors = TokenIndexArray.create(0)

		// POSITIONAL and un-nameable: `init`'s single parameter takes it at position 0, and a literal is not a
		// bare binding, so it can never be the subject of an E3207 blame.
		pushCallArg(args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, value: value, label: EmptySourceText, range: SourceRange.ofToken(literalTok), immutableName: EmptySourceText, anchorIndex: literalStart)

		self.artifact.literalInitSites.push(LiteralInitSite.create(typeTok.value, interfaceName: literalInitInterfaceName(form), nameLine: typeTok.line, nameColumn: typeTok.column, filePath: self.job.path))

		// `rparenTok` is the LITERAL — this form writes no parenthesis, and that token is what a diagnostic
		// about the call's tail must point at. `resultUsed: true` because a construction is an expression:
		// `parsePrimary` only reaches here in operand position.
		// `fromConstructionInit`, not `notMinted`: the author wrote `FilePath from "…"` and never named `init`, and
		// that is the only fact distinguishing this call from a written-out `FilePath.init("…")` — they build
		// the identical callee. See `CalleeMint.fromConstructionInit`.
		let built = try self.emitCall(callee, anchor: typeTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, rparenTok: literalTok, resultUsed: true, constructorInstance: self.constructorInstanceOf(typeTok.value), mint: CalleeMint.fromConstructionInit, places: self.placesOfArguments(args, anchor: literalTok))
		self.noteEmittedCallAsALiteral()
		return built
	end 'parseLiteralInitConstruction'

	// The operand each form takes. A String literal goes through `parseStringLiteral` so an INTERPOLATED
	// `Type from "a{n}b"` materializes the one way every other String expression does; a character literal has
	// no interpolation and goes through the shared byte decoder every other `'x'` reads. An array literal is
	// built at the instance `init`'s parameter states, exactly as it is when written as that call's argument,
	// because its element stride is fixed when the record is built.
	function parseLiteralInitOperand(func IrFunction, form LiteralInitForm, callee ByteArray) returns ValueId throws SourceParseError
		match form 'f'
			stringLiteral then return try self.parseStringLiteral(func)
			charLiteral then return try self.parseCharLiteral()
			arrayLiteral then self.stateLiteralTargetForArgument(CallArgTarget.callee(callee), sourceIndex: 0, label: EmptySourceText, valueStart: self.pos, args: ValueIdArray.create(0), receiverArgs: 0, constructorInstance: ConstructorInstance.none)
		end 'f'

		return try self.parseArrayLiteral(func, element: ArrayLiteralElementSource.inferred)
	end 'parseLiteralInitOperand'

	// ⭐⭐ **ONE HASH-TABLE COLUMN ARGUMENT, PARSED — a `Set`'s key, a `Map`'s key and a `Map`'s VALUE.** Parse
	// the expression, characterize a lone literal against the column's declared type, and refuse a mismatched
	// tag. The value is handed back unmoved: the `insert` or `upsert` call that stores it decides the move. The
	// three columns differ in the column TYPE they read and in the SUBJECT of their refusal, and in nothing
	// else, which is why those two are parameters and the sequence is not.
	//
	// ⚠ A lone character literal coerces to the column's type when that column is integral — a column
	// declared over a ranged integer alias — by the rule the `let`/`return`/comparison positions serve
	// (`integerizedOperand`). The tag rule itself is `columnValueTagMatches`, whose header says why
	// "is this an int?" is `tagIsIntegral` and not `== ValueTypeTag.integer`.
	//
	// The column type is resolved first, and the comparison is `columnValueMatches` rather than the
	// bare tag rule, because a `Map`'s value column may carry a nominal identity. Each half is a wrong
	// answer without the other:
	//
	//   • resolved: a `Map with (String, UnaryOp)` records its value argument as `named("UnaryOp")` —
	//     the declaration sweep ran before anything could say what the name denoted — and
	//     `tagIsIntegral(named)` is true, so the raw tag says "int" about a code pointer.
	//     `resolvedSlotType` is the same first step the element read takes (`containerSlotValueType`),
	//     so the write door and the read door agree.
	//   • identity: an enum column and an int column are both integral to the tag rule, so
	//     `["a": Kind.X, "b": 5]` would store a bare 5 where a `match` later reads a case. In
	//     `columnValueMatches` an identity on either side settles it, and only when neither has one
	//     does the tag rule decide (which is what keeps a ranged-alias key admitted).
	//
	// A deferred value is admitted unchecked: the E3004 at its call is the program's diagnostic.
	//
	// ⚠ The identity is `declaredColumnIdentity`'s, which the two callers compose their SUBJECTS from, so the
	// name a refusal prints and the name this comparison read are one string by construction.
	function parseHashTableColumnArg(func IrFunction, declaredType MaxonType, columnSubject String) returns ValueId throws SourceParseError
		let valueTok = self.current()
		let valueStart = self.pos
		let declared = maxonTypeTag(declaredType)
		self.stateDeclaredLiteralTarget(declaredType, scopeFilePath: self.job.path, valueStart: valueStart)
		let parsed = try self.integerizedOperand(try self.parseExpression(func, block: self.bodyState.currentBlock), expected: declared, start: valueStart, pastEnd: self.pos)

		let valueTag = self.tagOf(parsed)
		let valueIdentity = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: valueTag, nameId: self.valueNameId(parsed), readerFilePath: self.job.path)

		if not tagIsUnresolved(valueTag) and not columnValueMatches(declared, declaredIdentity: self.declaredColumnIdentity(declaredType), valueTag: valueTag, valueIdentity: valueIdentity) 'mismatch'
			throw SourceParseError.unsupported("{columnSubject} — got a '{columnTypeName(valueTag, identity: valueIdentity)}' value", line: valueTok.line, column: valueTok.column)
		end 'mismatch'

		return parsed
	end 'parseHashTableColumnArg'

	// ⭐⭐ **THE NOMINAL IDENTITY OF A COLUMN'S RESOLVED DECLARED TYPE — the ONE expression the three column
	// doors share.** `parseSetMemberList` and `parseMapColumnValue` build the refusal's SUBJECT from it and
	// `parseHashTableColumnArg` runs the `columnValueMatches` COMPARISON with it, so "the name a refusal
	// PRINTS" and "the name the check COMPARED" are one string BY CONSTRUCTION rather than by three copies of
	// one expression agreeing. Spelled out at each site, changing one described a different program from the
	// one refused, with no compile error anywhere to say so.
	//
	// ⚠ It is the UNGATED `aggregateNameIn`: a nested-container value column is admitted, and two distinct
	// instances share the `genericInstance` tag, so a gate withholding that tag's name would equate them.
	function declaredColumnIdentity(declaredType MaxonType) returns immutable ByteArray
		return aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: maxonTypeTag(declaredType), nameId: typeNameIdOf(declaredType), readerFilePath: self.job.path)
	end 'declaredColumnIdentity'

	// --- The `Map` builtin generic: `create` / `upsert` / `contains` / `get` / `count` ---

	// ⛔⛔ **AN INFERRED INSTANCE HAS NO `with` CLAUSE TO ANCHOR AN E3017 ON.**
	// `ProgramSignatures.instantiationSites` is built by the token sweep out of `typealias`
	// declarations, so nothing in it names an instance a construction inferred, and an argument
	// implementing NEITHER interface would be admitted in silence — a witness dispatch through a table
	// nothing stamped. So the construction RECORDS its instantiation, and the ordinary whole-program
	// check reports the container's own `where` clause against it: the same code, sentence and anchor
	// a written alias gets, from one rule rather than two.
	//
	// ⚠ **THE VERDICT CANNOT BE TAKEN HERE, and that is structural rather than tidiness.** A type's
	// `implements` clause is recorded when its OWN file is parsed and the compiler orders files only by source path,
	// so the answer at this cursor depends on which file came first — `checkLiteralInitConformance`'s reason,
	// one door over, for the identical deferral.
	function recordInferredInstantiation(giid GenericInstanceId, at Token)
		self.artifact.inferredInstantiationSites.push(GenericInstantiationSite.create(giid, nameLine: at.line, nameColumn: at.column, filePath: self.job.path))
	end 'recordInferredInstantiation'

	// ⚠⚠ **A MAP LITERAL'S COLUMN VALUES ARE NOT MOVED AT THE PARSE.** The corpus `Map.upsert` declares its
	// parameters, so `applyCallerConsume` reads their signature and the ORDINARY call machinery decides: it
	// MOVES an owned managed argument at a consuming position and CO-OWNS a borrowed one with a real
	// `__mm_retain` (`handleEscapingBorrowFeed`).
	//
	// ⚠ **DOING BOTH IS NOT BELT-AND-BRACES, IT IS A LEAK, and only ONE column class shows it.** The
	// two protocols AGREE wherever the call CONSUMES — an `int` column owns no record, and a `String` column is
	// `typeArgIsOwned` TRUE — so those columns show nothing. An all-scalar STRUCT answers that
	// question `false` and is BORROWED, and there the drained temporary is a reference nobody releases
	// (MEASURED: `let m = [1: Pair.create(3, b: 4)]` exited **101** against the oracle's 1;
	// `specs/map.md`'s `literal.aggregate-value-column` is that program). That case is what holds the
	// no-parse-time-move rule down.

	// ⭐ **ONE PAIR INTO THE MAP — `emitContainerLiteralElement`'s two-column twin, and the `value:` LABEL is
	// the half that is easy to leave off.** `Map.upsert(key Key, value Value)` declares its second parameter
	// labelled, so the synthesized call must spell it exactly as a written `m.upsert(k, value: v)` does or the
	// argument matcher answers about a parameter the author never named.
	//
	// ⚠ **THAT LABEL IS THE WHOLE REASON THIS IS NOT THE SHARED DOOR**, and it is a real difference rather
	// than a spelling: a `Map` hands its member in as a `(key, value)` PAIR whose second half is named, so the
	// argument array is a triple and the label column is not empty. Everything else — the void result, the
	// `receiverConstructorInstance`, the no-parse-time-move rule — is that function's answer and is stated
	// there once.
	function emitMapLiteralUpsert(func IrFunction, map ValueId, key ValueId, value ValueId, anchor Token, range SourceRange) throws SourceParseError
		let args = threeArgs(map, second: key, third: value)
		let argLabels = emptyArgLabels(args)
		try argLabels.set(MapUpsertValueArgSlot, value: MapUpsertValueLabel) otherwise panic("emitMapLiteralUpsert: the label column for a three-argument call has no slot {MapUpsertValueArgSlot} — `emptyArgLabels` mints one entry per argument")
		let argRanges = uniformArgRanges(args, range: range)
		self.bodyState.emittedCall = EmittedCallOp.none
		_ = try self.emitCall(qualifiedMethodName(MapBuiltinBaseName, methodName: UpsertMethod), anchor: anchor, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: NameRoster.create(0), rparenTok: anchor, resultUsed: false, constructorInstance: self.receiverConstructorInstance(map), mint: CalleeMint.notMinted, places: self.placesOfArguments(args, anchor: anchor))

		if let opIdx = try self.bodyState.emittedCall.opIndex() 'aCallWasEmitted'
			let notes = self.notesForWrite(func)
			notes.constructionOps.push(opIdx)
		end 'aCallWasEmitted'

		self.noteEmittedCallAsALiteral()
	end 'emitMapLiteralUpsert'

	// ⭐⭐ **`[k0: v0, k1: v1, …]` — A MAP LITERAL.** The cursor sits on the `:` after the first key, which
	// `parseArrayLiteral` has already parsed and handed over. It desugars to `Map.create()` plus one
	// `Map.upsert` per pair — the SAME two calls a `MapAlias.create()` + `upsert` program emits, so a
	// literal-built map and a hand-built one are one representation and one instance.
	//
	// ⚠ **THE FIRST PAIR FIXES BOTH COLUMNS, so the record cannot be created until both halves are parsed** —
	// the create stamps the two per-column destructors, and those are read off the column TYPES. That is
	// `parseArrayLiteral`'s managed path exactly, one column wider.
	//
	// ⚠ No half of a pair moves in at the parse: the desugared `Map.upsert` declares both parameters,
	// so the ordinary call machinery decides each column's ownership, and a second, parse-time move
	// would drain the value from the statement's pending drops and leak.
	//
	// ⭐⭐ **A LITERAL'S COLUMNS ARE HELD TO WHOEVER SERVES THE MAP.** A corpus `Map` is governed by its own
	// declared `where` clause and not by a builtin key roster, so this door does not route through
	// `requireContainerColumnTypes`: that function is a TOTAL router over the BUILTIN containers and meets its
	// named panic on anything else, which is exactly what a corpus `Map` is. A user `Hashable`/`Equatable`
	// type is therefore a valid key in a `[k: v]`, as it is through `PointMap.create()` + `upsert`
	// (`map.md`'s `a-user-type-can-be-a-map-key`).
	function parseMapLiteralBody(func IrFunction, firstKey ValueId, firstKeyTok Token, literalStart ElementIndex, range SourceRange) returns ValueId throws SourceParseError
		if self.valueIsDeferred(firstKey) 'aDeferredFirstKey'
			return try self.deferredMapLiteralFromKey(func)
		end 'aDeferredFirstKey'

		let keyType = try self.literalColumnTypeFor(firstKey, literalKind: MapLiteralSubject, columnNoun: HashTableKeyColumnNoun, valueTok: firstKeyTok)

		try self.consume(TokenKind.colon)
		let heldFirstKey = self.holdStorageReadForStatement(firstKey, kind: HoldKind.callOperand, range: SourceRange.ofToken(firstKeyTok), position: OperandSuccession.alwaysFollowed)
		let firstValueTok = self.current()
		let firstValueStart = self.pos
		let firstValue = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if self.valueIsDeferred(firstValue) 'aDeferredFirstValue'
			return try self.deferredLiteralRest(func, entry: LiteralEntryShape.pair)
		end 'aDeferredFirstValue'

		let valueType = try self.literalColumnTypeFor(firstValue, literalKind: MapLiteralSubject, columnNoun: HashTableValueColumnNoun, valueTok: firstValueTok)

		let giid = self.signatures.builtinInstanceForColumns(MapBuiltinBaseName, key: keyType, value: valueType)
		try self.admitInstanceArgStore(func, giid: giid, position: MapValueArgPosition, value: firstValue, valueStart: firstValueStart, place: MapLiteralValuePlace)

		// The literal is the one door a map can be born through without a `with (K, V)` annotation, so it owes
		// the same column gate the annotated door owes — asked BEFORE the create, so a refused literal emits no op.
		self.recordInferredInstantiation(giid, at: firstKeyTok)

		// ⭐⭐ **THE LITERAL CALLS THE CORPUS TYPE'S OWN METHODS.** The desugar is an empty map plus one
		// insert-or-replace per pair, so a literal-built map and a hand-built one are one representation and one
		// instance — the property this function's header claims.
		//
		// ⚠ **MEASURED, and it is why this door must not emit builtin ops**: a door that emitted them would build
		// a fused hash-table record for `let m = [1: 10]` and then dispatch
		// `m.count()` into the corpus body that reads six declared fields — **0xC0000005 on 32 of `map.md`'s
		// cases**, a green compile every time.
		let map = try self.emitContainerLiteralCreate(MapBuiltinBaseName, giid: giid, anchor: firstKeyTok, range: range)
		var keyBounds = self.boundsOfValue(firstKey)
		var valueBounds = self.boundsOfValue(firstValue)
		var keySigns = try self.foldColumnSign(ColumnSigns.unseen, value: firstKey, anchor: firstKeyTok)
		var valueSigns = try self.foldColumnSign(ColumnSigns.unseen, value: firstValue, anchor: firstValueTok)
		try self.emitMapLiteralUpsert(func, map: map, key: heldFirstKey, value: firstValue, anchor: firstKeyTok, range: range)

		while try self.atAnotherLiteralEntry() 'morePairs'
			// Every later pair is checked AGAINST the first's columns — the map-literal twin of
			// `admitArrayLiteralElement` — and rides the ordinary column-argument door, which
			// characterizes a lone literal and refuses a mismatched tag. A mixed literal is
			// therefore refused by the same sentence a mismatched `upsert` argument is.
			// ⚠ The desugared `Map.upsert` declares both parameters, so the call machinery takes each column
			// and a parse-time move would leak.
			let keyTok = self.current()
			let key = try self.parseMapColumnValue(func, giid: giid, position: HashTableKeyArgPosition, columnNoun: HashTableKeyColumnNoun)

			if self.valueIsDeferred(key) 'aDeferredKey'
				return try self.deferredMapLiteralFromKey(func)
			end 'aDeferredKey'

			try self.consume(TokenKind.colon)
			let heldKey = self.holdStorageReadForStatement(key, kind: HoldKind.callOperand, range: SourceRange.ofToken(keyTok), position: OperandSuccession.alwaysFollowed)
			let valueTok = self.current()
			let valueStart = self.pos
			let value = try self.parseMapColumnValue(func, giid: giid, position: MapValueArgPosition, columnNoun: HashTableValueColumnNoun)

			if self.valueIsDeferred(value) 'aDeferredValue'
				return try self.deferredLiteralRest(func, entry: LiteralEntryShape.pair)
			end 'aDeferredValue'

			try self.admitInstanceArgStore(func, giid: giid, position: MapValueArgPosition, value: value, valueStart: valueStart, place: MapLiteralValuePlace)

			keySigns = try self.foldColumnSign(keySigns, value: key, anchor: keyTok)
			valueSigns = try self.foldColumnSign(valueSigns, value: value, anchor: valueTok)
			keyBounds = keyBounds.joinedWith(self.boundsOfValue(key))
			valueBounds = valueBounds.joinedWith(self.boundsOfValue(value))
			try self.emitMapLiteralUpsert(func, map: map, key: heldKey, value: value, anchor: firstKeyTok, range: range)
		end 'morePairs'

		try self.consume(TokenKind.rightBracket)
		self.recordLiteralColumns(map, pair: ColumnPair.create(keyBounds, second: valueBounds))

		if literalStart == self.bodyState.imagedLetInitializerStart and self.at(TokenKind.newline) and self.tokensWriteAConstantLiteral(literalStart, pastEnd: self.pos) 'aConstantLet'
			self.setValueCapability(map, capability: ValueCapability.immutable)
		end 'aConstantLet'

		// ⛔ A `trackOwnedTemp(map, exclusivity: sole)` here DOUBLE-DROPS every map literal used as a
		// temporary: `[1: 10, 2: 20, 3: 30].count()` exits **0xC0000005** instead of answering **3**,
		// with two consecutive `x64.callDirect __destruct_Map_int_int` on the same record in `@main`.
		//
		// ⭐ **THE CREATE IS AN `emitCall`, WHICH CLASSIFIES ITS RESULT +1 OWNED BY ITSELF (`enrolOwnedCallTemp`).**
		// A raw runtime op owns nothing until a caller says so; the map create is not one. Tracking it again enrols one
		// record TWICE. `emitContainerLiteralCreate`'s header states exactly this rule and `parseSetMemberList` obeys it
		// by returning without tracking.
		//
		// ⚠ **THE BOUND FORM HIDES IT, AND THE REASON IS WORTH KEEPING**: `removeFromPendingTemps` strips
		// ALL occurrences, so the BOUND form (`let m = [1: 10]`) cancels both enrolments and answers
		// correctly. Only the unbound temporary — a literal consumed in value or condition position —
		// reaches scope exit still holding two. `specs/block-condition-temporaries.md` is the spec for
		// exactly that shape and every one of its cases used an ARRAY literal; the map cases below it are
		// this fix's gate.
		return map
	end 'parseMapLiteralBody'

	// ⚠⚠ **NO BUILTIN `Map` SURFACE LIVES HERE — NOT THE UPSERT CALL, THE ENTRIES ARRAY OR A METHOD DISPATCHER.**
	// A `Map` is a declared generic: every member (`count`/`contains`/`get`/`remove`/`upsert`/`insert`/`map`)
	// is `stdlib/Map.maxon`'s own body reached
	// through the ordinary method path, `Map.get`/`Map.insert` declare `throws MapError` themselves, and the
	// entry pair is `MapIterator.current()`'s — so `for … in` and `map` both take the `Iterable` cursor route
	// (`materializeIterableIterationSource`) rather than a materialized array.
	//
	// ⭐ What lives here is `parseMapColumnValue` below: `parseMapLiteralBody` parses a `[k: v]`
	// literal's columns, and it is the one door a map is born through with no `with (K, V)` to anchor on.

	// ONE `Map` column argument — the `Set` key's twin, and it rides the same `parseHashTableColumnArg`: this
	// end resolves WHICH column (key or value) and composes the `Map`'s own refusal subject, and nothing else.
	// The key half and the value half differ only in which type argument they read, so they are one function.
	function parseMapColumnValue(func IrFunction, giid GenericInstanceId, position ElementIndex, columnNoun String) returns ValueId throws SourceParseError
		let columnType = self.mapColumnType(giid, position: position)

		// The SUBJECT names the RESOLVED type and its nominal identity for `parseHashTableColumnArg`'s reason:
		// a `named("UnaryOp")` value column printed as *"is an int"*, a sentence about a code pointer that
		// argues against itself, and a `Kind` column printed the same way about an enum.
		let declaredType = self.resolvedSlotType(columnType)
		let declared = maxonTypeTag(declaredType)
		return try self.parseHashTableColumnArg(func, declaredType: declaredType, columnSubject: "this `{String.from(MapBuiltinBaseName)}`'s {columnNoun} is {articledColumnTypeName(declared, identity: self.declaredColumnIdentity(declaredType))}")
	end 'parseMapColumnValue'

	// The declared type of map column `position` — a selector rather than a `position` threaded into the index,
	// because the index's own doors are named for the columns (`mapKeyType` / `mapValueType`) and a positional
	// door there would be a second way to ask. THE one place that knows which type argument is the key: whether
	// a column owns what it holds is derived from the type this hands back, never from the position again.
	function mapColumnType(giid GenericInstanceId, position ElementIndex) returns MaxonType
		return self.signatures.mapKeyType(giid) if position == HashTableKeyArgPosition else self.signatures.mapValueType(giid)
	end 'mapColumnType'

	// --- The `List` builtin generic: `create` / `append` / `prepend` / `get` / `first` / `removeFirst` / `count` ---

	// Emit `__list_create(elementDrop)` for instance `giid`, yielding the empty chain header. `head`/`tail`/
	// `count` are zeroed by `__mm_alloc`, so only the stamp is written; `element_drop@24` carries the element's
	// destructor (the SAME `columnDestroyValue` a `Set`'s key and a `Map`'s two columns are stamped from) so
	// the list drops what it owns at teardown.
	//
	// ⭐ **AN OPAQUE ELEMENT TAKES THE OTHER ROAD, AND THE BRANCH IS HERE FOR THE REASON `emitArrayCreateOp`'s
	// IS**: this is the ONE producer of a chain's `create`, so no door can reach the static stamp with a
	// `typeParameter` element and no door can miss the descriptor-reading form.
	function emitListCreateOp(giid GenericInstanceId, range SourceRange) returns ValueId throws SourceParseError
		match self.signatures.containerCreateRoute(giid) 'route'
			opaqueElement or
			composedFromTheCaller then return self.emitOpaqueChainCreateOp(giid, range: range)
			staticStamp then return try self.emitStampedChainCreateOp(giid, range: range)
		end 'route'
	end 'emitListCreateOp'

	function emitStampedChainCreateOp(giid GenericInstanceId, range SourceRange) returns ValueId throws SourceParseError
		try self.requireColumnDropIsNameable(giid, range: range)
		let elementDrop = self.columnDestroyValue(self.signatures.containerElementType(giid), range: range)
		return self.emitRuntimeCall(ListCreateName, args: argsOf(elementDrop), resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
	end 'emitStampedChainCreateOp'

	// ⭐ **CREATE AN OPAQUE-`T` CHAIN inside a shared generic body** — `EChain.create()` where
	// `EChain = __ManagedList with typeParameter(token)`, the shape `stdlib/List.maxon`'s sole field is. It is
	// `emitArrayCreateOp`'s `opaqueElement` route with the stride omitted too: a
	// chain's node holds ONE MACHINE WORD whatever the element is (`ListRuntime.maxon`'s `value@16`), so unlike
	// an array there is no stride to read and the descriptor read is the create's ONLY argument. The parser
	// therefore emits a ZERO-argument `__list_create`; `LowerMaxonToStd.appendOpaqueContainerCreate` supplies
	// the `destroyFunc@40` read, so the tier that owns the descriptor's ValueId is the tier that reads it.
	//
	// ⭐ **A TRIVIAL INSTANTIATION READS 0 OUT OF THE SAME SLOT AND ITS TEARDOWN WALK IS SKIPPED**, which is
	// what makes ONE compiled body serve a `String` bag and an `int` bag in one program — the case
	// `specs/managed-list-opaque-element.md` exists for. The alternative is a
	// statically stamped 0 (`columnDestroyValue`'s trivial arm), which is the same instruction for both and
	// leaks the managed one.
	function emitOpaqueChainCreateOp(giid GenericInstanceId, range SourceRange) returns ValueId
		return self.emitRuntimeCall(ListCreateName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
	end 'emitOpaqueChainCreateOp'

	// ⭐ **THE CHAIN ELEMENT-TYPE GATE.** A node's `value@16` is ONE MACHINE WORD, so the positive rule is
	// `ProgramSignatures.slotTypeFitsOneWord` (see its header for what that buys and what it cost to have two
	// of them). It serves both chain surfaces — `__ManagedList` is the same record with the same one-word value
	// slot — so the name it blames is read off the instance rather than spelled twice.
	//
	// ⭐⭐ **AN OPAQUE `T` IS ADMITTED, AND IT IS ASKED FIRST BECAUSE IT IS A DIFFERENT QUESTION** — a
	// `T` slot is not a type that fails to fit a word, it is a slot whose destructor is not statically known.
	// Refusing it outright on the ground that *"a container inside a generic body has no element destructor
	// to stamp, so a managed instantiation would leak the elements it holds"* is a true sentence about a
	// **0 stamp**, which is what `columnDestroyValue` would produce, and not about the construct:
	// the destructor is in the enclosing instance's layout descriptor, whose `destroyFunc@40` the caller
	// already threads in, and `LowerMaxonToStd.appendOpaqueContainerCreate` reads it there at run time
	// exactly as an `Array with <type parameter>` has. A chain PUBLISHES no slots — it is empty at
	// birth and grows one node per insertion — so it needs none of the per-instantiation reasoning
	// `requireFixedArrayElementType` does at this same fork; the descriptor is the whole of the answer.
	//
	// ⚠ **`float` IS NOT WHAT THE LAST REFUSAL IS FOR, AND THAT WAS MEASURED RATHER THAN ASSUMED.** A float
	// slot would arrive in the XMM file where every container entry is declared `i64`, but it never reaches
	// here: `typealias FList = List with F` is already **E2062 on the type ARGUMENT** (a type parameter is an
	// opaque general-purpose slot and a float has no way through it). What the last refusal is for is
	// therefore any slot type neither managed nor word-shaped that a future type kind might introduce:
	// a clean E2015 rather than a wrong stride.
	//
	// MEASURED to pass through it as a `List` ELEMENT, each printing and tearing down clean: `bool`, a ranged
	// `Byte`, a declared enum, a function alias, a nested `List`, a nested `Array`, `String`, and a struct
	// with a `String` field.
	//
	// ⚠⚠ **AND PASSING THIS GATE IS NOT THE WHOLE ADMISSION — `TypeRules.columnValueTagMatches` DECIDES WHAT
	// MAY BE WRITTEN.** That was measured on a `Map`'s VALUE column, which shared this rule while the
	// synthesized table existed (the chain is the sole asker now): `bool` was admitted
	// here and refused at the first `upsert`, and the arm that closes it is that predicate's.
	function requireListElementType(giid GenericInstanceId, tok Token) throws SourceParseError
		if self.signatures.containerElementIsOpaque(giid) 'opaqueElement'
			return
		end 'opaqueElement'

		let elementType = self.signatures.containerElementType(giid)

		if self.signatures.slotTypeFitsOneWord(elementType) 'fitsTheSlot'
			return
		end 'fitsTheSlot'

		throw SourceParseError.unsupported("`{String.from(self.signatures.genericInstanceBaseName(giid))}` holds one machine word per {ContainerElementColumnNoun}, so its {ContainerElementColumnNoun} must be a managed type or an integral one — a '{self.signatures.typeDisplayName(elementType)}' {ContainerElementColumnNoun} does not fit that slot", line: tok.line, column: tok.column)
	end 'requireListElementType'

	// ⭐⭐ **THERE IS NO SYNTHESIZED `List` SURFACE.** `stdlib/List.maxon` declares
	// `count`/`isEmpty`/`append`/`prepend`/`insert`/`get`/`first`/`last`/`removeFirst`/`removeLast`/
	// `remove`/`clear` and `clone`, so a `List` receiver takes the
	// ordinary declared-method path — the same one every other `stdlib/` type's members take, and the one
	// that makes the module's bodies the thing that answers.
	//
	// ⚠ **NONE OF THE OWNERSHIP DOORS A `List` USES HAS A `List` ARM, SO THERE IS NOTHING TO MIGRATE.**
	// The move-in (`parseContainerElementArg`), the borrow and the move-out
	// (`emitContainerElementAccessor`) are container doors; the corpus declaration reaches them
	// through the ordinary call machinery, which reads the same `var self` / consuming-parameter facts off
	// the declaration that raise E3207 for `stdlib/Array.maxon`'s members.

	// ⭐ **A NO-ARGUMENT CHAIN READER — `count()` and `isEmpty()`, ON EITHER SURFACE.** The arms ask the
	// same question of the same record, so the empty argument list and the call are spelled once; the
	// only thing that differs between them is the entry point and the tag its answer wears, so those are the
	// two arguments. `emitChainClear` below is the same consolidation for
	// the void member.
	function emitChainReader(list ValueId, callee ByteArray, resultTag ValueTypeTag, range SourceRange) returns ValueId throws SourceParseError
		try self.consumeEmptyArgList()
		return self.emitRuntimeCall(callee, args: argsOf(list), resultTag: resultTag, resultNameId: UnnamedTypeId, range: range)
	end 'emitChainReader'

	// ⭐ **A VOID CHAIN MEMBER TAKING ONE NODE HANDLE — `detach`, `reinsertFirst`, `reinsertLast`.** All
	// three are the same four steps in the same order: refuse a value-position call BEFORE the argument list
	// is consumed (`requireVoidMethodIsStatement`'s ⇒ rule), parse and type-check the handle, emit, and hand
	// the RECEIVER back as what the statement still denotes. Written once because a fourth such member
	// would otherwise be a fourth chance to put the void guard in the wrong place.
	//
	// ⚠ **THE RESULT TAG IS AN ARGUMENT AND NOT A CONSTANT `void`, because two of the three entries DO
	// return a value.** `__list_detach_node` shares `remove`'s graph and hands the element back for the
	// parser to discard; the reinsertions return nothing. Typing a value-returning entry `void` at the Maxon
	// tier is the mismatch `parseArraySet`'s tag note records as a wrong answer, and the SURFACE is kept void
	// by the guard rather than by the tag — `dispatchManagedListMethod`'s `insertAtAnEnd` makes the
	// same split.
	//
	// ⚠ **NONE OF THE THREE MARKS THE ARGUMENT'S BINDING, WHERE `remove` DOES AND MUST.** They change a
	// node's LINKS and leave `value@16` where it is, so the handle goes on answering `value()` afterwards —
	// see the `reinsertAtAnEnd` arm for the roster this makes unnecessary.
	function emitChainNodeMutator(func IrFunction, list ValueId, giid GenericInstanceId, callee ByteArray, resultTag ValueTypeTag, resultUsed bool, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
		let node = try self.parseManagedListNodeArg(func, giid: giid, subject: methodTok.value)
		_ = self.emitRuntimeCall(callee, args: twoArgs(list, second: node), resultTag: resultTag, resultNameId: UnnamedTypeId, range: range)

		return list
	end 'emitChainNodeMutator'

	// ⭐ **`clear()` ON EITHER CHAIN SURFACE** — the void-statement guard, the empty argument list, and the ONE
	// runtime entry, which is `__list_clear` for both because the two surfaces are one structure (that entry's
	// own header states it, and `__list_decref`'s last owner calls the same walk). The receiver is handed back
	// as what the statement still denotes, exactly as `emitArrayVoidCall` does.
	function emitChainClear(list ValueId, resultUsed bool, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
		try self.consumeEmptyArgList()
		_ = self.emitRuntimeCall(ListClearName, args: argsOf(list), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		return list
	end 'emitChainClear'

	// ⭐⭐ **DISPATCH A `__ManagedList` METHOD** — the node-handle surface over the chain
	// `stdlib/List.maxon` wraps (`SignatureIndex.ManagedListBuiltinBaseName`), so every emit below is
	// a `__list_*` entry and not one new runtime call.
	//
	// ⭐⭐ **THE HANDLE AN INSERTION HANDS BACK IS A SECOND OWNER OF THE NODE.** The nodes are
	// REFCOUNTED, so a handle may escape into a return, a field or a parameter — which
	// `stdlib/List.maxon` needs — and every method below drops the CHAIN's reference rather than
	// freeing, so nothing here can dangle one.
	function dispatchManagedListMethod(func IrFunction, list ValueId, resultUsed bool, immutableReceiverName immutable ByteArray, receiverOwner ParamPositionMask, receiverStorage ParamPositionMask) returns ValueId throws SourceParseError
		let methodIndex = self.pos
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.ofToken(methodTok)
		let giid = self.valueNameId(list)
		let mutates = managedListMethodMutatesReceiver(methodTok.value)

		// What `noteReceiverWrite` takes a storage mask FOR is E3207 and the immutable-global mark — which the
		// two insertions genuinely owe, since an insertion does write a `let` receiver's record.
		self.noteReceiverWrite(func, receiver: list, immutableReceiverName: immutableReceiverName, receiverOwner: receiverOwner, receiverStorage: receiverStorage, methodTok: methodTok, methodIndex: methodIndex, mutatesReceiver: mutates)

		if methodTok.value.equals(CountMethod) 'count'
			return try self.emitChainReader(list, callee: ListCountName, resultTag: ValueTypeTag.integer, range: range)
		end 'count'

		// The `List` surface's own `isEmpty`, on the other name for the same record — one entry, one reader.
		if methodTok.value.equals(IsEmptyMethod) 'isEmpty'
			return try self.emitChainReader(list, callee: ListIsEmptyName, resultTag: ValueTypeTag.boolean, range: range)
		end 'isEmpty'

		// The two insertions differ only in WHICH end the runtime links onto, so they share one arm — the
		// `List` dispatcher's argument, with the node kept rather than discarded.
		if methodTok.value.equals(ManagedListInsertFirstMethod) or methodTok.value.equals(ManagedListInsertLastMethod) 'insertAtAnEnd'
			let value = try self.parseContainerElementArg(func, giid: giid as GenericInstanceId, methodTok: methodTok)
			let callee = ListPrependName if methodTok.value.equals(ManagedListInsertFirstMethod) else ListAppendName

			// ⭐⭐ **A DISCARDED INSERTION MINTS NO HANDLE, AND THE PREDICATE IS AN ARRIVAL ROSTER
			// RATHER THAN THE `resultUsed` FLAG.** `stdlib/List.maxon`'s `append`/`prepend` discard the node
			// on every call, and a handle minted for them would cost an `__mm_incref` plus a
			// `__list_node_decref` that the statement's own drain cancels one instruction later — three
			// such pairs in `ownership/no-leak-returned-managed-list` alone, in a program with no node handle
			// in its source.
			if self.chainInsertionHandleIsRead(callee, resultUsed: resultUsed) 'handleIsRead'
				return self.emitManagedListNodeHandle(callee, args: twoArgs(list, second: value), nodeInstance: self.signatures.managedListNodeInstanceFor(giid as GenericInstanceId) as TypeNameId, provenance: NodeHandleProvenance.chain(list), range: range)
			end 'handleIsRead'

			// Nobody reads the node, so the call is typed as the `List` door types it — an `integer` the
			// statement throws away — and the RECEIVER comes back as what the statement still denotes
			// (`emitArrayVoidCall`'s answer).
			_ = self.emitRuntimeCall(callee, args: twoArgs(list, second: value), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
			return list
		end 'insertAtAnEnd'

		// ⭐ **`head()` / `tail()` — THE TWO THROWING CHAIN NAVIGATORS.** They hand back a handle to a node
		// that ALREADY EXISTS, so the `+1` the mint door states is owed is the incref that door emits and
		// not an allocation's — see `emitManagedListNodeHandle`'s ⭐ block on `callReturnRc1`.
		if methodTok.value.equals(ManagedListHeadMethod) or methodTok.value.equals(ManagedListTailMethod) 'nodeAtAnEnd'
			try self.consumeEmptyArgList()
			let callee = ListHeadCheckedName if methodTok.value.equals(ManagedListHeadMethod) else ListTailCheckedName
			let handle = self.emitManagedListNodeHandle(callee, args: argsOf(list), nodeInstance: self.signatures.managedListNodeInstanceFor(giid as GenericInstanceId) as TypeNameId, provenance: NodeHandleProvenance.chain(list), range: range)
			self.adaptBorrowedElement(handle, receiver: list)
			return handle
		end 'nodeAtAnEnd'

		// ⭐ **`insertAfter(target, value:)` / `insertBefore(target, value:)` — THE TWO INTERIOR INSERTIONS.**
		// One arm, because they differ in nothing this door can see: the same two arguments, the same
		// move-in, the same minted handle. Which side of `target` the node lands on is the runtime entry's
		// four offsets (`buildListInteriorInsert`).
		if methodTok.value.equals(ManagedListInsertAfterMethod) or methodTok.value.equals(ManagedListInsertBeforeMethod) 'insertBesideANode'
			let callee = ListInsertAfterName if methodTok.value.equals(ManagedListInsertAfterMethod) else ListInsertBeforeName
			return try self.parseManagedListInsertBeside(func, list: list, giid: giid as GenericInstanceId, callee: callee, methodTok: methodTok, range: range)
		end 'insertBesideANode'

		// ⭐ **`reinsertFirst(node)` / `reinsertLast(node)` — MOVE AN EXISTING NODE TO AN END.** Void, so
		// statement-position only, and the receiver comes back as what the statement denotes.
		//
		// ⚠ **THE HANDLE IS NOT MARKED AND NEEDS NO ROSTER, WHERE `remove`'s DOES.** A reinsertion changes
		// the node's LINKS and leaves `value@16` exactly where it is, so the argument's handle goes on
		// answering `value()`, `next()` and `prev()` afterwards — there is nothing for a later read to be
		// refused about. `detach` is unmarked for the same reason and states it; `remove` is the ONE member
		// on this surface that empties the slot.
		if methodTok.value.equals(ManagedListReinsertFirstMethod) or methodTok.value.equals(ManagedListReinsertLastMethod) 'reinsertAtAnEnd'
			let callee = ListReinsertFirstName if methodTok.value.equals(ManagedListReinsertFirstMethod) else ListReinsertLastName
			return try self.emitChainNodeMutator(func, list: list, giid: giid as GenericInstanceId, callee: callee, resultTag: ValueTypeTag.void, resultUsed: resultUsed, methodTok: methodTok, range: range)
		end 'reinsertAtAnEnd'

		if methodTok.value.equals(RemoveMethod) 'remove'
			let node = try self.parseManagedListNodeArg(func, giid: giid as GenericInstanceId, subject: methodTok.value)

			// ⭐⭐ **`remove` TAKES THE ELEMENT, SO THE ARGUMENT'S OWN HANDLE MAY NOT BE READ AGAIN — AND THIS
			// IS THE NARROW FACT THAT HOLDS EVEN THOUGH NOTHING ON THIS SURFACE FREES A NODE.** `remove` NULLS the node's
			// `value@16` when it moves the element out, so `n.value()` after `chain.remove(n)` reads an
			// emptied slot — MEASURED as **exit 139**, a segfault, on a `String` element. A trivial element merely
			// prints `0`, which is how it goes unnoticed.
			//
			// ⭐ **IT IS PER-BINDING, NOT PER-STORAGE.** Keyed on the storage, `ml.remove(a)` would also kill
			// a handle `b` on a node the removal cannot touch. This marks the ARGUMENT's binding and nothing
			// else, so siblings stay readable; canonical `core.remove` pins that.
			//
			// ⚠ **`detach` DELIBERATELY DOES NOT REACH THIS.** It leaves the element in the node, so its
			// handle goes on answering `value()` — which is what `core.detach` asserts.
			//
			// ⛔⛔ **AND THE MARK HAS TO LAND, OR THE CALL IS REFUSED — BECAUSE A MARK THAT MISSES IS SILENT.**
			// `setBindingPartiallyMoved` is keyed to the BINDING that owns the handle, so it is INERT on a
			// handle read out of a struct FIELD, an array element, or any other expression no live binding
			// owns — and every one of those is namable a second time, which is the whole difference from an
			// unnamed temporary. MEASURED at review: `chain.remove(k.node)` then `k.read()` over a `String`
			// ran to **exit 139**.
			// The escape is a mark filed against a name the value has since left, so it is closed at the door
			// rather than by widening the mark.
			//
			// ⚠ **THE ONE UNMARKABLE SPELLING THAT IS SAFE IS THIS CHAIN'S OWN INSERTION, HANDED IN INLINE** —
			// `ml.remove(ml.insertLast(x))`, where the handle exists only as this argument and no second
			// expression can name it. It is admitted by IDENTITY (`nodeHandleMintedFrom`, stamped by the one
			// mint door) and not by shape.
			//
			// ⛔⛔ **`pendingTempsContain` IS NOT THE TEST, BECAUSE IT ADMITS EVERY CALL RESULT — `k.held()`
			// INCLUDED, MEASURED AT EXIT 139.** A method handing back a
			// field's handle is an unnamed owned temporary too, so that predicate is strictly wider than the
			// sentence it defends — the same defect this refusal exists to close, one level up. ⚠ The
			// stamp also carries WHICH chain, so `a.remove(b.insertLast(x))` is refused here rather than left
			// to `__list_remove_node`'s cross-chain abort.
			let mintedOnThisChain = (try self.bodyState.nodeHandleMintedFrom.get(node) otherwise panic("dispatchManagedListMethod: v{node} has no node-handle mint slot — every SSA value must be minted through mintValue, which seeds the column")) == list

			if not self.hasLiveOwner(node) and not mintedOnThisChain 'unmarkableHandle'
				throw SourceParseError.unsupported("`{String.from(ManagedListBuiltinBaseName)}.{String.from(RemoveMethod)}` takes the element OUT of the node, so its handle must be one this statement can mark as moved — a name (`{String.from(RemoveMethod)}(n)`) or an insertion on this same chain, handed in inline. A handle arriving any other way — out of a field, an element, a call result, a merge — would go on answering `{String.from(ManagedListNodeValueMethod)}()` from the emptied slot with nothing left to refuse the read; bind it to a name first, or use `{String.from(ManagedListDetachMethod)}`, which leaves the element where it is", line: methodTok.line, column: methodTok.column)
			end 'unmarkableHandle'

			self.setBindingPartiallyMoved(node, value: true)

			// The element is MOVED OUT — the caller owns it, and a statement-position `remove` drops it at
			// the statement's end like every other unbound owned temporary. Emitted through the ONE element
			// accessor, so its ownership, its result type and its buffer-surface mark are the array's answers.
			return try self.emitContainerElementAccessor(ListRemoveNodeName, container: list, args: twoArgs(list, second: node), giid: giid as GenericInstanceId, reference: ContainerElementReference.movedOut, range: range)
		end 'remove'

		// ⭐ **`detach(node)` — THE MEMBER THE SECOND RULING UNLOCKED.** Void and statement-position, like
		// `clear`; the chain lets go of the node while the caller's handle keeps it, which is only meaningful
		// because a node is refcounted. The runtime hands back the element like its `remove` twin and it is
		// discarded here — see `buildListDetachNode`.
		if methodTok.value.equals(ManagedListDetachMethod) 'detach'
			return try self.emitChainNodeMutator(func, list: list, giid: giid as GenericInstanceId, callee: ListDetachNodeName, resultTag: ValueTypeTag.integer, resultUsed: resultUsed, methodTok: methodTok, range: range)
		end 'detach'

		if methodTok.value.equals(ClearMethod) 'clear'
			return try self.emitChainClear(list, resultUsed: resultUsed, methodTok: methodTok, range: range)
		end 'clear'

		throw SourceParseError.unsupported("`{String.from(ManagedListBuiltinBaseName)}` method '{String.from(methodTok.value)}' — the compiler provides {String.from(CreateMethod)}/{String.from(CountMethod)}/{String.from(IsEmptyMethod)}/{String.from(ManagedListInsertFirstMethod)}/{String.from(ManagedListInsertLastMethod)}/{String.from(ManagedListInsertAfterMethod)}/{String.from(ManagedListInsertBeforeMethod)}/{String.from(ManagedListReinsertFirstMethod)}/{String.from(ManagedListReinsertLastMethod)}/{String.from(ManagedListHeadMethod)}/{String.from(ManagedListTailMethod)}/{String.from(RemoveMethod)}/{String.from(ManagedListDetachMethod)}/{String.from(ClearMethod)}, and {String.from(ManagedListNodeValueMethod)}/{String.from(ManagedListNodeSetValueMethod)}/{String.from(ManagedListNodeNextMethod)}/{String.from(ManagedListNodePrevMethod)} on the node handle", line: methodTok.line, column: methodTok.column)
	end 'dispatchManagedListMethod'

	// ⭐⭐ **THE ONE PLACE A `__ManagedListNode` VALUE IS MINTED — AND IT MINTS AN OWNED SECOND OWNER OF THE
	// NODE.** ⚖ USER RULING 2026-08-17: nodes are REFCOUNTED,
	// and a handle is a reference like any other. So the result is enrolled as a sole-owned temp and drops at
	// scope exit through `genericInstanceBoxDropCallee` → `__list_node_decref`, which is what lets a handle
	// outlive the chain in a return, a field or a parameter — the three positions `stdlib/List.maxon` needs.
	//
	// ⭐ **THE INCREF GOES THROUGH `emitIncref` AND NOT THROUGH A SECOND SPELLING OF IT.** That door is where
	// *"after this line the allocation has two owners"* is recorded (`markValueCoOwnsHeap`) and where the
	// retain is kept off a block-form `try`'s handler edge (`emitOwnershipRuntimeCall`); a raw
	// `emitRuntimeCall(MmIncrefName, …)` here would be a sixth producer of `__mm_incref` that the door's own
	// roster does not name, which is the shape that comes to miss whatever the door gains next.
	//
	// ⭐ **EVERY HANDLE LEAVES HERE OWNING EXACTLY ONE REFERENCE, AND WHICH SIDE PAID FOR IT IS DECIDED
	// INSIDE** — see the block on the `if` below, which is where the rule lands and why it applies to
	// four of the eight entries and not to the other four. A mint that forgot its `+1` would be a
	// use-after-free rather than a leak, and one that paid it twice would leak the node forever.
	function emitManagedListNodeHandle(callee ByteArray, args ValueIdArray, nodeInstance TypeNameId, provenance NodeHandleProvenance, range SourceRange) returns ValueId
		let node = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.genericInstance, resultNameId: nodeInstance, range: range)

		// ⭐⭐ **WHICH SIDE TAKES THE HANDLE'S `+1`, AND IT IS DERIVED FROM WHETHER THE ENTRY CAN THROW
		// RATHER THAN CARRIED AS A SECOND FLAG — because for each kind there is only ONE side that can.**
		//
		//   • A NON-THROWING entry (the four insertions) hands back a node whose only reference is the
		//     CHAIN's — `emitListClaimsNode` takes none, the fresh `__mm_alloc`'s `+1` IS the chain's — and
		//     the same entries serve the `List` surface, which DISCARDS the node. So the entry cannot incref
		//     (that arrangement was built and measured at exit **101**; `emitListClaimsNode`'s ⚠ block has
		//     the numbers) and the `+1` belongs here, at the one door that knows a handle was kept.
		//   • A THROWING entry (the four navigators) hands back a node that already has owners, and this
		//     door structurally CANNOT pay for it: the incref would be emitted before the `try` fork, so it
		//     would run on the ERROR edge over a result that is not a node — and it would displace the call
		//     as the op `rewriteLastCallToTryCall` rewrites, MEASURED as **E3055 *"try requires a throwing
		//     function: this builtin call cannot fail"*** on `try list.head()`, a program that is exactly
		//     one. Those entries incref before ok-returning.
		//
		// ⚠ **`markValueCoOwnsHeap` STILL HAS TO RUN ON THE CALLEE-PAID PATH**, and it does — through
		// `trackOwnedTemp(coOwned)` below, which is the same bit `emitIncref` sets. The `+1` moving into the
		// runtime does not make the value any less co-owned: the chain holds one too.
		if not isThrowingListRuntimeCallee(callee) 'plusOneIsThisDoors'
			self.emitIncref(node, range: range)
		end 'plusOneIsThisDoors'

		self.trackOwnedTemp(node, exclusivity: OwnedHeapExclusivity.coOwned)

		// ⭐ **THE PROVENANCE STAMP `remove`'s ONE EXEMPTION IS KEYED TO** — see `nodeHandleMintedFrom`. It is
		// written HERE, at the only door that mints a handle, so the exemption cannot be widened by a caller.
		//
		// ⭐ **AN `unchained` MINT STAMPS THE HANDLE'S OWN VALUE, WHICH IS NOT A SENTINEL — IT IS THE SEED
		// `mintValue` ALREADY WROTE, RESTATED.** `remove`'s test compares the stamp against a CHAIN value in
		// scope, and no handle's own SSA id can be one, so *"minted from no chain"* is spelled as *"a value
		// that is not a chain"* by construction rather than by a reserved number this column would then have
		// to defend. See `NodeHandleProvenance` for which mints have no chain to name.
		let stamp = match provenance 'mintSource'
			chain(sourceList) gives sourceList
			unchained gives node
		end 'mintSource'

		try self.bodyState.nodeHandleMintedFrom.set(node, value: stamp) otherwise panic("emitManagedListNodeHandle: v{node} has no node-handle mint slot — every SSA value must be minted through mintValue, which seeds the column")

		return node
	end 'emitManagedListNodeHandle'

	// ⭐⭐ **DOES ANYTHING READ THE NODE AN END-INSERTION LINKED?** Three ways the answer is YES,
	// and `resultUsed` alone reports only the first — which is exactly the *"a check filed against a spelling
	// narrower than the fact it defends"* shape, so the roster is written out and
	// each row is closed by something checkable rather than by prose:
	//
	//   • **THE VALUE IS READ WHERE THE CALL STANDS** — `let n = ml.insertLast(x)`, an argument, a `return`.
	//     `resultUsed`, which is what that flag actually means.
	//   • **THE POSTFIX CHAIN CONTINUES** — `ml.insertLast(x).value()` as a STATEMENT, where `parsePostfix`
	//     forwards the LAST hop's `resultUsed` to every earlier hop and its own header says so outright
	//     (*"`resultUsed` describes the chain's LAST hop and the receiver-returning arms make the earlier
	//     hops' own use invisible to it"*). The next token is the `.` that door is about to consume, which is
	//     the same test asked one call earlier.
	//   • **THE CALL IS A `try` TARGET** — `parseTryTargetExpression` parses one `resultUsed: false` while the
	//     try's result IS read, and `requireVoidMethodIsStatement`'s header records the same hole. It is
	//     closed for these two members and ONLY for them: neither throws, so `parseTry`'s
	//     `requireThrowingTryTarget` refuses the spelling (E3055) before anything is emitted. Asked of the
	//     CALLEE here rather than asserted in a comment, so a chain member that ever gains a `throws` clause
	//     takes the minting branch by construction instead of quietly falling through this hole.
	//
	// ⚠ **THE COST OF A FALSE `true` IS ONE REFCOUNT PAIR; THE COST OF A FALSE `false` IS AN UNOWNED HANDLE.**
	// Every disjunct is therefore written to over-answer YES rather than risk the other direction.
	function chainInsertionHandleIsRead(callee ByteArray, resultUsed bool) returns bool
		return resultUsed or self.at(TokenKind.dot) or isThrowingListRuntimeCallee(callee)
	end 'chainInsertionHandleIsRead'

	// ⭐ **`( target , value: X )` — THE ARGUMENT PAIR THE TWO INTERIOR INSERTIONS TAKE**, and the emit, for
	// `parseArraySet`'s reason: the value is parsed and MOVED IN before the call is emitted, so the call is
	// the last op in the block and the arm has one place that knows the argument order.
	//
	// ⚠ **NOTHING HERE DESTROYS A REJECTED ELEMENT, WHERE `parseArraySet`'s CALLEES ALL MUST.** Those entries
	// can REFUSE after the move-in has already made them the owner (an out-of-range index), which is the leak
	// `emitDestroyRejectedElement` closes twice over. These two cannot: the only thing they refuse is a target
	// in another chain, and that is an ABORT (`RuntimeAbort.managedListNodeNotInThisChain`) taken BEFORE the
	// node is allocated — the process ends, so there is no continuation for a leak to be observed in.
	//
	// ⚠ The target is parsed FIRST and the value second, which is the source order and also the order the
	// runtime entry takes them.
	function parseManagedListInsertBeside(func IrFunction, list ValueId, giid GenericInstanceId, callee ByteArray, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let targetTok = self.current()
		let target = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.requireManagedListNodeArg(target, giid: giid, subject: methodTok.value, argTok: targetTok)
		try self.consumeArrayArgLabel(ArrayValueLabel, required: true)
		let valueStart = self.pos
		self.stateContainerElementLiteralTargets(giid, valueStart: valueStart)
		let raw = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let checked = try self.storedContainerElement(giid, value: raw, valueStart: valueStart, methodTok: methodTok)
		let value = try self.moveElementIntoContainer(checked, giid: giid, valueStart: valueStart, destination: self.statement.elementStoreDestination)
		try self.consume(TokenKind.rightParen)

		return self.emitManagedListNodeHandle(callee, args: threeArgs(list, second: target, third: value), nodeInstance: self.signatures.managedListNodeInstanceFor(giid) as TypeNameId, provenance: NodeHandleProvenance.chain(list), range: range)
	end 'parseManagedListInsertBeside'

	// `( node )` — the single node argument `remove`, `detach` and the two reinsertions each take.
	//
	// ⚠ **THE HANDLE IS NOT MOVED IN AND NOTHING IS POISONED, EVEN THOUGH IT IS OWNED.** `remove` unlinks the
	// node and drops the CHAIN's reference; the caller's own reference is untouched, which is what lets the
	// handle outlive its own removal and makes its later scope-exit drop correct — the node stays ALIVE, and a
	// second `remove` of it is a no-op (`ListRuntime.buildListUnlinkNode`'s `owner@32` gate).
	//
	// ⚠ **WHAT DOES END THE HANDLE'S USEFULNESS IS THE ELEMENT LEAVING IT**, and that is the caller's
	// business rather than this parse: `remove` empties `value@16`, so `dispatchManagedListMethod`'s `remove`
	// arm marks the argument's binding moved (E3102 on a re-read) and REFUSES a handle it cannot mark. The
	// other three leave the element where it is and mark nothing.
	function parseManagedListNodeArg(func IrFunction, giid GenericInstanceId, subject ByteArray) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let argTok = self.current()
		let node = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.consume(TokenKind.rightParen)
		try self.requireManagedListNodeArg(node, giid: giid, subject: subject, argTok: argTok)

		return node
	end 'parseManagedListNodeArg'

	// ⭐ **IS THIS ARGUMENT A HANDLE ON A NODE OF *THIS* LIST'S ELEMENT TYPE?** The type test is the instance
	// IDENTITY: `managedListNodeInstanceFor` derives the one node instance this list's handles carry, so a
	// handle from a list of another element type is refused by comparing gids rather than by unpacking either
	// type.
	//
	// ⚠ **`subject` IS THE MEMBER THE AUTHOR WROTE, NOT A FIXED `remove`.** A refusal naming a member the
	// program does not contain would be a wrong sentence, so the noun is the caller's to supply.
	// It is the SAME defect class as the roster refusals two doors up, one argument in.
	//
	// ⚠ It does NOT decide whether the node is in this CHAIN, which is a run-time fact no parse can hold:
	// `owner@32` answers that at the entry point, and a foreign node aborts there.
	function requireManagedListNodeArg(node ValueId, giid GenericInstanceId, subject ByteArray, argTok Token) throws SourceParseError
		if self.valueIsInstance(node, giid: self.signatures.managedListNodeInstanceFor(giid)) 'aNodeOfThisList'
			return
		end 'aNodeOfThisList'

		throw SourceParseError.unsupported("`{String.from(ManagedListBuiltinBaseName)}.{String.from(subject)}` takes a node handle of this list — a `{String.from(ManagedListNodeBuiltinBaseName)} with {self.signatures.arrayElementDisplayName(giid)}`, which `{String.from(ManagedListInsertFirstMethod)}`/`{String.from(ManagedListInsertLastMethod)}`/`{String.from(ManagedListHeadMethod)}`/`{String.from(ManagedListTailMethod)}` hand back", line: argTok.line, column: argTok.column)
	end 'requireManagedListNodeArg'

	// ⭐⭐ **THE NODE-HANDLE SURFACE — `value()`, `setValue(v)`, `next()`, `prev()`.** Four members, and the
	// split between them is exactly the split between reading a node's PAYLOAD and stepping its LINKS.
	//
	// ⭐⭐ **`value()` ON A CONCRETE MANAGED ELEMENT IS AN OWNED READ, NOT A BORROW, AND THAT IS WHAT
	// MAKES `setValue` REPRESENTABLE AT ALL.** The setter RELEASES the element the node held
	// (`__list_node_set_value`), so a borrow taken before it dangles the instant it runs — which is
	// `/specs/managed-list.md`'s own `node.set-value-old-survives`, a case that reads the old String
	// AFTER the replacement and expects it intact. So `value()` on a concrete managed element is an
	// inline load PLUS an `__mm_incref`, classified owned and released at the caller's last use. The
	// arithmetic is one line — insert ⇒ rc 1 · `let old = value()` ⇒ rc 2 · `setValue` ⇒ rc 1 (`old`
	// alone) · print ⇒ alive · scope exit ⇒ 0, freed once.
	//
	// ⚠ **IT IS A THREE-WAY SPLIT ON THE ELEMENT, NOT A BLANKET RULE.** A TRIVIAL element owns nothing
	// and never reaches the ownership arms at all (`emitContainerElementAccessor` returns from its
	// trivial arm). An OPAQUE element — a `T` inside a shared generic body — stays a BORROW
	// deliberately: `stdlib/List.maxon`'s `get`/`current` forward `return node.value()`, and the
	// reference such a body could take is `retainFunc@64`, which for a byte record is a DEEP CLONE
	// rather than an incref, so a "retain" there would hand back a different record from the one the
	// slot holds (`emitContainerElementAccessor`'s own ⚠ block on that). Only a CONCRETE MANAGED
	// element retains.
	function dispatchManagedListNodeMethod(func IrFunction, node ValueId, giid GenericInstanceId, resultUsed bool, immutableReceiverName immutable ByteArray, receiverOwner ParamPositionMask, receiverStorage ParamPositionMask) returns ValueId throws SourceParseError
		let methodIndex = self.pos
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.ofToken(methodTok)

		// ⚠ **`setValue` IS A WRITE THROUGH THE HANDLE, so a read-only one is refused (E3207) exactly as a
		// read-only chain's `insertLast` is** — which is why this dispatcher takes a receiver where it took
		// only a value before.
		self.noteReceiverWrite(func, receiver: node, immutableReceiverName: immutableReceiverName, receiverOwner: receiverOwner, receiverStorage: receiverStorage, methodTok: methodTok, methodIndex: methodIndex, mutatesReceiver: managedListNodeMethodMutatesReceiver(methodTok.value))

		if methodTok.value.equals(ManagedListNodeValueMethod) 'value'
			try self.consumeEmptyArgList()
			let reference = ContainerElementReference.retained if self.signatures.containerElementIsManaged(giid) else ContainerElementReference.borrowed
			let elementOpFloor = self.artifact.module.ops.count()
			let element = try self.emitContainerElementAccessor(ListNodeValueName, container: node, args: argsOf(node), giid: giid, reference: reference, range: range)
			self.adaptElementRead(element, receiver: node, opFloor: elementOpFloor)
			return element
		end 'value'

		// ⭐ **`next()` / `prev()` — THE TWO THROWING NODE NAVIGATORS**, one arm because the direction is the
		// runtime entry's offset and nothing here differs.
		//
		// ⭐ **THE MINT IS `unchained`, AND THAT IS AN ANSWER RATHER THAN A GAP.** This dispatcher holds a
		// NODE, not a chain, so there is no chain value in scope to stamp — and the arrival it produces,
		// `ml.remove(n.next())`, is precisely one `remove` must refuse: an unnamed handle no statement can
		// mark as moved. `NodeHandleProvenance.unchained` is that refusal arriving by construction.
		if methodTok.value.equals(ManagedListNodeNextMethod) or methodTok.value.equals(ManagedListNodePrevMethod) 'step'
			try self.consumeEmptyArgList()
			let callee = ListNodeNextCheckedName if methodTok.value.equals(ManagedListNodeNextMethod) else ListNodePrevCheckedName
			let handle = self.emitManagedListNodeHandle(callee, args: argsOf(node), nodeInstance: giid as TypeNameId, provenance: NodeHandleProvenance.unchained, range: range)
			self.adaptBorrowedElement(handle, receiver: node)
			return handle
		end 'step'

		// ⭐ **`setValue(v)` — VOID, so statement-position only, and the receiver comes back as what the
		// statement still denotes.** The value is MOVED IN through the SAME door an insertion uses, so a
		// borrowed literal is promoted, an owned temporary adopted and a live binding co-owned — one answer
		// to *"what does a container do with an element handed to it"*, and the runtime entry releases the
		// element it displaces so the node still holds exactly one reference afterwards.
		if methodTok.value.equals(ManagedListNodeSetValueMethod) 'setValue'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			let value = try self.parseContainerElementArg(func, giid: giid, methodTok: methodTok)
			_ = self.emitRuntimeCall(ListNodeSetValueName, args: twoArgs(node, second: value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
			return node
		end 'setValue'

		throw SourceParseError.unsupported("`{String.from(ManagedListNodeBuiltinBaseName)}` method '{String.from(methodTok.value)}' — the compiler provides {String.from(ManagedListNodeValueMethod)}/{String.from(ManagedListNodeSetValueMethod)}/{String.from(ManagedListNodeNextMethod)}/{String.from(ManagedListNodePrevMethod)}", line: methodTok.line, column: methodTok.column)
	end 'dispatchManagedListNodeMethod'

	// ⭐⭐ **A `__ManagedMemoryCursor` RECEIVER — ITS OWN DISPATCH, because a cursor is not a container.** It
	// holds no elements: what it answers is a POSITION and the element at one, so the members that make sense
	// on it (`current`/`index`/`advance`/`retreat`/`seek`/`peek`) and the members that make sense on the
	// storage it points into (`get`/`setLength`/`grow`) are disjoint sets on two receivers.
	//
	// ⚠ **THE ROSTER GATE IS ASKED FIRST**, as it is on every other surface that carries one: "does this
	// member exist?" is the question every other refusal about the call presupposes — see
	// `dispatchArrayMethod` for the two measured spellings that made the ORDER matter as much as the test.
	//
	// ⚠ **NO IMMUTABLE-RECEIVER RULE, AND THAT IS THE CORPUS'S SIGNATURE RATHER THAN A RELAXATION.**
	// `stdlib/Array.maxon`'s `ArrayIterator` declares `advance`/`retreat`/`seek` on a plain `self` and
	// binds the cursor with `let`, so a `let`-bound cursor must be navigable.
	//
	// A navigation writes the CURSOR's `position@8`, not the buffer. What COULD invalidate the cursor is a
	// write to the SOURCE, and the cursor is protected there by its retain: the record cannot be freed under
	// it, and a position that the source has since shortened past is caught at the next navigation by the
	// LIVE `length` read (`emitCursorPositionOutOfRange`) rather than trusted from a snapshot.
	function dispatchCursorMethod(func IrFunction, cursor ValueId, giid GenericInstanceId, resultUsed bool) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.ofToken(methodTok)
		try self.requireCursorMemberIsNotRawSurface(methodTok)
		let roster = try self.requireSurfaceMember(MemberSurface.cursor, typeName: ManagedMemoryCursorBuiltinBaseName, methodTok: methodTok)

		// ⭐ **THE TWO INFALLIBLE READS.** `current()` yields the ELEMENT and goes through
		// `emitContainerElementAccessor` — the compiler-emitted element-read door, one of the two the language
		// now has (see its ⛔⛔ header for the corpus half) — as a BORROW:
		// the buffer still owns what is in the slot, so a `String` element handed back here is neither cloned
		// nor released. `index()` yields a plain integer and is emitted as one.
		if methodTok.value.equals(CursorCurrentMethod) 'current'
			try self.consumeEmptyArgList()
			let site = self.emitStringLiteral(panicMessageLinePrefix(self.job.path, line: methodTok.line), range: range)
			let elementOpFloor = self.artifact.module.ops.count()
			let element = try self.emitContainerElementAccessor(ManagedCursorCurrentName, container: cursor, args: twoArgs(cursor, second: site), giid: giid, reference: ContainerElementReference.borrowed, range: range)
			self.adaptElementRead(element, receiver: cursor, opFloor: elementOpFloor)
			return element
		end 'current'

		if methodTok.value.equals(CursorIndexMethod) 'index'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(ManagedCursorIndexName, args: argsOf(cursor), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'index'

		// ⭐ **THE THREE VOID NAVIGATORS, ONE ARM.** They differ only in the callee and in whether a target is
		// written, which is the same folding `dispatchArrayMethod`'s shift arm does and for the same reason:
		// two argument protocols where there is one would be the twin these rosters exist to prevent.
		if methodTok.value.equals(CursorAdvanceMethod) or methodTok.value.equals(CursorRetreatMethod) 'step'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			try self.consumeEmptyArgList()
			let stepCallee = ManagedCursorAdvanceName if methodTok.value.equals(CursorAdvanceMethod) else ManagedCursorRetreatName
			return self.emitRuntimeCall(stepCallee, args: argsOf(cursor), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'step'

		if methodTok.value.equals(CursorSeekMethod) 'seek'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			let target = try self.parseOneBuiltinIntegerArgList(func, paramName: ManagedMemoryIndexParamName, methodTok: methodTok)
			return self.emitRuntimeCall(ManagedCursorSeekName, args: twoArgs(cursor, second: target), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'seek'

		// `peek(ahead)` reads WITHOUT moving, so it is the one member that both takes an argument and yields an
		// element — the accessor door again, and a BORROW again, for `current`'s reason.
		if methodTok.value.equals(CursorPeekMethod) 'peek'
			let ahead = try self.parseOneBuiltinIntegerArgList(func, paramName: CursorPeekParamName, methodTok: methodTok)
			let elementOpFloor = self.artifact.module.ops.count()
			let element = try self.emitContainerElementAccessor(ManagedCursorPeekName, container: cursor, args: twoArgs(cursor, second: ahead), giid: giid, reference: ContainerElementReference.borrowed, range: range)
			self.adaptElementRead(element, receiver: cursor, opFloor: elementOpFloor)
			return element
		end 'peek'

		// ⚠ Unreachable while the roster and these arms agree — `dispatchArrayMethod`'s drift panic, for its
		// reason: a roster member with no arm would otherwise be handed the very refusal that says it is
		// provided.
		let drift = rosterDriftMessage("dispatchCursorMethod", member: methodTok.value, roster: roster, rosterFuncs: "`cursorSurfaceMemberNames`")
		panic("{drift}")
	end 'dispatchCursorMethod'

	// ⭐⭐ **`List from [a, b, c]` — `List.create()` PLUS ONE `List.append` PER MEMBER.** The cursor
	// sits on the `List` identifier. It is `parseSetMemberList`'s shape one container over. A source
	// that is not a bracketed list is a call of `List.init` (`parseContainerFromArray`).
	//
	// ⚠ **A LITERAL BUILDS NO INTERMEDIATE `Array`.** Reading the members straight needs no runtime
	// entry that CONSUMES a source buffer one machine word per slot, so it needs neither the
	// packed-element refusal such an entry requires (a `Byte` array strides 1, not 8) nor the
	// intermediate record.
	//
	// ⭐ **THE FIRST MEMBER FIXES THE ELEMENT TYPE AND THEREFORE THE INSTANCE**, exactly as the first element of
	// a `[…]` fixes an array's — through `literalColumnTypeFor`, which is the SAME door
	// `arrayLiteralInstanceFor` puts the same question to, so the element types this construction admits
	// are those an array literal admits. Every later member is held to that type by the ordinary argument check on
	// the declared `List.append(value Element)`, which is also what decides the MOVE: the element is the list's
	// from there, and a second parse-time move would be the leak `emitContainerLiteralElement`'s note measures.
	function parseListFromConstruction(func IrFunction) returns ValueId throws SourceParseError
		let listTok = try self.consumeConstructionHead()

		if not self.at(TokenKind.leftBracket) 'notArrayLiteral'
			return try self.parseContainerFromArray(func, headTok: listTok, container: FromHeadContainer.list)
		end 'notArrayLiteral'

		return try self.parseListMemberList(func, listTok: listTok)
	end 'parseListFromConstruction'

	// ⭐ **`List from [m0, m1, …]` ONTO THE DECLARED `List`** — the cursor sits on the `[`. Split out from the
	// head parse for `parseSetMemberList`'s reason: the head decides WHICH construction this is and the body
	// decides what it builds.
	function parseListMemberList(func IrFunction, listTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(listTok)
		try self.consume(TokenKind.leftBracket)

		let statedByAlias = self.namesContainerInstanceAlias(listTok.value, container: FromHeadContainer.list)

		// An EMPTY literal builds nothing, whether or not the head states the element type: an empty list is its
		// alias's `create()`.
		if self.at(TokenKind.rightBracket) 'noMembers'
			throw SourceParseError.unsupported(emptyListFromMessage(listTok.value, statedByAlias: statedByAlias), line: listTok.line, column: listTok.column)
		end 'noMembers'

		let firstTok = self.current()
		let first = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if self.valueIsDeferred(first) 'aDeferredFirstMember'
			return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
		end 'aDeferredFirstMember'

		let giid = try self.memberListInstance(listTok, container: FromHeadContainer.list, statedByAlias: statedByAlias, first: first, firstTok: firstTok, literalKind: ListLiteralSubject, columnNoun: ContainerElementColumnNoun)
		let list = try self.emitContainerLiteralCreate(ListBuiltinBaseName, giid: giid, anchor: listTok, range: range)
		try self.emitContainerLiteralElement(ListBuiltinBaseName, method: AppendMethod, container: list, value: first, anchor: listTok, range: range)
		var signs = try self.foldColumnSign(ColumnSigns.unseen, value: first, anchor: firstTok)

		while try self.atAnotherLiteralEntry() 'moreMembers'
			let memberTok = self.current()
			let member = try self.parseExpression(func, block: self.bodyState.currentBlock)

			if self.valueIsDeferred(member) 'aDeferredMember'
				return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
			end 'aDeferredMember'

			signs = try self.foldColumnSign(signs, value: member, anchor: memberTok)

			try self.emitContainerLiteralElement(ListBuiltinBaseName, method: AppendMethod, container: list, value: member, anchor: listTok, range: range)
		end 'moreMembers'

		try self.consume(TokenKind.rightBracket)
		return list
	end 'parseListMemberList'

	// The instance a `Set` or `List from […]` literal builds: the one its alias head names, or — under
	// the bare base name — the one its FIRST member fixes, through `literalColumnTypeFor`, the door
	// `arrayLiteralInstanceFor` asks.
	function memberListInstance(headTok Token, container FromHeadContainer, statedByAlias bool, first ValueId, firstTok Token, literalKind String, columnNoun String) returns GenericInstanceId throws SourceParseError
		if statedByAlias 'statedByTheAlias'
			return self.signatures.genericAliasInstanceFrom(headTok.value, readerFilePath: self.job.path)
		end 'statedByTheAlias'

		return self.inferredContainerInstance(container, element: try self.literalColumnTypeFor(first, literalKind: literalKind, columnNoun: columnNoun, valueTok: firstTok), head: headTok)
	end 'memberListInstance'

	// ⚠ **A CONTAINER JOINS THE MEMBER-BY-MEMBER DOOR BY NAMING ITS BASE** — `List` is
	// `emitContainerLiteralCreate` and `emitContainerLiteralElement` with `ListBuiltinBaseName` — not by growing a
	// third and fourth copy of the ownership rule, which is those two functions' own headers' point.

	// ==========================================================================================
	// The `FixedArray` builtin container — a FIXED-SIZE array (see `SignatureIndex.FixedArrayBuiltinBaseName`).
	// ==========================================================================================

	// ⭐ **WHAT A FIXED ARRAY MAY HOLD.** Its slot is an inline word of the element's own stride, so any element the
	// managed-memory runtime already strides fits — an integer of any declared range, a `bool`, a `float`, or a
	// MANAGED element, whose slot is a refcounted pointer and whose destructor `emitStampedArrayCreateOp` stamps
	// into the record. Any other element is E2015. An element whose zero is no value (a managed type, a ranged
	// alias that excludes 0, an enum whose raw values include no 0) is refused a plain `create()` for the
	// zeroing itself, by `requireZeroIsAnElement` (E3106); `create(value:)` starts one.
	//
	// ⭐⭐ **AN OPAQUE `T` IS ADMITTED, AND WHAT IT IS JUDGED BY IS THE INSTANTIATION SET.** *"A fixed array
	// inside a generic body has no statically known element stride to size its storage with"* is **false**:
	// a fixed array's storage is the same fused managed
	// record an array's is, held behind ONE 8-byte field slot, and an opaque `T`'s stride is the one its
	// instantiation's layout descriptor names (`elementStride@72`), which the body's create reads at run
	// time.
	// The SIZE is not the problem either — `FixedArray with 4 Element` states its 4 in the source, and the
	// substitution carries it into `FixedArray with 4 Int` through the intern key (`substituteInstanceArgsThrough`
	// carries `shape` explicitly, for exactly this).
	//
	// ⛔ **WHAT IS GENUINELY UNSOUND IS ONE INSTANTIATION AT A TIME, AND IT IS THE `create()` THAT PUBLISHES
	// SLOTS — NOT THE STRIDE.** `emitSizedContainerRecord` grows the record to N by ZEROING it, so all N slots are
	// readable by the type's own contract; a trivial element's zero IS a value, and a managed element's is a
	// NULL. A type parameter can be instantiated at a managed type, so a plain `create()` over one is judged
	// off the INSTANTIATION SET (`requireEveryInstantiationHasAZero`, asked by `requireSizedContainerElementType`
	// after this function) rather than here.
	function requireFixedArrayElementType(giid GenericInstanceId, tok Token) throws SourceParseError
		if self.signatures.containerElementIsOpaque(giid) or self.signatures.containerElementIsManaged(giid) 'anyInstantiationOrManaged'
			return
		end 'anyInstantiationOrManaged'

		let tag = maxonTypeTag(self.signatures.containerElementType(giid))

		if tagIsIntegral(tag) or tag == ValueTypeTag.boolean or tagIsFloat(tag) 'inlineScalar'
			return
		end 'inlineScalar'

		throw SourceParseError.unsupported(self.fixedArrayElementRefusal(giid), line: tok.line, column: tok.column)
	end 'requireFixedArrayElementType'

	// The wording of "a fixed array cannot hold that". It names the element as the SOURCE spells it
	// (`arrayElementDisplayName`) — a declared alias, a struct, an instance, or the primitive's own keyword.
	//
	// ⚠ **IT DOES NOT PRINT THE TAG.** `typeTagName(named)` is the word `int`, so a declared alias would read
	// back as *"'Alias' (int)"* — a sentence refusing a type while calling it something it is not.
	function fixedArrayElementRefusal(giid GenericInstanceId) returns String
		return "`{String.from(FixedArrayBuiltinBaseName)}` cannot hold a '{self.signatures.arrayElementDisplayName(giid)}' element — a fixed array's element is an integer, a bool, a float, or a managed value (a String, a record, an array or a union)"
	end 'fixedArrayElementRefusal'

	// ⚠⚠ **`stdlib/FixedArray.maxon`'s `create()` IS THE FIXED ARRAY CREATE.** Its body is `Self{}`, which
	// `emitSizedContainerRecord` builds already published at `countof(Self)` — *"zero-initialized, N elements"*.
	// `countof(Self)` is what makes that possible: the answer IS the size, the size is at the CALL, and a
	// `static … returns Self` reads it out of the hidden slot every call site fills in from the instance it builds.

	// ⚠ **`FixedArray`'S MUTATION ANSWERS ARE THE DECLARATION'S.** `stdlib/FixedArray.maxon`'s `set` writes through `self`
	// like any other declared method, so a `let` receiver is refused (E3207) off the declaration's own write
	// mask rather than off a receiver mask this door supplies.

	// Is the cursor on a `FixedArray from` construction — the bare `FixedArray` identifier or a
	// `FixedArray` instance alias, immediately followed by `from`?
	// `atContainerFromConstruction(FromHeadContainer.fixedArray)` answers it, read by BOTH the
	// declaration sweep (which pre-interns the instances a bare head can name) and `parsePrimary`'s
	// construction arm. The sweep answers no for every alias; an alias's instance was interned by its
	// declaration.

	// ⭐⭐ **`FixedArray from [a, b, c]` — AND IT EMITS NOT ONE RUNTIME OP OF ITS OWN.** The source array literal
	// already built exactly the record a fixed array is (`emitArrayCreateOp` + the pushes), so the construction is
	// the array literal RETYPED: `FixedArray with 3 <elem>` names the same 48 bytes `Array with <elem>` does, and
	// its drop callee is the same `__managed_decref` the literal's owned temp was already registered with. A
	// `__vec_from` would have been a copy of a record into an identical record.
	//
	// ⭐ **THE SIZE COMES FROM THE TOKENS, NOT FROM THE RECORD.** It is part of the TYPE, so it must be known
	// at parse time — `length@8` is a runtime fact — and the literal's element COUNT is exactly what the
	// source wrote between its brackets (`arrayLiteralElementCountAt`, the same counter the sweep pre-interns
	// with, so the instance the parser asks for is the instance the sweep interned).
	//
	// ⭐ **THE GATE IS ASKED OF THE SOURCE ARRAY'S INSTANCE, WHICH IS NOT A STAND-IN — IT IS THE SAME
	// QUESTION.** `Array with T` and `FixedArray with N T` share their element exactly, and every door
	// `requireFixedArrayElementType` opens (`containerElementIsOpaque`, `containerElementIsManaged`,
	// `containerElementType`, `arrayElementDisplayName`) reads only that element. So the fixed array's admissibility
	// is fully decided by the array the literal already built, and no fixed array instance need exist to decide it.
	function parseFixedArrayFromConstruction(func IrFunction) returns ValueId throws SourceParseError
		let headStart = self.pos
		let vecTok = try self.consumeConstructionHead()

		if not self.at(TokenKind.leftBracket) 'notArrayLiteral'
			let srcTok = self.current()
			throw SourceParseError.unsupported("`{String.from(FixedArrayBuiltinBaseName)} from` requires an array literal `[…]` — a fixed array's SIZE is part of its type, and only a literal states it in the source", line: srcTok.line, column: srcTok.column)
		end 'notArrayLiteral'

		if self.namesContainerInstanceAlias(vecTok.value, container: FromHeadContainer.fixedArray) 'statedByTheAlias'
			return try self.parseAliasedFixedArrayLiteral(func, vecTok: vecTok, headStart: headStart)
		end 'statedByTheAlias'

		// The literal is parsed FIRST so its own refusals — an empty `[]`, an element of another type, an element type
		// no literal admits — are reported by the reader that owns those sentences, before this arm asks a
		// question about an element the program does not have.
		let openIndex = self.pos
		self.imageTheLetInitializerAt(headStart, literal: openIndex)
		let arr = try self.parseArrayLiteral(func, element: ArrayLiteralElementSource.inferred)
		let arrGiid = self.valueNameId(arr)
		try self.requireFixedArrayElementType(arrGiid as GenericInstanceId, tok: vecTok)

		let size = try self.arrayLiteralElementCountAt(openIndex, anchor: vecTok)
		let giid = self.signatures.fixedArrayInstanceForElement(self.signatures.containerElementType(arrGiid as GenericInstanceId), size: size)

		// The retype is the WHOLE construction: same record, same bytes, same owner. `arr` is already this
		// statement's tracked owned temporary (`finishArrayLiteral`), and both instances drop through
		// `__managed_decref` (`genericInstanceBoxDropCallee`), so the value's registered ownership stays true of it.
		self.retypeValue(arr, valueType: MaxonType.genericInstance(giid))
		return arr
	end 'parseFixedArrayFromConstruction'

	// ⭐ **`Vec3 from [1, 2, 3]` — THE ALIAS STATES THE ELEMENT AND THE SIZE, SO THE LITERAL IS BUILT
	// AT THEM.** The bare form's retype, over a literal built at the alias's element rather than one
	// the first element inferred: a `FixedArray with 3 Reading` element strides the alias's slot, and
	// a record built at a bare `int`'s stride could not be retyped into it. The `Array` instance at
	// that element is interned before any parse
	// (`ProgramSignatures.internAliasedFixedArrayLiteralArrays`), so this read mints nothing. A
	// runtime-sized alias states no size: the literal's written element count gives the instance,
	// which the parse mints.
	function tokensWriteAConstantLiteral(first ElementIndex, pastEnd ElementIndex) returns bool
		var afterCast = false

		for at in first upto pastEnd 'eachToken'
			let kind = self.kindAt(at)

			if afterCast 'theCastType'
				if kind != TokenKind.identifier 'notATypeName'
					return false
				end 'notATypeName'

				afterCast = false
				continue
			end 'theCastType'

			if kind == TokenKind.as 'aCast'
				afterCast = true
				continue
			end 'aCast'

			if not self.tokenWritesAConstant(kind) 'notConstant'
				return false
			end 'notConstant'
		end 'eachToken'

		return not afterCast
	end 'tokensWriteAConstantLiteral'

	function tokenWritesAConstant(kind TokenKind) returns bool
		return kind == TokenKind.leftBracket or kind == TokenKind.rightBracket or kind == TokenKind.colon or kind == TokenKind.comma or kind == TokenKind.minus or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.charLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.true or kind == TokenKind.false
	end 'tokenWritesAConstant'

	function imageTheLetInitializerAt(headStart ElementIndex, literal ElementIndex)
		if headStart == self.bodyState.imagedLetInitializerStart 'theWholeInitializer'
			self.bodyState.imagedLetInitializerStart = literal
		end 'theWholeInitializer'
	end 'imageTheLetInitializerAt'

	function parseAliasedFixedArrayLiteral(func IrFunction, vecTok Token, headStart ElementIndex) returns ValueId throws SourceParseError
		let giid = self.signatures.genericAliasInstanceFrom(vecTok.value, readerFilePath: self.job.path)
		try self.requireFixedArrayElementType(giid, tok: vecTok)

		let arrayGiid = self.signatures.builtinInstanceForElement(self.signatures.arrayRecordBaseName(), element: self.signatures.containerElementType(giid))
		let openIndex = self.pos
		self.imageTheLetInitializerAt(headStart, literal: openIndex)
		let arr = try self.parseArrayLiteral(func, element: ArrayLiteralElementSource.stated(arrayGiid))

		let written = try self.arrayLiteralElementCountAt(openIndex, anchor: vecTok)
		var literalInstance = giid

		match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: giid as TypeNameId) 'declaredSize'
			stated(size) then try self.requireLiteralWritesTheStatedSize(written, size: size, vecTok: vecTok)
			inTheRecord then literalInstance = self.signatures.fixedArrayInstanceForElement(self.signatures.containerElementType(giid), size: written)
			callerSlot then throw SourceParseError.unsupported("`{String.from(vecTok.value)} from […]` writes {written} elements, and `{String.from(vecTok.value)}` states no size — a fixed array's size is part of its type", line: vecTok.line, column: vecTok.column)
		end 'declaredSize'

		self.retypeValue(arr, valueType: MaxonType.genericInstance(literalInstance))
		return arr
	end 'parseAliasedFixedArrayLiteral'

	function requireLiteralWritesTheStatedSize(written FixedElementCount, size FixedElementCount, vecTok Token) throws SourceParseError
		if written != size 'wrongElementCount'
			throw SourceParseError.unsupported("`{String.from(vecTok.value)} from […]` writes {written} elements, and `{String.from(vecTok.value)}` holds {size} — a fixed array's size is part of its type", line: vecTok.line, column: vecTok.column)
		end 'wrongElementCount'
	end 'requireLiteralWritesTheStatedSize'

	// ⭐ **HOW MANY ELEMENTS THE ARRAY LITERAL AT `openIndex` WRITES** — the top-level commas between
	// its brackets, plus one. Read from TOKENS because both of its callers need the answer before any
	// expression is parsed: the declaration sweep (which has no parser state at all) and the
	// construction above (which must know the instance before it can retype the value into it), and
	// the two must agree exactly so the sweep interns the instance the construction asks for.
	//
	// Nesting is tracked over the three bracket kinds a literal element can open, so `[f(1, 2), g(3)]` counts
	// TWO and `[[1, 2], [3, 4]]` counts two as well.
	//
	// ⚠ **AN EMPTY `[]` IS REFUSED RATHER THAN COUNTED AS ONE (review finding 6).** "Commas plus one" is only
	// true of a literal that has an element, and `[]` has none — `parseArrayLiteral` refuses it outright. Left
	// answering 1, this counter told the declaration SWEEP to intern three `FixedArray with 1 …` instances for a
	// literal the very next line rejects: registry rows minted on behalf of a program that cannot compile.
	function arrayLiteralElementCountAt(openIndex ElementIndex, anchor Token) returns FixedElementCount throws SourceParseError
		var depth = 0 as NestingDepth
		var commas = 0 as LiteralCommaCount
		var sawElement = false
		var i = openIndex

		while i < self.tokens.count() 'scan'
			let kind = self.kindAt(i)

			if tokenKindOpensABracket(kind) 'opens'
				depth = depth + 1
			end 'opens'

			if tokenKindClosesABracket(kind) 'closes'
				depth = depth - 1

				if depth == 0 'closesTheLiteral'
					if not sawElement 'emptyLiteral'
						throw SourceParseError.unsupported("`{String.from(FixedArrayBuiltinBaseName)} from []` — an empty array literal states neither the fixed array's element type nor its size, and both are part of the type", line: anchor.line, column: anchor.column)
					end 'emptyLiteral'

					return (commas + 1) as FixedElementCount
				end 'closesTheLiteral'
			end 'closes'

			if kind == TokenKind.comma and depth == 1 'topLevelSeparator'
				commas = commas + 1
			end 'topLevelSeparator'

			// Anything between the literal's own `[` and its `]` is an element token. Keyed on the
			// OPENER'S INDEX rather than on the bracket kind, so a nested `[` still counts as content.
			if i != openIndex 'elementToken'
				sawElement = true
			end 'elementToken'

			i = i + 1
		end 'scan'

		// The literal is unterminated. `parseArrayLiteral` would report it against the token it actually stops
		// at; this counter runs FIRST, so it says the same thing here rather than answering a count for a
		// literal that has no closing bracket.
		throw SourceParseError.unsupported("`{String.from(FixedArrayBuiltinBaseName)} from […]` — the array literal has no closing `]`", line: anchor.line, column: anchor.column)
	end 'arrayLiteralElementCountAt'

	function immutableReceiverNameOf(binding VarInfo, baseTok Token) returns immutable ByteArray
		if binding.isMutable() or binding.isParameter 'rebindable'
			return EmptySourceText
		end 'rebindable'

		return baseTok.value
	end 'immutableReceiverNameOf'

	// ⭐ **DISPATCH AN INTERFACE METHOD ON A CONSTRAINED TYPE-PARAMETER VALUE.** `receiver` is a
	// `typeParameter`-tagged value (`self.item`, a `T` field read) and the cursor sits on the method name. The concrete type is UNKNOWN in the shared body, so it dispatches through the runtime WITNESS:
	// the enclosing type's `where` constraint whose interface declares this method supplies the witness, and the
	// method's decl-order slot in that interface is the table index. Emits `MaxonOp.witnessDispatch`, which
	// `lowerMaxonToStd` turns into the fused `StdOp.witnessCall`. The receiver is BORROWED (arg 0); its user
	// arguments (none for `digest()`) follow it in `args`.
	//
	// ⭐ **ITS ARGUMENT LIST IS PARSED AND SLOTTED BY THE SAME DOORS EVERY OTHER CALL USES.** A bare comma
	// loop of `parseValueExpression` here would be a third, unwritten spelling of "parse an argument list",
	// reading no `name:` label, checking no arity and performing no label→position slotting — so the same
	// method would obey OPPOSITE rules depending on how it was reached: `add(1, 2)` E2053 on the concrete
	// receiver and accepted here, `add(1, b: 2)` accepted there and `E2004: Undefined variable 'b'` here.
	// The arity check is not cosmetic either — an under-supplied dispatch reads an UNINITIALISED REGISTER as
	// its missing actual and returns it (exit 1073754132 from a clean compile; with a ranged return type, a
	// spurious `Range check failed` panic on a correct program). `parseCallArgs` + `slotCallArgs` are the
	// doors, and there is no second spelling.
	function dispatchWitnessMethod(func IrFunction, receiver ValueId, resultUsed bool) returns ValueId throws SourceParseError
		let methodIndex = self.pos
		let methodTok = try self.consume(TokenKind.identifier)

		// ⭐ **THE CANDIDATES ARE FOUND BEFORE THE ARGUMENTS AND SELECTED AFTER THEM.** "Do the
		// constraints provide this name at all?" is answerable without reading a single argument, so it is
		// still asked first and still reports before an argument expression can raise anything of its own.
		// "Which of them did you mean?"
		// cannot be answered until the argument COUNT is known, so it waits.
		let candidates = try self.requireWitnessDispatchCandidates(receiver, methodTok: methodTok)

		try self.consume(TokenKind.leftParen)

		// FRESH columns holding the USER's arguments only — the borrowed receiver is prepended after
		// slotting, not before it. `parseCallArgs` counts arguments from 0 against the SOURCE, so the
		// receiver must not be in the array or the user's first argument would be judged as its second.
		let userArgs = ValueIdArray.create(0)
		let argLabels = NameRoster.create(0)
		let argRanges = SourceRangeArray.create(0)

		// `argImmutableNames` blames a binding for E3207 (an immutable argument at a MUTATING
		// parameter). A mutation summary is keyed by callee, which a witness dispatch has not got, so
		// the dispatch op carries the blames and `CapabilityCallCheck.checkLandingBodiesTakeTheArguments` judges them
		// against every conformer it may land on.
		let argImmutableNames = NameRoster.create(0)

		// Filled and DISCARDED: the per-argument TOKEN exists so a slot-type refusal can point at the
		// value, and a witness dispatch's arguments ARE typed by SemanticCheck against the resolved
		// requirement, so nothing here has one to raise.
		let argAnchors = TokenIndexArray.create(0)

		// The first argument's label is OPTIONAL at an interface / type-parameter receiver and MANDATORY
		// from the second on — see `consumeArgLabel`.
		let places = try self.parseCallArgs(func, target: CallArgTarget.witnessDispatch(self.witnessDeclarationFacts(candidates), requirement: methodTok.value), anchor: methodTok, args: userArgs, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, rule: ArgLabelRule.firstMayBeNamed)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let target = try self.pickWitnessDispatchByArity(candidates, argCount: userArgs.count() as ParamCount, receiver: receiver, methodTok: methodTok)

		if not places.isEmpty() 'someArgumentsReadAPlace'
			try self.bindPlaceArguments(places, declaration: self.witnessDeclarationFactsOf(target), args: userArgs, argLabels: argLabels, callAnchor: methodTok, calleeName: String.from(methodTok.value))
		end 'someArgumentsReadAPlace'

		try self.requireHandedCellsHaveTheRequirementsTypes(target, args: userArgs, argLabels: argLabels, argRanges: argRanges)

		try self.requireNoLinearArgumentIn(userArgs, refusal: self.unknownCalleeLinearSentence("an interface method"), anchor: methodTok)

		let args = try self.slottedWitnessArgs(target, receiver: receiver, userArgs: userArgs, argLabels: argLabels, argRanges: argRanges, methodTok: methodTok)
		let blames = try self.slottedWitnessBlames(target, blames: settledImmutableArgNames(argImmutableNames), argLabels: argLabels, argRanges: argRanges, methodTok: methodTok)
		self.widenWitnessArgs(target, args: args, first: methodTok, last: rparenTok)
		self.recordWitnessConstantArgRangeChecks(args, target: target, anchor: methodTok)
		let requirement = self.witnessRequirementOf(target)
		try self.handIsolatedWitnessArguments(requirement, args: args, argRanges: argRanges, methodTok: methodTok)

		// A `Self`-typed formal (`equals(other Self)`) requires an argument that is a value of `T` — a concrete
		// literal (`self.item.equals(42)`) would be marshalled into the `Self` pointer and faulted. The SAME
		// reject the `==` operator form runs, one shared helper.
		try self.requireWitnessSelfArgs(target, args: args, receiver: receiver, methodTok: methodTok)

		let range = SourceRange.between(methodTok, last: rparenTok)
		let result = try self.mintWitnessDispatchResult(target, receiver: receiver, methodTok: methodTok, resultUsed: resultUsed)
		let opIdx = self.emitWitnessDispatch(result, args: args, blames: blames, target: target, range: range, siteTok: methodTok)

		self.noteRequirementCallSite(func, opIdx: opIdx, target: target, args: args, argLabels: argLabels, argAnchors: argAnchors, receiverTok: self.tokenAt(methodIndex - 2))
		self.noteResultCapabilityThrough(result, carrier: receiver, declared: requirement.returnCapability)
		self.regionFactsForWrite().paramSources.noteDerivedBesideOtherData(result)

		return result
	end 'dispatchWitnessMethod'

	function witnessRequirementOf(target WitnessDispatchTarget) returns InterfaceMethodSig
		return witnessSlotAt(self.signatures, interfaces: self.signatures.interfaceMap(), witnessSlots: WitnessSlotsByDeclIndex.create(), interfaceDeclIndex: target.interfaceDeclIndex, methodIndex: target.methodIndex).method
	end 'witnessRequirementOf'

	function handIsolatedWitnessArguments(requirement InterfaceMethodSig, args ValueIdArray, argRanges SourceRangeArray, methodTok Token) throws SourceParseError
		let first = requirementFirstPosition(requirement)

		for position in first upto args.count() as ParamCount 'eachSourceArgument'
			let sourcePosition = position - first

			if requirementCapabilityAt(requirement, position: position, first: first) != ParamCapability.isolated or maskHasParam(requirement.byRefParams, param: sourcePosition) 'notAnOwnedPosition'
				continue
			end 'notAnOwnedPosition'

			try self.handIsolatedArgumentAt(args, position: position, range: witnessArgAnchor(argRanges, argIndex: sourcePosition), anchor: methodTok)
		end 'eachSourceArgument'
	end 'handIsolatedWitnessArguments'

	function noteRequirementCallSite(func IrFunction, opIdx ElementIndex, target WitnessDispatchTarget, args ValueIdArray, argLabels NameRoster, argAnchors TokenIndexArray, receiverTok Token)
		let notes = self.notesForWrite(func)
		notes.noteArgumentName(opIdx, position: 0, name: receiverTok.value)

		for i in 0 upto argAnchors.count() 'eachWrittenArgument'
			let slot = try argSlotPosition(target.paramNames, argIndex: i as ParamCount, label: try argLabels.get(i) otherwise panic("noteRequirementCallSite: argLabels.get OOB at {i}")) otherwise continue
			self.noteWrittenArgumentName(notes, opIdx: opIdx, position: slot + WitnessReceiverArgCount, anchorIndex: try argAnchors.get(i) otherwise panic("noteRequirementCallSite: argAnchors.get OOB at {i}"))
		end 'eachWrittenArgument'

		self.noteWindowCall(func, opIdx: opIdx, args: args, callOpen: PendingCallOpen.none)
	end 'noteRequirementCallSite'

	function witnessDeclarationFacts(candidates WitnessDispatchTargetArray) returns DeclarationFactsArray
		let facts = DeclarationFactsArray.create(0)

		if not self.signatures.programTakesAParamByRef() 'nothingIsPassedByReference'
			return facts
		end 'nothingIsPassedByReference'

		for candidate in candidates 'eachCandidate'
			facts.push(self.witnessDeclarationFactsOf(candidate))
		end 'eachCandidate'

		return facts
	end 'witnessDeclarationFacts'

	function witnessDeclarationFactsOf(target WitnessDispatchTarget) returns DeclarationFacts
		return DeclarationFacts.create(self.signatures.witnessRequirementConvention(target.declaringInterfaceName, methodName: target.methodName, paramNames: target.paramNames), consume: CalleeConsume.borrowsAll)
	end 'witnessDeclarationFactsOf'

	function slottedWitnessBlames(target WitnessDispatchTarget, blames NameRoster, argLabels NameRoster, argRanges SourceRangeArray, methodTok Token) returns NameRoster throws SourceParseError
		if blames.isEmpty() 'nothingIsBlamed'
			return NameRoster.create(0)
		end 'nothingIsBlamed'

		let sourcePositions = ValueIdArray.create(blames.count(), zeroed: false)

		for i in 0 upto blames.count() 'eachSourceArgument'
			sourcePositions.push(i as ValueId)
		end 'eachSourceArgument'

		let ordered = try self.slottedWitnessArgs(target, receiver: 0, userArgs: sourcePositions, argLabels: argLabels, argRanges: argRanges, methodTok: methodTok)
		let slotted = NameRoster.create(ordered.count() + 1 - WitnessReceiverArgCount, zeroed: false)
		slotted.push(EmptySourceText)

		for i in WitnessReceiverArgCount upto ordered.count() 'eachFormal'
			slotted.push(try blames.get(try ordered.get(i) otherwise panic("slottedWitnessBlames: ordered.get OOB at {i}")) otherwise panic("slottedWitnessBlames: the source position at formal {i} is past the {blames.count()} blames the argument loop pushed"))
		end 'eachFormal'

		return slotted
	end 'slottedWitnessBlames'

	// ⭐ **THE USER'S ARGUMENTS IN THE INTERFACE'S DECLARATION ORDER, WITH THE BORROWED RECEIVER BACK AT
	// `args[0]`** — or the first slotting failure, as the SAME code a direct call's
	// would get. The slotting itself is `Project.slotCallArgs`, the one home of the label→position mapping;
	// nothing about labels is re-derived here.
	//
	// ⭐ **THE LABELS BIND AGAINST THE INTERFACE, NOT THE CONFORMER.** Under dictionary-passing the shared
	// body has no concrete callee to ask — the same reason a `try`'s binding is typed off the
	// interface's `throws` clause — and it is forced by the compiler's own conformance rule besides:
	// `ConformanceCheck.signatureMatches` compares arity and TYPES only (it reads `paramNames` to format
	// E3016 and never compares it), so two conformers may spell their parameters differently and only the
	// interface's names are common to every one of them.
	//
	// The receiver is prepended AFTER slotting, restoring the `args[0]` = receiver / interface formal `j` =
	// `args[j+1]` convention that `requireGenuineSelfArgs`, `floatWidenedWitnessArgs` and
	// `emitWitnessDispatch` all index by — none of which is label-aware, and none of which needs to be.
	function slottedWitnessArgs(target WitnessDispatchTarget, receiver ValueId, userArgs ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, methodTok Token) returns ValueIdArray throws SourceParseError
		match slotCallArgs(target.paramNames, args: userArgs, argLabels: argLabels) 'slot'
			ordered(ids) then return withWitnessReceiver(receiver, ordered: ids)

			// The ARITY error blames the call, the two LABEL errors blame the offending argument — the same
			// split `SemanticCheck.validateCall` makes, `methodTok` being this call's own anchor (it is what
			// `SourceRange.between(methodTok, last: rparenTok)` starts the dispatch op's range at).
			refused(failure) then throw self.witnessSlotRefusal(target, failure: failure, argRanges: argRanges, methodTok: methodTok)
		end 'slot'
	end 'slottedWitnessArgs'

	function witnessSlotRefusal(target WitnessDispatchTarget, failure ArgSlotFailure, argRanges SourceRangeArray, methodTok Token) returns SourceParseError
		return match failure 'failure'
			arityMismatch(expected, got) gives SourceParseError.witnessArgCountMismatch(self.witnessCalleeName(target), expected: expected, got: got, line: methodTok.line, column: methodTok.column)
			unknownLabel(argIndex, label) gives SourceParseError.witnessUnknownArgLabel(self.witnessCalleeName(target), label: label, line: witnessArgAnchor(argRanges, argIndex: argIndex).line, column: witnessArgAnchor(argRanges, argIndex: argIndex).column)
			duplicateArg(argIndex, paramName) gives SourceParseError.witnessDuplicateArg(self.witnessCalleeName(target), paramName: paramName, line: witnessArgAnchor(argRanges, argIndex: argIndex).line, column: witnessArgAnchor(argRanges, argIndex: argIndex).column)
		end 'failure'
	end 'witnessSlotRefusal'

	// What a witness dispatch's argument diagnostics BLAME: `<Interface>.<method>`, which is what the call
	// actually binds against. A direct call names its callee; a dispatch has no callee name to name — the
	// concrete impl is not known in the shared body, and naming one conformer's would be a lie at every
	// other instantiation.
	//
	// ⚠ **THE DECLARING INTERFACE, NOT THE CONSTRAINT'S.** The constraint's name out of
	// `enclosingWhereConstraints` is the same name for every requirement an interface supplies — including
	// the ones it merely INHERITS — so under `where T is Derived` with `interface Derived extends Base`,
	// `Base`'s `label()` would report as `Derived.label`, a requirement `Derived` does not declare. The name
	// travels ON the resolved target, so the interface a message names is the interface
	// the message's arity, formals and labels were all read off.
	function witnessCalleeName(target WitnessDispatchTarget) returns String
		return "{String.from(target.declaringInterfaceName)}.{String.from(target.methodName)}"
	end 'witnessCalleeName'

	// The one door a `witnessDispatch` is emitted through: the `.method()` form and the
	// comparison-operator form (`emitTypeParamComparison`) both come here, so the op's `isThrowing`
	// stamp, the `lastWitnessDispatch` record and the routing of a throwing dispatch to an enclosing
	// handler are written once for both. A dispatch whose record was missed would leave a `try` on it
	// typing its `(e)` binding off a stale clause.
	//
	// `isVoid` is derived here from `target` rather than passed in, so no caller can spell its own
	// answer; the op's void-ness decides which register the lowering reads a result from.
	function emitWitnessDispatch(result ValueId, args ValueIdArray, blames NameRoster, target WitnessDispatchTarget, range SourceRange, siteTok Token) returns ElementIndex
		let isVoid = target.returnType.isVoid()
		let placed = self.floatWidenedWitnessArgs(target, args: args, siteTok: siteTok)

		if self.witnessArgumentsAreChecked(placed, target: target, anchor: siteTok) 'theQuantityDoorIsKept'
			self.markCallChecked(result)
		end 'theQuantityDoorIsKept'

		let opIdx = self.artifact.module.ops.count()
		self.statement.lastWitnessDispatch = RecordedTryTarget.recorded(opIdx, target: TryTarget.witness(target.methodName, throwsClause: target.throwsClause))
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.witnessDispatch(result, args: placed, argImmutableNames: blames, witness: target.witnessValue, methodIndex: target.methodIndex, interfaceDeclIndex: target.interfaceDeclIndex, isVoid: isVoid, isThrowing: throwsClauseIsThrowing(target.throwsClause)), range: range)

		self.routeThrowingOp(self.unclaimedThrowRouteDestination(), opIdx: opIdx, clause: target.throwsClause, result: result)
		self.recordBrandHandOvers(placed, kind: BrandRecordKind.handOverWitness, first: WitnessReceiverArgCount, argLabels: NameRoster.create(0), opIndex: opIdx, range: range)
		return opIdx
	end 'emitWitnessDispatch'

	// ⭐⭐ **WIDEN AN INTEGRAL ACTUAL SUPPLIED FOR A `float` INTERFACE FORMAL — the witness twin of
	// `LowerMaxonToStd.crossFloatDomainArgs`.** A DIRECT call gets this from the
	// callee's resolved signature at the Maxon→Std boundary; a witness dispatch has no callee to look up, so
	// its arguments reached the fused `witnessCall` exactly as written, while the op's `argFloatMask` said what
	// the CALLEE reads. An `int` actual for a `float` formal therefore travelled as a GPR/i64 while the
	// conforming impl reads it from XMM/f64:
	//
	// **MEASURED (both on `interface Scaled { function scale(k float) returns float }` with
	// `self.item.scale(2)`): x64 compiled clean and returned the WRONG ANSWER** — `movRegImm32 rdx, 2` ahead of
	// `callMem [rbx + 24]`, so the callee's `mulsd xmm0, …` multiplied whatever was left in xmm0 — **and wasm
	// trapped `indirect call type mismatch`**, since `call_indirect` checks the declared functype against the
	// target's own exactly. The wasm half is the hole the `requireIndirectlyReachableParamsAreMachineWords`
	// guard could not see while it existed: it refused a narrow (i32) parameter, but an f64 one is legal and
	// only DIVERGES when the actual is in the wrong register file — which is precisely what this widening fixes.
	//
	// ⚠ **IT IS NOT THE ONLY WIDENING, AND THE SPLIT IS BY WHAT EACH END CAN SEE.**
	// `LowerMaxonToStd.witnessFormalTypes` derives the masks from the INTERFACE's declared formals, so a formal
	// that resolves to `float` declares XMM whatever the actual is — and an unwidened `int` actual is then a raw
	// integer bit pattern moved into a float register, which x64 refuses outright (MEASURED: `a
	// register-to-register move from rax to xmm0 crosses register files`). So the lowering widens too, through
	// the same `crossFloatDomainArgs` a function-value call uses.
	// What THIS one still owns is the formal spelled `float` in the interface: it makes the VALUE an f64 at
	// PARSE time, which is what types the expression around it, and nothing downstream can do that. The
	// lowering's covers the formal the interface does NOT spell — an ASSOCIATED type, whose `float` is a
	// conformer's `with float` and is invisible here. The two compose: an actual this widened is already an f64,
	// so the lowering's fast path returns the argument list verbatim.
	//
	// It runs in `emitWitnessDispatch` because that is the ONE door both dispatch forms come through, so the
	// `.method()` and comparison-OPERATOR forms cannot acquire different argument placement. `promoteToFloat`
	// is idempotent, so a genuine `float` actual passes through untouched and emits nothing.
	//
	// ⚠ **IT IS NOT ARITY-TOLERANT.** Both dispatch forms guarantee one actual per formal (see
	// `requireGenuineSelfArgs`), so the two counts agree and walking the actuals is simply walking the
	// formals — and `witnessFormalIsFloat` may panic on an index past `paramTypeNames`, which that guarantee rules out.
	function floatWidenedWitnessArgs(target WitnessDispatchTarget, args ValueIdArray, siteTok Token) returns ValueIdArray
		// FAST PATH, for `crossFloatDomainArgs`'s reason: only a `float` FORMAL can force a widening and
		// almost no interface method has one, so every other dispatch returns its arguments verbatim — no array
		// built, no op emitted, and the whole conformance corpus stays byte-identical.
		if not self.witnessTargetHasFloatFormal(target) 'noFloatFormal'
			return args
		end 'noFloatFormal'

		let placed = ValueIdArray.create(args.count(), zeroed: false)

		// `args[0]` is the BORROWED receiver, which fills no formal — interface formal `j` is `args[j+1]`, the
		// same mapping `requireGenuineSelfArgs` walks. It is copied across before the loop so the loop body
		// never has to subtract from an index that could be 0.
		placed.push(try args.get(0) otherwise panic("floatWidenedWitnessArgs: a witness dispatch's args are empty — `args[0]` is the receiver, pushed by both dispatch forms before any actual"))

		for j in 0 upto args.count() - 1 'eachActual'
			let actual = try args.get(j + 1) otherwise panic("floatWidenedWitnessArgs: args.get OOB at {j + 1} below count {args.count()}")

			if not self.witnessFormalIsFloat(target, formalIndex: j) or valueIsMarked(self.bodyState.argumentStorage, value: actual) 'noWiden'
				placed.push(actual)
				continue
			end 'noWiden'

			placed.push(self.promoteToFloat(actual, opTok: siteTok))
		end 'eachActual'

		return placed
	end 'floatWidenedWitnessArgs'

	// Does ANY formal of the dispatched interface method declare `float`? The fast-path predicate above, kept
	// beside the per-formal test so the two read the same constant.
	function witnessTargetHasFloatFormal(target WitnessDispatchTarget) returns bool
		for j in 0 upto target.paramTypes.count() 'eachFormal'
			if self.witnessFormalIsFloat(target, formalIndex: j) 'found'
				return true
			end 'found'
		end 'eachFormal'

		return false
	end 'witnessTargetHasFloatFormal'

	// Is interface formal `formalIndex` declared `float`? Both askers stay within the declared formals — one
	// loops the formals directly, the other loops actuals a checked arity has made equinumerous with them
	// (see `floatWidenedWitnessArgs`) — so an out-of-range index is a compiler defect, not an arity mismatch
	// to absorb.
	function witnessFormalIsFloat(target WitnessDispatchTarget, formalIndex ElementIndex) returns bool
		return (try target.paramTypes.get(formalIndex) otherwise panic("witnessFormalIsFloat: paramTypes.get OOB at {formalIndex} below count {target.paramTypes.count()} — a dispatch reaching here has one actual per formal")).isFloat()
	end 'witnessFormalIsFloat'

	// The requirements `<receiver>.<method>(…)` could bind, or the "no constraint provides it" reject when the
	// constraints supply none. The reject is the `.method()` form's own; the OPERATOR form asks
	// `findWitnessDispatchCandidates` directly because its miss is E3005 (see `requireOperatorWitness`).
	//
	// ⭐⭐ **A `static` REQUIREMENT IS NOT A CANDIDATE FOR A CALL THAT SUPPLIES A RECEIVER.** The search
	// matches by METHOD NAME (it must — see `findWitnessDispatchCandidates`), so a `static` requirement was
	// reached by `self.item.origin()` and its slot bound, with the receiver prepended at `args[0]` in front of
	// a callee that declares no parameter for it. **MEASURED: x64-windows compiled clean and returned the
	// right answer by ABI LUCK** — the spurious receiver landed in an argument register the zero-parameter
	// impl never reads — **while `--target=wasm32-wasi` compiled clean and TRAPPED `indirect call type
	// mismatch`**, because `call_indirect` compares the declared functype against the target's own. The same
	// wall `floatWidenedWitnessArgs` describes: an argument-placement disagreement x64's registers absorb and
	// wasm's typed calls do not.
	//
	// ⚠ **IT IS A FILTER, NOT A VERDICT ON THE CHOSEN ONE, for `witnessTargetIsProtocol`'s reason.** Two
	// requirements may share a name and differ in receiver kind, and an instance-syntax call can only ever
	// mean the instance one — so the statics are removed BEFORE arity selects, and the arity/ambiguity
	// messages then speak only of requirements the call could have meant.
	//
	// ⚠⚠ **IT THROWS, AND IT MAY NOT MERELY RECORD — see `SourceParseError.staticRequirementNotDispatchable` for
	// the three measurements.** Recording a diagnostic and returning `candidates` would keep the parse on the path it
	// takes without this reject — and that path's next step is `pickWitnessDispatchByArity` over
	// the requirements just rejected, which then reports an argument COUNT or an ambiguity as if one of them
	// could still have been meant. Worse, a recorded diagnostic does not survive a later
	// `SourceParseError` in its region, nor one no region confines (`abortedParseArtifact`), so the
	// refusal would be contingent on nothing else there failing.
	function requireWitnessDispatchCandidates(receiver ValueId, methodTok Token) returns WitnessDispatchTargetArray throws SourceParseError
		let candidates = try self.findWitnessDispatchCandidates(receiver, methodName: methodTok.value, errorTok: methodTok)

		if candidates.count() == 0 'noneProvideIt'
			throw SourceParseError.unsupported("no requirement named '{String.from(methodTok.value)}' is provided by {self.witnessDispatchProviderPhrase(receiver)} — a method call on a value whose type is an interface, or on a constrained type parameter, dispatches through a witness table, so the method has to be one that interface declares", line: methodTok.line, column: methodTok.column)
		end 'noneProvideIt'

		// FAST PATH, for `floatWidenedWitnessArgs`' reason: a `static` requirement is rare — a sweep of both
		// spec corpora, the compiler and the stdlib found exactly ONE outside `stdlib/Builtins.maxon`'s
		// literal-init protocols, and NO program anywhere that reaches one through a constraint — so almost
		// every dispatch hands its candidates straight back: no array built, and the whole conformance corpus
		// stays allocation-identical (measured: scale-test delta 0 at all six sizes).
		if not witnessCandidatesNeedReceiverFilter(candidates) 'allTakeAReceiver'
			return candidates
		end 'allTakeAReceiver'

		let dispatchable = WitnessDispatchTargetArray.create(0)

		for i in 0 upto candidates.count() 'eachCandidate'
			let candidate = try candidates.get(i) otherwise panic("requireWitnessDispatchCandidates: candidates.get OOB at {i} below count {candidates.count()}")

			if witnessRequirementTakesReceiver(candidate) 'takesAReceiver'
				dispatchable.push(candidate)
			end 'takesAReceiver'
		end 'eachCandidate'

		if dispatchable.count() > 0 'someTakeAReceiver'
			return dispatchable
		end 'someTakeAReceiver'

		// The filter kept NOTHING, so every requirement of this name is `static` — which makes candidate 0 one
		// of them, and the one the author wrote the call against. A second static of the same name is the same
		// fact twice, not a rival, so only the first is named.
		let refused = try candidates.get(0) otherwise panic("requireWitnessDispatchCandidates: candidates.count() is {candidates.count()} but get(0) failed")

		throw SourceParseError.staticRequirementNotDispatchable(self.witnessCalleeName(refused), receiver: self.witnessDispatchReceiverPhrase(receiver), line: methodTok.line, column: methodTok.column)
	end 'requireWitnessDispatchCandidates'

	// ⭐⭐ **EVERY REQUIREMENT `receiver` CAN REACH UNDER `methodName` — A LIST, TRANSITIVE, FOR BOTH RECEIVER KINDS.** For a CONSTRAINED TYPE
	// PARAMETER that is every `where` constraint on it; for an EXISTENTIAL it is the one interface the value
	// is held at. Each candidate carries the VALUE holding the table to jump through, the requirement's SLOT
	// in that table, and the requirement's own signature.
	//
	// ⚠ **IT RETURNS EVERY HIT, BECAUSE RETURNING THE FIRST WOULD BE TWO SILENT PICKS IN ONE LOOP.** Stopping at the
	// first CONSTRAINT declaring the name would never consult a later constraint declaring it too, and matching by
	// NAME ALONE with no arity test would let the first requirement of that name take every call.
	// Neither would produce a diagnostic; both would produce a bound slot. Which of the candidates is meant is
	// therefore decided by the CALLER, which is the only party that knows what it can discriminate on — an
	// argument COUNT for `.method()`, the protocol's own SHAPE for an operator — and both go through
	// `pickSoleWitnessCandidate`, so neither can silently take the first of two.
	//
	// ⭐ **THE SLOT NUMBERING IS `interfaceWitnessSlots`', asked of the DECLARATION INDEX** — the same walk
	// `LowerMaxonToStd.ensureWitnessTable` lays the table out by, so `methodIndex` names the slot the emitted
	// blob actually fills. `errorTok` positions `requireInterfaceForParse`'s undeclared-interface reject.
	function findWitnessDispatchCandidates(receiver ValueId, methodName ByteArray, errorTok Token) returns WitnessDispatchTargetArray throws SourceParseError
		let candidates = WitnessDispatchTargetArray.create(0)

		// ⭐ **AN EXISTENTIAL SEARCHES THE ONE INTERFACE THE VALUE IS HELD AT, AND ITS WITNESS IS THE FAT
		// POINTER'S OWN SECOND HALF.** There is no constraint list to walk and no
		// hidden parameter to name: the receiver carries its table with it. Everything BELOW the search — the
		// argument slotting, the arity selection, the result typing, the emitted op — is shared verbatim,
		// which is the whole reason `WitnessDispatchTarget` names a witness VALUE rather than a constraint.
		if self.tagOf(receiver) == ValueTypeTag.interfaceRef 'existentialReceiver'
			let iface = try self.requireInterfaceForParse(self.internedName(self.valueNameId(receiver)), methodTok: errorTok)
			self.appendInterfaceDispatchCandidates(candidates, iface: iface, witness: self.witnessOfValue(receiver), methodName: methodName)
			return candidates
		end 'existentialReceiver'

		// ⭐ **THE RECEIVER'S TOKEN IS TURNED INTO A POSITION ONCE, HERE, BECAUSE THAT IS WHAT A `where` CLAUSE
		// IS INDEXED BY.** `WhereConstraint.typeParamIndex` is a POSITION in the declaring type's `uses`
		// list — the witness-slot numbering the dictionary-passing ABI threads — and the receiver carries an
		// IDENTITY, which are different kinds of number, so the conversion has to be written. A receiver that is not one of THIS
		// declaration's parameters (a concrete generic-method result the parser tags opaque in a non-generic
		// caller) matches no constraint, which is why the miss
		// returns the empty candidate list rather than raising.
		let typeName = try self.enclosingType.typeName() otherwise return candidates
		let receiverPosition = try typeParamPositionIn(self.valueTypeParamId(receiver), declarationName: typeName, paramNames: self.enclosingTypeParams) otherwise return candidates

		let constraintsOfReceiver = try self.constraintsOnParameter(self.enclosingWhereConstraints, position: receiverPosition, methodName: methodName, errorTok: errorTok)

		for constraint in constraintsOfReceiver 'eachConstraint'
			let i = constraint.constraintIndex

			if i as ParamCount >= self.declaringWitnessParamCount 'noTableToDispatchThrough'
				if constraint.declaresInstance 'dispatchHasNoTable'
					throw self.noWitnessTablesRefusal(methodName, arrival: NoWitnessTablesArrival.dispatchedOnATypeParameter if self.closureEnclosingFrames.isEmpty() else NoWitnessTablesArrival.dispatchedInAClosure, anchor: errorTok)
				end 'dispatchHasNoTable'

				continue
			end 'noTableToDispatchThrough'

			// ⚠ The witness is resolved for EVERY constraint on this receiver, ahead of knowing which one
			// declares `methodName` — a constraint that declares none contributes no candidate, and inside a
			// closure it has already claimed an env slot and emitted a load nothing reads. That costs one
			// machine word and one dead op on the rare `where T is A and B` where only one of the two is being
			// dispatched, and it buys the property this file spends most on: ONE candidate builder, reached
			// identically by both receiver kinds (see `appendInterfaceDispatchCandidates`). Splitting the
			// witness out to resolve it lazily would give the constraint route its own copy of the slot walk.
			self.appendInterfaceDispatchCandidates(candidates, iface: constraint.iface, witness: self.witnessValueForConstraint(i as WitnessSlotIndex, anchor: errorTok), methodName: methodName)
		end 'eachConstraint'

		return candidates
	end 'findWitnessDispatchCandidates'

	// ⭐⭐ **THE VALUE HOLDING `where` CONSTRAINT `constraintIndex`'s TABLE, IN THE FUNCTION BEING EMITTED.**
	// The ONE door every witness dispatch through a constrained type parameter goes through, and it
	// has two answers because two kinds of body can ask:
	//
	//   • the DECLARING function's own body — the hidden witness PARAMETER `parseFunction` reserved
	//     (`witnessParamValueId`). No op at all: the table is already in a register.
	//   • a LIFTED CLOSURE's body — the table is NOT a parameter of the lifted function and cannot become one:
	//     a closure is reached through the uniform `(userargs, record)` INDIRECT shape, which has exactly one
	//     hidden slot and it is the environment, and the call site (`cmp(a, b)` inside a sort helper) knows
	//     nothing of the closure's origin, let alone its constraints. So the witness travels as an ORDINARY
	//     CAPTURE — one env slot holding one machine word, stored where the closure is BUILT (inside the
	//     constrained method, which holds the table) and read back with the same `loadIndirect` every other
	//     capture is read with.
	//
	// ⭐ **SO A WITNESS IS A CAPTURED VALUE, NOT A SECOND CHANNEL — and that is forced, not preferred.** It
	// also costs nothing new downstream: `StdOp.witnessCall` takes a `witnessAddr` VALUE and resolves nothing
	// (`LowerMaxonToStd.appendWitnessCall`), so a table that arrived through an env slot is indistinguishable
	// from one that arrived in a parameter — which is the property the op's `constraintIndex` being a ValueId
	// buys, and this is the third receiver route to spend it.
	//
	// ⚠ **NESTED CLOSURES INHERIT BY CHAINING, ONE HOP PER LEVEL — which is why this works where an ordinary
	// nested capture is REFUSED** (`captureScopeOf`'s non-immediate-frame reject, whose problem is that there
	// is no env chain to walk). Each level captures from its own IMMEDIATE enclosing context, so a witness
	// reaches depth 2 as a capture of a capture, and every hop is a hop the existing env machinery already
	// makes. `fillInheritedWitnessCaptures` re-enters here, one context out, to close each one.
	function witnessValueForConstraint(constraintIndex WitnessSlotIndex, anchor Token) returns ValueId
		if self.closureEnclosingFrames.isEmpty() 'theDeclaringFunctionsOwnBody'
			return self.witnessParamValueId(constraintIndex)
		end 'theDeclaringFunctionsOwnBody'

		if constraintIndex as ParamCount >= self.declaringWitnessParamCount 'nothingToInherit'
			panic("witnessValueForConstraint: a closure asked for constraint {constraintIndex}'s table, and the function that built it declares {self.declaringWitnessParamCount} witness parameter(s) — `findWitnessDispatchCandidates` refuses a dispatch past them before it asks, and an inherited capture was filed by an earlier successful ask")
		end 'nothingToInherit'

		let slot = self.inheritedWitnessSlotFor(constraintIndex)

		// The read side of the env slot pair, derived through the SAME `wordSlotStorageType` the store side
		// (`buildClosureEnv`) asks — see `emitCaptureRead`, whose loads this deliberately mirrors rather than
		// re-deriving a width. A witness table is a plain machine word, so the declared type IS the storage
		// type; going through the shared door anyway is what keeps that true if either ever changes.
		return self.closureEnvWord(slot, anchor: anchor)
	end 'witnessValueForConstraint'

	// The env slot carrying constraint `constraintIndex`'s inherited witness in the closure now being parsed,
	// claiming a fresh one on first sight — `captureSlotFor`'s dedup, keyed by a name no source can write, so a
	// constraint dispatched five times in one body occupies one slot and stores once.
	//
	// ⚠ The slot stays `CapturedValue.unfilled` here and is entered in `inheritedWitnessCaptures`,
	// which `fillInheritedWitnessCaptures` drains before `buildClosureEnv` reads the column. It cannot
	// be filled now — the value belongs to the enclosing function's block, which is not current until
	// the restore.
	function inheritedWitnessSlotFor(constraintIndex WitnessSlotIndex) returns EnvSlotIndex
		for i in 0 upto self.bodyState.inheritedWitnessCaptures.count() 'existing'
			let seen = try self.bodyState.inheritedWitnessCaptures.get(i) otherwise panic("inheritedWitnessSlotFor: inheritedWitnessCaptures.get OOB at {i} below count {self.bodyState.inheritedWitnessCaptures.count()}")

			if seen.constraintIndex == constraintIndex 'reuse'
				return seen.slot
			end 'reuse'
		end 'existing'

		let slot = self.captureSlotFor(witnessCaptureName(constraintIndex), captureType: MaxonType.integer, anchor: self.current())
		self.bodyState.inheritedWitnessCaptures.push(InheritedWitnessCapture.create(constraintIndex, slot: slot))
		return slot
	end 'inheritedWitnessSlotFor'

	// ⭐ **CLOSE EACH INHERITED WITNESS'S ONE HOP, IN THE ENCLOSING CONTEXT** — called by
	// `parseClosureExpression` after the restore, which is the first moment the enclosing function's block and
	// SSA space are current again, and before `buildClosureEnv` reads the value column it fills.
	//
	// `witnessValueForConstraint` re-entering IS the chain: for a closure written directly in the constrained
	// method it answers with that method's hidden parameter and emits nothing; for a closure nested in another
	// closure it claims a slot in the ENCLOSING closure's environment and emits that closure's own load, which
	// this same routine then fills one level further out. The recursion terminates at the declaring function,
	// which is the only context with no environment above it.
	function fillInheritedWitnessCaptures(inherited InheritedWitnessCaptureArray, capturedValues CapturedValueArray, anchor Token)
		for entry in inherited 'eachInheritedWitness'
			let enclosingWitness = self.witnessValueForConstraint(entry.constraintIndex, anchor: anchor)
			try capturedValues.set(entry.slot, value: CapturedValue.filled(enclosingWitness)) otherwise panic("fillInheritedWitnessCaptures: env slot {entry.slot} is past the {capturedValues.count()} capture(s) this closure collected — every slot here came from `captureSlotFor`, which fills all three columns in lockstep")
		end 'eachInheritedWitness'
	end 'fillInheritedWitnessCaptures'

	// Does the function whose body is being EMITTED right now carry the declaring type's hidden witness
	// parameters? Not the same question as "did the declaring function reserve any" the moment a lifted closure
	// is being parsed: the closure's ABI has no room for them (see `witnessValueForConstraint`), so it carries
	// none however constrained its author was. The one door for "may I forward my own witness slots".
	function emittingFunctionCarriesWitnessParams() returns bool
		return self.emittingFunctionTableHolder() == TableHolder.carriesTables
	end 'emittingFunctionCarriesWitnessParams'

	// ⭐ **THE HIDDEN WITNESS PARAMETER THAT CARRIES CONSTRAINT `constraintIndex`'s TABLE.**
	// The parser RESERVED these slots (`parseFunction`,
	// `[user][existentialWitness][count][witness_0..k][layout]`),
	// so resolving one is arithmetic on the reservation this same pass made, not a whole-program re-derivation.
	// It PANICS on a function that reserved none: a
	// dispatch through a constraint can only be emitted inside an instance method of the constrained type, and
	// that is exactly the shape `witnessReserveFor` reserves for.
	//
	// ⚠ **ITS PRECONDITION IS "NOT INSIDE A LIFTED CLOSURE", AND `witnessValueForConstraint` IS WHAT HOLDS IT**
	// — a closure body's dispatch has no parameter to name and inherits instead, so reaching this from
	// one would return a ValueId in the DECLARING function's numbering, read inside a body with its own dense
	// SSA space. That is why the routing decision sits in one door above and not in each caller.
	function witnessParamValueId(constraintIndex WitnessSlotIndex) returns ValueId
		if self.declaringWitnessParamCount == 0 'reservesNoWitnessParameter'
			panic("Parser.witnessParamValueId: a dispatch through `where` constraint {constraintIndex} inside a function that reserved no witness parameters — `witnessReserveFor` reserves them for an INSTANCE method of a constrained type, so a dispatch reaching here was resolved against constraints the current function does not carry")
		end 'reservesNoWitnessParameter'

		return self.declaringWitnessParamBase + (constraintIndex as ValueId)
	end 'witnessParamValueId'

	function witnessSlotIndicesNamed(slots CollectedInterfaceMethodArray, methodName ByteArray) returns NamedSlotIndexArray
		let named = NamedSlotIndexArray.create(0)

		for slotIndex in 0 upto slots.count() 'eachSlot'
			if (try slots.get(slotIndex) otherwise panic("witnessSlotIndicesNamed: slots.get OOB at {slotIndex} below count {slots.count()}")).method.name.equals(methodName) 'named'
				named.push(slotIndex)
			end 'named'
		end 'eachSlot'

		return named
	end 'witnessSlotIndicesNamed'

	// ⭐ **EVERY REQUIREMENT OF `iface` (TRANSITIVELY) NAMED `methodName`, AS A DISPATCH TARGET THROUGH
	// `witness`** — the per-interface half of the search above, shared by both receiver kinds so a candidate is
	// built in exactly one place whichever route reached it. `witnessSlotsOf` is the memoized transitive
	// requirement list, and a requirement's INDEX in it is the table slot every reader numbers by
	// (`interfaceWitnessSlots`).
	//
	// The already-collected test is applied on BOTH routes rather than only on the constraint one: for a
	// single interface it can never fire (`interfaceWitnessSlots`' `visited` set gives each interface one run
	// of slots, and `requireUnclaimedInterfaceRequirementName` forbids one interface two requirements of a
	// name), so applying it uniformly costs an empty scan and keeps the rule stated once. See
	// `witnessCandidateAlreadyCollected` for why a requirement reached twice is one requirement, not a rival.
	function appendInterfaceDispatchCandidates(candidates WitnessDispatchTargetArray, iface IrInterface, witness ValueId, methodName immutable ByteArray)
		let slots = self.witnessSlotsOf(iface)

		// The handle that makes `methodIndex` meaningful downstream — read ONCE per interface here rather than
		// per candidate, and off the very interface whose slot list is being numbered, so the index and the
		// numbering cannot describe two different interfaces. `iface` came out of `interfaceMap()`, which is
		// the same store `recordInterfaceDeclaration` fills, so a miss is a compiler defect.
		let interfaceDeclIndex = self.interfaceDeclIndexOfResolved(iface)

		for slotIndex in self.witnessSlotIndicesNamed(slots, methodName: methodName) 'eachSlot'
			let slot = try slots.get(slotIndex) otherwise panic("appendInterfaceDispatchCandidates: slots.get OOB at {slotIndex} below count {slots.count()}")

			if witnessCandidateAlreadyCollected(candidates, declaringInterfaceName: slot.sourceInterfaceName, methodName: methodName) 'reachedByAnEarlierConstraint'
				continue
			end 'reachedByAnEarlierConstraint'

			candidates.push(WitnessDispatchTarget.create(witness, methodIndex: slotIndex as WitnessMethodIndex, interfaceDeclIndex: interfaceDeclIndex, returnTypeName: slot.method.returnTypeName, returnType: slot.method.returnType, paramTypeNames: slot.method.paramTypeNames, paramTypes: slot.method.paramTypes, throwsClause: slot.method.throwsClause, methodName: methodName, paramNames: slot.method.paramNames, declaringInterfaceName: slot.sourceInterfaceName, isStatic: slot.method.isStatic))
		end 'eachSlot'
	end 'appendInterfaceDispatchCandidates'

	// `iface`'s transitive witness slot list, built on this file's FIRST dispatch through that
	// interface and held after — see `WitnessSlotTable` for the quadratic this removes and for why the
	// memo is per `Parser` rather than on `ProgramSignatures`.
	//
	// The list is a pure function of the interface DECLARATION INDEX, which `ProgramSignatures` fixes before
	// any parse begins and no parse can move, so one answer serves the whole file — the same property that
	// makes the numbering safe to bake into another file's emitted offsets in the first place.
	// (`foldInterfaceDeclarations` is the only writer of that index and it runs to completion inside
	// `queryProgramSignatures`, before the first body is parsed; the sweep itself parses no call, so no
	// `Parser` can memoize a slot list off a half-filled index.)
	//
	// ⚠ **THE MAP IS ASKED THROUGH `interfaceMap()`, exactly as the parser's two other interface
	// readers ask it** (`requireInterfaceForParse`, `conformanceUsesArity`), and the memo through
	// `witnessSlotsAt`, the one walk the lowering and the checks number slots by — a second derivation
	// here could number them differently from the dispatch they emit.
	function witnessSlotsOf(iface IrInterface) returns CollectedInterfaceMethodArray
		let byDeclIndex = self.witnessSlotsForWrite()
		return witnessSlotsAt(self.signatures, interfaces: self.signatures.interfaceMap(), witnessSlots: byDeclIndex, interfaceDeclIndex: self.interfaceDeclIndexOfResolved(iface))
	end 'witnessSlotsOf'

	function interfaceDeclIndexOfResolved(iface IrInterface) returns ElementIndex
		return try self.signatures.interfaceDeclIndexOf(iface.name) otherwise panic("interfaceDeclIndexOfResolved: interface '{String.from(iface.name)}' resolved out of `interfaceMap()` but has no declaration-order index — the two are filled in one act by `recordInterfaceDeclaration`")
	end 'interfaceDeclIndexOfResolved'

	// ⭐ **WHICH CANDIDATE A `.method(…)` CALL MEANS: THE ONE TAKING THIS MANY ARGUMENTS.** An interface
	// and its `extends` parents may each declare the name — `Base.label()` beside `Derived.label(width)` is
	// the ordinary spelling — and those are two DISTINCT requirements in two DISTINCT slots, so the argument
	// count is what tells them apart. Selecting by name alone bound the call to whichever came first and then
	// reported the OTHER one's arity against it: `'Derived.label' expects 1 argument(s) but 0 were provided`,
	// a false sentence about an interface that inherits a zero-argument `label()`.
	//
	// The count is compared against the interface's FORMALS, which is the same list `slotCallArgs` then slots
	// the labelled arguments into — so a call that survives this cannot fail arity there, and one that does
	// not survive it is still reported by `slotCallArgs` whenever there is a single candidate to report
	// against (see below). The label rules stay entirely that function's.
	function pickWitnessDispatchByArity(candidates WitnessDispatchTargetArray, argCount ParamCount, receiver ValueId, methodTok Token) returns WitnessDispatchTarget throws SourceParseError
		let matching = WitnessDispatchTargetArray.create(0)

		for i in 0 upto candidates.count() 'eachCandidate'
			let candidate = try candidates.get(i) otherwise panic("pickWitnessDispatchByArity: candidates.get OOB at {i} below count {candidates.count()}")

			if candidate.paramTypes.count() as ParamCount == argCount 'takesThisMany'
				matching.push(candidate)
			end 'takesThisMany'
		end 'eachCandidate'

		match pickSoleWitnessCandidate(matching) 'pick'
			one(target) then return target
			ambiguous(first, second) then throw SourceParseError.ambiguousWitnessDispatch(String.from(methodTok.value), provider: self.witnessDispatchProviderPhrase(receiver), argCount: argCount, first: renderWitnessRequirement(first, signatures: self.signatures), second: renderWitnessRequirement(second, signatures: self.signatures), line: methodTok.line, column: methodTok.column)
			none then break
		end 'pick'

		// Nothing of that name takes this many arguments. With exactly ONE candidate there is nothing to select
		// between, and the arity is `slotCallArgs`' to report — the ONE home of the label→position mapping,
		// whose E3036 already names the interface and both counts. With several, no single one of them is what
		// the author meant, so the reject lists them all rather than blaming an arbitrary one.
		if candidates.count() == 1 'soleCandidate'
			return try candidates.get(0) otherwise panic("pickWitnessDispatchByArity: candidates.count() is 1 but get(0) failed")
		end 'soleCandidate'

		throw SourceParseError.noWitnessRequirementOfArity(String.from(methodTok.value), provider: self.witnessDispatchProviderPhrase(receiver), argCount: argCount, available: renderWitnessRequirements(candidates, signatures: self.signatures), line: methodTok.line, column: methodTok.column)
	end 'pickWitnessDispatchByArity'

	// The throwing form for the witness-dispatch caller, which cannot proceed without the declaration. The
	// miss is a clean positioned reject naming the constraint's interface.
	//
	// ⚠⚠ **THE MESSAGE MAY NOT SAY "NO FILE DECLARES IT", BECAUSE THAT IS SOMETIMES FALSE AND THE COMPILER
	// CANNOT TELL WHICH.** The index holds every interface `foldInterfaceDeclarations` could
	// READ, and that pass is TOLERANT: an `interface` whose own body has a syntax error records nothing, so a
	// declaration that is RIGHT THERE in the source lands here indistinguishably from a typo. It is not
	// enough that the real parse reports that syntax error too — MEASURED, with the broken `interface`
	// written BELOW its constrained use in the same file, THIS reject is raised at the dispatch first and the
	// file's parse stops, so the sentence below is the ONLY diagnostic the program produces
	// (`where-clauses.error.constraint-interface-unreadable` pins exactly that).
	//
	// So it states what is actually known — the name resolved to nothing READABLE — and names BOTH causes,
	// rather than asserting the one it cannot distinguish. Recording "a site claimed this name but failed to
	// read" instead would buy a sharper sentence for a SECOND store of the interface name (see
	// `InterfaceDeclSite`); a diagnostic is not worth the duplication.
	function requireInterfaceForParse(name ByteArray, methodTok Token) returns IrInterface throws SourceParseError
		match lookupInterface(self.signatures.interfaceMap(), name: name) 'lookup'
			found(iface) then return iface
			notFound then throw SourceParseError.unsupported("the `where` constraint interface '{String.from(name)}' does not resolve — no file in this program declares a readable `interface` of that name, so it is either misspelled or an `interface` whose own declaration fails to parse", line: methodTok.line, column: methodTok.column)
		end 'lookup'
	end 'requireInterfaceForParse'

	// Mint the SSA value a witness dispatch defines, typed from the interface method's return type
	// — the witness-dispatch twin of `mintDeclaredCallResult`. A `void` method mints a discarded `void`
	// result in statement position and reports E2004 in value position (like a void direct call); every other
	// return type is minted below and enrolled through `enrolOwnedCallTemp`, so a heap-returning interface
	// method's result is adopted owned exactly as a direct call's is. There is no retype to wait for here —
	// an interface's declared return type is already concrete, and the one that is not (`Self`) is answered
	// by the receiver rather than substituted afterwards.
	function mintWitnessDispatchResult(target WitnessDispatchTarget, receiver ValueId, methodTok Token, resultUsed bool) returns ValueId throws SourceParseError
		if target.returnType.isVoid() 'voidReturn'
			if resultUsed 'noValueToUse'
				throw SourceParseError.voidCallResultUsed(String.from(methodTok.value), line: methodTok.line, column: methodTok.column)
			end 'noValueToUse'

			return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
		end 'voidReturn'

		let result = self.witnessDispatchValueResult(target, receiver: receiver, methodTok: methodTok)
		self.enrolOwnedCallTemp(result)
		return result
	end 'mintWitnessDispatchResult'

	// The three spellings a NON-void interface return has, split from the door above so the drop enrolment is
	// written once across all three rather than once per arm — the same one-rule-one-site reason
	// `enrolOwnedCallTemp` exists at all.
	function witnessDispatchValueResult(target WitnessDispatchTarget, receiver ValueId, methodTok Token) returns ValueId
		// A `Self` return is the receiver's own type (the shared body cannot know the concrete one).
		if target.returnType.isSelf() 'selfReturn'
			return self.mintSelfReturnedWitnessResult(receiver)
		end 'selfReturn'

		if let held = try self.heldAssociatedReturnOf(target) 'heldAtAnInterface'
			return self.mintHeldAssociatedWitnessResult(target, held: held, receiver: receiver, methodTok: methodTok)
		end 'heldAtAnInterface'

		// ⭐⭐ **AN ASSOCIATED-TYPE RETURN THE RECEIVER'S OWN INSTANTIATION BINDS** — asked BELOW the held
		// arm, which must keep its nested witness, and ABOVE the fallback, which reads the associated type's
		// NAME as though it were a concrete type's.
		if let claim = try self.existentialClaimOfValue(receiver) 'theReceiverNamedAnInstantiation'
			if let bound = try self.associatedReturnThroughReceiverInstance(target, claim: claim) 'theReceiversInstanceBindsIt'
				return self.mintOwnedCallResult(bound, scopeFilePath: claim.scopeFilePath)
			end 'theReceiversInstanceBindsIt'
		end 'theReceiverNamedAnInstantiation'

		// ⭐⭐ **AND THE SAME ANSWER FOR A CONSTRAINED TYPE PARAMETER, WHOSE `where` CLAUSE IS WHERE ITS `with`
		// ARGUMENTS ARE WRITTEN.** Asked beside the instance arm rather than inside it because the two
		// receivers record the claim in two different stores — a declared existential on the VALUE, a type
		// parameter on the DECLARATION — and above the fallback for the identical reason: the fallback reads
		// the associated type's NAME as though it were a concrete type's.
		if let bound = try self.associatedReturnThroughConstraintBinding(target, receiver: receiver) 'theConstraintBindsIt'
			return self.mintOwnedCallResult(bound, scopeFilePath: self.constrainedParamDeclFilePath(receiver))
		end 'theConstraintBindsIt'

		// Minted as the interface's own file reads its text, so a float is lifted and a contested ranged
		// name re-spelled once, the crossing a direct call's result makes from its callee's file. Read as
		// this file's, a same-named narrower alias here elides the return guard.
		let result = self.mintOwnedCallResult(self.unboundRequirementResultType(target), scopeFilePath: self.signatures.declaringInterface(target.declaringInterfaceName).declFilePath)

		if self.tagOf(result) == ValueTypeTag.genericInstance and not target.returnType.brand.isEmpty() 'aBrandedResult'
			self.brandValue(result, brand: target.returnType.brand)
		end 'aBrandedResult'

		return result
	end 'witnessDispatchValueResult'

	// An associated type no receiver binds is named `<DeclaringInterface>.<Item>`: under its bare name
	// a program typealias of that name would capture it, and the result would carry that alias's
	// range.
	function unboundRequirementResultType(target WitnessDispatchTarget) returns MaxonType
		if target.returnType.isTypeParameter() 'anAssociatedType'
			let member = try associatedNameOf(target.returnType, signatures: self.signatures) otherwise panic("unboundRequirementResultType: the type parameter '{String.from(target.returnTypeName)}' returned by '{String.from(target.declaringInterfaceName)}.{String.from(target.methodName)}' has no owner — `recordInterfaceDeclaration` files every associated type of an interface as the sweep folds")
			return MaxonType.named(self.artifact.typeNames.intern(joinQualifiedName(target.declaringInterfaceName, member: member)))
		end 'anAssociatedType'

		return resolvedRequirementType(target.returnType, typeNames: self.artifact.typeNames, signatures: self.signatures)
	end 'unboundRequirementResultType'

	// ⭐⭐ **WHAT THE RECEIVER'S `with` ARGUMENTS SAY THIS ASSOCIATED-TYPE RETURN IS.** `current()` on a
	// `Cursor with Element` hands back an `Element`, and the fallback below this arm hands back
	// `named("Element")` — the interface's own PLACEHOLDER read as if it were a type the program declares.
	// Where the receiver still knows its instantiation, this is the answer instead: the argument that
	// instantiation bound at the requirement's own associated POSITION.
	//
	// ⛔⛔ **THE POSITION IS DERIVED FROM THE INTERFACE'S `uses` LIST, NOT ASSUMED TO BE ZERO**. Taking
	// `args[0]` flat is right by luck for `Iterable uses Element, Iter` and silently the wrong
	// argument for a requirement returning `Iter`, whose `Iter` argument sits at index 1.
	// `positionOfName` is the same numbering the held arm above uses.
	//
	// ⚠ **AND IT IS A PER-VALUE ANSWER, NEVER A WHOLE-PROGRAM ONE, WHICH THE HOLDINGS RECORD ONE ARM UP IS.**
	// A holding is unique because E3125 refuses a second site claiming another; an ARGUMENT is not — a shared
	// generic body's `Iterator with Element` and a user's `Iterator with Integer` are both legal, in one
	// program, and keying either by `(interface, position)` would give one of the two loops the other's element
	// type. That is why this reads the receiver and `associatedTypeHeldAt` reads the program.
	//
	// The two guards are `heldAssociatedReturnOf`'s, for its reasons: a requirement projected from a PARENT is
	// numbered against a list that is not this interface's, and a site binding fewer arguments than the
	// interface declares is E3016's to report and claims nothing here.
	function associatedReturnThroughReceiverInstance(target WitnessDispatchTarget, claim ExistentialClaim) returns MaxonType throws MapError
		let dispatched = self.signatures.interfaceNameAtDeclIndex(target.interfaceDeclIndex)

		if not target.declaringInterfaceName.equals(dispatched) 'aProjectedParentRequirement'
			throw MapError.keyNotFound
		end 'aProjectedParentRequirement'

		match lookupInterface(self.signatures.interfaceMap(), name: dispatched) 'base'
			notFound then throw MapError.keyNotFound
			found(iface) then return try self.instanceBoundAssociatedType(claim, iface: iface, requirement: target.returnType)
		end 'base'
	end 'associatedReturnThroughReceiverInstance'

	// The two lookups the answer above is, over a resolved interface — split out for `heldAssociatedReturnIn`'s
	// reason: the `found` arm of a `lookupInterface` match is a call in every reader of this file, never a body.
	//
	// ⚠ The argument crosses out of the INDEX's interner through `resolvedSlotType`, exactly as
	// `slotTypeThroughReceiver` crosses a substituted field type — an `adoptType` alone would leave a
	// sweep-recorded `named` leaf that reads as an integer (see that door).
	function instanceBoundAssociatedType(claim ExistentialClaim, iface IrInterface, requirement RequirementType) returns MaxonType throws MapError
		let position = try associatedPositionIn(requirement, iface: iface, signatures: self.signatures)

		if position >= self.signatures.genericInstanceArgCount(claim.instance) 'boundNothingHere'
			throw MapError.keyNotFound
		end 'boundNothingHere'

		return self.signatures.declaredSlotType(self.signatures.substitutedInstanceArg(claim.instance, position: position), into: self.artifact.typeNames, slotScopeFilePath: claim.scopeFilePath)
	end 'instanceBoundAssociatedType'

	// ⭐⭐ **WHAT THE RECEIVER'S OWN `where` CONSTRAINT SAYS THIS ASSOCIATED-TYPE RETURN IS** — the
	// constrained-type-parameter twin of `associatedReturnThroughReceiverInstance`, and the reason
	// `where Source is Iterator with Element` exists at all. `source.current()` inside a shared generic body
	// dispatches through a receiver whose TYPE is a parameter; without the constraint's binding the fallback
	// hands back `named("Element")` — the interface's own PLACEHOLDER read as if it were a type the program
	// declares — and a tuple built from it is a different tuple type from the declared one (E3005).
	//
	// The two guards are `associatedReturnThroughReceiverInstance`'s, for its reasons: a requirement projected
	// from a PARENT is numbered against a list that is not this interface's, and a constraint binding fewer
	// arguments than the interface declares claims nothing at the positions past them.
	function associatedReturnThroughConstraintBinding(target WitnessDispatchTarget, receiver ValueId) returns MaxonType throws MapError
		if self.tagOf(receiver) != ValueTypeTag.typeParameter 'notAConstrainedParameter'
			throw MapError.keyNotFound
		end 'notAConstrainedParameter'

		let dispatched = self.signatures.interfaceNameAtDeclIndex(target.interfaceDeclIndex)

		if not target.declaringInterfaceName.equals(dispatched) 'aProjectedParentRequirement'
			throw MapError.keyNotFound
		end 'aProjectedParentRequirement'

		match lookupInterface(self.signatures.interfaceMap(), name: dispatched) 'base'
			notFound then throw MapError.keyNotFound
			found(iface) then return try self.constraintBoundAssociatedType(receiver, iface: iface, requirement: target.returnType)
		end 'base'
	end 'associatedReturnThroughConstraintBinding'

	// The two lookups the answer above is — `instanceBoundAssociatedType`'s shape over the constraint list
	// rather than over an instance's arguments, split out for `heldAssociatedReturnIn`'s reason.
	function constraintBoundAssociatedType(receiver ValueId, iface IrInterface, requirement RequirementType) returns MaxonType throws MapError
		let position = try associatedPositionIn(requirement, iface: iface, signatures: self.signatures)
		let bindings = constrainedParamAssociatedBindings(self.signatures, token: self.valueTypeParamId(receiver), interfaceName: iface.name)

		if position >= bindings.count() 'boundNothingHere'
			throw MapError.keyNotFound
		end 'boundNothingHere'

		return resolvedBindingType(try bindings.get(position) otherwise panic("constraintBoundAssociatedType: bindings.get OOB at {position} below count {bindings.count()}"), typeNames: self.artifact.typeNames, signatures: self.signatures)
	end 'constraintBoundAssociatedType'

	// The OWNER type's file, not this call's: a `where` clause is stored only from the type
	// declaration, while the dispatch may be written in an extension in another file.
	function constrainedParamDeclFilePath(receiver ValueId) returns FilePath
		let owner = try self.signatures.typeParamOwnerOf(self.valueTypeParamId(receiver)) otherwise panic("constrainedParamDeclFilePath: v{receiver}'s type parameter has no owner, yet its owner's `where` clause bound this dispatch's result")

		return match self.signatures.structInAnyFile(owner.declaringTypeName) 'owner'
			declared(layout) gives layout.declFilePath
			undeclared panic("constrainedParamDeclFilePath: no `type {String.from(owner.declaringTypeName)}` is declared, yet its `where` clause bound this dispatch's result — `structWhereConstraints` read that declaration under the same key")
		end 'owner'
	end 'constrainedParamDeclFilePath'

	// ⭐⭐ **IS THIS DISPATCH'S RESULT AN ASSOCIATED TYPE THE PROGRAM HOLDS AT AN INTERFACE?** — the position
	// within the DISPATCHED interface's own `uses` names, plus the interface it is held at, or
	// `MapError.keyNotFound` for every ordinary return (which is every return in a program that writes no
	// interface as a `with` argument, so the common path is one map probe on a name).
	//
	// ⚠⚠ **THE REQUIREMENT'S DECLARING INTERFACE MUST BE THE DISPATCHED ONE, AND CHECKING THAT IS NOT
	// PEDANTRY.** `methodIndex` is numbered against the DISPATCHED interface's transitive slot list, so a
	// requirement declared on a PARENT is dispatched through the CHILD's table — while the associated type it
	// names is the parent's, at a position in the PARENT's `uses` list. Associated types do not project
	// through `extends` (`checkOneInterfaceConformance` records `Sub` with an empty `associatedTypeNames`),
	// so the two lists are unrelated and a same-spelled name at the same index in both would load the child's
	// slot for the parent's position — a witness for the wrong conformance, silently. Refused rather than
	// guessed: the answer is `notHeld`, which leaves the return typed as the interface declares it.
	function heldAssociatedReturnOf(target WitnessDispatchTarget) returns HeldAssociatedReturn throws AbsentError
		let dispatched = self.signatures.interfaceNameAtDeclIndex(target.interfaceDeclIndex)

		if not target.declaringInterfaceName.equals(dispatched) 'aProjectedParentRequirement'
			throw AbsentError.absent
		end 'aProjectedParentRequirement'

		match lookupInterface(self.signatures.interfaceMap(), name: dispatched) 'base'
			notFound then throw AbsentError.absent
			found(iface) then return try self.heldAssociatedReturnIn(iface, requirement: target.returnType)
		end 'base'
	end 'heldAssociatedReturnOf'

	// The two lookups the answer above is, over a resolved interface — split out because the `found` arm of a
	// `lookupInterface` match is a call in every reader of this file, never a body.
	function heldAssociatedReturnIn(iface IrInterface, requirement RequirementType) returns HeldAssociatedReturn throws AbsentError
		let position = try associatedPositionIn(requirement, iface: iface, signatures: self.signatures) otherwise throw AbsentError.absent
		return HeldAssociatedReturn.create(try self.signatures.associatedTypeHeldAt(iface.name, position: position), slotOffset: witnessAssociatedSlotOffset(self.witnessSlotsOf(iface).count() as WitnessMethodIndex, position: position), position: position)
	end 'heldAssociatedReturnIn'

	// ⭐⭐ **THE VALUE HALF COMES FROM THE CALL AND THE WITNESS HALF FROM THE TABLE THE CALL WAS DISPATCHED
	// THROUGH.** The impl returns its own concrete cursor in the one result register a witness call has; the
	// table to widen that cursor into an existential is a fact about the RECEIVER'S conformer, and the
	// receiver's own witness table is where its mint put it (`LowerMaxonToStd.stampAssociatedWitnessSlots`).
	// So the second word is a load plus an add, and nothing about the call's ABI changes.
	//
	// ⚠ The slot holds a distance from the table's own base, not an address — see
	// `GlobalDataTable.PendingRdataSelfRelReloc` for why `.rdata` cannot point at itself, and why the add is a
	// WRAPPING machine-word add (the distance is signed).
	//
	// ⚠ **`target.witnessValue` AND NOT `witnessOfValue(receiver)`**: the receiver of a witness dispatch is
	// either an existential or a value of a CONSTRAINED TYPE PARAMETER, and only the first has a paired
	// witness half. The table address is what this needs and `witnessValue` is it for both, which is the whole
	// reason `WitnessDispatchTarget` names a value rather than a constraint.
	function mintHeldAssociatedWitnessResult(target WitnessDispatchTarget, held HeldAssociatedReturn, receiver ValueId, methodTok Token) returns ValueId
		let range = SourceRange.ofToken(methodTok)
		let distance = self.emitIndirectLoad(MaxonType.integer, box: target.witnessValue, offset: held.slotOffset, storageType: MaxonType.integer, range: range)
		let nested = self.emitMachineWordBinOp(target.witnessValue, rhs: distance, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)
		let result = self.mintOwnedCallResult(MaxonType.interfaceRef(self.artifact.typeNames.intern(held.heldAt)), scopeFilePath: CompilerOwnedDeclFilePath)
		self.pairInterfaceWitness(result, witness: nested)

		// ⭐⭐ **THE HELD VALUE INHERITS THE `with` ARGUMENTS THE RECEIVER BOUND AT THIS POSITION** — the
		// second half of the chain `for item in <an Iterable>` walks, and without it the first half buys
		// nothing. `createIterator()` hands back a `Cursor` existential whose own `Element` is bound by the
		// SOURCE's instantiation (`Bag with (Element, Cursor with Element)`), not by anything the cursor's type
		// can say; carried here, `current()` on it resolves through the arm one function up. A receiver with no
		// instantiation to inherit from — a bare `Bag` parameter — passes nothing on, which is correct: it
		// bound nothing.
		if let receiverClaim = try self.existentialClaimOfValue(receiver) 'theReceiverKnowsItsArguments'
			if let heldInstance = try self.signatures.instanceArgHeldInstance(receiverClaim.instance, position: held.position) 'thatArgumentIsItselfInstantiated'
				self.recordValueExistentialInstance(result, claim: ExistentialClaim.create(heldInstance, scopeFilePath: receiverClaim.scopeFilePath))
			end 'thatArgumentIsItselfInstantiated'
		end 'theReceiverKnowsItsArguments'

		return result
	end 'mintHeldAssociatedWitnessResult'

	// ⭐ **A `Self`-RETURNING REQUIREMENT HANDS BACK THE RECEIVER'S OWN TYPE, AND EACH RECEIVER SPELLS THAT
	// DIFFERENTLY.**
	//
	//   • a CONSTRAINED TYPE PARAMETER: the receiver's `T`, opaque exactly as the receiver is.
	//   • an EXISTENTIAL: the SAME interface — and, crucially, the same WITNESS. `Self` means the conformer's
	//     own type, so the value coming back has the receiver's dynamic type and therefore the receiver's
	//     table. That is why this needs no second return register and no interface-returning ABI: the witness
	//     half is already in hand, so the result is paired with it and the callee returns one word, exactly as
	//     a concrete `Self`-returning impl does.
	function mintSelfReturnedWitnessResult(receiver ValueId) returns ValueId
		if self.tagOf(receiver) != ValueTypeTag.interfaceRef 'constrainedTypeParameter'
			return self.mintOwnedCallResult(MaxonType.typeParameter(self.valueNameId(receiver) as TypeParamId), scopeFilePath: CompilerOwnedDeclFilePath)
		end 'constrainedTypeParameter'

		let result = self.mintOwnedCallResult(MaxonType.interfaceRef(self.valueNameId(receiver)), scopeFilePath: CompilerOwnedDeclFilePath)
		self.pairInterfaceWitness(result, witness: self.witnessOfValue(receiver))
		return result
	end 'mintSelfReturnedWitnessResult'

	// The result type of a synthesized-protocol direct call (`emitBuiltinConformanceCall`,
	// `emitByteRecordOrdering`), lifted as its compiler-owned interface sees it: a program alias of
	// the same name is range-checked against rather than inherited.
	function interfaceReturnMaxonType(requirement RequirementType) returns MaxonType
		return self.repairSweptType(resolvedRequirementType(requirement, typeNames: self.artifact.typeNames, signatures: self.signatures), scopeFilePath: CompilerOwnedDeclFilePath)
	end 'interfaceReturnMaxonType'

	// The token shape of a method call on an ARRAY FIELD reached through a field chain — `<base>(.<field>)+
	// .<method>(` with AT LEAST TWO dots (a one-dot `b.m(…)` is `methodCallsAt`'s). `resolveFieldChainFrom`
	// stops the chain at the array field, so the last hop is the method. The base must be a live local (or a
	// captured enclosing struct), the same gate `methodCallsAt` uses.
	function fieldChainMethodCallAt(index ElementIndex) returns bool
		let chainEnd = self.fieldChainEndAfter(index, minHops: ChainMethodMinHops)

		if chainEnd == index or self.kindAt(chainEnd) != TokenKind.leftParen 'notChainMethod'
			return false
		end 'notChainMethod'

		// ASK THE SHARED DOOR. Re-deriving `valueBaseAt`'s test by hand loses its `Self`
		// guard: `fieldChainEndAfter` bases the chain test on `tokenCanBeAName`, which ADMITS
		// `TokenKind.selfType`, and `baseBindingName` special-cases only `TokenKind.self` — so with a
		// parameter legally bound under the literal name `Self`, a `Self.field.method(…)` chain reads as
		// naming a VALUE base here while the other three doors read it as the TYPE.
		return self.chainBaseNamesAValue(index)
	end 'fieldChainMethodCallAt'

	// The token index just PAST a field-access chain starting at `index` — a `base` (an identifier or
	// `self`) followed by `.field` hops — or `index` itself when the tokens there are not such a chain
	// with at least `minHops` hops.
	//
	// THE ONE WALK over that shape, shared by every door that asks it, so one chain shape is one answer
	// everywhere. `cellArgumentAnchorAt` predicts the same shape at a cursor this walk's askers do not hold,
	// and is bound to `namesMemberAt` for that reason.
	function fieldChainEndAfter(index ElementIndex, minHops FieldHopCount) returns ElementIndex
		// The base is anything `tokenCanBeAName` admits — which subsumes the identifier and the `self` keyword,
		// and adds a KEYWORD-named binding. One predicate for the base
		// exactly as `namesMemberAt` is one for the hop, and for the header's reason.
		if not tokenCanBeAName(self.tokenAt(index)) 'notABase'
			return index
		end 'notABase'

		var q = index + 1
		var hops = 0 as FieldHopCount

		while self.kindAt(q) == TokenKind.dot and self.namesMemberAt(q + 1) 'hop'
			hops = hops + 1
			q = q + 2
		end 'hop'

		return q if hops >= minHops else index
	end 'fieldChainEndAfter'

	// Resolve a field chain to the field the trailing call's RECEIVER is, and apply that call — an ARRAY
	// field's method (`b.ops.push(1)`), a nested STRUCT field's method (`o.inner.get()`), a FUNCTION-typed
	// field's indirect call (`o.inner.op()`, #97), an opaque `T` field's witness dispatch
	// (`self.item.digest()`) or a builtin conformer's (`o.count.hash()`). Shared by the STATEMENT form
	// (`resultUsed: false`) and the `try`-TARGET form (`try self.nodes.get(i) otherwise …`),
	// which leaves the throwing `call __managed_get` as the last op for `rewriteLastCallToTryCall`.
	//
	// ⭐ **IT ADDS EXACTLY ONE THING TO THE POSTFIX LOOP: THE CHAIN'S BASE NAME.** `resolveFieldChainFrom`
	// stops before the `.member(`, so the receiver is an ordinary value and every dispatch decision is
	// `dispatchMethodOnReceiver`'s — this door exists only because the chain's base IS a name, which the
	// blame name and the storage subject are read off. A postfix receiver in expression
	// position has no such name and passes the empty one (`valueReceiver`). Further hops past the first
	// (`o.inner.get().bump()`) are the postfix loop's, unnamed like every other temporary.
	function parseFieldChainCall(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		// The chain's BASE token, captured before the chain is resolved — it is the only thing that can
		// name the storage a write through this receiver reaches.
		let baseIndex = self.pos
		let operandStart = self.bodyState.operandOrder.eventCount()
		let receiver = try self.parseFieldAccess(func)
		let subjectName = self.storageSubjectNameAt(baseIndex)
		return try self.parsePostfix(func, operandStart: operandStart, value: try self.dispatchMethodOnReceiver(func, recv: self.valueReceiver(receiver, immutableName: self.fieldChainImmutableNameAt(baseIndex), subjectName: subjectName), resultUsed: resultUsed), resultUsed: resultUsed)
	end 'parseFieldChainCall'

	// ⭐ **WHICH ROSTER ANSWERS FOR THIS SURFACE** — the ONE place a member list is picked, so every
	// dispatcher's gate, the refusal it throws and the drift panic at its fall-through all read the same
	// answer. It is keyed on the SURFACE rather than the value being dispatched because `dispatchArrayMethod`
	// decides `buffer` vs `array` for one record (`SignatureIndex.ManagedMemoryTypeName`).
	//
	// A roster is built on this file's FIRST call into its surface and held after, because building one allocates
	// and most files call into few surfaces; identity with `ParserAnchors.surfaceRoster` is the has-it-been-built
	// gate. The arms differ only in which field they fill, which Maxon cannot abstract: there is no way to hand a
	// function the field to populate, so the alternative to six arms in one home is six homes.
	function surfaceMemberNames(surface MemberSurface) returns NameRoster
		if surface == MemberSurface.buffer 'bufferSurface'
			if self.bufferSurfaceRoster is self.anchors.surfaceRoster 'firstBufferCallInThisFile'
				self.bufferSurfaceRoster = bufferSurfaceMemberNames()
			end 'firstBufferCallInThisFile'

			return self.bufferSurfaceRoster
		end 'bufferSurface'

		if surface == MemberSurface.array 'arraySurface'
			if self.arraySurfaceRoster is self.anchors.surfaceRoster 'firstArrayCallInThisFile'
				self.arraySurfaceRoster = arraySurfaceMemberNames()
			end 'firstArrayCallInThisFile'

			return self.arraySurfaceRoster
		end 'arraySurface'

		if surface == MemberSurface.string 'stringSurface'
			if self.stringSurfaceRoster is self.anchors.surfaceRoster 'firstStringCallInThisFile'
				self.stringSurfaceRoster = stringSurfaceMemberNames()
			end 'firstStringCallInThisFile'

			return self.stringSurfaceRoster
		end 'stringSurface'

		if surface == MemberSurface.character 'characterSurface'
			if self.characterSurfaceRoster is self.anchors.surfaceRoster 'firstCharacterCallInThisFile'
				self.characterSurfaceRoster = characterSurfaceMemberNames()
			end 'firstCharacterCallInThisFile'

			return self.characterSurfaceRoster
		end 'characterSurface'

		if surface == MemberSurface.stringIndex 'stringIndexSurface'
			if self.stringIndexSurfaceRoster is self.anchors.surfaceRoster 'firstStringIndexCallInThisFile'
				self.stringIndexSurfaceRoster = stringIndexSurfaceMemberNames()
			end 'firstStringIndexCallInThisFile'

			return self.stringIndexSurfaceRoster
		end 'stringIndexSurface'

		if surface == MemberSurface.cursor 'cursorSurface'
			if self.cursorSurfaceRoster is self.anchors.surfaceRoster 'firstCursorCallInThisFile'
				self.cursorSurfaceRoster = cursorSurfaceMemberNames()
			end 'firstCursorCallInThisFile'

			return self.cursorSurfaceRoster
		end 'cursorSurface'

		panic("surfaceMemberNames: no roster for a `MemberSurface` this function does not cover — a surface added to the enum without one, which every gate reading it would then answer for by falling through")
	end 'surfaceMemberNames'

	// ⭐⭐ **THE ROSTER GATE ITSELF — ONE HOME FOR EVERY DISPATCH.** "Does this
	// surface have this member?" is asked ahead of every arm of every `dispatch*Method` that carries a roster
	// — one per `MemberSurface`, and the enum is the list rather than a sentence here naming some of them
	// (a sentence here naming some of them goes short the moment one is added) — because it is the question
	// the call presupposes. See `dispatchArrayMethod` for the two measured spellings that made the ORDER
	// matter as much as the test.
	//
	// ⚠ Written out per dispatcher it is four copies of one rule — fetch, membership test,
	// `throw SourceParseError.unsupported(…)` with the surface's sentence inline — differing only in the enum
	// value, and a new surface copies whichever neighbour it happens to read. The roster comes back so the
	// caller's drift panic names the same list this gate admitted from.
	//
	// ⚠ **THE ROSTER IS THE SURFACE'S AND THE NOUN IS THE VALUE'S, WHICH IS WHY ONLY THE NOUN IS A
	// PARAMETER.** Picking the list and testing the name are keyed on the surface alone — which is what lets
	// the receiverless `String.from` STATIC door share this gate. What the surface cannot supply is the TYPE
	// the refusal is shown about: the array surface serves every `BuiltinArrayLiteral` conformer the program
	// declares, so a constant named here would be a type the
	// receiver need not be. A NAME is not a receiver — nothing here resolves,
	// and no caller has to hold a value it did not already have.
	function requireSurfaceMember(surface MemberSurface, typeName ByteArray, methodTok Token) returns NameRoster throws SourceParseError
		let roster = self.surfaceMemberNames(surface)

		if not roster.contains(methodTok.value) 'notASurfaceMember'
			try self.refuseMemberTheSweepDropped(typeName, methodTok: methodTok)
			throw SourceParseError.unsupported(rosterRefusalSentence(typeName, member: methodTok.value, roster: roster, noun: SurfaceMemberNoun), line: methodTok.line, column: methodTok.column)
		end 'notASurfaceMember'

		return roster
	end 'requireSurfaceMember'

	// ⭐⭐ **THE SECOND THING THE ROSTER SENTENCE CANNOT WORD: THE MEMBER IS DECLARED AND THE INDEX LOST IT.**
	// A surface's roster is derived from the dispatch arms, so *"that list IS the surface"* is always true
	// about the SURFACE — and useless to a reader looking at a corpus declaration that plainly has the member.
	// This is `refuseArrayMemberTheOtherDeclarationCarries`' shape one door up, for its reason and about a
	// different subject: not *which* `Array` the value has, but whether the compiler ever managed to read the
	// declaration it is refusing.
	//
	// ⚠ **IT IS DEAD FOR EVERY HEALTHY COMPILE, and the emptiness test is what makes it free.** A drop is a
	// compiler bug (`SignatureIndex.DroppedSignature`), so the map is empty in every program that compiles and
	// in every program refused for a reason of its own.
	//
	// ⚠⚠ **THE KEY IS `declaredMethodName`'s SPELLING — THE ONE THE SWEEP FILED UNDER — AND THIS DOOR IS HANDED
	// A DIFFERENT ONE UNDER A CONTEST (found in review).** `recordScannedSignature` files the drop under
	// `qualifiedMethodName(self.enclosingType, …)`, i.e. under this compile's MINT for the receiver's
	// declaration; the `Array` caller passes `arrayReceiverDeclaredName`, which deliberately answers the
	// PRE-CONTEST source spelling so a refusal never quotes `__Array` at a reader. The two are EQUAL for
	// every uncontested compile — which is every compile in the corpus — and diverge only in a program that
	// declares its own `type Array`, where the lookup would then miss and this refusal would go dark, falling
	// back to the roster sentence it exists to replace. That is one fact in two spellings with nothing holding
	// them together, and it is named here rather than repaired because repairing it means deciding which
	// spelling a drop record is keyed by — a question `refuseArrayMemberTheOtherDeclarationCarries` one door
	// down already owns for the refusal, and which no program in the corpus can currently ask.
	function refuseMemberTheSweepDropped(typeName ByteArray, methodTok Token) throws SourceParseError
		if not self.signatures.hasDroppedSignatures() 'nothingWasDropped'
			return
		end 'nothingWasDropped'

		let qualified = qualifiedMethodName(typeName, methodName: methodTok.value)

		match self.signatures.droppedSignatureOf(qualified) 'lookup'
			none then return
			dropped(record) then throw SourceParseError.droppedSignature(String.from(qualified), declaredIn: "{record.filePath}", declLine: record.nameLine, declColumn: record.nameColumn, line: methodTok.line, column: methodTok.column)
		end 'lookup'
	end 'refuseMemberTheSweepDropped'

	// ⭐⭐ **WHAT AN ARRAY RECEIVER'S DECLARATION IS CALLED IN SOURCE** — the noun the roster refusal is
	// shown about. It is the instance's base name in every case but one: under a contest the corpus's
	// declaration is keyed under this compile's MINT, and a refusal quoting `__Array` would send the reader to
	// a spelling `requireUnreservedName` forbids them from writing — the same rule
	// `twoArrayDeclarationsRefusal` states one level down, applied to the one door that can meet a value of
	// either declaration.
	//
	// ⚠ The two names are EQUAL for every uncontested compile, which is the whole corpus, so the test is one
	// comparison and the answer is the base name.
	function arrayReceiverDeclaredName(giid GenericInstanceId) returns immutable ByteArray
		let base = self.signatures.genericInstanceBaseName(giid)
		return self.signatures.arrayRecordDeclaredName() if base.equals(self.signatures.arrayRecordBaseName()) else base
	end 'arrayReceiverDeclaredName'

	// ⭐ **NAME THE ARRAY READ THIS ARM JUST LOWERED, FOR E3064's SUBJECT** (`lastRuntimeRead*`). Threaded
	// around the emit so an arm stays one `return`.
	//
	// ⚠ **THE BUFFER SURFACE IS EXCLUDED, exactly as `requireArmServedIndexArgument` excludes it, and
	// for a reason of its own: THERE IS NO MEMBER TO NAME.** `count`/`length` and `get` share one arm
	// and one runtime entry with the buffer's spellings, and the receiver's GIID is the array's either
	// way — so a buffer read would be reported as `Array.length`, a member no reference declares and
	// no author wrote. The reference cannot judge these at all (it answers E3067, `_ =` wanting a call
	// where a buffer member is an op), so declining leaves a missed diagnostic rather than a wrong
	// one.
	function noteArrayReadMember(result ValueId, giid GenericInstanceId, methodTok Token, bufferSurface bool) returns ValueId
		if bufferSurface 'theCompilersOwnNameForARecord'
			return result
		end 'theCompilersOwnNameForARecord'

		self.noteRuntimeReadMember(result, typeName: self.arrayReceiverDeclaredName(giid), methodName: methodTok.value)
		return result
	end 'noteArrayReadMember'

	// ⭐⭐ **THE `Array` ROSTER REFUSAL IS A WRONG ANSWER IN EXACTLY ONE PROGRAM, AND THIS IS IT.** When a
	// user program declares its own `type Array` the compile holds TWO `Array` declarations — the user's under
	// the bare name, `stdlib/Array.maxon`'s under this compile's mint — and a member call resolves against the
	// RECEIVER's own (`memberBelongsToTheCorpus`). So `s.toByteArray().at(0)`, in a program whose own `type
	// Array` declares `at`, met *"`Array` member 'at' — the compiler provides managed/get/…; that list IS the surface,
	// so nothing else is served here"*: every clause of it TRUE about the synthesized surface, and every clause
	// of it unhelpful to a reader whose declaration two lines up plainly has `at`.
	//
	// ⚠ **IT IS A SECOND GATE AND NOT A CLAUSE ON THE FIRST, because the two ask different questions of
	// different subjects.** `requireSurfaceMember` is keyed on a SURFACE and holds no receiver — deliberately,
	// and that is what lets every surface share it. This one is about which DECLARATION a value has, which only
	// an `Array` receiver can be asked. Threading a receiver through the shared gate to serve one surface is how
	// the shared gate stops being shared.
	//
	// It is DEAD for every program in the corpus: `IrInterfaceMap.hasLibraryRenames` is false unless
	// something is contested, which is the one gate every cost of that mechanism sits behind.
	function refuseArrayMemberTheOtherDeclarationCarries(giid GenericInstanceId, methodTok Token, isManagedMemory bool) throws SourceParseError
		// A BUFFER receiver is refused in the buffer's own words and has no second declaration to be confused
		// with — `__ManagedMemory` is the compiler's own name and no file declares a member on it.
		if isManagedMemory or not self.signatures.interfaceMap().hasLibraryRenames() 'oneArrayDeclarationInThisCompile'
			return
		end 'oneArrayDeclarationInThisCompile'

		let roster = self.surfaceMemberNames(MemberSurface.array)

		if roster.contains(methodTok.value) 'theSynthesizedSurfaceServesIt'
			return
		end 'theSynthesizedSurfaceServesIt'

		// The receiver's own declaration has already been asked and declined (`memberBelongsToTheCorpus` runs
		// ahead of this dispatcher), so any declaration that carries the name here is by construction the other.
		let receiversOwn = self.signatures.genericInstanceBaseName(giid)

		// ⛔⛔ **THIS SENTENCE IS ABOUT TWO `Array`s, SO A RECEIVER THAT IS NEITHER MAY NOT BE HANDED IT** —
		// found in review, and it is the cure one door up applied everywhere EXCEPT its own twin. The gate
		// above asks only whether a CONTEST exists; the array surface serves every
		// `BuiltinArrayLiteral` conformer, so in a program holding `type Array` AND a `Bag`, a **`Bag`**
		// receiver reached here and was told *"this value's type is the `Array` the standard library
		// declares"*. `receiverIsTheProgramsOwn` is then `false` for the WRONG REASON, so it takes the library
		// arm and the whole sentence frame is false — not merely its noun, which is why passing
		// `arrayReceiverDeclaredName` here would fix the first word and leave the claim.
		//
		// A conformer of another name falls through to the roster refusal, which names the receiver's own
		// type, `Bag`. That refusal is the right one: it states what the SURFACE serves, and the
		// surface is exactly what such a receiver has.
		if not receiversOwn.equals(self.signatures.arrayRecordDeclaredName()) and not receiversOwn.equals(self.signatures.arrayRecordBaseName()) 'receiverIsNeitherArrayDeclaration'
			return
		end 'receiverIsNeitherArrayDeclaration'

		for declaration in self.arrayDeclarationNames() 'eachArrayDeclaration'
			if not declaration.equals(receiversOwn) and self.signatures.declaresCallee(qualifiedMethodName(declaration, methodName: methodTok.value)) 'theOtherDeclarationCarriesIt'
				throw SourceParseError.unsupported(twoArrayDeclarationsRefusal(self.signatures.arrayRecordDeclaredName(), member: methodTok.value, roster: roster, receiverIsTheProgramsOwn: receiversOwn.equals(self.signatures.arrayRecordDeclaredName())), line: methodTok.line, column: methodTok.column)
			end 'theOtherDeclarationCarriesIt'
		end 'eachArrayDeclaration'
	end 'refuseArrayMemberTheOtherDeclarationCarries'

	// ⭐⭐ **A SIZED CONTAINER'S BUFFER MAY NOT BE HANDED A MEMBER THAT MOVES ITS LENGTH.** The sibling
	// above's twin, placed at the same point in `dispatchArrayMethod` and for the same stated reason: it is
	// still the question *"does this member exist ON THIS RECEIVER?"*, answered more precisely for the one
	// receiver that can tell two answers apart. Here the two answers are the two places a container's COUNT
	// comes from — an `Array`'s record, a `FixedArray`'s type — and `sizedContainersBufferRefusal` carries the
	// argument in full.
	//
	// ⭐⭐ **IT IS CALLED FROM TWO SITES BECAUSE THE BARE-`managed` ROUTE REACHES NO VALUE, AND ONE OF THEM
	// PASSES THE ANSWER OFF THE ENCLOSING DECLARATION INSTEAD OF OFF A MARK.** A bare `managed.<member>(…)`
	// inside an `extension FixedArray` never reaches this dispatcher's value at all — which is true of EVERY
	// member —
	// `dispatchMethodOnBinding`'s `inlineManagedServesTheRecord` hands over the
	// RECEIVER's own record, minting nothing, so there is no value to mark; and the `giid` it hands over is
	// the buffer's, which the load-bearing retype spells `Array with Element` for a fixed array too, so no
	// `giid` test can tell a fixed array's record from a growable array's either. That site therefore asks
	// `declarationIsASizedContainerRecordNamed` of `enclosingType` — the BY-NAME form, which exists for
	// exactly that shape of caller — and calls THIS function, so the two routes are one refusal and one
	// sentence rather than two spellings of it. See `sizedContainerBufferValues` for the carrier the other
	// route reads.
	//
	// ⛔ **THE OBVIOUS COLLAPSE — READ THE MARK *OR* THE ENCLOSING DECLARATION — IS A MEASURED WRONG
	// ANSWER**, not merely a wider one: inside an `extension FixedArray` a `try managed.slice(0, 2)` bound to a
	// local has the fixed array's declared buffer type and is NOT the fixed array's record, so an `enclosingType`
	// disjunct at the VALUE site would refuse `s.clear()` on a slice. One value, one operation, two answers
	// — the exact defect the per-value mark exists to prevent. That is why `onASizedContainersRecord`
	// crosses the boundary as an ANSWER rather than as the evidence each caller derived it from.
	//
	// ⚠ It asks the length-writer list only AFTER the receiver test, so the roster it validates against is
	// built once per member call inside a sized container's body and never in any other program.
	function refuseLengthChangeOnASizedContainersBuffer(methodTok Token, onASizedContainersRecord bool) throws SourceParseError
		if not onASizedContainersRecord 'anOrdinaryBuffer'
			return
		end 'anOrdinaryBuffer'

		let lengthWriters = bufferLengthWritingMemberNames(self.surfaceMemberNames(MemberSurface.buffer))

		if not lengthWriters.contains(methodTok.value) 'itLeavesTheRecordsLengthAlone'
			return
		end 'itLeavesTheRecordsLengthAlone'

		throw SourceParseError.unsupported(sizedContainersBufferRefusal(methodTok.value, lengthWriters: lengthWriters, growableName: self.signatures.arrayRecordDeclaredName()), line: methodTok.line, column: methodTok.column)
	end 'refuseLengthChangeOnASizedContainersBuffer'

	function admitArrayCopy(recv MethodReceiver) throws SourceParseError
		if not self.signatures.isArrayInstanceAt(recv.tag, nameId: recv.nameId) 'notAnArray'
			return
		end 'notAnArray'

		let member = self.current()

		if not member.value.equals(CloneMethodName) and not member.value.equals(SliceMethod) 'notACopyingMember'
			return
		end 'notACopyingMember'

		let instance = recv.nameId as GenericInstanceId

		if not self.signatures.containerElementIsOpaque(instance) 'aConcreteElement'
			try self.requireCloneCopiesNoGreenThread(self.signatures.sourceCloneVerdictOfType(MaxonType.genericInstance(instance)), subject: "`{self.valueDisplayTypeName(recv.value)}`", memberTok: member)
		end 'aConcreteElement'

		self.signatures.noteArrayCopyDemanded(instance)
	end 'admitArrayCopy'

	// ⭐⭐⭐ **DOES THE CORPUS DECLARE THIS MEMBER? — THE DOOR THAT MAKES A LISTED `stdlib/String.maxon` MEAN
	// SOMETHING.** A roster is the compiler's statement of what its SYNTHESIZED surface serves; it is not the whole
	// answer once `type String` and
	// `type Character` are listed. Those declarations carry members the roster does not have —
	// `Character.toString()` is one — and the refusal for them would be
	// *"the compiler provides bytes/byteLength/asciiValue; that list IS the surface"*, which is false: the
	// program HAS a `Character.toString`, written in Maxon, sitting in a module this compiler loaded.
	//
	// ⇒ **A byte-record receiver asks the CORPUS before it is refused**, and a hit becomes an ordinary
	// qualified call to an ordinary declared function. That is the retirement mechanism in one door: every
	// member the corpus declares and the compiler does not is served from source, with no arm, no runtime graph and
	// no roster entry — and the members the compiler DOES serve keep their arms, because the roster is asked first.
	//
	// ⚠ **ORDER IS THE DESIGN, NOT AN OPTIMISATION.** The roster wins, so `s.byteLength()` still lowers to a
	// field load rather than calling the corpus body that would do the same thing more slowly, and
	// `s.hash()`/`s.equals()` still reach the synthesized conformance impls a witness slot is stamped with.
	// Retiring an arm is therefore a DELETION from the roster and nothing else — the corpus catches it here,
	// which is what makes the retirement incremental and measurable one member at a time.
	//
	// ⭐⭐ **AND IT IS ASKED FOR TWO RECEIVER KINDS, NOT ONE.** `StringIndex` is asked too: the
	// corpus's `type StringIndex` (`stdlib/String.maxon:931`) declares `equals` and `compare` as well as the two
	// accessors the compiler serves — it `implements Equatable, Comparable` — so the roster refusal would be the very
	// sentence this door exists to retire: **MEASURED without the arm, `d.equals(e)` on two indices reported
	// `E2015 … 'equals' — the compiler provides charIndex/bytePos; that list IS the surface`** about a method the
	// program plainly has. The two accessors keep their arms (roster wins, for the field-load reason
	// `dispatchStringIndexMethod` states); everything else the corpus declares is served from source.
	// ⭐⭐⭐ **AND THE `Array` SURFACE IS THE THIRD ASKER, AND IT NEEDS A SECOND DOOR TO BE ONE.** The
	// instance test is `isArrayInstanceAt(recv.tag, nameId: recv.nameId)` — a question about the TYPE, which
	// is all that ADMITTING an `Array` needs, since `Array with T` and its `__ManagedMemory with T` ARE one
	// type (which surface a receiver denotes is a further question, and the ⛔ block below is what it cost to
	// leave unasked). On its own it would move the refusal rather than
	// remove it: admitting a member routes it to `structBaseOfReceiver`, and
	// `ProgramSignatures.genericInstanceHasBaseLayout` answers FALSE for every BUILTIN generic base whatever
	// any file declares — so a declared `Array.size()` gets as far as `missingBaseLayout` and is refused
	// *"a field access … `Array` is a BUILTIN whose runtime record the compiler synthesizes"*, about a METHOD, which
	// is a WORSE sentence than the roster's. What admits it is `structLayoutOfType`'s own
	// `declarationIsTheManagedRecord` arm — read that header for why the FIELD WALK's gate stays where it is.
	//
	// ⚠ The SHAPE is asked as well as the instance, and the two are not the same test — see
	// `ProgramSignatures.declarationIsTheManagedRecord` for why either alone is a wrong answer. A declaration that
	// fails it is a record this compiler does NOT own, and its members must keep meeting the roster sentence
	// rather than being dispatched against a layout the value does not have.
	//
	// ⛔⛔ **THE INSTANCE TEST ALONE PICKS THE WRONG SURFACE, BECAUSE IT IS THE TYPE THAT IS SHARED AND
	// THE SURFACE THAT IS NOT.** Being an `Array` instance is exactly as true of a receiver denoting the
	// BUFFER, a door keyed on it would ask the **`Array`** roster about `__ManagedMemory`'s members — and the two
	// rosters are DELIBERATELY different lists. Every buffer member off the `Array` roster
	// (`swap`, `elementSize`, `grow`, `setLength`, `shiftLeft`, …) therefore falls through to
	// `declaresCallee("Array.<m>")` and is handed to the ENCLOSING RECORD's same-named method:
	//   • **MEASURED as a SILENT WRONG ANSWER** — a `type Array` declaring an `elementSize()` of its own got
	//     that method's value back from `managed.elementSize()`, compiled, linked and RAN, returning 99 where
	//     the buffer's answer is 8. No diagnostic anywhere.
	//   • **MEASURED as a wrong DIAGNOSTIC** — `stdlib/helpers/sort/smallSort.maxon:32`'s
	//     `try managed.swap(i, j: j)`, inside an `export extension Array` declaring its own `swap`, was
	//     `E3055 … 'Array.swap' does not throw`, about a call whose real target throws. The routing was
	//     unbounded recursion; only the throws-mismatch made it visible, which is the accident that found
	//     the whole defect.
	//
	// ⇒ **SO THE MARK IS ASKED HERE, AND IT IS THE SAME ONE `dispatchArrayMethod` DECIDES ON** — one fact,
	// read by both doors, rather than a second answer to "which of the two surfaces is this?". The buffer
	// surface is the COMPILER's own and no file declares a member on `__ManagedMemory`, so a buffer receiver
	// has nothing for the corpus to serve: it falls to `false` and reaches `dispatchArrayMethod`, where the
	// BUFFER roster gates it and a name that surface lacks is refused in the buffer's own sentence.
	//
	// ⚠ `dispatchArrayMethod` spells the same question `viaManagedField or valueIsBufferSurface(arr)`, and
	// the extra disjunct is not missing here: the two call sites that pass `viaManagedField: true` reach that
	// dispatcher DIRECTLY (`dispatchMethodOnBinding`'s fused arm and the re-entry inside the dispatcher
	// itself), so every receiver arriving at this door came by a route that passes `false`.
	//
	// ⚠ **ONLY THE THREE SPELLINGS WITHOUT A PRE-DOOR ARE AT RISK, WHICH IS WHY IT HIDES**: a STATEMENT
	// or `try`-TARGET `<base>.managed.<m>(…)` is claimed ahead of this by `arrayManagedMemberCallAt` and is
	// always right, so `try arr.managed.swap(…)` works while the bare `managed.swap(…)` two lines away would
	// not. A defect reachable by three routes and masked on a fourth reads as a spelling quirk.
	//
	// ⭐⭐⭐ **AND THE `Array` ARM ASKS THE RECEIVER WHICH DECLARATION IT IS OF, RATHER THAN SPELLING ONE.**
	// A user program declaring its own `type Array` moves the CORPUS declaration into the reserved
	// space (`SignatureIndex.contestStdlibTypeName`), so TWO `Array` declarations are live in one compile: the
	// user's under the bare name, `stdlib/Array.maxon`'s under this compile's mint. Keying either clause below
	// on the CONSTANT would ask about the user's declaration whatever the receiver is:
	//   • **MEASURED with `reserve` struck from the roster** — `stdlib/String.maxon:803`'s `bytes.reserve(…)`,
	//     whose receiver is the corpus's own `__Array with Byte`, looked for `Array.reserve` on the USER's
	//     container, found nothing and was refused **`E2015 … stdlib/String.maxon:803:9 … 'Array' member
	//     'reserve'`** — the compiler refusing a library line no user wrote, in a program whose only offence
	//     was declaring a container of its own. Three cases; the ⭐ block at `arraySurfaceMemberNames` records
	//     it as the reason four names could not leave the roster.
	//   • The SHAPE clause would be wrong the same way, and in the more dangerous direction: it would read the user
	//     declaration's field list to decide whether the CORPUS's record is the compiler's.
	// The receiver's instance carries the answer already — `Array with T` and `__ManagedMemory with T` intern
	// to one id under the name the declaring FILE spells (`canonicalGenericBaseNameInThisFile`) — so this
	// is a read of a fact the type already holds and not a second scoping rule.
	function memberBelongsToTheCorpus(recv MethodReceiver) returns bool
		if tagIsByteRecord(recv.tag) 'aByteRecord'
			return self.corpusServesMemberOffRoster(byteRecordSurface(recv.tag), typeName: self.byteRecordLayoutName(recv.tag))
		end 'aByteRecord'

		if self.isStringIndexType(recv.tag, nameId: recv.nameId) 'aStringIndex'
			return self.corpusServesMemberOffRoster(MemberSurface.stringIndex, typeName: StringIndexTypeName)
		end 'aStringIndex'

		if self.signatures.isArrayInstanceAt(recv.tag, nameId: recv.nameId) and not self.valueIsBufferSurface(recv.value) 'anArraySurface'
			let declaration = self.signatures.genericInstanceBaseName(recv.nameId as GenericInstanceId)

			if not self.signatures.declarationIsTheManagedRecord(declaration) 'notTheOwnRecordArray'
				return false
			end 'notTheOwnRecordArray'

			return self.corpusServesMemberOffRoster(MemberSurface.array, typeName: declaration)
		end 'anArraySurface'

		// ⭐⭐ **THE SIZED CONTAINER'S ARM, AND LISTING `stdlib/FixedArray.maxon` DOES NOT WORK WITHOUT IT.**
		//
		// ⛔ **MEASURED, and it is the whole difference between a filtered run and the suite: `--filter=fixed-array`
		// was 55/55 without this arm and the full suite was 5941/400.** 375 of those are one sentence —
		// `E2015 stdlib/Interfaces.maxon:229: `FixedArray` member 'createIterator' — the compiler provides count/get/set` —
		// because a listed `FixedArray` DECLARES `implements Iterable`, so `extension Iterable`'s `map`, `filter`
		// and `contains` specialize for it, and their `for item in self` asks the receiver for the very member
		// the roster did not carry. The conformance is not decoration: it is what publishes those extension
		// methods onto the type, and they are compiled.
		//
		// ⭐⭐ **AND IT HAS NO ROSTER CLAUSE, WHICH IS WHAT MAKES IT THE WHOLE SURFACE RATHER THAN
		// ITS REMAINDER.** The three sibling arms above ask two questions — does the COMPILER serve this name
		// itself, and does the corpus declare it — because each of those surfaces still has members of its own.
		// The sized container has none, so the
		// first question is vacuous and only the declaration's answer is left.
		if self.signatures.isFixedArrayInstanceAt(recv.tag, nameId: recv.nameId) 'aSizedContainerSurface'
			let sizedDeclaration = self.signatures.genericInstanceBaseName(recv.nameId as GenericInstanceId)

			if not self.signatures.declarationIsASizedContainerRecordNamed(sizedDeclaration) 'notTheCorpusFixedArray'
				return false
			end 'notTheCorpusFixedArray'

			return self.corpusDeclaresMemberAtCursor(sizedDeclaration)
		end 'aSizedContainerSurface'

		return false
	end 'memberBelongsToTheCorpus'

	// The shared test behind the door above and its STATIC twin: "the roster does not carry this member and
	// the corpus declares it on this type". Written once because the three askers differ only in which
	// surface and which type name they mean — and getting that ORDER wrong in one of them is exactly the
	// drift this whole arrangement exists to prevent.
	//
	// ⛔⛔ **"DECLARES IT" MEANS *ANY* DECLARATION, AND IT USED TO MEAN "IN THE TYPE'S OWN BODY".** It asked
	// `conformerDeclaresOwnMethod`, whose whole point is to EXCLUDE what an `extension` published — a
	// distinction the extension fold needs and this door must not inherit. A published method is the
	// conformer's at every other call site, so the exclusion made this one refuse it: **MEASURED, `"hello".
	// filter(…)` — `stdlib/Interfaces.maxon`'s `extension Iterable` publishes `filter` onto `String`, which
	// `implements Iterable` — reported `E2015 … 'filter' — the compiler provides hash/equals; that list IS the
	// surface`, which is exactly the sentence this door exists to retire, about a method the program has.
	// `Array.sort` and `sortUnstable` live in `export extension Array` and would have been refused for the
	// identical reason.
	//
	// ⚠ It PEEKS: the cursor sits on the member name — the `.` is already consumed and no arm has read it —
	// because the caller hands that token to the dispatcher, which consumes it. `tokenCanBeAName` guards a
	// measured hazard rather than a hypothetical one: a literal carries its CONTENT in `.value`, so
	// `String."fromOwnedBytes"` would otherwise be tested against the corpus's declaration by bytes alone.
	function corpusServesMemberOffRoster(surface MemberSurface, typeName ByteArray) returns bool
		let memberTok = self.current()

		if not tokenCanBeAName(memberTok) 'notAMemberName'
			return false
		end 'notAMemberName'

		return self.corpusServesNamedMemberOffRoster(memberTok.value, surface: surface, typeName: typeName)
	end 'corpusServesMemberOffRoster'

	// ⭐⭐ **THE SAME DOOR FOR A TYPE WITH NO SYNTHESIZED SURFACE AT ALL.** The rostered form above
	// asks two questions and this one asks the second alone: the sized container has no roster to lose a name
	// to, so every member a `FixedArray` has is `stdlib/FixedArray.maxon`'s. It is a SEPARATE door rather than a call
	// with an empty roster because an empty roster would need a `MemberSurface` entry, and that entry is
	// exactly what retires when a dispatcher does.
	//
	// ⚠ It PEEKS, and it carries the `tokenCanBeAName` guard for the rostered door's measured reason: a
	// literal carries its CONTENT in `.value`, so `FixedArray."frobnicate"` would otherwise be tested against the
	// declaration by bytes alone.
	function corpusDeclaresMemberAtCursor(typeName ByteArray) returns bool
		let memberTok = self.current()

		if not tokenCanBeAName(memberTok) 'notAMemberName'
			return false
		end 'notAMemberName'

		return self.signatures.declaresCallee(qualifiedMethodName(typeName, methodName: memberTok.value))
	end 'corpusDeclaresMemberAtCursor'

	function corpusServesNamedMemberOffRoster(member ByteArray, surface MemberSurface, typeName ByteArray) returns bool
		if self.surfaceMemberNames(surface).contains(member) 'theSynthesizedSurfaceServesIt'
			return surface == MemberSurface.array and self.declaredIndexIsNotAnIntegerAlias(member, typeName: typeName)
		end 'theSynthesizedSurfaceServesIt'

		return self.signatures.declaresCallee(qualifiedMethodName(typeName, methodName: member))
	end 'corpusServesNamedMemberOffRoster'

	function declaredIndexIsNotAnIntegerAlias(member ByteArray, typeName ByteArray) returns bool
		if not member.equals(GetMethod) and not member.equals(ArraySetMethod) and not member.equals(ArrayResizeMethod) 'noIndexParameter'
			return false
		end 'noIndexParameter'

		let decl = try self.declarationNameableHere(qualifiedMethodName(typeName, methodName: member)) otherwise return false

		return match self.signatures.declaredParamAliasAt(decl, position: 0) 'indexType'
			declared(alias) gives maxonTypeTag(alias.underlying) != ValueTypeTag.integer
			undeclared gives true
		end 'indexType'
	end 'declaredIndexIsNotAnIntegerAlias'

	// ⭐⭐⭐ **THERE IS NO STATIC TWIN OF THE DOOR ABOVE: `parseQualifiedCall` ITSELF SERVES A CORPUS-DECLARED
	// `String` STATIC.** A static the corpus declares and the compiler's roster does not reaches its declaration
	// through the ordinary qualified-call path: with both synthesized statics retired, a roster test could only
	// answer "miss", and every call it would admit goes to `parseCallNamed` with a callee, receiver, mint and
	// `constructorInstance` identical to the ones the ordinary qualified-call path builds for the same tokens —
	// including the `tokenCanBeAName` guard, which lives in that path's own `consumeNameToken`. The RECEIVER
	// door above stays because a receiver dispatch has a synthesized roster that genuinely wins first
	// (`s.byteLength()` is a field load, not a call); a static has no roster left to win.

	// Which roster a byte record's tag names. The two are separate surfaces with separate rosters, exactly as
	// they are separate conformers, so the mapping is stated once here rather than at each asker.
	function byteRecordSurface(tag ValueTypeTag) returns MemberSurface
		if tag == ValueTypeTag.character 'aCharacter'
			return MemberSurface.character
		end 'aCharacter'

		return MemberSurface.string
	end 'byteRecordSurface'

	// ⭐⭐ **`arr.managed` IN VALUE POSITION — THE SAME RECORD, SEEN AS THE BUFFER, AND THE
	// EXACT INVERSE OF `parseArrayInitStatic`.** `init(managed)` adopts a buffer AS the array around it; this
	// hands the array's buffer BACK. One record, two surfaces, and the two directions owe the same two things:
	// a FRESH `ValueId` to carry the surface mark, and a refcount that still balances.
	//
	// ⭐ **THE OWNERSHIP QUESTION IS "WHO ALREADY OWES THIS RECORD A DROP?", AND IT HAS TWO ANSWERS.**
	//   • **THE STATEMENT DOES** — `arr` is an UNBOUND owned temporary (`"…".toByteArray().managed`,
	//     `[1,2,3].managed`). `.managed` changes nothing about who drops it: the value carries the statement's
	//     one obligation on, to a binding that takes it over (`removeFromPendingTemps`) or to the statement-end
	//     drain. A second owner here would be a retain nobody needs, on every `path.toByteArray().managed` in
	//     the corpus. And the mark is safe on the receiver's OWN `ValueId` precisely BECAUSE it is a pending
	//     temp: `pendingTempsContain`'s contract is that such a value is owned by no binding, so there is no
	//     second name through which the `Array` surface could still be wanted — which is the whole hazard
	//     `error.managed-field-chain-does-not-mark-the-array` pins for the CHAINED spelling.
	//   • **SOMEBODY ELSE DOES** — `arr` is a BINDING's value (`var a = […]`, dropped at ITS scope exit) or a
	//     BORROW (a `ByteArray` PARAMETER, owned in the caller's frame — `stdlib/File.maxon:147`). Whatever
	//     this value is bound to or handed to drops independently, so it must become a SECOND owner through
	//     `coOwnAggregateAsTemp` — the `__mm_retain` that mints the fresh id on the same refcount word
	//     `__managed_decref` lowers, plus the statement-scoped drop an UNBOUND result needs. It is the one door
	//     `parseArrayInitStatic` takes for the other direction, so the two inverses cannot drift on ownership.
	//
	// ⚠⚠ **HANDING BACK THE RECEIVER'S OWN `ValueId` IN THE SECOND CASE IS A DOUBLE FREE, NOT A COSMETIC
	// IDENTITY.** `let m = a.managed` is three tokens, so `rhsWasBareLocalReference` reads it as a CONSUME and
	// does NOT poison `a` — yet `declareInitializedBinding` enrols `m` in `ownedBindings` all the same, because
	// the value's provenance says owned-heap. `a` and `m` would be one box with two scope-exit drops.
	// ⭐⭐ **THE SURFACE FLIP, PLUS THE ONE RETYPE THE SIZED CONTAINER NEEDS.** For the ARRAY record the
	// flip is the whole of it: `Array with T` and `__ManagedMemory with T` are ONE `GenericInstanceId`, so the
	// buffer surface of an array IS the array, and only the MARK changes. A `FixedArray with N T`'s record is the
	// same 48 bytes but a DIFFERENT id — the size is the second coordinate of its identity — so the value
	// handed to a buffer position has to say so, or the corpus's own `FixedArrayIter.create(managed)` is refused
	// **`E3005 … expected 'FixedArray.ElementMemory', got 'FixedArray_T…'`**: one record, two ids, which is exactly the
	// disagreement `canonicalGenericBaseNameInThisFile`'s fold exists to prevent one genericity up.
	//
	// ⚠ The buffer instance is built from the RECEIVER's element rather than from the declaration's parameter,
	// so it is concrete wherever the receiver is (`Vec3`'s buffer is `Array with Int`) and opaque inside the
	// declaration's own body — which is the same instance the field's declared type resolves to.
	function bufferSurfaceOfDeclaredRecord(box ValueId, layout StructLayout, range SourceRange) returns ValueId
		let surface = self.bufferSurfaceOf(box, range: range)

		if not self.signatures.declarationIsASizedContainerRecordNamed(layout.name) 'theBufferIsItsOwnInstance'
			return surface
		end 'theBufferIsItsOwnInstance'

		// ⭐⭐ **THE SIZED FACT IS WRITTEN ON THE VALUE HERE BECAUSE THE VERY NEXT LINE ERASES IT FROM THE
		// TYPE.** The retype below is what makes `stdlib/FixedArray.maxon`'s `createIterator`'s `FixedArrayIter.create(managed)`
		// type-check, and it is load-bearing — but it leaves the value spelled `Array with Element`, so
		// `genericInstanceBaseName(giid)` at the dispatch answers `Array` and no `giid` test downstream can
		// tell a fixed array's record from a growable array's. This `if` is the last place that knows, and it
		// already asked the question one line up.
		//
		// ⇒ It carries the answer on a per-VALUE mark instead, which reaches both spellings that mint one:
		// the bare `managed` inside an `extension FixedArray` (`dispatchMethodOnBinding` → `baseBoxOf` →
		// `parseSelfFieldRead`) and the explicit `self.managed` (`parseExplicitSelfFieldRead`), plus every
		// local a program binds either to — and, since the mark has to survive being re-minted, every
		// RE-MINT (`carryValueFacts`) and every MERGE (`propagateBufferSurfaceToPhi`).
		//
		// ⚠ **THE ONE SPELLING THAT MINTS NO VALUE IS ANSWERED ELSEWHERE**: a fused `managed.append(…)` at
		// `dispatchMethodOnBinding`, off the ENCLOSING DECLARATION. ⛔ A `returns ElementMemory` is NOT a third
		// carrier answerable at `emitCall` off the callee's name: a `slice` has the identical declared type, so
		// the declaration cannot tell the record from a view of it.
		self.markSizedContainerBuffer(surface, origin: self.brandOf(surface))

		self.retypeValue(surface, valueType: MaxonType.genericInstance(self.bufferSurfaceInstanceOf(box, layout: layout)))
		return surface
	end 'bufferSurfaceOfDeclaredRecord'

	// ⭐⭐⭐ **WHICH GENERIC INSTANCE A FUSED WRAPPER'S BUFFER SURFACE WEARS — ONE ANSWER, TWO DOORS.**
	// The value door RETYPES the surface it mints to this (above); the
	// fused record door hands it to `dispatchArrayMethod` as the receiver's `giid`, minting nothing
	// (`dispatchMethodOnBinding`'s `inlineManagedServesTheRecord`). Those are the two spellings of one field,
	// and they *"answer to one element rule"*: a CONSTANT such as `internSynthesizedByteInstance()` is one of
	// the three answers below and is wrong for receivers wanting the other two.
	//
	// **The three cases are the three shapes of fused record, and each is somebody else's already-settled
	// answer rather than a new one:**
	//   • **A BYTE RECORD** (`String`, `Character`) — the compiler's own synthesized byte buffer, the instance
	//     `emitFieldLoad` stamps on the `__str_bytes_view` it mints for exactly these two.
	//   • **THE ARRAY RECORD** — the buffer of an `Array with T` IS that array: `Array with T` and
	//     `__ManagedMemory with T` are ONE `GenericInstanceId`, so the receiver's own instance is the
	//     answer and there is nothing to build.
	//   • **THE SIZED CONTAINER'S RECORD** (`FixedArray`) — the same 48 bytes under a DIFFERENT id, because the
	//     size is the second coordinate of a fixed array's identity. Its buffer must be spelled
	//     `Array with T`, built from the RECEIVER's element so it is concrete wherever the receiver is
	//     (`Vec3`'s buffer is `Array with Int`) and opaque inside the declaration's own body.
	//
	// ⚠ **THE ORDER IS NOT A PREFERENCE, IT IS AN INCLUSION.** `declarationsValueIsTheManagedRecord` is the
	// union of the two declared-record cases, so it is asked FIRST to send the byte records away; only then
	// is the sized half separated from the growable one, which is the same rank order
	// `bufferSurfaceOfDeclaredRecord` above uses and for the same reason.
	//
	// ⛔⛔ **THE FIRST ARM IS A NEGATION, SO IT ANSWERS FOR A FOURTH SHAPE THE CENSUS ABOVE DOES NOT NAME,
	// AND WHAT MAKES THAT SAFE IS A REACHABILITY ARGUMENT THAT LIVES IN ANOTHER FUNCTION.**
	// `declarationsValueIsTheManagedRecord` is false for `String` and `Character` — and equally
	// false for ANY OTHER conformer of one of `stdlib/Builtins.maxon`'s three literal markers, which a user
	// file may perfectly well declare (`type Bag implements BuiltinArrayLiteral`). Such a wrapper is handed
	// the compiler's byte buffer here, which is the same stride lie — one shape further
	// out.
	//
	// ⇒ **IT CANNOT PRODUCE A WRONG ANSWER BECAUSE THAT SHAPE CANNOT PRODUCE A VALUE**, and that is
	// `Parser.requireFusedWrapperTag`'s doing, not this function's: The compiler mints a fused record only for the
	// two NAMES it owns the record for, so every other marked conformer is refused at its `Self{…}` literal
	// (`specs/interface-conformance.md` pins it, with the **exit 0xC0000005** the refusal prevents).
	// MEASURED: a `type Bag implements BuiltinArrayLiteral` over a CONCRETE
	// `__ManagedMemory with String`, whose `init` panics so no literal is ever written, COMPILES — and its
	// body's `managed.setByte(0, 65)` is admitted through this arm.
	// It leaks nothing only because no `Bag` can exist to be written into.
	//
	// ⚠ **SO THE ARM IS CORRECT TODAY AND ITS CORRECTNESS IS BORROWED.** It is left as a negation rather
	// than turned into a positive `byteRecordTagOfTypeName` test with a `panic` terminal, because that
	// panic would fire on programs the suite currently accepts — `interface-conformance.md`,
	// `array-declared-record.md` and three more declare marked conformers under five other names, and each
	// is pinned on the E2015 it gets today, not on a compiler abort. Widening `requireFusedWrapperTag`'s
	// refusal from the LITERAL to the DECLARATION would retire the borrowing entirely and is its own row.
	function bufferSurfaceInstanceOf(box ValueId, layout StructLayout) returns GenericInstanceId
		if not self.signatures.declarationsValueIsTheManagedRecord(layout.name) 'aByteRecordsBufferIsTheCompilersOwn'
			return self.signatures.internSynthesizedByteInstance()
		end 'aByteRecordsBufferIsTheCompilersOwn'

		if not self.signatures.declarationIsASizedContainerRecordNamed(layout.name) 'theBufferIsItsOwnInstance'
			return self.valueInstanceId(box)
		end 'theBufferIsItsOwnInstance'

		return self.signatures.builtinInstanceForElement(self.signatures.arrayRecordBaseName(), element: self.signatures.containerElementType(self.valueInstanceId(box)))
	end 'bufferSurfaceInstanceOf'

	function bufferSurfaceOf(arr ValueId, range SourceRange) returns ValueId
		let origin = self.brandOf(arr)

		if self.pendingTempsContain(arr) 'statementAlreadyOwnsIt'
			self.markBufferSurface(arr, origin: origin)
			return arr
		end 'statementAlreadyOwnsIt'

		let buffer = self.coOwnAggregateAsTemp(arr, range: range)
		self.markBufferSurface(buffer, origin: origin)
		return buffer
	end 'bufferSurfaceOf'

	// Dispatch a builtin `Array` method — cursor on the method NAME, `arr` the (borrowed) receiver record.
	// Shared by the binding receiver (`arr.push(x)`) and a value receiver (`[…].get(0)`). An OPAQUE-`T` array
	// (`self.items.push(x)` in a generic body) dispatches here too, and the shared body treats the
	// opaque element as an 8-byte WORD — which is correct for MOVE-IN (`push`/`set`/`insert` move the word, and
	// the call-site consume promotes a managed argument), for the metadata methods, for drop,
	// for READING (`get`/`first`/`last` hand back a BORROW) and for MOVING OUT (`pop`/`remove` hand back an OWNED
	// word dropped through the descriptor-gated `__drop_type_param`) — the word is only
	// carried and dropped, never interpreted. A per-element COPY (`slice`/`clone`/`append`) is served too, through
	// the descriptor `copyFunc@32`: `__managed_*_opaque` byte-blits a trivial element and
	// deep-clones a direct-clonable managed one, so it never duplicates a managed pointer and double-frees it —
	// unless the instantiation's element is a managed type that cannot be single-function-cloned, which
	// `requireOpaqueArrayCopyable` rejects.
	function dispatchArrayMethod(func IrFunction, arr ValueId, giid GenericInstanceId, resultUsed bool, immutableReceiverName immutable ByteArray, receiverOwner ParamPositionMask, receiverStorage ParamPositionMask, viaManagedField bool) returns ValueId throws SourceParseError
		let methodIndex = self.pos
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.ofToken(methodTok)

		try self.requireArrayMemberIsNotRawSurface(methodTok, onABuffer: viaManagedField or self.valueIsBufferSurface(arr))

		// ⭐ **A `let`-BOUND ARRAY IS NOT WRITABLE** — checked HERE, once, ahead of every arm, because the
		// question is about the METHOD NAME and this is where the name is first known. It goes through
		// `noteReceiverWrite`, the ONE home this rule has for every container, and it is what makes
		// the top-level managed `let` a CONSTANT rather than a value that silently mutates a copy at each
		// read (`emitManagedConstant`).
		// ⭐⭐ **IS THIS RECEIVER THE `__ManagedMemory` BUFFER SURFACE, OR THE `Array` AROUND IT?** One record,
		// two surfaces (`SignatureIndex.ManagedMemoryTypeName`), and this is the one place the question is
		// asked — the `.managed` arm below, the four buffer-only members further down, the label rule the
		// two-argument members follow and the mutates-receiver rule on the next line all read this answer.
		//
		// ⭐ **TWO DOORS, AND NEITHER IS THE INSTANCE.** The test `giid == internArrayByteInstance()` would admit a
		// user's own `ByteArray` and refuse a `__ManagedMemory` over any other element, because the alias is
		// element-agnostic, so an element
		// test cannot answer. What answers is where the receiver CAME FROM — either it was reached
		// through `.managed` (this call's `viaManagedField`), or the value itself was minted as a buffer
		// (`valueIsBufferSurface`: a `__ManagedMemory.create`, or a `slice` of one).
		let isManagedMemory = viaManagedField or self.valueIsBufferSurface(arr)

		// ⭐⭐ **THE ROSTER IS THE SURFACE, AND IT IS ASKED BEFORE ANYTHING ELSE.** ⚖ USER RULING,
		// 2026-07-31. A member the buffer does not have is refused HERE, ahead of every arm and ahead of both
		// receiver rules below, because "does this member exist?" is the question every other refusal about
		// the call presupposes. Two measured spellings say why the position matters as much as the test:
		//
		//   • `let x = mm.push(7)` would otherwise reach `push`'s own `requireVoidMethodIsStatement` and answer
		//     *"Function 'push' does not return a value"* — a false claim (the method EXISTS and is VOID) one
		//     surface over, about a name the buffer has never had.
		//   • `try mm.insert(0, value: 1)` would answer E3055 *"try requires a throwing function"* — a second
		//     assertion that the member is real, differing only in which property it invents.
		//
		// ⇒ The same reason the buffer-only mutators sit outside `arrayMethodMutatesReceiver` (the next line):
		// a rule about HOW a member may be used must not speak for a member the receiver does not have.
		//
		// ⭐⭐ **BOTH SURFACES COME THROUGH THIS ONE GATE.** Gating the buffer alone leaves the `Array` path
		// falling through to a hand-written literal at the end of the function, which is false in both
		// directions (see `arraySurfaceMemberNames`). Two gates would be two spellings of one
		// rule; the surface picks the roster (`surfaceMemberNames`) and the roster answers for the type it is
		// shown about (`requireSurfaceMember`, whose noun this door supplies).
		//
		// ⚠ **IT IS BEHAVIOUR-NEUTRAL FOR AN `Array` RECEIVER, and that is what the derived list guarantees**:
		// every name off the `Array` roster is refused here with an E2015 at the method token. Nothing on
		// the roster can be
		// refused, because every entry matches an arm (the panic at the end of this function is what says so).
		// ⭐⭐ **AND AHEAD OF THAT GATE, THE ONE THING IT CANNOT SAY.** With two `Array` declarations live
		// the roster's *"that list IS the surface"* is a wrong answer about the reader's own program — see
		// `refuseArrayMemberTheOtherDeclarationCarries`. Placed HERE for the paragraph above's own reason: it is
		// still the question *"does this member exist?"*, answered more precisely for the one compile that can
		// tell two answers apart.
		try self.refuseArrayMemberTheOtherDeclarationCarries(giid, methodTok: methodTok, isManagedMemory: isManagedMemory)

		// ⭐⭐ **AND THE SECOND THING THE ROSTER CANNOT SAY: THIS BUFFER'S COUNT IS ANSWERED BY ITS TYPE.**
		// Placed beside the sibling above and for its reason — still *"does this member exist on
		// THIS receiver?"*, answered more precisely for the one receiver that can tell two answers apart. The
		// evidence is the per-value mark and NOT the `giid`, which `bufferSurfaceOfDeclaredRecord`'s retype
		// has already spelled `Array with Element` by the time a value reaches here; the mark implies the
		// buffer answer, so `isManagedMemory` is not a second conjunct (`markSizedContainerBuffer`).
		try self.refuseLengthChangeOnASizedContainersBuffer(methodTok, onASizedContainersRecord: self.valueIsASizedContainersBuffer(arr))

		// ⭐ **THE NOUN IS THE RECEIVER'S OWN DECLARATION, AND THIS IS THE ONLY DOOR THAT KNOWS IT.** A
		// buffer is the compiler's own `__ManagedMemory`; an array is whichever `BuiltinArrayLiteral` conformer
		// the value's instance was built from, which may be a `Bag` the program declared.
		let roster = try self.requireSurfaceMember(MemberSurface.buffer if isManagedMemory else MemberSurface.array, typeName: ManagedMemoryTypeName if isManagedMemory else self.arrayReceiverDeclaredName(giid), methodTok: methodTok)

		// ⚠ **THE BUFFER-ONLY MEMBERS ARE GATED ON THAT ANSWER HERE TOO, or the E3207 rule names methods the
		// receiver does not have.** `let a = IntArray.create()` followed by `a.setLength(2)` must be refused
		// with the unknown-method E2015 its `var` spelling gets, because the method does not exist.
		let mutatesReceiver = arrayMethodMutatesReceiver(methodTok.value, isManagedMemory: isManagedMemory)

		self.noteReceiverWrite(func, receiver: arr, immutableReceiverName: immutableReceiverName, receiverOwner: receiverOwner, receiverStorage: receiverStorage, methodTok: methodTok, methodIndex: methodIndex, mutatesReceiver: mutatesReceiver)

		// ⭐⭐ **`.managed` IS AN IDENTITY AT EVERY ELEMENT TYPE.**
		// `stdlib/Array.maxon:103` declares `export var managed as ElementMemory` — `__ManagedMemory with
		// Element` — and the compiler binds that to the array's OWN instance
		// (`SignatureIndex.ManagedMemoryTypeName`), so `arr.managed` yields the receiver unchanged whatever
		// the element is: no conversion, no allocation, no runtime call.
		//
		// `array-slots.md`'s four cases reach `.managed` on an `Array with Slot` (a STRUCT element),
		// `managed-memory-methods.md`'s seven on an `Array with Int` and its eighth on an `Array with String`.
		//
		// ⚠ It is a FIELD read, not a call: the corpus writes no parentheses. So this arm never consumes an
		// argument list; routing it through the call arms below would demand a `(` the source does not write.
		//
		// ⚠ **THE ARM IS THE `Array`'s ALONE: a buffer has no `managed` member and the roster gate above
		// refuses one**, so `mm.managed.setByte(0, 65)` — a second door onto the buffer's own mutators through
		// a member the buffer does not have — is `error.buffer-has-no-managed-field` rather than an identity
		// on an identity. What re-enters here still arrives with `viaManagedField: true`, which is the ONE hop
		// the source wrote it on.
		//
		// ⚠⚠ **A `.member(` AFTER IT RE-ENTERS THIS DISPATCH WITH THE BUFFER SURFACE, RATHER THAN RETURNING
		// AND LETTING `parsePostfix` DISPATCH THE HOP.** The two are not interchangeable: `.managed` is an
		// identity, so the value `parsePostfix` would carry is the ARRAY's own — indistinguishable from a bare
		// `arr` — and `arr.managed.setByte(0, 65)` would arrive as `arr.setByte(0, 65)`, which the language
		// does not give a `ByteArray`. The surface is a fact about what the SOURCE wrote here, and it is
		// handed to the one dispatch that fact reaches.
		if methodTok.value.equals(ManagedMemoryFieldName) 'managedField'
			if not self.memberCallFollows(self.pos) 'bufferAsAValue'
				return self.bufferSurfaceOf(arr, range: range)
			end 'bufferAsAValue'

			try self.consume(TokenKind.dot)
			return try self.dispatchArrayMethod(func, arr: arr, giid: giid, resultUsed: resultUsed, immutableReceiverName: immutableReceiverName, receiverOwner: receiverOwner, receiverStorage: receiverStorage, viaManagedField: true)
		end 'managedField'

		// Throwing accessors — a plain `call` the enclosing `try` rewrites; result is the element (get/first/
		// last/pop/remove) or a discarded dummy (set). `resultUsed` is the try's concern, not checked here.
		// ⭐ get/first/last yield a BORROW of the element (the array keeps ownership — the caller must not drop
		// it); pop/remove MOVE the element OUT (the runtime nulls its slot), so their result is OWNED.
		if methodTok.value.equals(GetMethod) 'get'
			let index = try self.parseArrayOneArg(func)
			try self.requireArmServedIndexArgument(giid, member: methodTok.value, value: index, anchor: methodTok, bufferSurface: isManagedMemory)
			return self.noteArrayReadMember(try self.emitContainerElementAccessor(ManagedGetName, container: arr, args: twoArgs(arr, second: index), giid: giid, reference: ContainerElementReference.borrowed, range: range), giid: giid, methodTok: methodTok, bufferSurface: isManagedMemory)
		end 'get'

		// ⭐⭐ **ONE SPELLING, TWO ENTRIES — THE BUFFER'S `set` IS BOUNDED BY CAPACITY AND THE `Array`'s BY LENGTH.**
		// ⚖ The capacity bound is a USER RULING of 2026-07-30, taken after a measured three-way
		// contradiction the runnable oracle could not arbitrate; `ManagedMemoryRuntime.ManagedMemSetName` carries the ruling,
		// its date and the argument that settles it (a length bound forbids the exact stage-then-publish idiom
		// canonical `setLength`'s own contract prescribes). **`specs/managed-memory-methods.md:21` says LENGTH and
		// is treated as stale — do not "fix" this back toward it.**
		//
		// ⚠ **`Array.set` MUST NOT MOVE**: `specs/arrays.md` and the array corpus are written against the length
		// bound, and the record is shared — so the surface answer that already decides this call's LABEL rule
		// decides its CALLEE too, and there is no second discriminator.
		//
		// The `Array` half is served by the corpus body rather than by an arm. The RANGE check arrives
		// from `recordOpaqueArgRangeChecks` at the call site — both halves, the E3005 on a literal and
		// the `Range check failed` panic on a computed 505 — because the corpus declares `value Element`
		// and the shared callee knows no range. The LENGTH bound is `stdlib/Array.maxon`'s own `set`
		// guard.
		//
		// ⛔ **WHAT REFUSES IS THE RECEIVER, NOT `set`.** An `Array with <a parameter of the enclosing generic>`
		// cannot reach a corpus body at all: `stdlib/Map.maxon`'s own slot columns PANIC the compiler
		// (*"primitiveTypeByteSize: a `typeParameter`'s size is a runtime layout-descriptor read"*, from
		// `MaxonToStdLowering.materializeLayoutArgFor` needing a per-instance descriptor for `Array with Key`),
		// 34 `map` cases plus four more; three further cases are REFUSED outright because
		// `memberBelongsToTheCorpus` does not admit that receiver; and five `generic-opaque-element-loop-store`
		// cases lose `coOwnBorrowedOpaque`, which lives in `moveElementIntoContainer` and has no
		// counterpart on the ordinary caller-consume path. `arraySurfaceMemberNames`' `set` bullet carries the
		// full measurement. Until an opaque-element receiver can name a corpus body, this arm is how a `Map`
		// writes its own slots.
		//
		// ⚠ The callee is picked into a `var` because a conditional EXPRESSION does not lower here.
		// Written `callee: ManagedMemSetName if isManagedMemory else ManagedSetName` — the shape
		// `noteReceiverWrite`'s call above already uses — the build fails with `error E9001: Lowering
		// function 'Compiler.Parser.dispatchArrayMethod' failed: assign value %97103 (kind=MaxonInteger)
		// not in valueMap; assigning to '__arg_pin_27'`. No MECHANISM is claimed and none should be
		// inferred: a conditional `ByteArray` argument lowers fine on its own, twice in one function, in
		// a labelled position, and under a `try`. Whatever the trigger is, it needs this function, and
		// reverting these four lines to the one-line expression reproduces it exactly.
		//
		// ⚠⚠ **`set` IS A VOID MUTATOR TOO — IT SITS HERE ONLY BECAUSE IT THROWS, AND IT NEEDS BOTH HALVES OF
		// THE REFUSAL.** The two halves cover DISJOINT positions and neither can do
		// the other's job: this guard answers the BARE spelling (`let x = arr.set(…)`, where `resultUsed` is
		// TRUE at the arm), and the honest `void` result tag `parseArraySet` mints answers the `try`
		// spelling (`let x = try arr.set(…) otherwise …`, where the target is parsed `resultUsed: false` and
		// only `parseTry`'s `voidInValue` can see it). The three buffer mutators below carry both, and `set` does too.
		// ⇒ **MEASURED, and it is why the guard cannot be dropped in favour of the tag alone**: with the tag
		// honest and this line absent, `let x = arr.set(0, value: 7)` reaches `declareInitializedBinding` and
		// PANICS the compiler — *"maxonTypeOfTag: a `void` tag names no value"* — because SemanticCheck's
		// bare-throwing-call E3057 runs a whole pass too late to protect the parser from itself.
		if methodTok.value.equals(ArraySetMethod) 'set'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)

			if isManagedMemory 'capacityBoundedSetter'
				try self.requireBufferSetOwnsWhatItStores(giid, methodTok: methodTok)
			end 'capacityBoundedSetter'

			let setCallee = ManagedMemSetName if isManagedMemory else ManagedSetName
			return try self.parseArraySet(func, arr: arr, giid: giid, callee: setCallee, methodTok: methodTok, bufferSurface: isManagedMemory, range: range)
		end 'set'

		if methodTok.value.equals(ArrayFirstMethod) 'first'
			try self.consumeEmptyArgList()
			return self.noteArrayReadMember(try self.emitContainerElementAccessor(ManagedFirstName, container: arr, args: argsOf(arr), giid: giid, reference: ContainerElementReference.borrowed, range: range), giid: giid, methodTok: methodTok, bufferSurface: isManagedMemory)
		end 'first'

		// ⭐ **`remove` IS BUFFER-SURFACE ONLY, AND THE GATE IS WHAT SAYS SO.** The
		// `Array` spelling is `stdlib/Array.maxon`'s, which is this same operation through
		// `managed.remove(at)` — one runtime, reached from source instead of from an arm. The gate is
		// unreachable-by-roster (the buffer roster carries the name and the `Array` one does not) and
		// is written anyway, exactly as `byteAt`/`elementSize`/`grow` write theirs: an arm that can be
		// reached on a surface the member does not belong to is a defect, and the gate is the only thing
		// that states the surface at the arm rather than only in a list.
		if isManagedMemory and methodTok.value.equals(RemoveMethod) 'remove'
			let index = try self.parseArrayOneArg(func)
			return try self.emitContainerElementAccessor(ManagedRemoveName, container: arr, args: twoArgs(arr, second: index), giid: giid, reference: ContainerElementReference.movedOut, range: range)
		end 'remove'

		// ⭐ **`slice` IS BUFFER-SURFACE ONLY**, for `remove`'s reason above and by its gate. The
		// `Array` spelling is `stdlib/Array.maxon:226`'s, whose body is this same `managed.slice(…)` wrapped in
		// a `Self{managed: …}` — one runtime, reached from source. Its RESULT keeps everything the arm gave it:
		// the receiver's instance and the receiver's element surface both ride the `Self` return
		// (`retypeInstanceMethodResult`), which is where a corpus body gets what `inheritArrayElementSurface`
		// hands the arm below.
		if isManagedMemory and methodTok.value.equals(SliceMethod) 'slice'
			try self.requireArrayCopyMethodSupported(giid, methodTok: methodTok)
			return try self.parseArraySlice(func, arr: arr, giid: giid, range: range)
		end 'slice'

		// ⭐ **`byteAt(index)` — THE BUFFER'S BYTE READER**, sitting with the throwing accessors because
		// it YIELDS a value, where its `setByte` dual is void and sits with the mutators. Its bound is
		// `length · element_size` and it throws `invalidByteRange`, both of which live in one place with the
		// setter's (`ManagedMemoryRuntime.emitBufferAccessGuard`).
		if isManagedMemory and methodTok.value.equals(ByteAtMethod) 'byteAt'
			try self.requireBufferBytesAreNotAPointer(giid, methodTok: methodTok)
			let index = try self.parseOneBuiltinIntegerArgList(func, paramName: ManagedMemoryIndexParamName, methodTok: methodTok)
			return self.emitLibraryAliasedRuntimeCall(ManagedByteAtName, args: twoArgs(arr, second: index), alias: ByteAliasName, range: range)
		end 'byteAt'

		// Non-throwing value accessors.
		// ⭐ `__ManagedMemory.length()` IS `Array.count()` — both read `length@8` and nothing else — so the
		// name is folded onto this arm rather than given a second, byte-identical emission of its own.
		// `setLength`/`setByte` below are deliberately NOT folded onto `resize`/`set`: those two pairs differ
		// (see the `__ManagedMemory` mutators).
		// ⚠ **WHAT IS FOLDED IS THE EMISSION, NEVER THE SURFACE.** `count` is the `Array`'s spelling and
		// `length` is the buffer's, so `mm.count()` is refused by the roster gate above and only the second
		// disjunct here is reachable on a buffer — sharing an arm must not hand a receiver a name the
		// references never gave it, or the roster's own first entry becomes decorative.
		if methodTok.value.equals(CountMethod) or (isManagedMemory and methodTok.value.equals(ManagedMemoryLengthMethod)) 'count'
			try self.consumeEmptyArgList()
			let countArgs = argsOf(arr)
			let counted = self.emitRuntimeCallInto(self.mintArrayCountResult(giid, bufferSurface: isManagedMemory), callee: ManagedCountName, args: countArgs, range: range, argLabels: emptyArgLabels(countArgs))

			// ⭐ **A COUNT IS NON-NEGATIVE, AND THIS IS WHERE THAT FACT ENTERS THE COMPILER.** The backing
			// `__ManagedMemory` holds at most `i64.max` slots (`stdlib/Array.maxon`'s `ElementIndex` header
			// states the bound and why it is not tighter), so the answer is in `0 … i64.max` — which is what
			// lets `for i in 0 upto xs.count()` state its counter's floor.
			//
			// ⚠ COUNT ONLY, never the sibling read members `noteArrayReadMember` also serves — a
			// `capacity()` answers a NEGATIVE FLAG for a buffer it does not own, which is the whole reason
			// `ReportedCapacity` is full-range signed.
			self.recordProvenIntRange(counted, low: 0, high: i64.max)

			return self.noteArrayReadMember(counted, giid: giid, methodTok: methodTok, bufferSurface: isManagedMemory)
		end 'count'

		// ⭐ **`toCString()` — BUFFER-SURFACE ONLY**, like `length`/`byteAt`/`elementSize`: neither reference
		// gives `Array` the spelling, and the corpus reaches it through `arr.managed.toCString()`. The result is
		// a raw address, so it is `integer`-tagged exactly as `cstring` resolves in a type position — one
		// answer to "what is a NUL-terminated pointer?", given at the type door and at the value door.
		// ⭐⭐ **`makeCharFromBytes(pos, len)` — THE CORPUS'S GRAPHEME MINT, SERVED BY THE DOOR THAT ALREADY
		// EXISTS.** `__char_at(record, startPos, endPos)` is precisely this operation: *"a fresh OWNED record
		// holding a COPY of the bytes `[startPos, endPos)`"*, built through the one fused-record encoder, so a
		// Character minted here is byte-for-byte the one `for c in s` mints and drops through `__str_decref`
		// identically. Writing a second minting graph for the corpus's spelling is exactly the twin this
		// convergence exists to remove.
		//
		// ⚠ **THE CORPUS PASSES A LENGTH AND `__char_at` TAKES AN END, so the arm ADDS.** End-EXCLUSIVE, which
		// is what `pos + len` is — the corpus's own contract is *"callers must guarantee `pos + len <=
		// byteLength()`"*. Getting this backwards would read one byte too few from every multi-byte cluster,
		// silently.
		//
		// ⚠⚠ **BOTH ARE LIBRARY-TIER (`requireArrayMemberIsNotRawSurface`, E3185), AND THAT IS THE VISIBILITY
		// THEIR CORPUS DECLARATIONS ALREADY CARRY.**
		if isManagedMemory and methodTok.value.equals(ManagedMemoryMakeCharFromBytesMethod) 'makeCharFromBytes'
			// ⛔⛔ **`__char_at` READS `singleByteGraphemes@48`, WHICH ONLY A BYTE RECORD HAS.** A plain
			// 48-byte buffer record ends at `@48`, so serving this member one is an eight-byte read PAST the
			// record — into the next allocation's header, or off the end of the last one.
			//
			// ⚠ **A PANIC, NOT A DIAGNOSTIC, AND `ProgramSignatures.checkFusedWrapperRecordLayouts` IS THE
			// PRECEDENT.** Nothing a user program can express reaches it — the line above refuses this member
			// outside `stdlib/`, and the corpus's ONE call site is `String.makeCharFromBytes`'s
			// `managed.makeCharFromBytes(…)`, an implicit-`self` fused read that `dispatchMethodOnBinding`
			// routes here with the String's own record. So what could fire it is an edit to a LISTED corpus
			// module, and there is no degraded answer available: the alternative to stopping is minting a
			// Character out of whatever byte followed the record.
			//
			// ⛔⛔ **IT ASKS THE RECEIVER'S TAG, NOT THE ROUTE THE SOURCE WROTE — `viaManagedField` IS A DIFFERENT QUESTION.**
			// That flag means *"the source spelled `managed`"*, and the `.managed` re-entry below turns any array
			// receiver into one over a 48-byte buffer record. A `stdlib/` line reading `a.managed.makeCharFromBytes(0, 1)`
			// would therefore pass a guard keyed on it, whose whole subject is the seventh slot. `tagIsByteRecord` is the
			// representation question itself — the one `TypeRules` keeps apart from `tagIsText` for exactly this class of
			// mistake — so the guard is true of what the record IS rather than of how it was reached.
			//
			// ⛔ **MEASURED DIRECTLY, ON THE SPELLING ITSELF RATHER THAN ON A PROXY.** A
			// file placed under `stdlib/` (so `livesUnderStdlibDirectory` holds and
			// the raw-surface gate admits the member) whose whole body is `var a = Ints.create()`
			// + `a.push(1)` + `let c = a.managed.makeCharFromBytes(0, 1)` **COMPILED CLEAN on the base, exit
			// 0, and RAN** — `__char_at` handed an `Array with Int`'s 48-byte record and reading eight bytes
			// past its end. The same file panics here. That is the hole, and it was never a hypothetical.
			//
			// ⚠ **AND THE TIGHTENING COSTS NOTHING ON THE BYTE-RECORD SIDE, WHICH WAS THE HALF WORTH
			// DOUBTING.** Five stdlib-located spellings that DO carry a genuine byte record were compiled on
			// both binaries and answer IDENTICALLY: bare `managed.makeCharFromBytes(…)` inside an
			// `extension String` (served, both), `self.managed.…`, `let b = managed` then `b.…`,
			// `s.addressableBytes().…`, and `b.managed.…` — the last four already refused or panicking on the
			// base for their own reasons. The probe DISCRIMINATES rather than merely reporting zero: the
			// `Array` spelling above is the positive control, and it is the one that moved.
			if not tagIsByteRecord(self.tagOf(arr)) 'notAByteRecord'
				throw SourceParseError.unsupported("`{String.from(ManagedMemoryTypeName)}` {SurfaceMemberNoun} '{String.from(methodTok.value)}' reached a receiver that is not a {String.from(StringConformerName)}'s or a {String.from(CharacterConformerName)}'s own buffer — `{String.from(CharAtName)}` reads the single-byte-grapheme flag one slot past a bare buffer record; call it through a {String.from(StringConformerName)} or {String.from(CharacterConformerName)} receiver", line: methodTok.line, column: methodTok.column)
			end 'notAByteRecord'

			let window = try self.parseTwoBuiltinIntegerArgList(func, firstParam: ManagedMemoryCharPosParamName, secondParam: ManagedMemoryCharLenParamName, methodTok: methodTok)
			let startPos = try window.get(0) otherwise panic("makeCharFromBytes: parseTwoBuiltinIntegerArgList returned fewer than the two arguments it consumes")
			let byteLen = try window.get(1) otherwise panic("makeCharFromBytes: parseTwoBuiltinIntegerArgList returned fewer than the two arguments it consumes")
			return self.emitOwnedRuntimeResult(CharAtName, args: threeArgs(arr, second: startPos, third: self.emitMachineWordBinOp(startPos, rhs: byteLen, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)), resultTag: ValueTypeTag.character, resultNameId: UnnamedTypeId, range: range)
		end 'makeCharFromBytes'

		// ⭐ **ONE OF THE TWO DOORS THAT MINT A `cstring`** — the other is `String.cstr()`, whose whole body is
		// this call. The result is a raw address into the RECEIVER's buffer and is owned by the receiver, so
		// nothing is enrolled for a drop; what the tag buys is the type rule, not a width or a lifetime.
		if isManagedMemory and methodTok.value.equals(ManagedMemoryToCStringMethod) 'toCString'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(MmToCStringName, args: argsOf(arr), resultTag: ValueTypeTag.cstring, resultNameId: UnnamedTypeId, range: range)
		end 'toCString'

		// Buffer-surface only, for `remove`'s reason: `Array.capacity()` is
		// `stdlib/Array.maxon:154`'s `managed.capacity()`, which is this arm reached from source.
		if isManagedMemory and methodTok.value.equals(ArrayCapacityMethod) 'capacity'
			try self.consumeEmptyArgList()
			return self.emitLibraryAliasedRuntimeCall(ManagedCapacityName, args: argsOf(arr), alias: ReportedCapacityAliasName, range: range)
		end 'capacity'

		// ⭐ **`elementSize()` — THE BUFFER'S STRIDE, AND THE ONE MEMBER THAT REPORTS A REPRESENTATION**
		// (`specs/ranged-int-bit-packing.md`, `specs/bool-bit-packing.md`). It is on the BUFFER surface only,
		// like `length`/`byteAt`: `Array` has no such spelling in either reference, and a program reaches it
		// through `arr.managed.elementSize()`.
		//
		// ⚠ The result is a plain `int` and NOT the element's own type: it is a negative bit width for a
		// packed element, which no element's declared range admits, and the specs compare it against `-1`/
		// `-2`/`-4` as ordinary integers.
		if isManagedMemory and methodTok.value.equals(ManagedMemoryElementSizeMethod) 'elementSize'
			try self.consumeEmptyArgList()
			return self.emitLibraryAliasedRuntimeCall(ManagedElementSizeName, args: argsOf(arr), alias: FullRangeIntAliasName, range: range)
		end 'elementSize'

		// ⭐ **THE VOID MUTATORS — AND EACH REFUSES VALUE POSITION FROM INSIDE ITS OWN ARM**
		// (`requireVoidMethodIsStatement`, whose header carries the measurement). One call HERE, ahead of them
		// all, is reached by an UNKNOWN name too, so a typo is told the
		// method exists and is void instead of being handed the roster below. It is the first statement of
		// each arm rather than a shared line, so it still beats every argument diagnostic, and it is
		// reachable only once a real void method NAME has matched.
		if methodTok.value.equals(ArrayPushMethod) 'push'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			let value = try self.parseContainerElementArg(func, giid: giid, methodTok: methodTok)
			return self.emitArrayVoidCall(ManagedPushName, args: twoArgs(arr, second: value), receiver: arr, range: range)
		end 'push'

		if methodTok.value.equals(ArrayResizeMethod) 'resize'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			try self.requireArrayGrowthHasZeroElement(giid, tok: methodTok, refusal: ZeroElementRefusal.arrayResize)
			let n = try self.parseArrayOneArg(func)
			try self.requireArmServedIndexArgument(giid, member: methodTok.value, value: n, anchor: methodTok, bufferSurface: isManagedMemory)
			return self.emitArrayVoidCall(ManagedResizeName, args: twoArgs(arr, second: n), receiver: arr, range: range)
		end 'resize'

		// ⭐ **`clear` IS BUFFER-SURFACE ONLY**, for `remove`'s reason above and by its gate. The
		// `Array` spelling is `stdlib/Array.maxon`'s, whose whole body is this same `managed.clear()` — one
		// runtime, reached from source instead of from an arm.
		if isManagedMemory and methodTok.value.equals(ClearMethod) 'clear'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			try self.consumeEmptyArgList()
			return self.emitArrayVoidCall(ManagedClearName, args: argsOf(arr), receiver: arr, range: range)
		end 'clear'

		// ⭐⭐ **ONE ARM FOR ALL THREE SPELLINGS OF ONE OPERATION — `Array.append`, `Array.appendMemory` AND THE
		// BUFFER'S `append` — BECAUSE THE CORPUS BUILDS EACH OUT OF THE LAST.** `stdlib/Array.maxon:259` is
		// `append(other Self)` whose entire body is `appendMemory(other.managed)` — the array half of `other` is
		// never read — and `:272` is `appendMemory(source ElementMemory)`, whose own body is the buffer's
		// `append`. Post-collapse `ElementMemory` and `Self` are one record, so there is no second operation to
		// emit at any of the three: `parseArrayAppend` copies the source's elements into the receiver's storage
		// at whatever elementhood the receiver has.
		//
		// ⚖ The buffer shares this callee because its `append` does not throw: `stdlib/String.maxon:428`
		// declares a non-throwing `append` over a bare `managed.append(other.managed)` that cannot
		// compile otherwise. The whole argument is at `ManagedMemoryRuntime.ManagedAppendName`.
		//
		// ⭐ **AND THE SPLIT WAS NOT MERELY REDUNDANT, IT WAS A WRONG ANSWER**: the buffer callee byte-blitted
		// whatever the receiver held, so `a.managed.append(b.managed)` on an `Array with String` duplicated each
		// heap pointer and double-freed it (MEASURED: SIGSEGV at teardown). Reaching the shared door instead
		// picks the MANAGED and OPAQUE emissions by element kind, exactly as the `Array` spelling always did —
		// which is what identifies this as one operation the surfaces had come to disagree about.
		//
		// ⚠ **WHAT DOES NOT FOLD IS THE SURFACE**, in either direction:
		//   • The ARGUMENT SENTENCE stays per-surface (`parseArrayAppend`'s `bufferSurface`): the buffer's
		//     parameter is declared `__ManagedMemory`, so a mismatch names that type, where `Array.append`'s
		//     names the receiver's own instance. `builtin-type-checking.error-managed-memory-append-int` pins
		//     the first and `arrays.error.append-narrower-element-array` the second. One rule
		//     (`ProgramSignatures.arrayAppendArgAdmits`), two sentences.
		//   • `appendMemory` remains an `Array` NAME and only an `Array` name — the `length`/`count`
		//     arrangement. The corpus declares it on `Array` and on nothing else, so a buffer receiver asking
		//     for it is refused by the roster gate above and never reaches here.
		if methodTok.value.equals(AppendMethod) or methodTok.value.equals(AppendMemoryMethod) 'append'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			try self.requireArrayCopyMethodSupported(giid, methodTok: methodTok)
			return try self.parseArrayAppend(func, arr: arr, giid: giid, methodTok: methodTok, bufferSurface: isManagedMemory, range: range)
		end 'append'

		// ⭐⭐ **THE TWO `__ManagedMemory` MUTATORS — `setLength` and `setByte`.** VOID and THROWING,
		// which is why they sit with the void mutators (each opening with `requireVoidMethodIsStatement`,
		// so a value-position use is the void-result refusal) rather than with the throwing ACCESSORS
		// above, which all yield a value.
		//
		// ⚠ **NEITHER IS AN ALIAS OF THE `Array` METHOD IT RESEMBLES, and folding either would be a silent
		// wrong answer.** `resize` GROWS the capacity to fit where `setLength` must REFUSE a length above it —
		// `stdlib/Array.maxon:373-382` builds `resize` out of `reserve` THEN `setLength` for exactly that
		// reason — and `set` addresses ELEMENTS where `setByte` addresses BYTES, which coincide at element
		// size 1 and at no other size. See `ManagedMemoryRuntime.ManagedSetLengthName`.
		//
		// ⚠⚠ **THEY GO THROUGH `emitRuntimeCall`, NOT `emitArrayVoidCall`, AND THAT IS NOT A STYLE CHOICE.**
		// `emitArrayVoidCall` returns the RECEIVER as the expression's value, which is right for the
		// NON-throwing mutators around it (`arr.push(x)` yields something for a statement to be). Under a
		// `try` it makes the TRY's value the array — an owned managed record — and the try's ok/error
		// reconciliation then acts on it: MEASURED as an access violation on the first `setByte` of a freshly
		// created buffer. `parseArraySet` reaches `emitRuntimeCall` for the identical reason — it is throwing on
		// every surface that still has it, so nothing here has to choose.
		//
		// ⭐ **THE GATE IS A PROVENANCE TEST (`isManagedMemory` above), NOT AN ELEMENT TEST.** Under an element
		// test a `b"…"` literal and a `__ManagedMemory.create(n, 1)` are the same instance, so all three
		// members become visible on a user's `ByteArray` too, which the language does not give it. As it
		// stands, `"ab".toByteArray().setLength(0)` is the ordinary unknown-`Array`-method E2015 and only a
		// real buffer reaches these arms.
		if isManagedMemory and methodTok.value.equals(ManagedMemorySetLengthMethod) 'setLength'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			let newLength = try self.parseOneBuiltinIntegerArgList(func, paramName: ManagedMemoryNewLengthParamName, methodTok: methodTok)
			try self.requireZeroIsAnElement(giid, tok: methodTok, refusal: ZeroElementRefusal.bufferSetLength)
			return self.emitRuntimeCall(ManagedSetLengthName, args: twoArgs(arr, second: newLength), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'setLength'

		if isManagedMemory and methodTok.value.equals(ManagedMemorySetByteMethod) 'setByte'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			try self.requireBufferBytesAreNotAPointer(giid, methodTok: methodTok)

			// ⭐⭐ **THE RAW-BYTE WRITER ANSWERS TO ITS SLOT, AT EVERY STRIDE (E3118).** `setByte`
			// addresses a byte OFFSET, so on a record striding more than a byte it writes a FRAGMENT of an
			// element — and what the ARRAY surface reads back afterwards is an arbitrary unsigned value of
			// that element's whole SLOT. One question, one rule, whatever the width.
			//
			// ⛔⛔ **THE STRIDE IS AN INPUT TO THE ONE RULE, NOT A PRECONDITION OF IT.** Asking "does the element hold every
			// byte" behind a stride precondition lets through four silent wrong answers: `typealias Wide = int(0 to 1000)`
			// reading back **57089**, `int(-5 to 5)` reading back **223** (the unsigned ladder keeps it a machine word
			// without filling one), a `bool` element for which `v` and `not v` were BOTH true, and an ENUM
			// element on which the program compiled and then HUNG on an ordinal no arm names. So the rule
			// (`ProgramSignatures.elementAdmitsEverySlotValue`) asks `rangeHoldsEveryByte` at a
			// one-byte slot and the slot's own value set above it.
			//
			// ⚠⚠ **THAT IS NOT E3117 WIDENED, AND WIDENING IT IS THE MEASURED WRONG ANSWER IN THE OTHER
			// DIRECTION.** "Holds every byte" asked at a wider slot refuses `Array with Int` — three
			// `managed-memory-methods` cases stop compiling if it is done,
			// `IntArray.create()` staging a low byte told about a range a machine word obviously holds. E3117
			// keeps the two fills that ARE byte-per-element by contract (`parseByteView`, whose fill is
			// element-wise at whatever stride, and `__ManagedFile.read`, whose argument gate has already
			// established a byte-packed buffer); this site is not one because its construct never asks that
			// question except at one width.
			//
			// ⚠ **THE PREREQUISITE IS SETTLED ONE DOOR AWAY**: a
			// `__ManagedMemory.create(n, 1)` in a file whose `Byte` is two bytes would be TYPED stride 2 over a
			// record stamped stride 1 (`set(0, value: 300)` reads back **44**), the incoherence the same file's `b"…"`
			// literal is refused for. Both producers go through
			// `requireBytePackedRecordStridesLikeThisFilesByte`, so no receiver reaching here disagrees with
			// its own record about its stride — which is what makes a slot question answerable at all.
			//
			// ⚠ Its `byteAt` dual two arms up is untouched whatever the slot — it yields a plain `int`,
			// never the element — which is the one place this rule and E3110's pair part company; see
			// `requireRawByteFillFitsItsElement`.
			try self.requireRawByteWriteFitsItsSlot(giid, methodTok: methodTok)

			// The RECEIVER is argument 0, so the two-int list's array is prepended to rather than rebuilt —
			// the arg-list protocol stays in its one home and the receiver is added where it belongs.
			let args = try self.parseTwoBuiltinIntegerArgList(func, firstParam: ManagedMemoryOffsetParamName, secondParam: ManagedMemoryValueParamName, methodTok: methodTok)
			args.insert(0, value: arr)
			return self.emitRuntimeCall(ManagedSetByteName, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'setByte'

		// ⭐ **`grow(newCapacity)` — THE BUFFER'S CAPACITY RAISER.** Void and throwing, so it belongs
		// with these two and takes `emitRuntimeCall` for their reason: under a `try`, `emitArrayVoidCall` would
		// make the try's value the owned array record and the reconciliation would act on it (measured as an
		// access violation, see above).
		//
		// ⚠ It is NOT `reserve` under another name: `reserve` GROWS by the doubling policy and never
		// complains, `grow` raises the capacity to EXACTLY what it is asked for and THROWS `invalidCapacity`
		// when asked to lower it. `specs/managed-memory-builtin.md:grow` asserts the exact capacity.
		if isManagedMemory and methodTok.value.equals(ManagedMemoryGrowMethod) 'grow'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)
			let newCapacity = try self.parseOneBuiltinIntegerArgList(func, paramName: ManagedMemoryNewCapacityParamName, methodTok: methodTok)
			return self.emitRuntimeCall(ManagedMemGrowName, args: twoArgs(arr, second: newCapacity), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'grow'

		// ⭐⭐ **`fill(start, count:, value:)` — THE WHOLE-WINDOW ELEMENT WRITE, AND THE ONE BUFFER MEMBER THAT
		// ANSWERS A `bool`.** `stdlib/Array.maxon`'s `refill`/`growFilled` call it and keep their
		// per-element loop as the arm it DECLINES; see `ManagedMemoryRuntime.ManagedFillName` for why a
		// managed element is declined rather than served, and `buildManagedFill` for the window's bounds.
		//
		// ⚠⚠ **THE VALUE IS TYPE-CHECKED AND THEN LEFT ALONE — `moveElementIntoContainer` MUST NOT RUN HERE,
		// AND CALLING IT WOULD BE A LEAK ON THE ONE PATH THIS MEMBER EXISTS FOR.** Every other element-store
		// door moves the value in, because the container becomes its owner; this one stores it only when the
		// element is TRIVIAL, which owns nothing. For a managed or opaque element the move-in would take a
		// reference (`coOwnBorrowedOpaque` inside the shared `Array` body) that the runtime's decline
		// then never stores — and the value the caller still holds is the one the fallback loop is about to
		// take its own references through.
		//
		// ⚠ `containerElementWord` still runs, and it is the half that is NOT ownership: a `float` element
		// travels as its 64 bits, and the read back (`emitContainerElementAccessor`) reverses exactly this
		// conversion. Skipping it would put a double in a slot every reader takes for a bit pattern.
		//
		// ⚠ **NO MANAGED-ELEMENT GATE, unlike `set`'s E3109.** That refusal is about a write landing in the
		// UNOWNED staging region `[length, capacity)`; this window is bounded by the LIVE length and stores
		// nothing at all for a managed element, so there is no ownership for it to get wrong — and `refill`
		// on an `Array with String` is precisely the program that has to reach here.
		//
		// ⚠ It takes `emitRuntimeCall` rather than `emitArrayVoidCall` for the reason `setLength` states, and
		// needs no `requireVoidMethodIsStatement`: the call HAS a value, and it is the answer the caller must
		// read.
		if isManagedMemory and methodTok.value.equals(ManagedMemoryFillMethod) 'fill'
			try self.consume(TokenKind.leftParen)
			let start = try self.parseBuiltinIntegerArg(func, paramName: ManagedMemoryStartParamName, methodTok: methodTok)
			try self.consumeArrayArgLabel(ManagedMemoryCountParamName, required: false)
			let count = try self.parseBuiltinIntegerArg(func, paramName: ManagedMemoryCountParamName, methodTok: methodTok)
			try self.consumeArrayArgLabel(ManagedMemoryValueParamName, required: false)
			let valueStart = self.pos
			self.stateContainerElementLiteralTargets(giid, valueStart: valueStart)
			let raw = try self.parseExpression(func, block: self.bodyState.currentBlock)
			let checked = try self.requireContainerElementType(giid, value: raw, valueStart: valueStart, methodTok: methodTok)
			try self.consume(TokenKind.rightParen)
			let element = self.containerElementWord(checked, giid: giid, range: SourceRange.ofToken(self.tokenAt(valueStart)))
			return self.emitRuntimeCall(ManagedFillName, args: fourArgs(arr, second: start, third: count, fourth: element), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'fill'

		// ⭐⭐ **THE THREE RELOCATORS — void, throwing, two integer arguments each, and BUFFER-SURFACE ONLY.**
		// Neither reference gives `Array` any of these spellings: the corpus reaches them through
		// `managed.swap`/`managed.shiftRight` from inside `stdlib/Array.maxon` and
		// `stdlib/helpers/sort/smallSort.maxon`, and the `Array` methods built ON them (`insert`, `remove`,
		// `Array.swap`) are the surface a program is meant to see.
		//
		// ⚠ **THEY TAKE `emitRuntimeCall` FOR `grow`'s MEASURED REASON**: under a `try`, `emitArrayVoidCall`
		// would make the try's value the owned array record and the reconciliation would act on it (an access
		// violation — see the note above `setLength`).
		//
		// ⚠⚠ **NO MANAGED-ELEMENT GATE, AND THAT IS THE GROUP'S DEFINING PROPERTY RATHER THAN AN OVERSIGHT.**
		// `set` is refused for a managed element (E3109) because it takes OWNERSHIP of a value it was handed,
		// into a slot above `length` that nobody owns; `setByte`/`byteAt` are refused (E3110) because they read
		// or write a pointer as though it were data. A relocator does neither: it moves words the buffer
		// ALREADY OWNS between slots the buffer already owns, so the live multiset — and every element's
		// refcount — is invariant across it and the element's kind never enters the question.
		// `ManagedMemoryRuntime.ManagedMemSwapName`'s header carries that argument in full, and it is the same one that
		// makes `swap` unbuildable out of `get` + `set`.
		if isManagedMemory and methodTok.value.equals(ManagedMemorySwapMethod) 'swap'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)

			// The RECEIVER is argument 0, so the two-int list is prepended to rather than rebuilt — the
			// arg-list protocol stays in its one home, exactly as `setByte` above does it.
			let swapArgs = try self.parseTwoBuiltinIntegerArgList(func, firstParam: ManagedMemorySwapFirstParamName, secondParam: ManagedMemorySwapSecondParamName, methodTok: methodTok)
			swapArgs.insert(0, value: arr)
			return self.emitRuntimeCall(ManagedMemSwapName, args: swapArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'swap'

		if isManagedMemory and (methodTok.value.equals(ManagedMemoryShiftRightMethod) or methodTok.value.equals(ManagedMemoryShiftLeftMethod)) 'shift'
			try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)

			// ⚠ ONE ARM FOR THE PAIR, because they differ ONLY in the DIRECTION — same two parameters, same
			// labels, same capacity bound, same thrown case. The direction IS the callee, so it is chosen here
			// and nothing else in the arm branches on it; two arms would have been one argument protocol
			// written twice.
			let shiftCallee = ManagedMemShiftRightName if methodTok.value.equals(ManagedMemoryShiftRightMethod) else ManagedMemShiftLeftName
			let shiftArgs = try self.parseTwoBuiltinIntegerArgList(func, firstParam: ManagedMemoryIndexParamName, secondParam: ManagedMemoryCountParamName, methodTok: methodTok)
			shiftArgs.insert(0, value: arr)
			return self.emitRuntimeCall(shiftCallee, args: shiftArgs, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'shift'

		// ⭐⭐ **`createCursor()` — THE BUFFER'S ONE PRODUCER OF A `__ManagedMemoryCursor with Element`.**
		// Throwing (an EMPTY buffer has no valid position to start at) and OWNED: the cursor is its own
		// `__mm_alloc` box holding a RETAINED source, so it is tracked as an owned temp and drops at scope exit
		// through `genericInstanceBoxDropCallee` → `__managed_cursor_decref`, exactly as a `.create()`d container
		// drops through `__managed_decref`.
		//
		// ⚠ **THE RESULT'S ELEMENT IS DERIVED FROM THE RECEIVER'S INSTANCE, NOT RE-INFERRED**
		// (`managedMemoryCursorInstanceFor`), so a `current()` hands back the element the buffer actually
		// holds and the two cannot disagree about what that is.
		//
		// ⚠ **THE CURSOR IS NOT MARKED AS THE BUFFER SURFACE, and that is the one thing a reader of the
		// `slice` arm above might expect.** A slice of a buffer IS a buffer — same record, same members — so
		// its surface rides the value. A cursor is a DIFFERENT record with a disjoint member list, and it
		// carries its surface in its TYPE (`MemberSurface.cursor`, reached off the instance) rather than in
		// the provenance table, because unlike the buffer it does not share a `GenericInstanceId` with anything.
		if isManagedMemory and methodTok.value.equals(ManagedMemoryCreateCursorMethod) 'createCursor'
			try self.consumeEmptyArgList()
			let cursor = self.emitOwnedRuntimeResult(ManagedCursorCreateName, args: argsOf(arr), resultTag: ValueTypeTag.genericInstance, resultNameId: self.signatures.managedMemoryCursorInstanceFor(giid) as TypeNameId, range: range)

			return cursor
		end 'createCursor'

		// ⚠⚠ **NO RECEIVER OF EITHER SURFACE CAN REACH HERE, AND THIS IS THE CHECK THAT SAYS SO**
		// The roster gate at the top admitted only the names
		// `surfaceMemberNames` lists, and each of those matches an arm on its own spelling and at most on the
		// surface that gate had already established — so arriving here means a roster gained a member and the
		// dispatch did not. That is the surface-mismatch defect one level up, and the wrong answer it would otherwise give is
		// unusually convincing: the reader would be handed the roster refusal for a member the roster
		// PROVIDES. It cannot be caught earlier than the call that reveals it (an arm is a control-flow
		// position, not an entry a table can enumerate at install time), so it is caught here, loudly, rather
		// than described in a comment nobody re-reads.
		// ⭐ **VERIFIED RED, once per roster**: pushing `ManagedMemoryCreateMethod` onto the buffer roster and
		// writing `mm.create()` reaches this panic, as does pushing a bogus name onto
		// `arraySurfaceMemberNames` and calling it — each naming the member and both
		// remedies, not the roster refusal.
		let drift = rosterDriftMessage("dispatchArrayMethod", member: methodTok.value, roster: roster, rosterFuncs: "`arraySurfaceMemberNames`/`bufferSurfaceMemberNames`")
		panic("{drift}")
	end 'dispatchArrayMethod'

	// ⭐⭐ **REFUSE A WRITE TO AN IMMUTABLE CONTAINER (E3207) — ONE RULE, ONE HOME, FOR EVERY CONTAINER AND
	// EVERY CALL THAT WRITES ONE.** The container is a method's receiver (`noteReceiverWrite`) or the buffer
	// argument a writing builtin fills (`noteArgumentWrite`: the append intrinsics, `fillRandom`, `read`,
	// `readAppending`, `recv`), spelled by the tokens `[placeStart, placeEnd)`. The writability of the
	// binding and the refusal live here, so no container and no builtin can give its own answer to the same
	// question. The refusal is deferred (`deferRegionRefusal`), not thrown.
	//
	// ⭐⭐ **IT ALSO RECORDS THE WRITE IT PERMITS, AND THE TWO HALVES ARE ONE DECISION.** A write through a
	// container that denotes a PARAMETER's record is a mutation of that parameter, which is exactly what the
	// call-site half (`SemanticCheck.buildParamMutationSummary`) must know about the enclosing function.
	// `owner` is the narrow answer read ALONE at a method's receiver slot (NO for a self-field write; see
	// `receiverOwnerMask` and `argumentOwnerMask`); `storage` is which parameter's record this container
	// denotes, which the immutable-global column's union below needs and which the receiver slot must not
	// read. See `IrFunction`'s table, which is where the columns are defined.
	function noteContainerWrite(func IrFunction, written ValueId, blame immutable ByteArray, owner ParamPositionMask, storage ParamPositionMask, callTok Token)
		if not blame.isEmpty() and tagIsByteRecord(self.tagOf(written)) 'aTextIsReassignedByItsOwnMethod'
			self.deferRegionRefusal(ErrorCode.assignToImmutable, message: letReassignedMessage(String.from(blame)), line: callTok.line, column: callTok.column)
			return
		end 'aTextIsReassignedByItsOwnMethod'

		func.writtenParamMask = func.writtenParamMask or owner
		self.noteUseSite(func, value: written, mutable: true, line: callTok.line)

		// ⭐ **THE IMMUTABLE-GLOBAL COLUMN TAKES THE UNION OF BOTH**, because it asks the widest of the three questions —
		// "does this body write the record this parameter denotes, at all?" — and each of the other two is
		// narrowed away from it in a different direction (see `IrFunction.writesThroughParamMask`). Both
		// answers are already in hand here, decided about the same receiver at the same instant, so the union
		// costs nothing and cannot fall out of step with either. ⚠ It is keyed on `mutatesReceiver`:
		// `ml.insertLast(x)` frees no node but does write the record, which is exactly the question this column asks.
		func.writesThroughParamMask = func.writesThroughParamMask or owner or storage
	end 'noteContainerWrite'

	// What stays per-container is only WHICH METHOD NAMES WRITE THE RECEIVER, which the caller passes as
	// `mutatesReceiver`; a read-only method passes straight through.
	function noteReceiverWrite(func IrFunction, receiver ValueId, immutableReceiverName immutable ByteArray, receiverOwner ParamPositionMask, receiverStorage ParamPositionMask, methodTok Token, methodIndex ElementIndex, mutatesReceiver bool)
		if not mutatesReceiver 'readOnlyMethod'
			return
		end 'readOnlyMethod'

		let place = self.receiverPlaceBefore(methodIndex)
		self.requireWrittenOperandNotImmutable(receiver, place: place, calleeTok: methodTok, noun: "receiver")
		self.noteContainerWrite(func, written: receiver, blame: immutableReceiverName, owner: receiverOwner, storage: receiverStorage, callTok: methodTok)
	end 'noteReceiverWrite'

	function textIsReadFromASlot(operand ValueId) returns bool
		return tagIsByteRecord(self.tagOf(operand)) and self.valueIsASlotRead(operand)
	end 'textIsReadFromASlot'

	function requireWrittenOperandNotImmutable(operand ValueId, place(ElementIndex, ElementIndex), calleeTok Token, noun String)
		if (self.valueIsAValueType(operand) and not self.textIsReadFromASlot(operand)) or self.effectiveCapabilityOf(operand) != ValueCapability.immutable 'writable'
			return
		end 'writable'

		let subject = self.operandSubject(place.0, alone: place.1 == place.0 + 1, spelled: String.from((self.tokenAt(place.1 - 1)).value))
		self.deferRegionRefusal(ErrorCode.semanticArgumentCapabilityRefused, message: needsWritableRefusal("'{String.from(calleeTok.value)}' needs a writable {noun}", subject: subject, capability: ValueCapability.immutable), line: calleeTok.line, column: calleeTok.column)
	end 'requireWrittenOperandNotImmutable'

	function noteWrittenArgument(func IrFunction, args ValueIdArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, calleeTok Token, position ParamCount = 0)
		let written = try args.get(position) otherwise panic("noteWrittenArgument: a write names the argument it writes, and the call has none at {position}")
		let placeStart = try argAnchors.get(position) otherwise panic("noteWrittenArgument: an argument pushed into `args` pushes its anchor with it")
		let placeEnd = (try argAnchors.get(position + 1) otherwise self.pos) - 1

		self.noteArgumentWrite(func, written: written, blame: argImmutableNameAt(argImmutableNames, index: position), placeStart: placeStart, placeEnd: placeEnd, calleeTok: calleeTok)
	end 'noteWrittenArgument'

	function noteArgumentWrite(func IrFunction, written ValueId, blame immutable ByteArray, placeStart ElementIndex, placeEnd ElementIndex, calleeTok Token)
		self.requireWrittenOperandNotImmutable(written, place: (placeStart, placeEnd), calleeTok: calleeTok, noun: "argument")
		let subjectName = self.storageSubjectNameAt(placeStart)
		let storage = self.subjectStorageMask(func, subjectName: subjectName)
		let owner = self.argumentOwnerMask(subjectName, storage: storage, spansOneToken: placeEnd == placeStart + 1)

		self.noteContainerWrite(func, written: written, blame: blame, owner: owner, storage: storage, callTok: calleeTok)
	end 'noteArgumentWrite'

	function argumentOwnerMask(subjectName StorageSubject, storage ParamPositionMask, spansOneToken bool) returns ParamPositionMask
		if not spansOneToken 'aChainOffAName'
			return NoParamPositions
		end 'aChainOffAName'

		let name = try subjectName.storageName() otherwise return NoParamPositions

		if self.bodyState.scope.getInfo(name).isSelfField 'ownedByTheTypeNotTheCaller'
			return NoParamPositions
		end 'ownedByTheTypeNotTheCaller'

		return storage
	end 'argumentOwnerMask'

	// The token past the call of the method at `methodIndex` — past its argument list's closing paren, which is when
	// the write happens: an argument is read before it.
	function callEndAfter(methodIndex ElementIndex) returns ElementIndex
		var q = methodIndex + 1

		if self.kindAt(q) != TokenKind.leftParen 'noArguments'
			return q
		end 'noArguments'

		var depth = 0 as NestingDepth

		while self.kindAt(q) != TokenKind.eof 'eachToken'
			if self.kindAt(q) == TokenKind.leftParen 'opens'
				depth = depth + 1
			end 'opens'

			if self.kindAt(q) == TokenKind.rightParen 'closes'
				depth = depth - 1

				if depth == 0 'theCallsOwn'
					return q + 1
				end 'theCallsOwn'
			end 'closes'

			q = q + 1
		end 'eachToken'

		return q
	end 'callEndAfter'

	// The tokens, as `[start, end)`, that spell the receiver of the method at `methodIndex`: the chain of names ending at
	// the dot before the method, or the method's own name when what precedes the dot is no such chain.
	function receiverPlaceBefore(methodIndex ElementIndex) returns (ElementIndex, ElementIndex)
		if methodIndex < 2 'noReceiver'
			return (methodIndex, methodIndex + 1)
		end 'noReceiver'

		let start = try self.callChainStartEndingAt(methodIndex - 2) otherwise return (methodIndex, methodIndex + 1)
		return (start, methodIndex - 1)
	end 'receiverPlaceBefore'

	function callChainStartEndingAt(last ElementIndex) returns ElementIndex throws AbsentError
		var at = last

		while true 'eachHop'
			if self.kindAt(at) == TokenKind.rightParen 'aCallsArguments'
				if at < 1 'noCallee'
					throw AbsentError.absent
				end 'noCallee'

				at = try self.openingParenBefore(at) - 1
			end 'aCallsArguments'

			if not tokenCanBeAName(self.tokenAt(at)) 'notAName'
				throw AbsentError.absent
			end 'notAName'

			if at < 2 or self.kindAt(at - 1) != TokenKind.dot 'theChainStarts'
				return at
			end 'theChainStarts'

			at = at - 2
		end 'eachHop'

		throw AbsentError.absent
	end 'callChainStartEndingAt'

	function openingParenBefore(closeIndex ElementIndex) returns ElementIndex throws AbsentError
		var depth = 0 as ElementIndex
		var at = closeIndex

		while at > 0 'eachToken'
			if self.kindAt(at) == TokenKind.rightParen 'closes'
				depth = depth + 1
			end 'closes'

			if self.kindAt(at) == TokenKind.leftParen 'opens'
				depth = depth - 1

				if depth == 0 'theMatchingOne'
					return at
				end 'theMatchingOne'
			end 'opens'

			at = at - 1
		end 'eachToken'

		throw AbsentError.absent
	end 'openingParenBefore'

	// ⭐ **WHICH OF THE ENCLOSING FUNCTION'S PARAMETERS THIS RECEIVER'S RECORD BELONGS TO** — the bits
	// `noteReceiverWrite` sets when the write goes ahead, and 0 for a receiver that denotes storage no
	// parameter owns (a local, a temporary, a top-level global).
	//
	// ⚠ **THIS IS A QUESTION ABOUT THE VALUE, WHERE `VarInfo.isParameter` IS ONE ABOUT THE BINDING, AND THE
	// TWO MUST NOT BE UNIFIED.** `immutableReceiverNameOf` needs `isParameter` because `let a = p` is not
	// the parameter even though it carries `p`'s ValueId. Here the opposite is wanted: `var b = p`
	// followed by `b.push(9)` writes the CALLER's array, so the mutation belongs to `p`. The parameter
	// ValueId convention (`bindParameters` reserves 0..paramCount-1 and `mintValue` starts above it) is what
	// makes "this value IS parameter k" decidable, and it is the right test for THIS question only.
	//
	// ⭐⭐ **A SELF-FIELD ALIAS OWNS NOTHING IN THIS MASK.** A method writing its own receiver's fields
	// makes a caller's read-only receiver an error, but that answer comes from the summary's provenance
	// column (`SemanticCheck.buildParamMutationSummary`), not from this mask.
	//
	// ⚠ There is exactly ONE self-field store (`emitCheckedSelfFieldStore`, deliberately — see its
	// header), so `self.total = self.total + value` and `total = total + value` cannot reach different
	// verdicts on one write.
	//
	// ⚠ The arm is EXPLICIT rather than left to the value test below, because a self-field alias's
	// `boundValue` is 0 — `createSelfField` leaves it so — and 0 is `self`'s own id, so the value test would
	// mark parameter 0 for the wrong reason, off the very coincidence `requireStructBase`'s header records
	// three measured miscompiles from.
	//
	// The value test itself is exact rather than approximate: `bindParameters` reserves ids
	// `0..paramCount-1` for the parameters and `mintValue` starts above them, so no body value can collide
	// with a parameter's id. ⭐ It is `paramMaskOfValue` rather than inline: `receiverStorageMask`
	// asks the identical question of the identical value, and so does the self-field STORE door, so the
	// question has three askers.
	//
	// ⭐⭐⭐ **THE ONE SELF-FIELD THIS MASK DOES ANSWER: A FUSED WRAPPER'S INLINE `managed`.** `type String`'s
	// `managed` is the 40-byte `__ManagedMemory` EMBEDDED WHOLE at offset 0 — the ENVELOPE COLLAPSE
	// (`StructLayout.isInlineManagedField`), whose whole point is that **a String IS its own
	// `__ManagedMemory`** — so `managed.append(…)` inside `String.append` writes the very record the
	// CALLER's binding denotes, byte for byte, and refusing it is what keeps `s.append(" world")` off an
	// `.rdata` literal.
	//
	// ⚠ The line is the envelope collapse, not "the field is managed": `Bag.items` is an 8-byte POINTER to
	// storage the Bag owns, where `String.managed` is the record itself, and keyed on the collapse this arm
	// cannot see `Bag` at all, because `Bag` declares no builtin literal marker. **The four conformers are
	// `String`, `Character`, `Array` and `FixedArray`.**
	//
	// ⚠ **IT SETS THE RECEIVER COLUMN ONLY.** `receiverStorageMask` below answers for the record-write
	// column.
	function receiverOwnerMask(func IrFunction, binding VarInfo, baseTok Token) returns ParamPositionMask throws SourceParseError
		if binding.isSelfField 'ownedByTheTypeNotTheCaller'
			// ⛔ **BOUND FIRST, NEVER `if try …` — MEASURED, AND IT IS A SILENT WRONG ANSWER.** Written as
			// `if try self.selfFieldIsInlineManaged(…) 'label'` this arm fired for `type Bag`'s plain
			// `items` field, on which the predicate is provably FALSE (probed: `conforms=false`,
			// `fieldIndex=0`, `inlineIdx=1`) — so every `let`-bound struct with a container field was
			// refused with E3207. `dispatchMethodOnBinding`'s own use of this predicate already states the
			// rule — *"which needs a `try` and so cannot join a condition chain"* — and this is the
			// measurement behind it.
			let theRecordIsTheReceiver = try self.selfFieldIsInlineManaged(binding, baseTok: baseTok)

			if theRecordIsTheReceiver 'theFieldIsTheReceiversOwnRecord'
				return self.enclosingSelfParamMask(func)
			end 'theFieldIsTheReceiversOwnRecord'

			return NoParamPositions
		end 'ownedByTheTypeNotTheCaller'

		return paramMaskOfValue(func, value: binding.boundValue)
	end 'receiverOwnerMask'

	// ⭐ **THE ENCLOSING METHOD'S RECEIVER, AS A MASK** — shared by the two masks above and below, which both
	// reach it for a self-field alias and would otherwise spell one lookup and one panic twice. The
	// parameter INDEX is DERIVED (`self` resolved through the scope) rather than assumed to be 0: the
	// convention that binds it there lives in `bindParameters`, and restating it here would be a second copy
	// of it.
	function enclosingSelfParamMask(func IrFunction) returns ParamPositionMask
		return paramMaskOfValue(func, value: try self.bodyState.scope.lookupValue(SelfParamName) otherwise panic("enclosingSelfParamMask: a self-field alias is in scope but `self` is not — `declareSelfFieldAliases` and `bindParameters` both run at method entry before a body token is read, and neither other path can hold an alias in THIS scope without a receiver (a closure body gets a FRESH scope carrying no alias — a bare self-field name inside one resolves through the CAPTURE path instead, off the enclosing scope; a `static function` installs no alias at all)"))
	end 'enclosingSelfParamMask'

	// ⭐⭐ **THE STORAGE-WRITTEN TWIN OF THE MASK ABOVE: WHICH PARAMETER'S STORAGE A WRITE THROUGH THIS
	// RECEIVER REACHES.** It differs from `receiverOwnerMask` in EXACTLY ONE ARM — a SELF-FIELD alias — and
	// that one arm is the whole point of there being two masks. See `IrFunction`'s table for the pair, and
	// `receiverOwnerMask` above for why the receiver column answers NO there. `items.clear()` inside a method
	// of `Bag` writes storage the CALLER can reach, because the caller handed `b` over as the receiver.
	//
	// The receiver's parameter index is DERIVED rather than assumed to be 0 — see `enclosingSelfParamMask`,
	// the one home that lookup and its panic now have.
	function receiverStorageMask(func IrFunction, binding VarInfo) returns ParamPositionMask
		if binding.isSelfField 'fieldOfTheEnclosingReceiver'
			return self.enclosingSelfParamMask(func)
		end 'fieldOfTheEnclosingReceiver'

		return paramMaskOfValue(func, value: binding.boundValue)
	end 'receiverStorageMask'

	// The shared arm of the two masks above: the parameter `value` IS, as a mask, or none when it is not a
	// parameter at all. The parameter-ValueId convention (`bindParameters` reserves 0..paramCount-1) is what
	// makes the test a comparison rather than a lookup — see `receiverOwnerMask`'s ⚠ block for why this is
	// a question about the VALUE and `VarInfo.isParameter` is a different one about the BINDING.
	function capturedSlotMaskOf(value ValueId) returns ParamPositionMask
		match self.bodyState.capturedSlots 'column'
			unwritten then return NoParamPositions
			entries(bySlot) then return self.capturedSlotBit(try bySlot.get(value) otherwise return NoParamPositions)
		end 'column'
	end 'capturedSlotMaskOf'

	function capturedSlotBit(slot ElementIndex) returns ParamPositionMask
		match self.bodyState.closureEnv 'env'
			param(envValue) then return maskWithParam(NoParamPositions, param: capturedParamPosition(envValue as ParamCount, slot: slot))
			none then panic("capturedSlotBit: a captured read exists only in a closure body, which carries its environment parameter")
		end 'env'
	end 'capturedSlotBit'

	function paramMaskOfValue(func IrFunction, value ValueId) returns ParamPositionMask
		if not valueIsAParameter(value, paramCount: func.paramCount) 'notAParameter'
			return self.capturedSlotMaskOf(value)
		end 'notAParameter'

		return maskWithParam(NoParamPositions, param: paramPositionOfValueId(value))
	end 'paramMaskOfValue'

	// ⭐ **THE STORAGE MASK FOR A WRITE NAMED BY ITS SUBJECT** — the same answer `receiverStorageMask`
	// gives, reached through the ONE subject derivation (`storageSubjectNameAt`). It is what lets an array method reached through a FIELD CHAIN
	// (`bag.items.clear()` inside `function wipe(bag Bag)`) record the write against `bag`, which the
	// receiver-value path has no binding to find.
	function subjectStorageMask(func IrFunction, subjectName StorageSubject) returns ParamPositionMask
		let name = try subjectName.storageName() otherwise return NoParamPositions
		return self.receiverStorageMask(func, binding: self.bodyState.scope.getInfo(name))
	end 'subjectStorageMask'

	// Is this DECLARED type an `Array` instance? Asked by `arrayManagedFieldAt`, the `x.managed` ROUTING
	// question, which holds a declared `MaxonType` rather than a value.
	//
	// ⚠ **THE TAG TEST IS NOT OPTIONAL, AND LEAVING IT OUT IS A WRONG ANSWER RATHER THAN A LOOSE ONE.**
	// `TypeNameId` and `GenericInstanceId` share a numeric space, so `isArrayInstance` asked of a name that
	// is not an instance at all can answer TRUE by coincidence. It is the same two-part test
	// `parseFieldChainCall` makes of a receiver's VALUE, asked here of a type.
	function typeIsArrayInstance(t MaxonType) returns bool
		return self.signatures.isArrayInstanceAt(maxonTypeTag(t), nameId: typeNameIdOf(t))
	end 'typeIsArrayInstance'

	// ⭐ **THE DENSE-GROWTH GATE for `resize`, for `create(n)` with zeroed slots and for a `FixedArray`'s plain
	// `create` (E3106).** `__managed_resize`
	// lengthens by publishing a longer `length@8` over slots `__managed_grow` left ZEROED, and `create(n)`
	// publishes `n` slots of a fresh zeroed buffer; `create(n, zeroed: false)` and a literal-zero capacity
	// publish none and never reach this gate. A zero is an ELEMENT only while the element lives
	// INLINE in the buffer. A MANAGED element lives there as an 8-byte POINTER (`ManagedArrayElementBytes`),
	// and a promise as a pointer into the scheduler's slab, so a zeroed slot of either is NULL — an
	// absence, not a value — and Maxon has no default constructor to make one. The gate therefore asks
	// whether the element OWES A DROP (`containerElementOwesDrop`), not whether it is an `__mm` box: a
	// promise is not one.
	// The array that comes back answers `count()` = N while `get(0)` takes the empty-slot branch of
	// `emitLoadElemAndOkReturn`: a `count()` that does not agree with `get()`, which is a silent wrong answer
	// rather than a missing feature. `push(value)` is the growth that supplies the element. An inline element
	// whose zero is no value (a ranged alias that excludes 0, an enum whose raw values include no 0) is refused
	// the same way, by `requireZeroIsAnElement`.
	//
	// An OPAQUE-`T` element has no element type to name, so it is judged by the instantiation set
	// (`requireEveryInstantiationHasAZero`): `create(n)` in any generic body, and `resize` in a user-tier one,
	// are refused when some instantiation has no zero value. A library body's `resize` is trusted, because a
	// deliberately SPARSE slot table (a hash map's key column, which tracks occupancy in a parallel state
	// column and never reads a slot it did not write) is built through exactly that path.
	//
	// ⚠⚠ **A SECOND THING DEPENDS ON THIS REFUSAL, IN ANOTHER FILE.**
	// `__managed_get_unchecked` — the element read a `for x in arr` loop makes — OMITS the empty-slot arm
	// `__managed_get` carries, and is safe only because no index in `[0, count)` can hold a NULL managed slot.
	// That is true precisely because this rule refuses `resize`, a zeroed `create(n)` and a managed
	// `FixedArray`'s plain `create`, the operations that would create one. If this refusal is ever relaxed, that read becomes a null deref in a function whose own
	// text still looks correct: `ManagedMemoryRuntime.maxon`'s `ManagedGetUncheckedName` header states the
	// obligation from its end, and this note is the pointer back, so neither side can be changed without
	// meeting the other.
	function requireArrayGrowthHasZeroElement(giid GenericInstanceId, tok Token, refusal ZeroElementRefusal) throws SourceParseError
		if self.signatures.containerElementOwesDrop(giid) 'managed'
			let element = self.signatures.arrayElementDisplayName(giid)

			match refusal 'managedRefusal'
				arrayCreateZeroed or
				fixedArrayCreate then throw SourceParseError.zeroOutsideElement(refusal, subject: ZeroElementSubject.named(element), line: tok.line, column: tok.column)
				arrayResize then throw SourceParseError.arrayResizeManagedElement(element, line: tok.line, column: tok.column)
				default panic("requireArrayGrowthHasZeroElement: only `create` and `resize` publish zeroed slots of a growing array")
			end 'managedRefusal'
		end 'managed'

		try self.requireZeroIsAnElement(giid, tok: tok, refusal: refusal)
	end 'requireArrayGrowthHasZeroElement'

	function requireZeroIsAnElement(giid GenericInstanceId, tok Token, refusal ZeroElementRefusal) throws SourceParseError
		if self.signatures.containerElementIsOpaque(giid) 'opaqueElement'
			try self.requireEveryInstantiationHasAZero(giid, tok: tok, refusal: refusal)

			return
		end 'opaqueElement'

		if not self.signatures.typeExcludesZero(self.signatures.containerElementType(giid)) 'zeroIsAnElement'
			return
		end 'zeroIsAnElement'

		throw SourceParseError.zeroOutsideElement(refusal, subject: ZeroElementSubject.named(self.signatures.arrayElementDisplayName(giid)), line: tok.line, column: tok.column)
	end 'requireZeroIsAnElement'

	function requireEveryInstantiationHasAZero(giid GenericInstanceId, tok Token, refusal ZeroElementRefusal) throws SourceParseError
		if zeroElementRefusalTrustsSparseColumns(refusal) and self.job.livesUnderStdlibDirectory 'aLibraryBodysSparseColumn'
			return
		end 'aLibraryBodysSparseColumn'

		match self.signatures.genericTypeFieldNoZeroInstantiation(typeParamIdOf(self.signatures.containerElementType(giid))) 'noZeroInstantiation'
			noInstance then return
			instance(site) then throw self.instantiationRefusal(refusal, site: site, tok: tok)
		end 'noZeroInstantiation'
	end 'requireEveryInstantiationHasAZero'

	function instantiationRefusal(refusal ZeroElementRefusal, site InstantiationSiteLookup, tok Token) returns SourceParseError
		self.blameLibraryRefusalOnInstantiation(site)

		return match site 'written'
			unwritten gives SourceParseError.zeroOutsideElement(refusal, subject: ZeroElementSubject.instantiated, line: tok.line, column: tok.column)
			written(instantiation) gives SourceParseError.zeroOutsideElement(refusal, subject: ZeroElementSubject.instantiatedAs(String.from(self.signatures.instanceDisplayName(instantiation.gid))), line: tok.line, column: tok.column)
		end 'written'
	end 'instantiationRefusal'

	// ⭐⭐ **THE BUFFER `set` MUST OWN WHAT IT STORES, SO A MANAGED ELEMENT IS REFUSED (E3109).**
	// ⚖ USER RULING, 2026-07-30: the buffer surface's `set` is bounded by CAPACITY, which is what makes the
	// stage-then-`setLength`-to-publish idiom spellable — and what puts a write into `[length, capacity)`, a
	// region that carries NO OWNERSHIP. For a TRIVIAL element that is exactly the intent. For a MANAGED one
	// the staged element is owned by nobody until a `setLength` publishes it, and by nobody at all if one
	// never comes: MEASURED at exit **101** by two programs that break no stated contract — `reserve(4)` then
	// `set(0, "staged")` and return; and stage, then `push` over the staged slot (`__managed_push` stores AT
	// `length` without destroying the occupant, because before the ruling that slot was PROVABLY NULL).
	//
	// ⚖ **RULED A REJECTION RATHER THAN A FIX (user, 2026-07-30), and the reasons are worth keeping because
	// they are what a future "why not just make ownership follow?" has to answer.** Making the staged slot
	// owned means a destructor gate on every managed `push` — a hot path — and it makes the
	// `[length, capacity)`-reads-ZERO invariant CONDITIONAL, which `push`, `insert`, `append`, the grow
	// realloc and `__managed_cow_detach` all currently rely on. Refusing costs neither, and costs no capability:
	// `[0, length)` is precisely what the ARRAY surface's own length-bounded `set` covers, which owns what it
	// stores and is untouched — so the message names it as the spelling to use.
	//
	// ⭐ **IT IS COARSER THAN THE RULE IT ENFORCES, DELIBERATELY, AND THE COST WAS MEASURED RATHER THAN
	// ASSUMED.** The rule is about the INDEX (`>= length`), which is a runtime expression no parser holds, so
	// a parse-time refusal has to refuse the whole managed-element buffer `set` including the `[0, length)`
	// half that leaks nothing. A census of the corpus found every `.managed.set` site is a TRIVIAL element,
	// and the harmless half has an exact replacement one word shorter
	// (`arr.set(i, value: x)`). Refusing at compile time makes the leak IMPOSSIBLE where a runtime throw
	// would only make it reported — and buys the runtime setter no check at all.
	//
	// ⚠ **NO OPAQUE-`T` CARVE-OUT IS NEEDED, and that is checked rather than inherited from
	// `requireArrayGrowthHasZeroElement`'s note** (which does need one). `.managed` is not reachable inside a
	// shared generic body: `self.items.managed` is refused a step earlier as a field access through a
	// non-struct, so every site this rule can see has a CONCRETE element and a statically known answer.
	// `containerElementIsManaged` answering false for a type parameter is therefore not what makes this sound.
	function requireBufferSetOwnsWhatItStores(giid GenericInstanceId, methodTok Token) throws SourceParseError
		if not self.signatures.containerElementIsManaged(giid) 'trivial'
			return
		end 'trivial'

		throw SourceParseError.bufferSetManagedElement(self.signatures.arrayElementDisplayName(giid), line: methodTok.line, column: methodTok.column)
	end 'requireBufferSetOwnsWhatItStores'

	// ⭐⭐ **A MANAGED ELEMENT'S BYTES ARE A POINTER, NOT DATA, SO RAW BYTE ACCESS IS REFUSED (E3110).**
	// ⚖ USER RULING, 2026-07-30. `setByte` writes into a live heap ADDRESS — corruption in place,
	// after which the element it named is unreachable and unreleasable (MEASURED: exit **101** writing offset
	// 0 of an `Array with String`). `byteAt` READS one and hands the fragment back as though it were a value
	// (MEASURED: returned NONZERO for offsets 0 and 1 of a live `String` pointer) — a silent wrong answer, and
	// an address disclosure.
	//
	// ⚠⚠ **`byteAt` IS REFUSED ALONGSIDE `setByte`, NOT AFTER IT, AND THAT IS THE WHOLE POINT OF DOING BOTH
	// AT ONCE.** It returns a value: it corrupts nothing, trips no leak gate, and raises no error, so it is
	// exactly the half that stays green forever if only the writer is fixed.
	//
	// ⚠ **IT SHARES `requireBufferSetOwnsWhatItStores`'s PREDICATE AND MUST NOT SHARE ITS MESSAGE.** The
	// question ("is this element managed?") is one fact and is asked once, through
	// `signatures.containerElementIsManaged`. The ANSWER's consequence is two different facts: `set` is refused
	// for OWNERSHIP and only past the published length, so it has a harmless half and an exact replacement
	// (`arr.set(i, value:)`) the message names; these two are refused for REPRESENTATION, at every offset,
	// with no replacement — byte access to a pointer is not something a correct program wants. Folding the
	// two messages would put a rationale on one refusal that is true only of the other.
	//
	// ⚠ TRIVIAL elements are untouched, and that is the load-bearing half of the rule rather than an
	// exemption: `__ManagedMemory.create` can only ever yield a trivial element, so string building and the
	// NUL terminator `stdlib/File.maxon` writes at the length boundary go through here unchanged.
	function requireBufferBytesAreNotAPointer(giid GenericInstanceId, methodTok Token) throws SourceParseError
		if not self.signatures.containerElementIsManaged(giid) 'trivial'
			return
		end 'trivial'

		throw SourceParseError.bufferByteAccessManagedElement(String.from(methodTok.value), elementType: self.signatures.arrayElementDisplayName(giid), line: methodTok.line, column: methodTok.column)
	end 'requireBufferBytesAreNotAPointer'

	// ⭐⭐ **A RAW-BYTE FILL, ONE BYTE PER ELEMENT, NEEDS AN ELEMENT THAT ADMITS EVERY BYTE (E3117).**
	// ⛔ Two constructs write bytes into an `Array with Byte` that exist only at RUN TIME, and both were a
	// silent wrong answer under a `Byte` too narrow to hold them:
	//
	//   • the BYTE VIEW (`parseByteView` — `String.toByteArray()`, `String.bytes()`, `Character.bytes()`),
	//     whose `__str_to_bytes` blits the receiver's UTF-8. MEASURED with `requireByteStringBlobFitsItsElement` already
	//     in: `takes("ß".toByteArray())` into `takes(b Array with Byte)` under `typealias Byte = int(0 to 100)`
	//     returned **195**, exit 195, no diagnostic. `.bytes()` returned the same 195 through the same emitter.
	//   • `__ManagedFile.read(managed, size)`, which blits a file's contents into a caller's buffer.
	//
	// ⚠⚠ **THE BUFFER SURFACE'S `setByte` IS NOT A SITE OF THIS RULE.**
	// It addresses a byte OFFSET rather than an element, so what its write leaves behind is any bit
	// pattern of the element's whole SLOT, and *"admits every byte"* is that question's answer at ONE width
	// and no other. It asks `requireRawByteWriteFitsItsSlot` (E3118) instead, at every stride. The two
	// sites of this rule are exactly the ones whose fill is byte-per-element BY CONTRACT, which is why neither
	// needs — or may have — a stride test of its own; see the note below.
	//
	// ⚠⚠ **IT IS PER-TYPE AND `requireByteStringBlobFitsItsElement` IS PER-VALUE, AND THEY MAY NOT BE
	// MERGED.** The blob rule inspects the blob it holds, so it can accept `b"abc"` under `int(0 to 100)` — which it
	// MUST, and its own header says why. There is nothing here to inspect: the fill is one runtime blit, not
	// a run of stores that could be narrowed one at a time, so the only question left is about the ELEMENT.
	// Asking the blob rule's question here would accept every one of the readings above; asking this one there would
	// refuse `b"abc"`.
	//
	// ⛔⛔ **THE OBVIOUS CURE — RETYPE THE BYTE VIEW ONTO `__ManagedByte` AND LET `byteBufferBoundaryAdmits`
	// DECIDE — IS WRONG, AND IT WAS MEASURED RATHER THAN ARGUED.** A byte view is NOT a buffer of the
	// `__ManagedByte` kind: `emitArrayCreateOp` stamps its `element_size@24` from the very instance it is
	// typed as, so a wide `Byte` gives a genuinely stride-2 record and `__str_to_bytes` fills it at THAT
	// stride — `b0=97 b1=98 b2=99` under `typealias Byte = int(0 to 1000)`. `__ManagedByte`
	// strides 1 always (`undeclaredNamedElementSlot`), so a retyped view would be refused by that
	// door's STRIDE test at every declared byte-array position: measured on the tree as
	// `E3005 … expected 'Array_Byte$0_1000', got 'Array___ManagedByte'` for the buffer that already wears the
	// element. ⇒ the interning `parseByteView` does is deliberate and it is RIGHT; only the BOUNDS need
	// asking. `bytearray-element-size.a-wide-byte-still-materializes-a-byte-view` holds it shut.
	//
	// ⚠ **THE RAW-BYTE READER IS DELIBERATELY UNTOUCHED, AND UNLIKE E3110's PAIR THAT IS NOT THE HALF THAT
	// STAYS GREEN FOREVER.** `byteAt` emits `resultTag: ValueTypeTag.integer` with `UnnamedTypeId` — a plain
	// unranged `int`, never the element — so a byte read back is honest whatever `Byte` was declared to be.
	// E3110 refuses its reader because a managed element's bytes are an ADDRESS at every offset, which is a
	// fact about the REPRESENTATION and true in both directions; a declared RANGE constrains only what may be
	// STORED. Refusing the read as well would cost a capability to close nothing.
	//
	// ⚠ **IT IS THE BOUNDS QUESTION AND NOTHING ELSE, AND NEITHER REMAINING SITE MAY GROW A STRIDE TEST.**
	// Folding one in would open the byte view's own negative-`low` case: a `Byte` whose bounds cannot be
	// trusted takes the machine word (`rangedAliasStorageBytes`), so the view would stop LOOKING byte-packed
	// and the rule would stop asking, on exactly the element it least trusts. The construct that genuinely
	// needs the stride — `setByte` — does not have it as a precondition either: it feeds the stride INTO its
	// rule (`requireRawByteWriteFitsItsSlot`), which is the difference between a boundary and an answer.
	//
	// ⚠ A raw-negative `low` is REFUSED here, and it is the same conservative direction
	// `rangeHoldsEveryByte`'s header argues for: bounds ride as raw 64-bit patterns, so a negative `low` and
	// a bound above `i64.max` are the same bits. This door ADMITS a run of raw bytes into a declared element,
	// so the ambiguous answer has to be "no". `int(-5 to 300)` would in fact hold every byte and is refused
	// with the rest; that is the price of the ambiguity, and it is paid in the direction that cannot produce
	// a wrong answer.
	//
	// `undeclared` is the program that declares no `Byte` at all — the literal's own instance
	// (`SignatureIndex.undeclaredNamedElementSlot`), where no declared range exists for a byte to
	// fall outside of.
	function requireRawByteFillFitsItsElement(giid GenericInstanceId, methodTok Token) throws SourceParseError
		match self.signatures.arrayElementAliasOf(giid, readerFilePath: self.job.path) 'element'
			undeclared then return
			declared(alias) then try self.requireElementAdmitsEveryByte(alias, methodTok: methodTok)
		end 'element'
	end 'requireRawByteFillFitsItsElement'

	// The rule above's test, split out so the rule reads as its two cases — `requireEveryByteInRange`'s shape,
	// for its reason. The predicate is `RangedAliasRegistry`'s own `rangeHoldsEveryByte`, which the boundary
	// door already asks one quantifier up (`holdsEveryByteInEveryFile`), so a byte and a raw buffer cannot come
	// to mean two different things at the two doors.
	function requireElementAdmitsEveryByte(alias RangedTypeAlias, methodTok Token) throws SourceParseError
		if rangeHoldsEveryByte(alias.low, high: alias.high) 'holdsEveryByte'
			return
		end 'holdsEveryByte'

		throw SourceParseError.rawByteFillNarrowElement(String.from(methodTok.value), aliasName: String.from(alias.name), low: alias.low, high: alias.high, isFloat: aliasIsFloat(alias), line: methodTok.line, column: methodTok.column)
	end 'requireElementAdmitsEveryByte'

	// ⭐⭐ **A RAW-BYTE WRITE NEEDS AN ELEMENT THAT ADMITS EVERY BIT PATTERN OF ITS SLOT (E3118).** The
	// rule above's neighbour and NOT its widening: this one is asked by the single construct that addresses a
	// byte OFFSET, so the value its write leaves in the element is an arbitrary unsigned value of the whole
	// slot, and the width is part of the question rather than a gate in front of it. The predicate is
	// `ProgramSignatures.elementAdmitsEverySlotValue`, whose one-byte case IS `rangeHoldsEveryByte` — so at
	// the width where the two rules coincide they cannot come to disagree, and above it only this one speaks.
	//
	// ⚠ The SLOT is read from `arrayElementSize` — the sole producer of the stride in `element_size@24`, so the
	// width this refusal names is the width the runtime will actually stride, not a second derivation of it.
	function requireRawByteWriteFitsItsSlot(giid GenericInstanceId, methodTok Token) throws SourceParseError
		if self.signatures.elementAdmitsEverySlotValue(giid, readerFilePath: self.job.path) 'fillsItsSlot'
			return
		end 'fillsItsSlot'

		throw SourceParseError.rawByteWriteSlotDomain(String.from(methodTok.value), elementDisplay: self.slotElementDisplay(giid), slotBytes: self.signatures.arrayElementSize(giid), line: methodTok.line, column: methodTok.column)
	end 'requireRawByteWriteFitsItsSlot'

	// The element as the refusal above must NAME it: the display name, plus the DECLARED RANGE when there is
	// one, because a sentence about which values an element admits is unreadable without the values. The
	// choice between the two shapes is made HERE and not in the renderer, because only the parser holds the
	// signatures — `valueDisplayTypeName` feeding `builtinArgumentType`'s `got:` is the same split.
	function slotElementDisplay(giid GenericInstanceId) returns String
		return match self.signatures.arrayElementAliasOf(giid, readerFilePath: self.job.path) 'element'
			undeclared gives "'{self.signatures.arrayElementDisplayName(giid)}'"
			declared(alias) gives rangedAliasValueSetDisplay(String.from(alias.name), low: alias.low, high: alias.high, isFloat: aliasIsFloat(alias), domain: alias.domain)
		end 'element'
	end 'slotElementDisplay'

	// ⭐ **THE COPY GATE for `slice`/`clone`/`append`, routed by element KIND.** An OPAQUE-`T`
	// element (a generic body's shared `Array with <type parameter>`) copies through the descriptor's `copyFunc@32`
	// (`requireOpaqueArrayCopyable`); a CONCRETE element copies through its statically-known cloner
	// (`requireArrayElementCopyable`). One home so the three copy methods pick the right gate identically.
	function requireArrayCopyMethodSupported(giid GenericInstanceId, methodTok Token) throws SourceParseError
		if self.signatures.containerElementIsOpaque(giid) 'opaque'
			try self.requireOpaqueArrayCopyable(giid, methodTok: methodTok)
			return
		end 'opaque'

		try self.requireArrayElementCopyable(giid, methodTok: methodTok)
	end 'requireArrayCopyMethodSupported'

	// ⭐ **THE COPY GATE for an OPAQUE-`T` array.** An opaque
	// `Array with <type parameter>` inside a generic body copies each element through the enclosing
	// instance's descriptor `copyFunc@32`, which can hold only a SINGLE `(box) -> newBox` cloner
	// (`__managed_*_opaque` branches on it: a byte-blit for a trivial element, a deep clone for a
	// managed one). It REJECTS (E2015) when SOME instantiation of the enclosing generic type
	// substitutes a managed type nothing can deep-clone — an OS handle, a base-struct-less generic
	// instance with no runtime copy of its own (a cursor), an existential, or a type that owns one of
	// those — because such an element has no `copyFunc` and its copy would byte-blit a managed pointer
	// and double-free it. The reject is per-INSTANTIATION (the shared body's element is opaque), so it
	// enumerates the enclosing type's instances through `genericTypeFieldUncopyableInstantiation`,
	// mirroring the concrete gate `requireArrayElementCopyable`. An instantiation whose element is or
	// holds a promise is refused first, E3141 (`genericTypeFieldGreenThreadInstantiation`).
	function requireOpaqueArrayCopyable(giid GenericInstanceId, methodTok Token) throws SourceParseError
		let element = typeParamIdOf(self.signatures.containerElementType(giid))
		try self.requireInstantiationsCopyNoGreenThread(element, fallbackSubject: "`{String.from(self.signatures.instanceDisplayName(giid))}`", memberTok: methodTok)

		// ⚠ The element's token names its own declaration, so the gate resolves both halves from that one
		// fact and pairs nothing in from `self.enclosingType` — see `instanceWithTypeArgKind`.
		match self.signatures.genericTypeFieldUncopyableInstantiation(element) 'uncopyable'
			noInstance then return

			// ⭐ The offending INSTANTIATION is what the user wrote, so it is what this refusal is blamed at
			// when the body raising it is the library's — see `blameLibraryRefusalOnInstantiation`.
			instance(site) then self.blameLibraryRefusalOnInstantiation(site)
		end 'uncopyable'

		try self.refuseCloneOfAnUncloneableConformer(self.signatures.uncloneableExistentialInElementOf(giid), memberTok: methodTok)

		throw SourceParseError.unsupported("`{String.from(methodTok.value)}` COPIES each element of an `Array with <type parameter>` field, but this generic type is instantiated with a type whose managed element cannot be deep-cloned — a compiler-owned aggregate (`__ManagedFile`), a base-struct-less generic instance with no runtime copy of its own, an ELEMENT held at an interface type (an element slot is one machine word and a fat pointer is two), or a generic instance that owns one of those. String / struct / boxed-union / container (`Array with int`, `List with String`, `Array with (Array with String)`) / trivial instantiations, a record holding an interface-typed FIELD, and a declared generic's instance whose own substituted fields are all deep-cloneable (`Box with String`), ARE supported.", line: methodTok.line, column: methodTok.column)
	end 'requireOpaqueArrayCopyable'

	// ⭐⭐ **BLAME A LIBRARY-BODY REFUSAL ON THE INSTANTIATION THAT FORCED IT (BLAME).**
	//
	// This gate is contingent on the INSTANCE REGISTRY — it refuses `Array.clone`'s own
	// `managed.slice(0, len)` because SOME instantiation of the enclosing generic type substitutes an
	// element with no single `copyFunc`. When the body it refuses is `stdlib/`'s, the line it names is a
	// line no user wrote; the instantiation is the user's own construct, and blaming it there restores both
	// halves of what the relocation cost — the user's line, and (because the line IS `typealias Holders =
	// Array with Holder`) the user's element.
	//
	// ⚠ **ONLY FOR A LIBRARY BODY.** In a USER generic body the refusal already lands on a line its author
	// wrote, and re-pointing it at the instantiation would move a diagnostic that was never mis-blamed.
	// `isStdlibSource` is the right bit and not `livesUnderStdlibDirectory`: the question is whose code the
	// author is reading, which is exactly the visibility partition (`maxon build stdlib/URL.maxon`
	// makes those files the user's own, and there the refusal must stay where it is raised).
	//
	// An instance the program never WROTE — one substituted into a generic body's inner alias — is followed
	// back to the enclosing instantiation that minted it, and one with no written origin at all simply keeps
	// the raise site. Both are `ProgramSignatures.instantiationSiteOf`'s business, argued there.
	function blameLibraryRefusalOnInstantiation(site InstantiationSiteLookup)
		if not self.job.isStdlibSource 'theAuthorWroteThisBody'
			return
		end 'theAuthorWroteThisBody'

		match site 'site'
			unwritten then return
			written(site) then self.libraryBlame = LibraryBlame.userSite(site.filePath, line: site.nameLine, column: site.nameColumn)
		end 'site'
	end 'blameLibraryRefusalOnInstantiation'

	// Emit a VOID array mutator call; return the receiver (what the statement still denotes).
	function emitArrayVoidCall(callee ByteArray, args ValueIdArray, receiver ValueId, range SourceRange) returns ValueId
		_ = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		return receiver
	end 'emitArrayVoidCall'

	// ⭐ **DOES AN ELEMENT OF THIS CONTAINER OWN NOTHING?** — the accessor's own trivial test, named rather
	// than spelled inline so its two halves are read as ONE question and neither can be dropped.
	//
	// ⚠ **BOTH HALVES ARE LOAD-BEARING AND THE SECOND IS THE ONE THAT LOOKS REDUNDANT.**
	// `containerElementIsManaged` reads the TAG and answers FALSE for a `typeParameter` — in a shared generic
	// body that means *"no static answer"*, never *"owns nothing"* (a measured use-after-free the whole
	// suite was green over). So the opaque test is what keeps an `Array with Element` out of the trivial arm.
	// ⭐⭐ **THE THREE WAYS A PROMISE CAN LEAVE A CONTAINER, AND THEY ARE NOT INTERCHANGEABLE.**
	//
	//   • A **MOVE-OUT** (`pop`, `remove`, a list `remove`) — the container has ALREADY stopped naming it, so
	//     there is no slot to vacate later and the caller owns the thread outright. It is enrolled exactly as
	//     a spawn is, which is what makes `let p = try s.pop() …` drop its thread at scope exit instead of
	//     leaking it (measured without it: exit 101, the popped promise owned by NOBODY).
	//   • A **NAMEABLE READ** (`get(i)`, `first()`, `for … in`, an array cursor's `current()`/`peek(n)`) — the
	//     slot is recorded, and vacated when the read is consumed. A cursor's slot is taken AT THE READ, off
	//     the cursor's own buffer and position, so a navigation between the read and the await cannot move it.
	//   • A read that **CANNOT NAME ITS SLOT** (a list node's `value()`) — REFUSED. A list has no index to
	//     record, so nothing could be emptied, and letting it through would leave the element walk reclaiming
	//     a thread the await already reclaimed.
	//
	// ⚠ `first()` carries no index ARGUMENT and still names a slot — slot 0. The distinction is "can this read
	// name its slot", not "was an index written".
	//
	// Resolved BEFORE the accessor is emitted — see the call site for why the order is load-bearing.
	function promiseElementSlotOf(callee ByteArray, container ValueId, args ValueIdArray, giid GenericInstanceId, reference ContainerElementReference, range SourceRange) returns PromiseSlotResolution
		if not self.signatures.containerElementIsAGreenThreadHandle(giid) or self.containerReadMovesTheElementOut(reference) 'noSlotToVacateLater'
			return PromiseSlotResolution.noSlot
		end 'noSlotToVacateLater'

		if callee.equals(ManagedCursorCurrentName) or callee.equals(ManagedCursorPeekName) 'aCursorRead'
			let slotArgs = args if callee.equals(ManagedCursorPeekName) else argsOf(container)
			return PromiseSlotResolution.slot(self.emitArrayCursorSlot(container, args: slotArgs, range: range))
		end 'aCursorRead'

		if not indexedElementReadCallee(callee) 'cannotNameItsSlot'
			return PromiseSlotResolution.noSlot
		end 'cannotNameItsSlot'

		if args.count() > OneArgumentIsJustTheContainer 'carriesAnIndexArgument'
			return PromiseSlotResolution.slot(PromiseSlot.create(container, index: try args.get(1) otherwise panic("promiseElementSlotOf: args.get OOB at 1 — the count was just tested")))
		end 'carriesAnIndexArgument'

		return PromiseSlotResolution.slot(PromiseSlot.create(container, index: self.emitLiteral(FirstElementIndex, valueType: MaxonType.integer, range: range)))
	end 'promiseElementSlotOf'

	// ⭐ **THE SLOT A READ THROUGH AN ARRAY CURSOR NAMES: its buffer and its position, both read NOW.** The
	// cursor holds its source retained, and `Array with T` is one record with its `__ManagedMemory`, so the
	// source is the record `__managed_vacate` empties. `args` is the read's own argument list — a `peek`'s
	// second argument is how far ahead of the position it reads.
	function emitArrayCursorSlot(cursor ValueId, args ValueIdArray, range SourceRange) returns PromiseSlot
		let buffer = self.emitIndirectLoad(MaxonType.integer, box: cursor, offset: CursorSourceOffset, storageType: MaxonType.integer, range: range)
		let position = self.emitRuntimeCall(ManagedCursorIndexName, args: argsOf(cursor), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)

		if args.count() > OneArgumentIsJustTheContainer 'readsAhead'
			let ahead = try args.get(1) otherwise panic("emitArrayCursorSlot: args.get OOB at 1 — the count was just tested")
			return PromiseSlot.create(buffer, index: self.emitMachineWordBinOp(position, rhs: ahead, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range))
		end 'readsAhead'

		return PromiseSlot.create(buffer, index: position)
	end 'emitArrayCursorSlot'

	// The array-cursor slot of a library ITERATOR record (`ArrayIterator`), through the cursor it holds.
	// Throws when the record holds none, which is every iterator that is not over an array.
	function emitIteratorCursorSlot(iterator ValueId, args ValueIdArray, range SourceRange) returns PromiseSlot throws ArrayError
		let gid = self.valueInstanceId(iterator)
		let cursorField = try self.signatures.managedCursorFieldsOf(gid).get(0)
		let cursor = self.emitFieldLoad(iterator, layout: self.signatures.baseLayoutOf(gid), index: cursorField, range: range)
		return self.emitArrayCursorSlot(cursor, args: args, range: range)
	end 'emitIteratorCursorSlot'

	// Record what `promiseElementSlotOf` resolved, now that the read's value exists — and refuse the read
	// outright when it produced a promise no slot was named for.
	//
	// ⛔ **THE REFUSAL IS DECIDED ON THE RESULT VALUE'S TYPE, NOT ON THE CONTAINER'S `giid`.** The value that
	// came back is a promise whoever was asked about it, so a door that passed an instance answering `false`
	// is refused rather than let through to reclaim a thread twice.
	//
	// ⚠ Throwing AFTER the accessor call is emitted is safe where emitting is not: a throw appends no op, so
	// it cannot steal the last-op slot `parseTryCallTarget`'s rewrite depends on.
	function notePromiseElementRead(value ValueId, slot PromiseSlotResolution, callee ByteArray, reference ContainerElementReference, range SourceRange) throws SourceParseError
		if not self.valueIsPromise(value) 'notAPromiseElement'
			return
		end 'notAPromiseElement'

		if self.containerReadMovesTheElementOut(reference) 'movedOut'
			self.markValuePromise(value)
			self.bodyState.pendingTempDrops.push(value)
			return
		end 'movedOut'

		match slot 'resolved'
			noSlot then throw SourceParseError.promiseCannotBeBorrowed(String.from(self.calleeMemberNoun(callee)), cure: PromiseSlotReadCure, line: range.line, column: range.column)
			slot(at) then self.recordConsumablePromiseSlot(value, container: at.container, index: at.index, isField: false)
		end 'resolved'
	end 'notePromiseElementRead'

	// The SOURCE spelling of the member a runtime callee serves — a diagnostic must name what the AUTHOR
	// wrote, never the `__managed_*` entry the compiler emitted for it.
	function calleeMemberNoun(callee ByteArray) returns immutable ByteArray
		if callee.equals(ListNodeValueName) 'nodeValue'
			return b"value"
		end 'nodeValue'

		if callee.equals(ManagedCursorCurrentName) 'current'
			return CursorCurrentMethod
		end 'current'

		if callee.equals(ManagedCursorPeekName) 'peek'
			return CursorPeekMethod
		end 'peek'

		panic("calleeMemberNoun: '{String.from(callee)}' is not an element accessor a promise read can be refused at")
	end 'calleeMemberNoun'

	function containerReadMovesTheElementOut(reference ContainerElementReference) returns bool
		return match reference 'reference'
			movedOut gives true
			borrowed or
			retained gives false
		end 'reference'
	end 'containerReadMovesTheElementOut'

	function containerElementOwnsNothing(giid GenericInstanceId) returns bool
		return not self.signatures.containerElementIsManaged(giid) and not self.signatures.containerElementIsOpaque(giid)
	end 'containerElementOwnsNothing'

	// ⭐ **EMIT A MANAGED-AWARE ELEMENT ACCESSOR** (`get`/`first`, the `Array` cursor's two, and the `List`
	// accessors).
	//
	// ⛔⛔ **THIS IS NOT THE ONE DOOR EVERY ELEMENT READ USES. THERE ARE THREE, and each is found by a wrong
	// answer the other two do not cover.** This one carries the reads the COMPILER emits.
	// `last`/`pop`/`remove` are **CORPUS** members (`stdlib/Array.maxon` is compiled), so they arrive as
	// ordinary calls at `emitCall` and never reach here — the enumerations below still name them because the
	// ownership rule each states belongs to the container rather than to this door.
	//
	// ⚠ **THE `for … in` READ COMES THROUGH HERE.** An `Array` source is not rewritten to its cursor
	// (`materializeIterableIterationSource`), so the loop reads `__managed_get_unchecked` through this door
	// again — a trivial element through the arm below, a managed or opaque one through the BORROW arm, whose
	// enrolment against the iterated source is what the 2026-08-26 ruling upheld.
	//
	// ⇒ all three exist because a corpus body is compiled ONCE against an opaque `Element`: it reads a slot
	// with the shared element load, which sign-extends only through the record's `SignedElementStampFlag`,
	// and can know nothing else the INSTANCE fixes. Where the value
	// GOES from there is what splits the doors:
	//
	//   1. **`emitContainerElementAccessor`** (here) — a read the compiler emits, which holds the instance.
	//   2. **`typeResultThroughInstance`** — a value a corpus body RETURNS through the opaque word; the caller
	//      holds the instance. Two facts cross there, an f64 riding the general-purpose register and a
	//      narrow SIGNED value, and both have a twin here.
	//   3. **`bindParameters`** — a value a corpus body passes INTO user code as an ARGUMENT, through a
	//      function value (`arr.sortBy(cmp)`) or a witness call (`contains`'s `item == element`). NEITHER
	//      1 NOR 2 STANDS IN FRONT OF IT: nothing returns and nothing is read at the call site — the
	//      callee's own entry is the only place that can see it.
	//
	// All three spell it through the same two helpers (`emitNarrowSignedSlotRead`,
	// `narrowSignedSlotOfLocalType`) so the set cannot drift apart.
	//
	// ⚠⚠ **A RULE ADDED AT ONE AND NOT THE OTHERS IS A WRONG ANSWER ON THE REST OF THE SURFACE.** Whatever
	// you add below, ask what the other two owe.
	//
	// ⚠ **IT SERVES A `List` TOO, WITHOUT A LINE OF ITS OWN — which is what identifies it as a CONTAINER
	// door rather than an `Array` one.** Everything below reads the instance through `containerElementType`
	// (managed-ness, opacity, the result's value type) and the ownership rule it states is about the
	// OPERATION: `list.first()`/`list.get(i)` look at an element the list keeps, `list.removeFirst()` takes
	// one out, exactly as `arr.first()` and `arr.pop()` do. A second copy under a list name would be this
	// whole header — the scope promotion, the buffer-surface mark, the opaque arm — transcribed for a
	// container that answers every one of its questions identically.
	// The result carries the element's VALUE type: for a CONCRETE managed element its usable form — a struct →
	// `structRef` so `first.name` resolves, a boxed union → `named` so `match first` dispatches, a String → text,
	// an instance → `genericInstance`; for an OPAQUE element the element's own `typeParameter(token)` (the shared
	// body has no concrete type, so the tag stays opaque and its drop is descriptor-gated); or
	// `integer` for a TRIVIAL concrete element. Ownership:
	//   • get/first/last yield a BORROW (`ContainerElementReference.borrowed`): the array keeps the element, so
	//     the result is NOT tracked owned and is dropped by nothing here — the array's `__managed_decref` walk
	//     destroys it. A borrow merged with an OWNED `otherwise` fallback is reconciled by `finishValueTry` (the
	//     fallback drops on the error edge; see there).
	//   • pop/remove MOVE the element OUT (`movedOut`): the runtime NULLS the slot it hands back (so the
	//     array walk skips it), so the caller becomes the sole owner and the result is tracked owned — dropped by
	//     the concrete destructor (concrete element) or the descriptor-gated `__drop_type_param` (opaque element,
	//     inert for a trivial instantiation). That drop makes the enclosing method a layout carrier in
	//     lowering's carrier scan.
	//   • `__ManagedListNode.value()` on a concrete managed element RETAINS (`retained`): the node keeps the
	//     element and the caller takes a reference of its own, because `setValue` releases what the node held.
	//     See `ContainerElementReference` for why a borrow and a move-out are both wrong there.
	//
	// `reference` IS *"does the caller take the element OUT, look at it in place, or keep a reference of its
	// own?"*, so `pop`/`remove` are told apart STRUCTURALLY rather than by a second hand-maintained method
	// list: `arrayMethodMutatesReceiver` is already the ONE such list and answers a different question.
	//
	// A read in place is counted where it is held, by `HoldResolution.maxon`, which follows a hold taken on
	// the result back to this call.
	//
	// ⚠ **RETAINING AT THE READ IS NOT THE CHEAPER ANSWER — IT IS A DIFFERENT PROGRAM.** The reference an
	// opaque value takes is `retainFunc@64`, which for a byte record is `__str_clone`, a DEEP CLONE rather than
	// an incref (`SignatureIndex.retainCalleeForProtocol`, and its reason is that a literal's record is immortal
	// `.rdata`). So a retain here would copy the record on every element read and hand the reader a DIFFERENT
	// record from the one the slot holds.
	function emitContainerElementAccessor(callee ByteArray, container ValueId, args ValueIdArray, giid GenericInstanceId, reference ContainerElementReference, range SourceRange) returns ValueId throws SourceParseError
		// A TRIVIAL CONCRETE element (int / Byte / ranged-int / bool) is a bare inline word that owns nothing, so
		// it is NEVER tracked owned, read or moved out (a decref of an integer would corrupt the count) — a
		// PROMISE element takes this arm and is the one exception, tracked by the block below. An
		// OPAQUE element is NOT trivial here — `typeIsManaged` is false for a `typeParameter`, but a managed
		// instantiation's element DOES own heap — so it falls through to the opaque-aware path below.
		//
		// ⚠ **IT CARRIES THE ELEMENT'S DECLARED TYPE, NOT A BARE `integer`, AND THE DIFFERENCE IS A TYPE
		// IDENTITY.** The rule this arm states is about OWNERSHIP, and typing the result `integer` was a
		// second claim riding on it — that a `Byte` read out of an `Array with Byte` is indistinguishable
		// from an `int`. It is not: an array LITERAL picks its instance from its first element's tag
		// (`arrayLiteralInstanceFor`), so `[b.get(0), b.get(1)]` over a byte array built an `Array with
		// integer` — an 8-byte stride over values that came out of a 1-byte one — and the byte array
		// could not be rebuilt from its own elements. Typed `integer`, `String.from([x, y, z])` over a
		// `b"Hi!"` is a false reject: `E3005 requires an argument of type Array with Byte, but its argument is Array_int`.
		// `containerSlotValueType` is the one function that answers "what type does an element READ as",
		// and it answered here already for a managed element; a trivial one now asks the same question of
		// the same function.
		if self.containerElementOwnsNothing(giid) 'trivial'
			let trivialType = self.containerSlotValueType(self.signatures.containerElementType(giid))

			// ⭐ **A FLOAT ELEMENT COMES BACK AS ITS BITS AND IS REINTERPRETED HERE** — the read half of
			// `containerElementWord`, and it may not simply TAG the call's result `float`: the runtime returns
			// in a general-purpose register, so a float-tagged result would make the allocator colour the same
			// value into two register files and panic the emitter. The call is therefore typed honestly as an
			// integer and the bitcast is a real op.
			if self.containerElementIsFloatWord(giid) 'floatElement'
				let bits = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
				let reinterpreted = self.emitUnaryOp(bits, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: range)
				self.wearIndexSpaceAlias(reinterpreted, declared: self.signatures.containerElementType(giid), scopeFilePath: self.job.path)
				self.noteLiteralColumnRead(reinterpreted, container: container, column: LiteralColumn.first)
				self.settleFloatResult(reinterpreted)
				return reinterpreted
			end 'floatElement'

			// ⭐⭐ **A PROMISE ELEMENT IS READ AS A MOVE, AND THE SLOT IS RESOLVED BEFORE THE CALL IS EMITTED.**
			// The LOWERING is exactly the trivial one — a promise owns no record, so there is nothing to incref
			// — but the OWNERSHIP is not trivial: the slot and the reader now name one green thread, and exactly
			// one of them may reclaim it. See `promiseSlotContainer`.
			//
			// ⛔ **RESOLVED FIRST BECAUSE `first()` MINTS A LITERAL, AND A LITERAL EMITTED AFTER THE ACCESSOR
			// WOULD BE THE LAST OP.** `parseTryCallTarget` turns `try arr.get(i)` into a try-call by REWRITING
			// THE LAST OP, so anything emitted between the accessor call and that rewrite steals it — measured
			// as *"`try` must be applied to a call"* on four committed cases, the same trap the await door
			// carries its own note about. Resolving here leaves the accessor call last, always.
			let promiseSlot = self.promiseElementSlotOf(callee, container: container, args: args, giid: giid, reference: reference, range: range)
			let slotValue = self.emitRuntimeCall(callee, args: args, resultTag: maxonTypeTag(trivialType), resultNameId: typeNameIdOf(trivialType), range: range)
			try self.notePromiseElementRead(slotValue, slot: promiseSlot, callee: callee, reference: reference, range: range)

			// ⛔ **AND THE CONTAINER IS HELD TO SCOPE EXIT, THOUGH THE ELEMENT IS A BARE WORD.** The borrow arm
			// promotes a temporary receiver because the element points into it; here the element points
			// nowhere, and the temporary's DESTRUCTOR is what reclaims the thread — at statement end, before
			// the await. Gated on the read carrying a slot, so a move-out (`pop`/`remove`), which owns its
			// element outright, is not promoted. It emits no op, which is what leaves the accessor call last
			// for the try-call rewrite above.
			if self.promiseValueCarriesAContainerSlot(slotValue) 'aPromiseTheContainerStillHolds'
				self.giveTemporaryScopeLifetime(container, name: BorrowSourceBindingName)
			end 'aPromiseTheContainerStillHolds'

			// ⭐⭐ **A NARROW SIGNED SLOT IS SIGN-EXTENDED HERE (`enum-narrow-storage`).** The runtime's element
			// load sign-extends a record whose `element_size@24` stamp carries `SignedElementStampFlag` and
			// zero-extends every other, so an `i8`-slotted `Signal.minus` is `-1` and not `255` only where the
			// load or this extension applies. The extension is the identity on a value already extended
			// (`narrowSignedSlotOf`'s header).
			//
			// ⚠⚠ **THIS DOOR IS NOT ENOUGH ON ITS OWN.** This function's own header calls itself the door "every
			// element read in the language uses", but `last`/`pop`/`remove` are CORPUS members
			// (`stdlib/Array.maxon`) and a corpus body is compiled ONCE against an opaque `Element` — this door
			// never sees those calls. The corpus half is `typeResultThroughInstance`'s, off the SAME
			// `narrowSignedSlotOf` question — see `emitNarrowSignedSlotRead` for why asking it twice is one
			// derivation and not two.
			//
			// ⚠ **THE `for … in` READ OF AN `Array` COMES BACK THROUGH THIS DOOR.** An `Array` is not
			// rewritten to its cursor (`materializeIterableIterationSource`), so the iteration read is
			// `parseForStatement`'s `__managed_get_unchecked` — and a narrow signed enum element takes this
			// arm, so `for s in a` is sign-extended here rather than by the corpus one. The corpus half above is
			// still load-bearing for `pop`/`last`/`remove`; both are the same question asked of the
			// same function, which is why one being reachable cannot make the two disagree.
			let read = self.emitNarrowSignedSlotRead(slotValue, valueType: trivialType, range: range)
			self.noteLiteralColumnRead(read, container: container, column: LiteralColumn.first)
			return read
		end 'trivial'

		let resultType = self.elementAccessorResultType(giid)
		let result = self.emitRuntimeCall(callee, args: args, resultTag: maxonTypeTag(resultType), resultNameId: typeNameIdOf(resultType), range: range)
		self.markElementReadSurface(result, container: container)
		self.markStoredElementRead(result, container: container, qualifier: self.signatures.genericInstanceArgQualifier(giid, position: ContainerElementArgPosition))

		// An element read wears the brand the instantiation spelled its element with (`Rows = Array with Row`).
		self.brandValue(result, brand: self.elementBrandOf(giid))

		// ⭐⭐ **A RETAINED READ — THE CONTAINER KEEPS THE ELEMENT AND THE CALLER TAKES A REFERENCE OF ITS
		// OWN.** It is the `movedOut` arm plus the `+1` that makes it honest, and NOT a borrow: a borrow's
		// safety rests on the container not releasing the element, which is precisely what
		// `__ManagedListNode.setValue` does. The incref goes through `emitIncref` for `emitManagedListNodeHandle`'s
		// stated reason — that door is where *"after this line the allocation has two owners"* is recorded and
		// where the retain is kept off a block-form `try`'s handler edge.
		//
		// ⚠ **THE CONTAINER IS NOT SCOPE-PROMOTED, because it is not owed.** The
		// value holds its own reference, so nothing about the container's lifetime can dangle it — which is
		// the whole difference from the arm below and the reason a third answer had to exist.
		if reference == ContainerElementReference.retained 'retainedRead'
			self.emitIncref(result, range: range)
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.coOwned)
			return result
		end 'retainedRead'

		if reference == ContainerElementReference.movedOut 'moveOut'
			// ⛔ **CO-OWNED: REMOVING AN ELEMENT PROVES THE CONTAINER NO LONGER HOLDS IT, NOT THAT NOBODY DOES.**
			// `append`/`push` of a BORROWED aggregate co-owns it (`moveManagedValueInto`'s borrowed arm), so the
			// element handed back here may be a reference the CALLER still shares — MEASURED as 0xC0000005 on
			// `list.append(<a borrowed union>)` + `removeFirst()` + `match`. ⭐ The `Array` spelling of that same
			// program always passed, because `Array.remove` is a CORPUS member reaching `enrolOwnedCallTemp`,
			// which is co-owned; this compiler-emitted door was the one still claiming sole, and two spellings of
			// one operation must not disagree. See `OwnedHeapExclusivity`.
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.coOwned)
		end 'moveOut' else 'borrowsInPlace'
			// ⭐⭐ **A CONTAINER THE STATEMENT ALONE OWNS IS HELD TO THE SCOPE'S EXIT, BECAUSE THE ELEMENT JUST
			// HANDED OUT POINTS INTO IT.** ⚖ USER RULING, 2026-08-01: extend the TEMPORARY's lifetime. Without
			// it, `let n = try make().get(0) otherwise …` frees `make()`'s array at the statement's end
			// (`drainPendingTemps`, or the release `desugarTry` places on an abandoning path) while `n` still
			// names an element inside it — **`4557430888798830399`** = `0x3F3F3F3F3F3F3F3F`, a freed box's poison
			// byte read back as a `count()`. **A WRONG ANSWER in every channel this project has**: not a crash,
			// not a refusal, and no leak (the free is legitimate), so a green suite says nothing about it.
			//
			// ⭐ It is stated HERE, at the one door every in-place read THIS FUNCTION emits leaves through, rather than at the
			// five arms that reach it — the same argument `markElementReadSurface` makes one line up. So `get`,
			// `first`, the `for … in` element read and the list's two accessors are covered by one line
			// and a further arm cannot miss it. ⚠ **`last`/`pop`/`remove` ARE NOT AMONG THEM**: they are CORPUS
			// calls, so their lifetimes are `emitCall`'s. See this function's ⛔⛔ header block.
			//
			// ⚠ **IT IS THE BASE THAT IS PROMOTED, NOT THE ELEMENT THAT IS RETAINED** — the ruling's other
			// half. Retaining here would make `get` mean two different things depending on the RECEIVER's
			// provenance, which is exactly the shape the roster family keeps costing. There is no liveness pass at drop-insertion time — drops are emitted at parse — so the
			// lifetime taken is the coarser SCOPE one. The worst case is a slightly-later decref, never an
			// early free.
			//
			// A TRIVIAL concrete element returned from the arm above and never reaches here, so the promotion
			// costs nothing for the `Array with Integer` case that borrows nothing. An OPAQUE element does reach
			// here and is promoted: the shared body cannot know whether the instantiation's element owns heap,
			// and holding the container is inert for a trivial one and necessary for a managed one.
			self.giveTemporaryScopeLifetime(container, name: BorrowSourceBindingName)

			if not borrowedElementReadCallee(callee) 'aReadTheHoldResolverDoesNotKnow'
				panic("emitContainerElementAccessor: '{String.from(callee)}' borrows an element in place but is not a `borrowedElementReadCallee`, so the hold resolver would not follow the chain of a hold taken on its result")
			end 'aReadTheHoldResolverDoesNotKnow'

			self.markElementRead(result)
		end 'borrowsInPlace'

		return result
	end 'emitContainerElementAccessor'

	// ⭐⭐ **READ A VALUE OF `valueType` THAT MAY HAVE COME OUT OF A NARROW SIGNED SLOT — the ONE door both
	// halves of `enum-narrow-storage`'s read side go through**, so the direct element accessor above and the
	// opaque-word retype at `emitCall` cannot come to disagree about which types extend or how wide.
	//
	// `narrowSignedSlotOf` answers `notASignExtension` for everything else, so this is a pass-through for
	// every value in every program that has no narrow signed enum — which is why the callers ask it
	// unconditionally rather than guarding first and asking twice.
	// The value a parameter's NAME binds to: the slot itself, or the sign-extended reading of it when the
	// parameter is declared at a type stored in a narrow signed slot — see `bindParameters` for why the
	// callee's entry is the only place the third door can be. The extension lands in the ENTRY block, which
	// is current at both call sites and dominates every use of the parameter.
	function narrowSignedParamValue(slot ValueId, paramType MaxonType, range SourceRange) returns ValueId
		if not self.job.buildsBodies 'noBodyToReadIt'
			return slot
		end 'noBodyToReadIt'

		return self.emitNarrowSignedSlotRead(slot, valueType: paramType, range: range)
	end 'narrowSignedParamValue'

	function emitNarrowSignedSlotRead(value ValueId, valueType MaxonType, range SourceRange) returns ValueId
		match self.narrowSignedSlotOfLocalType(valueType) 'slot'
			fromBytes(slotBytes) then return self.emitSignExtendFromSlot(value, slotBytes: slotBytes, valueType: valueType, range: range)
			notASignExtension then return value
		end 'slot'
	end 'emitNarrowSignedSlotRead'

	// ⭐⭐ **THE NARROW SIGNED SLOT `valueType`'s VALUES OCCUPY — asked of a type interned in THIS FILE's
	// table, which is why the NAME crosses and the id does not.** `ProgramSignatures` classifiers must be
	// asked in the INDEX's space (`slotTypeThroughReceiver`'s ⚠ block); both callers here hold a
	// type the parser re-interned (`containerSlotValueType`, `slotTypeThroughReceiver`), so the id is this
	// file's and only the name means the same thing on both sides.
	//
	// ⚠ **MEASURED — the id form of this call was a WRONG ANSWER that depended on an unrelated declaration.**
	// `let o = [Offset.behind, Offset.here, Offset.ahead]` then `o.first()` over a three-case enum at
	// `-200 … 200` answered `-200` in a program that also declared `typealias Offsets = Array with Offset`
	// and **65336** in one that did not — the extra declaration only changed which order the two interners
	// assigned ids in.
	function narrowSignedSlotOfLocalType(valueType MaxonType) returns SignExtendSlot
		if maxonTypeTag(valueType) != ValueTypeTag.named 'onlyANamedLeafCanBeNarrowAndSigned'
			return SignExtendSlot.notASignExtension
		end 'onlyANamedLeafCanBeNarrowAndSigned'

		return self.signatures.narrowSignedSlotOf(self.internedName(typeNameIdOf(valueType)))
	end 'narrowSignedSlotOfLocalType'

	// ⭐⭐ **IS THIS ARGUMENT AN ENUM VALUE? — the gate that keeps `enum-narrow-storage`'s constant enum tags
	// out of the range-check ARG SITES.** Recording a case's tag as a known constant (`emitEnumTagLiteral`)
	// was needed so a constant enum literal could become a `.rdata` blob, and it had a second reacher:
	// `recordConstantArgRangeChecks` admits on `constIsKnown`, so EVERY enum-valued argument in EVERY
	// program would have started allocating a `RangeCheckArgSite`.
	//
	// ⚠ **THE SITE COULD NEVER PRODUCE A CHECK, which is why this is a gate and not a trade.**
	// `InsertRangeChecks.paramAliasOf` resolves an arg site against the CALLEE's ranged PARAMETERS, and a
	// parameter declared at an enum type is never among them (an enum has no `int(lo to hi)` declaration for
	// `paramSites` to hold). So the site was a parse-time allocation per call site with a structurally
	// guaranteed `paramAliasOf` miss at the other end — the `+N per call site, parse only` shape
	// `docs/optimization-log.md` has caught three times.
	//
	// ⚠ It asks whether the name is a DECLARED ENUM and not merely whether the tag is `named`, because a
	// ranged-alias value is `named` too (`7 as Byte`) and its site is the one this door exists for.
	function argIsAnEnumValue(argValue ValueId) returns bool
		return self.typeIsEnumOrUnion(self.tagOf(argValue), nameId: self.valueNameId(argValue))
	end 'argIsAnEnumValue'

	// ⭐⭐ **SIGN-EXTEND A VALUE READ OUT OF A NARROW SIGNED SLOT — ONE compiler-only unary op.** The width
	// comes from the slot the storage ladder chose, mapped by `signExtendFromSlotBytes`, so the op and the
	// stride are one derivation; the expansion into shifts is the Std tier's
	// (`LowerMaxonToStd.lowerSignExtend`), and `MaxonUnaryOp`'s header carries why it may not be shifts here.
	//
	// ⚠ **THE RESULT KEEPS THE VALUE'S OWN TYPE, not `integer`.** It IS the element — `v.rawValue` and
	// `match v` are what happens next — and typing it `integer` would be the same lost identity
	// `emitContainerElementAccessor`'s trivial arm already measured for a `Byte` (`E3005 requires a
	// Array with Byte`, a false reject). That is why it does not go through `emitUnaryOp`, which mints
	// at a bare TAG and would drop the enum's interned name.
	function emitSignExtendFromSlot(value ValueId, slotBytes ByteOffset, valueType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(valueType)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.unaryOp(result, operand: value, op: signExtendFromSlotBytes(slotBytes)), range: range)
		return result
	end 'emitSignExtendFromSlot'

	// ⭐ **AN ELEMENT READ OFF AN ARRAY OF BUFFERS IS A BUFFER.** Placed at the accessor's ONE mint
	// rather than at the five arms that reach it (`get`, `first`, `last`, `pop`, `remove` — plus the `for … in`
	// loop's unchecked read), because every one of them funnels through that line and a per-arm mark would be
	// the enumeration that misses the sixth. A trivial element never arrives here at all: an `Array with
	// Integer` returns from the early arm above, and no trivial element can be a buffer.
	//
	// ⚠⚠ **THE CONTAINER IS PASSED IN, NOT RECOVERED FROM `args.get(0)`.**
	// The premise "argument 0 is the container, which is the runtime ABI" holds for every `__managed_*`
	// accessor — `__managed_get(arr, i)`, `__managed_pop(arr)`, `__managed_remove(arr, i)` — and is FALSE for the list's
	// loop read: `__list_node_value(node)` takes the NODE the value sits in, so `args.get(0)` there is a node
	// pointer, and asking a buffer-surface question of it answers `false` by accident rather than by
	// derivation. A premise that has broken is not a premise, so the value comes from the caller, which holds
	// the container in every arm regardless of where the ABI happens to put it.
	function markElementReadSurface(result ValueId, container ValueId)
		if self.valueElementIsBufferSurface(container) 'containerHoldsBuffers'
			self.markBufferSurface(result, origin: self.brandOf(result))
		end 'containerHoldsBuffers'
	end 'markElementReadSurface'

	// The VALUE type an element accessor's result carries — the opaque element's own `typeParameter(token)` for an
	// OPAQUE array (the shared body keeps the element opaque; its drop is descriptor-gated, `decrefCalleeFor`'s
	// `typeParameter` arm → `__drop_type_param`), else the CONCRETE managed element's usable value form
	// (`containerSlotValueType`). Split so `emitContainerElementAccessor` reads ONE type either way; the opaque
	// `typeParameter` carries a POSITION, not an interned name, so it needs no interner adoption.
	function elementAccessorResultType(giid GenericInstanceId) returns MaxonType
		if self.signatures.containerElementIsOpaque(giid) 'opaque'
			return self.signatures.containerElementType(giid)
		end 'opaque'

		return self.containerSlotValueType(self.signatures.containerElementType(giid))
	end 'elementAccessorResultType'

	// ⭐ **THE ONE DOOR FOR "A RUNTIME CALL WHOSE RESULT IS A FRESH OWNED HEAP VALUE".** The result carries the
	// value type the caller names and is enrolled as a statement-scoped OWNED temporary (`trackOwnedTemp`), so
	// an UNBOUND result is dropped at statement end and a bound one transfers to the binding; its scope-exit
	// drop then routes by TAG through `decrefCalleeFor` (`__managed_decref` for an instance, `__str_decref` for a
	// String), which is why the tag is the caller's to state and nothing here needs to know the family.
	//
	// ⚠ **SINGLE-SOURCED SO THE OWNERSHIP PROTOCOL HAS ONE HOME** — the whole-array
	// `slice`/`clone`, `Set from […]`, a subprocess line read and the
	// String byte methods are all the same two-step ownership protocol (`emitRuntimeCall` + `trackOwnedTemp` + return),
	// so a change to what enrolling an owned temporary costs (an
	// escape mark, a second registry, a different drop door) is made once and not in four places that each
	// read as correct on its own — the failure mode being a LEAK or a double-free in whichever copy was missed,
	// never a compile error.
	//
	// The callers that pass `genericInstance` + the receiver's own `giid` get a result typed as the receiver:
	// `sub.get(0)`/`sub.count()` dispatch on the result because it is the SAME instance type as the
	// receiver. `slice` is THROWING, so this must stay the last op it emits — the enclosing `try` rewrites it
	// to a `tryCall`, and `finishValueTry` reconciles the OWNED result with an OWNED `otherwise` fallback (both
	// drop once, on their own edge).
	// ⚠ **`sole` IS ABOUT THE RECORD THIS RETURNS, WHICH IS THE ONLY THING A DROP OR A DESTRUCTIVE WRITE
	// TOUCHES.** `__str_bytes_view` is the one entry here that hands back a record VIEWING bytes another
	// allocation owns — but the record itself is freshly minted and has exactly one owner, and a byte record has
	// no payload or field slot for a move-out to null. See `OwnedHeapExclusivity`.
	//
	// ⛔ **AND THIS IS THE ONE `sole` IN THE FILE THAT RESTS ON THE SET OF CALLEES RATHER THAN ON AN OP — SO THE
	// FRESHNESS IS THE CALLEE'S TO EARN, NOT THIS DOOR'S TO ASSUME.** Every runtime entry reaching here today
	// mints its result, so the claim holds; but it holds by ENUMERATION, and this tree's enumerated doors rot.
	// FOUR of them already return a `structRef` (`__file_open`, `__dir_open_search`, `__charset_make`, and the
	// per-type deep-cloner `__clone_<T>` a source `p.clone()` emits — whose first act is an `__mm_alloc`, so
	// `sole` is exact for it), and a
	// struct box CAN serve as the box `lastFieldRead` records for a `throw box.unionField` — so a later entry that handed
	// back a SHARED record would inherit `sole` here in silence and re-arm the destructive write
	// `OwnedHeapExclusivity` documents three segfaults for. ⇒ **Adding a runtime entry whose result is not
	// freshly minted means passing `coOwned` here, not extending this list.** (It is the enumerated-doors shape
	// rather than transitive soleness — a different bug class,
	// and not live today.)
	function emitOwnedRuntimeResult(callee ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange, exclusivity OwnedHeapExclusivity = OwnedHeapExclusivity.sole) returns ValueId
		let result = self.emitRuntimeCall(callee, args: args, resultTag: resultTag, resultNameId: resultNameId, range: range)
		self.trackOwnedTemp(result, exclusivity: exclusivity)
		return result
	end 'emitOwnedRuntimeResult'

	// `slice(start, end)` — both positional; the `endIndex:` label the `Array` spelling required is OPTIONAL on
	// this surface (see `consumeArrayArgLabel`), and this surface is the only one that reaches
	// here. Emits the throwing `__managed_slice(arr, start, end)` as the LAST op so the enclosing `try` rewrites
	// it; returns the fresh owned array. Neither argument is a managed move-in (both are plain indices).
	//
	// ⭐ **A SLICE OF A BUFFER IS A BUFFER, WHICH IS WHY THE MARK REACHES THE RESULT AND NOT ONLY THE LABEL.**
	// `specs/managed-memory-builtin.md:slice` reads `s.length()` off the result and
	// `managed-memory-methods.bounds-slice-oob` does the same, so the surface must survive the operation — which
	// it does by riding the VALUE (`markBufferSurface`), the only carrier available when both surfaces share one
	// `GenericInstanceId` (see `Parser.bufferSurfaceValues`).
	function parseArraySlice(func IrFunction, arr ValueId, giid GenericInstanceId, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let start = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.consumeArrayArgLabel(EndIndexArgLabel, required: false)
		let endIndex = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.consume(TokenKind.rightParen)
		let sliced = self.emitArraySliceCall(giid, arr: arr, start: start, endIndex: endIndex, range: range)
		self.markBufferSurface(sliced, origin: self.brandOf(sliced))

		// And a slice of an array OF buffers is an array of buffers — the same rule one container out, which is
		// why the two live side by side rather than in one test: a value can be either, and never both.
		return self.inheritArrayElementSurface(sliced, source: arr)
	end 'parseArraySlice'

	// ⭐ **A COPY OF AN ARRAY OF BUFFERS HOLDS BUFFERS.** A whole-array producer hands back a value of the
	// receiver's own instance, and the element spelling cannot ride that instance (`Array with __ManagedMemory`
	// and `Array with ByteArray` are one id) — so it rides the value here. MEASURED before this line:
	// `bufs.clone().get(0).length()` was refused as an unknown `Array` method while `bufs.get(0).length()`
	// answered.
	//
	// ⚠ **ITS CALLERS INCLUDE EVERY CORPUS `Self` RETURN** (`retypeInstanceMethodResult`), because the `Array`-surface
	// `slice` is `stdlib/Array.maxon`'s declaration and the same fact has to reach it. One helper, asked from the
	// synthesized side and from the corpus side, rather than a second answer on each. ⇒ **`bufs.clone()` above is
	// served by that CORPUS route (`clone` is not on the roster), so the measurement it records is answered by the
	// `Self`-return caller rather than by an arm of its own.**
	function inheritArrayElementSurface(result ValueId, source ValueId) returns ValueId
		if self.valueElementIsBufferSurface(source) 'sourceHoldsBuffers'
			self.markBufferSurfaceElements(result)
		end 'sourceHoldsBuffers'

		return result
	end 'inheritArrayElementSurface'

	function emitArraySliceCall(giid GenericInstanceId, arr ValueId, start ValueId, endIndex ValueId, range SourceRange) returns ValueId
		if self.signatures.containerElementIsOpaque(giid) 'opaqueSlice'
			return self.emitOwnedRuntimeResult(ManagedSliceOpaqueName, args: threeArgs(arr, second: start, third: endIndex), resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
		end 'opaqueSlice'

		if self.signatures.containerElementIsManaged(giid) 'managedSlice'
			return self.emitOwnedRuntimeResult(ManagedSliceManagedName, args: fourArgs(arr, second: start, third: endIndex, fourth: self.arrayElementCloneValue(giid, range: range)), resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
		end 'managedSlice'

		return self.emitOwnedRuntimeResult(ManagedSliceName, args: threeArgs(arr, second: start, third: endIndex), resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
	end 'emitArraySliceCall'

	// `append(other)` — append `other`'s elements to `self`. `other` is BORROWED (read-only, not moved) and
	// PRESERVED (`append-preserves-originals`). Its element must be one the receiver's admits every value of,
	// which the rule all three spellings share enforces (`ProgramSignatures.arrayAppendArgAdmits`); only the
	// SENTENCE is per-surface, which is what `bufferSurface` selects — see the caller. A TRIVIAL receiver
	// block-copies `other`'s bytes (`__managed_append`); a CONCRETE MANAGED receiver
	// DEEP-CLONES each `other` element into `self` via `__managed_append_managed`, stamped with the element's
	// `funcAddr(__clone_<E>)`, so both arrays end up sole owners of independent elements. Returns the receiver
	// (what the statement still denotes).
	function parseArrayAppend(func IrFunction, arr ValueId, giid GenericInstanceId, methodTok Token, bufferSurface bool, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let other = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.requireAppendArg(other, arr: arr, giid: giid, methodTok: methodTok, bufferSurface: bufferSurface)
		try self.consume(TokenKind.rightParen)

		if self.signatures.containerElementIsOpaque(giid) 'opaqueAppend'
			return self.emitArrayVoidCall(ManagedAppendOpaqueName, args: twoArgs(arr, second: other), receiver: arr, range: range)
		end 'opaqueAppend'

		if self.signatures.containerElementIsManaged(giid) 'managedAppend'
			return self.emitArrayVoidCall(ManagedAppendManagedName, args: threeArgs(arr, second: other, third: self.arrayElementCloneValue(giid, range: range)), receiver: arr, range: range)
		end 'managedAppend'

		return self.emitArrayVoidCall(ManagedAppendName, args: twoArgs(arr, second: other), receiver: arr, range: range)
	end 'parseArrayAppend'

	// The argument rule all three `append` spellings make. The whole VERDICT is
	// `ProgramSignatures.arrayAppendArgAdmits` — one record, one operation, one precondition, stated
	// where the element types live so no door may respell it; `appendArgMismatch` chooses only the
	// sentence.
	//
	// ⚠ Both sentences anchor on the METHOD NAME, never on the argument, because that is what the
	// reference pins: `specs/type-checking.md`'s `method-call-wrong-self-type` fixes the `append`
	// token of `arr.append("hello")` and its `array-of-different-element-types` the `append` of
	// `ints.append(strings)`. A DECLARED call anchors on the call op
	// (`SemanticCheck.checkOneArgType`), so one refusal reachable through three doors would
	// otherwise carry three anchors.
	function requireAppendArg(other ValueId, arr ValueId, giid GenericInstanceId, methodTok Token, bufferSurface bool) throws SourceParseError
		if self.signatures.arrayAppendArgAdmits(giid, argTag: self.tagOf(other), argNameId: self.valueNameId(other), readerFilePath: self.job.path) 'admitted'
			return
		end 'admitted'

		let mismatch = self.appendArgMismatch(other, arr: arr, methodTok: methodTok, bufferSurface: bufferSurface)

		try self.refuseUnlessDeferred(mismatch, value: other)
	end 'requireAppendArg'

	// Which sentence a refusal gets is a property of the SURFACE the author wrote rather than of
	// the rule: the buffer's parameter is declared `__ManagedMemory`, so its mismatch names that
	// type and its `other` label (`builtin-type-checking.error-managed-memory-append-int` pins the
	// wording), while `Array.append` and `appendMemory` name the RECEIVER's own instance and read
	// the parameter name off the spelling the author wrote (`appendArgParamName`), so
	// `appendMemory` is never told to fix an `other` it does not declare.
	function appendArgMismatch(other ValueId, arr ValueId, methodTok Token, bufferSurface bool) returns SourceParseError
		if bufferSurface 'bufferSentence'
			return SourceParseError.builtinArgumentType(String.from(ManagedMemoryOtherParamName), expected: String.from(ManagedMemoryTypeName), got: self.valueDisplayTypeName(other), line: methodTok.line, column: methodTok.column, expectedNote: "", crossesRange: false)
		end 'bufferSentence'

		return SourceParseError.builtinArgumentType(String.from(appendArgParamName(methodTok.value)), expected: self.valueDisplayTypeName(arr), got: self.valueDisplayTypeName(other), line: methodTok.line, column: methodTok.column, expectedNote: "", crossesRange: false)
	end 'appendArgMismatch'

	// ⭐ **THE COPY GATE for `slice`/`clone`/`append` on a CONCRETE-element array.** An element that owes no
	// drop passes (its copy is a correct byte blit / COW view). A CONCRETE MANAGED element (String / struct
	// / boxed union) passes too — its copy is a per-element DEEP CLONE (`arrayElementCloneValue`
	// stamps the element's `funcAddr(__clone_<E>)` into the `_managed` runtime call). What
	// REJECTS (E2015) is a managed element whose nested type NOTHING can clone: a base-struct-less
	// generic instance with no runtime copy of its own (a cursor — a DECLARED generic's instance has its
	// per-instance cloner, and the managed buffer and the chain their runtime walks), an OS handle, or an
	// existential. An element that is or holds a promise is E3141: a copy would give two owners one thread.
	//
	// ⭐ **A CONTAINER WHOSE OWN ELEMENTS ARE MANAGED (an array-of-managed-arrays, a `List with String`)
	// PASSES.** Its copy is a 2-argument
	// `<containerClone>(box, funcAddr(elementClone))`, which `callIndirect(fn, elem)` cannot reach — an ARITY
	// bound on the entry point, never an impossibility — and a per-instance one-argument thunk closes it
	// (`SignatureIndex.managedElementRecordCopy`).
	//
	// An OPAQUE-`T` element (a generic body) is routed to `requireOpaqueArrayCopyable`
	// by `requireArrayCopyMethodSupported` instead, so only CONCRETE elements reach here.
	function requireArrayElementCopyable(giid GenericInstanceId, methodTok Token) throws SourceParseError
		if not self.signatures.containerElementOwesDrop(giid) 'trivial'
			return
		end 'trivial'

		let verdict = self.signatures.sourceCloneVerdictOfType(self.signatures.containerElementType(giid))

		if verdict != SourceCloneVerdict.cloneable 'unsupportedNested'
			try self.requireCloneCopiesNoGreenThread(verdict, subject: "an element of this array", memberTok: methodTok)
			try self.refuseCloneOfAnUncloneableConformer(self.signatures.uncloneableExistentialInElementOf(giid), memberTok: methodTok)

			throw SourceParseError.unsupported("`{String.from(methodTok.value)}` on an array whose managed element has a nested type this compiler cannot deep-clone — an OS handle, or an ELEMENT that is itself held at an interface type. String / struct / boxed-union / declared-generic-instance / container elements, including nested String, struct, union, Array, FixedArray, chain, instance and interface-typed fields and a managed-element container of any depth, ARE supported.", line: methodTok.line, column: methodTok.column)
		end 'unsupportedNested'
	end 'requireArrayElementCopyable'

	// ⭐ **THE ELEMENT-CLONER `funcAddr` STAMP** — the DUAL of `columnDestroyValue`. A
	// CONCRETE managed element knows its `(box) -> newBox` clone callee at this site (`__str_clone` / `__clone_<T>`
	// / `__managed_clone` for a trivial-element nested array), so the address rides the `funcAddr` code→register
	// path — the `_managed` runtime helper `callIndirect`s it per element. `requireArrayElementCopyable` has already
	// guaranteed the strategy is `direct` (an element cloner must satisfy `callIndirect(fn, elem)`); a `managedElements`/
	// `unsupported` strategy at the TOP element is a gate drift, not a valid program.
	function arrayElementCloneValue(giid GenericInstanceId, range SourceRange) returns ValueId
		match self.signatures.containerElementCascadeStrategy(giid, action: CascadeAction.clone) 'strategy'
			direct(callee) then return self.emitCodeAddress(callee, range: range)
			managedElements then panic("arrayElementCloneValue: a top-level managed array element resolved to `managedElements` — requireArrayElementCopyable gates this to a `direct` element cloner")
			throughWitness then panic("arrayElementCloneValue: a top-level managed array element is held at an interface type, which `instanceGraphSupportsDeepClone` refuses — an element slot is one machine word and a fat pointer is two")
			unsupported then panic("arrayElementCloneValue: a top-level managed array element resolved to `unsupported` — requireArrayElementCopyable rejects it at the front end")
		end 'strategy'
	end 'arrayElementCloneValue'

	// The VALUE type an element is loaded as and checked against — the element's declared type retyped to its
	// usable value form (a struct → `structRef`, a boxed union → its `named(<union>)`, a String → text, a
	// nested Array / instance → `genericInstance` so `retrieved.count()` dispatches, a trivial element → its
	// own declared type, alias name intact so the shift rule keeps reading its low bound).
	//
	// It is TWO shared steps and nothing of its own. `ProgramSignatures.declaredSlotType` resolves what the
	// declaration sweep could not yet name — a generic alias (`ByteArray` = `Array with Byte`), a function
	// alias, a float alias — and adopts the id into this file's interner (a ranged alias that shifted the
	// interning order would otherwise misresolve); `classifyUnionPayload`/`payloadValueTypeOf` then
	// give the same value form a union payload and a struct field read. Spelling the alias→instance step
	// here as well as there is exactly how the FUNCTION-alias element goes missing: an
	// `Array with <function alias>` element stays `named`, i.e. an int.
	//
	// ⭐ **IT TAKES THE SLOT'S DECLARED TYPE, NOT A `giid`, because a `Map`'s VALUE column asks the identical
	// question of a different slot.** Keyed on the instance it would have had to re-derive "which argument is
	// the slot" per container, which is the enumeration a two-column container breaks; keyed on the TYPE, an
	// `Array` element and a `Map` value are one question with one answer.
	function containerSlotValueType(slotType MaxonType) returns MaxonType
		let declared = self.resolvedSlotType(slotType)
		let tag = maxonTypeTag(declared)

		if tag == ValueTypeTag.genericInstance 'instance'
			return declared
		end 'instance'

		if tag == ValueTypeTag.named 'named'
			// ⛔ **THERE IS NO GENERIC-ALIAS ARM HERE, AND A COPY OF ONE WOULD BE PROVABLY DEAD.** It would read
			// `isGenericAliasInAnyFile(name)` and re-tag to the instance — but `declaredSlotType` one line up already
			// asked that, over `denotedSlotType`, and its hit RETURNS a `genericInstance` the `instance` arm above
			// takes. Reaching this line with tag `named` therefore MEANS the name is not a generic alias, and the
			// two lookups cannot disagree: `adoptType` re-interns by the SAME name string, so the artifact table's
			// spelling and the index's are one. A live-looking copy of an arm the shared door owns may not survive one
			// door down from the door that owns it.
			let name = self.internedName(typeNameIdOf(declared))

			// ⭐⭐ **A RANGED-ALIAS ELEMENT KEEPS ITS NAME, AND THAT IS A TYPE-IDENTITY FIX, NOT A
			// REFINEMENT.** `classifyUnionPayload` below answers a STORAGE question — what width does this
			// payload occupy — and its answer for a ranged int alias is the bare `integer` the alias erases
			// to. That is right for a union payload and WRONG for an array element read, because the value
			// it types is handed straight back to source, where the NAME is what decides an array literal's
			// instance (`arrayLiteralInstanceFor` reads the tag): reading three `Byte`s out of an `Array
			// with Byte` and writing `[x, y, z]` produced an `Array with integer` — an 8-byte stride over
			// values that came out of a 1-byte one — so a byte read back through a literal was no longer a
			// byte. Erased, `String.from([x, y, z])` over a `b"Hi!"`'s own elements is a false reject:
			// `E3005 requires an argument of type Array with Byte, but its argument is Array_int`. It is also what makes an
			// array read AGREE with a function return, which never erased: `function pick(v Byte) returns
			// Byte` already yields a `named`-tagged value, so `[pick(72)]` was an `Array with Byte` while
			// `[bytes.get(0)]` was not.
			if let underlying = try self.signatures.aliasUnderlyingFor(name, readerFilePath: self.job.path) 'rangedAlias'
				// A FLOAT-underlying alias resolves to `float` exactly as it does everywhere else
				// (`resolveFloatAliasType`) — the `named` tag cannot carry a float VALUE, whose class is XMM.
				return MaxonType.float if tagIsFloat(maxonTypeTag(underlying)) else declared
			end 'rangedAlias'
		end 'named'

		return payloadValueTypeOf(classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: declared, slotScopeFilePath: self.job.path), declared: declared)
	end 'containerSlotValueType'

	// ⭐ **WHAT A SLOT'S STORED TYPE ACTUALLY DENOTES, adopted into THIS file's interner** — a generic alias to
	// its instance (`ByteArray` = `Array with Byte`), a FUNCTION alias to `function`, a float alias to `float`.
	// The `into`/`slotScopeFilePath` pair is the same at every slot door in this file and was spelled out at
	// each of them; a slot type that shifted the interning order otherwise misresolves, which is a
	// silent wrong type rather than a diagnostic, so the triple is written once.
	//
	// ⚠ It is the FIRST STEP of `containerSlotValueType` above and not a synonym for it: that one goes on to
	// retype the result into the value form a READ hands back (a union payload, a struct field). The doors that
	// only need to know what the declaration NAMES — the column type checks — stop here.
	function resolvedSlotType(slotType MaxonType) returns MaxonType
		return self.signatures.declaredSlotType(slotType, into: self.artifact.typeNames, slotScopeFilePath: self.job.path)
	end 'resolvedSlotType'

	// ⭐⭐ **AN ELEMENT ARGUMENT MUST AGREE WITH THE INSTANCE'S ELEMENT TYPE.** The `Array` mutators are
	// PARSER-INTRINSIC — `push`/`set` emit `__managed_push`/`__managed_set` directly, so they
	// have no `FuncSignature` and never reach `SemanticCheck.validateCall` — and nothing else
	// asked the question at all: `moveElementIntoContainer` asks only about OWNERSHIP. All three symptoms were
	// MEASURED, and none of them was a diagnostic:
	//
	//   • `Array with String` + `push(42)` — compiled clean, then the array's `__managed_decref` walk freed `42`
	//     as a String pointer. A WILD FREE (0xC0000005).
	//   • `Array with Integer` + `push("hello")` — compiled clean and printed the record's raw address as an
	//     integer. A SILENT WRONG ANSWER.
	//   • `Array with Integer` + `push(1.5)` — reached the backend and panicked there on an xmm→gpr move,
	//     an internal error naming no source position, for a conversion the language refuses everywhere else.
	//
	// **IT IS `requireFieldType`'S BODY, AND DELIBERATELY SO**: an array element is a storage slot of a
	// container exactly as a struct field is, so it takes the SAME classifier and the SAME two verdict doors
	// — `assignableValue` (the coercion-site rule `checkDeclaredType` plus the widening an `ok` verdict owes,
	// in one call) and then `requireElementIdentity` (the alias or enum name a tag cannot compare) for a
	// trivial element, `requireManagedValueMatches` (the matching heap kind, plus the
	// aggregate NAME two `structRef` pointers share a tag over) for a managed one. No sentence is composed
	// here: the array door and an ordinary assignment cannot come to explain one rule two ways.
	//
	// It is NOT folded into `requireFieldType` itself for one measured reason: that function names its site
	// with `fieldSiteName`, a `String`, built INSIDE its managed arm. A shared core taking a pre-built name
	// would make every SCALAR field pay an allocation it does not use today — the cost `FunctionTypeDoor`'s
	// own header records at +1,852 in `phase:parse` for exactly this shape. What is written twice is a
	// three-line composition; the RULE is single-homed.
	//
	// ⚠ **THE MANAGED/TRIVIAL ARM IS CHOSEN BY THE CLASSIFIER AND BY NOTHING ELSE, AND THAT COSTS A MEASURED
	// ALLOCATION WORTH PAYING.** `ProgramSignatures.containerElementIsManaged` answers the same question without
	// boxing anything, and asking it here instead saves exactly one `PayloadClass` box per trivial-element
	// `push`/`set`/`insert` SITE (measured on the ladder: 32 allocations at the smallest size, doubling to 1,024 at
	// the largest — 0.007% of the compile). It is NOT taken. The two predicates are SEPARATE implementations of
	// "does this own heap?" — they already disagree on a generic-ALIAS `named` type, which `typeIsManaged`
	// calls managed and `classifyUnionPayload` calls `undeclaredName` — and they agree at THIS door only
	// because `declaredSlotType` resolves that alias first. A door whose entire subject is two things
	// disagreeing about a type does not buy 0.007% with a second opinion whose failure mode is the wild free
	// it exists to stop.
	//
	// ⚠ **IT RUNS BEFORE THE MOVE-IN, NOT AFTER**, and that ordering is the fix rather than an ordering
	// preference: `moveElementIntoContainer` PROMOTES a borrowed record by the ELEMENT's protocol
	// (`tagIsByteRecord`), so a struct pushed into a `String` array would be copied as a fused byte record
	// before any check could see it. It hands back the value the slot wants, so the caller rebinds —
	// `push(2)` into an `Array with Real` stores the widened `2.0`, and a caller that stored the value it
	// already held is precisely the bug the shared door exists to make unwriteable.
	//
	// ⚠ **AN OPAQUE `T` ELEMENT IS NOT CHECKED, and that is the same ruling every other opaque door makes.**
	// A shared generic body compiles ONCE, so `self.items.push(item)` has no concrete element type to compare
	// against; the instantiation's argument is checked in the CALLER's frame, where the type is concrete.
	//
	// ⚠ **THE ARRAY LITERAL ENTERS BELOW, AT `requireElementFitsSlot`.** Its element has no method token to
	// name. A numeric literal element asks `requireElementIdentity` itself, before its conversion.
	//
	// ⚠ **AN INTEGRAL ELEMENT SLOT COERCES A CHARACTER LITERAL BEFORE IT COMPARES.** `a.push('e')`
	// into an `Array with Character` needs nothing — the literal already IS a Character — but pushing one into
	// an array of a ranged integer alias reaches the same codepoint conversion every other declared slot makes
	// (`integerizedOperand`). It needs the value's TOKEN SPAN, which is why the callers hand over `valueStart`
	// (the same position `moveElementIntoContainer` reads).
	function admitInstanceArgStore(func IrFunction, giid GenericInstanceId, position ElementIndex, value ValueId, valueStart ElementIndex, place String) throws SourceParseError
		let slot = qualifierSlot(self.signatures.genericInstanceArgQualifier(giid, position: position))
		try self.admitStore(func, slot: slot, value: value, valueStart: valueStart, place: place, holder: StoreHolder.unheld)
	end 'admitInstanceArgStore'

	function requireContainerElementType(giid GenericInstanceId, value ValueId, valueStart ElementIndex, methodTok Token) returns ValueId throws SourceParseError
		let place = "an element of the container {String.from(methodTok.value)} writes"

		try self.admitInstanceArgStore(self.bodyFunction(), giid: giid, position: ContainerElementArgPosition, value: value, valueStart: valueStart, place: place)
		return try self.requireElementFitsSlot(giid, slot: self.elementSlotOf(giid), value: value, valueStart: valueStart, site: ContainerElementSite.call(methodTok))
	end 'requireContainerElementType'

	function elementSlotOf(giid GenericInstanceId) returns ElementSlot
		if let answered = try self.memos.elementSlots.get(giid) 'alreadyAsked'
			return answered
		end 'alreadyAsked'

		self.memos.elementSlots.file(giid, value: self.freshElementSlot(giid))

		return try self.memos.elementSlots.get(giid) otherwise panic("elementSlotOf: the answer filed for {giid} one line up is missing")
	end 'elementSlotOf'

	function freshElementSlot(giid GenericInstanceId) returns ElementSlot
		let indexSpaceType = self.signatures.containerElementType(giid)
		let declared = self.resolvedSlotType(indexSpaceType)
		let alias = self.declaredAliasOfIndexSpaceType(indexSpaceType)

		if self.signatures.containerElementIsOpaque(giid) 'opaqueInSharedBody'
			return ElementSlot.create(indexSpaceType, declared: declared, declaredKeepingAlias: declared, alias: alias, fit: ElementFit.opaque)
		end 'opaqueInSharedBody'

		let payload = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: declared, slotScopeFilePath: self.job.path)
		let declaredKeepingAlias = self.typeKeepingAlias(indexSpaceType, collapsed: declared, scopeFilePath: self.job.path)

		return ElementSlot.create(indexSpaceType, declared: declared, declaredKeepingAlias: declaredKeepingAlias, alias: alias, fit: ElementFit.checked(payload))
	end 'freshElementSlot'

	function requireElementFitsSlot(giid GenericInstanceId, slot ElementSlot, value ValueId, valueStart ElementIndex, site ContainerElementSite) returns ValueId throws SourceParseError
		return match slot.fit 'fit'
			opaque gives value
			checked(payload) gives try self.requireValueFitsCheckedSlot(giid, slot: slot, payload: payload, value: value, valueStart: valueStart, site: site)
		end 'fit'
	end 'requireElementFitsSlot'

	// The nominal half of an element store, which `assignableValue` cannot ask: two aliases of one integer
	// or float share a tag. It is its own function because a `call` asks it after `assignableValue` while a
	// literal asks it before its conversion. A managed slot asks it inside `requireManagedValueMatches`, an
	// opaque slot has no concrete element type, and a deferred value was refused where it was minted.
	function requireElementIdentity(giid GenericInstanceId, slot ElementSlot, value ValueId, site ContainerElementSite) throws SourceParseError
		let askedElsewhere = match slot.fit 'fit'
			opaque gives true
			checked(payload) gives payloadClassIsManaged(payload)
		end 'fit'

		if askedElsewhere or self.valueIsDeferred(value) 'nothingToAskHere'
			return
		end 'nothingToAskHere'

		try self.requireSlotAggregateIdentity(slot.declaredKeepingAlias, value: value, placeDoor: FunctionTypeDoor.containerElement, placeName: containerElementSiteName(site), placeOwner: SlotOwner.unowned, placeBrand: self.elementBrandOf(giid), placeSpelling: self.elementBrandOf(giid), voice: SlotMismatchVoice.containerElementArgument, anchor: containerElementSiteAnchor(site))
	end 'requireElementIdentity'

	function requireValueFitsCheckedSlot(giid GenericInstanceId, slot ElementSlot, payload PayloadClass, value ValueId, valueStart ElementIndex, site ContainerElementSite) returns ValueId throws SourceParseError
		let anchor = containerElementSiteAnchor(site)
		let declared = slot.declared

		// A promise element is compared by its whole promise type, here and not by the two arms below: they
		// compare a tag, and the type's result and error are what must agree. The check only checks; taking the
		// promise is `storedContainerElement`'s.
		if self.valueIsPromise(value) and typeIsPromiseStorage(self.signatures, t: declared) 'promiseElement'
			try self.requirePromiseSlotAgrees(value, storage: genericInstanceIdOf(declared), anchor: anchor)
			return value
		end 'promiseElement'

		let element = try self.integerizedOperand(value, expected: maxonTypeTag(declared), start: valueStart, pastEnd: self.pos)

		if payloadClassIsManaged(payload) 'managed'
			let widened = self.interfaceHandleOf(element, declared: declared, first: anchor, last: anchor)
			try self.requireManagedSlotValueMatches(payload, declared: declared, value: widened, placeDoor: FunctionTypeDoor.containerElement, placeName: containerElementSiteName(site), placeOwner: SlotOwner.unowned, placeBrand: self.elementBrandOf(giid), placeSpelling: self.elementBrandOf(giid), voice: SlotMismatchVoice.containerElementArgument, anchor: anchor)
			return widened
		end 'managed'

		// The `field` door, not `containerElement`: on this arm the door only names the slot a function value
		// is refused from (a function-typed element is managed and recorded by the arm above), and
		// `functionTypeDoorNoun` panics for `containerElement`.
		//
		// The VOICE is the other axis and is the mutator's own: `push` is a METHOD and its element is that
		// method's ARGUMENT, so the type refusal is the argument sentence rather than the assignment one.
		// See `SlotMismatchVoice`, which records what calling `push` a "variable" was measured to say.
		let stored = try self.assignableValue(anchor, value: element, declared: maxonTypeTag(declared), declaredNameId: typeNameIdOf(slot.declaredKeepingAlias), door: FunctionTypeDoor.field, placeOwner: SlotOwner.unowned, voice: SlotMismatchVoice.containerElementArgument)

		// A literal element is asked in `admitArrayLiteralElement`, before its conversion retags it; asked
		// here it would compare the slot's alias with itself.
		match site 'identity'
			call then try self.requireElementIdentity(giid, slot: slot, value: element, site: site)
			literalElement then break
		end 'identity'

		// ⭐⭐ **THE ELEMENT'S DECLARED RANGE BINDS IT AT RUNTIME TOO — AND THE GUARD GOES
		// HERE, AT THE STORE, WHICH IS THE LAST PLACE THAT KNOWS THE ELEMENT TYPE.** The element
		// travels as `__managed_push`/`__managed_set`'s third argument, and the callee it travels
		// into is a SHARED `Array` body whose parameter is the OPAQUE element type — so a guard
		// at the callee's entry has no narrowed parameter to stand behind and structurally cannot reach it.
		//
		// ⭐ **A GUARD AT THE STORE DOES NOT LAND PAST THE CALL, AND THAT IS THE WHOLE DIFFERENCE FROM A CALL ARGUMENT.**
		// A general call argument has no alias at parse time (the
		// parameter belongs to a callee that may be in another file — `RangeCheckArgSite`), so it can record
		// no positioned site at all. An element's alias is RIGHT HERE, in the instance's declared element
		// type, and this runs BEFORE the store call is emitted — so `recordRangeCheckSite`'s
		// `bodyOpCount()` is the ordinal the `__managed_*` call is about to take, and the split lands the
		// cascade immediately in front of it. It is the ordinary alias-named site every other door records.
		//
		// ⚠ The zero-initialized slot `Array.resize` EXPOSES crosses no store, so it is refused at the
		// `resize` instead (E3106) for an element range that excludes zero.
		//
		// A literal element records no site: its range is checked by its conversion in
		// `admitArrayLiteralElement`.
		match site 'site'
			call(method) then self.recordRangeCheckSite(stored, destination: declared, line: method.line, column: method.column)
			literalElement then break
		end 'site'

		return stored
	end 'requireValueFitsCheckedSlot'

	function containerElementHoldsPromises(giid GenericInstanceId) returns bool
		let slot = self.elementSlotOf(giid)

		return match slot.fit 'fit'
			opaque gives false
			checked gives typeIsPromiseStorage(self.signatures, t: slot.declared)
		end 'fit'
	end 'containerElementHoldsPromises'

	function storedContainerElement(giid GenericInstanceId, value ValueId, valueStart ElementIndex, methodTok Token) returns ValueId throws SourceParseError
		let checked = try self.requireContainerElementType(giid, value: value, valueStart: valueStart, methodTok: methodTok)

		if self.valueIsPromise(checked) and self.containerElementHoldsPromises(giid) 'promiseElement'
			try self.takeOwnedPromise(checked, anchor: methodTok, range: SourceRange.ofToken(methodTok), door: methodTok.value)
		end 'promiseElement'

		return checked
	end 'storedContainerElement'

	// Every door that gives a promise a new owner — a store, a capture, a callee that takes it — takes it here.
	// `notConsumed`: the new owner holds a thread that runs on, so a later read of the source name is an
	// ordinary use-after-move (E3102) and not the spent-thread refusal E3142.
	function takeOwnedPromise(promise ValueId, anchor Token, range SourceRange, door ByteArray) throws SourceParseError
		if not self.valueIsDeferred(promise) 'anOwnerToRequire'
			try self.requireConsumedPromiseIsOwned(promise, anchor: anchor, door: door)
		end 'anOwnerToRequire'

		self.consumePromiseThread(promise, range: range, reclaimedBy: PromiseConsume.notConsumed)
	end 'takeOwnedPromise'

	function storedPromiseValue(value ValueId, storage GenericInstanceId, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		try self.requirePromiseSlotAgrees(value, storage: storage, anchor: anchor)
		try self.takeOwnedPromise(value, anchor: anchor, range: range, door: anchor.value)
		return value
	end 'storedPromiseValue'

	function requirePromiseSlotAgrees(value ValueId, storage GenericInstanceId, anchor Token) throws SourceParseError
		let held = self.typeOf(value)

		if maxonTypeTag(held) == ValueTypeTag.unresolved 'reportedElsewhere'
			return
		end 'reportedElsewhere'

		if typeIsPromiseStorage(self.signatures, t: held) and promiseStoragesAgree(self.signatures, a: genericInstanceIdOf(held), b: storage) 'agrees'
			return
		end 'agrees'

		throw SourceParseError.promiseStorageMismatch(promiseStorageMismatchDetail(self.storedValueDisplay(held), slot: String.from(self.signatures.instanceDisplayName(storage)), slotClaim: self.promiseClaimDisplay(storage)), line: anchor.line, column: anchor.column)
	end 'requirePromiseSlotAgrees'

	function storedValueDisplay(held MaxonType) returns String
		if typeIsPromiseStorage(self.signatures, t: held) 'aPromise'
			return promiseHeldDisplay(self.promiseClaimDisplay(genericInstanceIdOf(held)))
		end 'aPromise'

		return "a value of type '{self.displayTypeNameOf(maxonTypeTag(held), nameId: typeNameIdOf(held))}'"
	end 'storedValueDisplay'

	function promiseClaimDisplay(gid GenericInstanceId) returns String
		return promiseClaimText(self.promiseResultDisplay(gid), throwing: promiseStorageThrows(self.signatures, gid: gid))
	end 'promiseClaimDisplay'

	function promiseResultDisplay(gid GenericInstanceId) returns String
		if self.signatures.promiseAwaits(gid, returnType: MaxonReturnType.void) 'nothing'
			return PromiseOfNothingDisplay
		end 'nothing'

		let result = self.resolvedSlotType(self.signatures.substitutedInstanceArg(gid, position: PromiseResultArgPosition))
		return "'{self.displayTypeNameOf(maxonTypeTag(result), nameId: typeNameIdOf(result))}'"
	end 'promiseResultDisplay'

	// `( expr )` — a single positional array-method argument (`push(x)`, `get(i)`, `reserve(n)`).
	function parseArrayOneArg(func IrFunction) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let arg = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.consume(TokenKind.rightParen)
		return arg
	end 'parseArrayOneArg'

	// An arm-served member (`get`, `set`, `resize`) emits no `call` and enters no function, so neither
	// the caller-side literal check nor the callee's entry guard exists for its index. Both halves are
	// owed here: another alias is refused as `SemanticCheck.checkOneArgType` refuses it at a call, and
	// the recorded site lets `InsertRangeChecks` raise E3005 for a foldable value and guard the rest.
	//
	// The alias is the one the declaration names, resolved in its declaring file and carried on the
	// site (`RangeCheckSiteTarget.alias`): re-resolved against the calling file it would enforce a
	// program's own `typealias ElementIndex` instead.
	//
	// The declaration is the receiver's own, found by its base name. `arrayReceiverDeclaredName` spells
	// a library array `Array` even when a program's own `Array` is declared, so it would find the
	// program's declaration and enforce its index alias on a library array.
	//
	// ⚠ The buffer surface is exempt: a `__ManagedMemory` index is a machine word, and
	// `specs/managed-memory-methods.md` pins that `mm.set(-1, …)` still throws.
	function requireArmServedIndexArgument(giid GenericInstanceId, member ByteArray, value ValueId, anchor Token, bufferSurface bool) throws SourceParseError
		if bufferSurface 'aMachineWordNotAStdlibAlias'
			return
		end 'aMachineWordNotAStdlibAlias'

		try self.requireDeclaredIndexArgument(self.signatures.genericInstanceBaseName(giid), member: member, value: value, anchor: anchor)
	end 'requireArmServedIndexArgument'

	function requireDeclaredIndexArgument(receiverName ByteArray, member ByteArray, value ValueId, anchor Token) throws SourceParseError
		// A program's own array record may leave a roster member undeclared; its synthesized surface
		// carries no alias to enforce.
		let decl = try self.signatures.sweptDeclarationOf(qualifiedMethodName(receiverName, methodName: member)) otherwise return

		let paramName = try decl.paramNames.get(0) otherwise panic("requireDeclaredIndexArgument: {String.from(receiverName)}.{String.from(member)} is declared with no first parameter")

		let alias = try requireDeclaredAlias(self.signatures.declaredParamAliasAt(decl, position: 0)) otherwise panic("requireDeclaredIndexArgument: the first parameter of {String.from(receiverName)}.{String.from(member)} names no ranged typealias, so `corpusServesNamedMemberOffRoster` should have served the declaration as a call")
		try self.requireArgumentFitsDeclaredAlias(value, alias: alias, paramName: paramName, anchor: anchor)
	end 'requireDeclaredIndexArgument'

	function parseCreateLengthArg(func IrFunction, lengthOwner ByteArray, paramName ByteArray, aliasTok Token) returns ValueId throws SourceParseError
		let length = try self.parseBuiltinIntegerArg(func, paramName: paramName, methodTok: aliasTok)
		try self.requireDeclaredIndexArgument(lengthOwner, member: ArrayResizeMethod, value: length, anchor: aliasTok)

		return length
	end 'parseCreateLengthArg'

	function mintArrayCountResult(giid GenericInstanceId, bufferSurface bool) returns ValueId
		if bufferSurface 'theBuffersOwnCount'
			return self.mintValueOfType(self.signatures.libraryAliasType(CountAliasName, into: self.artifact.typeNames))
		end 'theBuffersOwnCount'

		let receiverName = self.signatures.genericInstanceBaseName(giid)

		match self.signatures.returnTypeOf(qualifiedMethodName(receiverName, methodName: CountMethod), into: self.artifact.typeNames) 'declaration'
			undeclared then return self.mintValueOfType(self.signatures.libraryAliasType(CountAliasName, into: self.artifact.typeNames))
			declared(returnType) then return self.mintValueOfType(requireDeclaredResultValue(returnType, typeName: receiverName, methodName: CountMethod))
		end 'declaration'
	end 'mintArrayCountResult'

	function requireArgumentFitsDeclaredAlias(value ValueId, alias RangedTypeAlias, paramName ByteArray, anchor Token) throws SourceParseError
		let expected = self.signatures.rangedIdentityOfSpelling(alias.name, readerFilePath: alias.declFilePath)
		let gotTag = self.tagOf(value)
		let gotNameId = self.valueNameId(value)
		let gotAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: gotTag, nameId: gotNameId, readerFilePath: self.job.path)

		if not tagIsIntegral(gotTag) or self.signatures.aggregatesConflict(expected, expectedTag: ValueTypeTag.named, expectedNameId: UnnamedTypeId, expectedBrand: EmptySourceText, got: gotAggregate, gotTag: gotTag, gotNameId: gotNameId, gotBrand: self.brandOf(value), readerFilePath: self.job.path) 'anotherAlias'
			throw SourceParseError.builtinArgumentType(String.from(paramName), expected: String.from(sourceSpelledAliasName(alias.name)), got: self.valueDisplayTypeName(value), line: anchor.line, column: anchor.column, expectedNote: "", crossesRange: self.signatures.crossesIntegerRange(ValueTypeTag.named, expected: expected, gotTag: gotTag, got: gotAggregate))
		end 'anotherAlias'

		self.recordRangedTargetSite(value, target: alias, line: anchor.line, column: anchor.column)
	end 'requireArgumentFitsDeclaredAlias'

	// The ` , <label> : ` separating one of a builtin method's positional arguments from the next —
	// `set`/`insert`'s `value:`, `slice`'s `endIndex:`, `sendFrom`'s `offset:` and `length:`. ONE home for that
	// shape, so a builtin method names its label and inherits the same "must be labelled `<label>:`"
	// diagnostic; the cursor is left on the token that begins that argument's value.
	//
	// ⚠ **IT IS NOT A TWO-ARGUMENT RULE, AND THE DIAGNOSTIC SAID IT WAS.** `__ManagedSocket.sendFrom` is the
	// compiler's first THREE-argument builtin method and calls this TWICE, so the throw below may not name an
	// arity or a position: it once read "the second argument of a two-argument builtin method", which told an
	// author about the second argument of a two-argument method while complaining about the third of a
	// three-argument one. The label is the only thing this reader knows and the only thing it now says.
	//
	// ⭐ The label is REQUIRED on an `Array` and OPTIONAL on the `__ManagedMemory` buffer.
	// `stdlib/Array.maxon` declares `set`/`slice` as ordinary methods, so E2053's "second and
	// subsequent arguments must be named" applies to `arr.set(0, 99)` on an `Array with Int`. A
	// `__ManagedMemory` member is a compiler BUILTIN and takes both spellings — `mm.set(0, 99)` and
	// `mm.set(0, value: 99)` — while a WRONG label is `E3003 unknown parameter name`. The corpus needs
	// both directions — `specs/managed-memory-builtin.md` writes `set(0, value: 11)` and `slice(1,
	// endIndex: 4)` while `specs/managed-memory-methods.md` writes `set(10, 99)` and `slice(0, 10)` —
	// so "optional, and checked when present" is the only rule that admits the corpus, and it may not
	// leak onto `Array`.
	//
	// ⇒ The requirement rides in from the ONE surface answer (`dispatchArrayMethod`'s `isManagedMemory`), so
	// there is no second derivation of which spelling a receiver takes.
	function consumeArrayArgLabel(label ByteArray, required bool) throws SourceParseError
		if not required and not self.atArgLabel(self.pos) 'positionalSecondArgument'
			try self.consume(TokenKind.comma)
			return
		end 'positionalSecondArgument'

		let labelTok = try self.consumeLabelToken()

		if not labelTok.value.equals(label) 'wrongLabel'
			throw SourceParseError.unsupported("this builtin method's argument must be labelled `{String.from(label)}:` (got '{String.from(labelTok.value)}:')", line: labelTok.line, column: labelTok.column)
		end 'wrongLabel'
	end 'consumeArrayArgLabel'

	// `, <name> :` — the token shape an argument LABEL is spelled as, and the NAME token it carries.
	// Written once because a reader's VERDICT is its own while the SHAPE is shared: `consumeArrayArgLabel`
	// asserts the ONE label it expects, and this returns the token for a caller that decides for itself. A
	// second copy of "this is what a label looks like" is a copy that can come to disagree about it.
	function consumeLabelToken() returns Token throws SourceParseError
		try self.consume(TokenKind.comma)
		let labelTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.colon)

		return labelTok
	end 'consumeLabelToken'

	// Is the ` , <name> : ` label shape at `index`? The LOOKAHEAD half of the consumer above — asked where a
	// label is OPTIONAL, so a `,` that is not followed by one is read as a POSITIONAL argument rather than
	// reported as a missing label. It is the same relationship `memberCallFollows` has with the chain walk
	// it stops: a predicate and a consumer over one shape, spelled once each and next to each other, so neither
	// can come to admit a token the other rejects.
	function atArgLabel(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.comma and self.kindAt(index + 1) == TokenKind.identifier and self.kindAt(index + 2) == TokenKind.colon
	end 'atArgLabel'

	// ⭐ **`( index , value: X )` — THE INDEXED ELEMENT STORE, whichever member spells it**: the index
	// positional, the value labelled `value:` on every surface but the buffer (see `consumeArrayArgLabel`).
	// Emits the `__managed_set` / `__managed_mem_set` / `__list_insert` call and returns its result. The value
	// argument is parsed AFTER the index so the call is the last op the enclosing `try` rewrites.
	//
	// ⚠ **IT HAS ONE CALL SITE**: `dispatchArrayMethod`'s single `set` arm, serving BOTH of its receivers —
	// which is what keeps `bufferSurface` live rather than a branch nothing can reach: it is
	// `isManagedMemory`, `false` for the array surface's `set(i, value: x)` and `true` for the buffer's
	// positional one.
	//
	// ⭐ **IT IS THE SURFACE ITSELF THAT ARRIVES, NOT A PARAPHRASE OF IT.** A parameter spelled
	// `secondArgLabelled: not isManagedMemory` is one fact under a second name, and the label rule is not
	// the only thing that reads it: the index's DECLARED RANGE is exempt on the buffer for a different
	// reason (a builtin's index is a machine word), so two paraphrases of one surface answer are two places
	// for it to drift. `parseArrayAppend` already spells it this way.
	//
	// ⚠ **EVERY SPELLING OWES THE THROW PATH'S HALF OF THE MOVE-IN CONTRACT.** `moveElementIntoContainer`
	// below runs BEFORE the call is emitted, so a callee that refuses owns the element and must destroy it —
	// `ManagedMemoryRuntime.emitDestroyRejectedElement`, which every entry reached through here calls from its
	// reject block. Shipping a fourth spelling without it is a leak, measured twice — on `__managed_set`
	// and on `__list_insert`.
	function parseArraySet(func IrFunction, arr ValueId, giid GenericInstanceId, callee ByteArray, methodTok Token, bufferSurface bool, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let index = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.consumeArrayArgLabel(ArrayValueLabel, required: not bufferSurface)

		// The value is a managed-element STORE, so it is handled exactly as `push` is —
		// `moveElementIntoContainer` promotes a borrowed String, co-owns an owned value a live binding keeps,
		// adopts an owned temporary, and co-owns a borrowed aggregate. `__managed_set` destroys the LIVE occupant it overwrites (its element_destroy walk of one
		// slot), so no leak. The TYPE check precedes the move-in for the reason `requireContainerElementType` states.
		let valueStart = self.pos
		self.stateContainerElementLiteralTargets(giid, valueStart: valueStart)
		let raw = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let checked = try self.storedContainerElement(giid, value: raw, valueStart: valueStart, methodTok: methodTok)
		let value = try self.moveElementIntoContainer(checked, giid: giid, valueStart: valueStart, destination: self.statement.elementStoreDestination)
		try self.consume(TokenKind.rightParen)

		// The INDEX's declared range, recorded here and not beside the `parseExpression` that produced it:
		// `recordRangeCheckSite` anchors on the ordinal the NEXT op takes, so recording it now puts the
		// cascade in front of the store rather than into the middle of the value's own evaluation — the
		// position the callee's entry guard would have held. See `requireArmServedIndexArgument`.
		try self.requireArmServedIndexArgument(giid, member: methodTok.value, value: index, anchor: methodTok, bufferSurface: bufferSurface)

		// ⭐⭐ **THE THROWING `set` IS VOID AND ITS TAG MUST SAY SO — the guard the void mutators call cannot
		// reach here, and the check that CAN reads only this tag.** A `try` target is parsed with
		// `resultUsed: false` by design (`parseTryCallTarget`), so the arm's `requireVoidMethodIsStatement` is
		// blind to `let x = try arr.set(…) otherwise …` — the spelling the corpus actually writes, since a
		// throwing call wants a `try`. There `parseTry`'s `voidInValue` decides, and it reads NOTHING but
		// `tagOf(result)`. Tagged `integer`, that check was told there is a value, and the
		// program COMPILED, LINKED AND RAN (exit 0) with `x` bound to the ok-return's literal `0`
		// (`emitElementStoreAndOkReturn`) — while the runnable oracle refuses it, `E3059 type mismatch:
		// ''stdlib.Array.set' does not return a value'`. The arm is the THIRTEENTH
		// void one, and the only one whose refusal is DERIVED from the tag rather than written in the arm.
		// ⚠ The Std entry still ok-returns `(0, flag)` — a throwing `void` runtime function is normal
		// (`__managed_set_length`, `__managed_set_byte` and `__managed_mem_grow` are all declared `StdReturnType.void`
		// and all throw); what this tag decides is whether MAXON believes the call yields something.
		return self.emitRuntimeCall(callee, args: threeArgs(arr, second: index, third: value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'parseArraySet'

	// `( expr )` — a single element-VALUE argument (`push(x)`), TYPE-CHECKED against the instance's element
	// type and then MOVED into the array: a managed element is consumed so the array owns it
	// (its decref walk destroys it), a trivial element passes through. The value's start position is captured
	// so a bare-local source can be poisoned (E3102).
	function parseContainerElementArg(func IrFunction, giid GenericInstanceId, methodTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let valueStart = self.pos
		self.stateContainerElementLiteralTargets(giid, valueStart: valueStart)
		let value = try self.parseExpression(func, block: self.bodyState.currentBlock)

		// The move-in MUST run before the `)` is consumed: `rhsWasBareLocalReference` reads `[valueStart, self.pos)`
		// to decide whether the arg is a bare local to POISON, and a consumed `)` would widen that window past a
		// single-identifier arg (`push(node)`) — the store would silently take NO reference and the container
		// would hold a slot it does not own, released a second time when the binding drops at scope exit (a
		// double-free / over-release, exit 101). The op that goes missing under the 2026-08-12 ruling is an
		// `__mm_incref` rather than a move poison; the ordering requirement is the same either way.
		let checked = try self.storedContainerElement(giid, value: value, valueStart: valueStart, methodTok: methodTok)
		let moved = try self.moveElementIntoContainer(checked, giid: giid, valueStart: valueStart, destination: self.statement.elementStoreDestination)
		try self.consume(TokenKind.rightParen)
		return moved
	end 'parseContainerElementArg'

	// ⭐ **STORE A PARSED ELEMENT INTO A MANAGED-ELEMENT ARRAY.** The array holds exactly ONE
	// reference per slot (its `__managed_decref` walk releases it), so the source is handled exactly as a
	// struct-field / union-payload store is (`moveManagedValueInto`): a borrowed String literal is promoted to
	// an owned copy, an owned value a LIVE BINDING keeps is CO-OWNED (the binding stays readable and releases
	// its own reference at scope exit — the 2026-08-12 ruling), an owned TEMPORARY is ADOPTED (de-listed from
	// the pending drops), and a borrowed struct/union is CO-OWNED too (no clone exists, so the container takes
	// a second reference to the same record rather than refusing — the transitive-consume ruling of
	// 2026-08-04). A TRIVIAL-element array's value owns no heap and passes through unchanged. Shared by
	// push/set/insert. `valueStart` locates the value's first token — its bare-local source and the diagnostic
	// anchor both.
	function moveElementIntoContainer(value ValueId, giid GenericInstanceId, valueStart ElementIndex, destination ElementStoreDestination) returns ValueId throws SourceParseError
		try self.requireElementStoreRootStillLive(destination)
		let moved = try self.moveElementIn(value, giid: giid, valueStart: valueStart)
		self.noteClosureStoreSite(ClosureStoreDestination.element, value: moved, at: self.tokenAt(valueStart))
		return moved
	end 'moveElementIntoContainer'

	function moveElementIn(value ValueId, giid GenericInstanceId, valueStart ElementIndex) returns ValueId throws SourceParseError
		// ⭐ **AN OPAQUE-`T` ARRAY MOVE-IN IN THE SHARED BODY.** The shared generic body has
		// no static type for the element (`containerElementIsManaged` is false — the element is a `typeParameter`
		// word), so it can neither promote a borrow nor decide the element's managed-ness here. The array becomes
		// the element's OWNER whatever the instantiation — `__managed_decref` destroys each slot exactly once through
		// the descriptor's `destroyFunc@40` — so the value moved in must be one this frame OWNS, and
		// `moveOpaqueFeedArg` transfers it (poisoning a bare-local source, draining an owned temporary).
		// The CONCRETE call site's own consume is untouched — it runs in the caller's frame on the
		// concrete argument.
		if self.signatures.containerElementIsOpaque(giid) 'opaque'
			// ⭐⭐ **A BORROWED ELEMENT TAKES A REFERENCE, BECAUSE IT HAS NONE TO GIVE UP.** The container
			// releases exactly one per slot, so the store must hand it one it owns — and where this frame owns
			// nothing there is only one way to supply that: `retainFunc@64`, through the enclosing instance's
			// descriptor. See `referenceBorrowedOpaqueElement`.
			if not self.valueIsOwnedHeap(value) 'borrowed'
				return try self.referenceBorrowedOpaqueElement(value, valueStart: valueStart)
			end 'borrowed'

			// ⭐⭐ **INSIDE A LOOP THE FRAME TAKES A NEW REFERENCE INSTEAD OF GIVING UP ITS OWN.** A move
			// is the right and cheaper discharge only while this frame will not read the value again, and
			// across a back edge it provably will: the next iteration stores the same value into the next
			// slot. A `movedFrom` bit is set once, at the store's TEXT, and cannot say "moved on iteration 3,
			// live on iteration 4" — which is why the move door refuses this outright
			// (`poisonOwningBinding`). Taking a reference needs no such distinction: N iterations take N
			// references, the binding is never poisoned, and its own one is released at scope exit exactly as
			// it would have been had the loop not been written.
			//
			// ⚠ **AND THE ZERO-ITERATION CASE IS WHY A MOVE IS WRONG HERE AND NOT MERELY LESS EFFICIENT.** A move
			// decides at parse time that the store happened; a loop whose body never runs then leaks the
			// reference its consuming caller handed over, with the binding marked moved and nothing left to
			// release it. `a-loop-that-never-runs-still-releases-the-value` is that program.
			//
			// ⚠ **THIS ARM IS ABOUT AN OWNED VALUE ONLY, AND THAT IS THE WHOLE OF WHAT REACHES IT.** A
			// BORROW is served one branch up, by the same `coOwnBorrowedOpaque`; the two arms differ in what
			// happens to the SOURCE, not in what the container gets. An owned source keeps its own reference and
			// releases it at scope exit, and a borrowed one never had one.
			if self.moveOfValueEscapesLoop(value) 'referenceRatherThanMove'
				return self.coOwnBorrowedOpaque(value, range: SourceRange.ofToken(self.tokenAt(valueStart)))
			end 'referenceRatherThanMove'

			self.moveOpaqueFeedArg(value, valueStart: valueStart)
			return value
		end 'opaque'

		if not self.signatures.containerElementIsManaged(giid) 'trivial'
			return self.containerElementWord(value, giid: giid, range: SourceRange.ofToken(self.tokenAt(valueStart)))
		end 'trivial'

		let anchor = self.tokenAt(valueStart)

		// ⚠ `tagIsByteRecord`, NOT `tagIsText`: this flag selects the fused-record COPY protocol (promote a
		// borrowed record into a fresh owned one) against the aggregate protocol (refuse — a struct has no
		// clone), which is a question about the element's REPRESENTATION. A `Character` element answered
		// `false` here and `a.push('é')` was refused as *"moving a borrowed struct/union value into durable
		// storage … a struct/union has no `clone`"* — on a value that has exactly the clone that message
		// says it lacks, while the identical literal into a struct FIELD was accepted (that door asks
		// `classifyUnionPayload`, which already answers `isString: true` for a Character).
		let isString = tagIsByteRecord(maxonTypeTag(self.signatures.containerElementType(giid)))

		if self.signatures.containerElementIsFrozen(giid) and not isString and not self.valueIsOwnedHeap(value) and self.tagOf(value) != ValueTypeTag.interfaceRef 'sharesTheReadOnlyRecord'
			return try self.shareReadOnlyRecordInto(value, range: SourceRange.ofToken(anchor))
		end 'sharesTheReadOnlyRecord'

		self.noteLentUniqueMoved(value)

		return try self.moveManagedValueInto(value, argBareLocal: self.rhsWasBareLocalReference(valueStart), isString: isString, range: SourceRange.ofToken(anchor))
	end 'moveElementIn'

	function shareReadOnlyRecordInto(value ValueId, range SourceRange) returns ValueId throws SourceParseError
		if self.valueIsDeferred(value) 'aDeferredCallResult'
			return value
		end 'aDeferredCallResult'

		try self.requireNotMovedSinceItWasRead(value, range: range)
		self.emitIncref(value, range: range)
		return value
	end 'shareReadOnlyRecordInto'

	// ⭐⭐ **THE MACHINE WORD A TRIVIAL ELEMENT IS STORED AS — the FLOAT boundary, and the only element type
	// where the value and its slot live in different register files.**
	//
	// Every `__managed_*` mutator takes its element as an ordinary integer parameter, so it arrives in a
	// general-purpose register; a float value is born in XMM. Handed over unconverted it reached
	// `X64Backend.emitRegRegMove` and PANICKED — *"a register-to-register move from xmm0 to rdx crosses
	// register files"* (measured on `Array with Real` + `push(2.5)`, which is exactly the crash
	// `generic-types.md:error.float-type-arg` describes from the other side). A REINTERPRETATION is the
	// correct conversion and not a widening: the slot holds the f64's 64 bits, so `bitcastF64ToI64` in and
	// `bitcastI64ToF64` out (`containerSlotValueType`'s float arm) round-trip every value including NaNs and
	// the two zeros, where a numeric convert would not.
	//
	// ⚠ **ASKED OF THE INSTANCE'S ELEMENT, NOT OF THE VALUE'S TAG.** A `Byte` element assigned an int literal
	// carries an `integer` tag and must pass straight through; a float element handed an int literal has
	// already been promoted by `requireContainerElementType`, so the tag agreeing with the element is the
	// precondition rather than the test. Reading the element is what makes this one question with one answer
	// per instance.
	//
	// ⚠⚠ **THE TEST IS `containerElementIsFloatWord` BELOW, AND BOTH SIDES ASK IT — see that predicate for the
	// measured wrong answer a bare `tagIsFloat` on the raw element type gives.**
	function containerElementWord(value ValueId, giid GenericInstanceId, range SourceRange) returns ValueId
		if not self.containerElementIsFloatWord(giid) 'wordAlready'
			return value
		end 'wordAlready'

		return self.emitUnaryOp(value, op: MaxonUnaryOp.floatToBits, resultTag: ValueTypeTag.integer, range: range)
	end 'containerElementWord'

	// ⭐⭐ **DOES CONTAINER `giid`'s ELEMENT TRAVEL AS ITS 64 BITS — the ONE home of the float-element question,
	// and it has to be one home because its two askers are the two ENDS of a round trip.**
	// `containerElementWord` writes the bits in; `emitContainerElementAccessor` reads them back out. Spelled
	// separately, the two are free to disagree about what counts as a float element, and a disagreement is not
	// a diagnostic — it is a value that goes in through one door and comes out of another.
	//
	// ⚠ **IT RESOLVES THROUGH `containerSlotValueType`, NOT OFF THE RAW ELEMENT TYPE, AND THAT IS THE MEASURED
	// PART.** The stored element of a RANGED FLOAT ALIAS is `named("Float")`, which answers FALSE to a bare
	// `tagIsFloat`. With the raw type on the write side only, `FixedArray with 2 Float` over
	// `typealias Float = float(f64.min to f64.max)` stored its element unconverted and panicked the x64
	// emitter — *"a register-to-register move from xmm0 to rax crosses register files"* — while the
	// bare-float `FixedArray from [1.5, 2.5]`, whose element IS `float`, was already correct. Exactly the
	// asymmetry one shared door makes unrepresentable.
	function containerElementIsFloatWord(giid GenericInstanceId) returns bool
		return tagIsFloat(maxonTypeTag(self.containerSlotValueType(self.signatures.containerElementType(giid))))
	end 'containerElementIsFloatWord'

	// ⭐⭐ **THE REFERENCE A BORROWED OPAQUE-`T` ELEMENT OWES THE CONTAINER IT IS STORED INTO** — the
	// container twin of `moveOpaqueValueInto`'s borrowed arm, and the two discharge one obligation for the two
	// durable slot kinds. The container destroys each element exactly once through the enclosing instance's
	// `destroyFunc@40`, so a store must hand it a reference IT owns; a borrow has none to give up, so one is
	// TAKEN through the same descriptor's `retainFunc@64`. The two words are stamped from ONE
	// `typeParamOwnershipProtocol` answer and are therefore non-zero together, which is what makes that pairing
	// a fact rather than a hope — `managedOpaqueArrayElementOf` records what their disagreeing cost, twice.
	//
	// ⇒ This door serves the ONE shape whose reference no other frame can take, because the borrow is
	// produced INSIDE this body: `items.push(try other.get(i) otherwise …)`, an opaque field read, a
	// `for` element. The rule every frame keeps — *whoever hands a value to an opaque sink hands over
	// a reference IT owns; if it does not own one, it takes one first* — and this is the half where
	// the taking happens.
	//
	// The `__retain_type_param` this emits makes the enclosing method a layout carrier in lowering's carrier
	// scan.
	//
	// ⚠ **A VALUE WHOSE TAG IS NOT THE OPAQUE PARAMETER IS STILL REFUSED, AND THAT IS A TYPE ANSWER RATHER
	// THAN AN OWNERSHIP ONE.** `items.push("literal")` in a shared body has no caller frame to check the
	// element against — `requireContainerElementType` declines for an opaque element precisely because the
	// instantiation's argument is checked where it is CONCRETE — so accepting it would let a `Bag with Int`
	// store a String record through a zero retain word: a silent wrong answer where today there is a position.
	// The OWNED concrete case is accepted by the move arm above and carries that same hole; it is pre-existing
	// there and deliberately not widened here.
	function referenceBorrowedOpaqueElement(value ValueId, valueStart ElementIndex) returns ValueId throws SourceParseError
		let anchor = self.tokenAt(valueStart)

		if self.tagOf(value) != ValueTypeTag.typeParameter 'notTheElementsOwnParameter'
			throw SourceParseError.unsupported("storing a borrowed value of a CONCRETE type into an `Array with <type parameter>` in a shared generic body — the body compiles once for every instantiation, so nothing here can check the value against the element type the caller chose, and the reference the container needs would be taken through a descriptor written for a different type. Store a value of the element's own type parameter (a `get`/`first`/`last` read, an opaque field read, a `for` element, or a parameter the method consumes), or write the store in a method of a concrete instantiation", line: anchor.line, column: anchor.column)
		end 'notTheElementsOwnParameter'

		// A generic no instance of which exists has no `T` to reference — `opaqueSlotTakesItsOwnReference` asks the
		// identical question and says how it meets the reservation.
		if not self.signatures.typeParamOwnerIsInstantiated(self.valueTypeParamId(value)) 'noInstantiationToReference'
			return value
		end 'noInstantiationToReference'

		// ⚠ **A `constructorFeedParams` PARAMETER IS *NOT* EXEMPTED HERE, WHERE `moveOpaqueValueInto`
		// EXEMPTS IT — and the difference is which SLOT the concrete call site paid for.** There the
		// store IS the `Self{…}` that call site consumed its argument for, so a second reference would
		// leak the caller's. A container is a DIFFERENT durable slot with an element walk of its own, so
		// it owes its own reference; passing the value straight through would give that walk one nobody
		// ever took.
		return self.coOwnBorrowedOpaque(value, range: SourceRange.ofToken(anchor))
	end 'referenceBorrowedOpaqueElement'

	// ⭐ **MOVE AN OPAQUE OWNED FEED VALUE INTO ITS NEW OWNER.** The fed value (an
	// `items.push(item)` element, or a `self.N(item)` forward argument) is transferred so its new owner (the
	// array, or the consuming sibling) is its SOLE owner and this frame does not drop it too. Both transfer
	// forms run, and each is a no-op on the other's case — exactly as `transferConsumedArg`'s opaque arm pairs
	// them, which is the same transfer one call further out:
	//   • a bare reference to a LIVE owned binding is POISONED (a second use → E3102). `poisonMoveSource` is
	//     value-keyed and matches only a live owned binding, and the bare-local gate keeps it off the hot path
	//     (the same gate `moveManagedValueInto` uses).
	//   • an owned TEMPORARY is drained from the statement's pending drops. ⚠ Without this,
	//     `self.items.push(self.items.pop())` — the one shape that produces an owned opaque temporary — would free
	//     the moved-out element at statement end AND again through the array's own element walk, a double free
	//     on a live record with no diagnostic anywhere (measured: `0xC0000005`).
	function moveOpaqueFeedArg(value ValueId, valueStart ElementIndex)
		if self.rhsWasBareLocalReference(valueStart) 'bareLocal'
			self.moveOwnedValueOut(value)
			return
		end 'bareLocal'

		self.removeFromPendingTemps(value)
	end 'moveOpaqueFeedArg'

	// ⭐⭐ **A VOID CONTAINER METHOD HAS NO VALUE, so a value-position call is refused exactly as a void
	// free call is (`voidCallResultUsed`) — AND EVERY CALLER IS INSIDE THE ARM ITS OWN NAME MATCHED,
	// WHICH IS THE WHOLE OF THIS FUNCTION'S SCOPING.** It tests `resultUsed` and nothing about the name,
	// so it can only ever be as name-scoped as its call sites are.
	//
	// ⚠ **SCOPING IT POSITIONALLY — one call between the value-yielding arms and the void ones — is a
	// scope an UNKNOWN name shares.** A name matching no arm falls past every one of them, so
	// `let x = arr.frobnicate()` reaches the check and is told *"Function 'frobnicate' does not return a
	// value"*: a sentence asserting that the method EXISTS and is VOID, about a name the type has never
	// heard of, where the identical call in statement position correctly reports the roster refusal.
	// Naming the guarded methods in a comment here is a guarantee only the call sites can make.
	// `specs/void-call-result.md`'s four red cases and three controls are that pair of
	// properties: an unknown name reaches the ROSTER, and a real void mutator still reaches this.
	//
	// ⇒ **A NEW VOID ARM MUST CALL THIS AS ITS FIRST STATEMENT**, before it consumes an argument list, so
	// the refusal beats every argument diagnostic.
	function requireVoidMethodIsStatement(resultUsed bool, methodTok Token) throws SourceParseError
		if resultUsed 'valueUsed'
			throw SourceParseError.voidCallResultUsed(String.from(methodTok.value), line: methodTok.line, column: methodTok.column)
		end 'valueUsed'
	end 'requireVoidMethodIsStatement'

	// The SCOPE name a base token denotes. `self` is a keyword, so it carries no binding name of its
	// own; it names the receiver parameter, which is bound under `SelfParamName`. Every other base
	// token names itself.
	//
	// One home, because `p.x`, `p.m()` and their `self` spellings all have to answer it the same
	// way — and because it is the ONLY place the `self` token and the receiver parameter's name are
	// connected. A second copy is a second chance to look the receiver up under the word the source
	// happened to write.
	function baseBindingName(tok Token) returns immutable ByteArray
		return SelfParamName if tok.kind == TokenKind.self else tok.value
	end 'baseBindingName'

	// ⭐⭐ **WHICH BINDING DOES THE DOTTED BASE AT `index` DENOTE — one of this frame, a closure CAPTURE, or
	// none?** The one answer to the "a value outranks a type name" question, and therefore the one place the
	// shadowing rule is written; a clause added to a hand-spelled copy alone re-points a name at a different
	// declaration and earns no compile error anywhere. A base `resolveChain` entered as a type
	// (`qualifiedTypeBaseIsAt`) is always a type.
	//
	// ⚠ **`Self` IS EXCLUDED, AND THAT EXCLUSION *IS* THE RULE THAT `Self` NAMES A TYPE AND NEVER A
	// VALUE.** It is not a shortcut for a lookup that would have missed: a declaration CAN bind the
	// name — `function twin(Self Num)` is admitted, because a parameter's name may be spelled with a
	// keyword (`consumeNameToken`) — and the scope test would then find it and hand `Self.make(v)`
	// to `parseMethodCall` on that parameter. Without the exclusion, `Self.make(41)` inside `twin(Self
	// Num)` reports *"'int' has no method named 'make'"*, `Self.on` inside an `enum` reports *"a field
	// access on 'Self', which is declared 'int' and not a struct type"*, and `Self{n: 42}` in the SAME
	// body still means the type, because `parsePrimary`'s `selfType` arm claims `{` ahead of any scope
	// test. With it, `Self` names the TYPE and the parameter stays unreadable — `E3012 unused
	// variable: 'Self'` when nothing reads it, `E3003 'Gate' is a type and cannot be used directly as
	// a value` when something does.
	//
	// ⭐ Excluded HERE rather than refused at the declaration, and that placement is the argument: the
	// oracle ADMITS `function twin(Self Num)`, and `enum Kw { Self }` is a legal, useful case name both
	// compilers run (`Kw.Self`). Reserving the word at `requireUnreservedName` would refuse both. What
	// is wrong is not the declaration — it is a base position consulting the VALUE namespace about a
	// token that cannot be in it.
	function valueBaseAt(index ElementIndex) returns ValueBaseBinding
		let tok = self.tokenAt(index)

		if self.qualifiedTypeBaseIsAt(index) or tokenIsTheSelfType(tok) 'alwaysAType'
			return TypeValueBase
		end 'alwaysAType'

		let name = self.baseBindingName(tok)

		if self.bodyState.scope.contains(name) 'thisFrame'
			return ThisFrameValueBase
		end 'thisFrame'

		match self.captureScopeOf(name) 'captured'
			found(_, frame) then return ValueBaseBinding.captured(frame)
			notCaptured then return UnboundValueBase
		end 'captured'
	end 'valueBaseAt'

	function thisFrameBindingOf(baseTok Token) returns VarInfo
		return self.bodyState.scope.getInfo(self.baseBindingName(baseTok))
	end 'thisFrameBindingOf'

	function capturedBindingOf(baseTok Token, frame ElementIndex) returns VarInfo
		return self.capturedFrame(frame).scope.getInfo(self.baseBindingName(baseTok))
	end 'capturedBindingOf'

	// The one tie-break between a type and a top-level binding that share a head: the type wins where it
	// serves the member, the binding everywhere else. Every storage-kind door asks it, through
	// `managedTopLevelBaseAt` or `baseNamesModuleLevelAt`.
	function moduleLevelBindingHeadsAt(index ElementIndex) returns bool
		return match classifiedChainHead(self.signatures, head: self.tokenAt(index).value, readerFilePath: self.job.path, headIsAValue: false) 'claim'
			value gives true
			nominalTypeBesideBinding or
			otherTypeBesideBinding gives not self.typeReadingClaimsMemberAt(index)
			nominalType or
			otherType or
			unclaimed gives false
		end 'claim'
	end 'moduleLevelBindingHeadsAt'

	function typeReadingClaimsMemberAt(index ElementIndex) returns bool
		if self.kindAt(index + 1) != TokenKind.dot 'noMemberForTheTypeToClaim'
			return false
		end 'noMemberForTheTypeToClaim'

		return self.namesStaticMemberAt(self.tokenAt(index), memberIndex: index + TokensPerQualifierSegment) or self.staticCallClaimsBase(index)
	end 'typeReadingClaimsMemberAt'

	function baseNamesModuleLevelAt(index ElementIndex) returns bool
		return self.valueBaseAt(index).isUnbound() and self.moduleLevelBindingHeadsAt(index)
	end 'baseNamesModuleLevelAt'

	function baseNamesAValueAt(index ElementIndex) returns bool
		return self.valueBaseAt(index).isFrameValue()
	end 'baseNamesAValueAt'

	// ⭐ **DOES THE BASE AT `index` NAME A VALUE A FIELD CHAIN CAN START FROM?** `baseNamesAValueAt`
	// plus the one base that is neither a local nor a capture: a TOP-LEVEL MANAGED BINDING (spec-port
	// `map-struct-bytearray`) — `db.sourceFiles.contains(key)`, where `var db = Database.create(…)` is a
	// struct global. Without it the chain falls past every arm to the SIZED-BOUND reading and is refused as
	// `Expected ''min' or 'max'' but got 'sourceFiles'`.
	//
	// ⚠ **THE GLOBAL IS ASKED LAST, AND EVERY TYPE-BASED READING OF THE SHAPE IS ASKED BEFORE IT** — the
	// precedence `moduleLevelBindingHeadsAt` fixes: a name that is both a declared type and a global keeps
	// its type reading wherever the type serves the member. That is why the expression door's arm sits BELOW
	// the enum, namespace-call and static-call arms rather than beside the local one. A LOCAL, by contrast,
	// outranks a type name (the rule `valueBaseAt` carries), and the two orders differ for a reason: a local
	// is a declaration the reader can see on the page, while a global's spelling can collide with a type's
	// from another file.
	//
	// It costs one hash of bytes already in hand when the scope test declines — `managedTopLevelBaseAt`'s
	// measured filter — and allocates nothing.
	function chainBaseNamesAValue(index ElementIndex) returns bool
		return self.baseNamesAValueAt(index) or self.managedTopLevelBaseAt(index)
	end 'chainBaseNamesAValue'

	// ⭐⭐ **DOES THE IDENTIFIER AT `index` NAME ANYTHING AT ALL — the question that separates a
	// MISSPELLED statement from an ill-formed one.** A dotted statement whose base names nothing is a defect
	// in the NAME (`arr.reserve(8)` where `arr`'s declaration lives inside a branch the merge left behind),
	// and the author is owed the same `Undefined variable` an expression-position read of that name gets. A
	// base that DOES name something is refused for what the statement does with it, not for what it spells.
	//
	// ⚠ It resolves nothing of its own: every disjunct is a probe some door already owns, so what is
	// written here is only the LIST of namespaces a base may live in — a value or capture
	// (`chainBaseNamesAValue`), a top-level constant or slot (`namesTopLevelBinding`), a type declaration of
	// any form (`Point.create()`, `Box.seen`), a function used as a base (`inc.field`), and the ten sized
	// spellings the bound grammar owns (`u64.max`), which no file declares. A namespace a door adds later
	// belongs in this list, and leaving it out costs a wrong noun rather than a wrong program.
	function baseNamesNothingAt(index ElementIndex) returns bool
		let tok = self.tokenAt(index)

		if tok.kind != TokenKind.identifier or self.qualifiedTypeBaseIsAt(index) 'notAPlainName'
			return false
		end 'notAPlainName'

		if self.chainBaseNamesAValue(index) or self.namesTopLevelBinding(tok.value) 'namesAValue'
			return false
		end 'namesAValue'

		return not (self.signatures.nameIsDeclared(tok.value) or self.signatures.declaresCallee(tok.value) or isSizedTypeName(tok.value))
	end 'baseNamesNothingAt'

	// `p.x` — read field `x` out of the box `p` points at.
	//
	// ⭐ **IT RIDES `loadIndirect`, THE OP A GLOBAL'S READ ALREADY USES** (`emitGlobalLoad`), with a
	// real offset where that one passes `GlobalSlotOffset`. There is no `fieldLoad` op: the Std memory
	// band is the GENERAL pair, and the offset field is not dead weight — it is what
	// `point.x` carries, through this same op.
	//
	// The type comes off the BINDING, not off the value column's tag alone: `VarInfo.varType` is a
	// `structRef` carrying the struct's interned name id, and that name is what the layout registry
	// is keyed by. So `p.x` resolves through the same two steps a human does — which type is `p`,
	// and which slot does that type call `x`.
	function parseFieldAccess(func IrFunction) returns ValueId throws SourceParseError
		if self.chainBaseIsDeferred() 'deferredBase'
			return try self.deferredMemberResultPastTheBase(func)
		end 'deferredBase'

		let walk = self.markLateReads()
		let step = try self.resolveFieldChain()
		let site = self.lastConsumedSite()
		let index = try self.requireFieldIndex(step.layout, name: step.lastFieldTok.value, anchor: step.lastFieldTok)
		try self.requireFieldAccessible(step.layout, index: index, fieldTok: step.lastFieldTok)

		let range = SourceRange.between(step.baseTok, last: step.lastFieldTok)

		if self.cellWasRequestedAt(site) 'aRequestedFieldPath'
			self.statement.argumentRoot = step.cell
		end 'aRequestedFieldPath'

		if self.cellWasRequestedAt(site) and self.mayHandOverFieldAt(site, box: step.box, layout: step.layout, index: index, writableHere: true) 'handOverTheSlot'
			if self.valueIsCopyableTuple(step.box) 'aTupleIsRebound'
				self.markMutabilityExercised(step.baseBinding)
			end 'aTupleIsRebound'

			return self.handOverFieldStorage(step.box, layout: step.layout, index: index, range: range)
		end 'handOverTheSlot'

		let receiver = self.emitFieldLoad(step.box, layout: step.layout, index: index, range: range)

		if self.memberCallFollows(self.pos) 'aReceiverOfACall'
			self.deferReadsSince(walk)
		end 'aReceiverOfACall'

		return receiver
	end 'parseFieldAccess'

	// ⭐ **RESOLVE A FIELD-ACCESS CHAIN `base.f1.f2.…fN` to its FINAL box + layout + last field token** —
	// the shared spine of a chained READ (`o.inner.x`) and a chained WRITE (`o.inner.x = 42`). It resolves
	// the base binding to its box and layout (`requireStructBase`, which also enforces the live-binding
	// guard), then for every INTERMEDIATE field (all but the last) LOADS that field — which must be a struct
	// — as the next box and threads its layout onward. A borrowed load: the loaded struct box is a borrow of
	// the owning struct's field, valid while the base binding lives, so no ownership is taken and nothing is
	// dropped. The cursor is left on the token AFTER the last field name (the `=` of a write, or wherever the
	// read's expression continues).
	// ⭐ **`t.0` NAMES THE FIELD `_0` — THE ONE REWRITE FROM A POSITIONAL MEMBER TOKEN TO A FIELD-NAME TOKEN.**
	// A tuple's fields ARE ordinary struct fields, called `_0`, `_1`, … (`tupleFieldName`), so
	// nothing downstream learns about tuples: the rewritten token flows into `requireFieldIndex` /
	// `requireFieldAccessible` / `emitFieldLoad` exactly as `p.x`'s own token does, and `t._0` — which
	// `specs/tuples.md` spells in five cases — resolves through the identical `indexOfField`.
	//
	// The synthesized token keeps the ORIGINAL's line and column, so a diagnostic still points at what the
	// author wrote; it carries no source SPAN, because its text is not in the source buffer (`t.0` holds no
	// `_0`) and a span is a slice of that buffer. It is `identifier`-kinded for the same reason: the token is
	// a NAME now, and no later reader may re-decide it was a number.
	function consumeMemberNameToken() returns Token throws SourceParseError
		let member = try self.memberNameTokenAt(self.pos)
		self.advance()
		return member
	end 'consumeMemberNameToken'

	// The member-name token at `index` WITHOUT moving the cursor — `consumeMemberNameToken` minus the
	// advance, and the reason the rewrite above is not written inline there. `dispatchMethodOnBase` has to
	// READ the member to decide whether it is a field or a method and may not consume it: the method path
	// hands the cursor to `parseCallNamed`, which consumes the name itself. Peeking with the rewrite absent
	// would make a tuple's positional member (`makePair().0`) invisible to the field lookup on the one door
	// that cannot reach it through the chain walk.
	function memberNameTokenAt(index ElementIndex) returns Token throws SourceParseError
		let tok = self.tokenAt(index)

		// A KEYWORD after a `.` is a member NAME — `Box.from(7)`, `p.to()`. A `.` is followed by a member
		// name and by nothing else in this grammar, which is the same lookbehind `keywordIsAName` already draws
		// for the block-extent scans; so the reader admits exactly what those scans already exclude.
		if tokenCanBeAName(tok) 'namedMember'
			return tok
		end 'namedMember'

		if tok.kind != TokenKind.intLiteral 'notAMemberName'
			throw SourceParseError.unexpectedToken(TokenKind.identifier.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notAMemberName'

		return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: tupleFieldName(tok.value))
	end 'memberNameTokenAt'

	// **The token kinds that may NAME a member after a `.`** — anything `tokenCanBeAName` admits (an identifier,
	// or a KEYWORD, which after a `.` is a name), or the int literal of a tuple's positional access.
	// Spelled once, so the shapes built on it — the chain HOP (`fieldChainEndAfter`, which every field-store
	// and chained-call dispatcher walks through), the by-reference argument's anchor walk
	// (`cellArgumentAnchorAt`) and the call TAIL (`memberCallFollows`, which every `<base> . <member> (`
	// dispatcher asks) — and the consumer above cannot come to disagree about where a chain's hop ends. They
	// already MUST agree: `fieldChainEndAfter`'s header states that a divergence between its askers is a
	// use-after-free rather than a compile error.
	function namesMemberAt(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.intLiteral or tokenCanBeAName(self.tokenAt(index))
	end 'namesMemberAt'

	// ⭐⭐ **THE TOKEN SHAPE THAT ROUTES A PRIMITIVE-TYPE KEYWORD INTO A DOTTED EXPRESSION** —
	// `<int|float|bool> . <member>`. Expression position (`parsePrimary`) claims the read, so `int.fromString`
	// written without its call meets the refusals `parseDottedPrimary` gives every other base; a `try` target
	// (`parseTryCallReceiver`) asks `primitiveStaticCallAt`, the same shape with its `(`.
	//
	// `byte` is deliberately NOT here: it is a plain identifier, so `byte.fromString(…)` is already
	// routed by the identifier arms and joins the primitive reading further down, at
	// `parseQualifiedCall`. See `namesAPrimitiveType` for why one door is not enough.
	function primitiveStaticReadAt(index ElementIndex) returns bool
		return keywordNamesAPrimitiveType(self.tokenAt(index)) and self.kindAt(index + 1) == TokenKind.dot and self.namesMemberAt(index + 2)
	end 'primitiveStaticReadAt'

	function primitiveStaticCallAt(index ElementIndex) returns bool
		return self.primitiveStaticReadAt(index) and self.kindAt(index + 3) == TokenKind.leftParen
	end 'primitiveStaticCallAt'

	// **Is the `.member` at `index` a CALL — `. <member> (`?** The one question that tells a field-chain HOP
	// from the chain's END: a member followed by `(` is a method (or a call through a function-typed field),
	// which is not a field the walk may consume, and the value it is called ON is the chain's result.
	//
	// ⚠ **IT IS THE WALK'S STOP CONDITION, NOT THE STATEMENT DISPATCHER'S — and those are two derivations,
	// which is worth saying because it reads like one.** `resolveFieldChainFrom` asks THIS, hop by hop, of
	// the cursor it is standing on; `fieldChainMethodCallAt` asks `fieldChainEndAfter` for the index just
	// past the WHOLE chain and then tests `(` there. They agree today, and the agreement is structural
	// rather than shared: `fieldChainEndAfter`'s loop consumes a `.member` only while the NEXT tokens are
	// again `. <member>`, so the hop it stops before is exactly the one this predicate stops before. Both
	// spell the member half through `namesMemberAt`, which is the piece that genuinely has one home — teach
	// a new member-naming token to that and both walks learn it at once, which is the divergence
	// `fieldChainEndAfter`'s own header is about.
	//
	// ⭐⭐ **AND IT IS ALSO THE ONE SPELLING OF THE THREE-TOKEN TAIL `. <member> (` THAT EVERY
	// `<base> . <member> (` DISPATCH PREDICATE ASKS.** `isSelfMethodCallAt`, `methodCallsAt`,
	// `qualifiedStaticCallsAt`
	// and `primitiveStaticCallAt` each claim a four-token shape whose last three tokens are exactly this
	// question. Writing `kindAt(i+1) == dot and namesMemberAt(i+2) and kindAt(i+3) == leftParen` out by hand
	// at each makes the tail five copies of one syntactic fact with nothing making them agree. That is the
	// shape this project keeps paying for: teach the language a new call tail (a generic method call
	// `.m<T>(…)`, say) and a copy left behind does not fail to compile — it silently stops claiming a shape,
	// and the token walk and the statement dispatcher part company. The distinction the paragraph above
	// draws is between two DERIVATIONS of where a chain ends, never about the tail's spelling, which is one
	// fact with one home. What each predicate still owns is its BASE half — a keyword `self`, a bound
	// name, a plain identifier, a primitive-type keyword — which is where they genuinely differ.
	function memberCallFollows(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.dot and self.namesMemberAt(index + 1) and self.kindAt(index + 2) == TokenKind.leftParen
	end 'memberCallFollows'

	// Consume a field-chain base token — the receiver `self` (a keyword) or a local identifier. `self` names the
	// receiver parameter (resolved by `baseBindingName` to `SelfParamName`); every other base names itself.
	function consumeChainBaseToken() returns Token throws SourceParseError
		if self.at(TokenKind.self) 'selfBase'
			let tok = self.current()
			self.advance()
			return tok
		end 'selfBase'

		// A KEYWORD-named binding may be the base — `type.n` where `type` is a struct-typed parameter.
		// It resolves through the same `scope.contains` test an identifier base does; a keyword that names
		// nothing reaches the same `undefinedVariable` below.
		return try self.consumeNameToken(NamePosition.declaration)
	end 'consumeChainBaseToken'

	function resolveFieldChain() returns FieldChainStep throws SourceParseError
		// The base's INDEX, taken before the token is consumed: the top-level arm below is keyed on it, because
		// deciding whether a global claims this base needs the MEMBER name too (`managedTopLevelBaseAt`).
		let baseIndex = self.pos

		// The base is a local identifier (`b.ops.push`) OR the receiver `self` (`self.nodes.push`):
		// `self` is a keyword, not an identifier, and it names the receiver parameter bound under `SelfParamName`,
		// which `baseBindingName` maps. A single-hop `self.field` read/write resolves elsewhere; this is the 2+-hop
		// chain and the chain-method-call spine, which `fieldChainMethodCallAt` already admits a `self` base to.
		let baseTok = try self.consumeChainBaseToken()

		// ⭐ **THE BASE IS `valueBaseAt`'S ANSWER, AND THE ARMS DO THE RESOLVING** — a local base wants its
		// `VarInfo`, a captured one its frame. Asking the one door is what keeps the "a value outranks a type
		// name" rule single-sourced across all three doors that read it: the statement door (`methodCallsAt`),
		// the expression door (`parseDottedPrimary`) and this one, which RESOLVES a chain rather than merely
		// recognizing the shape of one.
		//
		// ⚠ **`Self` IS THEREFORE EXCLUDED HERE TOO, SO THAT NO DOOR LETS A BINDING SHADOW IT.**
		// `Self.n = 5` inside `bad(Self Gate)` falls to the tail and reports what the `Gate.n = 5` spelling
		// reports on the same token, where resolving it to the PARAMETER would report *"cannot assign to
		// immutable variable: 'Self'"*. No wrong answer is reachable through it —
		// every binding a store could have succeeded against is refused elsewhere, since only a PARAMETER may be
		// named `Self` and a parameter is immutable — but a rule that holds at two doors of three is the shape this
		// project keeps paying for.
		match self.valueBaseAt(baseIndex) 'valueBase'
			thisFrame then return try self.resolveThisFrameFieldChain(baseTok)
			captured(frame) then return try self.resolveCapturedFieldChain(baseTok, enclosing: self.capturedFrame(frame).scope, frame: frame)
			unbound or
			alwaysAType then break
		end 'valueBase'

		// ⭐ **A STATIC MEMBER IS THE FOURTH BASE** — `Cache.head.n = 42`, where `Cache.head` is module
		// storage keyed by its declaring type. `consumeChainBaseToken` has taken the TYPE name; the `.` and the
		// member are consumed here, and what the chain walks from is the SYNTHETIC qualified token — so the rest
		// of this door, `requireStructBase` and the immutable-write rule included, sees exactly the global base
		// the arm below already serves.
		//
		// ⚠ **THE READ SIDE IS A DIFFERENT DOOR, SO THE WRITE SIDE NEEDS THIS ARM.**
		// `Cache.head.n` in expression position is `parseDottedPrimary`'s static arm plus `parsePostfix`;
		// `Cache.head.n = 42` reaches THIS door, where the base `Cache` is neither a value nor a global and would fall
		// to the tail as **`E2004: Undefined variable 'Cache'`** (measured) — a name that is defined, and the
		// "sends the reader hunting for a typo" noun `top-level-let-scalar-reassign-error` exists to argue
		// against.
		//
		// Asked with the type-based readings and BEFORE the managed-global arm, the precedence
		// `chainBaseNamesAValue` states: a name that is both a declared type and a global keeps its type reading.
		let typeTok = try self.staticBaseTokenAt(baseIndex)

		if self.namesStaticMemberAt(typeTok, memberIndex: self.pos + 1) 'staticMemberBase'
			try self.consume(TokenKind.dot)
			let nameTok = self.staticMemberNameToken(typeTok, memberTok: try self.consumeMemberNameToken())

			return try self.resolveManagedBindingFieldChain(nameTok)
		end 'staticMemberBase'

		// ⭐ **A TOP-LEVEL MANAGED GLOBAL IS THE THIRD BASE** (spec-port `map-struct-bytearray`) —
		// `db.sourceFiles.contains(key)`. The slot's occupant is LOADED and wrapped in the same synthetic
		// `VarInfo` a global METHOD receiver already wears (`dispatchOnManagedReceiver`), so the layout
		// resolution, the live-binding guard and the immutable-write rule are the ones every other base gets;
		// nothing about a chain over a global is decided a second time here.
		//
		// The loaded pointer is BORROWED — the slot owns it, and `__maxon_global_cleanup` releases it at exit
		// — which is exactly the property an intermediate field load already has, so the chain walk below
		// needs no ownership bookkeeping it did not already have.
		if self.managedTopLevelBaseAt(baseIndex) 'managedTopLevelBase'
			return try self.resolveManagedBindingFieldChain(baseTok)
		end 'managedTopLevelBase'

		throw SourceParseError.undefinedVariable(String.from(baseTok.value), line: baseTok.line, column: baseTok.column)
	end 'resolveFieldChain'

	function resolveManagedBindingFieldChain(tok Token) returns FieldChainStep throws SourceParseError
		let binding = self.managedReceiverBindingOf(tok)

		match binding 'binding'
			inlineWord or
			imageRecord or
			imageBox then break

			// A managed CONSTANT is a `String` or a `b"…"`, which has no field, so it takes the same
			// `undefinedVariable` an unknown base does rather than an arm that could only refuse. An
			// IMAGED record MAY have fields — see `ManagedReceiverBinding.imageRecord` — so it chains
			// through the value like every other base, and a member the record has not got is then the
			// chain's own diagnostic rather than a claim that the base does not exist.
			constant or
			none then throw SourceParseError.undefinedVariable(String.from(tok.value), line: tok.line, column: tok.column)
			poisoned then panic("resolveFieldChain: a poisoned base is answered by `chainBaseIsDeferred` before the chain is resolved, in both the read and the write door")
			global(label, valueType) then return try self.resolveGlobalFieldChain(tok, label: label, valueType: valueType)
		end 'binding'

		let (value, valueType) = self.materializeImageOrInlineBinding(binding.clone(), tok: tok)
		return try self.resolveValueFieldChain(tok, value: value, valueType: valueType)
	end 'resolveManagedBindingFieldChain'

	function resolveGlobalFieldChain(baseTok Token, label ByteArray, valueType MaxonType) returns FieldChainStep throws SourceParseError
		let loaded = self.emitGlobalReceiverLoad(label, valueType: valueType, tok: baseTok)
		return try self.resolveValueFieldChain(baseTok, value: loaded, valueType: valueType)
	end 'resolveGlobalFieldChain'

	// ⭐ **THE CHAIN ITSELF, FROM A BASE THIS FRAME ALREADY HOLDS** — a `.data` slot's occupant above, and an
	// IMAGE-DATA struct's `.rdata` address at the two arms that materialize one. The two differ only in where
	// the pointer came from, and `mutable` is what parts what may be done through it: an imaged base passes
	// `false`, so a write through it is refused by the very rule a stored `let`'s is.
	//
	// No `baseBindingOf` here, and it would be a no-op if there were: `createValueBinding` cannot mint a
	// self-field alias, so such a base always holds its own value.
	function resolveValueFieldChain(baseTok Token, value ValueId, valueType MaxonType) returns FieldChainStep throws SourceParseError
		let binding = VarInfo.createValueBinding(baseTok.value, varType: valueType, kind: BindingKind.let, boundValue: value)
		let base = try self.requireStructBase(binding, baseTok: baseTok)

		return try self.resolveFieldChainFrom(base.box, layout: base.layout, baseTok: baseTok, baseBinding: binding, cell: ArgumentRoot.none)
	end 'resolveValueFieldChain'

	function resolveThisFrameFieldChain(baseTok Token) returns FieldChainStep throws SourceParseError
		let baseBinding = self.thisFrameBindingOf(baseTok)
		let base = try self.requireStructBase(baseBinding, baseTok: baseTok)

		return try self.resolveFieldChainFrom(base.box, layout: base.layout, baseTok: baseTok, baseBinding: try self.baseBindingOf(baseBinding, baseTok: baseTok, box: base.box), cell: ArgumentRoot.rooted(self.operandRootOf(baseBinding)))
	end 'resolveThisFrameFieldChain'

	// ⭐ **RESOLVE A FIELD-ACCESS CHAIN ON A CAPTURED STRUCT BASE.** `level.rawValue` inside a
	// closure that captures the enclosing struct `level`. The box is READ OUT OF THE ENV (`emitCaptureRead` —
	// a borrowed pointer copy, one `loadIndirect`), and its layout is resolved from the ENCLOSING binding's
	// struct type, identical to a local base. The enclosing binding is threaded as `baseBinding` so a WRITE
	// through a captured base (`level.x = …`) is correctly refused: a captured `let` is immutable (E2013).
	function resolveCapturedFieldChain(baseTok Token, enclosing Scope, frame ElementIndex) returns FieldChainStep throws SourceParseError
		let base = try self.capturedStructBase(baseTok, enclosing: enclosing, frame: frame)

		// The enclosing binding is threaded as `baseBinding` so a WRITE through a captured base (`level.x = …`)
		// is correctly refused — a captured `let` is immutable (E2013) — and so a READ that hands the field's
		// address to a by-reference callee asks that same permission before it does.
		return try self.resolveFieldChainFrom(base.box, layout: base.layout, baseTok: baseTok, baseBinding: try self.baseBindingOf(enclosing.getInfo(self.baseBindingName(baseTok)), baseTok: baseTok, box: base.box), cell: ArgumentRoot.rooted(self.operandRootOf(enclosing.getInfo(self.baseBindingName(baseTok)))))
	end 'resolveCapturedFieldChain'

	// Consume one `.field` on `(box, layout)`. The final field (no `.` after) is RETURNED unread for the
	// caller to read or write; an INTERMEDIATE field (a `.` follows) must be a struct — it is LOADED as the
	// next box (a borrow of the owning struct's field) and the walk recurses. Chains are a handful of hops
	// deep.
	function resolveFieldChainFrom(box ValueId, layout StructLayout, baseTok Token, baseBinding VarInfo, cell ArgumentRoot) returns FieldChainStep throws SourceParseError
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consumeMemberNameToken()

		if not self.at(TokenKind.dot) 'lastField'
			return FieldChainStep.create(box, layout: layout, lastFieldTok: fieldTok, baseTok: baseTok, baseBinding: baseBinding, cell: cell)
		end 'lastField'

		let index = try self.requireFieldIndex(layout, name: fieldTok.value, anchor: fieldTok)
		try self.requireFieldAccessible(layout, index: index, fieldTok: fieldTok)

		// ⭐⭐ **A `.member(` AFTER THIS FIELD ENDS THE CHAIN — THIS FIELD IS THE RECEIVER.** The chain walks
		// FIELDS; a member that opens a CALL is not one, so the walk stops here and returns this field as the
		// chain's last, leaving the cursor on the `.`. The caller loads it and `dispatchMethodOnReceiver`
		// decides what the member is, off the loaded value's own type — which is the same decision it makes
		// for `[1,2].get(0)` and for `s.clone().byteLength()`, reached through the same door.
		//
		// ⭐ **ONE RULE COVERS EVERY FIELD KIND: A MEMBER THAT OPENS A CALL ENDS THE CHAIN.** An ARRAY field
		// (`b.ops.push(1)`) and a TYPE-PARAMETER field (`self.item.digest()`) have no addressable sub-fields,
		// and both are only ever followed by a call, because that is the only thing the language lets you write after
		// them. Every other field kind would otherwise fall through to `structLayoutOfField`, which would make a
		// STRUCT field's method (`o.inner.get()`) `E3018 type 'Inner' has no field named 'get'` — the walk would consume
		// the METHOD NAME as a field — and a scalar field's (`o.count.hash()`) "not a struct".
		//
		// A member with NO `(` after it is still a FIELD and the walk continues, so `o.inner.x` is unchanged
		// and a chain THROUGH a non-struct field is still refused by `structLayoutOfField` below.
		if self.memberCallFollows(self.pos) 'receiverField'
			return FieldChainStep.create(box, layout: layout, lastFieldTok: fieldTok, baseTok: baseTok, baseBinding: baseBinding, cell: cell)
		end 'receiverField'

		// ⭐ **A `T`-TYPED HOP IS SUBSTITUTED BEFORE THE WALK ASKS WHAT IT ADDRESSES.** `pb.value.x` on a
		// `Box with Point` hops through a field the shared generic body typed `T`, and an unsubstituted
		// `typeParameter` reads as an INTEGER (`tagIsIntegral`) — so the hop door refused it as "not a struct"
		// on a program the oracle runs. This is the SAME substitution `emitFieldLoad` applies to the loaded
		// VALUE one line below, under the same shared condition; it has to happen here as well because the
		// walk decides where to go NEXT from the type, before any value exists.
		let declaredFieldType = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)
		let fieldType = self.slotTypeThroughReceiver(box, declared: declaredFieldType, scopeFilePath: layout.declFilePath)

		// ⭐⭐ **AN ENUM ACCESSOR AFTER THIS FIELD ENDS THE CHAIN TOO — the third instance of the rule the
		// `.member(` arm above states, and it arrived the way that arm predicts one will.** `b.c.name` on
		// a field declared `as Color` is not a hop THROUGH `c`: `.name` is a member of the enum VALUE, so
		// the walk stops here, the caller loads `c`, and `parsePostfix` reads the accessor off the loaded
		// value through the same `emitEnumInstanceAccessor` the other two spellings use. Left to fall
		// through, the walk consumed `name` as a field and `structLayoutOfField` refused it — *"a field
		// access through 'Box.c', which is declared 'int' and not a struct"*, a message that is true of
		// the ERASURE and false of the program.
		//
		// ⚠ **IT IS THE ONE GATE HERE THAT MUST ASK THE DECLARED TYPE RATHER THAN A VALUE**, because no value
		// exists yet — the load is what this decision gates. `enumAccessorFollowsFieldTyped` is that reading,
		// and it reaches the same lookup `enumMatchFor` does so the two cannot disagree.
		if self.enumAccessorFollowsFieldTyped(fieldType) 'enumAccessorField'
			return FieldChainStep.create(box, layout: layout, lastFieldTok: fieldTok, baseTok: baseTok, baseBinding: baseBinding, cell: cell)
		end 'enumAccessorField'

		let nextLayout = try self.structLayoutOfField(layout, fieldTok: fieldTok, fieldType: fieldType)
		let nextBox = self.emitFieldLoad(box, layout: layout, index: index, range: SourceRange.between(baseTok, last: fieldTok))
		return try self.resolveFieldChainFrom(nextBox, layout: nextLayout, baseTok: baseTok, baseBinding: baseBinding, cell: cell)
	end 'resolveFieldChainFrom'

	// Does an enum accessor hop follow the cursor, off a field whose DECLARED type is `fieldType`? The
	// type-keyed twin of `atEnumAccessorHopOn`, and it exists because the field-chain walk has to
	// decide whether to continue BEFORE it loads anything — there is no value to classify yet. Past
	// the `named` test the two read the identical lookup (`atEnumAccessorHopOfType`) and the identical
	// admission rule (`atEnumInstanceAccessor`), so a member one admits is a member the other admits.
	//
	// A `named` tag is what an enum-typed field carries (`typeTagName` prints it as `int`, which is what
	// made the old refusal read as a claim about an integer); every other tag declines here and the walk
	// carries on to `structLayoutOfField` exactly as before.
	function enumAccessorFollowsFieldTyped(fieldType MaxonType) returns bool
		if maxonTypeTag(fieldType) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		// ⚠ The tag test above filters almost none of the hops this runs at — a STRUCT-typed field is `named`
		// too — so the allocation guard on the shared tail is what keeps this off the ladder.
		return self.atEnumAccessorHopOfType(self.internedName(typeNameIdOf(fieldType)))
	end 'enumAccessorFollowsFieldTyped'

	// The `StructLayout` of a field whose already-resolved type `fieldType` is passed in — used to continue a
	// field chain THROUGH a struct-typed field (`o.inner.x`). The type is resolved to a `structRef`
	// (`named(Inner)` → `structRef`) and must carry a struct layout; a chain through a scalar / String / array
	// field is refused (an array is handled by the caller before this), since there is nothing to address a
	// further field on. `fieldType` is threaded IN (the caller already computed it) so it is not read twice.
	//
	// ⭐⭐ **IT ASKS `structLayoutOfType` RATHER THAN ANSWERING FOR ITSELF AND THAT KEEPS THE DOORS IN STEP.**
	// The BASE door knows `genericInstance`, so this HOP door must too, or a chain through a
	// generic-instance-typed field — an ordinary `type Outer` with `export var b as IntBox`, no type parameter
	// anywhere — is refused by a message that contradicts itself: `typeTagName(genericInstance)` prints
	// `"struct"`, so it reads *"declared 'struct' and not a struct"*. The oracle compiles that program and
	// prints 7.
	//
	// ⛔⛔ **AND THE ASK IS THE POINT, NOT A TIDY-UP: `structLayoutOfType` CARRIES A MEMORY-SAFETY GATE THIS
	// DOOR WOULD OTHERWISE HAVE HAD TO REMEMBER.** An instance may not ask `structOf` alone — see that
	// function's ⚠⚠ block, which records `a.value` on an `Array with Integer` printing the element buffer
	// POINTER and `a.value = 4242` overwriting it, with no diagnostic and exit 0. A second copy of the gate is
	// exactly the shape this compiler keeps paying for; one door means it cannot be forgotten here.
	// `specs/generic-types.md`'s `error.a-field-chain-through-a-builtin-instance-field-is-still-refused`
	// is what says it came across.
	//
	// The `baseTok` `structLayoutOfType` names in its diagnostics is the FIELD token here — for a hop, the
	// field IS what the reader must fix.
	function structLayoutOfField(baseLayout StructLayout, fieldTok Token, fieldType MaxonType) returns StructLayout throws SourceParseError
		let resolved = resolveNamedStruct(fieldType, typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: baseLayout.declFilePath)
		let tag = maxonTypeTag(resolved)

		if not self.tagCarriesStructLayoutHere(tag) 'notAStruct'
			throw SourceParseError.unsupported("a field access through '{String.from(baseLayout.name)}.{String.from(fieldTok.value)}', which is declared '{typeTagName(tag)}' and not a struct — only a struct field can carry a further field access", line: fieldTok.line, column: fieldTok.column)
		end 'notAStruct'

		return try self.structLayoutOfType(BaseAccessKind.field, tag: tag, nameId: typeNameIdOf(resolved), baseTok: fieldTok)
	end 'structLayoutOfField'

	// A self-field read — `count` and `self.count`, one path.
	//
	// Both spellings mean the same thing, so both resolve to the same `(layout, index)` and hand it
	// to `selfFieldReference`, which decides between handing the slot's address to a by-reference argument
	// and `emitFieldLoad` — the very routine `p.x` uses, emitting the same `loadIndirect` at the
	// same offset with the same storage type. The two spellings differ in exactly one step, and it
	// is the step they *have* to differ in: `self.count` names its field with a TOKEN, so it asks
	// `requireFieldIndex` (and can report E3018); a bare `count` came off an alias that
	// `declareSelfFieldAliases` minted by enumerating the layout, so its index is already known and
	// provably valid.
	//
	// A bare `x` and `self.x` take ONE path: the receiver read plus `emitFieldLoad`. A dedicated
	// self-field op carrying the receiver out-of-band, with slot 0 hardcoded in lowering, would be two
	// ops and two lowerings for one fact, and wrong inside a closure, where there is no receiver slot
	// for slot 0 to name. `Project.maxon`'s `VarInfo.isSelfField` states the rule; this is where it is
	// obeyed.
	function parseSelfFieldRead(nameTok Token, site CellArgumentToken, binding VarInfo) returns ValueId throws SourceParseError
		let layout = try self.enclosingLayout(nameTok)
		try self.requireFieldAccessible(layout, index: binding.fieldIndex, fieldTok: nameTok)

		return self.selfFieldReference(try self.readReceiverValue(nameTok), site: site, layout: layout, index: binding.fieldIndex, range: SourceRange.ofToken(nameTok))
	end 'parseSelfFieldRead'

	function cellWasRequestedAt(site CellArgumentToken) returns bool
		return self.statement.cellArgumentToken.matches(site)
	end 'cellWasRequestedAt'

	// A request is matched by token index, so a door's site must be the last token its read consumed. A
	// mismatch drops the request and the argument spills a scratch cell, losing the callee's write.
	function lastConsumedSite() returns CellArgumentToken
		return CellArgumentToken.at(self.pos - 1)
	end 'lastConsumedSite'

	function handOverPlaceStorage(storage ValueId)
		self.statement.cellArgumentToken = CellArgumentToken.none
		self.statement.handedPlaceStorage = PlaceStorage.handed(storage)
	end 'handOverPlaceStorage'

	function selfFieldReference(box ValueId, site CellArgumentToken, layout StructLayout, index FieldIndex, range SourceRange) returns ValueId
		if self.cellWasRequestedAt(site) 'aRequestedField'
			self.statement.argumentRoot = ArgumentRoot.rooted(self.receiverRootBinding())
		end 'aRequestedField'

		if self.cellWasRequestedAt(site) and self.mayHandOverFieldAt(site, box: box, layout: layout, index: index, writableHere: layout.fieldIsMutable(index)) 'handOverTheSlot'
			return self.handOverFieldStorage(box, layout: layout, index: index, range: range)
		end 'handOverTheSlot'

		return self.emitFieldLoad(box, layout: layout, index: index, range: range)
	end 'selfFieldReference'

	function handOverFieldStorage(box ValueId, layout StructLayout, index FieldIndex, range SourceRange) returns ValueId
		let storage = self.fieldCellAddress(box, layout: layout, index: index, range: range)

		if not self.statement.cellArgumentWantsAPlace 'theSlotAlone'
			self.statement.cellArgumentToken = CellArgumentToken.none
			return storage
		end 'theSlotAlone'

		self.handOverPlaceStorage(storage)
		return self.emitFieldLoad(box, layout: layout, index: index, range: range)
	end 'handOverFieldStorage'

	// ⚠ The storage is handed over exactly where `<the same chain> = v` would be accepted as a real store —
	// same box, same layout, same field index, same permission band, same guards. A callee reassigning a
	// by-reference parameter performs that store from another frame, so a shape admitted here and refused
	// there is a write past a permission rank with no diagnostic anywhere, and a shape refused here and
	// accepted there loses the write silently. `writableHere` is each door's answer to that question.
	//
	// ⛔ An `interfaceRef` is refused whatever its permission: a cell holds exactly ONE value, and an
	// existential spans `fieldSlotCount`'s two slots — so the callee's single-word store through the
	// address it is handed would rewrite the pointer and leave the witness behind it untouched.
	function mayHandOverStorageAt(site CellArgumentToken, writableHere bool, slotType MaxonType) returns bool
		return self.cellWasRequestedAt(site) and writableHere and maxonTypeTag(slotType) != ValueTypeTag.interfaceRef
	end 'mayHandOverStorageAt'

	function mayHandOverFieldAt(site CellArgumentToken, box ValueId, layout StructLayout, index FieldIndex, writableHere bool) returns bool
		if not self.cellWasRequestedAt(site) 'noRequestPending'
			return false
		end 'noRequestPending'

		if layout.fieldIsTheInlineManagedRecord(index) or fieldReadIsThePromiseHandle(self.signatures, receiverType: self.typeOf(box), layout: layout, index: index) 'theFieldIsTheReceiver'
			return false
		end 'theFieldIsTheReceiver'

		return self.mayHandOverStorageAt(site, writableHere: writableHere and layout.fieldIsMutable(index), slotType: self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames))
	end 'mayHandOverFieldAt'

	// The field's own address IS the cell the callee is handed, which is sound only because a cell's payload
	// sits at `ParameterCellValueOffset`, and that is 0: the callee dereferences at that offset and
	// lands on the field. Give a cell a header and this hands every by-reference callee an address one
	// header too low.
	function fieldCellAddress(box ValueId, layout StructLayout, index FieldIndex, range SourceRange) returns ValueId
		let declared = self.slotTypeThroughReceiver(box, declared: self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames), scopeFilePath: layout.declFilePath)
		let offset = self.emitLiteral(layout.offsetOfField(index) as FullRangeInt, valueType: MaxonType.integer, range: range)
		let addr = self.emitMachineWordBinOp(box, rhs: offset, op: MaxonBinOp.add, resultType: MaxonType.integer, range: range)

		self.retypeValue(addr, valueType: self.resolveFloatAliasType(declared, scopeFilePath: self.job.path))
		self.wearDeclaredFloatAlias(addr, declared: self.fieldTypeKeepingAlias(layout, index: index, collapsed: declared), scopeFilePath: layout.declFilePath)
		self.noteHandedStorageType(addr, varType: declared)
		return addr
	end 'fieldCellAddress'

	// `count = <expr>` — write a field of the enclosing type through the receiver, named bare. The
	// mirror of `parseSelfFieldRead`, landing on `emitFieldStore` exactly as `p.x = 5` does.
	//
	// ⭐ **THE RECEIVER'S OWN MUTABILITY IS NOT ASKED HERE.** `parseFieldAssignment` demands a mutable
	// INSTANCE because `let p` refuses a write through it; here the instance is `__self`, a parameter, and
	// every parameter is bound immutable — so asking would report E2013 against `self.n = self.n * 2` in
	// every mutating method the corpus has. A caller's `let` receiver of such a method is refused at the
	// call instead (E3207, `specs/immutable-method-call.md`).
	//
	// What IS asked is the FIELD's mutability — `layout.fieldIsMutable`, the same column and the
	// same diagnostic `c.version = 2` gets, because it is the same question. Anchored at the name
	// token, which is the only token there is.
	function parseSelfFieldAssignment(func IrFunction, block IrBlock, nameTok Token, binding VarInfo) throws SourceParseError
		let layout = try self.enclosingLayout(nameTok)
		try self.requireFieldAccessible(layout, index: binding.fieldIndex, fieldTok: nameTok)

		try self.emitCheckedSelfFieldStore(func, block: block, receiver: try self.requireReceiverValue(nameTok), layout: layout, index: binding.fieldIndex, fieldTok: nameTok, range: SourceRange.ofToken(nameTok))
	end 'parseSelfFieldAssignment'

	// **THE ONE SELF-FIELD WRITE**, shared by the two spellings: the bare `count = 1` and the
	// explicit `self.count = 1`. Everything a write decides lives here — whether the field accepts
	// one, when the right-hand side is parsed, what type it must have, and the store itself — so
	// the two spellings cannot come to disagree about any of it. They differ only in how the index
	// was found and which tokens the span covers, which is all either caller passes in.
	//
	// The right-hand side is parsed AFTER the rejection, so a refused program emits no op.
	function emitCheckedSelfFieldStore(func IrFunction, block IrBlock, receiver ValueId, layout StructLayout, index FieldIndex, fieldTok Token, range SourceRange) throws SourceParseError
		if not layout.fieldIsMutable(index) 'immutableField'
			throw SourceParseError.assignToImmutableField(String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
		end 'immutableField'

		// ⭐ **AND IT IS A WRITE OF THE RECEIVER'S STORAGE, WHICH A CALLER CAN SEE** — `items = <fresh>` inside
		// `b.wipe()` drops the record the field held, exactly as `items.clear()` does. It records the record-write
		// column; `writtenParamMask` stays untouched here (see `IrFunction`'s table and `receiverOwnerMask`).
		// Unconditional on the field's type: `total = total + v` on a scalar field of a global's box writes the
		// record exactly as a managed store does.
		func.writesThroughParamMask = func.writesThroughParamMask or paramMaskOfValue(func, value: receiver)

		let valueStart = self.pos
		let fieldType = self.storedFieldType(receiver, layout: layout, index: index)
		self.stateDeclaredLiteralTarget(fieldType, scopeFilePath: layout.declFilePath, valueStart: valueStart)
		let parsed = try self.parseExpression(func, block: block)

		// The COERCED value is what the store writes — `count = 3` into a `float` field stores the widened
		// f64. Same door as the struct literal and the `p.v = 3` spelling.
		let value = try self.requireFieldType(layout, index: index, fieldType: fieldType, value: parsed, valueStart: valueStart, anchor: fieldTok)

		try self.requireFieldStoreAllowed(func, box: receiver, layout: layout, index: index, value: value, valueStart: valueStart, placeText: "self", line: range.line, column: range.column)

		self.noteClosureStoreSite(ClosureStoreDestination.field(receiver, base: ClosureStoreBase.unspelled), value: value, at: self.tokenAt(valueStart))

		// Routed through `emitFieldWrite`, exactly as `parseFieldAssignment` is: a MANAGED self-field
		// (`name = n`) must MOVE the new value in and only THEN drop the value it displaces (a borrowed String
		// is promoted, a borrowed struct is co-owned), not a raw store that leaks the old value and dangles
		// behind a borrow. ⚠ The acquire-before-release order is load-bearing — `emitFieldWrite` says why.
		try self.emitFieldWrite(receiver, layout: layout, index: index, value: value, argBareLocal: self.rhsWasBareLocalReference(valueStart), anchor: fieldTok, range: range)
	end 'emitCheckedSelfFieldStore'

	// `self.x` / `self.m(…)` — the receiver named explicitly. `self` is its own KEYWORD token, so it
	// cannot ride the identifier paths; what it can do is resolve to the same two destinations they
	// do, which is what this routine is for. In an enum or union method, an accessor or backing field
	// (`self.name`, `self.latency`) is read by `parseEnumAccessor` under the rule a binding's `p.latency`
	// follows (`enumMemberReadableOfType`).
	//
	// The `(` at +3 splits the method call from the field read, exactly as `parseDottedPrimary` splits `p.x`
	// from `p.m(…)`. A `self.a.b` whose last field is a by-reference argument's anchor takes the chain door
	// instead, and that one is decided by the pending request's own token index rather than by a lookahead:
	// only the chain walk can reach a field the explicit single-hop read would leave to `parsePostfix`, and
	// the request has to be taken by the read that stands on it.
	//
	// ⭐ **A BARE `self` — not followed by a dot — IS THE RECEIVER AS A VALUE, AND IT IS ONE.** The receiver is
	// parameter 0, a BORROWED managed value of the enclosing type (`stdlib/FilePath` alone declares 13 signatures
	// taking and returning `FilePath`), so handing it back here does not create an ownership case — it stops hiding one,
	// and every rule that already governs a borrowed struct/union parameter reaches it unchanged. The
	// load-bearing one is the HAND-OFF promotion: `return self` and `f(self)` are the `return p` / `f(p)` of
	// a `p Point` parameter, decided by `emitOwnedValueReturn` and the ordinary argument rules, in ONE place.
	//
	// ⚠⚠ **`resultUsed` IS THE CALLER'S, NOT `true` — AND HARDCODING IT WOULD REFUSE A LEGAL `try
	// self.m()`.** This is reached from a VALUE position (`parsePrimary`) and from a `try` TARGET
	// position (`parseTryCallReceiver`), which is a STATEMENT: `try self.advance()` runs a void
	// throwing method for its effect, exactly as `try advance()` and `try other.advance()` do. With
	// the flag pinned `true`, the void arm of `mintDeclaredCallResult` would fire instead — `E2004:
	// Function 'C.advance' does not return a value`, about a call whose value nobody asked for. The
	// `self` arm must thread the caller's flag; every sibling arm of `parseTryCallReceiver` already passes
	// `false` there, which is why the two other spellings are unaffected.
	function parseSelfPrimary(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		let selfTok = self.current()

		// A receiver is required for EVERY destination, so its EXISTENCE is established once, here, before
		// the split — which is what keeps `self` in a `static function` out of `parseMethodCall`, whose
		// binding lookup would panic rather than report. It is the existence and NOT the value: the two
		// dotted arms resolve the receiver for themselves, and inside a closure a resolve EMITS an env load,
		// so resolving here as well would leave a dead one behind. See `requireReceiverInScope`.
		try self.requireReceiverInScope(selfTok)

		// ⭐ **ONE ARM FOR EVERY RECEIVER KIND, and a split between the enum half and the struct half would
		// rest on nothing real.** An enum's `self` is its i64 TAG or a pointer
		// to its box; a struct's is a pointer to its box; a generic instance's is a pointer to its box — and
		// each is exactly what a PARAMETER of that type holds, which `self` is. So there is nothing here to
		// decide: the value goes back, and whichever rule governs a borrowed value of that type governs it.
		if self.peekKind() != TokenKind.dot 'bareSelf'
			let receiver = try self.readReceiverValue(selfTok)
			self.advance()
			return receiver
		end 'bareSelf'

		if self.methodCallsAt(self.pos) 'methodCall'
			return try self.parseMethodCall(func, resultUsed: resultUsed)
		end 'methodCall'

		if self.selfFieldChainHandsOverACell() 'chainedFieldCell'
			return try self.parseFieldAccess(func)
		end 'chainedFieldCell'

		if self.selfNamesAnEnumAccessor() 'enumAccessor'
			return try self.parseEnumAccessor(EnumAccessorBase.receiver)
		end 'enumAccessor'

		return try self.parseExplicitSelfFieldRead()
	end 'parseSelfPrimary'

	function selfNamesAnEnumAccessor() returns bool
		return self.enclosingTypeIsEnum and self.enumMemberReadableOfType(ValueTypeTag.named, nameId: self.artifact.typeNames.intern(self.enclosingTypeName()), dotIndex: self.pos + 1)
	end 'selfNamesAnEnumAccessor'

	// `self.x` in value position, and the first hop of a longer self chain that hands over no storage — the
	// hops after it are `parsePostfix`'s. It asks
	// `requireFieldIndex` where the bare spelling reads the alias's index — see `parseSelfFieldRead` for why
	// that is the one legitimate difference — and converges on the same `selfFieldReference`.
	function parseExplicitSelfFieldRead() returns ValueId throws SourceParseError
		let selfTok = try self.consume(TokenKind.self)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		let site = self.lastConsumedSite()
		let layout = try self.enclosingLayout(selfTok)
		let index = try self.requireFieldIndex(layout, name: fieldTok.value, anchor: fieldTok)
		try self.requireFieldAccessible(layout, index: index, fieldTok: fieldTok)
		let walk = self.markLateReads()
		let field = self.selfFieldReference(try self.readReceiverValue(selfTok), site: site, layout: layout, index: index, range: SourceRange.between(selfTok, last: fieldTok))

		if self.memberCallFollows(self.pos) 'aReceiverOfACall'
			self.deferReadsSince(walk)
		end 'aReceiverOfACall'

		return field
	end 'parseExplicitSelfFieldRead'

	// `self.x = <expr>`. The explicit spelling, resolving its field token to an index and then
	// handing over to the one shared write above — so both spellings ask one mutability rule and
	// emit one store.
	function parseExplicitSelfFieldAssignment(func IrFunction, block IrBlock) throws SourceParseError
		let selfTok = try self.consume(TokenKind.self)
		try self.consume(TokenKind.dot)
		let fieldTok = try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.equals)

		// ⭐⭐ **IN A STATIC FACTORY THERE IS NO RECEIVER AND THIS IS NOT A STORE.** It DEFERS the field: the
		// value is held in a hidden slot until the `Self{…}` this factory returns consumes it. See
		// `parseNascentSelfAssignment`.
		if self.bodyState.inNascentSelfFactory 'aDeferredField'
			try self.parseNascentSelfAssignment(func, selfTok: selfTok, fieldTok: fieldTok)
			return
		end 'aDeferredField'

		// The receiver first, so `self.x = 1` in a `static function` reports what is actually wrong
		// rather than tripping over the enclosing type's layout.
		let receiver = try self.requireReceiverValue(selfTok)
		let layout = try self.enclosingLayout(selfTok)
		let index = try self.requireFieldIndex(layout, name: fieldTok.value, anchor: fieldTok)
		try self.requireFieldAccessible(layout, index: index, fieldTok: fieldTok)
		try self.emitCheckedSelfFieldStore(func, block: block, receiver: receiver, layout: layout, index: index, fieldTok: fieldTok, range: SourceRange.between(selfTok, last: fieldTok))
	end 'parseExplicitSelfFieldAssignment'

	// ⭐⭐ **`self.<field> = <expr>` IN A STATIC FACTORY — THE THIRD WAY A FIELD GETS ITS VALUE**
	// (`/specs/field-initialization.md`, rule 3). There is no receiver and no box: the value is bound to a
	// HIDDEN LOCAL, and the `Self{…}` this factory returns takes it from there.
	//
	// ⭐ **THE SLOT IS AN ORDINARY LOCAL, WHICH IS THE WHOLE IMPLEMENTATION.** A `var` the compiler already carries
	// through every merge it has — an `if`'s two arms give it a block argument, a loop carries it — so
	// "which value does the literal see?" is answered by the machinery that answers it for `var acc`, and
	// nothing here re-derives control flow. A MANAGED value is enrolled owned at its declaration exactly as
	// `var s = "…"` is, so a path that assigns and returns without a literal drops it at the scope exit.
	//
	// ⇒ what is left over is only the SECOND question — is it assigned on every path that reaches the
	// literal? — and that is `validateNascentSelfAssignments`, after the body, over the blocks the parse
	// actually built.
	function parseNascentSelfAssignment(func IrFunction, selfTok Token, fieldTok Token) throws SourceParseError
		let layout = try self.enclosingLayout(selfTok)
		let index = try self.requireFieldIndex(layout, name: fieldTok.value, anchor: fieldTok)
		try self.requireFieldAccessible(layout, index: index, fieldTok: fieldTok)
		let fieldType = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)

		let valueStart = self.pos
		self.stateDeclaredLiteralTarget(fieldType, scopeFilePath: layout.declFilePath, valueStart: valueStart)
		let parsed = try self.parseExpression(func, block: self.bodyState.currentBlock)

		// The coercion is the LITERAL's, through the same door — `self.v = 3` into a `float` field holds the
		// widened f64, exactly as `Self{v: 3}` stores one, because the two spellings fill one slot.
		let value = try self.requireFieldType(layout, index: index, fieldType: fieldType, value: parsed, valueStart: valueStart, anchor: fieldTok)
		let sourceName = self.rhsRootLocalName(valueStart)
		let sourceReadsAField = self.rhsSpanReadsAField(valueStart)

		let slotTok = self.nascentSelfSlotToken(fieldTok)

		if not self.bodyState.scope.contains(slotTok.value) 'noSlotForThisField'
			throw SourceParseError.unsupported("deferring field '{String.from(fieldTok.value)}' of `type {String.from(layout.name)}` to a `self.{String.from(fieldTok.value)} = …` assignment — the field's type owns heap, and a deferred slot holds its value across control flow with no place to release it on a path that assigns and then leaves without building the `Self\{…\}`. Give the field in the literal instead", line: fieldTok.line, column: fieldTok.column)
		end 'noSlotForThisField'

		self.bodyState.nascentSelfWrites.push(NascentSelfWrite.create(fieldTok.value, block: self.bodyState.currentBlock.id, position: self.bodyState.currentBlock.bodyOpCount()))
		try self.reassignBindingValue(func, binding: self.bodyState.scope.getInfo(slotTok.value), nameTok: slotTok, value: value, rhsBareLocalName: sourceName if not sourceReadsAField else SourceBinding.none)
	end 'parseNascentSelfAssignment'

	// ⭐⭐ **A DEFERRED FIELD'S SLOT IS OPENED AT THE TOP OF THE BODY, BEFORE ANY BLOCK IS — and that is the
	// whole reason `if … self.v = 1 … else … self.v = 2 … end` then reaches the `Self{…}` with a phi.** A
	// binding declared inside a branch leaves scope at that branch's `end` and is carried by nothing; one
	// declared here is an ordinary function-scope `var`, and every merge the compiler already has carries it — the
	// `if`'s block argument, the loop header's, the match's. Nothing about control flow is re-derived.
	//
	// ⚠ **THE SET COMES FROM A TOKEN SCAN, because a declaration cannot wait for the write that needs it.**
	// It looks for `self . <name> =` and nothing else — the same four tokens the assignment door consumes —
	// so a body that defers nothing pays one scan of its own tokens and declares nothing.
	//
	// ⚠ **A FIELD WHOSE TYPE OWNS HEAP GETS NO SLOT, and the assignment door refuses it by name.** The slot
	// would hold a managed value across control flow with no owner: a path that assigns and then `throw`s
	// leaks it, and a placeholder for the paths that do not assign is a null the scope exit would release.
	// The literal spelling (`Self{name: …}`) has neither problem and is the cure the message names.
	function declareNascentSelfSlots(block IrBlock, nameTok Token) throws SourceParseError
		if not self.bodyState.inNascentSelfFactory 'notAFactory'
			return
		end 'notAFactory'

		// ⚠ **THE ENTRY BLOCK IS SEEDED HERE AND NOT INHERITED.** This runs BEFORE `parseStatements`, which is
		// what sets `currentBlock` for the body — so without this the placeholders are emitted into whatever
		// block the PREVIOUS function ended on, and the entry block reads a value defined in another function.
		// MEASURED: `seedInUse: value 3 is live-in to block 0 but was never colored`.
		self.bodyState.currentBlock = block

		let layout = try self.enclosingLayout(nameTok)
		let bodyStart = self.pos
		let bodyEnd = self.bodyEndTokenIndex(bodyStart)
		let range = SourceRange.ofToken(nameTok)

		var i = bodyStart

		while i < bodyEnd 'scan'
			if self.nascentSelfAssignmentAt(i) 'aDeferredWrite'
				try self.declareOneNascentSelfSlot(layout, fieldTok: self.tokenAt(i + 2), range: range)
			end 'aDeferredWrite'

			i = i + 1
		end 'scan'
	end 'declareNascentSelfSlots'

	// Is the four-token run at `index` a deferred field write — `self . <name> =`? The same shape
	// `parseExplicitSelfFieldAssignment` consumes, asked of the token stream so the slot can exist before the
	// statement is reached.
	function nascentSelfAssignmentAt(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.self and self.kindAt(index + 1) == TokenKind.dot and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.equals
	end 'nascentSelfAssignmentAt'

	// One slot, declared once however many times the body assigns the field. A name the layout does not
	// declare is left alone: the real parse reports it (E3018) at the write, where the token is.
	function declareOneNascentSelfSlot(layout StructLayout, fieldTok Token, range SourceRange) throws SourceParseError
		let slotTok = self.nascentSelfSlotToken(fieldTok)

		if self.bodyState.scope.contains(slotTok.value) 'alreadyOpen'
			return
		end 'alreadyOpen'

		let index = try layout.indexOfField(fieldTok.value) otherwise return
		try self.declareNascentSlotForField(layout, index: index, slotTok: slotTok, range: range)
	end 'declareOneNascentSelfSlot'

	// One slot, once its field is known to exist. Split off because a `match` arm is one statement.
	function declareNascentSlotForField(layout StructLayout, index FieldIndex, slotTok Token, range SourceRange) throws SourceParseError
		let placeholder = nascentSlotPlaceholderType(maxonTypeTag(self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)))

		match placeholder 'kind'
			ownsHeap then return
			value(valueType) then try self.declareInitializedBinding(slotTok, value: self.emitLiteral(0, valueType: valueType, range: range), sourceName: SourceBinding.none, sourceReadsAField: false, kind: BindingKind.var)
		end 'kind'
	end 'declareNascentSlotForField'

	// The token index of this body's own `end` — the first block closer the scan reaches at depth zero.
	function bodyEndTokenIndex(bodyStart ElementIndex) returns ElementIndex
		self.buildBlockExtentIndex()
		let count = self.tokens.count()
		var depth = 0 as NestingDepth
		var i = bodyStart

		while i < count 'scan'
			if self.opensBlockAt(i) 'opens'
				depth = depth + 1
			end 'opens' else if self.closesBlockAt(i) 'closes'
				if depth == 0 'ourOwnEnd'
					return i
				end 'ourOwnEnd'

				depth = depth - 1
			end 'closes'

			i = i + 1
		end 'scan'

		return count
	end 'bodyEndTokenIndex'

	// The hidden slot's name token — the field's own, renamed into the reserved space. It carries the FIELD's
	// line and column, so anything that anchors on the binding points at what the author wrote.
	function nascentSelfSlotToken(fieldTok Token) returns Token
		return Token.create(TokenKind.identifier, line: fieldTok.line, column: fieldTok.column, value: nascentSelfSlotName(fieldTok.value))
	end 'nascentSelfSlotToken'

	function parseDeferredFieldAssignment(func IrFunction, block IrBlock) throws SourceParseError
		self.noteDeferredValueInTryBlock()
		self.advance()
		_ = try self.parseDeferredMemberChain(func)
		try self.consume(TokenKind.equals)
		_ = try self.parseExpression(func, block: block)
	end 'parseDeferredFieldAssignment'

	function parseFieldAssignment(func IrFunction, block IrBlock) throws SourceParseError
		if self.chainBaseIsDeferred() 'deferredBase'
			try self.parseDeferredFieldAssignment(func, block: block)
		end 'deferredBase' else 'resolvedBase'
			try self.parseResolvedFieldAssignment(func, block: block)
		end 'resolvedBase'
	end 'parseFieldAssignment'

	// `p.x = <expr>` — write field `x` of the box `p` points at. The mirror of `parseFieldAccess`: the
	// same tokens resolved through the same two steps (which type is `p`, which slot does that type
	// call `x`), landing on `storeIndirect` where the read lands on `loadIndirect`.
	//
	// Two things must be writable, and they are two facts: the instance (`let p` is not writable
	// through) and the field (`export let version` is not writable). Both report E2013 at the root
	// variable token, pinned by `structs.md`'s two `error.*` cases at `:16:2`.
	//
	// The instance rank is not `requireMutableBinding`: a parameter borrows the caller's box, and a
	// borrow's pointee fields are writable, so a parameter passes here and still refuses a rebind.
	// The two doors are `requireMutableBinding` and `requireWritableInstance`.
	//
	// Resolve, then permit; each rank is the fix that works next, so every message names a change
	// that fixes the program:
	//   1. Resolution — is `p` a struct with a field `x`? Asked first, through the same two helpers
	//      `parseFieldAccess` asks, so a write and a read cannot disagree about what `p.x` denotes.
	//      A permission message can only advise "declare it `var`", which cannot fix `n.x = 1` on an
	//      `int`.
	//   2. Permission — the instance, then visibility (E3014), then the field's mutability:
	//        • `var v` + `let` unexported field → E3014
	//        • `let v` + `var` unexported field → E2013 'v'
	//        • `v.nosuch`                       → E3018
	//      `struct-field-assign-precedence.md` pins the ranks.
	//
	// The read path asks the same chain without the instance rank (`parseFieldAccess`).
	function parseResolvedFieldAssignment(func IrFunction, block IrBlock) throws SourceParseError
		// The base's own token index, taken before the chain walk moves the cursor, so the storage subject
		// below comes through the shared `storageSubjectNameAt` — ONE derivation of "which storage does this
		// write go through", asked identically at every door.
		let baseIndex = self.pos

		// `resolveFieldChain` reads `base.f1.…fN` (a single `p.x` or a chain `o.inner.x`), resolving every
		// intermediate struct field and leaving the cursor on the `=`. Its `requireStructBase` already
		// enforced the base's live-binding guard.
		let targetOperands = self.bodyState.operandOrder.eventCount()
		let walk = self.markLateReads()
		let step = try self.resolveFieldChain()
		self.deferReadsSince(walk)
		self.bodyState.operandOrder.stashSince(targetOperands)

		// The place as written, and the record written: everything before the chain's last `. <field>`.
		let lastDotIndex = self.pos - 2
		try self.consume(TokenKind.equals)
		let index = try self.requireFieldIndex(step.layout, name: step.lastFieldTok.value, anchor: step.lastFieldTok)

		try self.requireWritableInstance(step)
		try self.requireFieldAccessible(step.layout, index: index, fieldTok: step.lastFieldTok)

		if not step.layout.fieldIsMutable(index) 'immutableField'
			throw SourceParseError.assignToImmutableField(String.from(step.lastFieldTok.value), line: step.baseTok.line, column: step.baseTok.column)
		end 'immutableField'

		// `writtenParamMask` deliberately stays untouched — the row `IrFunction`'s table already carries for the
		// field-chain write whose base is a parameter: **no / yes**. The refusal a field write through a
		// PARAMETER earns rides `writesThroughParamMask` below instead.
		let subjectName = self.storageSubjectNameAt(baseIndex)

		// ⭐ This is the door the narrow column never records. `bump(b Box)` whose body is `b.n = 99` writes the
		// caller's record and would otherwise be summarised as writing nothing, so `let a = Box.create()` +
		// `bump(a)` would compile and write a binding the program declared `let`. The narrow column cannot be
		// widened to catch it: it is what the RECEIVER slot reads alone. Ungated by field type: a scalar field of
		// a `let`'s box is as much the binding as an array field is.
		func.writesThroughParamMask = func.writesThroughParamMask or self.subjectStorageMask(func, subjectName: subjectName)

		// Parsed AFTER both rejections, so a refused program emits no op. The value's start is captured so `emitFieldWrite` can decide, for a
		// MANAGED field, whether the new value is a bare-local reference to poison.
		let valueStart = self.pos
		let storedType = self.storedFieldType(step.box, layout: step.layout, index: index)
		self.stateDeclaredLiteralTarget(storedType, scopeFilePath: step.layout.declFilePath, valueStart: valueStart)
		let parsed = try self.parseExpression(func, block: block)
		self.restoreStashedOperands()

		// The COERCED value is what the store writes — `p.v = 3` into a `float` field stores the widened
		// f64. Same door as the struct literal and the bare self-field spelling.
		let value = try self.requireFieldType(step.layout, index: index, fieldType: storedType, value: parsed, valueStart: valueStart, anchor: step.lastFieldTok)

		try self.requireFieldStoreAllowed(func, box: step.box, layout: step.layout, index: index, value: value, valueStart: valueStart, placeText: self.tokenTextFrom(baseIndex, endIndex: lastDotIndex), line: step.baseTok.line, column: step.baseTok.column)

		try self.requireStoreRootStillLive(self.storeRootOf(step.baseBinding), rootTok: step.baseTok)
		self.noteClosureStoreSite(ClosureStoreDestination.field(step.box, base: ClosureStoreBase.spelled(step.baseBinding.boundValue, name: step.baseBinding.name)), value: value, at: self.tokenAt(valueStart))

		try self.emitFieldWrite(step.box, layout: step.layout, index: index, value: value, argBareLocal: self.rhsWasBareLocalReference(valueStart), anchor: step.lastFieldTok, range: SourceRange.between(step.baseTok, last: step.lastFieldTok))
	end 'parseResolvedFieldAssignment'

	// ⭐ **WRITE A FIELD, DROPPING THE OLD MANAGED VALUE AND MOVING THE NEW ONE IN** — the
	// assignment counterpart of the construct-time `emitStructLiteral` move. A SCALAR field is a plain store.
	// A MANAGED field (a `String` or a `struct`) first MOVES the new value in (`moveInPayload` — a borrowed
	// literal is promoted, an owned value transfers, a borrowed struct is CO-OWNED) and only THEN drops the
	// value it displaces (`emitDecref`, tag-routed), so the field owns exactly one value across the write and
	// the old one is freed exactly once. Mirrors the `var`-String reassignment drop model, one indirection out.
	// ⛔ **THE ACQUIRE-THEN-RELEASE ORDER IS LOAD-BEARING** — see the measured use-after-free at the
	// emission site.
	// ⚠ **A FIELD WRITE RECORDS NO PARAMETER MUTATION HERE (`writtenParamMask`)**, though a PARAMETER's box is
	// reachable by one — it is the row `IrFunction`'s table already carries for a field-chain write whose base
	// is a parameter, and `array-managed-field-reassign:reassign-empty-array-field` is the case that goes red
	// the moment that column is fed from here. The write-through column IS fed, at the doors that call
	// this.
	// ⭐⭐ **THE TYPE A WRITE THROUGH *THIS BOX* ACTUALLY STORES — the ONE derivation, read by the TYPE CHECK
	// and by the STORE.** A field's declared type is the SHARED layout's, so an opaque `export var value as T`
	// answers `typeParameter` however concrete the receiver is; only the box says what `T` stands for. A
	// `genericInstance` box binds it (`slotTypeThroughReceiver`, the same door `emitFieldLoad` retypes a READ
	// through), a `structRef` box is the shared generic body and leaves it opaque.
	//
	// ⛔ The store and the check must classify the SAME type. `emitFieldWrite` resolves `T` to the
	// instance's argument before classifying the slot; handed the UNSUBSTITUTED `fieldTypeOf`,
	// `requireFieldType` — one line earlier at the very same doors — takes its verdict against `type
	// parameter`, which admits everything, and the store is then performed against `Label`. On
	// `LabelBox = Box with Label`, `b.value = Other.create(99)` then COMPILES, writes an `Other` box
	// into the `Label` slot, and reading `b.value.text` exits **0xC0000005**, where the correct answer
	// is `E3005 cannot assign a value of type 'Other' to field 'value' of 'LabelBox', which holds
	// 'Label'`. One derivation of the fact, read by both.
	//
	// ⚠ **AND IT IS THE READ'S DOOR VERBATIM**, rather than a `typeParameter`-only copy of the condition.
	// Such a copy has the read's blind spot exactly: a field typed through an inner
	// `typealias Items = Array with T` is a `genericInstance`, so the store's verdict is taken against
	// `Array with T` for a box that holds `Array with Num` — the same two-derivations-of-one-fact shape the
	// paragraph above records, one declaration form over.
	function storedFieldType(box ValueId, layout StructLayout, index FieldIndex) returns MaxonType
		return self.slotTypeThroughReceiver(box, declared: self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames), scopeFilePath: layout.declFilePath)
	end 'storedFieldType'

	function emitFieldWrite(box ValueId, layout StructLayout, index FieldIndex, value ValueId, argBareLocal bool, anchor Token, range SourceRange) throws SourceParseError
		let fieldType = self.storedFieldType(box, layout: layout, index: index)

		// ⭐ **A BARE OPAQUE `T` FIELD REASSIGNMENT.** The field is typed opaque `T`
		// (`typeParameter`) in the shared layout; how its OLD value drops depends on the box:
		//   • the enclosing SELF (a `structRef`, the shared generic body) keeps the field opaque, so a MANAGED
		//     instantiation's old value drops through the descriptor-gated `__drop_type_param` and the new value
		//     transfers in — `emitOpaqueFieldReassign`, which also handles the trivial-inert store.
		//   • a CONCRETE instance (`b.saved = …`, a `genericInstance`) knows its argument, so the field was
		//     RETYPED to that substituted concrete type above (as `emitFieldLoad` retypes a READ) and never
		//     reaches this arm — a managed concrete field drops the old through its own decref (`__str_decref` /
		//     `__destruct_<T>`) and moves the new in; a trivial one reclassifies to a scalar store.
		//
		// ⭐⭐ **"AS `emitFieldLoad` RETYPES A READ" IS LITERALLY THE SAME CALL, BECAUSE A COPY OF THE READ DOOR'S BODY
		// IS A READ-AFTER-FREE.** A line spelling `adoptType(substitutedInstanceArg(…))` — the body the READ door
		// (`slotTypeThroughReceiver`) routes through `declaredSlotType` — would fix the READ door and leave its declared
		// twin behind. What the copy hands on is a bare `named`, and the
		// consumer here is `classifyUnionPayload`, which resolves a `named` through its OWN cascade: it has a
		// struct arm (so a `Box with Point` write keeps working, which is why the split hides) and NO generic-alias
		// arm, so a `Holder with IntBox` write falls through to `undeclaredName`, takes the SCALAR store, and
		// neither drops the old box nor moves the new one in.
		//
		// ⚠ **MEASURED**, `var h = BoxHolder.hold(IntBox.create(7)); h.item = IntBox.create(8); h.item.value`:
		// the temporary was freed at the statement and the field kept pointing at it, so the read printed
		// **4557430888798830399** — `0x3F3F3F3F3F3F3F3F`, the free poison — where the oracle prints 8.
		//
		// Sharing the door rather than re-spelling it is the cure: a re-tag added to `declaredSlotType` now
		// reaches the WRITE the same day it reaches the READ.
		if maxonTypeTag(fieldType) == ValueTypeTag.typeParameter 'opaqueTypeParamField'
			self.emitOpaqueFieldReassign(box, layout: layout, index: index, value: value, fieldType: fieldType, argBareLocal: argBareLocal, range: range)
			return
		end 'opaqueTypeParamField'

		let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: fieldType, slotScopeFilePath: layout.declFilePath)

		// ⭐⭐ **A PROMISE FIELD IS STORED IN THREE STEPS AND THE ORDER IS THE WHOLE CORRECTNESS ARGUMENT.**
		// It sits above the managed test because a promise is not managed, and a bare store here leaves the
		// spawn a statement-scoped pending temporary whose drain CANCELS the thread the field now holds.
		//   • the MOVE-IN transfers ownership, and vacates the source slot if the value came out of one;
		//   • the RELEASE then drops whatever the field still held, exactly once — a field a previous
		//     consume emptied holds 0 and is skipped, which is the re-armed case;
		//   • the STORE puts the new thread in.
		// Release AFTER move-in is what makes an aliasing store (`g.p = h.p` on one box) correct: the
		// move-in has already emptied the source, so the release reads 0 and drops nothing.
		if payloadClassIsAGreenThread(class) 'aPromiseField'
			let moved = try self.moveInPayload(class, arg: value, argBareLocal: argBareLocal, owner: box, anchor: anchor, range: range)
			let displaced = self.emitIndirectLoad(MaxonType.integer, box: box, offset: layout.offsetOfField(index), storageType: MaxonType.integer, range: range)
			self.emitFieldStore(box, layout: layout, index: index, value: moved, range: range)
			self.emitPromiseRelease(displaced, range: range)
			return
		end 'aPromiseField'

		if not payloadClassIsManaged(class) 'scalarField'
			self.emitFieldStore(box, layout: layout, index: index, value: value, range: range)
			return
		end 'scalarField'

		let old = self.emitFieldLoad(box, layout: layout, index: index, range: range)

		// ⛔⛔ **ACQUIRE THE NEW VALUE BEFORE RELEASING THE OLD ONE — THE OTHER ORDER IS A USE-AFTER-FREE WHEN
		// THEY ARE THE SAME RECORD.** This door emitted the release FIRST until 2026-08-12, which made an
		// INDIRECT self-assignment free the value and then incref the freed memory.
		//
		// ⚠ On `function assign(dst Blk, src Blk)` doing `dst.args = src.args`, called as `assign(a, src:
		// a)`: a struct is a pointer to a shared heap box, so both parameters name ONE box and the
		// store's two operands are the same `Array` record. Release-first takes its refcount 1 → 0
		// (freed), the acquire then touches freed memory and the program exits **0xC0000005**.
		// Acquire-first makes the same store a net no-op (1 → 2 → 1), which is what it must be.
		//
		// ⚠ **NO STATIC CHECK CAN STAND IN FOR THIS.** The LEXICAL no-op `self.args = self.args` is refused by
		// E3067 (`rejectDegenerateAssignment`), and that refusal is exactly what hid the defect: it masks the
		// spelling while the aliasing route through two parameters is a genuine store whose operands only
		// coincide at RUN TIME. The store protocol itself has to be safe, so the fix is the order, not a wider
		// refusal. Pinned by `specs/managed-field-store-order.md`.
		//
		// This is the order the other DURABLE-STORAGE writes in this file already use and state for themselves —
		// `reassignCellBinding` ("the release must come AFTER the new value is settled and BEFORE the store"),
		// and `reassignBindingValue` in an inline comment rather than its header.
		// ⚠ `emitOpaqueFieldReassign`, this same function's other arm, releases between its two acquires; the
		// reason each order is safe is written at its own decref.
		//
		// An opaque `T` field is settled above by `emitOpaqueFieldReassign`, so the class here is always a
		// concrete managed one and the `owner` is never read — it is passed because the box IS the owner of
		// whatever lands in the slot, which is the fact the parameter names.
		let stored = try self.moveInPayload(class, arg: value, argBareLocal: argBareLocal, owner: box, anchor: anchor, range: range)

		self.emitFieldStore(box, layout: layout, index: index, value: stored, range: range)
		self.emitDecref(old, range: range)
	end 'emitFieldWrite'

	function fieldPlaceSpelling(layout StructLayout, index FieldIndex, fieldType MaxonType) returns immutable ByteArray
		let declared = self.signatures.fieldTypeOf(layout, index: index, into: self.artifact.typeNames)
		return layout.fieldDeclaredBrand(index) if maxonTypesDenoteSame(fieldType, b: declared) else EmptySourceText
	end 'fieldPlaceSpelling'

	// ⭐ **REASSIGN A BARE OPAQUE `T` FIELD IN THE SHARED GENERIC BODY** — the opaque twin of the
	// concrete managed field write. An OWNED new value transfers — `markOpaqueFieldReassignFeed` recorded the
	// reassigned parameter as a feed, so `bindParameters` enrolled it owned and the concrete call site transferred
	// it — and a BORROWED one takes its own reference through the descriptor. The field's OLD value
	// drops ONLY when some instantiation owes it a drop (`genericTypeFieldHasManagedInstantiation`):
	// then through the descriptor-gated `__drop_type_param`
	// (`emitDecref`'s `typeParameter` arm, which makes the method a layout carrier in lowering's carrier scan;
	// inert for a trivial instantiation whose `destroyFunc@40` is 0). An ALL-TRIVIAL
	// field owns no heap, so no drop and no descriptor — the store is byte-identical to a plain store.
	// An owned value then ALWAYS transfers into the field (a bare-local source is poisoned, E3102 on later use), so
	// this frame does not also drop it AND the enrolled-owned parameter is never left live to drop at a scope exit
	// (which would need a descriptor a trivial method does not carry).
	function emitOpaqueFieldReassign(box ValueId, layout StructLayout, index FieldIndex, value ValueId, fieldType MaxonType, argBareLocal bool, range SourceRange)
		// A borrowed opaque `T` takes a reference through the descriptor's `retainFunc@64`, as a container store
		// does (`referenceBorrowedOpaqueElement`). The retain and the old-value drop below both read
		// `genericTypeFieldHasManagedInstantiation`, so a reference is taken exactly where the displaced value
		// is released.
		//
		// ⚠ **BOTH DOORS ASK OWNERSHIP OF THE VALUE AT THE STORE, AND A PARAMETER ANSWERS "OWNED" WHATEVER ITS
		// CALLER DID — SO ONE METHOD HOP COULD DEFEAT BOTH.** That is closed at the CALLER rather
		// than here: `handleEscapingBorrowFeed` takes a real reference for a borrowed opaque argument at a
		// callee-storage feed position, so the "owned" answer this door reads is TRUE by construction.
		let owned = self.valueIsOwnedHeap(value)
		let stored = value if owned else self.referenceBorrowedOpaqueForField(value, fieldType: fieldType, range: range)

		// ⛔ **THE RELEASE SITS BETWEEN THE TWO ACQUIRES, AND EACH ORDER IS SAFE FOR ITS OWN REASON.** A
		// borrowed value's real reference (`referenceBorrowedOpaqueForField`) is emitted ABOVE this decref, so a
		// value that IS the displaced occupant is retained before it is released — `emitFieldWrite`'s order, and
		// `specs/managed-field-store-order.md` shows what the other order costs. An owned value's acquire is
		// `transferOwnedInto` below, which emits NO op that reads the record, and an owned RHS already carries a
		// reference of its own, so the record is at refcount ≥ 2 when this decref runs.
		if not self.signatures.genericTypeFieldHasManagedInstantiation(typeParamIdOf(fieldType)) 'nothingDisplacedOwesADrop'
			self.storeOpaqueFieldValue(box, layout: layout, index: index, value: value, stored: stored, owned: owned, argBareLocal: argBareLocal, range: range)
			return
		end 'nothingDisplacedOwesADrop'

		let old = self.emitFieldLoad(box, layout: layout, index: index, range: range)
		self.storeOpaqueFieldValue(box, layout: layout, index: index, value: value, stored: stored, owned: owned, argBareLocal: argBareLocal, range: range)
		self.emitDecref(old, range: range)
	end 'emitOpaqueFieldReassign'

	function storeOpaqueFieldValue(box ValueId, layout StructLayout, index FieldIndex, value ValueId, stored ValueId, owned bool, argBareLocal bool, range SourceRange)
		if owned 'movesTheOwnedValueIn'
			self.transferOwnedInto(value, argBareLocal: argBareLocal)
		end 'movesTheOwnedValueIn'

		self.emitFieldStore(box, layout: layout, index: index, value: stored, range: range)
	end 'storeOpaqueFieldValue'

	function referenceBorrowedOpaqueForField(value ValueId, fieldType MaxonType, range SourceRange) returns ValueId
		if not self.signatures.genericTypeFieldHasManagedInstantiation(typeParamIdOf(fieldType)) 'nothingToReference'
			return value
		end 'nothingToReference'

		return self.coOwnBorrowedOpaque(value, range: range)
	end 'referenceBorrowedOpaqueForField'

	// Declare every field of the enclosing type as a self-field alias, so a bare `width` inside
	// `function area()` of `type Rect` resolves to `self.width`. Called at instance-method entry
	// only; `anchor` is the method's name token, which the layout lookup's diagnostic points at.
	//
	// The alias carries the field's INDEX and its declared TYPE, both read straight out of the
	// layout being enumerated — so the alias cannot name a field the type does not have, which is
	// what lets the read and write paths skip the "does this type have this field?" question that
	// `self.x` and `p.x` must ask.
	//
	// The type comes through `fieldTypeOf`, not off the layout's column directly, because that is
	// the door that RE-INTERNS a `named` type into this file's own interner — the same door
	// `emitFieldLoad` reads a field's type through. Reading the column raw would bind aliases to
	// type-name ids from the SWEEP's table, which this file's interner cannot resolve.
	function declareSelfFieldAliases(anchor Token) throws SourceParseError
		let layout = try self.enclosingLayout(anchor)
		self.resolveSelfFieldTypes(layout)

		for i in 0 upto layout.fieldCount() 'eachField'
			let fieldName = try layout.fieldNames.get(i) otherwise panic("declareSelfFieldAliases: fieldNames.get OOB at {i} for `type {String.from(layout.name)}`, which declares {layout.fieldCount()}")
			let fieldType = try self.selfFieldTypes.get(i) otherwise panic("declareSelfFieldAliases: selfFieldTypes.get OOB at {i} for `type {String.from(layout.name)}` — `resolveSelfFieldTypes` resolves every one of its {layout.fieldCount()} fields")
			self.bodyState.scope.declareSelfField(fieldName, varType: fieldType, fieldIndex: i)
		end 'eachField'
	end 'declareSelfFieldAliases'

	// Resolve `layout`'s field types into `selfFieldTypes`, unless they already are. A field's type is a fact about
	// the declaration and this file's interner, and neither moves during a parse.
	function resolveSelfFieldTypes(layout StructLayout)
		if let resolved = try self.selfFieldTypesLayout.get(0) 'resolvedBefore'
			if resolved is layout 'theSameLayout'
				return
			end 'theSameLayout'
		end 'resolvedBefore'

		self.selfFieldTypesLayout.clear()
		self.selfFieldTypesLayout.push(layout)
		self.selfFieldTypes.clear()

		for i in 0 upto layout.fieldCount() 'eachField'
			self.selfFieldTypes.push(self.signatures.fieldTypeOf(layout, index: i, into: self.artifact.typeNames))
		end 'eachField'
	end 'resolveSelfFieldTypes'

	// The `StructLayout` of the type whose body encloses the cursor. The self-field twin of
	// `requireStructBase`: that one resolves the layout of a BINDING's declared type, this one
	// resolves the layout of the enclosing DECLARATION, which is what a receiver and a bare field
	// name are both typed by.
	//
	// Both misses panic rather than report, and for `requireConstructible`'s reason: every caller
	// is inside an instance method, so an enclosing type exists by construction, and the
	// declaration sweep recorded every `type` in the program before this file's parse began.
	function enclosingLayout(anchor Token) returns StructLayout throws SourceParseError
		let typeName = try self.enclosingType.typeName() otherwise panic("enclosingLayout: asked for the enclosing type's layout at {anchor.line}:{anchor.column}, but the cursor is at file scope — every caller is inside an instance method, whose body only `parseTypeDeclaration` reaches")

		// ⛔ **AN `enum`/`union` HAS NO LAYOUT TO ASK FOR** — and this is the one door the RECEIVER-FIELD
		// family has to say so at, because both spellings of a receiver field access come through it
		// (`parseExplicitSelfFieldRead`
		// and `parseExplicitSelfFieldAssignment`; the bare-name spellings cannot arrive, since `parseFunction`
		// declares no self-field aliases for an enum). A readable accessor or backing field is claimed first
		// by `selfNamesAnEnumAccessor`, so what arrives is a payload name or a write. Without it,
		// `self.reason` inside a `union` method — the
		// first thing a reader tries on a payload-bearing case — reached the `undeclared` panic below and took
		// the compiler down while blaming the declaration sweep for a disagreement that never happened.
		//
		// A positioned refusal, because the source can perfectly well write it: a case's PAYLOAD is a
		// pattern binding, not a member. (The oracle answers `E4006 has no property or method named 'reason'`;
		// The compiler says the same thing as the E2015 the rest of this family refuses with, and names the cure.)
		if self.enclosingTypeIsEnum 'enumHasNoFields'
			throw SourceParseError.unsupported("a field access through `self` in a method of `enum`/`union` `{String.from(self.enclosingTypeName())}` — an enum/union declares no fields; a case's PAYLOAD is bound by a pattern (`match self 'k' … fail(reason) then …`), never read through the receiver", line: anchor.line, column: anchor.column)
		end 'enumHasNoFields'

		// ⛔ **A PRIMITIVE HAS NO LAYOUT EITHER, AND IT IS THE ARM ABOVE'S TWIN FOR A DIFFERENT REASON:**
		// an enum has fields nowhere to *put*, and a primitive IS its value — `self` inside `extension int` is
		// the integer, not a box, so there is nothing a `.field` could name. `parseFunction` installs no
		// self-field aliases for such a body (its `⚠` states the measured abort), so the only spelling that
		// reaches here is the EXPLICIT `self.x`, which is exactly the door the enum arm sits at.
		//
		// Positioned rather than panicking for that arm's reason: the source can perfectly well write it.
		if primitiveTagOfTypeName(typeName) != ValueTypeTag.unresolved 'aPrimitiveHasNoFields'
			throw SourceParseError.unsupported("a field access through `self` in a method of `extension {String.from(self.enclosingTypeName())}` — a primitive IS its value and declares no fields, so `self` here is the {String.from(self.enclosingTypeName())} itself and has no members to read", line: anchor.line, column: anchor.column)
		end 'aPrimitiveHasNoFields'

		match self.signatures.structFor(typeName, readerFilePath: self.job.path) 'declared'
			declared(layout) then return layout
			undeclared then panic("enclosingLayout: `type {String.from(self.enclosingTypeName())}` is being parsed right now, but the declaration sweep never recorded it — `recordScannedType` and `parseTypeDeclaration` disagree about what opens a type declaration")
		end 'declared'
	end 'enclosingLayout'

	// ⭐ **THE RECEIVER'S SSA VALUE — READ BACK, NEVER ASSUMED.** It is parameter 0, so it is
	// ValueId 0; but that is a CONSEQUENCE of the Std-ABI seeding `parseFunction` performs
	// (`ValueIdRef.create(paramCount)` reserves 0..paramCount-1 and `bindParameters` binds
	// parameter `i` to id `i`), not an independent fact. A literal `0` here would be that
	// convention written down a second time, in the one place that would keep compiling — and
	// silently reading the wrong value — the day the seeding changed.
	//
	// **IT IS ALSO THE ONE PLACE `self` IS REFUSED WHERE THERE IS NO RECEIVER**, because that is
	// the same question: the receiver is bound iff `parseFunction` pushed one, so a failed lookup
	// IS "this is not an instance method". A `static function` is the interesting case — it has an
	// enclosing type but no instance — and file scope has neither. Both report here, positioned,
	// rather than reaching `enclosingLayout` and panicking on an enclosing type that is absent or
	// irrelevant.
	function requireReceiverValue(anchor Token) returns ValueId throws SourceParseError
		// The existence question first, so the two arms below can be a straight dispatch: whichever one
		// answers, the other is provably empty, and there is no third outcome to invent a sentinel for.
		try self.requireReceiverInScope(anchor)

		// ⭐⭐ **INSIDE A CLOSURE THE RECEIVER IS A CAPTURE, AND IT IS THE ORDINARY ONE.** A lifted closure has
		// no receiver of its own — its ValueId 0 is its first PARAMETER — so the enclosing `self` reaches the
		// body the way every other enclosing binding does: one env slot holding the receiver POINTER, read
		// back with one `loadIndirect`. Captured under `SelfParamName`, which is what makes ALL THREE
		// spellings share it: `self.x`, a bare self-field name (`parseSelfFieldRead`) and `self.m(…)` each
		// resolve the receiver through this door, `captureSlotFor` dedupes by name, so a body naming four
		// fields still allocates ONE slot.
		//
		// Before this, the gate here REFUSED the capture — and the refusal was load-bearing, because the
		// enclosing scope is still visible from a closure body: a `lookupValue(SelfParamName)` that reached
		// past it would hand back ValueId 0 and read the closure's own first parameter as a struct box.
		// MEASURED then: `apply(function(k int) gives k + n, x: 1)` inside a method of a `type Counter` with
		// `n = 3` returned **25** — the box pointer's low byte — with no diagnostic anywhere. That cannot
		// arise now for the reason it never arose for an ordinary capture: the closure's OWN scope is fresh
		// and binds no `__self`, so the receiver is found in the enclosing scope or nowhere, and the value it
		// yields is the env load rather than an id from a different function's SSA space.
		match self.captureScopeOf(SelfParamName) 'capturedReceiver'
			found(_, frame) then return try self.emitCaptureRead(SelfParamName, enclosing: self.capturedFrame(frame).scope, frame: frame, anchor: anchor)
			notCaptured then break
		end 'capturedReceiver'

		return try self.bodyState.scope.lookupValue(SelfParamName) otherwise panic("requireReceiverValue: `requireReceiverInScope` passed and no enclosing scope captured the receiver, so it is bound in this function's own scope — but `lookupValue` missed it. The two are reading one `Scope` and disagree.")
	end 'requireReceiverValue'

	// ⭐ **IS THERE A RECEIVER HERE AT ALL — bound as this function's own parameter 0, or reachable as a
	// CAPTURE of the enclosing method's?** The one home of that rule and of the E2001 it raises, asked by
	// `requireReceiverValue` before it resolves and by `parseSelfPrimary` before it splits on the token
	// after `self`.
	//
	// ⚠ **`parseSelfPrimary` NEEDS THE CHECK WITHOUT THE VALUE, and that is why this is separate.** Its
	// two dotted arms re-resolve the receiver for themselves (`parseMethodCall` from the cursor,
	// `parseExplicitSelfFieldRead` after consuming the field token), so resolving it up front would emit a
	// SECOND env load inside a closure body that nothing reads. Outside a closure the same call was free —
	// which is why the split only became necessary when the capture landed.
	function requireReceiverInScope(anchor Token) throws SourceParseError
		if self.nameBindsOrIsCaptured(SelfParamName) 'haveReceiver'
			return
		end 'haveReceiver'

		throw SourceParseError.selfOutsideInstanceMethod(anchor.line, column: anchor.column)
	end 'requireReceiverInScope'

	// ⭐ **E3014 — A FIELD NOT DECLARED `export` IS REACHABLE ONLY FROM ITS TYPE'S DECLARING DIRECTORY
	// SUBTREE** (`specs/field-visibility-is-directory-scoped.md`). The gate is the type's directory, never
	// the reading body's type: another type, a free function and an `extension` written there all reach it.
	//
	// **ONE HOME, TWO CALLERS** — the field READ and the field WRITE. It is one rule; written at
	// both sites, a future answer to what "accessible" means taught to one and not the other would let
	// an unexported field be WRITTEN where reading it correctly reports. An accepted access that should
	// have been refused is a wrong answer, not a compile error.
	//
	// ⚠ **IT IS NOT ASKED AT THE STRUCT-LITERAL SITE, AND THE REASON IS THE SPEC'S, NOT E3076'S.**
	// Initialization is exempt outright: *"All fields (exported or not) can be initialized in struct
	// literals, since the type itself determines what fields exist. The visibility only affects access
	// after construction"* (specs/export-var-fields.md). In the compiler that exemption is VACUOUS today —
	// E3076 already refuses every literal written outside its own type's body, so no out-of-type
	// literal survives to ask — but it is the SPEC's rule that makes the absence correct rather than
	// merely unreachable, and it is written here so the day E3076 relaxes does not silently take the
	// exemption with it.
	//
	// `fieldReach` (MemberReach.maxon), which the language server asks too, owns the refusal order: the
	// raw surface, then the TYPE's own tier — a type this file may not name hides every field, whatever
	// the field's own tier says — then the field's tier.
	function requireFieldAccessible(layout StructLayout, index FieldIndex, fieldTok Token) throws SourceParseError
		let typeReachable = self.membersReachable(layout.name, visibility: layout.visibility, declFilePath: layout.declFilePath)

		match fieldReach(self.signatures, layout: layout, index: index, readerFilePath: self.job.path, rawSurfaceRefused: self.rawSurfaceIsRefusedHere(), typeReachable: typeReachable) 'reach'
			reachable then return
			rawSurface(door) then throw self.rawSurfaceRefusal(door, anchor: fieldTok)
			typeHidden(tier) then throw hiddenMembersRefusal(layout.name, visibility: tier, memberTok: fieldTok)
			tierHidden then throw SourceParseError.unexportedFieldAccess(String.from(layout.name), fieldName: String.from(fieldTok.value), line: fieldTok.line, column: fieldTok.column)
		end 'reach'
	end 'requireFieldAccessible'

	function requireMembersReachable(typeName ByteArray, visibility Visibility, declFilePath FilePath, memberTok Token) throws SourceParseError
		if not self.membersReachable(typeName, visibility: visibility, declFilePath: declFilePath) 'typeHidden'
			throw hiddenMembersRefusal(typeName, visibility: visibility, memberTok: memberTok)
		end 'typeHidden'
	end 'requireMembersReachable'

	function requireInterfaceMembersReachable(interfaceName ByteArray, memberTok Token) throws SourceParseError
		if self.signatures.interfaceMap().namesALibraryProtocol(interfaceName) 'aSynthesizedProtocol'
			return
		end 'aSynthesizedProtocol'

		match self.signatures.interfaceDeclarationOf(interfaceName) 'declared'
			declared(_, visibility, declFilePath) then try self.requireMembersReachable(interfaceName, visibility: visibility, declFilePath: declFilePath, memberTok: memberTok)
			undeclared then panic("requireInterfaceMembersReachable: a value is held at the interface '{String.from(interfaceName)}', which no file declares and which is no synthesized protocol — an interface-typed value is only minted for a name the declaration sweep recorded")
		end 'declared'
	end 'requireInterfaceMembersReachable'

	function requireMethodReachable(func IrFunction, typeName ByteArray, visibility Visibility, declFilePath FilePath, methodName ByteArray, anchor Token) throws SourceParseError
		if self.membersReachable(typeName, visibility: visibility, declFilePath: declFilePath) or self.signatures.interfaceSurfaceGrantsCall(func.name, callee: qualifiedMethodName(typeName, methodName: methodName)) 'reachable'
			return
		end 'reachable'

		throw hiddenMembersRefusal(typeName, visibility: visibility, memberTok: anchor)
	end 'requireMethodReachable'

	// Inside a generic instance, a call the language makes over a value of a bound type argument
	// (interpolation's conversion, struct `==`/`<`, `for`'s protocol calls) is judged for the instantiating
	// caller, who supplied the type and could name it; so a generic in another file accepts the caller's
	// unexported type. Only struct and enum arguments count: a ranged alias's name can equal a nominal's.
	// A caller answered `true` still records the member-access credit, or E3092 tells it to drop an
	// `export` the instantiation needs.
	function reachedOnTheInstantiatorsBehalf(typeName ByteArray) returns bool
		for argument in self.genericBindings.bound 'eachBoundArgument'
			if argument.denotesNominalType() and argument.name.equals(typeName) 'aSuppliedType'
				return true
			end 'aSuppliedType'
		end 'eachBoundArgument'

		return false
	end 'reachedOnTheInstantiatorsBehalf'

	function requireMembersReachableToTheLanguage(typeName ByteArray, visibility Visibility, declFilePath FilePath, memberTok Token) throws SourceParseError
		if self.reachedOnTheInstantiatorsBehalf(typeName) 'suppliedByTheCaller'
			self.recordMemberAccessedTypeName(typeName)
			return
		end 'suppliedByTheCaller'

		try self.requireMembersReachable(typeName, visibility: visibility, declFilePath: declFilePath, memberTok: memberTok)
	end 'requireMembersReachableToTheLanguage'

	function requireImplicitMethodReachable(typeName ByteArray, methodName ByteArray, anchor Token) throws SourceParseError
		if self.reachedOnTheInstantiatorsBehalf(typeName) 'suppliedByTheCaller'
			self.recordMemberAccessedTypeName(typeName)
			return
		end 'suppliedByTheCaller'

		match self.signatures.nominalTypeNameIn(typeName) 'declared'
			declared(_, visibility, declFilePath) then try self.requireMethodReachable(self.bodyFunction(), typeName: typeName, visibility: visibility, declFilePath: declFilePath, methodName: methodName, anchor: anchor)
			undeclared then panic("requireImplicitMethodReachable: an implicit `{String.from(methodName)}` call is lowered onto '{String.from(typeName)}', which declares no type — every caller names the type the call resolves its callee against")
		end 'declared'
	end 'requireImplicitMethodReachable'

	function membersReachable(typeName ByteArray, visibility Visibility, declFilePath FilePath) returns bool
		if not self.namesEnclosingType(typeName) 'aReaderOutsideTheType'
			self.recordMemberAccessedTypeName(typeName)
		end 'aReaderOutsideTheType'

		return self.signatures.isVisibleFrom(visibility, declFilePath: declFilePath, readerFilePath: self.job.path)
	end 'membersReachable'

	// ⭐ **A MOVED-FROM BINDING IS DEAD AT EVERY USE, AND THIS IS THE ONE PREDICATE THAT SAYS SO.** Its
	// owned heap value was transferred to another binding by a `let u = t` / `s = t` whose RHS was a
	// bare reference to it (`poisonMoveSource` set `movedFrom`), so the value now belongs to that new
	// owner and any further USE of the source — a bare read, a field read or write THROUGH it, a method
	// call ON it — is use-after-move (E3102), anchored on the USE token. Only a FULL reassignment
	// `t = <expr>` revives it (`reassignBindingValue` clears the bit); a field store `t.x = …` is itself
	// a use of `t`, not a revive of it, so it must route through here and NOT through the reviving path.
	//
	// ⭐ **ONE HOME, TWO ENFORCING CALLERS**: the bare read (`parseVariableReference`) and every base of
	// a `.` — field read (`parseFieldAccess`), field write (`parseFieldAssignment`) and method receiver
	// (`parseMethodCall`), which ALL funnel through `requireStructBase`. Written at only the bare read,
	// a moved-from struct read or written through its fields was an UNCHECKED use-after-move: `let q = p`
	// then `p.x = 99` mutated `q`'s aliased box and `return q.x` returned 99 — a wrong answer for a
	// program that must be rejected. The rule cannot be split across use sites: a site
	// taught it beside a site not taught it IS that bug, and it is the same "one predicate, one enforcing
	// home" the move gate itself is written to.
	//
	// ⭐⭐ **AND IT ENFORCES A SECOND, MORE SPECIFIC RULE AT THE SAME CHOKEPOINT: a name whose GREEN
	// THREAD has been consumed is dead too (E3142).** The two are separate facts and both belong here, because
	// both are answers to "may this name be used?" and the caller set is identical. They differ in what they
	// are keyed on, and that difference is forced: a move is about a BINDING (which one owes the drop), a
	// consume is about a VALUE (which thread the runtime took back) — and a promise ALIASES rather than moves,
	// so an alias has no binding-level bit for the first rule to set.
	//
	// A SELF-FIELD ALIAS is EXCLUDED: a bare `count` inside a method reads a fresh `loadIndirect` through
	// the receiver rather than aliasing an owned value, so it is never moved-from (`poisonMoveSource`
	// gates on `rhsWasBareLocalReference`, which excludes self-fields). `parseVariableReference` routes
	// self-fields away before it reaches this guard; the exclusion here is what keeps the guard safe on
	// the struct-typed self-field base that DOES reach `requireStructBase` (which materializes it
	// rather than refusing it, so the guard runs on the alias for real and not merely on its way to an error).
	function requireBindingLive(binding VarInfo, nameTok Token) throws SourceParseError
		// The one chokepoint every USE of a local binding funnels through — the bare read, a field read or
		// write through it, a method call on it. Written BEFORE the move guard: a self-field alias and a
		// scalar binding are uses too, and the guard's exclusions are about a MOVE, not about whether the
		// name was read.
		// Before the move guard: a refused read of a moved binding still records where it moved.
		if self.job.recordsEditorFacts 'anEditedDocument'
			self.noteEditorBinding(binding, line: nameTok.line, column: nameTok.column)
		end 'anEditedDocument'

		binding.lastReadToken = self.pos

		// ⭐ **E3012's EVIDENCE, WRITTEN AT THE SAME CHOKEPOINT AND FOR THE SAME REASON.** "Was this name
		// read?" is the question this routine already exists to be the single home of; the unused check asks
		// it of the whole function instead of of one moment (see `VarInfo.referenced`). Written before the move
		// guard for the reason the block above is.
		self.markBindingReferenced(binding)
		self.noteReadOfKeptArgument(binding, nameTok: nameTok)

		if self.trackedLetCasts() 'someLetIsACast'
			self.noteLocalLetCastRead(binding, nameTok: nameTok)
		end 'someLetIsACast'

		try self.requireNotLentToACoroutine(binding, nameTok: nameTok)
		try self.requireUnmovedAtUse(binding, nameTok: nameTok)
		self.noteOperandRead(binding, at: self.pos)
	end 'requireBindingLive'

	// ⭐ **THE MOVE GUARD OF ONE USE OF `binding`'s CURRENT RECORD** — every read `requireBindingLive` guards, and a
	// closure's by-value capture (`emitCaptureRead`), which reads the record the binding holds at the literal.
	function requireUnmovedAtUse(binding VarInfo, nameTok Token) throws SourceParseError
		if binding.isSelfField 'selfFieldAlias'
			return
		end 'selfFieldAlias'

		// ⭐⭐ **A SPENT GREEN THREAD IS REFUSED BEFORE ANYTHING ELSE ABOUT THE BINDING IS ASKED (E3142).**
		// `await`/`try await`/`.cancel()` hand the thread's struct back to the scheduler, so ANY later use of a
		// name that still spells it reads memory the free list owns. The question is asked of the VALUE and not
		// of a bit on this binding, because a promise ALIASES: `let q = p` enrols no second owner, and there is
		// no `q` to poison — the ONE record against the thread's `ValueId` answers for `p` and `q` alike.
		//
		// ⚠ **AND IT IS ASKED ABOVE THE SCALAR ESCAPE, SO A SCALAR-TAGGED REPLY CELL'S POISON IS NOT SWALLOWED.**
		// A reply cell tagged `ValueTypeTag.integer` would take the escape below and swallow its poison
		// whole, and `services.error.use-after-await-of-a-reply` would COMPILE and exit 8. The cell is typed
		// `Promise with (T, E)` and does not take that escape by tag — the ORDER stands on its own
		// merit, stated in the paragraph below.
		//
		// ⚠ **AND MORE SPECIFIC THAN THE `movedFrom` REFUSAL BELOW, WHICH IS WHY IT IS ABOVE IT TOO.** E3102
		// says the value's ownership "moved to another binding" — true of a move, and false of a consume, where
		// the thread went to the RUNTIME and no binding has it. Both refuse the program; only one describes it.
		//
		// ⚠ **A THIRD KIND REACHES NEITHER TEST ON PURPOSE.** A read retired because a SIBLING read of its
		// slot was consumed had nothing done to it, so both sentences here would be false of it; it is
		// refused at the door it is carried to, where the message can name the slot.
		let consumedBy = self.bodyState.promiseConsumes.kindOf(binding.boundValue)

		if promiseConsumeNamesADoor(consumedBy) 'threadAlreadyReclaimed'
			throw SourceParseError.promiseAlreadyConsumed(String.from(promiseConsumeDoorName(consumedBy)), line: nameTok.line, column: nameTok.column)
		end 'threadAlreadyReclaimed'

		// ⭐ **A SCALAR-VALUED BINDING IS ALWAYS SAFE TO READ.** `movedFrom`/`partiallyMoved`
		// forbid a read because a MOVED HEAP value now belongs to another owner; a scalar is never moved that
		// way, so a move bit on a scalar-valued binding means something else entirely.
		//
		// ⛔ **IT DOES NOT ADMIT A PROMISE, AND "A PROMISE HANDLE IS INTEGER-TAGGED" IS NOT A REASON TO.** A spawn's
		// handle is typed at the interned `Promise with (T[, E])`, and a service reply cell is typed the same way,
		// so an integer tag would let this escape swallow a poison in silence. So
		// the escape excludes a promise explicitly, off the `markValuePromise` column that EVERY road
		// minting one writes — derived from the roads rather than from a list of them.
		//
		// ⚠ **NO ROAD MINTS A SCALAR-TAGGED PROMISE, AND THE CLAUSE STAYS.** So
		// the clause guards nothing that exists — which is exactly what it is for: it is one
		// dense-column read (measured below), and the alternative is a silent hole the next road to mint one
		// falls into.
		//
		// What remains is the case the arm is about: a binding rebound to a value owning nothing — a
		// promise binding REASSIGNED to a bare scalar (`p = 5`), or a binding handed a deferred value —
		// whose `movedFrom` means "owns nothing droppable" rather than "was moved from". A merged binding
		// with an unresolved incoming (`unresolvedMergeValues`) is admitted too, so it is not judged for
		// moves.
		// `rebindToAValueOwningNothing` re-points `boundValue` BEFORE setting that bit, so the binding
		// asked about here is no longer a promise and the escape still admits it.
		// ⚠ **THE MARK (`valueOwnsGreenThread`) AND NOT THE WIDER `valueIsPromise`, AND THE DIFFERENCE IS ONE
		// ALLOCATION PER SCALAR READ.** `valueIsPromise` is `valueOwnsGreenThread(v) or typeIsPromiseStorage(…,
		// typeOf(v))`, and `typeOf` CONSTRUCTS a `MaxonType` — a union case, which is a heap
		// object even when it carries no payload. This line is reached on every read of every
		// `int`/`bool`/`float` binding in every program, so that second disjunct minted one MaxonType per
		// scalar read.
		//
		// ⭐⭐ **AND IT COULD NEVER ANSWER TRUE HERE, so asking the narrow one changes no program.** The two
		// disjuncts are MUTUALLY EXCLUSIVE at this line: `typeIsPromiseStorage` is false for anything whose tag
		// is not `genericInstance`, `typeOf(v)` carries `tagOf(v)` as its tag, and this line only runs
		// once `tagOwnsNoHeapValue` has said that tag IS `integer`/`boolean`/`float`. So a promise reaching the
		// escape would wear a SCALAR tag, and the mark is the one column that records such a mint whatever
		// road makes it. A promise read back out of a container carries the `Promise with (T[, E])` type,
		// is therefore a `genericInstance`, and never reaches this line at all: it falls through to the move
		// checks below, which is where a value this frame does not own belongs.
		//
		// ⚠ **THE WIDER PREDICATE IS NOT NEEDED FOR THAT CONTAINER CASE, because the case cannot occur**
		// — a value cannot be scalar-tagged and instance-typed at once, because the type is DERIVED
		// from the tag.
		//
		// MEASURED, control vs changed on the scale ladder, same binary path and one session: the
		// `valueIsPromise` spelling cost **+8,176 allocations at the smallest size rising to +173,953 at the largest**
		// (x1.65 x1.79 x1.88 x1.94 x1.97 — linear, a per-read constant, +0.37% of the compile at the largest size);
		// the mark spelling costs a dense-column read and the ladder returns to the control's numbers.
		if (tagOwnsNoHeapValue(self.tagOf(binding.boundValue)) or self.valueIsDeferred(binding.boundValue) or valueIsMarked(self.bodyState.unresolvedMergeValues, value: binding.boundValue)) and not self.valueOwnsGreenThread(binding.boundValue) 'scalarBinding'
			return
		end 'scalarBinding'

		// Both move states are dead at every read. `movedFrom` (a `let u = t` / `s = t` handed the value
		// to another binding) and `partiallyMoved` (a binding-match moved a managed payload OUT of this
		// union, nulling its slot) differ only in whether the binding still owes a DROP — a use is
		// forbidden for both, and this is the one predicate that says so.
		if binding.movedFrom or binding.partiallyMoved or promiseConsumeMovedItToAnotherOwner(consumedBy) 'moved'
			throw self.movedBindingRefusal(binding, nameTok: nameTok)
		end 'moved'

		self.noteHeaderRead(binding.moveStateValue(), nameTok: nameTok)
	end 'requireUnmovedAtUse'

	function noteHeaderRead(value ValueId, nameTok Token)
		for scan in self.bodyState.loopScans 'eachLoop'
			if scan.tracksValue(value, mergedBindingValues: self.bodyState.mergedBindingValues) and not scan.headerReads.contains(value) 'theFirstReadOfTheHeaderValue'
				scan.headerReads.upsert(value, value: HeaderRead.create(nameTok.value.clone(), line: nameTok.line, column: nameTok.column))
			end 'theFirstReadOfTheHeaderValue'
		end 'eachLoop'
	end 'noteHeaderRead'

	// The box `binding` denotes and the `StructLayout` describing it — the two-step every field
	// access takes: the binding's declared type must BE a struct, and that struct must be one some
	// file declares.
	//
	// The second step cannot fail for a `structRef` the parser itself minted (it interned the id from
	// a name the sweep had already recorded), so it panics; the first very much can — `let n = 5`
	// then `n.x` — and reports. `baseTok` is only the token those diagnostics point at.
	//
	// ⭐⭐ **IT IS THE ONE READER OF A BASE BINDING'S BOX, AND THAT IS WHY IT RETURNS THE BOX AND NOT
	// JUST THE LAYOUT.** A SELF-FIELD ALIAS HAS NO SSA VALUE: `createSelfField` leaves
	// `boundValue` 0 because a read of the alias is a `loadIndirect` through the receiver, not a
	// reference to a value — **and ValueId 0 IS THE RECEIVER**. So a caller that proved the layout
	// here and then reached for `binding.boundValue` on its own silently addressed `__self`. What this
	// door hands back is `baseBoxOf`'s answer, which is that `loadIndirect` for an alias and the
	// binding's own value for everything else.
	//
	// That is not a hazard this comment is imagining; it was MEASURED, on the three sites that did
	// exactly that. In a self-referential `type Node` (`var next as Node`, which
	// `parseTypeReference` types `structRef` through its `namesEnclosingType` arm):
	//   • `return next.a`      compiled to a single `loadRegBaseDisp r8, [rcx + 0]` — that is
	//                          `return self.a`, off the receiver, at the wrong field's offset.
	//   • `return next.readA()` compiled to a bare `callDirect Node.readA` with NO argument setup —
	//                          the receiver was already in `rcx`, so it is `self.readA()`.
	//   • `next.a = 99`        reported E2013 "cannot assign to immutable variable: 'next'", which
	//                          is simply false of an `export var` field.
	// The first two exit 0 with no diagnostic anywhere. `parseVariableReference` guards this same
	// fact for the bare-name path and its comment states it exactly; the fact was written down
	// once and needed in four places. Handing the box back from here is what makes the other three
	// unable to get it wrong.
	function requireStructBase(binding VarInfo, baseTok Token) returns StructBase throws SourceParseError
		// The base binding must be LIVE before anything about it is resolved — a moved-from base is dead,
		// so `p.x`, `p.x = …` and `p.m()` on it are use-after-move (E3102), reported here at the base
		// token before the field/method is even looked up. This is the shared guard's second enforcing
		// home; `parseVariableReference` is the first. See `requireBindingLive`.
		try self.requireBindingLive(binding, nameTok: baseTok)

		// A struct box OR a generic INSTANCE (`Sizer with bool`) can be a method/field base — both
		// resolve to a struct layout (the instance's base struct, its methods compiled once against the
		// opaque `T`). Every other tag has no fields.
		let baseTag = maxonTypeTag(binding.varType)
		let baseTypeNameId = typeNameIdOf(binding.varType)

		if not self.tagCarriesStructLayoutHere(baseTag) 'notAStruct'
			// ⚠ **A TYPE THE PROGRAM DOES NOT HAVE IS NOT "declared 'int'", AND IT IS NOT THIS ACCESS'S
			// FAULT EITHER** — asked BEFORE the not-a-struct refusal below, because a name that denotes
			// nothing has no struct-hood to be wrong about. See `requireDeclaredBaseTypeName`.
			try self.requireDeclaredBaseTypeName(baseTag, nameId: baseTypeNameId, tok: baseTok)

			throw SourceParseError.unsupported("a field access on '{String.from(baseTok.value)}', which is declared '{typeTagName(baseTag)}' and not a struct type (only a struct has fields)", line: baseTok.line, column: baseTok.column)
		end 'notAStruct'

		// ⚠ **A STRUCT-TYPED FIELD USED AS A BASE IS MATERIALIZED, AND REFUSED ONLY WHEN NO VALUE OF ITS
		// TYPE COULD EXIST** — `inner.x` inside `type Outer`'s own method loads the field's box out
		// of the receiver and addresses THAT; `next.a` inside `type Node` is still E2015, because
		// `var next as Node` closes a cycle and no program can put a `Node` there to observe the load
		// being right. That is the `mintPhi` trap, and it is the whole of what the refusal is
		// arguing for — see `requireConstructibleSelfFieldBase`, which the METHOD door asks too.
		//
		// ⚠ **THE ARM STAYS BELOW THE `structRef` GATE, and moving it above is the tidy-looking edit that
		// is wrong.** A SCALAR field's alias (`count.x`, where `count` is an `Integer`) is not a struct
		// base either, but it is not a struct-typed field and must not be told it is;
		// `self-field-struct-typed.md`'s `error.scalar-field-base-is-not-a-struct` goes red on exactly
		// that reordering while the cycle cases stay green.
		if binding.isSelfField 'structTypedField'
			try self.requireFieldAccessible(try self.enclosingLayout(baseTok), index: binding.fieldIndex, fieldTok: baseTok)
			try self.requireConstructibleSelfFieldBase(baseTag, nameId: baseTypeNameId, fieldName: baseTok.value, anchor: baseTok)
		end 'structTypedField'

		// The layout is proved BEFORE the box is loaded, so a base this door is going to refuse emits no op
		// — `structLayoutOfType` can still throw for a generic instance whose base carries no layout of
		// its own.
		let layout = try self.structLayoutOfType(BaseAccessKind.field, tag: baseTag, nameId: baseTypeNameId, baseTok: baseTok)

		let box = try self.baseBoxOf(binding, baseTok: baseTok)

		// ⚠⚠ **NEITHER NAME COLUMN OF THE RECORD HAS A READER ON THIS DOOR'S PATH, AND THAT IS A PROPERTY OF
		// THE TWO CALLERS RATHER THAN AN OMISSION — CENSUSED.** `resolveFieldChain` and
		// `resolveGlobalFieldChain` take only the box and the layout off the `StructBase`; `immutableName`'s
		// ONE reader is `dispatchMethodOnBase`, and the only producers that reach it are
		// `structBaseOfReceiver` and `capturedStructBase`, never this one. **Do not read either column here
		// without moving its derivation** — a field CHAIN answers both questions elsewhere
		// and HAS to: its E3207 blame name is `parseFieldChainCall`'s `fieldChainImmutableNameAt`, its storage
		// subject that same call's `storageSubjectNameAt`, and its WRITE permission `parseFieldAssignment`'s
		// `requireWritableInstance`, asked of the binding `resolveFieldChain` threads on. All three are keyed
		// on the base's TOKEN INDEX or on that binding, because only those can tell a `self`-rooted chain's
		// FIELD subject from the receiver; a name answered from HERE could not, which is the whole reason
		// `subjectName` is empty rather than derived.
		//
		// ⚠ `immutableName` is still filled with the TRUE answer instead of that same empty, and the
		// asymmetry is deliberate: `EmptySourceText` in THAT column MEANS "writable" (`immutableReceiverNameOf`),
		// so a future reader would be told the permissive thing by a door that never asked. Asking the
		// MATERIALIZED binding is what keeps the value right if one ever arrives — every self-field alias is
		// built `BindingKind.let` and is not a parameter, so asking the ALIAS would report "immutable" against
		// an `export var` field, the false E3207 `baseBoxOf`'s header measures.
		return StructBase.create(layout, box: box, immutableName: self.immutableReceiverNameOf(try self.baseBindingOf(binding, baseTok: baseTok, box: box), baseTok: baseTok), subjectName: StorageSubject.none)
	end 'requireStructBase'

	// The `StructLayout` a struct-typed (tag, nameId) pair names — the guarded layout half of
	// `requireStructBase`, keyed on the TYPE rather than on a binding so all three base resolutions share it:
	// a local binding (`requireStructBase`), a CAPTURED base (whose box is the value read out of the env, not
	// `binding.boundValue` — `resolveCapturedFieldChain`), and a VALUE receiver bound to no name at all
	// (`structBaseOfReceiver`). Assumes the `structRef`/`genericInstance` gate above already held.
	//
	// ⭐ **THE TWO TAGS THAT GATE REACH HERE DIFFER IN WHETHER A MISSING LAYOUT IS POSSIBLE, AND THAT IS THE
	// WHOLE OF THIS FUNCTION.** A `structRef` was interned by the parser itself from a name the declaration
	// sweep had already recorded, so its layout cannot be absent and an absence is an invariant break — it
	// panics. A `genericInstance`'s base is whatever a `with` NAMED, and the instance is interned for it
	// either way, so a missing layout is an ordinary property of a program a user can write and must be a
	// positioned diagnostic. Both were one panic, and both were reachable: `arr.managed` on an `Array with
	// Int` and `t.foo` on a parameter typed `Nonexistent with Int` each died with a stack trace and no
	// `error E….` at all.
	//
	// ⇒ So the two tags do not ask the same question, and only the `structRef` half may ask `structOf`. The
	// instance half asks the SAME walk gate the four `SignatureIndex` field walks open with, for the reason
	// the gate below states: a name being declared is not the same fact as this instance's fields living
	// there, and where they came apart the compiler read a heap pointer out as user data.
	function structLayoutOfType(access BaseAccessKind, tag ValueTypeTag, nameId TypeNameId, baseTok Token) returns StructLayout throws SourceParseError
		let typeName = self.baseStructNameOfType(tag, nameId: nameId, baseTok: baseTok)

		// ⚠⚠ **AN INSTANCE ASKS `genericInstanceHasBaseLayout`, NEVER `structOf` ALONE — THE TWO DISAGREE,
		// AND THE DISAGREEMENT IS MEMORY-UNSAFE.** They answer different questions: `structOf` says "is a
		// type of this NAME declared anywhere", the gate says "does THIS INSTANCE have a layout its fields
		// actually live at". For a BUILTIN base they part company the moment a program writes `type Array
		// uses T` — the declaration registers, so `structOf` hands back ITS field table, while the VALUE in
		// hand is the runtime's synthesized 48-byte record, because every other door (`create`, the method
		// router, `genericInstanceBoxSize`, `genericInstanceBoxDropCallee`) is already routed to the builtin
		// by `isArrayInstance`. The field offsets then address the record, and MEASURED, with no diagnostic
		// anywhere and a compile that exits 0: `a.value` on an `Array with Integer` printed 7077984 — the
		// element buffer POINTER read as an Integer — and `a.value = 4242` overwrote that pointer, taking an
		// access violation (0xC0000005) in the teardown. `Set` hands out its record's count the same way.
		//
		// So the walk gate is the ONE door here too, exactly as it is at the four `SignatureIndex` walks: an
		// instance whose base has no layout OF ITS OWN never reads fields, whoever else declares the name.
		//
		// ⭐⭐⭐ **EXCEPT FOR THE ONE SHAPE WHERE THE DECLARATION *IS* THE RECORD, AND THAT IS NOT A WEAKENING —
		// IT IS THE OTHER HALF OF THE SAME ARGUMENT.** The paragraph above refuses a declared `Array`
		// because `structOf` hands back a field table the VALUE does not have. `declarationIsTheManagedRecord` is
		// exactly the test for the case where it does: the base is `Array`, the declaration has ONE field, and
		// that field is the buffer — so field 0 at offset 0 IS the record, which is why `emitFieldLoad`'s
		// inline-`managed` arm already answers it with the surface flip rather than a load. A second field is
		// what makes the two disagree, and that declaration is refused at construction
		// (`requireBufferIsItsOwnRecord`) rather than admitted here.
		//
		// ⚠⚠ **THIS DELIBERATELY DOES *NOT* MOVE `genericInstanceHasBaseLayout` ITSELF, AND THAT CHOICE WAS
		// MEASURED RATHER THAN ARGUED.** The corpus fall-through and that gate are NOT one change, although the
		// gate also decides the FIELD WALK the drop cascade reads: widening the gate to admit a declared `Array` base
		// was **INERT**, 551 `--filter=array` cases, 0 failures. The reason is that the walk it opens
		// would enumerate exactly ONE field, the buffer, whose drop callee is `__managed_decref` — the very callee
		// `genericInstanceBoxDropCallee` already gives the record itself — and both cascade readers filter a
		// non-`__destruct_` leaf out (`MmRuntime.addNestedInstanceDestructors`, `declareInstanceFieldDropNeeds`).
		//
		// ⇒ So the gate is not what refuses the member, and moving it buys nothing to offset its REACH: it
		// is read by four `SignatureIndex` field walks and by every caller of this function, including the
		// WRITE path and the field-chain walk. The two are the preconditions of two different queries — a
		// layout to NAME a member, and a layout to ENUMERATE fields — exactly as that gate's own header says of
		// its neighbour, so the admission is spent at the one door that needs it and nowhere else.
		// ⚠ **THE SIZED CONTAINER IS ADMITTED BY THE SAME ARGUMENT AS THE ARRAY RECORD** — with
		// `stdlib/FixedArray.maxon` listed, a `FixedArray`'s ONE declared field IS the record, so `structOf` and the
		// value agree about it exactly as they do for `Array`. **MEASURED without this: 375 cases refused at
		// `stdlib/Interfaces.maxon:229`'s `self.createIterator()` inside `extension Iterable`, with
		// `missingBaseLayout`'s *"the compiler reads no stdlib"* sentence — a refusal whose every clause had stopped
		// being true for this type the moment the module was listed.**
		if tag == ValueTypeTag.genericInstance and not (self.signatures.genericInstanceHasBaseLayout(nameId as GenericInstanceId) or self.signatures.declarationsValueIsTheManagedRecord(typeName)) 'noBaseLayout'
			throw self.missingBaseLayout(access, instance: nameId as GenericInstanceId, typeName: typeName, baseTok: baseTok)
		end 'noBaseLayout'

		match self.signatures.structInAnyFile(typeName) 'declared'
			declared(layout) then return layout
			undeclared then panic("structLayoutOfType: '{String.from(baseTok.value)}' resolves to base struct '{String.from(typeName)}' but no file declares that type — a struct base is only minted for a name the declaration sweep recorded (Parser.parseTypeReference), and an INSTANCE base was gated by genericInstanceHasBaseLayout above")
		end 'declared'
	end 'structLayoutOfType'

	// Which of the three ways a generic instance's base has no `StructLayout` this one is, worded for a reader
	// who needs opposite things from them — the diagnostic half of `ProgramSignatures.genericInstanceHasBaseLayout`,
	// whose header states the split. Only an instance reaches here; a `structRef` with no layout is an
	// invariant break and panics at the call site above.
	//
	// ⭐⭐ **AND IT IS TOLD WHICH ACCESS IT WAS ASKED ABOUT, BECAUSE CALLING EVERY ONE OF THEM A FIELD MISNAMES THE
	// CONSTRUCT.** This door serves BOTH the field walk and the member-dispatch fall-through, and its own
	// neighbour's header records the consequence in so many words — *"a declared `Array.size()` gets as far as
	// `missingBaseLayout` and is refused 'a field access … `Array` is a BUILTIN whose runtime record the compiler
	// synthesizes', about a METHOD"*. A member call reaches it whenever no synthesized surface catches the member first, and
	// `array-declared-record.error.a-conformer-named-for-a-container-that-constructs-nothing-…` MEASURED it:
	// `v.push(5 as Num)` reported as a field access on `v`. A refusal that misnames the construct it refuses
	// sends the reader to look at the wrong line.
	function missingBaseLayout(access BaseAccessKind, instance GenericInstanceId, typeName ByteArray, baseTok Token) returns SourceParseError
		// ⚠ **DO NOT SAY THE FIELD DOES NOT EXIST — IT VERY LIKELY DOES.** The compiler SYNTHESIZES
		// the `Array`/`Set` runtime record instead of compiling the declaration, so no `type` exists here to
		// carry a field table at all — the field is missing from this compiler, not from the language. E2015 —
		// a construct this compiler does not implement YET — is exactly the register that carries, and it is
		// the same one the sibling `n.x` guard above reports in.
		//
		// ⚠ **`Array`'s OWN `managed` FIELD DOES NOT REACH HERE.** It is routed to the array method
		// dispatcher before the field machinery is entered (`arrayManagedFieldAt`), because that field is an
		// IDENTITY on the record rather than a slot inside it. What reaches here is every OTHER field of a
		// synthesized builtin record, for which this refusal is the true answer.
		//
		// The wording names the stdlib file rather than a field, because the two builtins declare DIFFERENT
		// fields (`Array` its `managed`, `Set` its `elements`/`states`/`hashes`) and a message that named one
		// of them would be false about the other.
		if self.signatures.isBuiltinGenericBaseName(typeName) 'synthesizedBuiltin'
			return SourceParseError.unsupported(builtinRecordAccessRefusal(access, typeName: typeName, baseName: baseTok.value), line: baseTok.line, column: baseTok.column)
		end 'synthesizedBuiltin'

		let supplied = self.signatures.genericInstanceArgCount(instance)

		if self.signatures.declaresABaseRefusingTypeArgumentCount(typeName, count: supplied) 'aRefusedArgumentCount'
			return self.genericArgumentCountRefusal(self.signatures.baseLayoutOf(instance), supplied: supplied, baseTok: baseTok)
		end 'aRefusedArgumentCount'

		// The base is not declared AT ALL, so it has no fields and never will under this spelling. The
		// `with` that named it is the actual error and `checkGenericSpellings` reports E2055 against it. This
		// refusal carries that E2055's own text: `Queries.reportedArityMessages` drops it only when a reported
		// message equals it, and otherwise it is the one the user sees.
		return self.undeclaredGenericBaseRefusal(typeName, tok: baseTok)
	end 'missingBaseLayout'

	// The synthesized-record refusal, worded for the access that met it. Two sentences and not one with a noun
	// swapped, because they say genuinely different things: a FIELD is missing from this compiler and can be
	// reached through the members instead, while a MEMBER of a declaration this name also carries is not
	// missing at all — it belongs to a type the value is not. `containerStaticSurfaceSentence`'s per-container
	// router is the same shape for the same reason.
	//
	// ⚠ **NEITHER SENTENCE CLAIMS THE COMPILER READS NO STDLIB.** `stdlib/Array.maxon` and
	// `stdlib/FixedArray.maxon` are both LISTED, so it has read them. What is true is narrower and is what the
	// reader needs: the RECORD is synthesized, so a value of the instance carries that record's words
	// whatever any declaration of the name says.
	function builtinRecordAccessRefusal(access BaseAccessKind, typeName ByteArray, baseName ByteArray) returns String
		return match access 'access'
			field gives "a field access on '{String.from(baseName)}': `{String.from(typeName)}` is a BUILTIN whose runtime record the compiler SYNTHESIZES rather than compiling a declaration for, so a value of it carries that record's own words and not the fields `stdlib/{String.from(typeName)}.maxon` declares. The field is missing from this compiler, not from the language; reach the contents through the methods"
			member gives "a member access on '{String.from(baseName)}': `{String.from(typeName)}` is a BUILTIN whose runtime record the compiler SYNTHESIZES rather than compiling a declaration for, so a `{String.from(typeName)} with …` is this compiler's own instance and its members are the container's — not the ones a `type {String.from(typeName)}` declared here carries. Rename the declaration to reach its own members"
		end 'access'
	end 'builtinRecordAccessRefusal'

	// ⭐⭐ **A MEMBER-ACCESS BASE MAY NOT BE REFUSED IN TERMS OF A TYPE THE PROGRAM DOES NOT HAVE** — the
	// guard the same three doors `structLayoutOfType` above serves stand behind: a local BINDING
	// (`requireStructBase`, serving both the read and the write path), a CLOSURE CAPTURE
	// (`capturedStructBase`) and a VALUE receiver with no binding to name (`structBaseOfReceiver`). It
	// raises `SourceParseError.unknownTypeName` — E3011, the authority's own code and its own wording; see that
	// arm for why a parse-time door must report it at all.
	//
	// It THROWS rather than handing the name back for each door to throw with, so the ask-and-refuse is
	// written once instead of three times and there is no "no undeclared name" value to represent. ⚠ It is
	// deliberately NOT the `throw self.helperReturningAParseError(…)` shape
	// `structTypedSelfFieldBaseMessage`'s header measures as leaking two allocations: nothing returns a
	// `SourceParseError` here, it is constructed and thrown inside, exactly as the sibling `requireBindingLive`
	// does at the top of `requireStructBase`.
	//
	// A failing compile returns from `main` like any other run, so `mm_leak_check` still sees it: it
	// sits on the SINGLE unconditional exit path, takes main's return value as its argument, and
	// returns it unchanged only when the live allocation count is zero. All seven programs that reach
	// this guard exit **1**; two leaked allocations would come back as 101.
	//
	// ⚠ **IT EXISTS BECAUSE ALL THREE DOORS ASSERTED A TYPE THE COMPILER INVENTED.** Each worded its
	// refusal around `typeTagName(<the base's tag>)`, and a `named` tag PRINTS AS `int` (TypeRules'
	// `typeTagName`, whose `named` arm is right for the ranged INT alias it was written for — and wrong for
	// a ranged FLOAT one, which still reads `int` on the DECLARED branch this door leaves alone). So a parameter
	// declared with a name no registry declares was reported as *"'h', which is declared 'int'"* — a
	// statement about the source that the source does not make, and the kind of diagnostic that sends a
	// reader to the wrong line. MEASURED on `function takes(h NoSuchTypeAtAll)` + `return h.v`: all three
	// doors said `int`, in three different sentences. The runnable oracle answers the same program
	// `Unknown type: NoSuchTypeAtAll`, blaming the DECLARATION.
	//
	// ⚠ **THE VERDICT IS THE POINT, NOT A BETTER SENTENCE.** Keeping each door's
	// "a field access on 'h', …" framing and merely swapping the invented type for the real name would
	// leave one fact with a second wording, under E2015, beside the E3011 the authority gives it. One
	// authority, one code, one text, three anchors is the arrangement that cannot drift.
	//
	// ⭐ **IT ASKS `denotedNamedType`, AND ASKING ANYTHING ELSE IS THE WHOLE HAZARD HERE.** A `named` tag
	// covers every spelling `parseTypeReference` settles at parse time and no further — a declared `type`
	// named from OUTSIDE its own body, a declared `enum`/`union`, a ranged int alias, a qualified inner or
	// per-instance alias, five of the six compiler-owned names, and a name nothing declares at all. Only the
	// last is undeclared, and the list of the rest is exactly `denotedNamedType`'s cascade: the ONE place
	// that knows what a `named` type denotes, asked here for the same reason `denotedCastTargetTag` and
	// `checkGenericArgType` ask it, so a member-access base and the resolution pass cannot come to disagree
	// about what a name means. A re-derivation ("is it in the struct registry, the enum registry, …") is how
	// this refusal would come to reject a name the authority accepts — and it would do it by asserting the
	// name is undeclared, which is the very false statement this guard exists to remove.
	//
	// ⚠⚠ **THE `isCompilerOwnedTypeName` GATE IS HERE FOR A NAME THE CASCADE CANNOT ANSWER FOR, AND IT IS
	// WRITTEN OVER THE WHOLE LIST RATHER THAN OVER ONE NAME.** The cascade answers `ExitCode` by its own arm,
	// `HashValue` and `Codepoint` through the alias registry, `Ordering` and `ArrayError` as the enums
	// the corpus declares, and `CharSet` because
	// `stdlib/CharacterSet.maxon:19`'s own `typealias CharSet = Set with Character` folds into
	// `genericAliases` like any other declared alias;
	// `String` and `Character` never arrive here at all, because `parseTypeReference`
	// settles both syntactically and neither ever wears a `named` tag.
	//
	// ⚠ **`CharacterSet` IS NOT A CASE FOR THIS GATE.** `stdlib/CharacterSet.maxon` is listed, so `recordStruct` files
	// the corpus layout under the BARE name and the cascade answers it like any other declared struct;
	// `function hasIt(s CharacterSet, …)` + `s.contains(c)` reports no **`E3011: Unknown type 'CharacterSet'`**.
	// ⇒ **the gate is not load-bearing for THIS name, and it stays for the LIST**: `isCompilerOwnedTypeName`
	// still carries names no registry cascade reaches, and writing the gate as the list rather than as a
	// count keeps it correct when a name moves off it. Deleting it needs a measurement per remaining name.
	//
	// ⇒ **A NAME THE COMPILER RESERVES IS NEVER THE USER'S UNDECLARED NAME**, so this gate cannot swallow a
	// genuine typo: `requireTypeNameNotCompilerOwned` refuses any user declaration that would bind a name on
	// that list, which is what makes "reserved" and "the program's own missing type" disjoint by
	// construction — and it is stated as *the list* rather than as a COUNT of it on purpose. A count is a copy
	// of a list that lives somewhere else, and this file has the rule in so many words one registry over
	// (`BuiltinConformanceRuntime`: no count is written down, because a count is a copy that goes stale).
	// The pre-existing refusal then stands unchanged for the names still on the list, and it is the RIGHT one:
	// a reserved name is real, so reporting it undeclared would be a false statement.
	// ⚠ **THIS GUARD'S LIVE WITNESS IS `field-declared-unknown-type`'s CASE
	// `compiler-reserved-base-type-is-nameable-at-a-parameter`**, which pins that `CharacterSet` IS nameable at a parameter; treat it as the one to redden before touching the gate.
	//
	// ⚠ **NOTHING IS SUBSTITUTED FOR THE BASE'S TYPE — only the throw is the point.** `resolveTypes` erases a
	// `named` signature type and the parser deliberately does not (a `named` value's tag carries the alias
	// NAME the shift rule and the per-instance identity checks read — see `emitFieldLoad`'s header), so
	// resolving the base here would drop both. This is a DIAGNOSTIC query and nothing else.
	//
	// ⚠ **ONLY EVER CALLED ON A PATH THAT IS ALREADY THROWING**, which is what makes it free: it costs a name
	// lookup and a registry cascade per REFUSED member access, never one per field read. It also means it
	// cannot false-reject — the decision to refuse was taken before it was asked, and it only chooses which
	// refusal is reported.
	function requireDeclaredBaseTypeName(tag ValueTypeTag, nameId TypeNameId, tok Token) throws SourceParseError
		if tag != ValueTypeTag.named 'notANamedType'
			return
		end 'notANamedType'

		let name = self.internedName(nameId)

		if isCompilerOwnedTypeName(name) 'compilerReserved'
			return
		end 'compilerReserved'

		// ⚠ **THE ANSWER IS CHECKED RATHER THAN `_ =`-DISCARDED, AND THE REASON IS A BOOTSTRAP RULE, NOT A
		// TASTE.** `denotedNamedType` reads registries and writes nothing, so `buildEffectFreeSummary`
		// calls it PURE — and E3064 refuses `_ = <pure call>` as dead code. This call is not dead: what
		// this site wants is the FAILURE, and the purity rule does not model the `throws` channel (a
		// function that can throw has an observable effect its RETURN type cannot express). It is pure
		// because `splitQualifiedName` does not route through `String.split`.
		//
		// ⭐ So the answer is spent on the ONE claim its own header makes and nothing enforced: that the
		// cascade ERASES — every arm returns `exitCode`, `structRef`, `integer` or a ranged alias's
		// `int`/`float` underlying, and an arm that handed the `named` REFERENCE back would put this routine
		// (and `denotedCastTargetTag`, which reads a tag off the same call) into an unbounded resolve.
		let denoted = try denotedNamedType(self.signatures, name: name, id: nameId, readerFilePath: self.job.path) otherwise throw SourceParseError.unknownTypeName(self.signatures.aliasIdentityDisplay(name), line: tok.line, column: tok.column)

		if maxonTypeTag(denoted) == ValueTypeTag.named 'cascadeDidNotErase'
			panic("requireDeclaredBaseTypeName: `denotedNamedType` answered `named` for '{String.from(name)}' — every arm of its cascade erases to a concrete type or throws, so a `named` answer means a new arm hands its own input back")
		end 'cascadeDidNotErase'
	end 'requireDeclaredBaseTypeName'

	// The BASE struct name a method/field base resolves to: the struct itself for a `structRef`, or the
	// generic instance's base struct for a `genericInstance` (`Sizer with bool` ⇒ `Sizer`) — the
	// SHARED body its methods were compiled once against. The caller's `requireStructBase` has already
	// gated the tag to one of these two.
	function baseStructNameOfType(tag ValueTypeTag, nameId TypeNameId, baseTok Token) returns immutable ByteArray
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.signatures.genericInstanceBaseName(nameId as GenericInstanceId)
		end 'instance'

		// ⭐ A BYTE RECORD carries no name id of its own (`String` and `Character` are their own `MaxonType`
		// arms, not `named`), so its layout is found under the CORPUS's declaration name — which is the one
		// name a declaration of it can wear, since both are on `isCompilerOwnedTypeName`.
		if tag == ValueTypeTag.string 'aString'
			return StringConformerName
		end 'aString'

		if tag == ValueTypeTag.character 'aCharacter'
			return CharacterConformerName
		end 'aCharacter'

		return try self.artifact.typeNames.nameOf(nameId) otherwise panic("baseStructNameOfType: '{String.from(baseTok.value)}' carries a structRef whose name id is not in this file's interner — every structRef the parser mints is interned from a name in the same table")
	end 'baseStructNameOfType'

	// ⭐⭐ **DOES THIS VALUE HAVE A STRUCT LAYOUT *IN THIS PROGRAM*? — `tagCarriesStructLayout` PLUS THE ONE
	// QUESTION A TAG CANNOT ANSWER ON ITS OWN.** A `String`/`Character` is a byte record whose FIELDS
	// exist only when the corpus that declares them is loaded: with `stdlib/String.maxon` listed, `managed`
	// and `singleByteGraphemesFlag` are real fields at real offsets; without it there is no layout and the
	// old refusal is still the right answer. So the admitted set is the static one WIDENED by a lookup,
	// never a second static list.
	//
	// ⚠ **IT DOES NOT WIDEN WHAT USER CODE MAY REACH, AND THAT IS A DIFFERENT GATE'S JOB.** Neither corpus
	// field is exported, so `"abc".managed` outside `type String` is E3014 exactly as any unexported field
	// is — the visibility check runs after this one and is unchanged. What this changes is only WHICH
	// diagnostic an inaccessible field gets, and it moves it from "not a struct type" (false, and useless)
	// to the accurate one.
	function tagCarriesStructLayoutHere(tag ValueTypeTag) returns bool
		if tagCarriesStructLayout(tag) 'staticallyAggregate'
			return true
		end 'staticallyAggregate'

		if not tagIsByteRecord(tag) 'notAByteRecord'
			return false
		end 'notAByteRecord'

		return match self.signatures.structInAnyFile(self.byteRecordLayoutName(tag)) 'corpusDeclaresIt'
			declared gives true
			undeclared gives false
		end 'corpusDeclaresIt'
	end 'tagCarriesStructLayoutHere'

	// The corpus name a byte-record tag's layout is declared under. Split from `baseStructNameOfType` only
	// because that one needs a token to panic with and this one is asked before any error is possible; the
	// two must answer the same, so the second reads the first's two constants rather than restating them.
	function byteRecordLayoutName(tag ValueTypeTag) returns immutable ByteArray
		if tag == ValueTypeTag.character 'aCharacter'
			return CharacterConformerName
		end 'aCharacter'

		return StringConformerName
	end 'byteRecordLayoutName'

	// `loadIndirect <box> <offset>` — the one op a field read is.
	//
	// ⚠ **THE VALUE'S TAG AND THE OP'S `valueType` ARE DELIBERATELY DIFFERENT THINGS**, and reading
	// this as a redundancy is how it would get broken:
	//
	//   • the VALUE is minted with the field's DECLARED type — `named(Integer)` for a ranged alias —
	//     so the tag column keeps what the source said. THE SHIFT RULE reads it (`valueIsUnsigned`
	//     looks the alias's LOW BOUND up by name), so a field of `int(0 to u64.max)` right-shifts
	//     zero-filled, exactly as a PARAMETER of that type does.
	//   • the OP carries the field's STORAGE type — the resolved primitive — because
	//     `maxonTypeToStdType` PANICS on a `named`, and it panics on purpose: an op's type must be
	//     concrete by lowering, and `resolveTypes` rewrites signatures only, never op types.
	//
	// A parameter declared `Integer` already lives with exactly this split (`valueTagToStdType`'s
	// `named` arm exists for it), so this is that arrangement reaching one op further, not a new one.
	function regionRefusal(code ErrorCode, message String, line LineNumber, column ColumnNumber) returns SourceParseError
		return SourceParseError.registryRefused(code, explanation: message, line: line, column: column, note: DiagnosticNote.none)
	end 'regionRefusal'

	function regionFactsForRead() returns RegionFactTable
		match self.bodyState.regionFacts 'state'
			unwritten then return self.anchors.unwrittenRegionFacts
			entries(table) then return table
		end 'state'
	end 'regionFactsForRead'

	function regionFactsForWrite() returns RegionFactTable
		match self.bodyState.regionFacts 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = RegionFactTable.create()
		self.bodyState.regionFacts = RegionFacts.entries(fresh)
		return fresh
	end 'regionFactsForWrite'

	function capabilityOfValue(value ValueId) returns ValueCapability
		return try self.bodyState.valueCapabilities.get(value) otherwise panic("capabilityOfValue: v{value} has no capability slot — every SSA value is minted through mintValue, which seeds the column")
	end 'capabilityOfValue'

	function setValueCapability(value ValueId, capability ValueCapability)
		try self.bodyState.valueCapabilities.set(value, value: capability) otherwise panic("setValueCapability: v{value} has no capability slot — every SSA value is minted through mintValue, which seeds the column")
	end 'setValueCapability'

	function effectiveCapabilityOf(value ValueId) returns ValueCapability
		let facts = self.regionFactsForRead()

		if facts.mergedValues.contains(value) 'joinsTheOpenRegion'
			return self.capabilityOfValue(value)
		end 'joinsTheOpenRegion'

		return capabilityWithinWindows(facts.windows, value: value, intrinsic: self.capabilityOfValue(value))
	end 'effectiveCapabilityOf'

	function valueIsAValueType(value ValueId) returns bool
		return self.valueIsNoRecordAWriteReaches(value) or tagIsByteRecord(self.tagOf(value)) or self.valueIsAnImmutableAggregate(value)
	end 'valueIsAValueType'

	function valueIsASlotRead(value ValueId) returns bool
		return self.regionFactsForRead().fieldOrigins.contains(value)
	end 'valueIsASlotRead'

	function valueIsAnIsolatedSlotRead(value ValueId) returns bool
		if not valueIsMarked(self.bodyState.isolatedPartReads, value: value) and not self.valueIsASlotRead(value) 'neverReadAPart'
			return false
		end 'neverReadAPart'

		return self.isolatedSlotReadGiven(value, capability: self.effectiveCapabilityOf(value), isValueType: self.valueIsAValueType(value))
	end 'valueIsAnIsolatedSlotRead'

	function isolatedSlotReadGiven(value ValueId, capability ValueCapability, isValueType bool) returns bool
		if isValueType 'aValue'
			return false
		end 'aValue'

		return valueIsMarked(self.bodyState.isolatedPartReads, value: value) or (self.valueIsASlotRead(value) and capability == ValueCapability.isolated)
	end 'isolatedSlotReadGiven'

	function valueIsIsolatedRegionData(value ValueId) returns bool
		if self.valueIsAValueType(value) 'aValue'
			return false
		end 'aValue'

		return self.effectiveCapabilityOf(value) == ValueCapability.isolated or valueIsMarked(self.bodyState.isolatedPartReads, value: value)
	end 'valueIsIsolatedRegionData'

	function valueIsAnOwnedIsolatedRegion(value ValueId) returns bool
		return self.valueIsIsolatedRegionData(value) and not self.valueIsAnIsolatedSlotRead(value)
	end 'valueIsAnOwnedIsolatedRegion'

	function noteIsolatedPartRead(value ValueId)
		self.bodyState.isolatedPartReads = withValueMarked(self.bodyState.isolatedPartReads, value: value)
	end 'noteIsolatedPartRead'

	function noteIsolatedPartOrigin(value ValueId, startIndex ElementIndex, endIndex ElementIndex)
		if self.bodyState.isolatedPartOrigins.contains(value) or not self.valueIsAnIsolatedSlotRead(value) 'nothingToCarry'
			return
		end 'nothingToCarry'

		self.bodyState.isolatedPartOrigins.upsert(value, value: IsolatedPartRead.at(self.tokenTextFrom(startIndex, endIndex: endIndex), anchor: self.tokenAt(startIndex)))
	end 'noteIsolatedPartOrigin'

	function noteIsolatedPartReadAt(value ValueId, read IsolatedPartRead)
		self.noteIsolatedPartRead(value)
		self.bodyState.isolatedPartOrigins.upsert(value, value: read)
	end 'noteIsolatedPartReadAt'

	function copyIsolatedPartRead(target ValueId, source ValueId)
		self.noteIsolatedPartRead(target)

		if let origin = try self.bodyState.isolatedPartOrigins.get(source) 'aSourceReadAtItsSite'
			self.bodyState.isolatedPartOrigins.upsert(target, value: origin)
		end 'aSourceReadAtItsSite'
	end 'copyIsolatedPartRead'

	function noteElementReadFromAPart(element ValueId, source ValueId, startIndex ElementIndex, endIndex ElementIndex)
		if not self.valueIsAnIsolatedSlotRead(source) or self.valueIsAValueType(element) or self.bodyState.isolatedPartOrigins.contains(element) 'notReadFromAPart'
			return
		end 'notReadFromAPart'

		if self.bodyState.isolatedPartOrigins.contains(source) 'theSourceWasReadAtItsOwnSite'
			self.copyIsolatedPartRead(element, source: source)
			return
		end 'theSourceWasReadAtItsOwnSite'

		self.noteIsolatedPartReadAt(element, read: IsolatedPartRead.at(self.tokenTextFrom(startIndex, endIndex: endIndex), anchor: self.tokenAt(startIndex)))
	end 'noteElementReadFromAPart'

	function carryIsolatedPartRead(phi ValueId, arm ValueId)
		if self.bodyState.isolatedPartOrigins.contains(phi) 'alreadyCarried'
			return
		end 'alreadyCarried'

		if not self.valueIsAnIsolatedSlotRead(arm) 'notAPartRead'
			return
		end 'notAPartRead'

		self.copyIsolatedPartRead(phi, source: arm)
		self.handOverHandedBack(arm, phi: phi)
	end 'carryIsolatedPartRead'

	function handOverHandedBack(arm ValueId, phi ValueId)
		let pending = self.regionFactsForRead().handedBack

		if not pending.contains(arm) 'armNotHandedBack'
			return
		end 'armNotHandedBack'

		let moved = ValueIdArray.create(pending.count(), zeroed: false)

		for held in pending 'eachPending'
			moved.push(phi if held == arm else held)
		end 'eachPending'

		let table = self.regionFactsForWrite()
		table.handedBack = moved
	end 'handOverHandedBack'

	function noteHandedBackResult(result ValueId, callee ByteArray, args ValueIdArray, anchor Token)
		_ = self.carryPartReadThroughACall(result, sources: args)

		if self.bodyState.isolatedPartOrigins.contains(result) 'aPartReadOfItsOwnSite'
			return
		end 'aPartReadOfItsOwnSite'

		self.noteIsolatedPartReadAt(result, read: IsolatedPartRead.handedBackBy(calleeSourceName(callee), anchor: anchor))
		self.regionFactsForWrite().handedBack.push(result)
	end 'noteHandedBackResult'

	function noteViewOfTheOpenedRegion(result ValueId, callee ByteArray, args ValueIdArray, anchor Token)
		if self.windowedAViewInsideABlock(result) 'aViewInsideABlock'
			return
		end 'aViewInsideABlock'

		self.noteHandedBackResult(result, callee: callee, args: args, anchor: anchor)
	end 'noteViewOfTheOpenedRegion'

	function windowedAViewInsideABlock(result ValueId) returns bool
		match self.regionFactsForRead().pendingCallOpen 'pending'
			none then return false
			opened(box, range, _) then return self.windowThroughAnOpenBlock(box, result: result, range: range)
		end 'pending'
	end 'windowedAViewInsideABlock'

	function windowThroughAnOpenBlock(box ValueId, result ValueId, range SourceRange) returns bool
		if not self.anExplicitWindowIsOpen() 'noBlockIsOpen'
			return false
		end 'noBlockIsOpen'

		self.openStatementWindowThrough(box, floor: result, range: range)
		self.setValueCapability(result, capability: ValueCapability.mutable)
		return true
	end 'windowThroughAnOpenBlock'

	function anExplicitWindowIsOpen() returns bool
		for window in self.regionFactsForRead().windows 'eachWindow'
			if window.kind != WindowKind.oneStatement 'aBlock'
				return true
			end 'aBlock'
		end 'eachWindow'

		return false
	end 'anExplicitWindowIsOpen'

	function dischargeHandedBack(inputs ValueIdArray, result ValueId)
		let pending = self.regionFactsForRead().handedBack

		if pending.isEmpty() or self.tagOf(result) == ValueTypeTag.void or not self.valueIsCleanInput(result) 'nothingToDischarge'
			return
		end 'nothingToDischarge'

		for input in inputs 'eachInput'
			if not pending.contains(input) and not self.valueIsCleanInput(input) 'anInputThatMayKeepTheRegion'
				return
			end 'anInputThatMayKeepTheRegion'
		end 'eachInput'

		self.withdrawHandedBack(inputs)
	end 'dischargeHandedBack'

	function withdrawHandedBack(consumed ValueIdArray)
		let pending = self.regionFactsForRead().handedBack

		if pending.isEmpty() 'nothingHandedBack'
			return
		end 'nothingHandedBack'

		let remaining = ValueIdArray.create(pending.count(), zeroed: false)

		for held in pending 'eachPending'
			if not consumed.contains(held) 'stillHandedBack'
				remaining.push(held)
			end 'stillHandedBack'
		end 'eachPending'

		let table = self.regionFactsForWrite()
		table.handedBack = remaining
	end 'withdrawHandedBack'

	function requireNoHandedBackResult() throws SourceParseError
		let pending = self.regionFactsForRead().handedBack

		if pending.isEmpty() 'nothingHandedBack'
			return
		end 'nothingHandedBack'

		let value = try pending.get(0) otherwise panic("requireNoHandedBackResult: a non-empty column has an element 0")
		let read = try self.bodyState.isolatedPartOrigins.get(value) otherwise panic("requireNoHandedBackResult: v{value} was filed as handed back with its origin")
		throw self.isolatedPartReadRefusal(read)
	end 'requireNoHandedBackResult'

	function carryPartReadThroughACall(result ValueId, sources ValueIdArray) returns bool
		for source in sources 'eachSource'
			if self.valueIsAnIsolatedSlotRead(source) 'aPartReadReachesTheResult'
				self.carryIsolatedPartRead(result, arm: source)
				return true
			end 'aPartReadReachesTheResult'
		end 'eachSource'

		return false
	end 'carryPartReadThroughACall'

	function valueIsCleanInput(value ValueId) returns bool
		if self.tagOf(value) == ValueTypeTag.function and self.regionFactsForRead().cleanFunctionValues.contains(value) 'aClosureCarryingNothingTheCallerWrites'
			return true
		end 'aClosureCarryingNothingTheCallerWrites'

		let capability = self.effectiveCapabilityOf(value)
		let isValueType = self.valueIsAValueType(value)
		return isCleanInput(capability, isValueType: isValueType, isSlotRead: self.isolatedSlotReadGiven(value, capability: capability, isValueType: isValueType))
	end 'valueIsCleanInput'

	function valueIsCleanIntoARegion(value ValueId) returns bool
		return self.valueIsCleanInput(value) or self.regionFactsForRead().mergedValues.contains(value)
	end 'valueIsCleanIntoARegion'

	function noteMutableUse(value ValueId, line LineNumber)
		self.regionFactsForWrite().mutableUseLines.upsert(value, value: line)
	end 'noteMutableUse'

	function carryCapability(source ValueId, target ValueId)
		self.setValueCapability(target, capability: self.effectiveCapabilityOf(source))
		self.noteCarriedDerivation(target, source: source, slot: ParamCapability.unmarked, joins: false)
		self.carryParamSources(target, source: source)
	end 'carryCapability'

	function otherArmsAreFrozen(func IrFunction, arms ValueIdArray) returns bool
		for arm in arms 'eachArm'
			if not self.armIsAnUndecidedParameter(func, arm: arm) and not self.valueIsAValueType(arm) and self.effectiveCapabilityOf(arm) != ValueCapability.immutable 'notFrozenData'
				return false
			end 'notFrozenData'
		end 'eachArm'

		return true
	end 'otherArmsAreFrozen'

	function freezeParameterArms(func IrFunction, arms ValueIdArray)
		for arm in arms 'eachArm'
			if self.armIsAnUndecidedParameter(func, arm: arm) 'aParameterTheResultFreezes'
				self.setValueCapability(arm, capability: ValueCapability.immutable)
			end 'aParameterTheResultFreezes'
		end 'eachArm'
	end 'freezeParameterArms'

	function armIsAnUndecidedParameter(func IrFunction, arm ValueId) returns bool
		return self.paramSourcesOf(func, value: arm) != NoParamPositions and self.effectiveCapabilityOf(arm) == ValueCapability.mutable
	end 'armIsAnUndecidedParameter'

	function joinMergeCapability(phi ValueId, arms ValueIdArray, func IrFunction, anchor Token) throws SourceParseError
		for arm in arms 'eachPartReadArm'
			self.carryIsolatedPartRead(phi, arm: arm)
		end 'eachPartReadArm'

		if self.valueIsAValueType(phi) 'nothingToJoin'
			return
		end 'nothingToJoin'

		var parameterArms = NoParamPositions
		var parameterArmCount = 0 as ElementIndex
		var dataArm = false

		for arm in arms 'eachArmOfAnUndecidedClass'
			let flags = self.joinArmFlagsOf(func, arm: arm)

			if joinArmIs(flags, wanted: UndecidedParameterArm) 'aParameterDecidesIt'
				parameterArms = parameterArms or self.paramSourcesOf(func, value: arm)
				parameterArmCount = parameterArmCount + 1
				dataArm = dataArm or self.valueHasOtherPath(arm)
			end 'aParameterDecidesIt' else if joinArmIs(flags, wanted: LocalMutableArm) 'localDataBesideIt'
				dataArm = true
			end 'localDataBesideIt' else if joinArmIs(flags, wanted: FrozenDataArm) 'frozenBesideIt'
				self.regionFactsForWrite().paramSources.besideFrozen.insert(phi)
			end 'frozenBesideIt'
		end 'eachArmOfAnUndecidedClass'

		if parameterArms != NoParamPositions 'someParameterDecidesIt'
			if dataArm 'joinedWithLocalData'
				self.regionFactsForWrite().paramSources.noteMixedJoin(phi, sources: parameterArms)
			end 'joinedWithLocalData' else if self.otherArmsAreFrozen(func, arms: arms) 'besideFrozenData'
				self.regionFactsForWrite().paramSources.noteParametersBesideFrozenData(phi, sources: parameterArms, joinedOnlyParameters: parameterArmCount == arms.count())

				if self.bodyState.declaredReturnCapability == ResultCapability.immutable 'theResultFreezesThem'
					self.freezeParameterArms(func, arms: arms)
					self.setValueCapability(phi, capability: ValueCapability.immutable)
				end 'theResultFreezesThem'
			end 'besideFrozenData'

			return
		end 'someParameterDecidesIt'

		var joined = self.effectiveCapabilityOf(try arms.get(0) otherwise panic("joinMergeCapability: a merge has at least one arm"))

		for position in 1 upto arms.count() 'eachFurtherArm'
			let given = self.effectiveCapabilityOf(try arms.get(position) otherwise panic("joinMergeCapability: arms.get OOB at {position}"))

			if joinMixesIsolatedWithData(joined, second: given) 'isolatedBesideData'
				throw self.regionRefusal(ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, message: IsolatedJoinRefusal, line: anchor.line, column: anchor.column)
			end 'isolatedBesideData'

			joined = joinedCapability(joined, second: given)
		end 'eachFurtherArm'

		if let settlingOp = try self.onlyUndecidedArmOp(arms) 'oneArmSettlesAfterParsing'
			self.bodyState.undecidedResults.upsert(phi, value: settlingOp)
			joined = ProvisionalForAUse
		end 'oneArmSettlesAfterParsing'

		self.setValueCapability(phi, capability: joined)

		for arm in arms 'eachCarriedArm'
			self.noteCarriedDerivation(phi, source: arm, slot: ParamCapability.unmarked, joins: true)
		end 'eachCarriedArm'

		if joined != ValueCapability.isolated 'notIsolated'
			return
		end 'notIsolated'

		for arm in arms 'eachFreshArm'
			if self.capabilityOfValue(arm) == ValueCapability.temporary 'aFreshArm'
				self.setValueCapability(arm, capability: ValueCapability.isolated)
			end 'aFreshArm'
		end 'eachFreshArm'
	end 'joinMergeCapability'

	function onlyUndecidedArmOp(arms ValueIdArray) returns ElementIndex throws AbsentError
		var settlingOp = 0 as ElementIndex
		var undecided = 0 as ElementIndex

		for arm in arms 'eachArm'
			if self.valueIsAnUndecidedResult(arm) 'anUndecidedResult'
				settlingOp = try self.bodyState.undecidedResults.get(arm) otherwise throw AbsentError.absent
				undecided = undecided + 1
				continue
			end 'anUndecidedResult'

			let given = self.effectiveCapabilityOf(arm)

			if not self.valueIsAValueType(arm) and given != ValueCapability.mutable and given != ValueCapability.temporary 'notPlainWritableData'
				throw AbsentError.absent
			end 'notPlainWritableData'
		end 'eachArm'

		if undecided != 1 'noneOrSeveral'
			throw AbsentError.absent
		end 'noneOrSeveral'

		return settlingOp
	end 'onlyUndecidedArmOp'

	function joinArmFlagsOf(func IrFunction, arm ValueId) returns JoinArmFlags
		var flags = NoJoinArmFlags

		if self.armIsAnUndecidedParameter(func, arm: arm) 'anUndecidedParameter'
			flags = flags or UndecidedParameterArm
		end 'anUndecidedParameter'

		if self.armIsLocalMutableData(func, arm: arm) 'localMutableData'
			flags = flags or LocalMutableArm
		end 'localMutableData'

		if self.armIsAResultStillToSettle(func, arm: arm) 'aResultStillToSettle'
			flags = flags or ResultStillToSettleArm
		end 'aResultStillToSettle'

		if self.armIsFrozenData(func, arm: arm) 'frozenData'
			flags = flags or FrozenDataArm
		end 'frozenData'

		return flags
	end 'joinArmFlagsOf'

	function armIsFrozenData(func IrFunction, arm ValueId) returns bool
		if self.regionFactsForRead().paramSources.besideFrozen.contains(arm) 'aJoinWithAFrozenArm'
			return true
		end 'aJoinWithAFrozenArm'

		return not self.valueIsAValueType(arm) and self.effectiveCapabilityOf(arm) == ValueCapability.immutable and not self.valueIsFrozenAtItsRoot(func, value: arm)
	end 'armIsFrozenData'

	function armIsLocalData(func IrFunction, arm ValueId) returns bool
		return not (self.valueIsAValueType(arm) or self.valueIsOpaque(arm) or self.paramSourcesOf(func, value: arm) != NoParamPositions)
	end 'armIsLocalData'

	function armIsLocalMutableData(func IrFunction, arm ValueId) returns bool
		let given = self.effectiveCapabilityOf(arm)
		return self.armIsLocalData(func, arm: arm) and (given == ValueCapability.mutable or given == ValueCapability.temporary)
	end 'armIsLocalMutableData'

	function armIsAResultStillToSettle(func IrFunction, arm ValueId) returns bool
		return self.armIsLocalData(func, arm: arm) and self.effectiveCapabilityOf(arm) == ProvisionalForAUse and self.valueSettlesAfterParsing(arm)
	end 'armIsAResultStillToSettle'

	function noteJoinedArm(func IrFunction, phi ValueId, incoming ValueId, flags JoinArmFlags)
		let table = self.regionFactsForWrite().paramSources

		if joinArmIs(flags, wanted: UndecidedParameterArm) 'aParameterArm'
			table.noteParameterArm(phi, incoming: incoming, sources: self.paramSourcesOf(func, value: incoming))
			return
		end 'aParameterArm'

		if not joinArmIs(flags, wanted: LocalMutableArm) and not joinArmIs(flags, wanted: ResultStillToSettleArm) 'notLocalData'
			table.noteOtherArm(phi)
			return
		end 'notLocalData'

		table.noteLocalDataArm(phi)
	end 'noteJoinedArm'

	function valueHasOtherPath(value ValueId) returns bool
		return self.regionFactsForRead().paramSources.besideLocalData.contains(value)
	end 'valueHasOtherPath'

	function joinCapabilityInto(phi ValueId, incoming ValueId)
		if self.valueIsAValueType(phi) 'nothingToJoin'
			return
		end 'nothingToJoin'

		self.carryIsolatedPartRead(phi, arm: incoming)

		let flags = self.joinArmFlagsOf(self.bodyFunction(), arm: incoming)
		self.noteJoinedArm(self.bodyFunction(), phi: phi, incoming: incoming, flags: flags)

		if joinArmIs(flags, wanted: UndecidedParameterArm) 'aParameterDecidesIt'
			return
		end 'aParameterDecidesIt'

		let given = self.effectiveCapabilityOf(incoming)
		let current = self.capabilityOfValue(phi)
		self.noteCarriedDerivation(phi, source: incoming, slot: ParamCapability.unmarked, joins: true)

		if joinArmIs(flags, wanted: FrozenDataArm) 'aFrozenArm'
			self.regionFactsForWrite().paramSources.besideFrozen.insert(phi)
		end 'aFrozenArm'

		if self.mergeSettlesWithIncoming(phi, incoming: incoming, current: current, given: given) 'settlesAfterParsing'
			return
		end 'settlesAfterParsing'

		if given != current 'aDifferentCapability'
			if joinMixesIsolatedWithData(current, second: given) 'isolatedBesideData'
				let anchor = self.current()
				self.deferRegionRefusal(ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, message: IsolatedJoinRefusal, line: anchor.line, column: anchor.column)
			end 'isolatedBesideData'

			self.setValueCapability(phi, capability: joinedCapability(current, second: given))
		end 'aDifferentCapability'
	end 'joinCapabilityInto'

	function mergeSettlesWithIncoming(phi ValueId, incoming ValueId, current ValueCapability, given ValueCapability) returns bool
		if incoming == phi 'itself'
			return false
		end 'itself'

		let phiSettles = self.valueSettlesAfterParsing(phi)

		if given == ProvisionalForAUse and self.valueSettlesAfterParsing(incoming) 'aResultStillToSettle'
			if not phiSettles and current != ValueCapability.mutable and current != ValueCapability.temporary 'alreadyReadOnly'
				return false
			end 'alreadyReadOnly'

			self.addSettlingArms(phi, incoming: incoming)
			return true
		end 'aResultStillToSettle'

		if not phiSettles 'nothingPending'
			return false
		end 'nothingPending'

		if self.valueIsAValueType(incoming) or given == ValueCapability.mutable or given == ValueCapability.temporary 'plainWritableData'
			return true
		end 'plainWritableData'

		_ = self.bodyState.undecidedResults.remove(phi)
		_ = self.bodyState.rebindAliasOps.remove(phi)
		_ = self.bodyState.mergedSettlingOps.remove(phi)
		return false
	end 'mergeSettlesWithIncoming'

	function addSettlingArms(phi ValueId, incoming ValueId)
		let ops = try self.bodyState.mergedSettlingOps.get(phi) otherwise SettlingOpArray.create(0)

		if ops.count() == 0 and self.valueSettlesAfterParsing(phi) 'aSingleResultAlias'
			ops.push(try self.settlingOpOf(phi) otherwise panic("addSettlingArms: a pending merge is registered with its defining op"))
		end 'aSingleResultAlias'

		let armOps = try self.settlingOpsOf(incoming) otherwise panic("addSettlingArms: a pending arm is registered with its defining op")

		for opIdx in armOps 'eachArmOp'
			if not ops.contains(opIdx) 'aNewOp'
				ops.push(opIdx)
			end 'aNewOp'
		end 'eachArmOp'

		self.bodyState.undecidedResults.upsert(phi, value: try ops.get(0) otherwise panic("addSettlingArms: a pending arm has a defining op"))
		self.bodyState.mergedSettlingOps.upsert(phi, value: ops)
		self.setValueCapability(phi, capability: ProvisionalForAUse)
	end 'addSettlingArms'

	function carryCapabilityToAlias(source ValueId, target ValueId)
		let given = self.effectiveCapabilityOf(source)
		self.setValueCapability(target, capability: ValueCapability.mutable if given == ValueCapability.temporary else given)
		self.carryParamSources(target, source: source)
		self.noteCarriedDerivation(target, source: source, slot: ParamCapability.unmarked, joins: false)
		self.carryUndecidedResult(source, target: target)
	end 'carryCapabilityToAlias'

	function pathTextOf(startIndex ElementIndex) returns String
		return self.tokenTextFrom(startIndex, endIndex: self.pos)
	end 'pathTextOf'

	function spanIsAPostfixChain(startIndex ElementIndex) returns bool
		var nesting = 0 as NestingDepth

		for index in startIndex upto self.pos 'eachToken'
			let kind = self.kindAt(index)

			if nesting == 0 and not tokenKindIsPostfixChainPart(kind) and not tokenKindOpensAGroup(kind) 'breaksTheChain'
				return false
			end 'breaksTheChain'

			nesting = groupNestingAfter(kind, nesting: nesting)
		end 'eachToken'

		return true
	end 'spanIsAPostfixChain'

	function isolatedSlotReadRefusal(value ValueId, startIndex ElementIndex, endIndex ElementIndex, anchor Token) returns SourceParseError
		let read = try self.bodyState.isolatedPartOrigins.get(value) otherwise IsolatedPartRead.at(self.tokenTextFrom(startIndex, endIndex: endIndex), anchor: anchor)
		return self.isolatedPartReadRefusal(read)
	end 'isolatedSlotReadRefusal'

	function isolatedPartReadRefusal(read IsolatedPartRead) returns SourceParseError
		if read.handedBack 'aResultHandedBack'
			return self.regionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: handedBackRefusal(read.text), line: read.line, column: read.column)
		end 'aResultHandedBack'

		return self.regionRefusal(ErrorCode.semanticIsolatedReadOutsideBlock, message: "'{read.text}' is isolated and cannot be read outside a block; open it with `modify`, or take it out with `swap`", line: read.line, column: read.column)
	end 'isolatedPartReadRefusal'

	function requireNotAnIsolatedSlotRead(value ValueId, startIndex ElementIndex, endIndex ElementIndex, anchor Token) throws SourceParseError
		if self.valueIsAnIsolatedSlotRead(value) 'aSlotRead'
			throw self.isolatedSlotReadRefusal(value, startIndex: startIndex, endIndex: endIndex, anchor: anchor)
		end 'aSlotRead'
	end 'requireNotAnIsolatedSlotRead'

	function requireNotAnAcquiredState(value ValueId, verb String, anchor Token) throws SourceParseError
		if not valueIsMarked(self.bodyState.acquiredStates, value: value) 'notAnAcquiredState'
			return
		end 'notAnAcquiredState'

		throw self.regionRefusal(ErrorCode.semanticValueLeavesWindow, message: "'{String.from(anchor.value)}' is the state of an acquired service and cannot be {verb}: the service keeps its state", line: anchor.line, column: anchor.column)
	end 'requireNotAnAcquiredState'

	function acquiredStateRootOf(value ValueId) returns ValueId throws AbsentError
		let root = self.rootValueOf(value)

		if not valueIsMarked(self.bodyState.acquiredStates, value: root) 'notRootedAtAState'
			throw AbsentError.absent
		end 'notRootedAtAState'

		return root
	end 'acquiredStateRootOf'

	function acquiredStateNameOf(state ValueId) returns immutable ByteArray
		for acquired in self.regionFactsForRead().acquiredNames 'eachAcquiredName'
			if acquired.state == state 'theState'
				return acquired.name
			end 'theState'
		end 'eachAcquiredName'

		panic("acquiredStateNameOf: v{state} is marked as an acquired state and no `acquire` filed its name")
	end 'acquiredStateNameOf'

	function windowOwnerState(window OpenWindow) returns ValueId throws AbsentError
		if window.kind == WindowKind.acquire 'theBlockHoldsEveryName'
			throw AbsentError.absent
		end 'theBlockHoldsEveryName'

		return try self.acquiredStateRootOf(window.openedValue)
	end 'windowOwnerState'

	function stateIsOpenedByAnExplicitWindow(state ValueId) returns bool
		for window in self.regionFactsForRead().windows 'eachWindow'
			if window.kind != WindowKind.modify 'notABlock'
				continue
			end 'notABlock'

			let owner = try self.windowOwnerState(window) otherwise continue

			if owner == state 'itsOwnBlock'
				return true
			end 'itsOwnBlock'
		end 'eachWindow'

		return false
	end 'stateIsOpenedByAnExplicitWindow'

	function valueIsBesideAnotherStatesWindow(value ValueId) returns bool
		let windows = self.regionFactsForRead().windows

		if windows.isEmpty() 'noWindowIsOpen'
			return false
		end 'noWindowIsOpen'

		let state = try self.acquiredStateRootOf(value) otherwise return false

		for window in windows 'eachWindow'
			let owner = try self.windowOwnerState(window) otherwise continue

			if owner != state 'anotherStatesWindow'
				return true
			end 'anotherStatesWindow'
		end 'eachWindow'

		return false
	end 'valueIsBesideAnotherStatesWindow'

	function noteStateReached(value ValueId, line LineNumber, column ColumnNumber)
		let state = try self.acquiredStateRootOf(value) otherwise return

		if self.stateIsOpenedByAnExplicitWindow(state) 'itsOwnBlock'
			return
		end 'itsOwnBlock'

		let reached = self.regionFactsForWrite().reachedStates
		var known = false

		for other in reached 'eachReachedState'
			if other == state 'theSameState'
				known = true
				continue
			end 'theSameState'

			self.deferRegionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: self.twoStatesMessage(self.acquiredStateNameOf(other), second: self.acquiredStateNameOf(state)), line: line, column: column)
			return
		end 'eachReachedState'

		if not known 'aNewState'
			reached.push(state)
		end 'aNewState'
	end 'noteStateReached'

	function twoStatesMessage(first ByteArray, second ByteArray) returns String
		return "one statement reaches through two acquired states, '{String.from(first)}' and '{String.from(second)}', which may be one service; bind a value read from one of them in its own statement first"
	end 'twoStatesMessage'

	function forgetStatementFacts()
		match self.bodyState.regionFacts 'state'
			unwritten then return
			entries(table) then table.forgetStatement()
		end 'state'
	end 'forgetStatementFacts'

	function suspendStatementFacts() returns SuspendedStatementFacts
		return match self.bodyState.regionFacts 'state'
			unwritten gives SuspendedStatementFacts.nothing
			entries(table) gives table.suspendStatement()
		end 'state'
	end 'suspendStatementFacts'

	function resumeStatementFacts(suspended SuspendedStatementFacts)
		match suspended 'suspended'
			nothing then return
			held(reached, merged) then self.regionFactsForWrite().resumeStatement(reached, merged: merged)
		end 'suspended'
	end 'resumeStatementFacts'

	function storeHolderCapabilityOf(box ValueId) returns ValueCapability
		let capability = self.effectiveCapabilityOf(box)

		if capability != ValueCapability.immutable and self.valueIsBesideAnotherStatesWindow(box) 'anotherStatesData'
			return ValueCapability.paused
		end 'anotherStatesData'

		return capability
	end 'storeHolderCapabilityOf'

	function recoverIsolated(value ValueId, startIndex ElementIndex, site IsolatedRecoverySite) throws SourceParseError
		try self.requireNotAnAcquiredState(value, verb: "frozen" if site == IsolatedRecoverySite.freeze else "moved", anchor: self.tokenAt(startIndex))

		if self.isolateIfPossible(value) 'isolated'
			return
		end 'isolated'

		let anchor = self.tokenAt(startIndex)
		let endIndex = self.argumentEndIndex(startIndex) if site == IsolatedRecoverySite.argument else self.pos
		try self.requireNotAnIsolatedSlotRead(value, startIndex: startIndex, endIndex: endIndex, anchor: anchor)

		let text = self.tokenTextFrom(startIndex, endIndex: endIndex)
		throw self.regionRefusal(ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, message: self.isolatedRecoveryMessage(value, site: site, text: text, startIndex: startIndex), line: anchor.line, column: anchor.column)
	end 'recoverIsolated'

	function argumentEndIndex(startIndex ElementIndex) returns ElementIndex
		let closing = self.pos - 1
		let opening = self.parenGroups.openOf(self.tokens, close: closing)

		for start in self.argumentStartsOf(opening) 'eachArgument'
			if start > startIndex 'theNextArgumentBegins'
				return start - 1
			end 'theNextArgumentBegins'
		end 'eachArgument'

		return closing
	end 'argumentEndIndex'

	function isolatedRecoveryMessage(value ValueId, site IsolatedRecoverySite, text String, startIndex ElementIndex) returns String
		return match site 'site'
			freeze gives "'{text}' is used as mutable{self.mutableUseSuffix(value)}; freeze a copy: `freeze {self.freezeOperandText(text, startIndex: startIndex)}.clone()`"
			binding gives isolatedRecoveryRefusal("'{text}'", advice: IsolatedBindingAdvice)
			swapReplacement or
			returnPath gives isolatedRecoveryRefusal("'{text}'", advice: isolatedMoveAdvice(self.valueCanBeDeclaredIsolated(value, startIndex: startIndex), typeName: self.valueDisplayTypeName(value)))
			argument gives isolatedRecoveryRefusal("'{text}'", advice: "; pass a copy")
		end 'site'
	end 'isolatedRecoveryMessage'

	function valueCanBeDeclaredIsolated(value ValueId, startIndex ElementIndex) returns bool
		return self.rhsWasBareLocalReference(startIndex) and not valueIsMarked(self.bodyState.bufferSurfaceValues, value: value)
	end 'valueCanBeDeclaredIsolated'

	function freezeOperandText(text String, startIndex ElementIndex) returns String
		return text if self.spanIsAPostfixChain(startIndex) else "({text})"
	end 'freezeOperandText'

	function mutableUseSuffix(value ValueId) returns String
		let line = try self.regionFactsForRead().mutableUseLines.get(value) otherwise return ""
		return " at line {line}"
	end 'mutableUseSuffix'

	function settleBindingCapability(value ValueId, rhsStart ElementIndex, nameTok Token) throws SourceParseError
		let pending = self.bodyState.pendingLocalCapability
		self.bodyState.pendingLocalCapability = ParamCapability.unmarked

		if pending != ParamCapability.unmarked and self.pos != self.bodyState.pendingLocalCapabilityEnd 'notTheWholeInitializer'
			let stray = self.tokenAt(self.bodyState.pendingLocalCapabilityEnd)
			throw SourceParseError.unexpectedToken(TokenKind.newline.rawValue, got: tokenDisplayText(stray), line: stray.line, column: stray.column)
		end 'notTheWholeInitializer'

		try self.requireNotAnAcquiredState(value, verb: "moved", anchor: self.tokenAt(rhsStart))
		try self.requireBindingMayLeaveItsStatementWindow(value, rhsStart: rhsStart)

		if pending == ParamCapability.isolated 'declaredIsolated'
			try self.recoverIsolated(value, startIndex: rhsStart, site: IsolatedRecoverySite.binding)
			return
		end 'declaredIsolated'

		try self.requireNotAnIsolatedSlotRead(value, startIndex: rhsStart, endIndex: self.pos, anchor: self.tokenAt(rhsStart))

		if self.valueIsAValueType(value) 'aValue'
			return
		end 'aValue'

		if self.effectiveCapabilityOf(value) == ValueCapability.temporary 'anOrdinaryLocal'
			self.setValueCapability(value, capability: ValueCapability.mutable)
		end 'anOrdinaryLocal'

		self.noteMutableUse(value, line: nameTok.line)
	end 'settleBindingCapability'

	function requireHolderWritable(holderValue ValueId, holder ValueCapability, pathText String, action String, line LineNumber, column ColumnNumber) throws SourceParseError
		try self.requireHolderCapabilityWritable(holder, pathText: pathText, action: action, joinedAtALoop: false, line: line, column: column)

		if self.valueIsCarried(holderValue) 'aHolderTheLoopMayRejudge'
			let table = self.regionFactsForWrite()
			table.carriedHolders.push(CarriedHolder.create(holderValue, assumed: holder, pathText: pathText, action: action, line: line, column: column))
		end 'aHolderTheLoopMayRejudge'
	end 'requireHolderWritable'

	function isolatedHopsOf(opened ValueId) returns ValueIdArray
		let hops = ValueIdArray.create(0)
		var value = opened

		while true 'eachHopTowardTheRoot'
			let origin = try self.regionFactsForRead().fieldOrigins.get(value) otherwise break

			if self.effectiveCapabilityOf(value) == ValueCapability.isolated 'anIsolatedSlotRead'
				hops.push(value)
			end 'anIsolatedSlotRead'

			value = origin.holder
		end 'eachHopTowardTheRoot'

		return hops
	end 'isolatedHopsOf'

	function requireIsolatedSlotHolderWritable(opened ValueId, placeText String, line LineNumber, column ColumnNumber) throws SourceParseError
		for hop in self.isolatedHopsOf(opened) 'eachIsolatedHop'
			try self.requireSlotHolderWritable(hop, placeText: placeText, pathText: self.isolatedSlotFieldName(hop), action: "opened", line: line, column: column)
		end 'eachIsolatedHop'
	end 'requireIsolatedSlotHolderWritable'

	function isolatedSlotFieldName(hop ValueId) returns String
		let origin = try self.regionFactsForRead().fieldOrigins.get(hop) otherwise panic("isolatedSlotFieldName: v{hop} is an isolated hop, and a hop is a value some field was read into")

		return String.from(try self.layoutOfOrigin(origin).fieldNames.get(origin.field) otherwise panic("isolatedSlotFieldName: fieldNames.get OOB at {origin.field}"))
	end 'isolatedSlotFieldName'

	function requireSlotHolderWritable(hop ValueId, placeText String, pathText String, action String, line LineNumber, column ColumnNumber) throws SourceParseError
		let origin = try self.regionFactsForRead().fieldOrigins.get(hop) otherwise panic("requireSlotHolderWritable: v{hop} is a slot read, and a slot read is a value some field was read into")

		if self.valueSettlesAfterParsing(origin.holder) 'settledAfterParsing'
			self.noteDeferredResultWrite(origin.holder, fieldName: self.isolatedSlotFieldName(hop), placeText: placeText, line: line, column: column)
			return
		end 'settledAfterParsing'

		try self.requireHolderWritable(origin.holder, holder: self.holderCapabilityOutsideTheStatement(origin.holder), pathText: pathText, action: action, line: line, column: column)
	end 'requireSlotHolderWritable'

	function holderCapabilityOutsideTheStatement(holder ValueId) returns ValueCapability
		if self.valueIsBesideAnotherStatesWindow(holder) 'anotherStatesData'
			return ValueCapability.paused
		end 'anotherStatesData'

		return capabilityWithinExplicitWindows(self.regionFactsForRead().windows, value: holder, intrinsic: self.capabilityOfValue(holder))
	end 'holderCapabilityOutsideTheStatement'

	function isolatedSlotReadThroughReadOnlyData(operand ValueId) returns bool
		for hop in self.isolatedHopsOf(operand) 'eachIsolatedHop'
			let origin = try self.regionFactsForRead().fieldOrigins.get(hop) otherwise panic("isolatedSlotReadThroughReadOnlyData: v{hop} is an isolated hop, and a hop is a value some field was read into")

			if capabilityIsReadOnly(self.holderCapabilityOutsideTheStatement(origin.holder)) 'readOnlyHolder'
				return true
			end 'readOnlyHolder'
		end 'eachIsolatedHop'

		return false
	end 'isolatedSlotReadThroughReadOnlyData'

	function requireHolderCapabilityWritable(holder ValueCapability, pathText String, action String, joinedAtALoop bool, line LineNumber, column ColumnNumber) throws SourceParseError
		if not capabilityIsReadOnly(holder) 'writable'
			return
		end 'writable'

		let why = "immutable" if holder == ValueCapability.immutable else "read-only{self.readOnlyReasonOf(joinedAtALoop)}"
		throw self.regionRefusal(ErrorCode.semanticIsolatedHolderNotWritable, message: "'{pathText}' cannot be {action}: the value that holds it is {why}", line: line, column: column)
	end 'requireHolderCapabilityWritable'

	function requireBindingMayLeaveItsStatementWindow(value ValueId, rhsStart ElementIndex) throws SourceParseError
		let windows = self.regionFactsForRead().windows

		if not windowIsOpen(windows) 'noWindow'
			return
		end 'noWindow'

		let window = innermostWindowOf(windows)

		if window.kind != WindowKind.oneStatement or window.ownerStatement != self.bodyState.statementStart or self.valueIsCleanInput(value) 'staysInsideOrLeavesClean'
			return
		end 'staysInsideOrLeavesClean'

		throw self.valueLeavesWindowRefusal(window, subject: self.operandSubject(rhsStart, alone: self.statementEndsAt(rhsStart + 1), spelled: self.pathTextOf(rhsStart)), at: self.tokenAt(rhsStart))
	end 'requireBindingMayLeaveItsStatementWindow'

	function requireValueMayLeaveWindows(value ValueId, startIndex ElementIndex) throws SourceParseError
		let windows = self.regionFactsForRead().windows

		if windowIsOpen(windows) and not self.valueIsCleanInput(value) 'leavesAWindow'
			throw self.valueLeavesWindowRefusal(innermostWindowOf(windows), subject: self.returnedSubject(startIndex), at: self.tokenAt(startIndex))
		end 'leavesAWindow'
	end 'requireValueMayLeaveWindows'

	function valueLeavesWindowRefusal(window OpenWindow, subject String, at Token) returns SourceParseError
		let label = String.from(window.label)

		return match window.kind 'kind'
			modify gives self.regionRefusal(ErrorCode.semanticValueLeavesWindow, message: "{subject} is mutable and cannot leave '{label}'; a value leaving a modify block must be a value, immutable or a fresh isolated", line: at.line, column: at.column)
			oneStatement gives self.regionRefusal(ErrorCode.semanticValueLeavesWindow, message: "{subject} is mutable and cannot leave the statement that opens '{label}'; a value leaving a one-statement open must be a value, immutable or a fresh isolated", line: at.line, column: at.column)
			acquire gives self.regionRefusal(ErrorCode.semanticValueLeavesWindow, message: "{subject} is mutable and cannot leave '{label}'; a value leaving an acquire block must be a value, immutable or a fresh isolated, because the services it names keep their state", line: at.line, column: at.column)
		end 'kind'
	end 'valueLeavesWindowRefusal'

	function requireNoPendingCapability(stmtTok Token) throws SourceParseError
		if self.bodyState.pendingLocalCapability == ParamCapability.unmarked 'nothingPending'
			return
		end 'nothingPending'

		self.bodyState.pendingLocalCapability = ParamCapability.unmarked
		throw SourceParseError.unexpectedToken(TokenKind.newline.rawValue, got: tokenDisplayText(stmtTok), line: stmtTok.line, column: stmtTok.column)
	end 'requireNoPendingCapability'

	function parseCapabilityAnnotation(operand ValueId) returns ValueId throws SourceParseError
		let capabilityTok = self.current()
		let capability = try self.readParamCapability()

		if capability != ParamCapability.isolated 'notIsolated'
			throw notATypeError(capabilityTok)
		end 'notIsolated'

		let target = try self.parseTypeReference(BarePrimitiveVoice.asACastTarget)
		try self.requireCapabilityFits(capability, wordTok: capabilityTok, spelled: target)

		if self.valueIsAValueType(operand) 'aValue'
			throw notATypeError(capabilityTok)
		end 'aValue'

		self.bodyState.pendingLocalCapability = capability
		self.bodyState.pendingLocalCapabilityEnd = self.pos
		return operand
	end 'parseCapabilityAnnotation'

	function seedParameterCapabilities(func IrFunction, head FunctionHead, takesReceiver bool)
		var position = 0 as ParamCount

		if takesReceiver 'theReceiver'
			self.seedDeclaredParameter(func, position: 0, capability: head.selfCapability, marked: false)
			position = 1
		end 'theReceiver'

		for capability in head.paramCapabilities 'eachParameter'
			self.seedDeclaredParameter(func, position: position, capability: capability, marked: maskHasParam(head.markedParams, param: position))
			position = position + 1
		end 'eachParameter'
	end 'seedParameterCapabilities'

	function seedDeclaredParameter(func IrFunction, position ParamCount, capability ParamCapability, marked bool)
		match capability 'capability'
			immutable then self.seedFrozenParameter(func, position: position)
			isolated then self.seedIsolatedParameter(position, marked: marked)
			mutable then self.seedMutableParameter(func, position: position)
			unmarked or
			consuming then break
		end 'capability'
	end 'seedDeclaredParameter'

	function seedIsolatedParameter(position ParamCount, marked bool)
		self.setValueCapability(position as ValueId, capability: ValueCapability.isolated)

		if marked 'aMutableIsolatedParameter'
			self.bodyState.declaredMutableParams = maskWithParam(self.bodyState.declaredMutableParams, param: position)
		end 'aMutableIsolatedParameter'
	end 'seedIsolatedParameter'

	function requireByReferenceIsolatedStaysPut(func IrFunction, value ValueId, at Token) throws SourceParseError
		let reached = self.paramSourcesOf(func, value: value)

		if (reached and self.bodyState.declaredMutableParams) == NoParamPositions or self.effectiveCapabilityOf(value) != ValueCapability.isolated 'notAMutableIsolatedParameter'
			return
		end 'notAMutableIsolatedParameter'

		throw self.regionRefusal(ErrorCode.semanticValueLeavesWindow, message: "a `mutable isolated` parameter is by reference: the callee may open, swap or replace it but never move it out, alias it, store it or pass it on, because the caller's variable would then name a region another owner holds", line: at.line, column: at.column)
	end 'requireByReferenceIsolatedStaysPut'

	function seedMutableParameter(func IrFunction, position ParamCount)
		func.needsMutableParamMask = maskWithParam(func.needsMutableParamMask, param: position)
		self.bodyState.declaredMutableParams = maskWithParam(self.bodyState.declaredMutableParams, param: position)
	end 'seedMutableParameter'

	function seedFrozenParameter(func IrFunction, position ParamCount)
		self.setValueCapability(position as ValueId, capability: ValueCapability.immutable)
		func.needsFrozenParamMask = maskWithParam(func.needsFrozenParamMask, param: position)
	end 'seedFrozenParameter'

	function requireFieldStoreAllowed(func IrFunction, box ValueId, layout StructLayout, index FieldIndex, value ValueId, valueStart ElementIndex, placeText String, line LineNumber, column ColumnNumber) throws SourceParseError
		let fieldName = String.from(try layout.fieldNames.get(index) otherwise panic("requireFieldStoreAllowed: fieldNames.get OOB at {index}"))
		self.noteStateReached(box, line: line, column: column)
		let holder = self.storeHolderCapabilityOf(box)

		let settlesLater = self.valueSettlesAfterParsing(box)

		if settlesLater 'settledAfterParsing'
			self.noteDeferredResultWrite(box, fieldName: fieldName, placeText: placeText, line: line, column: column)
		end 'settledAfterParsing'

		if not (settlesLater and capabilityIsReadOnly(holder)) 'judgedNow'
			try self.requireStoreHolderWritable(holder, fieldName: fieldName, placeText: placeText, joinedAtALoop: false, line: line, column: column)
		end 'judgedNow'

		if holder == ValueCapability.isolated and not self.valueIsCleanIntoARegion(value) 'outerDataIntoARegion'
			let outerTok = self.tokenAt(valueStart)
			throw self.regionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: "'{self.tokenTextFrom(valueStart, endIndex: self.pos)}' is mutable outside '{placeText}'; a store into an isolated region takes values, immutable or isolated", line: outerTok.line, column: outerTok.column)
		end 'outerDataIntoARegion'

		try self.requireIsolatedSlotHolderWritable(box, placeText: placeText, line: line, column: column)
		self.noteMutableUse(box, line: line)
		self.noteUseSite(func, value: box, mutable: true, line: line)

		if self.valueIsAnUndecidedParameter(func, value: box, capability: holder) 'aWriteThroughAParametersData'
			self.notePassedParamNeed(func, value: box, mutable: true, line: line)
		end 'aWriteThroughAParametersData'

		try self.admitStore(func, slot: self.fieldSlotOf(layout, index: index, box: box), value: value, valueStart: valueStart, place: fieldName, holder: StoreHolder.held(box, assumed: holder, placeText: placeText, line: line, column: column))
	end 'requireFieldStoreAllowed'

	function fieldSlotOf(layout StructLayout, index FieldIndex, box ValueId) returns ParamCapability
		let declared = layout.fieldTypeSites.capabilityAt(index)

		if declared != ParamCapability.unmarked or self.tagOf(box) != ValueTypeTag.genericInstance 'theDeclarationDecidesIt'
			return declared
		end 'theDeclarationDecidesIt'

		let fieldType = try layout.fieldTypes.get(index) otherwise panic("fieldSlotOf: fieldTypes.get OOB at {index}")
		let slot = try self.signatures.typeParameterSlotIn(self.valueInstanceId(box), declared: fieldType) otherwise return declared
		return qualifierSlot(slot.1)
	end 'fieldSlotOf'

	function valueIsAnUndecidedParameter(func IrFunction, value ValueId, capability ValueCapability) returns bool
		if capability != ValueCapability.mutable or self.valueIsAValueType(value) or self.valueIsOpaque(value) 'notDecidedByItsClass'
			return false
		end 'notDecidedByItsClass'

		let sources = self.paramSourcesOf(func, value: value)
		return sources != NoParamPositions and (sources and self.bodyState.declaredMutableParams) == NoParamPositions
	end 'valueIsAnUndecidedParameter'

	function admitStore(func IrFunction, slot ParamCapability, value ValueId, valueStart ElementIndex, place String, holder StoreHolder) throws SourceParseError
		try self.requireNotAnAcquiredState(value, verb: "stored into '{place}'", anchor: self.tokenAt(valueStart))
		try self.requireNoUniqueAlias(value, action: "store into '{place}'", anchor: self.tokenAt(valueStart))
		try self.requireByReferenceIsolatedStaysPut(func, value: value, at: self.tokenAt(valueStart))
		let intoAHolder = self.storeHolderIsHeld(holder)

		if self.valueIsOpaque(value) and not intoAHolder 'nothingToJudge'
			return
		end 'nothingToJudge'

		let line = self.tokenAt(valueStart).line
		let given = self.effectiveCapabilityOf(value)

		if self.storeIsHeldByTheLiteral(func, slot: slot, value: value, given: given, holder: holder) 'aRecordUnderConstructionHoldsIt'
			self.regionFactsForWrite().pendingHeld.push(HeldStore.create(value, line: line, place: place, valueStart: valueStart, statementStart: self.bodyState.statementStart))
			return
		end 'aRecordUnderConstructionHoldsIt'

		self.fileResultStore(value, slot: slot, place: place, valueStart: valueStart)
		let verdict = self.slotStoreVerdictGiven(func, value: value, given: given, slot: slot, line: line)
		try self.requireStoreVerdictFits(verdict, fieldName: place, value: value, valueStart: valueStart, valueEnd: self.pos, joinedAtALoop: false)

		match verdict 'verdict'
			fits then self.promoteWhenHeld(value, holder: holder)
			recovers then self.recoverAsIsolated(value)
			notRecoverable or
			isolatedPartRead or
			mutableIntoImmutable or
			isolatedIntoMutable or
			immutableIntoMutable or
			pausedIntoMutable then panic("admitStore: a refusing store verdict was thrown by requireStoreVerdictFits before this match")
		end 'verdict'

		if slot == ParamCapability.immutable 'anImmutableSlotKeepsTheRecordItself'
			self.noteStoredIntoImmutableSlot(value)
		end 'anImmutableSlotKeepsTheRecordItself'

		if self.valueIsCarried(value) or self.storeHolderIsCarried(holder) 'aStoreTheLoopMayRejudge'
			let table = self.regionFactsForWrite()
			table.carriedStores.push(CarriedStore.create(holder, value: value, slot: slot, assumedValue: given, windows: table.windows.clone(), fieldName: place, valueStart: valueStart, valueEnd: self.pos, line: line, statementStart: self.bodyState.statementStart))
		end 'aStoreTheLoopMayRejudge'
	end 'admitStore'

	function noteStoredIntoImmutableSlot(value ValueId)
		if self.valueIsAValueType(value) 'copiedByValue'
			return
		end 'copiedByValue'

		self.bodyState.storedIntoImmutableSlot = withValueMarked(self.bodyState.storedIntoImmutableSlot, value: value)
	end 'noteStoredIntoImmutableSlot'

	function storeHolderIsHeld(holder StoreHolder) returns bool
		return match holder 'holder'
			unheld or
			building gives false
			held gives true
		end 'holder'
	end 'storeHolderIsHeld'

	function storeIsHeldByTheLiteral(func IrFunction, slot ParamCapability, value ValueId, given ValueCapability, holder StoreHolder) returns bool
		let building = match holder 'holder'
			building gives true
			unheld or
			held gives false
		end 'holder'

		if not building or slot != ParamCapability.unmarked or self.valueIsCarried(value) or self.valueIsAListNodeHandle(value) 'notAHold'
			return false
		end 'notAHold'

		if self.valueSettlesAfterParsing(value) 'aResultTheRecordKeeps'
			return not self.valueIsAValueType(value)
		end 'aResultTheRecordKeeps'

		return self.valueIsAnUndecidedParameter(func, value: value, capability: given)
	end 'storeIsHeldByTheLiteral'

	function valueIsACorpusList(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.genericInstance and self.signatures.genericInstanceBaseName(self.valueNameId(value) as GenericInstanceId).equals(ListBuiltinBaseName)
	end 'valueIsACorpusList'

	function valueIsAListNodeHandle(value ValueId) returns bool
		return self.signatures.isManagedListNodeInstanceAt(self.tagOf(value), nameId: self.valueNameId(value))
	end 'valueIsAListNodeHandle'

	function storeHolderIsCarried(holder StoreHolder) returns bool
		return match holder 'holder'
			unheld or
			building gives false
			held(box, _, _, _, _) gives self.valueIsCarried(box)
		end 'holder'
	end 'storeHolderIsCarried'

	function promoteWhenHeld(value ValueId, holder StoreHolder)
		if self.storeHolderIsHeld(holder) 'joinsTheHoldersRegion'
			self.promoteTemporary(value)
		end 'joinsTheHoldersRegion'
	end 'promoteWhenHeld'

	function valueIsAnUndecidedResult(value ValueId) returns bool
		return self.bodyState.undecidedResults.contains(value)
	end 'valueIsAnUndecidedResult'

	function fileResultUse(value ValueId, slot ParamCapability, sends bool, judged bool, place String, line LineNumber, column ColumnNumber)
		let ops = try self.settlingOpsOf(value) otherwise panic("fileResultUse: an undecided result is registered with its defining op")
		let notes = self.notesForWrite(self.bodyFunction())

		for opIdx in ops 'eachSettlingOp'
			notes.resultUses.push(ResultUse.create(opIdx, slot: slot, sends: sends, judged: judged, place: place, valueType: self.valueDisplayTypeName(value), readOnlyReason: readOnlyReasonSuffix(self.readOnlyReason()), line: line, column: column))
		end 'eachSettlingOp'
	end 'fileResultUse'

	function fileResultStore(value ValueId, slot ParamCapability, place String, valueStart ElementIndex)
		if slot == ParamCapability.isolated or self.valueIsAValueType(value) or not self.valueSettlesAfterParsing(value) or self.valueIsAListNodeHandle(value) 'nothingToSettle'
			return
		end 'nothingToSettle'

		let tok = self.tokenAt(valueStart)

		self.fileResultUse(value, slot: slot, sends: false, judged: true, place: place, line: tok.line, column: tok.column)
	end 'fileResultStore'

	function slotStoreVerdictGiven(func IrFunction, value ValueId, given ValueCapability, slot ParamCapability, line LineNumber) returns StoreVerdict
		if slot == ParamCapability.unmarked and self.valueIsAListNodeHandle(value) 'aHandleCarriesNoAuthority'
			return StoreVerdict.fits
		end 'aHandleCarriesNoAuthority'

		let isValueType = self.valueIsAValueType(value)
		let isSlotRead = self.isolatedSlotReadGiven(value, capability: given, isValueType: isValueType)

		if slot != ParamCapability.isolated and not isSlotRead and self.valueSettlesAfterParsing(value) 'settledAfterParsing'
			return StoreVerdict.fits
		end 'settledAfterParsing'

		if slot != ParamCapability.isolated and not isSlotRead and self.valueIsAnUndecidedParameter(func, value: value, capability: given) and not (slot == ParamCapability.immutable and self.valueHasOtherPath(value)) 'judgedAgainstItsFinalClass'
			self.notePassedParamNeed(func, value: value, mutable: slot != ParamCapability.immutable, line: line)
			return StoreVerdict.fits
		end 'judgedAgainstItsFinalClass'

		return storeVerdict(slot, value: given, isValueType: isValueType, isSlotRead: isSlotRead)
	end 'slotStoreVerdictGiven'

	function readOnlyReasonOf(joinedAtALoop bool) returns String
		return JoinedReadOnlyReason if joinedAtALoop else readOnlyReasonSuffix(self.readOnlyReason())
	end 'readOnlyReasonOf'

	function requireStoreHolderWritable(holder ValueCapability, fieldName String, placeText String, joinedAtALoop bool, line LineNumber, column ColumnNumber) throws SourceParseError
		if holder == ValueCapability.immutable 'frozenHolder'
			throw self.regionRefusal(ErrorCode.semanticWriteThroughReadOnly, message: "cannot write '{fieldName}' through '{placeText}', which is immutable", line: line, column: column)
		end 'frozenHolder'

		if holder == ValueCapability.paused 'pausedHolder'
			throw self.regionRefusal(ErrorCode.semanticWriteThroughReadOnly, message: "cannot write '{fieldName}' through '{placeText}', which is read-only{self.readOnlyReasonOf(joinedAtALoop)}", line: line, column: column)
		end 'pausedHolder'
	end 'requireStoreHolderWritable'

	function requireStoreVerdictFits(verdict StoreVerdict, fieldName String, value ValueId, valueStart ElementIndex, valueEnd ElementIndex, joinedAtALoop bool) throws SourceParseError
		if verdict == StoreVerdict.fits or verdict == StoreVerdict.recovers 'nothingToRefuse'
			return
		end 'nothingToRefuse'

		let valueTok = self.tokenAt(valueStart)

		if verdict == StoreVerdict.isolatedPartRead 'aPartRead'
			throw self.isolatedSlotReadRefusal(value, startIndex: valueStart, endIndex: valueEnd, anchor: valueTok)
		end 'aPartRead'

		let refusal = try storeRefusalOf(verdict, fieldName: fieldName, valueType: self.valueDisplayTypeName(value), readOnlyReason: self.readOnlyReasonOf(joinedAtALoop), subject: "'{self.tokenTextFrom(valueStart, endIndex: valueEnd)}'", holderNoun: holderNounOf(fieldName)) otherwise panic("requireStoreVerdictFits: a {verdict.name} verdict is no refusal")
		throw self.regionRefusal(refusal.0, message: refusal.1, line: valueTok.line, column: valueTok.column)
	end 'requireStoreVerdictFits'

	function requireAssignmentFitsVariable(binding VarInfo, value ValueId, valueStart ElementIndex, valueEnd ElementIndex) throws SourceParseError
		let given = self.effectiveCapabilityOf(value)
		let isValueType = self.valueIsAValueType(value)
		let verdict = assignmentVerdict(self.capabilityOfValue(binding.boundValue), value: given, isValueType: isValueType, isSlotRead: self.isolatedSlotReadGiven(value, capability: given, isValueType: isValueType))
		try self.requireStoreVerdictFits(verdict, fieldName: String.from(binding.name), value: value, valueStart: valueStart, valueEnd: valueEnd, joinedAtALoop: false)

		if verdict == StoreVerdict.recovers 'aFreshValueTakenByAnIsolatedVariable'
			self.recoverAsIsolated(value)
		end 'aFreshValueTakenByAnIsolatedVariable'
	end 'requireAssignmentFitsVariable'

	function recoverAsIsolated(value ValueId)
		self.setValueCapability(value, capability: ValueCapability.isolated)
		self.forgetUndecidedResult(value)
	end 'recoverAsIsolated'

	function valueIsCarried(value ValueId) returns bool
		let roots = self.regionFactsForRead().carriedRoots

		if roots.count() == 0 'noLoopIsOpen'
			return false
		end 'noLoopIsOpen'

		return roots.contains(self.rootValueOf(value))
	end 'valueIsCarried'

	function noteCarriedDerivation(derived ValueId, source ValueId, slot ParamCapability, joins bool)
		if not self.valueIsCarried(source) 'notLoopCarried'
			return
		end 'notLoopCarried'

		let table = self.regionFactsForWrite()
		table.carriedRoots.insert(derived)
		table.carriedDerivations.push(CarriedDerivation.create(derived, source: source, slot: slot, joins: joins))
	end 'noteCarriedDerivation'

	function noteLoopHeaderPhisCarried(phiVars LoopPhiVarArray)
		let table = self.regionFactsForWrite()

		for phiVar in phiVars 'eachHeaderPhi'
			table.carriedRoots.insert(phiVar.phiId)
		end 'eachHeaderPhi'
	end 'noteLoopHeaderPhisCarried'

	function settleCarriedCapabilities() throws SourceParseError
		let table = self.regionFactsForWrite()

		for derivation in table.carriedDerivations 'eachDerivation'
			let refreshed = refreshedCapability(self.capabilityOfValue(derivation.derived), holder: self.capabilityOfValue(derivation.source), slot: derivation.slot, joins: derivation.joins)
			self.setValueCapability(derivation.derived, capability: refreshed)
		end 'eachDerivation'

		for store in table.carriedStores 'eachStore'
			try self.settleCarriedStore(store)
		end 'eachStore'

		for slot in table.carriedStoredSlots 'eachStoredSlot'
			self.settleCarriedStoredSlot(slot)
		end 'eachStoredSlot'

		for judged in table.carriedHolders 'eachHolder'
			let holder = self.capabilityOfValue(judged.holder)

			if holder != judged.assumed 'sameAsJudged'
				try self.requireHolderCapabilityWritable(holder, pathText: judged.pathText, action: judged.action, joinedAtALoop: true, line: judged.line, column: judged.column)
			end 'sameAsJudged'
		end 'eachHolder'

		if self.bodyState.loopScans.isEmpty() 'theOutermostLoopHasSettled'
			table.clearCarried()
		end 'theOutermostLoopHasSettled'
	end 'settleCarriedCapabilities'

	function capabilityUnderWindows(windows WindowStack, value ValueId) returns ValueCapability
		return capabilityWithinWindows(windows, value: value, intrinsic: self.capabilityOfValue(value))
	end 'capabilityUnderWindows'

	function settleCarriedStore(store CarriedStore) throws SourceParseError
		let given = self.capabilityUnderWindows(store.windows, value: store.value)
		var holderMoved = false

		match store.holder 'holder'
			unheld or
			building then break
			held(box, assumed, _, _, _) then holderMoved = self.capabilityUnderWindows(store.windows, value: box) != assumed
		end 'holder'

		if not holderMoved and given == store.assumedValue and not self.valueIsAnUndecidedParameter(self.bodyFunction(), value: store.value, capability: given) 'sameAsJudged'
			return
		end 'sameAsJudged'

		match store.holder 'holder'
			unheld or
			building then break
			held(box, _, placeText, line, column) then try self.requireStoreHolderWritable(self.capabilityUnderWindows(store.windows, value: box), fieldName: store.fieldName, placeText: placeText, joinedAtALoop: true, line: line, column: column)
		end 'holder'

		let enclosingStart = self.bodyState.statementStart
		self.bodyState.statementStart = store.statementStart
		let verdict = self.slotStoreVerdictGiven(self.bodyFunction(), value: store.value, given: given, slot: store.slot, line: store.line)
		self.bodyState.statementStart = enclosingStart
		try self.requireStoreVerdictFits(verdict, fieldName: store.fieldName, value: store.value, valueStart: store.valueStart, valueEnd: store.valueEnd, joinedAtALoop: true)
	end 'settleCarriedStore'

	function settleCarriedStoredSlot(carried CarriedStoredSlot)
		let notes = self.notesForWrite(self.bodyFunction())
		let note = try notes.storedSlotArgs.get(carried.noteIndex) otherwise panic("settleCarriedStoredSlot: storedSlotArgs.get OOB at {carried.noteIndex}")
		let given = self.capabilityUnderWindows(carried.windows, value: carried.value)
		let reached = self.paramSourcesOf(self.bodyFunction(), value: carried.value)

		if given == note.capability and reached == note.sources 'sameAsJudged'
			return
		end 'sameAsJudged'

		let judged = note.judgedAs(reached, given: given, parameterUndecided: self.valueIsAnUndecidedParameter(self.bodyFunction(), value: carried.value, capability: given))
		try notes.storedSlotArgs.set(carried.noteIndex, value: judged) otherwise panic("settleCarriedStoredSlot: storedSlotArgs.set OOB at {carried.noteIndex}")
	end 'settleCarriedStoredSlot'

	function promoteTemporary(value ValueId)
		if self.capabilityOfValue(value) == ValueCapability.temporary 'joinsTheRegion'
			self.setValueCapability(value, capability: ValueCapability.mutable)
		end 'joinsTheRegion'
	end 'promoteTemporary'

	function readOnlyReason() returns ReadOnlyReason
		let windows = self.regionFactsForRead().windows

		if not windowIsOpen(windows) and self.statement.drainingLoops > 0 'aDrainedArray'
			return ReadOnlyReason.whileDrained(String.from(self.statement.drainingLabel))
		end 'aDrainedArray'

		if not windowIsOpen(windows) 'noWindow'
			return ReadOnlyReason.joinedData
		end 'noWindow'

		return ReadOnlyReason.whileOpen(String.from(innermostWindowOf(windows).label))
	end 'readOnlyReason'

	function noteEditorBinding(binding VarInfo, line LineNumber, column ColumnNumber)
		let value = binding.boundValue
		let tied = valueIsMarked(self.bodyState.tiedPromises, value: value)
		let isData = not self.valueIsAValueType(value)

		if binding.isCellBinding or binding.isSelfField or binding.name.equals(DiscardBindingName) or not (isData or tied) 'carriesNoFact'
			return
		end 'carriesNoFact'

		let capability = self.effectiveCapabilityOf(value) if isData else ValueCapability.unknown
		let readOnly = self.readOnlyReason() if capability == ValueCapability.paused else ReadOnlyReason.notReadOnly
		let owner = try self.artifact.module.functions.get(self.artifact.currentFuncIndex) otherwise panic("noteEditorBinding: functions.get OOB at {self.artifact.currentFuncIndex}, the function whose body is being parsed")
		var role = EditorBinding.local

		if binding.name.equals(SelfParamName) 'theReceiver'
			role = EditorBinding.receiver
		end 'theReceiver' else if binding.isParameter 'aParameter'
			role = EditorBinding.parameter
		end 'aParameter'

		self.artifact.recordEditorRead(positionKey(line, column: column), read: EditorRead.create(role, name: displayParamName(binding.name), owner: namePositionOf(owner), typeText: self.valueDisplayTypeName(value), capability: capability, outside: self.capabilityOfValue(value), readOnly: readOnly, move: self.editorMoveOf(binding), linear: self.valueIsLinear(value), tiedPromise: tied))
	end 'noteEditorBinding'

	function editorMoveOf(binding VarInfo) returns EditorMove
		if not binding.movedFrom and not binding.partiallyMoved 'neverMoved'
			return EditorMove.unmoved
		end 'neverMoved'

		return match binding.moveSite 'site'
			at(line) gives EditorMove.movedAt(line)
			unlocated gives EditorMove.movedWithoutALine
		end 'site'
	end 'editorMoveOf'

	function lineJustRead() returns LineNumber
		return self.tokenAt(self.pos - 1).line
	end 'lineJustRead'

	function waitInsideWindowMessage(window OpenWindow) returns String
		return match window.kind 'kind'
			modify or
			oneStatement gives "cannot wait inside '{String.from(window.label)}'; another coroutine could run while '{String.from(window.rootText)}' is open. Await before or after the block"
			acquire gives "cannot wait inside '{String.from(window.label)}'; an acquire block holds its services and may not wait or acquire again. Await before or after the block"
		end 'kind'
	end 'waitInsideWindowMessage'

	function requireNoWaitInsideWindow(waitTok Token) throws SourceParseError
		let windows = self.regionFactsForRead().windows

		if not windowIsOpen(windows) 'noWindow'
			return
		end 'noWindow'

		throw self.regionRefusal(ErrorCode.semanticWaitInsideWindow, message: self.waitInsideWindowMessage(innermostWindowOf(windows)), line: waitTok.line, column: waitTok.column)
	end 'requireNoWaitInsideWindow'

	function deferNoWaitInsideWindow(range SourceRange)
		let windows = self.regionFactsForRead().windows

		if not windowIsOpen(windows) 'noWindow'
			return
		end 'noWindow'

		self.deferRegionRefusal(ErrorCode.semanticWaitInsideWindow, message: self.waitInsideWindowMessage(innermostWindowOf(windows)), line: range.line, column: range.column)
	end 'deferNoWaitInsideWindow'

	function noteWaitSeed(func IrFunction, site WaitSite)
		match site 'site'
			none then return
			replyAwait or
			unknownOriginAwait or
			selectAwait or
			timedSend or
			acquire or
			startAwait or
			runtimePark then break
		end 'site'

		func.mayWaitSeed = true
		self.notesForWrite(func).sparseForWrite().noteFirstWaitSite(site)
	end 'noteWaitSeed'

	function noteRuntimeParkSeed()
		let parkOp = self.artifact.module.opCount() - 1
		self.noteWaitSeed(self.bodyFunction(), site: WaitSite.runtimePark(parkOp))
	end 'noteRuntimeParkSeed'

	function awaitWaitSite(promise ValueId, facts AwaitedPromise, opIdx ElementIndex) returns WaitSite
		return match facts.tryTarget 'target'
			named or
			witness or
			send or
			deferred gives WaitSite.none
			promise gives self.unknownOriginWaitSite(promise, opIdx: opIdx)
			serviceReply or
			sentReply gives WaitSite.replyAwait(opIdx)
			serviceStart gives WaitSite.startAwait(opIdx)
		end 'target'
	end 'awaitWaitSite'

	function unknownOriginWaitSite(promise ValueId, opIdx ElementIndex) returns WaitSite
		return match self.asyncCallCalleeOf(self.bodyFunction(), promise: promise) 'source'
			found gives WaitSite.none
			serviceReply gives WaitSite.replyAwait(opIdx)
			none gives WaitSite.unknownOriginAwait(opIdx)
		end 'source'
	end 'unknownOriginWaitSite'

	function requireAssignmentAllowedInWindows(nameTok Token) throws SourceParseError
		let windows = self.regionFactsForRead().windows

		if not windowIsOpen(windows) 'noWindow'
			return
		end 'noWindow'

		if let opened = try windowOpenedOnRoot(windows, rootName: nameTok.value) 'theOpenedSlot'
			throw self.regionRefusal(ErrorCode.semanticOpenedSlotReassigned, message: "'{String.from(nameTok.value)}' is open in '{String.from(opened.label)}' and cannot be reassigned there", line: nameTok.line, column: nameTok.column)
		end 'theOpenedSlot'

		if not self.bodyState.scope.contains(nameTok.value) 'noBinding'
			return
		end 'noBinding'

		let bound = self.bodyState.scope.getInfo(nameTok.value).boundValue
		let window = innermostWindowOf(windows)

		if valueIsOutsideInnermostWindow(windows, value: bound) and self.valueMayNameARecord(bound) 'anOuterRecordVariable'
			throw self.regionRefusal(ErrorCode.semanticOuterDataWrittenInWindow, message: "'{String.from(nameTok.value)}' holds a record from outside '{String.from(window.label)}' and cannot be reassigned while '{String.from(window.label)}' is open", line: nameTok.line, column: nameTok.column)
		end 'anOuterRecordVariable'
	end 'requireAssignmentAllowedInWindows'

	function requireReturnedCapability(func IrFunction, value ValueId, retStart ElementIndex) throws SourceParseError
		if self.valueIsDeferred(value) 'anUnknownResult'
			self.bodyState.returnsAnUnknownValue = true
		end 'anUnknownResult'

		try self.requireNoUniqueAlias(value, action: "return", anchor: self.tokenAt(retStart))
		try self.requireNotAnAcquiredState(value, verb: "returned", anchor: self.tokenAt(retStart))
		try self.requireNotAnIsolatedSlotRead(value, startIndex: retStart, endIndex: self.pos, anchor: self.tokenAt(retStart))
		let declared = self.bodyState.declaredReturnCapability
		let retTok = self.tokenAt(retStart)

		if declared == ResultCapability.immutable 'aFrozenResult'
			self.regionFactsForWrite().paramSources.adoptJoinedParameters(value)
		end 'aFrozenResult'

		let (heldByTheLiteral, literalHoldsAResult) = self.takeHeldLiteral(func, value: value)
		let fromParameters = self.paramSourcesOf(func, value: value) or heldByTheLiteral
		let alsoLocalData = self.valueHasOtherPath(value) or heldByTheLiteral != NoParamPositions or literalHoldsAResult

		try self.requireValueMayLeaveWindows(value, startIndex: retStart)

		if declared == ResultCapability.isolated 'declaredIsolated'
			try self.recoverIsolated(value, startIndex: retStart, site: IsolatedRecoverySite.returnPath)
		end 'declaredIsolated' else if declared == ResultCapability.immutable and not self.valueIsAValueType(value) 'declaredImmutable'
			if fromParameters != NoParamPositions and not alsoLocalData and (self.effectiveCapabilityOf(value) != ValueCapability.immutable or self.regionFactsForRead().paramSources.joinedParams.contains(value)) 'aParametersData'
				self.notePassedParamNeed(func, value: value, mutable: false, line: retTok.line)
			end 'aParametersData' else if self.effectiveCapabilityOf(value) != ValueCapability.immutable and not self.valueIsAnUndecidedResult(value) 'notFrozen'
				let given = self.effectiveCapabilityOf(value)
				let word = capabilityWord(given)
				throw self.regionRefusal(ErrorCode.semanticResultPathsDisagree, message: "a return does not fit the declared result: {self.returnedSubject(retStart)} is {word}, the result is immutable; freeze it", line: retTok.line, column: retTok.column)
			end 'notFrozen'
		end 'declaredImmutable' else if not self.valueIsAValueType(value) and self.effectiveCapabilityOf(value) == ValueCapability.isolated 'anIsolatedRegionForAPlainResult'
			let text = self.returnedExpressionText(retStart)
			throw self.regionRefusal(ErrorCode.semanticResultPathsDisagree, message: "a return does not fit the declared result: '{text}' is isolated, the result is not `isolated`; return `merge {text}`, or declare the result `isolated`", line: retTok.line, column: retTok.column)
		end 'anIsolatedRegionForAPlainResult' else if declared == ResultCapability.unmarked and not self.valueIsAValueType(value) 'aPlainResult'
			try self.notePlainResultData(func, value: value, retStart: retStart)
		end 'aPlainResult'

		if fromParameters == NoParamPositions or self.valueIsAValueType(value) 'notFromAParameter'
			self.bodyState.returnsOtherwise = true
		end 'notFromAParameter' else 'fromAParameter'
			self.bodyState.returnsFromParams = self.bodyState.returnsFromParams or fromParameters

			if alsoLocalData 'besideLocalData'
				self.bodyState.returnsOtherwise = true
			end 'besideLocalData'
		end 'fromAParameter'
	end 'requireReturnedCapability'

	function frozenFieldDefaultRefusal(place String, value ValueId, retStart ElementIndex) returns SourceParseError
		let refusal = try storeRefusalOf(StoreVerdict.immutableIntoMutable, fieldName: place, valueType: self.valueDisplayTypeName(value), readOnlyReason: "", subject: "", holderNoun: "field") otherwise panic("frozenFieldDefaultRefusal: an immutable-into-mutable verdict is a refusal")
		let valueTok = self.tokenAt(retStart)
		return self.regionRefusal(refusal.0, message: refusal.1, line: valueTok.line, column: valueTok.column)
	end 'frozenFieldDefaultRefusal'
end 'Parser'
