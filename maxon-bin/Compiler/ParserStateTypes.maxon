	export let box as ValueId
	export let flag as ValueId

	static function create(box ValueId, flag ValueId) returns BoxedMemberArm
		return Self{box: box, flag: flag}
	end 'create'
end 'BoxedMemberArm'

typealias BoxedMemberArmArray = Array with BoxedMemberArm

// Where the dispatch enters an error-union arm (`Parser.enterErrorUnionArm`): the block its edges target, the phi
// args they carry, and the block the arm's body is parsed into.
type ErrorUnionArmEntry
	export let targetId as BlockId
	export var args as ValueIdArray
	export let bodyId as BlockId

	static function create(targetId BlockId, args ValueIdArray, bodyId BlockId) returns ErrorUnionArmEntry
		return Self{targetId: targetId, args: args, bodyId: bodyId}
	end 'create'
end 'ErrorUnionArmEntry'

// A broken match obligation held for the handler's end (`Parser.errorMatchRefusal`).
union ErrorMatchRefusal
	none
	held(bindingName immutable ByteArray, reason String, line LineNumber, column ColumnNumber)
end 'ErrorMatchRefusal'

// E3161's reason where two paths reach one point with a combined error matched on one and not the other.
let ErrorMatchPathsDisagreeReason = "it is matched on some of the paths that join here and not on others"
let ErrorMatchLeavesUnmatchedReason = "a path leaves the handler here without having matched it"

// The refusal for moving the owned binding `owned` out of the innermost loop — E3161 when it is a combined
// error's match obligation, whose move is its match.
function reclaimedOnABackEdge(scan LoopMoveScan, headerValue ValueId) returns bool
	for back in scan.backEdges 'eachBackEdge'
		if promiseConsumeNamesADoor(back.mark.consumes.kindOf(headerValue)) 'reclaimedHere'
			return true
		end 'reclaimedHere'
	end 'eachBackEdge'

	return false
end 'reclaimedOnABackEdge'

function consumeReachesTheNextHeader(scan LoopMoveScan, back ReachingMoveEdge, promise ValueId) returns bool
	for phiVar in scan.phiVars 'eachCarriedBinding'
		if phiVar.phiId == promise and phiVar.binding.isEnrolled and phiVar.binding.enrolledAt < back.mark.height() 'theRebindableBinding'
			return back.mark.valueAt(phiVar.binding.enrolledAt) == promise
		end 'theRebindableBinding'
	end 'eachCarriedBinding'

	return true
end 'consumeReachesTheNextHeader'

function edgesCarryOneValue(edges ReachingMoveEdgeArray, position ElementIndex) returns bool
	let first = try edges.get(0) otherwise panic("edgesCarryOneValue: a merge is settled only with a reaching edge")
	let firstValue = first.mark.valueAt(position)

	for edge in edges 'eachEdge'
		if edge.mark.valueAt(position) != firstValue 'aSecondValue'
			return false
		end 'aSecondValue'
	end 'eachEdge'

	return true
end 'edgesCarryOneValue'

function exitEdgesDisagree(falseMark MoveMark, breaks ReachingMoveEdgeArray) returns bool
	for breakEdge in breaks 'eachBreak'
		for position in positionsThatMayDiffer(falseMark, b: breakEdge.mark) 'eachBinding'
			let movedOnFalse = falseMark.movedAt(position)
			let movedOnBreak = breakEdge.mark.movedAt(position)

			if movedOnFalse != movedOnBreak 'disagree'
				return true
			end 'disagree'
		end 'eachBinding'
	end 'eachBreak'

	return false
end 'exitEdgesDisagree'

function movedBetweenThrowEdgesRefusal(tryTok Token) returns SourceParseError
	return SourceParseError.unsupported("a block-form `try` whose body MOVES a value declared outside the block (into a field, a union payload, a consuming call or a `return`) BETWEEN two throwing calls — the block's throw edges share one handler, and they would reach it with that value still owned on the earlier edges and already given away on the later ones, so its drop belongs on some throw edges and not others. Move the value before the `try` block or after it, or give the two throwing calls their own `try` blocks", line: tryTok.line, column: tryTok.column)
end 'movedBetweenThrowEdgesRefusal'

