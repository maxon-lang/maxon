// `findGraphemeEnd(s, startPos: pos)` — the second parameter is LABELLED in the corpus declaration, and a
// Maxon-tier call must present the label or `lowerCall` mis-slots it. Stated here beside the callee whose
// signature it belongs to.
let CorpusStartPosLabel = b"startPos"

// The `argLabels` column for that call: the receiver is positional, `startPos` is not. Built per call
// because `slotCallArgs` INDEXES the column.
function emptySlotMessageLabels() returns NameRoster
	let labels = NameRoster.create(2, zeroed: false)
	labels.push(EmptySourceText)
	labels.push(EmptySlotMessageIndexLabel)
	return labels
end 'emptySlotMessageLabels'

function corpusFindGraphemeEndLabels() returns NameRoster
	let labels = NameRoster.create(2, zeroed: false)
	labels.push(EmptySourceText)
	labels.push(CorpusStartPosLabel)
	return labels
end 'corpusFindGraphemeEndLabels'

// ⭐⭐ **THE BYTE/ASCII FAMILY IS THE CORPUS'S, ALL SEVEN OF IT.**
// `startsWith`/`endsWith`, `toLower`/`toUpper`/`replace`/`replaceFirst`, `contains` and
// `split`: every one is an ordinary declared function in `stdlib/String.maxon` reached through
// `memberBelongsToTheCorpus`, so no constant for any of them is here — a name the compiler does not
// dispatch has nothing in this file to spell. `slice` and the three trims, and the five `StringIndex`
// producers, are served the same way.
//
// ⭐⭐ **`split` IS THE ONE CORPUS MEMBER THAT CONSTRUCTS AN `Array with String`, AND THE ORDINARY
// GENERIC-INSTANCE PATH DECIDES THAT ARRAY THE SAME WAY `emitArrayCreateOp` DOES.** The array's element
// size and its `element_destroy@40` stamp are the same. MEASURED on the emitted x64 of the same program
// through both doors, it is the same three instructions
// in the same order: `movRegImm32 rcx, 8` / `leaRegFunc rdx, [rip + __str_decref]` / `callDirect
// __managed_create`. The corpus's `typealias StringArray = Array with String` (`stdlib/String.maxon:618`) and
// a caller's own `Array with String` INTERN TO ONE `GenericInstanceId` — interning is keyed on
// `(typeNameId, args)` over the whole program, so the two spellings cannot be two instances — which is why
// a `["…"]` literal and a `split` result are assignable in both directions.
//
// ⚠ **`ContainsMethod` IS NOT A LEFTOVER**: `Set`, `Map` and
// `CharacterSet` all dispatch a `contains` of their own through it, and those surfaces are the compiler's. What
// the corpus serves is the `String` `contains`, not the spelling.
let ContainsMethod = b"contains"

// ⭐ **THE `StringIndex` FAMILY HERE IS THE INDEX'S OWN TWO ACCESSORS.**
// `charIndex`/`bytePos` are `stdlib/String.maxon:939-949`'s own names, and they are METHODS rather
// than field reads — the two fields are non-exported.
//
// ⚠ **THE FIVE PRODUCERS ARE THE CORPUS'S** — `startIndex`, `endIndex`, `findFirst`,
// `findLast` and `indexAfter` — so no constant for any of them is here:
// the type's layout comes from the corpus's own declaration in every program, so there is nothing to
// decide per file. These two arms STAY under the roster-wins rule, which is what keeps `idx.bytePos()` a
// field load rather than a call on the hottest path the corpus walks.
let StringIndexCharIndexMethod = b"charIndex"
let StringIndexBytePosMethod = b"bytePos"

// ⚠ **`String.slice` AND `String.sliceLength` ARE THE CORPUS'S.** The corpus declares both outright
// (`stdlib/String.maxon`), so no dispatch arm here spells either. The ARRAY's `endIndex:` label is
// `EndIndexArgLabel`; the constant-slice fold reads a `String` bound's label through `SliceEndIndexArgLabel`
// and `SliceLengthArgLabel`.

// The argument slot a builtin-conformance dispatch spends on its RECEIVER. The
// synthesized impls take `self` positionally in argument 0 — `int.compare(self, other)` — exactly as an
// instance method's receiver does, so an interface formal `j` is actual `j + 1` and the user-visible arity
// is the actual count less this. One name, read by the arity check and the `Self`-argument check.
let BuiltinConformanceReceiverArgs = 1

// The value a short-circuit merge takes on the SKIPPED path: `false` for `and` (a false left
// operand determines the whole expression), `true` for `or`.
function shortCircuitSeed(takesRhsWhenTrue bool) returns FullRangeInt
	if takesRhsWhenTrue 'isAnd'
		return BoolFalseValue
	end 'isAnd'

	return BoolTrueValue
end 'shortCircuitSeed'

// The block label a short-circuit's right-hand operand is evaluated under. Distinct per
// operator so a printed IR fragment says which one produced the block.
function shortCircuitLabel(takesRhsWhenTrue bool) returns immutable ByteArray
	if takesRhsWhenTrue 'isAnd'
		return b"andrhs"
	end 'isAnd'

	return b"orrhs"
end 'shortCircuitLabel'

type ShortCircuitRhs
	export let rhsId as BlockId
	export let value as ValueId
	export let resultTag as ValueTypeTag
	export var skippedMoveMark as MoveMark
	export var rhsMoveMark as MoveMark
	export let orders as ConditionOrders

	static function create(rhsId BlockId, value ValueId, resultTag ValueTypeTag, skippedMoveMark MoveMark, rhsMoveMark MoveMark, orders ConditionOrders) returns ShortCircuitRhs
		return Self{rhsId: rhsId, value: value, resultTag: resultTag, skippedMoveMark: skippedMoveMark, rhsMoveMark: rhsMoveMark, orders: orders}
	end 'create'
end 'ShortCircuitRhs'

// How a handed-off value's graph is proved. A MOVE proves the receiver its one owner; a SHARE
// proves a graph every thread may read at once, which is what a published value is.
enum GreenThreadHandOff
	move
	share
end 'GreenThreadHandOff'

union ThreadHandOffDoor
	message(blame String, argumentOf String)
	spawnFactory(blame String, argumentOf String)
	publish(key immutable ByteArray)
	coroutine(callee immutable ByteArray)
	closureCapture(name immutable ByteArray)
end 'ThreadHandOffDoor'

function handOffDoorBlame(door ThreadHandOffDoor) returns String
	return match door 'door'
		message(blame, _) gives blame
		spawnFactory(blame, _) gives blame
		publish(key) gives "the value published to `{String.from(key)}`"
		coroutine(callee) gives "the value handed to `async {String.from(callee)}(…)`"
		closureCapture(name) gives "the value of `{String.from(name)}` a closure captures"
	end 'door'
end 'handOffDoorBlame'

function handOffDoorKind(door ThreadHandOffDoor) returns GreenThreadHandOff
	return match door 'door'
		message or
		spawnFactory or
		coroutine or
		closureCapture gives GreenThreadHandOff.move
		publish gives GreenThreadHandOff.share
	end 'door'
end 'handOffDoorKind'

function handOffSharesWithTheCaller(door ThreadHandOffDoor) returns bool
	return match door 'door'
		coroutine gives true
		message or
		spawnFactory or
		publish or
		closureCapture gives false
	end 'door'
end 'handOffSharesWithTheCaller'

function handOffLeavesThisGreenThread(door ThreadHandOffDoor) returns bool
	return match door 'door'
		message or
		spawnFactory or
		publish gives true
		coroutine or
		closureCapture gives false
	end 'door'
end 'handOffLeavesThisGreenThread'

function handOffProvesItsGraph(door ThreadHandOffDoor) returns bool
	return match door 'door'
		message or
		spawnFactory or
		publish gives true
		coroutine or
		closureCapture gives false
	end 'door'
end 'handOffProvesItsGraph'

function handOffMayBeSharedReadOnly(door ThreadHandOffDoor) returns bool
	return match door 'door'
		message gives true
		spawnFactory or
		publish or
		coroutine or
		closureCapture gives false
	end 'door'
end 'handOffMayBeSharedReadOnly'

let NoImagedLetInitializer = u64.max as ElementIndex

let NoExitBlock = u64.max as BlockId

function registryNotSolelyOwnedExplanation(key ByteArray) returns String
	return "the value published to `{String.from(key)}` is not solely owned here — publish a `.clone()`"
end 'registryNotSolelyOwnedExplanation'

function registryNotSolelyOwnedError(key ByteArray, anchor Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.registryPublishedValueNotSolelyOwned, explanation: registryNotSolelyOwnedExplanation(key), line: anchor.line, column: anchor.column, note: DiagnosticNote.none)
end 'registryNotSolelyOwnedError'

// A witness dispatch's final argument list: the BORROWED receiver, then the user's actuals already in the
// interface's declaration order. It is what re-establishes the `args[0]` = receiver /
// interface formal `j` = `args[j+1]` convention after `slotCallArgs` — which knows only about the formals —
// has done the reordering. `twoArgs`' variadic sibling, and the ONE place the receiver is put back —
// `MaxonDialect.witnessDispatchReceiver` is the ONE place it is taken back off.
function withWitnessReceiver(receiver ValueId, ordered ValueIdArray) returns ValueIdArray
	let args = ValueIdArray.create(ordered.count() + 1, zeroed: false)
	args.push(receiver)

	for id in ordered 'eachOrdered'
		args.push(id)
	end 'eachOrdered'

	return args
end 'withWitnessReceiver'

// The span a witness dispatch's LABEL error is anchored on — the offending ARGUMENT's own, which is where
// `SemanticCheck.reportArgError` anchors the direct call's twin. `parseCallArgs` pushes
// one range per argument in lockstep and `slotCallArgs` only ever names an index it was handed, so an
// out-of-range index is a compiler defect and not a program's. It is a named lookup rather than a bare `get`
// at the throw sites because a `match` arm is a single expression and cannot bind the result to a `let`.
function witnessArgAnchor(argRanges SourceRangeArray, argIndex ParamCount) returns SourceRange
	return try argRanges.get(argIndex) otherwise panic("witnessArgAnchor: argRanges.get OOB at {argIndex} below count {argRanges.count()} — the columns `parseCallArgs` fills are parallel by construction")
end 'witnessArgAnchor'

// ⭐ **ONE CANDIDATE REQUIREMENT, AS THE AUTHOR WOULD RECOGNIZE IT (R10c)** — its DECLARING interface (under
// `where T is Derived` an inherited requirement is `Base.label()`, and naming `Derived` would be the very
// falsehood R10c removed) joined to `assembleMethodSignature`, the ONE `name(p t) returns r` spelling the
// conformance diagnostics already print a requirement with. A second format here would mean the same
// requirement described two ways depending on which pass complained about it. Both callers are FAILURE
// paths, so the interpolations cost a compiling program nothing.
function renderWitnessRequirement(target WitnessDispatchTarget, signatures ProgramSignatures) returns String
	return "{String.from(target.declaringInterfaceName)}.{assembleMethodSignature(target.methodName, paramNames: target.paramNames, paramTypes: target.paramTypeNames, returnType: target.returnTypeName, isStatic: target.isStatic, signatures: signatures)}"
end 'renderWitnessRequirement'

// Every candidate, rendered and joined through `appendCommaSeparated` — the ONE `", "` a diagnostic's list
// is punctuated with — for the "no requirement of that name takes N arguments" reject, which offers the menu
// instead of blaming one of them (R10c). A rendered requirement always carries at least `name() returns T`,
// so it meets that joiner's non-empty-item requirement.
function renderWitnessRequirements(candidates WitnessDispatchTargetArray, signatures ProgramSignatures) returns String
	var rendered = ""

	for i in 0 upto candidates.count() 'eachCandidate'
		let candidate = try candidates.get(i) otherwise panic("renderWitnessRequirements: candidates.get OOB at {i} below count {candidates.count()}")
		rendered = appendCommaSeparated(rendered, item: renderWitnessRequirement(candidate, signatures: signatures))
	end 'eachCandidate'

	return rendered
end 'renderWitnessRequirements'

// **THE BUILTIN `Array` METHODS.** `create` is a static factory; the rest are instance
// methods dispatched by name in `dispatchArrayMethod` off an `Array`-instance receiver. `get`/`set`/
// `first`/`last`/`pop`/`remove` are THROWING (they ride `try … otherwise`); the rest are non-throwing.
//
// ⚠ **THE THROWING EIGHT ARE NOT DECLARED HERE — THEY ARE `SignatureIndex`'s, AND THIS IS THE ONE PLACE THAT
// SAYS SO**. Each names a throwing runtime callee
// whose diagnostics must quote the AUTHOR's method rather than the emitted symbol, and the source-method maps
// (`ManagedMemoryRuntime`'s, and `ListRuntime`'s) do that quoting by answering with the constant THIS dispatch
// matches on — a second `b"set"` beside the first is the drift these blocks exist to prevent. The dispatch matches the same byte strings.
let CreateMethod = b"create"

// The tokens of the empty forms of `<Type> . create (…)`, as offsets from the region's start, and the token
// count each form spans (`emptyCreateTokenCount`). Named rather than written as literals at the probe: the
// counts are the region-LENGTH test, where a bare 5 reads as an unrelated number.
let EmptyCreateDotOffset = 1
let EmptyCreateNameOffset = EmptyCreateDotOffset + 1
let EmptyCreateOpenParenOffset = EmptyCreateNameOffset + 1
let EmptyCreateCloseParenOffset = EmptyCreateOpenParenOffset + 1
let EmptyCreateTokenCount = EmptyCreateCloseParenOffset + 1
let EmptyCreateZeroOffset = EmptyCreateOpenParenOffset + 1
let EmptyCreateAfterZeroOffset = EmptyCreateZeroOffset + 1
let EmptyCreateZeroedLabelOffset = EmptyCreateAfterZeroOffset + 1
let EmptyCreateZeroedColonOffset = EmptyCreateZeroedLabelOffset + 1
let EmptyCreateZeroedValueOffset = EmptyCreateZeroedColonOffset + 1
let EmptyCreateZeroedCloseParenOffset = EmptyCreateZeroedValueOffset + 1
let EmptyCreateZeroTokenCount = EmptyCreateAfterZeroOffset + 1
let EmptyCreateZeroedTokenCount = EmptyCreateZeroedCloseParenOffset + 1
let ZeroCapacityText = b"0"

type FieldTypeSpelling
	export let fieldType as MaxonType
	export let declaredSurface as immutable DeclaredSurface
	export let declaredBrand as immutable ByteArray
	export let spelledName as SpelledFieldName
	export let typeSite as PositionKey
	export let capability as ParamCapability

	static function create(fieldType MaxonType, declaredSurface immutable DeclaredSurface, declaredBrand ByteArray, spelledName SpelledFieldName, typeSite PositionKey = PositionlessSite, capability ParamCapability = ParamCapability.unmarked) returns Self
		return Self{fieldType: fieldType, declaredSurface: declaredSurface, declaredBrand: declaredBrand, spelledName: spelledName, typeSite: typeSite, capability: capability}
	end 'create'
end 'FieldTypeSpelling'

type SlotStoreSite
	export let place as String
	export let anchor as Token
	export let owner as SlotOwner

	static function create(place String, anchor Token, owner SlotOwner) returns Self
		return Self{place: place, anchor: anchor, owner: owner}
	end 'create'
end 'SlotStoreSite'

union WholeInitializerCast
	none
	at(line LineNumber, column ColumnNumber)
end 'WholeInitializerCast'

type UnsignedLiteralSite
	export let value as ValueId
	export let tok as Token

	static function create(value ValueId, tok Token) returns Self
		return Self{value: value, tok: tok}
	end 'create'
end 'UnsignedLiteralSite'

typealias UnsignedLiteralSiteArray = Array with UnsignedLiteralSite

function tagMayNameADeclaredType(tag ValueTypeTag) returns bool
	return tag == ValueTypeTag.structRef or tag == ValueTypeTag.named
end 'tagMayNameADeclaredType'

function unsignedLiteralWithoutAliasMessage(literal String) returns String
	return "Integer literal '{literal}' is above i64.max, so it needs an alias whose range admits it: write '{literal} as <alias>'"
end 'unsignedLiteralWithoutAliasMessage'

type InferredFieldType
	export let spelling as FieldTypeSpelling
	export let valueEnd as ElementIndex

	static function create(spelling FieldTypeSpelling, valueEnd ElementIndex) returns Self
		return Self{spelling: spelling, valueEnd: valueEnd}
	end 'create'
end 'InferredFieldType'

// A field default's helper has no `return` the author wrote, so its mismatch reads as a plain type
// mismatch — pinned byte-for-byte by `specs/field-defaults.md`'s `error.inferred-head-mismatch`.
function returnMismatchError(func IrFunction, got String, gotNote String, expected String, expectedNote String, line LineNumber, column ColumnNumber, origin ReceiverOrigin) returns SourceParseError
	if isFieldDefaultHelperName(func.name) 'aFieldDefault'
		return SourceParseError.typeMismatchExpectedGot(expected, got: "{got}{gotNote}", line: line, column: column, expectedNote: expectedNote, crossesRange: false)
	end 'aFieldDefault'

	return SourceParseError.returnTypeMismatch(got, gotNote: gotNote, expected: expected, expectedNote: expectedNote, line: line, column: column, origin: origin)
end 'returnMismatchError'

function tokenKindMayPrecedeAFieldDefaultCast(kind TokenKind, leading bool) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.true or kind == TokenKind.false or kind == TokenKind.dot or kind == TokenKind.self or kind == TokenKind.selfType or kind == TokenKind.sizeof or kind == TokenKind.countof or kind == TokenKind.int or kind == TokenKind.float or kind == TokenKind.bool or kind == TokenKind.cstring or (kind == TokenKind.minus and leading)
end 'tokenKindMayPrecedeAFieldDefaultCast'

// The two `stdlib/Range.maxon` types an out-of-header `to` / `upto` constructs — inclusive and half-open.
let RangeTypeName = b"Range"
let OpenRangeTypeName = b"OpenRange"
let ArrayPushMethod = b"push"
let RefillMethod = b"refill"
let ArrayCapacityMethod = b"capacity"
let ArrayResizeMethod = b"resize"

// ⚠ `clear` is spelled by the `__ManagedMemory` surface and the `__ManagedList` surface both, so it
// is UNPREFIXED for the rule the block below states: a method NAME is a token spelling, not a
// container's property, and a family-prefixed constant serving two families is one rename away from
// a second `b"clear"` beside the first.
let ClearMethod = b"clear"

// ⚠ **`isEmpty` IS THE `__ManagedList`'S SPELLING, NOT THE `Array`'S.** The `Array` serves it from the corpus
// (`stdlib/Array.maxon:103`). A `List` is SYNTHESIZED
// (`ListRuntime`'s header carries the measurement), so its `isEmpty` has no corpus body to come from, and the
// `__ManagedList` roster names `isEmpty` among its own. It is therefore UNPREFIXED, on the block below's rule: a method NAME is a token spelling, not a container's property.
let IsEmptyMethod = b"isEmpty"

// The whole-array copy methods. `slice` is THROWING (bounds/inverted-range → `ArrayError`) and
// returns a NEW independent array; `clone` returns a NEW independent array (non-throwing); `append` mutates the
// receiver, borrowing and preserving its argument.
// ⭐ **THE METHOD NAMES MORE THAN ONE CONTAINER SPELLS — ONE CONSTANT EACH, DELIBERATELY UNPREFIXED.** A
// method NAME is a token spelling, not a container's property. Two constants over one spelling would be
// the one-fact-written-twice this project keeps paying for: every dispatcher reaches the SAME name here
// and they diverge only in what they DO with it (an `Array`'s `slice` throws and copies elements; a
// `String`'s takes two `StringIndex`es and copies bytes; an `Array`'s `count` is a field load and a
// `String`'s is the O(n) grapheme walk).
//
// ⚠ **THE `Set` FAMILY SHARES THESE SPELLINGS.** `count`/`contains`/`create`/`insert`/`remove` are spelled
// once here for `Array`/`String`/`Set` alike, and they are what
// `emitContainerLiteralCreate`/`emitContainerLiteralElement` compose a desugared corpus call from.
//
// A second copy of a spelling would make a rename that reached one copy and not the other a WRONG ANSWER
// with no diagnostic: `Array.count` and `Set.count` would answer to different tokens, each dispatcher still
// compiling.
//
// ⚠ `SliceMethod` and `AppendMethod` live in `SignatureIndex` — see the roster block above, which is where
// that reason is stated. `slice` is among the throwing seven a source-method map must name; `append` was
// until the 2026-08-07 ruling made the buffer's `append` non-throwing, and stays there on that block's
// standing rule (one spelling, whichever surfaces serve it). `clone` left this block for the same kind of
// reason and the block's own rule: it is `Cloneable`'s method name, `IrInterface` already declares the
// protocol with it and now advertises it, so the two files held one spelling twice — see
// `IrInterface.CloneMethodName`, which every dispatcher here reads.
// ⭐ **`isEmpty` HAS NO `Array` ROSTER ENTRY, RUNTIME OR CONSTANT.** `stdlib/Array.maxon:103` serves it from
// the corpus and no other surface serves the `Array`'s spelling, so there is nothing for a constant to name.
// Every other name the corpus serves keeps its constant because some other surface still matches on it
// (`ClearMethod` is the buffer's, `CountMethod` the `Map`'s).
let CountMethod = b"count"

// ⚠⚠ **ONE RULE BINDS EVERY METHOD-NAME CONSTANT IN THIS BLOCK:**
//
// ⛔ **`token.value.equals(<MethodName>)` IS NOT BY ITSELF A KIND TEST, AND THE DIFFERENCE IS A SILENT
// LANGUAGE CHANGE.** A LITERAL carries text in `.value` too, and it carries the CONTENT with the quotes
// stripped (`Lexer.emitStringLit`), so `"from"`, `'from'` and `b"from"` all answer that test while
// `TokenKind.from` answers only for the keyword. ⇒ **A name-matching door takes its method name through
// `consumeNameToken` FIRST** — `tokenCanBeAName` admits an identifier or a keyword and excludes exactly the
// literal kinds — and only then matches on the name. Within that set the equivalence is exact and
// structural: the only scanner that emits a non-literal token carrying text is `scanIdentifier`, whose kind
// is `keywords.classify(identBytes)` of the very bytes it stores, so `value == b"from"` and
// `kind == TokenKind.from` cannot come apart. (`scanDirective`'s tokens all carry a leading `#`.) That is
// also why a keyword token can be matched by NAME at all: `Lexer.scanIdentifier` emits `value: identBytes`
// whatever kind it then classified them as, so a refusal can name the very constant its arm matches on
// rather than `TokenKind`'s `rawValue`, which is a DISPLAY string free to gain punctuation.

// The label `slice`'s SECOND argument gives its end index: `arr.slice(1, endIndex: 4)`,
// `s.slice(start, endIndex: idx)`. One label, both containers — `SliceMethod`'s reason.
let EndIndexArgLabel = b"endIndex"

// The label the two-argument mutators (`set`/`insert`) give their VALUE argument: `arr.set(0, value: 9)`.
let ArrayValueLabel = b"value"
let FromSourceParamName = b"source"
let FromSourceArrayNoun = "Array"

let FixedArrayIndexLabel = b"index"

let FixedArrayGetArgCount = 2

let FixedArraySetArgCount = 3

// ⭐ **WHICH `Array` METHODS WRITE THEIR RECEIVER** — the `Array` half of the one immutable-receiver
// rule (`noteReceiverWrite`, E3207; a declared container states its own through `var self`, and `String`'s
// half is the single method `append`). Every one of these rewrites the record's own slots:
// `push`/`insert`/`append`/`reserve`/`resize` can grow (`buffer@0` + `capacity@16`), `set` writes an
// element, and `pop`/`remove`/`clear` shorten it (`length@8`).
//
// The stdlib `Array` signatures state the same list through a by-reference `self`, which the compiler
// does not read, so the list is stated here and pinned by `specs/arrays.md`'s `error.*-on-a-let-array`
// cases.
//
// ⚠ It is NOT `isContainerMoveInMutator`, and neither can be defined from the other: that one answers
// "does this method take OWNERSHIP of an element?" (push/set/insert only), which is a question about
// the ARGUMENT. This one is about the RECEIVER.
// ⚠ **`isManagedMemory` IS NOT DECORATION: the buffer-only mutators EXIST ONLY ON THE BUFFER SURFACE**, so
// naming them unconditionally would apply the immutable-receiver rule to methods the receiver has no dispatch
// arm for — E3207 for a read-only receiver where a writable one correctly says the method is unknown. Every other name here
// is a real `Array` method on every instance and needs no gate.
function arrayMethodMutatesReceiver(name ByteArray, isManagedMemory bool) returns bool
	// The buffer-only MUTATORS (`setLength`, `setByte`, `grow`). They belong in this list
	// for the same reason `resize` and `set` do — each rewrites the record (`setLength` its `length@8` and the
	// vacated bytes, `setByte` one byte of its buffer, `grow` its `buffer@0` and `capacity@16`).
	// `length`/`capacity`/`byteAt` only read and are deliberately absent.
	// ⭐ **THE THREE RELOCATORS JOIN THEM.** `swap` writes no `length@8` and allocates nothing — it
	// exchanges two slots — but it rewrites the elements. The two shifts write the buffer outright.
	// ⚠ **`remove` IS A BUFFER MEMBER AND NOTHING ELSE**, exactly like `swap`, and its `Array` caller is
	// `stdlib/Array.maxon`'s `managed.remove(at)`, whose own receiver-write this same answer records
	// one frame down.
	// ⚠ **`clear` IS A BUFFER MEMBER AND NOTHING ELSE**, exactly like `remove`, and its `Array` caller is
	// `stdlib/Array.maxon`'s `managed.clear()`, whose own receiver-write this same answer records one
	// frame down.
	// ⚠ **`fill` WRITES NO `length@8` AT ALL** — it rewrites the elements of a window, which is `swap`'s
	// reason exactly, plus a copy-on-write detach that can replace `buffer@0`. It is deliberately NOT on `bufferLengthWritingMemberNames`: a sized container's
	// buffer may fill its own slots, because the count a fill leaves behind is the count it found.
	if isManagedMemory and (name.equals(ManagedMemorySetLengthMethod) or name.equals(ManagedMemorySetByteMethod) or name.equals(ManagedMemoryGrowMethod) or name.equals(ManagedMemoryFillMethod) or name.equals(ManagedMemorySwapMethod) or name.equals(ManagedMemoryShiftRightMethod) or name.equals(ManagedMemoryShiftLeftMethod) or name.equals(RemoveMethod) or name.equals(ClearMethod)) 'managedMemoryMutator'
		return true
	end 'managedMemoryMutator'

	// ⚠ **`appendMemory` IS HERE FOR THE REASON `append` IS, AND ITS ABSENCE WOULD NOT HAVE BEEN A REFUSAL —
	// IT WOULD HAVE BEEN A SILENT WRITE.** It copies the source's elements into the receiver's own storage,
	// so E3207 and the record-write mask must both see it; served as a member but left off this
	// answer, `let a = [1, 2]` followed by `a.appendMemory(…)` COMPILES and writes through an
	// immutable binding (`arrays.error.appendMemory-on-a-let-array`).
	// ⚠ **`insert` IS OFF THIS LIST WITH ITS ROSTER ENTRY, AND THE TWO GO TOGETHER BY CONSTRUCTION.**
	// This answer is only ever asked past `requireSurfaceMember`, so a name neither surface carries can never
	// reach it — an entry for one would be a rule about a member the receiver does not have, which is exactly
	// why the buffer-only mutators sit under the `isManagedMemory` gate above and not in this list. A
	// corpus-served `insert` gets E3207 from its own declaration's write masks instead, which is what
	// `arrays.error.insert-on-a-let-array` pins.
	// ⚠ **`reserve` IS OFF THE LIST THE SAME WAY**, and its case is `arrays.error.reserve-on-a-let-array`.
	return name.equals(ArrayPushMethod) or name.equals(ArraySetMethod) or name.equals(AppendMethod) or name.equals(AppendMemoryMethod) or name.equals(ArrayResizeMethod)
end 'arrayMethodMutatesReceiver'

// ⭐ **WHICH PARAMETER THE APPEND REFUSAL NAMES — READ OFF THE SPELLING THE AUTHOR WROTE.** One operation, two
// entry points, two formals: `stdlib/Array.maxon:258` declares `append(other Self)` and `:272` declares
// `appendMemory(source ElementMemory)`. The emission and the argument RULE are genuinely folded (there is one
// of each), so the parameter name is the ONE thing the fold would otherwise lose — and it is the one part of
// the sentence a reader can act on.
//
// ⚠ **IT IS THE `Array` SURFACE'S QUESTION ALONE**, because both declarations are `Array`'s. The BUFFER
// serves only `append` — `appendMemory` is not a `__ManagedMemory` member and its receiver is refused by the
// roster gate — so `requireAppendArg`'s buffer sentence names the one formal its own signature declares
// rather than asking a question with a single answer.
function appendArgParamName(methodName ByteArray) returns immutable ByteArray
	if methodName.equals(AppendMemoryMethod) 'memorySpelling'
		return ArrayAppendMemorySourceParamName
	end 'memorySpelling'

	return ManagedMemoryOtherParamName
end 'appendArgParamName'

// ⭐⭐ **WHICH MEMBERS THE `__ManagedMemory` BUFFER SURFACE HAS — THE ONE LIST ITS DISPATCH CONSULTS AND
// ITS REFUSAL RENDERS.** ⚖ **USER RULING, 2026-07-31: the buffer's legitimate surface is EXACTLY what its
// roster diagnostic names.** A roster kept as prose beside an ungated dispatch is false in both directions
// at once — `Array` member names reachable on a buffer because their arms are never gated, while the same
// sentence denies a member that compiles, links and runs
// (`managed-memory-methods.md`'s `error.buffer-has-no-*` cases are the programs).
//
// ⚠ A refusal is easier to get right than the noun in it, so the noun is the authority.
//
// ⚠ **THE ORDER IS THE MESSAGE'S ORDER, BECAUSE THE MESSAGE IS JOINED FROM THIS LIST**
// (`rosterList`). And the entries are the very constants the arms match on, so the sentence
// cannot spell a member differently from the dispatch that serves it — the residual a hand-written list of
// `b"…"` literals beside these would have left.
//
// ⚠ **THE OTHER DIRECTION — a name listed here whose arm does not exist — IS CHECKED rather than
// commented**: `dispatchArrayMethod`'s buffer fall-through is a PANIC naming
// this list, because a roster member that reaches it would otherwise be handed the very message that says
// it is provided. The pairing cannot be verified at install time (an arm is a control-flow position, not an
// entry in a table something can enumerate), so the check sits at the one moment it is observable.
//
// ⚠ **`fromCString` IS NOT A MEMBER OF THIS SURFACE.** It is `isStatic: true` in both references, so it
// belongs to `parseCompilerOwnedStatic`, and a line here would put a static on the roster the INSTANCE
// dispatch reads. A roster's "absent on purpose" note is two claims — that the name belongs here, and that
// it cannot be built — so check the category before adding a name, and re-measure a blocker before
// repeating it.
//
// ⚠ **WHAT THE LIST RECORDS IS WHAT THE SURFACE *HAS*, NEVER WHO MAY REACH IT, AND TWO ENTRIES DEPEND ON THAT
// SPLIT.** `toCString` and `makeCharFromBytes` are served — the corpus calls both — but, like every buffer
// member, only to library-tier code (`requireArrayMemberIsNotRawSurface`, E3185). Folding provenance into
// this roster would make the refusal for a member the surface does not have and the refusal for one you may
// not reach read as the same sentence.
//
// ⭐⭐ **THE ROSTER IS THE WHOLE CLAIM, AND THE REFUSAL CARRIES NO HAND-WRITTEN TAIL BESIDE IT**
// (`rosterRefusalSentence`). A tail listing what "are not built" is a second place every change must strike
// its name from, and it claims the absence of members the roster right above it provides. Adding a name
// here is the whole edit and cannot leave a sentence contradicting itself.
//
// ⚠ **`appendMemory` IS NOT A BUFFER MEMBER AT ALL.** It is declared on `Array`
// (`stdlib/Array.maxon:267`) and nowhere else: not in the corpus, and no corpus caller writes
// `mm.appendMemory(…)`. The envelope collapse makes the two surfaces ONE record, so serving it would cost
// nothing and refuse nothing — which is exactly the `length`/`count` rule (a shared EMISSION is not a
// shared NAME, the reason `mm.count()` is refused) with its sign flipped: the buffer advertising a member
// the language does not give it, the direction `arraySurfaceMemberNames`' header names as the defect.
// `error.buffer-has-no-appendMemory` is the program.
function bufferSurfaceMemberNames() returns NameRoster
	let names = NameRoster.create(0)
	names.push(ManagedMemoryLengthMethod)
	names.push(ArrayCapacityMethod)
	names.push(GetMethod)
	names.push(ArraySetMethod)
	names.push(ManagedMemorySetLengthMethod)
	names.push(ManagedMemorySetByteMethod)
	names.push(ByteAtMethod)
	names.push(ManagedMemoryElementSizeMethod)
	names.push(ManagedMemoryGrowMethod)
	names.push(ManagedMemoryFillMethod)
	names.push(ManagedMemoryToCStringMethod)
	names.push(ManagedMemoryMakeCharFromBytesMethod)
	names.push(AppendMethod)
	names.push(SliceMethod)
	names.push(ClearMethod)

	// ⭐ **THE FOUR RELOCATORS, ARRIVING BY EXACTLY THE ROUTE THE HEADER ABOVE DESCRIBES.** `remove` shares
	// the `Array`'s `__managed_remove` (same `length` bound, same tail slide, same erase); `swap`/`shiftRight`/
	// `shiftLeft` have runtimes of their own. They sit together because they are ONE group — the operations
	// that move elements the buffer already owns without producing or consuming one — and
	// `ManagedMemoryRuntime.ManagedMemSwapName`'s header carries why that group may not be built out of `get` + `set`.
	names.push(RemoveMethod)
	names.push(ManagedMemorySwapMethod)
	names.push(ManagedMemoryShiftRightMethod)
	names.push(ManagedMemoryShiftLeftMethod)

	// ⭐ **THE CURSOR'S PRODUCER IS A BUFFER MEMBER, AND IT IS THE ONLY ONE.** Nothing else in the language
	// mints a `__ManagedMemoryCursor`; the six members OF one live on `cursorSurfaceMemberNames`, one
	// receiver over.
	names.push(ManagedMemoryCreateCursorMethod)
	return names
end 'bufferSurfaceMemberNames'

// ⭐⭐ **WHICH BUFFER MEMBERS WRITE THE RECORD'S `length@8`** — the sub-roster a SIZED container's
// buffer refuses, because a fixed array's size is a coordinate of its TYPE and a member that moves the record's
// length leaves `count()` and `get` answering different numbers. `sizedContainersBufferRefusal` joins this
// very list into its sentence, so **THE LIST IS THE CLAIM**: a member joins the refusal by joining this list
// and nothing else moves.
//
// ⭐ **IT IS MEASURED AND THEN READ, NEVER REMEMBERED.** On a `FixedArray with 3 Int`'s buffer, printing
// `managed.length()` after each call: `setLength` 3→5, `remove` 5→4, `clear` 4→0; `grow(64)` moves CAPACITY
// 4→64 and leaves the length at 3, and `swap`/`shiftRight`/`shiftLeft` move elements the buffer already owns.
// `append` could not be probed at all — it PANICKED the compiler on the base — and was settled by reading
// every `emitStoreField` at `BufferOwnership.ManagedRecordLengthOffset` in `Runtime/ManagedMemoryRuntime.maxon`
// instead: `setLength`, `clear`, `remove` and `append` (its trivial and managed arms both, and the opaque arm
// delegates to those two). **Those four and no others** — `set` is capacity-bounded and stores no length,
// `setByte` can move capacity through the COW detach but never length, and `slice`'s every length store is
// into the freshly minted VIEW.
//
// ⛔⛔ **IT IS NOT `arrayMethodMutatesReceiver`'s BUFFER CLAUSE, AND SHARING THAT ONE WOULD BE AN
// OVER-REFUSAL.** That clause is `{setLength, setByte, grow, swap, shiftRight, shiftLeft, remove, clear}` —
// the strictly wider question *"does this member write the record?"* — and four of its entries leave the
// length exactly where it was. A shared coordinate is not a shared gate:
// `fixed-array.the-length-preserving-buffer-members-are-still-served` is the case that goes red the moment this
// list widens to it.
//
// ⚠ **EVERY ENTRY MUST ALSO BE ON THE BUFFER SURFACE, AND THE CHECK IS HERE RATHER THAN IN A REVIEWER'S
// HEAD.** A length-writer the surface does not serve is a drifted list: the refusal would name a member the
// roster refuses one gate earlier, so the sentence would describe a program nobody can write. It PANICS for
// `rosterDriftMessage`'s reason one surface over — the pairing cannot be verified at install time, so the
// check sits at the one moment it is observable.
//
// ⚠ **THE SURFACE ARRIVES AS AN ARGUMENT RATHER THAN BEING REBUILT HERE**: this list means nothing except
// relative to the roster it must be a subset of, and its one caller already holds that roster in the
// per-file cached form (`surfaceMemberNames`). Calling `bufferSurfaceMemberNames()` here instead would mint
// all nineteen names again at every buffer-member call inside a sized container's body.
function bufferLengthWritingMemberNames(surface NameRoster) returns NameRoster
	let names = NameRoster.create(0)
	names.push(ManagedMemorySetLengthMethod)
	names.push(AppendMethod)
	names.push(ClearMethod)
	names.push(RemoveMethod)

	for name in names 'eachLengthWriter'
		if not surface.contains(name) 'theSurfaceDoesNotServeIt'
			panic("bufferLengthWritingMemberNames: '{String.from(name)}' writes the buffer record's length but is not on `bufferSurfaceMemberNames` ({rosterList(surface)}), so no receiver can reach it and `sizedContainersBufferRefusal` would name a member the roster gate has already refused. EITHER put the name back on the surface, or take it off this list")
		end 'theSurfaceDoesNotServeIt'
	end 'eachLengthWriter'

	return names
end 'bufferLengthWritingMemberNames'

// ⭐⭐ **WHICH MEMBERS A `__ManagedMemoryCursor` HAS — the buffer roster's twin, one receiver over.** It
// carries the identical obligations: the entries are the very constants `dispatchCursorMethod`'s arms match
// on, the ORDER is the message's order because the message is joined from this list, and the fall-through is
// a PANIC naming it.
//
// ⚠ **THE LIST IS `stdlib/Array.maxon:495-530`'s, AND THAT IS WHY IT IS EXACTLY SIX.** `ArrayIterator`
// forwards `current`/`index`/`advance`/`retreat`/`seek`/`peek` and declares nothing else over its `raw`
// cursor; `advanceBy`/`retreatBy` are `Iterator`/`BidirectionalIterator` EXTENSION methods written in terms
// of `advance`/`retreat`, so they are the corpus's own code and never reach a compiler-owned arm.
//
// ⚠ **THE FIRST TWO ARE INFALLIBLE AND THE LAST FOUR THROW, and the split is the type's whole invariant
// rather than a per-member choice**: a cursor that exists points at a live element, so reading needs no
// check and every MOVE must refuse rather than land somewhere invalid. See
// `ManagedMemoryRuntime.buildManagedCursorCurrent`.
function cursorSurfaceMemberNames() returns NameRoster
	let names = NameRoster.create(0)
	names.push(CursorCurrentMethod)
	names.push(CursorIndexMethod)
	names.push(CursorAdvanceMethod)
	names.push(CursorRetreatMethod)
	names.push(CursorSeekMethod)
	names.push(CursorPeekMethod)
	return names
end 'cursorSurfaceMemberNames'

// ⭐⭐ **WHICH MEMBERS THE `Array` SURFACE HAS — the buffer roster's twin, one surface over.** It
// exists for the identical reason and carries the identical obligations: the entries are the very
// constants `dispatchArrayMethod`'s arms match on, the ORDER is the message's order because the message is
// joined from this list, and the fall-through is a PANIC naming it.
//
// ⚠ **`create` IS NOT MISSING FROM THIS LIST, IT IS NOT A MEMBER.** It is a static factory,
// `Array.create(…)`, which the dispatch has never served as a MEMBER — proven by the drift panic below having
// no arm to reach — while `managed` IS served (the `managedField` arm). The refusal says so in its own
// clause rather than by leaving the name out silently — a reader who wrote `arr.create()` needs to be told
// where `create` actually lives, and a reader who wrote `Array.create(…)` must not be told it is unsupported.
//
// ⚠ **THE BUFFER-ONLY NAMES ARE ABSENT ON PURPOSE**: `length`, `byteAt`, `setLength`, `setByte` and `grow`
// are `__ManagedMemory`'s alone (their arms are gated on the surface), so an `Array` receiver asking for one
// is refused with THIS roster — `setLength` is not missing from `Array`, it is not an `Array` method at all.
// `count` is the `Array`'s spelling of what the buffer calls `length`; the two share an emission and NEVER
// a surface.
//
// ⚠ **AND THE NAMES NEITHER SURFACE HAS** — `contains`/`filter`/… — are simply not on this list, which is the
// whole of what the refusal claims. A change that builds one adds its line HERE and has nothing else to
// remember; see `rosterRefusalSentence` for why the refusal does not enumerate them.
//
// ⚠⚠ **THE REFUSAL RENDERS THIS LIST, SO CHANGING THE SURFACE MOVES COMMITTED EXPECTATIONS.** Every
// `maxoncstderr` block that pins the sentence is rewritten when a line is added or struck —
// `managed-memory-methods.md` and `void-call-result.md` between them pin it many times about the `Array`
// surface. That is the derived-message property working as designed (a diagnostic enumerating what the
// compiler supplies must move when the surface grows), and it is the standing cost of changing a line here.
//
// ⭐⭐⭐ **STRIKING A NAME IS THE WHOLE EDIT THAT MOVES IT ONTO THE CORPUS.** `stdlib/Array.maxon` is listed,
// so `memberBelongsToTheCorpus` serves a name this list does not carry from the declaration the program
// actually has: nothing else moves but the sentence.
//
// ⚠ **A STRUCK NAME CAN KEEP ITS RUNTIME, AND THAT IS THE PARTITION SPEAKING RATHER THAN A HALF-JOB.**
// `remove` and `capacity` are `__ManagedMemory` members too (`bufferSurfaceMemberNames`), so their arms and
// their `__managed_remove`/`__managed_capacity` runtimes are FLOOR; `hash`/`equals`' `__managed_hash`/`__managed_eq`
// are what a `Map` key's WITNESS slot and the `==` OPERATOR name. What leaves the roster is the `Array`
// SPELLING, which is exactly what a roster is.
//
// ⭐⭐ **A DECLARED-OWN CONFORMER IS OWED THE RESIDUAL ROSTER AND NOTHING MORE.** A program's own
// `type Array` (or `Bag` — the marker, not the name, is what admits it) cannot call `clone`, `last`, `pop`,
// `insert`, `reserve`, `slice`, `remove`, `capacity`, `contains`, `map`, `hash` or `equals`: each of them is
// served by the corpus's `Array` and not by this list. So the roster is not an API a conformer is promised —
// it is the RESIDUE of what could not retire, and it shrinks. ⇒ a case that used a retiring member
// INCIDENTALLY is edited (`array-declared-record.the-empty-literal-is-the-empty-container` asks `count()`
// where it asked `isEmpty()`, and the two `stable-partition-managed-pivot` transcriptions declare the
// one-line `clear` `stdlib/Array.maxon:316` declares); a case whose SUBJECT is the member is what keeps the
// member. **`a-bare-call-to-a-roster-member-takes-the-roster` is the second kind** — its whole assertion is
// that the roster's `count` beats a declaration answering 99, and `count` is the only roster member that can
// carry it (the roster's `get` hands back an opaque `Element` no concrete return type can be compared
// against). That is one of `count`'s reasons for staying.
//
// ⚠⚠ **WHY EACH NAME STILL ON THE ROSTER STAYS, in six classes. A name may be in more than one.**
//   • **A COMPILE-TIME RULE THE CORPUS CANNOT STATE** — `resize` is E3106 (a managed element has no zero):
//     `array-slots.error.resize-struct-element` and `.error.resize-string-element` stop being refused.
//   • **A CORPUS BODY IS NOT THE SAME OPERATION** — `resize`, twice over:
//     `arrays.every-mutator-detaches-a-view` and `byte-string-literal.negative-resize-aborts` both change
//     ANSWER (exit 0 → 1, exit 73 → 1). `__managed_resize` COW-detaches and zero-fills; `stdlib/Array.maxon`'s
//     `reserve` + `setLength` does neither and panics where the runtime aborted. `resize` is the one name on
//     this list whose corpus body is not a slower spelling of its arm.
//   • **THE ARGUMENT RULE IS THE OPERATION'S, NOT THE PARAMETER'S** — `append` and `appendMemory`.
//     `ProgramSignatures.arrayAppendArgAdmits` admits by VALUE SET because append COPIES, which no nominal
//     `other Self` / `source ElementMemory` parameter can carry. Struck, `append` loses
//     `arrays.append-empty-to-nonempty`, `.append-wider-element-array-takes-a-narrower-one` and
//     `.append-reads-the-value-set-never-the-alias-name` to `E3005`. It is not a defect on either side.
//   • **A DECLARED-OWN `Array` DEPENDS ON IT** — `count` and `set` (the `stable-partition` cases plus one
//     `generic-opaque-element-borrow-liveness`), which is the class the paragraph above rules on: a COST,
//     paid where the member is incidental, and a REASON where the case's subject is the member itself.
//   • **THE EMITTED CODE OR THE COMPILER ITSELF BREAKS** — `push` and `set`. `push` breaks through
//     independent mechanisms: `interface-extensions/stdlib-map-on-map-with-function` exits **101**,
//     `generic-type-nested-array-typealias/static-forward-keeps-its-constructor-feed` PANICS in
//     `LayoutDescriptor`, four `tuples` cases lose their element coercion, and `byte-enum-comparison` loses
//     enum→`Byte`. `set` moves two
//     `codegen-internals/rdata-global-*-array-cow` `TargetIr` pins at BYTE 0 and breaks
//     `emitted-runtime-body/error-ordinal-in-an-emitted-body`.
//   • **AN OPAQUE-ELEMENT RECEIVER CANNOT REACH A CORPUS BODY AT ALL** — `set`'s class; see `set`'s own
//     bullet below. Of its three shapes only the declared-own one (the bullet above) still refuses.
//
// ⚠ **A REFUSAL RAISED INSIDE A CORPUS BODY NAMES A LINE NO USER WROTE.** `requireArrayCopyMethodSupported`
// fires where the `managed.slice(0, len)` IS, so a refusal for `clone` reads
// `stdlib/Array.maxon:142:32 … 'slice'` rather than `<fragment>:12:12 … 'clone'`; the blame edge that would
// re-point a stdlib-body diagnostic at the construct that forced it does not exist.
//
// ⚠⚠ **WHAT EACH NAME STILL ON THE ROSTER MEASURED WHEN STRUCK** — no two of them for the same reason. Each
// says which mechanism is missing:
//   • **`set`** — ⛔ **AN OPAQUE-ELEMENT RECEIVER CANNOT REACH A CORPUS BODY AT ALL.**
//     Both range halves arrive for free through `recordOpaqueArgRangeChecks` — struck, the E3005 and
//     the `Range check failed` panic both land — and the LENGTH bound is the corpus body's own
//     (`stdlib/Array.maxon`'s `set`). What refuses is the receiver, in three shapes,
//     none of them about `set`; two are handled and the third remains:
//       – the **DESCRIPTOR RESERVATION**: an `Array with Key` — `stdlib/Map.maxon`'s own slot columns —
//         needs *"primitiveTypeByteSize: a `typeParameter`'s size is a runtime layout-descriptor read"*
//         answered, raised by `MaxonToStdLowering.materializeLayoutArgFor` → `ensureLayoutDescriptor`.
//         The FORWARD it needs exists (`emitInstanceDescriptorAddr`, whose parameter-run arm answers YES for
//         `Array with Key`); what had to exist was the RESERVATION: `Map.insertAtSlot`'s obligation to
//         SUPPLY `Array.set`'s descriptor arrives by the call edge lowering's carrier scan draws
//         (`noteCarrierFactsOfSlottedCall`).
//       – the **LOOP-STORE MOVE**: `generic-opaque-element-loop-store`'s cases need the
//         `coOwnBorrowedOpaque`, which lives in the arm's `moveElementIntoContainer`, on the
//         ordinary caller-consume path too (*"moving a value declared outside this loop from inside the loop
//         body"*). The rule is about the LOOP and the sink's obligation rather than
//         about which door emitted the store, so `transferConsumedArg`'s opaque arm reads the same
//         `moveOfValueEscapesLoop` decision and takes the same reference. It is reachable with NO roster
//         strike at all (a consuming SIBLING call in a loop), which is what
//         `generic-opaque-element-loop-store`'s two `a-consuming-sibling-…` cases pin.
//       – a **REFUSAL** where that receiver is not even admitted: `stable-partition-managed-pivot`
//         ×2 and `generic-opaque-element-borrow-liveness.a-trivial-element-container-is-untouched`.
//         `memberBelongsToTheCorpus` is not declining a
//         receiver. All three programs DECLARE THEIR OWN `type Array uses Element`, which replaces the
//         corpus's for the whole compile — so the corpus has no `set` to serve and the roster refusal is
//         correct. They are the SECOND bullet's class (a declared-own `Array` depends on this roster), which
//         is a language question and not a generics one.
//   • **`push`** — three separate faults at once, measured: `arrays/slice-parent-grows-while-view-lives`
//     stops detaching a COW view (exit 1 against 0); a `byte-enum-comparison` case loses the arm's
//     enum→element coercion (`expected 'Byte', got 'Ascii'`); and both `bytearray-element-size`
//     contested-alias cases lose their refusal. Plus the declared-record class below.
//   • **`append`** — its `other Self` parameter meets the ORDINARY nominal argument agreement, which
//     refuses what `ProgramSignatures.arrayAppendArgAdmits` admits by VALUE SET: three cases,
//     `expected 'Array_int', got 'IntArray'`. That is `append`'s only blocker. It is the
//     rule, and it is not a defect on either side — the
//     admission is sound *because append COPIES*, which is a fact about the operation that no nominal
//     parameter type can carry — and it is bounded by the element's NAME: an element the author named is its
//     own type, and only an unnamed element (a literal's `int`) decays into a receiver whose range holds it
//     (`ProgramSignatures.trivialElementAdmitsEveryValueOf`).
//   • **`appendMemory`** — the SAME operation as `append` through the SAME admission, so it stays with it
//     (see its line on the roster below).
//
// ⭐⭐ **`push` IS FOUR MECHANISMS IN ONE BULLET.** It is not a third-bullet member either: it is blocked
// simultaneously by the declared-own class (the `array-declared-record` cases), by a compile-time rule
// (`ranged-typealias.error.array-push-out-of-range` stops being refused and
// `array-element-runtime-panic` loses its panic — `set`'s rule), by the
// argument's COERCION to the element type (`byte-enum-comparison` loses enum→`Byte`, and two `tuples` cases
// hand a `__Tuple2.int.int` to a `__Tuple2.Num.Num`), and by a lost COW detach. Four independent
// mechanisms, no two of which one change closes.
function arraySurfaceMemberNames() returns NameRoster
	let names = NameRoster.create(0)
	names.push(ManagedMemoryFieldName)
	names.push(GetMethod)
	names.push(ArraySetMethod)
	names.push(ArrayFirstMethod)
	names.push(CountMethod)
	names.push(ArrayPushMethod)
	names.push(ArrayResizeMethod)

	// ⚠ `clear` is off the roster but keeps its arm and its `__managed_clear`: `clear` is a `__ManagedMemory`
	// member too (`bufferSurfaceMemberNames`), so the arm is gated on the buffer surface exactly as `remove`'s
	// and `slice`'s are, and `stdlib/Array.maxon:316`'s `managed.clear()` is what an `Array` receiver reaches.
	names.push(AppendMethod)

	// ⚠ **THE `Array` SURFACE'S OWN, AND THE ONE THE CORPUS ACTUALLY DECLARES** (`stdlib/Array.maxon:234`).
	// It sits beside `append` because `append` is its CALLER — `:224`'s whole body is
	// `appendMemory(other.managed)` — so the roster shows the pair in the order the corpus builds them.
	//
	// ⛔ **`appendMemory` STAYS WITH `append`.** `append` stays for the
	// value-set argument admission (`ProgramSignatures.arrayAppendArgAdmits` — sound *because append COPIES*,
	// which no nominal parameter type can carry), and `appendMemory` is the SAME operation through the SAME
	// admission: `parseArrayAppend` serves both from one arm. Struck, a `Bytes` into a `Smalls`
	// through `s.appendMemory(b.managed)` becomes `E3005 … expected 'Smalls', got 'Bytes'` at the argument,
	// naming the formal `source`, where the unstruck compiler runs it and answers **249**. Retiring one of the
	// pair would leave one rule holding for one of its two spellings, which is the hazard this project keeps
	// naming, and no count of failing cases would say so.
	// `arrays.appendMemory-wider-element-array-takes-a-narrower-one` pins the rule on BOTH spellings.
	names.push(AppendMemoryMethod)

	// ⚠ **`hash`/`equals` ARE ON THE SURFACE UNCONDITIONALLY AND AVAILABLE CONDITIONALLY** (array-hashable):
	// whether THIS receiver's element satisfies `where
	// Element is Hashable and Equatable` is `requireArrayConformanceAvailable`'s question, asked at its own
	// span with its own diagnostic. The pair is APPENDED FROM ITS OWN SOURCE rather than typed out
	// (`stringSurfaceMemberNames`'s rule): the conformance row is
	// `IrInterface.isIntrinsicBuiltinConformance`'s, so the day `Array` gains a protocol, its method joins
	// the roster, the refusal and the dispatch together.
	return names
end 'arraySurfaceMemberNames'

// ⭐ **THE CLAUSE AN `Array` CONDITIONAL EXTENSION IS WITHHELD UNDER, RENDERED RATHER THAN WRITTEN.** It
// goes through the SAME renderer a user's `where` clause is spelled back out by (`renderWhereConstraints`),
// over the SAME interface list the availability check tests, so the sentence a reader is given and the
// condition they actually failed are one fact. Typed out as a literal it would be a further spelling of
// that list and the first one nothing checks.
//
// ⚠ **THE LIST IS A PARAMETER THOUGH `Array` HAS ONE CLAUSE, and the parameter is what says
// the renderer is not the clause's OWNER.** That clause is `hash`/`equals`'s `where Element is Hashable and
// Equatable` (`stdlib/Array.maxon:626`), whose list is `Array`'s own
// conformance row (`IrInterface.intrinsicConformanceProtocols`). The one caller names the source of it,
// so this function renders a list it is handed and never states one.
function arrayWhereClause(interfaces NameRoster) returns String
	let constraints = WhereConstraintArray.create(interfaces.count(), zeroed: false)

	for i in 0 upto interfaces.count() 'eachConstraint'
		let interfaceName = try interfaces.get(i) otherwise panic("arrayWhereClause: interfaces.get OOB at {i} below count {interfaces.count()}")
		constraints.push(WhereConstraint.create(ArrayElementTypeParamIndex, interfaceName: interfaceName))
	end 'eachConstraint'

	let paramNames = NameRoster.create(1, zeroed: false)
	paramNames.push(ArrayElementTypeParamName)
	return renderWhereConstraints(constraints, paramNames: paramNames)
end 'arrayWhereClause'

let TypeWhereClauseOwner = "this type"

// ⭐⭐ **WHICH MEMBERS THE `String` SURFACE HAS** — the third roster. It is
// `builtinConformerMethodNameList(String)` — `hash`/`equals`, and `compare` the day `String` becomes
// `Comparable` — and nothing else: those are the builtin CONFORMANCES, whose impls the corpus defines
// (`stdlib/String.maxon:371,375`), and the lookup `dispatchStringMethod` ends in is a direct-call door onto
// those same symbols, not a second body. Every other `String` member is `stdlib/String.maxon`'s and is
// taken by `memberBelongsToTheCorpus`, which is asked ahead of `dispatchStringMethod` and consults the corpus
// for exactly the names this roster does NOT carry, so each is an ordinary qualified call to the ordinary
// declared function. `dispatchStringMethod` serves no member of its own.
//
// It carries the obligations every roster carries: the entries are the names the dispatch can serve, the
// ORDER is the message's order because the message is joined from this list, the dispatch GATES on it ahead
// of every arm, and its fall-through is a PANIC naming it.
//
// ⚠⚠ **A HAND-WRITTEN LIST OF THE MEMBERS DRIFTS.** The *arm added, roster not updated* direction leaves a
// member that is dispatched, tested and refused for VISIBILITY unadvertised in the only sentence a user has
// to go on. **Rendering the constants alone would not catch that**, which is what the gate and the panic
// close.
//
// ⚠⚠ **AN UNEXPORTED MEMBER (`addressableBytes`, `byteAt`, `byteAtOrPanic`, `hasSingleByteGraphemes`,
// `setByte`) IS REFUSED BY ITS OWN DECLARATION RATHER THAN BY A LOCATION GATE.** They are unmarked functions
// in the corpus, so the call reaches the declaration and `SemanticCheck.calleeVisibleFrom` answers with
// the visibility the corpus actually WROTE. A gate would have to ask where the CALLING FILE lives and
// infer the member's visibility from the compiler's own arm list, where this asks the declaration.
//
// ⚠ **THE CONFORMANCE PAIR IS APPENDED FROM ITS OWN SOURCE, NOT TYPED OUT** (`hash`/`equals`, and
// `compare` the day `String` becomes `Comparable`). `dispatchStringMethod`'s last door resolves by LOOKUP
// through `builtinConformerMethod`, so a name it can supply must be a name this gate admits — one list
// serving the gate, the message and the drift panic at once.
//
// ⚠ **THE FUNCTION STAYS RATHER THAN COLLAPSING INTO ITS ONE CALL, and that is not a thin wrapper.** It is
// the `MemberSurface.string` row of `surfaceMemberNames`, whose other rows are hand-written lists; the
// roster gate reads it by surface, and the day `String` gains `Comparable` its `compare()` arrives here
// with no edit. Deleting it would move a surface's answer into the switch that dispatches on surfaces.
function stringSurfaceMemberNames() returns NameRoster
	return builtinConformerMethodNameList(StringConformerName)
end 'stringSurfaceMemberNames'

// ⭐ **WHICH MEMBERS THE `Character` SURFACE HAS.** Three, and the list is a roster for the same
// reason twenty-nine are: the count is not what makes a second copy of a list drift, an EDIT is,
// and a dispatcher with two arms gains a third exactly as one with twenty-seven does. `asciiValue`
// was that third arm, and it arrived by exactly the route this file prescribes — pushed HERE and
// struck from the refusal's tail clause in one edit. The rest of the surface is still that tail
// clause, under the same standing obligation.
function characterSurfaceMemberNames() returns NameRoster
	let names = NameRoster.create(0)
	names.push(ByteViewMethod)
	names.push(ByteLengthMethod)
	names.push(CharacterAsciiValueMethod)
	return names
end 'characterSurfaceMemberNames'

// ⭐ **WHICH MEMBERS THE `StringIndex` SURFACE HAS** — the `Character` roster's twin, one type over,
// and its `equals`/`compare` are absent for a reason the tail clause states rather than omits: they are
// reached through `==`/`<`, so a reader who asks for one must be sent to the operator and not merely told
// no.
function stringIndexSurfaceMemberNames() returns NameRoster
	let names = NameRoster.create(0)
	names.push(StringIndexCharIndexMethod)
	names.push(StringIndexBytePosMethod)
	return names
end 'stringIndexSurfaceMemberNames'

// ⭐⭐⭐ **THERE IS NO `String` STATIC ROSTER AND NO STATIC `MemberSurface`.** The two statics
// `stdlib/String.maxon` exports — `from(bytes)` at `:111` and `init(managed)` at `:106` — are served by
// those declarations themselves, through the ordinary qualified-call path every other type's statics take.
// There is no roster here because there is no synthesized surface for one to describe: `String.<anything>`
// mangles to the callee `String.<anything>`, which the corpus either declares or does not.
//
// ⚠ **"OR DOES NOT" NEEDS A DOOR OF ITS OWN, AND LEAVING IT TO THE FALL-THROUGH IS A MEASURED
// REGRESSION.** An undeclared callee types its result `unknown`, so the refusal surfaced at the next USE of
// that value rather than at the call — `E2015 :4:11: a member access 'byteLength' on a 'unknown' value` for
// `String.create()`, naming neither the type nor the member. `requireCompilerOwnedStaticIsResolvable` is
// where that answer lives: it is a rule about a name the COMPILER owns rather than a roster of members
// the compiler serves, so it needs no list and cannot go stale when the corpus grows one.
//
// ⚠ **A `String` STATIC TAKES `parseQualifiedCall`'s MANGLING LIKE ANY OTHER TYPE'S, WITH NO INTERCEPTION.**
// `stdlib/String.maxon` declares `String`, so the mangled `String.from` names a callee a file declares. A
// door that asked the corpus whether to forward to `parseCallNamed` would pass arguments
// character-for-character identical to the ones `parseQualifiedCall` builds one screen down. A door whose
// every answer is its fall-through's is a copy of that fall-through, so it is the fall-through
// that is kept. `Character` has no such door either.

// ⚠ **A DECLARED `Map` HAS NO ROSTER.** A roster exists
// to hold a SYNTHESIZED surface's dispatch arms and its refusal sentence to one list; a declared `Map`'s
// members are its own declaration's, and an unknown one is E4006 off that declaration rather than a
// hand-written sentence.

// ⚠ A roster exists to hold a SYNTHESIZED surface's dispatch arms and its refusal sentence to ONE list. A
// DECLARED type's members are its own declaration's, and an unknown one is E4006 off that declaration
// rather than a hand-written sentence — which is why `FixedArray`, `Map` and `List` have no roster here.
//
// ⚠ A fixed array is BORN through a construction, never through a member call: `Vec3.create()` is a call to the
// declared static, and `Self{}` inside the declaration is `Parser.emitSizedContainerRecord`.

// ⭐ **WHICH BUILTIN SURFACE A ROSTER ANSWERS FOR.** Eight surfaces carry members the compiler dispatches by name, and
// each has exactly one roster — so the surface is the memo's key, the builder's selector and the refusal's
// subject at once.
//
// ⚠ **THERE IS NO `fixed array` ENTRY.** Every member of a `FixedArray` is `stdlib/FixedArray.maxon`'s, so there is no
// synthesized surface for an entry to key — the same as `map`.
//
// ⚠ **EVERY SURFACE HERE IS A VALUE'S.** The `String` statics, members of the TYPE, are
// their own corpus declarations and key no entry, so what remains is one
// kind of question asked one way per surface.
enum MemberSurface
	// `__ManagedMemory` — the buffer under an `Array`'s record, reached through `.managed` or minted as one.
	buffer

	// `Array` — the surface around that same record.
	array
	string
	character
	stringIndex

	// `__ManagedMemoryCursor with Element` — a navigable position INSIDE a buffer, and a surface of its own
	// rather than more of the buffer's: what may be done to a position (`current`/`advance`/`seek`) and what
	// may be done to the storage it points into (`get`/`setLength`/`grow`) are disjoint sets on two receivers.
	cursor
end 'MemberSurface'

// Which compiler-owned record's roster serves a member of the enclosing type — `Parser.enclosingRosterServing`'s
// answer, read by the implicit-self call and by the fresh-return sweep.
enum EnclosingRoster
	none
	byteRecord
	array
end 'EnclosingRoster'

// ⭐ **WHICH ACCESS ASKED FOR A BASE'S LAYOUT** — `Parser.structLayoutOfType`'s two kinds of caller, carried
// so the refusal it can raise names the construct the author actually wrote. A field walk and a member
// dispatch both need a `StructLayout`, and a base that has none is the same fact about the TYPE with two
// different things to say to the reader; see `builtinRecordAccessRefusal`.
union BaseAccessKind
	field
	member
end 'BaseAccessKind'

// A roster as a refusal prints it — `length/capacity/get/…`, joined from the list the dispatch consults
// rather than transcribed beside it. `IrInterface.builtinConformerDispatchMethodNames` renders a
// diagnostic's method list off its own dispatch walk for the identical reason.
//
// ⚠ ONE renderer for BOTH surfaces: a second `/`-join would be the very duplication these lists exist to
// remove — two spellings of one sentence's shape, free to drift in punctuation while each stays "derived".
function rosterList(roster NameRoster) returns String
	var rendered = ""

	for member in roster 'eachMember'
		if not rendered.isEmpty() 'separator'
			rendered = "{rendered}/"
		end 'separator'

		rendered = "{rendered}{String.from(member)}"
	end 'eachMember'

	return rendered
end 'rosterList'

// ⭐ **ONE SENTENCE SHAPE FOR BOTH SURFACES** — the argument `rosterList` makes about the `/`-join, one
// level up: two full templates side by side are two spellings of one sentence, free to drift in
// punctuation, in noun, and in what they call the thing they refuse, while each stays perfectly
// "derived". `requireSurfaceMember` is the one gate that renders it.
//
// ⚠ **THE NOUN IS `member`, NOT `method`, AND THAT IS NOT A WORDING PREFERENCE.** The `Array` roster is
// derived from the ARMS, and one of those arms serves `managed`, which is a FIELD: `a.managed` reads it and
// `a.managed()` is not a call the grammar has (it reaches `Unsupported: ( statement`, which names neither
// `managed` nor the mistake). A list introduced by the word "method" would send a reader to a parse error
// for the one entry on it that is not one — the same shape as naming `create` among the members. `member`
// is true of every entry and is already the noun the buffer's half uses, so the two halves agree by
// construction rather than by review.
//
// ⚠ **THE NOUN IS A PARAMETER FOR EXACTLY ONE REASON, AND IT IS NOT WORDING**: a STATIC surface's
// members are not reached the same way. `String.create()` is a mistake about the TYPE and `s.create()` a
// mistake about a VALUE, so a reader told *"`String` member 'create'"* after writing `String.create()` is
// being pointed at the instance door — the very mis-aim the surface key exists to stop, arriving one word
// later. Every surface here passes `member` and means it; a STATIC one would be lying with it, which is why
// the word arrives as an argument rather than as a constant inside the sentence.
//
// ⚠ **NO PARAGRAPH HERE COUNTS THE SURFACES.** A count of them is a fact this block would state a dozen
// times with nothing checking any copy, so adding one surface would have to renumber every copy and would
// miss some. The counts go wherever they are not load-bearing: the next surface should cost these comments
// no edit at all.
//
// ⚠⚠ **IT ASSERTS NOTHING ABOUT WHAT IS ABSENT, AND THAT IS THE POINT OF THIS SHAPE.** A per-surface
// `absentClause` — a HAND-WRITTEN list of the members a surface does not have, with a reason for each — is
// a literal no gate can check, sitting inside a sentence whose other half is derived from the roster the
// dispatch gates on. **The derived half cannot rot; the literal half rots the moment anyone builds one of
// the things it says is missing** — and it rots INVISIBLY, because the sentence still reads as though it
// were authoritative. An obligation a reviewer has to remember is a rule the code should enforce.
//
// ⇒ **THE ROSTER IS THE WHOLE CLAIM.** The gate admits EXACTLY the names on it (`bufferSurfaceMemberNames`
// and its siblings, one per `MemberSurface` and each verified against its own dispatch arms by
// `rosterDriftMessage`'s panic), so "nothing else is served here" is not a second fact to keep true — it is
// what the list already says, and it
// stays true for free as the surface grows.
//
// ⚠ It deliberately does NOT hint at what might exist elsewhere. `create` being a STATIC and
// `addressableBytes` being STDLIB-ONLY are real facts, but they are facts about OTHER doors, and a door's own
// refusal is the wrong place to describe them: each is owned by the gate that enforces it, where it can be
// checked. A blanket sentence naming them here maintains them in two places at once.
function rosterRefusalSentence(typeName ByteArray, member ByteArray, roster NameRoster, noun String) returns String
	return "`{String.from(typeName)}` {noun} '{String.from(member)}' — the compiler provides {rosterList(roster)}; that list IS the surface, so nothing else is served here"
end 'rosterRefusalSentence'

// ⭐⭐ **WHY A MEMBER THAT PLAINLY EXISTS IS NOT SERVED ON THIS VALUE — the refusal `rosterRefusalSentence`
// cannot word.** A program declaring its own `type Array` makes the compile hold TWO of them
// (`SignatureIndex.contestStdlibTypeName`), and a member call resolves against the RECEIVER's own declaration
// (`Parser.memberBelongsToTheCorpus`). The roster sentence alone then says *"that list IS the surface"* about
// a value whose OTHER `Array` has exactly the member asked for — true of the surface and useless to the
// reader, who is looking at their own declaration two lines up.
//
// ⚠ It states the RULE and not only the fact, because the fact on its own reads as a compiler defect: the
// reader has to be told that the split is deliberate and which side of it they are standing on.
//
// ⭐⭐ **BOTH DECLARATIONS ARE QUOTED UNDER THE ONE BARE NAME THEY SHARE, AND IT IS THE CALLER'S TO SUPPLY.**
// A contest exists precisely because two declarations wrote the SAME name, so one spelling serves
// both halves of the sentence. It arrives as a parameter rather than as a constant because which name the
// corpus declares its record under is DISCOVERED (`ProgramSignatures.arrayRecordDeclaredName`), and a
// constant here would state a second, unchecked opinion of it.
//
// ⚠ Neither declaration is ever spelled by its COMPILED name: the library's goes by this compile's own MINT
// (`__Array`), a name no author wrote and one `Parser.requireUnreservedName` forbids them from writing, so
// quoting it would send a reader to a spelling they cannot use.
function twoArrayDeclarationsRefusal(typeName ByteArray, member ByteArray, roster NameRoster, receiverIsTheProgramsOwn bool) returns String
	let spelling = String.from(typeName)
	let programsOwn = "the `type {spelling}` this program declares"
	let librarys = "the `{spelling}` the standard library declares"
	let receiversOwn = programsOwn if receiverIsTheProgramsOwn else librarys
	let theOther = librarys if receiverIsTheProgramsOwn else programsOwn
	return "`{spelling}` {SurfaceMemberNoun} '{String.from(member)}' — this value's type is {receiversOwn}, and '{String.from(member)}' is declared on {theOther}. Declaring an `{spelling}` of your own does not replace the library's: yours answers for the bare name in YOUR files, the library's goes on answering inside `stdlib/`, and they are two different types — so a member declared on one is not served on a value of the other. What both share is the compiler's synthesized surface, which provides {rosterList(roster)}"
end 'twoArrayDeclarationsRefusal'

// ⭐ **WHERE A SIZED CONTAINER'S COUNT COMES FROM, WRITTEN ONCE.** It is the premise
// BOTH of the sized-container refusals rest on, and spelling it inside each of them would give one chance per
// builder for one copy to be reworded alone, which is exactly the drift a shared template removes for the rosters one
// surface over (`rosterRefusalSentence`). Named rather than inlined for `SurfaceMemberNoun`'s reason, three
// paragraphs down.
let SizedContainersCountComesFromItsType = "a fixed array's size is a coordinate of its TYPE, so `count()` answers `countof(Self)` and never reads the record"

// ⭐ **AND WHY THE GROWABLE RECORD IS DIFFERENT — the other half of the shared premise.** A function rather
// than a constant because the growable record's NAME is DISCOVERED (`arrayRecordDeclaredName`, whose reason
// `twoArrayDeclarationsRefusal` states), so it arrives from the caller; what must not be written twice is the
// CLAUSE, which is the half that can be reworded.
function growableCountIsItsRecordsLength(growableName ByteArray) returns String
	return "because an `{String.from(growableName)}`'s count IS its record's length"
end 'growableCountIsItsRecordsLength'

// ⭐⭐ **WHY THE MEMBER EXISTS ON THIS SURFACE AND STILL MAY NOT BE CALLED ON THIS RECEIVER — the third
// refusal `rosterRefusalSentence` cannot word.** The buffer roster serves `setLength`/`append`/
// `clear`/`remove` and must go on serving them, because the GROWABLE `Array`'s own body calls three of them
// on its own record. What the roster cannot say is that the same surface hangs off two records whose COUNT
// is answered from two different places: an `Array`'s count IS its record's `length@8`, while a sized
// container's is a coordinate of its TYPE (`countof(Self)`, folded to a literal). So a length write is the
// operation on one receiver and a self-contradiction on the other, and only a sentence holding both halves
// tells the reader which one they are standing on.
//
// ⚠ It states the RULE and not only the fact, for `twoArrayDeclarationsRefusal`'s reason: a bare *"this
// member is not served here"* about a member the surface plainly has reads as a compiler defect.
//
// ⚠ **THE SUB-LIST IS JOINED FROM `bufferLengthWritingMemberNames` THROUGH THE SHARED `rosterList`**, so the
// sentence cannot come to hold a second opinion of which members are refused — the same property
// `rosterRefusalSentence` has against the roster it renders, and the reason its hand-written `are not built`
// tail was deleted.
//
// ⚠ **ONLY THE GROWABLE NAME IS A PARAMETER, AND THE ASYMMETRY IS REAL RATHER THAN AN OVERSIGHT.** Which
// name the corpus declares its ARRAY record under is DISCOVERED (`arrayRecordDeclaredName`), so a constant
// here would be a second, unchecked opinion of it — `twoArrayDeclarationsRefusal`'s stated reason. The sized
// container's name is not discovered: it is the constant this whole rule is keyed on
// (`SignatureIndex.FixedArrayBuiltinBaseName`), and routing it through a parameter would dress one caller's
// literal up as a lookup. ⚠ Both are quoted PRE-CONTEST for that refusal's other stated reason: this compile's
// mint is a spelling `requireUnreservedName` forbids the reader from writing.
function sizedContainersBufferRefusal(member ByteArray, lengthWriters NameRoster, growableName ByteArray) returns String
	let spelling = String.from(member)
	let growable = String.from(growableName)
	return "`{String.from(ManagedMemoryTypeName)}` {SurfaceMemberNoun} '{spelling}' — this buffer is a `{String.from(FixedArrayBuiltinBaseName)}`'s own record, and {SizedContainersCountComesFromItsType}. '{spelling}' WRITES the record's length, which would leave the type saying one number while `get` and the walk answer another. A sized container's buffer refuses {rosterList(lengthWriters)} and serves every other member of the surface; the growable `{growable}`'s buffer serves all of them, {growableCountIsItsRecordsLength(growableName)}"
end 'sizedContainersBufferRefusal'

// The noun `requireSurfaceMember` names a surface's entries by. Named rather than spelled at each arm
// because every surface shares it: a literal repeated once per surface is one chance per surface for one of
// them to be reworded alone, which is the drift a shared sentence template removes one level up.
let SurfaceMemberNoun = "member"

// ⭐⭐ **WHAT A ROSTER/DISPATCH DRIFT PANICS WITH — ONE SENTENCE FOR EVERY SURFACE**, joined here for
// `rosterRefusalSentence`'s own reason one level up: a copy of this paragraph per surface would be one
// spelling too many per surface, and a panic is the one message no test ever renders, so a drifted copy of
// it would never be read until the day it was needed.
//
// The pairing it reports cannot be verified at install time — an arm is a CONTROL-FLOW POSITION, not an
// entry a table can enumerate — so the check sits at the one moment it is observable, and names both
// remedies rather than only the one the reader happens to be looking at.
//
// ⚠ **IT SAYS "SURFACE" AND NOT "RECEIVER".** Every surface is a VALUE's and none is dispatched off a
// TYPE token, so no caller is without a receiver; the sentence still names the surface because that is
// all the gate holds.
//
// ⇒ The wording stands on what is still checkable: `requireSurfaceMember` takes a SURFACE, a type NAME and
// a token, and **holds no receiver at all** — deliberately, and that is what lets every dispatch share it.
// A roster is picked and tested on the surface alone, so the sentence names the thing the gate actually has.
//
// ⚠ **EVERY CALLER BINDS THE RESULT AND THEN PANICS ON THE BINDING, and that is not a style
// choice**: `panic`'s argument must be a string LITERAL (E3005, "panic requires a string
// argument"), so `panic(rosterDriftMessage(…))` does not compile. `panic("{drift}")` is the
// interpolation that does.
function rosterDriftMessage(dispatchName String, member ByteArray, roster NameRoster, rosterFuncs String) returns String
	return "{dispatchName}: '{String.from(member)}' is on this surface's roster ({rosterList(roster)}) and no arm served it. EITHER add the arm, or take the name back out of {rosterFuncs} — the gate at the top of that dispatch admits nothing else, so this line is unreachable while the two agree"
end 'rosterDriftMessage'

// ⚠ **THERE IS NO `Set` OR `Map` ROSTER OF RECEIVER-MUTATING MEMBERS BESIDE THE `Array` HALF.** `Set` and
// `Map` are declared generics: `stdlib/Set.maxon`'s `insert`/`remove` and `stdlib/Map.maxon`'s
// `upsert`/`insert`/`remove` are ordinary members, so the ordinary parameter-mutation rule raises the same
// E3207 off the declaration rather than off a hand-written roster.

// ⚠ **THERE IS NO `List` ANSWER HERE.** `append`/`prepend`/`insert`/`removeFirst`/`removeLast`/`remove`/`clear`
// are the members of `stdlib/List.maxon` that write the record, and the ordinary parameter-mutation rule
// raises E3207 off their declarations — which is exactly what the `Set`/`Map` note above records for the
// hash tables.

// ⭐ **WHICH `__ManagedList` METHODS WRITE THEIR RECEIVER** — the same rule one surface over, and NOT the
// predicate above with two spellings added: the two surfaces name different methods (`insertFirst` vs
// `prepend`), so one function over both name sets would answer about methods its caller's container does
// not have. `count`, `isEmpty`, `head` and `tail` only READ the record; every other member links, unlinks
// or re-links a node, and each of those writes at least one of `head@0`, `tail@8` and `count@16`.
//
// ⚠ **`detach` IS ON THIS ROSTER AND IT WRITES ALL THREE.** A dispatcher arm added without its row here
// would accept `ml.detach(n)` on a read-only list where the
// identical `ml.remove(n)` is E3207 — one operation with two answers about the same receiver. It is the shape
// this file's rosters keep producing: an arm added, its roster row forgotten.
function managedListMethodMutatesReceiver(name ByteArray) returns bool
	return name.equals(ManagedListInsertFirstMethod) or name.equals(ManagedListInsertLastMethod) or name.equals(ManagedListInsertAfterMethod) or name.equals(ManagedListInsertBeforeMethod) or name.equals(ManagedListReinsertFirstMethod) or name.equals(ManagedListReinsertLastMethod) or name.equals(RemoveMethod) or name.equals(ManagedListDetachMethod) or name.equals(ClearMethod)
end 'managedListMethodMutatesReceiver'

// ⭐ **WHICH `__ManagedListNode` METHODS WRITE THEIR RECEIVER** — exactly one: `setValue` stores into
// `value@16` and releases what was there. `value`, `next` and `prev` are pure reads of the node's own
// words, and `next`/`prev` write nothing even though they hand back a handle that increfs its target — a
// refcount is not a write to THIS record.
//
// ⚠ It is its own predicate rather than an arm of the chain's, for that predicate's stated reason: the two
// surfaces name different members, and one function over both name sets answers about members its caller's
// receiver does not have.
function managedListNodeMethodMutatesReceiver(name ByteArray) returns bool
	return name.equals(ManagedListNodeSetValueMethod)
end 'managedListNodeMethodMutatesReceiver'

// ⭐⭐ **NOTHING A `__ManagedList` METHOD DOES CAN DANGLE A NODE HANDLE, SO NO PREDICATE NAMES THE
// METHODS THAT FREE A NODE.** ⚖ USER RULING 2026-08-17: nodes are
// REFCOUNTED and a handle is a second owner. `remove` and `clear` drop the CHAIN's reference; the node
// itself dies only when its last owner does, so a handle read after either is a legitimate read of a
// legitimate node — which is what `/specs/managed-list.md`'s `core.detach` asserts.

// `typeTagName` with its English indefinite article — *"an int"*, *"a String"*, *"a Character"*. It exists
// because this file's container-column refusals compose that phrase and a bare `"a {typeTagName(t)}"` reads
// *"a int"*, so without it the article would be written out once per refusal site and the three would be
// free to disagree.
//
// ⚠ Of the key types a hash table admits (`int`, `String`, `Character`), exactly one takes *"an"*, which is
// why the test is the integral one and not a vowel scan over the name. But `tag` is NOT confined to those —
// a conforming array record and any payload-free `enum` are keys too, and a `Map`'s VALUE column is held to
// the wider `slotTypeFitsOneWord`, and see `columnValueTagMatches`'s last arm for the measured reason a refused
// instance reaches here with any column type at all — so the `"a"` branch is a real default and not an
// unreachable one, and it is CORRECT for every remaining tag name (`float`, `bool`, `function`, a struct's
// name…), all of which begin with a consonant. A further admitted type whose name opens with a vowel needs
// its own arm here; nothing will crash to tell you.
function articledTypeTagName(tag ValueTypeTag) returns String
	let name = typeTagName(tag)
	return "an {name}" if tagIsIntegral(tag) else "a {name}"
end 'articledTypeTagName'

// ⭐⭐ **WHAT A CONTAINER-COLUMN REFUSAL CALLS A TYPE — its NOMINAL identity when it has one, and the
// primitive tag name otherwise.** `typeTagName` alone reads a declared ENUM as `int`, because a `named` value
// IS an integer to the tag rule (`tagIsIntegral`) — so storing a `Shade` in a `Kind` column was refused as
// *"this `Map`'s value is an int — got a 'int' value"*, a sentence that argues against itself. That is the
// exact shape `columnValueTagMatches`' header records from the ranged-alias measurement, and it is
// reachable because a `Map`'s VALUE column can carry an identity (the one-word slot gate, in
// `requireListElementType` — the chain is its sole asker).
//
// The identity comes from `Parser.declaredColumnIdentity`, and that is what MAKES the name a refusal PRINTS
// and the name the check COMPARED one string — the subject builders and the comparison call the same door
// rather than spelling one expression three times. A message naming a type the comparison did not use is how
// a diagnostic comes to describe a different program from the one that was refused.
function columnTypeName(tag ValueTypeTag, identity ByteArray) returns String
	return typeTagName(tag) if identity.isEmpty() else String.from(identity)
end 'columnTypeName'

// The same name with its indefinite article. A type with no identity keeps `articledTypeTagName`'s rule
// (whose own note records that the "an" case is exactly the integral one); a DECLARED name takes "a",
// because nothing here can know how its spelling opens and guessing would be wrong for `Item` and `Edge`
// alike. Every existing refusal is byte-identical through this door: they all name identity-less types.
function articledColumnTypeName(tag ValueTypeTag, identity ByteArray) returns String
	return articledTypeTagName(tag) if identity.isEmpty() else "a {String.from(identity)}"
end 'articledColumnTypeName'

// Append one argument to a call's THREE PARALLEL COLUMNS — its value, its `name:` label (the empty
// slice when positional), and its source span.
//
// **THE ONE WRITER OF THEM**, which is `StructLayout.addField`'s reason reaching the other family
// of parallel columns in the compiler: a caller that pushed a value and forgot a label would shift
// every later argument's label onto the wrong argument, and `slotCallArgs` would slot them
// accordingly — a silent wrong answer with no crash to find it by. There are exactly two callers,
// and the second is what made this worth a function: an argument the SOURCE wrote
// (`parseCallArgs`), and the RECEIVER an instance method call prepends (`parseCallNamed`), which is
// positional by construction and would otherwise have been a second, hand-written triple.
//
// `immutableName` is the FOURTH column (`MaxonOp.call`'s `argImmutableNames`): the binding name an
// E3207 would blame for this argument, `unblamed` when it may be written through. It rides here
// rather than being derived later for the reason the label does — it is a fact about the SYNTAX at
// this argument, and nothing downstream can recover it (see the op's own header).
function pushCallArg(args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, argAnchors TokenIndexArray, value ValueId, label ByteArray, range SourceRange, immutableName immutable ByteArray, anchorIndex ElementIndex)
	args.push(value)
	argLabels.push(label)
	argRanges.push(range)
	argImmutableNames.push(immutableName)

	// ⭐ **THE ARGUMENT'S OWN FIRST VALUE TOKEN, WHICH `argRanges` CANNOT STAND IN FOR.** A range carries a
	// line and a column; a refusal raised by a door that takes a `Token` — which every slot-type refusal does
	// — needs the token itself. `argRanges` is anchored at the argument's LABEL where it has one, and this at
	// its VALUE, because a type mismatch is about the value and the canonical position for one is where the
	// value starts (`services.error.a-handle-of-another-service-is-refused` pins exactly that column).
	argAnchors.push(anchorIndex)
end 'pushCallArg'

// ⭐ **PUSH AN ARGUMENT THE COMPILER SUPPLIED, NOT THE AUTHOR** — a parameter default's
// materialized value. It fills the three columns `pushCallArg` fills and DELIBERATELY leaves the fourth,
// `argImmutableNames`, short.
//
// The column exists to blame a BINDING for E3207, and a defaulted argument is a freshly minted call result
// that no binding owns — there is nothing to blame, which is exactly what a missing entry means
// (`argImmutableNameAt` decodes a short column as empty; it is the column's only reader).
//
// ⚠ **IT LEAVES `argAnchors` SHORT FOR THE SAME REASON, AND `callArgAnchorAt` DECODES THAT.** A defaulted
// argument has no token of the author's to point at — the value was materialized from the DECLARATION — so
// the honest anchor is the call site itself, which is what a short column means.
function pushDefaultedCallArg(args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, value ValueId, label ByteArray, range SourceRange)
	args.push(value)
	argLabels.push(label)
	argRanges.push(range)
end 'pushDefaultedCallArg'

// A `MaxonOp.call`'s `argLabels` column for a call whose every argument is POSITIONAL — one empty
// slice per argument. The op's columns are parallel by construction, so an all-positional call
// still has to say so at every index rather than carry a shorter list.
//
// The empty string is an unambiguous "no label" and not a value-masking sentinel, for the reason
// MaxonOp's `call` header gives: a parameter name can never be empty.
function emptyArgLabels(args ValueIdArray) returns NameRoster
	let labels = NameRoster.create(args.count(), zeroed: false)

	for _ in 0 upto args.count() 'each'
		labels.push(EmptySourceText)
	end 'each'

	return labels
end 'emptyArgLabels'

// A `MaxonOp.call`'s `argRanges` column when every argument shares ONE span — a call the COMPILER
// wrote, whose arguments no source token spawned individually.
//
// The per-argument span exists so a diagnostic can point at the offending argument
// (`SemanticCheck.reportArgError`), and a compiler-emitted call has no argument a user could have
// got wrong. Giving them all the call's own span is honest — that IS where each came from — and it
// keeps the column parallel, which `emitOp` requires.
function uniformArgRanges(args ValueIdArray, range SourceRange) returns SourceRangeArray
	let ranges = SourceRangeArray.create(args.count(), zeroed: false)

	for _ in 0 upto args.count() 'each'
		ranges.push(range)
	end 'each'

	return ranges
end 'uniformArgRanges'

// The slot the `value:` label of `Map.upsert(key, value:)` occupies in a synthesized `(receiver, key, value)`
// argument list — named rather than spelled inline so the desugar and the declaration it calls into
// cannot disagree about which argument carries the label. `stdlib/Map.maxon:124`.
let MapUpsertValueArgSlot = 2 as FieldIndex

let NoDefaultedArgs = 0 as ParamCount

let NoReceiverSlots = 0

function omittedParametersRemain(declared Count, written Count, receiverSlots ParamCount) returns bool
	return written + receiverSlots < declared
end 'omittedParametersRemain'

type PlannedDefaultArg
	export let label as immutable ByteArray
	export let producer as ParamDefaultProducer

	static function create(label ByteArray, producer ParamDefaultProducer) returns PlannedDefaultArg
		return Self{label: label, producer: producer}
	end 'create'
end 'PlannedDefaultArg'

typealias PlannedDefaultArgArray = Array with PlannedDefaultArg

function plannedDefaultArgs(info ParamDefaultInfo, written NameRoster, receiverSlots ParamCount) returns PlannedDefaultArgArray
	let planned = PlannedDefaultArgArray.create(0)
	let paramCount = info.paramNames.count()

	if not omittedParametersRemain(paramCount, written: written.count(), receiverSlots: receiverSlots) 'nothingOmitted'
		return planned
	end 'nothingOmitted'

	let filled = FixedBoolArray.create(paramCount)

	for i in 0 upto written.count() 'markSupplied'
		let label = try written.get(i) otherwise panic("plannedDefaultArgs: written.get OOB at {i} below count {written.count()}")
		let suppliedSlot = try argSlotPosition(info.paramNames, argIndex: (i as ParamCount) + receiverSlots, label: label) otherwise return PlannedDefaultArgArray.create(0)
		try filled.set(suppliedSlot, value: true) otherwise panic("plannedDefaultArgs: filled.set OOB at {suppliedSlot} — filled holds one entry per parameter name")
	end 'markSupplied'

	for slot in 0 upto paramCount 'planDefaults'
		let supplied = try filled.get(slot) otherwise panic("plannedDefaultArgs: filled.get OOB at {slot} despite slot < paramCount")

		if supplied 'alreadyGiven'
			continue
		end 'alreadyGiven'

		let producer = info.producerFor(slot as ParamCount)

		if producerIsRequired(producer) 'noDefault'
			continue
		end 'noDefault'

		planned.push(PlannedDefaultArg.create(slotArgLabel(info.paramNames, slot: slot as ParamCount), producer: producer))
	end 'planDefaults'

	return planned
end 'plannedDefaultArgs'

function bodyCanReadName(name ByteArray) returns bool
	return not name.equals(DiscardBindingName)
end 'bodyCanReadName'

// ⭐ **THE TOKEN A REFUSAL ABOUT ARGUMENT `index` SHOULD POINT AT** — the argument's own first value token,
// or the CALL's own anchor when the column is short. It is short for exactly one reason and it is a real
// answer rather than a gap: `pushDefaultedCallArg` supplies an argument the author never wrote, so there is
// no token of theirs to blame and the call site is the honest place to put it. `argImmutableNameAt`'s
// convention one column over, and its reason.
function callArgAnchorAt(argAnchors TokenIndexArray, index ParamCount, callAnchor ElementIndex) returns ElementIndex
	return try argAnchors.get(index) otherwise callAnchor
end 'callArgAnchorAt'

// The `argImmutableNames` column to put ON the op: the shared empty one when no argument named an
// immutable binding, else the column as built. Called once per source-written call, at the emit, so the
// overwhelming majority of calls retain nothing — the transient column the parser filled is freed instead
// of living as long as the module.
function settledImmutableArgNames(argImmutableNames NameRoster) returns NameRoster
	for name in argImmutableNames 'each'
		if not name.isEmpty() 'hasOne'
			return argImmutableNames
		end 'hasOne'
	end 'each'

	return NameRoster.create(0)
end 'settledImmutableArgNames'

// The Maxon comparison operator a comparison token maps to. Only called for tokens
// `comparisonOperator` classified as comparisons; anything else is a climber bug, so
// it panics rather than guessing. Kept separate from `infixMaxonOp` because a
// comparison is a distinct op family (`MaxonOp.compare`), not a `binOp` opcode.
function infixCmpOp(kind TokenKind) returns MaxonCmpOp
	if kind == TokenKind.equalsEquals 'eq'
		return MaxonCmpOp.eq
	end 'eq'

	if kind == TokenKind.bangEquals 'ne'
		return MaxonCmpOp.ne
	end 'ne'

	if kind == TokenKind.lessThan 'lt'
		return MaxonCmpOp.lt
	end 'lt'

	if kind == TokenKind.greaterThan 'gt'
		return MaxonCmpOp.gt
	end 'gt'

	if kind == TokenKind.lessEquals 'le'
		return MaxonCmpOp.le
	end 'le'

	if kind == TokenKind.greaterEquals 'ge'
		return MaxonCmpOp.ge
	end 'ge'

	panic("infixCmpOp: token '{kind.rawValue}' is not a comparison operator — comparisonOperator must gate this call")
end 'infixCmpOp'

// The source spelling of a comparison operator, for the E3066 union-comparison message. A `union`
// value has NO comparison of ANY kind: `==`/`!=` carry no synthesized equality, and `<`/`>`/`<=`/`>=`
// would compare two BOX ADDRESSES — a pointer answer to a question about values, the same
// reference-equality hazard `comparableOperands` refuses for two structs. So EVERY operator is named
// here, not only the two the corpus happens to exercise — the message stays honest whichever one the
// author wrote.
function comparisonOpSpelling(op MaxonCmpOp) returns String
	return match op 'op'
		eq gives "=="
		ne gives "!="
		lt gives "<"
		gt gives ">"
		le gives "<="
		ge gives ">="
	end 'op'
end 'comparisonOpSpelling'

// The source spelling of the reference-identity operator, for its two diagnostics — `comparisonOpSpelling`'s
// twin, and it is keyed on a BOOL rather than on an op because `is not` is two TOKENS the climber fuses into
// one operator (see `identityOperator`): there is no third thing for a token kind to name. Both messages name
// what the author WROTE, so `a is not 3` is not told about an `is` it does not contain.
function referenceIdentityOpSpelling(negate bool) returns String
	return "is not" if negate else "is"
end 'referenceIdentityOpSpelling'

// Which compiler-owned layouts a file names — the answer `fileNamesProducerMask` walks the tokens ONCE to
// build, rather than a walk per probe.
//
// ⚠ The LAYOUT bits name the types the compiler owns outright — `__ManagedFile`, `__ManagedDirectory` and
// `__ManagedSocket`. A type the corpus declares needs no bit: the ordinary declaration fold registers it in
// every program.
export typealias ProducerMask = int(0 to 255)

let ManagedFileProducerBit = 1 as ProducerMask
let ManagedDirectoryProducerBit = 2 as ProducerMask

// ⭐ **A `<Enum>.allCaseNames` — the fourth question this walk answers, and the only one that names no
// compiler-owned LAYOUT.** What it registers is the `Array with String` INSTANCE the member materializes,
// which — like a bare `[…]` literal's — has no typealias in the file to be interned from. It rides this
// walk rather than the declaration sweep's loop for that loop's own stated reason: `recordScannedType` and
// `recordScannedEnum` consume a declaration WHOLE, so a `Color.allCaseNames` inside a method body is
// invisible to an arm written there, and the instance would go uninterned in exactly the programs that
// declare their enums and their uses together.
let AllCaseNamesProducerBit = 4 as ProducerMask

// ⭐ **A `<Enum>.allCases` — the FIFTH question, and `allCaseNames`' twin in every respect but its element
// type.** What it registers is an `Array with <Enum>` instance PER DECLARED ENUM, which the sweep cannot
// narrow to one: the member's base may be a dotted companion (`Shape.unionCases.allCases`) and the enum
// registry is still being built while this walk runs. So the bit is only NOTED here and the over-interning
// waits for the whole program, exactly as `noteWellKnownInstanceNeeds`' do and for the same measured
// O(files × types) reason (`ProgramSignatures.internLiteralContainerInstances`).
let AllCasesProducerBit = 8 as ProducerMask

// ⭐ **A `__ManagedSocket` — the THIRD compiler-owned LAYOUT this walk answers for**, and the third of the
// three bits above that names a type the compiler still owns outright. Its own bit rather than a third name
// in either of those probes, for `atManagedDirectoryProducer`'s stated reason: the three register DIFFERENT
// layouts, so a file that names only `__ManagedFile` must not acquire a socket layout. It is numbered here,
// after the two `<Enum>` questions, because a bit's VALUE is its declaration order and renumbering the
// existing four to keep the layout probes adjacent would move facts nothing else in this file depends on.
let ManagedSocketProducerBit = 16 as ProducerMask
let ManagedHostResourceProducerBit = 32 as ProducerMask
let MutableMarkerProducerBit = 64 as ProducerMask
let MutableFunctionValueProducerBit = 128 as ProducerMask

// ⚠ **DERIVED, NOT TRANSCRIBED.** It was `15` — a hand-summed roster of four bits, and the fifth would have
// had to remember to change it. Nothing would have failed if it had not: the walk's early exit simply stops
// firing, so the only symptom is a full scan of every file, which no test can see. `or` over the bits
// themselves cannot go stale.
let AllProducerBits = (ManagedFileProducerBit or ManagedDirectoryProducerBit or AllCaseNamesProducerBit or AllCasesProducerBit or ManagedSocketProducerBit or ManagedHostResourceProducerBit or MutableMarkerProducerBit or MutableFunctionValueProducerBit) as ProducerMask

// --- Character literals ---
//
// The lexer hands the parser the RAW bytes between the quotes, escapes undecoded, under
// `TokenKind.charLiteral` — and it uses the SAME token kind for a BLOCK LABEL (`'check'`). Nothing
// distinguishes them lexically, and nothing needs to: the two never occur in the same grammatical
// position. A label is consumed by the statement parser at the exactly one place each construct
// allows it (after an `if`/`while` condition, after `else`, after `end`, after `break`/`continue`);
// a character literal is consumed by `parsePrimary`, which runs only where an OPERAND is required.
// `if x 'check'` therefore parses `x` as the condition — the climber stops at the `'check'` because
// a charLiteral is not an infix operator — and `if cp == '-' 'dash'` parses `'-'` as the
// comparison's right operand because that IS an operand position, then `'dash'` as the label.

// What a character literal's body decodes to.
// ⚠ **THE TWO CASES ARE A FACT ABOUT BYTE COUNT AND NOT A FACT ABOUT TYPE.** Every character literal is a
// `Character` (`parseCharLiteral`), and an integer-expecting position converts it to its codepoint
// (`integerizedOperand`); the split survives only inside `charLiteralBytes`,
// which folds both arms to the literal's UTF-8 bytes.
union CharLiteralValue
	// A single byte — an ASCII character, or an escape that produces one.
	byte(value Byte)

	// `''`. No character, and no value to give it.
	empty

	// A literal whose UTF-8 body is more than one byte: `'é'`, `'中'`, an emoji, an EGC. The BYTES ride the
	// case because the decode already has them and re-deriving them at the emit site would be the same
	// escape walk twice.
	multiByte(bytes immutable ByteArray)

	// A `\` escape this decoder does not know.
	badEscape(text String)

	// A `\xNN`/`\uNNNN` escape with the wrong number of hex digits. It carries the text the author
	// actually wrote (`\u00`, `\xZZ`), its OFFSET in the literal's body, and the MARKER byte after the
	// backslash — and it is its OWN case rather than a `badEscape`: the escape's SHAPE is recognized, only
	// its digit count is wrong, and the canonical corpus pins a distinct diagnostic for it (E1004,
	// `specs/unicode-escape.md:151`, `specs/hex-escape.md:147`) where an unrecognized `\q` is E2016.
	badDigitEscape(text String, offset ByteOffset, marker Byte)

	malformedText
end 'CharLiteralValue'

// Decode a character-literal body. There is no split on width: every literal is a `Character` and an
// integer position converts it, so what this returns is a DECODING, and its two value arms differ only in
// how many bytes the character occupies.
function decodeCharLiteral(raw ByteArray) returns CharLiteralValue
	let decoded = decodeEscapes(raw, kind: LiteralEscapeKind.characterLiteral)

	match decoded 'd'
		bytes(buf) then return charValueOf(buf)
		unknownEscape(text) then return CharLiteralValue.badEscape(text)
		badDigitEscape(text, offset, marker) then return CharLiteralValue.badDigitEscape(text, offset: offset, marker: marker)
		malformedText then return CharLiteralValue.malformedText
	end 'd'
end 'decodeCharLiteral'

function charValueOf(buf immutable ByteArray) returns CharLiteralValue
	if buf.count() == 0 'empty'
		return CharLiteralValue.empty
	end 'empty'

	if buf.count() > 1 'wide'
		return CharLiteralValue.multiByte(buf)
	end 'wide'

	let b = try buf.get(0) otherwise panic("charValueOf: count()==1 but get(0) failed")
	return CharLiteralValue.byte(b)
end 'charValueOf'

// The result of decoding a quoted body's escape sequences.
union DecodedLiteral
	bytes(buf immutable ByteArray)
	unknownEscape(text String)

	// A `\xNN`/`\uNNNN` escape with the wrong number of hex digits — see `CharLiteralValue.badDigitEscape`
	// for why the digit count gets a case of its own rather than riding `unknownEscape`.
	badDigitEscape(text String, offset ByteOffset, marker Byte)

	malformedText
end 'DecodedLiteral'

// The escape sequences a quoted literal accepts, decoded to their bytes. One set serves both forms, so a
// character literal and a string literal read escapes the same way — which is the whole reason this is a
// shared decoder rather than a char-only one.
//
// ⚠ **"THE SAME WAY" IS TRUE OF THE TABLE, NOT OF EVERY ROW IN IT.** `kind` names the literal form being
// decoded and is threaded to `escapeByte` for the one row that differs: `\{`/`\}` are a fact about
// INTERPOLATION, so a character literal refuses them. It is not optional at any call site, so a form
// cannot be decoded without saying which form it is.
//
// An UNRECOGNIZED escape is REPORTED, not copied through: there is no separate validation pass behind
// this one, and silently turning `'\q'` into two bytes would surface as the far more confusing
// "multi-byte character literal".
function decodeEscapes(raw ByteArray, kind LiteralEscapeKind) returns DecodedLiteral
	let buf = ByteArray.create(0) as isolated ByteArray
	let len = raw.count()
	var i = 0 as ByteOffset
	var hasNonAscii = false

	modify buf 'fill'
		while i < len as ByteOffset 'decode'
			let ch = try raw.get(i) otherwise panic("decodeEscapes: i < len just held but get({i}) failed")

			if ch != Backslash or i + 1 >= len as ByteOffset 'literalByte'
				buf.push(ch)
				hasNonAscii = hasNonAscii or ch >= AsciiCeiling
				i = i + 1
				continue
			end 'literalByte'

			let next = try raw.get((i + 1) as ElementIndex) otherwise panic("decodeEscapes: i + 1 < len just held but get({i + 1}) failed")

			// ⭐ **`\xNN` AND `\uNNNN` — THE TWO ESCAPES THAT SPELL A VALUE IN HEX DIGITS**, and the only ones
			// that can produce MORE THAN ONE BYTE, which is why neither can ride `escapeByte`'s table: that
			// maps one letter to one fixed byte, with no digits to read and only a single byte to answer with.
			// In a REGULAR literal BOTH name a CODEPOINT and both are
			// UTF-8 ENCODED, so `"e\u0301"` is three bytes and one grapheme; in a `b"…"` literal the same
			// escape means one LATIN-1 byte and is decoded by `appendByteStringEscape` instead.
			//
			// ⚠ **THE 2-DIGIT MARKER SPLITS THE SAME WAY.** The language prints `"\xC0"` as the two bytes `C3
			// 80` and `'\xC0'` as the character `À` — a CODEPOINT, UTF-8 encoded, exactly as its 4-digit twin
			// — while `b"\xC0"` is the single raw byte `C0`. Two spellings of one syntax with genuinely
			// different meanings — see that function's header — so they stay two decoders on purpose, sharing
			// the marker's digit COUNT, the digit VALIDATION and the digit ARITHMETIC, and nothing else.
			//
			// ⚠ **A MALFORMED DIGIT ESCAPE IS ITS OWN DIAGNOSTIC (E1004), NOT THE UNKNOWN-ESCAPE ONE.** `\x`
			// and `\u` ARE escapes this decoder recognizes — what is wrong is the DIGIT COUNT — so reporting
			// one as *"unknown escape sequence"* would name the wrong fault and quote only two of the
			// characters the author wrote. The canonical corpus pins both spellings
			// (`specs/unicode-escape.md:151`, `specs/hex-escape.md:147`).
			if next == LowerX or next == LowerU 'digitEscape'
				let form = digitEscapeOf(next)

				if not hexEscapeWellFormed(raw, at: i, len: len as ByteOffset, form: form) 'malformed'
					return DecodedLiteral.badDigitEscape(availableDigitEscapeText(raw, at: i, len: len as ByteOffset, form: form), offset: i, marker: next)
				end 'malformed'

				appendUtf8Encoded(buf, codepoint: digitEscapeValue(raw, at: i, form: form))
				hasNonAscii = true
				i = i + form.width
				continue
			end 'digitEscape'

			match escapeByte(next, kind: kind) 'esc'
				byte(b) then buf.push(b)
				unknown then return DecodedLiteral.unknownEscape("\\{String.from(byteSlice(next))}")
			end 'esc'

			i = i + 2
		end 'decode'
	end 'fill'

	if hasNonAscii and not utf8IsWellFormed(buf) 'malformed'
		return DecodedLiteral.malformedText
	end 'malformed'

	return DecodedLiteral.bytes(freeze buf)
end 'decodeEscapes'

// ⭐ **UTF-8 ENCODE a codepoint into `buf`** — the inverse of `decodeUtf8Sequence`, and the dual of
// `stdlib/Character.maxon`'s `fromCodepoint` (`:170-235`), whose four-way ladder and bit layout this is.
// Its one caller is the digit escape (`\xNN`/`\uNNNN`) in a regular literal, which is the only place the compiler
// turns a codepoint back into bytes: every other source character is ALREADY UTF-8 in the file and is
// copied through verbatim.
function appendUtf8Encoded(buf ByteArray, codepoint FullRangeInt)
	if codepoint < Utf8OneByteCeiling 'ascii'
		buf.push(codepoint as Byte)
		return
	end 'ascii'

	if codepoint < Utf8TwoByteCeiling 'twoByte'
		buf.push((Utf8LeadTwoByteFloor or (codepoint shr Utf8ContinuationBits)) as Byte)
		buf.push(utf8ContinuationByte(codepoint, shift: 0))
		return
	end 'twoByte'

	if codepoint < Utf8ThreeByteCeiling 'threeByte'
		buf.push((Utf8LeadThreeByteFloor or (codepoint shr Utf8ThreeByteHighShift)) as Byte)
		buf.push(utf8ContinuationByte(codepoint, shift: Utf8ContinuationBits))
		buf.push(utf8ContinuationByte(codepoint, shift: 0))
		return
	end 'threeByte'

	buf.push((Utf8LeadFourByteFloor or (codepoint shr Utf8FourByteHighShift)) as Byte)
	buf.push(utf8ContinuationByte(codepoint, shift: Utf8ThreeByteHighShift))
	buf.push(utf8ContinuationByte(codepoint, shift: Utf8ContinuationBits))
	buf.push(utf8ContinuationByte(codepoint, shift: 0))
end 'appendUtf8Encoded'

// One CONTINUATION byte: `0b10` followed by the six payload bits at `shift`.
function utf8ContinuationByte(codepoint FullRangeInt, shift FullRangeInt) returns Byte
	return (Utf8ContinuationFloor or ((codepoint shr shift) and Utf8ContinuationMask)) as Byte
end 'utf8ContinuationByte'

// The byte a two-character escape `\<c>` denotes, or `unknown`.
union EscapeByte
	byte(value Byte)
	unknown
end 'EscapeByte'

// The escape table BOTH decoders consult — `decodeEscapes` for a character literal and a string, and
// `appendByteStringEscape` for a `b"…"` blob — so the set cannot come to differ by decoder. `kind` is the
// one coordinate on which the forms legitimately disagree; see the brace arm.
function escapeByte(c Byte, kind LiteralEscapeKind) returns EscapeByte
	if c == LowerN 'newline'
		return EscapeByte.byte(NewlineByte)
	end 'newline'

	if c == LowerT 'tab'
		return EscapeByte.byte(TabByte)
	end 'tab'

	if c == LowerR 'carriageReturn'
		return EscapeByte.byte(CarriageReturnByte)
	end 'carriageReturn'

	if c == DigitZero 'nul'
		return EscapeByte.byte(NulEscapeByte)
	end 'nul'

	// The self-escapes: a backslash, and the delimiters a literal must be able
	// to contain — the single quote that would close a character literal, the double quote
	// that would close a string. Every literal form admits all three.
	if c == Backslash or c == SingleQuote or c == DoubleQuote 'selfEscape'
		return EscapeByte.byte(c)
	end 'selfEscape'

	// ⭐⭐ **THE BRACE ESCAPES BELONG TO THE ONE LITERAL FORM THAT INTERPOLATES, AND TO NO OTHER — WHICH
	// IS THE WHOLE REASON THIS TABLE TAKES A KIND.** `\{` spells a literal brace only because a bare
	// `{` would OPEN AN INTERPOLATION; where nothing interpolates there is no brace to rescue, so the
	// escape names no known escape and is refused. `/specs/character-type.md:313-328` lists a
	// character literal's escapes as `\n \t \\ \'` — no brace — and the brace is refused in BOTH
	// non-interpolating forms ( `'\{'` and `b"a\{b"` are each `error E1004: Invalid escape sequence
	// '\{' in …`).
	//
	// ⚠ **A SHARED TABLE WITH NO KIND CANNOT STATE A PER-KIND FACT.** Sharing one decoder across every
	// quoted body is right; the kind is the one coordinate on which the forms genuinely differ. Without it
	// the string's braces would reach the character literal AND the byte string. The exhaustive
	// `match` below is the guard: a fourth literal form cannot be added and left silently inheriting an
	// answer, which is what a `default` here would have bought.
	if c == LeftBrace or c == RightBrace 'interpolationBrace'
		return match kind 'interpolates'
			stringInterpolation gives EscapeByte.byte(c)
			characterLiteral or
			byteStringLiteral gives EscapeByte.unknown
		end 'interpolates'
	end 'interpolationBrace'

	return EscapeByte.unknown
end 'escapeByte'

// The escape text a malformed digit-escape diagnostic QUOTES: the backslash plus every byte the literal
// actually has, up to the whole a well-formed escape occupies. `'\u00'` quotes `\u00` — what the author
// wrote — rather than the `\uNNNN` they failed to write or a bare `\u`.
function availableDigitEscapeText(raw ByteArray, at ByteOffset, len ByteOffset, form DigitEscape) returns String
	var available = form.width

	if len - at < form.width 'truncated'
		available = len - at
	end 'truncated'

	return String.from(try raw.slice(at, endIndex: ((at + available) as ElementIndex)) otherwise panic("availableDigitEscapeText: [{at}, {at + available}) is inside a {len}-byte body by construction"))
end 'availableDigitEscapeText'

// ⭐ **THE ONE MALFORMED-DIGIT-ESCAPE DIAGNOSTIC (E1004), built where its three variables meet.** `text`
// is what the author wrote, `kind` is the literal FORM they wrote it in, `marker` is WHICH digit escape
// they wrote — and the message exists once so a character literal and a string literal, and `\x` and
// `\u`, cannot come to word the same fault differently. The canonical corpus pins both markers' spelling.
// ⚠⚠ **THE COLUMN IS `tok.column + <the escape's byte offset in the BODY>`, WHICH IS SHORT OF THE ESCAPE
// BY THE OPENING DELIMITER'S WIDTH — 1 for `'` and `"`, 2 for `b"`. THAT IS THE RULE, NOT A DEFECT, AND
// NO `maxoncstderr` BLOCK CAN DEFEND IT** (every canonical pin puts the escape at body offset 0,
// where the two addends' disagreement is invisible). For `b"AB\xG0"` at token column 10 the `\`
// sits at source column 14 and this says 12.
// ⭐ `token.column + i` is applied UNIFORMLY to all three literal forms, byte strings included.
// `specs/unicode-escape.md`'s `nonfirst-escape-column` case pins that answer, so it stays a fact under
// test.
function invalidDigitEscapeError(text String, kind LiteralEscapeKind, offset ByteOffset, marker Byte, tok Token) returns SourceParseError
	let form = digitEscapeOf(marker)
	return SourceParseError.invalidDigitEscape("Invalid {form.noun} escape '{text}': expected {form.digitCount} hex digits in {literalEscapeKindPhrase(kind)}", line: tok.line, column: tok.column + (offset as ColumnNumber))
end 'invalidDigitEscapeError'

function malformedLiteralTextError(kind LiteralEscapeKind, tok Token) returns SourceParseError
	return SourceParseError.malformedLiteralText("Malformed UTF-8 in {literalEscapeKindPhrase(kind)}: a surrogate (U+D800 to U+DFFF) or an invalid byte sequence is not a Unicode scalar value", line: tok.line, column: tok.column)
end 'malformedLiteralTextError'

// ⭐ **WHICH LITERAL FORM A MALFORMED DIGIT ESCAPE WAS WRITTEN IN — AN ENUM, NOT THREE LOOSE STRINGS.**
// The three forms that admit a digit escape are one closed set, so they are one type rather than three
// constants a caller may or may not reach for: `kind` has no default at any of the five call sites, and
// typing it this way additionally makes a HAND-SPELLED phrase a compile error instead of a fourth
// wording. Same reasoning as `BytePackedProducer` below, which this file already settled.
//
// ⚠ The byte-string arm is here rather than in that decoder: one rule with two validators is how `b"\xG0"`
// comes to be told it is "unsupported" while `"\xG0"` is told what is actually wrong with it.
enum LiteralEscapeKind
	characterLiteral
	stringInterpolation
	byteStringLiteral
end 'LiteralEscapeKind'

// The trailing context phrase the diagnostic names. Exhaustive over the enum with no `default`, so a
// fourth literal form cannot be added and left silently sharing another form's wording.
function literalEscapeKindPhrase(kind LiteralEscapeKind) returns String
	return match kind 'kind'
		characterLiteral gives "character literal"
		stringInterpolation gives "string interpolation"
		byteStringLiteral gives "byte string literal"
	end 'kind'
end 'literalEscapeKindPhrase'

// ⭐ **WHAT AN INTRINSIC THAT TAKES A COMPILE-TIME NAME REQUIRES, AS THE DIAGNOSTIC SPELLS IT.**
// Deliberately narrower than `typeTagName(ValueTypeTag.string)`: a `String` BINDING is refused too, so a
// message naming only the type would be a rule that does not match the one being enforced.
//
// TWO askers, one sentence. `panic(…)` needs a literal so the abort line can live in `.rdata` and print
// from a process whose heap may be the thing that failed (`parsePanicMessage`);
// `__DebugStream.nameId(…)` needs one so the name never exists at run time at all
// (`parseDebugStreamNameId`). A second copy of the wording would be a second thing that can come to
// describe the rule differently.
let StringLiteralRequirement = "a string literal"
let NumberOperandRequirement = "a number"
let IntegerOperandRequirement = "an integer"

// ⭐ What a `__Raw` operand refusal calls its two non-value requirements. Constants for
// `StringLiteralRequirement`'s reason: a wording a `maxoncstderr` block pins belongs in one place,
// not at the throw.
let RawConstantOperandRequirement = "a compile-time integer constant"
let RawScratchSizeRequirement = "a positive whole number of 8-byte slots"
let RawExitCodeRequirement = "the exit code of a RuntimeAbort case"

// ⭐ **THE `panic at <file>:<line>: <text>\n` LINE A `panic(…)` HANDS THE RUNTIME, IN THE ONE OF TWO FORMS
// ITS ARGUMENT ADMITS.** `mrt_panic` reads a NUL-terminated cstr and does not care which; what differs is
// only WHERE the bytes are, and therefore which op carries them.
union PanicMessage
	// A plain string literal — the whole line is a parse-time constant, interned as an immortal `.rdata`
	// cstr by `LowerMaxonToStd.lowerPanicAbort` and carried by `MaxonOp.panicAbort`.
	baked(line immutable ByteArray)

	// An INTERPOLATION — the line is assembled on the heap at run time and this is the address of its
	// bytes, carried by `MaxonOp.panicAbortValue`.
	rendered(linePtr ValueId)
end 'PanicMessage'

// One byte as a one-element ByteArray, so an offending escape can be interpolated into a
// diagnostic as text.
function byteSlice(b Byte) returns immutable ByteArray
	let one = ByteArray.create(1, zeroed: false) as isolated ByteArray

	modify one 'fill'
		one.push(b)
	end 'fill'

	return freeze one
end 'byteSlice'

// The ASCII bytes the escape decoder produces and recognizes. Named rather than spelled as
// bare numbers or as `'\\'` character literals — the parser cannot bootstrap its own
// character-literal syntax to define the table that decodes it.
let Backslash = 92
let SingleQuote = 39
let DoubleQuote = 34
let LeftBrace = 123
let RightBrace = 125
let LowerN = 110
let LowerT = 116
let LowerR = 114
let DigitZero = 48
let NewlineByte = 10 as Byte
let TabByte = 9 as Byte
let CarriageReturnByte = 13 as Byte
let NulEscapeByte = 0 as Byte

// --- Byte-string literal decode (`b"…"`) ---
//
// A byte-string decodes DIFFERENTLY from a String literal: a String keeps its source UTF-8 bytes verbatim,
// while a byte-string maps each SOURCE CODEPOINT to one Latin-1 byte — so a two-byte UTF-8 `À` becomes the
// single byte 0xC0. Escapes resolve as in a string (`escapeByte`) plus the byte-exact `\xNN` and the
// `\uNNNN` codepoint escape. A codepoint above 0xFF (`b"Ā"`, a `\uNNNN` naming one, an emoji) has no
// single-byte encoding and is REJECTED E1004 rather than best-fit-transliterated.

// The high-bit threshold: a source byte `< AsciiCeiling` is a bare ASCII byte; `>= AsciiCeiling` opens a
// multi-byte UTF-8 sequence. A byte-string codepoint must fit in `[0, ByteCodepointMax]` (Latin-1).
let AsciiCeiling = 128
let WordSignBitShift = 63
let ByteCodepointMax = 255

// The low byte of a codepoint (its Latin-1 encoding for a valid one; a harmless recovery value otherwise).
let CodepointLowByteMask = 255 as FullRangeInt
let LowerX = 120
let LowerU = 117

// A hex nibble is 4 bits; `\xNN` = `\` `x` + 2 hex digits (4 bytes), `\uNNNN` = `\` `u` + 4 hex digits (6).
let HexNibbleBits = 4 as FullRangeInt
let HexEscapeDigits = 2
let UniEscapeDigits = 4
let EscapeMarkerBytes = 2

// The noun each digit escape goes by in its E1004 diagnostic — the canonical corpus pins both
// (`specs/hex-escape.md:147`, `specs/unicode-escape.md:151`).
let HexEscapeNoun = "hex"
let UniEscapeNoun = "unicode"

// ⭐ **THE TWO DIGIT ESCAPES, KEYED BY THE MARKER BYTE AFTER THE BACKSLASH.** Everything that varies
// between `\x` and `\u` is a function of that ONE byte — how many hex digits follow it, how many source
// bytes a well-formed one occupies, and what a diagnostic calls it — so all three derivations are made
// together, once. Three callers ask (the regular-literal decoder, the byte-string decoder, and the
// malformed-escape diagnostic they share), and a second copy of the mapping is exactly how a decoder that
// reads 2 digits and a message that says "expected 4" arise.
type DigitEscape
	export let digitCount as ByteOffset
	export let noun as String

	// ⭐ **HOW WIDE A WELL-FORMED DIGIT ESCAPE IS, WRITTEN DOWN ONCE.** It was `EscapeMarkerBytes +
	// digitCount` spelled out at FOUR sites — the well-formedness bound, the quoted-text window, the digit
	// walk's end, and each decoder's advance — and the desync symptom is WRONG BYTES, not a compile error:
	// a future escape whose marker or digit run is a different size edits one of them and the others keep
	// stepping the old distance.
	export let width as ByteOffset

	static function of(digitCount ByteOffset, noun String) returns Self
		return Self{digitCount: digitCount, noun: noun, width: EscapeMarkerBytes + digitCount}
	end 'of'
end 'DigitEscape'

function digitEscapeOf(marker Byte) returns DigitEscape
	if marker == LowerX 'hex'
		return DigitEscape.of(HexEscapeDigits, noun: HexEscapeNoun)
	end 'hex'

	if marker == LowerU 'unicode'
		return DigitEscape.of(UniEscapeDigits, noun: UniEscapeNoun)
	end 'unicode'

	panic("digitEscapeOf: byte {marker} is no digit-escape marker — only `\\x` and `\\u` spell a value in hex digits")
end 'digitEscapeOf'

// The UTF-8 masks, shifts, lead floors and codepoint ceilings this file's compile-time decoder
// (`decodeUtf8Sequence`) and encoder (`appendUtf8Encoded`) read are declared ONCE, by
// `Runtime/GraphemeRuntime.maxon`, alongside the runtime decoder that reads the same numbers — see that
// file's header for why two copies of one encoding's bit layout is the shape that goes silently wrong.

// The lowercase hex digits and the minimum width a `U+NNNN` codepoint renders at.
let HexDigitsLower = "0123456789abcdef"
let HexRadix = 16 as FullRangeInt
let CodepointHexMinDigits = 4 as ByteOffset
let AsciiZeroByte = 48 as Byte

// One decoded UTF-8 sequence: the codepoint and how many source bytes it occupied (1..4).
type Utf8Sequence
	export let codepoint as FullRangeInt
	export let byteLength as ByteOffset

	static function of(codepoint FullRangeInt, byteLength ByteOffset) returns Self
		return Self{codepoint: codepoint, byteLength: byteLength}
	end 'of'
end 'Utf8Sequence'

// The answer `Parser.charLiteralCodepoint` gives: the single Unicode codepoint a character literal denotes,
// or `cluster` for an EGC that is a SEQUENCE of them (a ZWJ family emoji, a regional-indicator flag). A
// `cluster` is a `Character` and nothing else — it has no integer reading — so it is a CASE here rather than
// a sentinel codepoint no caller could tell from a real one.
union CharLiteralCodepoint
	codepoint(value FullRangeInt)
	cluster
end 'CharLiteralCodepoint'

// ⭐ Decode a `b"…"` literal body (the raw bytes between the quotes, escapes undecoded) to its Latin-1 byte
// payload. `tok` positions the E2015 an UNKNOWN escape raises (the byte-string twin of `decodeEscapes`'
// `unknownEscape`) and the E1004 a MALFORMED digit escape raises.
function decodeByteStringLiteral(raw ByteArray, tok Token) returns immutable ByteArray throws SourceParseError
	let buf = ByteArray.create(0) as isolated ByteArray
	let len = raw.count()
	var i = 0 as ByteOffset

	modify buf 'fill'
		while i < len as ByteOffset 'decode'
			let ch = try raw.get(i) otherwise panic("decodeByteStringLiteral: i < len just held but get({i}) failed")

			if ch != Backslash or i + 1 >= len as ByteOffset 'notEscape'
				i = try appendLiteralByteStringByte(buf, raw: raw, at: i, ch: ch, tok: tok)
				continue
			end 'notEscape'

			i = try appendByteStringEscape(buf, raw: raw, at: i, len: len as ByteOffset, tok: tok)
		end 'decode'
	end 'fill'

	return freeze buf
end 'decodeByteStringLiteral'

// A NON-escape byte at `at`: a bare ASCII byte is emitted verbatim; a `>= AsciiCeiling` byte opens a
// multi-byte UTF-8 sequence collapsed to its ONE Latin-1 byte (codepoint > 0xFF ⇒ E1004). Returns the
// index of the next byte to decode.
function appendLiteralByteStringByte(buf ByteArray, raw ByteArray, at ByteOffset, ch Byte, tok Token) returns ByteOffset throws SourceParseError
	if ch < AsciiCeiling 'ascii'
		buf.push(ch)
		return at + 1
	end 'ascii'

	let seq = decodeUtf8Sequence(raw, start: at)
	try requireByteCodepoint(seq.codepoint, tok: tok)
	buf.push((seq.codepoint and CodepointLowByteMask) as Byte)
	return at + seq.byteLength
end 'appendLiteralByteStringByte'

// An escape at `at` (`raw[at]` is `\`, and `at + 1 < len`). `\xNN` emits an exact raw byte; `\uNNNN` maps a
// codepoint to one Latin-1 byte (> 0xFF ⇒ E1004); every other `\c` resolves through the shared `escapeByte`
// table (an unknown one is E2015). Returns the index of the next byte to decode.
function appendByteStringEscape(buf ByteArray, raw ByteArray, at ByteOffset, len ByteOffset, tok Token) returns ByteOffset throws SourceParseError
	let next = try raw.get((at + 1) as ElementIndex) otherwise panic("appendByteStringEscape: at + 1 < len just held but get({at + 1}) failed")

	if next == LowerX or next == LowerU 'digitEscape'
		let form = digitEscapeOf(next)

		// The SAME malformed-escape diagnostic the regular-literal decoder reaches (`decodeEscapes`), named
		// with this literal's own `LiteralEscapeKind`. The only difference between the two routes is
		// DELIVERY — `decodeEscapes` serves both character literals and strings, so it cannot name the kind
		// and defers through `DecodedLiteral.badDigitEscape` for its caller to; this decoder serves exactly
		// one literal form, so it throws on the spot.
		if not hexEscapeWellFormed(raw, at: at, len: len, form: form) 'malformed'
			throw invalidDigitEscapeError(availableDigitEscapeText(raw, at: at, len: len, form: form), kind: LiteralEscapeKind.byteStringLiteral, offset: at, marker: next, tok: tok)
		end 'malformed'

		let value = digitEscapeValue(raw, at: at, form: form)

		// ⚠ THE TWO MARKERS MEAN DIFFERENT THINGS HERE, which is the whole reason this decoder exists
		// beside `decodeEscapes`. `\xNN` names the RAW BYTE, which two hex digits cannot put out of range;
		// `\uNNNN` names a CODEPOINT, which has a Latin-1 encoding only up to 0xFF.
		if next == LowerU 'codepoint'
			try requireByteCodepoint(value, tok: tok)
		end 'codepoint'

		buf.push((value and CodepointLowByteMask) as Byte)
		return at + form.width
	end 'digitEscape'

	match escapeByte(next, kind: LiteralEscapeKind.byteStringLiteral) 'esc'
		byte(b) then buf.push(b)
		unknown then throw SourceParseError.unsupported("the escape sequence '\\{String.from(byteSlice(next))}' in a byte string literal is not a recognized escape", line: tok.line, column: tok.column)
	end 'esc'

	return at + EscapeMarkerBytes
end 'appendByteStringEscape'

// Reject a codepoint with no single-byte Latin-1 encoding (`> 0xFF`) as E1004. The message names the
// codepoint in the oracle's `U+NNNN` (lowercase-hex, ≥ 4-digit) form.
function requireByteCodepoint(codepoint FullRangeInt, tok Token) throws SourceParseError
	if codepoint > ByteCodepointMax 'tooBig'
		throw SourceParseError.byteStringCodepointRange(byteStringCodepointRangeMessage(codepoint), line: tok.line, column: tok.column)
	end 'tooBig'
end 'requireByteCodepoint'

// ⭐⭐ **A BYTE-PACKED RECORD IS A VALUE OF `Array with Byte` ONLY WHILE THIS FILE'S `Byte` STRIDES ONE
// BYTE** — the E2015 both byte-packed PRODUCERS emit, from the one rule function
// (`Parser.requireBytePackedRecordStridesLikeThisFilesByte`) all three of their doorways ask, so no doorway
// can come to describe the defect differently.
//
// ⚠⚠ **THERE ARE TWO PRODUCERS AND BOTH ARE REFUSED.** A `b"…"` blob is
// byte-packed by CONSTRUCTION; `__ManagedMemory.create(count, elementSize: 1)` is byte-packed by its own
// ARGUMENT — `__managed_mem_create` stamps `element_size@24` from it while the front end types the result as
// this file's `Array with Byte` (`managedMemoryInstanceForElementSize`). The record and the incoherence are
// identical: MEASURED under `typealias Byte = int(0 to 1000)`,
// `create(8, 1)` then `set(0, value: 300)` type-checks against `int(0 to 1000)`, strides the stamped 1 and
// reads back **44**. One producer refused and its twin accepted would be the defect; the message is shared so
// that stays impossible.
//
// `LowerMaxonToStd.lowerConstArrayLiteral` lays the blob out one byte per element and stamps
// `element_size@24 = ByteStringElementSize` to match it; every OTHER `Array with Byte` record — `.create()`,
// a global's `__managed_create`, a `clone`/`slice` of either — is stamped from `ProgramSignatures.arrayElementStamp`,
// whose stride sizes the element from `Byte`'s DECLARED range. The two agree for the canonical `int(0 to u8.max)`
// and for anything narrower, which is the whole of what a byte string is; they do not agree for a wider one.
//
// ⚠ **WITHOUT THE GATE THAT DISAGREEMENT IS A SILENT WRONG ANSWER, NOT MERELY AN ABORT.** Measured
// with `typealias Byte = int(0 to 1000)`: two `Bytes` values, the same `push(300)` then `get(2)`,
// read back **44** from the literal-produced record and **300** from the `.create()`-produced one —
// one static type, two behaviours, no diagnostic. (`append` between the two does abort —
// `RuntimeAbort.arrayAppendElementSizeMismatch` — but it is the ONE array operation that compares
// the strides.) Emitting the blob WIDE is an element-wise widening emission — a real mechanism and
// its own change, exactly as the widening `__managed_append` across differing strides is — so until
// that exists this is E2015 at the producer rather than a record that behaves unlike every other
// value of its own type. The same holds of a byte-packed `create`: the alternative there is an
// element TYPE one byte wide that THIS file can name, which is precisely what its `Byte`
// declaration says it does not have.
//
// ⚠ Two slots and not one, so the literal's sentence stays BYTE-IDENTICAL to what it has always been while
// the buffer's names itself: the PRODUCER is what the author wrote, and the PACKED SUBJECT is the thing
// inside it that is byte-packed — the blob for one, the requested buffer for the other.
function bytePackedRecordStrideMessage(producer BytePackedProducer, declaredStride FullRangeInt) returns String
	let named = match producer 'producer'
		byteStringLiteral gives "a `b\"…\"` byte-string literal"
		managedMemoryCreate gives "`{String.from(ManagedMemoryTypeName)}.{String.from(ManagedMemoryCreateMethod)}({String.from(ManagedMemoryCountParamName)}, {String.from(ManagedMemoryElementSizeParamName)}: {ByteStringElementSize})`"
	end 'producer'

	let packedSubject = match producer 'packedSubject'
		byteStringLiteral gives "the literal's blob"
		managedMemoryCreate gives "the buffer it asks for"
	end 'packedSubject'

	return "{named} in a program whose `Byte` is a {declaredStride}-byte range: {packedSubject} is byte-PACKED, so its record would stride 1 while every `Array with Byte` built by `.create()` strides {declaredStride} — two values of one type that behave differently. Declare `Byte` as `int(0 to u8.max)` (or any range that fits one byte), or build the array with `.create()` + `push`"
end 'bytePackedRecordStrideMessage'

// ⭐⭐ **WHICH BYTE-PACKED PRODUCER A STRIDE REFUSAL IS ABOUT — AN ENUM, NOT TWO STRINGS, AND THAT IS
// MEASURED.** Two reasons, pointing the same way. The producer and the byte-packed thing inside it are
// ONE PAIRING: a producer printed beside the other's subject would state a true rule about the wrong
// construct, and an enum makes that pairing the message renderer's to make once rather than each caller's to
// get right. And a rendered STRING argument is built on every call, ACCEPTED ones included: passing the
// buffer producer's name as text cost **+55 allocations at scale rung 0 rising to +1543 at rung 5**, ~6 per
// accepted `__ManagedMemory.create`, for a sentence no compiling program ever reads.
enum BytePackedProducer
	byteStringLiteral
	managedMemoryCreate
end 'BytePackedProducer'

// The E1004 text, including the literal `\xNN` guidance.
function byteStringCodepointRangeMessage(codepoint FullRangeInt) returns String
	return "Codepoint U+{formatCodepointHex(codepoint)} exceeds the byte range 0-255 in byte string literal; use a \\xNN hex escape to embed a raw byte"
end 'byteStringCodepointRangeMessage'

// Render `codepoint` as lowercase hex, zero-padded to at least `CodepointHexMinDigits` — the `U+0100` /
// `U+1f600` form the diagnostic uses. Built least-significant-digit first, then reversed.
function formatCodepointHex(codepoint FullRangeInt) returns String
	let digits = HexDigitsLower.toByteArray()
	let lowFirst = ByteArray.create(0)
	var v = codepoint

	while v > 0 'emit'
		let nibble = v mod HexRadix
		lowFirst.push(try digits.get(nibble as ElementIndex) otherwise panic("formatCodepointHex: nibble {nibble} out of the 16-digit table"))
		v = v / HexRadix
	end 'emit'

	while lowFirst.count() < CodepointHexMinDigits 'pad'
		lowFirst.push(AsciiZeroByte)
	end 'pad'

	let out = ByteArray.create(lowFirst.count(), zeroed: false)
	var i = lowFirst.count()

	while i > 0 'reverse'
		i = i - 1
		out.push(try lowFirst.get(i) otherwise panic("formatCodepointHex: reverse index {i} out of range"))
	end 'reverse'

	return String.from(out)
end 'formatCodepointHex'

// Is the `\x`/`\u` escape at `at` followed by exactly `form.digitCount` hex digits, in bounds? THE one
// statement of a digit escape's well-formedness, shared by the two decoders that admit one — the
// byte-string one (which throws `invalidDigitEscapeError` on the spot) and the regular-literal one (which
// defers it as `DecodedLiteral.badDigitEscape`). They differ only in how the E1004 the two now share is
// delivered, so the answer and the message are both shared and only the delivery is not.
function hexEscapeWellFormed(raw ByteArray, at ByteOffset, len ByteOffset, form DigitEscape) returns bool
	let firstDigit = at + EscapeMarkerBytes
	let afterDigits = at + form.width
	return afterDigits <= len and hexDigitsPresent(raw, from: firstDigit, to: afterDigits)
end 'hexEscapeWellFormed'

function hexDigitsPresent(raw ByteArray, from ByteOffset, to ByteOffset) returns bool
	var i = from

	while i < to 'each'
		if not urlIsHexDigit(try raw.get(i) otherwise panic("hexDigitsPresent: i < to <= len but get({i}) failed")) 'notHex'
			return false
		end 'notHex'

		i = i + 1
	end 'each'

	return true
end 'hexDigitsPresent'

// The 0..15 value of a hex-digit byte — caller must have validated it via `hexDigitsPresent`.
function hexDigitValue(b Byte) returns FullRangeInt
	match urlHexDigitOf(b) 'reading'
		value(digit) then return digit as FullRangeInt
		notAHexDigit then panic("hexDigitValue: byte {b} is not a hex digit (caller must validate via hexDigitsPresent)")
	end 'reading'
end 'hexDigitValue'

// ⭐ The value the digit escape at `at` spells — THE one hex accumulation, for both markers and both
// decoders. It was two hand-unrolled copies (one 2-digit, one 4-digit) of the same `value * 16 + digit`
// fold; the MARKER's derivations are the only thing that ever differed, and they are now the parameter.
// The caller must have validated the digits via `hexEscapeWellFormed`.
function digitEscapeValue(raw ByteArray, at ByteOffset, form DigitEscape) returns FullRangeInt
	var value = 0 as FullRangeInt
	var i = at + EscapeMarkerBytes
	let pastDigits = at + form.width

	while i < pastDigits 'digits'
		value = (value shl HexNibbleBits) or hexDigitValue(try raw.get(i as ElementIndex) otherwise panic("digitEscapeValue: validated digit at {i} missing"))
		i = i + 1
	end 'digits'

	return value
end 'digitEscapeValue'

// Decode the UTF-8 sequence starting at `start` to its codepoint + byte length (1..4). A malformed or
// truncated sequence decodes as its lone lead byte (length 1) so the decode stays aligned — a byte-string
// with genuinely broken UTF-8 is rare and its lead byte is `<= 0xFF`, so it degrades to a raw byte rather
// than desyncing.
function decodeUtf8Sequence(raw ByteArray, start ByteOffset) returns Utf8Sequence
	let n = raw.count()
	let b0 = (try raw.get(start) otherwise panic("decodeUtf8Sequence: start {start} out of bounds")) as FullRangeInt

	if b0 < Utf8LeadTwoByteFloor or start + 1 >= n as ByteOffset 'loneLead'
		return Utf8Sequence.of(b0, byteLength: 1)
	end 'loneLead'

	let b1 = (try raw.get((start + 1) as ElementIndex) otherwise panic("decodeUtf8Sequence: continuation 1 out of bounds")) as FullRangeInt

	if b0 < Utf8LeadThreeByteFloor 'twoByte'
		return Utf8Sequence.of(((((b0 and Utf8LeadTwoByteMask) shl Utf8ContinuationBits) or (b1 and Utf8ContinuationMask))), byteLength: 2)
	end 'twoByte'

	if start + 2 >= n as ByteOffset 'truncated3'
		return Utf8Sequence.of(b0, byteLength: 1)
	end 'truncated3'

	let b2 = (try raw.get((start + 2) as ElementIndex) otherwise panic("decodeUtf8Sequence: continuation 2 out of bounds")) as FullRangeInt

	if b0 < Utf8LeadFourByteFloor 'threeByte'
		return Utf8Sequence.of(((((b0 and Utf8LeadThreeByteMask) shl Utf8ThreeByteHighShift) or ((b1 and Utf8ContinuationMask) shl Utf8ContinuationBits) or (b2 and Utf8ContinuationMask))), byteLength: 3)
	end 'threeByte'

	if start + 3 >= n as ByteOffset 'truncated4'
		return Utf8Sequence.of(b0, byteLength: 1)
	end 'truncated4'

	let b3 = (try raw.get((start + 3) as ElementIndex) otherwise panic("decodeUtf8Sequence: continuation 3 out of bounds")) as FullRangeInt
	return Utf8Sequence.of(((((b0 and Utf8LeadFourByteMask) shl Utf8FourByteHighShift) or ((b1 and Utf8ContinuationMask) shl Utf8ThreeByteHighShift) or ((b2 and Utf8ContinuationMask) shl Utf8ContinuationBits) or (b3 and Utf8ContinuationMask))), byteLength: 4)
end 'decodeUtf8Sequence'

// --- loop / on-the-fly SSA support ---

// The floor a FUNCTION exit (`emitFunctionExit`) releases down to — the base of the owned-binding
// stack, so every owned binding still in scope is dropped. A block or loop exit passes its own
// recorded height instead, releasing only what it declared.
let WholeFunctionScopeFloor = 0 as ElementIndex

// The floor `drainPendingTemps` releases down to when the WHOLE list goes — a statement's own tail drain
// and a hand-off exit (`return`/`throw`) both end every temporary the statement owns. A region passes its
// own recorded height instead, releasing only what IT built. Named for `WholeFunctionScopeFloor`'s reason:
// a bare `0` at a call site reads as an index into the list rather than as "all of them".
let WholeStatementTempFloor = 0 as ElementIndex

// What a lexical block must be unwound to — the heights of BOTH per-binding lists the parser
// keeps beside `Scope`.
//
// A `type` rather than two return values, because the two heights are one FACT ("where this block
// began") and are read by one caller. Passing them separately is how the two would eventually be
// captured at different moments; a block that recorded its mutable height on entry and its owned
// height a statement later would drain a binding it did not open.
type BlockMark
	export let mutableCount as ElementIndex
	export let ownedCount as ElementIndex
	export let debugOpenCount as ElementIndex
	export let orderFactHeight as ElementIndex

	static function create(mutableCount ElementIndex, ownedCount ElementIndex, debugOpenCount ElementIndex, orderFactHeight ElementIndex) returns BlockMark
		return Self{mutableCount: mutableCount, ownedCount: ownedCount, debugOpenCount: debugOpenCount, orderFactHeight: orderFactHeight}
	end 'create'
end 'BlockMark'

typealias DebugLocalSlotArray = Array with DebugLocalSlot

let FunctionEntryBlockId = 0

let DropCascadeNodeLabel = b"exitdrop"
let SkipTestNodeLabel = b"exitskip"
let ExitTerminalLabel = b"exitterminal"

// An exit handing off an owner with at most this many releasable owners above it gets its own
// nodes for those owners, joining the shared chain below the handed-off one. Deeper, or on a chain
// that carries lanes, it enters the flagged chain, where each rank down to the handed-off one
// compares itself with the skip rank the exit carries. The bound trades nodes per exit against a
// compare per rank at run time.
let ExplicitExclusionDepth = 3

enum ExitKind
	propagate
	throwScalar
	throwBoxed
	returnValue
	returnVoid
end 'ExitKind'

union FunctionExit
	propagate(flag ValueId)
	throwScalar(error ValueId)
	throwBoxed(error ValueId)
	returnValue(value ValueId)
	returnVoid
end 'FunctionExit'

type CarriedSlot
	export let tag as ValueTypeTag
	export let nameId as TypeNameId

	static function create(tag ValueTypeTag, nameId TypeNameId) returns Self
		return Self{tag: tag, nameId: nameId}
	end 'create'

	function matches(other CarriedSlot) returns bool
		return self.tag == other.tag and self.nameId == other.nameId
	end 'matches'
end 'CarriedSlot'

typealias CarriedSlotArray = Array with CarriedSlot

union ExitShape
	functionExit(kind ExitKind, tag ValueTypeTag, nameId TypeNameId)
	routedThrow(destination BlockId, slots CarriedSlotArray)
end 'ExitShape'

function slotsMatch(first CarriedSlotArray, second CarriedSlotArray) returns bool
	if first.count() != second.count() 'differentCounts'
		return false
	end 'differentCounts'

	for position in 0 upto first.count() 'eachSlot'
		let mine = try first.get(position) otherwise panic("slotsMatch: first.get OOB at {position} below the count both arrays agreed on")
		let theirs = try second.get(position) otherwise panic("slotsMatch: second.get OOB at {position} below the count both arrays agreed on")

		if not mine.matches(theirs) 'slotDiffers'
			return false
		end 'slotDiffers'
	end 'eachSlot'

	return true
end 'slotsMatch'

function functionShapeMatches(shape ExitShape, kind ExitKind, tag ValueTypeTag, nameId TypeNameId) returns bool
	match shape 'which'
		functionExit(otherKind, otherTag, otherNameId) then return kind == otherKind and tag == otherTag and nameId == otherNameId
		routedThrow then return false
	end 'which'
end 'functionShapeMatches'

function routedShapeMatches(shape ExitShape, destination BlockId, slots CarriedSlotArray) returns bool
	match shape 'which'
		functionExit then return false
		routedThrow(otherDestination, otherSlots) then return destination == otherDestination and slotsMatch(slots, second: otherSlots)
	end 'which'
end 'routedShapeMatches'

function exitShapesMatch(first ExitShape, second ExitShape) returns bool
	match first 'which'
		functionExit(kind, tag, nameId) then return functionShapeMatches(second, kind: kind, tag: tag, nameId: nameId)
		routedThrow(destination, slots) then return routedShapeMatches(second, destination: destination, slots: slots)
	end 'which'
end 'exitShapesMatch'

function exitShapeCarriesAWitness(shape ExitShape) returns bool
	match shape 'which'
		functionExit(_, tag, _) then return tag == ValueTypeTag.interfaceRef
		routedThrow then return false
	end 'which'
end 'exitShapeCarriesAWitness'

function exitShapeRoutesTo(shape ExitShape, destination BlockId) returns bool
	match shape 'which'
		functionExit then return false
		routedThrow(held, _) then return held == destination
	end 'which'
end 'exitShapeRoutesTo'

union HandedOff
	nothing
	value(held ValueId)
end 'HandedOff'

union ExitRoute
	direct
	chained(first ElementIndex, entry BlockId, lanes ValueIdArray)
	flagged(first ElementIndex, entry BlockId, lanes ValueIdArray, skip ElementIndex)
end 'ExitRoute'

enum ReleaseDisposition
	release
	skip
	unmatchedObligation
end 'ReleaseDisposition'

enum ChainNodeRole
	drop
	skipTest
end 'ChainNodeRole'

enum ReleaseShape
	plain
	cellBox
	cellWithOccupant
end 'ReleaseShape'

typealias OwnedBindingPositionArray = Array with ElementIndex

let LaneNodeValueBucket = 0

// Every node at or above a lane carries one phi per lane below it, so lanes cost nodes × lanes; capping
// them keeps that linear, and an owner rebound past the cap is baked into its node instead.
let MaxReleaseLanes = 6 as ElementIndex

type DropNodeKey
	export let released as ValueId
	export let releaseShape as ReleaseShape
	export let role as ChainNodeRole
	export let lanes as CarriedSlotArray
	export let ownLane as bool

	static function bakedValue(released ValueId, releaseShape ReleaseShape, role ChainNodeRole, lanes CarriedSlotArray) returns Self
		return Self{released: released, releaseShape: releaseShape, role: role, lanes: lanes, ownLane: false}
	end 'bakedValue'

	static function laneValue(role ChainNodeRole, lanes CarriedSlotArray) returns Self
		return Self{released: LaneNodeValueBucket, releaseShape: ReleaseShape.plain, role: role, lanes: lanes, ownLane: true}
	end 'laneValue'

	function matches(other DropNodeKey) returns bool
		if self.ownLane != other.ownLane or self.role != other.role or self.releaseShape != other.releaseShape or not slotsMatch(self.lanes, second: other.lanes) 'differs'
			return false
		end 'differs'

		return self.ownLane or self.released == other.released
	end 'matches'
end 'DropNodeKey'

type DropNode
	export let heldKey as DropNodeKey
	export let carriedShape as ExitShape
	export let onward as BlockId
	export let alsoOnward as BlockId
	export let entry as BlockId

	static function create(key DropNodeKey, exitShape ExitShape, successor BlockId, alternate BlockId, blockId BlockId) returns Self
		return Self{heldKey: key, carriedShape: exitShape, onward: successor, alsoOnward: alternate, entry: blockId}
	end 'create'

	function answers(key DropNodeKey, exitShape ExitShape, successor BlockId, alternate BlockId) returns bool
		return self.onward == successor and self.alsoOnward == alternate and self.heldKey.matches(key) and exitShapesMatch(self.carriedShape, second: exitShape)
	end 'answers'
end 'DropNode'

typealias DropNodeArray = Array with DropNode
typealias DropNodesByValue = Map with (ValueId, DropNodeArray)
typealias DropNodesByContext = Map with (BlockId, DropNodesByValue)

type ExitTerminal
	export let shape as ExitShape
	export let blockId as BlockId

	static function create(shape ExitShape, blockId BlockId) returns Self
		return Self{shape: shape, blockId: blockId}
	end 'create'
end 'ExitTerminal'

typealias ExitTerminalArray = Array with ExitTerminal

typealias ValueIdArrayColumn = Array with ValueIdArray

type RoutedNode
	export var block as IrBlock
	export var outgoing as ValueIdArrayColumn

	static function create(block IrBlock, outgoing ValueIdArrayColumn) returns Self
		return Self{block: block, outgoing: outgoing}
	end 'create'

	function attachArgument(phi ValueId)
		for edge in self.outgoing 'eachOutgoingEdge'
			edge.push(phi)
		end 'eachOutgoingEdge'
	end 'attachArgument'
end 'RoutedNode'

typealias RoutedNodeArray = Array with RoutedNode
typealias RoutedNodesByDestination = Map with (BlockId, RoutedNodeArray)

type UnmatchedObligation
	export let position as ElementIndex
	export let name as immutable ByteArray
	export let flag as ValueId

	static function create(position ElementIndex, name ByteArray, flag ValueId) returns Self
		return Self{position: position, name: name, flag: flag}
	end 'create'
end 'UnmatchedObligation'

typealias UnmatchedObligationArray = Array with UnmatchedObligation
typealias ReleasableRankColumn = Array with ElementIndex
typealias ReleaseDispositionColumn = Array with ReleaseDisposition

// Releasable owners above `floor` are ranked from 1 in binding order. The entry at rank r drops
// that owner and every lower rank, then reaches the base: the shape's exit terminal, or the `try`'s
// error block. An exit drops its innermost owner inline and enters the rank below it, so a
// function's drops, and the uses its register allocator splits, grow linearly in its exits rather
// than as their square. Gated by `tests/cli/error-path-drops-grow-linearly-with-*.maxtest`.
//
// A lane is an owner rebound after its rank's node was built. That node drops a block-arg phi, and
// every exit passes the owner's current value after the carried ones, so the node stays shared
// across the owner's values.
type ReleaseChain
	export let shape as ExitShape
	export let context as BlockId
	export let floor as ElementIndex
	var entries as BlockIdArray
	var skipEntries as BlockIdArray
	var unmatched as UnmatchedObligationArray
	var scanned as ElementIndex
	var dispositions as ReleaseDispositionColumn
	var scannedBindings as VarInfoArray
	var scannedValues as ValueIdArray
	var releasable as OwnedBindingPositionArray
	var releasableThrough as ReleasableRankColumn
	var laneRanks as ReleasableRankColumn
	var laneBindings as VarInfoArray

	static function create(shape ExitShape, context BlockId, floor ElementIndex) returns Self
		return Self{shape: shape, context: context, floor: floor, entries: BlockIdArray.create(0), skipEntries: BlockIdArray.create(0), unmatched: UnmatchedObligationArray.create(0), scanned: floor, dispositions: ReleaseDispositionColumn.create(0), scannedBindings: VarInfoArray.create(0), scannedValues: ValueIdArray.create(0), releasable: OwnedBindingPositionArray.create(0), releasableThrough: ReleasableRankColumn.create(0), laneRanks: ReleasableRankColumn.create(0), laneBindings: VarInfoArray.create(0)}
	end 'create'

	function matches(wanted ExitShape, wantedContext BlockId, wantedFloor ElementIndex) returns bool
		return self.floor == wantedFloor and self.context == wantedContext and exitShapesMatch(self.shape, second: wanted)
	end 'matches'

	function scannedHeight() returns ElementIndex
		return self.scanned
	end 'scannedHeight'

	function releasableCount() returns ElementIndex
		return self.releasable.count()
	end 'releasableCount'

	function positionOfRank(rank ElementIndex) returns ElementIndex
		return try self.releasable.get(rank - 1) otherwise panic("ReleaseChain.positionOfRank: rank {rank} is past the {self.releasable.count()} releasable bindings the chain scanned")
	end 'positionOfRank'

	function rankOfPosition(position ElementIndex) returns ElementIndex
		return try self.releasableThrough.get(position - self.floor) otherwise panic("ReleaseChain.rankOfPosition: position {position} is outside the [{self.floor}, {self.scanned}) the chain scanned")
	end 'rankOfPosition'

	function entryCount() returns ElementIndex
		return self.entries.count()
	end 'entryCount'

	function entryAt(rank ElementIndex) returns BlockId
		return try self.entries.get(rank - 1) otherwise panic("ReleaseChain.entryAt: rank {rank} has no entry among the {self.entries.count()} built")
	end 'entryAt'

	function noteEntry(entry BlockId)
		self.entries.push(entry)
	end 'noteEntry'

	function skipEntryCount() returns ElementIndex
		return self.skipEntries.count()
	end 'skipEntryCount'

	function skipEntryAt(rank ElementIndex) returns BlockId
		return try self.skipEntries.get(rank - 1) otherwise panic("ReleaseChain.skipEntryAt: rank {rank} has no entry among the {self.skipEntries.count()} built")
	end 'skipEntryAt'

	function noteSkipEntry(entry BlockId)
		self.skipEntries.push(entry)
	end 'noteSkipEntry'

	function unmatchedCount() returns ElementIndex
		return self.unmatched.count()
	end 'unmatchedCount'

	function unmatchedAt(index ElementIndex) returns UnmatchedObligation
		return try self.unmatched.get(index) otherwise panic("ReleaseChain.unmatchedAt: unmatched.get OOB at {index} below the count {self.unmatched.count()}")
	end 'unmatchedAt'

	function dispositionAt(position ElementIndex) returns ReleaseDisposition
		return try self.dispositions.get(position - self.floor) otherwise panic("ReleaseChain.dispositionAt: position {position} is outside the [{self.floor}, {self.scanned}) the chain scanned")
	end 'dispositionAt'

	function holdsBindingAt(position ElementIndex, binding VarInfo) returns bool
		let scannedBinding = try self.scannedBindings.get(position - self.floor) otherwise panic("ReleaseChain.holdsBindingAt: position {position} is outside the [{self.floor}, {self.scanned}) the chain scanned")
		return scannedBinding is binding
	end 'holdsBindingAt'

	function valueAt(position ElementIndex) returns ValueId
		return try self.scannedValues.get(position - self.floor) otherwise panic("ReleaseChain.valueAt: position {position} is outside the [{self.floor}, {self.scanned}) the chain scanned")
	end 'valueAt'

	function noteValueAt(position ElementIndex, value ValueId)
		try self.scannedValues.set(position - self.floor, value: value) otherwise panic("ReleaseChain.noteValueAt: position {position} is outside the [{self.floor}, {self.scanned}) the chain scanned")
	end 'noteValueAt'

	function laneCount() returns ElementIndex
		return self.laneRanks.count()
	end 'laneCount'

	function laneRankAt(index ElementIndex) returns ElementIndex
		return try self.laneRanks.get(index) otherwise panic("ReleaseChain.laneRankAt: laneRanks.get OOB at {index} below the count {self.laneRanks.count()}")
	end 'laneRankAt'

	function isLaneRank(rank ElementIndex) returns bool
		for lane in self.laneRanks 'eachLane'
			if lane == rank 'thisLane'
				return true
			end 'thisLane'
		end 'eachLane'

		return false
	end 'isLaneRank'

	function laneBindingCount() returns ElementIndex
		return self.laneBindings.count()
	end 'laneBindingCount'

	function laneBindingAt(index ElementIndex) returns VarInfo
		return try self.laneBindings.get(index) otherwise panic("ReleaseChain.laneBindingAt: laneBindings.get OOB at {index} below the count {self.laneBindings.count()}")
	end 'laneBindingAt'

	function hasRoomForLane() returns bool
		return self.laneBindings.count() < MaxReleaseLanes
	end 'hasRoomForLane'

	function markLane(binding VarInfo)
		self.laneBindings.push(binding)
	end 'markLane'

	function unmarkLane(binding VarInfo)
		let kept = VarInfoArray.create(0)

		for held in self.laneBindings 'eachLaneBinding'
			if not (held is binding) 'another'
				kept.push(held)
			end 'another'
		end 'eachLaneBinding'

		self.laneBindings = kept
	end 'unmarkLane'

	function carriesLaneBinding(binding VarInfo) returns bool
		for held in self.laneBindings 'eachLaneBinding'
			if held is binding 'thisOne'
				return true
			end 'thisOne'
		end 'eachLaneBinding'

		return false
	end 'carriesLaneBinding'

	function noteScanned(position ElementIndex, binding VarInfo, disposition ReleaseDisposition)
		if position != self.scanned 'outOfOrder'
			panic("ReleaseChain.noteScanned: position {position} is not the next unscanned one, {self.scanned}")
		end 'outOfOrder'

		self.dispositions.push(disposition)
		self.scannedBindings.push(binding)
		self.scannedValues.push(binding.boundValue)

		match disposition 'which'
			release then self.noteRelease(position, binding: binding)
			unmatchedObligation then self.unmatched.push(UnmatchedObligation.create(position, name: binding.name, flag: binding.boundValue))
			skip then break
		end 'which'

		self.releasableThrough.push(self.releasable.count())
		self.scanned = self.scanned + 1
	end 'noteScanned'

	function noteRelease(position ElementIndex, binding VarInfo)
		self.releasable.push(position)

		if self.carriesLaneBinding(binding) 'aLane'
			self.laneRanks.push(self.releasable.count())
		end 'aLane'
	end 'noteRelease'

	function invalidateFrom(position ElementIndex)
		if position >= self.scanned 'nothingScannedThere'
			return
		end 'nothingScannedThere'

		let kept = position if position > self.floor else self.floor
		let keptPositions = kept - self.floor
		var keptRanks = 0 as ElementIndex

		if keptPositions > 0 'somethingBelow'
			keptRanks = try self.releasableThrough.get(keptPositions - 1) otherwise panic("ReleaseChain.invalidateFrom: releasableThrough.get OOB at {keptPositions - 1} below the count scanned")
		end 'somethingBelow'

		self.dispositions.truncate(keptPositions)
		self.scannedBindings.truncate(keptPositions)
		self.scannedValues.truncate(keptPositions)
		self.releasableThrough.truncate(keptPositions)
		self.releasable.truncate(keptRanks)
		self.laneRanks = ranksUpTo(self.laneRanks, limit: keptRanks)

		if self.entries.count() > keptRanks 'entriesAbove'
			self.entries.truncate(keptRanks)
		end 'entriesAbove'

		if self.skipEntries.count() > keptRanks 'skipEntriesAbove'
			self.skipEntries.truncate(keptRanks)
		end 'skipEntriesAbove'

		let stillUnmatched = UnmatchedObligationArray.create(0)

		for obligation in self.unmatched 'eachObligation'
			if obligation.position < kept 'belowTheCut'
				stillUnmatched.push(obligation)
			end 'belowTheCut'
		end 'eachObligation'

		self.unmatched = stillUnmatched
		self.scanned = kept
	end 'invalidateFrom'
end 'ReleaseChain'

function ranksUpTo(ranks ReleasableRankColumn, limit ElementIndex) returns ReleasableRankColumn
	let kept = ReleasableRankColumn.create(0)

	for rank in ranks 'eachRank'
		if rank <= limit 'withinTheLimit'
			kept.push(rank)
		end 'withinTheLimit'
	end 'eachRank'

	return kept
end 'ranksUpTo'

typealias ReleaseChainArray = Array with ReleaseChain

type DropCascade
	export var terminals as ExitTerminalArray
	export var nodes as DropNodesByContext
	export var chains as ReleaseChainArray
	export var routed as RoutedNodesByDestination

	static function create() returns Self
		return Self{terminals: ExitTerminalArray.create(0), nodes: DropNodesByContext.create(), chains: ReleaseChainArray.create(0), routed: RoutedNodesByDestination.create()}
	end 'create'

	function routedNodesTo(destination BlockId) returns RoutedNodeArray
		return try self.routed.get(destination) otherwise RoutedNodeArray.create(0)
	end 'routedNodesTo'

	function noteRoutedNode(destination BlockId, node RoutedNode)
		let held = try self.routed.get(destination) otherwise RoutedNodeArray.create(0)
		held.push(node)
		self.routed.upsert(destination, value: held)
	end 'noteRoutedNode'

	function discardContext(context BlockId)
		let kept = ReleaseChainArray.create(0)

		for chain in self.chains 'eachChain'
			if chain.context != context 'otherContext'
				kept.push(chain)
			end 'otherContext'
		end 'eachChain'

		self.chains = kept
	end 'discardContext'

	function discardRoutedTo(destination BlockId)
		let kept = ReleaseChainArray.create(0)

		for chain in self.chains 'eachChain'
			if not exitShapeRoutesTo(chain.shape, destination: destination) 'anotherHandler'
				kept.push(chain)
			end 'anotherHandler'
		end 'eachChain'

		self.chains = kept
		_ = self.routed.remove(destination)
	end 'discardRoutedTo'

	function terminalFor(shape ExitShape) returns BlockId throws AbsentError
		for terminal in self.terminals 'eachTerminal'
			if exitShapesMatch(terminal.shape, second: shape) 'thisShape'
				return terminal.blockId
			end 'thisShape'
		end 'eachTerminal'

		throw AbsentError.absent
	end 'terminalFor'

	function nodeFor(key DropNodeKey, exitShape ExitShape, context BlockId, successor BlockId, alternate BlockId) returns BlockId throws AbsentError
		let inContext = try self.nodes.get(context) otherwise throw AbsentError.absent
		let candidates = try inContext.get(key.released) otherwise throw AbsentError.absent

		for candidate in candidates 'eachCandidate'
			if candidate.answers(key, exitShape: exitShape, successor: successor, alternate: alternate) 'thisNode'
				return candidate.entry
			end 'thisNode'
		end 'eachCandidate'

		throw AbsentError.absent
	end 'nodeFor'

	function noteTerminal(shape ExitShape, blockId BlockId)
		self.terminals.push(ExitTerminal.create(shape, blockId: blockId))
	end 'noteTerminal'

	function noteNode(key DropNodeKey, exitShape ExitShape, context BlockId, successor BlockId, alternate BlockId, blockId BlockId)
		let inContext = try self.nodes.get(context) otherwise DropNodesByValue.create()
		let candidates = try inContext.get(key.released) otherwise DropNodeArray.create(0)
		candidates.push(DropNode.create(key, exitShape: exitShape, successor: successor, alternate: alternate, blockId: blockId))
		inContext.upsert(key.released, value: candidates)
		self.nodes.upsert(context, value: inContext)
	end 'noteNode'
end 'DropCascade'

union DropCascadeState
	unbuilt
	built(cascade DropCascade)
end 'DropCascadeState'

function thrownExit(error ValueId, errorIsBoxed bool) returns FunctionExit
	if errorIsBoxed 'boxed'
		return FunctionExit.throwBoxed(error)
	end 'boxed'

	return FunctionExit.throwScalar(error)
end 'thrownExit'

function exitKindOf(exit FunctionExit) returns ExitKind
	return match exit 'exit'
		propagate gives ExitKind.propagate
		throwScalar gives ExitKind.throwScalar
		throwBoxed gives ExitKind.throwBoxed
		returnValue gives ExitKind.returnValue
		returnVoid gives ExitKind.returnVoid
	end 'exit'
end 'exitKindOf'

function exitValueOf(exit FunctionExit) returns ValueId throws AbsentError
	match exit 'exit'
		propagate(flag) then return flag
		throwScalar(error) then return error
		throwBoxed(error) then return error
		returnValue(value) then return value
		returnVoid then throw AbsentError.absent
	end 'exit'
end 'exitValueOf'

function exitRouteIsDirect(route ExitRoute) returns bool
	return match route 'route'
		direct gives true
		chained or
		flagged gives false
	end 'route'
end 'exitRouteIsDirect'

function handedOffValue(handedOff HandedOff) returns ValueId throws AbsentError
	match handedOff 'which'
		nothing then throw AbsentError.absent
		value(held) then return held
	end 'which'
end 'handedOffValue'

function handedOffHolds(handedOff HandedOff, candidate ValueId) returns bool
	let held = try handedOffValue(handedOff) otherwise return false
	return held == candidate
end 'handedOffHolds'

function chainEdgeArgs(carried ValueIdArray, lanes ValueIdArray, count ElementIndex) returns ValueIdArray
	let args = ValueIdArray.create(carried.count() + count, zeroed: false)
	args.append(carried)

	for index in 0 upto count 'eachLane'
		args.push(try lanes.get(index) otherwise panic("chainEdgeArgs: lanes.get OOB at {index} below the {lanes.count()} a block minted"))
	end 'eachLane'

	return args
end 'chainEdgeArgs'

function functionExitKind(shape ExitShape) returns ExitKind throws AbsentError
	match shape 'which'
		functionExit(kind, _, _) then return kind
		routedThrow then throw AbsentError.absent
	end 'which'
end 'functionExitKind'

// ⭐ **DROP-SKIP FOR A MOVED-FROM BINDING.** Its owned value was transferred to another
// binding by a `let u = t` / `s = t`, which now owns and drops it — decref-ing it here too
// would double-free. The moved-from binding stays in
// the list (removal would desync the block/loop drop marks), so the SKIP is what makes a
// moved-out value drop exactly once. This one guard serves every exit that funnels through
// here — `return`, a block fall-through, a `break`/`continue`.
function releaseDispositionOf(binding VarInfo) returns ReleaseDisposition
	let movedFrom = binding.movedFrom

	if binding.isErrorMatchObligation 'anObligation'
		if movedFrom 'matched'
			return ReleaseDisposition.skip
		end 'matched'

		return ReleaseDisposition.unmatchedObligation
	end 'anObligation'

	if movedFrom and not binding.isCellBinding 'movedOut'
		return ReleaseDisposition.skip
	end 'movedOut'

	return ReleaseDisposition.release
end 'releaseDispositionOf'

function exitCarriedValue(carried ValueIdArray) returns ValueId
	return try carried.get(0) otherwise panic("exitCarriedValue: an exit that carries a value was handed an empty payload")
end 'exitCarriedValue'

function exitTerminatorOp(kind ExitKind, carried ValueIdArray) returns MaxonOp
	match kind 'kind'
		propagate then return MaxonOp.propagateError(exitCarriedValue(carried))
		throwScalar then return MaxonOp.throwError(exitCarriedValue(carried), errorIsBoxed: false)
		throwBoxed then return MaxonOp.throwError(exitCarriedValue(carried), errorIsBoxed: true)
		returnValue then return MaxonOp.ret(exitCarriedValue(carried))
		returnVoid then return MaxonOp.retVoid
	end 'kind'
end 'exitTerminatorOp'

// What `Parser.valueIsBoxedUnion` found a `named` type to be.
enum BoxedUnionAnswer
	unasked
	boxed
	notBoxed
end 'BoxedUnionAnswer'

typealias BoxedUnionAnswerArray = Array with BoxedUnionAnswer

// ⭐ **IS A VALUE OF `tag` A SCALAR WHATEVER THE PROGRAM DECLARES?** A `named` tag answers `false`: only the
// whole program can say what a named type holds.
function tagIsAScalarWhateverIsDeclared(tag ValueTypeTag) returns bool
	return match tag 'tag'
		boolean or
		integer or
		float or
		exitCode or
		void or
		cstring gives true

		named or
		unresolved or
		structRef or
		string or
		function or
		typeParameter or
		genericInstance or
		character or
		interfaceRef gives false
	end 'tag'
end 'tagIsAScalarWhateverIsDeclared'

// A snapshot of the PATH-SENSITIVE move state of every owned binding in scope — the twin of
// `snapshotBindings` (which snapshots `boundValue` for the merge phis), for the one bit that must be
// reconciled at a control-flow join rather than accumulated monotonically.
//
// `movedFrom` is that bit: it says "this binding's owned value was handed to another owner, so its
// scope-exit drop is skipped". Set unconditionally where a move is WRITTEN, it leaks onto sibling
// branches — a value moved on ONE `if` branch reads as moved on the branch that never moved it, so its
// drop is skipped there and it LEAKS. Reconciling this bit at each join (restore it around a sibling
// branch, drop the value on the branches that kept it live) is what makes the drop path-sensitive.
//
// `partiallyMoved` is deliberately NOT snapshotted: it never SKIPS a drop (a partially-moved union box
// still drops through its cascade), so leaking it across a branch only over-rejects a later read — sound
// — while the value is always dropped correctly. Only `movedFrom` gates a drop, so only it needs this.
//
// Positional over `ownedBindings`, whose height is STABLE at every join point (a branch's own owned
// bindings are declared above the join's owned floor and popped at the branch's `end` before the join
// runs). `values` carries each binding's `boundValue` at capture time, so a drop placed on an edge that
// kept a binding LIVE decrefs the value that edge actually holds.
type MoveMark
	export let slots as MoveSlots

	// ⭐⭐ **AND THE CONSUMED GREEN THREADS — the SECOND path-sensitive fact, and the one an owned-binding
	// column structurally cannot carry.** `movedFrom` is positional over `ownedBindings`, and an ALIAS
	// (`let q = p`) is in no owned set at all — a promise aliases rather than moves, so `q` enrols nothing
	// — which left every rewind blind to a name that spells a thread the arm consumed. Keyed on the
	// promise's own `ValueId` instead, which IS the thread's identity, so the ONE record covers the owner
	// and every alias of it at once and there is no symbol table to walk.
	export let consumes as PromiseConsumes

	static function create(slots MoveSlots, consumes PromiseConsumes) returns MoveMark
		return Self{slots: slots, consumes: consumes}
	end 'create'

	function height() returns ElementIndex
		return self.slots.height
	end 'height'

	function movedAt(position ElementIndex) returns bool
		return self.slots.movedAt(position)
	end 'movedAt'

	function valueAt(position ElementIndex) returns ValueId
		return self.slots.valueAt(position)
	end 'valueAt'
end 'MoveMark'

typealias LiteralCommaCount = int(0 to u32.max)

// ⭐⭐ **ONE ENUM-ACCESSOR READ, the fact E3097 is decided from.** Keyed on the accessor result's own
// `ValueId` and never on a NAME — that value IS the read's identity, and a `let o = c.ordinal` binds it
// verbatim, so one record answers for the read and for every name of it at once. `PromiseConsumes`
// is keyed the same way for the same reason, and it is what keeps a symbol-table walk off the compare path.
//
// The MEMBER rides because the diagnostic has to name the accessor the author actually wrote: telling them
// `.name` is not comparable, about a line spelling `.ordinal`, describes a program they do not have.
type EnumAccessorRead
	export let value as ValueId
	export let member as immutable ByteArray

	static function create(value ValueId, member ByteArray) returns EnumAccessorRead
		return Self{value: value, member: member}
	end 'create'
end 'EnumAccessorRead'

typealias EnumAccessorReadArray = Array with EnumAccessorRead

// ⭐⭐ **ONE `self.<field> = …` WRITE INSIDE A STATIC FACTORY, IN THE BLOCK IT HAPPENED IN.** A factory may
// defer a field to an assignment (`/specs/field-initialization.md`'s third rule), and the language then owes
// a proof that every deferred field is assigned on EVERY path reaching the `Self{…}` that consumes it. The
// proof is a forward dataflow, and this is its GEN set — recorded as the body is parsed, because that is the
// one moment the block and the position within it are both in hand.
type NascentSelfWrite
	export let field as immutable ByteArray
	export let block as BlockId

	// How many ops the block already held. A write and a literal in ONE block are ordered by this and by
	// nothing else — the dataflow answers only which fields reach the block's ENTRY.
	export let position as ElementIndex

	static function create(field ByteArray, block BlockId, position ElementIndex) returns NascentSelfWrite
		return Self{field: field, block: block, position: position}
	end 'create'
end 'NascentSelfWrite'

typealias NascentSelfWriteArray = Array with NascentSelfWrite

// ⭐ **ONE `Self{…}` THAT TOOK A FIELD FROM A DEFERRED ASSIGNMENT** — the CHECK the dataflow discharges. It
// carries the fields it took (never the ones the literal spelled, which need no proof), so the diagnostic
// names exactly what the author has to fix.
type NascentSelfCheck
	export var fields as NameRoster
	export let typeName as immutable ByteArray
	export let block as BlockId
	export let position as ElementIndex
	export let line as LineNumber
	export let column as ColumnNumber

	static function create(fields NameRoster, typeName ByteArray, block BlockId, position ElementIndex, line LineNumber, column ColumnNumber) returns NascentSelfCheck
		return Self{fields: fields, typeName: typeName, block: block, position: position, line: line, column: column}
	end 'create'
end 'NascentSelfCheck'

typealias NascentSelfCheckArray = Array with NascentSelfCheck

// The prefix a deferred field's hidden slot is named under. A `__` name, so `requireUnreservedName` already
// keeps every user declaration out of the space and no program can spell one.
let NascentSelfSlotPrefix = "__self_"

// What `Parser.enumAccessorReadOf` found. A union rather than a bool-plus-out-parameter for the ordinary
// reason: the MEMBER only exists when there was a read, and the two answers must not be representable apart.
union EnumAccessorLookup
	read(member immutable ByteArray)
	notAnAccessor
end 'EnumAccessorLookup'

// The union of two move marks' `movedFrom` bits — the move state of a path that ran BOTH the moves `a`
// records and the moves `b` records. Its one use is the inline-conditional's TRUE path: the true arm's
// own moves (`a`), plus the unconditionally-evaluated condition's (`b`), which parse in the opposite
// order to how they run (`parseTernaryExpression`). Both marks are positional over the SAME owned-binding
// stack, so the union is per-position. Values are identical over the shared prefix (an expression
// reassigns no binding's value), so `b`'s serve — and `b`'s alone carry the tail below.
//
// ⚠ **`a` MAY BE SHORTER THAN `b`, AND THAT IS A REAL SHAPE RATHER THAN A TOLERANCE.** A CONDITION can
// enrol an owned binding — `giveTemporaryScopeLifetime` holds a temporary a borrow was taken out of, and
// the condition runs UNCONDITIONALLY, so its enrolment must outlive the whole ternary rather than be
// dropped with an arm.
// The true arm's mark is captured before the condition parses and is therefore a strict PREFIX of the
// condition's. Every position the arm cannot have seen is `b`'s alone: the binding did not exist while
// the arm ran, so the arm cannot have moved out of it. `a` LONGER than `b` is still a break — that would
// mean an arm's own binding survived past its exit — and still panics.
function orMoveMarks(a MoveMark, b MoveMark, ledger MoveLedger) returns MoveMark
	if a.height() > b.height() 'drifted'
		panic("orMoveMarks: mark height {a.height()} exceeds {b.height()} — an arm's own owned bindings must be popped at its exit, so the earlier mark can only ever be a prefix of the later one")
	end 'drifted'

	let differing = a.slots.differences(b.slots)
	let moved = BoolArray.create(differing.count(), zeroed: false)
	let values = ValueIdArray.create(differing.count(), zeroed: false)

	for position in differing 'each'
		moved.push(a.movedAt(position) or b.movedAt(position))
		values.push(b.valueAt(position))
	end 'each'

	return MoveMark.create(ledger.overlay(b.slots, height: b.height(), positions: differing, moved: moved, values: values), consumes: b.consumes.unioned(a.consumes))
end 'orMoveMarks'

// The sub-mark over the FIRST `height` owned bindings — the ones that OUTLIVE a construct whose own
// bindings sit above `height`.
//
// Its one use is a `break` that leaves a MATCH. Every other capture site is already at its join's
// height (see `MoveMark`), but a break is captured MID-ARM, with the arm's payload/`let` bindings
// still on the stack; the merge it reaches has drained them (`dropArmScopedOwned`) by the time
// `reconcileMovesAtMerge` runs, and that function compares EVERY reaching edge's mark against the
// owned height at the merge and panics on a mismatch. Trimming here is not a workaround for that
// check — it is what the check is asking for: the bindings above the floor are the arm's, they were
// already dropped by the break itself, and the merge has no business reconciling them.
function moveMarkPrefix(mark MoveMark, height ElementIndex) returns MoveMark
	if mark.height() < height 'tooShort'
		panic("moveMarkPrefix: the mark holds {mark.height()} entries, fewer than the requested prefix of {height} — the owned-binding stack fell below the floor the construct recorded at entry")
	end 'tooShort'

	return MoveMark.create(mark.slots.truncated(height), consumes: mark.consumes)
end 'moveMarkPrefix'

function positionsThatMayDiffer(a MoveMark, b MoveMark) returns MoveSlotIndexColumn
	if b.height() < a.height() 'shorter'
		panic("positionsThatMayDiffer: the second mark holds {b.height()} entries, fewer than the first mark's {a.height()} — both are cut at the owned height of one construct")
	end 'shorter'

	return a.slots.differences(b.slots)
end 'positionsThatMayDiffer'

// How a `try … otherwise …`'s error handler affects the merge. The success (`ok`) block always
// carries the tryCall's `result`; the error block's shape is one of:
//   • `value(v)`      — `otherwise <expr>` produced a fallback value; both edges merge into a result phi.
//   • `terminated`    — propagate / `otherwise return|break|continue|throw|panic` left the error block via
//                       its own terminator, so ONLY the ok block reaches the continuation (no merge).
//   • `fellThrough`   — `otherwise ignore` or a block handler that falls through: both edges reach the
//                       continuation with no try-value (a statement form), merging only carried vars.
union TryHandler
	// `blame` is the E3207 name a write through the merged result would land in when the fallback is a bare
	// immutable binding — the `try` merge's share of the rule the ternary and `match … gives` arms carry on
	// `MatchArmExit.blame`. It rides the union arm rather than a parser field so the fact travels with the
	// value it is about; the OK edge is the callee's own result and can blame nothing.
	value(otherwiseValue ValueId)
	terminated
	fellThrough
end 'TryHandler'

// A `try` in an `if`'s condition slot is caught by the `if` rather than propagated, so the branch
// tests the call's error flag and the two edges of the `if` are the two edges of the try:
//   • `test` — the bool the branch takes, so the branch, the value merge and the move
//     reconciliation stay one code path for both shapes.
//   • `result` — the success value, live on the then edge alone (a throw zeroes the register), so
//     only that edge may bind or drop it.
//   • `resultWasPending` — whether the result owes a drop; see `takeOffPendingTemps`.
//   • `flag` — the raw error flag, which the else edge decodes into an `else (e)` binding and, for
//     a payload-bearing union, owns as a heap box released on that edge.
//   • `errorType` — the callee's throws enum, the only thing the else edge asks: which enum `e` is,
//     and whether the flag is a box pointer or an `ordinal + bias`.
union IfCondition
	plain(test ValueId)

	// The caught-error form rides beside the type because a service reply's `(e)` binds a synthesized
	// two-member union rather than a declared enum, and the `else` branch that decodes it is parsed
	// far from the `try` target that decided which.
	tryCatch(test ValueId, result ValueId, resultWasPending bool, flag ValueId, errorType MaxonType, form CaughtErrorForm, join SentLegJoin)
end 'IfCondition'

// The optional success binder in front of a catching condition — `if let x = try …` / `if var x = try …`.
// It carries the name's TOKEN INDEX rather than its text: the token is what `declareInitializedBinding`
// wants (name, line and column together), and an index costs no managed field on a union arm.
union IfBinder
	none
	binding(nameIndex ElementIndex, kind BindingKind)
end 'IfBinder'

// The bool an `if`'s two-way branch tests, whichever shape its condition took.
function ifConditionTest(cond IfCondition) returns ValueId
	return match cond 'shape'
		plain(test) gives test
		tryCatch(test, _, _, _, _, _, _) gives test
	end 'shape'
end 'ifConditionTest'

// Does this `if` CATCH — i.e. is its else edge the error edge of a `try`? It decides one thing in
// `parseIfStatement`: a catching `if` always gets a real else block, even with no `else` written, because
// that edge carries an obligation (release the caught error) an `entry → continuation` edge cannot hold.
function ifConditionCatches(cond IfCondition) returns bool
	return match cond 'shape'
		plain gives false
		tryCatch gives true
	end 'shape'
end 'ifConditionCatches'

// ⭐ **WHAT A `try` IS APPLIED TO — the ONE thing the whole desugar asks about its target.**
// Everything downstream of `rewriteLastCallToTryCall` wants exactly two facts: the NAME a
// diagnostic blames (E3055/E3059, the void-result E3059) and the ERROR TYPE the target throws (which types
// the `(e)` binding and decides whether the caught error is a heap box). A direct call and an awaited
// promise answer the second by NAME — `ProgramSignatures.throwsOf`. A WITNESS dispatch cannot: an
// interface method is in no signature
// registry, and the only place its `throws` exists is the `where`-constraint resolution the parser just did.
//
// So the two shapes are kept as one union with two accessors (`tryTargetNoun`/`tryTargetThrows`) rather
// than by widening the thread to a `(name, clause)` pair: `requireThrowingTryTarget` must ALSO distinguish
// them — a name that no file declares is left to E3004, while a witness method that no file declares is
// normal and its non-throwing case is a real E3055 — and a pair would have lost exactly that.
//
// ⚠ **AND THE `named` ARM CARRIES A DISPATCH KEY, NOT A DISPLAY NAME — which is why the two accessors
// are not symmetric.** `witness` already spells its two jobs apart, holding the source method for diagnostics
// beside the clause; `named` holds ONE string doing both, and for a compiler-emitted callee the two answers
// differ (`__managed_set` dispatches, `set` is what the author wrote). It is not widened to a pair, because the
// display name is DERIVABLE from the key (`tryTargetNamedNoun`) and a second field would be that derivation
// stored — one fact in two places, filled in at every emission site, wrong at whichever one forgot.
union TryTarget
	// A DIRECT call: the callee NAME, which the signature index answers for. ⚠ The
	// EMITTED symbol for a builtin — `tryTargetNamedNoun` turns it back into the author's spelling.
	named(callee immutable ByteArray)

	// A witness-dispatched interface method: the method NAME for diagnostics, and the
	// interface's own declared `throws` clause — the only carrier of that fact.
	witness(methodName immutable ByteArray, throwsClause ThrowsClause)

	// An `await` of a promise typed at a `Promise` instance — one out of storage, or a declared spawn,
	// which `mintSpawnPromise` mints at its instance: the instance's name for diagnostics, and the
	// `throws` clause its `ErrorType` argument spells, the only carrier of that fact — a container
	// holds no `asyncCall` to recover a callee from. An undeclared spawn's await takes `deferred`, so
	// it is reported as E3004 rather than E3055.
	promise(storageName immutable ByteArray, throwsClause ThrowsClause)

	serviceReply(messageName immutable ByteArray, awaitedService immutable ByteArray)

	sentReply(messageName immutable ByteArray, awaitedService immutable ByteArray, sendErrorName immutable ByteArray)

	send(messageName immutable ByteArray, throwsClause ThrowsClause)

	serviceStart(factory immutable ByteArray, awaitedService immutable ByteArray)

	// A call to a callee nothing defines, or the await of a spawn of one: its `unresolved` result is a
	// deferral to E3004, so every door passes it through (see `deferredUnresolvedMemberResult`).
	deferred
end 'TryTarget'

// ⭐⭐ **WHAT AN `await` NEEDS TO KNOW ABOUT ITS PROMISE, FROM WHICHEVER SOURCE HAS IT.** A
// service reply carries the facts on the message its defining cell names, and any other promise — a
// spawn or one out of storage — in its own `Promise` instance's arguments, so the three await doors
// (`emitAwait`'s E3057 reject, `emitAwaitOp`'s result mint, `commitTryAwaitRewrite`'s desugar
// target) ask ONE function and none of them contains a second copy of the road split.
//
// ⚠ **THE `throws` CLAUSE IS NOT A FIELD HERE, AND DELIBERATELY SO.** It is `tryTargetThrows(tryTarget)` —
// the accessor the `try` desugar already reads it through — so a promise's throws-ness cannot be one thing
// to the plain-`await` reject and another to the `otherwise (e)` binding it produces.
type AwaitedPromise
	// What `await p` yields. `declared` carries a `MaxonReturnType` and not a bare type because a VOID
	// `async` is awaitable and has no result type at all (`await p` as a statement); `deferred` is the
	// await of a spawn nothing declares.
	export var result as AwaitedResult
	export var tryTarget as TryTarget

	static function create(result AwaitedResult, tryTarget TryTarget) returns AwaitedPromise
		return Self{result: result, tryTarget: tryTarget}
	end 'create'
end 'AwaitedPromise'

union AwaitedResult
	declared(returnType MaxonReturnType)
	deferred
end 'AwaitedResult'

union AwaitOperand
	promise(facts AwaitedPromise)
	deferred(result ValueId)
end 'AwaitOperand'

// The NAME a diagnostic blames for a `try` target — the first of the two questions the desugar asks it. A
// witness dispatch blames the interface method the author actually wrote (the witness table is a compiler
// artifact with no user spelling); a direct/awaited callee needs one more question asked of it, below.
function tryTargetNoun(target TryTarget, signatures ProgramSignatures) returns immutable ByteArray
	return match target 'kind'
		named(callee) gives tryTargetNamedNoun(callee, signatures: signatures)
		witness(methodName, _) gives methodName
		promise(methodName, _) gives methodName
		send(methodName, _) gives methodName
		serviceReply(methodName, _) gives methodName
		sentReply(methodName, _, _) gives methodName
		serviceStart(factory, _) gives factory
		deferred panic("tryTargetNoun: a deferred `try` target reached a diagnostic about what it produces — `requireCaughtResultIsSpokenFor` returns before asking for one, and `parseTry` asks only of a `void` result, which no deferred target has")
	end 'kind'
end 'tryTargetNoun'

function tryTargetProducesNoValueError(target TryTarget, signatures ProgramSignatures, tryTok Token) returns SourceParseError
	match target 'kind'
		send(messageName, _) then return SourceParseError.unsupported(serviceSendHasNoValueRefusal(messageName), line: tryTok.line, column: tryTok.column)
		named or
		witness or
		promise or
		serviceReply or
		serviceStart or
		sentReply or
		deferred then break
	end 'kind'

	return SourceParseError.errorTypeMismatch("'{String.from(tryTargetNoun(target, signatures: signatures))}' does not return a value", line: tryTok.line, column: tryTok.column)
end 'tryTargetProducesNoValueError'

// **E3059's NOUN for a `named` target, and the reason it is not just the callee.** A COMPILER-EMITTED
// callee is not a name the author can type — `__` is the prefix E2051 bars every declaration from — so
// quoting it produces the right code describing a construct the program does not contain: a program written
// `mm.setLength(1)` was told about `'__managed_set_length'`. `GtRuntime.runtimeCalleeSourceMethod` is the ONE home
// of "what did the author call this runtime callee?", which E3057's sentence asks as well and which is asked
// here rather than threaded down from every builtin emission site.
//
// ⚠ **`declaresCallee` IS THE GATE, NOT THE `__` PREFIX, AND IT IS THE SAME DOOR THAT ADMITTED THIS `try`.**
// `requireThrowingNamedTryTarget` asks `declaresCallee` FIRST: `stdlib/Builtins.maxon`
// declares AND calls `__int_fromString(…) throws SourceParseError`, so a `__` name can be a real declaration whose
// spelling the author did write. Reading the same predicate here means the check that let the target through
// and the message that blames it cannot come to disagree about whether the name has a declaration.
function tryTargetNamedNoun(callee immutable ByteArray, signatures ProgramSignatures) returns immutable ByteArray
	if signatures.declaresCallee(callee) 'declared'
		return callee
	end 'declared'

	// An undeclared callee here is compiler-internal (see `tryTargetOfCallee`).
	match runtimeCalleeSourceMethod(callee) 'sourceMethod'
		found(method) then return method

		// ⚠ **BOTH REFUSALS ARE DRIFT GUARDS, NOT USER-FACING PATHS — AND THE REACHABLE SET IS NINE, DERIVED
		// RATHER THAN PROBED.** A callee reaches E3059 iff it is THROWING (to pass E3055) and its
		// emission site tags the result VOID (to fail the void check), so the set is `isThrowingRuntimeCallee`
		// intersected with the `resultTag: ValueTypeTag.void` emission sites: `__managed_set` and the buffer's five
		// void mutators, PLUS `__mf_delete`, `__mf_rename` and `__md_create`. Every one is answered `found`.
		//
		// ⚠⚠ **AN ENUMERATION HERE IS A CLAIM ABOUT A SET, SO IT IS DERIVED FROM THE TWO PREDICATES THAT
		// DEFINE IT.** Probing one family at a time only ever finds the families you were already looking at:
		// the file and directory families have void throwing members too, and E3059 is a live SECOND consumer
		// of their maps. With `__mf_delete`'s arm answering `stat` and `__md_create`'s answering `next`, the
		// suite reads **2897 passed, 0 failed** while the compiler tells an author who wrote `delete` about
		// `'stat'`. The three cases below the buffer four in `specs/void-call-result.md` are what close that.
		sharedByTwoSpellings(spelling, alsoSpelled) then panic("tryTargetNamedNoun: '{String.from(callee)}' reached a VALUELESS-`try` diagnostic while answering two source spellings ('{String.from(spelling)}'/'{String.from(alsoSpelled)}'). A callee reached by two spellings returns a value in both — that is why two spellings exist — so it cannot be void here. If a valueless one now exists, E3059 needs a wording that names both without claiming which was written")

		// A FURTHER family joining `isThrowingRuntimeCallee` with a void member and no source-method map lands
		// here. Refused loudly rather than leaking the symbol, because there is no honest noun to substitute:
		// E3059 quotes a NAME, and "'array accessor' does not return a value" is not a sentence — which is
		// exactly why the array family has a map instead of a family wording.
		notFound then panic("tryTargetNamedNoun: no source-method spelling for the throwing runtime callee '{String.from(callee)}', which a valueless `try` needs to quote. Its family joined `isThrowingRuntimeCallee` without adding an arm to `GtRuntime.runtimeCalleeSourceMethod`; add one answering the parser's own method constant rather than letting E3059 print a `__` symbol no author can type")
	end 'sourceMethod'
end 'tryTargetNamedNoun'

// **E3055 for a `try` target THAT CARRIES ITS OWN CLAUSE** — a witness-dispatched interface method or a promise out of storage.
// Unconditional, unlike the `named` twin: neither
// an interface method nor a storage type is in the signature registry, so there is no "undeclared, leave it
// to E3004" case to exempt, and in both the clause is a fact the parser has already established — from the
// constraint resolution for one, from the `Promise with (T, E)` argument for the other. One function
// because it is one rule; the two shapes differ only in which noun they hand it.
function requireThrowingClauseTryTarget(noun ByteArray, throwsClause ThrowsClause, tryTok Token) throws SourceParseError
	if not throwsClauseIsThrowing(throwsClause) 'nonThrowing'
		throw SourceParseError.tryOnNonThrowing(String.from(noun), line: tryTok.line, column: tryTok.column)
	end 'nonThrowing'
end 'requireThrowingClauseTryTarget'

// The result of `captureEnclosing`: a name that resolved into an enclosing frame yields
// `captured` with the value read out of the env block; any other name is `notCaptured` and resolves
// through the ordinary top-level path.
union CaptureResult
	captured(value ValueId)
	notCaptured
end 'CaptureResult'

// The result of `captureScopeOf`: the immediate enclosing scope that binds a name for capture,
// or `notCaptured`. Distinct from `CaptureResult` — this yields the SCOPE (so a caller can read the binding's
// TYPE, e.g. to resolve a captured struct base's layout), where `CaptureResult` yields the read VALUE.
union CaptureScopeResult
	found(scope Scope, frame ElementIndex)
	notCaptured

	export function isFound() returns bool
		return match self 'result'
			found gives true
			notCaptured gives false
		end 'result'
	end 'isFound'
end 'CaptureScopeResult'

union ValueBaseBinding
	thisFrame
	captured(frame ElementIndex)
	unbound
	alwaysAType

	function isFrameValue() returns bool
		return match self 'binding'
			thisFrame or
			captured gives true
			unbound or
			alwaysAType gives false
		end 'binding'
	end 'isFrameValue'

	function isCaptured() returns bool
		return match self 'binding'
			captured gives true
			thisFrame or
			unbound or
			alwaysAType gives false
		end 'binding'
	end 'isCaptured'

	function isUnbound() returns bool
		return match self 'binding'
			unbound gives true
			thisFrame or
			captured or
			alwaysAType gives false
		end 'binding'
	end 'isUnbound'
end 'ValueBaseBinding'

// Shared for `ChainResolution.UnqualifiedChain`'s reason: `valueBaseAt` answers at every dotted base.
let ThisFrameValueBase = ValueBaseBinding.thisFrame

let UnboundValueBase = ValueBaseBinding.unbound

let TypeValueBase = ValueBaseBinding.alwaysAType

union EnumAccessorBase
	thisFrame
	receiver
	captured(scope Scope, frame ElementIndex)
end 'EnumAccessorBase'

// ⭐ **WHAT A TOP-LEVEL MANAGED NAME DENOTES AT A METHOD-RECEIVER POSITION** — `managedReceiverBindingOf`'s
// answer, and the reason it is a union rather than two booleans: the two kinds of managed binding need
// DIFFERENT payloads to build a receiver from (a `let` needs the bytes it re-materializes; a `var` needs
// the slot's label and type to load from), and the predicate and the dispatch must read ONE resolution or
// they can claim a shape for a door the other resolves differently.
//
// `none` is an ANSWER, not a failure: the name is spelled like a managed binding somewhere in the program
// but is not visible from THIS file (the file-scoped key), so the shape is not a method call at all.
//
// ⚠ **IT IS BUILT ONLY PAST `Parser.managedTopLevelBaseAt`, AND THAT GATE IS A BOOL FOR THIS UNION'S SAKE.**
// A Maxon union value is a heap object, `none` included, so a version of the gate that answered with this
// type allocated once per DOTTED CALL in the program instead of once per managed-receiver call site — a
// measured +3,465 allocations on rung 5 of a corpus that declares no managed binding at all, doubling with
// the program. The narrow answer is not the cheap one here; the narrow QUESTION is.
union ManagedReceiverBinding
	inlineWord(payload FullRangeInt, typeName immutable ByteArray)

	// A managed `let` — `bytes`/`kind` are what `emitManagedConstant` re-materializes.
	constant(bytes immutable ByteArray, kind ManagedConstKind)

	// A STORED managed binding (a record `let` the compiler cannot image) — `label`/`valueType` are what
	// `emitGlobalLoad` reads the slot with. Such a `let` is stored AND immutable: `Live.push(1)` must be
	// E3207 where `Buffer.push(1)` is legal, and the synthetic `VarInfo` the dispatch wears is the only
	// thing that can say so.
	global(label immutable ByteArray, valueType MaxonType)
	none

	// ⭐ An IMAGE-DATA `let` whose value is a RECORD the image describes — a constant array literal, an
	// empty `Array with T`, or a declared container's box (`Map`, `Set`, and every generic written the way
	// they are). It materializes its record at the receiver exactly as the `constant` arm does, and is
	// immutable for that arm's reason: `.rdata` is not writable, so `Live.push(1)` is E3207 and the
	// synthetic `VarInfo` is what says so.
	//
	// ⛔ **IT MAY HAVE FIELDS, AND EVERY READER OWES THEM A CHAIN.** A container box is a struct over its
	// columns, so `Shared.items` is an ordinary field read; only the two buffer shapes have none. A reader
	// that folds this case into a no-field arm answers `undefinedVariable` for the BASE — a name it has
	// just resolved — rather than a member diagnostic (`Parser.resolveFieldChain`).
	imageRecord(image TopLevelImageRecord)

	// ⭐ An IMAGE-DATA `let` holding a BOX — a constructed struct, or a boxed union's payload-free case. Its
	// box is `.rdata` too, so it is immutable for the arm above's reason, and it differs in carrying its
	// bytes, its type NAME and the tag its value stands at rather than a record description: a box has no
	// stride, count or element destructor to describe.
	imageBox(nodes ImmortalBoxNodeArray, root ElementIndex, typeName immutable ByteArray, tag ValueTypeTag)
	poisoned
end 'ManagedReceiverBinding'

// ⭐ **DID A TOP-LEVEL MANAGED RECEIVER ANSWER THIS CALL?** — `dispatchOnManagedTopLevelReceiver`'s two
// outcomes. The `none` half is a union arm and not a sentinel `ValueId` because 0 is a real value id
// (`self`'s), and the two callers do different things with it: one falls back to a plain reference, the
// other panics on a gate that promised there was a receiver here.
union ManagedTopLevelDispatch
	dispatched(result ValueId)
	notAManagedReceiver
end 'ManagedTopLevelDispatch'

// One incoming edge at a control-flow join, for the move reconciliation: the predecessor block a drop is
// emitted INTO when this edge kept a binding live, paired with the move state that edge carries. An
// `if`/`else` builds two (the then and else ends); a `match` builds one per reaching arm.
type ReachingMoveEdge
	export var block as IrBlock
	export let mark as MoveMark

	static function create(block IrBlock, mark MoveMark) returns ReachingMoveEdge
		return Self{block: block, mark: mark}
	end 'create'
end 'ReachingMoveEdge'

typealias ReachingMoveEdgeArray = Array with ReachingMoveEdge

// A loop-header (or loop-exit) phi: the mutable BINDING it carries, paired with the
// block-arg ValueId minted for it. POSITIONAL — the k-th phi var corresponds to
// `blockArgs[k]` on the merge block and to `argIds[k]` on every predecessor's
// `BranchEdge`, so all three follow one order.
//
// That order is declaration order over the bindings the loop CARRIES — the mutable vars in
// scope that its body assigns (`parseWhileStatement`) — which is a SUBSET of `mutableVars`,
// not a copy of it. So a phi list is indexed by phi position and never by a binding's index
// in `mutableVars`; the two coincided once and no longer do.
//
// The binding is held as the `VarInfo` OBJECT, not as its name. A name cannot address
// it: a block nested inside the loop may SHADOW the name, and then a name-keyed read
// would fetch the shadow — so `break`ing out of such a block would carry the shadow's
// value into the loop's exit phi. A silent miscompile, and the reason `Scope` mutates
// bindings in place instead of replacing them (see Scope's header).
type LoopPhiVar
	export var binding as VarInfo
	export let phiId as ValueId

	// The binding's value on the PREHEADER edge — the one edge into the header that comes from OUTSIDE
	// the loop. It is captured at mint time because installing the phi (`binding.boundValue = phiId`)
	// overwrites the very field it would otherwise be read from, and the preheader's block-arg list is
	// built AFTER every phi has been minted (`edgeArgsFor(preLoop: true)`).
	export let entryValue as ValueId

	static function create(binding VarInfo, phiId ValueId, entryValue ValueId) returns LoopPhiVar
		return Self{binding: binding, phiId: phiId, entryValue: entryValue}
	end 'create'
end 'LoopPhiVar'

typealias LoopPhiVarArray = Array with LoopPhiVar

// ⭐ **A POSITION IN `Parser.mutableVars`** — an index into that declaration-ordered stack, or
// `InnermostMutableVar.none` for "no mutable binding of that name is in scope". The stack is addressed by
// position (rather than the bindings being addressed by name) in exactly one place: the inverse
// index below, which is what turns "which bindings does this construct assign?" from a walk of
// everything in scope into a lookup per name assigned. Ascending position IS declaration order,
// which is the order every carried set must be returned in (see `assignedBindingsIn`).
export union InnermostMutableVar
	none
	at(position ElementIndex)
end 'InnermostMutableVar'

export typealias MutableVarShadowColumn = Array with InnermostMutableVar

// ⭐ **THE INVERSE OF `mutableVars`: name → the position of the INNERMOST binding with that name.**
// Keyed by the identifier's raw source slice, which is how every other name lookup in the parser is
// keyed (`ByteArray` hashes and compares by content — see Token.value).
//
// It holds only the innermost binding of each name because a name has only one meaning at a time.
// The ones it SHADOWS are still reachable — `Parser.mutableVarShadowed` chains them — because a
// carried set must contain every entry of `mutableVars` a construct's tokens name, shadowed or not
// (see `assignedBindingsIn` for why the shadowed ones are harmless and must nonetheless be kept).
typealias MutableVarPositionByName = Map with ByteArray, ElementIndex

function innermostMutableVarIn(byName MutableVarPositionByName, name ByteArray) returns InnermostMutableVar
	let position = try byName.get(name) otherwise return InnermostMutableVar.none
	return InnermostMutableVar.at(position)
end 'innermostMutableVarIn'

// A dense per-TOKEN column of token indices — `Parser.blockExtentEnds`, which answers "where does the block
// opened here close?" in one array read. Flat and dense for the reason `SourceRangeTable`'s columns are: a
// per-opener heap object would be one live allocation per construct, on the token array's own scale.

function paramTypeStartAt(paramTypeStarts TokenIndexArray, position ElementIndex) returns ElementIndex
	return try paramTypeStarts.get(position) otherwise panic("paramTypeStartAt: paramTypeStarts.get OOB at {position} — a parameter's columns are built in lockstep")
end 'paramTypeStartAt'

// Does the ASCENDING token-index list `column` hold `index`? The bisect BOTH sparse keyword indexes are
// read through — `declaredNameKeywords` (via `namesADeclaration`) and `blockKeywordNames` (via
// `keywordIsAName`). One routine, because it is one question asked of two lists built to the same
// discipline, and a second copy is how two bisects' bounds drift apart.
//
// ⚡ The `count()` read is the whole cost for very nearly every file: neither list has an entry unless the
// file actually spells the shape it records.
function ascendingTokenIndexHolds(column TokenIndexArray, index ElementIndex) returns bool
	let at = firstTokenAtOrAfter(column, from: 0, past: column.count(), token: index)

	if at >= column.count() 'nothingAtOrAfter'
		return false
	end 'nothingAtOrAfter'

	return (try column.get(at) otherwise panic("ascendingTokenIndexHolds: get OOB at {at} of {column.count()}")) == index
end 'ascendingTokenIndexHolds'

// The first entry of `column` within `[from, past)` that is `token` or later, or `past` when none
// is. Every bisect over an ascending token-index column reads through it, so the bounds live in one
// place.
function firstTokenAtOrAfter(column TokenIndexArray, from ElementIndex, past ElementIndex, token ElementIndex) returns ElementIndex
	var low = from
	var high = past

	while low < high 'bisect'
		let middle = low + (high - low) / 2
		let atMiddle = try column.get(middle) otherwise panic("firstTokenAtOrAfter: get OOB at {middle} of {column.count()}")

		if atMiddle < token 'below'
			low = middle + 1
		end 'below' else 'atOrAbove'
			high = middle
		end 'atOrAbove'
	end 'bisect'

	return low
end 'firstTokenAtOrAfter'

// The bare member names of a generic type's inner ranged typealiases, in scope while its body is parsed
// (`Parser.enclosingInnerAliases`). Keyed by content like every other name set here.
typealias InnerAliasNameSet = Set with ByteArray

// The per-value existential-instance column this parser fills is `IrFunction.valueExistentialInstances`, and
// both the `ValueExistentialInstanceMap` typealias and its `ValueExistentialInstanceColumn` state are
// declared there — the parser WRITES the fact and three later tiers read it, so the IR tier owns the shape.

// ⭐⭐ **A PER-FUNCTION MAP FROM AN SSA VALUE TO THE RANGED TYPEALIAS ITS DECLARED TYPE NAMES — for the two
// values whose OWN type columns cannot carry it.** E3010 ("unneeded cast") is a question about DECLARED
// types on both sides, and the compiler's `(tag, nameId)` columns answer it for a parameter, a field and an
// int-alias call result — but not for these two:
//
//   • **A ranged FLOAT alias.** Its value's tag is LIFTED to `float` (`resolveFloatAliasType`), because a
//     `named` float would be filed in a GPR — and `MaxonType.float` has no id slot, so the name is dropped
//     with it. `identity(42.0) returns Float` then `f as Float` has to know `f` is a `Float`.
//   • **The RESULT of a representationally-no-op `as` cast**, which `applyCast` flows on as the SOURCE
//     ValueId, unchanged and unminted. `let b = 42 as Byte` therefore leaves `b` naming the literal's
//     `integer`-tagged value, and `b as Byte` would look like a cast from a bare int.
//
// ⚠ **THE CAST WRITER IS GATED ON THE OPERAND NOT BEING A BARE LOCAL, AND THAT GATE IS WHAT KEEPS THE MAP
// FROM LYING.** A no-op cast returns the source ValueId, so `let a = 42` + `let b = a as Byte` leaves `a`
// and `b` naming ONE value — and writing `Byte` on it would make a later, genuinely-needed `a as Byte`
// report E3010 against a plain int. Recording only when the operand was a TEMPORARY (a literal, a call
// result, an expression — `rhsWasBareLocalReference` is the same question the move-poison asks, and it is
// asked of the same token range) means the value has no other name to corrupt. The cost is a FALSE
// NEGATIVE — `let x = t as Byte` for a bare local `t` records nothing, so a later `x as Byte` goes
// unreported.
//
// ⚠⚠ **"A MISSING DIAGNOSTIC IS THE SAFE DIRECTION" HOLDS ONLY FOR A MAP WHOSE ONLY READER IS E3010, AND
// THIS MAP HAS A SECOND READER.**
// `arrayLiteralInstanceFor` reads it to decide an array literal's ELEMENT TYPE, which decides the
// record's `element_size@24` — so the false negative is not only a diagnostic that does not fire, it is a
// REPRESENTATION. MEASURED on this tree, with `typealias N = int(0 to 15)`:
//
//   • `[7 as N, 3 as N]`      ⇒ `Array with N`,   `elementSize()` = **-4** (packed)
//   • `[v as N, w as N]`      ⇒ `Array with int`, `elementSize()` = **8**  (both operands bare locals)
//
// ⇒ **A SECOND READER NEEDS A SECOND ARGUMENT, AND THIS ONE DOES NOT HAVE IT.** The fix is not here: a
// no-op cast whose source is a bare local has no distinct ValueId to carry the alias, so the alias must be
// given one — a fourth `applyCast` re-tag predicate beside `castChangesTheShiftFill` /
// `castChangesTheDivisionProof` ("the target alias PACKS and the source's does not"), which mints through
// `emitRetaggedCastValue` exactly as those two do and propagates the parser's constant view across the
// mint. That is a change to `applyCast`'s contract with corpus-wide reach (`int(0 to 5)`,
// `int(0 to 7)` and `int(0 to 10)` all pack), so it is filed here rather than smuggled into a review commit.
//
// ⚠ **THE RULE, NOT A ROSTER: a float-alias value is recorded when it is a CALL RESULT, and is not
// recorded anywhere else.** Every other producer of one erases the alias by the same lift and goes
// unrecorded — a PARAMETER (`seedParamTypes`, whose loop iterates declared types with no ValueId in hand:
// a parameter's id is its position, RESERVED rather than minted), a FIELD READ
// (`ProgramSignatures.declaredSlotType` returns a bare `MaxonType.float`), a CLOSURE CAPTURE
// (`emitCaptureRead`). Those are instances, not a list to keep current: the deciding fact is that only
// `mintOwnedCallResult` still holds the un-lifted declared type at a point where a ValueId exists.
//
// It is the SAME false negative the bare-local gate above trades for, not a different rule — `f as Float`
// inside `function g(f Float)` reports nothing — and it closes at each producer that comes to hold both
// halves. An enumeration written once rots.
//
// A Map rather than a dense column because the population is a program's float-alias values plus its
// casts, which is zero for most functions. Reset per function and SWAPPED across a closure body (its value
// ids are a fresh SSA space), exactly like the sibling value columns.
typealias ValueDeclaredAliasMap = Map with (ValueId, TypeNameId)

typealias DeclaredAliasMemo = RewindableMemo with (TypeNameId, DeclaredAlias)

typealias NamedTypeTagMemo = RewindableMemo with (TypeNameId, ValueTypeTag)

typealias ElementSlotMemo = RewindableMemo with (GenericInstanceId, ElementSlot)

typealias ElementLiteralTargetMemo = RewindableMemo with (GenericInstanceId, ElementLiteralTargets)

union GlobalMapColumnsAnswer
	known(pair ColumnPair)
	notAnImmutableMapLiteral
end 'GlobalMapColumnsAnswer'

typealias GlobalMapColumnsMemo = RewindableMemo with (immutable ByteArray, GlobalMapColumnsAnswer)

// ⭐⭐ **WHICH OP A CHARACTER-LITERAL VALUE'S `.rdata` RECORD WAS EMITTED BY** — the fact `integerizedOperand`
// needs to REPLACE that record with an integer immediate instead of leaving it behind.
//
// Every character literal materializes as a `Character` (`parseCharLiteral`), and an integer-expecting
// position un-materializes it. That direction cannot emit the other thing and leave the first behind, which
// would cost only a dead `const` the fold's DCE collects:
// a Character is a `stringLiteral` op, and `LowerMaxonToStd.lowerStringLiteral`
// registers `.rdata` for one whether or not anything reads it — a blob, a 56-byte record and a fixup off the
// ONE `GlobalDataTable.nextStringId` counter every rdata prefix shares. A single stray blob in a
// stdlib module therefore renumbers every later `__str_blob_`/`__jumptable_` label in EVERY program.
// So the op is rewritten in place, and this is how its index is found in O(1).
//
// A Map rather than a dense column for `ValueDeclaredAliasMap`'s reason: the population is a function's
// character literals, which is zero for almost every function. Reset per function and SWAPPED across a
// closure body (its value ids are a fresh SSA space), exactly like the sibling value columns.
typealias CharLiteralOpMap = Map with (ValueId, ElementIndex)

// ⭐⭐ **WHICH OP PRODUCED EACH `addressableBytes()` BYTE VALUE — the map that lets a write intrinsic
// CONSUME the String instead of the buffer surface.** `addressableBytes()`
// yields an `Array with Byte` so the value can be TYPED as one; `__Builtins.writeStdout`/`writeStderr` read
// `buffer@0` and `length@8` and NOTHING else — the two slots a String record already carries, at the same
// offsets. So when its sole consumer is the write, the whole call chain exists to satisfy a type nobody
// reads: the managed-memory runtime and the leak gate arrive in a hello-world for it (MEASURED at
// 1,749 ⇒ 3,226 code bytes with the fold absent).
//
// ⚠ A String record IS a buffer record, so `__str_bytes_view` is one `__mm_incref` and the drop is a
// `__managed_decref`. The fold removes both, plus two calls — and it keeps `__managed_decref`, and with it
// the buffer runtime, out of a program that only prints.
//
// ⚠⚠ **WHAT IT FILES IS A CORPUS CALL** — `call String.addressableBytes(s)`, filed by
// `dispatchMethodOnBase`, the member being `stdlib/String.maxon:181`'s. ⭐ **THE REWRITE DEPENDS ON NOTHING
// BUT THE OP'S SHAPE**: one result, one argument, and that argument is the String. Re-pointing the callee
// at `__write_stdout` turns the producer into the consumer.
//
// The op is REWRITTEN IN PLACE for `CharLiteralOpMap`'s reason and this is how its index is found in O(1) —
// leaving the producing call behind and emitting a second one would keep the allocation this exists to
// remove.
//
// A Map rather than a dense column for `CharLiteralOpMap`'s reason: the population is a function's
// `addressableBytes()` calls, which is zero for every user function (the method is stdlib-only) and for
// almost every stdlib one. Reset per function and SWAPPED across a closure body, exactly like the siblings.
typealias StringBytesViewOpMap = Map with (ValueId, ElementIndex)

// ⭐ **A PER-VALUE TUPLE-SLOT SURFACE** — an SSA value that is a TUPLE ⇒ the `DeclaredSurface` word
// whose slot bits say which of its ELEMENTS the declaration spelled `__ManagedMemory`. A keyed payload
// rather than bare membership, which is what separates it from `ValueMarkSet`: "this value is a buffer" is
// one bit, "this value's element 0 but not element 1 is a buffer" is not.
//
// ⚠ **IT MAY NOT LIVE ON THE TUPLE'S TYPE, AND THAT IS THE WHOLE POINT** — `(__ManagedMemory, Int)` and
// `(ByteArray, Int)` canonicalize to ONE interned tuple with ONE `StructLayout`, so a surface written there
// would be read by both spellings. See `SignatureIndex.tupleStructLayout`'s ⚠⚠ block.
typealias ValueSlotSurfaceMap = Map with (ValueId, immutable DeclaredSurface)

// One enclosing loop on the parser's loop-context stack. `break`/`continue` read it
// to find their targets (innermost, or by label) and to build the block-arg value
// lists they carry to the exit / header. Because the header phis are created EAGERLY
// at loop entry (before the body is parsed), every in-edge can fill its BranchEdge
// argIds immediately from the current variable values — there is no deferred
// phi-operand backpatching, which keeps the loop lowering a single forward pass.
//
// It carries a separate continue target (`continueTargetId`): in a `while`, `continue`
// re-evaluates the condition, so its target IS the header; a `for`'s `continue` must run
// the STEP block's increment first, or the counter never advances and the loop spins
// forever. A `while` sets it to its own header, so there is exactly ONE rule here and
// `parseContinueStatement` has no construct to branch on.
type HeaderRead
	export let name as ByteArray
	export let line as LineNumber
	export let column as ColumnNumber

	static function create(name ByteArray, line LineNumber, column ColumnNumber) returns Self
		return Self{name: name, line: line, column: column}
	end 'create'

	function movedInAnEarlierIteration() returns SourceParseError
		return SourceParseError.useAfterMoveInAnEarlierIteration(String.from(self.name), line: self.line, column: self.column)
	end 'movedInAnEarlierIteration'

	function precedes(other HeaderRead) returns bool
		return self.line < other.line or (self.line == other.line and self.column < other.column)
	end 'precedes'
end 'HeaderRead'

union FirstHeaderRead
	none
	read(at HeaderRead)
end 'FirstHeaderRead'

function readPrecedes(read HeaderRead, first FirstHeaderRead) returns bool
	return match first 'sofar'
		none gives true
		read(earlier) gives read.precedes(earlier)
	end 'sofar'
end 'readPrecedes'

type SettledMoveEdge
	export let block as BlockId
	export let position as ElementIndex

	static function create(block BlockId, position ElementIndex) returns Self
		return Self{block: block, position: position}
	end 'create'
end 'SettledMoveEdge'

typealias SettledMoveEdgeArray = Array with SettledMoveEdge

type HeaderDependentPhi
	export let value as ValueId
	export let block as BlockId
	export let slot as ElementIndex

	static function create(value ValueId, block BlockId, slot ElementIndex) returns Self
		return Self{value: value, block: block, slot: slot}
	end 'create'
end 'HeaderDependentPhi'

typealias HeaderDependentPhiArray = Array with HeaderDependentPhi

type HeaderDependents
	export var marks as ValueMarkSet
	export var values as ValueIdArray
	export var phis as HeaderDependentPhiArray

	static function create(headerValue ValueId) returns Self
		let marks = ValueMarkSet.create()
		marks.insert(headerValue)
		let values = ValueIdArray.create(0)
		values.push(headerValue)
		return Self{marks: marks, values: values, phis: HeaderDependentPhiArray.create(0)}
	end 'create'

	function holds(value ValueId) returns bool
		return self.marks.contains(value)
	end 'holds'

	function addPhi(value ValueId, block BlockId, slot ElementIndex)
		self.addEpoch(value)
		self.phis.push(HeaderDependentPhi.create(value, block: block, slot: slot))
	end 'addPhi'

	function addEpoch(value ValueId)
		self.marks.insert(value)
		self.values.push(value)
	end 'addEpoch'
end 'HeaderDependents'

type PhiEdge
	export var source as IrBlock
	export var args as ValueIdArray

	static function create(source IrBlock, args ValueIdArray) returns Self
		return Self{source: source, args: args}
	end 'create'
end 'PhiEdge'

typealias PhiEdgeArray = Array with PhiEdge

function anIncomingEdgeIsSettled(edges PhiEdgeArray, settled BlockIdSet) returns bool
	for edge in edges 'eachIncomingEdge'
		if settled.contains(edge.source.id) 'settledOnThisEdge'
			return true
		end 'settledOnThisEdge'
	end 'eachIncomingEdge'

	return false
end 'anIncomingEdgeIsSettled'

function valueMarksOf(values ValueIdArray) returns ValueMarkSet
	let marks = ValueMarkSet.create()

	for value in values 'eachValue'
		marks.insert(value)
	end 'eachValue'

	return marks
end 'valueMarksOf'

function retargeted(target BlockId, from BlockId, to BlockId) returns BlockId
	return to if target == from else target
end 'retargeted'

function retargetedAll(targets BlockIdArray, from BlockId, to BlockId) returns BlockIdArray
	let out = BlockIdArray.create(targets.count(), zeroed: false)

	for target in targets 'eachTarget'
		out.push(retargeted(target, from: from, to: to))
	end 'eachTarget'

	return out
end 'retargetedAll'

typealias HeaderReadMap = Map with (ValueId, HeaderRead)

type HeaderDrop
	export let value as ValueId
	export let results as ValueIdArray

	static function create(value ValueId, results ValueIdArray) returns Self
		return Self{value: value, results: results}
	end 'create'
end 'HeaderDrop'

typealias HeaderDropArray = Array with HeaderDrop
typealias CellEpochRootMap = Map with (ValueId, ValueId)
typealias CellEpochsByRootMap = Map with (ValueId, HeaderDependents)

type PhiSlotUse
	export let block as BlockId
	export let slot as ElementIndex

	static function create(block BlockId, slot ElementIndex) returns Self
		return Self{block: block, slot: slot}
	end 'create'
end 'PhiSlotUse'

typealias PhiSlotUseArray = Array with PhiSlotUse

type PhiSlotUses
	export var slotUses as PhiSlotUseArray

	static function create() returns Self
		return Self{slotUses: PhiSlotUseArray.create(0)}
	end 'create'
end 'PhiSlotUses'

type IncomingPhiEdges
	export var edges as PhiEdgeArray

	static function create() returns Self
		return Self{edges: PhiEdgeArray.create(0)}
	end 'create'
end 'IncomingPhiEdges'

typealias PhiSlotUsesByValue = Map with (ValueId, PhiSlotUses)
typealias IncomingPhiEdgesByBlock = Map with (BlockId, IncomingPhiEdges)

type LoopEdgeIndex
	export var usesByValue as PhiSlotUsesByValue
	export var incomingByBlock as IncomingPhiEdgesByBlock

	static function create() returns Self
		return Self{usesByValue: PhiSlotUsesByValue.create(), incomingByBlock: IncomingPhiEdgesByBlock.create()}
	end 'create'

	function noteEdge(source IrBlock, edge BranchEdge)
		let incoming = try self.incomingByBlock.get(edge.targetBlockId) otherwise IncomingPhiEdges.create()
		incoming.edges.push(PhiEdge.create(source, args: edge.argIds))
		self.incomingByBlock.upsert(edge.targetBlockId, value: incoming)

		for slot in 0 upto edge.argIds.count() 'eachArgument'
			let argument = try edge.argIds.get(slot) otherwise panic("LoopEdgeIndex.noteEdge: argIds.get OOB at {slot} below its own count")
			let recorded = try self.usesByValue.get(argument) otherwise PhiSlotUses.create()
			recorded.slotUses.push(PhiSlotUse.create(edge.targetBlockId, slot: slot as ElementIndex))
			self.usesByValue.upsert(argument, value: recorded)
		end 'eachArgument'
	end 'noteEdge'
end 'LoopEdgeIndex'

union LoopEdgeIndexState
	unbuilt
	built(index LoopEdgeIndex)
end 'LoopEdgeIndexState'

type SettledEdgesAt
	export var edges as SettledMoveEdgeArray

	static function create() returns Self
		return Self{edges: SettledMoveEdgeArray.create(0)}
	end 'create'
end 'SettledEdgesAt'

typealias SettledEdgesByPosition = Map with (ElementIndex, SettledEdgesAt)

type LoopMoveScan
	export let valueFloor as ValueId
	export let blockFloor as BlockId
	export var preheader as IrBlock
	export var phiVars as LoopPhiVarArray
	export let entryMark as MoveMark
	export var exitMark as MoveMark
	export var headerReads as HeaderReadMap
	export var headerDrops as HeaderDropArray
	export var backEdges as ReachingMoveEdgeArray
	export var breakEdges as ReachingMoveEdgeArray
	export var settledEdgesByPosition as SettledEdgesByPosition
	export var edgeIndex as LoopEdgeIndexState
	export var droppedBeforeTheLoop as ValueIdArray
	export var cellEpochRoots as CellEpochRootMap
	export var cellEpochsByRoot as CellEpochsByRootMap

	static function create(valueFloor ValueId, blockFloor BlockId, preheader IrBlock, phiVars LoopPhiVarArray, entryMark MoveMark) returns Self
		return Self{valueFloor: valueFloor, blockFloor: blockFloor, preheader: preheader, phiVars: phiVars, entryMark: entryMark, exitMark: entryMark, headerReads: HeaderReadMap.create(), headerDrops: HeaderDropArray.create(0), backEdges: ReachingMoveEdgeArray.create(0), breakEdges: ReachingMoveEdgeArray.create(0), settledEdgesByPosition: SettledEdgesByPosition.create(), edgeIndex: LoopEdgeIndexState.unbuilt, droppedBeforeTheLoop: ValueIdArray.create(0), cellEpochRoots: CellEpochRootMap.create(), cellEpochsByRoot: CellEpochsByRootMap.create()}
	end 'create'

	function movedOnABackEdge(position ElementIndex) returns bool
		for back in self.backEdges 'eachBackEdge'
			let movedHere = back.mark.movedAt(position)

			if movedHere 'movedHere'
				return true
			end 'movedHere'
		end 'eachBackEdge'

		return false
	end 'movedOnABackEdge'

	function noteCellEpochRoot(epoch ValueId, root ValueId)
		self.cellEpochRoots.upsert(epoch, value: root)
		let rooted = self.cellEpochsRootedAt(root)

		if not rooted.holds(epoch) 'aNewEpochOfIt'
			rooted.addEpoch(epoch)
		end 'aNewEpochOfIt'

		self.cellEpochsByRoot.upsert(root, value: rooted)
	end 'noteCellEpochRoot'

	function noteSettledEdge(block BlockId, position ElementIndex)
		let settled = try self.settledEdgesByPosition.get(position) otherwise SettledEdgesAt.create()
		settled.edges.push(SettledMoveEdge.create(block, position: position))
		self.settledEdgesByPosition.upsert(position, value: settled)
	end 'noteSettledEdge'

	function cellEpochsRootedAt(root ValueId) returns HeaderDependents
		return try self.cellEpochsByRoot.get(root) otherwise HeaderDependents.create(root)
	end 'cellEpochsRootedAt'

	function headerReadOf(value ValueId) returns HeaderRead throws MapError
		return try self.headerReads.get(value)
	end 'headerReadOf'

	function firstReadAmong(dependents HeaderDependents) returns FirstHeaderRead
		var first = FirstHeaderRead.none

		for value in dependents.values 'eachDependent'
			let read = try self.headerReadOf(value) otherwise continue

			if readPrecedes(read, first: first) 'earliestSoFar'
				first = FirstHeaderRead.read(read)
			end 'earliestSoFar'
		end 'eachDependent'

		return first
	end 'firstReadAmong'

	function settlesAtEntry(position ElementIndex) returns bool
		if position >= self.entryMark.height() 'declaredInsideTheLoop'
			return false
		end 'declaredInsideTheLoop'

		return not self.entryMark.movedAt(position)
	end 'settlesAtEntry'

	function tracksValue(value ValueId, mergedBindingValues ValueMarkColumn) returns bool
		return value < self.valueFloor or valueIsMarked(mergedBindingValues, value: value) or self.cellEpochRoots.contains(value)
	end 'tracksValue'

	function cellEpochRootOf(epoch ValueId) returns ValueId throws MapError
		if epoch < self.valueFloor 'theHeadersOwnEpoch'
			return epoch
		end 'theHeadersOwnEpoch'

		return try self.cellEpochRoots.get(epoch)
	end 'cellEpochRootOf'

	function entryValueOfPhi(phi ValueId) returns ValueId
		for phiVar in self.phiVars 'eachPhi'
			if phiVar.phiId == phi 'thisPhi'
				return phiVar.entryValue
			end 'thisPhi'
		end 'eachPhi'

		panic("LoopMoveScan.entryValueOfPhi: v{phi} is no header phi of this loop — a binding moved on a back edge without a header read was reassigned in the body, which is what carries it")
	end 'entryValueOfPhi'
end 'LoopMoveScan'

typealias LoopMoveScanArray = Array with LoopMoveScan

type FinishedLoop
	export var falseEdge as IrBlock
	export var scan as LoopMoveScan

	static function create(falseEdge IrBlock, scan LoopMoveScan) returns Self
		return Self{falseEdge: falseEdge, scan: scan}
	end 'create'
end 'FinishedLoop'

// A hidden owned binding beside a kept constructor feed, whose moved bit means "this path stored
// or moved the feed". The feed's exit drop is `__release_type_param` and the unmoved guard's is
// `__reclaim_type_param` (`emitDecrefOps`): their gates are complementary, so each path destroys
// the value exactly once whether the instantiation is refcounted, a promise or trivial.
type FeedDropGuard
	export let feed as ValueId
	export let guard as ValueId

	static function create(feed ValueId, guard ValueId) returns Self
		return Self{feed: feed, guard: guard}
	end 'create'
end 'FeedDropGuard'

typealias FeedDropGuardArray = Array with FeedDropGuard

type LateHold
	export let opIndex as ElementIndex
	export let held as ValueId

	static function create(opIndex ElementIndex, held ValueId) returns Self
		return Self{opIndex: opIndex, held: held}
	end 'create'
end 'LateHold'

typealias LateHoldArray = Array with LateHold

type LateRead
	export let ops as OpIndexArray
	export var defined as ValueIdArray
	export var holds as LateHoldArray

	static function create(ops OpIndexArray, defined ValueIdArray) returns Self
		return Self{ops: ops, defined: defined, holds: LateHoldArray.create(0)}
	end 'create'

	function addHold(hold LateHold)
		self.defined.push(hold.held)
		self.holds.push(hold)
	end 'addHold'

	function defines(value ValueId) returns bool
		for candidate in self.defined 'eachDefined'
			if candidate == value 'found'
				return true
			end 'found'
		end 'eachDefined'

		return false
	end 'defines'
end 'LateRead'

typealias LateReadArray = Array with LateRead

type LateReadMark
	export let block as BlockId
	export let position as ElementIndex
	export let rangeSites as ElementIndex

	static function create(block BlockId, position ElementIndex, rangeSites ElementIndex) returns Self
		return Self{block: block, position: position, rangeSites: rangeSites}
	end 'create'
end 'LateReadMark'

enum LoopCarriedGuards
	stayUnsettled
	settleAlways
end 'LoopCarriedGuards'

let FeedDropGuardName = b"__feed_drop_guard"

type LoopContext
	export let label as immutable ByteArray

	// ⭐ **WHERE A COMPLETED ITERATION GOES** — the header for a `while` (the condition is re-evaluated
	// on the back edge), the STEP block for a `for` (whose increment must run first). Read by BOTH
	// `continue` and each parser's fall-through back edge, which is what makes it one fact rather than
	// two agreeing spellings.
	//
	// ⚠ There is deliberately no separate header field beside it. There was, and NOTHING EVER READ IT:
	// write-only state whose value COINCIDED with this one for `while` and not for `for`, so a future
	// reader reaching for the obvious-sounding name would have got `while` right, `for` wrong, and no
	// diagnostic either way. The exit is a field below because it is genuinely a different destination.
	export let continueTargetId as BlockId
	export let exitId as BlockId
	export var phiVars as LoopPhiVarArray

	// True once at least one `break` targeted this loop — the exit then merges the
	// header-false-edge value with each break's value, so it needs its own phis.
	export var hasBreak as bool

	// The owned-binding height when this loop's body was entered — the floor a `break`/`continue`
	// releases down to, dropping every owned binding declared since (this iteration's body-local
	// Strings/structs) before it jumps to the exit / back-edge. Equal to the body block's
	// `BlockMark.ownedCount`, because nothing is pushed between recording it and opening the body.
	export let ownedFloor as ElementIndex
	export let scanIndex as ElementIndex
	export let debugOpenFloor as ElementIndex
	export let windowFloor as ElementIndex

	static function create(label ByteArray, continueTargetId BlockId, exitId BlockId, phiVars LoopPhiVarArray, ownedFloor ElementIndex, scanIndex ElementIndex, debugOpenFloor ElementIndex, windowFloor ElementIndex) returns LoopContext
		return Self{label: label, continueTargetId: continueTargetId, exitId: exitId, phiVars: phiVars, hasBreak: false, ownedFloor: ownedFloor, scanIndex: scanIndex, debugOpenFloor: debugOpenFloor, windowFloor: windowFloor}
	end 'create'
end 'LoopContext'

typealias LoopContextArray = Array with LoopContext

// The state one block-form `try 'l' … end 'l' otherwise (e) 'h' … end 'h'` carries while its body
// is parsed. A stack, innermost on top: a nested block routes its body's throws to its own handler,
// and the stack is popped before the handler parses, so a throwing op inside a handler goes to the
// enclosing block, else to a test body's implied handler, else nowhere, which is E3057.
//
// The error block and its phis exist before the body because every routed op branches to it. The
// parser is SSA with block args, so each routed op defines its own flag and the handler sees them
// merged through `flagPhi`; `phiVars` does the same for every mutable binding the body may
// reassign, as `mintLoopHeaderPhis` does for a loop header. The carried set is read off the tokens
// before the body is parsed (see `parseTryBlockStatement`), which is what lets the phis exist that
// early.
type TryBlockContext
	// The `try` keyword — the anchor for every op the ROUTING synthesizes (the flag test, the branch, the
	// landing-pad drops). None of them is spawned by a source token, and the construct that wired them is
	// where a reader looks; `desugarTry` anchors its own fork the same way.
	export let tryTok as Token
	export let label as immutable ByteArray
	export let errBlockId as BlockId
	export let flagPhi as ValueId
	export var phiVars as LoopPhiVarArray

	// The owned-binding height at the `try`, so a routed throw releases exactly what the BODY declared and
	// still owns at that point — the body's `end` is jumped over, so its fall-through drops never run.
	export let ownedFloor as ElementIndex
	export let windowFloor as ElementIndex

	// ⭐⭐ **EVERY DISTINCT ERROR TYPE THIS BLOCK ROUTES, IN FIRST-ROUTED ORDER — the members of the
	// synthesized error union.** Two or more of them is a real Maxon program (`/specs/try-block.md` is
	// mostly made of them), and no discriminant is carried: `fusedTagOffset` on each member maps that
	// member's own case tags into a private slice of one dense integer line, so the pair (which
	// member, which case) is a SINGLE number — see `recordRoutedErrorType` for the assignment and why
	// it is injective.
	export var members as TryBlockErrorMemberArray

	// ⭐ **THE ROUTED EDGES, KEPT SO THE FUSED ORDINAL CAN BE ATTACHED TO THEM AFTER THE BODY IS PARSED.**
	// Whether the block IS a union is not known until its last statement, and a single-member block must emit
	// exactly what it emitted before this existed — so an edge records what it would need and nothing is
	// spent until `synthesizeErrorUnion` decides there is a union to dispatch.
	export var routedEdges as RoutedErrorEdgeArray

	// ⚠ **A MEMBER THE FUSED LINE CANNOT HOLD** — its name, for the refusal `requireRoutableTryBlockBody`
	// raises once a SECOND member proves the block really needs to fuse. Recorded rather than thrown for
	// `conflictingMoveEdge`'s reason: the routing path cannot throw.
	export var unfusableMember as String

	// ⭐⭐ **THE OWNERSHIP STATE THE HANDLER IS ENTERED WITH — the move flags of the bindings declared
	// OUTSIDE this block, as the FIRST routed call left them.** The handler is a sibling path of the body,
	// not its continuation, so it must not inherit whatever the body went on to move after the throw edge
	// was taken; `if`/`else` states the same rule by rewinding to `entryMoveMark` before the else branch.
	// Truncated to `ownedFloor` (`moveMarkPrefix`) because the body's OWN bindings differ in number from one
	// routed call to the next and are released by the landing pad regardless — only the outer ones survive
	// the edge and can still be owed a drop.
	export var edgeMoveMark as MoveMark

	// A LATER routed call whose outer-ownership state DISAGREES with `edgeMoveMark` — the body moved an
	// outer binding BETWEEN two routed calls, so the shared handler is reached with that binding live on one
	// edge and already given away on another. One handler cannot be right for both, so
	// `requireRoutableTryBlockBody` refuses it; recorded here rather than thrown because the router cannot
	// throw (see `routeThrowingOp`).
	export var conflictingMoveEdge as bool

	// A body that routed nothing but minted a deferred value (one resting on an undeclared call) is not
	// refused E3083, which would land in front of the E3004 that explains it.
	export var holdsADeferredValue as bool

	static function create(tryTok Token, label ByteArray, errBlockId BlockId, flagPhi ValueId, phiVars LoopPhiVarArray, ownedFloor ElementIndex, windowFloor ElementIndex) returns TryBlockContext
		return Self{tryTok: tryTok, label: label, errBlockId: errBlockId, flagPhi: flagPhi, phiVars: phiVars, ownedFloor: ownedFloor, windowFloor: windowFloor, members: TryBlockErrorMemberArray.create(0), routedEdges: RoutedErrorEdgeArray.create(0), unfusableMember: "", edgeMoveMark: MoveMark.create(MoveSlots.empty(), consumes: PromiseConsumes.none()), conflictingMoveEdge: false, holdsADeferredValue: false}
	end 'create'

	export function throwsClause() returns ThrowsClause
		let first = try self.members.first() otherwise return ThrowsClause.none
		return first.clause
	end 'throwsClause'
end 'TryBlockContext'

typealias TryBlockContextArray = Array with TryBlockContext

type ClaimScope
	export let enclosingClaim as ThrowRouteClaim
	export let enclosingFloor as ElementIndex
	export let floor as ElementIndex
	export let heldAwaitMark as ElementIndex

	static function create(enclosingClaim ThrowRouteClaim, enclosingFloor ElementIndex, floor ElementIndex, heldAwaitMark ElementIndex) returns ClaimScope
		return Self{enclosingClaim: enclosingClaim, enclosingFloor: enclosingFloor, floor: floor, heldAwaitMark: heldAwaitMark}
	end 'create'
end 'ClaimScope'

type HeldAwait
	export let opIdx as ElementIndex
	export let target as TryTarget
	export let clause as ThrowsClause
	export let awaitTok as Token

	static function create(opIdx ElementIndex, target TryTarget, clause ThrowsClause, awaitTok Token) returns HeldAwait
		return Self{opIdx: opIdx, target: target, clause: clause, awaitTok: awaitTok}
	end 'create'
end 'HeldAwait'

typealias HeldAwaitArray = Array with HeldAwait

type TryFork
	export var okBlock as IrBlock
	export let forkTemps as ValueIdArray
	export let suspendedMark as ElementIndex
	export let entryVals as ValueIdArray
	export var entryMoveMark as MoveMark
	export let resultWasPending as bool
	export let errFlag as ValueId
	export let errFused as ValueId

	static function create(okBlock IrBlock, forkTemps ValueIdArray, suspendedMark ElementIndex, entryVals ValueIdArray, entryMoveMark MoveMark, resultWasPending bool, errFlag ValueId, errFused ValueId) returns TryFork
		return Self{okBlock: okBlock, forkTemps: forkTemps, suspendedMark: suspendedMark, entryVals: entryVals, entryMoveMark: entryMoveMark, resultWasPending: resultWasPending, errFlag: errFlag, errFused: errFused}
	end 'create'
end 'TryFork'

// ⭐⭐ **ONE MEMBER OF A BLOCK-FORM `try`'s SYNTHESIZED ERROR UNION — an error enum the body routes, plus
// the OFFSET that maps its own case tags onto the block's one dense dispatch line.**
//
// ⭐ **`fusedTagOffset` IS WHY NO DISCRIMINANT IS NEEDED.** A discriminant slot beside the flag
// makes each handler arm test a PAIR — `discr == m and flag == ord + 1`, two compares and a fused
// `and`, or two chained blocks for a boxed member. This `match` already owns a tag-interval
// DISPATCH (a balanced binary search over one i64), so a pair would be the one thing that engine
// cannot consume. Adding the offset instead makes `(member, case)` a SINGLE integer, and the whole
// handler is then an ordinary enum match over a synthesized layout — no second compare, no second
// phi, and no second copy of the arm/merge/phi machinery.
type TryBlockErrorMember
	// The error enum/union's name — the identity `recordRoutedErrorType` dedupes on.
	export let name as immutable ByteArray
	export let clause as ThrowsClause

	// Is this member's flag a heap BOX POINTER rather than an `ordinal + bias`? It decides where the member's
	// own tag comes from at a routed edge (a LOAD out of the box vs the flag itself), which is a per-MEMBER
	// fact and not a per-case one: every throw of a boxed union delivers a pointer, payload-free cases
	// included. Both references say the same (`ErrorUnionCaseRef.memberIsBoxed`).
	export let isBoxed as bool

	// The member's declared layout — its case names, tags and payload slots. Held rather than re-looked-up so
	// the fused layout, the arm resolution and the payload binding all read one object.
	export let layout as immutable EnumLayout

	// ⭐ **ADDED TO THIS MEMBER'S OWN CASE TAG TO GIVE THE FUSED TAG**, and `fusedTop` is the highest fused
	// tag it can produce — the position the NEXT member starts one past. Carrying the top on the member,
	// rather than a cursor on the block, is what keeps a block that routes ONE error type from computing
	// anything it will never use. See `recordRoutedErrorType` for the placement and its injectivity argument.
	export let fusedTagOffset as FullRangeInt
	export let fusedTop as FullRangeInt

	// ⚠ **CAN THIS MEMBER BE PLACED ON THE FUSED LINE AT ALL?** False when its own tag span, or its position
	// above the members before it, does not fit an i64 — reachable, because a FLOAT-backed error enum's tags
	// are IEEE-754 bit patterns and one spanning a negative and a positive double is ~1.8e19 wide. It is
	// RECORDED rather than thrown because the routing path cannot throw, and it is only ever an error when a
	// SECOND member arrives: a lone member is never fused, so an unfusable one is a perfectly good block.
	export let fusable as bool

	static function create(name immutable ByteArray, clause ThrowsClause, isBoxed bool, layout immutable EnumLayout, placement FusedPlacement) returns TryBlockErrorMember
		return Self{name: name, clause: clause, isBoxed: isBoxed, layout: layout, fusedTagOffset: placement.offset, fusedTop: placement.top, fusable: placement.fusable}
	end 'create'
end 'TryBlockErrorMember'

typealias TryBlockErrorMemberArray = Array with TryBlockErrorMember

// ⭐⭐ **WHERE ONE MEMBER SITS ON THE FUSED DISPATCH LINE — or that it does not fit.** The three numbers
// travel together because they are one decision: `offset` is what a routed edge and the synthesized layout
// both add to the member's own tag, `top` is the highest fused tag it can produce (where the next member
// starts one past), and `fusable` says whether the arithmetic that produced them was performable at all.
// A service's reply error union is placed by the same arithmetic: `ServiceCompanions`
// asks for the two members' positions and `ServiceBehaviour` reads the handler member's offset back to shift the
// flag it writes into the cell. A second computation of the same line would be one fact in two places, and a
// disagreement between them is a `match e` arm dispatching on the wrong member.
type FusedPlacement
	export let fusable as bool
	export let offset as FullRangeInt
	export let top as FullRangeInt

	static function create(offset FullRangeInt, top FullRangeInt) returns FusedPlacement
		return Self{fusable: true, offset: offset, top: top}
	end 'create'

	// A member the line cannot hold. Its numbers are `0` and are never read: `requireRoutableTryBlockBody`
	// refuses the block the moment a second member joins it, and a block with one member fuses nothing.
	static function tooWide() returns FusedPlacement
		return Self{fusable: false, offset: 0, top: 0}
	end 'tooWide'
end 'FusedPlacement'

// ⭐⭐ **WHERE ONE MEMBER'S CASE LANDS ON THE FUSED LINE — the arithmetic itself, written ONCE because the
// parties that have to land on the same number are in different places.** The dispatch table
// (`fusedErrorUnionInfo`) and every routed edge's fused ordinal express this same sum.
function fusedCaseTag(memberTag FullRangeInt, offset FullRangeInt) returns FullRangeInt
	return memberTag + offset
end 'fusedCaseTag'

// ⚠⚠ **THE FUSED LINE'S CEILING AND FLOOR, HELD SHORT OF `i64`'s OWN BY A MARGIN — so every placement
// question is a COMPARISON and never a trial addition.** `FullRangeInt` is `int(i64.min to i64.max)`, so an
// overflowing `+` is a COMPILER PANIC, not a wrapped number; the placement arithmetic adds at most a `+ 1`
// past a checked bound, and the margin is what lets that `+ 1` be performed without a second question.
let FusedTagCeiling = I64MaxBound - 4
let FusedTagFloor = I64MinBound + 4

// ⭐ **PLACE A MEMBER WHOSE FUSED RANGE MUST START AT `floor`** — every member but the first scalar one.
// The offset that achieves it is `floor - <the member's lowest tag>`, and both that subtraction and the
// resulting top are checked before either is performed.
function fusedPlacementAt(floor FullRangeInt, span EnumTagSpan) returns FusedPlacement
	return match span 'span'
		// A declaration with no cases can throw nothing, so it occupies no position: the next member starts
		// exactly where this one would have, and the layout contributes no fused case for it to collide with.
		noCases gives FusedPlacement.create(0, top: floor - 1)
		spanning(low, high) gives fusedPlacementOfSpan(floor, low: low, high: high)
	end 'span'
end 'fusedPlacementAt'

// The `spanning` arm's arithmetic, split out so the guards read as one sequence rather than nesting inside
// a match arm. Each `return` below is a placement the i64 line cannot express.
function fusedPlacementOfSpan(floor FullRangeInt, low FullRangeInt, high FullRangeInt) returns FusedPlacement
	// The member's own WIDTH first — `high - low` is itself an i64 subtraction, and a float-backed enum
	// spanning a negative and a positive double is wider than the whole line.
	if low < 0 and high > FusedTagCeiling + low 'widerThanTheLine'
		return FusedPlacement.tooWide()
	end 'widerThanTheLine'

	let width = high - low

	// The member has to fit ABOVE `floor` as well as be narrow enough on its own.
	if floor > FusedTagCeiling - width 'noRoomAboveTheFloor'
		return FusedPlacement.tooWide()
	end 'noRoomAboveTheFloor'

	// And the offset itself is `floor - low`, which climbs as `low` falls.
	if low < 0 and floor > FusedTagCeiling + low 'offsetOverflows'
		return FusedPlacement.tooWide()
	end 'offsetOverflows'

	if low > 0 and floor < FusedTagFloor + low 'offsetUnderflows'
		return FusedPlacement.tooWide()
	end 'offsetUnderflows'

	return FusedPlacement.create(floor - low, top: floor + width)
end 'fusedPlacementOfSpan'

// ⭐ **PLACE THE FIRST SCALAR MEMBER, WHOSE OFFSET IS PINNED TO `ErrorFlagOrdinalBias`** — the one member
// whose position is chosen rather than derived, because pinning it there makes its fused ordinal the FLAG
// ITSELF and so costs a one-member block nothing. Only its top has to be checked.
function fusedPlacementAtTheBias(span EnumTagSpan) returns FusedPlacement
	return match span 'span'
		noCases gives FusedPlacement.create(ErrorFlagOrdinalBias, top: ErrorFlagOrdinalBias - 1)
		spanning(_, high) gives FusedPlacement.tooWide() if high > FusedTagCeiling - ErrorFlagOrdinalBias else FusedPlacement.create(ErrorFlagOrdinalBias, top: high + ErrorFlagOrdinalBias)
	end 'span'
end 'fusedPlacementAtTheBias'

// ⭐⭐ **ONE ROUTED THROW EDGE, RECORDED SO ITS FUSED ORDINAL CAN BE ATTACHED ONCE THE MEMBER LIST IS
// COMPLETE.** A block-form `try` does not know whether it is a union until its body's last statement, and a
// single-member block must emit byte-for-byte what it emitted before the union existed — so nothing is
// spent at the edge that a one-member block would not have spent, and `synthesizeErrorUnion` pays the rest.
//
// ⭐ **THE THREE SHAPES, AND WHY THE FIRST ONE COSTS NOTHING.** A routed edge's fused ordinal is
// `<this member's own tag> + fusedTagOffset`:
//   • the FIRST member, when it is SCALAR — its offset is exactly `ErrorFlagOrdinalBias`, so the fused
//     ordinal IS the flag the edge already carries. `fusedValue` is that flag and NO op exists. This is the
//     shape every block that turns out to have one member takes, which is what keeps them unchanged.
//   • any LATER member, when it is SCALAR — `flag + (offset - bias)`, emitted AT ROUTING TIME into the
//     block the edge leaves from, which has no terminator yet at that moment. A second member only ever
//     appears in a block that IS a union, so the op is never dead.
//   • any BOXED member — the tag is a LOAD out of the box, which must not run on the success path (the flag
//     is `0` there and the load would fault). So the edge is forced through a landing PAD and the load is
//     emitted into it at `synthesizeErrorUnion` time — a pad ends in an unconditional branch, which is what
//     lets an op be appended to it after the fact (`IrModule.appendOp` refuses a block ending in a
//     conditional branch, and refusing is right: an op past it would run on one edge only).
type RoutedErrorEdge
	// The EDGE's own argument list — the very array the `BranchEdge` holds, so pushing the fused ordinal onto
	// it IS attaching it to the edge. Positional against `errBlock.blockArgs`, where the fused phi is likewise
	// appended last.
	export var args as ValueIdArray

	// The error flag this edge carries: an `ordinal + bias` for a scalar member, the box POINTER for a boxed
	// one. It is `args[0]`, held again by name because the deferred load reads it.
	export let flag as ValueId

	// Where a DEFERRED computation is emitted — the landing pad, for a boxed member. Unread for the two
	// scalar shapes, whose value is already in `fusedValue`.
	export var block as IrBlock
	export let member as TryBlockErrorMember

	// The already-computed fused ordinal, for both SCALAR shapes. Unread when `member.isBoxed`.
	export let fusedValue as ValueId
	export let anchor as Token

	static function create(args ValueIdArray, flag ValueId, block IrBlock, member TryBlockErrorMember, fusedValue ValueId, anchor Token) returns RoutedErrorEdge
		return Self{args: args, flag: flag, block: block, member: member, fusedValue: fusedValue, anchor: anchor}
	end 'create'

	function attachFusedOrdinal(fused ValueId)
		self.args.push(fused)
	end 'attachFusedOrdinal'
end 'RoutedErrorEdge'

typealias RoutedErrorEdgeArray = Array with RoutedErrorEdge

// ⭐⭐ **WHAT A HANDLER'S `match e` NEEDS WHEN `e` IS A SYNTHESIZED ERROR UNION — and it is
// deliberately NOT A TYPE.** Minting a type and writing it into a registry under a joined NAME
// (`__ErrorUnion2-ErrA-ErrB`) would make that name a table KEY and the join's injectivity a
// correctness property — `/specs/try-block.md`'s `union-member-names-join-injectively` exists
// because `_` spells `{A_B, C}` and `{A, B_C}` identically and one union then silently REPLACES the
// other. The union is carried in the HANDLER's own scope instead, on `errorUnionBindings`, keyed by
// the `(e)` binding name and popped when the handler closes: two nested handlers hold two records
// and neither can see the other's, so there is no shared name space for a join to collide in.
//
// ⛔⛔ **AND THE KEY IS THE BINDING'S IDENTITY, NOT ITS NAME — THIS HEADER ONCE CLAIMED THE NAME WAS
// ENOUGH AND THAT WAS A MEASURED WRONG ANSWER.** "There is no shared name space for a join to
// collide in" is true of one handler against another and FALSE of a handler against its own body:
// The compiler permits shadowing, so `let e = Inner.splat` inside the handler re-binds the name, and `match
// e` took the union path and dispatched on the ERROR's fused ordinal. With case names chosen to
// collide, that **exits 11** where the answer is **22**, and no diagnostic anywhere. (With
// non-colliding names it failed loud instead — `E3034: no case 'one' in the error union` — which is
// how the silent form was found.) `errorUnionForScrutinee` now accepts only when the name still
// resolves to the VALUE the handler bound, so a shadow simply is not the union. A lossy key used as
// an identity, which is a shape this tree has paid for before.
//
// ⭐ **THE LAYOUT IS A DISPATCH TABLE, NOT A VALUE LAYOUT.** Its cases are the `(member, case)` pairs in
// member-then-declaration order and its tags are the fused ordinals; it carries NO payload slots, because a
// payload is read against the MEMBER's own layout (which is also what names the enum in a payload
// diagnostic). Nothing registers it, so nothing outside the handler can resolve it — which is exactly the
// property that makes the missing name safe.
type ErrorUnionInfo
	export let layout as immutable EnumLayout

	// Per FUSED case, the member it came from — parallel to `layout`'s own columns. It answers the two
	// questions a bare enum layout cannot: which enum to name in `ErrA.bang` (exhaustiveness, E3085's
	// ambiguity scan) and which member's rules an arm plays by.
	export let caseMembers as TryBlockErrorMemberArray

	// Each member once, in fused-line order — what a release that must cover every member in flight walks.
	export var members as TryBlockErrorMemberArray

	// The dispatch subject: the fused ordinal every routed edge computed, merged through the error block's
	// last phi. `match e` reads THIS where an ordinary enum match reads `emitEnumDispatchKey(scrut)`.
	export let fusedOrdinal as ValueId

	static function create(layout immutable EnumLayout, caseMembers TryBlockErrorMemberArray, members TryBlockErrorMemberArray, fusedOrdinal ValueId) returns ErrorUnionInfo
		return Self{layout: layout, caseMembers: caseMembers, members: members, fusedOrdinal: fusedOrdinal}
	end 'create'
end 'ErrorUnionInfo'

// What an enum arm's case names resolve against: a declared enum's own layout, or a synthesized error union,
// whose names resolve per member and whose payloads play by the member's layout.
union EnumArmTable
	declared(layout immutable EnumLayout)
	errorUnion(info ErrorUnionInfo)
end 'EnumArmTable'

// ⭐ **ONE RESOLVED ENUM ARM** — its payload bindings, and for an error union the members its alternatives
// name. `parseMatchCommon` needs both: the bindings are what the arm body declares at its head, and the
// members decide whose layout those bindings play by and which boxes the arm owes a release.
type EnumPatternArm
	export let bindings as PayloadBindingArray

	// Each member once, in the order the alternatives first name it. Empty for a declared enum's arm.
	export let members as TryBlockErrorMemberArray

	// The layout the bindings were parsed against — `undeclared` exactly when the arm names several members,
	// which `requireOrArmPayloadSlotsAgree` admits only for an arm that binds nothing.
	export let payloadEnum as DeclaredEnum

	static function create(bindings PayloadBindingArray, members TryBlockErrorMemberArray, payloadEnum DeclaredEnum) returns EnumPatternArm
		return Self{bindings: bindings, members: members, payloadEnum: payloadEnum}
	end 'create'

	// A scalar match's arm: no bindings, no members, no payload layout.
	static function bindingNothing() returns EnumPatternArm
		return Self{bindings: PayloadBindingArray.create(0), members: TryBlockErrorMemberArray.create(0), payloadEnum: DeclaredEnum.undeclared}
	end 'bindingNothing'
end 'EnumPatternArm'

// The layout whose tags the dispatch plan holds.
function enumArmDispatchLayout(table EnumArmTable) returns immutable EnumLayout
	return match table 't'
		declared(layout) gives layout
		errorUnion(info) gives info.layout
	end 't'
end 'enumArmDispatchLayout'

// The layout an arm's payload bindings play by: the declared enum's own, or the one member an error-union
// arm names.
function armPayloadEnumOf(table EnumArmTable, members TryBlockErrorMemberArray) returns DeclaredEnum
	match table 't'
		declared(layout) then return DeclaredEnum.declared(layout)
		errorUnion then break
	end 't'

	if members.count() != 1 'severalMembers'
		return DeclaredEnum.undeclared
	end 'severalMembers'

	let member = try members.get(0) otherwise panic("armPayloadEnumOf: members.get OOB at 0 after the count guard")
	return DeclaredEnum.declared(member.layout)
end 'armPayloadEnumOf'

// Record `member` on an arm's list unless an earlier alternative already named it.
function noteArmMember(members TryBlockErrorMemberArray, member TryBlockErrorMember)
	for named in members 'eachNamed'
		if named.name.equals(member.name) 'alreadyNamed'
			return
		end 'alreadyNamed'
	end 'eachNamed'

	members.push(member)
end 'noteArmMember'

// Is any of these members delivered as a heap box?
function membersHoldABox(members TryBlockErrorMemberArray) returns bool
	for member in members 'eachMember'
		if member.isBoxed 'boxed'
			return true
		end 'boxed'
	end 'eachMember'

	return false
end 'membersHoldABox'

// Is this match's scrutinee a synthesized error union, and if so which — `DeclaredEnum`'s shape, for
// `DeclaredEnum`'s reason: the absent state is structurally distinct from an empty one.
union ErrorUnionMatch
	notAUnion
	synthesized(info ErrorUnionInfo)
end 'ErrorUnionMatch'

// The `ErrorUnionMatch` twin of `enumMatchIsDeclared`.
function errorUnionIsSynthesized(m ErrorUnionMatch) returns bool
	return match m 'm'
		notAUnion gives false
		synthesized gives true
	end 'm'
end 'errorUnionIsSynthesized'

// The `ErrorUnionMatch` twin of `requireEnumLayout` — panics where the caller has already established there
// is a union, so no site has to invent a meaning for the absent case.
