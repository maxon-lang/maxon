	return SourceParseError.errorMatchNotExactlyOnce(String.from(name), reason: "this match is inside a loop the handler opened, which runs it zero times or more than once", line: at.line, column: at.column)
end 'errorMatchInsideALoopRefusal'

function capturedPromiseRefusal(range SourceRange, door ByteArray) returns SourceParseError
	return SourceParseError.promiseCannotBeBorrowed(String.from(door), cure: "This one is a closure's capture: the closure owns it for as long as the closure lives, and its body may run any number of times, so no run of it may give the promise away. Await it in the function that spawned it, or hand the closure what it needs as a parameter", line: range.line, column: range.column)
end 'capturedPromiseRefusal'

function unownedPromiseRefusal(anchor Token, door ByteArray) returns SourceParseError
	return SourceParseError.promiseCannotBeBorrowed(String.from(door), cure: "No frame owns this one: either the slot it was read from has already been consumed by another read of it, or it reached here through a branch or loop join — and a merge has no single slot to empty, because the paths can name different ones. Consume each read once, and do it before the paths join", line: anchor.line, column: anchor.column)
end 'unownedPromiseRefusal'

// The synthesized layout's NAME. It is a diagnostic string and nothing else — no registry holds it, so it
// cannot be a key and cannot collide (and `requireUnreservedName` bars the `__` space from user
// declarations anyway). It reaches a message only through E3081's all-discard sentence, which every other
// error-union diagnostic bypasses by naming the MEMBER enum the author actually wrote.
let SynthesizedErrorUnionName = b"__ErrorUnion"

union CaughtErrorBinding
	anonymous
	named(name immutable ByteArray)
end 'CaughtErrorBinding'

union RuntimeSourceOffence
	none
	recorded(typeName String, value ValueId, funcIndex ElementIndex, anchorIndex ElementIndex)

	function isRecorded() returns bool
		return match self 'offence'
			none gives false
			recorded gives true
		end 'offence'
	end 'isRecorded'
end 'RuntimeSourceOffence'

union MisclosedBlock
