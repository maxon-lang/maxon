// Every parser memo keyed by something a rewind reissues — an op index, a `TypeNameId`, a
// `GenericInstanceId`, a band row, a tuple name — lives here and claims its own `MemoTable` case. A
// memo kept anywhere else survives the rewind and answers the id's next owner with the abandoned
// region's answer: a wrong answer with no diagnostic.
type ParseMemos
	var declaredAliases as DeclaredAliasMemo
	var rangedAliasTags as NamedTypeTagMemo
	var castTargetTags as NamedTypeTagMemo
	var elementSlots as ElementSlotMemo
	var elementLiteralTargets as ElementLiteralTargetMemo
	var globalMapColumns as GlobalMapColumnsMemo
	var imageableVerdicts as ImageableVerdictMemo
	var dropCallees as DropCalleeMemo
	var functionHoldings as FunctionHoldingAnswers
	var instanceViewAliases as InstanceViewAliasMemo
	var usedTypeNames as RewindableNames

	// ⭐⭐ **THE TYPES THIS FILE REACHED INTO THROUGH A VALUE — answers the RESOLVER already computed,
	// kept.** A file can depend on another file's type without ever writing its name: `for it in h.items`
	// then `it.n` needs `Item` VISIBLE and never spells it, which is exactly the question E4006 answers at
	// that access. Recorded there and read by `checkUnusedExports`, so the export-hygiene question is the
	// resolver's own answer rather than a second, weaker walk over the type graph — two answers that
	// disagree leave a program with no legal spelling (E3092 says to drop the `export`, E4006 then refuses
	// the access).
	//
	// ⭐ **TWO WRITERS, ONE PER FAMILY OF REACH, AND NEITHER IS A WALK** — `requireFieldAccessible` for
	// a STRUCT's field, `emitEnumDispatchKey` for an ENUM/UNION's tag. Each states its own rule at its own
	// site; both are the line the compile ALREADY had to reach to emit the access, so neither
	// re-derives anything. A `match` on another file's union names its CASES and never its type, which is
	// the enum half of the same reach.
	//
	// ⚠ **A SEPARATE SET FROM `usedTypeNames` ABOVE, WHICH HOLDS A DIFFERENT FACT.** That one is "a name this
	// file WROTE in a type position" and is E3062's answer; this one holds names the file never wrote. Folding
	// them together would tell E3062 that a file used an alias it never spelled the day a struct and an alias
	// can wear one name.
	var memberAccessedTypeNames as RewindableNames

	// ⭐ The TUPLE type names this file has filed an artifact layout for. The filed copy's field types are
	// interned against `artifact.typeNames` and it cannot be the copy `ProgramSignatures` holds: `remapArtifact`
	// REWRITES an artifact layout's field types IN PLACE on the multi-file path, so a shared object would
	// rewrite the whole-program index's ids to one file's. Nothing in the parser reads the copy back — every
	// layout the parser holds is the index's (`ProgramSignatures.fieldTypeOf`'s precondition) — so only the
	// NAME is kept, and a tuple type written N times in a file files ONE contribution rather than N identical
	// ones for `commitStructTypes` to upsert over. Empty for a file with no tuples.
	var filedTupleNames as RewindableNames

	// ⭐ **THE UAX#29 GRAPHEME-WIDTH ANSWER PER STRING LITERAL OP** — see `SingleByteGraphemeMemo`.
	// Keyed by an OP index and therefore per-FILE: deliberately NOT reset per function, and not swapped
	// across a closure body, because neither changes what a literal's bytes are.
	var singleByteGraphemes as SingleByteGraphemeTable

	// ⭐ **WHETHER EACH `named` TYPE IS A BOXED UNION, BY ITS INTERNED ID** (`valueIsBoxedUnion`) — asked of every
	// `named` value a managed-value test meets, a ranged alias's included, and answered by `enumMatchFor` in a
	// heap box per ask. The interner is this parser's file's, so the ids are dense and an answer holds
	// until a rewind reissues its id.
	var boxedUnionAnswers as BoxedUnionAnswers
	var claims as RewindClaims

	static function create() returns ParseMemos
		let claims = RewindClaims.create()
		let memos = Self{declaredAliases: DeclaredAliasMemo.create(claims, table: MemoTable.declaredAliases), rangedAliasTags: NamedTypeTagMemo.create(claims, table: MemoTable.rangedAliasTags), castTargetTags: NamedTypeTagMemo.create(claims, table: MemoTable.castTargetTags), elementSlots: ElementSlotMemo.create(claims, table: MemoTable.elementSlots), elementLiteralTargets: ElementLiteralTargetMemo.create(claims, table: MemoTable.elementLiteralTargets), globalMapColumns: GlobalMapColumnsMemo.create(claims, table: MemoTable.globalMapColumns), imageableVerdicts: ImageableVerdictMemo.create(claims, table: MemoTable.imageableVerdicts), dropCallees: DropCalleeMemo.create(claims, table: MemoTable.dropCallees), functionHoldings: FunctionHoldingAnswers.rewindable(claims), instanceViewAliases: InstanceViewAliasMemo.create(claims, table: MemoTable.instanceViewAliases), usedTypeNames: RewindableNames.create(claims, table: MemoTable.usedTypeNames), memberAccessedTypeNames: RewindableNames.create(claims, table: MemoTable.memberAccessedTypeNames), filedTupleNames: RewindableNames.create(claims, table: MemoTable.filedTupleNames), singleByteGraphemes: noSingleByteGraphemeLiterals, boxedUnionAnswers: BoxedUnionAnswers.create(claims), claims: claims}
		memos.claims.requireEveryTableClaimed(MemoTable.singleByteGraphemes)
		return memos
	end 'create'

	function scannedGraphemeVerdict(literalOp ElementIndex) returns bool throws MapError
		match self.singleByteGraphemes 'state'
			unwritten then throw MapError.keyNotFound
			entries(scanned) then return try scanned.get(literalOp)
		end 'state'
	end 'scannedGraphemeVerdict'

	function noteGraphemeVerdict(literalOp ElementIndex, verdict bool)
		let scanned = self.graphemeVerdictsForWrite()
		scanned.file(literalOp, value: verdict)
	end 'noteGraphemeVerdict'

	function graphemeVerdictsForWrite() returns SingleByteGraphemeMemo
		match self.singleByteGraphemes 'state'
			unwritten then break
			entries(scanned) then return scanned
		end 'state'

		let fresh = SingleByteGraphemeMemo.create(self.claims, table: MemoTable.singleByteGraphemes)
		self.singleByteGraphemes = SingleByteGraphemeTable.entries(fresh)

		return fresh
	end 'graphemeVerdictsForWrite'

	function graphemeLogCount() returns ElementIndex
		match self.singleByteGraphemes 'state'
			unwritten then return 0
			entries(scanned) then return rewindLogCount(scanned, table: MemoTable.singleByteGraphemes)
		end 'state'
	end 'graphemeLogCount'

	function rewindGraphemeVerdicts(count ElementIndex)
		match self.singleByteGraphemes 'state'
			unwritten then return
			entries(scanned) then rewindLogTo(scanned, table: MemoTable.singleByteGraphemes, count: count)
		end 'state'
	end 'rewindGraphemeVerdicts'

	function mark() returns RewindMark
		let counts = RewindMark.create(MemoTable.allCases.count(), zeroed: false)

		for table in MemoTable.allCases 'eachTable'
			counts.push(self.logCountOf(table))
		end 'eachTable'

		return counts
