	export let info as ErrorUnionInfo

	static function create(name immutable ByteArray, flag ValueId, info ErrorUnionInfo) returns ErrorUnionBinding
		return Self{name: name, flag: flag, info: info}
	end 'create'
end 'ErrorUnionBinding'

typealias ErrorUnionBindingArray = Array with ErrorUnionBinding

// An open error-union arm whose member is boxed: `e` is bound, inside the arm, to a retagged copy
// of the shared flag. `errorUnionFlagOf` maps that box back to the flag, so a `match e` inside the
// arm still reaches the union and its match obligation (E3161).
