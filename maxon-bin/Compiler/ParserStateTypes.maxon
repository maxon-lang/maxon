	function rewindTo(mark RewindMark)
		for table in MemoTable.allCases 'eachTable'
			let marked = try mark.get(table.ordinal) otherwise panic("ParseMemos.rewindTo: the mark holds no count for {table.name}")
			self.rewindTable(table, count: marked)
			requireRewoundCount("memo {table.name}", now: self.logCountOf(table), marked: marked)
		end 'eachTable'
	end 'rewindTo'

	function logCountOf(table MemoTable) returns ElementIndex
		return match table 'which'
			declaredAliases gives rewindLogCount(self.declaredAliases, table: table)
			rangedAliasTags gives rewindLogCount(self.rangedAliasTags, table: table)
			castTargetTags gives rewindLogCount(self.castTargetTags, table: table)
			elementSlots gives rewindLogCount(self.elementSlots, table: table)
			elementLiteralTargets gives rewindLogCount(self.elementLiteralTargets, table: table)
			globalMapColumns gives rewindLogCount(self.globalMapColumns, table: table)
			imageableVerdicts gives rewindLogCount(self.imageableVerdicts, table: table)
			dropCallees gives rewindLogCount(self.dropCallees, table: table)
			functionHoldingAggregates gives rewindLogCount(self.functionHoldings.rewindableAggregates(), table: table)
			functionHoldingInstances gives rewindLogCount(self.functionHoldings.rewindableInstances(), table: table)
			instanceViewAliases gives rewindLogCount(self.instanceViewAliases, table: table)
			singleByteGraphemes gives self.graphemeLogCount()
			boxedUnionAnswers gives rewindLogCount(self.boxedUnionAnswers, table: table)
			usedTypeNames gives rewindLogCount(self.usedTypeNames, table: table)
			memberAccessedTypeNames gives rewindLogCount(self.memberAccessedTypeNames, table: table)
			filedTupleNames gives rewindLogCount(self.filedTupleNames, table: table)
		end 'which'
	end 'logCountOf'

	function rewindTable(table MemoTable, count ElementIndex)
		match table 'which'
			declaredAliases then rewindLogTo(self.declaredAliases, table: table, count: count)
			rangedAliasTags then rewindLogTo(self.rangedAliasTags, table: table, count: count)
			castTargetTags then rewindLogTo(self.castTargetTags, table: table, count: count)
			elementSlots then rewindLogTo(self.elementSlots, table: table, count: count)
			elementLiteralTargets then rewindLogTo(self.elementLiteralTargets, table: table, count: count)
			globalMapColumns then rewindLogTo(self.globalMapColumns, table: table, count: count)
			imageableVerdicts then rewindLogTo(self.imageableVerdicts, table: table, count: count)
			dropCallees then rewindLogTo(self.dropCallees, table: table, count: count)
			functionHoldingAggregates then rewindLogTo(self.functionHoldings.rewindableAggregates(), table: table, count: count)
			functionHoldingInstances then rewindLogTo(self.functionHoldings.rewindableInstances(), table: table, count: count)
			instanceViewAliases then rewindLogTo(self.instanceViewAliases, table: table, count: count)
			singleByteGraphemes then self.rewindGraphemeVerdicts(count)
			boxedUnionAnswers then rewindLogTo(self.boxedUnionAnswers, table: table, count: count)
			usedTypeNames then rewindLogTo(self.usedTypeNames, table: table, count: count)
			memberAccessedTypeNames then rewindLogTo(self.memberAccessedTypeNames, table: table, count: count)
			filedTupleNames then rewindLogTo(self.filedTupleNames, table: table, count: count)
		end 'which'
	end 'rewindTable'
end 'ParseMemos'

type StatementSlots
	var claimOpFloor as ElementIndex
	var qualifiedTypeBase as QualifiedTypeBase
	var handedResolution as HandedResolution

	// The first break of a combined error's match obligation found where nothing may throw — a drop site or a
	// join — held until the handler's end refuses it (`requireNoHeldErrorMatchRefusal`).
	var errorMatchRefusal as ErrorMatchRefusal

	// The token index of the `end` most recently consumed by `parseBlockBody`. It exists for
	// the drift guard `assertScanAligned`, which both `parseWhileStatement` and `parseIfStatement`
	// run to check the `end` the parser really closed the last body with against the one
	// `blockStatementEndIndex` predicted from the tokens. A nested block
	// finishes — and writes this — before its enclosing one does, so by the time an outer
	// `parseBlockBody` call returns it holds the OWN `end` of the construct's last body, which
	// is what the guard reads.
	var lastBlockBodyEnd as ElementIndex
	var constDependencyFailed as bool
	var constDependsOnARecord as bool

	// The token span of the most recently completed cast. It is never cleared: a record left by an
	// earlier expression cannot match, because `operandIsACast` asks for the operand's exact span.
	var lastCast as RecordedCast

	// ⭐ **THE NAME AN E3207 WOULD BLAME FOR THE BARE IDENTIFIER `parseVariableReference` LAST RESOLVED**,
	// `unblamed` when that binding may be written through. A scalar hand-off from the ONE resolution
	// that can answer it to the ONE consumer that needs it (`bareArgImmutableName`, at a call
	// argument), because a `ValueId` cannot carry the answer: `let a = p` binds `a` to the parameter
	// `p`'s own value, so the question is about the NAME and dies with the token unless it is
	// published here.
	//
	// ⚠ **ITS SCOPE IS EXACTLY ONE ARGUMENT.** `parseCallArgs` clears it before each argument and reads it
	// after, and only when the argument consumed exactly one identifier token — so a stale answer cannot
	// blame the wrong argument, and a primary path that publishes nothing answers "writable", which is the
	// safe direction (a missed diagnostic, never a refused program).
	var lastBareBindingImmutableName as immutable ByteArray

	// The try target of the most recently emitted witness dispatch, and in `lastAwait` of the most
	// recent await, keyed by op index. Whatever routes or rewrites the op later holds only its index,
	// while the method's name and throws clause, or the awaited promise's facts, are known only as the
	// op emits. Reading a record for any other op panics (`recordedTryTargetOf`): a door that emitted
	// without recording would otherwise mis-type an `(e)` binding silently.
	var lastWitnessDispatch as RecordedTryTarget

	// ⭐ The interface-typed slot the shared interface reader last saw — a requirement's PARAMETER or its
	// RETURN — held for the real parse to refuse. See `requireNoUnstorableRequirementType` for why the reader
	// may not throw. An empty name means none seen, which is a real absence rather than a sentinel: an
	// interface name is never empty. The POSITION rides too, so one record serves both halves and the message
	// still comes from the family door.
	var pendingRequirementParam as PendingUnstorableRequirement

	// See `lastWitnessDispatch`.
	var lastAwait as RecordedTryTarget

	// Set by `noteSpawnStartReply` as a `spawn`'s op is emitted, and read by `parseSpawn` right after
	// its factory call returns. A `spawn` inside the factory's arguments finishes before the outer op
	// is emitted, so the outer read sees its own spawn's record.
	var lastSpawnStart as SpawnStartReply
	var lastSend as RecordedSend
	var unsettledSend as UnsettledSend
	var sentLeg as SentLegSlot

	// ⭐ **THE LAST MEMBER DISPATCH — its member-name TOKEN and the receiver it was dispatched on** (E3087).
	// Two SCALAR fields, written in one place (`noteMemberDispatch`) and read in one (the
	// redundant-`contains`/`get` lint), following `lastFieldRead*` above in shape and for the same reason: a
	// field read allocates nothing, and the reader recognizes its own record by IDENTITY — the token index
	// must fall strictly inside the `if` condition being checked — so a stale entry cannot be mistaken for a
	// live one. A miss skips the lint; it can never name the wrong receiver. No validity flag is needed
	// because index 0 is a file's first token and can never be a member name inside an `if` condition.
	var lastDispatchedMemberIndex as ElementIndex
	var lastDispatchedReceiver as ValueId
	var constInitializerEnd as ElementIndex
	var initializerBinding as ByteArray
	var initializerClosureHost as immutable ByteArray
	var elementStoreDestination as ElementStoreDestination

	// A call argument at a by-reference position has asked for the STORAGE itself rather than its contents.
	// Set by `parseCallArgs` to the argument's chain ANCHOR — a bare name's own token, or the LAST
	// field token of `p.a.b` — through `cellArgumentAnchorAt`, and consumed by whichever read door lands on
	// that token (a cell local, a module slot, a self field, a field chain), which then hands back the
	// storage's ADDRESS and emits no load.
	//
	// ⚠ **IT IS KEYED ON THE TOKEN INDEX, AND A BARE BOOLEAN WOULD BE A WRONG ANSWER.** `f(x + 1)` at a
	// by-reference position parses `x` through the same read door, and a flag would hand the cell's address to
	// the `+`. The index says WHICH read may take it — the one standing on the anchor — and every other read
	// the argument contains sees a request that is not for it.
	var cellArgumentToken as CellArgumentToken
	var cellArgumentWantsAPlace as bool
	var argumentRoot as ArgumentRoot

	// Set by `parseCallArgs` under `ArgLabelRule.messageSend`; `emitServiceSend` takes it and resets it
	// on every exit, a refused argument list included, so no later send inherits a timeout.
	var pendingSendTimeout as SendTimeoutArgument
	var drainingLoops as ElementIndex
	var drainingLabel as immutable ByteArray
	var handedPlaceStorage as PlaceStorage

	// ⭐⭐ **A RECEIVING SLOT HAS STATED THE `Array` INSTANCE THE LITERAL AT THIS TOKEN MUST BE BUILT AT.**
	// Set by `parseCallArgs` for an argument whose first token is a `[`, and TAKEN by `parseArrayLiteral`.
	// Without it a literal's elements are typed by their own spelling, which makes `[1, 2, 3]` an
	// `Array with int` that no narrower element type accepts — while the same `1` adopts that element type at
	// a scalar parameter and at a `push`.
	//
	// ⚠ **IT IS KEYED ON THE TOKEN INDEX for `cellArgumentToken`'s reason**: a nested literal parses
	// through the same door (`total([f([1, 2]), 3])`), and a flag would let the inner one take a request made
	// for the outer. The index says WHICH literal may take it — the one opening on the slot's own first token.
	var arrayLiteralTargetTokenIndex as ElementIndex
	var arrayLiteralTarget as DeclaredArrayInstance
	var tupleLiteralTargetTokenIndex as ElementIndex
	var tupleLiteralTarget as DeclaredTupleTarget

	// ⭐ **THE PARAMETER TYPES THE CURRENT CALL ARGUMENT OFFERS A CLOSURE LITERAL** — see `ClosureParamOffer`.
	// Keyed on the argument's first token for `cellArgumentToken`'s reason: only a literal OPENING
	// there is the argument, so `f(g(function(x) gives x))` cannot hand `f`'s offer to the literal `g`
	// receives. `parseClosureExpression` takes it before its body parses, so it is not among that
	// function's saved per-function columns.
	var pendingClosureParamOffer as PendingClosureParamOffer

	function takeSentLeg() returns SentLegSlot
		let taken = self.sentLeg
		self.sentLeg = SentLegSlot.none
		return taken
	end 'takeSentLeg'

	function takeHandedPlaceStorage() returns PlaceStorage
		let handed = self.handedPlaceStorage
		self.handedPlaceStorage = noHandedPlaceStorage
		return handed
	end 'takeHandedPlaceStorage'

	static function quiescent() returns StatementSlots
		return Self{claimOpFloor: 0, qualifiedTypeBase: QualifiedTypeBase.none, handedResolution: NothingHanded, errorMatchRefusal: ErrorMatchRefusal.none, lastBlockBodyEnd: 0, constDependencyFailed: false, constDependsOnARecord: false, lastCast: RecordedCast.nothingRecorded, lastBareBindingImmutableName: EmptySourceText, lastWitnessDispatch: RecordedTryTarget.nothingRecorded, pendingRequirementParam: PendingUnstorableRequirement.none, lastAwait: RecordedTryTarget.nothingRecorded, lastSpawnStart: SpawnStartReply.noReply, lastSend: RecordedSend.nothingRecorded, unsettledSend: UnsettledSend.settled, sentLeg: SentLegSlot.none, lastDispatchedMemberIndex: 0, lastDispatchedReceiver: 0, constInitializerEnd: 0, initializerBinding: EmptySourceText.clone(), initializerClosureHost: EmptySourceText, elementStoreDestination: ElementStoreDestination.none, cellArgumentToken: CellArgumentToken.none, cellArgumentWantsAPlace: false, argumentRoot: ArgumentRoot.none, pendingSendTimeout: SendTimeoutArgument.absent, drainingLoops: 0, drainingLabel: EmptySourceText, handedPlaceStorage: noHandedPlaceStorage, arrayLiteralTargetTokenIndex: 0, arrayLiteralTarget: DeclaredArrayInstance.none, tupleLiteralTargetTokenIndex: 0, tupleLiteralTarget: NoDeclaredTupleTarget, pendingClosureParamOffer: PendingClosureParamOffer.none}
	end 'quiescent'
end 'StatementSlots'

type ParseRewindMark
	let pos as ElementIndex
	let openRegion as AbandonableRegion
	let blockStructureMisread as bool
	let libraryBlame as LibraryBlame
	let atFileScope as bool
	let artifact as ArtifactMark
	let band as ParseBandMark
	let memos as RewindMark
	let heldAwaits as ElementIndex
	let openByRefHandOffs as ElementIndex
	let closureEnclosingFrames as ElementIndex
	let covMatchLines as ElementIndex
	let covMatchCols as ElementIndex
	let constEvalStack as ElementIndex
	let mintedTests as ElementIndex
	let pendingDefaultHelpers as ElementIndex
	let pendingBareAliases as ElementIndex
	let deferredPatternBindings as ElementIndex
	let declaredTypeAliases as ElementIndex
	let readsALaterConformer as bool

	static function create(pos ElementIndex, openRegion AbandonableRegion, blockStructureMisread bool, libraryBlame LibraryBlame, atFileScope bool, artifact ArtifactMark, band ParseBandMark, memos RewindMark, heldAwaits ElementIndex, openByRefHandOffs ElementIndex, closureEnclosingFrames ElementIndex, covMatchLines ElementIndex, covMatchCols ElementIndex, constEvalStack ElementIndex, mintedTests ElementIndex, pendingDefaultHelpers ElementIndex, pendingBareAliases ElementIndex, deferredPatternBindings ElementIndex, declaredTypeAliases ElementIndex, readsALaterConformer bool) returns ParseRewindMark
		return Self{pos: pos, openRegion: openRegion, blockStructureMisread: blockStructureMisread, libraryBlame: libraryBlame, atFileScope: atFileScope, artifact: artifact, band: band, memos: memos, heldAwaits: heldAwaits, openByRefHandOffs: openByRefHandOffs, closureEnclosingFrames: closureEnclosingFrames, covMatchLines: covMatchLines, covMatchCols: covMatchCols, constEvalStack: constEvalStack, mintedTests: mintedTests, pendingDefaultHelpers: pendingDefaultHelpers, pendingBareAliases: pendingBareAliases, deferredPatternBindings: deferredPatternBindings, declaredTypeAliases: declaredTypeAliases, readsALaterConformer: readsALaterConformer}
	end 'create'
end 'ParseRewindMark'

function declarationPartWhenRefusedAfter(key PositionKey, refusal PositionKey) returns RefusedPart throws AbsentError
	if refusal < key 'beforeItsStart'
		throw AbsentError.absent
	end 'beforeItsStart'

	return RefusedPart.create(key, poisoned: PoisonedAt.line(positionKeyLine(key)))
end 'declarationPartWhenRefusedAfter'

function bindingPartWhenRefusedWithin(key PositionKey, extentEnd PositionKey, refusal PositionKey) returns RefusedPart throws AbsentError
	if refusal > extentEnd 'pastItsExtent'
		throw AbsentError.absent
	end 'pastItsExtent'

	return RefusedPart.create(key, poisoned: PoisonedAt.line(positionKeyLine(refusal)))
end 'bindingPartWhenRefusedWithin'

union OpenedBlockLabel
	claimed(label immutable ByteArray, key immutable ByteArray, at ElementIndex)

	// A label that reuses an enclosing one, or one whose position is not tracked. It owns no key in
	// `OpenLabels.positions`, so closing it must not release the enclosing block's key.
	unclaimed(label immutable ByteArray)
	unread

	function expectedAt(closing immutable ByteArray) returns immutable ByteArray
		return match self 'opened'
			claimed(label, _, _) gives label
			unclaimed(label) gives label
			unread gives closing
		end 'opened'
	end 'expectedAt'
end 'OpenedBlockLabel'

typealias OpenedBlockLabelArray = Array with OpenedBlockLabel
typealias OpenLabelPositions = Map with ByteArray, ElementIndex

union LabelReuse
	reused(label immutable ByteArray, outerAt ElementIndex, innerAt ElementIndex)
end 'LabelReuse'

typealias LabelReuseArray = Array with LabelReuse

function reusedBlockLabelMessage(label String, outer Token) returns String
	return "Block label '{label}' is already the label of an enclosing block or declaration (line {outer.line}, column {outer.column}); an `end '{label}'` could close either, so rename the inner block's label"
end 'reusedBlockLabelMessage'

// The open blocks, innermost last, and which label key each claimed block holds. Every reuse is
// recorded and the walk continues, so one pass reports them all.
type OpenLabels
	var stack as OpenedBlockLabelArray
	var positions as OpenLabelPositions
	var reuses as LabelReuseArray

	static function create() returns Self
		return Self{stack: OpenedBlockLabelArray.create(0), positions: OpenLabelPositions.create(), reuses: LabelReuseArray.create(0)}
	end 'create'

	function open(entry OpenedBlockLabel)
		match entry 'claim'
			claimed(label, key, at) then self.stack.push(self.claim(label, key: key, at: at))
			unclaimed or
			unread then self.stack.push(entry)
		end 'claim'
	end 'open'

	function claim(label immutable ByteArray, key immutable ByteArray, at ElementIndex) returns OpenedBlockLabel
		if self.positions.contains(key) 'taken'
			let outerAt = try self.positions.get(key) otherwise panic("OpenLabels.claim: a key the map contains has a position")
			self.reuses.push(LabelReuse.reused(label, outerAt: outerAt, innerAt: at))
			return OpenedBlockLabel.unclaimed(label)
		end 'taken'

		self.positions.upsert(key, value: at)
		return OpenedBlockLabel.claimed(label, key: key, at: at)
	end 'claim'

	function close() returns OpenedBlockLabel
		let innermost = try self.stack.pop() otherwise panic("OpenLabels.close: the walk returns when the outermost block closes, so a closer always has an opener to pop")

		match innermost 'released'
			claimed(_, key, _) then _ = self.positions.remove(key)
			unclaimed or
			unread then break
		end 'released'

		return innermost
	end 'close'

	function isEmpty() returns bool
		return self.stack.isEmpty()
	end 'isEmpty'

	function foundReuses() returns LabelReuseArray
		return self.reuses
	end 'foundReuses'
end 'OpenLabels'

union BlockCloserScan
	closed(reuses LabelReuseArray)
	misclosed(expected immutable ByteArray, closer ElementIndex)
	unterminated
end 'BlockCloserScan'

// `word`'s `tag` is the stored tag of the one case the arm covers: the payload is `word - tag`, which is
// the pointer only for a word holding that case (an arm that binds a payload covers exactly one, E3129).
union PayloadSource
	word(tag FullRangeInt)
	slot(offset ByteOffset, storage MaxonType)

	function slotOffset() returns ByteOffset
		return match self 'source'
			word panic("PayloadSource.slotOffset: a word payload has no slot — only an existential reads a witness half, and no existential payload is unboxed")
			slot(offset, _) gives offset
		end 'source'
	end 'slotOffset'
end 'PayloadSource'

union PayloadHolder
	record(box ValueId)
	word
end 'PayloadHolder'

type FieldRead
	export let value as ValueId
	export let typeIsUnknown as bool

	static function create(value ValueId, typeIsUnknown bool) returns FieldRead
		return Self{value: value, typeIsUnknown: typeIsUnknown}
	end 'create'
end 'FieldRead'

union LastFieldRead
	none
	read(value ValueId, box ValueId, offset ByteOffset)

	function isReadOf(value ValueId) returns bool
		return match self 'fieldRead'
			none gives false
			read(readValue, _, _) gives readValue == value
		end 'fieldRead'
	end 'isReadOf'

	function readBox() returns ValueId
		match self 'fieldRead'
			none then panic("LastFieldRead.readBox: asked only once `isReadOf` has matched a recorded read")
			read(_, box, _) then return box
		end 'fieldRead'
	end 'readBox'
end 'LastFieldRead'

union LastRuntimeRead
	none
	read(result ValueId, typeName immutable ByteArray, methodName immutable ByteArray)
end 'LastRuntimeRead'

type CaughtErrorBinder
	export let binding as CaughtErrorBinding

	// What a diagnostic and an emitted drop are attributed to: the binding NAME when one is written, else
	// whatever the caller decided stands for the handler (its `if`, its `panic`/`throws` keyword).
	export let anchor as Token

	static function named(name ByteArray, anchor Token) returns CaughtErrorBinder
		return Self{binding: CaughtErrorBinding.named(name), anchor: anchor}
	end 'named'

	static function anonymous(anchor Token) returns CaughtErrorBinder
		return Self{binding: CaughtErrorBinding.anonymous, anchor: anchor}
	end 'anonymous'

	function isNamed() returns bool
		return match self.binding 'binding'
			anonymous gives false
			named gives true
		end 'binding'
	end 'isNamed'

	function boundName() returns immutable ByteArray throws AbsentError
		match self.binding 'binding'
			anonymous then throw AbsentError.absent
			named(name) then return name
		end 'binding'
	end 'boundName'
end 'CaughtErrorBinder'

// ⭐ **WHICH OF THE THREE `otherwise` FORMS FOLLOWS A BLOCK-FORM `try`**, decided once by
// `requireTryBlockOtherwise` and consumed once by `parseTryBlockHandler` — so the peek that ADMITS a handler
// and the fork that PARSES it are one reading of the grammar rather than two that could disagree about which
// form was written.
//
// The two TERMINAL forms collapse to one shape because everything past the fork is common to them: the
// optional binding, its declaration, its drop, and its diverging tail. Only the last token differs, and that
// is `parseDivergingTerminalForm`, which every position admitting `divergentHandlerOpensAt`'s keyword pair
// shares — that function's header names them, so this does not carry a second copy of the list.
union TryBlockHandlerShape
	blockHandler
	divergent
end 'TryBlockHandlerShape'

// ⛔⛔ **DOES THIS TOKEN OPEN A DIVERGING TERMINAL FORM?** — `panic("…")` and `throws E.case`, the pair, in
// ONE place. FOUR readers, and the third is why this exists rather than an `at()` chain at each: a
// block-form `try`'s divergent `otherwise` admits the pair at both positions its optional binding can leave
// the cursor in (`requireTryBlockOtherwise`), a match arm's `default` admits exactly the same pair
// (`parseMatchCommon`), and a match EXPRESSION arm admits it where its `gives` would go (`parseArmBody` —
// `specs/match-expr-arm-divergent.md`). All four then parse it through the one
// `parseDivergingTerminalForm`.
//
// ⚠ **THE MATCH-`default` READER IS THE ONE THIS WAS MISSING**, and the review found it: the keywords were
// spelled in three places, of which only two were coupled, so a third diverging form added to `default`
// would have left the `otherwise` copy silently unable to spell it.
//
// ⚠ **THE BLOCK-EXTENT SCAN NEEDS NO SHARE OF THIS, AND THAT IS A PROPERTY RATHER THAN AN OVERSIGHT.**
// `otherwiseOpensBlockIn` is a POSITIVE test for the handler's block LABEL — a `charLiteral`, either straight
// after `otherwise` or after `( <name> )` — so every terminal form is excluded by construction, whatever
// keyword opens it. A roster shared with the scan would be the weaker arrangement: it would have to be
// extended for a third terminal form, where the label test simply keeps answering. That matters here because
// a spelling the grammar takes as terminal while the scan counts it as a block opener runs the enclosing
// construct's extent past its real `end` — `assertScanAligned`'s panic on a correct program, which this file
// records twice already for `otherwise` alone.
function divergentHandlerOpensAt(kind TokenKind) returns bool
	return kind == TokenKind.panic or kind == TokenKind.throws
end 'divergentHandlerOpensAt'

// ⭐⭐ **`terminator` IS A STATEMENT FORM THAT LEAVES ITS BLOCK UNCONDITIONALLY** — the E3071 roster,
// written once. `return`/`throw`/`panic` leave the FUNCTION; `break`/`continue` leave the enclosing loop or
// match. All five end the straight-line block they sit in, so whatever is written after one of them before
// the block's `end` is unreachable and `parseStatements` refuses it.
//
// ⚠ **`break`/`continue` ARE IN THE ROSTER, and `specs/break.md` pins the two loop keywords as
// `maxoncstderr` cases.** The question is not stylistic: a `break` followed by an `if` in the same block
// runs the loop to completion, the `if` having overwritten the `break`'s branch in `IrBlock.terminator`.
// See `SourceParseError.unreachableCode`.
//
// ⚠ **`throws` IS DELIBERATELY ABSENT, and it is not the same word as `throw`.** It opens a DIVERGING
// TERMINAL FORM in a match arm or a block-`try` handler (`divergentHandlerOpensAt` above), never a
// statement in a statement list, so a statement list can never be positioned on one.
//
// ⚠⚠ **THIS IS THE E3071 ROSTER, NOT THE ROSTER OF EVERYTHING THAT TERMINATES A BLOCK, AND THE TWO ARE
// DIFFERENT LISTS.** A bare-call statement to a function that never returns also ends its block
// (`terminateAfterDivergingCall`), and it is NOT admitted here — deliberately. This roster is read
// off the form `statementFormAt` classifies before that statement is parsed, and whether a call
// comes back is a whole-program fact about its callee, not a property of the form. So the tail
// under such a call is parsed into a `dead` block instead of refused, exactly as the tail under an
// `if`/`else` whose branches all `return` already is: neither opens with one of these five
// keywords, and neither is E3071's to report.
//
// `tryStmt` is `plain` although its block form opens a block: the form covers both spellings, and
// `parseTry` refuses the block one in a match arm (E2049) itself.
function statementFormRole(form StatementForm) returns StatementRole
	return match form 'form'
		ret or
		breakStmt or
		continueStmt or
		throwStmt or
		panicStmt gives StatementRole.terminator
		ifStmt or
		whileStmt or
		forStmt or
		modifyStmt or
		acquireStmt or
		matchStmt gives StatementRole.blockOpener
		strayStatementToken gives StatementRole.refusedOnSight
		bindingDecl or
		annotatedDecl or
		tryStmt or
		awaitStmt or
		destructStmt or
		tupleAssign or
		assign or
		selfFieldAssign or
		staticMemberAssign or
		refusedStaticStore or
		fieldAssign or
		methodCallStmt or
		fieldChainMethodStmt or
		staticMemberCallStmt or
		qualifiedStaticCallStmt or
		namespaceQualifiedCallStmt or
		valueHeadedCallStmt or
		parenthesizedCallStmt or
		spawnStmt or
		callStmt or
		memberExprStmt gives StatementRole.plain
	end 'form'
end 'statementFormRole'

enum StatementRole
	terminator
	blockOpener
	refusedOnSight
	plain
end 'StatementRole'

// The straight-line terminator the PREVIOUS statement was, when it was one — the whole of what
// `parseStatements` has to remember between iterations to answer E3071.
//
// `keyword` carries the terminator token's own SOURCE BYTES rather than a spelling chosen here, so the
// message quotes exactly the word the author wrote and there is no second roster to hold in step with
// `statementFormRole`. Keywords are lexed as words and keep their span (see `Token.value`), so
// those bytes are a zero-copy slice of the source buffer this parse already holds.
union PrecedingTerminator
	none
	keyword(name immutable ByteArray)
end 'PrecedingTerminator'

enum StatementForm
	ret
	bindingDecl
	annotatedDecl
	ifStmt
	whileStmt
	forStmt
	modifyStmt
	acquireStmt
	matchStmt
	breakStmt
	continueStmt
	throwStmt
	tryStmt
	panicStmt
	awaitStmt
	destructStmt
	tupleAssign
	assign
	selfFieldAssign
	staticMemberAssign
	refusedStaticStore
	fieldAssign
	methodCallStmt
	fieldChainMethodStmt
	staticMemberCallStmt
	qualifiedStaticCallStmt
	namespaceQualifiedCallStmt
	valueHeadedCallStmt
	parenthesizedCallStmt
	spawnStmt
	callStmt
	memberExprStmt
	strayStatementToken
end 'StatementForm'

function lineSharedRefusal(construct LineEndingConstruct, got Token) returns SourceParseError
	return SourceParseError.expectedNewlineAfter(construct, got: tokenDisplayText(got), line: got.line, column: got.column)
end 'lineSharedRefusal'

type StatementHead
	export let opening as Token
	export let chain as ChainResolution
	export let form as StatementForm

	static function create(opening Token, chain ChainResolution, form StatementForm) returns StatementHead
		return Self{opening: opening, chain: chain, form: form}
	end 'create'
end 'StatementHead'

// ⭐ **WHICH FORM OF CATCH IS BEING PARSED — the one thing the declaration door cannot see for itself.** A
// SINGLE-CALL form (`try f() otherwise (e) …`, `if try f() … else (e) …`) catches ONE call's error, so the
// binding is that callee's declared enum and can never be a union. A BLOCK form's handler is shared by every
// routed edge, so when the body routed two or more error types the binding is the synthesized union instead.
// That is the whole of what this carries.
//
// ⚠ **IT DOES NOT SAY WHETHER E3084 APPLIES, and a case that claimed to was deleted by review.** The
// obligation is armed by `parseOtherwiseBlock` alone — it sets `tryBindingName`/`tryBindingMatched` around
// its own body and checks them at its end — so a handler that never calls it never owes it. A divergent
// handler is exactly that, and says so at `parseDivergentOtherwise`, where the exemption actually happens.
union CaughtErrorForm
	singleCall
	blockForm(errorUnion ErrorUnionMatch)
end 'CaughtErrorForm'

// The synthesized error union this catch binds — `notAUnion` for a single-call form, which catches one
// callee's declared enum and can never be a union, and for a block form whose body routed one error type.
//
// ⚠ **BOTH OF A BLOCK FORM'S HANDLERS ANSWER THROUGH THIS ONE CASE, and a THIRD case for the divergent one
// was DELETED BY REVIEW.** It carried the same payload and every live consumer gave it the same answer, so
// it was two redundant arms wearing a distinction — and the ⚠ it hung on `tryBlockBindingToMatch` described
// a call that cannot happen (a divergent handler never reaches `parseOtherwiseBlock`, which is that
// routine's only caller). The E3084 exemption is real; it is stated at `parseDivergentOtherwise`, where it
// actually occurs.
function caughtErrorUnionMatch(form CaughtErrorForm) returns ErrorUnionMatch
	return match form 'f'
		singleCall gives ErrorUnionMatch.notAUnion
		blockForm(errorUnion) gives errorUnion
	end 'f'
end 'caughtErrorUnionMatch'

// The binding name this handler must be seen to `match` on (E3084), or `none` when it owes no such
// proof: a single-call handler, or a block-form one that declares no binding at all — though
// `requireTryBlockOtherwise` has already refused the latter, so the test here is the rule stated
// rather than a case that arrives.
union TryBinding
	none
	required(name immutable ByteArray)

	function requires(name ByteArray) returns bool
		return match self 'binding'
			none gives false
			required(requiredName) gives requiredName.equals(name)
		end 'binding'
	end 'requires'

	function requiredName() returns immutable ByteArray throws AbsentError
		match self 'binding'
			none then throw AbsentError.absent
			required(name) then return name
		end 'binding'
	end 'requiredName'
end 'TryBinding'

function tryBlockBindingToMatch(form CaughtErrorForm, binder CaughtErrorBinder) returns TryBinding
	let bindingName = try binder.boundName() otherwise return TryBinding.none

	return match form 'f'
		singleCall gives TryBinding.none
		blockForm gives TryBinding.required(bindingName)
	end 'f'
end 'tryBlockBindingToMatch'

// The name of the internal binding a `for … in` over an OWNED array TEMPORARY moves that temporary
// into (`parseForStatement`). It is never installed in a `Scope`, so no source line can name it; the
// `__` prefix is what says so anyway, since `requireUnreservedName` bars every declaration from that
// space. It exists only so `emitScopeRelease` — which drops BINDINGS — reaches the record.
let IterationSourceBindingName = b"__for_source"

// The name of the internal PER-TRIP binding a cursor loop's `current()` result is re-scoped into
// (`parseForStatement`'s cursor arm) when that result is an owned temporary. Same reasoning as the source
// binding one line up — never in a `Scope`, `__`-prefixed so no declaration could collide, and existing only
// so that the four exits `scopeReleasesAbove` serves reach the record exactly once each.
let IterationElementBindingName = b"__for_element"

// The same kind of unnameable internal binding, for the temporary a BORROW was taken out of — an
// element read off a container (`emitContainerElementAccessor`) or a managed field read off a box
// (`keepFieldSourceAliveForItsRead`). Both go through `giveTemporaryScopeLifetime`, so the two share
// one name for one reason: the record is held to the scope's exit because something still points
// INTO it.
let BorrowSourceBindingName = b"__borrow_source"

// The temporary `match` scrutinee's binding name, so a dump of `ownedBindings` says why that nameless entry
// is there. Inert: it is never installed in a `Scope` and nothing reads it to decide anything.
let ScrutineeSourceBindingName = b"__match_scrutinee"

// The tail of every panic about the sole-ownership column being unindexable, so the invariant it names — the
// two owned-heap columns are pushed together by `mintValue`/`recordValueType` — is written once and the three
// askers cannot come to describe it differently. The ASKER's own name still leads each message, because that
// is the half saying WHICH read failed.
let SoleOwnershipSlotPanicTail = " has no sole-ownership slot — the two owned-heap columns are pushed in lockstep by mintValue"

// The value a match arm produces, if any: `none` for a `then` (statement) arm, `value` for a
// `gives` (expression) arm. A union rather than a `ValueId` plus a bool — for the reason
// `ReceiverArg` is one: a `ValueId` has no empty value, and a sentinel would be READ downstream
// as a real operand.
union MatchGiveValue
	none
	value(id ValueId)
end 'MatchGiveValue'

// The one piece of bookkeeping a single enum/union declaration's case loop threads across its cases
// and does NOT keep: the auto-increment TAG counter.
//
// A `type` (one heap object per declaration, on the cold declaration path) rather than an out-param,
// which Maxon has no clean spelling for: the counter must PERSIST across cases (a bare `b` after
// `a = 5` must read `6`), so a caller that read it back by value would lose the update.
//
// ⚠ **THE BACKING DOES NOT LIVE HERE.** This record is built by
// `parseEnumDeclaration` and DISCARDED when the declaration closes, so a fact stored here is a fact no
// later reader can ask for — and every consumer of an enum VALUE needs to know whether its i64 is a
// number or an f64's bits. The backing therefore lives on `EnumLayout`, which survives; the counter
// stays here, because the next tag is genuinely about the parse and not about the enum.
type EnumCaseLedger
	// The tag the NEXT bare (or first) case takes. Starts at 0; an explicit `= N` resets it to N+1,
	// which is what gives `enum E { a = 5  b }` the tag 6.
	export var nextTag as FullRangeInt
	var names as ClaimedCaseNames
	var tags as ClaimedRawTags
	var texts as ClaimedRawTexts

	static function create() returns EnumCaseLedger
		return Self{nextTag: 0, names: ClaimedCaseNames.create(), tags: ClaimedRawTags.create(), texts: ClaimedRawTexts.create()}
	end 'create'

	function nameIsClaimed(name ByteArray) returns bool
		return self.names.contains(name)
	end 'nameIsClaimed'

	function rawValueIsClaimed(layout EnumLayout, tag FullRangeInt, rawValue String) returns bool
		if self.names.count() == 0 'nothingClaimedYet'
			return false
		end 'nothingClaimedYet'

		return match layout.rawValueIdentity() 'identity'
			theTag gives self.tags.contains(tag)
			recordedText gives self.texts.contains(rawValue)
			incomparable gives false
		end 'identity'
	end 'rawValueIsClaimed'

	function claim(layout EnumLayout, name ByteArray, tag FullRangeInt, rawValue String)
		self.names.insert(name)

		match layout.rawValueIdentity() 'identity'
			theTag then self.tags.insert(tag)
			recordedText then self.texts.insert(rawValue)
			incomparable then return
		end 'identity'
	end 'claim'
end 'EnumCaseLedger'

typealias ClaimedCaseNames = Set with ByteArray
typealias ClaimedRawTags = Set with FullRangeInt
typealias ClaimedRawTexts = Set with String

// Is `kind` a LITERAL token — an int/float/string/char/byte-string literal? Used to tell a keyword
// used as a case NAME (`keyword-as-case-name.md`: `function`, `end`, ...) from a literal, which the
// lexer emits as its own kind carrying its text. THE one list, so the case-name reader and any
// later reader cannot drift on what counts as a literal.
function tokenIsLiteralKind(kind TokenKind) returns bool
	return kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.charLiteral or kind == TokenKind.byteStringLiteral
end 'tokenIsLiteralKind'

// Does `kind` spell an enum/union case's raw value DIRECTLY — a string or a character literal? THE one
// list, because three doors must agree on it: the case-NAME reader (which admits such a literal where a
// name goes), the implicit-backing arm that recognizes it there, and the explicit `= <literal>` arm. Taught
// to two of the three, a spelling would be accepted as a name and then read as a malformed raw value.
function tokenKindIsEnumLiteralBacking(kind TokenKind) returns bool
	return kind == TokenKind.stringLiteral or kind == TokenKind.charLiteral
end 'tokenKindIsEnumLiteralBacking'

// ⭐ **THE TOKEN KINDS MAXON'S BLOCK STRUCTURE IS SPELLED WITH** — exactly the kinds
// `opensBlockAt`/`closesBlockAt` can ever answer `true` for.
//
// ⚠ **IT IS LOAD-BEARING, NOT DOCUMENTATION, AND IT IS GUARDED IN BOTH DIRECTIONS**: `opensBlockAt`
// early-returns on it, so a construct added to that chain WITHOUT being added here never opens a block at
// all — a loud drift-guard panic on the first program that nests it, rather than a silent divergence between
// two spellings of one list. And a kind added HERE without an arm in that chain now hits `opensBlockAt`'s own
// tail panic, so neither half can be extended alone. Its third reader is `parenGroupCanBeAParameterList`,
// which needs the same set to tell a parameter list from an arbitrary parenthesized expression, and
// its fourth is `Lexer.opensAKeptBlock`, whose own tail panic guards the same direction.
function kindSpellsBlockStructure(kind TokenKind) returns bool
	return kind == TokenKind.while or kind == TokenKind.match or kind == TokenKind.for or kind == TokenKind.modify or kind == TokenKind.acquire or kind == TokenKind.if or kind == TokenKind.else or kind == TokenKind.otherwise or kind == TokenKind.end or kind == TokenKind.try
end 'kindSpellsBlockStructure'

// ⭐ **THE KINDS THE BLOCK-EXTENT WALK OFFERS TO `keywordIsANameAt`** — block structure, PLUS `function`,
// whose name-ness `functionDeclarationAt` reads to tell a declaration from a keyword-named enum case used as
// a match-arm pattern (`function gives (1 + 1)` spells `function` · <name> · `(` character for character).
// It is wider than `kindSpellsBlockStructure` because a `function` keyword opens no block `opensBlockAt`
// counts — it is not block structure, it merely needs the same left context to be read correctly.
//
// ⚠ **GUARDED IN BOTH DIRECTIONS, like the set it wraps**: `recordBlockKeywordName` offers exactly this set
// to the walk's verdict, and `keywordIsAName` PANICS when asked about a kind outside it, so a reader added
// without a producer gets a loud answer rather than a silent `false` off a memo that can hold no entry.
function kindAsksKeywordIsAName(kind TokenKind) returns bool
	return kindSpellsBlockStructure(kind) or kind == TokenKind.function
end 'kindAsksKeywordIsAName'

// ⭐⭐ **WHAT THE INNERMOST OPEN BLOCK MAKES OF A KEYWORD STANDING AT ITS LEVEL** — the left context
// `keywordIsANameAt`'s position-sensitive shapes are rules about, and which no bounded lookaround can see.
// Only the block-extent walk knows it, from its own opener stack.
enum NameContext
	// A `match` BODY's own level, the only place an arm spells its case name.
	matchBody

	// An `enum`/`union` BODY's own level, where every member but a method declaration is case material.
	caseList

	// Anywhere else, where only the position-independent shapes hold.
	statementLevel
end 'NameContext'

// ⭐ **CAN `tok` SERVE AS A NAME — in any position where a name is the ONLY thing that may stand?** An
// identifier, or a KEYWORD spelled there. A keyword carries its source spelling in `.value` (the lexer
// emits it through the same path an identifier takes), and the signal that a token is word-shaped rather
// than punctuation is exactly that it carries text: a punctuator, `newline` and EOF all carry the shared
// EMPTY slice (see Token.value), while a literal carries text but is ruled out by its KIND. So a name is
// an identifier, or any non-literal token that carries a spelling.
//
// **THREE POSITIONS ASK IT, AND THEY ARE ONE QUESTION** — which is why it is one predicate rather than a
// per-position list of admitted keywords:
//
//   • an enum/union CASE name — `enum TokenType { function return end if … }` (`keyword-as-case-name.md`);
//   • a DECLARED name — a function's own name and a parameter's name (`keyword-as-a-declared-name.md`):
//     `export static function from (path String)` is `stdlib/FilePath.maxon`'s `FilePath.from`, and
//     it is the only keyword any `stdlib/` file declares as a function name;
//   • a MEMBER name after a `.` — `Box.from(7)`, `p.to()` (`memberNameTokenAt`).
//
// ⚠ **IT IS THE POSITION THAT LICENSES THIS, NOT THE KEYWORD**, so it takes nothing away from the
// keyword: `from` still opens a `Set from […]`, `while`/`for`/`match` still open blocks, `type` still
// declares a type. An allowlist of "harmless" keywords would be the same fact written down twice — once
// here and once in whichever grammar rule the keyword really belongs to — and would silently refuse the
// next keyword a corpus file declares.
//
// The whole-program `spawn` discovery walk
// (`Queries.serviceSpawnFollowing`) asks the identical question of a raw `TokenArray` with no `Parser`
// in scope, and a second spelling of "may this token be a name" would let that walk and
// `Parser.atSpawnPrefix` accept different programs — companions minted for a spawn the parser refuses, or a
// spawn the parser claims that nothing minted companions for.
function tokenCanBeAName(tok Token) returns bool
	if tok.kind == TokenKind.identifier 'plainIdentifier'
		return true
	end 'plainIdentifier'

	// ⛔⛔ **LAYOUT IS NEVER A NAME, AND `docComment` IS WHY THIS ARM HAS TO EXIST.** The empty-value test
	// below carries `newline` out but not a doc comment: a doc comment is not an identifier,
	// is not a literal, and CARRIES ITS PROSE — so it passes all three tests below, and `consumeNameToken`
	// would take the body of a comment as a declared name, a parameter, a callee, a method or an argument
	// label, with `tokenDisplayText` then quoting that prose inside the E2010 for whatever followed. Asked
	// through `tokenKindIsSkippedLayout` rather than named here, so the door the cursor SKIPS a token at
	// and the door that refuses it as a NAME cannot come apart.
	if tokenKindIsSkippedLayout(tok.kind) 'layout'
		return false
	end 'layout'

	if tok.value.isEmpty() 'punctuationOrEof'
		return false
	end 'punctuationOrEof'

	return not tokenIsLiteralKind(tok.kind)
end 'tokenCanBeAName'

function tokenIsTheSelfType(tok Token) returns bool
	return tok.kind == TokenKind.selfType
end 'tokenIsTheSelfType'

// ⭐⭐ **DOES A `test` DECLARATION OPEN AT `index`?** The word `test` is the declaration opener iff the
// very next token is the quoted prose NAME. See `TestKeywordName` for the measurement that forbids a `KeywordTable` row.
//
// ⚠ **IT DOES NOT ASK WHETHER `index` IS A DECLARATION POSITION — ITS CALLERS ESTABLISH THAT, AND BOTH
// MUST.** `dispatchTopLevel` is a declaration position by construction; the tolerant SWEEP asks only at
// block depth 0, exactly as it does for `let`/`var`/`type`/`enum`. Asked anywhere else it would claim
// `match test 'check'` — the identical two tokens — which is the shape
// `test-declaration/test-stays-an-ordinary-identifier` pins.
//
// ONE predicate for both walks, for `atTopLevelBindingKeyword`'s reason: a shape taught to the real parse
// and not to the sweep would leave the sweep counting a block the real parse opened, and every depth-0
// gate below it would stop firing.
//
// ⚠ A free function over a bare `TokenArray` rather than a method, because `maxon fmt` asks the same
// question with no `Parser` in scope, and a second spelling of "this line declares a test" would have
// the formatter re-lay-out a construct the parser reads as something else.
function testDeclarationAt(tokens TokenArray, index ElementIndex) returns bool
	let word = try tokens.get(index) otherwise return false

	if word.kind != TokenKind.identifier or not word.value.equals(TestKeywordName) 'notTheWord'
		return false
	end 'notTheWord'

	let proseName = try tokens.get(index + 1) otherwise return false
	return proseName.kind == TokenKind.charLiteral
end 'testDeclarationAt'

// `if range.end 'x'` ends its condition with a member named `end` and then opens the `if`'s label, so an
// `end` behind a `.` closes nothing.
function labelledBlockCloserAt(tokens TokenArray, index ElementIndex) returns bool
	return tokenKindAt(tokens, index: index) == TokenKind.end and tokenKindAt(tokens, index: index + 1) == TokenKind.charLiteral and not tokenFollowsAMemberDot(tokens, index: index)
end 'labelledBlockCloserAt'

// The SHAPE half on its own — a pure bounded lookaround. It is a routine of its own because the
// block-extent walk asks it while deciding THIS token's name verdict, and so cannot read the memo that
// verdict goes into.
//
// ⭐ The NAME slot asks `tokenCanBeAName` rather than `kindAt(index + 1) == identifier`: a keyword is a
// legal declared name, and a `function while(…)` this did not recognize would leave the sweep's
// `depth` one too deep for the rest of the file. A closure literal is excluded by construction — its
// `(` sits where the name would, and a punctuator carries no spelling.
function functionDeclarationShapeIn(tokens TokenArray, index ElementIndex) returns bool
	return functionHeadIn(tokens, index: index) and (try tokens.get(index + 2) otherwise return false).kind == TokenKind.leftParen
end 'functionDeclarationShapeIn'

function functionHeadIn(tokens TokenArray, index ElementIndex) returns bool
	if (try tokens.get(index) otherwise return false).kind != TokenKind.function or not declarationBeginsStatementIn(tokens, index: index) 'notAFunctionKeywordOpeningAStatement'
		return false
	end 'notAFunctionKeywordOpeningAStatement'

	return tokenCanBeAName(try tokens.get(index + 1) otherwise return false)
end 'functionHeadIn'

function functionDeclaresTypeParamsIn(tokens TokenArray, groups ParenGroups, nameIndex ElementIndex) returns bool
	let open = nameIndex + 1

	if tokenKindAt(tokens, index: open) != TokenKind.leftParen 'noParameterList'
		return false
	end 'noParameterList'

	let close = groups.closeOf(tokens, open: open)
	return tokenKindAt(tokens, index: close) == TokenKind.rightParen and tokenKindAt(tokens, index: close + 1) == TokenKind.uses
end 'functionDeclaresTypeParamsIn'

function tokensDeclareGenericFunctionTemplate(tokens TokenArray) returns bool
	let groups = ParenGroups.create()

	for position in 0 upto tokens.count() 'eachToken'
		if functionDeclarationShapeIn(tokens, index: position) and functionDeclaresTypeParamsIn(tokens, groups: groups, nameIndex: position + 1) 'aTemplate'
			return true
		end 'aTemplate'
	end 'eachToken'

	return false
end 'tokensDeclareGenericFunctionTemplate'

// ⭐⭐ **DOES A DECLARATION BEGIN AT `index` — is that token the FIRST of its statement, past the
// modifiers a declaration may carry?** Maxon separates statements with newlines, so a declaration's
// keyword either opens the file or follows a `newline`; a keyword standing anywhere else in a line is
// part of an EXPRESSION, whatever three-token shape it happens to spell.
//
// It is `ifBeginsStatementIn`'s rule one construct over, read the same way and for the same reason: both
// tell a token that OPENS something from the identically-spelled token that does not, and neither can
// be answered by looking forward. They differ only in what may precede — an `if` admits an `else` (the
// `else if` chain), a declaration admits its modifiers.
//
// ⚠ It is a bounded LOOKBEHIND and must stay one. The block-extent walk asks it AT THE CURSOR while
// deciding that token's name verdict, so a term reading anything ahead of the cursor would read an
// index that walk has not built yet.
function declarationBeginsStatementIn(tokens TokenArray, index ElementIndex) returns bool
	var start = index

	while start > 0 and declarationModifierIn(tokens, index: start - 1) 'pastModifiers'
		start = start - 1
	end 'pastModifiers'

	if start == 0 'atFileStart'
		return true
	end 'atFileStart'

	return (try tokens.get(start - 1) otherwise panic("declarationBeginsStatementIn: tokens.get OOB at {start - 1}, below an index the walk read")).kind == TokenKind.newline
end 'declarationBeginsStatementIn'

// A modifier that may stand between a statement's start and the keyword opening its declaration: a
// visibility tier, or the `static` a type member spells (`export static function create`). The tier half
// asks `visibilityModifierIn` rather than respelling `export`/`public`, for that predicate's
// own stated reason — a third tier taught to one reader and not another would put two readers of one
// grammar a token apart.
function declarationModifierIn(tokens TokenArray, index ElementIndex) returns bool
	return pastDeclarationModifiers(tokens, index: index) > index
end 'declarationModifierIn'

function pastDeclarationModifiers(tokens TokenArray, index ElementIndex) returns ElementIndex
	let keyword = pastVisibilityModifiers(tokens, index: index)

	if tokenKindAt(tokens, index: keyword) == TokenKind.static 'aStaticMember'
		return keyword + 1
	end 'aStaticMember'

	return keyword
end 'pastDeclarationModifiers'

function staticModifierEndsAt(tokens TokenArray, index ElementIndex) returns bool
	return index > 0 and tokenKindAt(tokens, index: index - 1) == TokenKind.static
end 'staticModifierEndsAt'

// The same question at an arbitrary INDEX — split out for `moduleModifierIn`'s reason, one door up: the
// fixed-element-count scan (`Parser.structFieldKeywordAt`) walks a type body by index and parses
// nothing, so it cannot ask a cursor-relative predicate. One rule, two entry points, and the cursor
// form is the indexed one asked at `self.pos`.
function visibilityModifierIn(tokens TokenArray, index ElementIndex) returns bool
	let kind = tokenKindAt(tokens, index: index)
	return kind == TokenKind.export or kind == TokenKind.public
end 'visibilityModifierIn'

function pastVisibilityModifiers(tokens TokenArray, index ElementIndex) returns ElementIndex
	var keyword = index

	while visibilityModifierIn(tokens, index: keyword) 'pastModifiers'
		keyword = keyword + 1
	end 'pastModifiers'

	return keyword
end 'pastVisibilityModifiers'

function namedDeclarationBeginsIn(tokens TokenArray, index ElementIndex) returns bool
	return tokenKindAt(tokens, index: index + 1) == TokenKind.identifier and declarationBeginsStatementIn(tokens, index: index)
end 'namedDeclarationBeginsIn'

function typeDeclarationHeaderIn(tokens TokenArray, index ElementIndex) returns bool
	return tokenKindDeclaresANamedType(tokenKindAt(tokens, index: index)) and namedDeclarationBeginsIn(tokens, index: index)
end 'typeDeclarationHeaderIn'

function topLevelBindingIn(tokens TokenArray, index ElementIndex) returns bool
	return tokenKindAt(tokens, index: index) == TokenKind.let and namedDeclarationBeginsIn(tokens, index: index)
end 'topLevelBindingIn'

function declarationHeadShapeIn(tokens TokenArray, index ElementIndex) returns bool
	return functionHeadIn(tokens, index: index) or typeDeclarationHeaderIn(tokens, index: index) or topLevelBindingIn(tokens, index: index) or testDeclarationAt(tokens, index: index) or defaultDeclarationAt(tokens, index: index)
end 'declarationHeadShapeIn'

function declarationOpensIn(tokens TokenArray, index ElementIndex) returns bool
	return declarationHeadShapeIn(tokens, index: pastVisibilityModifiers(tokens, index: index))
end 'declarationOpensIn'

function declarationOpensAtHeadColumn(tokens TokenArray, index ElementIndex) returns bool
	let tok = try tokens.get(index) otherwise panic("declarationOpensAtHeadColumn: index {index} is not below the {tokens.count()} tokens it was asked about")

	return tok.column == DeclarationHeadColumn and declarationOpensIn(tokens, index: index)
end 'declarationOpensAtHeadColumn'

// What a `consumeNameToken` mismatch names when the position wanted an enum/union CASE name — the
// one spelling of it, so the declaration reader and the `Color.red` reader cannot report the same
// malformed program two different ways.
let EnumCaseNameExpectation = "an enum case name"

// ⚡ **WHICH NAME A `consumeNameToken` MISMATCH SHOULD SAY IT WANTED — a payload-free enum, for
// `IrInterface.BuiltinConformer`'s MEASURED reason.** `consumeNameToken` sits on a per-token path (every
// declaration, parameter, callee, method name, argument label and variable READ in the program), and passing
// the expectation as a rendered `String` allocates one at each of them for a diagnostic almost none of them
// raises. MEASURED on the scale ladder, against a parent-commit binary at the same path: passing
// `TokenKind.identifier.rawValue` eagerly cost **+5,495 allocations at rung 0, doubling per rung**. The text
// is now built only on the throw.
enum NamePosition
	// A DECLARATION's own name, a parameter, a callee or method name, an argument label — every position whose
	// mismatch the spec corpus pins as E2010 `Expected identifier but got '<x>'`.
	declaration

	// An enum/union CASE name.
	enumCase
end 'NamePosition'

// ⭐ **WHICH MEMBER LIST A TYPE MEMBER IS BEING READ FROM** — the ONE thing the two bodies that share
// `parseTypeMember` disagree about: a `type` body may declare STORAGE (a field or a `static let`), an
// `extension` body may not, because an extension adds methods to types other declarations named and has no
// declaration of its own for a slot to belong to.
//
// A named enum rather than a bool, for `NamePosition`'s reason in its readability half: the call sites read
// `parseTypeMember(MemberList.extensionBody)`, where `parseTypeMember(false)` would not say what was false.
enum MemberList
	typeBody
	extensionBody
end 'MemberList'

// ⭐⭐ **WHICH SENTENCE AN E3005 STORAGE-SLOT MISMATCH IS TOLD IN.** The VERDICT is one rule and this does not
// touch it (`declaredSlotVerdict` for a trivial slot, `requireManagedValueMatches` for a managed one, both
// shared with every assignment door); what differs is the PLACE the value failed to enter, and the two kinds
// of place say different TRUE things about themselves.
//
// ⚠ **UNTIL THIS EXISTED THE PARSER CALLED A METHOD A VARIABLE**, which was not a wording preference but a
// false statement: `arr.push("hello")` on an `Array with Int` read *"cannot assign 'String' to variable
// 'push' of type 'int'"* — `push` is not a variable, it is a method, and `"hello"` is its ARGUMENT.
// `specs/type-checking.md` (the canonical definition, and the user ruling of 2026-08-04 that its wording
// wins) pins the argument voice for exactly that program.
//
// It is a SCALAR passed to the two verdict doors rather than a rendered noun, for `FunctionTypeDoor`'s
// MEASURED reason — those doors run on every assignment, every field store and every container mutation in
// the program, and a `String` threaded through one cost +1,852 allocations in `phase:parse` at scale rung 0.
// `Parser.slotMismatchError` renders the words — the variant, the quoted name and the EXPECTED side's
// spelling, all three — only where a diagnostic is built, and it is the ONE place any of them is decided.
//
// ⚠ **IT IS NOT A NEW `FunctionTypeDoor` ARM**, and that is deliberate: `FunctionTypeDoor` answers *"which
// door did a FUNCTION VALUE meet a declared function TYPE at"* for a whole-program drain, its assignment-shaped
// arms are a CONTIGUOUS BAND its readers depend on, and a container element is still the `field` door for
// that question (it is a slot of the container's storage). Two questions, two scalars.
enum SlotMismatchVoice
	// A place the author NAMED and can point at — a local, a global, a struct field. The refusal names it:
	// `cannot assign '<got>' to variable '<name>' of type '<expected>'`.
	assignedPlace

	// The element argument of a parser-intrinsic container mutator (`push` / `set` / `insert`). These emit
	// `__managed_push`/`__managed_set` directly, so they have no `FuncSignature` and never reach
	// `SemanticCheck.checkArgTypes` — but they are calls all the same, and their refusal takes the sentence
	// every other argument position takes (`SemanticCheck.argTypeMismatchSentence`, through
	// `SourceParseError.builtinArgumentType` — the SAME variant the sibling `append` doors already raise).
	containerElementArgument

	// A UNION CASE's payload slot, filled from an argument list (`Paint.tint(Shade.light)`). It is not worded
	// in the `assignedPlace` voice (`variable 'Paint.tint(c)'`), which names a place no source line holds.
	// The two canonical specs that pin this position —
	// `union-cases.md`'s two `union-payload.error.*` cases and `enum-full.md`'s
	// `error.associated-value-type-mismatch` — both word it `type mismatch: 'expected <declared>, got
	// <arriving>'` and both anchor it at the token FOLLOWING the offending argument (its `,` or the
	// construct's `)`), which is where the cursor is left after reading that argument.
	payloadArgument

	// ⭐⭐ **A SERVICE MESSAGE's ARGUMENT, filling one payload slot of the synthesized request union .**
	// It takes `containerElementArgument`'s SENTENCE for that voice's stated reason — a message is a call
	// whose arguments never reach `SemanticCheck.checkArgTypes`, so the refusal has to be the argument sentence
	// every other argument position takes — and differs in the ONE thing that sentence quotes. A container
	// mutator's element parameter is always named `value` (`stdlib/Array.maxon` declares all three that way),
	// so that voice can name it from a constant; a message's is the parameter the AUTHOR declared, which is
	// the payload field's own name.
	//
	// ⚠ It is a third voice rather than a widening of the second because `slotMismatchError`'s header states
	// the rule it would break: *"the selection is made HERE and not by the callers"*. Reading `placeName` in
	// the container arm would take the choice back out to a caller that passes the METHOD's name there.
	messageArgument
end 'SlotMismatchVoice'

// ⭐⭐ **WHY A UNION BOX'S PAYLOAD SLOTS ARE BEING FILLED — AND IT DECIDES TWO THINGS THAT MUST NOT BE
// DECIDED SEPARATELY.** One `emitEnumBox` fills every boxed union in the language, and there are
// two constructs that reach it. They agree about the box — the size, the tag, the slot offsets and the
// zero-fill are the union's, not the construct's — and they differ about exactly two things:
//
//   • **WHO TAKES OWNERSHIP OF A MANAGED PAYLOAD.** A union CONSTRUCTED here hands its box to this frame, so
//     a borrowed value may be CO-OWNED (`moveInPayload`, the 2026-08-04 transitive-consume ruling). A message
//     crosses to another GREEN THREAD, where a second owner is not a refcount pair but a race
//     (`handOff`) — so the same borrowed value must be REFUSED or copied.
//   • **WHAT THE REFUSAL SOUNDS LIKE.** A construct's payload is a payload; a message's is an ARGUMENT, and
//     it takes the argument sentence every other argument position takes for
//     `SlotMismatchVoice.containerElementArgument`'s stated reason — it is a call whose arguments never
//     reach `SemanticCheck.checkArgTypes`.
//
// ⚠ **ONE PARAMETER AND NOT TWO, BECAUSE THEY ARE ONE FACT.** A caller free to pair the message's voice
// with the construct's transfer would be free to refuse in the argument's words while co-owning the
// argument's box, which is the wrong answer wearing the right sentence.
union PayloadFill
	// `Move.walk(5)` — the author is CONSTRUCTING a boxed union value, and it stays in this frame.
	unionConstruct

	// `h.bump(5)` — the author is SENDING a message, and the box is on its way to another green thread. It
	// carries the SERVICE's type name because the refusal names the message the argument belongs to, and the
	// case name alone (`caseTok`) is only half of it.
	serviceMessage(serviceTypeName immutable ByteArray)
end 'PayloadFill'

// The sentence a mis-typed payload is refused in, per fill. See `SlotMismatchVoice` for what each voice says.
function payloadFillVoice(fill PayloadFill) returns SlotMismatchVoice
	return match fill 'fill'
		unionConstruct gives SlotMismatchVoice.payloadArgument
		serviceMessage gives SlotMismatchVoice.messageArgument
	end 'fill'
end 'payloadFillVoice'

union ContainerElementSite
	call(method Token)
	literalElement(element Token)
end 'ContainerElementSite'

function containerElementSiteAnchor(site ContainerElementSite) returns Token
	return match site 'site'
		call(method) gives method
		literalElement(element) gives element
	end 'site'
end 'containerElementSiteAnchor'

function containerElementSiteName(site ContainerElementSite) returns immutable ByteArray
	return match site 'site'
		call(method) gives method.value
		literalElement gives freeze ArrayLiteralElementPlace.toByteArray()
	end 'site'
end 'containerElementSiteName'

// ⭐⭐ **THE TWO DOORS AN ERROR LEAVES A FUNCTION BY.** Both hand the caller a flag the
// caller decodes against the enclosing function's DECLARED `throws` clause, so both owe that clause the same
// debt, at the `try` door and at the `throw` door alike. It exists so `requireErrorTypeFitsEnclosing` can be the ONE
// comparison while still telling each author what THEY have to change; it must never gate the comparison
// itself. See `Parser.requireThrownTypeFitsEnclosing`.
enum ErrorExitDoor
	// A bare `try f()` — the callee's flag re-published into the enclosing function's error register verbatim.
	propagate

	// A `throw <e>` statement, or a match's `default throws <E.case>` arm — a flag minted here.
	throwStatement
end 'ErrorExitDoor'

// ⭐ **WHICH DOOR MADE A BORROWED MANAGED VALUE OWNED.** Each door names the ONE function that
// spends it, so this reads as a mapping rather than as a COUNT that goes stale the next time a
// caller is factored (this file has had a call-site count go wrong three times — see
// `markDeclaredSurface`; do not write a number here). The doors share every rule EXCEPT two, and
// the door is what tells them apart: the immutable-global refusal has to name the door it was
// reached through, or it describes a `var` binding that the program does not contain — and a
// TRIVIAL TUPLE copies at a HAND-OFF while it increfs at a BINDING (`borrowLaunderDoorIsHandOff`).
// It carries a door rather than a noun `String` for `FunctionTypeDoor`'s MEASURED reason: a
// `String` threaded into a guard that almost never fires costs one allocation per promotion, and
// the promotion path runs for every borrowed String a program returns.
enum BorrowLaunderDoor
	// `var q = p` / `q = p2` — the binding becomes a second owner in THIS frame. Spent by `parseBinding`'s
	// declaration and reassignment paths, the only two that enrol a value as an owned BINDING.
	binding

	// `return p` — the value escapes to the caller, which adopts it as owned. Spent by `emitOwnedValueReturn`,
	// which is every `return` AND a closure body's `gives` (both hand a value to a caller that drops it once).
	returned

	// A value merged into a result phi the consumer drops once: a `match`/ternary arm (`promoteBorrowedGive`)
	// or a `try … otherwise <expr>` fallback (`finishValueTry`). ONE arm, because the two are one question —
	// the phi does not know which construct minted it and drops its value exactly once either way — and since
	// the review they are also ONE caller, `promoteBorrowedMergeEdge`, which is what spends this door.
	merged
end 'BorrowLaunderDoor'

// ⭐⭐ **IS THIS DOOR A HAND-OFF — the value LEAVES the expression that produced it — or a BINDING, a
// second name for it in THIS frame?** It is the one question a TRIVIAL TUPLE's promotion turns on,
// and the answer is the language's rather than chosen: `var q = t` on a tuple PARAMETER aliases (a
// write through `q` shows on `t` — 55), while `return t` COPIES (2). So a binding increfs like any
// other aggregate, and a hand-off gives the tuple a record of its own.
//
// ⚠ **WITHOUT THIS SPLIT THE `merged` DOOR SILENTLY DISAGREES WITH THE `returned` ONE.** With the tuple
// copy in `emitOwnedValueReturn` alone, `return t` copies while `return t if c else (7, 8)` — the same
// borrowed tuple, one hand-off further out — is increfed by the merge and then passes the return's
// `not valueIsOwnedHeap` guard as if the frame solely owned it, printing `a.1=99` where the oracle and
// `return t` print `a.1=2`. Asking it HERE is what keeps the three doors from disagreeing about which
// values have value semantics.
function borrowLaunderDoorIsHandOff(door BorrowLaunderDoor) returns bool
	return match door 'which'
		binding gives false
		returned or
		merged gives true
	end 'which'
end 'borrowLaunderDoorIsHandOff'

// ⭐⭐⭐ **HOW MANY OWNERS DOES THIS OWNED VALUE'S ALLOCATION HAVE — ONE, OR MORE THAN ONE?** Every door that
// makes a value owned states this, because `markValueOwnsHeap` takes it as a required argument and there is no
// other writer of the owned bit. It exists because *"this value owns a reference"* and *"this frame is the
// allocation's SOLE owner"* are DIFFERENT FACTS, and the compiler had one predicate answering both:
// `valueIsOwnedHeap` gated the two DESTRUCTIVE transfers — the match payload move-out
// (`Parser.moveOutManagedPayload`) and the thrown-field move-out (`Parser.moveOutThrownField`), each of which
// NULLS a slot in a box it does not re-read — and a co-owned box's other owner does. MEASURED as SIX
// segfaulting programs, all one defect: a union bound out of a mutable struct FIELD, out of an array element,
// out of a borrowed union's payload and then matched again inline, a field thrown out of a co-owned container,
// a co-owned reference RETURNED across a call, and a retained box CAUGHT across one.
//
// ⛔ **CO-OWNERSHIP IS THE DEFAULT, AND THAT DIRECTION IS THE WHOLE SAFETY ARGUMENT.** The RETAIN path is
// unconditionally correct — a bounded `__mm_incref` whose release is structural (`retainBorrowedPayload`) — so
// a door that understates its ownership costs one refcount pair, while one that overstates it steals a slot
// from a live owner. A new door therefore has to EARN `sole`; forgetting to claim it is safe, and the required
// argument means it cannot be forgotten silently either way.
//
// ⚠ It is a two-case enum rather than a `bool` for the reason `BorrowLaunderDoor` is not one: `sole: true` at a
// call site says nothing about which of the two facts is being asserted, and this is the file where confusing
// them cost six segfaults.
enum OwnedHeapExclusivity
	// The value holds the ONLY live reference to its allocation, and there is exactly ONE way to know that:
	// **THIS FRAME JUST EXECUTED THE OP THAT MADE THE ALLOCATION** (a `__mm_alloc`, a container create, a
	// `constArrayLiteral`, an interpolation record, a minted Character). A destructive move-out through it is
	// sound: nothing else will read the slots it nulls.
	//
	// ⛔⛔ **AND HERE IS THE INFERENCE THAT IS RETIRED, BECAUSE IT IS THE ONE THAT COST THREE SEGFAULTS**: *"or
	// because it is what is LEFT after a slot this frame solely owned was vacated."* That sentence stood here,
	// and it is FALSE — **soleness is not transitive.** A box this frame solely owns can hold a payload it only
	// CO-owns, because `moveManagedValueInto`'s `borrowedManaged` arm stores by `__mm_incref` rather than by
	// move. Three doors derived a claim about the CONTENTS from a claim about the CONTAINER and each nulled a
	// slot a live co-owner still read: `moveOutManagedPayload`, `emitContainerElementAccessor`'s move-out arm,
	// and `moveOutThrownField` — the third found only after a review had cleared it as "properly gated", which
	// was right about liveness and wrong about the inference. All three now pass `coOwned`.
	//
	// ⇒ **The audit that keeps this true is a PROPERTY, not a list**: no site may derive `sole` from another
	// value's soleness. `mergedHeapExclusivity` is the sole exception and it is safe by direction — it joins
	// its edges' own claims UNIVERSALLY, so one non-sole edge poisons the result.
	//
	// ⚠ This case comment is where the header above sends every future door-writer, which is exactly why the
	// retired inference is spelled out and struck rather than deleted: a reader who reaches for it needs to
	// find it refused here, not absent.
	sole

	// Some other live owner holds the same allocation, or this frame cannot prove that none does.
	// Three producers, and the third is the one an enumeration would miss: a RETAIN
	// (`__mm_retain`/`__mm_incref` — co-ownership by construction), a MERGE whose edges are not all
	// sole, and a value that CROSSED A FRAME BOUNDARY — a consumed parameter, a call's owned result, a
	// caught error box other than a send error's (`serviceSendErrorExclusivity`) — where the
	// transferring frame's choice between a move and an incref is invisible here and is a
	// whole-program fact the compiler does not compute.
	coOwned
end 'OwnedHeapExclusivity'

// ⚠ A send error is `sole` wherever it is held, which is what lets a caught one's arguments be
// moved out and sent again. The failed send built the box from the words it owned and cloned every
// shared argument, so no thrower's container can read it. A payload of an uncloneable type is handed back
// uncloned, so its bind retains instead (`sendErrorSlotIsCoOwnedByType`).
function serviceSendErrorExclusivity(signatures ProgramSignatures, unionName ByteArray) returns OwnedHeapExclusivity
	return OwnedHeapExclusivity.sole if signatures.isServiceSendError(unionName) else OwnedHeapExclusivity.coOwned
end 'serviceSendErrorExclusivity'

// ⭐⭐ **WHERE A NODE HANDLE WAS MINTED FROM — the provenance `__ManagedList.remove`'s ONE compile-time
// exemption is keyed to.** A handle minted BY A CHAIN carries that chain's value, so
// `ml.remove(ml.insertLast(x))` can be admitted by IDENTITY rather than by shape, and
// `a.remove(b.insertLast(x))` refused at the parse rather than left to the runtime's cross-chain abort.
//
// ⚠ **`unchained` IS A REAL ANSWER AND NOT AN ABSENCE.** `n.next()` and `n.prev()` mint handles from a
// NODE, where no chain value is in scope to name — and the arrival they produce is exactly the one `remove`
// must refuse (an unnamed handle no statement can mark as moved), so declining to guess a chain gives the
// right refusal rather than a missing one. The alternative, stamping some chain that happens to be nearby,
// is how an exemption gets widened by a caller.
union NodeHandleProvenance
	chain(list ValueId)
	unchained
end 'NodeHandleProvenance'

// ⭐⭐⭐ **WHERE DOES THE CALLER'S REFERENCE TO A CONTAINER ELEMENT COME FROM?** The question
// `emitContainerElementAccessor` answers for every element read in the language, and a `bool` could only
// say two of its three answers.
//
// ⚠ It is an enum rather than a `bool` for `OwnedHeapExclusivity`'s reason: the retired `owned: true` said
// nothing about WHICH fact was being asserted, and the two owning answers differ in whether the CONTAINER
// still holds the element — which is exactly what decides whether the reference had to be taken.
enum ContainerElementReference
	// The container KEEPS the element and the caller only looks at it: `get`, `first`, `last`, the `for … in`
	// element read, a cursor's `current`/`peek`. No reference is taken at the read — it is counted where it
	// is held (`HoldResolution.maxon`) — and the container is held to the scope's exit.
	borrowed

	// The container GIVES THE ELEMENT UP and the caller inherits its reference: `remove`, `removeFirst`,
	// `removeLast`, `pop`. Nothing is increfed — the container's own reference is what the caller now holds
	// — and the slot it came out of is nulled by the runtime entry so nobody drops it twice.
	movedOut

	// The container KEEPS the element AND the caller owns a reference of its own — a NEW one, taken here.
	// The one member that needs it is `__ManagedListNode.value()` on a concrete managed element, because
	// `setValue` releases what the node held: a borrow would dangle the moment the node is overwritten,
	// which is `/specs/managed-list.md:node.set-value-old-survives` exactly, and a move-out would free an
	// element the node still points at.
	retained
end 'ContainerElementReference'

// The sentence for an error type leaving a function that declares no `throws` at all. Each door names the
// remedy its author can actually reach for: the `try` door can convert the error with an `otherwise`, the
// `throw` door has no such move and can only declare the clause.
function noEnclosingThrowsDetail(errorType String, door ErrorExitDoor) returns String
	return match door 'which'
		propagate gives "try propagates '{errorType}' but the enclosing function declares no 'throws' — the error has nowhere to go and would be dropped; add 'otherwise' to handle it, or declare 'throws {errorType}'"
		throwStatement gives "throw of '{errorType}' but the enclosing function declares no 'throws' — the error flag has nowhere to be published and would be silently dropped, the throw path handing back the primary register's 0 as a real answer; declare 'throws {errorType}', or handle it here with a `try … otherwise`"
	end 'which'
end 'noEnclosingThrowsDetail'

// The expectation text for a `NamePosition`, rendered on the FAILURE path only (see `NamePosition`).
function nameExpectationOf(position NamePosition) returns String
	match position 'which'
		declaration then return TokenKind.identifier.rawValue
		enumCase then return EnumCaseNameExpectation
	end 'which'
end 'nameExpectationOf'

// Does a scrutinee's type name resolve to a declared enum/union? The predicate `parseMatchCommon`
// branches enum-vs-scalar on, factored out so the flag and the layout extraction below cannot come
// to disagree about what "is an enum match" means.
function enumMatchIsDeclared(decl DeclaredEnum) returns bool
	return match decl 'kind'
		declared gives true
		undeclared gives false
	end 'kind'
end 'enumMatchIsDeclared'

// The layout behind a `declared` enum match — called ONLY where `enumMatchIsDeclared` already
// answered true, so `undeclared` is a caller-guard break, not a program error. Returns the layout
// REFERENCE (no allocation), so re-extracting it at each of the three enum branch sites is free.
function requireEnumLayout(decl DeclaredEnum) returns immutable EnumLayout
	match decl 'kind'
		declared(layout) then return layout
		undeclared then panic("requireEnumLayout: called on a scalar match — guard with enumMatchIsDeclared")
	end 'kind'
end 'requireEnumLayout'

// A match arm that reaches the merge block — its exit block, the carried-variable values it
// leaves scope with, and (expression form only) the value it `gives`. Collected as the arms are
// parsed and drained by `finalizeMatchMerge`, which mints the merge's phis from the whole set.
//
// ⭐ There are neither slots nor mem2reg here, so each arm's value is threaded to the merge as a
// BLOCK-ARG — exactly as `if`/`while` thread a `var` across their joins. A mutable result SLOT (a
// store per arm, one load at the merge, promoted later) would reintroduce the very machinery this
// design exists to avoid.
type MatchArmExit
	export var exitBlock as IrBlock
	export var exitVals as ValueIdArray
	export var give as MatchGiveValue

	// The owned-binding move state this arm carries into the merge — the twin of `exitVals` for the
	// drop-gating bit, reconciled across the reaching arms so a value moved in one arm but left live in
	// another is dropped on the live arms' edges (`finalizeMatchMerge` → `reconcileMovesAtMerge`).
	export var moveMark as MoveMark

	// ⭐ **THE E3207 BLAME THIS ARM'S `gives` EXPRESSION WOULD CARRY** — the `let` binding a write through the
	// merged value would land in, or `unblamed`. It travels per ARM rather than per VALUE, and `finalizeMatchMerge` folds the reaching arms' blames onto the
	// result phi. A STATEMENT arm and a `break` exit give no value and can blame nothing, and each
	// says so at its own construction rather than through a default nobody reads.
	export var blame as immutable ByteArray

	static function create(exitBlock IrBlock, exitVals ValueIdArray, give MatchGiveValue, moveMark MoveMark, blame immutable ByteArray) returns MatchArmExit
		return Self{exitBlock: exitBlock, exitVals: exitVals, give: give, moveMark: moveMark, blame: blame}
	end 'create'
end 'MatchArmExit'

typealias MatchArmExitArray = Array with MatchArmExit

// ⭐⭐ **ONE ENCLOSING MATCH STATEMENT — A `break` TARGET, ON ITS OWN STACK BESIDE `Parser.loops`.**
//
// `break` targets a match ∪ the loops; `continue` targets the loops ONLY (`specs/match-statements.md`'s
// "## Break" section states it verbatim and `docs/WRITING_MAXON_CODE.md:529-532` agrees). The two kinds
// therefore cannot share one kind-tagged stack: every existing reader of `Parser.loops` means "the
// innermost LOOP" by reading its top — `bindingIndexEscapesLoop` above all, which decides whether a move
// escapes a loop — and a match interleaved into that stack would silently give each of them a different
// answer. A SECOND stack leaves every one of them correct by construction.
//
// A match EXPRESSION is never pushed: each of its arms feeds the one result phi, and a `break` that
// skipped an arm would leave that phi an operand short. Only the statement form is a target.
type MatchContext
	export let label as immutable ByteArray

	// The match's carried-variable set. A `break`'s exit snapshot must be positional over the SAME list
	// every arm's exit snapshot is, because `finalizeMatchMerge` compares them slot by slot.
	export var carried as VarInfoArray

	// The owned-binding height at match entry — the floor a `break` releases down to, dropping the arm's
	// own payload/`let` bindings on its way out. The exact twin of `LoopContext.ownedFloor`, and equal to
	// every arm's `armOwnedFloor`, since `dropArmScopedOwned` drains each arm back to it. Captured AFTER
	// the temporary-scrutinee enrolment, so the scrutinee box — which outlives the match — sits BELOW the
	// floor and a break does not drop it.
	export let ownedFloor as ElementIndex
	export let windowFloor as ElementIndex

	// The arm exits contributed by `break`s that target this match, drained into `reachingArms` before
	// `finalizeMatchMerge` counts them.
	//
	// ⭐ A break's block is a reaching arm exit like any other — same record, same join, same phi args — so a
	// match whose every arm breaks has a non-empty reaching set and a live merge without any second signal to
	// keep in step.
	export var breakExits as MatchArmExitArray
	export let debugOpenFloor as ElementIndex

	static function create(label immutable ByteArray, carried VarInfoArray, ownedFloor ElementIndex, debugOpenFloor ElementIndex, windowFloor ElementIndex) returns MatchContext
		return Self{label: label, carried: carried, ownedFloor: ownedFloor, windowFloor: windowFloor, breakExits: MatchArmExitArray.create(0), debugOpenFloor: debugOpenFloor}
	end 'create'
end 'MatchContext'

typealias MatchContextArray = Array with MatchContext

// What a `break`/`continue` resolved to. Two arms rather than one context type with a kind tag, because
// the destinations are genuinely different things: a loop's exit block already EXISTS and takes its
// loop-carried phi args now, while a match's merge is not a block yet at all — `finalizeMatchMerge` mints
// it last — so a break enrols itself in the reaching-arm set instead of branching.
union ControlTarget
	loopExit(ctx LoopContext)
	matchMerge(ctx MatchContext)
end 'ControlTarget'

// The constructs a keyword may leave, for the two E2047 texts. A shared "inside a loop" wording became
// FALSE for `break` the moment a match became a target, while staying true for `continue` — so the noun
// is derived from the same single bit `resolveControlTarget` computes, and the message cannot come to
// disagree with the resolution about what the keyword may name.
function controlTargetNoun(isBreak bool) returns String
	return "loop or match" if isBreak else "loop"
end 'controlTargetNoun'

// Which declared place `Parser.requireStorableDeclaredType` is refusing. An enum (a scalar), so the
// classification costs nothing at the sites that pass it.
// ⭐ **THE FIRST INTERFACE-TYPED PARAMETER OF A PARAMETER LIST, AND ITS ANCHOR** — the ONE scan two readers
// share. A closure's parameter list and an interface requirement's are read by different doors and refused
// at different moments (one throws, one records for the real parse), but "which parameter is an existential"
// is one question and is asked once.
type ExistentialParam
	export let declaredType as MaxonType
	export let anchor as SourceRange

	static function create(declaredType MaxonType, anchor SourceRange) returns ExistentialParam
		return Self{declaredType: declaredType, anchor: anchor}
	end 'create'
end 'ExistentialParam'

// Absence is a THROW rather than a sentinel, the channel every other lookup in this file speaks.
function firstExistentialParam(paramTypes MaxonTypeArray, paramRanges SourceRangeArray) returns ExistentialParam throws MapError
	for i in 0 upto paramTypes.count() 'eachParam'
		let paramType = try paramTypes.get(i) otherwise panic("firstExistentialParam: paramTypes.get OOB at {i} below count {paramTypes.count()}")

		if maxonTypeTag(paramType) == ValueTypeTag.interfaceRef 'anExistential'
			return ExistentialParam.create(paramType, anchor: try paramRanges.get(i) otherwise panic("firstExistentialParam: paramRanges.get OOB at {i} — the two columns are filled in lockstep by `parseFunctionParameters`"))
		end 'anExistential'
	end 'eachParam'

	throw MapError.keyNotFound
end 'firstExistentialParam'

enum DeclaredStoragePosition
	unionPayload
	containerElement

	// ⭐ The PARAMETER positions, which the three above deliberately exclude — a plain function's parameter IS
	// a position with room, and it stays legal. These are the ones whose ABI has no adjacent slot to give:
	// a lifted closure and a function TYPE are called through the uniform `(userargs, record)` indirect shape,
	// and an interface REQUIREMENT is called through a witness slot. Appended at the END, per the band-append
	// rule the `containerElement` arm's own note relies on.
	closureParameter
	interfaceRequirementParameter

	// A function type's parameter (`typealias ShapeFn = function(Shape) returns Integer`), called
	// through the same uniform function-value ABI as `closureParameter`.
	functionTypeParameter

	// ⭐ A generic type argument INFERRED from a factory's arguments (`spawnFactoryConstructorInstance`) — the
	// one road to an instantiation that names no written type, so it asks no declaration door.
	inferredTypeArgument

	// ⭐ A TUPLE ELEMENT. Reached by a THIRD route the ones above do not — a tuple type is interned into a
	// synthesized struct, so its element list is parsed by `parseTupleTypeReference` rather than by any
	// field/parameter/return reader, and it asked no door at all.
	tupleElement

	// ⭐⭐ **THE RETURN POSITIONS, WHICH DO NOT SHARE A REASON.** A DIRECT call carries the witness half of a return:
	// a non-throwing function hands it back in the second return register (`functionUsesSecondaryReturnSlot`),
	// so the refusals below do not share a reason and cannot share a clause. Each names the call
	// shape that cannot read that register.
	//
	// A THROWING function's return: the second register is the ONE the error flag already spends. Both
	// halves want it and there is exactly one, so this is a CONTENTION rather than a missing mechanism —
	// which is why its remedy is to drop the `throws`, not to move the interface somewhere else.
	throwingReturnType

	// A FUNCTION TYPE's return (`typealias MakeFn = function() returns Shape`). Called through
	// `StdOp.callIndirect`, which carries its whole signature ON THE OP and has room for one result.
	functionTypeReturnType

	// An interface REQUIREMENT's return. Dispatched through a witness-table slot, whose signature carries the
	// return as one machine word (`requirementAbiType`), so the witness half has no register.
	interfaceRequirementReturnType

	// ⭐ A FUNCTION VALUE's return, which is the position `functionTypeReturnType` does not cover: that one is
	// the DECLARED spelling (`typealias MakeFn = function() returns Shape`), and these two routes declare
	// nothing at all — a closure's return type is INFERRED from its `gives` expression, and `let f = make`
	// takes a value of whatever `make` returns. Same ABI, same reason, so it shares both clauses; a separate
	// position only because the subject sentence has to be honest about there being no declaration.
	functionValueReturnType

	// ⭐⭐ **AN INTERFACE INSTANCE'S ASSOCIATED-TYPE BINDING WHOSE ASSOCIATED TYPE REACHES A REQUIREMENT'S
	// PARAMETER** — the second argument of `Bag with (Integer, IntegerCursor)`, where `Iter` is written as
	// something a requirement TAKES. It reaches the SAME reader a container's element does
	// (`parseGenericArgNode`, which sees only an argument), and it is a different absence with a different
	// remedy: the binding is not a SLOT that is one word too narrow, it is an argument whose table would have
	// to come from the caller. Sent the `containerElement` sentence, the author is told a parameterized
	// interface has "an element slot", which names a container the program does not have.
	//
	// ⚠ **IT USED TO COVER THE RESULT POSITION TOO, AND THAT HALF IS NOW SUPPLIED RATHER THAN REFUSED.** A
	// requirement's RESULT is produced by the impl, whose own conformance pins the concrete type statically,
	// so the table to widen it through is a compile-time constant and rides in the conformer's own witness
	// table (`IrInterface.witnessAssociatedSlotOffset`). An ARGUMENT's table is the CALLER's — a different
	// conformer at every call site — so no slot of the callee's table can be right about it, and this is
	// what is left.
	//
	// Appended at the END, past `functionValueReturnType`, per the band-append rule the `containerElement`
	// arm's own note relies on — and past the `functionTypeReturnType to functionValueReturnType` range,
	// which would otherwise have swallowed it.
	associatedTypeBinding
	globalBinding
end 'DeclaredStoragePosition'

// ⭐⭐ **WHAT A `Base with Args` ARGUMENT IS, FOR THE ONE CHECK THAT HAS TO TELL THEM APART.** A `type`
// base's argument is a container ELEMENT; an `interface` base's is an associated-type BINDING, and the
// binding arm carries the interface NAME because its check is about the associated type at that position —
// which requirement writes it, and whether in the result or in an argument. See
// `ProgramSignatures.genericArgSlotOf`, which decides it once from the base.
union GenericArgSlot
	containerElement
	associatedTypeBinding(interfaceName immutable ByteArray)

	function storagePosition() returns DeclaredStoragePosition
		return match self 'slot'
			containerElement gives DeclaredStoragePosition.containerElement
			associatedTypeBinding gives DeclaredStoragePosition.associatedTypeBinding
		end 'slot'
	end 'storagePosition'
end 'GenericArgSlot'

// ⭐ **WHAT A DISPATCH NEEDS TO KNOW TO BUILD THE FAT POINTER ITS RESULT IS** — the interface the associated
// type is held at (which TYPES the value), the witness-table byte offset its nested table's distance sits at
// (which finds the second word), and the associated POSITION both were read at (which is what the receiver's
// own instantiation is indexed by). All three are derived from ONE lookup of that position, so they
// travel together rather than being asked for separately by a caller that could pair position `p`'s offset
// with position `q`'s interface. See `Parser.heldAssociatedReturnOf`.
type HeldAssociatedReturn
	export let heldAt as immutable ByteArray
	export let slotOffset as ByteOffset
	export let position as ElementIndex

	static function create(heldAt ByteArray, slotOffset ByteOffset, position ElementIndex) returns HeldAssociatedReturn
		return Self{heldAt: heldAt, slotOffset: slotOffset, position: position}
	end 'create'
end 'HeldAssociatedReturn'

// ⭐⭐ **THE ONE SENTENCE EVERY INTERFACE-TYPED-POSITION REFUSAL IS BUILT FROM.** Each of the places
// `DeclaredStoragePosition` names has no room for an existential's second word, and each says so with the
// same three parts: WHAT is being declared, WHERE the second word has nowhere to go, and WHAT TO DO.
// Written once here rather than spelled per site.
//
// ⚠ **THE COUNT IS DELIBERATELY NOT WRITTEN DOWN HERE.** It has been wrong in this file's comments in
// three consecutive rounds — "three positions", "the two PARAMETER positions", "six declared places" —
// each true when written and false one commit later. The enum IS the count; a prose copy of it is a
// second declaration free to rot.
//
// ⚠ **THE REMEDY IS PER POSITION, AND NO ONE CLAUSE IS RIGHT FOR ALL OF THEM.** The storage positions all
// close with *"or take the interface as a PARAMETER, which carries its witness as an adjacent argument"* —
// true of a plain function (MEASURED: an interface parameter there answers 31 on both targets) and FALSE of
// the positions whose whole problem is that their ABI reserves no such slot. Sent to a
// requirement's parameter, that advice walks the reader straight into a segfault.
function interfaceStoragePositionMessage(position DeclaredStoragePosition, interfaceName ByteArray) returns String
	return "{storagePositionSubject(position)} declared at the interface type '{String.from(interfaceName)}' — {ExistentialIsFatPointerReason}, and {storagePositionRoom(position)}. {storagePositionRemedy(position)}"
end 'interfaceStoragePositionMessage'

// WHAT TO DO, per position — see `interfaceStoragePositionMessage` for why this is not one shared clause.
function storagePositionRemedy(position DeclaredStoragePosition) returns String
	match position 'which'
		unionPayload or
		containerElement or
		inferredTypeArgument then return "Declare it at a concrete type, or take the interface as a PARAMETER of a plain function, which carries its witness as an adjacent argument"
		closureParameter or
		functionTypeParameter then return "Declare the parameter at a concrete type, or pass the interface to a named function DIRECTLY, whose signature reserves the adjacent slot"
		interfaceRequirementParameter then return "Declare the parameter at a concrete type, or declare the requirement over a type parameter the interface constrains"
		tupleElement then return "Declare the element at a concrete type, or pass the interface alongside the tuple as a PARAMETER of a named function, which carries its witness as an adjacent argument"

		// The contention's remedy is the only one in this family that does NOT move the interface: the
		// register exists and a non-throwing function returns the witness in it, so what has to give is the
		// `throws`.
		throwingReturnType then return "Declare the function without `throws` — a non-throwing function returns the witness half in that same second register — or return a concrete type and report the error some other way"
		functionTypeReturnType or
		interfaceRequirementReturnType or
		functionValueReturnType then return "Declare the return at a concrete type, or hand the interface back from a NAMED function called DIRECTLY, whose second return register carries the witness half"

		// It does NOT offer "take the interface as a PARAMETER", which every other storage position can: the
		// binding already IS on an existential parameter, and the value that cannot travel is the one a
		// REQUIREMENT hands back. Moving the outer type changes nothing about that.
		associatedTypeBinding then return "Hold the associated type at an interface only where every requirement that writes it RETURNS it, or bind it to a concrete conformer"
		globalBinding then return "Return a concrete type from the initializer, or hold the interface in a LOCAL of a function, which carries its witness as a second value"
	end 'which'
end 'storagePositionRemedy'

// WHAT is being declared, for the refusal's sentence. Rendered on the FAILURE path only.
function storagePositionSubject(position DeclaredStoragePosition) returns String
	match position 'which'
		unionPayload then return "a union case payload"
		containerElement then return "a container's element type"
		inferredTypeArgument then return "a type argument inferred from a factory argument"
		closureParameter then return "a closure parameter"
		interfaceRequirementParameter then return "an interface requirement's parameter"
		functionTypeParameter then return "a function type's parameter"
		tupleElement then return "a tuple element"
		throwingReturnType then return "a THROWING function's return type"
		functionTypeReturnType then return "a function type's return type"
		interfaceRequirementReturnType then return "an interface requirement's return type"
		functionValueReturnType then return "a function value's return type"
		associatedTypeBinding then return "an interface instance's associated-type binding"
		globalBinding then return "a top-level binding"
	end 'which'
end 'storagePositionSubject'

// WHERE the second word has nowhere to go — the reason, per position, so the message says what is missing
// rather than that something is.
function storagePositionRoom(position DeclaredStoragePosition) returns String
	match position 'which'
		unionPayload then return "a payload slot is one machine word, and unlike a struct field it cannot widen — every case of a union shares one slot region"
		containerElement then return "an element slot is one machine word"
		inferredTypeArgument then return "a slot standing at a type parameter is one machine word"
		closureParameter or
		functionTypeParameter then return IndirectCallHasNoWitnessSlotReason

		// Refused even for a parameter the impl never dispatches on: wasm traps on the call itself, so
		// the formal is unrepresentable rather than merely unchecked.
		interfaceRequirementParameter then return "a witness call carries one machine word per argument, so the witness half is dropped and the impl dispatches through whatever the next slot happens to hold"
		tupleElement then return "a tuple is a synthesized struct, so an element is a field slot: one machine word"

		// ⚠ Emitting the throwing return with a constant-0 flag instead would leave the witness inside
		// the callee and degrade the value to a bare pointer, with no diagnostic at all.
		throwingReturnType then return "a return hands back one register plus a second, but on a throwing function that second register already carries the error flag — there is exactly one of it and both halves want it"

		// A function value's signature has one result slot, while a requirement's return cannot be
		// spelled as an interface: two different absences, so two different sentences.
		functionTypeReturnType or
		functionValueReturnType then return "a call through a function value carries its whole signature on the call op (`callIndirect`), where there is room for ONE result — so the second register is never read and the witness half is dropped"
		interfaceRequirementReturnType then return "a requirement is dispatched through a witness-table slot that carries the return as one machine word — so the second register is never read and the witness half is dropped"
		associatedTypeBinding then return "a witness call carries one machine word per argument, so an argument's witness half is dropped — and unlike a result, whose conformer the impl that produces it pins statically, an argument's table is the CALLER's and differs per call site, so no slot of the callee's table can supply it"
		globalBinding then return "a global's slot is one machine word, with nowhere to hold the witness half"
	end 'which'
end 'storagePositionRoom'

// ⭐ **WHICH VALUE-MERGE CONSTRUCT `finalizeMatchMerge` is finishing.** The three share ONE
// merge — the phi, the give-agreement rules, the ownership normalisation — but they must NOT share their
// DIAGNOSTIC NOUN: a `match` reports "match arms give incompatible types" (E3005) naming the offending
// arm, while a ternary reports "ternary expression type mismatch" (E2028) naming the TRUE and FALSE
// branches by position. `isExpression` alone cannot tell a match EXPRESSION from a ternary — both give a
// value — so the construct rides explicitly. `matchStatement`'s presence is what lets `isExpression` be
// DERIVED here (`!= matchStatement`) rather than passed alongside, so the two can never disagree.
enum MergeConstruct
	matchStatement
	matchExpression
	ternary
end 'MergeConstruct'

// ⭐⭐ **WHICH DOMAIN'S CONSTANT THE PARSER HOLDS FOR A VALUE — one column, two views, no second column.**
// The parser's fold columns hold a bare 64-bit payload, and 64 bits are 64 bits: an integer's is a
// NUMBER and a float's is an IEEE-754 BIT PATTERN, and reading one as the other is a silent wrong answer at
// compile time (`3.14 + 2.0` folded as integers is neither 5.14 nor anything else).
//
// ⭐ **THE FLOAT HALF COSTS NOTHING, because the alternative is a
// SECOND COLUMN and this is not one.** The `known` flag was already a per-value column; making it say WHICH
// DOMAIN instead of merely WHETHER costs the same slot and answers both questions from one read. So
// `constIsKnown` is still a single array probe and still means "the compiler holds this value's INTEGER" —
// every existing reader is unchanged, and `3.14 + 2.0` still cannot fold, because a float's slot says
// `float` and never `integer`.
//
// ⚠ **THE DOMAIN IS THE PAYLOAD'S, NOT THE VALUE'S TAG, and they are deliberately not the same fact.** A
// value whose tag is `float` may hold NO constant (a parameter, a runtime divide) — that is `unknown`, not
// `float`. Reading the tag to decide how to read the payload would answer `float` for both and hand a
// caller the unseeded 0 as if it were `+0.0`, which is exactly the sentinel this column exists to refuse.
enum ConstPayloadDomain
	// No constant at all: a parameter, a call result, a merge phi, a value whose defining op declined to fold.
	unknown

	// The payload is an integer. Read through `constIsKnown`/`constOf`.
	integer

	// The payload is an f64 BIT PATTERN. Read through `floatConstIsKnown`/`floatConstBitsOf`, and never
	// through the integer pair — its ONE reader is the division-by-zero proof, which asks the pattern-safe
	// `floatOrderKey` rather than comparing the bits as a number.
	float

	// ⭐ **THE PAYLOAD IS THE `ElementIndex` OF THE `stringLiteral` OP THAT DEFINED THIS VALUE** — i.e. *"the
	// compiler MINTED these bytes and can still read them"*. Written by `emitStringLiteral`, the one site that
	// mints a `string`-tagged literal, and read through `knownLiteralBytes`.
	//
	// ⚠ **THE OP INDEX RATHER THAN THE BYTES, because this column is `FullRangeInt`-wide and a `ByteArray` is
	// not** — and an op index needs no second table: `module.ops` already holds the bytes, its indices are
	// stable for the whole file parse (`retypeCharLiteralAsCodepoint` writes one back in place), and this
	// column is re-created per function beside every other value column, so an index cannot outlive the
	// artifact that gave it meaning.
	stringLiteralOp

	// ⭐ **THE PAYLOAD IS A BYTE POSITION INTO A KNOWN-BYTES String** — what `startIndex()` and `endIndex()`
	// answer when their receiver's bytes are `stringLiteralOp`-known. Written by `recordConstStringIndexResult`
	// and read through `knownStringBytePos`.
	//
	// ⚠ It is NOT `integer`: a `StringIndex` is a two-field heap box, not a number, so nothing that reads an
	// INTEGER constant (the shift rule, `emitBinOp`'s fold, the duplicate-pattern check, the division proof)
	// may ever see this payload as one. A domain of its own is what keeps them from it.
	stringBytePos
end 'ConstPayloadDomain'

function mergeConstructOf(isExpression bool, destination ArmDestination) returns MergeConstruct
	match destination 'destination'
		returned then return MergeConstruct.matchStatement
		merged then return MergeConstruct.matchExpression if isExpression else MergeConstruct.matchStatement
	end 'destination'
end 'mergeConstructOf'

typealias ConstPayloadDomainArray = Array with ConstPayloadDomain

// ⭐⭐ **THE `stdlib/String.maxon` DECLARATIONS THE CONSTANT-SLICE FOLD RECOGNIZES**
// (`specs/constant-string-slice.md`), spelled as the qualified names `dispatchMethodOnBase` mints for a
// method on a `String` receiver. Whole names for the reason `BuiltinsMmAllocTotalName` is one: what is being
// matched is a callee, and a callee is one name.
let StringSliceMethodName = b"String.slice"
let StringSliceLengthMethodName = b"String.sliceLength"
let StringCStrMethodName = b"String.cstr"
let StringStartIndexMethodName = b"String.startIndex"
let StringEndIndexMethodName = b"String.endIndex"

// The bound's argument label in `slice(start, endIndex:)` and in `sliceLength(start, length:)`. Only the
// first argument of a call may be positional, so the label says which meaning the bound carries.
let SliceEndIndexArgLabel = b"endIndex"
let SliceLengthArgLabel = b"length"

// `slice`'s argument shape at the parse tier: the prepended receiver, the start index, and the bound.
let StringSliceArgCount = 3 as ElementIndex
let SliceReceiverArgIndex = 0 as ElementIndex
let SliceStartArgIndex = 1 as ElementIndex
let SliceBoundArgIndex = 2 as ElementIndex

// `startIndex()` / `endIndex()` take no argument of their own, so the prepended receiver is the whole list.
let StringIndexAccessorArgCount = 1 as ElementIndex

// Where `startIndex()` points: the first byte. Named rather than written as a bare `0` beside a `count()`,
// because the pair is what the fold's range test reads and one of them being a position is the point.
let LiteralStartBytePos = 0 as FullRangeInt

let EmptyInterpolationLength = 0

// ⭐ **THE BYTES BEHIND A VALUE THE COMPILER MINTED FROM A STRING LITERAL, OR THE ABSENCE OF THEM.** A union
// rather than a `ByteArray` plus a companion `bool`, and rather than an empty `ByteArray` standing for
// "unknown": `""` is a perfectly good literal whose slice is a perfectly good fold, so an empty payload is a
// VALUE here and can never be the sentinel for its own absence.
union KnownLiteralBytes
	unknown

	// The DECODED payload the `stringLiteral` op carries — the same bytes `LowerMaxonToStd` will register as
	// an immortal `.rdata` blob — and the INDEX of the op carrying them. The index rides along because it is
	// the literal's identity: two values naming one literal (a rebind, a second use) share it, so it is what
	// `literalHasSingleByteGraphemes` memoizes the UAX#29 answer under. Deriving it a second time from the
	// value would be the same read written twice, free to be given a different value id one edit later.
	payload(literalOp ElementIndex, bytes immutable ByteArray)
end 'KnownLiteralBytes'

// ⭐ **THE BYTE POSITION BEHIND A `StringIndex` THE COMPILER MINTED, OR THE ABSENCE OF ONE.** `0` is the
// answer for every `startIndex()`, so it cannot double as "no answer" — the same reason
// `floatConstBitsOf` refuses to hand back its unseeded slot.
union KnownStringBytePos
	unknown
	position(bytePos FullRangeInt)
end 'KnownStringBytePos'

// ⭐ **WHAT A `String.slice` CALL BECAME.** `notFolded` is a DECISION — the receiver's bytes or a bound was
// not a compile-time fact, or the range was out of the literal — and the caller emits the ordinary call, so
// the runtime path (and its panic) is what an un-folded slice still gets.
union ConstantSliceFold
	notFolded
	folded(literal ValueId)
end 'ConstantSliceFold'

// ⭐⭐ **WHERE THE `startIndex()` / `endIndex()` CALL THAT DEFINED A KNOWN BYTE POSITION WAS APPENDED** —
// filed as the call is emitted, so the fold that makes it garbage can drop it in O(1) instead of hunting
// for it.
//
// ⛔ **THE FIRST CUT HUNTED, AND THE HUNT WAS THE WHOLE BLOCK.** It scanned `opRefs` backwards decoding
// every op, then rebuilt the block's whole `opRefs` array and walked EVERY range-check site the function
// had recorded — three unbounded walks per removed accessor, twice per folded slice, in a block whose
// length GROWS with the number of folds. That is O(F·B + F·S) for F folded slices, i.e. quadratic in one
// function's size. All three walks are bounded here, and by facts rather than by luck:
//
//   * `block` + `blockOpPos` say exactly where the op ref stands, so nothing is searched for.
//   * `opIndex` is the PROOF that it still stands there. Module op indices are minted by append and never
//     reused, so `opRefs[blockOpPos] == opIndex` is identity and not resemblance — and when a `try` fork or
//     a ternary's `detachOpRefsAbove` has moved or truncated the block underneath the record, the compare
//     fails and the removal is DECLINED. A declined removal keeps a correct program that pays one
//     allocation; a removal on a stale position would delete somebody else's op.
//   * `siteMark` is `rangeCheckSites.count()` at the instant the op was appended. A site records
//     `maxonOpPos = bodyOpCount()` in the block it is recorded in, so every site filed BEFORE this op was
//     appended names a position at or below it and cannot be moved by its removal. Only the sites after
//     the mark can, which is `rehomeArmRangeSites`' bounded sub-range for a removal rather than a
//     relocation.
type FoldedIndexCallSite
	export let block as BlockId
	export let blockOpPos as ElementIndex
	export let opIndex as ElementIndex
	export let siteMark as ElementIndex

	static function create(block BlockId, blockOpPos ElementIndex, opIndex ElementIndex, siteMark ElementIndex) returns FoldedIndexCallSite
		return Self{block: block, blockOpPos: blockOpPos, opIndex: opIndex, siteMark: siteMark}
	end 'create'
end 'FoldedIndexCallSite'

// A Map rather than a dense column for `CharLiteralOpMap`'s reason: the population is a function's
// `startIndex()`/`endIndex()` calls ON A LITERAL, which is zero for almost every function. Reset per
// function and SWAPPED across a closure body, exactly like the sibling value columns — a ValueId means
// nothing outside the SSA space that minted it.
typealias FoldedIndexCallSiteMap = Map with (ValueId, FoldedIndexCallSite)

// ⭐ **WHETHER A STRING LITERAL'S BYTES ARE ALL SINGLE-BYTE GRAPHEMES, MEMOIZED PER LITERAL OP.**
// `bytesAreSingleByteGraphemes` is an O(L) scan of the literal, and `sliceLength` asks it at every
// fold site — so K sites cutting windows of one L-byte literal re-scanned it K times, and K and L both
// grow with the source. Asked once per literal here instead.
//
// Keyed by the `stringLiteral` OP rather than by a ValueId, which is why it is NOT reset per function or
// swapped across a closure: op indices are the FILE's and minted by append, so an answer stays true
// until a rewind truncates its op and reissues the index, which drops the answer with it. It is the
// same question about the same bytes wherever it is asked.
typealias SingleByteGraphemeMemo = RewindableMemo with (ElementIndex, bool)

// ⭐⭐ **WHAT THE COMPILER CAN PROVE ABOUT A DIVISOR** — the fallible-division rule's three answers, as
// ONE value rather than as two predicates asked in sequence.
//
// The rule is genuinely three-way (E3103 / bare divide / throwing divide), so two
// booleans — `divisorIsProvablyZero` then `divisorIsProvablyNonZero` — would ask the SAME cascade twice
// (the float-constant arm, then the integer-constant arm, once with `== 0` and once with `!= 0`). Two copies
// of one walk, and worse: nothing but inspection would stop both from answering `true` for the same divisor,
// which is an incoherent verdict the emitter had no arm for. One classification with three variants makes
// that unrepresentable and states the rule in the shape the rule has.
enum DivisorZeroVerdict
	// A folded constant 0 / 0.0 / -0.0. **E3103** — never routed to the throwing path.
	alwaysZero

	// A non-zero folded constant, or a declared ranged type whose range excludes 0. A BARE divide.
	neverZero

	// ⚠ **THE SAFE ANSWER, AND THE ONE EVERY GAP IN THE PROOF MUST FALL TO.** A divisor wrongly called
	// `neverZero` gets an unguarded divide — a hardware trap where a catchable error was promised, with no
	// diagnostic anywhere. One wrongly called `possiblyZero` costs a needless `try`, which the author sees.
	possiblyZero
end 'DivisorZeroVerdict'

// ⭐⭐ **WHAT THE COMPILER CAN PROVE ABOUT A DIVISOR — BOTH HAZARDS, FROM ONE WALK.** `idiv` raises
// `#DE` for two unrelated reasons, and a zero test alone answers only the first, which is how `i64.min mod -1`
// stays fatal on a path the fallible-division rule has already visited and cleared. So the question the
// parser asks about a divisor is *"which of `idiv`'s two divisors can it be?"* rather than *"can it be zero?"*,
// and this is the answer.
//
// ⚠⚠ **THE TWO FACTS ARE INDEPENDENT AND MUST NOT BE MERGED INTO ONE VERDICT.** They do not even decide the
// same KIND of thing:
//
//   • **zero decides FALLIBILITY** — E3103, a bare divide, or a throwing one. It is part of the operation's
//     TYPE, visible in the source as a required `try`.
//   • **`-1` decides only whether a GUARD is emitted.** `a mod -1` is `0`, so it is TOTAL, and a signed `/`
//     panics there only when the dividend may also be `i64.min`: folding this fact into `possiblyZero` would
//     demand a `try` on an operation whose failure is not a throw, and folding it into `neverZero` is
//     exactly the bug. It changes what is EMITTED and nothing about what is allowed.
//
// A divisor can be any combination of the two: `int(-1 to -1)` excludes zero and is always `-1`;
// `int(0 to 100)` admits zero and never `-1`; an opaque `int` is both.
//
// ⚠⚠ **THE COMBINATIONS ARE SPELLED OUT AS AN ENUM RATHER THAN CARRIED IN A TWO-FIELD `type`, AND
// THAT IS A MEASURED CONSTRAINT rather than a style choice.** This is asked once per division AND
// once per bare-local cast to a non-zero alias (`aliasChangesTheDivisionProof`), which is a hot
// parse path — and a Maxon `type` returned by value is a HEAP RECORD: `Self{...}` emits an
// `__mm_alloc` (a two-`Integer` `Pair.create` allocates 16 bytes). A struct there costs
// **+6,146 allocations in `phase:parse` at scale rung
// 5, for a fact that fits in three bits.** `CheckedDivisionKind`'s header states the same rule for
// the same reason one screen away.
//
// Three zero answers times two overflow answers is SIX, and there are FIVE members because the sixth is
// unrepresentable rather than merged away: a divisor proven to be exactly `0` is thereby proven NOT to be
// `-1`, so `provablyZero` paired with "may be `-1`" describes nothing. `divisorProofOf` is the ONE place
// that is written down, and it is why the pair enters through a function rather than being spelled at each
// of the four sites that answer it.
enum DivisorProof
	// A folded constant 0 / 0.0 / -0.0 — **E3103**, whatever the other hazard would have said.
	provablyZero

	// Both hazards closed: the BARE `idiv`, with no check, no branch and no call.
	nonZeroAndNotNegativeOne

	// Proven non-zero but possibly `-1`: a `mod` needs the overflow guard, and a signed `/` the quotient's
	// panic guard wherever its dividend may be `i64.min`, ahead of its bare `idiv`.
	nonZeroButMaybeNegativeOne

	// Possibly zero, proven not `-1`: a THROWING divide, with no overflow guard on either operator.
	maybeZeroButNotNegativeOne

	// ⚠ **NOTHING RULED OUT — THE ANSWER EVERY GAP IN THE PROOF MUST FALL TO**, for `DivisorZeroVerdict`'s
	// stated reason, now doubled: a wrong `nonZeroAndNotNegativeOne` is an unguarded `idiv` where a catchable
	// error or a `0` was promised, with no diagnostic anywhere, while a wrong answer here costs a needless
	// `try` and four instructions — both of which the author can see.
	maybeZeroAndMaybeNegativeOne
end 'DivisorProof'

// The two facts → the one verdict. The ONE place the 3×2 combinations collapse to five, so no caller has to
// know that a refused divisor's overflow hazard is moot.
function divisorProofOf(zero DivisorZeroVerdict, mayBeNegativeOne bool) returns DivisorProof
	match zero 'z'
		alwaysZero then return DivisorProof.provablyZero
		neverZero then return DivisorProof.nonZeroButMaybeNegativeOne if mayBeNegativeOne else DivisorProof.nonZeroAndNotNegativeOne
		possiblyZero then return DivisorProof.maybeZeroAndMaybeNegativeOne if mayBeNegativeOne else DivisorProof.maybeZeroButNotNegativeOne
	end 'z'
end 'divisorProofOf'

function divisorProofOfRange(low FullRangeInt, high FullRangeInt, isFloat bool) returns DivisorProof
	return divisorProofOf(DivisorZeroVerdict.neverZero if rangeExcludesZero(low, high: high, isFloat: isFloat) else DivisorZeroVerdict.possiblyZero, mayBeNegativeOne: not isFloat and not rangeExcludesNegativeOne(low, high: high))
end 'divisorProofOfRange'

union KnownValue
	floatConstant(bits FullRangeInt)
	integerConstant(value FullRangeInt)
	integerInterval(low FullRangeInt, high FullRangeInt)
	rangedAlias(alias RangedTypeAlias)
	unknown
end 'KnownValue'

// An unsigned-topped bound is a raw pattern above `i64.max` that every reader's signed comparisons misread,
// so such an interval with no declared alias to narrow it states nothing.
function knownIntervalWithinAlias(low FullRangeInt, high FullRangeInt, denoted DeclaredAlias) returns KnownValue
	let alias = try requireDeclaredAlias(denoted) otherwise return (KnownValue.unknown if rangeIsUnsignedTopped(low, high: high) else KnownValue.integerInterval(low, high: high))

	if aliasIsFloat(alias) or rangeIsUnsignedTopped(alias.low, high: alias.high) 'theAliasStatesNoSignedInterval'
		return KnownValue.integerInterval(low, high: high)
	end 'theAliasStatesNoSignedInterval'

	if rangeIsUnsignedTopped(low, high: high) 'theIntervalStatesNoSignedInterval'
		return KnownValue.rangedAlias(alias)
	end 'theIntervalStatesNoSignedInterval'

	return KnownValue.integerInterval(alias.low if alias.low > low else low, high: alias.high if alias.high < high else high)
end 'knownIntervalWithinAlias'

union FixedArrayIndexVerdict
	notProven
	proven
	pastTheSize(value FullRangeInt, count FixedElementCount)
end 'FixedArrayIndexVerdict'

export enum FixedArrayAccessor
	get
	set
end 'FixedArrayAccessor'

// @generated library-cache begin
let CacheCasesFixedArrayAccessor = [FixedArrayAccessor.get, FixedArrayAccessor.set]

function cacheReadFixedArrayAccessor(reader LibraryCacheReader) returns FixedArrayAccessor throws LibraryCacheDamage
	let ordinal = try reader.unsigned()

	return try CacheCasesFixedArrayAccessor.get(ordinal as ElementIndex) otherwise throw LibraryCacheDamage.unknownTag(ordinal)
end 'cacheReadFixedArrayAccessor'

function cacheTableAgreesFixedArrayAccessor() returns bool
	let declared = FixedArrayAccessor.allCases

	if CacheCasesFixedArrayAccessor.count() != declared.count() 'differentCount'
		return false
	end 'differentCount'

	for position in 0 upto declared.count() 'eachCase'
		let listed = try CacheCasesFixedArrayAccessor.get(position) otherwise return false
		let expected = try declared.get(position) otherwise return false

		if listed != expected 'anotherCase'
			return false
		end 'anotherCase'
	end 'eachCase'

	return true
end 'cacheTableAgreesFixedArrayAccessor'

function cacheEnumTablesAgreeInCompilerParserStateTypes() returns bool
	if not cacheTableAgreesFixedArrayAccessor() 'disagreesCacheTableAgreesFixedArrayAccessor'
		return false
	end 'disagreesCacheTableAgreesFixedArrayAccessor'

	return true
end 'cacheEnumTablesAgreeInCompilerParserStateTypes'

// @generated library-cache end

function fixedArrayAccessorMethodName(accessor FixedArrayAccessor) returns immutable ByteArray
	return match accessor 'accessor'
		get gives GetMethod
		set gives ArraySetMethod
	end 'accessor'
end 'fixedArrayAccessorMethodName'

export type SizedAccessor
	export let accessor as FixedArrayAccessor
	export let count as FixedElementCount

	static function create(accessor FixedArrayAccessor, count FixedElementCount) returns Self
		return Self{accessor: accessor, count: count}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.accessor.ordinal as CacheUnsigned)
		writer.unsigned(self.count as CacheUnsigned)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns SizedAccessor throws LibraryCacheDamage
		let f_accessor = try cacheReadFixedArrayAccessor(reader)
		let f_count = (try reader.boundedUnsigned(1, high: u32.max)) as FixedElementCount

		return Self{accessor: f_accessor, count: f_count}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(SizedAccessor) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'SizedAccessor'

union FixedArrayAccessProof
	notProven
	proven(accessor SizedAccessor)

	function isProven() returns bool
		return match self 'proof'
			notProven gives false
			proven gives true
		end 'proof'
	end 'isProven'
end 'FixedArrayAccessProof'

function sizedAccessorOf(signatures ProgramSignatures, receiverTag ValueTypeTag, receiverNameId TypeNameId, callee ByteArray) returns SizedAccessor throws AbsentError
	if not signatures.isFixedArrayInstanceAt(receiverTag, nameId: receiverNameId) 'notAFixedArray'
		throw AbsentError.absent
	end 'notAFixedArray'

	let instance = receiverNameId as GenericInstanceId
	let declaration = signatures.genericInstanceBaseName(instance)

	if not signatures.declarationIsASizedContainerRecordNamed(declaration) 'notTheCorpusFixedArray'
		throw AbsentError.absent
	end 'notTheCorpusFixedArray'

	let count = try signatures.genericInstanceFixedCount(instance) otherwise throw AbsentError.absent

	for accessor in FixedArrayAccessor.allCases 'eachAccessor'
		if callee.equals(qualifiedMethodName(declaration, methodName: fixedArrayAccessorMethodName(accessor))) 'theAccessorCalled'
			return SizedAccessor.create(accessor, count: count)
		end 'theAccessorCalled'
	end 'eachAccessor'

	throw AbsentError.absent
end 'sizedAccessorOf'

function fixedArrayIndexVerdictOf(known KnownValue, count FixedElementCount) returns FixedArrayIndexVerdict
	return match known 'known'
		integerConstant(value) gives fixedArrayConstantIndexVerdict(value, count: count)
		integerInterval(low, high) gives fixedArrayRangeIndexVerdict(low, high: high, count: count)
		rangedAlias(alias) gives FixedArrayIndexVerdict.notProven if aliasIsFloat(alias) else fixedArrayRangeIndexVerdict(alias.low, high: alias.high, count: count)
		floatConstant or
		unknown gives FixedArrayIndexVerdict.notProven
	end 'known'
end 'fixedArrayIndexVerdictOf'

function fixedArrayRangeIndexVerdict(low FullRangeInt, high FullRangeInt, count FixedElementCount) returns FixedArrayIndexVerdict
	if low >= 0 and high >= 0 and high < (count as FullRangeInt) 'insideTheSize'
		return FixedArrayIndexVerdict.proven
	end 'insideTheSize'

	return FixedArrayIndexVerdict.notProven
end 'fixedArrayRangeIndexVerdict'

function fixedArrayConstantIndexVerdict(value FullRangeInt, count FixedElementCount) returns FixedArrayIndexVerdict
	if value < 0 'aNegativeConstant'
		return FixedArrayIndexVerdict.notProven
	end 'aNegativeConstant'

	if value >= (count as FullRangeInt) 'pastTheEnd'
		return FixedArrayIndexVerdict.pastTheSize(value, count: count)
	end 'pastTheEnd'

	return FixedArrayIndexVerdict.proven
end 'fixedArrayConstantIndexVerdict'

function fixedArrayAccessorShapeIsExact(accessor FixedArrayAccessor, args ValueIdArray, argLabels NameRoster) returns bool
	let arity = match accessor 'arity'
		get gives FixedArrayGetArgCount
		set gives FixedArraySetArgCount
	end 'arity'

	if args.count() != arity 'wrongArity'
		return false
	end 'wrongArity'

	if not callArgumentLabel(argLabels, argIndex: 0).isEmpty() 'labelledReceiver'
		return false
	end 'labelledReceiver'

	let indexLabel = callArgumentLabel(argLabels, argIndex: 1)

	if not indexLabel.isEmpty() and not indexLabel.equals(FixedArrayIndexLabel) 'foreignIndexLabel'
		return false
	end 'foreignIndexLabel'

	return accessor == FixedArrayAccessor.get or callArgumentLabel(argLabels, argIndex: 2).equals(ArrayValueLabel)
end 'fixedArrayAccessorShapeIsExact'

// The FALLIBILITY half, back out — what the whole fallible-division rule is written in terms of (E3103 / bare / throwing).
function divisorProofZeroVerdict(proof DivisorProof) returns DivisorZeroVerdict
	return match proof 'p'
		provablyZero gives DivisorZeroVerdict.alwaysZero
		nonZeroAndNotNegativeOne or
		nonZeroButMaybeNegativeOne gives DivisorZeroVerdict.neverZero
		maybeZeroButNotNegativeOne or
		maybeZeroAndMaybeNegativeOne gives DivisorZeroVerdict.possiblyZero
	end 'p'
end 'divisorProofZeroVerdict'

// The OVERFLOW half — `mod`'s guard reads it alone, and the signed quotient's guard with the dividend's half.
function divisorProofMayBeNegativeOne(proof DivisorProof) returns bool
	return match proof 'p'
		// `provablyZero` answers `false` as a FACT and not as a default: a divisor proven to be `0` is proven not
		// to be `-1`. (It also never reaches a guard — E3103 refuses it first — so no caller depends on this.)
		provablyZero or
		nonZeroAndNotNegativeOne or
		maybeZeroButNotNegativeOne gives false
		nonZeroButMaybeNegativeOne or
		maybeZeroAndMaybeNegativeOne gives true
	end 'p'
end 'divisorProofMayBeNegativeOne'

// ⭐ **THE ONE CONSTRUCT→DIAGNOSTIC MAPPING for a value-merge type mismatch.** A ternary and a
// match share the merge but not the diagnostic noun: a ternary names its TRUE and FALSE branches by
// position (E2028), a match names the offending arm against the first (E3005). BOTH sides of the
// parse/merge boundary route through here — the parse-time give-type/promotion checks
// (`Parser.valueMergeGiveMismatch`) AND the whole-program fn-signature drain
// (`Queries.checkOneValueMergeSignature`) — so the noun is decided in exactly ONE place. Nothing else
// makes those two sites agree (one keys on `MergeConstruct`, the other on a stored `isTernary` bit, and
// they sit in different files), so a future change to the mapping that touched only one would silently
// diverge the two constructs' diagnostics; keeping it here is what forecloses that. `expectedDisplay` is
// the FIRST branch's already-formatted type, `gotDisplay` the mismatching one.
// ⭐ **THE ONE E2013 "you may not write this name" DIAGNOSTIC**, built from the token that names the
// target. THREE statements raise it and they know three different things — a local binding declared `let`
// (`requireMutableBinding`), a top-level binding that has a slot and still refuses the write
// (`parseTopLevelAssignment`), and a name that resolved to an INLINED top-level constant
// (`rejectNonGlobalAssignment`) — but they are one RULE stated once, and nothing else makes the three agree
// on the payload or the anchor. A fourth site, or a future change to what E2013 says, has one place to go.
//
// It takes the TOKEN, not a name and a position: the three sites all anchor on the token that spells the
// target, and passing the pieces separately is what lets one of them anchor somewhere else by accident.
enum ParameterReassignKind
	valueParameter
	recordParameter
	genericParameter
end 'ParameterReassignKind'

function parameterReassignMessage(name String, kind ParameterReassignKind) returns String
	return match kind 'kind'
		valueParameter gives "'{name}' is a parameter and cannot be reassigned; mark it mutable or copy it into a local var"
		recordParameter gives "'{name}' is a record parameter and cannot be reassigned; copy it into a local var"
		genericParameter gives "'{name}' is a generic parameter and cannot be reassigned; return the new value"
	end 'kind'
end 'parameterReassignMessage'

function parameterReassignError(nameTok Token, kind ParameterReassignKind) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: parameterReassignMessage(String.from(nameTok.value), kind: kind), line: nameTok.line, column: nameTok.column, note: DiagnosticNote.none)
end 'parameterReassignError'

function notATypeError(tok Token) returns SourceParseError
	return SourceParseError.unexpectedToken("a type", got: tokenDisplayText(tok), line: tok.line, column: tok.column)
end 'notATypeError'

union WrittenParameter
	named(name immutable ByteArray)
	positional(position ParamCount)

	function display() returns String
		return match self 'parameter'
			named(name) gives "parameter '{displayParamName(name)}'"
			positional(position) gives "argument {position + 1}"
		end 'parameter'
	end 'display'
end 'WrittenParameter'

function moduleLetCallMessage(name String, callee String) returns String
	return "the initializer of '{name}' calls '{callee}': a module-level or static `let` initializer calls nothing, so write a literal, or build the value where it is used"
end 'moduleLetCallMessage'

function letPassedToMutableParameterMessage(name String, parameter WrittenParameter) returns String
	return match parameter 'parameter'
		named(parameterName) gives "'{name}' is a let and cannot be passed to the `mutable` parameter '{displayParamName(parameterName)}'; bind it to a `var`"
		positional gives "'{name}' is a let and cannot be passed to a `mutable` parameter; bind it to a `var`"
	end 'parameter'
end 'letPassedToMutableParameterMessage'

function unmarkedParameterPassedMessage(name String, parameter WrittenParameter, functionName String) returns String
	return "cannot pass '{name}', which is read-only (a parameter), to a function that writes {parameter.display()} (in {functionName}); pass a `var`"
end 'unmarkedParameterPassedMessage'

function mutableArgumentNeedsAVarError(subject String, parameter WrittenParameter, functionName String, anchor Token) returns SourceParseError
	return SourceParseError.registryRefused(ErrorCode.assignToImmutable, explanation: "cannot pass {subject} to a function that writes {parameter.display()} (in {functionName}); pass a `var`", line: anchor.line, column: anchor.column, note: DiagnosticNote.none)
end 'mutableArgumentNeedsAVarError'

function assignToImmutableError(nameTok Token) returns SourceParseError
	return SourceParseError.assignToImmutable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
end 'assignToImmutableError'

function valueMergeMismatchError(isTernary bool, expectedDisplay String, gotDisplay String, line LineNumber, column ColumnNumber, expectedNote String = "", gotNote String = "") returns SourceParseError
	if isTernary 'ternary'
		return SourceParseError.ternaryValueTypeMismatch(expectedDisplay, trueNote: expectedNote, falseType: gotDisplay, falseNote: gotNote, line: line, column: column)
	end 'ternary'

	return SourceParseError.giveTypeMismatch(gotDisplay, gotNote: gotNote, expected: expectedDisplay, expectedNote: expectedNote, line: line, column: column)
end 'valueMergeMismatchError'

// How control left one arm's body, plus the exit snapshot the merge (or the next arm's
// fallthrough phi) needs. `fellThrough` and `reachesMerge` are mutually exclusive with each
// other and with a terminated exit: an arm either flows to the next arm's body (`and
// fallthrough`), reaches the merge, or TERMINATES — exactly one. Terminating covers every way a
// block can end: `return`/`break`/`continue` in a statement arm, and `panic(…)`/`throws E.case`
// in a DIVERGING expression arm, which is the one shape that terminates while carrying no give.
type MatchArmBody
	export let fellThrough as bool
	export let reachesMerge as bool
	export var exitBlock as IrBlock
	export var exitVals as ValueIdArray
	export var give as MatchGiveValue

	// The E3207 blame this arm's `gives` expression carries, or `unblamed` — `MatchArmExit.blame`'s
	// source, taken while the arm's own tokens are still the ones the cursor last moved over. A
	// STATEMENT arm gives no value and blames nothing, which every such site states rather than
	// inherits from a default.
	export var blame as immutable ByteArray

	static function create(fellThrough bool, reachesMerge bool, exitBlock IrBlock, exitVals ValueIdArray, give MatchGiveValue, blame immutable ByteArray) returns MatchArmBody
		return Self{fellThrough: fellThrough, reachesMerge: reachesMerge, exitBlock: exitBlock, exitVals: exitVals, give: give, blame: blame}
	end 'create'
end 'MatchArmBody'

union ArmDestination
	merged
	returned(anchor Token)
end 'ArmDestination'

// What a parsed match leaves behind: the continuation block control resumes in (`cont`, which
// becomes `currentBlock`), and the value it produced — `none` for a statement match, `value(phi)`
// for an expression match. Both entry points read `cont`; only the expression entry reads `result`.
type MatchOutcome
	export var cont as IrBlock
	export var result as MatchGiveValue

	static function create(cont IrBlock, result MatchGiveValue) returns MatchOutcome
		return Self{cont: cont, result: result}
	end 'create'
end 'MatchOutcome'

// One resolved payload binding of a `walk(dir)` arm: the binding NAME token (`dir`),
// the case FIELD it reads (its declared name + type), the SLOT it occupies, and whether it is the
// discard `_` (which binds nothing). Resolved at pattern-parse time — where the case index and its
// layout are in hand — and consumed by the arm body, which loads each slot out of the scrutinee box.
type PayloadBinding
	export let nameTok as Token
	export let field as PayloadField
	export let slot as PayloadSlotIndex
	export let isDiscard as bool
	export let caseIndex as CaseIndex

	static function bound(nameTok Token, field PayloadField, slot PayloadSlotIndex, caseIndex CaseIndex) returns PayloadBinding
		return Self{nameTok: nameTok, field: field, slot: slot, isDiscard: false, caseIndex: caseIndex}
	end 'bound'

	static function discard(nameTok Token, field PayloadField, slot PayloadSlotIndex, caseIndex CaseIndex) returns PayloadBinding
		return Self{nameTok: nameTok, field: field, slot: slot, isDiscard: true, caseIndex: caseIndex}
	end 'discard'
end 'PayloadBinding'

typealias PayloadBindingArray = Array with PayloadBinding

type ScrutineeStanding
	export let solelyOwned as bool
	let slotsMayBeReadAgain as bool
	let unaliased as bool

	static function create(solelyOwned bool, slotsMayBeReadAgain bool, unaliased bool) returns ScrutineeStanding
		return Self{solelyOwned: solelyOwned, slotsMayBeReadAgain: slotsMayBeReadAgain, unaliased: unaliased}
	end 'create'

	function ownsTheBoxAlone() returns bool
		return self.solelyOwned and not self.slotsMayBeReadAgain
	end 'ownsTheBoxAlone'

	function ownsItsIsolatedPayloads() returns bool
		return (self.solelyOwned or self.unaliased) and not self.slotsMayBeReadAgain
	end 'ownsItsIsolatedPayloads'
end 'ScrutineeStanding'

enum PayloadTake
	movedOut
	consumed
	partRead
	borrowed
end 'PayloadTake'

// ⭐ **THE STRATEGY THRESHOLD — below this many disjoint intervals a `match` dispatches by a linear
// compare chain, at or above it by a balanced binary search.** Three intervals is at most three
// compare-and-branch pairs, cheaper than the compare-per-level a search spends before it reaches a
// leaf; past that the search's logarithmic depth wins. A jump-TABLE tier above a density threshold
// is not emitted here: it needs an `.rdata` table and an indirect jump.
let MinIntervalsForDispatch = 4

// ⭐ **THE DENSE-TABLE DENSITY HEURISTIC — the three caps that decide a jump TABLE is worth its
// `.rdata` slots over a binary search.**
//
// A table COSTS one i32 slot per value in the covered SPAN (min..max) but BUYS the removal of the whole
// compare tree — so the span, not the arm count, is what has to be capped.
//   • `MaxTableSpanSlots` — 4096 slots (a 16 KiB table) is the widest span admitted. The arm64 bounds
//     check materialises this count into a scratch register precisely because 4096 does not fit the CMP
//     imm12 field (`Arm64Backend.arm64EmitJumpTable`).
//   • `MaxTableSlotsPerInterval` — density alone cannot judge a table: four arms 30 apart are 88% dense
//     inside the span cap yet trade 128 mostly-identical slots for the three compares a search removes. A
//     slot budget PER interval removed keeps the table proportional to what it actually buys.
//   • `MinTableDensity{Numerator,Denominator}` — the covered slots must be at least 2/5 (0.4) of the span,
//     or the search — whose cost follows the interval COUNT, not the span — wins.
let MaxTableSpanSlots = 4096 as FullRangeInt
let MaxTableSlotsPerInterval = 32
let MinTableDensityNumerator = 2
let MinTableDensityDenominator = 5

// ⭐ **ONE NORMALIZED DISPATCH KEY — a closed value interval `[lo, hi]` and the arm body it
// selects.** A `match` over an integer-like scrutinee (an enum/union tag, a scalar
// `int`/`char`/`bool`, a ranged-int alias) is lowered by first reducing every arm to a list of
// these: a single value is `[v, v]`, a range is `[lo, hi]`, an `or`-list contributes one interval
// per alternative, and an open bound is `i64.min`/`i64.max`. `targetBlockId` is the arm body the
// interval selects; `edgeArgs` are the carried-variable phi arguments the dispatch's test→body edge
// passes (empty when the body has no phis). `normalizeDispatchIntervals` sorts these and clips
// overlaps so earlier arms win, and the strategy chooser (`emitDispatchRange`) reads nothing else —
// so the shape of a `match` is written down ONCE (this list) rather than recognised back out of an
// already-emitted compare chain.
type DispatchInterval
	export var lo as FullRangeInt
	export var hi as FullRangeInt
	export var targetBlockId as BlockId

	// Mutable because the arm loop knows an interval's body before it knows the carried-var phi args
	// that ride the edge into it: the intervals are collected as the pattern is parsed, then the whole
	// arm's edge args are stamped across them once `setupFallthroughTargetPhis`/`restoreBindings` has run.
	export var edgeArgs as ValueIdArray

	static function create(lo FullRangeInt, hi FullRangeInt, targetBlockId BlockId, edgeArgs ValueIdArray) returns DispatchInterval
		return Self{lo: lo, hi: hi, targetBlockId: targetBlockId, edgeArgs: edgeArgs}
	end 'create'
end 'DispatchInterval'

typealias DispatchIntervalArray = Array with DispatchInterval

type DispatchMiss
	export var targetBlockId as BlockId
	export var edgeArgs as ValueIdArray

	// True only when every subject value lies in some interval (an exhaustive match with no `default`);
	// `emitDispatchChain` then omits its last interval's test, so a subject outside every interval would
	// take that interval's arm.
	export var isUnreachable as bool

	static function create(targetBlockId BlockId, edgeArgs ValueIdArray, isUnreachable bool) returns DispatchMiss
		return Self{targetBlockId: targetBlockId, edgeArgs: edgeArgs, isUnreachable: isUnreachable}
	end 'create'
end 'DispatchMiss'

// Stamp every interval one arm contributed — `intervals[from…]` — with the block its dispatch edge enters and
// the phi args that ride the edge. An or-arm or a split range reaches one arm through several intervals.
function retargetArmIntervals(intervals DispatchIntervalArray, from ElementIndex, targetId BlockId, args ValueIdArray)
	for k in from upto intervals.count() 'eachInterval'
		let interval = try intervals.get(k) otherwise panic("retargetArmIntervals: intervals.get OOB at {k} on a range walked to the array's own count")
		interval.targetBlockId = targetId
		interval.edgeArgs = args
	end 'eachInterval'
end 'retargetArmIntervals'

// The verdict of the density heuristic over `intervals[from, to)`: whether a jump table is worth it, and if
// so its `bias` (the minimum lo — subtract it and slot `i` is biased value `i`) and its `span` (the slot
// count, min..max inclusive). `isTable` false leaves the other two unread. Top-level (not nested in
// `Parser`), like `DispatchInterval` — the density planner returns it out of the parser's dispatch methods.
type DispatchTablePlan
	export let isTable as bool
	export let bias as FullRangeInt
	export let span as FullRangeInt

	static function notTable() returns DispatchTablePlan
		return Self{isTable: false, bias: 0, span: 0}
	end 'notTable'

	static function tableWith(bias FullRangeInt, span FullRangeInt) returns DispatchTablePlan
		return Self{isTable: true, bias: bias, span: span}
	end 'tableWith'
end 'DispatchTablePlan'

typealias FixedDispatchIndexArray = FixedArray with ElementIndex

// A permutation of `raw` interval positions — the sort order and the min-heap `normalizeDispatchIntervals`
// sweeps with. An entry is an index into the arm-order `raw` array, and because the raw array is built in
// arm order that index IS the arm PRIORITY (lower = earlier arm = wins an overlap), so the heap orders by
// the stored value directly.
typealias DispatchIndexArray = Array with ElementIndex

// The single-value patterns a `match` has already seen, for the duplicate-pattern check (E2027). A hash
// set, not a list: the check tests membership once per point arm, so a list makes a match of K distinct
// point arms — a keyword or bytecode dispatch table, the shape a big `match` IS — Θ(K²). Membership is the
// only thing asked of it (add, and "have I seen this?"), which is exactly a set's contract.
typealias SeenPatternValues = Set with FullRangeInt

typealias NamedSlotIndexArray = Array with ElementIndex

function solveFixedElementCountNeeds(methodNames NameRoster, seeds DescriptorNeedMap, callees SelfCalleesMap, needing DescriptorNeedNameSet)
	let methodCount = methodNames.count()
	let nameToIndex = MethodIndexMap.create()

	for i in 0 upto methodCount 'index'
		nameToIndex.upsert(try methodNames.get(i) otherwise panic("solveFixedElementCountNeeds: methodNames.get({i}) OOB below count {methodCount}"), value: i as CsrIndex)
	end 'index'

	let seeded = BoolArray.create(methodCount, zeroed: false)

	for i in 0 upto methodCount 'seed'
		seeded.push(try seeds.get(try methodNames.get(i) otherwise panic("solveFixedElementCountNeeds: methodNames.get({i}) in seed")) otherwise false)
	end 'seed'

	let edgeCallee = CsrColumn.create(0)
	let edgeCaller = CsrColumn.create(0)

	for i in 0 upto methodCount 'edges'
		for calleeName in calleesOf(methodNames, selfCallees: callees, callerIndex: i) 'edge'
			if let c = try nameToIndex.get(calleeName) 'realEdge'
				edgeCallee.push(c)
				edgeCaller.push(i as CsrIndex)
			end 'realEdge'
		end 'edge'
	end 'edges'

	let reaching = reverseReachabilityMark(buildCsr(edgeCallee, to: edgeCaller, nodeCount: methodCount as CsrIndex), seeds: seeded)

	for i in 0 upto methodCount 'publish'
		if (try reaching.get(i) otherwise panic("solveFixedElementCountNeeds: reaching.get({i}) in publish")) 'carriesOne'
			needing.insert(try methodNames.get(i) otherwise panic("solveFixedElementCountNeeds: methodNames.get({i}) in publish"))
		end 'carriesOne'
	end 'publish'
end 'solveFixedElementCountNeeds'

// The sibling methods `methodNames[callerIndex]` calls on `self` — the forward self-call edges out of one
// method.
//
// ⚠ **PANIC, NOT AN EMPTY LIST.** A miss is not "this method calls nothing" — it is
// impossible: `scanFixedElementCountNeedsInto` writes the seed, the callee row and the name in one act, so every
// entry of `methodNames` has a row here. Answered with a fresh empty array it would be a method silently
// stripped of its self-call edges, which under-reserves an ABI parameter and aborts the compiler two passes
// later with no position — the exact failure this fixpoint exists to prevent, wearing a default value's face.
function calleesOf(methodNames NameRoster, selfCallees SelfCalleesMap, callerIndex ElementIndex) returns NameRoster
	let caller = try methodNames.get(callerIndex) otherwise panic("calleesOf: methodNames.get({callerIndex}) OOB")
	return try selfCallees.get(caller) otherwise panic("calleesOf: '{String.from(caller)}' is in `methodNames` with no `selfCallees` row — `scanFixedElementCountNeedsInto` writes both in one act")
end 'calleesOf'

// An instance method's SOURCE parameter names with the receiver prepended — the call-aligned list every
// by-name sweep fact is indexed by, so `bits[i]` / `direct[i]` name the same slot a receiver-prepending call
// site does. Shared by the two callers that need the alignment (`callAlignedInstanceParams` for the
// transitive array-feed scan, `sweptParamNamesFor` for the declaration sweep), because an alignment written
// twice is two chances to disagree about where `self` sits.
function callAlignedFrom(sourceNames NameRoster) returns NameRoster
	let paramNames = NameRoster.create(sourceNames.count() + 1, zeroed: false)
	paramNames.push(SelfParamName)

	for sourceName in sourceNames 'eachSource'
		paramNames.push(sourceName)
	end 'eachSource'

	return paramNames
end 'callAlignedFrom'

// ⭐⭐ **THE ONE PARAMETER-NAME LIST THE DECLARATION SWEEP WALKS A BODY WITH — call-aligned, and the same for
// every declaration shape.** A receiver-less declaration's SOURCE names already are its call-aligned ones; an
// instance method's need `self` at slot 0 whether or not its type is generic. Both facts the sweep reads off
// a body's parameters — what it CONSUMES and what it takes BY REFERENCE — are therefore indexed in one space,
// which is what stops them disagreeing about where `self` sits.
//
// ⛔⛔ **AN INSTANCE METHOD'S PARAMETERS ARE ON IT TOO, AND A PROMISE IS WHY.** A method that awaits the
// promise it is handed owns it, so the caller must move it in — and that ownership is settled from this list
// BEFORE the body is parsed, so a list stopping at the receiver-less shapes refuses the program at its own
// `await` (`requireConsumedPromiseIsOwned`, E3141) while the identical free function compiles. The other
// consume door is indifferent either way: a direct `Self{f: p}` store in an instance method is co-ownership
// rather than a move, which is what `detectFieldStores: false` says at the call site.
//
// A method with no user parameters keeps the empty list rather than `self` alone: no source token can spell
// `__self`, so the entry would buy only the walk's own bracket bookkeeping.
function sweptParamNamesFor(sourceParamNames NameRoster, takesReceiver bool, selfCapability ParamCapability) returns NameRoster
	if not takesReceiver or (sourceParamNames.count() == 0 and selfCapability != ParamCapability.consuming) 'alreadyCallAligned'
		return sourceParamNames
	end 'alreadyCallAligned'

	return callAlignedFrom(sourceParamNames)
end 'sweptParamNamesFor'

// ⭐⭐ **WHERE THE VALUE `noteReturnedGlobalOrForward` IS READING ENDS — THE ONLY THING ITS TWO DOORS DIFFER
// IN.** The recogniser's whole rule is "the statement must be NOTHING BUT the shape", so every arm of it asks
// *"and does the region stop right here?"*; a `return` statement's value stops at the end of its LINE, and a
// captured PARAMETER DEFAULT's stops at the `,`/`)` the sweep has already walked to (`paramItemEndFrom`).
//
// ⚠ **THE DEFAULT DOOR HANDS ITS END OVER RATHER THAN LETTING THE RECOGNISER RE-DERIVE ONE.** "A `,` or a
// `)` ends it" is very nearly right and is not exactly right — `= f(a, b)` holds both inside its own parens —
// and the capture has ALREADY decided where the author's default ends. A second walk is a second answer; this
// file has paid for that twice (see `sweptParamDefaultHelperName`, and `PendingDefaultHelper.exprEnd`).
union SweptValueRegionEnd
	// A `return` statement: the value runs to the end of the line, which the body walk never has to compute.
	atLineEnd

	// A captured parameter default: the value runs to exactly this token, which is the `,` or `)` the
	// parameter-list walk stopped at.
	atToken(index ElementIndex)
end 'SweptValueRegionEnd'

// The `atLineEnd` answer, shared: a payload-free union case is still a heap object in Maxon, and the return
// door asks this question at every `return` statement in the program.
let sharedSweptValueLineEnd = SweptValueRegionEnd.atLineEnd

// ⭐ **DOES A TOKEN OF THIS KIND BIND THE NAME THAT FOLLOWS IT?** — the generous binder test
// `Parser.returnedNamesNotBoundHere` filters a swept return candidate through; see there for the full
// argument, including why `(` and `,` are in the list although a call argument is no binder at all. It is a
// free function beside `noteForwardCall` because, like it, it reads nothing but its argument.
function kindBindsTheNameAfterIt(kind TokenKind) returns bool
	return bindingKeywordSpells(kind) or kind == TokenKind.for or kind == TokenKind.leftParen or kind == TokenKind.comma
end 'kindBindsTheNameAfterIt'

// Record one seed candidate on the three parallel columns AT ONCE — the name as it is looked up, the HEAD
// segment the shadowing filter matches on, and the token index the returned VALUE starts at. One door
// rather than three pushes at each of the four recording sites: the columns are parallel by construction and
// every reader's panic says so, and a site that pushed two of the three would desynchronize the third
// silently.
//
// ⚠ **THE POSITION IS THE VALUE'S FIRST TOKEN, WHERE IT USED TO BE THE `return` KEYWORD'S, AND THE
// SHADOWING FILTER CANNOT TELL THE TWO APART.** `markBoundHead` shadows a candidate when the binder sits at
// or before this index, so moving it one token later could only newly admit a binder recorded AT the value's
// own first token — and none ever is: a binder is recorded where `kindBindsTheNameAfterIt` holds of the
// PRECEDING token, which for a returned value is `return`, a keyword that binds nothing. What the move buys
// is that the recogniser needs no anchor beside the region it is already given, which is what lets a
// captured parameter default — where there is no `return` keyword at all — go through the same door.
function noteReturnedCandidate(returnedNames NameRoster, returnedHeads NameRoster, returnedAt TokenIndexArray, name ByteArray, head ByteArray, valueStart ElementIndex)
	returnedNames.push(name)
	returnedHeads.push(head)
	returnedAt.push(valueStart)
end 'noteReturnedCandidate'

// ⭐⭐ **MARK EVERY RETURNED CANDIDATE THIS BINDER SHADOWS — and a binder shadows only what comes AFTER it.**
// One name can head more than one candidate (`Box.shared` and `Box.other` from two `return`s), so the walk is
// over all of them rather than a lookup.
//
// ⛔⛔ **THE POSITION TEST IS THE WHOLE OF WHY THE GENEROUS BINDER SET IS SAFE TO KEEP, AND IT WAS
// MISSING.** `returnedNamesNotBoundHere`'s own header records that the binder set deliberately
// admits plain call ARGUMENTS, which bind nothing — and calls the resulting dropped seed acceptable
// because it costs only a refusal. It is reached by a function that returns a name BARE on one path and
// passes that same name as an ARGUMENT on the next line, so a position-blind walk marks the candidate bound
// and refuses the return on a legal program.
//
// ⭐ **THE CURE IS POSITION, NOT SHAPE, AND THAT DISTINCTION IS LOAD-BEARING.** Narrowing the binder SET is
// what that header warns against, and it is right to: a `match` payload `case(a, b)` is character for
// character a call, so no token test can separate the two. Position needs no such test and is EXACT for the
// question actually being asked — a name cannot resolve to a local at a `return` that precedes the local's
// own declaration, because such a program does not compile at all. So requiring the binder to come FIRST can
// only drop FALSE shadowings; it cannot miss a real one, and the set stays as generous as it was.
function markBoundHead(returnedHeads NameRoster, bound BoolArray, returnedAt TokenIndexArray, name ByteArray, binderIndex ElementIndex)
	for i in 0 upto returnedHeads.count() 'eachCandidate'
		if not (try returnedHeads.get(i) otherwise panic("markBoundHead: returnedHeads.get({i}) OOB below its own count")).equals(name) 'otherHead'
			continue
		end 'otherHead'

		if binderIndex > (try returnedAt.get(i) otherwise panic("markBoundHead: returnedAt.get({i}) OOB — the columns are parallel by construction")) 'bindsAfterTheReturn'
			continue
		end 'bindsAfterTheReturn'

		try bound.set(i, value: true) otherwise panic("markBoundHead: bound.set({i}) OOB — the columns are parallel by construction")
	end 'eachCandidate'
end 'markBoundHead'

typealias MemberHopCount = int(0 to u32.max)

let HopsToCallOnAField = 2

// A name a `return` hands back, and what `Parser.everyReturnedLocalHoldsAFreshRecord`'s walk has learned of
// it: whether its one binding has been met, and whether the walk is still inside that binding's scope.
type ReturnedLocal
	export let name as immutable ByteArray
	export var bound = false
	export var inScope = false
	var scopeDepth = 0 as BlockDepth

	static function create(name ByteArray) returns ReturnedLocal
		return Self{name: name}
	end 'create'

	function bind(depth BlockDepth)
		self.bound = true
		self.scopeDepth = depth
		self.inScope = true
	end 'bind'

	// The walk has left the block the binding was written in once its depth falls below the binding's own.
	function closeScopeAbove(depth BlockDepth)
		if self.inScope and depth < self.scopeDepth 'leftTheBindingsBlock'
			self.inScope = false
		end 'leftTheBindingsBlock'
	end 'closeScopeAbove'
end 'ReturnedLocal'

typealias ReturnedLocalArray = Array with ReturnedLocal

enum ReturnedLocalBinding
	freshRecord
	fieldMoveOut
end 'ReturnedLocalBinding'

function namesIncludeAParameter(names NameRoster, paramNames NameRoster) returns bool
	for name in names 'eachName'
		if paramNames.contains(name) 'aParameter'
			return true
		end 'aParameter'
	end 'eachName'

	return false
end 'namesIncludeAParameter'

// Keeps one entry per open `(`, `{` or `[`, true for a `[`.
function trackGroupKindAt(kind TokenKind, openGroupIsBracket BoolArray)
	if tokenKindOpensABracket(kind) 'opens'
		openGroupIsBracket.push(kind == TokenKind.leftBracket)
	end 'opens'

	if tokenKindClosesABracket(kind) and openGroupIsBracket.count() > 0 'closes'
		_ = try openGroupIsBracket.pop() otherwise panic("trackGroupKindAt: pop failed on a stack whose count was just read as non-zero")
	end 'closes'
end 'trackGroupKindAt'

// A `name:` is a call's or a record literal's label only inside a `(` or a `{`.
function innermostGroupSpellsLabels(openGroupIsBracket BoolArray) returns bool
	if openGroupIsBracket.count() == 0 'noOpenGroup'
		return false
	end 'noOpenGroup'

	return not (try openGroupIsBracket.get(openGroupIsBracket.count() - 1) otherwise panic("innermostGroupSpellsLabels: get failed on a stack whose count was just read as non-zero"))
end 'innermostGroupSpellsLabels'

// A forward whose target is looked up by a written name, with that name and its position on the parallel
// columns `Parser.noForwardHeadIsBoundHere` filters — pushed together so the columns cannot desynchronize.
function noteForwardResolvedByName(forwards FreshReturnForwardArray, forward FreshReturnForward, forwardHeads NameRoster, forwardHeadsAt TokenIndexArray, headAt ElementIndex, head ByteArray)
	forwards.push(forward)
	forwardHeads.push(head)
	forwardHeadsAt.push(headAt)
end 'noteForwardResolvedByName'

// Record a forwarding edge, de-duplicated. The list is per BODY and a body forwards to a handful of names,
// so a linear membership test beats a set's allocation — the same trade `captureSlotFor` makes one column over.
//
// ⚠ **THE SHAPE IS PART OF THE IDENTITY.** A body that writes both `swap(x)` and `self.swap(x)` states two
// DIFFERENT edges — they reach different node families — so de-duplicating on the name alone would drop one
// of them, and which one it dropped would depend on the order the tokens happen to appear in.
function noteForwardCall(calls ForwardCallArray, call ForwardCall)
	for existing in calls 'each'
		if forwardCallsAreEqual(existing, b: call) 'alreadyRecorded'
			return
		end 'alreadyRecorded'
	end 'each'

	calls.push(call)
end 'noteForwardCall'

function receiverKeywordNamesTheEnclosingType(kind TokenKind) returns bool
	return kind == TokenKind.self or kind == TokenKind.selfType
end 'receiverKeywordNamesTheEnclosingType'

// --- `"{n:08x}"`, `"{f:8.2}"`, `"{c:verbose}"`: A FORMAT SPECIFIER ---

union InterpFormat
	plain

	// Did the author write a `:` at all? Distinct from an EMPTY specifier (`"{x:}"`), which is a
	// specifier the author wrote and which a `FormattedStringable` still receives.
	specified(spec InterpFormatSpec)

	function spec() returns InterpFormatSpec throws AbsentError
		match self 'format'
			plain then throw AbsentError.absent
			specified(spec) then return spec
		end 'format'
	end 'spec'
end 'InterpFormat'

union FormatPrecision
	shortest
	decimals(count FormatFieldWidth)

	function decimalCount() returns FormatFieldWidth throws AbsentError
		match self 'precision'
			shortest then throw AbsentError.absent
			decimals(count) then return count
		end 'precision'
	end 'decimalCount'
end 'FormatPrecision'

// ⭐⭐ **THE SPECIFIER IS READ ONCE, HERE, INTO THE COMPILE-TIME CONSTANTS THE RENDERERS TAKE.**
// `stdlib/Builtins.maxon`'s `__int_toStringFormatted` / `__float_toStringPadded` /
// `__float_toStringFixed` take a width, a fill, a base and a signedness as ARGUMENTS and read no
// text — so the text is given its meaning at exactly one place in the compiler, and nothing
// downstream carries a specifier it might interpret a second way. Keeping the raw string on the
// interpolation part and re-reading it during lowering instead needs an internal-error arm for
// "this integer part still carries a format spec".
//
// ⚠ **`text` OUTLIVES THE NUMERIC READING BECAUSE ONE CONSUMER IS NOT NUMERIC.** A user type
// implementing `FormattedStringable` receives the specifier VERBATIM as a `String` argument
// (`"{c:verbose}"` → `c.toString("verbose")`), so the bytes are part of the parsed form rather than
// something the parse consumes.
//
// ⭐ **ONE PREFIX GRAMMAR FOR BOTH NUMERIC FAMILIES, WHICH IS A DEPARTURE FROM THE BOOTSTRAP.** It
// has two readers, `ParseIntegerFormatSpec` (`[0][width][base]`) and `ParseFloatFormatSpec`
// (`[0][width][.precision]`), which differ in ONE decision: the float one refuses to read a leading
// `0` as the fill unless a second character follows it that is not `.`. That distinction cannot be
// observed — it only ever fires where the width is 0, and a zero-wide field pads nothing whichever
// fill it names — so the two readings agree on every program and this reads the prefix once.
//
// ⚠ **THE TAILS SHARE A POSITION, AND THAT IS DELIBERATE RATHER THAN INCIDENTAL.** A base letter is
// meaningless to a float and a `.precision` is meaningless to an integer, so each family reads only
// the field it understands — but BOTH read it at the same index, the one right after the width.
// Reading the precision first and then looking for the base at the position it left would make the
// effective integer grammar `[0][width][.precision][base]`, under which `"{n:8.2x}"` would read as
// hexadecimal where it means decimal. The base is therefore taken at `tailStart`, before the
// precision scan moves anything.
type InterpFormatSpec
	// The bytes between `:` and `}`, exactly as written.
	export let text as immutable ByteArray
	export let zeroFill as bool
	export let width as FormatFieldWidth

	// A float renders with EXACTLY this many decimals when the specifier gave one. Absent is not
	// "zero": `"{f:8}"` is the language's own spelling of the value right-aligned, and defaulting it
	// to a number of decimals is what would let a WIDTH silently change the DIGITS.
	export let precision as FormatPrecision
	export let halfRadix as FormatHalfRadix
	export let uppercase as bool

	// Does this base spell a sign? Only decimal does — `x`, `X`, `o` and `b` spell the bit pattern,
	// which is what makes `"{allBits:x}"` on `0 - 1` say `ffffffffffffffff` rather than `-1`.
	export let spellsASign as bool
	export let quotes as bool

	// Read the specifier's text into the constants above. `tok` is the specifier token, which
	// positions the one diagnostic this can raise.
	static function parse(tok Token) returns Self throws SourceParseError
		let text = tok.value

		// A leading `0` is the FILL, never the width's first digit. The two readings can only
		// differ where the width is 0, and a zero-wide field pads nothing under either fill.
		let zeroFill = Self.byteIs(text, index: 0, marker: b"0")
		var pos = 0 as ByteOffset

		if zeroFill 'fillIsNotAWidthDigit'
			pos = 1
		end 'fillIsNotAWidthDigit'

		let widthEnd = Self.digitsEnd(text, from: pos)
		let width = try Self.number(text, from: pos, to: widthEnd, tok: tok)

		// ⭐ **BOTH TAILS READ FROM HERE — see the header.** The base is taken at `tailStart` rather than
		// after the precision scan, so a precision cannot move the position the base is read from.
		let tailStart = widthEnd

		var precision = FormatPrecision.shortest

		if Self.byteIs(text, index: tailStart, marker: b".") 'precisionFollows'
			let precisionStart = tailStart + 1
			precision = FormatPrecision.decimals(try Self.number(text, from: precisionStart, to: Self.digitsEnd(text, from: precisionStart), tok: tok))
		end 'precisionFollows'

		let halfRadix = Self.halfRadixAt(text, index: tailStart)

		return Self{text: text, zeroFill: zeroFill, width: width, precision: precision, halfRadix: halfRadix, uppercase: Self.byteIs(text, index: tailStart, marker: b"X"), spellsASign: halfRadix == DecimalHalfRadix, quotes: Self.byteIs(text, index: tailStart, marker: QuotingSpecifierLetter)}
	end 'parse'

	// ⭐ **A LETTER THAT NAMES NO BASE MEANS DECIMAL, AND THAT IS THE CONTRACT — NOT AN UNHANDLED
	// CASE.** A specifier's meaning depends on the type it decorates, and a user type implementing
	// `FormattedStringable` may define any spelling it likes (`"{c:verbose}"`). Every such specifier
	// passes through this reader on its way to that type, so refusing an unrecognized letter here
	// would refuse them. A specifier that RAN OUT names no base either, and means the same thing.
	// Both references take this view.
	static function halfRadixAt(text ByteArray, index ByteOffset) returns FormatHalfRadix
		let base = try text.get(index) otherwise return DecimalHalfRadix

		if base == 'x' or base == 'X' 'hexadecimal'
			return HexHalfRadix
		end 'hexadecimal'

		if base == 'o' 'octal'
			return OctalHalfRadix
		end 'octal'

		if base == 'b' 'binary'
			return BinaryHalfRadix
		end 'binary'

		return DecimalHalfRadix
	end 'halfRadixAt'

	// Is `text[index]` this byte? Answers `false` past the end, which is the reading every caller
	// wants: a specifier that stopped has not written the byte being asked about.
	//
	// ⚠ **THE MARKER IS A ONE-BYTE BYTE STRING BECAUSE IT IS PASSED, NOT COMPARED.** `halfRadixAt`
	// three lines up writes `base == 'x'` and `number` writes `b - '0'`, and both are correct: a
	// character LITERAL coerces against a `Byte` in an expression. What it cannot do is cross a
	// parameter — `'0'` is a `Character`, a struct, and `'0' as Byte` is `E3009: Cannot cast from
	// struct to int`. `b"0"` reads the same at the call site and is the right type;
	// `primitiveStaticSourceSpelling` takes its separator out of a one-byte `b""` for this reason.
	static function byteIs(text ByteArray, index ByteOffset, marker ByteArray) returns bool
		let here = try text.get(index) otherwise return false
		return here == (try marker.get(0) otherwise panic("InterpFormatSpec.byteIs: marker '{String.from(marker)}' is not one byte"))
	end 'byteIs'

	// Index of the first byte at or after `from` that is not a decimal digit — the end of a width or
	// a precision, and `from` itself when neither was written. The digit test is the LEXER's
	// (`Lexer.isDigit`), which is the same question about a different run of bytes.
	static function digitsEnd(text ByteArray, from ByteOffset) returns ByteOffset
		var stop = from

		while stop < text.count() as ByteOffset 'scan'
			if not isDigit(try text.get(stop) otherwise panic("InterpFormatSpec.digitsEnd: text.get OOB at {stop} inside its own count()")) 'notADigit'
				return stop
			end 'notADigit'

			stop = stop + 1
		end 'scan'

		return stop
	end 'digitsEnd'

	// The number the digits in `[from, to)` spell. An empty run is 0 — a specifier that named no
	// width asked for no field, which is what a width of 0 means to every renderer.
	//
	// ⚠ **THE ACCUMULATOR IS WIDER THAN THE RESULT ON PURPOSE.** A digit run can walk past the bound
	// (and past an i64) long before it ends, so the running value is a `FullRangeInt` tested at every
	// step rather than a `FormatFieldWidth` that would trap inside the multiply.
	//
	// ⚠ **THE GUARD AND THE NARROWING `as` BELOW ARE THE SAME BOUND READ TWICE**, and a disagreement
	// between them is not a wrong answer but a compiler PANIC where an E2011 belongs. The two cannot
	// be joined syntactically (see `MaxFormatFieldWidth`, which records both attempts and their
	// diagnostics); what holds them together is that the constant is DECLARED at `FormatFieldWidth`,
	// so narrowing the type without narrowing the constant fails to build.
	static function number(text ByteArray, from ByteOffset, to ByteOffset, tok Token) returns FormatFieldWidth throws SourceParseError
		var value = 0 as FullRangeInt
		var i = from

		while i < to 'eachDigit'
			let b = try text.get(i) otherwise panic("InterpFormatSpec.number: text.get OOB at {i} — `digitsEnd` bounded `to` by count()")
			value = value * 10 + ((b - '0') as FullRangeInt)

			if value > (MaxFormatFieldWidth as FullRangeInt) 'pastTheBound'
				throw SourceParseError.formatFieldOverflow(String.from(text), line: tok.line, column: tok.column)
			end 'pastTheBound'

			i = i + 1
		end 'eachDigit'

		return value as FormatFieldWidth
	end 'number'
end 'InterpFormatSpec'

// ⛔⛔ **THESE TWO BOUNDS MUST EQUAL `stdlib/Builtins.maxon`'s, AND NOTHING CAN CHECK THAT.**
// `FormatFieldWidth` is the compiler's ACCEPTANCE bound and `PadWidth`/`DecimalPrecision`
// (`Builtins.maxon:1719-1735`) are the stdlib PARAMETER bound; `FormatHalfRadix` and `HalfRadix`
// (`:1843`) are the same pair one column over. `materializeFormattedIntPart` emits literals of the
// former straight into parameters of the latter.
//
// **They cannot be joined under one name, and the reason is not tidiness — it is that the two are
// SEPARATELY COMPILED ARTIFACTS.** The compiler's own source declares its types (`FullRangeInt` lives in
// `NumberParsing.maxon`, not in stdlib, for exactly this reason), and the stdlib a compile emits
// calls INTO is whichever tree the user's program loads — not the one this binary was built against.
// A shared typealias would bake THIS build's bound into a call resolved against THAT one, which is
// the same disagreement wearing a single name.
//
// ⇒ **So it is a contract, and here is which way it breaks.** NARROW stdlib's below the compiler's
// and neither tree fails to build: the compiler goes on accepting `"{n:4294967295}"` and minting that
// literal, and the failure lands as a **runtime range panic inside every emitted program that formats
// a number** past the new bound. WIDEN stdlib's and the cost is only an over-refusal — E2011 on a
// program stdlib could have served. The dangerous direction is the narrowing one, and it is silent.
typealias FormatFieldWidth = int(0 to u32.max)

// HALF of the base, which is the form `stdlib`'s `__unsignedDigitStep` takes — see there for why
// halving the 64-bit pattern before dividing is what lets one signed division serve every base and
// still convert a value with bit 63 set.
typealias FormatHalfRadix = int(1 to 8)

let DecimalHalfRadix = 5
let HexHalfRadix = 8
let OctalHalfRadix = 4
let BinaryHalfRadix = 1

let QuotingSpecifierLetter = b"q"
let QuotedTextMethodName = b"toQuoted"

// ⭐⭐ **DECLARED AT `FormatFieldWidth`, WHICH IS WHAT MAKES THE PAIR ABOVE CHECKED RATHER THAN
// MERELY ADJACENT.** `InterpFormatSpec.number` tests its accumulator against this and then narrows
// with an `as` — safe only while the guard and the range name the same number. Neither direction of
// the obvious join compiles: a range bound admits only a literal or `type.max`
// (**`E2010: Expected numeric literal, 'min', 'max', or 'type.min'/'type.max' in range bound`** for
// `int(0 to MaxFormatFieldWidth)`), and a ranged typealias has no `.max` accessor to read back
// (**`E3003: 'FormatFieldWidth' is a type and cannot be used directly as a value`**). Both were
// tried. What IS expressible is this: giving the constant the NARROW type makes the compiler check
// that the bound fits it, so narrowing `FormatFieldWidth` without touching this line is a build
// failure here instead of a guard that admits a value the `as` then panics on — the E2011 this code
// exists to raise, turned into a compiler crash.
//
// Exported because the diagnostic quotes it (`Queries.parseErrorDiagnostic`): a limit named at an
// author must be the limit that fired.
let MaxFormatFieldWidth = u32.max as FormatFieldWidth

// ⭐⭐ **WHAT A DECLARED TYPE'S STATIC ROSTER SAYS ABOUT `<Type>.<member>` ONCE EVERY ARM THAT COULD HAVE
// CLAIMED THE FORM HAS DECLINED IT** — `Parser.staticRosterVerdictFor`, asked by the READ door
// (`parseDottedPrimary`) and the STORE door (`parseStatement`) so they cannot answer one program
// differently.
//
// The caller has to tell "not mine" from the refusals, and the refusals differ in code and in sentence: a
// missing member is E2073, a hidden one E3008, and a method or requirement written
// without its call E2078, or E2013 when it is stored to.
//
// The READ door refuses every refusal; the STORE door refuses all but `undeclaredMember`.
union StaticRosterVerdict
	// The base names no type whose roster this reads, or a directory function, or the member half is not a
	// name. Some other arm's business, and the answer for every sized-type bound (`u64.max`) on this path.
	notADeclaredTypeMember

	// The type declares no static member of that name.
	undeclaredMember

	// The type declares the member and this file may not read it.
	hidden(tier Visibility)

	declaredMethod

	declaredInstanceMethod

	hiddenMethod(tier Visibility)

	refused(refusal SourceParseError, readsAsAMethod bool)

	requirement(interfaceName ByteArray)
end 'StaticRosterVerdict'

enum StaticMemberUse
	read
	store
end 'StaticMemberUse'

// ⭐⭐ **THE THREE `<Type> from <literal>` SUGARS, WHICH DIFFER IN EXACTLY TWO FACTS.** All desugar to the
// type's own `init` static and share every other rule — the arity and argument checks, the ownership of the
// returned struct, the E3004 for a type with no `init`. What a form decides is the TOKEN it claims and the
// CONFORMANCE its site requires, and those are the functions beneath it.
enum LiteralInitForm
	// `FilePath from "C:\\x.txt"` — `stdlib/Builtins.maxon`'s `init(value String)`.
	stringLiteral

	// `CharWrapper from 'X'` — `stdlib/Builtins.maxon`'s `init(value Character)`.
	charLiteral

	// `Digits from [4, 0, 7]` — `stdlib/Builtins.maxon`'s `init(value ElementArray)`.
	arrayLiteral
end 'LiteralInitForm'

// The collection a `<alias> from [ … ]` head's alias must name (`Parser.namesContainerInstanceAlias`).
enum FromHeadContainer
	set
	list
	fixedArray
	array
end 'FromHeadContainer'

function fromHeadIsTheBareBase(head ByteArray, container FromHeadContainer) returns bool
	return match container 'container'
		set or
		list or
		fixedArray gives head.equals(fromHeadBaseName(container))
		array gives false
	end 'container'
end 'fromHeadIsTheBareBase'

function fromHeadBaseName(container FromHeadContainer) returns immutable ByteArray
	return match container 'container'
		set gives SetBuiltinBaseName
		list gives ListBuiltinBaseName
		fixedArray gives FixedArrayBuiltinBaseName
		array panic("fromHeadBaseName: an `Array` head is always an alias and has no bare base name")
	end 'container'
end 'fromHeadBaseName'

let FromHeadTokenCount = 2

// The token a form's operand opens with.
function literalInitOperandKind(form LiteralInitForm) returns TokenKind
	return match form 'f'
		stringLiteral gives TokenKind.stringLiteral
		charLiteral gives TokenKind.charLiteral
		arrayLiteral gives TokenKind.leftBracket
	end 'f'
end 'literalInitOperandKind'

// The conformance a form's construction requires of its type, recorded on the site and taken after the merge
// by `ConformanceCheck.checkLiteralInitConformance`.
function literalInitInterfaceName(form LiteralInitForm) returns immutable ByteArray
	return match form 'f'
		stringLiteral gives InitableFromStringLiteralName
		charLiteral gives InitableFromCharLiteralName
		arrayLiteral gives InitableFromArrayLiteralName
	end 'f'
end 'literalInitInterfaceName'

// The panic a negative run-time count earns, and the two blocks `emitNegativeShiftCountGuard` splits the
// shift across. The text is the runnable oracle's, verbatim.
let NegativeShiftCountPanicText = "negative shift count"
let FillRefusedPanicText = "FixedArray.create: the value fill refused a window inside the new length"
let FillRefusedPanicBlockLabel = b"fillrefused"
let FilledBlockLabel = b"filled"
let NegativeShiftPanicBlockLabel = b"shiftneg"
let GuardedShiftBlockLabel = b"shiftok"

let EmptySlotMessageName = b"__emptySlotMessage"
let EmptySlotMessageIndexLabel = b"index"
let EmptySlotPanicBlockLabel = b"emptyslot"
let FilledSlotBlockLabel = b"slotfilled"
let EmptySlotWord = 0

// The two blocks `emitQuotientOverflowGuard` splits a signed quotient across.
let QuotientOverflowPanicBlockLabel = b"divovf"
let GuardedQuotientBlockLabel = b"divok"

// ⭐⭐ **THE SHARED EMPTIES A PARSER'S COLUMNS START FROM, AND THE ANCHORS ITS COPY-ON-WRITE TESTS COMPARE AGAINST.**
// Each column below is installed in a parser field and REPLACED before its first write, so an anchor stays empty and
// its identity says "not materialized yet". That is the whole economy: a `Parser` is built per file per pass and per
// top-level constant, and nearly none of them fills most of these.
//
// ⛔ **HELD BY AN OWNER AND HANDED TO EVERY PARSER IT BUILDS, NEVER MODULE-LEVEL.** A counted record retained from two
// OS threads is a lost update. A parse whose artifact
// crosses a pool boundary builds its own (`ParseStaging.parseFile`): the artifact's functions keep the placeholders,
// and a move carries only a record owned inside the moved graph.
// ⛔ **FIELDS, BECAUSE A `let` HOLDING AN EMPTY CONTAINER IS IMAGE DATA** (⚖ user ruling): storing a
// module-level `let`'s record into writable storage is refused, so a parser field could not be seeded from one.
export type ParserAnchors
	// `Parser.interfaceAliasScratch` of an interface that declares no generic-instance typealias — every interface
	// outside `stdlib/Builtins.maxon` and `specs/associated-types.md`.
	export var interfaceAliases as GenericAliasEntryArray

	// The default helpers a file holds until it declares a default (`materializedPendingDefaultHelpers`).
	export var pendingDefaultHelpers as PendingDefaultHelperArray

	// ⭐ **ONE ANCHOR FOR EVERY MEMBER ROSTER AND FOR `Parser.arrayDeclarationRoster`.** A roster is a constant a file
	// builds the first time it dispatches on that surface and keeps for every later call site (`MemberSurface`), so its
	// identity with this anchor is the has-it-been-built gate. One anchor rather than one each: it is only compared,
	// never read or written, and a second would add nothing but a field to test against the wrong one.
	export var surfaceRoster as NameRoster
	export var declarationRoster as NameRoster

	// `Parser.mutableVarShadowed` of a function that has declared no `var` yet; `pushMutableVar` replaces it.
	export var mutableVarShadowed as MutableVarShadowColumn

	// `Parser.blockExtentEnds` before `buildBlockExtentIndex` has run — the has-it-been-built gate.
	export var noBlockExtents as BlockExtents

	// What every function the parser builds starts from (`IrFunction.create`).
	export var functions as FunctionPlaceholders

	export var unwrittenRegionFacts as RegionFactTable
	export var detachedBlock as IrBlock

	export var undeclaredAlias as DeclaredAlias

	export static function create() returns ParserAnchors
		let functions = FunctionPlaceholders.create()
		return Self{interfaceAliases: GenericAliasEntryArray.create(0), pendingDefaultHelpers: PendingDefaultHelperArray.create(0), surfaceRoster: NameRoster.create(0), declarationRoster: NameRoster.create(0), mutableVarShadowed: MutableVarShadowColumn.create(0), noBlockExtents: BlockExtents.create(TokenArray.create(0), extentEnds: TokenIndexArray.create(0), keywordNames: TokenIndexArray.create(0), declaredNameKeywords: TokenIndexArray.create(0)), functions: functions, unwrittenRegionFacts: RegionFactTable.create(), detachedBlock: IrBlock.create(0, label: DetachedBlockLabel, heat: BlockHeat.normal, inlineSite: InlineSiteRef.none), undeclaredAlias: DeclaredAlias.undeclared}
	end 'create'
end 'ParserAnchors'

union ClosureEnvParam
	none
	param(valueId ValueId)
end 'ClosureEnvParam'

union HiddenWordParam
	none
	slot(valueId ValueId)
	enclosingThroughEnv
end 'HiddenWordParam'

function hiddenWordParamInheritedFrom(enclosing HiddenWordParam) returns HiddenWordParam
	return match enclosing 'enclosing'
		none gives HiddenWordParam.none
		slot or
		enclosingThroughEnv gives HiddenWordParam.enclosingThroughEnv
	end 'enclosing'
end 'hiddenWordParamInheritedFrom'

function layoutParamOf(needed bool, paramCount ParamCount) returns HiddenWordParam
	if needed 'reserved'
		return HiddenWordParam.slot(layoutDescriptorSlotValueId(paramCount))
	end 'reserved'

	return HiddenWordParam.none
end 'layoutParamOf'

function fixedElementCountParamOf(needed bool, paramCount ParamCount, witnessParamCount ParamCount) returns HiddenWordParam
	if needed 'reserved'
		return HiddenWordParam.slot(fixedElementCountSlotValueId(paramCount, witnessParamCount: witnessParamCount))
	end 'reserved'

	return HiddenWordParam.none
end 'fixedElementCountParamOf'

function hiddenWordParamIsCarried(param HiddenWordParam) returns bool
	return match param 'param'
		none gives false
		slot or
		enclosingThroughEnv gives true
	end 'param'
end 'hiddenWordParamIsCarried'

union HeldAcquire
	none
	held(group ValueId, guardFloor ElementIndex)
end 'HeldAcquire'

type AcquiredName
	export let token as Token
	export let handle as ValueId
	export let stateType as MaxonType

	static function create(token Token, handle ValueId, stateType MaxonType) returns AcquiredName
		return Self{token: token, handle: handle, stateType: stateType}
	end 'create'
end 'AcquiredName'

typealias AcquiredNameArray = Array with AcquiredName

type FunctionBodyState
	// The `var` bindings currently IN SCOPE, in declaration order — held as the
	// `VarInfo` objects, for the reason LoopPhiVar documents. A loop header mints a phi for
	// the SUBSET of these its body assigns, in this list's order, so that block-args and
	// every predecessor's BranchEdge argIds stay positionally aligned with each other.
	// `let` bindings never appear (they cannot be reassigned, so they carry no
	// loop-carried phi). A block's `var`s are drained off the end of this list at the
	// block's `end` (see closeBlock). Reset per function.
	//
	// An `if`'s merge works the same way (`assignedBindingsIn`): its snapshots are positional
	// over the SUBSET of this list its branches assign, in this list's order, and it mints a
	// phi only where the two paths differ.
	export var mutableVars as VarInfoArray

	// ⭐ **THE INVERSE OF THE LIST ABOVE, AND THE REASON A CARRIED SET COSTS O(assigned) RATHER THAN
	// O(vars in scope).** `mutableVarInnermost` maps a name to the position of the innermost binding
	// that holds it; `mutableVarShadowed` holds, per POSITION, the position that binding shadows (or
	// `InnermostMutableVar.none`), so the entries a name hides are reachable without a second map entry per name.
	//
	// Both are maintained in exact lockstep with `mutableVars` — pushed together at a `var`
	// declaration, popped together at the block's `end`, reset together per function — which is
	// what lets `openBlock`'s single height mark unwind all three (see `closeBlock`). Both start at
	// a shared empty and are copy-on-written by the first push (see `ParserAnchors.mutableVarShadowed`),
	// so a `Parser` that declares no `var` — every one the signature sweep builds — allocates neither.
	//
	// ⚠ **THIS IS AN INDEX, NOT A SECOND SYMBOL TABLE.** Nothing resolves a NAME through it: an
	// ordinary variable reference goes to `Scope`, which answers a different and larger question
	// (`let`s, self-fields, payload bindings, shadowing across function boundaries). This answers
	// only "where in the phi/merge ordering does this mutable binding sit", which is the one question
	// `mutableVars`'s ORDER exists to answer and the one `Scope` cannot.
	export var mutableVarShadowed as MutableVarShadowColumn

	export var mutableVarInnermost as MutableVarNameIndex

	// The struct-typed bindings currently IN SCOPE, in declaration order — the values a `return`
	// must DROP (`emitFunctionExit`). Held as the `VarInfo` objects, exactly as `mutableVars` is, and
	// drained off the end at a block's `end` by the same mark (see `closeBlock`). Reset per function.
	//
	// ⚠ **IT IS NOT `Scope.popScope`, AND THAT IS NOT AN OVERSIGHT.** Scope's header argues that a
	// parallel owned-list is state that can drift while `popScope` already resolves every binding a
	// frame tears down — and it is right about a BLOCK. It cannot serve this case, for
	// two independent reasons:
	//
	//   1. **A `return` TERMINATES ITS BLOCK.** `return p.x + p.y` must read the fields, THEN drop
	//      `p`, then return — so the drop belongs between the value and the terminator, at the
	//      `return` statement. `popScope` runs at a block's `end`, which is after the terminator:
	//      anything it emitted would sit on a path control has already left, and the box would leak.
	//   2. **A FUNCTION-SCOPE BINDING NEVER REACHES `popScope` AT ALL.** `Scope.install` records a
	//      declaration for teardown only while a frame is open (`frameMarks.count() > 0`), and
	//      `parseFunction` opens none — `main`'s `let p` lives for the whole function and is torn
	//      down by `reset`. The hook would not fire for either case.
	//
	// ORDER is the third reason, and `vars` could not give it either: `Scope.allVars` hands back a
	// hash MAP, so draining it would emit the drops in hash order and no `TargetIr` pin would
	// reproduce.
	export var ownedBindings as VarInfoArray

	export var moveLedger as MoveLedger

	// ⭐ **THE PARAMETERS AND `for` BINDINGS THIS FUNCTION DECLARED THAT E3012 MUST ACCOUNT FOR**, in
	// declaration order. Drained at the function's `end` by `reportUnusedBindings`, which reports the FIRST
	// one never mentioned. A body `let`/`var` is NOT collected — see there for the spec boundary.
	//
	// ⚠ It is a LIST and not `Scope.allVars()`, which is a hash MAP: its order is not the declaration
	// order the diagnostic must follow, and no `maxoncstderr` block would reproduce. The reason
	// `ownedBindings` gives just above.
	//
	// Reset per function, and SAVED/RESTORED around a closure body like its sibling columns here. That
	// isolation is load-bearing rather than tidy: a closure's parameters are bound through the same
	// `bindParameters`, and left shared they would be reported against the ENCLOSING function, which
	// declared none of them.
	export var unusedCandidates as UnusedBindingCandidateArray

	// ⭐ **HAS THIS FUNCTION BOUND A SECOND NAME TO A VALUE IT DOES NOT OWN?** — set by the immutable
	// rebind `let b = a` (see `declareInitializedBinding`), and read by nothing but `poisonValueAliases`.
	//
	// It exists to keep a symbol-table walk off the move path of every function that mints no alias. Without
	// an alias, two live bindings provably cannot share one value, so the walk is empty — and the move path
	// is taken by EVERY consuming call argument in the program, which is where an unconditional per-move
	// scan of the scope would turn a long body quadratic.
	//
	// Reset per function and saved/restored around a closure body like its sibling columns here, because a
	// closure body is a separate function: an alias minted in the enclosing one says nothing about whether
	// the closure's own moves need the walk.
	export var functionMintedValueAliases as bool

	// ⭐⭐ **THE VALUES THIS FRAME HAS ALREADY CONSUMED, ON THE PATH BEING PARSED RIGHT NOW — the live half of
	// `MoveMark.consumes`, and the state E3142 and a re-read's E3102 are decided from.**
	//
	// Recorded by `consumePromiseThread` (the one door `await`, `try await` and `.cancel()` all reach) and by
	// a `match` that consumes its scrutinee, and rewound at every branch by the same capture/restore/reconcile
	// the owned-binding move bits ride, so "was this thread spent?" is as path-sensitive as "was this binding
	// moved from?" — a consume in one `if` arm does not spend the thread on the arm that never ran.
	//
	// ⚠ **IT IS KEYED ON THE VALUE AND NOT ON THE BINDING, which is exactly what a `VarInfo` column could
	// not have been.** A promise ALIASES rather than moves, so `let q = p` enrols no second owner and there
	// is no per-binding place to write `q`'s poison that a rewind could find (`MoveMark` is positional over
	// `ownedBindings`, and an alias is not in it). One record against the thread's `ValueId` covers every
	// name that spells it, for as long as that name spells it: re-arming `p` gives `p` a NEW value and
	// revives it, while an alias still holding the OLD one stays refused — which is the whole of
	// `async-linearity.error.double-await-alias-outlives-rebind`.
	//
	// Re-created per function like `ownedBindings`, for the same reason: a `ValueId` names a value in one
	// function's SSA space and nothing else.
	export var promiseConsumes as PromiseConsumes

	// ⭐ **THE ENUM-ACCESSOR READS THIS FUNCTION HAS EMITTED** (E3097). Fresh per function for
	// `promiseConsumes`' reason: a `ValueId` means something else in the next body, so a record carried
	// across would refuse a comparison in a program that has no accessor in it at all. Empty for every
	// function that reads none, which is almost all of them.
	export var enumAccessorReads as EnumAccessorReadArray

	// This factory's deferred writes and the literals that consumed them — the GEN sets and the checks of
	// the definite-assignment dataflow (`validateNascentSelfAssignments`). Both are empty for every body
	// that defers nothing, which is every body but a factory written this way.
	export var nascentSelfWrites as NascentSelfWriteArray

	export var nascentSelfChecks as NascentSelfCheckArray

	// ⭐⭐ **THE NAMES A MENTION HAS RECORDED IN THIS FUNCTION — E3012's OTHER HALF, and the one
	// `VarInfo.referenced` structurally cannot answer.** "Referenced" is a fact about the NAME within the
	// enclosing function, not about the individual binding: MEASURED on the oracle, whose `_referencedVars` is
	// a `HashSet<string>` per function, two sequential `for i` loops are ACCEPTED when only the second reads
	// `i`. Each loop opens its own lexical frame and mints its own `VarInfo`, so the first one's bit stays
	// false for ever and a per-binding verdict would refuse the program.
	//
	// ⚠ **THAT IS NOT A CURIOSITY — IT IS LOAD-BEARING ON THE REAL CORPUS.** `specs/array-sort.md`'s
	// `driftsort-large-sqrt-cross-check` and `specs/generic-module-merge-pattern.md`'s
	// `dual-specialize-inner-array` both have a `for i` whose body never reads `i`, legal only because a later
	// `for i` in the same function does. Neither file is ported, which is why `unused-variable-name-scope.md`
	// exists to pin it here.
	//
	// **APPENDED ONCE PER BINDING, NOT ONCE PER MENTION**, and SCANNED only for a candidate whose own bit is
	// already false — i.e. only for a declaration that is about to be reported or excused. A function whose
	// every binding is used never scans it at all.
	//
	// Saved/CLEARED/restored around a closure body, then the closure's CAPTURED names are pushed back
	// into the restored list. Sharing it across the boundary instead would let a closure's private
	// local excuse an enclosing declaration of the same name.
	export var referencedNames as NameRoster

	// ⭐⭐ **THE NAMES THIS FUNCTION EVER NEEDED WRITABLE — E3077's evidence**, the exact twin of
	// `referencedNames` above, appended by `markMutabilityExercised` and read by `reportVarShouldBeLet`.
	// A `var` whose name never lands here could have been a `let`.
	//
	// ⚠ **NAME-SCOPED FOR THE SAME REASON ITS TWIN IS, and here the reason is a SHADOW rather than two
	// sibling loops.** An inner `var x` that IS written must excuse an enclosing `var x` that is not:
	// the key is a per-function name SET, so a per-binding verdict would refuse a legal program.
	// `VarInfo.mutabilityExercised` is the once-per-binding dedup in front of the append, exactly as
	// `referenced` is for the list above.
	//
	// Saved/CLEARED/restored around a closure body like its twin — a closure is a separate function and its
	// own writes say nothing about the enclosing body's `var`s. ⚠ Unlike `referencedNames` it takes NO
	// capture push-back at the restore: a capture is BY VALUE in the compiler (`captureEnclosing`), so a write
	// inside the closure cannot reach the enclosing binding and is no reason to keep it a `var`.
	export var mutabilityExercisedNames as NameRoster

	// ⭐ **THE OWNED HEAP TEMPORARIES CREATED BY THE STATEMENT BEING PARSED, awaiting their drop.** An
	// UNBOUND owned value — `print("{x}")`, where the interpolation result is consumed by `print` (which
	// BORROWS it) and bound to no name — has, under static single-owner, exactly one possible owner: the
	// STATEMENT that produced it. `emitStringInterp` pushes each result here; `parseStatement` drains it at
	// the statement's end, emitting a `__mm_decref` per entry into `currentBlock` — so the drop lands in the
	// LOOP BODY per iteration (`while … print("{i}") …`), the `if`-branch block, or a short-circuit merge,
	// wherever control is when the statement finishes. This is what makes `print("{x}")` — the dominant
	// interpolation shape — leak-free without binding it to a name.
	//
	// A value that IS bound (`let s = "{x}"`) has its ownership TRANSFERRED to the binding: `parseBinding`
	// removes it from here and adds it to `ownedBindings`, so it drops at SCOPE exit (`emitScopeDrops`), not
	// statement end. Reset per function, like every other per-function column. It holds only owned RESULTS —
	// the interpolation's internal scratch buffers are freed inside `emitStringInterp`, never tracked here.
	export var pendingTempDrops as ValueIdArray

	// The last `named` field read, so `throw <boxed-union field>` can move the box out of its
	// container (`moveOutThrownField` nulls the recorded `(box, offset)`). The thrown value is recognized
	// by identity against the recorded value, and an equal value id can only have come from this exact
	// `(box, offset)`; a miss falls to the retain, never a wrong slot nulled. Reset per function, so a
	// stale `box` never names a previous function's value.
	export var lastFieldRead as LastFieldRead

	// ⭐⭐ **WHICH SOURCE MEMBER A LOWERED RUNTIME READ SERVES — E3064's SUBJECT, AND NOTHING ELSE'S.** the compiler's
	// parser lowers a container read STRAIGHT to a runtime symbol, so a discarded `items.first()` files
	// `__managed_first` as the callee and the diagnostic would name a symbol the author never wrote; the
	// reference reports `Array.first`. The ARM that lowers the call is the only party holding both halves —
	// the receiver's declared name and the member token — so it says so here.
	//
	// ⚠ **ONE SLOT, NOT A TABLE, AND THE `result` FIELD IS WHAT MAKES THAT SOUND.** The discard door only ever
	// asks about the call its own statement ENDED on, so a nested read (`f(a.count())`) simply fails the
	// ValueId test and the door falls back to the callee — which is the right answer there, the discarded
	// result being `f`'s. A per-call map would cost an insert on the parser's hottest path to answer the same
	// question. The qualified name is built only when a site is actually filed, for the same reason.
	//
	// ⚠ **AND IT IS INVALIDATED PER FUNCTION, for `lastFieldRead`'s reason beside it: a ValueId names a
	// slot in ONE function's SSA space**, so a slot carried across the boundary could match an unrelated
	// value's id in the next body and report a runtime read under a member from the previous one.
	export var lastRuntimeRead as LastRuntimeRead

	// The enclosing loops, innermost last. `break`/`continue` resolve their
	// target here; a `while` pushes on entry and pops after its body. Reset per
	// function (a stray entry across functions would be a parser bug).
	export var loops as LoopContextArray

	// The enclosing block-form `try` bodies, innermost last. A throwing op routes to the innermost;
	// with none, a test body's implied handler takes it, and otherwise it stays plain and is refused
	// with E3057 (see `throwRouteDestination`).
	//
	// This field and the claim fields below are per-function state with `loops`/`matches`' lifetime,
	// and the reset sites point here:
	//
	//   • Reset at the start of a function body (`parseFunction`, `parseDefaultHelperBody`,
	//     `parseClosureExpression`). A stray context would name an error block and a phi from the
	//     previous function, so a routed op would branch across a function boundary. A `SourceParseError`
	//     thrown inside a body or a try target skips the pops and restores, and the next function must
	//     not inherit them.
	//   • Saved and restored around a closure (`parseClosureExpression` only), the one re-entrant
	//     door: the other two reach a fresh function from a drained top level, while a closure resumes
	//     the enclosing body. Reset without restore there would return to a block-form `try` body with
	//     an empty stack, so its remaining throwing ops stop routing and its `end` panics on the pop.
	export var tryBlocks as TryBlockContextArray

	// See `ThrowRouteClaim`. `claimOpFloor` is the op count when the claim opened, so a release never
	// reaches an op from before it. `heldAwaits` are the throwing awaits emitted under a claim: an
	// await's E3057 is the parser's to raise, and under a claim it is not yet known whether the await
	// will be released, so `closeClaim` refuses any still plain that is not the claimed value.
	//
	// `everyDestination` is also swapped in around a call no handler may take: a synthesized
	// incref/decref (`emitOwnershipRuntimeCall`), emitted into the router's own landing pads and merge
	// edges, where routing it would fork a block the router is building; and a traversal protocol call
	// `emitProtocolTryCall` rewrites itself, which routed first would be rewritten twice.
	export var throwRouteClaim as ThrowRouteClaim

	export var holdsSendForTryAwait as bool

	export var statementNesting as BlockDepth
	export var replyDeferred as bool
	export var consumesSelf as bool
	export var anyLinearOwned as bool
	export var consumedReceivers as ValueIdArray

	// A `try` target must still be a call when the target parse ends, so no fold may remove one inside
	// it. `parseTry` and `if let x = try …` rewrite the op producing the target's value
	// (`rewriteLastCallToTryCall`) and decide E3055 from what it names; a constant-slice fold that
	// removed the call would answer E2015, "the expression after `try` is not a call", for a call that
	// is in the source. Declining the fold costs only an illegal program its optimization, since
	// `String.slice` does not throw.
	//
	// It covers the target's arguments too, so a literal slice inside `try f(lit.slice(…))` keeps its
	// runtime call: the bracket is the whole target parse, and a second way to decide which call is
	// the target would be two deciders of one fact, free to disagree.
	export var tryTargetMustStayACall as bool

	// ⭐ **SET ONLY AROUND A `for` LOOP'S OWN `current()` CALL ON A `WithIterIterator` OVER AN ARRAY OF
	// PROMISES** — the loop's destructure moves the promise out of the pair into its array slot
	// (`claimWithIteratorPromiseSlot`), so the corpus-call door may admit a pair it would otherwise refuse as a
	// borrowed promise. The bracket holds one argument-free call, so no closure body is ever parsed under it.
	export var loopClaimsWithIteratorPromise as bool

	// The enclosing match STATEMENTS, innermost last — the other half of the break-target stack (see
	// `MatchContext` for why `break` needs its own rather than sharing `loops`). `continue` never reads
	// it. Reset per function AND per closure exactly as `loops` is: without the closure reset, a `break`
	// inside a closure inside a match arm would target a match in the ENCLOSING function, whose merge
	// block belongs to another `IrFunction` entirely.
	export var matches as MatchContextArray

	// The `(e)` bindings in scope that name a synthesized error union, innermost last. A handler
	// pushes one when it declares such a binding and pops it at its own `end`, so `match e` resolves
	// the union by the name the source wrote and by the value that name is still bound to
	// (`errorUnionForScrutinee`).
	//
	// ⚠ This and `boxedMemberArms` are saved, reset and restored around a closure body: a closure
	// declared inside a handler parses with them non-empty, and a `match e` there would name a fused
	// phi belonging to a different `IrFunction`.
	export var errorUnionBindings as ErrorUnionBindingArray

	export var boxedMemberArms as BoxedMemberArmArray

	// ⭐ **THE BLOCK-FORM `(e)` BINDING THIS HANDLER MUST BE SEEN TO `match` ON, AND WHETHER IT HAS
	// BEEN (E3084).** A block-form handler is reached by every routed edge, so a handler that never
	// discriminates has silently swallowed every error the body could raise, and the refusal is
	// anchored on the handler's own label. The name is EMPTY while no such handler is open, which is
	// also the single-call forms' state: they catch ONE call's error and are free to ignore it.
	//
	// ⚠ It is the NAME and nothing else — see `noteTryBlockBindingMatched` for why this rule and the union
	// DISPATCH key on different things, which is the one place in this construct they deliberately disagree.
	//
	// ⚠ Saved and restored by `parseOtherwiseBlock` around its own body, so a nested `try` block inside a
	// handler asks its own question and gives the enclosing one back unchanged — and reset per closure with
	// `errorUnionBindings`, for the reason stated there.
	export var tryBindingName as TryBinding

	export var tryBindingMatched as bool

	// The source-level type of every SSA value this function's ops define, DENSE by ValueId
	// and split into its two halves: the TAG (the discriminant) and, for a `named` type, the
	// interned name id. The type oracle the context-dependent operators consult:
	// `and`/`or`/`xor` and `not` mean one thing on `bool` and another on `int`, and — because
	// a bool `and`/`or` is CONTROL FLOW, which no later pass can retrofit — the parser is the
	// tier that must know.
	//
	// TWO SCALAR COLUMNS, not an `Array with MaxonType`: a Maxon union value is a heap
	// object, so a `MaxonType` column would put an allocation on every SSA value in the
	// program, and the type RULES that read it would put another on every operator. See
	// MaxonDialect's `ValueTypeTag` for the measurement that settled it.
	//
	// Seeded with the parameter types (which own ids 0..paramCount-1) and appended in
	// lockstep with `valueIds` by `mintValue`. Re-CREATED per function (never cleared) —
	// which is what makes the next line safe:
	//
	// **`valueTags` IS THE FUNCTION'S OWN COLUMN, SHARED BY REFERENCE.** `parseFunction` hands
	// this very array to `IrFunction.create`, so every `mintValue` during the body parse pushes
	// straight into `func.valueTags`. That is not an optimization detail to be tidied away: the
	// column has a SECOND reader (SemanticCheck, for the one type rule that needs a callee's
	// signature and so cannot live here — see IrFunction.valueTags), and copying it out at the
	// end of each body would allocate a dead array per function for nothing.
	//
	// `valueNameIds` — the parallel interned-NAME column — is handed to `IrFunction.create` BY
	// REFERENCE alongside `valueTags`, for the one downstream reader that needs an aggregate's NAME
	// and not just its class: SemanticCheck's call-argument identity check (two structs share the
	// `structRef` tag, so telling a `BoxA` argument from a `BoxB` one needs the name).
	// See IrFunction.valueNameIds.
	export var valueTags as ValueTypeTagArray

	// ⭐ **THIS FUNCTION'S SOURCE BINDINGS, FOR THE DEBUG-INFO SIDECAR** (see `IrFunction.debugLocals`) —
	// one record per declared `let` / `var` / parameter, in declaration order, each accumulating every SSA
	// value its name has owned. Handed to the `IrFunction` at the function's `end`, because a binding
	// leaves SCOPE at its own block's.
	export var debugLocals as DebugLocalDeclArray

	// The `VarInfo`s those records belong to, index-parallel with `debugLocals` and written by the one
	// door that appends to either (`trackDebugLocal`) — which is what makes "the two fell out of step"
	// unrepresentable rather than asserted. Held so the publication tripwire can compare each record's
	// tail against the value its binding actually ended up holding.
	export var debugBindings as VarInfoArray

	export var debugOpenSlots as DebugLocalSlotArray

	export var valueNameIds as TypeNameIdArray

	// THE PARSER'S CONSTANT FOLDER — two more columns in lockstep with `valueTags`, holding the
	// integer behind every SSA value the compiler KNOWS. It exists for the shift rule, which is
	// the one rule in the language that must ask "what IS this operand?" rather than "what TYPE is
	// it?" (TypeRules' ⭐ THE SHIFT RULE): a negative count is E2054, and a count of 64-or-more
	// names a different shift than the hardware would perform.
	//
	// Filled forward, at the three places an integer value is born — `emitLiteral` (so a count
	// named through a `let` is a count this column holds: `let SHIFT = -1` binds the name to the
	// literal's own ValueId), `emitUnaryOp` (`-1` is `neg` of a literal, not a negative literal),
	// and `emitBinOp` (so `x shl 63 + 1` is a count of 64).
	//
	// Two scalar columns rather than one column of a union, for the reason `valueTags` gives: a
	// Maxon union value is a heap object, and this is the per-VALUE path. Re-created per function,
	// so the cost is bounded by the largest function and not by the module.
	//
	// ⚠ Its REACH is a matter of diagnostic quality, never of correctness FOR THE SHIFT RULE. A count it
	// misses is a count `emitGuardedShift` saturates at run time, to exactly the same answer — which is what
	// lets the fold be an optimization rather than a second opinion. ⚠⚠ **THAT IS NOT TRUE OF ITS SECOND
	// READER.** The division-by-zero proof reads these columns too, and there a MISS costs a needless
	// `try` while a WRONG ANSWER costs a hardware trap where a catchable error was promised — so the proof is
	// written to fail towards "possibly zero", never towards "provably non-zero".
	//
	// ⭐ **The `known` half names the payload's DOMAIN, not merely its presence** — see `ConstPayloadDomain`
	// for why that is one column and not two, and why the tag cannot answer it.
	export var valueConsts as FullRangeIntArray

	export var valueConstDomains as ConstPayloadDomainArray

	// ⭐ **THE OWNED-HEAP PROVENANCE — the SSA values that OWE A DROP in this function.** It exists because
	// ownership CANNOT be read off the type tag: an owned interpolation String and a borrowed-immortal rdata
	// literal String share `ValueTypeTag.string`, so keying a drop on the tag would either decref an immortal
	// literal (a wrong decref of unowned `.rdata`) or leak an interpolation result; and a fresh struct box and a
	// borrowed struct PARAMETER share `structRef`. This is the provenance the tag cannot carry — recorded at
	// every producer that hands this frame a droppable reference, never by a literal or a parameter — read by
	// `parseBinding` (does this binding OWN a drop?) and structurally by the statement-scoped temp-drop.
	//
	// ⛔⛔ **IT SAID "FRESH … allocations" AND "today, the interpolation RESULTS", AND BOTH WERE FALSE — the
	// second by drift, the FIRST by a conflation that cost six segfaults.** The bit is set for a `__mm_retain`
	// of somebody else's box, for a consumed parameter, for a caught error box and for a call's owned result;
	// none of those is fresh, and *"owes a drop"* was never the same claim as *"nobody else holds this
	// allocation"*. The second claim is `valueOwnsHeapAlone`'s, one field down, and every reader that needs it
	// must ask THAT one. See `OwnedHeapExclusivity`.
	//
	// A PER-VALUE bool column, indexed by ValueId in lockstep with `valueTags`/`valueConstKnown` (pushed
	// `false` in `mintValue`/`recordValueType`, set `true` in `markValueOwnsHeap` — which `trackOwnedTemp`
	// calls when the value also owes a statement-scoped drop — read by `valueIsOwnedHeap`).
	// It is a set-MEMBERSHIP fact and nothing more — never iterated, order-independent — so the O(1) column
	// read is the right shape and the earlier sparse list was not: that list was scanned once per binding
	// and grew by one per interpolation, never pruned within a function, so a function with N bound
	// interpolations paid Σk = O(N²) — a `findFirst`-in-a-loop quadratic in one function's size. The column
	// makes each query O(1); its one added bool per value is strictly linear and dwarfed by the sibling columns
	// already carried per value (no COUNT of them here — this file has had a call-site count go stale three
	// times; see `markDeclaredSurface`). Reset per function.
	export var valueOwnsHeap as BoolArray

	// ⭐⭐ **AND WHETHER THAT OWNED REFERENCE IS THE ALLOCATION'S ONLY ONE** — the column that tells a SOLE
	// owner from a CO-OWNER, which `valueOwnsHeap` alone structurally cannot (see `OwnedHeapExclusivity` for
	// the six segfaults that conflation cost). Read ONLY by the two transfers that write DESTRUCTIVELY through
	// a box they will not re-read — `moveOutManagedPayload` nulls a payload slot, `moveOutThrownField` nulls a
	// field slot — because those are the only decisions in the parser that need sole ownership rather than
	// ownership. Every other owner-aware rule (a drop, a move poison, a reassignment's move-vs-copy) is correct
	// for a co-owner too and goes on asking `valueIsOwnedHeap`.
	//
	// Same lockstep as `valueOwnsHeap` (pushed `false` in `mintValue`/`recordValueType`, set by
	// `markValueOwnsHeap`'s `sole` argument, cleared by `markValueCoOwnsHeap`'s three callers), and
	// DENSE for `valuePromiseMarks`' measured reason read the other way: a sole owner is the COMMON case (every
	// fresh box in the program), so a sparse set would carry hundreds of entries per function to save one bool
	// per value.
	//
	// ⚠ **SEEDED `false` = CO-OWNED, and the seed is the safety property.** A value nothing claimed takes the
	// retain path, which is one refcount pair rather than a stolen slot.
	export var valueOwnsHeapAlone as BoolArray

	// ⭐⭐ **AND WHETHER A CALL RESULT'S SOLE OWNERSHIP IS KNOWN ONE FRAME OUT** — the column that says
	// *"the callee that handed this back built the record in its own `return` statement, so this frame is its
	// only owner"*, which `valueOwnsHeapAlone` structurally cannot say: that one means *"THIS frame executed the
	// allocating op"*, and a call result never did.
	//
	// ⛔ **IT IS A SECOND COLUMN AND NOT A WIDENING OF `valueOwnsHeapAlone`, DELIBERATELY.** That column's only
	// readers are the two DESTRUCTIVE move-outs, which null a slot in a box they will not re-read — and its
	// header records the six segfaults that came of deriving its `true` from anything but a local allocation.
	// This claim rests on a TOKEN-LEVEL whole-program summary (`ProgramSignatures.returnsFreshValue`), so it
	// earns its own column and its own reader rather than licensing a slot steal.
	//
	// ⚠ **ITS READER IS THE HAND-OFF DOOR** (`handOffTakeOf`, through `valueIsSolelyOwnedHere`), which
	// needs sole ownership for a reason no other rule in the parser has: the value crosses to a SECOND
	// GREEN THREAD, where a co-owner left behind on this thread steps a count the service now steps
	// too.
	//
	// ⭐ **CLEARED BY `markValueCoOwnsHeap`, WHICH IS WHAT MAKES IT UNFORGETTABLE.** Every op that mints a
	// second owner of a box already calls that one on its source — the five enumerated in its header — so a
	// fresh call result this frame then pushes into a container, captures, or hands to a consuming call stops
	// being movable at the instant the reference is taken, with no site having to remember a second write.
	//
	// Same lockstep as `valuePromiseMarks` (pushed `false` in `mintValue`/`recordValueType`, set by
	// `markValueFromFreshReturn` — see there for its writers — recreated per function and swapped
	// across a closure body).
	export var valueFromFreshReturn as BoolArray

	// ⭐ **THE PROMISE MARK** — true iff value `v` is an `async` spawn's handle. A per-value bool
	// column in the SAME lockstep as `valueOwnsHeap` (pushed `false` in `mintValue`/`recordValueType`, set by
	// `markValuePromise` on the one value `emitAsyncCall` mints, read by `valueOwnsGreenThread`). The handle's TAG
	// already carries its awaited scalar type (int/bool — a managed/float result is rejected before the handle
	// is minted), so `await` reads the result type off `tagOf` and this bit only distinguishes an awaitable
	// handle from a bare int of the same tag. Reset per function and SWAPPED across a closure body's context.
	//
	// ⚠ A DENSE COLUMN, not a sparse Set, EVEN THOUGH a promise is RARE — measured, not assumed: a per-function
	// empty Set's initial hash table costs about as much as the dense bit does across the whole corpus (a sparse
	// Set MEASURED +7,364 allocs / +292K bytes WORSE at scale-rung5), because both allocate one object per
	// function and most functions are small. So the column is simpler (mirrors `valueOwnsHeap`), marginally
	// cheaper, and honest — the sparse-is-cheaper premise did not survive the instrument.
	export var valuePromiseMarks as BoolArray

	// ⭐⭐ **WHICH `__ManagedList` A `__ManagedListNode` HANDLE VALUE WAS MINTED OFF — the column
	// `__ManagedList.remove` reads to decide whether it may admit a handle no binding owns.** Same lockstep as
	// `valuePromiseMarks` (pushed in `mintValue`/`recordValueType`, written by the ONE mint door
	// `emitManagedListNodeHandle`, recreated per function and swapped across a closure body).
	//
	// ⚠ **"NOT A MINT" IS THE VALUE'S OWN ID, WHICH IS WHY THIS NEEDS NO SENTINEL.** A handle is minted
	// AFTER the list value it comes off, so a mint's entry always names a DIFFERENT value than itself — the
	// seed is therefore unforgeable rather than a reserved number some future ValueId could collide with.
	//
	// ⛔ **IT EXISTS BECAUSE A GUARD PHRASED AS *"is this an unnamed temporary?"* ADMITTED EVERY CALL
	// RESULT.** `remove`'s markability refusal has to let ONE unmarkable spelling through — the insertion it
	// was handed inline — and the first cut asked `pendingTempsContain`, which is true of `k.held()` as well:
	// a call handing back a FIELD's handle, MEASURED at exit 139. The exemption now asks the question its own
	// diagnostic claims to ask, by identity.
	export var nodeHandleMintedFrom as ValueIdArray

	// ⭐⭐ **WHICH CONTAINER SLOT A PROMISE VALUE WAS READ OUT OF — the two columns that make a container
	// read a PENDING MOVE rather than a copy**. A promise has exactly one owner; reading one out of
	// `arr.get(i)` does not make a second, it starts a move whose store has not been emitted yet. These
	// record where to finish it: whichever door consumes the value — an await, a cancel, or a store that
	// gives it to another owner — `vacateConsumedPromiseSlot` zeroes that slot first, so the container's
	// element walk skips it.
	//
	// ⛔ **WITHOUT THEM THE ELEMENT DESTRUCTOR IS A DOUBLE RECLAIM.** With `element_destroy@40` stamped and
	// no vacate, the consume reclaims the thread and the container's walk reclaims it again, driving
	// the GT live count NEGATIVE — and because the gate is `!= 0`, an over-release reports the same exit 75 a
	// leak does. The stamp and the vacate are one mechanism and must not be separated.
	//
	// ⛔ **A READ'S ENTRY IS A STATIC RECORD AND IS NEVER CLEARED.** What retires a read is the consume
	// recorded against its value, which `promiseValueCarriesAContainerSlot` asks about first. That record
	// rides `MoveMark` and so is rewound at a branch join and unioned across one; clearing a column instead
	// cannot be rewound, and a slot read given away on ONE arm of an `if` then reads as unread past the join.
	//
	// ⚠ **NOT-SET IS THE VALUE'S OWN ID**, `nodeHandleMintedFrom`'s convention one column up: a value can
	// never be its own container, so the sentinel needs no reserved id and no parallel bool.
	export var promiseSlotContainer as ValueIdArray

	export var promiseSlotIndex as ValueIdArray

	// ⭐ **WHICH KIND OF SLOT the pair above names.** A CONTAINER element is emptied by `__managed_vacate`
	// (buffer + index × stride); a STRUCT FIELD is emptied by a direct store at its offset, the same shape
	// `moveOutManagedPayload` uses for a union payload. One pair of columns serves both because the question
	// they answer — "which slot does this pending move come out of" — is one question; only the store differs.
	// For a field, `promiseSlotIndex` holds a minted literal of the field OFFSET.
	export var promiseSlotIsAField as BoolArray

	// ⭐ **THE SPARSE INDEX OF THE COLUMNS ABOVE: exactly the values that recorded a slot, in read order.**
	// `recordConsumablePromiseSlot` is the sole writer of all four, so an entry exists for every value whose
	// columns are set. Retiring the siblings of a consumed slot walks this instead of the dense per-value
	// column, which is asked once per consume and would otherwise be quadratic in a body's SSA values.
	//
	// ⛔ **NOTHING IS EVER REMOVED FROM IT.** A compaction keyed on a path-sensitive fact could not be
	// rewound at a join. Recreated — never cleared in place — at each per-body reset, because a closure
	// body saves and restores the enclosing body's array.
	export var promiseSlotCarriers as ValueIdArray

	// ⭐⭐ **WHICH VALUES WEAR A RANGED ALIAS NOTHING PROVED THEY SATISFY** — the column that stops a
	// DECLARED type being read as a statement about a value's RANGE. Same lockstep as `valuePromiseMarks`:
	// pushed `false` in `mintValue`/`recordValueType`, set `true` by `mintPhi` for EVERY phi and by
	// `adoptOperandAlias` for every arithmetic result that ADOPTS its operands' alias, and cleared only by
	// `recordMergeAliasProof`.
	//
	// ⚠ **THE TWO WRITERS ARE THE SAME FACT.** A merge names the type it was declared with, which no incoming
	// edge need satisfy; an adopted `a + a2` names `Score`, which the sum may lie outside. Both are NAMES, and
	// a name is what the coercion doors compare; neither is a proof, and every guard still fires.
	//
	// ⚠⚠ **A PHI'S TYPE NAME IS A DECLARATION, AND THE RANGE MACHINERY WAS READING IT AS A PROOF.** The
	// induction `rangeCoversDenotedRange` rests on — *"a value denoting alias `A` is IN `A`'s range"*,
	// maintained because every DOOR guards (a cast, a parameter's entry, a ranged `return`, a field or
	// element store) — has exactly one other producer that is not a door, and `TypeRules` names only
	// `Array.resize`. **A MERGE IS THE SECOND, and it is far more reachable.** A phi takes its name from ONE
	// incoming edge — the binding's declared type (`mintPhiForBinding`), the FIRST arm's type
	// (`finalizeMatchMerge`), the range's start bound (a `for` index) — while an ASSIGNMENT and a `gives` arm
	// are not doors, so any other edge may hand it a wider value. Three wrong answers follow from
	// reading the name as a proof:
	//   • `var t = x` (`x` a `Num = int(0 to 1000)`) then `t = t + 500` in a loop, `return t` ⇒ the compiler returned
	//     **1600** through a `returns Num`, because the `return`'s guard is elided wherever the phi
	//     "already denoted" `Num`.
	//   • `match k gives n / gives a + b` ⇒ the join denoted `Num` off arm 0 and returned **1800**. The same
	//     lie ALSO made `<join> as Num` report E3010 *"'Num' already fits in 'Num'"* — refusing a narrowing
	//     the program genuinely needs.
	//   • `divisorProof` read the same claim: a `NonZero` phi decremented to `0` compiled to a BARE `idiv`
	//     with no `throws DivisionByZero` demanded, and a runtime `0` died an **UNCATCHABLE hardware fault**
	//     where `safety.md` promises a catchable `DivisionByZero`. That is the precise hazard
	//     `InsertRangeChecks.guardRangedParams` calls *"WHY THIS IS NOT COSMETIC"*.
	//
	// ⭐ **UNPROVEN IS THE DEFAULT BECAUSE A LOOP HEADER CANNOT ANSWER AT ALL.** Its back edge is parsed
	// AFTER it is minted, so no test at the mint — and no later fix-up either, since a `return` INSIDE the
	// body reads the header phi — can see what will reach it. The claim is therefore withheld from every
	// merge and LIFTED only where the complete incoming set is in hand (`recordMergeAliasProof`), which is
	// the safe direction: a withheld proof costs a guard, an unsound one costs the answer.
	export var aliasUnprovenMarks as BoolArray

	// Indexes `func.blockRefs` below `blockPositionsCovered`: whatever reorders blocks under that mark must
	// rewind it, as the ternary does, or `blockById` reads a block from its old position.
	export var blockPositions as BlockIndexById

	export var blockPositionsCovered as ElementIndex

	// ⭐ **THE PER-VALUE WITNESS PAIRING** — for a value tagged `interfaceRef`,
	// the ValueId of the fat pointer's witness half; 0 for every other value. See
	// `IrFunction.valueWitnessIds`, which this column is handed to by reference.
	//
	// ⚠⚠ **DENSE, BUT GROWN ON DEMAND — it is the one value column `mintValue` does NOT push to**, and that
	// is a measurement rather than a taste. Its sibling columns hold a fact about EVERY value (a tag, a name,
	// a constant, an owned-heap mark), so a slot per mint is the cheapest form they have. This one holds a
	// fact about the values that are EXISTENTIALS, which in almost every program is none of them — and a
	// column pushed per mint bills the whole program for a question only an interface can ask.
	// `pairInterfaceWitness` extends it to reach the value it is pairing, laying down the identical UNPAIRED
	// zeroes on the way, so every read below the high-water mark is bit-identical to the per-mint form.
	//
	// MEASURED on the doubling ladder, same binary path and same corpus, A/B against the per-mint push:
	// **`phase:parse` -6,500 allocations and -11,390,384 BYTES at rung 5** (-978/-1,180/-1,558/-2,287/-3,705/
	// -6,500 across rungs 0-5, the delta's own ratio converging on the ladder's x2 ⇒ the term removed was
	// LINEAR, not a constant). The BYTES are the headline and the allocations are not: a per-mint push grows
	// one i64 slot per SSA value, so what it cost was a `ValueIdArray` growth series the size of the whole
	// function — 3.4% of the phase's bytes — for a fact about values that are existentials, of which the
	// rung-5 corpus contains **zero** (it declares 132 interfaces and never uses one as a TYPE).
	export var valueWitnessIds as ValueIdArray

	// ⭐ **TRUE WHILE PARSING A `match` ARM's single-statement body.** A match arm body is a single
	// statement, so a `try` used there may take only a single-statement form — the block forms
	// (`try 'label' … end`, `otherwise 'label' … end`, `otherwise (e) 'label' … end`) are rejected as
	// E2049. `parseArmBody` sets it around its `parseStatement` call; `parseTry` reads it to raise the
	// block-form diagnostics at the right position. Saved/restored so nested constructs unwind it.
	export var inMatchArmBody as bool

	// ⭐⭐ **THE BRAND OF EACH VALUE — the generic-instance `typealias` it was declared, built or read under —
	// DENSE in the same lockstep as `valueNameIds`, and `UnnamedTypeId` (the empty name) for a value no alias
	// names.** `Xs` and `Ys` over one `Array with Integer` share a gid and are two types; the gid is what the
	// tag columns compare and the brand is what tells the two apart, once the gids agree
	// (`ProgramSignatures.aggregatesConflict`). A per-instance `Idx` result re-qualifies through it too
	// (`retypeInstanceMethodResult`). Dense rather than a map: the compiler's own source spells nearly every
	// container through an alias, so a map would be an allocation per function and a probe per stamp.
	export var valueBrandIds as TypeNameIdArray
	export var valueCapabilities as ValueCapabilityArray
	export var regionFacts as RegionFacts
	export var operandOrder as OperandOrder
	export var pendingLocalCapability as ParamCapability
	export var pendingLocalCapabilityEnd as ElementIndex
	export var seededExitPhis as ValueIdArray
	export var declaredReturnCapability as ResultCapability
	export var statementStart as ElementIndex
	export var returnsFromParams as ParamPositionMask
	export var returnsOtherwise as bool
	export var returnsFrozenData as bool
	export var returnsMutableData as bool
	export var returnsAnUnknownValue as bool
	export var frozenResultRefusal as DeferredRefusal
	export var discardedReplies as ValueIdArray
	export var undecidedResults as UndecidedResultOpMap
	export var mergedSettlingOps as MergedSettlingOpMap
	export var emittedCall as EmittedCallOp
	export var literalCallOps as FuncIndexArray
	export var authoredMemberCalls as AuthoredMemberCallArray
	export var liftedClosureBodies as OpSpanArray
	export var declaredMutableParams as ParamPositionMask

	// ⭐⭐ **THE `with` ARGUMENTS EACH EXISTENTIAL VALUE'S DECLARED TYPE NAMED** — see
	// `ValueExistentialInstanceMap`. Reset per function and SWAPPED across a closure body, exactly like the
	// sibling value columns, and for their reason: its keys are ids in THIS function's SSA space.
	export var valueExistentialInstance as ValueExistentialInstanceColumn
	export var valueExistentialScope as ValueExistentialScopeColumn
	export var valueCallInstance as ValueCallInstanceColumn

	// Every store this function makes into an interface-typed field (`ExistentialFieldStore`), started at the
	// shared empty and replaced on the first write, and swapped across a closure body for its sibling's reason.
	export var existentialFieldStores as ExistentialFieldStoreArray

	// ⭐⭐ **THE RANGED TYPEALIAS EACH VALUE'S DECLARED TYPE NAMES, where the value's own type columns cannot
	// say so (E3010)** — see `ValueDeclaredAliasMap` for the two cases and for why the cast writer is gated.
	// Reset per function and SWAPPED across a closure body, exactly like the sibling value columns.
	export var valueDeclaredAlias as ValueDeclaredAliasTable
	export var wrapOperands as WrapOperandsColumn

	export var literalCasts as LiteralCastTable
	export var literalCastArguments as LiteralCastArgumentTable
	export var letCasts as LetCastTracking
	export var scratchCellFills as ScratchCellFillTable
	export var argumentStorage as ValueMarkColumn
	export var borrowedScratchCells as ValueMarkColumn
	export var deferredArgumentBindings as DeferredArgumentBindingColumn
	export var pendingOverlaps as PendingOverlapColumn
	export var loopScans as LoopMoveScanArray
	export var dropCascade as DropCascadeState

	// ⭐⭐ **THE INTERVAL A COUNTED LOOP PROVED FOR EACH OF ITS COUNTERS** — see `ProvenIntRange` for
	// what an interval nothing NAMES may and may not decide. Reset per function and SWAPPED across a closure
	// body, exactly like the sibling value columns, and for their reason: its keys are ids in THIS function's
	// SSA space. It is the ONE column of this family that also leaves the parser — `commitRangeChecks` hands
	// it to `FunctionRangeChecks`, where `InlineLeaves` reads it back off the caller's own numbering.
	export var countedValueRanges as ProvenIntRangeColumn
	export var orderFacts as OrderFacts
	export var lastCondition as ConditionOrdersSlot

	// ⭐⭐ **THE `.rdata` OP EACH CHARACTER-LITERAL VALUE WAS MATERIALIZED BY** — see `CharLiteralOpMap` for
	// what an integer position does with it and why the op must be REPLACED rather than orphaned.
	// Reset per function and SWAPPED across a closure body, exactly like the sibling value columns.
	export var charLiteralOps as CharLiteralOpTable
	export var plainConstantArrays as PlainConstantArrayTable
	export var literalColumns as LiteralColumnsTable
	export var provenFloatRanges as ProvenFloatRangeColumn
	export var frozenTuples as FrozenTupleTable
	export var lastTupleLiteral as LastTupleLiteral

	// ⭐⭐ **WHICH OP PRODUCED EACH `addressableBytes()` BYTE VIEW** — see `StringBytesViewOpMap` for what the
	// stream-write fold does with it and for the allocation it removes.
	// Reset per function and SWAPPED across a closure body, exactly like the sibling value columns.
	export var stringBytesViewOps as StringBytesViewOpTable

	// ⭐⭐ **WHERE EACH KNOWN-BYTE-POSITION `startIndex()`/`endIndex()` CALL WAS APPENDED** — see
	// `FoldedIndexCallSite` for the three walks this record replaces and for why a miss is a DECLINE.
	// Reset per function and SWAPPED across a closure body, exactly like the sibling value columns.
	export var foldedIndexCallSites as FoldedIndexCallSiteTable

	// ⭐⭐ **WHICH VALUES WERE READ OUT OF AN IMMUTABLE TOP-LEVEL GLOBAL** — the fact that
	// stops a `let`-declared array's record from being written through a mutable ALIAS.
	//
	// A top-level array binding is a heap record with a `.data` slot whichever keyword declared it, and a
	// `let` refuses the direct write (E2013 at an assignment; E3207 at a
	// receiver-writing method). But a
	// borrowed managed AGGREGATE bound to a `var` is promoted to owned by an INCREF of the SAME box
	// (`retainBorrowedAggregate` — reference semantics, deliberately: the alias is observable), so `var b = A`
	// followed by `b.push(9)` would write the immutable global's record with every direct guard intact. That
	// is a silent wrong answer, not a crash — MEASURED at 3 where 2 is correct — and it is reachable only
	// because an IMMUTABLE binding holds a shared mutable record (a `let`
	// String's read is COPIED on promotion, and a `let` byte string re-materializes a fresh record per read).
	//
	// ⚠ **THE MARK KEYS ON THE VALUE, and that is the point.** The alternative — testing the initializer's
	// TOKENS for a bare name and re-resolving it — would be a FOURTH encoding of the local→capture→top-level
	// resolution order, which this file already carries three copies of.
	// A value carries
	// where it came from with no order to re-derive and no shadow to mistake.
	//
	// A SPARSE set, not a dense per-value column like `valueOwnsHeap`: the population is the immutable-global
	// reads of ONE function, which is zero in every program that declares no array `let`. Reset per function
	// and SWAPPED across a closure body, exactly like the sibling value columns — a closure's value ids are
	// its own SSA space, so a mark that leaked across would name an unrelated value.
	//
	// ⚠ **A SET RATHER THAN A LIST, BECAUSE BOTH ENDS GROW WITH THE FUNCTION.** A scan of a
	// `ValueIdArray` at the one promotion gate is O(1) only if one of the two populations is bounded —
	// and neither is: the marks are this function's immutable-global reads and the scans are its borrowed
	// managed-aggregate promotions, so a single function carrying K of each pays Theta(K^2). MEASURED on a
	// ladder of K interleaved `g(A)` reads and `b = s` promotions, against the identical program with `A`
	// declared `var` (which marks nothing, so the two differ in exactly this structure): the scan's own cost
	// was 3.5 / 15.6 / 65.2 / 259.6 ms at K = 2,000 / 4,000 / 8,000 / 16,000 — x4.41, x4.19, x3.98 per
	// doubling, a textbook quadratic — and 39% of `phase:parse` at the top rung, while the `var` control
	// stayed flat at x1.99. It allocates almost nothing (the list's own geometric growth, +21 allocations at
	// K = 16,000), so `scale-test` is structurally blind to it and it had to be found by reading.
	export var imageRecordReads as ValueMarkColumn
	export var temporaryFieldReads as ValueMarkColumn
	export var immortalFunctionValues as ValueMarkColumn

	// ⭐⭐ **WHICH VALUES WERE READ OUT OF A SLOT THAT CAN BE REBOUND WHILE A NAME STILL HOLDS THE VALUE**
	// — a MUTABLE struct field (`self.items`, `h.items`) or a cell. The fact that makes such a read OWE A
	// REFERENCE the moment it is bound to a name.
	//
	// ⚠ **THE BORROW MODEL'S STRUCTURAL ARGUMENT DOES NOT REACH A WRITABLE SLOT.**
	// `declareInitializedBinding` leaves an immutable binding of a borrowed managed value BORROWED — no
	// retain, no scope-exit drop — on the reasoning stated at its `aliasImmutableSource` arm: "the owner
	// always outlives every alias of it, structurally". That holds for the borrows it was written against —
	// a PARAMETER (the caller owns the box and cannot be rebound from here) and an immortal `.rdata` literal
	// — because their owner is not storage this function can overwrite. A field IS:
	// the STORAGE outlives the alias, but the VALUE in it does not, and the store that replaces it drops
	// exactly the record the alias still names.
	//
	// `let old = items` + `items = fresh` inside a method, read back afterwards, must answer
	// `sum 10` / `sum 3`. A bare
	// `loadIndirect` with no retain dies **0xC0000005** on the next read, because the field store's
	// `__managed_decref` has freed the record. It is the one thing between here and a working corpus
	// `Map`: `Map.grow()` is four `let old… = <field>` binds followed by four field stores.
	//
	// ⚠ **A `var` OF THE SAME READ IS CORRECT**, which is what pins the cure: the mutable arm
	// promotes through `promoteBorrowedToOwned` and the identical program RUNS. So this mark does not invent
	// an ownership rule — it says which IMMUTABLE bindings owe the promotion the mutable ones already take.
	//
	// ⚠ **AN IMMUTABLE FIELD IS DELIBERATELY NOT MARKED.** `let` storage refuses the store (E2013 at
	// `emitCheckedSelfFieldStore` / `parseFieldAssignment`), so no write can replace its occupant and the
	// borrow's owner outlives it for the original structural reason. The mark is about REBINDABILITY, not
	// about being a slot.
	//
	// A SPARSE set, reset per function and SWAPPED across a closure body, exactly like the sibling value
	// marks — a mark names an id in THIS function's SSA space.
	export var overwritableSlotReads as ValueMarkColumn

	export var elementReads as ValueMarkColumn
	export var holdKinds as HoldKindColumn
	export var heldReads as ValueMarkColumn
	export var lateReads as LateReadArray

	export var witnessCursorElements as ValueMarkColumn

	// ⭐⭐ **WHICH OPAQUE PARAMETERS ARE `constructedValue` FEEDS THIS FRAME DOES NOT KEEP — the ones
	// the CALL SITE has already settled:** a by-reference feed, or a feed of a `T` no instantiation of
	// which can owe a reference or hold a green thread (`bindParameters`). `Box.create(v T)` doing
	// `Self{value: v}` hands `v` to the box the call RETURNS, and the concrete caller consumed its
	// argument to pay for that; so this store owes no reference, and taking one would leak the
	// caller's.
	//
	// ⚠ **IT CANNOT BE READ OFF `valueIsOpaqueOwned`**: `bindParameters` does not enrol such a
	// parameter owned, so the ownership bit says "borrowed" for a value whose reference is already
	// accounted for, and this is the distinction the store side needs. It is a mark of its own rather
	// than a widening of that bit because `isOpaqueOwnedFeedArg` and `transferConsumedArg` read that
	// bit to decide FORWARDING, where the answer for a constructor feed must stay what it is.
	//
	// A SPARSE set, reset per function and SWAPPED across a closure body, exactly like the sibling value marks.
	export var constructorFeedParams as ValueMarkColumn

	// The `constructedValue` feeds this frame keeps: enrolled owned, each with a `FeedDropGuard`.
	// Every store of one into a record takes its own reference through the descriptor, and the frame
	// releases its own at exit, or at the store when some instantiation holds a green thread
	// (`noteFeedStored`).
	export var coOwningFeedParams as ValueMarkColumn

	export var feedDropGuards as FeedDropGuardArray

	// ⭐⭐ **WHICH RECORDS THIS SHARED BODY BUILT HOLD A REFERENCE IT TOOK THROUGH THE DESCRIPTOR**
	// — the exact set whose drop, IF IT HAPPENS HERE, must release that reference.
	//
	// ⚠ **IT IS THE DROP HALF OF THE STORE, AND WITHOUT IT THE STORE IS A LEAK.** The record's type is
	// SUBSTITUTED at the caller (`Box.pack`'s `(self.v, 1)` is `__Tuple2.<T>.int` here and
	// `__Tuple2.String.int` there), so a caller's cascade releases the slot and this body's does NOT — the
	// declaration-view layout's `T` field is not managed, so `__destruct_` skips it and `__mm_decref` just
	// frees the box. MEASURED on `tuples/tuple-of-a-managed-type-parameter`: exit 101, the clone stranded.
	// A record RETURNED from here is moved out of the pending drops, so exactly one of the two views
	// releases it.
	//
	// A per-VALUE mark and not a per-LAYOUT rule, because the obligation is the STORE's: a record of the
	// same type filled from an already-owned value took no reference and must not release one.
	export var recordsOwningOpaqueSlots as ValueMarkColumn

	export var acquiredStates as ValueMarkColumn

	export var heldAcquire as HeldAcquire

	// ⭐⭐ **WHICH RECORDS THIS BODY BUILT BY FEEDING A BORROWED OPAQUE `T` IT THEN REFERENCED THROUGH THE
	// DESCRIPTOR** — the PROVENANCE half of the nested-view field refusal, and the half a TYPE
	// test cannot supply.
	//
	// ⛔⛔ **A TYPE TEST ALONE REFUSES A COMMITTED PROGRAM.** `generic-type-substitution`'s
	// `bare-generic-name-nested-three-levels` stores a `Cell` HANDED IN as a consumed parameter into `Mid`'s
	// field, and the whole chain is built CONCRETELY by `main` — nothing descriptor-mediated is involved and
	// the concrete `__destruct_Mid_String` releases it correctly. What must be refused is not the field's TYPE
	// but a record whose slot holds a reference THIS frame took through a descriptor it cannot hand to the
	// destructor that will free the record.
	//
	// ⚠ Its polarity is the opposite of `constructorFeedParams`: that one records a feed that took NO reference,
	// this one records the feed that DID.
	export var recordsHoldingReferencedOpaqueSlots as ValueMarkColumn

	// ⭐ Did the CALL now being emitted take a descriptor-mediated reference for a feed argument? Set while the
	// arguments are transferred and read once the call's result exists — the two cannot be one step, because
	// the result is what carries the mark and the arguments are settled before it is defined.
	export var callReferencedAnOpaqueFeedSlot as bool

	export var lastExitBlock as BlockId
	export var immutableSlotReads as ValueMarkColumn
	export var storedIntoImmutableSlot as ValueMarkColumn
	export var isolatedPartReads as ValueMarkColumn
	export var tiedPromises as ValueMarkColumn
	export let isolatedPartOrigins as IsolatedPartReadMap
	export var rebindAliasOps as UndecidedResultOpMap
	export var imagedLetInitializerStart as ElementIndex

	// ⭐⭐ **WHICH SSA VALUES DENOTE A `__ManagedMemory` BUFFER RATHER THAN THE `Array` AROUND IT** —
	// the fact `SignatureIndex.ManagedMemoryTypeName` says the binding costs, kept where the compiler keeps such facts.
	//
	// The reference has TWO TYPES for one record: `Array with T` exposes `count`/`push`/`get`, and
	// `__ManagedMemory with T` — reached through `Array`'s own `managed` field — exposes
	// `length`/`setLength`/`setByte`/`grow`/`byteAt`. The compiler SYNTHESIZES that record instead of compiling
	// `stdlib/Array.maxon`, so it has ONE `GenericInstanceId` for both and cannot tell the two surfaces apart
	// by type. It tells them apart by PROVENANCE instead: a value MINTED as a buffer
	// (`__ManagedMemory.create`, or a `slice` of one) carries the mark, and everything else is an ordinary
	// array. So `arr.setByte(0, 65)` stays E2015 on a user's `ByteArray` — which is what the language says,
	// and what `managed-memory-methods.error.managed-memory-mutator-is-not-an-array-method` pins.
	//
	// ⚠ **THE MARK KEYS ON THE VALUE, WHICH IS WHY A BINDING NEEDS NO ENTRY OF ITS OWN.** The compiler has no stack
	// slots: `let mm = <the create call>` binds the NAME to the call's own `ValueId`
	// (`declareValueBinding`), so `mm.setLength(3)` asks about the very value that was marked. The same
	// property is what `valueBrandIds` and `imageRecordReads` rest on.
	//
	// ⚠ Its REACH ends at a function boundary and at a struct field, and that limit is a REFUSAL rather than
	// a wrong answer: a `__ManagedMemory` PARAMETER carries no mark, so a buffer member called on one is the
	// ordinary unknown-`Array`-method E2015. No corpus case writes that (every one reaches the surface
	// through `.managed` or through `create`), and the day one does, the answer is a declared-type carrier,
	// not a wider mark.
	//
	// A SPARSE set for `imageRecordReads`' reason — the population is zero in every program that never
	// names `__ManagedMemory` — sharing the same module-level empty anchor discipline. Reset per function and
	// SWAPPED across a closure body, exactly like the sibling value marks.
	export var bufferSurfaceValues as ValueMarkColumn

	// ⭐ **WHICH OF A TUPLE VALUE'S SLOTS DENOTE THE BUFFER** — `bufferSurfaceValues` one container
	// deeper, and a SEPARATE carrier because a tuple slot and a whole value are different facts: `p` is an
	// ordinary tuple record whatever `p.0` denotes. Written where a declaration that spelled a tuple binds its
	// value (a parameter, a return, a field read); read at `emitFieldLoad`, which every `p.0`, every
	// `let (m, n) = …` and every chain hop funnels through.
	//
	// Sparse, reset per function and SWAPPED across a closure body, exactly like `bufferSurfaceValues`.
	export var bufferSurfaceSlots as ValueSlotSurfaceColumn

	// Whose elements denote the buffer: an array value declared through an alias written
	// `Array with __ManagedMemory`. Read at `emitContainerElementAccessor`.
	//
	// These three are separate carriers rather than one `Map with (ValueId, DeclaredSurface)` because
	// two writers legitimately fire on one value, and across separate carriers that is additive for
	// free. `parseArraySlice` calls `markBufferSurface(sliced)` and then
	// `inheritArrayElementSurface(sliced, …)`; `emitFieldLoad` calls `markDeclaredSurface` twice on
	// one result, once for the struct field's own declaration and once for the tuple slot's. Merged,
	// an `upsert` would silently overwrite the first.
	//
	// ⚠ They describe one value space, so `carryValueFacts`, which carries them onto a re-minted name,
	// must carry every one of them.
	export var bufferSurfaceElements as ValueMarkColumn

	// ⭐⭐ **WHOSE RECORD IS A *SIZED* CONTAINER'S OWN** — `bufferSurfaceValues` narrowed to the one
	// receiver on which a length-changing buffer member is a wrong answer rather than an operation. A
	// `FixedArray`'s size is a coordinate of its TYPE (`count()` is `countof(Self)`, folded to a literal), while
	// `get` and the walk answer out of the record's `length@8`; the three agree only while the record's length
	// is the type's count, and `setLength`/`append`/`clear`/`remove` are exactly the members that move it.
	// Read at `dispatchArrayMethod` beside `valueIsBufferSurface`, which is already a two-carrier answer to
	// the neighbouring question.
	//
	// ⚠ **IT IS A SEPARATE COLUMN AND NOT A FOURTH BIT OF `DeclaredSurface`, WHICH IS WHY IT IS NOT ON THE
	// TRIPLE ABOVE.** That surface's slot and element columns describe what a value CONTAINS; this describes
	// whose record the value IS, which has no per-slot and no per-element reading — a tuple of two sized
	// containers' buffers is not a thing any declaration can spell.
	//
	// ⚠ **EVERY VALUE IN IT IS ALSO IN `bufferSurfaceValues`, AND THE WRITERS OWE THAT** — see
	// `markSizedContainerBuffer`. The refusal reads this column alone for exactly that reason.
	//
	// Sparse, reset per function and SWAPPED across a closure body, exactly like `bufferSurfaceValues`.
	export var sizedContainerBufferValues as ValueMarkColumn

	// ⭐⭐ **THE INTEGERS WHOSE PATTERN IS NEGATIVE AND WHOSE VALUE IS NOT — every integer the source
	// wrote above `i64.max` (a literal, or a `u64.max` bound in EXPRESSION position), and every
	// unnamed fold of unsigned operands that lands there.**
	//
	// Such a value does not fit a signed 64-bit field and rides as its wrapped negative pattern (see
	// `ParsedRangeBound.exceedsSignedMax` for a bound and `parseIntLiteral` for a literal — this set
	// only carries the fact from the site that materializes the value to the sites that ask). So the
	// parser's constant column holds a negative number for it, and `integerValueDomain`'s
	// `constOf(value) >= 0` test — which is a SIGNED read of a pattern — answers `signed` for a value
	// the author wrote as non-negative.
	//
	// ⚠ **WITHOUT IT, `x > u64.max` IS A WRONG ANSWER AND NOT MERELY A MISSED OPTIMIZATION.** With `x`
	// declared `int(0 to u64.max)` the pair reads (declaredNonNegative, signed), the ordering rule
	// refuses the unsigned reading on the strength of the literal, and `3 > -1` answers **true** for a
	// comparison against the maximum of the domain.
	//
	// ⚠ **AND IT MUST NOT BE WIDENED TO "ANY NEGATIVE CONSTANT", which is why it is a mark and not a
	// test.** A literal `-1` the author actually wrote is a genuinely negative operand: `x > -1` for
	// the same `x` is TRUE at every value, and reading that `-1` as `u64.max` would answer false. The
	// two are the same 64 bits and are told apart only by what the source wrote, which is exactly what
	// this mark records and nothing downstream can re-derive.
	//
	// A per-value mark is sound here for `emitLiteralIn`'s reason: every literal mints a FRESH ValueId
	// (no interning), so a mark on one occurrence cannot reach another value. Sparse, reset per
	// function and SWAPPED across a closure body, exactly like the sibling value marks — and, with
	// `unsignedPatternValues`, HANDED to the function's `FunctionRangeChecks` for the lowering and
	// `InsertRangeChecks`, which cannot see a parser field.
	export var unsignedMaxLiterals as ValueMarkColumn
	export var unsignedPatternValues as ValueMarkColumn
	export var literalCounters as ValueMarkColumn
	export var boundedCounters as ValueMarkColumn
	export var undecidedMerges as ValueMarkColumn

	// Every literal this body wrote above `i64.max` is E2011 unless a context whose type admits it
	// marks it in `admittedUnsignedLiterals`; `reportBareUnsignedLiterals` reports the rest when the
	// function commits.
	export var unsignedLiteralSites as UnsignedLiteralSiteArray
	export var admittedUnsignedLiterals as ValueMarkColumn

	// ⚠ A call marked here range-checked every unsigned-full argument at the call site, and that is
	// what lets `EntryGuardWaivers` drop the callee's entry guard when every path reaching it is
	// marked (`UncheckedCallPaths`). Marking a call that did not check would let a negative argument
	// into a callee that no longer guards.
	export var checkedCalls as ValueMarkColumn
	export var wholeFieldDefaultCast as WholeInitializerCast
	export var fieldDefaultSlot as FieldDefaultSlot
	export var returnsAParameterDefault as bool
	export var resultFreezesWithItsInstance as bool
	export var mergedBindingValues as ValueMarkColumn

	// A merged binding with an unresolved incoming value: the result of a call already reported as an
	// error, such as an unknown method. Such a merge makes no ownership claim and its binding is not
	// judged for moves, so no ownership diagnostic follows the reported one. A program holding one
	// never lowers (`requireNoUnresolvedTagsSurvivedTheMaxonTier`).
	export var unresolvedMergeValues as ValueMarkColumn

	export var movedBindingValues as ValueMarkColumn
	export var capturedMoveValues as ValueMarkColumn
	export var movedIntoCalls as MovedIntoCallMap
	export var openKeptSites as OpenKeptSiteArray
	export var lentUniqueParams as ValueIdArray
	export var lentUniqueParamNames as NameRoster
	export var capturedPromiseReads as ValueMarkColumn
	export var letFieldPromiseReads as LetFieldPromiseNameMap
	export var loopHeldBindings as NameRoster

	// ⭐⭐ **THE LITERALS THE SOURCE WROTE AS NEGATIVE NUMBERS — `unsignedMaxLiterals`' COMPANION, AND THE
	// OTHER HALF OF WHAT 64 BITS CANNOT SAY.**
	//
	// `-1`, `u64.max` and `0xFFFFFFFFFFFFFFFE` all ride as bit-63-set patterns. The first denotes a
	// NEGATIVE number; the other two denote the two largest non-negative ones. `literalInRange`'s unsigned
	// arm — which reads a bit-63-set pattern as "a huge unsigned this range admits" — is right for the two
	// and WRONG for the one, so **`take(-1)` compiled silently into an `int(0 to u64.max)` parameter and
	// printed 18446744073709551615.** A declared lower bound of 0 says `≥ 0`, and it does not stop saying
	// it because the upper bound happens to be `u64.max`.
	//
	// ⚠ **IT IS THE NEGATIVE THAT IS MARKED, NOT THE NON-NEGATIVE, AND THE DIRECTION IS A DECISION.** The
	// dual — "prove a bit-63-set constant was WRITTEN non-negative, else read it as negative" — is complete
	// in a way this is not, and it would REFUSE every folded bit-63-set constant the corpus already passes
	// (an FNV offset basis, a `1 shl 63`, anything a `let` laundered) on the strength of a spelling roster
	// nobody has enumerated. This direction's failure mode is a MISSED refusal — today's answer, standing —
	// and its arrival roster is the two sites that mint a literal the source wrote a negative number for:
	// `parseNegatedNumericLiteral` (`-<intLiteral>`) and `parseTypeQualifiedBoundExpression`
	// (`i8.min` … `i64.min`, whose stored pattern IS its negative value).
	//
	// ⚠ **AND IT MUST NOT BE MERGED INTO `unsignedMaxLiterals`.** That set's meaning is "this
	// pattern's value is above `i64.max`", and a written `-1` is genuinely `-1`: `x > -1` is TRUE at
	// every `x` and must stay so.
	//
	// A per-value mark is sound here for `emitLiteralIn`'s reason: every literal mints a FRESH ValueId (no
	// interning), so a mark on one occurrence cannot reach another value. Sparse, reset per function and
	// SWAPPED across a closure body, exactly like the sibling value marks — and HANDED to the function's
	// `FunctionRangeChecks`, because the reader that raises the E3005 is `InsertRangeChecks` at the Std
	// tier and a parser field is not visible there.
	export var writtenNegativeLiterals as ValueMarkColumn

	// ⭐ **THE RANGE-CHECK SITES OF THE FUNCTION CURRENTLY BEING PARSED.** Three accumulators
	// plus the two names the function's own SIGNATURE fixes:
	//
	//   • `rangeCheckSites` — every position whose declared alias the parser holds in hand: an `as` cast
	//     into a ranged alias, a struct-literal field, a field store, a field's declared default, an
	//     array element. Each carries the alias name it resolved, and each owes BOTH halves of the rule —
	//     see `RangeCheckSite` for why the site no longer says so per site.
	//   • `rangeCheckArgSites` — a CALL ARGUMENT already folded to a constant. The alias is the callee's
	//     to name, not this file's (see `RangeCheckArgSite`), so the site names the callee instead.
	//   • `rangeCheckReturnSites` — every `return <expr>` in a ranged-alias-returning function.
	//   • `rangeCheckReturnAlias` — that alias (`undeclared` when the return type is not a ranged
	//   alias,
	//     which is what gates the return recording).
	//   • `rangeCheckParamSites` — one entry per NARROWED-RANGE PARAMETER: what this function's CALLERS
	//     read back to check a constant argument, and where `InsertRangeChecks` puts the entry guard that
	//     enforces the range on every other argument (see `RangeCheckParamSite`). EMPTY when no parameter
	//     is a ranged alias.
	//
	// All five start fresh with each body and are committed to the artifact at its end
	// (`recordFunctionRangeChecks`), keyed by the function's name — the `InsertRangeChecks` Std pass
	// reads them back by name.
	//
	// A closure body has its own and commits them under its own lifted name. It has to: a site names a
	// ValueId and a BlockId, and a closure is a separate `IrFunction` with its own dense numbering, so
	// a site that leaks across the boundary is resolved against numbers that mean something else. The
	// leak is reachable by an ordinary `as` inside a closure, and it kills a correct program.
	export var rangeCheckSites as RangeCheckSiteArray

	export var rangeCheckArgSites as RangeCheckArgSiteArray
	export var rangeCheckReturnSites as RangeCheckReturnSiteArray

	// Per-function symbol table. Reset per function.
	export var scope as Scope

	// Per-function ValueId allocator for the values this function's ops define.
	// Re-seeded at `paramCount` per function (params implicitly own 0..paramCount-1
	// by Std-ABI convention), so ids are dense and function-local. The parser is
	// where value numbering is BORN — see MaxonDialect's MaxonOp header.
	export var valueIds as ValueIdRef

	// The block expression parsing is emitting into, and it moves: a short-circuit `and`/`or` leaves
	// control in a fresh merge block, and everything after it — the rest of the expression, the
	// statement's own terminator, every statement that follows — must land there. A function returns
	// one value, and the expression parser's is the ValueId, so the exit block is published here.
	//
	// It starts at the shared `ParserAnchors.detachedBlock`, because a body state exists before its
	// entry block does. Every body points it at its real entry before an op is emitted, so nothing is
	// ever written to the anchor; an optional-block union would put a `match` at every emit site for a
	// case that cannot occur.
	export var currentBlock as IrBlock

	// Whether the op that defined a value minted its record: `valueOwnsHeapAlone` at the instant of
	// the
	// mint, which that column stops saying the moment a second owner is taken (`markValueCoOwnsHeap`). A
	// downgrade makes a second name for the record, not an alias of what built it, so the question
	// `ValueOrigins` asks — is this value fresh, or one of its operands? — needs the claim as it
	// was made. Set only by `markValueOwnsHeap`'s `sole` arm, and filed as `IrFunction.valueMintedSole`.
	export var valueMintedSole as BoolArray

	export let functionReturnSpelling as immutable ByteArray
	export let functionReturnBrand as immutable ByteArray
	export var resultOrigin as ReceiverOrigin

	// Has the function being parsed been published as one whose return may alias an immutable global?
	// Read at one place, the `returned` door of `ownedFormOfBorrowedValue`, where it decides between
	// letting a marked value escape (the caller has been told, and marks what it gets back) and the
	// E2015 refusal (the caller has not been told, so an escape would launder the record into an
	// untracked alias).
	//
	// ⚠ It is the sweep's answer, not this parse's: the sweep recognises a deliberately narrow set of
	// `return` shapes (`noteReturnedGlobalOrForward`), and every shape it does not recognise arrives
	// here false and is refused.
	//
	// It is false inside a closure body, the indirect-call boundary: a closure has no static callee,
	// so no call site can be told to mark what calling one returns. A closure's fresh state carries
	// `false`, so the boundary needs no test of its own.

	export var returnsAReceiverField = false

	// The capture set of the closure being parsed. Populated by `captureEnclosing` as the body reads
	// enclosing names (first-seen order = env slot order), and read by `parseClosureExpression` after
	// the body parse to build the env block, one `storeIndirect` per capture, by value.
	export var captureNames as NameRoster

	export var captureValues as CapturedValueArray
	export var captureTypes as MaxonTypeArray

	// Where each capture was first read — the position its hand-off into the closure is blamed at.
	export var captureAnchors as TokenArray

	// ⭐ **WHICH OF THOSE SLOTS CARRY AN INHERITED WITNESS RATHER THAN A NAMED BINDING** — the subset
	// whose `captureValues` entry is `CapturedValue.unfilled` until it is closed by
	// `fillInheritedWitnessCaptures` after the restore. It is the AUTHORITY on which constraint owns which
	// slot: `captureSlotFor`'s name dedup would answer the same question, but only this list also carries the
	// pending fill, and one list answering both cannot drift from the other. Swapped across a nested closure
	// body exactly like the three columns above, so each closure closes its own hop.
	export var inheritedWitnessCaptures as InheritedWitnessCaptureArray

	export var closureEnv as ClosureEnvParam
	export var rangeCheckReturnAlias as DeclaredAlias
	export let rangeCheckParamSites as RangeCheckParamSiteArray

	export var layoutParam as HiddenWordParam

	export var droppedAWitnessCursorElement as bool

	// The hidden fixed-element-count parameter, when the function reserved one. `parseCountof` reads
	// it to decide whether the descriptor-free `countof(Self)` read can be served at all, so a
	// spelling the token pre-scan could not see becomes a positioned refusal rather than a reservation
	// the lowering discovers is missing. The slot's ValueId is resolved by the parser at the
	// reservation, as `witnessParamValueId` resolves its own, because the reader is the parser itself:
	// `countof(Self)` reads the entry block's `param` directly, and minting a copy would be a second
	// definition of one answer plus a `mov` per read.
	export var fixedElementCountParam as HiddenWordParam

	// ⭐ **IS THIS BODY A STATIC FACTORY — a `static function` of a `type`, returning that type?** The one
	// declaration shape in which `self.<field> = …` means anything: there is no receiver, and what the
	// assignment describes is the value the `Self{…}` below it will be. Everywhere else `self` outside an
	// instance method stays E2001.
	export let inNascentSelfFactory as bool

	// ⭐ **WHICH KIND OF BODY IS BEING PARSED (see `EnclosingBodyKind`).** Written where a body BEGINS —
	// `parseFunction`, `parseDefaultHelperBody` and `parseClosureExpression` — and saved/restored by the
	// closure, which is the one re-entrant door into a body: a closure written mid-body must not leave the
	// enclosing function looking like a closure after its `end`.
	export let enclosingBodyKind as EnclosingBodyKind

	// ⭐⭐ **THE LOCAL NAMES THIS BODY MUST GIVE A CELL** — filled once per function by
	// `cellLocalNamesIn` and read at every `var` declaration. Stays `unwritten` for every body that needs
	// none, which is every body in a program that neither marks a parameter `mutable` nor captures a mutated `var`.
	export var bodyStart = 0 as ElementIndex
	export var outerBodyStart = 0 as ElementIndex
	export var boundParams as CellLocalNameRoster
	export var cellLocalNames as CellLocalNameRoster
	export var cellOccupantReads as CellOccupantReadColumn
	export var cellEpochExclusivity as CellEpochExclusivityColumn
	export var handedCellTypes as HandedCellTypeColumn
	export var brandOrigins as BrandOriginColumn
	export var capturedSlots as CapturedSlotColumn
	export var handedBrands as HandedBrandColumn
	export var callTrailerOps as CallTrailerSet

	// The state every body starts from: a declared function and a default helper
	// (`beginDeclaredBody`), and a closure, which swaps it in for the enclosing body's and swaps that
	// back at its end (`parseClosureExpression`). Value ids and block ids restart with each function,
	// so a column left standing would name an unrelated value or block in the next body. ⚠ Every field
	// is a fresh or shared-empty object, because a closure's saved state still holds the enclosing
	// body's objects.
	static function fresh(anchors ParserAnchors, firstValueId ValueId, returnSpelling ByteArray, returnBrand ByteArray, closureEnv ClosureEnvParam, returnAlias DeclaredAlias, paramSites RangeCheckParamSiteArray, layoutParam HiddenWordParam, countParam HiddenWordParam, nascentSelfFactory bool, kind EnclosingBodyKind) returns FunctionBodyState
		return Self{
			scope: Scope.create(),
			valueIds: ValueIdRef.create(firstValueId),
			currentBlock: anchors.detachedBlock,
			valueMintedSole: BoolArray.create(0),
			functionReturnSpelling: returnSpelling,
			functionReturnBrand: returnBrand,
			resultOrigin: noResultOrigin,
			captureNames: NameRoster.create(0),
			captureValues: CapturedValueArray.create(0),
			captureTypes: MaxonTypeArray.create(0),
			captureAnchors: TokenArray.create(0),
			inheritedWitnessCaptures: InheritedWitnessCaptureArray.create(0),
			closureEnv: closureEnv,
			rangeCheckReturnAlias: returnAlias,
			rangeCheckParamSites: paramSites,
			layoutParam: layoutParam,
			fixedElementCountParam: countParam,
			droppedAWitnessCursorElement: false,
			inNascentSelfFactory: nascentSelfFactory,
			enclosingBodyKind: kind,
			cellLocalNames: noCellLocalNames,
			boundParams: noCellLocalNames,
			cellOccupantReads: CellOccupantReadColumn.unwritten,
			cellEpochExclusivity: CellEpochExclusivityColumn.unwritten,
			handedCellTypes: HandedCellTypeColumn.unwritten,
			brandOrigins: BrandOriginColumn.unwritten,
			capturedSlots: CapturedSlotColumn.unwritten,
			handedBrands: HandedBrandColumn.unwritten,
			callTrailerOps: CallTrailerSet.create(),
			mutableVars: VarInfoArray.create(0),
			mutableVarShadowed: anchors.mutableVarShadowed,
			mutableVarInnermost: noMutableVarInnermost,
			// A stray owned binding would emit a `__mm_decref` of a value from the previous function's SSA
			// space — a wild pointer the leak gate cannot report, because the count still balances.
			ownedBindings: VarInfoArray.create(0),
			moveLedger: MoveLedger.create(),
			// A candidate left over from the previous function would be reported against this function's
			// `end`.
			unusedCandidates: UnusedBindingCandidateArray.create(0),
			functionMintedValueAliases: false,
			promiseConsumes: PromiseConsumes.none(),
			enumAccessorReads: EnumAccessorReadArray.create(0),
			nascentSelfWrites: NascentSelfWriteArray.create(0),
			nascentSelfChecks: NascentSelfCheckArray.create(0),
			// E3012's and E3077's name-keyed accounting: a name mentioned in the previous function would
			// excuse a candidate of that name here.
			referencedNames: NameRoster.create(0),
			mutabilityExercisedNames: NameRoster.create(0),
			pendingTempDrops: ValueIdArray.create(0),
			lastFieldRead: LastFieldRead.none,
			lastRuntimeRead: LastRuntimeRead.none,
			loops: LoopContextArray.create(0),
			// Fresh per function, with its companion flag — see the `tryBlocks` field declaration for why.
			tryBlocks: TryBlockContextArray.create(0),
			throwRouteClaim: ThrowRouteClaim.unclaimed,
			holdsSendForTryAwait: false,
			statementNesting: 0,
			replyDeferred: false,
			consumesSelf: false,
			anyLinearOwned: false,
			consumedReceivers: ValueIdArray.create(0),
			tryTargetMustStayACall: false,
			loopClaimsWithIteratorPromise: false,
			matches: MatchContextArray.create(0),
			errorUnionBindings: ErrorUnionBindingArray.create(0),
			boxedMemberArms: BoxedMemberArmArray.create(0),
			tryBindingName: TryBinding.none,
			tryBindingMatched: false,
			valueTags: ValueTypeTagArray.create(0),
			debugLocals: DebugLocalDeclArray.create(0),
			debugBindings: VarInfoArray.create(0),
			debugOpenSlots: DebugLocalSlotArray.create(0),
			valueNameIds: TypeNameIdArray.create(0),
			valueConsts: FullRangeIntArray.create(0),
			valueConstDomains: ConstPayloadDomainArray.create(0),
			valueOwnsHeap: BoolArray.create(0),
			valueOwnsHeapAlone: BoolArray.create(0),
			valueFromFreshReturn: BoolArray.create(0),
			valuePromiseMarks: BoolArray.create(0),
			nodeHandleMintedFrom: ValueIdArray.create(0),
			promiseSlotContainer: ValueIdArray.create(0),
			promiseSlotIndex: ValueIdArray.create(0),
			promiseSlotIsAField: BoolArray.create(0),
			promiseSlotCarriers: ValueIdArray.create(0),
			aliasUnprovenMarks: BoolArray.create(0),
			blockPositions: BlockIndexById.create(),
			blockPositionsCovered: 0,
			valueWitnessIds: ValueIdArray.create(0),
			inMatchArmBody: false,
			valueBrandIds: TypeNameIdArray.create(0),
			valueCapabilities: ValueCapabilityArray.create(0),
			regionFacts: noRegionFacts,
			operandOrder: OperandOrder.create(),
			pendingLocalCapability: ParamCapability.unmarked,
			pendingLocalCapabilityEnd: 0,
			seededExitPhis: ValueIdArray.create(0),
			declaredReturnCapability: ResultCapability.unmarked,
			statementStart: 0,
			returnsFromParams: NoParamPositions,
			returnsOtherwise: false,
			returnsFrozenData: false,
			returnsMutableData: false,
			returnsAnUnknownValue: false,
			frozenResultRefusal: DeferredRefusal.none,
			discardedReplies: ValueIdArray.create(0),
			undecidedResults: UndecidedResultOpMap.create(),
			mergedSettlingOps: MergedSettlingOpMap.create(),
			emittedCall: EmittedCallOp.none,
			literalCallOps: FuncIndexArray.create(0),
			authoredMemberCalls: AuthoredMemberCallArray.create(0),
			liftedClosureBodies: OpSpanArray.create(0),
			declaredMutableParams: NoParamPositions,
			valueExistentialInstance: noValueExistentialInstances,
			valueExistentialScope: noValueExistentialScopes,
			valueCallInstance: noValueCallInstances,
			existentialFieldStores: ExistentialFieldStoreArray.create(0),
			valueDeclaredAlias: noValueDeclaredAliases,
			literalCasts: noLiteralCasts,
			literalCastArguments: noLiteralCastArguments,
			letCasts: noLetCasts,
			scratchCellFills: noScratchCellFills,
			argumentStorage: noValueMarks,
			borrowedScratchCells: noValueMarks,
			deferredArgumentBindings: DeferredArgumentBindingColumn.unwritten,
			pendingOverlaps: PendingOverlapColumn.unwritten,
			loopScans: LoopMoveScanArray.create(0),
			dropCascade: DropCascadeState.unbuilt,
			wrapOperands: noWrapOperands,
			countedValueRanges: noProvenIntRanges,
			orderFacts: OrderFacts.create(),
			lastCondition: ConditionOrdersSlot.none,
			charLiteralOps: noCharLiteralOps,
			plainConstantArrays: noPlainConstantArrays,
			literalColumns: noLiteralColumns,
			provenFloatRanges: noProvenFloatRanges,
			frozenTuples: noFrozenTuples,
			lastTupleLiteral: LastTupleLiteral.none,
			stringBytesViewOps: noStringBytesViewOps,
			foldedIndexCallSites: noFoldedIndexCallSites,
			imageRecordReads: noValueMarks,
			temporaryFieldReads: noValueMarks,
			immortalFunctionValues: noValueMarks,
			overwritableSlotReads: noValueMarks,
			elementReads: noValueMarks,
			holdKinds: noHoldKinds,
			heldReads: noValueMarks,
			lateReads: LateReadArray.create(0),
			witnessCursorElements: noValueMarks,
			constructorFeedParams: noValueMarks,
			coOwningFeedParams: noValueMarks,
			feedDropGuards: FeedDropGuardArray.create(0),
			recordsOwningOpaqueSlots: noValueMarks,
			acquiredStates: noValueMarks,
			heldAcquire: HeldAcquire.none,
			recordsHoldingReferencedOpaqueSlots: noValueMarks,
			callReferencedAnOpaqueFeedSlot: false,
			lastExitBlock: NoExitBlock,
			immutableSlotReads: noValueMarks,
			storedIntoImmutableSlot: noValueMarks,
			isolatedPartReads: noValueMarks,
			tiedPromises: noValueMarks,
			isolatedPartOrigins: IsolatedPartReadMap.create(),
			rebindAliasOps: UndecidedResultOpMap.create(),
			imagedLetInitializerStart: NoImagedLetInitializer,
			bufferSurfaceValues: noValueMarks,
			bufferSurfaceSlots: noBufferSurfaceSlots,
			bufferSurfaceElements: noValueMarks,
			sizedContainerBufferValues: noValueMarks,
			unsignedMaxLiterals: noValueMarks,
			unsignedPatternValues: noValueMarks,
			literalCounters: noValueMarks,
			boundedCounters: noValueMarks,
			undecidedMerges: noValueMarks,
			unsignedLiteralSites: UnsignedLiteralSiteArray.create(0),
			admittedUnsignedLiterals: noValueMarks,
			checkedCalls: noValueMarks,
			wholeFieldDefaultCast: WholeInitializerCast.none,
			fieldDefaultSlot: FieldDefaultSlot.notADefault,
			returnsAParameterDefault: false,
			resultFreezesWithItsInstance: false,
			mergedBindingValues: noValueMarks,
			unresolvedMergeValues: noValueMarks,
			movedBindingValues: noValueMarks,
			capturedMoveValues: noValueMarks,
			movedIntoCalls: MovedIntoCallMap.create(),
			openKeptSites: OpenKeptSiteArray.create(0),
			lentUniqueParams: ValueIdArray.create(0),
			lentUniqueParamNames: NameRoster.create(0),
			capturedPromiseReads: noValueMarks,
			letFieldPromiseReads: LetFieldPromiseNameMap.create(),
			loopHeldBindings: NameRoster.create(0),
			writtenNegativeLiterals: noValueMarks,
			rangeCheckSites: RangeCheckSiteArray.create(0),
			rangeCheckArgSites: RangeCheckArgSiteArray.create(0),
			rangeCheckReturnSites: RangeCheckReturnSiteArray.create(0)
		}
	end 'fresh'

	export function carriesLayoutParam() returns bool
		return hiddenWordParamIsCarried(self.layoutParam)
	end 'carriesLayoutParam'
end 'FunctionBodyState'

union QualifiedTypeBase
	none
	at(index ElementIndex, name immutable ByteArray, declFilePath FilePath)
end 'QualifiedTypeBase'

type TypeDeclarationHeader
	export let name as immutable ByteArray
	export let kind as TypeDeclKind
	export let visibility as Visibility
	export let nameLine as LineNumber
	export let nameColumn as ColumnNumber

	static function create(name ByteArray, kind TypeDeclKind, visibility Visibility, nameLine LineNumber, nameColumn ColumnNumber) returns TypeDeclarationHeader
		return Self{name: name, kind: kind, visibility: visibility, nameLine: nameLine, nameColumn: nameColumn}
	end 'create'
end 'TypeDeclarationHeader'

typealias TypeDeclarationHeaderArray = Array with TypeDeclarationHeader

type TopLevelBindingHeader
	export let name as immutable ByteArray
	export let visibility as Visibility

	static function create(name ByteArray, visibility Visibility) returns TopLevelBindingHeader
		return Self{name: name, visibility: visibility}
	end 'create'
end 'TopLevelBindingHeader'

typealias TopLevelBindingHeaderArray = Array with TopLevelBindingHeader

type TopLevelDeclarationHeaders
	export var types as TypeDeclarationHeaderArray
	export var bindings as TopLevelBindingHeaderArray

	static function create() returns TopLevelDeclarationHeaders
		return Self{types: TypeDeclarationHeaderArray.create(0), bindings: TopLevelBindingHeaderArray.create(0)}
	end 'create'
end 'TopLevelDeclarationHeaders'

typealias SettledTypeNameMap = Map with (ByteArray, TypeNameHiding)

export type BlockExtents
	export let tokens as TokenArray
	export let extentEnds as TokenIndexArray
	export let keywordNames as TokenIndexArray
	export let declaredNameKeywords as TokenIndexArray

	static function create(tokens TokenArray, extentEnds TokenIndexArray, keywordNames TokenIndexArray, declaredNameKeywords TokenIndexArray) returns BlockExtents
		return Self{tokens: tokens, extentEnds: extentEnds, keywordNames: keywordNames, declaredNameKeywords: declaredNameKeywords}
	end 'create'
end 'BlockExtents'

// Built by the header walk and adopted by the same file's fold, so the block-extent walk runs
// once per token array.
typealias BlockExtentsByPath = Map with (String, BlockExtents)

union DeclaredTupleTarget
	none
	layout(name immutable ByteArray)
end 'DeclaredTupleTarget'

let NoDeclaredTupleTarget = DeclaredTupleTarget.none

function tupleTargetNamed(name ByteArray) returns DeclaredTupleTarget
	return DeclaredTupleTarget.layout(name) if isTupleTypeName(name) else NoDeclaredTupleTarget
end 'tupleTargetNamed'

// A verdict rather than a throw, because its two readers act on a hidden name differently: a body
// records it and parses on (`settleTypeNameVerdict`), while a constant initializer's walk throws it
// (`refuseHiddenTypeName`), since that walk's artifact is discarded and a recorded refusal would
// vanish.
union HiddenNominal
	none
	named(name immutable ByteArray)
	aliasSpelled(written immutable ByteArray)
end 'HiddenNominal'

function bareNominalOf(kind HiddenSymbolKind, noun ByteArray) returns HiddenNominal
	return match kind 'kind'
		typeDeclaration gives HiddenNominal.named(noun)
		typeAliasDeclaration gives HiddenNominal.aliasSpelled(noun)
		functionDeclaration or
		staticMember panic("bareNominalOf: a bare type name is hidden as a type or a typealias, never as a function or a static")
	end 'kind'
end 'bareNominalOf'

union TypeNameVerdict
	nameable
	hidden(kind HiddenSymbolKind, tier Visibility, noun immutable ByteArray, nominal HiddenNominal, anchor Token)
end 'TypeNameVerdict'

enum TypeNameHeadForm
	reference
	construction
end 'TypeNameHeadForm'

type TypeNameHead
	export let token as Token
	export let identity as immutable ByteArray
	export let verdict as TypeNameVerdict

	static function create(token Token, identity ByteArray, verdict TypeNameVerdict) returns TypeNameHead
		return Self{token: token, identity: identity, verdict: verdict}
	end 'create'
end 'TypeNameHead'

function hiddenMembersRefusal(typeName ByteArray, visibility Visibility, memberTok Token) returns SourceParseError
	return SourceParseError.hiddenTypeMembers(String.from(typeName), tier: visibility, line: memberTok.line, column: memberTok.column)
end 'hiddenMembersRefusal'

function typeNameVerdictOf(hiding TypeNameHiding, noun ByteArray, anchor Token) returns TypeNameVerdict
	return match hiding 'hiding'
		notHidden or
		declaredInAnotherLayer gives TypeNameVerdict.nameable
		hidden(kind, tier) gives TypeNameVerdict.hidden(kind, tier: tier, noun: noun, nominal: bareNominalOf(kind, noun: noun), anchor: anchor)
	end 'hiding'
end 'typeNameVerdictOf'

union SpawnedType
	declared(declaration ChainType, consumed ElementIndex)
	named(typeName immutable ByteArray)

	function typeName() returns immutable ByteArray
		return match self 'spawned'
			declared(declaration, _) gives declaration.name
			named(typeName) gives typeName
		end 'spawned'
	end 'typeName'
end 'SpawnedType'

union QualifiedTypeChain
	declared(declaration ChainType, consumed ElementIndex)
	notQualified

	function denotedName(spelled immutable ByteArray) returns immutable ByteArray
		return match self 'chain'
			declared(declaration, _) gives nominalNameOr(declaration.kind, name: declaration.name, spelling: spelled)
			notQualified gives spelled
		end 'chain'
	end 'denotedName'
end 'QualifiedTypeChain'

type GenericBindingScope
	export let names as immutable NameRoster
	export let bound as GenericFunctionArgumentArray
	export let constraints as WhereConstraintArray

	static function over(names immutable NameRoster, bound GenericFunctionArgumentArray, constraints WhereConstraintArray) returns GenericBindingScope
		return Self{names: names, bound: bound, constraints: constraints}
	end 'over'

	static function empty() returns GenericBindingScope
		return Self{names: freeze NameRoster.create(0), bound: GenericFunctionArgumentArray.create(0), constraints: WhereConstraintArray.create(0)}
	end 'empty'
end 'GenericBindingScope'

union ConformanceOwner
	declaration(conformer immutable ByteArray)
	unchecked
end 'ConformanceOwner'

type HeldAssociatedUse
	export let associatedPosition as ElementIndex
	export let held as ExtensionHeldArgument

	static function create(associatedPosition ElementIndex, held ExtensionHeldArgument) returns HeldAssociatedUse
		return Self{associatedPosition: associatedPosition, held: held}
	end 'create'
end 'HeldAssociatedUse'

typealias HeldAssociatedUseArray = Array with HeldAssociatedUse

// The sweep notes each container argument an extension body writes over an associated type
// (`noteInterfaceBindingHeldAsArgument`), for every conformer's binding to be judged against; the
// real parse reads an associated type a conformer binds to an interface as that interface
// (`extensionAssociatedType`).
enum ExtensionBodyPass
	sweep
	parse
end 'ExtensionBodyPass'

type ExtensionAssociatedScope
	export let names as immutable NameRoster
	export let bindings as RequirementTypeArray
	export let bindingFilePath as FilePath
	export let pass as ExtensionBodyPass
	export var heldUses as HeldAssociatedUseArray

	static function over(names NameRoster, bindings RequirementTypeArray, bindingFilePath FilePath, pass ExtensionBodyPass) returns ExtensionAssociatedScope
		return Self{names: names, bindings: bindings, bindingFilePath: bindingFilePath, pass: pass, heldUses: HeldAssociatedUseArray.create(0)}
	end 'over'

	static function empty() returns ExtensionAssociatedScope
		return Self{names: freeze NameRoster.create(0), bindings: RequirementTypeArray.create(0), bindingFilePath: CompilerOwnedDeclFilePath, pass: ExtensionBodyPass.sweep, heldUses: HeldAssociatedUseArray.create(0)}
	end 'empty'
end 'ExtensionAssociatedScope'
