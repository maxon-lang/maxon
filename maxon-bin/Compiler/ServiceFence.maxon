export typealias FenceTicket = int(0 to u64.max)
export typealias StallMilliseconds = int(0 to 60000)

let TailStallVariable = "MAXON_TEST_SERVICE_TAIL_STALL_MS"

export typealias FenceCell = SharedValue with FenceTicket

// A `fence` message takes only a scalar and frees nothing after it publishes its arrival: a managed
// payload dropped after the publish would be the free the fence exists to wait out.
export interface Fenceable
	function fence(mutable self, ticket FenceTicket)
end 'Fenceable'

function tailStallFromEnvironment() returns StallMilliseconds
	let text = try Process.environmentVariable(TailStallVariable) otherwise (e) 'unset'
		match e 'error'
			variableUnset then return 0
			environmentUnreadable then return 0
			pathUnavailable then return 0
		end 'error'
	end 'unset'

	let milliseconds = try int.fromString(text) otherwise panic("{TailStallVariable} is '{text}', which is not a count of milliseconds")

	if milliseconds < 0 or milliseconds > 60000 'outOfRange'
		panic("{TailStallVariable} is {milliseconds}, which is outside 0 to 60000 milliseconds")
	end 'outOfRange'

	return milliseconds as StallMilliseconds
end 'tailStallFromEnvironment'

function pauseServiceTail(stall StallMilliseconds)
	if stall > 0 'stalling'
		sleep(stall as Milliseconds)
	end 'stalling'
end 'pauseServiceTail'

function newFenceCell() returns FenceCell
	return FenceCell.create(0 as FenceTicket)
end 'newFenceCell'

type FenceMember
	let handle as Fenceable.handle
	let arrivals as FenceCell
	let issued as FenceCell
	var ticket as FenceTicket

	static function of(handle Fenceable.handle, arrivals FenceCell, issued FenceCell) returns Self
		return Self{handle: handle, arrivals: arrivals, issued: issued, ticket: 0}
	end 'of'

	function claimTicket() returns FenceTicket
		while true 'untilClaimed'
			let seen = self.issued.current()
			let next = seen + 1

			if self.issued.publish(next, replacing: seen) 'claimed'
				return next
			end 'claimed'
		end 'untilClaimed'
	end 'claimTicket'

	function sendFence()
		self.ticket = self.claimTicket()

		// A shared member's fences must reach its mailbox in ticket order: an arrival of a later ticket
		// would otherwise stand for an earlier settler's messages still queued.
		while self.arrivals.current() + 1 < self.ticket 'behindAnotherSettler'
			Scheduler.yield()
		end 'behindAnotherSettler'

		try self.handle.fence(self.ticket) otherwise (e) 'refused'
			match e 'why'
				mailboxFull then panic("ServiceFence.settle: an enrolled service's mailbox is full, so it cannot take the fence that waits for its last message to finish")
				serviceStopped then panic("ServiceFence.settle: an enrolled service stopped while the fence still held its handle")
			end 'why'
		end 'refused'
	end 'sendFence'

	function awaitFence()
		while self.arrivals.current() < self.ticket 'awaitingTheFence'
			Scheduler.yield()
		end 'awaitingTheFence'
	end 'awaitFence'
end 'FenceMember'

typealias FenceMemberArray = Array with FenceMember

export type ServiceFence
	var members as FenceMemberArray

	export static function create() returns ServiceFence
		return Self{members: FenceMemberArray.create(0)}
	end 'create'

	export function enroll(handle Fenceable.handle, arrivals FenceCell)
		self.members.push(FenceMember.of(handle, arrivals: arrivals, issued: newFenceCell()))
	end 'enroll'

	export function enrollShared(handle Fenceable.handle, arrivals FenceCell, issued FenceCell)
		self.members.push(FenceMember.of(handle, arrivals: arrivals, issued: issued))
	end 'enrollShared'

	// A member drops each message's payloads after its handler returns, and runs messages in order, so
	// an arrived `fence` means no free from an earlier answer is still to come.
	export function settle()
		for member in self.members 'eachMember'
			member.sendFence()
		end 'eachMember'

		for member in self.members 'eachArrival'
			member.awaitFence()
		end 'eachArrival'
	end 'settle'

	export function dismiss()
		self.settle()
		self.members.clear()
	end 'dismiss'

	export function release()
		self.members.clear()
	end 'release'
end 'ServiceFence'
