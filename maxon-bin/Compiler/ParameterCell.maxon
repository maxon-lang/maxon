let ParameterCellValueOffset = 0 as ByteOffset

let ParameterCellWitnessOffset = ParameterCellValueOffset + InterfaceWitnessHalfOffset

let ParameterCellBytes = (ParameterCellWitnessOffset + MachineWordBytes) as FullRangeInt

let ParameterCellAllocName = b"__mm_param_cell"

function parameterCellCrossesASpawn(tag ValueTypeTag) returns bool
	return tag != ValueTypeTag.typeParameter
end 'parameterCellCrossesASpawn'

function parameterRidesACellIntoASpawn(byReference ParamPositionMask, param ParamCount, paramType MaxonType) returns bool
	return maskHasParam(byReference, param: param) and parameterCellCrossesASpawn(maxonTypeTag(paramType))
end 'parameterRidesACellIntoASpawn'

function parameterCellHoldsAWitness(cellType MaxonType) returns bool
	return maxonTypeTag(cellType) == ValueTypeTag.interfaceRef
end 'parameterCellHoldsAWitness'

function byReferenceMaskOf(byRef ByRefConvention, paramCount ParamCount) returns ParamPositionMask
	var mask = NoParamPositions

	if not byRef.statesAnything() 'everyParameterByValue'
		return mask
	end 'everyParameterByValue'

	for i in 0 upto paramCount 'eachParam'
		if byRef.paramIsByRef(i) 'arrivesAsACellAddress'
			mask = maskWithParam(mask, param: i)
		end 'arrivesAsACellAddress'
	end 'eachParam'

	return mask
end 'byReferenceMaskOf'
