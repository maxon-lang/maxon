extension Parser
	function emitAwait(func IrFunction, promise ValueId, awaitTok Token) returns ValueId throws SourceParseError
		match try self.awaitOperandOf(func, promise: promise, awaitTok: awaitTok) 'operand'
			promise(facts) then return try self.emitRoutedAwait(promise, facts: facts, awaitTok: awaitTok)
			deferred(result) then return result
		end 'operand'
	end 'emitAwait'

	// `await p`, plain. It lowers to `__gt_await`, which yields only the result and drops the error
	// flag, so a throwing promise's await must reach a handler: an enclosing block-form `try` or a
	// test body's implied handler takes it through the router, one under a claim is held until the
	// claim releases or refuses it (`closeClaim`), and one nothing catches is refused here (E3057).
	// The `try await` target reaches `emitAwaitOp` without this, because catching the error is what
	// `try await` does.
	function emitRoutedAwait(promise ValueId, facts AwaitedPromise, awaitTok Token) returns ValueId throws SourceParseError
		let clause = self.tryTargetThrows(facts.tryTarget)
		let position = self.throwRouteDestination()
		let claimed = claimCovers(self.bodyState.throwRouteClaim, destination: position)

		if not claimed and position == ThrowRouteDestination.nowhere 'nothingCatchesIt'
			try self.rejectPlainAwaitOfThrowing(facts.tryTarget, clause: clause, awaitTok: awaitTok)
		end 'nothingCatchesIt'

		let (result, opIdx) = try self.emitAwaitOp(promise, facts: facts, awaitTok: awaitTok)

		if claimed 'heldByTheClaim'
			self.heldAwaits.push(HeldAwait.create(opIdx, target: facts.tryTarget, clause: clause, awaitTok: awaitTok))
		end 'heldByTheClaim' else 'routedNow'
			self.routeThrowingOp(position, opIdx: opIdx, clause: clause, result: result)
		end 'routedNow'

		return result
	end 'emitRoutedAwait'

	function requireNoAwaitHeldAcrossFunctions()
		if self.heldAwaits.count() > 0 'aClaimLeftOneBehind'
			panic("requireNoAwaitHeldAcrossFunctions: {self.heldAwaits.count()} held await(s) outlived the claims that held them into a new function body — every claim that holds an await releases or refuses it before its statement ends")
		end 'aClaimLeftOneBehind'
	end 'requireNoAwaitHeldAcrossFunctions'

	// A non-promise operand (`await x` over an integer) is refused here, ahead of
	// `awaitedPromiseFacts`, which would panic on it; a deferred one awaits to a value derived from
	// it.
	function awaitOperandOf(func IrFunction, promise ValueId, awaitTok Token) returns AwaitOperand throws SourceParseError
		if not self.valueIsPromise(promise) 'notPromise'
			return AwaitOperand.deferred(try self.deferredResultOrRefusal(SourceParseError.awaitNonPromise(self.awaitOperandKindName(promise), line: awaitTok.line, column: awaitTok.column), value: promise))
		end 'notPromise'

		return AwaitOperand.promise(self.awaitedPromiseFacts(func, promise: promise))
	end 'awaitOperandOf'

	// E3057 for a plain `await` of a throwing promise nothing catches: asked by `emitRoutedAwait`, and
	// by `closeClaim` for an await a claim held and never released. The clause is read through
	// `tryTargetThrows`, the accessor the `try await` desugar binds its `otherwise (e)` at, so the
	// refused form and the accepted one cannot disagree about whether a promise throws. The await of a
	// `spawn`'s start is reported as the factory call it is written as, which is why a held await
	// keeps its target (`HeldAwait.target`).
	function rejectPlainAwaitOfThrowing(target TryTarget, clause ThrowsClause, awaitTok Token) throws SourceParseError
		if throwsClauseIsThrowing(clause) 'throwing'
			match target 'kind'
				serviceStart(factory, _) then throw SourceParseError.spawnStartRequiresTry(throwingCallRequiresTryMessage(self.signatures.diagnosticCalleeSpelling(factory)), factory: factory, line: awaitTok.line, column: awaitTok.column)
				named or
				witness or
				promise or
				send or
				serviceReply or
				sentReply or
				deferred then break
			end 'kind'

			// `otherwise panic` and not a `match`: `throwsClauseIsThrowing` has just answered that this clause
			// carries a name, so the `none` arm is unreachable by the line above it.
			let errorType = try throwsClauseName(clause) otherwise panic("rejectPlainAwaitOfThrowing: a clause throwsClauseIsThrowing accepted has a name")
			throw SourceParseError.awaitThrowingPromiseNeedsTry(errorType, line: awaitTok.line, column: awaitTok.column)
		end 'throwing'
	end 'rejectPlainAwaitOfThrowing'

	// Emit the `await` op for a validated promise operand — the shared core of plain `await`
	// (`emitRoutedAwait`) and the `try await` target (`parseTryTargetExpression`). The result tag is
	// the awaited result type `awaitedPromiseFacts` answers, so a void async yields a void await
	// result the desugar handles and a scalar async yields its scalar.
	function emitAwaitOp(promise ValueId, facts AwaitedPromise, awaitTok Token) returns (ValueId, ElementIndex) throws SourceParseError
		// ⭐ MINTED FROM THE AWAITED RESULT'S **TYPE**, its interner name included — see
		// `awaitedPromiseFacts` for the filler-name-id wrong answer that minting from the bare tag
		// produces.
		let result = match facts.result 'r'
			declared(returnType) gives self.mintAwaitedValue(returnType)
			deferred gives self.mintDeferredValue()
		end 'r'

		self.carryAwaitedResultCapability(result, promise: promise)

		// A reply held at an interface type brings its witness half back beside it
		// (`LowerMaxonToStd.lowerTryAwait`).
		if self.tagOf(result) == ValueTypeTag.interfaceRef 'aFatPointer'
			self.pairInterfaceWitness(result, witness: self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId))
		end 'aFatPointer'

		// ⭐⭐ **THE AWAIT ADOPTS THE THREAD'S REFERENCE TO A MANAGED RESULT** — the same enrolment an
		// ordinary call's owned managed result gets, and in the same place (between the mint and the op).
		// `__gt_await` hands back the `+1` the green thread's own `return` produced and does NOT release it
		// (`__gt_release_<callee>` is called with the result CONSUMED there), so this frame owes exactly one
		// drop; without the enrolment nobody owes it and the record leaks (exit 101). The DUAL is
		// `__gt_promise_drop`, which calls the releaser with the result NOT consumed precisely because no
		// await ever reached this line.
		self.enrolOwnedCallTemp(result)

		// ⭐⭐ **THE ONE PLACE THE BLOCKING GRAPH'S SEEDS ARE MINTED.** `awaitedPromiseFacts` has just
		// resolved which road this promise came by — including a merge PHI — so the fact is free here and
		// would be a second resolver anywhere else. See `Project.serviceAwaitSites`.
		// ⛔⛔ **THE VACATE IS EMITTED HERE, BEFORE THE AWAIT OP, AND THE ORDER IS LOAD-BEARING.**
		// `parseTryCallTarget` turns a `try await` into one by REWRITING THE LAST OP EMITTED
		// (`rewriteLastCallToTryCall`). Emit the slot vacate after the await and the last op is the
		// `__managed_vacate` call, so the rewrite retargets that instead — which turns `try await` cases
		// into E3055. Emitting it first leaves the await op
		// last, where the rewrite expects it. The rest of the consume (`consumePromiseThread`) has no emit and
		// stays below; it finds the consume already recorded and vacates nothing a second time.
		try self.requireConsumedPromiseIsOwned(promise, anchor: awaitTok, door: promiseConsumeDoorName(PromiseConsume.awaited))
		self.vacateConsumedPromiseSlot(promise, range: SourceRange.ofToken(awaitTok), reclaimedBy: PromiseConsume.awaited)
		let opIdx = self.artifact.module.ops.count()
		self.noteWaitSeed(self.bodyFunction(), site: self.awaitWaitSite(promise, facts: facts, opIdx: opIdx))
		let current = self.bodyFunction()
		current.mayYieldSeed = true
		self.statement.lastAwait = RecordedTryTarget.recorded(opIdx, target: facts.tryTarget)

		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.await(result, promise: promise), range: SourceRange.ofToken(awaitTok))

		// The await consumes the thread — the runtime reclaims its struct here — so its owning binding must not
		// also drop it at scope exit. Covers `try await` too: `parseTryCallTarget` emits its target
		// through this same `emitAwaitOp`, then rewrites the op to `tryAwait` (the consume is independent).
		self.consumePromiseThread(promise, range: SourceRange.ofToken(awaitTok), reclaimedBy: PromiseConsume.awaited)
		return (result, opIdx)
	end 'emitAwaitOp'

	function carryAwaitedResultCapability(result ValueId, promise ValueId)
		if self.valueIsAValueType(result) 'aValue'
			return
		end 'aValue'

		match self.asyncCallCalleeOf(self.bodyFunction(), promise: promise) 'source'
			found(callee) then self.setDeclaredResultCapability(result, declared: self.resultCapabilityDeclaredFor(callee))
			serviceReply(messageName, _) then self.setDeclaredResultCapability(result, declared: self.resultCapabilityDeclaredFor(messageName))
			none then break
		end 'source'
	end 'carryAwaitedResultCapability'

	function setDeclaredResultCapability(result ValueId, declared ResultCapability)
		if declared == ResultCapability.isolated 'anIsolatedResult'
			self.setValueCapability(result, capability: ValueCapability.isolated)
		end 'anIsolatedResult' else if declared == ResultCapability.immutable 'aFrozenResult'
			self.setValueCapability(result, capability: ValueCapability.immutable)
		end 'aFrozenResult'
	end 'setDeclaredResultCapability'

	function mintAwaitedValue(returnType MaxonReturnType) returns ValueId
		return match returnType 'r'
			void gives self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
			value(inner) gives self.mintValueOfType(inner)
		end 'r'
	end 'mintAwaitedValue'

	// Transfer ownership of every argument the callee takes. For a callee the sweep recorded ownership
	// facts for, each source argument is slotted to its parameter position (the sweep's `paramNames`
	// stand in for the not-yet-built `FuncSignature`); at a consumed position an owned value is moved
	// (poisoned if it is a live binding, drained if a temporary), a borrowed struct/union is refused
	// (E2015) and a scalar is inert, and a promise moves at every position the callee takes. The
	// common callee `borrowsAll`, so this is one `match`.
	function applyCallerConsume(callee ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance) throws SourceParseError
		match self.signatures.consumeOf(callee) 'c'
			borrowsAll then break
			consumes(info) then try self.transferConsumedArgs(info, isolated: self.isolatedParamBitsDeclaredBy(callee), args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructorInstance, callee: callee)
		end 'c'
	end 'applyCallerConsume'

	function isolatedParamBitsDeclaredBy(callee ByteArray) returns BoolArray
		let declaration = try self.declarationNameableHere(callee) otherwise return BoolArray.create(0)
		return self.signatures.isolatedParamBitsOf(declaration)
	end 'isolatedParamBitsDeclaredBy'

	function declarationTakesArgument(declaration DeclarationFacts, column ParamCount, label ByteArray, argValue ValueId, constructorInstance ConstructorInstance) returns bool
		if declaration.byRef.takesArgumentByRef(column, label: label) 'passedByReference'
			return false
		end 'passedByReference'

		match declaration.consume 'c'
			borrowsAll then return false
			consumes(info) then return self.consumeFactsTakeArgument(info, column: column, label: label, argValue: argValue, constructorInstance: constructorInstance)
		end 'c'
	end 'declarationTakesArgument'

	function consumeFactsTakeArgument(info ParamConsumeInfo, column ParamCount, label ByteArray, argValue ValueId, constructorInstance ConstructorInstance) returns bool
		let position = try argSlotPosition(info.paramNames, argIndex: column, label: label) otherwise return false

		return (self.valueIsPromise(argValue) and info.takesPromiseAt(position)) or self.argIsConsumedAt(info, position: position, constructorInstance: constructorInstance) or self.isOpaqueOwnedFeedArg(info, position: position, argValue: argValue)
	end 'consumeFactsTakeArgument'

	function transferConsumedArgs(info ParamConsumeInfo, isolated BoolArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance, callee ByteArray) throws SourceParseError
		let consumedOwned = ValueIdArray.create(0)

		for column in 0 upto args.count() as ParamCount 'eachArg'
			try self.transferConsumedColumn(info, isolated: isolated, column: column, args: args, argLabels: argLabels, argRanges: argRanges, anchor: anchor, constructorInstance: constructorInstance, consumedOwned: consumedOwned, callee: callee)
		end 'eachArg'
	end 'transferConsumedArgs'

	function noteMovedIntoCall(value ValueId, callee ByteArray, parameter ByteArray)
		self.bodyState.movedIntoCalls.upsert(value, value: keepingPositionText(callee, parameter: parameter))
	end 'noteMovedIntoCall'

	function transferConsumedColumn(info ParamConsumeInfo, isolated BoolArray, column ParamCount, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, anchor Token, constructorInstance ConstructorInstance, consumedOwned ValueIdArray, callee ByteArray) throws SourceParseError
		let label = try argLabels.get(column) otherwise panic("transferConsumedColumn: argLabels.get OOB at {column} — args and argLabels are pushed in lockstep")
		let position = try argSlotPosition(info.paramNames, argIndex: column, label: label) otherwise return
		let argValue = try args.get(column) otherwise panic("transferConsumedColumn: args.get OOB at {column}")

		if valueIsMarked(self.bodyState.argumentStorage, value: argValue) 'theCallersOwnCell'
			if info.takesPromiseAt(position) 'aPromiseCellTheCalleeEmpties'
				try self.takePromiseOutOfCell(argValue, column: column, args: args, argRanges: argRanges, anchor: anchor)
			end 'aPromiseCellTheCalleeEmpties'

			return
		end 'theCallersOwnCell'

		if self.valueIsPromise(argValue) and info.takesPromiseAt(position) 'aPromiseTheCalleeTakes'
			try self.takePromiseIntoCallee(argValue, column: column, args: args, argRanges: argRanges, anchor: anchor)
		end 'aPromiseTheCalleeTakes'

		let range = try argRanges.get(column) otherwise panic("transferConsumedColumn: argRanges.get OOB at {column} — args and argRanges are pushed in lockstep")
		let consumed = self.argIsConsumedAt(info, position: position, constructorInstance: constructorInstance) or self.isOpaqueOwnedFeedArg(info, position: position, argValue: argValue)

		if not consumed 'borrowed'
			try args.set(column, value: self.handleEscapingBorrowFeed(info, position: position, argValue: argValue, anchor: anchor)) otherwise panic("transferConsumedColumn: args.set OOB at {column}")
			return
		end 'borrowed'

		try self.requireConsumedArgumentStillOwned(argValue, consumedOwned: consumedOwned, range: range)
		let parameterName = try info.paramNames.get(position) otherwise panic("transferConsumedColumn: paramNames.get OOB at {position} — the position came from `argSlotPosition` over these names")

		if self.valueIsLinear(argValue) 'aLinearArgument'
			try self.requireLinearArgumentIsOwned(argValue, anchor: anchor)

			if parameterName.equals(SelfParamName) 'itIsTheReceiver'
				self.bodyState.consumedReceivers.push(argValue)
			end 'itIsTheReceiver'
		end 'aLinearArgument'

		let intoAnIsolatedParameter = try isolated.get(position) otherwise false

		if not intoAnIsolatedParameter 'aPlainPosition'
			try self.requireLinearValueMayEnterAPlainPosition(argValue, callee: callee, parameter: parameterName, range: range)
		end 'aPlainPosition'

		self.noteMovedIntoCall(argValue, callee: callee, parameter: parameterName)

		if intoAnIsolatedParameter 'anIsolatedParameter'
			try args.set(column, value: self.handIsolatedArgument(argValue, anchor: anchor)) otherwise panic("transferConsumedColumn: args.set OOB at {column}")
			return
		end 'anIsolatedParameter'

		try args.set(column, value: self.transferConsumedArg(argValue, anchor: anchor)) otherwise panic("transferConsumedColumn: args.set OOB at {column}")
	end 'transferConsumedColumn'

	function requireNoLinearArgumentIn(args ValueIdArray, refusal String, anchor Token) throws SourceParseError
		for argument in args 'eachArgument'
			if self.valueIsLinear(argument) 'aLinearArgument'
				throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: refusal, line: anchor.line, column: anchor.column)
			end 'aLinearArgument'
		end 'eachArgument'
	end 'requireNoLinearArgumentIn'

	function requireLinearValueMayEnterAPlainPosition(argValue ValueId, callee ByteArray, parameter ByteArray, range SourceRange) throws SourceParseError
		let table = self.regionFactsForRead()
		let windows = table.windows

		if not windowIsOpen(windows) or not self.valueIsLinear(argValue) or (self.effectiveCapabilityOf(argValue) != ValueCapability.isolated and not table.carriesABirth(argValue)) 'nothingEntersAnOpenRegion'
			return
		end 'nothingEntersAnOpenRegion'

		let window = innermostWindowOf(windows)

		if not valueIsOutsideInnermostWindow(windows, value: table.birthOf(argValue)) 'bornInsideTheWindow'
			return
		end 'bornInsideTheWindow'

		if parameter.equals(SelfParamName) 'theCalleeJudgesItsReceiver'
			let written = self.regionFactsForWrite()
			written.pendingWindowReceiver = PendingWindowReceiver.moved(range.line, column: range.column, label: window.label)
			return
		end 'theCalleeJudgesItsReceiver'

		throw self.regionRefusal(ErrorCode.semanticIsolatedCallOpensTwoRegions, message: outerValueIntoOpenWindowMessage(window.label, into: keepingPositionText(callee, parameter: parameter)), line: range.line, column: range.column)
	end 'requireLinearValueMayEnterAPlainPosition'

	function fileWindowReceiverMove(opIdx ElementIndex)
		match self.regionFactsForRead().pendingWindowReceiver 'pending'
			none then return
			moved(line, column, label) then self.noteWindowReceiverMove(opIdx, line: line, column: column, label: label)
		end 'pending'

		let written = self.regionFactsForWrite()
		written.pendingWindowReceiver = PendingWindowReceiver.none
	end 'fileWindowReceiverMove'

	function noteWindowReceiverMove(opIdx ElementIndex, line LineNumber, column ColumnNumber, label immutable ByteArray)
		let notes = self.notesForWrite(self.bodyFunction()).sparseForWrite()
		notes.windowReceiverOps.push(opIdx)
		notes.windowReceiverLabels.push(label)
		notes.windowReceiverLines.push(line)
		notes.windowReceiverColumns.push(column)
	end 'noteWindowReceiverMove'

	function rootBirthOf(source ValueId) returns ValueId throws AbsentError
		let table = self.regionFactsForRead()

		if not table.carriesABirth(source) and (self.valueIsAValueType(source) or self.effectiveCapabilityOf(source) != ValueCapability.isolated) 'notARootOfItsOwn'
			throw AbsentError.absent
		end 'notARootOfItsOwn'

		return table.birthOf(source)
	end 'rootBirthOf'

	function carryWindowBirth(carrier ValueId, sources ValueIdArray)
		if not windowIsOpen(self.regionFactsForRead().windows) 'noWindowToCross'
			return
		end 'noWindowToCross'

		var oldest = carrier

		for source in sources 'eachSource'
			let birth = try self.rootBirthOf(source) otherwise continue

			if birth < oldest 'olderThanTheCarrier'
				oldest = birth
			end 'olderThanTheCarrier'
		end 'eachSource'

		self.recordWindowBirth(carrier, birth: oldest)
	end 'carryWindowBirth'

	function carryWindowBirthFrom(carrier ValueId, source ValueId)
		if not windowIsOpen(self.regionFactsForRead().windows) 'noWindowToCross'
			return
		end 'noWindowToCross'

		let birth = try self.rootBirthOf(source) otherwise return
		self.recordWindowBirth(carrier, birth: birth)
	end 'carryWindowBirthFrom'

	function recordWindowBirth(carrier ValueId, birth ValueId)
		if birth < self.regionFactsForRead().birthOf(carrier) 'carriesAnOlderRoot'
			self.regionFactsForWrite().windowBirths.upsert(carrier, value: birth)
		end 'carriesAnOlderRoot'
	end 'recordWindowBirth'

	function unknownCalleeLinearSentence(door String) returns String
		return "a linear value is never passed to {door}: its callee is not known here, and the callee is what consumes a linear value. Call a function that takes it"
	end 'unknownCalleeLinearSentence'

	function requireLinearArgumentIsOwned(argValue ValueId, anchor Token) throws SourceParseError
		if self.hasLiveOwner(argValue) or self.pendingTempsContain(argValue) or self.valueIsOwnedHeap(argValue) or self.valueIsAPayloadFreeWord(argValue) or not self.valueIsManagedHeap(argValue) 'thisCodeOwnsIt'
			return
		end 'thisCodeOwnsIt'

		throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "this linear value is only lent to this code (a parameter of a function that does not take it, or `self` of a method that does not take `consuming self`), and only the code that owns a linear value consumes it", line: anchor.line, column: anchor.column)
	end 'requireLinearArgumentIsOwned'

	function handIsolatedArgument(argValue ValueId, anchor Token) returns ValueId
		if self.valueIsAnOwnedIsolatedLocal(argValue) 'anOwnedRegion'
			self.moveOwnedValueOut(argValue)
			return argValue
		end 'anOwnedRegion'

		return self.transferConsumedArg(argValue, anchor: anchor)
	end 'handIsolatedArgument'

	function argumentFirstTokenIndex(range SourceRange) returns ElementIndex
		var index = self.pos

		while index > 0 and (index >= self.tokens.count() or not tokenStartsAt(self.tokenAt(index), range: range)) 'backToTheArgument'
			index = index - 1
		end 'backToTheArgument'

		if not tokenStartsAt(self.tokenAt(index), range: range) 'noTokenThere'
			panic("argumentFirstTokenIndex: no token of this file stands at {range.line}:{range.column} — an argument range is the range of its first token")
		end 'noTokenThere'

		return index
	end 'argumentFirstTokenIndex'

	// Read off the source, not off the binding that holds the value: an alias and its original share one
	// value, and E3102 names the one written at this argument (`specs/async-promise-drop.md` pins both orders).
	function writtenArgumentName(range SourceRange) returns immutable ByteArray
		var index = self.argumentFirstTokenIndex(range)

		if self.kindAt(index + 1) == TokenKind.colon 'aLabel'
			index = index + 2
		end 'aLabel'

		while self.kindAt(index) == TokenKind.leftParen 'aParenthesizedValue'
			index = index + 1
		end 'aParenthesizedValue'

		if not tokenCanBeAName(self.tokenAt(index)) 'notABinding'
			panic("writtenArgumentName: the argument at {range.line}:{range.column} does not start with a name — a value handed over at two argument positions is a binding written twice")
		end 'notABinding'

		return self.tokenAt(index).value
	end 'writtenArgumentName'

	function requirePromiseNamedOnceInTheCall(promise ValueId, column ParamCount, args ValueIdArray, argRanges SourceRangeArray) throws SourceParseError
		for other in 0 upto args.count() as ParamCount 'eachArgument'
			if other == column or (try args.get(other) otherwise panic("requirePromiseNamedOnceInTheCall: args.get OOB at {other}")) != promise 'anotherValue'
				continue
			end 'anotherValue'

			let later = other if other > column else column
			let range = try argRanges.get(later) otherwise panic("requirePromiseNamedOnceInTheCall: argRanges.get OOB at {later} — args and argRanges are pushed in lockstep")
			throw SourceParseError.useAfterMovePassedTwice(String.from(self.writtenArgumentName(range)), line: range.line, column: range.column)
		end 'eachArgument'
	end 'requirePromiseNamedOnceInTheCall'

	function takePromiseIntoCallee(promise ValueId, column ParamCount, args ValueIdArray, argRanges SourceRangeArray, anchor Token) throws SourceParseError
		try self.requirePromiseNamedOnceInTheCall(promise, column: column, args: args, argRanges: argRanges)
		try self.takeOwnedPromise(promise, anchor: anchor, range: SourceRange.ofToken(anchor), door: anchor.value)
	end 'takePromiseIntoCallee'

	function requireConsumedArgumentStillOwned(argValue ValueId, consumedOwned ValueIdArray, range SourceRange) throws SourceParseError
		if self.repeatedOwningDestinationWouldDoubleFree(argValue) and self.isRepeatedOwningMove(consumedOwned, value: argValue) 'doubleConsume'
			throw SourceParseError.useAfterMovePassedTwice(String.from(self.writtenArgumentName(range)), line: range.line, column: range.column)
		end 'doubleConsume'

		try self.requireNotMovedSinceItWasRead(argValue, range: range)
	end 'requireConsumedArgumentStillOwned'

	function requireNotMovedSinceItWasRead(value ValueId, range SourceRange) throws SourceParseError
		if not valueIsMarked(self.bodyState.movedBindingValues, value: value) or self.hasLiveOwner(value) or self.pendingTempsContain(value) 'stillThisFramesToGive'
			return
		end 'stillThisFramesToGive'

		throw self.useAfterMoveRefusal(self.movedOwnerNameOf(value), value: value, line: range.line, column: range.column)
	end 'requireNotMovedSinceItWasRead'

	function movedOwnerNameOf(value ValueId) returns immutable ByteArray
		for binding in self.bodyState.ownedBindings 'eachOwned'
			if binding.movedFrom and binding.boundValue == value 'movedAway'
				return binding.name
			end 'movedAway'
		end 'eachOwned'

		panic("movedOwnerNameOf: v{value} is marked moved, has no live owner and is no pending temporary, yet no moved binding holds it — a value is marked moved only by poisoning the binding that owned it")
	end 'movedOwnerNameOf'

	// Is the argument at parameter `position` consumed by this call — a plain-field consume (`bits`, whatever
	// the concrete type), OR a type-parameter FEED whose concrete instance argument OWNS managed heap.
	// A trivial type-parameter feed (`Box with Point`/`IntBox`) answers false, so it is borrowed.
	function argIsConsumedAt(info ParamConsumeInfo, position ParamCount, constructorInstance ConstructorInstance) returns bool
		if info.isConsumed(position) 'plainConsume'
			return true
		end 'plainConsume'

		return self.instanceFeedConsumes(info, position: position, constructorInstance: constructorInstance)
	end 'argIsConsumedAt'

	// ⭐ **IS THE ARGUMENT AT `position` AN OPAQUE OWNED TYPE-PARAMETER FEED FORWARD?** A
	// feed position whose argument is an enrolled owned opaque `typeParameter` binding — the SHARED-body
	// forward move (`self.store(item)`) that `argIsConsumedAt`'s instance test cannot see, because the shared
	// body carries no concrete instance (`constructorInstance` none). The value-level dual of the direct
	// `moveElementIntoContainer` opaque poison. False for every non-feed position and every non-opaque argument
	// (a concrete String / struct feed argument, the CONCRETE call site's own value), so it moves nothing the
	// instance path already owns.
	function isOpaqueOwnedFeedArg(info ParamConsumeInfo, position ParamCount, argValue ValueId) returns bool
		return info.typeParamFeedOf(position).isFeed() and self.valueIsOpaqueOwned(argValue)
	end 'isOpaqueOwnedFeedArg'

	// ⭐ **A BORROWED ARGUMENT AT A `T`-TYPED FEED POSITION LANDS IN STORAGE THAT OUTLIVES THE STATEMENT** — a
	// constructor's field or a container the callee keeps — so that storage owes a reference of its own, and
	// it is taken HERE because this is the only frame that can see the argument is borrowed: inside the callee
	// it is a parameter and reads as owned.
	//
	// ⛔ **THE CALLER'S OWN REFERENCE KEEPS ITS ORDINARY SCHEDULE** — a temporary is released at the end of its
	// statement, a binding at its scope's exit. Holding a temporary to the scope's exit instead leaves a caller
	// owner nobody can name beside the container's: a send of that container then finds a record with an owner
	// outside the moved graph and aborts a seed-built binary (exit 96), and no scope is long enough for a container a loop fills.
	function handleEscapingBorrowFeed(info ParamConsumeInfo, position ParamCount, argValue ValueId, anchor Token) returns ValueId
		if not info.typeParamFeedOf(position).isFeed() 'notEscapingFeed'
			return argValue
		end 'notEscapingFeed'

		let fed = self.referenceOrMarkOpaqueFeed(argValue, anchor: anchor)

		if fed != argValue and self.effectiveCapabilityOf(argValue) == ValueCapability.immutable 'aFrozenValueStaysFrozen'
			self.setValueCapability(fed, capability: ValueCapability.immutable)
		end 'aFrozenValueStaysFrozen'

		return fed
	end 'handleEscapingBorrowFeed'

	// ⭐⭐⭐ **THE ONE ACT BOTH FEED SINKS OWE** — a constructor's field and a container the callee keeps alike. A
	// CONCRETE argument is the call site's own value, whose consume/borrow decision `argIsConsumedAt` already
	// made off the instance's type argument — a trivial aggregate is deliberately BORROWED and CO-OWNED, so the
	// reference is taken here. An OPAQUE shared-body borrow, which no instance test can see, takes its own
	// through the enclosing instance's descriptor; without it a caller's heap value is freed once at its scope
	// exit and again by the box's destructor.
	//
	// ⚠ **THE NARROWING IS THE INSTANTIATION AND NOT THE SINK** (`typeParamFeedCanOwnAReference`): taking it
	// unconditionally refuses FOUR committed programs whose instantiation is trivial and owes no reference at
	// all, because the retain is RESERVED statically (a descriptor parameter) and NEEDED only dynamically.
	// Declining there emits nothing that would have done anything — `retainFunc@64` is 0.
	//
	// ⚠ When no reference IS taken, the record this feed fills gets a slot holding a borrow nobody referenced,
	// which is sound where the record dies inside the borrow's lifetime and is not where it comes to rest.
	function referenceOrMarkOpaqueFeed(argValue ValueId, anchor Token) returns ValueId
		if self.tagOf(argValue) != ValueTypeTag.typeParameter 'concreteArgument'
			return self.coOwnConcreteAggregateFeed(argValue, anchor: anchor)
		end 'concreteArgument'

		if not self.signatures.typeParamFeedCanOwnAReference(self.valueTypeParamId(argValue)) 'noInstantiationOwesOne'
			return argValue
		end 'noInstantiationOwesOne'

		// The record this feed fills now holds a reference only the enclosing instance's descriptor can release.
		// Armed here, at the one line that takes it, and carried to the call's RESULT by
		// `emitCall`.
		self.bodyState.callReferencedAnOpaqueFeedSlot = true

		return self.coOwnBorrowedOpaque(argValue, range: SourceRange.ofToken(anchor))
	end 'referenceOrMarkOpaqueFeed'

	// ⭐ **TAKE THE SECOND REFERENCE A BORROWED CONCRETE AGGREGATE OWES ITS DURABLE SINK** — the one act both
	// feed sinks perform, so a third sink cannot inherit half of it. Only a NON-CONSUMED argument reaches
	// `handleEscapingBorrowFeed` at all (`argIsConsumedAt` diverted every owning one), so what arrives here is
	// exactly the co-owned trivial class (managed, not owned: a struct box, a trivial generic instance)
	// plus the scalars — and a SCALAR is not a pointer, owns no record and needs nothing, which is what
	// `valueIsNonTextAggregate` answers `false` for. A byte record cannot arrive: a `String` type argument is
	// `typeArgIsOwned` and is consumed, never borrowed. An `Array` one CAN, and its reference is the returning
	// retain — see `coOwnConcreteRecordForSink`, which is why this hands back a ValueId at all.
	//
	// The released end is the container's own drop, on the SAME `typeIsManaged` boundary this retain implies —
	// a direct field through `genericInstanceFieldOwesDrop`, an opaque column through the descriptor's
	// `destroyFunc@40` (`managedOpaqueArrayElementOf`, which carries the measurement of what the two reading
	// different boundaries cost).
	function coOwnConcreteAggregateFeed(argValue ValueId, anchor Token) returns ValueId
		if not self.valueIsNonTextAggregate(argValue) 'scalarOwnsNoRecord'
			return argValue
		end 'scalarOwnsNoRecord'

		return self.coOwnConcreteRecordForSink(argValue, range: SourceRange.ofToken(anchor))
	end 'coOwnConcreteAggregateFeed'

	// Does the concrete instance's argument at parameter `position`'s type-parameter feed own managed heap? Only a generic-alias constructor carries an instance; only a fed parameter has a position; a
	// borrowed (trivial) argument answers false.
	function instanceFeedConsumes(info ParamConsumeInfo, position ParamCount, constructorInstance ConstructorInstance) returns bool
		match constructorInstance 'ci'
			none then return false
			instance(gid) then return self.instanceFeedConsumesFor(gid, info: info, position: position)
		end 'ci'
	end 'instanceFeedConsumes'

	// The instance-in-hand half of `instanceFeedConsumes` — the parameter is consumed iff it feeds a type
	// parameter whose concrete argument owns managed heap. The feed's SINK does not enter here, and deliberately:
	// whether the CALLER must transfer is settled by the concrete argument alone, and both sinks then take
	// ownership of what arrives (one into the value the call returns, one into the callee's own storage).
	function instanceFeedConsumesFor(gid GenericInstanceId, info ParamConsumeInfo, position ParamCount) returns bool
		match info.typeParamFeedOf(position) 'f'
			none then return false
			feeds(tpPos, _) then return self.signatures.genericInstanceArgIsOwned(gid, position: tpPos)
		end 'f'
	end 'instanceFeedConsumesFor'

	// Hand one consumed argument to the callee, returning the value the call must actually carry. A
	// SCALAR argument owns no heap and the consume is inert (returns itself). An OWNED CONCRETE managed value
	// held by a live BINDING is CO-OWNED (the durable-sink ruling — the binding stays live and keeps its own
	// scope-exit drop); an owned TEMPORARY is ADOPTED, drained from the
	// statement's pending drops because the callee owns it now. Both go through the shared sink door
	// (`storeOwnedValueIntoDurableSink`), which is where that split and its ruling live. A BORROWED
	// STRING (a long rdata literal, or a borrowed String parameter/field) has a cheap owning copy, so it is
	// PROMOTED into a fresh owned record the callee can move into its field — exactly as a DIRECT struct-field /
	// union-payload move-in does (`moveManagedValueInto`) — and THAT copy is returned to replace the borrowed
	// arg. A borrowed STRUCT/UNION/EXISTENTIAL has no STATIC clone and becomes a SECOND OWNER instead
	// (`coOwnBorrowedForConsume`) — the transitive-consume case, and what it is answered with. Its RESULT
	// replaces the argument too: an existential's reference is taken through the witness, and a byte-record
	// conformer's protocol there is the same COPY the concrete arm above takes.
	function takeConsumedReference(argValue ValueId, anchor Token) returns ValueId
		// ⭐ AN OPAQUE OWNED type-parameter binding forwarded to a consuming sibling feed position:
		// the callee takes ownership, so MOVE it — poison the source binding so a second use is E3102 and
		// this frame does not drop it too. Its `typeParameter` tag fails `valueIsManagedHeap` below (opaque here),
		// so this must precede the scalar short-circuit; it carries no owning COPY (like an owned aggregate), so
		// the value passes through unchanged, poisoned in place. Reached only for `isOpaqueOwnedFeedArg` positions.
		if self.valueIsOpaqueOwned(argValue) 'opaqueOwned'
			// ⭐⭐ **INSIDE A LOOP THE FRAME TAKES A NEW REFERENCE INSTEAD OF GIVING UP ITS OWN — `moveElementIntoContainer`'s
			// RULE, AT THE DOOR AN ORDINARY CONSUMING CALL COMES THROUGH.** `moveElementIntoContainer`'s header
			// states the whole argument (N iterations take N references; a `movedFrom` bit set once at the
			// store's TEXT cannot say "moved on iteration 3, live on iteration 4"; and a loop that never runs
			// leaks the caller's reference outright). That argument is about the LOOP and the SINK's
			// obligation, not about which door emitted the store — so a sibling call that consumes its opaque
			// argument owes exactly the same discharge. Served by the corpus, `stdlib/Array.maxon`'s `set`
			// called from a shared body (`Bag.fillTo`'s store) comes through this door.
			//
			// The decision is `moveOfValueEscapesLoop`, read by both doors so they cannot settle on different
			// bindings (see `liveOwnerIndexOf`), and the reference is `coOwnBorrowedOpaque`, emitted by both
			// so the retain and its release are one protocol.
			//
			// A co-owning constructor feed takes a reference wherever it is forwarded: this frame keeps its
			// own (`coOwningFeedParams`).
			if valueIsMarked(self.bodyState.coOwningFeedParams, value: argValue) or self.moveOfValueEscapesLoop(argValue) 'referenceRatherThanMove'
				return self.coOwnBorrowedOpaque(argValue, range: SourceRange.ofToken(anchor))
			end 'referenceRatherThanMove'

			self.moveOwnedValueOut(argValue)
			return argValue
		end 'opaqueOwned'

		if not self.valueIsManagedHeap(argValue) 'scalar'
			return argValue
		end 'scalar'

		if not self.valueIsOwnedHeap(argValue) 'borrowedManaged'
			if tagIsByteRecord(self.tagOf(argValue)) 'byteRecord'
				let owned = self.promoteToOwnedString(argValue, range: SourceRange.ofToken(anchor))
				self.removeFromPendingTemps(owned)
				return owned
			end 'byteRecord'

			return self.coOwnBorrowedForConsume(argValue, range: SourceRange.ofToken(anchor))
		end 'borrowedManaged'

		// ⭐⭐ **A CONSUMING ARGUMENT IS A DURABLE SINK, SO IT CO-OWNS RATHER THAN MOVING (⚖ user ruling).**
		// The callee stores what it is handed, which is exactly the obligation the DIRECT store
		// door discharges one frame in — so both go through the ONE sink door
		// (`storeOwnedValueIntoDurableSink`, which carries the ruling and the live-binding-vs-temporary split).
		// Two spellings of one sink would be the shape this file keeps naming: `self.saved = chunk` legal and
		// `store(chunk)` an E3102, decided by which door happened to serve the statement.
		if self.valueHoldsAUniqueRecord(argValue) 'aUniqueMovesToItsKeeper'
			self.moveOwnedValueOut(argValue)
			return argValue
		end 'aUniqueMovesToItsKeeper'

		return self.storeOwnedValueIntoDurableSink(argValue, isString: tagIsByteRecord(self.tagOf(argValue)), range: SourceRange.ofToken(anchor))
	end 'takeConsumedReference'

	function uniquePayloadSubjectsOf(value ValueId) returns ValueIdArray
		let subjects = ValueIdArray.create(0)

		if not self.valueHoldsAUniqueRecord(value) 'notAUnique'
			return subjects
		end 'notAUnique'

		for (_, binding) in self.bodyState.scope.allVars() 'eachBinding'
			if binding.isPayloadBinding() and binding.isLiveNameOf(value) 'aPayloadOfAUnion'
				subjects.push(binding.payloadScrutBox())
			end 'aPayloadOfAUnion'
		end 'eachBinding'

		return subjects
	end 'uniquePayloadSubjectsOf'

	function transferConsumedArg(argValue ValueId, anchor Token) returns ValueId
		let subjects = self.uniquePayloadSubjectsOf(argValue)
		let transferred = self.takeConsumedReference(argValue, anchor: anchor)

		for subject in subjects 'eachSubjectOfAMovedUnique'
			self.setBindingPartiallyMoved(subject, value: true)
		end 'eachSubjectOfAMovedUnique'

		self.carryFactsToTheHandedReference(argValue, transferred: transferred)

		return transferred
	end 'transferConsumedArg'

	function carryFactsToTheHandedReference(argValue ValueId, transferred ValueId)
		if transferred != argValue 'aReferenceOfItsOwn'
			self.carryCapability(argValue, target: transferred)
			self.carryUndecidedResult(argValue, target: transferred)
			self.carryImmutableSlotRead(argValue, target: transferred)
			self.carryIsolatedPartRead(transferred, arm: argValue)
		end 'aReferenceOfItsOwn'
	end 'carryFactsToTheHandedReference'

	function argumentIsALentUnique(argument HandedOffArgument) returns bool
		return self.valueIsAUniqueNamedBy(argument.value, anchor: argument.anchor)
	end 'argumentIsALentUnique'

	function valueIsAUniqueNamedBy(value ValueId, anchor Token) returns bool
		if not self.valueHoldsAUniqueRecord(value) or not tokenCanBeAName(anchor) or not self.bodyState.scope.contains(anchor.value) 'notANamedUnique'
			return false
		end 'notANamedUnique'

		let binding = self.bodyState.scope.getInfo(anchor.value)

		return not binding.isCellBinding and not binding.isSelfField and not binding.movedFrom and binding.boundValue == value
	end 'valueIsAUniqueNamedBy'

	function lentColumns(args ValueIdArray, argAnchors TokenIndexArray, cells ParamPositionMask, anchor Token) returns ParamPositionMask
		var lent = cells

		for column in 0 upto args.count() 'eachArgument'
			if self.valueIsAUniqueNamedBy(try args.get(column) otherwise panic("lentColumns: args.get OOB at {column}"), anchor: self.handOffArgumentAnchor(argAnchors, index: column, fallback: anchor)) and not maskHasParam(cells, param: column as ParamCount) 'aNamedUnique'
				lent = maskWithParam(lent, param: column as ParamCount)
			end 'aNamedUnique'
		end 'eachArgument'

		return lent
	end 'lentColumns'

	function handOverLentReference(argument HandedOffArgument) returns ValueId
		let lent = self.coOwnBorrowedForConsume(argument.value, range: SourceRange.ofToken(argument.anchor))
		self.carryFactsToTheHandedReference(argument.value, transferred: lent)

		return lent
	end 'handOverLentReference'

	// ⭐⭐⭐ **HAND ONE VALUE THROUGH A `ThreadHandOffDoor`** — a message argument (and a `spawn`'s
	// state), a `spawn`'s factory argument the service keeps, a published value, an `async`
	// argument or a closure capture. A door that LEAVES this green thread hands the value to code
	// that may run on another OS thread, and a counted record's count steps PLAIN
	// (`MmRuntime.emitAdjustRefcount`) because one green thread owns it.
	//
	// ⇒ **AT A DOOR THAT LEAVES THIS GREEN THREAD, FIVE ANSWERS, AND EVERYTHING ELSE IS REFUSED** as
	// **`semanticServiceArgumentNotUnique`**, naming the value and the `.clone()` cure (a cell's
	// occupant is answered first, by `takeableCellOccupantOf`):
	//
	//   • a SCALAR owns no record and crosses as a machine word;
	//   • a BORROWED STRING — an immortal `.rdata` literal, a parameter, a field — is PROMOTED to a
	//     fresh sole copy, the only owned record there will be. Any other borrowed value is refused
	//     whatever its type, because the cure a refusal teaches — `.clone()` — IS that allocation,
	//     spelled by the author at the site that pays for it (⚖ user ruling);
	//   • a READ-ONLY value is SHARED, its graph proved for `GreenThreadHandOff.share`: at a
	//     message, a permanent read-only root or a parameter the sender never writes
	//     (`argumentMessageMayShare`); at a message or a publish, an all-`let` record this frame
	//     does not solely own (`immutableRecordIsSharedNotMoved`);
	//   • an OWNED value this frame solely owns is MOVED — the source binding poisoned (E3102 on a later read) or
	//     the temporary drained. **No incref: the frame's own `+1` rides into the message**, which is what makes
	//     the service the record's one owner rather than its second;
	//   • a TRIVIAL TUPLE (`valueIsCopyableTuple`) this frame does not solely own is COPIED — it
	//     has no identity, so the fresh record is the receiver's alone and the caller keeps its own.
	//
	// A `spawn`'s factory argument departs from this in `unprovenOwnerTakeOf` and
	// `spawnReleasesTheReadsOf`.
	//
	// A `publish` door (`Key.register`, `SharedValue.publish`) takes the same answers and
	// refuses as E3174; its graph is proved for SHARING rather than for a move, because every thread
	// reads a published value at once.
	//
	// ⚠ A door that stays on this green thread (`async`, a closure capture) never refuses a borrowed
	// value: two references on one thread are two references, so it takes a reference of its own
	// (`transferConsumedArg`) where a leaving door refuses.
	//
	// ⚠⚠ **A PROMISE IS REFUSED FIRST, AHEAD OF THE SCALAR SHORT-CIRCUIT, BECAUSE IT IS A SCALAR TO
	// `valueIsManagedHeap`.** A function value, an interface value and an opaque type parameter are refused at
	// the `spawn` against the message's DECLARATION (`ServiceCompanions.untransferableParameterNoun`, E3217), and
	// no accepted message has a parameter one of them could be an argument to. A promise handle is a bare
	// INTEGER (`valueIsPromise` is a per-value MARK precisely because the tag cannot say it), so
	// `keep(n Integer)` takes one with no complaint from anybody — and sending it hands a second green thread a
	// wait token whose completer is scheduled on this one, the shape E3100's linear-await rule exists to prevent.
	//
	// ⚠ **IT REFUSES BEFORE IT EMITS.** A promotion and the share walk are the only things it emits, each only
	// on the accepting path — `ProgramSignatures.transferWalkOf` decides refuse-versus-walk in one answer — so a
	// refused transfer leaves nothing behind. That is `emitBinOp`'s ordering rule, which every door that can throw
	// mid-expression keeps.
	function handOff(position ElementIndex, value ValueId, door ThreadHandOffDoor, anchor Token) returns ValueId throws SourceParseError
		let argument = HandedOffArgument.create(position, value: value, anchor: anchor, door: door)
		return self.handOver(argument, take: try self.handOffTakeOf(argument))
	end 'handOff'

	// Every argument's take is decided, and every refusal thrown, before any is handed over: a
	// hand-over emits, and `requireEachArgumentHandedOffOnce` needs every take in hand.
	function handOffArguments(arguments HandedOffArgumentArray, args ValueIdArray) returns HandOffPlanArray throws SourceParseError
		let plans = HandOffPlanArray.create(arguments.count(), zeroed: false)

		for argument in arguments 'eachRefusal'
			plans.push(HandOffPlan.create(argument, take: try self.handOffTakeOf(argument)))
		end 'eachRefusal'

		try self.requireEachArgumentHandedOffOnce(plans)

		for plan in plans 'eachHandOver'
			try args.set(plan.argument.position, value: self.handOver(plan.argument, take: plan.take)) otherwise panic("handOffArguments: args.set OOB at {plan.argument.position} — every argument was read out of these columns")
		end 'eachHandOver'

		return plans
	end 'handOffArguments'

	function handOffTakeOf(argument HandedOffArgument) returns HandOffTake throws SourceParseError
		let value = argument.value
		let door = argument.door
		let anchor = argument.anchor

		if handOffIsAClosureCapture(door) 'aCapture'
			if self.valueIsPromise(value) 'aPromise'
				try self.takeOwnedPromise(value, anchor: anchor, range: SourceRange.ofToken(anchor), door: anchor.value)
				self.noteMovedThrough(door, value: value)
				return HandOffTake.promiseMovedIn
			end 'aPromise'

			if self.valueIsImmortalFunction(value) 'sharedByEveryHolder'
				return HandOffTake.copied
			end 'sharedByEveryHolder'

			try self.requireCellIsNotLentToAnOpenCall(value)
		end 'aCapture'

		if not self.valueIsManagedHeap(value) 'aMachineWord'
			if self.tagOf(value) == ValueTypeTag.typeParameter and handOffSharesWithTheCaller(door) 'anOpaqueValueTheCallerKeeps'
				return HandOffTake.anOpaqueReference
			end 'anOpaqueValueTheCallerKeeps'

			if self.tagOf(value) == ValueTypeTag.typeParameter and not handOffLeavesThisGreenThread(door) 'anOpaqueValue'
				return self.opaqueTakeOf(value)
			end 'anOpaqueValue'

			return HandOffTake.copied
		end 'aMachineWord'

		if handOffSharesWithTheCaller(door) and not self.valueIsPromise(value) 'sharedWithTheCaller'
			if self.argumentIsALentUnique(argument) 'aUniqueTheCallerKeepsNamed'
				return HandOffTake.aLentReference
			end 'aUniqueTheCallerKeepsNamed'

			return HandOffTake.aReferenceOfItsOwn
		end 'sharedWithTheCaller'

		if let read = try self.takeableCellOccupantOf(value) 'aCellsOccupant'
			try self.requireHandedOffGraphWalkable(value, door: door, anchor: anchor)
			return HandOffTake.cellOccupant(read, exclusivity: self.cellEpochExclusivityOf(read.epoch))
		end 'aCellsOccupant'

		if handOffLeavesThisGreenThread(door) 'anotherGreenThread'
			return try self.greenThreadTakeOf(argument)
		end 'anotherGreenThread'

		return self.coroutineTakeOf(argument)
	end 'handOffTakeOf'

	function coroutineTakeOf(argument HandedOffArgument) returns HandOffTake
		let value = argument.value

		if not self.argumentMovesOut(value) 'notThisFramesToGive'
			return HandOffTake.aReferenceOfItsOwn
		end 'notThisFramesToGive'

		return HandOffTake.movedOut(self.valueIsSolelyOwnedHere(value))
	end 'coroutineTakeOf'

	function opaqueTakeOf(value ValueId) returns HandOffTake
		if self.valueIsOpaqueOwned(value) and self.ownedValueLeavesThisFrame(value) 'thisFramesToGive'
			return HandOffTake.movedOut(self.valueIsSolelyOwnedHere(value))
		end 'thisFramesToGive'

		return HandOffTake.anOpaqueReference
	end 'opaqueTakeOf'

	function greenThreadTakeOf(argument HandedOffArgument) returns HandOffTake throws SourceParseError
		let value = argument.value
		let door = argument.door
		let anchor = argument.anchor

		if self.valueIsCopyableTuple(value) and not self.valueIsSolelyOwnedHere(value) 'aValueWithNoIdentity'
			try self.requireHandedOffGraphWalkable(value, door: door, anchor: anchor)
			return HandOffTake.aCopyOfItsOwn
		end 'aValueWithNoIdentity'

		if self.argumentIsSharedReadOnly(argument) 'readOnlyToEveryHolder'
			try self.requireTransferGraphWalkable(value, door: door, anchor: anchor)
			return HandOffTake.sharedReadOnly
		end 'readOnlyToEveryHolder'

		if not self.valueIsOwnedHeap(value) and self.valueIsAnImmutableAggregate(value) 'borrowedButNothingCanWriteIt'
			try self.requireTransferGraphWalkable(value, door: door, anchor: anchor)
			return HandOffTake.sharedReadOnly
		end 'borrowedButNothingCanWriteIt'

		if not self.valueIsOwnedHeap(value) 'borrowed'
			if self.spawnReleasesTheReadsOf(value, door: door) or not tagIsByteRecord(self.tagOf(value)) 'aReadTheDoorTakesAReferenceTo'
				return HandOffTake.aReferenceOfItsOwn
			end 'aReadTheDoorTakesAReferenceTo'

			try self.requirePublishedGraphWalkable(value, door: door, anchor: anchor)
			return HandOffTake.promotedLiteral
		end 'borrowed'

		if self.immutableRecordIsSharedNotMoved(argument) 'nothingCanWriteIt'
			try self.requireTransferGraphWalkable(value, door: door, anchor: anchor)
			return HandOffTake.sharedReadOnly
		end 'nothingCanWriteIt'

		if not self.valueIsSolelyOwnedHere(value) and not self.valueIsAnOwnedIsolatedLocal(value) 'aSecondOwnerMayExist'
			return self.unprovenOwnerTakeOf(argument)
		end 'aSecondOwnerMayExist'

		try self.requireHandedOffGraphWalkable(value, door: door, anchor: anchor)
		return HandOffTake.movedOut(true)
	end 'greenThreadTakeOf'

	function unprovenOwnerTakeOf(argument HandedOffArgument) returns HandOffTake
		if self.ownedValueLeavesThisFrame(argument.value) 'thisFramesToGive'
			return HandOffTake.movedOut(false)
		end 'thisFramesToGive'

		return HandOffTake.aReferenceOfItsOwn
	end 'unprovenOwnerTakeOf'

	function spawnReleasesTheReadsOf(value ValueId, door ThreadHandOffDoor) returns bool
		return match door 'door'
			spawnFactory gives valueIsMarked(self.bodyState.temporaryFieldReads, value: value)
			message or
			publish or
			coroutine or
			closureCapture gives false
		end 'door'
	end 'spawnReleasesTheReadsOf'

	function handOver(argument HandedOffArgument, take HandOffTake) returns ValueId
		let value = argument.value

		match take 'take'
			copied then return value
			aReferenceOfItsOwn then return self.transferConsumedArg(value, anchor: argument.anchor)
			aLentReference then return self.handOverLentReference(argument)
			aCopyOfItsOwn then return self.handOverCopy(argument)
			anOpaqueReference then return self.coOwnBorrowedOpaque(value, range: SourceRange.ofToken(argument.anchor))
			promotedLiteral then return self.handOverPromotedLiteral(value, door: argument.door, anchor: argument.anchor)
			cellOccupant(read, _) then return self.handCellOccupantOver(read, argument: argument)
			promiseMovedIn then return value
			sharedReadOnly then return self.shareReadOnlyWithTheService(argument)
			movedOut then break
		end 'take'

		self.emitHandedOffGraphProof(value, door: argument.door, anchor: argument.anchor)
		self.moveOwnedValueOut(value)
		self.noteMovedThrough(argument.door, value: value)
		return value
	end 'handOver'

	function handOverCopy(argument HandedOffArgument) returns ValueId
		let copied = self.copyTupleForSink(argument.value, range: SourceRange.ofToken(argument.anchor))
		self.emitHandedOffGraphProof(copied, door: argument.door, anchor: argument.anchor)
		return copied
	end 'handOverCopy'

	function argumentMessageMayShare(argument HandedOffArgument) returns bool
		if not handOffMayBeSharedReadOnly(argument.door) 'aDoorThatNeverShares'
			return false
		end 'aDoorThatNeverShares'

		if self.effectiveCapabilityOf(argument.value) == ValueCapability.immutable 'aFrozenGraph'
			return true
		end 'aFrozenGraph'

		if self.valueIsAnOwnedIsolatedLocal(argument.value) 'anIsolatedRegionIsGivenAway'
			return false
		end 'anIsolatedRegionIsGivenAway'

		if not tokenCanBeAName(argument.anchor) or not self.bodyState.scope.contains(argument.anchor.value) 'notABinding'
			return false
		end 'notABinding'

		let binding = self.bodyState.scope.getInfo(argument.anchor.value)
		return binding.isParameter and not binding.isMutable() and not binding.isCellBinding and not binding.isSelfField and binding.boundValue == argument.value
	end 'argumentMessageMayShare'

	function shareReadOnlyWithTheService(argument HandedOffArgument) returns ValueId
		self.emitTransferGraphProof(argument.value, anchor: argument.anchor)
		return self.transferConsumedArg(argument.value, anchor: argument.anchor)
	end 'shareReadOnlyWithTheService'

	function noteMovedThrough(door ThreadHandOffDoor, value ValueId)
		if handOffIsAClosureCapture(door) 'intoAClosure'
			self.bodyState.capturedMoveValues = withValueMarked(self.bodyState.capturedMoveValues, value: value)
		end 'intoAClosure'
	end 'noteMovedThrough'

	function movedBindingRefusal(binding VarInfo, nameTok Token) returns SourceParseError
		if binding.isPayloadBinding() 'aPayloadOfAMovedSubject'
			if let into = try self.bodyState.movedIntoCalls.get(binding.payloadScrutBox()) 'itsSubjectWasHandedToACall'
				return SourceParseError.useAfterMoveInto(String.from(nameTok.value), into: into, line: nameTok.line, column: nameTok.column)
			end 'itsSubjectWasHandedToACall'
		end 'aPayloadOfAMovedSubject'

		return self.useAfterMoveRefusal(nameTok.value, value: binding.boundValue, line: nameTok.line, column: nameTok.column)
	end 'movedBindingRefusal'

	function useAfterMoveRefusal(name ByteArray, value ValueId, line LineNumber, column ColumnNumber) returns SourceParseError
		if valueIsMarked(self.bodyState.capturedMoveValues, value: value) 'movedIntoAClosure'
			return SourceParseError.useAfterMoveInto(String.from(name), into: String.from(ClosureCaptureMoveDisplay), line: line, column: column)
		end 'movedIntoAClosure'

		return SourceParseError.useAfterMove(String.from(name), line: line, column: column)
	end 'useAfterMoveRefusal'

	function requireCellIsNotLentToAnOpenCall(value ValueId) throws SourceParseError
		let read = try self.takeableCellOccupantOf(value) otherwise return
		let funcIndex = self.artifact.currentFuncIndex

		for handOff in self.openByRefHandOffs 'eachOpenHandOff'
			if handOff.funcIndex == funcIndex and handOff.epoch == read.epoch 'lentToTheCallThisCaptureIsAnArgumentOf'
				throw SourceParseError.useAfterMoveInto(String.from(handOff.anchor.value), into: String.from(ClosureCaptureMoveDisplay), line: handOff.anchor.line, column: handOff.anchor.column)
			end 'lentToTheCallThisCaptureIsAnArgumentOf'
		end 'eachOpenHandOff'
	end 'requireCellIsNotLentToAnOpenCall'

	function handOverPromotedLiteral(value ValueId, door ThreadHandOffDoor, anchor Token) returns ValueId
		let owned = self.promoteToOwnedString(value, range: SourceRange.ofToken(anchor))
		self.removeFromPendingTemps(owned)

		match handOffDoorKind(door) 'handOff'
			move then return owned
			share then self.emitTransferGraphProof(owned, anchor: anchor)
		end 'handOff'

		return owned
	end 'handOverPromotedLiteral'

	function handCellOccupantOver(read CellOccupantRead, argument HandedOffArgument) returns ValueId
		let value = argument.value
		let door = argument.door
		let anchor = argument.anchor

		self.emitHandedOffGraphProof(value, door: door, anchor: anchor)

		self.takeCellOccupant(read, value: value, range: SourceRange.ofToken(anchor))
		self.noteMovedThrough(door, value: read.binding.boundValue)
		return value
	end 'handCellOccupantOver'

	function requireHandedOffGraphWalkable(value ValueId, door ThreadHandOffDoor, anchor Token) throws SourceParseError
		if handOffProvesItsGraph(door) 'provedBeforeItCrosses'
			try self.requirePublishedGraphWalkable(value, door: door, anchor: anchor)
		end 'provedBeforeItCrosses'
	end 'requireHandedOffGraphWalkable'

	function requirePublishedGraphWalkable(value ValueId, door ThreadHandOffDoor, anchor Token) throws SourceParseError
		match handOffDoorKind(door) 'handOff'
			move then return
			share then try self.requireTransferGraphWalkable(value, door: door, anchor: anchor)
		end 'handOff'
	end 'requirePublishedGraphWalkable'

	function emitHandedOffGraphProof(value ValueId, door ThreadHandOffDoor, anchor Token)
		if handOffProvesItsGraph(door) and handOffDoorKind(door) == GreenThreadHandOff.share 'aSharedGraphIsWalked'
			self.emitTransferGraphProof(value, anchor: anchor)
		end 'aSharedGraphIsWalked'
	end 'emitHandedOffGraphProof'

	function requireEachArgumentHandedOffOnce(plans HandOffPlanArray) throws SourceParseError
		for i in 0 upto plans.count() 'eachArgument'
			let plan = try plans.get(i) otherwise panic("requireEachArgumentHandedOffOnce: plans.get OOB at {i} below its own count")

			if not handOffTakeMovesTheRecord(plan.take) 'notMoved'
				continue
			end 'notMoved'

			let first = plan.argument
			let identity = self.handedOffIdentity(first.value)

			for j in (i + 1) upto plans.count() 'eachLater'
				let again = (try plans.get(j) otherwise panic("requireEachArgumentHandedOffOnce: plans.get OOB at {j} below its own count")).argument

				if self.handedOffIdentity(again.value) == identity 'handedAgain'
					throw SourceParseError.useAfterMove(String.from(again.anchor.value), line: again.anchor.line, column: again.anchor.column)
				end 'handedAgain'
			end 'eachLater'
		end 'eachArgument'
	end 'requireEachArgumentHandedOffOnce'

	function handedOffIdentity(value ValueId) returns ValueId
		let read = try cellOccupantReadOf(self.bodyState.cellOccupantReads, occupant: value) otherwise return value
		return read.binding.boundValue
	end 'handedOffIdentity'

	function immutableRecordIsSharedNotMoved(argument HandedOffArgument) returns bool
		if not self.valueIsAnImmutableAggregate(argument.value) 'aWritableRecord'
			return false
		end 'aWritableRecord'

		return match argument.door 'door'
			message or
			publish gives not self.valueIsSolelyOwnedHere(argument.value)
			spawnFactory or
			coroutine or
			closureCapture gives false
		end 'door'
	end 'immutableRecordIsSharedNotMoved'

	function argumentIsSharedReadOnly(argument HandedOffArgument) returns bool
		return not tagIsByteRecord(self.tagOf(argument.value)) and self.argumentMessageMayShare(argument)
	end 'argumentIsSharedReadOnly'

	// ⭐⭐ **WALK THE GRAPH, OR REFUSE IT** — shared by the send and publish doors so the two cannot
	// walk one graph differently; the reply door asks the same decision and leaves the walk to the
	// `<T>.__behave`. It emits a walk only where nothing is thrown.
	//
	// ⛔ **SOLENESS IS NOT TRANSITIVE, SO THE GRAPH IS WALKED AT RUN TIME, IMMEDIATELY BEFORE THE HAND-OFF, AND
	// EVERY RECORD IN IT IS MARKED SHARED.** A box this frame solely owns can hold a payload it only co-owns —
	// an incref'd store, a factory's alias, a `push` of a live binding — and no caller-side mark or type tells
	// those apart from a fresh record. Across green threads the second owner would step a count the receiver
	// steps too.
	//
	// ⚠ The walk takes no reference: the reference that crosses — this frame's own, or a promoted
	// literal's copy — is the caller's.
	function requireTransferGraphWalkable(value ValueId, door ThreadHandOffDoor, anchor Token) throws SourceParseError
		match self.transferWalkOfValue(value) 'graph'
			closed or
			walkedBy or
			walkedThroughWitness then return
			refused(noun) then throw self.unwalkableTransferGraphError(value, blame: handOffDoorBlame(door), noun: noun, anchor: anchor)
		end 'graph'
	end 'requireTransferGraphWalkable'

	function emitTransferGraphProof(value ValueId, anchor Token)
		match self.transferWalkOfValue(value) 'graph'
			closed then return
			walkedBy(callee) then _ = self.emitRuntimeCall(callee, args: argsOf(value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
			walkedThroughWitness(entry) then _ = self.emitRuntimeCall(entry, args: twoArgs(self.witnessOfValue(value), second: value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.ofToken(anchor))
			refused then panic("emitTransferGraphProof: a graph no walk can be built for reaches the hand-off — `handOffTakeOf` refuses it before anything is emitted")
		end 'graph'
	end 'emitTransferGraphProof'

	function transferWalkOfValue(value ValueId) returns TransferWalk
		let subject = transferSubjectOf(self.tagOf(value), nameId: self.valueNameId(value), typeNames: self.artifact.typeNames)
		return self.signatures.transferWalkOf(subject, kind: TransferKind.share, readerFilePath: self.job.path)
	end 'transferWalkOfValue'

	// E3217 for a graph no per-type walk can be built for, at every door that refuses one.
	function unwalkableTransferGraphError(value ValueId, blame String, noun String, anchor Token) returns SourceParseError
		return SourceParseError.registryRefused(ErrorCode.semanticMessageNeedsACapability, explanation: serviceUnclosedRecordTransferMessage(blame, sourceClause: self.transferSourceClause(value), noun: noun), line: anchor.line, column: anchor.column, note: DiagnosticNote.none)
	end 'unwalkableTransferGraphError'

	// ⭐ **DID THIS PARSE MINT `value` AS A STRING LITERAL?** — `knownLiteralBytes`'s criterion asked as a
	// PREDICATE, so the send door pays one array read rather than a boxed union it would then discard. The
	// answer is a fact about PROVENANCE and not about the record: a parameter, a field, a merge result and a
	// runtime slice are all `false` here even when the record they happen to hold is the immortal one.
	function valueIsAMintedStringLiteral(value ValueId) returns bool
		return self.constPayloadDomain(value) == ConstPayloadDomain.stringLiteralOp
	end 'valueIsAMintedStringLiteral'

	// The clause naming the source a refused transfer should point the author at — the live owning binding,
	// or `NoTransferSourceClause` for a value no binding holds (a temporary, an element read, a field read).
	// Split out because both refusals need it and neither may resolve it a second way.
	function transferSourceClause(value ValueId) returns String
		let index = try self.liveOwnerIndexOf(value) otherwise return NoTransferSourceClause

		let owner = try self.bodyState.ownedBindings.get(index) otherwise panic("transferSourceClause: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")
		return serviceTransferSourceClause(String.from(owner.name))
	end 'transferSourceClause'

	// ⭐⭐ **ARE THESE TWO DECLARED ANSWERS INTERCHANGEABLE AT A CALL?** — the question
	// `requireImplementersAnswerAlike` asks of the services behind one interface handle.
	//
	// The TAG half is `returnTagsAgree` asked in BOTH directions. Two ranged aliases therefore agree (they are
	// both numbers).
	//
	// ⛔⛔ **THE TAG HALF IS NOT THE WHOLE TEST, AND TESTING ONLY IT IS A SILENT WRONG ANSWER.** Two struct
	// returns are both `structRef` and two generic-instance returns are both `genericInstance`, so two
	// DIFFERENT aggregates read as agreeing, and a value typed from one is read at the other's field offsets
	// with no diagnostic at any stage.
	//
	// ⇒ once the tags agree, only a nominal IDENTITY can still part them, and it is read through the ONE
	// routine that answers it (`aggregateNameIn`) — the same "a ranged alias names no aggregate" rule that
	// keeps two spellings of one number interchangeable.
	function returnAnswersAreInterchangeable(left MaxonReturnType, right MaxonReturnType) returns bool
		let leftTag = returnTypeTagOrVoid(left)
		let rightTag = returnTypeTagOrVoid(right)

		// `void` is not a `MaxonType`, so the void/value split is settled before any tag is compared — and a
		// value answer meeting a void one is the quadrant no retype can repair.
		if leftTag == ValueTypeTag.void or rightTag == ValueTypeTag.void 'oneOfThemReturnsNothing'
			return leftTag == rightTag
		end 'oneOfThemReturnsNothing'

		if not (returnTagsAgree(leftTag, declared: rightTag) and returnTagsAgree(rightTag, declared: leftTag)) 'theTagsAlreadyPartThem'
			return false
		end 'theTagsAlreadyPartThem'

		return not namedAggregatesConflict(self.adoptedReturnAggregateName(left), got: self.adoptedReturnAggregateName(right))
	end 'returnAnswersAreInterchangeable'

	// The aggregate identity of a SWEPT return type, read in this file's own interner. ADOPTED first because
	// the name is read in `self.artifact.typeNames` and a swept id is the INDEX's — the
	// same crossing `boundReturnOf` makes for the type it finally hands back. Reached only once
	// the tags have already agreed, so no set the tag test parts pays for it.
	function adoptedReturnAggregateName(swept MaxonReturnType) returns immutable ByteArray
		return match self.signatures.adoptReturnType(swept, into: self.artifact.typeNames) 'adopted'
			void gives EmptySourceText
			value(inner) gives aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: maxonTypeTag(inner), nameId: typeNameIdOf(inner), readerFilePath: self.job.path)
		end 'adopted'
	end 'adoptedReturnAggregateName'

	// ⭐⭐⭐ **A CALL'S RESULT TYPE IS FIXED WHILE ITS OWN FILE IS PARSED**, so it is read by callee name off the
	// sweep: the tag decides the Std type of the result (`lowerMaxonToStd`), whether a scope-exit drop is
	// enrolled for it (`enrolOwnedCallTemp`) and which register file it travels in.
	function boundReturnOf(callee ByteArray) returns BoundReturn
		match self.signatures.returnTypeOf(callee, into: self.artifact.typeNames) 'byName'
			declared(returnType) then return BoundReturn.declared(returnType, scopeFilePath: self.signatures.recordedReturnDeclFileOf(callee))
			undeclared then return sharedUndeclaredReturn
		end 'byName'
	end 'boundReturnOf'

	// ⭐⭐ **A SWEPT PARAMETER TYPE ADOPTED AND THEN REPAIRED, and BOTH steps are the reason a type read off it
	// agrees with the argument check.** The sweep's ids live in the index's own interner, and the type it recorded
	// is the TOLERANT one — a struct, a float alias and a generic alias all arrive as a bare `named`
	// (`parseTypeReference`'s `allFilesFolded` argument). Compared raw, a `ByteArray` parameter is a `named` while
	// its argument is a generic instance, and the two never agree.
	//
	// ⚠ A recorded PARAMETER type is repaired only where it is read. A recorded return type and a struct field
	// are also normalized at the source by `contestScopedAlias`, for readers that reach no scoped repair; a
	// parameter type has no such reader, so the scope file its reader hands in is the whole of the rule for it.
	function sweptParamType(swept MaxonType, scopeFilePath FilePath) returns MaxonType
		return self.repairSweptType(self.signatures.adoptType(swept, into: self.artifact.typeNames), scopeFilePath: scopeFilePath)
	end 'sweptParamType'

	// Mint the SSA value a call to `calleeTok` defines, typed from the WHOLE-PROGRAM signature index
	// (SignatureIndex.maxon) — so the type is exact whether the callee is declared above this call,
	// below it, or in another file entirely.
	//
	// The index answers with the DECLARATION, undistorted, which is what makes the two cases below
	// distinguishable at all: "no file declares it" is `undeclared` and "it declares nothing to
	// return" is `declared(void)`.
	function mintCallResult(callee ByteArray, anchor Token, resultUsed bool, bound BoundReturn) returns ValueId throws SourceParseError
		match bound 'callee'
			declared(returnType, scopeFilePath) then return try self.mintDeclaredCallResult(callee, anchor: anchor, returnType: returnType, scopeFilePath: scopeFilePath, resultUsed: resultUsed)

			// NO file declares this callee. DEFER, and keep deferring: `SemanticCheck.validateCall` owns
			// that diagnostic (E3004, "call to undefined function") because it reads the registry the
			// REAL parse built, and this sweep is the tolerant half of the pair — see
			// `CalleeReturn.undeclared`. So the program is rejected, just not here, and `unresolved`
			// therefore never reaches codegen.
			undeclared then return self.mintDeferredValue()
		end 'callee'
	end 'mintCallResult'

	// `unresolved` is a deferral, never a sentinel, so every door that meets a member on one answers
	// here rather than refusing. Whether a callee is declared anywhere is
	// `SemanticCheck.validateCall`'s question, reported as E3004 at the call; a refusal here would end
	// the file first, showing a symptom at an unrelated line, and would refuse a correct program whose
	// declaration the sweep missed.
	//
	// The doors whose parameter type is a `__`-reserved builtin (`__ManagedMemory`, `__ManagedFile`,
	// `__ManagedSocket`, `__ManagedDirectory`) throw instead; only a file allowed to spell those names
	// reaches them.
	function deferredUnresolvedMemberResult(func IrFunction) returns ValueId throws SourceParseError
		let chainCalls = try self.parseDeferredMemberChain(func)

		return self.deferredValueOfChain(chainCalls)
	end 'deferredUnresolvedMemberResult'

	function deferredMemberResultPastTheBase(func IrFunction) returns ValueId throws SourceParseError
		self.advance()

		return try self.deferredUnresolvedMemberResult(func)
	end 'deferredMemberResultPastTheBase'

	// The one door a deferred value is minted through, so the innermost block-form `try` learns that its
	// body holds one (`TryBlockContext.holdsADeferredValue`). A deferred value minted by `mintValue`
	// directly would leave that body to be refused E3083.
	function mintDeferredValue() returns ValueId
		let result = self.mintValue(ValueTypeTag.unresolved, nameId: UnnamedTypeId)
		self.noteDeferredValueInTryBlock()

		return result
	end 'mintDeferredValue'

	function noteDeferredValueInTryBlock()
		if self.bodyState.tryBlocks.count() == 0 'outsideATryBlock'
			return
		end 'outsideATryBlock'

		let ctx = self.innermostTryBlock()
		ctx.holdsADeferredValue = true
	end 'noteDeferredValueInTryBlock'

	function deferredValueOfChain(chainCalls DeferredChainCalls) returns ValueId
		let derived = self.mintDeferredValue()
		self.artifact.recordDeferredChain(derived, chainCalls: chainCalls)

		return derived
	end 'deferredValueOfChain'

	function valueIsDeferred(value ValueId) returns bool
		return tagIsUnresolved(self.tagOf(value))
	end 'valueIsDeferred'

	function innermostTryBlock() returns TryBlockContext
		return try self.bodyState.tryBlocks.get(self.bodyState.tryBlocks.count() - 1) otherwise panic("innermostTryBlock: asked with no block-form `try` on the stack — every caller is on a route `throwRouteDestination` found inside one")
	end 'innermostTryBlock'

	function capturedFrame(frame ElementIndex) returns ClosureEnclosingFrame
		return try self.closureEnclosingFrames.get(frame) otherwise panic("capturedFrame: frame {frame} is not one of the {self.closureEnclosingFrames.count()} enclosing frames — `captureScopeOf` answers a frame only while it is pushed")
	end 'capturedFrame'

	function parseDeferredMemberChain(func IrFunction) returns DeferredChainCalls throws SourceParseError
		var chainCalls = DeferredChainCalls.noCall

		while self.at(TokenKind.dot) 'chain'
			self.advance()
			self.advance()

			if self.at(TokenKind.leftParen) 'anArgumentList'
				try self.parseDeferredMemberArguments(func)
				chainCalls = DeferredChainCalls.lastLinkIsACall
			end 'anArgumentList' else if chainCalls == DeferredChainCalls.lastLinkIsACall 'aMemberAfterACall'
				chainCalls = DeferredChainCalls.callBeforeTheLastLink
			end 'aMemberAfterACall'
		end 'chain'

		return chainCalls
	end 'parseDeferredMemberChain'

	// Parsed rather than skipped, so an error inside the arguments is reported. It cannot share
	// `parseCallArgs`, which records by-reference, array-literal and anchor facts
	// against a declared callee; a member of an undeclared call's result has none to record them
	// against.
	function parseDeferredMemberArguments(func IrFunction) throws SourceParseError
		try self.consume(TokenKind.leftParen)
		var argIndex = 0 as ParamCount

		while not self.at(TokenKind.rightParen) 'eachArgument'
			if argIndex > 0 'afterTheFirst'
				try self.consume(TokenKind.comma)
			end 'afterTheFirst'

			_ = try self.consumeArgLabel(argIndex, rule: ArgLabelRule.unknownMember)
			let valueStart = self.pos
			let offersAClosure = self.argumentOpensAClosure(valueStart)

			if offersAClosure 'aClosureLiteral'
				self.stateClosureParamOfferAt(valueStart, offer: ClosureParamOffer.deferred)
			end 'aClosureLiteral'

			_ = try self.parseValueExpression(func)

			if offersAClosure 'anOfferMustNotOutliveItsArgument'
				self.statement.pendingClosureParamOffer = PendingClosureParamOffer.none
			end 'anOfferMustNotOutliveItsArgument'

			self.noteSpanMayWriteItsBinding(valueStart)
			argIndex = argIndex + 1
		end 'eachArgument'

		try self.consume(TokenKind.rightParen)
	end 'parseDeferredMemberArguments'

	function baseBindingIsADeferredCallResult(binding VarInfo) returns bool
		return tagIsUnresolved(maxonTypeTag(binding.varType))
	end 'baseBindingIsADeferredCallResult'

	function chainBaseIsDeferred() returns bool
		match self.valueBaseAt(self.pos) 'base'
			thisFrame then return self.baseBindingIsADeferredCallResult(self.thisFrameBindingOf(self.current()))
			captured(frame) then return self.baseBindingIsADeferredCallResult(self.capturedBindingOf(self.current(), frame: frame))
			unbound or
			alwaysAType then return self.chainBaseIsAPoisonedBinding()
		end 'base'
	end 'chainBaseIsDeferred'

	function chainBaseIsAPoisonedBinding() returns bool
		return self.baseIsAPoisonedGlobal(self.current()) or self.baseIsAPoisonedStaticMember()
	end 'chainBaseIsAPoisonedBinding'

	function baseIsAPoisonedGlobal(baseTok Token) returns bool
		return self.signatures.topLevelBindingVisibleFrom(baseTok.value, readerFilePath: self.job.path) and self.bindingIsPoisoned(baseTok)
	end 'baseIsAPoisonedGlobal'

	function baseIsAPoisonedStaticMember() returns bool
		let typeTok = try self.staticBaseTokenAt(self.pos) otherwise return false
		let memberIndex = self.pos + TokensPerQualifierSegment

		if not self.namesStaticMemberAt(typeTok, memberIndex: memberIndex) 'notAStaticMember'
			return false
		end 'notAStaticMember'

		return self.bindingIsPoisoned(self.staticMemberNameToken(typeTok, memberTok: self.tokenAt(memberIndex)))
	end 'baseIsAPoisonedStaticMember'

	function bindingIsPoisoned(bindingTok Token) returns bool
		return match self.managedReceiverBindingOf(bindingTok) 'binding'
			poisoned gives true
			inlineWord or
			constant or
			global or
			imageRecord or
			imageBox or
			none gives false
		end 'binding'
	end 'bindingIsPoisoned'

	// The result of a call to a callee some file DOES declare — where the void/value split is
	// finally a split and not a sentinel.
	function mintDeclaredCallValue(callee ByteArray, inner MaxonType, declFilePath FilePath) returns ValueId
		if self.declaredTypeIsUnknown(inner, scopeFilePath: declFilePath) 'aResultOfAnUnknownType'
			return self.mintDeferredValue()
		end 'aResultOfAnUnknownType'

		let result = self.mintDirectCallValueResult(inner, scopeFilePath: declFilePath)

		if self.tagOf(result) == ValueTypeTag.interfaceRef 'existentialReturn'
			if let claim = try self.declaredReturnExistentialClaim(callee, declFilePath: declFilePath) 'theReturnNamedAnInstantiation'
				self.recordValueExistentialInstance(result, claim: claim)
			end 'theReturnNamedAnInstantiation'
		end 'existentialReturn'

		return result
	end 'mintDeclaredCallValue'

	function mintDeclaredCallResult(callee ByteArray, anchor Token, returnType MaxonReturnType, scopeFilePath FilePath, resultUsed bool) returns ValueId throws SourceParseError
		match returnType 'r'
			// ⭐ **THE CALLEE'S OWN DECLARING FILE — see `resolveNamedStruct`'s `scopeFilePath`.** A return
			// type is a slot of the function that declared it, so the repair below is scoped by that file
			// and never by the one making the call.
			value(inner) then return self.mintDeclaredCallValue(callee, inner: inner, declFilePath: scopeFilePath)
			void then break
		end 'r'

		// A VOID callee. In STATEMENT position that is precisely what the position is FOR — the call
		// runs for its effect — so the result value is minted with the `void` tag and never read
		// again (ValueTypeTag.void: it is write-only, and this is the only site that writes it).
		//
		// In VALUE position there is no value to give: E2004, `Function 'noop' does not return a value`,
		// at this anchor.
		if resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(callee), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintDeclaredCallResult'

	// ⭐⭐ **THE VALUE A DIRECT CALL DEFINES — AND, WHEN THE CALLEE RETURNS AN INTERFACE, THE SECOND VALUE IT
	// DEFINES TOO (the return ABI).** An interface-returning callee hands back a fat pointer:
	// the value half in the primary return register and the WITNESS half in the secondary one — the same
	// register a throwing callee's error flag rides, and the same two-def op (`StdOp.tryCall`) that captures
	// it. So the call defines TWO SSA values, and the second is minted HERE rather than at the Std tier for
	// two reasons the pairing column cannot work without:
	//
	//   • **THE PARSER IS THE FIRST READER.** `let p = f.make()` then `p.produce()` resolves its dispatch
	//     during THIS parse (`witnessOfValue`), and so does passing `p` to an interface parameter, and so
	//     does the scope-exit `__drop_existential`. A witness minted one tier later would arrive after every
	//     one of those had already asked for it.
	//   • **`valueWitnessIds` IS THE MEMO'S OWN ARRAY.** `LowerMaxonToStd` re-points at
	//     `IrFunction.valueWitnessIds` per function and the merged module is a SHARED memo, so a pairing
	//     written down there would mutate what every later compile reads (docs/internals/query-spine.md,
	//     "The memo is shared").
	//
	// The witness id is therefore RESERVED by the parser and DEFINED by the Std tier — the one value in the
	// Maxon module with no Maxon op behind it, which is exactly what "the witness rides out of band" means:
	// it is not an operand of the `call`, it is the call's other result, and `StdOp.tryCall` is where that
	// becomes a def. It is tagged `integer` for the reason a merge phi's witness half is: it is a machine
	// address, in the GPR file, and nothing dispatches ON it.
	function mintDirectCallValueResult(inner MaxonType, scopeFilePath FilePath) returns ValueId
		let result = self.mintOwnedCallResult(inner, scopeFilePath: scopeFilePath)

		if self.tagOf(result) == ValueTypeTag.interfaceRef 'existentialReturn'
			self.pairInterfaceWitness(result, witness: self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId))
		end 'existentialReturn'

		return result
	end 'mintDirectCallValueResult'

	// The SSA value a VALUE-returning callee defines, minted from its declared return type — and ADOPTED
	// as owned when that type is a heap box. A callee that returns a heap value moves it OUT of itself
	// (`parseReturnStatement` — the box leaves the callee's drop sets), so the CALLER becomes its sole
	// owner and must drop it once. Three return types own a droppable box, and the caller adopts each the
	// same way:
	//
	//   • a `returns String` — a fused heap record (a borrowed literal was promoted to one at the return);
	//   • a `returns Pair` — a struct box (`resolveNamedStruct` re-tags the `named` signature type to
	//     `structRef` first, so the result binds a struct and `p.first` resolves — the two-place agreement
	//     the tolerant sweep's `named` return could not make on its own);
	//   • a `returns Container` — a payload-bearing (box or word) union/enum (`valueIsBoxedUnion`):
	//     a `named` result whose LAYOUT `carriesPayloads`, indistinguishable by tag from a bare
	//     enum value, which owns no box and is adopted by no one.
	//
	// ⚠ **THE ADOPTION ITSELF IS THE CALLER'S, NOT THIS FUNCTION'S — see `enrolOwnedCallTemp`.** Adopting here
	// would be one step too early for the one caller that RETYPES the
	// result afterwards. The name says `Owned` because that is what the returned value is; the obligation
	// is written down later, by the caller.
	// ⭐⭐ **THE READ-DOOR REPAIR OF A TYPE THE TOLERANT SWEEP RECORDED — one composition, two askers.**
	// `resolveNamedStruct` re-tags a struct-`named` to `structRef`; `resolveFloatAliasType` then resolves a
	// float-alias `named` (`Float`) to `float`; `resolveNamedAlias` resolves a function, generic or
	// tuple alias to what it denotes. All three are needed and they compose cleanly — a type is a struct, a
	// float alias, a function alias, a generic alias, a tuple alias or a ranged int, never two — so the result
	// of a `returns Float` callee binds a `float` (XMM) value that `trunc` truncates and `return` moves
	// cleanly, rather than a `named` value the tag says is an int while the backend files it in XMM.
	//
	// ⚠ **TWO READERS OF SWEPT TYPES, AND THEY MUST REPAIR THEM ALIKE**: a call's RESULT (below) and a
	// declaration's PARAMETER (`sweptParamType`). Repairing one and not the other gives a parameter a tag its
	// own argument check one pass later never sees.
	function repairSweptType(swept MaxonType, scopeFilePath FilePath) returns MaxonType
		return canonicalizeSweptTupleName(self.signatures, interner: self.artifact.typeNames, repaired: self.scopeCrossedType(self.resolveNamedAlias(self.resolveFloatAliasType(resolveNamedStruct(swept, typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: scopeFilePath), scopeFilePath: scopeFilePath), scopeFilePath: scopeFilePath), scopeFilePath: scopeFilePath))
	end 'repairSweptType'

	// ⭐⭐ **A NAME THAT MEANS TWO THINGS MAY NOT TRAVEL AS A NAME ACROSS THE FILE BOUNDARY — the step of the
	// repair the scope alone does not buy.** Resolving the slot in its DECLARING file
	// gives the right KIND; what it cannot fix is that the resulting value still WEARS the name, and every
	// rule that reads a `named` value asks what THIS file means by it. MEASURED: `useIt() returns Box` over
	// `b.maxon`'s unexported `int(0 to 10)`, returned from a `main.maxon` that means `a.maxon`'s
	// `export type Box`, was **`E3005 Cannot return 'Box' from function declared to return 'int'`** — the
	// value was an integer and the identity check read the caller's struct off its name.
	//
	// ⚠ **ERASED TO THE PRIMITIVE, WHICH IS THE HONEST ANSWER RATHER THAN A RETREAT.** The reading file
	// cannot name the declaration this value came from — that is what "neither declaration can see the
	// other" means — so it may not carry an identity the reader would resolve to a different declaration.
	// The RANGE goes with it, and that is right too: a range is enforced in the file that declared it
	// (`RangedAliasRegistry.lookup`), and this file declared nothing.
	//
	// ⛔⛔ **EVERY TEST HERE IS THAT THE TWO FILES *DISAGREE*, AND A ONE-SIDED TEST — "does the SLOT's file
	// mean X" — ERASES OR RE-SPELLS TYPES BOTH FILES AGREE ABOUT.** An `enum` and a `union` are the two
	// kinds that stay a bare `named` all the way through: `resolveNamedStruct` normalizes a struct,
	// `resolveNamedAlias` the function/generic/tuple forms and `resolveFloatAliasType` a float alias, and
	// NOTHING normalizes an enum away — `rewriteRecordedReturnTypes`' header says so in as many words. So a
	// union-returning callee arrives here wearing its name and fails any question it could never pass: a
	// payload-free enum return reads as `E2015 field access on 'lv', which is declared 'int'`, a union
	// return as `E3005 expected 'Container', got 'int'`, and a BOXED union's returned temporary loses its
	// owned-box enrolment altogether — a clean compile and a segfault. The RANGE arm makes the same mistake
	// in its own currency: handing the reader a mint the two files both spell the same way turns
	// `expected 'Level'` into `expected 'Level', got 'int'`.
	//
	// **THE RANGE ARM RUNS FIRST, AND IT RE-SPELLS RATHER THAN ERASES.** Where the two files mint different
	// ranged names for one spelling, the value keeps a name — the SLOT file's mint — because that file's
	// declaration is the one whose bounds the value was checked against.
	//
	// ⚠ **BELOW IT, A DISAGREEMENT IS NOT ENOUGH ON ITS OWN: only a RANGED alias has an erasure that is
	// true.** Where the slot's file means a union and the reader means a struct, erasing to a ranged
	// underlying would be a third wrong answer about a name with no ranged declaration in the pair at all,
	// so that case is left alone — the reader's own rules then refuse it loudly, which is the right
	// outcome until a diagnostic is written for it.
	//
	// It runs after the three repairs above because it must see what they produced.
	function scopeCrossedType(repaired MaxonType, scopeFilePath FilePath) returns MaxonType
		if maxonTypeTag(repaired) != ValueTypeTag.named 'carriesNoNameToCross'
			return repaired
		end 'carriesNoNameToCross'

		let name = self.internedName(typeNameIdOf(repaired))

		let slotRange = self.signatures.rangeScopedDeclaredName(name, readerFilePath: scopeFilePath)

		if not slotRange.equals(self.signatures.rangeScopedDeclaredName(name, readerFilePath: self.job.path)) 'theTwoFilesMeanTwoRanges'
			return MaxonType.named(self.artifact.typeNames.intern(slotRange))
		end 'theTwoFilesMeanTwoRanges'

		if not self.signatures.crossKindContested(name) 'oneKindHoldsTheName'
			return repaired
		end 'oneKindHoldsTheName'

		let slotKind = self.signatures.contestedTypeNameKindFor(name, readerFilePath: scopeFilePath)

		if slotKind == self.signatures.contestedTypeNameKindFor(name, readerFilePath: self.job.path) 'bothFilesMeanTheSameDeclaration'
			return repaired
		end 'bothFilesMeanTheSameDeclaration'

		if slotKind != TypeDeclKind.rangedAlias 'theSlotsMeaningHasNoTrueErasure'
			return repaired
		end 'theSlotsMeaningHasNoTrueErasure'

		return try self.signatures.aliasUnderlyingFor(name, readerFilePath: scopeFilePath) otherwise repaired
	end 'scopeCrossedType'

	function mintOwnedCallResult(inner MaxonType, scopeFilePath FilePath) returns ValueId
		let result = self.mintValueOfType(self.repairSweptType(inner, scopeFilePath: scopeFilePath))

		// ⭐ **THE FLOAT LIFT DROPS THE ALIAS NAME, so the alias is put back beside the value and worn on
		// its name column (`wearFloatAlias`), which keeps it nominal.** `MaxonType.float` has no id slot,
		// so a `returns Float` result lands with tag `float` and no name — and `let f = identity(42.0)`
		// then `f as Float` would read as a cast from a bare `float`, missing E3010. An INT alias keeps
		// its `named` tag and its name, so it needs no entry (see `ValueDeclaredAliasMap`). The test is
		// two tag reads: only the float lift turns a `named` return type into a `float` value.
		if maxonTypeTag(inner) == ValueTypeTag.named and tagIsFloat(self.tagOf(result)) 'floatAliasReturn'
			self.recordValueDeclaredAliasName(result, aliasName: self.internedName(typeNameIdOf(inner)))
			self.wearFloatAlias(result, aliasId: typeNameIdOf(inner))
		end 'floatAliasReturn'

		return result
	end 'mintOwnedCallResult'

	// ⭐⭐ **THE ONE RULE THAT SAYS A CALL'S RESULT OWES A DROP.** It ADOPTS the `+1` the callee took on
	// its way out (`emitOwnedValueReturn`): adoption is the one owned-temp door, `trackOwnedTemp`, exactly as
	// an interpolation temporary rides — `parseBinding` transfers a bound result to a scope-exit drop,
	// `drainPendingTemps` frees an unbound one after the consuming statement. A scalar / payload-free-enum /
	// void / unresolved result owns no heap and is enrolled in nothing, so a call door with nothing to
	// classify may ask unconditionally.
	//
	// ⭐⭐ **AN OPAQUE `T` RESULT IS ADOPTED TOO, AND ITS DROP IS THE DESCRIPTOR-GATED ONE.**
	// A `returns T` callee hands back a `+1` like every other managed return — it retains a borrow
	// through `retainFunc@64` on its way out (`emitOwnedValueReturn`) — so a result the receiver did NOT fix to
	// a concrete type (a `self.get()` relayed inside another shared body) still owes a release.
	// `valueIsManagedHeap` cannot see it: it tests byte-record and aggregate tags and `typeParameter`
	// is neither, which is exactly why the tag is named here. `decrefCalleeFor` routes it to
	// `__drop_type_param`, inert on a trivial instantiation whose `destroyFunc@40` is 0.
	//
	// ⛔⛔ **IT IS ASKED ONCE PER CALL DOOR, AND IT MUST BE ASKED OF THE FINAL TAG.** `valueIsManagedHeap`
	// reads the value's TAG, and an OPAQUE tag is none of `string` / `character` / `structRef` /
	// `genericInstance` / `interfaceRef` and is not `named`, so it always answers `false`. Asked while a
	// generic method's result still carried its declared `T`, it therefore enrolled nothing for a
	// `Box with Alpha` — and forced `typeResultThroughInstance` to decline the substitution rather than
	// contradict a decision already taken. So the DIRECT-call door (`emitCall`) asks AFTER
	// `typeCallResultThroughInstance`; the WITNESS door (`mintWitnessDispatchResult`) and the INDIRECT one
	// (`parseIndirectCall`) have no retype to wait for and ask as soon as the value exists.
	//
	// ⚠ **ASKING AFTER THE RETYPE CAN ONLY ADD ENROLMENTS, NEVER REMOVE ONE.** The retype declines unless the instance
	// fixes something the declaration left open, and the tags it can rewrite (a bare `typeParameter`, and a
	// `genericInstance`/`structRef` whose arguments the receiver settles) each answer this question at
	// least as generously afterwards as before; and the three lifts inside `mintOwnedCallResult`
	// (`resolveNamedStruct`, `resolveFloatAliasType`, `resolveNamedAlias`) each return their argument
	// unchanged unless the tag is `named`. So the retype is strictly not-managed → maybe-managed, and for
	// every non-generic call it is a no-op and this answer is bit-identical to the answer asked before it.
	//
	// ⛔ **IT MUST ALSO RUN BEFORE THE CALL'S OWN OP IS APPENDED.** `routeToTryBlock` relies on
	// the invariant it depends on — *a call's own result is the last thing enrolled before the op is
	// appended* — and takes the result back off the pending list while it builds the error edge, because the
	// `tryCall` never wrote that register on a throw.
	//
	// ⚠⚠ **CO-OWNED, BECAUSE A `return` PROMOTES A BORROW BY INCREF.** `emitOwnedValueReturn` runs a borrowed
	// return value through `promoteBorrowedToOwned`, whose aggregate arm is an `__mm_incref` — so
	// `function getTy(h Holder) returns Ty return h.ty end` hands its caller a SECOND owner of the receiver's
	// field, and the callee's signature records nothing about it. `let t = getTy(h)` then matched and moved its
	// payload out nulled `h.ty`'s slot: MEASURED as a segfault. Telling a fresh-box return from a co-owning one
	// is a whole-program fact (which returns launder a borrow), the same fixpoint the transitive consume waits
	// on; until it exists a call result is a co-owner, which costs one refcount pair and never a stolen slot.
	function enrolOwnedCallTemp(result ValueId)
		// A call that returns a promise handed its thread over, so this frame owns it. It is enrolled as
		// a promise and not as a heap box: `trackOwnedTemp` would drop it through `__mm_decref`,
		// decrementing a word inside the scheduler's slab that is not a refcount.
		//
		// The inference is sound only because a borrow cannot escape a frame: the return door
		// (`requireReturnedPromiseIsNotABorrow`) refuses a promise read out of a container and one no
		// frame owns (a merge, an alias of a parameter), so what reaches a caller was the callee's to
		// give — a spawn, a `pop`/`remove`, or a promise parameter it takes. Adopting a borrow would
		// reclaim one thread twice.
		//
		// The void test comes first and is not redundant: `typeOf` panics on a void tag, and
		// every call reaches here, statement-position void ones included.
		//
		// A result that names the array slot it was read from (`settleCorpusPromiseRead`) is that slot's
		// borrow, not a hand-over, and adopting it would reclaim the thread the array still holds.
		if self.tagOf(result) != ValueTypeTag.void and self.valueIsPromise(result) 'adoptsAGreenThread'
			if self.promiseValueCarriesAContainerSlot(result) 'aSlotBorrow'
				return
			end 'aSlotBorrow'

			self.markValuePromise(result)
			self.bodyState.pendingTempDrops.push(result)
			return
		end 'adoptsAGreenThread'

		if self.valueIsManagedHeap(result) or self.tagOf(result) == ValueTypeTag.typeParameter 'adoptsHeapBox'
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.coOwned)
		end 'adoptsHeapBox'
	end 'enrolOwnedCallTemp'

	// A returned promise must be one this frame owns. One still naming a container slot is a borrow
	// escaping its frame: reading it started a move that is finished by vacating the slot when it is
	// consumed, and a `return` carries it where the slot is no longer nameable, so the container and
	// the caller would both own the thread. That is what makes `Array.last()` a refusal for a promise
	// element while `pop`/`remove`, whose element is moved out and carries no slot, are not; the rule
	// is over the value's state rather than a roster of member names, so a user's own wrapper obeys it
	// too.
	//
	// Any other promise must pass `requireConsumedPromiseIsOwned`, the rule every promise door
	// applies: a merge of promises, or an alias of a parameter, has no owner the return could hand
	// over (E3141).
	function requireReturnedPromiseIsNotABorrow(value ValueId, anchor Token) throws SourceParseError
		if self.promiseValueCarriesAContainerSlot(value) 'stillHeldByItsContainer'
			throw SourceParseError.promiseCannotBeBorrowed(String.from(b"return"), cure: "This promise is still held by the container it was read out of, so returning it would leave two owners. `await` it and return the RESULT, or return one this frame owns outright — a spawn, or an element taken with `pop`/`remove`", line: anchor.line, column: anchor.column)
		end 'stillHeldByItsContainer'

		if self.valueIsPromise(value) 'aPromise'
			try self.requireConsumedPromiseIsOwned(value, anchor: anchor, door: anchor.value)
		end 'aPromise'
	end 'requireReturnedPromiseIsNotABorrow'

	// ⭐ **A CALL THROUGH A FUNCTION VALUE** — `f(21)`, `h.op(21)`, `pick()(21)`. The cursor sits
	// on the `(`; `callee` is the SSA value holding the function record (a `function`-tagged value
	// produced by a functionRef, a param, a field load, or another call). Arguments are POSITIONAL: a
	// function type's parameter names are documentation only, so there is nothing to label — `f(a, b)`
	// is two positional args, which a direct call would reject (rest-labelled), so indirect calls have
	// their own arg parser.
	function parseIndirectCall(func IrFunction, callee ValueId, resultUsed bool) returns ValueId throws SourceParseError
		let calleeTok = self.tokenAt(self.pos - 1)
		let anchor = self.current()
		let governing = self.functionValueGoverningId(callee)
		try self.consume(TokenKind.leftParen)
		self.anchorCalleeReadOutOfASlot(callee, range: SourceRange.ofToken(anchor))

		let args = ValueIdArray.create(0)
		let argImmutableNames = NameRoster.create(0)
		let argRanges = SourceRangeArray.create(0)
		let argAnchors = TokenIndexArray.create(0)
		let places = try self.parseIndirectCallArgs(func, governing: governing, args: args, names: argImmutableNames, argRanges: argRanges, argAnchors: argAnchors, anchor: anchor, calleeName: calleeTok.value)
		try self.requireNoLinearArgumentIn(args, refusal: self.unknownCalleeLinearSentence("a function value"), anchor: anchor)
		let argsAreChecked = self.indirectArgumentsAreChecked(governing, args: args, anchor: anchor)

		let rparenTok = try self.consume(TokenKind.rightParen)
		self.widenFunctionValueArgs(governing, args: args, anchor: anchor, rparenTok: rparenTok)
		try self.takePromisesTheFunctionTypeTakes(governing, args: args, argRanges: argRanges, anchor: anchor)
		try self.handIsolatedArgumentsTheFunctionTypeTakes(governing, args: args, argRanges: argRanges, anchor: anchor)

		// ⭐ **THE FUNCTION RECORD IS THE TRAILING ARGUMENT — UNIFORMLY.** The callee reads its captures
		// out of the record it was called through, which is what lets a callee only known to be
		// `function(T) returns R` — a value passed DOWN to a generic `apply(f, x)` — be called without
		// static knowledge of whether it captures.
		args.push(callee)

		let result = try self.mintIndirectCallResult(governing, resultUsed: resultUsed, anchor: anchor)
		let pending = try self.pendingIndirectPlaces(places)
		try self.notePromiseCellsTheFunctionTypeTakes(governing, pending: pending, args: args, argRanges: argRanges, anchor: anchor)

		// The indirect twin of `emitCall`'s enrolment, and in the same place — between the mint and the op.
		// No retype stands in between here (a function VALUE's return type is already concrete), so the
		// position is dictated only by `enrolOwnedCallTemp`'s "before the op is appended" half.
		self.enrolOwnedCallTemp(result)

		if argsAreChecked 'theQuantityDoorIsKept'
			self.markCallChecked(result)
		end 'theQuantityDoorIsKept'

		let callOpIndex = self.artifact.module.ops.count()
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.indirectCall(result, callee: callee, args: args, argImmutableNames: argImmutableNames), range: SourceRange.between(anchor, last: rparenTok))

		self.noteFunctionValueCallSite(func, opIdx: callOpIndex, args: args, argAnchors: argAnchors)
		self.noteResultCapabilityThrough(result, carrier: callee, declared: self.indirectResultCapabilityDeclared(governing))

		if not self.valueIsAValueType(result) and self.nameIsListed(self.frozenResultClosures, name: self.internedName(governing)) 'aClosureHandingBackFrozenData'
			self.setValueCapability(result, capability: ValueCapability.immutable)
		end 'aClosureHandingBackFrozenData'

		self.recordDeferredArgumentBindings(pending, callResult: result)
		self.recordBrandHandOversToFunctionValue(places, opIndex: callOpIndex, range: SourceRange.between(anchor, last: rparenTok))
		return result
	end 'parseIndirectCall'

	function spelledArgumentName(spelledTok Token, anchorIndex ElementIndex, namesItself bool) returns immutable ByteArray
		if let literal = try literalOperandOf(spelledTok, alone: namesItself or self.operandEndsAt(anchorIndex + 1)) 'aLiteralArgument'
			return match literal 'literal'
				byteString gives ByteLiteralSubject
				closure gives ClosureLiteralSubject
			end 'literal'
		end 'aLiteralArgument'

		if namesItself or (spelledTok.kind == TokenKind.identifier and not self.argumentIsACall(anchorIndex)) 'aNamedArgument'
			return spelledTok.value
		end 'aNamedArgument'

		return freeze self.argumentSpanText(anchorIndex).toByteArray()
	end 'spelledArgumentName'

	function noteWrittenArgumentName(notes CapabilityNotes, opIdx ElementIndex, position ParamCount, anchorIndex ElementIndex)
		notes.noteArgumentName(opIdx, position: position, name: self.spelledArgumentName(self.tokenAt(anchorIndex), anchorIndex: anchorIndex, namesItself: false))
	end 'noteWrittenArgumentName'

	function operandEndsAt(index ElementIndex) returns bool
		let kind = self.kindAt(index)

		return self.statementEndsAt(index) or kind == TokenKind.comma or kind == TokenKind.rightParen
	end 'operandEndsAt'

	function operandSubject(startIndex ElementIndex, alone bool, spelled String) returns String
		let first = self.tokenAt(startIndex)

		if let literal = try literalOperandOf(first, alone: alone) 'aLiteral'
			return match literal 'literal'
				byteString gives String.from(ByteLiteralSubject)
				closure gives closureSiteDisplay(self.job.authoredPath, line: first.line, column: first.column).bare()
			end 'literal'
		end 'aLiteral'

		return "'{spelled}'"
	end 'operandSubject'

	function noteFunctionValueCallSite(func IrFunction, opIdx ElementIndex, args ValueIdArray, argAnchors TokenIndexArray)
		let notes = self.notesForWrite(func)

		for i in 0 upto argAnchors.count() 'eachWrittenArgument'
			self.noteWrittenArgumentName(notes, opIdx: opIdx, position: i as ParamCount, anchorIndex: try argAnchors.get(i) otherwise panic("noteFunctionValueCallSite: argAnchors.get OOB at {i}"))
		end 'eachWrittenArgument'

		self.noteWindowCall(func, opIdx: opIdx, args: args, callOpen: PendingCallOpen.none)
	end 'noteFunctionValueCallSite'

	function argOwesTheQuantityDoor(arg ValueId) returns bool
		return self.unsignedLiteralAwaitsAdmission(arg) or (self.argIsAnIntegerQuantity(arg) and not self.valueFillsAnUnsignedQuantity(arg))
	end 'argOwesTheQuantityDoor'

	function anyArgOwesTheQuantityDoor(args ValueIdArray) returns bool
		for arg in args 'eachArg'
			if self.argOwesTheQuantityDoor(arg) 'owesIt'
				return true
			end 'owesIt'
		end 'eachArg'

		return false
	end 'anyArgOwesTheQuantityDoor'

	function recordQuantityDoor(arg ValueId, alias RangedTypeAlias, anchor Token)
		if self.unsignedLiteralAwaitsAdmission(arg) 'anUnsignedLiteral'
			self.admitUnsignedLiteral(arg)
			self.recordConstantArgSite(arg, parameter: ArgSiteParameter.slotAlias(alias.clone()), anchor: anchor)
			return
		end 'anUnsignedLiteral'

		if aliasIsFloat(alias) or not aliasIsUnsignedFullQuantity(alias) or not self.argIsAnIntegerQuantity(arg) 'noQuantityDoor'
			return
		end 'noQuantityDoor'

		self.recordRangedTargetSite(arg, target: alias, line: anchor.line, column: anchor.column)
	end 'recordQuantityDoor'

	function markCallChecked(result ValueId)
		self.bodyState.checkedCalls = withValueMarked(self.bodyState.checkedCalls, value: result)
	end 'markCallChecked'

	function indirectArgumentsAreChecked(governing TypeNameId, args ValueIdArray, anchor Token) returns bool
		if not self.anyArgOwesTheQuantityDoor(args) 'nothingOwed'
			return true
		end 'nothingOwed'

		let shape = self.functionValueShape(governing)

		for (position, given) in args.withIterator() 'eachArg'
			if not self.argOwesTheQuantityDoor(given) 'owesNothing'
				continue
			end 'owesNothing'

			let param = try shape.paramTypes.get(position.index()) otherwise return false

			if tagIsFloat(maxonTypeTag(param)) 'aFloatParameter'
				self.admitUnsignedLiteral(given)
				continue
			end 'aFloatParameter'

			match self.indirectParamAlias(param, scope: shape.scopeFilePath) 'paramType'
				undeclared then return false
				declared(ranged) then self.recordQuantityDoor(given, alias: ranged, anchor: anchor)
			end 'paramType'
		end 'eachArg'

		return true
	end 'indirectArgumentsAreChecked'

	function indirectParamAlias(param MaxonType, scope FilePath) returns DeclaredAlias
		if maxonTypeTag(param) != ValueTypeTag.named 'namesNoAlias'
			return DeclaredAlias.undeclared
		end 'namesNoAlias'

		return self.signatures.fileScopedOrInnerAliasNamed(self.internedName(typeNameIdOf(param)), readerFilePath: scope)
	end 'indirectParamAlias'

	function asyncArgumentsAreChecked(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token) returns bool
		if not self.anyArgOwesTheQuantityDoor(args) 'nothingOwed'
			return true
		end 'nothingOwed'

		for i in 0 upto args.count() 'eachArg'
			let given = try args.get(i) otherwise panic("asyncArgumentsAreChecked: args.get OOB at {i}")

			if not self.argOwesTheQuantityDoor(given) 'owesNothing'
				continue
			end 'owesNothing'

			match self.signatures.parameterAliasAt(callee, argIndex: i as ParamCount, label: callArgumentLabel(argLabels, argIndex: i as ParamCount)) 'paramType'
				undeclared then return false
				declared(ranged) then self.recordQuantityDoor(given, alias: ranged, anchor: anchor)
			end 'paramType'
		end 'eachArg'

		return true
	end 'asyncArgumentsAreChecked'

	function serviceArgumentsAreChecked(payloads PayloadFieldArray, slotValues ValueIdArray, filled BoolArray, anchor Token) returns bool
		for (position, field) in payloads.withIterator() 'eachSlot'
			let slot = position.index()
			let given = try filled.get(slot) otherwise panic("serviceArgumentsAreChecked: filled.get OOB at {slot} — the columns are sized to the variant's payload count")

			if not given or fieldIsTheServiceReplySlot(field) or fieldIsAServiceWitnessHalf(field) 'noArgumentHere'
				continue
			end 'noArgumentHere'

			let value = try slotValues.get(slot) otherwise panic("serviceArgumentsAreChecked: slotValues.get OOB at {slot}")

			if not self.argOwesTheQuantityDoor(value) 'owesNothing'
				continue
			end 'owesNothing'

			let alias = try self.rangeCheckedAliasOf(self.signatures.adoptType(field.declaredType, into: self.artifact.typeNames)) otherwise return false
			self.recordQuantityDoor(value, alias: alias, anchor: anchor)
		end 'eachSlot'

		return true
	end 'serviceArgumentsAreChecked'

	function valueAWitnessFormalReceives(given ValueId) returns ValueId throws AbsentError
		if not valueIsMarked(self.bodyState.argumentStorage, value: given) 'handedAsAValue'
			return given
		end 'handedAsAValue'

		return try self.scratchCellFillOf(given)
	end 'valueAWitnessFormalReceives'

	function witnessArgumentsAreChecked(args ValueIdArray, target WitnessDispatchTarget, anchor Token) returns bool
		for (position, formal) in target.paramTypes.withIterator() 'eachFormal'
			let given = try self.valueAWitnessFormalReceives(try args.get(position.index() + WitnessReceiverArgCount) otherwise panic("witnessArgumentsAreChecked: args.get OOB at formal {position.index()} — a dispatch has the receiver plus one actual per formal")) otherwise continue

			if not self.argOwesTheQuantityDoor(given) 'owesNothing'
				continue
			end 'owesNothing'

			let alias = try self.signatures.requirementRangedAlias(formal, interfaceName: target.declaringInterfaceName) otherwise return false
			self.recordQuantityDoor(given, alias: alias, anchor: anchor)
		end 'eachFormal'

		return true
	end 'witnessArgumentsAreChecked'

	function anchorCalleeReadOutOfASlot(callee ValueId, range SourceRange)
		if not valueIsMarked(self.bodyState.overwritableSlotReads, value: callee) or not self.holdIsOwed(callee) 'nothingTheCallCanFree'
			return
		end 'nothingTheCallCanFree'

		self.trackOwnedTemp(self.emitHoldMarker(callee, kind: HoldKind.calleeValue, range: range), exclusivity: OwnedHeapExclusivity.coOwned)
	end 'anchorCalleeReadOutOfASlot'

	// The POSITIONAL arguments of an indirect call — comma-separated expressions, no labels (a function
	// TYPE has no parameter names, so `indirectCall` carries no `argLabels`/`argRanges`; see MaxonDialect).
	// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
	// `parseCallArgs`' reason: an argument is parsed inside an expression that already seeded `currentBlock`.
	function parseIndirectCallArgs(func IrFunction, governing TypeNameId, args ValueIdArray, names NameRoster, argRanges SourceRangeArray, argAnchors TokenIndexArray, anchor Token, calleeName ByteArray) returns PlaceArgumentArray throws SourceParseError
		var places = PlaceArgumentColumn.unwritten

		if self.at(TokenKind.rightParen) 'noArgs'
			return placeArgumentsOf(places)
		end 'noArgs'

		let byRefPositions = self.indirectByRefPositionsOf(governing)
		let firstLend = self.bodyState.operandOrder.lendCount()
		_ = self.bodyState.operandOrder.beginCall()

		while true 'argLoop'
			let valueStart = self.pos
			let valueTok = self.current()
			let column = args.count() as ParamCount
			let readsAPlace = maskHasParam(byRefPositions, param: column)
			self.statement.cellArgumentToken = self.cellArgumentAnchorAt(valueStart) if readsAPlace else CellArgumentToken.none
			self.statement.cellArgumentWantsAPlace = readsAPlace
			let requestedTheCell = self.statement.cellArgumentToken.isPending()
			self.stateLiteralTargetForIndirectArgument(governing, position: args.count(), valueStart: valueStart)
			let value = try self.parseValueExpression(func)
			let handed = self.takeArgumentRoot(requestedTheCell)
			let handedPlace = self.statement.takeHandedPlaceStorage()
			argRanges.push(SourceRange.ofToken(valueTok))
			argAnchors.push(valueStart)
			args.push(self.holdStorageReadForStatement(value, kind: operandHoldKindOf(OperandPassing.intoPlace if readsAPlace else OperandPassing.asValue, valueKind: HoldKind.callOperand), range: SourceRange.ofToken(valueTok), position: OperandSuccession.alwaysFollowed))
			names.push(self.expressionImmutableBlame(valueTok, valueStart: valueStart))

			if readsAPlace 'aPositionTheValueWrites'
				if let name = try self.bareBindingNamedBy(valueStart).localName() 'aNamedLocalToAFunctionValue'
					try self.requireNotAnUnmarkedParameter(func, name: name, parameter: WrittenParameter.positional(column), callAnchor: anchor)
					try self.requireLocalIsWritableByReference(name, parameter: WrittenParameter.positional(column), callAnchor: anchor)
				end 'aNamedLocalToAFunctionValue'
			end 'aPositionTheValueWrites'

			if readsAPlace 'bindsAfterTheCalleeIsKnown'
				if let root = try handed.rootOfTheLend() 'aCellWasHanded'
					self.bodyState.operandOrder.lendCell(root, argumentStart: valueStart, write: LendWrite.unknown(calleeName), heldUntilStatementEnd: false)
				end 'aCellWasHanded'

				try self.requireNonStorageIsNotWritten(func, valueStart: valueStart, parameter: WrittenParameter.positional(column), callAnchor: anchor)
				try self.requireTheHandedCellHasTheFunctionTypesFormal(governing, column: column, storage: handedPlace, range: SourceRange.ofToken(valueTok))
				places = withPlaceArgument(places, place: PlaceArgument.create(column, value: value, storage: handedPlace, anchor: valueTok, source: PlaceSource.written(valueStart, position: column)))
				self.noteSpanMayWriteItsBinding(valueStart)
			end 'bindsAfterTheCalleeIsKnown'

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'

			try self.consume(TokenKind.comma)
		end 'argLoop'

		self.settleCallLends(firstLend)

		return placeArgumentsOf(places)
	end 'parseIndirectCallArgs'

	function indirectByRefPositionsOf(governing TypeNameId) returns ParamPositionMask
		if not self.signatures.programTakesAParamByRef() 'nothingIsPassedByReference'
			return NoParamPositions
		end 'nothingIsPassedByReference'

		return self.functionValueShape(governing).byRefParams
	end 'indirectByRefPositionsOf'

	function pendingIndirectPlaces(places PlaceArgumentArray) returns PendingArgumentBindingArray throws SourceParseError
		let pending = PendingArgumentBindingArray.create(places.count(), zeroed: false)

		for place in places 'eachPlace'
			pending.push(PendingArgumentBinding.create(place.column, cell: try self.placeStorageFor(place)))
		end 'eachPlace'

		return pending
	end 'pendingIndirectPlaces'

	function stateLiteralTargetForIndirectArgument(governing TypeNameId, position ElementIndex, valueStart ElementIndex)
		let opening = self.kindAt(valueStart)

		if opening != TokenKind.leftBracket and opening != TokenKind.leftParen 'noLiteralToType'
			return
		end 'noLiteralToType'

		let shape = self.functionValueShape(governing)
		let param = try shape.paramTypes.get(position) otherwise return

		if opening == TokenKind.leftBracket 'anArrayLiteral'
			self.stateArrayLiteralTargetAt(self.signatures.arrayInstanceOfDeclaredType(param, interner: self.artifact.typeNames, readerFilePath: shape.scopeFilePath), tokenIndex: valueStart)
			return
		end 'anArrayLiteral'

		if maxonTypeTag(param) == ValueTypeTag.structRef 'aRecordParameter'
			self.stateTupleLiteralTargetAt(tupleTargetNamed(self.internedName(typeNameIdOf(param))), tokenIndex: valueStart)
		end 'aRecordParameter'
	end 'stateLiteralTargetForIndirectArgument'

	// Mint the SSA value an indirect call defines, typed from the CALLEE FUNCTION VALUE's return type —
	// the mirror of `mintDeclaredCallResult` for a direct call. Here the return type is recovered from the
	// callee value's OWN function type (its governing name), and the value-returning tail
	// (`mintOwnedCallResult`) is shared, so an indirect call binds its result exactly as a direct one does.
	//
	// ⭐ A VOID FUNCTION VALUE IS REJECTED AT THE CALL WHEN ITS RESULT IS USED, exactly as a void DIRECT
	// call is (`resultUsed`, mirroring `mintDeclaredCallResult`). This UPHOLDS the invariant that
	// `maxonTypeOfTag`/`valueTagToStdType` assert — a `void` value is minted ONLY as a discarded statement
	// result, NEVER in a position that reads it. Without the guard, `let cb = doIt; let x = cb()` minted a
	// void value that reached `typeOf` and PANICKED, where the void DIRECT call `let x = doIt()` cleanly
	// reports E2004. Statement position (`resultUsed: false`) still mints the discarded
	// void value; every value position (`resultUsed: true` — a binding, `return`, an operand, an argument)
	// reports E2004 HERE, at the call, the same anchor and text the direct-call diagnostic uses.
	function mintIndirectCallResult(governing TypeNameId, resultUsed bool, anchor Token) returns ValueId throws SourceParseError
		let recovered = self.functionValueShape(governing)

		match recovered.returnType 'r'
			value(inner) then return self.mintSettledCallResult(inner, scopeFilePath: recovered.scopeFilePath)
			void then break
		end 'r'

		// A VOID function value used where a value belongs. Reported with the callee's governing function
		// name (`functionValueShape` proved it resolvable to reach the `void` arm), the E2004 spelling
		// `mintDeclaredCallResult` renders for a void direct call.
		if resultUsed 'noValueToUse'
			throw SourceParseError.voidCallResultUsed(String.from(genericTemplateName(self.internedName(governing))), line: anchor.line, column: anchor.column)
		end 'noValueToUse'

		return self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)
	end 'mintIndirectCallResult'

	function mintSettledCallResult(returnType MaxonType, scopeFilePath FilePath) returns ValueId
		let result = self.mintOwnedCallResult(returnType, scopeFilePath: scopeFilePath)
		self.settleFloatResult(result)
		return result
	end 'mintSettledCallResult'

	// The parameter and return types of a function value, recovered from its governing name (see
	// `MaxonType`'s `function` arm), paired with the file whose scope those types are resolved in. One
	// walk answers all three, so a new source cannot be given a type without a scope.
	//
	// ⚠ The scope is memory safety: an indirect call's result is repaired like any other swept type,
	// in the scope of the file that declared the slot. Resolved in the calling file, an alias's
	// `Token` can name a different declaration there, and the call's result is typed as the wrong
	// type.
	//   • a lifted closure is this parse's own (`closureShapes` is file-local), so its slot is this
	//     file's;
	//   • a top-level initializer's closure carries the scope its probe recorded
	//     (`ProgramSignatures.initializerClosureShapeFor`);
	//   • a function alias carries its declaring file (`FunctionTypeAlias.declFilePath`);
	//   • a declared function's slot is `recordedReturnDeclFileOf`'s answer, the door a direct call
	//     asks.
	// A name is a function alias or a function, never both, so the order of those two lookups is
	// immaterial.
	function functionValueShape(governing TypeNameId) returns FunctionValueShape
		let name = self.internedName(governing)

		// A closure's `$`-suffixed name is unwritable in source, so it shadows no function or alias.
		if let closure = try self.closureShapes.get(name) 'closure'
			return closure
		end 'closure'

		if let initializerClosure = try self.signatures.initializerClosureShapeFor(name, into: self.artifact.typeNames) 'initializerClosure'
			return initializerClosure
		end 'initializerClosure'

		match self.functionAliasForName(name) 'alias'
			// `maxonTypeOfStoredAliasReturn` is the one rebuild of a stored alias return; it recovers
			// `ExitCode`'s u32 width from the stored name, which a second spelling would drop to a `named`
			// i64.
			declared(alias) then return FunctionValueShape.create(self.aliasParamTypes(alias), returnType: maxonTypeOfStoredAliasReturn(alias, typeNames: self.artifact.typeNames), scopeFilePath: alias.declFilePath, promisesTaken: self.aliasPromisesTaken(alias), byRefParams: self.signatures.aliasByRefMask(alias), isolatedParams: self.signatures.aliasIsolatedMask(alias))
			undeclared then break
		end 'alias'

		if self.signatures.declaresCallee(name) 'aDeclaredFunction'
			return self.functionValueShapeOf(try self.signatures.sweptDeclarationOf(name) otherwise panic("functionValueShape: '{String.from(name)}' is a declared function, and `ProgramSignatures.record` files its declaration under `sweptDeclarations` in the same act as `returnTypes`"))
		end 'aDeclaredFunction'

		// A function-backed enum's `.rawValue` is the one mint whose name is not checked in the reading
		// file. When the declaring file refused the case (E3095, E2004), the call defers and that refusal
		// reports it.
		if self.signatures.backsAFunctionBackedEnumCase(name) 'aRefusedEnumCaseBacking'
			return FunctionValueShape.create(MaxonTypeArray.create(0), returnType: MaxonReturnType.value(MaxonType.unresolved), scopeFilePath: self.job.path, promisesTaken: BoolArray.create(0), byRefParams: NoParamPositions, isolatedParams: NoParamPositions)
		end 'aRefusedEnumCaseBacking'

		panic("functionValueShape: a `function`-tagged value's governing name '{String.from(name)}' is neither a lifted closure, a function alias, a declared function, nor a function-backed enum case's backing name — every function value is minted from one of the four (parseClosureExpression / parseTypeReference / emitFunctionRef / a function-backed enum's `.rawValue`)")
	end 'functionValueShape'

	function takePromiseOutOfCell(cell ValueId, column ParamCount, args ValueIdArray, argRanges SourceRangeArray, anchor Token) throws SourceParseError
		if valueIsMarked(self.bodyState.borrowedScratchCells, value: cell) and self.cellHoldsAPromise(self.typeOf(cell)) 'theCellOnlyLentTheHandle'
			let lent = try self.scratchCellFillOf(cell) otherwise panic("takePromiseOutOfCell: a borrowed scratch cell v{cell} has no recorded fill")
			try self.takePromiseIntoCallee(lent, column: column, args: args, argRanges: argRanges, anchor: anchor)
			return
		end 'theCellOnlyLentTheHandle'

		self.noteCellPromiseTaken(cell)
	end 'takePromiseOutOfCell'

	function notePromiseCellsTheFunctionTypeTakes(governing TypeNameId, pending PendingArgumentBindingArray, args ValueIdArray, argRanges SourceRangeArray, anchor Token) throws SourceParseError
		let shape = self.functionValueShape(governing)

		for binding in pending 'eachPlace'
			if not shape.takesPromiseAt(binding.column) 'notTaken'
				continue
			end 'notTaken'

			try self.takePromiseOutOfCell(binding.cell, column: binding.column, args: args, argRanges: argRanges, anchor: anchor)
		end 'eachPlace'
	end 'notePromiseCellsTheFunctionTypeTakes'

	function noteCellPromiseTaken(cell ValueId)
		if not self.cellHoldsAPromise(self.typeOf(cell)) 'notAPromiseCell'
			return
		end 'notAPromiseCell'

		let index = try self.liveOwnerIndexOf(cell) otherwise return
		let owned = try self.bodyState.ownedBindings.get(index) otherwise panic("noteCellPromiseTaken: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf`")

		if not owned.isCellBinding 'notACell'
			return
		end 'notACell'

		owned.setMovedFrom(true, ledger: self.bodyState.moveLedger)
	end 'noteCellPromiseTaken'

	function takePromisesTheFunctionTypeTakes(governing TypeNameId, args ValueIdArray, argRanges SourceRangeArray, anchor Token) throws SourceParseError
		let shape = self.functionValueShape(governing)
		let byRefPositions = self.indirectByRefPositionsOf(governing)

		for position in 0 upto args.count() 'eachArgument'
			let arg = try args.get(position) otherwise panic("takePromisesTheFunctionTypeTakes: args.get OOB at {position}")

			if not self.valueIsPromise(arg) or not shape.takesPromiseAt(position) or maskHasParam(byRefPositions, param: position as ParamCount) 'notTaken'
				continue
			end 'notTaken'

			try self.takePromiseIntoCallee(arg, column: position as ParamCount, args: args, argRanges: argRanges, anchor: anchor)
		end 'eachArgument'
	end 'takePromisesTheFunctionTypeTakes'

	function handIsolatedArgumentsTheFunctionTypeTakes(governing TypeNameId, args ValueIdArray, argRanges SourceRangeArray, anchor Token) throws SourceParseError
		let isolated = self.functionValueShape(governing).isolatedParams

		for position in 0 upto args.count() 'eachArgument'
			if not maskHasParam(isolated, param: position as ParamCount) 'notAnIsolatedPosition'
				continue
			end 'notAnIsolatedPosition'

			try self.handIsolatedArgumentAt(args, position: position, range: try argRanges.get(position) otherwise panic("handIsolatedArgumentsTheFunctionTypeTakes: argRanges.get OOB at {position} — args and argRanges are pushed in lockstep"), anchor: anchor)
		end 'eachArgument'
	end 'handIsolatedArgumentsTheFunctionTypeTakes'

	function handIsolatedAsyncArguments(callee ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, cells ParamPositionMask, anchor Token) throws SourceParseError
		let declaration = try self.declarationNameableHere(callee) otherwise return
		let isolated = self.signatures.isolatedParamBitsOf(declaration)

		for column in 0 upto args.count() as ParamCount 'eachArgument'
			let position = try argSlotPosition(declaration.paramNames, argIndex: column, label: callArgumentLabel(argLabels, argIndex: column)) otherwise continue

			if maskHasParam(cells, param: column) 'theCallersCellStaysItsOwn'
				continue
			end 'theCallersCellStaysItsOwn'

			if not (try isolated.get(position) otherwise false) or self.valueIsAValueType(try args.get(column) otherwise panic("handIsolatedAsyncArguments: args.get OOB at {column}")) 'notAnIsolatedRecord'
				continue
			end 'notAnIsolatedRecord'

			try self.handIsolatedArgumentAt(args, position: column, range: try argRanges.get(column) otherwise panic("handIsolatedAsyncArguments: argRanges.get OOB at {column} — args and argRanges are pushed in lockstep"), anchor: anchor)
		end 'eachArgument'
	end 'handIsolatedAsyncArguments'

	function handIsolatedArgumentAt(args ValueIdArray, position ElementIndex, range SourceRange, anchor Token) throws SourceParseError
		let arg = try args.get(position) otherwise panic("handIsolatedArgumentAt: args.get OOB at {position}")
		try self.requireNotMovedSinceItWasRead(arg, range: range)
		try args.set(position, value: self.handIsolatedArgument(arg, anchor: anchor)) otherwise panic("handIsolatedArgumentAt: args.set OOB at {position}")
	end 'handIsolatedArgumentAt'

	function aliasPromisesTaken(alias FunctionTypeAlias) returns BoolArray
		let taken = BoolArray.create(alias.paramTypes.count(), zeroed: false)

		for declared in self.aliasParamTypes(alias) 'eachParameter'
			taken.push(typeIsPromiseStorage(self.signatures, t: declared))
		end 'eachParameter'

		return taken
	end 'aliasPromisesTaken'

	function aliasParamTypes(alias FunctionTypeAlias) returns MaxonTypeArray
		let paramTypes = MaxonTypeArray.create(alias.paramTypes.count(), zeroed: false)

		for param in alias.paramTypes 'eachParam'
			paramTypes.push(self.repairSweptType(maxonTypeOfStoredAliasParam(param, typeNames: self.artifact.typeNames), scopeFilePath: alias.declFilePath))
		end 'eachParam'

		return paramTypes
	end 'aliasParamTypes'

	function functionValueShapeOf(decl SweptDeclaration) returns FunctionValueShape
		let paramTypes = MaxonTypeArray.create(decl.paramTypes.count(), zeroed: false)

		for swept in decl.paramTypes 'eachParam'
			paramTypes.push(self.sweptParamType(swept, scopeFilePath: decl.declFilePath))
		end 'eachParam'

		return FunctionValueShape.create(paramTypes, returnType: self.signatures.adoptReturnType(decl.returnType, into: self.artifact.typeNames), scopeFilePath: decl.declFilePath, promisesTaken: self.promisesTakenBy(decl, count: paramTypes.count()), byRefParams: byReferenceMaskOf(self.signatures.byRefOfDeclaration(decl.site), paramCount: paramTypes.count() as ParamCount), isolatedParams: self.signatures.isolatedParamMaskOf(decl))
	end 'functionValueShapeOf'

	function promisesTakenBy(decl SweptDeclaration, count ElementIndex) returns BoolArray
		let consume = self.signatures.consumeOfDeclaration(decl.site)
		let taken = BoolArray.create(count, zeroed: false)

		for position in 0 upto count 'eachPosition'
			taken.push(consume.takesPromiseAt(position as ParamCount))
		end 'eachPosition'

		return taken
	end 'promisesTakenBy'

	// Parse an integer literal token into a `literal` op, and return the value it defines.
	// The token's text becomes a number through the shared `intLiteralValue`, so a literal
	// in an expression and a literal in a range bound are read the same way.
	function parseIntLiteral() returns ValueId throws SourceParseError
		let tok = try self.consume(TokenKind.intLiteral)
		let value = try self.intLiteralValue(tok, negated: false)
		let result = self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(tok))

		if value < 0 'writtenAboveTheSignedTop'
			self.markAboveSignedMax(result)
			self.bodyState.unsignedLiteralSites.push(UnsignedLiteralSite.create(result, tok: tok))
		end 'writtenAboveTheSignedTop'

		return result
	end 'parseIntLiteral'

	function markAboveSignedMax(value ValueId)
		self.bodyState.unsignedMaxLiterals = withValueMarked(self.bodyState.unsignedMaxLiterals, value: value)
	end 'markAboveSignedMax'

	function admitUnsignedLiteral(value ValueId)
		if self.bodyState.unsignedLiteralSites.isEmpty() 'noUnsignedLiteralWritten'
			return
		end 'noUnsignedLiteralWritten'

		self.bodyState.admittedUnsignedLiterals = withValueMarked(self.bodyState.admittedUnsignedLiterals, value: value)
	end 'admitUnsignedLiteral'

	function unsignedLiteralAwaitsAdmission(value ValueId) returns bool
		return not self.bodyState.unsignedLiteralSites.isEmpty() and self.valueIsAboveSignedMax(value)
	end 'unsignedLiteralAwaitsAdmission'

	function admitUnsignedLiteralBeside(literal ValueId, partner ValueId)
		if not self.unsignedLiteralAwaitsAdmission(literal) 'notAnUnsignedLiteral'
			return
		end 'notAnUnsignedLiteral'

		self.admitUnsignedLiteralInto(literal, slot: self.tagOf(partner), alias: self.domainDeclaringAlias(partner))
	end 'admitUnsignedLiteralBeside'

	function admitUnsignedLiteralIntoSlot(value ValueId, slot ValueTypeTag, slotNameId TypeNameId)
		if not self.unsignedLiteralAwaitsAdmission(value) 'notAnUnsignedLiteral'
			return
		end 'notAnUnsignedLiteral'

		let alias = self.declaredAliasOfNameId(slotNameId) if slot == ValueTypeTag.named else DeclaredAlias.undeclared
		self.admitUnsignedLiteralInto(value, slot: slot, alias: alias)
	end 'admitUnsignedLiteralIntoSlot'

	function admitUnsignedLiteralInto(literal ValueId, slot ValueTypeTag, alias DeclaredAlias)
		if tagIsFloat(slot) 'aFloatSlot'
			self.admitUnsignedLiteral(literal)
			return
		end 'aFloatSlot'

		let aliasAdmitsIt = match alias 'slotType'
			undeclared gives false
			declared(ranged) gives aliasIsFloat(ranged) or self.edgeProvesAlias(literal, alias: ranged)
		end 'slotType'

		if aliasAdmitsIt 'theAliasAdmitsIt'
			self.admitUnsignedLiteral(literal)
		end 'theAliasAdmitsIt'
	end 'admitUnsignedLiteralInto'

	function admitUnsignedLiteralsAcross(incoming ValueIdArray)
		for literal in incoming 'eachLiteral'
			if not self.unsignedLiteralAwaitsAdmission(literal) 'notAnUnsignedLiteral'
				continue
			end 'notAnUnsignedLiteral'

			for partner in incoming 'eachPartner'
				self.admitUnsignedLiteralBeside(literal, partner: partner)
			end 'eachPartner'
		end 'eachLiteral'
	end 'admitUnsignedLiteralsAcross'

	function reportBareUnsignedLiterals()
		let admitted = self.bodyState.admittedUnsignedLiterals
		let sites = self.bodyState.unsignedLiteralSites

		for site in sites 'eachLiteral'
			if not valueIsMarked(admitted, value: site.value) 'noContextAdmitsIt'
				self.recordArtifactDiagnostic(ErrorCode.parserLiteralOverflow, message: unsignedLiteralWithoutAliasMessage(String.from(site.tok.value)), range: SourceRange.ofToken(site.tok))
			end 'noContextAdmitsIt'
		end 'eachLiteral'
	end 'reportBareUnsignedLiterals'

	// Parse a FLOAT literal token into a `literal` op, and return the value it defines.
	//
	// ⭐ **THE LITERAL'S VALUE IS ITS IEEE-754 BIT PATTERN**, carried in the very same `FullRangeInt`
	// payload an integer literal uses — and that is why a float costs NO new op at either tier.
	// `MaxonOp.literal` and `StdOp.const` already carry a `valueType` beside the bits, and the type is
	// what says how to READ them; 64 bits are 64 bits.
	//
	// ⚠ **THESE BITS ARE RECORDED AS A PARSER CONSTANT IN THE FLOAT DOMAIN, NEVER THE INTEGER ONE**, which
	// is what keeps the danger below a danger rather than a defect.
	// A float in the INTEGER fold columns would let `foldIntBinOp` ADD TWO IEEE PATTERNS AS
	// INTEGERS: `3.14 + 2.0` would fold to a number that is neither 5.14 nor anything else, silently, at
	// compile time. `ConstPayloadDomain` stamps the domain beside the payload and `constIsKnown` answers only
	// for `integer`, so the integer folder cannot reach a float pattern at all. The ONE reader of the float
	// half is the divisor proof (`divisorProof`), which needs to see `let zero = 0.0`.
	function parseFloatLiteral() returns ValueId throws SourceParseError
		let tok = try self.consume(TokenKind.floatLiteral)
		let bits = try self.floatLiteralBits(tok)
		return self.emitLiteral(bits, valueType: MaxonType.float, range: SourceRange.ofToken(tok))
	end 'parseFloatLiteral'

	// `-<numeric literal>` as ONE literal — see `parseUnary`'s note for why the negation belongs to
	// the literal rather than to an operator over it. Both halves read through the SAME decoders the
	// un-negated forms use (`intLiteralValue` with `negated: true`, `negatedFloatBits` over
	// `floatLiteralBits`), which is what makes a negated literal in an expression mean exactly what
	// the same text means in a range bound or a field default. The source range anchors on the `-`,
	// because that is where the literal now starts.
	function parseNegatedNumericLiteral(minusTok Token) returns ValueId throws SourceParseError
		if self.at(TokenKind.floatLiteral) 'float'
			return try self.parseNegatedFloatLiteral(minusTok)
		end 'float'

		let tok = try self.consume(TokenKind.intLiteral)
		let value = try self.intLiteralValue(tok, negated: true)
		let result = self.emitLiteral(value, valueType: MaxonType.integer, range: SourceRange.ofToken(minusTok))
		self.markWrittenNegative(result, value: value)
		return result
	end 'parseNegatedNumericLiteral'

	// The float half of `parseNegatedNumericLiteral`, on its own because the match-pattern reader
	// (`emitNegatedPatternValue`) wants exactly it and nothing of the int half: consume the literal and
	// mint ONE literal op carrying `negatedFloatBits` of its bits — the sign flip, never `0.0 - x`.
	function parseNegatedFloatLiteral(minusTok Token) returns ValueId throws SourceParseError
		let tok = try self.consume(TokenKind.floatLiteral)
		return self.emitLiteral(negatedFloatBits(try self.floatLiteralBits(tok)), valueType: MaxonType.float, range: SourceRange.ofToken(minusTok))
	end 'parseNegatedFloatLiteral'

	// ⭐ **THE ONE SITE THAT RECORDS "THE SOURCE WROTE A NEGATIVE NUMBER HERE"** — see
	// `writtenNegativeLiterals` for what the mark decides. Both minting sites route through it, so the COW
	// discipline and the `-0` exclusion are stated once.
	//
	// `-0` is written with a minus and denotes ZERO, which `int(0 to u64.max)` admits; marking it would
	// refuse a value that is in range. The test is on the DECODED value rather than on the minus token,
	// because "denotes a negative number" is the fact the reader needs.
	function markWrittenNegative(result ValueId, value FullRangeInt)
		if value >= 0 'notNegative'
			return
		end 'notNegative'

		self.bodyState.writtenNegativeLiterals = withValueMarked(self.bodyState.writtenNegativeLiterals, value: result)
	end 'markWrittenNegative'

	// Append a `literal` op into the CURRENT block; return the ValueId it defines.
	function emitLiteral(value FullRangeInt, valueType MaxonType, range SourceRange) returns ValueId
		return self.emitLiteralIn(self.bodyState.currentBlock, value: value, valueType: valueType, range: range)
	end 'emitLiteral'

	// Append a `literal` op into a NAMED block. The short-circuit lowering needs this: its
	// seed literal belongs in the ENTRY block, which by the time the phi is wired is no
	// longer the current one.
	function emitLiteralIn(block IrBlock, value FullRangeInt, valueType MaxonType, range SourceRange) returns ValueId
		let result = self.mintValueOfType(valueType)
		self.emitBodyOp(block, op: MaxonOp.literal(result, value: value, valueType: valueType), range: range)

		// THE root of the parser's constant view. A `let` binds its NAME to the value the
		// initializer produced, so `let SHIFT = -1` binds `SHIFT` to this very id — which is why
		// folding a literal is all it takes to see a count named through a `let`, and
		// a zero divisor named through one (`let zero = 0.0` then `x / zero`).
		//
		// ⭐ **THE TWO DOMAINS ARE RECORDED SEPARATELY, WHICH IS THE OPPOSITE OF RECORDING THEM
		// TOGETHER.** A float in the fold columns would let `foldIntBinOp` add
		// two IEEE patterns as integers, so a float's slot is
		// stamped `float`, `constIsKnown` answers only for `integer`, and `foldIntBinOp` is reachable
		// only through it. See `ConstPayloadDomain`.
		//
		// ⭐ **A `bool` LITERAL IS RECORDED TOO, IN THE INTEGER DOMAIN, AND IT IS THE SAME FACT RATHER THAN A
		// WIDENING OF ONE.** `true`/`false` materialize as `BoolTrueValue`/`BoolFalseValue` — 1 and 0 — and the
		// file already relies on that identity ("the BITWISE fold of two bools is already the LOGICAL answer",
		// `foldIntBinOp`'s note). Leaving it out would be measurable: a CONSTANT `[true, false, true,
		// false]` could not be recognised as constant at all, so `bool-bit-packing`'s constant literal could
		// not become the packed `.rdata` blob its spec pins, purely because the parser declined to write down a
		// value it had in hand. The FLOAT split stays and is the one this gate exists for — an IEEE
		// pattern must never reach `foldIntBinOp`.
		let tag = maxonTypeTag(valueType)

		if tagIsInteger(tag) or tagIsBool(tag) 'integerDomain'
			self.recordConst(result, folded: value)
		end 'integerDomain' else if tagIsFloat(tag) 'float'
			self.recordFloatConst(result, bits: value)
		end 'float'

		return result
	end 'emitLiteralIn'

	// --- token cursor ---

	// The token at an ABSOLUTE index, or a synthetic EOF once past the end. THE one place the
	// past-the-end rule is written down — `current`, `at`, `kindAt` and `peekKind` are all views
	// over this, so a cursor read and a scan read can never disagree about where the tokens stop.
	// The lexer already appends a real EOF, so the synthetic one is a belt-and-suspenders guard.
	function tokenAt(index ElementIndex) returns Token
		if index >= self.tokens.count() 'pastEnd'
			return Token.eof()
		end 'pastEnd'

		return try self.tokens.get(index) otherwise panic("Parser.tokenAt: index<count just checked but tokens.get({index}) failed")
	end 'tokenAt'

	// The token at the cursor.
	function current() returns Token
		return self.tokenAt(self.pos)
	end 'current'

	function at(kind TokenKind) returns bool
		return self.kindAt(self.pos) == kind
	end 'at'

	// The kind of the token at an ABSOLUTE index. The cursor-independent read the token-extent
	// scans need — `blockStatementEndIndex`, `buildWriteSiteIndex` and `opensBlockAt` all walk the
	// token array without moving `pos`.
	function kindAt(index ElementIndex) returns TokenKind
		if index >= self.tokens.count() 'pastEnd'
			return TokenKind.eof
		end 'pastEnd'

		return (try self.tokens.get(index) otherwise panic("Parser.kindAt: index<count just checked but tokens.get({index}) failed")).kind
	end 'kindAt'

	// **WHERE A STATEMENT STOPS, ASKED AT AN ABSOLUTE INDEX** — the `newline` that separates it from the
	// next one, the `end` that closes the enclosing block when it is that block's last statement, or EOF.
	//
	// A `docComment` is admitted only because the lexer never emits one after code on its line
	// (`Lexer.scanComment`), so it can stand here only where a line has already ended.
	//
	// ONE predicate because three readers ask it and a divergence between them is a WRONG DIAGNOSTIC
	// rather than a crash: `atEnumFunctionRawValue` decides that a name IS the whole raw value,
	// `parseReturnStatement` decides that a `return` is BARE, and `rejectDegenerateAssignment` decides
	// that a chain IS the whole right-hand side. Written out three times, a fourth
	// terminator taught to one reader leaves the other two reading a complete statement as an unfinished
	// one, each with its own unrelated-looking error.
	//
	// ⛔ **`requireDeclarationHeaderLineEnd` IS NOT A FOURTH READER AND MUST NOT BE "FINISHED" INTO ONE.** It
	// asks `tokenKindEndsALine` deliberately, WITHOUT `end`: it guards a DECLARATION HEADER, and a header line can
	// never legitimately be closed by the token that closes the body it introduces. Routed through here it
	// would accept `function f() end` — a signature with no newline after it — as a complete header.
	function statementEndsAt(index ElementIndex) returns bool
		let kind = self.kindAt(index)
		return tokenKindEndsALine(kind) or kind == TokenKind.end
	end 'statementEndsAt'

	// The IDENTIFIER text at an ABSOLUTE index, or the empty source text when that token is anything else
	// (a malformed header, or past the end). The tolerant read a SWEEP needs: it must not throw, because a
	// declaration it cannot read is the real parse's to report with a position.
	function interfaceNameAt(index ElementIndex) returns InterfaceName
		return InterfaceName.named(try self.identifierNameAt(index) otherwise return InterfaceName.none)
	end 'interfaceNameAt'

	function identifierNameAt(index ElementIndex) returns immutable ByteArray throws AbsentError
		let tok = self.tokenAt(index)

		if tok.kind != TokenKind.identifier 'notAName'
			throw AbsentError.absent
		end 'notAName'

		return tok.value
	end 'identifierNameAt'

	// **THE token shape of a reassignment, asked at an ABSOLUTE index — and there is exactly ONE
	// of these on purpose.** Two callers ask it and they must never disagree:
	//
	//   • `parseStatement`, deciding that this statement IS a reassignment, and
	//   • `buildWriteSiteIndex`, whose writes decide which vars a loop CARRIES A PHI FOR.
	//
	// Written down twice, a new write form (a compound assignment, a store through a field) taught
	// to the dispatcher and not to the scan would compile: the statement would assign the var, the
	// loop would mint no phi for it, and the var would reset to its pre-loop value on every
	// iteration. A SILENT MISCOMPILE — and, unlike a `blockStatementEndIndex` mismatch, one no drift
	// guard can see, because the loop's EXTENT would still be perfectly correct. Teaching this one
	// predicate teaches both.
	//
	// ⚠ AND IT IS NOT ENOUGH TO MAKE THE NEW FORM MERELY *MATCH* — IT MUST NAME THE RIGHT VAR.
	// `a.b = x` already fits `identifier equals`, at `b`. So a field store taught to THIS predicate
	// would silently start inserting **`b`**, the FIELD, and never `a`, the var that carries the
	// loop value. The phi would be minted for a name nothing writes and withheld from the one that
	// does.
	//
	// ⭐ **THAT IS WHY FIELD STORES HAVE THEIR OWN PREDICATE — `fieldAssignsAt` — AND WHY THIS ONE
	// IS NOT WIDENED**. `parseStatement` routes on both; `assignedBindingsIn` reads
	// only this one, and that is CORRECT rather than an omission: **a field store assigns no
	// binding.** `p` is a box pointer that `p.x = 5` never reassigns — the write goes to MEMORY,
	// through `storeIndirect`, and the box's address is the same value afterwards. So there is no
	// loop-carried value to merge and no phi to mint.
	//
	// ⚠ `c.value = c.value + 1` DOES make this scan insert `value`, at the field token, and it is
	// harmless — but **for the over-approximation note's SHADOWING reason, not its "selects nothing"
	// one**, and the difference is worth stating because only one of the two survives a local of the
	// same name. With no local called `value`, the name binds nothing at the header and selects
	// nothing. With `var value` ALSO in scope it DOES select, and a header phi IS minted for a var
	// the loop never writes. That phi CARRIES NOTHING — every incoming value is the same one,
	// precisely because nothing assigns it — which is the shape `elimTrivialBlockArgs` exists to fold
	// away (see PassPipeline). MEASURED rather than argued: that program returns 102, the right
	// answer.
	//
	// ⚠ A write with NO `=` ANYWHERE cannot be covered by either half of the above, because it is
	// not a statement to teach the dispatcher about: a `var` PARAMETER is written by `mutate(p)`
	// at the call site. `ParameterBindingKind` is the tripwire for that one — see `assignedBindingsIn`.
	function assignsAt(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.kindAt(index + 1) == TokenKind.equals
	end 'assignsAt'

	// ⭐ **WHAT ONE ELEMENT OF A CONFIRMED TARGET LIST IS**, read off the identifier at `nameIndex` and the
	// token before it. THE one classifier, so the loop-phi token scan and the parse cannot come to disagree
	// about which elements are WRITES to a binding already in scope — a disagreement in that direction is
	// not a missed diagnostic but a loop that recomputes from its entry value every trip
	// (`assignedBindingsIn`'s "under-approximating would drop a real phi").
	//
	// Precondition: `nameIndex` is an identifier inside a list `tupleAssignEqualsIn` has already accepted AS A
	// TUPLE ASSIGNMENT, so the token before it is the qualifier or a separator and nothing else. That
	// predicate refuses the DECLARING form outright, which is what makes the precondition true: in
	// `let (x, y) = t` the keyword sits before the PAREN and never before a name, so every name would
	// classify as a REBIND here.
	//
	// The discard name is tested before the qualifier, so `(let _, y) = f()` discards its first element as
	// `(_, y) = f()` and `let (a, _) = t` do: `_` declares no binding in any destructuring form.
	function tupleAssignTargetAt(nameIndex ElementIndex) returns TupleAssignTarget
		let qualifier = self.kindAt(nameIndex - 1)

		if self.tokenAt(nameIndex).value.equals(DiscardBindingName) 'discards'
			return TupleAssignTarget.discards
		end 'discards'

		if bindingKeywordSpells(qualifier) 'declaresAName'
			return TupleAssignTarget.declares(bindingKindOfKeyword(qualifier))
		end 'declaresAName'

		return TupleAssignTarget.rebinds
	end 'tupleAssignTargetAt'

	// ⭐ **THE BRACKET BOOKKEEPING EVERY PEEK-ONLY BODY WALK KEEPS** — `scanBodyFacts` (the sweep's, over a
	// whole declaration), `scanOneMethodFeedSignals`, and through `stepBodyWalk` the walks over one body:
	// `cellLocalNamesIn` (the parse's, ONCE — never over one binding's remaining scope, which is the
	// Θ(vars × tokens) shape that header rejects by name). They ask different questions
	// and need the
	// identical state, and a second copy of a push/pop pair is a second chance
	// for the two columns to fall out of lockstep — at which point `openBrackets`' top names the wrong call and
	// a forwarding edge is recorded against a function that never saw the argument.
	//
	// `openBrackets` carries the TOKEN INDEX of each open `(` or `{`, which is what makes "which call is this
	// argument in?" an O(1) read of the top rather than a backwards walk. ⚠ A `[` is NOT tracked here — an
	// index expression opens no call and holds no struct literal. `stepBodyWalk` counts subscripts itself
	// (`BodyWalk.openSubscripts`), so a comma inside one does not advance its argument index.
	//
	// ⭐ **IT HOLDS THE INDEX AND NOT THE CALLEE NAME, AND THAT IS BOTH CHEAPER AND MORE HONEST.** An index is
	// a scalar push where a name was a `ByteArray` one, and it is pushed for every `(` and `{` in every body
	// — while the two things a reader actually wants (`calleeNameOpeningAt`, `forwardCallOpeningAt`) are needed
	// only at a real forwarding candidate, which is rare. It also lets those readers see the bracket's own KIND
	// rather than trusting the pusher to have blanked a `{`, so "a struct literal opens no call" is checked
	// where it is spent instead of maintained across a column.
	function trackBracketAt(index ElementIndex, braceStack BoolArray, openBrackets TokenIndexArray)
		let kind = self.kindAt(index)

		if kind == TokenKind.leftBrace or kind == TokenKind.leftParen 'open'
			braceStack.push(kind == TokenKind.leftBrace)
			openBrackets.push(index)
		end 'open'

		if (kind == TokenKind.rightBrace or kind == TokenKind.rightParen) and braceStack.count() > 0 'close'
			_ = try braceStack.pop() otherwise panic("trackBracketAt: braceStack.pop on non-empty stack failed")
			_ = try openBrackets.pop() otherwise panic("trackBracketAt: openBrackets.pop failed — it is pushed and popped in lockstep with braceStack")
		end 'close'
	end 'trackBracketAt'

	// The BLOCK-DEPTH bookkeeping those same walks keep, for `trackBracketAt`'s reason. Depth 0 is the walk's
	// own starting level, so a `closesBlockAt` there is the walk's terminator and is left for the caller to see.
	function blockDepthAfter(index ElementIndex, depth BlockDepth) returns BlockDepth
		if self.opensBlockAt(index) 'opensBlock'
			return depth + 1
		end 'opensBlock'

		if depth > 0 and self.closesBlockAt(index) 'closesBlock'
			return depth - 1
		end 'closesBlock'

		return depth
	end 'blockDepthAfter'

	// ⭐⭐ **WHICH OF THIS BODY'S LOCAL NAMES HAVE TO LIVE IN A CELL?** — the caller-side half of the
	// decision the sweep makes for parameters, and it has to be made before the body is parsed, because a cell
	// has to dominate every read of the name it holds.
	//
	// ⚠⚠ **ONE WALK PER BODY, NOT ONE PER DECLARATION, AND THAT IS A SCALING RULE RATHER THAN A TIDY-UP.**
	// Asked at each `var` over the rest of its scope this is Θ(vars × tokens) — the exact shape
	// of a `Parse Θ(vars × constructs)` cost, and it bends in CPU while reading FLAT in
	// allocations, so the memory column could not have caught it. The names are collected once, here, and every
	// declaration below is a set membership test.
	//
	// ⚠ **IT IS A TOKEN SCAN AND SO OVER-APPROXIMATES, IN THE ONE DIRECTION THAT IS SAFE.** A name inside a
	// grouping paren reads as an argument; a callee is matched by its BARE name, so every `reassign` in the program answers for every
	// other; and the set is keyed by NAME, so an inner block's shadowing `var` of the same name is promoted
	// with it. Each costs a cell that was not needed — an allocation and a load per read — and none can produce
	// a wrong answer, because a cell is a legal home for any value and only the CALLEE's own ABI decides
	// whether an argument is read as an address.
	//
	// ⚡ **THE GATE IS WHY NO EXISTING PROGRAM PAYS FOR THIS.** `programTakesAParamByRef` is false for every program
	// in which no function marks a parameter `mutable`, so those programs never pay for the prescan.
	function seedCellLocalNames(paramNames NameRoster, extent BodyExtent)
		if not self.signatures.programTakesAParamByRef() 'nothingCouldWantACell'
			return
		end 'nothingCouldWantACell'

		self.bodyState.cellLocalNames = self.cellLocalNamesIn(self.pos, paramNames: paramNames, extent: extent)
	end 'seedCellLocalNames'

	function cellLocalNamesIn(bodyStart ElementIndex, paramNames NameRoster, extent BodyExtent) returns CellLocalNameRoster
		let handedOverByReference = CellLocalNameSet.create()
		let walk = BodyWalk.create()

		let scan = IndirectCallScan.over(self.nonCallNamesFrom(self.bodyState.outerBodyStart), params: paramNames, enclosing: self.bodyState.boundParams)
		var nesting = 0 as NestingDepth
		var q = bodyStart

		while self.kindAt(q) != TokenKind.eof and not self.bodyWalkEndsAt(walk, q: q) and not self.expressionBodyEndsAt(q, extent: extent, nesting: nesting, blockDepth: walk.blockDepth) 'walk'
			if self.handsANameByReferenceAt(q, walk: walk) or (self.bareCallArgumentAt(q, braceStack: walk.braceStack) and self.handsToAFunctionValueByReferenceAt(q, walk: walk, scan: scan)) 'handedToAByRefPosition'
				handedOverByReference.insert(self.tokenAt(q).value)
			end 'handedToAByRefPosition'

			self.stepBodyWalk(walk, q: q)
			nesting = groupNestingAfter(self.kindAt(q), nesting: nesting)
			q = q + 1
		end 'walk'

		self.bodyState.boundParams = CellLocalNameRoster.entries(scan.boundNames)

		return CellLocalNameRoster.entries(handedOverByReference)
	end 'cellLocalNamesIn'

	// Must cover every program fact `cellLocalNamesIn` reads in a shared-corpus file: a hand-off that
	// prescan decides and this walk leaves out serves a library parse to a program needing another.
	function corpusHandOffs() returns CorpusHandOffs
		let handOffs = CorpusHandOffs.create()
		let declaredVars = self.namesDeclaredByVar()
		let valueNames = self.namesSpelledAsValues()
		let walk = BodyWalk.create()
		var q = 0 as ElementIndex

		while self.kindAt(q) != TokenKind.eof 'walk'
			if not walk.insideASubscript() and self.bareCallArgumentAt(q, braceStack: walk.braceStack) and declaredVars.contains(self.tokenAt(q).value) 'aVarIsHandedToACall'
				self.noteHandOffAt(q, walk: walk, valueNames: valueNames, into: handOffs)
			end 'aVarIsHandedToACall'

			self.stepBodyWalk(walk, q: q)
			q = q + 1
		end 'walk'

		return handOffs
	end 'corpusHandOffs'

	function noteHandOffAt(q ElementIndex, walk BodyWalk, valueNames BareNameSet, into CorpusHandOffs)
		let opener = try walk.openBrackets.last() otherwise panic("noteHandOffAt: openBrackets is empty inside a call argument — the caller has just established an open `(`")

		let slot = self.functionValueSlotAt(opener, argument: q)

		if let callee = try self.calleeNameOpeningAt(opener) 'aNamedCallee'
			let held = try into.byCallee.get(callee) otherwise HandOffPositionsByArity.create()
			notedHandOffSlot(held, slot: slot)
			into.byCallee.upsert(callee, value: held)
		end 'aNamedCallee'

		let indirectWhateverTheProgram = match self.callOpeningAt(opener) 'opening'
			notACall gives false
			callResult gives true
			throughReceiver gives false
			bare(name) gives valueNames.contains(name)
		end 'opening'

		if indirectWhateverTheProgram 'aCallThroughAValue'
			notedHandOffSlot(into.indirect, slot: slot)
		end 'aCallThroughAValue'
	end 'noteHandOffAt'

	function namesDeclaredByVar() returns BareNameSet
		if self.fileVarNamesCollected 'collectedAlready'
			return self.fileVarNames
		end 'collectedAlready'

		for q in 0 upto self.tokens.count() 'eachToken'
			if self.kindAt(q) != TokenKind.var 'notAVarKeyword'
				continue
			end 'notAVarKeyword'

			if self.kindAt(q + 1) == TokenKind.leftParen 'aDestructuredPattern'
				for named in q + 2 upto self.parenGroups.closeOf(self.tokens, open: q + 1) 'eachPatternToken'
					if tokenCanBeAName(self.tokenAt(named)) 'aBoundName'
						self.fileVarNames.insert(self.tokenAt(named).value)
					end 'aBoundName'
				end 'eachPatternToken'

				continue
			end 'aDestructuredPattern'

			if tokenCanBeAName(self.tokenAt(q + 1)) 'aBoundName'
				self.fileVarNames.insert(self.tokenAt(q + 1).value)
			end 'aBoundName'
		end 'eachToken'

		self.fileVarNamesCollected = true

		return self.fileVarNames
	end 'namesDeclaredByVar'

	function requireTheHandOffWalkKeysTheCell(nameTok Token)
		if not self.namesDeclaredByVar().contains(nameTok.value) 'aCellTheWalkWouldNotKey'
			panic("Parser.requireTheHandOffWalkKeysTheCell: '{String.from(nameTok.value)}' lives in a cell, but no `var` spells it, so `corpusHandOffs` did not key the by-reference reads that decided it — a binding form that reaches a cell is spelled `var <name>` or is taught to `namesDeclaredByVar`")
		end 'aCellTheWalkWouldNotKey'
	end 'requireTheHandOffWalkKeysTheCell'

	function namesSpelledAsValues() returns BareNameSet
		let names = BareNameSet.create()

		for q in 0 upto self.tokens.count() 'eachToken'
			if self.spellsANameAsAValueAt(q) 'aNameNotCalledNorAMember'
				names.insert(self.tokenAt(q).value)
			end 'aNameNotCalledNorAMember'
		end 'eachToken'

		return names
	end 'namesSpelledAsValues'

	function spellsANameAsAValueAt(index ElementIndex) returns bool
		return tokenCanBeAName(self.tokenAt(index)) and self.kindAt(index + 1) != TokenKind.leftParen and (index == 0 or self.kindAt(index - 1) != TokenKind.dot)
	end 'spellsANameAsAValueAt'

	function stepBodyWalk(walk BodyWalk, q ElementIndex)
		let kind = self.kindAt(q)

		if kind == TokenKind.comma and walk.argumentIndexes.count() > 0 and not walk.insideASubscript() 'nextArgument'
			let last = walk.argumentIndexes.count() - 1
			let current = try walk.argumentIndexes.get(last) otherwise panic("stepBodyWalk: argumentIndexes.get OOB at its own last index")
			try walk.argumentIndexes.set(last, value: current + 1) otherwise panic("stepBodyWalk: argumentIndexes.set OOB at its own last index")
		end 'nextArgument'

		if (kind == TokenKind.leftBracket or kind == TokenKind.rightBracket) and walk.openSubscripts.count() > 0 'aSubscriptBracket'
			let last = walk.openSubscripts.count() - 1
			let depth = try walk.openSubscripts.get(last) otherwise panic("stepBodyWalk: openSubscripts.get OOB at its own last index")

			// Clamped: a body is walked before the parse reports an unbalanced `]`, so it may be malformed.
			let moved = subscriptDepthAfter(kind, depth: depth)
			try walk.openSubscripts.set(last, value: moved) otherwise panic("stepBodyWalk: openSubscripts.set OOB at its own last index")
		end 'aSubscriptBracket'

		self.trackBracketAt(q, braceStack: walk.braceStack, openBrackets: walk.openBrackets)

		while walk.argumentIndexes.count() < walk.openBrackets.count() 'anOpenerPushed'
			walk.argumentIndexes.push(0)
			walk.openSubscripts.push(0)
		end 'anOpenerPushed'

		while walk.argumentIndexes.count() > walk.openBrackets.count() 'anOpenerPopped'
			_ = try walk.argumentIndexes.pop() otherwise panic("stepBodyWalk: argumentIndexes.pop on a column longer than openBrackets")
			_ = try walk.openSubscripts.pop() otherwise panic("stepBodyWalk: openSubscripts.pop — it is pushed and popped with argumentIndexes")
		end 'anOpenerPopped'

		walk.blockDepth = self.blockDepthAfter(q, depth: walk.blockDepth)
	end 'stepBodyWalk'

	function bodyWalkEndsAt(walk BodyWalk, q ElementIndex) returns bool
		return walk.blockDepth == 0 and self.closesBlockAt(q)
	end 'bodyWalkEndsAt'

	function expressionBodyEndsAt(q ElementIndex, extent BodyExtent, nesting NestingDepth, blockDepth BlockDepth) returns bool
		if extent == BodyExtent.block or nesting > 0 or blockDepth > 0 'insideTheBody'
			return false
		end 'insideTheBody'

		let kind = self.kindAt(q)
		return kind == TokenKind.newline or kind == TokenKind.comma or tokenKindClosesAGroup(kind)
	end 'expressionBodyEndsAt'

	function nonCallNamesFrom(start ElementIndex) returns NonCallNameIndex
		if start == self.fileNonCallNames.start 'theFileItself'
			return self.fileNonCallNames
		end 'theFileItself'

		if start != self.bodyNonCallNames.start 'anotherBody'
			self.bodyNonCallNames = NonCallNameIndex.from(start)
		end 'anotherBody'

		return self.bodyNonCallNames
	end 'nonCallNamesFrom'

	function argumentHandOffAt(q ElementIndex, walk BodyWalk) returns ByRefHandOff
		if walk.insideASubscript() or not self.callArgumentStartsAt(q, braceStack: walk.braceStack) 'notInACallsArguments'
			return ByRefHandOff.none
		end 'notInACallsArguments'

		let before = self.kindAt(q - 1)

		if before != TokenKind.colon and self.kindAt(q + 1) == TokenKind.colon 'aLabelNotAValue'
			return ByRefHandOff.none
		end 'aLabelNotAValue'

		if not self.openCallTakesAParamByRef(walk.openBrackets) 'noByReferenceParameterByThatName'
			return ByRefHandOff.none
		end 'noByReferenceParameterByThatName'

		let opener = try walk.openBrackets.get(walk.openBrackets.count() - 1) otherwise panic("argumentHandOffAt: openBrackets is empty inside a call's arguments")
		let label = self.tokenAt(q - 2).value if before == TokenKind.colon else EmptySourceText

		if self.handedValueIsATypeParameter(opener, argIndex: walk.argumentIndex(), label: label) 'aTypeParameterValue'
			return ByRefHandOff.typeParameterValue
		end 'aTypeParameterValue'

		return ByRefHandOff.value
	end 'argumentHandOffAt'

	function handsANameByReferenceAt(q ElementIndex, walk BodyWalk) returns bool
		return self.bareCallArgumentAt(q, braceStack: walk.braceStack) and self.argumentHandOffAt(q, walk: walk) != ByRefHandOff.none
	end 'handsANameByReferenceAt'

	function handedValueIsATypeParameter(opener ElementIndex, argIndex ElementIndex, label ByteArray) returns bool
		let call = try self.forwardCallOpeningAt(opener) otherwise return false

		match call 'call'
			throughSelf(typeName, name) then return self.resolvedCalleeTakesATypeParameterByRef(qualifiedMethodName(typeName, methodName: name), sibling: SiblingMethod.none, name: name, argIndex: argIndex, label: label)
			bare(name) then return self.resolvedCalleeTakesATypeParameterByRef(name, sibling: self.siblingMethodNamed(name), name: name, argIndex: argIndex, label: label)
			throughAReceiver(name) then return self.signatures.bareNameTakesATypeParameterByRef(name)
		end 'call'
	end 'handedValueIsATypeParameter'

	function siblingMethodNamed(name ByteArray) returns SiblingMethod
		return SiblingMethod.named(qualifiedMethodName(try self.enclosingType.typeName() otherwise return SiblingMethod.none, methodName: name))
	end 'siblingMethodNamed'

	function siblingStatesByRefFacts(sibling SiblingMethod) returns bool
		return self.signatures.calleeStatesByRefFacts(try sibling.qualifiedName() otherwise return false)
	end 'siblingStatesByRefFacts'

	function resolvedCalleeTakesATypeParameterByRef(callee ByteArray, sibling SiblingMethod, name ByteArray, argIndex ElementIndex, label ByteArray) returns bool
		let calleeStates = self.signatures.calleeStatesByRefFacts(callee)
		let siblingStates = self.siblingStatesByRefFacts(sibling)

		if not calleeStates and not siblingStates 'resolvedToNothingThatStates'
			return self.signatures.bareNameTakesATypeParameterByRef(name)
		end 'resolvedToNothingThatStates'

		return (calleeStates and self.signatures.calleeTakesATypeParameterByRefAt(callee, argIndex: argIndex, label: label)) or (siblingStates and self.signatures.calleeTakesATypeParameterByRefAt(try sibling.qualifiedName() otherwise panic("resolvedCalleeTakesATypeParameterByRef: a sibling that states by-reference facts is a named one"), argIndex: argIndex, label: label))
	end 'resolvedCalleeTakesATypeParameterByRef'

	function openCallTakesAParamByRef(openBrackets TokenIndexArray) returns bool
		let opener = try openBrackets.get(openBrackets.count() - 1) otherwise panic("openCallTakesAParamByRef: openBrackets is empty inside a call argument — the caller has just established an open `(`")
		let name = try self.calleeNameOpeningAt(opener) otherwise return false
		return self.signatures.bareNameTakesAParamByRef(name)
	end 'openCallTakesAParamByRef'

	function handsToAFunctionValueByReferenceAt(q ElementIndex, walk BodyWalk, scan IndirectCallScan) returns bool
		if walk.insideASubscript() 'insideAnIndex'
			return false
		end 'insideAnIndex'

		let opener = try walk.openBrackets.get(walk.openBrackets.count() - 1) otherwise panic("handsToAFunctionValueByReferenceAt: openBrackets is empty inside a call argument — the caller has just established an open `(`")

		if not self.openingMayBeAnIndirectCall(opener, scan: scan) 'opensADirectCallOrNoCall'
			return false
		end 'opensADirectCallOrNoCall'

		let slot = self.functionValueSlotAt(opener, argument: q)
		return self.signatures.programHasMutableFunctionValues() or self.signatures.aFreeFunctionTakesByRefAt(slot.arity, position: slot.position)
	end 'handsToAFunctionValueByReferenceAt'

	function callOpeningAt(opener ElementIndex) returns CallOpening
		if self.kindAt(opener) != TokenKind.leftParen or opener == 0 or self.callOpeningAtIsSpawned(opener) 'cannotBeACallThroughAValue'
			return CallOpening.notACall
		end 'cannotBeACallThroughAValue'

		let before = self.kindAt(opener - 1)

		if before == TokenKind.rightParen or before == TokenKind.rightBracket 'aCallResultIsCalled'
			return CallOpening.callResult
		end 'aCallResultIsCalled'

		if before != TokenKind.identifier 'notACallee'
			return CallOpening.notACall
		end 'notACallee'

		let name = self.tokenAt(opener - 1).value

		if opener >= 2 and self.kindAt(opener - 2) == TokenKind.dot 'throughAReceiver'
			return CallOpening.throughReceiver(name)
		end 'throughAReceiver'

		return CallOpening.bare(name)
	end 'callOpeningAt'

	function openingMayBeAnIndirectCall(opener ElementIndex, scan IndirectCallScan) returns bool
		return match self.callOpeningAt(opener) 'opening'
			notACall gives false
			callResult gives true
			throughReceiver(name) gives self.signatures.bareNameIsAFunctionValuedFieldName(name)
			bare(name) gives scan.boundNames.contains(name) or self.enclosingTypeHasAFunctionValuedFieldNamed(name) or self.nameOccursAsAValueBefore(name, upTo: opener, scan: scan)
		end 'opening'
	end 'openingMayBeAnIndirectCall'

	function enclosingTypeHasAFunctionValuedFieldNamed(name ByteArray) returns bool
		let typeName = try self.enclosingType.typeName() otherwise return false

		return match self.signatures.structInAnyFile(typeName) 'layout'
			declared(layout) gives self.signatures.fieldTypeMayHoldAFunctionValue(try layout.fieldTypes.get(try layout.fieldNames.positionOfName(name) otherwise return false) otherwise panic("enclosingTypeHasAFunctionValuedFieldNamed: a layout's field columns are built in lockstep"))
			undeclared gives false
		end 'layout'
	end 'enclosingTypeHasAFunctionValuedFieldNamed'

	function nameOccursAsAValueBefore(name ByteArray, upTo ElementIndex, scan IndirectCallScan) returns bool
		while scan.nonCallNames.scannedTo < upTo 'extend'
			let i = scan.nonCallNames.scannedTo

			if self.spellsANameAsAValueAt(i) and not scan.nonCallNames.firstSites.contains(self.tokenAt(i).value) 'aFirstNameNotCalledNorAMember'
				scan.nonCallNames.firstSites.upsert(self.tokenAt(i).value, value: i)
			end 'aFirstNameNotCalledNorAMember'

			scan.nonCallNames.scannedTo = i + 1
		end 'extend'

		return (try scan.nonCallNames.firstSites.get(name) otherwise return false) < upTo
	end 'nameOccursAsAValueBefore'

	function callOpeningAtIsSpawned(opener ElementIndex) returns bool
		if opener >= 2 and self.kindAt(opener - 2) == TokenKind.async 'aBareSpawn'
			return true
		end 'aBareSpawn'

		return opener >= 4 and self.kindAt(opener - 2) == TokenKind.dot and self.kindAt(opener - 4) == TokenKind.async
	end 'callOpeningAtIsSpawned'

	// Is the argument beginning at `index` EXACTLY one name and nothing else? `bareCallArgumentAt` above
	// answers the same shape from inside a walk that already knows where it is; this one is asked at a cursor
	// standing on the argument's first token, so the bracket state is the caller's own and needs no stack.
	function argumentIsExactlyANameAt(index ElementIndex) returns bool
		return tokenCanBeAName(self.tokenAt(index)) and self.argumentEndsAt(index + 1)
	end 'argumentIsExactlyANameAt'

	// Which token of a by-reference argument may hand over storage — the name itself, or the LAST field of
	// `base.f1.…fN`. Answered from TOKENS before the value is parsed, because a read that has already
	// materialized the contents cannot be un-emitted.
	//
	// ⚠ The hop is `namesMemberAt`, the same predicate `fieldChainEndAfter` walks with. This walk predicts
	// where the parse will stop, and a shape one of them admits and the other does not leaves the anchor on a
	// token no read door stands on: the request is then silently never taken and the write is lost.
	function cellArgumentAnchorAt(index ElementIndex) returns CellArgumentToken
		if self.argumentIsExactlyANameAt(index) 'aBareName'
			return CellArgumentToken.at(index)
		end 'aBareName'

		if not tokenCanBeAName(self.tokenAt(index)) 'notAChainBase'
			return CellArgumentToken.none
		end 'notAChainBase'

		var segments = 0 as ElementIndex

		while self.kindAt(index + segments * TokensPerQualifierSegment + 1) == TokenKind.dot and self.namesMemberAt(index + segments * TokensPerQualifierSegment + 2) 'walk'
			segments = segments + 1
		end 'walk'

		let fieldIndex = index + segments * TokensPerQualifierSegment

		if segments > 0 and self.argumentEndsAt(fieldIndex + 1) 'aFieldOfAChainedBase'
			return CellArgumentToken.at(fieldIndex)
		end 'aFieldOfAChainedBase'

		return CellArgumentToken.none
	end 'cellArgumentAnchorAt'

	function selfFieldChainHandsOverACell() returns bool
		return self.statement.cellArgumentToken.liesBeyond(self.pos + TokensPerQualifierSegment)
	end 'selfFieldChainHandsOverACell'

	function argumentEndsAt(index ElementIndex) returns bool
		let after = self.kindAt(index)
		return after == TokenKind.comma or after == TokenKind.rightParen
	end 'argumentEndsAt'

	// ⭐ **IS THE TOKEN AT `index` A BARE NAME STANDING ALONE AS A CALL ARGUMENT?** — the by-reference forwarding probe
	// (`scanBodyFacts`), and the token-level twin of what `bareNameOfSpan` asks of the real parse: an
	// argument names a binding only if it IS that name and nothing else.
	//
	// The bracket condition, asked in `callArgumentStartsAt`, is what tells an ARGUMENT from a grouping paren's
	// contents or a struct literal's field value: the innermost open bracket must be a `(`. A struct literal is
	// `{…}` and is excluded by it, which is right — a field store is a CONSUME (the column above), never a forward.
	//
	// ⚠ **A PARAMETER'S NAME MAY BE A KEYWORD**, so this asks `tokenCanBeAName` rather than
	// `== identifier`, for the reason `consumedParamAfterColon` states with its measurement. Claiming nothing
	// extra: the name is looked up in the parameter list by the caller, and a keyword naming no parameter is
	// dropped exactly as an unrelated identifier is.
	//
	// ⚠ It over-detects a GROUPING paren whose whole contents are one name — `(x)` reads as an argument. The
	// edge it records then carries whatever name preceded the paren, which no function wears, so
	// `noteForwardCall` drops it and only the parameter's own `forwarded` bit is set. Harmless: a forwarded
	// bit with no live edge never widens anything.
	function bareCallArgumentAt(index ElementIndex, braceStack BoolArray) returns bool
		if not self.callArgumentStartsAt(index, braceStack: braceStack) 'notAnArgumentPosition'
			return false
		end 'notAnArgumentPosition'

		let after = self.kindAt(index + 1)

		if after != TokenKind.comma and after != TokenKind.rightParen 'notTheWholeArgument'
			return false
		end 'notTheWholeArgument'

		return tokenCanBeAName(self.tokenAt(index))
	end 'bareCallArgumentAt'

	function callArgumentStartsAt(index ElementIndex, braceStack BoolArray) returns bool
		if braceStack.count() == 0 or self.braceStackInnermostIsBrace(braceStack) 'notInsideACallsParens'
			return false
		end 'notInsideACallsParens'

		let before = self.kindAt(index - 1)
		return before == TokenKind.leftParen or before == TokenKind.comma or before == TokenKind.colon
	end 'callArgumentStartsAt'

	// The callee name of the bracket at `index`, or `AbsentError` when it opens no call — the forwarding
	// EDGE. It is the token immediately before, which for `reassign(…)`, `f.reassign(…)`
	// and `Type.create(…)` alike is the BARE name.
	//
	// A `{` opens a STRUCT LITERAL and never a call, so it is absent however nameable the token before
	// it is — `Self{tag: t}` must not read as a call to `Self`.
	function calleeNameOpeningAt(index ElementIndex) returns immutable ByteArray throws AbsentError
		if self.kindAt(index) != TokenKind.leftParen 'opensNoCall'
			throw AbsentError.absent
		end 'opensNoCall'

		if index == 0 or not tokenCanBeAName(self.tokenAt(index - 1)) 'aGroupingParen'
			throw AbsentError.absent
		end 'aGroupingParen'

		return self.tokenAt(index - 1).value
	end 'calleeNameOpeningAt'

	// ⭐⭐ **THE FORWARDING EDGE THE BRACKET AT `index` STATES, SHAPE AND ALL.** The name is
	// `calleeNameOpeningAt`'s — it is the same name, and asking it twice is how the two would come apart — and
	// the SHAPE is read off the one or two tokens before it, which is a hard partition of what the call can
	// name (see `ForwardCall`). An absent name means the bracket opened no call at all, which
	// `noteForwardCall` drops; the shape of a non-call is never read.
	//
	// ⭐ **`self.f(` AND `Self.f(` ARE THE NARROWEST SHAPE, AND BOTH KEYWORDS MEAN THE ENCLOSING TYPE** — the
	// instance receiver and the static one name the same declaration space, so `Self.create(…)` is as
	// precisely attributable as `self.swap(…)`. It must be `<self> . <name> (` EXACTLY: a longer chain
	// (`self.managed.swap(`) has a receiver that is a FIELD, whose type this walk cannot know, so it falls
	// through to the wide receiver shape — which is why `Array.swap`'s own `managed.swap(i, j: j)` still
	// widens.
	function forwardCallOpeningAt(index ElementIndex) returns ForwardCall throws AbsentError
		let name = try self.calleeNameOpeningAt(index)

		if index < 2 or self.kindAt(index - 2) != TokenKind.dot 'noReceiverWasWritten'
			return ForwardCall.bare(name)
		end 'noReceiverWasWritten'

		if index >= 3 and receiverKeywordNamesTheEnclosingType(self.kindAt(index - 3)) and self.enclosingType.isType() 'theEnclosingTypesOwnMethod'
			return ForwardCall.throughSelf(self.enclosingTypeName(), name: name)
		end 'theEnclosingTypesOwnMethod'

		return ForwardCall.throughAReceiver(name)
	end 'forwardCallOpeningAt'

	// ⭐⭐ **E3067's SELF-ASSIGNMENT HALF — REFUSED PURELY TEXTUALLY, BEFORE ANY NAME IS RESOLVED.**
	//
	// THE RULE, STATED SO THAT ITS FALSE-REJECT SURFACE IS OBVIOUS. The statement beginning at `index` is
	// refused when it is `<chain> = <chain> <statement end>` and the two chains are THE SAME TOKENS — equal
	// kind AND equal spelling, position by position. A chain is `fieldChainEndAfter`'s: a base (an
	// identifier, or a keyword the same walk admits as a name — `self` among them) followed by zero or more
	// `.member` hops. So `x = x`, `p.x = p.x`, `self.n = self.n`, `a.b.c = a.b.c` and `_ = _` are refused.
	//
	// ⚠ **E3067's OTHER HALF — a discard whose right-hand side called nothing — IS NOT HERE.** It is
	// `parseAssignment`'s discard arm, which asks what op the statement EMITTED rather than what tokens it
	// wrote, so it sees `_ = round(1.5)` and `_ = c.name`, which no token test can tell from a call. One
	// code, two messages, two doors: this half needs no ops and must run before the dispatch, that half
	// needs the ops and so cannot.
	//
	// ⚠ **TEXTUAL IS THE WHOLE OF IT** — the registry's own doc for E3067 says "a *textual* self-assignment",
	// and nothing here asks what a name MEANS. Everything below is therefore LEGAL and measured to stay so:
	//
	//   • `x = y` and `x = x + 1` — `self-assignment.md`'s own false-reject controls.
	//   • `x = (x)` — parenthesized: different tokens, so not refused. The rule is TEXTUAL — the
	//     one the registry describes, and the one that cannot be wrong about what a program MEANS: it
	//     can only ever miss, never mis-refuse.
	//
	// ⚠⚠ **AND IT IS STRICTER THAN THE ORACLE IN TWO DIRECTIONS, WHICH IS THE HALF THAT CAN BREAK A
	// PROGRAM THE ORACLE COMPILES.** A looser rule only lets a bad program through; a stricter one refuses
	// a good one, so these are the divergences worth writing down:
	//
	//   • `self.n = self.n` and `a.b.c = a.b.c` — both refused: a receiver hop and a chain of more
	//     than one hop are the same mistake as `x = x`, and the chain walk costs nothing to ask
	//     uniformly. Carving `self` back out would be more code for a worse rule.
	//   • **PRECEDENCE, not scope**: this runs before name resolution and before the mutability check, so
	//     `let x = 1` / `x = x` is E3067 here rather than an immutable-assignment complaint, and an
	//     undeclared `x = x` is E3067 rather than undefined-variable. The refusal is
	//     correct in every case; only which of two true complaints is reported first differs. Nothing pins
	//     either, and moving the check later would cost it the one property that makes it cheap — it reads
	//     TOKENS, at a point where no op has been emitted and nothing has to be unwound.
	//   • `arr[i] = arr[i]`, `m.get(k) = …` — an index or a call is not a chain hop, so the walk stops at
	//     the `[` / `(`, the LHS never reaches an `=`, and this rule never looks at the statement at all.
	//   • every `_ = <rhs>` but `_ = _` — the discard arm owns that shape, and reaching a verdict on it
	//     here would be the same rule written down twice.
	//
	// ⚠ **THE STATEMENT-END TEST IS LOAD-BEARING, NOT DEFENSIVE.** Drop it and `x = x + 1` — the spec's own
	// control — fires: its RHS chain IS `x` and matches the LHS token for token. What makes it a different
	// program is only the `+ 1` that follows, so "the chain is the WHOLE right-hand side" is the rule.
	//
	// Asked once, from `readStatementOpening`, before the dispatch — rather than from each of the
	// three assignment arms — because the shape it refuses spans all of them (`assignsAt`,
	// `fieldAssignsAt` and `selfFieldAssignsAt` each own one spelling of it) and a fourth write form
	// would otherwise have to remember to ask. A statement that opens with something the chain walk
	// refuses costs one predicate.
	//
	// ⛔ TUPLE ASSIGNMENT does NOT reach this rule. `fieldChainEndAfter` walks a chain from a NAME, so
	// it stops dead at the `(` and this rule never looks at the statement: `(x, y) = (x, y)` compiles
	// where `x = x` is E3067. Left as it is rather than widened, because the premise above does not
	// cover it — a target LIST is not a chain, so serving it needs a SECOND rule here (compare N
	// targets against N right-hand elements), not the reuse the header promises. It is a missing
	// diagnostic on a statement nobody writes.
	function rejectDegenerateAssignment(index ElementIndex) throws SourceParseError
		let lhsEnd = self.fieldChainEndAfter(index, minHops: AnyFieldHops)

		if lhsEnd == index or self.kindAt(lhsEnd) != TokenKind.equals 'notAnAssignmentStatement'
			return
		end 'notAnAssignmentStatement'

		let anchor = self.tokenAt(index)
		let rhsStart = lhsEnd + 1

		// The RHS must be the SAME LENGTH as the LHS and nothing more, which is one question rather than
		// two: read the same span of tokens after the `=`, and require the statement to stop right there.
		let chainLength = lhsEnd - index

		if not self.statementEndsAt(rhsStart + chainLength) 'rhsIsNotJustTheChain'
			return
		end 'rhsIsNotJustTheChain'

		if not self.tokenSpansAreIdentical(index, other: rhsStart, length: chainLength) 'notTheSameChain'
			return
		end 'notTheSameChain'

		throw SourceParseError.selfAssignmentHasNoEffect(self.renderChain(index, length: chainLength), line: anchor.line, column: anchor.column)
	end 'rejectDegenerateAssignment'

	// ⭐ **THE COMPARE ALLOCATES NOTHING, AND THAT IS THE POINT — IT RUNS ON EVERY ASSIGNMENT IN THE
	// PROGRAM.** `x = y`, `p.x = q.y` and `self.a = self.b` all reach it and all differ; only the refused
	// program ever reaches `renderChain`. Fused with the rendering — which is how it was first written —
	// every one of them paid an empty `String` plus one interpolation and one `String.from` PER MATCHED
	// TOKEN before finding the difference, and `self.a = self.b` paid two of each on every compile.
	//
	// ⚠ **A RENDERED `String` DOWN A PER-TOKEN PATH IS EXPENSIVE**: `NamePosition` exists because handing one
	// down such a path measured **+5,495 allocations at the first scale-test ladder step, doubling per step**.
	// A diagnostic's text is owed only by the program that gets the diagnostic.
	function tokenSpansAreIdentical(index ElementIndex, other ElementIndex, length ElementIndex) returns bool
		var offset = 0 as ElementIndex

		while offset < length 'eachToken'
			let left = self.tokenAt(index + offset)
			let right = self.tokenAt(other + offset)

			if left.kind != right.kind or not left.value.equals(right.value) 'differs'
				return false
			end 'differs'

			offset = offset + 1
		end 'eachToken'

		return true
	end 'tokenSpansAreIdentical'

	// A field chain spelled back as the author wrote it, for a diagnostic that must quote it. A chain
	// token is either a name — whose `value` carries the spelling — or the `.`, which is punctuation and
	// whose `value` is EMPTY by `Token.value`'s rule, so its spelling is its kind. That emptiness test is
	// the same one `tokenCanBeAName` tells the two apart by, rather than a second rule about dots.
	function renderChain(index ElementIndex, length ElementIndex) returns String
		var rendered = ""
		var offset = 0 as ElementIndex

		while offset < length 'eachToken'
			let tok = self.tokenAt(index + offset)
			rendered = "{rendered}{tok.kind.rawValue}" if tok.value.isEmpty() else "{rendered}{String.from(tok.value)}"
			offset = offset + 1
		end 'eachToken'

		return rendered
	end 'renderChain'

	// **The token shape of a FIELD STORE** — `<base> . <field> =`, asked at an ABSOLUTE index.
	//
	// Deliberately NOT folded into `assignsAt`: see there. The two are disjoint by construction (the
	// token after the base is `=` for one and `.` for the other), so `parseStatement` may ask them
	// in either order and get the same answer.
	//
	// `p.x == y` cannot be mistaken for a store: `==` lexes as a single `equalsEquals` token. Nor
	// can `Point.create(…)`, whose token at +3 is `(`.
	//
	// ⭐ **A CHAIN `o.inner.x =` matches too**: the base identifier is followed by ONE OR
	// MORE `.identifier` hops and then a single `=`. `resolveFieldChain` reads exactly this shape, so the
	// dispatch predicate and the parser agree on where a chained store begins and ends. A `.method()` chain
	// ends in `(` (not `=`) and a comparison in `==`, so neither is mistaken for a store.
	//
	// ⚠ **THE WALK IS `fieldChainEndAfter`'S, NOT A SECOND ONE.** Re-implementing the hop loop inline would
	// be a second copy of a walk whose OWN header makes it the one answer to where a chain ends, so a store
	// dispatcher asks the walk — and it is asked EXACTLY as `fieldChainMethodCallAt` asks it, `chainEnd == index` first
	// and the trailing token second. That guard is load-bearing rather than defensive: the walk answers `index`
	// unchanged BOTH for a base it refuses and for a zero-hop chain, so without it a statement standing on a
	// bare `=` — a base `tokenCanBeAName` refuses, leaving `kindAt(index)` the `=` itself — would read as a
	// field store instead of reaching the dispatcher's `unsupported` arm.
	function fieldAssignsAt(index ElementIndex) returns bool
		let chainEnd = self.fieldChainEndAfter(index, minHops: FieldStoreMinHops)
		return chainEnd != index and self.kindAt(chainEnd) == TokenKind.equals
	end 'fieldAssignsAt'

	// **The token shape of a STATIC MEMBER STORE** — `<Type> . <member> =`, where the base names a
	// declared type rather than a value and the qualified name is a binding the program declared. The
	// shadowing rule and the resolution are `staticMemberBaseAt`'s, stated there once for this door and its
	// call-shaped twin; what is decided HERE is only the token that must follow the pair.
	//
	// The `=` is what separates a store from a read: `Counter.count + 1` has no trailing `=` and belongs to
	// the expression arm, and `Counter.count == 1` lexes its operator as one `equalsEquals` token. It is
	// asked FIRST, ahead of the resolution: it is a token-kind compare that allocates nothing, and
	// everything inside `staticMemberBaseAt` joins a name and boxes two lookups.
	function staticMemberAssignsAt(index ElementIndex) returns bool
		return self.kindAt(index + TokensPerQualifierSegment + 1) == TokenKind.equals and self.staticMemberBaseAt(index)
	end 'staticMemberAssignsAt'

	// **The token shape of a METHOD CALL ON A STATIC MEMBER** —
	// `<Type>.<member>(.<field>)*.<method>(`, the STATEMENT half of the form `parseDottedPrimary`'s
	// static arm already serves in expression position. The trailing member call is what makes it a
	// statement at all: a bare `Names.items` on a line of its own computes nothing and stays the
	// `Unsupported: identifier statement`.
	//
	// The chain is `fieldChainEndAfter`'s walk from the member token, the one answer every other chain
	// door asks about where a chain ends, so this door cannot disagree with the rest of the file about
	// what a member call looks like — and it is asked first for `staticMemberAssignsAt`'s cost reason.
	function staticMemberCallsAt(index ElementIndex) returns bool
		let memberIndex = index + TokensPerQualifierSegment
		let chainEnd = self.fieldChainEndAfter(memberIndex, minHops: StaticMemberCallMinHops)

		return chainEnd != memberIndex and self.kindAt(chainEnd) == TokenKind.leftParen and self.staticMemberBaseAt(index)
	end 'staticMemberCallsAt'

	// ⭐ **DOES A ONE-HOP DOTTED FORM AT `index` ROOT AT A STATIC MEMBER — the half the two STATEMENT
	// dispatchers share?** They differ only in the token that must FOLLOW the pair, and everything
	// before that is one question: `typeBaseAdmittedAt`'s base rules, the type-naming base and the qualified
	// resolution. Written once so the store door and the call door cannot come to disagree about which
	// spellings are static members — a disagreement that would be silent, each falling through to a
	// different arm's refusal of the same program.
	function staticMemberBaseAt(index ElementIndex) returns bool
		if not self.typeBaseAdmittedAt(index) 'notATypeBase'
			return false
		end 'notATypeBase'

		let baseTok = try self.typeBaseTokenAt(index) otherwise return false
		return self.namesStaticMemberAt(baseTok, memberIndex: index + TokensPerQualifierSegment)
	end 'staticMemberBaseAt'

	// ⭐⭐ **THE BASE RULES EVERY STATEMENT-POSITION `<Type>.<member>` READER SHARES** — a `.` must follow the
	// base, and a base bound to a VALUE declines. Written once because `staticMemberBaseAt` and
	// `staticRosterVerdictAt` route the SAME statement on it: a rule added to one copy alone would split the
	// arm that takes a LEGAL static store from the arm that REFUSES a hidden one, and each would then refuse
	// the same program at the other's door with no compile error anywhere.
	//
	// ⭐ **A VALUE IN SCOPE OUTRANKS THE TYPE READING, and that test is why this is not merely a shape test.**
	// A local called `Counter` shadows `Counter.` exactly as a local `OFFSET` shadows a top-level constant of
	// that name — the rule `valueBaseAt` carries — so `Counter.count = 1` with such a local in
	// scope is a FIELD store on that local and must fall through to `fieldAssignsAt`. `Self` is excluded from
	// the shadowing test by that same function, which is what makes `Self.count = 1` inside a static method
	// reach the static-member doors at all.
	function typeBaseAdmittedAt(index ElementIndex) returns bool
		if self.kindAt(index + 1) != TokenKind.dot 'notADottedForm'
			return false
		end 'notADottedForm'

		return not self.baseNamesAValueAt(index)
	end 'typeBaseAdmittedAt'

	// `<Type>.<member>` at `index` as the static roster answers it — the STATEMENT door's face of
	// `staticRosterVerdictFor`, over the base `staticMemberBaseAt` reads and with `Self` already resolved to
	// the type it denotes.
	function staticRosterVerdictAt(index ElementIndex) returns StaticRosterVerdict
		if not self.typeBaseAdmittedAt(index) 'notATypeBase'
			return StaticRosterVerdict.notADeclaredTypeMember
		end 'notATypeBase'

		let baseTok = try self.typeBaseTokenAt(index) otherwise return StaticRosterVerdict.notADeclaredTypeMember
		return self.staticRosterVerdictFor(baseTok, memberIndex: index + TokensPerQualifierSegment)
	end 'staticRosterVerdictAt'

	// ⭐ **THE TOKEN SHAPE OF A STORE TO A STATIC MEMBER THIS FILE MAY NOT SEE** — `Counter.hits = 9` where
	// `hits` is declared and hidden — or to a method or requirement (`Ops.twice = f`, E2013). The refusing
	// twin of `staticMemberAssignsAt`, and its own predicate
	// rather than a widening of that one, whose base half the CALL door shares (`staticMemberCallsAt`): what
	// is refused here is the STORE.
	//
	// ⚠ **WITHOUT IT THE WRITE HALF OF THE VISIBILITY RULE IS UNENFORCED.** The store falls past
	// `staticMemberAssignsAt` for exactly the reason the read falls past `namesStaticMemberAt` — a hidden
	// declaration is invisible to a reader's probe — and then past `fieldAssignsAt`, whose chain walk refuses
	// a base that binds no value, leaving the author told `Undefined variable 'Counter'` about a type that is
	// perfectly visible.
	//
	// ⛔ **IT DELIBERATELY DOES NOT CLAIM `undeclaredMember`, WHICH THE READ DOOR DOES.** The two positions
	// fall through to different places: a read is refused as a missing member, while a store's last resort
	// is the field arm — and `Gate.n = 5`
	// against an INSTANCE FIELD is exactly that, an assignment through a base binding no value.
	// `self-type-member-expression`'s two `error.store-through-…` cases pin that sentence, and it is the
	// right one: the member is not missing, it needs a receiver.
	//
	// The `=` is asked FIRST for `staticMemberAssignsAt`'s cost reason: it is a token-kind compare, and
	// everything inside the verdict joins a name.
	function staticStoreRefusedAt(index ElementIndex) returns bool
		if self.kindAt(index + TokensPerQualifierSegment + 1) != TokenKind.equals 'notAStoreShape'
			return false
		end 'notAStoreShape'

		return match self.staticRosterVerdictAt(index) 'roster'
			notADeclaredTypeMember or
			undeclaredMember gives false
			hidden or
			declaredMethod or
			declaredInstanceMethod or
			hiddenMethod or
			refused or
			requirement gives true
		end 'roster'
	end 'staticStoreRefusedAt'

	// The store arm's refusal, worded by the one producer the read arm uses. It reads the base ONCE and asks
	// `staticRosterVerdictFor` rather than `staticRosterVerdictAt`: `staticStoreRefusedAt` admitted the base
	// rules one predicate ago off this same cursor, so re-asking them would be a second answer to a question
	// already settled.
	function refuseStaticMemberStore() throws SourceParseError
		let baseTok = try self.typeBaseTokenAt(self.pos) otherwise panic("refuseStaticMemberStore: no type base at this statement — `staticStoreRefusedAt` read one here one predicate ago, off the same cursor")
		let memberIndex = self.pos + TokensPerQualifierSegment
		throw self.staticRosterRefusal(self.staticRosterVerdictFor(baseTok, memberIndex: memberIndex), baseTok: baseTok, memberTok: self.tokenAt(memberIndex), written: self.writtenSpellingOfMemberAt(memberIndex), use: StaticMemberUse.store)
	end 'refuseStaticMemberStore'

	// **The token shape of an EXPLICIT self-field store** — `self . <field> =`.
	//
	// Its own predicate rather than a widening of `fieldAssignsAt`, because `self` is a KEYWORD and
	// not an identifier — and, more to the point, for `fieldAssignsAt`'s own reason: it assigns no
	// BINDING, so `assignedBindingsIn` must not see it. (The BARE spelling `count = 5` DOES match
	// `assignsAt` and is deliberately left to; see there.)
	function selfFieldAssignsAt(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.self and self.kindAt(index + 1) == TokenKind.dot and self.kindAt(index + 2) == TokenKind.identifier and self.kindAt(index + 3) == TokenKind.equals
	end 'selfFieldAssignsAt'

	// **The token shape of an INSTANCE METHOD CALL** — `<base> . <name> (`, where `<base>` names a
	// value IN SCOPE (a binding, or the `self` keyword's receiver).
	//
	// ⭐ **THE SCOPE TEST IS THE WHOLE PREDICATE**, because the token shape alone cannot tell
	// `c.increment()` from `Point.create()` — they are identical. What separates them is that one
	// base is a VALUE and the other is a TYPE NAME, and only the scope knows which.
	//
	// Asked at an ABSOLUTE index by `parseStatement` and at the cursor by
	// `parseDottedPrimary`/`parseSelfPrimary`, so the statement and expression positions cannot come
	// to disagree about what a method call looks like — which they would, since a method call is
	// legal in both and only one of them may discard the result.
	//
	// ⚠ A STATIC call in statement position is `qualifiedStaticCallsAt`'s, not this predicate's: the two
	// shapes differ only in what the base NAMES, so declining one here is what lets the other claim it.
	// ⭐⭐ **`<arrayBinding> . managed` — THE FIELD DOOR, AND WHY IT NEEDS A PREDICATE OF ITS OWN.**
	//
	// `.managed` is a FIELD: the corpus writes no parentheses (`arr.managed.setLength(2)`,
	// `f(bytes.managed)`), so `methodCallsAt` — which requires a `(` at +3 — is false for it, and the
	// statement/expression dispatchers fall through to the field-access path instead. There the base is an
	// `Array`, whose 48-byte record the compiler SYNTHESIZES rather than compiling `stdlib/Array.maxon`, so
	// `structLayoutOfType` finds no field table at all and `missingBaseLayout` reports E2015.
	//
	// ⭐ **THAT IS PURE PARSER ROUTING AND HAS NOTHING TO DO WITH THE ELEMENT TYPE, WHICH WAS MEASURED**:
	// `arr.managed.setLength(1)` failed identically on an `Array with Byte` — the instance `__ManagedMemory` was
	// already bound to — so every filed note in the corpus blaming the element binding was wrong about the cause.
	// What the access needs is to reach `dispatchArrayMethod`, which serves `.managed` as a member
	// (a VALUE receiver, `"…".toByteArray().managed`, works).
	//
	// ⇒ So this predicate routes the BINDING spelling to `parseMethodCall`, the very door `methodCallsAt` routes
	// to, and the dispatcher's own `.managed` arm does the rest. Where the two are asked together they are asked
	// BESIDE each other, never instead: they are disjoint by the `(` immediately after `managed`, which
	// `methodCallsAt` requires and no `.managed` read has.
	//
	// ⭐ **TWO SPELLINGS, ONE RULE PLUS ONE CONJUNCT.** `arr.managed` is claimed in VALUE
	// position too, so the member call is not part of *this* question — it is asked by
	// `arrayManagedMemberCallAt` below, which is literally this predicate `and` the `.<member>(` at +3, and
	// which the two positions that need a CALL read instead. The EXPRESSION door reads this one.
	//
	// ⚠ **IT IS NARROW ON PURPOSE, IN TWO WAYS.** The member must be `managed` — `arr.someOtherField` keeps
	// `missingBaseLayout`'s carefully-worded refusal, which is still the true answer for every other field of a
	// synthesized record. And the base must be a binding in THIS function's scope, because that is what makes
	// `parseMethodCall`'s `thisFrame` arm certain to fire; a captured or top-level array's `.managed`
	// stays refused rather than reaching that function's impossible-state panic.
	function arrayManagedFieldAt(index ElementIndex) returns bool
		if not tokenCanBeAName(self.tokenAt(index)) 'notABase'
			return false
		end 'notABase'

		if self.kindAt(index + 1) != TokenKind.dot or not self.tokenAt(index + 2).value.equals(ManagedMemoryFieldName) 'notTheManagedField'
			return false
		end 'notTheManagedField'

		// ⭐ **THE BARE VALUE FORM IS CLAIMED TOO:** `stdlib/File.maxon:147` is
		// `try writer.writeAll(content.managed)` — the buffer of a BORROWED `ByteArray` parameter, in
		// ARGUMENT position, with no member call after it. Requiring a `.<member>(` at +3 leaves that
		// spelling to the field machinery, where an `Array`'s synthesized record has no field table and
		// `missingBaseLayout` reports E2015. The member-call conjunct lives in `arrayManagedMemberCallAt`
		// below, which the two positions that genuinely need a CALL ask instead.
		// ⚠ **IT IS NOT AN IDENTITY, AND THAT IS WHAT MAKES THE BARE FORM SAFE** — see
		// `dispatchArrayMethod`'s `bufferAsAValue` arm, where the receiver's own `ValueId` handed back to a
		// `let` would make the binding and the array two owners of one record.
		match self.valueBaseAt(index) 'base'
			thisFrame then return self.typeIsArrayInstance(self.thisFrameBindingOf(self.tokenAt(index)).varType)
			captured or
			unbound or
			alwaysAType then return false
		end 'base'
	end 'arrayManagedFieldAt'

	// ⭐⭐ **`<enumBinding> . ordinal` — THE ENUM ACCESSOR DOOR, and it needs a predicate of its own for
	// `arrayManagedFieldAt`'s reason exactly.**
	//
	// `.ordinal` is a FIELD read: no parentheses, so `methodCallsAt` (which requires a `(` at +3) declines
	// it and the expression dispatcher falls through to the field path — where an enum-typed binding is
	// refused, because `requireStructBase` finds no struct layout for a declared enum. It is pure routing;
	// nothing about the access is ill-formed.
	//
	// ⭐ **THE ENUM IS READ OFF THE BINDING'S DECLARED `varType`.** During parsing that holds `named(X)` for
	// every binding kind — a `let`, a parameter, a cell `var`, a capture and a self-field alias alike;
	// `TypeResolution` erases an enum to `integer` only later, over the finished module. A self-field
	// alias's `boundValue` is the RECEIVER, so its tag would answer about the enclosing struct.
	//
	// ⚠ **IT IS NARROW ON PURPOSE, exactly as the `.managed` predicate is.** The member must classify as one
	// of the THREE the language defines on an enum VALUE (`enumInstanceAccessorOf`) — or, on a STRUCT-BACKED
	// enum alone, as a FIELD of its backing struct (see `enumBackingFieldMember`). Every other member of an
	// enum keeps `requireStructBase`'s refusal.
	//
	// It takes a `VarInfo` rather than an `EnumAccessorBase` because that union is a heap object and this
	// is asked of every value-based `<name>.<name>`; the base is built only once an accessor is emitted.
	//
	// It asks the CLASSIFIER through the DERIVED predicate `namesAnEnumInstanceAccessor` — which of the
	// three it got is the whole of what this door does not need to know; `parseEnumAccessor` asks the same
	// classifier and answers for each. One rule, two questions of it, both exhaustive — see
	// `EnumInstanceAccessor` for why it may not be a predicate beside an `if` chain.
	//
	// ⚠⚠ **THE MEMBER TEST SITS *BELOW* THE SCOPE TEST, AND THAT IS A COST TRADE MADE ON PURPOSE.** The
	// backing-field member set is a property of the LAYOUT, so it cannot be classified before the layout is
	// in hand — which means every `<name> . <name>` in the program pays a scope probe in
	// `parseDottedPrimary` rather than rejecting a name like `push` on the spot.
	function enumMemberReadableOff(binding VarInfo, atBase ElementIndex) returns bool
		return self.enumMemberReadableOfType(maxonTypeTag(binding.varType), nameId: typeNameIdOf(binding.varType), dotIndex: atBase + 1)
	end 'enumMemberReadableOff'

	function parseCapturedDottedPrimary(func IrFunction, enclosing Scope, frame ElementIndex) returns ValueId throws SourceParseError
		if self.enumMemberReadableOff(enclosing.getInfo(self.baseBindingName(self.current())), atBase: self.pos) 'enumAccessor'
			return try self.parseEnumAccessor(EnumAccessorBase.captured(enclosing, frame: frame))
		end 'enumAccessor'

		return try self.parseFieldAccess(func)
	end 'parseCapturedDottedPrimary'

	// The tag test FIRST, for `valueIsUnion`'s stated reason: `declaredEnumOfType` returns a `DeclaredEnum`,
	// a union VALUE that heap-allocates even for its `undeclared` case, and this predicate is asked of
	// every value-based `<name>.<name>` and every `self.<name>` in an enum. A value can only belong to an
	// enum if its tag is `named`, and that test is a scalar column read that allocates nothing.
	function enumMemberReadableOfType(tag ValueTypeTag, nameId TypeNameId, dotIndex ElementIndex) returns bool
		if tag != ValueTypeTag.named 'notAnEnumValue'
			return false
		end 'notAnEnumValue'

		let declaredEnum = self.declaredEnumOfType(tag, nameId: nameId)

		if not enumMatchIsDeclared(declaredEnum) 'notADeclaredEnum'
			return false
		end 'notADeclaredEnum'

		return self.enumMemberIsReadable(requireEnumLayout(declaredEnum), memberTok: self.enumMemberTokenAt(dotIndex))
	end 'enumMemberReadableOfType'

	// ⭐⭐ **DOES `member` NAME SOMETHING READABLE OFF A VALUE OF THIS ENUM?** — the door's admission rule and
	// the accessor's dispatch, asked of ONE function so they cannot come to disagree (which is what
	// `emitEnumInstanceAccessor`'s `notAnAccessor` panic asserts).
	//
	// Two ways to say yes: one of the three members the language defines on every enum VALUE, or — on a
	// STRUCT-BACKED enum only — a field of the backing struct, which such an enum exposes directly.
	//
	// ⚠ **THE THREE ACCESSORS WIN, SO A BACKING FIELD NAMED `name`, `ordinal` OR `rawValue` IS SHADOWED.**
	// `p.name` is the CASE's name even when the backing struct declares a `name` field, and the shorthand's
	// own rule (`p.width` IS `p.rawValue.width`) therefore does not hold for exactly those three spellings —
	// `p.rawValue.name` still reads the field. Both references order it this way. The field is reachable
	// under its long spelling, so nothing is unreachable; it is a precedence worth knowing rather than a gap.
	function enumMemberIsReadable(layout EnumLayout, memberTok Token) returns bool
		if namesAnEnumInstanceAccessor(enumInstanceAccessorOf(memberTok.value)) 'oneOfTheThree'
			return true
		end 'oneOfTheThree'

		return self.enumBackingFieldMember(layout, memberTok: memberTok)
	end 'enumMemberIsReadable'

	// ⭐⭐ **`p.width` IS `p.rawValue.width` — A STRUCT-BACKED ENUM EXPOSES ITS BACKING'S FIELDS
	// DIRECTLY.** `specs/enum-struct-backing.md` states the rule and pins it.
	//
	// ⭐ **THE LOOKUP IS THE RULE AND THE BACKING TEST IS A COST GUARD** — `valueIsUnion`'s arrangement, for
	// its reason. The rule has to be the lookup: an enum naming a struct no file declares must not silently
	// admit every member name. But `structOf` boxes a `DeclaredStruct` even to answer `undeclared`, and this
	// is asked of every non-accessor member on every enum binding in the program — where the overwhelming
	// majority are not struct-backed at all and would probe `EmptySourceText` only to be told so.
	function enumBackingFieldMember(layout EnumLayout, memberTok Token) returns bool
		if layout.backing != EnumBacking.structRecord 'notStructBacked'
			return false
		end 'notStructBacked'

		match self.signatures.structInAnyFile(try layout.backingStruct.typeName() otherwise panic("enumBackingFieldMember: a `structRecord` backing is set together with the struct it names (`requireEnumBacking`)")) 'backing'
			declared(struct) then return struct.declaresField(memberTok.value)
			undeclared then return false
		end 'backing'
	end 'enumBackingFieldMember'

	// ⭐⭐ **THE BINDING SPELLING OF AN ENUM MEMBER READ — `s.ordinal`, `s.name`, `s.rawValue`, `p.width`.**
	// Guarded by `enumMemberReadableOfType`, so the base — a this-frame binding, a capture or the receiver,
	// as `base` says — belongs to a declared enum or union; this consumes `<base> . <member>`.
	//
	// ⭐ **WHAT IT CONTRIBUTES IS THE ONE THING THIS SPELLING KNOWS AND THE TYPE-QUALIFIED ONE DOES NOT: that
	// there IS a value.** So it answers "where is the tag" through `emitEnumTagOf` and hands the tag on;
	// every question about what the MEMBER means is asked once, in `emitEnumInstanceAccessor`, whose header
	// carries them. Written the other way round, the two spellings would each have a copy.
	//
	// It takes no `IrFunction`: the emitters it calls append to `self.bodyState.currentBlock`, exactly as the
	// `.managed` field door's do. A parameter kept for symmetry would be an unused one (E3012).
	function parseEnumAccessor(base EnumAccessorBase) returns ValueId throws SourceParseError
		let baseTok = try self.consumeChainBaseToken()
		try self.consume(TokenKind.dot)
		let memberTok = try self.consumeMemberNameToken()

		let range = SourceRange.between(baseTok, last: memberTok)

		// ONE read of the binding, serving both questions below: a cell-resident base would otherwise be
		// loaded twice, and the second load is not merely wasteful — the two would be different SSA values
		// describing one enum.
		let baseValue = try self.enumAccessorBaseValue(base, baseTok: baseTok)
		let layout = requireEnumLayout(self.enumMatchFor(baseValue))

		// QUESTION 1 — where the tag is, asked through the door the `match` dispatch asks it through, and the
		// one thing this spelling knows that the type-qualified one does not: there IS a value here.
		return try self.emitEnumInstanceAccessor(layout, tag: try self.emitEnumTagOf(baseValue, layout: layout, anchor: memberTok, range: range, reach: EnumTagReach.written), memberTok: memberTok, range: range)
	end 'parseEnumAccessor'

	function enumAccessorBaseValue(base EnumAccessorBase, baseTok Token) returns ValueId throws SourceParseError
		match base 'base'
			thisFrame then return try self.thisFrameEnumBaseValue(baseTok)
			receiver then return try self.readReceiverValue(baseTok)
			captured(enclosing, frame) then return try self.emitCaptureRead(self.baseBindingName(baseTok), enclosing: enclosing, frame: frame, anchor: baseTok)
		end 'base'
	end 'enumAccessorBaseValue'

	function thisFrameEnumBaseValue(baseTok Token) returns ValueId throws SourceParseError
		let baseBinding = self.thisFrameBindingOf(baseTok)

		// The base is a USE of the binding, so it takes the same liveness/move guard every other read of a
		// name takes — a moved-from enum binding is dead here exactly as it is at `requireStructBase`.
		try self.requireBindingLive(baseBinding, nameTok: baseTok)

		return try self.baseBoxOf(baseBinding, baseTok: baseTok)
	end 'thisFrameEnumBaseValue'

	// ⭐⭐ **THE ANSWER ITSELF, ONCE THE TAG IS IN HAND — shared by the two SPELLINGS of an enum member read.**
	// A BINDING's (`op.rawValue`, above) and a type-qualified CASE's (`Op.doubleOp.rawValue`,
	// `TestOp.mul.latency`, `parseEnumLiteral`) differ ONLY in how the tag was obtained; past that they are
	// the same questions of the same layout, so they are asked here once. Written separately, the case
	// spelling would have been a second `.ordinal`/`.name`/`.rawValue` dispatch free to answer differently
	// from the binding one — the shape this file has paid for before.
	//
	// ⭐ **THE SPLIT BETWEEN THE MEMBERS IS THE *CONSTANT* EACH SELECTS AND NOTHING ELSE.** They ask the same
	// questions of the same layout, in the same order, and every one that must compute an answer computes it
	// with the same branchless sum — see `emitEnumCaseConstantSelect`, and `EnumCaseConstant` for the columns
	// it selects from. What differs per member is which column, and what TYPE the answer is handed back at.
	//
	// ⭐⭐ **IT TAKES THE TAG AND NOT A RECEIVER, BECAUSE ONE OF ITS TWO SPELLINGS HAS NO RECEIVER.**
	// `TestOp.mul.latency` names a case of a BOXED union: the read is answered from the constant tag and no
	// box is ever built, so there is no value to hand in.
	//
	// ⭐⭐ **IT ASKS THREE INDEPENDENT QUESTIONS, IN THIS ORDER, AND THEY MUST NEVER BE FUSED INTO ONE.**
	//
	//   1. **WHERE IS THE TAG?** Not asked here at all — asked by each CALLER, through one of the two
	//      functions that answer it: `emitEnumTagOf` for a value (which asks `emitEnumDispatchKey`, the
	//      door the `match` dispatch also asks, so the accessor and the `match` agree about where a union
	//      keeps its tag by construction) or
	//      `emitEnumCaseTagConstant` for a case named through its type. The two sit together and neither
	//      rule is spelled out anywhere else.
	//   2. **IS THAT TAG THE ORDINAL, OR ONLY A KEY TO IT?** Where the tag column is `0,1,2,…` the ordinal
	//      is the tag and the accessor costs no instruction; where the author renumbered the cases it is a
	//      different number and the mapping has to be computed (`emitEnumCaseConstantSelect` below).
	//   3. **IS THE ANSWER ALREADY AN `integer`-TYPED VALUE?** A loaded tag is; an unboxed enum's value is
	//      `named(<Enum>)` and needs a `+ 0`. Asked of the value's TYPE COLUMN, not re-derived from question
	//      1 — see `enumTagAsANumber`, which owns that obligation and the measurement behind it.
	//
	// ⭐⭐ **THEY ARE INDEPENDENT, AND THE COMBINATION THIS HEADER CALLED UNREACHABLE NOW ARRIVES — WHICH IS
	// THE ARGUMENT PAYING OUT RATHER THAN AGEING.** It read *"a boxed union cannot currently declare raw
	// values, so 'boxed AND renumbered' never arrives — but that is a fact about what the case reader admits
	// this month, not a law about ordinals"*. The month came: `readEnumCaseInto` reads a case's payload list
	// and its raw value as INDEPENDENT halves (`/specs/union-struct-backing.md` needs both on one case), so
	// `union Instr  add(dest ID, src ID) = 5  nop = 7 end` is boxed AND renumbered. MEASURED, and
	// byte-identical to the oracle: `op.rawValue` is **5** while `op.ordinal` is **0**. A single fused
	// condition would have answered one of those with the other. ⛔ It also broke a THIRD reader that had
	// quietly keyed on the same coincidence — see `appendUnionCasesCompanion`.
	//
	// ⚠⚠ **QUESTION 1 WENT UNASKED UNTIL IT WAS MEASURED, AND EVERY BOXED UNION'S `.ordinal` WAS A BOX
	// POINTER** — `Container.value(7).ordinal` printed 7077912 and `Container.empty.ordinal` printed 7078078
	// against the oracle's 1 and 0, and the numbers MOVED between runs because they were addresses. Both arms
	// of the union, not only the payload-bearing one (see `emitEnumTagOf`). `tagsAreDeclarationIndices` was
	// true for such a union, so it took the `+ 0` route and added zero to an address. This is why the
	// questions are separate: that one predicate was answering all three, and it is only ever an answer to
	// the second.
	function emitEnumInstanceAccessor(layout EnumLayout, tag ValueId, memberTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.requireMembersReachable(layout.name, visibility: layout.visibility, declFilePath: layout.declFilePath, memberTok: memberTok)

		// The dispatch is EXHAUSTIVE over `EnumInstanceAccessor`, which is what makes the door's cursor test and
		// this answer one rule: a member added to the classifier stops this function compiling until it is
		// answered here. `notAnAccessor` survives as the unreachable arm the guard already excluded.
		match enumInstanceAccessorOf(memberTok.value) 'member'
			caseName then return self.notedEnumAccessorRead(try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.caseName, valueType: MaxonType.string, anchor: memberTok, range: range), member: memberTok, tag: tag, isACaseTest: true)

			// ⚠ **A STRUCT-BACKED `.rawValue` IS NOT A CASE TEST AND IS NOT TAINTED.** Its answer is a whole
			// RECORD, so what a program compares is a FIELD of it (`op.rawValue.category`) — an ordinary value
			// read out of the backing, and refusing that would refuse the corpus's own dispatch tables.
			rawValue then return self.notedEnumAccessorRead(try self.emitEnumRawValue(layout, tag: tag, anchor: memberTok, range: range), member: memberTok, tag: tag, isACaseTest: layout.backing != EnumBacking.structRecord)
			ordinal then break

			// ⭐ **THE ONE MEMBER THAT IS NOT ONE OF THE THREE AND IS STILL A READ: a STRUCT-BACKED enum's
			// BACKING FIELD** (`p.width`, the shorthand for `p.rawValue.width`). `enumMemberReadableOfType` admits it
			// through `enumMemberIsReadable`, which is the same function this arm's refusal comes from — so the
			// door and the answer stay one rule, exactly as the three accessors are.
			//
			// ⭐ **REACHABLE FROM BOTH SPELLINGS.** `atEnumInstanceAccessor` — the type-qualified door — asks
			// the same `enumMemberIsReadable` this arm's refusal comes from, so `Preset.large.width` and
			// `TestOp.mul.latency` arrive here exactly as `p.width` does. `/specs/union-struct-backing.md`
			// writes the second; the enum spelling is pinned by `specs/enum-struct-backing.md`'s
			// `struct-backing-type-qualified-field`.
			notAnAccessor then return try self.emitEnumBackingFieldRead(layout, tag: tag, memberTok: memberTok, range: range)
		end 'member'

		// QUESTION 2 — whether that tag is already the answer. The lookup reads the tag as a bare i64, which
		// both forms of it are, so it needs to know nothing about question 1.
		if not layout.tagsAreDeclarationIndices() 'renumberedCases'
			return self.notedEnumAccessorRead(self.typedAsOrdinal(try self.emitEnumCaseConstantSelect(layout, tag: tag, column: EnumCaseConstant.declarationIndex, anchor: memberTok, range: range), layout: layout), member: memberTok, tag: tag, isACaseTest: true)
		end 'renumberedCases'

		return self.notedEnumAccessorRead(self.typedAsOrdinal(self.enumTagAsANumber(tag, anchor: memberTok, range: range), layout: layout), member: memberTok, tag: tag, isACaseTest: true)
	end 'emitEnumInstanceAccessor'

	function typedAsOrdinal(number ValueId, layout EnumLayout) returns ValueId
		if self.constIsKnown(number) 'aKnownConstant'
			return number
		end 'aKnownConstant'

		let ordinal = self.retypeAsLibraryAlias(number, aliasName: ElementIndexAliasName)

		if layout.caseCount() > 0 'declaresCases'
			self.recordProvenIntRange(ordinal, low: 0, high: (layout.caseCount() - 1) as FullRangeInt)
		end 'declaresCases'

		return ordinal
	end 'typedAsOrdinal'

	function typedAsRawInteger(number ValueId, layout EnumLayout) returns ValueId
		if self.constIsKnown(number) 'aKnownConstant'
			return number
		end 'aKnownConstant'

		let raw = self.retypeAsLibraryAlias(number, aliasName: FullRangeIntAliasName)

		if layout.caseCount() > 0 'declaresCases'
			let tags = layout.tagRange()
			self.recordProvenIntRange(raw, low: tags.low, high: tags.high)
		end 'declaresCases'

		return raw
	end 'typedAsRawInteger'

	// ⭐ **E3097's TAINT, MINTED AT THE ONE DOOR THAT PRODUCES AN ACCESSOR VALUE.** Every `.name`,
	// `.ordinal` and `.rawValue` read in the program comes out of `emitEnumInstanceAccessor`, whichever
	// spelling reached it, so recording here is what makes the refusal a property of the read rather than
	// of the syntax around it. The BACKING-FIELD arm deliberately does not come through: `p.width` is a
	// field of the enum's backing struct, an ordinary value, and comparing it is an ordinary comparison.
	// ⛔⛔ **A PASS-THROUGH ANSWER MAY NOT BE TAINTED, AND THIS IS THE WHOLE OF WHY THE TAINT IS SOUND.**
	// `enumTagAsANumber` hands the TAG back UNCHANGED when it is already `integer` — for a boxed union that
	// tag is a LOADED value, and for an unboxed one it can be the BINDING's own — so marking it would make
	// every later comparison of that value an accessor comparison. MEASURED before this guard existed: it
	// refused three sites in the compiler's own source that compare a FIELD of a backing record, none of them a case
	// test. So the mark goes on a value the accessor actually MINTED, and a pass-through is silently
	// un-refusable — a miss rather than a wrong answer, which is the direction this rule must fail in.
	function notedEnumAccessorRead(value ValueId, member Token, tag ValueId, isACaseTest bool) returns ValueId
		if not isACaseTest or value == tag 'nothingToMark'
			return value
		end 'nothingToMark'

		self.bodyState.enumAccessorReads.push(EnumAccessorRead.create(value, member: member.value))
		return value
	end 'notedEnumAccessorRead'

	// The accessor a value came out of, or nothing. A linear scan of a list that is EMPTY in every function
	// that reads no accessor — which is the shape the whole record is chosen for, and the reason this is not
	// a per-`ValueId` column.
	function enumAccessorReadOf(value ValueId) returns EnumAccessorLookup
		for read in self.bodyState.enumAccessorReads 'each'
			if read.value == value 'thisOne'
				return EnumAccessorLookup.read(read.member)
			end 'thisOne'
		end 'each'

		return EnumAccessorLookup.notAnAccessor
	end 'enumAccessorReadOf'

	// ⭐⭐ **E3097 — `==`/`!=` AGAINST AN ENUM ACCESSOR IS A CASE TEST WRITTEN THE WRONG WAY ROUND.** The
	// comparison reads as a dispatch and is a string or integer compare on a DERIVED value: add a case to the
	// enum and every such site goes on answering as it did, silently, which is exactly what the rule exists
	// to stop. The cure is on the value itself — `value == Type.case`, or `match` for a union variant — and
	// the message says so because the author's next question is what to write instead.
	//
	// ⚠ Only EQUALITY. Ordering an accessor (`a.ordinal < b.ordinal`) claims to be no such test and is
	// left alone.
	function requireNotAnEnumAccessorComparison(lhs ValueId, rhs ValueId, opTok Token) throws SourceParseError
		match self.enumAccessorReadOf(lhs) 'left'
			read(member) then throw SourceParseError.enumAccessorComparison(String.from(member), op: opTok.kind.rawValue, line: opTok.line, column: opTok.column)
			notAnAccessor then break
		end 'left'

		match self.enumAccessorReadOf(rhs) 'right'
			read(member) then throw SourceParseError.enumAccessorComparison(String.from(member), op: opTok.kind.rawValue, line: opTok.line, column: opTok.column)
			notAnAccessor then break
		end 'right'
	end 'requireNotAnEnumAccessorComparison'

	// ⭐ **QUESTION 3 — HAND A TAG BACK AS A NUMBER RATHER THAN AS A VALUE OF THE ENUM'S TYPE**, and it
	// is a third question rather than question 1 re-read. It asks what the tag value is TYPED, which
	// is the predicate spelled — a LOADED tag is already `integer` and is returned as it stands, and
	// the `+ 0` below is the same obligation where it is not. Reading the representation for this
	// would be right only while `emitEnumTagOf`'s load happens to mint `integer`; the type column is
	// what the answer turns on, so it is what is asked.
	//
	// ⭐⭐ **THE `+ 0` IS THE MEANING RATHER THAN A TRICK FOR PRODUCING IT.** An enum value IS its tag
	// (`parseEnumLiteral`), so under the accessor's guard the answer and the value are the same 64 bits, and
	// `+ 0` gets its result type from the one rule that types every other arithmetic result
	// (`TypeRules.arithResultTag`) rather than from an assertion here. It is emitted past the operand rule:
	// the tag is read out as a number, not used as an operand, and a union's tag is one the operand rule
	// refuses (`numberTagOf`).
	//
	// ⚠ **THE FRESH VALUE IS THE POINT, AND HANDING BACK THE RECEIVER'S OWN `ValueId` WAS MEASURED WRONG.**
	// It looks free — same bits, no instruction — but the receiver's value is tagged `named(LocalStatus)`,
	// and that tag is what E3005 reads: `return s.ordinal` from a `returns Integer` function reported
	// *"Cannot return 'LocalStatus' from function declared to return 'int'"*. The tag is not decoration; it
	// is the value's source type, and an ordinal is not of the enum's type. `retypeValue` is not the fix
	// either — it rewrites the columns IN PLACE, and this value may be a BINDING's, so retyping it would
	// break the `match s` two lines later. (`s as Integer` does not help for the same reason: the compiler's `as`
	// inside one numeric domain leaves the tag alone, so it is refused identically.)
	//
	// Two readers: `.ordinal` where the tags ARE the declaration indices, and `.rawValue` where the tag IS
	// the raw value and the backing is integral — the same obligation, which is why it is one function.
	function enumTagAsANumber(tag ValueId, anchor Token, range SourceRange) returns ValueId
		let tagTag = self.tagOf(tag)

		if tagTag == ValueTypeTag.integer 'tagIsAlreadyANumber'
			return tag
		end 'tagIsAlreadyANumber'

		let zero = self.emitLiteral(EnumOrdinalTagOffset, valueType: MaxonType.integer, range: range)

		return self.emitBinOpOverCheckedOperands(tag, rhs: zero, op: MaxonBinOp.add, leftTag: tagTag, rightTag: ValueTypeTag.integer, opTok: anchor, operandAlias: self.operandAliasOf(tag))
	end 'enumTagAsANumber'

	// ⭐⭐ **`s.rawValue` — THE ONE ACCESSOR WHOSE RESULT TYPE THE *BACKING* DECIDES**, which is why it has a
	// function of its own where `.name` is one line. Every arm answers from the SAME tag; what differs is the
	// domain the tag is read in:
	//
	//   • `integer` / `unresolved` — the tag IS the raw value and it is already a number. (`unresolved` is an
	//     enum whose cases numbered nothing, where the auto-increment declaration index is the raw
	//     value.)
	//   • `float` — the tag is the f64's IEEE-754 BIT PATTERN in a GPR, so the read is the `bitsToFloat`
	//     REINTERPRETATION every other float-backed-enum read goes through (`floatBehindEnumValue`, and its
	//     header for the four wrong answers a `cvtsi2sd` produced here).
	//   • `character` — the tag is the Unicode CODEPOINT, and a `Character` is a 56-byte record, so the value
	//     has to be MINTED (`__char_from_cp`) exactly as a `for c in 'a' to 'e'` trip element is. It is the
	//     one raw value that owns heap, so it is enrolled as an owned temporary and dropped at the statement's
	//     end like any other minted record.
	//   • `string` — the tag is only a declaration index (`EnumLayout.rawValueIdentity`), so the value rides
	//     `caseRawValues` and is selected the same way `.name` selects `caseNames`.
	//   • `functionRef` — the tag is only a declaration index too, and `caseRawValues` holds the backing
	//     FUNCTION's name; the constant selected is that function's `__fnref_` thunk address, and the sum is
	//     handed back typed `function(<first case's function>)` so it is CALLABLE. See
	//     `enumFunctionBackingGoverningName` for why the first case's name is the whole enum's answer.
	function emitEnumRawValue(layout EnumLayout, tag ValueId, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		match layout.backing 'backing'
			// `integer` carries every payload-bearing union: a payload-only case takes
			// `appendAutoTaggedEnumCase`, which fixes `EnumBacking.integer`, so
			// `union Shape circle(r int) square(s int) blank end` has tags `0,1,2` and `sh.rawValue` reads
			// them — pinned by `/specs/union-cases.md`'s `union-cases.runtime-accessors`, so a refusal here
			// turns that case red. The static members (`allCases`, `fromRawValue`) are refused on a union
			// because they need a per-case raw value the union has not got, while `.rawValue`, `.name` and
			// `.ordinal` need only the tag column.
			//
			// `unresolved` is a declaration with no cases (`requireEnumBacking` is its only door), which
			// cannot be read from; its raw value would be its declaration index, as for `integer`.
			integer or
			unresolved then return self.typedAsRawInteger(self.enumTagAsANumber(tag, anchor: anchor, range: range), layout: layout)
			float then return self.emitFullRangeFloatBits(tag, range: range)
			character then break
			string then return try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.declaredRawValue, valueType: MaxonType.string, anchor: anchor, range: range)
			functionRef then return try self.emitEnumCaseFunctionSelect(layout, tag: tag, anchor: anchor, range: range)

			// ⭐ `structRecord` — the tag is only a declaration index, and the raw value is a whole STRUCT, which
			// is not one machine word and therefore not one column. `.rawValue` is not an answer here; the
			// answer is per FIELD, and the field is the token after this one. See `emitEnumBackingRawValue`.
			structRecord then return try self.emitEnumBackingRawValue(layout, tag: tag, anchor: anchor, range: range)
		end 'backing'

		let character = self.emitRuntimeCall(CharFromCodepointName, args: argsOf(tag), resultTag: ValueTypeTag.character, resultNameId: UnnamedTypeId, range: range)
		self.trackOwnedTemp(character, exclusivity: OwnedHeapExclusivity.sole)
		return character
	end 'emitEnumRawValue'

	// ⭐ **`p.width` — THE SHORTHAND SPELLING, WHERE THE MEMBER IS THE FIELD AND THERE IS NO `.rawValue` HOP
	// TO CONSUME.** The assertion is what makes the door and this dispatch one rule: `enumMemberReadableOfType`
	// admits a member through `enumMemberIsReadable`, whose second half is the very predicate re-asked here,
	// so a member it admitted cannot be one this refuses — and a member it did NOT admit never arrives,
	// because `parseDottedPrimary` falls through to `parseFieldAccess`'s refusal instead.
	function emitEnumBackingFieldRead(layout EnumLayout, tag ValueId, memberTok Token, range SourceRange) returns ValueId throws SourceParseError
		if not self.enumBackingFieldMember(layout, memberTok: memberTok) 'notAMemberAtAll'
			panic("emitEnumBackingFieldRead: member '{String.from(memberTok.value)}' reached the accessor and names neither one of the three enum accessors nor a field of `{layout.kindWord()} {String.from(layout.name)}`'s backing struct — EVERY door into this dispatch admits a member through `enumMemberIsReadable`, the very predicate this line re-asks, so a member any of them admitted cannot be one this refuses")
		end 'notAMemberAtAll'

		return try self.emitEnumBackingFieldSelect(layout, tag: tag, fieldTok: memberTok, range: range)
	end 'emitEnumBackingFieldRead'

	// ⭐⭐ **DOES A `.<field>` HOP FOLLOW THE CURSOR? — THE ONE TOKEN-SHAPE TEST FOR CONTINUING A BACKING
	// CHAIN.** Both places that must ask it are the same question about the same two tokens: `.rawValue`
	// deciding whether a field follows it, and a NESTED RECORD deciding whether the chain descends into one.
	//
	// ⚠ **IT WAS WRITTEN OUT TWICE, CHARACTER FOR CHARACTER, AND THE COPIES CANNOT BE MADE TO DISAGREE
	// LOUDLY.** `consumeMemberNameToken` admits more than an identifier (a keyword, and a NUMBER rewritten
	// into a name for a tuple member), so widening one copy for `t.0` and not the other would not be a
	// compile error anywhere — it would accept `.rawValue.0` while refusing `.rawValue.pair.0`, or the
	// reverse. The two SENTENCES stay separate: they are about different subjects, the whole record and one
	// nested field.
	function atEnumBackingFieldHop() returns bool
		return self.enumMemberReadFollowsAt(self.pos) and tokenCanBeAName(self.enumMemberTokenAt(self.pos))
	end 'atEnumBackingFieldHop'

	// ⭐⭐ **`e.rawValue.<field>` ON A STRUCT-BACKED ENUM — THE `.rawValue` IS A HOP, NOT AN ANSWER.** The
	// cursor sits just past `rawValue`; this consumes the `. <field>` that must follow and hands the read to
	// the per-field select.
	//
	// ⛔ Bare `.rawValue` is REFUSED, deliberately: serving it means MATERIALIZING the backing struct,
	// and the reason not to is the one `parseEnumLiteral`'s boxed-union hop already states for a
	// neighbouring gap: a materialized record is an OWNED heap value minted mid-expression, which asks
	// who drops it and when — and the wrong answer to that is a leak or a double free rather than a
	// diagnostic. **No case in `/specs/enum-struct-backing.md` puts that question**: every use in it
	// is `.rawValue.<field>`, which needs no record at all. Whoever puts it builds the
	// materialization; until then the refusal says exactly that rather than implying the value cannot
	// exist.
	//
	// ⇒ This refusal is also the REASON `fromRawValue` on such an enum is an absent member rather than a
	// declined one. ⚠ It is not the MECHANISM, and saying so would be prose standing in for code: the
	// absence is produced by the explicit conjunct `and layout.backing != EnumBacking.structRecord` at the
	// claim site in `parseEnumLiteral`. Delete that conjunct and the call reaches
	// `requireFromRawValueBacking`'s `structRecord` arm, which PANICS — it asserts the claim site's decision
	// rather than re-deriving it. Nothing about E3034 falls out on its own.
	function emitEnumBackingRawValue(layout EnumLayout, tag ValueId, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		if not self.atEnumBackingFieldHop() 'noFieldFollows'
			throw SourceParseError.unsupported("`{String.from(EnumRawValueMemberName)}` on `{layout.kindWord()} {String.from(layout.name)}` read as a whole value — its raw value is a `{enumBackingNoun(layout.backing, backingStruct: layout.backingStruct)}` record, which the compiler selects one FIELD of at a time (`.{String.from(EnumRawValueMemberName)}.<field>`) rather than materializing. Materializing it here would mint an owned heap record inside an expression, and no case in `/specs/enum-struct-backing.md` asks for one", line: anchor.line, column: anchor.column)
		end 'noFieldFollows'

		try self.consume(TokenKind.dot)
		let fieldTok = try self.consumeMemberNameToken()

		return try self.emitEnumBackingFieldSelect(layout, tag: tag, fieldTok: fieldTok, range: range)
	end 'emitEnumBackingRawValue'

	// ⭐⭐ **WHICH SCALAR LEAF `<field>[.<field>…]` NAMES — THE WALK OVER THE DECLARED TYPES.** The cursor sits
	// just past the FIRST field name (`fieldTok`); every further hop this consumes is one the chain wrote.
	//
	// ⭐⭐ **IT DESCENDS THE *TYPES*, NEVER THE WRITTEN CONSTANTS, AND THAT IS WHAT MAKES ONE PATH SERVE EVERY
	// CASE.** `op.rawValue.meta.latency` means the same field of the same struct whichever case `op` holds —
	// the cases differ only in the NUMBER at the end — so the path is resolved ONCE per read here and the
	// per-case walk (`enumBackingFieldConstant`) merely follows it. Resolving against one case's entries
	// would make the answer depend on which case happened to be looked at first.
	//
	// ⛔ **A CHAIN THAT STOPS ON A RECORD IS REFUSED, AND IT IS BARE `.rawValue`'s REFUSAL ONE LEVEL IN.**
	// `op.rawValue.meta` names a whole `OpMeta` record; handing one back means minting an owned heap record
	// inside an expression, which asks who drops it and when (see `emitEnumBackingRawValue`, where the same
	// question is declined for the backing itself). Nothing in `/specs/enum-nested-struct-backing.md` asks
	// for one: every read in it reaches a scalar.
	//
	// ⚠ **RECURSIVE RATHER THAN A LOOP, AND THE PATH IS PASSED DOWN**: each hop is the identical question of
	// a different struct, and a loop would have to REBIND the struct — a managed value — once per hop.
	function resolveEnumBackingLeaf(struct StructLayout, memberTok Token, path EnumBackingFieldStepArray) returns EnumBackingLeaf throws SourceParseError
		let field = try self.requireFieldIndex(struct, name: memberTok.value, anchor: memberTok)
		path.push(EnumBackingFieldStep.create(field, fieldName: struct.fieldNameAt(field), ownerName: struct.name))

		let fieldType = self.signatures.fieldTypeOf(struct, index: field, into: self.artifact.typeNames)
		let domain = self.enumBackingFieldDomainOf(fieldType)

		if not domainIsEnumBackingNestedRecord(domain) 'reachedAScalar'
			return EnumBackingLeaf.create(path, fieldType: fieldType, domain: domain)
		end 'reachedAScalar'

		let nested = self.enumBackingNestedStruct(struct, field: field)

		if not self.atEnumBackingFieldHop() 'noFieldFollows'
			throw SourceParseError.unsupported("field '{String.from(struct.fieldNameAt(field))}' of the `{String.from(struct.name)}` backing read as a whole value — it is declared `{String.from(nested.name)}`, a record, and the compiler selects one SCALAR field of a struct backing at a time (`.{String.from(struct.fieldNameAt(field))}.<field>`) rather than materializing one. That is the refusal `{String.from(EnumRawValueMemberName)}` itself carries, one level in: a materialized record is an owned heap value minted inside an expression", line: memberTok.line, column: memberTok.column)
		end 'noFieldFollows'

		try self.consume(TokenKind.dot)

		return try self.resolveEnumBackingLeaf(nested, memberTok: try self.consumeMemberNameToken(), path: path)
	end 'resolveEnumBackingLeaf'

	// ⭐⭐ **ONE FIELD OF A CONSTANT STRUCT BACKING, AS A VALUE — the per-field column, selected by the very
	// sum `.ordinal` and `.name` are selected by.** That is the whole mechanism: a struct is not one machine
	// word, but each of its FIELDS is, so the branchless `Σᵢ constantᵢ × (tag == tagᵢ)` applies once per field
	// read and nothing new is needed for a backing that is not a scalar.
	//
	// ⭐ No constant-receiver fold. The spec's prose describes folding `let op = TestOp.mul` to a
	// literal and emitting the select only for a runtime receiver; that costs a `let`-to-case alias
	// table (`letStructBackedEnumCases`), a second folding walk (`parseStructBackingAccessChain`) and
	// a descent shared between them so the two answers stay byte-for-byte in sync. The SELECT is
	// emitted for BOTH instead, so the constant receiver and the runtime one are one route that cannot
	// disagree, and there is no second walk to keep in step.
	//
	// ⚠ **WHAT THAT COSTS IS MEASURED, AND IT IS NOT ZERO: the chain reaches x64 UNFOLDED.** `struct-backing-
	// basic`'s emitted `main` is `movRegImm32 rax, 1` followed by the full two-case
	// `cmpRegImm32`/`setccReg`/`imulRegRegImm32`/`lea` ladder, not a `movRegImm32 r8, 3`. `foldConstOperands`
	// does not collapse it.
	//
	// ⇒ **AND THAT IS PRE-EXISTING BEHAVIOUR OF `emitEnumCaseConstantSelect`, NOT SOMETHING THIS COLUMN
	// INTRODUCED** — MEASURED on the `.name` column, whose `struct-backing-name` case emits the
	// identical unfolded ladder for a `let`-bound receiver. So a fold belongs to that emitter, for all
	// five of its columns at once, and not here. Never a wrong answer either way: the ladder computes
	// the same constant.
	//
	// ⭐ **AND THE CHAIN MAY CONTINUE INTO AN ENUM ACCESSOR** — `t.rawValue.priority.ordinal`, where the field
	// is itself enum-typed. That is the third hop `parseEnumLiteral` already makes for `Op.doubleOp.rawValue`,
	// made here for the same reason: the selected value is the ONE enum value that reaches an accessor without
	// ever being bound to a name, so nothing upstream can route it and the postfix loop would read `.ordinal`
	// as a method call.
	//
	// ⭐⭐ **AND THE CHAIN MAY BE LONGER THAN ONE HOP, BECAUSE A BACKING FIELD MAY ITSELF BE A STRUCT**
	// (`/specs/enum-nested-struct-backing.md`: `op.rawValue.meta.latency`). `resolveEnumBackingLeaf` walks
	// the DECLARED types until it reaches a scalar, and what comes back is a PATH — everything past that
	// point is unchanged, because the leaf is still one machine word that is constant per case.
	function emitEnumBackingFieldSelect(layout EnumLayout, tag ValueId, fieldTok Token, range SourceRange) returns ValueId throws SourceParseError
		// The leaf's DECLARED type comes through the one door an ordinary field read asks it through
		// (`emitFieldLoad`), so a backing field of a ranged alias arrives tagged exactly as `s.width` on a
		// real record does — which is what makes `return op.rawValue.value` from a `returns Latency` function
		// type-check, and what gives the `named(Priority)` an `.ordinal` hop below needs.
		let leaf = try self.resolveEnumBackingLeaf(try self.requireEnumBackingStruct(layout, anchor: fieldTok), memberTok: fieldTok, path: EnumBackingFieldStepArray.create(0))
		let fieldType = leaf.fieldType
		let domain = leaf.domain

		// ⛔⛔ **THE SUM MUST BE DECODED INTO THE FIELD'S DOMAIN BEFORE IT IS CLAIMED TO BE OF THE FIELD'S
		// TYPE — `retypeValue` ONLY REWRITES TYPE COLUMNS.** The sum is integer arithmetic
		// (`emitCompareAgainstLiteral` → `mul` → `add`, all `operandType = i64`); the retype then CLAIMS it is
		// the field's type. For the three WORD domains that claim is already true of the bits. For a FLOAT
		// field it is not, and the value reached the backend as an f64 defined by an integer `add` —
		// **MEASURED as a compiler panic**, `X64Backend.maxon:828` *"a register-to-register move from rax to
		// xmm0 crosses register files"*, on `type M  export let r as Real end` + `a = M{r: 1.5}`.
		//
		// ⇒ the same `MaxonUnaryOp.bitsToFloat` REINTERPRETATION `emitEnumRawValue`'s float arm emits, and
		// for its reason: the i64 is the IEEE-754 pattern, so it is reinterpreted and never converted (a
		// `cvtsi2sd` would read the encoding as a magnitude — see that arm for the four wrong answers it
		// produced there).
		//
		// ⚠⚠ **AND THE ORDER IS THE WHOLE FIX: REINTERPRET, THEN CLAIM.** Written as the typed select (which
		// retypes) followed by the bitcast, the operand handed to `bitsToFloat` is already claimed f64 and the
		// panic merely MOVES — MEASURED, `LowerMaxonToStd.maxon:285` *"bitcastI64ToF64 reads an INTEGER
		// operand and was handed Std type f64 … a mismatch here is a front-end bug"*. So the three word
		// domains go through the shared typed select and the float one selects RAW.
		if domainIsEnumBackingFloatBits(domain) 'floatField'
			let bits = try self.emitEnumCaseConstantSelect(layout, tag: tag, column: EnumCaseConstant.structBackingField(leaf.path, domain: domain), anchor: fieldTok, range: range)
			let reinterpreted = self.emitUnaryOp(bits, op: MaxonUnaryOp.bitsToFloat, resultTag: ValueTypeTag.float, range: range)

			// The declared type is restored on the DECODED value, so a field of a ranged-float alias arrives
			// tagged `named(Ratio)` exactly as `emitFieldLoad` mints it - a claim that is now true of an
			// operand genuinely living in an XMM register.
			self.retypeValue(reinterpreted, valueType: fieldType)
			return reinterpreted
		end 'floatField'

		// `checkEnumBackingGroup` refuses an `unsupported` field at the DECLARATION, once per case, whether or
		// not any expression reads it — but a READ can still arrive first (see
		// `enumBackingUnsupportedFieldError`), so the gate below throws rather than asserting. Past it only
		// the three word domains remain, and for each the i64 IS the value: an int (or ranged-int alias), a
		// bool whose payload is 0 or 1, and a PAYLOAD-FREE enum whose value is its tag.
		try self.requireEnumBackingFieldDomainIsAWord(leaf.lastStep(), fieldType: fieldType, domain: domain, anchor: fieldTok)
		let selected = try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.structBackingField(leaf.path, domain: domain), valueType: fieldType, anchor: fieldTok, range: range)

		// A `.name`-shaped member on a leaf that is NOT enum-typed is left where it was: the field may be a
		// `String` with a `.count()`, and only the enum route is this function's to claim. The gates that
		// decide it live in `atEnumAccessorHopOn`, which `parsePostfix` reads too.
		if not self.atEnumAccessorHopOn(selected) 'noAccessorHop'
			return selected
		end 'noAccessorHop'

		let fieldLayout = requireEnumLayout(self.enumMatchFor(selected))

		// The selected leaf is a value of `fieldLayout` — the `enumWord` domain, which
		// `enumBackingNamedFieldDomain` admits only for an UNBOXED declaration, so `emitEnumTagOf` is the
		// identity here. It is still asked rather than assumed: that premise lives at the classifier, and a
		// reader that spelled the conclusion out would be a second copy of it.
		return try self.consumeEnumAccessorHop(fieldLayout, tag: try self.emitEnumTagOf(selected, layout: fieldLayout, anchor: fieldTok, range: range, reach: EnumTagReach.written), anchorTok: fieldTok)
	end 'emitEnumBackingFieldSelect'

	// ⭐ **AN ADDRESS-VALUED ACCESSOR — the selection, then the ONE line that says what was selected.** The
	// sum below is arithmetic and types itself `integer`; the selected words are ADDRESSES — a `.rdata`
	// String record for the two string columns, a `.text` `__fnref_` thunk for the function one — so the
	// result IS a String or a function and this is where it is recorded as one. Written once because `.name`,
	// a string backing's `.rawValue` and a function backing's differ only in the column and in that claim.
	//
	// ⚠ **NOTHING OWNS THE RESULT, AND THAT IS A PROPERTY OF WHAT WAS SELECTED.** Every candidate is an
	// IMMORTAL literal record (`capacity = -2`, never allocated, refcounted or dropped) or a code address,
	// so the selected one is too — which is what lets `return sh.name` hand it straight out of the function,
	// exactly as `return "circle"` does.
	function emitEnumCaseTypedSelect(layout EnumLayout, tag ValueId, column EnumCaseConstant, valueType MaxonType, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		let selected = try self.emitEnumCaseConstantSelect(layout, tag: tag, column: column, anchor: anchor, range: range)
		self.retypeValue(selected, valueType: valueType)
		return selected
	end 'emitEnumCaseTypedSelect'

	function emitEnumCaseFunctionSelect(layout EnumLayout, tag ValueId, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		let selected = try self.emitEnumCaseTypedSelect(layout, tag: tag, column: EnumCaseConstant.caseFunctionRef, valueType: MaxonType.function(self.enumFunctionBackingGoverningName(layout)), anchor: anchor, range: range)
		self.markImmortalFunction(selected)
		return selected
	end 'emitEnumCaseFunctionSelect'

	// ⭐⭐ **THE NAME THAT GOVERNS A FUNCTION-BACKED ENUM'S `.rawValue` — THE FIRST CASE'S FUNCTION, AND THAT
	// IS A TYPE CLAIM RATHER THAN AN IDENTITY ONE.** A function value's `MaxonType.function(id)` names
	// whatever DECLARES its signature (see MaxonType's `function` arm) — the function it refers to, or the
	// typealias the place was written with — and every reader of it asks exactly one question: what shape may
	// this be called at? `.rawValue` yields ONE value for n cases, so it needs ONE such name, and the first
	// case's function is a name that already resolves in `funcSignatures` whole-program, in every file, for a
	// forward reference as much as a backward one.
	//
	// ⚠ **IT IS ONLY TRUE BECAUSE THE CASES ARE MADE TO AGREE, AND THAT PREMISE IS ENFORCED, NOT ASSUMED** —
	// `Parser.checkFunctionBackedCase` records every later case against this one as a `PendingFunctionTypeDoor`
	// and `SemanticCheck.checkFunctionTypeDoors` refuses a disagreement. Without that check this would be a
	// lossy key standing in for an identity: `Op.tripleOp.rawValue` would be called at `doubleFn`'s shape.
	//
	// There is no signature-id registry — a function type is carried by the NAME of something that
	// declares it — so minting a synthetic alias would mean writing that name into two registries (the
	// parse-time `ProgramSignatures` and the post-merge `functionAliasShapes`) to say what a name
	// already in both says.
	//
	// That case 0 exists at all is the backing's own property, argued and enforced once in
	// `enumCaseFunctionName` rather than assumed here.
	function enumFunctionBackingGoverningName(layout EnumLayout) returns TypeNameId
		return self.artifact.typeNames.intern(self.enumCaseFunctionName(layout, index: FirstCaseIndex))
	end 'enumFunctionBackingGoverningName'

	// ⭐⭐ **THE TAG→CONSTANT MAPPING EVERY ENUM ACCESSOR NEEDS — `Σᵢ constantᵢ × (tag == tagᵢ)`, BRANCHLESS.**
	// `enum Code { ok = 5 }` has ordinal 0 and tag 5, so on that route the tag is NOT the answer and the
	// answer has to be computed from it; a case NAME is never the tag at all. Exactly one of the comparisons
	// holds — an enum value is one of the declared tags, the same closure `match`'s exhaustiveness rests on
	// (nothing in the language mints an enum value except a case construct, a match binding, or a value that
	// came from one) — so the sum is that case's constant and every other term is zero.
	//
	// ⭐⭐ **ONE EMITTER FOR THREE ACCESSORS, AND THE THREE ARE THE SAME QUESTION.** A NAME needs no
	// mechanism an ordinal does not: an immortal `.rdata` String is a machine word that is CONSTANT
	// PER CASE, exactly as a declaration index is, so it sums identically and needs no edge and no
	// merge. `EnumCaseConstant` is the whole of what varies.
	//
	// It takes the TAG, not the receiver: `parseEnumAccessor` has already answered where the tag lives (the
	// value itself, or a load out of a boxed union's offset 0), and both forms are the bare i64 the compares
	// below read. So this function needs to know nothing about boxing, and cannot get that question wrong.
	//
	// ⭐ **STRAIGHT-LINE, NOT A COMPARE/BRANCH CHAIN, AND THAT IS WHY IT CAN LIVE IN AN EXPRESSION AT ALL.**
	// A branch chain would have to fork mid-expression and merge n arms through a phi (`finalizeMatchMerge`'s
	// machinery), which is the apparatus a `match` EXPRESSION pays for because its arms run user code. Here
	// every arm is a constant, so the selection is arithmetic: a compare materializes its own 0/1
	// (x64 `setcc`+`movzx`, arm64 `cset`, wasm's i32 result zero-extended by `coerceOnStack`), one `mul`
	// scales it by the index, one `add` accumulates. Three ops per case, no blocks, no merge, and the whole
	// thing is an ordinary operand wherever `s.ordinal` was written.
	//
	// ⚠ **IT IS LINEAR IN THE CASE COUNT, PER READ, AND THAT IS THE ACCEPTED COST.** It is the shape
	// `EnumLayout.indexOfCase` already argues for — case counts are tiny — and the alternative shapes
	// each buy less than they cost: a per-enum helper FUNCTION trades n compares for a call/ret whose
	// prologue outweighs the work at these sizes (the argument `CheckedDivisionRuntime`'s header makes
	// for expanding a checked divide in place), and a table lookup keyed by TAG cannot be indexed by
	// one — `200`/`404`/`500` is exactly the case that reaches here.
	//
	// ⭐ The compare is the i64 IDENTITY compare on the tag for every backing, including float.
	// `.ordinal` asks WHICH CASE this is, and the compiler answers that question in exactly one way everywhere
	// else: an i64 compare against the tag column (`EnumLayout`'s header — a float-backed case's tag
	// is its IEEE-754 bit pattern, and `match` dispatches on it with no float register class). Routing
	// this through the same `emitCompareAgainstLiteral` the match dispatch uses is what makes the
	// accessor and the `match` unable to disagree about which case a value is. It is also strictly the
	// more correct compare: IEEE equality identifies `+0.0` with `-0.0`, which are two DISTINCT
	// declarable cases here (`EnumCaseLedger.rawValueIsClaimed` compares tags, so it admits both) —
	// under an f64 compare `low = 0.0 negLow = -0.0` answers ordinal 1 for BOTH, and under the tag
	// compare each answers its own index.
	function emitEnumCaseConstantSelect(layout EnumLayout, tag ValueId, column EnumCaseConstant, anchor Token, range SourceRange, domain EnumSelectDomain = EnumSelectDomain.caseTag) returns ValueId throws SourceParseError
		var selected = self.emitLiteral(FirstCaseOrdinal, valueType: MaxonType.integer, range: range)

		for i in firstSummedCaseIndex(column) upto layout.caseCount() 'eachSummedCase'
			// ⚠ **THE COMPARE'S RESULT IS RE-RECORDED AS A NUMBER, AND THE WIDTH CHANGE IS THE POINT.** The
			// mint types it `boolean` (i1 at Std) because that is what every other caller of that door feeds a
			// branch with; here the 0/1 is an arithmetic OPERAND. Left `boolean` it does not reach the machine
			// at all — `bool` is its own `TypeClass` and not `numeric`, so `requireBinOpOperands` refuses the
			// multiply outright — and past that gate `appendStdBinOp` would take the multiply's operand type
			// from this very value and ask for an i1 one. `integer` is the value's true type on this path
			// (`TypeRules.BoolTrueValue` is 1), it is minted one line above so no other reader can hold the
			// old claim, and the three backends each hand back a zero-extended machine word (see the header),
			// so the widened claim is one they already satisfy.
			let caseSubject = match domain 'subject'
				caseTag gives layout.tagOfIndex(i)
				wordKey gives layout.wordKeyOfIndex(i)
			end 'subject'

			let isThisCase = self.emitCompareAgainstLiteral(tag, literal: caseSubject, op: MaxonCmpOp.eq, opTok: anchor)
			self.retypeValue(isThisCase, valueType: MaxonType.integer)

			let caseConstant = try self.emitEnumCaseConstant(layout, index: i, column: column, anchor: anchor, range: range)
			let contribution = try self.emitBinOp(isThisCase, rhs: caseConstant, op: MaxonBinOp.mul, opTok: anchor)

			selected = try self.emitBinOp(selected, rhs: contribution, op: MaxonBinOp.add, opTok: anchor)
		end 'eachSummedCase'

		return selected
	end 'emitEnumCaseConstantSelect'

	// ⭐ **ONE CASE'S CONSTANT, AS AN `integer`-TYPED OPERAND THE SUM ABOVE CAN MULTIPLY.** A declaration
	// index already is a number; a `.rdata` String record and a `.text` function address are ADDRESSES, which
	// are numbers too — so the only thing the three ADDRESS columns need is for the value's TYPE COLUMN to
	// say so, which is the `retypeValue` below.
	//
	// ⚠ **RETYPING THE LITERAL IS SAFE HERE AND NOWHERE ELSE**: the value was minted one line above, names no
	// binding and has no other reader, so the claim cannot be stale for anybody. The op it defines is
	// untouched — a `stringLiteral` still lowers to the record's address and a `functionRef` to the thunk's —
	// and both claims agree at the Std tier, where a String, a code pointer and an `integer` are the same
	// i64. `emitEnumCaseTypedSelect` restores the real claim on the SUM, which is the value a program
	// actually reads.
	//
	// ⭐⭐ **THE FUNCTION COLUMN EMITS A REAL `functionRef` OP, AND THAT IS LOAD-BEARING TWICE OVER.** A
	// hand-built address constant would be the same 64 bits and would still be wrong: `collectFnRefThunkTargets`
	// scans for exactly this op to decide which `__fnref_` thunks to synthesize, and `DeadFunctionElimination`
	// roots the target off the `funcAddr` it lowers to. Emitted as a constant instead, the thunk would never
	// exist and the function would be stripped. It emits that op through `emitFunctionRefOp`, the producer every
	// function value shares; the gates `let f = doubleFn` meets were asked where the enum is declared.
	//
	// ⚠ **A FULL MATCH, FOR `firstSummedCaseIndex`'s STATED REASON AND NOT MERELY FOR SYMMETRY.** These are
	// the TWO per-column deciders `EnumCaseConstant` has, and they must refuse an unclassified column
	// ALIKE — an `if` chain ending in an `else` over `caseRawValues` would hand a fifth column the raw-value
	// bytes silently, which is a wrong answer where the sibling gives a compile error, and nothing routes an
	// author from that compile error to this function.
	function emitEnumCaseConstant(layout EnumLayout, index CaseIndex, column EnumCaseConstant, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		// ⚠ **EVERY ARM RETURNS, AND THE `var bytes` IT REPLACES WAS A PER-CASE ALLOCATION TWO ARMS NEVER
		// READ.** The seed `ByteArray.create(0)` sat above the match, so an empty array was allocated and
		// discarded ONCE PER CASE IN THE SUM for every `.ordinal` and every function-backed `.rawValue` — in a
		// file that prices allocations at exactly this granularity, on a path the fourth column had just
		// widened. Each column now names its own producer instead, which costs the exhaustive match nothing:
		// all five arms are still named here, so a sixth still fails to compile.
		match column 'c'
			declarationIndex then return self.emitLiteral(index as FullRangeInt, valueType: MaxonType.integer, range: range)
			caseName then return self.emitEnumCaseStringConstant(layout.caseNameAt(index), range: range)
			declaredRawValue then return self.emitEnumCaseStringConstant(freeze layout.rawValueAt(index).toByteArray(), range: range)
			caseFunctionRef then return self.emitEnumCaseFunctionConstant(layout, index: index, anchor: anchor)
			structBackingField(path, domain) then return self.emitLiteral(try self.enumBackingFieldConstant(layout, index: index, path: path, domain: domain, anchor: anchor), valueType: MaxonType.integer, range: range)
		end 'c'
	end 'emitEnumCaseConstant'

	// ⭐⭐ **CASE `index`'s NUMBER FOR BACKING FIELD `field` — the whole of what the DECLARATION deferred.**
	// The case reader could not resolve either half of this (it runs inside the sweep that builds the index),
	// so both are answered here: WHICH written entry fills the field, and what NUMBER that entry denotes.
	//
	// ⭐ **AN UNLABELLED FACTORY ARGUMENT IS MATCHED BY POSITION AND A LABELLED ONE BY NAME**, which is
	// the rule `readEnumBackingFields`' header states: `OpInfo.create(1, throughput: 1)` fills field 0
	// from argument 0 and `throughput` from the label. A brace literal labels every field, so it only
	// ever takes the name route.
	//
	// ⭐⭐ **AND IT FOLLOWS THE PATH, ONE GROUP PER HOP.** The read resolved which leaf is meant; this asks
	// which entry of THIS case fills each hop, descending into the group that entry owns until the last hop
	// answers with a number.
	function enumBackingFieldConstant(layout EnumLayout, index CaseIndex, path EnumBackingFieldStepArray, domain EnumBackingFieldDomain, anchor Token) returns FullRangeInt throws SourceParseError
		let written = layout.backingFieldsAt(index)
		var group = RootBackingGroup

		for hop in 0 upto path.count() 'eachHop'
			let step = try path.get(hop) otherwise panic("enumBackingFieldConstant: path.get OOB at {hop} below count {path.count()} for case '{String.from(layout.caseNameAt(index))}' of `{layout.kindWord()} {String.from(layout.name)}`")
			let entry = try self.requireEnumBackingEntryFilling(written, group: group, step: step, layout: layout, index: index, anchor: anchor)

			if hop + 1 == path.count() 'theLeafItself'
				return try self.enumBackingFieldNumber(enumBackingEntryAt(written, entry: entry).value, step: step, domain: domain, anchor: anchor)
			end 'theLeafItself'

			group = nestedBackingGroupOf(entry)
		end 'eachHop'

		panic("enumBackingFieldConstant: the path handed here is EMPTY for case '{String.from(layout.caseNameAt(index))}' of `{layout.kindWord()} {String.from(layout.name)}` — `resolveEnumBackingLeaf` pushes one step per hop before any exit, so a read cannot produce a column with no hops")
	end 'enumBackingFieldConstant'

	// ⭐⭐ **WHICH ENTRY OF THIS CASE FILLS ONE HOP** — a LABELLED entry by its name, an UNLABELLED one by its
	// position, and only ever among the entries that belong to the same group. Both spellings may appear in
	// one group (`OpMeta.create(4, isMemory: true, isCall: false)`), which is why neither test alone answers.
	//
	// ⚠ **THE RULE AND ITS DIAGNOSTIC ARE ONE FUNCTION**, `requireFieldIndex`'s shape and for its reason: the
	// only caller wants the entry, and "this case wrote nothing here" is the one thing to say when there is
	// none. See `enumBackingMissingFieldError` for why this copy throws rather than asserting — a file that
	// READS the enum can be parsed before the door that would have reported the gap.
	function requireEnumBackingEntryFilling(written EnumBackingFieldArray, group EnumBackingGroupId, step EnumBackingFieldStep, layout EnumLayout, index CaseIndex, anchor Token) returns EnumBackingEntryIndex throws SourceParseError
		for entry in 0 upto written.count() 'eachWrittenField'
			if enumBackingEntryFills(enumBackingEntryAt(written, entry: entry as EnumBackingEntryIndex), group: group, field: step.field, fieldName: step.fieldName) 'thisHop'
				return entry
			end 'thisHop'
		end 'eachWrittenField'

		// ⚠ **NOT `unknownField`, WHICH WOULD BE A FALSE SENTENCE.** The struct DOES declare this field —
		// `resolveEnumBackingLeaf` looked it up to get here — and what is missing is THIS CASE's value for it.
		// It was `unknownField` for one edit, and on `a = Meta{value: 1}  b = Meta{value: 2, cost: 5}` it said
		// *"type 'Meta' has no field named 'cost'"* about a type that declares `cost` on the line above.
		throw self.enumBackingMissingFieldError(step.ownerName, fieldName: step.fieldName, layout: layout, index: index, anchor: anchor)
	end 'requireEnumBackingEntryFilling'

	// The STRUCT a `structRecord` backing names, or the diagnostic that no file declares it. Refused HERE and
	// not at the declaration for the reason the whole backing is deferred: the case reader runs inside the
	// sweep that is still building the registry this asks.
	function requireEnumBackingStruct(layout EnumLayout, anchor Token) returns StructLayout throws SourceParseError
		let structName = try layout.backingStruct.typeName() otherwise panic("requireEnumBackingStruct: asked only of a `structRecord` backing, which is set together with the struct it names (`requireEnumBacking`)")

		match self.signatures.structInAnyFile(structName) 'declaring'
			declared(struct) then return struct
			undeclared then throw SourceParseError.undefinedVariable(String.from(structName), line: anchor.line, column: anchor.column)
		end 'declaring'
	end 'requireEnumBackingStruct'

	// ⭐ **THE NUMBER ONE WRITTEN FIELD VALUE DENOTES.** A literal already folded to its bits at the
	// declaration; an enum-member reference is the one form that could not, because a case's TAG is a
	// whole-program fact (see `EnumBackingFieldValue.enumCase`).
	//
	// ⚠ **AND A NESTED CONSTANT DENOTES NO NUMBER AT ALL, WHICH IS A DIAGNOSTIC AND NOT AN ASSERTION.** It
	// arrives only when the case wrote a record where the field's DECLARED type is a scalar — which
	// `requireEnumBackingFieldValueSuitsField` refuses at the declaration, in a fuller sentence. It is not
	// asserted here for the reason `enumBackingUnsupportedFieldError` records: a file that READS the enum can
	// be parsed before the one that declares it, so the door may not have run yet.
	function enumBackingFieldNumber(value EnumBackingFieldValue, step EnumBackingFieldStep, domain EnumBackingFieldDomain, anchor Token) returns FullRangeInt throws SourceParseError
		match value 'form'
			literal(bits, kind) then return enumBackingLiteralBits(bits, kind: kind, domain: domain)
			enumCase(enumName, caseName) then return try self.enumBackingFieldCaseTag(enumName, caseName: caseName, anchor: anchor)
			nestedStruct(structName) then throw SourceParseError.unsupported("a nested `{String.from(structName)}` constant written for field '{String.from(step.fieldName)}' of the `{String.from(step.ownerName)}` backing, which this read selects as a single word — a nested constant fills a field whose OWN declared type is that `type`, and this field's is not, so there is no number for the select to take", line: anchor.line, column: anchor.column)
		end 'form'
	end 'enumBackingFieldNumber'

	// `Priority.low` as a backing field value — the two names the declaration recorded, resolved against the
	// completed index. Both failures are the ordinary ones a `Priority.low` written in an EXPRESSION would
	// get, worded by the same two constructors, so a typo in a backing reads like a typo anywhere else.
	function enumBackingFieldCaseTag(enumName ByteArray, caseName ByteArray, anchor Token) returns FullRangeInt throws SourceParseError
		let referenced = self.signatures.enumFor(enumName, readerFilePath: self.job.path)

		if not enumMatchIsDeclared(referenced) 'noSuchEnum'
			throw SourceParseError.undefinedVariable(String.from(enumName), line: anchor.line, column: anchor.column)
		end 'noSuchEnum'

		let referencedLayout = requireEnumLayout(referenced)

		if not referencedLayout.hasCase(caseName) 'noSuchCase'
			throw SourceParseError.enumUnknownCase(referencedLayout.kindWord(), caseName: String.from(caseName), line: anchor.line, column: anchor.column)
		end 'noSuchCase'

		// The TAG, not the ordinal — an enum value IS its tag (`parseEnumLiteral`), so this is the same 64 bits
		// the source expression `Priority.low` would have emitted, and a `.ordinal` chained onto the selected
		// value reaches the ordinary accessor with the ordinary tag.
		return referencedLayout.tagOfCase(caseName)
	end 'enumBackingFieldCaseTag'

	// The `.rdata` record address of `bytes`, as an `integer`-typed word the sum can multiply — the two STRING
	// columns' half of the retype `emitEnumCaseConstant`'s header argues for, and the twin of
	// `emitEnumCaseFunctionConstant` below. Two producers rather than one shared tail because the columns mint
	// their word through different emitters, and the retype's safety argument is about the value each one has
	// just minted.
	function emitEnumCaseStringConstant(bytes immutable ByteArray, range SourceRange) returns ValueId
		let literal = self.emitStringLiteral(bytes, range: range)
		self.retypeValue(literal, valueType: MaxonType.integer)
		return literal
	end 'emitEnumCaseStringConstant'

	// Case `index`'s backing function as an `integer`-typed word the sum can multiply — its `__fnref_` thunk
	// address, minted by the ONE producer of a function value (see `emitEnumCaseConstant`'s header for why it
	// must be that producer and not a constant). It is the function column's half of the retype above rather
	// than a share of it, because the two columns mint their word through different emitters and the retype's
	// safety argument is about the value each one just minted. The declaration already asked whether the name
	// stands as a function value (`caseFunctionName`), in the file that may name it.
	function emitEnumCaseFunctionConstant(layout EnumLayout, index CaseIndex, anchor Token) returns ValueId
		let reference = self.emitFunctionRefOp(self.enumCaseFunctionName(layout, index: index), anchor: anchor)
		self.retypeValue(reference, valueType: MaxonType.integer)
		return reference
	end 'emitEnumCaseFunctionConstant'

	// ⭐ **`<arrayBinding> . managed . <member>(` — the CHAINED spelling, for the two positions where a bare
	// `arr.managed` denotes nothing a program can want.** A STATEMENT of it would build a buffer reference and
	// discard it on the same line; a `try` TARGET needs a throwing CALL to be the target at all, and a bare
	// `.managed` throws nothing. Both would be accepted-and-useless under the widened rule, so both ask for
	// the member call and the EXPRESSION door (`parseDottedPrimary`) asks the rule itself.
	//
	// It is the widened predicate `and` one conjunct rather than a second copy of the base/scope/element
	// tests: the day the base rule changes, there is one place it changes.
	function arrayManagedMemberCallAt(index ElementIndex) returns bool
		return self.arrayManagedFieldAt(index) and self.memberCallFollows(index + 3)
	end 'arrayManagedMemberCallAt'

	function methodCallsAt(index ElementIndex) returns bool
		// The BASE is anything `tokenCanBeAName` admits, which subsumes both the identifier and the `self`
		// keyword, and adds a KEYWORD-named binding (`type.method()` where `type` is a parameter). Widening
		// it claims no new program on its own: the SCOPE test below is the
		// predicate (see the header), and a keyword only ever names a binding because a declaration made it one.
		if not tokenCanBeAName(self.tokenAt(index)) 'notABase'
			return false
		end 'notABase'

		// The `. <member> (` TAIL asks the shared `memberCallFollows`, which spells the member half through
		// `namesMemberAt` and so admits a keyword-named member — `c.to()` routes here rather than falling
		// through to the type-bound reading, exactly as `c.next()` does. It is the same predicate the chain
		// walk and every other `<base> . <member> (` dispatcher read, for their stated reason.
		if not self.memberCallFollows(index + 1) 'notADottedCall'
			return false
		end 'notADottedCall'

		// A LOCAL receiver, a CAPTURED enclosing one (`b.doubled()` inside a closure), or a
		// top-level MANAGED BINDING (`Live.count()`; `msg.append("!")`). Each is a
		// VALUE the method dispatches on, which is what separates it from a static call on a TYPE name. The
		// managed binding is asked LAST because it is the only one of the three that can allocate (see
		// `managedTopLevelBaseAt`), and a local or captured base has already answered by then.
		//
		// ⚠ **THAT ORDER IS ALSO THE SHADOWING RULE, AND IT MUST MATCH `parseMethodCall`'S ARMS EXACTLY.**
		// Cheapest-first and local-then-capture-then-top-level happen to agree here, which is what makes the
		// agreement easy to break: a reorder for cost alone would silently re-point a name that a closure
		// captures at a same-named global. `parseMethodCall` carries the measurement of what that cost —
		// two resolutions of one name in one expression, neither a compile error.
		//
		// ⚠ The managed binding is ALSO the only one of the three whose name can belong to a declared
		// TYPE as well — which is why it, alone, has to weigh itself against the type-based readings of
		// this same shape (`moduleLevelBindingHeadsAt`) rather than simply claiming it.
		let baseTok = self.tokenAt(index)

		if self.baseNamesAValueAt(index) 'localOrCaptured'
			return true
		end 'localOrCaptured'

		// The GATE first and the resolution second, in that order and never fused: the gate is a bool and
		// allocates nothing, and everything past it boxes a union (see `managedTopLevelBaseAt`). A
		// LOOKAHEAD can only answer yes/no anyway — it runs at token shapes the parser has not committed
		// to, so there is nowhere to hand a resolution even if it had one.
		if not self.managedTopLevelBaseAt(index) 'notAManagedBase'
			return false
		end 'notAManagedBase'

		return match self.managedReceiverBindingOf(baseTok) 'managed'
			constant or
			global or
			inlineWord or
			imageRecord or
			imageBox gives true
			none or
			poisoned gives false
		end 'managed'
	end 'methodCallsAt'

	function namesTheStatementOnlyOwnedStatic(index ElementIndex) returns bool
		if not self.tokenAt(index).value.equals(compilerOwnedSurfaceTypeName(HandleSurface.file)) 'notTheFileSurface'
			return false
		end 'notTheFileSurface'

		return match compilerOwnedStaticNamed(HandleSurface.file, member: self.tokenAt(index + TokensPerQualifierSegment).value) 'lookup'
			found(kind) gives kind == CompilerOwnedStatic.fileStatFree
			notAStatic gives false
		end 'lookup'
	end 'namesTheStatementOnlyOwnedStatic'

	// **The token shape of A STATIC CALLED ON A LINE OF ITS OWN** — `<type> . <member> (`, the qualified call
	// shape that IS a statement. Four families reach it: `__ManagedFile.statFree(buffer)`, the `__Builtins`
	// intrinsics, the `__DebugStream` members, and any member written on a base a `type` declaration names —
	// whether that member returns a value, returns nothing, or resolves to nothing at all. The last two are
	// downstream questions: a result nobody took is E3064/E3065 at the dispatch site, an unresolved member is
	// `parseCallNamed`'s E3004.
	//
	// It asks the intrinsic table's OWN question, `isBuiltinsIntrinsicCallee`, of the name `parseQualifiedCall`
	// is about to mangle out of these same two tokens — rather than comparing the base token against a second
	// spelling of `__Builtins`. A second spelling is how the statement door and the intrinsic table would come
	// to disagree about which qualifier belongs to the compiler, and the failure would be silent in the worst
	// direction: a statement accepted here and then rejected as an unknown intrinsic three functions later.
	//
	// ⚠⚠ **THE NAME IS BUILT BY THE SAME EXPRESSION `parseQualifiedCall` USES — `genericAliasKeyFor` AND
	// `denotedGenericBaseName`, BOTH — and neither call is decoration.** Deriving the callee here from the
	// BARE base token agrees with the real parse only for as long as those two are jointly the identity on
	// every name that can reach this shape, and that premise does not hold: `parseQualifiedCall` reads an
	// INNER alias under its base-qualified key, so a door that skipped it would make one written name mean
	// two things. Both doors read the one key instead. Two derivations of one name is the duplication this
	// predicate was written to avoid.
	//
	// The mangling allocates, and it is on a COLD path by construction: the shape is asked only after every
	// cheaper statement form has declined, and `methodCallsAt` has already claimed every qualified shape whose
	// base is a value in scope — so what reaches here is a static-call-shaped statement and nothing else.
	//
	// ⚠⚠ **`__ManagedFile.statFree(buffer)` IS THE SECOND FAMILY, AND WITHOUT IT `stat` COULD NOT BE USED AT
	// ALL.** It is the only `__ManagedFile` static that is BOTH void and NON-throwing, so a statement is the
	// only position it can ever be written in — the void-and-throwing pair (`delete`/`rename`) always
	// arrives under a `try`, which is its own statement form. Left out, the canonical spelling
	// `stdlib/File.maxon:186` uses verbatim dies as `E2015: Unsupported: identifier statement` — and since
	// `stat` hands back a raw `__mm_alloc` block that only `statFree` can release, EVERY successful `stat`
	// then leaks it and the program exits 101. `__Builtins.sleep` is the same shape for the same structural
	// reason — see the arm: a VOID member of a family whose other members all return a value.
	//
	// ⚠ **THE MEMBER HALF ASKS `namesMemberAt`, NOT A RAW `TokenKind.identifier`.** A static may be
	// DECLARED under a keyword — `export static function to()` — and expression position calls it
	// (`let x = Helper.to()` compiles and runs, measured). A raw kind test here would refuse the identical name in
	// STATEMENT position as `E2015: Unsupported: identifier statement` while the oracle compiled and ran it,
	// which is the asymmetry this door removes, one level down. It
	// is asked through `memberCallFollows` — the ONE spelling of the `. <member> (` tail that `methodCallsAt`,
	// `isSelfMethodCallAt` and `primitiveStaticCallAt` also read — so a new member-naming token is taught to
	// every dispatcher at once rather than to three of four.
	//
	// The BASE half stays a plain identifier because a keyword cannot NAME a *declared* type: `type to` is
	// refused at its declaration (`E2010: Expected identifier but got 'to'`). `parseQualifiedCall` reads
	// its base through `typeBaseTokenAt`, which resolves two keywords — `Self` and the
	// primitive-type names — so widening this half would claim a shape the routine CAN parse but the ORACLE
	// refuses outright: `Self.m()` and `int.fromString(s)` on a line of their own are `E2001 unexpected
	// token` there (measured, both), so keeping them off this door is what keeps the two compilers agreeing
	// about which statements exist.
	function qualifiedStaticCallsAt(index ElementIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier or not self.memberCallFollows(index + 1) 'notAQualifiedCall'
			return false
		end 'notAQualifiedCall'

		if self.namesTheStatementOnlyOwnedStatic(index) 'statFree'
			return true
		end 'statFree'

		// The base name is resolved ONCE and threaded to both readings below — the callee mangle and the
		// declared-type claim. `denotedGenericBaseName` is a registry lookup that can allocate, and two calls
		// on one token are two derivations of one name, which is the drift this predicate's header is about.
		//
		// ⛔ **THROUGH `genericAliasKeyFor`, AND THE HEADER'S OWN PREMISE IS WHY.** That premise —
		// *"agrees with the real parse only for as long as `denotedGenericBaseName` is the identity on every name
		// that can reach this shape … exactly the kind of premise that quietly stops holding"* — does not hold
		// once `parseQualifiedCall` resolves an INNER alias under its base-qualified key. Reading
		// the bare member here would make THIS door the fifth reader of "which registration does this spelling
		// denote", and the two doors would then disagree about one written name. MEASURED on one binary: with
		// `typealias IntPair = Pair with ExitCode` at FILE scope, `IntPair.shout()` as a statement compiled and
		// ran; with the identical alias declared INSIDE the calling type it was
		// `E2015: Unsupported: identifier statement`, while `let p = IntPair.create(9)` one line below resolved
		// perfectly — a call accepted at one door and refused at the other, which is the exact failure this
		// predicate's header names. `staticCallClaimsBase` asks the same key for the same reason.
		let baseTok = try self.typeBaseTokenAt(index) otherwise panic("qualifiedStaticCallsAt: typeBaseTokenAt refused the identifier at {index}, and it refuses only a base that is not a name")
		let aliasName = self.genericAliasKeyFor(baseTok.value)
		let callee = self.denotedStaticCallee(aliasName, member: self.tokenAt(index + 2).value, nameReader: self.job.path)

		// ⭐ **THE COMPILER'S QUALIFIED FAMILIES — `__Builtins`, `__Raw`, `__DebugStream` — ARE CLAIMED WHOLE.** Their
		// void members (`__Builtins.sleep`, `__Raw.storeWord(addr, 0, v)`, `TraceEvents.logEvent`'s `__DebugStream`
		// emitters) answer nothing, so a bare statement is the only position they can be written in.
		//
		// ⚠ **THE QUALIFIER IS THE TEST, NOT A ROSTER OF THE VOID ROWS**: claiming the family routes an unrecognized or
		// out-of-tier member to `parseCallNamed` and its positioned refusal that names it (`E3004`, or `E3152` for a
		// `__Raw.osTickCountMs()` statement in user code), instead of `E2015: Unsupported: identifier statement`.
		// `__DebugStream.nameId` is claimed too and its value discarded; an intrinsic allocates nothing, so no box is stranded.
		if isCompilerQualifierCallee(callee) 'compilerQualifier'
			return true
		end 'compilerQualifier'

		// ⭐⭐ **A USER TYPE'S STATIC — THE BASE NAMING A DECLARED TYPE IS THE WHOLE CONDITION, and what the
		// member returns is the DISCARD door's question rather than this one's.** A value-returning static
		// written here is E3064 (pure) or E3065 (impure) at the dispatch site, so the program is refused and
		// no returned box is ever stranded; narrowing this to `void` would only trade those verdicts for
		// E2015, which says the compiler does not lower the shape — and it does. MEASURED against the
		// oracle, which answers the same two codes at the same two columns.
		//
		// ⚠ **AN UNKNOWN MEMBER ON A DECLARED TYPE IS CLAIMED BY THE SAME TEST, so it is refused by NAME
		// rather than by shape**: `Helper.nope()` reaches `parseCallNamed` and earns the positioned
		// **E3004 `call to undefined function 'Helper.nope'`** — the identical answer EXPRESSION position
		// gives for the same typo. That is why the test is the BASE and never a roster of members, which is
		// `isDebugStreamCallee`'s rule one type over.
		//
		// ⚠ **AN `enum`/`union` BASE NEEDS NO ARM OF ITS OWN**: The compiler refuses `static function` on either at
		// its DECLARATION, so no declared static can have one for a base.
		//
		// **IT READS A COMPLETE INDEX, AND THE REASON IS NOT `constructorInstanceOf`'S.** That one is written
		// for a reader the TOLERANT SWEEP reaches, and answers "the sweep's artifact is discarded". This
		// predicate is not such a reader: the sweep entry point is `foldDeclaredSignaturesInto`, which reads
		// DECLARATIONS only and never a body — "a sweep types no call", as `Queries.queryProgramSignatures`
		// puts it — and an initializer parse reads an EXPRESSION, never a statement. `parseStatement` is reached
		// from `parseModule` alone, and `queryProgramSignatures` sets `allFilesFolded` before the first file
		// is parsed. So a `false` here MEANS no file declares a type of that name; it never means "not swept
		// yet".
		if self.signatures.declaresADefault() and self.registryCallAt(index) 'aRegistryCall'
			return true
		end 'aRegistryCall'

		let resolved = self.resolveStaticMember(baseTok, baseIndex: index, aliasName: aliasName)

		// A refusal or a requirement is claimed so the statement earns that diagnostic rather than a shape
		// one; a directory function is left to the `namespaceQualifiedCallStmt` arm.
		let claimed = match resolved 'member'
			requirement or
			refused gives true
			directory gives false
			surface or
			minted or
			named gives self.signatures.containsStructFor(self.signatures.denotedGenericBaseName(aliasName, readerFilePath: self.job.path), readerFilePath: self.typeNameReaderAt(index))
		end 'member'

		self.statement.handedResolution = HandedResolution.handed(index, resolution: resolved.clone()) if claimed else NothingHanded

		return claimed
	end 'qualifiedStaticCallsAt'

	// The kind of the token ONE past the cursor. The parser's two-token lookahead:
	// distinguishing a reassignment (`ident =`) from a bare identifier statement (`ident …`)
	// needs to see the `=` without committing to consuming the identifier first — and it is
	// the same question `buildWriteSiteIndex` asks of every token in the file, which is why
	// both read it through `kindAt` and the past-the-end rule lives in exactly one place.
	function peekKind() returns TokenKind
		return self.kindAt(self.pos + 1)
	end 'peekKind'

	function isEof() returns bool
		return self.at(TokenKind.eof)
	end 'isEof'

	function advance()
		if self.pos < self.tokens.count() 'inRange'
			self.pos = self.pos + 1
		end 'inRange'
	end 'advance'

	// Consume a token of the expected kind, or throw a positioned mismatch error.
	// A TokenKind's `.rawValue` is its human-readable display text ("(", "return").
	// ⭐⭐ **THE ONE-CONSTRUCT-PER-LINE RULE, ASKED AFTER EVERY BLOCK LABEL, STATEMENT AND MATCH ARM AND
	// RESTATED BY NONE OF THEM.** `while i < 1 'w' i = i + 1 end 'w'` is refused at its label, and a rule
	// spelled at every opener is a rule that drifts at all but one of them.
	function requireLineEndAfter(construct LineEndingConstruct) throws SourceParseError
		if tokenKindEndsALine(self.kindAt(self.pos)) 'endsItsLine'
			return
		end 'endsItsLine'

		throw lineSharedRefusal(construct, got: self.current())
	end 'requireLineEndAfter'

	function consume(kind TokenKind) returns Token throws SourceParseError
		let tok = self.current()

		if tok.kind != kind 'mismatch'
			throw SourceParseError.unexpectedToken(kind.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'mismatch'

		self.advance()
		return tok
	end 'consume'

	// ⭐ **CONSUME A TOKEN IN A POSITION WHERE ONLY A NAME MAY STAND** — a declaration's name, a
	// parameter's name, a callee/method name, an enum case name. An identifier, or a KEYWORD spelled there
	// (`function from(…)`, `FilePath.from(…)`): see `tokenCanBeAName` for why the POSITION is what licenses
	// the keyword, and `keyword-as-a-declared-name.md` for the rule.
	//
	// `position` says what the mismatch diagnostic names, because the positions differ in what they are
	// ASKING for and not in what they accept — `'identifier'` for a declaration or a callee (the E2010 text
	// the spec corpus pins), `an enum case name` for a case. ONE reader, so a position taught to admit a
	// keyword cannot be one a sibling still refuses. ⚡ It is an ENUM and not the rendered text: see
	// `NamePosition` for the measurement that says why.
	function consumeNameToken(position NamePosition) returns Token throws SourceParseError
		let tok = self.current()

		if not tokenCanBeAName(tok) 'notAName'
			throw SourceParseError.unexpectedToken(nameExpectationOf(position), got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notAName'

		self.advance()
		return tok
	end 'consumeNameToken'

	function staticBaseTokenAt(index ElementIndex) returns Token throws SourceParseError
		let tok = self.tokenAt(index)

		if self.qualifiedTypeBaseIsAt(index) or tok.kind == TokenKind.identifier or tokenIsTheSelfType(tok) or keywordNamesAPrimitiveType(tok) 'aTypeNameBase'
			return try self.typeBaseTokenAt(index)
		end 'aTypeNameBase'

		return tok
	end 'staticBaseTokenAt'

	// ⭐⭐ **THE TOKEN NAMING A TYPE AT `index`, WITH `Self` ALREADY RESOLVED TO THE NAME IT DENOTES** —
	// `consumeNameToken`'s sibling for the other half of a dotted expression: that one reads the MEMBER, this
	// one reads the BASE. It is the ONE place the `Self` keyword becomes the enclosing declaration's own name
	// in an expression, and it is a token REWRITE rather than a flag every reader would have to test.
	//
	// ⭐ **THAT IS WHY THERE IS NO `Self` DISPATCHER.** `Self.off` inside `enum Toggle` IS `Toggle.off` and
	// `Self.make(v)` inside `type Box` IS `Box.make(v)`, so the two spellings converge HERE — at the single
	// token every type-named form reads its base through — and every arm downstream (`parseDottedPrimary`'s
	// enum-case and static-call split, `parseQualifiedCall`'s callee mangling, `parseEnumLiteral`, the struct
	// literal, the type-qualified bound) answers for both without knowing the keyword exists.
	//
	// The rewritten token keeps the `Self` token's line, column and source SPAN, so a diagnostic still
	// points at what the author wrote while NAMING the type it means. It is `identifier`-kinded for
	// `memberNameTokenAt`'s reason: the token is a NAME now, and no later reader may re-decide it was
	// a keyword.
	//
	// ⚠ **IT MOVES NO CURSOR**, because the two askers need different things from it: `parseDottedPrimary`
	// PEEKS to pick an arm, and the arm it picks then consumes the base itself.
	function typeBaseTokenAt(index ElementIndex) returns Token throws SourceParseError
		let tok = self.tokenAt(index)

		if self.qualifiedTypeBaseIsAt(index) 'theQualifiedBase'
			return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: self.qualifiedTypeBaseName(), startByte: tok.startByte, endByte: tok.endByte)
		end 'theQualifiedBase'

		if tok.kind == TokenKind.identifier 'plainTypeName'
			let identity = self.signatures.bareWrittenKey(tok.value, readerFilePath: self.job.path)

			if identity.equals(tok.value) 'itsWrittenNameIsItsIdentity'
				return tok
			end 'itsWrittenNameIsItsIdentity'

			return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: identity, startByte: tok.startByte, endByte: tok.endByte)
		end 'plainTypeName'

		// ⭐ **`int`/`float`/`bool` NAME TYPES HERE TOO — the SECOND keyword this reader resolves,
		// and it arrives by exactly `Self`'s argument.** A primitive keyword in a dotted base position can
		// only be the type it spells, so it becomes an identifier-kinded token carrying that spelling and
		// every arm downstream — the enum split, `parseQualifiedCall`'s mangle, the type-qualified bound —
		// serves it without learning that a keyword got here. Its line, column and source span are the
		// keyword's own, so a diagnostic still points at what the author wrote; `identifier`-kinded for the
		// reason the `Self` rewrite below is, that the token is a NAME now.
		//
		// ⚠ **A NON-CALL PRIMITIVE BASE ARRIVES TOO, AND IT READS NO BOUND.** Expression position
		// (`parsePrimary`) routes `<primitive> . <member>`, so `int.max` reaches this reader and is refused as
		// a member `int` lacks (E2073): the language has no `int.max` bound.
		if keywordNamesAPrimitiveType(tok) 'primitiveTypeName'
			return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: tok.value, startByte: tok.startByte, endByte: tok.endByte)
		end 'primitiveTypeName'

		// Anything else is the mismatch `consume(TokenKind.identifier)` reported before this reader existed,
		// on the same token and in the same words — a base position admits a type NAME and the one keyword
		// that stands for one, and nothing else.
		if not tokenIsTheSelfType(tok) 'notATypeName'
			throw SourceParseError.unexpectedToken(TokenKind.identifier.rawValue, got: tokenDisplayText(tok), line: tok.line, column: tok.column)
		end 'notATypeName'

		// The name is bound before the call rather than passed inline: a `try` expression in this
		// argument position does not lower (`E9001 … not in valueMap; assigning to '__arg_pin_7'`).
		let denoted = try self.requireEnclosingTypeName(tok)
		return Token.create(TokenKind.identifier, line: tok.line, column: tok.column, value: denoted, startByte: tok.startByte, endByte: tok.endByte)
	end 'typeBaseTokenAt'

	// The type-naming token at the cursor, consumed — `typeBaseTokenAt` plus the advance, split for the
	// reason `consumeMemberNameToken` is split from `memberNameTokenAt`.
	function consumeTypeBaseToken() returns Token throws SourceParseError
		let index = self.pos
		let tok = try self.typeBaseTokenAt(index)
		self.advance()

		if not self.qualifiedTypeBaseIsAt(index) 'writtenBare'
			try self.requireUnambiguousBaseName(self.tokenAt(index) if self.kindAt(index) == TokenKind.identifier else tok)
		end 'writtenBare'

		return tok
	end 'consumeTypeBaseToken'

	function qualifiedTypeBaseIsAt(index ElementIndex) returns bool
		return match self.statement.qualifiedTypeBase 'qualified'
			none gives false
			at(baseIndex, _, _) gives baseIndex == index
		end 'qualified'
	end 'qualifiedTypeBaseIsAt'

	function qualifiedTypeBaseName() returns immutable ByteArray
		let base = self.statement.qualifiedTypeBase

		return match base 'qualified'
			none panic("Parser.qualifiedTypeBaseName: no namespace-qualified type base was entered — every caller asked `qualifiedTypeBaseIsAt` first")
			at(_, name, _) gives name
		end 'qualified'
	end 'qualifiedTypeBaseName'

	function qualifiedTypeBaseFile() returns FilePath
		return match self.statement.qualifiedTypeBase 'qualified'
			none panic("Parser.qualifiedTypeBaseFile: no namespace-qualified type base was entered — every caller asked `qualifiedTypeBaseIsAt` first")
			at(_, _, declFilePath) gives declFilePath
		end 'qualified'
	end 'qualifiedTypeBaseFile'

	function primitiveNameIsOnlyDeclaredOutOfSight(name ByteArray) returns bool
		return namesAPrimitiveType(name) and self.signatures.allFilesFolded and self.signatures.typeNameHidingFrom(name, readerFilePath: self.job.path).isHidden()
	end 'primitiveNameIsOnlyDeclaredOutOfSight'

	function requireUnambiguousBaseName(tok Token) throws SourceParseError
		if self.namesEnclosingType(tok.value) or self.enclosingTypeParams.contains(tok.value) or self.namesInnerAliasHere(tok.value) or self.primitiveNameIsOnlyDeclaredOutOfSight(tok.value) 'aNearerScopeNamesIt'
			return
		end 'aNearerScopeNamesIt'

		try self.requireUnambiguousTypeName(tok.value, anchor: tok)
	end 'requireUnambiguousBaseName'

	// Advance the cursor past any newlines — `indexPastNewlines` applied to the cursor, so the MOVER and the
	// LOOKAHEAD read one definition of "which tokens are layout" rather than two copies of it.
	function skipNewlines()
		self.pos = self.indexPastNewlines(self.pos)
	end 'skipNewlines'

	// The first index at or after `index` that the GRAMMAR reads — the LOOKAHEAD form, moving no cursor,
	// and the one definition `skipNewlines` above is derived from. The layout it meets lies between
	// statements, members and arms: inside a bracket the lexer has already dropped it
	// (`Lexer.dropBracketedLayout`). `tokenAt` answers `eof` past the end, so this terminates.
	//
	// ⭐ **WHICH KINDS ARE LAYOUT IS `Lexer.tokenKindIsSkippedLayout`'s TO SAY, NOT THIS LOOP'S** — a `///`
	// doc comment is a token in this lexer (the formatter round-trips it and the LSP maps a cursor into it)
	// and the grammar reads it no more than it reads a newline. Spelled out here, the set would have to be
	// spelled again in every raw-stream walk that re-derives the same skip, and a walk admitting one kind
	// and not the other would count a construct the real parse steps over.
	function indexPastNewlines(index ElementIndex) returns ElementIndex
		var scan = index

		while tokenKindIsSkippedLayout(self.kindAt(scan)) 'skip'
			scan = scan + 1
		end 'skip'

		return scan
	end 'indexPastNewlines'

	// Consume an optional block label (`'name'`, a charLiteral) after `end`.
	function skipOptionalLabel()
		if self.at(TokenKind.charLiteral) 'label'
			self.advance()
		end 'label'
	end 'skipOptionalLabel'
end 'Parser'
