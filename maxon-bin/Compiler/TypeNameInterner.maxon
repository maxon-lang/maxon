// TypeNameInterner — the id ↔ name table behind `MaxonType.named(TypeNameId)`.
//
// The parser never stores a type-name String on an op; it interns the name into
// this table and stores the resulting `TypeNameId` (a single integer). Identical
// named references (`ExitCode` used twice) share one id, so structural type
// identity is a single integer compare and the name backing is stored once.
//
// PARSE-STAGING (parallel-ready): each `FileParseArtifact` owns its OWN local
// interner, populated during that file's parse — so a file's parse touches no
// shared state (see ParseStaging.maxon). `mergeArtifact` folds a file's local
// interner into the project's interner in source-path order (`foldInto`),
// returning a `TypeIdRemap` from the file-local ids to the project-global ids
// it was assigned, which the merge then applies to the file's ops and registry
// contributions. For M1 (one file, one named type `ExitCode`) the project
// interner starts empty, so the fold assigns identical ids and the remap is the
// identity — but the machinery is real, not a placeholder.

// Wide range: the interner is unbounded (one id per distinct named reference).
// `TypeNameIdArray` is declared beside `TypeNameId` itself, in `IR/Maxon/MaxonDialect.maxon`; the flat
// namespace check refuses a second identical declaration here.
export typealias TypeNameIdMap = Map with (ByteArray, TypeNameId)

// Raised when a `TypeNameId` is looked up that this interner never assigned —
// always a compiler bug (an id must come from the same interner it is resolved
// against), never user input.
export union TypeNameInternerError implements Error
	unknownId(id TypeNameId)

	// `idOf` was asked for a name this interner never saw — an ANSWER ("no type of that name has been
	// interned"), not a bug, unlike `unknownId`.
	unknownName(name ByteArray)
end 'TypeNameInternerError'

export type TypeNameInterner
	// id -> name (index is the TypeNameId). Each name is a view the interner owns over the bytes it was interned
	// from — no copy of them until a thread crossing detaches it.
	var names as ByteArrayArray

	// name -> id, for O(1) interning of an already-seen name.
	var ids as TypeNameIdMap

	// How many names the interner held when the signature index was settled. Only the index's own interner is
	// ever settled; every other interner keeps 0 and never restores.
	var baselineCount as TypeNameId

	// ⭐ **ID 0 IS THE EMPTY NAME, IN EVERY INTERNER.** `UnnamedTypeId` is the filler a scalar's slot and an
	// unbranded value's slot carry, and interning the empty name first is what makes that filler a NAME
	// rather than a collision with whichever real name a file happened to intern first. `foldInto` then
	// maps it to itself, so a remap needs no special case for it either.
	export static function create() returns TypeNameInterner
		var interner = Self{names: ByteArrayArray.create(), ids: TypeNameIdMap.create(), baselineCount: 0}
		_ = interner.intern(EmptySourceText)
		return interner
	end 'create'

	export function settleBaseline()
		self.baselineCount = names.count()
	end 'settleBaseline'

	// Copies of the names interned since the baseline, in id order: the one at position `k` holds id `baselineCount + k`.
	// Copies, because a restore does not release every record this interner took: a removed map key may stay in its slot.
	export function namesSinceBaseline() returns ByteArrayArray
		var added = ByteArrayArray.create()

		for id in self.baselineCount upto names.count() 'eachAdded'
			added.push((try names.get(id) otherwise panic("TypeNameInterner.namesSinceBaseline: names.get OOB at {id}")).clone())
		end 'eachAdded'

		return added
	end 'namesSinceBaseline'

	export function restoreBaseline()
		for id in self.baselineCount upto names.count() 'eachAdded'
			_ = ids.remove(try names.get(id) otherwise panic("TypeNameInterner.restoreBaseline: names.get OOB at {id}"))
		end 'eachAdded'

		names.truncate(self.baselineCount as ElementIndex)
	end 'restoreBaseline'

	export function baselineNameCount() returns TypeNameId
		return self.baselineCount
	end 'baselineNameCount'

	export function noteFingerprint(fingerprint IndexFingerprint, group String)
		fingerprint.openGroup(group)
		fingerprint.note("names", value: names.count())
		fingerprint.note("ids", value: ids.count())
		fingerprint.closeGroup()
	end 'noteFingerprint'

	// Intern `name`, returning its stable id. Idempotent: a name already present
	// returns its existing id without appending a duplicate.
	export function intern(name ByteArray) returns TypeNameId
		if let existing = try ids.get(name) 'seen'
			return existing
		end 'seen'

		// A VIEW of its own over the caller's bytes: an artifact's interner is handed names the worker's private
		// index holds, and a record both held would give the artifact an owner outside it when it crosses back.
		let owned = name.clone()
		let id = names.count()
		names.push(owned)
		ids.upsert(owned, value: id)
		return id
	end 'intern'

	// Resolve an id back to its name. Throws for an id this interner never
	// assigned (a compiler bug — see TypeNameInternerError).
	export function nameOf(id TypeNameId) returns ByteArray throws TypeNameInternerError
		return try names.get(id) otherwise throw TypeNameInternerError.unknownId(id)
	end 'nameOf'

	// Resolve a NAME to its id WITHOUT interning it — the read-only half of `intern`, for a caller
	// that has a name and needs the id some id-keyed index is filed under (the generic-instance
	// registry's by-base buckets). It must be separate from `intern`: interning on a miss APPENDS,
	// which moves `count()` and every id assigned after it, and those ids reach the emitted mangling —
	// so a mere lookup by a caller holding a name that is not a type would silently rewrite output.
	// Unlike `nameOf`'s, this throw is not a compiler bug: "no such type name" is a legitimate answer.
	export function idOf(name ByteArray) returns TypeNameId throws TypeNameInternerError
		return try ids.get(name) otherwise throw TypeNameInternerError.unknownName(name)
	end 'idOf'

	export function count() returns TypeNameId
		return names.count()
	end 'count'

	// Fold every name of `source` (a file-local interner) into `self` (the project interner) in id order,
	// returning the renumbering from each source id to the id it was assigned in `self`.
	export function foldInto(source TypeNameInterner) returns TypeIdRemap
		var mapping = TypeNameIdArray.create()

		for srcId in 0 upto source.names.count() 'each'
			let name = try source.names.get(srcId) otherwise panic("foldInto: source.names.get OOB at {srcId}")
			mapping.push(self.intern(name))
		end 'each'

		return TypeIdRemap.create(mapping, namesBase: 0, instances: GenericInstanceIdMap.create())
	end 'foldInto'
end 'TypeNameInterner'

export typealias GenericInstanceIdMap = Map with (GenericInstanceId, GenericInstanceId)

// ⭐ **ONE RENUMBERING OF A SET OF TYPE IDS, NAMES AND INSTANCES TOGETHER.** A name id at or above `namesBase`
// moves to `names[id - namesBase]` and one below it stays; an instance id `instances` holds moves to what it
// maps to and every other stays. A file interner's fold moves every name from 0, the signature index's moves
// only what a parse interned past its baseline, and a merge moves a parse's own instance rows.
export type TypeIdRemap
	var names as TypeNameIdArray
	let namesBase as TypeNameId
	var instances as GenericInstanceIdMap

	export static function create(names TypeNameIdArray, namesBase TypeNameId, instances GenericInstanceIdMap) returns TypeIdRemap
		return Self{names: names, namesBase: namesBase, instances: instances}
	end 'create'

	// Moves no id. Its name renumbering starts past every id an interner can hand out.
	export static function unmoved() returns TypeIdRemap
		return Self{names: TypeNameIdArray.create(), namesBase: i64.max, instances: GenericInstanceIdMap.create()}
	end 'unmoved'

	// This remap's name renumbering with `moved` as its instance renumbering.
	export function movingInstances(moved GenericInstanceIdMap) returns TypeIdRemap
		return TypeIdRemap.create(self.names, namesBase: self.namesBase, instances: moved)
	end 'movingInstances'

	// Does any id move? A remap that moves none is skipped whole by the merge.
	export function movesAnything() returns bool
		if self.instances.count() != 0 'instancesMove'
			return true
		end 'instancesMove'

		var unmovedId = self.namesBase

		for target in self.names 'eachName'
			if target != unmovedId 'aNameMoves'
				return true
			end 'aNameMoves'

			unmovedId = unmovedId + 1
		end 'eachName'

		return false
	end 'movesAnything'

	export function applyName(id TypeNameId) returns TypeNameId
		if id < self.namesBase 'belowTheRenumbering'
			return id
		end 'belowTheRenumbering'

		return try self.names.get(id - self.namesBase) otherwise panic("TypeIdRemap.applyName: id {id} is past the {self.names.count()} names this remap renumbers from {self.namesBase}")
	end 'applyName'

	export function applyInstance(id GenericInstanceId) returns GenericInstanceId
		return try self.instances.get(id) otherwise id
	end 'applyInstance'
end 'TypeIdRemap'

// Rewrite the type ids a `MaxonType` carries through a remap. The `typeParameter` token is a digest of source
// text, the same in every file, and passes through.
export function remapMaxonType(t MaxonType, remap TypeIdRemap) returns MaxonType
	return match t 'r'
		boolean gives t
		integer gives t
		float gives t
		exitCode gives t
		named(id) gives MaxonType.named(remap.applyName(id))
		unresolved gives t

		// A struct reference carries a name id for the same reason `named` does — it is the key
		// `StructLayoutMap` is read by — so it moves through a merge for the same reason and by the
		// same rule. Missing it would leave a `Point` reference in a second file indexing the
		// project interner at whatever name happened to take that id first.
		structRef(id) gives MaxonType.structRef(remap.applyName(id))

		// A `String` builtin carries no name id, so a merge's id remap has nothing to rewrite — like a
		// primitive, it passes through unchanged.
		string gives t

		// A function value carries a name id (its governing function/alias name) for the same reason
		// `named`/`structRef` do, so it moves through a merge by the same rule — remap the id.
		function(id) gives MaxonType.function(remap.applyName(id))

		// ⚠ **THE TOKEN IS A DIGEST, NOT A POSITION.** `ProgramSignatures.typeParamTokenFor` digests
		// `(declaringTypeName, paramName)`, a pure function of source text that every file computes alike. A
		// position would NOT be injective: every declaration numbers its parameters from zero.
		typeParameter gives t

		// An instance id a parse minted is renumbered by its merge; a baseline id stays.
		genericInstance(id) gives MaxonType.genericInstance(remap.applyInstance(id))

		// A Character carries no interner id (its identity is the tag), so a merge's remap has nothing
		// to rewrite — it passes through unchanged, exactly as `string` does.
		character gives t

		// An existential carries the interned INTERFACE name — a per-file interner id exactly as `named`'s
		// is — so a merge's id remap must rewrite it, or the dispatch would resolve its method slot against
		// whatever name the pre-merge id folded to.
		interfaceRef(id) gives MaxonType.interfaceRef(remap.applyName(id))
		cstring gives t
	end 'r'
end 'remapMaxonType'

// `remapMaxonType` folded over a LIST of types — a function's parameter column, a struct's field column, a
// swept declaration's parameter types. TWO callers had written this loop out by hand (`remapArtifact` and
// `remapStructLayoutFieldTypes`) and the swept parameter column would have been a third; the rule all three
// rest on is stated at `remapStructLayoutFieldTypes` (every arm is TAG-PRESERVING), and it is worth exactly
// once. ⚠ THE COUNT IS THE CALLER COUNT AND NOTHING ELSE CHECKS IT — the `PayloadField` walk below is a
// LOOK-ALIKE, not a fourth caller: it rebuilds a different element type and cannot come through here.
export function remapMaxonTypes(types MaxonTypeArray, remap TypeIdRemap) returns MaxonTypeArray
	var remapped = MaxonTypeArray.create()

	for t in types 'each'
		remapped.push(remapMaxonType(t, remap: remap))
	end 'each'

	return remapped
end 'remapMaxonTypes'

// Rewrite the name id of ONE entry of a dense per-value type column (`IrFunction.valueNameIds`)
// through a remap, TAG-AWARE — the column half of a `MaxonType` that `remapMaxonType` cannot reach,
// because the value's type is carried as the parallel (tag, nameId) columns the parser keeps rather
// than a materialized union.
//
// ⚠ A scalar's slot holds the `UnnamedTypeId` FILLER, not a real name — so it must NOT be remapped:
// `remap.applyName(0)` would rewrite the filler to whatever id 0 folded to (a real name), and a later
// reader gated on a name-bearing tag would then resolve a wrong name. Reconstructing the `MaxonType`
// from the tag and running it through `remapMaxonType` is what makes this filler-safe WITHOUT a second
// copy of "which tags bear names": `typeNameIdOf` already encodes it, and this is its exact inverse
// composed with the remap. `void` names no value (its slot is filler too) and `maxonTypeOfTag` panics
// on it, so it short-circuits.
module function remapValueNameId(tag ValueTypeTag, nameId TypeNameId, remap TypeIdRemap) returns TypeNameId
	if tag == ValueTypeTag.void 'void'
		return nameId
	end 'void'

	return typeNameIdOf(remapMaxonType(maxonTypeOfTag(tag, nameId: nameId), remap: remap))
end 'remapValueNameId'

// Rewrite the named-type id a `MaxonReturnType` may carry (its `value` inner).
export function remapMaxonReturnType(rt MaxonReturnType, remap TypeIdRemap) returns MaxonReturnType
	return match rt 'r'
		void gives rt
		value(inner) gives MaxonReturnType.value(remapMaxonType(inner, remap: remap))
	end 'r'
end 'remapMaxonReturnType'

// Rewrite a declared struct's field types through a remap, IN PLACE.
//
// Two callers reconcile a file's struct layouts into a bigger table — `mergeArtifact`'s
// `remapArtifact` (into `Project`) and `ProgramSignatures.foldFile` (into the signature index) —
// and they must not come to disagree about what a field's declared type means. One mechanism, two
// callers, exactly as `foldInto` + `remapMaxonReturnType` already are for a signature.
//
// It mutates rather than returning a copy because `StructLayout` is a heap `type` and both callers
// own the array they are folding: rebuilding the record would allocate a second layout per declared
// type to hold data neither caller keeps. The struct's NAME needs no remap — it is a `ByteArray`,
// and names travel (see SignatureIndex's header on the id problem).
//
// ⚠ **THE HAND-OFF IS `StructLayout.replaceFieldTypes` AND NOT A BARE ASSIGNMENT, BECAUSE THE LAYOUT NOW
// CACHES GEOMETRY DERIVED FROM THIS COLUMN** (`fieldOffsets`/`slotBytes`, the existential two-slot
// prefix sum). This function is a THIRD writer of `fieldTypes` — the header over those
// columns names only two — and writing the column without rebuilding them is harmless
// only because `remapMaxonType` is TAG-PRESERVING in every arm, which is a property of the function above
// that nothing here states and nothing checks; a single arm that changed a tag would move a field's slot
// count and every later field in that struct would read one slot short, silently. Handing the column back
// through the type that owns it is what makes the rebuild unmissable rather than remembered.
export function remapStructLayoutFieldTypes(layout StructLayout, remap TypeIdRemap)
	layout.replaceFieldTypes(remapMaxonTypes(layout.fieldTypes, remap: remap))
end 'remapStructLayoutFieldTypes'

// Rewrite a declared union/enum's PAYLOAD field types through a remap, IN PLACE — the enum twin of
// `remapStructLayoutFieldTypes`, and it exists for the identical reason: a payload field declared
// `walk(dir Direction)` carries a `named(Direction)` id into the file-local interner, and a merge
// that moves ids leaves it pointing at whatever name took that id first. `PayloadField` is an
// immutable record (`let` fields), so a rebuilt array of rebuilt fields replaces the column rather
// than mutating each in place — the `remapArtifact` interner rule (build fresh, assign) applied one
// registry deeper. Both callers that reconcile a file's enum layouts into a bigger table
// (`remapArtifact` into `Project`, `ProgramSignatures.foldFile` into the index) go through here, so
// the two cannot disagree about what a payload's declared type means.
export function remapEnumLayoutPayloadTypes(layout EnumLayout, remap TypeIdRemap)
	var remappedCases = PayloadFieldArrayArray.create()

	for casePayloads in layout.casePayloads 'eachCase'
		var remappedFields = PayloadFieldArray.create()

		for field in casePayloads 'eachField'
			remappedFields.push(PayloadField.create(field.name, declaredType: remapMaxonType(field.declaredType, remap: remap), declaredSurface: field.declaredSurface, declaredBrand: field.declaredBrand))
		end 'eachField'

		remappedCases.push(remappedFields)
	end 'eachCase'

	// Written through the layout's own door, after the read loop above rather than inside it: the write is
	// then the layout's own (which is what lets a caller reach this through a binding it may not write) and
	// it cannot land in a column the loop is still walking.
	for index in 0 upto remappedCases.count() 'eachRemapped'
		layout.retypeCasePayloads(index as CaseIndex, payloads: try remappedCases.get(index) otherwise panic("remapEnumLayoutPayloadTypes: remappedCases.get OOB at {index} inside its own count"))
	end 'eachRemapped'
end 'remapEnumLayoutPayloadTypes'
