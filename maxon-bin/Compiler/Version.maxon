// What this compiler reports as its version.
//
// These are defaults, and the build replaces them with `--define`. `maxon-bin/maxon.maxproj`
// derives the real values from git and passes them as `Compiler.CompilerVersion` and its two
// siblings; nothing rewrites this file, and a build never dirties the working tree.
//
// ⛔ **IT IS TRACKED SOURCE AND MUST STAY THAT WAY.** Generating it needs a compiler, and the compiler
// cannot be built without it: a generated file leaves a fresh clone with no `CompilerVersion` at all,
// and every lane fails to compile. A default that is honest — `dev`, built from an unknown commit —
// makes the file self-sufficient, and `--define` is what a build with more to say uses to say it.
//
// The shape is rustc's: `maxon 0.1.1 (a1b2c3d 2026-09-09)`. A release number alone cannot answer a bug
// report about "0.1.1" when there have been forty builds of it; the commit and the day can.
export let CompilerVersion = "dev"
module let CompilerProductName = "maxon"
module let CompilerCommit = "unknown"
module let CompilerCommitDate = "unknown"

// Shared by `version` and the no-argument overview, so the two cannot give different answers. It
// carries the host triple because several targets ship under one name.
export function versionLine() returns String
	return "{CompilerProductName} {CompilerVersion} ({CompilerCommit} {CompilerCommitDate}) ({targetToString(detectHostTarget())})"
end 'versionLine'
