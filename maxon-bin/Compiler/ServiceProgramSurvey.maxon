// ServiceProgramSurvey.maxon — ONE SWEEP OF EVERY FUNCTION'S EVERY OP FOR THE WHOLE-PROGRAM SERVICE RULE
// (E3139, `ServiceCallCycleCheck`): the call graph, every `await` on a service reply, and the service each
// function is a message or factory of. `checkServiceRules` asks its gate first, so a program that awaits no
// reply pays one `count()`.

// One `await` on a service reply. Rows, not a per-function column: see `ServiceAwaitRoster`.
module typealias ServiceAwaitSiteArray = Array with ServiceAwaitSite

module enum AwaitRowLookup implements Error
	awaitsOnlyThroughAHelper
end 'AwaitRowLookup'

// ⭐⭐⭐ **EVERY (FUNCTION, AWAITED SERVICE) PAIR IN THE PROGRAM — ONE ROW PER `await`, NOT ONE PER
// FUNCTION.** A message that awaits replies from TWO services owes an edge to BOTH, and a single site
// per function can carry only one of them.
//
// ⛔⛔ **MEASURED, WITH ITS POSITIVE CONTROL.** Keeping ONE site per function — the last an op sweep sees
// — seeds `C` alone for an `A.ping` that awaits `B` and then `C`, and the `A → B` edge is never built:
// the ring `A.ping → B.pong → A.ack` COMPILES CLEAN, exit 0, with one unrelated `await` added to
// `A.ping`, while the very same program without that await is E3139. A dropped edge is a MISSED refusal,
// which is exactly the deadlock `ServiceCallCycleCheck` exists to make unrepresentable.
//
// ⭐ **AND THERE IS NO "AWAITS NOTHING" SITE.** Absence is the absence of a ROW: a function that awaits
// no reply simply appears in no row, so no empty-name sentinel site and no parallel `BoolArray` guarding
// one exist, and nothing has to remember not to read its fields.
module type ServiceAwaitRoster
	// Row ⇒ the function whose own body holds the `await`.
	var funcIndices as FuncIndexArray

	// Row ⇒ which service that await blocks on, and where it is written.
	var sites as ServiceAwaitSiteArray

	static function create() returns ServiceAwaitRoster
		return Self{funcIndices: FuncIndexArray.create(0), sites: ServiceAwaitSiteArray.create(0)}
	end 'create'

	// ⚠ An await through `I.handle` may be answered by any live implementer of `I`, so it is an edge
	// to each of them (E3139); crediting one would let a wait cycle through another compile.
	function noteReplyAwait(funcIndex ElementIndex, site ServiceAwaitSite, signatures ProgramSignatures)
		if not signatures.declaresAnInterfaceHandle() or not signatures.isInterfaceHandle(serviceHandleCompanionName(site.serviceTypeName)) 'oneService'
			self.note(funcIndex, site: site)
			return
		end 'oneService'

		for service in serviceTypeRoster(signatures) 'eachService'
			if signatures.typeImplementsInterface(service, interfaceName: site.serviceTypeName) 'anImplementer'
				self.note(funcIndex, site: ServiceAwaitSite.create(service, line: site.line, column: site.column, declFilePath: site.declFilePath))
			end 'anImplementer'
		end 'eachService'
	end 'noteReplyAwait'

	function note(funcIndex ElementIndex, site ServiceAwaitSite)
		self.funcIndices.push(funcIndex)
		self.sites.push(site)
	end 'note'

	function rowCount() returns CsrIndex
		return self.sites.count()
	end 'rowCount'

	module function siteAt(row CsrIndex) returns ServiceAwaitSite
		return try self.sites.get(row) otherwise panic("ServiceAwaitRoster.siteAt: sites.get OOB at {row} below count {self.rowCount()}")
	end 'siteAt'

	function funcIndexAt(row CsrIndex) returns ElementIndex
		return try self.funcIndices.get(row) otherwise panic("ServiceAwaitRoster.funcIndexAt: funcIndices.get OOB at {row} below count {self.rowCount()}")
	end 'funcIndexAt'

	// Mark every function whose OWN body awaits a reply from `awaitedName`. ⚡ ONE sweep of the roster per
	// SERVICE, rather than one test per (function, service) pair — which is why carrying every await costs
	// less than the single-site column it replaced, not more.
	module function seedFunctionsAwaiting(awaitedName ByteArray, seeds BoolArray)
		for row in 0 upto self.rowCount() 'eachRow'
			if not self.siteAt(row).serviceTypeName.equals(awaitedName) 'anotherService'
				continue
			end 'anotherService'

			let funcIndex = self.funcIndexAt(row)
			try seeds.set(funcIndex, value: true) otherwise panic("ServiceAwaitRoster.seedFunctionsAwaiting: seeds.set OOB at {funcIndex} — every row's function index came from the same function list the seed column was sized to")
		end 'eachRow'
	end 'seedFunctionsAwaiting'

	// The FIRST row in which `funcIndex` itself awaits `awaitedName`.
	module function rowWhere(funcIndex ElementIndex, awaitedName ByteArray) returns CsrIndex throws AwaitRowLookup
		for row in 0 upto self.rowCount() 'eachRow'
			if self.funcIndexAt(row) == funcIndex and self.siteAt(row).serviceTypeName.equals(awaitedName) 'awaitsItHere'
				return row
			end 'awaitsItHere'
		end 'eachRow'

		throw AwaitRowLookup.awaitsOnlyThroughAHelper
	end 'rowWhere'

	// The first row ANYWHERE that awaits `awaitedName` — the anchor for a message that blocks only through a
	// helper. It panics rather than answering a default: a caller reaches it only for a function the closure
	// marked, and a mark reaches a caller only from a seed.
	module function firstRowAwaiting(awaitedName ByteArray) returns CsrIndex
		for row in 0 upto self.rowCount() 'eachRow'
			if self.siteAt(row).serviceTypeName.equals(awaitedName) 'awaitsIt'
				return row
			end 'awaitsIt'
		end 'eachRow'

		panic("ServiceAwaitRoster.firstRowAwaiting: no function awaits a reply from `{String.from(awaitedName)}`, yet the closure marked one as blocking on it — a mark reaches a caller only from a seed, and a seed is a direct await")
	end 'firstRowAwaiting'
end 'ServiceAwaitRoster'

union MessageOwner
	none
	service(name immutable ByteArray)
	factory(name immutable ByteArray)
end 'MessageOwner'

typealias MessageOwnerArray = Array with MessageOwner

module type ServiceProgramSurvey
	export var edges as CallGraphEdges
	var ownerPerFunc as MessageOwnerArray
	export var awaits as ServiceAwaitRoster

	static function create() returns ServiceProgramSurvey
		return Self{edges: CallGraphEdges.create(), ownerPerFunc: MessageOwnerArray.create(0), awaits: ServiceAwaitRoster.create()}
	end 'create'

	module function funcCount() returns CsrIndex
		return self.ownerPerFunc.count()
	end 'funcCount'

	module function serviceOf(funcIndex ElementIndex) returns immutable ByteArray throws AbsentError
		match try self.ownerPerFunc.get(funcIndex) otherwise panic("ServiceProgramSurvey.serviceOf: ownerPerFunc.get OOB at {funcIndex} below count {self.funcCount()}") 'owner'
			none then throw AbsentError.absent
			service(name) then return name
			factory(name) then return name
		end 'owner'
	end 'serviceOf'

	function factoryOwnerOf(signatures ProgramSignatures, callee ByteArray) returns MessageOwner
		if let owner = try serviceFactoryOwnerOf(signatures, callee: callee) 'aFactory'
			return MessageOwner.factory(owner)
		end 'aFactory'

		return MessageOwner.none
	end 'factoryOwnerOf'

	function noteFunction(project Project, module MaxonModule, signatures ProgramSignatures, func IrFunction, funcIndexByName FuncIndexByName, funcIndex ElementIndex)
		if let owner = try messageOwnerNameOf(signatures, callee: func.name) 'aMessage'
			self.ownerPerFunc.push(MessageOwner.service(owner))
		end 'aMessage' else 'notAMessage'
			self.ownerPerFunc.push(self.factoryOwnerOf(signatures, callee: func.name))
		end 'notAMessage'

		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("ServiceProgramSurvey.noteFunction: blockRef from func.blockRefs not in module.blocks")

			for opIndex in block.bodyOps() 'eachOp'
				let op = try module.ops.get(opIndex) otherwise panic("ServiceProgramSurvey.noteFunction: opIndex {opIndex} not in module.ops")

				if opIsACallGraphEdge(op) 'aCall'
					_ = recordCallGraphEdge(maxonOpCalleeName(op), funcIndexByName: funcIndexByName, callerIndex: funcIndex, edges: self.edges)
				end 'aCall'

				if let awaitSite = try project.serviceAwaitSites.get(opIndex) 'awaitsAReply'
					self.awaits.noteReplyAwait(funcIndex, site: awaitSite, signatures: signatures)
				end 'awaitsAReply'
			end 'eachOp'
		end 'eachBlock'
	end 'noteFunction'
end 'ServiceProgramSurvey'

export function checkServiceRules(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex)
	if project.serviceAwaitSites.count() == 0 'noRuleHasAnythingToSay'
		return
	end 'noRuleHasAnythingToSay'

	let survey = ServiceProgramSurvey.create()

	for funcIndex in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(funcIndex) otherwise panic("checkServiceRules: functions.get OOB at {funcIndex}")
		survey.noteFunction(project, module: module, signatures: signatures, func: func, funcIndexByName: funcNames.byName, funcIndex: funcIndex)
	end 'eachFunc'

	checkServiceCallCycles(project, signatures: signatures, funcNames: funcNames, survey: survey)
end 'checkServiceRules'

export typealias RequirementNameSet = Set with ByteArray
