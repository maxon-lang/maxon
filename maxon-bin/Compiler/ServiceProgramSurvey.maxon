// ServiceProgramSurvey.maxon — ONE SWEEP OF EVERY FUNCTION'S EVERY OP, AND EVERY WHOLE-PROGRAM SERVICE RULE
// READS IT.
//
// ⭐⭐ **THE RULES CLOSE OVER ONE CALL GRAPH, ROWED OPPOSITE WAYS.** `ServiceCallCycleCheck` asks *"which messages
// BLOCK ON a service?"* (E3139), and `ServiceGlobalAccessCheck` asks *"what does a message RUN?"* (E3143, E3163)
// and *"what does a global initializer run?"* (E3164, E3165). Two sweeps would let an edit to "the ops of a
// function" reach one copy, the rules then closing over different graphs — a WRONG ANSWER rather than a compile
// error.
// So the walk is here, once, collecting the union of what the rules need; which rule consumes which column is
// stated on the column.
//
// ⚠ **THE UNION IS COLLECTED WHENEVER ANY RULE RUNS, and that is the price of one walk.** Each extra column is
// one map `get` per op on a walk that already visits every op. `checkServiceRules` asks every gate first, so a
// program that triggers none pays a few `count()`s and nothing else.

// One `await` on a service reply. Rows, not a per-function column: see `ServiceAwaitRoster`.
module typealias ServiceAwaitSiteArray = Array with ServiceAwaitSite

// One row per ACCESS to module storage: which function holds it, which direction, and what the author wrote
// there. A ROSTER rather than a per-function column, on `ServiceAwaitRoster`'s discipline and for its reason
// — a function may touch two globals, and a read-modify-write touches one of them twice, so a single site
// per function can carry neither. Rows are appended in function-major then op-major order, which is what
// makes "the earliest offending access" a scan rather than a sort.
typealias ModuleVarAccessSiteArray = Array with ModuleVarAccessSite

// ⭐ **"NO SUCH ROW" AS A VALUE** — `ServiceCallCycleCheck.NoServiceNode`'s rule, one column over: row 0 is a
// real row, so the absence sits above every key the roster can mint.
// Its bound, `i64.max`, is that rule's too — `CsrIndex` is a checked quantity and `u64.max` rides as a
// signed-negative.
module let NoAwaitRow = i64.max as CsrIndex

// ⭐⭐⭐ **EVERY (FUNCTION, AWAITED SERVICE) PAIR IN THE PROGRAM — ONE ROW PER `await`, NOT ONE PER
// FUNCTION.** A message that awaits replies from TWO services owes an edge to BOTH, and a single site
// per function can carry only one of them.
//
// ⛔⛔ **MEASURED, WITH ITS POSITIVE CONTROL.** Keeping ONE site per function — the last an op sweep sees
// — seeds `C` alone for an `A.ping` that awaits `B` and then `C`, and the `A → B` edge is never built:
// the ring `A.ping → B.pong → A.ack` COMPILES CLEAN, exit 0, with one unrelated `await` added to
// `A.ping`, while the very same program without that await is E3139. A dropped edge is a MISSED refusal,
// which is exactly the deadlock `ServiceCallCycleCheck` exists to make unrepresentable.
//
// ⭐ **AND THERE IS NO "AWAITS NOTHING" SITE.** Absence is the absence of a ROW: a function that awaits
// no reply simply appears in no row, so no empty-name sentinel site and no parallel `BoolArray` guarding
// one exist, and nothing has to remember not to read its fields.
module type ServiceAwaitRoster
	// Row ⇒ the function whose own body holds the `await`.
	var funcIndices as FuncIndexArray

	// Row ⇒ which service that await blocks on, and where it is written.
	var sites as ServiceAwaitSiteArray

	static function create() returns ServiceAwaitRoster
		return Self{funcIndices: FuncIndexArray.create(), sites: ServiceAwaitSiteArray.create()}
	end 'create'

	function note(funcIndex FuncIndex, site ServiceAwaitSite)
		self.funcIndices.push(funcIndex)
		self.sites.push(site)
	end 'note'

	function rowCount() returns CsrIndex
		return self.sites.count()
	end 'rowCount'

	export function siteAt(row CsrIndex) returns ServiceAwaitSite
		return try self.sites.get(row) otherwise panic("ServiceAwaitRoster.siteAt: sites.get OOB at {row} below count {self.rowCount()}")
	end 'siteAt'

	function funcIndexAt(row CsrIndex) returns FuncIndex
		return try self.funcIndices.get(row) otherwise panic("ServiceAwaitRoster.funcIndexAt: funcIndices.get OOB at {row} below count {self.rowCount()}")
	end 'funcIndexAt'

	// Mark every function whose OWN body awaits a reply from `awaitedName`. ⚡ ONE sweep of the roster per
	// SERVICE, rather than one test per (function, service) pair — which is why carrying every await costs
	// less than the single-site column it replaced, not more.
	export function seedFunctionsAwaiting(awaitedName ByteArray, seeds BoolArray)
		for row in 0 upto self.rowCount() 'eachRow'
			if not self.siteAt(row).serviceTypeName.equals(awaitedName) 'anotherService'
				continue
			end 'anotherService'

			let funcIndex = self.funcIndexAt(row)
			try seeds.set(funcIndex, value: true) otherwise panic("ServiceAwaitRoster.seedFunctionsAwaiting: seeds.set OOB at {funcIndex} — every row's function index came from the same function list the seed column was sized to")
		end 'eachRow'
	end 'seedFunctionsAwaiting'

	// The FIRST row in which `funcIndex` itself awaits `awaitedName`, or `NoAwaitRow` when it blocks on that
	// service only through a helper.
	export function rowWhere(funcIndex FuncIndex, awaitedName ByteArray) returns CsrIndex
		for row in 0 upto self.rowCount() 'eachRow'
			if self.funcIndexAt(row) == funcIndex and self.siteAt(row).serviceTypeName.equals(awaitedName) 'awaitsItHere'
				return row
			end 'awaitsItHere'
		end 'eachRow'

		return NoAwaitRow
	end 'rowWhere'

	// The first row ANYWHERE that awaits `awaitedName` — the anchor for a message that blocks only through a
	// helper. It panics rather than answering a default: a caller reaches it only for a function the closure
	// marked, and a mark reaches a caller only from a seed.
	export function firstRowAwaiting(awaitedName ByteArray) returns CsrIndex
		for row in 0 upto self.rowCount() 'eachRow'
			if self.siteAt(row).serviceTypeName.equals(awaitedName) 'awaitsIt'
				return row
			end 'awaitsIt'
		end 'eachRow'

		panic("ServiceAwaitRoster.firstRowAwaiting: no function awaits a reply from `{String.from(awaitedName)}`, yet the closure marked one as blocking on it — a mark reaches a caller only from a seed, and a seed is a direct await")
	end 'firstRowAwaiting'
end 'ServiceAwaitRoster'

// A global's position in the list a slot roster files its ops against, and that list keyed by its slot's label.
module typealias SlotSubjectIndex = int(0 to u64.max)
typealias SlotSubjectIndexArray = Array with SlotSubjectIndex
module typealias SlotSubjectByLabel = Map with (ByteArray, SlotSubjectIndex)

// One row per op of one kind: the op, and the function whose body holds it, in function-major then op-major
// order.
module type OpRoster
	var funcs as FuncIndexArray
	var ops as OpIndexArray

	static function create() returns OpRoster
		return Self{funcs: FuncIndexArray.create(), ops: OpIndexArray.create()}
	end 'create'

	function note(funcIndex FuncIndex, opIndex OpIndex)
		self.funcs.push(funcIndex)
		self.ops.push(opIndex)
	end 'note'

	export function rowCount() returns CsrIndex
		return self.ops.count()
	end 'rowCount'

	export function funcAt(row CsrIndex) returns FuncIndex
		return try self.funcs.get(row) otherwise panic("OpRoster.funcAt: funcs.get OOB at {row} below count {self.rowCount()}")
	end 'funcAt'

	export function opAt(row CsrIndex) returns OpIndex
		return try self.ops.get(row) otherwise panic("OpRoster.opAt: ops.get OOB at {row} below count {self.rowCount()}")
	end 'opAt'
end 'OpRoster'

// One row per op addressing the slot of a managed global: the op, its function, and the global's position in
// `project.managedGlobals`.
module type SlotRoster
	export var sites as OpRoster
	var subjects as SlotSubjectIndexArray

	static function create() returns SlotRoster
		return Self{sites: OpRoster.create(), subjects: SlotSubjectIndexArray.create()}
	end 'create'

	function noteIfListed(label ByteArray, listed SlotSubjectByLabel, funcIndex FuncIndex, opIndex OpIndex)
		if let subject = try listed.get(label) 'aListedSlot'
			self.sites.note(funcIndex, opIndex: opIndex)
			self.subjects.push(subject)
		end 'aListedSlot'
	end 'noteIfListed'

	export function subjectAt(row CsrIndex) returns SlotSubjectIndex
		return try self.subjects.get(row) otherwise panic("SlotRoster.subjectAt: subjects.get OOB at {row} below count {self.sites.rowCount()}")
	end 'subjectAt'
end 'SlotRoster'

// ⭐⭐ **EVERY WHOLE-PROGRAM FACT THE SERVICE RULES NEED, OUT OF ONE PASS OVER EVERY FUNCTION'S EVERY OP.**
module type ServiceProgramSurvey
	// Call edges in the shared `(callee, caller)` shape every summary closes over. E3139 rows them with
	// `markSeededCallers`; the EDGES are the same relation either way.
	export var edges as CallGraphEdges

	// The same edges rowed by CALLER, so each row lists what a function calls — what "what does it run?" walks.
	// Built once the sweep is done (`settleCallGraph`).
	export var calleeGraph as CsrGraph

	// funcIndex ⇒ the service this function is a message of, or EMPTY. Asked once per FUNCTION rather than
	// once per (function, service): `messageOwnerNameOf` already walks every service's every variant.
	var ownerPerFunc as ByteArrayArray

	// funcIndex ⇒ is it a message? The same fact as `ownerPerFunc`, in the shape a seed column takes.
	export var messageSeeds as BoolArray

	// E3139's column: every (function, awaited service) pair.
	export var awaits as ServiceAwaitRoster

	// E3143's two columns of run-time dispatch: funcIndex ⇒ does its body call a closure value, and does it
	// dispatch through a witness. See `ServiceGlobalAccessCheck`'s header for why those are the one unknown that
	// rule resolves toward refusing.
	var callsAClosure as BoolArray
	var dispatchesThroughAWitness as BoolArray

	// ⭐ E3143's rows: one per witness dispatch — the function holding it and the requirement it dispatches —
	// which is what narrows where it can land (`widenFrom`). A function's rows are contiguous, from its entry in
	// `witnessDispatchStarts` to the next function's.
	var witnessDispatchFuncs as FuncIndexArray
	var witnessDispatchRequirements as ByteArrayArray
	var witnessDispatchStarts as EntryIndexArray

	// ⭐ E3143's column: the functions whose ADDRESS this program takes — one entry per `functionRef` that
	// resolves to a declared function, and so every function a closure call can land on. Collected as indices
	// rather than as a marked column because a `functionRef` may name a function this sweep has not reached yet.
	var addressTaken as CsrColumn

	// E3143's roster, in two parallel columns.
	var accessFuncs as FuncIndexArray
	var accessSites as ModuleVarAccessSiteArray

	// E3163's and E3165's roster: every op addressing the slot of a managed global.
	export var globalUses as SlotRoster

	// E3164's roster: every `spawn`, and the function holding it.
	export var spawns as OpRoster

	static function create() returns ServiceProgramSurvey
		return Self{edges: CallGraphEdges.create(), ownerPerFunc: ByteArrayArray.create(), messageSeeds: BoolArray.create(), awaits: ServiceAwaitRoster.create(), callsAClosure: BoolArray.create(), dispatchesThroughAWitness: BoolArray.create(), witnessDispatchFuncs: FuncIndexArray.create(), witnessDispatchRequirements: ByteArrayArray.create(), witnessDispatchStarts: EntryIndexArray.create(), calleeGraph: buildCsr(CsrColumn.create(), to: CsrColumn.create(), nodeCount: 0), addressTaken: CsrColumn.create(), accessFuncs: FuncIndexArray.create(), accessSites: ModuleVarAccessSiteArray.create(), globalUses: SlotRoster.create(), spawns: OpRoster.create()}
	end 'create'

	export function funcCount() returns CsrIndex
		return self.messageSeeds.count()
	end 'funcCount'

	export function isAMessage(funcIndex FuncIndex) returns bool
		return try self.messageSeeds.get(funcIndex) otherwise panic("ServiceProgramSurvey.isAMessage: messageSeeds.get OOB at {funcIndex} below count {self.funcCount()}")
	end 'isAMessage'

	export function serviceOf(funcIndex FuncIndex) returns ByteArray
		return try self.ownerPerFunc.get(funcIndex) otherwise panic("ServiceProgramSurvey.serviceOf: ownerPerFunc.get OOB at {funcIndex} below count {self.funcCount()}")
	end 'serviceOf'

	export function accessRowCount() returns CsrIndex
		return self.accessSites.count()
	end 'accessRowCount'

	export function accessFuncAt(row CsrIndex) returns FuncIndex
		return try self.accessFuncs.get(row) otherwise panic("ServiceProgramSurvey.accessFuncAt: accessFuncs.get OOB at {row} below count {self.accessRowCount()}")
	end 'accessFuncAt'

	export function accessSiteAt(row CsrIndex) returns ModuleVarAccessSite
		return try self.accessSites.get(row) otherwise panic("ServiceProgramSurvey.accessSiteAt: accessSites.get OOB at {row} below count {self.accessRowCount()}")
	end 'accessSiteAt'

	// Does this function choose a callee at run time — a closure call or a witness dispatch?
	export function dispatchesAtRunTime(funcIndex FuncIndex) returns bool
		let closure = try self.callsAClosure.get(funcIndex) otherwise panic("ServiceProgramSurvey.dispatchesAtRunTime: callsAClosure.get OOB at {funcIndex} below count {self.funcCount()}")
		let witness = try self.dispatchesThroughAWitness.get(funcIndex) otherwise panic("ServiceProgramSurvey.dispatchesAtRunTime: dispatchesThroughAWitness.get OOB at {funcIndex} below count {self.funcCount()}")
		return closure or witness
	end 'dispatchesAtRunTime'

	// ⭐⭐ **WHERE THE RUN-TIME DISPATCHES OF A NEWLY REACHED FUNCTION CAN LAND, MARKED AND QUEUED — and each
	// dispatch shape lands in its OWN set, a tiny one in every program that is not a plugin host.** Each set is
	// marked once, the first time a reached function dispatches that way.
	//
	// - A CLOSURE CALL lands on a function value, and a function value comes from a `functionRef` (a closure
	//   literal or a named function used as a value) and from nowhere else: every function whose address is
	//   taken.
	// - A WITNESS DISPATCH lands on a member of the conformance the witness table was built for, so on a
	//   function wearing the dispatched requirement's name (`WitnessDispatchTargets.candidatesFor`, complete by
	//   construction). A builtin conformer's slot is a Std-tier entry point no source declares, with no user
	//   module slot in it.
	//
	// ⛔⛔ **EACH NARROWING IS WHAT MAKES THE RULE USABLE AT ALL.** Marking EVERY function let one interface
	// dispatch implicate `Log.startCapture`, whose cure lives in a file the author does not own; marking every
	// address-taken function for a witness dispatch refused every service whose handler keeps a `Map`, because a
	// `Map` hashes its key through a witness and a closure anywhere in the program was then reachable.
	//
	// ⚠ **THE SAFE DIRECTION IS KEPT WITHIN EACH SET**: every function in one is queued, so the walk goes on to
	// what it calls — which may itself dispatch.
	export function widenFrom(funcIndex FuncIndex, walk CalleeWalk, widening DispatchWidening, dispatch WitnessDispatchTargets, funcIndexByName FuncIndexByName)
		let bodyCallsAClosure = try self.callsAClosure.get(funcIndex) otherwise panic("ServiceProgramSurvey.widenFrom: callsAClosure.get OOB at {funcIndex} below count {self.funcCount()}")

		if bodyCallsAClosure and not widening.closureTargetsMarked 'aClosureIsCalled'
			widening.closureTargetsMarked = true

			for target in self.addressTaken 'eachAddressTaken'
				walk.reach(target as FuncIndex)
			end 'eachAddressTaken'
		end 'aClosureIsCalled'

		let first = try self.witnessDispatchStarts.get(funcIndex) otherwise panic("ServiceProgramSurvey.widenFrom: witnessDispatchStarts.get OOB at {funcIndex}")
		let pastLast = try self.witnessDispatchStarts.get(funcIndex + 1) otherwise self.witnessDispatchFuncs.count()

		for row in first upto pastLast 'eachWitnessDispatch'
			let requirement = try self.witnessDispatchRequirements.get(row) otherwise panic("ServiceProgramSurvey.widenFrom: witnessDispatchRequirements.get OOB at {row} — the rows are pushed together")

			if widening.requirements.contains(requirement) 'widenedAlready'
				continue
			end 'widenedAlready'

			widening.requirements.insert(requirement)

			for candidate in dispatch.candidatesFor(requirement) 'eachCandidate'
				if let candidateIndex = try funcIndexByName.get(candidate) 'declaredHere'
					walk.reach(candidateIndex)
				end 'declaredHere'
			end 'eachCandidate'
		end 'eachWitnessDispatch'
	end 'widenFrom'

	export function settleCallGraph()
		self.calleeGraph = buildCsr(self.edges.callerIndices, to: self.edges.calleeIndices, nodeCount: self.funcCount())
	end 'settleCallGraph'

	// ⭐⭐ **ONE FUNCTION'S EDGES, ITS AWAITS, ITS RUN-TIME DISPATCHES, ITS ADDRESS-TAKING AND ITS MODULE
	// ACCESSES — ALL OUT OF THE SAME OP SWEEP.** Five facts about one body; five walks of it would be five
	// chances to disagree about which ops that body has, which is this file's whole reason for existing.
	function noteFunction(project Project, module MaxonModule, signatures ProgramSignatures, func IrFunction, funcIndexByName FuncIndexByName, funcIndex FuncIndex, dispatch WitnessDispatchTargets, globalsByLabel SlotSubjectByLabel)
		let owner = messageOwnerNameOf(signatures, callee: func.name)
		self.messageSeeds.push(not owner.isEmpty())
		self.ownerPerFunc.push(owner)
		self.witnessDispatchStarts.push(self.witnessDispatchFuncs.count())

		var bodyCallsAClosure = false
		let witnessDispatchesBefore = self.witnessDispatchFuncs.count()

		for blockRef in func.blockRefs 'eachBlock'
			let block = try module.blocks.get(blockRef) otherwise panic("ServiceProgramSurvey.noteFunction: blockRef from func.blockRefs not in module.blocks")

			for opIndex in block.opRefs 'eachOp'
				let op = try module.ops.get(opIndex) otherwise panic("ServiceProgramSurvey.noteFunction: opIndex {opIndex} not in module.ops")

				if opIsACallGraphEdge(op) 'aCall'
					_ = recordCallGraphEdge(maxonOpCalleeName(op), funcIndexByName: funcIndexByName, callerIndex: funcIndex, edges: self.edges)
				end 'aCall'

				if opTakesAFunctionsAddress(op) 'aFunctionValue'
					if let target = try funcIndexByName.get(maxonOpCalleeName(op)) 'namesADeclaredFunction'
						self.addressTaken.push(target)
					end 'namesADeclaredFunction'
				end 'aFunctionValue'

				match runTimeTargetOf(op) 'target'
					named then break 'target'
					closureValue then bodyCallsAClosure = true
					witnessSlot(methodIndex, interfaceDeclIndex) then self.noteWitnessDispatch(funcIndex, requirement: dispatch.requirementNameAt(methodIndex, interfaceDeclIndex: interfaceDeclIndex))
				end 'target'

				// ⛔ **EVERY await IS NOTED, NOT THE LAST ONE.** See `ServiceAwaitRoster` for the ring that
				// compiled clean while this kept one site per function.
				if let awaitSite = try project.serviceAwaitSites.get(opIndex) 'awaitsAReply'
					self.awaits.note(funcIndex, site: awaitSite)
				end 'awaitsAReply'

				if let accessSite = try project.moduleVarAccessSites.get(opIndex) 'touchesModuleStorage'
					self.accessFuncs.push(funcIndex)
					self.accessSites.push(accessSite)
				end 'touchesModuleStorage'

				if maxonOpNamesAGlobalLabel(op) 'addressesAGlobal'
					self.globalUses.noteIfListed(maxonOpGlobalLabelName(op), listed: globalsByLabel, funcIndex: funcIndex, opIndex: opIndex)
				end 'addressesAGlobal'

				if maxonOpIsServiceSpawn(op) 'aSpawn'
					self.spawns.note(funcIndex, opIndex: opIndex)
				end 'aSpawn'
			end 'eachOp'
		end 'eachBlock'

		self.callsAClosure.push(bodyCallsAClosure)
		self.dispatchesThroughAWitness.push(self.witnessDispatchFuncs.count() > witnessDispatchesBefore)
	end 'noteFunction'

	function noteWitnessDispatch(funcIndex FuncIndex, requirement ByteArray)
		self.witnessDispatchFuncs.push(funcIndex)
		self.witnessDispatchRequirements.push(requirement)
	end 'noteWitnessDispatch'
end 'ServiceProgramSurvey'

// What a walk's widening has already marked, so each target set is marked once.
module type DispatchWidening
	export var closureTargetsMarked as bool
	export var requirements as RequirementNameSet

	module static function create() returns DispatchWidening
		return Self{closureTargetsMarked: false, requirements: RequirementNameSet.create()}
	end 'create'
end 'DispatchWidening'

typealias RequirementNameSet = Set with ByteArray

// ⭐⭐ **THE WHOLE-PROGRAM SERVICE RULES, THE `let` INITIALIZER RULE, AND THE ONE SURVEY THEY SHARE.**
//
// ⚠ **THE GATES ARE ASKED BEFORE THE SWEEP, AND EACH IS EMPTY FOR A DIFFERENT ENORMOUS POPULATION.**
// `serviceAwaitSites` is empty for every program that awaits no reply — every program with no service in it,
// and every fire-and-forget one. `serviceTypeRoster` is empty for every program that spawns nothing, and the
// other three service rules need a service too: `moduleVarAccessSites` is empty for every program that never
// names a module `var`, the unmarkable `let`s for every program whose `let`s can all be walked, and
// `__module_init` exists only in a program with a managed global. E3165 needs no service, only a managed `var`
// beside a `let` whose initializer calls.
//
// ⚠ **E3139 REPORTS FIRST, and that ordering is the reason the calls are sequenced here rather than left to
// `semanticCheck`.** A ring that cannot make progress is the more fundamental defect, so a program with both is
// told about the deadlock.
export function checkServiceRules(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex)
	let spawnsAService = serviceTypeRoster(signatures).count() != 0
	let unmarkableLets = letShareWalksOf(project.managedGlobals, spawnsAService: spawnsAService).unmarkable
	let blockingRuleApplies = project.serviceAwaitSites.count() != 0
	let globalRuleApplies = spawnsAService and project.moduleVarAccessSites.count() != 0
	let letRuleApplies = unmarkableLets.count() != 0
	let initializerRuleApplies = spawnsAService and funcNames.byName.contains(ModuleInitName)
	let letInitializerRuleApplies = aLetInitializerMayReachAVar(project.managedGlobals)

	if not (blockingRuleApplies or globalRuleApplies or letRuleApplies or initializerRuleApplies or letInitializerRuleApplies) 'noRuleHasAnythingToSay'
		return
	end 'noRuleHasAnythingToSay'

	var survey = ServiceProgramSurvey.create()
	var dispatch = WitnessDispatchTargets.create(signatures, functions: funcNames.functions)
	let globalsByLabel = managedGlobalsByLabel(project.managedGlobals)

	for funcIndex in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(funcIndex) otherwise panic("checkServiceRules: functions.get OOB at {funcIndex}")
		survey.noteFunction(project, module: module, signatures: signatures, func: func, funcIndexByName: funcNames.byName, funcIndex: funcIndex, dispatch: dispatch, globalsByLabel: globalsByLabel)
	end 'eachFunc'

	survey.settleCallGraph()

	if blockingRuleApplies 'e3139'
		checkServiceCallCycles(project, signatures: signatures, funcNames: funcNames, survey: survey)
	end 'e3139'

	if globalRuleApplies or letRuleApplies 'aMessageMayReachModuleStorage'
		let reached = functionsSeedsCanRun(funcNames, survey: survey, seeds: survey.messageSeeds, dispatch: dispatch)

		if globalRuleApplies 'e3143'
			checkServiceGlobalAccesses(project, signatures: signatures, funcNames: funcNames, survey: survey, reached: reached)
		end 'e3143'

		if letRuleApplies 'e3162'
			checkUnmarkableLetReads(project, funcNames: funcNames, survey: survey, reached: reached)
		end 'e3162'
	end 'aMessageMayReachModuleStorage'

	let initializers = initializerCallees(project, module: module, funcNames: funcNames)

	if initializerRuleApplies 'e3163'
		checkSpawnsDuringGlobalInitialization(project, module: module, funcNames: funcNames, survey: survey, dispatch: dispatch, initializers: initializers)
	end 'e3163'

	if letInitializerRuleApplies 'e3164'
		checkLetInitializersReachNoVar(project, funcNames: funcNames, survey: survey, dispatch: dispatch, initializers: initializers)
	end 'e3164'
end 'checkServiceRules'

// Each managed global's slot label, keyed to its position in `globals`.
function managedGlobalsByLabel(globals ManagedGlobalArray) returns SlotSubjectByLabel
	var byLabel = SlotSubjectByLabel.create()

	for (position, global) in globals.withIterator() 'eachGlobal'
		byLabel.upsert(global.label, value: position.index() as SlotSubjectIndex)
	end 'eachGlobal'

	return byLabel
end 'managedGlobalsByLabel'

// Only an initializer that calls can reach another global, and only a `var` among the managed globals is refused.
function aLetInitializerMayReachAVar(globals ManagedGlobalArray) returns bool
	var holdsAVar = false
	var holdsACallingLet = false

	for global in globals 'eachGlobal'
		if global.isAVar() 'aVar'
			holdsAVar = true
		end 'aVar' else if global.initCallees.count() > 0 'aCallingLet'
			holdsACallingLet = true
		end 'aCallingLet'
	end 'eachGlobal'

	return holdsAVar and holdsACallingLet
end 'aLetInitializerMayReachAVar'

// Does this op take a function's ADDRESS — put a callable value somewhere a later `indirectCall` can find
// it? The bands are `runTimeTargetOf`'s, so a newly appended op fails to compile here too, and this
// predicate's accepting direction is the dangerous one: a function value this walk cannot see is a target
// `widenFrom` would leave out.
function opTakesAFunctionsAddress(op MaxonOp) returns bool
	return match op 'op'
		call or
			literal or
			ret or
			retVoid or
			binOp or
			unaryOp or
			compare or
			condBranch or
			branch gives false
		globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			tryCall gives false
		throwError or
			propagateError or
			panicAbort gives false
		functionRef gives true
		indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch gives false
		witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode gives false
		serviceSpawn or
			serviceSend or
			serviceReplyCell gives false
		immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness gives false
	end 'op'
end 'opTakesAFunctionsAddress'
