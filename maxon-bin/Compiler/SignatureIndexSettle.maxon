extension ProgramSignatures
	function settledDeclarations() returns SettledDeclarations
		return match self.ownSettled 'source'
			held(declarations) gives declarations
			readsPublished gives self.sharedSettled
		end 'source'
	end 'settledDeclarations'

	function mainThreadSettled() returns SettledDeclarations
		return match self.ownSettled 'source'
			held(declarations) gives declarations
			readsPublished panic("ProgramSignatures: a front-end worker reads the published declarations and has no declarations of its own to read or add to")
		end 'source'
	end 'mainThreadSettled'

	// --- MODULE DIRECTORIES and the ONE visibility decision ---

	// The two alias registries' provenance ranks claims against the module directories this index
	// records, through the SAME map. A copy of the index does not keep that sharing, so every holder
	// of one that goes on folding re-shares (`LibraryBaseline.copiedBaseline`), or the registries
	// would read directories nothing writes any more.
	function placeRootUnderStdlibDirectory(under bool)
		self.rootIsUnderStdlibDirectory = under
		self.shareModuleDirectoriesWithProvenance()
	end 'placeRootUnderStdlibDirectory'

	export function shareModuleDirectoriesWithProvenance()
		self.mainThreadSettled().typeAliases.provenance.shareFilePartition(self.mainThreadSettled().fileModuleDirectories, libraryPaths: self.mainThreadSettled().libraryFilePaths, underTheLibraryCone: self.rootIsUnderStdlibDirectory)
		self.mainThreadSettled().functionTypeAliases.provenance.shareFilePartition(self.mainThreadSettled().fileModuleDirectories, libraryPaths: self.mainThreadSettled().libraryFilePaths, underTheLibraryCone: self.rootIsUnderStdlibDirectory)
	end 'shareModuleDirectoriesWithProvenance'

	// File this file's module directory. Called once per file by `Queries.foldOneFileInto`, before the
	// file's declarations are folded, so `isVisibleFrom` can answer about any declaration the moment
	// the sweep ends. LAST-WINS is unreachable rather than tolerated: the sweep visits each path
	// exactly once.
	//
	// The directory rides the hash: it decides unexported visibility and a file's namespace, so moving a
	// file changes what other files compile to while no file's bytes change.
	export function recordFileModuleDirectory(path FilePath, moduleDirectory String, isLibrary bool, isRuntime bool, isScriptlib bool)
		self.mainThreadSettled().fileModuleDirectories.upsert(path.toString(), value: moduleDirectory)
		self.noteNamespaceQualifiers(freeze qualifierForNamespace(namespaceForModuleDirectory(moduleDirectory)).toByteArray())
		self.hash = mixBytes(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeModuleDirectory), bytes: path.toString().toByteArray()), bytes: moduleDirectory.toByteArray())

		if isLibrary 'aFileTheCompilerLoadedFromItsLibrary'
			self.mainThreadSettled().libraryFilePaths.insert(path.toString())
		end 'aFileTheCompilerLoadedFromItsLibrary'

		if isRuntime 'aFileOfTheRuntimeTier'
			self.mainThreadSettled().runtimeFilePaths.insert(path.toString())
		end 'aFileOfTheRuntimeTier'

		if isScriptlib 'aFileOfTheScriptlibTier'
			self.mainThreadSettled().scriptlibFilePaths.insert(path.toString())
		end 'aFileOfTheScriptlibTier'
	end 'recordFileModuleDirectory'

	function hasRecordedFile(path FilePath) returns bool
		return self.settledDeclarations().fileModuleDirectories.contains(path.toString())
	end 'hasRecordedFile'

	function noteNamespaceQualifiers(qualifier immutable ByteArray)
		for at in 0 upto qualifier.count() 'eachSeparator'
			if (try qualifier.get(at) otherwise panic("ProgramSignatures.noteNamespaceQualifiers: get OOB at {at} inside its own count()")) == QualifiedAliasSeparatorByte as Byte 'aProperPrefixEnds'
				self.mainThreadSettled().namespaceQualifiers.insert(freeze try qualifier.slice(0, endIndex: at) otherwise panic("ProgramSignatures.noteNamespaceQualifiers: slice [0, {at}) of a {qualifier.count()}-byte qualifier"))
			end 'aProperPrefixEnds'
		end 'eachSeparator'

		self.mainThreadSettled().namespaceQualifiers.insert(qualifier)
	end 'noteNamespaceQualifiers'

	export function attributeHashEventsTo(source HashEventSource)
		if self.baseline.settled 'pastTheBaseline'
			panic("ProgramSignatures.attributeHashEventsTo: the baseline is settled, so its hash chains are final and a parse writes none — nothing may attribute hash events to a source now")
		end 'pastTheBaseline'

		if self.hashSource == source 'alreadyThere'
			return
		end 'alreadyThere'

		self.saveActiveChain()
		self.hashSource = source
		self.hash = self.chainStateOf(source)
	end 'attributeHashEventsTo'

	function saveActiveChain()
		match self.hashSource 'active'
			author then self.authorChainState = self.hash
			library then self.libraryChainState = self.hash
			whole then self.wholeChainState = self.hash
		end 'active'
	end 'saveActiveChain'

	function chainStateOf(source HashEventSource) returns HashDigest
		return match source 'chain'
			author gives self.authorChainState
			library gives self.libraryChainState
			whole gives self.wholeChainState
		end 'chain'
	end 'chainStateOf'

	export function noteDeclaredName(name ByteArray)
		match self.hashSource 'source'
			author then self.insertAuthorDeclaredName(mixBytes(Hasher.empty(), bytes: name))
			library then self.noteMentionedName(name)
			whole then break
		end 'source'
	end 'noteDeclaredName'

	function insertAuthorDeclaredName(digest HashDigest)
		self.mainThreadSettled().authorDeclaredNames.insert(digest)

		if self.mainThreadSettled().libraryMeantNames.contains(digest) 'theLibraryMeansIt'
			self.authorNameMeantByTheLibrary = true
		end 'theLibraryMeansIt'
	end 'insertAuthorDeclaredName'

	export function noteMentionedName(name ByteArray)
		match self.hashSource 'source'
			library then self.insertMeantName(name)
			author or
			whole then break
		end 'source'
	end 'noteMentionedName'

	function insertMeantName(name ByteArray)
		self.insertMeantDigest(mixBytes(Hasher.empty(), bytes: name))

		let owner = try nameQualifierOf(name) otherwise return
		self.insertMeantDigest(mixBytes(Hasher.empty(), bytes: owner))
	end 'insertMeantName'

	function insertMeantDigest(digest HashDigest)
		self.mainThreadSettled().libraryMeantNames.insert(digest)

		if self.mainThreadSettled().authorDeclaredNames.contains(digest) 'anAuthorDeclaresIt'
			self.authorNameMeantByTheLibrary = true
		end 'anAuthorDeclaresIt'
	end 'insertMeantDigest'

	function mixTypeNameTable(state HashDigest, upTo TypeNameId) returns HashDigest
		var out = state

		for id in 0 upto upTo 'eachName'
			out = mixBytes(out, bytes: self.nameOfId(id))
		end 'eachName'

		return out
	end 'mixTypeNameTable'

	function mixInstanceRows(state HashDigest, upTo GenericInstanceId) returns HashDigest
		var out = state

		for id in 0 upto upTo 'eachRow'
			out = self.mixInstanceRow(out, id: id)
		end 'eachRow'

		return out
	end 'mixInstanceRows'

	function mixInstanceRow(state HashDigest, id GenericInstanceId) returns HashDigest
		return Hasher.combined(Hasher.combined(self.mixGenericInstance(Hasher.combined(state, value: DeclShapeInstanceRow), id: id), value: self.rowShape(id).hashWord()), value: SpeculativeRowMark if self.rowIsSpeculative(id) else NamedRowMark)
	end 'mixInstanceRow'

	export function footprintOf(instances GenericInstanceIdSet, names ObservedNameSet, dispatchedInterfaces ObservedInterfaceSet) returns ParseFootprint
		let pending = GenericInstanceIdArray.create(0)

		for id in instances 'eachSeen'
			pending.push(id)
		end 'eachSeen'

		var cursor = 0 as ElementIndex

		while cursor < pending.count() 'untilTheClosure'
			let id = try pending.get(cursor) otherwise panic("ProgramSignatures.footprintOf: pending.get OOB at {cursor} below count {pending.count()}")
			cursor = cursor + 1
			let watcher = rowMentions(self.rowBaseId(id), args: self.rowArgs(id))

			for nested in watcher.seenInstances 'eachNested'
				if not instances.contains(nested) 'aNewRow'
					instances.insert(nested)
					pending.push(nested)
				end 'aNewRow'
			end 'eachNested'

			for name in watcher.seenNames 'eachName'
				names.insert(name)
			end 'eachName'
		end 'untilTheClosure'

		pending.sort()

		let footprint = ParseFootprint.create()

		for id in pending 'eachRow'
			footprint.rows.push(FootprintRow.create(id, baseId: self.rowBaseId(id), args: self.rowArgs(id).clone(), shape: self.rowShape(id), speculative: self.rowIsSpeculative(id), compiledName: self.mangleGenericInstance(id)))
		end 'eachRow'

		for name in names 'eachNameInTheFootprint'
			footprint.nameIds.push(name)
			footprint.nameBytes.push(self.nameOfId(name))
		end 'eachNameInTheFootprint'

		let declared = InterfaceIndexArray.create(dispatchedInterfaces.count(), zeroed: false)

		for index in dispatchedInterfaces 'eachDispatchedInterface'
			declared.push(index)
		end 'eachDispatchedInterface'

		declared.sort()

		for index in declared 'eachInterfaceInTheFootprint'
			footprint.interfaces.push(FootprintInterface.create(index, name: self.interfaceNameAtDeclIndex(index)))
		end 'eachInterfaceInTheFootprint'

		return footprint
	end 'footprintOf'

	function footprintRemap(names NameIdMap, highest TypeNameId, instances GenericInstanceIdMap) returns TypeIdRemap
		let dense = TypeNameIdArray.create(highest + 1, zeroed: false)

		for id in 0 to highest 'eachSlot'
			dense.push(try names.get(id) otherwise id)
		end 'eachSlot'

		return TypeIdRemap.create(dense, namesBase: 0, instances: instances)
	end 'footprintRemap'

	export function rebaseFor(footprint ParseFootprint) returns ParseRebase throws SharedMemoMiss
		self.requireAtBaseline("the rebase of a shared library parse")
		let names = NameIdMap.create()
		var highest = 0 as TypeNameId

		for (position, id) in footprint.nameIds.withIterator() 'eachName'
			let bytes = try footprint.nameBytes.get(position.index()) otherwise panic("ProgramSignatures.rebaseFor: nameBytes.get OOB at {position.index()} — the footprint's two name columns are filled together")
			names.upsert(id, value: try self.typeNames.idOf(bytes) otherwise throw SharedMemoMiss.footprintMoved)

			if id > highest 'aNewHighest'
				highest = id
			end 'aNewHighest'
		end 'eachName'

		let instances = GenericInstanceIdMap.create()
		let remap = self.footprintRemap(names, highest: highest, instances: instances)

		for row in footprint.rows 'eachRow'
			let current = try self.findRow(remap.applyName(row.baseId), args: remapMaxonTypes(row.args, remap: remap), shape: row.shape) otherwise throw SharedMemoMiss.footprintMoved

			if self.rowIsSpeculative(current) != row.speculative or not self.mangleGenericInstance(current).equals(row.compiledName) 'aGuessBecameAFact'
				throw SharedMemoMiss.footprintMoved
			end 'aGuessBecameAFact'

			instances.upsert(row.id, value: current)
		end 'eachRow'

		let movedInterfaces = InterfaceIndexMap.create()

		for held in footprint.interfaces 'eachDispatchedInterface'
			let current = try self.interfaceDeclIndexOf(held.name) otherwise throw SharedMemoMiss.footprintMoved

			if current != held.declIndex 'theInterfaceMoved'
				movedInterfaces.upsert(held.declIndex, value: current)
			end 'theInterfaceMoved'
		end 'eachDispatchedInterface'

		return ParseRebase.create(names, instances: instances.clone(), interfaces: movedInterfaces, nameBaseline: self.typeNames.baselineNameCount())
	end 'rebaseFor'

	export function rebasedMintsAbsentFromTheBaseline(mints LocalInstanceMints, rebase ParseRebase) returns LocalInstanceMints throws SharedMemoMiss
		let rebased = mints.rebased(rebase)

		for row in rebased.rows 'eachMintedRow'
			if row.baseId >= rebased.typeNameBaseline 'aNameThisParseInterned'
				continue
			end 'aNameThisParseInterned'

			if self.holdsRow(row.baseId, args: row.args, shape: row.shape) 'theBaselineHoldsIt'
				throw SharedMemoMiss.footprintMoved
			end 'theBaselineHoldsIt'
		end 'eachMintedRow'

		return rebased
	end 'rebasedMintsAbsentFromTheBaseline'

	export function toldAnswersHold(mints LocalInstanceMints, overrides RowSetOverrideTable) returns bool
		for key in mints.rowSetAnswers.order 'eachQuestion'
			let told = try mints.rowSetAnswers.records.get(key) otherwise panic("ProgramSignatures.toldAnswersHold: the log orders a question it holds no record of")
			let expected = try overrides.answerFor(key) otherwise self.answerOverTheRows(told.query)

			if rowSetAnswerIsAffirmative(told.answer) != rowSetAnswerIsAffirmative(expected) 'theAnswerMoved'
				return false
			end 'theAnswerMoved'
		end 'eachQuestion'

		return true
	end 'toldAnswersHold'

	function instantiatedDigestExcluding(excluded HashDigestSet) returns HashDigest
		var members = Hasher.empty()

		for name in self.settledDeclarations().instantiatedByAParse 'eachName'
			if not nameIsExcluded(name, excluded: excluded) 'aLibraryName'
				members = members xor mixBytes(Hasher.empty(), bytes: name)
			end 'aLibraryName'
		end 'eachName'

		return members
	end 'instantiatedDigestExcluding'

	function finishHashChains()
		self.saveActiveChain()
		self.libraryHash = Hasher.combined(Hasher.combined(self.libraryChainState, value: SignatureDiscriminator.libraryChainSalt), value: self.wholeChainState)
		self.hash = Hasher.combined(Hasher.combined(self.authorChainState, value: SignatureDiscriminator.authorChainSalt), value: self.libraryHash)
		self.hashSource = HashEventSource.whole
		self.libraryParseSharing = self.decidedLibraryParseSharing()
	end 'finishHashChains'

	function decidedLibraryParseSharing() returns LibraryParseSharing
		if self.rootIsUnderStdlibDirectory 'theProjectIsTheLibrary'
			return LibraryParseSharing.rootInsideStdlib
		end 'theProjectIsTheLibrary'

		if self.settledDeclarations().interfaces.hasLibraryRenames() 'aLibraryTypeIsShadowed'
			return LibraryParseSharing.shadowed
		end 'aLibraryTypeIsShadowed'

		if self.authorNamesOverlapTheLibrary() 'theLibraryMeansAnAuthorName'
			return LibraryParseSharing.namesOverlap
		end 'theLibraryMeansAnAuthorName'

		return LibraryParseSharing.shareable
	end 'decidedLibraryParseSharing'

	export function authorNamesOverlapTheLibrary() returns bool
		return self.authorNameMeantByTheLibrary
	end 'authorNamesOverlapTheLibrary'

	export function libraryTypeNamesTheAuthorContests() returns NameRoster
		let contested = NameRoster.create(0)

		for name in self.settledDeclarations().userDeclaredTypeNames 'eachAuthorType'
			if self.settledDeclarations().stdlibDeclaredTypeNames.contains(name) and self.authorContestsTheLibraryName(name) 'theLibraryDeclaresIt'
				contested.push(name)
			end 'theLibraryDeclaresIt'
		end 'eachAuthorType'

		return contested
	end 'libraryTypeNamesTheAuthorContests'

	// The token stream `decl`'s initializer range indexes. A miss is a compiler bug: the fold keeps the stream of every
	// file it records a binding of, until `evaluateInitializers` has settled every one.
	function declTokensOf(decl TopLevelDecl) returns TokenArray
		return self.declTokenStreamOf(decl).prepared.tokens
	end 'declTokensOf'

	export function declTokenStreamPaths() returns FilePathArray
		let paths = FilePathArray.create(self.settledDeclarations().declTokenStreams.count(), zeroed: false)

		for (path, _) in self.settledDeclarations().declTokenStreams 'eachStream'
			paths.push(try FilePath.from(path) otherwise panic("ProgramSignatures.declTokenStreamPaths: '{path}' keys a token stream and is not a path, and every key is spelled from the path of the file the fold kept"))
		end 'eachStream'

		return paths
	end 'declTokenStreamPaths'

	export function restoreDeclTokenStream(path String, stream DeclTokenStream)
		self.mainThreadSettled().declTokenStreams.upsert(path, value: stream)
	end 'restoreDeclTokenStream'

	function declTokenStreamOf(decl TopLevelDecl) returns DeclTokenStream
		return try self.settledDeclarations().declTokenStreams.get(decl.declFilePath.toString()) otherwise panic("ProgramSignatures.declTokenStreamOf: '{String.from(decl.name)}' was recorded from {decl.declFilePath}, whose token stream the fold did not keep or the settled evaluation released")
	end 'declTokenStreamOf'

	// The module directory of a file the sweep folded. A MISS IS A COMPILER BUG, not a file at the root: the
	// root's directory is the empty string and is recorded like any other, so an absent entry means a path
	// reached a visibility question without ever having been swept — and answering `""` would silently place
	// that file in the root module, where every unmarked declaration in the program is visible to it.
	export function moduleDirectoryOf(path FilePath) returns String
		return self.moduleDirectoryOfPathText(path.toString())
	end 'moduleDirectoryOf'

	function scopeOf(path FilePath) returns DirectoryScope
		return DirectoryScope.create(self.moduleDirectoryOf(path), anchoredInTheLibraryCone: anchoredInTheLibraryCone(self.settledDeclarations().libraryFilePaths, sharesTheLibraryCone: self.rootIsUnderStdlibDirectory, path: path.toString()), isLibrary: self.declaredByTheCorpus(path))
	end 'scopeOf'

	// The one display rule for a source file: `__file__`, caller-file defaults, contested-instance notes and
	// generic instance names all use it. The module directory is joined in because two directories can hold
	// files of one name; a root file is unique by name alone.
	export function projectRelativeFileDisplay(path FilePath) returns String
		return projectRelativeDisplay(self.moduleDirectoryOf(path), path: path)
	end 'projectRelativeFileDisplay'

	export function genericInstanceNameOf(template GenericFunctionTemplate, arguments GenericFunctionArgumentArray) returns immutable ByteArray
		return template.instanceName(arguments, declaringFile: self.projectRelativeFileDisplay(template.declFilePath))
	end 'genericInstanceNameOf'

	// The same answer for a caller already holding the STRINGIFIED path — which is the map's key, so a
	// `contestedGenericAliases` group (keyed by declaring-file text, `GenericAliasByDeclaringFile`) reads it
	// without a `FilePath` round trip. The miss is `moduleDirectoryIn`'s panic, stated once.
	function moduleDirectoryOfPathText(pathText String) returns String
		return moduleDirectoryIn(self.settledDeclarations().fileModuleDirectories, path: pathText)
	end 'moduleDirectoryOfPathText'

	// The `.`-joined NAMESPACE a file is shown as — what `Queries.parseJobFor` stamps onto `ParseJob.namespace`, from
	// which a declaration's qualified spelling is minted (`namespaceQualifiedName`). ⚠ Nothing downstream of
	// the parser holds a namespace, because a `dir.fn()` reference resolves to the bare declared name at
	// parse time — there is no `IrFunction.namespace` to read.
	// Rendered from the stored directory rather than stored beside it: two fields would be two chances to
	// disagree, and only the directory can be inverted back into segments.
	export function namespaceOf(path FilePath) returns String
		return namespaceForModuleDirectory(self.moduleDirectoryOf(path))
	end 'namespaceOf'

	// ⭐⭐ **MAY `readerFilePath` NAME A DECLARATION MADE IN `declFilePath` AT TIER `visibility`?** —
	// this index's door onto `visibleThroughModuleDirectories`, for every kind of declaration there is:
	// a function, a nominal type, a ranged typealias, a top-level binding, a field.
	//
	// The `unexported` arm decides on a per-file INDEX of module directories rather than by stringifying
	// both `FilePath.parent()`s at every ask, and then runs a separator-guarded prefix test — see
	// `moduleDirectoryContains`, and `PortablePathSeparator` for what the guard costs when the
	// joiner is a character a directory name may contain.
	//
	// ⚠ **A DECLARATION'S OWN FILE ALWAYS MAY**, in every tier — visibility governs who ELSE may see a
	// declaration, never whether it is in scope where it was written. Every tier contains its own file by
	// construction.
	export function isVisibleFrom(visibility Visibility, declFilePath FilePath, readerFilePath FilePath) returns bool
		return visibleThroughModuleDirectories(self.settledDeclarations().fileModuleDirectories, libraryFiles: self.settledDeclarations().libraryFilePaths, sharesTheLibraryCone: self.rootIsUnderStdlibDirectory, visibility: visibility, declPath: declFilePath.toString(), readerPath: readerFilePath.toString())
	end 'isVisibleFrom'

	// ⭐ **`isVisibleFrom`'S ANSWER AS THE VERDICT A REFUSING CALLER NEEDS** — the bool plus the TIER the
	// refusal is worded by. Written once so the function door (`calleeVisibilityFrom`) and the
	// binding door (`declVisibilityFrom`) cannot come to spell one rule two ways; each supplies the tier and
	// the declaring file off its own record, which is all they differ in.
	function symbolVisibility(visibility Visibility, declFilePath FilePath, readerFilePath FilePath) returns SymbolVisibility
		if self.isVisibleFrom(visibility, declFilePath: declFilePath, readerFilePath: readerFilePath) 'nameableHere'
			return SymbolVisibility.visible
		end 'nameableHere'

		return SymbolVisibility.hidden(visibility)
	end 'symbolVisibility'

	// ⭐ **MAY `readerFilePath` NAME THIS RANGED ALIAS?** The alias-shaped face of `isVisibleFrom`,
	// kept as its own name because the two answers it separates are the point: a hidden alias is still
	// FOUND, which is what tells "no declaration binds this name anywhere" (E3011, at the `as`) from
	// "one does, elsewhere, and did not export it" (E3008, at the
	// target name). Folding the test into `lookup` would collapse the two into the sharper one's
	// wording and report the wrong mistake.
	//
	// ⚠ **ITS ONE CALLER IS THE LSP** (`visibleAliasFile`), which must not point a reader at a
	// declaration it may not name. The compile refuses a hidden type name through
	// `Parser.bareTypeNameVerdict`, at every position a type is written.
	export function aliasVisibleFrom(alias RangedTypeAlias, readerFilePath FilePath) returns bool
		return self.isVisibleFrom(alias.visibility, declFilePath: alias.declFilePath, readerFilePath: readerFilePath)
	end 'aliasVisibleFrom'

	// --- The stdlib/user SHADOW CONTEST. See `StdlibShadowRenameMap`. ---

	export function noteWrittenTypeClaim(name ByteArray, claim TypeNameClaim)
		let claims = try self.mainThreadSettled().writtenTypeClaims.get(name) otherwise TypeNameClaimArray.create(0)
		claims.push(claim)
		self.mainThreadSettled().writtenTypeClaims.upsert(name, value: claims)

		if self.recordsTypeClaims 'aSourceClaimsFoldIsAsking'
			let kept = try self.mainThreadSettled().claimedTypeClaims.get(name) otherwise TypeNameClaimArray.create(0)
			kept.push(claim)
			self.mainThreadSettled().claimedTypeClaims.upsert(name, value: kept)
		end 'aSourceClaimsFoldIsAsking'
	end 'noteWrittenTypeClaim'

	export function recordTypeClaims()
		self.recordsTypeClaims = true
	end 'recordTypeClaims'

	export function settleAliasFamiliesBesideNominals()
		let written = self.mainThreadSettled().writtenTypeClaims
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.writtenTypeClaims = TypeNameClaimLog.create()

		for (name, claims) in written 'eachWrittenName'
			if not isCompilerOwnedTypeName(name) and claimsHoldBothAliasAndNominal(claims) and everyClaimMayCoexist(name, claims: claims, directories: self.mainThreadSettled().fileModuleDirectories) 'anAliasBesideANominal'
				self.mainThreadSettled().aliasFamiliesBesideNominals.insert(name)
				self.crossKindContestsForWrite().upsert(name, value: claims)
			end 'anAliasBesideANominal'
		end 'eachWrittenName'
	end 'settleAliasFamiliesBesideNominals'

	export function noteHeaderTypeNameDecl(decl TypeNameDecl)
		self.mainThreadSettled().headerTypeNameDecls.push(decl)
	end 'noteHeaderTypeNameDecl'

	export function settleNominalNameCollisions(paths FilePathArray)
		let declared = TypeNameDeclArray.create(0)

		for decl in self.mainThreadSettled().headerTypeNameDecls 'eachHeaderDecl'
			if isCompilerOwnedTypeName(decl.name) or (not decl.claim.declaredByTheCorpus and isCompilerReservedName(decl.name)) 'theParserRefusesTheName'
				continue
			end 'theParserRefusesTheName'

			declared.push(self.libraryDeclarationUnderItsMintedName(decl))
		end 'eachHeaderDecl'

		for collision in nominalNameCollisionsOf(declared, paths: paths, directories: self.mainThreadSettled().fileModuleDirectories) 'eachCollision'
			self.mainThreadSettled().nominalNameCollisions.push(collision)
		end 'eachCollision'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.headerTypeNameDecls = TypeNameDeclArray.create(0)
	end 'settleNominalNameCollisions'

	export function settleAuthorMints()
		self.settleNominalMints()
		self.settleBindingMints()
		self.settleServiceSpawnTargets()
	end 'settleAuthorMints'

	function settleLibraryBindingMints() returns bool
		let contested = NameRoster.create(0)

		for (name, sites) in self.mainThreadSettled().topLevelBindingSites 'eachBindingName'
			if self.libraryNeedsMintsFor(name, sites: sites) 'aLibraryContestNotYetMinted'
				contested.push(name)
			end 'aLibraryContestNotYetMinted'
		end 'eachBindingName'

		if contested.count() == 0 'nothingIsContested'
			return false
		end 'nothingIsContested'

		self.attributeHashEventsTo(HashEventSource.library)

		for name in contested 'eachContestedName'
			self.mainThreadSettled().libraryContestedBindingNames.insert(name)

			for site in try self.mainThreadSettled().topLevelBindingSites.get(name) otherwise panic("ProgramSignatures.settleLibraryBindingMints: '{String.from(name)}' was read out of topLevelBindingSites a moment ago") 'eachSite'
				if not self.libraryBindingIsMinted(site) 'keepsTheBareName'
					continue
				end 'keepsTheBareName'

				self.mintAuthorName(name, declFilePath: site.declFilePath, rootKeepsTheBareName: false)
				self.hash = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeLibraryBindingMint), bytes: self.authorMintOf(site.declFilePath, name: name))
			end 'eachSite'
		end 'eachContestedName'

		for name in contested 'eachMintedName'
			self.noteMintedBindingSites(name)
		end 'eachMintedName'

		self.attributeHashEventsTo(HashEventSource.whole)

		return true
	end 'settleLibraryBindingMints'

	function libraryBindingIsMinted(site TopLevelBindingSite) returns bool
		return site.visibility == Visibility.unexported and self.declaredByTheCorpus(site.declFilePath)
	end 'libraryBindingIsMinted'

	function libraryNeedsMintsFor(name ByteArray, sites TopLevelBindingSiteArray) returns bool
		if not self.layerSitesSpanDirectories(sites, inTheLibrary: true) 'nothingIsContested'
			return false
		end 'nothingIsContested'

		for site in sites 'eachSiteMinted'
			if self.libraryBindingIsMinted(site) and not self.settledDeclarations().authorMints.contains(fileScopedDeclKey(name, declFilePath: site.declFilePath)) 'aSiteWithoutItsMint'
				return true
			end 'aSiteWithoutItsMint'
		end 'eachSiteMinted'

		return false
	end 'libraryNeedsMintsFor'

	// Runs after the nominal and binding mints settle: each candidate's type is resolved through them, and
	// the key carries the reader's directory, so two directories spelling one contested type name stay two
	// candidates.
	function settleServiceSpawnTargets()
		self.sortServiceSpawnCandidates()

		if self.settledDeclarations().contestedNominalClaims.count() == 0 or self.settledDeclarations().serviceSpawnCandidateList.isEmpty() 'noSpawnNamesAContestedType'
			return
		end 'noSpawnNamesAContestedType'

		let candidates = ServiceSpawnCandidateArray.create(0)
		let keys = ServiceSpawnCandidateKeyIndex.create()

		for candidate in self.settledDeclarations().serviceSpawnCandidateList 'eachCandidate'
			let typeName = self.authorNominalNameMeantBy(candidate.typeName, readerFilePath: candidate.declFilePath)
			let key = spawnCandidateKey(typeName, member: candidate.member, gate: candidate.gate, directory: self.moduleDirectoryOf(candidate.declFilePath))

			if keys.contains(key) 'alreadyNoted'
				continue
			end 'alreadyNoted'

			keys.upsert(key, value: candidates.count())
			candidates.push(ServiceSpawnCandidate.create(typeName, member: candidate.member, gate: candidate.gate.clone(), declFilePath: candidate.declFilePath, line: candidate.line, column: candidate.column))
		end 'eachCandidate'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.serviceSpawnCandidateList = candidates
		ownDeclarations.serviceSpawnCandidateKeys = keys
	end 'settleServiceSpawnTargets'

	function settleBindingMints()
		let contested = NameRoster.create(0)
		let libraryContested = DeclaredTypeNameSet.create()

		for (name, sites) in self.mainThreadSettled().topLevelBindingSites 'eachBindingName'
			let contest = self.bindingContestOf(sites)

			if contest == BindingContest.uncontested 'nothingContestsIt'
				continue
			end 'nothingContestsIt'

			contested.push(name)

			if contest == BindingContest.withTheLibrary 'theLibraryDeclaresItToo'
				libraryContested.insert(name)
			end 'theLibraryDeclaresItToo'
		end 'eachBindingName'

		if contested.count() == 0 'nothingIsContested'
			return
		end 'nothingIsContested'

		self.attributeHashEventsTo(HashEventSource.author)

		for name in contested 'eachContestedName'
			self.mainThreadSettled().contestedBindingNames.insert(name)

			let sites = try self.mainThreadSettled().topLevelBindingSites.get(name) otherwise panic("ProgramSignatures.settleBindingMints: '{String.from(name)}' was read out of topLevelBindingSites a moment ago")

			for (iter, site) in sites.withIterator() 'eachSite'
				if self.declaredByTheCorpus(site.declFilePath) 'aLibrarysBinding'
					continue
				end 'aLibrarysBinding'

				let holderKey = directoryNameKey(name, directory: self.moduleDirectoryOf(site.declFilePath))
				self.mainThreadSettled().bindingSiteHolders.upsert(holderKey, value: holderAfterNoting(self.mainThreadSettled().bindingSiteHolders, key: holderKey, index: iter.index()))

				self.mintAuthorName(name, declFilePath: site.declFilePath, rootKeepsTheBareName: not libraryContested.contains(name))
			end 'eachSite'
		end 'eachContestedName'

		for name in contested 'eachMintedName'
			self.noteMintedBindingSites(name)
		end 'eachMintedName'

		self.attributeHashEventsTo(HashEventSource.whole)
	end 'settleBindingMints'

	function noteMintedBindingSites(name ByteArray)
		let minted = TopLevelBindingSiteArray.create(0)
		let mints = NameRoster.create(0)

		for site in try self.mainThreadSettled().topLevelBindingSites.get(name) otherwise panic("ProgramSignatures.noteMintedBindingSites: '{String.from(name)}' is a contested binding name, which topLevelBindingSites holds") 'eachSite'
			let mint = self.authorMintOf(site.declFilePath, name: name)

			if not mint.equals(name) 'aMintedSite'
				minted.push(TopLevelBindingSite.create(site.visibility, declFilePath: site.declFilePath))
				mints.push(mint)
			end 'aMintedSite'
		end 'eachSite'

		for (iter, site) in minted.withIterator() 'eachMintedSite'
			self.noteTopLevelBinding(try mints.get(iter.index()) otherwise panic("ProgramSignatures.noteMintedBindingSites: mints and minted sites are pushed together"), site: site)
		end 'eachMintedSite'
	end 'noteMintedBindingSites'

	function bindingContestOf(sites TopLevelBindingSiteArray) returns BindingContest
		var authorsDeclareIt = false
		var libraryDeclaresIt = false

		for site in sites 'eachSite'
			if self.declaredByTheCorpus(site.declFilePath) 'theLibrarys'
				libraryDeclaresIt = true
				continue
			end 'theLibrarys'

			authorsDeclareIt = true
		end 'eachSite'

		if not authorsDeclareIt 'noAuthorDeclaresIt'
			return BindingContest.uncontested
		end 'noAuthorDeclaresIt'

		if libraryDeclaresIt 'theLibraryDeclaresItToo'
			return BindingContest.withTheLibrary
		end 'theLibraryDeclaresItToo'

		return BindingContest.amongAuthors if self.layerSitesSpanDirectories(sites, inTheLibrary: false) else BindingContest.uncontested
	end 'bindingContestOf'

	function layerSitesSpanDirectories(sites TopLevelBindingSiteArray, inTheLibrary bool) returns bool
		var firstDirectory = NoModuleDirectoryPrefix
		var seenASite = false

		for site in sites 'eachSite'
			if self.declaredByTheCorpus(site.declFilePath) != inTheLibrary 'anotherLayersSite'
				continue
			end 'anotherLayersSite'

			let directory = self.moduleDirectoryOf(site.declFilePath)

			if not seenASite 'theFirstDirectory'
				seenASite = true
				firstDirectory = directory
				continue
			end 'theFirstDirectory'

			if directory != firstDirectory 'aSecondDirectory'
				return true
			end 'aSecondDirectory'
		end 'eachSite'

		return false
	end 'layerSitesSpanDirectories'

	function settleNominalMints()
		let firstDirectory = NominalFirstDirectoryMap.create()
		let contested = DeclaredTypeNameSet.create()

		for decl in self.mainThreadSettled().headerTypeNameDecls 'eachHeaderDecl'
			if not declaresAnAuthorNominalName(decl) 'notAnAuthorNominal'
				continue
			end 'notAnAuthorNominal'

			let directory = self.moduleDirectoryOf(decl.claim.declFilePath)

			if let held = try firstDirectory.get(decl.name) 'aLaterDeclaration'
				if held != directory 'inAnotherDirectory'
					contested.insert(decl.name)
				end 'inAnotherDirectory'

				continue
			end 'aLaterDeclaration'

			firstDirectory.upsert(decl.name, value: directory)
		end 'eachHeaderDecl'

		if contested.count() == 0 'nothingIsContested'
			return
		end 'nothingIsContested'

		self.attributeHashEventsTo(HashEventSource.author)

		for decl in self.mainThreadSettled().headerTypeNameDecls 'eachContestedDecl'
			if decl.claim.declaredByTheCorpus or not contested.contains(decl.name) 'notAnAuthorsContestedName'
				continue
			end 'notAnAuthorsContestedName'

			let claims = try self.mainThreadSettled().contestedNominalClaims.get(decl.name) otherwise TypeNameClaimArray.create(0)
			claims.push(decl.claim)
			self.mainThreadSettled().contestedNominalClaims.upsert(decl.name, value: claims)

			let holderKey = directoryNameKey(decl.name, directory: self.moduleDirectoryOf(decl.claim.declFilePath))
			self.mainThreadSettled().contestedClaimHolders.upsert(holderKey, value: holderAfterNoting(self.mainThreadSettled().contestedClaimHolders, key: holderKey, index: claims.count() - 1))

			if not isTypeAliasDecl(decl.claim.kind) 'aNominalDeclaration'
				self.mintAuthorName(decl.name, declFilePath: decl.claim.declFilePath, rootKeepsTheBareName: true)
			end 'aNominalDeclaration'
		end 'eachContestedDecl'

		self.attributeHashEventsTo(HashEventSource.whole)
	end 'settleNominalMints'

	function mintAuthorName(name ByteArray, declFilePath FilePath, rootKeepsTheBareName bool)
		let directory = self.moduleDirectoryOf(declFilePath)

		if directory.isEmpty() and rootKeepsTheBareName 'theRootKeepsTheBareName'
			return
		end 'theRootKeepsTheBareName'

		let minted = authorMintSpelling(name, directory: directory)
		self.noteDeclaredName(minted)
		self.mainThreadSettled().authorMints.upsert(fileScopedDeclKey(name, declFilePath: declFilePath), value: minted)
	end 'mintAuthorName'

	function noteAuthorMintSpellings(spellings StdlibShadowSpellingArray, spelled WrittenMintSet)
		for (name, claims) in self.mainThreadSettled().contestedNominalClaims 'eachContestedNominal'
			for claim in claims 'eachClaim'
				if not isTypeAliasDecl(claim.kind) 'aNominalDeclaration'
					self.noteAuthorMintSpelling(spellings, spelled: spelled, name: name, declFilePath: claim.declFilePath)
				end 'aNominalDeclaration'
			end 'eachClaim'
		end 'eachContestedNominal'

		for (name, sites) in self.mainThreadSettled().topLevelBindingSites 'eachBindingName'
			if not self.bindingNameIsContested(name) 'uncontested'
				continue
			end 'uncontested'

			for site in sites 'eachSite'
				self.noteAuthorMintSpelling(spellings, spelled: spelled, name: name, declFilePath: site.declFilePath)
			end 'eachSite'
		end 'eachBindingName'
	end 'noteAuthorMintSpellings'

	function bindingNameIsContested(name ByteArray) returns bool
		return self.settledDeclarations().contestedBindingNames.contains(name) or self.settledDeclarations().libraryContestedBindingNames.contains(name)
	end 'bindingNameIsContested'

	// Runs after every file has folded: `noteFreeFunctionDeclaration` decides the function contest during the
	// fold, so asked earlier this finds no contested name and spells no mint.
	export function settleContestedFunctionSpellings()
		if self.settledDeclarations().contestedFreeFunctions.count() == 0 'noFunctionIsContested'
			return
		end 'noFunctionIsContested'

		let spellings = StdlibShadowSpellingArray.create(0)

		for spelling in self.settledDeclarations().shadowRoster.spellings 'eachSettledSpelling'
			spellings.push(spelling)
		end 'eachSettledSpelling'

		let spelled = WrittenMintSet.create()

		for (name, directories) in self.settledDeclarations().contestedFreeFunctions 'eachContestedFunction'
			for directory in directories 'eachDirectory'
				if directory.isEmpty() 'theRootKeepsTheBareName'
					continue
				end 'theRootKeepsTheBareName'

				self.noteMintedSpelling(spellings, spelled: spelled, name: name, minted: freeFunctionRegistrationName(name, moduleDirectory: directory), namespace: namespaceForModuleDirectory(directory))
			end 'eachDirectory'
		end 'eachContestedFunction'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.shadowRoster = ShadowSpellingRoster.of(spellings)
	end 'settleContestedFunctionSpellings'

	function noteAuthorMintSpelling(spellings StdlibShadowSpellingArray, spelled WrittenMintSet, name ByteArray, declFilePath FilePath)
		let minted = self.authorMintOf(declFilePath, name: name)

		if minted.equals(name) 'nothingNewToSpell'
			return
		end 'nothingNewToSpell'

		self.noteMintedSpelling(spellings, spelled: spelled, name: name, minted: minted, namespace: qualifierForNamespace(self.namespaceOf(declFilePath)))
	end 'noteAuthorMintSpelling'

	function noteMintedSpelling(spellings StdlibShadowSpellingArray, spelled WrittenMintSet, name ByteArray, minted ByteArray, namespace String)
		if spelled.contains(minted) 'alreadySpelled'
			return
		end 'alreadySpelled'

		spelled.insert(minted)
		let qualified = namespaceQualifiedName(namespace, name: name)
		spellings.push(StdlibShadowSpelling.create(namespaceQualifiedName(namespace, name: minted), qualified: qualified, bare: name))
		spellings.push(StdlibShadowSpelling.create(minted, qualified: qualified, bare: name))
	end 'noteMintedSpelling'

	export function hasAuthorMints() returns bool
		return self.settledDeclarations().contestedNominalClaims.count() > 0 or self.settledDeclarations().contestedBindingNames.count() > 0
	end 'hasAuthorMints'

	function hasLibraryMints() returns bool
		return self.settledDeclarations().libraryContestedBindingNames.count() > 0
	end 'hasLibraryMints'

	export function authorMintOf(declFilePath FilePath, name immutable ByteArray) returns immutable ByteArray
		if not self.settledDeclarations().contestedNominalClaims.contains(name) and not self.bindingNameIsContested(name) 'uncontested'
			return name
		end 'uncontested'

		return try self.settledDeclarations().authorMints.get(fileScopedDeclKey(name, declFilePath: declFilePath)) otherwise name
	end 'authorMintOf'

	function bareBindingMeaning(name ByteArray, readerFilePath FilePath) returns BareBindingMeaning
		if not self.bindingNameIsContested(name) or not self.settledDeclarations().fileModuleDirectories.contains(readerFilePath.toString()) 'uncontestedOrAReaderTheSweepNeverVisited'
			return BareBindingMeaning.unrelated
		end 'uncontestedOrAReaderTheSweepNeverVisited'

		let readerIsTheLibrary = self.declaredByTheCorpus(readerFilePath)
		let mintedLayer = self.settledDeclarations().libraryContestedBindingNames if readerIsTheLibrary else self.settledDeclarations().contestedBindingNames

		if not mintedLayer.contains(name) 'theReadersLayerMintsNothingOfThisName'
			return BareBindingMeaning.unrelated
		end 'theReadersLayerMintsNothingOfThisName'

		let sites = try self.settledDeclarations().topLevelBindingSites.get(name) otherwise panic("ProgramSignatures.bareBindingMeaning: '{String.from(name)}' is a contested binding name, which topLevelBindingSites holds")

		return match self.bindingScopeVerdict(sites, name: name, readerFilePath: readerFilePath, readerIsTheLibrary: readerIsTheLibrary) 'meaning'
			meant(index, _) gives self.bindingIdentityAt(sites, at: index, name: name)
			nowhere gives BareBindingMeaning.unrelated
			ambiguous gives BareBindingMeaning.ambiguous(self.bindingCandidatesFor(sites, name: name, readerFilePath: readerFilePath, readerIsTheLibrary: readerIsTheLibrary))
		end 'meaning'
	end 'bareBindingMeaning'

	function bindingScopeVerdict(sites TopLevelBindingSiteArray, name ByteArray, readerFilePath FilePath, readerIsTheLibrary bool) returns NameScopeVerdict
		if not readerIsTheLibrary 'anAuthorsReaderConsultsTheDirectoryHolders'
			match nearNameScope(self.bindingHoldingIn(sites, name: name, directory: self.moduleDirectoryOf(readerFilePath), readerFilePath: readerFilePath), theRoot: self.bindingHoldingIn(sites, name: name, directory: NoModuleDirectoryPrefix, readerFilePath: readerFilePath)) 'near'
				held(index, tier) then return NameScopeVerdict.meant(index, tier: tier)
				vacant or
				contested then break
			end 'near'
		end 'anAuthorsReaderConsultsTheDirectoryHolders'

		let tally = NameScopeTally.create()

		for (iter, site) in sites.withIterator() 'eachSite'
			tally.note(self.declarationTier(site.declFilePath, visibility: site.visibility, readerFilePath: readerFilePath), at: iter.index())
		end 'eachSite'

		return tally.verdict()
	end 'bindingScopeVerdict'

	function bindingHoldingIn(sites TopLevelBindingSiteArray, name ByteArray, directory String, readerFilePath FilePath) returns ScopeHolding
		return match self.bindingSiteHolderIn(name, directory: directory) 'holder'
			absent gives ScopeHolding.vacant
			several gives ScopeHolding.contested
			one(index) gives self.bindingHeldAt(sites, at: index, readerFilePath: readerFilePath)
		end 'holder'
	end 'bindingHoldingIn'

	function bindingHeldAt(sites TopLevelBindingSiteArray, at ElementIndex, readerFilePath FilePath) returns ScopeHolding
		let site = try sites.get(at) otherwise panic("ProgramSignatures.bindingHeldAt: sites.get OOB at {at} of {sites.count()} sites, a position the holder index recorded")
		return heldIfNameable(at, tier: self.declarationTier(site.declFilePath, visibility: site.visibility, readerFilePath: readerFilePath))
	end 'bindingHeldAt'

	function bindingSiteHolderIn(name ByteArray, directory String) returns DirectoryHolder
		return try self.settledDeclarations().bindingSiteHolders.get(directoryNameKey(name, directory: directory)) otherwise DirectoryHolder.absent
	end 'bindingSiteHolderIn'

	function declarationTier(declFilePath FilePath, visibility Visibility, readerFilePath FilePath) returns ScopeTier
		if self.declaredByTheCorpus(declFilePath) != self.declaredByTheCorpus(readerFilePath) 'aDeclarationOfAnotherLayer'
			return ScopeTierHidden
		end 'aDeclarationOfAnotherLayer'

		return self.settledDeclarations().typeAliases.provenance.tierOfDeclaration(declFilePath, visibility: visibility, readerPath: readerFilePath.toString())
	end 'declarationTier'

	export function bareBindingIdentity(name immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		return match self.bareBindingMeaning(name, readerFilePath: readerFilePath) 'meaning'
			declared(identity) gives identity
			unrelated or
			ambiguous gives name
		end 'meaning'
	end 'bareBindingIdentity'

	// Compares the nearest author function's tier with the nearest author binding's tier for one name: a
	// function in the reader's own directory outranks every binding, and a function at the root outranks a
	// binding outside the reader's own directory. A library reader answers false.
	function functionOutranksBinding(name ByteArray, readerFilePath FilePath) returns bool
		if not self.declaresCallee(name) and not self.isContestedFreeFunction(name) or not self.settledDeclarations().fileModuleDirectories.contains(readerFilePath.toString()) or self.declaredByTheCorpus(readerFilePath) 'noFunctionBearsTheNameHere'
			return false
		end 'noFunctionBearsTheNameHere'

		let functionTier = self.authorFunctionTier(name, readerFilePath: readerFilePath)

		if functionTier < ScopeTierRoot 'noNearFunction'
			return false
		end 'noNearFunction'

		return functionTier >= ScopeTierReadersDirectory or self.authorBindingTier(name, readerFilePath: readerFilePath) < ScopeTierReadersDirectory
	end 'functionOutranksBinding'

	function authorFunctionTier(name ByteArray, readerFilePath FilePath) returns ScopeTier
		let own = self.authorFunctionTierUnder(freeFunctionRegistrationName(name, moduleDirectory: self.moduleDirectoryOf(readerFilePath)) if self.isContestedFreeFunction(name) else name, readerFilePath: readerFilePath)

		if own >= ScopeTierReadersDirectory 'inTheReadersDirectory'
			return own
		end 'inTheReadersDirectory'

		let root = self.authorFunctionTierUnder(name, readerFilePath: readerFilePath)
		return root if root > own else own
	end 'authorFunctionTier'

	function authorFunctionTierUnder(key ByteArray, readerFilePath FilePath) returns ScopeTier
		var best = ScopeTierHidden as ScopeTier

		if let declaration = try self.sweptDeclarationOf(key) 'declared'
			if self.declarationIsVisibleFrom(key, declaration: declaration, readerFilePath: readerFilePath) 'nameableHere'
				best = self.declarationTier(declaration.declFilePath, visibility: declaration.visibility, readerFilePath: readerFilePath)
			end 'nameableHere'
		end 'declared'

		return best
	end 'authorFunctionTierUnder'

	function authorBindingTier(name ByteArray, readerFilePath FilePath) returns ScopeTier
		let tally = NameScopeTally.create()
		let sites = try self.settledDeclarations().topLevelBindingSites.get(name) otherwise return ScopeTierHidden

		for (iter, site) in sites.withIterator() 'eachSite'
			tally.note(self.declarationTier(site.declFilePath, visibility: site.visibility, readerFilePath: readerFilePath), at: iter.index())
		end 'eachSite'

		return tally.bestTier
	end 'authorBindingTier'

	function bindingIdentityAt(sites TopLevelBindingSiteArray, at ElementIndex, name ByteArray) returns BareBindingMeaning
		let site = try sites.get(at) otherwise panic("ProgramSignatures.bindingIdentityAt: sites.get OOB at {at}, an index the walk over these sites just read")
		return BareBindingMeaning.declared(self.authorMintOf(site.declFilePath, name: name))
	end 'bindingIdentityAt'

	function bindingCandidatesFor(sites TopLevelBindingSiteArray, name ByteArray, readerFilePath FilePath, readerIsTheLibrary bool) returns NameRoster
		let candidates = NameRoster.create(0)

		for site in sites 'eachSite'
			if self.bindingSiteIsReadableInTheReadersLayer(site, readerFilePath: readerFilePath, readerIsTheLibrary: readerIsTheLibrary) 'aReadableBindingOfTheReadersLayer'
				candidates.push(namespaceQualifiedName(qualifierForNamespace(self.namespaceOf(site.declFilePath)), name: name))
			end 'aReadableBindingOfTheReadersLayer'
		end 'eachSite'

		return candidates
	end 'bindingCandidatesFor'

	function bindingSiteIsReadableInTheReadersLayer(site TopLevelBindingSite, readerFilePath FilePath, readerIsTheLibrary bool) returns bool
		return self.declaredByTheCorpus(site.declFilePath) == readerIsTheLibrary and self.isVisibleFrom(site.visibility, declFilePath: site.declFilePath, readerFilePath: readerFilePath)
	end 'bindingSiteIsReadableInTheReadersLayer'

	export function qualifiedBindingIdentity(qualified ByteArray, readerFilePath FilePath) returns immutable ByteArray throws AbsentError
		match splitQualifiedName(qualified) 'split'
			notQualified then throw AbsentError.absent
			parts(qualifier, member) then return try self.bindingIdentityQualifiedBy(qualifier, member: member, readerFilePath: readerFilePath)
		end 'split'
	end 'qualifiedBindingIdentity'

	function bindingIdentityQualifiedBy(qualifier ByteArray, member ByteArray, readerFilePath FilePath) returns immutable ByteArray throws AbsentError
		if self.declaredByTheCorpus(readerFilePath) 'aLibraryReader'
			throw AbsentError.absent
		end 'aLibraryReader'

		for site in try self.settledDeclarations().topLevelBindingSites.get(member) otherwise throw AbsentError.absent 'eachSite'
			if not self.bindingSiteIsReadableInTheReadersLayer(site, readerFilePath: readerFilePath, readerIsTheLibrary: false) 'notReadableHere'
				continue
			end 'notReadableHere'

			if qualifierForNamespace(self.namespaceOf(site.declFilePath)).toByteArray().equals(qualifier) 'theQualifiedDirectory'
				return self.authorMintOf(site.declFilePath, name: member)
			end 'theQualifiedDirectory'
		end 'eachSite'

		throw AbsentError.absent
	end 'bindingIdentityQualifiedBy'

	export function authorNominalNameMeantBy(name ByteArray, readerFilePath FilePath) returns immutable ByteArray
		let claims = try self.settledDeclarations().contestedNominalClaims.get(name) otherwise return name

		if not self.settledDeclarations().fileModuleDirectories.contains(readerFilePath.toString()) 'aReaderTheSweepNeverVisited'
			return name
		end 'aReaderTheSweepNeverVisited'

		var meantAt = 0 as ElementIndex

		match self.settledDeclarations().typeAliases.provenance.meantAuthorClaimNear(claims, readerPath: readerFilePath.toString(), readersDirectory: self.contestedClaimHolderIn(name, directory: self.moduleDirectoryOf(readerFilePath)), theRoot: self.contestedClaimHolderIn(name, directory: NoModuleDirectoryPrefix)) 'nearest'
			nowhere or
			ambiguous then return name
			meant(index, _) then meantAt = index
		end 'nearest'

		let claim = try claims.get(meantAt) otherwise panic("ProgramSignatures.authorNominalNameMeantBy: claims.get OOB at {meantAt}, an index the nearest-claim walk just returned")

		if isTypeAliasDecl(claim.kind) 'anAliasIsMeant'
			return name
		end 'anAliasIsMeant'

		return self.authorMintOf(claim.declFilePath, name: name)
	end 'authorNominalNameMeantBy'

	function contestedClaimHolderIn(name ByteArray, directory String) returns DirectoryHolder
		return try self.settledDeclarations().contestedClaimHolders.get(directoryNameKey(name, directory: directory)) otherwise DirectoryHolder.absent
	end 'contestedClaimHolderIn'

	function libraryDeclarationUnderItsMintedName(decl TypeNameDecl) returns TypeNameDecl
		if not decl.claim.declaredByTheCorpus or isTypeAliasDecl(decl.claim.kind) 'notALibraryNominal'
			return decl
		end 'notALibraryNominal'

		return TypeNameDecl.create(self.settledDeclarations().interfaces.libraryNameOf(decl.name), claim: decl.claim, nameLine: decl.nameLine, nameColumn: decl.nameColumn)
	end 'libraryDeclarationUnderItsMintedName'

	export function collidingNominalDeclarations() returns TypeNameCollisionArray
		return self.settledDeclarations().nominalNameCollisions
	end 'collidingNominalDeclarations'

	export function isAliasFamilyBesideANominal(name ByteArray) returns bool
		return self.settledDeclarations().aliasFamiliesBesideNominals.contains(name)
	end 'isAliasFamilyBesideANominal'

	export function aliasFamilyIdentity(name immutable ByteArray) returns immutable ByteArray
		return aliasFamilyMint(name) if self.settledDeclarations().aliasFamiliesBesideNominals.contains(name) else name
	end 'aliasFamilyIdentity'

	function writtenTypeNameIdentity(name immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if not self.settledDeclarations().aliasFamiliesBesideNominals.contains(name) or not self.writtenNameMeansAnAliasHere(name, readerFilePath: readerFilePath) 'theNameItself'
			return name
		end 'theNameItself'

		return aliasFamilyMint(name)
	end 'writtenTypeNameIdentity'

	export function noteUserDeclaredTypeName(name ByteArray)
		self.mainThreadSettled().userDeclaredTypeNames.insert(name)
	end 'noteUserDeclaredTypeName'

	export function userDeclaredNominalNames() returns StringArray
		return self.userDeclaredTypeNamesOfKind(false)
	end 'userDeclaredNominalNames'

	export function userDeclaredAliasNames() returns StringArray
		return self.userDeclaredTypeNamesOfKind(true)
	end 'userDeclaredAliasNames'

	function userDeclaredTypeNamesOfKind(aliases bool) returns StringArray
		let names = StringArray.create(0)

		for (name, claims) in self.settledDeclarations().claimedTypeClaims 'eachWrittenName'
			for claim in claims 'eachClaim'
				if not claim.declaredByTheCorpus and isTypeAliasDecl(claim.kind) == aliases 'anAuthorsDeclarationOfThisKind'
					names.push(String.from(name))
					break
				end 'anAuthorsDeclarationOfThisKind'
			end 'eachClaim'
		end 'eachWrittenName'

		names.sortBy(function(left String, right String) gives left.compare(right))
		return names
	end 'userDeclaredTypeNamesOfKind'

	export function userExtensionMethodKeys() returns StringArray
		let keys = StringArray.create(0)

		for (qualified, _) in self.settledDeclarations().extensionMethodDeclFiles 'eachExtensionMethod'
			if not self.settledDeclarations().stdlibPublishedExtensionMethods.contains(qualified) 'anAuthorsMethod'
				keys.push(String.from(qualified))
			end 'anAuthorsMethod'
		end 'eachExtensionMethod'

		return keys
	end 'userExtensionMethodKeys'

	export function noteTopLevelTypeClaim(qualifier String, name ByteArray, claim TypeNameClaim)
		let qualified = namespaceQualifiedName(qualifier, name: name)
		let spelled = try self.mainThreadSettled().qualifiedTypeClaims.get(qualified) otherwise TypeNameClaimArray.create(0)
		spelled.push(claim)
		self.mainThreadSettled().qualifiedTypeClaims.upsert(qualified, value: spelled)

		let heads = try self.mainThreadSettled().typeHeadClaims.get(name) otherwise TypeNameClaimArray.create(0)
		heads.push(claim)
		self.mainThreadSettled().typeHeadClaims.upsert(name, value: heads)
	end 'noteTopLevelTypeClaim'

	function aliasDeclarationFileMeantBy(written ByteArray, readerFilePath FilePath) returns FilePath throws AbsentError
		let claims = try self.typeClaimsWritten(written)
		var anUnmarkedAlias = false

		for claim in claims 'eachClaim'
			anUnmarkedAlias = anUnmarkedAlias or (isTypeAliasDecl(claim.kind) and claim.visibility == Visibility.unexported)
		end 'eachClaim'

		if not anUnmarkedAlias 'nothingForTheNameToCredit'
			throw AbsentError.absent
		end 'nothingForTheNameToCredit'

		let ranked = self.rankedClaimIn(claims, readerFilePath: readerFilePath)

		if ranked.hiddenFromTheReader or not isTypeAliasDecl(ranked.claim.kind) 'noAliasIsMeant'
			throw AbsentError.absent
		end 'noAliasIsMeant'

		return ranked.claim.declFilePath
	end 'aliasDeclarationFileMeantBy'

	function typeClaimsWritten(written ByteArray) returns TypeNameClaimArray throws AbsentError
		match splitQualifiedName(written) 'spelling'
			notQualified then return try self.settledDeclarations().typeHeadClaims.get(written) otherwise throw AbsentError.absent
			parts then return try self.settledDeclarations().qualifiedTypeClaims.get(written) otherwise throw AbsentError.absent
		end 'spelling'
	end 'typeClaimsWritten'

	function typeHeadKindOf(name ByteArray, readerFilePath FilePath) returns TypeHeadKind
		var kind = TypeHeadKind.absent
		let heads = try self.settledDeclarations().typeHeadClaims.get(name) otherwise return TypeHeadKind.absent

		if heads.count() > 1 'severalDeclarationsHoldTheName'
			match self.settledDeclarations().typeAliases.provenance.meantAuthorClaimIn(heads, readerPath: readerFilePath.toString()) 'nearest'
				meant(index, _) then return TypeHeadKind.nominal if claimIsNominal(try heads.get(index) otherwise panic("ProgramSignatures.typeHeadKindOf: heads.get OOB at {index}, an index the nearest-claim walk just returned")) else TypeHeadKind.other
				nowhere or
				ambiguous then break
			end 'nearest'
		end 'severalDeclarationsHoldTheName'

		for claim in heads 'eachClaim'
			if self.claimReach(claim, readerFilePath: readerFilePath) == CandidateReach.hidden 'hiddenHere'
				continue
			end 'hiddenHere'

			if claimIsNominal(claim) 'aNominalType'
				return TypeHeadKind.nominal
			end 'aNominalType'

			kind = TypeHeadKind.other
		end 'eachClaim'

		return kind
	end 'typeHeadKindOf'

	export function namesANamespace(qualifier ByteArray) returns bool
		return self.settledDeclarations().namespaceQualifiers.contains(qualifier)
	end 'namesANamespace'

	export function noteTopLevelBinding(name ByteArray, site TopLevelBindingSite)
		let sites = try self.mainThreadSettled().topLevelBindingSites.get(name) otherwise TopLevelBindingSiteArray.create(0)
		sites.push(site)
		self.mainThreadSettled().topLevelBindingSites.upsert(name, value: sites)
	end 'noteTopLevelBinding'

	export function topLevelBindingVisibleFrom(name ByteArray, readerFilePath FilePath) returns bool
		for site in try self.settledDeclarations().topLevelBindingSites.get(name) otherwise return false 'eachSite'
			if self.isVisibleFrom(site.visibility, declFilePath: site.declFilePath, readerFilePath: readerFilePath) 'visibleHere'
				return true
			end 'visibleHere'
		end 'eachSite'

		return false
	end 'topLevelBindingVisibleFrom'

	// Every type name a LISTED STDLIB module declares, in the order the contest's token walk found them.
	// Recorded BEFORE any of them is contested, because `shadowRenameIsTaken` has to be able to ask about a
	// module the walk has not reached yet — see `stdlibDeclaredTypeNames`.
	export function noteStdlibDeclaredTypeNames(names NameRoster)
		for name in names 'each'
			self.mainThreadSettled().stdlibDeclaredTypeNames.insert(name)
		end 'each'
	end 'noteStdlibDeclaredTypeNames'

	// ⭐⭐ **RECORD ONE `type <Name> … implements … BuiltinArrayLiteral` DECLARATION.** Called by
	// `Queries.discoverWholeProgramTokenFacts`, once per such declaration, before the first file is folded.
	//
	// ⚠ **THE STDLIB'S IS SINGLED OUT BECAUSE IT ANSWERS A DIFFERENT QUESTION FROM THE OTHERS.** Every
	// conformer is a name whose instances ARE the managed record (`isArrayBaseName`); exactly one of them is
	// the record every stdlib SIGNATURE is written against, and that one is the fold target a
	// `__ManagedMemory` written outside any conformer's body must reach. A user's own conformer cannot serve
	// that role — a `ByteArray` handed back by `String.toByteArray()` is the corpus's record, and folding
	// `__ManagedMemory` in a user file onto `Bag` would give one record two ids at every crossing.
	//
	// ⛔⛔ **MORE THAN ONE STDLIB DECLARATION CARRIES THE MARKER.** `stdlib/FixedArray.maxon` does too, and
	// it is walked after `Array`: taking the last would make `corpusArrayRecordName` `FixedArray`, turn
	// `isArrayBaseName(b"Array")` FALSE and refuse `stdlib/Array.maxon`'s own `Self{managed: managed}`
	// as E2015 — every program in the tree failing to compile. A single-valued fact derived from a
	// marker two declarations carry is decided by walk order unless something breaks the tie.
	//
	// ⭐⭐ **THE TIEBREAK IS THE SKIP BELOW**, and it serves a USER file too: a user program declaring
	// `type FixedArray uses Element implements BuiltinArrayLiteral` reaches `noteArrayLiteralConformer`
	// with no stdlib module at all, and without the skip `Vec3.create()` would lose the size that is
	// part of its type, with no diagnostic. See `isBuiltinGenericBaseNameBesidesTheRecord` for the
	// `List` twin; the two `array-declared-record.error.a-conformer-named-for-…` cases pin both.
	//
	// The rule the skip states: a name the compiler already serves a container under is not made an ARRAY declaration
	// by the marker. A `FixedArray`'s size is the second coordinate of its instance identity
	// (`GenericInstanceRegistry.fixedSizes`, see `FixedArrayBuiltinBaseName`), so `FixedArray with 3 Int` is not the
	// record a `__ManagedMemory with Int` folds onto and never can be — one instance would have to be two —
	// and its literal already has its own door (`Parser.parseFixedArrayFromConstruction`, a RETYPE of the array
	// literal rather than an identity). A `List`'s record is a chain of nodes and shares nothing but the word.
	//
	// ⇒ **ONE SKIP CLOSES BOTH HALVES, WHICH IS WHY IT IS HERE AND NOT AT EITHER SYMPTOM.** The loud half is
	// the stdlib one: a second STDLIB conformer takes `corpusArrayRecordName` outright, so listing
	// `stdlib/FixedArray.maxon` made `isArrayBaseName(b"Array")` FALSE and refused `stdlib/Array.maxon:111`'s own
	// identity — every program in the tree, `return 7` included. The quiet half is the user one above, where
	// `isArrayBaseName` goes TRUE through the `hasNonCorpusArrayConformer` widening and
	// `Parser.dispatchMethodOnReceiver` — which asks the array arm FIRST — serves `push`/`resize` on a
	// fixed-size receiver. Same cause, opposite volume.
	//
	// ⚠ **THE SKIP IS SILENT HERE AND THE REFUSAL IS AT THE CONSTRUCTION**, because that is where the noun is
	// right: `Parser.requireNameIsNotABuiltinContainerBase`. The marker's own conformance requires a
	// `static init(value __ManagedMemory) returns Self` (E3016 without one), so every legal conformer builds
	// the identity this compiler cannot honour under such a name, and the declaration is refused there rather
	// than being quietly ignored.
	export function noteArrayLiteralConformer(name ByteArray, isStdlibSource bool)
		if self.isBuiltinGenericBaseNameBesidesTheRecord(name) 'compilerAlreadyServesAContainerUnderThisName'
			return
		end 'compilerAlreadyServesAContainerUnderThisName'

		if not self.declaresTheArrayLiteralMarker(name) 'firstDeclarationOfThisName'
			self.mainThreadSettled().arrayLiteralConformers.push(name)
		end 'firstDeclarationOfThisName'

		if isStdlibSource 'theCorpusDeclaresTheRecord'
			let ownDeclarations = self.mainThreadSettled()
			ownDeclarations.corpusArrayRecordName = ArrayRecordName.of(name)
			return
		end 'theCorpusDeclaresTheRecord'

		self.hasNonCorpusArrayConformer = true
	end 'noteArrayLiteralConformer'

	// ⭐ **NOTE ONE `spawn <T>.<member>(…)` SITE** — the NOTE half, on `noteArrayLiteralConformer`'s
	// shape: the token walk states what it saw and this index decides nothing yet. The same pair from a second
	// site is dropped, so a type spawned from twenty places is minted once and the diagnostic every one of
	// those sites raises is decided from one classification.
	export function noteServiceSpawnCandidate(typeName ByteArray, member ByteArray, gate SpawnGate, declFilePath FilePath, line LineNumber, column ColumnNumber)
		let key = spawnCandidateKey(typeName, member: member, gate: gate, directory: self.moduleDirectoryOf(declFilePath))

		if let position = try self.mainThreadSettled().serviceSpawnCandidateKeys.get(key) 'alreadyNoted'
			self.keepEarliestSpawnSite(position, declFilePath: declFilePath, line: line, column: column)
			return
		end 'alreadyNoted'

		self.mainThreadSettled().serviceSpawnCandidateKeys.upsert(key, value: self.mainThreadSettled().serviceSpawnCandidateList.count())
		self.mainThreadSettled().serviceSpawnCandidateList.push(ServiceSpawnCandidate.create(typeName, member: member, gate: gate, declFilePath: declFilePath, line: line, column: column))
		self.spawnsAnyServiceSettled = false
	end 'noteServiceSpawnCandidate'

	function keepEarliestSpawnSite(position ElementIndex, declFilePath FilePath, line LineNumber, column ColumnNumber)
		let held = try self.settledDeclarations().serviceSpawnCandidateList.get(position) otherwise panic("ProgramSignatures.keepEarliestSpawnSite: serviceSpawnCandidateList.get OOB at {position}")

		if not SourceSite.of(declFilePath, line: line, column: column).precedes(SourceSite.of(held.declFilePath, line: held.line, column: held.column)) 'heldIsEarlier'
			return
		end 'heldIsEarlier'

		try self.mainThreadSettled().serviceSpawnCandidateList.set(position, value: ServiceSpawnCandidate.create(held.typeName, member: held.member, gate: held.gate.clone(), declFilePath: declFilePath, line: line, column: column)) otherwise panic("ProgramSignatures.keepEarliestSpawnSite: serviceSpawnCandidateList.set OOB at {position}")
	end 'keepEarliestSpawnSite'

	function sortServiceSpawnCandidates()
		self.mainThreadSettled().serviceSpawnCandidateList.sortBy(function(left ServiceSpawnCandidate, right ServiceSpawnCandidate) gives SourceSite.of(left.declFilePath, line: left.line, column: left.column).compare(SourceSite.of(right.declFilePath, line: right.line, column: right.column)))

		let positions = ServiceSpawnCandidateKeyIndex.create()

		for position in 0 upto self.settledDeclarations().serviceSpawnCandidateList.count() 'eachCandidate'
			let candidate = try self.settledDeclarations().serviceSpawnCandidateList.get(position) otherwise panic("ProgramSignatures.sortServiceSpawnCandidates: serviceSpawnCandidateList.get OOB at {position}")
			positions.upsert(spawnCandidateKey(candidate.typeName, member: candidate.member, gate: candidate.gate, directory: self.moduleDirectoryOf(candidate.declFilePath)), value: position)
		end 'eachCandidate'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.serviceSpawnCandidateKeys = positions
	end 'sortServiceSpawnCandidates'

	export function serviceSpawnCandidates() returns ServiceSpawnCandidateArray
		return self.settledDeclarations().serviceSpawnCandidateList
	end 'serviceSpawnCandidates'

	// Asked per lowered value and per parsed declaration, so the answer is
	// memoized; every write that can move it — a spawn, a `default`, an adopted live-key set — clears
	// the memo.
	export function spawnsAnyService() returns bool
		if not self.spawnsAnyServiceSettled 'askedFirstSinceAChange'
			self.spawnsAnyServiceAnswer = self.anyServiceSpawnIsLive()
			self.spawnsAnyServiceSettled = true
		end 'askedFirstSinceAChange'

		return self.spawnsAnyServiceAnswer
	end 'spawnsAnyService'

	function anyServiceSpawnIsLive() returns bool
		for candidate in self.settledDeclarations().serviceSpawnCandidateList 'eachCandidate'
			if self.spawnIsLive(candidate) 'aLiveSpawn'
				return true
			end 'aLiveSpawn'
		end 'eachCandidate'

		return false
	end 'anyServiceSpawnIsLive'

	export function spawnIsLive(candidate ServiceSpawnCandidate) returns bool
		return match candidate.gate 'gate'
			always gives true
			defaultOf(declaration) gives self.defaultKeyIsLive(declaration.key) and self.defaultDeclarationWins(declaration)
			libraryBody gives self.liveSpawnedTypeNames.contains(spawnedTypeNameOf(self, candidate: candidate))
		end 'gate'
	end 'spawnIsLive'

	export function declaresALibraryBodySpawn() returns bool
		for candidate in self.settledDeclarations().serviceSpawnCandidateList 'eachCandidate'
			if candidate.gate.isLibraryBody() 'aLibrarySpawn'
				return true
			end 'aLibrarySpawn'
		end 'eachCandidate'

		return false
	end 'declaresALibraryBodySpawn'

	export function noteDefaultDeclaration(declaration DefaultDeclaration)
		self.mainThreadSettled().defaultDeclarationList.push(declaration)
		self.spawnsAnyServiceSettled = false
		self.mixIntoWholeChain(SignatureDiscriminator.declShapeDefaultDeclaration, bytes: declaration.key)
	end 'noteDefaultDeclaration'

	function mixIntoWholeChain(shape HashDigest, bytes ByteArray)
		match self.hashSource 'source'
			whole then self.hash = mixBytes(Hasher.combined(self.hash, value: shape), bytes: bytes)
			author or
			library then self.wholeChainState = mixBytes(Hasher.combined(self.wholeChainState, value: shape), bytes: bytes)
		end 'source'
	end 'mixIntoWholeChain'

	export function defaultDeclarations() returns DefaultDeclarationArray
		return self.settledDeclarations().defaultDeclarationList
	end 'defaultDeclarations'

	export function declaresADefault() returns bool
		return self.settledDeclarations().defaultDeclarationList.count() != 0
	end 'declaresADefault'

	export function declaresDefaultFor(key ByteArray) returns bool
		for declaration in self.settledDeclarations().defaultDeclarationList 'eachDeclaration'
			if declaration.key.equals(key) 'thisKey'
				return true
			end 'thisKey'
		end 'eachDeclaration'

		return false
	end 'declaresDefaultFor'

	export function winningDefaultOf(key ByteArray) returns DefaultDeclaration throws MapError
		if let programs = try self.firstDefaultAtTheLevel(key, isStdlibSource: false) 'theProgramsOwn'
			return programs
		end 'theProgramsOwn'

		return try self.firstDefaultAtTheLevel(key, isStdlibSource: true)
	end 'winningDefaultOf'

	// The one decider of which `default` is built (`winningDefaultOf`) and which E3169 blames
	// (`keptDefaultBeside`), so the declaration built is never the one refused.
	function firstDefaultAtTheLevel(key ByteArray, isStdlibSource bool) returns DefaultDeclaration throws MapError
		var seenOne = false
		var firstIndex = 0 as ElementIndex

		for (iter, declaration) in self.settledDeclarations().defaultDeclarationList.withIterator() 'eachDeclaration'
			if not declaration.key.equals(key) or declaration.isStdlibSource != isStdlibSource 'anotherLevelOrKey'
				continue
			end 'anotherLevelOrKey'

			if not seenOne or precedesInPathOrder(declaration.declFilePath, other: self.notedDefaultAt(firstIndex).declFilePath) 'firstInPathOrderSoFar'
				firstIndex = iter.index()
				seenOne = true
			end 'firstInPathOrderSoFar'
		end 'eachDeclaration'

		if not seenOne 'noDeclaration'
			throw MapError.keyNotFound
		end 'noDeclaration'

		return self.notedDefaultAt(firstIndex)
	end 'firstDefaultAtTheLevel'

	function notedDefaultAt(index ElementIndex) returns DefaultDeclaration
		return try self.settledDeclarations().defaultDeclarationList.get(index) otherwise panic("ProgramSignatures.notedDefaultAt: defaultDeclarationList.get OOB at {index} below count {self.settledDeclarations().defaultDeclarationList.count()}")
	end 'notedDefaultAt'

	export function defaultDeclarationWins(declaration DefaultDeclaration) returns bool
		let winner = try self.winningDefaultOf(declaration.key) otherwise panic("defaultDeclarationWins: `{String.from(declaration.key)}` has a declaration, so it has a winner")
		return winner.isTheSameDeclaration(declaration)
	end 'defaultDeclarationWins'

	export function keptDefaultBeside(declaration DefaultDeclaration) returns DefaultDeclaration throws MapError
		let first = try self.firstDefaultAtTheLevel(declaration.key, isStdlibSource: declaration.isStdlibSource)

		if first.isTheSameDeclaration(declaration) 'declaredFirst'
			throw MapError.keyNotFound
		end 'declaredFirst'

		return first
	end 'keptDefaultBeside'

	export function adoptLiveReach(filed LiveReach)
		if filed.sameReachAs(self.liveDefaultKeyNames, spawns: self.liveSpawnedTypeNames) 'alreadyAdopted'
			return
		end 'alreadyAdopted'

		self.liveDefaultKeyNames = copiedNames(filed.defaultKeys)
		self.liveSpawnedTypeNames = copiedNames(filed.spawnedTypes)
		self.liveKeyAdoptions = self.liveKeyAdoptions + 1
		self.spawnsAnyServiceSettled = false
	end 'adoptLiveReach'

	function fileServiceMessages(messages ServiceMessageIndex)
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.serviceMessages = messages
	end 'fileServiceMessages'

	function serviceMessageOf(callee ByteArray) returns ServiceMessage throws MapError
		return try self.settledDeclarations().serviceMessages.get(callee)
	end 'serviceMessageOf'

	export function namesAServiceMessage(callee ByteArray) returns bool
		return self.settledDeclarations().serviceMessages.contains(callee)
	end 'namesAServiceMessage'

	export function liveReach() returns LiveReach
		let reach = LiveReach.create()
		reach.replaceWith(self.liveDefaultKeyNames, spawns: self.liveSpawnedTypeNames)
		return reach
	end 'liveReach'

	export function liveKeysRevision() returns LiveKeysRevision
		return self.liveKeyAdoptions
	end 'liveKeysRevision'

	// ⚠ A parse reads liveness only through the by-reference convention (`byRefConventionDigestParsedBy`),
	// `spawnsAnyService()` and the defaults its own file declares, so a file's parse memo key carries only
	// those. A new liveness read in the parse must
	// join this digest, or a memoized parse outlives the answer it was built on.
	export function livenessDigestParsedBy(declFilePath FilePath) returns HashDigest
		var digest = Hasher.combined(Hasher.empty(), value: self.byRefConventionDigestParsedBy(declFilePath))

		if self.spawnsAnyService() 'aServiceIsSpawned'
			digest = Hasher.combined(digest, value: LivenessSpawnsAService)
		end 'aServiceIsSpawned'

		for declaration in self.settledDeclarations().defaultDeclarationList 'eachDeclaration'
			if declaration.declFilePath.equals(declFilePath) and self.defaultKeyIsLive(declaration.key) and self.defaultDeclarationWins(declaration) 'builtByThisFile'
				digest = Hasher.combinedBytes(Hasher.combined(digest, value: LivenessBuildsADefault), bytes: declaration.key)
			end 'builtByThisFile'
		end 'eachDeclaration'

		return digest
	end 'livenessDigestParsedBy'

	function byRefConventionDigestParsedBy(declFilePath FilePath) returns HashDigest
		self.requireByRefMasksSettled()

		if self.declaredByTheSharedCorpusAt(declFilePath.toString()) 'aCorpusFile'
			return self.corpusByRefConventionDigestAnswer
		end 'aCorpusFile'

		return self.byRefConventionDigestAnswer
	end 'byRefConventionDigestParsedBy'

	function requireByRefMasksSettled()
		if not self.byRefMasksSettled 'readBeforeTheBaseline'
			panic("ProgramSignatures: the by-reference conventions were read before `settleByRefConventions` settled them — a consumer reads them and computes nothing")
		end 'readBeforeTheBaseline'
	end 'requireByRefMasksSettled'

	export function settleByRefConventions()
		if self.byRefMasksSettled 'alreadySettled'
			return
		end 'alreadySettled'

		self.settleMarkerReferences()
		self.publishByRefNames()
		var digest = Hasher.empty()
		var corpusDigest = Hasher.empty()

		if self.programTakesAParamByRef() 'someFunctionTakesOne'
			digest = Hasher.combined(digest, value: LivenessTakesAParamByRef)
			digest = Hasher.combined(digest, value: nameSetDigest(self.settledDeclarations().byRefBareNames))
			corpusDigest = Hasher.combined(corpusDigest, value: LivenessTakesAParamByRef)
			let handedOffCallees = self.corpusHandOffCallees()
			corpusDigest = Hasher.combined(corpusDigest, value: nameSetDigestBeyond(self.settledDeclarations().byRefBareNames, excluded: self.corpusByRefBareNames(), among: handedOffCallees))

			if self.programHasMutableFunctionValues() 'aFunctionValueIsMutable'
				digest = Hasher.combined(digest, value: LivenessMutableFunctionValues)
				corpusDigest = Hasher.combined(corpusDigest, value: LivenessMutableFunctionValues)
			end 'aFunctionValueIsMutable'

			let witnessMasks = self.computedWitnessByRefMasks(false)
			digest = Hasher.combined(digest, value: witnessByRefMasksDigest(witnessMasks))
			corpusDigest = Hasher.combined(corpusDigest, value: witnessByRefMasksDigest(self.computedWitnessByRefMasks(true)))
			self.witnessByRefMasks = witnessMasks
			let fieldNames = self.computedFunctionValuedFieldNames(false)
			self.functionValuedFieldNames = fieldNames

			digest = Hasher.combined(Hasher.combined(digest, value: LivenessFunctionValuedField), value: nameSetDigest(fieldNames))
			corpusDigest = Hasher.combined(Hasher.combined(corpusDigest, value: LivenessFunctionValuedField), value: nameSetDigestBeyond(fieldNames, excluded: self.computedFunctionValuedFieldNames(true), among: handedOffCallees))
			corpusDigest = Hasher.combined(Hasher.combined(corpusDigest, value: LivenessHandedOffSlots), value: self.corpusHandOffSlotsDigest(fieldNames))
			corpusDigest = Hasher.combined(Hasher.combined(corpusDigest, value: LivenessAuthorConformerConventions), value: self.authorConformerConventionsDigest(self.corpusInterfaceCalleeNames()))
		end 'someFunctionTakesOne'

		self.byRefConventionDigestAnswer = digest
		self.corpusByRefConventionDigestAnswer = corpusDigest
		self.byRefMasksSettled = true
	end 'settleByRefConventions'

	function corpusByRefBareNames() returns BareNameSet
		let names = BareNameSet.create()

		for (name, sites) in self.settledDeclarations().byRefSitesOfKey 'eachKey'
			for site in sites 'eachDeclaration'
				let declaringFile = declaringFileOfSite(site)

				if not self.declaredByTheSharedCorpusAt(declaringFile) 'anAuthorsDeclaration'
					continue
				end 'anAuthorsDeclaration'

				let info = try self.settledDeclarations().funcParamReassigns.get(site) otherwise panic("corpusByRefBareNames: '{String.from(name)}' lists the declaration at '{String.from(site)}', and `recordParamReassigns` records every site it lists")

				if info.mutableParams != NoParamPositions 'takesSomethingByRef'
					names.insert(info.bareName)
				end 'takesSomethingByRef'
			end 'eachDeclaration'
		end 'eachKey'

		return names
	end 'corpusByRefBareNames'

	function noteCorpusHandOffs(facts CorpusHandOffs)
		let ownDeclarations = self.mainThreadSettled()
		mergedHandOffPositions(ownDeclarations.corpusIndirectHandOffs, added: facts.indirect)

		for (callee, positions) in facts.byCallee 'eachCallee'
			let held = try ownDeclarations.corpusHandOffsByCallee.get(callee) otherwise HandOffPositionsByArity.create()
			mergedHandOffPositions(held, added: positions)
			ownDeclarations.corpusHandOffsByCallee.upsert(callee, value: held)
		end 'eachCallee'
	end 'noteCorpusHandOffs'

	function corpusHandOffCallees() returns BareNameSet
		let callees = BareNameSet.create()

		for (callee, _) in self.settledDeclarations().corpusHandOffsByCallee 'eachCallee'
			callees.insert(callee)
		end 'eachCallee'

		return callees
	end 'corpusHandOffCallees'

	function corpusHandOffSlotsDigest(fieldNames BareNameSet) returns HashDigest
		var members = Hasher.empty()
		var counted = 0 as Count

		for (arity, positions) in self.corpusHandOffSlotsRead(fieldNames) 'eachArity'
			let taken = positions and (try self.settledDeclarations().freeFunctionByRefPositions.get(arity) otherwise NoParamPositions)

			if taken == NoParamPositions 'noReadSlotIsByReference'
				continue
			end 'noReadSlotIsByReference'

			members = members xor Hasher.combined(Hasher.combined(Hasher.empty(), value: arity as HashDigest), value: taken as HashDigest)
			counted = counted + 1
		end 'eachArity'

		return Hasher.combined(members, value: counted as HashDigest)
	end 'corpusHandOffSlotsDigest'

	function corpusHandOffSlotsRead(fieldNames BareNameSet) returns HandOffPositionsByArity
		let read = HandOffPositionsByArity.create()
		mergedHandOffPositions(read, added: self.settledDeclarations().corpusIndirectHandOffs)

		for (callee, positions) in self.settledDeclarations().corpusHandOffsByCallee 'eachCallee'
			if fieldNames.contains(callee) 'aCalleeThatMayBeAFieldValue'
				mergedHandOffPositions(read, added: positions)
			end 'aCalleeThatMayBeAFieldValue'
		end 'eachCallee'

		return read
	end 'corpusHandOffSlotsRead'

	function corpusInterfaceCalleeNames() returns BareNameSet
		let names = BareNameSet.create()
		let interfaces = BareNameSet.create()

		for interfaceName in self.settledDeclarations().interfaceNamesInDeclOrder 'eachInterface'
			match lookupInterface(self.settledDeclarations().interfaces, name: interfaceName) 'declared'
				found(iface) then self.noteCorpusInterface(iface, names: names, interfaces: interfaces)
				notFound then continue
			end 'declared'
		end 'eachInterface'

		for (qualified, member) in self.settledDeclarations().interfaceExtensionMembers 'eachExtensionMember'
			if not interfaces.contains(member.interfaceName) 'notACorpusInterface'
				continue
			end 'notACorpusInterface'

			match splitQualifiedName(qualified) 'qualified'
				parts(_, memberName) then names.insert(memberName)
				notQualified then continue
			end 'qualified'
		end 'eachExtensionMember'

		return names
	end 'corpusInterfaceCalleeNames'

	function noteCorpusInterface(iface IrInterface, names BareNameSet, interfaces BareNameSet)
		if not self.declaredByTheSharedCorpusAt(iface.declFilePath.toString()) 'anAuthorsInterface'
			return
		end 'anAuthorsInterface'

		interfaces.insert(iface.name)

		for method in iface.methods 'eachRequirement'
			names.insert(method.name)
		end 'eachRequirement'
	end 'noteCorpusInterface'

	function authorConformerConventionsDigest(requirementNames BareNameSet) returns HashDigest
		var members = Hasher.empty()
		var counted = 0 as Count

		for (site, info) in self.settledDeclarations().funcParamReassigns 'eachRecorded'
			if info.isAFreeFunction() or not requirementNames.contains(info.bareName) or self.declaredByTheSharedCorpusAt(declaringFileOfSite(site)) 'notAnAuthorsConformerMethod'
				continue
			end 'notAnAuthorsConformerMethod'

			var state = foldCallability(mixBytes(Hasher.empty(), bytes: info.bareName), callability: info.callability)

			for paramName in info.paramNames 'eachParam'
				state = mixBytes(state, bytes: paramName)
			end 'eachParam'

			members = members xor Hasher.combined(state, value: info.mutableParams as HashDigest)
			counted = counted + 1
		end 'eachRecorded'

		return Hasher.combined(members, value: counted as HashDigest)
	end 'authorConformerConventionsDigest'

	function computedFunctionValuedFieldNames(corpusOnly bool) returns BareNameSet
		let names = BareNameSet.create()

		for layout in self.settledDeclarations().structLayouts 'eachLayout'
			if corpusOnly and not self.settledDeclarations().stdlibDeclaredTypeNames.contains(layout.name) 'anAuthorsType'
				continue
			end 'anAuthorsType'

			for index in 0 upto layout.fieldNames.count() 'eachField'
				if self.fieldTypeMayHoldAFunctionValue(try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.computedFunctionValuedFieldNames: fieldTypes.get OOB at {index}")) 'aFunctionValuedField'
					names.insert(try layout.fieldNames.get(index) otherwise panic("ProgramSignatures.computedFunctionValuedFieldNames: fieldNames.get OOB at {index}"))
				end 'aFunctionValuedField'
			end 'eachField'
		end 'eachLayout'

		return names
	end 'computedFunctionValuedFieldNames'

	export function defaultKeyIsLive(key ByteArray) returns bool
		return self.liveDefaultKeyNames.contains(key)
	end 'defaultKeyIsLive'

	export function liveWinningDefaults() returns DefaultDeclarationArray
		let live = DefaultDeclarationArray.create(0)

		for declaration in self.settledDeclarations().defaultDeclarationList 'eachDeclaration'
			if self.defaultKeyIsLive(declaration.key) and self.defaultDeclarationWins(declaration) 'builtBeforeMain'
				live.push(declaration)
			end 'builtBeforeMain'
		end 'eachDeclaration'

		return live
	end 'liveWinningDefaults'

	export function defaultSlots(fileRanks FileEmissionRankMap) returns DefaultSlotArray
		let slots = DefaultSlotArray.create(0)

		for declaration in self.liveWinningDefaultsInPositionOrder(fileRanks) 'eachBuiltDefault'
			let slot = self.defaultSlotOf(declaration)

			if defaultSlotIsRefusedAsUnshareable(slot) 'refusedAtItsDeclaration'
				continue
			end 'refusedAtItsDeclaration'

			slots.push(slot)
		end 'eachBuiltDefault'

		return slots
	end 'defaultSlots'

	function defaultSlotOf(declaration DefaultDeclaration) returns DefaultSlot
		if self.defaultKeyIsAService(declaration.key) 'aServiceKey'
			return DefaultSlot.create(declaration, valueType: MaxonType.structRef(self.typeNames.intern(serviceHandleCompanionName(declaration.key))), kind: DefaultSlotKind.service)
		end 'aServiceKey'

		let valueType = MaxonType.structRef(self.typeNames.intern(declaration.key))
		return DefaultSlot.create(declaration, valueType: valueType, kind: self.registryValueKindOf(valueType, readerFilePath: declaration.declFilePath))
	end 'defaultSlotOf'

	export function registryValueKindOf(valueType MaxonType, readerFilePath FilePath) returns DefaultSlotKind
		let walk = self.transferWalkOf(transferSubjectOf(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType), typeNames: self.typeNames), kind: TransferKind.share, readerFilePath: readerFilePath)

		if not self.typeOwesDrop(valueType, from: self.typeNames) 'aValueInTheWord'
			return DefaultSlotKind.value(OwnershipCallee.inert, retainCallee: OwnershipCallee.inert, shareWalk: walk)
		end 'aValueInTheWord'

		return DefaultSlotKind.value(OwnershipCallee.named(managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: valueType)), retainCallee: OwnershipCallee.named(self.retainCalleeOf(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType), from: self.typeNames, result: RetainResult.sharedRead, readerFilePath: readerFilePath)), shareWalk: walk)
	end 'registryValueKindOf'

	// ⭐⭐⭐ **WHICH RUNTIME ENTRY TAKES A SECOND OWNER OF A VALUE — the retain side of
	// `managedNameDropCallee`.** Almost every managed value answers the plain box incref; the arms below
	// name the records that do not.
	//
	// ⚠ **THE TAG IS TESTED FIRST AND IT IS NOT A MICRO-OPTIMIZATION.** `nameId` is only meaningful
	// for a value that HAS a declared nominal type; asking it of an integer or a String would be
	// reading a field that means nothing there.
	export function retainCalleeOf(tag ValueTypeTag, nameId TypeNameId, from TypeNameInterner, result RetainResult, readerFilePath FilePath) returns immutable ByteArray
		// ⚠ Only a shared read takes `__str_retain`, which answers a CLONE of an immortal `.rdata` record
		// — a different pointer. Every in-place door keeps the plain box retain, which on an immortal
		// record returns without writing; an in-place door must not be handed a retain whose result is
		// another pointer.
		if result == RetainResult.sharedRead and tagIsByteRecord(tag) 'aByteRecordReadBack'
			return StrRetainName
		end 'aByteRecordReadBack'

		if tagIsByteRecord(tag) 'aByteRecord'
			return stickyBoxRetainCallee(result)
		end 'aByteRecord'

		// ⭐⭐ **AN ARRAY RECORD TAKES THE IMMORTAL-AWARE ENTRY.** A module-level managed constant's record
		// is `.rdata` (`Parser.emitManagedConstant`), so a refcount read-modify-write on it faults — and
		// whether a value is one cannot be known here, because it may be a merge phi. So the provenance
		// test is deferred to run time, exactly as `__str_retain` defers it one representation over, and
		// what is settled here is only which records that entry may read `capacity@16` out of: a six-slot
		// buffer record. A struct box's `@16` is an arbitrary field — or past the end of a box too small
		// to have one — so everything else keeps the plain box incref.
		if self.isArrayInstanceAt(tag, nameId: nameId) 'bufferRecord'
			return managedRecordRetainCallee(result)
		end 'bufferRecord'

		if self.isSharedValueInstanceAt(tag, nameId: nameId) 'aSharedValue'
			return SharedValueBoxRetainName
		end 'aSharedValue'

		if tag == ValueTypeTag.named and self.unionNameIsUnboxedFor(foreignNameOf(from, id: nameId), readerFilePath: readerFilePath) 'aWordUnion'
			return unionRetainSymbol(foreignNameOf(from, id: nameId))
		end 'aWordUnion'

		if tag != ValueTypeTag.structRef 'notNominal'
			return plainBoxRetainCallee(result)
		end 'notNominal'

		return managedNameRetainCallee(self, declaredName: foreignNameOf(from, id: nameId), result: result)
	end 'retainCalleeOf'

	export function sharedValueElementOf(id GenericInstanceId) returns MaxonType
		return self.substitutedInstanceArg(id, position: ContainerElementArgPosition)
	end 'sharedValueElementOf'

	export function instanceBaseIsSharedValue(id GenericInstanceId) returns bool
		return self.genericInstanceBaseName(id).equals(SharedValueTypeName)
	end 'instanceBaseIsSharedValue'

	export function isSharedValueInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.instanceBaseIsSharedValue(nameId as GenericInstanceId)
	end 'isSharedValueInstanceAt'

	export function instanceBaseIsReply(id GenericInstanceId) returns bool
		return self.genericInstanceBaseName(id).equals(ReplyTypeName)
	end 'instanceBaseIsReply'

	export function isReplyInstanceAt(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.instanceBaseIsReply(nameId as GenericInstanceId)
	end 'isReplyInstanceAt'

	export function typeHoldsAReply(type MaxonType) returns bool
		return self.typeReplyHolding(type, visited: NameRoster.create(0))
	end 'typeHoldsAReply'

	export function valueHoldsAReply(t MaxonType, idsFrom TypeNameInterner) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.typeReplyHolding(t, visited: NameRoster.create(0))
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		let name = try idsFrom.nameOf(typeNameIdOf(t)) otherwise panic("valueHoldsAReply: type-name id {typeNameIdOf(t)} is not in the interner it was resolved against — pass the interner this type's ids live in")
		return self.aggregateReplyHolding(self.denotedAggregateName(name), visited: NameRoster.create(0))
	end 'valueHoldsAReply'

	export function declaredSlotHoldsAReply(declared MaxonType, declFilePath FilePath) returns bool
		return self.typeHoldsAReply(self.declaredSlotType(declared, into: self.typeNames, slotScopeFilePath: declFilePath))
	end 'declaredSlotHoldsAReply'

	function typeReplyHolding(type MaxonType, visited NameRoster) returns bool
		let tag = maxonTypeTag(type)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.instanceReplyHolding(genericInstanceIdOf(type), visited: visited)
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'notAnAggregate'
			return false
		end 'notAnAggregate'

		let name = self.denotedSlotAggregateName(type)

		if self.isFunctionAliasInAnyFile(name) 'aFunctionAlias'
			return false
		end 'aFunctionAlias'

		if self.isGenericAliasInAnyFile(name) 'genericAlias'
			let live = try self.liveGenericAliasInstance(name) otherwise return false
			return self.instanceReplyHolding(live, visited: visited)
		end 'genericAlias'

		return self.aggregateReplyHolding(name, visited: visited)
	end 'typeReplyHolding'

	function instanceReplyHolding(id GenericInstanceId, visited NameRoster) returns bool
		if self.instanceBaseIsReply(id) 'aReply'
			return true
		end 'aReply'

		if self.instanceIsPromiseHandle(id) 'aPromise'
			return self.typeReplyHolding(self.substitutedInstanceArg(id, position: ContainerElementArgPosition), visited: visited)
		end 'aPromise'

		let mangled = self.mangleGenericInstance(id)

		if visited.contains(mangled) or self.nameIsAServiceType(self.genericInstanceBaseName(id)) 'alreadyWalkedOrHeldByACown'
			return false
		end 'alreadyWalkedOrHeldByACown'

		visited.push(mangled)

		if self.isElementBearingRecordInstance(id) 'anElementRecord'
			return self.typeReplyHolding(self.containerElementType(id), visited: visited)
		end 'anElementRecord'

		if not self.genericInstanceHasBaseLayout(id) 'noFieldsToRead'
			return false
		end 'noFieldsToRead'

		for i in 0 upto self.genericInstanceFieldCount(id) 'eachField'
			if self.typeReplyHolding(self.substituteInstanceFieldType(id, index: i), visited: visited) 'aReplyField'
				return true
			end 'aReplyField'
		end 'eachField'

		return false
	end 'instanceReplyHolding'

	function nameIsAServiceType(name ByteArray) returns bool
		for candidate in self.serviceSpawnCandidates() 'eachCandidate'
			if candidate.typeName.equals(name) 'aSpawnedType'
				return true
			end 'aSpawnedType'
		end 'eachCandidate'

		return false
	end 'nameIsAServiceType'

	function aggregateReplyHolding(name ByteArray, visited NameRoster) returns bool
		if visited.contains(name) or self.nameIsAServiceType(name) 'alreadyWalkedOrHeldByACown'
			return false
		end 'alreadyWalkedOrHeldByACown'

		visited.push(name)

		if self.containsStructInAnyFile(name) 'aStruct'
			let layout = self.structLayoutOf(name)

			for i in 0 upto layout.fieldCount() 'eachField'
				if self.typeReplyHolding(self.layoutFieldType(layout, structName: name, index: i), visited: visited) 'aReplyField'
					return true
				end 'aReplyField'
			end 'eachField'

			return false
		end 'aStruct'

		match self.enumInAnyFile(name) 'union'
			declared(layout) then return self.unionPayloadsHoldAReply(layout, visited: visited)
			undeclared then return false
		end 'union'
	end 'aggregateReplyHolding'

	function unionPayloadsHoldAReply(layout EnumLayout, visited NameRoster) returns bool
		for ci in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(ci)

			for fi in 0 upto payloads.count() 'eachPayload'
				let field = try payloads.get(fi) otherwise panic("ProgramSignatures.unionPayloadsHoldAReply: payloadsAt count disagrees with get at {fi}")

				if self.typeReplyHolding(field.declaredType, visited: visited) 'aReplyPayload'
					return true
				end 'aReplyPayload'
			end 'eachPayload'
		end 'eachCase'

		return false
	end 'unionPayloadsHoldAReply'

	export function replyElementOf(id GenericInstanceId) returns MaxonType
		return self.substitutedInstanceArg(id, position: ContainerElementArgPosition)
	end 'replyElementOf'

	export function internReplyInstanceForMessage(messageKey ByteArray) returns GenericInstanceId
		let result = try self.declaredReturnTypeOf(messageKey, into: self.typeNames) otherwise panic("internReplyInstanceForMessage: `{String.from(messageKey)}` declares no return type — `reply.later()` is refused in a message that returns nothing before it asks for an instance")
		let args = MaxonTypeArray.create(0)
		args.push(self.promiseResultArgFor(result))

		return self.internRow(self.typeNames.intern(ReplyTypeName), args: args)
	end 'internReplyInstanceForMessage'

	export function defaultKeyIsAService(key ByteArray) returns bool
		return self.nameDeclaresAnInterface(key)
	end 'defaultKeyIsAService'

	export function recordInterfaceHandle(handle StructLayout, interfaceName immutable ByteArray, representative immutable ByteArray)
		self.recordStruct(handle, declaredByTheCorpus: true)
		try self.mainThreadSettled().interfaceHandleOwners.insert(handle.name, value: interfaceName) otherwise panic("recordInterfaceHandle: `{String.from(handle.name)}` is already filed under an interface — the synthesis asks the struct registry for that very name before minting")
		self.mainThreadSettled().interfaceHandleRepresentatives.upsert(interfaceName, value: representative)
		self.mainThreadSettled().interfaceHandleOrder.push(interfaceName)
	end 'recordInterfaceHandle'

	export function interfacesWithHandles() returns NameRoster
		return self.settledDeclarations().interfaceHandleOrder
	end 'interfacesWithHandles'

	function interfaceDeclarationOf(name ByteArray) returns DeclaredTypeName
		return self.interfaceDeclaredIn(name)
	end 'interfaceDeclarationOf'

	export function interfaceRequirementSlots(interfaceName ByteArray) returns CollectedInterfaceMethodArray throws MapError
		match lookupInterface(self.settledDeclarations().interfaces, name: interfaceName) 'iface'
			found(iface) then return interfaceWitnessSlots(self.settledDeclarations().interfaces, iface: iface)
			notFound then throw MapError.keyNotFound
		end 'iface'
	end 'interfaceRequirementSlots'

	export function isInterfaceHandle(name ByteArray) returns bool
		return self.settledDeclarations().interfaceHandleOwners.contains(name)
	end 'isInterfaceHandle'

	export function interfaceOfHandle(handleName ByteArray) returns immutable ByteArray
		return try self.settledDeclarations().interfaceHandleOwners.get(handleName) otherwise panic("interfaceOfHandle: `{String.from(handleName)}` is filed under no interface — every caller asks `isInterfaceHandle` first")
	end 'interfaceOfHandle'

	export function interfaceHandleRepresentative(interfaceName ByteArray) returns immutable ByteArray
		return try self.settledDeclarations().interfaceHandleRepresentatives.get(interfaceName) otherwise panic("interfaceHandleRepresentative: `{String.from(interfaceName)}` has no handle — every caller holds one")
	end 'interfaceHandleRepresentative'

	export function typeImplementsInterface(typeName ByteArray, interfaceName ByteArray) returns bool
		let declared = try self.declaredInterfacesOfALaidOutType(typeName) otherwise return false

		return declaredInterfacesReach(self.settledDeclarations().interfaces, declaredNames: declared, wanted: interfaceName)
	end 'typeImplementsInterface'

	export function collectImplementedInterfaces(typeName ByteArray, into InterfaceNameSet)
		let declared = try self.declaredInterfacesOfALaidOutType(typeName) otherwise return

		collectDeclaredInterfaceClosure(self.settledDeclarations().interfaces, declaredNames: declared, into: into)
	end 'collectImplementedInterfaces'

	function declaredInterfacesOfALaidOutType(typeName ByteArray) returns InterfaceNameSet throws AbsentError
		if not self.hasRegisteredLayout(typeName) 'noLayout'
			throw AbsentError.absent
		end 'noLayout'

		return try self.sweptConformanceIndex().get(typeName) otherwise throw AbsentError.absent
	end 'declaredInterfacesOfALaidOutType'

	// ⚠ The one answer to "does this handle convert to that interface handle": every door converts
	// through `Parser.interfaceHandleOf`, and the type checks accept a `T.handle` for an `I.handle`
	// only where this answers yes. A door that accepted without converting would hand a box with no
	// send table to a send that loads one.
	export function serviceHandleWidensTo(handleName ByteArray, interfaceHandleName ByteArray) returns bool
		return self.isServiceHandle(handleName) and self.isInterfaceHandle(interfaceHandleName) and self.typeImplementsInterface(self.serviceOfHandle(handleName), interfaceName: self.interfaceOfHandle(interfaceHandleName))
	end 'serviceHandleWidensTo'

	export function declaresAnInterfaceHandle() returns bool
		return self.settledDeclarations().interfaceHandleOwners.count() > 0
	end 'declaresAnInterfaceHandle'

	// ⭐⭐ **IS THIS TYPE A HANDLE, AT A SERVICE OR AT AN INTERFACE?** `compilerOwnedAggregateOf` asks
	// it to route the handle's drop and clone, so a type whose calls are sends can never be one whose
	// box drops as an ordinary struct.
	export function isAnyServiceHandle(name ByteArray) returns bool
		return self.isServiceHandle(name) or self.isInterfaceHandle(name)
	end 'isAnyServiceHandle'

	export function serviceHandleNames() returns NameRoster
		let names = NameRoster.create(0)

		for (handleName, _) in self.settledDeclarations().serviceHandleOwners 'eachServiceHandle'
			names.push(handleName)
		end 'eachServiceHandle'

		return names
	end 'serviceHandleNames'

	export function interfaceHandleNames() returns NameRoster
		let names = NameRoster.create(0)

		for (handleName, _) in self.settledDeclarations().interfaceHandleOwners 'eachInterfaceHandle'
			names.push(handleName)
		end 'eachInterfaceHandle'

		return names
	end 'interfaceHandleNames'

	export function serviceOfHandleInstance(id GenericInstanceId) returns immutable ByteArray
		return self.serviceOfHandle(self.genericInstanceBaseName(id))
	end 'serviceOfHandleInstance'

	// ⭐⭐ **REGISTER A SERVICE'S TWO COMPANIONS — through `recordEnum`/`recordStruct`, the SAME doors an
	// author-written declaration takes.** That is the whole point of the door rather than a convenience:
	// those two are what fold a declaration's name and shape into `self.hash`, and `self.hash` is half of every
	// file's parse-memo key (`Queries.currentParseMemoKey`). Registering behind them would leave a `spawn`
	// added in file B unable to invalidate the parse of file A, where `Calc` is declared and where a reference
	// to `Calc.handle` resolves — a stale memo answering `Unknown type` about a type this compile mints.
	//
	// ⚠ `declaredByTheCorpus: true` states what is true of a COMPILER-MINTED declaration at the one gate that
	// reads it (`declarationContestsACompilerOwnedName`): it is not a user's contest for a reserved name, and
	// it must never be dropped. The names are dotted, so no compiler-owned spelling can be reached anyway —
	// stating it is what keeps that from being a coincidence.
	// ⭐ **REGISTER ONE `<T>.handle`, AND FILE IT AGAINST ITS SERVICE IN THE SAME STATEMENT.** The two facts
	// are one act because `isServiceHandle` and `serviceOfHandle` both rest on the second: a handle layout in
	// the struct registry with no owner filed would be a type whose method calls dispatch as ordinary struct
	// methods and whose box drops as an ordinary struct — silently.
	export function recordServiceHandle(handle StructLayout, serviceTypeName ByteArray)
		self.recordStruct(handle, declaredByTheCorpus: true)
		try self.mainThreadSettled().serviceHandleOwners.insert(handle.name, value: serviceTypeName) otherwise panic("recordServiceHandle: `{String.from(handle.name)}` is already filed under a service — `synthesizeServiceCompanions` asks the struct registry for that very name before minting, so a second mint of one handle cannot reach this line")
	end 'recordServiceHandle'

	// ⭐ **REGISTER ONE `<T>.request` OR `<T>.<m>.sendError`.** Separate from the handle for
	// `synthesizeServiceCompanions`' measured reason: a request union's payload may be typed at a
	// handle, so every handle must be registered before any request union is BUILT, and one function
	// registering both could not express that order.
	export function recordServiceUnion(layout EnumLayout)
		self.recordEnum(layout, declaredByTheCorpus: true)

		// ⭐ **AND ITS `unionCases` COMPANION, BECAUSE A REQUEST UNION IS AN ORDINARY UNION.** The
		// declaration sweep appends one for every author-written boxed union
		// (`Parser.recordScannedEnum`), through the same builder; a synthesized union that skipped it
		// would be the one union in the language whose `.unionCases` did not exist. The `carriesPayloads`
		// gate is `appendUnionCasesCompanion`'s own and is written rather than asserted: it is that
		// function's rule, not this caller's, and a union of payload-free messages carries no payloads.
		if layout.carriesPayloads() 'hasAssociatedValues'
			self.recordEnum(buildUnionCasesCompanion(layout), declaredByTheCorpus: true)
		end 'hasAssociatedValues'
	end 'recordServiceUnion'

	export function recordServiceSendError(layout EnumLayout)
		self.recordServiceUnion(layout)
		self.mainThreadSettled().serviceSendErrorNames.insert(layout.name)
	end 'recordServiceSendError'

	export function isServiceSendError(name ByteArray) returns bool
		return self.settledDeclarations().serviceSendErrorNames.contains(name)
	end 'isServiceSendError'

	// ⚡ **DOES THIS PROGRAM DECLARE ANY DOTTED TYPE NAME AT ALL?** — the one-`count()` gate in front of every
	// probe that would have to JOIN two tokens to ask its real question. Companions are the only types whose
	// names carry a dot, so a program with no `spawn` answers `false` here and never builds a name to look up.
	// `Parser.parseDottedPrimary`'s own header records what an ungated join at that site measured: a LINEAR
	// allocation term across the whole scale ladder, paid by every `Point.create(…)` in every program.
	export function declaresACompanionType() returns bool
		return self.settledDeclarations().serviceHandleOwners.count() > 0 or self.settledDeclarations().interfaceHandleOwners.count() > 0
	end 'declaresACompanionType'

	// ⭐⭐ **IS THIS INSTANCE'S BASE A SERVICE HANDLE? — THE INSTANCE ROAD'S ONE HOME, and it exists for the
	// reason `compilerOwnedAggregateOf` exists one tier over.** The drop and the clone of a value are
	// TAG-routed: a `genericInstance` reaches none of the name-routed doors, so each asks this for itself.
	export function instanceBaseIsServiceHandle(id GenericInstanceId) returns bool
		return self.isServiceHandle(self.genericInstanceBaseName(id))
	end 'instanceBaseIsServiceHandle'

	export function isServiceHandle(name ByteArray) returns bool
		return self.settledDeclarations().serviceHandleOwners.contains(name)
	end 'isServiceHandle'

	// ⭐ **THE SERVICE A HANDLE TYPE BELONGS TO** — the second question the one registry answers, asked by
	// `Parser.dispatchOnServiceHandle` to reach the request union and the message's qualified name. It PANICS
	// rather than answering a default: every caller has just been through `isServiceHandle`, and a handle with
	// no owner would be a companion something other than `recordServiceHandle` minted.
	export function serviceOfHandle(handleName ByteArray) returns immutable ByteArray
		return try self.settledDeclarations().serviceHandleOwners.get(handleName) otherwise panic("serviceOfHandle: `{String.from(handleName)}` is filed under no service — `recordServiceHandle` is the one act that registers a handle type, and it files the owner in the same statement")
	end 'serviceOfHandle'

	// ⭐ **DOES A DECLARATION OF THIS NAME CARRY THE ARRAY-LITERAL MARKER?** THE one reader of the discovered
	// list, so no caller can half-apply the "one or two names" rule the list's own header states.
	export function declaresTheArrayLiteralMarker(name ByteArray) returns bool
		for conformer in self.settledDeclarations().arrayLiteralConformers 'eachDeclaredConformer'
			if conformer.equals(name) 'thisOne'
				return true
			end 'thisOne'
		end 'eachDeclaredConformer'

		return false
	end 'declaresTheArrayLiteralMarker'

	// ⭐⭐ **THE NAME THE CORPUS DECLARES THE MANAGED RECORD UNDER, AS `readerIsStdlibSource` SPELLS IT** —
	// the fold target for every `__ManagedMemory` written outside a conformer's own body, in ONE place
	// so a caller cannot half-apply it. A stdlib file spells a contested corpus declaration under the
	// contest's mint; a user file spells it bare, because there the bare name is what the user's own tokens
	// already mean.
	//
	// ⚠ **THE RENAME IS APPLIED AT THE READ AND NOT AT DISCOVERY**: the contest is decided between the two
	// halves of the sweep and this is asked on both sides of it.
	export function arrayRecordBaseNameIn(readerIsStdlibSource bool) returns immutable ByteArray
		return self.settledDeclarations().interfaces.libraryNameOf(self.settledDeclarations().corpusArrayRecordName.name) if readerIsStdlibSource else self.arrayRecordDeclaredName()
	end 'arrayRecordBaseNameIn'

	// ⭐⭐ **THE NAME THE DECLARATION ITSELF WRITES, BEFORE ANY CONTEST — the record's spelling as a READER
	// knows it.** It answers the questions whose subject is a NAME on the page: every diagnostic that has to
	// quote the type. It is deliberately the pre-contest spelling: a refusal quoting this compile's mint
	// would send a reader to a name no author wrote and `Parser.requireUnreservedName` forbids them from
	// writing. The CONFORMER an array instance reduces to (`conformerNameOfInstanceSpelling`, and through it
	// every witness lookup and the hash-table key roster) is `arrayRecordBaseName`.
	//
	// ⛔ **IT IS NOT THE BASE A COMPILER-MINTED INSTANCE IS INTERNED UNDER — that is
	// `arrayRecordBaseName`.** A `b"…"`, an `[1, 2, 3]`, `<Enum>.allCaseNames` and `String.split`'s
	// result are all the CORPUS's record, so they must carry the base the corpus's own declaration is
	// registered under; under a contest that declaration has MOVED and this name is the PROGRAM's container
	// instead. See `internWellKnownContainerInstances` for the wrong answer that cost and for why interning
	// after the contest — rather than deciding the contest earlier — is the fix.
	export function arrayRecordDeclaredName() returns immutable ByteArray
		return self.settledDeclarations().corpusArrayRecordName.name
	end 'arrayRecordDeclaredName'

	// ⭐⭐ **IS `name` THE CONFORMER EVERY CONFORMING ARRAY REDUCES TO? — the ONE comparison behind the
	// intrinsic-conformance table's array row.** Every door that asks *"does this conformer name the
	// array record?"* asks it here: the E3017 where-constraint check, the witness-slot impl join, and the
	// element clause. They were three comparisons against the constant `SynthesizedArrayRecordSeed` while their
	// callers all arrived carrying `conformerNameOfType`'s DISCOVERED answer, so the three agreed with the
	// program only because `stdlib/Array.maxon` happens to declare the record as `Array`.
	//
	// ⚠ **IT IS NOT `isArrayBaseName`, AND THE TWO MUST NOT BE COLLAPSED.** That predicate answers *"is this
	// name an array DECLARATION in this compile?"* and is deliberately wide: a user's own
	// `BuiltinArrayLiteral` conformer and the corpus declaration MOVED by the shadow contest both answer true
	// there. A CONFORMER is narrower — `instanceConformerReduction` collapses every conforming instance,
	// whatever declaration it came from, onto this single name — so admitting the wide set here would file a
	// `Bag with Integer` under a conformer whose `Bag.hash` nothing installs.
	export function namesTheArrayRecordConformer(name ByteArray) returns bool
		return name.equals(self.arrayRecordBaseName())
	end 'namesTheArrayRecordConformer'

	// ⭐⭐ **THE ARRAY ROW OF THE INTRINSIC-CONFORMANCE TABLE, AS A LIST — `Hashable, Equatable`, fetched and
	// never transcribed.** It is BOTH halves of `extension Array implements Hashable, Equatable where
	// Element is Hashable and Equatable`: the protocols the record supplies AND the clause its element must
	// satisfy, which is not a coincidence but the shape of a container promising exactly what it demands of
	// its element (see `IrInterface.isIntrinsicBuiltinConformance`'s array arm, which owns the row).
	//
	// ⚠ **IT EXISTS BECAUSE THE TWO ARGUMENTS ARE ONE FACT AND THREE DOORS NEEDED THEM PAIRED** — the
	// withheld-method refusal, the hash-table key refusal (`Parser`) and the element clause
	// (`arrayElementCarriesConformance`). The row's key is a question rather than a name, so the pairing of
	// "the record's own spelling" with "this IS the record" is stated once here instead of agreed three
	// times. Each protocol is spelled through `IrInterfaceMap.spellingOf`, so under a contest the list names
	// the library's protocols and never an author's interface of the same name.
	export function arrayConformanceProtocolNames() returns NameRoster
		let protocols = intrinsicConformanceProtocols(self.arrayRecordBaseName(), discovered: DiscoveredConformer.arrayRecord)
		let names = NameRoster.create(protocols.count(), zeroed: false)

		for protocol in protocols 'eachProtocol'
			names.push(self.settledDeclarations().interfaces.spellingOf(protocol))
		end 'eachProtocol'

		return names
	end 'arrayConformanceProtocolNames'

	// ⭐⭐ **WHICH COMPILER-GRANTED CONFORMER A NAME IS — the ONE discovery every door that consults the
	// intrinsic-conformance table routes through (enum-hashable).** Two of that table's rows are keyed by a
	// declaration rather than by a compiler-owned spelling, so neither can be recognized without the program:
	// the ARRAY RECORD, whose name the corpus chooses, and a payload-free `enum`, whose name the author
	// chooses. They are answered together because they are the same question — *"is this name one the compiler
	// grants a conformance to without an `implements`?"* — and a caller that asked only one of them would
	// silently withhold the other's row.
	//
	// ⚠ **THE ENUM ROW IS WITHHELD FROM A `union`, WHICH IS THE LANGUAGE'S RULE AND NOT A REPRESENTATION
	// ONE.** `/specs/enum-hashable.md` grants the pair to enums *"without associated values"* and pins the
	// refusal of a union that has them; the row is withheld from EVERY union, including a payload-free
	// one — a union is a nominal choice the author made and the conformance is the enum keyword's.
	//
	// ⚠ **`carriesPayloads()` IS A SECOND CONDITION AND NOT A RESTATEMENT OF THE FIRST**: it is the
	// REPRESENTATION premise the granted impls rest on (`enumConformanceImplName` — the value must BE
	// its i64 tag), and the keyword alone does not establish it. An `enum` whose case carries a
	// payload is a box or a tagged word exactly as a union is, so hashing it as an i64 would hash a
	// POINTER; whether such a declaration is refused earlier is a question about a diagnostic, and
	// this predicate must not depend on the answer.
	export function namesAPayloadFreeEnum(name ByteArray) returns bool
		if let layout = try self.settledDeclarations().enumTypes.get(name) 'declared'
			return not layout.isUnion and not layout.carriesPayloads()
		end 'declared'

		return false
	end 'namesAPayloadFreeEnum'

	export function discoveredConformerOf(name ByteArray) returns DiscoveredConformer
		if self.namesTheArrayRecordConformer(name) 'theArrayRecord'
			return DiscoveredConformer.arrayRecord
		end 'theArrayRecord'

		if self.namesAPayloadFreeEnum(name) 'anEnum'
			return DiscoveredConformer.payloadFreeEnum
		end 'anEnum'

		return DiscoveredConformer.none
	end 'discoveredConformerOf'

	// ⭐⭐ **THE IMPL A PAYLOAD-FREE ENUM'S GRANTED `Hashable`/`Equatable` SLOT NAMES — the ONE answer, read by
	// the WITNESS SLOT (`LowerMaxonToStd.witnessSlotImpl`) and by the DIRECT dispatch
	// (`Parser.dispatchEnumConformanceMethod`), because a map that hashes a key one way and an `e.hash()` that
	// answers another is a wrong answer no diagnostic can reach.**
	//
	// ⭐ **IT IS `int`'s IMPL, AND THAT IS THE WHOLE OF WHY THE GRANT SYNTHESIZES NO BODY.** An enum value IS
	// its i64 tag — one `MaxonOp.literal` at every `Color.red` (`Parser.emitEnumTagLiteral`), resolving away to
	// `MaxonType.integer` below the parser (`TypeResolution.denotedNamedType`) — so hashing an enum IS hashing
	// that i64 and comparing two enums IS comparing two i64s. `int.hash`/`int.equals` are already synthesized,
	// already witness-reachable and already the symbols `__witness_int.*` names, so the enum row reaches the
	// same two bodies rather than minting a pair per enum in the program.
	//
	// ⭐ **AND THE TAG IS THE RIGHT THING TO HASH FOR EVERY BACKING, INCLUDING THE THREE WHERE IT IS NOT THE
	// RAW VALUE.** A string-backed enum's tag is its declaration index and a function-backed one's likewise;
	// a character-backed enum's is the codepoint; a float-backed one's is the f64's BIT PATTERN. In all four
	// the tag is UNIQUE per case (E3031 refuses a duplicate raw value), so two cases are equal exactly when
	// their tags are — which is the property a hash table needs, and it costs no String allocation per probe.
	//
	// ⚠ **A `float` BACKING HASHES THE BITS, NOT THE VALUE.** Dispatching to `float.hash` on the
	// reinterpreted value differs on exactly one input — a NaN-backed case, which `float.equals`
	// reports as unequal to ITSELF, so a map could never find the key it just inserted. Case identity
	// is what an enum's `Equatable` means, and the bit compare is that; numeric equality is not.
	//
	// ⚠ **AN ENUM THAT DECLARES ITS OWN `hash`/`equals` KEEPS IT.** Its method is registered under this
	// very key (`Parser.declaredMethodName`) and it is what `d.hash()` already resolves to. Answering
	// `int.hash` regardless would leave the two doors disagreeing about one enum.
	//
	// ⛔⛔ **AND THAT BRANCH IS SOUND ONLY BECAUSE E3130 REFUSES A MEMBER THAT DOES NOT IMPLEMENT THE
	// REQUIREMENT.** The grant is the compiler's and needs no clause, so an enum that names neither interface
	// has no `ConformanceDecl` for `checkConformance` to validate and no `witnessSlotImpls` selection behind
	// it — this join is the whole answer. Unguarded, an enum declaring `hash() returns String` is stamped
	// into a slot the probe calls as returning i64: a String pointer used as a hash and then leaked, on a
	// program that compiles clean with no diagnostic anywhere.
	// ⇒ `ConformanceCheck.checkGrantedEnumConformance` is the other half of THIS function and may not be
	// removed while this branch stands.
	export function enumConformanceImplName(enumName ByteArray, methodName ByteArray) returns immutable ByteArray
		if self.enumDeclaresOwnConformanceMethod(enumName, methodName: methodName) 'theEnumWritesItsOwn'
			return qualifiedMethodName(enumName, methodName: methodName)
		end 'theEnumWritesItsOwn'

		return qualifiedMethodName(IntConformerName, methodName: methodName)
	end 'enumConformanceImplName'

	// ⭐⭐ **DOES THIS ENUM DECLARE A MEMBER OF ITS OWN UNDER A GRANTED REQUIREMENT'S NAME? — the ONE home of
	// the override probe, read by all THREE doors that turn on it.** `Parser.enumGrantedConformanceMethod`
	// decides whether `e.hash()` is a method call or the granted conformance; `enumConformanceImplName`
	// decides which symbol the witness slot is stamped with; `ConformanceCheck.checkGrantedEnumConformance`
	// decides which members it must hold to the requirement.
	//
	// ⚠ **THEY WERE TWO COPIES OF ONE JOIN AND THAT IS EXACTLY WHY THIS EXISTS**: refine the rule at one and
	// the other keeps the old one, so `e.hash()` would call one body while the map stamped another — the
	// single-home invariant this whole grant rests on, broken by the edit that was meant to tighten it.
	export function enumDeclaresOwnConformanceMethod(enumName ByteArray, methodName ByteArray) returns bool
		return self.declaresCallee(qualifiedMethodName(enumName, methodName: methodName))
	end 'enumDeclaresOwnConformanceMethod'

	// ⭐⭐ **THE SAME NAME AS THE *STDLIB* SPELLS IT — and THE base every compiler-MINTED array instance is
	// interned under.** What `isArrayBaseName` recognizes as the corpus declaration MOVED; what a reader with
	// no file of its own (the conformance runtime, the reachability walk) has to use, because a corpus body is
	// compiled under the stdlib's spelling; and what the mint has to use, because a minted array IS the
	// corpus's record and must share the gid of the corpus's own `ByteArray`.
	//
	// ⚠ **EVERY CALLER THAT INTERNS OR LOOKS UP AN INSTANCE READS THIS ONE**, on both sides of the sweep and
	// in the real parse, so the sweep's write and the parser's read cannot land on two gids. The single thing
	// that makes that possible is that no mint runs before the contest — see
	// `internWellKnownContainerInstances`.
	export function arrayRecordBaseName() returns immutable ByteArray
		return self.arrayRecordBaseNameIn(true)
	end 'arrayRecordBaseName'

	// ⭐ **DECIDE THE CONTEST FOR ONE NAME A LISTED STDLIB MODULE DECLARES.** A no-op unless a USER file
	// declares it too; otherwise it mints the reserved name the stdlib declaration will be keyed under and
	// files it. Called once per stdlib-declared name, between the two sweep phases — see
	// `Queries.contestStdlibDeclarationsAgainstUserNames`.
	//
	// ⚠⚠ **A NAME NO USER DECLARATION MAY LEGALLY HOLD IS NOT A CONTEST, AND THE SWEEP CANNOT TELL —
	// SO THIS DOOR DOES.** The declaration sweep is deliberately TOLERANT (`Parser.recordScannedType`): it
	// folds a declaration in before the real parse gets to refuse it, so `userDeclaredTypeNames` holds names
	// the program is about to be rejected for writing. MEASURED: a user `enum __ManagedDirectoryError` —
	// which `requireUnreservedName` refuses with E2051 — contested `stdlib/Builtins.maxon`'s own declaration
	// of that name, renamed it out from under the runtime, and added a second, bogus **E4016** beside the
	// E2051 that `managed-directory.error-enum-name-is-reserved` pins. Both refusals are re-stated here
	// rather than deferred to the parse, because the contest is decided BEFORE any file is parsed.
	//
	// ⚠ **RE-PROBED, NOT PREFIXED ONCE, and against ALL THREE CLAIMANTS on the reserved space** — a user
	// declaration (E2051 forbids it, so only ever in a program already being refused), an earlier contest's
	// mint, and a stdlib declaration that spells the candidate itself. The loop terminates because each pass
	// makes the candidate strictly longer while all three sets are finite and already complete. It is
	// `reservedIfDeclared`'s loop, one namespace over.
	export function contestStdlibTypeName(name ByteArray)
		if not self.authorContestsTheLibraryName(name) 'uncontested'
			return
		end 'uncontested'

		if self.mainThreadSettled().interfaces.contestsLibraryName(name) 'alreadyContested'
			return
		end 'alreadyContested'

		var renamed = freeze "{String.from(ReservedTypeNamePrefix)}{String.from(name)}".toByteArray()

		while self.shadowRenameIsTaken(renamed) 'stillTaken'
			renamed = freeze "{String.from(ReservedTypeNamePrefix)}{String.from(renamed)}".toByteArray()
		end 'stillTaken'

		self.mainThreadSettled().interfaces.renameLibraryName(name, mintedAs: renamed)
	end 'contestStdlibTypeName'

	function authorContestsTheLibraryName(name ByteArray) returns bool
		return self.settledDeclarations().userDeclaredTypeNames.contains(name) and not isCompilerReservedName(name) and not isCompilerOwnedTypeName(name)
	end 'authorContestsTheLibraryName'

	// Is this candidate reserved name already spoken for? THREE claimants, and all three matter — two names
	// must not land on ONE reserved name, which is the collision `reservedIfDeclared`'s own header warns a
	// non-reserved prefix would make silent.
	//
	// ⚠ **THE STDLIB HALF IS THE ONE NOTHING ELSE WOULD CATCH.** `stdlib/Builtins.maxon`
	// already declares `__`-prefixed types of its own, so a stdlib module declaring `X` while any stdlib
	// module declares `__X` would have had the mint for a shadowed `X` land ON that declaration — an E3006
	// raised inside `stdlib/`, or worse a last-wins upsert of two layouts under one key. No pair in
	// `stdlib/` collides that way today, and it is checked rather than argued, because the thing that would
	// make it reachable is ADDING A FILE TO `stdlib/`, a change made by someone reading `StdlibLoader`'s
	// collision rule and not this function.
	function shadowRenameIsTaken(candidate ByteArray) returns bool
		if self.settledDeclarations().userDeclaredTypeNames.contains(candidate) 'aUserDeclarationHoldsIt'
			return true
		end 'aUserDeclarationHoldsIt'

		if self.settledDeclarations().stdlibDeclaredTypeNames.contains(candidate) 'aStdlibDeclarationHoldsIt'
			return true
		end 'aStdlibDeclarationHoldsIt'

		return self.settledDeclarations().interfaces.isMintedLibraryName(candidate)
	end 'shadowRenameIsTaken'

	// ⭐ **IS THIS CALLEE ONE OF THIS COMPILE'S OWN MINTS, or a METHOD OF ONE?** `__Clock.nowMs` is what
	// `stdlib/Clock.maxon`'s own `Clock.nowMs` becomes when a user program declares `type Clock`, and the
	// reserved-CALL door would otherwise refuse it as a user reaching for a compiler intrinsic. The
	// HEAD is what carries the mint, so the test splits the callee rather than matching a prefix — a prefix
	// test would admit `__Clockwork.tick`.
	export function isMintedStdlibShadowCallee(callee ByteArray) returns bool
		return self.settledDeclarations().interfaces.isMintedLibraryName(qualifiedCalleeHead(callee))
	end 'isMintedStdlibShadowCallee'

	// Both conjuncts bind: the compiler's own runtime calls (`__write_stdout`, interpolation parts) carry
	// `resolvedTypeQualifier` too, and a hand-typed `__Range.nosuch()` is `notMinted` and stays E3004.
	export function isMemberOfAMintedLibraryType(callee ByteArray, mint CalleeMint) returns bool
		return (mint == CalleeMint.resolvedTypeQualifier or mint == CalleeMint.resolvedStaticTypeQualifier) and self.isMintedStdlibShadowCallee(callee)
	end 'isMemberOfAMintedLibraryType'

	export function settleStdlibShadowSpellings(declaredNames NameRoster, declaringFiles FilePathArray)
		let spellings = StdlibShadowSpellingArray.create(0)
		let spelled = WrittenMintSet.create()

		for position in 0 upto declaredNames.count() 'eachDeclaredName'
			let name = try declaredNames.get(position) otherwise panic("stdlibShadowSpellings: declaredNames.get OOB at {position} below count {declaredNames.count()}")
			let minted = self.mainThreadSettled().interfaces.libraryNameOf(name)

			if minted.equals(name) or spelled.contains(minted) 'nothingNewToSpell'
				continue
			end 'nothingNewToSpell'

			spelled.insert(minted)

			let file = try declaringFiles.get(position) otherwise panic("settleStdlibShadowSpellings: the declaring files are pushed beside the names, so {position} indexes both")
			let namespace = qualifierForNamespace(namespaceForModuleDirectory(self.moduleDirectoryOf(file)))
			spellings.push(StdlibShadowSpelling.create(minted, qualified: namespaceQualifiedName(namespace, name: name), bare: name))
		end 'eachDeclaredName'

		self.noteAuthorMintSpellings(spellings, spelled: spelled)

		let familySpellings = StdlibShadowSpellingArray.create(self.mainThreadSettled().aliasFamiliesBesideNominals.count(), zeroed: false)

		for family in self.mainThreadSettled().aliasFamiliesBesideNominals 'eachAliasFamily'
			familySpellings.push(StdlibShadowSpelling.create(aliasFamilyMint(family), qualified: self.aliasFamilyAuthorSpelling(family), bare: family))
		end 'eachAliasFamily'

		familySpellings.sortBy(function(left StdlibShadowSpelling, right StdlibShadowSpelling) gives compareBytesOrdinally(left.bare, right: right.bare))

		for spelling in familySpellings 'eachSortedAliasFamily'
			spellings.push(spelling)
		end 'eachSortedAliasFamily'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.shadowRoster = ShadowSpellingRoster.of(spellings)
	end 'settleStdlibShadowSpellings'

	function aliasFamilyAuthorSpelling(family ByteArray) returns immutable ByteArray
		for claim in try self.crossKindClaimsOf(family) otherwise panic("ProgramSignatures.aliasFamilyAuthorSpelling: '{String.from(family)}' was settled as a family, which files its claims") 'eachClaim'
			if isTypeAliasDecl(claim.kind) and not claim.declaredByTheCorpus 'anAuthorsAlias'
				return family
			end 'anAuthorsAlias'
		end 'eachClaim'

		return namespaceQualifiedName(StdlibDirName, name: family)
	end 'aliasFamilyAuthorSpelling'

	export function shadowRoster() returns ShadowSpellingRoster
		return self.settledDeclarations().shadowRoster
	end 'shadowRoster'

	// Could `name` denote a top-level MANAGED binding anywhere in this program? A
	// `false` is final; a `true` still has to be resolved by `constantValueOf`/`globalDeclFor`, which is
	// what applies directory scoping and tells the two storage models apart. See `managedTopLevelNames`.
	export function namesManagedTopLevel(name ByteArray) returns bool
		return self.settledDeclarations().managedTopLevelNames.contains(name)
	end 'namesManagedTopLevel'

	// Fold ONE file's scanned declarations into the index. Called in SOURCE-PATH order, so the
	// index — and its hash — are a deterministic function of the program, not of the order the
	// files happened to be visited in.
	//
	// `fileTypeNames` is the interner the scan interned into (a `Parser`'s own artifact-local
	// table), so its ids are file-local. They are folded in and remapped through exactly the
	// machinery `mergeArtifact` uses for the identical job — `TypeNameInterner.foldInto` +
	// `remapMaxonReturnType`. One mechanism, two callers: a second copy of "reconcile a file's ids
	// into a bigger table" would be free to disagree with this one about what an id means.
	export function foldFile(scanned FuncReturnTypeEntryArray, aliases RangedTypeAliasArray, implementsClauses AliasImplementsClauseArray, functionAliases FunctionTypeAliasArray, structs StructLayoutArray, enums EnumLayoutArray, genericAliasEntries GenericAliasEntryArray, innerAliasEntries InnerAliasEntryArray, methodInnerAliasParamEntries MethodInnerAliasParamEntryArray, interfaceSites InterfaceDeclSiteArray, extensionSites ExtensionDeclSiteArray, conformanceSites ConformanceClauseDeclSiteArray, scanSites DescriptorScanSiteArray, bindings TopLevelDeclArray, paramConsumes ParamConsumeEntryArray, paramReassigns ParamReassignEntryArray, globalAliasReturns GlobalAliasReturnEntryArray, paramDefaults ParamDefaultEntryArray, throwsEntries ThrowsClauseEntryArray, bodyFacts SweptBodyFactEntryArray, freeFunctionNames NameRoster, testDecls DiscoveredTestArray, moduleDirectory String, filePath FilePath, fileStream DeclTokenStream, fileTypeNames TypeNameInterner, isStdlibSource bool)
		// Which file holds which declarations decides how other files resolve them, so the boundary
		// between files rides the hash.
		self.hash = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeFileBoundary), bytes: filePath.toString().toByteArray())

		// ⭐ The file's `test` declarations, appended in sweep order and contested by nothing: a minted
		// `__test_` name is in the space no author may declare (E2051), so there is no name question to
		// settle here and no registry below that reads them. See `declaredTests`.
		for declaredTest in testDecls 'eachDeclaredTest'
			self.mainThreadSettled().declaredTests.push(declaredTest)
		end 'eachDeclaredTest'

		for alias in aliases 'eachAlias'
			self.recordAlias(alias)
		end 'eachAlias'

		for clause in implementsClauses 'eachImplementsClause'
			self.mainThreadSettled().pendingImplementsClauses.push(clause)
		end 'eachImplementsClause'

		// ⭐⭐ **THE FREE-FUNCTION NAMESPACE PASS, AND IT RUNS BEFORE ANY PER-FUNCTION TABLE IS FOLDED.**
		// It does three jobs off one walk: it files each free function's directory-qualified spelling (the
		// map a dotted callee asks through); it decides whether the bare name is now declared in more
		// than one DIRECTORY; and it CLAIMS the key this file's own declarations of a contested name will be
		// filed under.
		//
		// ⚠ **THE POSITION IS LOAD-BEARING, not tidiness**, for a second reason too. When this file
		// is the one that makes a name contested, the INCUMBENT's sweep entries have to be moved off the bare
		// key — and they are readable there only until this file's own fold overwrites them, which is the very
		// next thing that happens. One line later and the incumbent's return type, throws clause and defaults
		// would be this file's. And every recorder below now keys through `sweepRegistrationKey`, which reads
		// exactly what this pass decides, so the contest has to be settled for this file before the first of
		// them runs.
		// Rendered ONCE per file, not once per declaration: it is a property of the file, and building it in
		// the loop below would allocate a namespace string for every free function in the program.
		let namespace = namespaceForModuleDirectory(moduleDirectory)

		for bareName in freeFunctionNames 'eachFreeFunction'
			self.recordNamespaceQualifiedFunction(namespaceQualifiedName(qualifierForNamespace(namespace), name: bareName), moduleDirectory: moduleDirectory)

			match self.noteFreeFunctionDeclaration(bareName, moduleDirectory: moduleDirectory) 'contest'
				uncontested or
				alreadyContested then continue
				newlyContested(incumbentRegistrationName) then self.refileContestedFreeFunction(bareName, registrationName: incumbentRegistrationName)
			end 'contest'
		end 'eachFreeFunction'

		// Inner ranged typealiases travel by NAME (a ranged alias's underlying is the `int`/
		// `float` keyword — no ids), so they fold alongside the ranged aliases, before the interner
		// reconciliation. Keyed by base-qualified name so `Wrapper.Idx` and a same-named inner alias of
		// another generic type stay distinct.
		for innerAlias in innerAliasEntries 'eachInnerAlias'
			self.recordInnerAlias(innerAlias.baseName, alias: innerAlias.alias)
		end 'eachInnerAlias'

		// Per-method inner-alias parameter info travels by NAME (member strings, no ids), so it
		// folds here too. Last-wins on a duplicate method name (a duplicate function is E3006, reported
		// elsewhere).
		for methodEntry in methodInnerAliasParamEntries 'eachMethodInnerAlias'
			self.mainThreadSettled().methodInnerAliasParams.upsert(methodEntry.methodName, value: methodEntry.info)
		end 'eachMethodInnerAlias'

		// Function aliases travel by NAME and carry no interner ids (their return type is stored as a
		// tag + a name ByteArray), so they fold here alongside the ranged aliases, before the interner
		// reconciliation below — nothing about them needs remapping (like `paramConsumes`/`throwsEntries`).
		for functionAlias in functionAliases 'eachFunctionAlias'
			self.recordFunctionTypeAlias(functionAlias)
		end 'eachFunctionAlias'

		if self.allFilesFolded and functionAliases.count() > 0 'aLateDeclaration'
			self.settleContestsOfLateFunctionAliases(functionAliases)
		end 'aLateDeclaration'

		// The fold already knows the file's provenance, so the corpus/user split a compiler-owned type name
		// turns on (`Project.declarationContestsACompilerOwnedName`) is DERIVED here once per file rather than
		// per declaration — and derived through the one predicate that owns it, never re-spelled
		// (`livesUnderStdlibDirectory`). Every declaration loop below reads it, so it precedes them all.
		let declaredByTheCorpus = livesUnderStdlibDirectory(self, isStdlibSource: isStdlibSource and not self.declaredInTheScriptlib(filePath))

		// Interface declaration SITES carry no ids at all — a file path and a token index — so they fold
		// here with the consume facts and the throws clauses, ahead of the interner reconciliation and ahead of
		// the identity-remap early return below, which no by-name fold may sit after. They are only
		// ACCUMULATED: the declarations behind them are read once the last file has folded, because a
		// requirement's rendered type depends on the whole program (see `InterfaceDeclSite`) — the same
		// "noted here, performed later" split `noteWellKnownInstanceNeeds` uses.
		for site in interfaceSites 'eachInterfaceSite'
			// The parser's E2015 does not keep a refused user interface out of this fold, and its unexported
			// site would answer `interfaceDeclaredIn` for the library's name, raising E3008 inside stdlib files.
			if site.name.contestsACompilerOwnedName(declaredByTheCorpus) 'aUserContest'
				continue
			end 'aUserContest'

			self.mainThreadSettled().interfaceDeclSites.push(site)

			if let name = try site.name.declaredName() 'aNamedInterface'
				self.mainThreadSettled().interfaceDeclSiteNames.insert(name)
			end 'aNamedInterface'
		end 'eachInterfaceSite'

		// EXTENSION declaration sites ride beside the interface ones, carry no ids for the same reason, and
		// are ACCUMULATED for a sharper version of the same one: an extension's methods belong to conformers
		// that may be declared in a file this sweep has not reached. See `ExtensionDeclSite`.
		for site in extensionSites 'eachExtensionSite'
			self.mainThreadSettled().extensionDeclSites.push(site)
		end 'eachExtensionSite'

		// CONFORMANCE CLAUSE sites ride beside both, carry no ids for the same reason, and are ACCUMULATED
		// for a reason that is the INTERFACE fold's own output: a clause's extent depends on an interface
		// arity that pass computes. See `ConformanceClauseDeclSite`.
		for site in conformanceSites 'eachConformanceClauseSite'
			self.mainThreadSettled().conformanceClauseSites.push(site)
		end 'eachConformanceClauseSite'

		// The sized-container method-list sites the fixed-element-count fixpoint walks — see
		// `DescriptorScanSite`.
		for site in scanSites 'eachDescriptorScanSite'
			self.mainThreadSettled().descriptorScanSites.push(site)
		end 'eachDescriptorScanSite'

		// Bindings are RECORDED here and EVALUATED later
		// (`evaluateInitializers`), and the gap between the two is the whole reason a forward
		// reference works — see that function.
		for binding in bindings 'eachBinding'
			self.recordDecl(binding)
		end 'eachBinding'

		// Only a file that declares a binding keeps its stream: nothing else reads one, and a clone of the index copies
		// every stream it holds.
		if not bindings.isEmpty() 'declaresABinding'
			self.mainThreadSettled().declTokenStreams.upsert(filePath.toString(), value: fileStream)
		end 'declaresABinding'

		let remap = self.typeNames.foldInto(fileTypeNames)

		// A declared struct's field types are reconciled IN PLACE, before the record loop below, so
		// there is ONE recording path rather than a mapped and an unmapped one. That is the opposite
		// shape from the signatures below, and the difference is what each fold owns: a
		// `MaxonReturnType` is a union VALUE, so remapping it can only mean constructing a new one
		// (hence the two loops, and the identity fast path that skips an allocation per declared
		// function); a `StructLayout` is a heap `type` this sweep just built and still owns, so its
		// field list is simply rewritten. `remapStructLayoutFieldTypes` is the single mechanism
		// `mergeArtifact` folds the same records with.
		// A declared type's id-bearing member types — a struct's field types and a union/enum's
		// PAYLOAD field types (`walk(dir Direction)`) — are reconciled IN PLACE before the record
		// loops below, so there is ONE recording path rather than a mapped and an unmapped one. A
		// payload-free enum carries no ids, so its loop body rewrites nothing; the record loop still
		// runs unconditionally (the ids are irrelevant to WHETHER a type is declared, only to what its
		// members mean).
		if remap.movesAnything() 'typeMemberIdsMoved'
			for layout in structs 'eachMovedStruct'
				remapStructLayoutFieldTypes(layout, remap: remap)
			end 'eachMovedStruct'

			for enumLayout in enums 'eachMovedEnum'
				remapEnumLayoutPayloadTypes(enumLayout, remap: remap)
			end 'eachMovedEnum'
		end 'typeMemberIdsMoved'

		for layout in structs 'eachStruct'
			self.recordStruct(layout, declaredByTheCorpus: declaredByTheCorpus)
		end 'eachStruct'

		for enumLayout in enums 'eachEnum'
			self.recordEnum(enumLayout, declaredByTheCorpus: declaredByTheCorpus)
		end 'eachEnum'

		// Generic-instance typealiases. Folded BEFORE the return-type split below (which returns
		// early on the identity fast path), so they are recorded whether or not ids moved. Each entry's
		// args are minted against the file's interner, so `recordGenericAlias` remaps them into this
		// index's interner (`remap`) before interning the instance — exactly as struct field types above.
		for genericAlias in genericAliasEntries 'eachGenericAlias'
			self.recordGenericAlias(genericAlias, remap: remap)
		end 'eachGenericAlias'

		for entry in scanned 'eachScannedSignature'
			self.recordScannedSignature(entry, name: entry.name, moduleDirectory: moduleDirectory, declFilePath: filePath, remap: remap)
		end 'eachScannedSignature'

		// ⭐⭐ **THE FOUR BY-NAME FOLDS.** Each keys through `sweepRegistrationKey`, so a declaration's consume
		// facts, by-reference columns, parameter defaults and `throws` clause land on the same key its return
		// type and declaration site did — which is the key the parser asks with.
		//
		// They carry no interner ids (names, numbers, a bare enum name), so nothing about them needs remapping.
		for entry in paramConsumes 'eachConsume'
			self.recordParamConsume(self.sweepRegistrationKey(entry.name, moduleDirectory: moduleDirectory), site: entry.site, info: entry.info)
		end 'eachConsume'

		for entry in paramReassigns 'eachByRef'
			self.recordParamReassign(self.sweepRegistrationKey(entry.name, moduleDirectory: moduleDirectory), site: entry.site, info: entry.info)
		end 'eachByRef'

		// The immutable-global-return raw material rides the same loop and the same key for the
		// by-reference columns' reason: it is another per-declaration fact a CALL SITE reads about a
		// callee it cannot see.
		//
		// ⚡ **THE DECLARING FILE IS FOLDED HERE, ONCE, RATHER THAN INSIDE THE LOOP** — see
		// `GlobalAliasReturnInfo.declFilePath` for why the file has to ride the hash at all. Every entry in this
		// array was swept by ONE `Parser` off ONE file, so `entry.info.declFilePath` is `filePath` for all of
		// them; folding it per entry meant a `String.toByteArray()` — a `managed.slice` COPY plus a
		// `ByteArray.init` — per DECLARATION, for a fact that changes per FILE. The hash still distinguishes two
		// files stating identical bodies, which is the whole reason the file rides.
		if globalAliasReturns.count() > 0 or anyDefaultHelperStatesAGlobalAliasReturn(paramDefaults) 'thisFileStatesOne'
			self.hash = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeGlobalAliasReturn), bytes: filePath.toString().toByteArray())
		end 'thisFileStatesOne'

		for entry in globalAliasReturns 'eachGlobalAliasReturn'
			self.recordGlobalAliasReturn(self.sweepRegistrationKey(entry.name, moduleDirectory: moduleDirectory), info: entry.info)
		end 'eachGlobalAliasReturn'

		// A helper's NAME was minted by the token SCAN, from the name the source wrote, a pass before
		// any contest was known — two directories each declaring a defaulting `pick` both mint
		// `__paramDefault#pick#0`. Filed under that name, the second declaration's helper would overwrite
		// the first's facts, and the drain would emit two definitions of a symbol no source wrote (E3006).
		//
		// ⚠ The helpers are filed before `recordParamDefaults`, so the info it stores already names their
		// registration-key spellings. A later file's contest moves an incumbent's helpers in
		// `renameContestedParamDefaultHelpers`.
		//
		// It walks `paramDefaults` rather than the file's free-function names because only this array knows
		// which declarations have a helper; a program that declares no default does not enter the loop at all.
		for entry in paramDefaults 'eachParamDefault'
			let key = self.sweepRegistrationKey(entry.name, moduleDirectory: moduleDirectory)

			// A later declaration of the key is E3006 and publishes nothing: its defaults and helpers would
			// otherwise be filed under the kept declaration's key. The kept declaration's site is written by
			// the `scanned` loop above, which is why this is asked here and not earlier.
			if self.keyBelongsToAnotherDeclaration(key, declFilePath: filePath, line: entry.nameLine, column: entry.nameColumn) 'aLaterDeclarationOfTheKey'
				continue
			end 'aLaterDeclarationOfTheKey'

			self.recordParamDefaults(key, info: self.recordSweptDefaultHelpers(entry.info, helpers: entry.helpers, bareName: entry.name, registrationName: key, moduleDirectory: moduleDirectory, declFilePath: filePath, remap: remap))
		end 'eachParamDefault'

		for entry in throwsEntries 'eachThrows'
			self.recordThrows(self.sweepRegistrationKey(entry.name, moduleDirectory: moduleDirectory), clause: entry.clause)
		end 'eachThrows'

		// The sweep collects every body fact into ONE array (see `SweptBodyFactEntry`); they part company
		// HERE, at the one point the registration key is minted, so none can be filed under a key another's
		// door would not ask with.
		for entry in bodyFacts 'eachProvedBodyFact'
			let factKey = self.sweepRegistrationKey(entry.name, moduleDirectory: moduleDirectory)

			match entry.fact 'which'
				leavesByPanicking then self.recordSweptBodyFact(factKey, marked: self.mainThreadSettled().funcDiverges, shape: SignatureDiscriminator.declShapeDiverges)
				leavesByThrowing then self.recordSweptBodyFact(factKey, marked: self.mainThreadSettled().funcAlwaysThrows, shape: SignatureDiscriminator.declShapeAlwaysThrows)
				returnsAFreshRecord then self.recordSweptBodyFact(factKey, marked: self.mainThreadSettled().funcReturnsFreshRecord, shape: SignatureDiscriminator.declShapeReturnsFreshRecord)
				returnsAFreshRecordIfCalleeDoes(forwards) then self.recordFreshReturnForward(factKey, forwards: forwards, declFilePath: filePath)
				constructsSelfFromItsParameters then self.recordSweptBodyFact(factKey, marked: self.mainThreadSettled().funcConstructsFromParams, shape: SignatureDiscriminator.declShapeConstructsFromParams)
				returnsAFieldOfItsReceiver then self.recordSweptBodyFact(factKey, marked: self.mainThreadSettled().funcReturnsReceiverField, shape: SignatureDiscriminator.declShapeReturnsReceiverField)
				returnsAMovedOutElementIfFieldDoes(forwards) then self.recordFieldMoveOutForward(factKey, forwards: forwards, declFilePath: filePath)
				returnsAParameter then self.recordSweptBodyFact(factKey, marked: self.mainThreadSettled().funcReturnsParameter, shape: SignatureDiscriminator.declShapeReturnsParameter)
			end 'which'
		end 'eachProvedBodyFact'
	end 'foldFile'

	// The identity case is not merely a shortcut, it avoids an ALLOCATION per declared function in
	// the program: `remapMaxonReturnType` CONSTRUCTS a `MaxonReturnType`, and a Maxon union value is
	// a heap object (every case), so remapping ids that did not move would allocate a fresh copy of
	// the object it was handed, for nothing.
	//
	// ⚠ Written as two `record` calls, NOT as `x if not remap.movesAnything() else remap(x)`. The
	// ternary form LEAKS — its arms mix a BORROWED field read with a freshly-OWNED value, and the
	// conditional does not reconcile the two ownerships, so the build exits 101.
	function recordScannedSignature(entry FuncReturnTypeEntry, name ByteArray, moduleDirectory String, declFilePath FilePath, remap TypeIdRemap)
		if not remap.movesAnything() 'idsUnchanged'
			self.record(name, moduleDirectory: moduleDirectory, returnType: entry.returnType, declaredSurface: entry.declaredSurface, visibility: entry.visibility, declFilePath: declFilePath, takesReceiver: entry.takesReceiver, opaqueParams: entry.opaqueParams, paramNames: entry.paramNames, paramTypes: entry.paramTypes, paramSpellings: entry.paramSpellings, paramDefaults: entry.paramDefaults, returnAliasName: entry.returnAliasName, nameLine: entry.nameLine, nameColumn: entry.nameColumn, enclosingTypeName: entry.enclosingTypeName, selfCapability: entry.selfCapability, paramCapabilities: entry.paramCapabilities, returnCapability: entry.returnCapability)
			return
		end 'idsUnchanged'

		self.record(name, moduleDirectory: moduleDirectory, returnType: remapMaxonReturnType(entry.returnType, remap: remap), declaredSurface: entry.declaredSurface, visibility: entry.visibility, declFilePath: declFilePath, takesReceiver: entry.takesReceiver, opaqueParams: entry.opaqueParams, paramNames: entry.paramNames, paramTypes: remapMaxonTypes(entry.paramTypes, remap: remap), paramSpellings: entry.paramSpellings, paramDefaults: entry.paramDefaults, returnAliasName: entry.returnAliasName, nameLine: entry.nameLine, nameColumn: entry.nameColumn, enclosingTypeName: entry.enclosingTypeName, selfCapability: entry.selfCapability, paramCapabilities: entry.paramCapabilities, returnCapability: entry.returnCapability)
	end 'recordScannedSignature'

	function recordSweptDefaultHelpers(info ParamDefaultInfo, helpers SweptDefaultHelperArray, bareName ByteArray, registrationName ByteArray, moduleDirectory String, declFilePath FilePath, remap TypeIdRemap) returns ParamDefaultInfo
		var filed = info

		for helper in helpers 'eachSynthesizedHelper'
			let helperName = self.defaultHelperNameUnder(helper.slot, sweptName: helper.signature.name, bareName: bareName, registrationName: registrationName)
			filed = filed.withHelperRenamed(helper.slot, renamedTo: helperName)
			self.recordScannedSignature(helper.signature, name: helperName, moduleDirectory: moduleDirectory, declFilePath: declFilePath, remap: remap)

			match helper.aliasReturn 'aliasReturn'
				statesNothing then continue
				states(aliasInfo) then self.recordGlobalAliasReturn(helperName, info: aliasInfo.declaredAs(helperName))
			end 'aliasReturn'
		end 'eachSynthesizedHelper'

		return filed
	end 'recordSweptDefaultHelpers'

	function defaultHelperNameUnder(slot ParamCount, sweptName immutable ByteArray, bareName ByteArray, registrationName ByteArray) returns immutable ByteArray
		if registrationName.equals(bareName) 'theHelperKeepsTheNameTheScanMintedForIt'
			return sweptName
		end 'theHelperKeepsTheNameTheScanMintedForIt'

		return paramDefaultHelperName(registrationName, paramIndex: slot)
	end 'defaultHelperNameUnder'

	// Add one declaration to the index AND fold it into the hash. The one write, so the table and the
	// hash that keys every parse memo on it can never disagree about what the index contains.
	//
	// ⭐⭐ **THE BUFFER-SPELLING WORD IS WRITTEN HERE, WITH THE RETURN TYPE IT DESCRIBES** — one
	// line, so the table and the claim beside it are written from one place about one declaration.
	//
	// ⚠⚠ **A DECLARATION'S SURFACE IS OR-ED IN AND NEVER OVERWRITTEN, AND THAT ASYMMETRY IS LOAD-BEARING
	// RATHER THAN A SAVING.** It makes the table answer "does ANY declaration of this name name the buffer,
	// and where?" — the same "absence is the answer" shape `recordThrows` and `recordParamConsume` rest on,
	// and for their reason. So `declaredReturnSurface` is exact for every name that reaches a call: a name
	// with no entry names the buffer in no declaration anywhere, and a name with one is unique (a second
	// declaration is E3006).
	//
	// ⭐⭐ **THE KEY IS NOT ALWAYS `name`: A FREE FUNCTION WHOSE BARE NAME A SECOND DIRECTORY DECLARES IS FILED
	// UNDER ITS `<directory>~name` MINT** — see `sweepRegistrationKey`, which every write below goes through.
	function record(name ByteArray, moduleDirectory String, returnType MaxonReturnType, declaredSurface immutable DeclaredSurface, visibility Visibility, declFilePath FilePath, takesReceiver bool, opaqueParams OpaqueParamInfo, paramNames NameRoster, paramTypes MaxonTypeArray, paramSpellings NameRoster, paramDefaults ParamPositionMask, returnAliasName ReturnAliasSpelling, nameLine LineNumber, nameColumn ColumnNumber, enclosingTypeName ByteArray, selfCapability ParamCapability, paramCapabilities ParamCapabilityArray, returnCapability ResultCapability)
		let key = self.sweepRegistrationKey(name, moduleDirectory: moduleDirectory)

		// An entry is another declaration's: a re-key strikes every fact from its source key (see
		// `rekeyDeclarationSweepEntries`).
		let isTheKeptDeclaration = not self.mainThreadSettled().returnTypes.contains(key) or self.precedesTheKeptSite(key, declFilePath: declFilePath, nameLine: nameLine, nameColumn: nameColumn)

		if isTheKeptDeclaration 'theFirstDeclarationAnswersTheReturnType'
			self.mainThreadSettled().returnTypes.upsert(key, value: returnType)
		end 'theFirstDeclarationAnswersTheReturnType'

		// Stored only when the clause wrote a name AND the recorded return type is a `named` one — which at this
		// point in the sweep is what a generic alias looks like, since the alias is not resolved to its instance
		// until later. ⛔ Gating on `genericInstance` instead is a WRONG ANSWER here and was measured as one: the
		// clause has not been resolved yet, so the test is false for every function and the stamp never happens.
		if isTheKeptDeclaration and returnTypeNamesAType(returnType) 'theClauseNamedAType'
			match returnAliasName 'spelled'
				named(aliasName) then self.mainThreadSettled().funcReturnAliasNames.upsert(key, value: aliasName)
				none then break
			end 'spelled'
		end 'theClauseNamedAType'

		if not surfaceIsPlain(declaredSurface) 'namesTheBufferAlias'
			self.mainThreadSettled().declaredReturnSurfaces.upsert(key, value: declaredSurface)
		end 'namesTheBufferAlias'

		if isTheKeptDeclaration and returnTypeNamesAType(returnType) 'aNameThisFileMustBeAbleToResolveLaterOn'
			self.mainThreadSettled().funcReturnDeclFiles.upsert(key, value: declFilePath)
		end 'aNameThisFileMustBeAbleToResolveLaterOn'

		if isTheKeptDeclaration 'theFirstDeclarationIsTheSite'
			self.mainThreadSettled().funcDeclSites.upsert(key, value: FunctionDeclSite.create(visibility, declFilePath: declFilePath, takesReceiver: takesReceiver, nameLine: nameLine, nameColumn: nameColumn, enclosingTypeName: enclosingTypeName))
		end 'theFirstDeclarationIsTheSite'

		if isTheKeptDeclaration 'theFirstDeclarationOfTheKeyIsTheOneKept'
			self.mainThreadSettled().sweptDeclarations.upsert(key, value: SweptDeclaration.create(paramNames, paramTypes: paramTypes, paramSpellings: paramSpellings, paramDefaults: paramDefaults, takesReceiver: takesReceiver, returnType: returnType, visibility: visibility, declFilePath: declFilePath, site: declarationSiteKey(declFilePath, line: nameLine, column: nameColumn), selfCapability: selfCapability, paramCapabilities: paramCapabilities, returnCapability: returnCapability))
		end 'theFirstDeclarationOfTheKeyIsTheOneKept'

		// ⭐ **THE OPAQUE-PARAMETER POSITIONS ARE WRITTEN HERE, WITH THE DECLARATION THEY DESCRIBE** —
		// the same one-act discipline `declaredSurface`, `visibility` and `takesReceiver` ride on, and for
		// their reason: they are facts about ONE declaration, and a second writer is a second chance for them
		// to come to describe two.
		//
		// ⚠ IT IS KEYED BY `key` LIKE EVERY OTHER WRITE HERE, so a re-key carries it by construction and there is
		// nothing for the contest registries to strand — which was already true of the free-function contest for
		// a reason of its own: a bare type-parameter parameter can only be declared inside a generic type's
		// body, and a free function is by definition outside every one, so this map never holds an entry a
		// NAMESPACE contest could be about.
		if isTheKeptDeclaration and opaqueParams.declaresATypeParameterParam() 'theKeptDeclarationTakesABareTypeParameter'
			self.mainThreadSettled().funcOpaqueParams.upsert(key, value: opaqueParams)
		end 'theKeptDeclarationTakesABareTypeParameter'

		// The KEY is mixed and not the source name, which is what makes a contested name move the hash
		// without a discriminator of its own: a free function a second directory declares is folded under its
		// `<directory>~name` key.
		self.hash = self.mixDeclaration(self.hash, name: key, returnType: returnType, declaredSurface: declaredSurface, visibility: visibility, declFilePath: declFilePath, takesReceiver: takesReceiver, opaqueParams: opaqueParams, paramNames: paramNames, paramTypes: paramTypes, paramSpellings: paramSpellings, paramDefaults: paramDefaults, selfCapability: selfCapability, paramCapabilities: paramCapabilities, returnCapability: returnCapability)
		self.noteDeclaredName(key)
	end 'record'

	// ⭐⭐⭐ **THE KEY THE SWEEP FILES A DECLARATION UNDER.**
	//
	// A free function whose bare name a second DIRECTORY declares is re-keyed to its `<directory>~name` mint
	// (`freeFunctionRegistrationName`). Every recorder in the fold routes through here, so a declaration's
	// return type, its `throws` clause and its parameter defaults all land on ONE key — the same key the
	// parser asks with (`Parser.declaredMethodName`).
	//
	// ⛔⛔ **ENTRIES ARE FILED UNDER ONE KEY, OR THE ANSWER IS SILENTLY WRONG.** Entries moved onto
	// `alpha~pick` with the facts left on the bare `pick` would have every gate keyed on the registration
	// name read maps nothing wrote for it.
	//
	// It costs one `Map.contains` on a map that is EMPTY for every program that declares no name in two
	// directories, which returns at its `capacity == 0` test before hashing.
	function sweepRegistrationKey(sourceName immutable ByteArray, moduleDirectory String) returns immutable ByteArray
		if self.isContestedFreeFunction(sourceName) 'moreThanOneDirectoryDeclaresThisName'
			return freeFunctionRegistrationName(sourceName, moduleDirectory: moduleDirectory)
		end 'moreThanOneDirectoryDeclaresThisName'

		return sourceName
	end 'sweepRegistrationKey'

	// ⭐ **WHICH OF `callee`'s PARAMETERS TAKE A BARE TYPE-PARAMETER ARGUMENT** — the door
	// `Parser.recordOpaqueArgRangeChecks` asks once it knows the call has a concrete generic-instance
	// receiver. A callee with no entry reads back the shared "declares none", which every predicate on the
	// record answers negatively for, so the caller needs no second presence test. `Map.get` is a `try` and a
	// name with no entry is the common case rather than an error.
	export function opaqueParamsOf(callee ByteArray) returns OpaqueParamInfo
		return try self.settledDeclarations().funcOpaqueParams.get(callee) otherwise OpaqueParamInfo.none()
	end 'opaqueParamsOf'

	// The surface already recorded for `name`, or the plain one. Split out because `Map.get` is a `try` and a
	// name with no entry is the common case rather than an error.
	function storedReturnSurface(name ByteArray) returns immutable DeclaredSurface
		return try self.settledDeclarations().declaredReturnSurfaces.get(name) otherwise plainDeclaredSurface()
	end 'storedReturnSurface'

	// ⭐ **WHERE DOES A CALL TO `callee` NAME THE `__ManagedMemory` BUFFER?** The door
	// `Parser.emitCall` asks of every direct, method and static call, so a result whose callee DECLARED the
	// alias — outright, or at a tuple slot, or as an array element — is marked at the one site that mints it.
	// It must be whole-program: the callee may be declared in another file, and the SPELLING is gone from
	// every type by the time the call is parsed.
	//
	// ⚠ **AN ALIAS SPELLING'S BITS ARE DERIVED HERE RATHER THAN TAKEN FROM THE STORE**, because the SWEEP that
	// captured this declaration ran while the alias registries were still being built — `returns BufArray`
	// cannot be asked "is `BufArray` an array of buffers?", nor `returns ByteBuffer` "is `ByteBuffer` the
	// buffer itself?", at the moment it is read. What the sweep DOES preserve is the alias NAME,
	// inside the recorded return type, and by the time anything asks this question every file is
	// folded. The stored bits are OR-ed in rather than replaced, which is what covers the other file
	// order. See `derivedAliasSurfaceBits`.
	//
	// A callee with no entry and a non-alias return type costs one `Map.contains` on an empty map plus a tag
	// test per call — the safe default `funcThrows`/`funcParamConsumes` rest on.
	export function declaredReturnSurface(callee ByteArray) returns immutable DeclaredSurface
		if let declared = try self.settledDeclarations().returnTypes.get(callee) 'declaresAReturnType'
			return match declared 'r'
				void gives self.storedReturnSurface(callee)
				value(inner) gives self.surfaceWithDerivedAliasBits(self.storedReturnSurface(callee), declared: inner)
			end 'r'
		end 'declaresAReturnType'

		return self.storedReturnSurface(callee)
	end 'declaredReturnSurface'

	// ⭐ **THE ONE FOLD OF A STORED SURFACE WITH THE SPELLING BITS THAT MUST BE DERIVED.** Every declared
	// position whose surface the SWEEP wrote asks it — a struct FIELD (`fieldSurfaceOf`), a declared RETURN
	// (above), and a union PAYLOAD (`payloadSurfaceOf`) — because NEITHER spelling bit is a fact that sweep
	// could answer; see `derivedAliasSurfaceBits` for why. Written out at each door, it would be three
	// copies of one rule.
	function surfaceWithDerivedAliasBits(stored immutable DeclaredSurface, declared MaxonType) returns immutable DeclaredSurface
		let derived = self.derivedAliasSurfaceBits(declared)

		if derived == 0 'namesNoBufferAlias'
			return stored
		end 'namesNoBufferAlias'

		return surfaceWithRootBits(stored, bits: derived)
	end 'surfaceWithDerivedAliasBits'

	// ⭐⭐ **WHICH SPELLING BITS DOES THIS DECLARED POSITION'S ALIAS NAME CARRY?** THE one
	// derivation, reached by every SWEPT position through `surfaceWithDerivedAliasBits` — the struct FIELD,
	// the RETURN clause and the union PAYLOAD — so no two of them can come to disagree about what
	// `var bufs as BufArray` and `var buf as ByteBuffer` mean.
	//
	// ⚠⚠ **NEITHER BIT IS A FACT THE SWEEP THAT RECORDED THE POSITION COULD ANSWER, AND THAT IS *ONE* CAUSE
	// RATHER THAN TWO.** Both registries are written by `recordGenericAlias` on ADJACENT LINES, and
	// `recordGenericAlias` is called from `foldFile` — i.e. after the whole file has been swept. So a position
	// spelled with an alias its OWN file declares is read while both sets are still empty, whichever bit it
	// wanted — the element bit and the outright one alike (`var buf as ByteBuffer` seven lines below
	// `typealias ByteBuffer = __ManagedMemory with Byte` must still reach `length`) — so both are
	// derived here rather than by two mechanisms free to disagree.
	//
	// It reads the `named` the SWEEP recorded and not a resolved type, and that is the whole mechanism: an
	// alias-typed position arrives as a bare `named` carrying the name (the very property `declaredSlotType`'s
	// re-tags exist to undo). A position that is ALREADY a `genericInstance` was written where the alias was
	// registered, so `parseTypeReference` folded the spelling away and there is nothing left in it to ask —
	// which is correct, because `Array with __ManagedMemory` and `Array with ByteArray` are one instance,
	// exactly as `__ManagedMemory with Byte` and `ByteArray` are.
	//
	// ⚠⚠ **AND IT IS THE SOLE CARRIER FOR AN ALIAS SPELLING, NOT A COMPLEMENTARY HALF.**
	// `parseTypeReference`'s alias arms are gated on `allFilesFolded`, and `Queries.foldOneFileInto`
	// folds EVERY file before that flag is set, so a swept alias-typed position keeps its bare `named`
	// in every file order, and this answers for it in every file order. A sweep-side registry read
	// would consult a whole-program set for a FILE-SCOPED name
	// (`Parser.spellingDenotesBufferSurface`). What the sweep stores is the LITERAL `__ManagedMemory`
	// spelling, which is a token fact needing no registry, and the tuple-slot mask.
	//
	// ⚠ **IT NEEDS NO READER FILE, AND THAT IS A PROPERTY OF ITS INPUT RATHER THAN AN OMISSION.** A name
	// reaching here is either uncontested — one declaration, so every file means the same one — or has already
	// been rewritten to its per-instance MINT by `resolveRecordedGenericAliasTypes`, and a mint is never itself
	// contested. The file-scoping this cannot do is therefore never asked of it; the door that IS asked is
	// `aliasSpellingSurfaceBits`.
	//
	// ⚠ The name is asked exactly as RECORDED, which is BASE-QUALIFIED for an inner alias
	// (`Character.ByteMemory`): `parseTypeReference`'s inner-alias arm and `qualifiedInnerGenericAlias` build
	// that one string between them, so this needs no second key and no knowledge that inner aliases exist.
	function derivedAliasSurfaceBits(declared MaxonType) returns DeclaredSurfaceNode
		if maxonTypeTag(declared) != ValueTypeTag.named 'notANamedAlias'
			return 0
		end 'notANamedAlias'

		return self.bufferAliasSurfaceBits(self.nameOfId(typeNameIdOf(declared)))
	end 'derivedAliasSurfaceBits'

	// ⭐ **WHICH SPELLING BITS AN ALIAS NAME THE SOURCE WROTE CARRIES — `derivedAliasSurfaceBits`' twin for a
	// spelling that is still a TOKEN rather than a recorded type.** A factory called through the alias
	// (`BufCell.make(…)`) is the position that needs it: the value it mints has no declared type to read, only
	// the name the call site wrote. It is READER-SCOPED where the twin is not, and that difference is its
	// input's: the twin reads a name the sweep already rewrote to a per-instance mint, this one reads what a
	// particular file's tokens say, and two files may declare one alias name (`declaredIdentityOfSpelling`).
	export function aliasSpellingSurfaceBits(name ByteArray, readerFilePath FilePath) returns DeclaredSurfaceNode
		return self.bufferAliasSurfaceBits(self.declaredIdentityOfSpelling(name, declFilePath: readerFilePath))
	end 'aliasSpellingSurfaceBits'

	// THE one decoder of an already-scoped alias name's two spelling bits, so the two doors above cannot come
	// to disagree about which set carries which bit — the pairing `derivedAliasSurfaceBits` states once.
	// It takes the name SCOPED, because scoping is exactly what the two callers differ on.
	function bufferAliasSurfaceBits(aliasName ByteArray) returns DeclaredSurfaceNode
		var bits = 0 as DeclaredSurfaceNode

		if self.settledDeclarations().bufferSurfaceAliases.contains(aliasName) 'aliasIsItselfTheBuffer'
			bits = bits or SurfaceBitIsBuffer
		end 'aliasIsItselfTheBuffer'

		if self.settledDeclarations().bufferElementAliases.contains(aliasName) 'aliasHoldsBuffers'
			bits = bits or SurfaceBitElementIsBuffer
		end 'aliasHoldsBuffers'

		return bits
	end 'bufferAliasSurfaceBits'

	// ⭐⭐ **THE SPELLING BITS A DECLARATION-VIEW POSITION INHERITS FROM THE INSTANCE ARGUMENT IT IS WRITTEN IN
	// TERMS OF — THE FOURTH DECLARED POSITION, and the only one that never had a word.** `returnShapeSurface`,
	// `fieldShapeSurface` and `payloadShapeSurface` each carry a pre-erasure spelling because
	// `__ManagedMemory` and `ByteArray` resolve to the SAME `genericInstance`; a generic type ARGUMENT is the
	// fourth position where that is true, and `substitutedInstanceArg` — the reader every substituted slot goes
	// through — hands back the resolved argument with the spelling already gone.
	//
	// ⚠ **THE SPELLING CANNOT LIVE ON THE INSTANCE, WHICH IS WHY THIS TAKES `id` AND ANSWERS ONLY BITS.**
	// `Array with __ManagedMemory` and `Array with ByteArray` intern to ONE `GenericInstanceId` deliberately —
	// that identity is what lets one `Array` body serve both, and the buffer surface rests on the two
	// being one TYPE with two SURFACES. So the argument's spelling is carried by the VALUE
	// (`Parser.bufferSurfaceElements`, which says *argument `BufferSurfaceArgPosition` of this value's
	// instance was spelled the buffer*), and what this door answers is the other half: WHERE in a
	// declaration-view type that argument lands.
	//
	// Two shapes, which are exactly the two bits a `DeclaredSurfaceNode` has:
	//   • `returns Element` — the position IS the argument ⇒ the value is a buffer;
	//   • `returns ArrayIterator with Element` — the position HOLDS it at its own argument 0 ⇒ the value's
	//     elements are buffers, and a `current()` on THAT value reaches the first arm one hop later.
	// The two compose, which is what carries the surface across `for m in bufs` under a corpus `Array`:
	// `createIterator()` takes the second, `current()` the first.
	//
	// ⚠ **THE OWNER IS CHECKED, NOT ONLY THE POSITION** — `substituteThroughInstance`'s guard, for its reason:
	// a parameter token identifies `(declaring type, parameter name)`, so another declaration's
	// parameter that happens to sit at position 0 must not be read as this instance's argument.
	//
	// ⚠ **IT TAKES AN INTERNER, AND THAT IS `substituteThroughInstanceInterned`'S REASON EXACTLY.** The two
	// arms above key on whole-program payloads — a `typeParameter` carries its digest, a `genericInstance` a
	// registry id — but the SECOND arm's input may arrive as a bare `named`, whose payload is an id in the
	// caller's own table. A caller therefore hands the table its type was minted from; reading such an id here
	// against `self.typeNames` is right exactly while two insertion orders coincide.
	export function surfaceBitsThroughInstanceArg(declared MaxonType, id GenericInstanceId, interner TypeNameInterner, readerFilePath FilePath) returns DeclaredSurfaceNode
		if self.namesBufferArgOf(declared, id: id) 'thePositionISTheArgument'
			return SurfaceBitIsBuffer
		end 'thePositionISTheArgument'

		match self.declarationViewInstanceOf(declared, scopeOwner: self.genericInstanceBaseName(id), interner: interner, readerFilePath: readerFilePath) 'holder'
			notInScope then return 0
			instance(nested) then return self.elementBitOfInstanceArg(nested, id: id)
		end 'holder'
	end 'surfaceBitsThroughInstanceArg'

	// ⭐ **THE INSTANCE A DECLARATION-VIEW POSITION DENOTES — three spellings of one thing.** A position
	// written OUT (`Cell with T` as a generic argument) already carries the instance; the other two arrive as
	// a bare `named`, and each has its own resolver, which is why this composes rather than picking:
	//   • the body's own inner `typealias` (`returns TCell`) — `parseTypeReference` records it BASE-QUALIFIED
	//     (`Holder.TCell`), which is the generic-alias registry's key for it;
	//   • a bare generic BASE in a type-parameter scope (`returns Inner` inside `type Outer uses T`) — the
	//     shape `Parser.promoteBareGenericResultToCalleeScope` exists for, minted by `scopedGenericInstanceOf`.
	//
	// The scope that binds the second is the CALLEE'S DECLARING TYPE, which here is the receiver instance's
	// base: `Parser.instanceSourceOfCall` has already refused any callee not qualified under it, so the
	// two cannot disagree.
	//
	// Both resolvers are the ONE door for their spelling — `genericAliasInstanceFrom` is what the parser
	// itself resolves an alias through, reader-scoped so two files' same-named alias stay two, and
	// `scopedGenericInstanceOf` is the single mint for the other.
	function declarationViewInstanceOf(declared MaxonType, scopeOwner ByteArray, interner TypeNameInterner, readerFilePath FilePath) returns ScopedGenericInstance
		if maxonTypeTag(declared) == ValueTypeTag.genericInstance 'writtenOut'
			return ScopedGenericInstance.instance(genericInstanceIdOf(declared))
		end 'writtenOut'

		if maxonTypeTag(declared) != ValueTypeTag.named 'spellsNoInstance'
			return ScopedGenericInstance.notInScope
		end 'spellsNoInstance'

		let name = try interner.nameOf(typeNameIdOf(declared)) otherwise panic("ProgramSignatures.declarationViewInstanceOf: `named` id {typeNameIdOf(declared)} is not in the interner it was read with — a caller must hand the table its own type was minted from")

		if self.isAliasOfFormFor(name, readerFilePath: readerFilePath, wanted: FormAliasKind.generic) 'spellsAnAlias'
			return ScopedGenericInstance.instance(self.genericAliasInstanceFrom(name, readerFilePath: readerFilePath))
		end 'spellsAnAlias'

		return self.scopedGenericInstanceOf(name, declaringTypeName: scopeOwner, scopeParamNames: self.structTypeParamsOf(scopeOwner))
	end 'declarationViewInstanceOf'

	// Does instance `nested` hold instance `id`'s buffer-spelled argument at its OWN
	// `BufferSurfaceArgPosition`? The second arm of the door above, split out because a `match` arm may not
	// open one.
	function elementBitOfInstanceArg(nested GenericInstanceId, id GenericInstanceId) returns DeclaredSurfaceNode
		if self.genericInstanceArgCount(nested) <= BufferSurfaceArgPosition 'noArgumentToHoldIt'
			return 0
		end 'noArgumentToHoldIt'

		if not self.namesBufferArgOf(self.substitutedInstanceArg(nested, position: BufferSurfaceArgPosition), id: id) 'itHoldsSomethingElse'
			return 0
		end 'itHoldsSomethingElse'

		return SurfaceBitElementIsBuffer
	end 'elementBitOfInstanceArg'

	// Is `t` the type parameter instance `id` binds at `BufferSurfaceArgPosition`? The predicate both arms
	// above ask, of the two positions a declaration view can put that parameter in.
	//
	// A token with no owner is the same invariant break `substituteThroughInstance` panics on, and it is the
	// same population of tokens: every one reaching here was minted inside a declaration the sweep folded.
	function namesBufferArgOf(t MaxonType, id GenericInstanceId) returns bool
		if maxonTypeTag(t) != ValueTypeTag.typeParameter 'notAFormalParameter'
			return false
		end 'notAFormalParameter'

		let owner = try self.typeParamOwnerOf(typeParamIdOf(t)) otherwise panic("ProgramSignatures.namesBufferArgOf: type-parameter token {typeNameIdOf(t)} has no owner — `recordStruct` and `recordInterfaceDeclaration` file every declared parameter as the sweep folds, so a token with none was minted inside a declaration neither fold saw")
		return owner.position == BufferSurfaceArgPosition and owner.declaringTypeName.equals(self.genericInstanceBaseName(id))
	end 'namesBufferArgOf'

	// Does the generic-instance alias `name` hold BUFFERS — was it declared `Array with
	// __ManagedMemory`? The read side of `bufferElementAliases`; `Set.contains` on the shared empty
	// set returns before it hashes, so a program that never writes the alias does not pay to ask.
	export function aliasElementIsBufferSurface(name ByteArray, readerFilePath FilePath) returns bool
		return self.settledDeclarations().bufferElementAliases.contains(self.declaredIdentityOfSpelling(name, declFilePath: readerFilePath))
	end 'aliasElementIsBufferSurface'

	// Does the generic-instance alias `name` DENOTE a buffer — was it declared `__ManagedMemory with
	// T`? The read side of `bufferSurfaceAliases`, and the door that makes `initKeys.length()` legal
	// where the parameter is declared `KeyMemory` rather than `__ManagedMemory`. `Set.contains` on the
	// shared empty set returns before it hashes, so a program with no such alias does not pay to ask.
	export function aliasDenotesBufferSurface(name ByteArray, readerFilePath FilePath) returns bool
		return self.settledDeclarations().bufferSurfaceAliases.contains(self.declaredIdentityOfSpelling(name, declFilePath: readerFilePath))
	end 'aliasDenotesBufferSurface'

	// Does the conformer declare `qualified` in its own body as a member of this kind, so an
	// `extension` must not publish its same-named member onto it? An interface extension supplies
	// default implementations, and a conformer that declares the member has said what it means there.
	// Only a declaration of the same kind counts: a type-body `static` beside an extension's instance
	// method of the same name shadows nothing, and counting it binds every call of the instance method
	// to the static. Asked by `Parser.foldExtensionDeclarationInto`, which records the answer for the
	// real parse.
	//
	// A signature an extension published does not count, which keeps the verdict independent of fold
	// order: two extensions publishing one `<Conformer>.<method>` stay E3006 whichever folds first.
	//
	// This is not the test for "does `<Type>.<method>` exist": every method an extension publishes is
	// a method of the conformer, and this answers `false` for it. Existence is `declaresCallee`.
	export function conformerDeclaresOwnMethod(qualified ByteArray, takesReceiver bool) returns bool
		let site = try self.settledDeclarations().funcDeclSites.get(qualified) otherwise return false
		return site.takesReceiver == takesReceiver and not self.settledDeclarations().extensionPublishedMethods.contains(extensionMemberKindKey(qualified, takesReceiver: takesReceiver))
	end 'conformerDeclaresOwnMethod'

	// ⭐⭐ **DOES `qualified` CARRY A HIDDEN `self`?** — the receiver half of resolving a bare sibling call to a
	// declaration whose body the parser cannot see (`Parser.isImplicitSelfMethod`). Wherever the parser CAN see
	// the body it reads the same fact off the tokens (`functionDeclIsStatic`), and both answers come from that
	// one test: the sweep captures it at the declaration and files it here.
	//
	// ⚠ **A NAME NOTHING DECLARES PANICS RATHER THAN ANSWERING "receiverless"** — the caller has already
	// established that the declaration exists (`declaresCallee`), because a name with no declaration is not a
	// sibling at all and takes a different door entirely. Answering `false` for it would be a sentinel: a typo
	// would silently become a receiver-less call and be reported against its ARGUMENTS.
	// ⭐ **THE FILE THAT DECLARED THIS FUNCTION — the reader for any question about what a name in its own
	// SIGNATURE means**, a `throws` clause included. A signature's names are spelled by the declaring file,
	// so that file is the one whose meaning of them is the right one; asking a reader-aware door with
	// anything else answers a meaning question for a file that never wrote the name.
	//
	// It PANICS rather than defaulting because every caller reaches it through a key the declaration sweep
	// has already recorded a site for — `funcDeclSites` and the throws/return registries are written by one
	// act (`record`) — and a reader invented for a missing site is exactly the wrong-file answer above.
	export function declaringFileOf(qualified ByteArray) returns FilePath
		let site = try self.settledDeclarations().funcDeclSites.get(qualified) otherwise panic("ProgramSignatures.declaringFileOf: nothing declares '{String.from(qualified)}' — the caller establishes that before asking what a name in its signature means")

		return site.declFilePath
	end 'declaringFileOf'

	export function declaringFileIfDeclared(qualified ByteArray) returns FilePath throws AbsentError
		let site = try self.settledDeclarations().funcDeclSites.get(qualified) otherwise throw AbsentError.absent

		return site.declFilePath
	end 'declaringFileIfDeclared'

	export function cloneIsACompilerCopy(callee ByteArray) returns bool
		if not self.declaresCallee(callee) 'synthesized'
			return true
		end 'synthesized'

		return self.declaredByTheSharedCorpusAt(self.declaringFileOf(callee).toString())
	end 'cloneIsACompilerCopy'

	export function declaredMethodTakesReceiver(qualified ByteArray) returns bool
		let site = try self.settledDeclarations().funcDeclSites.get(qualified) otherwise panic("ProgramSignatures.declaredMethodTakesReceiver: nothing declares '{String.from(qualified)}' — the caller establishes that through `declaresCallee` first, and the two registries are written by one act (`record`)")
		return site.takesReceiver
	end 'declaredMethodTakesReceiver'

	function declaredMemberKeysOf(typeName ByteArray) returns NameRoster
		let prefix = qualifiedMethodName(typeName, methodName: EmptySourceText)
		let keys = NameRoster.create(0)

		for (qualified, _) in self.settledDeclarations().funcDeclSites 'eachDeclaration'
			if bytesStartWith(qualified, prefix: prefix) 'declaredOnThisType'
				keys.push(qualified)
			end 'declaredOnThisType'
		end 'eachDeclaration'

		return keys
	end 'declaredMemberKeysOf'

	// Note that the `extension` declared in `declFilePath` published `qualified` onto a conformer: the
	// write side of `conformerDeclaresOwnMethod`, noted per member kind. The publication sets do not ride
	// the hash: they are derived from declarations the hash already carries.
	export function noteExtensionPublishedMethod(qualified ByteArray, takesReceiver bool, declFilePath FilePath, isStdlibSource bool)
		self.mainThreadSettled().extensionPublishedMethods.insert(extensionMemberKindKey(qualified, takesReceiver: takesReceiver))
		self.noteDeclaredName(qualified)

		if not self.mainThreadSettled().extensionMethodDeclFiles.contains(qualified) 'theFirstPublication'
			self.mainThreadSettled().extensionMethodDeclFiles.upsert(qualified, value: declFilePath)
		end 'theFirstPublication'

		if isStdlibSource 'theCorpusPublishedIt'
			self.mainThreadSettled().stdlibPublishedExtensionMethods.insert(qualified)
		end 'theCorpusPublishedIt'
	end 'noteExtensionPublishedMethod'

	export function noteInterfaceExtensionMember(qualified ByteArray, conformer ByteArray, interfaceName ByteArray)
		self.mainThreadSettled().interfaceExtensionMembers.upsert(qualified, value: InterfaceExtensionMember.create(conformer, interfaceName: interfaceName))
	end 'noteInterfaceExtensionMember'

	// ⭐⭐⭐ **THE RESIDUE OF THE `stdlib/PrimitiveExtensions.maxon` RETIREMENT — THE MEMBERS WHOSE ANSWER THE
	// COMPILER DECIDES FROM A COORDINATE OF THE RECEIVER THE CORPUS BODY CANNOT STATE.** The
	// framing is that **a roster is the RESIDUE of what could not retire**, so this list is a
	// finding rather than a policy, and every entry owes the measurement that put it there.
	//
	// ⛔⛔ **`int.toString` IS ON IT BECAUSE THE CORPUS BODY IS A SILENT WRONG ANSWER FOR AN UNSIGNED
	// RECEIVER — MEASURED, NOT ARGUED.** `stdlib/PrimitiveExtensions.maxon:21-23` is `return "{self}"`, and
	// `self` there is declared `int`, which in this language is the WHOLE of `i64` and therefore SIGNED
	// (`specs/x8`: no ranged type is not no constraint). the compiler's rule is the opposite one —
	// *"signedness is a property of the value's DECLARED type, read once by the compiler and handed to the
	// renderer"* (`specs/string-interpolation.md`) — and the declared type at the CALL is the caller's
	// `int(0 to u64.max)`, a coordinate the corpus parameter erases. With the module listed and this roster
	// empty, `string-interpolation/unsigned-decimal-tostring` printed **`[-1]` where it pins
	// `[18446744073709551615]`**, and `1 shl 63` came back `[-9223372036854775808]`.
	// ⚠ **The ORACLE prints `[-1]` too** (measured, same program), so this is not the compiler catching up — it is
	// the compiler's own deliberate divergence, and it lives in the renderer the corpus cannot reach.
	//
	// ⭐ **IT IS THE `FixedArray` SIZE STORY ONE AXIS OVER, WHICH IS WHY BOTH RETIREMENTS FILE A RESIDUE.** There,
	// a declaration's own `Self` states no COUNT while every value has one; here, a declaration's own `self`
	// states no RANGE while every receiver has one. A member whose answer needs the coordinate cannot retire
	// until the coordinate travels.
	//
	// ⚠ **`hash`, `equals`, `compare` AND `clone` ARE DELIBERATELY ABSENT**: each is a pure function of the
	// receiver's BITS, which is exactly what the corpus body has, and each is measurably live off the
	// declaration (the differing-declarations control moves `42.hash()` to `142`). `float.toString` and
	// `bool.toString` are absent for the same reason — neither renderer reads a range.
	function primitiveMembersTheCompilerRetains(typeName ByteArray) returns NameRoster
		let names = NameRoster.create(0)

		if typeName.equals(IntConformerName) 'theRangedPrimitive'
			names.push(ToStringMethodName)
		end 'theRangedPrimitive'

		return names
	end 'primitiveMembersTheCompilerRetains'

	function compilerOutranksTheCorpusOn(typeName ByteArray, member ByteArray, callee ByteArray) returns bool
		if not self.primitiveMembersTheCompilerRetains(typeName).contains(member) 'notOnTheResidueRoster'
			return false
		end 'notOnTheResidueRoster'

		return self.corpusDeclarationStands(callee)
	end 'compilerOutranksTheCorpusOn'

	function corpusDeclarationStands(callee ByteArray) returns bool
		return self.extensionMethodPublishedByStdlib(callee)
	end 'corpusDeclarationStands'

	// The corpus declares `int.hash` and its siblings itself, so `declaresCallee` alone is true of
	// every primitive member; the member is the PROGRAM's own only where no standing corpus
	// declaration accounts for it.
	export function userDeclaresMember(typeName ByteArray, member ByteArray) returns bool
		let callee = qualifiedMethodName(typeName, methodName: member)
		return self.declaresCallee(callee) and not self.corpusDeclarationStands(callee)
	end 'userDeclaresMember'

	export function declaredMemberBeatsTheCompiler(typeName ByteArray, member ByteArray) returns bool
		let callee = qualifiedMethodName(typeName, methodName: member)
		return self.declaresCallee(callee) and not self.compilerOutranksTheCorpusOn(typeName, member: member, callee: callee)
	end 'declaredMemberBeatsTheCompiler'

	// ⭐ **DID A LISTED STDLIB `extension` PUBLISH `qualified`?** — the test `corpusDeclarationStands`
	// builds its residue rule on: a member the CORPUS declares is one whose declaration describes what the
	// compiler already does.
	export function extensionMethodPublishedByStdlib(qualified ByteArray) returns bool
		return self.settledDeclarations().stdlibPublishedExtensionMethods.contains(qualified)
	end 'extensionMethodPublishedByStdlib'

	// Note that an `extension`'s member was withheld from a conformer that declares its own of the
	// same kind. The decision is recorded and read back by the real parse, so the body it emits and
	// the signature the fold published are one answer rather than two derivations of it.
	export function noteExtensionShadowedMethod(qualified ByteArray, takesReceiver bool)
		self.mainThreadSettled().extensionShadowedMethods.insert(extensionMemberKindKey(qualified, takesReceiver: takesReceiver))
	end 'noteExtensionShadowedMethod'

	export function noteExtensionHeldArgument(conformer ByteArray, interfaceName ByteArray, associatedPosition ElementIndex, held ExtensionHeldArgument)
		let key = extensionHeldArgumentKey(conformer, interfaceName: interfaceName, associatedPosition: associatedPosition)
		let known = self.extensionHeldArguments(conformer, interfaceName: interfaceName, associatedPosition: associatedPosition)

		for entry in known 'eachKnown'
			if entry.position == held.position and entry.baseName.equals(held.baseName) 'alreadyNoted'
				return
			end 'alreadyNoted'
		end 'eachKnown'

		let merged = ExtensionHeldArgumentArray.create(known.count() + 1, zeroed: false)
		merged.append(known)
		merged.push(held)

		self.mainThreadSettled().extensionHeldArguments.upsert(key, value: merged)

		// In the index's key, so an extension edited to store or stop storing an associated type
		// re-parses the conformers that bind it in other files.
		self.hash = mixBytes(Hasher.combined(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeExtensionHeldArgument), bytes: key), value: held.position as HashDigest), bytes: held.baseName)
	end 'noteExtensionHeldArgument'

	export function extensionHeldArguments(conformer ByteArray, interfaceName ByteArray, associatedPosition ElementIndex) returns ExtensionHeldArgumentArray
		if self.settledDeclarations().extensionHeldArguments.count() == 0 'noneNoted'
			return ExtensionHeldArgumentArray.create(0)
		end 'noneNoted'

		return try self.settledDeclarations().extensionHeldArguments.get(extensionHeldArgumentKey(conformer, interfaceName: interfaceName, associatedPosition: associatedPosition)) otherwise ExtensionHeldArgumentArray.create(0)
	end 'extensionHeldArguments'

	// Was `qualified` withheld from its conformer by the rule above? `Set.contains` on the shared empty set
	// returns before it hashes, so a program with no such shadow does not pay to ask.
	export function extensionMethodIsShadowed(qualified ByteArray, takesReceiver bool) returns bool
		return self.settledDeclarations().extensionShadowedMethods.contains(extensionMemberKindKey(qualified, takesReceiver: takesReceiver))
	end 'extensionMethodIsShadowed'

	// The one write of a function's ownership facts, for `record`'s reason: the table and the hash
	// that keys every parse memo on it cannot disagree about what the index contains. A function the
	// sweep found no consume, feed or hand-back in is not recorded, because its default answer is
	// "borrows everything", so the common function costs no map entry and no hash movement.
	function recordParamConsume(name ByteArray, site ByteArray, info ParamConsumeInfo)
		self.mainThreadSettled().funcParamConsumes.upsert(name, value: info)
		self.mainThreadSettled().declParamConsumes.upsert(site, value: info)
		self.forwardedStoresClosed = false
		var state = mixBytes(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeParamConsume), bytes: name), bytes: site)

		// The param NAMES ride too: a rename changes which labelled argument a caller slots to a consumed
		// position, so a caller's memo must move when they do (`transferConsumedArgs` slots against them
		// through `argSlotPosition`).
		for i in 0 upto info.paramNames.count() 'eachName'
			let paramName = try info.paramNames.get(i) otherwise panic("recordParamConsume: paramNames.get OOB at {i} despite i < count")
			let bit = info.isConsumed(i as ParamCount)
			state = Hasher.combined(mixBytes(state, bytes: paramName), value: SignatureDiscriminator.consumeBitSet if bit else SignatureDiscriminator.consumeBitClear)
			state = Hasher.combined(state, value: SignatureDiscriminator.handedOnBitSet if info.isHandedOn(i as ParamCount) else SignatureDiscriminator.handedOnBitClear)
		end 'eachName'

		for store in info.forwardedStores 'eachForwardedStore'
			state = Hasher.combined(mixBytes(mixBytes(mixBytes(Hasher.combined(Hasher.combined(Hasher.combined(Hasher.combined(state, value: store.paramIndex as HashDigest), value: store.shape.ordinal as HashDigest), value: store.calleeParam as HashDigest), value: store.column as HashDigest), bytes: store.typeName), bytes: store.memberName), bytes: store.label), value: SignatureDiscriminator.forwardedStoreDiscriminator)
		end 'eachForwardedStore'

		// The TYPE-PARAMETER FEEDS ride too: which position a parameter feeds decides whether a
		// caller consumes a managed argument there, so a change to it must move the caller's parse memo. Only a
		// generic constructor HAS a feed list (a non-generic function's `feeds` is EMPTY, so this loop does not
		// run and adds nothing — matching that such a function can never feed a type parameter). The STORED
		// feeds are read directly, never through `typeParamFeedOf`, whose out-of-range `none` would box a union
		// value per parameter on every consuming function in the program.
		for i in 0 upto info.feeds.count() 'eachFeed'
			state = self.mixTypeParamFeed(state, feed: try info.feeds.get(i) otherwise panic("recordParamConsume: feeds.get OOB at {i} despite i < count"))
		end 'eachFeed'

		self.hash = state
	end 'recordParamConsume'

	// Fold one parameter's type-parameter feed into the hash — `feeds(position, sink)` mixes both, `none` its own
	// discriminator (so a parameter that GAINED a feed hashes distinctly from one that never had one). The SINK
	// rides because the two sinks emit different programs for the same position: one enrols the callee
	// owner, the other leaves ownership with the constructed value.
	function mixTypeParamFeed(state HashDigest, feed TypeParamFeed) returns HashDigest
		return match feed 'f'
			feeds(position, sink) gives Hasher.combined(Hasher.combined(Hasher.combined(state, value: SignatureDiscriminator.feedShapeFeeds), value: position as HashDigest), value: feedSinkShape(sink))
			none gives Hasher.combined(state, value: SignatureDiscriminator.feedShapeNone)
		end 'f'
	end 'mixTypeParamFeed'

	// ⭐ **THE CALLEE'S CONSUME FACTS, or `borrowsAll`** — the door a CALL SITE asks once, then slots each
	// argument against `info.paramNames` to decide which ones are moved. `borrowsAll` (no recorded entry) is
	// every runtime callee, every borrow-only user function, and the overwhelming common case — so the call
	// site's fast path is a single `match` with nothing to slot.
	export function consumeOf(callee ByteArray) returns CalleeConsume
		let info = try self.settledDeclarations().funcParamConsumes.get(callee) otherwise return CalleeConsume.borrowsAll
		return CalleeConsume.consumes(info)
	end 'consumeOf'

	function closeForwardedStores()
		if self.forwardedStoresClosed 'alreadySettled'
			return
		end 'alreadySettled'

		self.forwardedStoresClosed = true

		let memo = PromiseTypeAnswerMap.create()
		let forwarders = ForwarderArray.create(0)
		let siteIndex = ForwarderSiteMap.create()
		let narrowed = ForwarderArray.create(0)
		let emptied = ForwarderArray.create(0)

		for (key, declaration) in self.settledDeclarations().sweptDeclarations 'eachKey'
			let info = try self.settledDeclarations().declParamConsumes.get(declaration.site) otherwise continue

			if not anyBitSet(info.handedOn) and info.forwardedStores.count() == 0 'nothingPromiseShaped'
				continue
			end 'nothingPromiseShaped'

			match self.promiseFactsThatCanCarry(info, declaration: declaration, memo: memo) 'verdict'
				none then emptied.push(Forwarder.create(key, decl: declaration, info: info))
				unchanged then self.noteForwarder(forwarders, siteIndex: siteIndex, forwarder: Forwarder.create(key, decl: declaration, info: info))
				narrower(pruned) then self.noteNarrowedForwarder(narrowed, forwarders: forwarders, siteIndex: siteIndex, forwarder: Forwarder.create(key, decl: declaration, info: pruned))
			end 'verdict'
		end 'eachKey'

		for forwarder in narrowed 'eachNarrowed'
			self.publishForwardedInfo(forwarder, info: forwarder.info)
		end 'eachNarrowed'

		for forwarder in emptied 'eachEmptied'
			_ = self.mainThreadSettled().declParamConsumes.remove(forwarder.decl.site)

			_ = self.mainThreadSettled().funcParamConsumes.remove(forwarder.key)
		end 'eachEmptied'

		if forwarders.count() > 0 'somethingForwards'
			self.propagateForwardedStores(forwarders, siteIndex: siteIndex)
		end 'somethingForwards'
	end 'closeForwardedStores'

	function closeIsolatedParamConsumes()
		for (key, declaration) in self.settledDeclarations().sweptDeclarations 'eachDeclaration'
			let owned = self.isolatedParamBitsOf(declaration)

			if not anyBitSet(owned) 'noIsolatedParameter'
				continue
			end 'noIsolatedParameter'

			let filed = try self.settledDeclarations().declParamConsumes.get(declaration.site) otherwise ParamConsumeInfo.noFacts(sweptParamNamesFor(declaration.paramNames, takesReceiver: declaration.takesReceiver, selfCapability: declaration.selfCapability))
			let bits = filed.bits.clone() as isolated BoolArray

			for position in 0 upto owned.count() 'eachOwnedPosition'
				if bitAt(owned, index: position as ParamCount) 'anIsolatedPosition'
					setParamBit(bits, index: position as ParamCount)
				end 'anIsolatedPosition'
			end 'eachOwnedPosition'

			let settled = filed.withBits(freeze bits)
			self.mainThreadSettled().declParamConsumes.upsert(declaration.site, value: settled)
			self.mainThreadSettled().funcParamConsumes.upsert(key, value: settled)
		end 'eachDeclaration'
	end 'closeIsolatedParamConsumes'

	function closeLinearParamConsumes()
		for (key, declaration) in self.settledDeclarations().sweptDeclarations 'eachDeclaration'
			let linear = self.linearParamBitsOf(declaration)

			if not anyBitSet(linear) 'noLinearParameter'
				continue
			end 'noLinearParameter'

			let filed = try self.settledDeclarations().declParamConsumes.get(declaration.site) otherwise ParamConsumeInfo.noFacts(sweptParamNamesFor(declaration.paramNames, takesReceiver: declaration.takesReceiver, selfCapability: declaration.selfCapability))
			let bits = filed.bits.clone() as isolated BoolArray

			for position in 0 upto linear.count() 'eachLinearPosition'
				if bitAt(linear, index: position as ParamCount) 'aLinearPosition'
					setParamBit(bits, index: position as ParamCount)
				end 'aLinearPosition'
			end 'eachLinearPosition'

			let settled = filed.withBits(freeze bits)
			self.mainThreadSettled().declParamConsumes.upsert(declaration.site, value: settled)
			self.mainThreadSettled().funcParamConsumes.upsert(key, value: settled)
		end 'eachDeclaration'
	end 'closeLinearParamConsumes'

	function linearParamBitsOf(declaration SweptDeclaration) returns BoolArray
		let linear = BoolArray.create(0)
		let firstSource = 1 if declaration.takesReceiver else 0

		for (iter, paramType) in declaration.paramTypes.withIterator() 'eachParameter'
			if self.typeIsLinear(paramType) 'aLinearParameter'
				setParamBit(linear, index: (iter.index() + firstSource) as ParamCount)
			end 'aLinearParameter'
		end 'eachParameter'

		return linear
	end 'linearParamBitsOf'

	function isolatedParamMaskOf(declaration SweptDeclaration) returns ParamPositionMask
		var mask = NoParamPositions
		let firstSource = 1 if declaration.takesReceiver else 0
		let written = self.writtenMarkersOf(declaration.site)

		for index in 0 upto declaration.paramCapabilities.count() 'eachParameter'
			let position = (index + firstSource) as ParamCount

			if self.declaredParamCapability(declaration, position: index) == ParamCapability.isolated and not maskHasParam(written, param: position) 'anOwnedRegion'
				mask = maskWithParam(mask, param: position)
			end 'anOwnedRegion'
		end 'eachParameter'

		return mask
	end 'isolatedParamMaskOf'

	function isolatedParamBitsOf(declaration SweptDeclaration) returns BoolArray
		let mask = self.isolatedParamMaskOf(declaration)
		let owned = BoolArray.create(0)

		for position in 0 upto MaxAbiArgs 'eachPosition'
			if maskHasParam(mask, param: position as ParamCount) 'anOwnedRegion'
				setParamBit(owned, index: position as ParamCount)
			end 'anOwnedRegion'
		end 'eachPosition'

		return owned
	end 'isolatedParamBitsOf'

	export function aliasIsolatedMask(alias FunctionTypeAlias) returns ParamPositionMask
		var mask = NoParamPositions

		for position in 0 upto alias.paramTypes.count() 'eachParam'
			if alias.paramCapabilityAt(position) == ParamCapability.isolated and not alias.paramMarkedAt(position) 'anOwnedRegion'
				mask = maskWithParam(mask, param: position as ParamCount)
			end 'anOwnedRegion'
		end 'eachParam'

		return mask
	end 'aliasIsolatedMask'

	function writtenMarkersOf(site ByteArray) returns ParamPositionMask
		let info = try self.settledDeclarations().funcParamReassigns.get(site) otherwise return NoParamPositions
		return info.writtenParams
	end 'writtenMarkersOf'

	function noteForwarder(forwarders ForwarderArray, siteIndex ForwarderSiteMap, forwarder Forwarder)
		if forwarder.info.forwardedStores.count() == 0 'forwardsNothing'
			return
		end 'forwardsNothing'

		siteIndex.upsert(forwarder.decl.site, value: forwarders.count() as ElementIndex)
		forwarders.push(forwarder)
	end 'noteForwarder'

	function noteNarrowedForwarder(narrowed ForwarderArray, forwarders ForwarderArray, siteIndex ForwarderSiteMap, forwarder Forwarder)
		narrowed.push(forwarder)
		self.noteForwarder(forwarders, siteIndex: siteIndex, forwarder: forwarder)
	end 'noteNarrowedForwarder'

	function propagateForwardedStores(forwarders ForwarderArray, siteIndex ForwarderSiteMap)
		let members = self.instanceMethodsByMemberName() if self.anyStoreResolvesByMemberName(forwarders) else DeclarationsByMemberName.create()
		let handed = ParamBitColumnArray.create(forwarders.count(), zeroed: false)
		let targets = StoreTargetColumnArray.create(forwarders.count(), zeroed: false)
		let waiters = FreshReturnWaiterMap.create()
		let ready = FreshReturnForwarderIndexArray.create(0)

		for index in 0 upto forwarders.count() 'eachForwarder'
			let forwarder = try forwarders.get(index) otherwise panic("propagateForwardedStores: forwarders.get OOB at {index}")
			let column = HandedOnColumn.startingFrom(forwarder.info.handedOn)
			let mine = StoreTargetArray.create(0)

			for store in forwarder.info.forwardedStores 'eachStore'
				if self.forwardedStoreIsTakenOutright(store, forwarder: forwarder) 'outright'
					column.set(store.paramIndex)
					continue
				end 'outright'

				for candidate in self.forwardedStoreCandidates(store, forwarder: forwarder, members: members) 'eachCandidate'
					mine.push(StoreTarget.create(store, callee: candidate.decl.site, receiverOffset: candidate.receiverOffset))

					if siteIndex.contains(candidate.decl.site) 'aForwarderItself'
						if var waiting = try waiters.get(candidate.decl.site) 'anotherWaiter'
							waiting.push(index as ElementIndex)
						end 'anotherWaiter' else 'firstWaiter'
							let first = FreshReturnForwarderIndexArray.create(0)
							first.push(index as ElementIndex)
							waiters.upsert(candidate.decl.site, value: first)
						end 'firstWaiter'
					end 'aForwarderItself'
				end 'eachCandidate'
			end 'eachStore'

			handed.push(column)
			targets.push(mine)
			ready.push(index as ElementIndex)
		end 'eachForwarder'

		while ready.count() > 0 'propagating'
			let node = try ready.pop() otherwise panic("propagateForwardedStores: pop from a non-empty worklist")

			if not self.forwarderLearnedSomething(node, forwarders: forwarders, handed: handed, targets: targets, siteIndex: siteIndex) 'nothingNew'
				continue
			end 'nothingNew'

			let site = (try forwarders.get(node) otherwise panic("propagateForwardedStores: forwarders.get OOB at {node}")).decl.site

			if let waiting = try waiters.get(site) 'someoneWaits'
				for waiter in waiting 'eachWaiter'
					ready.push(waiter)
				end 'eachWaiter'
			end 'someoneWaits'
		end 'propagating'

		for index in 0 upto forwarders.count() 'eachResult'
			let forwarder = try forwarders.get(index) otherwise panic("propagateForwardedStores: forwarders.get OOB at {index}")
			let column = try handed.get(index) otherwise panic("propagateForwardedStores: handed.get OOB at {index}")
			self.publishForwardedInfo(forwarder, info: forwarder.info.withHandedOn(column.frozen()))
		end 'eachResult'
	end 'propagateForwardedStores'

	function publishForwardedInfo(forwarder Forwarder, info ParamConsumeInfo)
		self.mainThreadSettled().declParamConsumes.upsert(forwarder.decl.site, value: info)

		self.mainThreadSettled().funcParamConsumes.upsert(forwarder.key, value: info)
	end 'publishForwardedInfo'

	function forwarderLearnedSomething(node ElementIndex, forwarders ForwarderArray, handed ParamBitColumnArray, targets StoreTargetColumnArray, siteIndex ForwarderSiteMap) returns bool
		var learned = false
		let column = try handed.get(node) otherwise panic("forwarderLearnedSomething: handed.get OOB at {node}")

		for target in try targets.get(node) otherwise panic("forwarderLearnedSomething: targets.get OOB at {node}") 'eachTarget'
			if column.has(target.store.paramIndex) or not self.forwardedTargetTakes(target, forwarders: forwarders, handed: handed, siteIndex: siteIndex) 'nothingToLearn'
				continue
			end 'nothingToLearn'

			column.set(target.store.paramIndex)
			learned = true
		end 'eachTarget'

		return learned
	end 'forwarderLearnedSomething'

	function forwardedTargetTakes(target StoreTarget, forwarders ForwarderArray, handed ParamBitColumnArray, siteIndex ForwarderSiteMap) returns bool
		let column = target.store.column + target.receiverOffset

		if let calleeNode = try siteIndex.get(target.callee) 'aForwarderBeingClosed'
			let callee = try forwarders.get(calleeNode) otherwise panic("forwardedTargetTakes: forwarders.get OOB at {calleeNode}")
			let position = try argSlotPosition(callee.info.paramNames, argIndex: column, label: target.store.label) otherwise return false
			let calleeColumn = try handed.get(calleeNode) otherwise panic("forwardedTargetTakes: handed.get OOB at {calleeNode}")

			return callee.info.takesPromiseAt(position) or calleeColumn.has(position)
		end 'aForwarderBeingClosed'

		return match self.consumeOfDeclaration(target.callee) 'consume'
			borrowsAll gives false
			consumes(info) gives forwardedStoreIsTakenBy(info, column: column, label: target.store.label)
		end 'consume'
	end 'forwardedTargetTakes'

	function forwardedStoreIsTakenOutright(store ForwardedStore, forwarder Forwarder) returns bool
		return match store.shape 'shape'
			qualified gives store.typeName.count() > 0 and self.namesAUnionCase(store.typeName, caseName: store.memberName)
			throughParameter gives self.parameterTypeTakesPromiseAt(store, forwarder: forwarder)
			outright gives true
			bare or
			throughSelf or
			throughSelfType or
			throughReceiver gives false
		end 'shape'
	end 'forwardedStoreIsTakenOutright'

	function parameterTypeTakesPromiseAt(store ForwardedStore, forwarder Forwarder) returns bool
		let declared = try self.declaredTypeAtCallPosition(forwarder.decl, position: store.calleeParam) otherwise return false
		let aliasName = try self.typeNames.nameOf(typeNameIdOf(declared)) otherwise return false

		return match self.functionAliasFrom(aliasName, readerFilePath: forwarder.decl.declFilePath) 'alias'
			declared(alias) gives self.aliasParamIsAPromise(alias, column: store.column)
			undeclared gives false
		end 'alias'
	end 'parameterTypeTakesPromiseAt'

	function aliasParamIsAPromise(alias FunctionTypeAlias, column ParamCount) returns bool
		let param = try alias.paramTypes.get(column as ElementIndex) otherwise return false
		return self.typeIsAGreenThreadHandle(maxonTypeOfStoredAliasParam(param, typeNames: self.typeNames), from: self.typeNames)
	end 'aliasParamIsAPromise'

	function forwardedStoreCandidates(store ForwardedStore, forwarder Forwarder, members DeclarationsByMemberName) returns StoreCandidateArray
		let found = StoreCandidateArray.create(0)

		match store.shape 'shape'
			bare then self.noteVisibleCandidate(found, key: self.nameABareCallBinds(store.memberName, readerFilePath: forwarder.decl.declFilePath), readerFilePath: forwarder.decl.declFilePath, instanceMethods: false)
			throughSelf then self.noteDeclaredCandidate(found, key: qualifiedMethodName(store.typeName, methodName: store.memberName), instanceMethods: true)
			throughSelfType then self.noteDeclaredCandidate(found, key: qualifiedMethodName(store.typeName, methodName: store.memberName), instanceMethods: false)
			qualified then self.noteQualifiedCandidates(found, store: store, members: members)
			throughReceiver then self.noteCandidates(found, from: try members.get(store.memberName) otherwise SweptDeclarationArray.create(0), instanceMethods: true)
			throughParameter or
			outright then break
		end 'shape'

		return found
	end 'forwardedStoreCandidates'

	function noteQualifiedCandidates(found StoreCandidateArray, store ForwardedStore, members DeclarationsByMemberName)
		self.noteDeclaredCandidate(found, key: qualifiedMethodName(self.aliasBaseTypeName(store.typeName), methodName: store.memberName), instanceMethods: false)

		if found.count() == 0 and self.isContestedFreeFunction(store.memberName) 'aDirectoryQualifiedContestedFunction'
			match self.resolveQualifiedFunctionName(joinQualifiedName(store.typeName, member: store.memberName), bare: store.memberName) 'directoryFunction'
				declaration(name) then self.noteDeclaredCandidate(found, key: name, instanceMethods: false)
				ambiguous or
				undeclared then break
			end 'directoryFunction'
		end 'aDirectoryQualifiedContestedFunction'

		if found.count() == 0 'nameIsNotATypeWithThatMember'
			self.noteCandidates(found, from: try members.get(store.memberName) otherwise SweptDeclarationArray.create(0), instanceMethods: true)
		end 'nameIsNotATypeWithThatMember'
	end 'noteQualifiedCandidates'

	function noteCandidates(found StoreCandidateArray, from SweptDeclarationArray, instanceMethods bool)
		for declaration in from 'eachDeclaration'
			self.noteCandidate(found, declaration: declaration, instanceMethods: instanceMethods)
		end 'eachDeclaration'
	end 'noteCandidates'

	function noteDeclaredCandidate(found StoreCandidateArray, key ByteArray, instanceMethods bool)
		if let declaration = try self.sweptDeclarationOf(key) 'declared'
			self.noteCandidate(found, declaration: declaration, instanceMethods: instanceMethods)
		end 'declared'
	end 'noteDeclaredCandidate'

	function noteVisibleCandidate(found StoreCandidateArray, key ByteArray, readerFilePath FilePath, instanceMethods bool)
		if let declaration = try self.visibleDeclarationOf(key, readerFilePath: readerFilePath) 'visible'
			self.noteCandidate(found, declaration: declaration, instanceMethods: instanceMethods)
		end 'visible'
	end 'noteVisibleCandidate'

	function noteCandidate(found StoreCandidateArray, declaration SweptDeclaration, instanceMethods bool)
		if declaration.takesReceiver == instanceMethods 'theCallShapeFits'
			found.push(StoreCandidate.create(declaration, receiverOffset: 1 if instanceMethods else 0))
		end 'theCallShapeFits'
	end 'noteCandidate'

	function aliasBaseTypeName(name immutable ByteArray) returns immutable ByteArray
		let instance = try self.liveGenericAliasInstance(name) otherwise return name
		return self.genericInstanceBaseName(instance)
	end 'aliasBaseTypeName'

	function instanceMethodsByMemberName() returns DeclarationsByMemberName
		let members = DeclarationsByMemberName.create()

		for (key, declaration) in self.settledDeclarations().sweptDeclarations 'eachKey'
			if not declaration.takesReceiver 'notAMethod'
				continue
			end 'notAMethod'

			let member = unqualifiedMemberOf(key)

			if var named = try members.get(member) 'anotherOfItsName'
				named.push(declaration)
			end 'anotherOfItsName' else 'firstOfItsName'
				let first = SweptDeclarationArray.create(0)
				first.push(declaration)
				members.upsert(member, value: first)
			end 'firstOfItsName'
		end 'eachKey'

		return members
	end 'instanceMethodsByMemberName'

	function promiseFactsThatCanCarry(info ParamConsumeInfo, declaration SweptDeclaration, memo PromiseTypeAnswerMap) returns PromiseFactVerdict
		var kept = false
		var dropped = false

		for position in 0 upto info.paramNames.count() 'eachHandedOn'
			if not info.isHandedOn(position as ParamCount) 'notHandedOn'
				continue
			end 'notHandedOn'

			if self.parameterMayCarryAPromise(declaration, position: position as ParamCount, memo: memo) 'aCarrier'
				kept = true
			end 'aCarrier' else 'aValue'
				dropped = true
			end 'aValue'
		end 'eachHandedOn'

		for store in info.forwardedStores 'eachStore'
			if self.parameterMayCarryAPromise(declaration, position: store.paramIndex, memo: memo) 'aCarrier'
				kept = true
			end 'aCarrier' else 'aValue'
				dropped = true
			end 'aValue'
		end 'eachStore'

		if not kept 'nothingPromiseShapedRemains'
			let ownershipOnly = self.withOnlyPromiseCarriers(info, declaration: declaration, memo: memo)
			return PromiseFactVerdict.none if ownershipOnly.isEmpty() else PromiseFactVerdict.narrower(ownershipOnly)
		end 'nothingPromiseShapedRemains'

		if not dropped 'everythingStays'
			return PromiseFactVerdict.unchanged
		end 'everythingStays'

		return PromiseFactVerdict.narrower(self.withOnlyPromiseCarriers(info, declaration: declaration, memo: memo))
	end 'promiseFactsThatCanCarry'

	function withOnlyPromiseCarriers(info ParamConsumeInfo, declaration SweptDeclaration, memo PromiseTypeAnswerMap) returns ParamConsumeInfo
		let carried = BoolArray.create(0) as isolated BoolArray
		let stores = ForwardedStoreArray.create(0) as isolated ForwardedStoreArray

		for position in 0 upto info.paramNames.count() 'eachPosition'
			if info.isHandedOn(position as ParamCount) and self.parameterMayCarryAPromise(declaration, position: position as ParamCount, memo: memo) 'aCarrierIsHandedOn'
				setParamBit(carried, index: position as ParamCount)
			end 'aCarrierIsHandedOn'
		end 'eachPosition'

		for store in info.forwardedStores 'eachStore'
			if self.parameterMayCarryAPromise(declaration, position: store.paramIndex, memo: memo) 'aCarrierForwards'
				stores.push(store)
			end 'aCarrierForwards'
		end 'eachStore'

		return info.withPromiseFacts(freeze carried, stores: freeze stores)
	end 'withOnlyPromiseCarriers'

	function declaredTypeAtCallPosition(declaration SweptDeclaration, position ParamCount) returns MaxonType throws AbsentError
		let column = try columnOfCallPosition(declaration.takesReceiver, position: position)
		return try declaration.paramTypes.get(column) otherwise panic("declaredTypeAtCallPosition: paramTypes.get OOB at {column} — call position {position} is past the {declaration.paramTypes.count()} declared parameters")
	end 'declaredTypeAtCallPosition'

	function parameterMayCarryAPromise(declaration SweptDeclaration, position ParamCount, memo PromiseTypeAnswerMap) returns bool
		let declared = try self.declaredTypeAtCallPosition(declaration, position: position) otherwise return false

		if not declaredTypeMayCarryAPromise(declared) 'noPromiseTypeLooksLikeThis'
			return false
		end 'noPromiseTypeLooksLikeThis'

		if maxonTypeTag(declared) == ValueTypeTag.typeParameter 'anOpaqueValue'
			return true
		end 'anOpaqueValue'

		return self.declaredTypeIsAPromise(declared, memo: memo)
	end 'parameterMayCarryAPromise'

	function declaredTypeIsAPromise(declared MaxonType, memo PromiseTypeAnswerMap) returns bool
		if maxonTypeTag(declared) != ValueTypeTag.named 'resolvedWithoutAName'
			return self.typeIsAGreenThreadHandle(declared, from: self.typeNames)
		end 'resolvedWithoutAName'

		let id = typeNameIdOf(declared)

		if let known = try memo.get(id) 'alreadyAsked'
			return known
		end 'alreadyAsked'

		let answer = self.typeIsAGreenThreadHandle(declared, from: self.typeNames)
		memo.upsert(id, value: answer)
		return answer
	end 'declaredTypeIsAPromise'

	function anyStoreResolvesByMemberName(forwarders ForwarderArray) returns bool
		for forwarder in forwarders 'eachForwarder'
			for store in forwarder.info.forwardedStores 'eachStore'
				if store.shape == ForwardShape.throughReceiver or store.shape == ForwardShape.qualified 'resolvesThroughMembers'
					return true
				end 'resolvesThroughMembers'
			end 'eachStore'
		end 'eachForwarder'

		return false
	end 'anyStoreResolvesByMemberName'

	function namesAUnionCase(typeName ByteArray, caseName ByteArray) returns bool
		match self.enumInAnyFile(typeName) 'declared'
			declared(layout) then return layout.isUnion and layout.hasCase(caseName)
			undeclared then return false
		end 'declared'
	end 'namesAUnionCase'

	// Add one function's by-reference columns to the index AND fold them into the hash — the one write, for
	// `recordParamConsume`'s reason, and here that reason is at its strongest: this table decides an ABI, so a
	// table and a memo key that disagreed would compile a caller against a signature the callee no longer has.
	//
	// A function that declares no `mutable` parameter is not recorded, so the common function costs no map
	// entry and no hash movement.
	function recordParamReassign(name ByteArray, site ByteArray, info ParamReassignInfo)
		self.mainThreadSettled().funcParamReassigns.upsert(site, value: info)
		noteDeclarationSiteOfKey(self.mainThreadSettled().byRefSitesOfKey, name: name, site: site)

		var state = mixBytes(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeParamByRef), bytes: name), bytes: site)

		for i in 0 upto info.paramNames.count() 'eachName'
			let paramName = try info.paramNames.get(i) otherwise panic("recordParamReassign: paramNames.get OOB at {i} despite i < count")
			state = mixBytes(state, bytes: paramName)
			state = Hasher.combined(state, value: SignatureDiscriminator.byRefBitSet if info.isByRef(i as ParamCount) else SignatureDiscriminator.byRefBitClear)
		end 'eachName'

		state = mixBytes(state, bytes: info.bareName)
		state = foldCallability(state, callability: info.callability)
		self.hash = state
		self.noteNamesAClosureReaches(info.bareName, calls: ForwardCallArray.create(0), authorStatesIt: true)
	end 'recordParamReassign'

	function noteNamesAClosureReaches(bareName ByteArray, calls ForwardCallArray, authorStatesIt bool)
		self.noteMentionedName(bareName)

		if authorStatesIt 'anAuthorsSeed'
			self.noteDeclaredName(bareName)
		end 'anAuthorsSeed'

		for call in calls 'eachSpelling'
			self.noteMentionedName(forwardCallName(call))
		end 'eachSpelling'
	end 'noteNamesAClosureReaches'

	// Add one function's immutable-global-return raw material to the index AND fold it into the hash — the one
	// write, for `recordParamReassign`'s reason. A function that states nothing is not recorded, so the common
	// function costs no map entry and no hash movement. The GATE is raised here, off the returned-NAME column
	// alone, because only a name can seed the closure.
	function recordGlobalAliasReturn(name ByteArray, info GlobalAliasReturnInfo)
		self.mainThreadSettled().funcGlobalAliasReturns.upsert(name, value: info)
		self.sawGlobalNameReturn = self.sawGlobalNameReturn or info.returnedNames.count() > 0

		// The declaring FILE is NOT folded here — `foldFile` folds it once for the whole file, because that is
		// the granularity the fact has. See there.
		var state = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeGlobalAliasReturn), bytes: name)

		for returned in info.returnedNames 'eachName'
			state = mixBytes(state, bytes: returned)
		end 'eachName'

		state = mixBytes(state, bytes: info.bareName)
		state = foldCallability(state, callability: info.callability)

		for call in info.returnCalls 'eachEdge'
			// The SHAPE rides with the name: the three call shapes reach different nodes, so two bodies
			// differing only in a receiver state different things and must not hash alike.
			state = mixBytes(state, bytes: forwardCallName(call))
			state = mixBytes(Hasher.combined(state, value: forwardCallShapeMark(call)), bytes: forwardCallSelfType(call))
		end 'eachEdge'

		self.hash = state
		self.noteNamesAClosureReaches(info.bareName, calls: info.returnCalls, authorStatesIt: true)
	end 'recordGlobalAliasReturn'

	// ⭐⭐ **MAY A CALL TO `callee` HAND BACK A `let`-DECLARED GLOBAL'S OWN RECORD?** — the ONE door the
	// parser asks, at a call site, to decide whether the result must carry the immutable-global mark. A key
	// with no entry answers false, which is every function in every program that returns no global.
	export function returnsImmutableGlobalAlias(callee ByteArray) returns bool
		self.closeGlobalAliasReturns()
		return self.settledDeclarations().globalAliasReturnKeys.contains(callee)
	end 'returnsImmutableGlobalAlias'

	// ⭐ **DOES ANY FUNCTION IN THE PROGRAM RETURN ONE?** The whole-program skip, asked before a call site
	// spends a hash on the question above — `programTakesAParamByRef`'s twin, and true of very few programs.
	export function programReturnsAnImmutableGlobalAlias() returns bool
		self.closeGlobalAliasReturns()
		return self.settledDeclarations().globalAliasReturnKeys.count() != 0
	end 'programReturnsAnImmutableGlobalAlias'

	// ⭐⭐ **CLOSE THE IMMUTABLE-GLOBAL-RETURN RELATION — the fixpoint that turns `get()` returning what
	// `inner()` returns into "`get()` may hand back a `let` global too", transitively.**
	//
	// It runs once, at the first read, as a single reverse reachability pass over the `DeclNodeSpace` and
	// edge shapes below rather than as round-based rescanning.
	//
	// ⭐ **THE SEED CANNOT BE DECIDED BY THE SWEEP, AND THAT IS WHY THE RAW NAMES ARE CARRIED.** "Is `A` an
	// immutable stored global?" needs every file's declarations folded and every initializer evaluated, and
	// the sweep runs while files are still arriving. Here, both are done.
	//
	// ⚠ **A SCALAR `let` IS NOT A SEED, AND THAT FALLS OUT RATHER THAN BEING EXCLUDED**: the seed test asks
	// whether the name denotes a RECORD, and an inlined scalar constant has none to alias in the first place
	// — the whole rule is about a record two names can reach.
	function closeGlobalAliasReturns()
		if self.globalAliasReturnsClosed 'alreadySettled'
			return
		end 'alreadySettled'

		self.globalAliasReturnsClosed = true

		// ⚡ **NO SEED, NO GRAPH.** A body is recorded merely for returning a CALL, so the map is non-empty on
		// most programs; what decides whether anything can be marked is whether some body returns a NAME at all.
		if not self.sawGlobalNameReturn 'noReturnedNameCanSeedIt'
			return
		end 'noReturnedNameCanSeedIt'

		self.publishGlobalAliasReturnKeys()
	end 'closeGlobalAliasReturns'

	function publishGlobalAliasReturnKeys()
		// ⚡⚡ **AND THE SAME GATE ASKED EXACTLY, WHICH THE ONE ABOVE CANNOT BE.** `sawGlobalNameReturn` is
		// raised at the SWEEP, where no name can be resolved, so it says only *"some body returned a bare
		// name"* — true of nearly every program, because `return EmptySourceText` and `return SomeConstant`
		// are ordinary. Here every declaration is folded and every initializer evaluated, so the real
		// question — does any of those names DENOTE a `let`-declared stored global? — has an answer, and a
		// `false` means reachability would run from an empty seed set and mark nothing. Skipping it skips
		// the node space, both edge columns, the CSR build and the BFS — a cost billed to `phase:parse`,
		// because this closure is asked lazily and its FIRST asker is `Parser.beginFunction`.
		if not self.anyRecordedReturnNamesAGlobal() 'noSeedResolvesToOne'
			return
		end 'noSeedResolvesToOne'

		let nodes = DeclNodeSpace.create()

		for (_, info) in self.settledDeclarations().funcGlobalAliasReturns 'eachRecorded'
			let node = nodes.nodeFor(info.bareName, callability: info.callability)

			if self.returnsAGlobalDirectly(info) 'namesOneItself'
				try nodes.seeds.set(node, value: true) otherwise panic("closeGlobalAliasReturns: seeds.set OOB at {node} despite the node having just been interned")
			end 'namesOneItself'
		end 'eachRecorded'

		// The return-forwarding edges, REVERSED — a forward `caller -> callee` is recorded as `callee -> caller`,
		// so a seed's row lists the declarations that return INTO it and the mark propagates back up the chain.
		let edgeCallee = CsrColumn.create(0)
		let edgeForwarder = CsrColumn.create(0)

		for (_, info) in self.settledDeclarations().funcGlobalAliasReturns 'eachForwarder'
			let forwarder = nodes.nodeFor(info.bareName, callability: info.callability)

			for call in info.returnCalls 'eachEdge'
				for callee in nodes.targetsOf(call) 'eachTargetItCanName'
					edgeCallee.push(callee)
					edgeForwarder.push(forwarder)
				end 'eachTargetItCanName'
			end 'eachEdge'
		end 'eachForwarder'

		let mayAlias = reverseReachabilityMark(buildCsr(edgeCallee, to: edgeForwarder, nodeCount: nodes.bareNames.count() as CsrIndex), seeds: nodes.seeds)

		// ⭐ Published per REGISTRATION KEY and not per node: the parser asks under the key it resolved a
		// call to, and two keys may share a node.
		for (name, info) in self.settledDeclarations().funcGlobalAliasReturns 'publishKeys'
			let marked = try mayAlias.get(nodes.nodeFor(info.bareName, callability: info.callability)) otherwise panic("closeGlobalAliasReturns: mayAlias.get OOB for a node interned before the graph was built")

			if marked 'marked'
				self.mainThreadSettled().globalAliasReturnKeys.insert(name)
			end 'marked'
		end 'publishKeys'
	end 'publishGlobalAliasReturnKeys'

	// ⚡ **IS THERE A SEED AT ALL?** — the closure's exact precondition, over the SAME per-declaration test the
	// seed loop uses, so the two cannot come to disagree about what a seed is. It walks and resolves nothing
	// the seed loop would not have resolved anyway; what it buys is the right to stop before the graph exists.
	function anyRecordedReturnNamesAGlobal() returns bool
		for (_, info) in self.settledDeclarations().funcGlobalAliasReturns 'eachRecorded'
			if self.returnsAGlobalDirectly(info) 'namesOneItself'
				return true
			end 'namesOneItself'
		end 'eachRecorded'

		return false
	end 'anyRecordedReturnNamesAGlobal'

	// Does this body return a name that DENOTES an immutable stored global, read from its own file? The
	// closure's seed test, asked once per recorded declaration.
	function returnsAGlobalDirectly(info GlobalAliasReturnInfo) returns bool
		for returned in info.returnedNames 'eachName'
			if self.namesImmutableRecordGlobal(returned, readerFilePath: info.declFilePath) 'namesAGlobal'
				return true
			end 'namesAGlobal'
		end 'eachName'

		return false
	end 'returnsAGlobalDirectly'

	// ⭐ **DOES `name`, READ FROM `readerFilePath`, DENOTE A `let`-DECLARED TOP-LEVEL BINDING WITH A RECORD?**
	// The one place the halves of that question are joined — the SAME scoped-then-bare probe every other
	// reader of a top-level name goes through (`declFor`).
	//
	// ⚠ **IT ASKS ABOUT THE RECORD AND THEREFORE ABOUT BOTH STORAGE MODELS.** The rule rests on two
	// names being able to reach ONE record, and an IMAGED `let` shares one exactly as a stored one
	// does — its reads are one `.rdata` address — so the imaging of a binding may not decide whether
	// the rule sees it. A scalar or managed `let` has no record to alias at all and answers false
	// either way.
	export function namesImmutableRecordGlobal(name ByteArray, readerFilePath FilePath) returns bool
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.stored) 'stored'
			found(index) then return not declIsAPayloadFreeUnionCase(self.declAt(index))
			notFound then break
		end 'stored'

		return match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.inlined) 'imaged'
			found(index) gives declHoldsAnImageRecord(self.declAt(index)) and not declIsAPayloadFreeUnionCase(self.declAt(index))
			notFound gives false
		end 'imaged'
	end 'namesImmutableRecordGlobal'

	// ⭐⭐ **IS `callee`'s PARAMETER AT `index` PASSED BY REFERENCE, UNDER ANY DECLARATION OF IT?** A
	// callee with no recorded entry, or an index past its recorded columns, is BY VALUE: the safe
	// default, and what makes recording only the stating functions correct.
	export function paramIsByRef(callee ByteArray, index ParamCount) returns bool
		return self.byRefOf(callee).paramIsByRef(index)
	end 'paramIsByRef'

	export function noteMutableMarkerDeclared()
		self.mainThreadSettled().noteMutableMarker()
	end 'noteMutableMarkerDeclared'

	export function noteMutableFunctionValueDeclared()
		self.mainThreadSettled().noteMutableFunctionValue()
	end 'noteMutableFunctionValueDeclared'

	export function programHasMutableFunctionValues() returns bool
		return self.settledDeclarations().sawMutableFunctionValue
	end 'programHasMutableFunctionValues'

	export function aFreeFunctionTakesByRefAt(arity ParamCount, position ParamCount) returns bool
		self.publishByRefNames()

		return maskHasParam(try self.settledDeclarations().freeFunctionByRefPositions.get(arity) otherwise NoParamPositions, param: position)
	end 'aFreeFunctionTakesByRefAt'

	function publishByRefNames()
		if self.byRefNamesPublished 'alreadySettled'
			return
		end 'alreadySettled'

		self.byRefNamesPublished = true

		for (name, sites) in self.settledDeclarations().byRefSitesOfKey 'publishNames'
			for site in sites 'eachDeclaration'
				let info = try self.settledDeclarations().funcParamReassigns.get(site) otherwise panic("publishByRefNames: '{String.from(name)}' lists the declaration at '{String.from(site)}', and `recordParamReassign` files that declaration's facts in the same act")

				if info.mutableParams != NoParamPositions 'takesSomethingByRef'
					self.mainThreadSettled().byRefBareNames.insert(info.bareName)
				end 'takesSomethingByRef'

				if self.takesATypeParameterByRef(name, info: info) 'anOpaqueParameterByReference'
					self.mainThreadSettled().opaqueByRefBareNames.insert(info.bareName)
				end 'anOpaqueParameterByReference'

				if info.isAFreeFunction() 'aFreeFunction'
					let arity = info.paramNames.count() as ParamCount
					self.mainThreadSettled().freeFunctionByRefPositions.upsert(arity, value: (try self.settledDeclarations().freeFunctionByRefPositions.get(arity) otherwise NoParamPositions) or info.mutableParams)
				end 'aFreeFunction'
			end 'eachDeclaration'
		end 'publishNames'
	end 'publishByRefNames'

	function computedWitnessByRefMasks(corpusOnly bool) returns WitnessByRefMaskMap
		let masks = WitnessByRefMaskMap.create()

		for interfaceName in self.settledDeclarations().interfaceNamesInDeclOrder 'eachInterface'
			match lookupInterface(self.settledDeclarations().interfaces, name: interfaceName) 'declared'
				found(iface) then self.noteWitnessMasksOf(iface, corpusOnly: corpusOnly, into: masks)
				notFound then continue
			end 'declared'
		end 'eachInterface'

		return masks
	end 'computedWitnessByRefMasks'

	function noteWitnessMasksOf(iface IrInterface, corpusOnly bool, into WitnessByRefMaskMap)
		if corpusOnly and not self.declaredByTheSharedCorpusAt(iface.declFilePath.toString()) 'anAuthorsInterface'
			return
		end 'anAuthorsInterface'

		noteRequirementByRefMasks(iface, signatures: self, into: into)
	end 'noteWitnessMasksOf'

	export function witnessRequirementByRefMask(interfaceName ByteArray, methodName ByteArray) returns ParamPositionMask
		self.requireByRefMasksSettled()
		return try self.witnessMaskTable().get(witnessRequirementKey(interfaceName, methodName: methodName)) otherwise NoParamPositions
	end 'witnessRequirementByRefMask'

	export function witnessRequirementConvention(interfaceName ByteArray, methodName ByteArray, paramNames NameRoster) returns ByRefConvention
		let mask = self.witnessRequirementByRefMask(interfaceName, methodName: methodName)

		if mask == NoParamPositions 'noFormalIsMutable'
			return ByRefConvention.allByValue()
		end 'noFormalIsMutable'

		var formals = NoParamPositions

		for formal in 0 upto paramNames.count() 'eachFormal'
			if maskHasParam(mask, param: (formal + WitnessReceiverArgCount) as ParamCount) 'aMutableFormal'
				formals = maskWithParam(formals, param: formal as ParamCount)
			end 'aMutableFormal'
		end 'eachFormal'

		let declarations = ByRefDeclarationArray.create(1, zeroed: false)
		declarations.push(ByRefDeclaration.create(ParamReassignInfo.create(paramNames, writtenParams: formals, markerHeads: NameRoster.create(0), bareName: methodName, callability: DeclCallability.methodOf(interfaceName))))
		return ByRefConvention.of(declarations)
	end 'witnessRequirementConvention'

	function takesATypeParameterByRef(name ByteArray, info ParamReassignInfo) returns bool
		let positions = self.opaqueParamsOf(name).positions

		for index in 0 upto info.paramNames.count() 'eachParam'
			if positions.namesATypeParameter(index as ParamCount) and info.isByRef(index as ParamCount) 'aTypeParameterByReference'
				return true
			end 'aTypeParameterByReference'
		end 'eachParam'

		return false
	end 'takesATypeParameterByRef'

	export function bareNameTakesATypeParameterByRef(bareName ByteArray) returns bool
		self.publishByRefNames()
		return self.settledDeclarations().opaqueByRefBareNames.contains(bareName)
	end 'bareNameTakesATypeParameterByRef'

	export function calleeTakesATypeParameterByRefAt(callee ByteArray, argIndex ElementIndex, label ByteArray) returns bool
		let positions = self.opaqueParamsOf(callee)

		if not positions.declaresATypeParameterParam() 'noTypeParameterParam'
			return false
		end 'noTypeParameterParam'

		let aligned = ((argIndex + 1) if positions.paramNames.count() > 0 and (try positions.paramNames.get(0) otherwise panic("calleeTakesATypeParameterByRefAt: paramNames.get(0) on a list whose count was just read as non-zero")).equals(SelfParamName) else argIndex) as ParamCount
		let slot = try argSlotPosition(positions.paramNames, argIndex: aligned, label: label) otherwise return false
		return positions.positions.namesATypeParameter(slot) and self.byRefOf(callee).takesArgumentByRef(aligned, label: label)
	end 'calleeTakesATypeParameterByRefAt'

	export function calleeStatesByRefFacts(callee ByteArray) returns bool
		return self.byRefOf(callee).statesAnything()
	end 'calleeStatesByRefFacts'

	export function byRefOf(callee ByteArray) returns ByRefConvention
		if let instance = try self.settledDeclarations().genericInstancesByName.get(callee) 'aFiledInstance'
			return self.byRefOfDeclaration(instance.siteKey)
		end 'aFiledInstance'

		if self.declaresGenericFunctions() and bytesContainRun(callee, run: self.settledDeclarations().genericInstanceNameMarker) 'anInstanceNothingFiled'
			panic("ProgramSignatures.byRefOf: '{String.from(callee)}' names a generic function instance that no parse filed — its template's by-reference facts cannot be reached, and answering 'all by value' would pass a value where the instance's body reads a cell")
		end 'anInstanceNothingFiled'

		let sites = try self.settledDeclarations().byRefSitesOfKey.get(callee) otherwise return ByRefConvention.allByValue()
		let declarations = ByRefDeclarationArray.create(sites.count(), zeroed: false)

		for site in sites 'eachDeclaration'
			self.appendByRefDeclarationAt(site, into: declarations)
		end 'eachDeclaration'

		return ByRefConvention.of(declarations)
	end 'byRefOf'

	export function consumeOfDeclaration(site ByteArray) returns CalleeConsume
		let info = try self.settledDeclarations().declParamConsumes.get(site) otherwise return CalleeConsume.borrowsAll
		return CalleeConsume.consumes(info)
	end 'consumeOfDeclaration'

	export function byRefOfDeclaration(site ByteArray) returns ByRefConvention
		if not self.settledDeclarations().funcParamReassigns.contains(site) 'statesNothing'
			return ByRefConvention.allByValue()
		end 'statesNothing'

		let declarations = ByRefDeclarationArray.create(1, zeroed: false)
		self.appendByRefDeclarationAt(site, into: declarations)
		return ByRefConvention.of(declarations)
	end 'byRefOfDeclaration'

	function appendByRefDeclarationAt(site ByteArray, into ByRefDeclarationArray)
		let info = try self.settledDeclarations().funcParamReassigns.get(site) otherwise panic("appendByRefDeclarationAt: no facts are filed at '{String.from(site)}' — a site is listed under a key only by `recordParamReassign`, which files its facts in the same act")
		into.push(ByRefDeclaration.create(info))
	end 'appendByRefDeclarationAt'

	function settleMarkerReferences()
		let settled = ParamReassignMap.create()

		for (site, info) in self.settledDeclarations().funcParamReassigns 'eachDeclaration'
			let declaringFile = declaringFileOfSite(site)
			let referenced = self.referencedMarkersOf(info, readerFilePath: try FilePath.from(declaringFile) otherwise panic("settleMarkerReferences: the declaring file '{declaringFile}' of a swept declaration is no valid path"))

			if referenced != info.mutableParams 'aMarkerMovedOffTheReference'
				settled.upsert(site, value: info.settledAs(referenced))
			end 'aMarkerMovedOffTheReference'
		end 'eachDeclaration'

		for (site, info) in settled 'eachSettled'
			self.mainThreadSettled().funcParamReassigns.upsert(site, value: info)
		end 'eachSettled'
	end 'settleMarkerReferences'

	function referencedMarkersOf(info ParamReassignInfo, readerFilePath FilePath) returns ParamPositionMask
		var referenced = info.writtenParams

		for position in 0 upto info.markerHeads.count() 'eachPosition'
			let head = try info.markerHeads.get(position) otherwise panic("referencedMarkersOf: markerHeads.get OOB at {position} below the {info.markerHeads.count()} heads")

			if not head.isEmpty() and not self.markedHeadTakesAReference(head, readerFilePath: readerFilePath) 'anAliasableRecord'
				referenced = maskWithoutParam(referenced, param: position as ParamCount)
			end 'anAliasableRecord'
		end 'eachPosition'

		return referenced
	end 'referencedMarkersOf'

	export function markedHeadTakesAReference(head ByteArray, readerFilePath FilePath) returns bool
		if head.equals(StringConformerName) or head.equals(CharacterConformerName) 'aTextValue'
			return true
		end 'aTextValue'

		if self.containsInterfaceFor(head, readerFilePath: readerFilePath) 'anExistential'
			return false
		end 'anExistential'

		if self.containsStructFor(head, readerFilePath: readerFilePath) 'aRecord'
			return self.typeNameHoldsAUnique(head)
		end 'aRecord'

		if self.isAliasOfFormFor(head, readerFilePath: readerFilePath, wanted: FormAliasKind.generic) 'aGenericAlias'
			return self.markedHeadTakesAReference(self.genericInstanceBaseName(self.genericAliasInstanceFrom(head, readerFilePath: readerFilePath)), readerFilePath: readerFilePath)
		end 'aGenericAlias'

		return true
	end 'markedHeadTakesAReference'

	export function markedGenericInstanceTakesAReference(id GenericInstanceId, readerFilePath FilePath) returns bool
		return self.markedHeadTakesAReference(self.genericInstanceBaseName(id), readerFilePath: readerFilePath)
	end 'markedGenericInstanceTakesAReference'

	export function aliasParamTakesAReference(param FunctionAliasParam, readerFilePath FilePath) returns bool
		match param.identity 'identity'
			typeParamToken then return true
			genericInstance(id) then return self.markedGenericInstanceTakesAReference(id, readerFilePath: readerFilePath)
			nameOnly then break
		end 'identity'

		if param.tag == ValueTypeTag.named or param.tag == ValueTypeTag.structRef or param.tag == ValueTypeTag.interfaceRef 'aNamedType'
			return self.markedHeadTakesAReference(param.typeName, readerFilePath: readerFilePath)
		end 'aNamedType'

		return true
	end 'aliasParamTakesAReference'

	export function aliasByRefMask(alias FunctionTypeAlias) returns ParamPositionMask
		var mask = NoParamPositions

		for (iter, param) in alias.paramTypes.withIterator() 'eachParam'
			if param.marked and markedParamTakesAReference(param.capability, headTakesAReference: self.aliasParamTakesAReference(param, readerFilePath: alias.declFilePath)) 'aReferenceParameter'
				mask = maskWithParam(mask, param: iter.index() as ParamCount)
			end 'aReferenceParameter'
		end 'eachParam'

		return mask
	end 'aliasByRefMask'

	export function requirementParamTakesAReference(requirement RequirementType, readerFilePath FilePath) returns bool
		return match requirement.identity 'identity'
			nominal(name) gives self.markedHeadTakesAReference(name, readerFilePath: readerFilePath)
			genericInstance(id) gives self.markedGenericInstanceTakesAReference(id, readerFilePath: readerFilePath)
			void or
			selfType or
			typeParameter or
			builtin gives true
		end 'identity'
	end 'requirementParamTakesAReference'

	// ⭐⭐ **DOES ANY FUNCTION SPELLED `bareName` TAKE A PARAMETER BY REFERENCE?** — the door the parser's
	// LOCAL-CELL prescan asks, and the reason it is a BARE-name question is that the prescan reads its callee
	// out of tokens (see `byRefBareNames`). Over-approximate by construction: every `reassign` in the program
	// answers for every other, so a `var` handed to an unrelated same-named callee gets a cell it does not
	// need. Sound — a cell is a legal home for any value — and confined to programs that declare a `mutable`
	// parameter.
	//
	// ⚠ **IT DOES NOT SPLIT ON THE CALL'S SHAPE, AND THAT IS DELIBERATE RATHER THAN AN OVERSIGHT.** The shape
	// split exists where an over-approximation becomes a false refusal (see `ForwardCall`); here the only
	// consequence is a heap cell a local did not need, which is the case the paragraph above already argues is
	// free. Narrowing it would buy an allocation and risk a MISSING cell, which is a wrong answer.
	export function bareNameTakesAParamByRef(bareName ByteArray) returns bool
		self.publishByRefNames()
		return self.settledDeclarations().byRefBareNames.contains(bareName)
	end 'bareNameTakesAParamByRef'

	export function bareNameIsAFunctionValuedFieldName(bareName ByteArray) returns bool
		self.requireByRefMasksSettled()
		return self.functionValuedFieldNameTable().contains(bareName)
	end 'bareNameIsAFunctionValuedFieldName'

	export function fieldTypeMayHoldAFunctionValue(declared MaxonType) returns bool
		let tag = maxonTypeTag(declared)
		return tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.unresolved or self.slotTypeIsAFunctionValue(declared)
	end 'fieldTypeMayHoldAFunctionValue'

	// ⭐⭐ **DOES THE PROGRAM MARK ANY PARAMETER `mutable`?** The whole-program skip, read by the parser
	// before it prescans a body for cell-resident locals: with nothing by-reference anywhere, no local can
	// ever need a cell for a call, and the prescan is not worth walking.
	export function programTakesAParamByRef() returns bool
		return self.settledDeclarations().sawMutableMarker
	end 'programTakesAParamByRef'

	// Record one function's per-parameter DEFAULTS AND fold them into the hash — the one write, for
	// `recordParamConsume`'s reason. A function with NO default is not recorded (its default answer is
	// "every parameter is required"), so the common function costs no map entry and no hash movement.
	function recordParamDefaults(name ByteArray, info ParamDefaultInfo)
		self.mainThreadSettled().funcParamDefaults.upsert(name, value: info)
		var state = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeParamDefault), bytes: name)

		// The param NAMES ride for `recordParamConsume`'s reason — a rename changes which labelled argument
		// slots to a defaulted position — and the per-position presence bit rides because it is what decides
		// whether a caller's short call is legal at all.
		//
		// ⚠ **THE DEFAULT'S EXPRESSION DELIBERATELY DOES NOT RIDE**, and that is docs/internals/query-spine.md's "mix what
		// a reader COPIES" rule, not an omission. A reader copies NOTHING out of the expression: it emits
		// `call __paramDefault#f#0`, byte-identical whether the default is `"World"` or `"Maxon"`, and the
		// expression reaches only the DECLARING file's own helper body — which re-parses on that file's own
		// content hash. What a reader does depend on is the helper's RETURN TYPE, and that rides already,
		// through the ordinary `FuncReturnTypeEntry` the same sweep publishes for it. Mixing the expression
		// would be sound and WRONG: every keystroke inside any default would re-parse the whole program,
		// which is the stored-binding payload mistake `mixDeclAnswer` avoids, one registry over.
		for i in 0 upto info.paramNames.count() 'eachName'
			let paramName = try info.paramNames.get(i) otherwise panic("recordParamDefaults: paramNames.get OOB at {i} despite i < count")
			state = Hasher.combined(mixBytes(state, bytes: paramName), value: defaultProducerMark(info.producerFor(i as ParamCount)))
		end 'eachName'

		self.hash = state
	end 'recordParamDefaults'

	// ⭐ **THE CALLEE'S DEFAULT FACTS, or `allRequired`** — the door a CALL SITE asks once, and only when it
	// supplied fewer arguments than it might have. `allRequired` (no recorded entry) is every runtime callee
	// and every function that declares no default, which is the overwhelming common case — so the call
	// site's fast path is a single map miss and nothing to slot.
	export function defaultsOf(callee ByteArray) returns CalleeParamDefaults
		let info = try self.settledDeclarations().funcParamDefaults.get(callee) otherwise return CalleeParamDefaults.allRequired
		return CalleeParamDefaults.defaults(info)
	end 'defaultsOf'

	// ⚡ **DOES `callee` DECLARE A DEFAULT ON ANY PARAMETER? — the presence-only half of `defaultsOf`, and
	// the one a HOT PATH may ask.** Membership IS the answer, because only a function that declares a default
	// is recorded, so this is a `contains` and not a `get otherwise` — whose fallback would mint a
	// payload-free `allRequired` union case (still a heap object) at every one of the program's calls that
	// is not to a defaulting callee, i.e. almost all of them. The same accounting `throwsMap.contains` is
	// written for one registry over.
	//
	// Two askers: the gates of `Parser.fillOmittedArgDefaults` and `Parser.calleeFillsDefaultsAfter`.
	export function declaresParamDefaults(callee ByteArray) returns bool
		return self.settledDeclarations().funcParamDefaults.contains(callee)
	end 'declaresParamDefaults'

	// Record one function's `throws E` clause AND fold it into the hash — the one write, for `record`'s
	// reason. A NON-throwing function is not recorded (its default answer is "does not throw"), so the
	// common function costs no map entry and no hash movement, exactly as `recordParamConsume` treats a
	// borrow-only one.
	function recordThrows(name ByteArray, clause ThrowsClause)
		if not throwsClauseIsThrowing(clause) 'nonThrowing'
			return
		end 'nonThrowing'

		self.mainThreadSettled().funcThrows.upsert(name, value: clause)

		// The THROWS TYPE NAME rides too — a callee that changes which error it throws changes what type a
		// caller's `(e)` binding recovers — and it rides through the SHARED `mixThrowsClause`, so a function's
		// clause and an interface requirement's clause enter the hash the one way.
		self.hash = mixThrowsClause(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeThrows), bytes: name), clause: clause)
	end 'recordThrows'

	// Record one proved body fact — the write plus the hash, for `recordThrows`'
	// reason. ⭐ **ONE RECORDER FOR EVERY FACT**, taking the registry it writes to: the facts differ only in
	// WHICH call shape reads them back, which is a property of the door and not of the recording.
	function recordSweptBodyFact(name ByteArray, marked DeclaredBodyFactNameSet, shape HashDigest)
		marked.insert(name)
		self.hash = mixBytes(Hasher.combined(self.hash, value: shape), bytes: name)
	end 'recordSweptBodyFact'

	// ⭐⭐ **DOES A CALL TO THIS NAME NEVER COME BACK? — the door `Parser.terminateAfterDivergingCall` asks
	// before letting a bare-call STATEMENT end its block.**
	export function functionNeverReturns(callee ByteArray) returns bool
		return self.settledDeclarations().funcDiverges.contains(callee)
	end 'functionNeverReturns'

	// ⭐⭐ **DOES A CALL TO THIS NAME ALWAYS THROW? — the door `Parser.desugarTry` asks before letting a
	// PROPAGATING `try` STATEMENT end its block.** `functionNeverReturns`' twin, one registry over: the
	// question is identical, and only the way the body leaves and the call shape that reads it differ.
	//
	// ⚠ **IT IS NOT A SUPERSET OF `functionNeverReturns` AND MUST NOT BE FOLDED INTO IT.** A `panic` helper's
	// call is a terminator written BARE; an always-throwing one's is a terminator only under a propagating
	// `try`, because an `otherwise` catches the error and control comes back. Answering either question with
	// the other's set would end a block control really leaves by.
	export function functionAlwaysThrows(callee ByteArray) returns bool
		return self.settledDeclarations().funcAlwaysThrows.contains(callee)
	end 'functionAlwaysThrows'

	// ⭐⭐ **DOES A CALL TO THIS NAME HAND BACK A RECORD NOBODY ELSE OWNS? — the door `Parser.emitCall` asks
	// before marking its result MOVABLE INTO A GREEN THREAD.** The two doors above's third sibling: a
	// declaration the sweep could not read that exactly publishes nothing and answers `false`.
	//
	// ⛔ **THE SAFE DIRECTION IS `false`, AND IT IS SAFE IN A WAY THE OTHER TWO ARE NOT.** A missed `true`
	// costs a SEND its move, which takes a reference of its own instead; a wrong `true` hands a box to a
	// second green thread while this one still holds it, which the plain refcount cannot survive. Every
	// uncertainty in `Parser.noteFreshReturnShape` therefore resolves to recording nothing.
	//
	// ⭐⭐ **IT CLOSES OVER FORWARDING CALLS (`closeFreshReturnForwards`).** `return other()` is fresh exactly
	// when `other` is, which is how `String.clone`, `return sliceBytes(…)`, answers `true`. A body
	// that binds what it returns is read over every use of the local (`Parser.everyReturnedLocalHoldsAFreshRecord`).
	export function returnsFreshValue(callee ByteArray) returns bool
		self.closeFreshReturnForwards()
		return self.keyReturnsFreshRecord(callee)
	end 'returnsFreshValue'

	// ⭐⭐ **IS A CALL TO THIS NAME THE CONSTRUCTION IT PERFORMS? — the door the record probe asks before
	// imaging a top-level `T.create(…)` as the construction it stands for.**
	export function functionConstructsFromParams(callee ByteArray) returns bool
		return self.settledDeclarations().funcConstructsFromParams.contains(callee)
	end 'functionConstructsFromParams'

	export function returnsAMovedOutElement(callee ByteArray) returns bool
		let visiting = NameRoster.create(0)
		return self.keyMovesAnElementOut(callee, visiting: visiting)
	end 'returnsAMovedOutElement'

	function keyMovesAnElementOut(key ByteArray, visiting NameRoster) returns bool
		if self.returnsFreshValue(key) 'movedOutAlready'
			return true
		end 'movedOutAlready'

		let declaration = try self.settledDeclarations().funcFieldMoveOutForwards.get(key) otherwise return false

		// A key already on the walk is a cycle, which proves nothing.
		if visiting.contains(key) 'aCycle'
			return false
		end 'aCycle'

		visiting.push(key)
		let moves = self.declarationMovesAnElementOut(declaration, visiting: visiting)
		_ = try visiting.pop() otherwise panic("ProgramSignatures.keyMovesAnElementOut: pop from the list just pushed to")
		return moves
	end 'keyMovesAnElementOut'

	function declarationMovesAnElementOut(declaration FreshReturnForwardingDeclaration, visiting NameRoster) returns bool
		for forward in declaration.forwards 'eachForward'
			if not self.fieldForwardMovesAnElementOut(forward, visiting: visiting) 'aBorrow'
				return false
			end 'aBorrow'
		end 'eachForward'

		return true
	end 'declarationMovesAnElementOut'

	function fieldForwardMovesAnElementOut(forward FreshReturnForward, visiting NameRoster) returns bool
		return match forward 'shape'
			ofFieldOfEnclosingType(typeName, fields, name) gives self.fieldTargetMovesAnElementOut(self.fieldMemberForwardTarget(typeName, fields: fields, name: name), visiting: visiting)
			unqualified or
			ofEnclosingType or
			ofNamedType panic("ProgramSignatures.fieldForwardMovesAnElementOut: a call forward reached the field move-out channel")
		end 'shape'
	end 'fieldForwardMovesAnElementOut'

	function fieldTargetMovesAnElementOut(target FieldMoveOutTarget, visiting NameRoster) returns bool
		return match target 'target'
			libraryDoor gives true
			declaration(key) gives self.keyMovesAnElementOut(key, visiting: visiting)
			unnameable gives false
		end 'target'
	end 'fieldTargetMovesAnElementOut'

	export function returnsAParameter(callee ByteArray) returns bool
		return self.settledDeclarations().funcReturnsParameter.contains(callee)
	end 'returnsAParameter'

	export function returnsAReceiverField(callee ByteArray) returns bool
		if not self.settledDeclarations().funcReturnsReceiverField.contains(callee) 'notProved'
			return false
		end 'notProved'

		return not self.nameIsAnInterfaceRequirement(bareMethodName(genericTemplateName(callee)).toByteArray())
	end 'returnsAReceiverField'

	function nameIsAnInterfaceRequirement(bare ByteArray) returns bool
		if bare.equals(ToStringMethodName) or bare.equals(HashMethodName) or bare.equals(EqualsMethodName) or bare.equals(CompareMethodName) or bare.equals(CloneMethodName) 'aSynthesizedProtocolMethod'
			return true
		end 'aSynthesizedProtocolMethod'

		return self.settledDeclarations().interfaceRequirementNames.contains(bare)
	end 'nameIsAnInterfaceRequirement'

	function recordFreshReturnForward(name ByteArray, forwards FreshReturnForwardArray, declFilePath FilePath)
		self.recordForwardingDeclaration(self.mainThreadSettled().funcFreshReturnForwards, shape: SignatureDiscriminator.declShapeFreshReturnForward, name: name, forwards: forwards, declFilePath: declFilePath)
	end 'recordFreshReturnForward'

	function recordFieldMoveOutForward(name ByteArray, forwards FreshReturnForwardArray, declFilePath FilePath)
		self.recordForwardingDeclaration(self.mainThreadSettled().funcFieldMoveOutForwards, shape: SignatureDiscriminator.declShapeFieldMoveOutForward, name: name, forwards: forwards, declFilePath: declFilePath)
	end 'recordFieldMoveOutForward'

	// One forwarding declaration's calls: the key's first declaration is the one stored, and a later one is
	// dropped (a second declaration of a key is E3006). The hash is mixed
	// for every declaration, for `recordSweptBodyFact`'s reason: a body that starts forwarding somewhere else
	// is a different program — and the declaring file rides because it decides which declaration an
	// unqualified call names.
	function recordForwardingDeclaration(into FreshReturnForwardMap, shape HashDigest, name ByteArray, forwards FreshReturnForwardArray, declFilePath FilePath)
		if not into.contains(name) 'theFirstDeclarationOfTheKeyIsTheOneKept'
			into.upsert(name, value: FreshReturnForwardingDeclaration.create(forwards, declFilePath: declFilePath))
		end 'theFirstDeclarationOfTheKeyIsTheOneKept'

		self.hash = mixBytes(mixBytes(Hasher.combined(self.hash, value: shape), bytes: name), bytes: declFilePath.toString().toByteArray())

		for forward in forwards 'eachForward'
			match forward 'shape'
				unqualified(enclosingType, callee) then self.mixFreshReturnForward(SignatureDiscriminator.freshForwardUnqualifiedShape, typeName: try enclosingType.typeName() otherwise EmptySourceText, callee: callee)
				ofEnclosingType(typeName, callee, takesReceiver) then self.mixFreshReturnForward(SignatureDiscriminator.freshForwardSelfReceiverShape if takesReceiver else SignatureDiscriminator.freshForwardSelfTypeShape, typeName: typeName, callee: callee)
				ofNamedType(typeName, callee) then self.mixFreshReturnForward(SignatureDiscriminator.freshForwardNamedTypeShape, typeName: typeName, callee: callee)
				ofFieldOfEnclosingType(typeName, fields, callee) then self.mixFreshReturnForwardThroughFields(typeName, fields: fields, callee: callee)
			end 'shape'
		end 'eachForward'
	end 'recordForwardingDeclaration'

	function mixFreshReturnForwardThroughFields(typeName ByteArray, fields NameRoster, callee ByteArray)
		self.mixFreshReturnForward(SignatureDiscriminator.freshForwardFieldMemberShape, typeName: typeName, callee: callee)

		for field in fields 'eachField'
			self.hash = mixBytes(self.hash, bytes: field)
			self.noteMentionedName(field)
		end 'eachField'
	end 'mixFreshReturnForwardThroughFields'

	function mixFreshReturnForward(shape HashDigest, typeName ByteArray, callee ByteArray)
		self.hash = mixBytes(mixBytes(Hasher.combined(self.hash, value: shape), bytes: typeName), bytes: callee)
		self.noteMentionedName(callee)
		self.noteMentionedName(typeName)
	end 'mixFreshReturnForward'

	// ⭐⭐⭐ **THE LEAST FIXPOINT THAT CLOSES `returnsAFreshRecord` OVER FORWARDING CALLS, AT ANY DEPTH.** A
	// declaration whose every `return` hands back a record literal OR a call's result publishes a CONDITION;
	// this discharges it against the declarations those calls reach, which only the whole-program merge knows.
	// The unconditional publishers are already in `funcReturnsFreshRecord` when this runs.
	//
	// ⚡ **A WORKLIST OVER REVERSE EDGES, SO THE CLOSE IS LINEAR IN THE FORWARDING CALLS.** Each forwarding
	// declaration counts the calls not yet fresh and waits on each of their keys; a key wakes its waiters once
	// it has published, so no pass rescans a forwarder that nothing new could settle.
	// A cycle keeps its members waiting on each other and publishes none of them — a missed `true`, the safe
	// direction.
	//
	// ⛔⛔ **A WRONG `true` HERE IS A MOVED BOX A SECOND OWNER STILL HOLDS, NOT A REFUSAL** — the direction
	// `returnsFreshValue`' header names. What makes the hop sound is that the forwarding
	// frame BINDS NOTHING: `return f(…)` with the call ending the line has no statement between the callee's
	// hand-off and its own, so the reference it passes on is the one it received and nobody else names it.
	// That is the identical argument the record-literal criterion rests on, one frame out.
	//
	// ⚡ The map is empty for every program whose bodies build the records they return, so the guard is one
	// `count()` and no sweep runs at all.
	function closeFreshReturnForwards()
		if self.freshReturnForwardsClosed 'alreadySettled'
			return
		end 'alreadySettled'

		self.freshReturnForwardsClosed = true

		if self.settledDeclarations().funcFreshReturnForwards.count() == 0 'nothingForwards'
			return
		end 'nothingForwards'

		let forwarderNames = NameRoster.create(self.settledDeclarations().funcFreshReturnForwards.count(), zeroed: false)
		let unsettled = UnsettledTargetCountArray.create(self.settledDeclarations().funcFreshReturnForwards.count(), zeroed: false)
		let waiters = FreshReturnWaiterMap.create()
		let ready = FreshReturnForwarderIndexArray.create(0)

		for (name, declaration) in self.settledDeclarations().funcFreshReturnForwards 'eachForwardingKey'
			let forwarder = forwarderNames.count()
			let pending = self.unsettledTargetsOf(declaration, owner: name, forwarder: forwarder, waiters: waiters)
			forwarderNames.push(name)
			unsettled.push(pending)

			if pending == 0 'freshAlready'
				ready.push(forwarder)
			end 'freshAlready'
		end 'eachForwardingKey'

		while ready.count() > 0 'publishSettled'
			let forwarder = try ready.pop() otherwise panic("closeFreshReturnForwards: pop from a non-empty worklist")
			let name = try forwarderNames.get(forwarder) otherwise panic("closeFreshReturnForwards: forwarder {forwarder} was queued past the {forwarderNames.count()} recorded")
			self.mainThreadSettled().funcReturnsFreshRecord.insert(name)

			if not waiters.contains(name) 'nothingWakes'
				continue
			end 'nothingWakes'

			for waiter in try waiters.get(name) otherwise panic("closeFreshReturnForwards: '{String.from(name)}' left the waiter map after `contains`") 'eachWaiter'
				let left = (try unsettled.get(waiter) otherwise panic("closeFreshReturnForwards: waiter {waiter} is past the {unsettled.count()} recorded")) - 1
				try unsettled.set(waiter, value: left) otherwise panic("closeFreshReturnForwards: unsettled.set OOB at {waiter}")

				if left == 0 'nowFresh'
					ready.push(waiter)
				end 'nowFresh'
			end 'eachWaiter'

			_ = waiters.remove(name)
		end 'publishSettled'
	end 'closeFreshReturnForwards'

	// How many of one forwarding declaration's calls do not reach a fresh declaration yet, each recorded as a wait
	// on its key. A call that reaches no declaration a key names exactly can never be fresh, so it counts and
	// waits on nothing.
	//
	// ⚠ It reads `funcReturnsFreshRecord` DIRECTLY rather than through `returnsFreshValue`, whose first act is
	// to run the close this is part of.
	function unsettledTargetsOf(declaration FreshReturnForwardingDeclaration, owner ByteArray, forwarder ElementIndex, waiters FreshReturnWaiterMap) returns UnsettledTargetCount
		var pending = 0 as UnsettledTargetCount

		for forward in declaration.forwards 'eachForward'
			match self.freshReturnForwardTarget(forward, declFilePath: declaration.declFilePath) 'target'
				declaration(key) then pending = pending + self.awaitedKeyCount(key, owner: owner, forwarder: forwarder, waiters: waiters)
				unnameable then pending = pending + 1
			end 'target'
		end 'eachForward'

		return pending
	end 'unsettledTargetsOf'

	// One if `forwarder` must wait on `key`, recorded once however many of its calls name that key; zero when
	// the key is fresh already or the wait is recorded.
	//
	// It is also zero for the forwarder's own key (`owner`): a call to itself adds no obligation beyond the
	// declaration's other calls, and waiting on a key that includes the waiter never settles.
	function awaitedKeyCount(key ByteArray, owner ByteArray, forwarder ElementIndex, waiters FreshReturnWaiterMap) returns UnsettledTargetCount
		if key.equals(owner) or self.keyReturnsFreshRecord(key) 'settledAlready'
			return 0
		end 'settledAlready'

		let waiting = try waiters.get(key) otherwise FreshReturnForwarderIndexArray.create(0)

		if waiting.count() > 0 and (try waiting.get(waiting.count() - 1) otherwise panic("awaitedKeyCount: last waiter of a non-empty list")) == forwarder 'alreadyWaiting'
			return 0
		end 'alreadyWaiting'

		waiting.push(forwarder)
		waiters.upsert(key, value: waiting)
		return 1
	end 'awaitedKeyCount'

	// ⭐⭐ **WHICH DECLARATION A FORWARDING CALL REACHES — the real parse's resolution of the same spelling,
	// asked once every declaration is folded.** It is re-derived rather than read off the parsed call because
	// `returnsFreshValue` is asked while bodies are still being parsed, in any file order. `unnameable` wherever
	// that resolution could reach something no key here names exactly; a wrong key would lend one declaration's
	// freshness to a call that reaches another.
	//
	//   • `name(…)` is `Parser.parseCall`: the enclosing type's member when it declares one
	//     (`isImplicitSelfMethod`), else the one declaration `resolveFunctionName` finds visible from the
	//     declaring file.
	//   • `self.name(…)` / `Self.name(…)` name the enclosing type's instance / static member.
	//   • `Type.name(…)` is `Parser.resolveStaticMember` for a head that names a plain `type` and nothing
	//     else: no alias, enum, union or other kind shares the name, it is outside the reserved `__` space whose
	//     members the parser intercepts by name, and `ChainResolution.classifiedChainHead` reads the head as a
	//     nominal type from the declaring file. A user type that displaces a stdlib one needs no refusal: every
	//     stdlib spelling of that name is rewritten into the reserved space (`Parser.shadowRenamedTokens`), so
	//     the bare name is the user's alone.
	function freshReturnForwardTarget(forward FreshReturnForward, declFilePath FilePath) returns FreshReturnForwardTarget
		return match forward 'shape'
			unqualified(enclosingType, name) gives self.unqualifiedForwardTarget(enclosingType, name: name, readerFilePath: declFilePath)
			ofEnclosingType(typeName, name, _) gives self.declaredForwardTarget(qualifiedMethodName(typeName, methodName: name))
			ofNamedType(typeName, name) gives self.namedTypeForwardTarget(typeName, name: name, readerFilePath: declFilePath)
			ofFieldOfEnclosingType panic("freshReturnForwardTarget: a field move-out forward is read by `returnsAMovedOutElement` and never reaches the sole-owner close")
		end 'shape'
	end 'freshReturnForwardTarget'

	function unqualifiedForwardTarget(enclosingType EnclosingTypeScope, name ByteArray, readerFilePath FilePath) returns FreshReturnForwardTarget
		if let typeName = try enclosingType.typeName() 'insideAType'
			let member = qualifiedMethodName(typeName, methodName: name)

			if self.declaresCallee(member) 'aSiblingMember'
				return FreshReturnForwardTarget.declaration(member)
			end 'aSiblingMember'
		end 'insideAType'

		return match self.resolveBareFunctionName(name, readerFilePath: readerFilePath) 'resolution'
			declaration(key) gives self.declaredForwardTarget(key)
			ambiguous or
			undeclared gives FreshReturnForwardTarget.unnameable
		end 'resolution'
	end 'unqualifiedForwardTarget'

	function namedTypeForwardTarget(typeName ByteArray, name ByteArray, readerFilePath FilePath) returns FreshReturnForwardTarget
		if not self.containsStructInAnyFile(typeName) or self.crossKindContested(typeName) or self.isGenericAliasInAnyFile(typeName) or self.containsEnumInAnyFile(typeName) or isCompilerReservedName(typeName) 'notOnlyAType'
			return FreshReturnForwardTarget.unnameable
		end 'notOnlyAType'

		if not chainHeadIsNominal(classifiedChainHead(self, head: typeName, readerFilePath: readerFilePath, headIsAValue: false)) 'theHeadIsNotAType'
			return FreshReturnForwardTarget.unnameable
		end 'theHeadIsNotAType'

		return self.declaredForwardTarget(qualifiedMethodName(typeName, methodName: name))
	end 'namedTypeForwardTarget'

	function fieldMemberForwardTarget(typeName immutable ByteArray, fields NameRoster, name ByteArray) returns FieldMoveOutTarget
		if not isElementMoveOutName(name) 'notADoor'
			panic("fieldMemberForwardTarget: `{String.from(name)}` is not on the move-out roster — the sweep records a field forward only for a roster name")
		end 'notADoor'

		let owner = try self.typeNameAfterFields(typeName, fields: fields, at: 0) otherwise return FieldMoveOutTarget.unnameable
		let member = qualifiedMethodName(owner, methodName: name)

		if self.declaresALibraryMoveOutDoor(member) 'aLibraryDoor'
			return FieldMoveOutTarget.libraryDoor
		end 'aLibraryDoor'

		let key = member

		if not self.declaresCallee(key) 'noSuchMember'
			return FieldMoveOutTarget.unnameable
		end 'noSuchMember'

		return FieldMoveOutTarget.declaration(key)
	end 'fieldMemberForwardTarget'

	function typeNameAfterFields(owner immutable ByteArray, fields NameRoster, at ElementIndex) returns immutable ByteArray throws AbsentError
		if at >= fields.count() 'everyFieldWalked'
			return owner
		end 'everyFieldWalked'

		let field = try fields.get(at) otherwise panic("ProgramSignatures.typeNameAfterFields: fields.get OOB at {at} below count {fields.count()}")

		return try self.typeNameAfterFields(try self.declaredTypeNameOfField(owner, field: field), fields: fields, at: at + 1)
	end 'typeNameAfterFields'

	export function declaresALibraryMoveOutDoor(member ByteArray) returns bool
		return isElementMoveOutName(unqualifiedMemberOf(member)) and self.declarationIsTheCorpus(member)
	end 'declaresALibraryMoveOutDoor'

	export function declarationIsTheCorpus(member ByteArray) returns bool
		let decl = try self.sweptDeclarationOf(member) otherwise return false
		return self.declaredByTheCorpus(decl.declFilePath)
	end 'declarationIsTheCorpus'

	function declaredTypeNameOfField(owner ByteArray, field ByteArray) returns immutable ByteArray throws AbsentError
		if not self.containsStructInAnyFile(owner) 'ownerIsNoStruct'
			throw AbsentError.absent
		end 'ownerIsNoStruct'

		let layout = self.structLayoutOf(owner)

		for i in 0 upto layout.fieldCount() 'eachField'
			if (try layout.fieldNames.get(i) otherwise panic("ProgramSignatures.declaredTypeNameOfField: fieldNames.get OOB at {i}")).equals(field) 'theField'
				return try self.declaredTypeNameOfSlot(try layout.fieldTypes.get(i) otherwise panic("ProgramSignatures.declaredTypeNameOfField: fieldTypes.get OOB at {i}"), owner: owner)
			end 'theField'
		end 'eachField'

		throw AbsentError.absent
	end 'declaredTypeNameOfField'

	function declaredTypeNameOfSlot(t MaxonType, owner ByteArray) returns immutable ByteArray throws AbsentError
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.genericInstanceBaseName(genericInstanceIdOf(t))
		end 'anInstance'

		if not self.tagMayNameAggregate(tag) 'namesNoType'
			throw AbsentError.absent
		end 'namesNoType'

		let written = self.denotedSlotAggregateName(t)
		let scoped = qualifiedMethodName(owner, methodName: written)

		if self.isGenericAliasInAnyFile(scoped) 'anInnerAlias'
			return try self.genericAliasBaseName(scoped)
		end 'anInnerAlias'

		if self.isGenericAliasInAnyFile(written) 'aGenericAlias'
			return try self.genericAliasBaseName(written)
		end 'aGenericAlias'

		return written
	end 'declaredTypeNameOfSlot'

	function genericAliasBaseName(aliasName ByteArray) returns immutable ByteArray throws AbsentError
		return self.genericInstanceBaseName(try self.liveGenericAliasInstance(aliasName) otherwise throw AbsentError.absent)
	end 'genericAliasBaseName'

	function declaredForwardTarget(key ByteArray) returns FreshReturnForwardTarget
		return FreshReturnForwardTarget.declaration(key) if self.declaresCallee(key) else FreshReturnForwardTarget.unnameable
	end 'declaredForwardTarget'

	// The declaration of `key` returns a record nobody else owns.
	function keyReturnsFreshRecord(key ByteArray) returns bool
		return self.settledDeclarations().funcReturnsFreshRecord.contains(key)
	end 'keyReturnsFreshRecord'

	// ⭐ **THE CALLEE'S `throws` CLAUSE, or `none`** — the door a call site asks: does this callee throw,
	// and what error type does it throw? `none` (no recorded entry) is every non-throwing function and the
	// common case. Read by the parser (to type an `(e)` binding) and by SemanticCheck (E3055/E3057).
	export function throwsOf(callee ByteArray) returns ThrowsClause
		// ⭐ **A COMPILER-INTERNAL RUNTIME CALLEE IS NOT IN `funcThrows`, AND CANNOT BE.** That map is
		// filled by the declaration sweep from DECLARED functions; `__mf_open_read` is minted at lowering and
		// no file declares it, so the map will never hold it however the sweep is extended.
		//
		// ⚠ **Until this arm existed the consequence was invisible and specific:** `try … otherwise (e)` bound
		// `e` with NO type, so `match e` fell to the scalar path and reported "enum-case patterns arrive in a
		// later wave" — a message about a missing FEATURE, for a program whose feature is present. MEASURED
		// against the control: the identical `match` over a USER enum's error compiles and runs, so the gap
		// was the binding's type, not the match.
		//
		// ⚠ WHICH families answer is `runtimeThrowsClause`'s to say, not this function's — see it for why a
		// family answering `none` is a scoped statement rather than an oversight. It is asked ONCE here so a
		// family added there is typed at every `(e)` binding without this door growing a second `match`.
		let runtimeClause = runtimeThrowsClause(callee)

		if throwsClauseIsThrowing(runtimeClause) 'runtimeCallee'
			return runtimeClause
		end 'runtimeCallee'

		return try self.settledDeclarations().funcThrows.get(callee) otherwise ThrowsClause.none
	end 'throwsOf'

	// ⭐⭐ **ADD ONE DECLARED INTERFACE TO THE INDEX AND FOLD IT INTO THE HASH** — the one write, for
	// `record`'s reason. Last-wins on a duplicate interface name (a duplicate declaration is the real parse's
	// to report, with a position).
	//
	// ⚠ **WHAT RIDES THE HASH IS WHAT A *PARSE* COPIES OUT OF THIS DECLARATION, AND THAT IS LESS THAN THE
	// RECORD HOLDS.** This hash keys every parse memo, so the rule is the one stated at `ProgramSignatures.hash`
	// and sharpened at "MIX WHAT A READER COPIES": a fact rides iff changing it changes what ANOTHER file
	// compiles to while that file's own bytes stay put.
	//
	//   • The `uses` ARITY rides: it decides whether the comma in `implements Duo with
	//     A, B` opens a second ARGUMENT or a second INTERFACE, so it changes what a conformance in any file
	//     PARSES — a reader that did not re-parse would go on binding the old count.
	//   • The declaring FILE rides: a dispatch in any file resolves the formals as that file sees them
	//     (`requirementAbiType`, `SemanticCheck.nominalWitnessFormal`), so moving the interface to another
	//     file changes what its callers check.
	//   • Each method's NAME, RETURN TYPE, FORMAL TYPES, FORMAL NAMES and `throws` ride: a witness dispatch in
	//     any file picks its table SLOT, its result type, its `Self`-formal rejection, its `name:` label
	//     vocabulary and its calling ABI off exactly those five (`Parser.findWitnessDispatchCandidates`), and every one
	//     of them is baked into that file's emitted code. A dispatch compiled against the previous `throws`
	//     reads a flag register the callee never writes.
	//   • **`extendsInterfaces` RIDES.** *"Nothing in a PARSE reads it"* holds only while a witness
	//     dispatch resolves against `iface.methods` alone, and the dispatch
	//     numbers its slot against the interface's TRANSITIVE requirement list: adding `extends Base` to an
	//     interface moves every slot index a `where T is Derived` dispatch compiles into ANOTHER file,
	//     while that file's own bytes stay put — the exact test this rule states. Only the parent NAMES ride;
	//     the parents' own methods reach the hash through their own entries, since one hash is folded over
	//     every declaration in the program.
	//   • **`isStatic` RIDES — `extendsInterfaces`' argument exactly, one field over.** *"Nothing in a PARSE
	//     reads it; `ConformanceCheck` does, but off `project.interfaces`"* holds only while a witness
	//     dispatch binds whatever requirement the name
	//     search reaches. A PARSE does read it: `Parser.requireWitnessDispatchCandidates` REFUSES a
	//     dispatch whose requirements are all `static` (E3116), and `IrInterface.witnessTargetIsProtocol`
	//     refuses a `static` look-alike as `Equatable`/`Comparable` (E3005). So `function origin()` becoming
	//     `static function origin()` here decides whether a `where T is Origin` body in ANOTHER file compiles
	//     at all, while that file's own bytes stay put — the exact test this rule states. It is NOT the
	//     "sound, and useless" key: a receiver kind is not a payload nobody outside the file can observe, and
	//     the edit that moves it is rare.
	//     MEASURED with the flag left out (`verify-warm-rebuild`, 2-file project + stdlib): a `static`-flag
	//     edit re-parses **1** file where the property demands **8**. `VerifyWarmRebuild.ReceiverKindEditBefore`
	//     is the probe, and it is the only one here that can see this — the other four move a NAME or a
	//     VALUE, and a key mixing those moves on all of them.
	export function recordInterfaceDeclaration(iface IrInterface, visibility Visibility)
		self.mainThreadSettled().interfaces.entries.upsert(iface.name, value: iface)

		// ⭐ **AN INTERFACE'S ASSOCIATED TYPES ARE TYPE PARAMETERS AND THEY MINT TOKENS** — inside
		// `interface Seq uses Element`, a written `Element` resolves to `typeParameter` exactly as a `type`'s
		// `uses` name does (`Parser.readInterfaceDeclaration` installs them in the same field), so the token
		// ledger has to know them or a `Seq`'s `Element` and a conformer's would be a token with no owner.
		// The one other declaration form that installs a parameter scope — a TYPE extension's body — borrows
		// the extended type's own list, which `recordStruct` has already filed.
		for i in 0 upto iface.associatedTypeNames.count() 'eachAssociatedType'
			self.recordTypeParamToken(iface.name, paramName: try iface.associatedTypeNames.get(i) otherwise panic("ProgramSignatures.recordInterfaceDeclaration: associatedTypeNames.get OOB at {i} below count {iface.associatedTypeNames.count()}"), position: i)
		end 'eachAssociatedType'

		// The declaration-order handle, minted in the SAME act as the map entry (see
		// `interfaceNamesInDeclOrder`). A name already present keeps its index — a redeclaration, and a user
		// type sharing a synthesized protocol's name, both resolve through `lookupInterface` at the asking
		// end, so one position per NAME is exactly right and nothing here has to decide which wins.
		if not self.mainThreadSettled().interfaceDeclIndexByName.contains(iface.name) 'firstDeclarationOfThisName'
			self.mainThreadSettled().interfaceDeclIndexByName.upsert(iface.name, value: self.mainThreadSettled().interfaceNamesInDeclOrder.count())
			self.mainThreadSettled().interfaceNamesInDeclOrder.push(iface.name)
		end 'firstDeclarationOfThisName'

		let named = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeInterface), bytes: iface.name)
		self.hash = Hasher.combined(mixDeclaringTier(named, visibility: visibility, declFilePath: iface.declFilePath), value: iface.associatedTypeNames.count() as HashDigest)

		for parentName in iface.extendsInterfaces 'eachParent'
			self.hash = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeInterfaceParent), bytes: parentName)
		end 'eachParent'

		for method in iface.methods 'eachMethod'
			self.mainThreadSettled().interfaceRequirementNames.insert(method.name)
			self.hash = mixBytes(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeInterfaceMethod), bytes: method.name), bytes: method.returnTypeName)
			self.hash = self.mixRequirementType(self.hash, requirement: method.returnType)
			self.hash = mixInterfaceFormals(self.hash, names: method.paramNames, types: method.paramTypeNames)

			for param in method.paramTypes 'eachParamType'
				self.hash = self.mixRequirementType(self.hash, requirement: param)
			end 'eachParamType'

			self.hash = mixThrowsClause(self.hash, clause: method.throwsClause)
			self.hash = mixCapabilities(self.hash, params: method.paramCapabilities, result: method.returnCapability)
			self.hash = Hasher.combined(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeSelfCapability), value: method.selfCapability.ordinal as HashDigest)
			self.hash = Hasher.combined(self.hash, value: SignatureDiscriminator.receiverShapeAbsent if method.isStatic else SignatureDiscriminator.receiverShapePresent)
		end 'eachMethod'
	end 'recordInterfaceDeclaration'

	// ⭐⭐ **THE DECLARED-INTERFACE STORE A *PARSE* MAY ASK, HANDED OUT WHOLE** — the whole-program half
	// of the parse-time answer, `structOf`'s twin. `project.interfaces` is not merged until every file
	// has parsed, so this map is the only interface store that exists mid-parse.
	//
	// ⚠ **THE STORE, NOT AN `interfaceOf(name)` ANSWER.** A one-name accessor would make its caller
	// (`Parser.requireInterfaceForParse`) spell the "synthesized protocol FIRST, then the store" rule
	// for itself — a second spelling of `IrInterface.lookupInterface`. A witness dispatch resolves its
	// CONSTRAINT's interface through the parser's spelling and every `extends` PARENT through
	// `lookupInterface`, one call apart, and a parent that resolves for the slot walk but not for the
	// constraint is a wrong slot COUNT with no diagnostic. Handing out the store leaves exactly one
	// statement of the rule.
	export function interfaceMap() returns IrInterfaceMap
		return self.settledDeclarations().interfaces
	end 'interfaceMap'

	export function declaringInterface(interfaceName ByteArray) returns IrInterface
		match lookupInterface(self.settledDeclarations().interfaces, name: interfaceName) 'declaring'
			found(iface) then return iface
			notFound then panic("ProgramSignatures.declaringInterface: no interface '{String.from(interfaceName)}' declares the requirement being read — a witness dispatch's declaring interface comes out of this index")
		end 'declaring'
	end 'declaringInterface'

	function interfaceDeclarationSites() returns InterfaceDeclSiteArray
		return self.settledDeclarations().interfaceDeclSites
	end 'interfaceDeclarationSites'

	// The declaration-order handle for an interface a dispatch resolved against — see `interfaceNamesInDeclOrder`
	// for what a `witnessDispatch` needs it for. It throws rather than returning a sentinel: every caller
	// holds an `IrInterface` that came OUT of `interfaceMap()`, so a miss is a compiler defect and the caller
	// says so.
	export function interfaceDeclIndexOf(name ByteArray) returns ElementIndex throws MapError
		return try self.settledDeclarations().interfaceDeclIndexByName.get(name)
	end 'interfaceDeclIndexOf'

	// The interface NAME an `interfaceDeclIndexOf` handle names — the read half, asked by `LowerMaxonToStd`
	// once per witness call. It answers a NAME and not a declaration for the reason
	// `interfaceNamesInDeclOrder` gives: the caller resolves it through `lookupInterface`, with the map its
	// own phase holds, so there is one rule for what a name denotes and this is not a second one.
	export function interfaceNameAtDeclIndex(index ElementIndex) returns immutable ByteArray
		return try self.settledDeclarations().interfaceNamesInDeclOrder.get(index) otherwise panic("ProgramSignatures.interfaceNameAtDeclIndex: index {index} is outside the {self.settledDeclarations().interfaceNamesInDeclOrder.count()} interface positions — a witness dispatch is naming an interface this program does not have, which means the op outlived the signature index it was numbered against")
	end 'interfaceNameAtDeclIndex'

	// Add one declared struct type to the index AND fold it into the hash. The one write, for
	// `record`'s reason: the table and the hash that keys every parse memo on it cannot disagree
	// about what the index contains.
	//
	// ⚠ **THE HASH CARRIES THE FIELD LIST, NOT MERELY THE NAME**, and that is `recordAlias`'s
	// argument about ranges applied to a layout. Every reader of `type Point` COPIES its layout into
	// its own code — `p.y` becomes `loadIndirect … offset 8`, and `Point.create` becomes an
	// `__mm_alloc` of 16 — while the reading file's own bytes never move. So reordering Point's
	// fields, renaming one, or adding a third changes what every other file COMPILES TO, and only
	// this hash can carry it. Without it, adding a field would leave every reader inlining the old
	// offsets against a box that is now a different shape: a silent out-of-bounds read.
	//
	// ⚠ **EVERY FACT A FIELD CARRIES RIDES THIS HASH, AND `mixField` IS THE ONE PLACE THEY DO.** The
	// default and mutability facts are here for the reason the field list is, one each way:
	//   • a DEFAULT changes CODEGEN — `export var value = 0` → `= 1` moves the `literal` op every
	//     other file's `Self{}` emits, while that file's own bytes never move;
	//   • MUTABILITY changes ACCEPTANCE — `var count` → `let count` must turn every other file's
	//     `c.count = 5` into E2013, and a reader that did not re-parse would go on compiling it.
	//
	// A hand-listed copy of a record's fields is a copy that can be short by one, silently. Keep the list
	// in ONE function.
	function recordStruct(layout StructLayout, declaredByTheCorpus bool)
		// ⭐ **THE PARAMETER TOKENS ARE FILED FIRST, AHEAD OF EVERY REASON THIS FOLD MIGHT DROP THE
		// LAYOUT.** A token is a fact about the DECLARATION'S TEXT, not about whether the registry keeps
		// its layout — and the real parse reads the body of a contested declaration (`type Array uses
		// Element` under a compiler-owned name) even while its E2015 is being reported, minting
		// `typeParameter` values whose owner a later instance query must still be able to name. Filing
		// them here costs one map entry per declared parameter and removes a whole class of "this token
		// has no owner" panic.
		for i in 0 upto layout.typeParamCount() 'eachDeclaredTypeParam'
			self.recordTypeParamToken(layout.name, paramName: try layout.typeParamNames.get(i) otherwise panic("ProgramSignatures.recordStruct: typeParamNames.get OOB at {i} below count {layout.typeParamCount()}"), position: i)
		end 'eachDeclaredTypeParam'

		// ⭐⭐ **A DECLARED `type` UNDER A COMPILER-OWNED NAME MAY COME FROM THE CORPUS AND FROM NOTHING ELSE
		// — `upsertDeclaredEnum`'s rule, one registry over, now spelled the SAME WAY.**
		//
		// The parse-time reject
		// (`Parser.requireTypeNameNotCompilerOwned`, E2015) is what the AUTHOR sees, but it cannot be what
		// keeps the registry honest: the declaration SWEEP is deliberately not a validator, so it folds the
		// declaration in before the real parse gets to refuse it, and every reader that resolves the name
		// through this registry then follows the user's declaration while `denotedNamedType` erases the name
		// to the builtin's own type.
		//
		// ⚠ MEASURED, on `type Codepoint … end` against `stdlib/helpers/string/utf16.maxon`: the
		// E2015 was reported correctly AND `utf16Width`'s `codepoint < 65536` became
		// **`E3005 cannot compare struct with int`, TWICE, positioned inside a stdlib file the author never
		// opened** — the user's struct having captured the parameter type of a module they did not write.
		// Dropping the declaration at the single write makes the collision unrepresentable rather than merely
		// diagnosed, which is the property the enum registry already has and for the same stated reason.
		//
		// ⭐⭐ **THE PROVENANCE BIT CURES TWO REACHABLE COMPILER PANICS.** Dropping EVERY declaration of such
		// a name, corpus included, rests on the premise that no stdlib module
		// declares one — a statement about which modules the loader happens to take, not about the
		// language — and it parts the
		// two doors over this one rule: `requireTypeNameNotCompilerOwned` ADMITS a stdlib file
		// (`livesUnderStdlibDirectory`), so the real parse walks into `type String`'s body while this write
		// has just thrown its layout away. The parser then asks for the layout of the declaration it is
		// standing inside and finds none.
		// ⚠ MEASURED, and they are PANICS rather than diagnostics:
		//   `maxon build stdlib/String.maxon`     ⇒ panic, `Parser.enclosingLayout`
		//   `maxon build stdlib/Character.maxon`  ⇒ panic, `Parser.requireConstructible`
		// Both blamed the declaration sweep for disagreeing with `parseTypeDeclaration` about what opens a
		// type declaration. They agreed perfectly; it was this REGISTRY that dropped what both had read.
		// ⇒ The rule is now the one sentence `upsertDeclaredEnum` already states — **a compiler-owned type
		// name may be declared by the CORPUS and by nothing else** — and a USER declaration is dropped here
		// exactly as before, which is what keeps `isCompilerOwnedTypeName`'s two measured silent wrong answers
		// (a user `hash()` answering 7 where djb2 answers 5381; `Set with String` counting 3 where the control
		// says 2) closed. `specs/string-conformance.md`'s two `may-not-bind-the-name` cases pin it.
		//
		// ⭐⭐ **A LISTED MODULE DECLARING A COMPILER-OWNED NAME: KEEP THE RESERVATION, DROP ANY SECOND
		// LAYOUT.** A compiler layout under a RESERVED spelling beside a corpus one under the BARE name
		// would give one concept two layouts under two keys; `String`, `Character`, `StringIndex` and
		// `CharacterSet` each have the corpus declaration alone. The bit below is what makes the corpus
		// declaration WIN rather than be dropped, and it is the only thing standing between two
		// numberings of one type. A struct layout MINTS an identity of its own, so it can agree with no
		// compiler-owned meaning — see `DeclaredTypeMeaning.nominalIdentity`.
		if declarationContestsACompilerOwnedName(layout.name, declaredByTheCorpus: declaredByTheCorpus, declares: DeclaredTypeMeaning.nominalIdentity) 'aUserContest'
			return
		end 'aUserContest'

		// The declaration-order handle, minted in the SAME act as the map entry — `recordInterfaceDeclaration`'s
		// discipline, for the reason stated at `structNamesInDeclOrder`. Asked BEFORE the upsert, so a
		// redeclaration of a name (E3006's business, reported elsewhere) keeps its one position.
		if not self.hasRegisteredLayout(layout.name) 'firstDeclarationOfThisName'
			self.mainThreadSettled().structNamesInDeclOrder.push(layout.name)
		end 'firstDeclarationOfThisName'

		self.addRegisteredLayout(layout)

		var state = mixDeclaringTier(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeStruct), bytes: layout.name), visibility: layout.visibility, declFilePath: layout.declFilePath)

		// The type PARAMETERS ride the hash: a change to `uses T` — a rename, or a change in
		// COUNT — changes which `Box with …` instantiations are the right arity in any file, so a reader's
		// parse memo must move with it. Mixed BEFORE the fields (a field's `typeParameter(token)` is only
		// meaningful against this list).
		for i in 0 upto layout.typeParamCount() 'eachTypeParam'
			let paramName = try layout.typeParamNames.get(i) otherwise panic("ProgramSignatures.recordStruct: typeParamNames.get OOB at {i}")
			state = mixBytes(Hasher.combined(state, value: SignatureDiscriminator.declShapeTypeParam), bytes: paramName)
		end 'eachTypeParam'

		// The `where` constraints ride the hash: a change to `where T is Digest` changes
		// which `Box with …` are legal (E3017) and which witness table a dispatch reads in any file, so a
		// reader's parse memo must move with it. Each entry's constrained-param INDEX and interface NAME are
		// mixed, in list order — the witness-slot order depends on that order too.
		state = self.mixWhereConstraints(state, constraints: layout.whereConstraints)
		state = self.mixRegionBounds(state, bounds: layout.regionBounds)

		// The `implements` list rides too — see `mixDeclaredConformances`. For a `type` it decides which
		// INTERFACE EXTENSION methods the type has, so adding or removing a name here adds or removes whole
		// functions from the program while the extension's own file never moves.
		state = mixDeclaredConformances(state, conformsTo: layout.conformsTo, shape: SignatureDiscriminator.declShapeDeclaredConformance)

		// And its `with` BINDINGS, for the sharper version of that same reason: they decide whether a
		// CONDITIONAL extension's methods exist on this type at all (`ConformanceCheck.checkExtensionConstraints`), so
		// editing `implements Holder with Score` to `with Tally` adds or removes functions from the program
		// with neither the extension's file nor this type's field list moving.
		state = self.mixConformanceBindings(state, bindings: layout.conformanceBindings)

		if layout.isUnique 'aUniqueType'
			state = Hasher.combined(state, value: SignatureDiscriminator.declShapeUniqueType)
		end 'aUniqueType'

		if layout.isLinear 'aLinearType'
			state = Hasher.combined(state, value: SignatureDiscriminator.declShapeLinearType)
		end 'aLinearType'

		for i in 0 upto layout.fieldCount() 'eachField'
			state = self.mixField(state, layout: layout, index: i)
		end 'eachField'

		self.hash = state
	end 'recordStruct'

	// Add one declared enum/union to the index AND fold it into the hash — `recordStruct`'s twin.
	//
	// ⚠ **THE HASH CARRIES THE CASE LIST AND THE TAGS, NOT MERELY THE NAME**, for `recordStruct`'s
	// reason applied to an enum. Every reader of `enum Color` COPIES its facts into its own code:
	// `Color.red` becomes an i64 `literal` of the tag, and a `match` over it becomes a chain of
	// compares against the tags plus an exhaustiveness check over the case NAMES. So changing a tag
	// (`red = 5`), reordering the cases, renaming one, or adding
	// a case changes what every other file COMPILES TO — while the reading file's own bytes never
	// move. Only this hash can carry it. The `isUnion` bit rides too: `enum` → `union` changes the
	// word a non-exhaustive-match diagnostic prints, and a reader that met that diagnostic must
	// re-parse to reprint it.
	//
	// ⚠⚠ **AND EACH CASE'S PAYLOAD SLOTS RIDE**, for that same rule one column further in — the case
	// name and tag alone said nothing about what a `mem(x)` binding LOADS. See `mixPayloadField`.
	//
	// ⚠⚠ **AND THE BACKING RIDES, BECAUSE THE TAG COLUMN CANNOT CARRY IT.** `enum Z  z = 0` and
	// `enum Z  z = 0.0` fold to the IDENTICAL name + tag (`floatLiteralBits(0.0)` is 0), and a reading file
	// compiles `"{z}"` to `__int_to_string` for one and `__float_toString` for the other. Editing the `0`
	// to `0.0` would otherwise leave every other file's parse memo valid and serve a stale answer, which is
	// exactly the class of staleness this hash exists to prevent — see the rule at `recordStruct`.
	function recordEnum(layout EnumLayout, declaredByTheCorpus bool)
		upsertDeclaredEnum(self.mainThreadSettled().enumTypes, layout: layout, declaredByTheCorpus: declaredByTheCorpus)

		var state = mixDeclaringTier(Hasher.combined(Hasher.combined(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeEnum), bytes: layout.name), value: SignatureDiscriminator.enumKindUnion if layout.isUnion else SignatureDiscriminator.enumKindEnum), value: enumBackingDiscriminator(layout.backing)), visibility: layout.visibility, declFilePath: layout.declFilePath)

		// ⭐⭐ **THE BACKING STRUCT'S NAME, WHICH THE DISCRIMINATOR ABOVE CANNOT CARRY.** `Meta` and `Other`
		// are both `structRecord`, so the backing bit says only THAT a struct backs the cases, never WHICH —
		// and which one it is decides what every reading file compiles a `.rawValue.<field>` to, because the
		// field POSITIONS come from that struct. Concretely: two structs with different field orders, and
		// `add = Meta.create(1)` edited to `Other.create(1)`. The argument is positional so no field name
		// moves, the constant is unchanged and the discriminator is unchanged — without this line the decl
		// hash does not move while a reader compiles a different constant. That is exactly the staleness
		// class `mixEnumCase`'s raw-value line exists for, and it is a per-DECLARATION fact rather than a
		// per-case one, so it rides here and not there. `EmptySourceText` for every other backing.
		state = mixBytes(state, bytes: try layout.backingStruct.typeName() otherwise EmptySourceText)

		// ⭐⭐ **WHETHER ANY CASE *WROTE* A RAW VALUE, WHICH NOTHING ELSE FOLDED HERE CAN CARRY.**
		// `enum C red green` and `enum C red = 0 green = 1` agree on the name, the kind, the backing
		// discriminator, the backing struct name, the conformances and — case by case — on the name, the tag
		// and (the identity being `theTag`) nothing further. So the two declarations hashed IDENTICALLY, while
		// a file interpolating one of them compiles `green` for the first and `1` for the second: a warm
		// rebuild across that edit would have served a parse of the reading file that renders the other one.
		// A per-DECLARATION fact, so it rides here beside the struct name and not in `mixEnumCase`.
		state = Hasher.combined(state, value: SignatureDiscriminator.enumDeclaresRawValues if layout.declaresRawValues else SignatureDiscriminator.enumAutoTagged)

		// The `implements` list rides for the field list's reason — see `mixDeclaredConformances`,
		// which states it once for both declaration kinds.
		state = mixDeclaredConformances(state, conformsTo: layout.conformsTo, shape: SignatureDiscriminator.declShapeDeclaredConformance)

		for i in 0 upto layout.caseCount() 'eachCase'
			state = self.mixEnumCase(state, layout: layout, index: i)
		end 'eachCase'

		self.hash = state
	end 'recordEnum'

	// Add one generic-instance typealias to the index AND fold it into the hash —
	// `recordStruct`'s twin. The base NAME is interned into this index's own interner, the args are
	// REMAPPED into it (they were minted against the scanning file's interner), the instance is
	// interned to a `GenericInstanceId`, and the alias name is mapped to it. Last-wins on a duplicate
	// alias (a duplicate typealias is reported elsewhere), exactly as `recordAlias` is.
	function recordGenericAlias(entry GenericAliasEntry, remap TypeIdRemap)
		let baseId = self.typeNames.intern(entry.baseName)
		let args = self.resolveGenericArgs(entry, remap: remap)
		let giid = self.internRow(baseId, args: args, shape: entry.shape)

		// ⭐ **THE PRIOR PROBE** — asked BEFORE the upsert, because after it every name is present. A name
		// two declarations mention is the only kind that can ever be contested, so this is what lets
		// `settleGenericAliasContest` cost nothing at all for a program with none.
		if self.mainThreadSettled().genericAliases.contains(entry.aliasName) 'anotherDeclarationAlreadyMentionsThisName'
			let names = self.disagreeingAliasNamesForWrite()
			names.insert(entry.aliasName)
		end 'anotherDeclarationAlreadyMentionsThisName'

		self.mainThreadSettled().genericAliases.upsert(entry.aliasName, value: giid)

		// ⭐ The retained copy carries the instance THIS declaration interned to — see
		// `GenericAliasEntry.sweptInstance` for why the bare map above cannot answer that question for the
		// names that need it answered.
		self.mainThreadSettled().genericAliasDecls.push(entry.recorded(giid))

		// ⭐ The ELEMENT SPELLING — the one fact `giid` structurally cannot carry, since
		// `Array with __ManagedMemory` and `Array with ByteArray` intern to the identical instance. Recorded
		// beside the instance it belongs to, so an alias cannot end up in one table and not the other.
		if entry.elementIsBuffer 'elementNamesTheBuffer'
			self.mainThreadSettled().bufferElementAliases.insert(entry.aliasName)
		end 'elementNamesTheBuffer'

		// ⭐ The BASE SPELLING — the same fact one position up, filed beside the instance for the same
		// reason: `__ManagedMemory with T` and `Array with T` intern identically, so only this can say which
		// surface a value declared with this alias wears.
		if entry.baseIsBuffer 'baseNamesTheBuffer'
			self.mainThreadSettled().bufferSurfaceAliases.insert(entry.aliasName)
		end 'baseNamesTheBuffer'

		// Record the instantiation SITE for the E3017 where-constraint check — only when the
		// alias carries a real source anchor (a top-level `typealias X = Base with Args`; a synthesized alias
		// has none). The `giid` + anchor is all the check needs: the base's constraints and the substituted args
		// are read off `giid`.
		match entry.anchor 'anchor'
			unanchored then break
			declaredAt(nameLine, nameColumn, _, _) then self.mainThreadSettled().genericAliasSites.push(GenericInstantiationSite.create(giid, nameLine: nameLine, nameColumn: nameColumn, filePath: entry.filePath))
		end 'anchor'

		// The alias name, its base name, its ELEMENT SPELLING and each arg's SHAPE ride the hash — a change to
		// any of them changes what a `IntBox.create(…)` in another file resolves and type-checks against, and
		// the spelling is the one `mixType` cannot carry (both arguments fold to one `genericInstance`).
		// ⭐ The SIZE rides for the element spelling's exact reason: it is half of the instance's identity and
		// `mixType` cannot carry it (`FixedArray with 3 Int` and `FixedArray with 4 Int` fold to the same base name and
		// the same one argument), so an edit from 3 to 4 would change what every `Vec3.create()` in another
		// file compiles to while this declaration's hashed bytes never moved.
		// ⭐ The BASE SPELLING rides in the SAME word, for the element spelling's exact reason: it decides
		// the member SURFACE every declared position naming this alias wears, and `mixType` cannot carry it —
		// `__ManagedMemory with T` and `Array with T` fold to one `genericInstance`. A separate bit rather than
		// a second fold, so a declaration that changes only its base's SPELLING still moves the hash.
		let sizeBits = entry.shape.hashWord()
		var state = mixDeclaringTier(Hasher.combined(Hasher.combined(mixBytes(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeGenericAlias), bytes: entry.aliasName), bytes: entry.baseName), value: entry.spellingBits() as HashDigest), value: sizeBits), visibility: entry.visibility, declFilePath: entry.filePath)

		for arg in args 'eachHash'
			state = self.mixType(state, t: arg)
		end 'eachHash'

		self.hash = state
	end 'recordGenericAlias'

	// ⭐⭐ **RECORD ONE `interface` BODY'S GENERIC-INSTANCE TYPEALIASES** — `recordGenericAlias`'s twin,
	// differing in exactly two things and in nothing else: the entries land in `interfaceAliases` rather than
	// `genericAliases` (see that field for the ruling), and they do NOT ride the content hash.
	//
	// ⚠ **THEY DO NOT RIDE THE HASH BECAUSE NO PARSE COPIES THEM** — docs/internals/query-spine.md's
	// "MIX WHAT A READER COPIES" rule. The index's hash keys every parse memo, and a requirement's rendered
	// parameter type is `Holder.ElementArray` whether this map holds the alias or not; the ONE consumer is
	// `checkConformance`, which runs on the merged project on every compile and memoizes nothing. Mixing it
	// would re-parse the whole program whenever an interface edited a private shorthand, which is the
	// "sound, and useless" pessimal key the query spine's header names.
	//
	// It takes the reader's own interner rather than a `TypeIdRemap` because the FOLD, unlike `foldFile`,
	// has no remap in hand: `foldInterfaceDeclarations` builds one reader per FILE and seats it at each site,
	// so the fold is per DECLARATION and the interner is the file's. The fold is skipped entirely for an
	// interface that declares no such alias — every interface in the corpus but a handful — so the walk of
	// the reader's interner is paid only where there is something to remap.
	export function recordInterfaceAliases(entries GenericAliasEntryArray, interfaceName ByteArray, fileTypeNames TypeNameInterner)
		if entries.count() == 0 'declaresNone'
			return
		end 'declaresNone'

		self.mainThreadSettled().interfaceAliasOwners.insert(interfaceName)
		let remap = self.typeNames.foldInto(fileTypeNames)

		for entry in entries 'eachAlias'
			let baseId = self.typeNames.intern(entry.baseName)
			let args = self.resolveGenericArgs(entry, remap: remap)
			self.mainThreadSettled().interfaceAliases.upsert(entry.aliasName, value: self.internRow(baseId, args: args, shape: entry.shape))
		end 'eachAlias'
	end 'recordInterfaceAliases'

	export function recordGenericWithSites(sites GenericWithSiteArray)
		self.mainThreadSettled().genericWithSites.append(sites)
	end 'recordGenericWithSites'

	// Does the program declare ANY interface-scoped generic-instance typealias? The whole-program gate the
	// conformance check gets its fast path from: a program with none — every program in the corpus outside
	// `stdlib/Builtins.maxon` and the interface-scoped alias cases — can have no requirement to expand, so the check never
	// asks a second question.
	export function declaresInterfaceAliases() returns bool
		return self.settledDeclarations().interfaceAliases.count() != 0
	end 'declaresInterfaceAliases'

	// ⭐ **AND THE SAME QUESTION OF ONE INTERFACE — the gate that keeps the whole-program bool above from
	// being the whole answer.** `stdlib/Builtins.maxon` declares `InitableFromArrayLiteral`'s
	// `typealias ElementArray`, so the program-wide bool is TRUE for every program that loads the stdlib,
	// which is every program: used alone it would put every conformance in the corpus back on the
	// substituting path. Asked per DECLARING interface it is exact — a requirement can only spell an alias
	// its own interface declared — and it is a set membership rather than an allocation.
	export function interfaceDeclaresAlias(name ByteArray) returns bool
		return self.settledDeclarations().interfaceAliasOwners.contains(name)
	end 'interfaceDeclaresAlias'

	export function expandedInterfaceAliasDisplay(qualifiedName ByteArray, associatedTypeNames NameRoster, boundSpellings NameRoster, declaringInterfaceName ByteArray) returns immutable ByteArray throws MapError
		let id = try self.interfaceAliasInstanceOf(qualifiedName)
		return self.substitutedInstanceName(id, associatedTypeNames: associatedTypeNames, boundSpellings: boundSpellings, declaringInterfaceName: declaringInterfaceName)
	end 'expandedInterfaceAliasDisplay'

	function substitutedInstanceName(id GenericInstanceId, associatedTypeNames NameRoster, boundSpellings NameRoster, declaringInterfaceName ByteArray) returns immutable ByteArray
		let instanceArgs = self.rowArgs(id)
		let args = StringArray.create(instanceArgs.count(), zeroed: false)

		for (iter, arg) in instanceArgs.withIterator() 'eachArg'
			args.push("{self.frozenArgMarker(id, position: iter.index(), form: InstanceNameForm.written)}{self.substitutedArgName(arg, associatedTypeNames: associatedTypeNames, boundSpellings: boundSpellings, declaringInterfaceName: declaringInterfaceName)}")
		end 'eachArg'

		return self.writtenInstanceTextOver(self.instanceNameStem(id), args: args)
	end 'substitutedInstanceName'

	function writtenInstanceTextOver(stem String, args StringArray) returns immutable ByteArray
		var out = "{stem} with "
		let parenthesized = args.count() != 1 or self.soleArgIsAnInstance(args)

		if parenthesized 'openTheParen'
			out.append("(")
		end 'openTheParen'

		out.append(joinedWith(args, separator: TypeArgumentSeparator))

		if parenthesized 'closeTheParen'
			out.append(")")
		end 'closeTheParen'

		return freeze out.toByteArray()
	end 'writtenInstanceTextOver'

	function soleArgIsAnInstance(args StringArray) returns bool
		let sole = try args.get(0) otherwise panic("ProgramSignatures.soleArgIsAnInstance: get(0) on an argument list whose count was just read as one")
		return sole.contains(WrittenInstanceMarker)
	end 'soleArgIsAnInstance'

	function substitutedArgName(arg MaxonType, associatedTypeNames NameRoster, boundSpellings NameRoster, declaringInterfaceName ByteArray) returns String
		if maxonTypeTag(arg) == ValueTypeTag.typeParameter 'maybeAnAssociatedType'
			if let position = try typeParamPositionIn(typeParamIdOf(arg), declarationName: declaringInterfaceName, paramNames: associatedTypeNames) 'oneOfTheDeclarersOwn'
				return self.aliasIdentityDisplay(try boundSpellings.get(position) otherwise panic("substitutedArgName: boundSpellings.get OOB at {position} — it is built parallel to associatedTypeNames, which is the list that position was just read out of"))
			end 'oneOfTheDeclarersOwn'
		end 'maybeAnAssociatedType'

		if maxonTypeTag(arg) == ValueTypeTag.genericInstance 'aNestedInstance'
			return String.from(self.substitutedInstanceName(genericInstanceIdOf(arg), associatedTypeNames: associatedTypeNames, boundSpellings: boundSpellings, declaringInterfaceName: declaringInterfaceName))
		end 'aNestedInstance'

		return String.from(self.displayedTypeArgName(arg, spelling: InstanceArgSpelling.asWritten))
	end 'substitutedArgName'

	export function interfaceAliasInstanceOf(qualifiedName ByteArray) returns GenericInstanceId throws MapError
		return try self.settledDeclarations().interfaceAliases.get(qualifiedName)
	end 'interfaceAliasInstanceOf'

	// Resolve an alias entry's flat pre-order arg tree to concrete `MaxonType`s in THIS index's
	// interner — interning nested instances DEPTH-FIRST. A leaf remaps its file-interner type through
	// `remap`; a nested instance header resolves its own args (advancing the shared cursor), interns
	// the instance, and yields `genericInstance(gid)`. The top-level list starts a FRESH cursor; a
	// nested instance shares its parent's, so both walk the flat tree through the one `resolveArgList`
	// loop.
	function resolveGenericArgs(entry GenericAliasEntry, remap TypeIdRemap) returns MaxonTypeArray
		let cursor = ArgCursor.create()
		return self.resolveArgList(entry.args, count: entry.argCount, cursor: cursor, remap: remap)
	end 'resolveGenericArgs'

	// Resolve `count` consecutive pre-order arg nodes from `nodes` at `cursor`, advancing it past each — the
	// ONE loop the top-level alias args and a nested instance's args share (they differ only in whether the
	// cursor is fresh or their parent's). A nested instance is interned before the outer arg that holds it.
	function resolveArgList(nodes GenericArgNodeArray, count FieldIndex, cursor ArgCursor, remap TypeIdRemap) returns MaxonTypeArray
		let out = MaxonTypeArray.create(count, zeroed: false)

		for _ in 0 upto count 'each'
			out.push(self.resolveArgNode(nodes, cursor: cursor, remap: remap))
		end 'each'

		return out
	end 'resolveArgList'

	function resolveArgNode(nodes GenericArgNodeArray, cursor ArgCursor, remap TypeIdRemap) returns MaxonType
		let node = try nodes.get(cursor.pos) otherwise panic("ProgramSignatures.resolveArgNode: cursor {cursor.pos} out of range for a {nodes.count()}-node arg tree — the pre-order flattening and its counts disagree")
		cursor.pos = cursor.pos + 1
		return match node 'k'
			leaf(argType) gives self.canonicalInstanceArg(remapMaxonType(argType, remap: remap))
			instanceHeader(baseName, argCount, shape) gives self.internNestedNode(baseName, argCount: argCount, shape: shape, nodes: nodes, cursor: cursor, remap: remap)
		end 'k'
	end 'resolveArgNode'

	function internNestedNode(baseName ByteArray, argCount FieldIndex, shape InstanceShape, nodes GenericArgNodeArray, cursor ArgCursor, remap TypeIdRemap) returns MaxonType
		let baseId = self.typeNames.intern(baseName)
		let args = self.resolveArgList(nodes, count: argCount, cursor: cursor, remap: remap)
		return MaxonType.genericInstance(self.internRow(baseId, args: args, shape: shape))
	end 'internNestedNode'

	// Fold one case's NAME, TAG and PAYLOAD SLOTS into the enum's hash. Split out so the SIGNED tag
	// (`FullRangeInt`) crosses to the UNSIGNED hash domain through a local — `recordAlias`/`mixDefaultLiteral`
	// have the same two lines for the same reason (a cast written inline as a nested `Hasher.combined`
	// argument draws a false E3010, unneeded cast).
	function mixEnumCase(state HashDigest, layout EnumLayout, index CaseIndex) returns HashDigest
		let named = mixBytes(state, bytes: layout.caseNameAt(index))
		let tagBits = layout.tagOfIndex(index) as HashDigest
		var folded = Hasher.combined(named, value: tagBits)

		// ⚠ **A RAW VALUE THE TAG DOES NOT CARRY MUST RIDE SEPARATELY** — `a = "x"` and `a = "y"` fold to the
		// identical name + tag + backing, which is the same blind spot the backing discriminator above exists
		// for, one column further in. Where the tag IS the raw value it is already mixed on the line above, so
		// nothing more is owed. WHICH column holds it is `EnumLayout.rawValueIdentity`'s single answer, not a
		// second `== EnumBacking.string` test that a later backing could silently fall past — and the third
		// answer is the reason that classifier is not a bool: a struct backing's per-case value lives in
		// `caseBackingFields`, so `rawValueAt` cannot carry it.
		//
		// ⚠ **`rawValueAt` FOR A STRUCT-BACKED CASE IS NOT EMPTY — IT IS THE STRUCT'S NAME**
		// (`Parser.appendStructBackedEnumCase` writes `String.from(typeTok.value)`), and an earlier draft of
		// this comment said it was empty and used that as the reason for skipping it. The reason is the one
		// above; and because the struct's name is a per-DECLARATION fact rather than a per-case one, it is
		// mixed once by `recordEnum` instead of once per case here.
		match layout.rawValueIdentity() 'identity'
			theTag then break
			recordedText then folded = mixBytes(folded, bytes: layout.rawValueAt(index).toByteArray())
			incomparable then folded = self.mixEnumBackingFields(folded, layout: layout, index: index)
		end 'identity'

		for field in layout.payloadsAt(index) 'eachSlot'
			folded = self.mixPayloadField(folded, field: field)
		end 'eachSlot'

		return folded
	end 'mixEnumCase'

	// ⭐ **FOLD A CASE'S CONSTANT STRUCT BACKING IN — `mixPayloadField`'s twin for the one backing whose value
	// lives in a column of its own.** The struct's NAME rides once per DECLARATION, mixed by `recordEnum`
	// beside the backing discriminator (see there), so what is owed here is per case: each entry's written
	// label, its POSITION, its GROUP and its value.
	//
	// ⚠ **THE POSITION AND THE GROUP RIDE EXPLICITLY, BECAUSE FOLDING ONLY THE ORDER IS A COLLISION.**
	// A case's entries are a TREE held flat (`EnumBackingField`), so the position is not the entry's place in
	// this array: `Outer.create(Inner.create(1), flag: true)` and a shape whose two entries sit in the other
	// group write the same labels and the same numbers in the same order and mean different things.
	function mixEnumBackingFields(state HashDigest, layout EnumLayout, index CaseIndex) returns HashDigest
		var folded = state

		for field in layout.backingFieldsAt(index) 'eachField'
			let slotted = Hasher.combined(folded, value: SignatureDiscriminator.enumBackingFieldSlot)
			let labelled = mixBytes(slotted, bytes: field.name)
			let placed = Hasher.combined(Hasher.combined(labelled, value: field.position as HashDigest), value: field.group as HashDigest)

			match field.value 'value'
				// The literal's KIND rides beside its bits: `1` and `1.0` are different declarations that fold
				// to the same `FullRangeInt` (`floatLiteralBits(0.0)` is 0), and they type-check differently.
				literal(bits, kind) then folded = Hasher.combined(Hasher.combined(placed, value: bits as HashDigest), value: enumBackingLiteralDiscriminator(kind))
				enumCase(enumName, caseName) then folded = mixBytes(mixBytes(Hasher.combined(placed, value: SignatureDiscriminator.enumBackingFieldEnumCase), bytes: enumName), bytes: caseName)

				// The nested struct's own NAME, because it is checked against the field's declared type and a
				// case naming a different one is a different declaration (`enumBackingNamedValueSuitsDomain`).
				// Its constants ride as the entries of the group it owns, folded by this same loop.
				nestedStruct(structName) then folded = mixBytes(Hasher.combined(placed, value: SignatureDiscriminator.enumBackingFieldNestedStruct), bytes: structName)
			end 'value'
		end 'eachField'

		return folded
	end 'mixEnumBackingFields'

	// ⭐ **FOLD ONE PAYLOAD SLOT IN — `mixField`'s twin, and it rides for `recordStruct`'s rule.**
	// A reading file COPIES a payload's declared type into its own code: the `match` binding's load width, its
	// ownership class (moved out, retained, or a scalar copy), and whether the slot is a nested union at all
	// are all read off it (`classifyUnionPayload`). So editing `mem(m Bytes)` to `mem(m String)` changes what
	// every other file COMPILES TO while that file's own bytes never move — the exact staleness the case list
	// already rides for, one column further in, and the case NAME and TAG alone could not carry it.
	//
	// ⚠ **AND THE SPELLING RIDES BESIDE THE TYPE, for `fieldShapeSurface`'s reason**:
	// `__ManagedMemory` and `ByteArray` fold to the identical `genericInstance` through `mixType`, while a
	// binding destructured out of the two reaches a different member roster.
	function mixPayloadField(state HashDigest, field PayloadField) returns HashDigest
		let named = self.mixType(mixBytes(Hasher.combined(state, value: SignatureDiscriminator.payloadShapeSlot), bytes: field.name), t: field.declaredType)
		let surfaced = mixSurface(Hasher.combined(named, value: SignatureDiscriminator.payloadShapeSurface), surface: field.declaredSurface)
		return Hasher.combined(surfaced, value: field.capability.ordinal as HashDigest)
	end 'mixPayloadField'

	// Fold EVERYTHING the compiler reads off field `index` into the index's hash. See `recordStruct`
	// for why each fact must ride, and why they must all ride from one place.
	function mixField(state HashDigest, layout StructLayout, index FieldIndex) returns HashDigest
		let fieldName = try layout.fieldNames.get(index) otherwise panic("ProgramSignatures.mixField: fieldNames.get OOB at {index}")
		let fieldType = try layout.fieldTypes.get(index) otherwise panic("ProgramSignatures.mixField: fieldTypes.get OOB at {index} — the field columns fell out of lockstep")

		let named = self.mixType(mixBytes(state, bytes: fieldName), t: fieldType)
		let withMutability = Hasher.combined(named, value: SignatureDiscriminator.fieldShapeMutable if layout.fieldIsMutable(index) else SignatureDiscriminator.fieldShapeImmutable)

		// The declared SPELLING — the one fact here `mixType` structurally cannot carry, since
		// `__ManagedMemory` and `ByteArray` fold to the identical `genericInstance`. See `fieldShapeSurface`.
		let withSpelling = mixSurface(Hasher.combined(withMutability, value: SignatureDiscriminator.fieldShapeSurface), surface: layout.fieldDeclaredSurface(index))
		let withCapability = Hasher.combined(withSpelling, value: layout.fieldTypeSites.capabilityAt(index).ordinal as HashDigest)
		return self.mixFieldDefault(withCapability, defaultValue: layout.fieldDefault(index))
	end 'mixField'

	// The DEFAULT half of `mixField`. `none` mixes its own shape rather than nothing: a field that
	// gained a default must hash differently from one that never had it, and `= 0` on a field whose
	// payload would otherwise fold to the same 0 is exactly the collision that would hide it.
	// ⭐⭐ **THE HELPER ARM MIXES ITS PRESENCE AND NOTHING ELSE, AND THAT IS THE `recordParamDefaults`
	// RULING APPLIED VERBATIM.** What a READER of `type Bag` copies out of an expression default is
	// exactly one thing — `call __fieldDefault#Bag#items` — and those bytes are byte-identical whether the
	// default is `IntArray.create(4)` or `IntArray.create(8, zeroed: false)`. The expression itself reaches only the
	// DECLARING file's own helper body, which re-parses on that file's own content hash. So mixing it would
	// be sound and WRONG: every keystroke inside any default would re-parse the whole program.
	//
	// ⚠ The two facts a reader DOES depend on both ride already, and neither needs an arm here: the helper's
	// NAME is `(type name, field name)`, both mixed by `mixField`/`recordStruct` above; and its RETURN TYPE
	// is the field's declared type, mixed by `mixField`'s own `mixType`. What is left is the presence BIT —
	// a field that gained an expression default must hash differently from one with none and from one with
	// a literal — which is this constant.
	function mixFieldDefault(state HashDigest, defaultValue FieldDefault) returns HashDigest
		return match defaultValue 'shape'
			none gives Hasher.combined(state, value: SignatureDiscriminator.fieldShapeNoDefault)
			literal(given) gives self.mixDefaultLiteral(state, given: given)
			helper gives Hasher.combined(state, value: SignatureDiscriminator.fieldShapeDefaultHelper)
			emptyCreateHelper gives Hasher.combined(state, value: SignatureDiscriminator.fieldShapeDefaultEmptyCreate)
		end 'shape'
	end 'mixFieldDefault'

	// The literal half of a defaulted field's hash. Split from `mixFieldDefault` so the payload
	// arrives as a bound PARAMETER: it is SIGNED (`FullRangeInt` — and a float default's is a bit
	// pattern that routinely has its top bit set) while the hash domain is unsigned, so it crosses
	// by an explicit cast, and that cast needs a local. `recordAlias` has the same two lines for the
	// same reason: written inline as an argument to a nested `Hasher.combined`, the cast draws a
	// false E3010 (unneeded cast), which costs nothing to route around.
	//
	// ⚠ **THE TAG RIDES, AND THE PAYLOAD ALONE WOULD NOT CARRY IT.** A default is stored as the source
	// wrote it and widened only when it fills a slot (`Parser.fillFieldDefault`), so the tag is a real
	// input to what a reader compiles to — and it is the one input the payload cannot stand in for:
	// `= 0` and `= 0.0` have the SAME `FullRangeInt` (zero is the one fixed point of int→f64 bits) and
	// differ only here. Hashing the pair keeps a memo from surviving an edit between them.
	//
	// It rides through `mixValueTag`, the door a top-level constant's tag already uses, and NOT through
	// the enum's ordinal — see the shape constants' own header: an ordinal is not a value in Maxon, and a
	// hash that moved when `ValueTypeTag`'s arms were REORDERED would invalidate every parse memo in the
	// project for a change that means nothing.
	// ⚠ **`writtenNegative` and `aboveSignedMax` RIDE FOR THE TAG'S OWN REASON, and the payload cannot
	// stand in for them either:** `= -1` and `= 0xFFFFFFFFFFFFFFFE` store the SAME KIND of negative
	// `FullRangeInt` and differ only in what the source wrote, which is what decides whether the default
	// fits an `int(0 to u64.max)` field (`FieldDefault.literal`). Editing one spelling into the other
	// must invalidate the memo, so the marks are mixed.
	function mixDefaultLiteral(state HashDigest, given ConstValue) returns HashDigest
		let payloadBits = given.payload as HashDigest
		let sign = SignatureDiscriminator.fieldDefaultWrittenNegative if given.writtenNegative else SignatureDiscriminator.fieldDefaultWrittenAboveSignedMax if given.aboveSignedMax else SignatureDiscriminator.fieldDefaultWrittenPlain

		// The ConstValue's `typeName` is not mixed: a field default's literal never carries one.
		return Hasher.combined(Hasher.combined(self.mixValueTag(Hasher.combined(state, value: SignatureDiscriminator.fieldShapeDefaulted), tag: given.tag, typeName: EmptySourceText), value: payloadBits), value: sign)
	end 'mixDefaultLiteral'

	// Add one ranged typealias to the index AND fold it into the hash. The hash carries the RANGE
	// and not merely the name, and that is load-bearing: widening `int(0 to 100)` to
	// `int(0 to u64.max)` makes the type UNSIGNED, which changes what every `shr` on it MEANS. Every
	// file must re-parse on that edit, and this is what makes it happen.
	function recordAlias(alias RangedTypeAlias)
		// The collision outcome is DISCARDED here on purpose: E3061 is raised once, at
		// the merge (`commitTypeAliases`), which is the whole-program drain that owns
		// `project.diagnostics`. Reporting from the pre-parse sweep as well would double every
		// diagnostic — the sweep and the merge both see every declaration. The sweep still calls
		// `record` rather than a plain upsert so that THIS registry and the project's are built by one
		// function: a sweep that filed declarations differently would resolve a contested name
		// differently from the merge, which is the divergence file scoping exists to remove.
		self.mainThreadSettled().typeAliases.record(alias)

		// The bounds are SIGNED (`FullRangeInt`) and the hash domain is UNSIGNED, so each crosses by an
		// explicit cast. Bound to locals rather than written inline: as arguments to a nested
		// `Hasher.combined` the casts draw a false E3010 (unneeded cast), which costs nothing to route
		// around.
		let low = alias.low as HashDigest
		let high = alias.high as HashDigest

		// ⭐ **VISIBILITY RIDES FOR THE RANGE'S OWN REASON**:
		// widening a range changes what a `shr` on a value of the alias means, and adding or removing
		// `export` changes whether ANOTHER file may name it at all (E3008,
		// `Parser.bareTypeNameVerdict`) and whether this file's own declaration can be reported unused
		// (E3062, `recordTypeName`). Both are decisions a memoized parse of a DIFFERENT file bakes in, so
		// both must move its memo key.
		//
		// ⚠ **THE WHOLE TIER, NOT ONE BIT.** `export typealias Score` vs `public typealias Score` is a
		// different answer to the unused-export audit, so the tiers must key different parses. The ordinal is
		// used rather than a bit because it is what a tier IS; a new case rides automatically.
		let named = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeAlias), bytes: alias.name)
		self.hash = mixDeclaringTier(Hasher.combined(Hasher.combined(named, value: low), value: high), visibility: alias.visibility, declFilePath: alias.declFilePath)
	end 'recordAlias'

	// Add one INNER ranged typealias under its BASE-QUALIFIED name AND fold it into the hash —
	// `recordAlias`'s twin. The RANGE rides for `recordAlias`'s reason (widening changes what a `shr` on a
	// value of the alias means), and the qualified name rides so that a rename or a new inner alias moves
	// every reader's parse memo — `Instance.Idx` resolves and type-checks against this in any file. The
	// stored `RangedTypeAlias.name` stays the BARE member (`Idx`); the key is `base.member`.
	function recordInnerAlias(baseName ByteArray, alias RangedTypeAlias)
		let qualified = joinQualifiedName(baseName, member: alias.name)
		self.mainThreadSettled().innerAliases.upsert(qualified, value: alias)

		// Bound to locals for `recordAlias`'s reason (the E3010 false positive on an inline cast).
		let low = alias.low as HashDigest
		let high = alias.high as HashDigest

		let named = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeInnerAlias), bytes: qualified)
		self.hash = mixDeclaringTier(Hasher.combined(Hasher.combined(named, value: low), value: high), visibility: alias.visibility, declFilePath: alias.declFilePath)
	end 'recordInnerAlias'

	// ⭐ **NOTE THAT AN `extension` BODY DECLARES A PER-INSTANCE NESTED `typealias` CALLED `qualified`** — see
	// `extensionInnerAliasMembers`. NAMES ONLY: the declaration itself is recorded a moment later by
	// `Parser.foldExtensionDeclarationInto`, through `recordInnerAlias` / `recordGenericAlias` /
	// `recordTupleAlias` like every other nested alias, so nothing about what the name MEANS is decided here.
	//
	// ⚠ It folds NOTHING into `self.hash`, and that is not an omission. The hash keys the parse memo on the
	// program's declarations, and this set is a pure function of tokens the three recorders above already mix
	// in under the same qualified name — the same declaration, seen one pass earlier. A second mix would key
	// the memo twice on one fact.
	export function recordExtensionInnerAliasMember(qualified ByteArray)
		if self.mainThreadSettled().extensionInnerAliasMembers.contains(qualified) 'alreadyNoted'
			return
		end 'alreadyNoted'

		self.requireBeforeTheBaseline("recordExtensionInnerAliasMember")
		self.mainThreadSettled().extensionInnerAliasMembers.insert(qualified)
	end 'recordExtensionInnerAliasMember'

	export function recordExtensionInnerAliasKeeper(qualified ByteArray, site ExtensionInnerAliasSite)
		self.requireBeforeTheBaseline("recordExtensionInnerAliasKeeper")

		if let keeper = try self.settledDeclarations().extensionInnerAliasKeepers.get(qualified) 'anEarlierDeclaration'
			if site.compare(keeper) != Ordering.lessThan 'theKeeperPrecedes'
				return
			end 'theKeeperPrecedes'
		end 'anEarlierDeclaration'

		self.mainThreadSettled().extensionInnerAliasKeepers.upsert(qualified, value: site)
	end 'recordExtensionInnerAliasKeeper'

	export function extensionInnerAliasKeeper(qualified ByteArray) returns ExtensionInnerAliasSite throws MapError
		return try self.settledDeclarations().extensionInnerAliasKeepers.get(qualified)
	end 'extensionInnerAliasKeeper'

	export function recordTypeBodyInnerAliasMember(qualified ByteArray)
		if self.mainThreadSettled().typeBodyInnerAliasMembers.contains(qualified) 'alreadyNoted'
			return
		end 'alreadyNoted'

		self.requireBeforeTheBaseline("recordTypeBodyInnerAliasMember")
		self.mainThreadSettled().typeBodyInnerAliasMembers.insert(qualified)
	end 'recordTypeBodyInnerAliasMember'

	export function typeBodyDeclaresInnerAlias(qualified ByteArray) returns bool
		return self.settledDeclarations().typeBodyInnerAliasMembers.contains(qualified)
	end 'typeBodyDeclaresInnerAlias'

	export function noteExtensionInnerAliasTier(qualified ByteArray, library bool)
		self.requireBeforeTheBaseline("noteExtensionInnerAliasTier")

		if self.typeBodyDeclaresInnerAlias(qualified) 'theTypesOwnMemberWins'
			return
		end 'theTypesOwnMemberWins'

		if library 'aLibrarySite'
			self.mainThreadSettled().libraryExtensionInnerAliasMembers.insert(qualified)

			if self.settledDeclarations().authorExtensionInnerAliasMembers.contains(qualified) 'theAuthorDeclaresItToo'
				self.mainThreadSettled().authorShadowedInnerAliases.insert(qualified)
			end 'theAuthorDeclaresItToo'

			return
		end 'aLibrarySite'

		self.mainThreadSettled().authorExtensionInnerAliasMembers.insert(qualified)

		if self.settledDeclarations().libraryExtensionInnerAliasMembers.contains(qualified) 'theLibraryDeclaresItToo'
			self.mainThreadSettled().authorShadowedInnerAliases.insert(qualified)
		end 'theLibraryDeclaresItToo'
	end 'noteExtensionInnerAliasTier'

	// The member name under which a body files and reads `member`. A program's extension member that a library
	// extension also declares for `owner` is a separate member with a minted name, so a library body, which
	// never takes the mint, keeps the library's declaration. A body in the corpus, and a reader outside an
	// extension body, always get `member` itself.
	export function innerAliasMemberFor(owner ByteArray, member immutable ByteArray, inExtensionBody bool, readerPath FilePath) returns immutable ByteArray
		if not inExtensionBody or self.settledDeclarations().authorShadowedInnerAliases.count() == 0 'notAnExtensionOrNothingShadowed'
			return member
		end 'notAnExtensionOrNothingShadowed'

		if not self.settledDeclarations().authorShadowedInnerAliases.contains(joinQualifiedName(owner, member: member)) or self.declaredByTheCorpus(readerPath) 'notShadowedForThisReader'
			return member
		end 'notShadowedForThisReader'

		return qualifiedMintName(member, qualifier: AuthorExtensionMemberQualifier)
	end 'innerAliasMemberFor'

	function requireBeforeTheBaseline(site String)
		if self.baseline.settled 'pastTheBaseline'
			panic("ProgramSignatures.{site}: the baseline is settled, so the declarations every parse reads are shared and frozen and no parse may add to them")
		end 'pastTheBaseline'
	end 'requireBeforeTheBaseline'

	// ⭐⭐ **NOTE THAT THE SWEEP DROPPED `name`'s SIGNATURE, AND WHERE THE DECLARATION IS** — see
	// `DroppedSignature`. It folds nothing into `self.hash` for `recordExtensionInnerAliasMember`'s reason and
	// a sharper one of its own: the hash keys a parse memo on the PROGRAM's declarations, and what this records
	// is a failure of the COMPILER to read one.
	export function recordDroppedSignature(name ByteArray, dropped DroppedSignature)
		self.mainThreadSettled().droppedSignatures.upsert(name, value: dropped)
	end 'recordDroppedSignature'

	// Did the sweep drop ANY signature? The gate every reader of the record opens with, so a healthy compile —
	// which is every compile in the corpus — pays one emptiness test and no lookups.
	export function hasDroppedSignatures() returns bool
		return self.settledDeclarations().droppedSignatures.count() > 0
	end 'hasDroppedSignatures'

	// The declaration whose signature the sweep dropped under `name`, or `none`.
	export function droppedSignatureOf(name ByteArray) returns DroppedSignatureLookup
		let record = try self.settledDeclarations().droppedSignatures.get(name) otherwise return DroppedSignatureLookup.none
		return DroppedSignatureLookup.dropped(record)
	end 'droppedSignatureOf'

	// ⭐⭐ **NOTE ONE FREE-FUNCTION DECLARATION, AND ANSWER WHAT THE FOLD OWES IT.**
	//
	// **THE RULE THIS IMPLEMENTS:** a function name is declared once per directory. Two declarations of one
	// bare name in DIFFERENT directories are both accepted, and each outside the root is registered under its
	// own `<directory>~name` mint (`freeFunctionRegistrationName`); the root keeps the bare name. Two in the
	// SAME directory keep the bare name and collide (`commitFuncSignatures`, E3006), which includes a pair at
	// the root, because the root is one directory.
	//
	// ⚠ **IT IS DECIDED ON MODULE DIRECTORIES AND NEVER ON RENDERED NAMESPACES**:
	// `namespaceForModuleDirectory` is not injective (`my/dir` and `my.dir` both render `my.dir`), so a
	// contest decided on the rendered form would merge two structurally different directories into one
	// namespace.
	//
	// ONLY a contested name is qualified. Qualifying EVERY free function's key with its namespace
	// would give the identical acceptance and the identical refusals while renaming every symbol in
	// every namespaced file; leaving an uncontested function registered under exactly the bytes it had
	// buys that for nothing.
	function noteFreeFunctionDeclaration(bareName ByteArray, moduleDirectory String) returns FreeFunctionContest
		self.noteDeclaredName(bareName)

		if self.mainThreadSettled().contestedFreeFunctions.contains(bareName) 'alreadyContested'
			self.addContestedDirectory(bareName, moduleDirectory: moduleDirectory)
			return FreeFunctionContest.alreadyContested
		end 'alreadyContested'

		let incumbentDirectory = try self.mainThreadSettled().freeFunctionDirectories.get(bareName) otherwise 'firstDeclarationOfThisName'
			self.mainThreadSettled().freeFunctionDirectories.upsert(bareName, value: moduleDirectory)
			return FreeFunctionContest.uncontested
		end 'firstDeclarationOfThisName'

		if incumbentDirectory.equals(moduleDirectory) 'sameDirectoryIsAnOrdinaryDuplicate'
			return FreeFunctionContest.uncontested
		end 'sameDirectoryIsAnOrdinaryDuplicate'

		self.addContestedDirectory(bareName, moduleDirectory: incumbentDirectory)
		self.addContestedDirectory(bareName, moduleDirectory: moduleDirectory)

		return FreeFunctionContest.newlyContested(freeFunctionRegistrationName(bareName, moduleDirectory: incumbentDirectory))
	end 'noteFreeFunctionDeclaration'

	function addContestedDirectory(bareName ByteArray, moduleDirectory String)
		let holderKey = directoryNameKey(bareName, directory: moduleDirectory)
		let declaredBefore = self.mainThreadSettled().functionDirectoryHolders.contains(holderKey)
		let directories = try self.mainThreadSettled().contestedFreeFunctions.get(bareName) otherwise StringArray.create(0)
		self.mainThreadSettled().functionDirectoryHolders.upsert(holderKey, value: holderAfterNoting(self.mainThreadSettled().functionDirectoryHolders, key: holderKey, index: directories.count()))

		if not declaredBefore 'aNewDirectory'
			directories.push(moduleDirectory)
		end 'aNewDirectory'

		self.mainThreadSettled().contestedFreeFunctions.upsert(bareName, value: directories)
	end 'addContestedDirectory'

	// Is this bare name declared as a free function in more than one directory? The one flag every reader
	// asks — the parser's declaration mint, its call doors, and `SemanticCheck`'s E3095.
	export function isContestedFreeFunction(bareName ByteArray) returns bool
		return self.settledDeclarations().contestedFreeFunctions.contains(bareName)
	end 'isContestedFreeFunction'

	// ⭐⭐ **THE DECLARATION A FUNCTION NAME WRITTEN IN `readerFilePath` MEANS** — the one resolver every door an
	// author's function name arrives through asks: a bare call, a function value, a function-backed enum case, the
	// close that follows a fresh-return forward, and E3095's report.
	//
	// A directory-qualified name (`beta.helper`) is the route `resolvesAsNamespaceQualifiedFunction` admits. A bare
	// name no second directory declares means what it spells, and the ordinary lookups accept or refuse it. A
	// contested bare name resolves in tiers, each over only the declarations the reader may name: the reader's
	// own directory, then the root (the unqualified namespace), then the single visible declaration elsewhere.
	// Two declarations at the nearest tier that holds any are ambiguous (E3095), never broken by position.
	export function resolveFunctionName(written ByteArray, readerFilePath FilePath) returns FunctionNameResolution
		return match splitQualifiedName(written) 'spelling'
			parts(_, member) gives self.resolveQualifiedFunctionName(written, bare: member)
			notQualified gives self.resolveBareFunctionName(written, readerFilePath: readerFilePath)
		end 'spelling'
	end 'resolveFunctionName'

	// The name a bare CALL binds: the one declaration it means, or the name as written when it means several or
	// none, which `SemanticCheck.validateCall` then refuses (E3095, E3004, E3008). The uncontested answer is
	// asked first because every bare call in the program crosses this line, and it allocates nothing.
	export function nameABareCallBinds(bareName immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		return match self.resolveBareFunctionName(bareName, readerFilePath: readerFilePath) 'resolution'
			declaration(name) gives name
			ambiguous or
			undeclared gives bareName
		end 'resolution'
	end 'nameABareCallBinds'

	function resolveBareFunctionName(bareName ByteArray, readerFilePath FilePath) returns FunctionNameResolution
		let directories = try self.settledDeclarations().contestedFreeFunctions.get(bareName) otherwise return FunctionNameResolution.declaration(bareName)
		let readerDirectory = self.moduleDirectoryOf(readerFilePath)

		match nearNameScope(self.functionHoldingIn(bareName, directories: directories, directory: readerDirectory, readerFilePath: readerFilePath), theRoot: self.functionHoldingIn(bareName, directories: directories, directory: NoModuleDirectoryPrefix, readerFilePath: readerFilePath)) 'near'
			held(index, _) then return self.functionDeclaredIn(bareName, directories: directories, at: index)
			vacant or
			contested then break
		end 'near'

		let tally = NameScopeTally.create()

		for (iter, directory) in directories.withIterator() 'eachDirectory'
			tally.note(self.functionDirectoryTier(bareName, directory: directory, readerFilePath: readerFilePath), at: iter.index())
		end 'eachDirectory'

		return match tally.verdict() 'verdict'
			meant(index, _) gives self.functionDeclaredIn(bareName, directories: directories, at: index)
			nowhere gives FunctionNameResolution.undeclared
			ambiguous gives FunctionNameResolution.ambiguous(self.nameableFunctionCandidates(bareName, directories: directories, readerFilePath: readerFilePath))
		end 'verdict'
	end 'resolveBareFunctionName'

	function functionHoldingIn(bareName ByteArray, directories StringArray, directory String, readerFilePath FilePath) returns ScopeHolding
		let holder = try self.settledDeclarations().functionDirectoryHolders.get(directoryNameKey(bareName, directory: directory)) otherwise DirectoryHolder.absent

		return match holder 'holder'
			absent gives ScopeHolding.vacant
			several gives ScopeHolding.contested
			one(index) gives heldIfNameable(index, tier: self.functionDirectoryTier(bareName, directory: self.functionDirectoryAt(bareName, directories: directories, at: index), readerFilePath: readerFilePath))
		end 'holder'
	end 'functionHoldingIn'

	function functionDirectoryAt(bareName ByteArray, directories StringArray, at ElementIndex) returns String
		return try directories.get(at) otherwise panic("ProgramSignatures.functionDirectoryAt: directories.get OOB at {at} of {directories.count()} directories declaring '{String.from(bareName)}', a position the holder index recorded")
	end 'functionDirectoryAt'

	function functionDeclaredIn(bareName ByteArray, directories StringArray, at ElementIndex) returns FunctionNameResolution
		return FunctionNameResolution.declaration(freeFunctionRegistrationName(bareName, moduleDirectory: self.functionDirectoryAt(bareName, directories: directories, at: at)))
	end 'functionDeclaredIn'

	function functionDirectoryTier(bareName ByteArray, directory String, readerFilePath FilePath) returns ScopeTier
		if not self.declaresAFreeFunctionVisibleFrom(freeFunctionRegistrationName(bareName, moduleDirectory: directory), readerFilePath: readerFilePath) 'notNameableHere'
			return ScopeTierHidden
		end 'notNameableHere'

		return tierOfNearness(nearnessOfDirectory(directory, readerDirectory: self.moduleDirectoryOf(readerFilePath)))
	end 'functionDirectoryTier'

	function nameableFunctionCandidates(bareName ByteArray, directories StringArray, readerFilePath FilePath) returns NameRoster
		let candidates = NameRoster.create(0)

		for directory in directories 'eachDirectory'
			if self.functionDirectoryTier(bareName, directory: directory, readerFilePath: readerFilePath) != ScopeTierHidden 'nameableHere'
				candidates.push(freeze qualifiedCandidateName(directory, bare: bareName).toByteArray())
			end 'nameableHere'
		end 'eachDirectory'

		return candidates
	end 'nameableFunctionCandidates'

	function resolveQualifiedFunctionName(written ByteArray, bare ByteArray) returns FunctionNameResolution
		if not self.resolvesAsNamespaceQualifiedFunction(written) 'notADirectoryQualifiedFunction'
			return FunctionNameResolution.undeclared
		end 'notADirectoryQualifiedFunction'

		return FunctionNameResolution.declaration(self.namespaceQualifiedFunctionName(written, bare: bare))
	end 'resolveQualifiedFunctionName'

	// ⭐⭐ **ROUTE OR NAME?** A qualifier is ordinarily a ROUTE and resolves onto the BARE declared name, which keeps
	// `utils.helper()` and `helper()` byte-identical. Once two directories declare the name, each is registered
	// under its own `<directory>~name` mint (`Parser.declaredMethodName`) and the written qualifier selects it.
	export function namespaceQualifiedFunctionName(written ByteArray, bare immutable ByteArray) returns immutable ByteArray
		if not self.isContestedFreeFunction(bare) 'aRouteToTheBareName'
			return bare
		end 'aRouteToTheBareName'

		let directory = try self.settledDeclarations().namespaceQualifiedFunctions.get(written) otherwise return bare
		return freeFunctionRegistrationName(bare, moduleDirectory: directory)
	end 'namespaceQualifiedFunctionName'

	// ⭐⭐ **POINT EVERY FUNCTION-BACKED CASE THE SWEEP FILED AT THE DECLARATION ITS NAME MEANS WHERE THE ENUM IS
	// DECLARED** — the sweep's half of `Parser.caseFunctionName`, which states why the reader's file must not
	// decide it. The sweep read each case before any contest was known, so it is resolved here, once the whole
	// program is folded. A name that means several declarations or none stays as written, and the real parse of
	// the declaring file refuses it.
	export function settleFunctionBackedEnumCases()
		let settled = EnumLayoutArray.create(0)

		for (_, layout) in self.mainThreadSettled().enumTypes 'eachEnum'
			if layout.backing != EnumBacking.functionRef 'notFunctionBacked'
				continue
			end 'notFunctionBacked'

			let edited = layout.clone()

			for index in 0 upto edited.caseCount() 'eachCase'
				match self.resolveFunctionName(freeze edited.rawValueAt(index).toByteArray(), readerFilePath: edited.declFilePath) 'resolution'
					declaration(name) then edited.nameCaseFunction(index, functionName: String.from(name))
					ambiguous or
					undeclared then break
				end 'resolution'
			end 'eachCase'

			settled.push(edited)
		end 'eachEnum'

		for layout in settled 'eachSettled'
			fileEnumLayout(self.mainThreadSettled().enumTypes, layout: layout)
		end 'eachSettled'
	end 'settleFunctionBackedEnumCases'

	// A scan of every enum layout. It is asked only after every ordinary lookup of a function value's
	// name has missed, which no program that compiles reaches.
	export function backsAFunctionBackedEnumCase(name ByteArray) returns bool
		let spelled = String.from(name)

		for (_, layout) in self.settledDeclarations().enumTypes 'eachEnum'
			if layout.backing != EnumBacking.functionRef 'notFunctionBacked'
				continue
			end 'notFunctionBacked'

			for index in 0 upto layout.caseCount() 'eachCase'
				if layout.rawValueAt(index).equals(spelled) 'thisCasesBacking'
					return true
				end 'thisCasesBacking'
			end 'eachCase'
		end 'eachEnum'

		return false
	end 'backsAFunctionBackedEnumCase'

	// ⭐ **THE NAME A FREE FUNCTION DECLARED IN `moduleDirectory` IS REGISTERED UNDER once its bare name is
	// contested** — its `<directory>~name` mint, and the BARE name when that directory is the root, which is
	// not a fallback but the rule: the root is the unqualified namespace, so a root declaration has no
	// qualifier to be named by.
	export function freeFunctionRegistrationName(bareName immutable ByteArray, moduleDirectory String) returns immutable ByteArray
		if moduleDirectory.isEmpty() 'theRootIsTheUnqualifiedNamespace'
			return bareName
		end 'theRootIsTheUnqualifiedNamespace'

		return authorMintSpelling(bareName, directory: moduleDirectory)
	end 'freeFunctionRegistrationName'

	// Move the incumbent's already-folded sweep entries from the bare key to its `<directory>~name` one, at
	// the moment a second directory declares the name. Every later declaration of a contested name files
	// under its own key from the start (`sweepRegistrationKey`), so the incumbent's are the only
	// entries written to the bare key without knowledge of the contest. A root declaration needs no
	// refile: the root is the unqualified namespace, so its registration name is the bare key, which
	// no subdirectory contestant writes.
	//
	// No hash mixing. Every fact moved here was already mixed into the parse-memo hash under its bare
	// name by the write that made it, and the minted key is derived from declarations the hash
	// already covers — mixing again would make the memo key depend on the move rather than on the
	// program. The default-helper rename's inputs, the bare name and the module directory, already
	// move the hash too.
	export function refileContestedFreeFunction(bareName ByteArray, registrationName ByteArray)
		if registrationName.equals(bareName) 'aRootDeclarationAlreadyOwnsTheBareKey'
			return
		end 'aRootDeclarationAlreadyOwnsTheBareKey'

		self.rekeyDeclarationSweepEntries(bareName, to: registrationName)
	end 'refileContestedFreeFunction'

	// Move one already-folded declaration from the key it was filed under to the key a contest has
	// just given it. It is reached when the source key holds this declaration's facts and nothing
	// else's — the free-function contest at the second directory.
	//
	// ⚠ Every fact is struck from the source key. A fact left behind is answered for a declaration
	// that never stated it — another declaration's parameter default, `throws` clause or return type.
	function rekeyDeclarationSweepEntries(from ByteArray, to ByteArray)
		self.moveDeclarationSweepFacts(from, to: to)
		self.renameContestedParamDefaultHelpers(from, registrationName: to)
	end 'rekeyDeclarationSweepEntries'

	function moveDeclarationSweepFacts(from ByteArray, to ByteArray)
		for fact in DeclarationSweepFact.allCases 'eachFact'
			self.moveDeclarationSweepFact(fact, from: from, to: to)
		end 'eachFact'
	end 'moveDeclarationSweepFacts'

	function moveDeclarationSweepFact(fact DeclarationSweepFact, from ByteArray, to ByteArray)
		match fact 'fact'
			returnType then self.mainThreadSettled().returnTypes.moveEntry(from, to: to)
			returnAliasName then self.mainThreadSettled().funcReturnAliasNames.moveEntry(from, to: to)
			returnSurface then self.mainThreadSettled().declaredReturnSurfaces.moveEntry(from, to: to)
			returnDeclFile then self.mainThreadSettled().funcReturnDeclFiles.moveEntry(from, to: to)
			declarationSite then self.mainThreadSettled().funcDeclSites.moveEntry(from, to: to)
			sweptDeclarations then self.mainThreadSettled().sweptDeclarations.moveEntry(from, to: to)
			opaqueParams then self.mainThreadSettled().funcOpaqueParams.moveEntry(from, to: to)
			paramConsumes then self.mainThreadSettled().funcParamConsumes.moveEntry(from, to: to)
			paramReassigns then self.mainThreadSettled().byRefSitesOfKey.moveEntry(from, to: to)
			globalAliasReturn then self.mainThreadSettled().funcGlobalAliasReturns.moveEntry(from, to: to)
			paramDefaults then self.mainThreadSettled().funcParamDefaults.moveEntry(from, to: to)
			throwsClause then self.mainThreadSettled().funcThrows.moveEntry(from, to: to)
			diverges then self.mainThreadSettled().funcDiverges.moveMember(from, to: to)
			alwaysThrows then self.mainThreadSettled().funcAlwaysThrows.moveMember(from, to: to)
			returnsFreshRecord then self.mainThreadSettled().funcReturnsFreshRecord.moveMember(from, to: to)
			freshReturnForwards then self.mainThreadSettled().funcFreshReturnForwards.moveEntry(from, to: to)
			constructsFromParams then self.mainThreadSettled().funcConstructsFromParams.moveMember(from, to: to)
			returnsReceiverField then self.mainThreadSettled().funcReturnsReceiverField.moveMember(from, to: to)
			returnsParameter then self.mainThreadSettled().funcReturnsParameter.moveMember(from, to: to)
			fieldMoveOutForwards then self.mainThreadSettled().funcFieldMoveOutForwards.moveEntry(from, to: to)
		end 'fact'
	end 'moveDeclarationSweepFact'

	// ⭐ **RE-POINT A CONTESTED DECLARATION'S SYNTHESIZED DEFAULT HELPERS AT THE KEY ITS OWN FACTS NOW SIT
	// UNDER.** The defaults entry is read back from the REGISTRATION key rather than from the bare name,
	// which is what makes it this declaration's by construction: nothing else files there. A name whose
	// declaration states no default has no entry and no helper, so the common contested name costs one map
	// miss.
	//
	// The helper's facts are moved, not copied, because when this runs the swept name holds only the
	// incumbent's: the contestant that triggered it files its own helpers later in its fold
	// (`recordSweptDefaultHelpers`), after the contest is settled. The moved alias-return info is
	// refiled through `declaredAs` for that function's reason.
	function renameContestedParamDefaultHelpers(bareName ByteArray, registrationName ByteArray)
		var info = try self.mainThreadSettled().funcParamDefaults.get(registrationName) otherwise return

		for i in 0 upto info.producers.count() 'eachCallAlignedSlot'
			let slot = i as ParamCount

			// A caller-location slot has no synthesized function to rename, so the move would find
			// nothing and `withHelperRenamed` would invent a helper the drain never declared.
			match info.producerFor(slot) 'produces'
				required or
				callerLine or
				callerFile then continue
				helper(name) then info = info.withHelperRenamed(slot, renamedTo: self.refileContestedDefaultHelper(slot, sweptName: name, bareName: bareName, registrationName: registrationName))
			end 'produces'
		end 'eachCallAlignedSlot'

		self.mainThreadSettled().funcParamDefaults.upsert(registrationName, value: info)
	end 'renameContestedParamDefaultHelpers'

	function refileContestedDefaultHelper(slot ParamCount, sweptName ByteArray, bareName ByteArray, registrationName ByteArray) returns immutable ByteArray
		let renamed = self.defaultHelperNameUnder(slot, sweptName: sweptName, bareName: bareName, registrationName: registrationName)
		self.moveDeclarationSweepFacts(sweptName, to: renamed)

		if let aliasReturn = try self.mainThreadSettled().funcGlobalAliasReturns.get(renamed) 'returnsAGlobalOrACall'
			self.mainThreadSettled().funcGlobalAliasReturns.upsert(renamed, value: aliasReturn.declaredAs(renamed))
		end 'returnsAGlobalOrACall'

		return renamed
	end 'refileContestedDefaultHelper'

	// Add one FREE function's namespace-qualified spelling to the index AND fold it into the hash —
	// `recordAlias`'s discipline, one write, so the map and the hash that keys every parse memo on it cannot
	// disagree about what the index contains. See `namespaceQualifiedFunctions` for why the map carries the
	// directory and `declShapeNamespaceQualifiedFunction` for why it must ride the hash at all.
	function recordNamespaceQualifiedFunction(qualifiedName ByteArray, moduleDirectory String)
		self.mainThreadSettled().namespaceQualifiedFunctions.upsert(qualifiedName, value: moduleDirectory)
		self.hash = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeNamespaceQualifiedFunction), bytes: qualifiedName)
	end 'recordNamespaceQualifiedFunction'

	// Add one FUNCTION typealias to the index AND fold it into the hash — the one write, for
	// `recordAlias`'s reason. The RETURN type rides the hash: a caller that binds a function value of this
	// alias and calls it recovers the result type FROM this return type, so a change to it changes what that
	// caller compiles to and its parse memo must move with it.
	//
	// ⭐⭐ **AND SO DOES THE PARAMETER LIST** — the sentence
	// above applies to it verbatim: `SemanticCheck.checkIndirectCallArgs` type-checks a call's arguments
	// against these types and `LowerMaxonToStd` derives the `callIndirect` FLOAT MASK from them, so changing
	// `typealias Cb = function(Integer)` to `function(Real)` changes the code another file emits.
	//
	// ⛔⛔ **IT RIDES AS THE `paramSpelling` DIGEST AND NOT AS `alias.paramTypes`.** Every route into `foldFile`
	// reads its aliases with `recordSignature: false` (the file sweep, the extension fold, all three nested
	// readers), so the `paramTypes` THIS function receives are the sweep's tolerant reading, whose ids are the
	// sweeping parser's interner's and whose `named` leaves stand for several different kinds of type. The
	// digest is folded at PARSE time from the parameter TOKENS, unconditionally in both passes
	// (`Parser.readFunctionTypeAlias`), so it is the one parameter fact both passes mint identically.
	function recordFunctionTypeAlias(alias FunctionTypeAlias)
		self.mainThreadSettled().functionTypeAliases.record(alias)
		let named = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeFunctionAlias), bytes: alias.name)
		self.hash = mixDeclaringTier(Hasher.combined(self.mixAliasReturnSlot(named, alias: alias), value: alias.paramSpelling), visibility: alias.visibility, declFilePath: alias.declFilePath)

		if alias.mutableFunction 'aMutableFunction'
			self.hash = Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeMutableFunction)
		end 'aMutableFunction'
	end 'recordFunctionTypeAlias'

	export function recordNestedFunctionAlias(qualified ByteArray)
		if self.settledDeclarations().nestedFunctionAliasMembers.contains(qualified) 'alreadyNoted'
			return
		end 'alreadyNoted'

		self.requireBeforeTheBaseline("recordNestedFunctionAlias")
		self.mainThreadSettled().nestedFunctionAliasMembers.insert(qualified)
	end 'recordNestedFunctionAlias'

	// ⭐⭐ **ONE STORED SIGNATURE SLOT FOLDED INTO THE HASH, AND ITS ARMS ARE `maxonTypeOfStoredTypeName`'s ARMS
	// OVER THE SAME COLUMNS — WHICH IS A BUILD FAILURE TO GET WRONG RATHER THAN A HEADER PROMISE.**
	// The two dispatches genuinely cannot share a body (see `AliasSlotIdentity` for the measurement that killed
	// the obvious unification), so they share the CLASSIFIER instead: both match `AliasSlotIdentity`
	// exhaustively, and a fourth identity column stops BOTH from compiling.
	//
	// The tag and the name are not the whole type: a `typeParameter`'s digest and a `genericInstance`'s
	// `GenericInstanceId` are exactly the identities the name slot cannot hold (`FunctionTypeAlias`), so
	// tag-plus-name alone gives two DIFFERENT return types one hash — two instantiations of one base are both
	// `(genericInstance, "")`.
	//
	// ⚠ **AND THAT STATE ARISES FOR EXACTLY ONE POPULATION, WHICH IS NARROWER THAN THE SENTENCE ABOVE READS
	// ON ITS OWN.** Only the `extension`-body nested alias reaches here `genericInstance`-tagged at all; every
	// FILE-SCOPE function alias arrives `named` + `AliasSlotIdentity.nameOnly`, because its fold runs ABOVE
	// `signatures.allFilesFolded` and `parseTypeReference`'s alias registries sit behind that gate. So the
	// hole was real and was one population wide — recorded here so a later reader does not conclude it was
	// broader, and does not conclude from a file-scope program's green run that the arm is dead.
	//
	// ⛔⛔ **THE INSTANCE GOES THROUGH `mixGenericInstance`, NEVER RAW.**
	// `mixDeclaration`'s rule is names-never-ids *because an INTERN-ORDER id
	// shifts when an unrelated file declares something* — which is the very failure mode this whole change
	// exists to have removed from the TYPE system, reintroduced one layer up in the CACHE KEY. `mixType`'s
	// `genericInstance` arm already states the cure and implements it: the base NAME plus each argument's
	// shape, which moves when and only when the instance's MEANING moves.
	// ⚠ **AND IT IS REACHABLE, NOT THEORETICAL.** MEASURED with a temporary panic: an `extension`-body nested
	// function typealias returning a generic alias arrives here tagged `genericInstance` carrying a live dense
	// **gid 1** — because `foldExtensionDeclarations` runs BELOW `signatures.allFilesFolded` (`Queries.maxon`),
	// unlike the file sweep, which is above it and therefore hands every file-scope alias a bare `named`.
	//
	// ⚠ **THE `typeParameter` HALF IS CORRECT RAW AND STAYS RAW**, for `mixType`'s own stated reason: a
	// token is a digest of two source NAMES, not an intern-order id, so mixing it IS mixing those names.
	function mixAliasReturnSlot(state HashDigest, alias FunctionTypeAlias) returns HashDigest
		let tagged = Hasher.combined(mixBytes(Hasher.combined(state, value: alias.returnTag.rawValue as HashDigest), bytes: alias.returnTypeName), value: alias.returnCapability.ordinal as HashDigest)

		match alias.returnIdentity 'identity'
			typeParamToken(token) then return Hasher.combined(tagged, value: token as HashDigest)
			genericInstance(id) then return self.mixGenericInstance(tagged, id: id)
			nameOnly then return tagged
		end 'identity'
	end 'mixAliasReturnSlot'

	// ⭐ **A CLAUSE'S `with` BINDINGS, AS A CLAUSE MAY BIND AT EVERY NAME** — one list per interface, so
	// the column is nested and a flat walk of it could not tell `implements A with X, B` from
	// `implements A, B with X`.
	//
	// ⚠ **EACH LIST'S LENGTH IS MIXED AHEAD OF ITS CONTENTS, AND THAT IS WHAT MAKES THE NESTING VISIBLE.**
	// Without it `[[X], [Y]]` and `[[X, Y], []]` hash identically — two different programs (one binds `Y` at the
	// second interface, the other binds it at the first), and a reader served the wrong memo would substitute
	// one conformer's associated type for another's.
	function mixConformanceBindings(state HashDigest, bindings ConformanceBindingArray) returns HashDigest
		var out = state

		for perInterface in bindings 'eachConformance'
			out = mixDeclaredConformances(Hasher.combined(out, value: perInterface.spellings.count() as HashDigest), conformsTo: perInterface.spellings, shape: SignatureDiscriminator.declShapeConformanceBinding)

			for bound in perInterface.types 'eachBoundType'
				out = self.mixRequirementType(out, requirement: bound)
			end 'eachBoundType'
		end 'eachConformance'

		return out
	end 'mixConformanceBindings'

	function mixRequirementType(state HashDigest, requirement RequirementType) returns HashDigest
		let tagged = mixBytes(Hasher.combined(state, value: requirement.identity.ordinal as HashDigest), bytes: requirement.brand)

		return match requirement.identity 'identity'
			typeParameter(token) gives Hasher.combined(tagged, value: token as HashDigest)
			genericInstance(id) gives self.mixGenericInstance(tagged, id: id)
			builtin(tag) gives Hasher.combined(tagged, value: tag.rawValue as HashDigest)
			nominal(name) gives mixBytes(tagged, bytes: name)
			void or
			selfType gives tagged
		end 'identity'
	end 'mixRequirementType'

	// Add one top-level DECLARATION (a `let`) to the arena. No value yet:
	// `evaluateInitializers` supplies that once every file has been folded in.
	//
	// On a duplicate storage key the declaration whose file's path identity sorts earliest is held, so the
	// kept binding does not depend on the order files are folded in. A file that declares the same name
	// twice — `let A = 1` then `let A = 2` — keeps the FIRST here and is
	// diagnosed E3006 by the real parse (`isRedeclaredBinding` → `Parser.raiseBindingFailure`), the
	// top-level twin of the positioned duplicate-FUNCTION check `commitFuncSignatures` makes. A
	// name two directories declare arrives minted `<directory>~name` (`settleBindingMints`), so the two hold
	// different keys. The key holds one declaration, so a duplicate of a binding
	// in another family is judged by the ledger in `TopLevelNameScope.maxon` rather than here.
	function recordDecl(decl TopLevelDecl)
		if let held = try self.mainThreadSettled().declIndex.get(decl.storageKey) 'duplicate'
			if DeclarationSite.of(decl, index: held).precedes(DeclarationSite.of(self.declAt(held), index: held)) 'declaredFirstInPathOrder'
				try self.mainThreadSettled().decls.set(held, value: decl) otherwise panic("ProgramSignatures.recordDecl: decls.set OOB at {held} — every index declIndex holds is one this arena minted")
			end 'declaredFirstInPathOrder'

			return
		end 'duplicate'

		self.mainThreadSettled().declIndex.upsert(decl.storageKey, value: self.mainThreadSettled().decls.count())
		self.mainThreadSettled().decls.push(decl)
	end 'recordDecl'

	// ⭐ EVALUATE EVERY TOP-LEVEL CONSTANT IN THE PROGRAM, and fold each answer into the index's hash.
	// Called once, by `queryProgramSignatures`, AFTER every file's declarations have been folded in.
	//
	// **THAT ORDERING IS THE FEATURE.** A forward reference — `let TOTAL = FIRST + SECOND` written
	// above `let FIRST = 30` — resolves precisely because nothing is evaluated until every declaration
	// is KNOWN. A single forward pass cannot do it.
	//
	// Driving over the ARENA in declaration order is what makes the cycle message deterministic — see
	// the `decls` field.
	// ⭐⭐ **BIND EVERY `--define` TO THE DECLARATION IT NAMES, BEFORE ANY INITIALIZER IS FOLDED.**
	//
	// It runs over the whole arena rather than at each fold, and that is what makes AMBIGUITY visible at
	// all: a per-fold check sees one declaration at a time and could only ever ask "is this one mine?",
	// which answers yes for both of two claimants and overrides both.
	//
	// ⚠ **A NAME MATCHES BARE OR NAMESPACE-QUALIFIED, AND NEITHER SPELLING IS TRUSTED TO BE UNIQUE.** A
	// bare name matches every directory's declaration, and a namespace is a rendering of a module DIRECTORY
	// (`my/dir` and `my.dir` both render `my.dir`) — qualifying narrows the field without closing it, and
	// only counting the matches can.
	export function resolveDefines(defines DefineArray) returns DefineProblemArray
		let problems = DefineProblemArray.create(0)

		for define in defines 'eachDefine'
			let claimants = self.defineClaimantsOf(define.name)

			if claimants.decls.count() == 0 'namedNothing'
				problems.push(DefineProblem.create(ErrorCode.defineNoSuchConstant, message: "--define named '{define.name}', which no file declares as a top-level constant. Nothing was overridden."))
				continue
			end 'namedNothing'

			if claimants.decls.count() > 1 'namedSeveral'
				// ⛔ **THE REMEDY IS NOT THE SAME ONE IN BOTH CASES, AND OFFERING THE WRONG ONE IS WORSE THAN
				// OFFERING NONE.** A declaration in a root-level file has an EMPTY namespace and therefore no
				// qualified spelling — `(root).Banner` is how it is DISPLAYED, not something this flag accepts
				// — so telling its author to "name it in full" prescribes a fix that cannot be typed. That is
				// exactly the failure `qualifiedCandidateName`'s header records: a message whose whole content
				// is a fix, and the fix does not work.
				let remedy = "Move it into a subdirectory or rename it — a declaration in a root-level file has no qualified spelling to name it by." if claimants.anyAtTheRoot else "Name one of them in full."
				problems.push(DefineProblem.create(ErrorCode.defineAmbiguous, message: "--define '{define.name}' matches {claimants.decls.count()} declarations and cannot choose between them: {claimants.list}. {remedy}"))
				continue
			end 'namedSeveral'

			let decl = self.ownDeclAt(claimants.sole())

			if not initializerIsLoneTokenOf(decl, tokens: self.declTokensOf(decl), kind: TokenKind.stringLiteral) 'notAPlainDefault'
				problems.push(DefineProblem.create(ErrorCode.defineNotAStringLiteral, message: "--define '{define.name}' names a constant at {decl.declFilePath}:{decl.nameLine}:{decl.nameColumn} whose initializer is not a plain string literal. Only a written-out default can be replaced."))
				continue
			end 'notAPlainDefault'

			decl.defined = DefinedInitializer.text(define.value)
		end 'eachDefine'

		self.bindBuilderCapability()
		return problems
	end 'resolveDefines'

	// ⚖ **THE CAPABILITY THIS COMPILER'S RUNTIME HAS, STATED IN WHAT IT BUILDS** (`FrontEndPool.RuntimeSharesAnyGraph`).
	// Bound only to exactly that declaration — the sole claimant of its qualified name, written as a lone bool literal
	// — so a program without it sees nothing, not even a refusal. A compiler whose declaration stops matching runs its
	// front end in process, which `tests/parallelCompile`'s pool cases refuse.
	function bindBuilderCapability()
		let claimants = self.defineClaimantsOf(FrontEndPool.RuntimeSharesAnyGraphDefine)

		if claimants.decls.count() != 1 'notTheCompilersDeclaration'
			return
		end 'notTheCompilersDeclaration'

		let decl = self.ownDeclAt(claimants.sole())
		let tokens = self.declTokensOf(decl)

		if not (initializerIsLoneTokenOf(decl, tokens: tokens, kind: TokenKind.false) or initializerIsLoneTokenOf(decl, tokens: tokens, kind: TokenKind.true)) 'notAWrittenFlag'
			return
		end 'notAWrittenFlag'

		decl.defined = DefinedInitializer.flag(true)
	end 'bindBuilderCapability'

	// Every declaration answering `name`, counted rather than looked up — see `resolveDefines`.
	function defineClaimantsOf(name String) returns DefineClaimants
		let claimants = DefineClaimants.create()

		for i in 0 upto self.settledDeclarations().decls.count() 'eachDecl'
			let decl = self.declAt(i)

			if not self.declMatchesDefineName(decl, name: name) 'notThisOne'
				continue
			end 'notThisOne'

			if self.namespaceOf(decl.declFilePath).isEmpty() 'declaredAtTheRoot'
				claimants.anyAtTheRoot = true
			end 'declaredAtTheRoot'

			let separator = "" if claimants.decls.count() == 0 else ", "
			claimants.list = "{claimants.list}{separator}{qualifiedCandidateName(self.moduleDirectoryOf(decl.declFilePath), bare: bareNameOfMint(decl.name))} at {decl.declFilePath}:{decl.nameLine}:{decl.nameColumn}"
			claimants.decls.push(i as ElementIndex)
		end 'eachDecl'

		return claimants
	end 'defineClaimantsOf'

	// Does this declaration answer to `name`, bare or namespace-qualified? A root-level file has an EMPTY
	// namespace and therefore no second spelling — its bare name already is its qualified one.
	function declMatchesDefineName(decl TopLevelDecl, name String) returns bool
		let bare = String.from(bareNameOfMint(decl.name))

		if bare == name 'bareSpelling'
			return true
		end 'bareSpelling'

		let namespace = self.namespaceOf(decl.declFilePath)

		if namespace.isEmpty() 'rootHasOneSpelling'
			return false
		end 'rootHasOneSpelling'

		return name == "{namespace}.{bare}"
	end 'declMatchesDefineName'

	export function evaluateInitializers(anchors ParserAnchors)
		for i in 0 upto self.mainThreadSettled().decls.count() 'eachDecl'
			let decl = self.declAt(i)

			match decl.outcome 'state'
				value or
				failed or
				poisoned or
				managedValue or
				deferredRecord or
				storedRecord or
				imagedRecord or
				imagedBox or
				unvalidatedRecord then break
				evaluating then panic("ProgramSignatures.evaluateInitializers: '{String.from(decl.name)}' is still marked `evaluating` between two top-level walks — every DFS pops what it pushes")
				pending then self.startDecl(i, anchors: anchors)
			end 'state'
		end 'eachDecl'
	end 'evaluateInitializers'

	// A stored record's initializer is parsed twice: here, to settle its type and its image-or-stored
	// verdict, and again in its declaring file's real parse as the `__global_init.<label>` function
	// `__module_init` calls. Readers in other files need the verdict before that file is parsed, and files
	// parse in no fixed order.
	export function settleRecordInitializers(anchors ParserAnchors)
		for i in 0 upto self.mainThreadSettled().decls.count() 'eachDecl'
			let decl = self.declAt(i)

			match decl.outcome 'state'
				deferredRecord then _ = self.settleRecordDecl(i, stack: TopLevelDeclIndexArray.create(0), anchors: anchors)
				value or
				failed or
				poisoned or
				managedValue or
				storedRecord or
				imagedRecord or
				imagedBox or
				unvalidatedRecord then break
				pending or
				evaluating then panic("ProgramSignatures.settleRecordInitializers: '{String.from(decl.name)}' is `pending` or `evaluating` after the sweep — `evaluateInitializers` settles every declaration and every DFS pops what it pushes")
			end 'state'
		end 'eachDecl'

		self.assignDataLabels()

		for j in 0 upto self.mainThreadSettled().decls.count() 'eachOutcome'
			let decl = self.declAt(j)
			self.attributeHashEventsTo(HashEventSource.library if self.declaredByTheCorpus(decl.declFilePath) else HashEventSource.author)
			self.hash = self.mixConstant(self.hash, decl: decl)
		end 'eachOutcome'

		self.attributeHashEventsTo(HashEventSource.whole)

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.declTokenStreams = DeclTokenStreamMap.create()
	end 'settleRecordInitializers'

	function assignDataLabels()
		let minted = DataLabelCountMap.create()
		var stored = 0 as StoredGlobalCount

		for i in 0 upto self.mainThreadSettled().decls.count() 'each'
			let decl = self.ownDeclAt(i)

			if not decl.hasStorage 'inlinedHasNoSlot'
				continue
			end 'inlinedHasNoSlot'

			let label = uniqueDataLabel(decl.name, minted: minted)
			decl.dataLabel = DataSlotLabel.labelled(label)
			stored = stored + 1

			if decl.declaredByTheCorpus and declHasInitializerFunction(decl) 'creditedAtTheRead'
				self.mainThreadSettled().corpusSlotInitCallees.upsert(label, value: freeze nameRosterOf(globalInitializerName(label)))
			end 'creditedAtTheRead'
		end 'each'

		self.storedGlobalCount = stored
	end 'assignDataLabels'

	function startDecl(index ElementIndex, anchors ParserAnchors)
		let stack = TopLevelDeclIndexArray.create(0)
		_ = self.evaluateDecl(index, stack: stack, anchors: anchors)
	end 'startDecl'

	function evaluateDecl(index ElementIndex, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns ConstEvalOutcome
		match self.declAt(index).outcome 'state'
			value(payload, tag, typeName) then return ConstEvalOutcome.value(payload, tag: tag, typeName: typeName)
			failed or
			poisoned then return ConstEvalOutcome.failed
			managedValue or
			deferredRecord or
			unvalidatedRecord or
			storedRecord or
			imagedRecord or
			imagedBox then return ConstEvalOutcome.notFound
			evaluating then return self.recordCycle(index, stack: stack)
			pending then break
		end 'state'

		let decl = self.ownDeclAt(index)
		decl.outcome = TopLevelConstant.evaluating
		stack.push(index)
		let outcome = self.foldInitializerDuringSweep(decl, stack: stack, anchors: anchors)
		_ = try stack.pop() otherwise panic("ProgramSignatures.evaluateDecl: stack.pop failed for '{String.from(decl.name)}' — every push is matched here")

		return outcome
	end 'evaluateDecl'

	function foldInitializerDuringSweep(decl TopLevelDecl, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns ConstEvalOutcome
		match decl.defined 'defined'
			written then break
			text(value) then return self.settleManagedValue(decl, bytes: freeze value.toByteArray(), kind: ManagedConstKind.string)
			flag(value) then return self.settleScalarValue(decl, value: ConstValue.ofBool(value))
		end 'defined'

		let parser = self.initializerParser(decl, role: InitializerRole.sweepFold, anchors: anchors)
		let folded = try parser.foldSweepInitializer(decl, stack: stack) otherwise (err) 'noValue'
			parser.recordTypeNamesPastTheCursor()
			return self.recordFailure(decl, error: err)
		end 'noValue'

		let settled = match folded 'kind'
			scalar(value) gives self.settleScalarValue(decl, value: value)
			managed(bytes, kind) gives self.settleManagedValue(decl, bytes: bytes, kind: kind)
			runtimeRecord gives self.settleDeferredRecord(decl)
		end 'kind'

		self.fileLetCastReads(decl, parser: parser)

		return settled
	end 'foldInitializerDuringSweep'

	function fileLetCastReads(decl TopLevelDecl, parser Parser)
		if declInitializerIsParsedAgain(decl) 'theLaterParseFilesThem'
			return
		end 'theLaterParseFilesThem'

		decl.letCastReads = parser.recordedLetCastReads()
	end 'fileLetCastReads'

	function initializerParser(decl TopLevelDecl, role InitializerRole, anchors ParserAnchors) returns Parser
		let stream = self.declTokenStreamOf(decl)
		return Parser.createOverPreparedTokens(stream.prepared, sourceBytes: initializerSourceBytes(stream.prepared.tokens, decl: decl), job: stream.job.forInitializerRole(role), signatures: self, anchors: anchors)
	end 'initializerParser'

	function settleScalarValue(decl TopLevelDecl, value ConstValue) returns ConstEvalOutcome
		if tagNamesADeclaredType(value.tag) 'anInlinePackedWord'
			self.mainThreadSettled().managedTopLevelNames.insert(decl.name)
		end 'anInlinePackedWord'

		decl.outcome = TopLevelConstant.value(value.payload, tag: value.tag, typeName: value.typeName)
		return ConstEvalOutcome.value(value.payload, tag: value.tag, typeName: value.typeName)
	end 'settleScalarValue'

	function settleManagedValue(decl TopLevelDecl, bytes ByteArray, kind ManagedConstKind) returns ConstEvalOutcome
		decl.outcome = TopLevelConstant.managedValue(bytes, kind: kind)
		self.mainThreadSettled().managedTopLevelNames.insert(decl.name)
		return ConstEvalOutcome.notFound
	end 'settleManagedValue'

	function settleDeferredRecord(decl TopLevelDecl) returns ConstEvalOutcome
		decl.outcome = TopLevelConstant.deferredRecord
		self.mainThreadSettled().managedTopLevelNames.insert(decl.name)
		return ConstEvalOutcome.notFound
	end 'settleDeferredRecord'

	function settleRecordDecl(index ElementIndex, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns ConstEvalOutcome
		let decl = self.ownDeclAt(index)
		decl.outcome = TopLevelConstant.evaluating
		stack.push(index)
		let outcome = self.probeRecordInitializer(decl, stack: stack, anchors: anchors)
		_ = try stack.pop() otherwise panic("ProgramSignatures.settleRecordDecl: stack.pop failed for '{String.from(decl.name)}' — every push is matched here")

		return outcome
	end 'settleRecordDecl'

	function settleDeferredRecordAt(index ElementIndex, stack TopLevelDeclIndexArray, anchors ParserAnchors)
		match self.declAt(index).outcome 'state'
			deferredRecord then _ = self.settleRecordDecl(index, stack: stack, anchors: anchors)
			evaluating then _ = self.recordCycle(index, stack: stack)
			value or
			failed or
			poisoned or
			managedValue or
			storedRecord or
			imagedRecord or
			imagedBox or
			unvalidatedRecord then break
			pending then panic("ProgramSignatures.settleDeferredRecordAt: '{String.from(self.declAt(index).name)}' is `pending` during the record probe — `evaluateInitializers` settled every declaration before it")
		end 'state'
	end 'settleDeferredRecordAt'

	export function bindingInitializerIsRefused(name ByteArray, readerFilePath FilePath) returns bool
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.either) 'lookup'
			found(index) then return declInitializerIsRefused(self.declAt(index))
			notFound then return false
		end 'lookup'
	end 'bindingInitializerIsRefused'

	export function settleBindingDuringProbe(name ByteArray, readerFilePath FilePath, stack TopLevelDeclIndexArray, anchors ParserAnchors)
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.either) 'lookup'
			found(index) then self.settleDeferredRecordAt(index, stack: stack, anchors: anchors)
			notFound then return
		end 'lookup'
	end 'settleBindingDuringProbe'

	export function constantValueDuringProbe(name ByteArray, readerFilePath FilePath, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns TopLevelConstantLookup
		self.settleBindingDuringProbe(name, readerFilePath: readerFilePath, stack: stack, anchors: anchors)

		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'constant'
			found(index) then return self.probedConstantValueAt(index, name: name, readerFilePath: readerFilePath)
			notFound then return TopLevelConstantLookup.notFound
		end 'constant'
	end 'constantValueDuringProbe'

	function probedConstantValueAt(index ElementIndex, name ByteArray, readerFilePath FilePath) returns TopLevelConstantLookup
		match self.declAt(index).outcome 'state'
			failed or
			unvalidatedRecord then return TopLevelConstantLookup.poisoned
			value or
			poisoned or
			managedValue or
			deferredRecord or
			storedRecord or
			imagedRecord or
			imagedBox or
			pending or
			evaluating then return self.notedConstantValue(index, name: name, readerFilePath: readerFilePath)
		end 'state'
	end 'probedConstantValueAt'

	function probeRecordInitializer(decl TopLevelDecl, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns ConstEvalOutcome
		let parser = self.initializerParser(decl, role: InitializerRole.recordProbe, anchors: anchors)

		let probed = try parser.probeRecordInitializer(decl, stack: stack) otherwise (err) 'noValue'
			return self.recordFailure(decl, error: err)
		end 'noValue'

		let outcome = match probed 'probed'
			scalar(value) gives self.settleScalarValue(decl, value: value)
			record(settled) gives self.settleProbedRecord(decl, settled: settled)
			unvalidated(followUp) gives self.settleUnvalidatedRecord(decl, followUp: followUp)
		end 'probed'

		self.fileLetCastReads(decl, parser: parser)

		return outcome
	end 'probeRecordInitializer'

	function settleUnvalidatedRecord(decl TopLevelDecl, followUp InitializerFollowUp) returns ConstEvalOutcome
		decl.outcome = TopLevelConstant.unvalidatedRecord(followUp)
		self.mainThreadSettled().managedTopLevelNames.insert(decl.name)

		return ConstEvalOutcome.notFound
	end 'settleUnvalidatedRecord'

	export function nonConstantCallInitializers() returns NonConstantCallSiteArray
		let sites = NonConstantCallSiteArray.create(0)

		for i in 0 upto self.settledDeclarations().decls.count() 'eachDecl'
			let decl = self.declAt(i)

			match decl.outcome 'state'
				unvalidatedRecord(followUp) then self.noteNonConstantCall(sites, decl: decl, followUp: followUp)
				pending or
				evaluating or
				value or
				failed or
				poisoned or
				managedValue or
				deferredRecord or
				storedRecord or
				imagedRecord or
				imagedBox then continue
			end 'state'
		end 'eachDecl'

		return sites
	end 'nonConstantCallInitializers'

	// Asked only once the compile has reported nothing: an initializer the probe left unresolved reads as
	// poisoned, which is silent, so it is sound only behind a diagnostic some pass has already reported.
	export function requireEveryUnvalidatedInitializerReported()
		for i in 0 upto self.settledDeclarations().decls.count() 'eachDecl'
			let decl = self.declAt(i)

			match decl.outcome 'state'
				unvalidatedRecord(followUp) then self.requireFollowUpReported(decl, followUp: followUp)
				pending or
				evaluating or
				value or
				failed or
				poisoned or
				managedValue or
				deferredRecord or
				storedRecord or
				imagedRecord or
				imagedBox then continue
			end 'state'
		end 'eachDecl'
	end 'requireEveryUnvalidatedInitializerReported'

	function requireFollowUpReported(decl TopLevelDecl, followUp InitializerFollowUp)
		match followUp 'followUp'
			nonConstantCall then break
			none then panic("ProgramSignatures.requireEveryUnvalidatedInitializerReported: top-level binding '{String.from(decl.name)}' in {decl.declFilePath} was left unresolved by the record probe and no diagnostic was reported anywhere in the program — its readers see it poisoned, so the compile would proceed silently")
		end 'followUp'
	end 'requireFollowUpReported'

	function noteNonConstantCall(sites NonConstantCallSiteArray, decl TopLevelDecl, followUp InitializerFollowUp)
		match followUp 'followUp'
			nonConstantCall(callee, line, column) then sites.push(NonConstantCallSite.create(callee, filePath: decl.declFilePath, line: line, column: column))
			none then break
		end 'followUp'
	end 'noteNonConstantCall'

	function settleProbedRecord(decl TopLevelDecl, settled ProbedRecord) returns ConstEvalOutcome
		match self.imageOfProbedRecord(settled) 'image'
			none then self.settleStoredRecord(decl, settled: settled)
			record(image) then self.settleImagedOutcome(decl, outcome: TopLevelConstant.imagedRecord(image))
			box(nodes, root, typeName, tag) then self.settleImagedOutcome(decl, outcome: TopLevelConstant.imagedBox(nodes, root: root, typeName: typeName, tag: tag))
		end 'image'

		return ConstEvalOutcome.notFound
	end 'settleProbedRecord'

	function settleStoredRecord(decl TopLevelDecl, settled ProbedRecord)
		decl.outcome = TopLevelConstant.storedRecord(settled.valueType, brand: settled.brand, runsProgramCode: settled.runsProgramCode, mapColumns: settled.mapColumns)
		decl.hasStorage = true
	end 'settleStoredRecord'

	function settleImagedOutcome(decl TopLevelDecl, outcome TopLevelConstant)
		decl.outcome = outcome
		decl.hasStorage = false
	end 'settleImagedOutcome'

	function imageOfProbedRecord(settled ProbedRecord) returns ProbedImage
		return match settled.shape 'shape'
			opaque gives ProbedImage.none
			constBlob(elementSize, elementCount, bytes, bounds) gives ProbedImage.record(TopLevelImageRecord.create(ImmortalRecordKind.constBlob, elementSize: elementSize, elementCount: elementCount, bytes: bytes, valueType: settled.valueType, brand: settled.brand, bounds: bounds))
			stringTable(texts) gives ProbedImage.record(self.stringTableImageOfTexts(texts.clone(), valueType: settled.valueType, brand: settled.brand))
			emptyContainer gives self.probedEmptyContainerImage(settled)
			payloadFreeUnionCase(typeName, caseName) gives self.probedUnionCaseImage(typeName, caseName: caseName)
			construction(nodes) gives self.probedConstructionImage(nodes)
		end 'shape'
	end 'imageOfProbedRecord'

	function probedConstructionImage(nodes ProbedConstructionArray) returns ProbedImage
		let arena = ImmortalBoxNodeArray.create(0)
		let rootId = (nodes.count() - 1) as ElementIndex
		let root = try nodes.get(rootId) otherwise panic("ProgramSignatures.probedConstructionImage: a construction shape carries its root last, and there are no nodes")

		match self.constructionBoxNode(nodes, id: rootId, arena: arena) 'outcome'
			described(node) then return ProbedImage.box(arena, root: node, typeName: root.typeName, tag: ValueTypeTag.structRef)
			notImageable then return ProbedImage.none
		end 'outcome'
	end 'probedConstructionImage'

	function constructionBoxNode(nodes ProbedConstructionArray, id ElementIndex, arena ImmortalBoxNodeArray) returns ConstStructBoxOutcome
		let construction = try nodes.get(id) otherwise panic("ProgramSignatures.constructionBoxNode: node {id} is outside a {nodes.count()}-entry arena — a slot names a node its construction appended before itself")
		let layout = self.constStructLayoutOf(construction.typeName, declName: construction.typeName)

		if construction.slots.count() != layout.fieldCount() 'notLayoutParallel'
			panic("ProgramSignatures.constructionBoxNode: `{String.from(construction.typeName)}` is constructed with {construction.slots.count()} slot(s) against a layout of {layout.fieldCount()} — the parse notes one value per DECLARED field")
		end 'notLayoutParallel'

		let scalars = ImageScalarSlotArray.create(0)
		let columns = ImmortalBoxColumnArray.create(0)

		for i in 0 upto layout.fieldCount() 'eachField'
			let slot = try construction.slots.get(i) otherwise panic("ProgramSignatures.constructionBoxNode: slots.get OOB at {i} below the count this loop was just held to")

			match self.constructionFieldSlot(slot, nodes: nodes, layout: layout, index: i as FieldIndex, arena: arena) 'field'
				scalar(field) then scalars.push(field)
				column(entry) then columns.push(entry)
				notImageable then return ConstStructBoxOutcome.notImageable
			end 'field'
		end 'eachField'

		return ConstStructBoxOutcome.described(pushImageBoxNode(arena, node: ImmortalBoxNode.create(structBoxImageBytes(layout.sizeBytes(), fields: scalars), columns: columns)))
	end 'constructionBoxNode'

	function constructionFieldSlot(slot ProbedSlot, nodes ProbedConstructionArray, layout StructLayout, index FieldIndex, arena ImmortalBoxNodeArray) returns ContainerBoxSlot
		let declared = self.fieldTypeOf(layout, index: index, into: self.typeNames)

		if maxonTypeTag(declared) == ValueTypeTag.interfaceRef 'anExistentialSlot'
			return ContainerBoxSlot.notImageable
		end 'anExistentialSlot'

		match slot 'slot'
			scalar(payload, kind) then return self.constructionScalarSlot(layout, index: index, declared: declared, payload: payload, kind: kind)
			emptyContainer(valueType) then return self.constructionContainerSlot(valueType, declared: declared, offset: layout.offsetOfField(index), arena: arena)
			helperDefault(callee) then return self.constructionHelperDefaultSlot(callee, layout: layout, index: index, declared: declared, arena: arena)
			unionCase(typeName, caseName) then return self.constructionUnionCaseSlot(typeName, caseName: caseName, declared: declared, offset: layout.offsetOfField(index), arena: arena)
			box(node) then return self.constructionNestedSlot(nodes, id: node, declared: declared, offset: layout.offsetOfField(index), arena: arena)
			inlineWord(payload, typeName) then return self.constructionInlineWordSlot(layout, index: index, declared: declared, payload: payload, typeName: typeName)
		end 'slot'
	end 'constructionFieldSlot'

	function constructionInlineWordSlot(layout StructLayout, index FieldIndex, declared MaxonType, payload FullRangeInt, typeName ByteArray) returns ContainerBoxSlot
		if not self.fieldDeclaresTypeNamed(declared, typeName: typeName) 'anotherType'
			return ContainerBoxSlot.notImageable
		end 'anotherType'

		return self.constructionScalarSlot(layout, index: index, declared: declared, payload: payload, kind: ProbedScalarKind.integer)
	end 'constructionInlineWordSlot'

	function constructionScalarSlot(layout StructLayout, index FieldIndex, declared MaxonType, payload FullRangeInt, kind ProbedScalarKind) returns ContainerBoxSlot
		if self.typeIsManaged(declared, from: self.typeNames) 'aManagedSlot'
			return ContainerBoxSlot.notImageable
		end 'aManagedSlot'

		let storageType = slotStorageType(self, declared: declared, typeNames: self.typeNames, readerFilePath: layout.declFilePath)

		if not kind.agreesWith(self.slotScalarKindOf(declared, storage: storageType)) 'aDifferentKindOfNumber'
			return ContainerBoxSlot.notImageable
		end 'aDifferentKindOfNumber'

		return ContainerBoxSlot.scalar(ImageScalarSlot.create(layout.offsetOfField(index), storageType: storageType, payload: payload))
	end 'constructionScalarSlot'

	function slotScalarKindOf(declared MaxonType, storage MaxonType) returns ProbedScalarKind
		if tagIsFloat(maxonTypeTag(storage)) 'aFloat'
			return ProbedScalarKind.float
		end 'aFloat'

		if maxonTypeTag(declared) == ValueTypeTag.boolean 'aBool'
			return ProbedScalarKind.boolean
		end 'aBool'

		if maxonTypeTag(declared) != ValueTypeTag.named 'anIntegerSlot'
			return ProbedScalarKind.integer
		end 'anIntegerSlot'

		let name = try self.typeNames.nameOf(typeNameIdOf(declared)) otherwise return ProbedScalarKind.integer

		return match self.enumInAnyFile(name) 'enum'
			declared gives ProbedScalarKind.enumCase(name)
			undeclared gives ProbedScalarKind.integer
		end 'enum'
	end 'slotScalarKindOf'

	function fieldDeclaresTypeNamed(declared MaxonType, typeName ByteArray) returns bool
		let name = try self.typeNames.nameOf(typeNameIdOf(declared)) otherwise return false
		return name.equals(typeName)
	end 'fieldDeclaresTypeNamed'

	function constructionContainerSlot(valueType MaxonType, declared MaxonType, offset ByteOffset, arena ImmortalBoxNodeArray) returns ContainerBoxSlot
		if maxonTypeTag(valueType) != ValueTypeTag.genericInstance or maxonTypeTag(declared) != ValueTypeTag.genericInstance 'notAContainer'
			return ContainerBoxSlot.notImageable
		end 'notAContainer'

		let giid = genericInstanceIdOf(valueType)

		if giid != genericInstanceIdOf(declared) 'anotherInstance'
			return ContainerBoxSlot.notImageable
		end 'anotherInstance'

		if not self.emptyContainerIsImageData(giid) 'notAnImagedContainer'
			return ContainerBoxSlot.notImageable
		end 'notAnImagedContainer'

		if not self.isArrayInstance(giid) 'aDeclaredContainersBox'
			return ContainerBoxSlot.column(ImmortalBoxColumn.create(offset, value: ImmortalBoxSlotValue.box(self.declaredContainerBoxNode(giid, nodes: arena))))
		end 'aDeclaredContainersBox'

		if self.containerElementIsOpaque(giid) 'aSharedBodysColumn'
			return ContainerBoxSlot.notImageable
		end 'aSharedBodysColumn'

		return ContainerBoxSlot.column(ImmortalBoxColumn.create(offset, value: ImmortalBoxSlotValue.emptyArray(self.arrayElementStamp(giid), elementDestroy: self.imageElementDestroyOf(giid))))
	end 'constructionContainerSlot'

	function constructionHelperDefaultSlot(callee ByteArray, layout StructLayout, index FieldIndex, declared MaxonType, arena ImmortalBoxNodeArray) returns ContainerBoxSlot
		match layout.fieldDefault(index) 'declared'
			emptyCreateHelper(helperName) then return self.constructionEmptyCreateSlot(callee, helperName: helperName, layout: layout, index: index, declared: declared, arena: arena)
			none or
			literal or
			helper then return ContainerBoxSlot.notImageable
		end 'declared'
	end 'constructionHelperDefaultSlot'

	function constructionEmptyCreateSlot(callee ByteArray, helperName ByteArray, layout StructLayout, index FieldIndex, declared MaxonType, arena ImmortalBoxNodeArray) returns ContainerBoxSlot
		if not callee.equals(helperName) 'notThisSlotsDefault'
			return ContainerBoxSlot.notImageable
		end 'notThisSlotsDefault'

		return self.constructionContainerSlot(declared, declared: declared, offset: layout.offsetOfField(index), arena: arena)
	end 'constructionEmptyCreateSlot'

	function constructionUnionCaseSlot(typeName ByteArray, caseName ByteArray, declared MaxonType, offset ByteOffset, arena ImmortalBoxNodeArray) returns ContainerBoxSlot
		if not self.fieldDeclaresTypeNamed(declared, typeName: typeName) or not self.boxedUnionCaseIsImageData(typeName, caseName: caseName) 'aPayloadCarryingCase'
			return ContainerBoxSlot.notImageable
		end 'aPayloadCarryingCase'

		return ContainerBoxSlot.column(ImmortalBoxColumn.create(offset, value: ImmortalBoxSlotValue.box(pushImageBoxNode(arena, node: ImmortalBoxNode.create(self.boxedUnionCaseImageBytes(typeName, caseName: caseName), columns: ImmortalBoxColumnArray.create(0))))))
	end 'constructionUnionCaseSlot'

	function constructionNestedSlot(nodes ProbedConstructionArray, id ElementIndex, declared MaxonType, offset ByteOffset, arena ImmortalBoxNodeArray) returns ContainerBoxSlot
		let nested = try nodes.get(id) otherwise panic("ProgramSignatures.constructionNestedSlot: node {id} is outside a {nodes.count()}-entry arena")

		if not self.fieldDeclaresTypeNamed(declared, typeName: nested.typeName) 'anotherType'
			return ContainerBoxSlot.notImageable
		end 'anotherType'

		match self.constructionBoxNode(nodes, id: id, arena: arena) 'outcome'
			described(node) then return ContainerBoxSlot.column(ImmortalBoxColumn.create(offset, value: ImmortalBoxSlotValue.box(node)))
			notImageable then return ContainerBoxSlot.notImageable
		end 'outcome'
	end 'constructionNestedSlot'

	// ⭐⭐ **CAN A BOXED UNION CASE'S BOX BE LAID DOWN AS BYTES? — the fourth shape, and the one with no
	// fields to fold: the record's bytes ARE the tag.**
	//
	// ⛔⛔ **THE QUESTION IS THE CASE'S, NEVER THE UNION'S.** A union carrying an `Array` in some other case
	// is imageable at the cases that carry nothing, because a `let` bound to `U.empty` can never become that
	// other case — its box is a tag beside slots that stay zero, and there is no payload whose address a
	// data→data relocation would have to write.
	// Reading the UNION instead would refuse every constant sentinel in this compiler's own source.
	//
	// ⚠ **THE ARITY IS ASKED HERE RATHER THAN INHERITED** from whatever noted the case: a payload-carrying
	// case admitted here would image a box whose slots the author filled as ZEROS, silently, so the
	// predicate that decides imaging states its own bound.
	function boxedUnionCaseIsImageData(typeName ByteArray, caseName ByteArray) returns bool
		let layout = self.unionCaseLayoutOf(typeName, caseName: caseName)
		return layout.payloadArityAt(requireUnionCaseIndex(layout, caseName: caseName)) == 0
	end 'boxedUnionCaseIsImageData'

	function emptyContainerIsImageData(giid GenericInstanceId) returns bool
		if self.isArrayInstance(giid) 'aManagedRecord'
			return true
		end 'aManagedRecord'

		return self.declaredContainerBoxIsImageData(giid)
	end 'emptyContainerIsImageData'

	function probedEmptyContainerImage(settled ProbedRecord) returns ProbedImage
		let giid = genericInstanceIdOf(settled.valueType)

		if not self.emptyContainerIsImageData(giid) 'aContainerBuiltByCode'
			return ProbedImage.none
		end 'aContainerBuiltByCode'

		return ProbedImage.record(self.emptyContainerImageOf(giid, valueType: settled.valueType, brand: settled.brand))
	end 'probedEmptyContainerImage'

	function probedUnionCaseImage(typeName ByteArray, caseName ByteArray) returns ProbedImage
		if not self.boxedUnionCaseIsImageData(typeName, caseName: caseName) 'aPayloadCarryingCase'
			return ProbedImage.none
		end 'aPayloadCarryingCase'

		let nodes = ImmortalBoxNodeArray.create(1, zeroed: false)
		let root = pushImageBoxNode(nodes, node: ImmortalBoxNode.create(self.boxedUnionCaseImageBytes(typeName, caseName: caseName), columns: ImmortalBoxColumnArray.create(0)))

		return ProbedImage.box(nodes, root: root, typeName: typeName, tag: ValueTypeTag.named)
	end 'probedUnionCaseImage'

	function stringTableImageOfTexts(texts ByteBlobArray, valueType MaxonType, brand ByteArray) returns TopLevelImageRecord
		let giid = genericInstanceIdOf(valueType)

		return TopLevelImageRecord.create(ImmortalRecordKind.stringTable(texts, elementDestroy: self.imageElementDestroyOf(giid)), elementSize: self.arrayElementSize(giid), elementCount: texts.count() as FullRangeInt, bytes: EmptySourceText, valueType: valueType, brand: brand, bounds: ColumnBounds.unknown)
	end 'stringTableImageOfTexts'

	// ⭐⭐⭐ **CAN A DECLARED CONTAINER'S WHOLE BOX BE LAID DOWN AS BYTES — `Map`, `Set`, and every generic
	// written the way they are?** The `Array` shape one tier out, and the first whose value is not in the
	// source at all: `Map.create()` is `return Self{}`, so the record it builds is four empty column arrays
	// and a struct pointing at them, and nothing about it can be TRANSCRIBED. It has to be EVALUATED, from
	// the declaration the shared body itself is compiled from.
	//
	// ⛔⛔ **THE FACTORY'S BODY MUST BE NOTHING BUT `Self{}`, AND THAT IS THE WHOLE OF WHAT MAKES THE
	// EVALUATION HONEST.** `functionConstructsFromParams` is the sweep's proof that the body is one `return`
	// of a record literal over its own parameters and nothing else (`Parser.noteConstructsFromParams`), and a
	// NULLARY one is `Self{}` exactly. A `create()` that computes — that sizes a table, that reads a clock —
	// answers false there, and the global is built before `main` as it always was.
	//
	// ⛔ **AND THE INSTANCE MUST BE CONCRETE.** Every column's destructor is read off THIS instance's own
	// arguments, so an instance still standing at a type parameter has no answer to give.
	export function declaredContainerBoxIsImageData(giid GenericInstanceId) returns bool
		// ⚡ **THE TWO ALLOCATION-FREE REFUSALS COME FIRST, BECAUSE THIS IS ASKED AT EVERY CONTAINER CO-OWN
		// SITE.** An `Array` is the commonest instance in the language and is marked at `capacity@16` rather
		// than in the header (`emptyContainerIsImageData`), so it belongs to the other fork entirely; a
		// layout-less instance has no box to describe. Both answers are map probes, where the arms below
		// build a qualified method name and walk the base's fields.
		if self.isArrayInstance(giid) or not self.genericInstanceHasBaseLayout(giid) 'notADeclaredContainersBox'
			return false
		end 'notADeclaredContainersBox'

		if self.instanceIsBuiltOnATypeParameter(giid) 'notConcrete'
			return false
		end 'notConcrete'

		let create = qualifiedMethodName(self.genericInstanceBaseName(giid), methodName: CreateMethod)

		if not self.functionConstructsFromParams(create) 'createComputes'
			return false
		end 'createComputes'

		match self.constFactoryConstructionAt(create) 'known'
			unfoldable then return false
			folds(layout, paramNames) then return paramNames.count() == 0 and self.everyContainerSlotIsImageData(giid, layout: layout)
		end 'known'
	end 'declaredContainerBoxIsImageData'

	// ⭐⭐⭐ **COULD A BOX OF THIS DECLARED STRUCT BE LAID DOWN AS BYTES WITH POINTER SLOTS?** —
	// `declaredContainerBoxIsImageData`'s twin over the shape whose fields the AUTHOR declared, and the
	// question a durable sink asks before choosing between a byte blit and a deep clone.
	//
	// ⛔⛔ **IT IS A TYPE QUESTION BECAUSE PROVENANCE IS NOT A COMPILE-TIME FACT.** Which record a sink is
	// handed may be a merge phi joining an imaged box with a heap one (`MmRuntime.buildMmOwn`'s header), so
	// the run-time fork has to be armed for every value of a type SOME box of which could be an image. It
	// therefore reads the DECLARATION, where `constructionFieldSlot` reads the probed VALUE, and answers yes
	// wherever that walk could: a struct it refuses has no imaged box with slots anywhere in the program.
	//
	// ⛔ **AND THE WHOLE FIELD GRAPH MUST BE DEEP-CLONEABLE**, which is the second half and not a nicety: the
	// deep road stamps `__clone_<T>`, and the cascade closure behind that symbol needs a cloner for every
	// managed field beneath it. A struct holding an OS HANDLE is `direct` at the top and carries a field
	// (`__ManagedFile`, `__ManagedDirectory`, `__ManagedSocket`) with no cascade at all, so only the
	// full-graph question refuses it — and refusing it costs an image nothing, because no fold produces a
	// handle. Such a value takes the plain co-own road instead, which is the right one for it: a second
	// OWNER of a handle box is safe where a second DESCRIPTOR is not.
	export function structBoxIsImageableWithSlots(typeName ByteArray) returns bool
		match self.structInAnyFile(typeName) 'declared'
			declared(layout) then return self.everyStructSlotIsImageable(layout) and self.structBoxHasADeepCloner(typeName)
			undeclared then return false
		end 'declared'
	end 'structBoxIsImageableWithSlots'

	// The walk behind the verdict above — split out because a `match` arm may not open a `for`. A struct of
	// SCALARS answers false: its image addresses no other object, so the blit is right for it and the deep
	// road would buy a cloner nothing needs.
	function everyStructSlotIsImageable(layout StructLayout) returns bool
		var addressesAnImageObject = false

		for i in 0 upto layout.fieldCount() 'eachField'
			match self.structImageSlotKind(layout, index: i) 'slot'
				scalar then continue
				pointer then addressesAnImageObject = true
				notImageable then return false
			end 'slot'
		end 'eachField'

		return addressesAnImageObject
	end 'everyStructSlotIsImageable'

	// ⭐ **WHAT ONE DECLARED FIELD COULD LAY DOWN AS — the TYPE-level reading of `constructionFieldSlot`,
	// admitting exactly the objects that walk admits.** A String, a Character and an existential are refused
	// there as folded values and are refused here as types, so the two readings cannot come apart.
	function structImageSlotKind(layout StructLayout, index FieldIndex) returns StructImageSlotKind
		let declared = self.fieldTypeOf(layout, index: index, into: self.typeNames)

		if not self.typeIsManaged(declared, from: self.typeNames) 'aNumber'
			return StructImageSlotKind.scalar
		end 'aNumber'

		let tag = maxonTypeTag(declared)

		if tag == ValueTypeTag.genericInstance 'aContainer'
			return self.containerSlotImageKind(genericInstanceIdOf(declared))
		end 'aContainer'

		// A declared struct or boxed union is a nested BOX, which `constructionNestedSlot` and
		// `constructionUnionCaseSlot` do lay down. Nothing else can be: a byte record carries a payload blob
		// no slot description names, and an existential is a pair the image has no shape for.
		if tagNamesADeclaredType(tag) or tag == ValueTypeTag.named 'aNestedBox'
			return StructImageSlotKind.pointer
		end 'aNestedBox'

		return StructImageSlotKind.notImageable
	end 'structImageSlotKind'

	// A container field's kind, forked on the instance as `constructionContainerSlot` forks it — an `Array` is
	// one record and a declared generic's container is a whole box, and both are addresses.
	function containerSlotImageKind(giid GenericInstanceId) returns StructImageSlotKind
		if self.isArrayInstance(giid) 'aManagedRecord'
			return StructImageSlotKind.pointer
		end 'aManagedRecord'

		if self.declaredContainerBoxIsImageData(giid) 'aDeclaredContainersBox'
			return StructImageSlotKind.pointer
		end 'aDeclaredContainersBox'

		return StructImageSlotKind.notImageable
	end 'containerSlotImageKind'

	// Has this struct a `(box) -> newBox` cloner whose WHOLE CASCADE can be emitted? The full-graph question
	// is the load-bearing half: a struct is `direct` at the top — every declared struct has a `__clone_<T>` —
	// while owning a field with no cascade at all, and `MmRuntime.noteStructCascadeNeeds` expands the stamped
	// symbol into a cloner for every managed field, so a top-level-only answer admits a stamp whose closure
	// cannot be built. `transferWalkOf` asks the pair the same way round. The strategy is then asked
	// through the very door `structBoxCloneCallee` reads the stamp off, so the gate and the callee cannot
	// disagree about a name.
	//
	// ⛔ **ONLY `direct` IS A YES, BECAUSE ONLY `direct` HAS THE ONE-ARGUMENT CALLEE THE SINK STAMPS.**
	// `__mm_own_deep` invokes the stamp as `callee(box)` and has nowhere to put a second argument, which is
	// why `structBoxCloneCallee` answers a `managedElements` strategy with a panic — so admitting one here
	// would be the gate and the resolver disagreeing about the same name, the shape this pair exists to rule
	// out. Declined, such a value takes the co-own road, which is a right answer rather than a stop.
	function structBoxHasADeepCloner(typeName ByteArray) returns bool
		if not self.aggregateSupportsDeepClone(typeName) 'someFieldHasNoCascade'
			return false
		end 'someFieldHasNoCascade'

		return match managedNameCascadeStrategy(self, declaredName: typeName, asElement: false, action: CascadeAction.clone) 'strategy'
			direct gives true
			managedElements or
			unsupported or
			throughWitness gives false
		end 'strategy'
	end 'structBoxHasADeepCloner'

	// ⭐ **THE `(box) -> newBox` A STRUCT BOX IS DEEP-COPIED THROUGH** — `genericInstanceBoxCloneCallee`'s
	// twin, resolved through `managedNameCascadeStrategy` rather than spelling `__clone_<T>` here, so the
	// symbol a sink stamps and the symbol `installStructCascades` synthesizes are one derivation.
	export function structBoxCloneCallee(typeName ByteArray) returns immutable ByteArray
		match managedNameCascadeStrategy(self, declaredName: typeName, asElement: false, action: CascadeAction.clone) 'strategy'
			direct(callee) then return callee
			managedElements then panic("ProgramSignatures.structBoxCloneCallee: `type {String.from(typeName)}` copies through an element-bearing record's 2-argument entry, which no box co-own can call — a declared struct's strategy is the `direct` per-type cloner")
			unsupported or
			throughWitness then panic("ProgramSignatures.structBoxCloneCallee: `type {String.from(typeName)}` has no deep cloner — `structBoxIsImageableWithSlots` asks the full-graph question and this same strategy before a value reaches this road")
		end 'strategy'
	end 'structBoxCloneCallee'

	// The walk behind the verdict above — split out because a `match` arm may not open a `for`. The box-size
	// agreement is checked here because the image is sized from the INSTANCE and its slots offset from the
	// LAYOUT: a disagreement would place a column past the end of the box it belongs to.
	function everyContainerSlotIsImageData(giid GenericInstanceId, layout StructLayout) returns bool
		if layout.sizeBytes() != self.genericInstanceBoxSize(giid) 'boxDisagrees'
			return false
		end 'boxDisagrees'

		let walk = BoxImageWalk.over(ImmortalBoxNodeArray.create(0))

		for i in 0 upto layout.fieldCount() 'eachField'
			// Spelled arm by arm rather than as a range: a case appended to `ContainerBoxSlot` must be
			// classified here rather than swallowed by a range whose text does not move with it.
			let laysDownAsBytes = match self.boxSlot(BoxOwner.generic(giid), layout: layout, index: i, walk: walk) 'slot'
				scalar or
				column gives true
				notImageable gives false
			end 'slot'

			if not laysDownAsBytes 'notBytes'
				return false
			end 'notBytes'
		end 'eachField'

		return true
	end 'everyContainerSlotIsImageData'

	// ⭐⭐ **WHAT ONE SLOT OF AN EMPTY DECLARED CONTAINER HOLDS — THE ONE DECIDER, asked by the verdict above
	// and by the builder below**, so a box admitted as bytes and a box laid down as bytes cannot be described
	// by two readings of one declaration.
	//
	// ⛔ **ONLY A DECLARED DEFAULT CAN ANSWER, BECAUSE `Self{}` WRITES NOTHING.** A slot with no default is
	// E3086 at the factory itself, and a slot filled by an arbitrary expression is produced by RUNNING CODE,
	// so neither has bytes to lay down.
	function boxSlot(owner BoxOwner, layout StructLayout, index FieldIndex, walk BoxImageWalk) returns ContainerBoxSlot
		match layout.fieldDefault(index) 'declared'
			none or
			helper then return ContainerBoxSlot.notImageable
			literal(given) then return self.containerBoxScalarSlot(layout, index: index, given: given)
			emptyCreateHelper then return self.boxColumnSlot(owner, layout: layout, index: index, walk: walk)
		end 'declared'
	end 'boxSlot'

	function concreteColumnSlot(column GenericInstanceId, layout StructLayout, index FieldIndex) returns ContainerBoxSlot
		return ContainerBoxSlot.column(ImmortalBoxColumn.create(layout.offsetOfField(index), value: ImmortalBoxSlotValue.emptyArray(self.arrayElementStamp(column), elementDestroy: self.imageElementDestroyOf(column))))
	end 'concreteColumnSlot'

	function nestedRecordBoxSlot(layout StructLayout, index FieldIndex, declared MaxonType, walk BoxImageWalk) returns ContainerBoxSlot
		let nested = try self.nullaryFactoryLayoutOf(declared) otherwise return ContainerBoxSlot.notImageable

		if walk.isInside(nested.name) 'aRecordThatContainsItself'
			return ContainerBoxSlot.notImageable
		end 'aRecordThatContainsItself'

		walk.enter(nested.name)
		let outcome = self.recordBoxNode(BoxOwner.plainRecord, layout: nested, size: nested.sizeBytes(), walk: walk)
		walk.leave()

		match outcome 'outcome'
			described(node) then return ContainerBoxSlot.column(ImmortalBoxColumn.create(layout.offsetOfField(index), value: ImmortalBoxSlotValue.box(node)))
			notImageable then return ContainerBoxSlot.notImageable
		end 'outcome'
	end 'nestedRecordBoxSlot'

	function nullaryFactoryLayoutOf(declared MaxonType) returns StructLayout throws AbsentError
		let name = try self.typeNames.nameOf(typeNameIdOf(declared)) otherwise throw AbsentError.absent

		match self.constFactoryConstructionAt(qualifiedMethodName(name, methodName: CreateMethod)) 'known'
			folds(layout, paramNames) then return try self.nullaryLayout(layout, paramNames: paramNames)
			unfoldable then throw AbsentError.absent
		end 'known'
	end 'nullaryFactoryLayoutOf'

	function nullaryLayout(layout StructLayout, paramNames NameRoster) returns StructLayout throws AbsentError
		if paramNames.count() != 0 'takesArguments'
			throw AbsentError.absent
		end 'takesArguments'

		return layout
	end 'nullaryLayout'

	function recordBoxNode(owner BoxOwner, layout StructLayout, size ByteOffset, walk BoxImageWalk) returns ConstStructBoxOutcome
		let scalars = ImageScalarSlotArray.create(0)
		let columns = ImmortalBoxColumnArray.create(0)

		for i in 0 upto layout.fieldCount() 'eachField'
			match self.boxSlot(owner, layout: layout, index: i, walk: walk) 'slot'
				scalar(field) then scalars.push(field)
				column(entry) then columns.push(entry)
				notImageable then return ConstStructBoxOutcome.notImageable
			end 'slot'
		end 'eachField'

		return ConstStructBoxOutcome.described(walk.pushNode(ImmortalBoxNode.create(structBoxImageBytes(size, fields: scalars), columns: columns)))
	end 'recordBoxNode'

	// A LITERAL default's slot. Only an INTEGRAL literal into an INTEGRAL slot is admitted: a float default's
	// payload is widened where a field default is filled (`Parser.constFloatBits`), and this door
	// has no construction to widen against — laying its raw `FullRangeInt` down would write an integer's bits
	// where the slot holds a double.
	function containerBoxScalarSlot(layout StructLayout, index FieldIndex, given ConstValue) returns ContainerBoxSlot
		if given.writtenNegative or not tagIsIntegral(given.tag) 'notAPlainIntegralLiteral'
			return ContainerBoxSlot.notImageable
		end 'notAPlainIntegralLiteral'

		let fieldType = self.fieldTypeOf(layout, index: index, into: self.typeNames)

		if not tagIsIntegral(maxonTypeTag(fieldType)) 'notAnIntegralSlot'
			return ContainerBoxSlot.notImageable
		end 'notAnIntegralSlot'

		return ContainerBoxSlot.scalar(ImageScalarSlot.create(layout.offsetOfField(index), storageType: slotStorageType(self, declared: fieldType, typeNames: self.typeNames, readerFilePath: layout.declFilePath), payload: given.payload))
	end 'containerBoxScalarSlot'

	// ⭐⭐ **A COLUMN SLOT, IN THE TERMS THE SHARED BODY BUILDS IT** — which is the one thing this whole shape
	// turns on. A generic's `create()` is compiled ONCE for every instantiation, so a column over one of the
	// base's own type parameters takes its `element_size@24` and `element_destroy@40` from the caller's layout
	// descriptor at RUN TIME (`Parser.emitArrayCreateOp`'s `opaqueElement` route). The image has to BE that
	// record: the key column of a `Map with (Byte, Byte)` must carry the stamp the shared body's own create
	// reads from the descriptor (`genericInstanceArgElementStamp`), or the body would index an imaged record
	// by a different geometry than one it created.
	//
	// A CONCRETE column — a `Map`'s `states`, whose element is a declared enum — is born at its own stride
	// with its own destructor, so it reads the two facts every other imaged empty container reads.
	function boxColumnSlot(owner BoxOwner, layout StructLayout, index FieldIndex, walk BoxImageWalk) returns ContainerBoxSlot
		let declared = self.fieldTypeOf(layout, index: index, into: self.typeNames)

		if maxonTypeTag(declared) == ValueTypeTag.structRef 'aNestedRecord'
			return self.nestedRecordBoxSlot(layout, index: index, declared: declared, walk: walk)
		end 'aNestedRecord'

		if maxonTypeTag(declared) != ValueTypeTag.genericInstance 'notAContainerSlot'
			return ContainerBoxSlot.notImageable
		end 'notAContainerSlot'

		let column = genericInstanceIdOf(declared)

		if not self.isArrayInstance(column) 'notAnArrayColumn'
			return ContainerBoxSlot.notImageable
		end 'notAnArrayColumn'

		if not self.containerElementIsOpaque(column) 'aConcreteColumn'
			return self.concreteColumnSlot(column, layout: layout, index: index)
		end 'aConcreteColumn'

		return self.opaqueColumnSlot(owner, column: column, layout: layout, index: index)
	end 'boxColumnSlot'

	function opaqueColumnSlot(owner BoxOwner, column GenericInstanceId, layout StructLayout, index FieldIndex) returns ContainerBoxSlot
		match owner 'owner'
			plainRecord then return ContainerBoxSlot.notImageable
			generic(giid) then return self.genericOpaqueColumnSlot(giid, column: column, layout: layout, index: index)
		end 'owner'
	end 'opaqueColumnSlot'

	function genericOpaqueColumnSlot(giid GenericInstanceId, column GenericInstanceId, layout StructLayout, index FieldIndex) returns ContainerBoxSlot
		let element = self.containerElementType(column)

		// A parameter of some OTHER declaration cannot be resolved against this instance's argument list, and
		// a field of this layout can only name its own — refused rather than asserted, because a position read
		// against the wrong `uses` list picks another argument's destructor.
		if not self.opaqueTypeParamDeclaredBy(element, typeName: layout.name) 'notThisDeclarationsParameter'
			return ContainerBoxSlot.notImageable
		end 'notThisDeclarationsParameter'

		let position = self.opaqueTypeParamPosition(element)

		return ContainerBoxSlot.column(ImmortalBoxColumn.create(layout.offsetOfField(index), value: ImmortalBoxSlotValue.emptyArray(self.genericInstanceArgElementStamp(giid, position: position), elementDestroy: self.typeParamDropCallee(giid, position: position))))
	end 'genericOpaqueColumnSlot'

	// ⭐ **THE CONTEST COLUMNS' READ AND INSTALL DOORS.** A `match` arm binds its payload IMMUTABLY and is
	// ONE statement (E3207), so a table cannot be written in the arm that reads it:
	// each install door answers the table and the caller writes through a `var` alias.

	// The claims recorded against a cross-kind contested `name`.
	function crossKindClaimsOf(name ByteArray) returns TypeNameClaimArray throws MapError
		match self.settledDeclarations().crossKindContests 'index'
			unwritten then throw MapError.keyNotFound
			entries(byName) then return try byName.get(name)
		end 'index'
	end 'crossKindClaimsOf'

	function crossKindContestsForWrite() returns CrossKindContestMap
		match self.mainThreadSettled().crossKindContests 'state'
			unwritten then break
			entries(byName) then return byName
		end 'state'

		let fresh = CrossKindContestMap.create()
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.crossKindContests = CrossKindContestTable.entries(fresh)
		return fresh
	end 'crossKindContestsForWrite'

	// Is ANY generic alias name contested? The gate two whole-program settles open with.
	function anyGenericAliasNameContested() returns bool
		match self.settledDeclarations().contestedGenericAliases 'index'
			unwritten then return false
			entries(byName) then return byName.count() > 0
		end 'index'
	end 'anyGenericAliasNameContested'

	export function anyTupleAliasNameContested() returns bool
		return self.anyMultiplyDeclaredTupleAlias()
	end 'anyTupleAliasNameContested'

	// The declaring-file group a contested alias name carries.
	function genericAliasClaimantsOf(name ByteArray) returns GenericAliasByDeclaringFile throws MapError
		match self.settledDeclarations().contestedGenericAliases 'index'
			unwritten then throw MapError.keyNotFound
			entries(byName) then return try byName.get(name)
		end 'index'
	end 'genericAliasClaimantsOf'

	function genericAliasContestsForWrite() returns ContestedGenericAliasMap
		match self.mainThreadSettled().contestedGenericAliases 'state'
			unwritten then break
			entries(byName) then return byName
		end 'state'

		let fresh = ContestedGenericAliasMap.create()
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.contestedGenericAliases = GenericAliasContestTable.entries(fresh)
		return fresh
	end 'genericAliasContestsForWrite'

	// Does a SECOND declaration disagree with `name`?
	function aliasNameIsDisagreedWith(name ByteArray) returns bool
		match self.settledDeclarations().multiplyDeclaredGenericAliases 'roster'
			unwritten then return false
			entries(names) then return names.contains(name)
		end 'roster'
	end 'aliasNameIsDisagreedWith'

	// Does any name have a second declaration at all?
	function anyAliasNameIsDisagreedWith() returns bool
		match self.settledDeclarations().multiplyDeclaredGenericAliases 'roster'
			unwritten then return false
			entries(names) then return names.count() > 0
		end 'roster'
	end 'anyAliasNameIsDisagreedWith'

	function disagreeingAliasNamesForWrite() returns DisagreeingAliasNameSet
		match self.mainThreadSettled().multiplyDeclaredGenericAliases 'state'
			unwritten then break
			entries(names) then return names
		end 'state'

		let fresh = DisagreeingAliasNameSet.create()
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.multiplyDeclaredGenericAliases = DisagreeingAliasNameRoster.entries(fresh)
		return fresh
	end 'disagreeingAliasNamesForWrite'

	// Settle a decl that produced no value: it either OWNS the defect or merely inherited one.
	function recordFailure(decl TopLevelDecl, error ConstEvalError) returns ConstEvalOutcome
		match error 'kind'
			defective(parseError) then decl.outcome = TopLevelConstant.failed(parseError)
			dependencyFailed then self.poisonIfUndecided(decl)
		end 'kind'

		return ConstEvalOutcome.failed
	end 'recordFailure'

	// Mark a decl as a casualty of someone else's defect — UNLESS a verdict was already handed to it.
	// `recordCycle` settles every member of a cycle from the inside, and those decls then unwind
	// through here carrying `dependencyFailed`; overwriting would blank the one diagnostic the cycle
	// produced.
	function poisonIfUndecided(decl TopLevelDecl)
		match decl.outcome 'state'
			// `recordCycle` already ruled on this decl.
			failed or
			poisoned then break
			evaluating then decl.outcome = TopLevelConstant.poisoned
			value then panic("ProgramSignatures.poisonIfUndecided: '{String.from(decl.name)}' holds a scalar value AND failed to evaluate — an initializer produces one or the other")
			managedValue or
			deferredRecord or
			unvalidatedRecord or
			storedRecord or
			imagedRecord or
			imagedBox then panic("ProgramSignatures.poisonIfUndecided: '{String.from(decl.name)}' holds a managed value AND failed to evaluate — an initializer produces one or the other")
			pending then panic("ProgramSignatures.poisonIfUndecided: '{String.from(decl.name)}' is `pending` while unwinding its own evaluation — `evaluateDecl` marks it `evaluating` before the walk")
		end 'state'
	end 'poisonIfUndecided'

	// **THE CYCLE.** `index` is already on `stack`, so the arc from its first appearance to the top is
	// a closed reference chain in which no member can ever be evaluated. Settle all of them here,
	// from the inside, and give exactly ONE the diagnostic.
	//
	// WHICH ONE: the LAST-DECLARED member. `stack` holds arena indices and the arena is in declaration
	// order, so that is simply the largest index in the arc — no source positions to compare. It anchors on
	// that declaration's NAME token, which is what `specs/top-level-let.md`'s `circular-dependency-error`
	// gates byte-for-byte (`3:5` — the `B` of `let B = A + 1`). Every other member is POISONED, so the
	// program reports one E2012 and not one per member.
	//
	// ⚠ THE MESSAGE NAMES THE ARC (`A, B`), NOT THE WHOLE IN-PROGRESS SET. For `X -> A -> B -> A` the set
	// would print "X, A, B", and `X` is not circular — it merely LEADS to a cycle.
	function recordCycle(index ElementIndex, stack TopLevelDeclIndexArray) returns ConstEvalOutcome
		let arcStart = self.stackPositionOf(index, stack: stack)

		let arc = DeclarationSiteArray.create(stack.count() - arcStart, zeroed: false)

		for i in arcStart upto stack.count() 'eachMember'
			let member = try stack.get(i) otherwise panic("ProgramSignatures.recordCycle: stack.get OOB at {i}")
			let memberDecl = self.declAt(member)
			arc.push(DeclarationSite.of(memberDecl, index: member))
		end 'eachMember'

		arc.sortBy(function(left DeclarationSite, right DeclarationSite) gives left.compare(right))

		var names = ""
		var owner = index

		for position in 0 upto arc.count() 'eachInDeclarationOrder'
			let member = try arc.get(position) otherwise panic("ProgramSignatures.recordCycle: arc.get OOB at {position}")

			if position > 0 'separator'
				names = "{names}, "
			end 'separator'

			names = "{names}{String.from(member.name)}"
			owner = member.index
		end 'eachInDeclarationOrder'

		let ownerDecl = self.ownDeclAt(owner)
		ownerDecl.outcome = TopLevelConstant.failed(SourceParseError.circularConstants(names, line: ownerDecl.nameLine, column: ownerDecl.nameColumn))

		for j in arcStart upto stack.count() 'eachVictim'
			let member = try stack.get(j) otherwise panic("ProgramSignatures.recordCycle: stack.get OOB at {j}")

			if member == owner 'ownsTheDiagnostic'
				continue
			end 'ownsTheDiagnostic'

			let victim = self.ownDeclAt(member)
			victim.outcome = TopLevelConstant.poisoned
		end 'eachVictim'

		return ConstEvalOutcome.failed
	end 'recordCycle'

	// Where `index` sits on the DFS stack. Its presence is a precondition — `recordCycle` is reached
	// only from the `evaluating` arm, which means this decl is on the current walk — so a miss is an
	// invariant break and not a case to handle.
	function stackPositionOf(index ElementIndex, stack TopLevelDeclIndexArray) returns ElementIndex
		for i in 0 upto stack.count() 'each'
			let member = try stack.get(i) otherwise panic("ProgramSignatures.stackPositionOf: stack.get OOB at {i}")

			if member == index 'found'
				return i
			end 'found'
		end 'each'

		let target = self.declAt(index)
		panic("ProgramSignatures.stackPositionOf: '{String.from(target.name)}' is marked `evaluating` but is not on the DFS stack — the mark and the stack fell out of lockstep")
	end 'stackPositionOf'

	// ⚠ **AN INITIALIZER'S READ IS A SECOND CONSTANT-READ DOOR BESIDE `constantValueOf`.** `let FINAL =
	// MIDDLE + 2` reads `MIDDLE` from inside an INITIALIZER, which is resolved here rather than at a use
	// site, so without this note a cross-file constant CHAIN leaves no trace and `checkUnusedExports`
	// reports every link of it as unreferenced. Both doors note through the same recorder, so the two
	// cannot come to disagree about what counts as a read.
	function notedConstantEvaluation(index ElementIndex, name ByteArray, readerFilePath FilePath, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns ConstEvalOutcome
		self.noteCrossFileConstantRead(index, name: name, readerFilePath: readerFilePath)
		return self.evaluateDecl(index, stack: stack, anchors: anchors)
	end 'notedConstantEvaluation'

	// The value `name` denotes when read from `readerFilePath` — the door a USE SITE asks through
	// (`Parser.topLevelBindingReference`), after every constant has been evaluated.
	//
	// A constant that FAILED reads as `poisoned` rather than inlining a value that does not exist: the
	// declaration's own diagnostic has already failed the build, and its readers add none of their
	// own.
	//
	// A stored binding reads as `notFound` here too — not because it is undefined, but because it is not a
	// CONSTANT and this door only answers for constants. Its reader (`Parser.parseVariableReference`)
	// asks `globalDeclFor` next, and emits a LOAD.
	export function constantValueOf(name ByteArray, readerFilePath FilePath) returns TopLevelConstantLookup
		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'lookup'
			found(index) then return self.notedConstantValue(index, name: name, readerFilePath: readerFilePath)
			notFound then return TopLevelConstantLookup.notFound
		end 'lookup'
	end 'constantValueOf'

	export function constantValueDuringSweep(name ByteArray, readerFilePath FilePath, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns TopLevelConstantLookup
		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'lookup'
			found(index) then return self.settledConstantValueAt(index, name: name, readerFilePath: readerFilePath, stack: stack, anchors: anchors)
			notFound then return TopLevelConstantLookup.notFound
		end 'lookup'
	end 'constantValueDuringSweep'

	function settledConstantValueAt(index ElementIndex, name ByteArray, readerFilePath FilePath, stack TopLevelDeclIndexArray, anchors ParserAnchors) returns TopLevelConstantLookup
		match self.notedConstantEvaluation(index, name: name, readerFilePath: readerFilePath, stack: stack, anchors: anchors) 'outcome'
			value(payload, tag, typeName) then return TopLevelConstantLookup.found(payload, tag: tag, typeName: typeName)
			failed then return TopLevelConstantLookup.poisoned
			notFound then return self.resolvedValueOf(index)
		end 'outcome'
	end 'settledConstantValueAt'

	export function integerConstantIn(name String, filePath FilePath) returns FullRangeInt
		match self.constantValueOf(freeze name.toByteArray(), readerFilePath: filePath) 'lookup'
			found(payload, tag, _) then return self.integerConstantPayload(payload, tag: tag, name: name, filePath: filePath)
			foundManaged or
			foundImageRecord or
			foundImageBox or
			recordDeferred then panic("ProgramSignatures.integerConstantIn: '{name}' in {filePath.toString()} is a managed or imaged constant, and the caller asked for a number")
			notFound or
			poisoned then panic("ProgramSignatures.integerConstantIn: {filePath.toString()} declares no constant '{name}' with a value that file can read")
		end 'lookup'
	end 'integerConstantIn'

	export function byteConstantIn(name String, filePath FilePath) returns immutable ByteArray
		match self.constantValueOf(freeze name.toByteArray(), readerFilePath: filePath) 'lookup'
			foundManaged(bytes, _) then return bytes
			found or
			foundImageRecord or
			foundImageBox or
			recordDeferred then panic("ProgramSignatures.byteConstantIn: '{name}' in {filePath.toString()} is not a text constant, and the caller asked for its bytes")
			notFound or
			poisoned then panic("ProgramSignatures.byteConstantIn: {filePath.toString()} declares no constant '{name}' with a value that file can read")
		end 'lookup'
	end 'byteConstantIn'

	function integerConstantPayload(payload FullRangeInt, tag ValueTypeTag, name String, filePath FilePath) returns FullRangeInt
		if tag != ValueTypeTag.integer 'notAnInteger'
			panic("ProgramSignatures.integerConstantIn: '{name}' in {filePath.toString()} folded to a {tag.name} constant, and the caller asked for a number")
		end 'notAnInteger'

		return payload
	end 'integerConstantPayload'

	// ⭐⭐ **THE ONE PLACE A CROSS-FILE CONSTANT READ LEAVES A TRACE, AND IT HAS TO BE HERE BECAUSE
	// NOWHERE ELSE KEEPS ONE.** A `let` with no storage is INLINED at its use site — it becomes a
	// `literal` op carrying the number — so unlike a stored binding (which emits a `globalAddr` naming its
	// `.data` label) a constant reference is invisible in the IR by the time any whole-module pass
	// runs. `checkUnusedExports` would therefore see `export let LIMIT` read from three other files as
	// read from NONE, and report E3092 on a genuinely-used constant: a WRONG ANSWER, not a missed one.
	//
	// ⚠ **ONLY CROSS-FILE READS ARE KEPT, WHICH IS WHAT MAKES IT FREE.** The array is empty for every
	// single-file program and holds one entry per cross-file constant SITE otherwise — the question the
	// check asks is "was it read from outside its declaring directory?", so a same-file read is not merely
	// uninteresting, it is not part of the answer.
	function notedConstantValue(index ElementIndex, name ByteArray, readerFilePath FilePath) returns TopLevelConstantLookup
		self.noteCrossFileConstantRead(index, name: name, readerFilePath: readerFilePath)
		return self.resolvedValueOf(index)
	end 'notedConstantValue'

	export function letCastDeclarationOf(name ByteArray, readerFilePath FilePath) returns LetCastDeclaration
		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'lookup'
			found(index) then return self.declAt(index).letCast
			notFound then return LetCastDeclaration.none
		end 'lookup'
	end 'letCastDeclarationOf'

	function noteCrossFileConstantRead(index ElementIndex, name ByteArray, readerFilePath FilePath)
		let decl = self.declAt(index)

		if decl.declFilePath.toString().equals(readerFilePath.toString()) 'sameFile'
			return
		end 'sameFile'

		self.crossFileConstantReads.push(NameInFile.create(name, readerFilePath: readerFilePath))
	end 'noteCrossFileConstantRead'

	// The cross-file constant reads this compile has seen, for `checkUnusedExports` to replay.
	export function crossFileConstantReadCount() returns ElementIndex
		return self.crossFileConstantReads.count()
	end 'crossFileConstantReadCount'

	export function crossFileConstantReadAt(index ElementIndex) returns NameInFile
		return try self.crossFileConstantReads.get(index) otherwise panic("ProgramSignatures.crossFileConstantReadAt: OOB at {index} — the caller walks this list's own count()")
	end 'crossFileConstantReadAt'

	// ⭐ **THE TYPE A TOP-LEVEL SLOT HOLDS — for `checkUnusedExports`, because REFERENCING A BINDING USES
	// ITS TYPE.** A file can write `db.sourceFiles.contains(key)` and name `db` and nothing else, while
	// depending on `Database`, on the `EntryMap` it is made of and on the `Entry` inside that. MEASURED on
	// `map-struct-bytearray/multi-file-struct-param-after-global-branch`, which reported all three.
	//
	// It supplies the interner rather than taking one, which is the whole reason it exists as its own
	// door: `resolvedGlobalOf` adopts the type INTO the table it is handed, and the caller must then walk
	// the result against THAT table — `indexTypeNames` is how it says so.
	export function globalSlotType(index ElementIndex) returns TopLevelGlobalLookup
		return self.resolvedGlobalOf(index, into: self.typeNames)
	end 'globalSlotType'

	// The top-level `let` arena, walked by `checkUnusedExports`. `declAt` is exported for the same
	// reason: the check seeds from every declaration, so it needs the arena and not a by-name probe.
	export function topLevelDeclCount() returns ElementIndex
		return self.settledDeclarations().decls.count()
	end 'topLevelDeclCount'

	// ⭐ **THE STORED-BINDING DOOR** — what `name` denotes as a top-level global with a `.data` slot, read
	// from `readerFilePath`. The twin of `constantValueOf`, and the reason the two are separate: an inlined
	// binding's use MATERIALIZES its value and a stored one's LOADS from a slot, so a caller that could not
	// tell them apart would have to guess which code to emit. It is every record `let` the
	// compiler cannot image — see `TopLevelDecl.hasStorage`.
	//
	// It resolves through the IDENTICAL scoped-then-bare probe (`declFor`), which is the whole point
	// of the storage key: this is what makes featA's `counter` and featB's
	// `counter` two slots instead of one.
	// ⚠ **`into` IS THE READER'S OWN INTERNER, and it is `returnTypeOf`'s discipline applied to a SLOT.** A
	// factory-built global's type is the callee's declared return type, which lives in THIS index's interner
	// — and a `MaxonType.structRef(id)` is meaningless outside the table that minted the id. So the type is
	// ADOPTED on the way out, exactly as a call's return type is. Every other arm's type carries no
	// interner id (a gid, a builtin, a tag) and crosses unchanged, which is why the parameter arrived only
	// when the struct arm did.
	export function globalIsAPayloadFreeUnionCase(name ByteArray, readerFilePath FilePath) returns bool
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.stored) 'lookup'
			found(index) then return declIsAPayloadFreeUnionCase(self.declAt(index))
			notFound then return false
		end 'lookup'
	end 'globalIsAPayloadFreeUnionCase'

	export function globalDeclFor(name ByteArray, readerFilePath FilePath, into TypeNameInterner) returns TopLevelGlobalLookup
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.stored) 'lookup'
			found(index) then return self.resolvedGlobalOf(index, into: into)
			notFound then return TopLevelGlobalLookup.notFound
		end 'lookup'
	end 'globalDeclFor'

	export function globalMapColumns(name ByteArray, readerFilePath FilePath) returns ColumnPair throws AbsentError
		match self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.stored) 'lookup'
			found(index) then return try self.immutableMapColumnsOf(self.declAt(index))
			notFound then throw AbsentError.absent
		end 'lookup'
	end 'globalMapColumns'

	function immutableMapColumnsOf(decl TopLevelDecl) returns ColumnPair throws AbsentError
		match decl.outcome 'state'
			storedRecord(_, _, _, mapColumns) then return try mapLiteralColumnPair(mapColumns)
			default throws AbsentError.absent
		end 'state'
	end 'immutableMapColumnsOf'

	export function bindingTypeClaimAt(index ElementIndex, into TypeNameInterner) returns BindingTypeClaim throws AbsentError
		let decl = self.declAt(index)

		match decl.outcome 'state'
			// ⚠ **A FOLDED ENUM OR UNION CASE IS TAGGED `named`, SO THIS ARM INTERNS INTO `into` TOO.** The
			// outcome carries the type's BYTES for exactly that reason — the adoption trap the boxed arm below
			// records, avoided at the source: an id minted in the INDEX's table panics the first door a file's
			// parse resolves it through (`slotStorageType` on a read, `foreignNameOf` on a store).
			value(_, tag, typeName) then return BindingTypeClaim.create(constantValueTypeIn(tag, typeName: typeName, into: into), brand: EmptySourceText)

			// ⭐ A MANAGED literal's slot is real, it
			// is just a POINTER rather than a value. Its type is the literal's own, so a read of the name
			// and a use of the literal it was initialized from are the same type by construction.
			managedValue(_, kind) then return BindingTypeClaim.create(self.managedConstValueType(kind, elementFilePath: decl.declFilePath), brand: EmptySourceText)

			storedRecord(valueType, brand, _, _) then return BindingTypeClaim.create(self.adoptType(valueType, into: into), brand: brand)
			imagedRecord(image) then return BindingTypeClaim.create(self.adoptType(image.valueType, into: into), brand: image.brand)
			imagedBox(_, _, typeName, tag) then return BindingTypeClaim.create(constantValueTypeIn(tag, typeName: typeName, into: into), brand: EmptySourceText)
			failed or
			poisoned or
			unvalidatedRecord then throw AbsentError.absent
			deferredRecord or
			pending or
			evaluating then panic("ProgramSignatures.bindingTypeClaimAt: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` and `settleRecordInitializers` run to completion before any pass reads a binding's type")
		end 'state'
	end 'bindingTypeClaimAt'

	// The `.data` label and TYPE of the global at `index` — everything a load or a store needs to
	// name it. A binding whose initializer failed reads as `poisoned`: the declaration's own diagnostic
	// has already failed the build, and a slot with no value is a slot with no bytes to emit.
	function resolvedGlobalOf(index ElementIndex, into TypeNameInterner) returns TopLevelGlobalLookup
		let decl = self.declAt(index)

		match decl.outcome 'state'
			value or
			managedValue or
			storedRecord then return self.storedGlobalFound(index, into: into)
			failed or
			poisoned or
			unvalidatedRecord then return TopLevelGlobalLookup.poisoned
			imagedRecord or
			imagedBox then return TopLevelGlobalLookup.notFound
			deferredRecord or
			pending or
			evaluating then panic("ProgramSignatures.resolvedGlobalOf: '{String.from(decl.name)}' is unevaluated at a use site — `evaluateInitializers` and `settleRecordInitializers` run to completion before any file is parsed")
		end 'state'
	end 'resolvedGlobalOf'

	function storedGlobalFound(index ElementIndex, into TypeNameInterner) returns TopLevelGlobalLookup
		let decl = self.declAt(index)
		let claim = try self.bindingTypeClaimAt(index, into: into) otherwise panic("ProgramSignatures.storedGlobalFound: '{String.from(decl.name)}' has a slot and a settled value, so `bindingTypeClaimAt` has a type to give it")

		return TopLevelGlobalLookup.found(self.slotLabelOf(decl), valueType: claim.valueType, brand: claim.brand)
	end 'storedGlobalFound'

	// ⭐ **THE `MaxonType` A MANAGED TOP-LEVEL BINDING OF `kind` DENOTES** — the SAME type its literal gives
	// a value in expression position (`Parser.emitStringLiteral` / `emitByteStringLiteralValue`), stated once
	// so a `let`'s inlined literal, a stored binding's slot, the module-init store and the cleanup's drop
	// cannot disagree about what the binding IS.
	//
	// A METHOD rather than a free function because a byte string's type is the CONCRETE `Array with Byte`
	// instance, and an instance is a gid only the interner can mint — the very `internArrayByteInstance` the
	// literal path uses, so `b"…"` has ONE type however it is reached.
	//
	// ⚠ **WHOSE `Byte` THE ELEMENT IS DEPENDS ON WHICH OF THE TWO STORAGE MODELS THE CALLER IS IN, so
	// the file is the caller's to state.** A STORED binding is one record, built once by `__module_init`
	// from its declaring file's literal, so its `.data` slot, its initializer and every load of it pass
	// `TopLevelDecl.declFilePath`. An INLINED `let` re-materializes the literal AT THE USE
	// (`Parser.emitManagedConstant`), under the reading file's own byte-string gate, so it passes the
	// READER's path — which is what makes the synthetic receiver's `varType` and the value the same emit
	// site produced one type rather than two.
	export function managedConstValueType(kind ManagedConstKind, elementFilePath FilePath) returns MaxonType
		return match kind 'k'
			string gives MaxonType.string
			byteArray gives MaxonType.genericInstance(self.internArrayByteInstance(elementFilePath))
			character gives MaxonType.character
		end 'k'
	end 'managedConstValueType'

	// The `.data` label of a STORED decl. Having storage is a precondition, not a case: an inlined binding
	// has no slot, and every caller reached this through a `stored`-filtered lookup or the same
	// `hasStorage` filter the arena walks use.
	//
	// ⚠ **IT TAKES THE DECL, NOT ITS ARENA INDEX**. Every caller already holds the
	// decl — each one fetched it to read `outcome` or `name` — so an index parameter would be a SECOND way
	// to say which declaration is meant, with nothing forcing the two to agree: a caller that paired
	// `declAt(j)` with index `i` would be answered about `i`'s label under `j`'s storage bit, which is a
	// wrong answer rather than a compile error. One parameter cannot desynchronize from itself, and it
	// drops the re-fetch this made every caller pay.
	function slotLabelOf(decl TopLevelDecl) returns immutable ByteArray
		return try decl.dataLabel.label() otherwise bareDataLabel(decl.name)
	end 'slotLabelOf'

	function dataLabelOf(decl TopLevelDecl) returns immutable ByteArray
		if not decl.hasStorage 'inlined'
			panic("ProgramSignatures.dataLabelOf: '{String.from(decl.name)}' is an inlined top-level constant and has no .data slot — a constant materializes its value at every read")
		end 'inlined'

		return try decl.dataLabel.label() otherwise panic("ProgramSignatures.dataLabelOf: top-level '{String.from(decl.name)}' has no .data label — `assignDataLabels` labels every STORED decl in the arena, and it runs inside `evaluateInitializers`")
	end 'dataLabelOf'

	export function addImagedModuleLetKinds(into HeldRecordKinds)
		for i in 0 upto self.settledDeclarations().decls.count() 'eachDecl'
			let kind = try self.imagedRecordKindOf(self.declAt(i)) otherwise continue
			into.kinds.insert(kind)
		end 'eachDecl'
	end 'addImagedModuleLetKinds'

	export function nameIsAnImagedRecordLet(name ByteArray, readerFilePath FilePath) returns bool
		match self.constantDeclFor(name, readerFilePath: readerFilePath) 'lookup'
			found(index) then return self.declIsAnImagedRecord(self.declAt(index))
			notFound then return false
		end 'lookup'
	end 'nameIsAnImagedRecordLet'

	function declIsAnImagedRecord(decl TopLevelDecl) returns bool
		_ = try self.imagedRecordKindOf(decl) otherwise return false
		return true
	end 'declIsAnImagedRecord'

	function imagedRecordKindOf(decl TopLevelDecl) returns immutable ByteArray throws AbsentError
		if decl.hasStorage 'notAnImage'
			throw AbsentError.absent
		end 'notAnImage'

		match decl.outcome 'shape'
			imagedRecord(image) then return self.canonicalInstanceName(genericInstanceIdOf(image.valueType))
			imagedBox(_, _, typeName, _) then return typeName
			deferredRecord or
			unvalidatedRecord or
			storedRecord or
			pending or
			evaluating or
			value or
			failed or
			poisoned or
			managedValue then throw AbsentError.absent
		end 'shape'
	end 'imagedRecordKindOf'

	// ⭐⭐ **DOES THIS DECLARATION STILL CONTRIBUTE STORAGE?** — the ONE filter both arena walks below
	// apply, and the whole of what makes a dead global's THREE PIECES drop TOGETHER.
	// The `.data` slot `declaredGlobals` reserves, the `__module_init` store `managedGlobals` causes and
	// the `__maxon_global_cleanup` drop it causes are all downstream of this single answer, so they cannot
	// disagree — and every way they COULD disagree is broken: a slot with no initializer holds null where
	// a record must be, an initializer with no slot stores into an address the image never laid down, and
	// a cleanup drop with no slot decrefs one.
	//
	// TWO independent reasons a declaration contributes nothing, in the order that makes the second one
	// askable: an INLINED binding has no slot at all (a `let` scalar materializes its value at every read and
	// an IMAGED record's read is one `.rdata` address, and `dataLabelOf` panics rather than inventing a label
	// for either), and a STORED binding whose label no `globalAddr` in the program names is dead.
	function contributesStorage(decl TopLevelDecl, live LiveGlobalLabelSet) returns bool
		if not decl.hasStorage 'inlinedHasNoSlot'
			return false
		end 'inlinedHasNoSlot'

		// ⛔ **THE PROGRAM'S OWN GLOBAL, WHEN ITS INITIALIZER CALLS, IS NEVER DROPPED — EVEN WHEN NOTHING
		// READS IT. A CORPUS GLOBAL IS, AND THAT EXCEPTION IS THE SECOND PARAGRAPH.** The rule discharges the
		// obligation `DeadGlobalElimination`'s header filed against the day an initializer may call, landing
		// here. Dropping the arena entry drops the `__module_init` ops
		// TOO, and for every other kind that is exactly right: they are compiler-synthesized allocation with
		// no user-visible effect. A user factory can `print`, mutate another global or throw, and
		// `specs/dead-top-level-var-elim.md:31` is explicit that "the call still runs even when the slot is
		// dead". Keeping the slot is the conservative half of that — a dead 8-byte word, never a lost effect
		// — and it is deliberately NOT a `callee.EndsWith(".create")` naming heuristic, which would make
		// renaming a method change whether its side effects run.
		//
		// ⭐ **WHERE THE BINDING WAS DECLARED DOES NOT ENTER IT — BUT WHO DECLARED IT DOES.** A `static`
		// member's initializer runs unconditionally before `main` exactly as a file-scope one's does, so the
		// two scopes are one population here. A CORPUS declaration is the exception and falls through to
		// liveness: stdlib is loaded into every compile, so keeping its slots for their effects would charge
		// every program in the language for a module it cannot reach (`TopLevelDecl.declaredByTheCorpus`).
		if not decl.declaredByTheCorpus and declRunsProgramCode(decl) 'theProgramsOwnDeclaration'
			return true
		end 'theProgramsOwnDeclaration'

		return live.contains(self.dataLabelOf(decl))
	end 'contributesStorage'

	export function globalInitCallees() returns NameRoster
		let callees = NameRoster.create(0)

		for i in 0 upto self.settledDeclarations().decls.count() 'each'
			let decl = self.declAt(i)

			if decl.declaredByTheCorpus or not declHasInitializerFunction(decl) 'notRooted'
				continue
			end 'notRooted'

			callees.push(globalInitializerName(self.dataLabelOf(decl)))
		end 'each'

		for declaration in self.liveWinningDefaults() 'eachBuiltDefault'
			callees.push(defaultInitializerName(declaration.key))
		end 'eachBuiltDefault'

		return callees
	end 'globalInitCallees'

	// ⭐ **WHAT THE CORPUS SLOT `label` NAMES CALLS**, or nothing when `label` names no corpus slot or one
	// initialized by no call. The half of the root set `globalInitCallees` deliberately does not carry; see
	// there. Answering with the SHARED EMPTY for the overwhelmingly common miss keeps this allocation-free at
	// the one call site that asks it — once per `globalAddr` op of every reached function.
	export function initCalleesOfCorpusSlot(label ByteArray) returns immutable NameRoster
		return try self.settledDeclarations().corpusSlotInitCallees.get(label) otherwise freeze NameRoster.create(0)
	end 'initCalleesOfCorpusSlot'

	// EVERY LIVE top-level global in the program, in ARENA (declaration) order, then every built
	// `default`'s slot, with the label and value its `.data` slot carries — the door the backend's
	// data-section layout asks through.
	//
	// It is asked ONCE per compile (`prepareLowering`), never per file: it is O(globals),
	// and a whole-program query under a per-file one is asked once per FILE, which is how a linear
	// walk becomes quadratic (docs/internals/query-spine.md, Whole-program queries under per-file ones).
	//
	// A binding whose initializer FAILED contributes no slot: the build has already failed on its
	// diagnostic, and there is no value to lay down.
	export function declaredGlobals(live LiveGlobalLabelSet, fileRanks FileEmissionRankMap) returns DataSectionEntryArray
		let entries = DataSectionEntryArray.create(0)

		for index in self.storedDeclarationsInPositionOrder(live, fileRanks: fileRanks) 'each'
			let decl = self.declAt(index)

			match decl.outcome 'state'
				value(payload, tag, typeName) then entries.push(DataSectionEntry.create(String.from(self.dataLabelOf(decl)), valueType: self.foldedGlobalStdType(tag, typeName: typeName, name: decl.name), value: payload, reach: DataReach.declared))
				failed or
				poisoned then continue

				managedValue(_, kind) then entries.push(self.nullPointerSlot(decl, valueType: self.managedConstValueType(kind, elementFilePath: decl.declFilePath)))
				storedRecord(valueType, _, _, _) then entries.push(self.nullPointerSlot(decl, valueType: valueType))
				imagedRecord or
				imagedBox or
				unvalidatedRecord or
				deferredRecord then panic("ProgramSignatures.declaredGlobals: '{String.from(decl.name)}' has storage but is imaged or unsettled — `contributesStorage` admits stored declarations only")
				pending or
				evaluating then panic("ProgramSignatures.declaredGlobals: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`")
			end 'state'
		end 'each'

		for declaration in self.liveWinningDefaultsInPositionOrder(fileRanks) 'eachBuiltDefault'
			entries.push(DataSectionEntry.create(String.from(defaultSlotLabel(declaration.key)), valueType: StdType.i64, value: ManagedGlobalInitialSlot, reach: DataReach.declared))
		end 'eachBuiltDefault'

		return entries
	end 'declaredGlobals'

	function storedDeclarationsInPositionOrder(live LiveGlobalLabelSet, fileRanks FileEmissionRankMap) returns DeclarationOrder
		let stored = DeclarationOrder.create(0)
		let storedPositions = DeclarationPositionArray.create(0)

		for i in 0 upto self.settledDeclarations().decls.count() 'eachDeclaration'
			let candidate = self.declAt(i)

			if not self.contributesStorage(candidate, live: live) 'noReachableSlot'
				continue
			end 'noReachableSlot'

			stored.push(i)
			storedPositions.push(DeclarationPosition.of(fileRanks, path: candidate.declFilePath, line: candidate.nameLine, column: candidate.nameColumn, kind: "the global", name: candidate.name))
		end 'eachDeclaration'

		let ordered = DeclarationOrder.create(storedPositions.count(), zeroed: false)

		for slot in declarationsInPositionOrder(storedPositions) 'each'
			ordered.push(try stored.get(slot) otherwise panic("ProgramSignatures.storedDeclarationsInPositionOrder: stored.get OOB at {slot}"))
		end 'each'

		return ordered
	end 'storedDeclarationsInPositionOrder'

	function liveWinningDefaultsInPositionOrder(fileRanks FileEmissionRankMap) returns DefaultDeclarationArray
		let winning = self.liveWinningDefaults()
		let positions = DeclarationPositionArray.create(winning.count(), zeroed: false)

		for declaration in winning 'eachWinningDefault'
			positions.push(DeclarationPosition.of(fileRanks, path: declaration.declFilePath, line: declaration.keyLine, column: declaration.keyColumn, kind: "the default", name: declaration.key))
		end 'eachWinningDefault'

		let ordered = DefaultDeclarationArray.create(positions.count(), zeroed: false)

		for slot in declarationsInPositionOrder(positions) 'each'
			ordered.push(try winning.get(slot) otherwise panic("ProgramSignatures.liveWinningDefaultsInPositionOrder: winning.get OOB at {slot}"))
		end 'each'

		return ordered
	end 'liveWinningDefaultsInPositionOrder'

	// The `.data` entry every RECORD-valued global reserves: one machine word of zero, holding the POINTER
	// `__module_init` writes before `main` — or, for an inline packed record, the VALUE it writes there.
	// One function rather than one spelling per outcome arm, because the bytes are the same zero in every
	// case.
	function nullPointerSlot(decl TopLevelDecl, valueType MaxonType) returns DataSectionEntry
		return DataSectionEntry.create(String.from(self.dataLabelOf(decl)), valueType: self.recordPointerSlotType(valueType, name: decl.name), value: ManagedGlobalInitialSlot, reach: DataReach.declared)
	end 'nullPointerSlot'

	// ⭐⭐ **THE `StdType` A RECORD-VALUED GLOBAL'S SLOT OCCUPIES** — the RECORD path's own door, and
	// a door of its own because it and `globalStdType` ask DIFFERENT questions of the same tag. That one
	// asks *"may a global's INLINE VALUE be of this tag?"*, where the value IS the `.data` bytes and the
	// tag is the whole of what they hold. This one asks *"is this record reached through a single
	// pointer?"*, where the bytes are that pointer and the tag names only what it points AT.
	//
	// ⚠⚠ **THE BARE `named` TAG MEANS DIFFERENT THINGS AT THE TWO DOORS, WHICH IS WHY NEITHER MAY SERVE THE
	// OTHER'S CALLER.** At `globalStdType` it is a folded payload-free enum or union case, whose ordinal IS
	// the `.data` bytes. Here it is a BOXED UNION's type (`enumMatchFor` reads it) — a record held by one
	// pointer, and dropped by a router that accepts the tag (`managedFieldDropCallee` takes `structRef` OR
	// `named`). Same tag, two representations, and only the caller knows which it is holding.
	//
	// ⚠ **IT IS NOT A SECOND WIDTH TABLE.** The machine word is still named exactly once, in
	// `valueTagToStdType`, which this returns through; what is local here is the REACHABILITY guard, and
	// that is the half that differs between the two callers.
	//
	// ⛔ **AN EXISTENTIAL IS THE ONE RECORD A SINGLE-POINTER SLOT CANNOT HOLD, and that refusal really is
	// the SLOT's** rather than inherited: an interface-typed value is the 16-byte fat pointer
	// `(value, witness)`, so its `.data` slot is TWO words.
	function recordPointerSlotType(valueType MaxonType, name ByteArray) returns StdType
		let tag = maxonTypeTag(valueType)

		if tag == ValueTypeTag.interfaceRef 'fatPointer'
			panic("recordPointerSlotType: top-level var '{String.from(name)}' holds an interface-typed value, which is the two-word fat pointer (value, witness) — a `.data` slot for one is TWO words, which this single-pointer door cannot express, and `Parser.requireGlobalIsNotAnExistential` refuses it at the declaration")
		end 'fatPointer'

		// A record still spelling a bare `named` other than a boxed union has no width the synthesized init
		// and cleanup can access its slot through, so it panics here rather than typing the slot.
		//
		// ⭐⭐ **A BOXED UNION IS THE ONE `named` THAT IS ALREADY CONCRETE**: every case of a boxed union is ONE
		// heap pointer, the machine word `valueTagToStdType` returns below, already dropped by
		// `managedFieldDropCallee`'s `named` arm through `__destruct_<U>`.
		if tag == ValueTypeTag.named and not self.namedTypeIsBoxedUnion(valueType) 'noConcreteSlotAccess'
			panic("recordPointerSlotType: top-level var '{String.from(name)}' holds a value of the bare name '{maxonTypeName(valueType, typeNames: self.typeNames)}' — `Parser.valueIsAScalar` settles every `named` value but a boxed union as a scalar before a record slot is typed, so reaching here means a non-union `named` value was admitted as a record")
		end 'noConcreteSlotAccess'

		// An inline packed record's slot holds its VALUE, not a pointer to it — one machine word, whose
		// initial zero `__module_init` overwrites with the word the factory computes. It answers ABOVE the
		// managed guard below, which would otherwise panic: such a value owns no heap, which is the whole
		// point of it.
		if tagNamesADeclaredType(tag) and self.nameIsInlineRecord(self.nameOfId(typeNameIdOf(valueType))) 'theSlotHoldsTheValue'
			return valueTagToStdType(tag)
		end 'theSlotHoldsTheValue'

		// A scalar reaching here is a classification drift, not a program: the record probe settles every
		// scalar initializer before a record slot is typed.
		if not self.slotTypeIsManaged(valueType) 'ownsNoHeap'
			panic("recordPointerSlotType: top-level var '{String.from(name)}' is typed '{maxonTypeName(valueType, typeNames: self.typeNames)}', which owns no heap — a record global's slot holds a POINTER, and `Parser.probedRecordOf` settles every scalar initializer before a record slot is typed")
		end 'ownsNoHeap'

		return valueTagToStdType(tag)
	end 'recordPointerSlotType'

	// ⭐ **EVERY LIVE MANAGED TOP-LEVEL GLOBAL IN THE PROGRAM, in ARENA (declaration) order** — the door
	// `installManagedGlobalInit` asks through, and the ONLY enumeration of them.
	//
	// It is the `declaredGlobals` twin and deliberately a SECOND walk rather than a widened first: that one
	// answers "what does the `.data` image hold?" (a label, a width, some bytes) and this one answers "what
	// must run before and after `main`?" (a label, the literal's bytes, its type). Fusing them would hand
	// the layout a payload it has no use for and the synthesis a `StdType` it cannot build a record from.
	//
	// Asked ONCE per compile (`prepareLowering`), never per file — it is O(declarations), and a
	// whole-program query under a per-file one is asked once per FILE, which is how a linear walk becomes
	// quadratic (docs/internals/query-spine.md, Whole-program queries under per-file ones).
	//
	// A binding whose initializer FAILED contributes nothing: the build has already failed on its diagnostic.
	export function managedGlobals(live LiveGlobalLabelSet, fileRanks FileEmissionRankMap) returns ManagedGlobalArray
		let entries = ManagedGlobalArray.create(0)

		for index in self.storedDeclarationsInPositionOrder(live, fileRanks: fileRanks) 'each'
			let decl = self.declAt(index)

			match decl.outcome 'state'
				value or
				failed or
				poisoned then continue

				managedValue(bytes, kind) then entries.push(self.managedGlobalEntry(decl, initializer: ManagedGlobalInitializer.literal(managedLiteralRecord(bytes, kind: kind)), valueType: self.managedConstValueType(kind, elementFilePath: decl.declFilePath)))
				storedRecord(valueType, _, _, _) then entries.push(self.managedGlobalEntry(decl, initializer: ManagedGlobalInitializer.initializerFunction(globalInitializerName(self.dataLabelOf(decl))), valueType: valueType))
				imagedRecord or
				imagedBox or
				unvalidatedRecord or
				deferredRecord then panic("ProgramSignatures.managedGlobals: '{String.from(decl.name)}' has storage but is imaged or unsettled — `contributesStorage` admits stored declarations only")
				pending or
				evaluating then panic("ProgramSignatures.managedGlobals: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` runs to completion inside `queryProgramSignatures`")
			end 'state'
		end 'each'

		return entries
	end 'managedGlobals'

	export function programModuleInitNeed() returns ModuleInitNeed
		for declaration in self.defaultDeclarations() 'eachDefault'
			if not declaration.isStdlibSource 'theProgramsOwn'
				return ModuleInitNeed.runsProgramCode
			end 'theProgramsOwn'
		end 'eachDefault'

		var need = ModuleInitNeed.none

		for i in 0 upto self.settledDeclarations().decls.count() 'each'
			let decl = self.declAt(i)

			if decl.declaredByTheCorpus 'theLibrarys'
				continue
			end 'theLibrarys'

			match self.initializerShapeOf(decl) 'shape'
				scalar then continue
				records then need = ModuleInitNeed.buildsRecords
				runsCode then return ModuleInitNeed.runsProgramCode
			end 'shape'
		end 'each'

		return need
	end 'programModuleInitNeed'

	// Read off the initializer's tokens and default-deny: a token not explicitly scalar- or record-shaped
	// runs code. A member read is scalar only as `.min`/`.max` or an enum or union case, and a comparison
	// runs code because it calls `equals`/`compare` on the program's own types. Over-reporting only costs
	// a spec case its batch; under-reporting would print outside every case's markers.
	function initializerShapeOf(decl TopLevelDecl) returns InitializerShape
		let tokens = self.declTokenStreamOf(decl).prepared.tokens

		if self.initializerIsALibraryContainerCreate(tokens, decl: decl) 'anEmptyLibraryContainer'
			return InitializerShape.records
		end 'anEmptyLibraryContainer'

		var shape = InitializerShape.scalar
		var previousToken = Token.create(TokenKind.equals, line: 0, column: 0)

		for position in decl.initStart upto decl.initEnd 'eachToken'
			let token = try tokens.get(position) otherwise panic("ProgramSignatures.initializerShapeOf: initializer token {position} of '{String.from(decl.name)}' is not below the declaring file's {tokens.count()} tokens")

			if tokenKindIsSkippedLayout(token.kind) 'layout'
				continue
			end 'layout'

			var tokenShape = initializerShapeOfToken(token.kind, previous: previousToken.kind)

			if token.kind == TokenKind.dot 'aMemberRead'
				tokenShape = self.memberReadShape(tokens, position: position, head: previousToken, limit: decl.initEnd)
			end 'aMemberRead'

			shape = widenedInitializerShape(shape, by: tokenShape)

			if shape == InitializerShape.runsCode 'settled'
				return shape
			end 'settled'

			previousToken = token
		end 'eachToken'

		return shape
	end 'initializerShapeOf'

	function initializerIsALibraryContainerCreate(tokens TokenArray, decl TopLevelDecl) returns bool
		let length = try emptyCreateTokenCount(tokens, start: decl.initStart) otherwise return false

		if decl.initEnd != decl.initStart + length 'notTheFactoryShape'
			return false
		end 'notTheFactoryShape'

		let head = initializerTokenAt(tokens, decl: decl, offset: 0)

		if not self.isAliasOfFormFor(head.value, readerFilePath: decl.declFilePath, wanted: FormAliasKind.generic) 'notAGenericAlias'
			return false
		end 'notAGenericAlias'

		let instance = self.genericAliasInstanceFrom(head.value, readerFilePath: decl.declFilePath)

		if length != EmptyCreateTokenCount and not self.isArrayInstance(instance) 'anArgumentOnANonArray'
			return false
		end 'anArgumentOnANonArray'

		let base = self.genericInstanceBaseName(instance)
		return self.isBuiltinGenericBaseName(base) or not (self.containsStructInAnyFile(base) or self.containsEnumInAnyFile(base))
	end 'initializerIsALibraryContainerCreate'

	function memberReadShape(tokens TokenArray, position ElementIndex, head Token, limit ElementIndex) returns InitializerShape
		if head.kind != TokenKind.identifier or position + 1 >= limit 'notANamedMember'
			return InitializerShape.runsCode
		end 'notANamedMember'

		let member = try tokens.get(position + 1) otherwise panic("ProgramSignatures.memberReadShape: member token {position + 1} is not below the declaring file's {tokens.count()} tokens")

		if member.kind == TokenKind.identifier and (member.value.equals(MinBoundField) or member.value.equals(MaxBoundField)) 'aRangeBound'
			return InitializerShape.scalar
		end 'aRangeBound'

		if self.containsEnumInAnyFile(head.value) 'aCaseOfADeclaredEnumOrUnion'
			return InitializerShape.scalar
		end 'aCaseOfADeclaredEnumOrUnion'

		return InitializerShape.runsCode
	end 'memberReadShape'

	export function initializerFunctionNameOf(decl TopLevelDecl) returns immutable ByteArray
		let recorded = self.recordedDeclFor(decl)

		if not recorded.hasStorage 'anUnresolvedInitializer'
			return self.initializerClosureHostOf(recorded)
		end 'anUnresolvedInitializer'

		return globalInitializerName(self.dataLabelOf(recorded))
	end 'initializerFunctionNameOf'

	// A binding is keyed by its name, or its namespace mint, never its path, so its closures' lifted names
	// and the bytes they reach are the same from any root
	// (`tests/cli/build-a-file-private-closure-let-builds-the-same-bytes-from-two-roots.maxtest`).
	export function initializerClosureHostOf(decl TopLevelDecl) returns immutable ByteArray
		return globalInitializerName(decl.storageKey)
	end 'initializerClosureHostOf'

	export function noteInitializerClosureShapes(shapes FunctionValueShapeMap, from TypeNameInterner)
		for (name, shape) in shapes 'eachClosure'
			let paramTypes = MaxonTypeArray.create(shape.paramTypes.count(), zeroed: false)

			for paramType in shape.paramTypes 'eachParam'
				paramTypes.push(self.adoptTypeFrom(paramType, from: from))
			end 'eachParam'

			let returnType = match shape.returnType 'returned'
				void gives MaxonReturnType.void
				value(inner) gives MaxonReturnType.value(self.adoptTypeFrom(inner, from: from))
			end 'returned'

			self.mainThreadSettled().initializerClosureShapes.upsert(name, value: FunctionValueShape.create(paramTypes, returnType: returnType, scopeFilePath: shape.scopeFilePath, promisesTaken: shape.promisesTaken.clone(), byRefParams: shape.byRefParams, isolatedParams: shape.isolatedParams))
		end 'eachClosure'
	end 'noteInitializerClosureShapes'

	export function initializerClosureShapeFor(name ByteArray, into TypeNameInterner) returns FunctionValueShape throws AbsentError
		let recorded = try self.settledDeclarations().initializerClosureShapes.get(name) otherwise throw AbsentError.absent
		let paramTypes = MaxonTypeArray.create(recorded.paramTypes.count(), zeroed: false)

		for paramType in recorded.paramTypes 'eachParam'
			paramTypes.push(self.adoptType(paramType, into: into))
		end 'eachParam'

		return FunctionValueShape.create(paramTypes, returnType: self.adoptReturnType(recorded.returnType, into: into), scopeFilePath: recorded.scopeFilePath, promisesTaken: recorded.promisesTaken.clone(), byRefParams: recorded.byRefParams, isolatedParams: recorded.isolatedParams)
	end 'initializerClosureShapeFor'

	function declInitializerCallees(decl TopLevelDecl) returns NameRoster
		if declRunsProgramCode(decl) 'runsAnInitializerFunction'
			return nameRosterOf(globalInitializerName(self.dataLabelOf(decl)))
		end 'runsAnInitializerFunction'

		return NameRoster.create(0)
	end 'declInitializerCallees'

	// One managed global's full description. Split out so each `match` arm above stays one line, and it takes
	// the TYPE its arm already built rather than re-deriving one: the drop callee is routed off that same
	// type, so the record the init builds and the drop the cleanup emits cannot name two different types.
	function managedGlobalEntry(decl TopLevelDecl, initializer ManagedGlobalInitializer, valueType MaxonType) returns ManagedGlobal
		let cleanupDrop = OwnershipCallee.named(managedFieldDropCallee(self, typeNames: self.typeNames, fieldType: valueType)) if self.typeOwesDrop(valueType, from: self.typeNames) else OwnershipCallee.inert
		return ManagedGlobal.create(self.dataLabelOf(decl), initializer: initializer, valueType: valueType, cleanupDrop: cleanupDrop, range: decl.initRange, declName: decl.name, nameLine: decl.nameLine, nameColumn: decl.nameColumn, declFilePath: decl.declFilePath, initCallees: self.declInitializerCallees(decl), threadReach: self.globalThreadReach(decl, valueType: valueType))
	end 'managedGlobalEntry'

	// A `let` is walked the way a sent message argument is, through the same door; a value packed into
	// its own slot word has no graph to walk.
	function globalThreadReach(decl TopLevelDecl, valueType MaxonType) returns GlobalThreadReach
		return match self.transferWalkOf(transferSubjectOf(maxonTypeTag(valueType), nameId: typeNameIdOf(valueType), typeNames: self.typeNames), kind: TransferKind.share, readerFilePath: decl.declFilePath) 'walk'
			closed or
			refused gives GlobalThreadReach.unmarked
			walkedBy(callee) gives GlobalThreadReach.everyThreadThrough(callee)
			walkedThroughWitness panic("globalThreadReach: `{String.from(decl.name)}` was routed a witness-read walk, and no module `let` is held at an interface type")
		end 'walk'
	end 'globalThreadReach'

	export function instancesDifferOnlyByElementDeclaration(source GenericInstanceId, target GenericInstanceId, readerFilePath FilePath) returns bool
		let sourceArgs = self.rowArgs(source)
		let targetArgs = self.rowArgs(target)

		if not self.instanceNameStem(source).equals(self.instanceNameStem(target)) or sourceArgs.count() != targetArgs.count() or not self.rowShape(source).sameAs(self.rowShape(target)) 'notOneContainerShape'
			return false
		end 'notOneContainerShape'

		for at in 0 upto sourceArgs.count() 'eachArgument'
			let sourceArg = try sourceArgs.get(at) otherwise panic("ProgramSignatures.instancesDifferOnlyByElementDeclaration: sourceArgs.get OOB at {at} below count {sourceArgs.count()}")
			let targetArg = try targetArgs.get(at) otherwise panic("ProgramSignatures.instancesDifferOnlyByElementDeclaration: targetArgs.get OOB at {at} below count {targetArgs.count()}")

			if not self.argumentsDifferOnlyByElementDeclaration(sourceArg, targetArg: targetArg, readerFilePath: readerFilePath) 'twoDifferentElements'
				return false
			end 'twoDifferentElements'
		end 'eachArgument'

		return true
	end 'instancesDifferOnlyByElementDeclaration'

	function argumentsDifferOnlyByElementDeclaration(sourceArg MaxonType, targetArg MaxonType, readerFilePath FilePath) returns bool
		if maxonTypesDenoteSame(sourceArg, b: targetArg) 'oneArgument'
			return true
		end 'oneArgument'

		if maxonTypeTag(sourceArg) == ValueTypeTag.genericInstance and maxonTypeTag(targetArg) == ValueTypeTag.genericInstance 'twoNestedInstances'
			return self.instancesDifferOnlyByElementDeclaration(genericInstanceIdOf(sourceArg), target: genericInstanceIdOf(targetArg), readerFilePath: readerFilePath)
		end 'twoNestedInstances'

		return self.elementDeclarationsAgree(sourceArg, targetArg: targetArg, readerFilePath: readerFilePath)
	end 'argumentsDifferOnlyByElementDeclaration'

	function elementDeclarationsAgree(sourceArg MaxonType, targetArg MaxonType, readerFilePath FilePath) returns bool
		if maxonTypeTag(sourceArg) != ValueTypeTag.named or maxonTypeTag(targetArg) != ValueTypeTag.named 'notTwoNamedElements'
			return false
		end 'notTwoNamedElements'

		let sourceElement = try requireDeclaredAlias(self.aliasOf(self.nameOfId(typeNameIdOf(sourceArg)), readerFilePath: readerFilePath)) otherwise return false
		let targetElement = try requireDeclaredAlias(self.aliasOf(self.nameOfId(typeNameIdOf(targetArg)), readerFilePath: readerFilePath)) otherwise return false

		if not sourceSpelledAliasName(sourceElement.name).equals(sourceSpelledAliasName(targetElement.name)) 'twoNames'
			return false
		end 'twoNames'

		return sourceElement.hasSameRangeAs(targetElement)
	end 'elementDeclarationsAgree'

	// The spelling is resolved in the callee's declaring file: read in the caller's, a caller that declares
	// its own alias of that name would take the result as its own brand. `FuncSignature.returnBrand` cannot
	// serve, because a caller's parse sees only its own file's signatures.
	export function callResultBrand(callee ByteArray) returns immutable ByteArray
		let aliasName = try self.returnAliasNameOf(callee) otherwise return EmptySourceText

		if self.returnNamesInnerAlias(callee, aliasName: aliasName) 'anInnerAliasBrandsNothing'
			return EmptySourceText
		end 'anInnerAliasBrandsNothing'

		return self.authorsAliasBrand(aliasName, readerFilePath: self.recordedReturnDeclFileOf(callee))
	end 'callResultBrand'

	// A COMPILER-RESERVED spelling (`__ManagedMemory`, the buffer surface of a byte array) brands nothing:
	// it is a surface the compiler registers over an author's instance, not a type the author declared.
	export function authorsAliasBrand(spelled ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if isCompilerReservedName(spelled) 'notAnAuthorsAlias'
			return EmptySourceText
		end 'notAnAuthorsAlias'

		return self.genericBrandOfWritten(spelled, readerFilePath: readerFilePath)
	end 'authorsAliasBrand'

	// The layout a `construct` node names. The probe recorded the node only after `Parser.requireConstructible`
	// answered `declared` for this very name, so a miss here is the declaration sweep and the arena disagreeing
	// about what a `type` is — `recordedDeclFor`'s drift guard, stated for a struct.
	function constStructLayoutOf(typeName ByteArray, declName ByteArray) returns StructLayout
		match self.structInAnyFile(typeName) 'declared'
			declared(layout) then return layout
			undeclared then panic("ProgramSignatures.constStructLayoutOf: '{String.from(declName)}' is initialized by a `{String.from(typeName)}\{…\}` literal, and no file declares `type {String.from(typeName)}` — the probe records the form only after `Parser.requireConstructible` has resolved that very layout")
		end 'declared'
	end 'constStructLayoutOf'

	// ⭐⭐ **THE DECLARATION BEHIND A FOLDED UNION CASE — THE ONE LOOKUP, AND THE ONE PLACE THAT SAYS WHAT
	// MAKES A CASE USABLE.** Both readers come through it: the imaging verdict and the image's bytes. A guard
	// on only one of those paths would leave the other free to lay down bytes for a shape its sibling refuses.
	//
	// All three refusals are invariant breaks rather than reachable cases, and each is stated HERE because
	// every caller needs all three:
	//
	//   * DECLARED — a folded case names a union the parse already resolved.
	//   * BOXED — an UNBOXED case's tag IS its value and folds to a number, so a box built for one would
	//     give every reader a pointer load over a number.
	//   * HAS THE CASE — `EnumLayout.indexOfCase` answers `caseCount()` for a name it does not hold, and that
	//     sentinel indexes nothing: left to the callers it surfaces as an internal `casePayloads.get` OOB a
	//     few frames down instead of naming the case that is missing.
	function unionCaseLayoutOf(typeName ByteArray, caseName ByteArray) returns immutable EnumLayout
		let layout = match self.enumInAnyFile(typeName) 'declared'
			declared(found) gives found
			undeclared panic("ProgramSignatures.unionCaseLayoutOf: '{String.from(typeName)}' names no declared enum or union, and yet a constant initializer folded '{String.from(caseName)}' as one of its cases")
		end 'declared'

		if not layout.carriesPayloads() 'aBareTag'
			panic("ProgramSignatures.unionCaseLayoutOf: '{String.from(typeName)}' declares no payload-carrying case, so its case '{String.from(caseName)}' is a bare TAG rather than a box — the scalar fold owns that shape")
		end 'aBareTag'

		return layout
	end 'unionCaseLayoutOf'

	// ⭐ **THE TAG SLOT, SPELLED ONCE.** The imaged box and the built box put the same number at the same
	// offset at the same width; two spellings of that is how one of them comes to move without the other.
	function unionTagSlot(layout EnumLayout, caseIndex CaseIndex) returns ImageScalarSlot
		return ImageScalarSlot.create(UnionTagOffset, storageType: MaxonType.integer, payload: layout.tagOfIndex(caseIndex))
	end 'unionTagSlot'

	function requireUnionCaseIndex(layout EnumLayout, caseName ByteArray) returns CaseIndex
		return try layout.indexOfCase(caseName) otherwise panic("ProgramSignatures.requireUnionCaseIndex: `{String.from(layout.name)}` declares no case '{String.from(caseName)}', and yet a constant initializer folded one — `Parser.constEnumCaseOfLayout` asks `hasCase` before either spelling is claimed")
	end 'requireUnionCaseIndex'

	// ⭐⭐ **THE BOX A PAYLOAD-FREE CASE IS, AS BYTES — the tag at `UnionTagOffset` and zeros to the end.**
	// It goes through `structBoxImageBytes`, the very builder a constructed struct's image uses, so an
	// imaged box and a `.rdata` struct box are laid down by one routine at one width; the size, the offset
	// and the tag are the LAYOUT's, which is what keeps this byte-identical to the box `Parser.emitEnumBox`
	// stores into for the same case.
	//
	// The slots past the tag stay zero because `emitEnumBox` pins the same deterministic 0 there, and that
	// zero is load-bearing: a NULL managed slot is what the destructor cascade's null-guard skips.
	function boxedUnionCaseImageBytes(typeName ByteArray, caseName ByteArray) returns immutable ByteArray
		let layout = self.unionCaseLayoutOf(typeName, caseName: caseName)
		let fields = ImageScalarSlotArray.create(1, zeroed: false)
		fields.push(unionTagSlot(layout, caseIndex: requireUnionCaseIndex(layout, caseName: caseName)))

		return structBoxImageBytes(layout.boxSizeBytes(), fields: fields)
	end 'boxedUnionCaseImageBytes'

	// The recorded arena entry a top-level `decl` resolves to, keyed on the decl's OWN storage key
	// rather than on a bare name (a declaration resolves to ITSELF, never through the scoped-then-bare
	// probe a USE goes through). The single get-or-panic that `declaredOutcome` and `isRedeclaredBinding`
	// share, so the drift guard below reads exactly one way at both.
	//
	// **THE DRIFT GUARD LIVES HERE.** The sweep decides what is top level by counting block depth over
	// tokens (`Parser.foldDeclaredSignaturesInto`); the real parse decides it by actually parsing.
	// Those are two readings of one question, and a miss means they disagreed — after which the
	// declaration is absent from the index, every use of it reports "undefined variable", and a correct
	// program is rejected for a reason that names nothing the user wrote. It panics instead, naming
	// the drift, in the discipline `mergeArtifact`'s span-lockstep assert follows.
	function recordedDeclFor(decl TopLevelDecl) returns TopLevelDecl
		let index = try self.settledDeclarations().declIndex.get(decl.storageKey) otherwise panic("ProgramSignatures.recordedDeclFor: the declaration sweep never recorded top-level '{String.from(decl.name)}' of {decl.declFilePath.toString()}, which the parser is dispatching at top level — the sweep's block-depth gate and the parser's structure disagree about what is top level")
		return self.declAt(index)
	end 'recordedDeclFor'

	// What the DECLARATION the real parse just read came to — the door `Parser.raiseBindingFailure`
	// asks through.
	export function declaredOutcome(decl TopLevelDecl) returns TopLevelConstant
		return self.recordedDeclFor(decl).outcome
	end 'declaredOutcome'

	// ⭐⭐ **IS THIS A DECLARATION OF A TOP-LEVEL NAME OTHER THAN THE ONE ITS KEY HOLDS? — asked of the WHOLE
	// PROGRAM, not of one file.**
	//
	// **A BINDING'S NAME IS ONE NAME PER DIRECTORY, and that is the ruling rather than an implementation
	// detail.** A name two directories declare is minted `<directory>~NAME` in its declaration's token
	// (`settleBindingMints`), so the two directories' bindings hold two keys. ⇒ two `export let LIMIT` in ONE
	// directory are one name declared twice, wherever the two files sit.
	//
	// ⛔ **EXEMPTING THAT CASE IS A SILENT WRONG ANSWER.** An arm labelled `crossFileExported` returning
	// `false` whenever the winner's file differs from this declaration's lets two files of one directory each
	// export `LIMIT`, compile clean, and hand every reader of that directory the held declaration's value,
	// with the other unreachable.
	//
	// The position comparison is what tells another declaration from the winner itself: `recordedDeclFor`
	// answers with the declaration the key holds, so a decl that is not at the winner's position is one of
	// the others.
	export function isRedeclaredBinding(decl TopLevelDecl) returns bool
		let winner = self.recordedDeclFor(decl)

		//
		// ⚠ **THE FILE TEST COMPARES THE PATH STRINGS AND DELIBERATELY NOT `FilePath.equals`.**
		// The stdlib's `equals` is the HOST FILESYSTEM's identity — case-INSENSITIVE on Windows — while every
		// "same file" question this index already answers is keyed on the raw string: `fileScopedDeclKey`
		// interpolates `declFilePath.toString()`, and `fileModuleDirectories` is keyed by it. Using `equals`
		// here would put a THIRD semantics beside those two rather than removing one, and it would pay two
		// `clone().toLower()` allocations at every top-level binding in the program. The two can only diverge
		// for paths differing in case alone, which one directory walk does not produce.
		return winner.nameLine != decl.nameLine or winner.nameColumn != decl.nameColumn or not winner.declFilePath.toString().equals(decl.declFilePath.toString())
	end 'isRedeclaredBinding'

	function resolvedValueOf(index ElementIndex) returns TopLevelConstantLookup
		let decl = self.declAt(index)

		match decl.outcome 'state'
			value(payload, tag, typeName) then return TopLevelConstantLookup.found(payload, tag: tag, typeName: typeName)
			managedValue(bytes, kind) then return TopLevelConstantLookup.foundManaged(bytes, kind: kind)
			failed or
			poisoned or
			unvalidatedRecord then return TopLevelConstantLookup.poisoned

			deferredRecord then return TopLevelConstantLookup.recordDeferred
			imagedRecord(image) then return TopLevelConstantLookup.foundImageRecord(image)
			imagedBox(nodes, root, typeName, tag) then return TopLevelConstantLookup.foundImageBox(nodes, root: root, typeName: typeName, tag: tag)
			storedRecord then return TopLevelConstantLookup.notFound
			pending or
			evaluating then panic("ProgramSignatures.resolvedValueOf: '{String.from(decl.name)}' is unevaluated at a use site — `evaluateInitializers` runs to completion before any file is parsed")
		end 'state'
	end 'resolvedValueOf'

	// An empty `Array with T`'s image: no payload, and the element's DESTRUCTOR, which is the one fact an
	// empty container has that a blob does not. Nothing is ever read out of the record — its `length@8` is 0
	// — but everything derived FROM it inherits `element_destroy@40`, and a clone off it is exactly what a
	// mutable sink is handed.
	//
	// A DECLARED generic's container is a struct box over columns of this very shape, and forks away here for
	// `emptyContainerIsImageData`'s reason — the two are marked at different offsets.
	function emptyContainerImageOf(giid GenericInstanceId, valueType MaxonType, brand ByteArray) returns TopLevelImageRecord
		if not self.isArrayInstance(giid) 'aDeclaredContainersBox'
			return self.declaredContainerBoxImageOf(giid, valueType: valueType, brand: brand)
		end 'aDeclaredContainersBox'

		return TopLevelImageRecord.create(ImmortalRecordKind.emptyContainer(self.imageElementDestroyOf(giid)), elementSize: self.arrayElementSize(giid), elementCount: 0, bytes: EmptySourceText, valueType: valueType, brand: brand, bounds: ColumnBounds.unknown)
	end 'emptyContainerImageOf'

	// ⭐⭐ **THE BOX AN EMPTY `Map`/`Set` `let` IS — built through `boxSlot`, the very decider that
	// admitted it**, so a slot cannot be judged one way and laid down another. The scalars are written into
	// the box here; the columns are named for the lowering, which is the only tier that can address one
	// image object from inside another.
	//
	// The refusal is an invariant break rather than a reachable case: only a box every slot of which that
	// decider admitted reaches this door (`declaredContainerBoxIsImageData`).
	function declaredContainerBoxImageOf(giid GenericInstanceId, valueType MaxonType, brand ByteArray) returns TopLevelImageRecord
		let nodes = ImmortalBoxNodeArray.create(0)
		let root = self.declaredContainerBoxNode(giid, nodes: nodes)

		return TopLevelImageRecord.create(ImmortalRecordKind.containerBox(nodes, root: root), elementSize: NoImmortalBoxStride, elementCount: 0, bytes: EmptySourceText, valueType: valueType, brand: brand, bounds: ColumnBounds.unknown)
	end 'declaredContainerBoxImageOf'

	// The arena node one empty declared container's box IS — the same walk whether the box is a `let`'s own
	// record or a FIELD of one, so a `Map` global and a `Map` field lay down one description.
	function declaredContainerBoxNode(giid GenericInstanceId, nodes ImmortalBoxNodeArray) returns ElementIndex
		let layout = self.containerBoxLayoutOf(giid)
		let walk = BoxImageWalk.over(nodes)

		match self.recordBoxNode(BoxOwner.generic(giid), layout: layout, size: self.genericInstanceBoxSize(giid), walk: walk) 'outcome'
			described(node) then return node
			notImageable then panic("ProgramSignatures.declaredContainerBoxNode: a field of `type {String.from(layout.name)}` lays down as no bytes, in a box `declaredContainerBoxIsImageData` admitted — that predicate is the one thing that decides imaging and it walks these very slots")
		end 'outcome'
	end 'declaredContainerBoxNode'

	// The base layout an imaged container's box is described by — read back through the SAME door the
	// admission read it through, so the fold's proof and the image's field walk cannot be about two layouts.
	function containerBoxLayoutOf(giid GenericInstanceId) returns StructLayout
		match self.constFactoryConstructionAt(qualifiedMethodName(self.genericInstanceBaseName(giid), methodName: CreateMethod)) 'known'
			folds(layout, _) then return layout
			unfoldable then panic("ProgramSignatures.containerBoxLayoutOf: generic instance {giid} is imaged but its base declares no foldable `{String.from(CreateMethod)}` — `declaredContainerBoxIsImageData` answers false for exactly that, and it is the one thing that decides imaging")
		end 'known'
	end 'containerBoxLayoutOf'

	// The element drop callee an imaged empty container names, or EMPTY when the element owns nothing. It
	// reads `columnDestroyStamp` — the one decider of which columns own what — rather than asking
	// `slotTypeIsManaged` again, so the record this global is imaged as and the record a body's `create()`
	// of the same instance is born with name one destructor.
	function imageElementDestroyOf(giid GenericInstanceId) returns OwnershipCallee
		return match self.columnDestroyStamp(self.containerElementType(giid)) 'stamp'
			// A trivial column's stamp is the number `TrivialDestructor`; an image record says the same thing
			// with an `inert` callee, which `LowerMaxonToStd.stampOwnershipWord` stamps as the zero word.
			inline gives OwnershipCallee.inert
			dropCallee(callee) gives OwnershipCallee.named(callee)
		end 'stamp'
	end 'imageElementDestroyOf'

	// **THE RESOLUTION RULE for a bare name that might be a top-level declaration.** A name two directories
	// declare is filed under each declaration's `<directory>~name` mint (`settleBindingMints`).
	//
	// ⭐ **ONE PROBE FOR BOTH KINDS, FILTERED BY `wanted`.** The probe is the
	// resolution RULE, and it is the same rule for an inlined and a stored binding — so it is written once. What
	// differs is only which kind the caller can use, and a caller asking for the wrong kind gets
	// `notFound`, which is the truth: no CONSTANT of that name is visible here, even though a stored one is.
	// A second copy of this walk for stored bindings would be free to drift on the probe order, and the failure
	// mode of that drift is silent — featA's `counter` resolving to featB's slot.
	function declFor(name ByteArray, readerFilePath FilePath, wanted DeclKind) returns TopLevelDeclLookup
		// ⭐ **THE KEY HOLDS DECLARATIONS OF EVERY TIER** — `let LIMIT` and `export let LIMIT` both file
		// here, and only the second is visible to every reader, which is what `isVisibleFrom` is asked for.
		//
		// A hidden declaration answers `notFound` rather than a refusal of its own: the reader gets
		// `Undefined variable 'LIMIT'`, which `directory-scope`'s
		// `error.an-unmarked-let-is-not-readable-from-another-directorys-body` pins.
		//
		// ⚠ **THAT ANSWER IS ONLY TRUE WHILE THE KEY HOLDS ONE DECLARATION.** `recordDecl` holds one
		// declaration per key, and `isRedeclaredBinding` refuses every other declaration of that key (E3006).
		if let exported = try self.settledDeclarations().declIndex.get(name) 'exported'
			let decl = self.declAt(exported)

			if not self.isVisibleFrom(decl.visibility, declFilePath: decl.declFilePath, readerFilePath: readerFilePath) 'outOfScope'
				return TopLevelDeclLookup.notFound
			end 'outOfScope'

			return self.lookupIfKind(exported, wanted: wanted)
		end 'exported'

		return TopLevelDeclLookup.notFound
	end 'declFor'

	// `index`, but only if the decl there is the KIND the caller can use.
	//
	// ⚠ IT DOES NOT FALL THROUGH TO ANOTHER DECLARATION. A `var counter` the reader resolves to answers
	// `notFound` to a constant reader — not some other directory's `let counter`. The alternative would be
	// worse than wrong: a constant initializer would silently reach PAST the reader's own declaration of the
	// name to somebody else's, and inline a number the author never wrote.
	function lookupIfKind(index ElementIndex, wanted DeclKind) returns TopLevelDeclLookup
		let hasStorage = self.declAt(index).hasStorage
		let isWanted = match wanted 'k'
			inlined gives not hasStorage
			stored gives hasStorage
			either gives true
		end 'k'

		return TopLevelDeclLookup.found(index) if isWanted else TopLevelDeclLookup.notFound
	end 'lookupIfKind'

	// ⭐⭐ **MAY `readerFilePath` READ THE TOP-LEVEL BINDING `name` THAT `declFilePath` DECLARES?** —
	// `calleeVisibilityFrom`'s binding-shaped twin, feeding the same rule and handing back the same verdict.
	//
	// ⚠ **IT ASKS A DIFFERENT QUESTION FROM `declFor` ABOVE.** `declFor` resolves a name FOR a reader, and a
	// declaration hidden from it is simply not found, which is what leaves a use with no binding. This asks
	// about the declaration over THERE, which is the only way to see a refusal at all.
	//
	// ⭐ **THE DECLARING PATH IS THE CALLER'S TO SUPPLY, AND FOR A STATIC MEMBER IT IS ITS TYPE'S.** A
	// `static let` may be written only in a `type` body — an `extension` is refused outright
	// (`static-variables/error.static-binding-in-an-extension`, E2015) — so a static's declaring file IS the
	// file its type is declared in, which is what lets `Parser.staticRosterVerdictFor` hand this the struct
	// layout's `declFilePath`.
	//
	// A name no declaration wears is VISIBLE: "there is no such binding" is a different mistake with a
	// different reporter, exactly as `calleeVisibilityFrom` decides it.
	export function declVisibilityFrom(name ByteArray, readerFilePath FilePath) returns SymbolVisibility
		if let wider = try self.settledDeclarations().declIndex.get(name) 'declaredAtAWiderTier'
			return self.declVisibility(wider, readerFilePath: readerFilePath)
		end 'declaredAtAWiderTier'

		return SymbolVisibility.visible
	end 'declVisibilityFrom'

	function bindingFor(name ByteArray, readerFilePath FilePath) returns DeclaredBinding
		let index = try self.settledDeclarations().declIndex.get(name) otherwise return DeclaredBinding.undeclared
		let decl = self.declAt(index)

		if not self.isVisibleFrom(decl.visibility, declFilePath: decl.declFilePath, readerFilePath: readerFilePath) 'hiddenHere'
			return DeclaredBinding.undeclared
		end 'hiddenHere'

		return DeclaredBinding.declared(decl.declFilePath)
	end 'bindingFor'

	// The verdict for the declaration at `index`. Its own name so the two probes above read one arena entry
	// each and hand `symbolVisibility` the tier and the file off the same record.
	function declVisibility(index ElementIndex, readerFilePath FilePath) returns SymbolVisibility
		let decl = self.declAt(index)
		return self.symbolVisibility(decl.visibility, declFilePath: decl.declFilePath, readerFilePath: readerFilePath)
	end 'declVisibility'

	// `declFor` restricted to the INLINED kind — the probe both constant doors share, named once so the two
	// cannot drift on which kind they meant.
	function constantDeclFor(name ByteArray, readerFilePath FilePath) returns TopLevelDeclLookup
		return self.declFor(name, readerFilePath: readerFilePath, wanted: DeclKind.inlined)
	end 'constantDeclFor'

	export function declAt(index ElementIndex) returns TopLevelDecl
		return try self.settledDeclarations().decls.get(index) otherwise panic("ProgramSignatures.declAt: decls.get OOB at {index} — every index handed out is one this arena minted")
	end 'declAt'

	function ownDeclAt(index ElementIndex) returns TopLevelDecl
		return try self.mainThreadSettled().decls.get(index) otherwise panic("ProgramSignatures.ownDeclAt: decls.get OOB at {index} — every index handed out is one this arena minted")
	end 'ownDeclAt'

	// Mix one top-level constant's ANSWER into the running hash: the key it is filed under, then its
	// VALUE.
	//
	// ⚠ **THE VALUE, AND NOT MERELY THE NAME.** This is the half a READER's parse memo depends on, and
	// the easy half to leave out. A use INLINES the constant — it becomes a `literal` op carrying the
	// number — so a file that merely reads `MAGIC` compiles differently when `MAGIC` changes, while
	// its OWN bytes, and therefore its own content hash, do not move at all. Without this, editing
	// `export let MAGIC = 42` to `43` would re-parse the declaring file and hand every reader a memo
	// with 42 still baked into it. (`QueryEngine.parseMemoKey` is the other half — see the `hash`
	// field.)
	function mixConstant(state HashDigest, decl TopLevelDecl) returns HashDigest
		let keyed = mixBytes(mixDeclaringTier(state, visibility: decl.visibility, declFilePath: decl.declFilePath), bytes: decl.storageKey)

		match decl.outcome 'o'
			value(payload, tag, typeName) then return self.mixDeclAnswer(keyed, decl: decl, payload: payload, tag: tag, typeName: typeName)

			// ⭐ **THE BYTES RIDE, for `mixDeclAnswer`'s reason applied to a managed constant.** A use
			// re-materializes the literal from exactly these bytes, so `export let G = "a"` → `"b"` changes
			// what every OTHER file compiles to while their own bytes never move. The KIND rides too: the
			// same bytes as a `String` and as a `b"…"` produce different records and different types.
			managedValue(bytes, kind) then return mixBytes(self.mixManagedKind(Hasher.combined(keyed, value: SignatureDiscriminator.constShapeManagedValue), kind: kind), bytes: bytes)

			storedRecord(valueType, brand, _, mapColumns) then return self.mixMapColumns(self.mixRecordStorage(mixBytes(self.mixType(Hasher.combined(keyed, value: SignatureDiscriminator.constShapeFactoryValue), t: valueType), bytes: brand), decl: decl), columns: mapColumns)
			imagedRecord(image) then return self.mixImageRecord(self.mixRecordStorage(mixBytes(self.mixType(Hasher.combined(keyed, value: SignatureDiscriminator.constShapeArrayValue), t: image.valueType), bytes: image.brand), decl: decl), image: image)
			imagedBox(nodes, root, typeName, tag) then return mixImageBoxTree(Hasher.combined(mixBytes(self.mixRecordStorage(Hasher.combined(keyed, value: SignatureDiscriminator.constShapeBoxedUnionValue), decl: decl), bytes: typeName), value: tag.ordinal as HashDigest), nodes: nodes, root: root, below: nodes.count())
			deferredRecord then panic("ProgramSignatures.mixConstant: '{String.from(decl.name)}' is still a deferred record — `settleRecordInitializers` settles every record before it folds the hash")

			// A constant with no value bakes no number into a reader, so every failure hashes alike —
			// but it must still hash differently from every VALUE, or `let X = compute()` becoming
			// `let X = 0` would leave a reader's memo valid. The failure's DETAILS are deliberately not
			// mixed: the build fails either way, and no reader's code depends on which diagnostic it
			// failed with.
			failed or
			unvalidatedRecord or
			poisoned then return Hasher.combined(keyed, value: SignatureDiscriminator.constShapeNoValue)
			pending or
			evaluating then panic("ProgramSignatures.mixConstant: '{String.from(decl.name)}' is unevaluated — `evaluateInitializers` folds the hash only after every walk has finished")
		end 'o'
	end 'mixConstant'

	// ⭐⭐⭐ **WHICH STORAGE MODEL A RECORD BINDING TOOK, AND THE ONE FACT THAT RIDES WITH IT — THE RULE ALL
	// THREE RECORD ARMS FORK ON, STATED HERE AND NOWHERE ELSE.**
	//
	// A STORED record's read is `globalAddr <label>` + `loadIndirect`, so its LABEL is its whole IR identity
	// and its content reaches only its declaring file's `__global_init.<label>` function. Mixing that content would be SOUND and WRONG — the "sound, and useless" key
	// `verify-warm-rebuild`'s property (b) rejects, where a keystroke in any initializer re-parses the whole
	// program.
	//
	// An IMAGED record has no slot to name at all — `assignDataLabels` labels only decls with storage, so its
	// `dataLabel` is EMPTY — and its bytes are copied into every reader instead. Leaving THOSE out is the
	// opposite failure and a WRONG ANSWER rather than a slow one: every reader's `.rdata` moves while the key
	// stands still, and each reader keeps a memo built over the old bytes.
	//
	// ⚠ **THE BIT IS `hasStorage`.** A `let` takes EITHER model — an array of scalars is `.rdata`, one of
	// managed elements has a slot (`TopLevelDecl.hasStorage`).
	//
	// Both directions are gated, and by DIFFERENT probes, because one probe cannot see both: see
	// `VerifyWarmRebuild`'s property (e).
	function mixRecordStorage(state HashDigest, decl TopLevelDecl) returns HashDigest
		if decl.hasStorage 'aSlotTheReaderLoadsFrom'
			return mixBytes(Hasher.combined(state, value: SignatureDiscriminator.recordStorageShapeSlot), bytes: try decl.dataLabel.label() otherwise EmptySourceText)
		end 'aSlotTheReaderLoadsFrom'

		return Hasher.combined(state, value: SignatureDiscriminator.recordStorageShapeImage)
	end 'mixRecordStorage'

	function mixImageRecord(state HashDigest, image TopLevelImageRecord) returns HashDigest
		let counted = self.mixColumnBounds(Hasher.combined(Hasher.combined(state, value: image.elementCount as HashDigest), value: image.elementSize as HashDigest), bounds: image.bounds)

		match image.kind 'kind'
			constBlob then return mixBytes(counted, bytes: image.bytes)
			emptyContainer(elementDestroy) then return mixOwnershipCallee(counted, callee: elementDestroy)
			stringTable(texts, elementDestroy) then return mixOwnershipCallee(self.mixImageTexts(counted, texts: texts), callee: elementDestroy)
			containerBox(nodes, root) then return mixImageBoxTree(counted, nodes: nodes, root: root, below: nodes.count())
		end 'kind'
	end 'mixImageRecord'

	function mixMapColumns(state HashDigest, columns MapLiteralColumns) returns HashDigest
		match columns 'mapShape'
			none then return Hasher.combined(state, value: SignatureDiscriminator.mapColumnsNone)
			columns(keys, values) then return self.mixColumnBounds(self.mixColumnBounds(Hasher.combined(state, value: SignatureDiscriminator.mapColumnsColumns), bounds: keys), bounds: values)
		end 'mapShape'
	end 'mixMapColumns'

	// A reader copies a constant image's and an immutable map's column bounds into its own code
	// (`Parser.emitImagedConstArrayLiteral`, `Parser.noteGlobalLetMapColumns`). `[1, -1]` and
	// `[1, u64.max]` have identical bytes and differ only here, so a key without the bounds would
	// leave a reader's memo with the old ones baked in.
	function mixColumnBounds(state HashDigest, bounds ColumnBounds) returns HashDigest
		match bounds 'boundsShape'
			unknown then return Hasher.combined(state, value: SignatureDiscriminator.columnBoundsUnknown)
			integers(low, high) then return self.mixColumnRange(Hasher.combined(state, value: SignatureDiscriminator.columnBoundsIntegers), low: low, high: high)
			unsignedIntegers(low, high) then return self.mixColumnRange(Hasher.combined(state, value: SignatureDiscriminator.columnBoundsUnsignedIntegers), low: low, high: high)
			floats(low, high) then return self.mixColumnRange(Hasher.combined(state, value: SignatureDiscriminator.columnBoundsFloats), low: low, high: high)
		end 'boundsShape'
	end 'mixColumnBounds'

	function mixColumnRange(state HashDigest, low FullRangeInt, high FullRangeInt) returns HashDigest
		return Hasher.combined(Hasher.combined(state, value: low as HashDigest), value: high as HashDigest)
	end 'mixColumnRange'

	function mixImageTexts(state HashDigest, texts ByteBlobArray) returns HashDigest
		var mixed = state

		for text in texts 'eachText'
			mixed = mixBytes(mixed, bytes: text)
		end 'eachText'

		return mixed
	end 'mixImageTexts'

	// Mix a managed constant's KIND. Its own discriminator per kind, so `let G = "ab"` and a
	// hypothetical byte-string of the same bytes hash apart — they materialize different records and
	// give the reader a different TYPE, which is exactly the acceptance a stale memo would keep.
	function mixManagedKind(state HashDigest, kind ManagedConstKind) returns HashDigest
		return match kind 'k'
			string gives Hasher.combined(state, value: SignatureDiscriminator.managedShapeString)
			byteArray gives Hasher.combined(state, value: SignatureDiscriminator.managedShapeByteArray)
			character gives Hasher.combined(state, value: SignatureDiscriminator.managedShapeCharacter)
		end 'k'
	end 'mixManagedKind'

	// ⭐⭐ **MIX WHAT A READER COPIES — AND A STORED BINDING'S READER COPIES NOTHING OF ITS VALUE.**
	//
	// Getting this backwards costs incrementality rather than correctness, which is exactly why it is
	// worth being exact about.
	//
	//   • An inlined `let`'s VALUE is COPIED INTO every reader — a use becomes a `literal` op carrying the
	//     number — so `let X = 7` → `8` changes what other files COMPILE TO while their own bytes
	//     never move. Only this hash can carry that. (`verify-warm-rebuild` property 3(c).)
	//
	//   • A stored binding's value is copied into NOTHING. A reader emits `globalAddr __data_X` +
	//     `loadIndirect` and that is byte-identical whatever the initializer held — the value
	//     reaches only the `.data` IMAGE, which is rebuilt from the arena whenever this query misses.
	//     `globalDeclFor` hands a use site `(label, tag)` and no payload (`TopLevelGlobalLookup`).
	//
	// So a stored binding mixes its TAG and its LABEL and stops there:
	//   - the TAG because it decides the load's WIDTH (`i1` moves one byte, `i64` eight);
	//   - the LABEL because it IS the reader's IR identity — the slot the emitted `globalAddr` names.
	//
	// ⚠ Mixing the PAYLOAD too would be SOUND and WRONG: it would re-parse every file in the program
	// whenever any stored global's initial value moved, which is precisely the "sound, and useless"
	// failure `verify-warm-rebuild`'s property (b) exists to reject — the composite-source-hash key
	// wearing a different hat.
	// ⚠ **THE FORK IS `hasStorage`, WHICH IS THE ONE THE RECORD ARMS ASK** (`mixRecordStorage`). Only the
	// record settles (`settleStoredRecord`, `settleImagedOutcome`) write the bit and no scalar goes through
	// them, so a folded SCALAR takes the inlined arm today; the fork is written as the question the record
	// arms ask because "does a reader bake this?" answered two ways in one function is how the two would
	// come to disagree the day a third storage model exists.
	function mixDeclAnswer(state HashDigest, decl TopLevelDecl, payload FullRangeInt, tag ValueTypeTag, typeName ByteArray) returns HashDigest
		if not decl.hasStorage 'inlinedBakesItsValue'
			return self.mixConstantValue(state, payload: payload, tag: tag, typeName: typeName)
		end 'inlinedBakesItsValue'

		return mixBytes(self.mixValueTag(Hasher.combined(state, value: SignatureDiscriminator.constShapeValue), tag: tag, typeName: typeName), bytes: try decl.dataLabel.label() otherwise EmptySourceText)
	end 'mixDeclAnswer'

	// The TAG rides the hash beside the payload: a `boolean` 1 and an `integer` 1 are the same number
	// and different values, and they compile to different code (an i1 versus an i64).
	function mixConstantValue(state HashDigest, payload FullRangeInt, tag ValueTypeTag, typeName ByteArray) returns HashDigest
		return Hasher.combined(self.mixValueTag(Hasher.combined(state, value: SignatureDiscriminator.constShapeValue), tag: tag, typeName: typeName), value: payload as HashDigest)
	end 'mixConstantValue'

	// Mix a FOLDED LITERAL's TAG. Shared by both arms of `mixDeclAnswer`, so an inlined and a stored binding
	// cannot come to disagree about what distinguishes a bool from an int — the difference between
	// them is which EXTRA facts ride along (a constant's payload; a stored binding's label), never this one.
	//
	// ⭐ **AND SHARED WITH THE STRUCT FIELD DEFAULT** (`mixDefaultLiteral`), which is the same question
	// about the same three tags: a `boolean` 1 and an `integer` 1 are the same number and different
	// values. A second tag→shape mapping would be one lattice hashed from three directions instead of
	// two, and a tag that hashed differently depending on which door it came through is a cache that
	// answers a stale parse for a changed file — the very failure the `typeShapeFloat` reuse below was
	// introduced to prevent.
	//
	// Exhaustive over `ValueTypeTag`, and the unreachable arms panic rather than hashing. A folded
	// constant is a body's known value (`Parser.constValueOfKnown`: a boolean, integer, exit code, float or
	// enum case) or an inline record's word, and a LITERAL field DEFAULT is a TOKEN-KIND lookup over exactly
	// three literal kinds (`Parser.readFieldDefaultLiteral`, entered only after `Parser.defaultRegionIsLiteral`
	// has said the whole default IS one of those three). So each arm's argument below is stated for the
	// constant — the producer that can reach furthest — and holds a fortiori for the field default. Hashing
	// the rest "just in case" would be inventing a key for a value that cannot exist, and the day one can,
	// this is where it must be decided rather than defaulted.
	//
	// ⚠ **AN EXPRESSION FIELD DEFAULT NEVER REACHES HERE AT ALL** — it is a `FieldDefault.helper`,
	// which `mixFieldDefault` hashes as a presence bit and never as a value. This door stays the
	// three-literal question.
	//
	// `let PI = 3.14` and `var ratio = 2.5 as Ratio` are constants, so a float tag is REACHABLE and
	// gets the one thing a content hash owes it — a distinct key. It reuses `typeShapeFloat`, the
	// shape `mixType` already gives a float from the `MaxonType` side: the two functions hash one
	// lattice from two directions, and a float that hashed differently depending on which door it
	// came through is a cache that answers a stale parse for a changed file.
	function mixValueTag(state HashDigest, tag ValueTypeTag, typeName ByteArray) returns HashDigest
		match tag 'k'
			// An `integer` or `float` constant's `typeName` is the typealias it carries, mixed for the
			// `named` arm's reason: `5 as Tally` and `5 as Count` are different values.
			integer then return mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeInteger), bytes: typeName)
			boolean then return Hasher.combined(state, value: SignatureDiscriminator.typeShapeBoolean)
			float then return mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeFloat), bytes: typeName)

			// ⭐⭐ **`named` IS REACHABLE, AND THE NAME RIDES WITH THE SHAPE.** A PAYLOAD-FREE ENUM CASE's
			// value is its tag and its type is the enum (`let JumpTableBaseReg = X64Register.r10`), so this
			// arm may not panic.
			//
			// ⚠ **THE BYTES ARE MIXED, NOT ONLY THE SHAPE, and leaving them out would be a stale-cache bug
			// rather than a coarse key.** Two enums' cases collide constantly — every enum's first case has
			// tag 0 — so `let a = Reg.rcx` and `let a = CharClass.other` would hash IDENTICALLY on shape plus
			// payload alone, and a file edited from one to the other would be answered from the other's parse.
			// That is exactly the failure this function's own header names two arms down.
			named then return mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeNamed), bytes: typeName)
			exitCode then return mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeExitCode), bytes: typeName)
			unresolved or
			void then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — only booleans, integers, exit codes, floats, enum cases and inline records are ever folded")

			// Only an INLINE PACKED record reaches this arm: the probe settles a heap record as a record,
			// never as a scalar (`Parser.probedRecordOf`), so what is hashed here is the type's own word and
			// never a box address. The bytes ride with the shape for the `named` arm's reason — two inline records
			// of identical widths are different types, and a file edited from one to the other must not be
			// answered from the other's parse.
			structRef then return mixBytes(Hasher.combined(state, value: SignatureDiscriminator.typeShapeStructRef), bytes: typeName)

			// A String top-level binding never reaches here: a managed literal folds to
			// `TopLevelConstant.managedValue`, whose hash is `mixConstant`'s own arm (the BYTES and the KIND
			// ride there), so it never comes through `mixDeclAnswer` to this tag-only door at all.
			string then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a managed binding hashes through `mixConstant`'s `managedValue` arm, never through this one")

			// A FUNCTION top-level binding never reaches here: a function value is never a known scalar, so
			// no initializer folds to a `function`-tagged value; it is a record global.
			function then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a function value is a record global, which hashes through `mixConstant`'s record arms, never through this one")

			// A TYPE-PARAMETER / GENERIC-INSTANCE top-level binding is unreachable for
			// `structRef`'s reason: neither is a folded scalar constant, so no initializer folds to one. A `b"…"` global IS a generic instance, but it hashes through
			// `mixConstant`'s `managedValue` arm and never reaches this tag-only door.
			typeParameter then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a type parameter names no value at module scope")
			genericInstance then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a `b\"…\"` global hashes through `mixConstant`'s `managedValue` arm, never through this one")

			// A CHARACTER top-level binding never reaches here: a character is a record global, which hashes
			// through `mixConstant`'s record arms.
			character then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a character is a record global, which hashes through `mixConstant`'s record arms, never through this one")

			// Unreachable for `structRef`'s reason: an existential is only ever built by widening a value no
			// initializer folds, so none is ever a top-level constant to hash.
			cstring then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — a `cstring` comes out of a call, and a call's result is never a known constant")
			interfaceRef then panic("ProgramSignatures.mixValueTag: a folded literal is tagged '{typeTagName(tag)}' — an interface-typed value is built by widening a conformer, which is not a constant initializer")
		end 'k'
	end 'mixValueTag'

	// The ranged typealias `name` denotes when read FROM `readerFilePath` — the reader's OWN file's
	// declaration first, then one the reader may actually NAME, and only then anyone else's
	// (`RangedAliasRegistry.lookup`, which carries the whole rule and its E3063 boundary). THE door the
	// shift rule asks through — see `Parser.valueIsUnsigned` — and the reason a file's `int(0 to 500)`
	// governs the casts written in it even where another file declares that name more widely.
	// ⛔⛔ **AND IT IS KIND-GATED, WHICH `RangedAliasRegistry.lookup` BENEATH IT CANNOT BE.** That door is
	// reader-aware about the RANGE — whose `int(0 to 10)` does this file mean — and knows nothing of a name
	// two KINDS hold, so its `byName` fallback would hand a file that means an `enum` another file's ALIAS,
	// and refuse that file's own `returns Level` against a declaration its author never saw.
	//
	// ⭐ **THE GATE IS HERE AND NOT AT THE CALL SITES**, because this is the complete site: every one of
	// them already passes a reader, so a caller cannot reach the registry without going through this
	// question. `readerMeansKind` is an empty-map probe in every program that contests nothing.
	export function aliasOf(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		if not self.readerMeansKind(name, readerFilePath: readerFilePath, kind: TypeDeclKind.rangedAlias) 'thisFileMeansAnotherDeclaration'
			return DeclaredAlias.undeclared
		end 'thisFileMeansAnotherDeclaration'

		return self.settledDeclarations().typeAliases.lookup(name, readerFilePath: readerFilePath)
	end 'aliasOf'

	export function aliasIdentityDisplay(identity ByteArray) returns String
		if isTupleTypeName(identity) 'aTupleName'
			return self.typeDisplayName(MaxonType.structRef(self.typeNames.intern(self.canonicalNameOfStruct(identity))))
		end 'aTupleName'

		if identity.equals(SynthesizedByteElementName) 'theCompilersOwnByteElement'
			return self.libraryByteDisplay()
		end 'theCompilersOwnByteElement'

		if not isMintName(identity) 'noMintQualifiesIt'
			if let id = try self.renderedInstanceOfUnclaimedName(identity) 'aCanonicalInstanceName'
				return self.instanceSourceDisplay(id)
			end 'aCanonicalInstanceName'

			return String.from(aliasBaseName(identity))
		end 'noMintQualifiesIt'

		match self.settledDeclarations().typeAliases.declarationInAnyFile(identity) 'mint'
			undeclared then return self.displayOfUnrangedMint(identity)
			declared(alias) then return self.contestedDeclarationSpelling(aliasBaseName(alias.name), declFilePath: alias.declFilePath)
		end 'mint'
	end 'aliasIdentityDisplay'

	function displayOfUnrangedMint(identity ByteArray) returns String
		let declaringFiles = self.genericAliasMintDeclaringFiles(identity)

		if declaringFiles.count() > 0 'aGenericAliasMint'
			return self.contestedDeclarationSpelling(aliasBaseName(identity), declFilePath: try declaringFiles.get(0) otherwise panic("ProgramSignatures.displayOfUnrangedMint: get(0) on a list whose count was just read as nonzero"))
		end 'aGenericAliasMint'

		match self.settledDeclarations().functionTypeAliases.declarationInAnyFile(identity) 'functionAlias'
			declared(alias) then return self.contestedDeclarationSpelling(aliasBaseName(alias.name), declFilePath: alias.declFilePath)
			undeclared then break
		end 'functionAlias'

		if isTupleTypeName(identity) 'aTuple'
			return self.displayNameOfAggregate(ValueTypeTag.structRef, aggregate: identity)
		end 'aTuple'

		if let id = try self.renderedInstanceOfUnclaimedName(identity) 'anInstance'
			return self.instanceSourceDisplay(id)
		end 'anInstance'

		if let owner = try self.instanceOwningAliasMint(identity) 'anInstanceScopedAlias'
			return "{String.from(sourceSpelledAliasName(identity))} of {self.instanceSourceDisplay(owner)}"
		end 'anInstanceScopedAlias'

		panic("ProgramSignatures.displayOfUnrangedMint: '{String.from(identity)}' carries a mint and is neither a declaration's mint, a function alias's mint, a tuple nor the canonical name of an interned instance — no registry can say what it denotes, and printing it would show a spelling no source holds")
	end 'displayOfUnrangedMint'

	// An alias declared inside a generic instance is minted `<alias><separator><instance>`. Splitting at the
	// first separator is sound because a source-spelled alias name cannot contain one.
	function instanceOwningAliasMint(identity ByteArray) returns GenericInstanceId throws MapError
		let split = try firstSeparatorIndex(identity, separator: CompilerMintSeparatorByte)
		return try self.renderedInstanceOfUnclaimedName(try identity.slice(split + 1, endIndex: identity.count()) otherwise panic("ProgramSignatures.instanceOwningAliasMint: the slice past the separator at {split} of a {identity.count()}-byte name is in range"))
	end 'instanceOwningAliasMint'

	function instanceSourceDisplay(id GenericInstanceId) returns String
		if let alias = try self.settledDeclarations().instanceDisplayNames.get(id) 'anAliasSpellsIt'
			return String.from(alias)
		end 'anAliasSpellsIt'

		return String.from(self.renderedInstanceWith(id, spelling: InstanceArgSpelling.asWritten))
	end 'instanceSourceDisplay'

	function libraryByteDisplay() returns String
		for claim in self.ambiguityClaimsOf(ByteElementTypeName) 'eachByteDeclaration'
			if claim.declaredByTheCorpus 'theLibrarys'
				return self.contestedDeclarationSpelling(ByteElementTypeName, declFilePath: claim.declFilePath)
			end 'theLibrarys'
		end 'eachByteDeclaration'

		return String.from(ByteElementTypeName)
	end 'libraryByteDisplay'

	function nameableByAuthors(declFilePath FilePath) returns bool
		return self.declaredInTheStdlib(declFilePath) or self.declaredInTheScriptlib(declFilePath) or not self.declaredByTheCorpus(declFilePath)
	end 'nameableByAuthors'

	function namespaceKeyOf(declFilePath FilePath) returns String
		return StdlibDirName if self.declaredInTheStdlib(declFilePath) else self.moduleDirectoryOf(declFilePath)
	end 'namespaceKeyOf'

	function qualifiersOf(base ByteArray) returns DeclarationQualifiers
		let qualifiers = DeclarationQualifiers.create()

		for claim in self.ambiguityClaimsOf(base) 'eachClaim'
			if self.nameableByAuthors(claim.declFilePath) 'nameable'
				qualifiers.noteNameableFile(claim.declFilePath, namespace: self.namespaceKeyOf(claim.declFilePath))
			end 'nameable'
		end 'eachClaim'

		return qualifiers
	end 'qualifiersOf'

	// The default memo walks every claimant of `base` on each call. A pass that spells many sites
	// passes one memo for its whole run, or it costs sites x claimants.
	export function contestedDeclarationSpelling(base ByteArray, declFilePath FilePath, memo DeclarationQualifierMemo = DeclarationQualifierMemo.create()) returns String
		if not memo.qualifiersFor(self, base: base).tellsApart(declFilePath, namespace: self.namespaceKeyOf(declFilePath)) 'noQualifierTellsItApart'
			return String.from(base)
		end 'noQualifierTellsItApart'

		if not self.nameableByAuthors(declFilePath) 'aTierNoAuthorCanName'
			return String.from(base)
		end 'aTierNoAuthorCanName'

		if self.declaredInTheStdlib(declFilePath) 'theLibrarys'
			return String.from(namespaceQualifiedName(StdlibDirName, name: base))
		end 'theLibrarys'

		let directory = moduleDirectoryRelativeTo(self.projectRootModuleDirectory, directory: self.moduleDirectoryOf(declFilePath))

		if directory.isEmpty() 'theRoot'
			return String.from(base)
		end 'theRoot'

		return qualifiedCandidateName(directory, bare: base)
	end 'contestedDeclarationSpelling'

	export function aliasOrInnerAliasOf(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		match self.aliasOf(name, readerFilePath: readerFilePath) 'fileScope'
			declared(alias) then return DeclaredAlias.declared(alias)
			undeclared then return self.innerAliasOf(name)
		end 'fileScope'
	end 'aliasOrInnerAliasOf'

	export function declaredAliasOfSpelling(spelling ByteArray, readerFilePath FilePath) returns DeclaredAlias
		let written = self.writtenAlias(spelling, readerFilePath: readerFilePath, wanted: WantedAliasKinds.ranged)
		return self.aliasOf(written.keyOf(), readerFilePath: written.meaningFileOf())
	end 'declaredAliasOfSpelling'

	// ⭐⭐ **THE NOMINAL IDENTITY OF THE RANGED TYPEALIAS `spelling` DENOTES FOR `readerFilePath` — the whole
	// of what makes a `typealias` a type of its own.** The identity is the DECLARATION: `Age` and `Year` over
	// one range are two types, and so are two declarations of one name wherever an author's declaration takes
	// part, each answering to its own mint (`RangedAliasRegistry.identityOfName`). `EmptySourceText` where
	// the reader means no ranged alias by it.
	//
	// ⚠ **THE ANSWER IS SPENT AS AN IDENTITY, NEVER AS A RANGE.** Two declarations of one name may hold two
	// RANGES; the range is per-file and enforced where the file is known (`InsertRangeChecks`).
	//
	// ⚠ Kind-gated for `aliasOf`'s reason, and a name two KINDS hold takes a minted spelling so the alias
	// half and the nominal half cannot answer to one identity.
	export function rangedIdentityOfSpelling(spelling ByteArray, readerFilePath FilePath) returns immutable ByteArray
		let written = self.writtenAlias(spelling, readerFilePath: readerFilePath, wanted: WantedAliasKinds.ranged)
		return self.rangedIdentityOfKey(written.keyOf(), readerFilePath: written.meaningFileOf())
	end 'rangedIdentityOfSpelling'

	function libraryAliasDeclaringFile(name ByteArray) returns FilePath throws MapError
		for claim in self.ambiguityClaimsOf(name) 'eachDeclaration'
			if claim.declaredByTheCorpus and claim.kind == TypeDeclKind.rangedAlias 'theLibrarys'
				return claim.declFilePath
			end 'theLibrarys'
		end 'eachDeclaration'

		throw MapError.keyNotFound
	end 'libraryAliasDeclaringFile'

	export function libraryAliasType(name ByteArray, into TypeNameInterner) returns MaxonType
		return MaxonType.named(into.intern(self.libraryAliasIdentity(name)))
	end 'libraryAliasType'

	export function libraryAliasIdentity(name immutable ByteArray) returns immutable ByteArray
		let declaringFile = try self.libraryAliasDeclaringFile(name) otherwise return name
		return self.rangedIdentityOfSpelling(name, readerFilePath: declaringFile)
	end 'libraryAliasIdentity'

	export function settleSynthesizedNominals()
		self.mainThreadSettled().interfaces.recordSynthesizedNominal(HashValueTypeName, identity: self.libraryAliasIdentity(HashValueTypeName))
		self.mainThreadSettled().interfaces.recordSynthesizedNominal(OrderingTypeName, identity: self.libraryAliasIdentity(OrderingTypeName))
	end 'settleSynthesizedNominals'

	export function libraryAliasDeclaration(name ByteArray) returns DeclaredAlias
		let declaringFile = try self.libraryAliasDeclaringFile(name) otherwise return self.settledDeclarations().typeAliases.declarationInAnyFile(name)
		return self.declaredAliasOfSpelling(name, readerFilePath: declaringFile)
	end 'libraryAliasDeclaration'

	function rangedIdentityOfKey(key immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if self.isInnerAlias(key) 'nestedAlias'
			return key
		end 'nestedAlias'

		let spelled = sourceSpelledAliasName(key)

		if not self.readerMeansKind(spelled, readerFilePath: readerFilePath, kind: TypeDeclKind.rangedAlias) 'thisFileMeansAnotherDeclaration'
			return EmptySourceText
		end 'thisFileMeansAnotherDeclaration'

		if self.settledDeclarations().typeAliases.hasIdentityContest(spelled) 'everyDeclarationIsItsOwnType'
			return self.settledDeclarations().typeAliases.identityOfName(spelled, name: key, readerFilePath: readerFilePath)
		end 'everyDeclarationIsItsOwnType'

		if self.crossKindContested(spelled) 'twoKindsHoldTheName'
			return self.settledDeclarations().typeAliases.crossKindIdentityOf(spelled, readerFilePath: readerFilePath)
		end 'twoKindsHoldTheName'

		if not self.settledDeclarations().typeAliases.declaresAlias(spelled) 'noDeclarationAnswersIt'
			return EmptySourceText
		end 'noDeclarationAnswersIt'

		return spelled
	end 'rangedIdentityOfKey'

	export function settleAliasImplementsClauses()
		let pending = self.mainThreadSettled().pendingImplementsClauses

		for clause in pending 'eachClause'
			let key = fileScopedDeclKey(clause.name, declFilePath: clause.declFilePath)
			let parent = try requireDeclaredAlias(self.aliasOf(clause.parentName, readerFilePath: clause.declFilePath)) otherwise 'noRangedAliasOfThatName'
				self.mainThreadSettled().implementsVerdicts.upsert(key, value: AliasImplementsVerdict.notARangedAlias)
				continue
			end 'noRangedAliasOfThatName'

			let verdict = implementsClauseVerdict(clause, parent: parent)
			self.mainThreadSettled().implementsVerdicts.upsert(key, value: verdict)

			match verdict 'linkWhenResolved'
				resolved then self.recordImplementsLink(self.linkedToParentIdentity(clause))
				cycle or
				notARangedAlias or
				rangeDoesNotFit or
				primitiveDiffers then break
			end 'linkWhenResolved'
		end 'eachClause'

		let cyclic = AliasImplementsClauseArray.create(0)

		for clause in self.mainThreadSettled().pendingImplementsClauses 'eachLinkedClause'
			if self.implementsLinkReturnsTo(clause) 'backToItself'
				cyclic.push(clause)
			end 'backToItself'
		end 'eachLinkedClause'

		for clause in cyclic 'eachCyclicClause'
			if not self.implementsLinkReturnsTo(clause) 'anEarlierMemberBrokeTheCycle'
				continue
			end 'anEarlierMemberBrokeTheCycle'

			self.mainThreadSettled().implementsVerdicts.upsert(fileScopedDeclKey(clause.name, declFilePath: clause.declFilePath), value: AliasImplementsVerdict.cycle)
			self.unlinkImplements(clause)
		end 'eachCyclicClause'

		for clause in self.mainThreadSettled().pendingImplementsClauses 'eachSettledClause'
			self.mixImplementsVerdict(clause)
		end 'eachSettledClause'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.pendingImplementsClauses = AliasImplementsClauseArray.create(0)
	end 'settleAliasImplementsClauses'

	// Keyed per (declaring file, name): a private alias is per file, so two files may link one name to
	// two different parents.
	function implementsLinkKeys(clause AliasImplementsClause) returns NameRoster
		let keys = NameRoster.create(0)
		keys.push(fileScopedDeclKey(clause.name, declFilePath: clause.declFilePath))

		let namespace = namespaceForModuleDirectory(self.moduleDirectoryOf(clause.declFilePath))

		if not namespace.isEmpty() 'aNamespaceMirror'
			keys.push(fileScopedDeclKey(namespaceQualifiedName(namespace, name: clause.name), declFilePath: clause.declFilePath))
		end 'aNamespaceMirror'

		return keys
	end 'implementsLinkKeys'

	function linkedToParentIdentity(clause AliasImplementsClause) returns AliasImplementsClause
		let identity = self.declaredIdentityOfSpelling(clause.parentName, declFilePath: clause.declFilePath)
		return AliasImplementsClause.create(clause.name, parentName: identity, visibility: clause.visibility, declFilePath: clause.declFilePath, isFloat: clause.isFloat, low: clause.low, high: clause.high)
	end 'linkedToParentIdentity'

	function recordImplementsLink(clause AliasImplementsClause)
		for key in self.implementsLinkKeys(clause) 'eachKey'
			self.mainThreadSettled().implementsParents.upsert(key, value: clause)
		end 'eachKey'
	end 'recordImplementsLink'

	function unlinkImplements(clause AliasImplementsClause)
		for key in self.implementsLinkKeys(clause) 'eachKey'
			if not self.mainThreadSettled().implementsParents.remove(key) 'neverLinked'
				panic("ProgramSignatures.unlinkImplements: '{String.from(key)}' holds no link — only a clause recordImplementsLink linked can close a cycle")
			end 'neverLinked'
		end 'eachKey'
	end 'unlinkImplements'

	// Every verdict, not only a link, moves the hash: it is the parse memo's key, and a verdict that
	// changes a diagnostic must re-parse the files that report it.
	function mixImplementsVerdict(clause AliasImplementsClause)
		let verdict = self.aliasImplementsVerdictOf(clause.name, declFilePath: clause.declFilePath)
		let shaped = Hasher.combined(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeAliasImplements), value: verdict.ordinal as HashDigest)
		self.hash = mixBytes(mixBytes(shaped, bytes: clause.name), bytes: clause.parentName)
	end 'mixImplementsVerdict'

	function implementsLinkReturnsTo(clause AliasImplementsClause) returns bool
		let own = self.rangedIdentityOfSpelling(clause.name, readerFilePath: clause.declFilePath)
		return self.aliasAncestorsOf(own, readerFilePath: clause.declFilePath).contains(own)
	end 'implementsLinkReturnsTo'

	export function aliasImplementsVerdictOf(name ByteArray, declFilePath FilePath) returns AliasImplementsVerdict
		return try self.settledDeclarations().implementsVerdicts.get(fileScopedDeclKey(name, declFilePath: declFilePath)) otherwise panic("ProgramSignatures.aliasImplementsVerdictOf: '{String.from(name)}' in {declFilePath} was never settled — the declaration sweep reads every file-scope typealias the real parse reads")
	end 'aliasImplementsVerdictOf'

	function implementsLinkOf(identity ByteArray, readerFilePath FilePath) returns AliasImplementsClause throws MapError
		let spelled = sourceSpelledAliasName(identity)
		let decl = try requireDeclaredAlias(self.aliasOf(identity if self.settledDeclarations().typeAliases.hasIdentityContest(spelled) else spelled, readerFilePath: readerFilePath))
		return try self.settledDeclarations().implementsParents.get(fileScopedDeclKey(spelled, declFilePath: decl.declFilePath))
	end 'implementsLinkOf'

	// Each hop resolves its parent in the file that wrote the clause. The walk is bounded by the link
	// count, so it ends even on a cycle `settleAliasImplementsClauses` did not unlink.
	export function aliasAncestorsOf(identity immutable ByteArray, readerFilePath FilePath) returns NameRoster
		let ancestors = NameRoster.create(0)

		if self.settledDeclarations().implementsParents.count() == 0 'noAliasImplementsAnother'
			return ancestors
		end 'noAliasImplementsAnother'

		var reader = readerFilePath

		while ancestors.count() <= self.settledDeclarations().implementsParents.count() 'eachAncestor'
			let current = try ancestors.last() otherwise identity
			let link = try self.implementsLinkOf(current, readerFilePath: reader) otherwise return ancestors
			let parent = self.rangedIdentityOfSpelling(link.parentName, readerFilePath: link.declFilePath)

			if parent.isEmpty() 'aLinkWithNoParent'
				panic("ProgramSignatures.aliasAncestorsOf: '{String.from(link.name)}' in {link.declFilePath} is linked to '{String.from(link.parentName)}', which that file does not mean as a ranged typealias — only a resolved clause is linked")
			end 'aLinkWithNoParent'

			reader = link.declFilePath
			ancestors.push(parent)
		end 'eachAncestor'

		return ancestors
	end 'aliasAncestorsOf'

	export function aliasWidensTo(identity ByteArray, ancestor ByteArray, readerFilePath FilePath) returns bool
		return self.aliasAncestorsOf(identity, readerFilePath: readerFilePath).contains(ancestor)
	end 'aliasWidensTo'

	export function aliasSatisfies(identity ByteArray, slot ByteArray, readerFilePath FilePath) returns bool
		return identity.equals(slot) or self.aliasWidensTo(identity, ancestor: slot, readerFilePath: readerFilePath)
	end 'aliasSatisfies'

	export function nearestCommonAliasAncestor(identities NameRoster, readerFilePath FilePath) returns immutable ByteArray
		let first = try identities.get(0) otherwise panic("ProgramSignatures.nearestCommonAliasAncestor: asked of no identities — an operand set holds at least two")
		var candidates = NameRoster.create(0)
		candidates.push(first)
		candidates.append(self.aliasAncestorsOf(first, readerFilePath: readerFilePath))

		for identity in identities 'eachIdentity'
			let reachable = self.aliasAncestorsOf(identity, readerFilePath: readerFilePath)
			reachable.push(identity)

			let kept = NameRoster.create(0)

			for candidate in candidates 'eachCandidate'
				if reachable.contains(candidate) 'everyIdentitySoFarReachesIt'
					kept.push(candidate)
				end 'everyIdentitySoFarReachesIt'
			end 'eachCandidate'

			candidates = kept
		end 'eachIdentity'

		return try candidates.get(0) otherwise EmptySourceText
	end 'nearestCommonAliasAncestor'

	export function operandAliasSetFits(brand ByteArray, slot ByteArray, readerFilePath FilePath) returns bool
		for member in operandAliasSetMembers(brand) 'eachMember'
			if self.aliasSatisfies(member, slot: slot, readerFilePath: readerFilePath) 'thisOperandSatisfiesIt'
				return true
			end 'thisOperandSatisfiesIt'
		end 'eachMember'

		return false
	end 'operandAliasSetFits'

	// ⭐ **DOES `identity` NAME A SCALAR WEARING A NAME?** — the reader-less half of the door above, for
	// `aggregatesConflict`, which is handed two identities and no file. A compiler-minted spelling
	// (`Byte$0_1000`) un-mints first: the mint qualifies WHICH declaration, never WHAT KIND of thing the
	// name denotes.
	//
	// ⛔ **A NAME TWO KINDS HOLD IS TWO IDENTITIES, AND ONLY THE MINTED ONE IS THE ALIAS.**
	// `rangedIdentityOfSpelling` spells a cross-kind contested alias as its mint, so the BARE name is the
	// struct's or enum's identity — and a record must not decay: a user `type FullRangeInt` beside stdlib's
	// `typealias FullRangeInt` would otherwise admit an `int` at a `Box with FullRangeInt`'s `T`, to be stored in
	// the box and freed as a struct.
	export function isRangedAliasIdentity(identity ByteArray) returns bool
		if self.isInnerAlias(identity) 'nestedAlias'
			return true
		end 'nestedAlias'

		let spelled = sourceSpelledAliasName(identity)

		if self.crossKindContested(spelled) 'twoKindsHoldTheName'
			return not identity.equals(spelled)
		end 'twoKindsHoldTheName'

		return self.settledDeclarations().typeAliases.declaresAlias(spelled)
	end 'isRangedAliasIdentity'

	// ⭐⭐ **THE NOMINAL IDENTITY A `named` TYPE NAME CARRIES FOR `readerFilePath`, OR `EmptySourceText`** —
	// the one door every extractor's `named` arm asks (`aggregateNameIn`, `typeArgAggregateName`), so a
	// signature's stored identity, a live
	// value's and a type argument's cannot disagree about one name. `named` is overloaded: a declared
	// struct/union/enum carries its own name, a per-instance alias (`IntWrapper.Idx`) its qualified name, a
	// plain ranged alias the identity `rangedIdentityOfSpelling` spells. A nominal declaration held only for
	// OTHER files carries no identity in this one (`containsStructFor`'s contest guard), and a base-template
	// inner alias (`Wrapper.Idx`) carries its qualified name, nominal exactly like a file-scope alias.
	export function namedIdentityOf(name immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if self.containsStructFor(name, readerFilePath: readerFilePath) or self.containsEnumFor(name, readerFilePath: readerFilePath) 'registeredAggregate'
			return name
		end 'registeredAggregate'

		// `containsQualifier` first: `isPerInstanceAlias` boxes a `DeclaredAlias`, and a plain name — the
		// overwhelming case — is asked at every coercion site.
		if containsQualifier(name) and self.isPerInstanceAlias(name, readerFilePath: readerFilePath) 'perInstanceAlias'
			return name
		end 'perInstanceAlias'

		return self.rangedIdentityOfSpelling(name, readerFilePath: readerFilePath)
	end 'namedIdentityOf'

	// Resolved in the DECLARING file: a ranged alias is file-scoped, so a non-`public` one asked from
	// the calling file resolves to nothing.
	export function firstParamAliasOf(callee ByteArray) returns DeclaredAlias
		let decl = try self.sweptDeclarationOf(callee) otherwise return DeclaredAlias.undeclared
		return self.declaredParamAliasAt(decl, position: 0)
	end 'firstParamAliasOf'

	export function calleeTakesNoExplicitParam(callee ByteArray) returns bool
		let decl = try self.sweptDeclarationOf(callee) otherwise return false

		for name in decl.paramNames 'eachParam'
			if not name.equals(SelfParamName) 'anExplicitParam'
				return false
			end 'anExplicitParam'
		end 'eachParam'

		return true
	end 'calleeTakesNoExplicitParam'

	export function soleCandidateOf(callee ByteArray) returns SweptDeclaration throws MapError
		if self.isGenericFunctionKey(callee) 'aGenericDeclarationCompetes'
			throw MapError.keyNotFound
		end 'aGenericDeclarationCompetes'

		return try self.sweptDeclarationOf(callee)
	end 'soleCandidateOf'

	export function declaredParamAliasAt(decl SweptDeclaration, position ParamCount) returns DeclaredAlias
		let declared = try decl.paramTypes.get(position) otherwise return DeclaredAlias.undeclared

		if maxonTypeTag(declared) != ValueTypeTag.named 'namesNoAlias'
			return DeclaredAlias.undeclared
		end 'namesNoAlias'

		let name = try self.typeNames.nameOf(typeNameIdOf(declared)) otherwise panic("ProgramSignatures.declaredParamAliasAt: a recorded `named` parameter type carries an id this index's own interner does not hold")
		return self.fileScopedOrInnerAliasNamed(name, readerFilePath: decl.declFilePath)
	end 'declaredParamAliasAt'

	export function mayTakeUnsignedQuantityAt(callee ByteArray, argIndex ParamCount, label ByteArray) returns bool
		let decl = try self.sweptDeclarationOf(callee) otherwise return false
		return self.declarationTakesUnsignedQuantityAt(decl, argIndex: argIndex, label: label)
	end 'mayTakeUnsignedQuantityAt'

	function declarationTakesUnsignedQuantityAt(decl SweptDeclaration, argIndex ParamCount, label ByteArray) returns bool
		return match self.declaredAliasAtArgument(decl, argIndex: argIndex, label: label) 'slotAlias'
			declared(alias) gives aliasIsUnsignedFullQuantity(alias)
			undeclared gives false
		end 'slotAlias'
	end 'declarationTakesUnsignedQuantityAt'

	export function parameterIsARangedAliasAt(callee ByteArray, argIndex ParamCount, label ByteArray) returns bool
		return match self.parameterAliasAt(callee, argIndex: argIndex, label: label) 'slotAlias'
			declared gives true
			undeclared gives false
		end 'slotAlias'
	end 'parameterIsARangedAliasAt'

	export function parameterAliasAt(callee ByteArray, argIndex ParamCount, label ByteArray) returns DeclaredAlias
		let decl = try self.sweptDeclarationOf(callee) otherwise return DeclaredAlias.undeclared
		return self.declaredAliasAtArgument(decl, argIndex: argIndex, label: label)
	end 'parameterAliasAt'

	export function declaredAliasAtArgument(decl SweptDeclaration, argIndex ParamCount, label ByteArray) returns DeclaredAlias
		if decl.takesReceiver and argIndex == 0 'theReceiver'
			return DeclaredAlias.undeclared
		end 'theReceiver'

		let sourceIndex = argIndex - 1 if decl.takesReceiver else argIndex

		let position = try argSlotPosition(decl.paramNames, argIndex: sourceIndex, label: label) otherwise return DeclaredAlias.undeclared

		return self.declaredParamAliasAt(decl, position: position)
	end 'declaredAliasAtArgument'

	// ⭐⭐ **THE `Array` INSTANCE `callee` DECLARES AT ONE ARGUMENT POSITION — what an array literal
	// written there has to be BUILT at (`Parser.arrayTargetForArgument`).** An element type is a LAYOUT and
	// not a label:
	// `Array with int(0 to 1000)` strides 2 bytes where `Array with int` strides 8, so a literal typed
	// by its own elements and only then compared against the slot is a record at the wrong stride —
	// which is why the slot has to answer BEFORE the literal is built.
	//
	// ⚠ **THE SPELLING IS RESOLVED FROM THE FILE THAT WROTE IT**, `firstParamAliasOf`'s rule above and for its
	// measured reason: a typealias is file-scoped, so a parameter type read from the CALLER's file resolves to
	// another declaration or to none at all.
	//
	// ⚠ **A NAME DECLARED TWICE ANSWERS `none`**, that door's reason one position over: two declarations of a
	// name may name different containers at one position, and which one a call resolves to is not decided here.
	//
	// ⚠ **A SWEPT PARAMETER TYPE IS A BARE `named`**, never the instance: the per-file alias registries are
	// read in the real parse only (`Parser.parseTypeReference`'s `allFilesFolded` gate), which is the gate this
	// stands behind and for the same reason — ungated, the answer would depend on the loader's walk order. A
	// parameter written `Array with T` outright is `unresolved` (`Parser.sweptParamTypeAt` reads no compound
	// type) and states nothing here.
	export function arrayInstanceDeclaredAtParam(callee ByteArray, sourceIndex ParamCount, label ByteArray, readerFilePath FilePath) returns DeclaredArrayInstance
		let param = try self.soleDeclaredParam(callee, sourceIndex: sourceIndex, label: label, readerFilePath: readerFilePath) otherwise return DeclaredArrayInstance.none
		return self.arrayInstanceOfDeclaredType(param.declared, interner: self.typeNames, readerFilePath: param.declFilePath)
	end 'arrayInstanceDeclaredAtParam'

	export function arrayInstanceDeclaredAtParamOfReceiver(callee ByteArray, sourceIndex ParamCount, label ByteArray, receiver GenericInstanceId, readerFilePath FilePath) returns DeclaredArrayInstance
		let param = try self.soleDeclaredParam(callee, sourceIndex: sourceIndex, label: label, readerFilePath: readerFilePath) otherwise return DeclaredArrayInstance.none

		// A swept parameter is a bare alias name, which the substitution passes through untouched, so the
		// alias is resolved first or the element type stays the declaration's `T`.
		let declared = self.declaredSlotType(param.declared, into: self.typeNames, slotScopeFilePath: param.declFilePath)
		let substituted = self.substituteThroughInstanceInterned(declared, id: receiver, interner: self.typeNames)

		if maxonTypesDenoteSame(substituted, b: declared) 'theReceiverFixesNothing'
			return self.arrayInstanceOfDeclaredType(param.declared, interner: self.typeNames, readerFilePath: param.declFilePath)
		end 'theReceiverFixesNothing'

		return self.arrayInstanceOfDeclaredType(substituted, interner: self.typeNames, readerFilePath: readerFilePath)
	end 'arrayInstanceDeclaredAtParamOfReceiver'

	export function tupleTypeNameDeclaredAtParam(callee ByteArray, sourceIndex ParamCount, label ByteArray, readerFilePath FilePath) returns immutable ByteArray throws AbsentError
		let param = try self.soleDeclaredParam(callee, sourceIndex: sourceIndex, label: label, readerFilePath: readerFilePath)

		let resolved = self.declaredSlotType(param.declared, into: self.typeNames, slotScopeFilePath: param.declFilePath)

		if maxonTypeTag(resolved) == ValueTypeTag.named and self.isAliasOfFormFor(self.nameOfId(typeNameIdOf(resolved)), readerFilePath: param.declFilePath, wanted: FormAliasKind.tuple) 'aQualifiedTupleAlias'
			if self.tupleAliasNamesAGenericAlias(self.nameOfId(typeNameIdOf(resolved)), readerFilePath: param.declFilePath) 'overAGenericAlias'
				throw AbsentError.absent
			end 'overAGenericAlias'

			return self.tupleAliasTargetFrom(self.nameOfId(typeNameIdOf(resolved)), readerFilePath: param.declFilePath)
		end 'aQualifiedTupleAlias'

		if maxonTypeTag(resolved) != ValueTypeTag.structRef 'notARecord'
			throw AbsentError.absent
		end 'notARecord'

		return self.indexSpaceTypeName(resolved)
	end 'tupleTypeNameDeclaredAtParam'

	export function tupleTypeNameDeclaredAtParamOfReceiver(callee ByteArray, sourceIndex ParamCount, label ByteArray, receiver GenericInstanceId, readerFilePath FilePath) returns immutable ByteArray throws AbsentError
		let param = try self.soleDeclaredParam(callee, sourceIndex: sourceIndex, label: label, readerFilePath: readerFilePath)
		let substituted = self.substituteThroughInstanceInterned(param.declared, id: receiver, interner: self.typeNames)

		if maxonTypeTag(substituted) != ValueTypeTag.structRef 'notARecord'
			throw AbsentError.absent
		end 'notARecord'

		return self.indexSpaceTypeName(substituted)
	end 'tupleTypeNameDeclaredAtParamOfReceiver'

	function soleDeclaredParam(callee ByteArray, sourceIndex ParamCount, label ByteArray, readerFilePath FilePath) returns DeclaredParam throws AbsentError
		if not self.allFilesFolded 'theAliasRegistriesAreStillFilling'
			throw AbsentError.absent
		end 'theAliasRegistriesAreStillFilling'

		let decl = try self.visibleDeclarationOf(callee, readerFilePath: readerFilePath) otherwise throw AbsentError.absent
		let slot = try argSlotPosition(decl.paramNames, argIndex: sourceIndex, label: label) otherwise throw AbsentError.absent
		let declared = try decl.paramTypes.get(slot) otherwise panic("ProgramSignatures.soleDeclaredParam: paramTypes.get OOB at {slot} — the sweep records one type per parameter name")
		return DeclaredParam.create(declared, declFilePath: decl.declFilePath)
	end 'soleDeclaredParam'

	export function arrayInstanceOfDeclaredType(declared MaxonType, interner TypeNameInterner, readerFilePath FilePath) returns DeclaredArrayInstance
		let tag = maxonTypeTag(declared)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.arrayInstanceOrNone(genericInstanceIdOf(declared))
		end 'anInstance'

		if tag != ValueTypeTag.named 'namesNoInstance'
			return DeclaredArrayInstance.none
		end 'namesNoInstance'

		let name = try interner.nameOf(typeNameIdOf(declared)) otherwise panic("ProgramSignatures.arrayInstanceOfDeclaredType: a `named` declared type carries an id the interner it was minted in does not hold")

		if not self.isAliasOfFormFor(name, readerFilePath: readerFilePath, wanted: FormAliasKind.generic) 'namesNoGenericAlias'
			return DeclaredArrayInstance.none
		end 'namesNoGenericAlias'

		return self.arrayInstanceOrNone(self.genericAliasInstanceFrom(name, readerFilePath: readerFilePath))
	end 'arrayInstanceOfDeclaredType'

	export function slotNamesTheInstancesBase(slotType MaxonType, interner TypeNameInterner, gid GenericInstanceId) returns bool
		if maxonTypeTag(slotType) != ValueTypeTag.structRef 'notADeclaredStruct'
			return false
		end 'notADeclaredStruct'

		let name = try interner.nameOf(typeNameIdOf(slotType)) otherwise panic("ProgramSignatures.slotNamesTheInstancesBase: structRef id {typeNameIdOf(slotType)} is not in the interner it was minted in")
		return name.equals(self.genericInstanceBaseName(gid))
	end 'slotNamesTheInstancesBase'

	function arrayInstanceOrNone(giid GenericInstanceId) returns DeclaredArrayInstance
		return DeclaredArrayInstance.instance(giid) if self.isArrayInstance(giid) else DeclaredArrayInstance.none
	end 'arrayInstanceOrNone'

	export function ambiguousAliasCandidates(name ByteArray, readerFilePath FilePath) returns AmbiguousCandidates
		let claims = self.ambiguityClaimsOf(name)

		if not self.nameMeansSeveral(claims, name: name, readerFilePath: readerFilePath) 'atMostOneMeaning'
			return AmbiguousCandidates.create(StringArray.create(0))
		end 'atMostOneMeaning'

		let candidates = StringArray.create(0)

		for claim in claims 'renderReachable'
			self.offerAmbiguousCandidate(candidates, reach: self.claimReach(claim, readerFilePath: readerFilePath), declFilePath: claim.declFilePath, name: name)
		end 'renderReachable'

		return AmbiguousCandidates.create(candidates)
	end 'ambiguousAliasCandidates'

	function bareNameMeansSeveral(name ByteArray, readerFilePath FilePath) returns bool
		return self.nameMeansSeveral(self.ambiguityClaimsOf(name), name: name, readerFilePath: readerFilePath)
	end 'bareNameMeansSeveral'

	function ambiguityClaimsOf(name ByteArray) returns TypeNameClaimArray
		if self.settledDeclarations().interfaces.hasLibraryRenames() 'aLibraryTypeMayHaveMoved'
			let moved = self.settledDeclarations().interfaces.libraryNameOf(name)

			if not moved.equals(name) 'theLibrarysDeclarationMoved'
				return self.movedTypeNameClaims(name, moved: moved)
			end 'theLibrarysDeclarationMoved'
		end 'aLibraryTypeMayHaveMoved'

		if let claims = try self.settledDeclarations().contestedNominalClaims.get(name) 'severalDirectoriesDeclareANominal'
			return claims
		end 'severalDirectoriesDeclareANominal'

		if let claims = try self.crossKindClaimsOf(name) 'severalKindsHoldTheName'
			return claims
		end 'severalKindsHoldTheName'

		let contested = self.settledDeclarations().typeAliases.contestedDeclarations(name)

		if contested.count() == 0 'noRangedAliasOfThisNameIsContested'
			return self.otherFormAmbiguityClaims(name)
		end 'noRangedAliasOfThisNameIsContested'

		let claims = TypeNameClaimArray.create(contested.count(), zeroed: false)

		for (_, alias) in contested 'eachDeclaringFile'
			claims.push(self.typeNameClaim(TypeDeclKind.rangedAlias, visibility: alias.visibility, declFilePath: alias.declFilePath))
		end 'eachDeclaringFile'

		return claims
	end 'ambiguityClaimsOf'

	function movedTypeNameClaims(name ByteArray, moved ByteArray) returns TypeNameClaimArray
		if moved.equals(name) 'nothingMoved'
			return self.typeNameClaimsOf(name)
		end 'nothingMoved'

		let claims = TypeNameClaimArray.create(0)

		for claim in self.typeNameClaimsOf(name) 'eachClaim'
			claims.push(claim)
		end 'eachClaim'

		for claim in self.typeNameClaimsOf(moved) 'eachMovedClaim'
			claims.push(claim)
		end 'eachMovedClaim'

		return claims
	end 'movedTypeNameClaims'

	function claimReach(claim TypeNameClaim, readerFilePath FilePath) returns CandidateReach
		if not readerFilePath.equals(CompilerOwnedDeclFilePath) and not self.settledDeclarations().typeAliases.provenance.claimIsVisibleFrom(claim, readerPath: readerFilePath.toString()) 'hidden'
			return CandidateReach.hidden
		end 'hidden'

		return CandidateReach.library if claim.declaredByTheCorpus else CandidateReach.author
	end 'claimReach'

	function offerAmbiguousCandidate(candidates StringArray, reach CandidateReach, declFilePath FilePath, name ByteArray)
		if reach != CandidateReach.author 'noSpellingToOffer'
			return
		end 'noSpellingToOffer'

		insertCandidateName(candidates, candidate: qualifiedCandidateName(self.moduleDirectoryOf(declFilePath), bare: unqualifiedMemberOf(name)))
	end 'offerAmbiguousCandidate'

	function otherFormAmbiguityClaims(name ByteArray) returns TypeNameClaimArray
		let functionAliases = self.settledDeclarations().functionTypeAliases.contestedDeclarations(name)

		if functionAliases.count() > 0 'severalFilesDeclareTheFunctionAlias'
			let claims = TypeNameClaimArray.create(functionAliases.count(), zeroed: false)

			for (_, alias) in functionAliases 'eachDeclaringFile'
				claims.push(self.typeNameClaim(TypeDeclKind.functionAlias, visibility: alias.visibility, declFilePath: alias.declFilePath))
			end 'eachDeclaringFile'

			return claims
		end 'severalFilesDeclareTheFunctionAlias'

		if let byFile = try self.claimantsOf(name) 'severalFilesDeclareTheTupleAlias'
			let claims = TypeNameClaimArray.create(byFile.count(), zeroed: false)

			for (_, tuple) in byFile 'eachDeclaringFile'
				claims.push(tuple.claim)
			end 'eachDeclaringFile'

			return claims
		end 'severalFilesDeclareTheTupleAlias'

		if self.aliasNameIsDisagreedWith(name) 'severalDeclarationsOfTheGenericAlias'
			return self.genericAliasClaimsOf(name)
		end 'severalDeclarationsOfTheGenericAlias'

		return TypeNameClaimArray.create(0)
	end 'otherFormAmbiguityClaims'

	function genericAliasClaimsOf(name ByteArray) returns TypeNameClaimArray
		self.indexGenericAliasDeclarations()

		let held = try self.settledDeclarations().genericAliasDeclIndexByName.get(name) otherwise return TypeNameClaimArray.create(0)
		let claims = TypeNameClaimArray.create(held.count(), zeroed: false)

		for at in held 'eachDeclaration'
			let decl = try self.settledDeclarations().genericAliasDecls.get(at) otherwise panic("ProgramSignatures.genericAliasClaimsOf: genericAliasDecls.get OOB at {at}, an index only `indexGenericAliasDeclarations` minted")
			claims.push(self.genericAliasDeclClaim(decl))
		end 'eachDeclaration'

		return claims
	end 'genericAliasClaimsOf'

	function nameMeansSeveral(claims TypeNameClaimArray, name ByteArray, readerFilePath FilePath) returns bool
		if self.declaredByTheCorpus(readerFilePath) 'theReaderMeansItsLibrarys'
			return false
		end 'theReaderMeansItsLibrarys'

		if not everyClaimMayCoexist(name, claims: claims, directories: self.settledDeclarations().fileModuleDirectories) 'aDuplicateDeclarationIsRefusedWhereItIsDeclared'
			return false
		end 'aDuplicateDeclarationIsRefusedWhereItIsDeclared'

		return match self.settledDeclarations().typeAliases.provenance.meantAuthorClaimIn(claims, readerPath: readerFilePath.toString()) 'meant'
			ambiguous gives true
			nowhere or
			meant gives false
		end 'meant'
	end 'nameMeansSeveral'

	export function namespaceMemberOf(qualified ByteArray, readerFilePath FilePath) returns NamespaceMember
		match splitQualifiedName(qualified) 'split'
			notQualified then panic("ProgramSignatures.namespaceMemberOf: '{String.from(qualified)}' holds no qualifier — the caller walked a dotted chain to build it")
			parts(_, member) then return self.namespaceMemberIn(qualified, member: member, readerFilePath: readerFilePath)
		end 'split'
	end 'namespaceMemberOf'

	function namespaceMemberIn(qualified ByteArray, member ByteArray, readerFilePath FilePath) returns NamespaceMember
		let moved = self.settledDeclarations().interfaces.libraryNameOf(member)
		let claims = try self.settledDeclarations().qualifiedTypeClaims.get(qualified) otherwise TypeNameClaimArray.create(0)

		return match self.settledDeclarations().typeAliases.provenance.tallyOfClaims(claims, readerPath: readerFilePath.toString(), authorsOnly: false).verdict() 'verdict'
			meant(index, _) gives self.chosenNamespaceMember(claims, at: index, member: member, moved: moved)
			ambiguous gives NamespaceMember.several(self.namespaceCandidates(claims, member: member, readerFilePath: readerFilePath))
			nowhere gives self.hiddenNamespaceMember(claims, at: 0, member: member, moved: moved)
		end 'verdict'
	end 'namespaceMemberIn'

	function hiddenNamespaceMember(claims TypeNameClaimArray, at ElementIndex, member ByteArray, moved ByteArray) returns NamespaceMember
		if at == claims.count() 'nothingIsHidden'
			return NamespaceMember.none
		end 'nothingIsHidden'

		let claim = try claims.get(at) otherwise panic("ProgramSignatures.hiddenNamespaceMember: claims.get OOB at {at}, an index the walk over these claims just read")
		return NamespaceMember.hidden(hiddenSymbolKindOf(claim), tier: claim.visibility, kind: claim.kind, declFilePath: claim.declFilePath, name: self.claimedNominalName(claim, member: member, moved: moved))
	end 'hiddenNamespaceMember'

	function claimedNominalName(claim TypeNameClaim, member immutable ByteArray, moved immutable ByteArray) returns immutable ByteArray
		if claim.declaredByTheCorpus 'theLibrarysDeclaration'
			return moved
		end 'theLibrarysDeclaration'

		if isTypeAliasDecl(claim.kind) 'anAlias'
			return member
		end 'anAlias'

		return self.authorMintOf(claim.declFilePath, name: member)
	end 'claimedNominalName'

	function chosenNamespaceMember(claims TypeNameClaimArray, at ElementIndex, member ByteArray, moved ByteArray) returns NamespaceMember
		let chosen = try claims.get(at) otherwise panic("ProgramSignatures.chosenNamespaceMember: claims.get OOB at {at}, an index the walk over these claims just read")
		return NamespaceMember.one(chosen.kind, declFilePath: chosen.declFilePath, name: self.claimedNominalName(chosen, member: member, moved: moved))
	end 'chosenNamespaceMember'

	function namespaceCandidates(claims TypeNameClaimArray, member ByteArray, readerFilePath FilePath) returns StringArray
		let candidates = StringArray.create(0)

		for claim in claims 'renderMatched'
			if self.claimReach(claim, readerFilePath: readerFilePath) != CandidateReach.hidden 'aMatchedDeclaration'
				insertCandidateName(candidates, candidate: qualifiedCandidateName(self.moduleDirectoryOf(claim.declFilePath), bare: member))
			end 'aMatchedDeclaration'
		end 'renderMatched'

		return candidates
	end 'namespaceCandidates'

	function settleTypeNameClaimIndex()
		// Unsettled first, so a re-settle collects from the registries rather than reading its own
		// old answers.
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.typeNameClaimIndex = TypeNameClaimIndex.unsettled
		let byName = TypeNameClaimsByKey.create()

		for name in self.namesSeveralDeclarationsMayHold() 'eachName'
			if byName.contains(name) 'alreadyIndexed'
				continue
			end 'alreadyIndexed'

			let spelled = self.movedTypeNameClaims(name, moved: self.mainThreadSettled().interfaces.libraryNameOf(name))

			if spelled.count() < 2 'heldOnce'
				continue
			end 'heldOnce'

			byName.upsert(name, value: self.typeNameClaimsOf(name))
		end 'eachName'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.typeNameClaimIndex = TypeNameClaimIndex.settled(byName)
	end 'settleTypeNameClaimIndex'

	function namesSeveralDeclarationsMayHold() returns NameRoster
		self.requireWholeProgramIndex("namesSeveralDeclarationsMayHold")

		let names = self.settledDeclarations().typeAliases.multiplyDeclaredNames()

		for name in self.settledDeclarations().functionTypeAliases.multiplyDeclaredNames() 'eachFunctionAlias'
			names.push(name)
		end 'eachFunctionAlias'

		for (name, _) in self.multiplyDeclaredTupleAliases 'eachTupleAlias'
			names.push(name)
		end 'eachTupleAlias'

		let genericAliasNames = DeclaredTypeNameSet.create()

		for decl in self.settledDeclarations().genericAliasDecls 'eachGenericAlias'
			if genericAliasNames.contains(decl.aliasName) 'aSecondDeclaration'
				names.push(decl.aliasName)
			end 'aSecondDeclaration' else 'theFirstDeclaration'
				genericAliasNames.insert(decl.aliasName)
			end 'theFirstDeclaration'
		end 'eachGenericAlias'

		for name in self.crossKindScopedAliasNames() 'eachCrossKind'
			names.push(name)
		end 'eachCrossKind'

		return names
	end 'namesSeveralDeclarationsMayHold'

	function recordMisclosedBlock(site MisclosedBlockSite)
		for recorded in self.settledDeclarations().misclosedBlocks 'eachRecorded'
			if recorded.filePath.equals(site.filePath) 'thisFileAlreadyHasOne'
				return
			end 'thisFileAlreadyHasOne'
		end 'eachRecorded'

		self.mainThreadSettled().misclosedBlocks.push(site)
	end 'recordMisclosedBlock'

	function hasMisclosedBlocks() returns bool
		return not self.settledDeclarations().misclosedBlocks.isEmpty()
	end 'hasMisclosedBlocks'

	function aMisclosedBlockCouldHaveCorrupted(message String) returns bool
		for site in self.settledDeclarations().misclosedBlocks 'eachSite'
			if site.couldHaveCorrupted(message) 'thisOne'
				return true
			end 'thisOne'
		end 'eachSite'

		return false
	end 'aMisclosedBlockCouldHaveCorrupted'

	function misclosedBlockIn(filePath String) returns MisclosedBlockSite throws AbsentError
		for site in self.settledDeclarations().misclosedBlocks 'eachSite'
			if site.filePath.equals(filePath) 'thisFiles'
				return site
			end 'thisFiles'
		end 'eachSite'

		throw AbsentError.absent
	end 'misclosedBlockIn'

	export function declaredInTheRuntimeTier(declFilePath FilePath) returns bool
		return self.settledDeclarations().runtimeFilePaths.contains(declFilePath.toString())
	end 'declaredInTheRuntimeTier'

	// The `stdlib/` part of the library — the files a `stdlib.X` spelling names. A `runtime/` file is the
	// library's too, and has no qualifier an author can write; a scriptlib file is named by its package's
	// `scriptlib.<package>`.
	export function declaredInTheStdlib(declFilePath FilePath) returns bool
		return self.settledDeclarations().libraryFilePaths.contains(declFilePath.toString()) and not self.settledDeclarations().runtimeFilePaths.contains(declFilePath.toString()) and not self.declaredInTheScriptlib(declFilePath)
	end 'declaredInTheStdlib'

	export function declaredInTheScriptlib(declFilePath FilePath) returns bool
		return self.settledDeclarations().scriptlibFilePaths.contains(declFilePath.toString())
	end 'declaredInTheScriptlib'

	// ⭐⭐ **IS A DECLARATION IN THIS FILE THE LIBRARY'S? — THE ONE SPELLING OF PROVENANCE THIS INDEX
	// USES.** It is the loader's own partition, stamped per file by `recordFileModuleDirectory` and shared
	// with the registries' `ClaimantProvenance` through `declaredInTheCorpus`, so the cross-kind contest,
	// the ambiguity candidates and the claimant ranking cannot come to two answers about which layer
	// declared a name.
	//
	// ⚠ **A DECLARATION THE COMPILER BUILT CARRIES NO FILE AT ALL** — a tuple layout, `Ordering`, the
	// builtin error enums (`CompilerOwnedDeclFilePath`) — and it belongs to the LIBRARY layer: it is
	// not the user's, and a user declaration of its name shadows it rather than meeting it.
	export function declaredByTheCorpus(declFilePath FilePath) returns bool
		return declaredInTheCorpus(self.settledDeclarations().libraryFilePaths, declPath: declFilePath.toString())
	end 'declaredByTheCorpus'

	export function declaredByTheSharedCorpusAt(declPath String) returns bool
		return declaredInTheCorpus(self.settledDeclarations().libraryFilePaths, declPath: declPath) and not self.settledDeclarations().scriptlibFilePaths.contains(declPath)
	end 'declaredByTheSharedCorpusAt'

	export function rawSurfaceIsRefusedIn(readerFilePath FilePath) returns bool
		return tierRefusesTheRawSurface(self.declaredInTheStdlib(readerFilePath) or self.rootIsUnderStdlibDirectory, isRuntimeSource: self.declaredInTheRuntimeTier(readerFilePath))
	end 'rawSurfaceIsRefusedIn'

	// --- The CROSS-KIND contest: one name, two kinds of declaration ---

	// One claim, with the provenance derived rather than carried — see `declaredByTheCorpus`. THE builder,
	// so no source of a claim can supply a provenance of its own.
	function typeNameClaim(kind TypeDeclKind, visibility Visibility, declFilePath FilePath) returns TypeNameClaim
		return TypeNameClaim.create(kind, declFilePath: declFilePath, visibility: visibility, declaredByTheCorpus: self.declaredByTheCorpus(declFilePath))
	end 'typeNameClaim'

	// ⭐⭐ **WHICH TYPE NAMES MORE THAN ONE *KIND* OF DECLARATION HOLDS — settled once, with every file
	// folded.** `typeNamePairMayCoexist` lets a `type Box` and a `typealias Box` in two files both stand;
	// the moment they do, every registry keyed by the bare name answers for BOTH and the fixed cascade in
	// `TypeResolution.denotedNamedType` picks one for the whole program. That is the wrong answer this
	// table exists to prevent, and it was MEASURED inside `stdlib/`: the library's own
	// `i64.min as FullRangeInt` resolved to a USER program's `type FullRangeInt`, and the E3009 named a library
	// line the author never opened.
	//
	// ⚠ **IT RECORDS ONLY THE PAIRS THAT MAY COEXIST — `typeNamePairMayCoexist`, the SAME predicate the
	// merge's duplicate check applies, which is what makes this table and that diagnostic two faces of one
	// rule rather than two rules.** A pair that COLLIDES has a declaration the program is being refused
	// for, and until the merge reports it resolution answers exactly as it always did: the fixed cascade,
	// whole-program, arm order. That is deliberate rather than tolerated — a colliding `type Score` and
	// `export typealias Score` earns BOTH the E3006 and the E3009 its misresolution causes
	// (`type-name-collision.md`'s `error.crossfile-type-and-exported-typealias` pins the pair), because
	// the second diagnostic is the CONSEQUENCE the first explains, and suppressing it here would hide the
	// reason the reader is being told the name is claimed twice.
	//
	// ⚠ **THE TEST IS `declaredFormOf` DISAGREEING WITH THE REGISTRY THAT OFFERED THE NAME, and that is
	// what keeps the list of "registries that can hold a type name" written down ONCE.** That cascade is
	// FIRST-MATCH in a fixed order, so a name two kinds hold answers the earlier one — and this walk offers
	// every name from every registry that holds it, so such a name is offered at least once from a registry
	// that is not the cascade's first answer. All seven are therefore walked, the ranged one included: skip
	// it and a `type Box` + `typealias Box` pair would be offered only as `structType`, which is exactly
	// what the cascade answers.
	//
	// ⚠ **EMPTY FOR EVERY PROGRAM IN THE CORPUS**, which is what keeps the readers free: each is one probe
	// of a map with no entries, and none of them allocates.
	export function settleCrossKindContests()
		self.requireWholeProgramIndex("settleCrossKindContests")

		// The interface half is indexed FIRST because it is the one kind whose registry is not yet built:
		// `interfaces` is filled by `foldInterfaceDeclarations`, which runs after this.
		let interfaceNames = NameRoster.create(0)

		for site in self.settledDeclarations().interfaceDeclSites 'eachInterfaceSite'
			if let name = try site.name.declaredName() 'aNamedInterface'
				interfaceNames.push(name)
			end 'aNamedInterface'
		end 'eachInterfaceSite'

		for (name, _) in self.structSlots 'eachStruct'
			self.noteCrossKindContest(name, offeredAs: TypeDeclKind.structType)
		end 'eachStruct'

		for (name, layout) in self.settledDeclarations().enumTypes 'eachEnumOrUnion'
			self.noteCrossKindContest(name, offeredAs: TypeDeclKind.unionType if layout.isUnion else TypeDeclKind.enumType)
		end 'eachEnumOrUnion'

		for name in interfaceNames 'eachInterface'
			self.noteCrossKindContest(name, offeredAs: TypeDeclKind.interfaceType)
		end 'eachInterface'

		let rangedAliasNames = self.settledDeclarations().typeAliases.declaredNames()

		for aliasName in rangedAliasNames 'eachRangedAlias'
			self.noteCrossKindContest(aliasName, offeredAs: TypeDeclKind.rangedAlias)
		end 'eachRangedAlias'

		let functionAliasNames = self.settledDeclarations().functionTypeAliases.declaredNames()

		for aliasName in functionAliasNames 'eachFunctionAlias'
			self.noteCrossKindContest(aliasName, offeredAs: TypeDeclKind.functionAlias)
		end 'eachFunctionAlias'

		let genericAliasNames = NameRoster.create(self.settledDeclarations().genericAliasDecls.count(), zeroed: false)

		for entry in self.settledDeclarations().genericAliasDecls 'eachGenericAliasName'
			genericAliasNames.push(entry.aliasName)
		end 'eachGenericAliasName'

		for aliasName in genericAliasNames 'eachGenericAlias'
			self.noteCrossKindContest(aliasName, offeredAs: TypeDeclKind.genericAlias)
		end 'eachGenericAlias'

		for (name, _) in self.tupleAliases 'eachTupleAlias'
			self.noteCrossKindContest(name, offeredAs: TypeDeclKind.tupleAlias)
		end 'eachTupleAlias'
	end 'settleCrossKindContests'

	// File `name` if a SECOND kind of declaration holds it — see the walk above for why "`declaredFormOf`
	// disagrees with the offering registry" is exactly that question. An uncontested name, which is every
	// name in every program in the corpus, pays that one allocation-free cascade and stops.
	//
	// ⚠ **IT ASKS THE BARE CASCADE (`declaredFormInAnyFile`), which is the only one that can be asked while
	// the contest table is still being built** — the reader-aware door reads that very table.
	//
	// ⚠ **AN `interface`-ONLY NAME IS THE ONE CASE THE CASCADE CANNOT ANSWER**, because
	// `foldInterfaceDeclarations` has not run and `interfaces` is empty here — so it throws, which is read
	// as "no other kind holds it". That is the right answer: the SITE that offered the name is then the
	// only declaration of it.
	function noteCrossKindContest(name ByteArray, offeredAs TypeDeclKind)
		if self.writtenNameIsContestedAcrossKinds(name) 'alreadySettled'
			return
		end 'alreadySettled'

		let sweptForm = try self.declaredFormInAnyFile(name) otherwise return

		if sweptForm == offeredAs 'noOtherKindHoldsIt'
			return
		end 'noOtherKindHoldsIt'

		let claims = self.typeNameClaimsOf(name)

		if not everyClaimMayCoexist(name, claims: claims, directories: self.settledDeclarations().fileModuleDirectories) 'thePairIsADuplicateDeclaration'
			return
		end 'thePairIsADuplicateDeclaration'

		let byName = self.crossKindContestsForWrite()
		byName.upsert(name, value: claims)
	end 'noteCrossKindContest'

	// EVERY declaration of `name`; `collectTypeNameClaims` owns what that means.
	function typeNameClaimsOf(name ByteArray) returns TypeNameClaimArray
		match self.settledDeclarations().typeNameClaimIndex 'index'
			unsettled then return self.collectTypeNameClaims(name)
			settled(byName) then return try byName.get(name) otherwise self.collectTypeNameClaims(name)
		end 'index'
	end 'typeNameClaimsOf'

	// EVERY declaration of `name`, across every registry that can hold one.
	//
	// ⚠ **THE RANGED AND TUPLE ARMS COLLECT *EVERY* DECLARING FILE, not one** — a file whose claim is dropped
	// is told it meant a same-named `type`. The ranged set is `contestedDeclarations`; when one file declares
	// the name that set is empty and the sole declaration is read through `declarationInAnyFile`, which is
	// deliberately not `lookup` — whose job is to answer what a READER means, and which synthesizes the
	// builtin `ExitCode` for a name no file declares at all.
	function collectTypeNameClaims(name ByteArray) returns TypeNameClaimArray
		let claims = TypeNameClaimArray.create(0)

		match self.structInAnyFile(name) 'aStruct'
			declared(layout) then claims.push(self.typeNameClaim(TypeDeclKind.structType, visibility: layout.visibility, declFilePath: layout.declFilePath))
			undeclared then break
		end 'aStruct'

		match self.enumInAnyFile(name) 'anEnumOrUnion'
			declared(layout) then claims.push(self.typeNameClaim(TypeDeclKind.unionType if layout.isUnion else TypeDeclKind.enumType, visibility: layout.visibility, declFilePath: layout.declFilePath))
			undeclared then break
		end 'anEnumOrUnion'

		match self.interfaceDeclaredIn(name) 'anInterface'
			declared(_, visibility, declFilePath) then claims.push(self.typeNameClaim(TypeDeclKind.interfaceType, visibility: visibility, declFilePath: declFilePath))
			undeclared then break
		end 'anInterface'

		let aliasKey = self.aliasFamilyIdentity(name)
		let contestedAliases = self.settledDeclarations().typeAliases.contestedDeclarations(aliasKey)

		if contestedAliases.count() > 0 'severalFilesDeclareTheRangedAlias'
			for (_, alias) in contestedAliases 'eachDeclaringFile'
				claims.push(self.typeNameClaim(TypeDeclKind.rangedAlias, visibility: alias.visibility, declFilePath: alias.declFilePath))
			end 'eachDeclaringFile'
		end 'severalFilesDeclareTheRangedAlias' else 'atMostOneFileDoes'
			match self.settledDeclarations().typeAliases.declarationInAnyFile(aliasKey) 'theSoleRangedAlias'
				declared(alias) then claims.push(self.typeNameClaim(TypeDeclKind.rangedAlias, visibility: alias.visibility, declFilePath: alias.declFilePath))
				undeclared then break
			end 'theSoleRangedAlias'
		end 'atMostOneFileDoes'

		let contestedFunctionAliases = self.settledDeclarations().functionTypeAliases.contestedDeclarations(aliasKey)

		if contestedFunctionAliases.count() > 0 'severalFilesDeclareTheFunctionAlias'
			for (_, alias) in contestedFunctionAliases 'eachDeclaringFile'
				claims.push(self.typeNameClaim(TypeDeclKind.functionAlias, visibility: alias.visibility, declFilePath: alias.declFilePath))
			end 'eachDeclaringFile'
		end 'severalFilesDeclareTheFunctionAlias' else 'atMostOneFileDoes'
			match self.functionAliasInAnyFile(aliasKey) 'theSoleFunctionAlias'
				declared(alias) then claims.push(self.typeNameClaim(TypeDeclKind.functionAlias, visibility: alias.visibility, declFilePath: alias.declFilePath))
				undeclared then break
			end 'theSoleFunctionAlias'
		end 'atMostOneFileDoes'

		if self.settledDeclarations().genericAliases.contains(aliasKey) 'aGenericAlias'
			for claim in self.genericAliasClaimsOf(aliasKey) 'eachGenericAliasClaim'
				claims.push(claim)
			end 'eachGenericAliasClaim'
		end 'aGenericAlias'

		if let byFile = try self.claimantsOf(aliasKey) 'severalFilesDeclareTheTupleAlias'
			for (_, tuple) in byFile 'eachDeclaringFile'
				claims.push(tuple.claim)
			end 'eachDeclaringFile'
		end 'severalFilesDeclareTheTupleAlias' else 'atMostOneFileDoes'
			if let tuple = try self.aliasNamed(aliasKey) 'aTupleAlias'
				claims.push(tuple.claim)
			end 'aTupleAlias'
		end 'atMostOneFileDoes'

		return claims
	end 'collectTypeNameClaims'

	// ⭐⭐ **EVERY CROSS-KIND CONTESTED NAME, FOR THE ELEMENT-SCOPING MINT** —
	// `RangedAliasRegistry.settleRangeContests`' `alsoScope`, which is where the whole argument for it
	// lives. Read TWICE, by the two registries that must agree about which mints exist: this index's
	// (`settleRangeScopedInstances`) and the project's (`FrontEndRun`).
	//
	// ⚠ **IT IS EVERY CONTESTED NAME AND NOT THE ONES WITH A RANGED DECLARATION**, because "does a ranged
	// alias hold this name" is `distinctRangeClaimants`' question and the registry is where it is asked. A
	// name with no ranged declaration is skipped there, in the one place that can see it.
	//
	// ⚠ Empty for every program in the corpus, which is what keeps both settles at one `count()`.
	export function crossKindScopedAliasNames() returns NameRoster
		match self.settledDeclarations().crossKindContests 'index'
			unwritten then return NameRoster.create(0)
			entries(byName) then return keysOfCrossKindContests(byName)
		end 'index'
	end 'crossKindScopedAliasNames'

	// ⭐⭐ **THE INTERFACE REGISTRY'S READER-AWARE DOOR.** `interfaceMap()`/`isInterfaceName` are
	// whole-program by construction, so the TYPE-POSITION doors ask the contest here rather than each
	// remembering it for itself.
	//
	// ⚠ It is `isInterfaceName`, not `lookupInterface`: this answers a membership question asked of every
	// type annotation in the program, and a union return is heap-boxed even for its `notFound` case (see
	// `Parser.parseTypeReference`).
	export function containsInterfaceFor(name ByteArray, readerFilePath FilePath) returns bool
		return isInterfaceName(self.settledDeclarations().interfaces, name: name) and not self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath)
	end 'containsInterfaceFor'

	// Do several KINDS of declaration hold `name`? The allocation-free gate the reader-aware doors open with:
	// a column nothing has contested answers without hashing.
	export function crossKindContested(name ByteArray) returns bool
		return self.writtenNameIsContestedAcrossKinds(name) and not self.settledDeclarations().aliasFamiliesBesideNominals.contains(name)
	end 'crossKindContested'

	export function declaresAnExitStatusRange(identity ByteArray) returns bool
		match self.settledDeclarations().typeAliases.declarationInAnyFile(identity) 'declaration'
			declared(alias) then return self.settledDeclarations().typeAliases.fitsTheBuiltinExitCode(alias)
			undeclared then return false
		end 'declaration'
	end 'declaresAnExitStatusRange'

	export function writtenNameIsContestedAcrossKinds(name ByteArray) returns bool
		match self.settledDeclarations().crossKindContests 'index'
			unwritten then return false
			entries(byName) then return byName.contains(name)
		end 'index'
	end 'writtenNameIsContestedAcrossKinds'

	export function writtenNameMeansARangedAliasHere(name ByteArray, readerFilePath FilePath) returns bool
		return self.writtenNameIsContestedAcrossKinds(name) and self.contestedTypeNameKindFor(name, readerFilePath: readerFilePath) == TypeDeclKind.rangedAlias
	end 'writtenNameMeansARangedAliasHere'

	export function writtenNameMeansAnAliasHere(name ByteArray, readerFilePath FilePath) returns bool
		return self.writtenNameIsContestedAcrossKinds(name) and isTypeAliasDecl(self.contestedTypeNameKindFor(name, readerFilePath: readerFilePath))
	end 'writtenNameMeansAnAliasHere'

	// ⭐⭐ **THE KIND A CROSS-KIND-CONTESTED NAME MEANS WHEN READ FROM `readerFilePath`** — the ONE decision
	// every reader-aware door is a face of, so a cast target, a parameter type, a field type and a form
	// probe cannot come to disagree about which of two coexisting declarations a file meant.
	export function contestedTypeNameKindFor(name ByteArray, readerFilePath FilePath) returns TypeDeclKind
		let claims = try self.crossKindClaimsOf(name) otherwise panic("ProgramSignatures.contestedTypeNameKindFor: '{String.from(name)}' is not cross-kind contested — every caller asks `crossKindContested` first")
		return self.rankedClaimIn(claims, readerFilePath: readerFilePath).claim.kind
	end 'contestedTypeNameKindFor'

	export function typeNameHidingFrom(name ByteArray, readerFilePath FilePath) returns TypeNameHiding
		if readerFilePath.equals(CompilerOwnedDeclFilePath) 'theCompilerWroteTheReference'
			return TypeNameHiding.notHidden
		end 'theCompilerWroteTheReference'

		let claims = self.movedTypeNameClaims(name, moved: self.settledDeclarations().interfaces.libraryNameOf(name))

		if claims.isEmpty() 'noDeclarationHoldsTheName'
			return TypeNameHiding.notHidden
		end 'noDeclarationHoldsTheName'

		let ranked = self.rankedClaimIn(claims, readerFilePath: readerFilePath)

		if not ranked.hiddenFromTheReader 'theReaderSeesTheWinner'
			return TypeNameHiding.notHidden
		end 'theReaderSeesTheWinner'

		// A library file never sees an author declaration, so an author's winning here is not a visibility
		// refusal: the sweep can fold the author's file before the library's own declaration is filed.
		if self.settledDeclarations().typeAliases.provenance.layerHidesClaim(ranked.claim, readerPath: readerFilePath.toString()) 'anAuthorsNameToALibraryReader'
			return TypeNameHiding.declaredInAnotherLayer
		end 'anAuthorsNameToALibraryReader'

		return hidingClaim(ranked.claim)
	end 'typeNameHidingFrom'

	function rankedClaimIn(claims TypeNameClaimArray, readerFilePath FilePath) returns RankedTypeNameClaim
		let ranked = self.settledDeclarations().typeAliases.provenance.rankedClaimIn(claims, readerPath: readerFilePath.toString())
		return RankedTypeNameClaim.create(try claims.get(ranked.at) otherwise panic("ProgramSignatures.rankedClaimIn: the ranked position {ranked.at} is one of these {claims.count()} claims"), hiddenFromTheReader: ranked.hiddenFromTheReader)
	end 'rankedClaimIn'

	// ⭐⭐ **DOES AN ALIAS ANSWER FOR `readerFilePath`, WHERE A NOMINAL DECLARATION ALSO HOLDS THE NAME?**
	// THE guard `TypeResolution.denotedNamedType`'s three nominal arms ask before claiming a name, so a
	// coexisting alias is not silently overruled by an arm ORDER.
	//
	// ⚠ **ONE `Map.contains` ON AN EMPTY MAP, ALLOCATING NOTHING.** It is asked once per named type
	// reference in the program — behind each arm's own registry probe, so only for a name that IS a
	// struct/enum/interface — and `denotedNamedType`'s header records the +36 × 2^n allocations across the
	// scale ladder that ONE boxed union at this door cost.
	export function aliasShadowsNominalFor(name ByteArray, readerFilePath FilePath) returns bool
		if not self.crossKindContested(name) 'noSecondKindHoldsTheName'
			return false
		end 'noSecondKindHoldsTheName'

		return isTypeAliasDecl(self.contestedTypeNameKindFor(name, readerFilePath: readerFilePath))
	end 'aliasShadowsNominalFor'

	// ⭐⭐ **THE LAYOUT DOORS, READER-AWARE — `structInAnyFile` / `enumInAnyFile` WITH THE CONTEST
	// APPLIED.** The `contains*For` predicates answer "is it one?"; these answer "which one", and a
	// caller that needs the LAYOUT — a field offset, an enum's `carriesPayloads()` — must not get
	// another file's.
	//
	// ⛔⛔ **MEASURED, and it is why these exist at all.** `Parser.enumMatchFor` classified a VALUE
	// minted in the file being parsed by asking `enumInAnyFile`: in a file meaning
	// `typealias Container = int(0 to 5)` it found ANOTHER file's `union Container`,
	// `carriesPayloads()` said yes, and the return path emitted **`__mm_retain` on the integer 1** — a
	// segfault (exit 139) in a function whose own file has no union in it.
	export function structFor(name ByteArray, readerFilePath FilePath) returns DeclaredStruct
		if self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath) 'anotherDeclarationAnswersHere'
			return DeclaredStruct.undeclared
		end 'anotherDeclarationAnswersHere'

		return self.structInAnyFile(name)
	end 'structFor'

	export function enumFor(name ByteArray, readerFilePath FilePath) returns DeclaredEnum
		if self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath) 'anotherDeclarationAnswersHere'
			return DeclaredEnum.undeclared
		end 'anotherDeclarationAnswersHere'

		return self.enumInAnyFile(name)
	end 'enumFor'

	function nominalTypeNameIn(name ByteArray) returns DeclaredTypeName
		match self.structInAnyFile(name) 'aStruct'
			declared(layout) then return DeclaredTypeName.declared(TypeDeclKind.structType, visibility: layout.visibility, declFilePath: layout.declFilePath)
			undeclared then break
		end 'aStruct'

		match self.enumInAnyFile(name) 'anEnumOrUnion'
			declared(layout) then return DeclaredTypeName.declared(TypeDeclKind.unionType if layout.isUnion else TypeDeclKind.enumType, visibility: layout.visibility, declFilePath: layout.declFilePath)
			undeclared then break
		end 'anEnumOrUnion'

		return self.interfaceDeclaredIn(name)
	end 'nominalTypeNameIn'

	function declaredTypeNameIn(written ByteArray, readerFilePath FilePath) returns DeclaredTypeName
		let meant = self.writtenAlias(written, readerFilePath: readerFilePath, wanted: WantedAliasKinds.everyAlias)
		let name = meant.keyOf()
		let meaningFile = meant.meaningFileOf()

		match self.innerAliasDeclaredIn(self.innerAliasKeyOf(name, readerFilePath: meaningFile)) 'anInnerAlias'
			declared(innerKind, innerVisibility, innerFile) then return DeclaredTypeName.declared(innerKind, visibility: innerVisibility, declFilePath: innerFile)
			undeclared then break
		end 'anInnerAlias'

		if let form = try self.aliasFormFor(name, readerFilePath: meaningFile) 'anAliasForm'
			return self.aliasFormDeclaredIn(form, name: name, readerFilePath: meaningFile)
		end 'anAliasForm'

		match self.structFor(name, readerFilePath: meaningFile) 'aStruct'
			declared(layout) then return DeclaredTypeName.declared(TypeDeclKind.structType, visibility: layout.visibility, declFilePath: layout.declFilePath)
			undeclared then break
		end 'aStruct'

		match self.enumFor(name, readerFilePath: meaningFile) 'anEnum'
			declared(layout) then return DeclaredTypeName.declared(TypeDeclKind.unionType if layout.isUnion else TypeDeclKind.enumType, visibility: layout.visibility, declFilePath: layout.declFilePath)
			undeclared then break
		end 'anEnum'

		match self.aliasOf(name, readerFilePath: meaningFile) 'aRangedAlias'
			declared(alias) then return DeclaredTypeName.declared(TypeDeclKind.rangedAlias, visibility: alias.visibility, declFilePath: alias.declFilePath)
			undeclared then break
		end 'aRangedAlias'

		if not self.containsInterfaceFor(name, readerFilePath: meaningFile) 'noInterfaceAnswersHere'
			return DeclaredTypeName.undeclared
		end 'noInterfaceAnswersHere'

		return self.interfaceDeclaredIn(name)
	end 'declaredTypeNameIn'

	export function innerAliasHidingFrom(written ByteArray, readerFilePath FilePath) returns TypeNameHiding
		let key = self.innerAliasKeyOf(written, readerFilePath: readerFilePath)

		if not self.namesAnInnerAliasOfAnyForm(key) 'notATypesOwnAlias'
			return TypeNameHiding.notHidden
		end 'notATypesOwnAlias'

		match self.declaredTypeNameIn(key, readerFilePath: readerFilePath) 'declaration'
			undeclared then return TypeNameHiding.notHidden
			declared(_, visibility, declFilePath) then return TypeNameHiding.notHidden if self.isVisibleFrom(visibility, declFilePath: declFilePath, readerFilePath: readerFilePath) else TypeNameHiding.hidden(HiddenSymbolKind.typeAliasDeclaration, tier: visibility)
		end 'declaration'
	end 'innerAliasHidingFrom'

	function innerAliasKeyOf(written immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if not containsQualifier(written) or self.namesAnInnerAliasOfAnyForm(written) 'notAPerInstanceSpelling'
			return written
		end 'notAPerInstanceSpelling'

		match splitQualifiedName(written) 'split'
			notQualified then return written
			parts(prefix, member) then return try self.perInstanceTemplateName(prefix, member: member, readerFilePath: readerFilePath) otherwise written
		end 'split'
	end 'innerAliasKeyOf'

	function innerAliasDeclaredIn(qualified ByteArray) returns DeclaredTypeName
		if let ranged = try self.settledDeclarations().innerAliases.get(qualified) 'aRangedInnerAlias'
			return DeclaredTypeName.declared(TypeDeclKind.rangedAlias, visibility: ranged.visibility, declFilePath: ranged.declFilePath)
		end 'aRangedInnerAlias'

		if not self.settledDeclarations().interfaceAliases.contains(qualified) 'notAnInterfacesOwnAlias'
			return DeclaredTypeName.undeclared
		end 'notAnInterfacesOwnAlias'

		match splitQualifiedName(qualified) 'split'
			notQualified then return DeclaredTypeName.undeclared
			parts(owner, _) then return self.interfaceAliasOwnedBy(owner)
		end 'split'
	end 'innerAliasDeclaredIn'

	function interfaceAliasOwnedBy(owner ByteArray) returns DeclaredTypeName
		match self.interfaceDeclaredIn(owner) 'owner'
			undeclared then return DeclaredTypeName.undeclared
			declared(_, visibility, declFilePath) then return DeclaredTypeName.declared(TypeDeclKind.genericAlias, visibility: visibility, declFilePath: declFilePath)
		end 'owner'
	end 'interfaceAliasOwnedBy'

	export function aliasFormFor(name ByteArray, readerFilePath FilePath) returns AliasForm throws UnknownTypeName
		if self.isFunctionAliasFor(name, readerFilePath: readerFilePath) 'aFunctionAlias'
			return AliasForm.functionAlias
		end 'aFunctionAlias'

		if self.isAliasOfFormFor(name, readerFilePath: readerFilePath, wanted: FormAliasKind.generic) 'aGenericAlias'
			return AliasForm.genericAlias
		end 'aGenericAlias'

		if self.isAliasOfFormFor(name, readerFilePath: readerFilePath, wanted: FormAliasKind.tuple) 'aTupleAlias'
			return AliasForm.tupleAlias
		end 'aTupleAlias'

		throw UnknownTypeName.notDeclared
	end 'aliasFormFor'

	function aliasFormDeclaredIn(form AliasForm, name ByteArray, readerFilePath FilePath) returns DeclaredTypeName
		match form 'form'
			functionAlias then return self.functionAliasDeclaredIn(name, readerFilePath: readerFilePath)
			genericAlias then return self.genericAliasDeclaredIn(name, readerFilePath: readerFilePath)
			tupleAlias then return self.tupleAliasDeclaredIn(name, readerFilePath: readerFilePath)
		end 'form'
	end 'aliasFormDeclaredIn'

	function tupleAliasDeclaredIn(name ByteArray, readerFilePath FilePath) returns DeclaredTypeName
		let claim = self.scopedTupleAlias(name, readerFilePath: readerFilePath).claim
		return DeclaredTypeName.declared(claim.kind, visibility: claim.visibility, declFilePath: claim.declFilePath)
	end 'tupleAliasDeclaredIn'

	// ⚠ **BUILT ON FIRST USE AND EXTENDED FROM A WATERMARK, AND WHOLE BY THE SETTLE.**
	// `settleBaseline` forces it, so every later call returns at the watermark guard; without that
	// guard every front-end worker would store into the settled declarations they all share. Sound
	// only because `genericAliasDecls` is push-only, which is what makes re-indexing from the
	// watermark monotone — a removal would leave a stale index nothing re-derives.
	//
	// Every declaration index is filed per name, unlike `indexInterfaceDeclarationSites`, because the
	// reader-scoped door ranks a name's claimants against each other and so needs all of them.
	function indexGenericAliasDeclarations()
		let declared = self.settledDeclarations().genericAliasDecls

		if self.settledDeclarations().genericAliasDeclsIndexedThrough == declared.count() 'everyDeclarationIndexed'
			return
		end 'everyDeclarationIndexed'

		for at in self.settledDeclarations().genericAliasDeclsIndexedThrough upto declared.count() 'eachUnindexedDeclaration'
			let decl = try declared.get(at) otherwise panic("ProgramSignatures.indexGenericAliasDeclarations: genericAliasDecls.get OOB at {at} below count {declared.count()}")
			let held = try self.mainThreadSettled().genericAliasDeclIndexByName.get(decl.aliasName) otherwise GenericAliasDeclIndexArray.create(0)
			held.push(at)
			self.mainThreadSettled().genericAliasDeclIndexByName.upsert(decl.aliasName, value: held)
		end 'eachUnindexedDeclaration'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.genericAliasDeclsIndexedThrough = self.settledDeclarations().genericAliasDecls.count()
	end 'indexGenericAliasDeclarations'

	function writtenGenericAliasDecl(name ByteArray, readerFilePath FilePath) returns ScopedGenericAliasDecl
		let written = self.writtenAlias(name, readerFilePath: readerFilePath, wanted: WantedAliasKinds.generic)

		return self.scopedGenericAliasDecl(written.keyOf(), readerFilePath: written.meaningFileOf())
	end 'writtenGenericAliasDecl'

	function scopedGenericAliasDecl(name ByteArray, readerFilePath FilePath) returns ScopedGenericAliasDecl
		let held = try self.heldGenericAliasDeclsOf(name) otherwise return ScopedGenericAliasDecl.undeclared

		return self.rankedGenericAliasDecl(held, readerFilePath: readerFilePath)
	end 'scopedGenericAliasDecl'

	// Ranks only the declarations the contest recorded in `participants`. An `extension` body's alias is
	// filed per conformer after the contest settles and holds no mint, so ranking it would hand
	// `genericAliasMintFor` and `scopedGenericAliasInstance` a declaration they cannot resolve.
	function contestedGenericAliasDecl(name ByteArray, readerFilePath FilePath, participants GenericAliasByDeclaringFile) returns ScopedGenericAliasDecl
		let held = try self.heldGenericAliasDeclsOf(name) otherwise return ScopedGenericAliasDecl.undeclared

		let participating = GenericAliasDeclIndexArray.create(0)

		for at in held 'eachDeclaration'
			if participants.contains(self.indexedGenericAliasDecl(at).filePath.toString()) 'declaredBeforeTheContestSettled'
				participating.push(at)
			end 'declaredBeforeTheContestSettled'
		end 'eachDeclaration'

		return self.rankedGenericAliasDecl(participating, readerFilePath: readerFilePath)
	end 'contestedGenericAliasDecl'

	function heldGenericAliasDeclsOf(name ByteArray) returns GenericAliasDeclIndexArray throws MapError
		self.indexGenericAliasDeclarations()
		return try self.settledDeclarations().genericAliasDeclIndexByName.get(name)
	end 'heldGenericAliasDeclsOf'

	function indexedGenericAliasDecl(at ElementIndex) returns GenericAliasEntry
		return try self.settledDeclarations().genericAliasDecls.get(at) otherwise panic("ProgramSignatures.indexedGenericAliasDecl: genericAliasDecls.get OOB at {at}, an index only `indexGenericAliasDeclarations` minted")
	end 'indexedGenericAliasDecl'

	function rankedGenericAliasDecl(held GenericAliasDeclIndexArray, readerFilePath FilePath) returns ScopedGenericAliasDecl
		if held.count() == 0 'noDeclarationHeld'
			return ScopedGenericAliasDecl.undeclared
		end 'noDeclarationHeld'

		let claims = TypeNameClaimArray.create(held.count(), zeroed: false)

		for at in held 'eachDeclaration'
			claims.push(self.genericAliasDeclClaim(self.indexedGenericAliasDecl(at)))
		end 'eachDeclaration'

		let ranked = self.settledDeclarations().typeAliases.provenance.rankedClaimIn(claims, readerPath: readerFilePath.toString())
		return ScopedGenericAliasDecl.declared(try self.heldGenericAliasDecl(held, at: ranked.at) otherwise panic("ProgramSignatures.rankedGenericAliasDecl: the ranked position {ranked.at} is one of the {held.count()} held declarations"))
	end 'rankedGenericAliasDecl'

	function genericAliasDeclClaim(decl GenericAliasEntry) returns TypeNameClaim
		return self.typeNameClaim(TypeDeclKind.genericAlias, visibility: decl.visibility, declFilePath: decl.filePath)
	end 'genericAliasDeclClaim'

	function heldGenericAliasDecl(held GenericAliasDeclIndexArray, at ElementIndex) returns GenericAliasEntry throws ArrayError
		return try self.settledDeclarations().genericAliasDecls.get(try held.get(at))
	end 'heldGenericAliasDecl'

	function genericAliasDeclaredIn(name ByteArray, readerFilePath FilePath) returns DeclaredTypeName
		match self.scopedGenericAliasDecl(name, readerFilePath: readerFilePath) 'scoped'
			undeclared then return DeclaredTypeName.undeclared
			declared(decl) then return DeclaredTypeName.declared(TypeDeclKind.genericAlias, visibility: decl.visibility, declFilePath: decl.filePath)
		end 'scoped'
	end 'genericAliasDeclaredIn'

	function functionAliasDeclaredIn(name ByteArray, readerFilePath FilePath) returns DeclaredTypeName
		match self.functionAliasFrom(name, readerFilePath: readerFilePath) 'aFunctionAlias'
			declared(alias) then return DeclaredTypeName.declared(TypeDeclKind.functionAlias, visibility: alias.visibility, declFilePath: alias.declFilePath)
			undeclared then return DeclaredTypeName.undeclared
		end 'aFunctionAlias'
	end 'functionAliasDeclaredIn'

	// Lazy and watermark-extended for `indexGenericAliasDeclarations`' reason, which owns it. One site per
	// name, the first: an interface name is not resolved per reader, so there is no claimant to rank.
	function indexInterfaceDeclarationSites()
		if self.settledDeclarations().interfaceDeclSitesIndexedThrough == self.settledDeclarations().interfaceDeclSites.count() 'everySiteIndexed'
			return
		end 'everySiteIndexed'

		for at in self.settledDeclarations().interfaceDeclSitesIndexedThrough upto self.settledDeclarations().interfaceDeclSites.count() 'eachUnindexedSite'
			let site = try self.settledDeclarations().interfaceDeclSites.get(at) otherwise panic("ProgramSignatures.indexInterfaceDeclarationSites: interfaceDeclSites.get OOB at {at} below count {self.settledDeclarations().interfaceDeclSites.count()}")

			let name = try site.name.declaredName() otherwise continue

			if not self.settledDeclarations().interfaceDeclSiteIndexByName.contains(name) 'firstSiteOfThisName'
				self.mainThreadSettled().interfaceDeclSiteIndexByName.upsert(name, value: at)
			end 'firstSiteOfThisName'
		end 'eachUnindexedSite'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.interfaceDeclSitesIndexedThrough = self.settledDeclarations().interfaceDeclSites.count()
	end 'indexInterfaceDeclarationSites'

	function interfaceDeclaredIn(name ByteArray) returns DeclaredTypeName
		self.indexInterfaceDeclarationSites()
		let at = try self.settledDeclarations().interfaceDeclSiteIndexByName.get(name) otherwise return DeclaredTypeName.undeclared
		let site = try self.settledDeclarations().interfaceDeclSites.get(at) otherwise panic("ProgramSignatures.interfaceDeclaredIn: interfaceDeclSites.get OOB at {at}, an index only the push beside it minted")
		return DeclaredTypeName.declared(TypeDeclKind.interfaceType, visibility: site.visibility, declFilePath: site.path)
	end 'interfaceDeclaredIn'

	// ⭐⭐ **`containsStructInAnyFile` WITH THE CONTEST APPLIED — "does a `type` of this name answer for THIS
	// FILE?"** Every door that decides what a WRITTEN name means asks this one; only a reader with no file
	// at all asks the bare twin.
	export function containsStructFor(name ByteArray, readerFilePath FilePath) returns bool
		return self.containsStructInAnyFile(name) and not self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath)
	end 'containsStructFor'

	// The twin one registry over. ⛔ **MEASURED without it:** `a.maxon` meaning `int(0 to 5)` by `Status`
	// reached `b.maxon`'s `enum Status` through the member door and stored its `big = 200` into a slot
	// `a.maxon` declares `int(0 to 5)` — the RANGE from one declaration and the VALUE from the other,
	// compiling clean and **exiting 201**.
	export function containsEnumFor(name ByteArray, readerFilePath FilePath) returns bool
		return self.containsEnumInAnyFile(name) and not self.aliasShadowsNominalFor(name, readerFilePath: readerFilePath)
	end 'containsEnumFor'

	// ⭐⭐ **IS `form` WHAT `readerFilePath` MEANS BY `name`? — the shared body of every reader-aware form
	// probe**, and the reason there is no fourth spelling of the rule. Two things can make an alias form
	// not what a reader means: a cross-kind CONTEST the reader is on the losing side of, and the reader's
	// OWN file declaring a nominal type of the name. Every other name means its one kind for every reader.
	//
	// ⚠ **IT DOES *NOT* ASK WHETHER `form`'s REGISTRY HOLDS THE NAME**, and that is what makes it shareable:
	// each caller keeps its own registry probe in front — `functionTypeAliases.contains`,
	// `aliasUnderlyingFor` — and that probe is what keeps the common answer free, since a name no
	// registry of that form holds never reaches here at all.
	export function readerMeansKind(name ByteArray, readerFilePath FilePath, kind TypeDeclKind) returns bool
		if self.crossKindContested(name) 'bothKindsMayStand'
			return self.contestedTypeNameKindFor(name, readerFilePath: readerFilePath) == kind
		end 'bothKindsMayStand'

		if isTypeAliasDecl(kind) and self.readersOwnFileDeclaresANominal(name, readerFilePath: readerFilePath) 'theReadersOwnNominalDeclarationAnswers'
			return false
		end 'theReadersOwnNominalDeclarationAnswers'

		return true
	end 'readerMeansKind'

	// A file that declares a `type`/`enum`/`union` of the name means its OWN declaration, whether or not the
	// pair may coexist. `crossKindContested` holds only the pairs that MAY, so a COLLIDING pair reaches
	// here uncontested: without this test the reader is handed the other file's alias, and a float alias's
	// return slot meets an enum-tagged value at `coerceToDeclared` — a panic on a program the merge is
	// already refusing with E3006.
	function readersOwnFileDeclaresANominal(name ByteArray, readerFilePath FilePath) returns bool
		if not self.containsStructInAnyFile(name) and not self.containsEnumInAnyFile(name) 'noNominalDeclarationHoldsTheName'
			return false
		end 'noNominalDeclarationHoldsTheName'

		match self.structInAnyFile(name) 'aStruct'
			declared(layout) then return layout.declFilePath.toString().equals(readerFilePath.toString())
			undeclared then break
		end 'aStruct'

		match self.enumInAnyFile(name) 'anEnumOrUnion'
			declared(layout) then return layout.declFilePath.toString().equals(readerFilePath.toString())
			undeclared then return false
		end 'anEnumOrUnion'
	end 'readersOwnFileDeclaresANominal'

	// ⭐ **`isFunctionAliasInAnyFile`, WITH THE CONTEST APPLIED** — the door every FORM probe that has a reader file
	// asks, so `a.maxon`'s `5 as Handler` means `a.maxon`'s ranged alias while `b.maxon`'s `f Handler`
	// means `b.maxon`'s function one. The bare twin stays, and stays correct, for the readers that hold no
	// file.
	export function isFunctionAliasFor(name ByteArray, readerFilePath FilePath) returns bool
		return self.settledDeclarations().functionTypeAliases.contains(name) and self.readerMeansKind(name, readerFilePath: readerFilePath, kind: TypeDeclKind.functionAlias)
	end 'isFunctionAliasFor'

	// `isGenericAlias` or `isTupleAlias` with the contest applied — `isFunctionAliasFor`'s twin for the other
	// two alias forms. A directory-qualified name is asked in the file it names.
	export function isAliasOfFormFor(name ByteArray, readerFilePath FilePath, wanted FormAliasKind) returns bool
		let written = self.writtenAlias(name, readerFilePath: readerFilePath, wanted: self.wantedKindsOfForm(wanted))

		return self.formHeldUnder(written.keyOf(), readerFilePath: written.meaningFileOf(), wanted: wanted)
	end 'isAliasOfFormFor'

	function formHeldUnder(key ByteArray, readerFilePath FilePath, wanted FormAliasKind) returns bool
		let isGeneric = wanted == FormAliasKind.generic

		if not (self.settledDeclarations().genericAliases.contains(key) if isGeneric else self.holdsTupleAlias(key)) 'noDeclarationUnderThisKey'
			return false
		end 'noDeclarationUnderThisKey'

		return self.readerMeansKind(key, readerFilePath: readerFilePath, kind: TypeDeclKind.genericAlias if isGeneric else TypeDeclKind.tupleAlias)
	end 'formHeldUnder'

	// ⭐ **THE TYPE NAMES A FILE'S TOP-LEVEL INITIALIZERS NAME — a `use` the real parse
	// structurally cannot see.**
	//
	// `let SENTINEL = 5 as Slot` is the only mention of `Slot` in many real files, and `var g =
	// ItemArray.create()` is very often the only mention of `ItemArray` — and the E3062 check would call
	// both aliases unused. The real parse cannot see either: the initializer is parsed by a throwaway
	// `Parser` (`foldInitializerDuringSweep`, `probeRecordInitializer`) before any file is parsed, and its
	// artifact is discarded.
	//
	// So the use is recorded HERE, on the index the sweep is building and that every parse then reads. That
	// is the same "record a use where the name is RESOLVED" rule the parser hooks follow
	// (`Parser.recordTypeNameUse`); this is simply the door for the one reader whose artifact is not kept. It is keyed per NAMING FILE, because both readers ask a question about a file — its own
	// (E3062) or every other one (E3092).
	//
	// ⚠ It records EVERY such name, including `as int` and `as ExitCode`. Filtering
	// to alias names would mean asking the alias registry mid-sweep, when it is still being built and
	// an absence means only "not swept yet"; and a name that is not a declared alias matches no
	// candidate, so the extra entries answer nothing and cost one set insert each.
	export function recordConstInitializerTypeName(name ByteArray, declFilePath FilePath)
		self.mainThreadSettled().constInitializerTypeNames.insert(fileScopedDeclKey(name, declFilePath: declFilePath))
		self.mainThreadSettled().constInitializerTypeSites.push(NameInFile.create(name, readerFilePath: declFilePath))
	end 'recordConstInitializerTypeName'

	// Did a top-level binding declared in `declFilePath` name `name` in its initializer? The membership
	// half, for E3062's per-file check.
	// It pays `fileScopedDeclKey`'s ~4 allocations, and pays them once per UNEXPORTED TYPEALIAS
	// DECLARED — not per use and not per name reference — which is why the composite key is affordable
	// here where `RangedAliasRegistry` refuses it.
	export function namesTypeInConstInitializer(name ByteArray, declFilePath FilePath) returns bool
		return self.settledDeclarations().constInitializerTypeNames.contains(fileScopedDeclKey(name, declFilePath: declFilePath))
	end 'namesTypeInConstInitializer'

	// The log of the same names, for `checkUnusedExports` to replay — its question is "did any OTHER file
	// name it?", which is a walk over the sites rather than a probe of one file's.
	export function constInitializerTypeSiteCount() returns ElementIndex
		return self.settledDeclarations().constInitializerTypeSites.count()
	end 'constInitializerTypeSiteCount'

	export function constInitializerTypeSiteAt(index ElementIndex) returns NameInFile
		return try self.settledDeclarations().constInitializerTypeSites.get(index) otherwise panic("ProgramSignatures.constInitializerTypeSiteAt: OOB at {index} — the caller walks this list's own count()")
	end 'constInitializerTypeSiteAt'

	export function aliasUnderlyingFor(name ByteArray, readerFilePath FilePath) returns MaxonType throws MapError
		return try self.settledDeclarations().typeAliases.underlyingFor(name, readerFilePath: readerFilePath)
	end 'aliasUnderlyingFor'

	// Is `name` a ranged FLOAT typealias (`typealias Weight = float(f64.min to f64.max)`) as
	// `readerFilePath` resolves it? The `bool` half of `aliasUnderlyingFor`, and the reader-aware
	// sibling of `isFunctionAliasFor`/`isAliasOfFormFor`.
	//
	// ⚠ An INT alias is deliberately NOT re-tagged by `floatAliasResolved`: `named` already reads as an integer
	// everywhere (`tagIsIntegral`), and its NAME is what carries the range and the signedness that
	// `valueIsUnsigned` and the range checks read off it. A FLOAT alias is the one `named` type whose
	// VALUE lives in a different register file, so it is the one that cannot be left overloaded.
	export function isFloatAliasFor(name ByteArray, readerFilePath FilePath) returns bool
		if let underlying = try self.aliasUnderlyingFor(name, readerFilePath: readerFilePath) 'rangedAlias'
			return tagIsFloat(maxonTypeTag(underlying))
		end 'rangedAlias'

		return false
	end 'isFloatAliasFor'

	// --- Inner + per-instance ranged aliases ---

	// Is `name` a BASE-TEMPLATE inner alias ("Wrapper.Idx") — the shared-body form a generic method's bare
	// `Idx` return/parameter resolves to? Membership in `innerAliases`.
	export function isInnerAlias(name ByteArray) returns bool
		return self.settledDeclarations().innerAliases.contains(name)
	end 'isInnerAlias'

	export function innerAliasInstanceOf(qualified ByteArray) returns GenericInstanceId throws MapError
		if let interfacesOwn = try self.settledDeclarations().interfaceAliases.get(qualified) 'anInterfacesOwnAlias'
			return interfacesOwn
		end 'anInterfacesOwnAlias'

		return try self.settledDeclarations().genericAliases.get(qualified)
	end 'innerAliasInstanceOf'

	// Every form of nested alias, a function's and an interface's included — what visibility and the audits
	// ask. `declaresInnerAlias` below asks the narrower per-instance question.
	export function namesAnInnerAliasOfAnyForm(qualified ByteArray) returns bool
		match splitQualifiedName(qualified) 'split'
			notQualified then return false
			parts(owner, _) then return self.namesATypeOwningAnInnerAlias(owner, qualified: qualified)
		end 'split'
	end 'namesAnInnerAliasOfAnyForm'

	function namesATypeOwningAnInnerAlias(owner ByteArray, qualified ByteArray) returns bool
		match self.nominalTypeNameIn(owner) 'owner'
			undeclared then return false
			declared then return self.declaresInnerAlias(qualified) or self.settledDeclarations().nestedFunctionAliasMembers.contains(qualified) or self.settledDeclarations().interfaceAliases.contains(qualified)
		end 'owner'
	end 'namesATypeOwningAnInnerAlias'

	// ⭐ **DOES THE BASE-QUALIFIED NAME `qualified` NAME A NESTED TYPEALIAS OF *ANY* PER-INSTANCE
	// FORM?** Three registries carry those — a RANGED one lands in `innerAliases`, a GENERIC-INSTANCE
	// one in `genericAliases` and a TUPLE one in `tupleAliases` — and every one of them is keyed
	// `<Type>.<member>`, so "did this type declare a nested alias called X?" is one question with
	// three places to look. Spelled once here rather than at the asker, because the day a fifth alias
	// form arrives the asker would be the copy that did not learn about it.
	//
	// ⚠ **A FUNCTION alias is deliberately absent even though it IS qualified by its enclosing type**
	// (`Parser.publishNestedFunctionAlias` files `<Type>.<member>` beside the bare name). The question
	// this asks is not "is the name keyed?" but "is it a MEMBER of the type?" — every caller uses the answer
	// to reach the per-instance machinery, and a function alias is not per-instance: it declares a file-scope
	// name too, and its qualified copy carries the identical signature. `isFunctionAliasFor` is the door for it.
	//
	// ⚠ **THE FOURTH SOURCE IS A NAME SET RATHER THAN A REGISTRY, AND IT IS WHAT MAKES THE ANSWER WHOLE-PROGRAM
	// FOR AN `extension` BODY.** `foldExtensionDeclarations` fills the three registries above one site at
	// a time WHILE reading each body's signatures, so during that pass they can only answer for the sites
	// already visited — the directory walk's order deciding what a written name means, which is exactly what
	// `StdlibLoader`'s header forbids. `extensionInnerAliasMembers` is filled by a pre-pass ahead of
	// the whole fold, so it answers the same for every site. It is a SUPERSET during the fold and identical
	// afterwards, and the excess is bounded by the same tolerance every sweep entry point has: a member the
	// fold cannot read publishes no declaration, and the program is being refused for that a moment later.
	export function declaresInnerAlias(qualified ByteArray) returns bool
		return self.settledDeclarations().innerAliases.contains(qualified) or self.settledDeclarations().genericAliases.contains(qualified) or self.holdsTupleAlias(qualified) or self.settledDeclarations().extensionInnerAliasMembers.contains(qualified)
	end 'declaresInnerAlias'

	// The inner alias `name` names ("Wrapper.Idx"), or `undeclared`. Its stored `.name` is the BARE member
	// (`Idx`) the method-return retype re-qualifies with a concrete receiver's instance alias.
	export function innerAliasOf(name ByteArray) returns DeclaredAlias
		let alias = try self.settledDeclarations().innerAliases.get(name) otherwise return DeclaredAlias.undeclared
		return DeclaredAlias.declared(alias)
	end 'innerAliasOf'

	export function rangeCheckedAliasNamed(name ByteArray, readerFilePath FilePath) returns RangedTypeAlias throws MapError
		return try requireDeclaredAlias(self.fileScopedOrInnerAliasNamed(name, readerFilePath: readerFilePath))
	end 'rangeCheckedAliasNamed'

	export function fileScopedOrInnerAliasNamed(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		return self.fileScopedOrInnerDeclaredAlias(self.aliasOf(name, readerFilePath: readerFilePath), name: name)
	end 'fileScopedOrInnerAliasNamed'

	export function requirementRangedAlias(requirement RequirementType, interfaceName ByteArray) returns RangedTypeAlias throws MapError
		let name = try requirement.nominalName() otherwise throw MapError.keyNotFound
		return try self.rangeCheckedAliasNamed(name, readerFilePath: self.declaringInterface(interfaceName).declFilePath)
	end 'requirementRangedAlias'

	export function requirementRangedIdentity(requirement RequirementType, interfaceName ByteArray) returns immutable ByteArray
		let name = try requirement.nominalName() otherwise return EmptySourceText
		return self.rangedIdentityOfSpelling(name, readerFilePath: self.declaringInterface(interfaceName).declFilePath)
	end 'requirementRangedIdentity'

	export function fileScopedOrInnerDeclaredAlias(fileScoped DeclaredAlias, name ByteArray) returns DeclaredAlias
		match fileScoped 'fileScoped'
			declared then return fileScoped
			undeclared then return self.innerAliasOf(name)
		end 'fileScoped'
	end 'fileScopedOrInnerDeclaredAlias'

	// The BARE member of the base-qualified inner alias `name` (`Wrapper.Idx` ⇒ `Idx`); `absent` when
	// `name` is not an inner alias. What the method-return retype re-qualifies
	// (`{receiverAlias}.{member}`).
	export function innerAliasMember(name ByteArray) returns immutable ByteArray throws AbsentError
		match self.innerAliasOf(name) 'm'
			declared(alias) then return alias.name
			undeclared then throw AbsentError.absent
		end 'm'
	end 'innerAliasMember'

	// ⭐ **IS `name` A REGISTERED PER-INSTANCE ALIAS ("IntWrapper.Idx")?** — the nominal-identity gate the
	// aggregate check reads. Its prefix must be a generic-instance ALIAS whose base declares the inner alias
	// named by its member. Keyed on the INSTANCE-ALIAS NAME, not the gid: `WrapperA` and `WrapperB` share one
	// gid yet are distinct aliases, so `WrapperA.Idx ≠ WrapperB.Idx` — the whole point of the gate.
	// ⭐⭐ **DO TWO NOMINAL IDENTITIES CONFLICT? — the NAME half of every coercion rule, and the one place the
	// decay is written.** Two different names always conflict. One name against NONE conflicts too — an
	// aggregate meeting a scalar is exactly the case a tag check cannot see, because `ValueTypeTag.named` is
	// overloaded — UNLESS the named side is a SCALAR WEARING A NAME (a ranged typealias, a per-instance
	// alias), which decays in both directions: a value with no identity of its own fits any alias slot of its
	// structural class, and a named value fits an unnamed slot. Only two DIFFERENT names conflict.
	//
	// ⚠ A `String` or a boxed union reaching an alias slot answers `got.isEmpty()` too, and is refused by the
	// TAG check every coercion site opens with rather than here, which is where it has always been refused.
	//
	// It is shared with `TypeResolution.shapesAgreeUnder`, whose per-position identities are built by the
	// same extractors: a function shape's parameter and return names are the same kind of answer, so a second
	// spelling of the rule there is exactly what would let two doors disagree about one pair of names.
	export function identitiesConflict(expected ByteArray, got ByteArray, readerFilePath FilePath) returns bool
		if not namedAggregatesConflict(expected, got: got) 'theTwoIdentitiesAgree'
			return false
		end 'theTwoIdentitiesAgree'

		if isTupleTypeName(expected) and isTupleTypeName(got) 'twoTuples'
			return self.tuplesConflict(expected, got: got)
		end 'twoTuples'

		if expected.isEmpty() 'aNamedScalarIntoAnUnnamedSlot'
			return not self.aliasIdentityDecays(got)
		end 'aNamedScalarIntoAnUnnamedSlot'

		if got.isEmpty() 'anUnnamedValueIntoANamedScalarSlot'
			return not self.aliasIdentityDecays(expected)
		end 'anUnnamedValueIntoANamedScalarSlot'

		// A generic method's shared signature can name only the template inner alias, so a per-instance alias
		// meets it wherever an instance's value crosses that signature.
		if self.instantiatesInnerAlias(got, template: expected) or self.instantiatesInnerAlias(expected, template: got) 'anInstanceOfTheTemplateAlias'
			return false
		end 'anInstanceOfTheTemplateAlias'

		return not self.aliasWidensTo(got, ancestor: expected, readerFilePath: readerFilePath)
	end 'identitiesConflict'

	export function identityFitsSlot(source ByteArray, slot ByteArray, readerFilePath FilePath) returns bool
		if not namedAggregatesConflict(slot, got: source) 'theTwoIdentitiesAgree'
			return true
		end 'theTwoIdentitiesAgree'

		if isTupleTypeName(slot) and isTupleTypeName(source) 'twoTuples'
			return not self.tuplesConflict(slot, got: source)
		end 'twoTuples'

		if source.isEmpty() 'anUnnamedValueIntoANamedSlot'
			return self.aliasIdentityDecays(slot) and self.namedAliasAdmitsEveryValue(slot, readerFilePath: readerFilePath)
		end 'anUnnamedValueIntoANamedSlot'

		if slot.isEmpty() 'aNamedValueIntoAnUnnamedSlot'
			return self.aliasIdentityDecays(source)
		end 'aNamedValueIntoAnUnnamedSlot'

		if self.instantiatesInnerAlias(source, template: slot) or self.instantiatesInnerAlias(slot, template: source) 'anInstanceOfTheTemplateAlias'
			return true
		end 'anInstanceOfTheTemplateAlias'

		return self.aliasWidensTo(source, ancestor: slot, readerFilePath: readerFilePath)
	end 'identityFitsSlot'

	function namedAliasAdmitsEveryValue(identity ByteArray, readerFilePath FilePath) returns bool
		match self.fileScopedOrInnerAliasNamed(identity, readerFilePath: readerFilePath) 'scoped'
			declared(alias) then return aliasAdmitsEveryValue(alias)
			undeclared then break
		end 'scoped'

		return match self.perInstanceAliasOf(identity, readerFilePath: readerFilePath) 'perInstance'
			declared(alias) gives aliasAdmitsEveryValue(alias)
			undeclared gives false
		end 'perInstance'
	end 'namedAliasAdmitsEveryValue'

	function tuplesConflict(expected ByteArray, got ByteArray) returns bool
		let expectedLayout = self.registeredTupleLayoutNamed(expected)
		let gotLayout = self.registeredTupleLayoutNamed(got)

		if expectedLayout.fieldCount() != gotLayout.fieldCount() 'differentArity'
			return true
		end 'differentArity'

		for i in 0 upto expectedLayout.fieldCount() 'eachElement'
			let expectedElement = try expectedLayout.fieldTypes.get(i) otherwise panic("ProgramSignatures.tuplesConflict: fieldTypes.get OOB at {i} below count {expectedLayout.fieldCount()}")
			let gotElement = try gotLayout.fieldTypes.get(i) otherwise panic("ProgramSignatures.tuplesConflict: fieldTypes.get OOB at {i} below count {gotLayout.fieldCount()}")

			if expectedLayout.fieldTypeSites.capabilityAt(i) != gotLayout.fieldTypeSites.capabilityAt(i) 'differentItemCapabilities'
				return true
			end 'differentItemCapabilities'

			if not maxonTypesDenoteSame(expectedElement, b: gotElement) 'differentElementTypes'
				if self.nestedTuplesConflict(expectedElement, got: gotElement) 'nestedTuplesDifferBeyondTheirBrands'
					return true
				end 'nestedTuplesDifferBeyondTheirBrands'

				continue
			end 'differentElementTypes'

			if maxonTypeTag(expectedElement) == ValueTypeTag.genericInstance and brandsConflict(expectedLayout.fieldDeclaredBrand(i as FieldIndex), got: gotLayout.fieldDeclaredBrand(i as FieldIndex)) 'twoBrandsOfOneInstance'
				return true
			end 'twoBrandsOfOneInstance'
		end 'eachElement'

		return false
	end 'tuplesConflict'

	function nestedTuplesConflict(expected MaxonType, got MaxonType) returns bool
		if not tagNamesADeclaredType(maxonTypeTag(expected)) or not tagNamesADeclaredType(maxonTypeTag(got)) 'notTwoRecords'
			return true
		end 'notTwoRecords'

		let expectedName = self.nameOfId(typeNameIdOf(expected))
		let gotName = self.nameOfId(typeNameIdOf(got))

		if not isTupleTypeName(expectedName) or not isTupleTypeName(gotName) 'notTwoTuples'
			return true
		end 'notTwoTuples'

		return self.tuplesConflict(expectedName, got: gotName)
	end 'nestedTuplesConflict'

	function registeredTupleLayoutNamed(name ByteArray) returns StructLayout
		return try self.registeredLayout(self.canonicalNameOfStruct(name)) otherwise panic("ProgramSignatures.registeredTupleLayoutNamed: tuple `{String.from(name)}` is not registered — `internTupleType` registers the layout before it hands the name back")
	end 'registeredTupleLayoutNamed'

	function instantiatesInnerAlias(identity ByteArray, template ByteArray) returns bool
		if not self.isInnerAlias(template) 'templateIsNoInnerAlias'
			return false
		end 'templateIsNoInnerAlias'

		return match splitQualifiedName(identity) 'split'
			notQualified gives false
			parts(prefix, member) gives (try self.perInstanceTemplateName(prefix, member: member, readerFilePath: CompilerOwnedDeclFilePath) otherwise return false).equals(template)
		end 'split'
	end 'instantiatesInnerAlias'

	// ⭐ **THE GENERIC-INSTANCE ALIAS AT `position` OF INSTANCE `id`, AS THE INSTANTIATION SPELLED IT** — the
	// brand an element read out of the instance wears, and the brand a value stored into that position must
	// carry. Read off the RAW argument, which keeps the author's spelling (`canonicalTypeArg` is what
	// resolves it to the instance it names); an argument spelled inline (`Array with (Array with Integer)`)
	// or by anything but a generic alias brands nothing.
	export function instanceArgBrand(id GenericInstanceId, position ElementIndex) returns immutable ByteArray
		let raw = self.substitutedInstanceArg(id, position: position)

		if maxonTypeTag(raw) != ValueTypeTag.named 'spelledInlineOrByAPrimitive'
			return EmptySourceText
		end 'spelledInlineOrByAPrimitive'

		return self.instanceBrandOfSpelling(self.nameOfId(typeNameIdOf(raw)))
	end 'instanceArgBrand'

	// ⭐ **HOW A BRAND IS QUOTED.** The author's spelling, unless that spelling is CONTESTED — two files
	// declaring one alias name over two instances — in which case the instance's own display name carries the
	// namespace or file that tells the two apart (`unambiguousAliasSpelling`), exactly as every other
	// diagnostic quotes a contested alias. A buffer view reads `__ManagedMemory with <element>`, and the mint
	// two declarations of ONE instance wear reads as its declaration's source spelling.
	export function brandDisplayName(brand ByteArray, gid GenericInstanceId) returns immutable ByteArray
		if not brandIsTheType(brand) 'noBrandNamesTheType'
			panic("ProgramSignatures.brandDisplayName: '{String.from(brand)}' names no type — a caller displays a brand only where brandIsTheType holds")
		end 'noBrandNamesTheType'

		if brand.equals(ManagedMemoryTypeName) or isBufferViewBrand(brand) 'aBufferView'
			if self.genericInstanceArgCount(gid) != 1 'notOneElement'
				panic("ProgramSignatures.brandDisplayName: '{String.from(brand)}' is a buffer view and its instance holds {self.genericInstanceArgCount(gid)} type arguments — a buffer view is `{String.from(ManagedMemoryTypeName)} with <element>`, so only a one-argument instance can wear it")
			end 'notOneElement'

			return freeze "{String.from(ManagedMemoryTypeName)} with {self.instanceArgShownName(gid)}".toByteArray()
		end 'aBufferView'

		if self.genericAliasMintIsABrand(brand) 'aMintOfOneInstanceTwoFilesDeclare'
			return freeze self.aliasIdentityDisplay(brand).toByteArray()
		end 'aMintOfOneInstanceTwoFilesDeclare'

		if self.genericAliasSpellingIsSuperseded(brand) 'twoFilesDeclareThisName'
			return self.instanceDisplayName(gid)
		end 'twoFilesDeclareThisName'

		return aliasBaseName(brand)
	end 'brandDisplayName'

	// The brand a spelled type argument or requirement parameter carries — the spelling itself when it is a
	// FILE-SCOPE generic alias, nothing for an instance mint, an inner alias (qualified in this registry — see
	// `Parser.brandOfSpelling` for why it brands nothing) or any other type.
	// ⚠ **A CONTESTED ALIAS IS NOT BRANDED, and that is not a gap.** Two files declaring one name over two
	// instances are split into DISTINCT gids (`fileScopedInstance`), so the gid tells them apart on its
	// own; a brand would only add a spelling whose display is a per-file question this file-less door cannot
	// answer (`unambiguousAliasSpelling` would path-qualify it). The instance display renders the value.
	// Two declarations over ONE instance share a gid, so there each declaration's mint brands instead
	// (`genericAliasMintIsABrand`).
	export function instanceBrandOfSpelling(spelling immutable ByteArray) returns immutable ByteArray
		if containsQualifier(spelling) or isCompilerReservedName(spelling) or self.genericAliasSpellingIsSuperseded(spelling) 'notAPlainBrand'
			return EmptySourceText
		end 'notAPlainBrand'

		return spelling if self.settledDeclarations().genericAliases.contains(spelling) else EmptySourceText
	end 'instanceBrandOfSpelling'

	export function sharedInstanceMintOr(spelling ByteArray, readerFilePath FilePath, fallback immutable ByteArray) returns immutable ByteArray
		if self.genericAliasClaimantsShareAnInstance(spelling) 'twoDeclarationsOfOneInstance'
			return self.genericAliasMintFor(spelling, readerFilePath: readerFilePath)
		end 'twoDeclarationsOfOneInstance'

		return fallback
	end 'sharedInstanceMintOr'

	export function genericAliasClaimantsShareAnInstance(name ByteArray) returns bool
		return self.settledDeclarations().sharedInstanceGenericAliases.contains(name)
	end 'genericAliasClaimantsShareAnInstance'

	function indexSharedInstanceGenericAliases()
		let shared = DisagreeingAliasNameSet.create()

		match self.mainThreadSettled().contestedGenericAliases 'index'
			unwritten then break
			entries(byName) then self.noteSharedInstanceAliases(byName, into: shared)
		end 'index'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.sharedInstanceGenericAliases = shared
	end 'indexSharedInstanceGenericAliases'

	function noteSharedInstanceAliases(byName ContestedGenericAliasMap, into DisagreeingAliasNameSet)
		for (name, byFile) in byName 'eachContestedName'
			let seen = GenericInstanceIdSet.create()

			for (_, instance) in byFile 'eachDeclaringFile'
				if seen.contains(instance) 'anEarlierFileDeclaresThisInstance'
					into.insert(name)
					break
				end 'anEarlierFileDeclaresThisInstance'

				seen.insert(instance)
			end 'eachDeclaringFile'
		end 'eachContestedName'
	end 'noteSharedInstanceAliases'

	export function genericAliasMintIsABrand(spelling ByteArray) returns bool
		return isMintName(spelling) and self.settledDeclarations().genericAliases.contains(spelling) and self.genericAliasClaimantsShareAnInstance(sourceSpelledAliasName(spelling))
	end 'genericAliasMintIsABrand'

	export function genericAliasMintDeclaringFiles(mint ByteArray) returns FilePathArray
		let files = FilePathArray.create(0)
		let mints = try self.settledDeclarations().genericAliasMints.get(sourceSpelledAliasName(mint)) otherwise return files

		for (declPath, held) in mints 'eachDeclaringFile'
			if held.equals(mint) 'thisMintsOwnDeclaration'
				files.push(try FilePath.from(declPath) otherwise panic("ProgramSignatures.genericAliasMintDeclaringFiles: '{declPath}' keys a generic alias's mint table and is not a path, and every key is spelled from the path of the file that declared it"))
			end 'thisMintsOwnDeclaration'
		end 'eachDeclaringFile'

		return files
	end 'genericAliasMintDeclaringFiles'

	function instanceArgShownName(gid GenericInstanceId) returns String
		let arg = self.substitutedInstanceArg(gid, position: ContainerElementArgPosition)

		if maxonTypeTag(arg) == ValueTypeTag.named 'aNamedElement'
			return self.aliasIdentityDisplay(self.nameOfId(typeNameIdOf(arg)))
		end 'aNamedElement'

		return String.from(self.displayedTypeArgName(arg, spelling: InstanceArgSpelling.asRange))
	end 'instanceArgShownName'

	export function contestedTypeNote(tag ValueTypeTag, nameId TypeNameId, brand ByteArray, identity ByteArray, shown String, otherShown String) returns String
		if tag != ValueTypeTag.genericInstance 'carriesNoInstance'
			return self.declaredInNote(identity, shown: shown, otherShown: otherShown)
		end 'carriesNoInstance'

		if self.genericAliasMintIsABrand(brand) 'aBrandOfOneInstanceTwoFilesDeclare'
			return self.declaredInNote(brand, shown: shown, otherShown: otherShown)
		end 'aBrandOfOneInstanceTwoFilesDeclare'

		if not shown.equals(otherShown) 'theDisplaysTellThemApart'
			return ""
		end 'theDisplaysTellThemApart'

		if isBufferViewBrand(brand) 'aViewOfAnAlias'
			return self.originNote(TypeOrigin.viewOf(String.from(self.brandDisplayName(brandBeneathBufferView(brand), gid: nameId as GenericInstanceId))))
		end 'aViewOfAnAlias'

		return self.originNote(TypeOrigin.declaredIn(self.genericInstanceDeclaringFiles(nameId as GenericInstanceId)))
	end 'contestedTypeNote'

	export function writtenAliasBase(written ByteArray) returns immutable ByteArray
		if isMintName(written) 'anIdentity'
			return aliasBaseName(written)
		end 'anIdentity'

		match splitQualifiedName(written) 'written'
			notQualified then return aliasBaseName(written)
			parts(_, member) then return aliasBaseName(member)
		end 'written'
	end 'writtenAliasBase'

	export function declaringFileOfWrittenAlias(written ByteArray, readerFilePath FilePath) returns WrittenAliasFile
		if isMintName(written) 'anIdentity'
			return self.declaringFileOfIdentity(written)
		end 'anIdentity'

		if containsQualifier(written) 'aDirectoryQualifiedName'
			return self.declaringFileOfQualifiedAlias(written, readerFilePath: readerFilePath)
		end 'aDirectoryQualifiedName'

		if self.bareNameMeansSeveral(written, readerFilePath: readerFilePath) 'thisFileCouldNotHaveWrittenItBare'
			return WrittenAliasFile.nothingMeant
		end 'thisFileCouldNotHaveWrittenItBare'

		return self.declaringFileOfIdentity(self.declaredIdentityOfSpelling(written, declFilePath: readerFilePath))
	end 'declaringFileOfWrittenAlias'

	export function declaringFileOfIdentity(name ByteArray) returns WrittenAliasFile
		if not isMintName(name) 'aBareNameHasNoDeclarationOfItsOwn'
			return WrittenAliasFile.unspecified
		end 'aBareNameHasNoDeclarationOfItsOwn'

		let files = self.identityDeclaringFiles(name)

		if files.count() != 1 'noOneDeclarationNamesIt'
			return WrittenAliasFile.unspecified
		end 'noOneDeclarationNamesIt'

		return WrittenAliasFile.declaredIn(try files.get(0) otherwise panic("ProgramSignatures.declaringFileOfIdentity: get(0) on a list whose count was just read as one"))
	end 'declaringFileOfIdentity'

	function declaringFileOfQualifiedAlias(qualified ByteArray, readerFilePath FilePath) returns WrittenAliasFile
		match lookupQualifiedType(self, written: qualified, readerFilePath: readerFilePath) 'declared'
			found(declaration) then return WrittenAliasFile.declaredIn(declaration.declFilePath) if declaration.isNameable() else WrittenAliasFile.unspecified
			ambiguous or
			missing then return WrittenAliasFile.unspecified
		end 'declared'
	end 'declaringFileOfQualifiedAlias'

	export function declaredInNote(identity ByteArray, shown String, otherShown String) returns String
		if not shown.equals(otherShown) 'theDisplaysTellThemApart'
			return ""
		end 'theDisplaysTellThemApart'

		return self.originNote(TypeOrigin.declaredIn(self.identityDeclaringFiles(identity)))
	end 'declaredInNote'

	export function originNote(origin TypeOrigin) returns String
		match origin 'origin'
			declaredIn(declFilePaths) then return " (declared in {self.declaringFileList(declFilePaths)})" if declFilePaths.count() > 0 else ""
			viewOf(shown) then return " (the view of '{shown}')"
		end 'origin'
	end 'originNote'

	function declaringFileList(declFilePaths FilePathArray) returns String
		let rendered = StringArray.create(0)

		for declFilePath in declFilePaths 'eachDeclaringFile'
			insertCandidateName(rendered, candidate: self.projectRelativeFileDisplay(declFilePath))
		end 'eachDeclaringFile'

		return joinedWith(rendered, separator: CandidateListSeparator)
	end 'declaringFileList'

	function identityDeclaringFiles(identity ByteArray) returns FilePathArray
		var files = FilePathArray.create(0)

		match self.settledDeclarations().typeAliases.declarationInAnyFile(identity) 'declaration'
			declared(alias) then files.push(alias.declFilePath)
			undeclared then files = self.unrangedMintDeclaringFiles(identity)
		end 'declaration'

		return files
	end 'identityDeclaringFiles'

	function unrangedMintDeclaringFiles(mint ByteArray) returns FilePathArray
		let generic = self.genericAliasMintDeclaringFiles(mint)

		if generic.count() > 0 'aGenericAliasMint'
			return generic
		end 'aGenericAliasMint'

		return self.settledDeclarations().functionTypeAliases.shapeScopedDeclaringFiles(mint)
	end 'unrangedMintDeclaringFiles'

	export function genericBrandOfWritten(spelled ByteArray, readerFilePath FilePath) returns immutable ByteArray
		let identity = self.declaredIdentityOfSpelling(spelled, declFilePath: readerFilePath)

		if not self.settledDeclarations().genericAliases.contains(identity) 'namesNoGenericAlias'
			return EmptySourceText
		end 'namesNoGenericAlias'

		if self.genericAliasMintIsABrand(identity) 'aMintOfOneInstanceTwoFilesDeclare'
			return identity
		end 'aMintOfOneInstanceTwoFilesDeclare'

		if isMintName(identity) 'aContestedAliasTheInstanceTellsApart'
			return EmptySourceText
		end 'aContestedAliasTheInstanceTellsApart'

		return self.instanceBrandOfSpelling(identity)
	end 'genericBrandOfWritten'

	function wantsKind(wanted WantedAliasKinds, kind TypeDeclKind) returns bool
		return match wanted 'wanted'
			ranged gives kind == TypeDeclKind.rangedAlias
			generic gives kind == TypeDeclKind.genericAlias
			tuple gives kind == TypeDeclKind.tupleAlias
			identityBearing gives kind == TypeDeclKind.rangedAlias or kind == TypeDeclKind.genericAlias or kind == TypeDeclKind.functionAlias
			everyAlias gives isTypeAliasDecl(kind)
		end 'wanted'
	end 'wantsKind'

	function wantedKindsOfForm(form FormAliasKind) returns WantedAliasKinds
		return match form 'form'
			generic gives WantedAliasKinds.generic
			tuple gives WantedAliasKinds.tuple
		end 'form'
	end 'wantedKindsOfForm'

	export function bareWrittenKey(spelling immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if readerFilePath.equals(CompilerOwnedDeclFilePath) 'aReaderThatHoldsNoFile'
			return spelling
		end 'aReaderThatHoldsNoFile'

		return self.writtenTypeNameIdentity(spelling, readerFilePath: readerFilePath)
	end 'bareWrittenKey'

	function writtenAlias(spelling ByteArray, readerFilePath FilePath, wanted WantedAliasKinds) returns WrittenAlias
		if containsQualifier(spelling) 'aDirectoryQualifiedName'
			match self.namespaceAliasOf(spelling, readerFilePath: readerFilePath, wanted: wanted) 'qualified'
				declared(declFilePath, member, kind) then return WrittenAlias.declared(self.aliasFamilyIdentity(member), readerFilePath: declFilePath, kind: kind)
				notAnAlias then break
			end 'qualified'
		end 'aDirectoryQualifiedName'

		return WrittenAlias.spelled(self.bareWrittenKey(spelling, readerFilePath: readerFilePath), readerFilePath: readerFilePath)
	end 'writtenAlias'

	function namespaceAliasOf(spelling ByteArray, readerFilePath FilePath, wanted WantedAliasKinds) returns NamespaceAlias
		if not containsQualifier(spelling) 'aBareName'
			return NamespaceAlias.notAnAlias
		end 'aBareName'

		if not self.allFilesFolded 'theSweepAnswersFromTokensAlone'
			return NamespaceAlias.notAnAlias
		end 'theSweepAnswersFromTokensAlone'

		match lookupQualifiedType(self, written: spelling, readerFilePath: readerFilePath) 'declaration'
			found(declaration) then return NamespaceAlias.declared(declaration.declFilePath, name: declaration.name, kind: declaration.kind) if declaration.isNameable() and self.wantsKind(wanted, kind: declaration.kind) else NamespaceAlias.notAnAlias
			ambiguous or
			missing then return NamespaceAlias.notAnAlias
		end 'declaration'
	end 'namespaceAliasOf'

	export function declaredIdentityOfSpelling(spelling immutable ByteArray, declFilePath FilePath) returns immutable ByteArray
		if spelling.isEmpty() or isMintName(spelling) 'alreadyAnIdentity'
			return spelling
		end 'alreadyAnIdentity'

		if not containsQualifier(spelling) 'aBareName'
			return self.declaredIdentityOfBareKey(self.bareWrittenKey(spelling, readerFilePath: declFilePath), declFilePath: declFilePath)
		end 'aBareName'

		match self.writtenAlias(spelling, readerFilePath: declFilePath, wanted: WantedAliasKinds.identityBearing) 'written'
			declared(key, namespaceFile, kind) then return self.declarationIdentityOf(key, kind: kind, declFilePath: namespaceFile)
			spelled(key, _) then return self.declaredIdentityOfBareKey(key, declFilePath: declFilePath)
		end 'written'
	end 'declaredIdentityOfSpelling'

	export function declarationIdentityOf(name ByteArray, kind TypeDeclKind, declFilePath FilePath) returns immutable ByteArray
		match kind 'kind'
			rangedAlias then return self.rangedIdentityOrKey(self.aliasFamilyIdentity(name), declFilePath: declFilePath)
			functionAlias then return self.functionAliasScopedName(self.aliasFamilyIdentity(name), readerFilePath: declFilePath)
			genericAlias then return self.genericAliasIdentityOf(self.aliasFamilyIdentity(name), declFilePath: declFilePath)
			tupleAlias or
			structType or
			enumType or
			unionType or
			interfaceType then panic("ProgramSignatures.declarationIdentityOf: '{String.from(name)}' is filed as a {kind.name} — `WantedAliasKinds.identityBearing` admits only a ranged, a function and a generic-instance alias, so every caller filtered the kind first")
		end 'kind'
	end 'declarationIdentityOf'

	function genericAliasIdentityOf(key immutable ByteArray, declFilePath FilePath) returns immutable ByteArray
		if self.genericAliasSpellingIsSuperseded(key) 'aContestedGenericAlias'
			return self.genericAliasMintFor(key, readerFilePath: declFilePath)
		end 'aContestedGenericAlias'

		return key
	end 'genericAliasIdentityOf'

	function rangedIdentityOrKey(key immutable ByteArray, declFilePath FilePath) returns immutable ByteArray
		if isMintName(key) or not self.keyMayTakeARangedIdentity(key) 'itsOwnNameIsItsIdentity'
			return key
		end 'itsOwnNameIsItsIdentity'

		let identity = self.rangedIdentityOfKey(key, readerFilePath: declFilePath)
		return key if identity.isEmpty() else identity
	end 'rangedIdentityOrKey'

	function keyMayTakeARangedIdentity(key ByteArray) returns bool
		return self.settledDeclarations().typeAliases.nameTakesAnIdentity(key) or self.crossKindContested(sourceSpelledAliasName(key))
	end 'keyMayTakeARangedIdentity'

	function declaredIdentityOfBareKey(key ByteArray, declFilePath FilePath) returns immutable ByteArray
		if self.genericAliasSpellingIsSuperseded(key) and self.readerMeansKind(key, readerFilePath: declFilePath, kind: TypeDeclKind.genericAlias) 'aContestedGenericAlias'
			return self.genericAliasMintFor(key, readerFilePath: declFilePath)
		end 'aContestedGenericAlias'

		if self.isFunctionAliasFor(key, readerFilePath: declFilePath) 'aFunctionAlias'
			return self.functionAliasScopedName(key, readerFilePath: declFilePath)
		end 'aFunctionAlias'

		return self.rangedIdentityOrKey(key, declFilePath: declFilePath)
	end 'declaredIdentityOfBareKey'

	// Do two function-type names carry different brands? — the function twin of `identitiesConflict`, asked
	// only once two SHAPES have agreed. A file-scope function typealias is its own type, so `Handler` never
	// stands where a `Callback` is declared; an anonymous shape — a closure literal's inferred type, a
	// declared function's own signature — carries no brand and fits any alias of its shape.
	//
	// The guard turns on membership of `nestedFunctionAliasMembers` and not on the spelling: a name the
	// nested minter wrote brands nothing in either direction. See that field, which owns the rule and why
	// the test is membership rather than a test for a dot.
	//
	// Two shape-scoped MINTS of one contested name conflict, which is the point: they are distinct keys,
	// so the equality below separates them and two files' same-named `function(…)` aliases no longer
	// satisfy each other's doors.
	export function functionBrandsConflict(declaredName ByteArray, gotName ByteArray) returns bool
		if self.settledDeclarations().nestedFunctionAliasMembers.contains(declaredName) or self.settledDeclarations().nestedFunctionAliasMembers.contains(gotName) 'notAPlainBrand'
			return false
		end 'notAPlainBrand'

		return not declaredName.equals(gotName) and self.settledDeclarations().functionTypeAliases.contains(declaredName) and self.settledDeclarations().functionTypeAliases.contains(gotName)
	end 'functionBrandsConflict'

	// ⭐ **IS A CONFLICT BETWEEN THESE TWO IDENTITIES ONE THAT `as` CONVERTS BY NAME ALONE?** — two scalars
	// each wearing a name (a ranged typealias, a per-instance alias), which is the whole of what a `return`
	// converts implicitly (`Parser.admitReturnedAggregate`). A struct, a boxed union or an instance mint
	// wears no such name, so a conflict with either side a record answers `false` and keeps its refusal.
	export function conflictIsBetweenNamedScalars(expected ByteArray, got ByteArray) returns bool
		return self.aliasIdentityDecays(expected) and self.aliasIdentityDecays(got)
	end 'conflictIsBetweenNamedScalars'

	// ⭐ Is `identity` a PAYLOAD-FREE enum — one whose value is a bare i64 tag rather than a heap box? Read
	// over `enumTypes` directly rather than through `enumOf`, which boxes a `DeclaredEnum`: this is asked at
	// every coercion site whose two identities disagree.
	function isPayloadFreeEnumIdentity(identity ByteArray) returns bool
		let layout = try self.settledDeclarations().enumTypes.get(identity) otherwise return false
		return not layout.carriesPayloads()
	end 'isPayloadFreeEnumIdentity'

	// ⭐⭐ **IS `identity` A SCALAR WEARING A NAME?** — a ranged typealias or a per-instance alias. Both are
	// integers whose only nominal content is the name, so both DECAY in either direction against a value
	// that carries no identity; the two boundary admits below are about RECORDS, which is why this question
	// is separate from them and asked first.
	//
	// ⚠ **THE STRANGER'S FILE** for the per-instance half — this authority is handed two NAMES and no
	// position, so a per-instance prefix two files declare over different bases has no reader to choose by.
	function aliasIdentityDecays(identity ByteArray) returns bool
		return self.isRangedAliasIdentity(identity) or self.isPerInstanceAlias(identity, readerFilePath: CompilerOwnedDeclFilePath)
	end 'aliasIdentityDecays'

	export function isPerInstanceAlias(name ByteArray, readerFilePath FilePath) returns bool
		return match self.perInstanceAliasOf(name, readerFilePath: readerFilePath) 'p'
			declared gives true
			undeclared gives false
		end 'p'
	end 'isPerInstanceAlias'

	// The inner alias a per-instance `name` resolves to (its RANGE + bare member), or `undeclared`. The one
	// door `isPerInstanceAlias` and the erasure both read, so "is it per-instance?" and "what does it erase
	// to?" answer from one place.
	export function perInstanceAliasOf(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		return match splitQualifiedName(name) 'split'
			notQualified gives DeclaredAlias.undeclared
			parts(prefix, member) gives self.perInstanceAliasFromParts(prefix, member: member, readerFilePath: readerFilePath)
		end 'split'
	end 'perInstanceAliasOf'

	// The inner alias a per-instance name's (prefix, member) resolves to — `undeclared` unless `prefix` is a
	// generic-instance alias whose base declares an inner alias `member`.
	// ⚠ **THE PREFIX IS RESOLVED AS `readerFilePath` MEANS IT, AND THE FILE-LESS FORM IS A COMPILER
	// PANIC.** The prefix is a generic-alias NAME, so for a name two files declare over different bases the
	// bare door refuses outright — from `aggregateNameIn` on a program writing `W.Idx` where two files
	// declare `W`, the compiler aborts. Every caller
	// that resolves a SOURCE spelling has a file; the two that structurally cannot pass
	// `CompilerOwnedDeclFilePath`, which resolves like a stranger — the same convention
	// `contestScopedDeclaredType` states for a layout no file declares.
	function perInstanceAliasFromParts(prefix ByteArray, member ByteArray, readerFilePath FilePath) returns DeclaredAlias
		return self.innerAliasOf(try self.perInstanceTemplateName(prefix, member: member, readerFilePath: readerFilePath) otherwise return DeclaredAlias.undeclared)
	end 'perInstanceAliasFromParts'

	function perInstanceTemplateName(prefix ByteArray, member ByteArray, readerFilePath FilePath) returns immutable ByteArray throws AbsentError
		if not self.isGenericAliasInAnyFile(prefix) or not self.readerMeansKind(prefix, readerFilePath: readerFilePath, kind: TypeDeclKind.genericAlias) 'notInstanceAlias'
			throw AbsentError.absent
		end 'notInstanceAlias'

		// ⭐ **`scopedGenericAliasInstance` AND NOT `genericAliasInstanceFrom`, AND THE DIFFERENCE IS BOTH HALVES
		// OF WHAT THIS SITE NEEDS.** The first picks WHICH DECLARATION the reader means — a pure map probe. The
		// second then re-scopes that instance's ARGUMENTS, which interns, and interning MUTATES: this door is
		// asked from `aggregateNameIn`, which holds the memoized index immutably and would be
		// refused (E3207). It is also work this site cannot use — an instance's BASE is invariant under
		// argument scoping, and the base is the whole of what a per-instance alias reads off the prefix.
		return joinQualifiedName(self.genericInstanceBaseName(self.scopedGenericAliasInstance(prefix, readerFilePath: readerFilePath)), member: member)
	end 'perInstanceTemplateName'

	// ⭐⭐ **THE AGGREGATE CONFLICT RULE — the ONE authority every coercion site shares**: the parser's five
	// symmetric ones (return, reassignment, `otherwise`, match arm, union-payload / struct-literal store) and
	// SemanticCheck's (a call argument, a generic call's type-parameter argument, and that argument where
	// the receiver has bound nothing), so they cannot come to disagree about
	// when a value may cross.
	//
	// It answers THREE questions in the order a coercion asks them, and each has its own measured wrong
	// answer below: do the two NOMINAL IDENTITIES agree, decay included (`identitiesConflict`); is the value
	// a payload-free enum's raw tag reaching an alias slot; and — when the two identities genuinely differ —
	// is this the one pair of DIFFERENT names that denotes ONE record (`byteBufferBoundaryAdmits`)?
	//
	// ⭐ **`expected` IS THE SIDE WHOSE DECLARATION DECIDES**, which is not always a `declare`d type: the
	// binding's declared type, the function's declared return, the parameter, the instance's type argument —
	// and, at the two symmetric merges, the value the phi ADOPTS (the try's result, the first arm). The byte
	// boundary is one-way for that reason and no other; see `byteBufferBoundaryAdmits`.
	//
	// ⚠ **THE (tag, nameId) PAIRS RIDE BESIDE THE NAMES RATHER THAN REPLACING THEM.** The name is spelled
	// against the asker's interner (`aggregateNameIn`, `typeArgAggregateName`), so this index cannot
	// re-derive it — but the pair it needs is interner-independent, since a `genericInstance` carries a
	// whole-program `GenericInstanceId` in every interner.
	//
	// ⭐⭐ **A SCALAR WEARING A NAME DECAYS IN BOTH DIRECTIONS, AND THAT IS THE WHOLE OF THE DECAY RULE.** A
	// ranged typealias and a per-instance `Idx` are integers whose only nominal content is the name, so a
	// value carrying NO identity fits either slot and a value carrying one fits an unnamed slot; only two
	// DIFFERENT names conflict. `identitiesConflict` holds that rule, because a function SHAPE's per-position
	// identities are the same kind of answer and must decay the same way.
	//
	// ⚠ **THERE IS NOTHING FOR EITHER TO DECAY INTO WHEN THE OTHER SIDE IS A RECORD** — a struct, a boxed
	// union/enum, a generic instance — so against a named AGGREGATE the conflict stands. `aliasIdentityDecays`
	// is what separates the two groups, and deciding it from the names alone needs no premise held elsewhere.
	//
	// ⛔ **AN `Idx` — AN INT — MUST NOT DECAY INTO A NAMED AGGREGATE, AND THE TAG CHECK AHEAD OF THIS DOOR
	// DOES NOT CATCH IT.** `SemanticCheck.checkTypeParameterArgsAt` compares against `substitutedInstanceArg`,
	// which returns the type argument AS INTERNED — a struct spelled by name is a `named` LEAF, never
	// `structRef` — so its tag check is `checkDeclaredType(named, named)`, which AGREES; only the identity
	// rule stands between an `Idx` and a `Box with Leaf`'s `T` field, where it would be freed as a `Leaf`.
	export function aggregatesConflict(expected ByteArray, expectedTag ValueTypeTag, expectedNameId TypeNameId, expectedBrand ByteArray, got ByteArray, gotTag ValueTypeTag, gotNameId TypeNameId, gotBrand immutable ByteArray, readerFilePath FilePath) returns bool
		// `not self.isPerInstanceAlias(expected)` is not spelled: an EMPTY name can never be one
		// (`splitQualifiedName` answers `notQualified`), and a redundant clause is a fact stated twice.
		// ⚠ **THE STRANGER'S FILE** — this authority is asked from nine coercion sites, five of them in
		// the parser and four in SemanticCheck, and it is handed two NAMES and their tags rather than a
		// position. A per-instance prefix two files declare over different BASES therefore has no reader
		// here to choose by, and `CompilerOwnedDeclFilePath` is this file's one spelling of that: resolve
		// as a file declaring none of it would. It decides a BOOL — whether `got` carries a nominal
		// identity that decays — and both declarations answer it alike unless their bases differ AND only
		// one declares the member.
		let gotIsAnOperandSet = isOperandAliasSetBrand(gotBrand)

		if not self.identitiesConflict(expected, got: got, readerFilePath: readerFilePath) 'theTwoIdentitiesAgree'
			return brandsConflict(expectedBrand, got: EmptySourceText if gotIsAnOperandSet else gotBrand)
		end 'theTwoIdentitiesAgree'

		if gotIsAnOperandSet and self.operandAliasSetFits(gotBrand, slot: expected, readerFilePath: readerFilePath) 'anOperandOfTheExpressionSatisfiesIt'
			return false
		end 'anOperandOfTheExpressionSatisfiesIt'

		// ⭐ **A PAYLOAD-FREE `enum`'s VALUE *IS* ITS RAW i64 TAG**, so it decays into an alias slot exactly as
		// an unnamed integer does. ONE-WAY, and deliberately: an integer standing where an `enum` is declared
		// would be a case index nothing produced, so a bare `Narrow` at a `Level` place stays refused — and two
		// different enums stay refused whichever way they meet. It is a VALUE coercion rule, which is why it
		// lives here and not in the name-only `identitiesConflict` two function-SHAPES also compare through.
		if self.aliasIdentityDecays(expected) and self.isPayloadFreeEnumIdentity(got) 'anEnumsRawValueIntoAnAliasSlot'
			return false
		end 'anEnumsRawValueIntoAnAliasSlot'

		// Asked only once the names have already disagreed, so every value that crosses every coercion site
		// in a compiling program pays nothing for it. TWO boundaries answer here, and they are disjoint by
		// construction — one is about a 1-byte record and the other about a machine-word one — so the order
		// between them decides nothing; they are two arms of the single question *"do these two differently
		// named instances denote one record?"*, asked where all nine coercion sites already ask it.
		if self.byteBufferBoundaryAdmits(expectedTag, declaredNameId: expectedNameId, gotTag: gotTag, gotNameId: gotNameId) 'oneByteRecord'
			return false
		end 'oneByteRecord'

		if self.sizedFixedArrayWidens(expectedTag, declaredNameId: expectedNameId, gotTag: gotTag, gotNameId: gotNameId) 'aSizedFixedArrayAtARuntimeSizedOne'
			return false
		end 'aSizedFixedArrayAtARuntimeSizedOne'

		return not self.inferredIntColumnBoundaryAdmits(expectedTag, declaredNameId: expectedNameId, gotTag: gotTag, gotNameId: gotNameId)
	end 'aggregatesConflict'

	// Both sides must be integer-range types: only then is an `as` cast between them the author's fix, so
	// only then does a refusal earn the cast hint.
	export function crossesIntegerRange(expectedTag ValueTypeTag, expected ByteArray, gotTag ValueTypeTag, got ByteArray) returns bool
		return self.wearsAnIntegerRange(expectedTag, identity: expected) and self.wearsAnIntegerRange(gotTag, identity: got)
	end 'crossesIntegerRange'

	// `isRangedAliasIdentity` is asked before the alias table: a bare name a struct and an alias both hold is
	// the struct's identity, and a table lookup by that name would hand the struct the alias's hint.
	function wearsAnIntegerRange(tag ValueTypeTag, identity ByteArray) returns bool
		if tag == ValueTypeTag.exitCode 'theBuiltinExitCode'
			return true
		end 'theBuiltinExitCode'

		if not self.isRangedAliasIdentity(identity) 'notARangedAlias'
			return false
		end 'notARangedAlias'

		match self.settledDeclarations().typeAliases.declarationInAnyFile(identity) 'declaration'
			declared(alias) then return maxonTypeTag(alias.underlying) == ValueTypeTag.integer
			undeclared then return false
		end 'declaration'
	end 'wearsAnIntegerRange'

	// The underlying primitive of a qualified alias (base-template OR per-instance) — TypeResolution's
	// erasure door: both collapse to their `int`/`float` underlying before lowering, exactly as a plain
	// ranged alias does; only the per-instance one ALSO carries nominal identity (kept in the value column).
	export function qualifiedAliasOf(name ByteArray, readerFilePath FilePath) returns DeclaredAlias
		let inner = self.innerAliasOf(name)

		match inner 'inner'
			declared then return inner
			undeclared then break
		end 'inner'

		return self.perInstanceAliasOf(name, readerFilePath: readerFilePath)
	end 'qualifiedAliasOf'

	// Does ANY method in the whole program declare a bare inner-alias parameter? The
	// allocation-free bool gate the per-instance argument check reads BEFORE `methodInnerAliasParamsOf` —
	// which mints an `InnerAliasParamLookup` union — a heap box — on every call. When this
	// answers false — every generics-free program, and any program with no per-instance method parameter —
	// no callee could ever be found, so the check returns without the per-call box. Mirrors the parser's
	// own `enclosingInnerAliases.count() != 0` gate and `aggregateNameIn`'s `containsQualifier` gate.
	export function hasInnerAliasParams() returns bool
		return self.settledDeclarations().methodInnerAliasParams.count() != 0
	end 'hasInnerAliasParams'

	// The inner-alias parameter info of `methodName` (`Wrapper.setTag`), or `noInnerAliasParams` when the
	// method declares no bare-inner-alias parameter — the common case, which costs no map entry. THE door the
	// parser's per-instance argument check asks through at a concrete call site.
	export function methodInnerAliasParamsOf(methodName ByteArray) returns InnerAliasParamLookup
		let info = try self.settledDeclarations().methodInnerAliasParams.get(methodName) otherwise return InnerAliasParamLookup.noInnerAliasParams
		return InnerAliasParamLookup.found(info)
	end 'methodInnerAliasParamsOf'

	// ⭐ **IS `name` A FUNCTION TYPEALIAS, AND WHAT DOES IT RETURN?**. THE door
	// `Parser.parseTypeReference` re-tags a `named` reference `MaxonType.function` through, and the one an
	// indirect call recovers the callee's return type from. `undeclared` is the common answer (most names
	// are not function aliases), spelled as a union arm rather than a sentinel for `DeclaredAlias`'s reason.
	// It carries no interner ids (the return type is a tag + a name ByteArray), so it needs no `into`.
	export function functionAliasInAnyFile(name ByteArray) returns DeclaredFunctionAlias
		return self.settledDeclarations().functionTypeAliases.declarationInAnyFile(name)
	end 'functionAliasInAnyFile'

	// The same alias as `readerFilePath` means it — the registry's own-file → library → any-author cascade,
	// which a reader holding a file must ask through rather than taking whichever declaration was recorded
	// last.
	function functionAliasFrom(name ByteArray, readerFilePath FilePath) returns DeclaredFunctionAlias
		return self.settledDeclarations().functionTypeAliases.lookup(name, readerFilePath: readerFilePath)
	end 'functionAliasFrom'

	// Is `name` a declared FUNCTION typealias — the `bool` half of `functionAliasInAnyFile`, and a
	// HOT-PATH allocation guard, exactly like `containsStruct`/`containsEnum` are for their `*Of`
	// twins. Asked of EVERY `named` type REFERENCE (`parseTypeReference`), field READ (`fieldTypeOf`)
	// and call RESULT (`resolveNamedAlias`) — most of them ranged int aliases, none of them function
	// aliases — so it must not pay `functionAliasInAnyFile`'s `DeclaredFunctionAlias` box (a Maxon
	// union value is a heap object EVERY case, `undeclared` included) just to throw it away. A
	// `Map.contains` allocates nothing. Only a reader that needs the alias itself calls
	// `functionAliasInAnyFile`.
	export function isFunctionAliasInAnyFile(name ByteArray) returns bool
		return self.settledDeclarations().functionTypeAliases.contains(name)
	end 'isFunctionAliasInAnyFile'

	// The files a diagnostic names to tell two claimants of one alias spelling apart. `contestedTypeNote`
	// asks only when the two displays read alike, so a name its qualifier already separates gets no second,
	// contradictory qualifier.
	export function genericInstanceDeclaringFiles(id GenericInstanceId) returns FilePathArray
		let files = FilePathArray.create(0)

		let declared = self.settledDeclarations().genericAliasDecls

		for entry in declared 'eachDeclaration'
			if not self.genericAliasSpellingIsSuperseded(entry.aliasName) 'theNameIsNotContested'
				continue
			end 'theNameIsNotContested'

			if self.fileScopedInstance(entry.internedInstance(), filePath: entry.filePath) == id 'thisDeclarationNamesThisInstance'
				files.push(entry.filePath)
			end 'thisDeclarationNamesThisInstance'
		end 'eachDeclaration'

		return files
	end 'genericInstanceDeclaringFiles'

	export function functionValueArmDeclaringFiles(name ByteArray) returns FilePathArray
		let mints = self.settledDeclarations().functionTypeAliases.shapeScopedDeclaringFiles(name)

		if mints.count() > 0 'aContestedFunctionAliasMint'
			return mints
		end 'aContestedFunctionAliasMint'

		let files = FilePathArray.create(0)

		if self.settledDeclarations().funcReturnDeclFiles.contains(name) 'aDeclaredFunctionOrClosure'
			files.push(self.recordedReturnDeclFileOf(name))
		end 'aDeclaredFunctionOrClosure'

		return files
	end 'functionValueArmDeclaringFiles'

	export function instanceViewAliasName(alias FunctionTypeAlias, gid GenericInstanceId) returns immutable ByteArray
		return instanceQualifiedAliasName(self.viewedAliasName(alias), canonicalInstance: self.canonicalInstanceName(gid))
	end 'instanceViewAliasName'

	// A program alias whose bare name a library declaration also holds is viewed under a minted name, so
	// the two declarations' views of one instance stay separate entries rather than sharing one.
	function viewedAliasName(alias FunctionTypeAlias) returns immutable ByteArray
		if self.declaredByTheCorpus(alias.declFilePath) or not self.settledDeclarations().functionTypeAliases.sharesItsNameWithACorpusDeclaration(alias.name) 'nothingToTellApart'
			return alias.name
		end 'nothingToTellApart'

		return qualifiedMintName(alias.name, qualifier: AuthorExtensionMemberQualifier)
	end 'viewedAliasName'

	export function functionAliasScopedName(name ByteArray, readerFilePath FilePath) returns immutable ByteArray
		return self.settledDeclarations().functionTypeAliases.shapeScopedName(name, readerFilePath: readerFilePath)
	end 'functionAliasScopedName'

	// ⭐⭐ **THE SECOND FIXPOINT IN THIS INDEX, BESIDE `settleGenericAliasContest`, AND FOR THE SAME REASON:
	// A CONTESTED SPELLING IN A SLOT CONTESTS ITS CONTAINER.** `typealias Step = function(Item)` keys off
	// what `Item` means, so a round that refines `Item`'s key moves `Step`'s.
	//
	// ⚠ The rounds are JACOBI — every key is read out of `keys` and written into `next` — so no row can see
	// a sibling refined earlier in the same round. That is what makes the result independent of map
	// iteration order, and the mint hex, the mangled symbols built from it and every rendered Target
	// IR that prints one stable across hosts.
	//
	// The bound is one round per name plus one: an acyclic chain of contested slots is at most that deep, so
	// reaching it with the keys still moving means a cycle, which has no settled key and cannot be minted
	// from.
	function settleContestsOfLateFunctionAliases(lateAliases FunctionTypeAliasArray)
		let contested = self.mainThreadSettled().functionTypeAliases.shapeContestNames(self.crossKindScopedAliasNames())

		for alias in lateAliases 'eachLateAlias'
			if contested.contains(alias.name) 'aContestedName'
				self.settleFunctionAliasShapeContests()
				return
			end 'aContestedName'
		end 'eachLateAlias'
	end 'settleContestsOfLateFunctionAliases'

	export function settleFunctionAliasShapeContests()
		let names = self.mainThreadSettled().functionTypeAliases.shapeContestNames(self.crossKindScopedAliasNames())

		if names.count() == 0 'noNameIsDeclaredTwice'
			return
		end 'noNameIsDeclaredTwice'

		let declaredInstances = DeclaredGenericAliasInstanceMap.create()

		for entry in self.mainThreadSettled().genericAliasDecls 'eachGenericAliasDeclaration'
			declaredInstances.upsert(functionAliasShapeKeyOf(entry.aliasName, declPath: entry.filePath.toString()), value: entry.internedInstance())
		end 'eachGenericAliasDeclaration'

		var keys = FunctionAliasShapeKeyMap.create()
		var moved = false

		for _ in 0 upto names.count() + 1 'eachRound'
			let next = FunctionAliasShapeKeyMap.create()
			moved = false

			for name in names 'eachName'
				for (declPath, alias) in self.mainThreadSettled().functionTypeAliases.declarationsOf(name) 'eachDeclaringFile'
					let rowKey = functionAliasShapeKeyOf(name, declPath: declPath)
					let key = self.functionAliasShapeKey(alias, known: keys, declaredInstances: declaredInstances)

					if not keys.contains(rowKey) or key != (try keys.get(rowKey) otherwise panic("settleFunctionAliasShapeContests: '{rowKey}' is in the previous round's table and its read failed")) 'thisRoundRefinedIt'
						moved = true
					end 'thisRoundRefinedIt'

					next.upsert(rowKey, value: key)
				end 'eachDeclaringFile'
			end 'eachName'

			keys = next

			if not moved 'theRoundChangedNothing'
				break
			end 'theRoundChangedNothing'
		end 'eachRound'

		if moved 'theRoundsRanOutWithTheKeysStillMoving'
			panic("ProgramSignatures.settleFunctionAliasShapeContests: {names.count()} multiply-declared function alias name(s) did not reach a fixpoint in {names.count() + 1} rounds — a slot cycle among contested names (`A = function(B)` beside `B = function(A)`, each declared twice) has no settled key, and minting from a moving table would give two files one shape")
		end 'theRoundsRanOutWithTheKeysStillMoving'

		self.mainThreadSettled().functionTypeAliases.settleShapeContests(keys, names: names)
	end 'settleFunctionAliasShapeContests'

	// Every slot is asked what its spelling means IN THE DECLARING FILE, which is what makes the key a fact
	// about the declaration rather than about whoever reads it.
	function functionAliasShapeKey(alias FunctionTypeAlias, known FunctionAliasShapeKeyMap, declaredInstances DeclaredGenericAliasInstanceMap) returns HashDigest
		let open = GenericInstanceIdArray.create(0)
		var digest = self.mixFunctionAliasSlot(Hasher.empty(), tag: alias.returnTag, typeName: alias.returnTypeName, declFilePath: alias.declFilePath, known: known, open: open, declaredInstances: declaredInstances)

		for param in alias.paramTypes 'eachParam'
			digest = self.mixFunctionAliasSlot(digest, tag: param.tag, typeName: param.typeName, declFilePath: alias.declFilePath, known: known, open: open, declaredInstances: declaredInstances)
		end 'eachParam'

		return digest
	end 'functionAliasShapeKey'

	function mixGenericInstanceSlot(state HashDigest, id GenericInstanceId, declFilePath FilePath, known FunctionAliasShapeKeyMap, open GenericInstanceIdArray, declaredInstances DeclaredGenericAliasInstanceMap) returns HashDigest
		for held in open 'eachOpenInstance'
			if held == id 'aCycleAmongTheDeclarations'
				return Hasher.combined(state, value: CyclicGenericSlotMark)
			end 'aCycleAmongTheDeclarations'
		end 'eachOpenInstance'

		open.push(id)
		var digest = mixBytes(state, bytes: self.genericInstanceBaseName(id))

		for arg in self.rowArgs(id) 'eachArgument'
			let tag = maxonTypeTag(arg)

			digest = self.mixGenericInstanceSlot(digest, id: genericInstanceIdOf(arg), declFilePath: declFilePath, known: known, open: open, declaredInstances: declaredInstances) if tag == ValueTypeTag.genericInstance else self.mixFunctionAliasSlot(digest, tag: tag, typeName: self.instanceArgSpelling(arg), declFilePath: declFilePath, known: known, open: open, declaredInstances: declaredInstances)
		end 'eachArgument'

		_ = try open.pop() otherwise panic("ProgramSignatures.mixGenericInstanceSlot: open.pop on a list this call pushed to")

		return digest
	end 'mixGenericInstanceSlot'

	function declaredGenericAliasInstance(name ByteArray, declFilePath FilePath, declaredInstances DeclaredGenericAliasInstanceMap) returns GenericInstanceId
		return try declaredInstances.get(functionAliasShapeKeyOf(name, declPath: declFilePath.toString())) otherwise self.bareGenericAliasInstance(name)
	end 'declaredGenericAliasInstance'

	function instanceArgSpelling(arg MaxonType) returns immutable ByteArray
		let tag = maxonTypeTag(arg)

		if tag == ValueTypeTag.named or tag == ValueTypeTag.structRef or tag == ValueTypeTag.function or tag == ValueTypeTag.interfaceRef 'namesAType'
			return self.nameOfId(typeNameIdOf(arg))
		end 'namesAType'

		return EmptySourceText
	end 'instanceArgSpelling'

	function mixFunctionAliasShapeKey(spelled HashDigest, typeName ByteArray, declFilePath FilePath, known FunctionAliasShapeKeyMap) returns HashDigest
		match self.settledDeclarations().functionTypeAliases.lookup(typeName, readerFilePath: declFilePath) 'aFunctionAliasSlot'
			declared(slot) then return Hasher.combined(spelled, value: try known.get(functionAliasShapeKeyOf(typeName, declPath: slot.declFilePath.toString())) otherwise Hasher.empty())
			undeclared then return spelled
		end 'aFunctionAliasSlot'
	end 'mixFunctionAliasShapeKey'

	// ⛔ **A GENERIC-INSTANCE SLOT MIXES ITS BASE NAME AND ARGS, NEVER ITS gid.** A gid is an allocation
	// index into `genericInstances`, and `rekeyScopedGenericAliases` re-keys instances AFTER this settle —
	// so a key built on one would depend on intern order and then change under the mints it produced, and
	// those mints reach minted type names, rdata and symbol spellings.
	//
	// The tuple arm mixes the target NAME because the kind ordinal the fallback reaches for is one constant
	// for every tuple. Two tuple targets differing only in a nested ranged alias are deliberately not split:
	// canonicalisation erases that difference, so they are one struct.
	function mixFunctionAliasSlot(state HashDigest, tag ValueTypeTag, typeName ByteArray, declFilePath FilePath, known FunctionAliasShapeKeyMap, open GenericInstanceIdArray, declaredInstances DeclaredGenericAliasInstanceMap) returns HashDigest
		let spelled = mixBytes(Hasher.combined(state, value: tag.ordinal as HashDigest), bytes: self.declaredIdentityOfSpelling(typeName, declFilePath: declFilePath))

		if typeName.isEmpty() 'aPrimitiveSlotCarriesNoName'
			return spelled
		end 'aPrimitiveSlotCarriesNoName'

		if self.isFunctionAliasFor(typeName, readerFilePath: declFilePath) 'aFunctionAliasSlot'
			return self.mixFunctionAliasShapeKey(spelled, typeName: typeName, declFilePath: declFilePath, known: known)
		end 'aFunctionAliasSlot'

		if self.isAliasOfFormFor(typeName, readerFilePath: declFilePath, wanted: FormAliasKind.generic) 'aGenericInstanceAliasSlot'
			return self.mixGenericInstanceSlot(spelled, id: self.declaredGenericAliasInstance(typeName, declFilePath: declFilePath, declaredInstances: declaredInstances), declFilePath: declFilePath, known: known, open: open, declaredInstances: declaredInstances)
		end 'aGenericInstanceAliasSlot'

		if self.readerMeansKind(typeName, readerFilePath: declFilePath, kind: TypeDeclKind.rangedAlias) 'mayBeARangedAliasSlot'
			match self.settledDeclarations().typeAliases.lookup(typeName, readerFilePath: declFilePath) 'aRangedAliasSlot'
				declared(ranged) then return Hasher.combined(Hasher.combined(spelled, value: ranged.low as HashDigest), value: ranged.high as HashDigest)
				undeclared then break
			end 'aRangedAliasSlot'
		end 'mayBeARangedAliasSlot'

		if self.isAliasOfFormFor(typeName, readerFilePath: declFilePath, wanted: FormAliasKind.tuple) 'aTupleAliasSlot'
			return mixBytes(spelled, bytes: self.tupleAliasTargetFrom(typeName, readerFilePath: declFilePath))
		end 'aTupleAliasSlot'

		let form = try self.declaredFormOf(typeName, readerFilePath: declFilePath) otherwise return spelled
		return Hasher.combined(spelled, value: form.ordinal as HashDigest)
	end 'mixFunctionAliasSlot'

	// ⭐ **A FUNCTION TYPEALIAS SUBSTITUTED IN AS A TYPE ARGUMENT IS A `function` PLACE, AND IT ARRIVES AS A
	// `named` LEAF.** `substitutedInstanceArg` answers the argument AS INTERNED, and a function alias
	// is not in the type registries `denotedNamedType` walks — it lives in `functionTypeAliases` — so
	// `Map with (String, UnaryOp)`'s value argument reads `named`, whose tag prints "int". Handed to the
	// scalar coercion rule unresolved, `m.upsert("d", value: double)` was refused *"cannot pass a value of
	// type 'function' … which holds 'int'"* on a program `specs/map.md:function-valued.dispatch` requires
	// to run.
	//
	// It is the same resolution `SemanticCheck.witnessFormalDeclaredType` makes for an interface
	// requirement's formal, for the same reason and with the same answer — `MaxonType.function(id)`, the
	// type a declared parameter of that alias carries — so a function alias means one thing at both doors.
	export function functionAliasResolved(t MaxonType) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notANamedLeaf'
			return t
		end 'notANamedLeaf'

		if not self.isFunctionAliasInAnyFile(self.nameOfId(typeNameIdOf(t))) 'notAFunctionAlias'
			return t
		end 'notAFunctionAlias'

		return MaxonType.function(typeNameIdOf(t))
	end 'functionAliasResolved'

	// ⭐ **A RANGED FLOAT ALIAS SUBSTITUTED IN AS A TYPE ARGUMENT IS A `float` PLACE, AND IT ARRIVES AS A
	// `named` LEAF** — `functionAliasResolved`'s twin one line up, for the identical reason and reached
	// through the identical chain. `substitutedInstanceArg` answers the argument AS INTERNED, and `named`
	// reads as an INTEGER everywhere (`tagIsIntegral`, whose own header says why it cannot do otherwise), so
	// `Array with Real`'s element read `int`. Handed to the scalar coercion rule unresolved,
	// `a.growFilled(4, value: 2.5)` was refused **E3009 *"cannot implicitly convert 'float' to 'int'"*** —
	// a lossy-narrowing diagnostic about a program in which nothing narrows — while the BARE spelling of the
	// same element (`[1.5, 2.5]`, whose instance argument IS `float`) passed the check.
	//
	// ⚠ **AN INT ALIAS IS DELIBERATELY LEFT ALONE.** Erasing it to its underlying primitive would drop
	// its NAME, and the name is what carries the range the argument check reads
	// (`checkArgAgainstDeclaredTag` is handed the substituted type for exactly that). A FLOAT alias is the one `named` type whose VALUE lives in a different register file — see
	// `isFloatAliasFor` — so it is the one that may not stay overloaded.
	export function floatAliasResolved(t MaxonType, readerFilePath FilePath) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notANamedLeaf'
			return t
		end 'notANamedLeaf'

		return MaxonType.float if self.isFloatAliasFor(self.nameOfId(typeNameIdOf(t)), readerFilePath: readerFilePath) else t
	end 'floatAliasResolved'

	// The struct type `name` denotes, declared in ANY file — `aliasOf`'s twin, and the door the
	// PARSER asks every struct question through: is this name a `type`? how big is its box? which
	// slot is `x`?
	//
	// ⚠ **THE LAYOUT IT HANDS BACK CARRIES THIS INDEX'S IDS, so a caller may read its NAMES, its
	// COUNT and its OFFSETS but never its field TYPES.** Those are `MaxonType`s minted against
	// `self.typeNames`, which is private and stays private (the header's ID PROBLEM). `fieldTypeOf`
	// is the one door a field's type comes out of, and it re-interns on the way. The split is not
	// a nicety: `indexOfField`/`offsetOfField`/`sizeBytes` are pure arithmetic over the name column
	// and need no interner at all, so making every caller adopt a whole layout to ask "which slot?"
	// would allocate a copy per field access to answer a question about integers.
	// ⭐⭐ **WHAT A FOLDABLE FACTORY BUILDS AND THE PARAMETERS ITS FIELDS ARE NAMED AFTER — the two facts a
	// call has to be rewritten into the construction it stands for, settled together because the
	// MAPPING between them is the whole of the fold.** The layout is the callee's declared RETURN type
	// resolved to a declared `type`; the names are its own source-aligned parameter list.
	export function constFactoryConstructionOf(decl SweptDeclaration) returns ConstFactoryConstruction
		match self.declaredFactoryStruct(decl.returnType) 'declared'
			declared(layout) then return ConstFactoryConstruction.folds(layout, paramNames: decl.paramNames)
			undeclared then return ConstFactoryConstruction.unfoldable
		end 'declared'
	end 'constFactoryConstructionOf'

	function constFactoryConstructionAt(key ByteArray) returns ConstFactoryConstruction
		let decl = try self.sweptDeclarationOf(key) otherwise return ConstFactoryConstruction.unfoldable
		return self.constFactoryConstructionOf(decl)
	end 'constFactoryConstructionAt'

	// The declared `type` a factory's return type names, or `undeclared` for anything else. `structRef` is
	// the only tag that can answer: `RecordedReturnTypeRule.declaredStruct` has already rewritten every
	// `returns Self` into one, so a return type still spelling a bare `named` is a type this index cannot
	// resolve and not a struct it can lay out.
	function declaredFactoryStruct(declared MaxonReturnType) returns DeclaredStruct
		return match declared 'returns'
			void gives DeclaredStruct.undeclared
			value(valueType) gives self.declaredStructOfValueType(valueType)
		end 'returns'
	end 'declaredFactoryStruct'

	function declaredStructOfValueType(valueType MaxonType) returns DeclaredStruct
		if maxonTypeTag(valueType) != ValueTypeTag.structRef 'notADeclaredStruct'
			return DeclaredStruct.undeclared
		end 'notADeclaredStruct'

		let name = try self.typeNames.nameOf(typeNameIdOf(valueType)) otherwise return DeclaredStruct.undeclared
		return self.structInAnyFile(name)
	end 'declaredStructOfValueType'

	export function structInAnyFile(name ByteArray) returns DeclaredStruct
		let layout = try self.registeredLayout(name) otherwise return DeclaredStruct.undeclared
		return DeclaredStruct.declared(layout)
	end 'structInAnyFile'

	export function typeNameIsDeclared(name ByteArray) returns bool
		if self.isCanonicalInstanceName(name) or self.hasRegisteredLayout(name) 'aRenderedOrLaidOutType'
			return true
		end 'aRenderedOrLaidOutType'

		let form = try self.declaredFormPastStructTypes(name) otherwise return false
		return form != TypeDeclKind.structType
	end 'typeNameIsDeclared'

	export function slotDeclaredTypes(recordName ByteArray, offset ByteOffset, into TypeNameInterner) returns MaxonTypeArray throws AbsentError
		if let enumLayout = try self.settledDeclarations().enumTypes.get(recordName) 'aDeclaredUnion'
			return try self.payloadSlotTypesAt(enumLayout, offset: offset, into: into)
		end 'aDeclaredUnion'

		let layout = try self.registeredLayout(recordName) otherwise throw AbsentError.absent

		if layout.packsInlineIntoAWord or layout.fieldCount() == 0 'noSlotToName'
			throw AbsentError.absent
		end 'noSlotToName'

		var occupant = 0 as FieldIndex

		for index in 0 upto layout.fieldCount() 'eachField'
			if layout.offsetOfField(index) > offset 'pastTheSlot'
				break
			end 'pastTheSlot'

			occupant = index
		end 'eachField'

		let types = MaxonTypeArray.create(1, zeroed: false)
		types.push(self.fieldTypeOf(layout, index: occupant, into: into))
		return types
	end 'slotDeclaredTypes'

	function payloadSlotTypesAt(layout EnumLayout, offset ByteOffset, into TypeNameInterner) returns MaxonTypeArray throws AbsentError
		let types = MaxonTypeArray.create(0)

		if offset == 0 'theTagWord'
			return types
		end 'theTagWord'

		var matched = false

		for caseIndex in 0 upto layout.caseCount() 'eachCase'
			let payloads = layout.payloadsAt(caseIndex)

			for slot in 0 upto payloads.count() 'eachPayload'
				if layout.payloadSlotOffset(slot as PayloadSlotIndex) != offset 'anotherSlot'
					continue
				end 'anotherSlot'

				types.push(self.payloadTypeOf(try payloads.get(slot) otherwise panic("payloadSlotTypesAt: payloads.get OOB at {slot} below the case's own count"), layout: layout, into: into))
				matched = true
			end 'eachPayload'
		end 'eachCase'

		if not matched 'noSuchSlot'
			throw AbsentError.absent
		end 'noSuchSlot'

		return types
	end 'payloadSlotTypesAt'

	// ⚠ Built once from `clauseConformanceIndex`, so `Queries.foldConformanceClauses` must run before it is
	// first asked: a clause it re-records after that ask never reaches an extension's conformer list.
	// `recordConformancesOfATypeExtension` drops this memo, so `Queries.foldExtensionConformances` is not
	// bound the same way.
	export function declaredConformerIndex() returns DeclaredConformerIndex
		if self.settledDeclarations().conformerIndex.built 'alreadyBuilt'
			return self.settledDeclarations().conformerIndex
		end 'alreadyBuilt'

		let clauses = self.clauseConformanceIndex()
		let index = DeclaredConformerIndex.over(self.settledDeclarations().structNamesInDeclOrder, enumNames: self.declaredEnumNames(), swept: clauses, interfaces: self.settledDeclarations().interfaces)
		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.conformerIndex = index
		return index
	end 'declaredConformerIndex'

	export function conformerIndexWithExtensions() returns DeclaredConformerIndex
		let index = self.declaredConformerIndex()

		if index.extensionsBuilt 'alreadyBuilt'
			return index
		end 'alreadyBuilt'

		let extensionNames = NameRoster.create(self.settledDeclarations().extensionDeclaredConformances.count(), zeroed: false)

		for (typeName, _) in self.settledDeclarations().extensionDeclaredConformances 'eachExtensionConformer'
			extensionNames.push(typeName)
		end 'eachExtensionConformer'

		let ownDeclarations = self.mainThreadSettled()
		ownDeclarations.conformerIndex.fileExtensionConformers(groupConformersByInterface(extensionNames, swept: self.settledDeclarations().extensionDeclaredConformances, interfaces: self.settledDeclarations().interfaces))
		return self.settledDeclarations().conformerIndex
	end 'conformerIndexWithExtensions'

	function declaredEnumNames() returns NameRoster
		let enumNames = NameRoster.create(self.settledDeclarations().enumTypes.count(), zeroed: false)

		for (enumName, _) in self.settledDeclarations().enumTypes 'eachDeclaredEnum'
			enumNames.push(enumName)
		end 'eachDeclaredEnum'

		return enumNames
	end 'declaredEnumNames'

	// ⭐⭐ **REPLACE WHAT THE SWEEP RECORDED FOR ONE `implements` CLAUSE WITH THE WHOLE-PROGRAM RE-READ'S
	// ANSWER** — the write half of `Queries.foldConformanceClauses`. It writes THROUGH the registry's
	// own layout (`normalizeSweptInterfaceTypes`' shape one column over), so every reader that already holds
	// one sees the corrected list; nothing is re-keyed and no map is rewritten.
	//
	// ⚠ **THE DECLARING FILE IS CHECKED, AND IT IS THE ONLY THING STANDING BETWEEN THIS AND A DROPPED
	// DECLARATION.** `recordStruct` DROPS a user declaration that contests a compiler-owned name, leaving the
	// compiler's own layout under that key — and this re-read is driven by a SITE, which knows only that some
	// file declared the name there. Writing without the check would give the builtin's layout the user
	// declaration's conformances, which is `recordStruct`'s measured "user's struct captured the parameter
	// type of a module they did not write" with the clause instead of the fields. The same test settles a
	// name two files declare (E3006's business): the registry keeps one, and only that one's site writes.
	//
	// ⚠ **IT MIXES THE RE-READ INTO `self.hash`, AND THAT IS NOT BOOKKEEPING.** The list the compiler USES is
	// this one, so this one is what must be hashed. Editing `implements A with X, B` to `implements A with X, C` moves no byte
	// `recordStruct` can see — it hashes the truncated `[A]` either way — while it adds and removes whole
	// extension methods from the program. Only this mix carries that to the reader's parse memo.
	export function refoldConformanceClause(site ConformanceClauseDeclSite, clause ScannedConformanceClause)
		if site.declIsEnum 'anEnum'
			let registered = try self.mainThreadSettled().enumTypes.get(site.declName) otherwise return

			if not registered.declFilePath.equals(site.path) 'theRegistryHoldsAnotherDeclaration'
				return
			end 'theRegistryHoldsAnotherDeclaration'

			let enumLayout = registered.clone()
			enumLayout.recordConformances(clause.names)
			fileEnumLayout(self.mainThreadSettled().enumTypes, layout: enumLayout)
		end 'anEnum' else 'aType'
			let layout = try self.sweptLayoutDeclaredAt(site) otherwise return
			layout.recordConformances(clause.names, bindings: clause.bindings)
		end 'aType'

		let named = mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeRefoldedConformance), bytes: site.declName)
		self.hash = self.mixConformanceBindings(mixDeclaredConformances(named, conformsTo: clause.names, shape: SignatureDiscriminator.declShapeDeclaredConformance), bindings: clause.bindings)
	end 'refoldConformanceClause'

	export function refoldWhereConstraints(site ConformanceClauseDeclSite, constraints WhereConstraintArray)
		let layout = try self.sweptLayoutDeclaredAt(site) otherwise return
		layout.recordWhereConstraints(constraints)

		self.hash = self.mixWhereConstraints(mixBytes(Hasher.combined(self.hash, value: SignatureDiscriminator.declShapeRefoldedWhereConstraint), bytes: site.declName), constraints: constraints)
	end 'refoldWhereConstraints'

	function mixWhereConstraints(state HashDigest, constraints WhereConstraintArray) returns HashDigest
		var mixed = state

		for constraint in constraints 'eachConstraint'
			mixed = mixBytes(Hasher.combined(Hasher.combined(mixed, value: SignatureDiscriminator.declShapeWhereConstraint), value: constraint.typeParamIndex as HashDigest), bytes: constraint.interfaceName)

			for binding in constraint.associatedBindingTypes 'eachBinding'
				mixed = self.mixRequirementType(mixed, requirement: binding)
			end 'eachBinding'
		end 'eachConstraint'

		return mixed
	end 'mixWhereConstraints'

	function mixRegionBounds(state HashDigest, bounds RegionBoundArray) returns HashDigest
		var mixed = state

		for bound in bounds 'eachBound'
			let kindMark = match bound.kind 'kind'
				sendable gives SignatureDiscriminator.regionBoundSendable
				isolated gives SignatureDiscriminator.regionBoundIsolated
			end 'kind'

			mixed = Hasher.combined(Hasher.combined(Hasher.combined(mixed, value: SignatureDiscriminator.declShapeRegionBound), value: bound.typeParamIndex as HashDigest), value: kindMark)
		end 'eachBound'

		return mixed
	end 'mixRegionBounds'
end 'ProgramSignatures'
