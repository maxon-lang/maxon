extension Parser
	// ⭐⭐ **THE ONE E3005 A STORAGE-SLOT MISMATCH IS RAISED AS, GIVEN THE VOICE ITS PLACE SPEAKS IN.** Both
	// verdict doors — the trivial `declaredSlotVerdict` one above and the managed `requireManagedValueMatches`
	// one — end here, so a container element and a struct field cannot come to explain one rejection two
	// ways beyond the one difference `SlotMismatchVoice` names. Everything that varies with the voice varies
	// HERE, in one `match`: which `SourceParseError` variant, which name is quoted, and how the EXPECTED side is
	// spelled.
	//
	// `resolvedExpected` is the assignment voice's answer and arrives already rendered, because the two
	// verdict doors resolve it differently — the declared alias, else a bare tag name, where two TAGS
	// disagree; a NAME where two aggregates of one tag are told apart — and neither may have that decision
	// taken away from it.
	//
	// ⚠ **`assignedPlace` IS THE PLACE THE VALUE WAS ENTERING, AND THE VOICE DECIDES WHETHER THE
	// SENTENCE QUOTES IT.** The assignment voice does — a local, a global, a field, a union payload
	// all name themselves. The argument voice does not: at a container mutator the anchor and the
	// quoted name part company, and both halves are pinned (`specs/type-checking.md` anchors
	// `method-call-wrong-element-type` on the `push` token of `arr.push("hello")` while naming the
	// mutator's `value` PARAMETER, which is what an author would have to change). `ArrayValueLabel` is
	// that parameter — `stdlib/Array.maxon` declares `push(value Element)`, `set(index, value)` and
	// `insert(at, value)`, so the label a two-argument mutator REQUIRES and the name its element
	// parameter CARRIES are one fact with one home. **The selection is made HERE and not by the
	// callers**: a caller convention is correct at its one site and structurally free to stop being,
	// and a `voice` paired with the wrong name is precisely the "one refusal, two sentences" defect
	// this enum exists to end.
	//
	// ⚠ **WHEREVER A NAME IS PRINTED AT ALL, BOTH VOICES PRINT `displayTypeNameOf`'s** (user ruling,
	// 2026-08-04: a diagnostic names a type by the `typealias` the author wrote, never by the compiler's
	// mint) — so a struct, a union, an interface and a GENERIC INSTANCE read the author's way in either
	// sentence. A ranged or float alias is named by `declaredSlotDisplayName` in every voice. A place whose
	// declaration spelling was recorded (`placeSpelling`) prints that spelling in every voice
	// (`declaredPlaceDisplay`).
	function slotMismatchError(voice SlotMismatchVoice, placeDoor FunctionTypeDoor, placeName ByteArray, placeOwner SlotOwner, placeBrand ByteArray, placeSpelling ByteArray, got String, gotNote String, resolvedExpected String, expectedNote String, declared ValueTypeTag, declaredNameId TypeNameId, line LineNumber, column ColumnNumber, crossesRange bool) returns SourceParseError
		let placeDisplay = self.declaredPlaceDisplay(placeSpelling, brand: placeBrand, tag: declared, nameId: declaredNameId)
		let gotDisplay = "{got}{gotNote}"

		return match voice 'v'
			assignedPlace gives SourceParseError.assignTypeMismatch(assignedPlacePhrase(placeDoor, name: placeName, owner: placeOwner), got: got, gotNote: gotNote, expected: resolvedExpected if placeSpelling.isEmpty() else placeDisplay, expectedNote: expectedNote, line: line, column: column, crossesRange: crossesRange)
			containerElementArgument gives SourceParseError.builtinArgumentType(String.from(ArrayValueLabel), expected: placeDisplay, got: gotDisplay, line: line, column: column, expectedNote: expectedNote, crossesRange: crossesRange)

			// The payload voice quotes no name at all (there is none to quote) and spells the EXPECTED side
			// through `declaredSlotDisplayName`, the same probe the argument voice makes — which is what puts
			// `enum-full.md`'s `expected Integer` (a ranged alias) and `union-cases.md`'s `expected Color` (an
			// enum) under one rule instead of two.
			payloadArgument gives SourceParseError.typeMismatchExpectedGot(placeDisplay, got: gotDisplay, line: line, column: column, expectedNote: expectedNote, crossesRange: crossesRange)

			// The argument sentence one voice up, quoting the slot's OWN name — which for a request union's
			// payload is the message parameter the author declared. See `SlotMismatchVoice.messageArgument`.
			messageArgument gives SourceParseError.builtinArgumentType(String.from(placeName), expected: placeDisplay, got: gotDisplay, line: line, column: column, expectedNote: expectedNote, crossesRange: crossesRange)
		end 'v'
	end 'slotMismatchError'

	function declaredPlaceDisplay(spelling ByteArray, brand ByteArray, tag ValueTypeTag, nameId TypeNameId) returns String
		if spelling.isEmpty() and not brand.isEmpty() 'aBrandWithNoRecordedSpelling'
			return self.signatures.aliasIdentityDisplay(brand)
		end 'aBrandWithNoRecordedSpelling'

		return self.declaredSpellingDisplay(spelling, tag: tag, nameId: nameId)
	end 'declaredPlaceDisplay'

	function declaredSpellingDisplay(spelling ByteArray, tag ValueTypeTag, nameId TypeNameId) returns String
		if spelling.isEmpty() 'noSpellingToQuote'
			return self.declaredSlotDisplayName(tag, nameId: nameId, fallback: self.displayTypeNameOf(tag, nameId: nameId))
		end 'noSpellingToQuote'

		return self.signatures.aliasIdentityDisplay(spelling)
	end 'declaredSpellingDisplay'

	function namesADeclaredSlotAlias(tag ValueTypeTag, nameId TypeNameId) returns bool
		if (tag != ValueTypeTag.named and tag != ValueTypeTag.float) or nameId == UnnamedTypeId 'notASlotAlias'
			return false
		end 'notASlotAlias'

		match self.declaredAliasOfNameId(nameId) 'a'
			declared then return true
			undeclared then return false
		end 'a'
	end 'namesADeclaredSlotAlias'

	function declaredSlotDisplayName(tag ValueTypeTag, nameId TypeNameId, fallback String) returns String
		if not self.namesADeclaredSlotAlias(tag, nameId: nameId) 'noAliasToQuote'
			return fallback
		end 'noAliasToQuote'

		return self.signatures.aliasIdentityDisplay(self.internedName(nameId))
	end 'declaredSlotDisplayName'

	// Two declared aliases are two types (LANGUAGE_REFERENCE "Aliases Are Distinct Types"), so a float alias
	// at an integer alias place is the E3005 mismatch at every door, never the E3009 narrowing.
	function declaredSlotVerdict(got ValueTypeTag, gotNameId TypeNameId, declared ValueTypeTag, declaredNameId TypeNameId) returns DeclaredTypeMatch
		let verdict = checkDeclaredType(got, declared: declared)

		if verdict == DeclaredTypeMatch.narrowsFloatToInt and self.namesADeclaredSlotAlias(got, nameId: gotNameId) and self.namesADeclaredSlotAlias(declared, nameId: declaredNameId) 'twoDistinctAliases'
			return DeclaredTypeMatch.mismatch
		end 'twoDistinctAliases'

		return verdict
	end 'declaredSlotVerdict'

	// ⭐⭐ **A DECLARED PLACE THAT CANNOT HOLD A FAT POINTER YET — THE ONE REFUSAL FOR EVERY SUCH PLACE**
	// An existential is TWO machine words, and it is
	// supplied only where there is somewhere to put the second one: a PARAMETER of a NAMED function (an
	// adjacent hidden argument), a LOCAL (a second SSA value), and a STRUCT FIELD (a second
	// SLOT, `Project.fieldSlotCount`). Every place `DeclaredStoragePosition` names lacks that room, and
	// without its arm each is a COMPILER PANIC, a SEGFAULT or a silently degraded type on a program the front
	// end accepts:
	//
	//   • a UNION PAYLOAD — `classifyUnionPayload` panics naming this very function. A payload slot is one
	//     machine word and, unlike a struct field, cannot widen (every
	//     case shares one slot region), so a payload bound out of a `match` arm would dispatch through whatever
	//     the next slot happened to hold.
	//   • the RETURN positions that CANNOT read the second return register, which are not the same case as
	//     the one that can. A DIRECT call's return writes it; a THROWING function's is already spending it on
	//     the error flag; a function TYPE's and a
	//     REQUIREMENT's are dispatched through call ops that declare one result. ⚠ The throwing
	//     case is REFUSED rather than silently skipped or left to panic at the first dispatch on
	//     the result: silence is the one unacceptable outcome.
	//   • a CONTAINER ELEMENT — an element slot is one machine word.
	//   • the three PARAMETER kinds with no adjacent slot — a closure's and a function TYPE's (the uniform
	//     `(userargs, record)` indirect ABI) and an interface REQUIREMENT's (a witness call). MEASURED: exit 139
	//     on x64 with a proper conformer, and a wasm trap even where the parameter was never dispatched on.
	//   • a TUPLE ELEMENT — a tuple is a synthesized struct, and this one reaches the BACKEND: it panics in
	//     `LayoutDescriptor.primitiveTypeTagName`, on an assertion that the front end has already refused it.
	//
	// ⚠ **IT IS ASKED AT THE DECLARATION AND NOT AT THE USE.** Each panic fires at a USE — a field store, a
	// method call on a returned value — where the mechanism is already missing and the author has nothing left
	// to change. Refusing where the type is WRITTEN names the line that has to move.
	//
	// ⚠ **THE TOLERANT READERS ARE KEPT OUT THREE DIFFERENT WAYS, AND ONLY ONE IS "BY CONSTRUCTION":**
	//   • the PAYLOAD/ELEMENT readers, by construction — during `foldDeclaredSignaturesInto`
	//     `parseTypeReference` cannot mint an `interfaceRef` at all (its arm is gated on `allFilesFolded`, and
	//     the interface registry is not filled until the sweep ends), so a swept declaration is a bare `named`.
	//   • the FUNCTION-TYPE reader, by a FLAG — `readFunctionTypeAlias`'s `recordSignature`, which the sweep
	//     passes `false`.
	//   • the INTERFACE reader, by DEFERRAL — it notes rather than throws, because its other caller
	//     (`foldInterfaceDeclarationInto`) swallows a `SourceParseError` and would silently drop the declaration.
	//     That one is why "one call per position" is not literally true either: the requirement positions
	//     reach the message through `requireNoUnstorableRequirementType` instead of through this function.
	function requireStorableDeclaredType(declared MaxonType, position DeclaredStoragePosition, line LineNumber, column ColumnNumber) throws SourceParseError
		if maxonTypeTag(declared) != ValueTypeTag.interfaceRef 'notAnExistential'
			return
		end 'notAnExistential'

		throw SourceParseError.unsupported(interfaceStoragePositionMessage(position, interfaceName: self.internedName(typeNameIdOf(declared))), line: line, column: column)
	end 'requireStorableDeclaredType'

	// ⭐⭐ **WHAT ONE `Base with Args` ARGUMENT MAY BE — the two-armed door `parseGenericArgNode` asks, and
	// the ONE place a fat pointer is admitted rather than refused.**
	//
	// A CONTAINER ELEMENT is the ordinary storage question, unchanged: an element slot is one machine word.
	//
	// An ASSOCIATED-TYPE BINDING naming an interface is something else entirely — it is not a value being
	// stored anywhere, it is the program DECLARING that it holds that associated position existentially
	// (`ProgramSignatures.settleAssociatedTypeHoldings`). Admitted where the associated type is only ever a
	// requirement's RESULT, because the second table then rides in each conformer's own witness table; refused
	// where a requirement TAKES it, because there the table would have to come from the caller and no static
	// slot can be right about it.
	//
	// ⚠ **THE ARITY GUARDS ARE `checkGenericSpellings`'s AND E3016's, NOT THIS DOOR'S** — an argument past the
	// interface's `uses` names, and an interface no file declares readably, both ADMIT here and are reported
	// where they belong. Refusing on them would report an arity mistake as an ABI one.
	function requireCarryableGenericArg(argType MaxonType, slot GenericArgSlot, position FieldIndex, argTok Token) throws SourceParseError
		if not self.signatures.genericArgumentIsRefused(slot, argumentIsAnInterface: maxonTypeTag(argType) == ValueTypeTag.interfaceRef, position: position as ElementIndex) 'admitted'
			return
		end 'admitted'

		// Thrown here, where the argument is parsed, rather than recorded: a recorded diagnostic is
		// discarded when a later throw abandons its region, and the author is then shown an unrelated
		// error further down instead.
		throw SourceParseError.unsupported(interfaceStoragePositionMessage(slot.storagePosition(), interfaceName: self.internedName(typeNameIdOf(argType))), line: argTok.line, column: argTok.column)
	end 'requireCarryableGenericArg'

	function namesAnExtensionAssociatedType(argTok Token) returns bool
		let _ = try self.extensionAssociated.names.positionOfName(argTok.value) otherwise return false
		return true
	end 'namesAnExtensionAssociatedType'

	function noteInterfaceBindingHeldAsArgument(argType MaxonType, argTok Token, baseName ByteArray, position FieldIndex)
		if self.extensionAssociated.pass != ExtensionBodyPass.sweep or self.extensionAssociated.names.isEmpty() 'nothingToNote'
			return
		end 'nothingToNote'

		if not self.typeNamesAnInterface(argType) 'notAnInterfaceBinding'
			return
		end 'notAnInterfaceBinding'

		let associatedPosition = try self.extensionAssociated.names.positionOfName(argTok.value) otherwise return
		self.extensionAssociated.heldUses.push(HeldAssociatedUse.create(associatedPosition, held: ExtensionHeldArgument.create(baseName, position: position)))
	end 'noteInterfaceBindingHeldAsArgument'

	function typeNamesAnInterface(declared MaxonType) returns bool
		let tag = maxonTypeTag(declared)

		if tag == ValueTypeTag.interfaceRef 'anExistential'
			return true
		end 'anExistential'

		if tag != ValueTypeTag.named and tag != ValueTypeTag.structRef 'notANameToLookUp'
			return false
		end 'notANameToLookUp'

		return isInterfaceName(self.signatures.interfaceMap(), name: self.internedName(typeNameIdOf(declared)))
	end 'typeNamesAnInterface'

	// The interned NAME behind a `named`/`structRef` id, from THIS file's interner — where every id a
	// type check sees was minted: the value during this parse, a declared return/field/binding type
	// from this file. A miss is a compiler invariant break, never user input (see TypeNameInterner).
	function internedName(id TypeNameId) returns immutable ByteArray
		return try self.artifact.typeNames.nameOf(id) otherwise panic("Parser.internedName: type-name id {id} is not in this file's interner — every `named`/`structRef` id is minted from it")
	end 'internedName'

	function functionAliasType(name ByteArray, readerFilePath FilePath) returns MaxonType
		return MaxonType.function(self.artifact.typeNames.intern(self.signatures.declaredIdentityOfSpelling(name, declFilePath: readerFilePath)))
	end 'functionAliasType'

	// The interned type-name id of an SSA value, read straight from the dense `valueNameIds` column —
	// the id `typeOf` and `valueIsUnsigned` both need, and a scalar (no `MaxonType` materialized). A
	// miss is a parser invariant break: the two type columns are minted in lockstep for every value.
	function valueNameId(value ValueId) returns TypeNameId
		return try self.bodyState.valueNameIds.get(value) otherwise panic("Parser.valueNameId: value v{value} has no recorded type name — the two type columns fell out of lockstep")
	end 'valueNameId'

	// Stamp the brand `value` wears — the generic-instance alias it was declared, built or read under, or the
	// buffer view of one (`bufferViewBrandOver`). An EMPTY brand stamps nothing: a value with no statically-known alias DECAYS into any brand of its
	// instance, and its per-instance `Idx` results and arguments lose their per-instance identity.
	function brandValue(value ValueId, brand ByteArray)
		if brand.isEmpty() 'noBrand'
			return
		end 'noBrand'

		if isCompilerReservedName(brand) and not isBufferViewBrand(brand) 'anUnknownCompilerMint'
			panic("brandValue: '{String.from(brand)}' is a compiler-reserved brand and the buffer view is the only one the compiler mints — an author cannot spell a name that starts with `__`")
		end 'anUnknownCompilerMint'

		try self.bodyState.valueBrandIds.set(value, value: self.artifact.typeNames.intern(brand)) otherwise panic("brandValue: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
	end 'brandValue'

	// ⭐⭐ **HAND THIS FUNCTION'S EXISTENTIAL-INSTANCE COLUMN TO THE `IrFunction`, ONCE, AFTER THE BODY.**
	// Every sibling value column is handed over at `IrFunction.create` and grown in place afterwards; this one
	// is REPLACED by the copy-on-write below rather than grown, so the reference `create` was given is the
	// shared empty for exactly the functions that later record something. Called at the end of all THREE parses
	// that mint an `IrFunction` — a declared function, a default-value helper and a lifted closure — each at the
	// point its own `recordFuncSignature` runs, which is the one place per parse where the body is complete and
	// the parser's field still points at the map that body filled (a closure's body SWAPS the field, and swaps
	// it back, so the enclosing function's publish must happen after the swap has been undone — which the end of
	// its body is).

	// ⛔ **THE TRIPWIRE.** A tracked binding's recorded tail IS its current value: a tail that has stopped
	// being one is a write to `boundValue` that skipped `recordDebugRebind`, and the record would then name
	// a location the value is not at where the debugger stops — a confident wrong answer with nothing to
	// notice it by.
	function requireDebugRecordIsCurrent(record DebugLocalDecl, current ValueId)
		let last = (try record.versions.get(record.versions.count() - 1) otherwise panic("requireDebugRecordIsCurrent: '{String.from(record.name)}' has an empty value list, where every record is created holding the value its declaration produced")).value

		if last != current 'aWriteBypassedTheDoor'
			panic("debug info: '{String.from(record.name)}' holds value {current} where the last one recorded for it is {last} — a site assigned `boundValue` without calling `recordDebugRebind` first, so this name's record is missing the value it holds")
		end 'aWriteBypassedTheDoor'
	end 'requireDebugRecordIsCurrent'

	// ⭐ **ENROL ONE SOURCE BINDING IN THE DEBUG-INFO ROSTER.** A `let`, a `var` and a parameter are the
	// names a user asks a debugger about by the spelling their own source wrote; a `for` variable, a
	// match-arm payload and every compiler-minted stand-in are not, and a record for one of those would be
	// a name the reader will look for in their program and not find.
	//
	// The two names excluded here are the two the language itself owns: `__self` is the receiver the parser
	// pushed, which no source token declares, and `_` is the discard, which says in as many words that the
	// author wanted the slot and not the name.
	function trackDebugLocal(binding VarInfo)
		if not self.job.capturesDebugLocals or binding.name.equals(SelfParamName) or binding.name.equals(DiscardBindingName) 'notARecordedName'
			return
		end 'notARecordedName'

		binding.debugLocalRecorded = true
		binding.debugLocalSlot = self.bodyState.debugLocals.count() as DebugLocalSlot
		self.bodyState.debugLocals.push(DebugLocalDecl.create(binding.name, declaredType: binding.varType, firstValue: binding.boundValue, firstDef: self.debugDefinitionHere(), heldInACell: binding.isCellBinding))
		self.bodyState.debugBindings.push(binding)
		self.bodyState.debugOpenSlots.push(binding.debugLocalSlot)
	end 'trackDebugLocal'

	function debugDefinitionHere() returns DebugVersionDef
		let block = self.bodyState.currentBlock
		let ops = block.bodyOps()
		var at = ops.count()

		while at > 0 'eachOpBackwards'
			at = at - 1
			let opIdx = try ops.get(at) otherwise panic("debugDefinitionHere: bodyOps.get OOB at {at} below the count just read")
			let op = try self.artifact.module.ops.get(opIdx) otherwise panic("debugDefinitionHere: ops.get OOB at {opIdx} — a block names only ops its module holds")

			if let defined = try maxonOpDefinedValue(op) 'aValuedOp'
				if self.tagOf(defined) != ValueTypeTag.void 'aValueTheCodeKeeps'
					return DebugVersionDef.definedAfter(block.id, anchor: defined)
				end 'aValueTheCodeKeeps'
			end 'aValuedOp'
		end 'eachOpBackwards'

		return DebugVersionDef.definedIn(block.id)
	end 'debugDefinitionHere'

	// ⭐⭐ **RECORD A REBIND, AND EVERY SITE THAT WRITES `boundValue` CALLS THIS FIRST.** A name owns a
	// SEQUENCE of values — the merge phis, the loop-header phis, the snapshot rewind and the source-level
	// assignment each mint another — and a record holding only the declaration's value names a location
	// the value is not at by the time a debugger stops there.
	//
	// ⛔ **AND IT CATCHES A SITE THAT DID NOT CALL IT.** A tracked binding's recorded tail IS its current
	// value, so a tail that has stopped being one is a write this never saw. Checked here and again at
	// `publishDebugLocals`, so a bypass is caught whether or not another rebind follows it.
	//
	// ⚠ **IT TAKES THE BINDING'S TWO SCALARS RATHER THAN THE BINDING.** A parameter of `VarInfo` type here
	// would make this a function that WRITES through a parameter as far as the whole-program summary is
	// concerned, and a phi site cannot hand `pv.binding` to such a function at all (E3207) — every one of
	// them holds its `LoopPhiVar` through a list it does not own.
	function recordDebugRebind(slot DebugLocalSlot, recorded bool, current ValueId, value ValueId, def DebugVersionDef)
		if not recorded 'notRecorded'
			return
		end 'notRecorded'

		let record = try self.bodyState.debugLocals.get(slot) otherwise panic("recordDebugRebind: debug-local slot {slot} is past the {self.bodyState.debugLocals.count()} this function has recorded")
		requireDebugRecordIsCurrent(record, current: current)
		record.versions.push(DebugLocalVersion.create(value, def: def))
	end 'recordDebugRebind'

	// The same, for the three source-level assignment sites, which hold the name rather than the binding.
	function recordDebugRebindByName(name ByteArray, value ValueId)
		if not self.job.capturesDebugLocals 'notCapturing'
			return
		end 'notCapturing'

		let binding = self.bodyState.scope.getInfo(name)
		self.recordDebugRebind(binding.debugLocalSlot, recorded: binding.debugLocalRecorded, current: binding.boundValue, value: value, def: self.debugDefinitionHere())
	end 'recordDebugRebindByName'

	function noteFoldedBinding(record DebugLocalDecl, binding VarInfo)
		if binding.isCellBinding or record.versions.count() != 1 or not self.constIsKnown(binding.boundValue) 'notOneFoldedValue'
			return
		end 'notOneFoldedValue'

		record.noteFoldedConstant(binding.boundValue, constant: self.constOf(binding.boundValue))
	end 'noteFoldedBinding'

	// The function's bindings, handed over once at its `end` — `publishExistentialInstances`' twin, and
	// late for its own reason: a binding leaves SCOPE at its block's `end` while its record must reach the
	// function's, so the roster is the parser's own `VarInfo` list rather than the scope's.
	function publishDebugLocals(func IrFunction)
		if self.bodyState.debugLocals.count() == 0 'nothingRecorded'
			return
		end 'nothingRecorded'

		for i in 0 upto self.bodyState.debugLocals.count() 'eachRecord'
			let record = try self.bodyState.debugLocals.get(i) otherwise panic("publishDebugLocals: debugLocals.get OOB at {i} despite the upto bound")
			let binding = try self.bodyState.debugBindings.get(i) otherwise panic("publishDebugLocals: debugBindings.get OOB at {i} — the two columns are appended by one door")
			requireDebugRecordIsCurrent(record, current: binding.boundValue)
			self.noteFoldedBinding(record, binding: binding)
		end 'eachRecord'

		func.debugLocals = self.bodyState.debugLocals
	end 'publishDebugLocals'

	function publishBrandOrigins(func IrFunction, byValue BrandOriginMap)
		let values = ValueIdArray.create(byValue.count(), zeroed: false)
		let keys = NameRoster.create(byValue.count(), zeroed: false)

		for (value, key) in byValue 'eachOrigin'
			values.push(value)
			keys.push(key)
		end 'eachOrigin'

		func.brandOriginValues = values
		func.brandOriginKeys = keys
	end 'publishBrandOrigins'

	function recordAdoptableStore(key immutable ByteArray, declaredBrand ByteArray, valueType MaxonType, value ValueId, phrase String, anchor Token)
		if not declaredBrand.isEmpty() or maxonTypeTag(valueType) != ValueTypeTag.genericInstance 'carriesNoBrandToAdopt'
			return
		end 'carriesNoBrandToAdopt'

		let stored = self.authoredBrandOf(value)
		let origin = EmptySourceText if not stored.isEmpty() else (try self.brandOriginOf(value) otherwise EmptySourceText)

		if stored.isEmpty() and origin.isEmpty() 'storesNothingToAdopt'
			return
		end 'storesNothingToAdopt'

		self.artifact.recordBrandRecord(PendingBrandRecord.create(key, kind: BrandRecordKind.store, brand: stored, opIndex: 0, argIndex: 0, label: EmptySourceText, phrase: freeze phrase.toByteArray(), line: anchor.line, column: anchor.column, filePath: self.job.path, originKey: origin))
	end 'recordAdoptableStore'

	function keyAdoptableLocal(nameTok Token, kind BindingKind, value ValueId)
		if kind != BindingKind.var or self.tagOf(value) != ValueTypeTag.genericInstance or self.brandIdOf(value) != UnnamedTypeId 'notAnAdoptableVar'
			return
		end 'notAnAdoptableVar'

		let key = freeze "local|{self.job.path.toString()}|{self.artifact.currentFuncIndex}|{nameTok.line}:{nameTok.column}|{String.from(nameTok.value)}".toByteArray()
		self.bodyState.scope.setBrandKey(nameTok.value, key: key)
		self.recordAdoptableStore(key, declaredBrand: EmptySourceText, valueType: self.typeOf(value), value: value, phrase: assignedPlacePhrase(FunctionTypeDoor.variable, name: nameTok.value, owner: SlotOwner.unowned), anchor: nameTok)
	end 'keyAdoptableLocal'

	function wearAdoptedBrand(binding VarInfo, value ValueId) returns ValueId
		if binding.brandKey.isEmpty() or binding.brandId == UnnamedTypeId or self.brandIdOf(value) != UnnamedTypeId 'nothingToWear'
			return value
		end 'nothingToWear'

		try self.bodyState.valueBrandIds.set(value, value: binding.brandId) otherwise panic("wearAdoptedBrand: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
		return value
	end 'wearAdoptedBrand'

	function readOfAnUnadoptedLocal(binding VarInfo, value ValueId) returns ValueId
		if binding.brandKey.isEmpty() or binding.brandId != UnnamedTypeId or self.tagOf(value) != ValueTypeTag.genericInstance 'carriesNoPendingBrand'
			return value
		end 'carriesNoPendingBrand'

		self.noteBrandOrigin(value, key: binding.brandKey)
		return value
	end 'readOfAnUnadoptedLocal'

	function recordUnadoptedBrandDoor(value ValueId, expected immutable ByteArray, door FunctionTypeDoor, placeName ByteArray, owner SlotOwner, anchor Token)
		let key = try self.brandOriginOf(value) otherwise return
		self.artifact.recordBrandRecord(PendingBrandRecord.create(key, kind: BrandRecordKind.assignDoor, brand: expected, opIndex: 0, argIndex: 0, label: EmptySourceText, phrase: freeze brandedPlacePhrase(door, name: placeName, owner: owner).toByteArray(), line: anchor.line, column: anchor.column, filePath: self.job.path))
	end 'recordUnadoptedBrandDoor'

	function authoredBrandOf(value ValueId) returns immutable ByteArray
		let own = self.brandOf(value)
		return own if brandIsTheType(own) and not isCompilerReservedName(own) else EmptySourceText
	end 'authoredBrandOf'

	function carryMergeOrigin(phi ValueId, arms ValueIdArray, anchor Token)
		var phiOriginNoted = false

		for i in 0 upto arms.count() 'eachArm'
			let key = try self.brandOriginOf(try arms.get(i) otherwise panic("carryMergeOrigin: arms.get OOB at {i}")) otherwise continue
			self.noteBrandOrigin(phi, key: key)
			phiOriginNoted = true
			break
		end 'eachArm'

		if not phiOriginNoted 'noArmAwaitsABrand'
			return
		end 'noArmAwaitsABrand'

		for i in 0 upto arms.count() 'eachRecordedArm'
			let arm = try arms.get(i) otherwise panic("carryMergeOrigin: arms.get OOB at {i}")
			let authored = self.authoredBrandOf(arm)
			let key = try self.brandOriginOf(arm) otherwise EmptySourceText

			if not authored.isEmpty() or not key.isEmpty() 'anArmThatHoldsABrand'
				self.artifact.recordBrandRecord(PendingBrandRecord.create(key, kind: BrandRecordKind.mergeArms, brand: authored, opIndex: 0, argIndex: 0, label: EmptySourceText, phrase: EmptySourceText, line: anchor.line, column: anchor.column, filePath: self.job.path))
			end 'anArmThatHoldsABrand'
		end 'eachRecordedArm'
	end 'carryMergeOrigin'

	function noteBrandOrigin(value ValueId, key ByteArray)
		self.bodyState.brandOrigins = withBrandOrigin(self.bodyState.brandOrigins, value: value, key: key)
	end 'noteBrandOrigin'

	function brandOriginOf(value ValueId) returns immutable ByteArray throws MapError
		match self.bodyState.brandOrigins 'column'
			unwritten then throw MapError.keyNotFound
			entries(byValue) then return try byValue.get(value)
		end 'column'
	end 'brandOriginOf'

	function publishExistentialInstances(func IrFunction)
		// The state stops here — see `IrFunction.valueExistentialInstances` for the pool-worker aliasing that
		// keeps that field a map. A function that recorded nothing hands over nothing and the target keeps its
		// own empty one.
		match self.bodyState.valueExistentialInstance 'function'
			unwritten then break
			entries(byValue) then func.valueExistentialInstances = byValue
		end 'function'

		match self.bodyState.valueCallInstance 'function'
			unwritten then break
			entries(byValue) then func.valueCallInstances = byValue
		end 'function'

		match self.bodyState.literalCastArguments 'function'
			unwritten then break
			entries(confirmed) then func.literalCastArguments = confirmed
		end 'function'

		match self.bodyState.letCasts 'function'
			none then break
			tracking(state) then func.letCastReads = state.reads
		end 'function'

		func.existentialFieldStores = self.bodyState.existentialFieldStores

		match self.bodyState.deferredArgumentBindings 'function'
			unwritten then break
			entries(bindings) then func.deferredArgumentBindings = bindings
		end 'function'

		match self.bodyState.pendingOverlaps 'function'
			unwritten then break
			entries(overlaps) then func.pendingOverlaps = overlaps
		end 'function'

		match self.bodyState.brandOrigins 'function'
			unwritten then break
			entries(byValue) then self.publishBrandOrigins(func, byValue: byValue)
		end 'function'
	end 'publishExistentialInstances'

	function beginDeclaredBody(firstValueId ValueId, returnSpelling ByteArray, returnBrand ByteArray, returnAlias DeclaredAlias, paramSites RangeCheckParamSiteArray, layoutParam HiddenWordParam, countParam HiddenWordParam, nascentSelfFactory bool, kind EnclosingBodyKind, witnessParamBase ValueId, witnessParamCount ParamCount)
		self.requireNoAwaitHeldAcrossFunctions()
		self.bodyState = FunctionBodyState.fresh(self.anchors, firstValueId: firstValueId, returnSpelling: returnSpelling, returnBrand: returnBrand, closureEnv: ClosureEnvParam.none, returnAlias: returnAlias, paramSites: paramSites, layoutParam: layoutParam, countParam: countParam, nascentSelfFactory: nascentSelfFactory, kind: kind)
		self.declaringWitnessParamBase = witnessParamBase
		self.declaringWitnessParamCount = witnessParamCount
	end 'beginDeclaredBody'

	function seedHiddenIntegerParam(valueId ValueId, anchor Token)
		self.recordValueType(MaxonType.integer)
		self.artifact.recordParamOrigin(valueId, range: SourceRange.ofToken(anchor))
	end 'seedHiddenIntegerParam'

	function seedHiddenWordParam(param HiddenWordParam, anchor Token)
		match param 'param'
			slot(valueId) then self.seedHiddenIntegerParam(valueId, anchor: anchor)
			none then return
			enclosingThroughEnv then panic("seedHiddenWordParam: a declared body seeds its own hidden slots, and only a closure body inherits one through its environment")
		end 'param'
	end 'seedHiddenWordParam'

	function closureEnvValue() returns ValueId
		match self.bodyState.closureEnv 'env'
			param(valueId) then return valueId
			none then panic("Parser.closureEnvValue: a capture is read only inside a closure body, which alone reserves an environment parameter")
		end 'env'
	end 'closureEnvValue'

	// The body's sole-owner marks as a column of their own, sized to them, for the function that keeps them.
	function mintedSoleColumn() returns BoolArray
		let column = BoolArray.create(self.bodyState.valueMintedSole.count(), zeroed: false)

		for minted in self.bodyState.valueMintedSole 'eachValue'
			column.push(minted)
		end 'eachValue'

		return column
	end 'mintedSoleColumn'

	// ⭐⭐ **RECORD THE `with` ARGUMENTS AN EXISTENTIAL VALUE'S DECLARED TYPE NAMED** — see
	// `ValueExistentialInstanceMap` for what the column is for and why the fact cannot ride on the type. Two
	// producers write it and they are the two ends of one chain: the PARAMETER whose declared type is a
	// generic alias over an interface base, and a dispatch RESULT whose associated position that parameter's
	// instance holds at another interface (`mintHeldAssociatedWitnessResult`) — so `for item in source` reaches
	// `current()` with the source's own binding still in hand.
	function recordValueExistentialInstance(value ValueId, claim ExistentialClaim)
		// Allocated on the first write (`valueExistentialInstancesForWrite`), so a function with no
		// parameterized-interface value never allocates one.
		let byValue = self.valueExistentialInstancesForWrite()
		byValue.upsert(value, value: claim.instance)
		let scopes = self.valueExistentialScopesForWrite()
		scopes.upsert(value, value: claim.scopeFilePath)
	end 'recordValueExistentialInstance'

	// ⭐ **RECORD THE RANGED TYPEALIAS A VALUE'S DECLARED TYPE NAMES** (see `ValueDeclaredAliasMap` for
	// what this map is for and why it exists beside the two type columns). Only a declared ranged
	// alias is recorded: a cast to `ExitCode`, to a bare primitive or to a struct names none, and a
	// value with no entry simply falls back to its own `named` tag (`valueDenotedAlias`).
	//
	// ⚠ **THE CALLER OWNS THE ALIASING QUESTION.** This writes the value it is given, so a caller holding a
	// value that another BINDING also names must not call it — see `ValueDeclaredAliasMap`'s gate and
	// `applyCast`, the one door where that can happen.
	function recordValueDeclaredAliasId(value ValueId, aliasId TypeNameId)
		// Allocated on the first write (`valueDeclaredAliasesForWrite`), so a function with no
		// float-alias value and no `as` cast never allocates one.
		let recorded = self.valueDeclaredAliasesForWrite()
		recorded.upsert(value, value: aliasId)
	end 'recordValueDeclaredAliasId'

	function recordValueDeclaredAliasName(value ValueId, aliasName ByteArray)
		self.recordValueDeclaredAliasId(value, aliasId: self.artifact.typeNames.intern(aliasName))
	end 'recordValueDeclaredAliasName'

	// ⭐ **THE RANGED TYPEALIAS AN EXPRESSION'S VALUE DENOTES** — the SOURCE half of every containment
	// question in this file: E3010's *"is the written cast unneeded?"*, and every range-check door's
	// *"is the runtime guard provably dead?"*. They are one question with two consumers, so the value's
	// answer is read in one place.
	//
	// The recorded entry WINS over the value's own `named` tag, because it is the LATER and more specific
	// statement about the same value: `identity(42) as Byte` hands back the call result untouched, and that
	// result's type column still says `Integer` while the expression now denotes a `Byte`.
	function valueDenotedAlias(value ValueId) returns DeclaredAlias
		let aliasId = try self.denotedAliasId(value) otherwise return DeclaredAlias.undeclared
		return self.castAliasNamedBy(aliasId)
	end 'valueDenotedAlias'

	function denotedAliasId(value ValueId) returns TypeNameId throws MapError
		match self.recordedCastAlias(value) 'castAlias'
			declared then return try self.castAliasOf(value)
			undeclared then break
		end 'castAlias'

		match self.provenAliasOfValue(value) 'proven'
			declared then return self.valueNameId(value)
			undeclared then throw MapError.keyNotFound
		end 'proven'
	end 'denotedAliasId'

	// ⭐ **THE ALIAS A CAST RECORDED ON THIS VALUE, OR `undeclared`** — the map read the two
	// denoted-alias readers (`denotedAliasId`, `domainDeclaringAlias`) share, spelled once. They
	// differ ONLY in what they fall back to when nothing was recorded, and that difference is the
	// whole of why there are two (see `domainDeclaringAlias`).
	function recordedCastAlias(value ValueId) returns DeclaredAlias
		let aliasId = try self.castAliasOf(value) otherwise return DeclaredAlias.undeclared
		return self.castAliasNamedBy(aliasId)
	end 'recordedCastAlias'

	function castAliasNamedBy(aliasId TypeNameId) returns DeclaredAlias
		return self.signatures.fileScopedOrInnerAliasNamed(self.internedName(aliasId), readerFilePath: self.job.path)
	end 'castAliasNamedBy'

	// ⭐⭐ **THE RANGED ALIAS AN INTEGER VALUE'S DECLARED TYPE NAMES — `valueDenotedAlias` WITH THE OTHER
	// FALLBACK, AND THE DIFFERENCE IS A MEASURED ONE.** Same map, same precedence; where
	// nothing was recorded this reads the value's DECLARED type (`declaredAliasOfValue`) and not its
	// PROVEN one. It is what `integerValueDomain` — and so both consumers of that domain, the divide
	// and the decimal renderer — resolves a value's signedness through.
	//
	// ⚠ **A PHI'S DECLARED ALIAS IS WITHHELD FROM THE ZERO PROOF, AND FROM THE SIGNEDNESS RULE ONLY WHERE
	// THE ALIAS LIES INSIDE `0 to i64.max`** (`declaredAliasHonouredBy`). The zero withhold exists because a
	// merge can carry a `0` its declared `NonZero` never proved, and a wrong `neverZero` is an UNCATCHABLE
	// hardware fault. An unproven value of a non-negative signed-width alias may be a negative its name never
	// proved, so it reads signed. A full-width unsigned alias keeps the reading the program WROTE, which
	// `valueIsUnsigned` — the shift rule, the other half of the same question — also reads: routing this
	// through `provenAliasOfValue` instead turns stdlib's float printer back to `cqo`+`idiv` on a
	// loop-carried `int(0 to u64.max)`.
	function domainDeclaringAlias(value ValueId) returns DeclaredAlias
		let recorded = self.recordedCastAlias(value)

		return match recorded 'r'
			declared gives recorded
			undeclared gives self.declaredAliasHonouredBy(value)
		end 'r'
	end 'domainDeclaringAlias'

	function declaredAliasHonouredBy(value ValueId) returns DeclaredAlias
		let declared = self.declaredAliasOfValue(value)

		if not self.aliasIsUnproven(value) 'aProvenName'
			return declared
		end 'aProvenName'

		if let ranged = try requireDeclaredAlias(declared) 'aRangedName'
			if not aliasIsFloat(ranged) and rangeIsWithinSignedNonNegative(ranged.low, high: ranged.high) 'nameSaysNonNegative'
				return DeclaredAlias.undeclared
			end 'nameSaysNonNegative'
		end 'aRangedName'

		return declared
	end 'declaredAliasHonouredBy'

	// ⭐⭐ **`declaredAliasOfValue` MINUS THE MERGES NOTHING PROVED — the reader for every question that
	// spends the alias as a PROOF, as opposed to reading it as the value's DECLARED type.** The type-name
	// column answers both questions and they are not the same question: for a phi it states the type the merge
	// was declared with, which no incoming edge need satisfy (see `aliasUnprovenMarks`).
	//
	// ⭐ **THE SPLIT IS THE POINT — `declaredAliasOfValue` KEEPS ITS HONEST READERS.**
	// `requireOtherwiseInRangedReturn` asks what a try-result's type IS, to refuse an out-of-range literal
	// fallback against it, and `domainDeclaringAlias` asks the SIGNEDNESS the program wrote, withholding only
	// what `declaredAliasHonouredBy` refuses. Everything that spends
	// the alias as a claim about the VALUE's bounds reads through here: `valueDenotedAlias` (E3010 and the
	// guard-death test), `divisorProof`, and the two STORAGE readers `elementStrideOfValue` /
	// `elementPackingOfValue` — a narrow slot filled from a value nothing proved narrow truncates silently.
	//
	// ⚠ It is consulted only as `valueDenotedAlias`'s FALLBACK, never ahead of `valueDeclaredAlias`: a
	// recorded cast target IS a proof — the `as` emits the guard — so `<phi> as Num` legitimately denotes
	// `Num` afterwards even though the phi alone does not.
	function provenAliasOfValue(value ValueId) returns DeclaredAlias
		if self.aliasIsUnproven(value) 'mergeProvesNothing'
			return DeclaredAlias.undeclared
		end 'mergeProvesNothing'

		return self.declaredAliasOfValue(value)
	end 'provenAliasOfValue'

	// Is `value` wearing a ranged alias nothing proved it satisfies?
	function aliasIsUnproven(value ValueId) returns bool
		return try self.bodyState.aliasUnprovenMarks.get(value) otherwise panic("aliasIsUnproven: v{value} has no alias-proof slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'aliasIsUnproven'

	// ⭐ **THE TYPEALIAS AN OPERAND CARRIES** — a cast's recorded alias if one named this value, else its own
	// `named` type when that names a ranged alias, else `EmptySourceText`. The recorded entry WINS, for
	// `valueDenotedAlias`'s reason: it is the later and more specific statement about the same value.
	//
	// ⛔ **THE ANSWER IS THE NAME AND NOT ITS INTERNER ID, BECAUSE `UnnamedTypeId` IS A REAL ID.** The filler
	// every un-named mint carries is 0 and a `TypeNameInterner` starts empty, so the FIRST name a file
	// interns is indistinguishable from "no name" by id alone. Every other reader escapes that by gating on
	// the TAG first (`declaredAliasOfNameId`'s header states the obligation); a question whose whole answer
	// IS an identity cannot, and spelled in ids this silently read the first typealias in every file as
	// unnamed — so `p + i` over two aliases adopted the right-hand one instead of being refused.
	function operandAliasName(value ValueId) returns immutable ByteArray
		if let recorded = try self.castAliasOf(value) 'aCastNamedIt'
			return self.signatures.rangedIdentityOfSpelling(self.internedName(recorded), readerFilePath: self.job.path)
		end 'aCastNamedIt'

		if self.tagOf(value) == ValueTypeTag.float and self.valueNameId(value) != UnnamedTypeId 'aWornFloatAlias'
			return self.signatures.rangedIdentityOfSpelling(self.internedName(self.valueNameId(value)), readerFilePath: self.job.path)
		end 'aWornFloatAlias'

		if self.tagOf(value) != ValueTypeTag.named 'carriesNoName'
			return EmptySourceText
		end 'carriesNoName'

		return self.signatures.rangedIdentityOfSpelling(self.valueTypeName(value), readerFilePath: self.job.path)
	end 'operandAliasName'

	// ⭐⭐ **THE TYPEALIAS A BINARY OPERATOR'S RESULT WEARS, AND THE REFUSAL WHEN THE TWO OPERANDS DISAGREE.**
	// `a + a2` over `Age` is an `Age`; `a + 1` is an `Age` too, because an operand carrying NO alias adopts
	// the named one; `a + y` over two different aliases is refused, and `as` is the door.
	//
	// ⚠ **ASKED AFTER `requireBinOpOperands`**, so a genuine class mismatch (`3 + true`) keeps its own
	// wording — this rule is about two values that are already both numbers.
	function operandAliasIdentity(lhs ValueId, rhs ValueId, opName String, opTok Token) returns OperandAlias throws SourceParseError
		match self.agreeOperandAliases(self.operandAliasAnswer(lhs), right: self.operandAliasAnswer(rhs)) 'agreement'
			leftDecides then return self.operandAliasOf(lhs)
			rightAdopted then return self.operandAliasOf(rhs)
			common(members, ancestor) then return OperandAlias.mixed(operandAliasSetBrand(members), ancestor: ancestor)
			disjoint then throw self.operandAliasRefusal(opName, left: self.operandAliasOf(lhs).identity, right: self.operandAliasOf(rhs).identity, opTok: opTok)
		end 'agreement'
	end 'operandAliasIdentity'

	function agreeOperandAliases(left ByteArray, right ByteArray) returns OperandAliasAgreement
		if left.equals(right) or right.isEmpty() 'theLeftDecides'
			return OperandAliasAgreement.leftDecides
		end 'theLeftDecides'

		if left.isEmpty() 'theLeftAdoptsTheRight'
			return OperandAliasAgreement.rightAdopted
		end 'theLeftAdoptsTheRight'

		let members = operandAliasSetUnion(left, right: right)
		let ancestor = self.signatures.nearestCommonAliasAncestor(members, readerFilePath: self.job.path)

		if ancestor.isEmpty() 'noCommonAncestor'
			return OperandAliasAgreement.disjoint
		end 'noCommonAncestor'

		return OperandAliasAgreement.common(members, ancestor: ancestor)
	end 'agreeOperandAliases'

	function operandAliasRefusal(opName String, left ByteArray, right ByteArray, opTok Token) returns SourceParseError
		return SourceParseError.operandAliasMismatch(opName, left: self.signatures.aliasIdentityDisplay(left), right: self.signatures.aliasIdentityDisplay(right), line: opTok.line, column: opTok.column)
	end 'operandAliasRefusal'

	function operandAliasOf(value ValueId) returns OperandAlias
		let brand = self.brandOf(value)

		if isOperandAliasSetBrand(brand) 'aMixedExpression'
			return OperandAlias.mixed(brand, ancestor: self.valueTypeName(value))
		end 'aMixedExpression'

		return OperandAlias.named(self.operandAliasName(value))
	end 'operandAliasOf'

	function destinationTemporary(value ValueId, declared MaxonType, anchor Token) returns ValueId throws SourceParseError
		if self.valueIsAPlainConstantArray(value) 'aConstantArrayActsLikeALiteral'
			return try self.plainConstantArrayAs(value, declared: declared, anchor: anchor)
		end 'aConstantArrayActsLikeALiteral'

		let brand = self.brandOf(value)

		if not isOperandAliasSetBrand(brand) 'notAMixedExpression'
			return value
		end 'notAMixedExpression'

		let slot = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: maxonTypeTag(declared), nameId: typeNameIdOf(declared), readerFilePath: self.job.path)

		if slot.equals(aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: self.tagOf(value), nameId: self.valueNameId(value), readerFilePath: self.job.path)) 'alreadyTheDestinationsType'
			self.shedOperandAliasSet(value)
			return value
		end 'alreadyTheDestinationsType'

		if not self.signatures.operandAliasSetFits(brand, slot: slot, readerFilePath: self.job.path) 'noOperandSatisfiesTheDestination'
			return value
		end 'noOperandSatisfiesTheDestination'

		return try self.convertValueToDeclaredType(value, sourceTag: self.tagOf(value), targetType: declared, targetAlias: self.declaredAliasOfType(declared), opTok: anchor, sourceIsBareLocal: false, mustCarryTargetType: true)
	end 'destinationTemporary'

	function operandAliasSetOf(value ValueId) returns immutable ByteArray
		let brand = self.brandOf(value)
		return brand if isOperandAliasSetBrand(brand) else EmptySourceText
	end 'operandAliasSetOf'

	function shedOperandAliasSet(value ValueId)
		if not self.operandAliasSetOf(value).isEmpty() 'aMixedExpression'
			try self.bodyState.valueBrandIds.set(value, value: UnnamedTypeId) otherwise panic("shedOperandAliasSet: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
		end 'aMixedExpression'
	end 'shedOperandAliasSet'

	function admitOperandAliasSetArgs(callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token) throws SourceParseError
		if not self.someArgNeedsItsDestinationsType(args) 'noMixedExpression'
			return
		end 'noMixedExpression'

		let decl = try self.declarationNameableHere(callee) otherwise return
		try self.admitOperandAliasSetArgsTo(decl, args: args, argLabels: argLabels, anchor: anchor)
	end 'admitOperandAliasSetArgs'

	function someArgNeedsItsDestinationsType(args ValueIdArray) returns bool
		for arg in args 'eachArg'
			if not self.operandAliasSetOf(arg).isEmpty() or self.valueIsAPlainConstantArray(arg) 'aValueTheDestinationRetypes'
				return true
			end 'aValueTheDestinationRetypes'
		end 'eachArg'

		return false
	end 'someArgNeedsItsDestinationsType'

	function admitOperandAliasSetArgsTo(decl SweptDeclaration, args ValueIdArray, argLabels NameRoster, anchor Token) throws SourceParseError
		let receiverArgs = 1 if decl.takesReceiver else 0

		for i in receiverArgs upto args.count() 'eachSourceArg'
			let slot = try argSlotPosition(decl.paramNames, argIndex: (i - receiverArgs) as ParamCount, label: callArgumentLabel(argLabels, argIndex: i as ParamCount)) otherwise continue
			let swept = try decl.paramTypes.get(slot) otherwise continue
			let given = try args.get(i) otherwise panic("admitOperandAliasSetArgsTo: args.get OOB at {i}")
			try args.set(i, value: try self.destinationTemporary(given, declared: self.sweptParamType(swept, scopeFilePath: decl.declFilePath), anchor: anchor)) otherwise panic("admitOperandAliasSetArgsTo: args.set OOB at {i}")
		end 'eachSourceArg'
	end 'admitOperandAliasSetArgsTo'

	function operandAliasAnswer(value ValueId) returns immutable ByteArray
		let brand = self.brandOf(value)
		return brand if isOperandAliasSetBrand(brand) else self.operandAliasName(value)
	end 'operandAliasAnswer'

	// ⭐⭐ **STAMP AN ADOPTED TYPEALIAS ONTO A FRESHLY MINTED ARITHMETIC RESULT — as a NAME, never as a
	// PROOF.** The result IS that alias at every coercion door, and the name satisfies nothing: `a + a2`
	// over `Score` may land outside `Score`. What add, sub and mul over known ranges do prove is the
	// interval `adoptBinaryResultAlias` records beside the name. `retypeValue` rather than a re-mint, because the value was minted one line earlier by the emitter that
	// calls this and has no other reader yet.
	//
	// The gate is the INTEGRAL reading of the RESULT, not the operator: a comparison's `boolean` and a
	// `min`'s promoted `float` name no ranged integer to adopt.
	function adoptOperandAlias(result ValueId, alias OperandAlias, resultTag ValueTypeTag)
		if alias.identity.isEmpty() or not (tagIsInteger(resultTag) or tagIsFloat(resultTag)) 'nothingToAdopt'
			return
		end 'nothingToAdopt'

		let aliasId = self.artifact.typeNames.intern(alias.identity)

		if tagIsFloat(resultTag) 'aFloatResult'
			if not self.namedIsFloatAlias(aliasId) 'anIntegerAlias'
				self.wearFullRangeFloat(result)
				return
			end 'anIntegerAlias'

			self.wearFloatAlias(result, aliasId: aliasId)
		end 'aFloatResult' else 'anIntegerResult'
			self.retypeValue(result, valueType: MaxonType.named(aliasId))
		end 'anIntegerResult'

		try self.bodyState.aliasUnprovenMarks.set(result, value: true) otherwise panic("adoptOperandAlias: v{result} has no alias-proof slot — every SSA value must be minted through mintValue, which seeds the column")

		if not alias.brand.isEmpty() 'anOperandSet'
			self.brandValue(result, brand: alias.brand)
		end 'anOperandSet'
	end 'adoptOperandAlias'

	function adoptWhereClosedElseBound(result ValueId, alias OperandAlias, resultTag ValueTypeTag, bounds Interval)
		if alias.identity.isEmpty() or not tagIsInteger(resultTag) 'nothingToClose'
			self.adoptOperandAlias(result, alias: alias, resultTag: resultTag)
			return
		end 'nothingToClose'

		if let ranged = try requireDeclaredAlias(self.castAliasNamedBy(self.artifact.typeNames.intern(alias.identity))) 'aRangedOperand'
			if not aliasIsFloat(ranged) and not aliasIsClosedUnderWordArithmetic(ranged) and not rangeCoversIntBounds(ranged, low: bounds.lo, high: bounds.hi) 'resultLeavesTheAlias'
				self.recordResultInterval(result, low: bounds.lo, high: bounds.hi, provenance: IntervalProvenance.operandRanges)
				return
			end 'resultLeavesTheAlias'
		end 'aRangedOperand'

		self.adoptOperandAlias(result, alias: alias, resultTag: resultTag)
	end 'adoptWhereClosedElseBound'

	function adoptUnaryResultAlias(result ValueId, operand ValueId, op MaxonUnaryOp, resultTag ValueTypeTag)
		let alias = OperandAlias.named(self.operandAliasName(operand))
		let bounds = try self.unaryResultInterval(op, operand: operand) otherwise Interval.create()
		self.adoptWhereClosedElseBound(result, alias: alias, resultTag: resultTag, bounds: bounds)
	end 'adoptUnaryResultAlias'

	function adoptBinaryResultAlias(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, alias OperandAlias, resultTag ValueTypeTag)
		if op == MaxonBinOp.bitOr or op == MaxonBinOp.bitXor 'aWordCombination'
			let bounds = try self.operandPairInterval(op, lhs: lhs, rhs: rhs) otherwise Interval.create()
			self.adoptWhereClosedElseBound(result, alias: alias, resultTag: resultTag, bounds: bounds)
			return
		end 'aWordCombination'

		self.adoptOperandAlias(result, alias: alias, resultTag: resultTag)

		if tagIsInteger(resultTag) and (op == MaxonBinOp.add or op == MaxonBinOp.sub or op == MaxonBinOp.mul) 'anIntervalArithmetic'
			let bounds = try self.operandPairInterval(op, lhs: lhs, rhs: rhs) otherwise return
			self.recordResultInterval(result, low: bounds.lo, high: bounds.hi, provenance: IntervalProvenance.operandRanges)
		end 'anIntervalArithmetic'
	end 'adoptBinaryResultAlias'

	function recordResultInterval(result ValueId, low FullRangeInt, high FullRangeInt, provenance IntervalProvenance)
		if low == i64.min and high == i64.max 'saysNothing'
			return
		end 'saysNothing'

		match provenance 'provenance'
			operandRanges then self.recordProvenIntRange(result, low: low, high: high)
			literalCounters then self.markLiteralInterval(result, low: low, high: high)
		end 'provenance'
	end 'recordResultInterval'

	function unaryResultInterval(op MaxonUnaryOp, operand ValueId) returns Interval throws AbsentError
		let origin = Interval.create()

		if op == MaxonUnaryOp.neg 'negation'
			origin.setBounds(0, high: 0)
		end 'negation' else if op == MaxonUnaryOp.bitNot 'complement'
			origin.setBounds(-1, high: -1)
		end 'complement' else 'unmodelled'
			throw AbsentError.absent
		end 'unmodelled'

		return try binOpBounds(MaxonBinOp.sub, left: origin, right: try self.operandIntervalOf(operand))
	end 'unaryResultInterval'

	function operandPairInterval(op MaxonBinOp, lhs ValueId, rhs ValueId) returns Interval throws AbsentError
		return try binOpBounds(op, left: try self.operandIntervalOf(lhs), right: try self.operandIntervalOf(rhs))
	end 'operandPairInterval'

	function operandIntervalOf(value ValueId) returns Interval throws AbsentError
		if let constant = try self.constantIntervalOf(value) 'aKnownConstant'
			return constant
		end 'aKnownConstant'

		if let proven = try self.provenIntervalOf(value) 'aProvenInterval'
			return proven
		end 'aProvenInterval'

		let ranged = try requireDeclaredAlias(self.valueDenotedAlias(value)) otherwise throw AbsentError.absent

		if aliasIsFloat(ranged) or rangeIsUnsignedTopped(ranged.low, high: ranged.high) 'notASignedInterval'
			throw AbsentError.absent
		end 'notASignedInterval'

		let interval = Interval.create()
		interval.setBounds(ranged.low, high: ranged.high)
		return interval
	end 'operandIntervalOf'

	// ⭐⭐ **RECORD AN INTERVAL A VALUE IS PROVEN TO LIE IN** — see `ProvenIntRange` for what an interval
	// nothing NAMES may and may not decide, and `mintCountedBodyCounter` for why a counter's interval is
	// recorded against the BODY's block-arg rather than the loop header's phi.
	function recordProvenIntRange(value ValueId, low FullRangeInt, high FullRangeInt)
		// The column is installed on the first interval, exactly as `recordValueDeclaredAliasName`'s is and
		// for its reason: a function that proves no interval never allocates one.
		let proven = self.countedValueRangesForWrite()
		proven.upsert(value, value: ProvenIntRange.create(low, high: high))
	end 'recordProvenIntRange'

	// ⭐⭐ **A COMPILER-MINTED MACHINE WORD IS PROVEN OVER `[0, 2^64-1]` AS A NAMELESS INTERVAL, NEVER BY
	// RESOLVING `MachineWord` BY NAME — AND THE DIFFERENCE IS A FORGEABLE PROOF.** The by-name alias
	// registry falls through to LAST-WINS across the whole program (`Project.maxon`'s tier note), and
	// `fileMayUseReservedNames` admits a staged `.maxtest` file into the reserved space, so a file
	// declaring `typealias MachineWord = int(0 to 10)` would hand this door a range it never meant and
	// delete a real guard from code that never saw that file. An interval names nothing and nothing can
	// contest it.
	//
	// ⚠ It is also INVISIBLE to `integerValueDomain`, which is a feature and not a limitation: nothing
	// downstream decides a divide's or a comparison's signedness off it, so a proof recorded here can
	// only ever elide a guard that could not have fired — never change what the arithmetic computes.
	function recordWholeMachineWordRange(value ValueId)
		self.recordProvenIntRange(value, low: 0, high: UnsignedFullUpperPattern)
	end 'recordWholeMachineWordRange'

	function recordDeclaredAliasRange(value ValueId, alias RangedTypeAlias)
		if aliasIsFloat(alias) 'aFloatAlias'
			return
		end 'aFloatAlias'

		self.recordProvenIntRange(value, low: alias.low, high: alias.high)
	end 'recordDeclaredAliasRange'

	// ⭐ **DOES THE INTERVAL RECORDED FOR `value` LIE INSIDE `target`?** The map probe and the one
	// containment, spelled here so the joiner below reads as the two sentences it is. A function that
	// proves no interval answers off the unwritten column and allocates nothing.
	function countedRangeCovers(value ValueId, target RangedTypeAlias) returns bool
		let proven = try provenIntRangeOf(self.bodyState.countedValueRanges, value: value) otherwise return false
		return rangeCoversIntBounds(target, low: proven.low, high: proven.high)
	end 'countedRangeCovers'

	// ⭐⭐ **IS `value` PROVABLY INSIDE `target`? — THE WHOLE OF EVERY RUNTIME GUARD'S DEATH TEST, AND THE
	// ONE PLACE THE TWO KINDS OF PROOF ARE JOINED FOR A GUARD.** A value proves its range two ways and only two: it
	// DENOTES a declared alias whose range the destination covers (the induction
	// `rangeCoversDenotedRange`'s header states), or an interval nothing names was recorded for it
	// (`recordProvenIntRange`). Both answers mean the same thing to a guard — the compare cannot fail — so they are
	// joined once, and no door reaches a verdict of its own. The proofs that decide whether a divide or a
	// `FixedArray` accessor can fail join the same two facts in `knownValueOf`.
	//
	// ⚠⚠ **THE JOIN IS DELIBERATELY NOT MADE INSIDE `valueDenotedAlias`, AND THE LINE IS: A NAMELESS
	// INTERVAL IS NOT A DECLARED TYPE.** Two of that function's readers ask about the type
	// the program WROTE, not about the bounds a value happens to satisfy, and each would answer a DIFFERENT
	// question if an interval were folded in:
	//
	//   • **E3010** (`reportUnneededCastBetween`) QUOTES both alias names — *"unneeded cast: 'A' already
	//     fits in 'B'"* — and its own rule is that it *"fires only when BOTH ends are DECLARED ranged
	//     typealiases"*. An interval has no name to print and no declaration to have repeated, and
	//     firing here would REFUSE a legal program.
	//   • **`edgeProvesAlias`** does not spend the proof — it LIFTS a merge's withheld alias claim
	//     (`recordMergeAliasProof`), which republishes that merge's DECLARED name to every reader including
	//     the one above. An interval may not put a name into circulation that no edge declared.
	//
	// `shiftCountIsProvenUnguarded` asks the SAME kind of question — can a runtime guard fire? — and joins
	// the same two facts against the counts a shift takes as written rather than against an alias.
	// `emitPrimitiveClone` is outside this joiner: a receiver that denotes no ALIAS is handed back
	// untouched, and an interval gives it no alias to shed.
	//
	// ⛔ **EACH WITHHOLD IS PINNED BY A CASE THAT GOES RED IF IT IS UNDONE**, because a rule this file merely
	// asserts is one nothing checks (`specs/range-check-panic.md`):
	// `a-counted-loop-counter-proves-a-cast` stops COMPILING if E3010 reads the interval, and
	// `a-merge-fed-by-a-counted-loop-denotes-no-alias` stops compiling if
	// `edgeProvesAlias` does (the merge's declared name comes back into circulation and its `as` is E3010).
	function valueIsProvablyInRange(value ValueId, target RangedTypeAlias) returns bool
		return rangeCoversDenotedRange(target, source: self.valueDenotedAlias(value)) or self.countedRangeCovers(value, target: target) or self.unsignedSourceFillsUnsignedQuantity(value, target: target)
	end 'valueIsProvablyInRange'

	function unsignedSourceFillsUnsignedQuantity(value ValueId, target RangedTypeAlias) returns bool
		if not aliasIsUnsignedFullQuantity(target) 'targetHasNoSignFloorOnly'
			return false
		end 'targetHasNoSignFloorOnly'

		return self.valueFillsAnUnsignedQuantity(value)
	end 'unsignedSourceFillsUnsignedQuantity'

	function valueIsNonNegativeSource(value ValueId) returns bool
		if self.valueCarriesAnUnsignedPattern(value) 'anUnsignedPattern'
			return true
		end 'anUnsignedPattern'

		if self.constIsKnown(value) and self.constOf(value) >= 0 'aNonNegativeConstant'
			return true
		end 'aNonNegativeConstant'

		return self.valueDeclaresUnsigned(value) and self.declaredDomainStandsBehindADoor(value)
	end 'valueIsNonNegativeSource'

	function declaredDomainStandsBehindADoor(value ValueId) returns bool
		return not self.aliasIsUnproven(value) or valueIsMarked(self.bodyState.boundedCounters, value: value)
	end 'declaredDomainStandsBehindADoor'

	function valueFillsAnUnsignedQuantity(value ValueId) returns bool
		return self.valueIsNonNegativeSource(value) or (self.valueDeclaresUnsigned(value) and self.valueRecordsACastAlias(value))
	end 'valueFillsAnUnsignedQuantity'

	function valueRecordsACastAlias(value ValueId) returns bool
		return match self.bodyState.valueDeclaredAlias 'column'
			unwritten gives false
			entries(recorded) gives recorded.contains(value)
		end 'column'
	end 'valueRecordsACastAlias'

	function valueCarriesAnUnsignedPattern(value ValueId) returns bool
		return valueIsMarkedUnsigned(value, literals: self.bodyState.unsignedMaxLiterals, patterns: self.bodyState.unsignedPatternValues)
	end 'valueCarriesAnUnsignedPattern'

	function valueDeclaresUnsigned(value ValueId) returns bool
		return match self.domainDeclaringAlias(value) 'source'
			undeclared gives false
			declared(source) gives not aliasIsFloat(source) and rangeIsUnsigned(source.low)
		end 'source'
	end 'valueDeclaresUnsigned'

	function markUnsignedArithmeticResult(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp)
		if not self.arithmeticStaysUnsigned(lhs, rhs: rhs, op: op) 'mayGoNegative'
			return
		end 'mayGoNegative'

		self.markUnsignedPattern(result)
	end 'markUnsignedArithmeticResult'

	function markUnsignedPattern(value ValueId)
		self.bodyState.unsignedPatternValues = withValueMarked(self.bodyState.unsignedPatternValues, value: value)
	end 'markUnsignedPattern'

	function arithmeticStaysUnsigned(lhs ValueId, rhs ValueId, op MaxonBinOp) returns bool
		if not self.resultDomainOperandsAreUnsigned(lhs, rhs: rhs, op: op) 'signedArithmetic'
			return false
		end 'signedArithmetic'

		if binOpKeepsUnsignedOperandsUnsigned(op) 'closedOverUnsigned'
			return true
		end 'closedOverUnsigned'

		return op == MaxonBinOp.sub and self.constIsKnown(lhs) and self.constIsKnown(rhs) and not unsignedArithmeticWraps(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs))
	end 'arithmeticStaysUnsigned'

	function resultDomainOperandsAreUnsigned(lhs ValueId, rhs ValueId, op MaxonBinOp) returns bool
		if shiftOperator(op) 'theCountIsNotAValueOfTheResultsType'
			return self.soleOperandIsInTheUnsignedDomain(lhs)
		end 'theCountIsNotAValueOfTheResultsType'

		return self.operandsAreInTheUnsignedDomain(lhs, rhs: rhs)
	end 'resultDomainOperandsAreUnsigned'

	function soleOperandIsInTheUnsignedDomain(value ValueId) returns bool
		return self.valueIsNonNegativeSource(value) and self.valueIsInTheUnsignedDomain(value)
	end 'soleOperandIsInTheUnsignedDomain'

	function operandsAreInTheUnsignedDomain(lhs ValueId, rhs ValueId) returns bool
		if not (self.valueIsNonNegativeSource(lhs) and self.valueIsNonNegativeSource(rhs)) 'aSignedOperand'
			return false
		end 'aSignedOperand'

		return self.valueIsInTheUnsignedDomain(lhs) or self.valueIsInTheUnsignedDomain(rhs)
	end 'operandsAreInTheUnsignedDomain'

	function guardUnsignedArithmetic(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, alias OperandAlias, resultTag ValueTypeTag, opTok Token, borrowRuledOut bool)
		if not tagIsInteger(resultTag) or not binOpCanLeaveUnsignedRange(op) 'nothingToGuard'
			return
		end 'nothingToGuard'

		let ranged = try self.fullWidthAliasOf(alias) otherwise return

		if self.operandsAreFoldedUnsigned(lhs, rhs: rhs) and unsignedArithmeticWraps(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs)) 'aFoldedWrap'
			self.recordResolvedRangeCheckSite(result, target: RangeCheckSiteTarget.foldedArithmetic(ranged.clone(), lhs: self.constOf(lhs), rhs: self.constOf(rhs), op: op), line: opTok.line, column: opTok.column)
			return
		end 'aFoldedWrap'

		if self.unsignedArithmeticIsProvablyInRange(result, lhs: lhs, rhs: rhs, op: op, target: ranged, borrowRuledOut: borrowRuledOut) 'provablyInRange'
			return
		end 'provablyInRange'

		self.recordWrapOperands(result, lhs: lhs, rhs: rhs, op: op)
		self.recordResolvedRangeCheckSite(result, target: RangeCheckSiteTarget.arithmetic(ranged.clone()), line: opTok.line, column: opTok.column)
		self.markUnsignedPattern(result)
	end 'guardUnsignedArithmetic'

	function namesAFullWidthAlias(alias OperandAlias) returns bool
		_ = try self.fullWidthAliasOf(alias) otherwise return false
		return true
	end 'namesAFullWidthAlias'

	function fullWidthAliasOf(alias OperandAlias) returns RangedTypeAlias throws AbsentError
		if alias.identity.isEmpty() 'unnamed'
			throw AbsentError.absent
		end 'unnamed'

		let ranged = try requireDeclaredAlias(self.castAliasNamedBy(self.artifact.typeNames.intern(alias.identity))) otherwise throw AbsentError.absent

		if not aliasChecksItsArithmetic(ranged) 'notFullWidth'
			throw AbsentError.absent
		end 'notFullWidth'

		return ranged
	end 'fullWidthAliasOf'

	function unsignedArithmeticIsProvablyInRange(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp, target RangedTypeAlias, borrowRuledOut bool) returns bool
		if self.arithmeticHasANeutralOperand(lhs, rhs: rhs, op: op) 'anIdentity'
			return true
		end 'anIdentity'

		if self.operandsAreFoldedUnsigned(lhs, rhs: rhs) 'foldedUnsigned'
			return not unsignedArithmeticWraps(op, lhs: self.constOf(lhs), rhs: self.constOf(rhs))
		end 'foldedUnsigned'

		return self.countedRangeCovers(result, target: target) or self.dominatingOrderKeepsInRange(lhs, rhs: rhs, op: op, borrowRuledOut: borrowRuledOut)
	end 'unsignedArithmeticIsProvablyInRange'

	function settleRunTimeBorrow(result ValueId, lhs ValueId, rhs ValueId) returns bool
		if self.differenceIsAboveADominatingFloor(lhs, subtrahend: rhs) 'cannotBorrow'
			self.markUnsignedPattern(result)
			return true
		end 'cannotBorrow'

		self.recordWrapOperands(result, lhs: lhs, rhs: rhs, op: MaxonBinOp.sub)
		return false
	end 'settleRunTimeBorrow'

	function dominatingOrderKeepsInRange(lhs ValueId, rhs ValueId, op MaxonBinOp, borrowRuledOut bool) returns bool
		return match op 'op'
			add gives self.sumIsBelowADominatingBound(lhs, addend: rhs) or self.sumIsBelowADominatingBound(rhs, addend: lhs)
			sub gives borrowRuledOut
			mul gives false
			default panic("dominatingOrderKeepsInRange: '{op.rawValue}' is not an operator that can leave an unsigned range")
		end 'op'
	end 'dominatingOrderKeepsInRange'

	function differenceIsAboveADominatingFloor(minuend ValueId, subtrahend ValueId) returns bool
		if minuend == subtrahend 'theSameValue'
			return true
		end 'theSameValue'

		if self.bodyState.orderFacts.holds(subtrahend, high: minuend) 'anOrderBetweenThem'
			return true
		end 'anOrderBetweenThem'

		if not self.constIsKnown(subtrahend) 'notAConstantSubtrahend'
			return false
		end 'notAConstantSubtrahend'

		return match self.bodyState.orderFacts.floorOf(minuend) 'floor'
			unknown gives false
			known(floor) gives foldUnsignedIntCompare(MaxonCmpOp.ge, lhs: floor, rhs: self.constOf(subtrahend)) == BoolTrueValue
		end 'floor'
	end 'differenceIsAboveADominatingFloor'

	function sumIsBelowADominatingBound(operand ValueId, addend ValueId) returns bool
		if not self.constIsKnown(addend) 'noConstantAddend'
			return false
		end 'noConstantAddend'

		return match self.bodyState.orderFacts.ceilingOf(operand) 'ceiling'
			unknown gives false
			known(ceiling) gives not unsignedArithmeticWraps(MaxonBinOp.add, lhs: ceiling, rhs: self.constOf(addend))
		end 'ceiling'
	end 'sumIsBelowADominatingBound'

	function constantBoundOf(value ValueId) returns ConstantBound
		if not self.constIsKnown(value) 'notConstant'
			return ConstantBound.unknown
		end 'notConstant'

		return ConstantBound.known(self.constOf(value))
	end 'constantBoundOf'

	function assumeOrders(facts OrderFactArray) returns ElementIndex
		let floor = self.bodyState.orderFacts.height()

		for fact in facts 'eachFact'
			self.bodyState.orderFacts.assume(fact, lowConstant: self.constantBoundOf(fact.low), highConstant: self.constantBoundOf(fact.high))
		end 'eachFact'

		return floor
	end 'assumeOrders'

	function recordComparisonOrders(result ValueId, lhs ValueId, rhs ValueId, op MaxonCmpOp, signedness IntegerSignedness)
		if comparisonReadsOrdering(op) 'anOrdering'
			if signedness == IntegerSignedness.unsigned 'readUnsigned'
				self.recordConditionOrders(result, orders: ConditionOrders.ordered(lhs, rhs: rhs, op: op))
			end 'readUnsigned'

			return
		end 'anOrdering'

		self.recordZeroTestOrders(result, lhs: lhs, rhs: rhs, op: op)
	end 'recordComparisonOrders'

	function recordZeroTestOrders(result ValueId, lhs ValueId, rhs ValueId, op MaxonCmpOp)
		if self.valueIsConstant(rhs, equalTo: 0) and self.valueDeclaresUnsigned(lhs) 'subjectOnTheLeft'
			self.recordConditionOrders(result, orders: ConditionOrders.differing(rhs, subject: lhs, op: op))
		end 'subjectOnTheLeft' else if self.valueIsConstant(lhs, equalTo: 0) and self.valueDeclaresUnsigned(rhs) 'subjectOnTheRight'
			self.recordConditionOrders(result, orders: ConditionOrders.differing(lhs, subject: rhs, op: op))
		end 'subjectOnTheRight'
	end 'recordZeroTestOrders'

	function recordConditionOrders(value ValueId, orders ConditionOrders)
		self.bodyState.lastCondition = ConditionOrdersSlot.recorded(value, orders: orders)
	end 'recordConditionOrders'

	function conditionOrdersOf(value ValueId) returns ConditionOrders
		match self.bodyState.lastCondition 'slot'
			none then return ConditionOrders.neutral()
			recorded(held, orders) then return orders if held == value else ConditionOrders.neutral()
		end 'slot'
	end 'conditionOrdersOf'

	function negateConditionOrders(operand ValueId, result ValueId)
		let orders = self.conditionOrdersOf(operand)

		if not orders.holdsNothing() 'somethingToNegate'
			self.recordConditionOrders(result, orders: orders.negated())
		end 'somethingToNegate'
	end 'negateConditionOrders'

	function assumeOrdersOfTheSurvivingArm(orders ConditionOrders, thenLeaves bool, elseLeaves bool)
		if thenLeaves and not elseLeaves 'onlyTheElseContinues'
			_ = self.assumeOrders(orders.whenFalse)
		end 'onlyTheElseContinues' else if elseLeaves and not thenLeaves 'onlyTheThenContinues'
			_ = self.assumeOrders(orders.whenTrue)
		end 'onlyTheThenContinues'
	end 'assumeOrdersOfTheSurvivingArm'

	function operandsAreFoldedUnsigned(lhs ValueId, rhs ValueId) returns bool
		return self.constIsKnown(lhs) and self.constIsKnown(rhs) and self.operandsAreInTheUnsignedDomain(lhs, rhs: rhs)
	end 'operandsAreFoldedUnsigned'

	function arithmeticHasANeutralOperand(lhs ValueId, rhs ValueId, op MaxonBinOp) returns bool
		return match op 'op'
			add gives self.valueIsConstant(lhs, equalTo: 0) or self.valueIsConstant(rhs, equalTo: 0)
			sub gives self.valueIsConstant(rhs, equalTo: 0)
			mul gives self.valueIsConstant(lhs, equalTo: 0) or self.valueIsConstant(rhs, equalTo: 0) or self.valueIsConstant(lhs, equalTo: 1) or self.valueIsConstant(rhs, equalTo: 1)
			default panic("arithmeticHasANeutralOperand: '{op.rawValue}' is not an operator that can leave an unsigned range")
		end 'op'
	end 'arithmeticHasANeutralOperand'

	function valueIsConstant(value ValueId, equalTo FullRangeInt) returns bool
		return self.constIsKnown(value) and self.constOf(value) == equalTo
	end 'valueIsConstant'

	function recordWrapOperands(result ValueId, lhs ValueId, rhs ValueId, op MaxonBinOp)
		let recorded = self.wrapOperandsForWrite()
		recorded.upsert(result, value: WrapOperands.create(lhs, rhs: rhs, op: op))
	end 'recordWrapOperands'

	function wrapOperandsForWrite() returns WrapOperandsMap
		match self.bodyState.wrapOperands 'state'
			unwritten then break
			entries(byResult) then return byResult
		end 'state'

		let fresh = WrapOperandsMap.create()
		self.bodyState.wrapOperands = WrapOperandsColumn.entries(fresh)
		return fresh
	end 'wrapOperandsForWrite'

	function valueIsInTheUnsignedDomain(value ValueId) returns bool
		return self.valueCarriesAnUnsignedPattern(value) or self.valueDeclaresUnsigned(value)
	end 'valueIsInTheUnsignedDomain'

	// The brand `value` wears (`WrapperA`, `Xs`), or `EmptySourceText` when it has none — a `self` receiver,
	// a literal, a merge of unbranded arms, or any non-instance value. `UnnamedTypeId` IS the empty name.
	function brandOf(value ValueId) returns immutable ByteArray
		return self.internedName(self.brandIdOf(value))
	end 'brandOf'

	function brandIdOf(value ValueId) returns TypeNameId
		return try self.bodyState.valueBrandIds.get(value) otherwise panic("brandIdOf: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
	end 'brandIdOf'

	function typeSpellingAt(start ElementIndex) returns immutable ByteArray
		let spelled = StringBuilder.create()
		var depth = 0 as TypeSpellingDepth
		var previous = TokenKind.newline
		var q = start

		while not self.typeSpellingEndsAt(q, depth: depth, first: start) 'eachToken'
			let kind = self.kindAt(q)

			if kind == TokenKind.leftParen 'opens'
				depth = depth + 1
			end 'opens' else if kind == TokenKind.rightParen 'closes'
				depth = depth - 1
			end 'closes'

			if typeSpellingSeparates(previous, next: kind, previousIsWord: q > start and not self.tokenAt(q - 1).value.isEmpty(), nextIsWord: not self.tokenAt(q).value.isEmpty()) 'aSpace'
				spelled.append(" ")
			end 'aSpace'

			spelled.append(tokenDisplayText(self.tokenAt(q)))
			previous = kind
			q = q + 1
		end 'eachToken'

		return freeze spelled.build().toByteArray()
	end 'typeSpellingAt'

	function writtenSignatureTypeNames(audited bool, paramNames NameRoster, paramTypeStarts TokenIndexArray, returnTypeStart ElementIndex, hasReturnType bool, ownTypeParams NameRoster) returns WrittenTypeNames
		if not audited or self.isLibrarySource() 'aSignatureNoAuthorAudits'
			return WrittenTypeNames.none()
		end 'aSignatureNoAuthorAudits'

		let names = NameRoster.create(0)
		let ends = WrittenTypeNameEnds.create(paramNames.count() + 1, zeroed: false)

		for position in 0 upto paramNames.count() 'eachParam'
			if not (try paramNames.get(position) otherwise panic("writtenSignatureTypeNames: paramNames.get OOB at {position} inside its own `upto` bound")).equals(SelfParamName) 'aWrittenParameterType'
				self.appendWrittenTypeNamesAt(paramTypeStartAt(paramTypeStarts, position: position), ownTypeParams: ownTypeParams, into: names)
			end 'aWrittenParameterType'

			ends.push(names.count())
		end 'eachParam'

		if hasReturnType 'aReturnClause'
			self.appendWrittenTypeNamesAt(returnTypeStart, ownTypeParams: ownTypeParams, into: names)
		end 'aReturnClause'

		ends.push(names.count())
		return WrittenTypeNames.create(names, ends: ends)
	end 'writtenSignatureTypeNames'

	function appendWrittenTypeNamesAt(start ElementIndex, ownTypeParams NameRoster, into NameRoster)
		var depth = 0 as TypeSpellingDepth
		var rangeDepth = 0 as TypeSpellingDepth
		var q = start

		while not self.typeSpellingEndsAt(q, depth: depth, first: start) 'eachToken'
			let kind = self.kindAt(q)

			if kind == TokenKind.leftParen 'opens'
				depth = depth + 1

				if rangeDepth == 0 and q > start and keywordIsARangedPrimitive(self.tokenAt(q - 1)) 'aRangesBounds'
					rangeDepth = depth
				end 'aRangesBounds'
			end 'opens' else if kind == TokenKind.rightParen 'closes'
				if depth == rangeDepth 'theRangeCloses'
					rangeDepth = 0
				end 'theRangeCloses'

				depth = depth - 1
			end 'closes'

			if kind != TokenKind.identifier or rangeDepth != 0 'notAWrittenTypeName'
				q = q + 1
				continue
			end 'notAWrittenTypeName'

			let dots = self.dottedChainLengthAt(q)

			if dots > 0 'aQualifiedName'
				into.push(self.assembleDottedChainAt(q, dots: dots))
			end 'aQualifiedName' else 'aBareName'
				self.appendBareTypeName(self.tokenAt(q).value, ownTypeParams: ownTypeParams, into: into)
			end 'aBareName'

			q = q + dots * TokensPerQualifierSegment + 1
		end 'eachToken'
	end 'appendWrittenTypeNamesAt'

	function appendBareTypeName(name ByteArray, ownTypeParams NameRoster, into NameRoster)
		if self.enclosingTypeParams.contains(name) or ownTypeParams.contains(name) 'aTypeParameterInScope'
			return
		end 'aTypeParameterInScope'

		into.push(self.innerAliasKeyOrName(name))
	end 'appendBareTypeName'

	function typeSpellingEndsAt(q ElementIndex, depth TypeSpellingDepth, first ElementIndex) returns bool
		let kind = self.kindAt(q)

		if tokenKindEndsALine(kind) 'endOfLine'
			return true
		end 'endOfLine'

		if depth > 0 'insideAGroup'
			return false
		end 'insideAGroup'

		if kind == TokenKind.returns 'aReturnsKeyword'
			return self.kindAt(first) != TokenKind.function
		end 'aReturnsKeyword'

		return kind == TokenKind.comma or kind == TokenKind.rightParen or kind == TokenKind.equals or kind == TokenKind.throws or kind == TokenKind.charLiteral or kind == TokenKind.gives or kind == TokenKind.where
	end 'typeSpellingEndsAt'

	// The bare identifier a type position was written as, or `unnamed` when it was spelled any other
	// way — a primitive keyword, an inline instance (`Array with Integer`), a dotted name. A spelling is read at the
	// declaration and judged by its reader (`declaredBrand`), because the sweep that records a field or a
	// payload runs before the alias registry can say what the name denotes.
	function spelledTypeNameAt(index ElementIndex) returns SpelledFieldName
		if self.kindAt(index) != TokenKind.identifier or self.typeSpellingContinuesPast(index) 'notABareName'
			return SpelledFieldName.unnamed
		end 'notABareName'

		return SpelledFieldName.named(self.tokenAt(index).value)
	end 'spelledTypeNameAt'

	function writtenTypeNameAt(index ElementIndex) returns SpelledFieldName
		let bare = self.spelledTypeNameAt(index)

		match bare 'bare'
			named then return bare
			unnamed then return self.spelledQualifiedNameAt(index)
		end 'bare'
	end 'writtenTypeNameAt'

	function spelledQualifiedNameAt(index ElementIndex) returns SpelledFieldName
		let dots = self.dottedChainLengthAt(index)
		let last = index + dots * TokensPerQualifierSegment

		if dots == 0 or self.kindAt(last) != TokenKind.identifier or self.typeSpellingContinuesPast(last) 'notAQualifiedName'
			return SpelledFieldName.unnamed
		end 'notAQualifiedName'

		return SpelledFieldName.named(self.assembleDottedChainAt(index, dots: dots))
	end 'spelledQualifiedNameAt'

	function typeSpellingContinuesPast(nameAt ElementIndex) returns bool
		let next = self.kindAt(nameAt + 1)
		return next == TokenKind.with or next == TokenKind.dot
	end 'typeSpellingContinuesPast'

	// The brand a place declared as `spelled` confers on a value of the `resolved` type: the spelling when it
	// names a file-scope generic alias and the type is an instance, else nothing. A ranged alias's spelling is
	// an IDENTITY (`ProgramSignatures.namedIdentityOf`), not a brand, and a primitive brands nothing.
	function declaredBrand(spelled ByteArray, resolved MaxonType, readerFilePath FilePath) returns immutable ByteArray
		if maxonTypeTag(resolved) != ValueTypeTag.genericInstance 'notAnInstance'
			return EmptySourceText
		end 'notAnInstance'

		return self.brandOfSpelling(spelled, readerFilePath: readerFilePath)
	end 'declaredBrand'

	function fieldPlaceBrand(layout StructLayout, index FieldIndex, resolved MaxonType) returns immutable ByteArray
		return self.declaredBrand(layout.fieldDeclaredBrand(index), resolved: resolved, readerFilePath: layout.declFilePath)
	end 'fieldPlaceBrand'

	function payloadPlaceBrand(field PayloadField, layout EnumLayout, resolved MaxonType) returns immutable ByteArray
		return self.declaredBrand(field.declaredBrand, resolved: resolved, readerFilePath: layout.declFilePath)
	end 'payloadPlaceBrand'

	function declaredParamSpelling(paramTypeStarts TokenIndexArray, position ElementIndex, resolved MaxonType) returns immutable ByteArray
		let brand = self.declaredBrandAt(paramTypeStartAt(paramTypeStarts, position: position), resolved: resolved)

		if not brand.isEmpty() 'aBrandedParameter'
			return brand
		end 'aBrandedParameter'

		if self.isLibrarySource() 'aLibraryFilesOwnSpelling'
			return EmptySourceText
		end 'aLibraryFilesOwnSpelling'

		match self.writtenTypeNameAt(paramTypeStartAt(paramTypeStarts, position: position)) 'spelling'
			named(name) then return name if isCompilerReservedName(name) else EmptySourceText
			unnamed then return EmptySourceText
		end 'spelling'
	end 'declaredParamSpelling'

	function declaredBrandAt(typeStart ElementIndex, resolved MaxonType) returns immutable ByteArray
		if maxonTypeTag(resolved) != ValueTypeTag.genericInstance 'notAnInstance'
			return EmptySourceText
		end 'notAnInstance'

		match self.writtenTypeNameAt(typeStart) 'spelling'
			named(name) then return self.declaredBrand(name, resolved: resolved, readerFilePath: self.job.path)
			unnamed then return EmptySourceText
		end 'spelling'
	end 'declaredBrandAt'

	function returnBrandOf(returnType MaxonReturnType, returnTypeStart ElementIndex) returns immutable ByteArray
		return match returnType 'r'
			void gives EmptySourceText
			value(inner) gives self.declaredBrandAt(returnTypeStart, resolved: inner)
		end 'r'
	end 'returnBrandOf'

	// ⭐⭐ **A BRAND IS A FILE-SCOPE GENERIC ALIAS, AND AN INNER ALIAS BRANDS NOTHING.** `typealias Xs = Array
	// with Integer` at file scope names a type an author can write at every door — a parameter, a cast target,
	// a field. An alias declared INSIDE a type body (`typealias EManagedList = __ManagedList with Element`, in
	// `List` and again in `ListIterator`) is a spelling of the shared body's instantiation over that type's
	// own parameters, so two types' spellings of one instance would be two types with no door between them
	// if either branded. The body's bare spelling is refused here and the qualified one (`List.EManagedList`)
	// by `instanceBrandOfSpelling`.
	//
	// Two file-scope declarations of one name over ONE instance are two types, so each declaration's mint
	// brands (`genericAliasMintIsABrand`).
	//
	// `readerFilePath` is the file that wrote `spelled`: for a stored field or payload, its declaring file.
	// One spelling names a different alias in another file (an unexported `Numbers`, a qualified
	// `alpha.Numbers`), so resolved in the reading file it would brand the value with the reader's alias.
	function brandOfSpelling(spelled immutable ByteArray, readerFilePath FilePath) returns immutable ByteArray
		if self.signatures.genericAliasMintIsABrand(spelled) 'aDeclarationsOwnMint'
			return spelled
		end 'aDeclarationsOwnMint'

		if self.namesInnerAliasHere(spelled) 'anInnerAliasBrandsNothing'
			return EmptySourceText
		end 'anInnerAliasBrandsNothing'

		return self.signatures.authorsAliasBrand(spelled, readerFilePath: readerFilePath)
	end 'brandOfSpelling'

	// The brand an ELEMENT read out of instance `giid` wears — the alias the instantiation spelled its one
	// type argument with (`Rows = Array with Row` yields `Row`s). A base with several arguments (`Map`)
	// answers nothing: which argument an element is would be a per-base fact this door does not hold.
	function elementBrandOf(giid GenericInstanceId) returns immutable ByteArray
		if self.signatures.genericInstanceArgCount(giid) != 1 'noSingleElementPosition'
			return EmptySourceText
		end 'noSingleElementPosition'

		return self.signatures.instanceArgBrand(giid, position: ContainerElementArgPosition)
	end 'elementBrandOf'

	// ⭐ **RECORD A FUNCTION VALUE MEETING A FUNCTION-TYPED PLACE — the FUNCTION twin of the nominal
	// `aggregatesConflict` identity check every door beside this one already makes.** A `structRef` and a
	// `function` are both aggregates the tag check reads as one type: two different structs share
	// `structRef`, and two different function TYPES share `function`. The struct half is decided in place,
	// because a struct's identity is its name and the parser holds both names. The function half cannot be:
	// a function value's own shape is its parameter list, which lives in the whole-program `funcSignatures`
	// the parser does not have, and the shapes are compared RESOLVED, which is not true until
	// `resolveTypes`. So this records the two governing NAMES and
	// `SemanticCheck.checkFunctionTypeDoors` decides.
	//
	// A NO-OP unless BOTH sides are function-tagged: a function value meeting a non-function place is
	// `DeclaredTypeMatch.functionIntoNonFunction` (already reported, with its own advice), and a
	// non-function value meeting a function place is an ordinary class mismatch. Only function-meets-function
	// reaches a rule that has nothing left to compare.
	// ⚠ **PRECONDITION: `isFunctionTypeDoor` ANSWERED TRUE** — the gate is the CALLER's, so a call that is
	// not a door evaluates nothing at all. That matters here more than at a typical helper: two of the three
	// doors sit on the hottest paths in the parser (`assignableValue` runs at every assignment,
	// `parseReturnStatement` at every `return`) and almost none of them is a function meeting a function.
	//
	// ⚠ The cost of a door call is the place NOUN, not where the gate sits: with the gate inside, at the call
	// site, or with the declared type passed as a `MaxonType`, the ladder reads the SAME +1,852 allocations at
	// rung 0 to the digit. What costs is a `String` noun threaded on from `assignableValue`; it is ZERO once
	// the noun is a scalar (`FunctionTypeDoor`). Every argument this takes is a scalar or a shared
	// reference, so the door adds no `phase:parse` allocation.
	function recordFunctionTypeDoor(declaredNameId TypeNameId, gotNameId TypeNameId, door FunctionTypeDoor, place FunctionTypeDoorPlace, anchor Token, handedAt Token)
		self.recordFunctionTypeDoorByName(self.internedName(declaredNameId), gotName: self.internedName(gotNameId), door: door, place: place, anchor: anchor, handedAt: handedAt)
	end 'recordFunctionTypeDoor'

	// ⭐ **THE RECORD ITSELF — the door sites that already hold NAMES rather than ids.** A
	// `PendingFunctionTypeDoor` travels as two names (see there: interner-free, so the record survives the
	// merge unremapped), so the id-taking entry point above is a convenience for the sites whose two sides
	// are SSA/type-column ids, and this is the same fact with the un-interning already done.
	//
	// ⚠ **SPLIT RATHER THAN COPIED, and the copy is what it replaced.** A function-backed enum case holds its
	// two sides as `ByteArray` (a case's raw value is bytes on the layout), so it hand-built the
	// `PendingFunctionTypeDoor` — becoming the one site that knew `filePath` belongs on the record and how an
	// anchor decomposes. Two sites spelling one record is how the two come to disagree about it.
	function recordFunctionTypeDoorByName(declaredName immutable ByteArray, gotName immutable ByteArray, door FunctionTypeDoor, place FunctionTypeDoorPlace, anchor Token, handedAt Token)
		self.artifact.recordFunctionTypeDoor(PendingFunctionTypeDoor.create(gotName, declaredName: declaredName, door: door, place: place, line: anchor.line, column: anchor.column, handedLine: handedAt.line, handedColumn: handedAt.column, filePath: self.job.path))
	end 'recordFunctionTypeDoorByName'

	function recordFunctionStoreDoor(declaredNameId TypeNameId, value ValueId, door FunctionTypeDoor, placeName ByteArray, placeOwner SlotOwner, anchor Token)
		var recorded = door
		var place = FunctionTypeDoorPlace.named(placeName)

		if slotOwnerIsATupleElement(placeOwner) 'tupleElement'
			recorded = FunctionTypeDoor.tupleElement
			place = FunctionTypeDoorPlace.unnamed
		end 'tupleElement' else if door == FunctionTypeDoor.containerElement 'containerElement'
			place = FunctionTypeDoorPlace.unnamed
		end 'containerElement'

		self.recordFunctionTypeDoor(declaredNameId, gotNameId: self.functionValueGoverningId(value), door: recorded, place: place, anchor: anchor, handedAt: anchor)
	end 'recordFunctionStoreDoor'

	// ⭐⭐ **THE IDENTITY `resolveTypes` IS ABOUT TO DESTROY — the ONE extraction EVERY pre-erasure column
	// fills through (including the function-TYPE tier).** The interned name
	// of a declared boxed union/enum (or a per-instance ranged alias), and `EmptySourceText` for everything
	// else. Captured at the real parse because this is the last point such a type still knows its name:
	// `TypeResolution.resolveNamedType` collapses it to bare `integer`, leaving every whole-program check
	// nothing to compare.
	//
	// ⚠ **`resolveNamedStruct` IS ASKED FIRST, AND THAT LINE IS THE WHOLE UNIFICATION.** The rule this column
	// states is *"the identity that does NOT survive resolution"*, so a STRUCT must answer empty — its
	// `structRef(id)` survives and every reader takes its name live off the type. But the two callers hand in
	// types at DIFFERENT stages of exactly that rewrite: `parseFunction`/`parseClosureExpression` have already
	// folded `resolveNamedStructAll` over their parameter list, while `readFunctionTypeAlias` has not (a
	// function typealias stores what `parseTypeReference` minted, and a struct is still `named` there). Asking
	// the idempotent re-tag here is what makes both answer alike; without it a `function(Point)` ALIAS carried
	// "Point" while a `function(p Point)` FUNCTION carried nothing, and `functionShapesAgree` would have
	// refused the legal program that passes one to the other. A near-mirror that is not exact is this
	// project's signature bug — so the two sides share the extraction, not merely the comparison.
	//
	// ⚠ **CALLABLE ONLY FROM THE REAL PARSE**, for `resolveNamedStruct`/`aggregateNameIn`'s own reason: both
	// consult `self.signatures`, which the tolerant declaration SWEEP is still building, so a name the sweep
	// has not reached yet would classify differently there. Every caller is inside a `recordSignature`-gated
	// or real-parse-only path.
	function erasedAggregateNameOf(t MaxonType) returns immutable ByteArray
		let resolved = resolveNamedStruct(t, typeNames: self.artifact.typeNames, signatures: self.signatures, scopeFilePath: self.job.path)
		let tag = maxonTypeTag(resolved)

		if tag != ValueTypeTag.named 'survivesResolution'
			return EmptySourceText
		end 'survivesResolution'

		return aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: tag, nameId: typeNameIdOf(resolved), readerFilePath: self.job.path)
	end 'erasedAggregateNameOf'

	// The same extraction for a RETURN slot — a `void` return carries no type and so no identity. Its column
	// is a single `ByteArray` rather than an array because a function type returns exactly one thing.
	function erasedAggregateNameOfReturn(rt MaxonReturnType) returns immutable ByteArray
		return match rt 'r'
			void gives EmptySourceText
			value(inner) gives self.erasedAggregateNameOf(inner)
		end 'r'
	end 'erasedAggregateNameOfReturn'

	// `erasedAggregateNameOf` folded over a parameter list — `FuncSignature.paramAggregateNames` for a
	// declared function or a lifted closure, one entry per parameter and in lockstep with `paramTypes`.
	function paramAggregateNamesOf(paramTypes MaxonTypeArray) returns NameRoster
		let names = NameRoster.create(paramTypes.count(), zeroed: false)

		for pt in paramTypes 'each'
			names.push(self.erasedAggregateNameOf(pt))
		end 'each'

		return names
	end 'paramAggregateNamesOf'

	// ⭐ **THE PRE-ERASURE *SPELLING* COLUMN A SIGNATURE CARRIES (user ruling, 2026-08-04)** — the interned
	// name of every `named` parameter, the brand of a branded instance, the written spelling of a tuple type,
	// and `EmptySourceText` for anything else. Its sibling
	// `paramAggregateNamesOf` above walks the SAME `paramTypes`, position for position, so the two columns
	// cannot come to disagree about which parameter is which. See `FuncSignature.paramDeclaredNames` for why
	// they are different facts — a SPELLING to print versus an IDENTITY to compare.
	//
	// Captured HERE, at the real parse, for `paramAggregateNamesOf`'s reason: this is the last point a `named`
	// parameter still knows its name, because `resolveTypes` erases both a union/enum and a ranged alias to
	// bare `integer` (TypeResolution.resolveNamedType). A STRUCT or interface keeps its own tag through
	// resolution and is read straight off `paramTypes`, so its slot stays empty and no name is stored twice.
	function selfSpelledParamsOf(paramNames NameRoster, paramTypeStarts TokenIndexArray) returns ParamPositionMask
		var mask = NoParamPositions

		for position in 0 upto paramNames.count() 'eachParam'
			let isReceiver = (try paramNames.get(position) otherwise panic("selfSpelledParamsOf: paramNames.get OOB at {position} inside its own `upto` bound")).equals(SelfParamName)

			if not isReceiver and self.kindAt(paramTypeStartAt(paramTypeStarts, position: position)) == TokenKind.selfType 'spelledSelf'
				mask = maskWithParam(mask, param: position as ParamCount)
			end 'spelledSelf'
		end 'eachParam'

		return mask
	end 'selfSpelledParamsOf'

	function paramDeclaredNamesOf(paramNames NameRoster, paramTypes MaxonTypeArray, paramTypeStarts TokenIndexArray) returns NameRoster
		let names = NameRoster.create(paramTypes.count(), zeroed: false)

		for i in 0 upto paramTypes.count() 'each'
			let pt = try paramTypes.get(i) otherwise panic("paramDeclaredNamesOf: paramTypes.get OOB at {i} below the count just read from the same array")
			let tag = maxonTypeTag(pt)
			let isReceiver = (try paramNames.get(i) otherwise panic("paramDeclaredNamesOf: paramNames.get OOB at {i} — a parameter's columns are built in lockstep")).equals(SelfParamName)

			if tag == ValueTypeTag.named 'erasedByResolution'
				names.push(self.internedName(typeNameIdOf(pt)))
			end 'erasedByResolution' else if tag == ValueTypeTag.genericInstance 'aBrandedInstance'
				// The BRAND the parameter was declared under, read off the same token `bindParameters` reads
				// for the callee's own slot; empty for an inline-spelled instance.
				names.push(self.declaredParamSpelling(paramTypeStarts, position: i, resolved: pt))
			end 'aBrandedInstance' else if tag == ValueTypeTag.structRef and not isReceiver and isTupleTypeName(self.internedName(typeNameIdOf(pt))) 'aWrittenTupleType'
				names.push(self.typeSpellingAt(paramTypeStartAt(paramTypeStarts, position: i)))
			end 'aWrittenTupleType' else 'keepsItsOwnTag'
				names.push(EmptySourceText)
			end 'keepsItsOwnTag'
		end 'each'

		return names
	end 'paramDeclaredNamesOf'

	// ⭐ **THE PRIMITIVE TAG THE RANGED ALIAS `nameId` REDUCES TO**, or `named` when no ranged alias
	// declares that name. It is decided through the SAME whole-program `aliasOf` door
	// `valueIsUnsigned`/`fieldStorageType` already ask, so an alias declared in ANY file resolves — and
	// NEVER a String/struct/union `named` (`aliasOf` answers `undeclared` for those, and the name keeps
	// its `named` tag). The parse-time twin of `TypeResolution.resolveNamedType`'s alias arm.
	//
	// ⚠ The caller must know the tag is `named` before asking: `nameId` for a non-`named` type is
	// `UnnamedTypeId`, which is not in the interner (`internedName` would panic). `floatResolvedTag` /
	// `resolveFloatAliasType` / `builtinConformerOfType` are the gated doors, and every reader goes
	// through one of them.
	//
	// TWO facts are read off this ONE reduction, and they must not become two lookups: whether a `named`
	// is a FLOAT alias (the tag `named` is too coarse to carry it), and whether it is an INT alias
	// (the builtin-conformance receiver classifier, which must see `Byte` and `Integer` as `int` exactly
	// as `ProgramSignatures.conformerTypeArgName` does for a witness type argument).
	function rangedAliasTag(nameId TypeNameId) returns ValueTypeTag
		if let answered = try self.memos.rangedAliasTags.get(nameId) 'alreadyAsked'
			return answered
		end 'alreadyAsked'

		let tag = self.rangedAliasTagOfNameFrom(self.internedName(nameId), scopeFilePath: self.job.path)
		self.memos.rangedAliasTags.file(nameId, value: tag)

		return tag
	end 'rangedAliasTag'

	// The same reduction on a named FILE's behalf. Split for `namedIsFloatAliasFor`'s reason: a slot another
	// file declared is reduced in THAT file's scope, and `aliasOf` is where the reader is spent.
	function rangedAliasTagOfNameFrom(name ByteArray, scopeFilePath FilePath) returns ValueTypeTag
		return match self.signatures.aliasOrInnerAliasOf(name, readerFilePath: scopeFilePath) 'a'
			declared(alias) gives maxonTypeTag(alias.underlying)
			undeclared gives ValueTypeTag.named
		end 'a'
	end 'rangedAliasTagOfNameFrom'

	// Does `nameId` name a ranged FLOAT alias? A `float(low to high)` alias
	// (`Parser.readTypeAliasDeclaration`) is the ONE `named` type whose VALUE is a genuine float; an
	// `int(low to high)` alias is `named` too and is an int.
	function namedIsFloatAlias(nameId TypeNameId) returns bool
		return tagIsFloat(self.rangedAliasTag(nameId))
	end 'namedIsFloatAlias'

	// The same question on a named FILE's behalf — see `resolveFloatAliasType`, the one caller that asks it
	// for a slot another file declared. The bare form above is this one asked for THIS file, which is what
	// every other reader of a float alias means.
	function namedIsFloatAliasFor(nameId TypeNameId, scopeFilePath FilePath) returns bool
		return tagIsFloat(self.rangedAliasTagOfNameFrom(self.internedName(nameId), scopeFilePath: scopeFilePath))
	end 'namedIsFloatAliasFor'

	// A `named` TAG that names a ranged float alias resolves to `float`; every other tag passes through —
	// an INT alias stays `named` (`checkDeclaredType` reads it identically, and its name still carries the
	// signedness `valueIsUnsigned` needs), a scalar/struct/String carries no alias. THE float-alias resolution for
	// a DECLARED type met at a coercion site: `checkDeclaredType(3.14's float, Float)` must ask
	// `checkDeclaredType(float, float)` and answer `ok`, not read `Float`'s overloaded `named` tag as an
	// integer and report a false narrowing (E3009). `resolveFloatAliasType` is its twin for a produced
	// VALUE's type; both delegate the alias lookup to `namedIsFloatAlias`.
	function floatResolvedTag(tag ValueTypeTag, nameId TypeNameId) returns ValueTypeTag
		// ⚠ The guard is repeated below rather than delegated to, and it is load-bearing HERE: callers hand
		// this the filler `UnnamedTypeId` beside a concrete tag all the time, and `internedName` PANICS on an
		// id its interner never minted. Only a `named` tag has a name to resolve.
		if tag != ValueTypeTag.named 'notNamed'
			return tag
		end 'notNamed'

		return self.floatResolvedTagOfNameFrom(tag, name: self.internedName(nameId), scopeFilePath: self.job.path)
	end 'floatResolvedTag'

	// The resolution above, asked of the NAME. ONE statement of "a `named` tag over a ranged FLOAT alias is
	// a `float`", so a cast target and every other reader cannot come to disagree about which types a cast
	// may cross (`castHasNoLegalConversion`'s float-resolved precondition) or about what a rejection names.
	function floatResolvedTagOfNameFrom(tag ValueTypeTag, name ByteArray, scopeFilePath FilePath) returns ValueTypeTag
		if tag != ValueTypeTag.named 'notNamed'
			return tag
		end 'notNamed'

		return ValueTypeTag.float if tagIsFloat(self.rangedAliasTagOfNameFrom(name, scopeFilePath: scopeFilePath)) else tag
	end 'floatResolvedTagOfNameFrom'

	// A `named` tag REDUCED to whatever its ranged alias underlies — `Integer` to `integer`, `Percent`
	// to `float` — with every other tag passing through. The general form of the two functions above,
	// and it exists because they are deliberately NOT general: `floatResolvedTag` leaves an INT alias
	// `named` (its callers still need the name's signedness), which makes it useless to a caller whose
	// question is "is this an integer?".
	//
	// ⚠ IT IS NOT `tagIsIntegral` EITHER, AND THAT IS THE WHOLE REASON IT EXISTS. `tagIsIntegral`
	// answers `true` for EVERY `named` tag, float aliases included, and its own comment says so and says
	// why it is sound where it is used. At `emitBitsToFloat` it would not be: it would admit a
	// `Percent`-typed operand through the front-end gate and hand `bitcastI64ToF64` an f64, which
	// `assertUnaryOperandDomain` answers with a PANIC. A gate whose failure mode is a compiler crash
	// on a legal-looking program has to resolve the name, not approximate it.
	//
	// The alias lookup itself is not restated — it is `rangedAliasTag`'s, exactly as the two above.
	// An UNDECLARED name reduces to `named` and therefore matches no primitive question, which is the
	// truthful answer: the program is being rejected for the missing type anyway (E3011).
	function rangedAliasResolvedTag(tag ValueTypeTag, nameId TypeNameId) returns ValueTypeTag
		// The guard `floatResolvedTag`'s carries, and load-bearing for the same reason: a non-`named`
		// tag's `nameId` is the filler `UnnamedTypeId`, which `internedName` PANICS on.
		if tag != ValueTypeTag.named 'notNamed'
			return tag
		end 'notNamed'

		return self.rangedAliasTag(nameId)
	end 'rangedAliasResolvedTag'

	// Resolve a float-alias `named` TYPE to `MaxonType.float` — the produced-VALUE twin of
	// `floatResolvedTag`. A `returns Float` CALL RESULT is a genuine float value, so its tag must be
	// `float` (matching the XMM class the value-class column gives a float return from the callee's f64
	// Std return type), or `trunc(x)` reads the `named` tag as already-integral and returns `x` unchanged
	// and `return x` moves an XMM value through a GPR. An int alias keeps its `named` type (its name
	// carries signedness); a struct/scalar/String passes through.
	// ⚠ **`scopeFilePath` FOR `resolveNamedStruct`'s REASON.**
	// It reaches the ranged registry through `namedIsFloatAlias` ->
	// `rangedAliasTag` -> `ProgramSignatures.aliasOf`, which is reader-aware about the RANGE; the KIND gate
	// is `aliasOf`'s own, so what this parameter carries is WHOSE meaning is being asked.
	// MEASURED without it: a `typealias Level = float(0.0 to 5.0)` in one file against an `enum Level` in
	// another refused the enum file's OWN `returns Level` — inside a file whose author never saw the alias.
	function resolveFloatAliasType(t MaxonType, scopeFilePath FilePath) returns MaxonType
		if maxonTypeTag(t) != ValueTypeTag.named 'notNamed'
			return t
		end 'notNamed'

		return MaxonType.float if self.namedIsFloatAliasFor(typeNameIdOf(t), scopeFilePath: scopeFilePath) else t
	end 'resolveFloatAliasType'

	// ⭐ **THE BUILTIN CONFORMER A `(tag, nameId)` TYPE DISPATCHES ITS `.hash()`/`.equals()`/`.compare()`
	// UNDER** — THE one classifier behind both spellings of a direct dispatch (a
	// binding receiver in `parseMethodCall`, a call-result receiver in `parsePostfix`), so the two cannot
	// come to disagree about which values carry a builtin conformance.
	//
	// A ranged INT alias reduces to `integer` FIRST, which is what makes `Integer`, `Byte`, `HashValue` and
	// a bare `int` one conformer rather than four: `Byte.compare` does not exist and never will — the
	// witness path already collapses a ranged type ARGUMENT the same way
	// (`ProgramSignatures.conformerTypeArgName` → `conformerNameOfDeclaredName`), so both dispatch paths key the
	// same `int.compare` symbol off the same type. A ranged FLOAT alias reduces to `float` by the very same
	// step, so `Percent.compare` is `float.compare`.
	//
	// Every tag with no synthesized impl answers `notAConformer` (`builtinConformerOfTag`), which is what
	// keeps a struct receiver on the struct path.
	//
	// ⚠⚠ **A `string` TAG IS NOT ONE OF THOSE, AND NOTHING HERE IS WHAT KEEPS A `String` RECEIVER OFF
	// THE CONFORMER ARM — THE ARM *ORDER* IS.** This classifier answers `stringConformer` for a string tag,
	// and `dispatchMethodOnReceiver` routes a String receiver to `dispatchStringMethod` SEVEN arms above the
	// conformer arm — which is the load-bearing fact that header states, and the only one. Reading the
	// guarantee off this function instead would be reading it off the wrong mechanism.
	//
	// ⇒ what the `string` answer is actually FOR is the `Self`-ARGUMENT check
	// (`requireBuiltinConformanceSelfArgs` → `valueIsConformer`), which the receiver split cannot reach:
	// `"ab".equals("ac")` hands a String to a `Self` formal and is admitted here, once.
	//
	// ⚠ It answers with the CONFORMER and not its name, and that is a measured decision rather than a
	// stylistic one — see `BuiltinConformer`'s header for the 16-byte box a name allocates at every
	// method-call site in every program, feature or no feature.
	function builtinConformerOfType(tag ValueTypeTag, nameId TypeNameId) returns BuiltinConformer
		return builtinConformerOfTag(tag if tag != ValueTypeTag.named else self.rangedAliasTag(nameId))
	end 'builtinConformerOfType'

	// The classifier above, asked of an SSA VALUE's own type — the form the postfix loop and the
	// `Self`-argument check need (a call result and a method argument are values, not bindings).
	function builtinConformerOfValue(value ValueId) returns BuiltinConformer
		return self.builtinConformerOfType(self.tagOf(value), nameId: self.valueNameId(value))
	end 'builtinConformerOfValue'

	// Is `value` a value of the conformer `conformer`? The concrete-receiver twin of
	// `isReceiverTypeParamValue`: what a `Self`-typed formal accepts. Compared as CONFORMERS rather than as
	// names, so a `Self` argument agrees with its receiver by the same classifier the dispatch was chosen by
	// and no name is materialized to answer a question about types.
	function valueIsConformer(value ValueId, conformer BuiltinConformer) returns bool
		return self.builtinConformerOfValue(value) == conformer
	end 'valueIsConformer'

	// The name is not a local and not a top-level binding WITH STORAGE. Say which of the two remaining things
	// it is: an INLINED top-level constant (E2013) or nothing at all (E2004).
	//
	// A STORED-but-immutable binding — an array `let` the compiler could not image (a managed element, a
	// non-empty container) — never reaches here: it resolves through `globalDeclFor` like any other global,
	// and `parseTopLevelAssignment` refuses it there with this same diagnostic, holding the resolution that
	// proves the name is declared.
	function rejectNonGlobalAssignment(nameTok Token) throws SourceParseError
		match self.constantLookup(nameTok.value, readerFilePath: self.job.path) 'constant'
			// Every kind of constant is immutable — assigning to a managed `let`, to an imaged record or to
			// a scalar one is the same mistake and gets the same diagnostic.
			found or
			foundManaged or
			foundImageRecord or
			foundImageBox or
			recordDeferred or
			poisoned then throw assignToImmutableError(nameTok)
			notFound then throw SourceParseError.undefinedVariable(String.from(nameTok.value), line: nameTok.line, column: nameTok.column)
		end 'constant'
	end 'rejectNonGlobalAssignment'

	// `return [<expr>]`. Sets the block's terminator directly, emitting the distinct
	// `retVoid` variant for a void return rather than a `ret` carrying some absent-value
	// sentinel (see MaxonDialect's `retVoid`).
	//
	// WHICH variant is decided by `func`'s DECLARED return type — never by the token that
	// follows `return`. The two are not interchangeable, and the token alone is the wrong
	// question: it says what the source WROTE, not what the function PROMISED, and when
	// they differ it is the promise the whole backend was built around. Deriving the
	// answer from the token stream instead gives the compiler two sources of truth for
	// "is this function void", with nothing to make them agree — and they disagree on
	// exactly two programs, each a bug no later pass can catch:
	//
	//   • `return <expr>` in a VOID function reaches the x64 tier as a value `ret`, where
	//     `emitPrimaryReturnMove` has no return register to move the value into — a
	//     compiler PANIC on a legal program.
	//   • a BARE `return` in a value-returning function reaches it as `retVoid`, which
	//     emits the `ret` without ever writing R8 — a SILENT MISCOMPILE handing the caller
	//     whatever the last op happened to leave in the return register.
	//
	// `func.maxonReturnType` is not a copy of the contract kept beside it: it IS the
	// field the rest of the pipeline reads — it flows to `funcReturnTypes`, through
	// lowering, and becomes the backend's `StdReturnType`. Reading it here means the
	// parser and the tier that must honour it cannot be looking at different answers.
	//
	// So the statement's shape is checked AGAINST the contract rather than used to infer
	// it, and a `return` that cannot honour it is rejected here — where a source position
	// still exists — instead of reaching a tier that can only panic or emit the wrong op.
	function parseReturnStatement(func IrFunction, block IrBlock) throws SourceParseError
		let retTok = try self.consume(TokenKind.return)
		let bare = self.statementEndsAt(self.pos)

		if isInitializerFunctionName(func.name) 'noFunctionToLeave'
			throw SourceParseError.returnInInitializer(String.from(self.statement.initializerBinding), line: retTok.line, column: retTok.column)
		end 'noFunctionToLeave'

		if self.bodyState.replyDeferred 'afterReplyLater'
			if not bare 'aValue'
				throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "after `reply.later()` the message answers through its Reply, so `return` carries no value: pass the value to `<reply>.answer(value)`", line: retTok.line, column: retTok.column)
			end 'aValue'

			self.emitFunctionExit(block, exit: FunctionExit.returnValue(self.deferredReturnPlaceholder(func.maxonReturnType, anchor: retTok)), anchor: retTok)
			return
		end 'afterReplyLater'

		if maxonReturnTypeIsVoid(func.maxonReturnType) 'voidFunction'
			if not bare 'valueFromVoid'
				throw SourceParseError.returnValueFromVoid(String.from(func.name), line: retTok.line, column: retTok.column)
			end 'valueFromVoid'

			self.emitFunctionExit(block, exit: FunctionExit.returnVoid, anchor: retTok)
			return
		end 'voidFunction'

		// Value-returning: a bare `return` has nothing to return, and there is no value
		// the compiler may invent for it.
		if bare 'noValue'
			throw SourceParseError.returnWithoutValue(String.from(func.name), line: retTok.line, column: retTok.column)
		end 'noValue'

		try self.parseCheckedValueReturn(func, block: block, anchor: retTok)
	end 'parseReturnStatement'

	// ⭐ **PARSE AND RETURN ONE VALUE EXPRESSION, WITH EVERY RULE A `return` OWES** — the character-expecting
	// coercion, the escaping-closure reject, the declared-type check, the aggregate-identity check, the
	// widening coercion, the owned hand-off and the ranged-return site. The cursor sits ON the expression's
	// first token; `anchor` is what a diagnostic and the emitted span point at.
	//
	// ⭐⭐ **IT IS SHARED BECAUSE A PARAMETER DEFAULT *IS* A RETURN**. A default is
	// compiled as the whole body of a synthesized nullary helper whose declared return type is the
	// parameter's declared type (`parseDefaultHelperBody`), so `name String = 42` has to be refused with
	// exactly the diagnostic `return 42` earns from a `returns String` function, and `factor Number = 2` has
	// to widen exactly as `return 2` does. Every one of those rules lives here, once: a second copy at the
	// default site would be a second opinion about what a value must satisfy to leave a function.
	function parseCheckedValueReturn(func IrFunction, block IrBlock, anchor Token) throws SourceParseError
		// The terminator goes on the block the EXPRESSION ended in, not the one it started
		// in. `return a or b` evaluates the `or` across three blocks and leaves control in
		// the merge; terminating `block` instead would leave the merge unterminated (a
		// backend panic) and put the `ret` on a path the value it returns does not reach.
		// ⭐ A `return` IS AN INTEGER-EXPECTING POSITION when the function declares an integral type, so a
		// character literal coerces to its codepoint there. `return 'a'` from `returns Character` needs
		// nothing: the literal already IS one. See `integerizedOperand`.
		let retStart = self.pos
		self.stateDeclaredReturnArrayLiteralTarget(func.maxonReturnType, valueStart: retStart)

		// Each arm returns its own give: a merge phi carries one word, and the witness half of a returned
		// interface value is chosen from the conformer at the `ret`.
		if maxonReturnTypeTag(func.maxonReturnType) == ValueTypeTag.interfaceRef and self.at(TokenKind.match) 'eachArmReturnsItsGive'
			_ = try self.parseMatchCommon(func, block: block, isExpression: true, destination: ArmDestination.returned(anchor))
			return
		end 'eachArmReturnsItsGive'

		let expression = try self.parseExpression(func, block: block)
		try self.returnCheckedValue(func, expression: expression, retStart: retStart, anchor: anchor)
	end 'parseCheckedValueReturn'

	function returnCheckedValue(func IrFunction, expression ValueId, retStart ElementIndex, anchor Token) throws SourceParseError
		try self.requireByReferenceIsolatedStaysPut(func, value: expression, at: anchor)

		try self.requireReturnedCapability(func, value: expression, retStart: retStart)

		let parsed = try self.integerizedOperand(expression, expected: maxonReturnTypeTag(func.maxonReturnType), start: retStart, pastEnd: self.pos)

		let retVal = match func.maxonReturnType 'declared'
			void gives parsed
			value(declared) gives self.interfaceHandleOf(parsed, declared: declared, first: anchor, last: anchor)
		end 'declared'

		match func.maxonReturnType 'unneeded'
			void then break
			value(declared) then self.reportUnneededLiteralCastAt(expression, first: retStart, declared: declared)
		end 'unneeded'

		// The value must satisfy what the function PROMISED — `checkDeclaredType`, the same
		// COERCION-SITE rule the call arguments and the assignments ask, and deliberately not the
		// symmetric `typesAgree` an operator's two operands ask. `return flag` from a function
		// declared `returns Integer` is the argument-position bug in reverse: the bool's 1 payload
		// would be handed back through the return register as the integer 1. And `return 3.7` from
		// one is the LOSSY half — the classes agree, so only a one-sided rule can see it.
		//
		// The declared type here is the RAW parse-time one (a `named` alias, not yet resolved by
		// `TypeResolution`, which runs after the parse). A ranged INT alias's `named` tag is what
		// `typeClassOf`/`tagIsIntegral` are built to read; a ranged FLOAT alias's is not — `named` is
		// `tagIsIntegral`, so `checkDeclaredType(3.14's float, Float)` would read the alias as an int and
		// report a false narrowing (E3009) on `return 3.14`. `floatResolvedTag` resolves a float alias to
		// `float` HERE, at the call site, leaving the shared `named`-is-int rules untouched: `named`
		// still means int everywhere those rules read it, and only a proven float alias is lifted out of
		// it. `typeTagName` then prints `float` for the float alias and `int` for the int one, each the
		// resolved primitive.
		let retTag = self.tagOf(retVal)
		let declaredNameId = maxonReturnTypeNameId(func.maxonReturnType)
		let declaredTag = self.floatResolvedTag(maxonReturnTypeTag(func.maxonReturnType), nameId: declaredNameId)

		// ⭐⭐ **AN INTERFACE-TYPED RETURN IS A WIDENING POSITION, NOT AN AGREEMENT ONE.**
		// It is the SECOND widening position the language has, and it takes exactly the shape
		// the first one took at a call ARGUMENT (`SemanticCheck.checkOneArgType`): a conforming concrete
		// value gains its witness half on the way out and leaves as a fat pointer, so `TypeClass.interfaceValue`
		// deliberately agrees with nothing and BOTH checks below would refuse every legal return — the tag
		// check on the class, the aggregate-identity check on two nominal names that are never the same name.
		// It returns rather than falling through for that second reason, exactly as `checkOneArgType` does.
		//
		// ⚠ **THE VERDICT IS NOT TAKEN HERE, AND CANNOT BE.** Whether the returned type CONFORMS is
		// `ConformanceCheck.valueWidensToInterface`, which takes the whole `Project` — and the parser holds
		// none, because a conformer's `implements` clause is recorded when its OWN file is parsed and the two
		// files have no ordering. `SemanticCheck.checkOneReturnedValue` asks it whole-program through the
		// SAME door the argument position asks, so the widening positions cannot come to disagree about
		// what conforms — nor about a `float`, which conforms and still has no way into the fat pointer.
		//
		// The ranged-return site below is not skipped by returning early: it is gated on
		// `rangeCheckReturnAlias`, which is the declared return type's RANGED-ALIAS name, and an interface is
		// not one — so it is empty on every path that reaches here.
		if declaredTag == ValueTypeTag.interfaceRef 'existentialReturn'
			try self.emitOwnedValueReturn(retVal, anchor: anchor)
			return
		end 'existentialReturn'

		// The tag verdict runs FIRST: a genuine CLASS mismatch (a bool, or a struct, where an int is
		// declared) is refused by it, and the aggregate-name check below only NEWLY catches
		// the case the tag check WRONGLY AGREES on — a boxed union returned where a scalar is declared,
		// where `checkDeclaredType(named, named)` agrees because `ValueTypeTag.named` is overloaded.
		match self.declaredSlotVerdict(retTag, gotNameId: self.valueNameId(retVal), declared: declaredTag, declaredNameId: declaredNameId) 'declared'
			ok then break
			mismatch then throw returnMismatchError(func, got: self.valueDisplayTypeName(retVal), gotNote: "", expected: self.declaredSpellingDisplay(self.bodyState.functionReturnSpelling, tag: declaredTag, nameId: declaredNameId), expectedNote: "", line: anchor.line, column: anchor.column, origin: self.bodyState.resultOrigin.clone())
			narrowsFloatToInt then throw SourceParseError.implicitNarrowing(self.valueDisplayTypeName(retVal), targetType: self.declaredSpellingDisplay(self.bodyState.functionReturnSpelling, tag: declaredTag, nameId: declaredNameId), line: anchor.line, column: anchor.column)

			// A FUNCTION VALUE returned where a NON-function type is declared — the spec's
			// specific E3005 ("Cannot return 'function' from function declared to return '{declared}': …").
			// A function returned from a function-typed return (`return double` from `returns UnaryOp`)
			// agrees and never reaches this.
			functionIntoNonFunction then throw SourceParseError.functionValueReturned(self.declaredSpellingDisplay(self.bodyState.functionReturnSpelling, tag: declaredTag, nameId: declaredNameId), line: anchor.line, column: anchor.column)
		end 'declared'

		// The FUNCTION twin of the aggregate identity check in `admitReturnedAggregate` — a function value
		// returned where a function type is declared agrees on the tag and can still be a different function
		// type entirely. See `recordFunctionTypeDoor` for why it is recorded rather than decided here. It is
		// recorded BEFORE the conversion, off the value's own governing name, so the whole-program door still
		// compares the two SHAPES; only the brand is exempt there.
		if isFunctionTypeDoor(declaredTag, got: retTag) 'functionTypeDoor'
			self.recordFunctionTypeDoor(declaredNameId, gotNameId: self.functionValueGoverningId(retVal), door: FunctionTypeDoor.returned, place: FunctionTypeDoorPlace.unnamed, anchor: anchor, handedAt: self.tokenAt(retStart))
		end 'functionTypeDoor'

		let admitted = try self.admitReturnedAggregate(func, returned: retVal, retTag: retTag, declaredTag: declaredTag, declaredNameId: declaredNameId, retStart: retStart, anchor: anchor)

		// ⭐ **THE `ok` VERDICT ABOVE LICENSED A WIDENING, AND SOMETHING HAS TO PERFORM IT.** `return 3`
		// from a `returns float` function agreed (both numeric, nothing lost) and then handed the raw i64
		// straight to `emitOwnedValueReturn` — which put a GPR where the f64 return register is, and the
		// x64 emitter panicked on the cross-register-file move it was asked for. The same door every other
		// coercion site uses; `retVal` is already a float when the source wrote one, so this is a no-op for
		// every program that compiled before.
		let returned = self.coerceToDeclared(admitted, declared: declaredTag, anchor: anchor)
		self.carryCapability(expression, target: returned)

		try self.emitOwnedValueReturn(returned, anchor: anchor)

		// A `return` in a ranged-int-alias-returning function is a narrowing site. `returned` is the
		// scalar the exit carries — on its `ret`, or on the edge of its `branch` into the function's
		// shared exit chain (a ranged int return is never an owned value, so `emitOwnedValueReturn`
		// passes it through unwrapped), so recording it here matches the id the Std pass finds there
		// (`retMatchesValue`). Anchored on the `return` keyword (the E3005 position). A ranged
		// INT alias never widens, so this is the value the coercion returned untouched.
		//
		// ⚠ **RECORDED AFTER THE EXIT IS EMITTED, BECAUSE THE BLOCK IS HALF THE SITE** (see
		// `RangeCheckReturnSite.block`): the guard belongs in front of THIS site's own exit, and the
		// block that terminator went into is `currentBlock` as `emitOwnedValueReturn` left it. The
		// hand-off's scope drops run first and may branch, so the block the `return` keyword was parsed
		// in is not reliably the one holding the exit.
		//
		// ⭐⭐ **AND A `return` WHOSE VALUE THE DECLARED TYPE PROVABLY ADMITS IS NOT A SITE.**
		// `return b` from a `returns ExitCode` function, `b` a `Byte =
		// int(0 to u8.max)`, would emit a `0 ≤ x ≤ 4294967295` cascade with an `mrt_panic` arm on a value
		// that cannot fail it — while the SAME compile reports `b as ExitCode` as E3010 *"'Byte' already
		// fits in 'ExitCode'"*, which is that cascade's own impossibility, proved. The alias-named doors
		// ask this inside `recordRangedTargetSite`; a `return` asks it through `recordRangedReturnSite`
		// because its destination is the FUNCTION's declared type rather than one written at the site.
		match self.bodyState.rangeCheckReturnAlias 'rangedReturn'
			undeclared then break
			declared(alias) then self.recordRangedReturnSite(returned, alias: alias, anchor: anchor)
		end 'rangedReturn'
	end 'returnCheckedValue'

	// ⭐⭐ **THE NOMINAL HALF OF A `return` — the identity check, and the ONE implicit conversion the language
	// has.** A `return` carries exactly the conversion an explicit `as <declared type>` would perform, and no
	// other door does: an argument, a rebind, a field store, an `otherwise` value and a match-arm merge all
	// still demand the written cast. So `return n` from a `returns Wide` function IS `return n as Wide` — a
	// widening emits no guard, a narrowing keeps the runtime guard, two brands of one instance re-brand at no
	// cost, and `main` may return an alias-typed value without spelling `ExitCode`.
	//
	// ⛔ **ONLY A NOMINAL DIFFERENCE CONVERTS, and the two arms below are the whole of what counts as one.**
	// A DIFFERENT struct, a boxed union where a scalar is declared, a different generic INSTANCE — each is a
	// record handed back and dropped under the DECLARED type's destructor: a wild free or a leak the tag
	// check cannot see (two structs share `structRef`; a boxed union and a ranged alias share `named`).
	// Those keep the refusal. `castIsARebrand` admits two brands of ONE instance only (the canonical instance
	// names agree), and `conflictIsBetweenNamedScalars` admits two NAMES over a scalar only — an identity a
	// struct, a union or an instance mint never has. A function value's brand is decided at the whole-program
	// door instead (`SemanticCheck.checkOneFunctionTypeDoor`, where `returned` is exempt exactly as `cast` is)
	// and its SHAPE is still compared there; the parser's names are empty for both function sides.
	//
	// ⭐ **THE CONVERSION IS THE CAST'S OWN.** `rebrandValue` and `convertValueToDeclaredType` are the doors an
	// `as` goes through, minus the two records that are about a WRITTEN cast — E3010 (`reportUnneededCast`:
	// there is no cast here to call unneeded) and the type-name verdict (`settleTypeNameVerdict`: the
	// return type was written in this file, where its visibility was settled at the declaration). A bare
	// local therefore gets a fresh value rather than an in-place retype (`emitRetaggedCastValue`), because the
	// same local stays live on other paths under its own identity, and the result carries the declared
	// alias, so the ranged-return site below reads its guard as dead.
	//
	// ⚠ **THE TWO NAMES DECIDE THE VERDICT AND DO NOT SPELL IT** — `parseAssignment`'s reassign check and
	// `requireManagedValueMatches` carry the identical note for the identical reason (user ruling,
	// 2026-08-04): the refusal quotes the alias the author wrote, never the instance mint.
	function admitReturnedAggregate(func IrFunction, returned ValueId, retTag ValueTypeTag, declaredTag ValueTypeTag, declaredNameId TypeNameId, retStart ElementIndex, anchor Token) returns ValueId throws SourceParseError
		let declaredType = try valueTypeOfReturn(func.maxonReturnType) otherwise panic("admitReturnedAggregate: a void return type has no value — the caller must gate on maxonReturnTypeIsVoid first")
		let value = try self.destinationTemporary(returned, declared: declaredType, anchor: anchor)
		let declaredReturnName = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: declaredTag, nameId: declaredNameId, readerFilePath: self.job.path)
		let returnedName = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: retTag, nameId: self.valueNameId(value), readerFilePath: self.job.path)
		let returnBrand = self.bodyState.functionReturnBrand

		if not returnBrand.isEmpty() and retTag == ValueTypeTag.genericInstance 'aBrandedReturnMayMeetAnUnadoptedRead'
			self.recordUnadoptedBrandDoor(value, expected: returnBrand, door: FunctionTypeDoor.returned, placeName: func.name, owner: SlotOwner.unowned, anchor: anchor)
		end 'aBrandedReturnMayMeetAnUnadoptedRead'

		if not self.signatures.aggregatesConflict(declaredReturnName, expectedTag: declaredTag, expectedNameId: declaredNameId, expectedBrand: returnBrand, got: returnedName, gotTag: retTag, gotNameId: self.valueNameId(value), gotBrand: self.brandOf(value), readerFilePath: self.job.path) 'theValueIsOfTheDeclaredType'
			return value
		end 'theValueIsOfTheDeclaredType'

		let sourceIsBareLocal = self.rhsWasBareLocalReference(retStart)

		if self.castIsARebrand(value, targetType: declaredType) 'twoBrandsOfOneInstance'
			return self.rebrandValue(value, targetType: declaredType, brand: returnBrand, sourceIsBareLocal: sourceIsBareLocal, opTok: anchor)
		end 'twoBrandsOfOneInstance'

		if self.signatures.conflictIsBetweenNamedScalars(declaredReturnName, got: returnedName) 'twoNamesOverOneScalar'
			return try self.convertValueToDeclaredType(value, sourceTag: retTag, targetType: declaredType, targetAlias: self.declaredAliasOfType(declaredType), opTok: anchor, sourceIsBareLocal: sourceIsBareLocal, mustCarryTargetType: false)
		end 'twoNamesOverOneScalar'

		let declaredShown = self.declaredSpellingDisplay(self.bodyState.functionReturnSpelling, tag: declaredTag, nameId: declaredNameId)
		let paired = self.pairedDisplays(value, declaredTag: declaredTag, declaredNameId: declaredNameId, declaredBrand: returnBrand, declaredIdentity: declaredReturnName, declaredShown: declaredShown)
		try self.refuseUnlessDeferred(returnMismatchError(func, got: paired.got, gotNote: paired.gotNote, expected: paired.declared, expectedNote: paired.declaredNote, line: anchor.line, column: anchor.column, origin: self.bodyState.resultOrigin.clone()), value: value)
		return value
	end 'admitReturnedAggregate'

	function recordRangedReturnSite(returned ValueId, alias RangedTypeAlias, anchor Token)
		self.admitUnsignedLiteral(returned)
		self.recordLiteralCounterUse(returned, target: alias, line: anchor.line, column: anchor.column)

		if self.valueIsProvablyInRange(returned, target: alias) 'provablyInRange'
			return
		end 'provablyInRange'

		self.bodyState.rangeCheckReturnSites.push(RangeCheckReturnSite.create(returned, block: self.bodyState.currentBlock.id, line: anchor.line, column: anchor.column))
	end 'recordRangedReturnSite'

	// ⭐ **EMIT A VALUE `ret` THAT HANDS ITS VALUE TO THE CALLER AS AN OWNED ONE** — the shared tail of a
	// value `return` and a non-capturing closure body's `gives <expr>`. A closure body IS a
	// value return (its expression is the lifted function's returned value), so both go through here rather
	// than each spelling the promotion/reject/drop dance. `anchor` is the token a diagnostic and the span
	// point at (`return`'s keyword, or the closure's `gives`).
	//
	// **A `returns String` FUNCTION HANDS BACK A UNIFORMLY OWNED HEAP String**, and the caller drops that
	// result unconditionally (`enrolOwnedCallTemp`). So the callee must return something OWNED and must not
	// drop it — two adjustments, in this order, BEFORE the scope drops:
	//
	//   • PROMOTE a borrowed return. `return "hi"` is an immortal rdata literal
	//     (`capacity@16 == ImmortalRecordCapacity`), not owned heap; handed back as-is, the caller would
	//     `__mm_decref` read-only data. `retainBorrowedByteRecord` (`__str_retain`) is what makes it
	//     droppable without making it a COPY: it reads that capacity at RUN TIME and clones an immortal
	//     record where it increfs a heap one, so the caller adopts an independently-droppable record either
	//     way and a borrowed HEAP String is handed back as ITSELF. `return "{x}"` and `return t` are already
	//     owned, so they pass through here. This half is return-specific and stays here; the MOVE below is
	//     the shared hand-off cleanup.
	//   • MOVE the owned return OUT of both drop sets — the shared `emitHandoffExit` (the throw twin
	//     performs the SAME move). It belongs to the caller now: excluded from this exit's
	//     owned-binding drops so `emitFunctionExit` does not double-free `return t`, and out of
	//     `pendingTempDrops` so the interp/promoted temporary is not dropped on the dead path the
	//     `ret` leaves behind. The binding stays in `ownedBindings`, because the list OUTLIVES the
	//     `return` and the returned binding may sit in an enclosing block with other LIVE exit edges
	//     whose drops are emitted LATER in the parse and still own it.
	//
	// ⭐⭐ **A RETURNED STRUCT / BOXED UNION MUST BE OWNED, AND A BORROWED ONE IS CO-OWNED RATHER THAN
	// REFUSED.** An OWNED box carries the provenance bit and is moved out, so exactly one owner drops it. A
	// BORROWED aggregate — `return self`, a struct/union parameter, a re-borrow, a struct-typed field read —
	// has an owner ELSEWHERE, and handing the box back untouched would make two owners free one box. It is
	// therefore INCREF'd on the way out, through the one `promoteBorrowedToOwned` door a `var q = p` binding
	// already uses: the caller adopts a real second reference and decrefs it once, the borrow's own owner is
	// untouched, and the box is freed exactly once on every path.
	//
	// A String is RETAINED — `__str_retain`, an incref of a heap record and a clone of an immortal one — and a
	// trivial TUPLE gets its own record, both through the same door; a scalar or payload-free enum carries no
	// box and is always fine.
	//
	// ⚠ **MAXON'S VALUE SEMANTICS ARE REFERENCE SEMANTICS** — *"everything is
	// a reference; if you want a copy you do it explicitly with `clone()`"* — so a `return name` handing back
	// a different record than the `name` it was given is the copy the author never wrote. Only the `binding`
	// door still copies (`ownedFormOfBorrowedValue`, which states why, and that the question is still open).
	//
	// **THE DROPS GO AFTER THE VALUE, BEFORE THE TERMINATOR.** AFTER the value, because `return p.x + p.y`
	// READS the box; dropping first would free the memory the loads are about to read. BEFORE the
	// terminator, because a `ret` ENDS the block. `returned` is already in a register by then.
	function emitOwnedValueReturn(retVal ValueId, anchor Token) throws SourceParseError
		// A promise still naming a container slot is a borrow, and a borrow may not leave the frame — see the
		// predicate for why this is what refuses `last()` on a promise array while leaving `pop` legal.
		try self.requireReturnedPromiseIsNotABorrow(retVal, anchor: anchor)

		var returned = retVal

		// The ONE promotion door (see the header): a borrowed String is RETAINED at this HAND-OFF door
		// (`__str_retain`), a borrowed TRIVIAL TUPLE gets its own record, a borrowed opaque `T` takes a
		// reference through its instance descriptor, a borrowed struct/union/instance INCREFS. An
		// already-owned value and a scalar pass straight through.
		//
		// ⭐⭐ **THE CALLEE DISCHARGES THE HAND-OFF FOR EVERY SHAPE — AN OPAQUE `T` INCLUDED — AND THE
		// CALLER SIMPLY ADOPTS** (`enrolOwnedCallTemp`). There is no convention under which the CALLER
		// can take the reference instead: a body that returns a value it CREATED has nowhere to put the
		// one it holds, and releasing it before the `ret` frees the record the caller is about to retain.
		// A caller-takes-it convention is read off the DECLARED type while the obligation belongs to the
		// RETURNED VALUE, so it leaks whenever the body already owned what it hands back — MEASURED,
		// `return fresh()` through a `returns Element` prints the right answer and exits 101 with no
		// `pop`, no array and no function alias in it.
		//
		// ⚠ **THE OPAQUE ARM IS ADMITTED BY THE SHARED GATE BELOW RATHER THAN BY A PRIVATE `if` HERE, AND
		// THAT IS WHAT KEEPS THE MERGE EDGE ANSWERABLE.** A private arm on this road leaves
		// `promoteBorrowedGive` with no answer for a borrowed `T` — a parser panic on
		// `return front if c else back` over a body whose `if`/`return` spelling compiles. An ALREADY-OWNED
		// opaque value (an element `pop` moved out of an `Array with T` field) passes straight through and is
		// moved out of the drop sets below, exactly as an owned String does.
		if self.returnedValueIsTheReceiversFieldRecord(returned) 'handedBackUncounted'
			if self.valueIsOwnedHeap(returned) 'ownedDespiteTheSweep'
				panic("emitOwnedValueReturn: the sweep proved every `return` of this method a field of its receiver, yet a returned record is owned — callers adopt no reference for it, so it would leak")
			end 'ownedDespiteTheSweep'

			self.emitHandoffExit(FunctionExit.returnValue(returned), anchor: anchor)
			return
		end 'handedBackUncounted'

		if self.borrowedValueOwesAHandoffReference(returned) 'promoteBorrowed'
			returned = try self.promoteBorrowedToOwned(returned, door: BorrowLaunderDoor.returned, range: SourceRange.ofToken(anchor))
			self.carryCapability(retVal, target: returned)
			self.carryUndecidedResult(retVal, target: returned)
			self.carryImmutableSlotRead(retVal, target: returned)
		end 'promoteBorrowed'

		self.emitHandoffExit(FunctionExit.returnValue(returned), anchor: anchor)
	end 'emitOwnedValueReturn'

	function returnedValueIsTheReceiversFieldRecord(returned ValueId) returns bool
		return self.bodyState.returnsAReceiverField and self.valueIsAManagedStructRecord(returned)
	end 'returnedValueIsTheReceiversFieldRecord'

	function valueIsAManagedStructRecord(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.structRef and self.valueIsManagedHeap(value)
	end 'valueIsAManagedStructRecord'

	// ============================================================================
	// scalar error handling: throw / try / otherwise / panic
	// ============================================================================

	// `throw E.case` or `throw <e>` — leave the enclosing ERROR SCOPE, which is the FUNCTION unless a
	// block-form `try` body encloses this statement, in which case it is that block's shared handler (see
	// `emitThrowError`, which owns the fork, and `routeBareThrowToTryBlock`). The thrown expression evaluates
	// to a `named(E)` enum value carrying the case's tag (a literal for `throw E.case`, the caught `(e)`
	// binding for `throw e`); the flag encode is the same at both destinations. Owned locals are dropped
	// before control leaves — the whole frame's on the function edge, the block's own on the routed one.
	function parseThrowStatement(func IrFunction, block IrBlock) throws SourceParseError
		self.bodyState.currentBlock = block
		let throwTok = try self.consume(TokenKind.throw)
		self.bodyState.operandOrder.enterStatement()
		try self.emitThrowError(func, anchor: throwTok)
		self.bodyState.operandOrder.leaveStatement()
	end 'parseThrowStatement'

	// Parse the thrown enum expression and send the error on its way — the `throwError` terminator out of the
	// function, or a branch to the enclosing block-form `try`'s shared handler. Shared by the `throw <e>`
	// statement and the match `default throws <E.case>` arm (which differ only in the keyword their caller
	// consumed — `throw` vs `throws`), so both spellings route identically inside a `try` block.
	function emitThrowError(func IrFunction, anchor Token) throws SourceParseError
		// Where this throw goes is decided first, because it decides what the throw owes. A routed throw
		// branches to the enclosing block-form `try`'s shared handler, so it is measured against no
		// `throws` clause (`main` may hold a `try` block whose body throws) and releases only what the
		// block owns.
		let routed = self.bodyState.tryBlocks.count() > 0
		let thrownValueFloor = func.valueTags.count()
		let thrownStart = self.pos
		var errValue = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let errorType = self.typeOf(errValue)

		if maxonTypeTag(errorType) != ValueTypeTag.named 'notAnErrorType'
			try self.refuseUnlessDeferred(SourceParseError.thrownValueNotAnErrorEnum(anchor.line, column: anchor.column), value: errValue)

			// Noted even when the value was minted outside the block: a body whose only throw is this one
			// routes nothing, and would otherwise be refused E3083 in front of the E3004 that explains it.
			self.noteDeferredValueInTryBlock()
			self.endADeferredThrow(errValue, routed: routed, anchor: anchor)
			return
		end 'notAnErrorType'

		// `errorIsBoxed` below is derived from the value, while the catch derives the same fact from the
		// enclosing function's declared clause (`tryErrorEnumType`). This check is what makes the two
		// derivations agree, as E3059 does for the propagate form.
		try self.requireThrownTypeFitsEnclosing(func, errorType: errorType, routed: routed, anchor: anchor)

		if self.throwLeavesAWindow(routed) 'leavesAWindow'
			try self.requireValueMayLeaveWindows(errValue, startIndex: thrownStart)
		end 'leavesAWindow'

		let errorIsBoxed = self.throwsTypeIsBoxedUnion(errorType)

		// A thrown box must be owned by this frame: the catch adopts it and drops it once. An owned box
		// (a fresh `throw U.case(x)`, a caught `(e)`) is moved out below. One not owned here is either:
		//   • moved out of its field (`moveOutThrownField` nulls the slot) when it is a boxed-union field
		//     read this throw expression itself made (`thrownValueFloor`), the throw leaves the function,
		//     and this frame is the container's sole owner — the container then dies with this frame, so
		//     no surviving owner can read the nulled slot. An earlier read bound to a name may reach
		//     storage on a sibling path, and a routed throw stays in a frame that may re-read the field.
		//     The gate is `valueIsSoleHeapOwner`, not `valueIsOwnedHeap`: a co-owned container
		//     (`let c = g.inner`) carries the owned bit while `g.inner` still points at the box (see
		//     `OwnedHeapExclusivity`);
		//   • otherwise retained into a fresh value (`retainBorrowedAggregate`), a second owner the catch
		//     consumes while the borrow's own owner keeps its reference. ⚠ It must be a fresh value:
		//     marking a borrowed parameter's own value owned would let a sibling path move that value
		//     into storage without a retain.
		if errorIsBoxed and not self.valueIsSoleHeapOwner(errValue) 'borrowedThrow'
			let thrownIsFieldRead = self.bodyState.lastFieldRead.isReadOf(errValue) and errValue >= thrownValueFloor as ValueId

			if thrownIsFieldRead and not routed and self.valueIsSoleHeapOwner(self.bodyState.lastFieldRead.readBox()) 'fieldThrow'
				self.moveOutThrownField(errValue, anchor: anchor)
			end 'fieldThrow' else 'coOwnTheThrownBox'
				errValue = self.retainBorrowedAggregate(errValue, range: SourceRange.ofToken(anchor))
			end 'coOwnTheThrownBox'
		end 'borrowedThrow'

		// The box leaves the local drop sets before the scope drops: the cleanup releases every other
		// owned local on the throw edge but not the box in flight, which would otherwise be freed here
		// and adopted by the catch. It is the hand-off cleanup a `return <value>` performs
		// (`emitHandoffExit`), and the owned list is restored for a sibling exit edge that still
		// owns it. A scalar error owns no heap, so its move-out is inert.
		if routed 'toTheBlockHandler'
			self.routeBareThrowToTryBlock(errValue, errorType: errorType, errorIsBoxed: errorIsBoxed, anchor: anchor)
			return
		end 'toTheBlockHandler'

		self.emitHandoffExit(thrownExit(errValue, errorIsBoxed: errorIsBoxed), anchor: anchor)
	end 'emitThrowError'

	// A routed throw leaves a window only if one opened since its `try` block. `windowFloor` counts only
	// `modify` windows, so a throw while a one-statement window is innermost always leaves it.
	function throwLeavesAWindow(routed bool) returns bool
		let windows = self.regionFactsForRead().windows

		if not windowIsOpen(windows) 'noWindow'
			return false
		end 'noWindow'

		if not routed or (innermostWindowOf(windows)).kind == WindowKind.oneStatement 'leavesTheInnermost'
			return true
		end 'leavesTheInnermost'

		return self.openWindowCount() > self.innermostTryBlock().windowFloor
	end 'throwLeavesAWindow'

	function endADeferredThrow(errValue ValueId, routed bool, anchor Token)
		if not routed 'outOfTheFunction'
			self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.throwError(errValue, errorIsBoxed: false), range: SourceRange.ofToken(anchor))
			return
		end 'outOfTheFunction'

		let ctx = self.innermostTryBlock()
		self.recordBranchEdge(self.bodyState.currentBlock, targetId: ctx.errBlockId, argIds: self.tryBlockErrorEdgeArgs(ctx, flag: errValue))
		self.emitBranch(self.bodyState.currentBlock, targetId: ctx.errBlockId)
	end 'endADeferredThrow'

	// ⭐⭐ **ROUTE A BARE `throw` TO THE ENCLOSING BLOCK-FORM `try`'s SHARED HANDLER — the THROW twin of
	// `routeToTryBlock`, and the whole of what that construct's body means by "a throw".**
	// NOT routing it is a correctness bug: in a body holding one routed call and one `throw AErr.beta`, the
	// unrouted throw neither reaches the handler nor leaves the function.
	//
	// The flag is the value form of the encode, `MaxonOp.errorFlagEncode`, lowered by the same
	// `encodeScalarErrorFlag` the `throwError` terminator is, so the flag a routed throw hands the
	// handler is bit-identical to the one a returned throw hands a caller.
	//
	// ⭐ **THREE THINGS ARE SHARED VERBATIM WITH THE CALL ROUTER, and each is a guard that construct paid for**:
	// the error edge's args are the flag FIRST and every carried binding's value RIGHT HERE (positional against
	// the phis, `edgeArgsFor(preLoop: false)`); the edge goes through `tryBlockThrowEdgeTarget`, so this site's
	// own live temporaries and the body's owned bindings are released in a landing pad rather than leaked over
	// the body's `end`; and `recordRoutedEdge` settles the handler's error TYPE and the ownership state the
	// handler is entered with. Nothing here is a second opinion about any of them.
	//
	// ⚠ **BUT THE BOX IN FLIGHT LEAVES THE DROP SETS FIRST, WHICH IS THE CALL ROUTER'S OWN HAZARD WEARING THE
	// THROW'S CLOTHES.** A `throw U.case(x)` builds an owned box and hands it to the handler, which adopts it
	// (`enrollCaughtBox`); left in `pendingTempDrops`/`ownedBindings` the landing pad would release it on the
	// very edge that transfers it — a double free. `emitHandoffExit` performs exactly this move-out for
	// the function-exit form. A bound box stays in `ownedBindings` and is excluded from this edge's
	// drops (`HandedOff`): a SIBLING edge (another arm, the path that did not throw) still owns it.
	function routeBareThrowToTryBlock(errValue ValueId, errorType MaxonType, errorIsBoxed bool, anchor Token)
		let ctx = self.innermostTryBlock()
		let member = self.recordRoutedEdge(ctx, clause: self.thrownTypeClause(errorType))

		let flag = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.errorFlagEncode(flag, errorValue: errValue, errorIsBoxed: errorIsBoxed), range: SourceRange.ofToken(anchor))
		let fused = self.routedEdgeFusedValue(member, flag: flag, anchor: ctx.tryTok)

		let errArgs = self.tryBlockErrorEdgeArgs(ctx, flag: flag)
		var inFlight = HandedOff.nothing

		if self.valueIsOwnedHeap(errValue) 'boxInFlight'
			inFlight = HandedOff.value(errValue)
			self.removeFromPendingTemps(errValue)
		end 'boxInFlight'

		let errTargetId = self.tryBlockThrowEdgeTarget(ctx, errArgs: errArgs, flag: flag, member: member, fusedValue: fused, anchor: anchor, handedOff: inFlight)

		self.emitBranch(self.bodyState.currentBlock, targetId: errTargetId)
	end 'routeBareThrowToTryBlock'

	// ⭐ **THE `ThrowsClause` A THROWN VALUE'S TYPE NAMES — the THROW door's projection, where a CALL's is
	// `signatures.throwsOf(callee)`.** Both routed edges (a bare throwing call, a bare `throw`) hand
	// `recordRoutedEdge` one of these, so the block's error type is settled from ONE kind of answer whichever
	// door produced it. Its two readers — this and `requireThrownTypeFitsEnclosing` — are why it is a function
	// rather than two spellings of `nameOf(typeNameIdOf(...))`.
	//
	// It panics on a non-`named` type rather than answering `none`: `emitThrowError` reports "that is
	// not an error type at all" before either caller runs, and a `none` here would be that refusal
	// silently re-decided as "this block routed nothing".
	function thrownTypeClause(errorType MaxonType) returns ThrowsClause
		if maxonTypeTag(errorType) != ValueTypeTag.named 'notAnErrorType'
			panic("thrownTypeClause: a thrown value's type is not `named` — `emitThrowError` refuses that before either caller reaches here")
		end 'notAnErrorType'

		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(errorType)) otherwise panic("thrownTypeClause: a `named` MaxonType's TypeNameId did not resolve in the artifact's interner — every such id was minted by `intern` against this same interner")
		return ThrowsClause.throwing(String.from(name))
	end 'thrownTypeClause'

	// Move a thrown boxed-union field out of a container this frame solely owns (`emitThrowError`
	// gates it). The throw nulls the slot the value was loaded from (the `lastFieldRead*` fields), so
	// the container's `__destruct_<T>` cascade skips it rather than freeing the box the catch adopts,
	// and marking the value owned routes it through the hand-off a fresh `throw U.case(x)` takes — the
	// throw twin of match's `moveOutManagedPayload`.
	//
	// The value is marked co-owned, not sole: a sole container may hold a co-owned field
	// (`Self{pending: <a borrowed union>}` co-owns it in), so nulling the slot transfers that slot's
	// reference and says nothing about the allocation.
	//
	// The null store is an i64 pointer write: a boxed-union field slot holds a machine-word box
	// address (`fieldStorageType` gives it `integer`).
	function moveOutThrownField(value ValueId, anchor Token)
		let range = SourceRange.ofToken(anchor)
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: range)

		match self.bodyState.lastFieldRead 'fieldRead'
			none then panic("moveOutThrownField: a thrown field is moved out only after `emitThrowError` matched it against the recorded field read")
			read(_, box, offset) then self.emitIndirectStore(box, offset: offset, value: zero, storageType: MaxonType.integer, range: range)
		end 'fieldRead'

		self.markValueOwnsHeap(value, exclusivity: OwnedHeapExclusivity.coOwned)
	end 'moveOutThrownField'

	// ⭐ **`panic("message")` — ABORT, PRINTING `panic at <file>:<line>: <message>` AND A BACKTRACE, EXIT 1.**
	// Emits a `panicAbort`/`panicAbortValue` body op carrying the message, followed by a dead return
	// terminator (control never returns, so the return is unreachable but keeps the block well-formed).
	//
	// ⭐ **THE MESSAGE IS ASSEMBLED HERE BECAUSE TWO OF ITS THREE PARTS ONLY EXIST HERE** — the source
	// BASENAME and the LINE of the `panic` keyword. The format itself is `panicMessageLine`'s (and, for an
	// interpolation, its two halves), shared with the range-check guard so the runtime prints one shape
	// whichever producer assembled it. The location-prefixed message is interned at parse time, except where
	// that cannot apply — a message whose text is not a parse-time constant (`PanicMessage`).
	//
	// ⚠ **`panic` IS A TERMINATING STATEMENT THAT CARRIES AN EXPRESSION, WHICH IS WHY IT DRAINS ITS OWN
	// TEMPORARIES.** `parseStatement`'s post-statement drain is skipped once the block is terminated, on the
	// stated argument that a terminating statement drops its temporaries BEFORE its terminator (as
	// `parseReturnStatement` does) and that `break`/`continue` carry no expression to build one. `panic` was
	// the case that argument did not cover: an interpolated message builds an owned String, and left in
	// `pendingTempDrops` it was released by the NEXT statement's drain — which, for a `panic` inside an
	// `if`, is a block the interpolation's definitions do not dominate. That is the exact shape
	// `drainPendingTemps`' region list warns about: on x64 the value happened to be spilled and the release
	// read an UNINITIALIZED SLOT on the path the `if` did not take (a silent wrong free), and on arm64 it
	// stayed in a register and the register allocator reported it, several passes later, as
	// `seedInUse: … a use dominates its def`.
	function parsePanicStatement(func IrFunction, block IrBlock) throws SourceParseError
		self.bodyState.currentBlock = block
		let panicTok = try self.consume(TokenKind.panic)
		let messageTempFloor = self.bodyState.pendingTempDrops.count()
		try self.consume(TokenKind.leftParen)
		self.bodyState.operandOrder.enterStatement()
		let message = try self.parsePanicMessage(func, panicTok: panicTok)
		self.bodyState.operandOrder.leaveStatement()
		try self.consume(TokenKind.rightParen)

		if self.bodyState.pendingTempDrops.count() > messageTempFloor 'dropMessageTemps'
			self.drainPendingTemps(messageTempFloor, anchor: panicTok)
		end 'dropMessageTemps'

		let range = SourceRange.ofToken(panicTok)

		match message 'form'
			baked(line) then self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.panicAbort(line), range: range)
			rendered(linePtr) then self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.panicAbortValue(linePtr), range: range)
		end 'form'

		self.emitDeadReturn(func, anchor: panicTok)
	end 'parsePanicStatement'

	// The `panic at <file>:<line>: <text>\n` line a `panic(…)` hands the runtime, having consumed its
	// argument — BAKED for a plain literal, RENDERED for an interpolation (see `PanicMessage`).
	//
	// ⚠ **THE ARGUMENT MUST BE A STRING *LITERAL* (interpolated or not), NOT MERELY A `String`** —
	// `panic(m)` on a `String` binding is `E3005 panic requires a string argument`; accepting one
	// exits with no message at all, because there is nothing to bake. The requirement is not an
	// implementation limit dressed as a rule: it is what makes the message's SHAPE a compile-time
	// fact, so a plain one can live in `.rdata` and print from a process whose heap may be the thing
	// that failed. An interpolation necessarily allocates to render its holes — but only on the path
	// that is already aborting.
	function parsePanicMessage(func IrFunction, panicTok Token) returns PanicMessage throws SourceParseError
		if not self.at(TokenKind.stringLiteral) 'notALiteral'
			let argTok = self.current()
			let arg = try self.parseExpression(func, block: self.bodyState.currentBlock)
			throw SourceParseError.builtinOperandPhrase("panic", required: StringLiteralRequirement, got: self.valueDisplayTypeName(arg), line: argTok.line, column: argTok.column)
		end 'notALiteral'

		if self.peekKind() == TokenKind.stringInterpStart 'interpolated'
			return PanicMessage.rendered(try self.renderedPanicMessagePointer(func, panicTok: panicTok))
		end 'interpolated'

		let tok = try self.consume(TokenKind.stringLiteral)
		let text = String.from(try self.decodedStringLiteralBytes(tok))
		return PanicMessage.baked(panicMessageLine(self.job.path, line: panicTok.line, text: text))
	end 'parsePanicMessage'

	// ⭐⭐ **AN INTERPOLATED PANIC ASSEMBLES ITS WHOLE LINE AT RUN TIME — LOCATION PREFIX AND TRAILING
	// NEWLINE INCLUDED — AND HANDS THE RUNTIME THE ADDRESS OF THE BYTES.** `panic("value is {x}")` cannot
	// bake a line: `{x}` is not known until the program runs. So the two constant halves become extra
	// literal FRAGMENTS of an ordinary interpolation (`panicMessageLinePrefix`, `PanicMessageLineTerminator`
	// — the same two `panicMessageLine` bakes, so the format is spelled once for both producers) and the
	// existing interpolation machinery assembles the rest.
	//
	// ⭐ **WHAT MAKES THIS COST NO NEW RUNTIME: A FUSED INTERPOLATION BUFFER IS ALREADY NUL-TERMINATED.**
	// `emitStringInterp` allocates the record + the bytes + one more, and the slab zeroes what it hands
	// back, so `buffer[totalLen]` IS the NUL `mrt_panic` scans for. What reaches the runtime is therefore a
	// C string of exactly the shape the interned `.rdata` blob is — one entry point, one contract, two ways
	// of producing the bytes.
	//
	// ⚠ **THE RECORD LEAVES THE PENDING LIST WITHOUT A DROP, AND THAT IS DELIBERATE.** Its bytes are what
	// the runtime reads, so a `__mm_decref` before the call would free the message being printed; and there
	// is no "after the call", because `mrt_panic` exits the process. This is `emitHandoffExit`'s shape
	// — a value handed away stops being the statement's to release — with the hand-off going to a runtime
	// rather than to a caller. Every OTHER temporary the message expression built (a `toString()` result an
	// interpolation spliced in) stays enrolled and is drained by `parsePanicStatement`, in the block its
	// definition dominates.
	function renderedPanicMessagePointer(func IrFunction, panicTok Token) returns ValueId throws SourceParseError
		let record = try self.parseStringInterpolation(func, prefix: panicMessageLinePrefix(self.job.path, line: panicTok.line), suffix: PanicMessageLineTerminator)
		self.removeFromPendingTemps(record)
		return self.emitLoadStringField(record, offset: StringBufferOffset, range: SourceRange.ofToken(panicTok))
	end 'renderedPanicMessagePointer'

	// The dead return terminator emitted after a diverging op (`panicAbort`): a `retVoid` for a void
	// function, else a zero. Unreachable — the preceding op never returns — but every block must commit
	// to a terminator.
	//
	// ⛔⛔ **ITS BITS ARE DEAD; ITS REGISTER FILE IS NOT.** `ret` moves the value into the return register,
	// which for a float-returning function is XMM0/d0, so an INTEGER zero makes the x64 emitter panic —
	// *"a register-to-register move from rax to xmm0 crosses register files"* — on a function whose whole
	// body is `if x < 0.0 … panic("neg") … end / return x`, with no `try` in sight. The value is dead
	// either way; the CLASS the allocator colours it in is not, and no diagnostic exists for it because the
	// program is perfectly legal.
	//
	// ⭐ **THE THROW EDGE ONE DOOR OVER CARRIES THE SAME RULE.** `LowerMaxonToStd`'s
	// `emitZeroConstOfReturnType` states it for `errorReturn`'s family-default value, quoting that same
	// panic — but a `panic()` statement never reaches it, because the parser commits this terminator at the
	// MAXON tier. Two producers of "the dead value a diverging path returns", and each has to know.
	//
	// ⚠ **THE FLOAT TEST GOES THROUGH `floatResolvedTag`, NOT THE BARE TAG.** A `returns FullRangeFloat` — the
	// declared return of `stdlib/Builtins.maxon`'s `__float_fromString` — is a `named` ranged alias at parse
	// time (aliases erase in `resolveTypes`, which runs later), and a `named` that reduces to `float` occupies
	// XMM exactly as a bare `float` does. Reading the bare tag classes it GPR and reproduces the panic on the
	// one declaration this most matters for.
	function emitDeadReturn(func IrFunction, anchor Token)
		if maxonReturnTypeIsVoid(func.maxonReturnType) 'void'
			self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.retVoid, range: SourceRange.ofToken(anchor))
			return
		end 'void'

		let range = SourceRange.ofToken(anchor)
		let zero = self.emitLiteral(0, valueType: self.deadReturnZeroType(func), range: range)

		if self.tagOf(zero) == ValueTypeTag.interfaceRef 'anExistentialReturn'
			self.pairInterfaceWitness(zero, witness: self.emitLiteral(0, valueType: MaxonType.integer, range: range))
		end 'anExistentialReturn'

		self.emitBodyTerminator(self.bodyState.currentBlock, op: MaxonOp.ret(zero), range: range)
	end 'emitDeadReturn'

	// Every statement door that ends in a call finishes here. The router runs at emission, where
	// statement position is unknowable, so two statement facts wait for this point: the discard probe
	// (E3064/E3065), which must find a routed call's `tryCall`, and the implied route, where an
	// always-throwing callee's unreachable ok edge is closed, as `desugarTry` closes it for a
	// propagating `try`.
	function finishCallStatement(func IrFunction, result ValueId, opFloor ElementIndex, tempFloor ElementIndex, anchor Token) throws SourceParseError
		try self.requireSendReplyKept(result, opFloor: opFloor, anchor: DroppedReplyAnchor.atTheSend)
		self.recordDiscardedCallResult(result, opFloor: opFloor, anchor: anchor, door: DiscardDoor.statement)

		if self.throwRouteDestination() != ThrowRouteDestination.impliedTestHandler 'theImpliedHandlerIsNotHere'
			return
		end 'theImpliedHandlerIsNotHere'

		if self.routedCallNeverComesBack(self.tryChannelCallAbove(opFloor, wanted: TryChannelResult.definedValue(result))) 'theCalleeOnlyThrows'
			self.endBlockAfterUnreachableTail(func, anchor: anchor, tempFloor: tempFloor)
		end 'theCalleeOnlyThrows'
	end 'finishCallStatement'

	function routedCallNeverComesBack(routed DiscardedCallee) returns bool
		return match routed 'routed'
			notACall gives false
			named(callee, _, _) gives self.signatures.functionAlwaysThrows(callee)
		end 'routed'
	end 'routedCallNeverComesBack'

	// A bare-call statement to a function that never returns ends its block, exactly as a
	// `panic` statement in its place would. This is the only consumer of `functionNeverReturns`,
	// deliberately: the fact reaches every construct that asks `isTerminated()` — an `otherwise`
	// handler's fall-through gate (E3059), the missing-return gate (E3013), an `if`/`match` arm's
	// merge — through the block's terminator.
	//
	// A short-circuit `and`/`or` in an argument leaves control in a fresh merge block, which is where
	// the call landed and so the block that is terminated.
	//
	// Only the bare-name call statement asks. A method call's key needs the receiver's type, and a
	// namespace-qualified call's key is assembled from contest state, so either would derive the key a
	// second way. Every uncertainty must resolve to "it returns", which is what not asking gives,
	// while a wrong key could answer yes for a declaration that comes back.
	function terminateAfterDivergingCall(func IrFunction, calleeTok Token, tempFloor ElementIndex)
		// ⚡ A single `Set.contains` on a set that is EMPTY for every program declaring no `panic` helper,
		// asked once per bare-call statement. Asked of the name the call binds, which is what the facts are
		// keyed by.
		if not self.signatures.functionNeverReturns(self.signatures.nameABareCallBinds(calleeTok.value, readerFilePath: self.job.path)) 'theCalleeComesBack'
			return
		end 'theCalleeComesBack'

		self.endBlockAfterUnreachableTail(func, anchor: calleeTok, tempFloor: tempFloor)
	end 'terminateAfterDivergingCall'

	// What a statement does once control provably does not continue past it, written once for every
	// door that reaches it: a bare call to a `panic` helper, and an always-throwing callee
	// under a propagating `try` (`desugarTry`) or a test body's implied handler
	// (`finishCallStatement`). The doors differ only in the question they ask the signature index, and
	// a second copy of what follows is a second chance to omit the drain.
	//
	// The drain is not optional, because `parseStatement`'s tail drain skips a terminated block: this
	// statement's temporaries are released here or by nobody. The floor is the statement's, never the
	// whole list: an enclosing construct's temporary (a match scrutinee, a `for` element) sits below
	// it, and taking it off the pending list would leak it on every other path.
	//
	// No scope drops, exactly as `panic` emits none: control never reaches the rest of this frame, so
	// a drop here would be code on a path that does not exist.
	//
	// What follows goes into a fresh `dead` block, as `finalizeIfElse` does for the continuation of an
	// `if` whose branches all terminate: the tail is parsed for syntax and emits into a block nothing
	// reaches, and a `return` written under such a statement is not a second terminator on this block,
	// which `emitTerminator` would panic on. E3071 does not refuse that tail: its roster is statement
	// forms (`statementFormRole`), and neither a call nor a `try` is a terminator.
	function endBlockAfterUnreachableTail(func IrFunction, anchor Token, tempFloor ElementIndex)
		// The block this statement's work landed in cannot ordinarily be terminated — its ops were just
		// appended — but a `dead` one can arrive here from an unreachable tail, and `Terminator.dead` is not an
		// op `emitTerminator` may replace.
		if self.bodyState.currentBlock.isTerminated() 'nothingReachesThisStatementAnyway'
			return
		end 'nothingReachesThisStatementAnyway'

		if self.bodyState.pendingTempDrops.count() > tempFloor 'dropStatementTemps'
			self.drainPendingTemps(tempFloor, anchor: anchor)
		end 'dropStatementTemps'

		self.emitDeadReturn(func, anchor: anchor)

		self.bodyState.currentBlock = self.newDeadBlock(func, label: b"afterdiverge")
	end 'endBlockAfterUnreachableTail'

	// Does this `try` target name a callee that can only ever throw? Only a `named` target has a
	// declaration to ask about: a witness dispatch resolves to a conformer this call site does not
	// know, an awaited promise names a storage type rather than a body, and a deferred target names
	// nothing. Every uncertainty here must resolve to "it comes back", which those arms answering
	// `false` give.
	function tryTargetAlwaysThrows(target TryTarget) returns bool
		return match target 'shape'
			named(callee) gives self.signatures.functionAlwaysThrows(callee)
			witness or
			promise or
			send or
			deferred or
			serviceReply or
			serviceStart or
			sentReply gives false
		end 'shape'
	end 'tryTargetAlwaysThrows'

	// The type a dead return's zero is born with — `float` when the declared return occupies XMM,
	// the declared interface type for an interface return, `integer` otherwise. A String / struct /
	// boxed-union return is a POINTER, which is a GPR value exactly as an `int` is, and the bits are
	// dead on every one of them. An interface return is the exception: lowering widens a `ret` of a
	// non-existential value through that value's witness table, and an integer zero has none.
	function deadReturnZeroType(func IrFunction) returns MaxonType
		let declared = func.maxonReturnType

		if tagIsFloat(self.floatResolvedTag(maxonReturnTypeTag(declared), nameId: maxonReturnTypeNameId(declared))) 'floatReturn'
			return MaxonType.float
		end 'floatReturn'

		if maxonReturnTypeTag(declared) == ValueTypeTag.interfaceRef 'existentialReturn'
			return try valueTypeOfReturn(declared) otherwise panic("deadReturnZeroType: a void return type has no tag, so it is not an interface return")
		end 'existentialReturn'

		return MaxonType.integer
	end 'deadReturnZeroType'

	// ⭐ **THE try/otherwise DESUGAR.** Parses `try <call> [otherwise <handler>]`, emitting a `tryCall`
	// (the call rewritten to define a second `errorFlag` value), a `compare(flag != 0)` + `condBranch`
	// two-way split, the error handler, and the merge. Returns the try's RESULT value (used in expression
	// position; discarded as a statement). `resultUsed` is true in value position — it decides the
	// void-callee (E3059) and `otherwise ignore` (E3059) rejects.
	function parseTry(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		let tryTok = try self.consume(TokenKind.try)

		// ⭐ **A BLOCK-FORM `try` REACHING HERE IS IN AN EXPRESSION POSITION**, and that is the only way it
		// can: `parseStatement` forks the statement spelling to `parseTryBlockStatement` before this routine
		// is entered (both read the same `charLiteralOpensTryBlockIn` label lookahead). The construct GROUPS statements
		// and yields nothing, so there is no value for the enclosing expression to take — the same rule that
		// makes an `if` a statement and a `<t> if <c> else <f>` the expression spelling.
		if charLiteralOpensTryBlockIn(self.tokens, index: self.pos) 'blockFormInValuePosition'
			throw SourceParseError.errorTypeMismatch("a block-form `try 'label' … end` groups statements and yields no value, so it cannot stand where a value is expected — use a single-statement `try call()` with an `otherwise <value>` fallback", line: tryTok.line, column: tryTok.column)
		end 'blockFormInValuePosition'

		// ⭐⭐ **WHERE THE TARGET'S OWN OPS BEGIN — the fact that makes "the LAST op in the block" mean "the
		// TARGET'S last op".** `module.ops` is append-only for the whole parse (nothing truncates it, and a
		// rewrite mutates in place), so an op index below this floor was appended before the target was
		// parsed and cannot be the target's however the target is spelled.
		//
		// ⚠ It is a FLOOR on the op INDEX rather than a count of `currentBlock.opRefs`, because the target
		// may legally leave `currentBlock` behind: a nested `try` (`try consume(try get() otherwise 0)`)
		// desugars into a fork and the outer call lands in the merge block, so a per-block count would be
		// measured against a block that is no longer current.
		let targetOpFloor = self.artifact.module.ops.count()

		// This statement's own temporary floor, captured before the target is parsed so the target's operands
		// sit above it — what `endBlockAfterUnreachableTail` drains if the ok edge turns out to be unreachable
		// Read only on that path; every other `try` ignores it.
		let tempFloor = self.bodyState.pendingTempDrops.count()
		let targetDeferralFloor = self.artifact.deferredChains.count()
		let result = try self.parseTryCallTarget(func)
		let (target, flag) = try self.rewriteLastCallToTryCall(result, tryTok: tryTok, targetDeferralFloor: targetDeferralFloor, targetOpFloor: targetOpFloor)
		let leg = self.statement.takeSentLeg()

		try self.requireThrowingTryTarget(target, tryTok: tryTok)

		if not resultUsed 'aStatement'
			try self.requireSendReplyKept(result, opFloor: targetOpFloor, anchor: DroppedReplyAnchor.atTry(tryTok))
		end 'aStatement'

		// A value-position `try` on a VOID callee has no value to yield (E3059).
		//
		// ⚠ **THE SAME ENGLISH SENTENCE IS ALSO E2004's** (`Queries.voidCallResultUsed`, *"Function 'x' does not
		// return a value"*), and the two are deliberately NOT merged: this one is the `try` spelling, refused from
		// the result TAG at the try's own position, while E2004 is the BARE spelling, refused by each dispatch
		// arm's `resultUsed` guard a pass earlier. Two codes, two checks, two positions — `void-call-result.md`
		// pins both halves of every void mutator, because a guard lost from either arm passes on the other's case.
		if resultUsed and self.tagOf(result) == ValueTypeTag.void 'voidInValue'
			throw tryTargetProducesNoValueError(target, signatures: self.signatures, tryTok: tryTok)
		end 'voidInValue'

		return try self.desugarTry(func, tryTok: tryTok, result: result, flag: flag, target: target, resultUsed: resultUsed, tempFloor: tempFloor, leg: leg)
	end 'parseTry'

	// Parse the throwing target after `try` — a primary call form followed by its whole postfix chain
	// (`try make().slice(1, endIndex: 3)`, `try [10,20,30].get(0)`, `try pick()(21)`) — and leave its
	// op for the caller's desugar to rewrite into the try channel.
	//
	// The `try` binds to the op producing the target's value, so the chain must be parsed to its end:
	// stopping at the primary would rewrite `make`'s call in `try make().slice(…)` and refuse a legal
	// program as "'make' does not throw".
	//
	// `resultUsed: false` at every arm: whether the try's value is usable is settled once, by
	// `parseTry`, from the try's own position (E3059). Asked inside the target it would report "this
	// call's value cannot be used" for a `try f().push(1)` statement, where the real fault is that
	// `push` cannot throw (E3055).
	//
	// Both `try` forms, `parseTry` and `if try` (`parseCatchingCondition`), funnel through here, so
	// the claim is opened here. The op producing the target's value is the caller's to rewrite and no
	// router may take it first, so a `try f() otherwise 0` inside a `try 'l' … end` body catches its
	// own error. Every other throwing op inside the target — an argument, an operand, a chain receiver
	// — is released to the enclosing block or test handler (see `ThrowRouteClaim`). A `SourceParseError`
	// from the target skips the restore harmlessly: the claim is reset per function, and a parse error
	// ends this file's parse.
	function parseTryCallTarget(func IrFunction) returns ValueId throws SourceParseError
		let claim = self.openClaim(ThrowRouteClaim.everyDestination)
		let savedTargetMustStayACall = self.bodyState.tryTargetMustStayACall

		// See `tryTargetMustStayACall`: no fold inside the target may remove the op the rewrite one level
		// up looks for.
		self.bodyState.tryTargetMustStayACall = true
		let target = try self.parseTryTargetExpression(func)
		try self.closeClaim(claim, keepsTheCoveredAwait: false)
		self.bodyState.tryTargetMustStayACall = savedTargetMustStayACall
		return target
	end 'parseTryCallTarget'

	// ⭐⭐ **TAKE THE OPS A BLOCK HAS GAINED SINCE `mark` OFF IT, AND HAND THEM BACK.** A ternary's TRUE ARM is
	// parsed onto the unconditional path before the `if` announces the form (`parseTernaryExpression`), and is
	// then re-attached inside a block only ONE edge reaches. The ops keep their `module.ops` indices — only the
	// block referencing them changes.
	//
	// ⚠ Its one caller is the ternary relocation. A substituted `T` result's `+1` is taken in the callee (see
	// `emitOwnedValueReturn`), so nothing is emitted after such a call and there is nothing to lift onto a `try`'s ok edge.
	//
	// ⚠ **COLLECT AND TRUNCATE ARE ONE OPERATION, WHICH IS WHY THEY ARE ONE FUNCTION.** A collect without the
	// truncate leaves the ops running on the path that was supposed to lose them — a `+1` (or a whole arm) on
	// both edges of a fork, which is a leak on one of them and no diagnostic on either.
	function detachOpRefsAbove(block IrBlock, mark ElementIndex) returns OpIndexArray
		let detached = OpIndexArray.create(block.bodyOpCount() - mark, zeroed: false)

		for i in mark upto block.bodyOpCount() 'collect'
			detached.push(try block.bodyOpAt(i) otherwise panic("detachOpRefsAbove: block {block.id} bodyOpAt OOB at {i}"))
		end 'collect'

		while block.bodyOpCount() > mark 'truncate'
			_ = try block.popBodyOp() otherwise panic("detachOpRefsAbove: block {block.id} popBodyOp above the mark {mark} failed")
		end 'truncate'

		return detached
	end 'detachOpRefsAbove'

	// ⭐⭐ **THE RANGE-CHECK SITES THE TRUE ARM RECORDED MOVE WITH ITS OPS — THE OTHER HALF OF THE
	// RELOCATION ABOVE.** A site is a POSITION, not a value: it records the block control was in and the
	// ordinal that block stood at (`RangeCheckSite`), because a narrowing int→int cast emits no op of its
	// own and an ordinal is the only anchor there is. `detachOpRefsAbove` takes the arm's ops off
	// `startBlock` and `parseTernaryExpression` re-attaches them inside `ternarytrue`, so a site the arm
	// recorded describes a position that has ceased to exist — and `InsertRangeChecks` then splits
	// `startBlock`, which is the CONDITION's block and runs unconditionally.
	//
	// ⛔ **BOTH HALVES OF THAT ARE MEASURED WRONG ANSWERS, not a theoretical hazard.**
	//
	//   * **The checked value is computed INSIDE the arm.** The cascade is emitted in `startBlock` while its
	//     operand is defined in `ternarytrue`, which `startBlock` dominates — a use above its def. Liveness
	//     propagates the operand out of the entry block and the register allocator refuses the function
	//     outright: *"seedInUse: value N is live-in to block 0 but was never colored"*.
	//     `stdlib/Array.maxon`'s ranged `ElementIndex` puts a guard on every computed array index, so an
	//     `a.get(i - n)` in a conditional expression's true arm is this shape.
	//   * **The checked value is computed EARLIER** (a parameter, or anything from a dominating block).
	//     Nothing is out of order, so nothing complains — the guard simply runs on BOTH edges, which is the
	//     wrong answer: `(i as Small) if flag else 7` with `flag` FALSE and an out-of-range `i` must print
	//     `7` and exit 0, not panic *"Range check failed: value outside typealias 'Small'"*. That is the
	//     very failure `RangeCheckSite.block` exists to prevent — *"a cast in an unselected ternary arm /
	//     if-branch does not fire it"* — reintroduced one construct over, by a relocation the site record
	//     had no way to hear about.
	//
	// The mapping is the relocation's own arithmetic and nothing more: an op that stood at position p of
	// `startBlock` stands at `p - opShift` of the continuation. Only sites naming `fromBlock` move — a site
	// the arm recorded in a block of its OWN (a nested ternary's branch, a short-circuit, a `try` fork)
	// names that block, and those blocks are re-registered under the same ids, so they need nothing.
	//
	// ⚠⚠ **THE SECOND PLACE THAT KNOWS A SITE'S ORDINAL IS A KEY IS `removeCurrentBlockOpAt`** — the
	// constant-slice fold's op REMOVAL, which shifts by one instead of relocating and skips instead of
	// asserting. The two loops are the same rule with different failure policies, and nothing but this
	// cross-reference makes them agree: **a change to `RangeCheckSite`'s position representation must be
	// made in BOTH, and a THIRD mutation of any block's body ops owes the same walk.** There are exactly two
	// body-op mutations in this parser (`detachOpRefsAbove` and `removeCurrentBlockOpAt`); a grep for
	// `popBodyOp` / `setBodyOp` is what enumerates them.
	function rehomeArmRangeSites(fromBlock BlockId, toBlock BlockId, opShift ElementIndex, firstSite ElementIndex, endSite ElementIndex)
		for i in firstSite upto endSite 'eachArmSite'
			let site = try self.bodyState.rangeCheckSites.get(i) otherwise panic("rehomeArmRangeSites: rangeCheckSites.get OOB at {i}, inside the range the ternary's own marks bound")

			if site.block != fromBlock 'recordedInAnInnerArmBlock'
				continue
			end 'recordedInAnInnerArmBlock'

			if site.maxonOpPos < opShift 'aheadOfTheArm'
				panic("rehomeArmRangeSites: a site recorded during the true arm names position {site.maxonOpPos} of block {fromBlock}, which already held {opShift} ops when the arm began — a block's ordinals only grow while the parser is inside it, so a site recorded after the mark cannot stand before it")
			end 'aheadOfTheArm'

			try self.bodyState.rangeCheckSites.set(i, value: site.placedAt(toBlock, atOrdinal: site.maxonOpPos - opShift)) otherwise panic("rehomeArmRangeSites: rangeCheckSites.set OOB at {i}, which the read above just found in range")
		end 'eachArmSite'
	end 'rehomeArmRangeSites'

	// The target's grammar, split from the state above so the claim brackets every path through it.
	function parseTryTargetExpression(func IrFunction) returns ValueId throws SourceParseError
		// `try await p`: the await is the throwing operation, so it is the try target. It is emitted
		// through `emitAwaitOp` without `emitAwait`'s routing or its E3057 refusal, because catching the
		// error is what `try await` does; `rewriteLastCallToTryCall` then converts it into a `tryAwait`,
		// and `parseTry`'s E3055 check refuses a non-throwing promise. The promise operand is parsed
		// unclaimed, so a throwing op inside it goes to the enclosing handler.
		//
		// Terminal: no postfix chain is applied to the awaited value, because a trailing `.method(…)`
		// would make the method the try target and leave the throwing await unguarded, silently dropping
		// its error flag. The operand parse has already consumed any postfix on the promise itself.
		if self.at(TokenKind.await) 'awaitTarget'
			try self.requireNoWaitInsideWindow(self.current())
			let awaitTok = try self.consume(TokenKind.await)
			let holdsSend = self.bodyState.holdsSendForTryAwait
			self.bodyState.holdsSendForTryAwait = true
			let promise = try self.parseUnclaimedUnary(func)
			self.bodyState.holdsSendForTryAwait = holdsSend

			match try self.awaitOperandOf(func, promise: promise, awaitTok: awaitTok) 'operand'
				promise(facts) then return (try self.emitAwaitOp(promise, facts: self.holdTheSendOfAnAwait(promise, facts: facts), awaitTok: awaitTok)).0

				// Derived as a call, so `rewriteLastCallToTryCall` answers it `TryTarget.deferred`.
				deferred then return self.deferredValueOfChain(DeferredChainCalls.lastLinkIsACall)
			end 'operand'
		end 'awaitTarget'

		// `try spawn T.f(…)`: the await of the start is the throwing operation, and the arm is terminal
		// for the await's reason above.
		if self.atSpawnPrefix() 'spawnTarget'
			return try self.parseSpawn(func, handling: SpawnStartHandling.caught)
		end 'spawnTarget'

		let operandStart = self.bodyState.operandOrder.eventCount()
		return try self.parsePostfix(func, operandStart: operandStart, value: try self.parseTryCallReceiver(func), resultUsed: false)
	end 'parseTryTargetExpression'

	// The PRIMARY a `try` target's postfix chain starts from — a free call `f(…)`, a method/qualified call
	// `obj.m(…)` / `Type.m(…)` / `Self.m(…)`, a `self.m(…)`, a field-chain call, or an array / byte-string
	// LITERAL receiver.
	// Split from `parseTryCallTarget` so the postfix continuation is applied to EVERY form in one place rather
	// than per arm (applying it per arm leaves the free-call arm stopping
	// at the first callee).
	function parseTryCallReceiver(func IrFunction) returns ValueId throws SourceParseError
		// `try bag.items.get(0) otherwise …` / `try self.nodes.get(i) otherwise …` — a throwing method on an
		// ARRAY reached through a 2+-hop field chain. Checked FIRST: a single-hop `self.m(…)` /
		// `obj.m(…)` is not a field chain (`fieldChainMethodCallAt` needs 2+ hops) and falls to the arms below;
		// a 2+-hop chain resolves to the array field and applies the method, leaving the `call __managed_get` as the
		// last op for `rewriteLastCallToTryCall`.
		// `try arr.managed.get(0) otherwise …` — asked BEFORE the field chain, which would otherwise claim the
		// two-hop shape and resolve `.managed` as a field of a record that has none (see `arrayManagedFieldAt`).
		// The CHAINED predicate: a `try` target must be a throwing CALL, and a bare `try arr.managed` is not one.
		if self.arrayManagedMemberCallAt(self.pos) 'managedFieldTarget'
			return try self.parseMethodCall(func, resultUsed: false)
		end 'managedFieldTarget'

		if self.fieldChainMethodCallAt(self.pos) 'fieldChainTarget'
			return try self.parseFieldChainCall(func, resultUsed: false)
		end 'fieldChainTarget'

		if self.at(TokenKind.self) 'selfCall'
			return try self.parseSelfPrimary(func, resultUsed: false)
		end 'selfCall'

		// `try Self.check(v) otherwise …` — the `Self.` spelling of the qualified static the arm above serves.
		// `Self` is its own keyword token, so it cannot ride that arm; and it opens the DOTTED form ONLY,
		// which is why it is not simply folded into it — there is no `Self(…)` free call for the sibling
		// sub-arm to serve. `parseDottedPrimary` resolves the base, so nothing here learns what `Self` means.
		if self.at(TokenKind.selfType) and self.peekKind() == TokenKind.dot 'selfDottedTarget'
			return try self.parseDottedPrimary(func, resultUsed: false)
		end 'selfDottedTarget'

		// `try int.fromString(s) otherwise 0` — the primitive-static spelling of the qualified static above,
		// and the position that MATTERS for it: all four `__<prim>_fromString` declarations throw,
		// so `try` is the only way a program calls one. `int`/`float`/`bool` are keywords, so they cannot ride
		// the `named` arm; the SHAPE gate is `parsePrimary`'s read shape with the call's `(` added, so the try
		// target admits the calls the expression does. `byte.fromString(…)` is an identifier and is served by
		// `named` above.
		if self.primitiveStaticCallAt(self.pos) 'primitiveStaticTarget'
			return try self.parseDottedPrimary(func, resultUsed: false)
		end 'primitiveStaticTarget'

		// `try [10,20,30].get(0) otherwise …` — a throwing method on an array LITERAL, and its
		// exact byte-string analogue `try b"…".get(0)`. Each parses to an owned array temp that
		// the postfix chain applies its method to; the temp is a FORK temporary, which `openTryFork`
		// suspends
		// across the handler so every ABANDONING path releases it and the merging ones keep it.
		// Both literal kinds are enrolled together — accepting one and not the other would
		// reject a legal `try b"…".get(…)` as "not a call".
		if self.at(TokenKind.leftBracket) 'arrayLiteralTarget'
			return try self.parseArrayLiteral(func, element: ArrayLiteralElementSource.inferred)
		end 'arrayLiteralTarget'

		if self.at(TokenKind.byteStringLiteral) 'byteStringLiteralTarget'
			return try self.parseByteStringLiteral()
		end 'byteStringLiteralTarget'

		// ⭐ **`try "abc".findFirst("b") otherwise …` — A STRING LITERAL RECEIVER, AND THE ARM THE
		// SENTENCE ABOVE ALREADY ARGUED FOR.** That note says the two literal kinds are enrolled together
		// because "accepting one and not the other would reject a legal `try b\"…\".get(…)` as 'not a
		// call'" — and a `String` has THREE throwing methods a program may reach on a literal
		// (`findFirst`, `findLast`, `indexAfter`), so the same argument had a third case it did not
		// cover. Without this arm, `try "abc".findFirst("b") otherwise "abc".startIndex()` is `E2015 …
		// (got 'string literal')` — a legal program refused.
		//
		// ⚠ It calls `parseStringLiteral`, not `consumeStringLiteralValue`, so an INTERPOLATED receiver
		// (`try "a{x}".findFirst("b")`) is enrolled too. That result is an OWNED heap String rather than an
		// immortal rdata one, which needs no special handling here for the array literal's reason: the postfix
		// chain applies its method to the temp and `openTryFork` suspends it across the handler.
		if self.at(TokenKind.stringLiteral) 'stringLiteralTarget'
			return try self.parseStringLiteral(func)
		end 'stringLiteralTarget'

		// ⭐ **`try 'A'.asciiValue() otherwise 0` — A CHARACTER LITERAL RECEIVER, THE FOURTH CASE OF
		// THE ARGUMENT THE TWO NOTES ABOVE ALREADY MAKE.** `Character.asciiValue()` is the type's one throwing
		// member, so `try` is the only way a program calls it, and a literal is the receiver the oracle prints
		// **65** for. `charLiteralOpensTryBlockIn` tells a block LABEL from a receiver by the `.` behind it, which is also
		// why nothing here needs to re-ask: a bare `try 'x'` never gets past `parseTry`.
		if self.at(TokenKind.charLiteral) 'characterLiteralTarget'
			return try self.parseCharLiteral()
		end 'characterLiteralTarget'

		// `try (a / b) otherwise …`: a parenthesized expression as the try target. Division is the only
		// throwing operation written as an operator rather than a call, so it is the only one whose `try`
		// cannot name a callee; `specs/arithmetic-operators.md` documents this as the form.
		//
		// This does not open `try` to arbitrary parenthesized expressions. The group is an ordinary
		// expression, transparent to the claim, and the rewrite takes the op producing its value: a
		// possibly-zero divide left a `call __checked_div` and is converted, a divide whose divisor is proven
		// nonzero left a bare division `binOp` and is E3055, and `try (4 + 5)` left a `binOp` and is refused
		// as not a call. So the accepted set is exactly "the group's outermost
		// operation is fallible", derived from the rule every other try shape uses. A group over a bare
		// name emits no op at all, which `parseTry`'s `targetOpFloor` catches (see `opProducingTheValue`,
		// and `safety.md`'s two `error.try-over-a-parenthesized-…` cases).
		if self.at(TokenKind.leftParen) 'parenthesizedTarget'
			return try self.parseParenthesizedExpression(func)
		end 'parenthesizedTarget'

		// ⭐⭐ **THE GENERAL NAMED TARGET, AND IT IS LAST ON PURPOSE.** `try f(…)` and `try obj.method(…)`
		// where the head is any token that can stand as a NAME — which includes a KEYWORD,
		// because a function and a parameter may be declared with one. `try from.get(k)` on a parameter
		// named `from` (`IR/CsrGraph.maxon:75`) is the shape, and asking `TokenKind.identifier`, which a
		// keyword is not, refuses it `E2015 "try must be applied to a call … (got 'from')"`.
		//
		// ⚠ **IT MOVED DOWN RATHER THAN GAINING AN EXCLUSION LIST, and the difference is the one this file
		// keeps paying for.** Widened in place it would have claimed `Self.check(v)` and `int.fromString(s)`
		// out from under the two arms above that exist to serve them — the `Self` arm's own header says it
		// cannot ride the named arm, and a primitive static reaches `parseDottedPrimary` through neither. The
		// alternative was `tokenCanBeAName(…) and not at(selfType) and not primitiveStaticCallAt(…)`, an
		// enumerated exclusion that goes stale the next time a keyword-headed target earns an arm. Ordering
		// IS the rule here — the router's own header says the field-chain arm is "checked FIRST" for exactly
		// this reason — so the general case goes last and every specific one keeps its claim by standing
		// above it.
		if tokenCanBeAName(self.current()) 'named'
			if self.peekKind() == TokenKind.leftParen 'freeCall'
				return try self.parseCall(func, resultUsed: false)
			end 'freeCall'

			if self.peekKind() == TokenKind.dot 'dotted'
				return try self.parseDottedPrimary(func, resultUsed: false)
			end 'dotted'
		end 'named'

		let tok = self.current()
		throw SourceParseError.unsupported("`try` must be applied to a call — `try f(…)`, `try obj.method(…)`, `try (a / b)`, or `try await p` (got '{tok.kind.rawValue}')", line: tok.line, column: tok.column)
	end 'parseTryCallReceiver'

	// The one reader of which op produced the value the parser just built: the current block's last
	// op, or the op behind it `tryTargetCallOpIndex` steps back to. It must have been emitted at or
	// above `floor`. A group over a bare name emits nothing, and without the floor the last op would
	// be the previous statement's: `let a = arr.get(2)` then `try (a) otherwise 99` would rewrite that
	// accessor, so the handler caught the array's error and the E3057 the bare accessor owed vanished
	// with its `call`.
	function opProducingTheValue(floor ElementIndex) returns ValueProducer
		let refCount = self.bodyState.currentBlock.bodyOpCount()

		if refCount == 0 'theBlockHoldsNoOp'
			return ValueProducer.noOwnOp
		end 'theBlockHoldsNoOp'

		let lastIdx = try self.bodyState.currentBlock.bodyOpAt(refCount - 1) otherwise panic("opProducingTheValue: bodyOpAt OOB on a block whose count was just read as non-zero")

		if lastIdx < floor 'emittedBeforeTheFloor'
			return ValueProducer.noOwnOp
		end 'emittedBeforeTheFloor'

		return ValueProducer.at(self.tryTargetCallOpIndex(lastIdx, refCount: refCount, targetOpFloor: floor))
	end 'opProducingTheValue'

	// A container whose element is a float reads its slot as 64 bits and reinterprets them with a
	// `bitsToFloat` op right after the call (`emitContainerElementAccessor`), and a narrow signed
	// element is sign-extended the same way. That op, not the call, is then the last one, and `try
	// v.get(0) otherwise 0.0` would be refused as not a call; the step back makes the reinterpretation
	// part of the call's result production.
	//
	// It is not a backward scan, and that is the safety argument: it steps back one op, only when that
	// op reinterprets the immediately preceding op's own result (`opReinterpretsResultOf`), and never
	// below `targetOpFloor`. So `try f() + 1` keeps its refusal and nothing reaches a previous
	// statement's call.
	function tryTargetCallOpIndex(lastIdx ElementIndex, refCount ElementIndex, targetOpFloor ElementIndex) returns ElementIndex
		var last = lastIdx
		var count = refCount

		while count >= 2 and self.bodyState.callTrailerOps.contains(last) 'eachCallTrailer'
			let before = try self.bodyState.currentBlock.bodyOpAt(count - 2) otherwise panic("tryTargetCallOpIndex: bodyOpAt OOB at {count - 2} on a block with {count} ops")

			if before < targetOpFloor 'beforeTheTarget'
				break
			end 'beforeTheTarget'

			last = before
			count = count - 1
		end 'eachCallTrailer'

		if count < 2 'noOpBehindIt'
			return last
		end 'noOpBehindIt'

		let prevIdx = try self.bodyState.currentBlock.bodyOpAt(count - 2) otherwise panic("tryTargetCallOpIndex: bodyOpAt OOB at {count - 2} on a block with {count} ops")

		if prevIdx < targetOpFloor 'beforeTheTarget'
			return last
		end 'beforeTheTarget'

		return prevIdx if self.opReinterpretsResultOf(last, producer: prevIdx) else last
	end 'tryTargetCallOpIndex'

	// Is op `idx` a REINTERPRETATION of the value the CALL at `producer` defines — the one shape
	// `tryTargetCallOpIndex` steps back over. Both halves are required: a reinterpretation over anything
	// else, and a reinterpretation sitting behind a non-call, leave the try target where it was.
	//
	// ⭐ **TWO OPS QUALIFY, AND WHAT MAKES THEM QUALIFY IS THAT A USER CANNOT SPELL EITHER.** A float
	// element's `bitsToFloat` and a narrow signed element's sign extension are both emitted by
	// `emitContainerElementAccessor` as part of producing the call's result, so `try v.get(0) otherwise 0.0`
	// and `try arr.get(0) otherwise Signal.zero` are each exactly one call. `try f() + 1` is NOT, and the
	// only thing separating the two is that its `binOp` is the author's — which is why this is a membership
	// test over compiler-only ops and not a shape test over the op graph. (`__Builtins.bitsToFloat(x)` is a
	// CALL, not a bare op, so the author's spelling of the reinterpretation is not in the set either.)
	function opReinterpretsResultOf(idx ElementIndex, producer ElementIndex) returns bool
		return match try self.artifact.module.ops.get(idx) otherwise panic("opReinterpretsResultOf: opRef {idx} not in module.ops") 'reinterpretation'
			unaryOp(_, operand, op) gives unaryOpProducesACallResult(op) and discardedCalleeIsACall(self.directCallDefining(producer, value: operand))
			call or
			literal or
			ret or
			retVoid or
			binOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			tryCall or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			await or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessDispatch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceSend or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd gives false
		end 'reinterpretation'
	end 'opReinterpretsResultOf'

	// The unary ops that are part of a CALL's RESULT PRODUCTION rather than an expression applied to it —
	// the membership `opReinterpretsResultOf` tests. Exhaustive, so a unary op the compiler starts inserting
	// after a call has to be classified here rather than silently breaking a `try` over that call.
	function unaryOpProducesACallResult(op MaxonUnaryOp) returns bool
		return match op 'o'
			neg or
			bitNot or
			logicalNot or
			trunc or
			promoteToFloat or
			promoteUnsignedToFloat or
			floor or
			ceil or
			round or
			sqrt or
			abs or
			fneg or
			floatToBits or
			copy gives false
			bitsToFloat or
			signExtendI8 or
			signExtendI16 or
			signExtendI32 gives true
		end 'o'
	end 'unaryOpProducesACallResult'

	function directCallDefining(idx ElementIndex, value ValueId) returns DiscardedCallee
		return match self.routableOpAt(idx) 'producer'
			call(result, callee, _) gives DiscardedCallee.named(callee, result: result, opIndex: idx) if result == value else DiscardedCallee.notACall
			notRoutable or
			division or
			tryChannelCall or
			witness or
			send or
			await gives DiscardedCallee.notACall
		end 'producer'
	end 'directCallDefining'

	function rewriteLastCallToTryCall(target ValueId, tryTok Token, targetDeferralFloor ElementIndex, targetOpFloor ElementIndex) returns (TryTarget, ValueId) throws SourceParseError
		// Asked before `opProducingTheValue`: a deferred chain whose base emits an op of its own (a
		// captured `var` read through its cell) would otherwise have that unrelated op rewritten as the
		// target.
		if self.artifact.deferredChains.lastLinkIsACallAbove(targetDeferralFloor, funcIndex: self.artifact.currentFuncIndex, valueId: target) 'aDeferredCall'
			return (TryTarget.deferred, self.mintDeferredValue())
		end 'aDeferredCall'

		// `try (a)`, which emits nothing, and `try (a + b)` are refused with one sentence
		// (`notACallTryTarget`): to the author they are one mistake, and one sentence keeps the two
		// spellings from drifting apart. Rewriting in place is what makes nested tries work (`try
		// consume(try get() otherwise 0)`): each inner try rewrites its own op, and the outer's producer
		// is its own call.
		match self.opProducingTheValue(targetOpFloor) 'producer'
			noOwnOp then throw self.notACallTryTarget(tryTok)
			at(opIdx) then return try self.commitTryTargetRewrite(opIdx, tryTok: tryTok)
		end 'producer'
	end 'rewriteLastCallToTryCall'

	function commitTryTargetRewrite(opIdx ElementIndex, tryTok Token) returns (TryTarget, ValueId) throws SourceParseError
		let op = self.routableOpAt(opIdx)

		match op 'rewrite'
			send then return self.rewriteSendToTryChannel(opIdx)
			division(divisionOp) then throw SourceParseError.tryOnTotalDivision(divisionOperatorSpelling(divisionOp), line: tryTok.line, column: tryTok.column)
			notRoutable or
			tryChannelCall then throw self.notACallTryTarget(tryTok)
			call then try self.requireCallCanFail(opIdx, tryTok: tryTok)
			witness or
			await then break
		end 'rewrite'

		let flag = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		return (self.rewriteToTryChannel(opIdx, op: op, flag: flag), flag)
	end 'commitTryTargetRewrite'

	function requireCallCanFail(opIdx ElementIndex, tryTok Token) throws SourceParseError
		let proven = try self.artifact.provenFixedArrayAccesses.get(opIdx) otherwise return
		throw SourceParseError.tryOnProvenFixedArrayAccess(String.from(fixedArrayAccessorMethodName(proven.accessor)), count: proven.count, line: tryTok.line, column: tryTok.column)
	end 'requireCallCanFail'

	function rewriteSendToTryChannel(opIdx ElementIndex) returns (TryTarget, ValueId)
		let sent = recordedSendOf(self.statement.lastSend, opIdx: opIdx)
		let layout = self.sendErrorLayoutOf(sent)
		let status = self.sendStatusOf(opIdx)
		self.statement.unsettledSend = UnsettledSend.settled
		let range = self.artifact.opRanges.get(opIdx)
		let anchor = anchorTokenSpanning(range)
		let (refused, accepted) = self.branchOnSendStatus(status, anchor: anchor)
		let settled = self.artifact.module.addBlock(self.bodyFunction(), label: b"sendsettled", heat: BlockHeat.normal)
		let flag = self.mintPhi(settled, tag: ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.carryWindowBirthFrom(flag, source: sent.staging)

		self.bodyState.currentBlock = accepted
		self.joinSendFlag(accepted, settled: settled, flag: self.emitLiteral(NoErrorFlag, valueType: MaxonType.integer, range: range))

		self.bodyState.currentBlock = refused
		self.joinSendFlag(refused, settled: settled, flag: self.emitRefusedSendFlag(sent, layout: layout, status: status, range: range, anchor: anchor))

		self.bodyState.currentBlock = settled
		return (TryTarget.send(sent.messageName, throwsClause: sent.throwsClause()), flag)
	end 'rewriteSendToTryChannel'

	function branchOnSendStatus(status ValueId, anchor Token) returns (IrBlock, IrBlock)
		let func = self.bodyFunction()
		let refused = self.artifact.module.addBlock(func, label: b"sendrefused", heat: BlockHeat.cold)
		let accepted = self.artifact.module.addBlock(func, label: b"sendaccepted", heat: BlockHeat.normal)

		let isRefused = self.emitCompareAgainstLiteral(status, literal: CownSendStatus.delivered.rawValue, op: MaxonCmpOp.ne, opTok: anchor)
		self.emitCondBranch(self.bodyState.currentBlock, cond: isRefused, thenId: refused.id, elseId: accepted.id, ifTok: anchor)

		return (refused, accepted)
	end 'branchOnSendStatus'

	function joinSendFlag(block IrBlock, settled IrBlock, flag ValueId)
		self.recordBranchEdge(block, targetId: settled.id, argIds: argsOf(flag))
		self.emitBranch(block, targetId: settled.id)
	end 'joinSendFlag'

	function sendErrorLayoutOf(sent SentMessage) returns immutable EnumLayout
		match self.signatures.enumInAnyFile(sent.sendErrorName()) 'registered'
			declared(layout) then return layout
			undeclared then panic("sendErrorLayoutOf: nothing declares `{String.from(sent.sendErrorName())}` —`ServiceCompanions.mintServiceSendErrorTypes` mints one beside every request union, and a send to `{String.from(sent.messageName)}` was parsed")
		end 'registered'
	end 'sendErrorLayoutOf'

	function sendStatusOf(opIdx ElementIndex) returns ValueId
		match try self.artifact.module.ops.get(opIdx) otherwise panic("sendStatusOf: opRef {opIdx} not in module.ops") 'send'
			serviceSend(_, status, _, _, _, _, _, _) then return status
			call(result, _, _, _, _, _, _) then return result
			default panic("sendStatusOf: the op at {opIdx} is neither a mailbox send nor an interface-table send — `routableOpAt` classified it as a send")
		end 'send'
	end 'sendStatusOf'

	function holdTheSendOfAnAwait(promise ValueId, facts AwaitedPromise) returns AwaitedPromise
		match facts.tryTarget 'target'
			serviceReply(messageName, awaitedService) then return self.holdTheSendOfAReply(promise, facts: facts, messageName: messageName, awaitedService: awaitedService)
			named or
			witness or
			promise or
			send or
			sentReply or
			serviceStart or
			deferred then return facts
		end 'target'
	end 'holdTheSendOfAnAwait'

	function holdTheSendOfAReply(promise ValueId, facts AwaitedPromise, messageName ByteArray, awaitedService ByteArray) returns AwaitedPromise
		match self.statement.unsettledSend 'unsettled'
			settled then return facts
			pending(opIdx, range) then return self.holdPendingSendLeg(opIdx, range: range, promise: promise, facts: facts, messageName: messageName, awaitedService: awaitedService)
		end 'unsettled'
	end 'holdTheSendOfAReply'

	function holdPendingSendLeg(opIdx ElementIndex, range SourceRange, promise ValueId, facts AwaitedPromise, messageName ByteArray, awaitedService ByteArray) returns AwaitedPromise
		let sent = recordedSendOf(self.statement.lastSend, opIdx: opIdx)

		if not sent.awaitsCell(promise) 'someOtherPromise'
			return facts
		end 'someOtherPromise'

		self.statement.unsettledSend = UnsettledSend.settled
		let status = self.sendStatusOf(opIdx)
		let anchor = anchorTokenSpanning(range)
		let members = self.sentReplyErrorMembers(messageName, sendErrorName: sent.sendErrorName())
		let sendMember = try members.get(0) otherwise panic("holdPendingSendLeg: `sentReplyErrorMembers` answers the send error first, always")
		let (refused, accepted) = self.branchOnSendStatus(status, anchor: anchor)

		self.bodyState.currentBlock = refused
		let flag = self.emitRefusedSendFlag(sent, layout: sendMember.layout, status: status, range: range, anchor: anchor)
		let fused = self.routedEdgeOrdinalForUnion(sendMember, block: refused, flag: flag, fusedValue: self.routedEdgeFusedValue(sendMember, flag: flag, anchor: anchor), anchor: anchor)
		self.statement.sentLeg = SentLegSlot.held(SentLeg.create(refused.id, flag: flag, fused: fused, members: members))

		self.bodyState.currentBlock = accepted
		return AwaitedPromise.create(facts.result, tryTarget: TryTarget.sentReply(messageName, awaitedService: awaitedService, sendErrorName: sent.sendErrorName()))
	end 'holdPendingSendLeg'

	function mintJoinedError(slot SentLegSlot, handlerFlag ValueId) returns JoinedError
		return match slot 'slot'
			none gives JoinedError.create(handlerFlag, fused: handlerFlag)
			held(leg) gives self.mintHeldJoinedError(leg)
		end 'slot'
	end 'mintJoinedError'

	function mintHeldJoinedError(leg SentLeg) returns JoinedError
		let flag = self.mintDetachedPhi(ValueTypeTag.integer, nameId: UnnamedTypeId)

		if not leg.holdsAUnion() 'oneErrorType'
			return JoinedError.create(flag, fused: flag)
		end 'oneErrorType'

		return JoinedError.create(flag, fused: self.mintDetachedPhi(ValueTypeTag.integer, nameId: UnnamedTypeId))
	end 'mintHeldJoinedError'

	function handlerFusedOrdinal(slot SentLegSlot, handlerFlag ValueId, anchor Token) returns ValueId
		return match slot 'slot'
			none gives handlerFlag
			held(leg) gives self.heldHandlerFusedOrdinal(leg, handlerFlag: handlerFlag, anchor: anchor)
		end 'slot'
	end 'handlerFusedOrdinal'

	function heldHandlerFusedOrdinal(leg SentLeg, handlerFlag ValueId, anchor Token) returns ValueId
		if not leg.holdsAUnion() 'noHandlerMember'
			return handlerFlag
		end 'noHandlerMember'

		let handlerMember = try leg.members.get(1) otherwise panic("heldHandlerFusedOrdinal: a leg that holds a union has two members")
		return self.routedEdgeFusedValue(handlerMember, flag: handlerFlag, anchor: anchor)
	end 'heldHandlerFusedOrdinal'

	function joinSentLeg(join SentLegJoin, errBlock IrBlock)
		match join.slot 'slot'
			none then return
			held(leg) then self.joinHeldSentLeg(leg, join: join, errBlock: errBlock)
		end 'slot'
	end 'joinSentLeg'

	function joinHeldSentLeg(leg SentLeg, join SentLegJoin, errBlock IrBlock)
		self.attachDetachedPhi(errBlock, phi: join.joined.flag)
		let refusedArgs = argsOf(leg.flag)
		let handlerArgs = argsOf(join.handlerFlag)

		if leg.holdsAUnion() 'withTheFusedOrdinal'
			self.attachDetachedPhi(errBlock, phi: join.joined.fused)
			refusedArgs.push(leg.fused)
			handlerArgs.push(join.handlerFused)
		end 'withTheFusedOrdinal'

		let refused = self.blockOfThisBody(leg.refusedId)
		let entry = self.blockOfThisBody(join.entryBlockId)
		self.recordBranchEdge(refused, targetId: errBlock.id, argIds: refusedArgs)
		self.emitBranch(refused, targetId: errBlock.id)
		self.recordBranchEdge(entry, targetId: errBlock.id, argIds: handlerArgs)
	end 'joinHeldSentLeg'

	function blockOfThisBody(id BlockId) returns IrBlock
		return try self.blockById(self.bodyFunction(), id: id) otherwise panic("blockOfThisBody: block {id} is not in the function being parsed — a held send leg names only blocks this body created")
	end 'blockOfThisBody'

	function requireSentReplyPropagates(target TryTarget, tryTok Token) throws SourceParseError
		match target 'kind'
			sentReply(messageName, _, sendErrorName) then try self.requireSentReplyHasOneErrorType(messageName, sendErrorName: sendErrorName, tryTok: tryTok)
			named or
			witness or
			promise or
			send or
			serviceReply or
			serviceStart or
			deferred then return
		end 'kind'
	end 'requireSentReplyPropagates'

	function requireSentReplyHasOneErrorType(messageName ByteArray, sendErrorName immutable ByteArray, tryTok Token) throws SourceParseError
		if self.sentReplyErrorMembers(messageName, sendErrorName: sendErrorName).count() < 2 'oneErrorType'
			return
		end 'oneErrorType'

		let handlerError = try throwsClauseName(self.signatures.throwsOf(messageName)) otherwise panic("requireSentReplyHasOneErrorType: a reply has two error types only when its handler throws")
		throw SourceParseError.errorTypeMismatch("`try await` of '{String.from(messageName)}' can fail at the send ('{String.from(sendErrorName)}') and in the handler ('{handlerError}'), so it has no single error type to propagate — handle it here with `otherwise (e)` and `match e`, or split it: `let p = try h.m(x)` propagates '{String.from(sendErrorName)}', then `try await p` propagates '{handlerError}'", line: tryTok.line, column: tryTok.column)
	end 'requireSentReplyHasOneErrorType'

	function requireSendSettled() throws SourceParseError
		match self.statement.unsettledSend 'unsettled'
			settled then return
			pending(opIdx, range) then throw SourceParseError.registryRefused(ErrorCode.throwingFunctionRequiresTry, explanation: throwingCallRequiresTryMessage(recordedSendOf(self.statement.lastSend, opIdx: opIdx).spelling), line: range.line, column: range.column, note: DiagnosticNote.none)
		end 'unsettled'
	end 'requireSendSettled'

	function requireSendReplyKept(result ValueId, opFloor ElementIndex, anchor DroppedReplyAnchor) throws SourceParseError
		match self.statement.lastSend 'last'
			nothingRecorded then return
			recorded(opIdx, funcIndex, sent) then try self.requireNotADroppedReply(sent, opIdx: opIdx, funcIndex: funcIndex, opFloor: opFloor, result: result, anchor: anchor)
		end 'last'
	end 'requireSendReplyKept'

	function requireNotADroppedReply(sent SentMessage, opIdx ElementIndex, funcIndex ElementIndex, opFloor ElementIndex, result ValueId, anchor DroppedReplyAnchor) throws SourceParseError
		if funcIndex != self.artifact.currentFuncIndex or opIdx < opFloor or not sent.awaitsCell(result) 'noReplyDropped'
			return
		end 'noReplyDropped'

		let range = match anchor 'where'
			atTry(tryTok) gives SourceRange.ofToken(tryTok)
			atTheSend gives self.artifact.opRanges.get(opIdx)
		end 'where'

		throw SourceParseError.registryRefused(ErrorCode.semanticServiceReplyDropped, explanation: serviceReplyDroppedRefusal(sent.spelling), line: range.line, column: range.column, note: DiagnosticNote.none)
	end 'requireNotADroppedReply'

	function emitRefusedSendFlag(sent SentMessage, layout EnumLayout, status ValueId, range SourceRange, anchor Token) returns ValueId
		self.releaseRefusedReply(sent.reply, range: range)
		let tagShift = self.sendErrorTagShift(layout)

		if not layout.carriesPayloads() 'aScalarError'
			return self.emitAddLiteral(status, addend: tagShift + ErrorFlagOrdinalBias, anchor: anchor)
		end 'aScalarError'

		let size = self.emitLiteral(layout.boxSizeBytes() as FullRangeInt, valueType: MaxonType.integer, range: range)
		let box = self.emitBoxAlloc(size, resultTag: ValueTypeTag.named, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)
		self.emitIndirectStore(box, offset: UnionTagOffset, value: self.emitAddLiteral(status, addend: tagShift, anchor: anchor), storageType: MaxonType.integer, range: range)

		let staged = ValueIdArray.create(layout.maxPayloadArity(), zeroed: false)

		for slot in 0 upto layout.maxPayloadArity() 'eachStagedWord'
			self.requireSendErrorSlotMatchesRequest(sent, layout: layout, slot: slot)
			staged.push(self.emitIndirectLoad(MaxonType.integer, box: sent.staging, offset: layout.payloadSlotOffset(slot), storageType: MaxonType.integer, range: range))
		end 'eachStagedWord'

		for slot in 0 upto layout.maxPayloadArity() 'eachArgumentWord'
			self.emitIndirectStore(box, offset: layout.payloadSlotOffset(slot), value: self.emitHandedBackWord(sent, slot: slot, staged: staged, range: range), storageType: MaxonType.integer, range: range)
		end 'eachArgumentWord'

		return box
	end 'emitRefusedSendFlag'

	function requireSendErrorSlotMatchesRequest(sent SentMessage, layout EnumLayout, slot PayloadSlotIndex)
		let full = try layout.indexOfCase(ServiceSendMailboxFullCaseName) otherwise panic("requireSendErrorSlotMatchesRequest: `{String.from(layout.name)}` declares no `{String.from(ServiceSendMailboxFullCaseName)}` case — `buildServiceSendErrorUnion` builds both")
		let argument = try layout.payloadsAt(full).get(slot) otherwise panic("requireSendErrorSlotMatchesRequest: `{String.from(layout.name)}` has no payload slot {slot}, and its arity is {layout.maxPayloadArity()}")
		let claimed = sent.requestPayloadAt(slot)

		if not argument.name.equals(claimed.name) or layout.payloadSlotOffset(slot) != sent.request.payloadSlotOffset(slot) 'slotsDiverged'
			panic("requireSendErrorSlotMatchesRequest: slot {slot} of `{String.from(layout.name)}` is `{String.from(argument.name)}` at offset {layout.payloadSlotOffset(slot)}, while slot {slot} of the request variant `{String.from(sent.messageName)}` is `{String.from(claimed.name)}` at offset {sent.request.payloadSlotOffset(slot)} — a refused send copies a staged word to the send-error slot at its own offset, so the two layouts must agree slot for slot")
		end 'slotsDiverged'
	end 'requireSendErrorSlotMatchesRequest'

	function emitHandedBackWord(sent SentMessage, slot PayloadSlotIndex, staged ValueIdArray, range SourceRange) returns ValueId
		let word = stagedWordAt(staged, slot: slot)

		match sent.handBackOf(slot) 'handBack'
			moved then return word
			copied(clone, release) then return self.emitSharedWordCopiedAndReleased(sent, staged: staged, slot: slot, clone: clone, release: release, range: range)
		end 'handBack'
	end 'emitHandedBackWord'

	function emitSharedWordCopiedAndReleased(sent SentMessage, staged ValueIdArray, slot PayloadSlotIndex, clone ManagedCascadeStrategy, release ByteArray, range SourceRange) returns ValueId
		let copy = self.emitSharedWordCopy(sent, staged: staged, slot: slot, clone: clone, range: range)
		let word = stagedWordAt(staged, slot: slot)

		match clone 'strategy'
			throughWitness then self.emitOwnershipRuntimeCall(release, args: twoArgs(stagedWitnessAt(staged, slot: slot), second: word), range: range)
			direct or
			managedElements then self.emitOwnershipRuntimeCall(release, args: argsOf(word), range: range)
			unsupported then panic("emitSharedWordCopiedAndReleased: slot {slot} of `{String.from(sent.messageName)}` carries a strategy with no copy — `sharedSlotHandBack` hands such a slot back uncopied")
		end 'strategy'

		return copy
	end 'emitSharedWordCopiedAndReleased'

	function emitSharedWordCopy(sent SentMessage, staged ValueIdArray, slot PayloadSlotIndex, clone ManagedCascadeStrategy, range SourceRange) returns ValueId
		let word = stagedWordAt(staged, slot: slot)

		match clone 'strategy'
			direct(callee) then return self.emitRuntimeCall(callee, args: argsOf(word), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
			managedElements(containerCopy, elementCopy) then return self.emitRuntimeCall(containerCopy, args: twoArgs(word, second: self.emitCodeAddress(elementCopy, range: range)), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
			throughWitness(entry) then return self.emitRuntimeCall(entry, args: twoArgs(stagedWitnessAt(staged, slot: slot), second: word), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
			unsupported then panic("emitSharedWordCopy: slot {slot} of `{String.from(sent.messageName)}` carries a strategy with no copy — `sharedSlotHandBack` hands such a slot back uncopied")
		end 'strategy'
	end 'emitSharedWordCopy'

	function sendErrorTagShift(layout EnumLayout) returns FullRangeInt
		let full = try layout.indexOfCase(ServiceSendMailboxFullCaseName) otherwise panic("sendErrorTagShift: `{String.from(layout.name)}` declares no `{String.from(ServiceSendMailboxFullCaseName)}` case — `buildServiceSendErrorUnion` builds both")
		let stopped = try layout.indexOfCase(ServiceSendServiceStoppedCaseName) otherwise panic("sendErrorTagShift: `{String.from(layout.name)}` declares no `{String.from(ServiceSendServiceStoppedCaseName)}` case — `buildServiceSendErrorUnion` builds both")
		let shift = layout.tagOfIndex(full) - CownSendStatus.full.rawValue

		if layout.tagOfIndex(stopped) - CownSendStatus.stopped.rawValue != shift 'statusesDrifted'
			panic("sendErrorTagShift: `{String.from(layout.name)}` tags `full` and `stopped` {layout.tagOfIndex(stopped) - layout.tagOfIndex(full)} apart, while `CownSendStatus` numbers them {CownSendStatus.stopped.rawValue - CownSendStatus.full.rawValue} apart — the runtime answers the status and the tag is derived from it by one shift")
		end 'statusesDrifted'

		return shift
	end 'sendErrorTagShift'

	function releaseRefusedReply(reply ServiceReplyValue, range SourceRange)
		match reply 'reply'
			fireAndForget then return
			cell(promise) then _ = self.emitRuntimeCall(CownReplyRefusedName, args: argsOf(promise), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'reply'
	end 'releaseRefusedReply'

	function rewriteToTryChannel(opIdx ElementIndex, op RoutableOp, flag ValueId) returns TryTarget
		return match op 'rewrite'
			call gives self.tryTargetOfCallee(self.commitTryCallRewrite(opIdx, errorFlag: flag))
			witness gives self.commitWitnessTryDispatchRewrite(opIdx, flag: flag)
			await (result, promise) gives self.commitTryAwaitRewrite(opIdx, result: result, flag: flag, promise: promise)
			notRoutable or
			division or
			send or
			tryChannelCall panic("rewriteToTryChannel: the op at {opIdx} is neither a call, a witness dispatch nor an await — both callers classify it with `routableOpAt` first")
		end 'rewrite'
	end 'rewriteToTryChannel'

	// The one builder of `TryTarget.named`, so a `named` callee always has a definition and an
	// undeclared one is compiler-internal — `tryTargetNamedNoun` and `requireThrowingNamedTryTarget`
	// rest on that.
	function tryTargetOfCallee(callee ByteArray) returns TryTarget
		if self.signatures.definesCallee(callee) 'theSignaturesAnswerForIt'
			return TryTarget.named(callee)
		end 'theSignaturesAnswerForIt'

		return TryTarget.deferred
	end 'tryTargetOfCallee'

	// Replace the `witnessDispatch` at `opIdx` with a `witnessTryDispatch` and return the interface
	// method's name and declared `throws`. The op carries neither — both are facts of the constraint
	// resolution, and an op field would be paid for by every dispatch to answer a question only a
	// `try` asks — so the dispatch records them as it emits (`lastWitnessDispatch`) and this reads
	// them back. A non-throwing method rewritten here is E3055, reported by `requireThrowingTryTarget`
	// off the `none` clause, as for a non-throwing direct callee.
	function commitWitnessTryDispatchRewrite(opIdx ElementIndex, flag ValueId) returns TryTarget
		// CHECKED BEFORE THE REWRITE, not after: a stale record would mean the target's name and throws clause
		// belong to some OTHER dispatch, and rewriting first would leave a half-converted op behind the panic.
		let target = recordedTryTargetOf(self.statement.lastWitnessDispatch, opIdx: opIdx)

		match try self.artifact.module.ops.get(opIdx) otherwise panic("commitWitnessTryDispatchRewrite: opIdx {opIdx} not in module.ops") 'w'
			witnessDispatch(result, args, argImmutableNames, witness, methodIndex, interfaceDeclIndex, isVoid, _) then try self.artifact.module.ops.set(opIdx, value: MaxonOp.witnessTryDispatch(result, errorFlag: flag, args: args, argImmutableNames: argImmutableNames, witness: witness, methodIndex: methodIndex, interfaceDeclIndex: interfaceDeclIndex, isVoid: isVoid)) otherwise panic("commitWitnessTryDispatchRewrite: module.ops.set OOB at {opIdx}")
			default panic("commitWitnessTryDispatchRewrite: the op at {opIdx} is not a `witnessDispatch` — `rewriteLastCallToTryCall`'s match routes only that arm here")
		end 'w'

		return target
	end 'commitWitnessTryDispatchRewrite'

	// Replace the `call` op at `opIdx` with a `tryCall` defining the second `errorFlag` result, preserving
	// every call field, and return the callee name.
	// `mint` crosses the rewrite with every other operand: a `try int.fromString(s)` is the SAME call, and
	// the noun its E3036 would name does not change because the error flag became a second result.
	function commitTryCallRewrite(opIdx ElementIndex, errorFlag ValueId) returns immutable ByteArray
		match try self.artifact.module.ops.get(opIdx) otherwise panic("commitTryCallRewrite: opRef {opIdx} not in module.ops") 'rewrite'
			call(result, callee, args, argLabels, argRanges, argImmutableNames, mint) then return self.commitTryCallOp(opIdx, result: result, errorFlag: errorFlag, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, mint: mint)
			default panic("commitTryCallRewrite: the op at {opIdx} is not a `call` — `routableOpAt` classified it as one")
		end 'rewrite'
	end 'commitTryCallRewrite'

	function commitTryCallOp(opIdx ElementIndex, result ValueId, errorFlag ValueId, callee immutable ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames NameRoster, mint CalleeMint) returns immutable ByteArray
		try self.artifact.module.ops.set(opIdx, value: MaxonOp.tryCall(result, errorFlag: errorFlag, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, mint: mint)) otherwise panic("commitTryCallOp: module.ops.set OOB at {opIdx}")
		return callee
	end 'commitTryCallOp'

	// Replace the `await` at `opIdx` with a `tryAwait` and return the target the desugar asks its
	// questions of — the awaited callee for a spawn, the storage type for a promise out of a
	// container. `emitAwaitOp` records it from the same `awaitedPromiseFacts` it mints the result type
	// from, so the two are one derivation.
	function commitTryAwaitRewrite(opIdx ElementIndex, result ValueId, flag ValueId, promise ValueId) returns TryTarget
		let target = recordedTryTargetOf(self.statement.lastAwait, opIdx: opIdx)
		try self.artifact.module.ops.set(opIdx, value: MaxonOp.tryAwait(result, errorFlag: flag, promise: promise)) otherwise panic("commitTryAwaitRewrite: module.ops.set OOB at {opIdx}")
		return target
	end 'commitTryAwaitRewrite'

	// The AWAITED callee name a promise handle carries — recovered from the `asyncCall` op that minted it, by
	// scanning this function's emitted blocks. A promise ValueId is minted by exactly ONE `asyncCall` in its
	// OWN function (the promise mark is per-function, so the search never crosses a frame), so the first match
	// is THE one. `none` means the value is not an async spawn's result — the caller reports its own
	// "not a promise" / invariant diagnostic. Read at the `try await`/plain-`await` sites (rare), so an
	// O(function ops) scan costs nothing on the await-free program and keeps the promise → callee fact off
	// every value (no per-value column that the scale corpus, which has no async, would pay for).
	//
	// ⭐ **A RE-ARMED `var`'s PROMISE IS A MERGE PHI** — no `asyncCall` defines it
	// directly, so the direct scan misses and the resolution TRACES the phi's incoming edge values to a
	// defining `asyncCall`. A promise var's phi merges promises on every reaching edge (all from `async
	// <callee>` of the same consistently-typed binding), so the first one reached answers for the awaited
	// result type and the throws check. A `Set` of visited values breaks loop back-edge cycles.
	function asyncCallCalleeOf(func IrFunction, promise ValueId) returns AsyncCalleeLookup
		let visited = AsyncCalleeVisited.create()
		return self.resolveAsyncCallee(func, promise: promise, visited: visited)
	end 'asyncCallCalleeOf'

	function resolveAsyncCallee(func IrFunction, promise ValueId, visited AsyncCalleeVisited) returns AsyncCalleeLookup
		if visited.contains(promise) 'seen'
			return AsyncCalleeLookup.none
		end 'seen'

		visited.insert(promise)

		for blockRef in func.blockRefs 'eachBlock'
			let block = try self.artifact.module.blocks.get(blockRef) otherwise panic("resolveAsyncCallee: blockRef from func.blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				match asyncCalleeIfMatch(try self.artifact.module.ops.get(opIdx) otherwise panic("resolveAsyncCallee: opIdx {opIdx} not in module.ops"), promise: promise) 'm'
					found(callee) then return AsyncCalleeLookup.found(callee)
					serviceReply(messageName, awaitedService) then return AsyncCalleeLookup.serviceReply(messageName, awaitedService: awaitedService)
					none then break
				end 'm'
			end 'eachOp'
		end 'eachBlock'

		// Not defined by an `asyncCall` directly — trace a merge phi's incoming values.
		for incoming in self.phiIncomingValues(func, phi: promise) 'eachIncoming'
			match self.resolveAsyncCallee(func, promise: incoming, visited: visited) 'r'
				found(callee) then return AsyncCalleeLookup.found(callee)
				serviceReply(messageName, awaitedService) then return AsyncCalleeLookup.serviceReply(messageName, awaitedService: awaitedService)
				none then break
			end 'r'
		end 'eachIncoming'

		return AsyncCalleeLookup.none
	end 'resolveAsyncCallee'

	// The values that flow INTO `phi` on each predecessor edge, if `phi` is a merge block-arg — else empty. A
	// ValueId is a block-arg of exactly ONE block (SSA), so the first block carrying it is THE one; the phi's
	// slot in that block's `blockArgs` indexes each incoming edge's `argIds` (recorded in lockstep — an edge
	// exists in `branchEdges` iff its target carries block-args, so every edge into this block has one).
	function phiIncomingValues(func IrFunction, phi ValueId) returns ValueIdArray
		let incoming = ValueIdArray.create(0)

		for blockRef in func.blockRefs 'eachBlock'
			let block = try self.artifact.module.blocks.get(blockRef) otherwise panic("phiIncomingValues: blockRef from func.blockRefs not in module.blocks")

			for slot in 0 upto block.blockArgs.count() 'eachArg'
				let arg = try block.blockArgs.get(slot) otherwise panic("phiIncomingValues: blockArgs.get OOB at {slot}")

				if arg.valueId == phi 'isPhi'
					for predRef in func.blockRefs 'eachPred'
						let pred = try self.artifact.module.blocks.get(predRef) otherwise panic("phiIncomingValues: predRef not in module.blocks")

						for edge in pred.branchEdges 'eachEdge'
							if edge.targetBlockId == block.id 'intoBlock'
								incoming.push(try edge.argIds.get(slot) otherwise panic("phiIncomingValues: an edge into block {block.id} carries {edge.argIds.count()} args but the phi is at slot {slot} — edge args must be lockstep with block args"))
							end 'intoBlock'
						end 'eachEdge'
					end 'eachPred'

					return incoming
				end 'isPhi'
			end 'eachArg'
		end 'eachBlock'

		return incoming
	end 'phiIncomingValues'

	// **E3055 — the `try` target's terminal call must be one that CAN throw.** Anchored on the `try` token,
	// which is why it lives here and not in SemanticCheck (see `SourceParseError.tryOnNonThrowing`).
	//
	// ⭐ **THERE ARE TWO CALLEE CLASSES, AND BOTH ARE ASKED.** A COMPILER-EMITTED
	// callee (`__managed_count`, `__print_string`, `__managed_append`) is in no signature registry, so
	// `declaresCallee` answers `false` for it — asking that alone waves every non-throwing builtin
	// through: `try arr.count()` and `try print("x")` compile, and the desugar then branches on an
	// error-flag register the callee never wrote — a `try` that takes its error path on whatever the
	// ABI left in R10. `isThrowingRuntimeCallee` is THE ONE home of "which builtin throws" (a throwing
	// array accessor, or `__Builtins.runProcess`), and this is the exact mirror of
	// `SemanticCheck.validatePlainCall`, which reads the SAME predicate to report the opposite mistake
	// (E3057 — a throwing builtin called WITHOUT `try`). Neither can drift from the other.
	//
	// A callee NO file declares is left to SemanticCheck's E3004: a `try <typo>` is an unknown function, not a
	// non-throwing one.
	//
	// ⭐⭐ **AND THE DECLARED CALLEE IS ASKED FIRST, BECAUSE "COMPILER-INTERNAL" DOES NOT IMPLY
	// "UNDECLARED".** `stdlib/Builtins.maxon` declares `__int_fromString(…) throws ParseError` and CALLS it,
	// and a `__`-first order answers that call's question from the builtin roster — which of course does not
	// list it — refusing the module's own `try __int_fromString(input)` as *"this builtin call cannot fail"*
	// (E3055). A DECLARED callee's `throws` clause is written in the program; nothing about the shape of its
	// name can outrank it.
	//
	// ⚠ **AND IT ASKS `declaresCallee`, WHICH IS WHERE A PER-CALL PREDICATE BELONGS.** `returnTypeOf` answers
	// the same question by ADOPTING the return type into this file's interner, so it allocates a `CalleeReturn`
	// per ask; in front of the builtin arm that lands on every `try` over an array accessor or a checked divide
	// in the program — MEASURED on the scale ladder as +52 allocations at rung 0 doubling to +1,664 at rung 5,
	// a per-site constant, which is what a `Map.contains` half of that pair exists to avoid. It is also the one
	// `requireCalleeIsNotReservedName` asks, so the door that ADMITS a reserved call and the check that reads
	// its `throws` clause cannot disagree about whether the name has a declaration.
	//
	// A WITNESS target answers from its OWN clause, and it has no "undeclared" escape. An interface method is
	// in NO signature registry, so routing it through `declaresCallee` would answer `false` and wave every
	// non-throwing interface method through — this very hole, arriving from the other side. Its `throws` is a
	// fact the constraint resolution already established, so the test is unconditional.
	function requireThrowingTryTarget(target TryTarget, tryTok Token) throws SourceParseError
		match target 'kind'
			named(callee) then try self.requireThrowingNamedTryTarget(callee, tryTok: tryTok)
			witness(methodName, throwsClause) then try requireThrowingClauseTryTarget(methodName, throwsClause: throwsClause, tryTok: tryTok)
			promise(methodName, throwsClause) then try requireThrowingClauseTryTarget(methodName, throwsClause: throwsClause, tryTok: tryTok)
			send(methodName, throwsClause) then try requireThrowingClauseTryTarget(methodName, throwsClause: throwsClause, tryTok: tryTok)
			serviceReply(messageName, _) then try requireThrowingClauseTryTarget(messageName, throwsClause: self.signatures.throwsOf(messageName), tryTok: tryTok)
			serviceStart(factory, _) then try requireThrowingClauseTryTarget(factory, throwsClause: self.signatures.throwsOf(factory), tryTok: tryTok)
			sentReply or
			deferred then break
		end 'kind'
	end 'requireThrowingTryTarget'

	// The `named` half of the check above. An undeclared callee here is compiler-internal (see
	// `tryTargetOfCallee`), so the builtin roster answers for it.
	function requireThrowingNamedTryTarget(callee ByteArray, tryTok Token) throws SourceParseError
		if self.signatures.declaresCallee(callee) 'declared'
			if not throwsClauseIsThrowing(self.signatures.throwsOf(callee)) 'nonThrowing'
				throw SourceParseError.tryOnNonThrowing(String.from(callee), line: tryTok.line, column: tryTok.column)
			end 'nonThrowing'

			return
		end 'declared'

		if isThrowingRuntimeCallee(callee) 'throwingAccessor'
			return
		end 'throwingAccessor'

		// A total remainder is the one non-throwing callee whose name the author did not write — they
		// wrote an operator — so the builtin sentence below would call their `mod` "this builtin call".
		// Every other `__` callee here is a method or a `print` the author spelled.
		let divisionKind = divisionKindOf(callee)

		match divisionKind 'totalDivision'
			guardedRemainder then throw SourceParseError.tryOnTotalDivision(divisionOperatorSpellingForKind(divisionKind), line: tryTok.line, column: tryTok.column)

			// The two `__checked_*` names are throwing and returned above; `notCheckedDivision` is every other
			// builtin, which the sentence below is for.
			quotient or
			remainder then panic("requireThrowingNamedTryTarget: '{String.from(callee)}' is a THROWING division, so `isThrowingRuntimeCallee` must have accepted the `try` already — reaching here means `divisionKindThrows` and that predicate disagree")
			notCheckedDivision then break
		end 'totalDivision'

		throw SourceParseError.tryOnNonThrowingBuiltin(tryTok.line, column: tryTok.column)
	end 'requireThrowingNamedTryTarget'

	function notACallTryTarget(tryTok Token) returns SourceParseError
		return SourceParseError.unsupported("`try` must be applied to a call — `try f(…)` or `try obj.method(…)`; the expression after `try` is not a call", line: tryTok.line, column: tryTok.column)
	end 'notACallTryTarget'

	// Build the flag split + handler + merge for a parsed `tryCall`. `result` is the success value,
	// `flag` its error flag, both defined by the `tryCall` in `currentBlock`.
	function desugarTry(func IrFunction, tryTok Token, result ValueId, flag ValueId, target TryTarget, resultUsed bool, tempFloor ElementIndex, leg SentLegSlot) returns ValueId throws SourceParseError
		if not self.at(TokenKind.otherwise) 'propagate'
			try self.requireSentReplyPropagates(target, tryTok: tryTok)
			let calleeThrows = self.tryTargetThrows(target)
			let reportsTheThrow = self.testBodyAbsorbs(calleeThrows)

			if not reportsTheThrow 'propagatesToTheCaller'
				try self.checkPropagateType(func, throwsClause: calleeThrows, tryTok: tryTok)
			end 'propagatesToTheCaller'

			self.forkOntoPropagatingHandler(func, flag: flag, clause: calleeThrows, result: result, anchor: tryTok, reportsTheThrow: reportsTheThrow, leg: leg)

			// A propagating `try` in statement position whose callee can only ever throw has an ok edge
			// control never takes, so the block ends here. An `otherwise` catches the error and control
			// comes back, and a value-position `let x = try f()` is left alone, since ending the block would
			// put a definition in a block nothing enters.
			//
			// Only after the fork is finished: `finishTerminatedTry` has left control in the ok block with
			// the result back on the pending list, and `resumeForkTemps` has handed the fork's temporaries
			// back, so this is the first point at which the pending list is the one the drain must clear.
			if not resultUsed and self.tryTargetAlwaysThrows(target) 'theCalleeNeverComesBack'
				self.endBlockAfterUnreachableTail(func, anchor: tryTok, tempFloor: tempFloor)
			end 'theCalleeNeverComesBack'

			return result
		end 'propagate'

		let fork = self.openTryFork(func, flag: flag, result: result, anchor: tryTok, leg: leg)
		let enclosingStart = self.bodyState.statementStart
		let enclosingFacts = self.suspendStatementFacts()
		let handler = try self.parseOtherwiseHandler(func, result: result, flag: fork.errFlag, fused: fork.errFused, target: target, resultUsed: resultUsed, tryTok: tryTok)
		self.bodyState.statementStart = enclosingStart
		self.resumeStatementFacts(enclosingFacts)
		let errEnd = self.bodyState.currentBlock
		let errMoveMark = self.captureMoveMark()

		let merged = match handler 'h'
			terminated gives self.finishTerminatedTry(fork, result: result)
			value(otherwiseValue) gives try self.finishValueTry(func, okBlock: fork.okBlock, errEnd: errEnd, result: result, resultWasPending: fork.resultWasPending, otherwiseValue: otherwiseValue, entryMoveMark: fork.entryMoveMark, tryTok: tryTok)
			fellThrough gives try self.finishFellThroughTry(func, okBlock: fork.okBlock, errEnd: errEnd, entryVals: fork.entryVals, result: result, resultWasPending: fork.resultWasPending, resultUsed: resultUsed, entryMoveMark: fork.entryMoveMark, errMoveMark: errMoveMark, tryTok: tryTok)
		end 'h'

		// LAST, and after the finish: `finishValueTry` drains the FALLBACK's own temporaries on the error edge
		// with a whole-statement floor, and would sweep these with them if they were back on the list.
		self.resumeForkTemps(fork.forkTemps, suspendedMark: fork.suspendedMark)
		return merged
	end 'desugarTry'

	function forkOntoPropagatingHandler(func IrFunction, flag ValueId, clause ThrowsClause, result ValueId, anchor Token, reportsTheThrow bool, leg SentLegSlot)
		let fork = self.openTryFork(func, flag: flag, result: result, anchor: anchor, leg: leg)

		if reportsTheThrow 'anUncaughtThrowInATest'
			self.emitUncaughtTestThrow(fork.errFlag, throwsClause: clause, anchor: anchor)
		end 'anUncaughtThrowInATest' else 'republishTheFlag'
			self.emitFunctionExit(self.bodyState.currentBlock, exit: FunctionExit.propagate(fork.errFlag), anchor: anchor)
		end 'republishTheFlag'

		_ = self.finishTerminatedTry(fork, result: result)
		self.resumeForkTemps(fork.forkTemps, suspendedMark: fork.suspendedMark)
	end 'forkOntoPropagatingHandler'

	function emitErrorFlagTest(flag ValueId, op MaxonCmpOp, anchor Token) returns ValueId
		return self.emitCompareAgainstLiteral(flag, literal: NoErrorFlag, op: op, opTok: anchor)
	end 'emitErrorFlagTest'

	// The fork's temporaries belong to the enclosing expression, which is only half-built when the
	// `try` forks: a path that goes on to finish it keeps them, and a path that abandons it releases
	// them on its way out. Releasing them at the head of `tryok` frees a value the expression stores a
	// few ops later (`specs/try-fork-pending-temporaries.md`).
	//
	// Abandoning is a property of a path, not of a handler: a handler that falls through its `end` can
	// still leave by an inner `return`. So while the handler parses, the temporaries are enrolled as
	// anonymous owned bindings (`suspendForkTempsAsOwned`), and every exit's existing scope drops
	// release them:
	//   • `return` / `throw` — `emitHandoffExit`, which drops the in-scope list and restores it,
	//     so two sibling exits each release them on their own path;
	//   • a propagating handler — `forkOntoPropagatingHandler`'s whole-function scope drops;
	//   • `break` / `continue` — `dropTargetBodyOwned`: a target outside the `try` recorded its floor
	//     below this enrolment and releases them, and a loop opened inside the handler recorded its
	//     floor above it and does not;
	//   • `panic` — releases no owned binding and aborts;
	//   • falling through the handler's `end` — `closeBlock` pops only above its own mark, so the
	//     merged path still owns them.
	// The block form's `tryBlockThrowEdgeTarget` applies the same rule: release per abandoning path,
	// never per construct.
	//
	// They come off `pendingTempDrops` for the handler's duration because a handler's own
	// statement-end drains read the whole list and would sweep and forget them, leaking on the ok
	// path; `resumeForkTemps` hands them back once both edges are wired.
	function openTryFork(func IrFunction, flag ValueId, result ValueId, anchor Token, leg SentLegSlot) returns TryFork
		let isErr = self.emitErrorFlagTest(flag, op: MaxonCmpOp.ne, anchor: anchor)

		// The result is owned only on the ok edge: on `tryerr` its register is NULL, and a handler exit
		// that drains the pending list (`otherwise return`/`throw`) would decref it. So it comes off the
		// list here, by membership (see `takeOffPendingTemps`), and `TryFork.resultWasPending` carries
		// that answer to every finish path that re-homes it on the ok side.
		//
		// Before `takeForkTemps`: the suspension enrols what the fork still owes as owned bindings, which
		// every abandoning exit releases, so a result left on the list would be decref'd on the error
		// edge.
		let resultWasPending = self.takeOffPendingTemps(result)
		let entryBlock = self.bodyState.currentBlock
		let okBlock = self.artifact.module.addBlock(func, label: b"tryok", heat: BlockHeat.normal)
		let errBlock = self.artifact.module.addBlock(func, label: b"tryerr", heat: BlockHeat.normal)
		let forkTemps = self.takeForkTemps()
		let suspendedMark = self.suspendForkTempsAsOwned(forkTemps)

		let handlerFused = self.handlerFusedOrdinal(leg, handlerFlag: flag, anchor: anchor)
		let joined = self.mintJoinedError(leg, handlerFlag: flag)
		self.joinSentLeg(SentLegJoin.create(leg, entryBlockId: entryBlock.id, handlerFlag: flag, handlerFused: handlerFused, joined: joined), errBlock: errBlock)
		self.emitCondBranch(entryBlock, cond: isErr, thenId: errBlock.id, elseId: okBlock.id, ifTok: anchor)

		// Values entering both branches: the ok path leaves the carried vars unchanged, so `entryVals`
		// is what it carries; the error handler may reassign them (`otherwise 'err' result = 42`).
		//
		// ⚠ Both snapshots are taken AFTER the suspension above, and that order is load-bearing:
		// `restoreMoveMark` PANICS unless the owned-binding height it rewinds to is the one it captured, so
		// an enrolment made between the two would abort the compiler rather than misbehave quietly.
		let entryVals = self.snapshotBindings(self.bodyState.mutableVars)

		// ⭐ **AND THE SAME SNAPSHOT FOR THE DROP-GATING BIT.** The ok edge leaves this fork having moved
		// nothing (the handler is the only thing parsed between here and the merge), so `entryMoveMark` IS
		// the ok edge's move state — which makes it both the state to rewind to when the handler terminates
		// and the ok edge's half of the reconciliation when it does not. `parseIfStatement` captures its
		// `entryMoveMark` at the identical point for the identical pair of uses.
		let entryMoveMark = self.captureMoveMark()

		self.bodyState.currentBlock = errBlock
		return TryFork.create(okBlock, forkTemps: forkTemps, suspendedMark: suspendedMark, entryVals: entryVals, entryMoveMark: entryMoveMark, resultWasPending: resultWasPending, errFlag: joined.flag, errFused: joined.fused)
	end 'openTryFork'

	// ⭐⭐ **RECONCILE THE MOVE STATE OF A MERGE WITH TWO LIVE EDGES** — an `if`'s two branches, a `try`'s ok
	// edge and handler, a short-circuit's skip edge and right-hand side. A binding moved on one edge and live on
	// the other is dropped on the live edge and marked uniformly moved past the merge (`reconcileMovesAtMerge`).
	//
	// Called BEFORE the edges' branches are emitted: each decref is appended to the edge block that owes it, and
	// has to land ahead of that block's jump to the continuation.
	function reconcileMovesAtTwoEdgeMerge(a IrBlock, markA MoveMark, b IrBlock, markB MoveMark, anchor Token)
		let moveEdges = ReachingMoveEdgeArray.create(2, zeroed: false)
		moveEdges.push(ReachingMoveEdge.create(a, mark: markA))
		moveEdges.push(ReachingMoveEdge.create(b, mark: markB))
		self.reconcileMovesAtMerge(moveEdges, anchor: anchor)
	end 'reconcileMovesAtTwoEdgeMerge'

	// The error handler TERMINATED (propagate / return / break / continue / throw / panic): only the ok
	// block reaches the continuation. Restore the carried vars AND the drop-gating move state to their
	// pre-try values (neither the error path's reassignments nor its MOVES reach here — it dropped its own
	// live values on the way out) and continue in the ok block.
	function finishTerminatedTry(fork TryFork, result ValueId) returns ValueId
		self.restoreBindings(self.bodyState.mutableVars, snapshot: fork.entryVals)
		self.restoreMoveMark(fork.entryMoveMark)
		self.bodyState.currentBlock = fork.okBlock

		// The handler terminated, so only `okBlock` continues and the result is live there. `openTryFork`
		// took it off the pending list because its register is NULL on the error edge; it goes back on
		// only if it was there, so the ok continuation binds it or drains it on the ok path alone.
		self.returnToPendingTemps(result, wasPending: fork.resultWasPending)
		return result
	end 'finishTerminatedTry'

	// `otherwise <expr>` — both edges reach a fresh continuation carrying a result phi of `result` (ok)
	// and `otherwiseValue` (err). No carried-var phis: an `otherwise` VALUE is an expression, which
	// assigns no binding, so the ok and err edges agree on every carried var.
	function finishValueTry(func IrFunction, okBlock IrBlock, errEnd IrBlock, result ValueId, resultWasPending bool, otherwiseValue ValueId, entryMoveMark MoveMark, tryTok Token) returns ValueId throws SourceParseError
		// CONSUMER GUARD for the void-result invariant the producer enforces: a void `try`-result
		// has no width, so a value merge is ill-formed and `mintPhi` below would build a void phi block-arg
		// lowering can't type. `parseUnboundOtherwiseForm`'s value-form guard already rejects it (E3059) —
		// it is the ONE `TryHandler.value` producer and runs strictly before here — so this can only trip on
		// a FUTURE value-handler producer that forgets the check, and it names that invariant rather than
		// deferring the crash to a confusing `valueTagToStdType` lowering panic.
		if self.tagOf(result) == ValueTypeTag.void 'voidResultPhi'
			panic("finishValueTry: a void try-result reached the value merge — parseUnboundOtherwiseForm's value-form guard must reject `try <voidCall> otherwise <value>` before here")
		end 'voidResultPhi'

		// ⭐ **REJECT AN OPAQUE-`T` TRY-MERGE THAT WOULD NEED A DESCRIPTOR-GATED INCREF/COPY.**
		// The owned reconciliation below assumes a CONCRETE managed pointer: it increfs the borrowed
		// OK result (`__mm_incref`), retains a borrowed String fallback (`retainBorrowedByteRecord`), or increfs an
		// aliased owned fallback (`transferFallbackToPhi`). For an OPAQUE `typeParameter` element every one of
		// those is WRONG — a trivial instantiation's word is a RAW SCALAR a plain `__mm_incref` faults on
		// (access violation), and a managed one needs the enclosing instance's descriptor to pick the retain. So
		// a `try <opaqueArr>.get/first/last(…) otherwise <owned>` (a borrow merged with an owned fallback) or a
		// `try <opaqueArr>.pop/remove(…) otherwise <value>` (an owned move-out merged with a fallback value) is a
		// clean E2015, since no descriptor-gated reconciliation exists. A DIVERGING otherwise
		// (`otherwise return`/`throw`/`panic`) routes to `finishTerminatedTry` and never reaches here — that plain
		// borrow / move-out is exactly what is supported. Only the opaque array accessors produce a
		// `typeParameter` try-result, so the tag is the
		// whole test; a value fallback that must be reconciled is signalled by either side owning heap.
		if self.tagOf(result) == ValueTypeTag.typeParameter and (self.valueIsOwnedHeap(result) or self.valueIsOwnedHeap(otherwiseValue)) 'opaqueTryMerge'
			throw SourceParseError.unsupported("a `try` on an opaque type-parameter array accessor (`get`/`first`/`last`/`pop`/`remove` on an `Array with <type parameter>` field) with a VALUE `otherwise <expr>` — reconciling the borrowed/moved-out element with the fallback at the `try` continuation needs an incref or a copy the shared body cannot pick statically (the element is a raw scalar for a trivial instantiation and a managed pointer for another). Use a DIVERGING `otherwise` (`otherwise return`/`throw`/`panic`) instead — the plain borrow (`get`/`first`/`last`) and move-out (`pop`/`remove`) are supported that way.", line: tryTok.line, column: tryTok.column)
		end 'opaqueTryMerge'

		try self.refuseExistentialValueMerge(self.tagOf(result), what: "the result of a `try … otherwise <expr>`", tok: tryTok)
		self.admitUnsignedLiteralBeside(otherwiseValue, partner: result)

		let cont = self.artifact.module.addBlock(func, label: b"trycont", heat: BlockHeat.normal)
		let joinedAtTheFallback = self.otherwiseJoinsAtARuntimeSizedFixedArray(otherwiseValue, result: result)
		let phiTypeSource = otherwiseValue if joinedAtTheFallback else result
		let phiId = self.mintPhi(cont, tag: self.tagOf(phiTypeSource), nameId: try self.bodyState.valueNameIds.get(phiTypeSource) otherwise panic("finishValueTry: the merge's type source has no name column"))

		// The merge wears the try-result's brand, or the runtime-sized fallback's where the two join there.
		self.brandValue(phiId, brand: self.brandOf(phiTypeSource))
		let tryArms = argsOf(result)
		tryArms.push(otherwiseValue)
		self.carryMergeOrigin(phiId, arms: tryArms, anchor: tryTok)
		try self.joinMergeCapability(phiId, arms: tryArms, func: func, anchor: tryTok)

		// A managed result phi is owned: it is the sole owner of whichever value reaches the merge and is
		// dropped once at its scope exit, so each edge transfers one owned reference in. The ok `result`
		// came off the pending list at the fork (`openTryFork`); the err `otherwiseValue` is reconciled
		// here. `requireOtherwiseMatchesResult` already refused a fallback whose type could not merge,
		// and a deferred fallback reaches the merge as it is. A scalar result keeps a borrowed phi.
		//
		// The two kinds of managed fallback are reconciled by different doors, and the split keeps the
		// count at one: a borrowed fallback is minted a reference of its own by
		// `promoteBorrowedMergeEdge`, the helper a `match`/ternary arm's borrowed give goes through,
		// which states why running `transferFallbackToPhi` on top would leak; an already-owned fallback
		// settles with its existing owner in `transferFallbackToPhi`. The error edge is `currentBlock`
		// here, the block the promotion must land in.
		//
		// A promise result owns a green thread rather than heap, so it has its own arm: the fallback
		// promise moves into the phi (`moveGreenThreadResultIntoPhi`), and the phi is enrolled pending
		// once, so exactly one owner drops or awaits whichever thread reaches the merge.
		var errEdgeValue = otherwiseValue
		var phiOwned = false
		var phiOwnsAGreenThread = false

		if self.valueIsOwnedHeap(result) 'managedResultPhi'
			if self.valueIsOwnedHeap(otherwiseValue) 'ownedFallback'
				self.transferFallbackToPhi(errEdgeValue, tryTok: tryTok)
			end 'ownedFallback' else if self.borrowedValueOwesAHandoffReference(otherwiseValue) 'promoteBorrowedFallback'
				errEdgeValue = try self.promoteBorrowedMergeEdge(otherwiseValue, edgeBlock: self.bodyState.currentBlock, anchor: tryTok)
			end 'promoteBorrowedFallback' else if not self.valueIsDeferred(otherwiseValue) 'aResolvedUnownedFallback'
				panic("finishValueTry: a resolved fallback that owns no heap met an owned try-result — `refuseOtherwiseMismatch` refuses that pair unless the fallback is a deferred call result")
			end 'aResolvedUnownedFallback'

			phiOwned = true
		end 'managedResultPhi' else if resultWasPending 'aGreenThreadResult'
			try self.moveGreenThreadResultIntoPhi(result, otherwiseValue: otherwiseValue, tryTok: tryTok)
			self.markValuePromise(phiId)
			phiOwnsAGreenThread = true
		end 'aGreenThreadResult' else 'borrowResult'
			// ⭐ **A BORROW try-result merged with an OWNED fallback** (`try arr.get(i) otherwise Item.create(…)`).
			// A managed-array `get`/`first`/`last` yields a BORROW — the array owns the element
			// and its `__managed_decref` walk drops it — while the `otherwise` fallback is a FRESH OWNED box. The
			// two edges merge into ONE binding, which has ONE drop discipline, so they MUST agree on ownership.
			//
			// ⚠ **THE OK BORROW IS INCREF'D SO THE PHI IS OWNED — do NOT compensate for the fallback with an
			// error-edge drop.** Making the phi a borrow (never dropped) leaks the owned fallback; an
			// `emitDecref(otherwiseValue)` on the error edge frees the fallback BEFORE the merged
			// binding is read, a use-after-free
			// (four `array-slots` reads came back `0x3F3F…`). Instead the ok edge takes a
			// SECOND owner of the borrowed element with `__mm_incref`, so the phi owns a reference on BOTH edges
			// and is dropped exactly ONCE at the binding's scope exit — after the last read, on every path.
			// incref and every managed drop (`__mm_decref`/`__str_decref`/`__managed_decref`/`__destruct_*`) share the
			// one header-refcount protocol (`emitRefcountCheckToLastOwner`), so the array's own decref walk and
			// this scope-exit drop balance regardless of which runs last: the element ends at refcount 0 with
			// exactly one free. The incref goes into `okBlock` (single-threaded, before its branch to `cont`);
			// `currentBlock` is `errEnd` and is restored after.
			//
			// The ERROR edge owes the phi a reference too, by the SAME rule: `transferFallbackToPhi` moves an
			// owned temp or increfs an aliased binding, so a `try arr.get(i) otherwise fallbackBinding` (the
			// binding read again after the try) no longer double-frees the box the phi and the binding share.
			//
			// A SCALAR result with a scalar fallback owns nothing on either edge, so the guard is false and the
			// borrowed phi stands — nothing incref'd, nothing dropped.
			if self.valueIsOwnedHeap(otherwiseValue) 'ownedFallbackIntoBorrow'
				let resumeBlock = self.bodyState.currentBlock
				self.bodyState.currentBlock = okBlock
				self.emitIncref(result, range: SourceRange.ofToken(tryTok))
				self.bodyState.currentBlock = resumeBlock

				self.transferFallbackToPhi(otherwiseValue, tryTok: tryTok)
				phiOwned = true
			end 'ownedFallbackIntoBorrow'
		end 'borrowResult'

		if not phiOwned 'aBorrowedPhi'
			self.propagateSlotReadMarkFrom(phiId, give: result)
		end 'aBorrowedPhi'

		// ⭐ **THE FALLBACK EXPRESSION'S ABANDONED TEMPORARIES DIE ON THE ERROR EDGE — the `otherwise <value>`
		// region.** The fallback runs on the error edge
		// ALONE, so a temporary it built and did not hand back (`[1,2]` in `otherwise [1,2].count()`) is exactly a
		// ternary/match arm's abandoned temp, one construct over: releasing it at the shared statement tail —
		// which sits in `cont`, reached from the ok edge too — releases a value that edge never built, the
		// register allocator's "a use dominates its def" (a compiler panic on a valid program). `currentBlock` is
		// `errEnd` (or the block the fallback left control in), which dominates the err→`cont` edge, so the drops
		// ride the single-threaded error path. The floor is `WholeStatementTempFloor`: `openTryFork`
		// cleared the
		// pending list at the fork, so everything enrolled since is the fallback's own, and the fallback VALUE was
		// pulled out just above (into the phi) — the phi is enrolled AFTER this drain so it is not swept here.
		//
		// ⚠ SKIPPED when the phi is a BORROW of a still-live source (`phiOwned` false AND the fallback is a
		// managed pointer): such a fallback can BORROW into one of these temporaries (`otherwise makeX().field`),
		// and dropping the temporary would free what the phi reads. That shape needs the source incref'd, not
		// dropped; draining here would trade a panic for
		// a use-after-free. A scalar fallback borrows nothing, so the common `otherwise <expr>.count()` is safe.
		if phiOwned or not self.valueIsManagedHeap(otherwiseValue) 'dropFallbackTemps'
			self.drainPendingTemps(WholeStatementTempFloor, anchor: tryTok)
		end 'dropFallbackTemps'

		// ⭐ **THE TWO EDGE VALUES THAT REACH `cont`, BUILT ONCE FOR BOTH READERS.** The exclusivity join and
		// `recordMergeAliasProof` below ask DIFFERENT questions of the SAME pair, and both only iterate it, so
		// one list serves both; two sites each building their own is one `ValueIdArray` per value-`try` merge
		// for nothing. Hoisted
		// above the `phiOwned` gate deliberately: the alias reader is ungated, so the list is needed on every
		// path anyway and the branch would only decide WHICH site paid for it.
		let contEdges = twoArgs(result, second: errEdgeValue)

		// The phi is only as strong as its weakest path. Both branches above already downgraded what they
		// increfed (`emitIncref` marks its operand co-owned), so this reads the state they left rather than
		// re-deriving which branch ran.
		if phiOwned 'enrolPhi'
			self.enrolOwnedPhi(phiId, edges: contEdges)
		end 'enrolPhi'

		self.markPhiImmortalIfEveryEdgeIs(phiId, edges: contEdges)

		if phiOwnsAGreenThread 'enrolThreadPhi'
			self.bodyState.pendingTempDrops.push(phiId)
		end 'enrolThreadPhi'

		// ⭐ **THE THIRD MERGE'S SHARE OF THE E3207 BLAME** — `finalizeMatchMerge`'s rule, one construct over,
		// ungated: a fallback naming an immutable binding is refused whatever the phi's ownership turns out
		// to be.

		// A value fallback is an expression, but an expression can still consume (`otherwise takeIt(s)`),
		// so the two edges are reconciled here as the fell-through form reconciles them.
		self.reconcileMovesAtTwoEdgeMerge(okBlock, markA: entryMoveMark, b: errEnd, markB: self.captureMoveMark(), anchor: tryTok)

		let okArgs = ValueIdArray.create(0)
		okArgs.push(result)
		self.recordBranchEdge(okBlock, targetId: cont.id, argIds: okArgs)
		self.emitBranch(okBlock, targetId: cont.id)

		let errArgs = ValueIdArray.create(0)
		errArgs.push(errEdgeValue)
		self.recordBranchEdge(errEnd, targetId: cont.id, argIds: errArgs)
		self.emitBranch(errEnd, targetId: cont.id)

		// ⭐ **BOTH EDGES ARE FINAL HERE, SO THE MERGE MAY ASK FOR ITS ALIAS CLAIM BACK.** The ok edge is
		// the callee's result, guarded by the callee's own ranged `return`; the err edge is the fallback, which
		// proves the range when it is an in-range literal or a value already denoting one, and proves nothing
		// when it is neither. `recordMergeAliasProof` decides from the values rather than from the shape, which
		// is what keeps `otherwise 0` eliding while `otherwise <wider var>` does not.
		self.recordMergeAliasProof(phiId, incoming: contEdges)
		self.recordLiteralRangeOfMerge(phiId, incoming: contEdges)
		self.recordFloatRangeOfMerge(phiId, incoming: contEdges)
		self.settleFloatResult(phiId)
		self.joinLiteralColumns(phiId, incoming: contEdges)

		// ⭐ **AND THE BUFFER-SURFACE FAMILY — THE THIRD MERGE'S SHARE OF IT.** Asked of
		// `contEdges` for `recordMergeAliasProof`'s stated reason one line up: both edges are final here, and
		// the err edge in particular is only settled after the ownership reconciliation above. MEASURED as the
		// route this closes: `try managed.slice(0, 99) otherwise managed` inside an `extension FixedArray` cleared
		// the fixed array's own record through the phi.
		self.propagateBufferSurfaceToPhi(phiId, gives: contEdges)

		self.bodyState.currentBlock = cont
		return phiId
	end 'finishValueTry'

	function moveGreenThreadResultIntoPhi(result ValueId, otherwiseValue ValueId, tryTok Token) throws SourceParseError
		if not self.valueOwnsGreenThread(result) 'notAGreenThread'
			panic("moveGreenThreadResultIntoPhi: v{result} was on the pending list without owning heap, and a promise is the only other value `enrolOwnedCallTemp` enrols there")
		end 'notAGreenThread'

		try self.takeOwnedPromise(otherwiseValue, anchor: tryTok, range: SourceRange.ofToken(tryTok), door: TokenKind.otherwise.rawValue.toByteArray())
	end 'moveGreenThreadResultIntoPhi'

	// Hand the merge phi exactly one owned reference from the error edge. `finishValueTry` drops the
	// phi once at the binding's scope exit, and the two fallback shapes owe that reference
	// differently:
	//   • an unconsumed owned temporary (`otherwise Slot.create(…)`) already owns its one reference
	//     and is moved into the phi by leaving the pending list;
	//   • a live owned binding or consumed parameter (`otherwise fallback`, read again after the
	//     `try`) keeps its own reference and drops it at its own scope exit, so the phi takes a second
	//     one with `__mm_incref` on the error edge (`currentBlock` is `errEnd` at both callers).
	// Backwards is a wrong answer either way: increfing a temp leaks, and moving a binding
	// double-frees (exit 101). `pendingTempsContain` discriminates because the two owned homes are
	// disjoint: a transfer to a binding removes the value from the pending list first.
	function transferFallbackToPhi(errEdgeValue ValueId, tryTok Token)
		if self.pendingTempsContain(errEdgeValue) 'movedTemp'
			self.removeFromPendingTemps(errEdgeValue)
		end 'movedTemp' else if self.valueIsAnOwnedIsolatedLocal(errEdgeValue) 'anIsolatedRegion'
			self.moveOwnedValueOut(errEdgeValue)
		end 'anIsolatedRegion' else 'aliasedBinding'
			self.emitIncref(errEdgeValue, range: SourceRange.ofToken(tryTok))
		end 'aliasedBinding'
	end 'transferFallbackToPhi'

	// `otherwise ignore` or a block handler that FELL THROUGH — both edges reach a fresh continuation
	// with no try-value. Merge the carried vars a block handler may have reassigned (`mergeAtContinuation`
	// mints a phi only where the two edges differ). The returned `result` is the discarded statement value.
	function finishFellThroughTry(func IrFunction, okBlock IrBlock, errEnd IrBlock, entryVals ValueIdArray, result ValueId, resultWasPending bool, resultUsed bool, entryMoveMark MoveMark, errMoveMark MoveMark, tryTok Token) returns ValueId throws SourceParseError
		// ⭐ **A FELL-THROUGH HANDLER CARRIES NO VALUE, SO IT CANNOT STAND IN A VALUE POSITION.** `otherwise
		// ignore` and a handler block that runs off its end both catch the error and produce nothing, so the
		// error edge reaches the merge with no value while a value position needs one on BOTH edges — and for
		// a managed result the ok edge is about to DROP that result below, so binding it would read freed heap
		// (a leak/UAF, not merely an undefined scalar). Rejected HERE, the ONE point at which both spellings
		// have collapsed to the `fellThrough` signal, so the rule is stated once rather than at each spelling's
		// parse site, where the two spellings are free to drift and the fall-through block case then leaks.
		if resultUsed 'valuelessHandlerInValue'
			throw SourceParseError.errorTypeMismatch("a `try` used for its value needs a value on the error path too, but this `otherwise` handler catches the error without producing one (`otherwise ignore`, or a handler block that runs off its end) — give it a fallback value with `otherwise <expr>`, or make every path of the handler terminate (`return`/`throw`/`break`/`continue`)", line: tryTok.line, column: tryTok.column)
		end 'valuelessHandlerInValue'

		let cont = self.artifact.module.addBlock(func, label: b"trycont", heat: BlockHeat.normal)
		let errVals = self.snapshotBindings(self.bodyState.mutableVars)

		// A block handler is statements, so it can move an outer owned binding (`otherwise (e) 'h'
		// consume(s) end 'h'`) where the ok edge left it live — reconciled across the two edges before
		// either branches. See `reconcileMovesAtTwoEdgeMerge`.
		self.reconcileMovesAtTwoEdgeMerge(okBlock, markA: entryMoveMark, b: errEnd, markB: errMoveMark, anchor: tryTok)

		self.mergeAtContinuation(okBlock, predB: errEnd, cont: cont, bindings: self.bodyState.mutableVars, valsA: entryVals, valsB: errVals)

		// A discarded result that owes a drop is dropped in `okBlock`, before its branch to the shared
		// `cont`: never in `cont`, which the error edge reaches with a NULL register, and never on the
		// error edge. `openTryFork` took it off the pending list, so the statement drain never sees it
		// and this is its only drop.
		if resultWasPending 'dropManagedResultOnOk'
			self.bodyState.currentBlock = okBlock
			self.emitDecref(result, range: SourceRange.ofToken(tryTok))
		end 'dropManagedResultOnOk'

		self.emitBranch(okBlock, targetId: cont.id)
		self.emitBranch(errEnd, targetId: cont.id)
		self.bodyState.currentBlock = cont
		return result
	end 'finishFellThroughTry'

	// Parse the `otherwise` handler into the current (error) block and report how it affects the
	// merge. A `try` with no `otherwise` never reaches here: `desugarTry` forks it onto
	// `forkOntoPropagatingHandler`.
	function parseOtherwiseHandler(func IrFunction, result ValueId, flag ValueId, fused ValueId, target TryTarget, resultUsed bool, tryTok Token) returns TryHandler throws SourceParseError
		try self.consume(TokenKind.otherwise)

		let eType = self.tryErrorEnumType(self.tryTargetThrows(target))
		let form = self.caughtErrorFormFor(target, fused: fused)

		// Block forms own their caught box end-to-end (`parseOtherwiseBlock` enrols, binds and drops it).
		if self.at(TokenKind.leftParen) 'bindingForm'
			return try self.parseOtherwiseBinding(func, flag: flag, errorType: eType, form: form)
		end 'bindingForm'

		if self.at(TokenKind.charLiteral) 'blockForm'
			return try self.parseOtherwiseBlock(func, binder: CaughtErrorBinder.anonymous(self.current()), flag: flag, errorType: eType, form: form)
		end 'blockForm'

		// The non-block forms discard the caught error, so its box must drop here. `otherwise ignore`, a
		// fallback value, and the single-statement `return`/`break`/`continue`/`throw <fresh>` each catch
		// a boxed error and throw it away, so its box, owned by this try, drops exactly once on the error
		// edge. It is enrolled anonymously (these forms name no `e`) so a terminating form's own
		// `emitScopeDrops` releases it, then dropped here for the non-terminating forms
		// (`dropArmScopedOwned` frees it on a live exit and drains it either way). A scalar error owns no
		// box, so this is inert. (`otherwise panic` aborts the process before any free matters.)
		let ownedFloor = self.bodyState.ownedBindings.count()

		if errorUnionIsSynthesized(caughtErrorUnionMatch(form)) 'aCombinedError'
			if not self.at(TokenKind.panic) 'survivesTheHandler'
				self.releaseCombinedErrorBox(func, form: form, flag: flag, anchor: tryTok)
			end 'survivesTheHandler'
		end 'aCombinedError' else if self.throwsTypeIsBoxedUnion(eType) 'enrolBox'
			_ = self.enrollAnonymousCaughtBox(flag, eType: eType, anchor: tryTok)
		end 'enrolBox'

		let handler = try self.parseUnboundOtherwiseForm(func, result: result, resultUsed: resultUsed, tryTok: tryTok)
		self.dropArmScopedOwned(ownedFloor, exitBlock: self.bodyState.currentBlock, anchor: tryTok)
		return handler
	end 'parseOtherwiseHandler'

	function releaseCombinedErrorBox(func IrFunction, form CaughtErrorForm, flag ValueId, anchor Token)
		let caught = caughtErrorUnionMatch(form)

		if not errorUnionIsSynthesized(caught) 'nothingCombined'
			return
		end 'nothingCombined'

		let info = requireErrorUnionInfo(caught)
		self.bodyState.currentBlock = self.emitErrorUnionBoxReleases(func, members: info.members, fused: info.fusedOrdinal, entry: self.bodyState.currentBlock, flag: flag, anchor: anchor)
	end 'releaseCombinedErrorBox'

	function settleCaughtCombinedError(func IrFunction, binder CaughtErrorBinder, form CaughtErrorForm, flag ValueId)
		let combined = caughtErrorUnionMatch(form)

		if not errorUnionIsSynthesized(combined) or not membersHoldABox(requireErrorUnionInfo(combined).members) 'nothingBoxed'
			return
		end 'nothingBoxed'

		if let name = try binder.boundName() 'aNamedBinding'
			let caught = self.bodyState.scope.getInfo(name)
			self.enrolOwnedBinding(VarInfo.createErrorMatchObligation(name, varType: caught.varType, flag: caught.boundValue))
		end 'aNamedBinding' else 'anAnonymousBinding'
			self.releaseCombinedErrorBox(func, form: form, flag: flag, anchor: binder.anchor)
		end 'anAnonymousBinding'
	end 'settleCaughtCombinedError'

	// Is a throw with this clause, landing in a `test` body, reported rather than propagated? Two
	// conditions:
	//
	//   • the body must be the test's own. A closure written inside a test body is a separate function
	//     whose errors go to whoever calls it, which may be nobody or long after the test finished, so
	//     there is nothing for the test to fail on its behalf; `error.closure-in-a-test-is-not-a-test`
	//     is the pin.
	//   • the error must not already be `TestFailure`. An assertion throws exactly what a test throws,
	//     so it propagates with no report, which is what makes a report mean "something unexpected".
	//
	// Both routes a test-body throw takes ask it — an explicit bare `try` (`desugarTry`) and the
	// implied handler (`routeToImpliedTestHandler`) — so the two report identically.
	function testBodyAbsorbs(throwsClause ThrowsClause) returns bool
		if self.bodyState.enclosingBodyKind != EnclosingBodyKind.testBody 'notATestBody'
			return false
		end 'notATestBody'

		return match throwsClause 'calleeThrows'
			none gives false
			throwing(propagated) gives not propagated.equals(TestImpliedThrowsTypeName)
		end 'calleeThrows'
	end 'testBodyAbsorbs'

	// The handler a test body substitutes, emitted as IR — what an explicit bare `try` on a foreign
	// error, or a throwing op the implied handler takes, compiles to:
	//
	//     try <op> otherwise (e) 'uncaught throw in test'
	//         __TestReport.threw("<E>", errorCase: "{e}", file: "<this file>", line: <the op's line>)
	//         throw TestFailure.assertion
	//     end 'uncaught throw in test'
	//
	//   • A test still throws exactly `TestFailure`: the foreign error is reported and dropped, never
	//     propagated, so the runner has one error type to handle.
	//   • The report reaches the runner before the failure does, so the test says which error it
	//     failed on.
	//   • `file` and `line` locate the throwing op — the explicit `try`, or the op's own source range
	//     for the implied handler — because that is the line a reader has to open.
	//
	// The call is synthesized at the IR tier and must not go through the source-call door:
	// `requireCalleeIsNotReservedName` refuses a `__` callee an author typed, pinned shut by
	// `stdlib-user-shadows.error.the-mint-is-not-reachable-from-user-code`. That is a rule about
	// provenance, so the compiler's own emission passes it by being the compiler's, with no name-keyed
	// exemption.
	//
	// `"{e}"` is the language's own interpolation (`emitCaughtErrorText`), so the report renders the
	// error as `otherwise (e) … print("{e}")` would.
	function emitUncaughtTestThrow(flag ValueId, throwsClause ThrowsClause, anchor Token)
		let range = SourceRange.ofToken(anchor)
		let errorTypeName = try throwsClauseName(throwsClause) otherwise panic("emitUncaughtTestThrow: `testBodyAbsorbs` has already matched this clause's `throwing` arm, so it cannot be `none` here")
		let errorType = self.tryErrorEnumType(throwsClause)

		// The enrolment below is arm-scoped, and capturing the floor is what says so. A boxed foreign
		// error is enrolled as an owned binding (`recoverCaughtErrorValue`) so the drops below release
		// it, but it belongs to this terminated edge only: left standing, `finishTerminatedTry`'s
		// `restoreMoveMark` finds a height that no longer matches and panics on a correct program. The
		// floor/drain pair is `parseOtherwiseHandler`'s, for its reason: every catching form that
		// discards the error brackets its enrolment the same way.
		let ownedFloor = self.bodyState.ownedBindings.count()
		let caught = self.recoverCaughtErrorValue(flag, errorType: errorType, anchor: anchor)

		let args = ValueIdArray.create(0)
		args.push(self.emitStringLiteral(freeze TestProtocolWrapper.toByteArray(), range: range))
		args.push(self.emitStringLiteral(freeze TestProtocolSeparator.toByteArray(), range: range))
		args.push(self.emitStringLiteral(freeze self.signatures.shadowRoster().authorSpelledText(errorTypeName).toByteArray(), range: range))
		args.push(self.emitCaughtErrorText(caught, anchor: anchor, range: range))

		// The file names ITSELF the way every other emitted string does — root-relative and `/`-joined, which
		// is what `__file__` expands to. An absolute path would be a fact about the machine that ran the
		// compiler; see `sourceFileDisplayPath`.
		args.push(self.emitStringLiteral(self.sourceFileDisplayPath(), range: range))
		args.push(self.emitLiteral(anchor.line as FullRangeInt, valueType: MaxonType.integer, range: range))
		_ = self.emitRuntimeCall(TestReportThrewCallee, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)

		// ⭐ **AND THEN THE TEST FAILS.** The hand-off drop set releases everything this frame still owns —
		// the interpolation result, and a BOXED foreign error's box, which `recoverCaughtErrorValue` enrolled
		// for exactly this moment — while the thrown scalar itself owns no heap and moves out inertly. It is
		// the same call `emitThrowError` ends on, because it is the same throw.
		let failure = self.emitTestFailureAssertion(range)
		self.emitHandoffExit(FunctionExit.throwScalar(failure), anchor: anchor)

		// The block is terminated by the line above, so this drops nothing — it DRAINS, which is the half that
		// matters: the tracking must be back at the floor before `finishTerminatedTry` rewinds the move mark.
		self.dropArmScopedOwned(ownedFloor, exitBlock: self.bodyState.currentBlock, anchor: anchor)
	end 'emitUncaughtTestThrow'

	// The caught error as a VALUE the report can render. A scalar enum's is the flag's decoded ordinal; a
	// BOXED union's IS the flag — a box pointer — and it is enrolled as an owned binding here, so the throw
	// that follows releases it through the ordinary hand-off drop rather than leaking a box on the one path
	// that catches it. The same split `declareCaughtError` makes, minus the naming: nothing binds an `e`
	// here, because no source wrote one.
	function recoverCaughtErrorValue(flag ValueId, errorType MaxonType, anchor Token) returns ValueId
		if not self.throwsTypeIsBoxedUnion(errorType) 'aScalarEnum'
			return self.decodeScalarCaughtError(flag, errorType: errorType, anchor: anchor)
		end 'aScalarEnum'

		return self.enrollAnonymousCaughtBox(flag, eType: errorType, anchor: anchor)
	end 'recoverCaughtErrorValue'

	// `"{e}"` for the caught error — the ONE interpolation the compiler writes on an author's behalf, built
	// out of the very parts `parseStringInterpolation` builds a written one from, so the report and a
	// `print("{e}")` in the same program cannot render one error two ways.
	function emitCaughtErrorText(caught ValueId, anchor Token, range SourceRange) returns ValueId
		let partBufs = ValueIdArray.create(0)
		let partLens = ValueIdArray.create(0)
		let scratchIds = ValueIdArray.create(0)
		try self.materializeInterpExpr(caught, exprTok: anchor, format: InterpFormat.plain, partBufs: partBufs, partLens: partLens, scratchIds: scratchIds, range: range) otherwise panic("emitCaughtErrorText: interpolating a caught '{String.from(self.valueTypeName(caught))}' was refused, but the value is decoded from a declared error enum or union and rendered with no format specifier, so no interpolation refusal can apply to it")
		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range)
	end 'emitCaughtErrorText'

	// `TestFailure.assertion` as a VALUE, through the SAME emitter the source expression `TestFailure.assertion`
	// goes through (`emitEnumTagLiteral`): the value of a payload-free enum case IS its tag, carried as a
	// `named(E)`-tagged value over an `integer` literal op, and a second construction of that pairing would be
	// the one shape `maxonTypeToStdType` panics on.
	//
	// The TAG is read off the corpus's own declaration rather than assumed to be zero. `stdlib/Testing.maxon`
	// is loaded into every compile, so the layout is always there; a rename or a reordering of its cases is a
	// positioned compiler panic here instead of a throw that encodes a tag nothing decodes.
	function emitTestFailureAssertion(range SourceRange) returns ValueId
		match self.signatures.enumFor(TestImpliedThrowsTypeName.toByteArray(), readerFilePath: self.job.path) 'declared'
			declared(layout) then return self.emitEnumTagLiteral(layout.name, tag: layout.tagOfCase(TestFailureAssertionCaseName), range: range)
			undeclared then panic("emitTestFailureAssertion: '{TestImpliedThrowsTypeName}' declares no enum — `stdlib/Testing.maxon` is loaded into every compile, and a `test` declaration cannot be parsed without it")
		end 'declared'
	end 'emitTestFailureAssertion'

	// The `otherwise` forms that bind no `e` and open no block: `ignore`, a single-statement `return`/`break`/
	// `continue`/`throw`/`panic`, or a fallback VALUE. Split out of `parseOtherwiseHandler` so its caller can
	// bracket them with the caught-box enrol/drop every one of them shares — each DISCARDS the caught error.
	// Returns how the form affects the merge; on entry `currentBlock` is the error block.
	function parseUnboundOtherwiseForm(func IrFunction, result ValueId, resultUsed bool, tryTok Token) returns TryHandler throws SourceParseError
		// `otherwise ignore` catches the error and discards the value — a fell-through (statement) form. Its
		// use in a value position is refused uniformly with a fall-through block, at the one `fellThrough`
		// gate in `finishFellThroughTry`; here it only reports HOW the merge behaves.
		if self.at(TokenKind.ignore) 'ignoreForm'
			try self.consume(TokenKind.ignore)
			return TryHandler.fellThrough
		end 'ignoreForm'

		// The single-statement CONTROL-FLOW forms terminate the error block; their own scope drops release
		// the caught box the caller enrolled.
		if self.at(TokenKind.return) or self.at(TokenKind.break) or self.at(TokenKind.continue) 'controlFlow'
			let head = try self.readStatementOpening(PrecedingTerminator.none, entersItsChain: true)
			_ = try self.parseStatement(func, block: self.bodyState.currentBlock, head: head)
			return TryHandler.terminated
		end 'controlFlow'

		if self.at(TokenKind.throw) 'rethrow'
			try self.parseThrowStatement(func, block: self.bodyState.currentBlock)
			return TryHandler.terminated
		end 'rethrow'

		if self.at(TokenKind.panic) 'panicForm'
			// The handler aborts the process, so its block runs at most once.
			self.bodyState.currentBlock.heat = BlockHeat.cold
			try self.parsePanicStatement(func, block: self.bodyState.currentBlock)
			return TryHandler.terminated
		end 'panicForm'

		// `otherwise <expr>` — a fallback VALUE that merges with the success value.
		//
		// A void `try` (its call returns nothing) has no success value for a fallback VALUE to stand in
		// for, so `otherwise <expr>` is ill-formed here — `finishValueTry` would mint a void phi that
		// lowering cannot type. The valueless forms a void `try` DOES take (`ignore`, a block,
		// a single-statement return/break/continue/throw/panic) are all handled above, so reaching here
		// means a genuine value. This is the statement-position twin of `parseTry`'s value-position void
		// reject; both are E3059. (A value-position void `try` is rejected before the handler parses, so
		// `result` is void here only in statement position.)
		if self.tagOf(result) == ValueTypeTag.void 'voidTryOtherwiseValue'
			throw SourceParseError.errorTypeMismatch("a void `try` (its call returns nothing) cannot take an `otherwise <value>` fallback — the success path yields no value for the fallback to stand in for; use `otherwise ignore`, an `otherwise 'block' … end`, or a single-statement `otherwise return`/`throw`", line: tryTok.line, column: tryTok.column)
		end 'voidTryOtherwiseValue'

		// The token index the fallback expression starts at, kept so the range check below can ask what
		// the expression parser ACTUALLY consumed — see `requireOtherwiseInRangedReturn`.
		let otherwiseStart = self.pos
		self.stateDeclaredLiteralTarget(self.typeOf(result), scopeFilePath: self.job.path, valueStart: otherwiseStart)
		let otherwiseValue = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.requireOtherwiseInRangedReturn(result, from: otherwiseStart, to: self.pos, tryTok: tryTok)
		self.noteIsolatedPartOrigin(otherwiseValue, startIndex: otherwiseStart, endIndex: self.pos)

		try self.requireOtherwiseMatchesResult(otherwiseValue, result: result, resultUsed: resultUsed, tryTok: tryTok)

		return TryHandler.value(otherwiseValue)
	end 'parseUnboundOtherwiseForm'

	function requireOtherwiseMatchesResult(otherwiseValue ValueId, result ValueId, resultUsed bool, tryTok Token) throws SourceParseError
		if self.valueIsDeferred(result) 'aDeferredResult'
			return
		end 'aDeferredResult'

		if resultUsed and tagIsFloat(self.tagOf(otherwiseValue)) != tagIsFloat(self.tagOf(result)) 'typeMismatch'
			try self.refuseOtherwiseMismatch(self.valueKindWord(otherwiseValue), expectedType: self.valueKindWord(result), fallback: otherwiseValue, tryTok: tryTok)
			return
		end 'typeMismatch'

		// A fallback of the wrong named aggregate — a different struct/union, or an aggregate against a
		// scalar result (or the reverse) — merges into the owned result phi and is dropped under the
		// result's destructor, which the float check above cannot see (two structs share the `structRef`
		// tag; a boxed union and a ranged-int alias share `named`). Asked whatever `resultUsed` says: the
		// phi is dropped on the discard path too (`finishValueTry`). Identity is the interned name,
		// exact.
		//
		// ⚠ The two names decide the verdict and do not spell it, as at the return and reassignment
		// doors: the message renders the author's alias, not the canonical instance name.
		let resultAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: self.tagOf(result), nameId: self.valueNameId(result), readerFilePath: self.job.path)
		let fallbackAggregate = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: self.tagOf(otherwiseValue), nameId: self.valueNameId(otherwiseValue), readerFilePath: self.job.path)

		if not self.otherwiseJoinsAtARuntimeSizedFixedArray(otherwiseValue, result: result) and self.signatures.aggregatesConflict(resultAggregate, expectedTag: self.tagOf(result), expectedNameId: self.valueNameId(result), expectedBrand: self.brandOf(result), got: fallbackAggregate, gotTag: self.tagOf(otherwiseValue), gotNameId: self.valueNameId(otherwiseValue), gotBrand: self.brandOf(otherwiseValue), readerFilePath: self.job.path) 'aggregateOtherwiseMismatch'
			try self.refuseOtherwiseMismatch(self.valueDisplayTypeName(otherwiseValue), expectedType: self.valueDisplayTypeName(result), fallback: otherwiseValue, tryTok: tryTok)
			return
		end 'aggregateOtherwiseMismatch'

		// A managed try-result and its fallback merge through an owned result phi (`finishValueTry`),
		// dropped once at its scope exit, so the tag must agree: a `String` result with an `int` fallback
		// would have the phi's drop decref an integer as a String pointer. A borrowed fallback of the
		// right type is promoted at the merge rather than refused.
		if self.valueIsOwnedHeap(result) and self.tagOf(otherwiseValue) != self.tagOf(result) 'managedOtherwiseTypeMismatch'
			try self.refuseOtherwiseMismatch(self.valueKindWord(otherwiseValue), expectedType: self.valueKindWord(result), fallback: otherwiseValue, tryTok: tryTok)
		end 'managedOtherwiseTypeMismatch'
	end 'requireOtherwiseMatchesResult'

	function otherwiseJoinsAtARuntimeSizedFixedArray(otherwiseValue ValueId, result ValueId) returns bool
		return self.signatures.sizedFixedArrayWidens(self.tagOf(otherwiseValue), declaredNameId: self.valueNameId(otherwiseValue), gotTag: self.tagOf(result), gotNameId: self.valueNameId(result))
	end 'otherwiseJoinsAtARuntimeSizedFixedArray'

	function refuseOtherwiseMismatch(fallbackType String, expectedType String, fallback ValueId, tryTok Token) throws SourceParseError
		try self.refuseUnlessDeferred(SourceParseError.errorTypeMismatch("otherwise type '{fallbackType}' does not match expected type '{expectedType}'", line: tryTok.line, column: tryTok.column), value: fallback)
	end 'refuseOtherwiseMismatch'

	// ⭐ **AN `otherwise` FALLBACK LITERAL MUST LIE INSIDE THE TRY RESULT'S RANGED TYPE.** The fallback
	// merges with the success value through one result phi typed by the callee's return type, so an
	// out-of-range default binds a value wearing a type whose declared range excludes it — the one
	// invariant a ranged type exists to carry, broken on exactly the path the author wrote the fallback
	// for. Refused at compile time, as an out-of-range literal is at a cast and at a ranged `return`.
	//
	// ⚠ **IT READS THE TOKENS THE EXPRESSION PARSER ACTUALLY CONSUMED, which is why it takes a SPAN and
	// does not peek ahead.** "Was this fallback a plain integer literal?" is a question about what was
	// PARSED, and only `parseExpression` knows where its expression ended; a look-ahead here would be a
	// second reading of the grammar, free to disagree with the first about where a fallback stops. The
	// literal's text becomes a number through `intLiteralValue`, the one decoder every literal uses.
	//
	// A non-literal fallback — a call, an arithmetic expression, a variable — is deliberately NOT
	// checked. The compiler has no compile-time value for one here, and no guard site to hang a runtime check
	// on: the pass that emits those (`InsertRangeChecks`) guards CASTS and RETURNS, and a fallback is
	// neither.
	function requireOtherwiseInRangedReturn(result ValueId, from ElementIndex, to ElementIndex, tryTok Token) throws SourceParseError
		match self.declaredAliasOfValue(result) 'a'
			undeclared then return
			declared(alias) then try self.requireOtherwiseLiteralInRange(alias, from: from, to: to, tryTok: tryTok)
		end 'a'
	end 'requireOtherwiseInRangedReturn'

	// The half above that has an alias in hand. A FLOAT alias is skipped: its bounds are IEEE-754 bit
	// patterns and the span this reads is an INTEGER literal, so the comparison would be between two
	// things that were never the same kind of number.
	function requireOtherwiseLiteralInRange(alias RangedTypeAlias, from ElementIndex, to ElementIndex, tryTok Token) throws SourceParseError
		if aliasIsFloat(alias) 'floatAlias'
			return
		end 'floatAlias'

		let negated = self.kindAt(from) == TokenKind.minus

		// ⚠ **THE PARENTHESES ARE LOAD-BEARING.** `a + b if c else d` can bind as `a + (b if c else d)` —
		// the same trap `PressureIndex.combine` documents — so without them this reads `from + (1
		// if negated else from)`, i.e. `2 * from` on the non-negated arm. Then `otherwise -1` is refused
		// and `otherwise 101` compiles clean and returns the success value, because the index lands on an
		// unrelated token and the guard below bails. The one arm the pinned case exercises is the one
		// that works.
		let literalIndex = (from + 1) if negated else from

		// The span must be the literal and NOTHING else — one token, or a `-` and one token.
		if literalIndex + 1 != to or self.kindAt(literalIndex) != TokenKind.intLiteral 'notAPlainLiteral'
			return
		end 'notAPlainLiteral'

		let value = try self.intLiteralValue(self.tokenAt(literalIndex), negated: negated)
		let written = ConstValue.ofIntLiteral(value, negated: negated)

		// This door reads the `-` off the TOKEN STREAM rather than off `writtenNegativeLiterals`, and that is
		// not a second derivation of the mark: no value is minted here at all (the handler's literal is not
		// emitted until the branch is taken), so there is no ValueId to key one by. `negated` above IS the
		// same fact from the same place — the minus the source wrote.
		if written.fitsAlias(alias, isFloat: false) 'inRange'
			return
		end 'inRange'

		throw SourceParseError.otherwiseOutsideRangedReturn(value, aliasName: self.signatures.aliasIdentityDisplay(alias.name), low: alias.low, high: alias.high, writtenNegative: written.writtenNegative, domain: alias.domain, line: tryTok.line, column: tryTok.column)
	end 'requireOtherwiseLiteralInRange'

	// `otherwise (e) 'label' … end 'label'` — bind the caught error, then parse the labelled handler block.
	// In a match arm this block form is E2049. What `e` BINDS is `declareCaughtError`'s three-way answer, not
	// this routine's: a scalar enum's decoded ordinal, a boxed union's pointer, or — for a block whose body
	// routed two or more error types — the raw flag under a synthesized error union.
	//
	// ⭐ **IT TAKES THE ERROR TYPE AND THE FORM, NOT THE `TryTarget` IT USED TO DERIVE THEM FROM**, because a
	// block-form `try 'l' … end 'l' otherwise (e) 'h' … end 'h'` has NO single target: its handler is shared
	// by every routed edge in the body. For a ONE-member block the type is what those edges agreed on
	// (`TryBlockContext.throwsClause`); for a multi-member one there is no single enum at all, and `form`
	// carries the synthesized union that replaces it. The single-call form still asks `tryTargetThrows` — one
	// line up, at its own caller — so this routine keeps one shape and the two constructs reach it two ways.
	function parseOtherwiseBinding(func IrFunction, flag ValueId, errorType MaxonType, form CaughtErrorForm) returns TryHandler throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let eNameTok = try self.consume(TokenKind.identifier)

		// ⛔ **A CAUGHT ERROR IS A DECLARATION, SO IT ASKS THE DECLARATION DOOR** — for the reason
		// `requireUnreservedName`'s header gives at length, and this is one of the two sites that proved it:
		// before this call, `try f() otherwise (__x) 'h'` declared a `__`-prefixed local and RAN (measured,
		// exit 42) where the oracle refuses it E2051. `self` was never reachable here — `consume(identifier)`
		// refuses the keyword first — which is exactly why the hole was invisible to the receiver rule.
		try self.requireUnreservedName(eNameTok, declaredName: eNameTok.value)
		try self.consume(TokenKind.rightParen)
		return try self.parseOtherwiseBlock(func, binder: CaughtErrorBinder.named(eNameTok.value, anchor: eNameTok), flag: flag, errorType: errorType, form: form)
	end 'parseOtherwiseBinding'

	// Enrol a caught boxed error as owned. The flag is the box pointer (the throw encode wrote it
	// verbatim), so there is no decode arithmetic: a retagged copy of it (`retagCaughtBox`) carries
	// the union type, so `match e` dispatches through the box and the scope-exit drop routes to
	// `__destruct_<U>`, both of which read the value tag. ⚠ The flag itself is never retyped or
	// marked: in an error-union match one flag serves every arm, and a retype left standing would type
	// the next arm's `e` as this arm's member. A discarding form (a no-binding block,
	// `otherwise ignore`, a fallback value) enrols the box anonymously (`enrollAnonymousCaughtBox`),
	// so every catching form becomes an owner the same way.
	//
	// The box is co-owned because the throw may have retained rather than moved: the flag carries no
	// note of which transfer produced it, and the catcher is a different frame and cannot ask. A
	// `match e` on a caught box therefore retains its payload rather than nulling a slot the thrower's
	// container may still read (see `OwnedHeapExclusivity`). A send error is the exception, sole by
	// its type (`serviceSendErrorExclusivity`).
	function enrollCaughtBox(flag ValueId, eType MaxonType, binder CaughtErrorBinder) returns ValueId throws SourceParseError
		let name = try binder.boundName() otherwise return self.enrollAnonymousCaughtBox(flag, eType: eType, anchor: binder.anchor)

		let box = self.retagCaughtBox(flag, eType: eType, anchor: binder.anchor)
		self.enrolOwnedBinding(try self.declareCaughtErrorBinding(name, anchor: binder.anchor, varType: eType, value: box))
		return box
	end 'enrollCaughtBox'

	function enrollAnonymousCaughtBox(flag ValueId, eType MaxonType, anchor Token) returns ValueId
		let box = self.retagCaughtBox(flag, eType: eType, anchor: anchor)
		self.enrolOwnedBinding(VarInfo.createValueBinding(EmptySourceText, varType: eType, kind: BindingKind.let, boundValue: box))
		return box
	end 'enrollAnonymousCaughtBox'

	function retagCaughtBox(flag ValueId, eType MaxonType, anchor Token) returns ValueId
		let box = self.emitRetaggedCastValue(flag, targetType: eType, range: SourceRange.ofToken(anchor))
		self.carryWindowBirthFrom(box, source: flag)
		let unionName = self.internedName(typeNameIdOf(eType))
		self.markValueOwnsHeap(box, exclusivity: serviceSendErrorExclusivity(self.signatures, unionName: unionName))

		if self.signatures.isServiceSendError(unionName) and self.sendErrorCarriesAnIsolatedPayload(unionName) 'anIsolatedRegionComesBack'
			self.setValueCapability(box, capability: ValueCapability.isolated)
		end 'anIsolatedRegionComesBack'

		return box
	end 'retagCaughtBox'

	function sendErrorCarriesAnIsolatedPayload(unionName ByteArray) returns bool
		match self.signatures.enumInAnyFile(unionName) 'registered'
			declared(layout) then return layout.carriesAnIsolatedPayload()
			undeclared then panic("sendErrorCarriesAnIsolatedPayload: nothing declares `{String.from(unionName)}`, and a caught send error names the union `mintServiceSendErrorTypes` minted")
		end 'registered'
	end 'sendErrorCarriesAnIsolatedPayload'

	// ⭐⭐ **RECOVER THE CAUGHT ERROR INTO `currentBlock` — THE ONE DECODE, SHARED BY EVERY CONSTRUCT THAT
	// CATCHES.** `try f() otherwise (e) 'err' … end`, `if try f() 'ok' … end 'ok' else (e) 'err' … end` and a
	// block-form `try`'s handler are one operation reached by three grammars: the same flag, caught the same
	// way. THREE shapes to undo — the third is `form`'s, and it is not a decode at all:
	//   • a SYNTHESIZED ERROR UNION (a block whose body routed two or more error types) — the flag is an
	//     `ordinal + bias` on some incoming edges and a box POINTER on others, so there is no ONE decode and
	//     no ONE type; `e` takes the flag untyped and the arms discriminate (`declareErrorUnionBinding`).
	// The other two are the error-flag ABI's own pair (`throwsTypeIsBoxedUnion`, the fact the throw ENCODE
	// turned on):
	//   • a BOXED union — the flag IS the box pointer, written verbatim by the throw, so the binding
	//     takes a retagged copy of it with NO arithmetic (`enrollCaughtBox`).
	//   • a SCALAR enum — `e = flag - ErrorFlagOrdinalBias`, the exact inverse of the Std-tier throw ENCODE
	//     (`lowerThrowError`). Both read the one `ErrorFlagOrdinalBias`, so a change to the bias cannot leave
	//     this decode silently binding `match e` to the wrong case.
	// A BOXED error is enrolled owned whether or not it is named — ANONYMOUS for a binder-less catch — so a
	// transferred box is released exactly once on the edge that leaves the branch; the caller's
	// `dropArmScopedOwned` does the releasing. A SCALAR error owns no heap and enrols nothing, so a
	// binder-less scalar catch emits no code at all.
	//
	// The caller has already opened the scope frame the binding lands in, and owns the matching
	// `ownedFloor` / `popScope` / `dropArmScopedOwned` — this routine only declares.
	function declareCaughtError(flag ValueId, errorType MaxonType, binder CaughtErrorBinder, form CaughtErrorForm) throws SourceParseError
		try self.bindCaughtError(flag, errorType: errorType, binder: binder, form: form)

		let name = try binder.boundName() otherwise return

		// ⭐⭐ **E3012 — A DECLARED-BUT-UNREAD `( e )` IS REFUSED, AT EVERY DOOR THAT DECLARES ONE.** The
		// binding is optional; declaring one and never reading it says the author meant to use the error and
		// did not, and the oracle refuses it at all three catching forms. The enrolment sits at this door
		// rather than at those forms because this is the one site that is COMPLETE: a fourth catching form
		// cannot acquire a binding without coming through here.
		self.bodyState.unusedCandidates.push(UnusedBindingCandidate.create(self.bodyState.scope.getInfo(name), nameRange: SourceRange.ofToken(binder.anchor), kind: UnusedBindingKind.caughtError, declToken: self.pos))
	end 'declareCaughtError'

	// The decode of a caught error into its binding — a deferred flag as it stands, a synthesized
	// error union's raw flag, a boxed union's pointer, or a scalar enum's decoded ordinal. Split out
	// of `declareCaughtError` so that its early exits cannot skip the enrolment that follows them.
	function bindCaughtError(flag ValueId, errorType MaxonType, binder CaughtErrorBinder, form CaughtErrorForm) throws SourceParseError
		let caughtUnion = caughtErrorUnionMatch(form)

		if self.valueIsDeferred(flag) 'aDeferredError'
			if let name = try binder.boundName() 'nameTheDeferredError'
				_ = try self.declareCaughtErrorBinding(name, anchor: binder.anchor, varType: self.typeOf(flag), value: flag)
			end 'nameTheDeferredError'

			return
		end 'aDeferredError'

		if errorUnionIsSynthesized(caughtUnion) 'aSynthesizedUnion'
			try self.declareErrorUnionBinding(flag, info: requireErrorUnionInfo(caughtUnion), binder: binder)
			return
		end 'aSynthesizedUnion'

		if self.throwsTypeIsBoxedUnion(errorType) 'boxedError'
			_ = try self.enrollCaughtBox(flag, eType: errorType, binder: binder)
			return
		end 'boxedError'

		let name = try binder.boundName() otherwise return

		let eValue = self.decodeScalarCaughtError(flag, errorType: errorType, anchor: binder.anchor)
		_ = try self.declareCaughtErrorBinding(name, anchor: binder.anchor, varType: errorType, value: eValue)
	end 'bindCaughtError'

	function declareCaughtErrorBinding(name ByteArray, anchor Token, varType MaxonType, value ValueId) returns VarInfo throws SourceParseError
		return try self.bodyState.scope.declareValueBinding(name, varType: varType, kind: BindingKind.let, value: value, brandId: UnnamedTypeId) otherwise throw SourceParseError.localShadowsSelfField(String.from(name), typeName: String.from(self.enclosingTypeName()), line: anchor.line, column: anchor.column)
	end 'declareCaughtErrorBinding'

	// ⭐ **A SCALAR ENUM ERROR'S VALUE, RECOVERED FROM THE FLAG.** The flag carries `ordinal + bias`
	// (`ErrorFlagOrdinalBias`, the encode's own reservation of 0 for "no error in flight"), so the decode is
	// the one subtraction — and it is a routine rather than four inline lines because the SUBSTITUTED
	// handler a `test` body gets (`emitUncaughtTestThrow`) needs exactly this value and must not decode it a
	// second way. A second spelling of an ABI decode is the shape that reads one enum's ordinals as
	// another's.
	function decodeScalarCaughtError(flag ValueId, errorType MaxonType, anchor Token) returns ValueId
		let range = SourceRange.ofToken(anchor)
		let bias = self.emitLiteral(ErrorFlagOrdinalBias, valueType: MaxonType.integer, range: range)
		let eValue = self.mintValueOfType(errorType)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(eValue, lhs: flag, rhs: bias, op: MaxonBinOp.sub), range: range)
		return eValue
	end 'decodeScalarCaughtError'

	// ⭐⭐ **DECLARE A SYNTHESIZED-ERROR-UNION `(e)` BINDING — the THIRD shape of caught error, and the
	// only one that owns nothing.** `e` is bound to the FLAG itself and typed `integer`: the flag is
	// an `ordinal + bias` on some incoming edges and a heap box POINTER on others, so there is no one
	// type it could carry and no one drop it could owe. Claiming either would be a measured fault in
	// one direction or the other — marking it owned would decref an ordinal on a scalar member's edge,
	// and giving it a member's `named` type would tell `emitDecref` to run that member's `__destruct_`
	// over a number.
	//
	// ⭐ **SO THE BOX IS RELEASED PER ARM INSTEAD**, where the members are known — `parseMatchCommon`'s
	// `enrollCaughtBox` for an arm naming one member, `enterErrorUnionArm` for an arm naming several, a
	// `default` and an arm an `and fallthrough` reaches — which is sound only because the handler matches `e`
	// exactly once on every path (`consumeErrorMatchObligation`).
	//
	// The registration is what lets `match e` find the union by the name the author wrote; `parseOtherwiseBlock`
	// pops it at the handler's `end`, so a nested handler's binding cannot be mistaken for this one.
	function declareErrorUnionBinding(flag ValueId, info ErrorUnionInfo, binder CaughtErrorBinder) throws SourceParseError
		let bindingName = try binder.boundName() otherwise return

		let flagType = self.signatures.libraryAliasType(FullRangeIntAliasName, into: self.artifact.typeNames)
		let typedFlag = self.emitRetaggedCastValue(flag, targetType: flagType, range: SourceRange.ofToken(binder.anchor))

		_ = try self.bodyState.scope.declareValueBinding(bindingName, varType: flagType, kind: BindingKind.let, value: typedFlag, brandId: UnnamedTypeId) otherwise throw SourceParseError.localShadowsSelfField(String.from(bindingName), typeName: String.from(self.enclosingTypeName()), line: binder.anchor.line, column: binder.anchor.column)
		self.bodyState.errorUnionBindings.push(ErrorUnionBinding.create(bindingName, flag: typedFlag, info: info))
	end 'declareErrorUnionBinding'

	// ⛔⛔ **E3161 — A COMBINED ERROR THAT MAY BE A BOX IS MATCHED EXACTLY ONCE ON EVERY PATH THROUGH ITS HANDLER.**
	// `e` owns nothing, and the box is released by the arm of the `match e` that runs; so a second match reads a
	// released box and a path with no match never releases it. The rule rides the move machinery rather than the
	// text: the handler enrols an owned entry that owns nothing (`VarInfo.isErrorMatchObligation`), the match
	// MOVES it here, and the doors that already settle a move on every path settle this one — a join whose paths
	// disagree (`reconcileMovesAtMerge`) and an exit that reaches it live (`scopeReleasesAbove`) hold a refusal where
	// they would have emitted a drop. A loop the handler opened is refused as the move out of a loop is.
	function consumeErrorMatchObligation(flag ValueId, matchTok Token) throws SourceParseError
		for i in 0 upto self.bodyState.ownedBindings.count() 'eachOwned'
			let owned = try self.bodyState.ownedBindings.get(i) otherwise panic("consumeErrorMatchObligation: ownedBindings.get OOB at {i} on a range walked to its own count")

			if not owned.isErrorMatchObligation or owned.boundValue != flag 'anotherBinding'
				continue
			end 'anotherBinding'

			if owned.movedFrom 'alreadyMatched'
				throw SourceParseError.errorMatchNotExactlyOnce(String.from(owned.name), reason: "this path has already matched it", line: matchTok.line, column: matchTok.column)
			end 'alreadyMatched'

			if self.bindingIndexEscapesLoop(i as ElementIndex) 'insideALoop'
				throw errorMatchInsideALoopRefusal(owned.name, at: SourceRange.ofToken(matchTok))
			end 'insideALoop'

			owned.setMovedFrom(true, ledger: self.bodyState.moveLedger)
			return
		end 'eachOwned'
	end 'consumeErrorMatchObligation'

	// Hold the first broken obligation found where nothing may throw; a later one on the same parse adds nothing.
	function holdErrorMatchRefusal(bindingName ByteArray, reason String, anchor Token)
		match self.statement.errorMatchRefusal 'r'
			none then self.statement.errorMatchRefusal = ErrorMatchRefusal.held(bindingName, reason: reason, line: anchor.line, column: anchor.column)
			held then return
		end 'r'
	end 'holdErrorMatchRefusal'

	// Refuse the held broken obligation, if there is one — asked where a handler ends, the last door its paths reach.
	function requireNoHeldErrorMatchRefusal() throws SourceParseError
		let refusal = self.statement.errorMatchRefusal
		self.statement.errorMatchRefusal = ErrorMatchRefusal.none

		match refusal 'r'
			none then return
			held(bindingName, reason, line, column) then throw SourceParseError.errorMatchNotExactlyOnce(String.from(bindingName), reason: reason, line: line, column: column)
		end 'r'
	end 'requireNoHeldErrorMatchRefusal'

	// The synthesized error union a match scrutinee names, tested by the binding's identity, not its
	// name. The name finds the record; what makes it the union is that the name still resolves, where
	// the `match` stands, to the value the handler bound, or to an open boxed arm's copy of it
	// (`errorUnionFlagOf`). Shadowing is permitted, so a name-only test would hand
	// `let e = Inner.splat` the error's dispatch, a silent wrong answer. `lookupValue` is the
	// shadowing rule (innermost declaration wins), so asking it is asking the one authority rather
	// than re-deciding scope here.
	//
	// Walked innermost-first anyway, so a nested handler's `(f)` wins over an enclosing `(e)` of the
	// same name.
	function errorUnionForScrutinee(scrutStart ElementIndex) returns ErrorUnionMatch
		let name = try self.matchScrutineeBareName(scrutStart) otherwise return ErrorUnionMatch.notAUnion

		// An unbound name is not this handler's binding either — it is a name-resolution failure the
		// expression parse is about to report with a position of its own.
		let bound = try self.bodyState.scope.lookupValue(name) otherwise return ErrorUnionMatch.notAUnion

		var i = self.bodyState.errorUnionBindings.count()

		while i > 0 'innermostFirst'
			i = i - 1
			let binding = try self.bodyState.errorUnionBindings.get(i) otherwise panic("errorUnionForScrutinee: errorUnionBindings.get OOB at {i} on a list walked downwards from its own count")

			if binding.name.equals(name) and binding.flag == self.errorUnionFlagOf(bound) 'found'
				return ErrorUnionMatch.synthesized(binding.info)
			end 'found'
		end 'innermostFirst'

		return ErrorUnionMatch.notAUnion
	end 'errorUnionForScrutinee'

	function errorUnionFlagOf(value ValueId) returns ValueId
		for arm in self.bodyState.boxedMemberArms 'eachOpenArm'
			if arm.box == value 'theArmsBox'
				return arm.flag
			end 'theArmsBox'
		end 'eachOpenArm'

		return value
	end 'errorUnionFlagOf'

	// Record that the enclosing block-form handler's binding HAS now been matched on (E3084's other half).
	// A `tryBindingName` of `none` — every context but an open block-form handler — can match nothing.
	//
	// ⚠⚠ **IT IS KEYED ON THE NAME, WHERE `errorUnionForScrutinee` IS KEYED ON THE BINDING'S IDENTITY
	// — and the asymmetry is deliberate, because the two ask different questions.** The DISPATCH asks
	// *"which value is being discriminated?"*, which a shadow answers differently and must; this rule
	// asks *"did the author write a `match` on this name in this handler?"*, which is syntactic.
	// Tightening it to the identity refuses a handler whose only `match e` names a shadow, which is a
	// legal program. `try-block-shadowed-binding.md` pins both halves.
	function noteTryBlockBindingMatched(name ByteArray)
		if not self.bodyState.tryBindingName.requires(name) 'notTheHandlersBinding'
			return
		end 'notTheHandlersBinding'

		self.bodyState.tryBindingMatched = true
	end 'noteTryBlockBindingMatched'

	// The scrutinee token's name when a `match` names a BARE binding and nothing else — `match e 'k'`, an
	// identifier followed immediately by the block label. Two facts about a block-form handler are asked of
	// that name and neither survives `parseExpression` (which yields the flag phi, an integer like any
	// other): whether the handler discriminated (E3084) and whether the scrutinee is a synthesized union.
	// `AbsentError` for every other scrutinee shape, which is exactly "this is not that binding".
	function matchScrutineeBareName(index ElementIndex) returns immutable ByteArray throws AbsentError
		if self.kindAt(index) != TokenKind.identifier or self.kindAt(index + 1) != TokenKind.charLiteral 'notABareBinding'
			throw AbsentError.absent
		end 'notABareBinding'

		return self.tokenAt(index).value
	end 'matchScrutineeBareName'

	// Parse an `otherwise` handler BLOCK (`otherwise ['(e)'] 'label' … end 'label'`) into the error block.
	// The caught error is recovered by the shared `declareCaughtError` — the same decode `if try … else (e)`
	// runs — in a fresh scope frame opened before the body and drained after it. Both forms are
	// E2049 in a match arm (the block label is where the arm-body single-statement rule is violated).
	function parseOtherwiseBlock(func IrFunction, binder CaughtErrorBinder, flag ValueId, errorType MaxonType, form CaughtErrorForm) returns TryHandler throws SourceParseError
		if not self.at(TokenKind.charLiteral) 'noLabel'
			let tok = self.current()
			throw SourceParseError.matchMissingBlockId(tok.line, column: tok.column)
		end 'noLabel'

		let labelTok = self.current()

		if self.bodyState.inMatchArmBody 'inArm'
			throw SourceParseError.tryBlockFormInMatchArm(true, line: labelTok.line, column: labelTok.column)
		end 'inArm'

		// Consume the block-open label (`parseBlockBody` consumes only the closing `end <label>`, exactly
		// as `parseIfStatement`/`parseWhileStatement` consume their own opening labels).
		try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		// The owned-binding height BEFORE the caught box is enrolled — a handler-local drop FLOOR, the try
		// twin of `openBlock`'s `ownedCount` (drained by `dropArmScopedOwned` below). A boxed error is an
		// owned heap value this handler received ownership of; a scalar error owns no heap and adds none.
		let ownedFloor = self.bodyState.ownedBindings.count()
		let handlerDebugFloor = self.bodyState.debugOpenSlots.count()
		self.bodyState.scope.pushScope()

		try self.declareCaughtError(flag, errorType: errorType, binder: binder, form: form)
		self.settleCaughtCombinedError(func, binder: binder, form: form, flag: flag)

		let errBlock = self.bodyState.currentBlock

		// ⭐ **E3084's BRACKET.** A BLOCK-form handler is reached by every routed edge, so one that never
		// `match`es on its binding has silently swallowed every error the body could raise; the single-call
		// forms catch ONE call's error and are free to ignore it. The question is asked of the handler's own
		// body and nothing else, so the state is saved and restored around exactly that parse — a nested `try`
		// block inside this handler asks its own and gives this one back untouched.
		let savedBindingName = self.bodyState.tryBindingName
		let savedBindingMatched = self.bodyState.tryBindingMatched
		self.bodyState.tryBindingName = tryBlockBindingToMatch(form, binder: binder)
		self.bodyState.tryBindingMatched = false
		let unionBindingDepth = self.bodyState.errorUnionBindings.count()

		let errEnd = try self.parseBlockBody(func, block: errBlock, label: labelTok.value)
		self.bodyState.scope.popScope()
		self.closeDebugScopesAbove(handlerDebugFloor, endsIn: errEnd)

		let matchedTheBinding = self.bodyState.tryBindingMatched
		let requiredBindingName = self.bodyState.tryBindingName
		self.bodyState.tryBindingName = savedBindingName
		self.bodyState.tryBindingMatched = savedBindingMatched

		while self.bodyState.errorUnionBindings.count() > unionBindingDepth 'closeUnionScope'
			_ = try self.bodyState.errorUnionBindings.pop() otherwise panic("parseOtherwiseBlock: errorUnionBindings.pop failed above the depth this handler recorded")
		end 'closeUnionScope'

		if let required = try requiredBindingName.requiredName() 'aBindingToDiscriminate'
			if not matchedTheBinding 'neverDiscriminated'
				throw SourceParseError.tryBlockBindingNotMatched(String.from(required), line: labelTok.line, column: labelTok.column)
			end 'neverDiscriminated'
		end 'aBindingToDiscriminate'

		// Release the caught box on whichever edge leaves the handler — a `__destruct_<U>`/decref on a live
		// fall-through (into `errEnd`), the terminating statement's own `emitFunctionExit` on a return/throw —
		// and drain it off the owned list either way, so the function-end drop never sees a handler binding.
		// A no-op when the handler enrolled nothing (a scalar error, or none).
		self.dropArmScopedOwned(ownedFloor, exitBlock: errEnd, anchor: labelTok)
		try self.requireNoHeldErrorMatchRefusal()

		if errEnd.isTerminated() 'terminated'
			return TryHandler.terminated
		end 'terminated'

		return TryHandler.fellThrough
	end 'parseOtherwiseBlock'

	// ============================================================================
	// The BLOCK-FORM `try` — `try 'l' <statements> end 'l' otherwise (e) 'h' … end 'h'`
	// ============================================================================

	// Parse a block-form `try`: a body whose throwing calls, interface calls and awaits are bare, and
	// one handler every one of them branches to. The single-call form (`parseTry`) puts the `try` on
	// one op and forks around it; this form puts the label on a group and lets every throwing op in it
	// share a handler:
	//
	//     entry   → <body stmts>                                       ; each routed call ends its block with
	//                                                                  ;   flag != 0 ? tryblkerr : tryblkok_N
	//     tryblkok_N → <the rest of the body>                          ; the success continuation
	//     tryblkerr(flag, …carried) → <the `otherwise (e)` handler>
	//     tryblkcont ← both edges, where each fell through
	//
	// ⭐ **THE ERROR BLOCK AND ITS PHIS EXIST BEFORE THE BODY IS PARSED**, which is what makes a single-pass
	// SSA parser able to build this at all: a routed call needs the block id to branch to and the phi slots
	// to fill, and it needs them the instant it is emitted. The carried set is read off the TOKENS first —
	// `parseWhileStatement`'s device, for exactly its reason, and the reason its `blockStatementEndIndex` /
	// `assignedBindingsIn` pair is reused verbatim here rather than approximated.
	//
	// ⭐ **THE BODY'S CALLS ARE ROUTED AT EMIT TIME, NOT BY A POST-PASS.** Neither a post-pass rescan
	// that splits blocks around each throwing call nor routing at the call site into SLOTS survives
	// here: this parser mints SSA values and block args as it goes, so (a) there is no slot for the
	// shared handler to read a flag out of, and (b) a post-pass cannot recover what value each mutable
	// binding held at a call it has already walked past. Routing where the call is emitted is the only
	// point at which BOTH the flag and the live carried values are in hand — see
	// `routeBareThrowingCall`.
	//
	// ⚠ **AND E3057 NEEDS NO CHANGE WHATEVER, WHICH IS THE POINT.** It is keyed on the OP KIND rather
	// than suppressed by a try-block stack — `SemanticCheck.validatePlainCall` fires on a `call`,
	// never on a `tryCall` — so a routed call is exempt because it IS a `tryCall`, and every call this
	// router declines stays a plain `call` and is reported exactly as before. One gate, no second
	// opinion, and a routing door this construct forgets to reach is a LOUD E3057 rather than a
	// dropped flag.
	function parseTryBlockStatement(func IrFunction, block IrBlock) returns IrBlock throws SourceParseError
		self.bodyState.currentBlock = block
		let tryIndex = self.pos
		let tryTok = try self.consume(TokenKind.try)
		let labelTok = try self.consume(TokenKind.charLiteral)

		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		// A match arm's body must be a single statement (E2049).
		//
		// ⚠ **ANCHORED ON THE `try`, WHERE THE BLOCK-`otherwise` FORM ANCHORS ON ITS LABEL — and the
		// asymmetry is the CANONICAL spec's, not a slip.** `specs/match-statements.md:1010` pins column 10
		// (the `try`) for this form and its sibling pins the label for the other. The arm's body BEGINS at
		// this keyword, so this is where the single-statement rule is broken; an `otherwise` is a
		// continuation of a statement that already started legally, and its label is the first token that
		// could not be there.
		if self.bodyState.inMatchArmBody 'inArm'
			throw SourceParseError.tryBlockFormInMatchArm(false, line: tryTok.line, column: tryTok.column)
		end 'inArm'

		// Decided from the tokens, before anything is emitted — see the header. `continuesAtElse: false`:
		// what follows this construct's `end` is an `otherwise`, not an `else`, and `otherwise` opens a
		// block of its OWN (`otherwiseOpensBlockIn`) which the scan must not fold into the body's extent.
		let bodyEndIndex = self.blockStatementEndIndex(tryIndex, continuesAtElse: false)
		let carried = self.assignedBindingsIn(tryIndex, endIndex: bodyEndIndex)

		let errBlock = self.artifact.module.addBlock(func, label: b"tryblkerr", heat: BlockHeat.normal)

		// ⚠ **THE FLAG PHI IS MINTED FIRST AND EVERY EDGE PUSHES IT FIRST.** Block args and edge args are
		// POSITIONAL, so this order IS the pairing — the same contract `mintPhiForBinding` states for the
		// existential witness pair, one construct out.
		let flagPhi = self.mintPhi(errBlock, tag: ValueTypeTag.integer, nameId: UnnamedTypeId)
		let phiVars = self.mintCarriedPhis(errBlock, carried: carried)

		self.bodyState.tryBlocks.push(TryBlockContext.create(tryTok, label: labelTok.value, errBlockId: errBlock.id, flagPhi: flagPhi, phiVars: phiVars, ownedFloor: self.bodyState.ownedBindings.count(), windowFloor: self.openWindowCount()))
		let bodyEnd = try self.parseBlockBody(func, block: block, label: labelTok.value)

		// Guard the token scan against the parse it predicted — `parseWhileStatement`'s guard, and the
		// reason a construct added to `opensBlockAt` is safe to add: a mis-predicted extent is a loud panic
		// rather than a silently lost phi.
		self.assertScanAligned("parseTryBlockStatement", predictedEnd: bodyEndIndex)

		let ctx = try self.bodyState.tryBlocks.pop() otherwise panic("parseTryBlockStatement: the try-block stack is empty after the body of '{String.from(labelTok.value)}' — it is pushed and popped in this one routine")

		try self.requireRoutableTryBlockBody(ctx, tryTok: tryTok)

		// ⭐ **THE VALUES THE BODY LEAVES, CAPTURED BEFORE THE PHIS ARE INSTALLED.** They are the OK edge's
		// half of the final merge; installing first would overwrite them with the error block's phis.
		let bodyVals = self.snapshotBindings(self.bodyState.mutableVars)

		// The move state's twin of `bodyVals`, and it is captured for the same reason one statement apart:
		// the body is one of the two paths reaching the construct's merge, and the drop-gating bit has to
		// arrive there from the body rather than from whatever the handler goes on to do.
		let bodyMoveMark = self.captureMoveMark()
		self.installCarriedPhis(phiVars, phiBlock: errBlock.id)

		let shape = try self.requireTryBlockOtherwise(tryTok)

		// ⚠ Re-fetched by ID rather than reusing the `errBlock` alias minted before the body — NOT because an
		// `IrBlock` alias can go stale (it cannot: blocks are reference objects, and `bodyEnd` is held across
		// this whole handler parse for exactly that reason). It is fetched by id because the id is what the
		// CONTEXT carries: `errBlockId` is the only handle the router had, so reading the block back through
		// it is what proves the block the handler is written into is the one every routed edge branched to.
		self.bodyState.currentBlock = try self.blockById(func, id: ctx.errBlockId) otherwise panic("parseTryBlockStatement: the error block {ctx.errBlockId} of '{String.from(labelTok.value)}' is not in its own function")

		// ⭐⭐ **THE HANDLER IS PARSED AGAINST THE OWNERSHIP STATE THE THROW EDGE CARRIES, NOT THE BODY'S END
		// STATE** — `if`/`else`'s `restoreMoveMark(entryMoveMark)` before the else branch, one construct over.
		// The edge leaves the body AT a routed call, so anything the body moved AFTER that call did not happen
		// on this path and the handler must still see those bindings as live (`requireRoutableTryBlockBody`
		// has already refused a body whose routed calls disagree about this). Without the rewind, a handler
		// that reads or re-moves such a binding would be reasoning about a move that its own path never made.
		self.restoreMoveMark(ctx.edgeMoveMark)

		// ⭐ **THE SYNTHESIZED ERROR UNION, BUILT ONLY NOW — the member list is complete exactly once the body
		// is, and the fused phi must be the LAST block arg, so it cannot be minted before the last routed edge
		// has recorded its own args.**
		let errorUnion = self.synthesizeErrorUnion(ctx, errBlock: self.bodyState.currentBlock)

		// After `synthesizeErrorUnion`: it appends the fused phi to the edges of the routed nodes this
		// discards, and a node it misses branches to the error block one argument short.
		self.discardRoutedReleaseChains(ctx.errBlockId)

		let handler = try self.parseTryBlockHandler(func, shape: shape, flag: self.caughtFlagOf(ctx), errorType: self.tryErrorEnumType(ctx.throwsClause()), errorUnion: errorUnion)
		let errEnd = self.bodyState.currentBlock
		let handlerMoveMark = self.captureMoveMark()

		return self.finishTryBlock(func, bodyEnd: bodyEnd, errEnd: errEnd, bodyVals: bodyVals, handler: handler, bodyMoveMark: bodyMoveMark, handlerMoveMark: handlerMoveMark, tryTok: tryTok)
	end 'parseTryBlockStatement'

	// E3083 (a block-form `try` whose body routes no throwing call) and the refusals the router found
	// but could not raise. All are questions about the whole body, so they are asked once here, after
	// it is parsed and before the handler is.
	function requireRoutableTryBlockBody(ctx TryBlockContext, tryTok Token) throws SourceParseError
		// The premise is the clause, not a counter: `throwsClause` is `none` exactly when nothing was
		// routed, so "did anything route?" and "what does `(e)` bind?" are one fact rather than two that
		// could disagree. A body that routed nothing but minted a deferred value is not refused: `(e)` is
		// bound deferred (`caughtFlagOf`), and the E3004 at the undeclared call is the program's
		// diagnostic.
		if not throwsClauseIsThrowing(ctx.throwsClause()) and not ctx.holdsADeferredValue 'noThrowingCalls'
			throw SourceParseError.tryBlockNoThrows(String.from(ctx.label), line: tryTok.line, column: tryTok.column)
		end 'noThrowingCalls'

		// ⚠ A member the fused dispatch line cannot hold. The handler tells its members apart by one
		// integer built from each member's own tag range; a float-backed error enum's tags are IEEE-754
		// bit patterns, so one spanning a negative and a positive double is wider than i64. A block
		// routing that type alone fuses nothing, which is why this is asked here, where the second member
		// is known.
		if ctx.members.count() > 1 and not ctx.unfusableMember.isEmpty() 'errorTypeTooWideToFuse'
			throw SourceParseError.unsupported("a block-form `try` whose body routes '{ctx.unfusableMember}' alongside another error type — the shared handler tells its members apart by one integer built from each member's own case tags, and this one's tags span more of the i64 range than that line can hold (a FLOAT-backed enum's tags are IEEE-754 bit patterns, so two cases can be ~1.8e19 apart). Give it its own `try` block, or route it through a single-statement `try … otherwise`", line: tryTok.line, column: tryTok.column)
		end 'errorTypeTooWideToFuse'

		// ⚠ The body gave an outer value away between two routed calls, so the handler's one block is
		// reached with that value both live and already moved. The drop that reconciles a conditional
		// move is emitted per edge (`reconcileMovesAtMerge`), and this block builds no per-edge landing
		// pad, so lowered anyway it is a leak on one edge or a double free on another.
		// `poisonOwningBinding` refuses a move that escapes a loop for the same reason.
		if ctx.conflictingMoveEdge 'movedBetweenThrowEdges'
			throw movedBetweenThrowEdgesRefusal(tryTok)
		end 'movedBetweenThrowEdges'
	end 'requireRoutableTryBlockBody'

	function caughtFlagOf(ctx TryBlockContext) returns ValueId
		if throwsClauseIsThrowing(ctx.throwsClause()) 'aRoutedBody'
			return ctx.flagPhi
		end 'aRoutedBody'

		if not ctx.holdsADeferredValue 'neitherRoutedNorDeferred'
			panic("caughtFlagOf: a body that routed nothing and deferred nothing is refused E3083 by `requireRoutableTryBlockBody` before this runs")
		end 'neitherRoutedNorDeferred'

		return self.mintDeferredValue()
	end 'caughtFlagOf'

	// ⭐⭐ **BUILD THE SYNTHESIZED ERROR UNION — the `(e)` binding's type when the body routed TWO OR MORE
	// distinct error enums, which is what most of `/specs/try-block.md` is made of.** Answers `notAUnion` for
	// a body that routed one, and that answer costs nothing: no phi is minted, no edge is touched, and the
	// block is left exactly as the single-enum path built it.
	//
	// ⭐ **THREE THINGS HAPPEN AND THEY ARE ONE THING: THE FUSED ORDINAL BECOMES A REAL SSA VALUE.**
	//   1. A phi is APPENDED to the error block's args, past the flag and the carried set. Block args and edge
	//      args are POSITIONAL, so appending on both sides in the same order IS the pairing — the contract
	//      `parseTryBlockStatement` states for the flag phi, one slot further along. It is safe to append here
	//      and nowhere earlier: every routed edge is recorded by the time the body's `end` is consumed.
	//   2. Each recorded edge PUSHES its fused ordinal onto its own arg list — the very array the `BranchEdge`
	//      holds, so the push IS the attachment.
	//   3. A BOXED member's edge finally computes its ordinal, in the landing pad forced for it (see
	//      `tryBlockThrowEdgeTarget`). It could not be computed at the edge: the load must not stand where the
	//      flag may be `0`.
	//
	// ⭐ **THE LAYOUT IS A DISPATCH TABLE OVER `(member, case)` PAIRS**, in member-then-declaration order,
	// carrying the FUSED tags. `ErrorUnionInfo`'s header says why it holds no payload slots and why it is
	// registered nowhere.
	function synthesizeErrorUnion(ctx TryBlockContext, errBlock IrBlock) returns ErrorUnionMatch
		if ctx.members.count() < 2 'oneErrorTypeIsNoUnion'
			return ErrorUnionMatch.notAUnion
		end 'oneErrorTypeIsNoUnion'

		let fusedPhi = self.mintPhi(errBlock, tag: ValueTypeTag.integer, nameId: UnnamedTypeId)

		// Shared chain nodes forward the error block's args by position, so each takes the fused phi too.
		for node in self.dropCascade().routedNodesTo(ctx.errBlockId) 'eachSharedDropNode'
			node.attachArgument(self.mintPhi(node.block, tag: ValueTypeTag.integer, nameId: UnnamedTypeId))
		end 'eachSharedDropNode'

		let ordinals = ValueIdArray.create(ctx.routedEdges.count(), zeroed: false)

		for k in 0 upto ctx.routedEdges.count() 'computeEach'
			let edge = try ctx.routedEdges.get(k) otherwise panic("synthesizeErrorUnion: routedEdges.get OOB at {k} on a list walked to its own count")
			let ordinal = self.routedEdgeOrdinalForUnion(edge.member, block: edge.block, flag: edge.flag, fusedValue: edge.fusedValue, anchor: edge.anchor)
			ordinals.push(ordinal)
		end 'computeEach'

		for k in 0 upto ctx.routedEdges.count() 'attachEach'
			let ordinal = try ordinals.get(k) otherwise panic("synthesizeErrorUnion: ordinals.get OOB at {k} — the list is filled one entry per edge in the walk above")
			let edge = try ctx.routedEdges.get(k) otherwise panic("synthesizeErrorUnion: routedEdges.get OOB at {k} on a list walked to its own count")
			edge.attachFusedOrdinal(ordinal)
		end 'attachEach'

		return ErrorUnionMatch.synthesized(fusedErrorUnionInfo(ctx.members, fusedOrdinal: fusedPhi))
	end 'synthesizeErrorUnion'

	// ⭐⭐ **THE DISPATCH TABLE FOR A FUSED ERROR UNION — the `(member, case)` pairs in member-then-declaration
	// order, carrying the FUSED tags.** `ErrorUnionInfo`'s header says why it holds no payload slots and why
	// it is registered nowhere.
	//
	// ⚠ **TWO CONSTRUCTS BUILD ONE, AND THEY DIFFER ONLY IN WHERE THE MEMBERS AND THE SUBJECT COME
	// FROM.** A block-form `try` collects its members from what its body ROUTED and its subject is a phi over
	// the throw edges; a `try await` of a send has the send's error and whatever the message declares for
	// members, and its subject is the phi the two edges meet in. Everything after that
	// — the table, the ordering, the tag arithmetic — is one operation, and a second copy of it would be a
	// `match e` arm selected by a table the other half did not build.
	function fusedErrorUnionInfo(members TryBlockErrorMemberArray, fusedOrdinal ValueId) returns ErrorUnionInfo
		let layout = EnumLayout.create(SynthesizedErrorUnionName, isUnion: true, conformsTo: NameRoster.create(0), visibility: Visibility.global, declFilePath: CompilerOwnedDeclFilePath, backing: EnumBacking.integer, isSynthesized: true) as isolated EnumLayout
		let caseMembers = TryBlockErrorMemberArray.create(0)

		for m in 0 upto members.count() 'eachMember'
			let member = try members.get(m) otherwise panic("fusedErrorUnionInfo: members.get OOB at {m} on a list walked to its own count")

			for i in 0 upto member.layout.caseCount() 'eachCase'
				// `declaresRawValue: false` is the literal truth and not a default: this layout exists only to
				// dispatch the fused `match` and no value is ever TYPED by it, so nothing can interpolate one.
				let caseName = member.layout.caseNameAt(i)
				let caseTag = fusedCaseTag(member.layout.tagOfIndex(i), offset: member.fusedTagOffset)
				layout.addCase(caseName, tag: caseTag, rawValue: "", declaresRawValue: false, payloads: PayloadFieldArray.create(0), backingFields: freeze EnumBackingFieldArray.create(0))
				caseMembers.push(member)
			end 'eachCase'
		end 'eachMember'

		return ErrorUnionInfo.create(freeze layout, caseMembers: caseMembers, members: members, fusedOrdinal: fusedOrdinal)
	end 'fusedErrorUnionInfo'

	function caughtErrorFormFor(target TryTarget, fused ValueId) returns CaughtErrorForm
		return match target 'kind'
			named or
			witness or
			promise or
			send or
			serviceReply or
			serviceStart or
			deferred gives CaughtErrorForm.singleCall
			sentReply(messageName, _, sendErrorName) gives self.sentReplyCaughtForm(messageName, sendErrorName: sendErrorName, fused: fused)
		end 'kind'
	end 'caughtErrorFormFor'

	function sentReplyCaughtForm(messageName ByteArray, sendErrorName immutable ByteArray, fused ValueId) returns CaughtErrorForm
		let members = self.sentReplyErrorMembers(messageName, sendErrorName: sendErrorName)

		if members.count() < 2 'oneErrorTypeIsNoUnion'
			return CaughtErrorForm.singleCall
		end 'oneErrorTypeIsNoUnion'

		return CaughtErrorForm.blockForm(ErrorUnionMatch.synthesized(fusedErrorUnionInfo(members, fusedOrdinal: fused)))
	end 'sentReplyCaughtForm'

	function sentReplyErrorMembers(messageName ByteArray, sendErrorName immutable ByteArray) returns TryBlockErrorMemberArray
		let members = TryBlockErrorMemberArray.create(0)
		let sendLayout = self.requireRoutedErrorLayout(sendErrorName)
		members.push(TryBlockErrorMember.create(sendErrorName, clause: ThrowsClause.throwing(String.from(sendErrorName)), isBoxed: sendLayout.carriesPayloads(), layout: sendLayout, placement: serviceSendErrorPlacement(sendLayout)))

		let clause = self.signatures.throwsOf(messageName)
		let errorName = try throwsClauseName(clause) otherwise return members
		let handlerName = freeze errorName.toByteArray()
		members.push(TryBlockErrorMember.create(handlerName, clause: clause, isBoxed: false, layout: serviceReplyErrorLayout(self.signatures, errorName: handlerName), placement: serviceReplyHandlerPlacement(self.signatures, sendLayout: sendLayout, errorName: handlerName)))
		return members
	end 'sentReplyErrorMembers'

	// The value one recorded edge contributes to the fused phi. The two SCALAR shapes settled theirs where the
	// edge was built (`routedEdgeFusedValue`); a BOXED member's is emitted HERE, into the landing pad that
	// exists for exactly this — the pad ends in an unconditional branch, which is what lets an op be appended
	// to it after the fact, and it is reached only when the flag really is a box pointer.
	function routedEdgeOrdinalForUnion(member TryBlockErrorMember, block IrBlock, flag ValueId, fusedValue ValueId, anchor Token) returns ValueId
		if not member.isBoxed 'alreadyComputed'
			return fusedValue
		end 'alreadyComputed'

		let saved = self.bodyState.currentBlock
		self.bodyState.currentBlock = block
		let tag = self.emitUnionTagLoad(flag, range: SourceRange.ofToken(anchor))
		var fused = tag

		if member.fusedTagOffset != 0 'shifted'
			fused = self.emitAddLiteral(tag, addend: member.fusedTagOffset, anchor: anchor)
		end 'shifted'

		self.bodyState.currentBlock = saved
		return fused
	end 'routedEdgeOrdinalForUnion'

	// **E2050 — a block-form `try` must be followed by its `otherwise (e) 'label' … end` handler.**
	// The construct exists to funnel several throwing calls into ONE handler; with no handler there is
	// nothing for a routed error to reach, and the error block would be an unterminated orphan.
	//
	// ⭐⭐ **AND IT CLASSIFIES THE HANDLER, because the three forms diverge at the token after `otherwise`
	// and nowhere else.** `/specs/try-block-otherwise-divergent.md` gives the construct three handlers:
	//   • `otherwise (e) 'h' … end 'h'` — a BLOCK handler. Its binding is REQUIRED: the handler's whole job
	//     is to tell the routed errors apart, which needs a name to `match` on.
	//   • `otherwise [(e)] panic("…")` and `otherwise [(e)] throws E.case` — TERMINAL handlers, a single
	//     expression with no `end` of their own, whose binding is OPTIONAL because nothing has to be
	//     dispatched on it.
	// The SHAPE is returned rather than re-derived at the call site: the same peek deciding admission and then
	// deciding routing would be one grammar written twice, free to admit a form it then declines to parse.
	//
	// ⚠ Whether a binder is PRESENT is deliberately not carried with it. That question belongs to
	// `parseOptionalCaughtErrorBinder`, which two constructs share and which must ask it for itself — the
	// catching `if` reaches that routine with no shape at all. Carrying it here would un-share the binder to
	// save one token test.
	//
	// ⭐ **TWO SPELLINGS OF ONE HANDLER, AND BOTH ARE CANONICAL.** The handler may be ATTACHED to the body's
	// closer — `end 'work' otherwise (e) 'h'`, which `/specs/map-try-otherwise-block.md` uses and
	// `specs/map-try-otherwise-block.md` pins — or STANDALONE, opening its own line after `end 'work'`,
	// which is the only form `/specs/try-block.md` writes (30 times). The two differ by LAYOUT and nothing
	// else: the newlines between the body's `end` and the `otherwise` are the whole difference, so the
	// handler is looked for PAST them.
	//
	// ⚠ **THE CURSOR MOVES ONLY WHEN AN `otherwise` IS ACTUALLY THERE.** Skipping the newlines first and
	// then testing would consume the layout ahead of an ordinary following statement, and the E2050 this
	// routine raises would be anchored past it.
	function requireTryBlockOtherwise(tryTok Token) returns TryBlockHandlerShape throws SourceParseError
		let handlerIndex = self.indexPastNewlines(self.pos)

		if self.kindAt(handlerIndex) != TokenKind.otherwise 'noHandler'
			throw SourceParseError.tryBlockMissingOtherwise(false, line: tryTok.line, column: tryTok.column)
		end 'noHandler'

		self.pos = handlerIndex

		try self.consume(TokenKind.otherwise)

		// UNBOUND: the terminal forms are the only ones that may omit the binding.
		if not self.at(TokenKind.leftParen) 'noBinding'
			if divergentHandlerOpensAt(self.kindAt(self.pos)) 'terminalWithoutABinding'
				return TryBlockHandlerShape.divergent
			end 'terminalWithoutABinding'

			let tok = self.current()
			throw SourceParseError.tryBlockMissingOtherwise(true, line: tok.line, column: tok.column)
		end 'noBinding'

		// BOUND: `( <name> )` followed by the LABEL of a block handler, or by the keyword of a terminal one.
		// All FOUR positions are read, exactly as `otherwiseOpensBlockIn` reads them for the extent scan — so
		// this classification and that one are looking at the same shape rather than at one offset of it, and
		// the offsets carry names instead of arithmetic.
		//
		// ⚠ A MIS-SHAPEN binder (`otherwise (a, b) panic …`, `otherwise () panic …`) falls through to
		// `blockHandler` and is reported by `parseOtherwiseBinding`'s own positioned `consume` — which is the
		// right answer for it: the author wrote something that is neither form, and the parser blames the
		// token that is wrong rather than guessing which form was meant.
		let binderIsWellFormed = self.kindAt(self.pos + 1) == TokenKind.identifier and self.kindAt(self.pos + 2) == TokenKind.rightParen

		if binderIsWellFormed and divergentHandlerOpensAt(self.kindAt(self.pos + 3)) 'terminalWithABinding'
			return TryBlockHandlerShape.divergent
		end 'terminalWithABinding'

		return TryBlockHandlerShape.blockHandler
	end 'requireTryBlockOtherwise'

	// A catching `if`'s `else (e)` and a block-form `try`'s divergent `otherwise (e)` share this.
	// `parseOtherwiseBinding` cannot: its binding is mandatory. `otherwiseOpensBlockIn` reads the same
	// `( <name> )` by token index, as a lookahead that must answer before the cursor moves.
	function parseOptionalCaughtErrorBinder(fallbackAnchor Token) returns CaughtErrorBinder throws SourceParseError
		if not self.at(TokenKind.leftParen) 'noBinder'
			return CaughtErrorBinder.anonymous(fallbackAnchor)
		end 'noBinder'

		try self.consume(TokenKind.leftParen)
		let eNameTok = try self.consume(TokenKind.identifier)

		// ⛔ **A CAUGHT ERROR IS A DECLARATION, SO IT ASKS THE DECLARATION DOOR** — `requireUnreservedName`'s
		// header gives the reason at length, and BOTH of this routine's callers measured it independently:
		// `otherwise (__x) panic(…)` and `end 'c' else (__e) 'err'` each declared a `__`-prefixed local and RAN
		// where the oracle refuses it E2051.
		try self.requireUnreservedName(eNameTok, declaredName: eNameTok.value)
		try self.consume(TokenKind.rightParen)
		return CaughtErrorBinder.named(eNameTok.value, anchor: eNameTok)
	end 'parseOptionalCaughtErrorBinder'

	// ⭐⭐ **`panic("…")` / `throws E.case` — THE TWO DIVERGING TERMINAL FORMS, PARSED ONCE.** Three positions
	// spell this pair and mean the same by it: a match arm's `default`, a match EXPRESSION arm's BODY —
	// where its `gives` would go, the keyword replacing it (`red panic("…")` —
	// `specs/match-expr-arm-divergent.md`, which is why this is a shared door and not a second fork) — and a
	// block-form `try`'s divergent `otherwise`. All admit it through
	// `divergentHandlerOpensAt`, all seat it in a block their caller chose, and all rely on it TERMINATING
	// that block. The two LEAF routines are shared, which is what makes a copy of the fork easy to miss.
	//
	// ⚠ **THE SINGLE-CALL `try f() otherwise throw E.x` IS DELIBERATELY NOT ONE OF THEM.** It spells `throw`,
	// not `throws`, and it lives in `parseUnboundOtherwiseForm` beside `ignore`, `return`/`break`/`continue`
	// and a fallback VALUE — none of which these two admit. Same leaves, different grammar; folding it in
	// would make this the fork for a keyword set it does not have.
	function parseDivergingTerminalForm(func IrFunction, block IrBlock) throws SourceParseError
		if self.at(TokenKind.throws) 'rethrow'
			self.bodyState.currentBlock = block
			let throwsTok = try self.consume(TokenKind.throws)
			try self.emitThrowError(func, anchor: throwsTok)
			return
		end 'rethrow'

		if self.at(TokenKind.panic) 'abort'
			try self.parsePanicStatement(func, block: block)
			return
		end 'abort'

		panic("parseDivergingTerminalForm: the token here is neither `throws` nor `panic` — every caller admits this form through `divergentHandlerOpensAt`, which is the one roster of the two keywords")
	end 'parseDivergingTerminalForm'

	// ⭐⭐ **PARSE THE HANDLER THE SHAPE NAMED.** One fork, at the one point both handler kinds have their
	// error TYPE and their synthesized UNION in hand — so what a divergent handler's optional `(e)` binds is
	// the same thing a block handler's required one binds, by construction rather than by two agreeing copies.
	function parseTryBlockHandler(func IrFunction, shape TryBlockHandlerShape, flag ValueId, errorType MaxonType, errorUnion ErrorUnionMatch) returns TryHandler throws SourceParseError
		match shape 'shape'
			blockHandler then return try self.parseOtherwiseBinding(func, flag: flag, errorType: errorType, form: CaughtErrorForm.blockForm(errorUnion))
			divergent then return try self.parseDivergentOtherwise(func, flag: flag, errorType: errorType, errorUnion: errorUnion)
		end 'shape'
	end 'parseTryBlockHandler'

	// ⭐⭐ **`otherwise [(e)] panic("…")` / `otherwise [(e)] throws E.case` — THE TERMINAL HANDLERS.** Both
	// DIVERGE, so the construct has exactly one live edge past it (the body's), and both are a single
	// expression with no `end` of their own.
	//
	// ⭐ **THE OPTIONAL BINDING GOES THROUGH `declareCaughtError`, THE SAME DOOR THE BLOCK FORM USES**, so
	// what `(e)` means here is what it means there — a scalar enum's decoded ordinal or a boxed union's
	// pointer — rather than a second answer that could drift from it. Its binder is `parseOptionalCaughtErrorBinder`,
	// shared with the catching `if`'s `else (e)`, for the same reason one level down.
	//
	// ⭐⭐ **E3084 DOES NOT APPLY HERE, AND THE MECHANISM IS THIS ROUTINE'S SILENCE.** A block handler owes a
	// `match` on its binding because it RUNS: one that never discriminates has swallowed every error the body
	// can raise. A divergent handler aborts or re-throws, so it swallows nothing and owes nothing. The
	// obligation is armed by `parseOtherwiseBlock` — which sets `tryBindingName`/`tryBindingMatched` around
	// its own body and checks them at its end — and this routine never calls it and never touches either
	// field, so the rule simply never arms. ⚠ It is stated HERE because that is where it happens: a
	// `CaughtErrorForm` case for it would look like documentation and be a redundant arm on a call that cannot
	// occur, since `tryBlockBindingToMatch` is reached only from `parseOtherwiseBlock`.
	//
	// ⚠ **AND THE TWO FIELDS ARE DELIBERATELY NOT SAVED AND RESTORED.** A divergent handler is still
	// lexically inside any ENCLOSING handler's body, so a `match e` written in its panic message or throw
	// expression legitimately discharges that enclosing handler's obligation. Only a CLOSURE crosses a
	// function boundary, and that is where the reset lives.
	//
	// ⚠ **THE CAUGHT ERROR STILL OWES ITS DROP, WHICH IS WHY THE SCOPE FRAME IS HERE.** A boxed error
	// reaching a `panic` or a re-throw is a live heap box this frame received ownership of; `declareCaughtError`
	// enrols it (NAMED, or ANONYMOUS when the form binds nothing), the terminating form's own
	// `emitScopeDrops`/`emitHandoffExit` releases it on the way out, and `dropArmScopedOwned` drains it
	// off the owned list either way. This is `parseOtherwiseHandler`'s bracket around the single-call
	// terminal forms, applied to the block form's — one rule, two constructs.
	function parseDivergentOtherwise(func IrFunction, flag ValueId, errorType MaxonType, errorUnion ErrorUnionMatch) returns TryHandler throws SourceParseError
		let binder = try self.parseOptionalCaughtErrorBinder(self.current())
		try self.rejectDivergentBindingOverErrorUnion(binder, errorUnion: errorUnion)

		let ownedFloor = self.bodyState.ownedBindings.count()
		let unionBindingDepth = self.bodyState.errorUnionBindings.count()
		let form = CaughtErrorForm.blockForm(errorUnion)
		let handlerDebugFloor = self.bodyState.debugOpenSlots.count()
		self.bodyState.scope.pushScope()
		try self.declareCaughtError(flag, errorType: errorType, binder: binder, form: form)

		// ⚠ **A SYNTHESIZED UNION'S BOX IS RELEASED HERE FOR THE REASON A `default` ARM'S IS.** Over a union
		// the binding owns nothing at all — the flag is an ordinal on some incoming edges and a box POINTER on
		// others, so `declareErrorUnionBinding` gives it no type and no drop, and the box is released by
		// whichever ARM the dispatch enters. A divergent handler names no member, so it releases whichever boxed
		// member is in flight through the same `emitErrorUnionBoxReleases` a `default` arm reaches.
		//
		// ⛔ **IT RUNS BEFORE THE FORM PARSES, AND THAT IS ONLY SOUND BECAUSE THE BINDING IS REFUSED ABOVE.**
		// The release `__destruct_`s the in-flight box; a binding readable AFTERWARDS would be naming a freed
		// one. `rejectDivergentBindingOverErrorUnion` is what makes "readable afterwards" impossible — remove
		// it and this ordering becomes a wrong VALUE, which is exactly what review measured.
		self.releaseCombinedErrorBox(func, form: form, flag: flag, anchor: binder.anchor)

		try self.parseDivergingTerminalForm(func, block: self.bodyState.currentBlock)

		self.bodyState.scope.popScope()
		self.closeDebugScopesAbove(handlerDebugFloor, endsIn: self.bodyState.currentBlock)

		while self.bodyState.errorUnionBindings.count() > unionBindingDepth 'closeUnionScope'
			_ = try self.bodyState.errorUnionBindings.pop() otherwise panic("parseDivergentOtherwise: errorUnionBindings.pop failed above the depth this handler recorded")
		end 'closeUnionScope'

		self.dropArmScopedOwned(ownedFloor, exitBlock: self.bodyState.currentBlock, anchor: binder.anchor)
		return TryHandler.terminated
	end 'parseDivergentOtherwise'

	// ⛔⛔ **A DIVERGENT `otherwise` MAY NOT BIND THE ERROR WHEN THE BODY ROUTES TWO OR MORE ERROR
	// TYPES, because the alternative is a MEANINGLESS VALUE.** `(e)` would name the compiler's synthesized
	// error union, which has NO value form: it is a dispatch table over `(member, case)` pairs
	// (`ErrorUnionInfo`), the binding carries the raw flag typed `integer`, and only a `match` ARM
	// recovers a member's own type from it. Every other form that binds such a union is a `match` away
	// from a real type; this is the first that is not, because E3084 does not reach it.
	//
	// ⭐ There is nothing for `(e)` to name. `otherwise (e) panic("failed: {e}")` over a body throwing
	// two distinct error types can print only the raw `ordinal + bias` flag — an internal ABI value
	// with no meaning to the author — and on a BOXED member's edge that fused ordinal is the numeric
	// value of a pointer the union cleanup one statement below has already freed. A diagnostic naming
	// what is missing beats a silent answer.
	//
	// It rejects nothing any spec requires: `/specs/try-block-otherwise-divergent.md` binds only over a
	// single error type, and every one of its multi-type cases is UNBOUND — which stays legal, and is exactly
	// the shape the union cleanup exists for.
	function rejectDivergentBindingOverErrorUnion(binder CaughtErrorBinder, errorUnion ErrorUnionMatch) throws SourceParseError
		if not binder.isNamed() or not errorUnionIsSynthesized(errorUnion) 'nothingToRefuse'
			return
		end 'nothingToRefuse'

		throw SourceParseError.unsupported("binding the caught error of a DIVERGENT `otherwise` whose body routes TWO OR MORE error types — `(e)` would name the synthesized error union, which has no value form: it is a dispatch table over the `(member, case)` pairs, so the binding could carry only the raw error flag and neither a message nor a payload could say which error occurred. Bind it in a block handler, whose `match` arms recover each member's own type (`otherwise (e) 'h' … match e … end 'h'`), or drop the binding — `otherwise panic(…)` and `otherwise throws E.case` catch every member", line: binder.anchor.line, column: binder.anchor.column)
	end 'rejectDivergentBindingOverErrorUnion'

	// ⭐ **WHERE CONTROL GOES AFTER THE CONSTRUCT — FOUR SHAPES FROM TWO INDEPENDENT FACTS**: whether the
	// BODY fell through, and whether the HANDLER did. Each is settled by its own block's terminator, so
	// there is nothing to remember and no fifth case to forget.
	//
	// ⭐ **EACH SHAPE SETTLES TWO AXES, NOT ONE — the carried VALUES and the drop-gating MOVE state** —
	// and they are settled together here for the reason `finalizeIfElse` settles them together: the
	// surviving path's state prevails, and a shape that carried the values across without the move
	// bits would keep answering correctly while silently leaking or double-freeing. A handler that
	// moves an outer owned binding and then returns would otherwise leave it marked moved on the
	// BODY's continuation, so its function-end drop is skipped: exit 101.
	function finishTryBlock(func IrFunction, bodyEnd IrBlock, errEnd IrBlock, bodyVals ValueIdArray, handler TryHandler, bodyMoveMark MoveMark, handlerMoveMark MoveMark, tryTok Token) returns IrBlock
		let bodyFellThrough = not bodyEnd.isTerminated()

		// ⚠ Read off the HANDLER's own verdict rather than re-asking `errEnd.isTerminated()`. The two agree
		// today — that test is exactly how `parseOtherwiseBlock` decides what to return — and asking it again
		// here would be that one fact spelled in two places, free to disagree the day a handler form
		// terminates without terminating its final block.
		let handlerFellThrough = match handler 'h'
			terminated gives false
			fellThrough gives true
			value panic("finishTryBlock: a block-form `try`'s handler is parsed by `parseTryBlockHandler`, whose two routes are `parseOtherwiseBinding` (reaching only `parseOtherwiseBlock`, which answers `terminated`/`fellThrough`) and `parseDivergentOtherwise` (which answers `terminated` unconditionally) — a `value` handler is the single-call form's `otherwise <expr>` fallback and cannot arrive from either")
		end 'h'

		if bodyFellThrough and handlerFellThrough 'bothEdges'
			// Two live predecessors — the ordinary two-way merge, minting a phi only where the edges
			// disagree about a carried binding (`mergeAtContinuation`, the same one `if`/`else` uses).
			let cont = self.artifact.module.addBlock(func, label: b"tryblkcont", heat: BlockHeat.normal)
			let handlerVals = self.snapshotBindings(self.bodyState.mutableVars)

			// ⭐ **A CONDITIONAL MOVE RECONCILED ACROSS THE TWO LIVE EDGES** — a binding moved on one and left
			// live on the other is dropped on the LIVE edge and marked uniformly moved past the merge, so the
			// later scope-exit drop is right on both. Emitted BEFORE the phi edges and the branches, exactly as
			// `finalizeIfElse` does it, so each decref lands in its own edge's block ahead of that block's jump.
			self.reconcileMovesAtTwoEdgeMerge(bodyEnd, markA: bodyMoveMark, b: errEnd, markB: handlerMoveMark, anchor: tryTok)

			self.mergeAtContinuation(bodyEnd, predB: errEnd, cont: cont, bindings: self.bodyState.mutableVars, valsA: bodyVals, valsB: handlerVals)
			self.emitBranch(bodyEnd, targetId: cont.id)
			self.emitBranch(errEnd, targetId: cont.id)
			self.bodyState.currentBlock = cont
			return cont
		end 'bothEdges'

		if bodyFellThrough 'onlyTheBody'
			// The handler terminated (`return`/`throw`/`panic`/`break`/`continue`), so neither its
			// reassignments nor its MOVES reach the continuation — restore every carried binding and the
			// drop-gating bit to what the BODY left, exactly as `finishTerminatedTry` restores the pre-try
			// state for the single-call form. The handler dropped its own live values on the way out.
			self.restoreBindings(self.bodyState.mutableVars, snapshot: bodyVals)
			self.restoreMoveMark(bodyMoveMark)
			self.bodyState.currentBlock = bodyEnd
			return bodyEnd
		end 'onlyTheBody'

		if handlerFellThrough 'onlyTheHandler'
			// The body terminated on every path (its last statement was a `return`/`throw`), so only the
			// handler continues and the carried bindings already read its values — nothing to merge. The move
			// restore is a no-op today for the same reason `finalizeIfElse`'s `onlyElse` arm's is (the handler
			// was parsed last and nothing has touched the state since); it is written anyway so "the surviving
			// path's state prevails" is stated once per axis rather than resting on parse order.
			self.restoreMoveMark(handlerMoveMark)
			self.bodyState.currentBlock = errEnd
			return errEnd
		end 'onlyTheHandler'

		// Neither edge falls through, so control leaves through the terminators the two blocks carry.
		// What follows the construct parses into a dead block (`newDeadBlock`): a statement there would
		// otherwise emit into a block that already has a terminator.
		self.bodyState.currentBlock = self.newDeadBlock(func, label: b"tryblkcont")
		return self.bodyState.currentBlock
	end 'finishTryBlock'

	// Route a just-emitted call to the handler that catches its throw. Every door that emits a
	// throwing op shares one decision (`throwRouteDestination`): an enclosing block-form `try` wins,
	// innermost first; otherwise a test body's implied handler; otherwise nowhere, and the op stays
	// plain for E3057. The call doors (`emitCall`, `emitRuntimeCallInto`) ask here,
	// `emitWitnessDispatch` and `emitAwait` ask `routeThrowingOp` directly, and an op a claim held is
	// routed on release by `routeHeldOp`. The destination is asked before the callee's clause because
	// this is on the path of every call the compiler emits, and almost none is inside a `try` block or
	// a test body.
	//
	// The routing decision and the `(e)` binding's type come from one lookup: `throwsOf` answers both
	// "does this callee throw" and "which enum" (a declared function's clause, or
	// `runtimeThrowsClause` for a compiler-internal callee), so a routed call always gives the handler
	// a type, and a callee whose family answers `none` is left for E3057 rather than routed to a
	// handler that could not bind it. That is why the gate is the clause and not the wider
	// `isThrowingRuntimeCallee`.
	function routeBareThrowingCall(callee ByteArray, opIdx ElementIndex, result ValueId)
		let destination = self.unclaimedThrowRouteDestination()

		if destination == ThrowRouteDestination.nowhere 'nothingCatchesIt'
			return
		end 'nothingCatchesIt'

		self.routeThrowingOp(destination, opIdx: opIdx, clause: self.signatures.throwsOf(callee), result: result)
	end 'routeBareThrowingCall'

	function throwRouteDestination() returns ThrowRouteDestination
		if self.bodyState.tryBlocks.count() > 0 'insideATryBlock'
			return ThrowRouteDestination.enclosingTryBlock
		end 'insideATryBlock'

		if self.bodyState.enclosingBodyKind == EnclosingBodyKind.testBody 'insideATestBody'
			return ThrowRouteDestination.impliedTestHandler
		end 'insideATestBody'

		return ThrowRouteDestination.nowhere
	end 'throwRouteDestination'

	function unclaimedThrowRouteDestination() returns ThrowRouteDestination
		let destination = self.throwRouteDestination()
		return ThrowRouteDestination.nowhere if claimCovers(self.bodyState.throwRouteClaim, destination: destination) else destination
	end 'unclaimedThrowRouteDestination'

	// It cannot throw: `emitRuntimeCall` reaches it and is non-throwing with dozens of callers, so a
	// throwing router would charge this construct to every runtime call. Hence `bodyFunction` for the
	// function, `emitErrorFlagTest` for the flag test, and a refusal routing discovers is recorded on
	// the `TryBlockContext` (`unfusableMember`, `conflictingMoveEdge`) and raised by
	// `requireRoutableTryBlockBody` at the body's end.
	function routeThrowingOp(destination ThrowRouteDestination, opIdx ElementIndex, clause ThrowsClause, result ValueId)
		if not throwsClauseIsThrowing(clause) 'cannotThrow'
			return
		end 'cannotThrow'

		match destination 'destination'
			nowhere then return
			enclosingTryBlock then self.routeToTryBlock(opIdx, clause: clause, result: result)
			impliedTestHandler then self.routeToImpliedTestHandler(opIdx, clause: clause, result: result)
		end 'destination'
	end 'routeThrowingOp'

	function openClaim(claim ThrowRouteClaim) returns ClaimScope
		let opened = ClaimScope.create(self.bodyState.throwRouteClaim, enclosingFloor: self.statement.claimOpFloor, floor: self.artifact.module.ops.count(), heldAwaitMark: self.heldAwaits.count())
		self.bodyState.throwRouteClaim = claim
		self.statement.claimOpFloor = opened.floor
		return opened
	end 'openClaim'

	function closeClaim(claim ClaimScope, keepsTheCoveredAwait bool) throws SourceParseError
		self.restoreClaim(claim.enclosingClaim)
		self.statement.claimOpFloor = claim.enclosingFloor

		if self.heldAwaits.count() == claim.heldAwaitMark 'nothingWasHeld'
			return
		end 'nothingWasHeld'

		let covered = self.opProducingTheValue(claim.floor)
		let coveredAwait = HeldAwaitArray.create(0)

		for i in claim.heldAwaitMark upto self.heldAwaits.count() 'eachHeldAwait'
			let held = try self.heldAwaits.get(i) otherwise panic("closeClaim: heldAwaits.get OOB at {i} on a range walked to its own count")

			if valueProducerIs(covered, opIdx: held.opIdx) 'theClaimedValue'
				coveredAwait.push(held)
				continue
			end 'theClaimedValue'

			if routableOpIsAwait(self.routableOpAt(held.opIdx)) 'neverCaught'
				try self.rejectPlainAwaitOfThrowing(held.target, clause: held.clause, awaitTok: held.awaitTok)
			end 'neverCaught'
		end 'eachHeldAwait'

		self.heldAwaits.truncate(claim.heldAwaitMark)

		if keepsTheCoveredAwait 'aLaterReleaseRoutesIt'
			for held in coveredAwait 'keepTheClaimedValue'
				self.heldAwaits.push(held)
			end 'keepTheClaimedValue'
		end 'aLaterReleaseRoutesIt'
	end 'closeClaim'

	function swapClaim(claim ThrowRouteClaim) returns ThrowRouteClaim
		let enclosing = self.bodyState.throwRouteClaim
		self.bodyState.throwRouteClaim = claim
		return enclosing
	end 'swapClaim'

	function restoreClaim(enclosing ThrowRouteClaim)
		self.bodyState.throwRouteClaim = enclosing
	end 'restoreClaim'

	function releaseCompletedOperand()
		if self.bodyState.throwRouteClaim != ThrowRouteClaim.unclaimed 'claimed'
			self.releaseHeldThrowingOp(self.statement.claimOpFloor, heldBy: self.bodyState.throwRouteClaim)
		end 'claimed'
	end 'releaseCompletedOperand'

	function parseUnclaimedUnary(func IrFunction) returns ValueId throws SourceParseError
		let enclosing = self.swapClaim(ThrowRouteClaim.unclaimed)
		let operand = try self.parseUnary(func)
		self.restoreClaim(enclosing)
		return operand
	end 'parseUnclaimedUnary'

	function parseUnclaimedPrimaryChain(func IrFunction) returns ValueId throws SourceParseError
		let enclosing = self.swapClaim(ThrowRouteClaim.unclaimed)
		let operandStart = self.bodyState.operandOrder.eventCount()
		let operand = try self.parsePostfix(func, operandStart: operandStart, value: try self.parsePrimary(func), resultUsed: true)
		self.restoreClaim(enclosing)
		return operand
	end 'parseUnclaimedPrimaryChain'

	function parseUnclaimedBinary(func IrFunction, minPrec InfixPrecedence) returns ValueId throws SourceParseError
		let enclosing = self.swapClaim(ThrowRouteClaim.unclaimed)
		let operand = try self.parseBinary(func, minPrec: minPrec)
		self.restoreClaim(enclosing)
		return operand
	end 'parseUnclaimedBinary'

	function releaseHeldThrowingOp(floor ElementIndex, heldBy ThrowRouteClaim)
		match self.opProducingTheValue(floor) 'producer'
			noOwnOp then return
			at(opIdx) then self.routeHeldOp(opIdx, heldBy: heldBy)
		end 'producer'
	end 'releaseHeldThrowingOp'

	function routeHeldOp(opIdx ElementIndex, heldBy ThrowRouteClaim)
		let destination = self.throwRouteDestination()

		if not claimCovers(heldBy, destination: destination) 'routedAtItsOwnDoor'
			return
		end 'routedAtItsOwnDoor'

		match self.routableOpAt(opIdx) 'held'
			notRoutable or
			division or
			tryChannelCall then return
			send(result) then self.routeSend(destination, opIdx: opIdx, result: result)
			call(result, callee, _) then self.routeThrowingOp(destination, opIdx: opIdx, clause: self.signatures.throwsOf(callee), result: result)
			witness(result) then self.routeThrowingOp(destination, opIdx: opIdx, clause: self.tryTargetThrows(recordedTryTargetOf(self.statement.lastWitnessDispatch, opIdx: opIdx)), result: result)
			await (result, _) then self.routeThrowingOp(destination, opIdx: opIdx, clause: self.heldAwaitClause(opIdx), result: result)
		end 'held'
	end 'routeHeldOp'

	function heldAwaitClause(opIdx ElementIndex) returns ThrowsClause
		for held in self.heldAwaits 'eachHeldAwait'
			if held.opIdx == opIdx 'thisAwait'
				return held.clause
			end 'thisAwait'
		end 'eachHeldAwait'

		panic("heldAwaitClause: the plain `await` at op {opIdx} was released from a claim that covers its destination and is not in `heldAwaits` — `emitAwait` holds every await a claim covers")
	end 'heldAwaitClause'

	// The one classifier of which ops the try channel can carry. Every rewrite (`rewriteToTryChannel`)
	// and every reader of a producing op asks it, so an op added to `MaxonOp` is classified once.
	function routableOpAt(opIdx ElementIndex) returns RoutableOp
		return match try self.artifact.module.ops.get(opIdx) otherwise panic("routableOpAt: opRef {opIdx} not in module.ops") 'op'
			call(result, callee, args, _, _, _, _) gives RoutableOp.send(result) if callee.equals(CownInterfaceSendName) else RoutableOp.call(result, callee: callee, receiver: receiverArgumentOf(args))
			serviceSend(result, _, _, _, _, _, _, _) gives RoutableOp.send(result)
			tryCall(result, _, callee, args, _, _, _, _) gives RoutableOp.tryChannelCall(result, callee: callee, receiver: receiverArgumentOf(args))
			witnessDispatch(result, _, _, _, _, _, _, _) gives RoutableOp.witness(result)
			await (result, promise) gives RoutableOp.await(result, promise: promise)
			binOp(_, _, _, op) gives RoutableOp.division(op) if divisionOperator(op) else RoutableOp.notRoutable
			literal or
			ret or
			retVoid or
			unaryOp or
			compare or
			condBranch or
			branch or
			globalAddr or
			loadIndirect or
			storeIndirect or
			stringLiteral or
			throwError or
			propagateError or
			panicAbort or
			functionRef or
			indirectCall or
			asyncCall or
			tryAwait or
			sizeofType or
			constArrayLiteral or
			switch or
			witnessTryDispatch or
			panicAbortValue or
			errorFlagEncode or
			serviceSpawn or
			serviceReplyCell or
			immortalStructRecord or
			immortalStringTable or
			covPoint or
			rawIntrinsic or
			existentialWitness or
			holdValue or
			holdEnd gives RoutableOp.notRoutable
		end 'op'
	end 'routableOpAt'

	function routeToImpliedTestHandler(opIdx ElementIndex, clause ThrowsClause, result ValueId)
		let func = self.bodyFunction()
		let flag = self.rewriteRoutedOp(opIdx)
		self.forkOntoPropagatingHandler(func, flag: flag, clause: clause, result: result, anchor: anchorTokenSpanning(self.artifact.opRanges.get(opIdx)), reportsTheThrow: self.testBodyAbsorbs(clause), leg: SentLegSlot.none)
	end 'routeToImpliedTestHandler'

	function namingCallerName() returns immutable ByteArray
		if self.artifact.module.functions.isEmpty() 'noBodyWasEverParsed'
			return EmptySourceText
		end 'noBodyWasEverParsed'

		return self.bodyFunction().name
	end 'namingCallerName'

	function bodyFunction() returns IrFunction
		return try self.artifact.module.functions.get(self.artifact.currentFuncIndex) otherwise panic("bodyFunction: the function whose body is being parsed ({self.artifact.currentFuncIndex}) is not in this file's module — every body door pushes its function before it stamps the index")
	end 'bodyFunction'

	function blockById(func IrFunction, id BlockId) returns IrBlock throws BlockRefLookupError
		let blockCount = func.blockRefs.count()

		for position in self.bodyState.blockPositionsCovered upto blockCount 'indexNewBlocks'
			self.bodyState.blockPositions.place(self.artifact.module.blockAtPosition(func, position: position).id, value: position)
		end 'indexNewBlocks'

		self.bodyState.blockPositionsCovered = blockCount

		let block = try self.artifact.module.getBlockByIdThrough(func, byId: self.bodyState.blockPositions, id: id)

		if block.id != id 'staleIndex'
			panic("blockById: the body's block index put block {id} at a position holding block {block.id} of '{String.from(func.name)}'")
		end 'staleIndex'

		return block
	end 'blockById'

	// Membership, not `valueIsOwnedHeap`, decides whether a routed or `try`ed result owes a drop: a
	// promise result is pending without the owned-heap bit, and a routed runtime-call result is
	// enrolled by its caller only after the door returns. Every edge that re-homes the result carries
	// this answer (`TryFork.resultWasPending`, `IfCondition.tryCatch`).
	function takeOffPendingTemps(value ValueId) returns bool
		let count = self.bodyState.pendingTempDrops.count()

		if count > 0 and (try self.bodyState.pendingTempDrops.get(count - 1) otherwise panic("takeOffPendingTemps: pendingTempDrops.get OOB on a list whose count was just read as non-zero")) == value 'theNewestPendingTemp'
			_ = try self.bodyState.pendingTempDrops.pop() otherwise panic("takeOffPendingTemps: pendingTempDrops.pop failed on a non-empty list")
			return true
		end 'theNewestPendingTemp'

		if not self.pendingTempsContain(value) 'notPending'
			return false
		end 'notPending'

		self.removeFromPendingTemps(value)
		return true
	end 'takeOffPendingTemps'

	function returnToPendingTemps(value ValueId, wasPending bool)
		if wasPending 'backOnTheOkPath'
			self.bodyState.pendingTempDrops.push(value)
		end 'backOnTheOkPath'
	end 'returnToPendingTemps'

	function routeToTryBlock(opIdx ElementIndex, clause ThrowsClause, result ValueId)
		let ctx = self.innermostTryBlock()
		let member = self.recordRoutedEdge(ctx, clause: clause)
		let flag = self.rewriteRoutedOp(opIdx)
		self.carryWindowBirthFrom(ctx.flagPhi, source: flag)
		let func = self.bodyFunction()

		// The success continuation. Everything the rest of the body emits lands here, so a second throwing
		// call in the same body splits THIS block in turn — which is how N calls reach one handler with no
		// N-aware bookkeeping anywhere.
		let okBlock = self.artifact.module.addBlock(func, label: b"tryblkok", heat: BlockHeat.normal)

		// ⚠ **THE FUSED ORDINAL IS COMPUTED HERE, WHILE THIS BLOCK STILL HAS NO TERMINATOR.** It is the ONE
		// moment it can be: `IrModule.appendOp` refuses to append past a conditional branch (an op there would
		// run on the not-taken edge only), and the branch is two statements away. A first SCALAR member spends
		// nothing — see `routedEdgeFusedValue`.
		let fused = self.routedEdgeFusedValue(member, flag: flag, anchor: ctx.tryTok)
		let isErr = self.emitErrorFlagTest(flag, op: MaxonCmpOp.ne, anchor: ctx.tryTok)

		let errArgs = self.tryBlockErrorEdgeArgs(ctx, flag: flag)

		// This op's own result is owned only on the ok edge, so it comes off the pending list while the
		// error edge is built. A managed result arrives already enrolled (`enrolOwnedCallTemp`), and the
		// landing pad below drains that list on the error edge, where the result register was never
		// written: a decref there is an access violation. `openTryFork` guards its own fork against the
		// same hazard.
		//
		// It is removed before the edge is built, not inside it, so `tryBlockThrowEdgeTarget`'s "does
		// this site owe anything?" test sees the list its drops will walk: an op whose only pending temp
		// is its own result owes nothing on the error edge and needs no pad.
		//
		// It goes straight back afterwards, where `openTryFork` leaves it off until a finish path: that
		// fork splits the whole statement and each finish re-homes the result, while here the ok
		// continuation is the same statement, which still owes the drop. It is re-pushed at the tail,
		// which is where it was.
		let resultWasPending = self.takeOffPendingTemps(result)
		let errTargetId = self.tryBlockThrowEdgeTarget(ctx, errArgs: errArgs, flag: flag, member: member, fusedValue: fused, anchor: ctx.tryTok)
		self.returnToPendingTemps(result, wasPending: resultWasPending)

		self.emitCondBranch(self.bodyState.currentBlock, cond: isErr, thenId: errTargetId, elseId: okBlock.id, ifTok: ctx.tryTok)
		self.bodyState.currentBlock = okBlock
	end 'routeToTryBlock'

	// ⭐⭐ **ONE ROUTED ERROR EDGE'S ARGUMENT LIST: THE FLAG FIRST, THEN EVERY CARRIED BINDING'S VALUE RIGHT
	// HERE.** Positional against the phis `parseTryBlockStatement` minted in that order — and the fused
	// ordinal `synthesizeErrorUnion` appends LAST lands past both, on this list and on `blockArgs` alike.
	// `edgeArgsFor(preLoop: false)` reads each binding's CURRENT value, which is exactly what this point in
	// the body left it holding.
	//
	// ⚠ **IT IS ONE ROUTINE BECAUSE THE ORDER IS AN ABI BETWEEN TWO SITES THAT CANNOT SEE EACH OTHER.** Both
	// routing doors build this list and `errBlock.blockArgs` is matched against it BY POSITION, so a leading
	// argument added to one copy and not the other is a phi reading another binding's value — a wrong answer,
	// with nothing to report it. `parseWhileStatement` keeps its own edge list in one place
	// (`loopHeaderArgs`) for the same reason.
	function tryBlockErrorEdgeArgs(ctx TryBlockContext, flag ValueId) returns ValueIdArray
		let errArgs = ValueIdArray.create(0)
		errArgs.push(flag)

		for arg in self.edgeArgsFor(ctx.phiVars, preLoop: false) 'carried'
			errArgs.push(arg)
		end 'carried'

		return errArgs
	end 'tryBlockErrorEdgeArgs'

	// ⭐⭐ **WHERE THE THROW EDGE ACTUALLY GOES — the shared error block, or a LANDING PAD in front of
	// it that releases what the body owns at THIS call.** A routed throw jumps over the body's `end`,
	// so none of the drops that fall-through would have run do: the temporaries the half-finished
	// statement built (`f(Item.create())` where `f` throws) and every owned binding the body declared
	// before this point would both leak. They cannot be released in the shared error block — it is
	// reached from every routed call, each owing a DIFFERENT set — so each site that owes anything
	// gets its own one-way pad, which releases its temporaries and its innermost owner and joins the
	// `ReleaseChain` every routed site shares. It is the SAME RULE the expression-level `try` reaches
	// by another route: release what the half-finished statement owes on each path that ABANDONS it,
	// never once per construct. That fork suspends its temporaries as owned bindings instead
	// (`Parser.suspendForkTempsAsOwned`), because its abandoning paths are the handler's own exits and
	// those already carry scope drops; here the abandoning paths are routed CALL SITES, which do not,
	// so each gets a pad.
	//
	// ⚠ **THE PENDING TEMP LIST IS READ, NOT CLEARED.** The OK path continues and still owes those same
	// temporaries at the end of its statement, so clearing here would leak them on the path that did not
	// throw. `desugarTry` keeps the same property by a different mechanism — it hands its list back
	// (`resumeForkTemps`) once both edges are wired.
	//
	// A site owing nothing branches straight to the error block: no pad, no block, no drops.
	//
	// ⚠ **A BOXED MEMBER'S EDGE ALWAYS TAKES A PAD, WHETHER OR NOT IT OWES A DROP.** Its fused ordinal
	// is the tag LOADED out of the box, and on the success edge the flag is `0` — so the load has
	// exactly one place it can stand: a block only the error edge reaches. That is what the pad is.
	function tryBlockThrowEdgeTarget(ctx TryBlockContext, errArgs ValueIdArray, flag ValueId, member TryBlockErrorMember, fusedValue ValueId, anchor Token, handedOff HandedOff = HandedOff.nothing) returns BlockId
		let owesTemps = self.bodyState.pendingTempDrops.count() > WholeStatementTempFloor
		let mayOweBindings = self.bodyState.ownedBindings.count() > ctx.ownedFloor
		let leavesWindows = self.openWindowCount() > ctx.windowFloor

		if not owesTemps and not mayOweBindings and not member.isBoxed and not leavesWindows 'nothingToRelease'
			return self.routeStraightToHandler(ctx, errArgs: errArgs, flag: flag, member: member, fusedValue: fusedValue, anchor: anchor)
		end 'nothingToRelease'

		let shape = self.routedThrowShape(ctx, errArgs: errArgs)
		var route = ExitRoute.direct

		if mayOweBindings 'bindingsToRelease'
			route = self.exitRouteOf(self.releaseChain(shape, floor: ctx.ownedFloor), handedOff: handedOff, anchor: ctx.tryTok)
		end 'bindingsToRelease'

		if not owesTemps and exitRouteIsDirect(route) and not member.isBoxed and not leavesWindows 'allMoved'
			return self.routeStraightToHandler(ctx, errArgs: errArgs, flag: flag, member: member, fusedValue: fusedValue, anchor: anchor)
		end 'allMoved'

		let func = self.bodyFunction()
		let pad = self.artifact.module.addBlock(func, label: b"tryblkthrow", heat: BlockHeat.normal)

		self.emitWindowExitsInto(pad, floor: ctx.windowFloor, anchor: ctx.tryTok)

		self.emitTempDropsInto(pad, temps: self.bodyState.pendingTempDrops, anchor: ctx.tryTok)
		self.emitExitRoute(pad, route: route, shape: shape, carried: errArgs, anchor: ctx.tryTok)
		ctx.routedEdges.push(RoutedErrorEdge.create(errArgs, flag: flag, block: pad, member: member, fusedValue: fusedValue, anchor: anchor))
		return pad.id
	end 'tryBlockThrowEdgeTarget'

	function routeStraightToHandler(ctx TryBlockContext, errArgs ValueIdArray, flag ValueId, member TryBlockErrorMember, fusedValue ValueId, anchor Token) returns BlockId
		self.recordBranchEdge(self.bodyState.currentBlock, targetId: ctx.errBlockId, argIds: errArgs)
		ctx.routedEdges.push(RoutedErrorEdge.create(errArgs, flag: flag, block: self.bodyState.currentBlock, member: member, fusedValue: fusedValue, anchor: anchor))
		return ctx.errBlockId
	end 'routeStraightToHandler'

	function routedThrowShape(ctx TryBlockContext, errArgs ValueIdArray) returns ExitShape
		let errBlock = try self.blockById(self.bodyFunction(), id: ctx.errBlockId) otherwise panic("routedThrowShape: the error block {ctx.errBlockId} of '{String.from(ctx.label)}' is not in its own function")

		if errBlock.blockArgs.count() != errArgs.count() 'argsAndPhisDisagree'
			panic("routedThrowShape: a routed edge carries {errArgs.count()} values but the error block of '{String.from(ctx.label)}' holds {errBlock.blockArgs.count()} phis — the two are positional")
		end 'argsAndPhisDisagree'

		let slots = CarriedSlotArray.create(errBlock.blockArgs.count(), zeroed: false)

		for arg in errBlock.blockArgs 'eachPhi'
			slots.push(CarriedSlot.create(self.tagOf(arg.valueId), nameId: self.valueNameId(arg.valueId)))
		end 'eachPhi'

		return ExitShape.routedThrow(ctx.errBlockId, slots: slots)
	end 'routedThrowShape'

	// ⭐⭐ **THE FUSED ORDINAL THIS EDGE WILL CARRY, computed where the edge leaves from — or NOT computed at
	// all, which is the case that matters most.** Three shapes, and `RoutedErrorEdge`'s header argues each:
	//
	//   • **the FIRST member, SCALAR** — its `fusedTagOffset` IS `ErrorFlagOrdinalBias`, so `tag + bias` is
	//     already the fused ordinal and the flag serves unchanged. **Nothing is emitted.** Every block-form
	//     `try` that turns out to route ONE error type is this shape, which is how the whole error-union
	//     mechanism costs a single-member block exactly nothing.
	//   • **a LATER member, SCALAR** — `flag + (offset - bias)`, emitted here. A second member exists only in a
	//     block that IS a union, so the op is never dead.
	//   • **a BOXED member** — the tag is a LOAD, and it cannot stand on a path where the flag may be `0`.
	//     Deferred to the landing pad `tryBlockThrowEdgeTarget` forces for exactly this reason, and filled by
	//     `routedEdgeOrdinalForUnion` only if the block turns out to be a union.
	function routedEdgeFusedValue(member TryBlockErrorMember, flag ValueId, anchor Token) returns ValueId
		if member.isBoxed 'deferredToThePad'
			return flag
		end 'deferredToThePad'

		let shift = member.fusedTagOffset - ErrorFlagOrdinalBias

		if shift == 0 'theFlagIsAlreadyTheOrdinal'
			return flag
		end 'theFlagIsAlreadyTheOrdinal'

		return self.emitAddLiteral(flag, addend: shift, anchor: anchor)
	end 'routedEdgeFusedValue'

	// `subject + addend` as an integer value, through the two ops the fused-ordinal shift needs and nothing
	// else. Its two callers are the two halves of that shift (the routing-time scalar form and the pad's
	// deferred boxed form), so the addition is written once.
	function emitAddLiteral(subject ValueId, addend FullRangeInt, anchor Token) returns ValueId
		let range = SourceRange.ofToken(anchor)
		let rhs = self.emitLiteral(addend, valueType: MaxonType.integer, range: range)
		let sum = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.binOp(sum, lhs: subject, rhs: rhs, op: MaxonBinOp.add), range: range)
		return sum
	end 'emitAddLiteral'

	// Convert a routed op into the try-channel op that defines a fresh flag, through the rewrite an
	// explicit `try` uses (`rewriteToTryChannel`), so a routed op and a `try`ed one are byte-identical
	// downstream.
	//
	// It is not `rewriteLastCallToTryCall`, which finds the op an author's `try` was applied to and
	// refuses a non-routable one with a sentence. Here the emitting door has already classified the op
	// as routable, so any other kind is a broken compiler invariant — `rewriteToTryChannel`'s panic,
	// not a diagnostic.
	function rewriteRoutedOp(opIdx ElementIndex) returns ValueId
		let op = self.routableOpAt(opIdx)

		match op 'op'
			send then return self.rewriteSendToTryChannel(opIdx).1
			notRoutable or
			division or
			call or
			witness or
			await or
			tryChannelCall then break
		end 'op'

		let flag = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		_ = self.rewriteToTryChannel(opIdx, op: op, flag: flag)
		return flag
	end 'rewriteRoutedOp'

	function routeSend(destination ThrowRouteDestination, opIdx ElementIndex, result ValueId)
		let sent = recordedSendOf(self.statement.lastSend, opIdx: opIdx)
		self.routeThrowingOp(destination, opIdx: opIdx, clause: sent.throwsClause(), result: sent.resultValue(result))
	end 'routeSend'

	// ⭐ **WHAT A ROUTED EDGE TELLS THE SHARED HANDLER — which UNION MEMBER it raises, and the OWNERSHIP state
	// the handler will be entered with.** Returns the member; the caller needs it to compute the edge's fused
	// ordinal. Both routing doors (a bare throwing op, a bare `throw`) come through here, so the
	// member set
	// and the entry ownership are settled from one place whichever door produced the edge.
	//
	// The ownership half is settled by the FIRST routed edge and every later one must AGREE with it; a
	// disagreement is RECORDED — for `requireRoutableTryBlockBody` to refuse at the body's end, or as an
	// enclosing handler's E3161 — because this path cannot throw (see `routeThrowingOp`).
	function recordRoutedEdge(ctx TryBlockContext, clause ThrowsClause) returns TryBlockErrorMember
		// The outer bindings' move state ON THIS EDGE. Truncated to the block's owned floor: the body's own
		// bindings vary in number between routed calls and the landing pad releases them anyway, so only the
		// outer ones are comparable — and only they can still be owed a drop past the handler.
		let edgeMark = moveMarkPrefix(self.captureMoveMark(), height: ctx.ownedFloor)

		if not throwsClauseIsThrowing(ctx.throwsClause()) 'firstRoutedEdge'
			ctx.edgeMoveMark = edgeMark
		end 'firstRoutedEdge' else 'laterRoutedEdge'
			self.recordRoutedEdgeMoveDisagreement(ctx, edgeMark: edgeMark)
		end 'laterRoutedEdge'

		return self.recordRoutedErrorType(ctx, clause: clause)
	end 'recordRoutedEdge'

	// Compare a later routed edge's outer move state with the first edge's, which the handler is parsed in. An
	// outer binding moved between them is the body's refusal; an enclosing handler's combined error matched
	// between them is that handler's E3161, since the two edges reach this block's handler together.
	//
	// Only the `movedFrom` bits are compared: the VALUES legitimately differ between two points in one body. The
	// consumed threads need no comparison of their own — a consume a NAME can outlive also marks that name's
	// owning binding moved (`consumePromiseThread`), and a promise no binding owns has no name a later use could
	// reach it through.
	function recordRoutedEdgeMoveDisagreement(ctx TryBlockContext, edgeMark MoveMark)
		// Both marks are cut at the block's owned floor, so a height difference means the floor itself moved —
		// the same unreconcilable shape the body's refusal reports.
		if ctx.edgeMoveMark.height() != edgeMark.height() 'differentHeights'
			ctx.conflictingMoveEdge = true
			return
		end 'differentHeights'

		for i in positionsThatMayDiffer(ctx.edgeMoveMark, b: edgeMark) 'eachOuter'
			let movedOnFirst = ctx.edgeMoveMark.movedAt(i)
			let movedHere = edgeMark.movedAt(i)

			if movedOnFirst == movedHere 'agrees'
				continue
			end 'agrees'

			let owned = try self.bodyState.ownedBindings.get(i) otherwise panic("recordRoutedEdgeMoveDisagreement: ownedBindings.get OOB at {i} — the mark is cut below the live height")
			let isObligation = owned.isErrorMatchObligation
			let name = owned.name

			if isObligation 'matchedBetweenEdges'
				self.holdErrorMatchRefusal(name, reason: ErrorMatchPathsDisagreeReason, anchor: ctx.tryTok)
			end 'matchedBetweenEdges' else 'movedBetweenEdges'
				ctx.conflictingMoveEdge = true
			end 'movedBetweenEdges'
		end 'eachOuter'
	end 'recordRoutedEdgeMoveDisagreement'

	// ⭐⭐ **FIND OR ADD THIS ERROR TYPE AS A MEMBER OF THE BLOCK'S SYNTHESIZED UNION, AND FIX ITS SLICE
	// OF THE FUSED DISPATCH LINE.** Deduped by NAME, in first-routed order. Instead of carrying the
	// position on a second phi and testing a PAIR at every handler arm, each member is given
	// `fusedTagOffset`, and `<member's own case tag> + fusedTagOffset` is the ONE number an arm tests.
	//
	// ⭐⭐ **WHY THAT NUMBER IS INJECTIVE, WHICH IS THE WHOLE CORRECTNESS ARGUMENT.** Each member is handed
	// the CLOSED interval `[floor, floor + width]`, where `width` is its OWN tag range (`maxTag - minTag`)
	// and `floor` is one past the previous member's top — so the intervals are disjoint and strictly
	// ascending, and a member's own cases are distinct inside its interval because its tags are distinct
	// (E3031 refuses two cases with one raw value). Hence distinct `(member, case)` pairs have distinct fused
	// tags, for ANY tag numbering including explicit `= N` and negative raw values. **Nothing is joined and
	// no name is a key** — which is the property `/specs/try-block.md`'s
	// `union-member-names-join-injectively` was written to protect in a compiler that spells the union's
	// identity as a string (see `ErrorUnionInfo` for that comparison).
	//
	// ⚠ **THE PLACEMENT CAN FAIL, AND FAILING IS NOT A PANIC.** A FLOAT-backed error enum is legal and
	// throwable (MEASURED: `enum FErr implements Error  lo = -1.5  hi = 2.5 end` compiles and throws), and
	// `tagOfIndex` hands back the IEEE-754 BIT PATTERN — so such a member can be wider than the whole i64
	// line, and a second one placed above it would overflow `FullRangeInt`, which is a ranged type and so a
	// COMPILER PANIC rather than a wrapped number. `fusedPlacementAt` answers `tooWide` instead, and the
	// block is refused when a second member proves it really had to fuse.
	//
	// ⚠ **THE FIRST MEMBER, WHEN SCALAR, IS GIVEN EXACTLY `ErrorFlagOrdinalBias` — and that is not an
	// optimization, it is what keeps a ONE-member block byte-identical.** Such a member's flag already IS
	// `tag + bias`, so its fused ordinal is the flag and the edge emits no op at all; a block that turns out
	// to have one member therefore spends nothing on machinery it does not use.
	function recordRoutedErrorType(ctx TryBlockContext, clause ThrowsClause) returns TryBlockErrorMember
		let errorName = try throwsClauseName(clause) otherwise panic("recordRoutedErrorType: both routing doors gate on `throwsClauseIsThrowing` before reaching here")
		let name = freeze errorName.toByteArray()

		for i in 0 upto ctx.members.count() 'seen'
			let existing = try ctx.members.get(i) otherwise panic("recordRoutedErrorType: members.get OOB at {i} on a list walked to its own count")

			if existing.name.equals(name) 'sameMember'
				return existing
			end 'sameMember'
		end 'seen'

		let layout = self.requireRoutedErrorLayout(name)
		let isBoxed = layout.carriesPayloads()
		let span = enumTagSpan(layout)

		// A SCALAR member's runtime value is `tag + bias`; a BOXED member's is the tag loaded out of the box.
		// Every member but the first takes the next free slice above the member before it; the first, when it
		// is SCALAR, is pinned at exactly the bias so its fused ordinal IS the flag and its edges emit nothing.
		var placement = FusedPlacement.tooWide()

		if ctx.members.count() == 0 and not isBoxed 'firstScalarMemberIsTheFlagItself'
			placement = fusedPlacementAtTheBias(span)
		end 'firstScalarMemberIsTheFlagItself' else 'aboveWhatIsAlreadyPlaced'
			placement = fusedPlacementAt(self.nextFusedFloor(ctx), span: span)
		end 'aboveWhatIsAlreadyPlaced'

		if not placement.fusable and ctx.unfusableMember.isEmpty() 'firstMemberTheLineCannotHold'
			ctx.unfusableMember = String.from(name)
		end 'firstMemberTheLineCannotHold'

		let member = TryBlockErrorMember.create(name, clause: clause, isBoxed: isBoxed, layout: layout, placement: placement)
		ctx.members.push(member)
		return member
	end 'recordRoutedErrorType'

	// The first free position on the fused line — `0` for the first member, one past the previous member's
	// top for every later one. The `+ 1` is safe without a check because a placed top is at most
	// `FusedTagCeiling`, which is held short of `i64.max` by exactly this margin.
	function nextFusedFloor(ctx TryBlockContext) returns FullRangeInt
		if ctx.members.count() == 0 'nothingPlacedYet'
			return 0
		end 'nothingPlacedYet'

		let previous = try ctx.members.get(ctx.members.count() - 1) otherwise panic("nextFusedFloor: members.get failed on a list the line above tested is non-empty")

		if not previous.fusable 'thePreviousOneDidNotFitEither'
			return 0
		end 'thePreviousOneDidNotFitEither'

		return previous.fusedTop + 1
	end 'nextFusedFloor'

	// The declared layout of an error type a routed edge names. It is DECLARED by construction: a call routes
	// only on a `throws E` clause the signature table produced, and a `throw` only on a value whose type the
	// parser already resolved — so an undeclared name here is a compiler invariant break, not a user error
	// (E3004 reports an unknown type long before a throw can name it).
	function requireRoutedErrorLayout(name ByteArray) returns immutable EnumLayout
		match self.signatures.enumFor(name, readerFilePath: self.job.path) 'declared'
			declared(layout) then return layout
			undeclared then panic("requireRoutedErrorLayout: '{String.from(name)}' is routed as an error type but declares no enum or union — every routing door reads the name off a resolved `throws` clause or a resolved thrown value")
		end 'declared'
	end 'requireRoutedErrorLayout'

	// The MaxonType of the enum a throwing `callee` throws — the type an `(e)` binding recovers. A callee
	// with no throws clause is rejected by SemanticCheck (E3055), so the fallback `integer` here is never
	// lowered; it only keeps the parser from panicking while building IR the error gate will discard.
	// ⭐ **E3059 — PROPAGATE TYPE MISMATCH.** A bare `try …` (no `otherwise`) re-publishes the caught flag
	// VERBATIM into the ENCLOSING function's error register, so if the propagated callee throws a DIFFERENT
	// error type than the enclosing function declares, the caller decodes one enum's ordinals as another's
	// tags — a silent miscompile a boxed union turns into a wild free. Refused when the two named types differ,
	// AND when the enclosing function names none at all (see `rejectPropagateAgainstEnclosing`). Shared by
	// every try shape — a direct call, `try await p` (the awaited callee's throws type IS the promise's) and a
	// witness dispatch — because each answers `tryTargetThrows` and only the CLAUSE reaches here.
	function checkPropagateType(func IrFunction, throwsClause ThrowsClause, tryTok Token) throws SourceParseError
		match throwsClause 'calleeThrows'
			none then break
			throwing(propagated) then try self.requireErrorTypeFitsEnclosing(func, errorType: propagated, door: ErrorExitDoor.propagate, anchor: tryTok)
		end 'calleeThrows'
	end 'checkPropagateType'

	// The throw door's half of the rule above, and the same function underneath: an error leaves a
	// function by a bare `try` re-publishing a callee's flag or a `throw` publishing a fresh one, and
	// both hand the caller a flag it decodes against the enclosing function's declared clause.
	// Unguarded, this door gives:
	//
	//   • `throw <payload-carrying union>` under a scalar enum clause — the throw writes a box pointer
	//     and the catch reads an ordinal and never releases it: exit 101;
	//   • `throw ErrB.bOne` under `throws ErrA` — a silent wrong answer: the caller matches the
	//     ordinal against `ErrA`'s cases;
	//   • `throw` in a function declaring no `throws` — the flag has nowhere to be published, so the
	//     error is discarded and the throw path's `0` comes back as a real answer.
	//
	// `emitThrowError` refuses a value whose type is not `named` at all (`throw 1`) before calling
	// this: the error flag encodes an enum ordinal or a union box pointer and has no third shape.
	function requireThrownTypeFitsEnclosing(func IrFunction, errorType MaxonType, routed bool, anchor Token) throws SourceParseError
		// A routed throw owes the enclosing clause nothing: the rule is about the flag a function
		// publishes to its caller, and a throw routed to a block-form `try`'s handler branches inside
		// this frame — `main` may hold such a block while declaring no `throws`
		// (`try-block.bare-throw-in-nested-if`). The routed edge's own type agreement is
		// `recordRoutedEdge`'s.
		if routed 'toABlockHandler'
			return
		end 'toABlockHandler'

		let thrownName = try throwsClauseName(self.thrownTypeClause(errorType)) otherwise panic("requireThrownTypeFitsEnclosing: `thrownTypeClause` answered `none` for a type `emitThrowError` proved is `named` before calling this")
		try self.requireErrorTypeFitsEnclosing(func, errorType: thrownName, door: ErrorExitDoor.throwStatement, anchor: anchor)
	end 'requireThrownTypeFitsEnclosing'

	// ⭐ **THE ONE PLACE AN OUTGOING ERROR TYPE IS MEASURED AGAINST THE ENCLOSING `throws` CLAUSE.** Refuses
	// when the enclosing function declares a DIFFERENT named type than `errorType` — or NO type at all. Split
	// so the nested `match`/comparison is not an inline labelled-if in a match arm (which the parser rejects).
	//
	// ⚠ **THE `none` ARM IS A REJECT, NOT A FALLTHROUGH.** A bare `try f()` inside a function declaring no
	// `throws` has nowhere to re-publish the flag: `propagateError` writes the enclosing function's error
	// register, and a non-throwing function's caller never reads it — so the error is SILENTLY DISCARDED and
	// the callee's throw-path primary (`0`) comes back as a real answer. MEASURED both ways: `try inner(3)` in
	// a non-throwing `outer` exited 0 where the answer is the error path, and so did the witness spelling
	// (`try self.item.digest()` in a non-throwing generic method). The runnable oracle refuses both — E2001,
	// "try without otherwise requires the enclosing function to have 'throws'" — so this closes a divergence,
	// not a design question. `error-handling.md`'s own Error Propagation section already stated the rule
	// ("only valid in functions with `throws`"); the prose and the compiler had simply disagreed. It rides
	// E3059 through the existing free-form `errorTypeMismatch` arm rather than a new `SourceParseError` variant,
	// because it is the SAME fact that arm's four other messages carry: the error type does not fit where it
	// is going. A `none` enclosing clause is that mismatch at its limit — there is no there to fit into.
	// The `throw` door measured the same discard independently (see `requireThrownTypeFitsEnclosing`).
	//
	// ⚠ **`door` PICKS THE SENTENCE AND NOTHING ELSE.** The two doors are one rule and must never answer
	// differently about whether a type fits; they differ only in what the author has to be told to do about
	// it, which is why the wording — and not the comparison — is what branches.
	//
	// ⚠⚠ **AN ENCLOSING CLAUSE THAT NAMES NO DECLARED ENUM IS NOT THIS CHECK'S TO REPORT, AND SAYING SO IS
	// WHAT KEEPS THE ROOT CAUSE ON TOP.** This check compares two error TYPES; a clause naming an interface,
	// a struct or a typo denotes no type, so there is nothing here to compare against and blaming the `throw`
	// would be blaming the symptom. Worse, its remedy would be actively wrong — `throws Error` with a
	// `throw DigestError.x` inside would be told to *declare* `throws DigestError` when the clause is the
	// thing at fault. Two checks already own that clause and both outrank this one because both can name WHY
	// the clause is wrong: **E3113** (`SemanticCheck.checkThrowsClausesNameDeclaredErrors`) for
	// a function's own clause, and **E3016** (`ConformanceCheck.validateThrowsConformance`) for an impl method
	// under a requirement. Nothing escapes by deferring — both run on every program this arm declines, which is
	// exactly why the condition is "the DECODE's own registry does not declare it" (`signatures.containsEnum`,
	// the registry `throwsTypeIsBoxedUnion` resolves through) and not a hand-listed set of bad shapes.
	function requireErrorTypeFitsEnclosing(func IrFunction, errorType String, door ErrorExitDoor, anchor Token) throws SourceParseError
		match func.throwsTypeName 'enclosing'
			none then try self.refuseErrorWithNoEnclosingClause(errorType, door: door, anchor: anchor)
			throwing(enclosing) then try self.rejectIfDifferentThrows(errorType, enclosing: enclosing, door: door, anchor: anchor)
		end 'enclosing'
	end 'requireErrorTypeFitsEnclosing'

	// ⭐⭐ **THE `none` ARM'S TWO SENTENCES, AND THE DIFFERENCE BETWEEN THEM IS THE REMEDY.** The rule is one
	// rule — an error type leaving a function that declares no `throws` has nowhere to go — and the
	// comparison never branches. What branches is what the author can DO about it:
	//
	//   • in a DECLARED function, either move works: convert the error with an `otherwise`, or declare the
	//     clause. That is `noEnclosingThrowsDetail`'s sentence, on E3059, and `maxoncstderr` blocks
	//     pin it.
	//   • in a CLOSURE only the first move exists. A function type is `function(T) returns U` with no throws
	//     clause — **E3101**'s whole content — so telling the author to declare one names a program the
	//     grammar has no place for. The oracle's own sentence (E2001, measured) is the one that fits, and
	//     `test-uncaught-throw/error.closure-in-a-test-is-not-a-test` pins it byte for byte.
	//
	// ⚠ **THE CLOSURE ARM IS THE `try` DOOR'S ONLY.** A `throw` inside a closure is refused by the sentence
	// its own door has always given it: `door` picks the sentence here exactly as it does one function down.
	function refuseErrorWithNoEnclosingClause(errorType String, door ErrorExitDoor, anchor Token) throws SourceParseError
		if self.bodyState.enclosingBodyKind == EnclosingBodyKind.closureBody and door == ErrorExitDoor.propagate 'aClosureHasNoClauseToDeclare'
			throw SourceParseError.bareTryInAClosure(anchor.line, column: anchor.column)
		end 'aClosureHasNoClauseToDeclare'

		throw SourceParseError.errorTypeMismatch(noEnclosingThrowsDetail(errorType, door: door), line: anchor.line, column: anchor.column)
	end 'refuseErrorWithNoEnclosingClause'

	// The comparison itself — ONE `equals`, for both doors. The PROPAGATE mismatch keeps its dedicated
	// `propagateTypeMismatch` arm (whose sentence the corpus pins byte-for-byte); the THROW mismatch rides the
	// free-form `errorTypeMismatch` arm, exactly as the `none` sentences above do, because it is the same fact
	// on the same code (E3059): the error type does not fit where it is going.
	function rejectIfDifferentThrows(errorType String, enclosing String, door ErrorExitDoor, anchor Token) throws SourceParseError
		if errorType.equals(enclosing) 'fits'
			return
		end 'fits'

		// The enclosing clause denotes no error type — E3113 or E3016 owns this program (see the header above).
		if not self.signatures.containsEnumFor(enclosing.toByteArray(), readerFilePath: self.job.path) 'clauseIsNotAnErrorType'
			return
		end 'clauseIsNotAnErrorType'

		match door 'which'
			propagate then throw SourceParseError.propagateTypeMismatch(errorType, enclosing: enclosing, line: anchor.line, column: anchor.column)
			throwStatement then throw SourceParseError.errorTypeMismatch("throw of '{errorType}' but the enclosing function throws '{enclosing}' — the caller decodes the error flag against '{enclosing}', so one enum's ordinals would be read as another's tags, and a payload-carrying union arriving where a scalar is expected leaks its box; throw a '{enclosing}' case, or declare 'throws {errorType}'", line: anchor.line, column: anchor.column)
		end 'which'
	end 'rejectIfDifferentThrows'

	// The ERROR TYPE a `try` target throws — the second of the two questions the desugar asks its target, and
	// the one the two shapes answer differently: a NAMED callee is looked up in the whole-program signature
	// index; a WITNESS method carries its own clause, because no registry holds an interface method.
	function tryTargetThrows(target TryTarget) returns ThrowsClause
		return match target 'kind'
			named(callee) gives self.signatures.throwsOf(callee)
			witness(_, throwsClause) gives throwsClause
			promise(_, throwsClause) gives throwsClause
			send(_, throwsClause) gives throwsClause
			serviceReply(messageName, _) gives self.signatures.throwsOf(messageName)
			serviceStart(factory, _) gives self.signatures.throwsOf(factory)
			sentReply(_, _, sendErrorName) gives ThrowsClause.throwing(String.from(sendErrorName))
			deferred gives ThrowsClause.none
		end 'kind'
	end 'tryTargetThrows'

	function tryErrorEnumType(throwsClause ThrowsClause) returns MaxonType
		return match throwsClause 'k'
			none gives MaxonType.integer
			throwing(name) gives MaxonType.named(self.artifact.typeNames.intern(name.toByteArray()))
		end 'k'
	end 'tryErrorEnumType'

	// ⭐ **IS THE THROWN/CAUGHT ERROR A BOXED (payload-bearing) UNION?** — the ONE fact the error-flag
	// ABI turns on, and the derive-once point for it. Read at BOTH ends so the flag round-trips: the
	// throw ENCODE (`emitThrowError`, which stamps it on the `throwError` op for `lowerThrowError` to
	// write the box pointer verbatim) and the catch DECODE (`declareCaughtError`, which binds `e` to
	// that pointer verbatim for BOTH catching constructs). Both funnel through the one
	// `enumInAnyFile(name).carriesPayloads()` here, so a boxed union cannot be encoded as a pointer at
	// one end and decoded as an `ordinal + bias` at the other. A SCALAR enum and a non-`named` type
	// are `false` — their flag is `ordinal + ErrorFlagOrdinalBias`. An error union `implements` an
	// interface, which `unionRepresentationOf` never stores as a word, so a payload-bearing one is
	// always a box.
	function throwsTypeIsBoxedUnion(errorType MaxonType) returns bool
		if maxonTypeTag(errorType) != ValueTypeTag.named 'notNamed'
			return false
		end 'notNamed'

		let name = try self.artifact.typeNames.nameOf(typeNameIdOf(errorType)) otherwise return false
		return match self.signatures.enumFor(name, readerFilePath: self.job.path) 'e'
			declared(layout) gives layout.carriesPayloads()
			undeclared gives false
		end 'e'
	end 'throwsTypeIsBoxedUnion'

	// Emit a `__mm_decref` for every owned binding above `floor`, in REVERSE declaration order.
	//
	// The two kinds of exit that release owned bindings differ only in how far down the stack they
	// release: a FUNCTION exit (`emitFunctionExit`) drops the WHOLE in-scope list
	// (`WholeFunctionScopeFloor`), while a nested BLOCK's fall-through and a `break`/`continue` drop
	// only what the block or loop itself declared (their recorded height), here, leaving the outer
	// bindings for their own scope to release. The floor is the single fact that tells the two apart,
	// so both read their list from `scopeReleasesAbove` and the reverse order cannot drift between
	// them.
	//
	// Reverse, because that is the order ownership is conventionally released in — the last thing
	// built is the first torn down — and because a later binding may hold
	// a reference INTO an earlier one, so releasing the outer first would be releasing the thing
	// still being pointed at. The convention
	// costs nothing and is the one that stays right.
	//
	// `anchor` is the token of the statement that made control leave the scope (the `return`, the
	// block's `end`, the `break`/`continue`): no source token spawns a drop, and that statement is
	// where a reader looks for what happened to the values in it.
	//
	// ⛔⛔ **`into` IS THE BLOCK THE DECREFS LAND IN, AND IT IS NOT `self.bodyState.currentBlock`.**
	// Control leaves a scope at a block a caller KNOWS; `currentBlock` is where the parser last
	// emitted, and after a nested `if`/`while` those are different blocks. Drops sent to
	// `currentBlock` there release the locals on one path only — a leak on the other, and a double
	// free once per loop iteration (`specs/character-ownership.md`'s
	// `local-dropped-once-after-a-loop`). Every caller states the block it means.
	function emitScopeDrops(into IrBlock, floor ElementIndex, anchor Token)
		self.emitScopeReleasesInto(into, releases: self.scopeReleasesAbove(floor, anchor: anchor), anchor: anchor)
	end 'emitScopeDrops'

	function emitScopeReleasesInto(into IrBlock, releases OwnedBindingPositionArray, anchor Token)
		for position in releases 'eachRelease'
			self.emitReleaseInto(into, position: position, value: self.ownedBindingAt(position).boundValue, anchor: anchor)
		end 'eachRelease'
	end 'emitScopeReleasesInto'

	function scopeReleasesAbove(floor ElementIndex, anchor Token) returns OwnedBindingPositionArray
		let releases = OwnedBindingPositionArray.create(0)
		var i = self.bodyState.ownedBindings.count()

		while i > floor 'eachOwned'
			i = i - 1

			match releaseDispositionOf(self.ownedBindingAt(i)) 'disposition'
				release then releases.push(i)
				unmatchedObligation then self.holdErrorMatchRefusal(self.ownedBindingAt(i).name, reason: ErrorMatchLeavesUnmatchedReason, anchor: anchor)
				skip then break
			end 'disposition'
		end 'eachOwned'

		return releases
	end 'scopeReleasesAbove'

	function ownedBindingAt(position ElementIndex) returns VarInfo
		return try self.bodyState.ownedBindings.get(position) otherwise panic("ownedBindingAt: ownedBindings.get OOB at {position} — a release position is read while its binding is still enrolled")
	end 'ownedBindingAt'

	function releaseShapeAt(position ElementIndex) returns ReleaseShape
		let binding = self.ownedBindingAt(position)

		if not binding.isCellBinding 'aRecord'
			return ReleaseShape.plain
		end 'aRecord'

		return ReleaseShape.cellWithOccupant if self.cellOwnsItsOccupant(binding.varType, crossesByReference: binding.cellCrossesByReference) and not valueIsMarked(self.bodyState.borrowedScratchCells, value: binding.boundValue) else ReleaseShape.cellBox
	end 'releaseShapeAt'

	function emitScopeRelease(position ElementIndex, value ValueId, anchor Token)
		let range = SourceRange.ofToken(anchor)
		let shape = self.releaseShapeAt(position)

		if shape == ReleaseShape.plain 'aRecord'
			self.emitDecref(value, range: range, name: self.ownedBindingAt(position).name)
			return
		end 'aRecord'

		// ⭐⭐ **A CELL IS DROPPED IN TWO STEPS, BECAUSE IT OWNS TWO THINGS** — the occupant it holds
		// and the box holding it; a cell that only lends a promise (`borrowedScratchCells`) owns its box
		// alone. The occupant is LOADED rather than remembered, for
		// `reassignCellBinding`'s reason: a callee may have replaced it through the very pointer this
		// binding hands out, so the value the parser last saw is not what the cell contains. Releasing that
		// would free a record the cell no longer holds and leak the one it does.
		//
		// ⚠ Only a cell this frame OWNS reaches here: a by-reference PARAMETER's cell is the caller's and is
		// never enrolled (`bindParameters`), so `ownedBindings` holds only locals and r-value scratch cells.
		if shape == ReleaseShape.cellWithOccupant 'cellHoldsAManagedRecord'
			self.emitCellOccupantRelease(self.ownedBindingAt(position).varType, box: value, range: range)
		end 'cellHoldsAManagedRecord'

		// The BOX, freed explicitly rather than through `emitDecref` — see `allocateCell` for why the
		// tag-routed drop would run the CONTENT's destructor over a cell.
		self.emitOwnershipRuntimeCall(MmDecrefName, args: argsOf(value), range: range)
	end 'emitScopeRelease'

	function emitFunctionExit(into IrBlock, exit FunctionExit, anchor Token, handedOff HandedOff = HandedOff.nothing)
		self.bodyState.lastExitBlock = into.id
		self.emitWindowExitsInto(into, floor: 0, anchor: anchor)
		let shape = self.exitShapeOf(exit)
		var route = ExitRoute.direct

		if self.bodyState.ownedBindings.count() > WholeFunctionScopeFloor 'mayOweBindings'
			route = self.exitRouteOf(self.releaseChain(shape, floor: WholeFunctionScopeFloor), handedOff: handedOff, anchor: anchor)
		end 'mayOweBindings'

		let carried = self.exitPayloadOf(exit, shape: shape)
		self.emitExitRoute(into, route: route, shape: shape, carried: carried, anchor: anchor)
	end 'emitFunctionExit'

	// Each exit keeps its innermost release inline, under its own statement's span, so every exit
	// holds an instruction (and a line-table row) without padding: a debug-info build emits the bytes
	// a plain one does.
	function emitExitRoute(into IrBlock, route ExitRoute, shape ExitShape, carried ValueIdArray, anchor Token)
		match route 'route'
			direct then self.emitExitTail(into, shape: shape, carried: carried, range: SourceRange.ofToken(anchor))
			chained(first, entry, lanes) then self.emitReleaseAndJump(into, first: first, entry: entry, lanes: lanes, carried: carried, shape: shape, anchor: anchor)
			flagged(first, entry, lanes, skip) then self.emitSkippingJump(into, first: first, entry: entry, lanes: lanes, skip: skip, carried: carried, shape: shape, anchor: anchor)
		end 'route'
	end 'emitExitRoute'

	function emitExitTail(into IrBlock, shape ExitShape, carried ValueIdArray, range SourceRange)
		match shape 'which'
			functionExit(kind, _, _) then self.emitBodyTerminator(into, op: exitTerminatorOp(kind, carried: carried), range: range)
			routedThrow(destination, _) then self.emitChainJump(into, target: destination, edgeArgs: carried, range: range)
		end 'which'
	end 'emitExitTail'

	function emitReleaseAndJump(into IrBlock, first ElementIndex, entry BlockId, lanes ValueIdArray, carried ValueIdArray, shape ExitShape, anchor Token)
		self.emitReleaseInto(into, position: first, value: self.ownedBindingAt(first).boundValue, anchor: anchor)
		carried.append(lanes)
		self.emitExitJump(into, entry: entry, edgeArgs: carried, shape: shape, anchor: anchor)
	end 'emitReleaseAndJump'

	function emitSkippingJump(into IrBlock, first ElementIndex, entry BlockId, lanes ValueIdArray, skip ElementIndex, carried ValueIdArray, shape ExitShape, anchor Token)
		self.emitReleaseInto(into, position: first, value: self.ownedBindingAt(first).boundValue, anchor: anchor)
		carried.append(lanes)

		let previous = self.swapCurrentBlock(into)
		carried.push(self.emitLiteral(skip as FullRangeInt, valueType: MaxonType.integer, range: SourceRange.ofToken(anchor)))
		_ = self.swapCurrentBlock(previous)

		self.emitExitJump(into, entry: entry, edgeArgs: carried, shape: shape, anchor: anchor)
	end 'emitSkippingJump'

	function emitExitJump(into IrBlock, entry BlockId, edgeArgs ValueIdArray, shape ExitShape, anchor Token)
		match shape 'which'
			functionExit(kind, _, _) then self.noteFunctionExitSite(into, kind: kind, entry: entry, carried: edgeArgs)
			routedThrow then break
		end 'which'

		self.emitChainJump(into, target: entry, edgeArgs: edgeArgs, range: SourceRange.ofToken(anchor))
	end 'emitExitJump'

	function noteFunctionExitSite(block IrBlock, kind ExitKind, entry BlockId, carried ValueIdArray)
		self.markExitSite(block)

		if kind != ExitKind.returnVoid 'carriesAValue'
			self.joinExitCapability(entry, carried: carried)
		end 'carriesAValue'
	end 'noteFunctionExitSite'

	function joinExitCapability(entry BlockId, carried ValueIdArray)
		let phi = self.exitChainPhi(entry)
		let carriedValue = try carried.get(0) otherwise panic("joinExitCapability: a value exit carries no value")
		let incoming = self.capabilityOfValue(carriedValue)

		if not valueIdArrayContains(self.bodyState.seededExitPhis, value: phi) 'firstEdge'
			self.bodyState.seededExitPhis.push(phi)
			self.setValueCapability(phi, capability: incoming)
			return
		end 'firstEdge'

		if incoming != self.capabilityOfValue(phi) 'edgesDisagree'
			self.setValueCapability(phi, capability: ValueCapability.mutable)
		end 'edgesDisagree'
	end 'joinExitCapability'

	function exitChainPhi(entry BlockId) returns ValueId
		let block = try self.blockById(self.bodyFunction(), id: entry) otherwise panic("exitChainPhi: the exit chain entry {entry} is not in the function")
		let phiArg = try block.blockArgs.get(0) otherwise panic("exitChainPhi: the exit chain entry {entry} of a value exit has no carried phi")

		return phiArg.valueId
	end 'exitChainPhi'

	function markExitSite(block IrBlock)
		let exitSite = block
		exitSite.role = BlockRole.exitSite
	end 'markExitSite'

	function emitChainJump(block IrBlock, target BlockId, edgeArgs ValueIdArray, range SourceRange)
		self.recordBranchEdge(block, targetId: target, argIds: edgeArgs)
		self.emitBodyTerminator(block, op: MaxonOp.branch(target), range: range)
	end 'emitChainJump'

	function swapCurrentBlock(block IrBlock) returns IrBlock
		let previous = self.bodyState.currentBlock
		self.bodyState.currentBlock = block
		return previous
	end 'swapCurrentBlock'

	// `currentBlock` is restored because a routed call's caller emits its `condBranch` into the block
	// it stood in; left pointing here, that branch would terminate this block instead.
	function emitReleaseInto(block IrBlock, position ElementIndex, value ValueId, anchor Token)
		let previous = self.swapCurrentBlock(block)
		self.emitScopeRelease(position, value: value, anchor: anchor)
		_ = self.swapCurrentBlock(previous)
	end 'emitReleaseInto'

	// A closed loop's context is never asked for again, and every exit scans and validates the whole
	// chain list, so keeping its chains would make each later exit pay for every loop before it.
	function discardLoopReleaseChains(context BlockId)
		match self.bodyState.dropCascade 'state'
			built(cascade) then cascade.discardContext(context)
			unbuilt then break
		end 'state'
	end 'discardLoopReleaseChains'

	// For `discardLoopReleaseChains`' reason: nothing routes to a closed `try`'s handler again.
	function discardRoutedReleaseChains(destination BlockId)
		match self.bodyState.dropCascade 'state'
			built(cascade) then cascade.discardRoutedTo(destination)
			unbuilt then break
		end 'state'
	end 'discardRoutedReleaseChains'

	function releaseChain(shape ExitShape, floor ElementIndex) returns ReleaseChain
		let cascade = self.dropCascade()
		let context = self.dropCascadeContext()

		for chain in cascade.chains 'eachChain'
			if chain.matches(shape, wantedContext: context, wantedFloor: floor) 'thisChain'
				return chain
			end 'thisChain'
		end 'eachChain'

		let fresh = ReleaseChain.create(shape, context: context, floor: floor)
		cascade.chains.push(fresh)
		return fresh
	end 'releaseChain'

	// A chain caches each position's release disposition, and a move-state write changes it: a stale
	// one drops a moved-out value twice or leaks a revived one. Only the positions written since the
	// last exit are rechecked, and ranks below the lowest one that changed stay built.
	function validateReleaseChains(cascade DropCascade)
		let top = self.bodyState.ownedBindings.count()
		let dirty = self.bodyState.moveLedger.takeChainDirtyPositions(top)

		if dirty.isEmpty() 'nothingWritten'
			return
		end 'nothingWritten'

		for chain in cascade.chains 'eachChain'
			chain.invalidateFrom(top)

			for position in dirty 'eachDirtyPosition'
				self.revalidatePosition(chain, position: position)
			end 'eachDirtyPosition'
		end 'eachChain'
	end 'validateReleaseChains'

	function revalidatePosition(chain ReleaseChain, position ElementIndex)
		if position < chain.floor or position >= chain.scannedHeight() 'outsideTheScan'
			return
		end 'outsideTheScan'

		let binding = self.ownedBindingAt(position)
		let disposition = releaseDispositionOf(binding)

		if not chain.holdsBindingAt(position, binding: binding) or disposition != chain.dispositionAt(position) 'aDifferentRelease'
			chain.invalidateFrom(position)
			return
		end 'aDifferentRelease'

		if disposition != ReleaseDisposition.release or binding.boundValue == chain.valueAt(position) 'valueUnchanged'
			return
		end 'valueUnchanged'

		self.revalidateChangedValue(chain, position: position, binding: binding)
	end 'revalidatePosition'

	function revalidateChangedValue(chain ReleaseChain, position ElementIndex, binding VarInfo)
		let rank = chain.rankOfPosition(position)
		let current = binding.boundValue

		if chain.entryCount() < rank and chain.skipEntryCount() < rank 'nothingBuiltThere'
			chain.noteValueAt(position, value: current)
			return
		end 'nothingBuiltThere'

		if chain.isLaneRank(rank) and self.valueDropsThroughAPhi(current) 'stillALane'
			chain.noteValueAt(position, value: current)
			return
		end 'stillALane'

		if chain.isLaneRank(rank) 'noLongerALane'
			chain.unmarkLane(binding)
		end 'noLongerALane' else if chain.hasRoomForLane() and self.bindingMayBecomeALane(binding) 'newLane'
			chain.markLane(binding)
		end 'newLane'

		chain.invalidateFrom(position)
	end 'revalidateChangedValue'

	function bindingMayBecomeALane(binding VarInfo) returns bool
		if not self.bodyState.loopScans.isEmpty() or binding.isCellBinding 'laneUnsafe'
			return false
		end 'laneUnsafe'

		return self.valueDropsThroughAPhi(binding.boundValue)
	end 'bindingMayBecomeALane'

	function valueDropsThroughAPhi(value ValueId) returns bool
		let tag = self.tagOf(value)

		if tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.typeParameter or self.valueOwnsGreenThread(value) or self.valueIsImmortalFunction(value) 'aSpecialDrop'
			return false
		end 'aSpecialDrop'

		if valueIsMarked(self.bodyState.recordsOwningOpaqueSlots, value: value) or valueIsMarked(self.bodyState.witnessCursorElements, value: value) 'aMarkedRecord'
			return false
		end 'aMarkedRecord'

		return match self.holdKindOf(value) 'hold'
			found gives false
			none gives true
		end 'hold'
	end 'valueDropsThroughAPhi'

	function syncReleaseChain(chain ReleaseChain)
		self.validateReleaseChains(self.dropCascade())
		let top = self.bodyState.ownedBindings.count()

		if top < chain.floor 'belowItsFloor'
			panic("syncReleaseChain: {top} owned bindings are below the chain's floor {chain.floor}, which a scope drains only after its exits")
		end 'belowItsFloor'

		chain.invalidateFrom(top)
		self.dropStaleLaneBindings(chain, top: top)
		self.dropDisqualifiedLanes(chain)

		for position in chain.scannedHeight() upto top 'eachNewBinding'
			let binding = self.ownedBindingAt(position)

			if chain.carriesLaneBinding(binding) and not self.bindingMayBecomeALane(binding) 'noLongerQualifies'
				chain.unmarkLane(binding)
			end 'noLongerQualifies'

			chain.noteScanned(position, binding: binding, disposition: releaseDispositionOf(binding))
		end 'eachNewBinding'
	end 'syncReleaseChain'

	function dropStaleLaneBindings(chain ReleaseChain, top ElementIndex)
		var index = chain.laneBindingCount()

		while index > 0 'eachLaneBinding'
			index = index - 1
			let held = chain.laneBindingAt(index)

			if not held.isEnrolled or held.enrolledAt >= top or not (self.ownedBindingAt(held.enrolledAt) is held) 'noLongerInScope'
				chain.unmarkLane(held)
			end 'noLongerInScope'
		end 'eachLaneBinding'
	end 'dropStaleLaneBindings'

	function dropDisqualifiedLanes(chain ReleaseChain)
		var index = chain.laneCount()

		while index > 0 'eachLane'
			index = index - 1
			let position = chain.positionOfRank(chain.laneRankAt(index))
			let binding = self.ownedBindingAt(position)

			if not self.bindingMayBecomeALane(binding) 'noLongerQualifies'
				chain.unmarkLane(binding)
				chain.invalidateFrom(position)
			end 'noLongerQualifies'
		end 'eachLane'
	end 'dropDisqualifiedLanes'

	function refuseUnmatchedObligations(chain ReleaseChain, handedOff HandedOff, anchor Token)
		var index = chain.unmatchedCount()

		while index > 0 'eachObligation'
			index = index - 1
			let obligation = chain.unmatchedAt(index)

			if handedOffHolds(handedOff, candidate: obligation.flag) 'inFlight'
				continue
			end 'inFlight'

			self.holdErrorMatchRefusal(obligation.name, reason: ErrorMatchLeavesUnmatchedReason, anchor: anchor)
		end 'eachObligation'
	end 'refuseUnmatchedObligations'

	function excludedRankOf(chain ReleaseChain, handedOff HandedOff) returns ElementIndex throws AbsentError
		let held = try handedOffValue(handedOff)
		let position = try self.liveOwnerIndexOf(held) otherwise throw AbsentError.absent

		if position < chain.floor 'belowTheScope'
			throw AbsentError.absent
		end 'belowTheScope'

		return chain.rankOfPosition(position)
	end 'excludedRankOf'

	function exitShapeOf(exit FunctionExit) returns ExitShape
		let kind = exitKindOf(exit)
		let value = try exitValueOf(exit) otherwise return ExitShape.functionExit(kind, tag: ValueTypeTag.void, nameId: UnnamedTypeId)
		return ExitShape.functionExit(kind, tag: self.tagOf(value), nameId: self.valueNameId(value))
	end 'exitShapeOf'

	function exitPayloadOf(exit FunctionExit, shape ExitShape) returns ValueIdArray
		let value = try exitValueOf(exit) otherwise return ValueIdArray.create(0)

		if exitShapeCarriesAWitness(shape) 'anExistential'
			return twoArgs(value, second: self.witnessOfValue(value))
		end 'anExistential'

		return argsOf(value)
	end 'exitPayloadOf'

	function dropCascade() returns DropCascade
		match self.bodyState.dropCascade 'state'
			built(cascade) then return cascade
			unbuilt then break
		end 'state'

		let cascade = DropCascade.create()
		self.bodyState.dropCascade = DropCascadeState.built(cascade)
		return cascade
	end 'dropCascade'

	// A node is shared only within one innermost loop: header withdrawal (`withdrawOpsDefining`, from
	// the loop's `blockFloor`) edits the drops inside a loop's block range after the loop is parsed.
	function dropCascadeContext() returns BlockId
		if self.bodyState.loopScans.isEmpty() 'outsideEveryLoop'
			return FunctionEntryBlockId
		end 'outsideEveryLoop'

		return self.innermostLoopScan().blockFloor
	end 'dropCascadeContext'

	function exitRouteOf(chain ReleaseChain, handedOff HandedOff, anchor Token) returns ExitRoute
		self.syncReleaseChain(chain)
		self.refuseUnmatchedObligations(chain, handedOff: handedOff, anchor: anchor)

		if let rank = try self.excludedRankOf(chain, handedOff: handedOff) 'aBindingInFlight'
			return self.routeExcluding(chain, rank: rank, anchor: anchor)
		end 'aBindingInFlight'

		return self.routeAll(chain, anchor: anchor)
	end 'exitRouteOf'

	function routeAll(chain ReleaseChain, anchor Token) returns ExitRoute
		let count = chain.releasableCount()

		if count == 0 'nothingToRelease'
			return ExitRoute.direct
		end 'nothingToRelease'

		return ExitRoute.chained(chain.positionOfRank(count), entry: self.chainEntry(chain, rank: count - 1, anchor: anchor), lanes: self.laneValuesThrough(chain, rank: count - 1))
	end 'routeAll'

	function routeExcluding(chain ReleaseChain, rank ElementIndex, anchor Token) returns ExitRoute
		let count = chain.releasableCount()
		let above = count - rank

		if above == 0 'theInnermostIsInFlight'
			if rank == 1 'nothingElseToRelease'
				return ExitRoute.direct
			end 'nothingElseToRelease'

			return ExitRoute.chained(chain.positionOfRank(rank - 1), entry: self.chainEntry(chain, rank: rank - 2, anchor: anchor), lanes: self.laneValuesThrough(chain, rank: rank - 2))
		end 'theInnermostIsInFlight'

		let first = chain.positionOfRank(count)

		if above > ExplicitExclusionDepth or chain.laneCount() > 0 'sharedSkipChain'
			return ExitRoute.flagged(first, entry: self.skipChainEntry(chain, rank: count - 1, anchor: anchor), lanes: self.laneValuesThrough(chain, rank: count - 1), skip: rank)
		end 'sharedSkipChain'

		return ExitRoute.chained(first, entry: self.exclusionSegmentEntry(chain, excludedRank: rank, anchor: anchor), lanes: ValueIdArray.create(0))
	end 'routeExcluding'

	function laneSlotsThrough(chain ReleaseChain, rank ElementIndex) returns CarriedSlotArray
		let slots = CarriedSlotArray.create(0)

		for index in 0 upto chain.laneCount() 'eachLane'
			let laneRank = chain.laneRankAt(index)

			if laneRank <= rank 'atOrBelow'
				let current = self.ownedBindingAt(chain.positionOfRank(laneRank)).boundValue
				slots.push(CarriedSlot.create(self.tagOf(current), nameId: self.valueNameId(current)))
			end 'atOrBelow'
		end 'eachLane'

		return slots
	end 'laneSlotsThrough'

	function laneValuesThrough(chain ReleaseChain, rank ElementIndex) returns ValueIdArray
		let values = ValueIdArray.create(0)

		for index in 0 upto chain.laneCount() 'eachLane'
			let laneRank = chain.laneRankAt(index)

			if laneRank <= rank 'atOrBelow'
				values.push(self.ownedBindingAt(chain.positionOfRank(laneRank)).boundValue)
			end 'atOrBelow'
		end 'eachLane'

		return values
	end 'laneValuesThrough'

	function chainBase(shape ExitShape, anchor Token) returns BlockId
		match shape 'which'
			functionExit then return self.dropCascadeTerminal(self.dropCascade(), shape: shape, anchor: anchor)
			routedThrow(destination, _) then return destination
		end 'which'
	end 'chainBase'

	function ensureEntries(chain ReleaseChain, through ElementIndex, anchor Token)
		let built = chain.entryCount()

		if built < through 'nodesToBuild'
			self.extendEntries(chain, built: built, through: through, anchor: anchor)
		end 'nodesToBuild'
	end 'ensureEntries'

	function chainEntry(chain ReleaseChain, rank ElementIndex, anchor Token) returns BlockId
		if rank == 0 'theBase'
			return self.chainBase(chain.shape, anchor: anchor)
		end 'theBase'

		self.ensureEntries(chain, through: rank, anchor: anchor)
		return chain.entryAt(rank)
	end 'chainEntry'

	function extendEntries(chain ReleaseChain, built ElementIndex, through ElementIndex, anchor Token)
		let below = self.chainEntry(chain, rank: built, anchor: anchor)
		let ranks = ReleasableRankColumn.create(through - built, zeroed: false)
		var next = through

		while next > built 'eachNewRank'
			ranks.push(next)
			next = next - 1
		end 'eachNewRank'

		let nodes = self.materializeNodes(chain, ranks: ranks, below: below, anchor: anchor)
		var position = nodes.count()

		while position > 0 'eachNodeInRankOrder'
			position = position - 1
			chain.noteEntry(try nodes.get(position) otherwise panic("extendEntries: nodes.get OOB at {position} below the count just read"))
		end 'eachNodeInRankOrder'
	end 'extendEntries'

	function exclusionSegmentEntry(chain ReleaseChain, excludedRank ElementIndex, anchor Token) returns BlockId
		let below = self.chainEntry(chain, rank: excludedRank - 1, anchor: anchor)
		let ranks = ReleasableRankColumn.create(0)
		var rank = chain.releasableCount() - 1

		while rank > excludedRank 'eachRankAbove'
			ranks.push(rank)
			rank = rank - 1
		end 'eachRankAbove'

		if ranks.isEmpty() 'nothingAboveTheInlineRelease'
			return below
		end 'nothingAboveTheInlineRelease'

		return try self.materializeNodes(chain, ranks: ranks, below: below, anchor: anchor).get(0) otherwise panic("exclusionSegmentEntry: a segment with ranks to release built no node")
	end 'exclusionSegmentEntry'

	// Nodes and terminals carry the span of the exit that created them, and an exit sharing them later
	// leaves it. A chain's debug span is chosen apart from it, in `LowerMaxonToStd`.
	function materializeNodes(chain ReleaseChain, ranks ReleasableRankColumn, below BlockId, anchor Token) returns BlockIdArray
		let cascade = self.dropCascade()
		let hits = BlockIdArray.create(0)
		var successor = below
		var pending = ranks.count()

		while pending > 0 'sharedSuffix'
			let rank = try ranks.get(pending - 1) otherwise panic("materializeNodes: ranks.get OOB at {pending - 1} below its own count")
			successor = try cascade.nodeFor(self.nodeKeyOf(chain, rank: rank, role: ChainNodeRole.drop), exitShape: chain.shape, context: chain.context, successor: successor, alternate: successor) otherwise break
			hits.push(successor)
			pending = pending - 1
		end 'sharedSuffix'

		let func = self.bodyFunction()
		let fresh = IrBlockArray.create(pending, zeroed: false)

		for _ in 0 upto pending 'eachNewNode'
			fresh.push(self.artifact.module.addBlock(func, label: DropCascadeNodeLabel, heat: BlockHeat.normal, role: BlockRole.exitChain))
		end 'eachNewNode'

		for index in 0 upto pending 'eachNewNodeInExecutionOrder'
			let block = try fresh.get(index) otherwise panic("materializeNodes: fresh.get OOB at {index} below its own count")
			var nextId = successor

			if index + 1 < pending 'anotherNewNodeFollows'
				nextId = (try fresh.get(index + 1) otherwise panic("materializeNodes: fresh.get OOB at {index + 1} below its own count")).id
			end 'anotherNewNodeFollows'

			self.emitDropNode(block, chain: chain, rank: try ranks.get(index) otherwise panic("materializeNodes: ranks.get OOB at {index} below its own count"), successor: nextId, cascade: cascade, anchor: anchor)
		end 'eachNewNodeInExecutionOrder'

		let nodes = BlockIdArray.create(fresh.count() + hits.count(), zeroed: false)

		for block in fresh 'eachFresh'
			nodes.push(block.id)
		end 'eachFresh'

		var hit = hits.count()

		while hit > 0 'eachSharedNode'
			hit = hit - 1
			nodes.push(try hits.get(hit) otherwise panic("materializeNodes: hits.get OOB at {hit} below the count just read"))
		end 'eachSharedNode'

		return nodes
	end 'materializeNodes'

	function skipChainEntry(chain ReleaseChain, rank ElementIndex, anchor Token) returns BlockId
		let built = chain.skipEntryCount()

		if built < rank 'ranksToBuild'
			self.extendSkipEntries(chain, built: built, through: rank, anchor: anchor)
		end 'ranksToBuild'

		return chain.skipEntryAt(rank)
	end 'skipChainEntry'

	function skipBelowOf(chain ReleaseChain, rank ElementIndex, anchor Token) returns BlockId
		if rank == 1 'theBase'
			return self.chainBase(chain.shape, anchor: anchor)
		end 'theBase'

		return chain.skipEntryAt(rank - 1)
	end 'skipBelowOf'

	function extendSkipEntries(chain ReleaseChain, built ElementIndex, through ElementIndex, anchor Token)
		self.ensureEntries(chain, through: through - 1, anchor: anchor)

		let cascade = self.dropCascade()
		var next = built + 1

		while next <= through 'sharedSuffix'
			let plainBelow = self.chainEntry(chain, rank: next - 1, anchor: anchor)
			let hit = try cascade.nodeFor(self.nodeKeyOf(chain, rank: next, role: ChainNodeRole.skipTest), exitShape: chain.shape, context: chain.context, successor: self.skipBelowOf(chain, rank: next, anchor: anchor), alternate: plainBelow) otherwise break
			chain.noteSkipEntry(hit)
			next = next + 1
		end 'sharedSuffix'

		if next > through 'allShared'
			return
		end 'allShared'

		let func = self.bodyFunction()
		let tests = IrBlockArray.create(through - next + 1, zeroed: false)
		let drops = IrBlockArray.create(through - next + 1, zeroed: false)

		for _ in next to through 'eachNewRankInExecutionOrder'
			tests.push(self.artifact.module.addBlock(func, label: SkipTestNodeLabel, heat: BlockHeat.normal, role: BlockRole.exitChain))
			drops.push(self.artifact.module.addBlock(func, label: DropCascadeNodeLabel, heat: BlockHeat.normal, role: BlockRole.exitChain))
		end 'eachNewRankInExecutionOrder'

		for rank in next to through 'eachNewRankBottomUp'
			let index = through - rank
			let test = try tests.get(index) otherwise panic("extendSkipEntries: tests.get OOB at {index} below the count just built")
			let drop = try drops.get(index) otherwise panic("extendSkipEntries: drops.get OOB at {index} below the count just built")
			self.emitSkipNode(chain, rank: rank, test: test, drop: drop, cascade: cascade, anchor: anchor)
		end 'eachNewRankBottomUp'
	end 'extendSkipEntries'

	function emitSkipNode(chain ReleaseChain, rank ElementIndex, test IrBlock, drop IrBlock, cascade DropCascade, anchor Token)
		let range = SourceRange.ofToken(anchor)
		let plainBelow = self.chainEntry(chain, rank: rank - 1, anchor: anchor)
		let skipBelow = self.skipBelowOf(chain, rank: rank, anchor: anchor)
		let testCarried = self.mintExitPhis(test, shape: chain.shape)
		let testLanes = self.mintLanePhis(test, chain: chain, through: rank)
		let testSkip = self.mintPhi(test, tag: ValueTypeTag.integer, nameId: UnnamedTypeId)
		let previous = self.swapCurrentBlock(test)
		let isSkipped = self.emitCompareAgainstLiteral(testSkip, literal: rank as FullRangeInt, op: MaxonCmpOp.eq, opTok: anchor)
		_ = self.swapCurrentBlock(previous)

		let dropCarried = self.mintExitPhis(drop, shape: chain.shape)
		let dropLanes = self.mintLanePhis(drop, chain: chain, through: rank)
		let dropSkip = self.mintPhi(drop, tag: ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitChainRelease(drop, chain: chain, rank: rank, lanes: dropLanes, anchor: anchor)

		let onwardLanes = dropLanes.count() - 1 if chain.isLaneRank(rank) else dropLanes.count()
		let afterDrop = chainEdgeArgs(dropCarried, lanes: dropLanes, count: onwardLanes)

		if rank > 1 'moreBelow'
			afterDrop.push(dropSkip)
		end 'moreBelow'

		self.emitChainJump(drop, target: skipBelow if rank > 1 else plainBelow, edgeArgs: afterDrop, range: range)

		let toPlain = chainEdgeArgs(testCarried, lanes: testLanes, count: onwardLanes)
		let toDrop = chainEdgeArgs(testCarried, lanes: testLanes, count: testLanes.count())
		toDrop.push(testSkip)
		self.recordBranchEdge(test, targetId: plainBelow, argIds: toPlain)
		self.recordBranchEdge(test, targetId: drop.id, argIds: toDrop)
		self.emitCondBranch(test, cond: isSkipped, thenId: plainBelow, elseId: drop.id, ifTok: anchor)
		chain.noteSkipEntry(test.id)
		cascade.noteNode(self.nodeKeyOf(chain, rank: rank, role: ChainNodeRole.skipTest), exitShape: chain.shape, context: chain.context, successor: skipBelow, alternate: plainBelow, blockId: test.id)

		let testEdges = ValueIdArrayColumn.create(2, zeroed: false)
		testEdges.push(toPlain)
		testEdges.push(toDrop)
		self.noteRoutedBlock(cascade, shape: chain.shape, block: test, edges: testEdges)

		let dropEdges = ValueIdArrayColumn.create(1, zeroed: false)
		dropEdges.push(afterDrop)
		self.noteRoutedBlock(cascade, shape: chain.shape, block: drop, edges: dropEdges)
	end 'emitSkipNode'

	function noteRoutedBlock(cascade DropCascade, shape ExitShape, block IrBlock, edges ValueIdArrayColumn)
		match shape 'which'
			functionExit then break
			routedThrow(destination, _) then cascade.noteRoutedNode(destination, node: RoutedNode.create(block, outgoing: edges))
		end 'which'
	end 'noteRoutedBlock'

	function mintLanePhis(block IrBlock, chain ReleaseChain, through ElementIndex) returns ValueIdArray
		let slots = self.laneSlotsThrough(chain, rank: through)
		let phis = ValueIdArray.create(slots.count(), zeroed: false)

		for slot in slots 'eachLane'
			phis.push(self.mintPhi(block, tag: slot.tag, nameId: slot.nameId))
		end 'eachLane'

		return phis
	end 'mintLanePhis'

	function emitChainRelease(block IrBlock, chain ReleaseChain, rank ElementIndex, lanes ValueIdArray, anchor Token)
		let position = chain.positionOfRank(rank)

		if chain.isLaneRank(rank) 'dropsItsLane'
			self.emitReleaseInto(block, position: position, value: try lanes.last() otherwise panic("emitChainRelease: rank {rank} is a lane yet the block minted none"), anchor: anchor)
			return
		end 'dropsItsLane'

		self.emitReleaseInto(block, position: position, value: self.ownedBindingAt(position).boundValue, anchor: anchor)
	end 'emitChainRelease'

	function nodeKeyOf(chain ReleaseChain, rank ElementIndex, role ChainNodeRole) returns DropNodeKey
		let lanes = self.laneSlotsThrough(chain, rank: rank)

		if chain.isLaneRank(rank) 'dropsItsLane'
			return DropNodeKey.laneValue(role, lanes: lanes)
		end 'dropsItsLane'

		let position = chain.positionOfRank(rank)
		let released = self.ownedBindingAt(position).boundValue
		return DropNodeKey.bakedValue(released, releaseShape: self.releaseShapeAt(position), role: role, lanes: lanes)
	end 'nodeKeyOf'

	function dropCascadeTerminal(cascade DropCascade, shape ExitShape, anchor Token) returns BlockId
		if let existing = try cascade.terminalFor(shape) 'alreadyBuilt'
			return existing
		end 'alreadyBuilt'

		let kind = try functionExitKind(shape) otherwise panic("dropCascadeTerminal: a routed throw ends at its handler and has no terminal block")
		let block = self.artifact.module.addBlock(self.bodyFunction(), label: ExitTerminalLabel, heat: BlockHeat.normal, role: BlockRole.exitChain)
		let carried = self.mintExitPhis(block, shape: shape)
		self.emitBodyTerminator(block, op: exitTerminatorOp(kind, carried: carried), range: SourceRange.ofToken(anchor))
		cascade.noteTerminal(shape, blockId: block.id)
		return block.id
	end 'dropCascadeTerminal'

	function emitDropNode(block IrBlock, chain ReleaseChain, rank ElementIndex, successor BlockId, cascade DropCascade, anchor Token)
		let carried = self.mintExitPhis(block, shape: chain.shape)
		let lanes = self.mintLanePhis(block, chain: chain, through: rank)
		self.emitChainRelease(block, chain: chain, rank: rank, lanes: lanes, anchor: anchor)

		let onwardLanes = lanes.count() - 1 if chain.isLaneRank(rank) else lanes.count()
		let onward = chainEdgeArgs(carried, lanes: lanes, count: onwardLanes)
		self.emitChainJump(block, target: successor, edgeArgs: onward, range: SourceRange.ofToken(anchor))
		cascade.noteNode(self.nodeKeyOf(chain, rank: rank, role: ChainNodeRole.drop), exitShape: chain.shape, context: chain.context, successor: successor, alternate: successor, blockId: block.id)

		let edges = ValueIdArrayColumn.create(1, zeroed: false)
		edges.push(onward)
		self.noteRoutedBlock(cascade, shape: chain.shape, block: block, edges: edges)
	end 'emitDropNode'

	function mintSlotPhis(block IrBlock, slots CarriedSlotArray, into ValueIdArray)
		var position = 0 as ElementIndex

		while position < slots.count() 'eachSlot'
			let slot = try slots.get(position) otherwise panic("mintSlotPhis: slots.get OOB at {position} below the count just read")
			let phi = self.mintPhi(block, tag: slot.tag, nameId: slot.nameId)
			into.push(phi)
			position = position + 1

			if slot.tag == ValueTypeTag.interfaceRef 'itsWitnessFollows'
				let witnessSlot = try slots.get(position) otherwise panic("mintSlotPhis: an interface slot at {position - 1} is not followed by its witness slot")
				let witness = self.mintPhi(block, tag: witnessSlot.tag, nameId: witnessSlot.nameId)
				self.pairInterfaceWitness(phi, witness: witness)
				into.push(witness)
				position = position + 1
			end 'itsWitnessFollows'
		end 'eachSlot'
	end 'mintSlotPhis'

	function mintFunctionExitPhis(block IrBlock, kind ExitKind, tag ValueTypeTag, nameId TypeNameId, into ValueIdArray)
		if kind == ExitKind.returnVoid 'nothingCarried'
			return
		end 'nothingCarried'

		let carried = self.mintPhi(block, tag: tag, nameId: nameId)
		into.push(carried)

		if tag == ValueTypeTag.interfaceRef 'anExistential'
			let witness = self.mintPhi(block, tag: ValueTypeTag.integer, nameId: UnnamedTypeId)
			self.pairInterfaceWitness(carried, witness: witness)
			into.push(witness)
		end 'anExistential'
	end 'mintFunctionExitPhis'

	function mintExitPhis(block IrBlock, shape ExitShape) returns ValueIdArray
		let phis = ValueIdArray.create(0)

		match shape 'which'
			functionExit(kind, tag, nameId) then self.mintFunctionExitPhis(block, kind: kind, tag: tag, nameId: nameId, into: phis)
			routedThrow(_, slots) then self.mintSlotPhis(block, slots: slots, into: phis)
		end 'which'

		return phis
	end 'mintExitPhis'

	// Emit a single drop — the one shape a dropped owned heap value releases through, shared by every drop
	// site: `emitScopeDrops` (a binding at scope exit), `drainPendingTemps` (an unconsumed temporary at
	// statement end), and `emitStringInterp` (its consumed scratch buffers). One door, so the drop's op
	// shape lives in ONE place and cannot drift across the callers. The result is `void` because a decref
	// returns nothing — the tag `ValueTypeTag.void` exists for exactly this, a ValueId the op shape demands
	// and no rule may ever be asked about.
	//
	// ⭐ **THE DROP DISPATCH, DONE STATICALLY** — the parser knows the type at every drop, so there is no
	// stored destructor pointer and no `callIndirect` (`StringRuntime.buildStrDecref` has the full why).
	// ⭐ **AND THE ONE DROP THAT IS *NOT* STATIC.** An owned existential's
	// conformer is a run-time fact, so its release takes the witness as a SECOND argument and reads
	// `destroyFunc@8` out of the table — the only drop in the parser whose callee cannot be chosen from the
	// value's type alone. It is a separate emit rather than a widened `decrefCalleeFor` because that router
	// answers a NAME and this needs an argument list; `decrefCalleeFor`'s own `interfaceRef` guard says so
	// from the other side.
	function emitDecref(value ValueId, range SourceRange, name immutable ByteArray = EmptySourceText)
		let firstOp = self.artifact.module.ops.count()
		self.emitDecrefOps(value, range: range)
		self.noteDroppedPromise(value, firstOp: firstOp, name: name)
		self.noteDroppedLinear(value, firstOp: firstOp, name: name)

		if self.anyLoopTracksDrop(value) 'aLoopMayWithdrawIt'
			self.noteHeaderDrop(value, results: self.opResultsSince(firstOp))
		end 'aLoopMayWithdrawIt'
	end 'emitDecref'

	function noteDiscardedReply(value ValueId, opFloor ElementIndex)
		if not self.valueOwnsGreenThread(value) 'notAPromise'
			return
		end 'notAPromise'

		let opIdx = try firstOpDefiningSince(self.artifact.module, value: value, floor: opFloor) otherwise return
		try requireServiceReplyCell(try self.artifact.module.ops.get(opIdx) otherwise panic("noteDiscardedReply: ops.get OOB at {opIdx}")) otherwise return
		self.bodyState.discardedReplies.push(value)
	end 'noteDiscardedReply'

	function noteDroppedPromise(value ValueId, firstOp ElementIndex, name immutable ByteArray)
		if not self.valueOwnsGreenThread(value) or valueIdArrayContains(self.bodyState.discardedReplies, value: value) 'notAPromiseToAccountFor'
			return
		end 'notAPromiseToAccountFor'

		for opIdx in firstOp upto self.artifact.module.ops.count() 'eachNewOp'
			let emitted = try self.artifact.module.ops.get(opIdx) otherwise panic("noteDroppedPromise: ops.get OOB at {opIdx} below the count just read")

			if (try directCalleeOf(emitted) otherwise EmptySourceText).equals(GtPromiseDropName) 'theDrop'
				self.noteDroppedOwned(DroppedOwnedKind.promise, op: opIdx, name: name)
			end 'theDrop'
		end 'eachNewOp'
	end 'noteDroppedPromise'

	function anyLoopTracksDrop(value ValueId) returns bool
		for scan in self.bodyState.loopScans 'eachLoop'
			if scan.tracksValue(value, mergedBindingValues: self.bodyState.mergedBindingValues) 'tracked'
				return true
			end 'tracked'
		end 'eachLoop'

		return false
	end 'anyLoopTracksDrop'

	function noteHeaderDrop(value ValueId, results ValueIdArray)
		for scan in self.bodyState.loopScans 'eachLoop'
			if scan.tracksValue(value, mergedBindingValues: self.bodyState.mergedBindingValues) 'dropsAHeaderValue'
				scan.headerDrops.push(HeaderDrop.create(value, results: results))
			end 'dropsAHeaderValue'
		end 'eachLoop'
	end 'noteHeaderDrop'

	function opResultsSince(firstOp ElementIndex) returns ValueIdArray
		let results = ValueIdArray.create(self.artifact.module.ops.count() - firstOp, zeroed: false)

		for opIndex in firstOp upto self.artifact.module.ops.count() 'eachOp'
			let op = try self.artifact.module.ops.get(opIndex) otherwise panic("opResultsSince: ops.get OOB at {opIndex} below the count just read")
			results.push(try maxonOpDefinedValue(op) otherwise panic("opResultsSince: op {opIndex} defines no value — every op a drop or a slot vacate emits mints the value that names it"))
		end 'eachOp'

		return results
	end 'opResultsSince'

	function emitDecrefOps(value ValueId, range SourceRange)
		if let feed = try self.feedGuardedBy(value) 'aFeedDropGuard'
			self.emitOwnershipRuntimeCall(ReclaimTypeParamName, args: argsOf(feed), range: range)
			return
		end 'aFeedDropGuard'

		if self.valueIsImmortalFunction(value) 'anImmortalRecord'
			return
		end 'anImmortalRecord'

		if self.tagOf(value) == ValueTypeTag.interfaceRef 'existential'
			self.emitDropCall(value, callee: DropExistentialName, args: twoArgs(self.witnessOfValue(value), second: value), range: range)
			return
		end 'existential'

		let callee = self.decrefCalleeFor(value)

		// ⭐ **A RECORD THIS SHARED BODY GAVE A DESCRIPTOR-MEDIATED REFERENCE RELEASES IT BEFORE ITS BOX GOES.**
		// Its own cascade cannot: the layout's `T` field is not managed in the DECLARATION view,
		// which is right for every OTHER reader of that layout and is exactly why the obligation is carried on
		// the value. See `recordsOwningOpaqueSlots` for the leak this closes and why the mark is per-value.
		//
		// ⛔ **UNLESS THE CASCADE ABOUT TO RUN *IS* THE DICTIONARY ONE, WHICH RELEASES THE SAME SLOTS**
		// — and then this arm would release them a second time. The two are read off ONE callee
		// rather than each being argued unreachable from the other: a mark is a fact about the FRAME, a
		// dictionary destructor is a fact about the TYPE, and nothing structurally keeps a value from carrying
		// both. Where it does, the destructor is the correct releaser, because it fires at refcount ZERO and
		// this arm fires unconditionally.
		if valueIsMarked(self.bodyState.recordsOwningOpaqueSlots, value: value) and not isDictionaryDestructorCallee(callee) 'ownsOpaqueSlots'
			self.emitOpaqueSlotReleases(value, range: range)
		end 'ownsOpaqueSlots'

		// ⭐ An OPAQUE drop reads the enclosing instance's layout descriptor at run time, so it needs the
		// parameter that carries it — reserved before this body was parsed. Record a disagreement rather than
		// emitting a call the lowering can only abort on; `parseFunction` refuses it with a position.
		//
		// ⚠ **THE DICTIONARY DESTRUCTOR READS ONE TOO AND IS DELIBERATELY NOT TESTED HERE**, because it could
		// never answer: `instanceBoxDropCallee` picks that callee only where the descriptor already exists, so
		// an arm for it would be a gate that cannot fail. The guarantee is held there, where the choice is
		// made, and `LowerMaxonToStd.appendWholeLayoutDescriptor` panics if the two ever come apart.
		if callee.equals(DropTypeParamName) and valueIsMarked(self.bodyState.witnessCursorElements, value: value) 'aWitnessCursorElement'
			self.bodyState.droppedAWitnessCursorElement = true
		end 'aWitnessCursorElement'

		self.emitDropCall(value, callee: callee, args: argsOf(value), range: range)
	end 'emitDecrefOps'

	function emitDropCall(value ValueId, callee ByteArray, args ValueIdArray, range SourceRange)
		match self.holdKindOf(value) 'hold'
			found(kind) then self.emitHoldEnd(value, kind: kind, callee: callee, args: args, range: range)
			none then self.emitOwnershipRuntimeCall(callee, args: args, range: range)
		end 'hold'
	end 'emitDropCall'

	// ⭐⭐ **RELEASE EVERY OPAQUE `T` SLOT OF A RECORD THIS BODY BUILT AND IS ABOUT TO FREE** —
	// the drop dual of `moveOpaqueValueInto`'s store, emitted only for a record the store actually referenced
	// (`recordsOwningOpaqueSlots`).
	//
	// The slot is LOADED rather than the retained SSA value being remembered, because a tuple slot is
	// WRITABLE (`t.0 = x`) — a remembered value would be the one the write replaced, and releasing that is a
	// double free at the far end. The load is what the record actually holds at this moment, which is the only
	// thing the drop may act on.
	//
	// The descriptor is guaranteed: the store that set the mark went through `__retain_type_param`, which owes
	// the same descriptor and records its absence itself, so this cannot be the first site to need one.
	function emitOpaqueSlotReleases(box ValueId, range SourceRange)
		let layout = self.declaredLayoutOfRecordValue(box)

		for i in 0 upto layout.fieldCount() 'eachField'
			let declared = self.signatures.fieldTypeOf(layout, index: i, into: self.artifact.typeNames)

			if maxonTypeTag(declared) != ValueTypeTag.typeParameter 'notOpaque'
				continue
			end 'notOpaque'

			self.emitOwnershipRuntimeCall(DropTypeParamName, args: argsOf(self.emitFieldLoad(box, layout: layout, index: i, range: range)), range: range)
		end 'eachField'
	end 'emitOpaqueSlotReleases'

	// The declared layout of a record VALUE that took a descriptor-mediated reference — a `Self{…}` or a tuple
	// literal, both `structRef`-tagged by `emitOwnedStructBox`.
	//
	// ⚠ **A UNION BOX IS THE ONE OTHER THING `moveInPayload` FILLS, AND IT CANNOT REACH HERE TODAY** — not by
	// arrangement but because the construct is refused: a generic union instantiated over a type parameter is
	// unspellable in a return position (`E2001` on `returns Holder with E`) and `E3005` through an inner
	// alias, so no shared body ever builds one and no `T` payload is ever stored. The panic states that rather
	// than a layout being silently skipped, because the day the front end admits the construct this cascade
	// owes it a release and a quiet miss would be a leak.
	function declaredLayoutOfRecordValue(box ValueId) returns StructLayout
		let name = self.valueTypeName(box)

		match self.signatures.structFor(name, readerFilePath: self.job.path) 'declared'
			declared(layout) then return layout
			undeclared then panic("declaredLayoutOfRecordValue: v{box} took a descriptor-mediated reference into a slot of '{String.from(name)}', which declares no struct — a UNION box is the only other record `moveInPayload` fills, and a generic union over a type parameter is refused at the front end, so admitting one means this cascade now owes its payload a release")
		end 'declared'
	end 'declaredLayoutOfRecordValue'

	// Every synthesized retain or release goes through here, and the one thing this door adds is that
	// it is never routed to a handler. These calls are `void` and the compiler's own, and they are
	// emitted into the router's own output: `tryBlockThrowEdgeTarget` fills a landing pad with them
	// while `currentBlock` points at that pad, and `reconcileMovesAtMerge` appends them to live edge
	// blocks. Routed, one would split the block the router is building.
	//
	// It is inert while no drop or retain callee (`__mm_incref`, `__mm_decref`, `__str_decref`,
	// `__managed_decref`, `__destruct_*`, `__drop_existential`) carries a throws clause, because the
	// router declines on the clause; that is a fact about which runtime families are typed, not about
	// this code.
	function emitOwnershipRuntimeCall(callee ByteArray, args ValueIdArray, range SourceRange)
		let savedRouteClaim = self.swapClaim(ThrowRouteClaim.everyDestination)
		_ = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		self.restoreClaim(savedRouteClaim)
	end 'emitOwnershipRuntimeCall'

	// ⭐ **PATH-SENSITIVE MOVE STATE — CAPTURE.** Snapshot the `movedFrom` bit (and current value) of every
	// owned binding in scope, so a branch's moves can be UNDONE for a sibling path (`restoreMoveMark`) or
	// reconciled at a join (`reconcileMovesAtMerge`). The twin of `snapshotBindings` for the drop-gating
	// bit. Positional over `ownedBindings`; see `MoveMark` for why only `movedFrom` rides and why the
	// height is stable at every capture point.
	//
	// ⭐ **AND THE CONSUMED GREEN THREADS BESIDE IT, WHICH ARE NOT POSITIONAL AND CANNOT BE.** A promise
	// ALIASES rather than moves, so a second name for a thread enrols no owned binding — there is no slot in
	// the positional column for the alias's poison to live in. The consume list is keyed on the thread's own
	// `ValueId` instead and rides whole.
	function captureMoveMark() returns MoveMark
		return MoveMark.create(self.syncedMoveSlots(), consumes: self.bodyState.promiseConsumes)
	end 'captureMoveMark'

	function syncedMoveSlots() returns MoveSlots
		let height = self.bodyState.ownedBindings.count()
		let positions = self.bodyState.moveLedger.takeRefreshPositions(height)

		if positions.isEmpty() 'nothingChangedSinceTheLastSnapshot'
			return self.bodyState.moveLedger.live
		end 'nothingChangedSinceTheLastSnapshot'

		let moved = BoolArray.create(positions.count(), zeroed: false)
		let values = ValueIdArray.create(positions.count(), zeroed: false)

		for position in positions 'eachPosition'
			let binding = try self.bodyState.ownedBindings.get(position) otherwise panic("syncedMoveSlots: ownedBindings.get OOB at {position}")
			moved.push(binding.movedFrom)
			values.push(binding.moveStateValue())
		end 'eachPosition'

		self.bodyState.moveLedger.install(positions, height: height, moved: moved, values: values)
		return self.bodyState.moveLedger.live
	end 'syncedMoveSlots'

	function enrolOwnedBinding(binding VarInfo)
		let enrolled = binding
		enrolled.enrolledAt = self.bodyState.ownedBindings.count()
		enrolled.isEnrolled = true
		self.bodyState.ownedBindings.push(enrolled)
		self.bodyState.moveLedger.noteDirty(enrolled.enrolledAt)

		if self.valueIsLinear(enrolled.boundValue) 'aLinearBinding'
			self.bodyState.anyLinearOwned = true
		end 'aLinearBinding'
	end 'enrolOwnedBinding'

	function valueIsLinear(value ValueId) returns bool
		return self.signatures.valueIsLinear(self.tagOf(value), nameId: self.valueNameId(value), from: self.artifact.typeNames)
	end 'valueIsLinear'

	function noteDroppedLinear(value ValueId, firstOp ElementIndex, name immutable ByteArray)
		if firstOp >= self.artifact.module.ops.count() or not self.valueIsLinear(value) 'notALinearDrop'
			return
		end 'notALinearDrop'

		self.noteDroppedOwned(DroppedOwnedKind.linear, op: firstOp, name: name)
	end 'noteDroppedLinear'

	function noteDroppedOwned(kind DroppedOwnedKind, op ElementIndex, name immutable ByteArray)
		self.notesForWrite(self.bodyFunction()).sparseForWrite().droppedOwned.push(DroppedOwned.create(op, name: name, kind: kind))
	end 'noteDroppedOwned'

	function noteLinearLiveAcrossOp(opIdx ElementIndex)
		for binding in self.bodyState.ownedBindings 'eachOwned'
			if not binding.movedFrom and self.valueIsLinear(binding.boundValue) 'aLiveLinearBinding'
				self.recordLinearLiveAt(opIdx, name: binding.name)
				return
			end 'aLiveLinearBinding'
		end 'eachOwned'

		for pending in self.bodyState.pendingTempDrops 'eachPending'
			if self.valueIsLinear(pending) 'aLiveLinearTemporary'
				self.recordLinearLiveAt(opIdx, name: EmptySourceText)
				return
			end 'aLiveLinearTemporary'
		end 'eachPending'
	end 'noteLinearLiveAcrossOp'

	function recordLinearLiveAt(opIdx ElementIndex, name ByteArray)
		let notes = self.notesForWrite(self.bodyFunction()).sparseForWrite()
		notes.liveLinearCallOps.push(opIdx)
		notes.liveLinearCallNames.push(name)
	end 'recordLinearLiveAt'

	function truncateOwnedBindings(height ElementIndex)
		for position in height upto self.bodyState.ownedBindings.count() 'eachDropped'
			let dropped = try self.bodyState.ownedBindings.get(position) otherwise panic("truncateOwnedBindings: ownedBindings.get OOB at {position}")
			dropped.isEnrolled = false
		end 'eachDropped'

		self.bodyState.ownedBindings.truncate(height)
	end 'truncateOwnedBindings'

	// ⭐ **PATH-SENSITIVE MOVE STATE — RESTORE.** Rewind every owned binding's `movedFrom` bit to a
	// captured mark, undoing the moves a sibling branch made so the next path is parsed against the
	// pre-branch ownership state (the twin of `restoreBindings`). Written THROUGH the shared `VarInfo`
	// reference, so every holder observes it. The owned height must match the capture — a branch's own
	// owned bindings were popped before this runs (see `MoveMark`), so a mismatch is a lockstep break.
	function restoreMoveMark(mark MoveMark)
		if self.bodyState.ownedBindings.count() != mark.height() 'drifted'
			panic("restoreMoveMark: owned-binding height {self.bodyState.ownedBindings.count()} differs from the captured mark's {mark.height()} — a branch's owned bindings must be popped before its move state is restored")
		end 'drifted'

		for position in self.syncedMoveSlots().differences(mark.slots) 'eachDifference'
			let binding = try self.bodyState.ownedBindings.get(position) otherwise panic("restoreMoveMark: ownedBindings.get OOB at {position}")
			binding.setMovedFrom(mark.movedAt(position), ledger: self.bodyState.moveLedger)

			if binding.isCellBinding 'restoreTheCellsEpoch'
				binding.cellEpoch = CellEpoch.current(mark.valueAt(position))
			end 'restoreTheCellsEpoch'

			self.bodyState.moveLedger.noteDirty(position)
		end 'eachDifference'

		// ⭐ **THE CONSUME HALF IS ASSIGNED, NOT UNWOUND, AND IT MUST GO IN BOTH DIRECTIONS.** A restore is
		// not always a rewind: `finalizeIfNoElse`'s direct-false-edge arm restores the THEN branch's mark
		// onto the entry state, which ADDS the consumes that branch made. Replacing the list with an
		// independent copy of the mark's states "the consume state at this join is exactly what the mark
		// says" once, for both directions, instead of two rules that could disagree about which way is which.
		self.bodyState.promiseConsumes = mark.consumes
	end 'restoreMoveMark'

	// ⭐⭐ **PATH-SENSITIVE MOVE STATE — RECONCILE AT A JOIN.** Given the edges that REACH a merge (each an
	// already-live predecessor block paired with the move state it carries), settle every owned binding to
	// a UNIFORM post-merge state so the later scope-exit drop is correct on every path:
	//   • moved on SOME edges, live on OTHERS ⇒ the value was given away on the moved edges but is still
	//     owned on the live ones. Emit its drop on each LIVE edge (using that edge's own value), and mark
	//     the binding moved after the merge — settled on every path, so the scope-exit drop skips it.
	//   • moved on ALL edges ⇒ already given away everywhere; mark moved, drop nothing.
	//   • live on ALL edges ⇒ still owned everywhere; mark live, drop nothing — the scope exit drops it.
	// A binding moved before the whole construct is moved on every reaching edge (the flag is monotonic
	// within a path), so it stays moved; a binding no branch touched is live on every edge and stays live.
	// The reaching edges are UNTERMINATED blocks (a terminated branch dropped its own values and
	// contributes no edge), so a decref appended to one lands before the merge branch the caller emits
	// next. Called only with at least one reaching edge — an all-terminating construct has a dead merge and
	// leaves the move state alone.
	function reconcileMovesAtMerge(edges ReachingMoveEdgeArray, anchor Token)
		// The caller must pass at least one reaching edge — an all-terminating construct has a dead merge and
		// must NOT call this at all. With no edges every binding would read `anyMoved == false` and be marked
		// live, silently clobbering an already-moved binding's state (a mass-leak footgun on the most delicate
		// path). Enforced loudly rather than trusted, since a wrong move state here is a leak or a double-free.
		if edges.count() == 0 'noEdges'
			panic("reconcileMovesAtMerge: called with no reaching edges — an all-terminating construct has a dead merge and must leave the move state alone rather than reconcile it")
		end 'noEdges'

		let n = self.bodyState.ownedBindings.count()

		for edge in edges 'checkAligned'
			if edge.mark.height() != n 'drifted'
				panic("reconcileMovesAtMerge: a reaching edge's mark holds {edge.mark.height()} entries but {n} owned bindings are in scope — the marks drifted out of lockstep with the owned-binding stack")
			end 'drifted'
		end 'checkAligned'

		for position in self.positionsToReconcile(edges) 'eachBinding'
			self.reconcileBindingAtMerge(edges, position: position, anchor: anchor)
		end 'eachBinding'

		// ⭐ **AND THE CONSUMED THREADS SETTLE THE SAME WAY THE BITS ABOVE DO — spent on ANY reaching edge is
		// spent past the merge, and spent on NO reaching edge is NOT** (`binding.movedFrom = anyMoved`, one
		// loop up, said of a value instead of a binding). There is no drop to place for them and so no
		// per-edge emission: a consume already handed the thread to the runtime on the edge that made it,
		// and the edges that did not made none.
		//
		// ⛔⛔ **ASSIGNED FROM THE EDGES, NEVER UNIONED ONTO THE LIVE STATE — the bits one loop up are, and two
		// columns settling one join by two different rules is exactly how they come to disagree.** This used
		// to union in place, on the premise that the live state is always a subset of the union. It is not:
		// the state this routine finds is whatever was parsed LAST, and that is not always a reaching edge.
		// A `match` restores the entry mark at the START of each arm (`beginFreshArm`) and never after the
		// last one, so an arm that RETURNS leaves its own consumes live while contributing no edge — and the
		// union carried its thread past a merge no reaching path spends it on.
		//
		// MEASURED: two programs differing only in the ORDER of one match's two arms: with
		// `default then return (await p)` LAST the following `await p` was refused E3142, while the same
		// match written the other way round compiled and exited 44. The `movedFrom` bits were right in both,
		// because they are ASSIGNED from `anyMoved` over the reaching edges — which is what this does.
		let firstEdge = try edges.get(0) otherwise panic("reconcileMovesAtMerge: a merge is reconciled only with a reaching edge")
		var settled = firstEdge.mark.consumes

		for edge in edges 'eachEdgesConsumes'
			settled = settled.unioned(edge.mark.consumes)
		end 'eachEdgesConsumes'

		self.bodyState.promiseConsumes = settled
	end 'reconcileMovesAtMerge'

	function positionsToReconcile(edges ReachingMoveEdgeArray) returns MoveSlotIndexColumn
		let first = try edges.get(0) otherwise panic("positionsToReconcile: a merge is reconciled only with a reaching edge")
		let positions = MoveSlotIndexColumn.create(0)

		for edge in edges 'eachEdge'
			positions.append(positionsThatMayDiffer(first.mark, b: edge.mark))
		end 'eachEdge'

		positions.append(self.syncedMoveSlots().differences(first.mark.slots))
		return sortedUniquePositions(positions)
	end 'positionsToReconcile'

	function reconcileBindingAtMerge(edges ReachingMoveEdgeArray, position ElementIndex, anchor Token)
		var anyMoved = false
		var anyLive = false

		for edge in edges 'scan'
			let movedHere = edge.mark.movedAt(position)

			if movedHere 'movedHere'
				anyMoved = true
			end 'movedHere' else 'liveHere'
				anyLive = true
			end 'liveHere'
		end 'scan'

		let joined = try self.bodyState.ownedBindings.get(position) otherwise panic("reconcileBindingAtMerge: ownedBindings.get OOB at {position}")
		let joinedIsObligation = joined.isErrorMatchObligation
		let joinedName = joined.name
		let joinedIsCell = joined.isCellBinding

		if joinedIsCell 'aCellKeepsItsOwnRelease'
			self.settleCellEpochAtMerge(edges, position: position)
		end 'aCellKeepsItsOwnRelease' else if anyMoved and anyLive and joinedIsObligation 'matchedOnSomePaths'
			self.holdErrorMatchRefusal(joinedName, reason: ErrorMatchPathsDisagreeReason, anchor: anchor)
		end 'matchedOnSomePaths' else if anyMoved and anyLive 'mixed'
			let saved = self.bodyState.currentBlock

			for edge in edges 'dropLive'
				let movedOnEdge = edge.mark.movedAt(position)

				if not movedOnEdge 'liveEdge'
					self.bodyState.currentBlock = edge.block
					let liveValue = edge.mark.valueAt(position)

					// ⚠ A bare decref, where `emitScopeRelease` drops a cell binding in two steps. Sound
					// because the value here is never a cell's box: a cell binding cannot be moved — the
					// poisoning doors match a binding through `boundValue` and a cell's reads yield fresh
					// loads — so no cell binding is ever mixed at a merge.
					self.emitDecref(liveValue, range: SourceRange.ofToken(anchor))
				end 'liveEdge'
			end 'dropLive'

			self.bodyState.currentBlock = saved
		end 'mixed'

		let binding = try self.bodyState.ownedBindings.get(position) otherwise panic("reconcileBindingAtMerge: ownedBindings.get OOB at {position}")

		if joinedIsCell 'aCellsEpochIsSettledAbove'
			binding.setMovedFrom(anyMoved, ledger: self.bodyState.moveLedger)
		end 'aCellsEpochIsSettledAbove' else if anyMoved 'movedOnAnEdge'
			if not edgesCarryOneValue(edges, position: position) 'theMergeMintsAPhi'
				self.noteSettledMerge(edges, position: position)
			end 'theMergeMintsAPhi'
		end 'movedOnAnEdge'

		binding.setMovedFrom(anyMoved, ledger: self.bodyState.moveLedger)
		self.bodyState.moveLedger.noteDirty(position)
	end 'reconcileBindingAtMerge'

	function noteSettledMerge(edges ReachingMoveEdgeArray, position ElementIndex)
		for scan in self.bodyState.loopScans 'eachLoop'
			if scan.settlesAtEntry(position) 'liveWhenTheLoopWasEntered'
				for edge in edges 'eachEdge'
					scan.noteSettledEdge(edge.block.id, position: position)
				end 'eachEdge'
			end 'liveWhenTheLoopWasEntered'
		end 'eachLoop'
	end 'noteSettledMerge'

	// ⭐ **WHICH RUNTIME ENTRY DROPS `value`** — one tag-and-type router, extended per managed kind:
	//   • a STRING (`__str_decref`) frees its record AND the external buffer a grown String leaves behind
	//     (`parent@32`/`buffer@0`), which the generic decref structurally cannot reach;
	//   • a STRUCT box that owns a managed field (`__destruct_<Struct>`) drops each managed field through ITS
	//     own destructor, then frees the box — because the generic decref would leak them;
	//   • a MANAGED-PAYLOAD union box (`__destruct_<U>`) runs its own tag-conditional cascade — drop each
	//     live managed field through ITS own destructor, then free the box — because a union box carries
	//     owned payloads the generic decref would leak;
	//   • everything else (a SCALAR union box, a struct box whose fields are all scalars, a raw interpolation
	//     buffer) is the generic refcounted `__mm_decref` — its `TrivialDestructor` frees exactly the box.
	// A struct/union routed to a cascade is decided off `managedFieldDropCallee` / `unionBoxDropCallee`,
	// which wrap the SAME predicates the destructor synthesis (and `noteDestructorUsage`) emit from, so a
	// box routed to a cascade here always has one built for it.
	function decrefCalleeFor(value ValueId) returns immutable ByteArray
		// ⭐ **A PROMISE IS A GREEN-THREAD HANDLE, NOT A REFCOUNTED HEAP BOX.** An un-awaited
		// `async` spawn dropped at scope exit / a re-arm routes to `__gt_promise_drop`, which reclaims AND
		// cancels the thread — NOT `__mm_decref` (a promise owns no `__mm_alloc` box; the handle is the GT
		// struct pointer). Checked FIRST, off the promise MARK column, because no TAG identifies a promise: a
		// spawn's handle is typed at the interned `Promise with (T[, E])`,
		// but a bare `int` binding reassigned from a promise wears the same tags a promise does — so
		// tag-based routing would send one down the other's road. The mark is written by every road that
		// mints a promise and by nothing else, which is what makes it the answer.
		if self.valueOwnsGreenThread(value) 'promise'
			return GtPromiseDropName
		end 'promise'

		// Ahead of the `dropCallees` memo, whose key is the tag and the type parameter's name: it cannot
		// tell a guarded feed from an unguarded value of the same `T`, so an answer cached for one would be
		// served to the other.
		if self.feedIsGuarded(value) 'aGuardedFeed'
			return ReleaseTypeParamName
		end 'aGuardedFeed'

		let carriesLayoutParam = self.bodyState.carriesLayoutParam()
		var key = ((self.tagOf(value).ordinal as ImageableVerdictKey) shl ImageableVerdictTagShift) or (self.valueNameId(value) as ImageableVerdictKey)

		if carriesLayoutParam 'keyedByTheFrame'
			key = key or DropCalleeLayoutParamBit
		end 'keyedByTheFrame'

		if let known = try self.memos.dropCallees.get(key) 'alreadyAsked'
			return known.spelling()
		end 'alreadyAsked'

		let frame = self.signatures.openCascadeWalk()
		let callee = self.typeDecrefCalleeFor(value)
		let memoized = self.typeDecrefCalleeFor(value)

		if self.signatures.closeCascadeWalk(frame) 'restsOnDeclarationsAlone'
			self.memos.dropCallees.file(key, value: DropCallee.create(memoized))
		end 'restsOnDeclarationsAlone'

		return callee
	end 'decrefCalleeFor'

	function typeDecrefCalleeFor(value ValueId) returns immutable ByteArray
		let tag = self.tagOf(value)

		// ⚠ `tagIsByteRecord`, NOT `tag == ValueTypeTag.string`: WHICH DROP a value takes is decided by its
		// RECORD, and a Character's record is a String's. Left narrow, a dropped Character falls past every
		// arm below to the generic `__mm_decref`, which frees the box without releasing the external buffer a
		// detached record owns — a leak on exactly the Character values.
		if tagIsByteRecord(tag) 'byteRecord'
			return StrDecrefName
		end 'byteRecord'

		if tag == ValueTypeTag.function 'aFunctionValue'
			return MmDecrefName
		end 'aFunctionValue'

		// ⭐ AN OPAQUE TYPE-PARAMETER binding (`push(item Element)`'s `item`, enrolled owned in a shared generic
		// body). Its element destructor is not known statically — the body compiles ONCE for
		// every instantiation — so it drops through `__drop_type_param(descriptor, value)`, which reads the
		// enclosing instance's layout descriptor `destroyFunc@40` at run time (0 for a trivial instantiation →
		// inert). `lowerRuntimeCall` prepends the descriptor argument, the drop twin of the opaque array create.
		if tag == ValueTypeTag.typeParameter 'opaque'
			return DropTypeParamName
		end 'opaque'

		// A struct box: `managedFieldDropCallee` returns `__destruct_<Struct>` for one that owns a managed
		// field and the trivial `__mm_decref` otherwise, reading only allocation-free `Map.contains` /
		// per-field checks (no throwaway box), so it needs no hot-path guard of its own.
		if self.valueIsAHeapRecord(value) 'struct'
			return self.structBoxDropCallee(value)
		end 'struct'

		// ⭐ A GENERIC-INSTANCE box (`Box with String`) drops through its own `__destruct_<mangled>`
		// cascade when the instance owns managed heap, else the trivial `__mm_decref`. The gid is on the value's
		// name column (the same access `instanceIdOfValue` reads at lowering); the drop callee is decided
		// INSIDE `ProgramSignatures` over the instance's own registry/interner — a trivial instance (`IntBox`)
		// answers `__mm_decref`.
		if tag == ValueTypeTag.genericInstance 'instance'
			return self.instanceBoxDropCallee(value)
		end 'instance'

		// ⚠ **THE `named` PRE-CHECK IS A HOT-PATH ALLOCATION GUARD, NOT A TIDY EARLY RETURN** — the exact
		// one `valueIsUnion` documents. This runs for EVERY dropped owned value (an interpolation buffer),
		// and `enumMatchFor` returns a `DeclaredEnum` — a heap-boxed Maxon union VALUE even for its
		// `undeclared` case. Only a `named`-tagged value can be a union box; an interp buffer is `integer`,
		// so gating here is what keeps a String/interp drop from boxing a throwaway `DeclaredEnum.undeclared`
		// (measured on scale-test: this guard keeps `allocsDelta` at 0).
		if tag != ValueTypeTag.named 'notUnion'
			return MmDecrefName
		end 'notUnion'

		let decl = self.enumMatchFor(value)

		if enumMatchIsDeclared(decl) 'union'
			// The drop callee is decided INSIDE `ProgramSignatures`, over the layout's own interner —
			// NOT here with `self.artifact.typeNames`. A signatures layout's payload ids live in the
			// signatures interner, and resolving them against this file's interner misread a managed
			// payload whenever a ranged alias shifted the interning order (a leak / wild-free).
			return self.signatures.unionBoxDropCallee(requireEnumLayout(decl).name)
		end 'union'

		// A `named` value that is not a declared union is a declared STRUCT read from a FIELD: a struct
		// field's value carries `named`, not `structRef` (`fieldTypeOf` re-tags only function/generic-alias
		// fields), so the OLD value dropped on `h.n = …` arrives here. Route it through the SAME
		// `managedFieldDropCallee` the `structRef` arm and the destructor synthesis use, so a MANAGED-owning
		// struct drops through its `__destruct_<T>` cascade — the trivial `MmDecrefName` frees only the box
		// and LEAKS its managed fields (exit 101). A trivial struct answers `MmDecrefName` there too
		// (byte-identical), so only the managed case changes. The `containsStruct` gate keeps a `named` that
		// names no declared struct (a ranged typealias) on the trivial path, where `managedFieldDropCallee`
		// would otherwise panic (it classifies only struct/union/generic-alias fields).
		if self.signatures.containsStructFor(self.valueTypeName(value), readerFilePath: self.job.path) 'struct'
			return self.structBoxDropCallee(value)
		end 'struct'

		return MmDecrefName
	end 'typeDecrefCalleeFor'

	// ⭐⭐⭐ **WHICH CASCADE FREES A RECORD BOX — the ordinary one, or the DICTIONARY one.** The
	// declared-record twin of `instanceBoxDropCallee`, and it carries that function's whole argument at the one
	// record shape the instance family cannot see: a TUPLE whose elements stand at the enclosing generic's own
	// parameters. `typeIsManaged` answers `false` for a bare parameter, so `managedFieldDropCallee` hands back
	// the trivial `__mm_decref` — which frees the box and STRANDS the reference `Parser.moveOpaqueValueInto`
	// took into the slot through `retainFunc@64`.
	//
	// ⛔ **IT IS GATED ON THE BODY HAVING A DESCRIPTOR, exactly as `instanceBoxDropCallee` is**: a frame with
	// no descriptor has nothing to release THROUGH, and it is also a frame no real protocol ever reached — a
	// caller that carries none hands such a chain the parameterised blob whose ownership words are all zero,
	// so nothing was retained there either (`LowerMaxonToStd.emitInstanceDescriptorAddr`'s mint arm).
	//
	// ⛔⛔ **AND ON THE RECORD'S SLOTS BEING *THIS* BODY'S OWN PARAMETERS**, which is `recordOpaqueSlotDeclaration`
	// carrying a declaration rather than a `bool`: the descriptor a method holds lays out its ENCLOSING type's
	// `uses` list, and releasing another declaration's parameter positions into it is the position mismatch
	// measured at exit 139.
	function structBoxDropCallee(value ValueId) returns immutable ByteArray
		let name = self.valueTypeName(value)

		if self.bodyState.carriesLayoutParam() and self.recordRestsThisBodysOpaqueSlot(name) 'aRecordOverThisBodysParameters'
			return dictionaryDestructorSymbol(name)
		end 'aRecordOverThisBodysParameters'

		return managedFieldDropCallee(self.signatures, typeNames: self.artifact.typeNames, fieldType: self.typeOf(value))
	end 'structBoxDropCallee'

	// Does `name` denote a record resting a slot at a parameter of the type THIS body is a method of? The two
	// halves of the gate above that are questions about the record rather than about the frame, asked together
	// because either alone admits a record this body cannot release correctly.
	function recordRestsThisBodysOpaqueSlot(name ByteArray) returns bool
		match self.signatures.opaqueSlotDeclarationOf(name) 'restsASlot'
			none then return false
			declaredBy(owner) then return self.enclosingType.names(owner)
		end 'restsASlot'
	end 'recordRestsThisBodysOpaqueSlot'

	// ⭐⭐⭐ **WHICH CASCADE FREES AN INSTANCE BOX — the MONOMORPHIZED one, or the DICTIONARY one.**
	// A concrete `Box with String` has a `__destruct_Box_String` that resolves every field's release
	// statically. The instance a SHARED generic body holds — `BagIter with Element` inside
	// `type Bag uses Element` — does not: its `slot` stands at a bare parameter, `typeIsManaged` answers
	// `false` for it, and `genericInstanceBoxDropCallee` therefore hands back the trivial `__mm_decref`, which
	// frees the box and STRANDS whatever reference the slot holds.
	//
	// ⛔⛔ **MEASURED, and it is the whole reason this family exists: with the constructor-feed retain in place
	// and no dictionary destructor, three `generic-opaque-cursor-element` cases exit 101.** `Bag.contains`
	// (`stdlib/Interfaces.maxon`'s `extension Iterable`, re-parsed per conformer) decrefs the iterator record on
	// both loop exits, and that decref is the trivial one.
	//
	// ⚠ The gate is `instanceRestsARetainedSlot` and NOT `instanceRestsAnUnnameableSlot`: the retain that puts
	// a reference in the slot reads every interned row (`typeParamFeedCanOwnAReference`), so the release must
	// too — see that predicate's header for the two kinds and why a refusal's narrower one would leak here.
	//
	// ⛔⛔ **AND IT IS ALSO GATED ON THE BODY RESERVING A LAYOUT SLOT.** A dictionary destructor makes its
	// caller a layout carrier in lowering's carrier scan, and a body with no slot to receive the descriptor
	// in cannot be one. A body reserving none that is nevertheless the LAST owner of such a record falls
	// through to `genericInstanceBoxDropCallee`, which frees the box and leaves the slot — a LEAK the gate
	// reports, not a use-after-free.
	//
	// ⭐ It is ALSO the guarantee `emitDecref` does not restate: because the dictionary callee is chosen only
	// where a slot is reserved, no drop site can emit one in a body that cannot carry a descriptor — which is
	// why `LowerMaxonToStd`'s prepend panics rather than testing.
	function instanceBoxDropCallee(value ValueId) returns immutable ByteArray
		let gid = self.valueNameId(value)

		if self.bodyState.carriesLayoutParam() and self.signatures.instanceRestsARetainedSlot(gid as GenericInstanceId) 'aDeclarationViewRestingARetainedSlot'
			return instanceDictionaryDestructorSymbol(self.signatures, id: gid as GenericInstanceId)
		end 'aDeclarationViewRestingARetainedSlot'

		return self.signatures.genericInstanceBoxDropCallee(gid as GenericInstanceId)
	end 'instanceBoxDropCallee'

	// ⭐ **CALL AN EMITTED RUNTIME ENTRY POINT** (`__mm_alloc`, `__mm_decref`) — the door the parser
	// reaches the heap through, and the only one.
	//
	// It is NOT `emitCall`, and the difference is what a runtime call IS: `emitCall` types its
	// result from the whole-program signature index and slots its arguments against a declaration.
	// The runtime has neither — it is built at the STD tier, after lowering (`installMmRuntime`),
	// so no file declares it, `mintCallResult` would type it `unresolved` (a tag that PANICS at
	// lowering), and `SemanticCheck` would report E3004 against a name the user never wrote.
	// `isRuntimeCallee` is what tells the two apart, and it is one predicate read by the three
	// places that care (here, `validateCall`, `lowerCall`).
	//
	// So the caller states the result's type, because the caller is the compiler and it KNOWS: an
	// `__mm_alloc` returns the struct it just built, a `__mm_decref` returns nothing.
	//
	// ⚠ **EVERY ARGUMENT IS POSITIONAL, IN DECLARATION ORDER — FOR A `__`-PREFIXED RUNTIME CALLEE.** There
	// is no label to reorder by: the runtime has no parameter names for a label to match, so `lowerCall`
	// passes them straight through. `emptyArgLabels` is what says so on the op, and `lowerCall`'s guard is
	// what makes a labelled runtime call fail loudly rather than mis-slot.
	//
	// ⭐ **`argLabels` IS THE ONE EXCEPTION, AND IT EXISTS FOR THE CORPUS SEGMENTER (see
	// `CorpusFindGraphemeEnd`).** A callee that IS declared — a stdlib free function this compiler routes a
	// builtin method to — is slotted against its declaration by `slotCallArgs`, so a labelled parameter
	// needs its label present or the argument lands in the wrong slot. Supplying it is therefore the whole
	// difference between the two kinds of callee, and it is a PARAMETER rather than a second emitter
	// because everything else about the two is identical: same op, same routing hook, same result mint.
	//
	// ⚠ An EMPTY column means "all positional", never "zero arguments" — `slotCallArgs` INDEXES this
	// column, so a positional call must still hand it a real per-argument one (`emptyArgLabels`'s own
	// header). The two cases cannot be confused: a call with no arguments has nothing to slot either way.
	function emitRuntimeCall(callee ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange) returns ValueId
		return self.emitLabelledRuntimeCall(callee, args: args, resultTag: resultTag, resultNameId: resultNameId, range: range, argLabels: emptyArgLabels(args))
	end 'emitRuntimeCall'

	function emitLabelledRuntimeCall(callee ByteArray, args ValueIdArray, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange, argLabels NameRoster) returns ValueId
		let result = self.emitRuntimeCallInto(self.mintValue(resultTag, nameId: resultNameId), callee: callee, args: args, range: range, argLabels: argLabels)

		if tagIsIntegral(resultTag) 'anIntegralAnswer'
			self.recordDeclaredReturnRange(callee, value: result)
		end 'anIntegralAnswer'

		return result
	end 'emitLabelledRuntimeCall'

	function recordDeclaredReturnRange(callee ByteArray, value ValueId)
		match self.signatures.declaredReturnAliasOf(callee) 'declaredReturn'
			undeclared then return
			declared(alias) then self.recordDeclaredAliasRange(value, alias: alias)
		end 'declaredReturn'
	end 'recordDeclaredReturnRange'

	// ⭐⭐ **THE SAME EMISSION, ONTO A RESULT THE CALLER ALREADY MINTED — for the one construct whose
	// ARGUMENTS have to name the record the call will hand back.** `<Union>.fromName("case", payload…)` moves
	// its payload arguments in at the parser (`parseEnumFromNameCase`), and a move-in into a slot declared at
	// an opaque type parameter MARKS the record that owes the slot's release (`moveOpaqueValueInto` →
	// `markRecordOwningOpaqueSlots`). That record is this call's result, and the call cannot be emitted first:
	// `try` binds to the op producing the target's value (`opProducingTheValue`), so the move-in ops
	// must
	// precede it. Minting the result up front is what lets both facts hold at once.
	//
	// ⚠ **THE SPLIT IS THE MINT, WHICH IS WHY THE FRONT DOOR IS NOT A THIN WRAPPER.** Every other runtime call
	// wants its result minted from the tag and the type name, and must not be free to mint it twice or from a
	// different tag than the one the op is emitted under.
	function deferWriteThroughReadOnlyReceiver(callee ByteArray, args ValueIdArray, range SourceRange)
		if not receiverWritingRuntimeCallee(callee) or (self.statement.drainingLoops > 0 and callee.equals(ManagedVacateName)) 'nothingWritten'
			return
		end 'nothingWritten'

		let written = try args.get(writtenOperandOf(callee)) otherwise return

		if self.valueIsAValueType(written) or self.effectiveCapabilityOf(written) == ValueCapability.immutable 'judgedElsewhere'
			return
		end 'judgedElsewhere'

		let root = self.rootValueOf(written)

		if self.valueSettlesAfterParsing(root) 'settledAfterParsing'
			self.noteDeferredResultWrite(root, fieldName: "a container", placeText: "a call result", line: range.line, column: range.column)
			return
		end 'settledAfterParsing'

		if self.effectiveCapabilityOf(written) != ValueCapability.paused 'writable'
			return
		end 'writable'

		self.deferRegionRefusal(ErrorCode.semanticWriteThroughReadOnly, message: "cannot write through a read-only value{readOnlyReasonSuffix(self.readOnlyReason())}", line: range.line, column: range.column)
	end 'deferWriteThroughReadOnlyReceiver'

	function emitRuntimeCallInto(result ValueId, callee ByteArray, args ValueIdArray, range SourceRange, argLabels NameRoster) returns ValueId
		// The index the op below will occupy — read before the append, so the ROUTING hook after it names an
		// op rather than re-deriving "the last one" from a block whose contents it does not own.
		let opIdx = self.artifact.module.ops.count()
		self.deferWriteThroughReadOnlyReceiver(callee, args: args, range: range)

		// `notMinted`: a runtime entry's callee is not the author's bytes either, but its noun is a question
		// about the NAME — `GtRuntime.runtimeCalleeSourceMethod` answers it, keyed by name, and may be. Only the
		// primitive-static mint needs the per-SITE bit. See `CalleeMint`.
		self.emitDirectCallOp(MaxonOp.call(result, callee: callee, args: args, argLabels: argLabels, argRanges: uniformArgRanges(args, range: range), argImmutableNames: NameRoster.create(0), mint: CalleeMint.notMinted), callee: callee, callResult: result, args: args, argLabels: argLabels, range: range)

		// The call door for every compiler-emitted callee, which is how `arr.get(i)`, `map.get(k)` and a
		// checked divide reach an enclosing `try` block or a test body's implied handler. It declines on
		// two field reads when neither encloses the call, which is every call in almost every program.
		//
		// `result` is handed over although nothing has enrolled it yet: a runtime call's managed result
		// is tracked by its caller after this returns (`emitContainerElementAccessor`), so the router's
		// pending-list test answers false here. Passing it makes "a routed op's own result never rides
		// the error edge" hold at every door by statement, so a door that enrols before emitting is
		// correct too.
		self.routeBareThrowingCall(callee, opIdx: opIdx, result: result)
		return result
	end 'emitRuntimeCallInto'

	// A void `__mm_incref` of `value`: the one spelling of "take a second owner of this box in place".
	// `__mm_retain` is the returning twin (`retainBorrowedAggregate`) for when a fresh SSA name is
	// needed; this form is for when the caller already holds the ValueId it means.
	//
	// ⛔ **BOTH RETAIN DOORS ASK `ProgramSignatures.retainCalleeOf`, and `result` is which shape they
	// need** — this one retains for effect, `emitRetainCall` needs a fresh SSA name for the same box.
	// A door that spells `__mm_retain` itself frees a live cown when the value is a handle
	// (`specs/services.md`, `a-handle-read-out-of-an-array-survives-a-second-send`).
	function emitIncref(value ValueId, range SourceRange)
		if self.valueIsImmortalFunction(value) 'anImmortalRecord'
			return
		end 'anImmortalRecord'

		self.emitOwnershipRuntimeCall(self.signatures.retainCalleeOf(self.tagOf(value), nameId: self.valueNameId(value), from: self.artifact.typeNames, result: RetainResult.discarded, readerFilePath: self.job.path), args: argsOf(value), range: range)

		// ⭐ **AND THE OP IS THE FACT: after this line `value`'s allocation has two owners.** The mark rides
		// here rather than at the named doors above because that is what makes it unforgettable — see
		// `markValueCoOwnsHeap`.
		self.markValueCoOwnsHeap(value)
	end 'emitIncref'

	// ⭐ **THE ONE `__mm_alloc` CALL.** Every heap box the compiler builds — a struct record, a fused
	// String record, an interpolation scratch buffer, a boxed union — is allocated through here, so the
	// `__mm_alloc(size, destructor)` ABI lives in exactly ONE place: the destructor is the SECOND
	// argument, and a box whose contents cascade to nothing passes `TrivialDestructor`. An added or
	// reordered alloc argument that reached three of those call sites and missed the fourth would
	// corrupt that box silently — nothing but this consolidation forces the four to agree. `size` is an
	// already-emitted value (a size literal, or the interpolation length sum), so the caller decides how
	// it is computed; and enrolling the result as an owned temp is the caller's decision too (a struct
	// box is not tracked, a union and an interpolation String are), so `trackOwnedTemp` stays at the
	// call site rather than hiding in here.
	// ⭐ `tag` is the mm-trace label for a box that is NOT any declared type's — `MmTag.Untagged` for every
	// box whose type the LOWERING can name from `resultTag`/`resultNameId`, which is the common case. It is
	// recorded against the `__mm_alloc` call op immediately below, and read by nothing but
	// `LowerMaxonToStd.allocTagIndexOf`. See `Project.allocTagSites` for why it travels beside the type
	// rather than in it.
	function emitBoxAlloc(size ValueId, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange, tag MmTag = MmTag.Untagged) returns ValueId
		return self.emitBoxAllocWithDestructor(size, destructor: self.emitLiteral(TrivialDestructor, valueType: MaxonType.integer, range: range), resultTag: resultTag, resultNameId: resultNameId, range: range, tag: tag)
	end 'emitBoxAlloc'

	function emitBoxAllocWithDestructor(size ValueId, destructor ValueId, resultTag ValueTypeTag, resultNameId TypeNameId, range SourceRange, tag MmTag) returns ValueId
		let allocArgs = ValueIdArray.create(2, zeroed: false)
		allocArgs.push(size)
		allocArgs.push(destructor)

		// ⚠ IMMEDIATELY BEFORE the call is emitted, and it must be: the recorder keys on "the op the very
		// next append creates", which is exactly the index `emitRuntimeCall` reads for the same op. An
		// intervening emit would tag a literal instead of the allocation.
		self.recordAllocTag(tag)
		return self.emitRuntimeCall(MmAllocName, args: allocArgs, resultTag: resultTag, resultNameId: resultNameId, range: range)
	end 'emitBoxAllocWithDestructor'

	// Record a box's mm-trace tag on the artifact, unless it has none to record. `Untagged` is the ordinary
	// answer and writing it would fill the sparse table with the entry its absence already means.
	function recordAllocTag(tag MmTag)
		match tag 'tag'
			Untagged then return
			StringRecord or
			ArrayRecord or
			ElementBuffer or
			CString or
			ListRecord or
			ListNode or
			CursorRecord or
			FileBox or
			DirectoryBox or
			InterpolationScratch or
			ClosureEnv or
			ParameterCell or
			AsyncArgumentImage or
			ServiceStartRecord then break
		end 'tag'

		self.artifact.recordAllocTagSite(tag)
	end 'recordAllocTag'

	// ⭐ **TRACK AN OWNED HEAP TEMPORARY.** The one door `emitStringInterp` reaches ownership through:
	// it records the value's provenance (so `parseBinding` knows the binding owns a drop) AND enrolls it in
	// the statement's pending-drop list (so an UNBOUND result is dropped at statement end). Both from one
	// call, so the two facts — "this value owns heap" and "someone must drop it" — cannot be set apart.
	//
	// ⚠ **`exclusivity` IS THREADED RATHER THAN ASSUMED, AND THIS DOOR IS EXACTLY WHY IT HAD TO BE.** Its
	// header read "a FRESH owned heap temporary" for as long as most of its callers were allocations, and three
	// of them are not: a `try … otherwise` result phi, a `match` result phi, and `coOwnAggregateAsTemp`, which
	// increfs somebody else's box. A door that had baked `sole` in here would have handed a stolen slot to each
	// of those. See `OwnedHeapExclusivity`.
	function trackOwnedTemp(value ValueId, exclusivity OwnedHeapExclusivity)
		self.markValueOwnsHeap(value, exclusivity: exclusivity)
		self.bodyState.pendingTempDrops.push(value)

		if self.valueIsLinear(value) 'aLinearTemporary'
			self.bodyState.anyLinearOwned = true
		end 'aLinearTemporary'
	end 'trackOwnedTemp'

	// ⭐ **`trackOwnedTemp`'s EXACT INVERSE — the value is no longer a managed temporary at all.** Its
	// one caller is `foldByteViewIntoStreamWrite`, which rewrites the call that PRODUCED the byte-view record
	// INTO the write that consumed it: there is no record any more, so both halves of the enrolment have to
	// go. Dropping only the pending entry would leave `valueOwnsHeap` set on what is now an integer byte
	// count, and a `let n = __Builtins.writeStdout(…)` would then bind a value the scope exit tries to
	// DECREF — which is why this is the inverse of the whole two-step and not of its second half.
	//
	// ⚠ It is NOT a general "cancel an ownership" door and must not become one: releasing a temporary whose
	// record still EXISTS is a leak. The caller's obligation is that the producing op is gone.
	function releaseOwnedTemp(value ValueId)
		try self.bodyState.valueOwnsHeap.set(value, value: false) otherwise panic("releaseOwnedTemp: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")
		try self.bodyState.valueMintedSole.set(value, value: false) otherwise panic("releaseOwnedTemp: v{value}{SoleOwnershipSlotPanicTail}")

		// The exclusivity claim goes with the ownership it qualified — see `markValueCoOwnsHeap`.
		self.markValueCoOwnsHeap(value)
		self.removeFromPendingTemps(value)
	end 'releaseOwnedTemp'

	// Set `value`'s owned-heap provenance bit WITHOUT enrolling it as a statement-scoped pending temporary
	// — the half of `trackOwnedTemp` a CONSUMED PARAMETER needs. The param already drops at
	// FUNCTION scope exit through `ownedBindings` (or is skipped once moved into a field), so adding it to
	// `pendingTempDrops` too would drop it a SECOND time at the enclosing statement's end — the double-free
	// that made `Outer.create(inner)` free its own field. A temporary, by contrast, IS statement-scoped and
	// wants both.
	//
	// ⭐⭐ **THE ONE WRITER OF THE OWNED BIT, WHICH IS WHY THE EXCLUSIVITY ARGUMENT IS REQUIRED HERE.** Every
	// door that makes a value owned passes through this line, so a required `exclusivity` is a question no
	// producer — present or future — can leave unanswered: the compiler refuses the call. See
	// `OwnedHeapExclusivity` for what the two answers mean and for the six segfaults that came of having only
	// one bit to say them with.
	function markValueOwnsHeap(value ValueId, exclusivity OwnedHeapExclusivity)
		try self.bodyState.valueOwnsHeap.set(value, value: true) otherwise panic("markValueOwnsHeap: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")

		match exclusivity 'howMany'
			sole then self.markValueMintedSole(value)
			coOwned then self.markValueCoOwnsHeap(value)
		end 'howMany'
	end 'markValueOwnsHeap'

	function markValueMintedSole(value ValueId)
		try self.bodyState.valueOwnsHeapAlone.set(value, value: true) otherwise panic("markValueMintedSole: v{value}{SoleOwnershipSlotPanicTail}")
		try self.bodyState.valueMintedSole.set(value, value: true) otherwise panic("markValueMintedSole: v{value}{SoleOwnershipSlotPanicTail}")
	end 'markValueMintedSole'

	// ⭐⭐ **SOMETHING ELSE OWNS THIS ALLOCATION TOO — the one write of `false` into the exclusivity column**,
	// shared by the three statements that mean it: an ownership RELEASED (`releaseOwnedTemp` — a value that owns
	// nothing is the sole owner of nothing, and a stale `true` would be a destructive-move licence on an
	// integer), an ownership DECLARED co-owned by its producer (`markValueOwnsHeap`), and an ownership
	// DOWNGRADED by an incref.
	//
	// ⭐ **THE DOWNGRADE IS AUTOMATIC WHERE THE OTHER TWO ARE DECLARED, AND THAT IS THE POINT.** A value marked
	// `sole` can STOP being sole later, so the downgrade is a property of the OP that mints the second owner
	// rather than of the doors that reach it — the only form of it that cannot be forgotten. **EVERY such op
	// calls this on its SOURCE, and there are FIVE of them, not one:**
	//
	//   • `emitIncref` — `__mm_incref` in place (a consuming argument co-owning a borrow, a `try … otherwise`
	//     phi edge).
	//   • `emitRetainCall` — `__mm_retain`, the RETURNING twin, which mints a fresh name for the same box.
	//   • `retainBorrowedByteRecord` — `__str_retain`, an incref on its heap branch.
	//   • `emitRetainExistentialCall` — `__retain_existential`, an incref through the witness.
	//   • `coOwnBorrowedOpaque` — `__retain_typeparam`, an incref through the instance descriptor.
	//
	// ⛔ **THE LIST IS COMPLETE, AND IT MUST STAY COMPLETE.** The four ops after `emitIncref` are latent rather than
	// live (their sources are gated borrowed, or are records with no nullable slot), and a sentence claiming
	// completeness is load-bearing only while it is true.
	//
	// The reverse direction has no door at all: nothing may promote a co-owner to sole, because a decref this
	// frame emits cannot be known to be the allocation's last.
	function markValueCoOwnsHeap(value ValueId)
		try self.bodyState.valueOwnsHeapAlone.set(value, value: false) otherwise panic("markValueCoOwnsHeap: v{value}{SoleOwnershipSlotPanicTail}")

		// ⭐⭐ **AND THE FRESH-RETURN CLAIM GOES WITH IT, FOR THE `sole` CLAIM'S OWN REASON ONE LINE UP.**
		// `valueFromFreshReturn` says *"nobody but this frame owns this record"*, which every one of the five ops
		// that reach this line has just made false. Clearing it HERE rather than at those five sites is what makes
		// the downgrade unforgettable — the same argument this function's header makes for the exclusivity bit,
		// and the reason a sixth retain door cannot ship a movable value with two owners.
		try self.bodyState.valueFromFreshReturn.set(value, value: false) otherwise panic("markValueCoOwnsHeap: v{value} has no fresh-return slot — every SSA value must be minted through mintValue, which seeds the column")
		self.noteCellOccupantCoOwned(value)
	end 'markValueCoOwnsHeap'

	function noteCellOccupantCoOwned(value ValueId)
		self.raiseCellOccupantExclusivity(value, to: CellOccupantExclusivity.coOwned)
	end 'noteCellOccupantCoOwned'

	function raiseCellOccupantExclusivity(value ValueId, to CellOccupantExclusivity)
		let read = try cellOccupantReadOf(self.bodyState.cellOccupantReads, occupant: value) otherwise return
		self.raiseCellEpochExclusivity(read.epoch, to: to)
	end 'raiseCellOccupantExclusivity'

	// ⭐ **MARK A VALUE AS THE SOLE REFERENCE TO A RECORD NO OTHER FRAME OWNS.** Set on a call result
	// by `emitCall` — the one line every direct, method and static call passes with the callee's NAME
	// in hand, which is what the whole-program summary is keyed by — and carried onto a merged
	// binding's phi when every incoming is solely owned here (`mintPhiForBinding`,
	// `pushMergedEdgeValue`).
	//
	// ⚠ **IT MUST RUN AFTER `enrolOwnedCallTemp` AND IT DOES.** That door marks a call result `coOwned`, which
	// goes through `markValueCoOwnsHeap` — the very line that CLEARS this bit. Ordered the other way the mark
	// would be erased by the enrolment that follows it, silently, and every send of a factory result would be
	// refused rather than moved.
	function markValueFromFreshReturn(value ValueId)
		try self.bodyState.valueFromFreshReturn.set(value, value: true) otherwise panic("markValueFromFreshReturn: v{value} has no fresh-return slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'markValueFromFreshReturn'

	// ⭐⭐ **SOLE OWNERSHIP AS A SEND NEEDS IT — `valueIsSoleHeapOwner` OR the one-level fresh-return summary.**
	// The two claims answer one question through different evidence: the column says THIS FRAME allocated the
	// record, and the summary says the CALLEE that handed it back allocated it in its own `return` and could not
	// have kept a reference. A send is satisfied by either; the two destructive move-outs are not, which is why
	// this is a door of its own rather than a widening of the column (see the field header).
	function valueIsSolelyOwnedHere(value ValueId) returns bool
		// A payload-free word owns nothing, so it is trivially sole; refusing it would reject a service
		// method that returns it beside a constructed word.
		if self.valueIsAPayloadFreeWord(value) 'aPayloadFreeWord'
			return true
		end 'aPayloadFreeWord'

		if self.valueIsHeldByAnEnclosingLoop(value) 'aLoopIteratesIt'
			return false
		end 'aLoopIteratesIt'

		if self.valueIsSoleHeapOwner(value) 'allocatedInThisFrame'
			return true
		end 'allocatedInThisFrame'

		return try self.bodyState.valueFromFreshReturn.get(value) otherwise panic("valueIsSolelyOwnedHere: v{value} has no fresh-return slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'valueIsSolelyOwnedHere'

	// Mark `value` as an `async` spawn's promise handle.
	function markValuePromise(value ValueId)
		try self.bodyState.valuePromiseMarks.set(value, value: true) otherwise panic("markValuePromise: v{value} has no promise slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'markValuePromise'

	// ⭐⭐ **"IS THIS A PROMISE?" AND "DOES THIS FRAME OWN A GREEN THREAD?" ARE TWO QUESTIONS, AND
	// COLLAPSING THEM BACK IS A DOUBLE FREE.**
	// A promise's storage is what separates them:
	//
	//   • `valueIsPromise` — **may this be `await`ed?** True for a spawn's handle AND for a value whose TYPE
	//     is a `Promise with (T[, E])`, because the storage type carries everything the await needs.
	//   • `valueOwnsGreenThread` — **does THIS frame owe a `__gt_promise_drop`?** The MARK alone. A promise
	//     read back out of a container wears no mark: the container holds the handle, this frame merely read
	//     it, and enrolling it here would drop a thread the container still names. What accounts for such a
	//     read is the slot it came from (`promiseSlotContainer`), which is a third answer and not this one.
	//
	// ⇒ every OWNERSHIP door (the binding enrolment, the re-arm, `decrefCalleeFor`, the merge phi) asks the
	// second; the two AWAIT doors — `emitAwait`'s throwing-promise gate and `emitAwaitOp`'s E2015 refusal —
	// ask the first.
	//
	// ⚠ **AND SO DOES A THIRD, WHICH IS A RECLAIM: `methodCallCancelsAPromise`, the `p.cancel()` gate.** It
	// asks `valueIsPromise` DESPITE reclaiming, and that is the right question rather than an oversight — the
	// ownership question would answer "no" for a promise read back out of a container, and `p.cancel()` on a
	// stored promise is precisely a thing the language allows. What `cancel` needs to know is "is this a
	// promise at all", exactly as `await` does; what it does about the ownership half it does through
	// `consumePromiseThread`, at the site (see `emitPromiseCancel`).
	function valueOwnsGreenThread(value ValueId) returns bool
		return try self.bodyState.valuePromiseMarks.get(value) otherwise panic("valueOwnsGreenThread: v{value} has no promise slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'valueOwnsGreenThread'

	function valueIsPromise(value ValueId) returns bool
		return self.valueOwnsGreenThread(value) or typeIsPromiseStorage(self.signatures, t: self.typeOf(value))
	end 'valueIsPromise'

	// ⭐ **THE ONE DEFINITION OF "OWNED": does `value` own a droppable heap allocation it must transfer or
	// drop?** The single predicate the DECLARATION (`parseBinding`), the REASSIGNMENT
	// (`reassignBindingValue`), the RETURN move-out, and the match `gives` transfer all ask, so none of
	// them can drift on what enrols a binding in `ownedBindings`. It is PROVENANCE, never the type tag —
	// see `valueOwnsHeap`'s header for why the tag cannot answer:
	//
	//   • a String's tag conflates an owned heap copy with a borrowed immortal rdata literal;
	//   • a struct/boxed-union tag (`structRef`/`named`) conflates a fresh OWNED box with a BORROWED
	//     PARAMETER — a struct param is `structRef` and a union param `named`, and neither owns anything.
	//     A borrowed aggregate treated as owned would make `let q = a` (re-borrow of a struct param) move
	//     ownership out of a borrow and free it twice — the cross-call double-free this bit exists to
	//     avoid. The bit says NO for a param (`bindParameters` never sets it) and YES for every owned box.
	//
	// So the bit is the whole answer, uniformly across String / struct / union: it is set at every owned
	// heap PRODUCER and nowhere else, through one of the two doors that set it —
	//   • `trackOwnedTemp` (bit + a STATEMENT-scoped drop obligation) — an interpolation, a promotion, a
	//     struct literal, a boxed-union construct, an owned call result;
	//   • `markValueOwnsHeap` (the bit ALONE) — a value whose drop is owed by a BINDING or by the caller
	//     instead, so a pending-temp entry would drop it twice: a consumed parameter, a `for` loop value, a
	//     managed payload bound out of a union (`ownPayloadBinding` — moved out of an owned one or retained
	//     out of a borrowed one), a thrown field, a closure env.
	// An O(1) column read, seeded `false` by `mintValue`/`recordValueType`. The day a third owned heap kind
	// (an owned array) lands, its producer calls one of those two and this answers for it too — no arm to
	// add, because the bit already means exactly "owns droppable heap".
	function valueIsOwnedHeap(value ValueId) returns bool
		return try self.bodyState.valueOwnsHeap.get(value) otherwise panic("valueIsOwnedHeap: v{value} has no owned-heap slot — every SSA value must be minted through mintValue, which seeds the column")
	end 'valueIsOwnedHeap'

	// ⭐⭐⭐ **THE STRICTER QUESTION — is `value`'s allocation owned by THIS FRAME AND NOBODY ELSE?** The
	// predicate the two DESTRUCTIVE transfers ask, and the only two: `declarePayloadBindings` before nulling a
	// payload slot, `emitThrowError` before nulling a thrown field's slot. Both write through a box they will
	// never read again, so both need a promise about every OTHER reader of that box — which is precisely what
	// `valueIsOwnedHeap` does not make.
	//
	// ⛔ **DO NOT REACH FOR THIS ANYWHERE ELSE WITHOUT THE SAME ARGUMENT.** A drop, a move poison, a
	// reassignment's move-vs-copy and a hand-off are all correct for a CO-OWNER — each releases exactly the one
	// reference this frame holds — so asking soleness there would refuse or leak on programs that are fine.
	// The distinguishing property is not "does this touch ownership" but "does this write into a slot whose
	// other readers this frame cannot enumerate".
	//
	// ⭐ **A THIRD READER SHARES THAT ARGUMENT: `valueIsSolelyOwnedHere`**, the send's transfer gate. A send
	// does not write into a slot — it hands the record to ANOTHER GREEN THREAD, where an owner this frame cannot
	// enumerate would be left behind stepping a count the service steps too. Same promise, one hazard over; it
	// asks this predicate rather than the column, and admits ONE further shape of its own (a callee's
	// proven-fresh return), which is why it is a door beside this one rather than an edit to it.
	function valueIsSoleHeapOwner(value ValueId) returns bool
		return self.valueIsOwnedHeap(value) and try self.bodyState.valueOwnsHeapAlone.get(value) otherwise panic("valueIsSoleHeapOwner: v{value}{SoleOwnershipSlotPanicTail}")
	end 'valueIsSoleHeapOwner'

	// ⭐⭐ **WHAT A RESULT PHI INHERITS FROM ITS EDGES — sole ONLY if every edge is.** A phi is one name for a
	// value several paths produced, so a destructive move-out through it is sound only where it is sound on ALL
	// of them; one co-owning edge makes the whole merge a co-owner. That is the same conservative direction
	// `joinMergeCapability` takes at the same two merges and for the same structural reason — the
	// alternative licenses the theft on precisely the path that shares the box.
	//
	// Its two callers are the two constructs that merge an OWNED value: a `match`/ternary result
	// (`finalizeMatchMerge`) and a `try … otherwise <expr>` result (`finishValueTry`). An EMPTY edge list is a
	// caller error rather than a vacuous `sole`: "every edge is sole" is trivially true of no edges, and this is
	// the file where an unearned `sole` costs a segfault.
	function enrolOwnedPhi(phi ValueId, edges ValueIdArray)
		self.trackOwnedTemp(phi, exclusivity: self.mergedHeapExclusivity(edges))
		self.carryFreshReturnToPhi(phi, edges: edges)
	end 'enrolOwnedPhi'

	function carryFreshReturnToPhi(phi ValueId, edges ValueIdArray)
		for edge in edges 'each'
			if not self.valueIsSolelyOwnedHere(edge) 'thisPathSharesIt'
				return
			end 'thisPathSharesIt'
		end 'each'

		self.markValueFromFreshReturn(phi)
	end 'carryFreshReturnToPhi'

	function mergedHeapExclusivity(edges ValueIdArray) returns OwnedHeapExclusivity
		if edges.isEmpty() 'nothingToJoin'
			panic("mergedHeapExclusivity: asked to join an EMPTY edge list — a phi has at least one incoming value, and answering `sole` for none would be an ownership claim nothing established")
		end 'nothingToJoin'

		for edge in edges 'each'
			if not self.valueIsSoleHeapOwner(edge) 'thisPathSharesIt'
				return OwnedHeapExclusivity.coOwned
			end 'thisPathSharesIt'
		end 'each'

		return OwnedHeapExclusivity.sole
	end 'mergedHeapExclusivity'

	// ⭐ **IS `value` AN ENROLLED OPAQUE OWNED type-parameter binding?** A consumed opaque
	// ARRAY-feed parameter, enrolled owned in a shared generic body (`bindParameters`): its `typeParameter`
	// tag is opaque (the shared body has no static type) yet it owns heap for a managed instantiation. THE one
	// predicate the forward-consume GATE (`isOpaqueOwnedFeedArg`) and the forward TRANSFER
	// (`transferConsumedArg`'s opaque arm) both read, so the "what is an opaque owned value" question is
	// answered once and the two cannot drift into moving different things (a wrong-consume double-free).
	function valueIsOpaqueOwned(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.typeParameter and self.valueIsOwnedHeap(value)
	end 'valueIsOpaqueOwned'

	function markPhiImmortalIfEveryEdgeIs(phi ValueId, edges ValueIdArray)
		var everyEdgeIsAFunction = not edges.isEmpty()
		var everyEdgeIsAnImageRecord = not edges.isEmpty()

		for edge in edges 'eachEdge'
			everyEdgeIsAFunction = everyEdgeIsAFunction and self.valueIsImmortalFunction(edge)
			everyEdgeIsAnImageRecord = everyEdgeIsAnImageRecord and self.valueIsAnImmortalImageRecord(edge)
		end 'eachEdge'

		if everyEdgeIsAFunction 'everyEdgeIsAnImmortalFunction'
			self.markImmortalFunction(phi)
		end 'everyEdgeIsAnImmortalFunction'

		if everyEdgeIsAnImageRecord 'everyEdgeIsAnImageRecordRead'
			self.markImageRecordRead(phi)
		end 'everyEdgeIsAnImageRecordRead'
	end 'markPhiImmortalIfEveryEdgeIs'

	function valueNeedsNoHold(value ValueId) returns bool
		return self.valueIsImmortalFunction(value) or self.valueIsAnImmortalImageRecord(value)
	end 'valueNeedsNoHold'

	function markImmortalFunction(value ValueId)
		self.bodyState.immortalFunctionValues = withValueMarked(self.bodyState.immortalFunctionValues, value: value)
	end 'markImmortalFunction'

	function valueIsImmortalFunction(value ValueId) returns bool
		return valueIsMarked(self.bodyState.immortalFunctionValues, value: value)
	end 'valueIsImmortalFunction'

	// Ownership of `value` has been TRANSFERRED to a binding, so the statement no longer owes its drop:
	// remove it from the pending list. A filter-rebuild rather than a pop because, while the transferred
	// value is normally the last one pushed (a binding's initializer is the statement's final expression),
	// keying on identity rather than position is what stays correct if that ever stops holding.
	function removeFromPendingTemps(value ValueId)
		let kept = ValueIdArray.create(0)

		for pending in self.bodyState.pendingTempDrops 'each'
			if pending != value 'notTransferred'
				kept.push(pending)
			end 'notTransferred'
		end 'each'

		self.bodyState.pendingTempDrops = kept
	end 'removeFromPendingTemps'

	// ⭐⭐ **RELEASE WHAT BUILDING A HAND-OFF'S VALUES LEFT BEHIND, BEFORE THE HAND-OFF WALKS THEIR GRAPHS.** A
	// `spawn`'s state and a send's arguments are walked at run time at the hand-off, and
	// a record built on the way is an owner of what the walk reaches: a temporary a factory stored through a second
	// factory, or the temporary a field argument was borrowed out of (`giveTemporaryScopeLifetime` holds that one
	// to the SCOPE's exit). Nothing reads either once the calls that took them have returned, so both are
	// released here, where the statement's end or the scope's would leave them a second owner while the service
	// runs. The handed-off values themselves stay pending: their doors move them. So does a hold on a
	// handed-off operand (`HoldPolicy.survivesTheHandOff`), because the transfer reads it after this release.
	function releaseHandOffBuildTemps(tempFloor ElementIndex, ownedFloor ElementIndex, handedOff ValueIdArray, anchor Token)
		let kept = ValueIdArray.create(0)
		let released = ValueIdArray.create(0)

		for (iter, pending) in self.bodyState.pendingTempDrops.withIterator() 'each'
			if iter.index() < tempFloor or handedOff.contains(pending) or self.holdKindOf(pending).has(HoldPolicy.survivesTheHandOff) 'stillOwed'
				kept.push(pending)
			end 'stillOwed' else 'deadAfterItsCall'
				released.push(pending)
			end 'deadAfterItsCall'
		end 'each'

		self.emitTempDrops(released, floor: WholeStatementTempFloor, anchor: anchor)
		self.bodyState.pendingTempDrops = kept

		// A scope-lifetime record is the SOURCE of a borrow, never a handed-off value — releasing one of those would
		// free what the transfer below still reads.
		for i in ownedFloor upto self.bodyState.ownedBindings.count() 'eachHeldForTheBuild'
			let held = try self.bodyState.ownedBindings.get(i) otherwise panic("releaseHandOffBuildTemps: ownedBindings.get OOB at {i} on a walk bounded by its own count")

			if handedOff.contains(held.boundValue) 'handedOffIsHeld'
				panic("releaseHandOffBuildTemps: handed-off v{held.boundValue} is held by the scope-lifetime binding `{String.from(held.name)}` enrolled while its hand-off was built")
			end 'handedOffIsHeld'
		end 'eachHeldForTheBuild'

		self.dropArmScopedOwned(ownedFloor, exitBlock: self.bodyState.currentBlock, anchor: anchor)
	end 'releaseHandOffBuildTemps'

	// Is `value` still an UNCONSUMED owned temporary — a value `trackOwnedTemp` enrolled and nothing has
	// transferred to a binding yet? The two owned-value homes are disjoint by construction (a transfer to a
	// binding `removeFromPendingTemps` first — `parseBinding`/`moveInPayload`), so a value in this list is
	// exactly one owned by no binding. `parseMatchCommon` reads it to tell a temporary scrutinee (which
	// needs match-scoped enrollment) from an already-bound one (which does not).
	function pendingTempsContain(value ValueId) returns bool
		for pending in self.bodyState.pendingTempDrops 'each'
			if pending == value 'found'
				return true
			end 'found'
		end 'each'

		return false
	end 'pendingTempsContain'

	// ⭐⭐ **MOVE A TEMPORARY'S DROP FROM THE STATEMENT TO THE ENCLOSING SCOPE — the ONE promotion, and the
	// answer to every "this value is still being pointed into after the statement ends" question the parser
	// asks.** An UNCONSUMED owned temporary is freed by `drainPendingTemps` at the statement's tail; a
	// value some longer-lived thing still reaches must instead be freed at the scope frame's exit, and the
	// mechanism for that is already the ordinary one — a nameless entry in `ownedBindings`, which every exit
	// drops through (`emitFunctionExit` for a `return`/`throw` and for the frame's own end, the loop floor for a
	// `break`/`continue`). Exactly once on every path, which is what a hand-placed decref could not promise.
	//
	// ⚠ **THE GATE IS `pendingTempsContain`, NOT `valueIsOwnedHeap`, AND THE DIFFERENCE IS A DOUBLE FREE.** A
	// value a BINDING already owns is owned-heap too, and enrolling it a second time emits two decrefs of one
	// record (measured at the `for … in` site: `for x in arr` over a `var arr` segfaulted). The pending list is
	// precisely the owned values NO binding owns (`pendingTempsContain`), which is the question being asked —
	// so a non-temporary source is a silent, correct no-op and every caller may ask unconditionally.
	//
	// ⚠ **FIVE CALLERS**: the `for … in` SOURCE and, separately, the per-trip ELEMENT an `Iterable` cursor's
	// `current()` mints; the temporary `match` scrutinee; the box a member BORROW was taken off
	// (`dispatchMethodOnBase`); and the container an ARRAY element borrow was taken out of. All one fact —
	// *"something this frame holds points into this record after the statement ends"* — and one door, so no
	// copy does half of it.
	// ⛔ **STORAGE THAT OUTLIVES THE STATEMENT IS NOT THAT FACT.** It takes a reference of its own
	// (`handleEscapingBorrowFeed`); promoting the temporary as well leaves an extra owner until the scope's exit,
	// which a send of that storage refuses as an owner outside the moved graph.
	// `name` is inert (the binding is never installed in a `Scope`, so no source line can name it) and each
	// caller states its own, so a dump of `ownedBindings` still says WHY each nameless entry is there.
	function giveTemporaryScopeLifetime(value ValueId, name ByteArray)
		if not self.pendingTempsContain(value) 'notATemporary'
			return
		end 'notATemporary'

		self.removeFromPendingTemps(value)
		self.enrolOwnedBinding(VarInfo.createValueBinding(name, varType: self.typeOf(value), kind: BindingKind.let, boundValue: value))
	end 'giveTemporaryScopeLifetime'

	// ⭐ **THE OWNED-VALUE CLEANUP A `return <value>` AND A `throw <value>` SHARE** — the two exits that
	// HAND a heap value to the caller. Both must, in this exact order, drop every owned value this function
	// still holds EXCEPT the one in flight, then leave the function:
	//
	//   • MOVE the handed-off value out of the local drops — it leaves the pending-temp list (a
	//     freshly built `return U.case(x)` / `throw U.case(x)` temporary) and is passed to
	//     `emitFunctionExit` as the owned binding to exclude (a `return t` / re-thrown `throw e`
	//     caught binding), each a no-op on the other's case — so the caller becomes its sole owner
	//     and neither drop below frees it. A promise owns a
	//     green thread rather than heap, and is moved out the same way, or the callee would cancel the
	//     thread it returns. A no-op for a scalar.
	//   • DROP the exit expression's leftover TEMPORARIES: `return wrap("v{x}")` / `throw E.p(len("v{x}"))`
	//     build an interpolation this statement owns but does NOT hand back. The `count() > 0` guard is
	//     `drainPendingTemps`' own — almost no exit leaves a temporary, so the common exit pays nothing.
	//   • DROP every other owned BINDING in scope and LEAVE (`emitFunctionExit`). The handed-off
	//     binding stays in the owned-binding list: the list OUTLIVES this exit, and a SIBLING exit
	//     edge of an enclosing block still owns it on ITS runtime path (this exit terminated only its
	//     own).
	//
	// The drops land AFTER the caller computed the handed-off value (already a register read, no
	// longer a heap access) and BEFORE the exit's terminator (a terminator ENDS the block — anything
	// after it sits on a path control has left, and the value leaks: exit 101). Factoring the WHOLE
	// sequence, not just the move-out, is what keeps the two exits from drifting on it.
	function emitHandoffExit(exit FunctionExit, anchor Token)
		let handedOff = try exitValueOf(exit) otherwise panic("emitHandoffExit: a void return carries nothing to hand off")
		var inFlight = HandedOff.nothing

		if self.valueIsOwnedHeap(handedOff) or self.valueOwnsGreenThread(handedOff) 'movedOut'
			inFlight = HandedOff.value(handedOff)
			self.removeFromPendingTemps(handedOff)
		end 'movedOut'

		if self.bodyState.pendingTempDrops.count() > 0 'dropExitTemps'
			self.drainPendingTemps(WholeStatementTempFloor, anchor: anchor)
		end 'dropExitTemps'

		self.emitFunctionExit(self.bodyState.currentBlock, exit: exit, anchor: anchor, handedOff: inFlight)
	end 'emitHandoffExit'

	// Does `binding` currently owe a scope-exit drop — i.e. is it a LIVE owner in `ownedBindings`? The
	// reassignment path's test for whether the value being OVERWRITTEN is owned. It reads MEMBERSHIP,
	// not `valueIsOwnedHeap(binding.boundValue)`, and that distinction is the whole point: a
	// loop-carried `var`'s current value is a header phi with no owned-heap provenance, so the value
	// column would answer `false` for a binding the loop owns (see `reassignBindingValue`). Membership
	// survives the phi; the provenance bit does not.
	function bindingIsOwned(binding VarInfo) returns bool
		return self.hasLiveOwner(binding.boundValue)
	end 'bindingIsOwned'

	// True iff the RHS just parsed — the tokens in `[startPos, self.pos)` — RESOLVES TO a bare reference
	// to a LOCAL binding (`let u = t` / `s = t`, and equally `let u = (t)`). That is the ONLY RHS shape
	// that can MOVE an owned value out of an existing binding: it resolves to that binding's own SSA
	// value (`parseVariableReference` returns `binding.boundValue`), so `poisonMoveSource`'s value-keyed
	// scan can match it. Every other RHS — a call, an interpolation, a field read, any arithmetic —
	// mints a FRESH temp that is the value of no binding (a CONSUME), so the scan is guaranteed to find
	// nothing.
	//
	// A BARE read is a rooted span with no field steps, which is what `rhsBareLocalSourceName` answers with
	// — the chain grammar itself is written down once, at `rhsRootName`. This is that answer reduced to
	// a yes/no, for the callers that need only that.
	function rhsWasBareLocalReference(startPos ElementIndex) returns bool
		return self.rhsBareLocalSourceName(startPos).isLocal()
	end 'rhsWasBareLocalReference'

	// ⭐ **WHICH LOCAL A BARE-READ RHS NAMES — the same answer as `rhsWasBareLocalReference` with the NAME
	// KEPT**, `none` when the span is not one (a call, a field read, any expression). The two rules a
	// rebind asks need different halves of it: the MOVE model wants the bool (*can this poison
	// anything?*) and the immutable-alias rule wants the name (*was that local declared `let`?*).
	// Answered once so the two cannot disagree about which local the RHS was — a bool that said "bare
	// local" while the name walk said "no root" would move a value out of a binding nothing had named.
	function rhsBareLocalSourceName(startPos ElementIndex) returns SourceBinding
		if self.rhsSpanReadsAField(startPos) 'readsAField'
			return SourceBinding.none
		end 'readsAField'

		return self.rhsRootLocalName(startPos)
	end 'rhsBareLocalSourceName'

	function bindingTakesItsOwnReference(kind BindingKind, sourceName SourceBinding, value ValueId) returns bool
		if kind == BindingKind.let 'aLetAliasesOrMoves'
			return self.valueIsAnImmutableAggregate(value) and not self.valueIsAnOwnedIsolatedLocal(value) and not self.rebindSourceIsAnImmutableAlias(sourceName)
		end 'aLetAliasesOrMoves'

		let aVarTakesAnImmutableSource = kind == BindingKind.var
		return self.nameAliasesItsSource(kind, sourceName: sourceName, value: value) == aVarTakesAnImmutableSource
	end 'bindingTakesItsOwnReference'

	function nameAliasesItsSource(kind BindingKind, sourceName SourceBinding, value ValueId) returns bool
		return self.rebindSourceIsAnImmutableAlias(sourceName) and not (kind == BindingKind.var and self.writableRecordMovesOutOfALet(sourceName, value: value))
	end 'nameAliasesItsSource'

	function writableRecordMovesOutOfALet(sourceName SourceBinding, value ValueId) returns bool
		let sourceLocal = try sourceName.localName() otherwise return false
		let source = self.bodyState.scope.getInfo(sourceLocal)
		return not source.isMutable() and not source.isParameter and self.tagOf(value) != ValueTypeTag.function and not self.valueIsAnImmutableAggregate(value)
	end 'writableRecordMovesOutOfALet'

	// ⭐⭐ **AN IMMUTABLE REBIND IS A SECOND REFERENCE, NOT A MOVE (the ownership ruling, 2026-08-04) — the
	// ONE predicate BOTH rebind doors ask.** Maxon is single-ownership and everything is a reference; what
	// makes a second name for one value SAFE is that neither can be written through, which is MUTABILITY and
	// not linearity. So a bare read of a `let` never leaves its source moved-from, at a declaration
	// (`declareInitializedBinding`) or at an assignment (`reassignBindingValue`) alike.
	//
	// ⚠ **THE TWO DOORS AGREE ON THE RULE AND NOT ON WHAT IT COSTS, WHICH IS WHY THIS ANSWERS THE PREDICATE
	// AND NEITHER DOOR'S ACTION.** A DECLARATION's alias is free: the new name is declared inside the
	// source's scope, so the source structurally outlives it and keeps the ONE drop, and no refcount is
	// involved. An ASSIGNMENT's destination already exists at a scope depth this door cannot bound, and it
	// already owes a drop of its own — so it takes a real reference (`coOwnImmutableRebindSource`). Written
	// as one predicate at two doors the rule cannot drift; written as one ACTION it would have double-freed.
	//
	// A source with no name is no bare local read at all — `SourceBinding.none` is
	// `rhsRootLocalName`'s answer for it — so it is asked here rather than at each caller.
	function rebindSourceIsAnImmutableAlias(sourceName SourceBinding) returns bool
		let sourceLocal = try sourceName.localName() otherwise return false
		let source = self.bodyState.scope.getInfo(sourceLocal)
		return not source.isMutable() and not self.valueIsAnOwnedIsolatedLocal(source.boundValue) and not self.valueHoldsAUniqueRecord(source.boundValue)
	end 'rebindSourceIsAnImmutableAlias'

	// ⭐⭐ **WHICH NAME THE RHS SPAN IS ROOTED AT — the `t` of `t`, `(t)`, `t.x`, `t.0`, `(t).x`, `(t.x.y)` —
	// or `AbsentError` when the span is not a chain of members rooted at a name.** Whether that name is a
	// readable local is `localBindingNamed`'s question.
	//
	// ⭐ **TWO RULES ASK IT, AND THEY ASK DIFFERENT HALVES OF ONE QUESTION.** The MOVE model asks *"was
	// this a bare read of a local?"* (`rhsWasBareLocalReference` — only that shape can move an owned value
	// out of an existing binding, because only that shape resolves to the binding's own SSA value). And the
	// IMMUTABLE-ALIAS rule asks *"was that local declared `let`?"* (`rebindSourceIsAnImmutableAlias`), which
	// needs the NAME the first reduces away. One walk answers both, so the grammar of "a name, then field
	// steps" is written down once.
	//
	// ⚠ **PARENS ARE PART OF THE CHAIN GRAMMAR, and that is a soundness requirement, not tidiness.**
	// `parseParenthesizedExpression` returns its inner value UNCHANGED, so `(t)` / `((t))` alias the
	// same owned box a bare `t` does. A token-count-only gate (`self.pos == startPos + 1`) calls them
	// non-bare-local, so the poison never runs, both bindings drop the one box, and the double free is back.
	//
	// ⚠ **AND STRIPPING ONLY THE PAIR THAT WRAPS THE WHOLE SPAN IS NOT ENOUGH.** `(t).x` opens with a `(`
	// that no trailing `)` balances at the end of the span, so such a strip does not fire, the root token is
	// the `(`, and the answer is "no root": `var b = t.x` from an immutable `t` is refused while
	// `var b = (a).x` COMPILES and its `b.x = 99` writes through `t` (the oracle refuses both). So the walk
	// recognizes the whole postfix grammar instead — a run of opening parens, the root name, then hops and
	// closers in any order — which is the shape `parsePrimary` + `parsePostfix` actually accept. It
	// stays a SOUND over-approximation for the move half: every span it admits beyond a bare name contains a
	// `.`, so `rhsWasBareLocalReference` (which demands no field step) cannot see one of them.
	//
	// ⚠ **A HOP'S NAME IS `namesMemberAt`'s QUESTION, NOT `tokenCanBeAName`'s.** A copy of "what may follow
	// a `.`" spelled out here drifts: it misses the INT LITERAL of a tuple's positional access, so
	// `var a = t.0` escapes the same refusal `var a = t._0` receives — the same wrong answer, one spelling
	// over. The door that owns that question is asked instead.
	//
	// (`shiftCountAnchor` still carries the plain whole-span strip; see the note there for why the two are
	// deliberately not shared. They were never the same question — that one anchors a diagnostic on the token
	// the author wrote, and it wants the outermost paren gone and nothing else.)
	//
	// ⭐ **A GATE, NOT THE DECISION.** `poisonMoveSource` keeps the authority — given a bare-local RHS it
	// still matches the value against the owned set, so a bare local that is NOT owned (a scalar) still
	// poisons nothing. This only decides whether calling the poison can possibly do anything. Skipping it
	// when this is false is a no-op: the owner lookup cannot match a non-bare-local RHS.
	//
	// ⚠ **THE ROOT TOKEN MAY BE A KEYWORD, because a BINDING's name may be** — asked through
	// `tokenCanBeAName`, exactly as `consumedParamAfterColon` (the SWEEP's copy of this same question, and
	// its header names this routine) asks it. The two MUST agree, and the failure when they do not is a
	// wrong ANSWER: with the sweep saying "the callee consumes it" while this says "the RHS is not a bare
	// local", `Self{value: from}` inside `static function create(from String)` leaves the parameter
	// unpoisoned and the callee drops at scope exit what it has just stored into the field — a SEGFAULT on
	// `Box.create(msg)` where the identical program spelling the parameter `path` runs. It stays a
	// sound over-approximation: `localBindingNamed`'s `scope.contains`, and `poisonMoveSource`'s own
	// owned-set match, keep the authority.
	function rhsRootName(startPos ElementIndex) returns immutable ByteArray throws AbsentError
		let hi = self.pos
		var lo = startPos
		var openParens = 0 as Count

		while lo < hi and self.kindAt(lo) == TokenKind.leftParen 'stripOpeningParens'
			lo = lo + 1
			openParens = openParens + 1
		end 'stripOpeningParens'

		if lo >= hi 'emptySpan'
			throw AbsentError.absent
		end 'emptySpan'

		let tok = self.tokenAt(lo)
		let namesAConsumedReceiver = tok.kind == TokenKind.self and self.bodyState.consumesSelf

		if not tokenCanBeAName(tok) and not namesAConsumedReceiver 'notAName'
			throw AbsentError.absent
		end 'notAName'

		// Everything past the root must CONTINUE the chain — a `. member` hop, or a `)` closing one of the
		// parens the root was opened behind. A call's `(`, an operator, an index or a trailing method call
		// all mint a FRESH value that is the storage of no binding, which is precisely the case both askers
		// must exclude.
		var closeParens = 0 as Count
		var i = lo + 1

		while i < hi 'eachStep'
			if self.kindAt(i) == TokenKind.rightParen 'closesAWrap'
				closeParens = closeParens + 1
				i = i + 1
				continue
			end 'closesAWrap'

			if self.kindAt(i) != TokenKind.dot or i + 1 >= hi or not self.namesMemberAt(i + 1) 'notAMemberHop'
				throw AbsentError.absent
			end 'notAMemberHop'

			i = i + 2
		end 'eachStep'

		// Every paren the root sits behind must be closed by the end of the span. Fewer closers means the
		// `(` opened something this walk did not read — a call's argument list, a parenthesized operand —
		// and the span is then not rooted at the name it happens to start with.
		if closeParens != openParens 'parensDoNotWrapTheChain'
			throw AbsentError.absent
		end 'parensDoNotWrapTheChain'

		return SelfParamName if namesAConsumedReceiver else tok.value
	end 'rhsRootName'

	function rhsRootLocalName(startPos ElementIndex) returns SourceBinding
		let name = try self.rhsRootName(startPos) otherwise return SourceBinding.none
		return self.localBindingNamed(name)
	end 'rhsRootLocalName'

	// The root is excluded when it names a top-level binding (`scope.contains` false) or a self-field
	// alias (`isSelfField`, whose read mints a fresh load rather than aliasing a binding's value) —
	// neither is a live owned local the move scan would match. Those are the same two conditions `parseVariableReference` treats as a bare LOCAL
	// read, so the gate cannot diverge from what actually resolves to a binding's `boundValue` — parens
	// included, since a parenthesized read resolves through the very same `parseVariableReference`.
	function localBindingNamed(name ByteArray) returns SourceBinding
		if not self.bodyState.scope.contains(name) or self.bodyState.scope.isSelfField(name) 'notAReadableLocal'
			return SourceBinding.none
		end 'notAReadableLocal'

		return SourceBinding.local(name)
	end 'localBindingNamed'

	// Did the RHS span reach into a FIELD of its root rather than reading the root itself? A field step is
	// a `.`, and a bare name span cannot contain one — so this separates `t` from `t.x` without re-walking
	// the chain grammar `rhsRootName` owns. Spans here are a handful of tokens, so the scan is
	// cheaper than carrying a second return value out of that walk.
	function rhsSpanReadsAField(startPos ElementIndex) returns bool
		var i = startPos

		while i < self.pos 'eachToken'
			if self.kindAt(i) == TokenKind.dot 'fieldStep'
				return true
			end 'fieldStep'

			i = i + 1
		end 'eachToken'

		return false
	end 'rhsSpanReadsAField'

	// ⭐ **MOVE THE VALUE OUT OF ITS CURRENT OWNER.** If `value` is the current value of a LIVE owned
	// binding — i.e. the RHS of a bind/assign was a bare reference to that binding (`let u = t`) — mark
	// that source `movedFrom`, so a later read of it is use-after-move (E3102) and `scopeReleasesAbove`
	// skips its drop (only the new owner drops the value). A fresh owned temp (`build()`, `"{x}"`) is
	// the value of no binding, so nothing is poisoned — that is a CONSUME (move-in), not a
	// source-poisoning move.
	//
	// Finds the ONE live owner via `liveOwnerIndexOf` (the same lookup `bindingIsOwned` reads), so a
	// value already moved once — a `movedFrom` ghost — can never be picked as a live source. **The
	// callers GATE it on `rhsWasBareLocalReference`**, so it runs only when the RHS actually was a bare
	// local reference — never on a consume.
	//
	// ⚠ **A MOVE OF A BINDING DECLARED OUTSIDE THE INNERMOST LOOP IS REJECTED HERE** (`anchor` positions the
	// diagnostic). The path-sensitive drop reconciliation (`reconcileMovesAtMerge`) settles an `if`/`match`
	// join, but a LOOP has two exits the join model does not reach: the back edge (which would re-move the
	// binding on the next iteration — a double-free) and a `break` (which leaves the binding live on the
	// normal exit while giving it away on the break edge — a leak or, once the join restores the sibling
	// path, a double-free). Placing the compensating drop on those edges needs elaboration across the loop
	// boundary, so a move that escapes the innermost loop is refused rather than
	// miscompiled. A binding declared INSIDE the loop body (index at or above the loop's owned floor) is
	// reconciled within the body, once per iteration, and is unaffected.
	// ⭐ **`await`/`try await` CONSUMES a promise's green thread — the DUAL of the E3100 linear-
	// await check.** The runtime driver (`__gt_await`/`__gt_try_await`) reclaims the GT struct AT the await, so
	// the thread must NOT also be dropped at scope exit — mark its owning binding `movedFrom` (the scope-exit
	// drop then skips it, exactly as an owned box moved by `let u = t` is skipped), and clear it from the
	// pending-temp list (an UNBOUND awaited spawn, `await async f()`). Keyed on the thread's ValueId — its
	// identity — so awaiting through ANY alias consumes the one thread (`let q = p; await q` consumes `p`'s
	// thread). An unbound-and-unowned promise has no owner to mark, so the scan quietly finds nothing, which is
	// correct — the pending-temp clear is all it needs. Unlike `poisonMoveSource`, it does NOT reject a move
	// that escapes a loop: a promise spawned outside a loop and awaited inside is already E3100 (double-await
	// across the back-edge), so it never reaches lowering, and marking its (outer) owner here is harmless.
	// ⭐⭐ **A PROMISE NOBODY OWNS MAY NOT BE CONSUMED.** Three states are legitimate at a consume: this frame
	// OWNS the thread (a spawn, a move-out, a promise parameter — the mark), or it holds a live pending move
	// out of a container slot (the slot columns), or it is a value derived from one of those. A promise with
	// NEITHER is one the compiler cannot account for, and consuming it reclaims a thread something else still
	// names.
	//
	// ⛔ **THE SHAPE THIS CATCHES IS A MERGE.** `var p = try s.get(0)…; if c  p = try s.get(1)… end; await p`
	// hands the await a PHI, and a phi is minted with the slot columns seeded NOT-SET — there is no single
	// slot to carry, because the two edges name different ones. Finishing the move would need a store in each
	// predecessor block, and the merge layer builds edge-argument LISTS with no per-edge emission context; a
	// vacate emitted anyway landed in whichever block was current, emptied BOTH slots, and orphaned the
	// untaken edge's thread — measured, still exit **75**. So the construct is cleanly refused rather than
	// half-tracked, and the cure is to consume before the join.
	//
	// Every door that spends a promise asks it, not only the two that reclaim. `await` and `cancel`
	// hand the thread back to the runtime; a store into a container, a field or a union case, an
	// argument at a position the callee takes, and an `otherwise` fallback merged into a `try`'s phi
	// hand it to another owner; a `return` hands it to the caller
	// (`requireReturnedPromiseIsNotABorrow`). A promise no frame can account for is as wrong at one as
	// at another.
	// `async-promise-drop.error.cancel-a-promise-no-frame-owns` pins the second door against the first.
	//
	// `door` is a NOUN the caller supplies rather than a `PromiseConsume`: the reclaiming pair have keywords
	// (`promiseConsumeDoorName`), while a give-away door is best named by the token the author actually
	// wrote — `push`, the field name, the callee.
	function requireConsumedPromiseIsOwned(promise ValueId, anchor Token, door ByteArray) throws SourceParseError
		if self.promiseIsAccountedFor(promise) 'accountedFor'
			try self.requireConsumedSlotIsWritable(promise, anchor: anchor)
			return
		end 'accountedFor'

		throw self.unownedPromiseRefusalOf(promise, anchor: anchor, door: door)
	end 'requireConsumedPromiseIsOwned'

	function requireConsumedSlotIsWritable(promise ValueId, anchor Token) throws SourceParseError
		let container = try self.carriedContainerSlotOf(promise) otherwise return

		if let fieldName = try self.bodyState.letFieldPromiseReads.get(promise) 'aLetFieldsSlot'
			throw SourceParseError.assignToImmutableField(fieldName, line: anchor.line, column: anchor.column)
		end 'aLetFieldsSlot'

		if self.effectiveCapabilityOf(container) == ValueCapability.immutable 'anImmutableHolder'
			throw self.regionRefusal(ErrorCode.semanticWriteThroughReadOnly, message: "cannot consume a promise held in immutable data: consuming empties the slot it is held in", line: anchor.line, column: anchor.column)
		end 'anImmutableHolder'
	end 'requireConsumedSlotIsWritable'

	function unownedPromiseRefusalOf(promise ValueId, anchor Token, door ByteArray) returns SourceParseError
		if valueIsMarked(self.bodyState.capturedPromiseReads, value: promise) 'theClosuresOwnCapture'
			return capturedPromiseRefusal(SourceRange.ofToken(anchor), door: door)
		end 'theClosuresOwnCapture'

		return unownedPromiseRefusal(anchor, door: door)
	end 'unownedPromiseRefusalOf'

	function promiseIsAccountedFor(promise ValueId) returns bool
		return self.valueOwnsGreenThread(promise) or self.promiseValueCarriesAContainerSlot(promise)
	end 'promiseIsAccountedFor'

	//
	// ⭐⭐ **AND IT RECORDS THE CONSUME AGAINST THE THREAD, WHICH IS WHAT REFUSES THE NEXT USE OF ANY NAME
	// FOR IT (E3142).** The `movedFrom` bit above answers "does this BINDING still owe a drop?", and
	// that is all it can answer: an alias (`let q = p`) enrols no owned binding, so there is no bit of `q`'s
	// to set. The record is keyed on the thread's `ValueId` instead — the identity every name for it shares
	// — so `PromiseConsumes.kindOf` answers for the spawner and for each alias with one entry, and the path-
	// sensitive machinery rewinds ONE list rather than an unbounded set of names.
	//
	// `reclaimedBy` is which door handed the thread back to the RUNTIME. `notConsumed` is the honest answer
	// for the third caller, `transferConsumedArgs`: a promise ARGUMENT moves to another OWNER, which is not
	// a reclaim and leaves the thread perfectly alive — so a later use of the source is an ordinary
	// use-after-move (E3102, *"its ownership moved to another binding"*), which is exactly what it is.
	function consumePromiseThread(promise ValueId, range SourceRange, reclaimedBy PromiseConsume)
		// ⭐⭐ **FIRST, BECAUSE THE SLOT MUST BE EMPTIED BEFORE ANYTHING ELSE CAN DROP IT.** If this promise
		// was read out of a container, the frame has just finished MOVING it out; the container must stop
		// naming it or its element walk reclaims a thread this consume already reclaimed.
		//
		// ⛔ **AND BEFORE THE RECORD BELOW, NOT AFTER.** A recorded consume is what makes
		// `promiseValueCarriesAContainerSlot` answer false, so recording first would suppress this frame's
		// own vacate and leave the slot naming a thread this consume just spent.
		self.vacateConsumedPromiseSlot(promise, range: range, reclaimedBy: reclaimedBy)

		if reclaimedBy != PromiseConsume.notConsumed 'recordTheReclaim'
			self.recordPromiseConsume(promise, kind: reclaimedBy)
		end 'recordTheReclaim'

		self.removeFromPendingTemps(promise)

		let index = try self.liveOwnerIndexOf(promise) otherwise return

		// A `var` bound from `.get(index)`: the flag is written THROUGH the shared `VarInfo` reference (the
		// `Scope.setValue` idiom `poisonOwningBinding` uses), so every holder observes it.
		let owned = try self.bodyState.ownedBindings.get(index) otherwise panic("consumePromiseThread: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")

		if reclaimedBy == PromiseConsume.notConsumed 'givenToAnotherOwner'
			self.recordPromiseConsume(promise, kind: PromiseConsume.movedIntoStorage)
		end 'givenToAnotherOwner'

		owned.markMovedAt(self.lineJustRead(), ledger: self.bodyState.moveLedger)
	end 'consumePromiseThread'

	// The one writer of `promiseConsumes`, and FIRST WINS: a door that reclaimed the thread must not be
	// overwritten by a later record, or E3142 quotes a door that is not where the thread went.
	function recordPromiseConsume(promise ValueId, kind PromiseConsume)
		self.bodyState.promiseConsumes = self.bodyState.promiseConsumes.recorded(promise, kind: kind)
	end 'recordPromiseConsume'

	// ⭐ **RECORD THAT `value` WAS READ OUT OF `container[index]` — the read half of a move out of a slot.**
	// Called at the container-read door for a green-thread element only; every other element is a borrow or a
	// retain and has no move to finish.
	function recordConsumablePromiseSlot(value ValueId, container ValueId, index ValueId, isField bool)
		try self.bodyState.promiseSlotContainer.set(value, value: container) otherwise panic("recordConsumablePromiseSlot: v{value} has no promise-slot entry — every SSA value must be minted through mintValue, which seeds the columns")
		try self.bodyState.promiseSlotIndex.set(value, value: index) otherwise panic("recordConsumablePromiseSlot: v{value} has no promise-slot index entry — every SSA value must be minted through mintValue, which seeds the columns")
		try self.bodyState.promiseSlotIsAField.set(value, value: isField) otherwise panic("recordConsumablePromiseSlot: v{value} has no promise-slot kind entry — every SSA value must be minted through mintValue, which seeds the columns")
		self.bodyState.promiseSlotCarriers.push(value)
	end 'recordConsumablePromiseSlot'

	// Does this value still name a container slot it was read out of, and not yet vacated? NOT-SET is the
	// value's own id — see the columns' header.
	function promiseValueCarriesAContainerSlot(value ValueId) returns bool
		try self.carriedContainerSlotOf(value) otherwise return false
		return true
	end 'promiseValueCarriesAContainerSlot'

	function carriedContainerSlotOf(value ValueId) returns ValueId throws AbsentError
		if self.bodyState.promiseConsumes.kindOf(value) != PromiseConsume.notConsumed 'givenAwayOnThisPath'
			throw AbsentError.absent
		end 'givenAwayOnThisPath'

		let container = try self.bodyState.promiseSlotContainer.get(value) otherwise panic("carriedContainerSlotOf: v{value} has no promise-slot entry — every SSA value must be minted through mintValue, which seeds the columns")

		if container == value 'carriesNoSlot'
			throw AbsentError.absent
		end 'carriesNoSlot'

		return container
	end 'carriedContainerSlotOf'

	// ⭐⭐ **FINISH THE MOVE: EMPTY THE SLOT THIS PROMISE CAME OUT OF.** `__managed_vacate` stores a zero
	// over it — no destroy (the thread has just been consumed by this frame, destroying it is the second
	// reclaim) and no COW detach (that would copy the record and leave two of them naming one thread). The
	// container's element walk null-guards every slot, so a vacated one is simply skipped.
	//
	// ⚠ **WHAT STOPS A VALUE VACATING TWICE IS THE CONSUME IT RECORDS HERE**, which the carries-a-slot test
	// above reads. The columns themselves are never cleared, for the reason their own header gives.
	function vacateConsumedPromiseSlot(value ValueId, range SourceRange, reclaimedBy PromiseConsume)
		if not self.promiseValueCarriesAContainerSlot(value) 'cameFromNoSlot'
			return
		end 'cameFromNoSlot'

		let container = try self.bodyState.promiseSlotContainer.get(value) otherwise panic("vacateConsumedPromiseSlot: v{value} has no promise-slot entry — the check above just read it")
		let index = try self.bodyState.promiseSlotIndex.get(value) otherwise panic("vacateConsumedPromiseSlot: v{value} has no promise-slot index entry — the columns move in lockstep")
		self.emitSlotVacate(value, range: range)
		self.noteCellPromiseTaken(container)
		self.recordPromiseConsume(value, kind: PromiseConsume.movedIntoStorage if reclaimedBy == PromiseConsume.notConsumed else reclaimedBy)
		self.retireEveryPendingReadOfSlot(container, index: index)
	end 'vacateConsumedPromiseSlot'

	function emitSlotVacate(value ValueId, range SourceRange)
		let container = try self.bodyState.promiseSlotContainer.get(value) otherwise panic("emitSlotVacate: v{value} has no promise-slot entry — every caller found it carrying one")
		let index = try self.bodyState.promiseSlotIndex.get(value) otherwise panic("emitSlotVacate: v{value} has no promise-slot index entry — the columns move in lockstep")
		let slotIsAField = try self.bodyState.promiseSlotIsAField.get(value) otherwise panic("emitSlotVacate: v{value} has no promise-slot kind entry — the columns move in lockstep")

		self.emitVacateCall(GtPromiseFieldVacateName if slotIsAField else ManagedVacateName, container: container, index: index, read: value, range: range)
	end 'emitSlotVacate'

	function emitVacateCall(callee ByteArray, container ValueId, index ValueId, read ValueId, range SourceRange)
		let args = ValueIdArray.create(3, zeroed: false)
		args.push(container)
		args.push(index)
		args.push(read)
		_ = self.emitRuntimeCall(callee, args: args, resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitVacateCall'

	// ⚠ **THE UNCHECKED EMPTY, and its one caller is why it is not the checked vacate.**
	// `claimWithIteratorPromiseSlot` empties a pair's element field as bookkeeping — the field never owned
	// the thread — and a second pass over an array whose slot an earlier await vacated legitimately finds a
	// zero there. Routing it through `__gt_promise_field_vacate` aborts such a program at 118
	// (`withIterator.nested-loops-over-two-promise-arrays`). A field a frame is MOVING a promise out of goes
	// through the checked door instead.
	function emitEmptyPromiseField(box ValueId, offset ByteOffset, range SourceRange)
		let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: range)
		self.emitIndirectStore(box, offset: offset, value: zero, storageType: MaxonType.integer, range: range)
	end 'emitEmptyPromiseField'

	function emitPromiseRelease(held ValueId, range SourceRange)
		_ = self.emitRuntimeCall(GtPromiseReleaseName, args: argsOf(held), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitPromiseRelease'

	// ⭐⭐ **EMPTYING A SLOT RETIRES EVERY PENDING READ OF IT, NOT JUST THE ONE BEING CONSUMED.** A slot can be
	// read twice before either read is used — `let a = try s.get(0)…; let b = try s.get(0)…` — and both values
	// then name ONE green thread. The first consume takes it; the second must not, and the record left here
	// says so: the retired value carries neither an ownership mark nor a slot, so whichever door it reaches
	// refuses it through `requireConsumedPromiseIsOwned` rather than reclaiming a thread that is already
	// gone. A record rather than a removal, because a removal could not be rewound at a branch join.
	//
	// ⚠ **THE INDEX IS MATCHED BY CONSTANT WHERE ONE IS KNOWN, NOT BY `ValueId`.** Two source-level `0`s mint
	// two different literal values, so identity alone would call them different slots and see nothing.
	// ⛔ **THIS PROVES ONLY THE SAME-SLOT CASE, SO IT CANNOT BE THE WHOLE GUARD.** A run-time index, a cursor's
	// position and a buffer loaded out of a cursor are fresh values at every read, so two reads of one slot
	// through them look like two slots here; `__managed_vacate` checks the occupant at run time for those.
	function retireEveryPendingReadOfSlot(container ValueId, index ValueId)
		for other in self.pendingReadsOfSlot(container, index: index) 'eachPendingRead'
			self.recordPromiseConsume(other, kind: PromiseConsume.siblingReadConsumedTheSlot)
		end 'eachPendingRead'
	end 'retireEveryPendingReadOfSlot'

	function pendingReadsOfSlot(container ValueId, index ValueId) returns ValueIdArray
		let reads = ValueIdArray.create(0)

		for position in 0 upto self.bodyState.promiseSlotCarriers.count() 'eachCarrier'
			let other = try self.bodyState.promiseSlotCarriers.get(position) otherwise panic("pendingReadsOfSlot: promiseSlotCarriers.get OOB at {position} on a walk bounded by its own count")

			let otherContainer = try self.carriedContainerSlotOf(other) otherwise continue
			let otherIndex = try self.bodyState.promiseSlotIndex.get(other) otherwise panic("pendingReadsOfSlot: the slot columns move in lockstep")

			if otherContainer != container or not self.slotIndicesDenoteTheSameSlot(otherIndex, b: index) 'anotherSlot'
				continue
			end 'anotherSlot'

			reads.push(other)
		end 'eachCarrier'

		return reads
	end 'pendingReadsOfSlot'

	// Do these two index values name the same slot? The same SSA value always does; two values both known to
	// be the same constant do too, which is the case that matters (a repeated literal index).
	function slotIndicesDenoteTheSameSlot(a ValueId, b ValueId) returns bool
		if a == b 'sameValue'
			return true
		end 'sameValue'

		if not (self.constIsKnown(a) and self.constIsKnown(b)) 'notBothConstant'
			return false
		end 'notBothConstant'

		return self.constOf(a) == self.constOf(b)
	end 'slotIndicesDenoteTheSameSlot'

	// ⭐ **IS A GREEN THREAD `p` OWNS STILL NAMED BY A LIVE ALIAS?** `let q = p` binds
	// `q` to `p`'s thread ValueId without enrolling a second owner (a promise aliases, it does not move), so
	// re-arming `p` must first confirm no such live alias exists — else dropping the thread dangles the alias
	// (a UAF at `await q`). `thread` is the value being re-armed away. Two shapes:
	//   • DIRECT — `thread` is the spawn's ValueId (a non-loop re-arm): scan the symbol table for a DIFFERENT
	//     live name bound to it.
	//   • MERGE PHI — a re-armed `var` across a loop / branch holds a phi as `thread`; the phi itself is named
	//     by no alias, but the thread it MERGES (on the first reaching edge) may be. So also scan the phi's
	//     incoming edge values (`phiIncomingValues`) — the pre-loop value an outer `let q = p` aliases.
	// Purely a re-arm-time scan (no per-binding/per-value state), so the async-free scale corpus pays nothing.
	function promiseThreadHasLiveAlias(func IrFunction, reArmedName ByteArray, thread ValueId) returns bool
		if self.threadNameAliasedBy(reArmedName, thread: thread) 'direct'
			return true
		end 'direct'

		for incoming in self.phiIncomingValues(func, phi: thread) 'eachIncoming'
			if self.threadNameAliasedBy(reArmedName, thread: incoming) 'phiAlias'
				return true
			end 'phiAlias'
		end 'eachIncoming'

		return false
	end 'promiseThreadHasLiveAlias'

	// A live name of `thread` OTHER than `reArmedName` — the raw symbol-table scan `promiseThreadHasLiveAlias`
	// runs on the re-armed value and on each of its phi's incoming values. What counts as a live name is
	// `VarInfo.isLiveNameOf`, shared with `poisonValueAliases`; the name exclusion is this scan's alone.
	function threadNameAliasedBy(reArmedName ByteArray, thread ValueId) returns bool
		for (name, info) in self.bodyState.scope.allVars() 'each'
			if name != reArmedName and info.isLiveNameOf(thread) 'alias'
				return true
			end 'alias'
		end 'each'

		return false
	end 'threadNameAliasedBy'

	function poisonMoveSource(value ValueId)
		self.noteLentUniqueMoved(value)

		// The OWNER first, and the aliases only once it has been found: `liveOwnerIndexOf` skips a
		// poisoned owner — so marking the names first would hide the owner from its own lookup, and with
		// it the loop-escape refusal below.
		self.poisonOwningBinding(value)
		self.poisonValueAliases(value)
	end 'poisonMoveSource'

	// ⭐ **WHERE IN `ownedBindings` THE ONE LIVE OWNER OF `value` SITS** — it throws when this frame owns it
	// through no BINDING at all (a statement-scoped temporary, or a value it does not own).
	//
	// ⚠ **ONE LOOKUP, BECAUSE ITS TWO CALLERS MUST AGREE ON *WHICH* BINDING THE MOVE IS ABOUT.** The move itself
	// (`poisonOwningBinding`, which marks that binding `movedFrom`) and the question asked BEFORE moving
	// (`moveOfValueEscapesLoop`, which decides whether an opaque container store may move at all) would
	// otherwise be two searches free to settle on two owners — and then a store would take a reference against
	// one binding's position while the poison landed on another's.
	function liveOwnerIndexOf(value ValueId) returns ElementIndex throws MapError
		return try self.bodyState.moveLedger.refreshedOwners(self.bodyState.ownedBindings).ownerOf(value)
	end 'liveOwnerIndexOf'

	function hasLiveOwner(value ValueId) returns bool
		try self.liveOwnerIndexOf(value) otherwise return false
		return true
	end 'hasLiveOwner'

	// ⭐ **WOULD MOVING `value` CROSS OUT OF THE INNERMOST ENCLOSING LOOP?** The question a door asks when it
	// has a second way to discharge its obligation and wants to know whether the cheap one is available — see
	// `moveElementIntoContainer`'s opaque arm, which takes a REFERENCE instead when the answer is yes. Asked of
	// the same binding `poisonOwningBinding` would poison, so the two doors cannot disagree about which move
	// this is.
	function moveOfValueEscapesLoop(value ValueId) returns bool
		let index = try self.liveOwnerIndexOf(value) otherwise return false
		return self.bindingIndexEscapesLoop(index)
	end 'moveOfValueEscapesLoop'

	// The owned-set half of `poisonMoveSource`: mark the ONE live owner of `value` moved-from, refusing a
	// move that would escape the innermost loop.
	function poisonOwningBinding(value ValueId)
		let index = try self.liveOwnerIndexOf(value) otherwise return

		// A `var` bound from `.get(index)`, not a bare `for` element: a field write needs a mutable binding,
		// and it is written THROUGH the shared `VarInfo` reference (the `Scope.setValue` idiom), so the flag is
		// observed by every holder — `ownedBindings`, `Scope.vars`, any loop-phi list.
		let owned = try self.bodyState.ownedBindings.get(index) otherwise panic("poisonOwningBinding: ownedBindings.get OOB at {index} — the index came from `liveOwnerIndexOf` and was just bounds-tested")

		owned.markMovedAt(self.lineJustRead(), ledger: self.bodyState.moveLedger)
		self.settleFeedDropGuardOf(value, loopCarried: LoopCarriedGuards.settleAlways)
		self.bodyState.movedBindingValues = withValueMarked(self.bodyState.movedBindingValues, value: value)
	end 'poisonOwningBinding'

	// ⭐⭐ **A MOVE POISONS EVERY NAME THAT READS THE VALUE, NOT ONLY THE ONE THAT OWNS IT.** An immutable
	// rebind (`let b = a`) enrols no second owner — `b` simply reads `a`'s value — so `poisonMoveSource`'s
	// owner lookup finds `a` and stops. That is the right OWNER, and it is not the whole answer: after
	// `f(b)` or `return b` the callee has the value, and `b` would go on reading a box this frame no longer
	// owns. The names are not interchangeable to the diagnostic either — a later `print(b)` must say `b`.
	//
	// So the symbol table is walked and every live binding on the same value is marked. Only the READ
	// rejection turns on this bit for an alias: an alias is in no owned set, so no drop is skipped or added
	// by marking it, which is why marking too widely here can only ever add an E3102, never a leak.
	//
	// ⚠ **GATED ON THE FUNCTION HAVING MINTED AN ALIAS AT ALL.** Without an alias no two live bindings can
	// share a value, so the walk is provably empty — and consuming call arguments reach the poison on every
	// call in the program, which is exactly where an ungated per-move symbol-table scan would become
	// quadratic in a long function body.
	function poisonValueAliases(value ValueId)
		if not self.bodyState.functionMintedValueAliases 'noAliasesInThisFunction'
			return
		end 'noAliasesInThisFunction'

		for (name, binding) in self.bodyState.scope.allVars() 'eachBinding'
			if not (binding.isLiveNameOf(value) or self.bindingIsAUniquePayloadOf(binding, scrutinee: value)) 'notALiveNameOfIt'
				continue
			end 'notALiveNameOfIt'

			// Re-read through `getInfo` for a `var`: the map's `for` element is immutable, and the flag must
			// be written THROUGH the shared `VarInfo` so every holder observes it — the `Scope.setValue`
			// idiom `poisonOwningBinding` uses, for its reason.
			let alias = self.bodyState.scope.getInfo(name)
			alias.markMovedAt(self.lineJustRead(), ledger: self.bodyState.moveLedger)
		end 'eachBinding'
	end 'poisonValueAliases'

	function bindingIsAUniquePayloadOf(binding VarInfo, scrutinee ValueId) returns bool
		return binding.isPayloadBinding() and binding.payloadScrutBox() == scrutinee and not binding.movedFrom and self.valueHoldsAUniqueRecord(binding.boundValue)
	end 'bindingIsAUniquePayloadOf'

	// Does moving the owned binding at `index` cross OUT of the innermost enclosing loop — i.e. was that
	// binding declared before the loop body was entered (`LoopContext.ownedFloor`)? Only such a move is
	// unsound (see `poisonMoveSource`); a move of a body-local binding, or any move outside a
	// loop entirely, is fine. The innermost loop is the top of the loop-context stack.
	function bindingIndexEscapesLoop(index ElementIndex) returns bool
		if self.bodyState.loops.count() == 0 'notInLoop'
			return false
		end 'notInLoop'

		let innermost = try self.bodyState.loops.get(self.bodyState.loops.count() - 1) otherwise panic("bindingIndexEscapesLoop: loops.get failed on a non-empty stack")
		return index < innermost.ownedFloor
	end 'bindingIndexEscapesLoop'

	// ⭐ **PROMOTE A BORROWED String TO AN OWNED HEAP COPY**, which is what the `binding` door spends;
	// the two HAND-OFF doors retain instead (`retainBorrowedByteRecord`). The
	// problem it solves: `return "hi"` yields an immortal rdata literal
	// (`capacity@16 == ImmortalRecordCapacity` — NOT `RdataBufferCapacity`, whose record is an ordinary
	// `__mm_alloc` box), and a `returns String` caller drops its result unconditionally — decref'ing
	// read-only data. Copying the
	// source bytes into a fresh fused record — the SAME single-`__mm_alloc` path an interpolation builds,
	// with the source as its one part (`__str_copy` blits `buffer@0`/`length@8`) — yields an owned
	// temporary the caller can safely drop. `emitStringInterp` marks it owned (`trackOwnedTemp`); the
	// return's move-out then takes it out of the pending list. NO second record layout is hand-rolled.
	// ⚠ **THE PROMOTION KEEPS THE SOURCE'S TYPE, AND GETTING THAT WRONG IS A REACHABLE BUG.** The copy is
	// built by the interpolation encoder, whose result is a `String` — so promoting a borrowed CHARACTER
	// through it unchanged hands back a `string`-tagged value, and `var found = 'é'` (a `var` promotes its
	// managed initializer at the declaration) types `found` as a **String**. The next line then refuses a
	// Character: *"cannot assign 'Character' to variable 'found' of type 'String'"*, on a program that is
	// plainly legal. The RECORD is identical either way — that is the whole premise of `tagIsByteRecord` —
	// so only the tag is wrong, which is exactly the class of bug a shared representation invites.
	// `resultTag` is threaded from here rather than fixed at the encoder because the encoder has a second
	// caller (`parseStringInterpolation`) whose result genuinely IS a String.
	function promoteToOwnedString(source ValueId, range SourceRange) returns ValueId
		let partBufs = ValueIdArray.create(0)
		let partLens = ValueIdArray.create(0)
		let scratchIds = ValueIdArray.create(0)
		self.materializeStringRecordPart(source, partBufs: partBufs, partLens: partLens, range: range)
		return self.emitStringInterp(partBufs, partLens: partLens, scratchIds: scratchIds, range: range, resultTag: self.tagOf(source))
	end 'promoteToOwnedString'

	// ⭐ **RETAIN A BORROWED MANAGED AGGREGATE AS A FRESH OWNED VALUE.** The struct/union analogue
	// of `promoteToOwnedString`: where a String promotes by COPYING into a fresh owned record, an aggregate
	// has no cheap owning copy and MUST stay the same box (the alias is observable through a field write), so
	// it is promoted by an INCREF instead — `__mm_retain` raises the box's refcount and hands back the
	// pointer. That the runtime fn RETURNS the pointer (rather than reusing the void `__mm_incref`) is the
	// point: the result is a FRESH SSA value distinct from `source`, so a later re-borrow of `source`
	// (`let r = p`) cannot `poisonMoveSource`-match this binding, and moving this binding poisons IT, not the
	// source. The result carries the SOURCE's exact type (same tag + name id), so the binding is the same
	// aggregate the source is — its fields, its `match` dispatch, and its drop callee all resolve
	// identically. `markValueOwnsHeap` (not `trackOwnedTemp`) sets the owned-heap provenance WITHOUT
	// enrolling a statement-scoped pending drop: `parseBinding` binds this to the `var`, which drops it at
	// ITS scope exit through `ownedBindings` — the same door a consumed managed parameter drops through.
	//
	// ⭐ **CO-OWNED IS THIS DOOR'S DEFINING FACT, NOT A CAVEAT ON IT** — the paragraph above says the box is
	// deliberately SHARED and the alias deliberately observable, so the result is the textbook co-owner. Claiming
	// `sole` here is what let `let borrowed = h.ty` steal `h`'s payload slot.
	function retainBorrowedAggregate(source ValueId, range SourceRange) returns ValueId
		let retained = self.emitRetainCall(source, range: range)
		self.markValueOwnsHeap(retained, exclusivity: OwnedHeapExclusivity.coOwned)
		return retained
	end 'retainBorrowedAggregate'

	// ⭐ **THE BYTE-RECORD TWIN OF `retainBorrowedAggregate`** — same ownership bookkeeping, a different
	// runtime entry, and the difference is that a byte record has TWO provenances where an aggregate has one.
	// `__str_retain` copies an immortal `.rdata` literal and increfs a heap record; either way the result is a
	// FRESH SSA value the merge phi owns outright, and `markValueOwnsHeap` rather than `trackOwnedTemp` for
	// the reason stated one function up — the phi, not this statement, owes the drop.
	//
	// The result carries the SOURCE's tag and name id, so a `Character` edge stays a `Character`.
	//
	// CO-OWNED for the reason the two provenances give it: `__str_retain` increfs a HEAP record, and which of its
	// two branches ran is exactly what this frame cannot know (that is why the entry exists). A byte record has no
	// slot a move-out can null, so the claim costs nothing today and is the true one.
	function retainBorrowedByteRecord(source ValueId, range SourceRange) returns ValueId
		let retained = self.emitRuntimeCall(StrRetainName, args: argsOf(source), resultTag: self.tagOf(source), resultNameId: self.valueNameId(source), range: range)

		// The SOURCE is downgraded too, for `emitIncref`'s reason — see `markValueCoOwnsHeap`. On the heap branch
		// this op is an incref, so afterwards two names hold one record; on the `.rdata` branch it is a copy and
		// the source was never sole anyway, so the mark is true either way and the parser need not know which ran.
		self.markValueCoOwnsHeap(source)
		self.markValueOwnsHeap(retained, exclusivity: OwnedHeapExclusivity.coOwned)
		self.carryFromSharedRecord(retained, from: source, source: self.bodyState, path: ValueCarryPath.copy)
		return retained
	end 'retainBorrowedByteRecord'

	// ⭐ **AN EXISTENTIAL'S FRESH NAME KEEPS THE SOURCE'S WITNESS AND THE `with` CLAIM IT WAS DECLARED AT.** A
	// retain takes a second owner of the conformer's record — or, for a byte record, a CLONE of it — and in
	// neither case does the conformer change, so the co-owner dispatches through the same table and binds what
	// the source bound. But it is a different ValueId, and both columns are keyed by ValueId, so both have to be
	// carried: without the witness the first dispatch on the result panics in `witnessOfValue`, and without the
	// claim a field store of the result is refused as though its binding had never been settled
	// (`SemanticCheck.checkExistentialSiteClaimAtFieldStore`). A non-existential source has neither and carries
	// nothing, which is what lets the two retain doors share this step.
	//
	// ⚠ Asked by the existential retain (`emitRetainExistentialCall`), which every door that retains —
	// a co-own, a consume — reaches, and by the doors that name a value again without retaining it
	// (`openHold`, `movedAliasOf`).
	function carryInterfaceWitness(retained ValueId, from ValueId)
		if self.tagOf(from) != ValueTypeTag.interfaceRef 'notAnExistential'
			return
		end 'notAnExistential'

		self.pairInterfaceWitness(retained, witness: self.witnessOfValue(from))

		if let claim = try self.existentialClaimOfValue(from) 'declaredAtAClaim'
			self.recordValueExistentialInstance(retained, claim: claim)
		end 'declaredAtAClaim'
	end 'carryInterfaceWitness'

	function carryFromSharedRecord(to ValueId, from ValueId, source FunctionBodyState, path ValueCarryPath)
		self.carryValueFacts(to, from: from, source: source, path: path)
		self.carryImageRecordMark(to, from: from, source: source, path: path)
	end 'carryFromSharedRecord'

	function carryValueFacts(to ValueId, from ValueId, source FunctionBodyState, path ValueCarryPath)
		self.carryBrand(to, from: from, source: source, path: path)
		self.carryFact(ValueFact.unprovenAlias, to: to, from: from, source: source, path: path)
		self.carryFact(ValueFact.aboveSignedMax, to: to, from: from, source: source, path: path)
		self.carryFact(ValueFact.bufferSurface, to: to, from: from, source: source, path: path)
		self.carryFact(ValueFact.sizedContainerBuffer, to: to, from: from, source: source, path: path)
		self.carryFact(ValueFact.bufferElements, to: to, from: from, source: source, path: path)
		self.markBufferSurfaceSlots(to, surface: bodySlotSurface(source, value: from))
		self.carryBrandOrigin(to, from: from, source: source, path: path)
	end 'carryValueFacts'

	function carryBrandOrigin(to ValueId, from ValueId, source FunctionBodyState, path ValueCarryPath)
		if path == ValueCarryPath.cellStore 'aCellWearsItsBindingsOrigin'
			return
		end 'aCellWearsItsBindingsOrigin'

		match source.brandOrigins 'column'
			unwritten then break
			entries(byValue) then self.carryBrandOriginFrom(byValue, to: to, from: from)
		end 'column'
	end 'carryBrandOrigin'

	function carryBrandOriginFrom(byValue BrandOriginMap, to ValueId, from ValueId)
		if let key = try byValue.get(from) 'originated'
			self.noteBrandOrigin(to, key: key)
		end 'originated'
	end 'carryBrandOriginFrom'

	function carryFact(fact ValueFact, to ValueId, from ValueId, source FunctionBodyState, path ValueCarryPath)
		if factCrossesPath(fact, path: path) and bodyHoldsFact(source, fact: fact, value: from) 'carried'
			self.applyFact(fact, to: to, from: from, source: source)
		end 'carried'
	end 'carryFact'

	function applyFact(fact ValueFact, to ValueId, from ValueId, source FunctionBodyState)
		match fact 'fact'
			unprovenAlias then try self.bodyState.aliasUnprovenMarks.set(to, value: true) otherwise panic("applyFact: v{to} has no alias-proof slot — every SSA value must be minted through mintValue, which seeds the column")
			aboveSignedMax then self.markAboveSignedMax(to)
			bufferSurface then self.markBufferSurface(to, origin: self.internedName(self.brandIdIn(source, value: from)))
			sizedContainerBuffer then self.markSizedContainerBuffer(to, origin: self.internedName(self.brandIdIn(source, value: from)))
			bufferElements then self.markBufferSurfaceElements(to)
		end 'fact'
	end 'applyFact'

	function carryBrand(to ValueId, from ValueId, source FunctionBodyState, path ValueCarryPath)
		if path == ValueCarryPath.cellStore 'aCellWearsItsBindingsBrand'
			return
		end 'aCellWearsItsBindingsBrand'

		self.wearBrandIfUnbranded(to, brand: self.brandIdIn(source, value: from))
	end 'carryBrand'

	function wearBrandIfUnbranded(value ValueId, brand TypeNameId)
		if brand != UnnamedTypeId and self.brandIdOf(value) == UnnamedTypeId 'anUnbrandedName'
			try self.bodyState.valueBrandIds.set(value, value: brand) otherwise panic("wearBrandIfUnbranded: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
		end 'anUnbrandedName'
	end 'wearBrandIfUnbranded'

	function brandIdIn(source FunctionBodyState, value ValueId) returns TypeNameId
		return try source.valueBrandIds.get(value) otherwise panic("brandIdIn: v{value} has no brand slot — every SSA value is minted through mintValue, which seeds the column")
	end 'brandIdIn'

	// ⭐⭐ **WHICH RETAIN A BORROWED AGGREGATE TAKES — and an EXISTENTIAL takes a DIFFERENT one, because a
	// CONCRETE type's protocol is a compile-time fact and a conformer's is not.**
	// A concrete value's entry is `retainCalleeOf`'s, which is the plain box retain for almost
	// everything and the cown handle pair for a `<T>.handle`. A conformer may be neither — `int`/`bool` conform
	// intrinsically and are held at an interface as their RAW
	// VALUE (which is what makes them representable there where a `float` is not, E3121), and a `String`
	// literal is an IMMORTAL `.rdata` record that must be COPIED rather than increfed. So the existential arm
	// dispatches through the witness's `retainFunc@16` — `__retain_existential(witness, value)` — which is the
	// same three-way choice `promoteBorrowedToOwned` makes statically, deferred to run time.
	//
	// **BOTH SHORTCUTS WERE MEASURED AS 0xC0000005**: a plain `__mm_retain` on `use(h Comparable)` called with
	// `7`, writing through `<the integer> - 24 + 16` where the program answers 11; and a hardcoded incref
	// under the gate on `widen("abc")`, writing into read-only `.rdata`.
	//
	// ⚠ Both entries return a value the caller must USE, and NEITHER is guaranteed to hand back what it was
	// given: the existential arm dispatches through the witness, and the concrete arm answers `__managed_retain`
	// for a buffer record, which copies an immortal one. A caller may never substitute the source for the result.
	function emitRetainCall(source ValueId, range SourceRange) returns ValueId
		if self.tagOf(source) == ValueTypeTag.interfaceRef 'existential'
			return self.emitRetainExistentialCall(source, range: range)
		end 'existential'

		// ⭐⭐ **A BOX WHOSE SLOTS ADDRESS OTHER RECORDS IS THE THIRD REPRESENTATION WITH AN IMMORTAL MEMBER**,
		// and it earns an arm HERE rather than in `retainCalleeOf` for one reason: its entry takes the
		// box's own cloner as a SECOND argument, which a callee selector cannot express. The buffer record's
		// fork is `__managed_retain`'s, off `capacity@16`; this one is `__mm_own_deep`'s, off the allocation
		// header, because a declared generic's `@16` — and a struct's — is an author-declared field.
		if self.valueIsAnImageableDeepBox(source) and not self.valueIsImmutableData(source) 'aBoxWithPointerSlots'
			return self.emitOwnDeepBoxCopy(source, range: range)
		end 'aBoxWithPointerSlots'

		if self.valueIsImmortalFunction(source) 'anImmortalRecord'
			let copy = self.emitRetaggedCastValue(source, targetType: self.typeOf(source), range: range)
			self.markImmortalFunction(copy)
			self.carryFromSharedRecord(copy, from: source, source: self.bodyState, path: ValueCarryPath.value)
			return copy
		end 'anImmortalRecord'

		// `__mm_retain` gives `source`'s box a second owner exactly as `__mm_incref` does, so the source is
		// downgraded here for the identical reason — see `markValueCoOwnsHeap`.
		self.markValueCoOwnsHeap(source)
		let opFloor = self.artifact.module.ops.count()
		let retained = self.emitRuntimeCall(self.retainCalleeForValue(source), args: argsOf(source), resultTag: self.tagOf(source), resultNameId: self.valueNameId(source), range: range)
		self.noteRetainOfAParameter(source, retained: retained, opFloor: opFloor)
		self.carryFromSharedRecord(retained, from: source, source: self.bodyState, path: ValueCarryPath.copy)
		self.carryFrozenCapability(source, target: retained)
		return retained
	end 'emitRetainCall'

	function carryFrozenCapability(source ValueId, target ValueId)
		if self.effectiveCapabilityOf(source) == ValueCapability.immutable and not self.valueSettlesAfterParsing(source) 'aFrozenRecord'
			self.setValueCapability(target, capability: ValueCapability.immutable)
		end 'aFrozenRecord'
	end 'carryFrozenCapability'

	function noteRetainOfAParameter(source ValueId, retained ValueId, opFloor ElementIndex)
		if not self.valueIsAnArray(source) or self.valueIsImmutableData(source) or not self.valueIsAnUndecidedParameter(self.bodyFunction(), value: source, capability: self.effectiveCapabilityOf(source)) 'decidedAlready'
			return
		end 'decidedAlready'

		let opIdx = try firstOpDefiningSince(self.artifact.module, value: retained, floor: opFloor) otherwise return
		let sources = self.paramSourcesOf(self.bodyFunction(), value: source)
		let notes = self.notesForWrite(self.bodyFunction())

		for position in 0 upto MaxAbiArgs 'eachSourceParameter'
			if maskHasParam(sources, param: position) 'aSource'
				notes.retainOps.push(opIdx)
				notes.retainParams.push(position)
			end 'aSource'
		end 'eachSourceParameter'
	end 'noteRetainOfAParameter'

	function retainCalleeForValue(source ValueId) returns immutable ByteArray
		if self.valueIsAnArray(source) and self.valueIsImmutableData(source) 'immutableArrayIsNeverCopied'
			return MmRetainName
		end 'immutableArrayIsNeverCopied'

		return self.signatures.retainCalleeOf(self.tagOf(source), nameId: self.valueNameId(source), from: self.artifact.typeNames, result: RetainResult.freshName, readerFilePath: self.job.path)
	end 'retainCalleeForValue'

	// ⭐ **THE ONE `__retain_existential` CALL**, so its argument ORDER — the witness first, matching
	// `__drop_existential` — is spelled once. BOTH callers want the same half of it, the returned id: the
	// entry dispatches through the witness's `retainFunc@16`, which for a byte-record conformer is a
	// `__str_clone` handing back a DIFFERENT record, so the co-owner is what came out and never what went in.
	// The result carries the SOURCE's exact type so a caller that binds it holds the same existential.
	function emitRetainExistentialCall(source ValueId, range SourceRange) returns ValueId
		// Downgraded for `markValueCoOwnsHeap`'s reason. Which of the witness's three protocols runs is a RUN-TIME
		// choice (incref a record, copy a byte record, hand back a raw value), and the co-owned answer is the
		// sound one under every branch — the incref one makes it literally true, and the others make it harmless.
		self.markValueCoOwnsHeap(source)
		let retained = self.emitRuntimeCall(RetainExistentialName, args: twoArgs(self.witnessOfValue(source), second: source), resultTag: self.tagOf(source), resultNameId: self.valueNameId(source), range: range)
		self.carryInterfaceWitness(retained, from: source)
		self.carryFromSharedRecord(retained, from: source, source: self.bodyState, path: ValueCarryPath.copy)
		return retained
	end 'emitRetainExistentialCall'

	// ⭐ **BECOME A SECOND OWNER OF `source`'s BOX, AS AN UNBOUND STATEMENT-SCOPED TEMPORARY** — the door for
	// an expression that hands back a record SOMEBODY ELSE already owes a drop on, and whose own result may be
	// bound to nothing.
	//
	// It is `retainBorrowedAggregate` PLUS `trackOwnedTemp`, and the second half is the part that is easy to
	// leave off: the door above sets the owned-heap bit ALONE, because it is written for a value whose drop a
	// BINDING will owe (`promoteBorrowedToOwned`). A value that may never reach a binding —
	// `ByteArray.init(mm).count()`, `f(bytes.managed)` — needs the STATEMENT-scoped obligation as well, or the
	// retain is never released (exit 101 with `trackOwnedTemp` removed).
	//
	// ⭐ **THE TWO CALLERS ARE EXACT INVERSES OF EACH OTHER AND THAT IS WHY THIS IS ONE FUNCTION**:
	// `parseArrayInitStatic` adopts a buffer AS the array around it, `bufferSurfaceOf` hands the array's buffer
	// BACK. They differ in exactly ONE line — whether the fresh id is marked `markBufferSurface`. Spelled out
	// at each site instead, a third ownership fact added to one copy is a leak or a double free in the other,
	// with nothing to say so: the surfaces are inverses, but the refcount question they answer is the same
	// question.
	// ⭐⭐ **TRANSITIVE CONSUME: A BORROWED AGGREGATE REACHING A CONSUMING POSITION TAKES ITS OWN REFERENCE**
	// (⚖ the user ruling, 2026-08-04). Both doors that hand a value to durable storage — a CONSUMED ARGUMENT
	// (`transferConsumedArg`, the callee will store it) and a DIRECT move-in (`moveManagedValueInto`, this
	// frame stores it) — settle it by REFCOUNT rather than by the call-graph fixpoint an `E2015` could name:
	// the storage becomes a second owner, the borrow's own owner is untouched,
	// and the container's destructor releases exactly the reference taken here. It is the SAME `__mm_incref`
	// co-ownership the compiler already sanctions for a slice view, a `try … otherwise` phi reconciliation and a
	// borrowed aggregate bound into a `var` — generalized to the one position that was still refused.
	//
	// ⚠ **IT IS NOT `retainBorrowedAggregate`, AND THE DIFFERENCE IS WHAT OWNS THE RESULT.** That door marks
	// its result owned because a BINDING will drop it at scope exit; here the new owner is a SLOT in another
	// record, so this frame marks nothing and drops nothing — the container's destructor releases exactly the
	// reference taken here.
	//
	// ⚠⚠ **THE RESULT IS WHAT THE CALLER MUST STORE, BECAUSE TWO OF THE THREE ARMS HAND BACK A DIFFERENT
	// RECORD.** Only the struct/union arm can answer with the source: `__mm_incref` is void and an aggregate
	// must stay one record. The other two co-own a representation with an IMMORTAL member, and an immortal
	// record's only co-owner is a COPY — `__retain_existential` dispatches through the witness's
	// `retainFunc@16`, which for a `String`/`Character` conformer is `__str_clone`, and `__managed_retain`
	// forks on the buffer record's own `capacity@16`. Handing the SOURCE back instead puts an immortal
	// `.rdata` record into durable storage, where the sink's first write faults on a read-only page and the
	// clone nobody kept leaks — MEASURED as `widen("abc")` printing `A` and dying with 0xC0000005.
	//
	// ⚠ **AND IT IS NOT A MOVE.** The source is deliberately NOT poisoned: co-ownership is what makes
	// `Holder.create(p)` twice legal in one body, where a move would make the second an E3102 and a single
	// transferred `+1` a double free at the second destructor.
	function coOwnBorrowedForConsume(value ValueId, range SourceRange) returns ValueId
		if self.tagOf(value) == ValueTypeTag.interfaceRef 'existential'
			return self.emitRetainExistentialCall(value, range: range)
		end 'existential'

		return self.coOwnConcreteRecordForSink(value, range: range)
	end 'coOwnBorrowedForConsume'

	// ⭐⭐ **THE REFERENCE A BORROWED CONCRETE RECORD OWES A DURABLE SINK, AS THE ValueId THE SINK MUST
	// RECEIVE — ONE HOME, BECAUSE THE ANSWER IS NOT ALWAYS THE VALUE THAT WENT IN.** Both doors that hand a
	// borrowed record to storage that outlives the statement (`coOwnBorrowedForConsume`, a consumed argument
	// or a direct move-in; `coOwnConcreteAggregateFeed`, a type-parameter feed position) owe exactly this one
	// act, and the answer they must pass on is the one this returns.
	//
	// ⚠⚠ **A BUFFER RECORD MAY BE IMAGE DATA, AND THE VOID INCREF IS UNSOUND FOR ONE.** A module-level
	// managed constant materializes as an immortal `.rdata` record (`emitManagedConstant`), and
	// `__managed_incref` on one does NOTHING by design — so the sink comes to hold the read-only record
	// itself, and the first mutation reached through it writes a read-only page (a segfault on x64, a SILENT
	// write on wasm, which has no read-only section). `__managed_retain` forks on the record's own
	// `capacity@16`: a private clone for an immortal record, the same box with one more owner for every other.
	// Which record a sink is handed is not a compile-time fact — it may be a merge phi — so the fork has to be
	// the run-time one.
	function coOwnConcreteRecordForSink(value ValueId, range SourceRange) returns ValueId
		if self.valueIsAnArray(value) 'bufferRecord'
			return self.emitRetainCall(value, range: range)
		end 'bufferRecord'

		if self.valueIsImmutableData(value) and not self.valueIsAServiceHandle(value) 'immutableDataIsShared'
			return self.emitRetainCall(value, range: range)
		end 'immutableDataIsShared'

		// ⭐⭐⭐ **A SERVICE HANDLE IS `structRef`-TAGGED AND IS NOT A PLAIN STRUCT BOX — a durable sink takes
		// a SHARE of it, never a copy.** A handle's identity IS the cown it names, and each handle box owns
		// one share of the cown, given back by its destructor (`__cown_handle_destruct`). `__mm_own`'s copy
		// arm allocates a second box and blits the cown pointer into it without taking a share, so two
		// boxes would give back ONE share: the first drop closes the cown, the service drains, and the next
		// send is refused as stopped.
		//
		// ⚠ It is `emitIncref`, which asks `retainCalleeOf` — so the reference a sink takes and the
		// reference a scope-exit drop releases are the SAME answer, and stay duals by construction.
		if self.valueIsAServiceHandle(value) 'aServiceHandle'
			self.emitIncref(value, range: range)
			return value
		end 'aServiceHandle'

		// ⭐⭐⭐ **A BOX WHOSE SLOTS ADDRESS OTHER RECORDS TAKES THE DEEP COPY, exactly as the buffer record at
		// the top does.** A `Map`, a `Set` and every declared generic written the way they are; and a struct
		// whose own fields hold such records. An empty one of either is IMAGE DATA, whose incref does nothing.
		// The checker lets a module-level `let`'s image reach only a read-only sink statically, but a callee's
		// store (`Self{m: m}`) cannot know where its parameter came from, so the fork is the run-time one, and
		// it is the backstop for a gate that misses a writable sink. Left to a bare incref or to `__mm_own`'s
		// blit, the sink would hold the `let`'s own columns, and the first write through them would hit a
		// read-only page (a silent write on wasm).
		if self.valueIsAnImageableDeepBox(value) 'aBoxWithPointerSlots'
			return self.emitOwnDeepBoxCopy(value, range: range)
		end 'aBoxWithPointerSlots'

		if self.valueIsAHeapRecord(value) 'plainStructBox'
			return self.emitOwnBoxForSink(value, range: range)
		end 'plainStructBox'

		self.emitIncref(value, range: range)
		return value
	end 'coOwnConcreteRecordForSink'

	// ⭐⭐ **IS THIS VALUE A BOX A `let` COULD HAVE LAID DOWN AS BYTES WITH SLOTS ADDRESSING OTHER RECORDS —
	// a `Map`, a `Set`, every declared generic written the way they are, and a struct holding one of those?**
	// The admissions are `declaredContainerBoxIsImageData` and `structBoxIsImageableWithSlots` themselves,
	// which is why this is EXACT rather than conservative: a type either predicate refuses has no such imaged
	// box anywhere in the program, so no value of it can be one and the cheaper acquire stays right.
	//
	// ⛔ **A SERVICE HANDLE IS EXCLUDED HERE AND NOT ONLY AT THE SINK DOOR.** A handle's box NAMES a cown
	// whose drop steps two shares; a copy of it is a second name holding one share, which
	// `coOwnConcreteRecordForSink`'s handle arm records as a measured wrong answer. Its `create()` does not
	// construct from params today, so the predicates below would refuse it anyway — but this door is the one
	// that decides which boxes get COPIED, and that gate belongs where the decision is.
	function valueIsAnImageableDeepBox(value ValueId) returns bool
		let key = ((self.tagOf(value).ordinal as ImageableVerdictKey) shl ImageableVerdictTagShift) or (self.valueNameId(value) as ImageableVerdictKey)

		if let known = try self.memos.imageableVerdicts.get(key) 'alreadyAsked'
			return known
		end 'alreadyAsked'

		let frame = self.signatures.openCascadeWalk()
		let verdict = self.imageableDeepBoxVerdict(value)

		if self.signatures.closeCascadeWalk(frame) 'restsOnDeclarationsAlone'
			self.memos.imageableVerdicts.file(key, value: verdict)
		end 'restsOnDeclarationsAlone'

		return verdict
	end 'valueIsAnImageableDeepBox'

	function valueIsImmutableData(value ValueId) returns bool
		if self.valueIsAValueType(value) 'copiedByValue'
			return false
		end 'copiedByValue'

		return self.effectiveCapabilityOf(value) == ValueCapability.immutable or valueIsMarked(self.bodyState.storedIntoImmutableSlot, value: value)
	end 'valueIsImmutableData'

	function imageableDeepBoxVerdict(value ValueId) returns bool
		if self.valueIsAServiceHandle(value) 'aServiceHandle'
			return false
		end 'aServiceHandle'

		if self.tagOf(value) == ValueTypeTag.genericInstance 'aDeclaredContainersBox'
			return self.signatures.declaredContainerBoxIsImageData(self.valueInstanceId(value))
		end 'aDeclaredContainersBox'

		return self.valueIsAHeapRecord(value) and self.signatures.structBoxIsImageableWithSlots(self.valueTypeName(value))
	end 'imageableDeepBoxVerdict'

	// ⭐⭐ **IS THIS VALUE A SERVICE HANDLE? — THE VALUE TIER'S ONE SPELLING, over both tags a handle can
	// stand at.** A monomorphic service's handle is `structRef` at its companion's name; a generic one's is
	// `genericInstance`, because the instantiation rides its type. Each half asks the road's OWN home —
	// `compilerOwnedAggregateOf`'s `isServiceHandle` for the name road, `instanceBaseIsServiceHandle` for the
	// instance road — so this adds no sixth decider, it spends the two that exist.
	//
	// ⚠ **IT ANSWERS A PREDICATE, WHERE `retainCalleeOf` ANSWERS A CALLEE.** A door that needs to know
	// WHICH entry to call must ask that one; this is for a door choosing between two SHAPES of ownership
	// (a share versus a copy), which no callee can express.
	function valueIsAServiceHandle(value ValueId) returns bool
		if self.tagOf(value) == ValueTypeTag.genericInstance 'aGenericServicesHandle'
			return self.signatures.instanceBaseIsServiceHandle(self.valueInstanceId(value))
		end 'aGenericServicesHandle'

		return self.valueIsAHeapRecord(value) and self.signatures.isAnyServiceHandle(self.valueTypeName(value))
	end 'valueIsAServiceHandle'

	// ⭐⭐ **THE RETURNING `__mm_own` A STRUCT BOX OWES A DURABLE SINK — and the callee is chosen HERE rather
	// than in `retainCalleeOf` because a CLONE is right only where the sink outlives the statement.**
	// A borrowed aggregate co-owned into a `var` (`var q = p`) must keep ALIASING — `q.x = 100` shows through
	// to the caller — so that door keeps `__mm_retain`, which hands the same box back. Routing both through
	// one selector would make the aliasing one clone too.
	//
	// ⛔⛔ **AND THAT ARGUMENT IS ABOUT A BOX WHOSE CONTENTS ARE ITS VALUE, WHICH IS NOT EVERY `structRef`.**
	// A box may instead be a NAME for something the runtime counts — a service handle names a cown — and
	// for one of those a copy is not a private version of the same value, it is a second name holding one
	// share. The caller gates such a box out before it reaches here (`coOwnConcreteRecordForSink`'s handle
	// arm); a co-own road added later owes the same gate, because this door cannot tell the two boxes apart
	// and does not try.
	//
	// The result is a distinct ValueId either way, which the sink needs for `emitRetainCall`'s reason.
	function emitOwnBoxForSink(value ValueId, range SourceRange) returns ValueId
		self.markValueCoOwnsHeap(value)
		let owned = self.emitRuntimeCall(MmOwnName, args: argsOf(value), resultTag: self.tagOf(value), resultNameId: self.valueNameId(value), range: range)
		self.carryFromSharedRecord(owned, from: value, source: self.bodyState, path: ValueCarryPath.copy)
		return owned
	end 'emitOwnBoxForSink'

	// ⭐⭐ **THE RETURNING `__mm_own_deep` A BOX WITH POINTER SLOTS OWES — `emitOwnBoxForSink`'s twin over the
	// shape whose SLOTS address other records.** The two differ in the one thing that matters: this one's
	// copy arm is the box's own `__clone_<…>`, stamped as the second argument, where that door's is a byte
	// blit. `MmRuntime.buildMmOwnDeep` carries why a blit cannot serve one.
	//
	// ⚠ **ONLY AN IMMORTAL BOX IS COPIED, WHICH IS WHAT KEEPS THE ALIASING `emitOwnBoxForSink`'S HEADER
	// RESERVES.** An ordinary heap box goes through the counted arm, so `var q = m` still shows
	// `q.upsert(…)` through to `m`; an image record has no aliasing to preserve, because nothing can write
	// it. It is `__managed_retain`'s bargain one representation over.
	//
	// The result is a distinct ValueId either way, which the caller needs for `emitRetainCall`'s reason.
	function emitOwnDeepBoxCopy(value ValueId, range SourceRange) returns ValueId
		self.markValueCoOwnsHeap(value)
		let cloner = self.emitCodeAddress(self.deepBoxCloneCallee(value), range: range)
		let copy = self.emitRuntimeCall(MmOwnDeepName, args: twoArgs(value, second: cloner), resultTag: self.tagOf(value), resultNameId: self.valueNameId(value), range: range)
		self.carryFromSharedRecord(copy, from: value, source: self.bodyState, path: ValueCarryPath.copy)
		return copy
	end 'emitOwnDeepBoxCopy'

	// The `(box) -> newBox` the door above stamps: a declared generic's container clones through its
	// INSTANCE's cloner, a struct through its TYPE's. The value's own tag says which, and it is the tag
	// `valueIsAnImageableDeepBox` forked on to admit it.
	function deepBoxCloneCallee(value ValueId) returns immutable ByteArray
		if self.tagOf(value) == ValueTypeTag.genericInstance 'aDeclaredContainersBox'
			return self.signatures.genericInstanceBoxCloneCallee(self.valueInstanceId(value))
		end 'aDeclaredContainersBox'

		return self.signatures.structBoxCloneCallee(self.valueTypeName(value))
	end 'deepBoxCloneCallee'

	function unsharedByteRecord(value ValueId, range SourceRange) returns ValueId
		self.removeFromPendingTemps(value)

		let unshared = self.emitOwnedRuntimeResult(StrUnshareName, args: argsOf(value), resultTag: self.tagOf(value), resultNameId: self.valueNameId(value), range: range)
		self.carryValueFacts(unshared, from: value, source: self.bodyState, path: ValueCarryPath.value)

		return unshared
	end 'unsharedByteRecord'

	function unsharedStoredByteRecord(stored ValueId, range SourceRange) returns ValueId
		if not tagIsByteRecord(self.tagOf(stored)) or not self.valueIsOwnedHeap(stored) or self.valueIsSoleHeapOwner(stored) 'nothingShared'
			return stored
		end 'nothingShared'

		let unshared = self.unsharedByteRecord(stored, range: range)
		self.removeFromPendingTemps(unshared)

		return unshared
	end 'unsharedStoredByteRecord'

	// ⭐⭐ **THE REFERENCE A REBIND FROM AN IMMUTABLE SOURCE OWES**
	// (`bindingTakesItsOwnReference` and `rebindSourceIsAnImmutableAlias` carry the rule; this is what it
	// costs). The source is NOT poisoned, so it keeps the drop it has always owed; this binding is enrolled
	// in `ownedBindings` and owes one too, so it must hold a reference of its own or one box is released
	// twice. That is the same co-ownership the 2026-08-12 durable-store ruling gives a field, an element and
	// a by-reference parameter's cell (`storeOwnedValueIntoDurableSink`) — the difference is only WHO owns
	// the result, which is why that door cannot be reused verbatim: there the new owner is a SLOT and the
	// result is marked nothing, here it is a BINDING and the result must carry the owned-heap bit.
	//
	// ⚠ **THE FRESH SSA NAME IS LOAD-BEARING, NOT A BY-PRODUCT OF WHICH RUNTIME ENTRY WAS HANDY.** Both
	// entries RETURN the reference they took (`__mm_retain`'s whole reason for existing beside the void
	// `__mm_incref` — see `retainBorrowedAggregate`), so this binding holds an id the source does not: a
	// later move out of either name resolves to exactly one owner, where a shared id would let
	// `liveOwnerIndexOf` pick the wrong binding and poison — or drop — the other one's reference.
	//
	// ⚠ **AND IT MUST CARRY THE PER-VALUE COLUMNS ACROSS THAT FRESH NAME**, and the immutable-global taint is
	// the one whose loss is not an `E2015` but a WRITE that reaches a record the language calls immutable. The
	// retain entries carry them (`carryValueFacts`), and the existential retain carries the interface witness
	// beside them (`carryInterfaceWitness`).
	//
	// ⚠ **`promoteBorrowedToOwned` IS THE NEAREST-LOOKING SIBLING AND IS NOT THIS.** Its precondition is a
	// BORROWED value (its own `panic` says so), and both of its answers are wrong here: at the `binding`
	// door a byte record COPIES, and at `merged` a trivial tuple COPIES — where this door's whole subject is
	// a value the source still owns, whose IDENTITY the two names must go on sharing. What the two have in
	// common is the column carry, which is why that is called and not re-spelled.
	function coOwnImmutableRebindSource(value ValueId, range SourceRange) returns ValueId
		// **THE SPLIT IS "IS THERE A SECOND OWNER TO KEEP ALIVE?"** — `storeOwnedValueIntoDurableSink`'s
		// split, asked here for its reason and answered the same way. An owned value NO BINDING holds has no
		// other owner at all, so this binding ADOPTS the `+1` it was handed and the caller's
		// `removeFromPendingTemps` cancels the statement-end drop; an incref/decref pair around a value
		// nothing else releases is pure churn. The shape that reaches it is a `for` element — declared
		// IMMUTABLE (`declareLoopVariable`) and enrolled in no owned set, so it satisfies the alias rule
		// while owning its value through the statement rather than through a name.
		if not self.hasLiveOwner(value) 'ownedTemporaryIsAdopted'
			return value
		end 'ownedTemporaryIsAdopted'

		return self.retainBorrowedByteRecord(value, range: range) if tagIsByteRecord(self.tagOf(value)) else self.retainBorrowedAggregate(value, range: range)
	end 'coOwnImmutableRebindSource'

	function coOwnAggregateAsTemp(source ValueId, range SourceRange) returns ValueId
		let owned = self.retainBorrowedAggregate(source, range: range)

		// `coOwned` restates the retain above rather than contradicting it — this call adds the statement-scoped
		// DROP obligation and must not launder the ownership claim while it is there.
		self.trackOwnedTemp(owned, exclusivity: OwnedHeapExclusivity.coOwned)
		return owned
	end 'coOwnAggregateAsTemp'

	function operandIsFollowed(position OperandSuccession) returns bool
		return match position 'position'
			alwaysFollowed gives true
			beforeComma gives self.kindAt(self.pos) == TokenKind.comma
			receiverBeforeArguments gives self.kindAt(self.pos) != TokenKind.rightParen
			memberReceiverBeforeArguments gives self.receiverTakesArgumentsAt(self.pos)
		end 'position'
	end 'operandIsFollowed'

	function receiverTakesArgumentsAt(dotIndex ElementIndex) returns bool
		return self.memberCallFollows(dotIndex) and self.kindAt(dotIndex + ReceiverDotBeforeArgumentList) != TokenKind.rightParen
	end 'receiverTakesArgumentsAt'

	function markLateReads() returns LateReadMark
		return LateReadMark.create(self.bodyState.currentBlock.id, position: self.bodyState.currentBlock.bodyOpCount(), rangeSites: self.bodyState.rangeCheckSites.count())
	end 'markLateReads'

	function deferReadsSince(mark LateReadMark)
		if self.bodyState.currentBlock.id != mark.block or self.bodyState.rangeCheckSites.count() != mark.rangeSites 'theWalkMovedPositions'
			panic("deferReadsSince: a path walk changed blocks or filed a position-keyed site, so its ops cannot be placed after the values that follow it")
		end 'theWalkMovedPositions'

		for position in mark.position upto self.bodyState.currentBlock.bodyOpCount() 'eachWalkOp'
			let opIdx = try self.bodyState.currentBlock.bodyOpAt(position) otherwise panic("deferReadsSince: bodyOpAt OOB at {position} of {self.bodyState.currentBlock.bodyOpCount()}")
			let walkOp = try self.artifact.module.ops.get(opIdx) otherwise panic("deferReadsSince: ops.get OOB at {opIdx}")

			if maxonOpCalleeKind(walkOp) != MaxonCalleeKind.noCallee 'aCallingWalkStaysWhereItRan'
				return
			end 'aCallingWalkStaysWhereItRan'
		end 'eachWalkOp'

		let window = self.detachOpRefsAbove(self.bodyState.currentBlock, mark: mark.position)

		if window.count() == 0 'nothingWasRead'
			return
		end 'nothingWasRead'

		let defined = ValueIdArray.create(0)

		for opIdx in window 'eachDetachedOp'
			let detached = try self.artifact.module.ops.get(opIdx) otherwise panic("deferReadsSince: ops.get OOB at {opIdx}")
			let id = try maxonOpDefinedValue(detached) otherwise continue
			defined.push(id)
		end 'eachDetachedOp'

		self.bodyState.lateReads.push(LateRead.create(window, defined: defined))
	end 'deferReadsSince'

	function emitBodyOp(block IrBlock, op MaxonOp, range SourceRange)
		if self.bodyState.lateReads.count() > 0 'someReadIsLate'
			self.attachLateReadsOf(block, op: op)
		end 'someReadIsLate'

		let opIdx = self.artifact.module.ops.count()
		self.artifact.emitOp(block, op: op, range: range)

		if self.bodyState.anyLinearOwned and opMayWaitForAnotherParty(op) 'aSuspensionPoint'
			self.noteLinearLiveAcrossOp(opIdx)
		end 'aSuspensionPoint'
	end 'emitBodyOp'

	function emitBodyTerminator(block IrBlock, op MaxonOp, range SourceRange)
		if self.bodyState.lateReads.count() > 0 'someReadIsLate'
			self.attachLateReadsOf(block, op: op)
		end 'someReadIsLate'

		self.artifact.emitTerminator(block, op: op, range: range)
	end 'emitBodyTerminator'

	function deferHoldOfLateRead(source ValueId, kind HoldKind, range SourceRange) returns ValueId
		let (held, holdOp) = self.openHold(source, kind: kind, range: range)
		self.artifact.emitOp(self.bodyState.currentBlock, op: holdOp, range: range)
		_ = try self.bodyState.currentBlock.popBodyOp() otherwise panic("deferHoldOfLateRead: the hold just emitted is not the last op of its block")
		let landed = self.artifact.module.ops.count() - 1
		let position = try self.positionOfLateRead(source) otherwise panic("deferHoldOfLateRead: v{source} is a late read, so one window defines it")
		let window = try self.bodyState.lateReads.remove(position) otherwise panic("deferHoldOfLateRead: lateReads.remove OOB at {position}")
		window.addHold(LateHold.create(landed, held: held))
		self.bodyState.lateReads.insert(position, value: window)
		return held
	end 'deferHoldOfLateRead'

	function positionOfLateRead(value ValueId) returns ElementIndex throws AbsentError
		for position in 0 upto self.bodyState.lateReads.count() 'eachLateRead'
			let late = try self.bodyState.lateReads.get(position) otherwise panic("positionOfLateRead: lateReads.get OOB at {position}")

			if late.defines(value) 'defined'
				return position
			end 'defined'
		end 'eachLateRead'

		throw AbsentError.absent
	end 'positionOfLateRead'

	function attachLateReadsOf(block IrBlock, op MaxonOp)
		let operands = ValueIdArray.create(0)
		maxonOpOperandValues(op, into: operands)
		self.attachLateReadsFor(block, values: operands)
	end 'attachLateReadsOf'

	function attachLateReadsFor(block IrBlock, values ValueIdArray)
		var position = 0 as ElementIndex

		while position < self.bodyState.lateReads.count() 'eachLateRead'
			if not self.lateReadDefinesAnyOf(position, values: values) 'notRead'
				position = position + 1
				continue
			end 'notRead'

			self.attachLateRead(block, position: position)
			_ = try self.bodyState.lateReads.remove(position) otherwise panic("attachLateReadsFor: remove OOB at {position} of {self.bodyState.lateReads.count()}")
		end 'eachLateRead'
	end 'attachLateReadsFor'

	function lateReadDefinesAnyOf(position ElementIndex, values ValueIdArray) returns bool
		let late = try self.bodyState.lateReads.get(position) otherwise panic("lateReadDefinesAnyOf: lateReads.get OOB at {position}")

		for value in values 'eachValue'
			if late.defines(value) 'read'
				return true
			end 'read'
		end 'eachValue'

		return false
	end 'lateReadDefinesAnyOf'

	function attachLateRead(block IrBlock, position ElementIndex)
		let late = try self.bodyState.lateReads.get(position) otherwise panic("attachLateRead: lateReads.get OOB at {position}")

		for opIdx in late.ops 'eachOp'
			block.pushBodyOp(opIdx)
		end 'eachOp'

		for hold in late.holds 'eachHold'
			block.pushBodyOp(hold.opIndex)
			self.trackOwnedTemp(hold.held, exclusivity: OwnedHeapExclusivity.coOwned)
		end 'eachHold'
	end 'attachLateRead'

	function valueIsALateRead(value ValueId) returns bool
		for late in self.bodyState.lateReads 'eachLateRead'
			if late.defines(value) 'defined'
				return true
			end 'defined'
		end 'eachLateRead'

		return false
	end 'valueIsALateRead'

	function settleLateReads(floor ElementIndex)
		if self.bodyState.lateReads.count() <= floor 'noneOfThisStatementIsLate'
			return
		end 'noneOfThisStatementIsLate'

		for position in floor upto self.bodyState.lateReads.count() 'eachLateRead'
			self.attachLateRead(self.bodyState.currentBlock, position: position)
		end 'eachLateRead'

		self.bodyState.lateReads.truncate(floor)
	end 'settleLateReads'

	function callSuccession(base OperandSuccession, target CallArgTarget, rule ArgLabelRule, written Count) returns OperandSuccession
		if target.runsUserCode() or self.calleeFillsDefaultsAfter(target, rule: rule, written: written) 'somethingRunsAfterTheLastOperand'
			return OperandSuccession.alwaysFollowed
		end 'somethingRunsAfterTheLastOperand'

		return base
	end 'callSuccession'

	function calleeFillsDefaultsAfter(target CallArgTarget, rule ArgLabelRule, written Count) returns bool
		let callee = try target.declaredName() otherwise panic("calleeFillsDefaultsAfter: a witness dispatch names no callee, and `callSuccession` answers it from `runsUserCode` before asking")
		let receiverSlots = self.serviceMessageFirstParam(callee) if rule == ArgLabelRule.messageSend else NoReceiverSlots

		// Asked before inference picks a template, so any template that would fill a default counts: an
		// unheld last argument is freed by a default that runs after it.
		if self.signatures.isGenericFunctionKey(callee) and self.anyGenericTemplateOmitsAParameter(callee, written: written, receiverSlots: receiverSlots) 'aTemplateMayOmitAParameter'
			return true
		end 'aTemplateMayOmitAParameter'

		if not self.signatures.declaresParamDefaults(callee) 'everyParameterRequired'
			return false
		end 'everyParameterRequired'

		return match self.signatures.defaultsOf(callee) 'defaults'
			allRequired gives false
			defaults(info) gives omittedParametersRemain(info.paramNames.count(), written: written, receiverSlots: receiverSlots)
		end 'defaults'
	end 'calleeFillsDefaultsAfter'

	function anyGenericTemplateOmitsAParameter(callee ByteArray, written Count, receiverSlots ParamCount) returns bool
		for template in self.genericTemplatesNameableHere(callee, mint: CalleeMint.notMinted) 'eachTemplate'
			if omittedParametersRemain(sweptParamNamesFor(template.paramNames, takesReceiver: template.takesReceiver, selfCapability: ParamCapability.unmarked).count(), written: written, receiverSlots: receiverSlots) 'moreDeclared'
				return true
			end 'moreDeclared'
		end 'eachTemplate'

		return false
	end 'anyGenericTemplateOmitsAParameter'

	function literalSuccession(layout StructLayout, filled FixedBoolArray, current FieldIndex) returns OperandSuccession
		for i in 0 upto layout.fieldCount() 'eachField'
			if i == current or (try filled.get(i) otherwise panic("literalSuccession: filled.get OOB at {i} — the column is sized to the layout's field count")) 'notOmitted'
				continue
			end 'notOmitted'

			match fieldDefaultFill(layout, index: i) 'declared'
				none or
				literal then continue
				callsHelper then return OperandSuccession.alwaysFollowed
			end 'declared'
		end 'eachField'

		return OperandSuccession.beforeComma
	end 'literalSuccession'

	function holdIsOwedAt(value ValueId, position OperandSuccession) returns bool
		return self.operandIsFollowed(position) and self.valueIsAStorageRead(value) and self.holdIsOwed(value) and self.restOfStatementMayWriteStorageOf(value)
	end 'holdIsOwedAt'

	// A cell is reachable only through its name, so a hold on a read of one is owed only where the
	// rest of the statement names it, and an unneeded hold permanently downgrades the cell's epoch.
	function restOfStatementMayWriteStorageOf(value ValueId) returns bool
		let read = try cellOccupantReadOf(self.bodyState.cellOccupantReads, occupant: value) otherwise return true
		return self.restOfStatementNames(read.binding.name)
	end 'restOfStatementMayWriteStorageOf'

	function restOfStatementNames(name ByteArray) returns bool
		let statementEnd = statementEndIndexIn(self.tokens, start: self.pos, blockShiftAt: function(index) gives self.blockShiftAt(index))

		for q in self.pos upto statementEnd 'walk'
			if tokenCanBeAName(self.tokenAt(q)) and self.tokenAt(q).value.equals(name) 'namesTheBinding'
				return true
			end 'namesTheBinding'
		end 'walk'

		return false
	end 'restOfStatementNames'

	function blockShiftAt(index ElementIndex) returns BlockShift
		if self.opensBlockAt(index) 'opens'
			return BlockShift.opens
		end 'opens'

		if self.closesBlockAt(index) 'closes'
			return BlockShift.closes
		end 'closes'

		return BlockShift.none
	end 'blockShiftAt'

	function holdStorageReadForStatement(value ValueId, kind HoldKind, range SourceRange, position OperandSuccession) returns ValueId
		if not self.holdIsOwedAt(value, position: position) 'nothingToHold'
			return value
		end 'nothingToHold'

		return self.emitOperandHold(value, kind: kind, range: range)
	end 'holdStorageReadForStatement'

	function holdCallOperand(value ValueId, target CallArgTarget, passing OperandPassing, range SourceRange, position OperandSuccession) returns ValueId
		if not self.holdIsOwedAt(value, position: position) 'nothingToHold'
			return value
		end 'nothingToHold'

		return self.emitOperandHold(value, kind: operandHoldKindOf(passing, valueKind: target.operandHoldKind(self.effectiveCapabilityOf(value) == ValueCapability.immutable)), range: range)
	end 'holdCallOperand'

	function emitOperandHold(value ValueId, kind HoldKind, range SourceRange) returns ValueId
		if self.holdReplacesItsSource(value) and not kind.mayReplaceItsSource() 'theDoorCannotNameTheHeldReference'
			return value
		end 'theDoorCannotNameTheHeldReference'

		let late = self.valueIsALateRead(value)
		let held = self.deferHoldOfLateRead(value, kind: kind, range: range) if late else self.emitHoldMarker(value, kind: kind, range: range)

		if not late 'owedFromNow'
			self.trackOwnedTemp(held, exclusivity: OwnedHeapExclusivity.coOwned)
		end 'owedFromNow'

		self.noteReadHeld(value)
		return held if self.holdReplacesItsSource(value) else value
	end 'emitOperandHold'

	// ⭐ **MAKE A BORROWED MANAGED VALUE OWNED — the ONE `String`-copy-vs-aggregate-retain decision every site
	// that needs an owned value out of a borrowed one must make.** A borrowed value cannot be enrolled as
	// owned as-is: its owner is elsewhere, so a scope-exit drop would free the caller's box a second time. So
	// it is promoted — a String COPIES into a fresh owned record (value semantics), a struct/union INCREFS the
	// shared box (reference semantics: an aggregate has no cheap owning copy and its alias is observable
	// through a field write). The caller has already established that `value` is a BORROWED managed heap value
	// (`valueIsManagedHeap and not valueIsOwnedHeap`), so the two arms are exhaustive and a scalar — which owns
	// no heap and never reaches an owned binding — is a parser invariant break, not an unhandled case.
	//
	// ⭐⭐ **THREE DOORS, NOT TWO.** A DECLARATION (`var q = p`), a REASSIGNMENT (`q = p2`), and a HAND-OFF —
	// a `return` (`emitOwnedValueReturn`) and a match/ternary arm merged into an owned result phi
	// (`promoteBorrowedGive`). Co-owning across a call boundary needs no cross-call consume: the callee
	// increfs, the caller adopts and decrefs once, and the borrow's own owner is untouched — the refcount is
	// balanced on every path, which is exactly what this incref already buys inside one frame. The value
	// oracle settles the SEMANTICS the incref implies: a `return self` whose result is written through shows
	// the write on the receiver — `p.x=5 q.x=5`.
	//
	// ⚠ Single-sourced BECAUSE the two callers straddle a boundary that lets them drift: a reassignment path
	// spelling only the String half (`promoteToOwnedString`) string-promotes a borrowed STRUCT on `q = p2` —
	// a blit of the struct's fields as a fused String record, a SILENT miscompile the type checker waves
	// through (both sides are the same aggregate type) and the suite stays green over. Routing both sites
	// here makes a divergence a compile error rather than a wrong answer.
	//
	// ⚠⚠ **AN AGGREGATE READ OUT OF AN IMMUTABLE GLOBAL STAYS MARKED.** The aggregate arm promotes by
	// INCREF — the owner becomes a second owner of the SAME box, deliberately, because the alias is
	// observable — so a mutable binding of a value read from a `let`-declared global names a record the
	// language says is immutable, through BOTH callers: the declaration `var b = A` and the reassignment
	// `b = A`. The promoted value carries the immutable-global mark, and the doors that WRITE refuse it (see
	// `ownedFormOfBorrowedValue`'s `aggregate` arm). A String source never reaches it — the text arm
	// COPIES, which is why `var b = <a String let>` stays legal and correct.
	//
	// Widening the incref into a copy is not an option here — a borrowed array bound to a `var` SHARES when
	// the source is mutable, for a parameter, say — so copying would change a
	// defined answer rather than fix an undefined one.
	//
	// ⭐ **THE PER-VALUE SURFACE COLUMN RIDES ACROSS, HERE AND NOT IN ANY ARM.** All three arms mint a
	// ValueId distinct from `value` — that is what makes them promotions — and the buffer-surface provenance
	// is keyed by ValueId, so it must be carried or a promoted `__ManagedMemory` stops answering on its own
	// roster. One line at the door rather than one per arm.
	function promoteBorrowedToOwned(value ValueId, door BorrowLaunderDoor, range SourceRange) returns ValueId throws SourceParseError
		let promoted = try self.ownedFormOfBorrowedValue(value, door: door, range: range)
		self.carryValueFacts(promoted, from: value, source: self.bodyState, path: ValueCarryPath.value)
		return promoted
	end 'promoteBorrowedToOwned'

	// ⭐ **WHICH VALUES THE DOOR ABOVE HAS AN ANSWER FOR** — the entry condition of a hand-off that must leave
	// its new owner with a reference of its own. Written once because a door whose condition is NARROWER than
	// the door's answer set silently declines a shape its sibling promotes: spelled `valueIsManagedHeap`, the
	// merge-edge door dropped a generic body's borrowed opaque `T` into `promoteBorrowedGive`'s
	// unreachable-case panic while the `if`/`return` spelling of the same function compiled.
	//
	// It gates every such door: a `return` (`emitOwnedValueReturn`), a `match`/ternary arm's give
	// (`promoteBorrowedGive`), a `try … otherwise` fallback (`finishValueTry`) and a rebind of a
	// binding in the owned set, so narrowing it narrows all four.
	//
	// A scalar owns no heap and owes nothing, and neither does a deferred call result. An
	// already-owned value has already discharged the hand-off.
	function borrowedValueOwesAHandoffReference(value ValueId) returns bool
		return (self.valueIsManagedHeap(value) or self.tagOf(value) == ValueTypeTag.typeParameter) and not self.valueIsOwnedHeap(value)
	end 'borrowedValueOwesAHandoffReference'

	// The protocol choice `promoteBorrowedToOwned` is written around — RETAIN a String at a hand-off and COPY
	// it at a `binding`, copy a trivial tuple at a hand-off, take an opaque `T`'s reference through its
	// instance descriptor, incref anything else — split out so the surface carry above can wrap all of them
	// without being written into each. Every word of that door's header describes this body; it is
	// called from nowhere else.
	function ownedFormOfBorrowedValue(value ValueId, door BorrowLaunderDoor, range SourceRange) returns ValueId throws SourceParseError
		// ⭐⭐ **THE ONE TYPE THE BODY CANNOT NAME.** A shared generic body's opaque `T`
		// is neither a byte record nor an aggregate, so every arm below declines it — it takes its reference
		// through the enclosing instance's descriptor instead, whose `retainFunc@64` is `__str_clone` for a
		// byte record, `__mm_retain` for a managed aggregate and 0 — a no-op — for an instantiation that owns
		// nothing.
		//
		// ⭐ **IT IS ASKED AT THE SHARED DOOR BECAUSE THREE DOORS OWE THIS REFERENCE, NOT TWO.** A RETURN out
		// of the body, a STORE into a durable slot (`moveOpaqueValueInto`, which reaches `coOwnBorrowedOpaque`
		// on its own consume path) and a MERGE EDGE — a `match`/ternary arm's borrowed give, and a
		// `try … otherwise` fallback — each hand a borrowed `T` to an owner that will release it. The merge
		// edge is a door that needs wiring of its own: `return front if c else back` over an `Array with Element`'s
		// borrowed `first()` and owned `last()` PANICKED the parser in `promoteBorrowedGive`, while the same
		// program written as an `if`/`return` pair compiled and ran, because only the return road asked.
		if self.tagOf(value) == ValueTypeTag.typeParameter 'opaqueElement'
			try self.requireCapturedOpaqueHoldsNoGreenThread(value, range: range)
			return self.coOwnBorrowedOpaque(value, range: range)
		end 'opaqueElement'

		if tagIsByteRecord(self.tagOf(value)) 'byteRecord'
			// ⭐⭐ **A MERGE EDGE CO-OWNS WHERE THE OTHER TWO DOORS COPY, AND THE DIFFERENCE IS A WRITE THAT MUST
			// REACH THE CALLER.** `grow(make() if c else s)` hands the phi to a callee that WRITES it, so a
			// copy of the `s` edge is a write nobody sees: MEASURED `v=ab` against the oracle's `v=abXY`. The
			// split is by DOOR rather than by widening the copy away because the other two doors have their own
			// settled answers and no measured defect: a BINDING becomes a new owner in this frame — which is
			// what keeps `var b = <a String let>` legal (see the immutable-global refusal below, whose soundness
			// rests on the text arm copying) — and a `return` a new owner in the CALLER's, which is what makes a
			// `try f() otherwise <owned>` merge's ok edge provably a heap record rather than its caller's
			// literal.
			//
			// ⚠ **AND IT CANNOT BE `emitIncref`, BECAUSE THE PARSER CANNOT KNOW WHICH KIND OF RECORD THIS IS.**
			// A borrowed `String` parameter is heap when its caller owned one and immortal `.rdata` when its
			// caller wrote a literal, and `pick(v, …)` / `pick("ab", …)` over one `pick(s String, …)` differ in
			// nothing this frame can read. `__str_retain` is that decision, made where it can be — off the
			// record's own `capacity@16`. See its header for the two measurements that bound it on both sides.
			// ⭐⭐ **A HAND-OFF RETAINS, IT DOES NOT COPY — `__str_retain`, WHICH IS THE ONLY PARTY THAT CAN
			// TELL AN IMMORTAL LITERAL FROM A HEAP RECORD.** Both hand-off doors take this arm: a MERGE edge
			// takes it (a copy of one edge is a write nobody sees — `grow(make() if c else s)` printed
			// `v=ab` against the oracle's `v=abXY`), and so does a `return`. The property the return
			// door would copy FOR is preserved: `__str_retain` clones an immortal `.rdata` literal and
			// increfs a heap record, so what the caller adopts is an owned, independently-droppable record
			// either way — which is exactly what makes a `try f() otherwise <owned>` merge's ok edge
			// provably a heap record rather than its caller's literal.
			//
			// ⛔⛔ **COPYING A RETURNED BORROWED STRING IS AGAINST THE LANGUAGE.** Maxon is single-ownership
			// with reference semantics — *"everything is a reference; if you want a copy you do it explicitly
			// with `clone()`"* (user ruling) — so a `return name` handing back a DIFFERENT record than the `name`
			// it was given is a copy the author did not write, and the caller's value stops being the callee's.
			// The rule is the reason; the cost is not.
			//
			// ⚠ **THE `binding` DOOR STILL COPIES.** Its copy is load-bearing for a different rule: it is what
			// keeps `var b = <a String let>` legal.
			if borrowLaunderDoorIsHandOff(door) 'handOff'
				return self.retainBorrowedByteRecord(value, range: range)
			end 'handOff'

			return self.promoteToOwnedString(value, range: range)
		end 'byteRecord'

		// ⭐ **A TRIVIAL TUPLE HANDED OFF GETS ITS OWN RECORD, AND IT IS ASKED BEFORE THE AGGREGATE ARM
		// BECAUSE A TUPLE IS A `structRef` THAT ARM WOULD INCREF INSTEAD.** The caller adopts and frees whatever
		// a `returns (…)` hands back, and a TRIVIAL tuple — unlike a struct — may simply be COPIED: the only way
		// to obtain one is the expression that produced it, so within the set `valueIsCopyableTuple` admits there
		// is no prior identity to break (see `moveManagedValueInto` for the full argument). Without it,
		// `function echo(t (Num, Num)) returns (Num, Num) return t end` would share one record where a tuple's
		// whole point is that it does not.
		//
		// ⚠ **A MANAGED-ELEMENT tuple is NOT admitted and therefore falls through to the INCREF, which is
		// the defined answer** — writing through a returned `(String, Num)` shows on the source (`a.1=99
		// b.1=99`), while the trivial spelling one line over does not (`a.1=3 b.1=99`). So the split is
		// not "tuples have no identity" — a managed one demonstrably does — it is that a shallow copy of
		// a managed element would free one String twice, and the incref is the sound answer available
		// today.
		//
		// ⚠ It is gated on the door because a BINDING is not a hand-off: `var q = t` aliases (see
		// `borrowLaunderDoorIsHandOff`), so copying there would change a defined answer.
		//
		// ⚠ **IT SITS AHEAD OF THE IMMUTABLE-GLOBAL ARM BELOW, AND THAT ORDER IS SOUND RATHER THAN
		// LUCKY.** That arm carries the mark across an INCREF because an incref hands back the SAME
		// record; a COPY carries nothing — the fresh record is a different record, and writing it cannot
		// reach the global — which is the same reason the `byteRecord` arm above is already ahead of it.
		// So a marked TUPLE is copied and comes out UNMARKED, which is the right answer and not a hole.
		// It cannot arise today (a top-level global cannot hold a tuple: `let A = (1, 2)` is E2010), and
		// the day one can, copying is what keeps the global immutable.
		if borrowLaunderDoorIsHandOff(door) and self.valueIsCopyableTuple(value) 'copyableTuple'
			return self.copyTupleValue(value, range: range)
		end 'copyableTuple'

		if self.valueIsNonTextAggregate(value) 'aggregate'
			return self.retainBorrowedAggregate(value, range: range)
		end 'aggregate'

		panic("ownedFormOfBorrowedValue: v{value} is neither text nor a managed aggregate — the caller has already gated on `valueIsManagedHeap`, so a borrowed value promoted to owned is always a String (retained at a hand-off, copied at a binding) or a struct/union box (retain); a scalar owns no heap and never reaches an owned binding's promotion")
	end 'ownedFormOfBorrowedValue'

	// ⭐⭐ **MINT THE ONE OWNED REFERENCE A RESULT PHI'S BORROWED EDGE OWES IT, INTO THAT EDGE'S OWN BLOCK.**
	// The `merged` door has TWO callers — a `match`/ternary arm (`promoteBorrowedGive`) and a
	// `try … otherwise <expr>` fallback (`finishValueTry`) — and they owe the phi the identical THREE steps, of
	// which only the block differs. Spelled at both sites they were held together by a comment reading *"exactly
	// as `promoteBorrowedGive` does"*, which is a test nobody wrote: a third obligation added to one edge kind
	// would not fail to compile at the other, it would silently leak or double-free on the arm that missed it.
	//
	// The three steps, and why each:
	//   • EMIT INTO THE EDGE, not into `currentBlock`. A match arm's promotion belongs in its still-unterminated
	//     exit block, or the incref runs on the path that did not take the arm. `finishValueTry` passes the
	//     block it is already in (`errEnd`), so the save/restore is inert there and the rule stays stated once.
	//   • PROMOTE through the one door — a String copies, a trivial tuple gets its own record, an aggregate
	//     increfs.
	//   • DE-LIST it from the statement's pending temps. The phi owns it now; a statement-end drain would free a
	//     record the merged result still holds. ⚠ And this is why the promotion must NOT also be handed to
	//     `transferFallbackToPhi`: a retain mints a fresh SSA name that is no pending temp, so that helper would
	//     read it as an aliased BINDING and incref a second time — a leak. `transferFallbackToPhi` settles an
	//     ALREADY-OWNED edge, which is the other branch of the question, not a further step of this one.
	function promoteBorrowedMergeEdge(value ValueId, edgeBlock IrBlock, anchor Token) returns ValueId throws SourceParseError
		let saved = self.bodyState.currentBlock
		self.bodyState.currentBlock = edgeBlock

		let owned = try self.promoteBorrowedToOwned(value, door: BorrowLaunderDoor.merged, range: SourceRange.ofToken(anchor))
		self.removeFromPendingTemps(owned)

		if owned != value and not self.valueIsCopyableTuple(value) 'anAliasOfTheEdge'
			self.carryCapabilityToAlias(value, target: owned)
			self.carryImmutableSlotRead(value, target: owned)
			self.carryIsolatedPartRead(owned, arm: value)
		end 'anAliasOfTheEdge'

		self.bodyState.currentBlock = saved
		return owned
	end 'promoteBorrowedMergeEdge'

	// ⭐ **DROP EVERY OWNED TEMPORARY THE STATEMENT LEFT UNCONSUMED**, in REVERSE creation order (the
	// `emitScopeDrops` convention — the last built is the first torn down), into `currentBlock`. Called at
	// the end of a statement, so the drop lands exactly where control is when the statement finishes: a loop
	// body, an `if` branch, a short-circuit merge. Clears the list — a temporary belongs to ONE statement.
	//
	// `anchor` is the statement's own token; no source token spawns a drop, so it rides the statement that
	// made control leave the temporary's lifetime, exactly as `emitFunctionExit` rides the `return`.
	// ⭐ **RELEASE EVERY PENDING TEMPORARY ABOVE `floor`, AND FORGET THEM.** `WholeStatementTempFloor` ends
	// the whole list (a statement's tail, a hand-off exit); a REGION passes the height it recorded before
	// parsing itself, so it releases what IT built and leaves the enclosing statement's temporaries alone.
	// That distinction is the whole point: an `if` inside `let v = f("{x}", …)` must not release the
	// interpolation `f` has not been handed yet.
	//
	// A floor ABOVE the current count is not an error and does nothing — the list is *shorter* than the
	// region's start only when something already released past it (a `return` inside a match arm drains the
	// whole list on its own edge), and there is then nothing left for the region to release.
	//
	// ⚠ **THE REGIONS THAT MUST CALL THIS, WRITTEN DOWN ONCE — TEACH A NEW ONE HERE.** Every construct that
	// FORKS owes its own temporaries a release in a block their definitions dominate; miss one and the shape
	// is a leak (a release on too few paths) or a release of a value the taken path never built (which the
	// register allocator reports, several passes later, as "a use dominates its def"):
	//   • `parseIfStatement` / `parseWhileStatement` — the condition, in its exit block before the branch,
	//     EXCEPT a CATCHING `if`, whose condition is a fork and releases them at the head of EACH EDGE
	//     (`takeCatchingForkTemps`). That is not `openTryFork`'s rule: an `if`'s condition is finished
	//     when it branches, so its temporaries are dead on both edges, while an expression-level `try`
	//     forks mid-expression and its operands are not;
	//   • `parseMatchCommon` — the scrutinee before the first test, and each ARM at its own exit
	//     (`finishArmExit`, which releases the arm's SCOPE-lifetime records in the same block and by the same
	//     rule);
	//   • `parseTernaryExpression` — the condition, and each of the two arms (`finishArmExit` again);
	//   • `emitShortCircuit` — the right-hand side, which runs on one path only;
	//   • `desugarTry` — the odd one out, and deliberately: its fork temporaries belong to the ENCLOSING
	//     EXPRESSION, which is only half-built at the fork, so they are LIVE past it on every PATH that goes
	//     on to finish that expression. For the handler's parse they leave this list entirely
	//     (`takeForkTemps`) and are enrolled as anonymous OWNED BINDINGS
	//     (`suspendForkTempsAsOwned`), so that each abandoning path releases them through its own scope drop;
	//     `resumeForkTemps` hands them back for the paths that merge. Never swept here.
	// There is no automatic check behind this list, and that is a known gap rather than an oversight: the
	// flat list is always drained by *something* downstream, so an end-of-parse "nothing left over" assertion
	// cannot see a release that landed in the wrong BLOCK — the defect this discipline exists to prevent. A
	// real guard needs a def-block per temporary plus a dominance query. `specs/block-condition-temporaries.md`
	// pins one case per region in the meantime, and the leak gate (`!= 0`, so it catches an over-release too)
	// is what makes those cases fail loudly.
	function drainPendingTemps(floor ElementIndex, anchor Token)
		self.emitTempDrops(self.bodyState.pendingTempDrops, floor: floor, anchor: anchor)

		self.bodyState.pendingTempDrops.truncate(floor)
	end 'drainPendingTemps'

	// ⭐⭐ **SUSPEND THE ENCLOSING EXPRESSION'S PENDING TEMPORARIES FOR THE DURATION OF A `try` HANDLER — the
	// pair `desugarTry` brackets its handler parse with, and the whole of what makes an abandoning path
	// release them without this file knowing which paths abandon.**
	//
	// `takeForkTemps` moves them OFF `pendingTempDrops`, because a handler's own drains
	// (`emitHandoffExit` behind an `otherwise return`, a handler block's statement tails) read the WHOLE
	// list with a whole-statement floor: left in place they would release values the ok edge still owns AND
	// FORGET them, leaking on that path. It COPIES rather than moving the field's array — a handle taken out
	// of a field that is then reassigned is the exact shape that once crashed this parser (`emitTempDrops`
	// reading a pointer-shaped word where a `ValueId` belonged) — and the list is empty for almost every
	// `try`, so the copy is one empty-array `create` and nothing else.
	function takeForkTemps() returns ValueIdArray
		let taken = ValueIdArray.create(self.bodyState.pendingTempDrops.count(), zeroed: false)

		for temp in self.bodyState.pendingTempDrops 'eachPending'
			taken.push(temp)
		end 'eachPending'

		self.bodyState.pendingTempDrops = ValueIdArray.create(0)
		return taken
	end 'takeForkTemps'

	// ⭐⭐ **AND ENROL THEM AS ANONYMOUS OWNED BINDINGS, WHICH IS WHERE THE RELEASE ACTUALLY COMES FROM.**
	// `parseOtherwiseHandler` makes the identical enrolment one level in for the caught error box, and states
	// the reason this one exists too: *"so a terminating form's own `emitScopeDrops` releases it"*. Every
	// path that leaves the enclosing expression already funnels through a scope drop with a FLOOR — a
	// hand-off exit through the whole-function one, a `break`/`continue` through its target's — so putting
	// the temporaries in that registry answers, for free and by construction, both "which paths owe a
	// release" and "does THIS `break` leave the `try` at all". See `openTryFork` for the enumeration.
	//
	// They are enrolled ANONYMOUSLY (`EmptySourceText`): an operand of a half-built expression has no name
	// and must acquire none — every name-keyed reader (`requireBindingLive`, the move poisoner, the
	// reassignment scan) reaches a binding through `Scope`, which this never enters.
	//
	// ⚠ `movedFrom` is false and stays false — nothing inside a handler can name these to move out of one —
	// so `emitScopeDrops` never skips them and `captureMoveMark`'s positional snapshot is unaffected beyond
	// its height, which `desugarTry` takes AFTER this call for exactly that reason.
	//
	// Returns the height to rewind to, so the un-enrolment cannot drift from the enrolment's count.
	function suspendForkTempsAsOwned(forkTemps ValueIdArray) returns ElementIndex
		let mark = self.bodyState.ownedBindings.count()

		for temp in forkTemps 'eachSuspended'
			self.enrolOwnedBinding(VarInfo.createValueBinding(EmptySourceText, varType: self.typeOf(temp), kind: BindingKind.let, boundValue: temp))
		end 'eachSuspended'

		return mark
	end 'suspendForkTempsAsOwned'

	// ⭐ **RESUME: un-enrol, and hand the temporaries back to the statement that owns them.** The paths that
	// reach here are the ones that go on to finish the enclosing expression — the ok edge, and a merged error
	// edge — so from here the ordinary statement-end drain is the correct releaser again.
	//
	// They go back UNDER everything enrolled since (the value merge's phi, a re-enrolled managed try-result),
	// because the drop order is creation order reversed and these were built first.
	//
	// ⚠ The owned-binding pop is a TRUNCATION to the recorded mark rather than a removal per temp:
	// mid-stack removal desyncs every block and loop drop mark taken since, which is the reason
	// `reassignBindingValue` gives for leaving a moved-from ghost in the list rather than deleting it.
	function resumeForkTemps(forkTemps ValueIdArray, suspendedMark ElementIndex)
		self.truncateOwnedBindings(suspendedMark)

		if forkTemps.count() == 0 'nothingToHandBack'
			return
		end 'nothingToHandBack'

		let merged = ValueIdArray.create(forkTemps.count() + self.bodyState.pendingTempDrops.count(), zeroed: false)

		for temp in forkTemps 'builtBeforeTheFork'
			merged.push(temp)
		end 'builtBeforeTheFork'

		for temp in self.bodyState.pendingTempDrops 'enrolledSinceTheFork'
			merged.push(temp)
		end 'enrolledSinceTheFork'

		self.bodyState.pendingTempDrops = merged
	end 'resumeForkTemps'

	// Emit the `__mm_decref` for each of `temps` above `floor`, in REVERSE creation order, into
	// `currentBlock`, WITHOUT touching the list. The drop LOOP, split out so a fork that releases the SAME
	// temporaries into more than one block — the catching `if`, through `emitTempDropsInto`, and the block
	// form's landing pads — reuses it instead of spelling the reverse walk a second time. A second copy is how
	// they would come to disagree on the order, and the order is a rule (`emitScopeDrops`' convention: the
	// last built is the first torn down).
	function emitTempDrops(temps ValueIdArray, floor ElementIndex, anchor Token)
		var i = temps.count()

		while i > floor 'eachTemp'
			i = i - 1
			let temp = try temps.get(i) otherwise panic("emitTempDrops: temps.get OOB at {i} — the list is walked strictly downwards from its own count")
			self.emitDecref(temp, range: SourceRange.ofToken(anchor))
		end 'eachTemp'
	end 'emitTempDrops'

	// ⭐⭐ **RELEASE A CATCHING `if`'s CONDITION TEMPORARIES AT THE HEAD OF ONE EDGE — in that edge's OWN
	// block, whatever block the parse is standing in.** The condition is fully evaluated before the split, so
	// nothing downstream can still consume what it built: the temporaries are dead on BOTH edges and each
	// releases them exactly once, in a block their definitions dominate. `currentBlock` is saved and restored
	// because the caller is not done with the block it was standing in.
	//
	// ⛔ **`desugarTry` USED TO SHARE THIS AND MUST NOT.** An expression-level `try` forks in the MIDDLE of an
	// expression, so its pending temporaries are operands the ok edge has yet to consume rather than garbage —
	// releasing them at the head of `tryok` freed a value stored into a struct three ops later. That fork
	// suspends them as owned bindings instead (`suspendForkTempsAsOwned`), so each ABANDONING PATH releases
	// them through its own scope drop; the difference between the two forks is exactly whether an unfinished
	// expression survives the split.
	function emitTempDropsInto(block IrBlock, temps ValueIdArray, anchor Token)
		if temps.count() == 0 'nothingToRelease'
			return
		end 'nothingToRelease'

		let saved = self.bodyState.currentBlock
		self.bodyState.currentBlock = block
		self.emitTempDrops(temps, floor: WholeStatementTempFloor, anchor: anchor)
		self.bodyState.currentBlock = saved
	end 'emitTempDropsInto'

	// ⭐⭐ **A CATCHING `if` IS A `try` FORK, SO ITS CONDITION'S TEMPORARIES MAY NOT DIE IN THE ENTRY BLOCK.**
	// A PLAIN condition's do, and that is `drainPendingTemps`' own rule: `entry` is the single path through
	// the condition and dominates then, else and continuation alike, so one release there is one release on
	// every path.
	//
	// ⛔ **THE PLACEMENT IS PER EDGE, because the two edges merge in the continuation and one release there is
	// one release too few on the other path.** The then and else blocks are the fork's two edges, and each
	// gets the drops at its head, through `emitTempDropsInto`.
	//
	// ⚠ **`desugarTry` LOOKS LIKE THE SAME FORK AND IS NOT.** An `if`'s CONDITION is a finished expression
	// when it branches, so nothing downstream can consume
	// what it built and the temporaries are dead on both edges. An expression-level `try` forks in the MIDDLE
	// of an expression, so its pending temporaries are operands still to be consumed — releasing them at the
	// head of `tryok` freed a value stored into a struct three ops later. That fork therefore releases only on
	// head of `tryok` frees a value stored into a struct three ops later. That fork therefore releases only on
	//
	// ⚠ **AND THE HEAD OF AN EDGE IS WHERE A COMPILER EMITS THINGS THAT READ A TEMPORARY.** A retain emitted there would
	// read out of one of these very temporaries — `if let x = try make().fetch()` releases the receiver in
	// `entry`, ahead of the branch, and the then branch reads `0x3F3F…` poison (`ok=4557430888798830399`). The
	// `+1` of a substituted `T` result is taken in the callee (`emitOwnedValueReturn`), so no such reader exists; the
	// placement stays because it is the one an edge-head emission cannot invalidate.
	function takeCatchingForkTemps(cond IfCondition, floor ElementIndex, anchor Token) returns ValueIdArray
		if not ifConditionCatches(cond) 'plainCondition'
			self.drainPendingTemps(floor, anchor: anchor)
			return self.noForkTemps
		end 'plainCondition'

		let carried = ValueIdArray.create(0)
		var i = floor

		while i < self.bodyState.pendingTempDrops.count() 'collect'
			carried.push(try self.bodyState.pendingTempDrops.get(i) otherwise panic("takeCatchingForkTemps: pendingTempDrops.get OOB at {i} on a list of {self.bodyState.pendingTempDrops.count()}"))
			i = i + 1
		end 'collect'

		self.bodyState.pendingTempDrops.truncate(floor)

		return carried
	end 'takeCatchingForkTemps'

	// ⭐ **OPEN A CATCHING `if`'s OK EDGE — the fork's condition temporaries are released at its head.** They
	// can be, because the condition is a FINISHED expression when it branches: nothing downstream consumes
	// them. ⛔ `desugarTry` may NOT do this: an expression-level `try` forks mid-expression, so releasing its
	// operands at the head of `tryok` is a use-after-free. A plain
	// `if` carries none (`takeCatchingForkTemps` drained them into the entry block, where a single path makes
	// that right) and this is inert for it.
	function openCatchingOkEdge(cond IfCondition, okBlock IrBlock, temps ValueIdArray, anchor Token)
		if not ifConditionCatches(cond) 'plainCondition'
			return
		end 'plainCondition'

		self.emitTempDropsInto(okBlock, temps: temps, anchor: anchor)
	end 'openCatchingOkEdge'

	// Parse an `if` statement:
	//   if <cond> 'thenLabel'
	//       <then-stmts>
	//   end 'thenLabel' [ else 'elseLabel' <else-stmts> end 'elseLabel'
	//                   | else if <cond> …  (the else branch is itself a nested `if`) ]
	//
	// Lowering shape: the entry block (`block`) evaluates `cond` (a comparison, whose
	// value the Std→x64 pass fuses with the branch) and gets a `condBranch` terminator
	// selecting the then block vs the false target (the else block, or the continuation
	// when there is no else). A branch that returns terminates itself; one that falls
	// through gets a `branch` to the continuation. Blocks are created then→else→
	// continuation so `.text` lays them out in source order.
	//
	// Returns the CONTINUATION — where control resumes after the `if`. It is either
	// reachable (Terminator.unset, so subsequent statements emit into it — e.g. the
	// `return 0` after a simple `if`) or, when both branches return, unreachable
	// (Terminator.dead — emits no code, but is still returned so the caller always has
	// a block to continue in).
	//
	// VALUE MERGE: because a `var` may be reassigned inside a branch, the value of
	// a variable at the continuation depends on which path ran. The parser snapshots
	// each carried var's value entering the branches, RESTORES it before the else/false
	// path (so that path resumes from the pre-`if` state), and at the continuation
	// merges the two incoming snapshots — a variable that differs across the paths gets
	// a continuation PHI (the same block-arg mechanism loops use), everything else keeps
	// its common value. Without this, a `var` written only on the taken path would leak
	// its then-value onto the not-taken path (a real miscompile).
	//
	// THE CARRIED SET IS THE VARS THE STATEMENT ASSIGNS, decided from the tokens before
	// anything is emitted (`assignedBindingsIn` over the whole if's extent) — a SUBSET of
	// `mutableVars`, in that list's declaration order. A var no branch assigns holds one
	// value on entry, then-exit AND else-exit, so it can never differ at the merge: it
	// needs neither a phi nor a snapshot slot, and is left out of all three. This is the
	// exact analogue of `parseWhileStatement`'s carried set, and it replaces snapshotting
	// the WHOLE mutable-var set at every branch — which was O(vars in scope) per `if`, and
	// with the scope-filler count doubling on the scale corpus made `phase:parse` BYTES
	// bend quadratically while its ALLOCATIONS stayed linear (bigger snapshots, not more).
	//
	// Each branch body is a lexical BLOCK (parseBlockBody), so the three snapshots are
	// all taken at the SAME scope depth — a `var` declared inside a branch has left
	// `mutableVars` by the time that branch's exit values are read, and is skipped by
	// `assignedBindingsIn` (not bound at entry), which keeps `entryVals` / `thenVals` /
	// `elseVals` positionally aligned with `assignedBindings`.
	function parseIfStatement(func IrFunction, block IrBlock) returns IrBlock throws SourceParseError
		let ifEnd = self.blockStatementEndIndex(self.pos, continuesAtElse: true)
		return try self.parseIfWithin(func, block: block, ifEnd: ifEnd)
	end 'parseIfStatement'

	// `ifEnd` is the final `end` of the whole `else if` chain, which every arm shares. Only the
	// outermost `if` scans for it; each `else if` arm is handed it, because a scan per arm re-reads
	// the rest of the chain, so the chain's cost grows with the square of its length.
	// `assertScanAligned` checks it at every level.
	function parseIfWithin(func IrFunction, block IrBlock, ifEnd ElementIndex) returns IrBlock throws SourceParseError
		let ifIndex = self.pos
		let ifTok = try self.consume(TokenKind.if)

		// The carried bindings — read off the tokens covering the WHOLE statement (then plus
		// every `else`/`else if` branch, through the final `end`), before a single op is
		// emitted. Every snapshot below is positional over THIS list, so the per-branch cost
		// is O(assigned), not O(vars in scope). `ifEnd` also feeds the drift guard.
		let assignedBindings = self.assignedBindingsIn(ifIndex, endIndex: ifEnd)

		// `if let x = try …` / `if var x = try …` — the success binder, read off the tokens BEFORE the
		// condition because it is what makes the condition's `try` mandatory rather than optional.
		let binder = try self.parseIfBinder()

		let condTempFloor = self.bodyState.pendingTempDrops.count()
		let condWindowFloor = self.statementWindowFloor()
		let cond = try self.parseIfCondition(func, block: block, ifTok: ifTok, binder: binder)
		try self.requireNoDeferredRefusal()
		self.closeWindowsTo(condWindowFloor)
		let orders = self.conditionOrdersOf(ifConditionTest(cond))

		// The condition's own blocks: a short-circuit `and`/`or` in it (`if a() and b()`)
		// has already branched, and control now sits in ITS merge block. That — not the
		// block the `if` started in — is where the two-way branch belongs, and it is the
		// `if`'s true entry for every purpose below.
		let entry = self.bodyState.currentBlock

		// ⭐ **THE CONDITION'S TEMPORARIES DIE HERE, IN `entry`, BEFORE THE BRANCH.** `if [10,20,30].count()
		// == 99` builds an array that nothing owns once `count()` has read it, and `entry` is the last block
		// on the single path through the condition — it dominates the then branch, the else branch and the
		// continuation alike, so ONE release here is one release on every path. Releasing it anywhere later
		// cannot be: the branches are the two halves of a fork (a drop in the body runs only when the body
		// does — the leak), and the continuation is reached from both (a drop there runs twice, or on a path
		// that returned early, never at all).
		//
		// ⛔ **A CATCHING `if` IS THE ONE CONDITION THAT CANNOT TAKE THAT DEAL**, because its ok edge still owes
		// a co-own that READS one of these temporaries — so it gets them back here and releases them per edge
		// (see `takeCatchingForkTemps`). The list is empty for every other condition, and each of the two edges
		// below drops it exactly once.
		let forkTemps = self.takeCatchingForkTemps(cond, floor: condTempFloor, anchor: ifTok)

		// E3087 — `if x.contains(k)` guarding a `try x.get(k)` on the same key. Asked HERE, with the cursor
		// still on the then-label, because this is the first point that holds both halves the check needs: the
		// condition has been parsed (so the receiver's TYPE is resolved and recorded) and the then-block's
		// tokens are still ahead, unconsumed and readable.
		try self.requireNoRedundantContainsGet(ifIndex)

		let thenLabel = try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)

		// Values entering the branches (the condition only reads, so `entry`'s values
		// are unchanged by it). Positional over `assignedBindings`.
		let entryVals = self.snapshotBindings(assignedBindings)

		// The move state entering the branches — the twin of `entryVals` for the drop-gating bit, over the
		// owned bindings the branches might move (a `let` String, a consumed param), which are NOT the
		// assigned `var`s `entryVals` covers. Reconciled at the join so a conditional move drops correctly.
		let entryMoveMark = self.captureMoveMark()

		// These blocks are passed to functions that mutate them (the statement parser
		// fills the block; the finalizers wire its terminator).
		let thenBlock = self.artifact.module.addBlock(func, label: thenLabel.value, heat: BlockHeat.normal)

		// ⭐ **THE OK EDGE'S HEAD, IN ORDER: the lifted co-own FIRST, then the fork's temporary releases.**
		// `parseCatchingCondition` tests `flag == 0`, so the THEN block is the edge the `tryCall` wrote the
		// result on — and the `+1` the caller owes a substituted `T` result has to precede the release of the
		// temporary it takes its reference out of. Both are no-ops for a plain `if`.
		self.openCatchingOkEdge(cond, okBlock: thenBlock, temps: forkTemps, anchor: ifTok)

		// ⭐ **`--coverage`: THE TRUE ARM'S COUNTER, ahead of the arm's own code.** Maxon writes no `then`
		// keyword, so the true arm begins at the `if` itself and shares its line; the `if`'s own position is
		// also the BRANCH position that groups this arm with the false one. It goes AFTER the ownership head
		// above, whose order is a stated invariant of the catching fork and not this counter's to disturb.
		if self.coverageActive() 'instrumentTheTrueArm'
			self.mintCovPoint(thenBlock, funcName: func.name, flags: MxdbgCovFlagArmThen, line: ifTok.line, col: ifTok.column, branchLine: ifTok.line, branchCol: ifTok.column)
		end 'instrumentTheTrueArm'

		let thenOrderFloor = self.assumeOrders(orders.whenTrue)
		let thenEnd = try self.parseIfThenBody(func, thenBlock: thenBlock, label: thenLabel.value, cond: cond, binder: binder, anchor: thenLabel)
		self.bodyState.orderFacts.forgetAbove(thenOrderFloor)
		let thenLeaves = thenEnd.isTerminated()

		// Snapshot the then-branch's exit values and move state, then rewind BOTH to the entry state so the
		// else/false path is parsed against the pre-`if` values and pre-`if` ownership, not the then-branch's.
		let thenVals = self.snapshotBindings(assignedBindings)
		let thenMoveMark = self.captureMoveMark()
		self.restoreBindings(assignedBindings, snapshot: entryVals)
		self.restoreMoveMark(entryMoveMark)

		// ⭐ **A CATCHING `if` WITH NO `else` STILL HAS AN ELSE BLOCK.** Its false edge is the error edge of a
		// `try`, which carries an obligation an `entry → continuation` edge structurally cannot: a caught
		// payload-bearing error is a heap box this construct owns, and it must be released on the path that
		// caught it. Giving that edge a real (possibly empty) block hands the release, the `else (e)` binding
		// and the written-`else` body to ONE routine, instead of splitting the ownership rule across the
		// two-block and three-block merge shapes. A PLAIN `if` with no `else` is untouched and keeps the
		// direct false edge.
		if not self.at(TokenKind.else) and not ifConditionCatches(cond) 'noElse'
			let cont = self.finalizeIfNoElse(func, entry: entry, cond: ifConditionTest(cond), ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, bindings: assignedBindings, entryVals: entryVals, thenVals: thenVals, entryMoveMark: entryMoveMark, thenMoveMark: thenMoveMark)
			self.assumeOrdersOfTheSurvivingArm(orders, thenLeaves: thenLeaves, elseLeaves: false)
			self.assertScanAligned("parseIfStatement", predictedEnd: ifEnd)
			return cont
		end 'noElse'

		// ⛔ **IMPLICIT MEANS "THE SOURCE DID NOT WRITE THIS ARM", NOT "NO BLOCK EXISTS FOR IT".** A catching
		// `if` mints an else block for its error path even when the program wrote no `else`, and reporting
		// that as an authored arm would tell a reader their `else` went untaken when they wrote none.
		let elseWrittenInSource = self.at(TokenKind.else)
		let elseTok = self.current()
		let elseBlock = self.artifact.module.addBlock(func, label: b"ifelse", heat: BlockHeat.normal)

		// The catching fork's OTHER edge. Nothing on it reads the condition's temporaries, but it reaches the
		// continuation just as the then edge does, so it owes them the same single release — and it owes it
		// here rather than in the handler body, which may `return` before ever reaching a drain.
		self.emitTempDropsInto(elseBlock, temps: forkTemps, anchor: ifTok)

		self.mintElseArmPoint(elseBlock, funcName: func.name, ifTok: ifTok, elseTok: elseTok, written: elseWrittenInSource)

		let elseOrderFloor = self.assumeOrders(orders.whenFalse)
		let elseEnd = try self.parseElseBody(func, elseBlock: elseBlock, cond: cond, ifTok: ifTok, ifEnd: ifEnd)
		self.bodyState.orderFacts.forgetAbove(elseOrderFloor)
		let elseLeaves = elseEnd.isTerminated()
		let elseVals = self.snapshotBindings(assignedBindings)
		let elseMoveMark = self.captureMoveMark()
		let cont = self.finalizeIfElse(func, entry: entry, cond: ifConditionTest(cond), ifTok: ifTok, thenBlock: thenBlock, thenEnd: thenEnd, elseBlock: elseBlock, elseEnd: elseEnd, bindings: assignedBindings, thenVals: thenVals, elseVals: elseVals, thenMoveMark: thenMoveMark, elseMoveMark: elseMoveMark)
		self.assumeOrdersOfTheSurvivingArm(orders, thenLeaves: thenLeaves, elseLeaves: elseLeaves)
		self.assertScanAligned("parseIfStatement", predictedEnd: ifEnd)
		return cont
	end 'parseIfWithin'

	// ⭐⭐ **E3087 — `if x.contains(k)` FOLLOWED BY `try x.get(k)` IS TWO LOOKUPS WHERE ONE WILL DO.** The
	// membership test and the value read probe the same table for the same key, so the pattern is refused and
	// the author is pointed at `if let v = try x.get(k)`, which does one.
	//
	// ⭐ **IT IS A PARSER CHECK.** Run over the lowered IR instead, the receiver's access path has to
	// be RECONSTRUCTED by walking SSA def-use chains backwards, because by then the source text is
	// gone. The parser resolves types AND still holds the tokens, so `holder.cache` and the key's
	// spelling are READ rather than rebuilt, and the anchor the diagnostic wants (the `contains`
	// member-name token) is a token this function has in its hand. Nothing here re-derives a path, so
	// nothing here can disagree with the receiver the call actually took.
	//
	// ⚠ **THE RULE ITSELF**: the receiver and the key must be the SAME access path on both sides
	// (matched structurally, so a field chain counts exactly as a bare local does); the `get` must be
	// under a `try`; and the scan of the then-block STOPS at the first thing that could have
	// invalidated the membership answer — a write to any name in either path, or any other call on the
	// same receiver. Suppressing on those is what keeps the lint from being a false accusation against
	// code that legitimately probes twice.
	//
	// ⚠ **A NON-PATH RECEIVER OR KEY IS SIMPLY NOT LINTED**: an access-path build answers null and the
	// walk continues. `t.get(0).contains(k)` and `m.contains(a + b)` are outside what a token-level
	// path comparison can prove equal, and an unprovable pair must not be reported.
	function requireNoRedundantContainsGet(ifIndex ElementIndex) throws SourceParseError
		// The condition spans `(if, then-label)`; the cursor sits on the label, which `parseIfStatement` has
		// not consumed yet. A `contains` this `if` did not dispatch — an `and`/`or` arm, a nested call, an
		// earlier statement's — fails the containment test below and stops the check.
		let condStart = ifIndex + 1
		let memberIndex = self.statement.lastDispatchedMemberIndex

		if memberIndex <= condStart or memberIndex >= self.pos 'containsIsNotThisCondition'
			return
		end 'containsIsNotThisCondition'

		if not self.tokenAt(memberIndex).value.equals(ContainsMethod) 'notAContainsCondition'
			return
		end 'notAContainsCondition'

		// The condition must be the `contains` call and NOTHING ELSE: `if not m.contains(k)` and
		// `if m.contains(k) and f()` guard something different from what the `if` tests, so neither is this
		// pattern. `chain . contains ( args )` — the chain runs `[condStart, memberIndex - 1)` and the `(`
		// immediately follows the member name.
		if not self.isDottedChain(condStart, pastEnd: memberIndex - 1) or self.kindAt(memberIndex - 1) != TokenKind.dot 'conditionIsNotALoneContainsCall'
			return
		end 'conditionIsNotALoneContainsCall'

		if self.kindAt(memberIndex + 1) != TokenKind.leftParen or self.kindAt(self.pos - 1) != TokenKind.rightParen 'notACallSpanningTheCondition'
			return
		end 'notACallSpanningTheCondition'

		let keyStart = memberIndex + 2
		let keyPastEnd = self.pos - 1

		if not self.isDottedChain(keyStart, pastEnd: keyPastEnd) 'keyIsNotAPath'
			return
		end 'keyIsNotAPath'

		// The THEN block's own extent — `continuesAtElse: false`, so the scan stops at the first `end` and
		// never walks an `else` branch, which the membership test did not guard.
		if not self.thenBlockRepeatsTheLookup(self.pos, ifEnd: self.blockStatementEndIndex(ifIndex, continuesAtElse: false), chainStart: condStart, chainPastEnd: memberIndex - 1, keyStart: keyStart, keyPastEnd: keyPastEnd) 'noRedundantGet'
			return
		end 'noRedundantGet'

		let receiverText = self.dottedChainText(condStart, pastEnd: memberIndex - 1)
		let keyText = self.dottedChainText(keyStart, pastEnd: keyPastEnd)
		let owner = self.receiverTypeDisplayName(self.statement.lastDispatchedReceiver)
		let anchor = self.tokenAt(memberIndex)
		throw SourceParseError.redundantContainsGet("redundant '{owner}.{String.from(ContainsMethod)}' followed by '{owner}.{String.from(GetMethod)}' on '{receiverText}': use 'if let v = try {receiverText}.{String.from(GetMethod)}({keyText})' (or 'if var') instead — performs one lookup instead of two", line: anchor.line, column: anchor.column)
	end 'requireNoRedundantContainsGet'

	// Does the then-block `(labelIndex, ifEnd)` read `try <chain>.get(<key>)` on the very path the
	// condition already probed? The walk STOPS — never `continue`s past — at anything that could have
	// invalidated the membership answer:
	//
	//   • a WRITE to any name the receiver or key path mentions (`m = other`, `holder.cache = fresh`), and the
	//     guard set is every segment of both paths, so a write to `cache` stops a `holder.cache` receiver;
	//   • ANY other member access on the same receiver — `m.upsert(…)` may have inserted, `m.remove(…)` may
	//     have deleted — including a `get` whose key differs or one not under a `try`.
	//
	// A nested block inside the then-block is walked like the rest: a `get` reached only conditionally is still
	// a second lookup on a path the `contains` already answered for, and the writes that would suppress it are
	// seen on the way in.
	function thenBlockRepeatsTheLookup(labelIndex ElementIndex, ifEnd ElementIndex, chainStart ElementIndex, chainPastEnd ElementIndex, keyStart ElementIndex, keyPastEnd ElementIndex) returns bool
		var i = labelIndex + 1

		while i < ifEnd 'scan'
			// A write to a guarded name — `<name> =` where `<name>` is a segment of either path. `==` is a
			// distinct token kind, so a comparison is not mistaken for an assignment.
			if self.kindAt(i + 1) == TokenKind.equals and self.tokenNamesAPathSegment(i, chainStart: chainStart, chainPastEnd: chainPastEnd, keyStart: keyStart, keyPastEnd: keyPastEnd) 'guardedNameWritten'
				return false
			end 'guardedNameWritten'

			if not self.tokensEqualAt(i, otherStart: chainStart, otherPastEnd: chainPastEnd) 'notTheReceiver'
				i = i + 1
				continue
			end 'notTheReceiver'

			// The receiver path occurs here. Every use of it decides the answer: the matching `try …get(key)`
			// fires, and anything else ends the scan.
			let memberIndex = i + (chainPastEnd - chainStart) + 1

			if self.kindAt(memberIndex - 1) != TokenKind.dot 'notAMemberAccess'
				return false
			end 'notAMemberAccess'

			if not self.tokenAt(memberIndex).value.equals(GetMethod) or self.kindAt(i - 1) != TokenKind.try 'notATryGet'
				return false
			end 'notATryGet'

			if self.kindAt(memberIndex + 1) != TokenKind.leftParen 'notACall'
				return false
			end 'notACall'

			let argStart = memberIndex + 2
			let argPastEnd = argStart + (keyPastEnd - keyStart)

			if self.kindAt(argPastEnd) != TokenKind.rightParen or not self.tokensEqualAt(argStart, otherStart: keyStart, otherPastEnd: keyPastEnd) 'differentKey'
				return false
			end 'differentKey'

			return true
		end 'scan'

		return false
	end 'thenBlockRepeatsTheLookup'

	// Is the token at `index` an identifier spelled like some segment of either guarded path? The guard set is
	// the path SEGMENTS rather than the whole path, deliberately: `holder.cache = fresh` rebinds the field a
	// `holder.cache` receiver reads, and `holder = other` rebinds its base, and both must suppress.
	function tokenNamesAPathSegment(index ElementIndex, chainStart ElementIndex, chainPastEnd ElementIndex, keyStart ElementIndex, keyPastEnd ElementIndex) returns bool
		if self.kindAt(index) != TokenKind.identifier 'notAName'
			return false
		end 'notAName'

		let name = self.tokenAt(index).value
		return self.chainMentionsName(name, chainStart: chainStart, chainPastEnd: chainPastEnd) or self.chainMentionsName(name, chainStart: keyStart, chainPastEnd: keyPastEnd)
	end 'tokenNamesAPathSegment'

	function chainMentionsName(name ByteArray, chainStart ElementIndex, chainPastEnd ElementIndex) returns bool
		var i = chainStart

		while i < chainPastEnd 'eachSegment'
			if self.tokenAt(i).value.equals(name) 'mentions'
				return true
			end 'mentions'

			// Segments alternate `ident . ident`, so stepping two lands on the next name.
			i = i + 2
		end 'eachSegment'

		return false
	end 'chainMentionsName'

	// Is `[start, pastEnd)` exactly `ident ( . ident )*` — the token shape of an access PATH, which is the
	// whole of what this lint can compare structurally. An empty span is not one.
	function isDottedChain(start ElementIndex, pastEnd ElementIndex) returns bool
		if pastEnd <= start 'empty'
			return false
		end 'empty'

		var i = start

		while i < pastEnd 'eachSegment'
			if self.kindAt(i) != TokenKind.identifier 'notAName'
				return false
			end 'notAName'

			if i + 1 >= pastEnd 'lastSegment'
				return true
			end 'lastSegment'

			if self.kindAt(i + 1) != TokenKind.dot 'notADot'
				return false
			end 'notADot'

			i = i + 2
		end 'eachSegment'

		return false
	end 'isDottedChain'

	// Do the tokens at `[start, …)` spell the same thing as `[otherStart, otherPastEnd)`? Compared by the
	// tokens' own source bytes, which is what makes `holder.cache` on one side and `holder.cache` on the other
	// the same receiver without a name table.
	//
	// ⚠ **THE KIND IS COMPARED TOO, and it is not belt-and-braces**: a PUNCTUATION token carries no source
	// bytes of its own, so a value-only test reads every `.`, `,` and `+` as the same empty string and
	// `holder + cache` would answer equal to the chain `holder . cache`.
	function tokensEqualAt(start ElementIndex, otherStart ElementIndex, otherPastEnd ElementIndex) returns bool
		var offset = 0 as ElementIndex

		while otherStart + offset < otherPastEnd 'eachToken'
			let here = self.tokenAt(start + offset)
			let there = self.tokenAt(otherStart + offset)

			if here.kind != there.kind or not here.value.equals(there.value) 'differs'
				return false
			end 'differs'

			offset = offset + 1
		end 'eachToken'

		return true
	end 'tokensEqualAt'

	// The source spelling of the dotted chain `[start, pastEnd)` — `m`, `holder.cache`. Rebuilt from the
	// tokens' own bytes rather than sliced out of the source buffer, because the chain is exactly
	// `ident ( . ident )*` and so has no interior trivia to preserve.
	function dottedChainText(start ElementIndex, pastEnd ElementIndex) returns String
		var out = ""
		var i = start

		while i < pastEnd 'eachSegment'
			if i > start 'separator'
				out.append(".")
			end 'separator'

			out.append(String.from(self.tokenAt(i).value))
			i = i + 2
		end 'eachSegment'

		return out
	end 'dottedChainText'

	// The name the diagnostic calls a receiver's TYPE — `Map` for a `Map with (String, String)`, `Set` for a
	// set, the declared name for a struct. It is the BASE name of a generic instance and not the mangled
	// instance name, because the sentence names a method (`Map.contains`) and a method belongs to the base.
	function receiverTypeDisplayName(receiver ValueId) returns String
		let tag = self.tagOf(receiver)

		if tag == ValueTypeTag.genericInstance 'instance'
			return String.from(self.signatures.genericInstanceBaseName(self.valueInstanceId(receiver)))
		end 'instance'

		return typeTagName(tag) if self.valueNameId(receiver) == UnnamedTypeId else String.from(self.internedName(self.valueNameId(receiver)))
	end 'receiverTypeDisplayName'

	// Record the member dispatch about to happen — the token index of the member NAME and the receiver whose
	// type it is being dispatched on. TWO SCALAR FIELDS written in ONE place, exactly as `lastFieldRead*` is:
	// the redundant-`contains`/`get` lint recognizes its own condition by IDENTITY (the index must fall inside
	// the condition it is checking), so a stale record from an earlier dispatch cannot be mistaken for this
	// one, and a miss simply skips the lint rather than reporting the wrong receiver.
	function noteMemberDispatch(recv MethodReceiver)
		self.statement.lastDispatchedMemberIndex = self.pos
		self.statement.lastDispatchedReceiver = recv.value
	end 'noteMemberDispatch'

	// Parse an `else` branch into `elseBlock`. A PLAIN condition's else is exactly what it always was — the
	// `else` keyword and then a body. A CATCHING condition's else is the try's ERROR EDGE, which owns the
	// caught error whether or not an `else` was written, so it routes to its own opener.
	function parseElseBody(func IrFunction, elseBlock IrBlock, cond IfCondition, ifTok Token, ifEnd ElementIndex) returns IrBlock throws SourceParseError
		match cond 'shape'
			plain then break
			tryCatch(_, _, _, flag, errorType, form, join) then return try self.parseCatchingElseBody(func, elseBlock: elseBlock, flag: flag, errorType: errorType, form: form, join: join, ifTok: ifTok, ifEnd: ifEnd)
		end 'shape'

		try self.consume(TokenKind.else)
		return try self.parseElseBranchBody(func, elseBlock: elseBlock, ifEnd: ifEnd)
	end 'parseElseBody'

	// The else branch's BODY, once its `else` (and, for a catching `if`, any `(e)` binder) has been
	// consumed: either a nested `if` (the `else if …` chain — the else branch IS a nested if statement, so
	// `elseBlock` becomes that if's entry) or a plain labelled `else` block. Returns the block the else
	// branch left control in (its own continuation for a nested if; the block its last statement filled for
	// a plain else).
	//
	// The `else if` form opens NO scope frame of its own: its condition is evaluated in the ENCLOSING scope
	// (it is not inside any block), and each of the nested if's own branches opens a frame when it is
	// parsed. Only the plain `else 'label'` form is a block body.
	function parseElseBranchBody(func IrFunction, elseBlock IrBlock, ifEnd ElementIndex) returns IrBlock throws SourceParseError
		if self.at(TokenKind.if) 'elseIf'
			return try self.parseIfWithin(func, block: elseBlock, ifEnd: ifEnd)
		end 'elseIf'

		let elseLabelTok = try self.consume(TokenKind.charLiteral)
		try self.requireLineEndAfter(LineEndingConstruct.blockLabel)
		return try self.parseBlockBody(func, block: elseBlock, label: elseLabelTok.value)
	end 'parseElseBranchBody'
end 'Parser'
