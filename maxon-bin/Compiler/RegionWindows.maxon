export union DeferredRefusal
	none
	at(line LineNumber, column ColumnNumber, code ErrorCode, message String)
end 'DeferredRefusal'

module typealias JoinArmFlags = bits(8)

module let NoJoinArmFlags = 0 as JoinArmFlags

module let UndecidedParameterArm = 1 as JoinArmFlags

module let LocalMutableArm = 2 as JoinArmFlags

module let ResultStillToSettleArm = 4 as JoinArmFlags

module let FrozenDataArm = 8 as JoinArmFlags

module function joinArmIs(flags JoinArmFlags, wanted JoinArmFlags) returns bool
	return (flags and wanted) != 0
end 'joinArmIs'

export type ParamSourceTable
	module var derived as PhiParamSourceMap
	module var joinedParams as PhiParamSourceMap
	module var besideLocalData as ValueMarkSet
	module var besideOther as ValueMarkSet
	module var besideFrozen as ValueMarkSet
	module var heldReturned as ParamPositionMask

	export static function create() returns ParamSourceTable
		return Self{derived: PhiParamSourceMap.create(), joinedParams: PhiParamSourceMap.create(), besideLocalData: ValueMarkSet.create(), besideOther: ValueMarkSet.create(), besideFrozen: ValueMarkSet.create(), heldReturned: NoParamPositions}
	end 'create'

	module function derivedSourcesOf(value ValueId) returns ParamPositionMask
		return try self.derived.get(value) otherwise NoParamPositions
	end 'derivedSourcesOf'

	module function carry(target ValueId, source ValueId, sources ParamPositionMask)
		self.derived.upsert(target, value: sources)

		if self.besideLocalData.contains(source) 'aMixedJoin'
			self.besideLocalData.insert(target)
		end 'aMixedJoin'
	end 'carry'

	module function noteMixedJoin(phi ValueId, sources ParamPositionMask)
		self.derived.upsert(phi, value: sources)
		self.besideLocalData.insert(phi)
	end 'noteMixedJoin'

	module function noteParameterArm(phi ValueId, incoming ValueId, sources ParamPositionMask)
		let joined = (try self.joinedParams.get(phi) otherwise NoParamPositions) or sources
		self.joinedParams.upsert(phi, value: joined)

		if self.besideOther.contains(phi) 'anArmOfItsOwn'
			return
		end 'anArmOfItsOwn'

		self.derived.upsert(phi, value: joined)

		if self.besideLocalData.contains(incoming) 'incomingBesideLocalData'
			self.besideLocalData.insert(phi)
		end 'incomingBesideLocalData'
	end 'noteParameterArm'

	module function noteLocalDataArm(phi ValueId)
		self.besideLocalData.insert(phi)
	end 'noteLocalDataArm'

	module function noteDerivedBesideOtherData(value ValueId)
		if self.derived.contains(value) 'sourcedFromAParameter'
			self.besideLocalData.insert(value)
		end 'sourcedFromAParameter'
	end 'noteDerivedBesideOtherData'

	module function noteOtherArm(phi ValueId)
		self.besideOther.insert(phi)
		_ = self.derived.remove(phi)
	end 'noteOtherArm'

	module function noteParametersBesideFrozenData(phi ValueId, sources ParamPositionMask, joinedOnlyParameters bool)
		self.joinedParams.upsert(phi, value: sources)

		if joinedOnlyParameters 'noOtherArm'
			self.derived.upsert(phi, value: sources)
		end 'noOtherArm'
	end 'noteParametersBesideFrozenData'

	module function adoptJoinedParameters(phi ValueId)
		let joined = try self.joinedParams.get(phi) otherwise return
		self.derived.upsert(phi, value: joined)
	end 'adoptJoinedParameters'

	module function mixedJoinSources() returns JoinedParamSourceArray
		let mixed = JoinedParamSourceArray.create(0)

		if self.besideLocalData.count() == 0 'noMixedJoin'
			return mixed
		end 'noMixedJoin'

		for (value, sources) in self.derived 'eachSourcedValue'
			if self.besideLocalData.contains(value) 'aMixedJoin'
				mixed.push(JoinedParamSource.create(value, sources: sources))
			end 'aMixedJoin'
		end 'eachSourcedValue'

		return mixed
	end 'mixedJoinSources'
end 'ParamSourceTable'

export type RegionFactTable
	module var windows as WindowStack
	module var fieldOrigins as FieldOriginMap
	module var mutableUseLines as UseLineMap
	module var paramSources as ParamSourceTable
	module var callOpens as WindowStack
	module var callGuards as ElementIndex
	module var deferredRefusal as DeferredRefusal
	module var handedBack as ValueIdArray
	module var carriedRoots as ValueMarkSet
	module var carriedDerivations as CarriedDerivationArray
	module var carriedStores as CarriedStoreArray
	module var carriedStoredSlots as CarriedStoredSlotArray
	module var carriedHolders as CarriedHolderArray
	module var lentUniques as ValueMarkSet
	module var destructuredUniques as ValueMarkSet

	// Filed for an alias of an immutable holder and for a view of read-only elements, never for a `let` that
	// owns a fresh record: a by-reference cell write is refused only for a filed root.
	module var cellRefusedRoots as ValueMarkSet
	module var cleanFunctionValues as ValueMarkSet
	module var lentLocals as LentLocalArray
	module var pendingHeld as HeldStoreArray
	module var heldLiterals as HeldLiteralMap

	export static function create() returns RegionFactTable
		return Self{windows: WindowStack.create(0), fieldOrigins: FieldOriginMap.create(), mutableUseLines: UseLineMap.create(), paramSources: ParamSourceTable.create(), callOpens: WindowStack.create(0), callGuards: 0, deferredRefusal: DeferredRefusal.none, handedBack: ValueIdArray.create(0), carriedRoots: ValueMarkSet.create(), carriedDerivations: CarriedDerivationArray.create(0), carriedStores: CarriedStoreArray.create(0), carriedStoredSlots: CarriedStoredSlotArray.create(0), carriedHolders: CarriedHolderArray.create(0), lentUniques: ValueMarkSet.create(), destructuredUniques: ValueMarkSet.create(), cellRefusedRoots: ValueMarkSet.create(), cleanFunctionValues: ValueMarkSet.create(), lentLocals: LentLocalArray.create(0), pendingHeld: HeldStoreArray.create(0), heldLiterals: HeldLiteralMap.create()}
	end 'create'

	module function clearCarried()
		self.carriedRoots = ValueMarkSet.create()
		self.carriedDerivations = CarriedDerivationArray.create(0)
		self.carriedStores = CarriedStoreArray.create(0)
		self.carriedStoredSlots = CarriedStoredSlotArray.create(0)
		self.carriedHolders = CarriedHolderArray.create(0)
	end 'clearCarried'
end 'RegionFactTable'

export union RegionFacts
	unwritten
	entries(table RegionFactTable)
end 'RegionFacts'

module let noRegionFacts = RegionFacts.unwritten

module function windowIsOpen(windows WindowStack) returns bool
	return not windows.isEmpty()
end 'windowIsOpen'

module function innermostWindowOf(windows WindowStack) returns OpenWindow
	return try windows.last() otherwise panic("innermostWindowOf: asked with no window open — every caller checks `windowIsOpen` first")
end 'innermostWindowOf'

module function capabilityWithinWindows(windows WindowStack, value ValueId, intrinsic ValueCapability) returns ValueCapability
	if windows.isEmpty() 'noWindow'
		return intrinsic
	end 'noWindow'

	return capabilityWithinWindowAt(windows, position: windows.count() - 1, value: value, intrinsic: intrinsic)
end 'capabilityWithinWindows'

module function capabilityWithinExplicitWindows(windows WindowStack, value ValueId, intrinsic ValueCapability) returns ValueCapability
	var position = windows.count()

	while position > 0 'outwardFromTheInnermost'
		position = position - 1
		let window = try windows.get(position) otherwise panic("capabilityWithinExplicitWindows: windows.get OOB at {position} below the count just read")

		if window.kind == WindowKind.modify 'anExplicitWindow'
			return capabilityWithinWindowAt(windows, position: position, value: value, intrinsic: intrinsic)
		end 'anExplicitWindow'
	end 'outwardFromTheInnermost'

	return intrinsic
end 'capabilityWithinExplicitWindows'

function capabilityWithinWindowAt(windows WindowStack, position ElementIndex, value ValueId, intrinsic ValueCapability) returns ValueCapability
	let window = try windows.get(position) otherwise panic("capabilityWithinWindowAt: windows.get OOB at {position}")

	if not window.opensAField and value == window.openedValue 'theOpenedRoot'
		return ValueCapability.mutable
	end 'theOpenedRoot'

	if valueIsAnEnclosingWindowsRoot(windows, value: value, below: position) 'outsideTheInnerBlock'
		return ValueCapability.paused
	end 'outsideTheInnerBlock'

	if value >= window.floor 'insideTheWindow'
		return intrinsic
	end 'insideTheWindow'

	if intrinsic == ValueCapability.mutable or intrinsic == ValueCapability.temporary 'outerWritableData'
		return ValueCapability.paused
	end 'outerWritableData'

	return intrinsic
end 'capabilityWithinWindowAt'

function valueIsAnEnclosingWindowsRoot(windows WindowStack, value ValueId, below ElementIndex) returns bool
	for position in 0 upto below 'eachEnclosingWindow'
		let enclosing = try windows.get(position) otherwise panic("valueIsAnEnclosingWindowsRoot: windows.get OOB at {position} below the window asked about")

		if not enclosing.opensAField and value == enclosing.openedValue 'anEnclosingRoot'
			return true
		end 'anEnclosingRoot'
	end 'eachEnclosingWindow'

	return false
end 'valueIsAnEnclosingWindowsRoot'

module enum FieldWindowState
	notOpen
	open
	paused
end 'FieldWindowState'

module function windowOpenedOnRoot(windows WindowStack, rootName ByteArray) returns OpenWindow throws AbsentError
	var position = windows.count()

	while position > 0 'outwardFromTheInnermost'
		position = position - 1
		let window = try windows.get(position) otherwise panic("windowOpenedOnRoot: windows.get OOB at {position} below the count just read")

		if not window.rootName.isEmpty() and window.rootName.equals(rootName) 'theOpenedRoot'
			return window
		end 'theOpenedRoot'
	end 'outwardFromTheInnermost'

	throw AbsentError.absent
end 'windowOpenedOnRoot'

module function windowOpensValue(windows WindowStack, value ValueId) returns bool
	for window in windows 'eachWindow'
		if not window.opensAField and window.openedValue == value 'theOpenedValue'
			return true
		end 'theOpenedValue'
	end 'eachWindow'

	return false
end 'windowOpensValue'

module function modifyWindowCount(windows WindowStack) returns ElementIndex
	var count = 0 as ElementIndex

	for window in windows 'eachWindow'
		if window.kind == WindowKind.modify 'aModifyBlock'
			count = count + 1
		end 'aModifyBlock'
	end 'eachWindow'

	return count
end 'modifyWindowCount'

module function statementWindowIsOpen(windows WindowStack) returns bool
	for window in windows 'eachWindow'
		if window.kind == WindowKind.oneStatement 'aStatementOpen'
			return true
		end 'aStatementOpen'
	end 'eachWindow'

	return false
end 'statementWindowIsOpen'

function wordIsARegionOperator(word ByteArray) returns bool
	return word.equals(FreezeOperatorWord) or word.equals(SwapOperatorWord) or word.equals(MergeOperatorWord)
end 'wordIsARegionOperator'

function operandStartsWith(kind TokenKind) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.self or kind == TokenKind.selfType or kind == TokenKind.try or kind == TokenKind.leftBracket or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.true or kind == TokenKind.false
end 'operandStartsWith'

module function tokenKindIsPostfixChainPart(kind TokenKind) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.dot or kind == TokenKind.self or kind == TokenKind.selfType or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.charLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.true or kind == TokenKind.false
end 'tokenKindIsPostfixChainPart'

module function regionOperatorAt(tokens TokenArray, index ElementIndex) returns bool
	let tok = try tokens.get(index) otherwise return false

	if tok.kind != TokenKind.identifier or not wordIsARegionOperator(tok.value) 'notTheWord'
		return false
	end 'notTheWord'

	if index > 0 and tokenKindAt(tokens, index: index - 1) == TokenKind.dot 'aMemberName'
		return false
	end 'aMemberName'

	let next = tokenKindAt(tokens, index: index + 1)

	if operandStartsWith(next) 'anOperand'
		return true
	end 'anOperand'

	if next != TokenKind.leftParen 'notAParenthesizedOperand'
		return false
	end 'notAParenthesizedOperand'

	let paren = try tokens.get(index + 1) otherwise return false
	return paren.line != tok.line or paren.column != tok.column + (tok.value.count() as ColumnNumber)
end 'regionOperatorAt'
