	var carriedHolders as CarriedHolderArray
	var lentUniques as ValueMarkSet
	var destructuredUniques as ValueMarkSet
	var acquiredNames as AcquiredStateNameArray
	var reachedStates as ValueIdArray
	var mergedValues as ValueMarkSet
	var pendingCallOpen as PendingCallOpen

	// Filed for an alias of an immutable holder and for a view of read-only elements, never for a `let` that
	// owns a fresh record: a by-reference cell write is refused only for a filed root.
	var cellRefusedRoots as ValueMarkSet
	var cleanFunctionValues as ValueMarkSet
	var lentLocals as LentLocalArray
	var pendingHeld as HeldStoreArray
	var heldLiterals as HeldLiteralMap

	export static function create() returns RegionFactTable
		return Self{windows: WindowStack.create(0), windowBirths: WindowBirthMap.create(), pendingWindowReceiver: PendingWindowReceiver.none, fieldOrigins: FieldOriginMap.create(), mutableUseLines: UseLineMap.create(), paramSources: ParamSourceTable.create(), callOpens: WindowStack.create(0), callGuards: 0, deferredRefusal: DeferredRefusal.none, handedBack: ValueIdArray.create(0), carriedRoots: ValueMarkSet.create(), carriedDerivations: CarriedDerivationArray.create(0), carriedStores: CarriedStoreArray.create(0), carriedStoredSlots: CarriedStoredSlotArray.create(0), carriedHolders: CarriedHolderArray.create(0), lentUniques: ValueMarkSet.create(), destructuredUniques: ValueMarkSet.create(), acquiredNames: AcquiredStateNameArray.create(0), reachedStates: ValueIdArray.create(0), mergedValues: ValueMarkSet.create(), pendingCallOpen: PendingCallOpen.none, cellRefusedRoots: ValueMarkSet.create(), cleanFunctionValues: ValueMarkSet.create(), lentLocals: LentLocalArray.create(0), pendingHeld: HeldStoreArray.create(0), heldLiterals: HeldLiteralMap.create()}
	end 'create'

	function birthOf(value ValueId) returns ValueId
		return try self.windowBirths.get(value) otherwise value
	end 'birthOf'

	function carriesABirth(value ValueId) returns bool
		return self.windowBirths.contains(value)
	end 'carriesABirth'

	function forgetStatement()
		self.reachedStates.clear()
		self.mergedValues = ValueMarkSet.create()
	end 'forgetStatement'

	function suspendStatement() returns SuspendedStatementFacts
		let suspended = SuspendedStatementFacts.held(self.reachedStates, merged: self.mergedValues)
		self.reachedStates = ValueIdArray.create(0)
		self.mergedValues = ValueMarkSet.create()

		return suspended
	end 'suspendStatement'

	function resumeStatement(reached ValueIdArray, merged ValueMarkSet)
		self.reachedStates = reached
		self.mergedValues = merged
	end 'resumeStatement'

	function clearCarried()
		self.carriedRoots = ValueMarkSet.create()
		self.carriedDerivations = CarriedDerivationArray.create(0)
		self.carriedStores = CarriedStoreArray.create(0)
		self.carriedStoredSlots = CarriedStoredSlotArray.create(0)
		self.carriedHolders = CarriedHolderArray.create(0)
	end 'clearCarried'
end 'RegionFactTable'

union RegionFacts
	unwritten
	entries(table RegionFactTable)
end 'RegionFacts'

let noRegionFacts = RegionFacts.unwritten

function windowIsOpen(windows WindowStack) returns bool
	return not windows.isEmpty()
end 'windowIsOpen'

function innermostWindowOf(windows WindowStack) returns OpenWindow
	return try windows.last() otherwise panic("innermostWindowOf: asked with no window open — every caller checks `windowIsOpen` first")
end 'innermostWindowOf'

function capabilityWithinWindows(windows WindowStack, value ValueId, intrinsic ValueCapability) returns ValueCapability
	if windows.isEmpty() 'noWindow'
		return intrinsic
	end 'noWindow'

	return capabilityWithinWindowAt(windows, position: windows.count() - 1, value: value, intrinsic: intrinsic)
end 'capabilityWithinWindows'

function capabilityWithinExplicitWindows(windows WindowStack, value ValueId, intrinsic ValueCapability) returns ValueCapability
	var position = windows.count()

	while position > 0 'outwardFromTheInnermost'
		position = position - 1
		let window = try windows.get(position) otherwise panic("capabilityWithinExplicitWindows: windows.get OOB at {position} below the count just read")

		if window.kind == WindowKind.modify or window.kind == WindowKind.acquire 'anExplicitWindow'
			return capabilityWithinWindowAt(windows, position: position, value: value, intrinsic: intrinsic)
		end 'anExplicitWindow'
	end 'outwardFromTheInnermost'

	return intrinsic
end 'capabilityWithinExplicitWindows'

function windowOpensARoot(window OpenWindow) returns bool
	return not window.opensAField and window.kind != WindowKind.acquire
end 'windowOpensARoot'

enum WindowStanding
	theOpenedRoot
	anEnclosingRoot
	outerData
	bornInside
end 'WindowStanding'

function standingInWindowAt(windows WindowStack, position ElementIndex, value ValueId) returns WindowStanding
	let window = try windows.get(position) otherwise panic("standingInWindowAt: windows.get OOB at {position}")

	if windowOpensARoot(window) and value == window.openedValue 'theOpenedRoot'
		return WindowStanding.theOpenedRoot
	end 'theOpenedRoot'

	if valueIsAnEnclosingWindowsRoot(windows, value: value, below: position) 'outsideTheInnerBlock'
		return WindowStanding.anEnclosingRoot
	end 'outsideTheInnerBlock'

	if value >= window.floor 'insideTheWindow'
		return WindowStanding.bornInside
	end 'insideTheWindow'

	return WindowStanding.outerData
end 'standingInWindowAt'

function valueIsOutsideInnermostWindow(windows WindowStack, value ValueId) returns bool
	return match standingInWindowAt(windows, position: windows.count() - 1, value: value) 'standing'
		anEnclosingRoot or
		outerData gives true
		theOpenedRoot or
		bornInside gives false
	end 'standing'
end 'valueIsOutsideInnermostWindow'

function keepingPositionText(callee ByteArray, parameter ByteArray) returns String
	return "the parameter '{displayParamName(parameter)}' of '{String.from(callee)}', which keeps it"
end 'keepingPositionText'

function outerValueIntoOpenWindowMessage(label ByteArray, into String) returns String
	return "an isolated value from outside '{String.from(label)}' cannot be moved into {into} while '{String.from(label)}' is open: it would become part of the open region. Move it into an `isolated` parameter or an `isolated` slot, send it, or `merge` it"
end 'outerValueIntoOpenWindowMessage'

function capabilityWithinWindowAt(windows WindowStack, position ElementIndex, value ValueId, intrinsic ValueCapability) returns ValueCapability
	return match standingInWindowAt(windows, position: position, value: value) 'standing'
		theOpenedRoot gives ValueCapability.mutable
		anEnclosingRoot gives ValueCapability.paused
		bornInside gives intrinsic
		outerData gives ValueCapability.paused if intrinsic == ValueCapability.mutable or intrinsic == ValueCapability.temporary else intrinsic
	end 'standing'
end 'capabilityWithinWindowAt'

function valueIsAnEnclosingWindowsRoot(windows WindowStack, value ValueId, below ElementIndex) returns bool
	for position in 0 upto below 'eachEnclosingWindow'
		let enclosing = try windows.get(position) otherwise panic("valueIsAnEnclosingWindowsRoot: windows.get OOB at {position} below the window asked about")

		if windowOpensARoot(enclosing) and value == enclosing.openedValue 'anEnclosingRoot'
			return true
		end 'anEnclosingRoot'
	end 'eachEnclosingWindow'

	return false
end 'valueIsAnEnclosingWindowsRoot'

enum FieldWindowState
	notOpen
	open
	paused
end 'FieldWindowState'

function windowOpenedOnRoot(windows WindowStack, rootName ByteArray) returns OpenWindow throws AbsentError
	var position = windows.count()

	while position > 0 'outwardFromTheInnermost'
		position = position - 1
		let window = try windows.get(position) otherwise panic("windowOpenedOnRoot: windows.get OOB at {position} below the count just read")

		if not window.rootName.isEmpty() and window.rootName.equals(rootName) 'theOpenedRoot'
			return window
		end 'theOpenedRoot'
	end 'outwardFromTheInnermost'

	throw AbsentError.absent
end 'windowOpenedOnRoot'

function windowOpensValue(windows WindowStack, value ValueId) returns bool
	for window in windows 'eachWindow'
		if windowOpensARoot(window) and window.openedValue == value 'theOpenedValue'
			return true
		end 'theOpenedValue'
	end 'eachWindow'

	return false
end 'windowOpensValue'

function modifyWindowCount(windows WindowStack) returns ElementIndex
	var count = 0 as ElementIndex

	for window in windows 'eachWindow'
		if window.kind == WindowKind.modify or window.kind == WindowKind.acquire 'anExplicitBlock'
			count = count + 1
		end 'anExplicitBlock'
	end 'eachWindow'

	return count
end 'modifyWindowCount'

function statementWindowIsOpen(windows WindowStack) returns bool
	for window in windows 'eachWindow'
		if window.kind == WindowKind.oneStatement 'aStatementOpen'
			return true
		end 'aStatementOpen'
	end 'eachWindow'

	return false
end 'statementWindowIsOpen'

function wordIsARegionOperator(word ByteArray) returns bool
	return word.equals(FreezeOperatorWord) or word.equals(SwapOperatorWord) or word.equals(MergeOperatorWord)
end 'wordIsARegionOperator'

function operandStartsWith(kind TokenKind) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.self or kind == TokenKind.selfType or kind == TokenKind.try or kind == TokenKind.leftBracket or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.true or kind == TokenKind.false
end 'operandStartsWith'

function tokenKindIsPostfixChainPart(kind TokenKind) returns bool
	return kind == TokenKind.identifier or kind == TokenKind.dot or kind == TokenKind.self or kind == TokenKind.selfType or kind == TokenKind.intLiteral or kind == TokenKind.floatLiteral or kind == TokenKind.charLiteral or kind == TokenKind.stringLiteral or kind == TokenKind.byteStringLiteral or kind == TokenKind.true or kind == TokenKind.false
end 'tokenKindIsPostfixChainPart'

function regionOperatorAt(tokens TokenArray, index ElementIndex) returns bool
	let tok = try tokens.get(index) otherwise return false

	if tok.kind != TokenKind.identifier or not wordIsARegionOperator(tok.value) 'notTheWord'
		return false
	end 'notTheWord'

	if index > 0 and tokenKindAt(tokens, index: index - 1) == TokenKind.dot 'aMemberName'
		return false
	end 'aMemberName'

	let next = tokenKindAt(tokens, index: index + 1)

	if operandStartsWith(next) 'anOperand'
		return true
	end 'anOperand'

	if next != TokenKind.leftParen 'notAParenthesizedOperand'
		return false
	end 'notAParenthesizedOperand'

	let paren = try tokens.get(index + 1) otherwise return false
	return paren.line != tok.line or paren.column != tok.column + (tok.value.count() as ColumnNumber)
end 'regionOperatorAt'
