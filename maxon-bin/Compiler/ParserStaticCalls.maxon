extension Parser
	function chainNamesADirectoryQualifiedFunction(chain ChainResolution) returns bool
		return match chain 'chain'
			declaredFunction gives true
			unqualified or
			value or
			declaredType or
			ambiguous or
			nothing gives false
		end 'chain'
	end 'chainNamesADirectoryQualifiedFunction'

	function chainIsADirectoryQualifiedCall(chain ChainResolution) returns bool
		return self.chainNamesADirectoryQualifiedFunction(chain) and self.chainCallFollowsAt(self.pos)
	end 'chainIsADirectoryQualifiedCall'

	function chainCallFollowsAt(index ElementIndex) returns bool
		return self.kindAt(index + self.dottedChainLengthAt(index) * TokensPerQualifierSegment + 1) == TokenKind.leftParen
	end 'chainCallFollowsAt'

	// How many `.<name>` pairs follow the identifier at `index` — the peek-only, allocation-free half of
	// `assembleDottedChainAt`. `0` for a bare name and for anything that is not an identifier at all.
	//
	// ⭐⭐ **TWO POSITIONS ASK IT, AND THEY ARE ONE QUESTION**: the CALL door
	// (`parseNamespaceQualifiedCall`), and `parseTypeReference`'s `Instance.Member` / `dir.Name` arm. They
	// share one walk because two copies would come apart: `lib.from.helper()` would compile while
	// `21 as lib.from.Score` did not. Two spellings of "where does a dotted name end" can only ever agree by
	// accident, and neither site reads as wrong on its own. See `parseTypeReference` for the measurement.
	//
	// ⚠ **THE HEAD MUST BE A PLAIN IDENTIFIER AND THE SEGMENTS AFTER IT NEED ONLY BE NAMEABLE.**
	// A trailing segment is the FUNCTION'S OWN NAME, and a declaration may take a keyword — `export
	// function from()` is legal and `declaredMethodName` files its qualified spelling under `lib.from`, so a
	// walk that demanded `identifier` there would register a name no call could ever reach. The HEAD is held
	// to `identifier` because it is the position every other arm of `parseDottedPrimary` reads its base from,
	// and widening it would offer this arm keyword bases (`int.`, `Self.`) that those arms own.
	function dottedChainLengthAt(index ElementIndex) returns ElementIndex
		if self.kindAt(index) != TokenKind.identifier 'notADottedName'
			return 0
		end 'notADottedName'

		return chainSegmentsAt(self.tokens, at: index)
	end 'dottedChainLengthAt'

	// The `a.b.c` NAME a chain of `dots` pairs at `index` spells, built through `joinQualifiedName` so the
	// registry is asked about the same bytes `namespaceQualifiedName` filed it under. Called only once
	// `dottedChainLengthAt` has accepted the shape, so the joins are paid by a real dotted call or a real
	// dotted TYPE reference and by nothing else — the two callers of the walk above, sharing its assembly for
	// the same reason they share its predicate.
	// ⭐⭐ **THE SYNTHETIC NAME TOKEN A `Type.member` STATIC ACCESS DENOTES** — `value` is the storage
	// key `Counter.count`, built by the one join every member name in this file is built by, and the SPAN is
	// the whole chain the author wrote (`baseTok`'s first byte through `memberTok`'s last), so a diagnostic
	// or a `SourceRange` taken off it points at the source rather than at half of it.
	//
	// ⭐ **SYNTHESIZING A TOKEN IS WHAT MAKES THE TWO STATIC-MEMBER DOORS ONE LINE EACH.** The whole
	// top-level binding machinery — the constant probe, the slot probe, the load, the checked store, E2013,
	// E2004, the blame name a bare argument carries — is keyed by a token's `value`
	// and anchored on its position. A static member differs from a file-scope global in NOTHING but how its
	// name is spelled, so spelling it is the entire adaptation; the alternative was threading a second
	// "which name did you mean" parameter through six shared functions, where the token and the name would
	// have been free to disagree.
	//
	// ⚠ It is `identifier`-kinded for `typeBaseTokenAt`'s reason, one door along: the token IS a name,
	// and every reader downstream asks what it spells rather than which keyword produced it.
	function staticMemberNameToken(baseTok Token, memberTok Token) returns Token
		return Token.create(TokenKind.identifier, line: baseTok.line, column: baseTok.column, value: qualifiedMethodName(baseTok.value, methodName: memberTok.value), startByte: baseTok.startByte, endByte: memberTok.endByte)
	end 'staticMemberNameToken'

	// ⭐⭐ **`Counter.count` AND `Names.items.push(9)` — THE ONE READER OF A STATIC-MEMBER ACCESS.**
	// The cursor sits on the base; `baseTok` is what `typeBaseTokenAt` made of it, so `Self.count` inside the
	// declaring type arrives here as `Counter.count` and needs no arm of its own.
	//
	// ⭐⭐ **THE TWO SHAPES ARE SPLIT ON WHETHER A MEMBER CALL FOLLOWS, AND THAT SPLIT IS A SOUNDNESS FIX
	// RATHER THAN A CONVENIENCE.** A plain read hands back a value; a read that RECEIVES a method must arrive
	// at the dispatcher wearing the four facts a NAME carries, and the E3207 blame name is the one that
	// matters. Without this split, `type Cache { static let xs = [1, 2, 3] }` plus `try Cache.xs.pop()`
	// compiles clean — a mutation of a binding declared `let` — because the value falls out to
	// `parsePostfix`, whose receiver is deliberately nameless ("A postfix receiver is bound to no name"),
	// which is true of a literal and a call result and false of this. The identical program spelled with a
	// file-scope `let xs = [1, 2, 3]` is E3207, and both are.
	//
	// ⭐ So the call form goes to `dispatchOnManagedReceiver` — the SAME door a bare top-level managed
	// receiver uses (`parseMethodCall`'s `managedTopLevelBase` arm) — with the qualified name as the
	// binding's. That also makes `Names.items.push(9)` legal as a STATEMENT, which the runnable oracle
	// refuses outright (`E3003: 'Names' is a type and cannot be used directly as a value`, measured): a
	// managed static you may declare and may not call a method on is a slot nothing can use, and the compiler has
	// the receiver door to hand.
	//
	// ⚠ **A SCALAR `static let` REACHES THE `none` ARM AND FALLS BACK TO THE PLAIN READ**, which is the right
	// answer rather than a gap: an inlined scalar constant has no slot and no record, so there is nothing a
	// method could mutate and no ownership for a blame name to protect. Its member (if any) is then served by
	// `parsePostfix`'s value receiver exactly as an integer literal's is.
	function parseStaticMemberAccess(func IrFunction, baseTok Token, resultUsed bool) returns ValueId throws SourceParseError
		let memberIndex = self.pos + TokensPerQualifierSegment
		let memberTok = self.tokenAt(memberIndex)
		let nameTok = self.staticMemberNameToken(baseTok, memberTok: memberTok)

		// ON the member token, not past it: `dispatchMethodOnBinding` advances once off the receiver's LAST
		// token and lets `dispatchMethodOnReceiver` consume the `.` — the arrangement every receiver door
		// shares, and the whole reason the cursor is moved here rather than past the pair.
		self.pos = self.pos + TokensPerQualifierSegment

		if self.memberCallFollows(self.pos + 1) 'aMethodOnTheMember'
			match try self.dispatchOnManagedTopLevelReceiver(func, tok: nameTok, resultUsed: resultUsed) 'binding'
				dispatched(result) then return result
				notAManagedReceiver then break
			end 'binding'
		end 'aMethodOnTheMember'

		self.advance()
		return try self.topLevelBindingReference(nameTok)
	end 'parseStaticMemberAccess'

	// ⭐ **DOES `<baseTok>.<member at memberIndex>` NAME A DECLARED STATIC MEMBER?** — the ONE
	// recognizer both the read arm (`parseDottedPrimary`) and the write arm (`staticMemberAssignsAt`) ask,
	// so an expression `Counter.count` and a statement `Counter.count = 1` cannot come to disagree about
	// which spellings are static members. They would: only one of them would then take the static route, and
	// the other would be refused as a missing member or as a field chain through a binding that does not
	// exist.
	//
	// **`containsStruct` IS THE COST, and it is `containsEnum`'s gate for exactly its reason.** This runs on
	// every dotted form that reaches the recognizer — `v == u64.max` among them — and everything past it
	// ALLOCATES the joined name plus the union box each lookup door returns. `containsStruct` is a set
	// membership on bytes already in hand, allocating nothing. A static member is declared in a `type` body,
	// so its base is a declared struct by construction and `u16` never pays the join.
	//
	// A declaration may take a keyword as its name, so the member half is `tokenCanBeAName` rather than
	// `identifier` — the same asymmetry `dottedChainLengthAt` draws between a chain's head and its trailing
	// segments, and for the same reason.
	function namesStaticMemberAt(baseTok Token, memberIndex ElementIndex) returns bool
		if not self.signatures.containsStructFor(baseTok.value, readerFilePath: self.typeNameReaderAt(memberIndex - TokensPerQualifierSegment)) or not tokenCanBeAName(self.tokenAt(memberIndex)) 'notACandidate'
			return false
		end 'notACandidate'

		return self.namesTopLevelBinding(qualifiedMethodName(baseTok.value, methodName: self.tokenAt(memberIndex).value))
	end 'namesStaticMemberAt'

	function staticMemberHeadsAFieldChain(baseTok Token, memberIndex ElementIndex) returns bool
		if self.kindAt(memberIndex + 1) != TokenKind.dot or not self.namesMemberAt(memberIndex + TokensPerQualifierSegment) or self.memberCallFollows(memberIndex + 1) 'noFieldHop'
			return false
		end 'noFieldHop'

		return self.signatures.namesManagedTopLevel(qualifiedMethodName(baseTok.value, methodName: self.tokenAt(memberIndex).value))
	end 'staticMemberHeadsAFieldChain'

	// ⭐⭐ **WHAT `<baseTok>.<member>` IS, ONCE `namesStaticMemberAt` HAS SAID IT IS NOT A READABLE STATIC.**
	// The refusing half of that recognizer, and the ONE reader every refusal door shares.
	//
	// ⭐ **A HIDDEN MEMBER IS INVISIBLE TO `namesStaticMemberAt` BY CONSTRUCTION, WHICH IS THE WHOLE REASON
	// THIS EXISTS.** A reader's probe answers `notFound` for a declaration hidden from it rather than meeting
	// it, leaving the author told the type has no such member about a member that exists.
	// `declVisibilityFrom` asks about the declaration itself, which is the only question that can answer.
	//
	// ⭐ **AND A `visible` VERDICT HERE MEANS NO DECLARATION AT ALL.** `declVisibilityFrom` answers `visible`
	// both for a readable binding and for a name nothing declares; the first is unreachable at this point,
	// the caller having already routed every readable static to `parseStaticMemberAccess`. So the remaining
	// case is the roster's honest `undeclaredMember`.
	function staticRosterVerdictFor(baseTok Token, memberIndex ElementIndex) returns StaticRosterVerdict
		let memberTok = self.tokenAt(memberIndex)

		// A program that declares `type u64` keeps `u64.max` as a bound.
		if not tokenCanBeAName(memberTok) or namesASizedBound(baseTok.value, member: memberTok.value) 'aFormOtherThanAMember'
			return StaticRosterVerdict.notADeclaredTypeMember
		end 'aFormOtherThanAMember'

		let nameReader = self.typeNameReaderAt(memberIndex - TokensPerQualifierSegment)
		let aliasName = self.genericAliasKeyFor(baseTok.value)
		let namesAStruct = self.signatures.containsStructFor(baseTok.value, readerFilePath: nameReader)

		if not namesAStruct and self.staticBaseKindOf(baseTok.value) == StaticBaseKind.declaredName and not self.signatures.isAliasOfFormFor(aliasName, readerFilePath: nameReader, wanted: FormAliasKind.generic) 'notATypeBase'
			return StaticRosterVerdict.notADeclaredTypeMember
		end 'notATypeBase'

		let found = self.methodVerdictOf(self.resolveStaticMember(baseTok, baseIndex: memberIndex - TokensPerQualifierSegment, aliasName: aliasName))

		match found 'method'
			undeclaredMember then break
			notADeclaredTypeMember or
			hidden or
			declaredMethod or
			declaredInstanceMethod or
			hiddenMethod or
			refused or
			requirement then return found
		end 'method'

		if not namesAStruct 'noStaticBindings'
			return StaticRosterVerdict.notADeclaredTypeMember
		end 'noStaticBindings'

		let member = qualifiedMethodName(baseTok.value, methodName: memberTok.value)

		return match self.signatures.declVisibilityFrom(member, readerFilePath: self.job.path) 'visibility'
			visible gives StaticRosterVerdict.undeclaredMember
			hidden(tier) gives StaticRosterVerdict.hidden(tier)
		end 'visibility'
	end 'staticRosterVerdictFor'

	function methodVerdictOf(resolution StaticMemberResolution) returns StaticRosterVerdict
		return match resolution 'resolution'
			surface gives StaticRosterVerdict.declaredMethod
			minted(callee) gives self.methodVerdict(callee)
			named(callee, declaredByAFile) gives self.methodVerdict(callee) if declaredByAFile else StaticRosterVerdict.undeclaredMember
			directory gives StaticRosterVerdict.notADeclaredTypeMember
			requirement(interfaceName) gives StaticRosterVerdict.requirement(interfaceName)
			refused(refusal, readsAsAMethod) gives StaticRosterVerdict.refused(refusal, readsAsAMethod: readsAsAMethod)
		end 'resolution'
	end 'methodVerdictOf'

	function methodVerdict(callee ByteArray) returns StaticRosterVerdict
		return match self.signatures.calleeVisibilityFrom(callee, readerFilePath: self.job.path) 'visibility'
			visible gives StaticRosterVerdict.declaredInstanceMethod if self.signatures.calleeReceiverOf(callee) == CalleeReceiver.takesReceiver else StaticRosterVerdict.declaredMethod
			hidden(tier) gives StaticRosterVerdict.hiddenMethod(tier)
		end 'visibility'
	end 'methodVerdict'

	function staticRosterRefusal(verdict StaticRosterVerdict, baseTok Token, memberTok Token, written String, use StaticMemberUse) returns SourceParseError
		let member = String.from(qualifiedMethodName(baseTok.value, methodName: memberTok.value))

		return match verdict 'verdict'
			hidden(tier) gives SourceParseError.symbolNotVisible(HiddenSymbolKind.staticMember, symbol: member, tier: tier, line: memberTok.line, column: memberTok.column)
			undeclaredMember gives undeclaredStaticMember(baseTok, memberTok: memberTok)
			hiddenMethod(tier) gives SourceParseError.symbolNotVisible(HiddenSymbolKind.functionDeclaration, symbol: written, tier: tier, line: memberTok.line, column: memberTok.column)
			declaredMethod gives self.methodRefusal(MethodKind.callable, written: written, memberTok: memberTok, use: use)
			declaredInstanceMethod gives self.methodRefusal(MethodKind.ofAValue, written: written, memberTok: memberTok, use: use)
			refused(refusal, readsAsAMethod) gives self.methodRefusal(MethodKind.ofAValue, written: written, memberTok: memberTok, use: use) if readsAsAMethod else refusal
			requirement(interfaceName) gives self.methodRefusal(MethodKind.requirementOf(interfaceName), written: written, memberTok: memberTok, use: use)
			notADeclaredTypeMember panic("staticRosterRefusal: '{member}' is not a refusal — every caller asks `staticRosterVerdictFor` and routes only what it refused")
		end 'verdict'
	end 'staticRosterRefusal'

	function methodRefusal(kind MethodKind, written String, memberTok Token, use StaticMemberUse) returns SourceParseError
		return match use 'use'
			read gives methodReadRefusal(kind, written: written, memberTok: memberTok)
			store gives methodAssigned(written, memberTok: memberTok)
		end 'use'
	end 'methodRefusal'

	function nonBoundMemberRefusal(baseTok Token, baseIndex ElementIndex) returns SourceParseError
		let base = String.from(baseTok.value)
		let memberTok = self.tokenAt(baseIndex + TokensPerQualifierSegment)
		let nameReader = self.typeNameReaderAt(baseIndex)

		match self.staticBaseKindOf(baseTok.value) 'kind'
			typeParameter then return memberThroughABaseThatNamesNoValue(base, noun: "a type parameter", memberTok: memberTok)
			primitive then return self.undeclaredBaseRefusal(baseTok, memberTok: memberTok) if self.signatures.namesANamespace(baseTok.value) else primitiveMemberRefusal(baseTok, memberTok: memberTok)
			declaredName then break
		end 'kind'

		let form = try self.signatures.declaredFormOf(baseTok.value, readerFilePath: nameReader) otherwise return self.undeclaredBaseRefusal(baseTok, memberTok: memberTok)

		return match form 'form'
			interfaceType gives memberThroughABaseThatNamesNoValue(base, noun: "an interface", memberTok: memberTok)
			structType gives undeclaredStaticMember(baseTok, memberTok: memberTok)
			enumType gives memberOfABaseWithNoSuchMember(base, noun: "an enum", memberTok: memberTok)
			unionType gives memberOfABaseWithNoSuchMember(base, noun: "a union", memberTok: memberTok)
			rangedAlias gives memberOfABaseWithNoSuchMember(base, noun: "a ranged alias", memberTok: memberTok)
			functionAlias gives memberOfABaseWithNoSuchMember(base, noun: "a function type alias", memberTok: memberTok)
			genericAlias gives self.genericAliasMemberRefusal(baseTok, memberTok: memberTok, nameReader: nameReader, written: self.writtenSpellingOfMemberAt(baseIndex + TokensPerQualifierSegment))
			tupleAlias gives memberOfABaseWithNoSuchMember(base, noun: "a tuple alias", memberTok: memberTok)
		end 'form'
	end 'nonBoundMemberRefusal'

	function undeclaredBaseRefusal(baseTok Token, memberTok Token) returns SourceParseError
		if self.signatures.namesANamespace(baseTok.value) 'aDirectory'
			return memberOfABaseWithNoSuchMember(String.from(baseTok.value), noun: "a directory", memberTok: memberTok)
		end 'aDirectory'

		return SourceParseError.undefinedVariable(String.from(baseTok.value), line: baseTok.line, column: baseTok.column)
	end 'undeclaredBaseRefusal'

	function genericAliasMemberRefusal(aliasTok Token, memberTok Token, nameReader FilePath, written String) returns SourceParseError
		let instanceBase = self.signatures.genericInstanceBaseName(self.signatures.genericAliasInstanceFrom(self.genericAliasKeyFor(aliasTok.value), readerFilePath: nameReader))

		if self.namesTopLevelBinding(qualifiedMethodName(instanceBase, methodName: memberTok.value)) 'aStaticOfTheBase'
			return missingStaticMember("'{written}' is a static of '{String.from(instanceBase)}', which is read through the type itself: write '{String.from(instanceBase)}.{String.from(memberTok.value)}'", anchor: memberTok)
		end 'aStaticOfTheBase'

		let baseForm = try self.signatures.declaredFormOf(instanceBase, readerFilePath: nameReader) otherwise return undeclaredStaticMember(aliasTok, memberTok: memberTok)

		return match baseForm 'baseForm'
			interfaceType gives memberThroughABaseThatNamesNoValue(String.from(aliasTok.value), noun: "an interface instance", memberTok: memberTok)
			structType or
			enumType or
			unionType or
			rangedAlias or
			functionAlias or
			genericAlias or
			tupleAlias gives undeclaredStaticMember(aliasTok, memberTok: memberTok)
		end 'baseForm'
	end 'genericAliasMemberRefusal'

	function typeParameterScopeOf(name ByteArray) returns TypeParameterScope
		if let position = try self.enclosingTypeParams.positionOfName(name) 'ofTheEnclosingType'
			return TypeParameterScope.ofTheEnclosingType(position)
		end 'ofTheEnclosingType'

		if let position = try self.genericBindings.names.positionOfName(name) 'ofTheGenericFunction'
			return TypeParameterScope.ofTheGenericFunction(position)
		end 'ofTheGenericFunction'

		return TypeParameterScope.notAParameter
	end 'typeParameterScopeOf'

	function namesATypeParameter(name ByteArray) returns bool
		return match self.typeParameterScopeOf(name) 'scope'
			ofTheEnclosingType or
			ofTheGenericFunction gives true
			notAParameter gives false
		end 'scope'
	end 'namesATypeParameter'

	function constraintRequirement(paramName ByteArray, memberTok Token) returns ConstraintRequirement
		return match self.typeParameterScopeOf(paramName) 'scope'
			ofTheEnclosingType(position) gives self.requirementThroughConstraints(self.enclosingWhereConstraints, position: position, memberTok: memberTok)
			ofTheGenericFunction(position) gives self.requirementThroughConstraints(self.genericBindings.constraints, position: position, memberTok: memberTok)
			notAParameter panic("constraintRequirement: '{String.from(paramName)}' is neither a parameter of the enclosing type nor of the enclosing generic function — every caller asks `namesATypeParameter` first")
		end 'scope'
	end 'constraintRequirement'

	// A static requirement outranks an instance one of the same name on any constraint: written through the
	// type, `T.m` can only mean the static.
	function requirementThroughConstraints(constraints WhereConstraintArray, position ElementIndex, memberTok Token) returns ConstraintRequirement
		let found = try self.constraintsOnParameter(constraints, position: position, methodName: memberTok.value, errorTok: memberTok) otherwise (err) 'theInterfaceDoesNotResolve'
			return ConstraintRequirement.unresolved(err.clone())
		end 'theInterfaceDoesNotResolve'

		var instanceHolder = ConstraintRequirement.notDeclared

		for constraint in found 'eachConstraint'
			if constraint.declaresStatic 'aStaticRequirement'
				return ConstraintRequirement.staticDeclaredBy(constraint.interfaceName.clone())
			end 'aStaticRequirement'

			if constraint.declaresInstance 'anInstanceRequirement'
				instanceHolder = ConstraintRequirement.instanceDeclaredBy(constraint.interfaceName.clone())
			end 'anInstanceRequirement'
		end 'eachConstraint'

		return instanceHolder
	end 'requirementThroughConstraints'

	function constraintsOnParameter(constraints WhereConstraintArray, position ElementIndex, methodName ByteArray, errorTok Token) returns ConstraintOnParameterArray throws SourceParseError
		let found = ConstraintOnParameterArray.create(0)

		for i in 0 upto constraints.count() 'eachConstraint'
			let constraint = try constraints.get(i) otherwise panic("constraintsOnParameter: constraints.get OOB at {i} below count {constraints.count()}")

			if constraint.typeParamIndex != position 'otherParam'
				continue
			end 'otherParam'

			let iface = try self.requireInterfaceForParse(constraint.interfaceName, methodTok: errorTok)
			let slots = self.witnessSlotsOf(iface)
			var declaresStatic = false
			var declaresInstance = false

			for slotIndex in self.witnessSlotIndicesNamed(slots, methodName: methodName) 'eachNamedSlot'
				if (try slots.get(slotIndex) otherwise panic("constraintsOnParameter: slots.get OOB at {slotIndex} below count {slots.count()}")).method.isStatic 'aStaticSlot'
					declaresStatic = true
				end 'aStaticSlot' else 'anInstanceSlot'
					declaresInstance = true
				end 'anInstanceSlot'
			end 'eachNamedSlot'

			found.push(ConstraintOnParameter.create(i, interfaceName: constraint.interfaceName, iface: iface, declaresStatic: declaresStatic, declaresInstance: declaresInstance))
		end 'eachConstraint'

		return found
	end 'constraintsOnParameter'

	// Does `name` denote a top-level binding this file may read — a `let` it would INLINE, or a slot it
	// would LOAD? Asked as ONE question because the two doors are disjoint by construction (one storage key
	// holds one decl) and a caller routing on it does not care which of them answered:
	// `topLevelBindingReference` asks them again in that same order and materializes whichever hit.
	function namesTopLevelBinding(name ByteArray) returns bool
		let isConstant = match self.constantLookup(name, readerFilePath: self.job.path) 'constant'
			found or
			foundManaged or
			foundImageRecord or
			foundImageBox or
			recordDeferred or
			poisoned gives true
			notFound gives false
		end 'constant'

		if isConstant 'inlined'
			return true
		end 'inlined'

		return match self.signatures.globalDeclFor(name, readerFilePath: self.job.path, into: self.artifact.typeNames) 'global'
			found or
			poisoned gives true
			notFound gives false
		end 'global'
	end 'namesTopLevelBinding'

	function assembleDottedChainAt(index ElementIndex, dots ElementIndex) returns immutable ByteArray
		let assembled = ByteArray.create(0) as isolated ByteArray

		modify assembled 'fill'
			assembled.append(self.tokenAt(index).value)

			for i in 0 upto dots 'eachSegment'
				assembled.append(MethodNameSeparatorBytes)
				assembled.append(self.tokenAt(index + i * TokensPerQualifierSegment + 2).value)
			end 'eachSegment'
		end 'fill'

		return freeze assembled
	end 'assembleDottedChainAt'

	function directoryQualifiedCalleeOf(chain ChainResolution) returns immutable ByteArray
		return match chain 'chain'
			declaredFunction(callee, _) gives callee
			unqualified or
			value or
			declaredType or
			ambiguous or
			nothing panic("Parser.directoryQualifiedCalleeOf: a chain was admitted as a directory-qualified function and is something else")
		end 'chain'
	end 'directoryQualifiedCalleeOf'

	// `utils.helper(…)` / `lib.inner.deepHelper(…)` — consume the qualifier chain and emit the ORDINARY direct
	// call it names. Reached only for a chain `resolveChain` answered `declaredFunction`, from the STATEMENT
	// and EXPRESSION doors alike, at any segment count.
	//
	// ⭐ **THE CALLEE IS THE DECLARATION'S REGISTERED NAME, AND THAT IS WHY THE EMITTED CODE IS UNTOUCHED.** The
	// compiler's function registry is keyed by that name — the bare final segment, or its `<dir>~name` mint once
	// two directories declare it (`ProgramSignatures.namespaceQualifiedFunctionName`) — so `utils.helper` is a
	// ROUTE to the declaration, not a second symbol, and the call op, the linked name and the rendered Target IR
	// are byte-identical to a bare call's. It also puts the tier decision back on the ordinary path —
	// `SemanticCheck.calleeVisibleFrom` refuses `utils.hidden()` with E3008, naming the mistake
	// the reader can act on. Making `{ns}.{name}` the SYMBOL and the bare form a fallback instead
	// would change what a function is CALLED throughout the backend.
	//
	// The chain length is re-read rather than passed in: `dottedChainLengthAt` is a pure token walk that
	// allocates nothing and cannot disagree with the recognizer, and an `else if` predicate has nowhere to
	// bind a value for its own body.
	function parseNamespaceQualifiedCall(func IrFunction, chain ChainResolution, resultUsed bool) returns ValueId throws SourceParseError
		// Bound BEFORE the loop, which moves the cursor: re-reading it from `self.pos` on each iteration
		// would count a chain that is one segment shorter every time round.
		let qualifierDots = self.dottedChainLengthAt(self.pos)

		// WHETHER the written chain or the bare member is the callee is
		// `ProgramSignatures.namespaceQualifiedFunctionName`'s one rule, asked by every directory-qualified door.
		let callee = self.directoryQualifiedCalleeOf(chain)

		// Stops ON the final segment rather than past it: `parseCallNamed` consumes that token itself (it may
		// be a keyword standing as a name) and then the `(`.
		for _ in 0 upto qualifierDots 'eachQualifierSegment'
			self.advance()
			try self.consume(TokenKind.dot)
		end 'eachQualifierSegment'

		return try self.parseCallNamed(func, callee: callee, anchor: self.current(), receiver: ReceiverArg.none, resultUsed: resultUsed, constructorInstance: ConstructorInstance.none, mint: CalleeMint.notMinted)
	end 'parseNamespaceQualifiedCall'

	// `beta.helper` and `lib.inner.helper` READ AS A VALUE — the value door's directory-qualified spelling, the
	// remedy E3095 names. The chain is claimed only where `resolveChain` answered `declaredFunction`, so the
	// written name routes to a free function. Refusals quote the chain as written.
	function parseNamespaceQualifiedFunctionValue(chain ChainResolution) returns ValueId throws SourceParseError
		let headTok = self.current()
		let qualifierDots = self.dottedChainLengthAt(self.pos)
		let writtenName = self.assembleDottedChainAt(self.pos, dots: qualifierDots)
		let memberTok = self.tokenAt(self.pos + qualifierDots * TokensPerQualifierSegment)
		let callee = self.directoryQualifiedCalleeOf(chain)
		self.pos = self.pos + qualifierDots * TokensPerQualifierSegment + 1

		let writtenTok = Token.create(TokenKind.identifier, line: headTok.line, column: headTok.column, value: writtenName, startByte: headTok.startByte, endByte: memberTok.endByte)
		return try self.emitNamedFunctionRef(writtenTok, funcName: callee)
	end 'parseNamespaceQualifiedFunctionValue'

	// `Color.red` — the value of an enum/union case: its TAG, as an i64 `literal` (the raw value for
	// an int backing, the IEEE-754 bit pattern for a float). Named `Color.green` for a case the enum
	// does not have is E3034, positioned at the TYPE name.
	//
	// ⭐ The value is TAGGED `named(Color)` while its literal op is typed `integer`, and the two are
	// deliberately different: the TAG carries the enum's name so a `match` can recognize the scrutinee
	// as a `Color`, and the OP's `integer` type is what the Std lowering reads to give it an i64
	// (a `named` op-type would hit `maxonTypeToStdType`'s panic). Both collapse to i64, so the value's
	// register class and its lowering agree — see `emitEnumTagLiteral`.
	function parseEnumLiteral(func IrFunction, declaredLayout EnumLayout) returns ValueId throws SourceParseError
		// `Self.off` reaches here as `Toggle.off` — see `typeBaseTokenAt`.
		let typeTok = try self.consumeTypeBaseToken()
		try self.consume(TokenKind.dot)

		return try self.parseEnumLiteralMember(func, declaredLayout: declaredLayout, typeTok: typeTok)
	end 'parseEnumLiteral'

	// ⭐⭐ **EVERYTHING PAST `<type> .`, SPLIT OFF FOR THE ONE HEAD THAT IS TWO SEGMENTS LONG.** A
	// SERVICE's request union is named `Calc.request`, so `Calc.request.unionCases.bump` opens with a type name
	// carrying a dot of its own — and every member below means for it exactly what it means for a union the
	// author wrote under one name. The split is what lets the two heads share the member reader instead of the
	// second one re-dispatching into a copy of it.
	//
	// ⚠ `typeTok` is the head the AUTHOR wrote (`Calc`), which is where a diagnostic about a case the union
	// does not have belongs — the same anchor the single-segment head uses, for the reason
	// `unionCasesCompanionOf` states about `Shape` versus `unionCases`.
	function parseEnumLiteralMember(func IrFunction, declaredLayout EnumLayout, typeTok Token) returns ValueId throws SourceParseError
		// ⭐⭐ **`Shape.unionCases.<anything>` IS THE COMPANION'S `<anything>` — ONE HOP, THEN THIS FUNCTION
		// CONTINUES AS IF THE COMPANION HAD BEEN NAMED DIRECTLY.** Every member below — a bare CASE,
		// `allCases`, `allCaseNames`, `fromRawValue` — means for the companion exactly what it means for any
		// other payload-free enum, so the whole of `.unionCases` support past the sweep is this substitution.
		// Writing it as a re-dispatch instead would need each member's arm duplicated under a second head.
		//
		// ⚠ **THE ANCHOR STAYS `typeTok`**, i.e. `Shape` and not `unionCases`: a diagnostic about a case the
		// companion does not have names the type the reader wrote, which is what E3034's position means for
		// every other enum reference.
		let layout = self.unionCasesCompanionOf(declaredLayout, typeTok: typeTok)

		// ⭐ **`<Enum>.allCaseNames` IS A STATIC MEMBER, NOT A CASE** — it is claimed here, ahead of the case
		// lookup, because that lookup's answer for it is E3034 and there is nothing further along this path
		// that could reconsider. The member exists on EVERY enum and union (see `EnumAllCaseNamesMemberName`).
		//
		// ⚠ **NO SPEC COVERS AN ENUM THAT DECLARES A CASE *NAMED* `allCaseNames`.** The member name is decided
		// first here, so the member wins. Nothing in `/specs` states that is right, no corpus or spec enum
		// declares such a case, and reserving the name outright would be a refusal with corpus-wide blast radius
		// that nothing is asking for — so this is an unpinned choice, not a settled rule.
		//
		// The cursor test is `atStaticEnumMember`, the SAME predicate the sweep interns the member's
		// `Array with String` off. The two must agree exactly: the sweep decides whether the instance exists
		// and this decides whether it is read, so a shape one accepts and the other declines is a parse-time
		// lookup for an instance nobody interned.
		if self.atStaticEnumMember(EnumAllCaseNamesMemberName) 'allCaseNames'
			let memberTok = self.current()
			self.advance()
			return try self.emitEnumAllCaseNames(layout, range: SourceRange.ofToken(typeTok))
		end 'allCaseNames'

		// ⭐⭐ **`allCases` AND `fromRawValue` ARE BOTH *ENUM*-ONLY (WHERE `allCaseNames` IS ON BOTH), AND A
		// UNION IS REFUSED THEM IN TWO DIFFERENT SENTENCES — EACH HALF HAS ITS OWN PIN.** `allCases` earns a
		// refusal BY NAME: `allCases is not available on unions`, E4006, at the TYPE token, pinned by
		// `specs/enum-allcases.md`'s `enum-allcases.error-enum`. `fromRawValue` instead FALLS THROUGH to the
		// case lookup and comes out `unknown union case: 'fromRawValue'`, E3034, pinned by
		// `specs/enum-full.md`'s `error.fromRawValue-associated-values`. ⇒ **A change that moves either pin has
		// merged two rules the language keeps apart.**
		//
		// ⛔⛔ **THIS COMMENT USED TO RECORD THE E4006 MEASUREMENT AND THEN CONCLUDE THAT *BOTH* MEMBERS FALL
		// THROUGH — the two halves of one paragraph saying opposite things — and the code obeyed the wrong
		// half.** `allCases` sat inside a single `not layout.isUnion` gate with `fromRawValue`, so a union got
		// E3034 for it and `enum-allcases.error-enum` was red on a spec whose expectation the same paragraph
		// quotes correctly. The measurement was right; the disposition it drew was the OTHER member's.
		//
		// `allCaseNames` (above) needs no gate at all: it returns only NAMES, which every declaration has
		// (see `EnumAllCaseNamesMemberName`).
		//
		// The SYNTHESIZED `<Union>.unionCases` companion is an ENUM, which is precisely how a payload-bearing
		// union reaches this surface at all — through the hop above, never through the refusal here.
		//
		// `<Enum>.allCases` is interned by the same sweep walk `allCaseNames` is; the two are siblings in
		// every respect but their element type. A UNION never reads that instance, so the throw below cannot
		// desynchronize the sweep from this read (see `atStaticEnumMember`).
		//
		// ⚠ **THE REFUSAL IS ASKED BEFORE THE CASE LOOKUP, so it now reaches a union that DECLARES a case
		// named `allCases` as well** — which is the member-name-first ordering `allCaseNames` above
		// records. Nothing in `/specs` or the corpus declares such a case, so the ordering stays exactly
		// as wide as the one already recorded; it is not a second decision.
		if self.atStaticEnumMember(EnumAllCasesMemberName) 'allCases'
			if layout.isUnion 'allCasesOnUnion'
				throw SourceParseError.allCasesOnUnion(typeTok.line, column: typeTok.column)
			end 'allCasesOnUnion'

			self.advance()
			return try self.emitEnumAllCases(layout, range: SourceRange.ofToken(typeTok))
		end 'allCases'

		// `<Enum>.fromRawValue(raw)` — the one member of this surface that is a CALL, and the one that
		// throws. Claimed here so the case lookup never sees it, EXCEPT on the two constructs where the
		// member does not exist and that lookup is the right answer: a UNION (per the pin above) and —
		//
		// ⛔⛔ **A STRUCT-BACKED ENUM.** `.rawValue` on such an enum denotes no VALUE in the compiler — only
		// `.rawValue.<field>` does, a select per field — so there is nothing `fromRawValue` could take as
		// an argument and nothing for it to hand back. Declining the claim here lets
		// `enumCaseIndexOrThrow` word it, which is `E3034 unknown enum case: 'fromRawValue'` at the TYPE
		// name — the verdict `specs/enum-struct-backing.md`'s `error.struct-backing-fromRawValue` pins.
		//
		// ⚠ It is deliberately NOT the E2015 the other non-integer backings get
		// (`requireFromRawValueBacking`): those declare a raw value the compiler declines to SEARCH, which is a
		// different sentence from a member that is not there.
		if self.atStaticEnumMember(EnumFromRawValueMemberName) and not layout.isUnion and layout.backing != EnumBacking.structRecord 'fromRawValue'
			let memberTok = self.current()
			self.advance()
			return try self.parseEnumFromRawValue(func, layout: layout, memberTok: memberTok, range: SourceRange.ofToken(typeTok))
		end 'fromRawValue'

		// ⭐⭐ **`<Enum>.fromName(name)` — THE SIBLING LOOKUP, AND THE ONE MEMBER OF THIS SURFACE CLAIMED
		// UNCONDITIONALLY.** Every arm above it carries a gate — `allCases` is refused on a union,
		// `fromRawValue` declines the claim on a union and on a struct backing — and this one carries
		// none, which is a fact about the QUESTION and not an oversight. Those two read the case TAG
		// column, whose meaning depends on the declaration's keyword and backing; this reads the case
		// NAME column, which every declaration has in full. See `EnumFromNameMemberName` for the
		// derivation.
		//
		// ⚠ **IT IS ASKED BEFORE THE CASE LOOKUP, so a declaration that names a case `fromName` loses it
		// to the member** — the member-name-first ordering `allCaseNames` records above, and not a second
		// decision. On `enum Weird  fromName  other end` + `let w = Weird.fromName` the MEMBER is read
		// and the program is refused with **E2010** *Expected '(' but got 'newline'*. A refusal is the
		// safe direction for a collision no `/specs` case and no corpus declaration contains, but the
		// diagnostic is the parser's generic one and does not name the collision, so this is a recorded
		// gap and not a settled rule, exactly as its sibling's is.
		if self.atStaticEnumMember(EnumFromNameMemberName) 'fromName'
			let memberTok = self.current()
			self.advance()
			return try self.parseEnumFromName(func, layout: layout, memberTok: memberTok, range: SourceRange.ofToken(typeTok))
		end 'fromName'

		let caseTok = try self.consumeNameToken(NamePosition.enumCase)

		let index = try self.enumCaseIndexOrThrow(layout, nameTok: caseTok, posTok: typeTok)
		let range = SourceRange.ofToken(typeTok)

		// ⭐⭐ **`Op.doubleOp.rawValue`, `Preset.large.width`, `TestOp.mul.latency` — A MEMBER READ ON A CASE
		// NAMED THROUGH ITS TYPE.** A type-qualified case is the ONE enum reference that reaches an accessor
		// without ever being bound to a name, so nothing upstream can route it: `parseDottedPrimary`'s accessor
		// arm tests a base that is a BINDING, and the postfix loop reads `. <name>` as a method call and
		// demanded a `(` (*"Expected '(' but got 'newline'"* — MEASURED on `Mime.json.rawValue` and on
		// `Preset.large.width`, both of which the oracle compiles). So the hop is claimed here and answered by
		// the SAME emitter a binding's accessor uses — one dispatch, not a second one free to disagree.
		//
		// ⭐⭐ **IT IS ASKED *BEFORE* THE REPRESENTATION SPLIT BELOW, AND THAT IS WHAT LETS A BOXED UNION REACH
		// IT.** The case is already resolved, so its tag is a compile-time constant and no value need exist
		// (`emitEnumCaseTagConstant`) — which is the whole difference between reading `TestOp.mul`'s metadata
		// and CONSTRUCTING `TestOp.mul`, an act that would demand the `dest`/`src` arguments the read has none
		// of. `/specs/union-struct-backing.md` writes exactly that read.
		//
		// ⚠ **NOTHING IS ALLOCATED ON THIS PATH, WHICH IS WHY IT IS NOT THE DECLINED LIFETIME QUESTION.**
		// `Shape.circle(1).rawValue` — a member read on a CONSTRUCTED rvalue box — keeps its existing
		// *"Expected '('"* routing, because there the box IS built and enrolled as an owned temporary, and
		// reading one field out of it asks who drops it and when. That question is still nobody's; this path
		// never puts it.
		//
		// ⚠ **A TRAILING `(` LEAVES IT ALONE, which is how a binding's accessor is separated from a same-named
		// METHOD too** — there by `parseDottedPrimary` asking `methodCallsAt` first, here by
		// `atEnumInstanceAccessor` stating it, because no earlier arm claims the type-qualified call shape.
		if self.atEnumInstanceAccessor(layout, index: self.pos) 'accessorHop'
			return try self.consumeEnumAccessorHop(layout, tag: self.emitEnumCaseTagConstant(layout, index: index, range: range), anchorTok: typeTok)
		end 'accessorHop'

		// ⭐ A PAYLOAD-BEARING union is a box or a tagged word, and EVERY case of it takes that form — a
		// payload-free case (`Container.empty`) is a bare tag in a box, or the stored tag alone in a
		// word, so the lifetime is uniform (`carriesPayloads` decides once, per the union, not per the
		// case). A payload-free enum/union stays the bare-i64-tag representation.
		match self.signatures.unionRepresentation(layout) 'representation'
			box or
			word then return try self.parseEnumBoxConstruct(func, layout: layout, caseIndex: index, caseTok: caseTok, range: range)
			bareTag then break
		end 'representation'

		// A payload-free enum/union case carries no value list. `Color.red(5)` is a payload on a
		// construct that declares none — refused rather than silently dropped.
		if self.at(TokenKind.leftParen) 'unexpectedPayload'
			let parenTok = self.current()
			throw SourceParseError.unsupported("a payload on case '{String.from(caseTok.value)}' of `{layout.kindWord()} {String.from(layout.name)}`, which declares no payload on any case", line: parenTok.line, column: parenTok.column)
		end 'unexpectedPayload'

		// An unboxed case's VALUE is its tag, which is the unboxed arm of the very function the hop above
		// takes its tag from — so the two readings are one line and cannot come apart.
		return self.emitEnumCaseTagConstant(layout, index: index, range: range)
	end 'parseEnumLiteralMember'

	// ⭐⭐ **`. <member>` — THE TWO-TOKEN SHAPE ITSELF, WRITTEN ONCE FOR BOTH SPELLINGS OF AN ENUM ACCESSOR.**
	// A binding's (`op.rawValue`, `enumMemberReadableOfType`) and a type-qualified case's (`Op.doubleOp.rawValue`,
	// `atEnumInstanceAccessor`) read the identical dot-then-member test at two different offsets, and the
	// OFFSET ARITHMETIC is what must be written once: `index` is the dot and `index + 1` is the member, and a
	// door that spells that itself is free to classify the wrong token.
	//
	// ⭐⭐ **THE TWO DOORS ADMIT THE SAME MEMBER SET — ONE RULE, `enumMemberIsReadable`.** A door that admitted only the
	// three accessors while the other admitted a struct backing's FIELD (`p.width`) would be a gap wearing a design's
	// clothes: **`/specs/union-struct-backing.md` writes `TestOp.mul.latency`**, and the oracle compiles the enum
	// spelling of it too (`Preset.large.width` ⇒ 9, MEASURED). What is shared is the shape AND
	// the rule; what stays each door's own is the `(` exclusion, which genuinely differs (see
	// `atEnumInstanceAccessor`).
	function enumMemberTokenAt(index ElementIndex) returns Token
		return self.tokenAt(index + 1)
	end 'enumMemberTokenAt'

	// Is there a `. <member>` at `index` at all — the shape both doors open with, before either asks whether
	// the member is one IT admits.
	function enumMemberReadFollowsAt(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.dot
	end 'enumMemberReadFollowsAt'

	// Is there a `. <member>` at `index` naming something readable off a value of `layout`, and is it NOT a
	// call — the tail of `Op.doubleOp.rawValue`, of `Preset.large.width`, of `TestOp.mul.latency`? The
	// admission rule is `enumMemberIsReadable`, shared with the binding door; the `(` exclusion is genuinely
	// this door's own, because a BINDING's accessor gets it from `parseDottedPrimary` asking `methodCallsAt`
	// first, while nothing upstream claims the type-qualified `Color.red.name()` shape.
	//
	// ⚠ **THE MEMBER SET IT ADMITS, ENUMERATED — because a widened predicate can
	// admit a member its premise is false for.** `enumMemberIsReadable` says yes to exactly two
	// things: one of the three accessors the language defines on every enum VALUE, and — on a `structRecord`
	// backing whose struct some file DECLARES — a field of that struct. Both are
	// answered from the case's TAG and nothing else (`emitEnumInstanceAccessor`), and the tag of a
	// type-qualified case is a compile-time constant in BOTH representations
	// (`emitEnumCaseTagConstant`) — so unlike `.ordinal`'s measured defect there is no value here whose
	// representation the answer could be wrong about, boxed or not.
	function atEnumInstanceAccessor(layout EnumLayout, index ElementIndex) returns bool
		if not self.enumMemberReadFollowsAt(index) 'notAMemberRead'
			return false
		end 'notAMemberRead'

		if self.enumMemberTrailerAt(index) == TokenKind.leftParen 'aCall'
			return false
		end 'aCall'

		return self.enumMemberIsReadable(layout, memberTok: self.enumMemberTokenAt(index))
	end 'atEnumInstanceAccessor'

	// ⭐⭐ **IS THE CURSOR ON AN ACCESSOR HOP READABLE OFF `value`?** ONE door for the two callers that hold a
	// VALUE rather than a binding or a type name: `parsePostfix`, where the receiver is whatever the
	// expression just built, and `emitEnumBackingFieldSelect`, whose selected leaf may itself be enum-typed.
	// Both spelled these gates out, and the field-chain fix was about to spell them a third time.
	//
	// ⚠⚠ **IT ANSWERS `bool` AND NEVER TOUCHES `enumMatchFor`, AND THE LADDER IS WHY.** A `DeclaredEnum` is a
	// union VALUE that heap-allocates even to say `undeclared` — the cost `valueIsUnion` and
	// `enumMemberReadableOfType` both arrange their gates around — and this is asked at EVERY `.` in every postfix
	// chain in the program. Written to RETURN one, it charged **+288 allocations at rung 0 of the scale
	// ladder, doubling at every rung**; the same reading survived putting `containsEnum` in front of the
	// lookup, because the box was the RETURN and not the query. So the three cheap tests — token shape, the
	// value's scalar tag column, and a set membership over bytes already in hand — stand in front, and the
	// only allocating call left is `enumOf` on a value that really is an enum. The caller re-derives the
	// LAYOUT on the taken path, which is `enumMemberReadableOfType`'s own arrangement with `parseEnumAccessor`.
	function atEnumAccessorHopOn(value ValueId) returns bool
		if not self.enumMemberReadFollowsAt(self.pos) 'noMemberFollows'
			return false
		end 'noMemberFollows'

		if self.tagOf(value) != ValueTypeTag.named 'notANamedValue'
			return false
		end 'notANamedValue'

		return self.atEnumAccessorHopOfType(self.valueTypeName(value))
	end 'atEnumAccessorHopOn'

	// ⭐ **THE TAIL BOTH DOORS SHARE — is the cursor on an accessor hop readable off a value whose TYPE is
	// spelled `typeName`?** `atEnumAccessorHopOn` reaches it from a VALUE's tag column and
	// `enumAccessorFollowsFieldTyped` from a FIELD's declared type; past the name they are the same two
	// questions, so they are asked here once. Written twice, one door could come to admit a member the other
	// refuses — and the two decide the SAME hop from opposite sides of one field load.
	//
	// ⚠ **`containsEnum` BEFORE `enumOf`, and it is the allocation guard both callers' headers record**: a
	// `DeclaredEnum` heap-allocates even to say `undeclared`, and this runs at every `.` in every postfix
	// chain and at every intermediate field hop. The membership test is over bytes already in hand.
	function atEnumAccessorHopOfType(typeName ByteArray) returns bool
		if not self.signatures.containsEnumFor(typeName, readerFilePath: self.job.path) 'notAnEnumName'
			return false
		end 'notAnEnumName'

		return self.atEnumInstanceAccessor(requireEnumLayout(self.signatures.enumFor(typeName, readerFilePath: self.job.path)), index: self.pos)
	end 'atEnumAccessorHopOfType'

	// The kind of the token FOLLOWING the member — `index + 2`, the third of the three this shape spans, and
	// the one the `(` exclusion tests. It sits beside `enumMemberTokenAt` on that helper's own argument: the
	// OFFSET ARITHMETIC is what must be written once, and a door spelling `+ 2` itself is free to classify the
	// wrong token. `+ 1` lived here and `+ 2` did not, which is that argument one offset short.
	function enumMemberTrailerAt(index ElementIndex) returns TokenKind
		return self.kindAt(index + 2)
	end 'enumMemberTrailerAt'

	// ⭐⭐ **CONSUME THE `. <member>` HOP AND ANSWER — THE MIRROR OF `enumMemberTokenAt`'S OFFSET ARITHMETIC,
	// AND WRITTEN ONCE FOR THE IDENTICAL REASON.** Both callers past `atEnumInstanceAccessor` had these three
	// lines verbatim, differing only in the tag expression and the anchor token: `parseEnumLiteral`'s
	// type-qualified case and `emitEnumBackingFieldSelect`'s hop past a selected enum-typed field.
	//
	// ⚠ **THE COPIES COULD NOT BE MADE TO DISAGREE LOUDLY.** `consumeMemberNameToken` already admits more than
	// an identifier (a keyword, and a NUMBER rewritten into a name for a tuple member); widen the member to
	// TWO tokens and one site consumes one token too few — a parse error at a token nobody wrote, not a
	// compile error anywhere. `anchorTok` is the caller's because the RANGE is the caller's fact: the read
	// spans from the type name in one spelling and from the first field name in the other.
	function consumeEnumAccessorHop(layout EnumLayout, tag ValueId, anchorTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.dot)
		let memberTok = try self.consumeMemberNameToken()

		return try self.emitEnumInstanceAccessor(layout, tag: tag, memberTok: memberTok, range: SourceRange.between(anchorTok, last: memberTok))
	end 'consumeEnumAccessorHop'

	// ⭐ **CONSUME A `unionCases .` HOP AND ANSWER WITH THE COMPANION'S LAYOUT** — or hand back the layout that
	// was named, unchanged, when the cursor is on anything else.
	//
	// ⚠ **A COMPANION THE SWEEP DID NOT SYNTHESIZE IS AN ORDINARY UNKNOWN CASE, NOT A PANIC.** `unionCases` is
	// synthesized only for a union with associated values (`appendUnionCasesCompanion`), so writing
	// `Color.unionCases.red` on a payload-free enum finds no registered companion — and the honest answer is
	// the one the reader can act on: E3034 at the type name, exactly as any other member that names no case
	// gets. So the hop is NOT consumed when the companion is absent, and the case lookup below reports it.
	function unionCasesCompanionOf(layout immutable EnumLayout, typeTok Token) returns immutable EnumLayout
		if not self.atUnionCasesAccess() 'notTheCompanion'
			return layout
		end 'notTheCompanion'

		if not self.signatures.containsEnumInAnyFile(unionCasesCompanionName(layout.name)) 'noCompanionRegistered'
			return layout
		end 'noCompanionRegistered'

		self.advance()
		try self.consume(TokenKind.dot) otherwise panic("unionCasesCompanionOf: `atUnionCasesAccess` required a `.` after `{String.from(UnionCasesMemberName)}` at `{String.from(typeTok.value)}` and it is not there — the predicate and this consumption read the same two tokens")

		return requireEnumLayout(self.signatures.enumInAnyFile(unionCasesCompanionName(layout.name)))
	end 'unionCasesCompanionOf'

	// ⭐⭐ **MATERIALIZE `<Enum>.allCases` — an OWNED `Array with <Enum>` of every case value, in declaration
	// order.** `emitEnumAllCaseNames`' twin one column over, and deliberately built the same way: what the
	// member denotes is a VALUE of a type the language already has, so `.count()`, `.get(0)` and
	// `for c in …` reach it through the ordinary machinery with no accessor protocol of its own.
	//
	// ⭐ **ITS ELEMENTS NEED NO MOVE-IN, WHERE `allCaseNames`' DO.** A case value is a bare i64 tag — a scalar
	// the array copies by value — so there is no ownership to transfer; the names member has to promote each
	// borrowed literal because the array's element destructor releases every live slot.
	//
	// ⚠ **THE INSTANCE IS READ BACK, NEVER FIRST INTERNED HERE** — `atContainerFromConstruction`'s
	// discipline, and `emitEnumAllCaseNames`' note in full: a parse-time intern would be the first
	// write to a shared registry mid-parse and the gid would depend on parse order.
	// `ProgramSignatures.internEnumElementInstances` interns one per declared enum for any program
	// that names the member.
	function emitEnumAllCases(layout EnumLayout, range SourceRange) returns ValueId throws SourceParseError
		let giid = self.signatures.builtinInstanceForNamedElement(self.signatures.arrayRecordBaseName(), element: layout.name)
		let arr = try self.emitArrayCreateOp(giid, range: range, sizing: ValueIdArray.create(0))

		for i in 0 upto layout.caseCount() 'eachCase'
			self.emitArrayPush(arr, element: self.emitEnumTagLiteral(layout.name, tag: layout.tagOfIndex(i), range: range), range: range)
		end 'eachCase'

		self.trackOwnedTemp(arr, exclusivity: OwnedHeapExclusivity.sole)
		return arr
	end 'emitEnumAllCases'

	// ⭐⭐ **`<Enum>.fromRawValue(raw)` — THE REVERSE LOOKUP, EMITTED AS A CALL TO THE PER-ENUM Std HELPER.**
	// The parser's whole job here is the argument and the two refusals; the search itself is
	// `Runtime/EnumLookupRuntime.maxon`'s, which is where the reason it must be a call is written down.
	//
	// ⚠ **ENUM-ONLY, WHICH IS `union-scalar-backing.md`'s COMMITTED PROSE.** A union answers
	// `unknown union case: 'fromRawValue'` — that spec's own documentation section says so outright — so the
	// member is claimed only for an enum and a union falls through to the case lookup that already words it
	// that way. The SYNTHESIZED companion is an enum, which is exactly how `Shape.unionCases.fromRawValue(0)`
	// is reached.
	function parseEnumFromRawValue(func IrFunction, layout EnumLayout, memberTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.requireFromRawValueBacking(layout, memberTok: memberTok)

		try self.consume(TokenKind.leftParen)
		let argTok = self.current()
		let raw = try self.parseValueExpression(func)
		try self.consume(TokenKind.rightParen)

		// ⭐ **THE ARGUMENT'S DOMAIN IS THE BACKING'S**, so the sentence names the type the declaration
		// actually takes — `expected float, got int` on a float-backed enum, where a fixed `int` would have
		// named a type the program does not contain. The renderer is the shared one, so this position and the
		// payload one cannot come to word one rejection two ways.
		let expected = enumRawValueArgumentTag(layout.backing)

		if not self.rawValueArgumentSuits(raw, expected: expected) 'wrongDomain'
			let mismatch = SourceParseError.typeMismatchExpectedGot(typeTagName(expected), got: self.valueDisplayTypeName(raw), line: argTok.line, column: argTok.column, expectedNote: "", crossesRange: false)

			try self.refuseUnlessDeferred(mismatch, value: raw)
		end 'wrongDomain'

		// ⭐⭐ **A LITERAL THAT NAMES NO CASE IS REFUSED HERE, NOT LEFT TO THE RUN-TIME THROW.** Both
		// references fold a constant argument against the case list, and `/specs/constants.md`'s
		// `error.fromRawValue-invalid-literal` pins the verdict. The call still stands: `try` binds to one,
		// and a resolved literal simply makes the helper's throw unreachable.
		try self.requireFoldedRawValueNamesACase(layout, raw: raw, memberTok: memberTok)

		return self.emitRuntimeCall(enumFromRawValueSymbol(layout.name), args: argsOf(self.rawValueSearchKey(raw, backing: layout.backing, range: range)), resultTag: ValueTypeTag.named, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)
	end 'parseEnumFromRawValue'

	// Does the written argument suit the backing's domain? A `named` value is admitted wherever an integer is
	// — a ranged alias IS an int, and every other door in this file reads it that way.
	function rawValueArgumentSuits(raw ValueId, expected ValueTypeTag) returns bool
		let got = self.tagOf(raw)

		if expected == ValueTypeTag.integer 'aNumber'
			return tagIsIntegral(got)
		end 'aNumber'

		return got == expected
	end 'rawValueArgumentSuits'

	// ⭐ **WHAT THE HELPER ACTUALLY SEARCHES BY, which is the tag column's own currency.** A float's tag is
	// its IEEE-754 BIT PATTERN, so the argument is reinterpreted here rather than in the helper — the same
	// handoff `emitEnumRawValue` makes in the other direction. Every other backing passes its value through:
	// an integer is already the tag, and a byte record is compared as bytes.
	function rawValueSearchKey(raw ValueId, backing EnumBacking, range SourceRange) returns ValueId
		if backing != EnumBacking.float 'notAFloatBacking'
			return raw
		end 'notAFloatBacking'

		return self.emitUnaryOp(raw, op: MaxonUnaryOp.floatToBits, resultTag: ValueTypeTag.integer, range: range)
	end 'rawValueSearchKey'

	// ⭐ **THE COMPILE-TIME LOOKUP, for an argument the parser can already see.** Only a NUMBER folds: a
	// byte-record argument is a record this tier holds no value for, so a `Grade.fromRawValue('Z')` is left
	// to the helper's own throw — the honest answer rather than a fold that reads a pointer as a codepoint.
	function requireFoldedRawValueNamesACase(layout EnumLayout, raw ValueId, memberTok Token) throws SourceParseError
		if enumRawValueIsBytes(layout.backing) or not self.constIsKnown(raw) 'nothingToFold'
			return
		end 'nothingToFold'

		let value = self.constOf(raw)

		for i in 0 upto layout.caseCount() 'eachCase'
			if layout.tagOfIndex(i) == value 'namesThisCase'
				return
			end 'namesThisCase'
		end 'eachCase'

		throw SourceParseError.enumNoSuchRawValue(self.foldedRawValueSpelling(raw, backing: layout.backing), enumName: String.from(layout.name), line: memberTok.line, column: memberTok.column)
	end 'requireFoldedRawValueNamesACase'

	// The number as the author wrote it — a float backing's constant is an IEEE-754 bit pattern, and quoting
	// those bits at someone who wrote `2.5` would name a number their program does not contain. Through the
	// shared renderer, so a folded constant is spelled the same way here as in every other diagnostic.
	function foldedRawValueSpelling(raw ValueId, backing EnumBacking) returns String
		return scalarConstantText(self.constOf(raw), isFloat: backing == EnumBacking.float)
	end 'foldedRawValueSpelling'

	// ⭐ **WHICH BACKINGS `fromRawValue` IS BUILT FOR, AND WHY THE OTHER THREE ARE A REFUSAL RATHER THAN A
	// SILENT WRONG ANSWER.** The helper searches the layout's TAG column, which is the raw-value column only
	// for an `integer` backing and for an unnumbered enum (whose raw value IS its declaration index). A
	// STRING backing's tags are declaration indices and its raw values are text; a FLOAT or CHARACTER raw
	// value is not an i64 argument at all; and a FUNCTION raw value has no literal spelling to look up by at
	// all — a code address is not something a program can write down. Each of those needs a
	// differently-typed parameter and a different comparison, and no committed case exercises one, so they
	// are named and refused here.
	//
	// ⭐⭐ **THE STRUCT BACKING IS NOT ONE OF THEM, AND ITS ANSWER IS AN ABSENCE RATHER THAN A REFUSAL** — see
	// the claim site in `parseEnumLiteral`, which never lets one reach here. The distinction is real: every
	// backing named below HAS a raw value a program can write down and the compiler declines to search FOR it, while a
	// struct-backed enum has no `.rawValue` VALUE at all in the compiler (only `.rawValue.<field>`, a select per
	// field), so there is no argument `fromRawValue` could take and no member for it to be.
	function requireFromRawValueBacking(layout EnumLayout, memberTok Token) throws SourceParseError
		match layout.backing 'backing'
			integer or
			unresolved or
			float or
			character or
			string then break
			functionRef then throw SourceParseError.unsupported("`{String.from(EnumFromRawValueMemberName)}` on `{layout.kindWord()} {String.from(layout.name)}`, which is {enumBackingNoun(layout.backing, backingStruct: layout.backingStruct)}-backed — a code address has no literal spelling a program could look one up BY, which is why the reference refuses this backing here too", line: memberTok.line, column: memberTok.column)
			structRecord then panic("requireFromRawValueBacking: `{layout.kindWord()} {String.from(layout.name)}` is struct-backed and reached the `{String.from(EnumFromRawValueMemberName)}` guard — `parseEnumLiteral` does not CLAIM the member for that backing, so such a call is an unknown case (E3034) and never arrives here")
		end 'backing'
	end 'requireFromRawValueBacking'

	// ⭐⭐ **`<Enum>.fromName(name)` / `<Union>.fromName("case", payload…)` — THE LOOKUP BY CASE NAME,
	// EMITTED AS A CALL TO A PER-DECLARATION Std HELPER.** Its sibling `fromRawValue`'s shape exactly — the
	// search is `Runtime/EnumLookupRuntime.maxon`'s and the reason it must be a call is written down there —
	// with the whole of the difference in one place: the argument is a String, so no backing is refused and no
	// keyword is excluded (see `EnumFromNameMemberName`).
	//
	// ⭐⭐ **A LITERAL NAME IS RESOLVED AT COMPILE TIME, AND STILL EMITS THE CALL.** A literal is validated
	// against the case list and an unknown one is E3034 rather than a run-time throw, which
	// `/specs/constants.md`'s `error.fromName-invalid-case` pins. The CALL stays because `try` binds to one:
	// a resolved literal simply makes the helper's throw unreachable, which costs the compare chain and
	// nothing else.
	//
	// ⭐⭐ **THE ANCHOR FOR EVERY REFUSAL HERE IS THE MEMBER TOKEN, AND A SPEC PINS IT.**
	// `/specs/constants.md` pins column 25 of `let _d = try Direction.fromName("…")` and
	// `/specs/enum-full.md` column 25 of `let _c = try Container.fromName("value")` — both the `fromName`
	// token.
	//
	// ⚠ It is deliberately NOT the TYPE token a bare `Color.green` case refusal uses: what the author got
	// wrong is an argument to this member, not the enum they named.
	function parseEnumFromName(func IrFunction, layout EnumLayout, memberTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)

		if self.atLiteralCaseNameArgument() 'compileTimeName'
			return try self.parseEnumFromNameLiteral(func, layout: layout, memberTok: memberTok, range: range)
		end 'compileTimeName'

		let name = try self.parseValueExpression(func)

		// The argument's domain is `String`, whatever the declaration is — read through the shared
		// renderer so this position and the literal one cannot come to word one rejection two ways.
		if not tagIsText(self.tagOf(name)) 'notAString'
			let mismatch = SourceParseError.typeMismatchExpectedGot(typeTagName(ValueTypeTag.string), got: self.valueDisplayTypeName(name), line: memberTok.line, column: memberTok.column, expectedNote: "", crossesRange: false)

			try self.refuseUnlessDeferred(mismatch, value: name)
		end 'notAString'

		try self.consume(TokenKind.rightParen)

		return self.emitEnumFromNameCall(layout, args: argsOf(name), range: range)
	end 'parseEnumFromName'

	// ⭐ **IS THE ARGUMENT A BARE STRING LITERAL — the shape whose case is a COMPILE-TIME fact?** A
	// `stringLiteral` token standing immediately before the `)` or the `,` IS the whole argument: there is no
	// operator it could be the left side of (a following `stringInterpStart` would make it an interpolation,
	// and an interpolation's first token cannot be followed by either of these). Asked at the CURSOR rather
	// than off the emitted op, because the literal path must decide BEFORE it emits — an unknown name and a
	// wrong arity are refusals that leave no code behind.
	function atLiteralCaseNameArgument() returns bool
		if not self.at(TokenKind.stringLiteral) 'notALiteral'
			return false
		end 'notALiteral'

		let after = self.peekKind()
		return after == TokenKind.rightParen or after == TokenKind.comma
	end 'atLiteralCaseNameArgument'

	// The compile-time half: resolve the literal to a case, check the payload arity the call supplies against
	// the one that case declares, and emit the call the resolution earned — the general helper for a
	// payload-free case, the per-case one for a payload-bearing case (see `synthesizeEnumFromNameCase`).
	function parseEnumFromNameLiteral(func IrFunction, layout EnumLayout, memberTok Token, range SourceRange) returns ValueId throws SourceParseError
		let nameTok = try self.consume(TokenKind.stringLiteral)
		let wanted = try self.decodedStringLiteralBytes(nameTok)

		let index = try layout.indexOfCase(wanted) otherwise throw SourceParseError.enumNoCaseNamed(layout.kindWord(), caseName: String.from(wanted), typeName: String.from(layout.name), line: memberTok.line, column: memberTok.column)

		if layout.payloadArityAt(index) == 0 'payloadFree'
			// A payload-free case takes the name and nothing else; anything further is the arity refusal
			// below's business, stated once for both directions.
			try self.requireNoFurtherPayloadArgs(wanted, expected: 0, memberTok: memberTok)
			try self.consume(TokenKind.rightParen)
			return self.emitEnumFromNameCall(layout, args: argsOf(self.emitStringLiteral(wanted, range: SourceRange.ofToken(nameTok))), range: range)
		end 'payloadFree'

		return try self.parseEnumFromNameCase(func, layout: layout, caseIndex: index, nameTok: nameTok, memberTok: memberTok, range: range)
	end 'parseEnumFromNameLiteral'

	// ⭐⭐ **`<Union>.fromName("value", 42)` — A LITERAL NAME NAMING A PAYLOAD-BEARING CASE.** The payload
	// arguments are read, TYPE-CHECKED and MOVED IN here, at the parser, through the very doors
	// `Container.value(42)` goes through (`classifyUnionPayload`, `requirePayloadArgType`,
	// `moveInPayload`), and the synthesized helper receives values that are already owned and stores them
	// verbatim. That split is deliberate: ownership is a fact about the CALLER's bindings — which local was
	// poisoned, which temporary stopped owing a drop — and a Std-tier body can see none of it.
	//
	// ⚠ **THE ARGUMENTS ARE POSITIONAL, WHERE `Container.value(n: 42)`'s ARE NOT.** A construct's payload list
	// follows the call-arg rule (first positional, the rest named, slotted by payload FIELD name); this list
	// is `fromName`'s own and is read as a plain positional tail — one comma plus one expression per declared
	// slot. No spec exercises a labelled one, and inventing a second slotting rule for a spelling nothing
	// writes would be a divergence with nothing behind it.
	//
	// ⭐ **THE RESULT IS MINTED BEFORE THE ARGUMENTS ARE MOVED IN**, because an opaque slot's move-in has to
	// name the record that will own it and that record IS this call's result — see `emitRuntimeCallInto`.
	function parseEnumFromNameCase(func IrFunction, layout EnumLayout, caseIndex CaseIndex, nameTok Token, memberTok Token, range SourceRange) returns ValueId throws SourceParseError
		let payloads = layout.payloadsAt(caseIndex)
		let arity = layout.payloadArityAt(caseIndex)
		let caseName = layout.caseNameAt(caseIndex)

		let slotValues = ValueIdArray.create(arity, zeroed: false)
		let slotBareLocal = BoolArray.create(arity, zeroed: false)
		let slotAnchors = TokenIndexArray.create(arity, zeroed: false)

		for _ in 0 upto arity 'eachSlot'
			if not self.at(TokenKind.comma) 'tooFew'
				throw SourceParseError.enumFromNamePayloadArity(String.from(caseName), expected: arity, line: memberTok.line, column: memberTok.column)
			end 'tooFew'

			try self.consume(TokenKind.comma)

			// The value's start is captured before it is parsed so `rhsWasBareLocalReference` can decide
			// afterwards whether it was a bare local — what a managed payload's move-in poisons. The token AFTER
			// the argument anchors that argument's own TYPE refusal, exactly as `parsePayloadArgs` does.
			let valueStart = self.pos
			self.stateDeclaredLiteralTarget(self.signatures.payloadTypeOf(try payloads.get(slotValues.count()) otherwise panic("parseEnumFromNameCase: payloads.get OOB at {slotValues.count()} — the loop runs once per declared payload"), layout: layout, into: self.artifact.typeNames), scopeFilePath: layout.declFilePath, valueStart: valueStart)
			let value = try self.parseValueExpression(func)
			slotValues.push(self.holdStorageReadForStatement(value, kind: HoldKind.listOperand, range: SourceRange.ofToken(nameTok), position: OperandSuccession.beforeComma))
			slotBareLocal.push(self.rhsWasBareLocalReference(valueStart))
			slotAnchors.push(self.pos)
		end 'eachSlot'

		try self.requireNoFurtherPayloadArgs(caseName, expected: arity, memberTok: memberTok)
		try self.consume(TokenKind.rightParen)

		// Validate + classify every slot before emitting anything permanent — `emitEnumBox`'s discipline, for
		// its reason: a refused payload leaves no code behind.
		let classes = PayloadClassArray.create(arity, zeroed: false)

		for i in 0 upto arity 'validate'
			let field = try payloads.get(i) otherwise panic("parseEnumFromNameCase: payloadsAt returned fewer fields than its own count at {i}")
			let declared = self.signatures.payloadTypeOf(field, layout: layout, into: self.artifact.typeNames)
			let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: declared, slotScopeFilePath: layout.declFilePath)
			let arg = try slotValues.get(i) otherwise panic("parseEnumFromNameCase: slotValues.get OOB at {i} — the columns are filled one per declared slot")
			let anchorIndex = try slotAnchors.get(i) otherwise panic("parseEnumFromNameCase: slotAnchors.get OOB at {i} — captured in lockstep with the values")
			try slotValues.set(i, value: try self.requirePayloadArgType(field, declared: declared, declaredWithAlias: self.typeKeepingAlias(field.declaredType, collapsed: declared, scopeFilePath: layout.declFilePath), class: class, value: arg, caseTok: memberTok, argTok: self.tokenAt(anchorIndex), voice: SlotMismatchVoice.payloadArgument, layout: layout)) otherwise panic("parseEnumFromNameCase: slotValues.set OOB at {i} — the columns are filled one per declared slot")
			classes.push(class)
		end 'validate'

		let result = self.mintValue(ValueTypeTag.named, nameId: self.artifact.typeNames.intern(layout.name))

		let args = ValueIdArray.create(arity + 1, zeroed: false)
		args.push(self.emitStringLiteral(caseName, range: SourceRange.ofToken(nameTok)))

		for i in 0 upto arity 'moveIn'
			let class = try classes.get(i) otherwise panic("parseEnumFromNameCase: classes.get OOB at {i} — filled in lockstep with the fields")
			let arg = try slotValues.get(i) otherwise panic("parseEnumFromNameCase: slotValues.get OOB at {i} after the validation pass")
			let bareLocal = try slotBareLocal.get(i) otherwise panic("parseEnumFromNameCase: slotBareLocal.get OOB at {i} — captured in lockstep with the values")
			let moved = try self.moveInPayload(class, arg: arg, argBareLocal: bareLocal, owner: result, anchor: memberTok, range: range)

			// The helper's parameters are all i64, so a float crosses as its bits; `emitEnumBox` needs no
			// bitcast because its store is typed at the slot's float width.
			if tagIsFloat(maxonTypeTag(payloadStorageOf(class))) 'aFloatSlotTravelsAsItsBits'
				args.push(self.emitUnaryOp(moved, op: MaxonUnaryOp.floatToBits, resultTag: ValueTypeTag.integer, range: range))
			end 'aFloatSlotTravelsAsItsBits' else 'aWord'
				args.push(moved)
			end 'aWord'
		end 'moveIn'

		return self.trackEnumFromNameResult(layout, result: self.emitRuntimeCallInto(result, callee: enumFromNameCaseSymbol(layout.name, caseName: caseName), args: args, range: range, argLabels: emptyArgLabels(args)))
	end 'parseEnumFromNameCase'

	// A literal name has consumed its argument; anything but the closing `)` is a payload list the
	// case does not declare that many slots for. ONE refusal for both directions — see
	// `enumFromNamePayloadArity` for why over-supply is E3036 rather than a parse error.
	function requireNoFurtherPayloadArgs(caseName ByteArray, expected PayloadSlotIndex, memberTok Token) throws SourceParseError
		if not self.at(TokenKind.comma) 'nothingFurther'
			return
		end 'nothingFurther'

		throw SourceParseError.enumFromNamePayloadArity(String.from(caseName), expected: expected, line: memberTok.line, column: memberTok.column)
	end 'requireNoFurtherPayloadArgs'

	// Emit the GENERAL lookup call and give its result the type and the ownership the declaration says it
	// has. Its per-case sibling reaches the same two facts through `emitRuntimeCallInto` and
	// `trackEnumFromNameResult`, because it must mint the result before its arguments — which is exactly why
	// the OWNERSHIP half is a function of its own rather than a line in this one.
	function emitEnumFromNameCall(layout EnumLayout, args ValueIdArray, range SourceRange) returns ValueId
		return self.trackEnumFromNameResult(layout, result: self.emitRuntimeCall(enumFromNameSymbol(layout.name), args: args, resultTag: ValueTypeTag.named, resultNameId: self.artifact.typeNames.intern(layout.name), range: range))
	end 'emitEnumFromNameCall'

	// ⭐ **A BOXED UNION'S LOOKUP HANDS BACK AN OWNED HEAP RECORD; A PAYLOAD-FREE DECLARATION'S HANDS
	// BACK A BARE TAG.** The helper allocates the box (`EnumLookupRuntime.emitBoxWithTag`), so the
	// result owes a drop exactly as a written `Container.empty` does — enrolled through the same door
	// that construct uses, which is what makes the statement-end drop and the binding's ownership one
	// rule rather than two. A word union's helper allocates nothing and is enrolled the same way, so
	// the one rule covers it too.
	function trackEnumFromNameResult(layout EnumLayout, result ValueId) returns ValueId
		if layout.carriesPayloads() 'ownsARecord'
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.sole)
		end 'ownsARecord'

		return result
	end 'trackEnumFromNameResult'

	// ⭐⭐ **MATERIALIZE `<Enum>.allCaseNames` — an OWNED `Array with String` of the case names, in
	// declaration order.** It builds exactly what the source literal `["red", "green", "blue"]` builds, op
	// for op: one `__managed_create` over the `Array with String` instance, then one promoted String per case
	// pushed into it. That is the whole design decision — the member is a VALUE of a type the language
	// already has, so it needs no representation, no accessor protocol and no runtime helper of its own, and
	// `.count()` / `.get(0)` / `for name in …` reach it through the postfix loop like any other array.
	//
	// ⭐ **A UNION IS THE SAME QUESTION.** `caseNames` is one column whatever the declaration's keyword or a
	// case's payload arity, so `Container.value(n Integer)` contributes `"value"` and nothing else — which is
	// exactly what `/specs/enum-allcasenames.md` requires of a union with associated values.
	//
	// ⚠ **THE INSTANCE IS READ BACK, NEVER FIRST INTERNED HERE.** The sweep interns `Array with String` for
	// any file naming the member (`AllCaseNamesProducerBit`), so a parse-time intern would be the first write
	// to a shared registry mid-parse and the gid would depend on parse order —
	// `atContainerFromConstruction`'s stated discipline, and the reason the probe walks whole files
	// rather than the declaration loop.
	//
	// ⚠ Each name is emitted as an IMMORTAL rdata String and then PROMOTED to an owned record by the shared
	// move-in door, because the array's `element_destroy@40` stamp releases every live slot: a borrowed
	// literal handed straight in would be released by an owner it never gave a reference to. `argBareLocal`
	// is `false` and cannot be otherwise — the value was minted two lines up and names no binding to poison.
	function emitEnumAllCaseNames(layout EnumLayout, range SourceRange) returns ValueId throws SourceParseError
		let giid = self.signatures.builtinInstanceForElement(self.signatures.arrayRecordBaseName(), element: MaxonType.string)
		let arr = try self.emitArrayCreateOp(giid, range: range, sizing: ValueIdArray.create(0))

		for i in 0 upto layout.caseCount() 'eachCase'
			let literal = self.emitStringLiteral(layout.caseNameAt(i), range: range)
			let owned = try self.moveManagedValueInto(literal, argBareLocal: false, isString: true, range: range)
			self.emitArrayPush(arr, element: owned, range: range)
		end 'eachCase'

		self.trackOwnedTemp(arr, exclusivity: OwnedHeapExclusivity.sole)
		return arr
	end 'emitEnumAllCaseNames'

	// ⭐ **CONSTRUCT A BOXED UNION VALUE** — `Move.walk(Direction.east)`, `LexErr.pair(7, column: 13)`,
	// or a payload-free case of a boxed union (`Container.empty`). Parses the payload argument list into
	// LAYOUT-parallel slot columns (`parsePayloadArgs`), checks every declared slot was filled
	// (`requireAllPayloadsProvided`), and hands off to `emitEnumBox`, which validates each field's TYPE
	// before it emits a single op.
	//
	// ⭐ **THE PAYLOAD ARGUMENT LIST FOLLOWS THE CALL-ARG RULE FOR A LIST WITH NO DEFAULTS** — the
	// first argument is positional, the second and later are named (`ArgLabelRule.ordinary`) —
	// crossed with the struct literal's slot-by-name: a named argument lands in the slot whose payload
	// FIELD its label names, whatever position it was written in. A case's payload is ordered by its
	// declaration, so the first argument needs no name to find its place; the rest do, exactly as a
	// call's arguments do. This is where the two syntaxes meet, and it is why `slotBareLocal` is
	// captured per SLOT and not per source position — `emitEnumBox`/`moveInPayload` reads
	// `argsBareLocal[i]` for the field at slot `i`, so a reordering named argument must poison the
	// right source (get it wrong and a managed payload's move-in poisons a use-after-move or leaks).
	function parseEnumBoxConstruct(func IrFunction, layout EnumLayout, caseIndex CaseIndex, caseTok Token, range SourceRange) returns ValueId throws SourceParseError
		let payloads = layout.payloadsAt(caseIndex)
		let arity = layout.payloadArityAt(caseIndex)

		// LAYOUT-parallel columns, the union twin of `parseStructLiteral`'s field columns: `slotValues[i]`
		// is the value for the payload field the case declares at slot `i`, whatever position/label the
		// construct wrote it in; `filled[i]` turns an unwritten slot into a missing-argument error rather
		// than a zero nobody chose; `slotBareLocal[i]` records whether slot `i`'s value was a bare reference
		// to a local binding — what a managed payload's move-in poisons (`moveInPayload`); `slotAnchors[i]`
		// is the token the slot's TYPE refusal is anchored at, which the type check (in `emitEnumBox`, after
		// the whole list is read) can no longer see for itself — see `parsePayloadArgs`.
		let slotValues = ValueIdArray.create(arity)
		let filled = FixedBoolArray.create(arity)
		let slotBareLocal = BoolArray.create(arity)
		let slotAnchors = TokenIndexArray.create(arity, zeroed: false)

		for _ in 0 upto arity 'initSlots'
			slotAnchors.push(self.pos)
		end 'initSlots'

		if self.at(TokenKind.leftParen) 'withArgs'
			try self.parsePayloadArgs(func, layout: layout, payloads: payloads, slotValues: slotValues, filled: filled, slotBareLocal: slotBareLocal, slotAnchors: slotAnchors, caseTok: caseTok)
		end 'withArgs'

		try self.requireAllPayloadsProvided(layout, payloads: payloads, filled: filled, caseTok: caseTok)

		let boxed = (try self.emitEnumBox(layout, caseIndex: caseIndex, args: slotValues, argsBareLocal: slotBareLocal, argAnchors: slotAnchors, caseTok: caseTok, range: range, fill: PayloadFill.unionConstruct)).0
		self.markFreshWhenInputsClean(boxed, inputs: slotValues)

		return boxed
	end 'parseEnumBoxConstruct'

	// Parse the `(pos, label: value, …)` payload argument list into the layout-parallel columns. The caller
	// has confirmed the `(`; this consumes it through the closing `)`. The FIRST argument is positional and
	// fills slot 0; every later argument is named and slots by the payload FIELD name it labels
	// (`payloadSlotFor`). A slot written twice is a duplicate, mirroring `parseStructLiteralFields` — a
	// payload field IS a field, so the same struct-literal diagnostics fit.
	//
	// ⭐ **IT ALSO RECORDS EACH SLOT'S DIAGNOSTIC ANCHOR, AND ONLY THIS FUNCTION CAN.** A payload argument's
	// TYPE is judged in `emitEnumBox`, once the whole list is read, and by then the cursor is past the
	// construct — so the position the two canonical specs pin (`,` or `)`, the token FOLLOWING the argument)
	// is not recoverable there. It is captured here, at the one moment it is `self.pos`, and by SLOT rather
	// than by source position for `slotBareLocal`'s stated reason: a named argument may fill a slot the
	// author wrote out of order, and an anchor paired with the wrong slot points at another argument.
	function parsePayloadArgs(func IrFunction, layout EnumLayout, payloads PayloadFieldArray, slotValues ValueIdArray, filled FixedBoolArray, slotBareLocal BoolArray, slotAnchors TokenIndexArray, caseTok Token) throws SourceParseError
		try self.consume(TokenKind.leftParen)

		// A case that declares NO payload takes no argument LIST — it is written `U.empty`, never
		// `U.empty()` or `U.empty(x)`. Rejected before any argument is parsed, because the columns are
		// empty and every slot lookup below would be out of bounds. A payload-free case with no parens
		// skips this function entirely and constructs a bare-tag box.
		if payloads.count() == 0 'noPayload'
			throw SourceParseError.unsupported("a payload argument list on case '{String.from(caseTok.value)}' of `{layout.kindWord()} {String.from(layout.name)}`, which declares no payload for that case", line: caseTok.line, column: caseTok.column)
		end 'noPayload'

		var argIndex = 0 as ParamCount

		while true 'argLoop'
			// The label token anchors an unknown/duplicate-label diagnostic; captured before `consumeArgLabel`
			// consumes it, exactly as `parseCallArgs` captures `argFirstTok`.
			let labelTok = self.current()
			let label = try self.consumeArgLabel(argIndex, rule: ArgLabelRule.ordinary)
			let slot = try self.payloadSlotFor(layout, payloads: payloads, argIndex: argIndex, label: label, labelTok: labelTok, caseTok: caseTok)

			let alreadyFilled = try filled.get(slot) otherwise panic("parsePayloadArgs: filled.get OOB at slot {slot} — the columns are sized to the case's arity and payloadSlotFor returns an in-range slot")

			if alreadyFilled 'duplicate'
				throw SourceParseError.duplicateFieldInitializer(String.from(layout.name), fieldName: String.from(label), line: labelTok.line, column: labelTok.column)
			end 'duplicate'

			// `parseValueExpression` (the climber plus a trailing ternary), not `parseExpression`, for
			// `parseStructLiteralFields`' reason: an argument is parsed INSIDE an expression that already
			// seeded `currentBlock`. The value's start position is
			// captured first so `rhsWasBareLocalReference` can decide, after the value is parsed, whether it
			// was a bare local — a managed payload's move-in poisons that source.
			let valueStart = self.pos
			let payloadField = try payloads.get(slot) otherwise panic("parsePayloadArgs: payloads.get OOB at slot {slot} — the columns are sized to the case's arity")
			self.stateDeclaredLiteralTarget(self.signatures.payloadTypeOf(payloadField, layout: layout, into: self.artifact.typeNames), scopeFilePath: layout.declFilePath, valueStart: valueStart)
			let value = try self.parseValueExpression(func)

			try self.admitStore(func, slot: payloadField.capability, value: value, valueStart: valueStart, place: payloadPlaceText(layout, field: payloadField, caseTok: caseTok), holder: StoreHolder.unheld)

			// ⭐ **THE TOKEN AFTER THE ARGUMENT — READ ONCE, AND BOTH REFUSALS ABOUT THIS ARGUMENT TAKE IT.** The
			// escaping-closure reject is positioned there (matching its `maxoncstderr` block) and so is the
			// TYPE refusal (`emitEnumBox`, through `slotAnchors`). Taking `self.current()` for one and
			// `self.pos` for the other five lines apart made that agreement a coincidence of two reads of a
			// cursor nothing pins between them; one binding makes it structural.
			let afterArg = self.pos

			try slotValues.set(slot, value: self.holdStorageReadForStatement(value, kind: HoldKind.listOperand, range: SourceRange.ofToken(labelTok), position: OperandSuccession.beforeComma)) otherwise panic("parsePayloadArgs: slotValues.set OOB at slot {slot} — the columns are sized to the case's arity")
			try filled.set(slot, value: true) otherwise panic("parsePayloadArgs: filled.set OOB at slot {slot} — the columns are sized to the case's arity")
			try slotBareLocal.set(slot, value: self.rhsWasBareLocalReference(valueStart)) otherwise panic("parsePayloadArgs: slotBareLocal.set OOB at slot {slot} — the columns are sized to the case's arity")
			try slotAnchors.set(slot, value: afterArg) otherwise panic("parsePayloadArgs: slotAnchors.set OOB at slot {slot} — the columns are sized to the case's arity")

			argIndex = argIndex + 1

			if not self.at(TokenKind.comma) 'endArgs'
				break
			end 'endArgs'

			try self.consume(TokenKind.comma)
		end 'argLoop'

		try self.consume(TokenKind.rightParen)
	end 'parsePayloadArgs'

	// The layout SLOT a payload argument fills. Argument 0 is positional (`consumeArgLabel` guaranteed it
	// carries no label) and fills slot 0 in declaration order — the payload twin of a call's first argument
	// filling parameter 0. A later argument is named and slots by the payload FIELD name it labels; a label
	// naming no field of this case is an unknown-field error, mirroring `requireFieldIndex`. Slot 0 is in
	// range because a payload-free case never reaches the argument loop (`parsePayloadArgs` rejects its
	// parens before any lookup).
	function payloadSlotFor(layout EnumLayout, payloads PayloadFieldArray, argIndex ParamCount, label ByteArray, labelTok Token, caseTok Token) returns PayloadSlotIndex throws SourceParseError
		if argIndex == 0 'positional'
			return 0
		end 'positional'

		for i in 0 upto payloads.count() 'each'
			let field = try payloads.get(i) otherwise panic("payloadSlotFor: payloadsAt returned fewer fields than its own count at {i}")

			if field.name.equals(label) 'match'
				return i
			end 'match'
		end 'each'

		throw SourceParseError.unknownPayloadName(String.from(layout.name), caseName: String.from(caseTok.value), payloadName: String.from(label), line: labelTok.line, column: labelTok.column)
	end 'payloadSlotFor'

	// Every declared payload slot must have been given a value. A union payload has NO defaults (unlike a
	// struct field, so there is no `applyFieldDefaults` step here), which makes an omitted slot always an
	// error — reported at the FIRST unfilled slot in declaration order, mirroring `requireAllFieldsInitialized`,
	// so the message is a function of the case rather than of a hash walk. Anchored at the case name.
	function requireAllPayloadsProvided(layout EnumLayout, payloads PayloadFieldArray, filled FixedBoolArray, caseTok Token) throws SourceParseError
		for i in 0 upto payloads.count() 'each'
			let wasFilled = try filled.get(i) otherwise panic("requireAllPayloadsProvided: filled.get OOB at {i} — the column is sized to the case's arity")

			if wasFilled 'given'
				continue
			end 'given'

			let field = try payloads.get(i) otherwise panic("requireAllPayloadsProvided: payloadsAt returned fewer fields than its own count at {i}")
			throw SourceParseError.fieldNotInitialized(String.from(layout.name), fieldName: String.from(field.name), line: caseTok.line, column: caseTok.column)
		end 'each'
	end 'requireAllPayloadsProvided'

	// Emit the record: validate + classify every payload field (type-check each argument) BEFORE any
	// op, then open the record — a construct `__mm_alloc`s a box of `8 + maxArity*8` bytes, a service
	// message takes its green thread's staging buffer (`__cown_staging`) — store the case TAG at
	// offset 0, store each payload at `8 + slot*8`, and, for a construct, ZERO-FILL the unused slots
	// `[arity, maxArity)`.
	//
	// ⭐ A construct's box is TAGGED `named(<union>)` — the same tag a scalar enum value carries, so
	// `match` recognizes it through the one `enumMatchFor` door — and enrolled as an OWNED HEAP
	// TEMPORARY (`trackOwnedTemp`), so `parseBinding` binds its drop to scope exit and an unbound
	// `Move.walk(5)` statement is freed at statement end.
	//
	// ⭐ **A MANAGED PAYLOAD IS MOVED IN** (`moveInPayload`) — no incref, no copy of an owned value.
	// The record owns the payload after the store; the source binding is poisoned (E3102) and an owned
	// temporary is removed from the statement's pending drops. A wholly-scalar union keeps the trivial
	// destructor; a managed one drops through `__destruct_<U>` (see
	// `emitDecref`/`synthesizeUnionDestructor`).
	//
	// ⚠ **A CONSTRUCT'S ZERO-FILL IS MANDATORY** even though the slab returns zeroed memory: it pins a
	// deterministic 0 in a narrow case's unused slots, and a NULL slot is exactly what the cascade's
	// null-guard skips — so a zeroed managed slot is never decref'd as a bogus pointer.
	function emitEnumBox(layout EnumLayout, caseIndex CaseIndex, args ValueIdArray, argsBareLocal BoolArray, argAnchors TokenIndexArray, caseTok Token, range SourceRange, fill PayloadFill) returns (ValueId, SharedSlotHandBackArray) throws SourceParseError
		let payloads = layout.payloadsAt(caseIndex)

		// Validate + classify every field before emitting a single op — a refused payload emits no code.
		let classes = PayloadClassArray.create(payloads.count(), zeroed: false)

		for i in 0 upto payloads.count() 'validate'
			let field = try payloads.get(i) otherwise panic("emitEnumBox: payloadsAt returned fewer fields than its own count at {i}")
			let declared = self.signatures.payloadTypeOf(field, layout: layout, into: self.artifact.typeNames)
			let class = classifyUnionPayload(self.signatures, typeNames: self.artifact.typeNames, fieldType: declared, slotScopeFilePath: layout.declFilePath)
			classes.push(class)

			// ⛔⛔ **THE `__reply` SLOT'S ARGUMENT IS NOT TYPE-CHECKED, AND THAT IS LOAD-BEARING.** Nor is
			// a witness half's, which no source argument fills (`ServiceCompanions.serviceWitnessHalfSlotName`).
			// Its field is declared `MaxonType.integer` deliberately (a raw cell pointer the destructor
			// cascade must not follow) while `mintServiceReplyCell` mints the value at
			// `Promise with (T, E)` — so this check would earn an **E3005 on every reply-bearing send in the
			// suite**, blaming the author for an argument they did not write and the compiler minted. Both
			// sides of this slot are the compiler's, which is what makes skipping it honest rather than a
			// hole. `moveMessagePayloads` skips the same slot for its own reason, through the same predicate.
			if fieldIsTheServiceReplySlot(field) or fieldIsAServiceWitnessHalf(field) 'theCompilersOwnSlot'
				continue
			end 'theCompilersOwnSlot'

			let arg = try args.get(i) otherwise panic("emitEnumBox: args.count() was checked to equal the arity but get OOB at {i}")
			let anchorIndex = try argAnchors.get(i) otherwise panic("emitEnumBox: argAnchors.get OOB at {i} — captured in lockstep with the args")
			let declaredWithAlias = self.typeKeepingAlias(field.declaredType, collapsed: declared, scopeFilePath: layout.declFilePath)
			let checked = try self.requirePayloadArgType(field, declared: declared, declaredWithAlias: declaredWithAlias, class: class, value: arg, caseTok: caseTok, argTok: self.tokenAt(anchorIndex), voice: payloadFillVoice(fill), layout: layout)
			try args.set(i, value: checked) otherwise panic("emitEnumBox: args.set OOB at {i} — args.count() was checked to equal the arity")

			match fill 'fill'
				unionConstruct then self.recordPayloadRangeCheck(checked, class: class, declared: declaredWithAlias, layout: layout, anchor: self.tokenAt(anchorIndex))
				serviceMessage then break
			end 'fill'
		end 'validate'

		let handBack = try self.transferPayloadsIntoAGreenThread(fill, args: args, payloads: payloads, argAnchors: argAnchors, caseTok: caseTok)

		if payloadFillBuildsAConstruct(fill) and self.signatures.unionRepresentation(layout) == UnionRepresentation.word 'aWordUnion'
			return (try self.emitUnboxedUnionWordConstruct(layout, fill: fill, caseIndex: caseIndex, classes: classes, args: args, argsBareLocal: argsBareLocal, caseTok: caseTok, range: range), handBack)
		end 'aWordUnion'

		let box = self.openPayloadRecord(layout, fill: fill, range: range)

		self.emitUnionTagStore(box, tag: layout.tagOfIndex(caseIndex), range: range)

		for i in 0 upto payloads.count() 'storeEach'
			let field = try payloads.get(i) otherwise panic("emitEnumBox: payloads.get OOB at {i} on a list walked to its own count")

			if fieldIsAServiceWitnessHalf(field) 'storedWithItsValue'
				continue
			end 'storedWithItsValue'

			let class = try classes.get(i) otherwise panic("emitEnumBox: classes.get OOB at {i} — it is filled in lockstep with the fields")
			let stored = try self.storedPayloadAt(fill, index: i, class: class, args: args, argsBareLocal: argsBareLocal, holder: PayloadHolder.record(box), caseTok: caseTok, range: range)
			self.emitIndirectStore(box, offset: layout.payloadSlotOffset(i as PayloadSlotIndex), value: stored, storageType: payloadStorageOf(class), range: range)

			if payloadClassIsExistential(class) 'andItsWitnessHalf'
				let declared = self.signatures.payloadTypeOf(field, layout: layout, into: self.artifact.typeNames)
				self.emitIndirectStore(box, offset: layout.payloadSlotOffset(i as PayloadSlotIndex) + InterfaceWitnessHalfOffset, value: self.widenedWitnessOf(stored, interfaceName: interfaceNameOfType(declared, typeNames: self.artifact.typeNames), range: range), storageType: MaxonType.integer, range: range)
			end 'andItsWitnessHalf'
		end 'storeEach'

		// The fill keeps a box's bytes deterministic whatever the allocator returns; the union cloner
		// blits the whole box (`MmRuntime.synthesizeUnionCloner`), so it copies these slots too. A
		// message skips it: it is read only through its live variant (the loop's arm), so the words an
		// earlier message left in the staging buffer are never followed.
		match fill 'zeroFillOwnership'
			unionConstruct then self.zeroFillUnusedPayloadSlotsAndNoteTheCase(box, layout: layout, payloadCount: payloads.count(), caseTok: caseTok, range: range)
			serviceMessage then break
		end 'zeroFillOwnership'

		return (box, handBack)
	end 'emitEnumBox'

	function emitUnboxedUnionWordConstruct(layout EnumLayout, fill PayloadFill, caseIndex CaseIndex, classes PayloadClassArray, args ValueIdArray, argsBareLocal BoolArray, caseTok Token, range SourceRange) returns ValueId throws SourceParseError
		if layout.payloadArityAt(caseIndex) == 0 'payloadFree'
			return self.emitUnboxedPayloadFreeWord(layout, caseIndex: caseIndex, range: range)
		end 'payloadFree'

		let class = try classes.get(0) otherwise panic("emitUnboxedUnionWordConstruct: classes.get(0) OOB on a case with one payload")
		let stored = try self.storedPayloadAt(fill, index: 0, class: class, args: args, argsBareLocal: argsBareLocal, holder: PayloadHolder.word, caseTok: caseTok, range: range)
		let word = self.emitMachineWordBinOp(stored, rhs: self.emitLiteral(layout.wordKeyOfIndex(caseIndex), valueType: MaxonType.integer, range: range), op: MaxonBinOp.bitOr, resultType: MaxonType.named(self.artifact.typeNames.intern(layout.name)), range: range)
		self.trackOwnedTemp(word, exclusivity: OwnedHeapExclusivity.sole)
		return word
	end 'emitUnboxedUnionWordConstruct'

	function payloadFillBuildsAConstruct(fill PayloadFill) returns bool
		return match fill 'fill'
			unionConstruct gives true
			serviceMessage gives false
		end 'fill'
	end 'payloadFillBuildsAConstruct'

	function openPayloadRecord(layout EnumLayout, fill PayloadFill, range SourceRange) returns ValueId
		match fill 'destination'
			unionConstruct then return self.allocatedUnionBox(layout, range: range)
			serviceMessage then return self.emitRuntimeCall(CownStagingName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
		end 'destination'
	end 'openPayloadRecord'

	function allocatedUnionBox(layout EnumLayout, range SourceRange) returns ValueId
		let size = self.emitLiteral(layout.boxSizeBytes() as FullRangeInt, valueType: MaxonType.integer, range: range)
		let box = self.emitBoxAlloc(size, resultTag: ValueTypeTag.named, resultNameId: self.artifact.typeNames.intern(layout.name), range: range)
		self.trackOwnedTemp(box, exclusivity: OwnedHeapExclusivity.sole)
		return box
	end 'allocatedUnionBox'

	function zeroFillUnusedPayloadSlotsAndNoteTheCase(box ValueId, layout EnumLayout, payloadCount ElementIndex, caseTok Token, range SourceRange)
		self.zeroFillUnusedPayloadSlots(box, layout: layout, firstUnused: payloadCount as PayloadSlotIndex, range: range)

		if payloadCount == 0 'aPayloadFreeCase'
			self.noteUnionCaseImage(box, typeName: layout.name, caseName: caseTok.value)
		end 'aPayloadFreeCase'
	end 'zeroFillUnusedPayloadSlotsAndNoteTheCase'

	function zeroFillUnusedPayloadSlots(box ValueId, layout EnumLayout, firstUnused PayloadSlotIndex, range SourceRange)
		for j in firstUnused upto layout.maxPayloadArity() 'zeroFill'
			let zero = self.emitLiteral(0, valueType: MaxonType.integer, range: range)
			self.emitIndirectStore(box, offset: layout.payloadSlotOffset(j), value: zero, storageType: MaxonType.integer, range: range)
		end 'zeroFill'
	end 'zeroFillUnusedPayloadSlots'

	function recordPayloadRangeCheck(value ValueId, class PayloadClass, declared MaxonType, layout EnumLayout, anchor Token)
		match class 'c'
			scalar then break
			managed or
			nestedUnion or
			greenThread or
			undeclaredName or
			existential or
			typeParam then return
		end 'c'

		if typeNameIdOf(declared) == UnnamedTypeId 'namesNoAlias'
			return
		end 'namesNoAlias'

		let alias = try self.signatures.rangeCheckedAliasNamed(self.internedName(typeNameIdOf(declared)), readerFilePath: layout.declFilePath) otherwise return
		self.recordRangedTargetSite(value, target: alias, line: anchor.line, column: anchor.column)
	end 'recordPayloadRangeCheck'

	// ⭐⭐ **MOVE EVERY MANAGED PAYLOAD OF A MESSAGE TO THE SERVICE — or refuse.** The
	// send's half of `emitEnumBox`'s two-fill split; a `unionConstruct` fill returns at the first line and the
	// whole step is inert for every union in every program that spawns nothing.
	//
	// It REWRITES `args` in place, exactly as `transferConsumedArgs` rewrites a call's, and for the identical
	// reason: a borrowed byte record is PROMOTED, so what crosses is a different record than what was parsed
	// and the store below must carry the copy rather than the borrow.
	function transferPayloadsIntoAGreenThread(fill PayloadFill, args ValueIdArray, payloads PayloadFieldArray, argAnchors TokenIndexArray, caseTok Token) returns SharedSlotHandBackArray throws SourceParseError
		match fill 'fill'
			unionConstruct then return SharedSlotHandBackArray.create(0)
			serviceMessage(serviceTypeName) then return try self.moveMessagePayloads(serviceTypeName, args: args, payloads: payloads, argAnchors: argAnchors, caseTok: caseTok)
		end 'fill'
	end 'transferPayloadsIntoAGreenThread'

	// The loop, split from the `match` above so the arm stays one statement. Every payload the AUTHOR wrote
	// goes through the ONE message door, `handOffArguments`.
	//
	// ⛔⛔ **THE `__reply` SLOT IS SKIPPED, AND THAT IS LOAD-BEARING RATHER THAN A SAVING.** A send mints a
	// real cell there, and `handOffTakeOf`'s FIRST question is `valueIsPromise`, asked deliberately
	// ahead of the scalar short-circuit — so passing the slot through earns **a refusal naming `__reply` as the
	// author's own argument** on every reply-bearing send in the suite.
	//
	// ⭐ **AND THE REFUSAL WOULD BE WRONG ON ITS OWN TERMS, NOT MERELY MISPLACED.** That rule is about a
	// REFERENCE-COUNTED box reaching two green threads. A cell is not
	// refcounted: it is the two-party TEARDOWN RENDEZVOUS itself (`GtRuntime.GtOffTeardown`), whose whole
	// design is that the sender and the service each hold it and each arrive at it exactly once. Handing it
	// over IS the mechanism the rule exists to protect.
	function moveMessagePayloads(serviceTypeName ByteArray, args ValueIdArray, payloads PayloadFieldArray, argAnchors TokenIndexArray, caseTok Token) returns SharedSlotHandBackArray throws SourceParseError
		let authored = HandedOffArgumentArray.create(0)

		for i in 0 upto payloads.count() 'eachAuthored'
			let field = try payloads.get(i) otherwise panic("moveMessagePayloads: payloads.get OOB at {i} — the loop is bounded by that same count")

			if not fieldIsTheServiceReplySlot(field) and not fieldIsAServiceWitnessHalf(field) 'theAuthorsArgument'
				let argValue = try args.get(i) otherwise panic("moveMessagePayloads: args.get OOB at {i} — the caller sized the columns to the variant's payload count")
				let argIndex = try argAnchors.get(i) otherwise panic("moveMessagePayloads: argAnchors.get OOB at {i} — filled in lockstep with the args")
				let argTok = self.tokenAt(argIndex)

				authored.push(HandedOffArgument.create(i, value: argValue, anchor: argTok, door: ThreadHandOffDoor.message(serviceSendArgumentBlame(serviceTypeName, methodName: caseTok.value, paramName: field.name), argumentOf: serviceSendArgumentOf(serviceTypeName, methodName: caseTok.value))))
			end 'theAuthorsArgument'
		end 'eachAuthored'

		let plans = try self.handOffArguments(authored, args: args)
		let handBack = SharedSlotHandBackArray.create(payloads.count(), zeroed: false)

		for _ in 0 upto payloads.count() 'eachSlot'
			handBack.push(SharedSlotHandBack.moved)
		end 'eachSlot'

		for plan in plans 'eachPlan'
			match plan.take 'take'
				sharedReadOnly then try handBack.set(plan.argument.position, value: self.sharedSlotHandBack(plan.argument)) otherwise panic("moveMessagePayloads: handBack.set OOB at {plan.argument.position} — the column is sized to the variant's payload count and the position came from that list")

				copied or
				cellOccupant or
				movedOut or
				promiseMovedIn or
				promotedLiteral or
				aReferenceOfItsOwn or
				aLentReference or
				aCopyOfItsOwn or
				anOpaqueReference then continue
			end 'take'
		end 'eachPlan'

		return handBack
	end 'moveMessagePayloads'

	function valueHasACapability(value ValueId) returns bool
		return self.valueIsNonTextAggregate(value) or self.tagOf(value) == ValueTypeTag.typeParameter
	end 'valueHasACapability'

	function sharedSlotHandBack(argument HandedOffArgument) returns SharedSlotHandBack
		let valueType = self.typeOf(argument.value)

		if self.typeCannotBeCloned(valueType) 'handedBackAsItIs'
			return SharedSlotHandBack.moved
		end 'handedBackAsItIs'

		let clone = managedFieldCascadeStrategy(self.signatures, typeNames: self.artifact.typeNames, fieldType: valueType, asElement: false, action: CascadeAction.clone)
		return SharedSlotHandBack.copied(clone, release: DropExistentialName if maxonTypeTag(valueType) == ValueTypeTag.interfaceRef else managedFieldDropCallee(self.signatures, typeNames: self.artifact.typeNames, fieldType: valueType))
	end 'sharedSlotHandBack'

	function typeCannotBeCloned(valueType MaxonType) returns bool
		match managedFieldCascadeStrategy(self.signatures, typeNames: self.artifact.typeNames, fieldType: valueType, asElement: false, action: CascadeAction.clone) 'strategy'
			unsupported then return true
			direct or
			managedElements or
			throughWitness then break
		end 'strategy'

		let tag = maxonTypeTag(valueType)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.sourceCloneVerdictOfType(MaxonType.genericInstance(genericInstanceIdOf(valueType))) == SourceCloneVerdict.holdsAnUncloneable
		end 'anInstance'

		if not self.signatures.tagMayNameAggregate(tag) 'namesNoAggregate'
			return false
		end 'namesNoAggregate'

		return not self.signatures.aggregateSupportsDeepClone(self.signatures.denotedAggregateName(self.internedName(typeNameIdOf(valueType))))
	end 'typeCannotBeCloned'

	function sendErrorSlotIsCoOwnedByType(layout EnumLayout, slotType MaxonType) returns bool
		return self.signatures.isServiceSendError(layout.name) and self.typeCannotBeCloned(slotType)
	end 'sendErrorSlotIsCoOwnedByType'

	// A word has no record to own its payload, so `arg` stands in as the owner. That is sound only
	// because the owner is read solely for an opaque type-parameter payload (`markOpaqueSlotOwner`),
	// and `unionRepresentationOf` never makes a union with one a word.
	function storedPayloadAt(fill PayloadFill, index ElementIndex, class PayloadClass, args ValueIdArray, argsBareLocal BoolArray, holder PayloadHolder, caseTok Token, range SourceRange) returns ValueId throws SourceParseError
		let arg = try args.get(index) otherwise panic("storedPayloadAt: args.get OOB at {index} after the arity check")
		let bareLocal = try argsBareLocal.get(index) otherwise panic("storedPayloadAt: argsBareLocal.get OOB at {index} — captured in lockstep with the args")

		let owner = match holder 'holder'
			record(box) gives box
			word gives arg
		end 'holder'

		return try self.storedPayloadValue(fill, class: class, arg: arg, argBareLocal: bareLocal, owner: owner, caseTok: caseTok, range: range)
	end 'storedPayloadAt'

	// What actually lands in payload slot `i`, per fill. A CONSTRUCT moves in here, where its box or
	// word is built; a MESSAGE was transferred before the box did, so this frame has already given up
	// its reference and the store is the bare word.
	function storedPayloadValue(fill PayloadFill, class PayloadClass, arg ValueId, argBareLocal bool, owner ValueId, caseTok Token, range SourceRange) returns ValueId throws SourceParseError
		return match fill 'fill'
			unionConstruct gives try self.moveInPayload(class, arg: arg, argBareLocal: argBareLocal, owner: owner, anchor: caseTok, range: range)
			serviceMessage gives arg
		end 'fill'
	end 'storedPayloadValue'

	// ⭐ **MOVE A MANAGED VALUE INTO DURABLE STORAGE** — a union payload slot or a struct field, the
	// construct half of static single-owner ownership and the mirror of `parseBinding`'s move-on-bind. A
	// scalar is stored as-is. A managed value is stored so the box holds exactly ONE reference to it:
	//   • a BORROWED String literal/param is PROMOTED to an owned heap copy first (`promoteToOwnedString`),
	//     so the box owns a droppable payload — the copy is a fresh temp, removed from the pending list;
	//   • an already-OWNED value (an owned String, an interpolation temp, an owned struct/union box, a
	//     CONSUMED param — one the analysis enrolled as owned) is transferred: a bare-local reference is
	//     POISONED (E3102 on later use), an owned temporary is removed from the pending drops. No incref, no
	//     copy.
	//   • a BORROWED struct/union/existential value (a borrowed param, a borrowed field read, a non-consumed
	//     argument) has NO STATIC clone, so it is CO-OWNED instead — the box takes its own reference and the
	//     borrow's owner is untouched (`coOwnBorrowedForConsume`, the transitive-consume ruling of
	//     2026-08-04). (A String is the one managed kind with a promote, so a borrowed String takes a real
	//     copy rather than a second reference — and an EXISTENTIAL whose conformer IS a String takes that same
	//     copy at run time, through its witness, which is why `coOwnBorrowedForConsume` answers with a value
	//     rather than with the one it was handed.)
	//   • a slot declared at the enclosing generic's own TYPE PARAMETER takes its reference at RUN TIME
	//     (`moveOpaqueValueInto`) — the shared body cannot name the protocol, but the record it
	//     fills is concrete at the caller and its destructor drops the slot regardless.
	// `owner` is the RECORD the slot belongs to — passed so the one door that takes a descriptor-mediated
	// reference can record the release obligation ON THE RECORD, rather than a caller inferring "a reference
	// was taken" from the returned value differing (which the substituted-concrete arm also does).
	//
	// This is the MOVE: the box becomes the value's sole owner, the source is poisoned or de-listed, no
	// incref, and the box holds exactly one reference it releases through `__destruct_<U>`.
	function moveInPayload(class PayloadClass, arg ValueId, argBareLocal bool, owner ValueId, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		if payloadClassIsTypeParam(class) 'opaqueSlot'
			return try self.moveOpaqueValueInto(arg, argBareLocal: argBareLocal, slot: DurableOpaqueSlot.inRecord(owner), range: range)
		end 'opaqueSlot'

		// ⭐⭐ **A GREEN-THREAD PAYLOAD IS MOVED IN, AND IT IS NOT A MANAGED MOVE.** `moveManagedValueInto`
		// takes a reference (or poisons a source and takes its one); a promise has no reference to take, so
		// the move IS the consume — the word is stored as it stands and this frame stops naming the thread.
		//
		// ⛔ **WITHOUT IT THE PAYLOAD FALLS TO THE `scalar` RETURN AND THE SPAWN IS CANCELLED UNDER THE UNION.**
		// `Slot.held(async plain())` would leave the spawn a statement-scoped pending temporary of the
		// CONSTRUCTING frame, whose drain reclaims it at the end of that statement, and the payload would keep a
		// dead handle.
		match class 'promiseSlot'
			greenThread(storage) then return try self.storedPromiseValue(arg, storage: genericInstanceIdOf(storage), anchor: anchor, range: range)
			managed or
			scalar or
			nestedUnion or
			existential or
			undeclaredName or
			typeParam then break
		end 'promiseSlot'

		// ⭐ **A CONCRETE CONFORMER WIDENED INTO AN INTERFACE-TYPED SLOT MOVES IN BY ITS OWN TYPE'S PROTOCOL.** The
		// slot's class says only "existential", while an `int` conformer owns nothing and a `String` one is a byte
		// record whose borrowed literal cannot take a reference.
		if payloadClassIsExistential(class) and self.tagOf(arg) != ValueTypeTag.interfaceRef 'aConcreteConformer'
			return try self.moveConcreteValueInto(arg, argBareLocal: argBareLocal, range: range)
		end 'aConcreteConformer'

		if not payloadClassIsManaged(class) 'scalar'
			return arg
		end 'scalar'

		self.noteLentUniqueMoved(arg)
		let moved = try self.moveManagedValueInto(arg, argBareLocal: argBareLocal, isString: payloadClassIsString(class), range: range)
		return self.unsharedStoredByteRecord(moved, range: range)
	end 'moveInPayload'

	// A value whose own type is concrete, moved into durable storage by that type's protocol: nothing for a value
	// that owns no heap, a byte record's retain for a String or Character, and a reference for an aggregate.
	function moveConcreteValueInto(arg ValueId, argBareLocal bool, range SourceRange) returns ValueId throws SourceParseError
		if not self.valueIsManagedHeap(arg) 'ownsNoHeap'
			return arg
		end 'ownsNoHeap'

		self.noteLentUniqueMoved(arg)

		return try self.moveManagedValueInto(arg, argBareLocal: argBareLocal, isString: tagIsByteRecord(self.tagOf(arg)), range: range)
	end 'moveConcreteValueInto'

	// ⭐⭐ **MOVE A VALUE INTO A SLOT DECLARED AT THE ENCLOSING GENERIC'S OWN TYPE PARAMETER** —
	// `moveManagedValueInto`'s twin for the one slot kind whose protocol is not a compile-time fact.
	// The split it makes is the SAME split: an already-OWNED value is TRANSFERRED (a consumed feed
	// parameter moved into an opaque array — the caller already handed over its `+1`, so a reference
	// taken here would leak it), and a BORROWED one is CO-OWNED. Only the second arm is this twin's
	// own, and only it can be right: a body reading `items.get(i)` holds a borrow the array still
	// owns.
	//
	// ⚠ **A VALUE WHOSE TAG IS NO LONGER THE OPAQUE PARAMETER HAS BEEN SUBSTITUTED**, and then the static
	// protocol is both available and strictly better — a String COPIES rather than dispatching to `__str_clone`
	// through a load, and the two answers are the same answer. It is routed through the ordinary doors rather
	// than through the descriptor so that a body which knows the type never pays a run-time dispatch for it.
	function moveOpaqueValueInto(arg ValueId, argBareLocal bool, slot DurableOpaqueSlot, range SourceRange) returns ValueId throws SourceParseError
		if self.tagOf(arg) != ValueTypeTag.typeParameter 'substitutedToAConcreteType'
			return try self.moveConcreteValueInto(arg, argBareLocal: argBareLocal, range: range)
		end 'substitutedToAConcreteType'

		try self.requireCapturedOpaqueHoldsNoGreenThread(arg, range: range)

		if self.opaqueSlotTakesItsOwnReference(arg) 'referenceThroughTheDescriptor'
			// A RECORD slot makes the record the reference's owner, so it owes the release if IT is dropped here —
			// recorded at the one line that takes the reference, which is what makes the store half and the drop
			// half one act rather than two that agree. A CELL releases its occupant itself (`cellOwnsItsOccupant`).
			self.markOpaqueSlotOwner(slot)
			return self.coOwnBorrowedOpaque(arg, range: range)
		end 'referenceThroughTheDescriptor'

		// The slot INHERITS the reference this frame holds (`opaqueSlotTakesItsOwnReference` names the three
		// shapes and why each takes nothing). Only the OWNED one has bookkeeping left: this frame stops owing the
		// drop. The other two owe nothing here, because the reference the slot ends up holding was never this
		// frame's to give away.
		if self.valueIsOpaqueOwned(arg) 'thisFrameStopsOwningIt'
			self.transferOwnedInto(arg, argBareLocal: argBareLocal)

			// A held operand's reference is adopted by the slot, so the record owes its release as above: a
			// record dropped inside the shared generic body releases its `T` slot only through the descriptor.
			if self.holdKindOf(arg).has(HoldPolicy.adoptedByAnOpaqueSlot) and self.signatures.typeParamOwnerIsInstantiated(self.valueTypeParamId(arg)) 'aHeldReferenceIsAdopted'
				self.markOpaqueSlotOwner(slot)
			end 'aHeldReferenceIsAdopted'
		end 'thisFrameStopsOwningIt'

		return arg
	end 'moveOpaqueValueInto'

	function markOpaqueSlotOwner(slot DurableOpaqueSlot)
		match slot 'owner'
			inRecord(box) then self.markRecordOwningOpaqueSlots(box)
			inCell then break
		end 'owner'
	end 'markOpaqueSlotOwner'

	// ⭐⭐ **DOES AN OPAQUE `T` DESTINATION TAKE ITS OWN REFERENCE TO `value`, OR INHERIT THE ONE THIS FRAME
	// HOLDS? — THE one home of that routing question, because THREE doors ask it and a disagreement between them
	// is a double free rather than a diagnostic.** The STORE acts on the answer (`moveOpaqueValueInto`); the two
	// REPEAT guards read it to decide whether ONE value may fill TWO owning destinations in a single construct
	// (`rejectDoubleOwningStore` for `Self{a: v, b: v}`, `transferConsumedArgs` for `Pair.create(v, b: v)`, both
	// through `repeatedOwningDestinationWouldDoubleFree`). A destination that takes its OWN reference may be
	// repeated — N destinations take N references and each is released by its own owner; one that INHERITS may
	// not, because the single reference this frame holds cannot answer for two owners.
	//
	// ⛔⛔ **THREE SHAPES INHERIT, AND "IS IT OWNED" NAMES ONLY THE FIRST.** A constructor FEED
	// parameter this frame does not keep and a generic no `with` ever names both read as BORROWED to
	// the ownership bit while taking no reference at all, so a guard asking `valueIsOpaqueOwned` alone
	// would admit a repeat of either — two owners of one `+1`. Each arm below says why it takes
	// nothing; the consequence for a repeat is identical across all three.
	//
	// Precondition: `value` carries the opaque `typeParameter` tag. A SUBSTITUTED value is concrete and is
	// routed through the ordinary doors, which CO-OWN and may therefore always be repeated.
	function opaqueSlotTakesItsOwnReference(value ValueId) returns bool
		// Owned, yet it takes its own reference: the frame keeps one too (`coOwningFeedParams`). Asked
		// before the ownership bit, which would transfer it.
		if valueIsMarked(self.bodyState.coOwningFeedParams, value: value) 'aFeedThisFrameKeeps'
			return true
		end 'aFeedThisFrameKeeps'

		// Any other already-OWNED value is TRANSFERRED — a consumed feed parameter moved into an opaque
		// array. The caller already handed over its `+1`, so a reference taken here would leak it.
		if self.valueIsOpaqueOwned(value) 'ownedIsTransferred'
			return false
		end 'ownedIsTransferred'

		// A constructor feed this frame does not keep is paid for by the call site's consume
		// (`constructorFeedParams`).
		if valueIsMarked(self.bodyState.constructorFeedParams, value: value) 'settledByTheCallSite'
			return false
		end 'settledByTheCallSite'

		// ⭐ **A GENERIC NO INSTANCE OF WHICH EXISTS HAS NO `T` TO REFERENCE, AND THIS IS THE PREDICATE THE
		// RESERVATION READ** (`genericTypeIsInstantiated`, asked here of the value's own token). Both answer over
		// the whole program's instances: a type only a parse instantiates is found by the fold and the index the
		// reservation reads is settled again with it (`Queries.foldEveryFileInto`).
		//
		// ⚠ **IT IS DELIBERATELY *NOT* "IS SOME INSTANTIATION MANAGED".** The reservation is settled before any
		// body is parsed and so cannot see a CONCRETE instantiation at all — see `genericTypeIsInstantiated`.
		//
		// The zero word is what makes the retain free where it is not needed: `retainFunc@64` is 0 for an
		// instantiation whose argument owns NO RECORD — an `int`/`bool`/`float`, a ranged alias, a payload-free
		// enum — so `__retain_type_param` loads it, skips the `callIndirect` and hands back exactly the value it
		// was given. WHICH protocol applies stays the DESCRIPTOR's to say — minted per instance after every file is
		// parsed.
		//
		// ⚠ **"TRIVIAL" IS NOT THE LINE.** An all-scalar STRUCT is trivial in the CONSUME sense (`typeArgIsOwned`
		// false — the call site borrows it and the caller keeps it) and is a refcounted heap box all the same, so
		// its word is `__mm_retain`. `typeOwnershipProtocol` is the boundary that decides this slot.
		return self.signatures.typeParamOwnerIsInstantiated(self.valueTypeParamId(value))
	end 'opaqueSlotTakesItsOwnReference'

	// ⭐ **THE REPEAT GUARDS' SHARED GATE: would a SECOND owning destination for `value` in this construct free
	// one reference twice?** Only an opaque `T` value whose destination INHERITS this frame's reference can —
	// everything else takes an independent reference per destination and may repeat freely: a concrete managed
	// value co-owns (the 2026-08-12 ruling), a substituted opaque is concrete, and a borrowed opaque the
	// descriptor can retain takes one per slot. Spelled once because its two askers must ask the SAME
	// question: a field guard testing the DESTINATION's declared type and an argument guard testing the
	// VALUE's ownership make `Self{a: v, b: v}` and `Pair.create(v, b: v)` two answers to one question.
	function repeatedOwningDestinationWouldDoubleFree(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.typeParameter and not self.opaqueSlotTakesItsOwnReference(value)
	end 'repeatedOwningDestinationWouldDoubleFree'

	// ⭐⭐ **BECOME A SECOND OWNER OF A BORROWED OPAQUE `T`, THROUGH THE ENCLOSING INSTANCE'S DESCRIPTOR**
	// — `coOwnBorrowedForConsume`'s arm for the type the shared body cannot name.
	// `__retain_type_param(descriptor, value)` reads `retainFunc@64` and `callIndirect`s it: `__str_clone` for a
	// byte-record argument, `__mm_retain` for an aggregate, and nothing at all for a trivial one, whose word is
	// 0. `lowerRuntimeCall` prepends the descriptor, exactly as it does for the drop twin.
	//
	// **TWO DOORS OWE THIS REFERENCE, AND THEY OWE THE SAME ONE.** A STORE into a durable slot
	// (`moveOpaqueValueInto`) and a RETURN out of the body (`emitOwnedValueReturn`) each
	// hand a borrowed `T` to an owner that will release it, and neither can name the protocol. Written twice
	// they would be two answers to one question about a reference count — a leak on one side and a double free
	// on the other.
	//
	// ⚠ **THE RESULT IS WHAT THE CALLER USES AND NEVER `value`** — the byte-record arm hands back a DIFFERENT
	// record, which is the identical trap `coOwnBorrowedForConsume`'s existential arm measured as an access
	// violation plus a leaked clone. This frame marks the result neither owned nor pending, and that is right
	// for both doors: the new owner is a SLOT in another record whose destructor releases exactly this
	// reference, or the CALLER, which adopts it (`enrolOwnedCallTemp`).
	//
	// ⚠ It records a missing descriptor rather than emitting a call the lowering can only abort on — the
	// arrangement `emitDecref` already has for the drop, so `parseFunction` refuses it with a position.
	function coOwnBorrowedOpaque(value ValueId, range SourceRange) returns ValueId
		// Downgraded for `markValueCoOwnsHeap`'s reason: the instance descriptor's retain is an incref for every
		// managed instantiation, and inert for a trivial one — so a second owner either exists or there is
		// nothing to own, and neither case licenses a destructive write through `value`.
		self.markValueCoOwnsHeap(value)
		let retained = self.emitRuntimeCall(RetainTypeParamName, args: argsOf(value), resultTag: self.tagOf(value), resultNameId: self.valueNameId(value), range: range)
		self.carryFromSharedRecord(retained, from: value, source: self.bodyState, path: ValueCarryPath.copy)
		self.noteFeedStored(value, range: range)
		return retained
	end 'coOwnBorrowedOpaque'

	// ⭐ **STORE AN ALREADY-CLASSIFIED-MANAGED VALUE INTO DURABLE STORAGE** — the core of `moveInPayload`,
	// factored out so a struct field / union payload (`moveInPayload`) and an ARRAY element
	// `moveElementIntoContainer`) share the ONE transfer rule and cannot drift on it. A borrowed String is promoted
	// to an owned copy (a fresh temp de-listed); a borrowed struct/union/existential is CO-OWNED
	// (`coOwnBorrowedForConsume`, which for an existential answers with the reference it TOOK — that may be a
	// fresh record); an owned value held by a LIVE BINDING is CO-OWNED too (`storeOwnedValueIntoDurableSink`,
	// the ruling below); an owned TEMPORARY is adopted outright, its statement-end drop cancelled. Precondition:
	// the value is managed.
	//
	// ⭐⭐ **A DURABLE STORE OF AN OWNED MANAGED VALUE INCREFS — IT DOES NOT MOVE (⚖ user ruling, 2026-08-12).**
	// POISONING the source binding instead — on the premise that the compiler is move-only and one `+1`
	// cannot be owned twice — makes the two-sink program the language's own witness-return case is built from
	// (persist into a durable field AND push into a transient local array) an E3102 that no rewriting of the
	// source can avoid, because BOTH sinks genuinely need a reference. The ruling is that each durable store
	// ADDS one: the
	// sinks co-own, the source binding stays LIVE, and its own scope-exit drop releases the reference it has
	// always held. Net refcount for the ordinary single-sink store is unchanged (+1 here, −1 at scope exit).
	//
	// ⚠ **A REBIND OF A PLAIN LOCAL IS NOT A DURABLE STORE AND IS UNTOUCHED.** `let u = t` / `s = t` over an
	// ordinary local still MOVE (`reassignBindingValue`, `declareInitializedBinding` → `poisonMoveSource`), so
	// `specs/moves.md`'s use-after-move family is untouched. A second NAME for a value is not a
	// sink: it owes no drop of its own, it inherits the one the old name owed.
	//
	// ⚠⚠ **THE EXCEPTION IS A CELL-RESIDENT BINDING, AND IT IS A REBIND THAT *IS* A DURABLE STORE.** `s = t`
	// where `s` is a by-reference parameter never reaches `reassignBindingValue` at all —
	// `parseAssignment` routes it to `reassignCellBinding`, which discharges the write through THIS door and so
	// co-owns. That is right, and it is right for the ruling's own reason: a cell is the CALLER's storage and
	// outlives this frame, exactly as a field or a global's slot does (`reassignCellBinding` says so in its own
	// words). Routing it back to a move would rebuild the inconsistency in the other direction — `self.f = t`
	// co-owning while `byRefParam = t` moved.
	//
	// ⚠ **THE OPAQUE `T` DOORS MOVE AN OWNED VALUE** (`moveOpaqueValueInto`,
	// `moveElementIntoContainer`'s opaque arm, `transferConsumedArg`'s opaque arm). A shared generic
	// body cannot name an incref: its only retain is `retainFunc@64` out of the enclosing instance's
	// layout descriptor, which a body carrying no descriptor (a `static` over a trivial instantiation)
	// does not have — so co-owning there unconditionally converts a working program into a refusal.
	// Those doors take a reference where a move is provably wrong (across a loop back edge), and for a
	// kept constructor feed (`coOwningFeedParams`).
	function moveManagedValueInto(arg ValueId, argBareLocal bool, isString bool, range SourceRange) returns ValueId throws SourceParseError
		if self.valueIsDeferred(arg) 'aDeferredCallResult'
			return arg
		end 'aDeferredCallResult'

		try self.requireNotMovedSinceItWasRead(arg, range: range)

		// ⚠⚠ **A MANAGED VALUE ENTERING DURABLE STORAGE WHOSE TYPE RESTS A SLOT AT THE ENCLOSING PARAMETER IS
		// NOT REFUSED HERE.** A FIELD of the enclosing type is the arrival that reaches it —
		// `Self\{one: EBox.create(x, …)\}` — and the enclosing instance's destructor releases that field: a
		// concrete one through the substituted `__destruct_Box_String`, a declaration view through its dictionary
		// destructor (`MmRuntime.nestedViewDropKind`). What such an arrival needs is the reference, not the
		// release, and the constructor feed takes it (`referenceOrMarkOpaqueFeed`).
		//
		// ⇒ what DOES owe a descriptor is the arrival whose release is a STAMPED ONE-ARGUMENT function pointer
		// — a container's element, a `List` node, a `Map`/`Set` column — because a declaration view's release
		// is a two-argument dictionary destructor and no static stamp can hold one. That is settled at the two
		// container CREATE sites (`requireColumnDropIsNameable`), which are the doors those arrivals pass and
		// this one is not.

		// ⭐⭐ **A TUPLE IS COPIED HERE, NOT MOVED — BECAUSE A TUPLE IS A VALUE.** A struct is CO-OWNED
		// below when it is borrowed and MOVED when it is owned, and both are right for a struct: it has
		// reference identity a program can observe (an alias, a mutation through one), so a second record
		// would be a second thing. A tuple has none — the only way to obtain one is the expression that
		// just produced it — so the durable slot takes its OWN record and the source keeps its own. That
		// is what makes `xs.push(p)` followed by `return p` mean what `specs/tuples.md` says it means:
		// the array owns one record and the return owns another, where a move would poison `p` and a
		// share would free one record twice.
		//
		// ⚠ **ONLY A TRIVIAL-ELEMENT TUPLE, AND THE RESTRICTION IS A DELIBERATE NON-GOAL RATHER THAN A
		// SOUNDNESS ONE.** A per-element retain is available and would make a shallow copy of a managed-element
		// tuple perfectly droppable. What is
		// NOT available is the VALUE semantics a copy exists for. A retain hands back a second record whose
		// elements ALIAS the first's, so a write through one tuple would show on the other — precisely what a
		// trivial tuple's copy exists to prevent, and what `returned-tuple-copies-only-when-trivial` pins from
		// the other side. A managed-element tuple therefore keeps the struct rules below (share one record,
		// co-own it) until it has a DEEP clone, the only copy that would mean what a tuple
		// means. A tuple holding a promise keeps them for good: a green thread cannot be copied at all.
		if self.valueIsCopyableTuple(arg) 'copyTuple'
			return self.copyTupleForSink(arg, range: range)
		end 'copyTuple'

		if isString 'string'
			if not self.valueIsOwnedHeap(arg) 'promoteBorrowed'
				// ⭐⭐ **A BORROWED BYTE RECORD IS CO-OWNED, NOT COPIED — THE SAME ANSWER THE STRUCT/UNION ARM
				// DIRECTLY BELOW GIVES, AND FOR THE SAME REASON.** Maxon is single-ownership with reference
				// semantics: *"everything is a reference; if you want a copy you do it explicitly with
				// `clone()`"*. A `Self{name: n}` that stores a DIFFERENT record than the `n` it was handed is
				// a copy the author did not write, and it makes the field's identity diverge from the
				// source's — which is precisely the divergence the aggregate arm refuses to introduce.
				// `__str_retain` is what lets this be said at all: it increfs a HEAP record and copies only
				// an immortal `.rdata` literal, which cannot be increfed because its header is in a
				// read-only image section. The copy that remains is therefore about the LITERAL's storage
				// class, not about borrowing.
				//
				// ⚠ The result is a FRESH SSA value that this frame owns, exactly as the copy was, so the
				// pending-temp bookkeeping is unchanged: the sink adopts the reference and the statement
				// drain must not also drop it.
				let owned = self.retainBorrowedByteRecord(arg, range: range)
				self.removeFromPendingTemps(owned)
				return owned
			end 'promoteBorrowed'
		end 'string' else 'structOrUnion'
			if not self.valueIsOwnedHeap(arg) 'borrowedManaged'
				// ⭐ **CO-OWNED, NOT MOVED (the transitive-consume ruling, 2026-08-04).** An aggregate has no
				// clone, so the durable slot becomes a SECOND OWNER of the same record; the borrow's own owner
				// is untouched and this frame poisons nothing, so the `transferOwnedInto` below is skipped
				// deliberately rather than fallen past. `coOwnBorrowedForConsume` states the rule in full, and
				// its ARGUMENT twin (`transferConsumedArg`) answers the same question one call boundary out.
				// ⚠ Its RESULT is what is stored, never `arg`: an EXISTENTIAL's reference is taken through the
				// witness and a byte-record conformer's protocol there is a COPY, so the two can differ.
				return self.coOwnBorrowedForConsume(arg, range: range)
			end 'borrowedManaged'
		end 'structOrUnion'

		if argBareLocal 'sourceMayBeALiveBinding'
			return self.storeOwnedValueIntoDurableSink(arg, isString: isString, range: range)
		end 'sourceMayBeALiveBinding'

		// With the gate false the value came from an EXPRESSION rather than a name, so no binding owns it and
		// the slot simply ADOPTS the `+1` it was just handed — the statement-end drop is cancelled and nothing
		// is poisoned, because there is no source to poison. Spelled here rather than routed through
		// `transferOwnedInto`: that door's other arm is the move-poison, which is now unreachable from this
		// function, and calling it with a statically-false flag would read as though a move could still happen.
		self.removeFromPendingTemps(arg)
		return arg
	end 'moveManagedValueInto'

	// ⭐⭐ **HAND AN OWNED CONCRETE MANAGED VALUE TO A DURABLE SINK — THE ONE ACT, SHARED BY THE DIRECT STORE AND
	// THE CONSUMING ARGUMENT** (`moveManagedValueInto`, which carries the 2026-08-12 ruling, and
	// `transferConsumedArg`, which is the same sink one call boundary out). Written twice, the two would be free
	// to settle differently on what a durable sink owes a value — a leak on one side and a double free on the
	// other, from a distinction the language does not draw.
	//
	// **THE SPLIT IS "IS THERE A SECOND OWNER TO KEEP ALIVE?"** A value a LIVE BINDING holds keeps that binding
	// and its scope-exit drop, so the sink must take its OWN reference. An owned TEMPORARY has no other owner at
	// all, so the sink ADOPTS the `+1` the expression just minted and the statement-end drop is cancelled — an
	// incref/decref pair around a value nothing else reads would be pure churn.
	//
	// ⚠⚠ **THE SPLIT IS AN `if`/`else`, WHICH MAKES A PRECONDITION LOAD-BEARING THAT USED TO BE BELT-AND-BRACES:
	// A VALUE IS NEVER IN `ownedBindings` AND `pendingTempDrops` AT THE SAME TIME.** The door this replaced at
	// `transferConsumedArg` ran the poison AND `removeFromPendingTemps` unconditionally, on the argument that
	// each is a no-op on the other's case — so it stayed correct even if a value were somehow in both. This one
	// takes the co-own arm for a bound value and never de-lists, so a value in both lists would keep a
	// statement-end `__mm_decref` against a reference the SINK now owns: a use-after-free on the next read, not
	// a leak. The invariant is `markValueOwnsHeap`'s and `trackOwnedTemp`'s to keep — the two owned-bit doors
	// exist precisely because a binding's drop and a statement's drop are alternatives, never both (see
	// `markValueOwnsHeap`, whose header carries the measured double-free from adding a pending entry for a
	// consumed parameter that already dropped through `ownedBindings`).
	//
	// Two retain protocols, and they are the SAME two the BORROWED arms already route between: a byte record
	// through `__str_retain` (an incref on the heap branch, a copy of an immortal `.rdata` literal on the other),
	// an aggregate or existential through `coOwnBorrowedForConsume`. The RESULT is what the sink receives and
	// never `arg` — both of those may hand back a DIFFERENT record, which is the measured access violation
	// `coOwnBorrowedForConsume` records.
	//
	function storeOwnedValueIntoDurableSink(arg ValueId, isString bool, range SourceRange) returns ValueId
		if not self.hasLiveOwner(arg) 'ownedTemporaryIsAdopted'
			self.removeFromPendingTemps(arg)
			return arg
		end 'ownedTemporaryIsAdopted'

		if self.valueHoldsAUniqueRecord(arg) 'aUniqueValueHasOneName'
			self.moveOwnedValueOut(arg)
			return arg
		end 'aUniqueValueHasOneName'

		if isString 'byteRecord'
			return self.retainBorrowedByteRecord(arg, range: range)
		end 'byteRecord'

		return self.coOwnBorrowedForConsume(arg, range: range)
	end 'storeOwnedValueIntoDurableSink'

	// Transfer an already-OWNED managed value into durable storage: a bare-local reference to a binding is
	// POISONED (`movedFrom` — E3102 on later use); an owned temporary is removed from the statement's pending
	// drops (the box owns it now). THE one place the "who no longer owns this value" bookkeeping lives, so a
	// union payload move and a struct-field move cannot drift on it.
	function transferOwnedInto(arg ValueId, argBareLocal bool)
		if argBareLocal 'moveOnBind'
			self.moveOwnedValueOut(arg)
		end 'moveOnBind' else 'consumeTemp'
			self.removeFromPendingTemps(arg)
		end 'consumeTemp'
	end 'transferOwnedInto'

	// Store the case TAG at the box's offset 0 as an i64 — the same i64 tag `emitEnumTagLiteral` mints
	// for a bare enum and the same `match` loads back to dispatch, so construct and match cannot
	// disagree about what a case's tag is.
	function emitUnionTagStore(box ValueId, tag FullRangeInt, range SourceRange)
		let tagLit = self.emitLiteral(tag, valueType: MaxonType.integer, range: range)
		self.emitIndirectStore(box, offset: UnionTagOffset, value: tagLit, storageType: MaxonType.integer, range: range)
	end 'emitUnionTagStore'

	// A payload argument must agree with its field's classified type. A SCALAR uses `checkDeclaredType`,
	// the same coercion-site rule a struct literal field, a call argument and a `return` ask, PLUS the
	// nominal identity `checkDeclaredType` structurally cannot ask (`requireSlotAggregateIdentity`); a MANAGED
	// payload requires the matching heap kind (a String, or a struct/boxed union of the same name).
	//
	// ⚠ **TWO ANCHORS, AND THEY ARE DIFFERENT QUESTIONS.** `caseTok` names the CONSTRUCT and is where a
	// refusal about the case as a whole belongs (a payload the tier cannot lower, a slot left unfilled);
	// `argTok` is the token following THIS argument and is where a refusal about ONE argument's type
	// belongs, which is the position the canonical specs pin (`union-payload.error.wrong-struct`).
	function requirePayloadArgType(field PayloadField, declared MaxonType, declaredWithAlias MaxonType, class PayloadClass, value ValueId, caseTok Token, argTok Token, voice SlotMismatchVoice, layout EnumLayout) returns ValueId throws SourceParseError
		match class 'c'
			// An opaque `T` payload takes the scalar rule: `checkDeclaredType`'s type-parameter arm is where
			// an argument meets an opaque formal. ⚠ Never as a `scalar to typeParam` range: `scalar` is the
			// first variant of `PayloadClass` and `typeParam` the last, so the range would swallow every
			// case between.
			scalar or
			typeParam then return try self.requireScalarPayloadArg(field, declared: declared, declaredWithAlias: declaredWithAlias, value: value, caseTok: caseTok, argTok: argTok, voice: voice, layout: layout)
			managed(storage, isString) then return try self.requireManagedPayloadArg(field, storage: storage, isString: isString, declared: declared, value: value, caseTok: caseTok, argTok: argTok, voice: voice, layout: layout)

			// A nested boxed union takes the managed door, over its `named(<union>)` value type and not over
			// the machine word its slot is. A boxed union's value carries `named`, which every ranged-int
			// alias and every payload-free enum also carries, so the tag comparison alone agrees for any two
			// of them; it is `requireManagedValueMatches`' second half (`requireSlotAggregateIdentity`) that
			// makes `Wrap.wrap(Other.a(5))` a positioned refusal rather than an `Other` box read back under
			// `Inner`'s destructor. `isString: false` — a union box is an aggregate, never copied by the
			// fused-record protocol a String takes.
			nestedUnion(storage) then try self.requireManagedValueMatches(storage, isString: false, value: value, placeDoor: FunctionTypeDoor.payload, placeName: field.name, placeOwner: SlotOwner.unowned, placeBrand: EmptySourceText, placeSpelling: EmptySourceText, voice: voice, anchor: argTok)

			// The promise's own type check, and it must NOT go through `requireScalarPayloadArg`: that door
			// compares TAGS, and a `genericInstance` against the declared `named` alias is an E3005 about a
			// promise being stored in the promise slot that declares it. `requireManagedValueMatches` compares
			// the two as the aggregate identities they are.
			greenThread(storage) then try self.requireManagedValueMatches(storage, isString: false, value: value, placeDoor: FunctionTypeDoor.payload, placeName: field.name, placeOwner: SlotOwner.unowned, placeBrand: EmptySourceText, placeSpelling: EmptySourceText, voice: voice, anchor: argTok)

			// An undeclared payload name is a user error TypeResolution reports (E3011); the op is kept
			// well-formed for the instant before the pipeline's error gate throws — nothing to check here.
			undeclaredName then break
			existential then self.recordExistentialPayloadStore(field, declared: declared, value: value, caseTok: caseTok, argTok: argTok)
		end 'c'

		return value
	end 'requirePayloadArgType'

	function requireManagedPayloadArg(field PayloadField, storage MaxonType, isString bool, declared MaxonType, value ValueId, caseTok Token, argTok Token, voice SlotMismatchVoice, layout EnumLayout) returns ValueId throws SourceParseError
		if maxonTypeTag(storage) == ValueTypeTag.function 'aFunctionValue'
			return try self.requireScalarPayloadArg(field, declared: declared, declaredWithAlias: declared, value: value, caseTok: caseTok, argTok: argTok, voice: voice, layout: layout)
		end 'aFunctionValue'

		try self.requireManagedValueMatches(storage, isString: isString, value: value, placeDoor: FunctionTypeDoor.payload, placeName: field.name, placeOwner: SlotOwner.unowned, placeBrand: self.payloadPlaceBrand(field, layout: layout, resolved: storage), placeSpelling: field.declaredBrand, voice: voice, anchor: argTok)
		return value
	end 'requireManagedPayloadArg'

	// ⭐ **A MESSAGE ARGUMENT AT AN INTERFACE-TYPED PARAMETER WIDENS AS A FIELD STORE DOES**, and whether it
	// conforms is `SemanticCheck.checkExistentialFieldStores`' whole-program verdict for the same reason — a
	// conformer's `implements` clause is recorded when its own file is parsed. A parameter carries no `with`
	// claim of a record's type parameter, so the store names none.
	function recordExistentialPayloadStore(field PayloadField, declared MaxonType, value ValueId, caseTok Token, argTok Token)
		let site = freeze "'{String.from(field.name)}' of the message '{String.from(caseTok.value)}'".toByteArray()
		self.recordExistentialStore(ExistentialFieldStore.create(value, subject: value, interfaceName: interfaceNameOfType(declared, typeNames: self.artifact.typeNames), claims: GenericInstanceIdArray.create(0), fieldSite: site, place: ExistentialStorePlace.messageArgument, line: argTok.line, column: argTok.column, filePath: self.job.path))
	end 'recordExistentialPayloadStore'

	// ⚠ **THE TAG COMES OFF THE RESOLVED `declared`, NEVER OFF `field.declaredType`.** Read raw, a
	// FUNCTION-alias payload is a `named` — an int — so `Payload.op(twice)` would meet the
	// `functionIntoNonFunction` arm below and be refused E3005. Resolved, it is the function type the value is.
	function requireScalarPayloadArg(field PayloadField, declared MaxonType, declaredWithAlias MaxonType, value ValueId, caseTok Token, argTok Token, voice SlotMismatchVoice, layout EnumLayout) returns ValueId throws SourceParseError
		let declaredTag = maxonTypeTag(declared)
		let got = self.tagOf(value)

		// ⭐⭐ **A FUNCTION VALUE INTO A FUNCTION-TYPED PAYLOAD IS THE FOURTH DOOR, AND IT REACHED NONE OF THEM.**
		// `checkDeclaredType` answers `ok` for `function` meeting `function` on the TAG alone —
		// which is right, because two function TYPES share that tag exactly as two structs share `structRef`
		// and no tag comparison can settle it. Every other position that holds a declared function type
		// records a door for `SemanticCheck.checkFunctionTypeDoors`; this one fell through the `ok` arm and
		// compared nothing at all. MEASURED on a two-parameter function stored in a one-parameter payload and
		// called through it: arm64-macOS prints `v=7` — the second argument is the leftover slot — and
		// `wasm32-wasi` traps *"indirect call type mismatch"*, `call_indirect` being the one target that
		// checks. Recorded rather than decided here for `recordFunctionTypeDoor`'s reason: the shapes live in
		// the whole-program registries and are compared RESOLVED.
		if isFunctionTypeDoor(declaredTag, got: got) 'functionIntoFunctionPayload'
			self.recordFunctionTypeDoor(typeNameIdOf(declared), gotNameId: self.functionValueGoverningId(value), door: FunctionTypeDoor.payload, place: FunctionTypeDoorPlace.named(field.name), anchor: caseTok, handedAt: caseTok)
		end 'functionIntoFunctionPayload'

		match self.declaredSlotVerdict(got, gotNameId: self.valueNameId(value), declared: declaredTag, declaredNameId: typeNameIdOf(declaredWithAlias)) 'declared'
			ok then break
			mismatch then throw self.slotMismatchError(voice, placeDoor: FunctionTypeDoor.payload, placeName: field.name, placeOwner: SlotOwner.unowned, placeBrand: EmptySourceText, placeSpelling: EmptySourceText, got: self.valueDisplayTypeName(value), gotNote: "", resolvedExpected: self.declaredSlotDisplayName(declaredTag, nameId: typeNameIdOf(declaredWithAlias), fallback: typeTagName(declaredTag)), expectedNote: "", declared: declaredTag, declaredNameId: typeNameIdOf(declaredWithAlias), line: argTok.line, column: argTok.column, crossesRange: false)
			narrowsFloatToInt then throw SourceParseError.implicitNarrowing(self.valueDisplayTypeName(value), targetType: self.declaredSlotDisplayName(declaredTag, nameId: typeNameIdOf(declaredWithAlias), fallback: typeTagName(declaredTag)), line: argTok.line, column: argTok.column)

			// A FUNCTION VALUE into a scalar union PAYLOAD whose declared type is NOT a function — the same
			// E3005 a function value meeting any other non-function slot earns. A function-ALIAS payload no
			// longer reaches it: `declaredTag` is `function` there and `checkDeclaredType` answers `ok`.
			functionIntoNonFunction then throw SourceParseError.functionValueIntoNonFunction("payload '{String.from(field.name)}'", heldType: self.declaredSlotDisplayName(declaredTag, nameId: typeNameIdOf(declaredWithAlias), fallback: typeTagName(declaredTag)), line: argTok.line, column: argTok.column)
		end 'declared'

		// ⭐⭐ **AND THE NOMINAL IDENTITY, WHICH `checkDeclaredType` STRUCTURALLY CANNOT ASK — THE SIXTH DOOR
		// ON `requireSlotAggregateIdentity`.** A payload-free enum's value
		// IS its i64 tag, so an ENUM-typed payload is `PayloadClass.scalar` and its verdict is
		// `checkDeclaredType(named, named)` — which AGREES for any two enums, exactly as it does for an
		// enum-typed struct FIELD without `requireSlotAggregateIdentity` (see the header there). MEASURED on
		// `union Paint tint(c Color) end` handed a `Shade`: it COMPILED, and the binding `c` came back out as
		// a `Shade` ordinal wearing `Color`'s name — `specs/union-cases.md`'s `union-payload.error.wrong-enum`
		// is that program. The MANAGED half of the payload door asks (through
		// `requireManagedValueMatches`), which is why the STRUCT twin of the same hole is refused
		// and only the enum one needs this door.
		//
		// Asked past the verdict rather than instead of it: a tag disagreement is the coarser fact and reads
		// better said first, and a value that failed it has no identity worth comparing.
		try self.requireSlotAggregateIdentity(declaredWithAlias, value: value, placeDoor: FunctionTypeDoor.payload, placeName: field.name, placeOwner: SlotOwner.unowned, placeBrand: self.payloadPlaceBrand(field, layout: layout, resolved: declared), placeSpelling: field.declaredBrand, voice: SlotMismatchVoice.payloadArgument, anchor: argTok)

		self.admitUnsignedLiteralIntoSlot(value, slot: declaredTag, slotNameId: typeNameIdOf(declared))
		return self.coerceToDeclared(value, declared: declaredTag, anchor: argTok)
	end 'requireScalarPayloadArg'

	// Load a boxed union's i64 TAG from offset 0 — the DISPATCH SUBJECT a `match` compares against
	// each case's tag. Its result is `integer`-tagged (a plain i64), not `named`, so the dispatch
	// compare is an i64 equality the E3066 union guard never sees. Loaded ONCE per match (it dominates
	// every arm's test block).
	function emitUnionTagLoad(box ValueId, range SourceRange) returns ValueId
		return self.emitIndirectLoad(MaxonType.integer, box: box, offset: UnionTagOffset, storageType: MaxonType.integer, range: range)
	end 'emitUnionTagLoad'

	function emitUnboxedPayloadFreeWord(layout EnumLayout, caseIndex CaseIndex, range SourceRange) returns ValueId
		let word = self.emitEnumTagLiteral(layout.name, tag: layout.payloadFreeWordOfIndex(caseIndex), range: range)
		self.markImageRecordRead(word)
		return word
	end 'emitUnboxedPayloadFreeWord'

	// A case's declaration index, read by `.ordinal` and the enum accessors: the dispatch key, mapped
	// back from the word key for a word union.
	function emitEnumTagOf(value ValueId, layout EnumLayout, anchor Token, range SourceRange, reach EnumTagReach) returns ValueId throws SourceParseError
		let key = try self.emitEnumDispatchKey(value, layout: layout, anchor: anchor, range: range, reach: reach)

		match self.signatures.unionRepresentation(layout) 'representation'
			word then return try self.emitDeclarationIndexOfWordKey(key, layout: layout, anchor: anchor, range: range)
			bareTag or
			box then return key
		end 'representation'
	end 'emitEnumTagOf'

	function emitDeclarationIndexOfWordKey(key ValueId, layout EnumLayout, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		if not layout.wordKeysFollowDeclarationOrder() 'keysAreShuffled'
			return try self.emitEnumCaseConstantSelect(layout, tag: key, column: EnumCaseConstant.declarationIndex, anchor: anchor, range: range, domain: EnumSelectDomain.wordKey)
		end 'keysAreShuffled'

		return self.emitMachineWordBinOp(key, rhs: self.emitLiteral(UnboxedFirstKey, valueType: MaxonType.integer, range: range), op: MaxonBinOp.sub, resultType: MaxonType.integer, range: range)
	end 'emitDeclarationIndexOfWordKey'

	// ⭐⭐ **WHERE AN ENUM VALUE'S TAG LIVES — THE ONE ANSWER, read by the `match` DISPATCH and, through
	// `emitEnumTagOf`, by `.ordinal`.** A SCALAR enum's value IS its tag (`parseEnumLiteral` emits the tag
	// as the value), so the tag is the value and this emits nothing. A BOXED union's value is a heap
	// POINTER, so its i64 tag is LOADED from offset 0 through `emitUnionTagLoad` above. A WORD union's
	// value carries its key (`wordKeyOfIndex`) in the low bits, or from bit 48 up for a payload-free case
	// of a union too large for the tag mask, so the key is read by `emitUnboxedWordKey`.
	//
	// ⚠⚠ **IT IS ONE FUNCTION BECAUSE THE DECISION DRIFTS, NOT ONLY THE OFFSET — AND THE DRIFT IS MEASURED.**
	// Both readers already shared `emitUnionTagLoad`, so they could never disagree about WHERE in the box a
	// tag sits; they each carried their own copy of WHETHER to look there, and that is the copy that came
	// apart. `.ordinal` did not have one at all: it read `tagsAreDeclarationIndices` (true for a boxed
	// union, whose tags are `0,1,2,…`) as permission to treat the value as the tag, so
	// `Container.value(7).ordinal` printed 7077912 and `Container.empty.ordinal` printed 7078078 against the
	// oracle's 1 and 0 — box addresses, which moved between runs. Reunited here, a reader that forgets the
	// question cannot be written: there is nowhere to ask it.
	//
	// ⚠ **EVERY CASE OF A PAYLOAD-BEARING UNION TAKES ITS RECORD FORM, PAYLOAD-FREE ONES INCLUDED** —
	// `carriesPayloads` decides per UNION (`maxPayloadArity() > 0`), not per case, so `empty` beside a
	// `value(n)` is a bare tag in a box, or the stored tag alone in a word, and its value is not a
	// bare tag either way. That is why the predicate here is the layout's and never the case's.
	//
	// A caller that has not already established the value IS an enum keeps that guard at its own site — the
	// `match` dispatch's `isEnumMatch`, which is a question about the SCRUTINEE and not about the layout.
	function emitEnumDispatchKey(value ValueId, layout EnumLayout, anchor Token, range SourceRange, reach EnumTagReach) returns ValueId throws SourceParseError
		// ⭐⭐ **THIS FILE REACHED INTO A VALUE OF `layout.name`, AND THIS IS THE ONE LINE THAT KNOWS IT** —
		// `requireFieldAccessible`'s twin for enums and unions, recorded through the same one-writer channel and
		// for the same reason. A `match` arm spells CASE names (`small`, `big(n)`), `.ordinal` spells a member,
		// and an interpolation hole spells nothing at all, so a file that reaches another file's union this way
		// leaves NO written name for `usedTypeNames` to hold — and E3092 told the author to drop the `export`
		// that made the program compile. Third instance of one class; see `UnusedExportCheck`'s header for the
		// first two.
		//
		// ⚠⚠ **RECORDED HERE AND NOT AT `enumMatchFor`, WHICH IS THE WIDER DOOR — AND THE DIFFERENCE IS
		// MEASURED, NOT ARGUED.** That one also answers for a drop cascade (`decrefCalleeFor`) and a
		// refused cast (`requireCastSourceIsNotEnum`) — none of them a
		// source-level reach. Crediting the drop is exactly the callee-RETURN-type credit `noteCalleeSignature`
		// refuses by name. MEASURED by putting the credit there and rebuilding:
		// `unused-export/error.unused-exported-union-nothing-outside-reaches` went RED — "expected a compile
		// error but compilation succeeded" — while all three `match`/accessor cases stayed green. That case's
		// whole subject is a file that HOLDS such a value and never opens it, so the wider door deletes it.
		//
		// ⚠ Written BEFORE the representation split: a bare-tag enum's value IS its tag and emits
		// nothing, but the file reached the layout either way. A cure behind the load would pass the
		// union cases and still report every plain `enum`.
		match reach 'reach'
			written then try self.requireMembersReachable(layout.name, visibility: layout.visibility, declFilePath: layout.declFilePath, memberTok: anchor)
			languageMade then try self.requireMembersReachableToTheLanguage(layout.name, visibility: layout.visibility, declFilePath: layout.declFilePath, memberTok: anchor)
		end 'reach'

		match self.signatures.unionRepresentation(layout) 'representation'
			bareTag then return value
			word then return self.emitUnboxedWordKey(value, layout: layout, range: range)
			box then return self.emitUnionTagLoad(value, range: range)
		end 'representation'
	end 'emitEnumDispatchKey'

	function emitUnboxedWordKey(word ValueId, layout EnumLayout, range SourceRange) returns ValueId
		let tagBits = self.emitMachineWordBinOp(word, rhs: self.emitLiteral(UnboxedTagMask, valueType: MaxonType.integer, range: range), op: MaxonBinOp.bitAnd, resultType: MaxonType.integer, range: range)

		if not layout.wordKeysNeedInhabitants() 'tagBitsAreTheKey'
			return tagBits
		end 'tagBitsAreTheKey'

		let inhabitantKey = self.emitMachineWordBinOp(word, rhs: self.emitLiteral(UnboxedInhabitantShift, valueType: MaxonType.integer, range: range), op: MaxonBinOp.shrLogical, resultType: MaxonType.integer, range: range)

		return self.emitMachineWordBinOp(tagBits, rhs: inhabitantKey, op: MaxonBinOp.bitOr, resultType: MaxonType.integer, range: range)
	end 'emitUnboxedWordKey'

	// The tag a dispatch plan holds for a case, which is what `emitEnumDispatchKey` yields for a value of
	// that case: a word union's key (`wordKeyOfIndex`), never its declaration index, or the arm would be
	// keyed off.
	function dispatchTagOfIndex(layout EnumLayout, index CaseIndex) returns FullRangeInt
		return match self.signatures.unionRepresentation(layout) 'representation'
			word gives layout.wordKeyOfIndex(index)
			bareTag or
			box gives layout.tagOfIndex(index)
		end 'representation'
	end 'dispatchTagOfIndex'

	// ⭐⭐ **THE SAME QUESTION WHERE THERE IS NO VALUE TO ASK IT OF — a case named through its TYPE
	// (`Preset.large`, `TestOp.mul`), whose tag is a COMPILE-TIME CONSTANT.** It sits beside `emitEnumDispatchKey`
	// because it is the third answer to that function's one question, and the split between its two arms is
	// exactly the split there: for an UNBOXED declaration a case's tag IS its value, so the enum-typed literal
	// this mints serves both readers — the construct `Color.red` evaluates to and the tag an accessor selects
	// from. For a BOXED union the two part company (the value is a heap box, the tag a bare i64 at offset 0),
	// and only the tag is knowable without arguments, so that is all this mints.
	//
	// ⭐⭐ **THAT ASYMMETRY IS THE WHOLE OF WHY `TestOp.mul.latency` CAN WORK ON A PAYLOAD-BEARING UNION.**
	// Constructing `mul` would demand its `dest`/`src` arguments; reading its compile-time metadata needs no
	// value at all, so the read is answered from the tag alone and no box is ever allocated — which also means
	// there is no owned heap record minted mid-expression, the lifetime question `emitEnumBackingRawValue`
	// declines for a materialized backing.
	//
	// ⚠ **THE BOXED ARM MUST MINT `integer` AND NOT `named(<Union>)`.** A `named` claim over a bare tag is
	// a measured defect class — a box pointer stored as a tag, `0xC0000005`
	// (`enumBackingNamedFieldDomain`) — read in the other direction: `enumTagAsANumber` asks precisely
	// "is this already a bare number", and answering "no, it is a TestOp" about an i64 that IS one would be a
	// false claim kept honest only by luck.
	function emitEnumCaseTagConstant(layout EnumLayout, index CaseIndex, range SourceRange) returns ValueId
		let tag = layout.tagOfIndex(index)

		match self.signatures.unionRepresentation(layout) 'representation'
			bareTag then return self.emitEnumTagLiteral(layout.name, tag: tag, range: range)
			box or
			word then return self.emitLiteral(tag, valueType: MaxonType.integer, range: range)
		end 'representation'
	end 'emitEnumCaseTagConstant'

	// Load a payload field out of the box at `8 + slot*8`, or out of a word union by subtracting the
	// arm's stored tag from the word — the `emitFieldLoad` split, one op further. A SCALAR is minted at the field's DECLARED type
	// (so a nested `match dir` sees a `Direction`, and the shift rule reads a ranged alias's low
	// bound); a MANAGED payload is minted at its concrete storage type (`structRef`/`string`) so an
	// extracted struct's field access (`b.mass`) resolves and its ownership is read off the tag; a
	// nested BOXED UNION is minted at its `named(<union>)`, so a `match` on the extracted payload
	// recognizes it and its drop routes to `__destruct_<U>`. The op itself always carries a concrete
	// storage WIDTH, which for the boxed-union case is not the value type (`maxonTypeToStdType` panics
	// on a `named`) — see `payloadStorageOf`.
	//
	// ⚠ **THE SOURCE (A SLOT'S ADDRESS AND WIDTH, OR THE WORD) AND THE VALUE TYPE ARE ALL THE
	// CALLER'S, exactly as they are on the STORE side (`emitEnumBox`), and that is not a
	// convenience.** `declarePayloadBindings` needs the slot's `PayloadClass` anyway — to decide
	// managed-vs-scalar ownership, and to hand the slot's ADDRESS and WIDTH to the move-out's null
	// store — so classifying the slot a SECOND time here would derive
	// each of the numbers twice. The load and the store must agree on the address and the width
	// EXACTLY or the store corrupts the box, so they are derived ONCE at the caller and passed to
	// everything that emits with them.
	//
	// A scalar payload's `valueType` is its DECLARED type (an enum payload stays `named(<Enum>)` so a
	// nested `match` recognizes it) and never the storage: a function-alias payload bound out as a bare
	// `named` is an int, which is what made `print("{f(3)}")` on such a binding `E2015 … a value of type
	// 'unknown'`. The caller reaches it through `payloadValueTypeOf`, off the same `payloadTypeOf`
	// call that adopts the id into this file's interner — without which the minted value carries a
	// signatures id `enumMatchFor` would misresolve.
	function emitUnionPayloadLoad(box ValueId, field PayloadField, valueType MaxonType, source PayloadSource, range SourceRange) returns ValueId
		let result = match source 'source'
			word(tag) gives self.emitMachineWordBinOp(box, rhs: self.emitLiteral(tag, valueType: MaxonType.integer, range: range), op: MaxonBinOp.sub, resultType: valueType, range: range)
			slot(offset, storage) gives self.emitIndirectLoad(valueType, box: box, offset: offset, storageType: storage, range: range)
		end 'source'

		// ⭐ **A PAYLOAD DECLARED `__ManagedMemory` BINDS AS THE BUFFER SURFACE** — the declared
		// SPELLING, which `valueType` cannot carry (the alias resolves to the same `genericInstance` a
		// `ByteArray` payload does), taken off the payload record's own column. It sits at THIS mint for
		// `emitFieldLoad`'s reason: every `match` arm, every nesting depth and every scrutinee ownership
		// mode funnels through this one line, and a per-door mark would be the enumeration that misses one.
		self.markDeclaredSurface(result, declared: self.signatures.payloadSurfaceOf(field))
		self.noteAdaptedSlotRead(result, box: box, slot: field.capability)
		self.carryPayloadParamSources(result, box: box, slot: field.capability)

		if maxonTypeTag(valueType) == ValueTypeTag.interfaceRef 'andItsWitnessHalf'
			self.pairInterfaceWitness(result, witness: self.emitIndirectLoad(MaxonType.integer, box: box, offset: source.slotOffset() + InterfaceWitnessHalfOffset, storageType: MaxonType.integer, range: range))
		end 'andItsWitnessHalf'

		return result
	end 'emitUnionPayloadLoad'

	// Emit a case's TAG as an i64 `literal` whose VALUE tag is `named(<enum>)`. The one site that
	// mints an enum value, so the tag/op-type split (see `parseEnumLiteral`) lives in exactly one
	// place. See the ⭐ block on the `recordConst` below for why the tag IS written down: a constant enum
	// literal has to be RECOGNISABLE as constant.
	function emitEnumTagLiteral(enumName ByteArray, tag FullRangeInt, range SourceRange) returns ValueId
		let nameId = self.artifact.typeNames.intern(enumName)
		let result = self.mintValue(ValueTypeTag.named, nameId: nameId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.literal(result, value: tag, valueType: MaxonType.integer), range: range)

		// ⭐ **THE TAG IS WRITTEN DOWN AS A KNOWN CONSTANT, AND IT IS THE SAME FACT `bool` ALREADY WRITES DOWN
		// RATHER THAN A WIDENING OF ONE.** `emitLiteralIn` records an INTEGER-tagged literal's value; this mint
		// is deliberately separate (the value is `named(E)` while the op carries `integer`), so the recording
		// has to be spelled here or the compiler declines to write down a value it has in hand.
		//
		// ⚠ **WHAT THAT COST WAS MEASURABLE, and it is the identical measurement `emitLiteralIn`'s
		// float/bool split carries**: a CONSTANT `[Color.red, Color.green, Color.blue]` could not be
		// recognised as constant at all, so `enum-narrow-storage`'s six literals could not become the
		// `.rdata` blobs their spec pins. The domain is INTEGER because a payload-free enum's value IS an
		// i64 tag — the same reading `emitEnumTagOf` and `TypeResolution` give it — so no float pattern
		// can reach `foldIntBinOp` through this door. A BOXED union never arrives:
		// `emitEnumCaseTagConstant` sends it to `emitLiteral` at `integer`, because its value is a box
		// pointer and its tag is not it. A payload-free case of a WORD union does arrive, with its stored
		// word (`payloadFreeWordOfIndex`), which is the whole of that value.
		self.recordConst(result, folded: tag)

		return result
	end 'emitEnumTagLiteral'

	// `Point.create(3, y: 4)` — a call to a type's static method.
	//
	// It is an ORDINARY call with a mangled name, and that is the whole implementation: the callee
	// is `Point.create`, which is exactly the key `parseFunction` declared the method under
	// (`declaredMethodName`), so `emitCall` types the result from the signature index and
	// `slotCallArgs` reorders `y: 4` against the declaration — the SAME slotting every free call
	// gets, not a second one. A static method has no receiver, so there is nothing else to pass.
	//
	// ⚠ The base is NOT checked to be a declared type here, and that is deliberate rather than
	// missing: `Foo.bar()` where `Foo` is nothing at all resolves to a callee `Foo.bar` that no file
	// declares, which `SemanticCheck.validateCall` reports as E3004 — the authority for "no such
	// function", reading the registry the real parse built. A check here would be a second opinion
	// from the tolerant sweep, and the sweep must never own a veto (see `CalleeReturn.undeclared`).
	//
	// ⛔⛔ **`Adder.bump(a)` — AN INSTANCE METHOD NAMED STATICALLY — REACHES HERE AND IS *NOT* REFUSED, AND
	// "REJECTED BY ARITY" IS FALSE OF IT, AT THE COST OF AN ACCESS VIOLATION.** The call carries no
	// receiver, so the argument list is one short of
	// the signature (whose parameter 0 is `SelfParamName`) — but that is a refusal only WHEN THE COUNTS
	// DIFFER, and they COINCIDE for every zero-parameter instance method called with one argument. The
	// author's first argument then simply lands in slot 0, because that is where an unlabelled argument
	// goes; `Adder.bump(a)` on a real `Adder` IS `a.bump()`, and the runnable oracle compiles and runs
	// it (exit 42, measured), so the FORM is legal and refusing it here would refuse a working program.
	//
	// ⇒ The refusal is not a diagnostic about spelling: it is the ARGUMENT TYPE CHECK on that slot, which
	// `SemanticCheck.checkArgTypes` applies like any other parameter's (see its header for the three measured faults of
	// exempting it). `Adder.bump(7)` would otherwise COMPILE CLEAN and dereference an `int` as a record pointer. The
	// receiver is judged like any other parameter, and E3005 says
	// `argument type mismatch for 'self': expected 'Adder', got 'int'` — the oracle's own sentence,
	// which the compiler already spells for every other parameter. Nothing about it belongs in this routine.
	//
	// (The COUNTS that E3036 carries when the arities genuinely differ ARE inflated by the receiver,
	// which is not this routine's doing and is not restated here — see the receiver prepend in
	// `parseCallNamed`, the one place that causes it, for both callers.)
	// ⭐⭐ **WHICH COMPILER-OWNED SURFACE `typeName` DENOTES — the whole roster, in one reader.** See
	// `CompilerOwnedStaticSurface` for why it is a value. Its one asker is `resolveStaticMember`, and a
	// second roster would admit whichever surface is added next.
	//
	// ⚠ **THE ARM ORDER IS LOAD-BEARING** — each arm's own note says against what — so this reader keeps it
	// and no caller may re-ask the questions in another order.
	//
	// `aliasName` is the caller's resolved generic-alias key rather than one derived here: the caller needs
	// the same key for the ordinary path, and deriving it twice is the two-readings-of-one-alias trap that
	// `parseQualifiedCall`'s own resolve records.
	function compilerOwnedStaticSurface(typeName ByteArray, aliasName ByteArray, nameReader FilePath) returns CompilerOwnedStaticSurface
		// ⭐ **`CharacterSet.letters` IS AN ORDINARY MANGLED STATIC, NOT AN INTERCEPTION.** `stdlib/CharacterSet.maxon` is
		// listed, so all twelve (the eleven presets and `from`) are declared statics on a declared struct and mangle
		// exactly as `Point.create` does.
		// `__ManagedFile.openRead(path)` — the compiler-owned handle type's statics. Intercepted here
		// because the type has a registered LAYOUT but no `type` declaration and no user methods, so the
		// mangled `__ManagedFile.openRead` below would name a callee no file declares.
		for kind in HandleSurface.allCases 'eachHandleSurface'
			if typeName.equals(compilerOwnedSurfaceTypeName(kind)) 'aHandleSurfaceSpelling'
				return CompilerOwnedStaticSurface.handle(kind)
			end 'aHandleSurfaceSpelling'
		end 'eachHandleSurface'

		// `__ManagedMemory.create(count, elementSize)` — intercepted BEFORE the generic-alias arm
		// below, which would route it to `parseArrayStaticCall` (the alias IS bound to an `Array` instance)
		// and refuse its two arguments against `Array.create()`'s none. That is the measured red:
		// `E2010 Expected ')' but got 'integer literal'`.
		// ⚠ **AN ALIAS TO THE BUFFER REACHES THIS DOOR TOO, AND LEAVING IT OUT REPRODUCED THE VERY RED THE
		// PARAGRAPH ABOVE DESCRIBES.** `stdlib/Character.maxon:172` writes `ByteMemory.create(1, 1)` over its
		// own `typealias ByteMemory = __ManagedMemory with Byte`, and a qualifier test that matched only the
		// literal spelling sent it to `parseArrayStaticCall` — `E2010 Expected ')' but got '1'`, the same
		// measured shape one line down, arrived at through the alias instead of through the arm order.
		// `aliasDenotesBufferSurface` is the existing answer to "does this spelling denote the buffer?" and is
		// already what `typeSpellingAtDenotesBuffer` asks in the other position, so this is that one
		// question asked here rather than a second test of it.
		if self.spellingDenotesBufferSurface(typeName, nameReader: nameReader) 'managedMemoryStatic'
			return CompilerOwnedStaticSurface.handle(HandleSurface.memory)
		end 'managedMemoryStatic'

		// ⚠ **`String` HAS NO ARM HERE.** `stdlib/String.maxon` declares `String.from(bytes)` and `String.init(managed)`,
		// so the mangling `resolveUnownedStatic` builds names exactly the corpus functions that serve them.
		// `__ManagedFile`, `__ManagedDirectory`, `__ManagedSocket` and `__ManagedMemory` keep theirs because none has a
		// `type` declaration anywhere, so the mangled name would name a callee no file declares.

		// `IntArray.create()` / `IntSet.create()` / `StrMap.create()` / `PointList.create()`, and
		// `ElementArray.create(0)` for the inner spelling of the same thing
		// — a static call on a BUILTIN-CONTAINER instance alias. Every one is intercepted
		// before the generic-alias → base rewrite `resolveUnownedStatic` makes, which would mangle them to `Array.create` /
		// `Set.create` / `Map.create` / `List.create` — callees no file declares, because no builtin container
		// has a base struct. Their statics lower to their own runtime, not to a user method.
		//
		// ⚠ **THE ALIAS QUESTION IS ASKED ONCE AND THE INSTANCE RESOLVED ONCE**, then the resolved id is tested.
		// Written as self-contained arms it would be two index resolves per container to answer one question, and
		// each new container would add two more — the shape that grows fastest is the one to collapse first.
		//
		// ⛔ ONE ROSTER. A narrower second one is a wrong answer twice over. Claiming `Array` and `List`
		// only leaves a `Set`/`Map` inner alias on a fallthrough that is not a diagnostic: `typealias
		// Nums = Set with ExitCode` inside a type body, then `Nums.create()`, produces a value of type
		// `unknown` and the program is refused for an `insert` on it. Widening to
		// `isBuiltinGenericBaseName` but leaving the NON-builtin fall-through reading a bare member is
		// the identical failure one category over: `typealias IntPair = Pair with ExitCode` then
		// `IntPair.create(9)`, refused for a field access on `unknown`. Two rosters of "which containers
		// does this compiler own", and two keys for one alias, are the same duplication in two columns.
		if self.signatures.isAliasOfFormFor(aliasName, readerFilePath: nameReader, wanted: FormAliasKind.generic) 'containerAliasStatic'
			let aliasGiid = self.signatures.genericAliasInstanceFrom(aliasName, readerFilePath: nameReader)

			if self.signatures.instanceBaseIsSharedValue(aliasGiid) 'sharedValueStatic'
				return CompilerOwnedStaticSurface.sharedValue(aliasGiid)
			end 'sharedValueStatic'

			// ⭐⭐ **AND IT IS A BUILTIN CONTAINER WHOSE `create` THE COMPILER EMITS.** The
			// interception exists because a mangled `Base.create` would name a callee no file declares; the
			// day a listed module declares one, the mangle below IS the right answer and the interception
			// becomes the wrong one. `instanceCreateIsDeclared` is that question's ONE home. `Map`, `Set` and `List` are not in
			// `isBuiltinGenericBaseName`, so they never reach this door; `FixedArray` cannot leave it, because
			// that predicate also decides what `FixedArray with 3 Int` MEANS, so it leaves through the
			// derivation instead.
			if self.signatures.isBuiltinGenericBaseName(self.signatures.genericInstanceBaseName(aliasGiid)) and not self.signatures.instanceCreateIsDeclared(aliasGiid) 'containerStatic'
				return CompilerOwnedStaticSurface.containerAlias(aliasGiid)
			end 'containerStatic'
		end 'containerAliasStatic'

		return CompilerOwnedStaticSurface.none
	end 'compilerOwnedStaticSurface'

	// ⭐⭐ **WHOSE NAME A `<Type>.<member>` CALLS, once the compiler-owned surfaces have declined it or left it
	// to the corpus** — `resolveStaticMember`'s ordinary half. It MOVES NO CURSOR: every door asks with the
	// member only peeked, and the call door hands it to `parseCallNamed`, which consumes it.
	function resolveUnownedStatic(typeTok Token, memberTok Token, aliasName ByteArray, nameReader FilePath, kind StaticBaseKind) returns StaticMemberResolution
		// ⭐⭐ **`int.fromString(s)` / `byte.fromString(s)` — A PRIMITIVE'S STATIC, WHICH IS A FREE FUNCTION IN
		// THE RESERVED SPACE.** THE join site, and the only one: door 1 (`int`/`float`/`bool`, a
		// keyword resolved by `typeBaseTokenAt`) and door 2 (`byte`, a plain identifier that has always flowed
		// through here) converge on the same base token, so one arm serves both. It is intercepted for the
		// reason `CharacterSet` and `String` are one arm up — a primitive has no `type` declaration, so the
		// mangled `int.fromString` below would name a callee no file declares.
		//
		// ⭐ **THE MINT IS GATED ON THE TARGET BEING DECLARED, AND THAT GATE *IS* THE FAILURE PATH.** An
		// unknown member simply does not mint, so the callee stays what the author wrote and every
		// diagnostic downstream names `int.frobnicate` — never `__int_frobnicate`. Rewriting
		// unconditionally would report **E2004 `Undefined function '__int_frobnicate'`**, naming a symbol
		// the author never wrote, so the check that decides whether to rewrite is the same check that
		// keeps the user's own spelling in the message — one question, not a rewrite plus an apology.
		// Where that spelling then goes is the E2073 refusal below.
		//
		// ⚠⚠ **A USER DECLARATION OUTRANKS THE PRIMITIVE READING, AND A DECLARED `type` CONTESTS IT FOR `byte` ALONE.** `type
		// int` is refused at its own name (`E2010: Expected identifier but got 'int'`, measured), so
		// `int.`/`float.`/`bool.` can never be contested by a `type` — but `byte` is an ordinary identifier here, and a
		// `type byte` declaring `static function fromString` COMPILES AND RUNS on this tree today (measured:
		// exit 7). Minting ahead of it would silently re-point a call that already worked at the stdlib body,
		// which is the shape a green suite cannot see. Asked as `declaresCallee` of the SAME mangled name the
		// ordinary path below builds, so the two readings of one call site cannot disagree about what "the
		// user declared it" means. ⭐ **AND ASKING IT OF THAT NAME MAKES A GENERIC ALIAS FALL OUT FOR FREE** —
		// `typealias byte = Box with Num` resolves `byte.fromString` to `Box.fromString` before this test, so a
		// user's own generic instance keeps its static (measured: exit 9) with no arm of its own here.
		//
		// ⛔ **AND THE CLAUSE IS NOT `byte`'s ALONE.** The three KEYWORD qualifiers can name a declaration too:
		// `extension int` can write one, and a `static function make()` in it publishes `int.make`. This
		// clause is what makes that call LINK, by declining to mint `__int_make` for a name the program
		// actually has. The rule is *"a declaration outranks the primitive reading"*, and a premise nobody
		// re-checks is how a guard gets deleted as dead. What the refusal below then answers is a qualifier the
		// author wrote for which NO declaration exists, which is exactly the case it words its sentence for.
		//
		// The order of the two probes is cost: `namesAPrimitiveType` is four `equals` on a short slice and
		// allocates nothing (the discipline the math-intrinsic table measured), while each `declaresCallee`
		// needs a joined name. Every qualified call in the program pays the first; only a primitive-based one
		// pays the rest.
		let declaredCallee = self.denotedStaticCallee(aliasName, member: memberTok.value, nameReader: nameReader)

		if kind == StaticBaseKind.primitive and (not self.signatures.declaresCallee(declaredCallee) or self.primitiveNameIsOnlyDeclaredOutOfSight(typeTok.value)) 'primitiveStatic'
			let minted = primitiveStaticCallee(typeTok.value, methodName: memberTok.value)

			if self.signatures.declaresCallee(minted) 'declaredPrimitiveStatic'
				return StaticMemberResolution.minted(minted)
			end 'declaredPrimitiveStatic'

			if not self.signatures.containsStructFor(typeTok.value, readerFilePath: nameReader) or self.primitiveNameIsOnlyDeclaredOutOfSight(typeTok.value) 'noUserTypeOfThatName'
				if self.signatures.namesANamespace(typeTok.value) 'aDirectoryNamedLikeThePrimitive'
					return StaticMemberResolution.directory(qualifiedMethodName(typeTok.value, methodName: memberTok.value))
				end 'aDirectoryNamedLikeThePrimitive'

				return StaticMemberResolution.refused(primitiveMemberRefusal(typeTok, memberTok: memberTok), readsAsAMethod: false)
			end 'noUserTypeOfThatName'
		end 'primitiveStatic'

		// ⭐ `String.create(…)` — an unknown static on a type name the COMPILER owns. LAST of the doors,
		// so every interception above still wins: it speaks only for a base no file may declare and a member
		// no file does. See `requireCompilerOwnedStaticIsResolvable` for why this one class is the parser's to
		// refuse while a user type's stays SemanticCheck's.
		try requireCompilerOwnedStaticIsResolvable(typeTok, memberTok: memberTok, declaredCallee: declaredCallee, signatures: self.signatures) otherwise (err) 'unresolvableOwnedType'
			return StaticMemberResolution.refused(err, readsAsAMethod: false)
		end 'unresolvableOwnedType'

		// ⭐ **ASKED ONCE AND READ TWICE.** The consume side (which argument OWNS the box being built) and the
		// result side (which instance the value IS) are two halves of one fact; re-deriving each of them
		// from `aliasName` is a second chance to answer the same call site differently,
		// which is what `staticCallClaimsBase`'s own header says about the callee name one door up.
		let registered = declaredCallee
		let declaredByAFile = self.signatures.declaresCallee(registered) or self.signatures.isGenericFunctionKey(registered)

		return StaticMemberResolution.named(registered, declaredByAFile: declaredByAFile)
	end 'resolveUnownedStatic'

	// The order is the precedence. A type parameter first: in its scope `T` names the parameter, whatever
	// top-level type or alias shares the spelling. A directory function next, so a directory named like a
	// primitive or a compiler-owned type reaches its own functions; a type's static of the same key still
	// wins, because `resolvesAsNamespaceQualifiedFunction` declines a key a type method wears.
	function resolveStaticMember(typeTok Token, baseIndex ElementIndex, aliasName ByteArray) returns StaticMemberResolution
		let memberTok = self.tokenAt(baseIndex + TokensPerQualifierSegment)
		let kind = self.staticBaseKindOf(typeTok.value)

		if kind == StaticBaseKind.typeParameter 'aTypeParameterBase'
			return self.typeParameterStatic(typeTok, memberTok: memberTok, baseIndex: baseIndex)
		end 'aTypeParameterBase'

		match self.directoryFunctionNamed(typeTok, memberTok: memberTok) 'directory'
			declared(callee) then return StaticMemberResolution.directory(callee)
			notADirectoryFunction then break
		end 'directory'

		let nameReader = self.typeNameReaderAt(baseIndex)
		let owned = self.compilerOwnedStaticSurface(typeTok.value, aliasName: aliasName, nameReader: nameReader)

		match self.surfaceReach(owned, typeTok: typeTok) 'reach'
			refused(refusal) then return StaticMemberResolution.refused(refusal.clone(), readsAsAMethod: false)
			reachable then break
		end 'reach'

		match owned 'owned'
			none then return self.resolveUnownedStatic(typeTok, memberTok: memberTok, aliasName: aliasName, nameReader: nameReader, kind: kind)
			handle or
			containerAlias or
			sharedValue then break
		end 'owned'

		return match self.surfaceStaticOf(owned, member: memberTok.value, aliasName: aliasName, nameReader: nameReader) 'static'
			emitted gives StaticMemberResolution.surface(owned)
			corpus gives self.resolveUnownedStatic(typeTok, memberTok: memberTok, aliasName: aliasName, nameReader: nameReader, kind: kind)
			absent gives StaticMemberResolution.refused(self.surfaceStaticRefusal(owned, typeTok: typeTok, memberTok: memberTok), readsAsAMethod: self.surfaceDeclaresInstanceMethod(owned, member: memberTok.value))
		end 'static'
	end 'resolveStaticMember'

	function staticBaseKindOf(name ByteArray) returns StaticBaseKind
		if self.namesATypeParameter(name) 'aTypeParameter'
			return StaticBaseKind.typeParameter
		end 'aTypeParameter'

		if namesAPrimitiveType(name) 'aPrimitiveType'
			return StaticBaseKind.primitive
		end 'aPrimitiveType'

		return StaticBaseKind.declaredName
	end 'staticBaseKindOf'

	function typeParameterStatic(typeTok Token, memberTok Token, baseIndex ElementIndex) returns StaticMemberResolution
		return match self.constraintRequirement(typeTok.value, memberTok: memberTok) 'requirement'
			staticDeclaredBy(interfaceName) gives StaticMemberResolution.requirement(interfaceName.clone())
			instanceDeclaredBy(interfaceName) gives StaticMemberResolution.refused(instanceRequirementThroughTypeParameter(self.writtenSpellingOfMemberAt(baseIndex + TokensPerQualifierSegment), interfaceName: interfaceName, typeTok: typeTok, memberTok: memberTok), readsAsAMethod: true)
			unresolved(refusal) gives StaticMemberResolution.refused(refusal.clone(), readsAsAMethod: false)
			notDeclared gives StaticMemberResolution.refused(memberThroughABaseThatNamesNoValue(String.from(typeTok.value), noun: "a type parameter", memberTok: memberTok), readsAsAMethod: false)
		end 'requirement'
	end 'typeParameterStatic'

	function directoryFunctionNamed(headTok Token, memberTok Token) returns DirectoryFunction
		if not self.signatures.namesANamespace(headTok.value) 'notADirectory'
			return DirectoryFunction.notADirectoryFunction
		end 'notADirectory'

		return match self.signatures.resolveFunctionName(joinQualifiedName(headTok.value, member: memberTok.value), readerFilePath: self.job.path) 'resolution'
			declaration(name) gives DirectoryFunction.declared(name)
			undeclared gives DirectoryFunction.notADirectoryFunction
			ambiguous panic("directoryFunctionNamed: a qualified function name resolves to a declaration or to nothing — `resolveQualifiedFunctionName` has no ambiguous answer, and only a bare name can have several visible candidates")
		end 'resolution'
	end 'directoryFunctionNamed'

	function surfaceStaticOf(surface CompilerOwnedStaticSurface, member ByteArray, aliasName ByteArray, nameReader FilePath) returns SurfaceStatic
		return match surface 'surface'
			handle(kind) gives SurfaceStatic.emitted if self.surfaceTableDeclares(kind, member: member) else SurfaceStatic.absent
			containerAlias(giid) gives self.containerStaticOf(giid, member: member, aliasName: aliasName, nameReader: nameReader)
			sharedValue gives SurfaceStatic.emitted if member.equals(RegistryCreateMemberName) else SurfaceStatic.absent
			none panic("surfaceStaticOf: `none` is no compiler-owned surface — every caller opens by routing it to the ordinary resolution")
		end 'surface'
	end 'surfaceStaticOf'

	function surfaceTableDeclares(surface HandleSurface, member ByteArray) returns bool
		return match compilerOwnedStaticNamed(surface, member: member) 'lookup'
			found gives true
			notAStatic gives false
		end 'lookup'
	end 'surfaceTableDeclares'

	function containerStaticOf(giid GenericInstanceId, member ByteArray, aliasName ByteArray, nameReader FilePath) returns SurfaceStatic
		if not self.signatures.isArrayInstance(giid) 'notAnArray'
			return SurfaceStatic.emitted if member.equals(CreateMethod) and self.signatures.instanceHasBuiltinCreate(giid) else SurfaceStatic.absent
		end 'notAnArray'

		return match self.arrayStaticKind(member, aliasName: aliasName, nameReader: nameReader) 'kind'
			builtinCreate or
			builtinInit gives SurfaceStatic.emitted
			corpus gives SurfaceStatic.corpus
			none gives SurfaceStatic.absent
		end 'kind'
	end 'containerStaticOf'

	function denotedStaticCallee(aliasName ByteArray, member ByteArray, nameReader FilePath) returns immutable ByteArray
		return qualifiedMethodName(self.signatures.denotedGenericBaseName(aliasName, readerFilePath: nameReader), methodName: member)
	end 'denotedStaticCallee'

	function arrayStaticKind(member ByteArray, aliasName ByteArray, nameReader FilePath) returns ArrayStaticKind
		let builtin = builtinArrayStaticKind(member)

		if builtin != ArrayStaticKind.none 'aBuiltin'
			return builtin
		end 'aBuiltin'

		if self.signatures.declaresCallee(self.denotedStaticCallee(aliasName, member: member, nameReader: nameReader)) 'corpus'
			return ArrayStaticKind.corpus
		end 'corpus'

		return ArrayStaticKind.none
	end 'arrayStaticKind'

	function surfaceDeclaresInstanceMethod(surface CompilerOwnedStaticSurface, member ByteArray) returns bool
		return match surface 'surface'
			sharedValue gives member.equals(RegistryCurrentMemberName) or member.equals(CloneMethodName) or member.equals(RegistryPublishMemberName)
			handle or
			containerAlias gives false
			none panic("surfaceDeclaresInstanceMethod: `none` is no compiler-owned surface")
		end 'surface'
	end 'surfaceDeclaresInstanceMethod'

	function handleStaticRefusal(surface HandleSurface, memberTok Token) returns SourceParseError
		let member = String.from(memberTok.value)

		// The names and labels are rendered from the constants the two statics are parsed with, so the
		// sentence and the parse agree by construction. `createCursor` is named because it is an INSTANCE
		// method (`dispatchArrayMethod`'s arm), and the cure a reader needs is the spelling.
		if surface == HandleSurface.memory 'theBufferSurface'
			return missingStaticMember("`{String.from(ManagedMemoryTypeName)}` static '{member}' — the statics are `{String.from(compilerOwnedStaticSpelling(CompilerOwnedStatic.memoryCreate))}({String.from(ManagedMemoryCountParamName)}, {String.from(ManagedMemoryElementSizeParamName)})` and `{String.from(compilerOwnedStaticSpelling(CompilerOwnedStatic.memoryFromCString))}({String.from(ManagedMemoryCStringParamName)})`; `{String.from(ManagedMemoryCreateCursorMethod)}` is an INSTANCE method, so write it on a receiver", anchor: memberTok)
		end 'theBufferSurface'

		return missingStaticMember("`{String.from(compilerOwnedSurfaceTypeName(surface))}` static '{member}' — {compilerOwnedStaticRoster(surface)}", anchor: memberTok)
	end 'handleStaticRefusal'

	function surfaceStaticRefusal(surface CompilerOwnedStaticSurface, typeTok Token, memberTok Token) returns SourceParseError
		return match surface 'surface'
			handle(kind) gives self.handleStaticRefusal(kind, memberTok: memberTok)
			containerAlias(giid) gives self.containerStaticRefusal(giid, memberTok: memberTok)
			sharedValue gives undeclaredStaticMember(typeTok, memberTok: memberTok)
			none panic("surfaceStaticRefusal: `none` is no compiler-owned surface")
		end 'surface'
	end 'surfaceStaticRefusal'

	// ⚠ **THE `Array` REFUSAL NAMES WHAT THE COMPILER PROVIDES, AND KEEPING IT CURRENT IS NOT COSMETIC**: a
	// reader trusts a refusal's NOUN over the source, and a stale one sends them looking for a mechanism that
	// is one line away.
	function containerStaticRefusal(giid GenericInstanceId, memberTok Token) returns SourceParseError
		if self.signatures.isArrayInstance(giid) 'array'
			return missingStaticMember("`Array` static method '{String.from(memberTok.value)}' — the compiler provides two: `create()` and `init(managed)`", anchor: memberTok)
		end 'array'

		return missingStaticMember(self.containerStaticSurfaceSentence(giid, method: memberTok.value), anchor: memberTok)
	end 'containerStaticRefusal'

	// The ORDINARY static call — `File.readText(p)`, `StrBox.create(s)`. Split out so `parseQualifiedCall`'s
	// callee match keeps one statement per arm; the constructor half is what makes it more than a call, and
	// `ConstructorInstance` carries why.
	function parseDeclaredStaticCall(func IrFunction, callee ByteArray, aliasName ByteArray, typeTok Token, memberTok Token, resultUsed bool, mint CalleeMint) returns ValueId throws SourceParseError
		let constructed = self.constructorInstanceOf(aliasName)

		if not self.createDecidesItsElementGate(constructed, memberTok: memberTok) 'theGateIsAskedHere'
			try self.requireConstructedFixedArrayElementType(constructed, aliasTok: typeTok)
		end 'theGateIsAskedHere'

		if let built = try self.instanceBuiltByCreate(constructed, memberTok: memberTok) 'aCreate'
			if self.signatures.isFixedArrayInstance(built) 'aFixedArrayCreate'
				if self.fixedArrayStatesItsCount(built) and self.atValueLabel(self.pos + 2) 'aTypeSizedValueFilledCreate'
					return try self.parseTypeSizedFixedArrayCreate(func, giid: built, aliasTok: typeTok, aliasName: aliasName)
				end 'aTypeSizedValueFilledCreate'

				match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: built as TypeNameId) 'lengthSource'
					inTheRecord then return try self.parseRuntimeSizedFixedArrayCreate(func, giid: built, aliasTok: typeTok, aliasName: aliasName)
					stated(count) then try self.requireTypeSizedCreateTakesNoLength(built, count: count, aliasTok: typeTok, memberTok: memberTok)
					callerSlot then break
				end 'lengthSource'
			end 'aFixedArrayCreate'
		end 'aCreate'

		// ⭐⭐ **A BARE GENERIC BASE NAMED FROM A NON-GENERIC SCOPE HAS NO OTHER SOURCE FOR ITS TYPE
		// ARGUMENTS.** `constructorInstanceOf` answers from a generic ALIAS or from the enclosing type's
		// parameters, and `Outer.create(1 as Whole)` written in `main` has neither — so only the factory's own
		// arguments can fix them. A value at the base `structRef` fixes nothing, which means no layout
		// descriptor and no synthesized `__destruct_<instance>` for what it builds.
		//
		// ⚠ **A MISS KEEPS THE SUPPLIED ANSWER.** An inference that cannot fix every parameter hands
		// `constructed` back untouched. A miss is a diagnostic at a `spawn`, where the instantiation is the
		// whole point, and here only when the result is written over a parameter it left unfixed
		// (`requireBareGenericResultIsTyped`), since such a result has no type.
		let result = try self.parseCallNamed(func, callee: callee, anchor: memberTok, receiver: ReceiverArg.none, resultUsed: resultUsed, constructorInstance: constructed, mint: mint, inferInstanceOf: self.bareGenericFactoryBase(constructed, typeTok: typeTok))

		match constructed 'constructed'
			none then break
			instance(gid) then self.retypeGenericAliasConstructorResult(result, gid: gid, aliasName: aliasName)
		end 'constructed'

		return result
	end 'parseDeclaredStaticCall'

	function instanceBuiltByCreate(constructed ConstructorInstance, memberTok Token) returns GenericInstanceId throws AbsentError
		if not memberTok.value.equals(CreateMethod) 'notCreate'
			throw AbsentError.absent
		end 'notCreate'

		match constructed 'constructed'
			none then throw AbsentError.absent
			instance(gid) then return gid
		end 'constructed'
	end 'instanceBuiltByCreate'

	function requireTypeSizedCreateTakesNoLength(giid GenericInstanceId, count FixedElementCount, aliasTok Token, memberTok Token) throws SourceParseError
		if self.kindAt(self.pos + 1) != TokenKind.leftParen or self.kindAt(self.pos + 2) == TokenKind.rightParen 'noArgument'
			return
		end 'noArgument'

		throw typeSizedCreateTakesALength(String.from(aliasTok.value), sized: "{String.from(FixedArrayBuiltinBaseName)} with {count} {self.signatures.arrayElementDisplayName(giid)}", memberTok: memberTok)
	end 'requireTypeSizedCreateTakesNoLength'

	function parseRuntimeSizedFixedArrayCreate(func IrFunction, giid GenericInstanceId, aliasTok Token, aliasName ByteArray) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(aliasTok, last: methodTok)
		try self.consume(TokenKind.leftParen)

		if self.at(TokenKind.rightParen) or self.atValueLabel(self.pos) 'noLength'
			throw runtimeSizedCreateNeedsALength(String.from(aliasTok.value), memberTok: methodTok)
		end 'noLength'

		let lengthTok = self.current()
		let length = try self.parseCreateLengthArg(func, lengthOwner: self.signatures.arrayRecordBaseName(), paramName: FixedArrayCreateLengthName, aliasTok: aliasTok)
		let fill = try self.parseCreateFillArg(func, giid: giid, memberTok: methodTok)
		try self.requireFillElementType(giid, fill: fill, aliasTok: aliasTok)

		if self.at(TokenKind.comma) 'anotherArgument'
			throw runtimeSizedCreateTakesALengthAndAValue(String.from(aliasTok.value), memberTok: methodTok)
		end 'anotherArgument'

		try self.consume(TokenKind.rightParen)

		if self.constIsKnown(length) and self.constOf(length) >= 0 'aNonNegativeConstant'
			if self.constOf(length) >= (MinFixedElementCount as FullRangeInt) and self.constOf(length) <= (MaxFixedElementCount as FullRangeInt) 'aUsableCount'
				let sized = self.signatures.fixedArrayInstanceForElement(self.signatures.containerElementType(giid), size: self.constOf(length) as FixedElementCount)
				let record = try self.emitOwnedContainerRecord(sized, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: ValueIdArray.create(0))

				try self.emitCreateFill(func, record: record, giid: giid, fill: fill, count: length, anchor: methodTok, range: range)

				return record
			end 'aUsableCount'

			self.recordSizedBaseCountRefusal(lengthTok, fault: "create's length is the constant {self.constOf(length)}")
		end 'aNonNegativeConstant'

		let record = try self.emitOwnedContainerCreate(giid, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: twoArgs(length, second: length))

		try self.emitCreateFill(func, record: record, giid: giid, fill: fill, count: length, anchor: methodTok, range: range)

		return record
	end 'parseRuntimeSizedFixedArrayCreate'

	function parseTypeSizedFixedArrayCreate(func IrFunction, giid GenericInstanceId, aliasTok Token, aliasName ByteArray) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(aliasTok, last: methodTok)
		try self.consume(TokenKind.leftParen)

		if not self.atValueLabel(self.pos) 'noValueFirst'
			throw typeSizedCreateTakesALength(String.from(aliasTok.value), sized: "{String.from(FixedArrayBuiltinBaseName)} with {self.statedFixedCountOf(giid)} {self.signatures.arrayElementDisplayName(giid)}", memberTok: methodTok)
		end 'noValueFirst'

		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.colon)

		let fill = CreateFill.filled(try self.parseCreateFillValue(func, giid: giid, methodTok: methodTok))
		try self.requireFillElementType(giid, fill: fill, aliasTok: aliasTok)

		if self.at(TokenKind.comma) 'anotherArgument'
			throw typeSizedCreateTakesALength(String.from(aliasTok.value), sized: "{String.from(FixedArrayBuiltinBaseName)} with {self.statedFixedCountOf(giid)} {self.signatures.arrayElementDisplayName(giid)}", memberTok: methodTok)
		end 'anotherArgument'

		try self.consume(TokenKind.rightParen)

		let record = try self.emitOwnedContainerRecord(giid, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: ValueIdArray.create(0))
		self.brandValue(record, brand: self.brandOfSpelling(aliasName, readerFilePath: self.job.path))
		self.markFreshWhenInputsClean(record, inputs: ValueIdArray.create(0))

		try self.emitCreateFill(func, record: record, giid: giid, fill: fill, count: try self.fixedElementCountValue(giid, anchor: aliasTok), anchor: methodTok, range: range)

		return record
	end 'parseTypeSizedFixedArrayCreate'

	function statedFixedCountOf(giid GenericInstanceId) returns FixedElementCount
		match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: giid as TypeNameId) 'source'
			stated(count) then return count
			inTheRecord or
			callerSlot then panic("statedFixedCountOf: only a type-sized fixed array states its count, and the caller has established that this one does")
		end 'source'
	end 'statedFixedCountOf'

	function atValueLabel(index ElementIndex) returns bool
		return self.kindAt(index) == TokenKind.identifier and self.kindAt(index + 1) == TokenKind.colon and self.tokenAt(index).value.equals(ManagedMemoryValueParamName)
	end 'atValueLabel'

	function requireFillElementType(giid GenericInstanceId, fill CreateFill, aliasTok Token) throws SourceParseError
		match fill 'fillKind'
			unfilled then try self.requireSizedContainerElementType(giid, aliasTok: aliasTok)
			filled then try self.requireFixedArrayElementType(giid, tok: aliasTok)
		end 'fillKind'
	end 'requireFillElementType'

	function createDecidesItsElementGate(constructed ConstructorInstance, memberTok Token) returns bool
		let built = try self.instanceBuiltByCreate(constructed, memberTok: memberTok) otherwise return false

		if not self.signatures.isFixedArrayInstance(built) 'notAFixedArray'
			return false
		end 'notAFixedArray'

		return match self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: built as TypeNameId) 'lengthSource'
			inTheRecord gives true
			stated gives self.atValueLabel(self.pos + 2)
			callerSlot gives false
		end 'lengthSource'
	end 'createDecidesItsElementGate'

	function parseCreateFillArg(func IrFunction, giid GenericInstanceId, memberTok Token) returns CreateFill throws SourceParseError
		if not self.at(TokenKind.comma) or not self.atArgLabel(self.pos) or not self.tokenAt(self.pos + 1).value.equals(ManagedMemoryValueParamName) 'noValue'
			return CreateFill.unfilled
		end 'noValue'

		try self.consumeArrayArgLabel(ManagedMemoryValueParamName, required: true)

		return CreateFill.filled(try self.parseCreateFillValue(func, giid: giid, methodTok: memberTok))
	end 'parseCreateFillArg'

	function parseCreateFillValue(func IrFunction, giid GenericInstanceId, methodTok Token) returns ValueId throws SourceParseError
		let valueStart = self.pos
		self.stateContainerElementLiteralTargets(giid, valueStart: valueStart)
		let raw = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let checked = try self.requireContainerElementType(giid, value: raw, valueStart: valueStart, methodTok: methodTok)

		return self.containerElementWord(checked, giid: giid, range: SourceRange.ofToken(self.tokenAt(valueStart)))
	end 'parseCreateFillValue'

	function emitCreateFill(func IrFunction, record ValueId, giid GenericInstanceId, fill CreateFill, count ValueId, anchor Token, range SourceRange) throws SourceParseError
		match fill 'fillKind'
			unfilled then return
			filled(word) then try self.emitFillCall(func, record: record, giid: giid, count: count, word: word, anchor: anchor, range: range)
		end 'fillKind'
	end 'emitCreateFill'

	function emitFillCall(func IrFunction, record ValueId, giid GenericInstanceId, count ValueId, word ValueId, anchor Token, range SourceRange) throws SourceParseError
		if self.signatures.containerElementIsManaged(giid) or self.signatures.containerElementIsOpaque(giid) 'anOwnedElement'
			try self.emitContainerLiteralElement(self.signatures.genericInstanceBaseName(giid), method: RefillMethod, container: record, value: word, anchor: anchor, range: range)
			return
		end 'anOwnedElement'

		let start = self.emitLiteral(0, valueType: MaxonType.integer, range: range)
		let targetOpFloor = self.artifact.module.ops.count()
		let targetDeferralFloor = self.artifact.deferredChains.count()
		let savedRouteClaim = self.swapClaim(ThrowRouteClaim.everyDestination)
		let applied = self.emitRuntimeCall(ManagedFillName, args: fourArgs(record, second: start, third: count, fourth: word), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		self.restoreClaim(savedRouteClaim)
		let (_, refused) = try self.rewriteLastCallToTryCall(applied, tryTok: anchor, targetDeferralFloor: targetDeferralFloor, targetOpFloor: targetOpFloor)

		self.emitPanicBranch(func, condition: refused, panicLine: panicMessageLine(self.job.path, line: anchor.line, text: FillRefusedPanicText), panicLabel: FillRefusedPanicBlockLabel, continueLabel: FilledBlockLabel, opTok: anchor)
	end 'emitFillCall'

	// The base an ordinary static call may INFER an instantiation for: a written type name that declares type
	// parameters and that no alias or enclosing scope has already fixed. `FactoryInference.none` for
	// every other call, which is what keeps the inference off every road that already has an answer.
	function bareGenericFactoryBase(constructed ConstructorInstance, typeTok Token) returns FactoryInference
		match constructed 'constructed'
			instance then return FactoryInference.none
			none then break
		end 'constructed'

		return FactoryInference.of(typeTok.value) if self.signatures.structDeclaresTypeParams(typeTok.value) else FactoryInference.none
	end 'bareGenericFactoryBase'

	// ⚖ **A GENERIC BASE NOTHING BINDS HAS NO INSTANCE BEHIND IT (E3162).** `Box uses Element` named inside
	// `type Outer uses T` is the base: a `T` stored through it is released by nothing, because
	// `Outer with String`'s drop reaches the field through the base's own opaque `Element`; and a layout-needing
	// callee could be handed only this frame's descriptor, which describes `Outer`'s parameters and not `Box`'s.
	// Binding the base to the scope by POSITION is rejected on purpose (the scoped-name rule binds by name), so
	// the author names `Box with T` in a `typealias`. Outside a generic type body there is no scope to feed, and
	// a layout-needing call — static or through a receiver — is refused where the frame has no descriptor of its
	// own to hand on.
	//
	// Asked after the factory inference, because arguments that fix every parameter to a concrete type build
	// that instance and leave no bare subject; and before the result is minted, so a refused call emits nothing.
	function requireBareGenericSubjectIsBound(callee ByteArray, args ValueIdArray, argLabels NameRoster, constructed ConstructorInstance, inferInstanceOf FactoryInference, anchor Token) throws SourceParseError
		if self.enclosingTypeParams.isEmpty() 'nothingTheFrameCanFeed'
			return
		end 'nothingTheFrameCanFeed'

		// An instance method named statically (`FixedArray.get(v, index: 1)`) takes its receiver as the first argument,
		// and that value, not the written base, is the subject.
		if let base = try inferInstanceOf.baseName() 'aFactoryOfAGenericBase'
			if self.signatures.calleeReceiverOf(callee) != CalleeReceiver.takesReceiver 'aStaticCallOnAGenericBase'
				match constructed 'arguments'
					instance then return
					none then try self.requireBareGenericBaseIsBound(base, callee: callee, args: args, argLabels: argLabels, anchor: anchor)
				end 'arguments'

				return
			end 'aStaticCallOnAGenericBase'
		end 'aFactoryOfAGenericBase'

		if args.isEmpty() 'noArguments'
			return
		end 'noArguments'

		let first = try args.get(0) otherwise panic("requireBareGenericSubjectIsBound: args.get(0) on a non-empty list")

		if self.tagOf(first) != ValueTypeTag.structRef 'firstArgumentIsNoBase'
			return
		end 'firstArgumentIsNoBase'

		if self.signatures.calleeReceiverOf(callee) == CalleeReceiver.takesReceiver 'aReceiverCall'
			try self.requireBareGenericBaseIsBound(self.internedName(self.valueNameId(first)), callee: callee, args: args, argLabels: argLabels, anchor: anchor)
		end 'aReceiverCall'
	end 'requireBareGenericSubjectIsBound'

	function staticReadsItsCount(callee ByteArray) returns bool
		if self.signatures.calleeReceiverOf(callee) == CalleeReceiver.takesReceiver or isFieldDefaultHelperName(callee) 'theCountHasAnotherSource'
			return false
		end 'theCountHasAnotherSource'

		return self.signatures.functionReadsFixedElementCount(callee)
	end 'staticReadsItsCount'

	function requireACountSourceForAStaticCall(callee ByteArray, constructed ConstructorInstance, anchor Token) throws SourceParseError
		if not self.signatures.anyFunctionReadsFixedElementCount() or not self.staticReadsItsCount(callee) 'theCountHasAnotherSource'
			return
		end 'theCountHasAnotherSource'

		let source = match constructed 'qualifier'
			instance(gid) gives self.signatures.elementCountSourceOf(ValueTypeTag.genericInstance, nameId: gid as TypeNameId)
			none gives ElementCountSource.callerSlot
		end 'qualifier'

		match source 'qualifierSource'
			stated then return
			inTheRecord then throw SourceParseError.unsupported("calling '{String.from(unqualifiedMemberOf(callee))}' (which reads `countof` of the sized container's own `Self`) through the name of a runtime-sized fixed array, whose length is the value's and not the type's — a `static function` has no value to read it from. Name a sized instance with a typealias (`FixedArray with 3 Int`) and call it through that, or call it from a method of the sized container", line: anchor.line, column: anchor.column)
			callerSlot then break
		end 'qualifierSource'

		if self.signatures.calleeReturnsItsDeclaringType(callee) 'theResultStatesIt'
			return
		end 'theResultStatesIt'

		match self.bodyState.fixedElementCountParam 'hasOneToForward'
			slot or
			enclosingThroughEnv then return
			none then break
		end 'hasOneToForward'

		throw SourceParseError.unsupported("calling '{String.from(unqualifiedMemberOf(callee))}' (which reads `countof` of the sized container's own `Self`) through a name that states no element count, from a function that carries no fixed-element-count parameter of its own to forward — a `static function` that does not return `Self` takes the count from the instance its call names. Name a sized instance with a typealias (`FixedArray with 3 Int`) and call it through that, or call it from a method of the sized container", line: anchor.line, column: anchor.column)
	end 'requireACountSourceForAStaticCall'

	function requireBareGenericBaseIsBound(base ByteArray, callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token) throws SourceParseError
		// The scope's own name means `Self`, whose descriptor this frame does carry.
		if self.namesEnclosingType(base) or not self.signatures.structDeclaresTypeParams(base) 'notABareGenericBase'
			return
		end 'notABareGenericBase'

		if self.bareGenericBaseIsFedAnEnclosingParameter(base, callee: callee, args: args, argLabels: argLabels) 'fed'
			throw self.bareGenericSubjectRefusal(base, callee: callee, use: BareGenericSubjectUse.fedAnEnclosingParameter, anchor: anchor)
		end 'fed'
	end 'requireBareGenericBaseIsBound'

	// ⚠ **A CALLEE IS FED ONLY IF THE DECLARATION ITS ARGUMENTS FILL IS.**
	// The declaration judged is the one `declarationNameableHere` answers, and a refusal resting on a
	// declaration the call cannot mean refuses a legal call, so it is judged only where its arity and
	// labels fit the call (`memberFeed`).
	function bareGenericBaseIsFedAnEnclosingParameter(base ByteArray, callee ByteArray, args ValueIdArray, argLabels NameRoster) returns bool
		let decl = try self.declarationNameableHere(callee) otherwise return false
		return self.memberFeed(base, decl: decl, args: args, argLabels: argLabels) == MemberFeed.fed
	end 'bareGenericBaseIsFedAnEnclosingParameter'

	function memberFeed(base ByteArray, decl SweptDeclaration, args ValueIdArray, argLabels NameRoster) returns MemberFeed
		match slotCallArgs(sweptSlotNames(decl), args: args, argLabels: argLabels) 'slot'
			ordered(slotted) then return self.slottedMemberFeed(base, decl: decl, slotted: slotted)

			// A label no parameter carries, or a count no parameter list takes, is the argument check's refusal.
			refused then return MemberFeed.unfilled
		end 'slot'
	end 'memberFeed'

	// Inside a generic type body a value that is not fully concrete is one written over the enclosing type's
	// parameters. A parameter type the sweep could not read cannot refuse the member, so it is not judged.
	function slottedMemberFeed(base ByteArray, decl SweptDeclaration, slotted ValueIdArray) returns MemberFeed
		var fed = false

		for i in 0 upto decl.paramTypes.count() 'eachUserParam'
			let swept = try decl.paramTypes.get(i) otherwise panic("slottedMemberFeed: paramTypes.get OOB at {i} inside its own count()")

			if maxonTypeTag(swept) == ValueTypeTag.unresolved 'theSweepDidNotReadThisParameterType'
				continue
			end 'theSweepDidNotReadThisParameterType'

			let declared = self.sweptParamType(swept, scopeFilePath: decl.declFilePath)
			let position = callPositionOfColumn(decl.takesReceiver, column: i as ParamCount)
			let argument = try slotted.get(position) otherwise panic("slottedMemberFeed: slotted.get OOB at column {i} — `slotCallArgs` answered `ordered`, so the counts agree")

			if self.typeIsWrittenOverTheBase(declared, base: base) 'aSlotOfTheBase'
				fed = fed or not self.signatures.argIsFullyConcrete(self.typeOf(argument))
			end 'aSlotOfTheBase'
		end 'eachUserParam'

		return MemberFeed.fed if fed else MemberFeed.notFed
	end 'slottedMemberFeed'

	// Does `declared` mention one of `base`'s own type parameters — the parameter itself, or an instance written
	// over one at any depth?
	function typeIsWrittenOverTheBase(declared MaxonType, base ByteArray) returns bool
		let tag = maxonTypeTag(declared)

		if tag == ValueTypeTag.genericInstance 'anInstance'
			let id = genericInstanceIdOf(declared)

			for position in 0 upto self.signatures.genericInstanceArgCount(id) 'eachArgument'
				if self.typeIsWrittenOverTheBase(self.signatures.substitutedInstanceArg(id, position: position), base: base) 'overTheBase'
					return true
				end 'overTheBase'
			end 'eachArgument'

			return false
		end 'anInstance'

		if tag != ValueTypeTag.typeParameter 'aConcreteLeaf'
			return false
		end 'aConcreteLeaf'

		let token = typeParamIdOf(declared)

		for paramName in self.signatures.structTypeParamsOf(base) 'eachParam'
			if typeParamTokenFor(base, paramName: paramName) == token 'declaredByTheBase'
				return true
			end 'declaredByTheBase'
		end 'eachParam'

		return false
	end 'typeIsWrittenOverTheBase'

	// ⚠ **THE REMEDY IS A `typealias`, BECAUSE A `with` INSTANCE IS SPELLED IN ONE** — a field typed
	// `Box with T` inline does not parse.
	function bareGenericSubjectRefusal(base ByteArray, callee ByteArray, use BareGenericSubjectUse, anchor Token) returns SourceParseError
		return SourceParseError.bareGenericSubjectUnbound(bareGenericSubjectSentence(self.signatures, base: base, callee: callee, use: use, scopeTypeName: self.enclosingTypeNameOrEmpty(), scopeParams: self.enclosingTypeParams), line: anchor.line, column: anchor.column)
	end 'bareGenericSubjectRefusal'

	function requireBareGenericResultIsTyped(result ValueId, callee ByteArray, constructed ConstructorInstance, inferInstanceOf FactoryInference, anchor Token) throws SourceParseError
		let base = try inferInstanceOf.baseName() otherwise return

		if self.namesEnclosingType(base) 'theEnclosingInstanceTypesIt'
			return
		end 'theEnclosingInstanceTypesIt'

		match constructed 'instance'
			instance then return
			none then break
		end 'instance'

		if self.signatures.calleeReceiverOf(callee) == CalleeReceiver.takesReceiver 'theReceiverNamesTheInstance'
			return
		end 'theReceiverNamesTheInstance'

		if self.typeIsWrittenOverTheBase(self.typeOf(result), base: base) 'theResultHasNoType'
			throw self.bareGenericSubjectRefusal(base, callee: callee, use: BareGenericSubjectUse.resultTypedAtAnUnboundParameter, anchor: anchor)
		end 'theResultHasNoType'
	end 'requireBareGenericResultIsTyped'

	function parseQualifiedCall(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		// `Self.create(…)` reaches here as `Point.create(…)` — `consumeTypeBaseToken` resolved the keyword, so
		// the callee mangling, the alias interceptions and the E3062 use hook below all see one spelling.
		let baseIndex = self.pos
		let typeTok = try self.consumeTypeBaseToken()

		if self.namesReplyLater(typeTok) 'replyLater'
			return try self.parseReplyLater(func, replyTok: typeTok, baseIndex: baseIndex)
		end 'replyLater'

		// A `Type.method()` base NAMES a type, so it is a USE for the E3062 check — and it is the only
		// place many generic-instance aliases are ever named (`IntArray.create()`). It never reaches
		// `parseTypeReference`, which is why this second hook exists at all (`recordTypeNameUse`).
		self.recordBaseTypeNameUse(baseIndex, resolved: typeTok)

		if self.signatures.declaresADefault() and self.registryCallAt(self.pos - 1) 'aRegistryCall'
			return try self.parseRegistryCall(func, keyTok: typeTok, resultUsed: resultUsed)
		end 'aRegistryCall'

		// ⭐⭐ **THE GENERIC ALIAS THIS CALL'S BASE NAMES, RESOLVED ONCE — file-scope (`IntBox`) or INNER
		// (`Plain.IntPair`) — and all FOUR of this routine's alias-driven decisions read THIS name rather than
		// the written token:** the builtin-container interception below, the base a static mangles onto
		// (`denotedGenericBaseName`), the instance a constructor builds (`constructorInstanceOf`), and the type
		// its result adopts (`retypeGenericAliasConstructorResult`). Which registration a written name denotes
		// is `genericAliasKeyFor`'s alone — recognizing the inner spelling here and dropping it for the other
		// three is exactly how one call site comes to hold two readings of one alias.
		let aliasName = self.genericAliasKeyFor(typeTok.value)

		if self.aliasDenotesARefusedInstance(aliasName) 'aRefusedInstance'
			return try self.deferredUnresolvedMemberResult(func)
		end 'aRefusedInstance'

		let resolved = self.staticMemberResolutionAt(typeTok, baseIndex: baseIndex, aliasName: aliasName)

		match resolved 'member'
			surface(owned) then return try self.parseOwnedStaticCall(func, owned: owned, typeTok: typeTok, aliasName: aliasName)
			refused(refusal, _) then throw refusal
			minted or
			named or
			directory or
			requirement then break
		end 'member'

		try self.consume(TokenKind.dot)
		return try self.parseStaticMemberCall(func, typeTok: typeTok, aliasName: aliasName, resolved: resolved, resultUsed: resultUsed)
	end 'parseQualifiedCall'

	function namesARefusedInstance(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.genericInstance and self.defersOnRefusedInstance(nameId as GenericInstanceId)
	end 'namesARefusedInstance'

	// A use of a refused instance defers and reports nothing, leaving the alias's E2015 as the one
	// report; `FoldLedger.requireEveryDeferralExplained` panics on a deferral in a program that
	// reports no error.
	function defersOnRefusedInstance(id GenericInstanceId) returns bool
		if not self.signatures.allFilesFolded 'theSweepRefusesNothing'
			return false
		end 'theSweepRefusesNothing'

		let refused = self.refusedInstanceAnswer(id)

		if refused 'aDeferralIsMade'
			self.artifact.refusedInstanceDeferrals = self.artifact.refusedInstanceDeferrals + 1
		end 'aDeferralIsMade'

		return refused
	end 'defersOnRefusedInstance'

	function refusedInstanceAnswer(id GenericInstanceId) returns bool
		if let known = try self.refusedInstances.get(id) 'answeredAlready'
			return known
		end 'answeredAlready'

		let answer = self.signatures.genericInstanceIsRefused(id)
		self.refusedInstances.upsert(id, value: answer)

		return answer
	end 'refusedInstanceAnswer'

	function deferredWhenRefused(declared MaxonType) returns MaxonType
		let denoted = self.resolveNamedAlias(declared, scopeFilePath: self.job.path)

		if self.namesARefusedInstance(maxonTypeTag(denoted), nameId: typeNameIdOf(denoted)) 'aRefusedInstance'
			return MaxonType.unresolved
		end 'aRefusedInstance'

		return self.deferredWhenUnknown(declared, scopeFilePath: self.job.path)
	end 'deferredWhenRefused'

	function deferredWhenUnknown(declared MaxonType, scopeFilePath FilePath) returns MaxonType
		if self.declaredTypeIsUnknown(declared, scopeFilePath: scopeFilePath) 'anUnknownType'
			return MaxonType.unresolved
		end 'anUnknownType'

		return declared
	end 'deferredWhenUnknown'

	function declaredTypeIsUnknown(declared MaxonType, scopeFilePath FilePath) returns bool
		let tag = maxonTypeTag(declared)

		if tagIsUnresolved(tag) 'alreadyDeferred'
			return true
		end 'alreadyDeferred'

		if not self.signatures.allFilesFolded or tag != ValueTypeTag.named 'nothingToJudge'
			return false
		end 'nothingToJudge'

		let id = typeNameIdOf(declared)

		return declaredNameDenotesNothing(self.signatures, name: self.internedName(id), id: id, readerFilePath: scopeFilePath)
	end 'declaredTypeIsUnknown'

	function aliasDenotesARefusedInstance(aliasName ByteArray) returns bool
		if not self.signatures.isAliasOfFormFor(aliasName, readerFilePath: self.job.path, wanted: FormAliasKind.generic) 'notAnInstanceAlias'
			return false
		end 'notAnInstanceAlias'

		return self.defersOnRefusedInstance(self.signatures.genericAliasInstanceFrom(aliasName, readerFilePath: self.job.path))
	end 'aliasDenotesARefusedInstance'

	function staticMemberResolutionAt(typeTok Token, baseIndex ElementIndex, aliasName ByteArray) returns StaticMemberResolution
		if self.statement.handedResolution.handsOverAt(baseIndex) 'handedByThePredicate'
			let handed = self.statement.handedResolution.held()
			self.statement.handedResolution = NothingHanded

			return handed
		end 'handedByThePredicate'

		return self.resolveStaticMember(typeTok, baseIndex: baseIndex, aliasName: aliasName)
	end 'staticMemberResolutionAt'

	function parseOwnedStaticCall(func IrFunction, owned CompilerOwnedStaticSurface, typeTok Token, aliasName ByteArray) returns ValueId throws SourceParseError
		match owned 'surface'
			handle(kind) then return try self.parseCompilerOwnedStatic(func, surface: kind, typeTok: typeTok)
			containerAlias(giid) then return try self.parseContainerAliasStaticCall(func, aliasTok: typeTok, aliasName: aliasName, giid: giid)
			sharedValue(giid) then return try self.parseSharedValueCreate(func, typeTok: typeTok, giid: giid)
			none then panic("parseOwnedStaticCall: `none` is no compiler-owned surface — `resolveStaticMember` answers `surface` only for one")
		end 'surface'
	end 'parseOwnedStaticCall'

	// The `<member>(…)` of a `Type.member(…)` call whose base no compiler-owned surface claimed, the cursor past
	// the dot — or of a container alias's member the compiler emits no code for (`parseArrayStaticCall`).
	function parseStaticMemberCall(func IrFunction, typeTok Token, aliasName ByteArray, resolved StaticMemberResolution, resultUsed bool) returns ValueId throws SourceParseError
		// PEEKED, not consumed: `parseCallNamed` consumes its own callee token (`dispatchMethodOnBase` says
		// so where it hands the cursor over), and consuming it here would leave the arguments to a second
		// reader.
		let memberTok = self.current()

		match resolved 'callee'
			minted(minted) then return try self.parseCallNamed(func, callee: minted, anchor: memberTok, receiver: ReceiverArg.none, resultUsed: resultUsed, constructorInstance: ConstructorInstance.none, mint: CalleeMint.primitiveStatic)
			named or
			directory then return try self.parseDeclaredStaticCall(func, callee: resolved.calleeToCall(), aliasName: aliasName, typeTok: typeTok, memberTok: memberTok, resultUsed: resultUsed, mint: self.staticCallHeadMint(self.pos - TokensPerQualifierSegment, typeTok: typeTok))
			requirement then throw staticRequirementCalled(self.writtenSpellingOfMemberAt(self.pos), typeTok: typeTok, memberTok: memberTok)
			refused(refusal, _) then throw refusal
			surface then panic("parseStaticMemberCall: a compiler-owned surface is dispatched by `parseOwnedStaticCall`, which has already consumed the member")
		end 'callee'
	end 'parseStaticMemberCall'

	// The concrete instance a `Type.method(…)` call constructs — an `instance(gid)` when `Type` is
	// a generic-instance alias (`StrBox`), so the caller-side consume can move its managed arguments into the
	// owning box; `none` for a plain type's static method. It reads the whole-program index, complete in the
	// real parse (during the tolerant sweep `isGenericAlias` answers no, so the consume simply does not fire —
	// which is sound: the sweep's artifact is discarded).
	//
	// ⭐ **A BARE GENERIC TYPE NAME INSIDE A TYPE-PARAMETER SCOPE IS THE SECOND WAY A BASE NAMES AN INSTANCE
	//** — `Inner.make(items)` written in `type Outer uses T` builds an `Inner with Outer.T`. It is the
	// same question as the alias arm's and gets the same answer shape, so the two live at one door: what
	// differs is only where the ARGUMENTS come from, a `typealias`'s written list or the enclosing scope's
	// parameters. See `bareGenericInstanceInScope` for the binding rule and for why the caller-side gate is
	// spelled here.
	function constructorInstanceOf(baseName ByteArray) returns ConstructorInstance
		if self.signatures.isAliasOfFormFor(baseName, readerFilePath: self.job.path, wanted: FormAliasKind.generic) 'genericAlias'
			return ConstructorInstance.instance(self.signatures.genericAliasInstanceFrom(baseName, readerFilePath: self.job.path))
		end 'genericAlias'

		if self.enclosingTypeParams.count() == 0 'noTypeParameterScope'
			return ConstructorInstance.none
		end 'noTypeParameterScope'

		return self.bareGenericInstanceInScope(baseName)
	end 'constructorInstanceOf'

	// ⭐⭐ **THE INSTANTIATION A FACTORY CALL ON A BARE GENERIC BASE STARTS, READ OFF ITS ARGUMENTS.** Two
	// roads reach it and they differ only in what a MISS means: a `spawn` names a bare generic type and
	// cannot name an alias — the whole-program walk that decides which types are services reads raw tokens
	// with no scope to resolve one (`Queries.serviceSpawnFollowing`) — so there the arguments are the
	// only thing that can fix `T` and a miss is a refusal; an ordinary static call keeps the base `structRef`
	// it would otherwise have had.
	//
	// `constructorInstanceOf`'s third road, and deliberately not an arm of it: that door answers from the
	// BASE NAME alone and is asked before any argument exists.
	function spawnFactoryConstructorInstance(supplied ConstructorInstance, inferInstanceOf FactoryInference, callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token, serviceSite ServiceSpawnSite) returns ConstructorInstance throws SourceParseError
		let base = try inferInstanceOf.baseName() otherwise return supplied

		let params = self.signatures.structTypeParamsOf(base)

		if params.isEmpty() 'aPlainType'
			return supplied
		end 'aPlainType'

		// ⇒ **WHERE NO DECLARATION IS NAMEABLE, REFUSED HERE RATHER THAN GUESSED.** The `spawn` road says so with
		// a sentence; the ordinary road keeps the base `structRef`.
		let decl = try self.declarationNameableHere(callee) otherwise 'noDeclarationIsNameable'
			if serviceSite.isASpawn() 'aSpawn'
				throw self.unnameableFactoryRefusal(callee, anchor: try serviceSite.token() otherwise anchor)
			end 'aSpawn'

			return supplied
		end 'noDeclarationIsNameable'

		return try self.instanceFixedByFactoryDeclaration(supplied, base: base, decl: decl, callee: callee, args: args, argLabels: argLabels, anchor: anchor, site: serviceSite)
	end 'spawnFactoryConstructorInstance'

	function instanceFixedByFactoryDeclaration(supplied ConstructorInstance, base ByteArray, decl SweptDeclaration, callee ByteArray, args ValueIdArray, argLabels NameRoster, anchor Token, site ServiceSpawnSite) returns ConstructorInstance throws SourceParseError
		let params = self.signatures.structTypeParamsOf(base)
		let typeArgs = MaxonTypeArray.create(0)

		for position in 0 upto params.count() 'eachTypeParam'
			let paramName = try params.get(position) otherwise panic("instanceFixedByFactoryDeclaration: params.get OOB at {position} on a list walked to its own count")

			match self.factoryTypeArgumentAt(base, paramName: paramName, position: position, decl: decl, args: args, argLabels: argLabels) 'argument'
				found(t) then typeArgs.push(t)
				absent then return try self.uninferredFactoryInstance(supplied, reason: UninferredFactoryReason.noParameterFixesIt(paramName), typeName: base, callee: callee, site: site)
			end 'argument'
		end 'eachTypeParam'

		return try self.instanceOfFactoryTypeArguments(supplied, base: base, typeArgs: typeArgs, callee: callee, anchor: anchor, site: site)
	end 'instanceFixedByFactoryDeclaration'

	function instanceOfFactoryTypeArguments(supplied ConstructorInstance, base ByteArray, typeArgs MaxonTypeArray, callee ByteArray, anchor Token, site ServiceSpawnSite) returns ConstructorInstance throws SourceParseError
		for t in typeArgs 'eachTypeArgument'
			_ = try self.requireInferableTypeArgument(t, anchor: try site.token() otherwise anchor)
		end 'eachTypeArgument'

		// ⛔⛔ **THE CONCRETENESS TEST IS ASKED OF THE ARGUMENTS, NOT OF AN INTERNED ID, AND THAT IS A
		// CORRECTNESS RULE.** `internGenericInstanceOf` MINTS a row on a miss and CLEARS the speculative mark
		// on a hit — *"the guess has since been confirmed by the source"*. This road may DISCARD its answer
		// two lines down, and a rejected inference confirms nothing: interning to ask would promote a
		// candidate walk's guess and grow the registry for an instantiation no source names.
		//
		// ⛔ **A `spawn` INSIDE ANOTHER GENERIC BODY FIXES NOTHING**, and the instance it would name is the
		// one shape `ServiceBehaviour` cannot build `<T>.__behave` for: `receiverLayoutSourceOf` would forward a descriptor
		// the synthesized body has no slot for. Refused here rather than aborting the compiler two tiers down.
		if not self.signatures.argsAreFullyConcrete(typeArgs) 'stillOpaque'
			return try self.uninferredFactoryInstance(supplied, reason: UninferredFactoryReason.theArgumentsAreStillOpaque, typeName: base, callee: callee, site: site)
		end 'stillOpaque'

		let gid = self.signatures.internGenericInstanceOf(base, args: typeArgs)

		// ⭐⭐ **AN INFERRED INSTANTIATION IS A SITE, AND `where` CONSTRAINTS ARE CHECKED SITE BY SITE.**
		// `ConformanceCheck.checkWhereConstraints` walks the lists a provenance is recorded on — a declared
		// alias, a bracketed literal, a file-scope constant — and an instantiation on none of them is checked
		// by nobody: E3017 goes unraised and the program reaches `witnessSlotImpl` with no conformance
		// selected.
		self.recordInferredInstantiation(gid, at: anchor)
		return ConstructorInstance.instance(gid)
	end 'instanceOfFactoryTypeArguments'

	function unnameableFactoryRefusal(callee ByteArray, anchor Token) returns SourceParseError
		return match self.signatures.calleeVisibilityFrom(callee, readerFilePath: self.job.path) 'visibility'
			hidden(tier) gives SourceParseError.symbolNotVisible(HiddenSymbolKind.functionDeclaration, symbol: String.from(callee), tier: tier, line: anchor.line, column: anchor.column)
			visible panic("unnameableFactoryRefusal: '{String.from(callee)}' has no declaration this file may name yet its site says visible — an undeclared member is `classifyServiceTarget`'s E3134, which the `spawn` door asks before this one")
		end 'visibility'
	end 'unnameableFactoryRefusal'

	// A value held at an interface type fixes no instantiation on either road: the instance would stand a fat
	// pointer in a one-word slot, and no descriptor or layout can be built for one.
	function requireInferableTypeArgument(t MaxonType, anchor Token) returns MaxonType throws SourceParseError
		try self.requireStorableDeclaredType(t, position: DeclaredStoragePosition.inferredTypeArgument, line: anchor.line, column: anchor.column)
		return t
	end 'requireInferableTypeArgument'

	// ⭐ **WHAT AN INFERENCE THAT FIXED NOTHING ANSWERS — ONE HOME, because both misses answer identically on
	// the ordinary road and differ only in the sentence the `spawn` road raises.** The reason travels as a
	// verdict rather than a rendered sentence so the ordinary road builds no String it will not use.
	function uninferredFactoryInstance(supplied ConstructorInstance, reason UninferredFactoryReason, typeName ByteArray, callee ByteArray, site ServiceSpawnSite) returns ConstructorInstance throws SourceParseError
		let spawnTok = try site.token() otherwise return supplied
		let member = unqualifiedMemberOf(callee)

		match reason 'why'
			noParameterFixesIt(paramName) then throw SourceParseError.unsupported(spawnUninferrableTypeArgumentRefusal(typeName, member: member, paramName: paramName), line: spawnTok.line, column: spawnTok.column)
			theArgumentsAreStillOpaque then throw SourceParseError.unsupported(spawnOpaqueTypeArgumentRefusal(typeName, member: member), line: spawnTok.line, column: spawnTok.column)
		end 'why'
	end 'uninferredFactoryInstance'

	// What the arguments fix one type parameter to, or `absent`. The FIRST factory parameter declared
	// at that parameter, or at an instance written over it, whose argument fixes it decides; labels
	// are mapped through `argSlotPosition`, the one home of the label-to-position rule, so
	// `create(item: x)` fixes `T` exactly as `create(x)` does.
	function factoryTypeArgumentAt(typeName ByteArray, paramName ByteArray, position ElementIndex, decl SweptDeclaration, args ValueIdArray, argLabels NameRoster) returns InferredTypeArgument
		let token = typeParamTokenFor(typeName, paramName: paramName)
		var inferred = InferredTypeArgument.absent

		for p in 0 upto decl.paramTypes.count() 'eachFactoryParam'
			let swept = try decl.paramTypes.get(p) otherwise panic("factoryTypeArgumentAt: paramTypes.get OOB at {p} below count {decl.paramTypes.count()}")
			let sweptTag = maxonTypeTag(swept)

			if sweptTag == ValueTypeTag.unresolved or (sweptTag == ValueTypeTag.typeParameter and typeParamIdOf(swept) != token) 'notThisParameter'
				continue
			end 'notThisParameter'

			let declared = swept if sweptTag == ValueTypeTag.typeParameter else self.sweptParamType(swept, scopeFilePath: decl.declFilePath)

			for i in 0 upto args.count() 'eachArgument'
				let label = try argLabels.get(i) otherwise panic("factoryTypeArgumentAt: argLabels.get OOB at {i} — args and argLabels are pushed in lockstep")

				let slot = try argSlotPosition(decl.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

				if slot != p 'anotherPosition'
					continue
				end 'anotherPosition'

				match self.typeArgumentFixedByArgument(declared, actual: self.spawnTypeArgumentOfValue(try args.get(i) otherwise panic("factoryTypeArgumentAt: args.get OOB at {i}")), token: token, base: typeName, position: position) 'atThisArgument'
					found(fixed) then inferred = self.joinedInferredArgument(inferred, next: fixed)
					absent then break
				end 'atThisArgument'
			end 'eachArgument'
		end 'eachFactoryParam'

		return inferred
	end 'factoryTypeArgumentAt'

	function joinedInferredArgument(sofar InferredTypeArgument, next MaxonType) returns InferredTypeArgument
		return match sofar 'sofar'
			absent gives InferredTypeArgument.found(next)
			found(held) gives InferredTypeArgument.found(self.signatures.joinedFixedArrayArgument(held, next: next))
		end 'sofar'
	end 'joinedInferredArgument'

	// A parameter written as the bare base inside its own type is the instance over the type's own
	// parameters, so the argument's type argument at `position` is the one it fixes.
	function typeArgumentFixedByArgument(declared MaxonType, actual MaxonType, token TypeParamId, base ByteArray, position ElementIndex) returns InferredTypeArgument
		if maxonTypeTag(declared) != ValueTypeTag.structRef 'notTheBaseItself'
			return self.typeArgumentFixedByType(declared, actual: actual, token: token)
		end 'notTheBaseItself'

		if maxonTypeTag(actual) != ValueTypeTag.genericInstance or not self.internedName(typeNameIdOf(declared)).equals(base) 'notAnInstanceOfTheBase'
			return InferredTypeArgument.absent
		end 'notAnInstanceOfTheBase'

		let actualId = genericInstanceIdOf(actual)

		if not self.signatures.genericInstanceBaseName(actualId).equals(base) 'anotherBase'
			return InferredTypeArgument.absent
		end 'anotherBase'

		return InferredTypeArgument.found(self.signatures.canonicalInstanceArg(self.signatures.substitutedInstanceArg(actualId, position: position)))
	end 'typeArgumentFixedByArgument'

	function typeArgumentFixedByType(declared MaxonType, actual MaxonType, token TypeParamId) returns InferredTypeArgument
		let declaredTag = maxonTypeTag(declared)

		if declaredTag == ValueTypeTag.typeParameter 'aTypeParameter'
			return InferredTypeArgument.found(self.signatures.canonicalInstanceArg(actual)) if typeParamIdOf(declared) == token else InferredTypeArgument.absent
		end 'aTypeParameter'

		if declaredTag != ValueTypeTag.genericInstance or maxonTypeTag(actual) != ValueTypeTag.genericInstance 'nothingToMatchInside'
			return InferredTypeArgument.absent
		end 'nothingToMatchInside'

		let declaredId = genericInstanceIdOf(declared)
		let actualId = genericInstanceIdOf(actual)

		if self.signatures.genericInstanceBaseId(declaredId) != self.signatures.genericInstanceBaseId(actualId) 'anotherBase'
			return InferredTypeArgument.absent
		end 'anotherBase'

		for argumentPosition in 0 upto self.signatures.genericInstanceArgCount(declaredId) 'eachArgument'
			match self.typeArgumentFixedByType(self.signatures.substitutedInstanceArg(declaredId, position: argumentPosition), actual: self.signatures.substitutedInstanceArg(actualId, position: argumentPosition), token: token) 'atThisPosition'
				found(fixed) then return InferredTypeArgument.found(fixed)
				absent then continue
			end 'atThisPosition'
		end 'eachArgument'

		return InferredTypeArgument.absent
	end 'typeArgumentFixedByType'

	// An argument's type as a TYPE ARGUMENT of the SIGNATURE INDEX's registry. A name crosses interners as a
	// NAME — the value's id belongs to this file's table — and the canonical `structRef`/`named` split is the
	// index's own, asked through its door so an inferred instantiation and a spelled one intern once.
	function spawnTypeArgumentOfValue(value ValueId) returns MaxonType
		let declared = self.typeOf(value)
		let tag = maxonTypeTag(declared)

		if tag != ValueTypeTag.named and not tagNamesADeclaredType(tag) 'carriesNoName'
			return declared
		end 'carriesNoName'

		return self.signatures.canonicalInstanceArg(maxonTypeOfTag(tag, nameId: self.signatures.indexTypeNames().intern(self.valueTypeName(value))))
	end 'spawnTypeArgumentOfValue'

	// ⭐ **A GENERIC CONSTRUCTOR'S RESULT IS THE INSTANCE, not the base struct.**
	// `BoolSizer.create(…)` links to `Sizer.create`, which returns `Self` — the BASE struct `Sizer`
	// (`structRef`) — because the shared body is compiled once against the opaque `T`. But the VALUE is a
	// `Sizer with bool`, and dictionary-passing needs that instance identity ON the value so a later
	// `s.typeSize()` can pass the right layout descriptor. So when the result adopted the base struct's
	// type, retype it to `genericInstance(gid)`, carrying the gid the method call site reads out of the
	// value's name column. A method returning a SCALAR (`typeSize() returns Integer`) or a DIFFERENT struct
	// keeps its type — only a `Self`/base-struct return is the instance, which the base-id guard enforces.
	//
	// ⚠ **THE INSTANCE ARRIVES AS A PARAMETER RATHER THAN BEING RE-DERIVED FROM `aliasName`**, and that is not
	// tidying: the CONSUME side already asked `constructorInstanceOf` for exactly this value, so re-deriving it
	// was a second reading of one call site — and with generic substitution the two readings would genuinely differ, because a
	// base name may denote an instance the alias registry knows nothing about (`Inner` inside `type Outer uses
	// T`). `aliasName` is still taken, for the one thing only the WRITTEN spelling can answer.
	//
	// ⚠ The `GenericAlias` in the name is the NARROWER of the two bases it serves; it is kept because
	// comments in `SemanticCheck`, `SignatureIndex` and `IrFunction` cite it.
	function retypeGenericAliasConstructorResult(result ValueId, gid GenericInstanceId, aliasName ByteArray)
		self.retypeConstructorResultToInstance(result, gid: gid)
		self.recordValueCallInstance(result, instance: gid)

		// ⛔⛔ **PROVENANCE IS ABOUT WHAT THE SITE WROTE, NOT ABOUT WHETHER A RETYPE WAS NEEDED**, so it is
		// not written behind the retype's guards. A factory whose result is ALREADY the instance is the
		// common case: only a DECLARED generic's `create() returns Self` comes back as the shared body's
		// base `structRef` and needs retyping, while every builtin container's factory —
		// `OtherCol.create()` over `Array` — is already typed. Unrecorded, a diagnostic cannot say which
		// of two aliases of one instance the blamed statement wrote.
		//
		// ⚠ The guards below are the ones this fact needs, and they are NOT the retype's: the value must BE an
		// instance and it must be THIS one. A result that is some other base's struct is not described by
		// this alias and must not be stamped with its name.
		if not self.resultIsTheInstance(result, gid: gid) 'notTheInstanceBuilt'
			return
		end 'notTheInstanceBuilt'

		// ⭐ Carry the FACTORY's alias onto the result as its BRAND, so a later `w.getTag()` / `w.setTag(…)` on
		// this value can re-qualify an inner-alias return/parameter to `WrapperA.Idx`, and so an `A.create(4)`
		// never reaches a `B` slot. The shared gid cannot recover `WrapperA`; only the syntactic `aliasName` can.
		//
		// ⚠ **A BARE GENERIC BASE HAS NO SUCH SPELLING TO CARRY** — `Inner` names the BASE, and the
		// per-instance registries are keyed on alias names (`perInstanceAliasFromParts` resolves the prefix
		// through the generic-alias registry, which has no entry for a base). Stamping the base name here
		// would file a per-instance question under a name that answers no per-instance registry; the
		// substitution the value actually needs is `typeCallResultThroughInstance`'s, which reads the gid and
		// never the spelling.
		self.brandValue(result, brand: self.brandOfSpelling(aliasName, readerFilePath: self.job.path))

		// ⭐ **AND THE ALIAS'S OWN ARGUMENT SPELLING** — `emitOwnedContainerCreate`'s line for the builtin
		// `Array`, at the door a DECLARED generic's factory leaves through. `BufCell.make(…)` mints the only
		// kind of value that has no declared type to read its surface from, and `gid` cannot answer for it:
		// `Cell with __ManagedMemory` and `Cell with ByteArray` are one instance. Only the written spelling can,
		// and it is the same spelling `brandValue` is here for.
		self.markDeclaredSurface(result, declared: surfaceOfRootBits(self.signatures.aliasSpellingSurfaceBits(aliasName, readerFilePath: self.job.path)))
	end 'retypeGenericAliasConstructorResult'

	function resultIsTheInstance(result ValueId, gid GenericInstanceId) returns bool
		return self.tagOf(result) == ValueTypeTag.genericInstance and self.valueNameId(result) == gid as TypeNameId
	end 'resultIsTheInstance'

	// A static returning another type keeps its result's type, so the inferred instance is recorded as
	// the call's qualifier, which is where `LowerMaxonToStd.hiddenArgumentSourceOf` reads its hidden
	// words from.
	function stampInferredFactoryResult(result ValueId, gid GenericInstanceId)
		self.retypeConstructorResultToInstance(result, gid: gid)
		self.recordValueCallInstance(result, instance: gid)
	end 'stampInferredFactoryResult'

	// ⭐ **THE RETYPE HALF.** A DECLARED generic's `create() returns Self` hands back the shared body's base
	// `structRef`, and only the call site knows which instance was asked for. A result that is already an
	// instance — every builtin container's factory — needs nothing done to it, which is precisely why the
	// provenance above may not be written behind these guards.
	function retypeConstructorResultToInstance(result ValueId, gid GenericInstanceId)
		if self.tagOf(result) != ValueTypeTag.structRef 'notBaseStruct'
			return
		end 'notBaseStruct'

		let baseId = self.artifact.typeNames.intern(self.signatures.genericInstanceBaseName(gid))
		let resultNameId = try self.bodyState.valueNameIds.get(result) otherwise panic("retypeConstructorResultToInstance: result v{result} has no name-id — the two type columns are dense and in lockstep")

		if resultNameId != baseId 'notThisBase'
			return
		end 'notThisBase'

		self.retypeValue(result, valueType: MaxonType.genericInstance(gid))
	end 'retypeConstructorResultToInstance'

	// ⭐ **`p.add(10)` / `self.add(10)` — AN INSTANCE METHOD CALL, WHICH IS AN ORDINARY DIRECT CALL
	// WITH ONE EXTRA ARGUMENT.**
	//
	// The callee is `Adder.add` — mangled from the RECEIVER'S DECLARED TYPE and the method name,
	// which is exactly the key `parseFunction` declared it under (`declaredMethodName`), the same
	// key `Point.create` is linked by. So the result is typed from the signature index, arguments
	// are slotted by `slotCallArgs`, arity and labels are validated by `SemanticCheck`, and the
	// backend passes the receiver in argument register 0 — none of which learns that methods exist.
	//
	// **THE RECEIVER IS PREPENDED AS ARGUMENT 0, AND THAT IS THE ENTIRE DISPATCH MECHANISM.** It
	// pairs with the `SelfParamName` parameter `parseFunction` pushed at position 0: the call's
	// first argument is POSITIONAL, so `slotCallArgs` puts it at position 0 without being told
	// anything, and the user's `10` — also positional, at index 1 — lands on the first user
	// parameter. The two halves meet through the ordinary label rules and nothing else.
	//
	// ⭐ **THE RECEIVER IS BORROWED — the callee neither owns it nor drops it.** It is passed as a
	// parameter, and a parameter is not owned by the callee: the CALLER owns the +1, so no incref is
	// emitted here and no drop is emitted there. The receiver's box is dropped by the binding that
	// owns it, at ITS scope exit (`ownedBindings`), which is why `c.increment()` twice over followed
	// by `c.getCount()` is well-defined and returns 42 rather than reading freed memory. A consume
	// would be a SINK: a store of the RECEIVER into heap storage, or its passing to a callee that
	// consumes it.
	//
	// ⚠⚠ **A SINK OF THE RECEIVER IS CO-OWNED, NOT MOVED.** `var next as Node` inside `type Node` is a
	// legal struct-typed field, and `self` IS a value, so `next = self`, `bag.push(self)`, `Self{f:
	// self}` and `Cell.create(self)` all PARSE. Each reaches a door keyed on BORROWED-ness rather than
	// on the `self` keyword — a durable store `moveManagedValueInto`, a consuming argument
	// `transferConsumedArg` — and both take the sink's own reference through
	// `coOwnBorrowedForConsume`, leaving the receiver's owner untouched. **`self` reaches them as
	// parameter 0, exactly as `other Node` does.**
	//
	// ⭐ **A HAND-OFF IS NOT A SINK.** `return self` and a `gives self` arm hand the receiver to the
	// CALLER, which adopts one reference and drops it; they are co-owned by an `__mm_retain`
	// (`promoteBorrowedToOwned`) and the receiver's own owner is untouched.
	function parseMethodCall(func IrFunction, resultUsed bool) returns ValueId throws SourceParseError
		let baseTok = self.current()

		// A CAPTURED enclosing receiver: `b.doubled()` inside a closure that captures the
		// struct `b`. The base is not in the closure's OWN scope but resolves into an enclosing one.
		//
		// ⚠⚠ **IT IS ASKED BEFORE THE TOP-LEVEL FALL-THROUGH, AND THAT ORDER *IS* THE SHADOWING RULE —
		// ONE RULE, ENCODED IN THREE PLACES, WHICH IS WHY EACH OF THEM SAYS SO.** `parseVariableReference`
		// states it for a bare read ("an enclosing local that SHADOWS a same-named global is caught as the
		// capture it is, not silently resolved to the global — a wrong answer"), and `methodCallsAt` asks
		// its two membership tests in the same order. A method RECEIVER is the same name in the same
		// position, so it must resolve to the same binding.
		//
		// Were this arm BELOW the managed one, the inversion would be a LIVE
		// wrong answer rather than a latent one. With a top-level `let msg = "GLOBAL-TWELVE"` and a
		// `let msg = "ab"` in `main`, a closure body would read the CAPTURE for `{msg}` (printing `ab`) and the
		// GLOBAL for `msg.byteLength()` (yielding 13) — two resolutions of one name, in one expression,
		// neither of them a compile error.
		match self.valueBaseAt(self.pos) 'receiver'
			thisFrame then return try self.dispatchMethodOnBinding(func, binding: self.thisFrameBindingOf(baseTok), baseTok: baseTok, subjectName: self.storageSubjectNameAt(self.pos), resultUsed: resultUsed)
			captured(frame) then return try self.capturedMethodCall(func, baseTok: baseTok, enclosing: self.capturedFrame(frame).scope, frame: frame, resultUsed: resultUsed)
			unbound or
			alwaysAType then break
		end 'receiver'

		// ⭐ **A TOP-LEVEL MANAGED BINDING IS A RECEIVER** — a `let` (`Live.count()`, `name.byteLength()`) or a
		// `var` (`msg.append("!")`, `Buffer.count()`). Neither is a binding in
		// scope and neither is a capture, so without this arm the base reads as a TYPE NAME and the call is
		// mangled to a callee `Live.count` no file declares (E3004, measured).
		//
		// It materializes the receiver and then hands it to the SAME `dispatchMethodOnBinding` a local
		// receiver goes through, wearing a SYNTHETIC binding. That is not a shortcut: the dispatch already
		// routes by TAG (String / Array / Set / conformer / struct) and already enforces the one
		// immutable-receiver rule (`noteReceiverWrite`, E3207). Re-deciding either here would be a
		// second copy of both.
		//
		// ⭐ **THE TWO KINDS ARE TOLD APART BY MATCHING THE RESOLUTION, NOT BY RE-ASKING FOR IT.** Past the
		// gate this resolves the base ONCE and dispatches on the arms, rather than testing a predicate that
		// resolves it and then resolving it again to build the receiver. The `let` and the `var` differ in
		// exactly two places — where the value comes from and whether the binding is mutable — and
		// `mutable` is what makes `Live.push(1)` an E3207 while `Buffer.push(1)` is legal.
		//
		// A `none` here is a base spelled like a managed binding but not VISIBLE from this file. It cannot
		// arrive through `methodCallsAt` (which resolved the same answer and declined the shape), and with
		// the capture already ruled out above there is nothing left for it to be — so it joins the gate's
		// own `false` at the one impossible-state panic below rather than getting an arm of its own.
		//
		// ⭐ **A `var` RECEIVER IS THE SLOT'S CURRENT OCCUPANT, LOADED — AND IT IS NOT STORED BACK.** Every
		// receiver-writing method rewrites the RECORD in place and never moves it: `__managed_append` grows a
		// String's fused record through `buffer@0`/`length@8`, and an `Array`'s `push`/`set`/`clear` detach or rewrite the
		// element buffer while the 48-byte record stays put (`dispatchArrayMethod` states the same
		// invariant for a local receiver). So the pointer in the `.data` slot is still the right pointer
		// after the call, and a store-back would be a second write of a value that did not change. The
		// loaded pointer is BORROWED — the slot owns it (see `emitGlobalLoad`) — so nothing drops it here
		// and `__maxon_global_cleanup` releases it at exit.
		//
		// A `let`'s literal is re-materialized at the use, exactly as a bare reference to it would be.
		if self.managedTopLevelBaseAt(self.pos) 'managedTopLevelBase'
			match try self.dispatchOnManagedTopLevelReceiver(func, tok: baseTok, resultUsed: resultUsed) 'binding'
				dispatched(result) then return result
				notAManagedReceiver then break
			end 'binding'
		end 'managedTopLevelBase'

		panic("parseMethodCall: '{String.from(baseTok.value)}' is neither a local binding, a capture, nor a top-level managed binding, but `methodCallsAt` gated this call — the two must agree on what a method receiver is, and on the ORDER they resolve one in")
	end 'parseMethodCall'

	// ⭐⭐ **THE THREE STORAGE MODELS A TOP-LEVEL MANAGED RECEIVER CAN HAVE, JOINED IN ONE DOOR** — asked by
	// both receiver sites (`parseStaticMemberAccess` for `Names.items.push(9)`, `parseMethodCall` for a bare
	// base). They differ only in the token they resolve and in what they do when the answer is `none`, so a
	// per-site copy of the arms would be one rule written twice: a fourth storage model taught to one site
	// and not the other is a wrong answer at the other, with nothing to make the two disagree loudly.
	//
	// What each arm carries is the same three facts `dispatchOnManagedReceiver` takes — the VALUE the
	// receiver is, its TYPE, and whether a receiver-writing method on it is legal. Only a `var`'s slot
	// answers `mutable`; a managed constant and an imaged record are `.rdata` and can be written through by
	// nothing.
	function dispatchOnManagedTopLevelReceiver(func IrFunction, tok Token, resultUsed bool) returns ManagedTopLevelDispatch throws SourceParseError
		let binding = self.managedReceiverBindingOf(tok)

		match binding 'binding'
			inlineWord or
			imageRecord or
			imageBox then break
			constant(bytes, kind) then return ManagedTopLevelDispatch.dispatched(try self.dispatchOnManagedReceiver(func, baseTok: tok, value: try self.emitManagedConstant(bytes, kind: kind, range: SourceRange.ofToken(tok)), varType: self.signatures.managedConstValueType(kind, elementFilePath: self.job.path), resultUsed: resultUsed))
			global(label, valueType) then return ManagedTopLevelDispatch.dispatched(try self.dispatchOnGlobalReceiver(func, tok: tok, label: label, valueType: valueType, resultUsed: resultUsed))
			none or
			poisoned then return ManagedTopLevelDispatch.notAManagedReceiver
		end 'binding'

		let (value, valueType) = self.materializeImageOrInlineBinding(binding.clone(), tok: tok)
		return ManagedTopLevelDispatch.dispatched(try self.dispatchOnManagedReceiver(func, baseTok: tok, value: value, varType: valueType, resultUsed: resultUsed))
	end 'dispatchOnManagedTopLevelReceiver'

	function dispatchOnGlobalReceiver(func IrFunction, tok Token, label ByteArray, valueType MaxonType, resultUsed bool) returns ValueId throws SourceParseError
		let walk = self.markLateReads()
		let loaded = self.noteGlobalLetMapColumns(self.emitGlobalReceiverLoad(label, valueType: valueType, tok: tok), tok: tok)
		self.deferReadsSince(walk)
		return try self.dispatchOnManagedReceiver(func, baseTok: tok, value: loaded, varType: valueType, resultUsed: resultUsed)
	end 'dispatchOnGlobalReceiver'

	// ⭐ **THE SHAPE OF A SYNTHETIC RECEIVER BINDING, DECIDED ONCE.** A top-level managed receiver is not a
	// declaration the parser read, so its `VarInfo` is invented here — and every field of it is a claim the
	// dispatcher acts on: the NAME an E3207 would blame, the TYPE the tag-routing reads, `mutable`, and
	// (by omission) `isParameter: false`, which is what keeps `immutableReceiverNameOf`'s parameter
	// exemption from silently admitting a write to a `let`-bound constant. Two arms building their own
	// would be two chances for one of those to drift.

	// ⚠ **THE STORAGE SUBJECT COMES OFF THE BINDING'S NAME, NOT OFF THE CURSOR'S TOKENS.** Every receiver
	// this door serves is module storage the base is not a local for, so the token-index derivation's scope
	// arm is dead here and only its tail applies. Deriving it from the name is also what lets a STATIC
	// MEMBER through: its storage is `Names.items`, which no single token spells, so a token read would
	// answer `Names` — a name that denotes no storage — and silently drop the write.
	function dispatchOnManagedReceiver(func IrFunction, baseTok Token, value ValueId, varType MaxonType, resultUsed bool) returns ValueId throws SourceParseError
		let binding = VarInfo.createValueBinding(baseTok.value, varType: varType, kind: BindingKind.let, boundValue: value, brandId: self.brandIdOf(value))
		return try self.dispatchMethodOnBinding(func, binding: binding, baseTok: baseTok, subjectName: StorageSubject.none, resultUsed: resultUsed)
	end 'dispatchOnManagedReceiver'

	// ⭐ **BUILD THE RECEIVER A BINDING DENOTES AND HAND IT TO THE ONE DISPATCHER.** The cursor sits ON the
	// base token; this consumes it and `dispatchMethodOnReceiver` consumes the `.`. Shared by a LOCAL
	// receiver and a top-level MANAGED CONSTANT one, which differ only in where the binding came from — so
	// the two spellings cannot come to disagree about which dispatch a `String`, an `Array`, a `Set` or a
	// conformer receiver gets.
	//
	// ⭐⭐ **EVERYTHING BINDING-SPECIFIC HAPPENS HERE, AND NOTHING ELSE DOES.** This door owns exactly the
	// four facts a NAME carries and a temporary cannot — the live-binding guard, the self-field
	// materialization, the E3207 blame name and storage subject, and the owning-parameter mask — and then the
	// receiver is just a value. That split is what lets `parsePostfix` serve a literal, a call result or a
	// field read through the SAME switch instead of growing a parallel arm per type (the shape
	// `IrInterface.maxon:565-573` already prescribes for the builtin-conformer door: "to keep the two
	// dispatch spellings from disagreeing").
	// ⚠ **`subjectName` IS THE CALLER'S.** Derived here from `self.pos` it would be
	// exact for a receiver that IS one token and wrong for one that is not: a static member's receiver is
	// `Names.items`, three tokens, and a cursor-based read answers `Names` — a name denoting no storage, so
	// the write is recorded under nothing. Each caller holds the fact
	// directly — a local's from the cursor, module storage's from its own name — so the derivation is
	// stated where it is known rather than guessed from a position.
	function dispatchMethodOnBinding(func IrFunction, binding VarInfo, baseTok Token, subjectName StorageSubject, resultUsed bool) returns ValueId throws SourceParseError
		// The receiver must be LIVE (a moved-from String / Array / Set / struct touched through a method is
		// use-after-move, E3102), checked before the method name is even resolved. It was written once per
		// dispatcher and is asked ONCE here — the question is about the BINDING, and every arm past this
		// point holds only a value.
		try self.requireBindingLive(binding, nameTok: baseTok)

		if self.textMemberRewritesItsReceiverHere(maxonTypeTag(binding.varType), member: self.tokenAt(self.pos + MethodNameOffset).value) 'aTextIsReassignedByItsOwnMethod'
			try self.requireTextReceiverIsRebindable(binding, baseTok: baseTok, methodTok: self.tokenAt(self.pos + MethodNameOffset))
			self.markMutabilityExercised(binding)
		end 'aTextIsReassignedByItsOwnMethod'

		// ⚠ The OWNER mask is read off the binding as it ARRIVED, before `baseBindingOf` materializes
		// a self-field alias into an ordinary value binding — materializing is exactly what erases the fact
		// that the record belongs to `self`. See `receiverOwnerMask`.
		let owner = try self.receiverOwnerMask(func, binding: binding, baseTok: baseTok)

		// Read BEFORE the materialization too: `baseBindingOf` hands back an ordinary value binding,
		// which is exactly the fact the struct fallthrough still has to refuse on.
		let selfFieldName = SelfFieldAlias.field(baseTok.value) if binding.isSelfField else SelfFieldAlias.none

		// ⭐⭐⭐ **`managed.length()` INSIDE `stdlib/String.maxon` HANDS OVER THE STRING'S OWN RECORD AND MINTS
		// NOTHING.** Reading a fused wrapper's inline `managed` normally goes through `emitFieldLoad`, which
		// goes through `__str_bytes_view` so the value can be TYPED as an `Array with Byte` — and when the only
		// thing that value does is receive ONE member call, that whole round trip exists for a callee that reads
		// two words the String record already carries at the same offsets. The round trip is a refcount pair
		// (`__mm_incref` in, `__managed_decref` out), paid on a hot path: `s.byteLength()`, whose corpus body is
		// exactly `return managed.length()`, and `String.byteAt`, which is the same shape once PER BYTE and is
		// what `hashString` is built out of.
		//
		// ⭐ **IT IS THE ARRAY PATH'S OWN SHAPE, NOT A NEW ONE.** `arr.managed.setLength(2)` already dispatches
		// with the receiver's record and mints nothing — `dispatchArrayMethod`'s `.managed` arm splits on
		// `memberCallFollows` and re-enters with `viaManagedField: true`. That split is exactly this one: a
		// `managed` that is CALLED needs no record of its own, and a `managed` used as a VALUE (bound,
		// returned, passed, or stored in a `String{…}` literal) still mints, because the caller may drop it
		// and dropping the receiver's own record is the double free `bufferSurfaceOf`'s header measures.
		//
		// ⭐⭐⭐ **IT IS EVERY MEMBER, NOT A WHITELIST.** A whitelist of the members whose runtime entries have
		// been traced leaves the eleven others a container body spells — `set`, `get`, `setLength`, `capacity`,
		// `grow`, `slice`, `remove`, `clear`, `fill`, `shiftRight`, `elementSize`, **39 call sites across
		// `stdlib/`** — falling through to the `managed`-as-a-VALUE door, which pays an
		// `__mm_retain`/`__managed_decref` pair around the call. **That pair protects nothing on this route**,
		// and each of the three arguments for a whitelist is closed somewhere else:
		//
		//   • **THE ENTRY RECEIVES THE SAME POINTER EITHER WAY**, so a list never decides which record an entry
		//     gets — only whether a refcount pair is paid on the way to it. An `Array`'s buffer IS the `Array`,
		//     and `__str_bytes_view` is an `__mm_incref` that hands the RECEIVER's own record straight back (its
		//     whole body is a `capacity@16 == -4` test, an incref and `mov r8, rcx`).
		//   • **THE INSTANCE** — `append`'s and `setByte`'s parse-time admission reads the receiver's giid, and
		//     this door hands over `bufferSurfaceInstanceOf`, which is the value door's OWN answer, so the two
		//     cannot disagree about the element.
		//   • **THE SEVENTH SLOT** — `makeCharFromBytes` reads `@48` and must never be handed a plain 48-byte
		//     buffer record. `dispatchArrayMethod` refuses that on the RECEIVER's TAG rather than on the route
		//     it came by (`tagIsByteRecord`).
		//
		// ⇒ **THE RECEIVER HERE IS `self`**, a parameter the CALLER owns for the whole frame, so nothing a
		// buffer entry does can free it, and the `memberCallFollows` gate above is exactly "the only consumer is
		// a call in the same statement". `managed` used as a VALUE still mints and still pays, because it may
		// outlive the statement — the double free `bufferSurfaceOf`'s header measures.
		//
		// ⭐ **WHICH SLOTS EACH ENTRY READS.** Every fused record agrees on the SIX buffer slots — `buffer@0`,
		// `length@8`, `capacity@16`, `element_size@24`, `parent@32`, `element_destroy@40`, all spelled from the
		// same `BufferOwnership.ManagedRecord*Offset` constants — and a BYTE record carries a SEVENTH,
		// `singleByteGraphemes@48`, that no buffer entry knows about.
		//   • `length()` -> `__managed_count`, reads `@8`.
		//   • `byteAt(i)` -> `__managed_byte_at`, reads `@0` plus `@8`/`@16`/`@24` through `emitBufferAccessGuard`.
		//   • `setByte(i, v)` -> `__managed_set_byte` + `__managed_cow_detach`, reads `@8`/`@24`/`@0` and writes
		//     `requireRawByteWriteFitsItsSlot` E3118) reads the GIID, so a synthesized byte instance handed over
		//     here makes an `Array with String`'s byte write **COMPILE CLEAN AND EXIT 101**.
		//   • `append(other)` -> `__managed_append`, reads both records' `@24` and aborts on a mismatch; its
		//     admission (`ProgramSignatures.arrayAppendArgAdmits`) reads the giid too, and under the same lie
		//     takes `primitiveTypeByteSize` down on an opaque element.
		//   • `toCString()` -> `__mm_to_cstring`, reads `@8` and `@0`. Not even `@24`.
		//   • `makeCharFromBytes(p, n)` -> `__char_at`, **reads `@48`** — the one entry written for a byte record,
		//     and the one `dispatchArrayMethod`'s `tagIsByteRecord` guard exists for. That guard carries the
		//     measurement in full and is what closes this, on the record rather than on the route.
		//   • `slice(s, e)` -> `__managed_slice` -> `emitRecordView`, which LOADS `@40` into the fresh view. A
		//     String record's `element_destroy@40` must therefore be a real destructor: a flag there becomes a
		//     view's destructor and the first `__managed_decref` `callIndirect`s address 1.
		//
		// ⛔⛔⛔ **PRESENTING `internSynthesizedByteInstance()` TO EVERY RECEIVER IS A LIE.** The instance is
		// what `emitFieldLoad` stamps on the VIEW it mints, and for a `String` or a `Character` it is exactly
		// right — their record IS a byte buffer. For an `Array` or a `FixedArray` it is a stride lie the very next
		// header down the file already spells out (`emitFieldLoad`'s `inlineManagedIsTheReceiver` arm: *"a
		// stride lie for an `Array with Element`, whose slots are 8 bytes wide"*) — and the members that CONSULT
		// the instance rather than merely reading the record then answer about a `Byte` whatever the receiver's
		// element really is. **Three members do, and each fails differently**:
		//   • `append` → `ProgramSignatures.arrayAppendArgAdmits` asks `containerElementIsOpaque` of the BYTE
		//     instance (false), falls through to `sameTrivialArrayShape`, asks `arrayElementSize` of the
		//     ARGUMENT, and `primitiveTypeByteSize` **PANICS** on the type parameter.
		//   • `setByte` → E3110 (`requireBufferBytesAreNotAPointer`) and E3118
		//     (`requireRawByteWriteFitsItsSlot`) both read the instance, so on an `Array with String` the
		//     write is admitted as a `Byte`'s: it **COMPILES CLEAN AND EXITS 101**, a byte landing in a
		//     String POINTER slot and the leak that follows.
		//   • `makeCharFromBytes` → `__char_at` reads `singleByteGraphemes@48`, off the end of a 48-byte
		//     buffer record. Closed separately and structurally, by the tag test in `dispatchArrayMethod`.
		// In every one of the three the `self.managed.…` spelling — the VALUE path, which carries the
		// receiver's real instance — answers correctly, which is what says the ROUTE is the fault and never the
		// operation.
		//
		// ⇒ **THE DOOR HANDS OVER THE RECEIVER'S OWN BUFFER-SURFACE INSTANCE** (`bufferSurfaceInstanceOf`),
		// which is the same answer `bufferSurfaceOfDeclaredRecord` retypes its minted surface to — one fact,
		// one home, so the record path and the value path cannot come to disagree about the element.
		//
		// ⛔ THE FAST PATH IS KEPT FOR ALL FOUR CONFORMERS, BECAUSE THE ALTERNATIVE COSTS 1.65–1.9x.
		// Routing `Array` and `FixedArray` to the value door instead is correct and dearer than it looks:
		// `Array.hash` and `Array.equals` are NOT on `arraySurfaceMemberNames`, so unlike `count`/`get`
		// they are corpus bodies a program actually calls, and each loops `try managed.byteAt(i)` once
		// per byte (`stdlib/Array.maxon:665-688`) — which the re-route turns into a
		// `coOwnAggregateAsTemp` per byte. `Array.hash` is what `Map` and `Set` key on.
		//
		// ⚠ **THE SIZED CONTAINER'S LENGTH-WRITER REFUSAL IS THIS DOOR'S OWN AND MUST STAY HERE** — see
		// `refuseLengthChangeOnASizedContainersBuffer`. This door mints no value, so there is nothing to
		// carry a mark; and the instance it hands over is spelled `Array with Element` for a fixed array too
		// (that retype is load-bearing), so no `giid` test downstream can tell a fixed array's record from a
		// growable array's either. Only the ENCLOSING DECLARATION answers here, asked BY NAME because that is
		// the form `enclosingType` holds.
		//
		// The SYNTACTIC half is asked first because it is total and cheap; only then is the layout resolved,
		// which needs a `try` and so cannot join a condition chain.
		if binding.isSelfField and self.memberCallFollows(self.pos + 1) 'aCalledManagedFieldMember'
			// ⚠ The layout is bound here rather than asked through `selfFieldIsInlineManaged` because this
			// door needs it TWICE — once to admit the field, once to say which instance the record's buffer
			// surface wears. `StructLayout.fieldIsTheInlineManagedRecord` is that admission's one home, so
			// asking it directly is the SAME question and not a second reading of it.
			let layout = try self.enclosingLayout(baseTok)

			if layout.fieldIsTheInlineManagedRecord(binding.fieldIndex) 'inlineManagedServesTheRecord'
				try self.requireFieldAccessible(layout, index: binding.fieldIndex, fieldTok: baseTok)

				try self.refuseLengthChangeOnASizedContainersBuffer(self.tokenAt(self.pos + 2), onASizedContainersRecord: self.signatures.declarationIsASizedContainerRecordNamed(self.enclosingTypeName()))

				let receiver = try self.readReceiverValue(baseTok)
				let record = try self.selfFieldValueBinding(binding, baseTok: baseTok, value: receiver)
				let surface = self.bufferSurfaceInstanceOf(receiver, layout: layout)

				self.advance()
				try self.consume(TokenKind.dot)
				let enclosingDestination = self.statement.elementStoreDestination
				self.statement.elementStoreDestination = ElementStoreDestination.rootedAt(self.storeRootOf(binding), anchor: baseTok)
				let elementOpFloor = self.artifact.module.ops.count()
				let arrayReceiverValue = self.bindingValue(record, range: SourceRange.ofToken(baseTok))
				let arrayCallResult = try self.dispatchArrayMethod(func, arr: arrayReceiverValue, giid: surface, resultUsed: resultUsed, immutableReceiverName: self.immutableReceiverNameOf(record, baseTok: baseTok), receiverOwner: owner, receiverStorage: self.subjectStorageMask(func, subjectName: subjectName), viaManagedField: true)
				self.statement.elementStoreDestination = enclosingDestination
				self.adaptElementRead(arrayCallResult, receiver: arrayReceiverValue, opFloor: elementOpFloor)
				return arrayCallResult
			end 'inlineManagedServesTheRecord'
		end 'aCalledManagedFieldMember'

		let walk = self.markLateReads()
		let box = try self.baseBoxOf(binding, baseTok: baseTok)
		self.deferReadsSince(walk)

		let held = try self.baseBindingOf(binding, baseTok: baseTok, box: box)

		self.advance()
		let result = try self.dispatchMethodOnReceiver(func, recv: MethodReceiver.create(box, tag: maxonTypeTag(held.varType), nameId: typeNameIdOf(held.varType), anchor: baseTok, immutableName: self.immutableReceiverNameOf(held, baseTok: baseTok), subjectName: subjectName, owner: owner, selfFieldName: selfFieldName), resultUsed: resultUsed)

		if not self.signatures.isReplyInstanceAt(maxonTypeTag(held.varType), nameId: typeNameIdOf(held.varType)) and not valueIdArrayContains(self.bodyState.consumedReceivers, value: box) 'aReplyAnswersByMovingItself'
			try self.requireNotMovedSinceItWasRead(box, range: SourceRange.ofToken(baseTok))
		end 'aReplyAnswersByMovingItself'

		return result
	end 'dispatchMethodOnBinding'

	// Is this self-field alias the INLINE `managed` of a fused wrapper — the one field whose address IS the
	// receiver's? The same two questions `emitFieldLoad`'s own arm asks, and that is a
	// MECHANISM rather than a claim: both reach `StructLayout.fieldIsTheInlineManagedRecord`, whose header
	// carries the wrong answer a divergence between them would produce. What is left here is the only part
	// that is this door's own — resolving the ENCLOSING layout, which the field-load door is handed.
	//
	// ⚠ **IT ADMITS ALL FOUR CONFORMERS — `String`, `Character`, `Array` and `FixedArray` — AND EVERY ASKER WANTS
	// THAT.** `receiverOwnerMask`'s E3207 column is about a write reaching the CALLER's record, which is true
	// of all four; and the fused record door admits all four too, because the cure is to hand each of them
	// its OWN buffer instance rather than to turn any of them away (`bufferSurfaceInstanceOf`). ⛔ Narrowing it to the
	// two byte records is correct but measured at 1.65–1.9x on `Array.hash` — see the fused door's header for the numbers
	// and for why the instance, not the routing, is the thing to fix.
	function selfFieldIsInlineManaged(binding VarInfo, baseTok Token) returns bool throws SourceParseError
		let layout = try self.enclosingLayout(baseTok)
		return layout.fieldIsTheInlineManagedRecord(binding.fieldIndex)
	end 'selfFieldIsInlineManaged'

	// ⭐ **THE RECEIVER A VALUE IS.** A temporary — a string literal, a call result, a parenthesised
	// expression, a field read — is bound to no name, and the three provenance fields are the empty answer
	// for a REASON rather than by omission:
	//   • `immutableName` — nothing may be blamed for a write through it. No `let` promises anything about a
	//     value nobody named, so a mutating method on one is legal exactly as it is on a `var`.
	//   • `subjectName` — it denotes no STORAGE, so a write through it records no parameter's.
	//   • `owner` — it is nobody's parameter, so a write through it mutates none.
	// The FIELD-CHAIN door is the one caller that can still name something and passes its own two
	// (`parseFieldChainCall`): the chain's base IS a name.
	//
	// The anchor is the `.` — a temporary has no token of its own, and the dot is where the member access
	// the diagnostic is about begins.
	function valueReceiver(value ValueId, immutableName immutable ByteArray, subjectName StorageSubject) returns MethodReceiver
		return MethodReceiver.create(value, tag: self.tagOf(value), nameId: self.valueNameId(value), anchor: self.current(), immutableName: immutableName, subjectName: subjectName, owner: NoParamPositions, selfFieldName: SelfFieldAlias.none)
	end 'valueReceiver'

	// ⭐⭐ **THE ONE TAG SWITCH A `.member` ROUTES THROUGH — cursor ON the `.`.** Both spellings of a
	// receiver reach it: a BINDING (`dispatchMethodOnBinding`) and a VALUE (`parsePostfix`,
	// `parseFieldChainCall`). Before this existed the two were separate chains — eight arms keyed on a
	// `VarInfo` and four keyed on a value — and the difference between them was not a design, it was
	// whichever types someone had needed from a value so far: `[1,2].get(0)` worked and `"ab".byteLength()`
	// was `E2015: Unsupported: . statement`, `a.get().compare(b)` worked and `Inner.make(9).get()` did not.
	//
	// ⚠ **THE ARM ORDER IS LOAD-BEARING IN ONE PLACE**: `String` is a builtin conformer too, so its arm must
	// precede the conformer arm or `s.byteLength()` would be resolved against `String`'s intrinsic
	// conformances instead of the String method table.
	function emitFunctionValueClone(recv MethodReceiver) returns ValueId throws SourceParseError
		let memberTok = self.current()
		self.advance()
		try self.consume(TokenKind.leftParen)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let held = self.coOwnAggregateAsTemp(recv.value, range: SourceRange.between(memberTok, last: rparenTok))

		if self.regionFactsForRead().cleanFunctionValues.contains(recv.value) 'theClosureHoldsNothingTheCallerWrites'
			self.regionFactsForWrite().cleanFunctionValues.insert(held)
		end 'theClosureHoldsNothingTheCallerWrites'

		return held
	end 'emitFunctionValueClone'

	function dispatchMethodOnReceiver(func IrFunction, recv MethodReceiver, resultUsed bool) returns ValueId throws SourceParseError
		let enclosingDestination = self.statement.elementStoreDestination
		self.statement.elementStoreDestination = self.elementStoreDestinationOf(recv)
		let memberTok = self.tokenAt(self.pos + 1)
		let callsGeneratedClone = memberTok.value.equals(CloneMethodName) and self.cloneOfReceiverIsACompilerCopy(recv)
		let firstOp = self.artifact.module.opCount()
		let result = try self.dispatchReceiverMember(func, recv: self.receiverHeldAcrossItsArguments(recv), resultUsed: resultUsed)
		self.statement.elementStoreDestination = enclosingDestination
		self.noteAuthoredMemberCall(recv, memberTok: memberTok, firstOp: firstOp)

		if callsGeneratedClone 'aDeepCopy'
			self.markFresh(result)
		end 'aDeepCopy'

		self.dischargeHandedBackOperands(result, opFloor: firstOp)
		return result
	end 'dispatchMethodOnReceiver'

	function dischargeHandedBackOperands(result ValueId, opFloor ElementIndex)
		if self.regionFactsForRead().handedBack.isEmpty() 'nothingHandedBack'
			return
		end 'nothingHandedBack'

		let opIdx = try firstOpDefiningSince(self.artifact.module, value: result, floor: opFloor) otherwise return
		let op = try self.artifact.module.ops.get(opIdx) otherwise panic("dischargeHandedBackOperands: ops.get OOB at {opIdx}")
		let operands = ValueIdArray.create(0)
		maxonOpOperandValues(op, into: operands)
		self.dischargeHandedBack(operands, result: result)
	end 'dischargeHandedBackOperands'

	function cloneOfReceiverIsACompilerCopy(recv MethodReceiver) returns bool
		if recv.tag == ValueTypeTag.function or recv.tag == ValueTypeTag.interfaceRef or recv.tag == ValueTypeTag.typeParameter 'noGeneratedCopy'
			return false
		end 'noGeneratedCopy'

		if recv.tag == ValueTypeTag.genericInstance 'anInstance'
			return self.signatures.cloneIsACompilerCopy(qualifiedMethodName(self.signatures.genericInstanceBaseName(recv.nameId as GenericInstanceId), methodName: CloneMethodName))
		end 'anInstance'

		if not self.signatures.tagMayNameAggregate(recv.tag) 'aValue'
			return true
		end 'aValue'

		return self.signatures.cloneIsACompilerCopy(qualifiedMethodName(self.internedName(recv.nameId), methodName: CloneMethodName))
	end 'cloneOfReceiverIsACompilerCopy'

	function receiverHeldAcrossItsArguments(recv MethodReceiver) returns MethodReceiver
		let held = self.holdStorageReadForStatement(recv.value, kind: HoldKind.callOperand, range: SourceRange.ofToken(recv.anchor), position: OperandSuccession.memberReceiverBeforeArguments)

		if held == recv.value 'nothingReplaced'
			return recv
		end 'nothingReplaced'

		return recv.withValue(held)
	end 'receiverHeldAcrossItsArguments'

	function dispatchReceiverMember(func IrFunction, recv MethodReceiver, resultUsed bool) returns ValueId throws SourceParseError
		if tagIsUnresolved(recv.tag) 'deferredCallError'
			return try self.deferredUnresolvedMemberResult(func)
		end 'deferredCallError'

		try self.consume(TokenKind.dot)
		self.noteMemberDispatch(recv)

		if self.textMemberRewritesItsReceiverHere(recv.tag, member: self.current().value) 'aTextIsRewrittenInPlace'
			self.requireWrittenOperandNotImmutable(recv.value, place: self.receiverPlaceBefore(self.pos), calleeTok: self.current(), noun: "receiver")
		end 'aTextIsRewrittenInPlace'

		// ⭐⭐⭐ **A MEMBER THE CORPUS DECLARES AND THE ROSTER DOES NOT GOES TO THE CORPUS.**
		// Asked AHEAD of the builtin dispatchers, and gated so it can only ever catch what they would
		// REFUSE: `memberBelongsToTheCorpus` is consulted only for a name the roster does not carry, so
		// every arm below keeps every member it already served and the order rule in this header is untouched.
		// What it decides is the fall-through: `Character.toString()` is an ordinary call to an ordinary
		// declared function.
		//
		// ⇒ **THIS IS HOW THE SYNTHESIZED SURFACE RETIRES, ONE MEMBER AT A TIME AND MEASURABLY**: strike a
		// name from `stringSurfaceMemberNames`, and the corpus body behind it takes over here with no other
		// edit. See `memberBelongsToTheCorpus`, which serves the `StringIndex` surface as well as the two
		// byte records.
		if self.memberBelongsToTheCorpus(recv) 'corpusMethod'
			try self.admitArrayCopy(recv)
			return try self.dispatchMethodOnBase(func, base: try self.structBaseOfReceiver(recv), baseTok: recv.anchor, resultUsed: resultUsed)
		end 'corpusMethod'

		// ⭐⭐ **`p.cancel()` — CANCEL A GREEN THREAD.** A promise has exactly one member, so this is
		// gated on the NAME as well as on the receiver: every other spelling keeps whatever the arms below
		// already gave it, which matters because an UNBOXED promise's tag is `integer` (`p.toString()` is a
		// perfectly good `int` conformance call) and a STORED one's is `genericInstance`.
		//
		// ⚠ **IT IS ASKED HERE, AHEAD OF EVERY TAG ARM, BECAUSE A PROMISE WEARS TWO TAGS AND NEITHER IS ITS
		// OWN.** Placed after them, the unboxed spelling would reach the builtin-conformer roster (which is
		// the *"'int' has no method named 'cancel'"* this closes) and the stored one would reach the struct
		// fallthrough looking for a `Promise.cancel` no file declares.
		if self.methodCallCancelsAPromise(recv) 'promiseCancel'
			return try self.emitPromiseCancel(recv, resultUsed: resultUsed)
		end 'promiseCancel'

		if self.methodCallPeeksAPromise(recv) 'promisePeek'
			return try self.emitPromiseIsComplete(recv)
		end 'promisePeek'

		if self.methodCallSelectsOverPromises(recv) 'promiseSelect'
			return try self.emitPromiseArrayAwaitAny(recv)
		end 'promiseSelect'

		if self.signatures.isSharedValueInstanceAt(recv.tag, nameId: recv.nameId) 'sharedValueMethod'
			return try self.dispatchOnSharedValue(func, holder: recv.value, baseTok: recv.anchor, resultUsed: resultUsed)
		end 'sharedValueMethod'

		if recv.tag == ValueTypeTag.function and self.current().value.equals(CloneMethodName) 'functionValueClone'
			return try self.emitFunctionValueClone(recv)
		end 'functionValueClone'

		// A STRING RECEIVER takes the builtin String methods rather than the struct path, which would reject
		// it as not a struct. String is the one non-struct type carrying a method table of its own.
		if recv.tag == ValueTypeTag.string 'stringMethod'
			return try self.dispatchStringMethod(func, recv: recv)
		end 'stringMethod'

		// A CHARACTER RECEIVER — its own dispatcher, for the reason it is its own type.
		if recv.tag == ValueTypeTag.character 'characterMethod'
			return try self.dispatchCharacterMethod(recv)
		end 'characterMethod'

		// An ARRAY RECEIVER (`arr.push(x)`, `[10,20].get(0)`) goes to the managed-memory runtime rather than through
		// the struct path (which would reject a generic instance as not a plain struct). The split is on the
		// `genericInstance` tag being an `Array` instance — the parser's type oracle.
		if self.signatures.isArrayInstanceAt(recv.tag, nameId: recv.nameId) 'arrayMethod'
			// `viaManagedField: false` — a receiver that arrived here was named or produced, not reached
			// through `.managed`; whether it nonetheless denotes a BUFFER is a question about the VALUE
			// (`valueIsBufferSurface`), which the dispatcher asks for itself.
			return try self.dispatchArrayRosterMethod(func, recv: recv, resultUsed: resultUsed)
		end 'arrayMethod'

		// ⚠ **A SET OR A MAP RECEIVER HAS NO ARM HERE.** Both containers are declared generics, so `s.insert(e)` and
		// `m.upsert(k, value: v)` fall through to the ordinary declared-method path — the same one every other
		// `stdlib/` type's members take.

		// ⚠ **A LIST RECEIVER HAS NO ARM HERE EITHER.** `stdlib/List.maxon` declares the type, so `l.append(x)`,
		// `try l.first()` and `l.count()` fall through to the ordinary declared-method path.

		// A `__ManagedList` RECEIVER (`ml.insertFirst(x)`, `ml.remove(node)`, `ml.clear()`) is the SAME chain
		// under the surface that hands out node handles. ⭐ **IT CARRIES THE STORAGE MASK.** A handle is a SECOND
		// OWNER of a refcounted node, so nothing on this surface can dangle one. The mask that arrives is E3207's
		// and the may-alias-a-`let`-global refusal's, which the two insertions genuinely owe.
		if self.signatures.isManagedListInstanceAt(recv.tag, nameId: recv.nameId) 'managedListMethod'
			return try self.dispatchManagedListMethod(func, list: recv.value, resultUsed: resultUsed, immutableReceiverName: recv.immutableName, receiverOwner: recv.owner, receiverStorage: self.subjectStorageMask(func, subjectName: recv.subjectName))
		end 'managedListMethod'

		// A NODE-HANDLE RECEIVER (`node.value()`, `node.next()`) — its own dispatcher because a node is not a
		// container: what it answers is the element it holds and the nodes beside it.
		//
		// ⚠ **IT CARRIES THE IMMUTABLE NAME AND THE STORAGE MASK.** `setValue` WRITES through the handle, so
		// E3207 and the may-alias-a-`let`-global refusal apply to it exactly as they do to a chain's insertions.
		if self.signatures.isManagedListNodeInstanceAt(recv.tag, nameId: recv.nameId) 'managedListNodeMethod'
			return try self.dispatchManagedListNodeMethod(func, node: recv.value, giid: recv.nameId as GenericInstanceId, resultUsed: resultUsed, immutableReceiverName: recv.immutableName, receiverOwner: recv.owner, receiverStorage: self.subjectStorageMask(func, subjectName: recv.subjectName))
		end 'managedListNodeMethod'

		// A CURSOR RECEIVER (`c.current()`, `c.advance()`) — its own dispatcher for the node arm's reason: a
		// cursor is not a container either.
		if self.signatures.isManagedMemoryCursorInstanceAt(recv.tag, nameId: recv.nameId) 'cursorMethod'
			return try self.dispatchCursorMethod(func, cursor: recv.value, giid: recv.nameId as GenericInstanceId, resultUsed: resultUsed)
		end 'cursorMethod'

		// ⚠ **A FIXED ARRAY HAS NO ARM HERE.** `stdlib/FixedArray.maxon` declares `create`, `count`, `get` and
		// `set`, so `v.get(0)` and `v.set(0, value: 42)` are taken by `memberBelongsToTheCorpus` at the top of
		// this switch and reach the ordinary declared-method path.

		// A `StringIndex` RECEIVER (`idx.charIndex()`, `idx.bytePos()`) takes its own two
		// accessors rather than the struct path, under the SAME roster-wins rule that keeps `s.byteLength()`
		// a field load: the corpus declares both accessors and the struct path would resolve them, but each
		// would then be a real CALL on the byte-position read every `slice` and every corpus grapheme walk
		// makes. Two field loads instead — see `dispatchStringIndexMethod`.
		if self.isStringIndexType(recv.tag, nameId: recv.nameId) 'stringIndexMethod'
			return try self.dispatchStringIndexMethod(recv)
		end 'stringIndexMethod'

		// ⭐ **`ws.contains(c)` HAS NO ARM HERE.** It is deliberately NOT the `StringIndex` arm's
		// case above: that one keeps a declared accessor off the struct path because the call it would emit
		// sits on a hot byte-position read. `CharacterSet.contains` has no such argument — it is a real call
		// either way — so with the corpus declaring it there is nothing for an arm here to buy.
		// A CONSTRAINED TYPE-PARAMETER RECEIVER — `self.item.digest()` where `item` is a `T`
		// and `T` is constrained `where T is Digest`. The concrete type is unknown in the shared body, so it
		// dispatches through the runtime WITNESS, not a direct call.
		//
		// ⭐ **AN EXISTENTIAL RECEIVER TAKES THE SAME ARM** — `b.run()` on a
		// `b Backend`. Its concrete type is unknown for the OTHER reason (it is chosen at run time, not
		// erased by a shared body), and the answer is the same runtime witness; what differs is only WHERE
		// the table comes from, and `dispatchWitnessMethod` reads that off the receiver's tag.
		//
		// ⚠ It must precede the builtin-conformer arm below for the reason the `String` arm precedes it: a
		// `Stringable`/`Hashable` value is held at a SYNTHESIZED protocol interface, and the conformer
		// classifier would otherwise claim the receiver and dispatch a concrete `int.hash` on a fat pointer.
		if recv.tag == ValueTypeTag.typeParameter or recv.tag == ValueTypeTag.interfaceRef 'witnessMethod'
			if recv.tag == ValueTypeTag.interfaceRef 'anInterfaceValue'
				try self.requireInterfaceMembersReachable(self.internedName(recv.nameId), memberTok: self.current())
			end 'anInterfaceValue'

			return try self.dispatchWitnessMethod(func, receiver: recv.value, resultUsed: resultUsed)
		end 'witnessMethod'

		// A BUILTIN-CONFORMER RECEIVER (`i.compare(j)`, `i.hash()`) is dispatched DIRECTLY to the synthesized
		// conformance impl rather than through the struct path, which would reject an `int` as not a struct.
		// The split is on the receiver's TYPE reduced to its conformer (`builtinConformerOfType` — the
		// parser's type oracle again). A receiver that is NOT a builtin conformer — a struct, a generic
		// instance, or a type with no conformance at all — falls through to the struct path below, which
		// resolves the first two and reports the third.
		let receiverConformer = self.builtinConformerOfType(recv.tag, nameId: recv.nameId)

		if isBuiltinConformer(receiverConformer) 'builtinConformer'
			return try self.dispatchBuiltinConformanceMethod(func, recv: recv, conformer: receiverConformer, resultUsed: resultUsed)
		end 'builtinConformer'

		// A `__ManagedFile` RECEIVER — `f.close()`. Its own dispatcher for the reason the
		// `StringIndex` arm above has one: the layout IS registered, so the struct path would accept the box
		// and then resolve `close` against `funcSignatures`, where no file declares `__ManagedFile.close`.
		if self.isManagedFileType(recv.tag, nameId: recv.nameId) 'managedFileMethod'
			return try self.dispatchManagedFileMethod(func, recv: recv)
		end 'managedFileMethod'

		// A `__ManagedDirectory` RECEIVER — `dir.next()`, and (the corpus's own spelling)
		// `wrapper.dir.next()`. Its own dispatcher for the reason the arm above has one, and it accepts the
		// same two tags for the same measured reason: a struct FIELD read carries `named`, not `structRef`,
		// and `specs/managed-directory.md`'s documented usage pattern reaches every instance method through a
		// field.
		if self.isManagedDirectoryType(recv.tag, nameId: recv.nameId) 'managedDirectoryMethod'
			return try self.dispatchManagedDirectoryMethod(recv)
		end 'managedDirectoryMethod'

		// A `__ManagedSocket` RECEIVER — `s.close()`, and (the corpus's own spelling, `stdlib/TcpClient.maxon:43`)
		// `self.socket.sendFrom(…)`. Its own dispatcher for the reason the two arms above have one, and it
		// accepts the same two tags for the same measured reason: a struct FIELD read carries `named`, not
		// `structRef`, and a `__ManagedSocket` is documented as a FIELD of a wrapper type.
		if self.isManagedSocketType(recv.tag, nameId: recv.nameId) 'managedSocketMethod'
			return try self.dispatchManagedSocketMethod(func, recv: recv)
		end 'managedSocketMethod'

		if self.isManagedPagesType(recv.tag, nameId: recv.nameId) 'managedPagesMethod'
			return try self.dispatchManagedPagesMethod(recv)
		end 'managedPagesMethod'

		if self.isManagedHandleType(recv.tag, nameId: recv.nameId) 'managedHandleMethod'
			return try self.dispatchManagedHandleMethod(recv)
		end 'managedHandleMethod'

		if self.isManagedPinType(recv.tag, nameId: recv.nameId) 'managedPinMethod'
			return try self.dispatchManagedPinMethod(recv)
		end 'managedPinMethod'

		if self.signatures.isReplyInstanceAt(recv.tag, nameId: recv.nameId) 'replyMethod'
			return try self.dispatchReplyMethod(func, recv: recv, resultUsed: resultUsed)
		end 'replyMethod'

		// AN ENUM/UNION RECEIVER — `d.isNorth()`, `s.action()`, `self.isStop()`, and also
		// `pick().score()` and `Direction.south.score()`, which the oracle accepts (measured: 10) and which
		// arrive here as VALUES rather than through the binding door.
		//
		// Gated on the `named` TAG first, which allocates nothing and is false for every struct, String,
		// Character, Array and Set receiver — so the interner read and the registry probe behind it are paid
		// only by a receiver that is an enum or a ranged alias, and a ranged alias reaching here was already
		// on its way to the struct fallthrough's refusal.
		if self.typeIsEnumOrUnion(recv.tag, nameId: recv.nameId) 'enumMethod'
			return try self.dispatchEnumMethod(func, recv: recv, resultUsed: resultUsed)
		end 'enumMethod'

		return try self.dispatchMethodOnBase(func, base: try self.structBaseOfReceiver(recv), baseTok: recv.anchor, resultUsed: resultUsed)
	end 'dispatchReceiverMember'

	function typeIsEnumOrUnion(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.named and self.signatures.containsEnumFor(self.internedName(nameId), readerFilePath: self.job.path)
	end 'typeIsEnumOrUnion'

	// Is the member about to be dispatched `cancel` on a promise? The cursor sits on the method NAME (the
	// `.` is consumed), so this peeks rather than consuming — `emitPromiseCancel` takes the token.
	function methodCallCancelsAPromise(recv MethodReceiver) returns bool
		return self.current().value.equals(PromiseCancelMethodName) and self.valueIsPromise(recv.value)
	end 'methodCallCancelsAPromise'

	// ⭐⭐ **`p.cancel()` — RECLAIM AND CANCEL THE GREEN THREAD, THROUGH THE DROP ENTRY THAT ALREADY DOES BOTH.**
	// `__gt_promise_drop` is not a reclaim with a cancel bolted on: its header calls it *"RECLAIM + CANCEL AN
	// UN-AWAITED GREEN THREAD"*, and it also runs `__gt_release_<callee>` as `ownedByThisDrop`
	// so the thread's managed arguments and its unread result-or-error are released. `cancel` wants exactly
	// that and wants it exactly once, so it CALLS that entry rather than growing a second one — which is what
	// `Runtime/AsyncReleaser.maxon`'s header already anticipated: *"Cancel routes through `promise_drop`, so
	// it inherits this rather than growing a third copy of the decision."*
	//
	// ⭐ **AND `consumePromiseThread` IS WHAT MAKES IT RUN ONCE.** It is the same door `await` uses: the
	// promise leaves this frame's `pendingTempDrops` and its owning binding is marked moved, so the
	// scope-exit gate (`not binding.movedFrom and bindingIsOwned(binding)`) emits NO second
	// `__gt_promise_drop` — which would be a double reclaim of a struct already back on the free list, and a
	// second releaser run over slots the first one freed. The runtime's `gt.releaser = 0` store is the
	// backstop behind that, in that order and for that reason.
	function emitPromiseCancel(recv MethodReceiver, resultUsed bool) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		try self.consumeEmptyArgList()
		try self.requireVoidMethodIsStatement(resultUsed, methodTok: methodTok)

		// ⭐⭐ **THE SAME OWNERSHIP QUESTION `await` ASKS, AND FOR THE SAME REASON — a reclaim this frame
		// cannot account for is not less wrong for being spelled `cancel`.** Anchored on the METHOD token,
		// the analogue of the `await` keyword: the caret belongs on the door, not on the receiver that is
		// perfectly well-formed. See `requireConsumedPromiseIsOwned` for the merge shape it catches.
		try self.requireConsumedPromiseIsOwned(recv.value, anchor: methodTok, door: promiseConsumeDoorName(PromiseConsume.cancelled))
		self.consumePromiseThread(recv.value, range: SourceRange.between(recv.anchor, last: methodTok), reclaimedBy: PromiseConsume.cancelled)

		if tiedCarrierOwnersOf(self.artifact.module, func: self.bodyFunction()).contains(recv.value) 'aTiedCancelWaits'
			let cancelling = self.bodyFunction()
			cancelling.mayYieldSeed = true
		end 'aTiedCancelWaits'

		return self.emitRuntimeCall(GtPromiseDropName, args: argsOf(recv.value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: SourceRange.between(recv.anchor, last: methodTok))
	end 'emitPromiseCancel'

	function methodCallPeeksAPromise(recv MethodReceiver) returns bool
		return self.current().value.equals(PromiseIsCompleteMethodName) and self.valueIsPromise(recv.value)
	end 'methodCallPeeksAPromise'

	function emitPromiseIsComplete(recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		try self.consumeEmptyArgList()
		return self.emitRuntimeCall(GtIsCompleteName, args: argsOf(recv.value), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: SourceRange.between(recv.anchor, last: methodTok))
	end 'emitPromiseIsComplete'

	function methodCallSelectsOverPromises(recv MethodReceiver) returns bool
		return self.current().value.equals(ArrayAwaitAnyMethodName) and self.valueIsPromiseArray(recv.value)
	end 'methodCallSelectsOverPromises'

	function emitPromiseArrayAwaitAny(recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		try self.consumeEmptyArgList()
		return try self.emitAwaitAnyCall(recv.value, anchor: methodTok)
	end 'emitPromiseArrayAwaitAny'

	function originOfValue(value ValueId) returns ReceiverOrigin
		let names = self.originNamesOf(value)

		if names.isEmpty() 'nothingExplainsIt'
			return ReceiverOrigin.unattributed
		end 'nothingExplainsIt'

		return ReceiverOrigin.derivedFrom(names)
	end 'originOfValue'

	function originNamesOf(value ValueId) returns NameRoster
		let names = NameRoster.create(0)
		let brand = self.brandOf(value)

		if not brand.isEmpty() 'aBrandedValue'
			names.push(brand)
		end 'aBrandedValue'

		match self.sourceOfValue(value) 'source'
			producedByCall(callee, receiver) then self.noteCallOrigins(callee, receiver: receiver, into: names)
			boundOutOf(unionName) then names.push(unionName)
			unknown then break
		end 'source'

		return names
	end 'originNamesOf'

	function noteCallOrigins(callee ByteArray, receiver ReceiverArgument, into NameRoster)
		into.push(genericTemplateName(callee))

		match receiver 'receiver'
			passed(value) then self.noteReceiverOrigins(value, into: into)
			none then break
		end 'receiver'
	end 'noteCallOrigins'

	function noteReceiverOrigins(value ValueId, into NameRoster)
		for name in self.originNamesOf(value) 'eachReceiverOrigin'
			into.push(name)
		end 'eachReceiverOrigin'
	end 'noteReceiverOrigins'

	function sourceOfValue(value ValueId) returns ReceiverSource
		if self.artifact.currentFuncIndex >= self.artifact.module.funcCount() 'noBodyHoldsTheValue'
			return ReceiverSource.unknown
		end 'noBodyHoldsTheValue'

		for blockRef in self.bodyFunction().blockRefs 'eachBlock'
			let block = try self.artifact.module.blocks.get(blockRef) otherwise panic("sourceOfValue: blockRef from the body function's blockRefs not in module.blocks")

			for opIdx in block.bodyOps() 'eachOp'
				let source = self.sourceOfCallAt(opIdx, value: value)

				match source 'source'
					producedByCall then return source
					boundOutOf or
					unknown then break
				end 'source'
			end 'eachOp'
		end 'eachBlock'

		return self.payloadSourceOf(value)
	end 'sourceOfValue'

	function payloadSourceOf(value ValueId) returns ReceiverSource
		for (_, binding) in self.bodyState.scope.allVars() 'eachBinding'
			if binding.isPayloadBinding() and binding.boundValue == value 'theBindingOfThisPayload'
				return ReceiverSource.boundOutOf(self.internedName(self.valueNameId(binding.payloadScrutBox())))
			end 'theBindingOfThisPayload'
		end 'eachBinding'

		return ReceiverSource.unknown
	end 'payloadSourceOf'

	function sourceOfCallAt(opIdx ElementIndex, value ValueId) returns ReceiverSource
		return match self.routableOpAt(opIdx) 'producer'
			call(result, callee, receiver) gives receiverSourceOfCall(result, value: value, callee: callee, receiver: receiver)
			tryChannelCall(result, callee, receiver) gives receiverSourceOfCall(result, value: value, callee: callee, receiver: receiver)
			notRoutable or
			division or
			witness or
			send or
			await gives ReceiverSource.unknown
		end 'producer'
	end 'sourceOfCallAt'

	// The `StructBase` a receiver that reached the struct fallthrough denotes — the value form of
	// `requireStructBase`, sharing its layout resolution and differing only in that a VALUE has no binding
	// to prove live and no self-field alias to materialize (its producer already did both).
	//
	// A tag with no methods at all lands here, and this is where it is reported: a `float`, a `void` call
	// result, an enum value, a function value. The message names the member rather than the type's fields,
	// because reaching this point means a `.` followed a value the language gives no member access to.
	function structBaseOfReceiver(recv MethodReceiver) returns StructBase throws SourceParseError
		if not self.tagCarriesStructLayoutHere(recv.tag) 'notAStruct'
			let memberTok = self.current()

			// ⚠ The third of `requireDeclaredBaseTypeName`'s doors — a receiver with no binding to name, whose
			// refusal called it a `'int'` value: the same invented type in a third wording, which is why the
			// three doors now share the ONE verdict and none of them words this fact for itself.
			try self.requireDeclaredBaseTypeName(recv.tag, nameId: recv.nameId, tok: memberTok)

			// ⭐⭐ **THE SENTENCE NAMES THE GATE'S THREE ARMS, NOT A ROSTER OF TYPES.** A hand-spelled roster of
			// builtin type names, one file away from the code that decides, is this project's signature bug in a
			// USER-FACING string: it goes stale the moment a container is retired.
			//
			// ⚠ **DERIVING IT FROM `isBuiltinGenericBaseName` IS THE WRONG ROSTER**, not merely a costly one.
			// That predicate answers `Array`, `List`, `FixedArray`, `__ManagedList`, `__ManagedListNode`,
			// `__ManagedMemoryCursor` — three reserved spellings no user program may write, and it names none of
			// `String`/`Character`/`StringIndex`/`CharacterSet`. Generating from it would replace a stale list
			// with a WRONG one.
			//
			// ⇒ The gate is `tagCarriesStructLayoutHere` on the line above, and it admits exactly three
			// things: a `structRef`, a `genericInstance`, and a BYTE RECORD whose corpus declaration is
			// loaded (`tagIsByteRecord` — `String` and `Character`, and only those two). Every builtin name is
			// already one of the first two: an `Array`/`Set`/`Map` value is a
			// `genericInstance`, a `StringIndex` and a `CharacterSet` are `structRef`s. A sentence that
			// enumerates nothing cannot go stale when a container is retired or added.
			throw SourceParseError.memberAccessOnNonStruct("a member access '{String.from(memberTok.value)}' on a '{self.valueKindWord(recv.value)}' value — only a struct, a generic instance and the byte records (`String`, `Character`) carry members here", line: memberTok.line, column: memberTok.column, origin: self.originOfValue(recv.value))
		end 'notAStruct'

		// ⚠ **AN AGGREGATE-TYPED SELF-FIELD ALIAS IS REFUSED HERE ONLY WHEN NO VALUE OF ITS TYPE COULD EXIST**
		// — `specs/self-field-struct-typed.md` pins the refusal and its own sabotage note says the method
		// case does not merely go red without it, it goes GREEN WITH THE WRONG CODE. It sits at the FALLTHROUGH
		// and not in front of the switch because every builtin arm above serves such an alias correctly and by
		// design (`items.push(v)`, `name.append("!")` — `baseBoxOf`'s header measures both).
		//
		// ⭐⭐ **THE PREDICATE IS CONSTRUCTIBILITY.** The case is not that a struct-typed field is unlowerable
		// — the box IS loaded correctly, by
		// `baseBoxOf`, before this receiver is built — but the `mintPhi` trap: `type Node`'s
		// `var next as Node` needs a `Node` to put there and there is no `null` and no base case, so NO PROGRAM
		// COULD OBSERVE the load being right. That argument holds for a type on a cycle in the struct-field
		// graph and for nothing else. `type Outer`'s `var inner as Inner` is built by
		// `Outer.create(Inner.create(42))`, `inner.get()` is the program `specs/method-calls.md` writes,
		// and the explicit `self.inner.get()` spelling of the very same call compiles and answers 42
		// through this same fallthrough — the two spellings of one access must not disagree.
		// `ProgramSignatures.structTypeIsConstructible` is the one home of that question, cycles and all.
		//
		// ⭐ **`requireStructBase` ASKS THE SAME NARROWED QUESTION**, through the same function, and
		// materializes the field through `baseBoxOf` exactly as this door's producer does. Reading the box off
		// `binding.boundValue` instead is 0, the RECEIVER — the silent `return self.a` its own header records.
		// One predicate, one sentence.
		//
		// ⚠ The gate is NESTED INSIDE the alias arm, not hoisted above it. `structLayoutOfType` below resolves
		// the same name for itself, but this door is on the path of EVERY method dispatch in the program while
		// a self-field alias base is rare — so lifting the resolution out to share it would pay it on every
		// call to save one dense-column index on almost none. It stays where only the alias path reaches it,
		// exactly as the enum arm above gates on its TAG before touching the interner.
		if let fieldName = try recv.selfFieldName.fieldName() 'selfFieldAlias'
			try self.requireConstructibleSelfFieldBase(recv.tag, nameId: recv.nameId, fieldName: fieldName, anchor: recv.anchor)
		end 'selfFieldAlias'

		return StructBase.create(try self.structLayoutOfType(BaseAccessKind.member, tag: recv.tag, nameId: recv.nameId, baseTok: recv.anchor), box: recv.value, immutableName: recv.immutableName, subjectName: recv.subjectName)
	end 'structBaseOfReceiver'

	// ⭐⭐ **MAY A SELF-FIELD ALIAS OF THIS AGGREGATE TYPE BE A BASE AT ALL? — ONE PREDICATE FOR THE TWO
	// DOORS THAT CAN HOLD ONE**, the METHOD receiver (`structBaseOfReceiver`) and the field-chain BASE
	// (`requireStructBase`). Both materialize the box before they get here; what is left to decide is whether
	// a value of the field's type could exist at all, and that is `ProgramSignatures.structTypeIsConstructible`'s
	// one home — a walk over the struct-field cycle, not a name comparison.
	//
	// ⚠ **THE PREDICATE AND THE SENTENCE TRAVEL TOGETHER, AND THAT IS THE POINT.**
	// `specs/self-field-struct-typed.md` pins three cases against the identical text at two doors; while
	// the two doors asked the same question in two places, one of them could be narrowed and the other left
	// behind. Asking through here is
	// what makes a future narrowing arrive at both doors or at neither.
	function requireConstructibleSelfFieldBase(tag ValueTypeTag, nameId TypeNameId, fieldName ByteArray, anchor Token) throws SourceParseError
		if not self.signatures.structTypeIsConstructible(self.baseStructNameOfType(tag, nameId: nameId, baseTok: anchor)) 'inconstructible'
			throw SourceParseError.unsupported(structTypedSelfFieldBaseMessage(fieldName), line: anchor.line, column: anchor.column)
		end 'inconstructible'
	end 'requireConstructibleSelfFieldBase'

	// ⭐ **DISPATCH A METHOD ON AN ENUM/UNION RECEIVER.** The cursor sits on the member NAME. The
	// callee is mangled from the receiver's declared ENUM NAME and the member name — the very key
	// `parseFunction` declared the method under (`declaredMethodName`) — and the receiver is prepended as
	// argument 0 by the shared `parseCallNamed`. Nothing below the parser learns that enums have methods.
	//
	// ⚠ **THERE ARE TWO ARMS SINCE enum-hashable, and the mangled callee is only the FIRST.** A member the
	// enum does not declare may still be one of the `Hashable`/`Equatable` requirements the compiler GRANTS
	// every payload-free enum, which is a conformance dispatch and not a method call at all — see the arm
	// below. Both arms are exhaustive over one lookup, so a member reaches exactly one of them.
	//
	// ⭐ **ROUTING IT THROUGH THE ONE SWITCH GIVES IT A VALUE RECEIVER AS WELL AS A BINDING ONE.**
	// `pick().score()` and `Direction.south.score()` are programs the oracle runs, and an arm reachable only
	// from `dispatchMethodOnBinding` answers `E2015: Unsupported: . statement` for both. It needs nothing
	// added — an enum value carries its name in the same column a binding's declared type does.
	//
	// ⭐ **THE RECEIVER IS BORROWED, exactly as a struct's is** (`parseMethodCall`'s header argues it in
	// full). A payload-free enum's receiver is a bare i64 tag with no ownership at all; a BOXED union's is
	// a pointer the caller's binding owns, so no incref is emitted HERE and no drop there. The callee cannot
	// leak it either — `return self` from a boxed union takes the SAME hand-off PROMOTION a
	// `returns Container` on a `c Container` parameter does, minting its own `__mm_retain` inside the
	// callee. Either way `self`
	// IS parameter 0, so it is not a special case; it is the ordinary parameter rule reaching it, and the
	// call site's own accounting is unchanged because the callee pays for whatever it hands back.
	//
	// The three facts it shares with the struct path — liveness, the E3207 blame name and the storage
	// subject — are asked through the same three functions, so an enum receiver and a struct receiver
	// cannot come to disagree about a use-after-move, an immutable receiver or a written parameter.
	function dispatchEnumMethod(func IrFunction, recv MethodReceiver, resultUsed bool) returns ValueId throws SourceParseError
		// The enum's name comes from the receiver's TYPE, never from the anchor token: the anchor is a
		// variable's name (`d`), a `.` for a temporary, and `self` is not even an identifier.
		let memberTok = self.current()
		let enumName = self.internedName(recv.nameId)
		let enumLayout = requireEnumLayout(self.signatures.enumFor(enumName, readerFilePath: self.job.path))
		try self.requireMethodReachable(func, typeName: enumName, visibility: enumLayout.visibility, declFilePath: enumLayout.declFilePath, methodName: memberTok.value, anchor: memberTok)
		let callee = qualifiedMethodName(enumName, methodName: memberTok.value)

		// ⭐⭐ **`d.hash()` AND `a.equals(b)` ON AN ENUM ARE THE GRANTED CONFORMANCE, NOT A MISSING METHOD.** An enum has
		// the conformance by declaration alone, so without a door on the value side both would be
		// `E3004: call to undefined function 'Direction.hash'`. This is that door,
		// and it resolves the member against the SAME intrinsic-conformance row the E3017 answer and the
		// witness slot read (`isIntrinsicBuiltinConformance`'s `payloadFreeEnum` arm) — so the set of members
		// it serves cannot come to differ from the set of protocols the enum is held to conform to.
		//
		// ⚠ **IT IS ASKED ONLY WHERE THE ENUM DECLARES NO METHOD OF THAT NAME**, the precedence a user
		// override has over synthesis, and here it costs nothing to honour: the declared method is the
		// ordinary call below, and `enumConformanceImplName` answers with that same key, so the
		// witness slot follows the door rather than contradicting it.

		// ⭐⭐ **`u.clone()` ON A BOXED UNION — the struct door's twin, past the same `declaresCallee` test so a
		// user-written `<U>.clone` still wins.** `MmRuntime.synthesizeUnionCloner` already emits the body (a
		// fresh box, a whole-box blit, then a deep clone of the LIVE case's managed payloads), and
		// `installUnionCascades` builds exactly the ones `__clone_` callees root — so this is a call site, not
		// a synthesis pass, exactly as `emitSynthesizedStructClone` is.
		//
		// ⚠ **THE RESULT'S TYPE IS THE WHOLE POINT.** Without this arm the member resolved to a `<U>.clone` no
		// file declares, so `parseCallNamed` minted an `unknown`-tagged result and the union's identity was
		// gone: a `match` on it took the SCALAR path (`enumMatchFor` reads `named`), reporting a missing
		// enum-case-pattern feature, and a member read on it reported "a member access on a 'unknown' value" —
		// two diagnostics about the value's TYPE, on top of the E3004 the call itself owed.
		//
		// ⭐ **A PAYLOAD-FREE ENUM IS DELIBERATELY NOT SERVED HERE.** Its value is a bare i64 tag with no box
		// to allocate, `synthesizeUnionCloner` would `__mm_alloc` one anyway, and the oracle refuses the
		// spelling outright (E4006 `has no property or method named 'clone'`); it keeps the undefined-function
		// refusal it already had.
		match self.boxedUnionCloneReceiver(enumName, callee: callee, memberTok: memberTok) 'synthesizedClone'
			declared(layout) then return try self.emitSynthesizedUnionClone(recv, layout: layout, memberTok: memberTok)
			undeclared then break
		end 'synthesizedClone'

		match self.enumGrantedConformanceMethod(enumName, memberName: memberTok.value) 'granted'
			supplied(method) then return try self.dispatchEnumConformanceMethod(func, recv: recv, enumName: enumName, method: method, memberTok: memberTok)
			notSupplied then return try self.parseCallNamed(func, callee: callee, anchor: memberTok, receiver: self.writtenReceiver(recv.value, immutableName: recv.immutableName, anchor: recv.anchor), resultUsed: resultUsed, constructorInstance: ConstructorInstance.none, mint: CalleeMint.resolvedTypeQualifier)
		end 'granted'
	end 'dispatchEnumMethod'

	// Which member of `enumName` this call reaches through the GRANTED conformance rather than through a
	// declared method — `notSupplied` for every member an enum body declares itself, and for every name the
	// granted row does not carry (a `union`'s, since the row is withheld from one, and anything that is not
	// `hash`/`equals`). Its two answers are the two arms of the dispatch above, so a member cannot be claimed
	// here and then looked for as a declaration.
	//
	// ⚠ **THE DECLARED-METHOD PROBE COMES FIRST AND IT IS WHAT KEEPS THIS OFF THE HOT PATH.** The row walk
	// below builds a protocol-name array, and EVERY enum method call in every program arrives here — so
	// `d.isNorth()` must not pay for it. A declared member is one map lookup and returns; the walk is reached
	// only by a member no declaration answers, which is a call already bound for the granted conformance or
	// for a diagnostic.
	//
	// ⚠⚠ **THE PROBE IS `ProgramSignatures.enumDeclaresOwnConformanceMethod` AND MAY NOT BE INLINED BACK TO
	// A `declaresCallee` OF ITS OWN.** Three doors turn on this one question — this dispatch, the witness
	// slot's impl name, and E3130's check — and two copies of the same join would let the rule be
	// refined at one, so `e.hash()` would call one body while the map stamps another.
	function enumGrantedConformanceMethod(enumName ByteArray, memberName ByteArray) returns BuiltinConformerMethodLookup
		if self.signatures.enumDeclaresOwnConformanceMethod(enumName, methodName: memberName) 'theEnumDeclaresIt'
			return BuiltinConformerMethodLookup.notSupplied
		end 'theEnumDeclaresIt'

		return builtinConformerMethod(enumName, methodName: memberName, discovered: self.signatures.discoveredConformerOf(enumName), interfaces: self.signatures.interfaceMap())
	end 'enumGrantedConformanceMethod'

	// ⭐ **EMIT ONE GRANTED-CONFORMANCE CALL ON AN ENUM RECEIVER** — the cursor sits on the member NAME, which
	// the shared `emitBuiltinConformanceCall` consumes along with the argument list, so the arity check, the
	// `Self`-argument rule and the result typing are the ones every direct conformance dispatch already uses.
	//
	// ⭐ **THE RECEIVER AND ITS `Self` ARGUMENT TRAVEL AS THEIR ENUM-TYPED VALUES AND ARE NOT CONVERTED, WHICH
	// IS THE `int` IMPL'S ABI ALREADY.** An enum value IS its i64 tag in a GPR and resolves to
	// `MaxonType.integer` below the parser, so `int.hash`/`int.equals` receive exactly the i64 they expect —
	// the same handoff `emitEnumRawValue` makes when it passes a tag straight to `__char_from_cp`. Emitting a
	// `+ 0` retag (`enumTagAsANumber`) would buy nothing here: that exists to give an ORDINAL a type of its
	// own, and no result of this call carries the enum's type.
	function dispatchEnumConformanceMethod(func IrFunction, recv MethodReceiver, enumName ByteArray, method InterfaceMethodSig, memberTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.identifier)
		return try self.emitBuiltinConformanceCall(func, receiver: recv.value, target: DirectConformanceTarget.enumTagValue(enumName), method: method, baseTok: recv.anchor, methodTok: memberTok)
	end 'dispatchEnumConformanceMethod'

	// ⭐⭐ **THE BOX A BASE BINDING DENOTES — and a SELF-FIELD ALIAS is the one that has to be MATERIALIZED
	// first.** Every other binding already holds its value; a self-field alias holds NONE.
	// `VarInfo.createSelfField` leaves `boundValue` 0 because a read of the alias is a `loadIndirect`
	// through the receiver — **and ValueId 0 IS the receiver** — so a door that took `boundValue` on its own
	// addressed the enclosing struct's BOX as if it were the field.
	//
	// ⚠ **BOTH HALVES OF THAT ARE WRONG, and one of them silently.** With `var items as IntArray`
	// inside `type Bag`:
	//   • `items.count()` inside a method compiles clean and answers **0** for an array holding one
	//     element — `__managed_count` is handed the Bag's box and reads its second word. A wrong answer with
	//     no diagnostic anywhere, and the runnable oracle answers 1.
	//   • `items.push(v)` is **E3207** — a false rejection of an ordinary struct-with-a-container method,
	//     because the alias is neither `isMutable()` nor `isParameter`, so `immutableReceiverNameOf` blames it.
	//     The oracle accepts it. That half is `baseBindingOf`'s, below; this one is the load.
	//
	// ⭐⭐ **THE FIELD-CHAIN BASE ASKS THIS RATHER THAN REFUSING.** With no materialization of its own,
	// `requireStructBase` refuses EVERY struct-typed self-field alias — `inner.x` and `inner.x = 7` are
	// E2015 one function away from an `inner.get()` that compiles and runs (exit 41), and the
	// `self.inner.x = 7` spelling of that same write answers 7. Three spellings of one access, two served
	// and one refused, is the asymmetry this being a shared function ends.
	function baseBoxOf(binding VarInfo, baseTok Token) returns ValueId throws SourceParseError
		if binding.isSelfField 'materializeTheField'
			return try self.parseSelfFieldRead(baseTok, site: CellArgumentToken.none, binding: binding)
		end 'materializeTheField'

		return self.bindingValue(binding, range: SourceRange.ofToken(baseTok))
	end 'baseBoxOf'

	// ⭐⭐ **THE BINDING A BASE'S WRITABILITY IS ASKED OF — the alias MATERIALIZED, anything else itself.**
	// A self field's writability is the FIELD's own `var`/`let` (`selfFieldIsWritable`), not the alias
	// binding's: the alias is built `BindingKind.let` because a REBIND of it is never legal, and the receiver
	// it hangs off is a parameter and so is never `isMutable()` either. Both of the doors that ask — E3207's
	// receiver door (`immutableReceiverNameOf`) and E2013's instance door (`requireWritableInstance`), which
	// that second function's header calls *"one write of one record under two spellings"* — read
	// `mutable`/`isParameter` off a binding, so the materialized one is what carries them the answer.
	//
	// ⚠ **IT TAKES THE BOX RATHER THAN LOADING ONE, AND THAT IS WHY IT IS SPLIT FROM `baseBoxOf`.** The
	// field-chain door asks the two questions at two different moments — `requireStructBase` resolves the box
	// as part of proving the base is a struct at all, and the WRITE check happens later, after the chain has
	// been walked and the field resolved (`parseFieldAssignment`'s rank order). Re-deriving the binding from
	// the box it already holds emits nothing; loading again would emit a second `loadIndirect` nobody reads.
	function baseBindingOf(binding VarInfo, baseTok Token, box ValueId) returns VarInfo throws SourceParseError
		if not binding.isSelfField 'holdsItsOwnValue'
			return binding
		end 'holdsItsOwnValue'

		return try self.selfFieldValueBinding(binding, baseTok: baseTok, value: box)
	end 'baseBindingOf'

	// ⭐ **THE MATERIALIZED FORM OF A SELF-FIELD ALIAS, GIVEN THE VALUE THAT STANDS FOR IT.** Two doors reach
	// it and they differ ONLY in where that value comes from: the ordinary one loads the field
	// (`baseBoxOf`), the field-chain base re-derives it from the box that door already loaded
	// (`baseBindingOf`), and the fused-wrapper record door hands over the RECEIVER
	// (`dispatchMethodOnBinding`'s `inlineManagedServesTheRecord`, which mints nothing).
	//
	// ⚠ It is a function rather than two constructions because everything ELSE about the binding — the blame
	// NAME, the declared TYPE, and the writability rule that must ask the FIELD's `var`/`let` rather than the
	// alias's (`selfFieldIsWritable`, whose header records the false E3207 the other question produced) — is
	// the same in both, and a second construction is where those three come to disagree.
	function selfFieldValueBinding(binding VarInfo, baseTok Token, value ValueId) returns VarInfo throws SourceParseError
		return VarInfo.createValueBinding(baseTok.value, varType: binding.varType, kind: bindingKindOfMutability(try self.selfFieldIsWritable(binding, nameTok: baseTok)), boundValue: value, brandId: self.brandIdOf(value))
	end 'selfFieldValueBinding'

	// ⭐ **MAY A SELF-FIELD ALIAS BE WRITTEN THROUGH? — THE FIELD'S OWN `var`/`let`, NEVER THE BINDING'S.**
	// `createSelfField` binds every alias `BindingKind.let` and says why (a rebind of the alias is never legal),
	// so asking the BINDING calls a `var` field immutable — the false E3207 `baseBoxOf`'s header
	// measures. `layout.fieldIsMutable` is the SAME column `emitCheckedSelfFieldStore` asks of `n = 1`.
	//
	// ⚠ **BOTH ASKERS COME THROUGH HERE, AND THAT IS WHY IT IS A FUNCTION.** A method RECEIVER (`items.push(v)`)
	// and a bare-name ARGUMENT (`grow(items)`, whose blame name `parseVariableReference` publishes) are the same
	// question about the same field. They were derived twice — once as `mutable:`, once as `not …` — and an
	// INVERTED restatement is the shape that lets a `var` field become one a method may push onto but no callee
	// may be handed, with nothing in either site to say the other exists.
	//
	// The alias's binding is what this door holds; the rule itself is keyed on the field INDEX
	// (`StructLayout.fieldIsMutable`), which is all a by-reference hand-over has.
	function selfFieldIsWritable(binding VarInfo, nameTok Token) returns bool throws SourceParseError
		return (try self.enclosingLayout(nameTok)).fieldIsMutable(binding.fieldIndex)
	end 'selfFieldIsWritable'

	// ⭐ **COULD THE `<base> . <member> (` AT `index` BE A METHOD CALL ON A TOP-LEVEL MANAGED BINDING?** — a
	// `let` or a `var`. The ONE gate in front of both askers — `methodCallsAt` (is
	// this token shape a method call at all?) and `parseMethodCall` (build the receiver) — for
	// `methodCallsAt`'s own stated reason: a receiver test written twice is free to drift, and the drift
	// is silent.
	//
	// **COULD**, not IS: it answers over the whole program's managed NAMES and the competing type-based
	// readings, and deliberately not over what this FILE can see. Whether the name resolves to a binding
	// visible here is `managedReceiverBindingOf`'s answer, and both askers go on to ask it — so a `true`
	// here is permission to resolve, never a claim on the shape.
	//
	// ⭐ **BOTH KINDS ANSWER HERE, THROUGH ONE FILTER AND ONE `moduleLevelBindingHeadsAt`.** They are the same
	// question — "does this base name a managed record rather than a type?" — and asking it twice would
	// pay the type-reading probe twice for every managed base and, worse, allow a future rule taught to
	// one door and not the other. Which KIND it is matters only to `parseMethodCall`, where it decides
	// `mutable`, and that comes out of the ONE `managedReceiverBindingOf` below.
	//
	// ⚠⚠ **IT RETURNS A BOOL, AND THAT IS A COST DECISION WITH A MEASUREMENT BEHIND IT.** The obvious
	// tidier shape is to fold this into `managedReceiverBindingOf` and hand every caller the binding — but
	// a Maxon union VALUE IS A HEAP OBJECT, including the payload-free `none`, so a union-returning gate
	// allocates once per DOTTED CALL IN THE PROGRAM rather than once per managed-receiver call site. So the
	// gate that decides "may this allocate?" must not itself allocate to say no.
	//
	// It takes the base's INDEX rather than its token because the answer needs the MEMBER name too
	// (`moduleLevelBindingHeadsAt`), and deriving that from a token would re-assume the cursor is parked on
	// the base — true at both askers today, and exactly the premise that quietly stops holding.
	//
	// ⚠ **THE `namesManagedTopLevel` FILTER IS NOT AN OPTIMIZATION, IT IS THE COST MODEL.**
	// `methodCallsAt` runs at every dotted-call shape in the program, and the file-scoped probes behind
	// this gate BUILD A STRING KEY (~4 allocations per call — see `fileScopedDeclKey`). In front of it a
	// base that is not spelled like any managed binding in the program — every static call,
	// `Widget.create(…)` and `String.from(…)` alike, which is nearly every base that reaches here — costs
	// ONE hash of bytes it already holds and allocates nothing. `moduleLevelBindingHeadsAt` sits BEHIND the
	// same filter and inherits the same model: it runs only for a base actually spelled like a managed
	// binding, so its type-reading probes are off the hot path entirely.
	//
	// It is a NAME set rather than a whole-program bool because a bool goes permanently
	// true at the first managed binding, and every static dotted call in the program then pays the full
	// probe to be told no. See `ProgramSignatures.managedTopLevelNames`.
	function managedTopLevelBaseAt(index ElementIndex) returns bool
		if self.qualifiedTypeBaseIsAt(index) or not self.signatures.namesManagedTopLevel(self.tokenAt(index).value) 'notAManagedName'
			return false
		end 'notAManagedName'

		return self.moduleLevelBindingHeadsAt(index)
	end 'managedTopLevelBaseAt'

	// ⭐ **WHAT A MANAGED TOP-LEVEL NAME DENOTES AT A RECEIVER POSITION — the ONE resolution**, asked by
	// both readers past `managedTopLevelBaseAt`: `methodCallsAt` to decide whether the token shape is a
	// method call at all, `parseMethodCall` to build the receiver. Two probes with two arm orders would be
	// two encodings of "which door claims this name", and the failure mode is silent — one door claiming
	// the shape and the other resolving it differently.
	//
	// One storage key holds ONE declaration (`recordDecl`), so the two doors are
	// disjoint by construction and the order below is a cost preference, not a precedence: the constant is
	// asked first because a managed `let` is the commoner declaration.
	//
	// ⚠ It BOXES a union per call — `none` included, which is why the GATE in front of it is a bool. That
	// is affordable only because of the gate: it runs solely for a base actually spelled like a managed
	// binding, i.e. once per managed-receiver call SITE at parse time, never per dotted call in the program.
	// A program with no managed binding — the whole scale corpus — never reaches it. The box is 1
	// allocation; testing this as a predicate and then re-resolving the identical name to build the receiver
	// pays it twice more, read on a 16,384-site same-lineage ladder as exactly 12.000 allocations per
	// managed-`var` site and 6.000 per managed-`let` site. Passing the answer along instead makes "the two
	// read the same resolution and cannot disagree" true by construction rather than an assertion.
	function managedReceiverBindingOf(tok Token) returns ManagedReceiverBinding
		if self.job.initializerRole == InitializerRole.sweepFold 'aSweepHasNoReceiverYet'
			return ManagedReceiverBinding.none
		end 'aSweepHasNoReceiverYet'

		match self.constantLookup(tok.value, readerFilePath: self.job.path) 'constant'
			found(payload, tag, typeName) then return ManagedReceiverBinding.inlineWord(payload, typeName: typeName) if tagNamesADeclaredType(tag) else ManagedReceiverBinding.none
			foundManaged(bytes, kind) then return ManagedReceiverBinding.constant(bytes, kind: kind)
			foundImageRecord(image) then return ManagedReceiverBinding.imageRecord(image)
			foundImageBox(nodes, root, typeName, tag) then return ManagedReceiverBinding.imageBox(nodes, root: root, typeName: typeName, tag: tag)
			recordDeferred then panic("Parser.managedReceiverBindingOf: '{String.from(tok.value)}' is a deferred record — the sweep returns before this probe and the record probe settles every record it reads")
			notFound then break
			poisoned then return ManagedReceiverBinding.poisoned
		end 'constant'

		return match self.signatures.globalDeclFor(tok.value, readerFilePath: self.job.path, into: self.artifact.typeNames) 'global'
			found(label, valueType, _) gives ManagedReceiverBinding.global(label, valueType: valueType)
			notFound gives ManagedReceiverBinding.none
			poisoned gives ManagedReceiverBinding.poisoned
		end 'global'
	end 'managedReceiverBindingOf'

	// ⭐⭐ **DOES A TYPE-BASED READING ALREADY CLAIM THIS `<base> . <member> (`?** A managed constant is the
	// WEAKEST claim on that shape, and this is what says so.
	//
	// ⚠ **IT IS THE MIRROR OF `parseDottedPrimary`'S ARM ORDER, AND IT EXISTS BECAUSE THE MANAGED-CONSTANT
	// ARM BROKE THAT ORDER'S PREMISE.** `methodCallsAt`'s header states it: the token shape alone cannot
	// tell `c.increment()` from `Point.create()`, and "only the scope knows which". That held while every
	// receiver was a LOCAL or a CAPTURE — a name was a value or a type, never both. A top-level managed
	// constant is the first receiver that can share its spelling with a declared type, so the shape has to
	// be decided against the type-based readings instead of ahead of them. `methodCallsAt` is asked FIRST
	// of the three dispatchers' arm chains, so without this the constant silently outranks all of them.
	//
	// **MEASURED AGAINST THE RUNNABLE ORACLE, one program at a time.** With `let Widget = "abcdefghij"`
	// beside a `type Widget`, the oracle answers 42 for `Widget.byteLength()` when the type declares that
	// static and 10 — the CONSTANT's byte length — when it declares only `create`. So the rule is not
	// "a type name always wins": the type-based reading is TRIED FIRST and the constant is its FALLBACK,
	// which is exactly what asking the three claims below reproduces. Without it the compiler answered 10 in both
	// cases, silently, with no diagnostic and a green suite.
	//
	// Each clause delegates to the authority that arm already uses — none of them re-derives what a type
	// is:
	//
	//   • `containsEnum` — the enum/union arm, which claims a payload CONSTRUCT `Move.walk(5)`; that has
	//     the same token shape a static call does (`parseDottedPrimary` says so where it orders the two).
	//   • `isGenericAlias` — the `IntArray.create()` / `IntSet.create()` statics `parseQualifiedCall`
	//     intercepts AHEAD of its own mangle. They are the one type-based claim the callee probe below
	//     structurally cannot see: `Array`/`Set` have no base struct, so their statics lower to the array
	//     and set runtimes and NO file declares an `Array.create` to be found.
	//   • a DECLARED callee under the mangled static name — every plain struct's `Widget.byteLength`, and
	//     a user generic alias's `IntBox.create` through its base. The answer is the SAME resolution
	//     `parseQualifiedCall` reads (`resolveStaticMember`) rather than one re-derived here: two derivations
	//     of one callee name is the drift `qualifiedStaticCallsAt` documents at length, and its failure is a
	//     call accepted at one door and refused at the other.
	function staticCallClaimsBase(index ElementIndex) returns bool
		let written = self.tokenAt(index).value

		// ⚠ **THE SAME KEY `parseQualifiedCall` RESOLVES**, for the reason the third bullet already gives
		// about the callee name: the two doors must not read one written spelling as two different aliases, or a
		// call is claimed at one and refused at the other. An INNER alias is keyed base-qualified, so asking the
		// bare member here would hand the base to the managed-constant fallback for exactly the aliases
		// `parseQualifiedCall` does resolve.
		let baseName = self.genericAliasKeyFor(written)

		if self.signatures.containsEnumFor(baseName, readerFilePath: self.job.path) or self.signatures.isAliasOfFormFor(baseName, readerFilePath: self.job.path, wanted: FormAliasKind.generic) 'enumOrGenericAlias'
			return true
		end 'enumOrGenericAlias'

		return match self.resolveStaticMember(self.tokenAt(index), baseIndex: index, aliasName: baseName) 'member'
			surface or
			minted gives true
			named(_, declaredByAFile) gives declaredByAFile
			directory or
			requirement or
			refused gives false
		end 'member'
	end 'staticCallClaimsBase'

	// Dispatch a method (or a function-typed FIELD load) on an already-resolved struct base — the shared tail
	// of a LOCAL receiver and a CAPTURED one. The cursor sits on the member name.
	//
	// A member that is a FUNCTION-typed FIELD, not a method — `h.op(21)` / `self.op(x)`, where `op` is a
	// function-typed field — is an INDIRECT call, not a method dispatch: load the field (a `function`
	// value) and let the postfix loop (`parsePostfix`) apply the `(args)`. Only a FUNCTION-typed field diverts
	// here — a non-function field followed by `(` (`p.count(…)` on an int field) is not a callable member and
	// falls through to the method path, which reports it as an unknown method. `resultUsed` does not apply to
	// the field load: the value/statement position is decided at the indirect call the postfix loop emits.
	function dispatchMethodOnBase(func IrFunction, base StructBase, baseTok Token, resultUsed bool) returns ValueId throws SourceParseError
		// PEEKED, not consumed: the method path below hands the cursor to `parseCallNamed`, which consumes
		// the name itself. Only the field-read branch advances.
		let memberTok = try self.memberNameTokenAt(self.pos)
		let access = self.memberAccessOn(base.layout, memberTok: memberTok)

		match access 'gate'
			methodCall then try self.requireMethodReachable(func, typeName: base.layout.name, visibility: base.layout.visibility, declFilePath: base.layout.declFilePath, methodName: memberTok.value, anchor: memberTok)
			fieldRead or
			missingField then try self.requireMembersReachable(base.layout.name, visibility: base.layout.visibility, declFilePath: base.layout.declFilePath, memberTok: memberTok)
		end 'gate'

		// ⭐⭐⭐ **A MEMBER CALL ON A `<T>.handle` IS A MESSAGE SEND, AND THAT IS THE WHOLE OF LOCATION
		// TRANSPARENCY.** Dispatch is decided by the RECEIVER's type: a `Calc` value takes direct
		// calls, a `Calc.handle` takes messages, and `c.bump(3)` is spelled identically either way. Intercepted
		// HERE, ahead of the field/method split, because a handle has exactly one field — the cown, at
		// `Visibility.unexported` — and every member an author can name on one is a message, `clone` or `shutdown`.
		//
		// ⚠ **ALL THREE DISPATCH ENTRIES FUNNEL THROUGH THIS FUNCTION**, so one interception covers a handle
		// held by a binding (`h.bump()`), one reached through a chain (`self.sink.say(s)`) and one a postfix
		// walk produced. A second copy at each door is exactly the drift `dispatchMethodOnBase`'s own header
		// warns about one paragraph down.
		if self.signatures.isServiceHandle(base.layout.name) 'aServiceHandle'
			return try self.dispatchOnServiceHandle(func, base: base, baseTok: baseTok, memberTok: memberTok, resultUsed: resultUsed)
		end 'aServiceHandle'

		if self.signatures.isInterfaceHandle(base.layout.name) 'anInterfaceHandle'
			return try self.dispatchOnInterfaceHandle(func, base: base, baseTok: baseTok, memberTok: memberTok, resultUsed: resultUsed)
		end 'anInterfaceHandle'

		if self.signatures.isSharedValueInstanceAt(self.tagOf(base.box), nameId: self.valueNameId(base.box)) 'aSharedValue'
			return try self.dispatchOnSharedValue(func, holder: base.box, baseTok: baseTok, resultUsed: resultUsed)
		end 'aSharedValue'

		match access 'member'
			fieldRead(fieldIndex) then return try self.readFieldMember(base, index: fieldIndex, baseTok: baseTok, memberTok: memberTok)
			missingField then throw SourceParseError.unknownField(String.from(base.layout.name), fieldName: String.from(memberTok.value), line: memberTok.line, column: memberTok.column)
			methodCall then break
		end 'member'

		try self.requireFixedElementCountSourceForForwarding(base, memberTok: memberTok)

		// Built ONCE and threaded into both readers — the withholding guard keys its store by it, and the call
		// below dispatches on it. Derived twice, it was two string joins and an allocation on EVERY struct
		// method call in every program, for one name that cannot differ.
		let callee = qualifiedMethodName(base.layout.name, methodName: memberTok.value)

		// ⭐⭐ **`p.clone()` ON A DECLARED STRUCT — AN INDEPENDENT COPY, THROUGH THE `__clone_<T>` CLONER THIS
		// COMPILER ALREADY SYNTHESIZES** (`specs/reference-identity.md`). The body is
		// `MmRuntime.synthesizeStructCascade` — a fresh `__mm_alloc` box, a whole-struct blit, then a deep clone
		// of each managed field — and this is the door onto it for a source `a.clone()`.
		//
		// ⭐ **IT IS WIRED HERE, PAST THE `declaresCallee` TEST, SO A USER-WRITTEN `clone` STILL WINS.** There is
		// no per-type synthesized Maxon-level function: the Std-tier cloner it would lower to already exists and
		// is already correct, and `installStructCascades` already emits exactly the ones a program references. So
		// this is a call site, not a synthesis pass.
		//
		// ⚠ **THE `__clone_` CALLEE IS WHAT ROOTS THE SYNTHESIS**: `recordCallUsage` reads the prefix into
		// `usage.neededCloners`, `noteCascadeUsage` closes that set over the nested fields, and
		// `installStructCascades` builds the bodies. Nothing else has to be told.
		//
		// ⚠ **IT IS PLACED BELOW THE TWO GUARDS, NOT ABOVE THEM, AND THAT IS THE POINT.** Each of them calls
		// itself *"the ONE door every struct method call passes through"*, and a return above them would have
		// made both claims false — quietly, since neither has anything to say about a synthesized clone
		// today. An invariant that holds only because the exception happens to be inert is the shape this
		// file keeps paying for, so the arm sits where the claims stay literally true.
		try self.requireWitnessSourceForForwarding(base, callee: callee, memberTok: memberTok)
		try self.requireMethodNotWithheldByConstraint(base.layout.name, callee: callee, receiver: base.box, memberTok: memberTok)

		if self.cloneIsSynthesized(callee, memberTok: memberTok) 'synthesizedClone'
			return try self.emitSynthesizedStructClone(base, memberTok: memberTok, baseTok: baseTok)
		end 'synthesizedClone'

		// ⭐⭐ **THE FLOOR THE CORPUS CALL WILL LAND AT, READ BEFORE THE EMIT** — `emitRuntimeCall`'s own
		// discipline, for the reason the stream-write fold needs: `addressableBytes()` produces a byte-buffer
		// VALUE that `__Builtins.writeStdout` does not read, and the fold removes it by rewriting
		// THIS op's callee in place (`foldByteViewIntoStreamWrite`). Filed here because this is the one door
		// every corpus method call passes through, and `callee` is already built.
		//
		// ⚠ It is a FLOOR rather than the index, because `parseCallNamed` — not this function — appends the
		// op. The fold RE-MATCHES what it finds there and declines if it is not the call, so a
		// `parseCallNamed` that one day emits a setup op first costs an allocation rather than rewriting the
		// wrong op.
		//
		// ⚠ The guard is the RECEIVER's layout plus the member's spelling, never a join: asking
		// `conformsToBuiltinManagedWrapper` first means a user type with an `addressableBytes` of its own is
		// never filed, and it costs one bit-test on the overwhelmingly common path where the answer is no.
		let byteViewOpFloor = self.artifact.module.opCount()
		let producesAByteView = base.layout.conformsToBuiltinManagedWrapper() and memberTok.value.equals(CorpusAddressableBytes)

		// ⭐ **THE CALL IS ANCHORED AT THE METHOD NAME, THE RECEIVER ARGUMENT AT THE RECEIVER.**
		// A `baseTok` anchor would put every diagnostic about this call on the receiver — `s.append(t)`
		// reported at `s`. That is not the convention `SourceRange.between` states (*"the construct's
		// leading keyword or callee name"*) and it is not what the canonical corpus prints: `/specs`
		// positions E3207 at the method name (`immutable-method-call:5:4` over `\ts.append(" world")`) and
		// E3036 there too (`method-calls:19:4` over `\tc.increment(5)`).
		// `resolvedTypeQualifier`: the author wrote the MEMBER and a receiver; the head above came from
		// `base.layout`, so no token at this call site spells it.
		let result = try self.parseCallNamed(func, callee: callee, anchor: memberTok, receiver: self.writtenReceiver(base.box, immutableName: base.immutableName, anchor: baseTok), resultUsed: resultUsed, constructorInstance: self.receiverConstructorInstance(base.box), mint: CalleeMint.resolvedTypeQualifier)
		self.retypeInstanceMethodResult(result, receiver: base.box)

		if producesAByteView 'aFoldableByteView'
			self.recordStringBytesViewOp(result, opIndex: byteViewOpFloor)
		end 'aFoldableByteView'

		return result
	end 'dispatchMethodOnBase'

	// Read ONCE and threaded to both decisions below, which are the two halves of one question: a member
	// followed by `(` is a CALL, and a member not followed by one is a READ — so "is it a field?" and
	// "may it be reported as a missing field?" cannot come to disagree about which shape they saw.
	//
	// A member that is a FIELD is READ, in two cases: a FUNCTION-typed one however it is spelled (the
	// `(args)` after it is an INDIRECT call the postfix loop applies, not a method dispatch), and ANY
	// field with no `(` after it at all — `Inner.make(9).x`, `t.branch().tally`, a plain member access
	// on a value no chain walk resolved, whether because the base was not a name or because an
	// earlier door already materialized it.
	//
	// A NON-function field WITH a `(` falls through to the method path deliberately: `p.count(…)` on
	// an int field `count` is not a call through the field, and it must report the unknown method
	// (E3004) rather than silently reading the field and applying parens to an integer.
	//
	// ⭐ **A MEMBER WITH NO `(` AFTER IT CANNOT BE A METHOD CALL, so it is an UNKNOWN FIELD and is
	// reported as one.** Left to fall through, the method path hands the cursor to `parseCallNamed`,
	// which consumes the name and then reports the PUNCTUATION it wanted — `E2010: Expected '(' but got
	// 'newline'` for `Leaf.make(4).nope` — a complaint about the syntax when what is wrong is the NAME.
	// The BINDING spelling of the identical access already answers E3018 through `requireFieldIndex`
	// (`let l = Leaf.make(4)` then `l.nope`), and the two spellings are
	// one question: the door a receiver came through may not change what the answer IS.
	function memberAccessOn(layout StructLayout, memberTok Token) returns MemberAccess
		let callFollows = self.kindAt(self.pos + 1) == TokenKind.leftParen

		if let fieldIndex = try layout.indexOfField(memberTok.value) 'fieldMember'
			if maxonTypeTag(self.signatures.fieldTypeOf(layout, index: fieldIndex, into: self.artifact.typeNames)) == ValueTypeTag.function or not callFollows 'fieldRead'
				return MemberAccess.fieldRead(fieldIndex)
			end 'fieldRead'
		end 'fieldMember'

		return MemberAccess.methodCall if callFollows else MemberAccess.missingField
	end 'memberAccessOn'

	function readFieldMember(base StructBase, index FieldIndex, baseTok Token, memberTok Token) returns ValueId throws SourceParseError
		self.advance()

		if self.cellWasRequestedAt(self.lastConsumedSite()) 'anAnchoredFieldNoDoorAnswers'
			panic("readFieldMember: `{String.from(memberTok.value)}` is the anchor of a by-reference argument, and a value receiver's field read answers no such request — the chain's head must be read through `parseFieldAccess`, whose door hands the field over")
		end 'anAnchoredFieldNoDoorAnswers'

		try self.requireFieldAccessible(base.layout, index: index, fieldTok: memberTok)
		let borrowsATemporary = self.keepFieldSourceAliveForItsRead(base, index: index)
		let value = self.emitFieldLoad(base.box, layout: base.layout, index: index, range: SourceRange.between(baseTok, last: memberTok))

		if borrowsATemporary or valueIsMarked(self.bodyState.temporaryFieldReads, value: base.box) 'aProjectionOfATemporary'
			self.bodyState.temporaryFieldReads = withValueMarked(self.bodyState.temporaryFieldReads, value: value)
		end 'aProjectionOfATemporary'

		return value
	end 'readFieldMember'

	// Everything an author may spell on a `<T>.handle`, in the order the questions can be asked, and
	// `ServiceCompanions.serviceHandleSurface` is the same set enumerated for an editor.
	//
	// The request union is the roster: it holds one variant per message in declaration order, so "is this
	// a message?" is `request.indexOfCase` and needs no second list to fall out of step with
	// `messageMethodNames`.
	//
	// The variant test comes first, and that is what gives a declared `clone`/`shutdown` precedence. A
	// service declaring `export function shutdown()` has a variant of that name, so the author's
	// method wins and the compiler's `shutdown` becomes unspellable for it — which leaves dropping the
	// last handle as the other road to the same close. It is `cloneIsSynthesized`'s rule, reached by
	// asking the roster rather than by asking `declaresCallee` a second time.
	//
	// ⚠ `shutdown` is the handle's own method too, and that is not why its arm refuses a value. So is
	// `clone`, whose whole point is the value it hands back. What separates them is that nothing declares
	// what `shutdown` returns — see `emitServiceShutdown`, which carries the argument.
	function dispatchOnServiceHandle(func IrFunction, base StructBase, baseTok Token, memberTok Token, resultUsed bool) returns ValueId throws SourceParseError
		let typeName = self.signatures.serviceOfHandle(base.layout.name)
		let request = try serviceRequestLayoutOf(self.signatures, typeName: typeName) otherwise panic("dispatchOnServiceHandle: nothing declares `union {String.from(serviceRequestCompanionName(typeName))}` — `ServiceCompanions.synthesizeServiceCompanions` mints it beside the handle, and this caller reached a handle")

		if let caseIndex = try request.indexOfCase(memberTok.value) 'aMessage'
			return try self.emitServiceSend(func, base: base, baseTok: baseTok, memberTok: memberTok, typeName: typeName, request: request, caseIndex: caseIndex, route: MessageRoute.mailbox, resultUsed: resultUsed)
		end 'aMessage'

		if memberTok.value.equals(ServiceShutdownMethodName) 'theShutdownMethod'
			return try self.emitServiceShutdown(base, baseTok: baseTok, memberTok: memberTok, typeName: typeName, resultUsed: resultUsed)
		end 'theShutdownMethod'

		if memberTok.value.equals(CloneMethodName) 'aSecondHandle'
			return try self.emitServiceHandleClone(base, cloner: CownHandleCloneBoxName, baseTok: baseTok, memberTok: memberTok)
		end 'aSecondHandle'

		throw SourceParseError.serviceNotAMessage(serviceNotAMessageRefusal(typeName, handleName: base.layout.name, member: memberTok.value, declaresIt: self.signatures.declaresCallee(qualifiedMethodName(typeName, methodName: memberTok.value))), line: memberTok.line, column: memberTok.column)
	end 'dispatchOnServiceHandle'

	function requireImplementersAnswerAlike(interfaceName ByteArray, representative ByteArray, request EnumLayout, caseIndex CaseIndex, memberTok Token) throws SourceParseError
		let member = memberTok.value
		let representativeMessage = qualifiedMethodName(representative, methodName: member)
		let representativeReturn = serviceDeclarationOf(self.signatures, key: representativeMessage).returnType
		let representativeThrows = self.signatures.throwsOf(representativeMessage)

		for service in interfaceServiceImplementers(self.signatures, interfaceName: interfaceName) 'eachService'
			if service.equals(representative) 'theSender'
				continue
			end 'theSender'

			let serviceRequest = try serviceRequestLayoutOf(self.signatures, typeName: service) otherwise panic("requireImplementersAnswerAlike: `{String.from(service)}` is on the companion roster, which mints its request union")
			let message = qualifiedMethodName(service, methodName: member)

			// An implementer lacking the message does not conform, which `ConformanceCheck` reports (E3016)
			// after parsing; a program this reaches may still be that one.
			let serviceCase = try serviceRequest.indexOfCase(member) otherwise continue

			if payloadsAgree(request.payloadsAt(caseIndex), other: serviceRequest.payloadsAt(serviceCase)) and self.returnAnswersAreInterchangeable(representativeReturn, right: serviceDeclarationOf(self.signatures, key: message).returnType) and throwsClausesAgree(representativeThrows, other: self.signatures.throwsOf(message)) 'answersAlike'
				continue
			end 'answersAlike'

			throw SourceParseError.registryRefused(ErrorCode.interfaceHandleImplementersDisagree, explanation: "`{String.from(interfaceName)}.{String.from(member)}` cannot be sent through `{String.from(interfaceName)}.handle`: `{String.from(service)}` and `{String.from(representative)}` declare it with different parameter, return or `throws` types, so one request and one reply cannot serve both — send it through each service's own handle", line: memberTok.line, column: memberTok.column, note: DiagnosticNote.none)
		end 'eachService'
	end 'requireImplementersAnswerAlike'

	function dispatchOnInterfaceHandle(func IrFunction, base StructBase, baseTok Token, memberTok Token, resultUsed bool) returns ValueId throws SourceParseError
		let interfaceName = self.signatures.interfaceOfHandle(base.layout.name)
		let representative = self.signatures.interfaceHandleRepresentative(interfaceName)
		let request = try serviceRequestLayoutOf(self.signatures, typeName: interfaceName) otherwise panic("dispatchOnInterfaceHandle: nothing declares `union {String.from(serviceRequestCompanionName(interfaceName))}` — `ServiceCompanions.synthesizeInterfaceRequestUnions` mints it beside every interface handle")

		if let caseIndex = try request.indexOfCase(memberTok.value) 'aRequirement'
			let (sender, _) = try interfaceMessageRepresentative(self.signatures, interfaceName: interfaceName, member: memberTok.value) otherwise panic("dispatchOnInterfaceHandle: `union {String.from(serviceRequestCompanionName(interfaceName))}` lists `{String.from(memberTok.value)}`, and `buildInterfaceRequestUnion` lists a requirement only when an implementer declares it as a message")
			try self.requireImplementersAnswerAlike(interfaceName, representative: sender, request: request, caseIndex: caseIndex, memberTok: memberTok)
			return try self.emitServiceSend(func, base: base, baseTok: baseTok, memberTok: memberTok, typeName: sender, request: request, caseIndex: caseIndex, route: MessageRoute.sendTable(caseIndex, interfaceName: interfaceName), resultUsed: resultUsed)
		end 'aRequirement'

		if memberTok.value.equals(ServiceShutdownMethodName) 'theShutdownMethod'
			return try self.emitServiceShutdown(base, baseTok: baseTok, memberTok: memberTok, typeName: representative, resultUsed: resultUsed)
		end 'theShutdownMethod'

		if memberTok.value.equals(CloneMethodName) 'aSecondHandle'
			return try self.emitServiceHandleClone(base, cloner: CownInterfaceCloneBoxName, baseTok: baseTok, memberTok: memberTok)
		end 'aSecondHandle'

		if witnessSlotsRequireMethod(self.requirementSlotsOf(interfaceName), methodName: memberTok.value) 'aRequirementNoHandleCanSend'
			if let withholder = try interfaceMessageWithholder(self.signatures, interfaceName: interfaceName, member: memberTok.value) 'anImplementerWithholdsIt'
				throw SourceParseError.serviceNotAMessage(interfaceMessageWithheldRefusal(interfaceName, handleName: base.layout.name, member: memberTok.value, withholder: withholder), line: memberTok.line, column: memberTok.column)
			end 'anImplementerWithholdsIt'

			throw SourceParseError.serviceNotAMessage(interfaceMessageUnimplementedRefusal(interfaceName, handleName: base.layout.name, member: memberTok.value), line: memberTok.line, column: memberTok.column)
		end 'aRequirementNoHandleCanSend'

		throw SourceParseError.serviceNotAMessage(serviceNotAMessageRefusal(interfaceName, handleName: base.layout.name, member: memberTok.value, declaresIt: false), line: memberTok.line, column: memberTok.column)
	end 'dispatchOnInterfaceHandle'

	// ⭐⭐ **`h.m(…)` — FILL THE REQUEST AND SEND IT.** The arguments are read by the ORDINARY call
	// reader (`parseCallArgs` + `fillOmittedArgDefaults`), so a message takes labels, defaults and
	// every argument diagnostic exactly as a direct call to the same method does; only what happens to
	// them afterwards is this reader's. They are then SLOTTED into the variant's payload columns
	// through `argSlotPosition` — the one home of the label-to-position mapping — and handed to
	// `emitEnumBox`, which types each against the payload field (which IS the parameter's declared
	// type) and MOVES it into the request.
	//
	// ⚠ **THE ARGUMENTS NEVER REACH `SemanticCheck.checkArgTypes`, WHICH IS WHY THE TYPING HAPPENS
	// HERE.** The `serviceSend` op carries a REQUEST and not an argument list, so the pass that types
	// a call's arguments has nothing to type. That is the same position a parser-intrinsic container
	// mutator is in, and the refusal takes the same voice for the same reason
	// (`SlotMismatchVoice.containerElementArgument`).
	function emitServiceSend(func IrFunction, base StructBase, baseTok Token, memberTok Token, typeName immutable ByteArray, request EnumLayout, caseIndex CaseIndex, route MessageRoute, resultUsed bool) returns ValueId throws SourceParseError
		if self.messageHasAnUnreadParameter(request.payloadsAt(caseIndex)) 'theDeclarationIsRefused'
			self.advance()
			try self.parseDeferredMemberArguments(func)

			return self.deferredValueOfChain(DeferredChainCalls.lastLinkIsACall)
		end 'theDeclarationIsRefused'

		let callee = qualifiedMethodName(typeName, methodName: memberTok.value)
		try self.requireServiceSendResultUnused(resultUsed, request: request, caseIndex: caseIndex, callee: callee, memberTok: memberTok)
		let instance = self.serviceInstanceOfHandle(base.box, typeName: typeName)
		try self.requireServiceReplyInstanceIsKnown(callee, typeName: typeName, instance: instance, memberTok: memberTok)

		let memberIndex = self.pos
		try self.consumeNameToken(NamePosition.declaration)
		try self.consume(TokenKind.leftParen)

		let args = ValueIdArray.create(0)
		let argLabels = NameRoster.create(0)
		let argRanges = SourceRangeArray.create(0)

		// Filled and DISCARDED, both of them, and each for its own reason. `argRanges` is the column an
		// op carries so a LATER pass can position a diagnostic about one argument, and a send's op
		// carries a REQUEST rather than arguments; `argImmutableNames` blames a binding for E3207, which
		// is keyed by callee mutation summary — and a message writes a value this frame has given up, so
		// there is nothing to blame.
		let argImmutableNames = NameRoster.create(0)
		let argAnchors = TokenIndexArray.create(0)
		let argumentTempFloor = self.bodyState.pendingTempDrops.count()
		let argumentOwnedFloor = self.bodyState.ownedBindings.count()

		// `messageSend`, unconditionally: a message is a declared method, so it always has parameter names to
		// label with — no bare builtin can arrive through a handle.
		_ = try self.parseCallArgs(func, target: CallArgTarget.movedInto(callee), anchor: memberTok, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, argAnchors: argAnchors, rule: ArgLabelRule.messageSend) otherwise (refusal) 'argsRefused'
			self.statement.pendingSendTimeout = SendTimeoutArgument.absent
			throw refusal
		end 'argsRefused'

		let timeout = self.statement.pendingSendTimeout.clone()
		self.statement.pendingSendTimeout = SendTimeoutArgument.absent
		let rparenTok = try self.consume(TokenKind.rightParen)

		if self.timeoutMayPark(timeout) 'aTimedSend'
			try self.requireNoLinearArgumentIn(args, refusal: "a linear value is never sent with a `sendTimeout:`: a timed send waits for room in the mailbox, and a wait may never end, so the sender could neither hand the value over nor consume it. Send it without a timeout, and consume the value `mailboxFull` and `serviceStopped` hand back", anchor: memberTok)
		end 'aTimedSend'

		try self.checkSendArgumentCapabilities(func, callee: callee, args: args, argAnchors: argAnchors, argLabels: argLabels, anchor: memberTok)

		// A message's declared defaults are filled exactly as a direct call's are, through the same door, so
		// `h.bump()` on a `bump(by int = 1)` sends the same request `h.bump(1)` does.
		let defaultedArgs = try self.fillOmittedArgDefaults(callee, anchor: memberTok, args: args, argLabels: argLabels, argRanges: argRanges, receiverSlots: self.serviceMessageFirstParam(callee))
		self.stampDefaultsSubject(callee, args: args, argLabels: argLabels, defaultedArgs: defaultedArgs, receiverSlots: self.serviceMessageFirstParam(callee), constructorInstance: self.serviceSubjectOf(instance))

		let range = SourceRange.between(baseTok, last: rparenTok)
		let payloads = request.payloadsAt(caseIndex)
		let slotValues = ValueIdArray.create(payloads.count(), zeroed: false)
		let filled = BoolArray.create(payloads.count(), zeroed: false)
		let bareLocal = BoolArray.create(payloads.count(), zeroed: false)
		let slotAnchors = TokenIndexArray.create(payloads.count(), zeroed: false)
		self.seedMessageSlots(payloads, anchor: memberIndex, slotValues: slotValues, filled: filled, bareLocal: bareLocal, slotAnchors: slotAnchors)

		try self.slotMessageArgs(callee, payloads: payloads, args: args, argLabels: argLabels, argAnchors: argAnchors, memberIndex: memberIndex, slotValues: slotValues, filled: filled, slotAnchors: slotAnchors, memberTok: memberTok)
		self.widenMessageArgsToInterfaceHandles(payloads, slotValues: slotValues, filled: filled, firstTok: baseTok, lastTok: rparenTok)
		let argsAreChecked = self.serviceArgumentsAreChecked(payloads, slotValues: slotValues, filled: filled, anchor: memberTok)
		let reply = self.fillMessageReplySlot(payloads, callee: callee, awaitedService: awaitedServiceOf(route, typeName: typeName), instance: instance, slotValues: slotValues, filled: filled, range: range)
		try self.requireEveryMessageArgumentGiven(callee, payloads: payloads, filled: filled, given: args.count() as ParamCount, memberTok: memberTok)

		self.releaseHandOffBuildTemps(argumentTempFloor, ownedFloor: argumentOwnedFloor, handedOff: slotValues, anchor: memberTok)
		let (box, handBack) = try self.emitEnumBox(request, caseIndex: caseIndex, args: slotValues, argsBareLocal: bareLocal, argAnchors: slotAnchors, caseTok: memberTok, range: range, fill: PayloadFill.serviceMessage(typeName))
		self.carryWindowBirth(box, sources: slotValues)
		let spelling = qualifiedMethodName(awaitedServiceOf(route, typeName: typeName), methodName: memberTok.value)
		try self.requireSendSettled()
		return self.emitServiceSendOp(base, box: box, request: request, caseIndex: caseIndex, handBack: handBack, callee: callee, spelling: spelling, reply: reply, route: route, range: range, argsAreChecked: argsAreChecked, timeout: timeout)
	end 'emitServiceSend'

	function timeoutMayPark(timeout SendTimeoutArgument) returns bool
		return match timeout 'timeout'
			absent gives false
			given(value) gives not self.valueIsConstant(value, equalTo: NoSendTimeoutMs)
		end 'timeout'
	end 'timeoutMayPark'

	function widenMessageArgsToInterfaceHandles(payloads PayloadFieldArray, slotValues ValueIdArray, filled BoolArray, firstTok Token, lastTok Token)
		if not self.signatures.declaresAnInterfaceHandle() 'noInterfaceHandle'
			return
		end 'noInterfaceHandle'

		for (position, field) in payloads.withIterator() 'eachSlot'
			let slot = position.index()
			let given = try filled.get(slot) otherwise panic("widenMessageArgsToInterfaceHandles: filled.get OOB at {slot} — the columns are sized to the variant's payload count")

			if not given or fieldIsTheServiceReplySlot(field) or fieldIsAServiceWitnessHalf(field) 'noArgumentHere'
				continue
			end 'noArgumentHere'

			let value = try slotValues.get(slot) otherwise panic("widenMessageArgsToInterfaceHandles: slotValues.get OOB at {slot}")
			let widened = self.interfaceHandleOf(value, declared: self.signatures.adoptType(field.declaredType, into: self.artifact.typeNames), first: firstTok, last: lastTok)
			try slotValues.set(slot, value: widened) otherwise panic("widenMessageArgsToInterfaceHandles: slotValues.set OOB at {slot}")
		end 'eachSlot'
	end 'widenMessageArgsToInterfaceHandles'

	// ⭐⭐ **A `returns T` REPLY NEEDS THE HANDLE'S INSTANTIATION, AND A DECLARED SLOT CANNOT CARRY ONE
	// (E3145).** One `<T>.handle` companion serves every instantiation — nothing about it names a type
	// argument — so a `spawn` puts the instantiation on the VALUE, and a parameter, field or element typed
	// `<T>.handle` drops it. The reply is produced where the descriptor is and awaited where the handle is,
	// so a handle that names no instantiation leaves the awaited value with no type to check anything
	// against.
	//
	// ⚠ **THE TEST IS THE RETURN TYPE, NOT THE HANDLE**, because this rule is about the one shape whose
	// answer is missing: a concrete reply and a fire-and-forget message need nothing from the instantiation
	// and stay legal through a bare-companion slot. What has no answer is a `T`-typed reply, and the cure is
	// to spell the slot at `<T>.handle with <Args>` — an instantiation like any other generic's, which
	// carries the type through a parameter, a field or an element.
	//
	// ⚠ It is asked before a single argument is read, so a refused send leaves no ops behind it — that is
	// `emitBinOp`'s ordering rule, and on this road it holds without residue.
	function requireServiceReplyInstanceIsKnown(callee ByteArray, typeName ByteArray, instance ServiceStateInstance, memberTok Token) throws SourceParseError
		match instance 'known'
			at then return
			monomorphic then break
		end 'known'

		if not self.signatures.structDeclaresTypeParams(typeName) 'aMonomorphicService'
			return
		end 'aMonomorphicService'

		let declaredReturn = try self.signatures.declaredValueReturnOf(callee, into: self.artifact.typeNames) otherwise return

		if maxonTypeTag(declaredReturn) != ValueTypeTag.typeParameter 'theInstantiationFixesNothingHere'
			return
		end 'theInstantiationFixesNothingHere'

		throw SourceParseError.serviceReplyInstanceUnknown(serviceReplyInstanceUnknownRefusal(typeName, methodName: memberTok.value, paramName: self.replyTypeParamName(declaredReturn), member: serviceSpawnSiteOf(self.signatures, typeName: typeName).member), line: memberTok.line, column: memberTok.column)
	end 'requireServiceReplyInstanceIsKnown'

	// The SOURCE NAME of the type parameter a reply is declared at — `T`, the spelling the author wrote,
	// where the type carries only its digest token. A reply this is asked of has already been matched
	// `typeParameter`, and every such token was filed by `recordStruct` against the declaration it came from.
	function replyTypeParamName(declaredReturn MaxonType) returns immutable ByteArray
		let token = typeParamIdOf(declaredReturn)

		return (try self.signatures.typeParamOwnerOf(token) otherwise panic("replyTypeParamName: type-parameter token {token} names no declaration's parameter — every token was filed by `ProgramSignatures.recordStruct` from the `uses` list that minted it")).paramName
	end 'replyTypeParamName'

	// ⭐ **THE FOUR LAYOUT-PARALLEL COLUMNS A REQUEST IS FILLED THROUGH, SEEDED FOR ONE VARIANT.** Both
	// doors that build one need all four and neither may seed three — `emitEnumBox` indexes every one of them
	// by slot, so a column short by an entry is an out-of-bounds panic rather than a missing value.
	//
	// A witness-half slot is seeded FILLED: its value is the witness of the argument before it, which
	// the payload store writes beside that argument (`emitEnumBox`), so no source argument ever fills
	// it.
	//
	// ⚠ **`bareLocal` IS ALL FALSE AND CANNOT BE OTHERWISE, WHICH IS WHY IT IS SEEDED HERE AND NEVER WRITTEN.**
	// The transfer a message's payload takes is `handOff`, which resolves the source binding
	// itself; the union CONSTRUCT's per-slot bare-local column has no reader on this path
	// (`storedPayloadValue`), and passing a column of the right SHAPE is what lets the two fills share one
	// emitter instead of two.
	function seedMessageSlots(payloads PayloadFieldArray, anchor ElementIndex, slotValues ValueIdArray, filled BoolArray, bareLocal BoolArray, slotAnchors TokenIndexArray)
		for field in payloads 'eachSlot'
			slotValues.push(0)
			filled.push(fieldIsAServiceWitnessHalf(field))
			bareLocal.push(false)
			slotAnchors.push(anchor)
		end 'eachSlot'
	end 'seedMessageSlots'

	function messageHasAnUnreadParameter(payloads PayloadFieldArray) returns bool
		for field in payloads 'eachPayload'
			if tagIsUnresolved(maxonTypeTag(field.declaredType)) 'anUnreadType'
				return true
			end 'anUnreadType'
		end 'eachPayload'

		return false
	end 'messageHasAnUnreadParameter'

	// ⚠ The request sits in this thread's one staging buffer until the op copies it out, so nothing
	// between `emitEnumBox`'s fill and the op may send: a nested send would overwrite it.
	function emitServiceSendOp(base StructBase, box ValueId, request EnumLayout, caseIndex CaseIndex, handBack SharedSlotHandBackArray, callee ByteArray, spelling ByteArray, reply ServiceReplyValue, route MessageRoute, range SourceRange, argsAreChecked bool, timeout SendTimeoutArgument) returns ValueId
		let bytes = self.emitLiteral(request.boxSizeBytes() as FullRangeInt, valueType: MaxonType.integer, range: range)
		let sent = self.mintValue(ValueTypeTag.void, nameId: UnnamedTypeId)

		let (timeoutMs, timed) = match timeout 'timeout'
			absent gives (self.emitLiteral(NoSendTimeoutMs, valueType: MaxonType.integer, range: range), false)
			given(value) gives (value, true)
		end 'timeout'

		let mayPark = self.timeoutMayPark(timeout)

		if mayPark 'aSendThatMayPark'
			self.deferNoWaitInsideWindow(range)
		end 'aSendThatMayPark'

		let checkable = match route 'route'
			mailbox gives self.emitMailboxSend(base, box: box, bytes: bytes, callee: callee, sent: sent, range: range, timeoutMs: timeoutMs, timed: timed)
			sendTable(slot, _) gives self.emitInterfaceSend(base, slot: slot, box: box, bytes: bytes, range: range, timeoutMs: timeoutMs)
		end 'route'

		let opIdx = self.artifact.module.opCount() - 1

		if mayPark 'recordTheWaitSite'
			self.noteWaitSeed(self.bodyFunction(), site: WaitSite.timedSend(opIdx))
		end 'recordTheWaitSite'

		let message = SentMessage.create(callee, spelling: spelling, handle: base.box, staging: box, reply: reply, request: request, caseIndex: caseIndex, handBack: handBack)
		self.statement.lastSend = RecordedSend.recorded(opIdx, funcIndex: self.artifact.currentFuncIndex, send: message)

		if argsAreChecked 'theQuantityDoorIsKept'
			self.markCallChecked(checkable)
		end 'theQuantityDoorIsKept'

		// ⭐ **THE VALUE OF AN AWAITABLE SEND IS ITS REPLY CELL, NOT THE SEND.** The `serviceSend` op
		// still defines a void `sent` — it is a statement, and every op in this dialect names a result — but
		// what the expression yields is the PROMISE the cell op minted one box earlier, which is what `await`
		// and `try await` are then applied to.
		let value = message.resultValue(sent)
		self.routeOrHoldSend(opIdx, range: range, result: value)
		return value
	end 'emitServiceSendOp'

	function routeOrHoldSend(opIdx ElementIndex, range SourceRange, result ValueId)
		let destination = self.unclaimedThrowRouteDestination()

		if destination == ThrowRouteDestination.nowhere or self.bodyState.holdsSendForTryAwait 'nothingCatchesIt'
			self.statement.unsettledSend = UnsettledSend.pending(opIdx, range: range)
			return
		end 'nothingCatchesIt'

		self.routeThrowingOp(destination, opIdx: opIdx, clause: recordedSendOf(self.statement.lastSend, opIdx: opIdx).throwsClause(), result: result)
	end 'routeOrHoldSend'

	function emitMailboxSend(base StructBase, box ValueId, bytes ValueId, callee immutable ByteArray, sent ValueId, range SourceRange, timeoutMs ValueId, timed bool) returns ValueId
		let cown = self.emitFieldLoad(base.box, layout: base.layout, index: ServiceHandleCownFieldIndex, range: range)
		let status = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.serviceSend(sent, status: status, callee: callee, handle: cown, request: box, bytes: bytes, timeoutMs: timeoutMs, timed: timed), range: range)
		return sent
	end 'emitMailboxSend'

	function emitInterfaceSend(base StructBase, slot CaseIndex, box ValueId, bytes ValueId, range SourceRange, timeoutMs ValueId) returns ValueId
		let slotOffset = self.emitLiteral(interfaceSendSlotOffset(slot), valueType: MaxonType.integer, range: range)
		return self.emitRuntimeCall(CownInterfaceSendName, args: fiveArgs(base.box, second: slotOffset, third: box, fourth: bytes, fifth: timeoutMs), resultTag: ValueTypeTag.integer, resultNameId: UnnamedTypeId, range: range)
	end 'emitInterfaceSend'

	// ⭐ **`h.shutdown()` — CLOSE THE MAILBOX, AND WHAT IS QUEUED STILL RUNS.** Everything already queued
	// still runs and a later send fails with `serviceStopped`; nothing is enqueued, so it takes no
	// slot and cannot fail.
	//
	// ⛔ **THE VALUE POSITION IS REFUSED.** `shutdown` is the HANDLE's own method rather than a message
	// of the type (`ProgramSignatures.serviceMessageOf` holds no entry for it), so no declaration says
	// what it hands back.
	//
	// ⚠ **IT REFUSES BEFORE IT EMITS**, `emitBinOp`'s ordering rule, which is why the gate precedes even the
	// argument list's two tokens.
	function emitServiceShutdown(base StructBase, baseTok Token, memberTok Token, typeName ByteArray, resultUsed bool) returns ValueId throws SourceParseError
		if resultUsed 'usedForItsValue'
			throw SourceParseError.unsupported(serviceShutdownHasNoValueRefusal(typeName), line: memberTok.line, column: memberTok.column)
		end 'usedForItsValue'

		try self.consumeNameToken(NamePosition.declaration)
		try self.consume(TokenKind.leftParen)
		let rparenTok = try self.consume(TokenKind.rightParen)

		let range = SourceRange.between(baseTok, last: rparenTok)
		return self.emitRuntimeCall(CownCloseName, args: argsOf(self.emitFieldLoad(base.box, layout: base.layout, index: ServiceHandleCownFieldIndex, range: range)), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitServiceShutdown'

	// ⭐ **`h.clone()` — A SECOND HANDLE TO THE SAME SERVICE, NEVER A SECOND SERVICE.** It cannot take
	// `emitSynthesizedStructClone`'s road: that emits `__clone_<T>`, a symbol `installStructCascades` never
	// builds for a companion, and a blitted copy of the box would name the cown twice while its counts said
	// once. `CownHandleCloneBoxName` is the SAME entry `SignatureIndex.managedNameCascadeStrategy` hands back for
	// a handle held in a field or an array element, so a handle cloned three different ways takes one body.
	function emitServiceHandleClone(base StructBase, cloner ByteArray, baseTok Token, memberTok Token) returns ValueId throws SourceParseError
		self.advance()
		try self.consumeEmptyArgList()

		// The receiver's OWN type, not the layout's name: a generic service's handle stands at
		// `<T>.handle with <Args>`, and a clone that decayed to the base would leave the second handle unable
		// to resolve a `returns T` reply.
		return self.emitOwnedRuntimeResult(cloner, args: argsOf(base.box), resultTag: self.tagOf(base.box), resultNameId: self.valueNameId(base.box), range: SourceRange.between(baseTok, last: memberTok))
	end 'emitServiceHandleClone'

	// ⭐ **A SEND OF A MESSAGE WITH NO REPLY HAS NO VALUE, SO THERE IS NOTHING TO BIND.** A
	// message that returns nothing and throws nothing carries no `__reply` slot, so no cell is minted and the
	// send has no value — and the sentence names the DECLARATION that would give it one.
	function requireServiceSendResultUnused(resultUsed bool, request EnumLayout, caseIndex CaseIndex, callee ByteArray, memberTok Token) throws SourceParseError
		if not resultUsed 'aStatement'
			return
		end 'aStatement'

		match serviceReplySlotIndex(request.payloadsAt(caseIndex)) 'reply'
			at then return
			absent then throw SourceParseError.unsupported(serviceSendHasNoValueRefusal(callee), line: memberTok.line, column: memberTok.column)
		end 'reply'
	end 'requireServiceSendResultUnused'

	// Slot every source argument into the variant's payload column, through `argSlotPosition` — the one home
	// of the label-to-position mapping, asked over the DECLARATION's own parameter names. A label naming no
	// parameter is refused here rather than filling a slot it does not mean.
	//
	// ⚠ The names are the declaration's SOURCE-ALIGNED list (`SweptDeclaration.paramNames`, receiver excluded),
	// which is exactly the shape a send's arguments are in: the service's state is the LOOP's receiver, not
	// this call's, so nothing is prepended and position `i` is parameter `i`.
	function slotMessageArgs(callee ByteArray, payloads PayloadFieldArray, args ValueIdArray, argLabels NameRoster, argAnchors TokenIndexArray, memberIndex ElementIndex, slotValues ValueIdArray, filled BoolArray, slotAnchors TokenIndexArray, memberTok Token) throws SourceParseError
		let paramNames = self.serviceMessageParamNames(callee)

		for i in 0 upto args.count() 'eachArg'
			let label = try argLabels.get(i) otherwise panic("slotMessageArgs: argLabels.get OOB at {i} — args and argLabels are pushed in lockstep")
			let parameter = try argSlotPosition(paramNames, argIndex: i as ParamCount, label: label) otherwise throw SourceParseError.unknownField(String.from(callee), fieldName: String.from(argLabelSpelling(label)), line: memberTok.line, column: memberTok.column)

			let position = serviceParamPayloadSlot(payloads, paramIndex: parameter)

			let alreadyFilled = try filled.get(position) otherwise panic("slotMessageArgs: filled.get OOB at {position} — the columns are sized to the variant's payload count, which is the parameter count plus at most a reply slot")

			if alreadyFilled 'twice'
				throw SourceParseError.duplicateFieldInitializer(String.from(callee), fieldName: String.from(argLabelSpelling(label)), line: memberTok.line, column: memberTok.column)
			end 'twice'

			try slotValues.set(position, value: try args.get(i) otherwise panic("slotMessageArgs: args.get OOB at {i}")) otherwise panic("slotMessageArgs: slotValues.set OOB at {position}")
			try filled.set(position, value: true) otherwise panic("slotMessageArgs: filled.set OOB at {position}")
			try slotAnchors.set(position, value: callArgAnchorAt(argAnchors, index: i as ParamCount, callAnchor: memberIndex)) otherwise panic("slotMessageArgs: slotAnchors.set OOB at {position}")
		end 'eachArg'
	end 'slotMessageArgs'

	// ⭐⭐ **MINT THE REPLY CELL AND SLOT IT — the one place a send becomes awaitable.** A variant with a
	// `__reply` payload gets a fresh cell; one without has no slot at all
	// (`ServiceCompanions.serviceReplySlotIndex` is the authority) and this fills nothing.
	//
	// ⭐ **THE CELL IS SLOTTED AS AN ORDINARY ARGUMENT, WHICH IS WHY THE OP GOES HERE AND NOT AT THE SEND.**
	// The cell has to EXIST before the box is built, and minting it here is what lets it ride the same fill
	// every other argument does. Its payload FIELD stays `MaxonType.integer` — a raw cell pointer the
	// destructor cascade must not follow — while the VALUE is a `Promise`, which is why `emitEnumBox` skips
	// exactly this slot's argument-type check (`fieldIsTheServiceReplySlot`).
	//
	// ⚠ **AND IT IS ENROLLED AS AN OWNED PROMISE IN THE SAME BREATH**, exactly as `emitAsyncCall`
	// enrols a spawn's: `markValuePromise` makes `await`/`try await`/E3100 see it, and
	// `pendingTempDrops` makes a DISCARDED reply (`_ = try h.say("a") otherwise …`) drop it at
	// statement end through `__gt_promise_drop` — the abandoned-cell road
	// `services.reply-discarded-is-dropped-clean` pins.
	function fillMessageReplySlot(payloads PayloadFieldArray, callee ByteArray, awaitedService ByteArray, instance ServiceStateInstance, slotValues ValueIdArray, filled BoolArray, range SourceRange) returns ServiceReplyValue
		match serviceReplySlotIndex(payloads) 'reply'
			absent then return ServiceReplyValue.fireAndForget
			at(slot) then return self.mintServiceReplyCell(slot, callee: callee, awaitedService: awaitedService, instance: instance, slotValues: slotValues, filled: filled, range: range)
		end 'reply'
	end 'fillMessageReplySlot'

	// ⭐ **THE SERVICE'S INSTANTIATION, READ OFF THE HANDLE STANDING AT THE SEND.** `<T>.handle with <Args>`
	// and `<T> with <Args>` are two instances over ONE argument list, so the service's is RE-BASED from the
	// handle's rather than derived a second time from a source this site cannot see.
	function serviceSubjectOf(instance ServiceStateInstance) returns ConstructorInstance
		return match instance 'instance'
			monomorphic gives ConstructorInstance.none
			at(id) gives ConstructorInstance.instance(id)
		end 'instance'
	end 'serviceSubjectOf'

	function serviceInstanceOfHandle(box ValueId, typeName ByteArray) returns ServiceStateInstance
		return match self.serviceStateInstanceOf(box) 'handle'
			monomorphic gives ServiceStateInstance.monomorphic
			at(id) gives ServiceStateInstance.at(self.signatures.internInstanceOverArgsOf(typeName, likeInstance: id))
		end 'handle'
	end 'serviceInstanceOfHandle'

	// The mint itself, split out because a `match` arm is ONE statement and this is five.
	//
	// ⭐⭐ **THE CELL IS BORN AT `Promise with (T, E)`.** Typed `ValueTypeTag.integer`, a scheduler pointer on the
	// reply road would be a
	// plain number and `return h.total()`, `p + 1`, `takesInt(h.total())` and `p.clone()` would all COMPILE. The
	// instance comes from `SignatureIndex.internPromiseInstanceForReply`, interned in the index's own name
	// space so it is the SAME gid a `typealias R = Promise with (Integer, MathError)` resolves to —
	// which is what lets a reply be stored in the type that names it.
	//
	// ⚠ **`markValuePromise` STAYS, AND IT IS NOT REDUNDANT WITH THE TYPE.** The mark answers *"does THIS
	// frame owe a `__gt_promise_drop`?"* (`decrefCalleeFor`), which a type cannot: a
	// promise read back out of a container carries the very same type and owes nothing.
	function mintServiceReplyCell(slot PayloadSlotIndex, callee ByteArray, awaitedService ByteArray, instance ServiceStateInstance, slotValues ValueIdArray, filled BoolArray, range SourceRange) returns ServiceReplyValue
		let cell = self.mintValue(ValueTypeTag.genericInstance, nameId: self.signatures.internPromiseInstanceForReply(callee, serviceInstance: instance) as TypeNameId)
		self.markValuePromise(cell)
		self.bodyState.pendingTempDrops.push(cell)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.serviceReplyCell(cell, messageName: callee, awaitedService: awaitedService), range: range)

		try slotValues.set(slot, value: cell) otherwise panic("mintServiceReplyCell: slotValues.set OOB at {slot} — the columns are sized to the variant's payload count and the slot came from that same list")
		try filled.set(slot, value: true) otherwise panic("mintServiceReplyCell: filled.set OOB at {slot} — the columns are sized to the variant's payload count and the slot came from that same list")
		return ServiceReplyValue.cell(cell)
	end 'mintServiceReplyCell'

	// Every payload slot the source was responsible for must have been given a value. Reported in the
	// ARGUMENT-COUNT voice rather than the union's missing-field one, because what the author wrote is a call
	// and the count they need is the message's parameter count — the reply slot, which they cannot fill, is
	// excluded from both sides of it.
	function requireEveryMessageArgumentGiven(callee ByteArray, payloads PayloadFieldArray, filled BoolArray, given ParamCount, memberTok Token) throws SourceParseError
		for slot in 0 upto payloads.count() 'eachSlot'
			let wasFilled = try filled.get(slot) otherwise panic("requireEveryMessageArgumentGiven: filled.get OOB at {slot}")

			if wasFilled 'given'
				continue
			end 'given'

			throw SourceParseError.builtinArity(String.from(callee), expected: self.serviceMessageParamNames(callee).count() as ParamCount, got: given, line: memberTok.line, column: memberTok.column)
		end 'eachSlot'
	end 'requireEveryMessageArgumentGiven'

	// A message's declared parameter NAMES. Asked through one function because three readers need them and a
	// disagreement would slot an argument into one position and count it against another.
	function serviceMessageParamNames(callee ByteArray) returns NameRoster
		return serviceDeclarationOf(self.signatures, key: callee).paramNames
	end 'serviceMessageParamNames'

	function serviceMessageFirstParam(callee ByteArray) returns ParamCount
		return firstUserParamIndex(serviceDeclarationOf(self.signatures, key: callee).takesReceiver)
	end 'serviceMessageFirstParam'

	// Is this member the SYNTHESIZED struct `clone` — the name `clone`, on a struct that declares no `clone` of
	// its own? The gate in front of the emit below. `declaresCallee` is the WHOLE-PROGRAM index, not this file:
	// a user's `Point.clone` may be written in any file, which is the same reason
	// `structComparisonOperands` asks its `equals` question the same way.
	function cloneIsSynthesized(callee ByteArray, memberTok Token) returns bool
		return memberTok.value.equals(CloneMethodName) and not self.signatures.declaresCallee(callee)
	end 'cloneIsSynthesized'

	// `p.clone()` as the direct `__clone_<T>(box)` call it is. The result is a FRESH, SOLELY-owned box — the
	// cloner's first act is an `__mm_alloc` — so it is enrolled as an owned temporary exactly as a struct
	// literal's box is, and a binding adopts it or the statement drops it. An INLINE PACKED record has no
	// box and nothing to own — the copy IS the word — so it is retagged instead, which is what gives the
	// result a value of its own rather than a second name for the receiver's.
	//
	// The result is stamped `structRef` + the receiver's own layout name, which is the same pair
	// `emitStructLiteral` mints, and a generic receiver's clone with the receiver's own instance: a clone
	// of a `Point` IS a `Point`, so `b.x` and `b.equals(a)` resolve against the one nominal identity.
	//
	// ⚠ The cloneability refusal comes BEFORE the tokens are consumed and before anything is emitted — a
	// rejected program must leave no ops behind (`emitShift`'s rule).
	function emitSynthesizedStructClone(base StructBase, memberTok Token, baseTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.between(baseTok, last: memberTok)

		// Asked of the layout, not the receiver's tag: `self.clone()` inside `Box`'s own body has a
		// `structRef` receiver, and the declared-type cloner would blit its `T` word unretained.
		if base.layout.typeParamCount() > 0 'aGenericBase'
			let instance = try self.cloneableInstanceOf(base, memberTok: memberTok)
			self.advance()
			try self.consumeEmptyArgList()
			return self.emitOwnedRuntimeResult(self.signatures.genericInstanceBoxCloneCallee(instance), args: argsOf(base.box), resultTag: self.tagOf(base.box), resultNameId: self.valueNameId(base.box), range: range)
		end 'aGenericBase'

		try self.requireNoUniqueCause(self.signatures.uniqueCauseOf(base.layout.name), subject: String.from(base.layout.name), verb: "cloned", anchor: baseTok)
		try self.requireStructCloneVerdict(self.signatures.sourceCloneVerdictOfAggregate(base.layout.name), typeName: base.layout.name, display: String.from(base.layout.name), memberTok: memberTok)
		self.advance()
		try self.consumeEmptyArgList()

		if self.signatures.layoutPacksInlineIntoAWord(base.layout) 'theCopyISTheWord'
			return self.emitRetaggedCastValue(base.box, targetType: MaxonType.structRef(self.artifact.typeNames.intern(base.layout.name)), range: range)
		end 'theCopyISTheWord'

		return self.emitOwnedRuntimeResult(clonerSymbol(base.layout.name), args: argsOf(base.box), resultTag: ValueTypeTag.structRef, resultNameId: self.artifact.typeNames.intern(base.layout.name), range: range)
	end 'emitSynthesizedStructClone'

	// ⭐ **WHICH DECLARED UNION `<receiver>.clone()` CLONES, or `undeclared` for every other member and every
	// other receiver.** The decision the enum dispatch's clone arm branches on, spelled once so the arm holds
	// one test rather than three.
	//
	// ⚠ **THE `cloneIsSynthesized` PROBE COMES FIRST AND IS WHAT KEEPS THIS OFF THE HOT PATH.**
	// `ProgramSignatures.enumFor` returns a `DeclaredEnum` — a union VALUE, so a heap box for its `undeclared`
	// case as much as any other — and EVERY enum method call in every program arrives here; asking the registry
	// before the name would allocate one per call. See `valueIsUnion`, which guards the same registry probe the
	// same way and carries the measurement.
	function boxedUnionCloneReceiver(enumName ByteArray, callee ByteArray, memberTok Token) returns DeclaredEnum
		if not self.cloneIsSynthesized(callee, memberTok: memberTok) 'notTheSynthesizedClone'
			return DeclaredEnum.undeclared
		end 'notTheSynthesizedClone'

		let declared = self.signatures.enumFor(enumName, readerFilePath: self.job.path)

		if not enumMatchIsDeclared(declared) 'notADeclaredEnum'
			return DeclaredEnum.undeclared
		end 'notADeclaredEnum'

		// A payload-free enum IS its i64 tag: there is no box to allocate and no slot to deep-copy, so the
		// cloner `installUnionCascades` would build for it copies nothing. It keeps the undefined-function
		// refusal the spelling already earns, which is the oracle's answer too (E4006).
		if not requireEnumLayout(declared).carriesPayloads() 'payloadFreeEnum'
			return DeclaredEnum.undeclared
		end 'payloadFreeEnum'

		return declared
	end 'boxedUnionCloneReceiver'

	// `u.clone()` as the direct `__clone_<U>(box)` call it is — `emitSynthesizedStructClone`'s union twin, and
	// it mints the pair `emitEnumBox` mints: `named` + the union's own layout name, so the clone of an `Op` IS
	// an `Op` and a `match` on it dispatches over the same case set. The result is a FRESH box the cloner
	// `__mm_alloc`s, so it is enrolled as a sole owned temporary and a binding adopts it.
	//
	// ⚠ The refusals come BEFORE the tokens are consumed and before anything is emitted, for
	// `emitSynthesizedStructClone`'s reason: a rejected program must leave no ops behind.
	function emitSynthesizedUnionClone(recv MethodReceiver, layout EnumLayout, memberTok Token) returns ValueId throws SourceParseError
		try self.requireUnionCloneSupported(layout, memberTok: memberTok)
		self.advance()
		try self.consumeEmptyArgList()

		return self.emitOwnedRuntimeResult(clonerSymbol(layout.name), args: argsOf(recv.value), resultTag: ValueTypeTag.named, resultNameId: self.artifact.typeNames.intern(layout.name), range: SourceRange.between(recv.anchor, last: memberTok))
	end 'emitSynthesizedUnionClone'

	function requireUnionCloneSupported(layout EnumLayout, memberTok Token) throws SourceParseError
		let verdict = self.signatures.sourceCloneVerdictOfAggregate(layout.name)

		if verdict == SourceCloneVerdict.cloneable 'cloneable'
			return
		end 'cloneable'

		try self.requireCloneCopiesNoGreenThread(verdict, subject: "`{String.from(layout.name)}`", memberTok: memberTok)
		try self.refuseCloneOfAnUncloneableConformer(self.signatures.uncloneableExistentialIn(layout.name), memberTok: memberTok)

		throw SourceParseError.unsupported("`clone` on `{String.from(layout.name)}`, which carries a payload this compiler cannot deep-clone: an OS handle (`__ManagedFile`/`__ManagedDirectory`/`__ManagedSocket`), which cannot be duplicated at all, or a type that owns one. String, struct, boxed-union, enum, `Array`, `FixedArray`, `List` and declared-generic instance payloads ARE supported.", line: memberTok.line, column: memberTok.column)
	end 'requireUnionCloneSupported'

	function requireCloneCopiesNoGreenThread(verdict SourceCloneVerdict, subject String, memberTok Token) throws SourceParseError
		if verdict == SourceCloneVerdict.holdsAGreenThread 'aGreenThreadIsCopied'
			throw self.greenThreadCopyRefusal(subject, memberTok: memberTok)
		end 'aGreenThreadIsCopied'
	end 'requireCloneCopiesNoGreenThread'

	function greenThreadCopyRefusal(subject String, memberTok Token) returns SourceParseError
		return SourceParseError.promiseCannotBeBorrowed(String.from(memberTok.value), cure: "{subject} is or holds a promise, and a promise owns a green thread that exactly one owner may reclaim — so a copy would give two of them one thread. `await` the promise and copy a value holding its RESULT", line: memberTok.line, column: memberTok.column)
	end 'greenThreadCopyRefusal'

	function requireInstantiationsCopyNoGreenThread(param TypeParamId, fallbackSubject String, memberTok Token) throws SourceParseError
		match self.signatures.genericTypeFieldGreenThreadInstantiation(param) 'greenThread'
			noInstance then return
			instance(site) then try self.refuseCopyOfAnInstantiation(site, fallbackSubject: fallbackSubject, memberTok: memberTok)
		end 'greenThread'
	end 'requireInstantiationsCopyNoGreenThread'

	function refuseCopyOfAnInstantiation(site InstantiationSiteLookup, fallbackSubject String, memberTok Token) throws SourceParseError
		self.blameLibraryRefusalOnInstantiation(site)

		match site 'site'
			unwritten then throw self.greenThreadCopyRefusal(fallbackSubject, memberTok: memberTok)
			written(written) then throw self.greenThreadCopyRefusal("`{String.from(self.signatures.instanceDisplayName(written.gid))}`", memberTok: memberTok)
		end 'site'
	end 'refuseCopyOfAnInstantiation'

	function cloneableInstanceOf(base StructBase, memberTok Token) returns GenericInstanceId throws SourceParseError
		if self.tagOf(base.box) != ValueTypeTag.genericInstance 'noInstanceInHand'
			throw SourceParseError.unsupported("`clone` on `{String.from(base.layout.name)}`, which is a GENERIC type read where its type parameters name no instance — a clone is minted per INSTANCE (a `{String.from(base.layout.name)} with String` and a `{String.from(base.layout.name)} with int` copy different things), so it is written where the instance is known. Clone the value at a site that names its instance, or write a `clone` method on `{String.from(base.layout.name)}` that rebuilds it.", line: memberTok.line, column: memberTok.column)
		end 'noInstanceInHand'

		let instance = self.valueInstanceId(base.box)
		try self.requireStructCloneVerdict(self.signatures.sourceCloneVerdictOfType(MaxonType.genericInstance(instance)), typeName: base.layout.name, display: self.valueDisplayTypeName(base.box), memberTok: memberTok)
		return instance
	end 'cloneableInstanceOf'

	function requireStructCloneVerdict(verdict SourceCloneVerdict, typeName ByteArray, display String, memberTok Token) throws SourceParseError
		if verdict == SourceCloneVerdict.cloneable 'cloneable'
			return
		end 'cloneable'

		try self.requireCloneCopiesNoGreenThread(verdict, subject: "`{display}`", memberTok: memberTok)
		try self.refuseCloneOfAnUncloneableConformer(self.signatures.uncloneableExistentialIn(typeName), memberTok: memberTok)

		throw SourceParseError.unsupported("`clone` on `{display}`, which owns a field this compiler cannot deep-clone: an OS handle (`__ManagedFile`/`__ManagedDirectory`/`__ManagedSocket`), which cannot be duplicated at all, or a type that owns one, including one held INSIDE a struct field. String, struct, boxed-union, enum, `Array`, `FixedArray`, `List` (managed elements included), declared-generic instance (`Box with String`) and interface-typed fields ARE supported.", line: memberTok.line, column: memberTok.column)
	end 'requireStructCloneVerdict'

	// The one conformer-naming refusal the four clone gates share, each asking it AHEAD of its own general
	// wording so the named reason wins where there is one. `none` is not "cloneable" — it is "not this", and
	// the caller's own refusal then stands.
	function refuseCloneOfAnUncloneableConformer(blame UncloneableExistentialSlot, memberTok Token) throws SourceParseError
		match blame 'blame'
			none then return
			slot(structName, fieldName, interfaceName, conformerName) then throw SourceParseError.unsupported("`{String.from(memberTok.value)}` on `{String.from(structName)}`, whose field `{String.from(fieldName)}` holds a `{String.from(interfaceName)}` value that may be a `{String.from(conformerName)}`, which {self.signatures.uncloneableConformerReason(conformerName)}", line: memberTok.line, column: memberTok.column)
		end 'blame'
	end 'refuseCloneOfAnUncloneableConformer'

	// ⭐ **THE CONDITIONAL-EXTENSION REFUSAL, AT THE ONE DOOR EVERY STRUCT METHOD CALL PASSES THROUGH.**
	// Asked before the callee is built, because the answer is about the NAME and not about the arguments: a
	// method a `where` clause withheld does not exist for this receiver at any arity.
	//
	// A `Map.contains`-cheap probe of a store that is EMPTY in every program declaring no conditional
	// extension, which is the whole corpus but one spec — so the ordinary method call pays one miss and
	// allocates nothing: `callee` is the caller's own, which it is about to dispatch on regardless.
	function requireMethodNotWithheldByConstraint(typeName ByteArray, callee ByteArray, receiver ValueId, memberTok Token) throws SourceParseError
		match self.signatures.conditionalExtensionSkipOf(callee) 'skip'
			notWithheld then break
			withheld(skip) then throw SourceParseError.conditionalExtensionWithheld(String.from(skip.typeName), methodName: String.from(skip.methodName), clause: skip.clause, unmetInterfaceName: String.from(skip.unmetInterfaceName), bindingName: String.from(skip.bindingName), line: memberTok.line, column: memberTok.column)
		end 'skip'

		try self.requireReceiverSatisfiesExtensionConstraints(typeName, callee: callee, receiver: receiver, memberTok: memberTok)
	end 'requireMethodNotWithheldByConstraint'

	// ⭐⭐ **THE OTHER HALF OF THE CONDITIONAL REFUSAL: a TYPE extension's clause is checked at the CALL, per
	// RECEIVER, because there is nowhere earlier it could be.** The compiler compiles one body per generic type,
	// so `extension Box where Item is Equatable` cannot be filtered per instance the way an
	// interface extension is filtered per conformer — every `Box with X` shares the one `Box.matches`, and
	// what varies is whether a given receiver may reach it.
	//
	// ⚠ **WITHOUT THIS THE PROGRAM DOES NOT FAIL, IT PANICS.** `Box with NotEq` then `.matches(…)` reached
	// `LowerMaxonToStd.ensureWitnessTable` for `__witness_NotEq.Equatable` and died in `witnessSlotImpl`
	// ("no conformance selected a member for slot 'NotEq.Equatable.equals'") — measured, in exactly the shape
	// that panic's own message predicts: a table built for a conformance nothing validated.
	//
	// Two receiver shapes, and both are the same question asked of what the call site actually knows:
	//
	//   • A CONCRETE generic instance — the type argument is known, so ask whether it conforms. This is the
	//     `witnessArgSourceOfValue`'s concrete-instance arm's precondition, checked where a position exists.
	//   • ANYTHING ELSE (the enclosing generic body's own `self`, a value of its type parameter) — the
	//     argument is opaque and the witness is FORWARDED from the caller's own slots, so the caller must
	//     carry the SAME constraints in the SAME order. Inside the extension's own body it does, by
	//     construction (`openExtensionBodyScope` installs that very list); inside a plain method of the same
	//     type it carries only the type's own, and the forward would read a slot that was never reserved.
	//
	// ⚠ **THE TWO LISTS THIS FUNCTION HOLDS ARE DIFFERENT LISTS AND MUST STAY SO.** The one it VALIDATES
	// is the extension's own clause — the constraints nothing else checks, and the clause a refusal quotes back
	// at the author. The one the OPAQUE arm compares against is the callee's WHOLE witness list
	// (`witnessConstraintsOfMethod`: the type's constraints then the extension's extras), because that is what
	// the forward is index-aligned to. Comparing against the extension's clause alone is right only when the
	// two coincide, i.e. only for a target type that declares no `where` of its own.
	function requireReceiverSatisfiesExtensionConstraints(typeName ByteArray, callee ByteArray, receiver ValueId, memberTok Token) throws SourceParseError
		let constraints = self.signatures.extensionMethodConstraintsOf(callee)

		if constraints.isEmpty() 'notAConditionalTypeExtensionMethod'
			return
		end 'notAConditionalTypeExtensionMethod'

		let clause = self.signatures.renderExtensionClause(typeName, constraints: constraints)

		if self.tagOf(receiver) != ValueTypeTag.genericInstance 'opaqueReceiver'
			if whereConstraintsMatch(self.enclosingWhereConstraints, other: self.signatures.witnessConstraintsOfMethod(callee, extensionConstraints: constraints)) 'callerCarriesThem'
				return
			end 'callerCarriesThem'

			throw SourceParseError.unsupported("'{String.from(typeName)}.{String.from(memberTok.value)}' is a conditional extension method ({clause}), and this receiver's type argument is not known here — the enclosing function carries no witness for that constraint to forward. Call it on a concrete instance, or declare the same `where` clause on the function's own extension", line: memberTok.line, column: memberTok.column)
		end 'opaqueReceiver'

		match receiverMeetsExtensionConstraints(self.signatures, gid: self.valueInstanceId(receiver), constraints: constraints) 'constraint'
			met then break
			unmet(interfaceName, argDisplayName) then throw SourceParseError.conditionalExtensionWithheld(String.from(typeName), methodName: String.from(memberTok.value), clause: clause, unmetInterfaceName: String.from(interfaceName), bindingName: String.from(argDisplayName), line: memberTok.line, column: memberTok.column)
		end 'constraint'

		try self.requireTablesToForwardOpaqueArguments(self.valueInstanceId(receiver), callee: callee, extensionConstraints: constraints, methodName: memberTok.value, anchor: memberTok)
	end 'requireReceiverSatisfiesExtensionConstraints'

	function requireTablesToForwardOpaqueArguments(instance GenericInstanceId, callee ByteArray, extensionConstraints WhereConstraintArray, methodName ByteArray, anchor Token) throws SourceParseError
		if self.emittingFunctionCarriesWitnessParams() or not self.signatures.constraintsNameABareTypeParameter(callee, extensionConstraints: extensionConstraints, gid: instance) 'nothingToForwardOrSomewhereToForwardFrom'
			return
		end 'nothingToForwardOrSomewhereToForwardFrom'

		throw self.noWitnessTablesRefusal(methodName, arrival: arrivalWhenWithoutTables(self.emittingFunctionTableHolder(), outsideAClosure: NoWitnessTablesArrival.dispatchedOnAnInstanceOverATypeParameter), anchor: anchor)
	end 'requireTablesToForwardOpaqueArguments'

	// ⚠⚠ **A MANAGED FIELD READ OUT OF A TEMPORARY HOLDS THAT TEMPORARY TO THE SCOPE'S EXIT — the read is a
	// BORROW, and the box that owns what it borrows would otherwise die at the end of THIS statement.**
	// `emitFieldLoad`'s header states the invariant the borrow rests on in full: *"the read is a BORROW … so
	// the box keeps its +1 and drops the value at ITS scope exit; a `let s = b.value` re-reads a live pointer
	// and is never double-dropped."* A box bound to NO NAME had no scope exit later than the statement —
	// `trackOwnedTemp` enrolled it, the statement's pending drops freed it — so any result that outlived the
	// statement was a pointer into freed memory.
	//
	// Unguarded, every managed field kind reads freed memory: a String field
	// (`Box.make("hello").name`), an Array field, a struct field, and a tuple element (a tuple is a
	// synthesized struct, so it needs no arm of its own). The struct field reads the freed-memory fill byte
	// back as user data, a wrong answer with no crash at all.
	//
	// ⚖ The box is promoted to a scope-lifetime binding (`giveTemporaryScopeLifetime`) — the user ruling is
	// to extend the temporary's lifetime. It is the SAME promotion, through the SAME door, that a container
	// an ELEMENT borrow came out of gets, so the two cannot come to have two cures.
	//
	// A SCALAR field is COPIED, not borrowed, so it is untouched — which is exactly what keeps
	// `postfix.field-read-on-a-call-result` (`Leaf.make(4).tally`) paying nothing, and what makes the gate the
	// managed classifier and not the temporary.
	function keepFieldSourceAliveForItsRead(base StructBase, index FieldIndex) returns bool
		// A box owned by a NAME — a local, a parameter, `self`, a captured env slot — or a borrow of one
		// already outlives the statement, and the read is the ordinary borrow every field chain already is.
		// Only an UNCONSUMED owned temporary needs promoting, which `giveTemporaryScopeLifetime` asks for
		// itself; this early return is the COST gate, keeping the managed classification below off the hot
		// path of every field read in a program.
		if not self.pendingTempsContain(base.box) 'boxOutlivesTheStatement'
			return false
		end 'boxOutlivesTheStatement'

		// ⭐ **BOTH ARMS ARE THE DOOR THE BOX'S OWN DESTRUCTOR DECIDES THIS FIELD'S DROP THROUGH.** A generic
		// INSTANCE must SUBSTITUTE its opaque arguments before it can answer (an `Element` field is managed
		// for `Box with String` and inert for `Box with Int`); a plain struct field is `structFieldIsManaged`,
		// which is literally the per-field predicate `__destruct_<T>`'s cascade loops over. "The box frees it
		// at drop" and "the read borrows it" are then one answer and cannot come apart — a field this gate
		// let through while the destructor freed it would be exactly the crash above, wearing a guard.
		//
		// ⚠ **IT ASKS THE STRUCT AND THE INDEX, NOT A TYPE, AND THAT IS THE FIX FOR A MEASURED CROSS-FILE
		// USE-AFTER-FREE.** A spelling that routes the field type out through `fieldTypeOf(…, into:
		// self.artifact.typeNames)` — which ADOPTS it, re-interning a `named` against THIS FILE's table — and
		// then asks `typeIsManaged`, which resolves that id against the PROGRAM-WIDE one. Same number,
		// different table, so the classification follows the interning ORDER: cross-file, a scalar alias
		// field reads MANAGED (a false `E2015` on a legal `Gate.twice(21).n`) and a boxed-UNION field reads
		// SCALAR, admitting the very borrow-out-of-a-temporary above and hanging on the freed box. Asking by
		// STRUCT NAME and INDEX never lets a type cross an interner boundary at all, so there is no id to get
		// wrong, and the guard and the cascade read one column. `typeIsManaged` demands its interner by
		// name (`from:`) so the two-step cannot be rebuilt by accident.
		let borrowsManagedHeap = self.signatures.genericInstanceFieldIsManaged(self.valueInstanceId(base.box), index: index) if self.tagOf(base.box) == ValueTypeTag.genericInstance else self.signatures.structFieldIsManaged(base.layout.name, index: index)

		if not borrowsManagedHeap 'scalarFieldIsCopiedNotBorrowed'
			return false
		end 'scalarFieldIsCopiedNotBorrowed'

		self.giveTemporaryScopeLifetime(base.box, name: BorrowSourceBindingName)
		return true
	end 'keepFieldSourceAliveForItsRead'

	// ⭐ **THE CONCRETE INSTANCE A METHOD'S RECEIVER SUPPLIES TO THE CALLER-SIDE CONSUME.**
	// A `genericInstance` receiver (`sc` of type `Container with String`) knows its instance gid at the call
	// site — the same provenance `retypeGenericAliasConstructorResult` stamped on it — so a method whose param
	// FEEDS an opaque type parameter (`push(item Element)` moving `item` into `self.items`) can decide, right
	// here, whether that argument OWNS managed heap for THIS instance and must be MOVED in. It is the method
	// twin of `constructorInstanceOf`: a generic-alias CONSTRUCTOR reads the instance off the alias name, an
	// instance method reads it off the receiver's value. A `structRef` receiver (a plain struct, or `self` in
	// the shared body, which does not know its concrete instance) supplies `none` and borrows exactly as before.
	function receiverConstructorInstance(box ValueId) returns ConstructorInstance
		if self.tagOf(box) == ValueTypeTag.genericInstance 'instance'
			return ConstructorInstance.instance(self.valueInstanceId(box))
		end 'instance'

		return ConstructorInstance.none
	end 'receiverConstructorInstance'

	// ⭐ **RETYPE A METHOD RESULT TO CARRY PER-INSTANCE IDENTITY.** Two shapes gain it from the
	// receiver, and they need DIFFERENT things off it:
	//   • a `Self` return (`withTag() returns Self`, resolved to the base `structRef`) is re-tagged to the
	//     receiver's OWN `genericInstance` — so `w = w.withTag(7)` stays the same instance and type-checks
	//     (the assignment would else reject `Wrapper` into a `genericInstance` var). It needs the receiver's
	//     GID and nothing else; the alias is propagated when the receiver has one (see the arm);
	//   • an INNER-ALIAS return (`getTag() returns Idx`, resolved to `named("Wrapper.Idx")`) is re-qualified
	//     to `named("{alias}.Idx")` — so `a.getTag()` is a `WrapperA.Idx` value the arg check compares by
	//     name. That one IS the alias, so a receiver with no alias leaves it plain.
	// `receiver` is BORROWED; only the result's type moves.
	function retypeInstanceMethodResult(result ValueId, receiver ValueId)
		let receiverAlias = brandBeneathBufferView(self.brandOf(receiver))

		// ⭐⭐ **A `Self` RETURN IS FIXED BY THE RECEIVER'S *INSTANCE*, AND THE ALIAS IS ONLY A SPELLING IT MAY
		// ALSO CARRY — so this arm sits ABOVE the alias gate.** Below it, an aliasless receiver DECAYS its
		// `Self` result to the base `structRef`, which is not a harmless widening: `Array with T` and `Array`
		// are different types to every later check, so the decayed value is refused by the very declaration
		// that produced it. It shows only on a receiver nothing SPELLS — an array literal, a `static` field, a
		// value merged across branches — which is why a synthesized surface hides it completely.
		//
		// ⚠ **MEASURED, by striking `slice`/`clone` from `arraySurfaceMemberNames` so `stdlib/Array.maxon`'s
		// own `returns Self` bodies serve the calls**: `stdlib/TraceCapture.maxon`'s `captured.clone()` is
		// `E3005 Cannot return 'Array' from function declared to return 'TraceKeyArray'` — a stdlib body
		// refused for returning exactly what it declared — and every downstream read of a `slice` result is
		// `E3059 … 'int' does not match expected type 'type parameter'`, because the base `Array` fixes no
		// element. 78 cases under `clone` alone, 55 under `slice`.
		//
		// ⚠ **THE ALIAS IS STILL PROPAGATED WHEN THERE IS ONE, AND IT IS THE ALIAS THAT IS OPTIONAL RATHER
		// THAN THE INSTANCE.** `brandValue` names the SPELLING a diagnostic quotes back
		// (`bytearray-element-size`'s contested-alias family lives on it); an empty one is a value no source
		// text names, not a value with no type.
		if self.tagOf(result) == ValueTypeTag.structRef and self.tagOf(receiver) == ValueTypeTag.genericInstance 'selfReturn'
			let gid = self.valueInstanceId(receiver)
			let baseId = self.artifact.typeNames.intern(self.signatures.genericInstanceBaseName(gid))

			if self.valueNameId(result) == baseId 'sameBase'
				self.retypeValue(result, valueType: MaxonType.genericInstance(gid))

				if not receiverAlias.isEmpty() 'receiverSpellsItsInstance'
					self.brandValue(result, brand: receiverAlias)
				end 'receiverSpellsItsInstance'

				// ⭐ **AND THE ELEMENT SURFACE RIDES WITH IT, for the reason `inheritArrayElementSurface`
				// states one door over**: a `Self` result IS a value of the receiver's own instance, and
				// `Array with __ManagedMemory` / `Array with ByteArray` are ONE `GenericInstanceId` — so the
				// element spelling cannot ride the gid and has to ride the value. The synthesized `clone` /
				// `slice` arms carry it explicitly; a corpus body returning `Self` is the same operation
				// reached from source, so it may not lose it. (MEASURED with `slice`/`clone` struck:
				// `b.get(0).length()` after `let b = a.clone()` on an `Array with __ManagedMemory` was
				// *"`Array` member 'length'"* — the exact sentence that helper exists to retire.)
				// A receiver holding no buffer-surface elements carries no mark, so this is a bit-test that
				// answers no for every other container and every plain struct.
				_ = self.inheritArrayElementSurface(result, source: receiver)
				return
			end 'sameBase'
		end 'selfReturn'

		// An INNER-ALIAS return is re-qualified through the receiver's alias SPELLING and has nothing to fall
		// back on without one — `named("{alias}.Idx")` cannot be built from a gid — so this arm keeps the gate
		// the arm above shed.
		if receiverAlias.isEmpty() 'noReceiverAlias'
			return
		end 'noReceiverAlias'

		if self.tagOf(result) == ValueTypeTag.named 'namedReturn'
			if let member = try self.signatures.innerAliasMember(self.internedName(self.valueNameId(result))) 'innerAliasReturn'
				self.retypeValue(result, valueType: MaxonType.named(self.artifact.typeNames.intern(joinQualifiedName(receiverAlias, member: member))))
			end 'innerAliasReturn'
		end 'namedReturn'
	end 'retypeInstanceMethodResult'

	// A callee that reads `countof` of the sized container's own `Self` takes the answer from a hidden
	// argument the call site fills in, from one of three sources: the receiver's instance when it
	// states a count, the receiver's record when the instance is runtime-sized, and the emitting
	// function's own slot otherwise. A frame with none would reach
	// `LowerMaxonToStd.forwardCallerFixedElementCount`'s panic, far from the spelling that caused it.
	//
	// ⛔ The reservation fixpoint cannot be made complete by adding token shapes, which is why this is
	// a door. It reads raw tokens: `selfTypedLocalBoundAt` admits `= Self{…}` and `= Self.<static>(`
	// because those spellings name the type, and no token shape tells it that `self.dup()` returns
	// `Self`. So these arrive here with no slot to forward:
	//   • `var other = self.dup()` then `other.capacity()`.
	//   • `var x = other` where `other` is a `Self` parameter.
	//   • `function(v Self) gives v.capacity()` inside a method that reserved no count slot: a closure
	//     carries only the slot the enclosing method has.
	//
	// ⚠ It asks what the function being emitted carries, not what its declaration reserved
	// (`requireWitnessSourceForForwarding`'s distinction): a closure body is parsed inside its method
	// but emitted as its own function, and carries the count only as a word inherited through its
	// environment (`enclosingThroughEnv`).
	//
	// ⚠ The receiver test is `ProgramSignatures.elementCountSourceOf`, the same question
	// `LowerMaxonToStd.emitFixedElementCountOfReceiver` branches on, so this refusal cannot disagree with the
	// emit about which receivers need a forward. Wider, it would refuse a legal program; narrower, it
	// would let the abort back through.
	//
	// The clauses are ordered by cost: the whole-program bool leaves every program that writes no
	// `countof` before anything is looked up, and the qualified-name join, which allocates, is last.
	function requireFixedElementCountSourceForForwarding(base StructBase, memberTok Token) throws SourceParseError
		if not self.signatures.anyFunctionReadsFixedElementCount() 'noCountInThisProgram'
			return
		end 'noCountInThisProgram'

		match self.signatures.elementCountSourceOf(self.tagOf(base.box), nameId: self.valueNameId(base.box)) 'receiverSource'
			stated or
			inTheRecord then return
			callerSlot then break
		end 'receiverSource'

		match self.bodyState.fixedElementCountParam 'hasOneToForward'
			slot or
			enclosingThroughEnv then return
			none then break
		end 'hasOneToForward'

		if self.signatures.functionReadsFixedElementCount(qualifiedMethodName(base.layout.name, methodName: memberTok.value)) 'reject'
			throw SourceParseError.unsupported("calling '{String.from(memberTok.value)}' (which reads `countof` of the sized container's own `Self`) on a receiver whose type states no element count, from a function that carries no fixed-element-count parameter of its own to forward — the count reaches a shared body through a hidden argument every call site fills in from the instance it holds. Reach it {ReachThroughSelfClause} or a `Self.<static>()`, by chaining the call directly onto the expression that produced the receiver, or through a concrete sized instance", line: memberTok.line, column: memberTok.column)
		end 'reject'
	end 'requireFixedElementCountSourceForForwarding'

	// ⚠ **THE WITNESS TWIN OF `requireFixedElementCountSourceForForwarding`.** A dictionary-passing call on a
	// value of the enclosing generic type FORWARDS the caller's own witness tables
	// (`LowerMaxonToStd.witnessArgSourceOfValue`'s `structRef` arm), so the caller must carry
	// them. An INSTANCE method and a `Self`-returning static always do; any other static of a constrained type
	// reserves them conditionally, and lowering keeps them only while it carries the descriptor
	// (`refuseUnsuppliedTables`). A frame that reserved none would reach `forwardCallerWitness`'s panic; this
	// refuses it with a position instead.
	//
	// ⚠ **IT ASKS `emittingFunctionCarriesWitnessParams`, NOT the declaring function's COUNT, and the difference
	// is a LIFTED CLOSURE.** Forwarding copies the caller's hidden witness PARAMETERS into the callee's,
	// by position (`LowerMaxonToStd.forwardCallerWitness`) — so the question is what the function being EMITTED
	// carries, and a lifted closure carries none however constrained the method that wrote it is. Asked of the
	// declaring count instead, a closure inside a constrained instance method would take the early return here
	// and forward parameter slots its own ABI never reserved: not a panic, a WRONG TABLE.
	function requireWitnessSourceForForwarding(base StructBase, callee ByteArray, memberTok Token) throws SourceParseError
		if self.emittingFunctionCarriesWitnessParams() 'hasThemToForward'
			return
		end 'hasThemToForward'

		if self.tagOf(base.box) != ValueTypeTag.structRef or not self.enclosingType.names(base.layout.name) 'notSameTypeValue'
			return
		end 'notSameTypeValue'

		if self.signatures.witnessConstraintsOfMethod(callee, extensionConstraints: self.signatures.extensionMethodConstraintsOf(callee)).isEmpty() 'calleeDispatchesNothing'
			return
		end 'calleeDispatchesNothing'

		throw self.noWitnessTablesRefusal(memberTok.value, arrival: arrivalWhenWithoutTables(self.emittingFunctionTableHolder(), outsideAClosure: NoWitnessTablesArrival.forwardedToACallee), anchor: memberTok)
	end 'requireWitnessSourceForForwarding'

	function emittingFunctionTableHolder() returns TableHolder
		return deriveTableHolder(not self.closureEnclosingFrames.isEmpty(), carriedTables: self.declaringWitnessParamCount)
	end 'emittingFunctionTableHolder'

	function noWitnessTablesRefusal(methodName ByteArray, arrival NoWitnessTablesArrival, anchor Token) returns SourceParseError
		return SourceParseError.unsupported(noWitnessTablesSentence(methodName, arrival: arrival), line: anchor.line, column: anchor.column)
	end 'noWitnessTablesRefusal'

	// ⭐ **A METHOD CALL ON A CAPTURED RECEIVER.** `b.doubled()` where `b` is an enclosing binding captured
	// by the closure. The receiver is READ OUT OF THE ENV (`emitCaptureRead` — a borrowed pointer copy) and
	// dispatched exactly as a local receiver: it is passed as `__self` (the method borrows its receiver).
	// An existential, enum or union receiver has no struct layout, so it dispatches as a receiver
	// value; anything else resolves through `capturedStructBase`, which refuses a non-struct.
	function capturedMethodCall(func IrFunction, baseTok Token, enclosing Scope, frame ElementIndex, resultUsed bool) returns ValueId throws SourceParseError
		self.advance()

		let baseName = self.baseBindingName(baseTok)
		let binding = enclosing.getInfo(baseName)

		if self.baseBindingIsADeferredCallResult(binding) 'deferredBase'
			return try self.deferredUnresolvedMemberResult(func)
		end 'deferredBase'

		let capturedTag = maxonTypeTag(binding.varType)
		let capturedNameId = typeNameIdOf(binding.varType)

		if capturedTag == ValueTypeTag.interfaceRef or self.typeIsEnumOrUnion(capturedTag, nameId: capturedNameId) 'aReceiverWithoutAStructLayout'
			let value = try self.emitCaptureRead(baseName, enclosing: enclosing, frame: frame, anchor: baseTok)
			let receiver = try self.baseBindingOf(binding, baseTok: baseTok, box: value)
			return try self.dispatchMethodOnReceiver(func, recv: MethodReceiver.create(value, tag: capturedTag, nameId: capturedNameId, anchor: baseTok, immutableName: self.immutableReceiverNameOf(receiver, baseTok: baseTok), subjectName: StorageSubject.none, owner: NoParamPositions, selfFieldName: SelfFieldAlias.none), resultUsed: resultUsed)
		end 'aReceiverWithoutAStructLayout'

		try self.consume(TokenKind.dot)
		return try self.dispatchMethodOnBase(func, base: try self.capturedStructBase(baseTok, enclosing: enclosing, frame: frame), baseTok: baseTok, resultUsed: resultUsed)
	end 'capturedMethodCall'

	// ⭐ **RESOLVE A CAPTURED STRUCT BASE TO ITS (box, layout)** — the shared resolution behind a
	// captured field access (`b.width`) and a captured method call (`b.doubled()`). The box is READ OUT
	// OF THE ENV (`emitCaptureRead` — a borrowed pointer copy, one `loadIndirect`, cursor-independent so a
	// caller may have already consumed the base token), and its layout is resolved from the enclosing binding's
	// struct type exactly as `requireStructBase` does for a local base. A captured value with no struct layout
	// is refused (a captured String's builtin methods are reached by no case here).
	//
	// ⛔ **THE GATE ASKS `tagCarriesStructLayoutHere` RATHER THAN SPELLING `!= structRef` ITSELF, WHICH
	// WOULD EXCLUDE EVERY GENERIC INSTANCE.** No door in this file guards a `structLayoutOfType` call
	// with a hand-rolled tag test; the two siblings (`requireStructBase` for a local base,
	// `structLayoutOfField` for a hop) both ask the predicate, and both carry the comment saying why —
	// *"a struct box OR a generic INSTANCE (`Sizer with bool`) can be a method/field base"*.
	// Left out, a closure that names a captured instance was refused, and the refusal CONTRADICTED
	// ITSELF: `typeTagName(genericInstance)` prints `"struct"`, so it read *"declared 'struct' and not
	// a struct type"*. It is the same shape `structLayoutOfField`'s header records, one door over, and the same
	// fix: ask the predicate rather than answer for yourself.
	function capturedStructBase(baseTok Token, enclosing Scope, frame ElementIndex) returns StructBase throws SourceParseError
		let baseName = self.baseBindingName(baseTok)
		let binding = enclosing.getInfo(baseName)
		let capturedTag = maxonTypeTag(binding.varType)
		let capturedTypeNameId = typeNameIdOf(binding.varType)

		if not self.tagCarriesStructLayoutHere(capturedTag) 'notAStruct'
			// `requireStructBase`'s undeclared-name guard, reached through a `function(…) gives` instead of a
			// bare name — identically able to assert an invented `int` without it, which is the second of
			// `requireDeclaredBaseTypeName`'s three doors.
			try self.requireDeclaredBaseTypeName(capturedTag, nameId: capturedTypeNameId, tok: baseTok)

			throw SourceParseError.unsupported("a field access or method call on the captured '{String.from(baseTok.value)}', which is declared '{typeTagName(capturedTag)}' and not a struct type (only a struct has fields and methods)", line: baseTok.line, column: baseTok.column)
		end 'notAStruct'

		// No storage subject: capture is BY VALUE, so a method call on a CAPTURED receiver cannot reach a
		// binding of the enclosing body.
		let layout = try self.structLayoutOfType(BaseAccessKind.member, tag: capturedTag, nameId: capturedTypeNameId, baseTok: baseTok)
		let box = try self.emitCaptureRead(baseName, enclosing: enclosing, frame: frame, anchor: baseTok)
		let receiver = try self.baseBindingOf(binding, baseTok: baseTok, box: box)
		return StructBase.create(layout, box: box, immutableName: self.immutableReceiverNameOf(receiver, baseTok: baseTok), subjectName: StorageSubject.none)
	end 'capturedStructBase'

	// ⭐ **A STRING RECEIVER'S LAST SYNTHESIZED DOOR, AND IT SERVES NO METHOD OF ITS OWN.**
	// It consists of the roster gate and the builtin-CONFORMANCE lookup — `hash`/`equals`, whose impls the
	// corpus defines and which this reaches by symbol rather than by re-synthesizing. Every actual member of
	// `String` is `stdlib/String.maxon`'s and is taken by `memberBelongsToTheCorpus` before this is asked.
	//
	// ⚠ **IT TAKES NO `resultUsed`, AND THAT IS A CONSEQUENCE RATHER THAN A TIDY-UP.** Only a VOID member needs
	// `requireVoidMethodIsStatement`, and this door serves none. A corpus member's void-ness is checked on the
	// corpus path, by the declaration.
	//
	// The cursor sits on the method NAME; the receiver's live-binding guard belongs to whichever door
	// resolved it (`dispatchMethodOnBinding` — a temporary has no move state to check).
	function dispatchStringMethod(func IrFunction, recv MethodReceiver) returns ValueId throws SourceParseError
		let baseTok = recv.anchor
		let methodTok = try self.consume(TokenKind.identifier)

		// ⭐⭐ **THE ROSTER IS THE SURFACE, AND IT IS ASKED BEFORE ANY ARM** — `dispatchArrayMethod`'s
		// gate, one type over, for its reason: "does this member exist?" is the question every other refusal
		// about the call presupposes, and a rule about HOW a member may be used must not speak for a member
		// the receiver does not have.
		//
		// ⚠ **IT IS BEHAVIOUR-NEUTRAL, and the derived list is what guarantees that**: every name off this
		// roster is refused here with E2015 at the call's token, its sentence derived from the roster rather than
		// hand-written. Nothing ON the roster can be
		// refused here, because every entry matches an arm or the conformance lookup (the panic at the end of
		// this function is what says so).
		//
		// ⚠ **THE ONE STDLIB-ONLY NAME PASSES THIS GATE AND IS REFUSED BY ITS OWN ARM.** That ordering is
		// the point of putting it on the roster at all: "the compiler has no such method" and "this method exists
		// and is not yours to call" are different statements, and the gate must not turn the second into the
		// first. `stdlib-only-string-methods.md` pins both directions — the real name gets the visibility
		// refusal, a near miss of it gets this roster.
		let roster = try self.requireSurfaceMember(MemberSurface.string, typeName: StringConformerName, methodTok: methodTok)

		// ⚠ A member reaches this dispatcher only by being on `stringSurfaceMemberNames`; striking it there is
		// the whole of retiring an arm, and the byte/ASCII family — `startsWith`, `endsWith`, `toLower`,
		// `toUpper`, `replace`, `replaceFirst`, `contains`, `split` — is off it.
		//
		// ⭐ `bytes()`/`codepoints()`/`utf16()` are the corpus's rather than this dispatcher's, and that
		// changes the RETURN TYPE: the corpus answers with a LAZY `ByteView`/`CodepointView`/`UTF16View`
		// holding the `String` (`stdlib/helpers/string/views.maxon`) where an arm here would answer with a
		// MATERIALIZED `Array`. `ByteView.create(s)` answers `count()` and drives `for b in v` to
		// `97,98,99` through the corpus's own `createIterator`/`current`/`advance`. `toByteArray()` is
		// the corpus's INDEPENDENT `managed.slice` copy.
		//
		// ⚠ `Character.bytes()` is NOT retired and still reaches `parseByteView` from
		// `dispatchCharacterMethod` — `type Character` has no view accessor to fall through to.
		//
		// ⭐⭐⭐ **NO ARM BELOW THIS LINE SYNTHESIZES A `String` MEMBER, ONLY THE CONFORMANCE DOOR.** The
		// scalar members and the byte doors — `byteLength`, `isEmpty`, `clone`, `addressableBytes`, `byteAt`,
		// `byteAtOrPanic`, `hasSingleByteGraphemes`, `append` and `setByte` — are `stdlib/String.maxon`'s,
		// which is the normative definition (`:264-270` says so outright of the byte primitives). Each is a
		// field load, a load plus a compare, or one runtime call, so what a corpus body adds over an arm is a
		// call frame and no other work.
		//
		// ⚠ **A MEMBER SERVED FROM ITS OWN DECLARATION NEEDS NO LOCATION GATE.** A location gate exists only
		// because a synthesized arm answers AHEAD of the corpus, so the visibility the corpus WROTE can never be
		// reached. With no arm, `SemanticCheck.calleeVisibleFrom` refuses each with E3008 — one mechanism,
		// where a gate makes two.
		//
		// ⛔ **`append` NEEDS A MASK RATHER THAN A BODY.** No `String` arm calls
		// `noteReceiverWrite(mutatesReceiver: true)`, so without the mask nothing would report E3207 for
		// `let s = "hello"; s.append(" world")` — a write through a receiver the caller may only
		// have BORROWED, which is a memory-safety fault rather than a lost message. The corpus body's
		// `writtenParamMask` is ZERO because both its writes are self-field writes, so `receiverOwnerMask`
		// derives that bit from the ENVELOPE COLLAPSE — see its header — and `String.append` states its own
		// receiver write, leaving the call-site half (`CapabilityCallCheck.checkCallArguments`) to
		// refuse it, naming the corpus's own parameter.
		//
		// ⛔ `mapAsciiCase` is routed to the corpus, and the one thing that has to hold for it is a label.
		// `specs/parameter-labels.md` rules that every argument after the first must be NAMED and E2053
		// enforces it, so `stdlib/String.maxon:672` writes `try work.setByte(i, value: b + delta)` —
		// without the `value:`, `stdlib/` refuses itself and the declared member cannot serve its own
		// only caller.
		//
		// ⭐ **A `setByte` LOWERS TO `__managed_set_byte` ON THE RECEIVER'S OWN RECORD**, which is what the
		// corpus body's `managed.setByte(…)` means on a FUSED record — a String record and an Array record
		// agree on all five slots that entry reads (`BufferOwnership`'s shared prefix), and it touches `@40`
		// nowhere. There is no `__str_set_byte` to keep in step.
		//
		// ⛔⛔ **WRITING THROUGH `__str_bytes_view(self)` INSTEAD LANDS THE WRITE NOWHERE.** That view is
		// NON-OWNING (`capacity@16 = ViewBufferCapacity`), so `__managed_set_byte`'s guard sends it through
		// `__managed_cow_detach` first: the view gets a private copy, the byte is written into the copy, and
		// the copy dies with the owned temporary at statement end. `buildStrBytesView`'s own header calls that
		// safe on the grounds that *"nothing in `stdlib/` writes through this door"* — true only while the
		// door's one corpus caller, `mapAsciiCase`, is unreachable. ⇒ **A CLAIM THAT AN UNREACHABLE PATH IS
		// SAFE IS A CLAIM NOTHING MEASURED.**

		// ⭐⭐ **`hash()` AND `equals(other)` ARE NOT STRING METHODS — THEY ARE THE BUILTIN CONFORMANCES, AND
		// THIS IS THE DIRECT-CALL DOOR ONTO THE IMPLS THAT ALREADY EXIST.** A
		// `__witness_String.*` slot is stamped with a `funcAbs64` reloc naming `String.hash`/`String.equals`,
		// and this emits those SAME symbols — one body, three doors, and emphatically not a second djb2
		// written at a call site.
		// ⛔⛔ **AND THE BODY BEHIND THOSE SYMBOLS IS THE CORPUS'S, NOT A SYNTHESIZED ONE.**
		// `BuiltinConformanceRuntime` builds an impl only for a candidate the module NAMES and does not
		// DEFINE, and `stdlib/String.maxon:365,373` declare both — so no synthesized pair is installed. On the
		// emitted IR `s.hash()` is `call String.hash`, whose body is `call hashString`
		// (`stdlib/helpers/string/hash.maxon:22`).
		// (`stdlib/helpers/string/hash.maxon:22`).
		//
		// ⇒ **SO THERE IS NOTHING HERE FOR A RETIREMENT TO MOVE.** A retirement exists to make the corpus body
		// serve
		// the member; for this pair the corpus body ALREADY serves it, and the only thing striking the two
		// names off the roster would change is which door routes the call — `memberBelongsToTheCorpus`
		// instead of the lookup below — to the identical symbol. That is churn with a return-type risk
		// (`HashValue` is `int(0 to u32.max)`; this door types the result off the `InterfaceMethodSig`) and no
		// benefit. The two hashes AGREE — same djb2, same seed, same multiplier, same low-32 mask — which is
		// what a `Set with String`'s bucket layout rides on; `BuiltinConformanceRuntime`'s header records the
		// full measurement.
		//
		// ⭐ **ASKED LAST, AND BY LOOKUP RATHER THAN BY TWO MORE `if`s.** Last, because the String method
		// table above must win — the arm-order rule `dispatchMethodOnReceiver` states, one level down. By
		// lookup, because then no method NAME is spelled here at all: the pair is DERIVED from
		// `isIntrinsicBuiltinConformance`'s `String` row, so this door cannot offer a method the installer
		// would decline to install, and the day `String` gains `Comparable` its `compare()` opens with no edit
		// here. A name the row does not supply falls through to the roster below, which is what keeps a typo a
		// typo rather than a permissions message.
		match builtinConformerMethod(StringConformerName, methodName: methodTok.value, discovered: DiscoveredConformer.none, interfaces: self.signatures.interfaceMap()) 'conformanceMethod'
			supplied(method) then return try self.emitBuiltinConformanceCall(func, receiver: recv.value, target: DirectConformanceTarget.builtinValue(BuiltinConformer.stringConformer), method: method, baseTok: baseTok, methodTok: methodTok)
			notSupplied then break
		end 'conformanceMethod'

		// ⚠⚠ **NO `String` RECEIVER CAN REACH HERE, AND THIS IS THE CHECK THAT SAYS SO.** The gate at
		// the top admitted only the names `stringSurfaceMemberNames` lists, and each of those matches an arm
		// above or the conformance lookup on its own spelling — so arriving here means the roster gained a
		// member and the dispatch did not. That is the defect the derived roster exists to close, one level up, and the
		// wrong answer it would otherwise give is unusually convincing: the reader would be handed the roster
		// refusal for a member the roster PROVIDES. It is exactly what a hand-written sentence could never
		// notice, which is how `addressableBytes` and `byteAtOrPanic` went unadvertised.
		// ⭐ **VERIFIED RED**: pushing a bogus name onto `stringSurfaceMemberNames` and calling it reaches
		// this panic, naming the member and both remedies rather than the roster refusal.
		let drift = rosterDriftMessage("dispatchStringMethod", member: methodTok.value, roster: roster, rosterFuncs: "`stringSurfaceMemberNames` (whose tail is `IrInterface.builtinConformerMethodNameList`)")
		panic("{drift}")
	end 'dispatchStringMethod'

	// ⚠ **`String.split` HAS NO PARSER ARM.** The corpus builds the `Array with String` through
	// `StringArray.create(0)` (`stdlib/String.maxon:618-625`), which reaches the SAME door by the ordinary
	// generic-instance path and stamps the same element size and the same `element_destroy@40` — measured on the
	// emitted code, see `ContainsMethod`'s header. `.bytes()` below is the only member here that fills a
	// caller-created array, and it keeps this shape for its own element's sake (`requireRawByteFillFitsItsElement`).

	// ⭐ **`Character.bytes()` — hand back this record's bytes as an `Array with Byte`.** `String.bytes()` falls through
	// to the corpus, so this emitter serves one receiver.
	//
	// The array is created HERE, through `emitArrayCreateOp` — the one array-creation door — and handed to
	// `__str_to_bytes` to fill: element size
	// and the `element_destroy@40` stamp are decided by the same code a `b"…"` literal uses, so a
	// `.bytes()` result and a byte-string literal cannot disagree about what an `Array with Byte` is. They
	// are in fact the SAME interned instance (`internArrayByteInstance`).
	//
	// ⚠⚠ **IT MATERIALIZES, AND THAT IS A `Character` DECISION AND NOT A `String` ONE.**
	// `String.bytes()` falls through to `stdlib/String.maxon:495`, whose `ByteView` is LAZY: the corpus needs no
	// special support for it, and `for b in ByteView.create(s)` walks the corpus's `createIterator`/`current`/`advance`
	// and prints `97,98,99`.
	//
	// ⚠ **`Character` IS NOT KEPT HERE FOR WANT OF A DECLARATION — `stdlib/Character.maxon:53` DECLARES
	// `bytes()` TOO.** It is kept because retiring it is a different trade with a cost of its own: that body
	// is `ByteView.create(toString())`, and `toString()` mints a whole `String` record per call, where this
	// emitter reads the Character's own bytes in place. `Character.bytes()` is on `characterSurfaceMemberNames`
	// and off the `String` roster, so retiring it is a decision about that allocation.
	// The result is an OWNED temp whose `__managed_decref` frees the record and its buffer.
	//
	// ⚠ **THE ELEMENT IS THE READING FILE'S OWN `Byte` ON PURPOSE, AND THAT IS WHY THE FILL HAS TO BE GATED.**
	// `__str_to_bytes` writes the receiver's raw UTF-8 into the record — bytes that exist only at run
	// time — so the element must admit every value a byte has. It is asked here rather than at the interning,
	// because what is wrong is the FILL and not the type: `requireRawByteFillFitsItsElement` states the whole
	// rule, and why the element may not simply be moved onto `__ManagedByte` to dodge it.
	//
	// The giid is read ONCE and threaded to both, so the instance the rule inspects is provably the instance
	// the record is typed as — `requireByteStringBlobFitsItsElement`'s coupling, on the other producer of the
	// same type.
	function parseByteView(record ValueId, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let giid = self.signatures.internArrayByteInstance(self.job.path)
		try self.requireRawByteFillFitsItsElement(giid, methodTok: methodTok)
		try self.consumeEmptyArgList()
		return try self.emitMaterializedFill(giid, callee: StrToBytesName, source: record, range: range)
	end 'parseByteView'

	// ⚠⚠ **`String.codepoints()`/`String.utf16()` ARE THE CORPUS'S AND MINT NO ARRAY INSTANCE.**
	// `CodepointView`/`UTF16View` are structs holding the `String`, so no compiler-synthesized decoding view over
	// `Codepoint`/`CodeUnit16` exists. The reason one must not is restated at
	// `SignatureIndex.SynthesizedByteElementName`: those two element names are RANGED typealiases in
	// stdlib modules, so an `Array with CodeUnit16` would take its stride from
	// `arrayElementSize`'s registry probe — making the element size of a compiler-synthesized view a function of
	// which files `stdlib/` holds that day.

	// ⭐⭐ **A PUSH-ONLY RUNTIME WALK THAT FILLS A CALLER-CREATED ARRAY.** The array is created HERE through
	// `emitArrayCreateOp` (the one array-creation door), handed to the walk as the SECOND argument after its
	// `(source, dest)` order, and the ARRAY — not the void call's result — is enrolled as the owned temporary.
	//
	// ⚠ The result is enrolled owned whatever the element is: `trackOwnedTemp` routes its scope-exit drop by
	// TAG through `decrefCalleeFor` (`__managed_decref`), which destroys the elements the record's own
	// `element_destroy@40` stamp names — so a managed-element fill needs nothing extra here.
	function emitMaterializedFill(giid GenericInstanceId, callee ByteArray, source ValueId, range SourceRange) returns ValueId throws SourceParseError
		let filled = try self.emitArrayCreateOp(giid, range: range, sizing: ValueIdArray.create(0))
		_ = self.emitRuntimeCall(callee, args: twoArgs(source, second: filled), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		self.trackOwnedTemp(filled, exclusivity: OwnedHeapExclusivity.sole)
		return filled
	end 'emitMaterializedFill'

	// ⭐⭐ **DOES THIS RECEIVER'S ELEMENT SATISFY THE `where` CLAUSE OF `Array`'s OWN CONDITIONAL
	// CONFORMANCE? — the WITHHOLDING rule, and it is the SAME question, the same predicate and the
	// same diagnostic a user's own conditional extension gets.** `ConformanceCheck.typeConformsTo`
	// over `sweptConformanceIndex` is what `requireReceiverSatisfiesExtensionConstraints` asks of a
	// declared type's extension methods; the only difference here is that the clause is stated by an
	// interface list instead of parsed. E4006 is therefore the same sentence a reader gets from a
	// `where` clause they wrote themselves.
	//
	// ⭐ **THE CLAUSE IS READ FROM `isIntrinsicBuiltinConformance` RATHER THAN TRANSCRIBED** (see that
	// predicate's `Array` arm): `where Element is Hashable and Equatable` is the SAME two protocols `Array`
	// conditionally supplies, so the sentence a reader is given and the row that decides it are one fact.
	//
	// ⚠ **ITS ONE CALLER IS THE `==`/`!=` OPERATOR.** `arr.hash()`, `a.equals(b)` and
	// `arr.contains(x)` are `stdlib/Array.maxon` extensions, each stating its clause in the language
	// and withholding itself. The operator has no declaration to withhold it, which is why this exists
	// — and why the interface list is not a PARAMETER: there is one clause to ask about, so a caller
	// cannot name a different one.
	//
	// ⚠ **AN OPAQUE `T` ELEMENT SATISFIES THE CLAUSE WHEN `T`'s OWN `where` CLAUSE PROMISES IT**
	// (`arrayElementConstraintCheck`), and the comparison then dispatches through `T`'s witness
	// tables, which the emitting function must carry (`requireTablesToForwardOpaqueArguments`).
	//
	// ⚠ **THE METHOD NAME AND THE POSITION ARE TWO PARAMETERS, because the OPERATOR door has one and not the
	// other.** `a == b` fails this rule as `Array.equals` — that is the method whose availability was
	// withheld — but the only span to blame is the operator's, and there is no `equals` token to read a name
	// off.
	function requireArrayConformanceAvailable(giid GenericInstanceId, methodName ByteArray, anchor Token) throws SourceParseError
		let interfaces = self.signatures.arrayConformanceProtocolNames()

		match self.signatures.arrayElementConstraintCheck(giid, clauseInterfaces: interfaces) 'clause'
			satisfied then break
			unmet(unmetInterfaceName, bindingName) then throw SourceParseError.conditionalExtensionWithheld(String.from(self.signatures.arrayRecordDeclaredName()), methodName: String.from(methodName), clause: arrayWhereClause(interfaces), unmetInterfaceName: String.from(unmetInterfaceName), bindingName: String.from(bindingName), line: anchor.line, column: anchor.column)
		end 'clause'

		let callee = qualifiedMethodName(self.signatures.genericInstanceBaseName(giid), methodName: methodName)
		try self.requireTablesToForwardOpaqueArguments(giid, callee: callee, extensionConstraints: self.signatures.extensionMethodConstraintsOf(callee), methodName: methodName, anchor: anchor)
	end 'requireArrayConformanceAvailable'

	// ⭐ **A `Character`'S BUILTIN METHODS** — the `dispatchStringMethod` twin, and a
	// separate dispatcher for the reason the two types are separate: a Character has no `append`, no
	// `split` and no case conversion, and a String has no `asciiValue`. Sharing one dispatcher would make
	// each type's method set the union of both, which is precisely the type-safety the distinct tag buys.
	//
	// The cursor sits on the method NAME (`dispatchMethodOnReceiver` consumed the `.`).
	//
	// It takes no `resultUsed`, unlike its String twin: every Character method RETURNS a value, so there is
	// no void result for a value-position call to misuse (`append` is the String method that needs it).
	function dispatchCharacterMethod(recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(recv.anchor, last: methodTok)

		// The roster gate, `dispatchStringMethod`'s twin — see there for why it is asked ahead of every arm.
		let roster = try self.requireSurfaceMember(MemberSurface.character, typeName: CharacterConformerName, methodTok: methodTok)

		if methodTok.value.equals(ByteViewMethod) 'bytes'
			return try self.parseByteView(recv.value, methodTok: methodTok, range: range)
		end 'bytes'

		// `byteLength()` is `length@8` — the UTF-8 width of the whole cluster, which for an EGC is the sum
		// of its codepoints' widths (a family emoji is 18). The same field load a String's `byteLength()`
		// is, because it is the same field of the same record.
		if methodTok.value.equals(ByteLengthMethod) 'byteLength'
			try self.consumeEmptyArgList()
			return self.emitIndirectLoad(self.declaredRuntimeMethodResult(CharacterConformerName, methodName: methodTok.value), box: recv.value, offset: StringLengthOffset, storageType: MaxonType.integer, range: range)
		end 'byteLength'

		// ⭐ **`asciiValue()` — THE ONE THROWING `Character` MEMBER**, and the one arm here whose call is a
		// `tryCall` rather than a plain one. Nothing about that is decided at this site: the arm emits an
		// ordinary call and `isThrowingRuntimeCallee` — which `GraphemeRuntime.isThrowingCharacterRuntimeCallee`
		// now joins — is what makes the parser's E3055 ACCEPT a `try` on it and SemanticCheck's E3057 REJECT a
		// bare one, off the one predicate so the accept and the reject cannot name different sets.
		//
		// ⚠ **IT WAS ABSENT UNTIL THE `if try …` FORM EXISTED, AND ITS ABSENCE WAS NEVER ABOUT THIS TYPE.**
		// The two corpus cases spell the call `if try c.asciiValue()` — the SUCCESS-TEST form of `try` in a
		// condition — and the compiler had that form for NO throwing call; the gap was in the `try` machinery, one
		// layer over. With the form built, the member is vocabulary WITH its consumer, which is the bar this
		// dispatcher's siblings are held to. A non-throwing variant was never on the table: it would have to
		// answer a non-ASCII cluster with a sentinel.
		if methodTok.value.equals(CharacterAsciiValueMethod) 'asciiValue'
			try self.consumeEmptyArgList()

			// ⭐ **THE RESULT IS TYPED FROM THE DECLARATION, NOT INVENTED HERE.** `stdlib/Character.maxon`
			// declares `asciiValue() returns AsciiValue`, a ranged alias — and a bare `integer` result loses
			// that name, which is the one thing a range rule can be stated over: `try c.asciiValue()
			// otherwise -1` compiled clean while the identical shape over a user function was refused,
			// because `declaredAliasOfValue` had no name to look up. Reading the signature rather than
			// naming the alias here is what stops the compiler holding a second copy of a stdlib
			// declaration.
			let asciiArgs = argsOf(recv.value)
			let asciiValue = self.emitRuntimeCallInto(self.mintValueOfType(self.declaredRuntimeMethodResult(CharacterConformerName, methodName: methodTok.value)), callee: CharAsciiValueName, args: asciiArgs, range: range, argLabels: emptyArgLabels(asciiArgs))
			self.noteRuntimeReadMember(asciiValue, typeName: CharacterConformerName, methodName: methodTok.value)
			return asciiValue
		end 'asciiValue'

		let drift = rosterDriftMessage("dispatchCharacterMethod", member: methodTok.value, roster: roster, rosterFuncs: "`characterSurfaceMemberNames`")
		panic("{drift}")
	end 'dispatchCharacterMethod'

	function parseCompilerOwnedStatic(func IrFunction, surface HandleSurface, typeTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.dot)
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(typeTok, last: methodTok)

		match compilerOwnedStaticNamed(surface, member: methodTok.value) 'lookup'
			found(kind) then return try self.emitCompilerOwnedStatic(func, kind: kind, typeTok: typeTok, methodTok: methodTok, range: range)
			notAStatic then panic("parseCompilerOwnedStatic: '{String.from(methodTok.value)}' passed `surfaceStaticOf` and the member table has no row for it — the roster and this dispatcher read one table")
		end 'lookup'
	end 'parseCompilerOwnedStatic'

	function surfaceReach(owned CompilerOwnedStaticSurface, typeTok Token) returns SurfaceReach
		try self.requireSurfaceIsReachable(owned, typeTok: typeTok) otherwise (err) 'theSurfaceIsNotReachable'
			return SurfaceReach.refused(err.clone())
		end 'theSurfaceIsNotReachable'

		return SurfaceReach.reachable
	end 'surfaceReach'

	function requireSurfaceIsReachable(owned CompilerOwnedStaticSurface, typeTok Token) throws SourceParseError
		match owned 'surface'
			handle(kind) then try self.requireHandleSurfaceIsReachable(kind, typeTok: typeTok)
			none then try self.requireTypeSpellingIsNotRawBuffer(typeTok)
			containerAlias or
			sharedValue then break
		end 'surface'
	end 'requireSurfaceIsReachable'

	function requireHandleSurfaceIsReachable(surface HandleSurface, typeTok Token) throws SourceParseError
		match surface 'surface'
			memory then try self.requireBufferSurfaceIsReachable(typeTok)
			file or
			directory or
			socket or
			pages or
			osHandle or
			pin then try self.requireTypeSpellingIsNotRawBuffer(typeTok)
		end 'surface'
	end 'requireHandleSurfaceIsReachable'

	function requireBufferSurfaceIsReachable(typeTok Token) throws SourceParseError
		if self.rawSurfaceIsRefusedHere() 'refused'
			throw self.rawSurfaceRefusal(RawSurfaceDoor.bufferType(typeTok.value), anchor: typeTok)
		end 'refused'
	end 'requireBufferSurfaceIsReachable'

	// ⚠ Throwing-ness is NOT decided here. The per-surface `isThrowingManaged…RuntimeCallee` predicates name
	// the callees and the composed `isThrowingRuntimeCallee` is read by the parser's E3055 accept and
	// SemanticCheck's E3057 reject, so a `try` is required at exactly the places those two agree on.
	function emitCompilerOwnedStatic(func IrFunction, kind CompilerOwnedStatic, typeTok Token, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		match kind 'static'
			fileOpenRead then return try self.parseManagedFileOpen(func, callee: ManagedFileOpenReadName, methodTok: methodTok, range: range)
			fileOpenWrite then return try self.parseManagedFileOpen(func, callee: ManagedFileOpenWriteName, methodTok: methodTok, range: range)
			fileOpenWriteExecutable then return try self.parseManagedFileOpen(func, callee: ManagedFileOpenWriteExecutableName, methodTok: methodTok, range: range)
			fileOpenCreateNew then return try self.parseManagedFileOpen(func, callee: ManagedFileOpenCreateNewName, methodTok: methodTok, range: range)
			fileExists then return try self.parseManagedFileExists(func, methodTok: methodTok, range: range)
			fileDelete then return try self.parseManagedFileDelete(func, methodTok: methodTok, range: range)
			fileRename then return try self.parseManagedFileRename(func, methodTok: methodTok, range: range)
			fileStat then return try self.parseManagedFileStat(func, methodTok: methodTok, range: range)
			fileStatField then return try self.parseManagedFileStatField(func, methodTok: methodTok, range: range)
			fileStatFree then return try self.parseManagedFileStatFree(func, methodTok: methodTok, range: range)
			directoryOpenSearch then return try self.parseManagedDirectoryOpenSearch(func, methodTok: methodTok, range: range)
			directoryExists then return try self.parseManagedDirectoryExists(func, methodTok: methodTok, range: range)
			directoryCreate then return try self.parseManagedDirectoryCreate(func, methodTok: methodTok, range: range)
			directoryDelete then return try self.parseManagedDirectoryDelete(func, methodTok: methodTok, range: range)
			directoryCurrentPath then return try self.parseManagedDirectoryCurrentPath(range)
			directoryResolve then return try self.parseManagedDirectoryResolve(func, methodTok: methodTok, range: range)
			socketTcpConnect then return try self.emitManagedSocketTcpConnectCall(func, methodTok: methodTok, range: range)
			socketBindListener then return try self.emitManagedSocketBindCall(func, methodTok: methodTok, range: range)
			pagesReserve then return try self.parseManagedPagesReserve(func, methodTok: methodTok, range: range)
			handleTimer then return try self.parseManagedHandleTimer(range)
			handleAdopting then return try self.parseManagedHandleAdopting(func, methodTok: methodTok, range: range)
			pinAcquire then return try self.parseManagedPinAcquire(range)
			memoryCreate then return try self.parseManagedMemoryCreate(func, typeTok: typeTok, methodTok: methodTok, range: range)
			memoryFromCString then return try self.parseManagedMemoryFromCString(func, methodTok: methodTok, range: range)
		end 'static'
	end 'emitCompilerOwnedStatic'

	function parseManagedFileExists(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitLibraryAliasedRuntimeCall(ManagedFileExistsName, args: argsOf(path), alias: FullRangeIntAliasName, range: range)
	end 'parseManagedFileExists'

	function parseManagedFileDelete(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitRuntimeCall(ManagedFileDeleteName, args: argsOf(path), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'parseManagedFileDelete'

	function parseManagedFileRename(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let oldPath = try self.parseManagedMemoryArg(func, paramName: ManagedFileOldPathParamName, methodTok: methodTok)
		try self.consume(TokenKind.comma)
		let newPath = try self.parseManagedMemoryArg(func, paramName: ManagedFileNewPathParamName, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return self.emitRuntimeCall(ManagedFileRenameName, args: twoArgs(oldPath, second: newPath), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'parseManagedFileRename'

	// ⚠ `stat` returns a RAW pointer the caller must hand back to `statFree`, so it is deliberately NOT
	// tracked: nothing in the ownership model can free a bare `int`, and the exit-101 leak gate is what
	// reports a caller that forgets.
	function parseManagedFileStat(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitLibraryAliasedRuntimeCall(ManagedFileStatName, args: argsOf(path), alias: FullRangeIntAliasName, range: range)
	end 'parseManagedFileStat'

	function parseManagedFileStatField(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let args = try self.parseTwoBuiltinIntegerArgList(func, firstParam: ManagedFileBufferParamName, secondParam: ManagedFileIndexParamName, methodTok: methodTok)
		return self.emitLibraryAliasedRuntimeCall(ManagedFileStatFieldName, args: args, alias: FullRangeIntAliasName, range: range)
	end 'parseManagedFileStatField'

	// ⚠ VOID and NON-throwing, so a bare STATEMENT is the only position it has — see the
	// `qualifiedStaticCallStmt` arm, which exists for it.
	function parseManagedFileStatFree(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let buffer = try self.parseOneBuiltinIntegerArgList(func, paramName: ManagedFileBufferParamName, methodTok: methodTok)
		return self.emitRuntimeCall(ManagedFileStatFreeName, args: argsOf(buffer), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'parseManagedFileStatFree'

	// One of the three OPENS: a single `__ManagedMemory` path, and an OWNED `__ManagedFile` box back. Its tag
	// is `structRef` over the registered `__ManagedFile` layout, which is what lets it be stored into a
	// `var file as __ManagedFile` field.
	function parseManagedFileOpen(func IrFunction, callee ByteArray, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitOwnedRuntimeResult(callee, args: argsOf(path), resultTag: ValueTypeTag.structRef, resultNameId: self.managedFileNameId(), range: range)
	end 'parseManagedFileOpen'

	// ⚠ **OWNERSHIP: the one directory static that produces an owned box.** It goes through
	// `emitOwnedRuntimeResult`, so it is tracked as an owned temporary whose drop is `__md_destruct` — the
	// RAII close (`SignatureIndex.managedNameDropCallee`).
	function parseManagedDirectoryOpenSearch(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitOwnedRuntimeResult(ManagedDirectoryOpenSearchName, args: argsOf(path), resultTag: ValueTypeTag.structRef, resultNameId: self.managedDirectoryNameId(), range: range)
	end 'parseManagedDirectoryOpenSearch'

	// ⭐ **`exists` IS `bool`, NOT `int`.** `specs/managed-directory.md:205` writes `if not
	// __ManagedDirectory.exists(…)`, so `not` has to be logical negation rather than bitwise
	// complement. The RUNTIME still answers a 0/1 i64 — this tier has no `setcc` — and it is this TAG
	// that makes the value a bool to everything above, the same arrangement `__managed_is_empty` has.
	function parseManagedDirectoryExists(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitRuntimeCall(ManagedDirectoryExistsName, args: argsOf(path), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
	end 'parseManagedDirectoryExists'

	function parseManagedDirectoryCreate(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitRuntimeCall(ManagedDirectoryCreateName, args: argsOf(path), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'parseManagedDirectoryCreate'

	// `create`'s twin, and void for its reason: the removal either happened or threw, so there is no
	// verdict left to answer with.
	function parseManagedDirectoryDelete(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitRuntimeCall(ManagedDirectoryDeleteName, args: argsOf(path), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'parseManagedDirectoryDelete'

	// The one static with NO arguments, and the one that hands back memory: an owned `__ManagedMemory`
	// the caller drops like any other array record.
	function parseManagedDirectoryCurrentPath(range SourceRange) returns ValueId throws SourceParseError
		try self.consumeEmptyArgList()
		return self.emitOwnedManagedMemoryResult(ManagedDirectoryCurrentPathName, args: ValueIdArray.create(0), range: range)
	end 'parseManagedDirectoryCurrentPath'

	function parseManagedDirectoryResolve(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let path = try self.parseOneManagedMemoryArgList(func, paramName: ManagedFilePathParamName, methodTok: methodTok)
		return self.emitOwnedManagedMemoryResult(ManagedDirectoryResolveName, args: argsOf(path), range: range)
	end 'parseManagedDirectoryResolve'

	// ⭐ **THE THREE `__ManagedDirectory` INSTANCE METHODS — `next`, `filename`, `close`.** The cursor
	// sits on the method NAME (`dispatchMethodOnReceiver` consumed the `.`).
	//
	// ⚠ **THE OP RANGE STARTS AT THE METHOD TOKEN, NOT AT THE RECEIVER, AND THAT IS THE ORACLE'S COLUMN.**
	// `specs/managed-directory.md`'s `next-without-try` pins the E3057 at column 10 of `_ = dir.next()`,
	// which is `next` — the receiver is column 6. It is also what `dispatchWitnessMethod` already does
	// ("`methodTok` being this call's own anchor"), so this is the house convention rather than a divergence
	// from it; the file and array dispatchers anchor at the receiver instead, and no committed case pins
	// either of those.
	//
	// An unknown method is refused by name here rather than mangled into a callee no file declares.
	function dispatchManagedDirectoryMethod(recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(methodTok, last: methodTok)

		if methodTok.value.equals(ManagedDirectoryNextMethod) 'next'
			try self.consumeEmptyArgList()
			return self.emitLibraryAliasedRuntimeCall(ManagedDirectoryNextName, args: argsOf(recv.value), alias: FullRangeIntAliasName, range: range)
		end 'next'

		// A FRESH owned `__ManagedMemory` copy of the current entry's name — see
		// `ManagedDirectoryRuntime.emitCStringToManaged` for why it copies rather than handing back a
		// pointer into the find block.
		if methodTok.value.equals(ManagedDirectoryFilenameMethod) 'filename'
			try self.consumeEmptyArgList()
			return self.emitOwnedManagedMemoryResult(ManagedDirectoryFilenameName, args: argsOf(recv.value), range: range)
		end 'filename'

		if methodTok.value.equals(ManagedDirectoryCloseMethod) 'close'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(ManagedDirectoryCloseName, args: argsOf(recv.value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'close'

		throw SourceParseError.unsupported("`{String.from(ManagedDirectoryTypeName)}` method '{String.from(methodTok.value)}' — the type has exactly these three: `next()`, `filename()` and `close()`", line: methodTok.line, column: methodTok.column)
	end 'dispatchManagedDirectoryMethod'

	// ⭐ **THE `__ManagedSocket` INSTANCE METHODS — the transfers, the deadlines, the close, and the server
	// side's two.** The cursor sits on the method NAME (`dispatchMethodOnReceiver` consumed the `.`).
	//
	// ⚠ The buffer is BORROWED by all three, not consumed: `__ms_send_from` reads out of it and `__ms_recv`
	// writes into it, and neither takes ownership — which is what lets the caller keep using it afterwards,
	// exactly as `__mf_read`/`__mf_write` do one family over.
	//
	// An unknown method is refused by name here rather than mangled into a callee no file declares.
	function dispatchManagedSocketMethod(func IrFunction, recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(recv.anchor, last: methodTok)

		// ⚠ **THREE ARGUMENTS, AND THE SECOND AND THIRD LABELS ARE OPTIONAL** — the `__ManagedMemory` surface's
		// rule (`consumeArrayArgLabel`, whose header carries the measurement), and the spelling the corpus
		// uses: `stdlib/TcpClient.maxon:43` writes all three positionally.
		if methodTok.value.equals(ManagedSocketSendFromMethod) 'sendFrom'
			try self.consume(TokenKind.leftParen)
			let buffer = try self.parseManagedMemoryArg(func, paramName: ManagedFileManagedParamName, methodTok: methodTok)
			try self.consumeArrayArgLabel(ManagedMemoryOffsetParamName, required: false)
			let offset = try self.parseBuiltinIntegerArg(func, paramName: ManagedMemoryOffsetParamName, methodTok: methodTok)
			try self.consumeArrayArgLabel(ManagedSocketLengthParamName, required: false)
			let length = try self.parseBuiltinIntegerArg(func, paramName: ManagedSocketLengthParamName, methodTok: methodTok)
			try self.consume(TokenKind.rightParen)
			return self.emitLibraryAliasedRuntimeCall(ManagedSocketSendFromName, args: fourArgs(recv.value, second: buffer, third: offset, fourth: length), alias: BytePosAliasName, range: range)
		end 'sendFrom'

		if methodTok.value.equals(ManagedSocketRecvMethod) 'recv'
			try self.consume(TokenKind.leftParen)
			let buffer = try self.parseManagedMemoryFillArg(func, paramName: ManagedFileManagedParamName, methodTok: methodTok)
			try self.consume(TokenKind.rightParen)
			return self.emitLibraryAliasedRuntimeCall(ManagedSocketRecvName, args: twoArgs(recv.value, second: buffer), alias: BytePosAliasName, range: range)
		end 'recv'

		if methodTok.value.equals(ManagedSocketCloseMethod) 'close'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(ManagedSocketCloseName, args: argsOf(recv.value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'close'

		if methodTok.value.equals(ManagedSocketShutdownWriteMethod) 'shutdownWrite'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(ManagedSocketShutdownWriteName, args: argsOf(recv.value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'shutdownWrite'

		// ⭐ **THE TWO DEADLINE SETTERS TAKE ONE UNLABELLED MILLISECOND COUNT**, which is the shape every
		// single-argument builtin method on this surface has; `0` clears the deadline.
		if methodTok.value.equals(ManagedSocketSetReadDeadlineMethod) 'setReadDeadline'
			return try self.emitManagedSocketDeadlineCall(func, recv: recv, methodTok: methodTok, callee: ManagedSocketSetReadDeadlineName, range: range)
		end 'setReadDeadline'

		if methodTok.value.equals(ManagedSocketSetWriteDeadlineMethod) 'setWriteDeadline'
			return try self.emitManagedSocketDeadlineCall(func, recv: recv, methodTok: methodTok, callee: ManagedSocketSetWriteDeadlineName, range: range)
		end 'setWriteDeadline'

		// ⭐ **A PREDICATE, TAGGED `boolean` AND NOT `integer`** — `BuiltinsStdoutWantsAnsiColorName`'s rule:
		// a question whose answer is yes-or-no must not arrive as a number.
		if methodTok.value.equals(ManagedSocketTimedOutMethod) 'timedOut'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(ManagedSocketTimedOutName, args: argsOf(recv.value), resultTag: ValueTypeTag.boolean, resultNameId: UnnamedTypeId, range: range)
		end 'timedOut'

		// ⭐ **THE SERVER SIDE's TWO.** `boundPort()` reports the port a `bindListener` of 0 was given, and
		// `accept()` answers an OWNED socket of its own — the peer half, which CAN transfer. Both are refused
		// at runtime on a socket that never listened, which is a state `stdlib/TcpListener.maxon` makes
		// unwritable.
		if methodTok.value.equals(ManagedSocketBoundPortMethod) 'boundPort'
			try self.consumeEmptyArgList()
			return self.emitLibraryAliasedRuntimeCall(ManagedListenerPortName, args: argsOf(recv.value), alias: NetworkPortAliasName, range: range)
		end 'boundPort'

		if methodTok.value.equals(ManagedSocketAcceptMethod) 'accept'
			try self.consumeEmptyArgList()
			return self.emitOwnedRuntimeResult(ManagedListenerAcceptName, args: argsOf(recv.value), resultTag: ValueTypeTag.structRef, resultNameId: self.managedSocketNameId(), range: range)
		end 'accept'

		throw SourceParseError.unsupported("`{String.from(ManagedSocketTypeName)}` method '{String.from(methodTok.value)}' — the type has exactly these nine: `sendFrom()`, `recv()`, `close()`, `shutdownWrite()`, `setReadDeadline()`, `setWriteDeadline()`, `timedOut()`, `boundPort()` and `accept()`", line: methodTok.line, column: methodTok.column)
	end 'dispatchManagedSocketMethod'

	// One reader of the `(host, port:)` endpoint for both statics: two copies of an argument list is how one
	// of them would quietly acquire a different label rule. Both produce an OWNED box whose
	// drop is `__ms_destruct` — the RAII close (`SignatureIndex.managedNameDropCallee`).
	function parseManagedSocketEndpointArgs(func IrFunction, methodTok Token) returns (ValueId, ValueId) throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let host = try self.parseManagedMemoryArg(func, paramName: ManagedSocketHostParamName, methodTok: methodTok)
		try self.consumeArrayArgLabel(ManagedSocketPortParamName, required: false)
		let port = try self.parseBuiltinIntegerArg(func, paramName: ManagedSocketPortParamName, methodTok: methodTok)
		return (host, port)
	end 'parseManagedSocketEndpointArgs'

	// ⭐ **`bindListener(host, port: p)` — THE SERVER SIDE's ONLY STATIC.** It BINDS and LISTENS in one
	// call and answers a socket that can do neither `sendFrom` nor `recv`; `stdlib/TcpListener.maxon` is
	// the wrapper that states that in the type system, and its header carries why the box is this type.
	function emitManagedSocketBindCall(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let endpoint = try self.parseManagedSocketEndpointArgs(func, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)

		return self.emitOwnedRuntimeResult(ManagedListenerBindName, args: twoArgs(endpoint.0, second: endpoint.1), resultTag: ValueTypeTag.structRef, resultNameId: self.managedSocketNameId(), range: range)
	end 'emitManagedSocketBindCall'

