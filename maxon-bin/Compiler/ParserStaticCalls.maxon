	function parseDestructStatement() throws SourceParseError
		let destructTok = self.current()
		self.advance()
		let selfTok = try self.consume(TokenKind.self)

		if not self.statementEndsAt(self.pos) 'moreFollows'
			let strayTok = self.current()
			throw SourceParseError.unexpectedToken(TokenKind.newline.rawValue, got: tokenDisplayText(strayTok), line: strayTok.line, column: strayTok.column)
		end 'moreFollows'

		if not self.bodyState.consumesSelf 'notAFinalizer'
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "`destruct self` is written in a method that takes `consuming self`: only a finalizer ends the life of the value it is called on", line: destructTok.line, column: destructTok.column)
		end 'notAFinalizer'

		let held = (self.bodyState.scope.getInfo(SelfParamName)).boundValue
		try self.requireNotMovedSinceItWasRead(held, range: SourceRange.ofToken(selfTok))

		if not self.hasLiveOwner(held) 'noOwnerToEnd'
			throw self.regionRefusal(ErrorCode.semanticLinearRefused, message: "`destruct self` ends the life of a record this method owns, and this receiver is not one: declare finalizers on a `type` that holds fields", line: destructTok.line, column: destructTok.column)
		end 'noOwnerToEnd'

		self.emitDecrefOps(held, range: SourceRange.between(destructTok, last: selfTok))
		self.poisonMoveSource(held)
	end 'parseDestructStatement'

	function namesReplyLater(typeTok Token) returns bool
		return typeTok.value.equals(ReplyLaterBaseName) and self.kindAt(self.pos) == TokenKind.dot and self.tokenAt(self.pos + 1).value.equals(ReplyLaterMemberName) and self.kindAt(self.pos + 2) == TokenKind.leftParen
	end 'namesReplyLater'

	function replyLaterIsAWholeLetInitializer(baseIndex ElementIndex) returns bool
		return baseIndex >= ReplyLaterInitializerTokens and self.kindAt(baseIndex - 1) == TokenKind.equals and self.kindAt(baseIndex - 2) == TokenKind.identifier and self.kindAt(baseIndex - 3) == TokenKind.let and tokenKindEndsALine(self.kindAt(baseIndex - 4))
	end 'replyLaterIsAWholeLetInitializer'

	function replyDeferrerThrowsReplyStopped(func IrFunction) returns bool
		let clause = self.signatures.throwsOf(func.name)

		if not throwsClauseIsThrowing(clause) 'throwsNothing'
			return false
		end 'throwsNothing'

		let name = try throwsClauseName(clause) otherwise panic("replyDeferrerThrowsReplyStopped: a clause `throwsClauseIsThrowing` accepted carries a name")
		return name.toByteArray().equals(ReplyStoppedTypeName)
	end 'replyDeferrerThrowsReplyStopped'

	function requireReplyLaterShape(func IrFunction, replyTok Token, baseIndex ElementIndex) throws SourceParseError
		if not self.signatures.declaresCallee(func.name) 'notADeclaredBody'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "`reply.later()` is written in the body of a message, not in a closure or a default value", line: replyTok.line, column: replyTok.column)
		end 'notADeclaredBody'

		if self.bodyState.statementNesting != 1 'nested'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "`reply.later()` is a statement of the message's own body, not of an `if`, a loop, a `match`, a `try` or any other block inside it", line: replyTok.line, column: replyTok.column)
		end 'nested'

		if not self.replyLaterIsAWholeLetInitializer(baseIndex) 'notALet'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "`reply.later()` is the whole initializer of a `let`: `let pending = reply.later()`", line: replyTok.line, column: replyTok.column)
		end 'notALet'

		if self.bodyState.replyDeferred 'twice'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "a message defers its reply once: the second `reply.later()` has no reply left to take", line: replyTok.line, column: replyTok.column)
		end 'twice'

		if maxonReturnTypeIsVoid(func.maxonReturnType) 'noReply'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "a message with no `returns` clause has no reply to defer: give it one, or send the answer another way", line: replyTok.line, column: replyTok.column)
		end 'noReply'

		if maxonReturnTypeTag(func.maxonReturnType) == ValueTypeTag.interfaceRef 'aFatPointer'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "a message that returns an interface value cannot defer its reply: a Reply carries one machine word", line: replyTok.line, column: replyTok.column)
		end 'aFatPointer'

		if not self.replyDeferrerThrowsReplyStopped(func) 'noStoppedClause'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "a message that defers its reply declares `throws ReplyStopped`: the caller's `await` receives it when the Reply is dropped unanswered", line: replyTok.line, column: replyTok.column)
		end 'noStoppedClause'

		let owner = try self.enclosingType.typeName() otherwise throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "`reply.later()` is written in a method of a service type", line: replyTok.line, column: replyTok.column)

		if self.signatures.structDeclaresTypeParams(owner) 'aGenericService'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "`reply.later()` is not written in a generic service: a Reply is typed by the message's reply type, which a generic body does not fix", line: replyTok.line, column: replyTok.column)
		end 'aGenericService'
	end 'requireReplyLaterShape'

	function parseReplyLater(func IrFunction, replyTok Token, baseIndex ElementIndex) returns ValueId throws SourceParseError
		try self.requireReplyLaterShape(func, replyTok: replyTok, baseIndex: baseIndex)
		try self.consume(TokenKind.dot)
		try self.consume(TokenKind.identifier)
		try self.consume(TokenKind.leftParen)
		let rparenTok = try self.consume(TokenKind.rightParen)

		if not self.statementEndsAt(self.pos) 'moreFollows'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "`reply.later()` is the whole initializer of a `let`: nothing follows it", line: replyTok.line, column: replyTok.column)
		end 'moreFollows'

		self.bodyState.replyDeferred = true
		let instance = self.signatures.internReplyInstanceForMessage(func.name)

		return self.emitOwnedRuntimeResult(GtReplyLaterName, args: ValueIdArray.create(0), resultTag: ValueTypeTag.genericInstance, resultNameId: instance as TypeNameId, range: SourceRange.between(replyTok, last: rparenTok))
	end 'parseReplyLater'

	function deferredReturnPlaceholder(returnType MaxonReturnType, anchor Token) returns ValueId
		let range = SourceRange.ofToken(anchor)
		let word = self.emitLiteral(0, valueType: MaxonType.integer, range: range)

		return match returnType 'declared'
			void panic("deferredReturnPlaceholder: `reply.later()` is refused in a message with no `returns` clause")
			value(declared) gives self.emitRetaggedCastValue(word, targetType: declared, range: range)
		end 'declared'
	end 'deferredReturnPlaceholder'

	function dispatchReplyMethod(func IrFunction, recv MethodReceiver, resultUsed bool) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)

		if not methodTok.value.equals(ReplyAnswerMethodName) 'notAnswer'
			throw SourceParseError.unsupported("`Reply` method '{String.from(methodTok.value)}' — the type has exactly one: `answer(value)`", line: methodTok.line, column: methodTok.column)
		end 'notAnswer'

		if resultUsed 'noValue'
			throw SourceParseError.unsupported("`Reply.answer` returns nothing, so its result cannot be used", line: methodTok.line, column: methodTok.column)
		end 'noValue'

		try self.consume(TokenKind.leftParen)
		let valueStart = self.pos
		let value = try self.parseExpression(func, block: self.bodyState.currentBlock)
		let rparenTok = try self.consume(TokenKind.rightParen)
		let range = SourceRange.between(methodTok, last: rparenTok)

		let element = self.resolvedSlotType(self.signatures.replyElementOf(self.valueInstanceId(recv.value)))
		try self.requireReplyAnswerAgrees(value, element: element, anchor: self.tokenAt(valueStart))

		let answered = try self.handOff(SoleHandedOffPosition, value: value, door: ThreadHandOffDoor.message("the value answered to this Reply", argumentOf: "the Reply it answers"), anchor: self.tokenAt(valueStart))
		let reply = try self.takeReplyToAnswer(recv)

		return self.emitRuntimeCall(GtReplyAnswerName, args: twoArgs(reply, second: answered), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'dispatchReplyMethod'

	function takeReplyToAnswer(recv MethodReceiver) returns ValueId throws SourceParseError
		if not tokenCanBeAName(recv.anchor) or not self.bodyState.scope.contains(recv.anchor.value) 'notABinding'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "a Reply is answered through the local or parameter that holds it: bind it first (`let pending = try self.waiting.pop() otherwise return`), then `pending.answer(value)`", line: recv.anchor.line, column: recv.anchor.column)
		end 'notABinding'

		let binding = self.bodyState.scope.getInfo(recv.anchor.value)

		if binding.isSelfField 'aField'
			throw self.regionRefusal(ErrorCode.semanticReplyDeferralRefused, message: "a Reply is answered through the local or parameter that holds it, not through a field of the state: take it out of the field first (`let pending = try self.waiting.pop() otherwise return`)", line: recv.anchor.line, column: recv.anchor.column)
		end 'aField'

		let held = binding.boundValue

		if self.argumentMovesOut(held) 'thisFramesToGive'
			self.moveOwnedValueOut(held)
			return held
		end 'thisFramesToGive'

		let referenced = self.transferConsumedArg(held, anchor: recv.anchor)
		self.poisonMoveSource(held)

		return referenced
	end 'takeReplyToAnswer'

	function requireReplyAnswerAgrees(value ValueId, element MaxonType, anchor Token) throws SourceParseError
		let elementTag = maxonTypeTag(element)
		let elementNameId = typeNameIdOf(element)
		let gotTag = self.tagOf(value)

		match self.declaredSlotVerdict(gotTag, gotNameId: self.valueNameId(value), declared: elementTag, declaredNameId: elementNameId) 'verdict'
			ok then break
			mismatch or
			narrowsFloatToInt or
			functionIntoNonFunction then throw SourceParseError.typeMismatchExpectedGot(maxonTypeName(element, typeNames: self.artifact.typeNames), got: self.valueDisplayTypeName(value), line: anchor.line, column: anchor.column, expectedNote: "", crossesRange: false)
		end 'verdict'

		let expectedName = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: elementTag, nameId: elementNameId, readerFilePath: self.job.path)
		let gotName = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: gotTag, nameId: self.valueNameId(value), readerFilePath: self.job.path)

		if self.signatures.aggregatesConflict(expectedName, expectedTag: elementTag, expectedNameId: elementNameId, expectedBrand: EmptySourceText, got: gotName, gotTag: gotTag, gotNameId: self.valueNameId(value), gotBrand: self.brandOf(value), readerFilePath: self.job.path) 'aggregatesDiffer'
			throw SourceParseError.typeMismatchExpectedGot(maxonTypeName(element, typeNames: self.artifact.typeNames), got: self.valueDisplayTypeName(value), line: anchor.line, column: anchor.column, expectedNote: "", crossesRange: false)
		end 'aggregatesDiffer'
	end 'requireReplyAnswerAgrees'

