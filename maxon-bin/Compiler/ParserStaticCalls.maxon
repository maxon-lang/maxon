	function emitManagedSocketTcpConnectCall(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let endpoint = try self.parseManagedSocketEndpointArgs(func, methodTok: methodTok)
		let deadline = try self.parseManagedSocketConnectDeadline(func, methodTok: methodTok, range: range)
		try self.consume(TokenKind.rightParen)

		return self.emitOwnedRuntimeResult(ManagedSocketTcpConnectName, args: threeArgs(endpoint.0, second: endpoint.1, third: deadline), resultTag: ValueTypeTag.structRef, resultNameId: self.managedSocketNameId(), range: range)
	end 'emitManagedSocketTcpConnectCall'

	function parseManagedSocketConnectDeadline(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		if self.at(TokenKind.rightParen) 'noDeadlineGiven'
			return self.emitLiteral(ManagedSocketNoDeadlineMs, valueType: MaxonType.integer, range: range)
		end 'noDeadlineGiven'

		try self.consumeArrayArgLabel(ManagedSocketDeadlineParamName, required: false)
		return try self.parseBuiltinIntegerArg(func, paramName: ManagedSocketDeadlineParamName, methodTok: methodTok)
	end 'parseManagedSocketConnectDeadline'

	// One body for both deadline setters: they differ only in the callee, and two copies of an argument list is
	// how one of them would quietly acquire a different label rule.
	function emitManagedSocketDeadlineCall(func IrFunction, recv MethodReceiver, methodTok Token, callee ByteArray, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let milliseconds = try self.parseBuiltinIntegerArg(func, paramName: ManagedSocketDeadlineParamName, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return self.emitRuntimeCall(callee, args: twoArgs(recv.value, second: milliseconds), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitManagedSocketDeadlineCall'

	// ⭐ **AN OWNED `__ManagedMemory` OUT OF A RUNTIME CALL — the shape `filename()`, `currentPath()`
	// and `__Builtins.commandLineArg(i)` share.** Three facts have to travel together and each of them is a
	// silent wrong answer on its own: the value is an OWNED heap record (so its scope exit must drop it), it
	// is a byte-PACKED `Array` instance (so `String.init` accepts it and reads it at stride 1), and it is a
	// BUFFER SURFACE (so `.length()`/`.byteAt()` reach the `__ManagedMemory` members rather than the `Array`
	// ones — `valueIsBufferSurface`, the provenance mark that tells the two surfaces of one record apart).
	// `__ManagedMemory.create` states the same three at its own site; this is the second producer, so they
	// are stated once.
	//
	// ⚠⚠ **THE INSTANCE IS THE COMPILER'S OWN (`internSynthesizedByteInstance`), NOT `Array with Byte`, AND
	// THAT IS A MEASURED FIX RATHER THAN A PREFERENCE.** These buffers are `mm_alloc`'d runs of bytes that no
	// source line describes, so their stride cannot be a function of whether the PROGRAM happens to declare
	// `typealias Byte = int(0 to 1000)`. With `internArrayByteInstance()` here, a user's wide `Byte` made
	// `String.init(managed)` inside `stdlib/CommandLine.maxon` fail with `E3005 … expected
	// '__ManagedMemory', got 'Array_Byte'` — in a program that never mentions `CommandLine`, because a
	// stdlib module is parsed by every program. `SynthesizedByteElementName` carries the full argument
	// and the two occasions this exact defect has been measured on.
	//
	// ⛔ **AND SCOPING IT TO A *FILE* IS NOT THE WEAKER FORM OF THE SAME CURE — IT IS A SILENT WRONG ANSWER.**
	// All three producers build their record through
	// `ManagedDirectoryRuntime.emitCStringToManaged`, which stamps `element_size@24` from the LITERAL
	// `ByteStringElementSize` (`:334`), so the record's stride is 1 whoever is parsing. There is therefore
	// nothing here for a file to decide: `internArrayByteInstance(self.job.path)` would answer the parsing
	// file's `Byte`, and `specs/managed-directory.md` writes `dir.filename()` in USER programs — so a user
	// declaring `typealias Byte = int(0 to 1000)` would get a static type striding 2 over a record stamped 1,
	// with no diagnostic. A per-file element makes the two `Array with Byte` honest about each other; it
	// cannot make either of them honest about a record neither describes.
	function emitOwnedManagedMemoryResult(callee ByteArray, args ValueIdArray, range SourceRange) returns ValueId
		let result = self.emitOwnedRuntimeResult(callee, args: args, resultTag: ValueTypeTag.genericInstance, resultNameId: self.signatures.internSynthesizedByteInstance() as TypeNameId, range: range)
		self.markBufferSurface(result, origin: EmptySourceText)
		self.markFresh(result)
		return result
	end 'emitOwnedManagedMemoryResult'

	// `(<path>)` — the one-`__ManagedMemory`-argument list six of the nine statics share.
	function parseOneManagedMemoryArgList(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let value = try self.parseManagedMemoryArg(func, paramName: paramName, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return value
	end 'parseOneManagedMemoryArgList'

	// ⭐ **ONE `__ManagedMemory` ARGUMENT, CHECKED AGAINST THE PARAMETER IT FILLS.**
	//
	// ⚠ **THE ANCHOR IS THE METHOD-NAME TOKEN, NOT THE ARGUMENT, AND THAT IS THE ORACLE'S COLUMN.**
	// `builtin-type-checking.error-managed-file-open-read-int` pins `3:29`, which is where `openRead` starts,
	// not where the `0` is — and it is the right choice rather than a quirk to match: a mismatch is a fact
	// about the CALL, and `SemanticCheck.checkArgTypes` positions every ordinary argument mismatch on the
	// call range for the same reason.
	function parseManagedMemoryArg(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		let value = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.requireManagedMemoryValue(value, paramName: paramName, anchor: methodTok)
		return value
	end 'parseManagedMemoryArg'

	function parseManagedMemoryFillArg(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		let valueTok = self.current()
		let valueStart = self.pos
		let value = try self.parseManagedMemoryArg(func, paramName: paramName, methodTok: methodTok)

		self.noteArgumentWrite(func, written: value, blame: self.expressionImmutableBlame(valueTok, valueStart: valueStart), placeStart: valueStart, placeEnd: self.pos, calleeTok: methodTok)

		return value
	end 'parseManagedMemoryFillArg'

	// One `int` argument of a signature-checked builtin — `size`, `count`, `elementSize`, a stat buffer's
	// address, a stat field index, a byte offset, a byte value. Same anchor rule as its `__ManagedMemory`
	// sibling above, and the same sentence.
	// ⚠⚠ **THE DOMAIN TEST IS `tagIsIntegral`, NOT `== ValueTypeTag.integer`, AND THE NARROW SPELLING IS A
	// FALSE REFUSAL.** A value whose static type is a RANGED ALIAS carries the
	// `named` tag until TypeResolution collapses it — `columnValueTagMatches`'s measured reason — so the narrow
	// test refused every argument spelled with one. MEASURED on `stdlib/helpers/string/utf8.maxon:102`, whose
	// `s.byteAt(pos)` has `pos BytePos`: `E3005 argument type mismatch for 'index': expected 'int', got 'int'`,
	// a refusal that names one type twice because both spellings render to `int` and only the TAG differs.
	// The fact belongs at the shared argument parser, where all six builtin doors read it.
	function parseBuiltinIntegerArg(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		let value = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if not tagIsIntegral(self.numberTagOf(value)) 'notInteger'
			throw SourceParseError.builtinArgumentType(String.from(paramName), expected: typeTagName(ValueTypeTag.integer), got: self.valueDisplayTypeName(value), line: methodTok.line, column: methodTok.column, expectedNote: "", crossesRange: false)
		end 'notInteger'

		return value
	end 'parseBuiltinIntegerArg'

	// `(<n>)` — the one-`int`-argument list `statFree` and `setLength` share. The `__ManagedMemory` sibling's
	// `parseOneManagedMemoryArgList`, for its reason.
	function parseOneBuiltinIntegerArgList(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let value = try self.parseBuiltinIntegerArg(func, paramName: paramName, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return value
	end 'parseOneBuiltinIntegerArgList'

	// ⭐ **ONE `cstring` ARGUMENT — `__ManagedMemory.fromCString`'s, and the buffer surface's only one.** Its
	// own door rather than the integer one above because the test is EXACT: an integer is a width the callee
	// would `strlen`, which is the confusion `ValueTypeTag.cstring` was minted to end. The anchor is the
	// method-name token, which is `parseManagedMemoryArg`'s rule and the oracle's column.
	function parseBuiltinCStringArg(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		let value = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if self.tagOf(value) != ValueTypeTag.cstring 'notACString'
			throw SourceParseError.builtinArgumentType(String.from(paramName), expected: typeTagName(ValueTypeTag.cstring), got: self.valueDisplayTypeName(value), line: methodTok.line, column: methodTok.column, expectedNote: "", crossesRange: false)
		end 'notACString'

		return value
	end 'parseBuiltinCStringArg'

	// `(<cstr>)` — the one-`cstring`-argument list. `parseOneBuiltinIntegerArgList`'s shape, one type over.
	function parseOneBuiltinCStringArgList(func IrFunction, paramName ByteArray, methodTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let value = try self.parseBuiltinCStringArg(func, paramName: paramName, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return value
	end 'parseOneBuiltinCStringArgList'

	// ⭐ **`(<a>, <b>)` — THE TWO-`int` ARGUMENT LIST, ONE HOME, THREE CALLERS** (`statField`,
	// `__ManagedMemory.create`, `setByte`). It returns the argument ARRAY rather than the two values, because
	// that is what all three callers then hand to `emitRuntimeCall`.
	//
	// ⚠ **THE PAREN/COMMA PROTOCOL IS THE FACT WORTH SINGLE-HOMING, not the two calls it brackets.** These
	// builtins take their second argument POSITIONALLY (`statField(buf, 3)`), which every other call in the
	// language may not — E2053 requires `name: value` past the first — and that exemption is the oracle's
	// spelling (`stdlib/File.maxon:178-184`), not a shortcut. Written out per site it would be three places to
	// change if it ever stopped being an exemption, and a site missed would go on ACCEPTING the old spelling:
	// a wrong acceptance, not a compile error.
	//
	// ⭐ **THE LABEL IS ALSO PERMITTED, AND CHECKED WHEN WRITTEN** — the exemption is that a label is not
	// REQUIRED, never that it is refused. Both spellings are in the canonical corpus for the same member:
	// `specs/managed-memory-builtin.md` writes `create(4, elementSize: 8)` and `setByte(0, value: 11)` while
	// `specs/managed-memory-methods.md` and `stdlib/File.maxon:71` write both positionally. The rule and its
	// diagnostic are `consumeArrayArgLabel`'s, so the two-argument members of the buffer surface — whether they
	// arrive as a static here or as a method arm — answer a wrong label identically.
	function parseTwoBuiltinIntegerArgList(func IrFunction, firstParam ByteArray, secondParam ByteArray, methodTok Token) returns ValueIdArray throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let first = try self.parseBuiltinIntegerArg(func, paramName: firstParam, methodTok: methodTok)
		try self.consumeArrayArgLabel(secondParam, required: false)
		let second = try self.parseBuiltinIntegerArg(func, paramName: secondParam, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return twoArgs(first, second: second)
	end 'parseTwoBuiltinIntegerArgList'

	// ⭐⭐⭐ **`String.from(bytes)` AND `String.init(managed)` ARE THE CORPUS'S, NOT SYNTHESIZED MEMBERS.**
	// `stdlib/String.maxon:114,119-121` declares both, and the corpus bodies reach the runtime graph through
	// `emitFusedWrapperLiteral` — a `String{managed: …, singleByteGraphemesFlag: …}` literal lowers to
	// `__str_of_buffer`, which is `__str_from_bytes` with the classification supplied rather than scanned.
	// `emitFusedWrapperLiteral` COPIES its buffer, so neither call adopts its argument.
	//
	// ⚠ **THEIR ARGUMENT RULE IS A DECLARED PARAMETER'S, NOT THE STRIDE RULE BELOW.** A declared parameter asks
	// `ProgramSignatures.aggregatesConflict`, which is NOMINAL over the container — deliberately, because a
	// parameter hands the container over and the callee may push into it. The two rules disagree on exactly one
	// shape: an array whose byte element the author named something other than `Byte`. See
	// `specs/string-views.md`'s `a-user-ranged-alias-element-keeps-its-name` for the program, which
	// proves its element survives through the buffer surface rather than through this door.

	// ⭐⭐ **`fromCString(cstr)` — A NUL-TERMINATED POINTER BACK INTO AN OWNED BUFFER**, `toCString()`'s
	// dual and the surface's second static. The whole emit is one runtime call: `__mm_from_cstring` walks
	// the pointer with a `strlen` and blits it into a fresh byte-element `Array` record, which is the
	// builder `__md_filename` and `__cl_arg` have used rather than a second copy of the loop.
	//
	// ⚠ **THE RESULT IS OWNED AND IT IS A BYTE BUFFER, so it takes the SAME door `filename()` does**
	// (`emitOwnedManagedMemoryResult`): the record is freshly allocated, nothing else will ever drop it,
	// and its element is a byte — the synthesized byte instance, not `create`'s element-size-chosen one,
	// because a `cstring` IS a byte pointer and no width argument exists to choose from.
	//
	// ⚠ **THE ARGUMENT IS CHECKED AS A `cstring` AND AN INTEGER IS REFUSED.** This door is the reason the
	// tag exists said the other way round: an address the parser cannot tell from a byte count is one
	// `strlen` away from walking whatever follows it in memory.
	function parseManagedMemoryFromCString(func IrFunction, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let cstr = try self.parseOneBuiltinCStringArgList(func, paramName: ManagedMemoryCStringParamName, methodTok: methodTok)
		return self.emitOwnedManagedMemoryResult(MmFromCStringName, args: argsOf(cstr), range: range)
	end 'parseManagedMemoryFromCString'

	// ⭐ **`__ManagedMemory.create(count, elementSize)` — THE BUFFER'S CONSTRUCTOR.** It yields an OWNED
	// `Array` record, so its scope-exit drop routes through `__managed_decref` (which frees the record AND its
	// element buffer) exactly as a `.create()`d array's does, and the value is MARKED as the buffer surface
	// (`markBufferSurface`) so its members are reachable through it — the one thing that makes it more than an
	// array to the code that follows.
	//
	// ⚠ **`elementSize` IS BOTH A RUNTIME ARGUMENT AND A COMPILE-TIME DECISION, AND IT HAS TO BE BOTH.** The
	// runtime stores it into `element_size@24` (the stride every accessor moves by); the FRONT END additionally
	// picks the result's `Array` instance from it (`managedMemoryInstanceForElementSize`), because `get`/`set`
	// are typed off the element and nothing later can recover a type from a register.
	function parseManagedMemoryCreate(func IrFunction, typeTok Token, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		let elementSizeStart = self.pos
		let args = try self.parseTwoBuiltinIntegerArgList(func, firstParam: ManagedMemoryCountParamName, secondParam: ManagedMemoryElementSizeParamName, methodTok: methodTok)
		let count = try args.get(0) otherwise panic("parseManagedMemoryCreate: the two-int arg list returned fewer than two values")
		let elementSize = try args.get(1) otherwise panic("parseManagedMemoryCreate: the two-int arg list returned fewer than two values")
		let instance = try self.managedMemoryCreateInstance(typeTok, elementSize: elementSize, argStart: elementSizeStart)

		// The program states a stride; a signed narrow instance is created with its stamp instead, so its
		// record carries the signed-slot flag.
		let signedNarrowInstance = self.signatures.arrayElementStamp(instance) as FullRangeInt != self.constOf(elementSize) and self.signatures.arrayElementSize(instance) as FullRangeInt == self.constOf(elementSize)
		let createArgs = twoArgs(count, second: self.emitInstanceElementSize(instance, range: range)) if signedNarrowInstance else args
		let created = self.emitOwnedRuntimeResult(ManagedMemCreateName, args: createArgs, resultTag: ValueTypeTag.genericInstance, resultNameId: (instance as TypeNameId), range: range)
		self.markBufferSurface(created, origin: EmptySourceText)
		self.markFresh(created)
		return created
	end 'parseManagedMemoryCreate'

	function managedMemoryCreateInstance(typeTok Token, elementSize ValueId, argStart ElementIndex) returns GenericInstanceId throws SourceParseError
		let named = try self.requireManagedMemoryElementSize(elementSize, argStart: argStart)

		if typeTok.value.equals(ManagedMemoryTypeName) or self.constOf(elementSize) == ByteStringElementSize 'theSizeNamesTheInstance'
			return named
		end 'theSizeNamesTheInstance'

		let receiver = self.signatures.genericAliasInstanceFrom(self.genericAliasKeyFor(typeTok.value), readerFilePath: self.job.path)

		let stride = self.signatures.arrayElementSize(receiver) as FullRangeInt

		if stride != self.constOf(elementSize) 'theStrideDisagrees'
			throw SourceParseError.unsupported("`{String.from(typeTok.value)}.{String.from(ManagedMemoryCreateMethod)}`'s `{String.from(ManagedMemoryElementSizeParamName)}` is {self.constOf(elementSize)}, and the buffer's element strides {stride}: the record would be stamped with one width and read at the other", line: self.tokenAt(argStart).line, column: self.tokenAt(argStart).column)
		end 'theStrideDisagrees'

		return receiver
	end 'managedMemoryCreateInstance'

	// ⭐⭐ **THE `Array` INSTANCE A `create`'s `elementSize` NAMES — AND WHY THE ARGUMENT MUST BE A COMPILE-TIME
	// CONSTANT.** `mm.get(0)` and `mm.set(0, value: 300)` are typed off the instance's ELEMENT, so the front end
	// has to know the element size at the call; a size that only exists in a register would leave `get` with no
	// type to give back and `set` with no range to check `300` against.
	//
	// ⚠ The element size must be a compile-time CONSTANT. Passing it through as a real runtime SSA
	// value would need `__ManagedMemory` to be a generic with an `Element` parameter a substitution
	// pass binds — machinery this compiler does not have and does not need, since every call site in
	// `/specs` and in `stdlib/` writes a literal.
	// ⚠ A non-positive size is REFUSED cleanly here rather than left to crash a later lowering. A
	// crash is not a diagnostic.
	//
	// ⚠ **A NON-POSITIVE SIZE IS NOT REFUSED HERE, and `managedMemoryInstanceForElementSize` states why**: the
	// corpus pins `create(4, 0)` as a CAUGHT `invalidAllocation` throw from the runtime, so a parse-time refusal
	// would turn a case about error handling into a compile error.
	//
	// The constant comes from the parser's own fold (`constIsKnown`), so `let W = 8` then `create(n, W)` is
	// admitted — a `let`'s use IS its literal in the compiler — while a parameter or a computed size is refused by name.
	//
	// ⚠⚠ **AND A CONSTANT IS NOT ENOUGH: IT MUST BE A WIDTH the compiler HAS AN ELEMENT TYPE FOR.**
	// Knowing the size at the call buys nothing if the instance chosen for it then STRIDES differently from
	// the type `get`/`set` are checked against — measured on `create(4, elementSize: 4)`, which took the
	// machine-word instance, accepted `set(0, value: 5000000000)` against `int`'s range and read back
	// 705032704. `managedMemoryElementSizeIsTypeable` owns that set; this is the door that reports it.
	function requireManagedMemoryElementSize(elementSize ValueId, argStart ElementIndex) returns GenericInstanceId throws SourceParseError
		if not self.constIsKnown(elementSize) 'notAConstant'
			throw SourceParseError.unsupported("`{String.from(ManagedMemoryTypeName)}.{String.from(ManagedMemoryCreateMethod)}`'s `{String.from(ManagedMemoryElementSizeParamName)}` must be a compile-time constant — it picks the buffer's ELEMENT TYPE, which `get`/`set` are typed from, and a size that exists only at run time leaves them with no type. Write the literal ({ByteStringElementSize} for bytes, {primitiveTypeByteSize(ValueTypeTag.integer)} for words).", line: self.tokenAt(argStart).line, column: self.tokenAt(argStart).column)
		end 'notAConstant'

		let size = self.constOf(elementSize)

		if not self.signatures.managedMemoryElementSizeIsTypeable(size) 'noElementTypeIsThatWide'
			throw SourceParseError.unsupported("`{String.from(ManagedMemoryTypeName)}.{String.from(ManagedMemoryCreateMethod)}`'s `{String.from(ManagedMemoryElementSizeParamName)}` is {size}, and the compiler has no element TYPE of that width — a buffer must be byte-packed ({ByteStringElementSize}) or machine-word ({primitiveTypeByteSize(ValueTypeTag.integer)}). Typing it as a word anyway would check `get`/`set` against a range the buffer's stride cannot hold, and store the value truncated.", line: self.tokenAt(argStart).line, column: self.tokenAt(argStart).column)
		end 'noElementTypeIsThatWide'

		let instance = self.signatures.managedMemoryInstanceForElementSize(size, readerFilePath: self.job.path)

		// ⭐⭐ **AND THE INSTANCE MUST STRIDE WHAT THE RECORD WILL BE STAMPED WITH.** `__managed_mem_create`
		// stamps `element_size@24` from this very ARGUMENT, so a `create` whose instance strides something
		// else is a record and a static type disagreeing about one buffer — the `b"…"` literal's incoherence
		// through the other producer, and it was accepted for a row's length while the literal was refused
		// (`requireBytePackedRecordStridesLikeThisFilesByte` carries the measurement).
		//
		// ⚠ **ONLY THE BYTE ARM CAN DISAGREE, WHICH IS WHY THE TEST IS NOT `size == arrayElementSize`.** The
		// word arm takes the bare-`int` instance, whose stride is the machine word by construction whatever
		// `Byte` was declared to be; and a NON-POSITIVE size never reaches a live record at all — the corpus
		// pins `create(4, 0)` as a caught runtime `invalidAllocation`, so which instance a doomed `create`
		// wore is unobservable and a `size == stride` test would turn that case into a compile error.
		if size == ByteStringElementSize 'aBytePackedBuffer'
			try self.requireBytePackedRecordStridesLikeThisFilesByte(instance, producer: BytePackedProducer.managedMemoryCreate, line: self.tokenAt(argStart).line, column: self.tokenAt(argStart).column)
		end 'aBytePackedBuffer'

		return instance
	end 'requireManagedMemoryElementSize'

	// ⭐ **THE `__ManagedMemory` PARAMETER RULE OF EVERY SIGNATURE-CHECKED BUILTIN.**
	//
	// ⚠ **THERE IS ONE STRIDE RULE, AND A BUILTIN PARAMETER KEEPS IT WHERE A DECLARED ONE DOES NOT.** A declared
	// parameter's argument goes to `SemanticCheck.checkOneArgType`, which asks `ProgramSignatures.aggregatesConflict` —
	// NOMINAL over the container, because a declared parameter hands the container over and the callee may push
	// into it. A BUILTIN parameter keeps the stride rule below because it has no declaration to be nominal about.
	// `builtin-type-checking.error-managed-file-open-read-int` pins its spelling.
	function requireManagedMemoryValue(value ValueId, paramName ByteArray, anchor Token) throws SourceParseError
		if self.valueIsByteArray(value) 'isByteArray'
			return
		end 'isByteArray'

		throw SourceParseError.builtinArgumentType(String.from(paramName), expected: String.from(ManagedMemoryTypeName), got: self.valueDisplayTypeName(value), line: anchor.line, column: anchor.column, expectedNote: "", crossesRange: false)
	end 'requireManagedMemoryValue'

	// Is `value` a BYTE-PACKED buffer — the instance `__ManagedMemory` is bound to, the one a `b"…"` literal
	// has, the one `.toByteArray()` produces, and the compiler-owned one a String's byte VIEW wears? The
	// shared PREDICATE behind the two rules above: they test the same thing and differ only in what they SAY.
	// Any other `Array` instance would be read at ITS element stride, so a path handed to the OS (or a String
	// built from it) would be whichever bytes fell on the stride boundaries — a silent wrong answer, refused
	// at the argument.
	//
	// ⚠ **THE STRIDE QUESTION ITSELF IS `ProgramSignatures.isBytePackedArrayInstance` AND IS NOT SPELLED HERE.**
	// The DECLARED-function argument door asks the identical question one tier up
	// (`SemanticCheck.checkOneArgType`), and a builtin parameter and a declared one disagreeing about what a
	// byte buffer is IS the defect this single predicate exists to close. This adapter only puts a `ValueId`'s two type
	// columns in front of it.
	function valueIsByteArray(value ValueId) returns bool
		return self.signatures.isBytePackedArrayInstance(self.tagOf(value), nameId: self.valueNameId(value))
	end 'valueIsByteArray'

	// A ByteArray or a one-byte-stride FixedArray: the buffers the AES intrinsics accept.
	function valueIsByteBuffer(value ValueId) returns bool
		return self.signatures.isBytePackedBufferRecordInstance(self.tagOf(value), nameId: self.valueNameId(value))
	end 'valueIsByteBuffer'

	function pairedDisplays(value ValueId, declaredTag ValueTypeTag, declaredNameId TypeNameId, declaredBrand ByteArray, declaredIdentity ByteArray, declaredShown String) returns PairedDisplays
		let gotShown = self.valueDisplayTypeName(value)
		let gotIdentity = aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: self.tagOf(value), nameId: self.valueNameId(value), readerFilePath: self.job.path)
		let gotNote = self.signatures.gotSideNote(self.tagOf(value), gotNameId: self.valueNameId(value), gotBrand: self.brandOf(value), gotIdentity: gotIdentity, gotShown: gotShown, declaredTag: declaredTag, declaredNameId: declaredNameId, declaredShown: declaredShown)
		let declaredNote = self.signatures.contestedTypeNote(declaredTag, nameId: declaredNameId, brand: declaredBrand, identity: declaredIdentity, shown: declaredShown, otherShown: gotShown)
		return PairedDisplays.create(self.signatures.tupleDisplayNoted(gotShown, identity: gotIdentity, otherShown: declaredShown, otherIdentity: declaredIdentity), gotNote: gotNote, declared: self.signatures.tupleDisplayNoted(declaredShown, identity: declaredIdentity, otherShown: gotShown, otherIdentity: gotIdentity), declaredNote: declaredNote)
	end 'pairedDisplays'

	// How a value's type is SPELLED in a diagnostic, its alias included — its tag, resolved through the
	// DISPLAY name behind it. An operand rule asks `valueKindWordAt` instead, which names an int- or
	// float-backed enum by the tag it judged; both render a struct through `brandedDisplayTypeName`, so
	// neither reaches for the identity.
	//
	// A BRANDED value prints its brand: `Xs` and `Ys` share a gid, and the brand is the type the value IS.
	// SemanticCheck's half is `valueTypeDisplayName`, and the two must agree or one message would quote the
	// author while its neighbour quoted the compiler.
	function valueDisplayTypeName(value ValueId) returns String
		return self.brandedDisplayTypeName(self.tagOf(value), nameId: self.valueNameId(value), brand: self.brandOf(value))
	end 'valueDisplayTypeName'

	function valueKindWord(value ValueId) returns String
		return self.valueKindWordAt(value, tag: self.tagOf(value))
	end 'valueKindWord'

	// `tag` is the tag the rule judged (a `numberTagOf` answer), so a float-backed enum prints `float`.
	// The alias is looked up by the value's own tag, which a ranged int alias's judged tag does not carry.
	function valueKindWordAt(value ValueId, tag ValueTypeTag) returns String
		let nameId = self.valueNameId(value)

		if tag == ValueTypeTag.structRef or tag == ValueTypeTag.genericInstance or tag == ValueTypeTag.interfaceRef or self.nameIdIsAnEnumOrUnion(tag, nameId: nameId) 'anAggregate'
			return self.brandedDisplayTypeName(tag, nameId: nameId, brand: self.brandOf(value))
		end 'anAggregate'

		return self.declaredSlotDisplayName(self.tagOf(value), nameId: nameId, fallback: typeTagName(tag))
	end 'valueKindWordAt'

	function nameIdIsAnEnumOrUnion(tag ValueTypeTag, nameId TypeNameId) returns bool
		return tag == ValueTypeTag.named and self.signatures.containsEnumFor(self.internedName(nameId), readerFilePath: self.job.path)
	end 'nameIdIsAnEnumOrUnion'

	// The SOURCE-LEVEL TYPE RULES the parser enforces — what an operator's operands may be, and
	// when two types agree — live in TypeRules.maxon, NOT here. They are shared with SemanticCheck
	// (whose call-argument check is the one rule that needs whole-program signatures and so cannot
	// live in the parser), and a rule with two homes is a rule that will eventually disagree with
	// itself. See that file's header. What lives here is only the RAISING of them: turning a
	// verdict into a positioned `SourceParseError`.

	// The non-numeric-operand refusal, split by whether the two operands AGREE — a `match` arm is one statement
	// and this is a fork. Both branches `throw` INLINE rather than returning a `SourceParseError` for the caller to
	// throw, which is the shape that leaks two allocations under the emitted refcount runtime.
	function raiseNonNumericOperands(opTok Token, left ValueTypeTag, leftValue ValueId, right ValueTypeTag, rightValue ValueId) throws SourceParseError
		let leftWord = self.valueKindWordAt(leftValue, tag: left)
		let rightWord = self.valueKindWordAt(rightValue, tag: right)

		if left == right and leftWord.equals(rightWord) 'oneTypeOnBothSides'
			throw SourceParseError.undefinedOperatorForType(opTok.kind.rawValue, typeName: leftWord, line: opTok.line, column: opTok.column)
		end 'oneTypeOnBothSides'

		throw SourceParseError.nonNumericOperands(leftWord, right: rightWord, line: opTok.line, column: opTok.column)
	end 'raiseNonNumericOperands'

	function nonIntegralOperandWord(left ValueTypeTag, leftValue ValueId, right ValueTypeTag, rightValue ValueId) returns String
		let offending = nonIntegralOperandOf(left, right: right)
		return self.valueKindWordAt(leftValue if offending == left else rightValue, tag: offending)
	end 'nonIntegralOperandWord'

	// The binary-operand rule, RAISED. **Both paths a word operator can take come through it** —
	// the ordinary `binOp` emit, and the short-circuit lowering, which emits no `binOp` at all
	// (the blocks are laid down instead) and would otherwise need its own copy of "what counts as
	// a mixed operand". A second copy on the OTHER path every `and`/`or` can take is free to
	// drift from the first, and the drift would show up as a `bool and int` silently accepted on
	// one path and rejected on the other — a wrong answer, not a compile error.
	function requireBinOpOperands(op MaxonBinOp, left ValueTypeTag, leftValue ValueId, right ValueTypeTag, rightValue ValueId, opTok Token) throws SourceParseError
		match checkBinOpOperands(op, left: left, right: right) 'operands'
			ok then break
			mixedWordOperands then throw SourceParseError.operandTypeMismatch(opTok.kind.rawValue, line: opTok.line, column: opTok.column)
			nonNumericOperands then try self.raiseNonNumericOperands(opTok, left: left, leftValue: leftValue, right: right, rightValue: rightValue)
			nonIntegralOperands then throw SourceParseError.nonIntegralOperands(opTok.kind.rawValue, operand: self.nonIntegralOperandWord(left, leftValue: leftValue, right: right, rightValue: rightValue), line: opTok.line, column: opTok.column)
		end 'operands'
	end 'requireBinOpOperands'

	// The display of a type that may wear a brand — a value's, or a declared place's (`which holds 'Ys'`).
	function brandedDisplayTypeName(tag ValueTypeTag, nameId TypeNameId, brand ByteArray) returns String
		if brandIsTheType(brand) 'aBrandIsTheType'
			return String.from(self.signatures.brandDisplayName(brand, gid: nameId as GenericInstanceId))
		end 'aBrandIsTheType'

		return self.displayTypeNameOf(tag, nameId: nameId)
	end 'brandedDisplayTypeName'

	// ⭐⭐ **THE DISPLAY TWIN OF `aggregateNameIn`, AND THE PARSER-TIER HALF OF ONE RULE (user ruling,
	// 2026-08-04): a diagnostic names a type the way the AUTHOR WROTE IT.** `aggregateNameIn` answers with the
	// IDENTITY — for a generic instance, the canonical `Array_String` two values are compared on — and an
	// identity is not a spelling: no source line holds `Array_String`, the author wrote
	// `typealias StringArray = Array with String`. Every other tag already answers with a written name (a
	// struct, an interface, a registered union/enum) or with the primitive the author sees (`int`, `String`),
	// so the instance arm is the whole difference and the rest routes through the existing chain.
	//
	// ⚠ The SemanticCheck twin is `typeDisplayName`, and the instance name they both quote comes from the
	// shared whole-program index, so they cannot come to spell one type two ways. **What is twinned is the LOOKUP
	// and the instance arm, which are the two tier-bound halves; the TAIL is not, and is
	// `ProgramSignatures.displayNameOfAggregate` — one home, because it takes a tag and a resolved name, and a
	// tuple's element names resolve against the whole-program index both tiers share.**
	function displayTypeNameOf(tag ValueTypeTag, nameId TypeNameId) returns String
		if tag == ValueTypeTag.genericInstance 'genericInstance'
			return String.from(self.signatures.instanceDisplayName(nameId as GenericInstanceId))
		end 'genericInstance'

		// Its aggregate NAME when it has one (a declared struct/union), else the scalar TYPE it actually is —
		// an `int`, a `bool`, a `String`, or a ranged-int alias whose overloaded `named` tag is NOT an
		// aggregate.
		return self.signatures.displayNameOfAggregate(tag, aggregate: aggregateNameIn(self.signatures, interner: self.artifact.typeNames, tag: tag, nameId: nameId, readerFilePath: self.job.path))
	end 'displayTypeNameOf'

	// `CharSet from ['x', 'y', 'z']` — the SOURCE form of a `Set with Character`, and the only form: the
	// eleven predefined sets are `stdlib/CharacterSet.maxon`'s own `static let`s. The cursor sits on the `[`.
	// Each element is a `Character` by being written as a character literal.
	//
	// The create and the insert are `emitContainerLiteralCreate`/`emitContainerLiteralElement` under `Set`'s base
	// name directly — the corpus `Set`'s own doors,
	// which is what enrols the fresh set as a pending temporary (a `let s = CharSet from ['x']` that never
	// reaches an owner is still dropped at scope exit) and what makes the insert a VOID mutator the set owns
	// its member from. There is one producer, so there is one spelling of the member set's INSTANCE.
	function parseCharacterMemberSetLiteral(func IrFunction, anchor Token, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftBracket)
		let chars = try self.emitContainerLiteralCreate(SetBuiltinBaseName, giid: self.signatures.setInstanceForCharacter(), anchor: anchor, range: range)

		while not self.at(TokenKind.rightBracket) 'eachMember'
			let memberTok = self.current()
			let member = try self.parseExpression(func, block: self.bodyState.currentBlock)

			if self.tagOf(member) != ValueTypeTag.character 'notACharacter'
				throw SourceParseError.builtinOperandType(String.from(CharacterMemberSetAliasName), required: typeTagName(ValueTypeTag.character), got: self.valueKindWord(member), line: memberTok.line, column: memberTok.column)
			end 'notACharacter'

			try self.emitContainerLiteralElement(SetBuiltinBaseName, method: InsertMethod, container: chars, value: member, anchor: anchor, range: range)

			if not self.at(TokenKind.rightBracket) 'moreMembers'
				try self.consume(TokenKind.comma)
			end 'moreMembers'
		end 'eachMember'

		try self.consume(TokenKind.rightBracket)
		return chars
	end 'parseCharacterMemberSetLiteral'

	// ⭐ **A `StringIndex`'S BUILTIN METHODS** — `charIndex()` and `bytePos()`, the corpus's
	// own two accessors (`stdlib/String.maxon:939-949`). Its own dispatcher rather than the struct path, for
	// the ROSTER-WINS reason `s.byteLength()` keeps its arm: `dispatchMethodOnBase` would resolve both names
	// against `funcSignatures` and find the corpus's real bodies, so this is not about reachability — it is
	// that each would then be a CALL, and `bytePos()` is read twice per `slice`, once per `charAt`, once per
	// `indexAfter` and once per step of every corpus loop that walks an index.
	//
	// ⚠ **THE ARGUMENT FOR THIS DISPATCHER IS COST, NOT REACHABILITY.** The corpus's declaration is the only
	// `StringIndex` declaration, so there is no fall-through to guard against and what is left is the cost of a CALL
	// per read. **A dispatcher kept for a reason that has expired is a dispatcher nobody re-justifies**; this one
	// earns its place on those grounds.
	//
	// Both are FIELD READS through the layout's own door (`emitFieldLoad`), not hand-written offsets: the
	// layout the corpus's declaration registered is where a `StringIndex`'s shape is stated, and reading it
	// any other way would be a second copy of the offsets.
	//
	// The cursor sits on the method NAME (`dispatchMethodOnReceiver` consumed the `.`). It takes no
	// `resultUsed`: both methods return a value, so there is no void result for a value position to misuse.
	function dispatchStringIndexMethod(recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(recv.anchor, last: methodTok)

		// The roster gate, `dispatchStringMethod`'s twin — see there for why it is asked ahead of every arm.
		let roster = try self.requireSurfaceMember(MemberSurface.stringIndex, typeName: StringIndexTypeName, methodTok: methodTok)

		if methodTok.value.equals(StringIndexCharIndexMethod) 'charIndex'
			try self.consumeEmptyArgList()
			return self.emitStringIndexField(recv.value, index: StringIndexCharIdxFieldIndex, range: range)
		end 'charIndex'

		if methodTok.value.equals(StringIndexBytePosMethod) 'bytePos'
			try self.consumeEmptyArgList()
			return self.emitStringIndexField(recv.value, index: StringIndexBytePosFieldIndex, range: range)
		end 'bytePos'

		let drift = rosterDriftMessage("dispatchStringIndexMethod", member: methodTok.value, roster: roster, rosterFuncs: "`stringIndexSurfaceMemberNames`")
		panic("{drift}")
	end 'dispatchStringIndexMethod'

	// One field of a `StringIndex` box, read through the layout the CORPUS's declaration registered — the
	// shared body of `charIndex()`, `bytePos()`, `slice`'s two byte-position reads and the `==` comparison.
	// Five readers, one derivation of where a field lives, and that derivation runs off the
	// same `type StringIndex` a program can name.
	function emitStringIndexField(box ValueId, index FieldIndex, range SourceRange) returns ValueId
		return self.emitFieldLoad(box, layout: self.signatures.stringIndexLayoutOrPanic(), index: index, range: range)
	end 'emitStringIndexField'

	// The `__ManagedFile` type's interned name — adopted into THIS FILE's interner, because that is
	// the one a value's `nameId` column is read against (`mintValue`), not the whole-program one.
	//
	// ⚠ There is no `stringIndexNameId` twin: `startIndex`/`endIndex`/`findFirst`/`findLast`/`indexAfter` are
	// `stdlib/String.maxon`'s, so every `StringIndex` value in a program is a CALL RESULT whose name comes off the callee's
	// declared return type — nothing in this file mints one, and nothing needs the id.
	function managedFileNameId() returns TypeNameId
		return self.artifact.typeNames.intern(ManagedFileTypeName)
	end 'managedFileNameId'

	// The `__ManagedDirectory` type's interned name — `managedFileNameId`'s twin, against the
	// ARTIFACT's interner for its reason.
	function managedDirectoryNameId() returns TypeNameId
		return self.artifact.typeNames.intern(ManagedDirectoryTypeName)
	end 'managedDirectoryNameId'

	// The `__ManagedSocket` type's interned name — `managedDirectoryNameId`'s twin, against the same interner.
	function managedSocketNameId() returns TypeNameId
		return self.artifact.typeNames.intern(ManagedSocketTypeName)
	end 'managedSocketNameId'

	function managedPagesNameId() returns TypeNameId
		return self.artifact.typeNames.intern(ManagedPagesTypeName)
	end 'managedPagesNameId'

	function managedHandleNameId() returns TypeNameId
		return self.artifact.typeNames.intern(ManagedHandleTypeName)
	end 'managedHandleNameId'

	function managedPinNameId() returns TypeNameId
		return self.artifact.typeNames.intern(ManagedPinTypeName)
	end 'managedPinNameId'

	// Is this receiver a `__ManagedFile`? A TAG cannot answer it — every struct box is `structRef` — so it
	// is the interned NAME behind the tag, exactly as `isStringIndexType` asks.
	//
	// ⚠⚠ **IT ACCEPTS `named` AS WELL AS `structRef`, AND WITHOUT THAT HALF THE CORPUS'S ACTUAL SPELLING
	// DOES NOT DISPATCH.** A struct FIELD read carries `named`, not `structRef` — `fieldTypeOf`
	// re-tags only function and generic-alias fields, which `decrefCalleeFor`'s own `named` arm records — and
	// the corpus reaches every instance method through a field: `specs/managed-file.md`'s documented usage
	// pattern is a `__ManagedFile` INSIDE a wrapper type, so it is `wf.file.write(…)`, never `f.write(…)`.
	// Left narrow, that receiver falls past this arm to the struct path and reports E3004 against a method
	// the language does have. (`structRef` alone serves only a case that binds the box
	// DIRECTLY.)
	//
	// ⚠ **IT READS THE NAME BEHIND THE ID; IT DOES NOT INTERN ONE.** `typeNames.equalsAt(id, other: name)`
	// is a dense-column index plus a byte compare against the arena, materializing nothing — the form
	// `isStringIndexType` and `isManagedDirectoryType` both use. A `nameId ==
	// self.managedFileNameId()` spelling would ask the same question by HASHING `__ManagedFile` and
	// probing the interner on EVERY method dispatch in the program, and would INSERT on a miss — so a
	// file that merely calls a method on some struct would acquire a `__ManagedFile` entry it has no
	// use for, on the enum/alias receivers too, since the tag gate here admits `named`. The enum test
	// one arm below gates on the tag FIRST for the same reason: the interner is not touched for a
	// receiver that is not its business. The mint site (`parseManagedFileOpen`) interns, which is
	// where the id genuinely has to exist.
	function isManagedFileType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: ManagedFileTypeName)
	end 'isManagedFileType'

	// Is this receiver a `__ManagedDirectory`? `isManagedFileType`'s twin, in every respect including WHY it
	// accepts `named` beside `structRef`: `specs/managed-directory.md`'s documented usage pattern reaches
	// every instance method through a struct FIELD (`wrapper.dir.next()`), and a field read carries `named`.
	// It reads the name behind the id rather than interning one, so a receiver that is not its business
	// costs a dense-column index and a byte compare.
	function isManagedDirectoryType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: ManagedDirectoryTypeName)
	end 'isManagedDirectoryType'

	// Is this receiver a `__ManagedSocket`? `isManagedDirectoryType`'s twin, in every respect including WHY it
	// admits both aggregate tags.
	function isManagedSocketType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: ManagedSocketTypeName)
	end 'isManagedSocketType'

	function isManagedPagesType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: ManagedPagesTypeName)
	end 'isManagedPagesType'

	function isManagedHandleType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: ManagedHandleTypeName)
	end 'isManagedHandleType'

	function isManagedPinType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: ManagedPinTypeName)
	end 'isManagedPinType'

	// ⭐ **"IS THIS RECEIVER THE AGGREGATE CALLED `typeName`?" — THE SHARED BODY OF THE THREE TYPE TESTS
	// ABOVE AND BELOW** (`__ManagedFile`, `__ManagedDirectory`, `StringIndex`). Each spelled the tag gate and
	// the name compare out for itself, which is three copies of one rule — and the rule is not obvious in
	// either half: the TAG gate must admit `named` as well as `structRef` (the measured defect, recorded
	// at `isManagedFileType`), and the NAME must be read behind the id rather than interned (which would
	// insert on a miss, giving every file that calls any struct method an entry it has no use for).
	// A fourth such type gets both facts by asking, rather than by copying whichever neighbour it read.
	//
	// ⚠ The tag half is `SignatureIndex.tagMayNameAggregate`, not a fourth spelling of it: that function's
	// own header records the FOUR ways this same test had come to be written, and adding a fifth here would
	// be the thing it was written to stop.
	function receiverIsNamedAggregate(tag ValueTypeTag, nameId TypeNameId, typeName ByteArray) returns bool
		if not self.signatures.tagMayNameAggregate(tag) 'notAnAggregateRef'
			return false
		end 'notAnAggregateRef'

		return self.artifact.typeNames.equalsAt(nameId, other: typeName)
	end 'receiverIsNamedAggregate'

	// ⭐ **THE FIVE `__ManagedFile` INSTANCE METHODS — `close`, `size`, `read`, `readAppending`,
	// `write`.** The cursor sits on the method NAME (`dispatchMethodOnReceiver` consumed the `.`).
	//
	// An open with no close leaks an OS handle for the process lifetime, and that leak is invisible to
	// the exit-101 memory gate because a handle is not memory. `close()` is NON-throwing and void, per
	// the spec's "Does not throw"; the other four throw `__ManagedFileError`.
	//
	// An unknown method is refused by name here rather than mangled into a callee no file declares —
	// `compilerOwnedStaticSurface`'s argument for the statics, on the instance side.
	function dispatchManagedFileMethod(func IrFunction, recv MethodReceiver) returns ValueId throws SourceParseError
		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(recv.anchor, last: methodTok)

		if methodTok.value.equals(ManagedFileCloseMethod) 'close'
			try self.consumeEmptyArgList()
			return self.emitRuntimeCall(ManagedFileCloseName, args: argsOf(recv.value), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
		end 'close'

		if methodTok.value.equals(ManagedFileSizeMethod) 'size'
			try self.consumeEmptyArgList()
			return self.emitLibraryAliasedRuntimeCall(ManagedFileSizeName, args: argsOf(recv.value), alias: FileSizeAliasName, range: range)
		end 'size'

		// ⚠ The buffer is BORROWED, not consumed: `__mf_read` writes into it and `__mf_write` reads out of
		// it, and neither takes ownership — which is what lets the caller keep using `buffer` afterwards (and
		// lets a `"…".toByteArray().managed` temporary drop at the end of the statement, as it does today for
		// `openRead`'s path).
		if methodTok.value.equals(ManagedFileReadMethod) 'read'
			let (managed, size) = try self.parseManagedFileFillArgs(func, methodTok: methodTok)
			return self.emitLibraryAliasedRuntimeCall(ManagedFileReadName, args: threeArgs(recv.value, second: managed, third: size), alias: FileSizeAliasName, range: range)
		end 'read'

		if methodTok.value.equals(ManagedFileReadAppendingMethod) 'readAppending'
			let (managed, size) = try self.parseManagedFileFillArgs(func, methodTok: methodTok)
			return self.emitLibraryAliasedRuntimeCall(ManagedFileReadAppendingName, args: threeArgs(recv.value, second: managed, third: size), alias: FileSizeAliasName, range: range)
		end 'readAppending'

		if methodTok.value.equals(ManagedFileWriteMethod) 'write'
			try self.consume(TokenKind.leftParen)
			let managed = try self.parseManagedMemoryArg(func, paramName: ManagedFileManagedParamName, methodTok: methodTok)
			try self.consume(TokenKind.rightParen)
			return self.emitLibraryAliasedRuntimeCall(ManagedFileWriteName, args: twoArgs(recv.value, second: managed), alias: FileSizeAliasName, range: range)
		end 'write'

		throw SourceParseError.unsupported("`{String.from(ManagedFileTypeName)}` method '{String.from(methodTok.value)}' — the type has exactly these five: `size()`, `read(managed, size)`, `readAppending(managed, size)`, `write(managed)` and `close()`", line: methodTok.line, column: methodTok.column)
	end 'dispatchManagedFileMethod'

	function parseManagedFileFillArgs(func IrFunction, methodTok Token) returns (ValueId, ValueId) throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let managed = try self.parseManagedMemoryFillArg(func, paramName: ManagedFileManagedParamName, methodTok: methodTok)

		// ⭐ **THE THIRD RAW-BYTE FILL** — `__mf_read` and `__mf_read_append` blit a file's contents into
		// the caller's buffer, so the buffer's element has to admit every value a byte has, exactly as
		// the byte view's and `setByte`'s do. `write` is NOT gated beside it: it READS the buffer out to
		// the file and stores nothing, which is the same reason `byteAt` is untouched.
		//
		// The instance is the value's own name id: `parseManagedMemoryArg` has just proven through
		// `requireManagedMemoryValue` that this value IS a byte-packed generic instance, so the tag is
		// established before the id is read as one (`isArrayInstanceAt`'s trap, one call earlier).
		try self.requireRawByteFillFitsItsElement(self.valueInstanceId(managed), methodTok: methodTok)
		try self.consume(TokenKind.comma)
		let size = try self.parseBuiltinIntegerArg(func, paramName: ManagedFileSizeParamName, methodTok: methodTok)
		try self.consume(TokenKind.rightParen)
		return (managed, size)
	end 'parseManagedFileFillArgs'

	// ⭐ **IS THIS THE `StringIndex` TYPE?** A TAG cannot answer it — every struct box is `structRef` — so it
	// is the interned NAME behind the tag, which is the same identity `aggregateNameIn` publishes for a
	// reassign check. The tag gate is not merely a fast path: a non-aggregate tag carries `UnnamedTypeId` in
	// the name column, which no interner is obliged to hold.
	//
	// Its askers read the two DIFFERENT records a type can live in, which is why the shared body takes
	// the pair rather than either one: `dispatchMethodOnBinding` asks a BINDING's declared type (a
	// self-field alias holds no value, so its `boundValue` is the receiver's box and would answer for the
	// wrong type), and `emitCompare`/`slice` ask a VALUE's columns (a call result is bound to no name).
	//
	// ⚠ **IT ADMITS `named` BESIDE `structRef`, AND THE CORPUS'S DECLARATION IS WHAT MAKES THAT REACHABLE.** The
	// `StringIndex` source can name is the corpus's own, so `function byteOf(idx StringIndex)` and
	// `var pos as StringIndex` are both programs, and a struct field read carries `named`, which is the measured
	// lesson of `isManagedFileType` one type over. Left narrow, those two receivers would fall past this arm to
	// the struct path, which RESOLVES both accessors against the corpus and answers correctly — so the cost of
	// the omission would be a silent CALL where every other spelling gets a field load, not a wrong answer.
	// Consistency is the reason it is widened, and it is stated because the absence of a wrong answer is
	// exactly what would let it sit.
	function isStringIndexType(tag ValueTypeTag, nameId TypeNameId) returns bool
		return self.receiverIsNamedAggregate(tag, nameId: nameId, typeName: StringIndexTypeName)
	end 'isStringIndexType'

	function valueIsStringIndex(value ValueId) returns bool
		return self.isStringIndexType(self.tagOf(value), nameId: self.valueNameId(value))
	end 'valueIsStringIndex'

	// `( )` — the empty argument list of a no-argument BUILTIN call, whichever family it belongs to: a String
	// accessor (`byteLength`, `isEmpty`, `clone`), an array method (`count`, `first`, `pop`, `clear`, …), a
	// set method, and the two static factories (`IntArray.create()`, `IntSet.create()`). One home
	// means a builtin's empty argument list is parsed the same way everywhere.
	function consumeEmptyArgList() throws SourceParseError
		try self.consume(TokenKind.leftParen)
		try self.consume(TokenKind.rightParen)
	end 'consumeEmptyArgList'

	// ⚠⚠ **`String.append` HAS NO PARSER ARM, AND ITS RECEIVER-WRITE REFUSAL LIVES ELSEWHERE.** The corpus body
	// (`stdlib/String.maxon:428-437`) carries the append itself; `receiverOwnerMask` derives the bit from the
	// envelope collapse and `CapabilityCallCheck.checkCallArguments` raises the E3207 at the same token.
	// The corpus reaches `__managed_append` through `managed.append(other.managed)`, whose growth is
	// `__managed_grown_cap`'s and so stays geometric.

	// --- Direct builtin-conformance dispatch: `i.compare(j)` / `i.hash()` / `i.equals(j)`,
	// and a `String` receiver's `s.hash()` / `s.equals(t)` through the same body ---

	// ⭐ **ONE BODY SERVES BOTH DISPATCH PATHS.** A concrete receiver calls `int.compare` DIRECTLY —
	// the very symbol a `__witness_int.Comparable` slot is stamped with (`ensureWitnessTable`'s
	// funcAbs64 reloc), built by the very same `BuiltinConformanceRuntime.buildOrderingCompare`. There
	// is no second impl for the direct path and no thunk between them: the dictionary-passing form
	// loads the pointer out of `.rdata` and the concrete form names the symbol, and they land in the
	// same function.
	//
	// ⚠ **THE INSTALLER MUST SEE THIS REFERENCE.** `installBuiltinConformanceRuntime` builds an impl iff
	// the program REFERENCES it, and a direct call creates no `.rdata` reloc — see that file's header for
	// how the reference is found. A dispatch emitted here that the installer cannot see is a link-time
	// panic (`resolveCallFixups: call to unknown function 'int.compare'`), never a silent wrong answer.

	// Resolve the method name against the conformer's INTRINSIC conformances and emit the call. The cursor
	// sits on the method NAME. A name no intrinsic conformance supplies is a clean positioned reject — never
	// a route to a `<type>.<method>` symbol nothing installs.
	function dispatchBuiltinConformanceMethod(func IrFunction, recv MethodReceiver, conformer BuiltinConformer, resultUsed bool) returns ValueId throws SourceParseError
		let typeName = builtinConformerName(conformer)

		// ⭐⭐⭐ **A DECLARED BODY BEATS EVERY ARM BELOW, AND THIS TEST HAS TO COME FIRST OR TWO OF THEM ARE A
		// SILENT WRONG ANSWER.** A primitive can declare an `extension int`, so the arms below are not the only
		// surface it has and the ordering question exists:
		// `extension int implements Stringable` declaring a `toString()` publishes a real `int.toString`
		// function, type-checked and linked — and the `toString` arm below LOWERS INLINE AND CALLS NO SYMBOL, so
		// left ahead of this test it would emit the compiler's own conversion and the author's body would never
		// run. Not a refusal, not a link failure: a program that compiles, links, runs and prints the wrong
		// thing. `clone` is the identical shape (`emitPrimitiveClone` hands back the receiver), which is why
		// `specs/extension-over-primitive.md` spends a differing-declarations case on each.
		//
		// ⚠ **IT IS A PEEK, BECAUSE THE DECLARED PATH MAY NOT CONSUME THE NAME** — `parseCallNamed` consumes it
		// itself, exactly as `dispatchMethodOnBase` peeks for the same reason. The cursor is on the method name
		// (the `.` is already consumed), which is the same position `methodCallCancelsAPromise` peeks from.
		//
		// ⭐ **THE SYNTHESIZED SURFACE IS NOT RETIRED BY THIS, AND MUST NOT BE:** a program that declares
		// nothing still reaches every arm below unchanged, which is what keeps `5.hash()`, `"{x}"` and
		// `x.clone()` working with no `stdlib/PrimitiveExtensions.maxon` listed. This is the
		// `cloneIsSynthesized` rule — *"wired PAST the `declaresCallee` test, so a user-written `clone`
		// still wins"* — asked of a primitive instead of a struct.
		//
		// ⚠ **`declaresCallee` IS THE WHOLE-PROGRAM SWEEP, NOT THIS FILE**, for `cloneIsSynthesized`'s
		// reason: the `extension int` may be written in any file, and an answer that depended on which file the
		// call is in would dispatch one `n.hash()` to the declaration and another to the synthesized impl.
		let methodTok = self.current()
		let declaredCallee = qualifiedMethodName(typeName, methodName: methodTok.value)

		if self.signatures.declaredMemberBeatsTheCompiler(typeName, member: methodTok.value) 'theProgramDeclaresItsOwn'
			// `resolvedTypeQualifier`: the author wrote the MEMBER and a receiver, and no token at this call
			// site spells the type — `dispatchMethodOnBase`'s mint, for its reason. `ConstructorInstance.none`
			// because a primitive has no box for a constructor to have built.
			return try self.parseCallNamed(func, callee: declaredCallee, anchor: methodTok, receiver: self.writtenReceiver(recv.value, immutableName: recv.immutableName, anchor: recv.anchor), resultUsed: resultUsed, constructorInstance: ConstructorInstance.none, mint: CalleeMint.resolvedTypeQualifier)
		end 'theProgramDeclaresItsOwn'

		// The peek above only READ the name; the arms below all consume it, and this is the one place they
		// share to do it — which is also where a member that is not a name at all still gets the E2010 it
		// always got.
		try self.consume(TokenKind.identifier)

		// ⭐⭐ **THE TWO LOWERED PROTOCOL METHODS COME NEXT, and neither reaches an impl.** Both reference
		// compilers give `int`/`float`/`bool` these through an `extension … implements …` in
		// `stdlib/PrimitiveExtensions.maxon` whose whole body is ONE expression; The compiler has that mechanism
		// but does not yet LIST that module (`IrInterface.isIntrinsicBuiltinConformance` withholds
		// `Stringable`/`Cloneable` from the primitives on purpose — `:2243-2247`), so with nothing declared it
		// still emits that one expression here and skips the frame. That is why these arms sit AHEAD of the
		// conformance lookup rather than adding protocols to it, and BEHIND the declared-body test above. They
		// are named once, beside the refusal that advertises them, in
		// `IrInterface.builtinConformerLoweredMethodNames`, whose header carries why a lowering is kept out of
		// `isIntrinsicBuiltinConformance`.

		// `x.toString()` is `Stringable`'s method and lowers to exactly what `"{x}"` lowers to
		// (`specs/primitive-stringable.md`, whose Notes say "uses the same conversion as string
		// interpolation" and mean it literally).
		if methodTok.value.equals(ToStringMethodName) 'stringableLowering'
			try self.consumeEmptyArgList()
			return try self.emitValueToString(recv.value, exprTok: methodTok, range: SourceRange.between(recv.anchor, last: methodTok))
		end 'stringableLowering'

		// ⭐ **`x.clone()` IS `Cloneable`'S METHOD AND ITS LOWERING IS THE IDENTITY** — the three bodies
		// in `stdlib/PrimitiveExtensions.maxon:25-27`, `:70-72`, `:98-100` are literally `return self`,
		// because a primitive IS its value: there is nothing to copy that handing back the receiver has
		// not already done. So the call frame is skipped like `toString`'s, and no `<type>.clone` symbol
		// exists or is owed.
		//
		// ⚠⚠ **HANDING BACK THE RECEIVER IS SOUND HERE AND IS EMPHATICALLY WRONG FOR A MANAGED RECEIVER** —
		// see `dispatchStringMethod`'s `clone` arm, which calls `__str_clone` precisely because returning the
		// receiver would hand the caller a second owner of one box. What makes the difference is not this arm's
		// judgement but WHICH receivers can reach it: `dispatchMethodOnReceiver` routes a `String` receiver to
		// `dispatchStringMethod` and a `Character` receiver to `dispatchCharacterMethod` several arms above the
		// builtin-conformer arm, so the only conformers that arrive are the three SCALARS, which own no
		// storage, are copied by every assignment already, and can no more be aliased by this than `let y = x`
		// can. ⇒ **admitting a managed conformer to `builtinConformerOfTag` without first giving it its own
		// dispatcher would make this arm a use-after-free**, which is the same ordering fact that header
		// already calls load-bearing.
		if methodTok.value.equals(CloneMethodName) 'cloneableLowering'
			try self.consumeEmptyArgList()
			return try self.emitPrimitiveClone(recv.value, methodTok: methodTok)
		end 'cloneableLowering'

		match builtinConformerMethod(typeName, methodName: methodTok.value, discovered: DiscoveredConformer.none, interfaces: self.signatures.interfaceMap()) 'lookup'
			supplied(method) then return try self.emitBuiltinConformanceCall(func, receiver: recv.value, target: DirectConformanceTarget.builtinValue(conformer), method: method, baseTok: recv.anchor, methodTok: methodTok)
			notSupplied then throw SourceParseError.unsupported("'{String.from(typeName)}' has no method named '{String.from(methodTok.value)}' — a builtin-typed receiver supplies {builtinConformerDispatchMethodNames(typeName)}", line: methodTok.line, column: methodTok.column)
		end 'lookup'
	end 'dispatchBuiltinConformanceMethod'

	// ⭐⭐ **THE VALUE `x.clone()` DENOTES — the receiver, EXCEPT THAT IT SHEDS THE RECEIVER'S RANGED
	// TYPEALIAS, because `Cloneable.clone() returns Self` and `Self` here is the CONFORMER, not the alias
	// the receiver was written as.**
	//
	// ⚠ **`clone()` ANSWERS THE EXTENDED PRIMITIVE, NOT THE RECEIVER'S ALIAS.** `int`/`float`/`bool`
	// are conformed through `extension int`/`extension float`/`extension bool`, so the `Self` those
	// `clone() returns Self` bodies name is the primitive: a `Byte` receiver's clone is an `int`, a
	// `Percent` receiver's is a `float`. `x.clone() as Byte` and `p.clone() as Percent` therefore
	// COMPILE, where `x as Byte` on the same `x` is E3010 "unneeded cast".
	// `primitive-cloneable/byte.clone` is exactly that program — `let y = x.clone() as Integer` — and
	// returning the receiver unchanged refuses it, on a diagnostic true about the typing and wrong
	// about the language.
	//
	// ⭐ **AND IT IS THE READING THE COMPILER ALREADY GIVES `Self` IN ARGUMENT POSITION.**
	// `requireBuiltinConformanceSelfArgs` admits an `equals`/`compare` argument by CONFORMER
	// (`valueIsConformer`, which collapses `Byte` and `Integer` alike to `int`), never by the alias the
	// argument was written as. One rule now answers `Self` in both positions.
	//
	// ⭐ **NOTHING IS EMITTED UNLESS THE ANSWER WOULD OTHERWISE MOVE** — `applyCast`'s discipline, whose five
	// mint questions each fire only where a shared value would carry a fact that is not the result's. A
	// receiver denoting no ranged alias (every `bool`, and the overwhelming majority of `int`s and `float`s:
	// a literal, a plain binding, a parameter typed `int`) IS the whole answer, so `let x = 42` then
	// `x.clone()` costs not one instruction — which is what makes this a lowering rather than a call.
	function emitPrimitiveClone(receiver ValueId, methodTok Token) returns ValueId throws SourceParseError
		match self.valueDenotedAlias(receiver) 'denoted'
			undeclared then return receiver
			declared(alias) then return try self.emitAliasFreeCopy(receiver, alias: alias, methodTok: methodTok)
		end 'denoted'
	end 'emitPrimitiveClone'

	// ⭐ **THE SAME NUMBER UNDER A FRESH SSA IDENTITY THAT DENOTES NO ALIAS.** A fresh ValueId is the ONLY
	// way to say it: the alias is recorded per VALUE (`ValueDeclaredAliasMap`) and the receiver's entry is
	// the receiver's, so a result that shares its id shares its alias. `emitBinOp` mints its result
	// `UnnamedTypeId` at the operator's own domain tag, which is precisely the plain primitive wanted here.
	//
	// ⚠⚠ **`v - 0` AND NOT `v + 0`, AND THE DIFFERENCE IS ONLY VISIBLE ON A FLOAT.** `-0.0 + 0.0` is `+0.0`
	// — a wrong answer for `(-0.0).clone()` — while `-0.0 - 0.0` is `-0.0`. Subtracting the domain's zero is
	// an EXACT identity on every input of both domains: signed zeroes, subnormals, infinities and NaN all
	// come back bit-for-bit, and an integer subtract of 0 cannot overflow. (`applyCast`'s int-only retag
	// emitter uses `+ 0` and is correct there for the same reason it would not be here — no float reaches
	// it.) `recordBinOpFold` carries a constant receiver's value across, so the parser's const view — which
	// is what turns a shift COUNT into a compile-time decision — survives the mint.
	//
	// The alias itself says which zero, so the domain is read off the very fact that made a copy necessary
	// rather than off a second classifier: every ranged typealias is an int range or a float range
	// (`aliasIsFloat`), and there is no third.
	function emitAliasFreeCopy(receiver ValueId, alias RangedTypeAlias, methodTok Token) returns ValueId throws SourceParseError
		let range = SourceRange.ofToken(methodTok)
		let zero = self.emitLiteral(FloatZeroBits, valueType: MaxonType.float, range: range) if aliasIsFloat(alias) else self.emitLiteral(0, valueType: MaxonType.integer, range: range)

		return try self.emitBinOp(receiver, rhs: zero, op: MaxonBinOp.sub, opTok: methodTok)
	end 'emitAliasFreeCopy'

	// Parse the argument list and emit the call. The receiver is argument 0 and is BORROWED, so no incref is
	// emitted here and no drop is owed there, exactly as an instance method's receiver rides. That is a
	// property of the IMPLS rather than of the operand kind, which is why it survived `String` joining them:
	// the scalar impls read by-value operands and free nothing, and `buildStrHash`/`buildStrEq` take a String
	// POINTER but only read `buffer@0`/`length@8` and walk the bytes (see their headers). A managed argument
	// therefore stays an ordinary pending temp and drops at statement end, AFTER the compare.
	//
	// It goes through `emitRuntimeCall` rather than `emitCall` for that door's stated reason: a synthesized
	// impl is built at the Std tier AFTER the pipeline, so no file declares it, `mintCallResult` would type
	// it `unresolved`, and the argument order is the compiler's own rather than a signature's. The result is
	// typed from the interface method's declared return (`interfaceReturnMaxonType` — the SAME typing the
	// witness-dispatched form gets), so `compare`'s `Ordering` carries the enum's `named` tag a `match`
	// recognizes and `hash`'s `HashValue` carries the ranged alias's.
	function emitBuiltinConformanceCall(func IrFunction, receiver ValueId, target DirectConformanceTarget, method InterfaceMethodSig, baseTok Token, methodTok Token) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let args = ValueIdArray.create(0)
		args.push(self.holdStorageReadForStatement(receiver, kind: HoldKind.callOperand, range: SourceRange.ofToken(baseTok), position: OperandSuccession.receiverBeforeArguments))

		if not self.at(TokenKind.rightParen) 'hasArgs'
			while true 'argLoop'
				let argTok = self.current()
				let arg = try self.parseValueExpression(func)
				args.push(self.holdStorageReadForStatement(arg, kind: HoldKind.callOperand, range: SourceRange.ofToken(argTok), position: OperandSuccession.beforeComma))

				if not self.at(TokenKind.comma) 'endArgs'
					break
				end 'endArgs'

				try self.consume(TokenKind.comma)
			end 'argLoop'
		end 'hasArgs'

		let rparenTok = try self.consume(TokenKind.rightParen)

		// A builtin has no signature for `SemanticCheck`'s arity check to consult, so it is raised here —
		// the same `builtinArity` every other builtin raises, counted in USER arguments (the receiver slot
		// is the compiler's, and reporting it would name an argument the author never wrote).
		let userArgs = args.count() as ParamCount - BuiltinConformanceReceiverArgs

		if userArgs != method.paramTypes.count() as ParamCount 'arity'
			throw SourceParseError.builtinArity(String.from(method.name), expected: method.paramTypes.count() as ParamCount, got: userArgs, line: methodTok.line, column: methodTok.column)
		end 'arity'

		try self.requireBuiltinConformanceSelfArgs(method, args: args, target: target, methodTok: methodTok)

		let resultType = self.interfaceReturnMaxonType(method.returnType)
		return self.emitRuntimeCall(self.conformanceImplNameOf(target, methodName: method.name), args: args, resultTag: maxonTypeTag(resultType), resultNameId: typeNameIdOf(resultType), range: SourceRange.between(baseTok, last: rparenTok))
	end 'emitBuiltinConformanceCall'

	// The symbol a direct conformance dispatch calls. Both arms name a body that already exists — the
	// synthesized `<conformer>.<method>`, or (for an enum) `int`'s own, which is the whole reason the enum
	// grant mints nothing.
	function conformanceImplNameOf(target DirectConformanceTarget, methodName ByteArray) returns immutable ByteArray
		match target 'target'
			builtinValue(conformer) then return qualifiedMethodName(builtinConformerName(conformer), methodName: methodName)
			enumTagValue(enumName) then return self.signatures.enumConformanceImplName(enumName, methodName: methodName)
		end 'target'
	end 'conformanceImplNameOf'

	// Is `actual` a value this target's `Self` formal accepts? The two arms are the two identities a direct
	// dispatch can have — a builtin CONFORMER, compared as conformers so `Byte` and `Integer` agree, and one
	// specific ENUM, compared by name because two enums are two types however alike their tags look.
	function valueSatisfiesConformanceSelf(actual ValueId, target DirectConformanceTarget) returns bool
		match target 'target'
			builtinValue(conformer) then return self.valueIsConformer(actual, conformer: conformer)
			enumTagValue(enumName) then return self.tagOf(actual) == ValueTypeTag.named and self.artifact.typeNames.equalsAt(self.valueNameId(actual), other: enumName)
		end 'target'
	end 'valueSatisfiesConformanceSelf'

	// ⭐ **A `Self`-TYPED FORMAL TAKES A VALUE OF THE RECEIVER'S OWN CONFORMER, AND NOTHING ELSE.**
	// `Equatable.equals` and `Comparable.compare` both declare `other Self`, and each impl reads its second
	// operand the way its OWN receiver is represented: `int.equals(self, other)` compares two RAW i64s, so a
	// String actual would be compared as its heap POINTER and a struct as its box address, while
	// `String.equals` walks bytes off a pointer, so an INT actual would be dereferenced. Both directions are
	// silent wrong answers, which is precisely what `requireGenuineSelfArgs` refuses for the witness-dispatched
	// form; this is the same question asked of a CONCRETE conformer instead of a type parameter.
	//
	// ⚠ It is what makes `builtinConformerOfTag`'s `string` arm load-bearing rather than decorative: the
	// RECEIVER never reaches that classifier (`dispatchMethodOnReceiver` routes a String several arms
	// earlier), but `equals`'s ARGUMENT reaches it here, and without the arm a legal `"ab".equals("ac")`
	// would be refused for handing a String to a `Self` formal.
	//
	// ⚠ **"THE RECEIVER'S OWN CONFORMER" IS THE TARGET'S QUESTION AND NOT THIS ONE'S SINCE enum-hashable** —
	// an ENUM receiver's `Self` is that one enum, not the `int` its granted impls belong to, so admitting by
	// conformer there would compare a `Color` tag against a bare `int` or against another enum's case index.
	// `valueSatisfiesConformanceSelf` holds both readings; this walk owns only WHICH formals are asked.
	//
	// Interface formal `j` is actual `j + BuiltinConformanceReceiverArgs`; arity was checked above.
	function requireBuiltinConformanceSelfArgs(method InterfaceMethodSig, args ValueIdArray, target DirectConformanceTarget, methodTok Token) throws SourceParseError
		for j in 0 upto method.paramTypes.count() 'eachFormal'
			let formalType = try method.paramTypes.get(j) otherwise panic("requireBuiltinConformanceSelfArgs: paramTypes.get OOB at {j} below count {method.paramTypes.count()}")

			if not formalType.isSelf() 'notSelfFormal'
				continue
			end 'notSelfFormal'

			let actual = try args.get(j + BuiltinConformanceReceiverArgs) otherwise panic("requireBuiltinConformanceSelfArgs: args.get OOB at {j + BuiltinConformanceReceiverArgs} below count {args.count()} — the arity check ran first")

			if not self.valueSatisfiesConformanceSelf(actual, target: target) 'notSameConformer'
				throw SourceParseError.builtinOperandType(String.from(method.name), required: String.from(conformanceSelfTypeNameOf(target)), got: self.valueKindWord(actual), line: methodTok.line, column: methodTok.column)
			end 'notSameConformer'
		end 'eachFormal'
	end 'requireBuiltinConformanceSelfArgs'

	// --- Builtin `Array` parsing ---

	// `[a, b, c]` — an array literal. Desugars to `__managed_create(elementSize, 0)` then one `__managed_push` per
	// element, yielding an OWNED `Array`: the instance is the stated head's, else the receiving slot's or the first
	// element's (`unheadedArrayLiteralInstance`). An empty `[]`
	// carries no element to infer a type from and is rejected (use `Array with T` + `.create()`).
	//
	// ⭐ **`element` IS WHERE THE INSTANCE COMES FROM, AND IT IS A PARAMETER RATHER THAN A SECOND ENTRY POINT**
	// (`ArrayLiteralElementSource`). A `<alias> from […]` head states the instance the literal must build;
	// everything downstream of that one decision — the map-literal fork, the constant-blob fork, the element
	// rule, the owned-temp registration — is the same for both spellings, and a second
	// function to hold a different first line would have had to copy all of it.
	function parseArrayLiteral(func IrFunction, element ArrayLiteralElementSource) returns ValueId throws SourceParseError
		// ⭐ **THE RECEIVING SLOT'S ANSWER IS TAKEN HERE AND SPENT AT THE `giid` LINE BELOW.** Taken before a
		// single element is parsed, because an element may itself be a call whose own arguments overwrite the
		// request (`total([f([1, 2]), 3])`); spent past the empty check and the map fork, because `[]` states
		// no elements for a slot to type and `["a": 1]` is not this container at all.
		let slot = self.takeArrayLiteralTargetAt(self.pos)
		let literalStart = self.pos
		let openTok = try self.consume(TokenKind.leftBracket)
		let range = SourceRange.ofToken(openTok)

		if self.at(TokenKind.rightBracket) 'empty'
			throw SourceParseError.unsupported(emptyArrayLiteralMessage(element), line: openTok.line, column: openTok.column)
		end 'empty'

		// A bare int literal needs no path of its own: an all-constant `[10, 20, 30]` takes the machine-word
		// blob path below and creates no record, and the general path infers `integer` from the parsed
		// first element.
		let firstTok = self.current()
		let firstStart = self.pos
		self.stateArrayLiteralElementTargets(element, slot: slot, valueStart: firstStart)
		let first = try self.parseExpression(func, block: self.bodyState.currentBlock)

		// ⭐ **A `:` AFTER THE FIRST ELEMENT MAKES THE WHOLE THING A MAP LITERAL** — `["a": 1, "b": 2]`.
		// The disambiguation is at exactly this point because no bounded LOOKAHEAD can find the colon:
		// because `[f(a, b): 1]` has a `,` at depth 1 first and `[m.get(k): 1]` has an arbitrary
		// expression in front of the `:`. So the first element is parsed unconditionally and the token
		// AFTER it is what decides which container this is.
		//
		// ⚠ It sits ahead of `arrayLiteralInstanceFor` because a map literal has NO array instance to mint: the
		// first element is its first KEY, and the instance it fixes has two columns rather than one.
		//
		// ⚠⚠ **AND IT IS ASKED ONLY WHERE THE ELEMENT TYPE IS STILL OPEN.** A `<alias> from […]` head has already
		// named an `Array` instance, so taking this fork under one would hand the head's caller a `Map` — a
		// silently wrong TYPE rather than a diagnostic. Under a stated head a `:` is simply not part of the
		// literal, and the element rule or the closing `]` refuses it.
		if self.at(TokenKind.colon) and elementSourceIsInferred(element) 'mapLiteral'
			return try self.parseMapLiteralBody(func, firstKey: first, firstKeyTok: firstTok, literalStart: literalStart, range: range)
		end 'mapLiteral'

		if self.valueIsDeferred(first) 'aDeferredFirstElement'
			return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
		end 'aDeferredFirstElement'

		// ⚠ **THE STATED INSTANCE IS TAKEN WITHOUT ASKING THE FIRST ELEMENT AT ALL**, which is the point: under
		// `ByteArray from […]` the first element is a bare `int` constant, and `arrayLiteralInstanceFor` would
		// answer `Array with integer` — the very inference the head exists to override.
		let giid = match element 'elementSource'
			stated(headGiid) gives headGiid
			inferred gives try self.unheadedArrayLiteralInstance(slot, first: first, elemTok: firstTok)
		end 'elementSource'

		if elementSourceIsInferred(element) 'anInferredInstance'
			self.recordInferredInstantiation(giid, at: firstTok)
		end 'anInferredInstance'

		// The first element is ADMITTED into that instance exactly as every `, e` after it is
		// (`admitArrayLiteralElement`) — one element rule, asked of every element including the first.
		let head = try self.admitArrayLiteralElement(first, giid: giid, elemTok: firstTok, valueStart: firstStart)

		// ⭐⭐ **AN INLINE-STORED ELEMENT COLLECTS ITS ELEMENTS BEFORE IT BUILDS ANYTHING**, because if they
		// are all constants the whole literal is ONE `.rdata` blob and there is no record to push into. The
		// element type is settled by the FIRST element alone — it is what fixes `giid` — so the decision is
		// available here, one line before the create this path would otherwise emit.
		//
		// ⭐⭐ **THE GATE IS "DOES THE SLOT OWN ITS OWN BYTES", NOT A WIDTH** (`arrayElementMayBeConstantBlob`),
		// and only a MANAGED or OPAQUE element answers no. It asked "narrower than a machine word" until
		// `codegen-internals`, which excluded `[10, 20, 30]` — the plainest constant array there is, and the
		// one the spec's own sentence and seven `RequiredRdata` cases are written about.
		//
		// ⚠ **THE ADMITTED SET IS WIDER THAN "ENUMS AND PACKED ELEMENTS", AND SAYING SO MATTERS.** A literal
		// whose first element FIXES a narrow ranged alias (`[1 as Percent, 2 as Percent]`) became a `.rdata`
		// blob where it was `__managed_create` + pushes, and every machine-word constant literal has now joined
		// them. ⭐ That drops no CHECK: `pushArrayLiteralElement` applies none a blob would skip — a ranged
		// element's runtime guard rides `parseArraySet`, which a literal never goes through — and the
		// values were already required to be compile-time constants. ⚠ A cast to a NON-packing alias still
		// does not retag the element (`applyCast.castChangesTheElementPacking` mints a `named` result only
		// across the byte/sub-byte boundary), so which instance `[1 as Percent, …]` mints is that predicate's answer, not this
		// gate's.
		if self.signatures.arrayElementMayBeConstantBlob(giid) 'anInlineStoredElement'
			return try self.parseCollectedArrayLiteralBody(func, first: head, firstStart: firstStart, literalStart: literalStart, giid: giid, range: range, restIsConstantRun: self.restIsIntegerLiteralRun() and self.constIsKnown(head) and self.admitIntegerLiteralIntoElementSlot(first, slot: self.elementSlotOf(giid)))
		end 'anInlineStoredElement'

		let arr = try self.emitArrayCreateOp(giid, range: range, sizing: ValueIdArray.create(0))
		try self.pushArrayLiteralElement(arr, elem: head, giid: giid, valueStart: firstStart, range: range)

		return try self.finishArrayLiteral(func, arr: arr, giid: giid, range: range)
	end 'parseArrayLiteral'

	// ⭐⭐ **AN INLINE-STORED LITERAL'S BODY — COLLECTED FIRST, EMITTED ONCE.** Every element is parsed and held, and
	// only at the `]` is it known whether they are ALL compile-time constants:
	//
	//   • **all constant** ⇒ ONE `constArrayLiteral` op over an immortal `.rdata` blob. This is what
	//     `ranged-int-bit-packing`'s three ```RequiredRdata cases pin BYTE-FOR-BYTE — `[0 as Q, 1 as Q,
	//     2 as Q, 3 as Q]` at 2 bits is the single byte `0b11_10_01_00` — which is a claim about the bit
	//     ORDER and the `ceil(count·bits/8)` sizing that no round-tripped value could make; and it is what
	//     `enum-narrow-storage`'s six pin at the BYTE ladder (`u8[] 0, 1, 2`, `i16[] -200, 0, 200`).
	//   • **any element non-constant** ⇒ the ordinary `__managed_create` + one `__managed_push` per element, over the
	//     values already parsed. `specs/bool-bit-packing.md` requires both spellings to reach the identical
	//     representation ("whether built from a constant literal, a NON-CONSTANT literal, or dynamically"),
	//     and they do: the stride is `arrayElementSize`'s single answer either way.
	//
	// ⚠ **THE FALL-BACK COSTS NOTHING IT DID NOT ALREADY COST**, which is why collecting is safe: the values
	// it pushes are the very `ValueId`s parsing produced, in order, so nothing is parsed twice and no op is
	// wasted. What the CONSTANT arm leaves behind is the elements' own `const` materializations, now unused —
	// dead values the blob makes redundant, which the backend drops on the floor because nothing reads them.
	//
	// ⚠ Only an INLINE-STORED element reaches here — never a managed one, whose slot is a pointer to a heap
	// box — so there is no managed move-in to preserve, which is what makes holding the elements across the
	// `]` legitimate at all. `arrayElementMayBeConstantBlob` is where that exclusion is stated.
	function parseCollectedArrayLiteralBody(func IrFunction, first ValueId, firstStart ElementIndex, literalStart ElementIndex, giid GenericInstanceId, range SourceRange, restIsConstantRun bool) returns ValueId throws SourceParseError
		let values = ValueIdArray.create(0)
		let starts = TokenIndexArray.create(0)
		values.push(first)
		starts.push(firstStart)

		while try self.atAnotherLiteralEntry() 'moreElements'
			let parsed = try self.parseArrayLiteralTailElement(func, giid: giid, constantRun: restIsConstantRun)

			if self.valueIsDeferred(parsed.value) 'aDeferredElement'
				return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
			end 'aDeferredElement'

			values.push(parsed.value)
			starts.push(parsed.start)
		end 'moreElements'

		try self.consume(TokenKind.rightBracket)
		try self.requireElementsShareASign(values, starts: starts)

		if self.everyElementIsAKnownConstant(values) 'aConstantBlob'
			let wholeLetInitializer = literalStart == self.bodyState.imagedLetInitializerStart and self.at(TokenKind.newline)
			return self.emitConstantArrayBlob(values, giid: giid, range: range, asImage: wholeLetInitializer)
		end 'aConstantBlob'

		if restIsConstantRun 'aRunThatIsNotConstant'
			panic("Parser.parseCollectedArrayLiteralBody: a run of integer literals converted into '{String.from(self.signatures.instanceDisplayName(giid))}' left a non-constant element — every element of the run is a constant, converted or proven in range")
		end 'aRunThatIsNotConstant'

		let arr = try self.emitArrayCreateOp(giid, range: range, sizing: ValueIdArray.create(0))

		for i in 0 upto values.count() 'eachElement'
			let elem = try values.get(i) otherwise panic("parseCollectedArrayLiteralBody: values.get({i}) failed inside its own upto bound")
			let elemStart = try starts.get(i) otherwise panic("parseCollectedArrayLiteralBody: starts.get({i}) failed — it is pushed in lockstep with values")
			try self.pushArrayLiteralElement(arr, elem: elem, giid: giid, valueStart: elemStart, range: range)
		end 'eachElement'

		self.trackOwnedTemp(arr, exclusivity: OwnedHeapExclusivity.sole)
		self.fileElementColumns(arr, values: values, giid: giid)
		return arr
	end 'parseCollectedArrayLiteralBody'

	// Does the compiler hold every one of these values as an integer constant — the question that decides
	// whether a collected literal becomes a blob or a run of pushes. A `bool` element's `true`/`false` folds
	// to 1/0 through the same constant table, and so does an enum case's TAG (`emitEnumTagLiteral`), which is
	// why one predicate serves every inline-stored element kind.
	function everyElementIsAKnownConstant(values ValueIdArray) returns bool
		for elem in values 'each'
			if not self.constIsKnown(elem) 'notAConstant'
				return false
			end 'notAConstant'
		end 'each'

		return true
	end 'everyElementIsAKnownConstant'

	// ⭐ **SERIALIZE THE CONSTANTS AND EMIT THE ONE OP.** Precondition: `everyElementIsAKnownConstant(values)`
	// and the instance's element stores its own bytes — both settled by the sole caller.
	//
	// The stride the blob is stamped with is the stride its image was serialized at, because both come
	// from the one `constArrayBlobOf` call.
	function emitConstantArrayBlob(values ValueIdArray, giid GenericInstanceId, range SourceRange, asImage bool) returns ValueId
		let constants = FullRangeIntArray.create(values.count(), zeroed: false)

		for elem in values 'each'
			constants.push(self.constOf(elem))
		end 'each'

		let blob = constArrayBlobOf(constants, stride: self.signatures.arrayElementSize(giid))
		let result = self.mintValue(ValueTypeTag.genericInstance, nameId: giid as TypeNameId)

		if asImage 'imageData'
			self.artifact.recordImmortalConstArraySite(ImmortalRecordKind.constBlob)
		end 'imageData'

		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.constArrayLiteral(result, elementSize: blob.stride, elementCount: blob.elementCount, bytes: blob.bytes), range: range)

		if asImage 'frozenImage'
			self.setValueCapability(result, capability: ValueCapability.immutable)
		end 'frozenImage' else 'ownedTemp'
			self.trackOwnedTemp(result, exclusivity: OwnedHeapExclusivity.sole)
			self.markFresh(result)
		end 'ownedTemp'

		if self.arrayInstanceHoldsBareNumbers(giid) 'aBareNumberArray'
			let filed = self.plainConstantArraysForWrite()
			filed.upsert(result, value: constants)
			self.fileElementColumns(result, values: values, giid: giid)
		end 'aBareNumberArray'

		return result
	end 'emitConstantArrayBlob'

	function plainConstantArraysForWrite() returns PlainConstantArrayMap
		match self.bodyState.plainConstantArrays 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = PlainConstantArrayMap.create()
		self.bodyState.plainConstantArrays = PlainConstantArrayTable.entries(fresh)
		return fresh
	end 'plainConstantArraysForWrite'

	function plainConstantArrayElements(value ValueId) returns FullRangeIntArray throws MapError
		match self.bodyState.plainConstantArrays 'column'
			unwritten then throw MapError.keyNotFound
			entries(filed) then return try filed.get(value)
		end 'column'
	end 'plainConstantArrayElements'

	function valueIsAPlainConstantArray(value ValueId) returns bool
		return match self.bodyState.plainConstantArrays 'column'
			unwritten gives false
			entries(filed) gives filed.contains(value)
		end 'column'
	end 'valueIsAPlainConstantArray'

	function freezeLiteralTuple(value ValueId)
		match self.bodyState.lastTupleLiteral 'last'
			none then return
			built(literal, elements) then self.fileFrozenTuple(literal, value: value, elements: elements)
		end 'last'
	end 'freezeLiteralTuple'

	function fileFrozenTuple(literal ValueId, value ValueId, elements ValueIdArray)
		if literal != value 'notTheLiteralJustBuilt'
			return
		end 'notTheLiteralJustBuilt'

		let filed = self.frozenTuplesForWrite()
		filed.upsert(value, value: elements)
	end 'fileFrozenTuple'

	function frozenTuplesForWrite() returns FrozenTupleMap
		match self.bodyState.frozenTuples 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = FrozenTupleMap.create()
		self.bodyState.frozenTuples = FrozenTupleTable.entries(fresh)
		return fresh
	end 'frozenTuplesForWrite'

	function frozenTupleElements(tuple ValueId) returns ValueIdArray throws MapError
		match self.bodyState.frozenTuples 'state'
			unwritten then throw MapError.keyNotFound
			entries(filed) then return try filed.get(tuple)
		end 'state'
	end 'frozenTupleElements'

	function frozenTupleElement(tuple ValueId, index FieldIndex) returns ValueId throws AbsentError
		let elements = try self.frozenTupleElements(tuple) otherwise throw AbsentError.absent
		return try elements.get(index) otherwise throw AbsentError.absent
	end 'frozenTupleElement'

	function noteFrozenTupleFieldRead(read ValueId, tuple ValueId, index FieldIndex)
		if let element = try self.frozenTupleElement(tuple, index: index) 'aFrozenElement'
			self.carryElementKnowledge(read, source: element)
			return
		end 'aFrozenElement'

		let pair = try self.literalColumnsOf(tuple) otherwise return
		self.applyColumnBounds(read, bounds: pair.boundsOf(LiteralColumn.first if index == EntryKeyFieldIndex else LiteralColumn.second))
	end 'noteFrozenTupleFieldRead'

	function literalColumnsForWrite() returns LiteralColumnsMap
		match self.bodyState.literalColumns 'state'
			unwritten then break
			entries(table) then return table
		end 'state'

		let fresh = LiteralColumnsMap.create()
		self.bodyState.literalColumns = LiteralColumnsTable.entries(fresh)
		return fresh
	end 'literalColumnsForWrite'

	function recordLiteralColumns(value ValueId, pair ColumnPair)
		let filed = self.literalColumnsForWrite()
		filed.upsert(value, value: pair)
	end 'recordLiteralColumns'

	function literalColumnsOf(value ValueId) returns ColumnPair throws MapError
		match self.bodyState.literalColumns 'state'
			unwritten then throw MapError.keyNotFound
			entries(filed) then return try filed.get(value)
		end 'state'
	end 'literalColumnsOf'

	function noteColumnSign(signs ColumnSigns, value ValueId) returns ColumnSigns
		if not self.valueIsAnIntegerConstant(value) 'notABareConstant'
			return signs
		end 'notABareConstant'

		if self.valueCarriesAnUnsignedPattern(value) 'anUnsignedLiteral'
			return signs.withUnsigned(self.constOf(value))
		end 'anUnsignedLiteral'

		if self.constOf(value) < 0 'aNegativeLiteral'
			return signs.withNegative(self.constOf(value))
		end 'aNegativeLiteral'

		return signs
	end 'noteColumnSign'

	function requireColumnSignsAgree(signs ColumnSigns, anchor Token) throws SourceParseError
		match signs 'state'
			mixed(negativeValue, unsignedPattern) then throw SourceParseError.literalsShareNoIntegerType(negativeValue, unsignedPattern: unsignedPattern, line: anchor.line, column: anchor.column)
			unseen or
			negative or
			unsigned then return
		end 'state'
	end 'requireColumnSignsAgree'

	function foldColumnSign(signs ColumnSigns, value ValueId, anchor Token) returns ColumnSigns throws SourceParseError
		let folded = self.noteColumnSign(signs, value: value)
		try self.requireColumnSignsAgree(folded, anchor: anchor)
		return folded
	end 'foldColumnSign'

	function requireElementsShareASign(values ValueIdArray, starts TokenIndexArray) throws SourceParseError
		var signs = ColumnSigns.unseen

		for i in 0 upto values.count() 'eachElement'
			let element = try values.get(i) otherwise panic("requireElementsShareASign: values.get({i}) failed inside its own upto bound")
			let start = try starts.get(i) otherwise panic("requireElementsShareASign: starts.get({i}) failed — it is pushed in lockstep with values")
			signs = try self.foldColumnSign(signs, value: element, anchor: self.tokenAt(start))
		end 'eachElement'
	end 'requireElementsShareASign'

	function fileElementColumns(array ValueId, values ValueIdArray, giid GenericInstanceId)
		if not self.arrayInstanceHoldsBareNumbers(giid) 'notBareNumbers'
			return
		end 'notBareNumbers'

		let first = try values.get(0) otherwise return
		var joined = self.boundsOfValue(first)

		for i in 1 upto values.count() 'eachElement'
			let element = try values.get(i) otherwise panic("fileElementColumns: values.get OOB at {i}")
			joined = joined.joinedWith(self.boundsOfValue(element))
		end 'eachElement'

		self.recordLiteralColumns(array, pair: ColumnPair.create(joined, second: ColumnBounds.unknown))
	end 'fileElementColumns'

	function boundsOfValue(value ValueId) returns ColumnBounds
		let tag = self.tagOf(value)

		if tag == ValueTypeTag.integer and self.constIsKnown(value) and self.valueCarriesAnUnsignedPattern(value) 'anUnsignedConstant'
			return columnBoundsOfPoint(self.constOf(value), unsignedPattern: true, isFloat: false)
		end 'anUnsignedConstant'

		if tag == ValueTypeTag.integer and self.valueNameId(value) == UnnamedTypeId and valueIsMarked(self.bodyState.unsignedMaxLiterals, value: value) and not self.constIsKnown(value) 'anUnsignedRead'
			let proven = try provenIntRangeOf(self.bodyState.countedValueRanges, value: value) otherwise return ColumnBounds.unknown
			return ColumnBounds.unsignedIntegers(proven.low, high: proven.high)
		end 'anUnsignedRead'

		if tag == ValueTypeTag.integer 'anInteger'
			let interval = try self.literalIntervalOf(value) otherwise return ColumnBounds.unknown
			return columnBoundsOfWords(interval.lo, high: interval.hi, isFloat: false)
		end 'anInteger'

		if tag == ValueTypeTag.float 'aFloat'
			let range = try self.floatRangeOf(value) otherwise return ColumnBounds.unknown
			return columnBoundsOfWords(range.low, high: range.high, isFloat: true)
		end 'aFloat'

		return ColumnBounds.unknown
	end 'boundsOfValue'

	function applyColumnBounds(read ValueId, bounds ColumnBounds)
		match bounds 'known'
			unknown then return
			integers(low, high) then self.markIntegerBounds(read, low: low, high: high)
			unsignedIntegers(low, high) then self.markUnsignedBounds(read, low: low, high: high)
			floats(low, high) then self.markFloatBounds(read, low: low, high: high)
		end 'known'
	end 'applyColumnBounds'

	function markIntegerBounds(read ValueId, low FullRangeInt, high FullRangeInt)
		if self.tagOf(read) != ValueTypeTag.integer or self.valueNameId(read) != UnnamedTypeId 'notAPlainInteger'
			return
		end 'notAPlainInteger'

		self.markLiteralInterval(read, low: low, high: high)
	end 'markIntegerBounds'

	function markUnsignedBounds(read ValueId, low FullRangeInt, high FullRangeInt)
		if self.tagOf(read) != ValueTypeTag.integer or self.valueNameId(read) != UnnamedTypeId 'notAPlainInteger'
			return
		end 'notAPlainInteger'

		self.recordProvenIntRange(read, low: low if low >= 0 else 0, high: high)
		self.markAboveSignedMax(read)
	end 'markUnsignedBounds'

	function markFloatBounds(read ValueId, low FullRangeInt, high FullRangeInt)
		if self.tagOf(read) != ValueTypeTag.float or self.valueNameId(read) != UnnamedTypeId 'notAPlainFloat'
			return
		end 'notAPlainFloat'

		self.recordFloatRange(read, range: ProvenFloatRange.create(low, high: high))
	end 'markFloatBounds'

	function noteLiteralColumnRead(read ValueId, container ValueId, column LiteralColumn)
		let pair = try self.literalColumnsOf(container) otherwise return
		self.applyColumnBounds(read, bounds: pair.boundsOf(column))
	end 'noteLiteralColumnRead'

	function joinLiteralColumns(phi ValueId, incoming ValueIdArray)
		let first = try incoming.get(0) otherwise return
		var joined = try self.literalColumnsOf(first) otherwise return

		for i in 1 upto incoming.count() 'eachGive'
			let give = try incoming.get(i) otherwise panic("joinLiteralColumns: incoming.get OOB at {i}")
			let next = try self.literalColumnsOf(give) otherwise return
			joined = joined.joinedWith(next)
		end 'eachGive'

		self.recordLiteralColumns(phi, pair: joined)
	end 'joinLiteralColumns'

	function noteCursorRead(result ValueId, pair ColumnPair)
		if self.tagOf(result) == ValueTypeTag.structRef 'anEntry'
			self.recordLiteralColumns(result, pair: pair)
			return
		end 'anEntry'

		self.applyColumnBounds(result, bounds: pair.first)
	end 'noteCursorRead'

	function noteLiteralColumnsCorpusCall(result ValueId, callee ByteArray, args ValueIdArray)
		if args.isEmpty() 'noReceiver'
			return
		end 'noReceiver'

		let receiver = try args.get(0) otherwise panic("noteLiteralColumnsCorpusCall: args.get(0) failed on a non-empty list")
		let pair = try self.literalColumnsOf(receiver) otherwise return

		if qualifiedMemberIs(callee, member: InitMethod) and qualifyingTypeName(callee).equals(FixedArrayBuiltinBaseName) 'aFixedArrayOverTheLiteral'
			self.recordLiteralColumns(result, pair: pair)
			return
		end 'aFixedArrayOverTheLiteral'

		if not self.signatures.declarationIsTheCorpus(callee) 'aUserDeclaration'
			return
		end 'aUserDeclaration'

		if isElementMoveOutName(unqualifiedMemberName(callee)) or qualifiedMemberIs(callee, member: ListLastMethod) 'aStoredElementRead'
			self.applyColumnBounds(result, bounds: pair.first)
		end 'aStoredElementRead' else if qualifiedMemberIs(callee, member: GetMethod) 'aGetRead'
			self.applyColumnBounds(result, bounds: pair.boundsOf(LiteralColumn.second if self.signatures.isMapShapedInstanceAt(self.tagOf(receiver), nameId: self.valueNameId(receiver)) else LiteralColumn.first))
		end 'aGetRead' else if qualifiedMemberIs(callee, member: CursorCurrentMethod) 'aCursorRead'
			self.noteCursorRead(result, pair: pair)
		end 'aCursorRead' else if pair.holdsAKnownColumn() and (qualifiedMemberIs(callee, member: SliceMethod) or qualifiedMemberIs(callee, member: CloneMethodName)) 'aCopyOfTheElements'
			self.recordLiteralColumns(result, pair: pair)
		end 'aCopyOfTheElements' else if qualifiedMemberIs(callee, member: CreateIteratorMethodName) 'aWalkOverTheElements'
			self.recordLiteralColumns(result, pair: pair)
		end 'aWalkOverTheElements'
	end 'noteLiteralColumnsCorpusCall'

	function floatRangeOf(value ValueId) returns ProvenFloatRange throws AbsentError
		if self.tagOf(value) != ValueTypeTag.float or self.valueNameId(value) != UnnamedTypeId 'notAPlainFloat'
			throw AbsentError.absent
		end 'notAPlainFloat'

		if self.floatConstIsKnown(value) 'aConstant'
			return try floatRangeOfPoint(self.floatConstBitsOf(value))
		end 'aConstant'

		return try provenFloatRangeOf(self.bodyState.provenFloatRanges, value: value) otherwise throw AbsentError.absent
	end 'floatRangeOf'

	function valueHasFloatRange(value ValueId) returns bool
		return match self.bodyState.provenFloatRanges 'column'
			unwritten gives false
			entries(proven) gives proven.contains(value)
		end 'column'
	end 'valueHasFloatRange'

	function provenFloatRangesForWrite() returns ProvenFloatRangeMap
		match self.bodyState.provenFloatRanges 'state'
			unwritten then break
			entries(proven) then return proven
		end 'state'

		let fresh = ProvenFloatRangeMap.create()
		self.bodyState.provenFloatRanges = ProvenFloatRangeColumn.entries(fresh)
		return fresh
	end 'provenFloatRangesForWrite'

	function recordFloatRange(value ValueId, range ProvenFloatRange)
		let proven = self.provenFloatRangesForWrite()
		proven.upsert(value, value: range)
	end 'recordFloatRange'

	function recordFloatRangeOfMerge(phi ValueId, incoming ValueIdArray)
		if self.tagOf(phi) != ValueTypeTag.float or self.valueNameId(phi) != UnnamedTypeId 'notAPlainFloat'
			return
		end 'notAPlainFloat'

		let first = try incoming.get(0) otherwise return
		var hull = try self.floatRangeOf(first) otherwise return

		for i in 1 upto incoming.count() 'eachGive'
			let give = try incoming.get(i) otherwise panic("recordFloatRangeOfMerge: incoming.get OOB at {i}")
			let next = try self.floatRangeOf(give) otherwise return
			hull = try floatRangeHull(hull, b: next) otherwise return
		end 'eachGive'

		self.recordFloatRange(phi, range: hull)
	end 'recordFloatRangeOfMerge'

	function recordPromotedIntegerRange(promoted ValueId, source ValueId)
		let interval = try self.literalIntervalOf(source) otherwise return
		let range = try floatRangeOfIntegers(interval.lo, high: interval.hi) otherwise return
		self.recordFloatRange(promoted, range: range)
	end 'recordPromotedIntegerRange'

	function carryElementKnowledge(read ValueId, source ValueId)
		if self.valueNameId(read) != UnnamedTypeId 'aNamedRead'
			return
		end 'aNamedRead'

		if self.tagOf(read) == ValueTypeTag.float and self.floatConstIsKnown(source) 'aFloatConstant'
			self.recordFoldedFloat(read, bits: self.floatConstBitsOf(source))
			return
		end 'aFloatConstant'

		self.applyColumnBounds(read, bounds: self.boundsOfValue(source))
	end 'carryElementKnowledge'

	function noteIdentityPrimitiveClone(result ValueId, callee ByteArray, args ValueIdArray)
		if args.count() != 1 'notUnary'
			return
		end 'notUnary'

		let receiver = try args.get(0) otherwise panic("noteIdentityPrimitiveClone: args.get(0) failed on a one-element list")

		if self.valueNameId(result) != UnnamedTypeId or self.tagOf(result) != self.tagOf(receiver) or not (self.tagOf(result) == ValueTypeTag.integer or self.tagOf(result) == ValueTypeTag.float) 'notTheReceiversShape'
			return
		end 'notTheReceiversShape'

		if not qualifiedMemberIs(callee, member: CloneMethodName) or self.signatures.userDeclaresMember(qualifyingTypeName(callee), member: CloneMethodName) 'notThePrimitiveIdentity'
			return
		end 'notThePrimitiveIdentity'

		self.carryElementKnowledge(result, source: receiver)
	end 'noteIdentityPrimitiveClone'

	function plainConstantArrayAs(value ValueId, declared MaxonType, anchor Token) returns ValueId throws SourceParseError
		if not self.valueIsAPlainConstantArray(value) or maxonTypeTag(declared) != ValueTypeTag.genericInstance 'nothingToRetype'
			return value
		end 'nothingToRetype'

		let target = genericInstanceIdOf(declared)

		if not self.signatures.isArrayInstance(target) or maxonTypeTag(self.signatures.containerElementType(target)) != ValueTypeTag.named 'targetElementNamesNoAlias'
			return value
		end 'targetElementNamesNoAlias'

		let constants = try self.plainConstantArrayElements(value) otherwise panic("plainConstantArrayAs: v{value} was just found in the plain constant array table")
		let elementType = MaxonType.float if tagIsFloat(maxonTypeTag(self.signatures.containerElementType(self.valueInstanceId(value)))) else MaxonType.integer
		let elements = ValueIdArray.create(constants.count(), zeroed: false)

		for constant in constants 'eachConstant'
			let literal = self.emitLiteral(constant, valueType: elementType, range: SourceRange.ofToken(anchor))
			elements.push(try self.admitArrayLiteralElement(literal, giid: target, elemTok: anchor, valueStart: self.pos))
		end 'eachConstant'

		return self.emitConstantArrayBlob(elements, giid: target, range: SourceRange.ofToken(anchor), asImage: false)
	end 'plainConstantArrayAs'

	// The tail a MANAGED or OPAQUE literal takes once its record exists and its first element is pushed: the
	// `, e` elements, the closing `]` and the owned-temp registration. It pushes as it goes
	// rather than collecting, and that is the whole difference from `parseCollectedArrayLiteralBody`: a
	// managed element's move-in is decided from the `[valueStart, self.pos)` window it was written at, which
	// a collect-then-push walk would have already moved past.
	function finishArrayLiteral(func IrFunction, arr ValueId, giid GenericInstanceId, range SourceRange) returns ValueId throws SourceParseError
		while try self.atAnotherLiteralEntry() 'moreElements'
			let parsed = try self.parseArrayLiteralTailElement(func, giid: giid, constantRun: false)

			if self.valueIsDeferred(parsed.value) 'aDeferredElement'
				return try self.deferredLiteralRest(func, entry: LiteralEntryShape.element)
			end 'aDeferredElement'

			try self.pushArrayLiteralElement(arr, elem: parsed.value, giid: giid, valueStart: parsed.start, range: range)
		end 'moreElements'

		try self.consume(TokenKind.rightBracket)

		self.trackOwnedTemp(arr, exclusivity: OwnedHeapExclusivity.sole)
		return arr
	end 'finishArrayLiteral'

	function stateArrayLiteralElementTargets(element ArrayLiteralElementSource, slot DeclaredArrayInstance, valueStart ElementIndex)
		match element 'elementSource'
			stated(headGiid) then self.stateContainerElementLiteralTargets(headGiid, valueStart: valueStart)
			inferred then self.stateSlotElementTargets(slot, valueStart: valueStart)
		end 'elementSource'
	end 'stateArrayLiteralElementTargets'

	function stateSlotElementTargets(slot DeclaredArrayInstance, valueStart ElementIndex)
		match slot 'slot'
			instance(giid) then self.stateContainerElementLiteralTargets(giid, valueStart: valueStart)
			none then self.stateNoElementLiteralTargets(valueStart)
		end 'slot'
	end 'stateSlotElementTargets'

	function stateNoElementLiteralTargets(valueStart ElementIndex)
		self.stateTupleLiteralTargetAt(NoDeclaredTupleTarget, tokenIndex: valueStart)
		self.stateArrayLiteralTargetAt(DeclaredArrayInstance.none, tokenIndex: valueStart)
	end 'stateNoElementLiteralTargets'

	// One element after the first, and its type match against the literal's instance: the one home of
	// the element rule, shared by `finishArrayLiteral` (which pushes what it gets) and
	// `parseCollectedArrayLiteralBody` (which collects it). The separator is
	// `atAnotherLiteralEntry`'s.
	function parseArrayLiteralTailElement(func IrFunction, giid GenericInstanceId, constantRun bool) returns ArrayLiteralElement throws SourceParseError
		let elemTok = self.current()
		let elemStart = self.pos

		if not constantRun 'aLiteralTargetIsOnOffer'
			self.stateContainerElementLiteralTargets(giid, valueStart: elemStart)
		end 'aLiteralTargetIsOnOffer'

		let elem = try self.parseExpression(func, block: self.bodyState.currentBlock)

		if self.valueIsDeferred(elem) 'aDeferredElement'
			return ArrayLiteralElement.create(elem, start: elemStart)
		end 'aDeferredElement'

		if constantRun and self.admitIntegerLiteralIntoElementSlot(elem, slot: self.elementSlotOf(giid)) 'provenInRange'
			return ArrayLiteralElement.create(elem, start: elemStart)
		end 'provenInRange'

		return ArrayLiteralElement.create(try self.admitArrayLiteralElement(elem, giid: giid, elemTok: elemTok, valueStart: elemStart), start: elemStart)
	end 'parseArrayLiteralTailElement'

	// Bare literals only, so no element of a run is negative: a run skips the element conversion, and
	// `requireElementsShareASign` sees the same signs either way only because of that.
	function restIsIntegerLiteralRun() returns bool
		var q = self.pos

		while self.kindAt(q) == TokenKind.comma 'eachEntry'
			if self.kindAt(q + 1) != TokenKind.intLiteral 'notALiteralEntry'
				return false
			end 'notALiteralEntry'

			q = q + 2
		end 'eachEntry'

		return self.kindAt(q) == TokenKind.rightBracket
	end 'restIsIntegerLiteralRun'

	// A literal the slot provably holds is stored unconverted: `InsertRangeChecks` drops an in-range
	// literal's site, so the conversion would add nothing.
	function admitIntegerLiteralIntoElementSlot(value ValueId, slot ElementSlot) returns bool
		if not self.valueIsAnIntegerConstant(value) 'notAnIntegerConstant'
			return false
		end 'notAnIntegerConstant'

		return match slot.alias 'alias'
			declared(ranged) gives self.admitIntegerLiteralIntoAlias(value, alias: ranged)
			undeclared gives maxonTypeTag(slot.declared) == ValueTypeTag.integer and not self.valueIsAboveSignedMax(value)
		end 'alias'
	end 'admitIntegerLiteralIntoElementSlot'

	function admitIntegerLiteralIntoAlias(value ValueId, alias RangedTypeAlias) returns bool
		if aliasIsFloat(alias) or not self.edgeProvesAlias(value, alias: alias) 'notProvenInside'
			return false
		end 'notProvenInside'

		self.admitUnsignedLiteral(value)
		return true
	end 'admitIntegerLiteralIntoAlias'

	function valueIsAnIntegerConstant(value ValueId) returns bool
		return self.tagOf(value) == ValueTypeTag.integer and self.valueNameId(value) == UnnamedTypeId and self.constIsKnown(value)
	end 'valueIsAnIntegerConstant'

	function valueIsAboveSignedMax(value ValueId) returns bool
		return valueIsMarked(self.bodyState.unsignedMaxLiterals, value: value)
	end 'valueIsAboveSignedMax'

	// ⭐⭐ **ONE ELEMENT ADMITTED INTO THE LITERAL'S INSTANCE** — the door the FIRST element and every `, e`
	// after it both go through, so a literal cannot come to have two element rules.
	//
	// ⭐⭐ **IT CONVERTS WHENEVER THE ELEMENT'S STORAGE DIFFERS FROM THE INSTANCE'S SLOT — under a stated head
	// AND under an inferred one.** The gate is `storageDiffersFromAlias`: *would this value be stored
	// structurally false for a bare `[…]`.
	//
	// ⚠ **`[10 as Byte, 20]` IS THE CASE THAT DISPROVES IT, AND IT IS ACCEPTED DELIBERATELY.** Element
	// 1 is renamed to `Byte` by its own `as` (`mayRetypeForNarrowerStorage`), so the literal mints an
	// `Array with Byte`; element 2 is a bare `20` at a machine word against a one-byte slot, so it
	// DOES convert here. Refusing it would be stricter than the language: the program answers 20. The rule is the instance's slot, not the spelling of the head.
	//
	// ⭐ **A STATED HEAD IS THE CASE WHERE IT IS TRUE, AND WHAT IT DOES THEN IS THE `as <element>` THE SOURCE
	// DID NOT HAVE TO WRITE.** `ByteArray from [10, 20, 30]` hands over three bare `int` constants at a
	// machine word each against an instance that stores one byte each, so each is converted through
	// `convertValueToDeclaredType` — the same conversion `[10 as Byte, 20 as Byte, 30 as Byte]` performs, and
	// deliberately the same one, because the two spellings must reach the identical `i8[] 10, 20, 30` blob
	// (`specs/codegen-internals.md` pins both).
	//
	// ⚠ **THE KIND GATE IS NOT OPTIONAL AND IS ASKED BEFORE THE CONVERSION.** A String value against a stated
	// `Byte` element also answers the stride question TRUE (a String denotes no ranged alias, so it reads as a
	// full machine word), and the re-tag would have stamped `Byte` onto a heap POINTER — a silent wrong
	// answer. `requireCastKindsConvert` is the existing E3009 for it and needs no new sentence. (The runnable
	// oracle has no answer here to match: `ByteArray from ["a", "b"]` crashes it with an internal E9001.)
	function admitArrayLiteralElement(value ValueId, giid GenericInstanceId, elemTok Token, valueStart ElementIndex) returns ValueId throws SourceParseError
		let slot = self.elementSlotOf(giid)

		if self.valueIsPromise(value) and typeIsPromiseStorage(self.signatures, t: slot.declared) 'aPromiseElement'
			return try self.storedPromiseValue(value, storage: genericInstanceIdOf(slot.declared), anchor: elemTok, range: SourceRange.ofToken(elemTok))
		end 'aPromiseElement'

		// Asked before the conversion, which retags a number of another alias into the slot's alias and so
		// leaves two equal names to compare.
		if tagIsIntegral(self.tagOf(value)) or tagIsFloat(self.tagOf(value)) 'aNumberCarriesItsOwnIdentity'
			try self.requireElementIdentity(giid, slot: slot, value: value, site: ContainerElementSite.literalElement(elemTok))
		end 'aNumberCarriesItsOwnIdentity'

		// ⚠ **THE ELEMENT TYPE HAS TO BE RE-SPELLED IN THIS FILE'S INTERNER BEFORE ANY DOOR BELOW SEES IT.**
		// The instance's argument was interned by `ProgramSignatures`, and every step from here mints or reads
		// a `named` id against the FILE's table — `castTargetTag` resolves one, `emitRetaggedCastValue` stamps
		// one onto the value it mints. It is always a `named` type where the conversion runs, because
		// `elementMustBeConvertedInto` answers false for a target that declares no ranged alias.
		//
		// ⛔ **NO CONVERSION GUARD IS SPELLED HERE, AND THAT IS THE POINT.** The conversion's three
		// legality guards live inside `convertValueToDeclaredType`, so reaching the conversion grants all of
		// them; a guard re-spelled here, such as `requireCastKindsConvert`, would grant one and drop the enum
		// refusal that keeps `ByteArray from [Color.red, …]` out.
		let converted = try self.convertedArrayLiteralElement(value, slot: slot, giid: giid, elemTok: elemTok, valueStart: valueStart)
		let fitted = try self.requireElementFitsSlot(giid, slot: slot, value: converted, valueStart: valueStart, site: ContainerElementSite.literalElement(elemTok))
		try self.admitInstanceArgStore(self.bodyFunction(), giid: giid, position: ContainerElementArgPosition, value: value, valueStart: valueStart, place: ArrayLiteralElementPlace)

		return fitted
	end 'admitArrayLiteralElement'

	// The element itself, converted into the instance's element type when it is not already that type and
	// handed straight back when it is. Split from the `requireElementFitsSlot` call above so that call is
	// written ONCE for both arms — calling it in each arm is one question asked from two places.
	function convertedArrayLiteralElement(value ValueId, slot ElementSlot, giid GenericInstanceId, elemTok Token, valueStart ElementIndex) returns ValueId throws SourceParseError
		if not (try self.elementMustBeConvertedInto(value, giid: giid, targetAlias: slot.alias, elemTok: elemTok)) 'alreadyThisInstancesElement'
			return value
		end 'alreadyThisInstancesElement'

		let elementType = MaxonType.named(self.artifact.typeNames.intern(self.signatures.indexSpaceTypeName(slot.indexSpaceType)))
		return try self.convertValueToDeclaredType(value, sourceTag: self.tagOf(value), targetType: elementType, targetAlias: slot.alias, opTok: elemTok, sourceIsBareLocal: self.rhsWasBareLocalReference(valueStart), mustCarryTargetType: true)
	end 'convertedArrayLiteralElement'

	// ⭐⭐ **MUST THIS ELEMENT STILL BE MADE INTO THE INSTANCE'S ELEMENT TYPE? — TWO QUESTIONS, AND NEITHER
	// SUBSUMES THE OTHER.** Both send the element through `convertValueToDeclaredType`, which is where the
	// range guard and the retag live, so missing either one loses a check:
	//
	//   • **STORAGE** (`storageDiffersFromAlias`) — would this value occupy the slot differently? It reads the
	//     value's PROVEN alias, so `[s + 1, s + 2]` over a one-byte `Small` converts even though the elements
	//     WEAR `Small`: they merely adopted the name and 256 would be stored as 0.
	//   • **IDENTITY** — is this value already the slot's element type at all? It reads the DECLARED type, so
	//     it sees what the stride cannot.
	//
	// ⛔⛔ **THE TWO ANSWERS DIVERGE FOR EVERY 8-BYTE RANGED ALIAS.** `int(0 to i64.max)` — stdlib's own
	// `ElementIndex`, `FileSize`, `DurationMs`, `Count` — occupies a machine word exactly as a bare `int`
	// does, so the storage question alone answers NO and the element keeps its `integer` tag. Skipping the
	// conversion skips its RANGE CHECK too, so `[-1]` would reach an `int(0 to u64.max)` slot with no
	// diagnostic at all.
	//
	// ⚠ **A SLOT WHOSE ELEMENT DECLARES NO RANGED ALIAS HAS NOTHING TO CONVERT INTO** — a `String`, a struct,
	// an enum or a nested container element is the type it is, and a value of another type there is
	// `requireElementFitsSlot`'s to refuse. It is also what keeps the `named` spelling in the conversion correct: the conversion
	// runs only where the element type IS a declared alias name.
	//
	// ⚠ **A FUNCTION VALUE IS COMPARED BY SHAPE, NOT CONVERTED** — `requireElementFitsSlot` records a
	// function-type door for it, where converting one into a ranged int slot would refuse `[double, triple]` with a cast diagnostic.
	function elementMustBeConvertedInto(value ValueId, giid GenericInstanceId, targetAlias DeclaredAlias, elemTok Token) returns bool throws SourceParseError
		if self.storageDiffersFromAlias(value, targetAlias: targetAlias) 'wouldOccupyTheSlotDifferently'
			return true
		end 'wouldOccupyTheSlotDifferently'

		return match targetAlias 'a'
			undeclared gives false
			declared gives self.tagOf(value) != ValueTypeTag.function and (try self.arrayLiteralInstanceFor(value, elemTok: elemTok)) != giid
		end 'a'
	end 'elementMustBeConvertedInto'

	// Push one already-parsed array-literal element, moving a managed element in (the array owns it; a trivial
	// element passes through) — `moveElementIntoContainer` off the value's start position so a bare local is poisoned.
	function pushArrayLiteralElement(arr ValueId, elem ValueId, giid GenericInstanceId, valueStart ElementIndex, range SourceRange) throws SourceParseError
		self.emitArrayPush(arr, element: try self.moveElementIntoContainer(elem, giid: giid, valueStart: valueStart, destination: ElementStoreDestination.none), range: range)
	end 'pushArrayLiteralElement'

	// THE `__managed_push` of an array being BUILT, over an element whose ownership has already been settled.
	// Its two callers settle that in different ways and so cannot share the step before it: a literal's
	// element is decided from the SOURCE TOKENS it was written at (`moveElementIntoContainer`), while a
	// synthesized case-name element (`emitEnumAllCaseNames`) was written at no tokens at all. The store
	// itself is one fact, so it is written once.
	//
	// ⚠ Distinct from the user's own `arr.push(x)`, which is `emitArrayVoidCall` — that form hands the
	// RECEIVER back as "what the statement still denotes", where a build step's result is nobody's.
	function emitArrayPush(arr ValueId, element ValueId, range SourceRange)
		_ = self.emitRuntimeCall(ManagedPushName, args: twoArgs(arr, second: element), resultTag: ValueTypeTag.void, resultNameId: UnnamedTypeId, range: range)
	end 'emitArrayPush'

	// The `Array with T` instance a literal's FIRST element fixes — an integer element → the
	// int instance, a String → `Array with String`, a struct/boxed-union → `Array with <name>`. All are
	// interned by the sweep (`internBuiltinIntegerInstance` / `internLiteralContainerInstances`), so this is a
	// pure lookup. A function/other element is not a supported literal element yet (E2015).
	//
	// ⭐ **`bool` AND `float` ARE ADMITTED ELEMENT TYPES.** `/specs/fixed-array.md` writes
	// `FixedArray from [true, false, …]` and `FixedArray from [1.5, 2.5]`, and a `FixedArray from […]` builds its record
	// through THIS literal. `bool` needs nothing but this arm (its slot is one byte by `trivialElementSlot`,
	// and `Array with bool` built through `BArr.create()` + `push` works); `float` needs the element-word
	// bitcast (`containerElementWord` / `containerSlotValueType`).
	//
	// A NAMED float array is `Array with Real`: `checkGenericArgType`'s `inlineElement` exemption admits a
	// float alias as a buffer element, and a bare `Array with float` is E2061 there.
	//
	// ⭐ **A CAST TO A PACKING ALIAS ARRIVES HERE AS A `named` TAG, AND THAT IS WHY THIS DOOR NEEDS NO ARM
	// OF ITS OWN FOR IT.** `[0 as Q, 1 as Q, 2 as Q, 3 as Q]` is an `Array with Q`, not an `Array with int`
	// — and it reaches the `aggregate` arm below unchanged, because `applyCast.castChangesTheElementPacking`
	// MINTS a `named`-tagged result for a cast that moves an element between the byte and sub-byte ladders.
	// ⚠ A cast that merely narrows the BYTE width does NOT retag — see that predicate's ⛔⛔ block for the two
	// programs the wider rule broke.
	// Reading the tag is therefore complete. ⚠ Asking `recordedCastAlias` here instead is WRONG:
	// `finishCast` withholds that record for a bare-local source, so it would answer differently for
	// `[7 as N, …]` and `[v as N, …]`.
	function arrayLiteralInstanceFor(elem ValueId, elemTok Token) returns GenericInstanceId throws SourceParseError
		return self.signatures.builtinInstanceForElement(self.signatures.arrayRecordBaseName(), element: try self.literalColumnTypeFor(elem, literalKind: ArrayLiteralSubject, columnNoun: ContainerElementColumnNoun, valueTok: elemTok))
	end 'arrayLiteralInstanceFor'

	// ⭐⭐ **THE INSTANCE A LITERAL WITH NO `from` HEAD BUILDS — THE RECEIVING SLOT'S WHEN ONE STATED IT, ELSE
	// THE ONE ITS FIRST ELEMENT FIXES.** The slot answers because the slot is what the value has to BE:
	// `[1, 2, 3]` written at an `Array with Count` parameter is that array, exactly as the bare `1` written at
	// a `Count` parameter is that int and `xs.push(1)` stores one. Typed by its own spelling instead, the
	// literal is an `Array with int` that no narrower element type accepts — an inconsistency in the language
	// rather than a rule about ranges.
	//
	// ⭐⭐ **AND THE SLOT ANSWERS ONLY FOR AN ELEMENT COLUMN THE COMPILER ITSELF INFERRED**
	// (`arrayElementMayBeRestated`) — a literal of `Octet`s or of `String`s names its own element type,
	// and restating one would overrule the source. Those keep the instance they infer and so keep the
	// positioned argument refusal they earn. A literal of ARRAYS is restated only when its element is
	// already the instance the slot's element names.
	//
	// ⭐ **IT WIDENS NOTHING FOR THE COLUMN IT DOES ANSWER: EVERY ELEMENT IS STILL ADMITTED AGAINST THE
	// INSTANCE** by the element rule a `from` head already goes through (`admitArrayLiteralElement`), so a
	// value outside the slot's range is refused with its own bound quoted.
	function unheadedArrayLiteralInstance(slot DeclaredArrayInstance, first ValueId, elemTok Token) returns GenericInstanceId throws SourceParseError
		let own = try self.arrayLiteralInstanceFor(first, elemTok: elemTok)
		return match slot 'slot'
			instance(giid) gives giid if self.signatures.arrayElementMayBeRestated(giid, got: own) else own
			none gives own
		end 'slot'
	end 'unheadedArrayLiteralInstance'

	// ⭐ **THE SLOT'S ANSWER FOR THE LITERAL OPENING AT `openIndex` — TAKEN, so one request serves one
	// literal.** A request that names another token belongs to an enclosing position.
	function takeArrayLiteralTargetAt(openIndex ElementIndex) returns DeclaredArrayInstance
		let pending = self.pendingArrayLiteralTargetAt(openIndex)
		self.statement.arrayLiteralTarget = DeclaredArrayInstance.none
		return pending
	end 'takeArrayLiteralTargetAt'

	// ⭐ **THE STANDING REQUEST, READ WITHOUT SPENDING IT** — what a TERNARY needs, because its two arms are
	// one value in one slot and the arm that parses first would otherwise take the answer away from the other
	// (`parseTernaryExpression` re-issues it at the false arm's own token).
	//
	// ⚠ **THE INSTANCE COLUMN IS WHAT SAYS "NOTHING PENDING", NEVER THE INDEX.** Token 0 is a real position and
	// instance 0 is a real instance, so only `DeclaredArrayInstance.none` can say it.
	function pendingArrayLiteralTargetAt(index ElementIndex) returns DeclaredArrayInstance
		if self.statement.arrayLiteralTargetTokenIndex != index 'noRequestForThisToken'
			return DeclaredArrayInstance.none
		end 'noRequestForThisToken'

		return self.statement.arrayLiteralTarget
	end 'pendingArrayLiteralTargetAt'

	// ⭐⭐ **DOES THIS ARGUMENT POSITION STATE THE INSTANCE A LITERAL WRITTEN AT IT MUST BUILD?** Asked BEFORE
	// the value is parsed, for `argumentPassingAt`'s reason: the answer changes what the parse has to
	// PRODUCE — an `int(0 to 1000)` element strides 2 bytes where a bare `int` strides 8 — and a record
	// already emitted cannot be re-strided into the slot.
	//
	// ⚠ **THE STATE IS WRITTEN UNCONDITIONALLY AND THE `[` TEST GATES ONLY THE LOOKUP.** A request no literal
	// took must not outlive its argument, which is `cellArgumentToken`'s discipline; and the lookup
	// behind it walks the callee's declarations, while every argument of every call in the program
	// passes this line.
	function stateLiteralTargetForArgument(target CallArgTarget, sourceIndex ParamCount, label ByteArray, valueStart ElementIndex, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance)
		self.stateArrayLiteralTargetAt(self.arrayTargetForArgument(target, sourceIndex: sourceIndex, label: label, valueStart: valueStart, args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance), tokenIndex: valueStart)
		self.stateTupleLiteralTargetAt(self.tupleTargetForArgument(target, sourceIndex: sourceIndex, label: label, valueStart: valueStart, args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance), tokenIndex: valueStart)
	end 'stateLiteralTargetForArgument'

	function arrayTargetForArgument(target CallArgTarget, sourceIndex ParamCount, label ByteArray, valueStart ElementIndex, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns DeclaredArrayInstance
		if self.kindAt(valueStart) != TokenKind.leftBracket 'noLiteralToType'
			return DeclaredArrayInstance.none
		end 'noLiteralToType'

		let callee = try target.declaredName() otherwise return DeclaredArrayInstance.none
		let instance = try self.callInstanceOf(args, receiverArgs: receiverArgs, constructorInstance: constructorInstance) otherwise return self.signatures.arrayInstanceDeclaredAtParam(callee, sourceIndex: sourceIndex, label: label, readerFilePath: self.job.path)
		return self.signatures.arrayInstanceDeclaredAtParamOfReceiver(callee, sourceIndex: sourceIndex, label: label, receiver: instance, readerFilePath: self.job.path)
	end 'arrayTargetForArgument'

	function callReceiverInstance(args ValueIdArray, receiverArgs ParamCount) returns GenericInstanceId throws AbsentError
		if receiverArgs == 0 'noReceiver'
			throw AbsentError.absent
		end 'noReceiver'

		let receiver = try args.get(0) otherwise panic("callReceiverInstance: a call with a prepended receiver holds it at argument 0")

		if self.tagOf(receiver) != ValueTypeTag.genericInstance 'notAConcreteInstance'
			throw AbsentError.absent
		end 'notAConcreteInstance'

		return self.valueInstanceId(receiver)
	end 'callReceiverInstance'

	function tupleTargetForArgument(target CallArgTarget, sourceIndex ParamCount, label ByteArray, valueStart ElementIndex, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns DeclaredTupleTarget
		if self.kindAt(valueStart) != TokenKind.leftParen 'noLiteralToType'
			return NoDeclaredTupleTarget
		end 'noLiteralToType'

		let callee = try target.declaredName() otherwise return NoDeclaredTupleTarget

		if let instance = try self.callInstanceOf(args, receiverArgs: receiverArgs, constructorInstance: constructorInstance) 'declaredThroughTheCallsInstance'
			let named = try self.signatures.tupleTypeNameDeclaredAtParamOfReceiver(callee, sourceIndex: sourceIndex, label: label, receiver: instance, readerFilePath: self.job.path) otherwise return NoDeclaredTupleTarget
			return tupleTargetNamed(named)
		end 'declaredThroughTheCallsInstance'

		let name = try self.signatures.tupleTypeNameDeclaredAtParam(callee, sourceIndex: sourceIndex, label: label, readerFilePath: self.job.path) otherwise return NoDeclaredTupleTarget
		return tupleTargetNamed(name)
	end 'tupleTargetForArgument'

	function callInstanceOf(args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns GenericInstanceId throws AbsentError
		match constructorInstance 'constructed'
			instance(id) then return id
			none then return try self.callReceiverInstance(args, receiverArgs: receiverArgs)
		end 'constructed'
	end 'callInstanceOf'

	// ⭐⭐ **WHAT A CLOSURE LITERAL WRITTEN AT THIS ARGUMENT MAY TAKE ITS PARAMETER TYPES FROM** — asked before the
	// value is parsed for `stateLiteralTargetForArgument`'s reason: a closure's parameter types decide
	// how its body parses. Only an argument that OPENS with `function` pays the lookup, and it answers
	// whether it stated an offer, so the argument loop clears exactly the offers it made.
	function stateClosureParamOfferForArgument(target CallArgTarget, sourceIndex ParamCount, label ByteArray, valueStart ElementIndex, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns bool
		if not self.argumentOpensAClosure(valueStart) 'noClosureLiteral'
			return false
		end 'noClosureLiteral'

		self.stateClosureParamOfferAt(valueStart, offer: self.closureParamOfferAt(target, sourceIndex: sourceIndex, label: label, args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance))
		return true
	end 'stateClosureParamOfferForArgument'

	function argumentOpensAClosure(valueStart ElementIndex) returns bool
		return self.kindAt(valueStart) == TokenKind.function
	end 'argumentOpensAClosure'

	function stateClosureParamOfferAt(valueStart ElementIndex, offer ClosureParamOffer)
		self.statement.pendingClosureParamOffer = PendingClosureParamOffer.at(valueStart, offer: offer)
	end 'stateClosureParamOfferAt'

	// The offer stated for the argument opening at `index`, taken — so a closure literal nested in this one's body,
	// which opens at another token, sees none.
	function takeClosureParamOfferAt(index ElementIndex) returns ClosureParamOffer
		match self.statement.pendingClosureParamOffer 'pending'
			none then return noClosureParamOffer
			at(tokenIndex, offer) then return self.takenClosureParamOffer(offer, tokenIndex: tokenIndex, index: index)
		end 'pending'
	end 'takeClosureParamOfferAt'

	function takenClosureParamOffer(offer ClosureParamOffer, tokenIndex ElementIndex, index ElementIndex) returns ClosureParamOffer
		if tokenIndex != index 'notThisArgumentsLiteral'
			return noClosureParamOffer
		end 'notThisArgumentsLiteral'

		self.statement.pendingClosureParamOffer = PendingClosureParamOffer.none
		return offer
	end 'takenClosureParamOffer'

	// ⭐⭐ **THE PARAMETER TYPES THE CALLEE DECLARES FOR A CLOSURE AT ONE ARGUMENT.** Read off the whole-program
	// index, because the callee may be declared in any file: the declaration of the name names its slot's type,
	// and a slot declared with a function typealias offers that alias's parameter types — the sweep's reading,
	// repaired from the alias's own file and fixed through the call's instance (the receiver's, or the one a
	// constructor or generic-alias static call builds), so `SortComparator`'s `Element` is the receiver's element.
	//
	// ⛔ **THE OFFER IS ONLY WHAT THE NAMEABLE DECLARATION STATES.** The declaration is `declarationNameableHere`'s.
	// A declaration with no slot for this argument, or whose slot is a concrete type no closure is, offers
	// nothing, and so does a slot this door cannot judge — one the sweep did not read, or a type parameter the
	// call's instance does not fix: the untyped parameter is then E2015, never a type taken from a declaration the call
	// may not resolve to.
	function closureParamOfferAt(target CallArgTarget, sourceIndex ParamCount, label ByteArray, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns ClosureParamOffer
		if not self.signatures.allFilesFolded 'theAliasRegistriesAreStillFilling'
			return noClosureParamOffer
		end 'theAliasRegistriesAreStillFilling'

		let callee = try target.declaredName() otherwise return noClosureParamOffer
		let candidate = try self.declarationNameableHere(callee) otherwise return noClosureParamOffer
		let slot = try argSlotPosition(candidate.paramNames, argIndex: sourceIndex, label: label) otherwise return noClosureParamOffer
		let swept = try candidate.paramTypes.get(slot) otherwise panic("closureParamOfferAt: paramTypes.get OOB at {slot} — the sweep records one type per parameter name")
		let slotType = self.slotTypeThroughCallReceiver(self.repairSweptType(self.signatures.adoptType(swept, into: self.artifact.typeNames), scopeFilePath: candidate.declFilePath), args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance, scopeFilePath: candidate.declFilePath)

		if maxonTypeTag(slotType) != ValueTypeTag.function 'noClosureStandsHere'
			return noClosureParamOffer
		end 'noClosureStandsHere'

		let aliasName = self.functionAliasKeyFor(self.internedName(typeNameIdOf(slotType)), callee: callee, declFilePath: candidate.declFilePath)

		if not self.namesADeclaredFunctionAlias(aliasName) 'aFunctionTypeNoAliasGoverns'
			return noClosureParamOffer
		end 'aFunctionTypeNoAliasGoverns'

		return self.offeredClosureParamTypesOf(aliasName, readerFilePath: candidate.declFilePath, origin: ReceiverOrigin.derivedFrom(singleName(genericTemplateName(callee))), args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance)
	end 'closureParamOfferAt'

	function offeredClosureParamTypesOf(offeredAlias ByteArray, readerFilePath FilePath, origin ReceiverOrigin, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns ClosureParamOffer
		match self.functionAliasMeantFrom(offeredAlias, readerFilePath: readerFilePath) 'alias'
			declared(alias) then return self.offeredClosureParamTypes(alias, aliasName: offeredAlias, origin: origin, args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance)
			undeclared then panic("closureParamOfferAt: '{String.from(offeredAlias)}' was offered only after `namesADeclaredFunctionAlias` found it declared")
		end 'alias'
	end 'offeredClosureParamTypesOf'

	function namesADeclaredFunctionAlias(name ByteArray) returns bool
		return match self.functionAliasForName(name) 'alias'
			declared gives true
			undeclared gives false
		end 'alias'
	end 'namesADeclaredFunctionAlias'

	// ⭐ **A METHOD'S SLOT NAMES ITS DECLARING BODY'S OWN NESTED ALIAS FIRST** — `parseTypeReference`'s in-body
	// rule, read from the callee's qualifier because the cursor is not in that body. An `extension Iterable` is
	// folded once per conformer and each fold files its `ElementTransform` under `<Conformer>.ElementTransform`;
	// the bare key holds whichever fold ran last.
	function functionAliasKeyFor(aliasName ByteArray, callee ByteArray, declFilePath FilePath) returns immutable ByteArray
		let nested = try self.signatures.aliasNestedInDeclaringTypeOf(callee, aliasName: aliasName, declFilePath: declFilePath) otherwise return aliasName
		return nested if self.signatures.isFunctionAliasInAnyFile(nested) else aliasName
	end 'functionAliasKeyFor'

	// The offer itself: one type per parameter of `alias`, each rebuilt into this file's interner, repaired from the
	// alias's declaring file and fixed through the call's instance. A parameter type still naming a type parameter this
	// body does not declare — bare, or as a type argument (`Array with T`) — would type the closure against a
	// binding nothing here supplies, so it withholds.
	function offeredClosureParamTypes(alias FunctionTypeAlias, aliasName ByteArray, origin ReceiverOrigin, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance) returns ClosureParamOffer
		let paramTypes = MaxonTypeArray.create(alias.paramTypes.count(), zeroed: false)

		for param in alias.paramTypes 'eachParam'
			let stored = maxonTypeOfStoredAliasParam(param, typeNames: self.artifact.typeNames)
			let offered = self.slotTypeThroughCallReceiver(self.repairSweptType(stored, scopeFilePath: alias.declFilePath), args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance, scopeFilePath: alias.declFilePath)

			if self.namesTypeParameterOutOfScope(offered) 'anUnboundTypeParameter'
				return noClosureParamOffer
			end 'anUnboundTypeParameter'

			if self.typeNamesAnInterface(offered) 'aParameterTheAliasRefuses'
				return ClosureParamOffer.deferred
			end 'aParameterTheAliasRefuses'

			paramTypes.push(offered)
		end 'eachParam'

		let result = match maxonTypeOfStoredAliasReturn(alias, typeNames: self.artifact.typeNames) 'declaredReturn'
			void gives ClosureResult.inferred
			value(inner) gives self.declaredClosureResult(self.slotTypeThroughCallReceiver(self.repairSweptType(inner, scopeFilePath: alias.declFilePath), args: args, receiverArgs: receiverArgs, constructorInstance: constructorInstance, scopeFilePath: alias.declFilePath), offeredAlias: self.signatures.declaredIdentityOfSpelling(alias.name, declFilePath: alias.declFilePath), origin: origin)
		end 'declaredReturn'

		return ClosureParamOffer.offered(paramTypes, result: result, aliasName: aliasName)
	end 'offeredClosureParamTypes'

	function declaredClosureResult(declared MaxonType, offeredAlias ByteArray, origin ReceiverOrigin) returns ClosureResult
		if tagIsUnresolved(maxonTypeTag(declared)) or self.namesTypeParameterOutOfScope(declared) 'nothingThisBodyCanHold'
			return ClosureResult.inferred
		end 'nothingThisBodyCanHold'

		return ClosureResult.declared(declared, offeredAlias: offeredAlias, origin: origin.clone())
	end 'declaredClosureResult'

	// A slot declared in a shared generic body, read through this call's instance when it has one: the
	// receiver's, else the constructed one.
	function slotTypeThroughCallReceiver(declared MaxonType, args ValueIdArray, receiverArgs ParamCount, constructorInstance ConstructorInstance, scopeFilePath FilePath) returns MaxonType
		let instance = try self.callInstanceOf(args, receiverArgs: receiverArgs, constructorInstance: constructorInstance) otherwise return declared
		return self.functionSlotThroughInstance(declared, gid: instance, scopeFilePath: scopeFilePath)
	end 'slotTypeThroughCallReceiver'

	// Does `t` name, at any depth of its type arguments, a type parameter the enclosing declaration does not
	// declare? A type argument written as a generic alias's name is read as the instance it denotes. The
	// walk ends on an instance already open on it: a cyclic alias reaches this before E3091 refuses it.
	function namesTypeParameterOutOfScope(t MaxonType, open GenericInstanceIdArray = GenericInstanceIdArray.create(0)) returns bool
		let tag = maxonTypeTag(t)

		if tag == ValueTypeTag.typeParameter 'aTypeParameter'
			return not self.typeParameterIsInScope(typeParamIdOf(t))
		end 'aTypeParameter'

		if tag != ValueTypeTag.genericInstance 'aLeaf'
			return false
		end 'aLeaf'

		let id = genericInstanceIdOf(t)

		for earlier in open 'eachOpenInstance'
			if earlier == id 'revisited'
				return false
			end 'revisited'
		end 'eachOpenInstance'

		open.push(id)
		var unbound = false

		for position in 0 upto self.signatures.genericInstanceArgCount(id) 'eachTypeArgument'
			if self.namesTypeParameterOutOfScope(self.signatures.denotedArg(id, position: position), open: open) 'unboundInside'
				unbound = true
				break
			end 'unboundInside'
		end 'eachTypeArgument'

		_ = try open.pop() otherwise panic("namesTypeParameterOutOfScope: open.pop on a path this call pushed to")
		return unbound
	end 'namesTypeParameterOutOfScope'

	// Does the enclosing declaration's `uses` list mint `token`? The identity `parseTypeReference` gives a bare
	// type parameter is `typeParamTokenFor(enclosingType, name)`, so this asks that of each name.
	function typeParameterIsInScope(token TypeParamId) returns bool
		for name in self.enclosingTypeParams 'eachTypeParam'
			if typeParamTokenFor(self.enclosingTypeName(), paramName: name) == token 'mintedHere'
				return true
			end 'mintedHere'
		end 'eachTypeParam'

		return false
	end 'typeParameterIsInScope'

	// The two columns of one request, written together — the ONE writer, so a position can never be left
	// standing beside an instance some earlier slot named.
	function stateDeclaredLiteralTarget(declared MaxonType, scopeFilePath FilePath, valueStart ElementIndex)
		self.stateLiteralTargets(declared, arrayTarget: self.signatures.arrayInstanceOfDeclaredType(declared, interner: self.artifact.typeNames, readerFilePath: scopeFilePath), tupleTarget: self.declaredTupleTargetOf(declared), valueStart: valueStart)
	end 'stateDeclaredLiteralTarget'

	function stateLiteralTargets(declared MaxonType, arrayTarget DeclaredArrayInstance, tupleTarget DeclaredTupleTarget, valueStart ElementIndex)
		self.stateArrayLiteralTargetAt(arrayTarget, tokenIndex: valueStart)
		self.stateTupleLiteralTargetAt(tupleTarget, tokenIndex: valueStart)
		self.stateClosureOfferOfDeclaredType(declared, valueStart: valueStart)
	end 'stateLiteralTargets'

	function stateClosureOfferOfDeclaredType(declared MaxonType, valueStart ElementIndex)
		if maxonTypeTag(declared) != ValueTypeTag.function or not self.argumentOpensAClosure(valueStart) 'noClosureToOffer'
			return
		end 'noClosureToOffer'

		match self.functionAliasForName(self.internedName(typeNameIdOf(declared))) 'alias'
			declared(alias) then self.stateClosureParamOfferAt(valueStart, offer: self.offeredClosureParamTypes(alias, aliasName: self.internedName(typeNameIdOf(declared)), origin: ReceiverOrigin.unattributed, args: ValueIdArray.create(0), receiverArgs: 0, constructorInstance: ConstructorInstance.none))
			undeclared then break
		end 'alias'
	end 'stateClosureOfferOfDeclaredType'

	function declaredTupleTargetOf(declared MaxonType) returns DeclaredTupleTarget
		if maxonTypeTag(declared) != ValueTypeTag.structRef 'noTupleLiteralToType'
			return NoDeclaredTupleTarget
		end 'noTupleLiteralToType'

		return tupleTargetNamed(self.internedName(typeNameIdOf(declared)))
	end 'declaredTupleTargetOf'

	function stateTupleColumnTargetAt(target DeclaredTupleTarget, column FieldIndex, valueStart ElementIndex)
		match target 'target'
			none then self.stateTupleLiteralTargetAt(NoDeclaredTupleTarget, tokenIndex: valueStart)
			layout(name) then self.stateTupleLiteralTargetAt(self.declaredTupleColumnTarget(name, column: column), tokenIndex: valueStart)
		end 'target'
	end 'stateTupleColumnTargetAt'

	function declaredTupleColumnTarget(declaredName ByteArray, column FieldIndex) returns DeclaredTupleTarget
		let layout = self.registeredTupleLayout(declaredName)

		if column >= layout.fieldCount() 'pastTheDeclaredColumns'
			return NoDeclaredTupleTarget
		end 'pastTheDeclaredColumns'

		return self.declaredTupleTargetOf(self.signatures.fieldTypeOf(layout, index: column, into: self.artifact.typeNames))
	end 'declaredTupleColumnTarget'

	function stateTupleLiteralTargetAt(target DeclaredTupleTarget, tokenIndex ElementIndex)
		self.statement.tupleLiteralTargetTokenIndex = tokenIndex
		self.statement.tupleLiteralTarget = target
	end 'stateTupleLiteralTargetAt'

	function pendingTupleLiteralTargetAt(index ElementIndex) returns DeclaredTupleTarget
		if self.statement.tupleLiteralTargetTokenIndex != index 'noRequestForThisToken'
			return NoDeclaredTupleTarget
		end 'noRequestForThisToken'

		return self.statement.tupleLiteralTarget
	end 'pendingTupleLiteralTargetAt'

	function takeTupleLiteralTargetAt(openIndex ElementIndex) returns DeclaredTupleTarget
		let pending = self.pendingTupleLiteralTargetAt(openIndex)
		self.statement.tupleLiteralTarget = NoDeclaredTupleTarget
		return pending
	end 'takeTupleLiteralTargetAt'

	function tupleElementColumnType(value ValueId, target DeclaredTupleTarget, column FieldIndex, anchor Token) returns MaxonType
		return match target 'target'
			none gives self.valueSlotType(value)
			layout(name) gives self.declaredTupleColumnType(value, declaredName: name, column: column, anchor: anchor)
		end 'target'
	end 'tupleElementColumnType'

	function tupleElementColumnBrand(value ValueId, target DeclaredTupleTarget, column FieldIndex) returns immutable ByteArray
		if self.tagOf(value) != ValueTypeTag.genericInstance 'carriesNoInstanceBrand'
			return EmptySourceText
		end 'carriesNoInstanceBrand'

		let own = self.authoredBrandOf(value)

		if not own.isEmpty() 'itsOwnBrand'
			return own
		end 'itsOwnBrand'

		return match target 'target'
			none gives EmptySourceText
			layout(name) gives self.declaredTupleColumnBrand(name, column: column)
		end 'target'
	end 'tupleElementColumnBrand'

	function declaredTupleColumnBrand(declaredName ByteArray, column FieldIndex) returns immutable ByteArray
		let layout = self.registeredTupleLayout(declaredName)

		if column >= layout.fieldCount() 'pastTheDeclaredColumns'
			return EmptySourceText
		end 'pastTheDeclaredColumns'

		let declaredColumn = try layout.fieldTypes.get(column) otherwise panic("Parser.declaredTupleColumnBrand: column {column} is below the {layout.fieldCount()} fields `{String.from(declaredName)}` declares")
		return layout.fieldDeclaredBrand(column) if maxonTypeTag(declaredColumn) == ValueTypeTag.genericInstance else EmptySourceText
	end 'declaredTupleColumnBrand'

	function declaredTupleColumnType(value ValueId, declaredName ByteArray, column FieldIndex, anchor Token) returns MaxonType
		let layout = self.registeredTupleLayout(declaredName)

		if self.tagOf(value) != ValueTypeTag.function 'adoptsItsOwnType'
			return self.numericColumnType(value, layout: layout, column: column)
		end 'adoptsItsOwnType'

		if column >= layout.fieldCount() 'pastTheDeclaredColumns'
			return self.typeOf(value)
		end 'pastTheDeclaredColumns'

		let declaredColumn = try layout.fieldTypes.get(column) otherwise panic("Parser.tupleElementColumnType: column {column} is below the {layout.fieldCount()} fields `{String.from(declaredName)}` declares")

		if not self.signatures.slotTypeIsAFunctionValue(declaredColumn) 'notAFunctionColumn'
			return self.typeOf(value)
		end 'notAFunctionColumn'

		self.recordFunctionTypeDoorByName(self.signatures.indexSpaceTypeName(declaredColumn), gotName: self.internedName(self.valueNameId(value)), door: FunctionTypeDoor.tupleElement, place: FunctionTypeDoorPlace.unnamed, anchor: anchor, handedAt: anchor)
		return self.signatures.fieldTypeOf(layout, index: column, into: self.artifact.typeNames)
	end 'declaredTupleColumnType'

	// A column takes no read-only refusal: a tuple may hold read-only values and carries their mark on its
	// own identity. A column whose layout spells an alias still binds its
	// element through the field door's fit — identity and range — as a struct field does, after the
	// layout is interned.
	function requireTupleColumns(layout StructLayout, elementValues ValueIdArray, elementStarts TokenIndexArray, anchor Token) throws SourceParseError
		for i in 0 upto layout.fieldCount() 'eachColumn'
			let value = try elementValues.get(i) otherwise panic("Parser.requireTupleColumns: elementValues.get OOB at {i} — the column is sized to the layout's field count")
			let valueStart = try elementStarts.get(i) otherwise panic("Parser.requireTupleColumns: elementStarts.get OOB at {i} — the column is sized to the layout's field count")

			if layout.fieldDeclaredBrand(i).count() == 0 'noAliasToHold'
				continue
			end 'noAliasToHold'

			let site = self.slotStoreSiteOf(layout, index: i, valueStart: valueStart, anchor: anchor)
			let stored = try self.requireFieldTypeFit(layout, index: i, fieldType: self.signatures.fieldTypeOf(layout, index: i, into: self.artifact.typeNames), value: value, valueStart: valueStart, anchor: anchor, site: site)

			try elementValues.set(i, value: stored) otherwise panic("Parser.requireTupleColumns: elementValues.set OOB at {i} — the column is sized to the layout's field count")
		end 'eachColumn'
	end 'requireTupleColumns'

	function numericColumnType(value ValueId, layout StructLayout, column FieldIndex) returns MaxonType
		let own = self.valueSlotType(value)

		if column >= layout.fieldCount() 'pastTheDeclaredColumns'
			return own
		end 'pastTheDeclaredColumns'

		let declaredColumn = try layout.fieldTypes.get(column) otherwise panic("Parser.numericColumnType: column {column} is below the {layout.fieldCount()} fields `{String.from(layout.name)}` declares")

		if self.signatures.typeNamesANumericIdentity(declaredColumn, slotScopeFilePath: layout.declFilePath) 'anAliasedColumn'
			return self.signatures.adoptType(declaredColumn, into: self.artifact.typeNames)
		end 'anAliasedColumn'

		let ownIsAnAlias = maxonTypeTag(own) == ValueTypeTag.named and self.signatures.aliasNamedIsRanged(self.internedName(typeNameIdOf(own)), slotScopeFilePath: self.job.path)

		if ownIsAnAlias and (maxonTypeTag(declaredColumn) == ValueTypeTag.integer or maxonTypeTag(declaredColumn) == ValueTypeTag.float) 'anAliasedValueInAPlainColumn'
			return self.signatures.fieldTypeOf(layout, index: column, into: self.artifact.typeNames)
		end 'anAliasedValueInAPlainColumn'

		return own
	end 'numericColumnType'

	function stateDeclaredReturnArrayLiteralTarget(declared MaxonReturnType, valueStart ElementIndex)
		match declared 'declared'
			void then self.stateArrayLiteralTargetAt(DeclaredArrayInstance.none, tokenIndex: valueStart)
			value(inner) then self.stateDeclaredLiteralTarget(inner, scopeFilePath: self.job.path, valueStart: valueStart)
		end 'declared'
	end 'stateDeclaredReturnArrayLiteralTarget'

	function stateContainerElementLiteralTargets(giid GenericInstanceId, valueStart ElementIndex)
		match self.elementLiteralTargetsOf(giid) 'targets'
			none then self.stateNoElementLiteralTargets(valueStart)
			typed(adopted, arrayTarget, tupleTarget) then self.stateLiteralTargets(adopted, arrayTarget: arrayTarget.clone(), tupleTarget: tupleTarget.clone(), valueStart: valueStart)
		end 'targets'
	end 'stateContainerElementLiteralTargets'

	function elementLiteralTargetsOf(giid GenericInstanceId) returns ElementLiteralTargets
		if let answered = try self.memos.elementLiteralTargets.get(giid) 'alreadyAsked'
			return answered
		end 'alreadyAsked'

		self.memos.elementLiteralTargets.file(giid, value: self.freshElementLiteralTargets(giid))

		return try self.memos.elementLiteralTargets.get(giid) otherwise panic("elementLiteralTargetsOf: the answer filed for {giid} one line up is missing")
	end 'elementLiteralTargetsOf'

	function freshElementLiteralTargets(giid GenericInstanceId) returns ElementLiteralTargets
		if self.signatures.containerElementIsOpaque(giid) 'opaqueInSharedBody'
			return ElementLiteralTargets.none
		end 'opaqueInSharedBody'

		let adopted = self.signatures.adoptType(self.signatures.containerElementType(giid), into: self.artifact.typeNames)
		return ElementLiteralTargets.typed(adopted, arrayTarget: self.signatures.arrayInstanceOfDeclaredType(adopted, interner: self.artifact.typeNames, readerFilePath: self.job.path), tupleTarget: self.declaredTupleTargetOf(adopted))
	end 'freshElementLiteralTargets'

	function stateArrayLiteralTargetAt(slot DeclaredArrayInstance, tokenIndex ElementIndex)
		self.statement.arrayLiteralTargetTokenIndex = tokenIndex
		self.statement.arrayLiteralTarget = slot
	end 'stateArrayLiteralTargetAt'

	// ⭐⭐ **THE TYPE A BRACKETED LITERAL'S VALUE FIXES FOR THE COLUMN IT SITS IN.** An array literal has ONE
	// such column (its element) and a map literal has TWO (its key and its value), and the question each puts
	// is identical — *which `MaxonType` does this parsed value name?* — so it is answered here once and the
	// three callers differ only in the NOUN their refusal uses.
	//
	// ⚠ **THE `named`-vs-`structRef` CHOICE IS `builtinInstanceForNamedElement`'s AND MUST STAY THERE**: a
	// synthesized TUPLE interns as `structRef` where a declared struct/union is `named`, and a second spelling
	// of that rule is a measured spurious `E3006 duplicate definition of 'Array_<T>'` (see its header). So the
	// aggregate arm asks it rather than building the `MaxonType` itself.
	//
	// ⚠⚠ **THE REFUSAL'S ARRAY SPELLING IS PINNED BYTE-FOR-BYTE by `specs/character-ownership.md`'s
	// `an-array-literal-element-is-not-a-character`**, which is why the subject arrives as `<kind> <noun>`
	// rather than as one reworded sentence: composed from `ArrayLiteralSubject`/`ContainerElementColumnNoun` it
	// reproduces that expectation exactly, and the map literal's two columns get their own nouns without
	// touching it.
	function literalColumnTypeFor(value ValueId, literalKind String, columnNoun String, valueTok Token) returns MaxonType throws SourceParseError
		let tag = self.tagOf(value)

		// ⛔⛔ **`exitCode` RIDES HERE, AND WITHOUT IT THIS DOOR REFUSED A PROGRAM ITS OWN SENTENCE
		// PERMITTED.** `typeTagName(exitCode)` is `"int"`, so an `ExitCode`-tagged element fell to the
		// throw as *"an array literal element of type 'int' — a literal's elements are an integer, …"* —
		// the identical self-refuting shape this door carried for a container, one tag over. That is a
		// false refusal and not a policy — the program answers `9`:
		//
		//     typealias IntThunk = function() returns ExitCode
		//     function useIt(t IntThunk) returns Integer
		//         let v = t()
		//         var arr = [v, v]          // ← E2015 before this arm
		//
		// ⚠ **A DIRECT CALL CANNOT REACH IT, WHICH IS WHY IT SURVIVED REVIEW.** `[code(), code()]` over a
		// `function code() returns ExitCode` compiles, because a direct call's result is not `exitCode`-tagged.
		// `wordSlotStorageType`'s header names the two doors that DO mint one — `mintIndirectCallResult` (an
		// indirect call through a function alias) and `interfaceReturnMaxonType` (an interface method
		// `returns ExitCode`) — and both reach this column. That header is also this arm's ANSWER: it maps
		// `exitCode` to `MaxonType.integer` at the env-slot sink, and `tagIsPlainInteger` puts `exitCode` beside
		// `integer` because neither carries an alias identity, so the column an `ExitCode`-tagged element takes
		// is the plain `integer` one every other plain integer takes.
		if tagIsPlainInteger(tag) 'int'
			return MaxonType.integer
		end 'int'

		if tagIsFloat(tag) and self.valueNameId(value) != UnnamedTypeId 'aFloatAlias'
			return self.signatures.namedElementType(self.valueTypeName(value))
		end 'aFloatAlias'

		if tag == ValueTypeTag.boolean or tagIsFloat(tag) 'scalar'
			return MaxonType.boolean if tag == ValueTypeTag.boolean else MaxonType.float
		end 'scalar'

		if tagIsText(tag) 'string'
			return MaxonType.string
		end 'string'

		if self.signatures.tagMayNameAggregate(tag) 'aggregate'
			return self.signatures.namedElementType(self.valueTypeName(value))
		end 'aggregate'

		// ⭐⭐ **A CONTAINER VALUE — A GENERIC INSTANCE, WHOSE COLUMN TYPE IS THE INSTANCE ITSELF.** `[list1, list2]`
		// over two `List with Integer` locals is an `Array with (List with Integer)`, and that nested instance is a
		// type this door can name outright.
		//
		// ⭐⭐ **IT IS THE ONE ARM OF THIS DOOR THAT MAY USE THE SHARED REBUILD, AND THE ASYMMETRY IS THE REASON.**
		// `typeOf` is `maxonTypeOfTag(tagOf, nameId: valueNameId)`, whose `genericInstance` arm is exactly the type
		// wanted here — so open-coding it would be a second spelling of a rule that already has a home, and
		// `valueIsUnsigned`'s header records what that costs ("the file's THIRD copy of that walk").
		// The `named` and `function` arms genuinely CANNOT use it: their ids are the parser's FILE-LOCAL interner's
		// and must cross into the signature index's as BYTES, which is why each hands a name to
		// `signatures.namedElementType` / `functionElementType` instead. A generic instance needs no crossing
		// because **there is exactly ONE `GenericInstanceRegistry` in the compiler** (`SignatureIndex.maxon`), so
		// every giid — from whichever of the ~20 sites minted this value — is already in the index's space by
		// construction. That is a property of the registry, not a list of mint sites that could go stale.
		//
		// ⭐ **THE MECHANISM IS WHOLE; THIS DOOR ONLY NAMES THE ELEMENT TYPE.** `typealias L = Array with IntList`
		// plus `.create()`/`.push()` compiles and runs (2/2/10 on this spec's own program), because a
		// nested instance is a MANAGED element like any other: `arrayElementSize` stamps the 8-byte pointer slot,
		// `columnDestroyValue` stamps the element's drop callee, and `containerElementType` reads the
		// instance back for `get`. What a bare `[…]` cannot do on its own is NAME that element type, exactly as the
		// `function` arm below records for a function value.
		//
		// ⚠ **NO `interfaceRef` SPLIT IS OWED HERE, AND THE REASON IS THE VALUE COLUMN — NOT `instanceDenotedType`.**
		// That door decides `interfaceRef`-vs-`genericInstance` for a TYPE REFERENCE, and two sites
		// (`parseTypeReference`'s scoped arm, `promoteBareGenericResultToCalleeScope`) mint
		// `MaxonType.genericInstance` without asking it — so it is not a claim this arm may lean on. What this arm
		// dispatches on is the VALUE's tag, where the split is already made by the tag set's own definition: an
		// existential tags the fat pointer's value half `interfaceRef` (see `ValueTypeTag.interfaceRef`), never
		// `genericInstance`. A value reaching here is a box.
		if tag == ValueTypeTag.genericInstance 'containerValue'
			return self.typeOf(value)
		end 'containerValue'

		// ⭐⭐ **A FUNCTION VALUE, WHOSE COLUMN TYPE IS ITS OWN GOVERNING NAME.** A bare `[…]` writes no
		// alias, so it has no other way to NAME the element type. It takes the first element's governing
		// name, which is the same answer `enumFunctionBackingGoverningName` gives for a function-backed
		// enum's `.rawValue` and for the same reason: The compiler names a function type by something
		// that declares it, and the first value is a name that already resolves whole-program.
		//
		// ⚠ **THE NAME CROSSES INTERNERS, SO IT TRAVELS AS BYTES** — `signatures.functionElementType` does the
		// interning, for the reason its own header records with the measurement: a container instance's type
		// arguments are ids in the SIGNATURE index's interner, and the parser's `valueNameId` is an id in this
		// FILE's. Handing the raw id over compiled, parsed and then panicked at the call.
		if tag == ValueTypeTag.function 'functionValue'
			return self.signatures.functionElementType(self.valueTypeName(value))
		end 'functionValue'

		// ⛔⛔ **THE ROSTER BELOW IS HAND-WRITTEN AND IT NO LONGER LISTS EVERY ARM ABOVE IT — MEASURED, NOT
		// SUSPECTED.** It names an integer, a float, a bool, a String, a struct and a boxed union, and the arms
		// admit two more: a FUNCTION VALUE (`[double, triple]`, admitted by the arm directly above and never
		// listed) and, since spec-port `monomorphization-recursive-type`, a CONTAINER (`[list1, list2]`). A
		// sentence that under-states what it admits is this project's most frequent single rot.
		//
		// ⚠ **IT IS NOT RENDERED FROM THE ARMS HERE BECAUSE THE SENTENCE IS PINNED BYTE-FOR-BYTE BY A SECOND
		// SPEC.** `specs/character-ownership.md` quotes the composed message in TWO `maxoncstderr` blocks
		// (`an-array-literal-element-is-not-a-character`, `an-ascii-array-literal-is-a-character-array-too`),
		// which the compiler's `--update-required` does not regenerate. Rendering the roster from the tag arms therefore
		// rewrites a committed expectation belonging to another spec, and that is a decision for
		// whoever owns that file — not a side effect of adding an arm here.
		throw SourceParseError.unsupported("{literalKind} {columnNoun} of type '{typeTagName(tag)}' — a literal's {columnNoun}s are an integer, a float, a bool, a String, a struct, or a boxed union (a bare `[…]` infers the type from the first {columnNoun})", line: valueTok.line, column: valueTok.column)
	end 'literalColumnTypeFor'

	// Emit `__managed_create(elementSize, elementDestroy)` for instance `giid`, yielding the array
	// record — the shared producer for a literal and an `IntArray.create()`. A non-empty `sizing` (the
	// capacity and the length) makes it `__managed_create_sized(elementSize, capacity, length,
	// elementDestroy)`, or `__managed_create_fixed` for a FixedArray: the record of a sized container.
	// Element size is the instance's stamp (`arrayElementStamp`), a compile-time constant here (a concrete
	// instance). The element destructor is the ADDRESS of the
	// element's drop callee for an element that owes a drop, stamped into `element_destroy@40` before any
	// element move (every create stores it inside its body, so it is set at birth); 0 for a
	// trivial element. NOT tracked owned — the caller decides that (a literal tracks after its pushes,
	// a `create()` immediately). A create whose element is composed over the enclosing type's parameters
	// (`containerCreateRoute`'s `composedFromTheCaller`) is emitted without the destructor argument, and the
	// lowering reads it out of the body's descriptor table (`appendComposedElementStampCreate`). An opaque
	// element (`opaqueElement`) is emitted without the element size and the destructor both, and the
	// lowering reads both from the descriptor (`appendOpaqueContainerCreate`).
	function emitArrayCreateOp(giid GenericInstanceId, range SourceRange, sizing ValueIdArray) returns ValueId throws SourceParseError
		match self.signatures.containerCreateRoute(giid) 'route'
			opaqueElement then return self.emitArrayCreateCall(giid, leading: ValueIdArray.create(0), trailing: ValueIdArray.create(0), sizing: sizing, range: range)
			composedFromTheCaller then return self.emitComposedArrayCreateOp(giid, range: range, sizing: sizing)
			staticStamp then return try self.emitStampedArrayCreateOp(giid, range: range, sizing: sizing)
		end 'route'
	end 'emitArrayCreateOp'

	function emitComposedArrayCreateOp(giid GenericInstanceId, range SourceRange, sizing ValueIdArray) returns ValueId
		return self.emitArrayCreateCall(giid, leading: argsOf(self.emitInstanceElementSize(giid, range: range)), trailing: ValueIdArray.create(0), sizing: sizing, range: range)
	end 'emitComposedArrayCreateOp'

	function emitStampedArrayCreateOp(giid GenericInstanceId, range SourceRange, sizing ValueIdArray) returns ValueId throws SourceParseError
		let sizeVal = self.emitInstanceElementSize(giid, range: range)
		try self.requireColumnDropIsNameable(giid, range: range)
		let destroyVal = self.columnDestroyValue(self.signatures.containerElementType(giid), range: range)
		return self.emitArrayCreateCall(giid, leading: argsOf(sizeVal), trailing: argsOf(destroyVal), sizing: sizing, range: range)
	end 'emitStampedArrayCreateOp'

	function emitInstanceElementSize(giid GenericInstanceId, range SourceRange) returns ValueId
		return self.emitLiteral(self.signatures.arrayElementStamp(giid) as FullRangeInt, valueType: MaxonType.integer, range: range)
	end 'emitInstanceElementSize'

	function emitArrayCreateCall(giid GenericInstanceId, leading ValueIdArray, trailing ValueIdArray, sizing ValueIdArray, range SourceRange) returns ValueId
		let args = ValueIdArray.create(leading.count() + sizing.count() + trailing.count(), zeroed: false)
		args.append(leading)
		args.append(sizing)
		args.append(trailing)

		return self.emitRuntimeCall(self.arrayCreateCallee(giid, sizing: sizing), args: args, resultTag: ValueTypeTag.genericInstance, resultNameId: giid as TypeNameId, range: range)
	end 'emitArrayCreateCall'

	function arrayCreateCallee(giid GenericInstanceId, sizing ValueIdArray) returns immutable ByteArray
		if sizing.count() == 0 'unsized'
			return ManagedCreateName
		end 'unsized'

		if sizing.count() == SizedCreateSizingCount 'sized'
			return ManagedCreateFixedName if self.signatures.isFixedArrayInstance(giid) else ManagedCreateSizedName
		end 'sized'

		panic("arrayCreateCallee: a sizing names {sizing.count()} values, and an array create takes none or the capacity and the length")
	end 'arrayCreateCallee'

	// Emit the RAW `.text` address of a COMPILER-INTERNAL runtime function (`__str_decref`, `__destruct_<T>`,
	// `__managed_decref`, `__mm_decref`) as a value. The drop walk invokes it through a plain `callIndirect(ptr)`,
	// not the function-record ABI, so its `FunctionRefForm.codeAddress` lowers to the bare address rather than a
	// function record, and `scanRuntimeUsage` records it so the named destructor is installed (its transitive
	// `__str_decref`/`__mm_free`/nested-cascade needs then close through `noteDestructorUsage`, exactly as a
	// scope-exit `__destruct_<T>` drop's do).
	function emitCodeAddress(name ByteArray, range SourceRange) returns ValueId
		let result = self.mintValue(ValueTypeTag.integer, nameId: UnnamedTypeId)
		self.emitBodyOp(self.bodyState.currentBlock, op: MaxonOp.functionRef(result, funcName: name, form: FunctionRefForm.codeAddress), range: range)
		return result
	end 'emitCodeAddress'

	// ⭐ **THE STATIC SURFACE OF A BUILTIN-CONTAINER INSTANCE ALIAS — ONE dispatch, both spellings of the
	// alias.** A TOP-LEVEL alias (`IntArray`) and a NESTED one (`Container.ElementArray`) differ only in the
	// NAME the instance was keyed under, so they route through here rather than each carrying its own list of
	// which containers are claimed. Two such lists is what let a `Set` inner alias's `create()` produce a value
	// of type `unknown` (see the caller's `innerAlias` arm).
	//
	// `Array` alone has a SECOND static (`init(managed)`), so it keeps its own reader; every other container
	// is `create()`-only and shares one. A container with no usable `create` for the instance in hand is
	// refused by `requireContainerColumnTypes` with a sentence naming that container, at the `.create()` the
	// author wrote, rather than falling through to the mangled `Base.create` (a callee no file declares).
	//
	// ⚠ **A `List with <type parameter>` IS NOT REFUSED** — a chain over an opaque element reads its element
	// destructor off the enclosing instance's layout descriptor at run time, exactly as an
	// `Array with <type parameter>` does. What the door refuses is a NODE HANDLE, which has no `create()` at
	// all.
	function parseContainerAliasStaticCall(func IrFunction, aliasTok Token, aliasName ByteArray, giid GenericInstanceId) returns ValueId throws SourceParseError
		if self.signatures.isArrayInstance(giid) 'array'
			return try self.parseArrayStaticCall(func, aliasTok: aliasTok, aliasName: aliasName, giid: giid)
		end 'array'

		return try self.parseBuiltinContainerStaticCall(aliasTok, aliasName: aliasName, giid: giid)
	end 'parseContainerAliasStaticCall'

	// The `Array` statics. `create` yields an OWNED array, empty or sized (`parseArrayCreateStatic`);
	// `init(managed)` ADOPTS an existing buffer as the array around it. Both serve a CONCRETE instance
	// (`Array with Integer`) and an OPAQUE one (`Array with T` inside a generic body) alike —
	// `emitArrayCreateOp` branches on the element, and the adoption is element-agnostic by construction.
	//
	// `create()`: an opaque element is created here without its stride or destructor (`emitArrayCreateOp`'s
	// `opaqueElement` route; the lowering reads both from the threaded descriptor); the element READ (borrow),
	// MOVE-OUT (`__drop_type_param`) and COPY (`__managed_*_opaque` via the descriptor `copyFunc@32`) are all
	// served through the descriptor, never creation.
	//
	// Every OTHER static `stdlib/Array.maxon` declares — `from(source)` — is an ordinary corpus call, and goes
	// through the door every declared static takes. Its member may be a keyword (`from`), which is a name
	// after the dot.
	function parseArrayStaticCall(func IrFunction, aliasTok Token, aliasName ByteArray, giid GenericInstanceId) returns ValueId throws SourceParseError
		try self.consume(TokenKind.dot)

		let methodTok = try self.consume(TokenKind.identifier)
		let range = SourceRange.between(aliasTok, last: methodTok)

		match builtinArrayStaticKind(methodTok.value) 'kind'
			builtinCreate then return try self.parseArrayCreateStatic(func, giid: giid, aliasTok: aliasTok, aliasName: aliasName, range: range)
			builtinInit then return try self.parseArrayInitStatic(func, giid: giid, methodTok: methodTok, range: range)
			corpus or
			none then panic("parseArrayStaticCall: '{String.from(methodTok.value)}' reached the compiler's own Array statics and is neither `create` nor `init` — `resolveStaticMember` answers every other member that way as a corpus call or a refusal")
		end 'kind'
	end 'parseArrayStaticCall'

	// `create()` and `create(0)` build the empty array, `create(n)` builds `n` zero elements and
	// `create(n, zeroed: false)` an empty array with room for `n`; the sized forms are each one
	// `__managed_create_sized` call. `n` is proved to fit `ElementIndex` by the door `resize` uses (E3005).
	//
	// A literal-zero capacity returns before the zero-element gate, so `create(0)` is legal for every element.
	// `zeroed:` takes a literal `true` or `false` (E2015 otherwise) because whether the element has a zero
	// value is a compile-time fact the gate must see.
	function parseArrayCreateStatic(func IrFunction, giid GenericInstanceId, aliasTok Token, aliasName ByteArray, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)

		if self.at(TokenKind.rightParen) 'noArguments'
			try self.consume(TokenKind.rightParen)

			if self.signatures.isCorpusArrayInstance(giid) 'libraryArray'
				self.recordArtifactDiagnostic(ErrorCode.arrayCreateWithoutCapacity, message: "'{String.from(aliasName)}.{String.from(CreateMethod)}()' needs a capacity: write '{String.from(CreateMethod)}(0)' for an empty array, '{String.from(CreateMethod)}(n)' for n zero elements, or '{String.from(CreateMethod)}(n, {String.from(ArrayCreateZeroedLabel)}: false)' for an empty array with room for n", range: range)
			end 'libraryArray'

			return try self.emitOwnedContainerCreate(giid, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: ValueIdArray.create(0))
		end 'noArguments'

		let capacity = try self.parseCreateLengthArg(func, lengthOwner: self.signatures.genericInstanceBaseName(giid), paramName: ArrayCreateCapacityName, aliasTok: aliasTok)

		var zeroed = true

		if self.at(TokenKind.comma) 'zeroedArgument'
			try self.consume(TokenKind.comma)
			zeroed = try self.parseArrayCreateZeroed()
		end 'zeroedArgument'

		try self.consume(TokenKind.rightParen)

		if self.constIsKnown(capacity) and self.constOf(capacity) == 0 'emptyArray'
			return try self.emitOwnedContainerCreate(giid, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: ValueIdArray.create(0))
		end 'emptyArray'

		if zeroed 'zeroedSlots'
			try self.requireArrayGrowthHasZeroElement(giid, tok: aliasTok, refusal: ZeroElementRefusal.arrayCreateZeroed)
		end 'zeroedSlots'

		let published = capacity if zeroed else self.emitLiteral(0, valueType: MaxonType.integer, range: range)

		return try self.emitOwnedContainerCreate(giid, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: twoArgs(capacity, second: published))
	end 'parseArrayCreateStatic'

	function parseArrayCreateZeroed() returns bool throws SourceParseError
		let zeroedLabel = try self.consume(TokenKind.identifier)

		if not zeroedLabel.value.equals(ArrayCreateZeroedLabel) 'notZeroed'
			throw SourceParseError.unsupported("'{String.from(zeroedLabel.value)}:' in '{String.from(CreateMethod)}(…)' — the second argument is '{String.from(ArrayCreateZeroedLabel)}:'", line: zeroedLabel.line, column: zeroedLabel.column)
		end 'notZeroed'

		try self.consume(TokenKind.colon)

		if self.at(TokenKind.true) 'zeroedTrue'
			try self.consume(TokenKind.true)

			return true
		end 'zeroedTrue'

		if self.at(TokenKind.false) 'zeroedFalse'
			try self.consume(TokenKind.false)

			return false
		end 'zeroedFalse'

		let written = self.tokenAt(self.pos)

		throw SourceParseError.unsupported("'{String.from(ArrayCreateZeroedLabel)}:' takes the literal 'true' or 'false' — whether a type has a zero value is decided where '{String.from(CreateMethod)}' is written", line: written.line, column: written.column)
	end 'parseArrayCreateZeroed'

	// ⭐⭐ **`ByteArray.init(managed)` — ADOPT A BUFFER AS THE ARRAY AROUND IT.**
	// `stdlib/Array.maxon:110-115` declares `init(managed ElementMemory) returns Self` with the body
	// `return Self{managed: managed}`, where `ElementMemory = __ManagedMemory with Element`. In the compiler that
	// struct literal is an IDENTITY on the record rather than a construction: `Array with T` and
	// `__ManagedMemory with T` are ONE record with TWO SURFACES (`SignatureIndex.ManagedMemoryTypeName` is
	// registered as a generic ALIAS of the `Array with Byte` instance), so there is no second record for the
	// buffer to become a field of. No allocation, no copy, no element walk.
	//
	// ⚠ **IT IS DELIBERATELY NOT `String.init(managed)`'S ARM, WHICH COPIES** (`__str_from_bytes`). The two
	// statics share a name, a parameter name and an argument door, and the copy is CORRECT there for a reason
	// that does not hold here: a String record differs from an Array record at slot `@40`, so it has to build
	// one. Copying here would defeat the static's entire purpose — the caller fills a raw buffer and then
	// names it as the container.
	//
	// ⭐ **THE EMISSION IS `retainBorrowedAggregate`, AND BOTH OF ITS PROPERTIES ARE LOAD-BEARING.**
	//   • **A FRESH, UNMARKED `ValueId` IS WHAT FLIPS THE SURFACE.** The two surfaces are told apart by
	//     PROVENANCE, and the ARRAY surface is the ABSENCE of the buffer mark (`markBufferSurface`). The
	//     argument typically CARRIES that mark and the retain carries it onto its fresh name
	//     (`carryValueFacts`), so the adoption clears it (`unmarkBufferSurface`); a value still marked would
	//     dispatch on the BUFFER roster — `init(…).push(…)` refused as an unknown `Array` method, the roster
	//     exactly inverted. `array-init.the-surface-flips` is the case that says so.
	//   • **THE REFCOUNT BALANCES.** The source is still live and still drops at its own scope exit, so the
	//     adopted array must be a SECOND owner, not a stolen one. `__mm_retain` raises the same refcount word
	//     `__managed_decref` lowers — both go through `MmRuntime.emitRefcountCheckToLastOwner` — so
	//     `let a = ByteArray.init(mm)` traces rc 0 → 1 → (`a` drops) 0 → (`mm` drops) freed.
	//
	// The retain and the statement-scoped drop obligation come as ONE call (`coOwnAggregateAsTemp`), shared
	// with `bufferSurfaceOf` — the inverse direction, which owes the identical pair for the identical reason:
	// a static CALL's result may be bound to nothing (`ByteArray.init(mm).count()`), so the bare owned-heap
	// bit `retainBorrowedAggregate` sets is not enough. See that door for why the two halves travel together.
	function parseArrayInitStatic(func IrFunction, giid GenericInstanceId, methodTok Token, range SourceRange) returns ValueId throws SourceParseError
		try self.consume(TokenKind.leftParen)
		let argumentStart = self.pos
		let managed = try self.parseExpression(func, block: self.bodyState.currentBlock)
		try self.requireSameArrayInstance(managed, giid: giid, anchor: methodTok)
		try self.requireNotAnIsolatedSlotRead(managed, startIndex: argumentStart, endIndex: self.pos, anchor: self.tokenAt(argumentStart))
		try self.consume(TokenKind.rightParen)

		let adopted = self.adoptManagedAsArray(managed, range: range)
		self.unmarkBufferSurface(adopted)
		try self.bodyState.valueBrandIds.set(adopted, value: UnnamedTypeId) otherwise panic("parseArrayInitStatic: v{adopted} has no brand slot — every SSA value is minted through mintValue, which seeds the column")

		if not capabilityIsReadOnly(self.effectiveCapabilityOf(managed)) 'writableBuffer'
			self.markFreshWhenInputsClean(adopted, inputs: argsOf(managed))
		end 'writableBuffer'

		return adopted
	end 'parseArrayInitStatic'

	function adoptManagedAsArray(managed ValueId, range SourceRange) returns ValueId
		if self.valueIsAnOwnedIsolatedLocal(managed) 'movesIntoTheArray'
			self.moveOwnedValueOut(managed)
			self.trackOwnedTemp(managed, exclusivity: OwnedHeapExclusivity.coOwned)
			return managed
		end 'movesIntoTheArray'

		return self.coOwnAggregateAsTemp(managed, range: range)
	end 'adoptManagedAsArray'

	// ⭐ **THE `init(managed)` ARGUMENT RULE IS SAME-INSTANCE — AND THE OBVIOUS DOOR IS THE WRONG ONE.**
	// `String.init` checks its argument with `requireManagedMemoryValue`, which is BYTE-ONLY
	// (`valueIsByteArray` requires `arrayElementSize == 1`). That is right for a String — it is reading the
	// bytes — and wrong here in the direction that costs a WRONG ANSWER rather than a refusal: it would
	// ACCEPT `IntArray.init(<a byte buffer>)`, an `Array with Integer` striding by 8 through a byte-packed
	// allocation, giving back whichever bytes fell on the boundaries. So `String.init`'s door is left alone —
	// it still needs the byte rule — and this is a second rule BESIDE it rather than a widening of it.
	//
	// The rule: the argument's generic instance must EQUAL the receiver alias's. That is element-agnostic and
	// strictly STRONGER than the byte rule, and it is what keeps the element STRIDE honest at every element
	// type rather than at one. `array-init.error.a-buffer-of-the-wrong-element` is the refusal.
	//
	// ⚠ **EVERY ADOPTION REACHABLE TODAY IS NONETHELESS A BYTE ONE, AND THAT IS THE `Array_int` GAP SHOWING
	// THROUGH — NOT THIS RULE.** `managedMemoryInstanceForElementSize` mints exactly two instances, and the
	// word one is `Array with int`, which NO program can name: `Array with int` is E2061 (a bare `int` is not
	// a type argument) and every ranged alias over it interns a different instance — the same `Array_int` vs
	// `Array_Integer` split `specs/default-values.md` and `string-views.md` already pin for array
	// literals. MEASURED, all three rows, in `specs/array-init.md`. Keying on element WIDTH instead
	// would reach the word row only by giving up the soundness above — a managed element and an `int` are
	// both 8 bytes wide, so an `Array with String` would adopt a buffer of raw integers as String pointers.
	//
	// ⚠ The sentence names `__ManagedMemory with <element>` because that is what the SIGNATURE declares
	// (`ElementMemory`), not the `Array` spelling of the same instance — the split `SourceParseError`'s two
	// builtin-argument sentences already draw, for the same reason.
	//
	// ⚠⚠ **IT ASKS FOR THE INSTANCE, NOT FOR THE BUFFER MARK, AND THE NAME SAYS SO.**
	// It makes no buffer test: an ORDINARY array of
	// the same instance is admitted too, and adopting one is an ordinary co-owning retain
	// (`array-init.an-ordinary-array-of-the-instance-adopts` pins it). Keying on `valueIsBufferSurface`
	// instead would not merely be stricter, it would be WRONG — the mark is a per-function fact about a
	// `ValueId` and it does not survive a CLOSURE CAPTURE (MEASURED: inside a closure body `mm.length()` is
	// already refused, while `ByteArray.init(mm)` must still adopt — `array-init.a-captured-buffer-adopts-
	// inside-a-closure`). A door keyed on the mark would refuse the `stdlib/File.maxon:135` shape the moment
	// it appeared inside a closure, for a reason having nothing to do with the element stride this rule
	// exists to keep honest. The instance is the fact the stride depends on, so the instance is what is asked.
	// ⚠⚠ **AND IT ADMITS THE BYTE-BUFFER BOUNDARY — THE NINTH DOOR OF THE CLASS
	// `byteBufferBoundaryAdmits`'s header ENUMERATES.**
	// ⚠ NINTH, and the only one that does NOT ride `aggregatesConflict`: the eight that header measured are
	// aggregate comparisons, and this rule is raw instance EQUALITY (see the paragraph above for why), so it
	// inherits nothing from them and is given the door by name.
	// A COMPILER-SYNTHESIZED byte buffer wears the reserved element `__ManagedByte`, deliberately a DIFFERENT
	// instance from the user-visible `Byte` (`SignatureIndex`'s two-names roster: a user may declare `Byte`,
	// and a compiler-minted buffer's stride may not follow). Raw instance EQUALITY therefore refuses it, and
	// `StdinSource.readSome` is exactly that program: `ByteArray.init(__Builtins.readStdin(most))`, refused
	// `E3005 argument type mismatch for 'managed': expected '__ManagedMemory with Byte', got
	// 'Array___ManagedByte'` — MEASURED on a module the BOOTSTRAP
	// compiles.
	//
	// ⭐ **THE ADMISSION IS THE SHARED THREE-QUESTION DOOR AND NOT A FOURTH SPELLING OF IT**, which is that
	// header's own instruction: the receiver's element must be NAMED for a byte, must hold EVERY byte value
	// in every file that declares it, and its record must stride ONE byte — and only then is the arriving
	// `__ManagedByte` admitted. All three are load-bearing here for the same reasons they are at the other
	// eight sites: a user program may contest `Byte` with `typealias Byte = int(0 to 200)` (whole-program, by
	// NAME — `export` is not read), and adopting a raw byte buffer as an array of THAT element is the
	// measured 223 the second question exists to refuse. Under all three the stride is provably 1 on both
	// sides, which is the exact property this function protects.
	//
	// ⚠ It stays ONE-WAY, like every other use of that door: only the COMPILER's own mint is admitted at a
	// declared byte position. A user's `Array with Byte` is not admitted at a `__ManagedByte` position,
	// because nothing mints a value at that spelling but the compiler.
	// The instance a `genericInstance`-tagged value is typed as — the name column carries the
	// GenericInstanceId on that tag (see `typeNameIdOf`). Asked only when the tag says so.
	function valueInstanceId(value ValueId) returns GenericInstanceId
		return self.valueNameId(value) as GenericInstanceId
	end 'valueInstanceId'

	function valueIsAnArray(value ValueId) returns bool
		return self.signatures.isArrayInstanceAt(self.tagOf(value), nameId: self.valueNameId(value))
	end 'valueIsAnArray'

	// The token a `typeParameter`-tagged value is typed as — the same column, read on that tag.
	function valueTypeParamId(value ValueId) returns TypeParamId
		return self.valueNameId(value) as TypeParamId
	end 'valueTypeParamId'

	function valueIsInstance(value ValueId, giid GenericInstanceId) returns bool
		return self.tagOf(value) == ValueTypeTag.genericInstance and self.valueInstanceId(value) == giid
	end 'valueIsInstance'

	function requireSameArrayInstance(value ValueId, giid GenericInstanceId, anchor Token) throws SourceParseError
		if self.valueIsInstance(value, giid: giid) 'sameInstance'
			return
		end 'sameInstance'

		if self.signatures.byteBufferBoundaryAdmits(ValueTypeTag.genericInstance, declaredNameId: giid as TypeNameId, gotTag: self.tagOf(value), gotNameId: self.valueNameId(value)) 'aSynthesizedByteBuffer'
			return
		end 'aSynthesizedByteBuffer'

		throw SourceParseError.builtinArgumentType(String.from(StringInitManagedParamName), expected: "{String.from(ManagedMemoryTypeName)} with {self.signatures.arrayElementDisplayName(giid)}", got: self.valueDisplayTypeName(value), line: anchor.line, column: anchor.column, expectedNote: "", crossesRange: false)
	end 'requireSameArrayInstance'

	// --- The `create()` static surface the compiler-owned containers SHARE (`Set` / `Map` / `List`) ---

	// ⭐ **`IntSet.create()` / `StrMap.create()` / `PointList.create()` — ONE PARSE.** Every container whose
	// whole static surface is `create()` is born here: consume `.create`, consume the empty argument list, gate
	// the element/column types, emit the create, and TRACK THE RESULT as an owned temporary so an unbound one
	// drops at statement end and a bound one transfers to its binding.
	//
	// ⚠ **THE `trackOwnedTemp` IS THE REASON THIS IS ONE FUNCTION AND NOT THREE.** A container whose copy
	// omitted it would LEAK with no diagnostic anywhere — the record is created, nothing tracks it, and
	// `genericInstanceBoxDropCallee` is never asked. The two things a container
	// genuinely does differently (the sentence its unknown static is refused with, and the gate/emit pair) are
	// the two routers below; the skeleton around them cannot drift because there is one of it.
	//
	// `Array` is NOT here: its static surface is several methods with arguments (`parseArrayStaticCall`), so it
	// shares the skeleton with nothing.
	//
	// ⚠ **`aliasName` IS THE CALLER'S AND IS NEVER RE-DERIVED FROM `aliasTok`.** The two doors
	// spell the key differently — a top-level alias is its own token, a NESTED one is base-qualified
	// (`Container.ElementArray`) — so `aliasTok.value` is the right key for one of them and the wrong one for
	// the other.
	function parseBuiltinContainerStaticCall(aliasTok Token, aliasName ByteArray, giid GenericInstanceId) returns ValueId throws SourceParseError
		try self.consume(TokenKind.dot)
		let methodTok = try self.consume(TokenKind.identifier)

		if not methodTok.value.equals(CreateMethod) 'unknownStatic'
			panic("parseBuiltinContainerStaticCall: '{String.from(methodTok.value)}' passed `surfaceStaticOf` and is not `create` — the roster and this chain read one list")
		end 'unknownStatic'

		try self.consumeEmptyArgList()

		return try self.emitOwnedContainerCreate(giid, aliasTok: aliasTok, aliasName: aliasName, range: SourceRange.between(aliasTok, last: methodTok), sizing: ValueIdArray.create(0))
	end 'parseBuiltinContainerStaticCall'

	// ⭐⭐ **THE OWNED EMPTY CONTAINER AN INSTANCE ALIAS DENOTES — the ONE producer behind BOTH spellings**,
	// `<Alias>.create()` and `<Alias>{}`. The two are the same value by measurement, not by intention:
	// the oracle's `ElementArray{}` is `resize`d and `count()`s back exactly as its `ElementArray.create(0)`
	// does. A second producer for the literal would be a second answer to "what does an empty `Array with T`
	// cost?", free to drift from this one the day a header, an element stamp or the buffer surface changes.
	//
	// `Array` is its own arm and is UNGATED: its element rule is the instance's
	// own, so `requireContainerColumnTypes` returns for it, and it alone carries the buffer-surface stamp.
	//
	// `sizing` is empty for the empty container and `(capacity, published length)` for an `Array`'s
	// sized `create` and a runtime-sized `FixedArray`'s `create(n)`, which are no empty container and
	// so are not noted as an empty-container image.
	//
	// ⭐ **`BufArray.create()` YIELDS AN ARRAY OF BUFFERS** — asked of the ALIAS NAME and never of
	// `giid`, which cannot answer: `Array with __ManagedMemory` and `Array with ByteArray` intern to the SAME
	// instance. The name is the caller's because the doors spell it differently — a top-level alias is its own
	// token, a nested one is base-qualified — and only they know which.
	// ⭐⭐ **A BUILTIN CONTAINER'S FACTORY STAMPS THE BRAND THE SITE BUILT IT UNDER.** `Xs.create()` and
	// `Ys.create()` share a gid and are two types; only the written spelling says which one
	// `takesYs(Xs.create())` passed, and `retypeGenericAliasConstructorResult` — where a DECLARED generic's
	// factory result is stamped — is never reached by a builtin container, whose result is already an instance
	// rather than the shared body's base `structRef`.
	//
	// ⚠ It is stamped in ONE place rather than in each of the three arms, because it is one fact about the
	// CALL and not about which kind of container the call built.
	function emitOwnedContainerCreate(giid GenericInstanceId, aliasTok Token, aliasName ByteArray, range SourceRange, sizing ValueIdArray) returns ValueId throws SourceParseError
		let container = try self.emitOwnedContainerRecord(giid, aliasTok: aliasTok, aliasName: aliasName, range: range, sizing: sizing)

		// `Xs.create()` builds an `Xs`; a bare `Array with Integer` spelled at the site builds an unbranded one.
		self.brandValue(container, brand: self.brandOfSpelling(aliasName, readerFilePath: self.job.path))

		if sizing.count() == 0 'anEmptyContainer'
			self.noteEmptyContainerImage(container)
		end 'anEmptyContainer'

		self.markFreshWhenInputsClean(container, inputs: ValueIdArray.create(0))

		return container
	end 'emitOwnedContainerCreate'

	function emitOwnedArrayRecord(giid GenericInstanceId, aliasName ByteArray, range SourceRange, sizing ValueIdArray) returns ValueId throws SourceParseError
		let arr = try self.emitArrayCreateOp(giid, range: range, sizing: sizing)
		self.trackOwnedTemp(arr, exclusivity: OwnedHeapExclusivity.sole)

		if self.signatures.aliasElementIsBufferSurface(aliasName, readerFilePath: self.job.path) 'elementsAreBuffers'
			self.markBufferSurfaceElements(arr)
		end 'elementsAreBuffers'

		return arr
	end 'emitOwnedArrayRecord'

	// The record itself — one arm per container kind. Split from the stamping above so the provenance is written
	// once for all three rather than at each `return`.
	function emitOwnedContainerRecord(giid GenericInstanceId, aliasTok Token, aliasName ByteArray, range SourceRange, sizing ValueIdArray) returns ValueId throws SourceParseError
		if self.signatures.isArrayInstance(giid) 'array'
			return try self.emitOwnedArrayRecord(giid, aliasName: aliasName, range: range, sizing: sizing)
		end 'array'

		// ⭐⭐ **THE SIZED CONTAINER'S RECORD IS BORN WITH ITS SLOTS PUBLISHED, AND THAT IS THE WHOLE OF
		// WHAT IS THE COMPILER'S HERE.** `Vec3.create()` is an ordinary call to `stdlib/FixedArray.maxon`'s
		// declared static, whose body is `return Self{}` — and this arm is what that literal MEANS. It is
		// a fact about the TYPE, exactly as the element stride is: a `FixedArray with 3 Int` IS a three-slot
		// record, so a literal of it publishes three slots however the program spelled the construction.
		//
		// ⚠ **THE COUNT IS `fixedElementCountValue`'s, NOT `genericInstanceFixedCount`'s, AND THE
		// DIFFERENCE IS THE SHARED BODY.** Inside `FixedArray.create` the instance is the declaration's own
		// countless `Self` (`ownRecordSelfInstance`, interned at `InstanceShape.unsized` so ONE body
		// serves every size), so the size is a fact about the CALLER and arrives in the hidden count
		// slot; at a concrete `Vec3{}` it folds to 3. Reading the registry directly here would publish
		// ZERO slots in the one body that matters. A runtime-sized instance has no such fact: its length
		// is the `sizing` the building call passes.
		if self.signatures.isFixedArrayInstance(giid) 'sizedContainer'
			let sized = try self.emitSizedContainerRecord(giid, anchor: aliasTok, range: range, sizing: sizing)
			self.trackOwnedTemp(sized, exclusivity: OwnedHeapExclusivity.sole)
			return sized
		end 'sizedContainer'

		let container = try self.gateAndEmitContainerCreate(giid, aliasTok: aliasTok, range: range)
		self.trackOwnedTemp(container, exclusivity: OwnedHeapExclusivity.sole)
		return container
	end 'emitOwnedContainerRecord'
end 'Parser'
