module typealias CapturedLoadMap = Map with (ValueId, ParamCount)

module typealias RetainedValueMap = Map with (ValueId, ValueId)

module typealias ParamMaskByValue = Map with (ValueId, ParamPositionMask)

module typealias SettlingOpByValue = Map with (ValueId, ElementIndex)

module typealias LoadedFromMap = Map with (ValueId, ValueId)

module typealias IncomingsByPhi = Map with (ValueId, ValueIdArray)

module typealias PositionSlotKey = int(0 to 9223372036854775807)

module typealias ParamMaskByCallArgument = Map with (PositionSlotKey, ParamPositionMask)

module typealias ParamSourcesByFunction = Map with (ElementIndex, ParamSources)

module function positionSlotKey(index ElementIndex, position ElementIndex) returns PositionSlotKey
	return (index as PositionSlotKey) * (MaxAbiArgs as PositionSlotKey) + (position as PositionSlotKey)
end 'positionSlotKey'

union CapturedEnvironment
	none
	parameter(position ParamCount, value ValueId)
end 'CapturedEnvironment'

function capturedEnvironmentOf(func IrFunction) returns CapturedEnvironment
	if func.closureEnvFields.count() == 0 'notAClosure'
		return CapturedEnvironment.none
	end 'notAClosure'

	let position = func.paramCount - 1
	return CapturedEnvironment.parameter(position, value: valueIdAtParamPosition(position))
end 'capturedEnvironmentOf'

function noteCapturedLoad(captured CapturedLoadMap, op MaxonOp, addr ValueId, environment CapturedEnvironment, offset ByteOffset)
	match environment 'environment'
		none then return
		parameter(envPosition, env) then noteEnvironmentLoad(captured, op: op, addr: addr, env: env, envPosition: envPosition, offset: offset)
	end 'environment'
end 'noteCapturedLoad'

function noteLoadedOccupant(captured CapturedLoadMap, func IrFunction, op MaxonOp, addr ValueId, environment CapturedEnvironment, offset ByteOffset)
	if offset == ParameterCellValueOffset and valueIsAParameter(addr, paramCount: func.paramCount) and maskHasParam(func.reassignedParamMask, param: paramPositionOfValueId(addr)) 'theOccupantOfAByReferenceCell'
		let loaded = try maxonOpDefinedValue(op) otherwise panic("noteLoadedOccupant: a load defines its result")
		captured.upsert(loaded, value: paramPositionOfValueId(addr))
		return
	end 'theOccupantOfAByReferenceCell'

	noteCapturedLoad(captured, op: op, addr: addr, environment: environment, offset: offset)
end 'noteLoadedOccupant'

function noteEnvironmentLoad(captured CapturedLoadMap, op MaxonOp, addr ValueId, env ValueId, envPosition ParamCount, offset ByteOffset)
	if addr != env 'notTheEnvironment'
		return
	end 'notTheEnvironment'

	let slot = try envSlotAtOffset(offset) otherwise return

	let id = try maxonOpDefinedValue(op) otherwise panic("noteEnvironmentLoad: a load defines its result")
	captured.upsert(id, value: capturedParamPosition(envPosition, slot: slot))
end 'noteEnvironmentLoad'

function opCopiesItsOperand(op MaxonOp) returns bool
	let callee = try directCalleeOf(op) otherwise return false
	return bytesStartWith(callee, prefix: ClonerPrefix)
end 'opCopiesItsOperand'

function noteRetain(captured CapturedLoadMap, retainedFrom RetainedValueMap, func IrFunction, op MaxonOp, operand ValueId)
	if opCopiesItsOperand(op) 'aCopyOwnsItsOwnStorage'
		return
	end 'aCopyOwnsItsOwnStorage'

	let result = try maxonOpDefinedValue(op) otherwise return
	retainedFrom.upsert(result, value: operand)

	let position = try parameterBehindIn(func, captured: captured, value: operand) otherwise return
	captured.upsert(result, value: position)
end 'noteRetain'

function parameterBehindIn(func IrFunction, captured CapturedLoadMap, value ValueId) returns ParamCount throws AbsentError
	if value < valueIdAtParamPosition(func.paramCount) 'oneOfOurParameters'
		return paramPositionOfValueId(value)
	end 'oneOfOurParameters'

	return try captured.get(value) otherwise throw AbsentError.absent
end 'parameterBehindIn'

function valueIsAnOpaqueElement(func IrFunction, value ValueId) returns bool
	if valueIsAParameter(value, paramCount: func.paramCount) 'aParameterItself'
		return false
	end 'aParameterItself'

	return (try func.valueTags.get(value) otherwise panic("valueIsAnOpaqueElement: v{value} of '{String.from(func.name)}' has no recorded type")) == ValueTypeTag.typeParameter
end 'valueIsAnOpaqueElement'

function scanParamAliases(ir MaxonModule, func IrFunction, captured CapturedLoadMap, retainedFrom RetainedValueMap)
	let environment = capturedEnvironmentOf(func)

	for opIdx in ir.liveOpIndices(func) 'eachOp'
		let op = try ir.ops.get(opIdx) otherwise panic("scanParamAliases: opIdx {opIdx} from liveOpIndices is not in module.ops")

		match slotReadOfOp(op, opIndex: opIdx) 'read'
			load(_, addr, offset) then noteLoadedOccupant(captured, func: func, op: op, addr: addr, environment: environment, offset: offset)
			retainOf(operand) then noteRetain(captured, retainedFrom: retainedFrom, func: func, op: op, operand: operand)
			none or
			store or
			wordPayload then break
		end 'read'
	end 'eachOp'
end 'scanParamAliases'

function indexParamNotes(ir MaxonModule, func IrFunction, joined ParamMaskByValue, callArguments ParamMaskByCallArgument, results SettlingOpByValue, derived SettlingOpByValue)
	let notes = func.capabilityNotes

	for source in notes.joinedSources 'eachJoin'
		if not joined.contains(source.value) 'firstWins'
			joined.upsert(source.value, value: source.sources)
		end 'firstWins'
	end 'eachJoin'

	for source in notes.callArgSources 'eachCallArgument'
		let key = positionSlotKey(source.op, position: source.position)

		if not callArguments.contains(key) 'firstWins'
			callArguments.upsert(key, value: source.sources)
		end 'firstWins'
	end 'eachCallArgument'

	for opIdx in notes.undecidedResultOps 'eachUndecidedResult'
		let defined = try maxonOpDefinedValue(try ir.ops.get(opIdx) otherwise panic("indexParamNotes: ops.get OOB at {opIdx}")) otherwise continue

		if not results.contains(defined) 'firstWins'
			results.upsert(defined, value: opIdx)
		end 'firstWins'
	end 'eachUndecidedResult'

	for position in 0 upto notes.derivedResultValues.count() 'eachDerivedResult'
		let value = try notes.derivedResultValues.get(position) otherwise panic("indexParamNotes: derivedResultValues.get OOB at {position}")

		if not derived.contains(value) 'firstWins'
			derived.upsert(value, value: try notes.derivedResultOps.get(position) otherwise panic("indexParamNotes: derivedResultOps.get OOB at {position} — the columns are pushed together"))
		end 'firstWins'
	end 'eachDerivedResult'
end 'indexParamNotes'

module type ParamNoteIndex
	module let joined as ParamMaskByValue
	module let callArguments as ParamMaskByCallArgument
	module let results as SettlingOpByValue
	module let derived as SettlingOpByValue

	module static function empty() returns ParamNoteIndex
		return Self{joined: ParamMaskByValue.create(), callArguments: ParamMaskByCallArgument.create(), results: SettlingOpByValue.create(), derived: SettlingOpByValue.create()}
	end 'empty'

	module static function of(ir MaxonModule, func IrFunction, shared ParamNoteIndex) returns ParamNoteIndex
		if not paramNotesAreRecorded(func) 'nothingRecorded'
			return shared
		end 'nothingRecorded'

		let joined = ParamMaskByValue.create()
		let callArguments = ParamMaskByCallArgument.create()
		let results = SettlingOpByValue.create()
		let derived = SettlingOpByValue.create()
		indexParamNotes(ir, func: func, joined: joined, callArguments: callArguments, results: results, derived: derived)
		return Self{joined: joined, callArguments: callArguments, results: results, derived: derived}
	end 'of'
end 'ParamNoteIndex'

function opIsADirectCall(op MaxonOp) returns bool
	try directCallPartsOf(op) otherwise return false
	return true
end 'opIsADirectCall'

function paramNotesAreRecorded(func IrFunction) returns bool
	let notes = func.capabilityNotes

	if bodyIsUnreadable(func) 'anUnreadableBody'
		return false
	end 'anUnreadableBody'

	return not (notes.joinedSources.isEmpty() and notes.callArgSources.isEmpty() and notes.undecidedResultOps.isEmpty() and notes.derivedResultValues.isEmpty())
end 'paramNotesAreRecorded'

module enum HolderWalk
	within
	withinThroughResults
	opaqueElementSources
end 'HolderWalk'

module type ParamSources
	module let project as Project
	module let ir as MaxonModule
	module let signatures as ProgramSignatures
	module let funcIndexByName as FuncIndexByName
	module let func as IrFunction
	module let captured as CapturedLoadMap
	module let retainedFrom as RetainedValueMap
	let notes as ParamNoteIndex
	var masks as ParamMaskByValue
	var settledWithin as ParamMaskByValue
	var settledThroughResults as ParamMaskByValue
	var settledOpaqueElements as ParamMaskByValue
	var walking as ValueMarkSet
	let loadedFrom as LoadedFromMap
	// Walked only by `withinThroughResults`: a word payload widens the written side alone, so it cannot ride
	// in `loadedFrom`.
	let payloadHolderOf as LoadedFromMap
	let definingCall as SettlingOpByValue
	let incomingsOf as IncomingsByPhi
	var derivationsIndexed as bool
	let elementHolders as ParamMaskByValue
	var elementHoldersIndexed as bool

	module static function of(project Project, ir MaxonModule, funcIndexByName FuncIndexByName, func IrFunction, noNotes ParamNoteIndex, signatures ProgramSignatures) returns ParamSources
		let captured = CapturedLoadMap.create()
		let retainedFrom = RetainedValueMap.create()
		scanParamAliases(ir, func: func, captured: captured, retainedFrom: retainedFrom)
		return Self{project: project, ir: ir, signatures: signatures, funcIndexByName: funcIndexByName, func: func, captured: captured, retainedFrom: retainedFrom, notes: ParamNoteIndex.of(ir, func: func, shared: noNotes), masks: ParamMaskByValue.create(), settledWithin: ParamMaskByValue.create(), settledThroughResults: ParamMaskByValue.create(), settledOpaqueElements: ParamMaskByValue.create(), walking: ValueMarkSet.create(), loadedFrom: LoadedFromMap.create(), payloadHolderOf: LoadedFromMap.create(), definingCall: SettlingOpByValue.create(), incomingsOf: IncomingsByPhi.create(), derivationsIndexed: false, elementHolders: ParamMaskByValue.create(), elementHoldersIndexed: false}
	end 'of'

	function indexElementHolders()
		if self.elementHoldersIndexed 'alreadyIndexed'
			return
		end 'alreadyIndexed'

		self.elementHoldersIndexed = true
		ViewedSources.over(self.signatures, sources: self).indexElementHolders(self.elementHolders)
	end 'indexElementHolders'

	function elementHoldersOf(value ValueId) returns ParamPositionMask
		self.indexElementHolders()
		return try self.elementHolders.get(value) otherwise NoParamPositions
	end 'elementHoldersOf'

	function indexDerivations()
		if self.derivationsIndexed 'alreadyIndexed'
			return
		end 'alreadyIndexed'

		self.derivationsIndexed = true

		for opIdx in self.ir.liveOpIndices(self.func) 'eachOp'
			let op = try self.ir.ops.get(opIdx) otherwise panic("ParamSources.indexDerivations: opIdx {opIdx} from liveOpIndices is not in module.ops")

			if opIsADirectCall(op) 'aCall'
				self.definingCall.upsert(try maxonOpDefinedValue(op) otherwise panic("ParamSources.indexDerivations: a direct call defines its result"), value: opIdx)
			end 'aCall'

			match slotReadOfOp(op, opIndex: opIdx) 'read'
				load(_, addr, _) then self.noteLoad(op, addr: addr)
				wordPayload(result, holder) then self.noteWordPayload(result, holder: holder)
				store or
				retainOf or
				none then break
			end 'read'
		end 'eachOp'

		let merges = MergeEdges.create()
		noteMergeEdges(self.ir, func: self.func, into: merges)

		for index in 0 upto merges.count() 'eachMergeEdge'
			let phi = merges.phiAt(index)

			if let known = try self.incomingsOf.get(phi) 'anotherIncoming'
				known.push(merges.incomingAt(index))
				continue
			end 'anotherIncoming'

			let first = ValueIdArray.create(0)
			first.push(merges.incomingAt(index))
			self.incomingsOf.upsert(phi, value: first)
		end 'eachMergeEdge'
	end 'indexDerivations'

	function noteWordPayload(result ValueId, holder ValueId)
		if valueCarriesACapability(self.project, func: self.func, value: result) 'aPayloadThatHoldsRecords'
			self.payloadHolderOf.upsert(result, value: holder)
		end 'aPayloadThatHoldsRecords'
	end 'noteWordPayload'

	function noteLoad(op MaxonOp, addr ValueId)
		let loaded = try maxonOpDefinedValue(op) otherwise panic("ParamSources.noteLoad: a load defines its result")
		let capability = try self.func.valueCapabilities.get(loaded) otherwise panic("ParamSources.noteLoad: valueCapabilities.get OOB at v{loaded} of '{String.from(self.func.name)}' — the column is minted in lockstep with the type columns")

		if capability == ValueCapability.immutable 'frozenByItsOwnSlot'
			return
		end 'frozenByItsOwnSlot'

		self.loadedFrom.upsert(loaded, value: addr)
	end 'noteLoad'

	module function maskWithin(value ValueId, throughResults bool) returns ParamPositionMask
		if not valueCarriesACapability(self.project, func: self.func, value: value) 'aValueHasNoStorageToLieWithin'
			return NoParamPositions
		end 'aValueHasNoStorageToLieWithin'

		return self.holdersReachedFrom(value, walk: HolderWalk.withinThroughResults if throughResults else HolderWalk.within)
	end 'maskWithin'

	module function holdersReachedFrom(value ValueId, walk HolderWalk) returns ParamPositionMask
		self.indexDerivations()
		let settled = self.settledHolders(walk)
		var mask = NoParamPositions
		let pending = ValueIdArray.create(0)
		let seen = ValueMarkSet.create()
		pending.push(value)

		while not pending.isEmpty() 'towardTheHolders'
			let current = self.rootOf(try pending.pop() otherwise panic("ParamSources.holdersReachedFrom: the pending list was tested non-empty"))

			if seen.contains(current) 'alreadyWalked'
				continue
			end 'alreadyWalked'

			seen.insert(current)

			if let known = try settled.get(current) 'settledByAnEarlierWalk'
				mask = mask or known
				continue
			end 'settledByAnEarlierWalk'

			mask = mask or self.maskOf(current)

			if let holder = try self.loadedFrom.get(current) 'aFieldLoad'
				pending.push(holder)
			end 'aFieldLoad'

			if let incomings = try self.incomingsOf.get(current) 'aJoin'
				pending.append(incomings)
			end 'aJoin'

			match walk 'walk'
				within then break
				withinThroughResults then mask = mask or self.expandThroughPayloadsAndResults(current, into: pending)
				opaqueElementSources then self.expandThroughCallArguments(current, into: pending)
			end 'walk'
		end 'towardTheHolders'

		settled.upsert(self.rootOf(value), value: mask)
		return mask
	end 'holdersReachedFrom'

	function settledHolders(walk HolderWalk) returns ParamMaskByValue
		return match walk 'walk'
			within gives self.settledWithin
			withinThroughResults gives self.settledThroughResults
			opaqueElementSources gives self.settledOpaqueElements
		end 'walk'
	end 'settledHolders'

	function expandThroughPayloadsAndResults(current ValueId, into ValueIdArray) returns ParamPositionMask
		if let box = try self.payloadHolderOf.get(current) 'aWordPayload'
			into.push(box)
		end 'aWordPayload'

		self.pushHoldersOfResult(current, into: into)
		return self.elementHoldersOf(current)
	end 'expandThroughPayloadsAndResults'

	function expandThroughCallArguments(current ValueId, into ValueIdArray)
		if let opIdx = try self.definingCall.get(current) 'aCallResult'
			into.append(self.argumentsOfCall(opIdx))
		end 'aCallResult'
	end 'expandThroughCallArguments'

	function pushHoldersOfResult(value ValueId, into ValueIdArray)
		let opIdx = try self.settlingOpOf(value) otherwise return
		let args = self.argumentsOfCall(opIdx)

		for i in self.resultSourcePositions(opIdx) 'eachSourceArg'
			into.push(try args.get(i) otherwise panic("ParamSources.pushHoldersOfResult: args.get OOB at {i} — a source position names an argument of this call"))
		end 'eachSourceArg'
	end 'pushHoldersOfResult'

	module function writeSeeds() returns ParamWriteSeedRow
		let row = ParamWriteSeedRow.empty()

		for opIdx in self.ir.liveOpIndices(self.func) 'eachOp'
			let op = try self.ir.ops.get(opIdx) otherwise panic("ParamSources.writeSeeds: opIdx {opIdx} from liveOpIndices is not in module.ops")

			match slotReadOfOp(op, opIndex: opIdx) 'read'
				store(addr, _, value) then self.noteStoredValue(row, addr: addr, value: value)
				load or
				wordPayload or
				retainOf then break
				none then self.noteRuntimeWrite(row, op: op)
			end 'read'
		end 'eachOp'

		if row.rawWrite 'aRawResourceIsWritten'
			row.identity = row.identity or self.rawWrittenParams()
		end 'aRawResourceIsWritten'

		return row
	end 'writeSeeds'

	module function valueMayHoldAUnique(value ValueId) returns bool
		let tag = valueTagOf(self.func, value: value)

		if tag == ValueTypeTag.typeParameter or tag == ValueTypeTag.interfaceRef or tag == ValueTypeTag.function 'aValueWhoseContentIsOpen'
			return true
		end 'aValueWhoseContentIsOpen'

		let nameId = try self.func.valueNameIds.get(value) otherwise panic("ParamSources.valueMayHoldAUnique: v{value} of '{String.from(self.func.name)}' has no type name — the type columns are minted in lockstep")
		return self.signatures.valueHoldsAUnique(tag, nameId: nameId, from: self.project.typeNames)
	end 'valueMayHoldAUnique'

	function noteMovedValue(row ParamWriteSeedRow, value ValueId, sources ParamPositionMask)
		row.moved = row.moved or sources

		if sources != NoParamPositions and self.valueMayHoldAUnique(value) 'mayMoveAUnique'
			row.movedUnique = row.movedUnique or sources
		end 'mayMoveAUnique'
	end 'noteMovedValue'

	function noteStoredValue(row ParamWriteSeedRow, addr ValueId, value ValueId)
		self.noteMovedValue(row, value: value, sources: self.maskOf(value))

		let holders = self.maskWithin(addr, throughResults: true)

		if holders == NoParamPositions 'storesIntoNothingOfOurs'
			return
		end 'storesIntoNothingOfOurs'

		row.within = row.within or holders
		row.kept = row.kept or self.maskOf(value)
	end 'noteStoredValue'

	function noteRuntimeWrite(row ParamWriteSeedRow, op MaxonOp)
		let parts = try directCallPartsOf(op) otherwise return
		let callee = parts.0

		if self.funcIndexByName.contains(callee) 'aBodyDescribesIt'
			return
		end 'aBodyDescribesIt'

		if rawResourceWritingCallee(callee) 'aRawResourceIsWritten'
			row.rawWrite = true
		end 'aRawResourceIsWritten'

		if receiverWritingRuntimeCallee(callee) 'theReceiverIsWritten'
			let written = try parts.1.get(writtenOperandOf(callee)) otherwise panic("ParamSources.noteRuntimeWrite: '{String.from(callee)}' writes an operand its call does not pass")
			row.identity = row.identity or self.maskOf(written)
			row.within = row.within or self.maskWithin(written, throughResults: true)
		end 'theReceiverIsWritten'

		self.noteRuntimeStores(row, callee: callee, args: parts.1)
	end 'noteRuntimeWrite'

	function noteRuntimeStores(row ParamWriteSeedRow, callee ByteArray, args ValueIdArray)
		let shape = runtimeCalleeStoreShape(callee)

		for receiverIndex in 0 upto args.count() 'eachReceiver'
			let receiver = try args.get(receiverIndex) otherwise panic("ParamSources.noteRuntimeStores: args.get OOB at {receiverIndex}")

			if not shapeStoresInto(shape, receiverIndex: receiverIndex as ParamCount) 'storesNothing'
				continue
			end 'storesNothing'

			let storesIntoOurs = self.maskWithin(receiver, throughResults: true) != NoParamPositions

			for storedIndex in 0 upto args.count() 'eachStored'
				if storedIndex != receiverIndex and shapeStoresOperand(shape, storedIndex: storedIndex as ParamCount) 'anotherOperand'
					let storedValue = try args.get(storedIndex) otherwise panic("ParamSources.noteRuntimeStores: args.get OOB at {storedIndex}")
					let stored = self.maskOf(storedValue)
					self.noteMovedValue(row, value: storedValue, sources: stored)

					if storesIntoOurs 'intoDataTheCallerReaches'
						row.kept = row.kept or stored
					end 'intoDataTheCallerReaches'
				end 'anotherOperand'
			end 'eachStored'
		end 'eachReceiver'
	end 'noteRuntimeStores'

	function rawWrittenParams() returns ParamPositionMask
		var records = NoParamPositions
		var isAMethod = false

		if let sig = try self.project.funcSignatures.get(self.func.name) 'declared'
			isAMethod = sig.takesReceiver()
		end 'declared'

		for position in 0 upto self.func.paramCount 'eachParam'
			if isAMethod and position != ReceiverParamPosition 'onlyTheReceiverOwnsTheResource'
				break
			end 'onlyTheReceiverOwnsTheResource'

			let tag = valueTagOf(self.func, value: valueIdAtParamPosition(position))

			if not tagIsAScalarWhateverIsDeclared(tag) and not tagIsByteRecord(tag) 'holdsAStructuredRecord'
				records = maskWithParam(records, param: position)
			end 'holdsAStructuredRecord'
		end 'eachParam'

		return records
	end 'rawWrittenParams'

	module function forgetMasks()
		self.masks = ParamMaskByValue.create()
		self.settledWithin = ParamMaskByValue.create()
		self.settledThroughResults = ParamMaskByValue.create()
		self.settledOpaqueElements = ParamMaskByValue.create()
	end 'forgetMasks'

	module function parameterBehind(value ValueId) returns ParamCount throws AbsentError
		return try parameterBehindIn(self.func, captured: self.captured, value: value)
	end 'parameterBehind'

	module function rootOf(value ValueId) returns ValueId
		var current = value

		while true 'towardTheRoot'
			current = try self.retainedFrom.get(current) otherwise return current
		end 'towardTheRoot'

		panic("ParamSources.rootOf: the walk toward a root only exits by returning at a value no retain produced")
	end 'rootOf'

	module function isAResult(value ValueId) returns bool
		return self.notes.results.contains(value)
	end 'isAResult'

	module function settlingOpOf(value ValueId) returns ElementIndex throws AbsentError
		if let opIdx = try self.notes.results.get(value) 'aResult'
			return opIdx
		end 'aResult'

		return try self.notes.derived.get(value) otherwise throw AbsentError.absent
	end 'settlingOpOf'

	module function hasASettlingOp(value ValueId) returns bool
		return self.notes.results.contains(value) or self.notes.derived.contains(value)
	end 'hasASettlingOp'

	module function maskOf(value ValueId) returns ParamPositionMask
		if let known = try self.masks.get(value) 'alreadyAnswered'
			return known
		end 'alreadyAnswered'

		if valueIsAnOpaqueElement(self.func, value: value) 'anElementOfAnOpaqueType'
			let root = self.rootOf(value)

			if root != value 'aRetainedCopyOfAnotherValue'
				return self.maskOf(root)
			end 'aRetainedCopyOfAnotherValue'

			return NoParamPositions
		end 'anElementOfAnOpaqueType'

		if let direct = try self.parameterBehind(value) 'aParameter'
			return maskWithParam(NoParamPositions, param: direct)
		end 'aParameter'

		if self.walking.contains(value) 'beingWalked'
			return NoParamPositions
		end 'beingWalked'

		self.walking.insert(value)
		var mask = NoParamPositions

		if let joinedSources = try self.notes.joined.get(value) 'aMixedJoin'
			mask = joinedSources
		end 'aMixedJoin' else 'notJoined'
			mask = self.maskOfSettlingResult(value)
		end 'notJoined'

		_ = self.walking.remove(value)
		self.masks.upsert(value, value: mask)
		return mask
	end 'maskOf'

	function maskOfSettlingResult(value ValueId) returns ParamPositionMask
		let opIdx = try self.settlingOpOf(value) otherwise return NoParamPositions
		return self.maskOfResult(opIdx)
	end 'maskOfSettlingResult'

	module function maskOfResult(opIdx ElementIndex) returns ParamPositionMask
		let args = self.argumentsOfCall(opIdx)
		var mask = NoParamPositions

		for i in self.resultSourcePositions(opIdx) 'eachSourceArg'
			mask = mask or self.maskOfCallArgument(opIdx, args: args, position: i)
		end 'eachSourceArg'

		return mask
	end 'maskOfResult'

	function argumentsOfCall(opIdx ElementIndex) returns ValueIdArray
		let parts = try directCallPartsOf(try self.ir.ops.get(opIdx) otherwise panic("ParamSources.argumentsOfCall: ops.get OOB at {opIdx}")) otherwise return ValueIdArray.create(0)
		return parts.1
	end 'argumentsOfCall'

	module function resultSourcePositions(opIdx ElementIndex) returns FuncIndexArray
		let positions = FuncIndexArray.create(0)
		let parts = try directCallPartsOf(try self.ir.ops.get(opIdx) otherwise panic("ParamSources.resultSourcePositions: ops.get OOB at {opIdx}")) otherwise return positions

		if borrowedElementReadCallee(parts.0) 'anElementRead'
			positions.push(0)
			return positions
		end 'anElementRead'

		let calleeIndex = try self.funcIndexByName.get(parts.0) otherwise return positions
		let callee = try self.ir.functions.get(calleeIndex) otherwise panic("ParamSources.resultSourcePositions: functions.get OOB at {calleeIndex}")
		let sig = try self.project.funcSignatures.get(parts.0) otherwise return positions

		for i in 0 upto parts.1.count() 'eachSourceArg'
			let label = try parts.2.get(i) otherwise continue
			let slot = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

			if maskHasParam(callee.resultFromParamMask, param: slot) 'aSource'
				positions.push(i)
			end 'aSource'
		end 'eachSourceArg'

		return positions
	end 'resultSourcePositions'

	module function resultIsUnknown(opIdx ElementIndex) returns bool
		let op = try self.ir.ops.get(opIdx) otherwise panic("ParamSources.resultIsUnknown: ops.get OOB at {opIdx}")
		let parts = try directCallPartsOf(op) otherwise return false
		let calleeIndex = try self.funcIndexByName.get(parts.0) otherwise return false

		return (try self.ir.functions.get(calleeIndex) otherwise panic("ParamSources.resultIsUnknown: functions.get OOB at {calleeIndex}")).resultIsUnknown()
	end 'resultIsUnknown'

	module function maskOfCallArgument(opIdx ElementIndex, args ValueIdArray, position ElementIndex) returns ParamPositionMask
		let argId = try args.get(position) otherwise panic("ParamSources.maskOfCallArgument: args.get OOB at {position}")
		let recorded = try self.notes.callArguments.get(positionSlotKey(opIdx, position: position)) otherwise NoParamPositions
		return recorded or self.maskOf(argId)
	end 'maskOfCallArgument'
end 'ParamSources'

module type ParamWriteSeedRow
	module var identity as ParamPositionMask
	module var within as ParamPositionMask
	module var kept as ParamPositionMask
	module var moved as ParamPositionMask
	module var movedUnique as ParamPositionMask
	module var rawWrite as bool

	module static function empty() returns ParamWriteSeedRow
		return Self{identity: NoParamPositions, within: NoParamPositions, kept: NoParamPositions, moved: NoParamPositions, movedUnique: NoParamPositions, rawWrite: false}
	end 'empty'
end 'ParamWriteSeedRow'

module type ParamWriteSeeds
	module let identity as ParamPositionMaskArray
	module let within as ParamPositionMaskArray
	module let kept as ParamPositionMaskArray
	module let moved as ParamPositionMaskArray
	module let movedUnique as ParamPositionMaskArray

	module static function over(funcNames FunctionNameIndex, paramSources ParamSourceIndex) returns ParamWriteSeeds
		let funcCount = funcNames.functions.count()
		let seeds = Self{identity: emptySummaryColumn(funcCount), within: emptySummaryColumn(funcCount), kept: emptySummaryColumn(funcCount), moved: emptySummaryColumn(funcCount), movedUnique: emptySummaryColumn(funcCount)}

		for index in 0 upto funcCount 'eachFunc'
			let func = try funcNames.functions.get(index) otherwise panic("ParamWriteSeeds.over: functions.get OOB at {index} below its own count")

			if func.paramCount == 0 or bodyIsUnreadable(func) 'nothingOfItsOwnToWrite'
				continue
			end 'nothingOfItsOwnToWrite'

			let row = paramSources.of(index).writeSeeds()
			_ = widenSummaryColumn(seeds.identity, index: index, by: row.identity)
			_ = widenSummaryColumn(seeds.within, index: index, by: row.within)
			_ = widenSummaryColumn(seeds.kept, index: index, by: row.kept)
			_ = widenSummaryColumn(seeds.moved, index: index, by: row.moved)
			_ = widenSummaryColumn(seeds.movedUnique, index: index, by: row.movedUnique)
		end 'eachFunc'

		return seeds
	end 'over'
end 'ParamWriteSeeds'

module type ParamSourceIndex
	let project as Project
	let ir as MaxonModule
	let funcNames as FunctionNameIndex
	let noNotes as ParamNoteIndex
	let signatures as ProgramSignatures
	var built as ParamSourcesByFunction

	module static function over(project Project, ir MaxonModule, funcNames FunctionNameIndex, signatures ProgramSignatures) returns ParamSourceIndex
		return Self{project: project, ir: ir, funcNames: funcNames, noNotes: ParamNoteIndex.empty(), signatures: signatures, built: ParamSourcesByFunction.create()}
	end 'over'

	module function of(funcIndex ElementIndex) returns ParamSources
		if let known = try self.built.get(funcIndex) 'alreadyBuilt'
			return known
		end 'alreadyBuilt'

		let func = try self.funcNames.functions.get(funcIndex) otherwise panic("ParamSourceIndex.of: functions.get OOB at {funcIndex}")
		let sources = ParamSources.of(self.project, ir: self.ir, funcIndexByName: self.funcNames.byName, func: func, noNotes: self.noNotes, signatures: self.signatures)
		self.built.upsert(funcIndex, value: sources)
		return sources
	end 'of'

	module function ofFunction(func IrFunction) returns ParamSources
		return self.of(try self.funcNames.byName.get(func.name) otherwise panic("ParamSourceIndex.ofFunction: '{String.from(func.name)}' is not in the function-name index"))
	end 'ofFunction'
end 'ParamSourceIndex'

// What an op does with a field slot: reads it, stores into it, or retains a value — which a `let` bound out of a
// rebindable slot is — or none of these.
export union SlotRead
	none
	load(opIndex ElementIndex, addr ValueId, offset ByteOffset)
	store(addr ValueId, offset ByteOffset, value ValueId)
	retainOf(operand ValueId)
	wordPayload(result ValueId, holder ValueId)
end 'SlotRead'

export function slotReadOfOp(op MaxonOp, opIndex ElementIndex) returns SlotRead
	match op 'op'
		loadIndirect(_, addr, offset, _) then return SlotRead.load(opIndex, addr: addr, offset: offset)
		storeIndirect(addr, offset, value, _) then return SlotRead.store(addr, offset: offset, value: value)
		call(_, callee, args, _, _, _, _) then return SlotRead.retainOf(try args.get(0) otherwise panic("slotReadOfOp: a retain has no operand")) if ownershipBookkeepingCallee(callee) and args.count() > 0 else SlotRead.none
		holdValue(_, held, _, _, _) then return SlotRead.retainOf(held)
		binOp(result, lhs, _, binary) then return SlotRead.wordPayload(result, holder: lhs) if binary == MaxonBinOp.sub else SlotRead.none
		literal or
		ret or
		retVoid or
		unaryOp or
		compare or
		condBranch or
		branch or
		globalAddr or
		stringLiteral or
		tryCall or
		throwError or
		propagateError or
		panicAbort or
		functionRef or
		indirectCall or
		asyncCall or
		await or
		tryAwait or
		sizeofType or
		constArrayLiteral or
		switch or
		witnessDispatch or
		witnessTryDispatch or
		panicAbortValue or
		errorFlagEncode or
		serviceSpawn or
		serviceSend or
		serviceReplyCell or
		immortalStructRecord or
		immortalStringTable or
		covPoint or
		rawIntrinsic or
		existentialWitness or
		holdEnd then return SlotRead.none
	end 'op'
end 'slotReadOfOp'
