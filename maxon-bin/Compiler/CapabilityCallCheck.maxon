module function checkCapabilityCalls(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, calls CallSummaryIndex, paramSources ParamSourceIndex) throws CompileError
	var witnessSlots = WitnessSlotsByDeclIndex.create()
	checkParamsNeedNotBoth(project, funcNames: funcNames, facts: facts)

	for funcIndex in 0 upto funcNames.functions.count() 'eachFunc'
		try requireStillWanted(project)
		let func = try funcNames.functions.get(funcIndex) otherwise panic("checkCapabilityCalls: functions.get OOB at {funcIndex} below its own count")

		if bodyIsUnreadable(func) or project.libraryFacts.bodyIsSwept(func.name) 'nothingToJudge'
			continue
		end 'nothingToJudge'

		var memo = SettledMemo.over(paramSources.of(funcIndex))

		for opIdx in module.liveOpIndices(func) 'eachOp'
			checkCapabilitiesAtOp(project, module: module, signatures: signatures, funcNames: funcNames, provenance: provenance, facts: facts, calls: calls, witnessSlots: witnessSlots, func: func, funcIndex: funcIndex, opIdx: opIdx, memo: memo)
		end 'eachOp'

		checkStoredSlotArguments(project, module: module, funcNames: funcNames, provenance: provenance, facts: facts, func: func, memo: memo)
		checkResultUses(project, funcNames: funcNames, facts: facts, func: func, memo: memo)
		checkNoWaitInsideWindows(project, module: module, funcNames: funcNames, facts: facts, func: func, windowCallOps: func.capabilityNotes.windowCallOps, windowCallLabels: func.capabilityNotes.windowCallLabels)
		checkPausedOperandsAreNotWritten(project, module: module, signatures: signatures, witnessSlots: witnessSlots, funcNames: funcNames, facts: facts, func: func)
		checkWrittenCapturesAreWritable(project, facts: facts, func: func)
		let tiedCarriers = tiedCarrierOwnersOf(module, func: func)
		checkTiedPromisesAreOnlyAwaited(project, module: module, func: func, owners: tiedCarriers)
		checkNoPromiseIsDropped(project, module: module, func: func, owners: tiedCarriers)
		checkDeferredResultWrites(project, funcNames: funcNames, facts: facts, func: func, memo: memo)
	end 'eachFunc'

	checkConformersMeetTheirRequirements(project, module: module, signatures: signatures, funcNames: funcNames, facts: facts)
end 'checkCapabilityCalls'

module let ProvisionalForAUse = ValueCapability.paused
let ProvisionalForAWrite = ValueCapability.immutable
let ReceiverArgumentIndex = 0 as ElementIndex

function checkStoredSlotArguments(project Project, module MaxonModule, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, func IrFunction, memo SettledMemo)
	for stored in func.capabilityNotes.storedSlotArgs 'eachStoredSlotArg'
		let target = try storedSlotTargetOf(project, module: module, funcNames: funcNames, provenance: provenance, stored: stored) otherwise continue

		if stored.undecided 'seededNotJudged'
			continue
		end 'seededNotJudged'

		let capability = settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: stored.argValue, memo: memo) if memo.sources.hasASettlingOp(stored.argValue) or memo.mergesArms(stored.argValue) else stored.capability
		let verdict = storeVerdict(stored.slot, value: capability, isValueType: false, isSlotRead: false)

		if verdict == StoreVerdict.fits 'fitsTheSlot'
			continue
		end 'fitsTheSlot'

		let place = "{String.from(target.0)}.{target.1}"
		let refusal = try storeRefusalOf(verdict, fieldName: place, valueType: stored.valueType, readOnlyReason: stored.readOnlyReason, subject: "", holderNoun: "element") otherwise panic("checkStoredSlotArguments: a slot that is never isolated judged a value {verdict.name}")
		reportPositioned(project, code: refusal.0, message: refusal.1, line: stored.line, column: stored.column, filePath: authoredFileOf(project, func: func, opIndex: stored.op))
	end 'eachStoredSlotArg'
end 'checkStoredSlotArguments'

function checkResultUses(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, memo SettledMemo)
	for use in func.capabilityNotes.resultUses 'eachResultUse'
		if not use.judged 'seededNotJudged'
			continue
		end 'seededNotJudged'

		let op = try facts.ir.ops.get(use.op) otherwise panic("checkResultUses: ops.get OOB at {use.op}")
		let settled = settledResultCapability(project, funcNames: funcNames, facts: facts, func: func, op: op, provisional: ProvisionalForAUse, memo: memo)
		let filePath = authoredFileOf(project, func: func, opIndex: use.op)

		if use.sends 'aSend'
			if capabilityBreaksAFrozenNeed(settled) 'notFrozen'
				reportPositioned(project, code: ErrorCode.semanticArgumentCapabilityRefused, message: "{use.place}{capabilityWord(settled)}{freezeAdvice(settled, phrase: ". Freeze it first")}", line: use.line, column: use.column, filePath: filePath)
			end 'notFrozen'

			continue
		end 'aSend'

		let verdict = storeVerdict(use.slot, value: settled, isValueType: false, isSlotRead: false)

		if verdict == StoreVerdict.fits 'fitsTheSlot'
			continue
		end 'fitsTheSlot'

		let refusal = try storeRefusalOf(verdict, fieldName: use.place, valueType: use.valueType, readOnlyReason: use.readOnlyReason, subject: "", holderNoun: holderNounOf(use.place)) otherwise panic("checkResultUses: a result is never judged against an isolated slot")
		reportPositioned(project, code: refusal.0, message: refusal.1, line: use.line, column: use.column, filePath: filePath)
	end 'eachResultUse'
end 'checkResultUses'

function checkCallSite(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, func IrFunction, funcIndex ElementIndex, opIdx ElementIndex, op MaxonOp, memo SettledMemo)
	let parts = try directCallPartsOf(op) otherwise panic("checkCallSite: handed an op that is not a direct call")
	let firstJudged = ReceiverArgumentIndex + 1 if memo.buildsALiteral(opIdx) else ReceiverArgumentIndex

	checkCallArguments(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, opIdx: opIdx, callee: parts.0, args: parts.1, argLabels: parts.2, argRanges: parts.3, argImmutableNames: parts.4, firstJudged: firstJudged, memo: memo)
	checkAdaptingResultArguments(project, funcNames: funcNames, facts: facts, func: func, callerIndex: funcIndex, opIdx: opIdx, callee: parts.0, args: parts.1, argLabels: parts.2, memo: memo)
end 'checkCallSite'

function checkCapabilitiesAtOp(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, calls CallSummaryIndex, witnessSlots WitnessSlotsByDeclIndex, func IrFunction, funcIndex ElementIndex, opIdx ElementIndex, memo SettledMemo)
	let op = try module.ops.get(opIdx) otherwise panic("checkCapabilitiesAtOp: opIdx {opIdx} not in module.ops")

	if project.opRanges.get(opIdx).line == 0 'compilerMinted'
		return
	end 'compilerMinted'

	match capabilityDoorOf(op) 'door'
		inert then return
		directCall then checkCallSite(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, funcIndex: funcIndex, opIdx: opIdx, op: op, memo: memo)
		witnessCall then checkRequirementArguments(project, signatures: signatures, witnessSlots: witnessSlots, func: func, opIdx: opIdx, op: op, memo: memo)
		spawn then checkSpawnArguments(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, opIdx: opIdx, op: op, memo: memo)
		functionValueCall then checkFunctionValueCall(project, funcNames: funcNames, provenance: provenance, facts: facts, calls: calls, func: func, opIdx: opIdx, op: op, memo: memo)
		returned then checkReturnedValue(project, module: module, funcNames: funcNames, facts: facts, func: func, opIdx: opIdx, op: op, memo: memo)
	end 'door'
end 'checkCapabilitiesAtOp'

function positionIsTheReceiver(sig FuncSignature, position ParamCount) returns bool
	return sig.takesReceiver() and position == ReceiverParamPosition
end 'positionIsTheReceiver'

function argumentSubject(func IrFunction, opIdx ElementIndex, argImmutableNames WriteBlameArray, index ParamCount, atTheReceiver bool) returns String
	let blamedName = try immutableArgNameAt(argImmutableNames, index: index).blamedName() otherwise EmptySourceText

	if not blamedName.isEmpty() 'aBlamedBinding'
		return "'{String.from(blamedName)}'"
	end 'aBlamedBinding'

	let unnamed = "the receiver" if atTheReceiver else "the argument"
	let spelled = try func.capabilityNotes.argumentNameAt(opIdx, position: index) otherwise return unnamed

	if spelled.isEmpty() 'aTokenThatNamesNothing'
		return unnamed
	end 'aTokenThatNamesNothing'

	return subjectOfSpelledName(spelled)
end 'argumentSubject'

function seedOriginSuffix(facts CapabilityFacts, index ElementIndex, position ParamCount, mutable bool) returns String
	let origin = try facts.seedOriginAt(index, position: position, mutable: mutable) otherwise return ""
	return " (line {origin.line}: {origin.reason})"
end 'seedOriginSuffix'

function useSiteSuffix(facts CapabilityFacts, index ElementIndex, position ParamCount, mutable bool) returns String
	let func = try facts.funcNames.functions.get(index) otherwise panic("useSiteSuffix: functions.get OOB at {index}")
	let line = try func.capabilityNotes.useSiteLine(position, mutable: mutable) otherwise return seedOriginSuffix(facts, index: index, position: position, mutable: mutable)
	let phrase = try func.capabilityNotes.useSitePhrase(position, mutable: mutable) otherwise return seedOriginSuffix(facts, index: index, position: position, mutable: mutable)
	return " (line {line}: `{String.from(phrase)}`)"
end 'useSiteSuffix'

function paramPhrase(func IrFunction, sig FuncSignature, position ParamCount) returns String
	if position >= func.paramCount 'aCapturedSlot'
		return "the data it captured"
	end 'aCapturedSlot'

	if positionIsTheReceiver(sig, position: position) 'theReceiver'
		return "its receiver"
	end 'theReceiver'

	return "'{displayParamName(try sig.paramNames.get(position) otherwise panic("paramPhrase: paramNames.get OOB at {position}"))}'"
end 'paramPhrase'

function leafNeedPhrase(project Project, funcNames FunctionNameIndex, index ElementIndex, position ParamCount, mutable bool) returns String
	let func = try funcNames.functions.get(index) otherwise panic("leafNeedPhrase: functions.get OOB at {index}")
	view sig = try project.funcSignatures.get(func.name) otherwise panic("leafNeedPhrase: '{String.from(func.name)}' has no signature")
	let target = paramPhrase(func, sig: sig, position: position)
	let declared = declaredCapabilityOf(sig, position: position)

	if mutable 'needsAWritableOne'
		return "takes `mutable` {target}" if declared == ParamCapability.mutable else "writes {target}"
	end 'needsAWritableOne'

	if declared == ParamCapability.immutable and positionIsTheReceiver(sig, position: position) 'aFrozenReceiver'
		return "is declared `immutable self`"
	end 'aFrozenReceiver'

	return "takes `immutable` {target}" if declared == ParamCapability.immutable else "needs {target} frozen"
end 'leafNeedPhrase'

function hopsFor(facts CapabilityFacts, index ElementIndex, position ParamCount, mutable bool) returns NeedHops
	if mutable 'aWrittenNeed'
		return facts.writtenHops
	end 'aWrittenNeed'

	if maskHasParam(try facts.immutableOnly.get(index) otherwise panic("hopsFor: immutableOnly.get OOB at {index}"), param: position) 'everyInstanceNeedsItFrozen'
		return facts.frozenHops
	end 'everyInstanceNeedsItFrozen'

	return facts.frozenSomeHops
end 'hopsFor'

function landedHop(hops NeedHops, funcCount ElementIndex, hop NeedHop) returns NeedHop throws AbsentError
	if hop.callee < funcCount 'aBody'
		return hop
	end 'aBody'

	return try hops.viaOf(hop.callee, position: hop.calleeParam)
end 'landedHop'

function needChainText(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, index ElementIndex, position ParamCount, mutable bool) returns String
	let hops = hopsFor(facts, index: index, position: position, mutable: mutable)
	var text = " ("
	var currentIndex = index
	var currentPosition = position
	var first = true

	while true 'eachHop'
		let viaNode = try hops.viaOf(currentIndex, position: currentPosition) otherwise break
		let hop = try landedHop(hops, funcCount: funcNames.functions.count(), hop: viaNode) otherwise break
		let callee = try funcNames.functions.get(hop.callee) otherwise panic("needChainText: functions.get OOB at {hop.callee}")
		let calleeDisplay = functionDisplay(project, func: callee).memberQuoted()
		text.append("it calls {calleeDisplay}, which " if first else "calls {calleeDisplay}, which ")
		first = false
		currentIndex = hop.callee
		currentPosition = hop.calleeParam
	end 'eachHop'

	if first 'ownUse'
		return ""
	end 'ownUse'

	text.append("{leafNeedPhrase(project, funcNames: funcNames, index: currentIndex, position: currentPosition, mutable: mutable)})")
	return text
end 'needChainText'

function needOriginText(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, index ElementIndex, position ParamCount, mutable bool) returns String
	let chain = needChainText(project, funcNames: funcNames, facts: facts, index: index, position: position, mutable: mutable)

	if not chain.isEmpty() 'aCall'
		return chain
	end 'aCall'

	let func = try funcNames.functions.get(index) otherwise panic("needOriginText: functions.get OOB at {index}")
	let line = try func.capabilityNotes.useSiteLine(position, mutable: mutable) otherwise return seedOriginSuffix(facts, index: index, position: position, mutable: mutable)
	return " at line {line}"
end 'needOriginText'

function genericNeedPhrase(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, index ElementIndex, position ParamCount, mutable bool) returns String
	let direct = facts.directMutable if mutable else facts.directImmutable

	if maskHasParam(try direct.get(index) otherwise panic("genericNeedPhrase: direct.get OOB at {index}"), param: position) 'ownUse'
		return "{leafNeedPhrase(project, funcNames: funcNames, index: index, position: position, mutable: mutable)}{useSiteSuffix(facts, index: index, position: position, mutable: mutable)}"
	end 'ownUse'

	let func = try funcNames.functions.get(index) otherwise panic("genericNeedPhrase: functions.get OOB at {index}")
	view sig = try project.funcSignatures.get(func.name) otherwise panic("genericNeedPhrase: '{String.from(func.name)}' has no signature")
	let target = paramPhrase(func, sig: sig, position: position)
	return "writes {target}" if mutable else "needs {target} frozen"
end 'genericNeedPhrase'

function checkParamsNeedNotBoth(project Project, funcNames FunctionNameIndex, facts CapabilityFacts)
	for index in 0 upto funcNames.functions.count() 'eachFunc'
		let func = try funcNames.functions.get(index) otherwise panic("checkParamsNeedNotBoth: functions.get OOB at {index} below its own count")

		if bodyIsUnreadable(func) 'nothingToJudge'
			continue
		end 'nothingToJudge'

		let both = (try facts.mutableOnly.get(index) otherwise panic("checkParamsNeedNotBoth: mutableOnly.get OOB at {index}")) and (try facts.immutableOnly.get(index) otherwise panic("checkParamsNeedNotBoth: immutableOnly.get OOB at {index}"))

		if both == NoParamPositions 'noConflict'
			continue
		end 'noConflict'

		view sig = try project.funcSignatures.get(func.name) otherwise continue

		for position in 0 upto func.paramCount 'eachParam'
			if not maskHasParam(both, param: position) or declaredCapabilityOf(sig, position: position) != ParamCapability.unmarked 'notAnUnmarkedConflict'
				continue
			end 'notAnUnmarkedConflict'

			let name = "the receiver" if positionIsTheReceiver(sig, position: position) else "'{displayParamName(try sig.paramNames.get(position) otherwise continue)}'"
			let site = func.typeSites.siteAt(position)
			let line = positionKeyLine(site) if site != PositionlessSite else func.nameLine
			let column = positionKeyColumn(site) if site != PositionlessSite else func.nameColumn
			let asMutable = needOriginText(project, funcNames: funcNames, facts: facts, index: index, position: position, mutable: true)
			let asImmutable = needOriginText(project, funcNames: funcNames, facts: facts, index: index, position: position, mutable: false)
			reportPositioned(project, code: ErrorCode.semanticParamNeedsBothCapabilities, message: "parameter {name} is used as mutable{asMutable} and as immutable{asImmutable}; a parameter cannot be both", line: line, column: column, filePath: func.sourceFilePath)
		end 'eachParam'
	end 'eachFunc'
end 'checkParamsNeedNotBoth'

function checkCallArguments(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, callee ByteArray, args ValueIdArray, argLabels NameRoster, argRanges SourceRangeArray, argImmutableNames WriteBlameArray, firstJudged ElementIndex, memo SettledMemo)
	if project.poison.duplicates(callee) 'aNameDeclaredMoreThanOnce'
		return
	end 'aNameDeclaredMoreThanOnce'

	view sig = try project.funcSignatures.get(callee) otherwise return
	let calleeIndex = try facts.indexOf(callee) otherwise return
	let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("checkCallArguments: functions.get OOB at {calleeIndex}")

	for i in firstJudged upto args.count() 'eachArg'
		let label = try argLabels.get(i) otherwise panic("checkCallArguments: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
		let position = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

		let written = try args.get(i) otherwise panic("checkCallArguments: args.get OOB at {i} below its own count")
		let constructsALiteral = firstJudged != ReceiverArgumentIndex
		let argId = memo.sources.rootOf(written) if constructsALiteral else written

		if not argumentIsJudgedAtParameter(project, sig: sig, calleeFunc: calleeFunc, position: position, sources: memo.sources, argId: argId, constructsALiteral: constructsALiteral) 'aValueParameter'
			continue
		end 'aValueParameter'

		let range = try argRanges.get(i) otherwise panic("checkCallArguments: argRanges.get OOB at {i} — a call's argument columns are parallel by construction")

		if refuseArgumentAtParameter(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, opIdx: opIdx, calleeFunc: calleeFunc, calleeIndex: calleeIndex, sig: sig, position: position, argId: argId, argIndex: i as ParamCount, argImmutableNames: argImmutableNames, range: range, memo: memo) 'refused'
			return
		end 'refused'
	end 'eachArg'
end 'checkCallArguments'

function argumentIsJudgedAtParameter(project Project, sig FuncSignature, calleeFunc IrFunction, position ParamCount, sources ParamSources, argId ValueId, constructsALiteral bool) returns bool
	if paramTagCarriesACapability(project, sig: sig, func: calleeFunc, position: position) 'aCapabilityCarryingParameter'
		return true
	end 'aCapabilityCarryingParameter'

	return constructsALiteral and sources.hasASettlingOp(argId) and valueTagOf(sources.func, value: argId) != ValueTypeTag.typeParameter and valueCarriesACapability(project, func: sources.func, value: argId)
end 'argumentIsJudgedAtParameter'

function refuseArgumentAtParameter(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, calleeFunc IrFunction, calleeIndex ElementIndex, sig FuncSignature, position ParamCount, argId ValueId, argIndex ParamCount, argImmutableNames WriteBlameArray, range SourceRange, memo SettledMemo) returns bool
	if memo.isAnUnmarkedParameterValue(project, value: argId) or provenance.valueIsAnImmutableAggregate(func, value: argId) 'judgedByTheEdgeOrNoWriterReaches'
		return false
	end 'judgedByTheEdgeOrNoWriterReaches'

	var paramClass = facts.classAt(calleeIndex, position: position, declared: declaredCapabilityOf(sig, position: position))

	if paramClass == ParamClass.anyCapability and facts.frozenOnlyWhereRecordsAreHeld(calleeIndex, position: position) and provenance.valueHoldsRecordsWithin(func, value: argId) 'frozenForItsRecords'
		paramClass = ParamClass.immutableOnly
	end 'frozenForItsRecords'

	let capability = settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: argId, memo: memo)

	if paramClass == ParamClass.mutableOnly and capability == ValueCapability.paused and memo.windowPausesOperand(opIdx, argIndex: argIndex) 'theWindowCheckSpeaksForIt'
		return false
	end 'theWindowCheckSpeaksForIt'

	if not argumentClassRefuses(paramClass, capability: capability) 'accepted'
		return refuseReadOnlyIntoABuilder(project, facts: facts, func: func, opIdx: opIdx, memo: memo, calleeFunc: calleeFunc, calleeIndex: calleeIndex, sig: sig, position: position, argIndex: argIndex, argImmutableNames: argImmutableNames, range: range, paramClass: paramClass)
	end 'accepted'

	let subject = argumentSubject(func, opIdx: opIdx, argImmutableNames: argImmutableNames, index: argIndex, atTheReceiver: positionIsTheReceiver(sig, position: position))
	let message = refusalOfArgument(project, funcNames: funcNames, facts: facts, calleeFunc: calleeFunc, calleeIndex: calleeIndex, position: position, paramClass: paramClass, capability: capability, subject: subject)
	reportPositioned(project, code: ErrorCode.semanticArgumentCapabilityRefused, message: message, line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
	return true
end 'refuseArgumentAtParameter'

function refuseReadOnlyIntoABuilder(project Project, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, memo SettledMemo, calleeFunc IrFunction, calleeIndex ElementIndex, sig FuncSignature, position ParamCount, argIndex ParamCount, argImmutableNames WriteBlameArray, range SourceRange, paramClass ParamClass) returns bool
	if paramClass != ParamClass.anyCapability or not facts.buildsRecordAt(calleeIndex, position: position) 'buildsNothingFromIt'
		return false
	end 'buildsNothingFromIt'

	if not memo.windowPausesOperand(opIdx, argIndex: argIndex) 'notPausedByAnOpenBlock'
		return false
	end 'notPausedByAnOpenBlock'

	let subject = argumentSubject(func, opIdx: opIdx, argImmutableNames: argImmutableNames, index: argIndex, atTheReceiver: positionIsTheReceiver(sig, position: position))
	let message = "{functionDisplay(project, func: calleeFunc).memberQuoted()} builds a record that holds {paramPhrase(calleeFunc, sig: sig, position: position)}, so it takes no read-only data; {subject} is {capabilityWord(ValueCapability.paused)}"
	reportPositioned(project, code: ErrorCode.semanticArgumentCapabilityRefused, message: message, line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
	return true
end 'refuseReadOnlyIntoABuilder'

function checkLandingBodiesTakeTheArguments(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, bodies CallLandingBodies, args ValueIdArray, argImmutableNames WriteBlameArray, memo SettledMemo)
	var landing = bodies.impls.clone()
	landing.sort()
	let range = project.opRanges.get(opIdx)

	for calleeIndex in landing 'eachLandingBody'
		let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("checkLandingBodiesTakeTheArguments: functions.get OOB at {calleeIndex}")

		if bodyIsUnreadable(calleeFunc) or not project.funcSignatures.contains(calleeFunc.name) 'nothingToJudgeAgainst'
			continue
		end 'nothingToJudgeAgainst'

		view sig = try project.funcSignatures.get(calleeFunc.name) otherwise panic("checkLandingBodiesTakeTheArguments: funcSignatures.get failed after contains for '{String.from(calleeFunc.name)}'")

		for position in 0 upto userArityOfIndirectCall(args) 'eachArg'
			if position >= calleeFunc.paramCount or not paramTagCarriesACapability(project, sig: sig, func: calleeFunc, position: position) 'aValueParameter'
				continue
			end 'aValueParameter'

			let argId = try args.get(position) otherwise panic("checkLandingBodiesTakeTheArguments: args.get OOB at {position} below the supplied count")

			if refuseArgumentAtParameter(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, opIdx: opIdx, calleeFunc: calleeFunc, calleeIndex: calleeIndex, sig: sig, position: position, argId: argId, argIndex: position, argImmutableNames: argImmutableNames, range: range, memo: memo) 'refused'
				return
			end 'refused'
		end 'eachArg'
	end 'eachLandingBody'
end 'checkLandingBodiesTakeTheArguments'

function checkAdaptingResultArguments(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, callerIndex ElementIndex, opIdx ElementIndex, callee ByteArray, args ValueIdArray, argLabels NameRoster, memo SettledMemo)
	let calleeIndex = try facts.indexOf(callee) otherwise return
	let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("checkAdaptingResultArguments: functions.get OOB at {calleeIndex}")

	if resultFromPositionCount(calleeFunc) < 2 'adaptsToAtMostOne'
		return
	end 'adaptsToAtMostOne'

	view sig = try project.funcSignatures.get(callee) otherwise return
	let kinds = sourceKindsOf(project, funcNames: funcNames, facts: facts, func: func, callerIndex: callerIndex, calleeFunc: calleeFunc, sig: sig, args: args, argLabels: argLabels, memo: memo)

	if not sourcesAreMixed(kinds) 'notMixed'
		return
	end 'notMixed'

	var names = ""

	for position in 0 upto calleeFunc.paramCount 'eachPosition'
		if maskHasParam(calleeFunc.resultFromParamMask, param: position) 'joined'
			names.append("or " if not names.isEmpty() else "")
			names.append("'{displayParamName(try sig.paramNames.get(position) otherwise panic("checkAdaptingResultArguments: paramNames.get OOB at {position}"))}' ")
		end 'joined'
	end 'eachPosition'

	let range = project.opRanges.get(opIdx)
	reportPositioned(project, code: ErrorCode.semanticArgumentClassesDisagree, message: "{functionDisplay(project, func: calleeFunc).memberQuoted()} returns {names.trim()}; they must both be mutable or both immutable here", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
end 'checkAdaptingResultArguments'

typealias SourceKinds = bits(8)

let NoSourceKinds = 0 as SourceKinds

let MutableSource = 1 as SourceKinds

let ImmutableSource = 2 as SourceKinds

let ReadOnlySource = 4 as SourceKinds

let UnknownSource = 8 as SourceKinds

function sourceKindOf(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, callerIndex ElementIndex, argId ValueId, memo SettledMemo) returns SourceKinds
	if not valueCarriesACapability(project, func: func, value: argId) 'aValueHasNoCapability'
		return NoSourceKinds
	end 'aValueHasNoCapability'

	if let parameter = try memo.unmarkedParameterBehind(project, value: argId) 'anUnmarkedParameter'
		let fixed = try facts.fixedCapabilityAt(callerIndex, position: parameter) otherwise return ReadOnlySource

		return MutableSource if fixed == ValueCapability.mutable else ReadOnlySource
	end 'anUnmarkedParameter'

	if memo.isSettling(argId) 'aLoopCarriedSource'
		memo.noteRead(argId)
		return NoSourceKinds
	end 'aLoopCarriedSource'

	return match settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: argId, memo: memo) 'capability'
		mutable or
		temporary or
		isolated gives MutableSource
		immutable gives ImmutableSource
		paused gives ReadOnlySource
		unknown gives UnknownSource
	end 'capability'
end 'sourceKindOf'

function sourceKindsOf(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, callerIndex ElementIndex, calleeFunc IrFunction, sig FuncSignature, args ValueIdArray, argLabels NameRoster, memo SettledMemo) returns SourceKinds
	var kinds = NoSourceKinds

	for i in 0 upto args.count() 'eachArg'
		let label = try argLabels.get(i) otherwise panic("sourceKindsOf: argLabels.get OOB at {i} — a call's argument columns are parallel by construction")
		let position = try argSlotPosition(sig.paramNames, argIndex: i as ParamCount, label: label) otherwise continue

		if not maskHasParam(calleeFunc.resultFromParamMask, param: position) or declaredCapabilityOf(sig, position: position) == ParamCapability.immutable 'notASource'
			continue
		end 'notASource'

		kinds = kinds or sourceKindOf(project, funcNames: funcNames, facts: facts, func: func, callerIndex: callerIndex, argId: try args.get(i) otherwise panic("sourceKindsOf: args.get OOB at {i} below its own count"), memo: memo)
	end 'eachArg'

	return kinds
end 'sourceKindsOf'

function sourcesInclude(kinds SourceKinds, wanted SourceKinds) returns bool
	return (kinds and wanted) != 0
end 'sourcesInclude'

function sourcesAreMixed(kinds SourceKinds) returns bool
	return sourcesInclude(kinds, wanted: MutableSource) and sourcesInclude(kinds, wanted: ImmutableSource) and not sourcesInclude(kinds, wanted: ReadOnlySource) and not sourcesInclude(kinds, wanted: UnknownSource)
end 'sourcesAreMixed'

function refusalOfArgument(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, calleeFunc IrFunction, calleeIndex ElementIndex, position ParamCount, paramClass ParamClass, capability ValueCapability, subject String) returns String
	let name = functionDisplay(project, func: calleeFunc).memberQuoted()

	match paramClass 'paramClass'
		mutableOnly then return refusalOfMutableOnly(project, funcNames: funcNames, facts: facts, name: name, calleeIndex: calleeIndex, position: position, capability: capability, subject: subject)
		immutableOnly then return refusalOfImmutableOnly(project, funcNames: funcNames, facts: facts, name: name, calleeIndex: calleeIndex, position: position, capability: capability, subject: subject)
		anyCapability or
		both or
		isolatedParam then panic("refusalOfArgument: a '{paramClass.name}' parameter refuses nothing, and `argumentClassRefuses` says so first")
	end 'paramClass'
end 'refusalOfArgument'

function argumentClassRefuses(paramClass ParamClass, capability ValueCapability) returns bool
	return match paramClass 'paramClass'
		mutableOnly gives capabilityIsReadOnly(capability)
		immutableOnly gives capabilityBreaksAFrozenNeed(capability)
		anyCapability or
		both or
		isolatedParam gives false
	end 'paramClass'
end 'argumentClassRefuses'

function refusalOfMutableOnly(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, name String, calleeIndex ElementIndex, position ParamCount, capability ValueCapability, subject String) returns String
	let phrase = genericNeedPhrase(project, funcNames: funcNames, facts: facts, index: calleeIndex, position: position, mutable: true)
	let chain = needChainText(project, funcNames: funcNames, facts: facts, index: calleeIndex, position: position, mutable: true)
	return needsWritableRefusal("{name} {phrase}{chain}", subject: subject, capability: capability)
end 'refusalOfMutableOnly'

function refusalOfImmutableOnly(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, name String, calleeIndex ElementIndex, position ParamCount, capability ValueCapability, subject String) returns String
	let phrase = genericNeedPhrase(project, funcNames: funcNames, facts: facts, index: calleeIndex, position: position, mutable: false)
	let chain = needChainText(project, funcNames: funcNames, facts: facts, index: calleeIndex, position: position, mutable: false)
	return needsFrozenRefusal("{name} {phrase}{chain}", subject: subject, capability: capability)
end 'refusalOfImmutableOnly'

function checkSpawnArguments(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, op MaxonOp, memo SettledMemo)
	match op 'op'
		serviceSpawn(_, _, _, _, callee, args, argLabels, argRanges, argImmutableNames, _, _, _) then checkCallArguments(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, opIdx: opIdx, callee: callee, args: args, argLabels: argLabels, argRanges: argRanges, argImmutableNames: argImmutableNames, firstJudged: ReceiverArgumentIndex, memo: memo)
		default panic("checkSpawnArguments: handed an op that is not a service spawn")
	end 'op'
end 'checkSpawnArguments'

function checkReturnedValue(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, op MaxonOp, memo SettledMemo)
	let retVal = try returnedResultValueOf(op) otherwise panic("checkReturnedValue: handed an op that is not a value return")
	checkReturnFitsDeclaredResult(project, module: module, funcNames: funcNames, facts: facts, func: func, opIdx: opIdx, retVal: retVal, memo: memo)
end 'checkReturnedValue'

function checkRequirementArguments(project Project, signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, func IrFunction, opIdx ElementIndex, op MaxonOp, memo SettledMemo)
	let parts = try witnessCallPartsOf(op) otherwise panic("checkRequirementArguments: handed an op that is not a witness dispatch")
	let args = parts.0
	let argImmutableNames = parts.1
	let methodIndex = parts.2
	let interfaceDeclIndex = parts.3
	let slot = witnessSlotAt(signatures, interfaces: signatures.interfaceMap(), witnessSlots: witnessSlots, interfaceDeclIndex: interfaceDeclIndex, methodIndex: methodIndex)
	let first = requirementFirstPosition(slot.method)
	let requirementName = "{String.from(slot.sourceInterfaceName)}.{String.from(slot.method.name)}"

	for position in 0 upto args.count() 'eachArg'
		let declared = requirementCapabilityAt(slot.method, position: position as ParamCount, first: first)
		let argId = try args.get(position) otherwise panic("checkRequirementArguments: args.get OOB at {position} below its own count")

		if checkDeclaredArgument(project, func: func, opIdx: opIdx, boundary: requirementName, declared: declared, argId: argId, argIndex: position as ParamCount, argImmutableNames: argImmutableNames, atTheReceiver: position < first, memo: memo) 'refused'
			return
		end 'refused'
	end 'eachArg'
end 'checkRequirementArguments'

function checkDeclaredArgument(project Project, func IrFunction, opIdx ElementIndex, boundary String, declared ParamCapability, argId ValueId, argIndex ParamCount, argImmutableNames WriteBlameArray, atTheReceiver bool, memo SettledMemo) returns bool
	if declared == ParamCapability.unmarked or (declared != ParamCapability.isolated and memo.isAnUnmarkedParameterValue(project, value: argId)) 'noDemandHere'
		return false
	end 'noDemandHere'

	let capability = argumentCapabilityOf(project, func: func, argId: argId)

	if declared == ParamCapability.mutable and capability == ValueCapability.paused and memo.windowPausesOperand(opIdx, argIndex: argIndex) 'theWindowCheckSpeaksForIt'
		return false
	end 'theWindowCheckSpeaksForIt'

	let range = project.opRanges.get(opIdx)

	if declared == ParamCapability.isolated 'anIsolatedPosition'
		let verdict = storeVerdict(ParamCapability.isolated, value: capability, isValueType: false, isSlotRead: false)

		if verdict == StoreVerdict.fits or verdict == StoreVerdict.recovers 'isolatedEnough'
			return false
		end 'isolatedEnough'

		reportPositioned(project, code: ErrorCode.semanticIsolatedRecoverNeedsCleanInputs, message: isolatedRecoveryRefusal(argumentSubject(func, opIdx: opIdx, argImmutableNames: argImmutableNames, index: argIndex, atTheReceiver: atTheReceiver), advice: "; pass a copy"), line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
		return true
	end 'anIsolatedPosition'

	if not declaredArgumentIsRefused(declared, capability: capability) 'accepted'
		return false
	end 'accepted'

	let message = refusalOfDeclaredArgument(boundary, declared: declared, capability: capability, subject: argumentSubject(func, opIdx: opIdx, argImmutableNames: argImmutableNames, index: argIndex, atTheReceiver: atTheReceiver), atTheReceiver: atTheReceiver)
	reportPositioned(project, code: ErrorCode.semanticArgumentCapabilityRefused, message: message, line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
	return true
end 'checkDeclaredArgument'

function declaredArgumentIsRefused(declared ParamCapability, capability ValueCapability) returns bool
	return (declared == ParamCapability.mutable and capabilityIsReadOnly(capability)) or (declared == ParamCapability.immutable and capabilityBreaksAFrozenNeed(capability))
end 'declaredArgumentIsRefused'

function refusalOfDeclaredArgument(boundary String, declared ParamCapability, capability ValueCapability, subject String, atTheReceiver bool) returns String
	let declaration = "`mutable self`" if declared == ParamCapability.mutable and atTheReceiver else "`immutable self`" if atTheReceiver else "`{declarationWordOf(declared)}` parameter"

	if declared == ParamCapability.mutable 'needsAWritableOne'
		return needsWritableRefusal("'{boundary}' takes {declaration}", subject: subject, capability: capability)
	end 'needsAWritableOne'

	return needsFrozenRefusal("'{boundary}' is declared {declaration}", subject: subject, capability: capability)
end 'refusalOfDeclaredArgument'

function checkFunctionValueCall(project Project, funcNames FunctionNameIndex, provenance ProvenanceTracer, facts CapabilityFacts, calls CallSummaryIndex, func IrFunction, opIdx ElementIndex, op MaxonOp, memo SettledMemo)
	let parts = match op 'op'
		indirectCall(_, callee, args, argImmutableNames) gives (callee, args, argImmutableNames)
		default panic("checkFunctionValueCall: handed an op that is not an indirect call")
	end 'op'

	checkMutableFunctionCall(project, func: func, opIdx: opIdx, calleeValue: parts.0)
	view shape = try functionTypeRegistryOf(project).aliasShapes.get(functionValueGoverningName(project, func: func, value: parts.0)) otherwise 'undeclaredBoundary'
		let bodies = calls.functionValueBodiesCalledThrough(func, callee: parts.0)
		checkLandingBodiesTakeTheArguments(project, funcNames: funcNames, provenance: provenance, facts: facts, func: func, opIdx: opIdx, bodies: bodies, args: parts.1, argImmutableNames: parts.2, memo: memo)
		return
	end 'undeclaredBoundary'

	let alias = aliasDisplayOf(project, name: functionValueGoverningName(project, func: func, value: parts.0))

	for position in 0 upto userArityOfIndirectCall(parts.1) 'eachArg'
		let argId = try parts.1.get(position) otherwise panic("checkFunctionValueCall: args.get OOB at {position} below the supplied count")

		if checkDeclaredArgument(project, func: func, opIdx: opIdx, boundary: alias, declared: declaredCapabilityAt(shape.paramCapabilities, position: position as ParamCount), argId: argId, argIndex: position as ParamCount, argImmutableNames: parts.2, atTheReceiver: false, memo: memo) 'refused'
			return
		end 'refused'
	end 'eachArg'
end 'checkFunctionValueCall'

function checkMutableFunctionCall(project Project, func IrFunction, opIdx ElementIndex, calleeValue ValueId)
	if not functionValueIsMutable(project, func: func, value: calleeValue) 'aPlainFunction'
		return
	end 'aPlainFunction'

	let capability = argumentCapabilityOf(project, func: func, argId: calleeValue)

	if not capabilityIsReadOnly(capability) 'writableEnough'
		return
	end 'writableEnough'

	let range = project.opRanges.get(opIdx)
	let alias = aliasDisplayOf(project, name: functionValueGoverningName(project, func: func, value: calleeValue))
	reportPositioned(project, code: ErrorCode.semanticMutableFunctionConversionRefused, message: "'{alias}' mutates captures and cannot be called through {capabilityWord(capability)} data", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
end 'checkMutableFunctionCall'

function checkWrittenCapturesAreWritable(project Project, facts CapabilityFacts, func IrFunction)
	for site in func.capabilityNotes.captureSites 'eachCapture'
		let closureIndex = try facts.indexOf(site.closureName) otherwise continue
		let written = try facts.mutableOnly.get(closureIndex) otherwise panic("checkWrittenCapturesAreWritable: mutableOnly.get OOB at {closureIndex}")

		if not maskHasParam(written, param: site.position) 'notWritten'
			continue
		end 'notWritten'

		let capability = argumentCapabilityOf(project, func: func, argId: site.value)

		if capability != ValueCapability.immutable and (capability != ValueCapability.paused or site.pausedWhenCaptured) 'writable'
			continue
		end 'writable'

		let name = String.from(site.name)
		let reason = JoinedReadOnlyReason if capability == ValueCapability.paused else ""
		reportPositioned(project, code: ErrorCode.semanticWriteThroughReadOnly, message: "cannot write '{name}' through the closure that captures it: '{name}' is {capabilityWord(capability)}{reason}", line: site.line, column: site.column, filePath: func.sourceFilePath)
	end 'eachCapture'
end 'checkWrittenCapturesAreWritable'

module typealias TiedCarrierMap = Map with (ValueId, ElementIndex)

module function tiedCarrierOwnersOf(module MaxonModule, func IrFunction) returns TiedCarrierMap
	var owners = TiedCarrierMap.create()

	for tiedOp in func.capabilityNotes.tiedAsyncOps 'eachTiedAsync'
		let promise = try tiedPromiseOf(module, opIdx: tiedOp) otherwise continue

		for carrier in promiseCarriersOf(module, func: func, promise: promise) 'eachCarrier'
			if not owners.contains(carrier) 'firstOwner'
				owners.upsert(carrier, value: tiedOp)
			end 'firstOwner'
		end 'eachCarrier'
	end 'eachTiedAsync'

	return owners
end 'tiedCarrierOwnersOf'

function checkTiedPromisesAreOnlyAwaited(project Project, module MaxonModule, func IrFunction, owners TiedCarrierMap)
	if owners.count() == 0 'noTiedPromise'
		return
	end 'noTiedPromise'

	var operands = ValueIdArray.create(0)

	for opIdx in module.liveOpIndices(func) 'eachOp'
		let op = try module.ops.get(opIdx) otherwise panic("checkTiedPromisesAreOnlyAwaited: ops.get OOB at {opIdx}")

		if project.opRanges.get(opIdx).line == 0 or tiedPromiseUseIsHarmless(op) 'notAUse'
			continue
		end 'notAUse'

		if let held = try heldValueOf(op) 'aHold'
			_ = held
			continue
		end 'aHold'

		if let drained = try awaitedPromiseOf(op) 'anAwait'
			_ = drained
			continue
		end 'anAwait'

		maxonOpOperandValues(op, into: operands)

		for operand in operands 'eachOperand'
			let tiedOp = try owners.get(operand) otherwise continue

			if tiedOp == opIdx 'itsOwnSpawn'
				continue
			end 'itsOwnSpawn'

			let range = project.opRanges.get(opIdx)
			reportPositioned(project, code: ErrorCode.semanticTiedPromiseRefused, message: "the promise of this `async` call is tied to the mutable data it was given: it is awaited or cancelled and nothing else, never returned, stored, captured, sent or passed on, because the coroutine still holds the caller's data", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
			break
		end 'eachOperand'
	end 'eachOp'
end 'checkTiedPromisesAreOnlyAwaited'

function tiedPromiseUseIsHarmless(op MaxonOp) returns bool
	let callee = try directCalleeOf(op) otherwise return false
	return callee.equals(GtPromiseDropName) or callee.equals(GtIsCompleteName)
end 'tiedPromiseUseIsHarmless'

function checkNoPromiseIsDropped(project Project, module MaxonModule, func IrFunction, owners TiedCarrierMap)
	var operands = ValueIdArray.create(0)
	let notes = func.capabilityNotes

	for position in 0 upto notes.droppedPromiseOps.count() 'eachDrop'
		let dropOp = try notes.droppedPromiseOps.get(position) otherwise panic("checkNoPromiseIsDropped: droppedPromiseOps.get OOB at {position}")
		maxonOpOperandValues(try module.ops.get(dropOp) otherwise panic("checkNoPromiseIsDropped: ops.get OOB at {dropOp}"), into: operands)
		let dropped = try operands.get(0) otherwise panic("checkNoPromiseIsDropped: a promise drop at op {dropOp} names no promise")
		let name = String.from(try notes.droppedPromiseNames.get(position) otherwise panic("checkNoPromiseIsDropped: droppedPromiseNames.get OOB at {position} — the columns are parallel"))
		let range = project.opRanges.get(dropOp)
		let filePath = authoredFileOf(project, func: func, opIndex: dropOp)

		if let tiedOp = try owners.get(dropped) 'aTiedPromise'
			let spawn = project.opRanges.get(tiedOp)
			fileSecondary(project, code: ErrorCode.semanticTiedPromiseRefused, message: droppedTiedPromiseMessage(name, spawn: spawn), line: range.line, column: range.column, filePath: filePath)
			continue
		end 'aTiedPromise'

		fileSecondary(project, code: ErrorCode.semanticPromiseDropped, message: droppedPromiseMessage(name), line: range.line, column: range.column, filePath: filePath)
	end 'eachDrop'
end 'checkNoPromiseIsDropped'

function droppedTiedPromiseMessage(name String, spawn SourceRange) returns String
	if name.isEmpty() 'unnamed'
		return "this exit leaves the tied promise of the `async` call at {spawn.line}:{spawn.column} neither awaited nor cancelled: `await` it or call `.cancel()` on it before this exit"
	end 'unnamed'

	return "this exit leaves '{name}' neither awaited nor cancelled, and the coroutine of the `async` call at {spawn.line}:{spawn.column} still holds the data it was given: `await {name}` or call `{name}.cancel()` before this exit"
end 'droppedTiedPromiseMessage'

function droppedPromiseMessage(name String) returns String
	if name.isEmpty() 'unnamed'
		return "this drops a promise that was never awaited, cancelled, stored or returned: `await` it, call `.cancel()` on it, store it or return it"
	end 'unnamed'

	return "this drops '{name}', which was never awaited, cancelled, stored or returned: `await {name}`, call `{name}.cancel()`, store it or return it"
end 'droppedPromiseMessage'

function heldValueOf(op MaxonOp) returns ValueId throws AbsentError
	match op 'op'
		holdValue(_, held, _, _, _) then return held
		holdEnd(_, held, _, _, _) then return held
		default throws AbsentError.absent
	end 'op'
end 'heldValueOf'

function promiseCarriersOf(module MaxonModule, func IrFunction, promise ValueId) returns ValueIdArray
	var carriers = ValueIdArray.create(0)
	carriers.push(promise)
	var grew = true

	while grew 'untilNoMoreCarriers'
		grew = false

		for blockRef in func.blockRefs 'eachBlock'
			let block = module.getBlock(blockRef)

			for edge in block.branchEdges 'eachEdge'
				let target = try module.getBlockByIdIn(func, id: edge.targetBlockId) otherwise continue

				for position in 0 upto edge.argIds.count() 'eachArgument'
					let argument = try edge.argIds.get(position) otherwise continue

					if not carriers.contains(argument) 'notThePromise'
						continue
					end 'notThePromise'

					let phi = (try target.blockArgs.get(position) otherwise continue).valueId

					if not carriers.contains(phi) 'aNewCarrier'
						carriers.push(phi)
						grew = true
					end 'aNewCarrier'
				end 'eachArgument'
			end 'eachEdge'
		end 'eachBlock'
	end 'untilNoMoreCarriers'

	return carriers
end 'promiseCarriersOf'

module function requireCallOrTryCall(op MaxonOp) throws AbsentError
	match op 'op'
		call or
		tryCall then return
		default throws AbsentError.absent
	end 'op'
end 'requireCallOrTryCall'

function settledArgumentCapability(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, argId ValueId, memo SettledMemo) returns ValueCapability
	if let answered = try memo.settled(argId) 'alreadySettled'
		memo.noteRead(argId)
		return answered
	end 'alreadySettled'

	let provisional = argumentCapabilityOf(project, func: func, argId: argId)
	memo.record(argId, capability: provisional)
	memo.beginSettling(argId)
	let settled = settledOnceBegun(project, funcNames: funcNames, facts: facts, func: func, argId: argId, provisional: provisional, memo: memo)

	if memo.endSettling(argId) 'independentOfOpenValues'
		memo.record(argId, capability: settled)
	end 'independentOfOpenValues' else 'readAnOpenValue'
		memo.forget(argId)
	end 'readAnOpenValue'

	return settled
end 'settledArgumentCapability'

function settledOnceBegun(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, argId ValueId, provisional ValueCapability, memo SettledMemo) returns ValueCapability
	if let opIdx = try memo.sources.settlingOpOf(argId) 'aResult'
		let op = try facts.ir.ops.get(opIdx) otherwise panic("settledArgumentCapability: ops.get OOB at {opIdx}")
		return settledResultCapability(project, funcNames: funcNames, facts: facts, func: func, op: op, provisional: provisional, memo: memo)
	end 'aResult'

	return settledByItsArms(project, funcNames: funcNames, facts: facts, func: func, argId: argId, provisional: provisional, memo: memo)
end 'settledOnceBegun'

function settledByItsArms(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, argId ValueId, provisional ValueCapability, memo SettledMemo) returns ValueCapability
	var visiting = ValueIdArray.create(0)
	let judged = settledMergeOf(project, funcNames: funcNames, facts: facts, func: func, phi: argId, provisional: provisional, memo: memo, visiting: visiting)

	if not judged.1 'decidedByTheParser'
		return provisional
	end 'decidedByTheParser'

	return judged.0
end 'settledByItsArms'

enum PhiArmKind
	judgedElsewhere
	divergingPlaceholder
	exitChainNode
	nestedMerge
	plainArm
end 'PhiArmKind'

enum PhiArmPolicy
	againstProvisional
	besideParameterArms
end 'PhiArmPolicy'

function phiArmKindOf(project Project, memo SettledMemo, arm ValueId, policy PhiArmPolicy, visiting ValueIdArray) returns PhiArmKind
	if memo.isAnUnmarkedParameterValue(project, value: arm) 'aParameterJudgedByItsEdge'
		return PhiArmKind.judgedElsewhere
	end 'aParameterJudgedByItsEdge'

	if policy == PhiArmPolicy.againstProvisional and valueIdArrayContains(visiting, value: arm) 'alreadyOnThePath'
		return PhiArmKind.judgedElsewhere
	end 'alreadyOnThePath'

	if memo.definesALiteral(arm) 'aLiteralArm'
		return PhiArmKind.divergingPlaceholder if policy == PhiArmPolicy.againstProvisional else PhiArmKind.judgedElsewhere
	end 'aLiteralArm'

	if policy == PhiArmPolicy.besideParameterArms and callerParamMaskOf(project, sources: memo.sources, value: arm) != NoParamPositions 'frozenByTheResult'
		return PhiArmKind.judgedElsewhere
	end 'frozenByTheResult'

	if policy == PhiArmPolicy.againstProvisional and memo.isAnExitChainPhi(arm) 'aNodeOfTheExitChain'
		return PhiArmKind.exitChainNode
	end 'aNodeOfTheExitChain'

	return PhiArmKind.nestedMerge if memo.mergesArms(arm) else PhiArmKind.plainArm
end 'phiArmKindOf'

function settledMergeOf(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, phi ValueId, provisional ValueCapability, memo SettledMemo, visiting ValueIdArray) returns (ValueCapability, bool)
	let arms = try memo.armsOfPhi(phi) otherwise return (provisional, false)
	visiting.push(phi)
	var joined = provisional
	var joinedAny = false
	var needsJudging = false

	for arm in arms 'eachArm'
		let kind = phiArmKindOf(project, memo: memo, arm: arm, policy: PhiArmPolicy.againstProvisional, visiting: visiting)

		if kind == PhiArmKind.judgedElsewhere 'judgedElsewhere'
			continue
		end 'judgedElsewhere'

		if kind == PhiArmKind.divergingPlaceholder 'aDivergingArmsPlaceholder'
			needsJudging = true
			continue
		end 'aDivergingArmsPlaceholder'

		let settledArm = settledArmOf(project, funcNames: funcNames, facts: facts, func: func, arm: arm, kind: kind, memo: memo, visiting: visiting)
		needsJudging = needsJudging or settledArm.1
		joined = joinedCapability(joined, second: settledArm.0) if joinedAny else settledArm.0
		joinedAny = true
	end 'eachArm'

	return (joined, needsJudging and joinedAny)
end 'settledMergeOf'

function settledArmOf(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, arm ValueId, kind PhiArmKind, memo SettledMemo, visiting ValueIdArray) returns (ValueCapability, bool)
	match kind 'kind'
		exitChainNode then return (settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: arm, memo: memo), true)
		nestedMerge then return settledMergeOf(project, funcNames: funcNames, facts: facts, func: func, phi: arm, provisional: argumentCapabilityOf(project, func: func, argId: arm), memo: memo, visiting: visiting)
		plainArm then return (settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: arm, memo: memo), memo.sources.hasASettlingOp(arm))
		judgedElsewhere or
		divergingPlaceholder then panic("settledArmOf: a {kind.name} arm is skipped or flagged before it is settled")
	end 'kind'
end 'settledArmOf'

function settledResultCapability(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, op MaxonOp, provisional ValueCapability, memo SettledMemo) returns ValueCapability
	let parts = try directCallPartsOf(op) otherwise return provisional
	let callee = parts.0
	let args = parts.1
	let labels = parts.2
	let calleeIndex = try facts.indexOf(callee) otherwise return provisional
	let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("settledResultCapability: functions.get OOB at {calleeIndex}")
	view sig = try project.funcSignatures.get(callee) otherwise return provisional

	if calleeFunc.resultIsUnknown() 'aResultTheParserCouldNotType'
		return ValueCapability.unknown
	end 'aResultTheParserCouldNotType'

	if bodyIsUnreadable(calleeFunc) 'nothingToJudge'
		return provisional
	end 'nothingToJudge'

	if calleeFunc.resultMayBeFrozen 'aMixedGetter'
		return ValueCapability.paused
	end 'aMixedGetter'

	if calleeFunc.resultFromParamMask == NoParamPositions 'noSourceToJudge'
		return ValueCapability.mutable
	end 'noSourceToJudge'

	let callerIndex = try facts.indexOf(func.name) otherwise return provisional
	let kinds = sourceKindsOf(project, funcNames: funcNames, facts: facts, func: func, callerIndex: callerIndex, calleeFunc: calleeFunc, sig: sig, args: args, argLabels: labels, memo: memo)

	if sourcesInclude(kinds, wanted: UnknownSource) 'anUnknownSource'
		return ValueCapability.unknown
	end 'anUnknownSource'

	if sourcesInclude(kinds, wanted: ReadOnlySource) 'readOnly'
		return ValueCapability.paused
	end 'readOnly'

	if sourcesAreMixed(kinds) 'mixed'
		return provisional
	end 'mixed'

	if sourcesInclude(kinds, wanted: ImmutableSource) 'frozen'
		return ValueCapability.paused if calleeFunc.resultHasOtherPath else ValueCapability.immutable
	end 'frozen'

	return ValueCapability.mutable
end 'settledResultCapability'

function checkDeferredResultWrites(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, memo SettledMemo)
	let notes = func.capabilityNotes

	for position in 0 upto notes.resultWriteOps.count() 'eachDeferredWrite'
		let opIdx = try notes.resultWriteOps.get(position) otherwise panic("checkDeferredResultWrites: resultWriteOps.get OOB at {position}")
		let op = try facts.ir.ops.get(opIdx) otherwise panic("checkDeferredResultWrites: ops.get OOB at {opIdx}")
		let writableAtParse = try notes.resultWriteWritable.get(position) otherwise panic("checkDeferredResultWrites: resultWriteWritable.get OOB at {position}")
		let settled = settledResultCapability(project, funcNames: funcNames, facts: facts, func: func, op: op, provisional: ValueCapability.mutable if writableAtParse else ProvisionalForAWrite, memo: memo)

		if settled == ValueCapability.mutable or settled == ValueCapability.temporary or settled == ValueCapability.isolated or settled == ValueCapability.unknown 'writable'
			continue
		end 'writable'

		let field = String.from(try notes.resultWriteFields.get(position) otherwise panic("checkDeferredResultWrites: resultWriteFields.get OOB at {position}"))
		let place = String.from(try notes.resultWritePlaces.get(position) otherwise panic("checkDeferredResultWrites: resultWritePlaces.get OOB at {position}"))
		let line = try notes.resultWriteLines.get(position) otherwise panic("checkDeferredResultWrites: resultWriteLines.get OOB at {position}")
		let column = try notes.resultWriteColumns.get(position) otherwise panic("checkDeferredResultWrites: resultWriteColumns.get OOB at {position}")
		reportPositioned(project, code: ErrorCode.semanticWriteThroughReadOnly, message: "cannot write '{field}' through '{place}', which is {capabilityWord(settled)}", line: line, column: column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
	end 'eachDeferredWrite'
end 'checkDeferredResultWrites'

module function requireServiceReplyCell(op MaxonOp) throws AbsentError
	match op 'op'
		serviceReplyCell then return
		default throws AbsentError.absent
	end 'op'
end 'requireServiceReplyCell'

function tiedPromiseOf(module MaxonModule, opIdx ElementIndex) returns ValueId throws AbsentError
	let op = try module.ops.get(opIdx) otherwise throw AbsentError.absent

	match op 'op'
		asyncCall(result, _, _, _, _, _, _, _) then return result
		default throws AbsentError.absent
	end 'op'
end 'tiedPromiseOf'

function returnsADeadZero(module MaxonModule, func IrFunction, retVal ValueId) returns bool
	let producer = try opDefiningValue(module, func: func, value: retVal) otherwise return false
	try requireLiteralOp(producer) otherwise return false
	return true
end 'returnsADeadZero'

module function requireLiteralOp(op MaxonOp) throws AbsentError
	match op 'op'
		literal then return
		default throws AbsentError.absent
	end 'op'
end 'requireLiteralOp'

function checkReturnFitsDeclaredResult(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, retVal ValueId, memo SettledMemo)
	view sig = try project.funcSignatures.get(func.name) otherwise return

	if sig.returnCapability == ResultCapability.unmarked or sig.returnCapability == ResultCapability.isolated or returnsADeadZero(module, func: func, retVal: retVal) 'declaresNothingToFit'
		return
	end 'declaresNothingToFit'

	var capability = settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: retVal, memo: memo)

	if capabilityBreaksAFrozenNeed(capability) and sig.returnCapability == ResultCapability.immutable and memo.mergesArms(retVal) 'parametersAreFrozenByTheResult'
		var visited = ValueIdArray.create(0)
		capability = settledBesideParameterArms(project, funcNames: funcNames, facts: facts, func: func, phi: retVal, memo: memo, visited: visited)
	end 'parametersAreFrozenByTheResult'

	let message = try refusalOfReturn(sig.returnCapability, capability: capability, returnsAParameter: callerParamMaskOf(project, sources: memo.sources, value: retVal) != NoParamPositions) otherwise return
	let range = project.opRanges.get(opIdx)
	reportPositioned(project, code: ErrorCode.semanticResultPathsDisagree, message: message, line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
end 'checkReturnFitsDeclaredResult'

function settledBesideParameterArms(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, phi ValueId, memo SettledMemo, visited ValueIdArray) returns ValueCapability
	if valueIdArrayContains(visited, value: phi) 'alreadyWalked'
		return ValueCapability.immutable
	end 'alreadyWalked'

	visited.push(phi)
	let arms = try memo.armsOfPhi(phi) otherwise return settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: phi, memo: memo)
	var joined = ValueCapability.immutable

	for arm in arms 'eachArm'
		let kind = phiArmKindOf(project, memo: memo, arm: arm, policy: PhiArmPolicy.besideParameterArms, visiting: visited)

		if kind == PhiArmKind.judgedElsewhere 'frozenByTheResult'
			continue
		end 'frozenByTheResult'

		if kind == PhiArmKind.nestedMerge 'aMergeOfItsOwn'
			joined = joinedCapability(joined, second: settledBesideParameterArms(project, funcNames: funcNames, facts: facts, func: func, phi: arm, memo: memo, visited: visited))
			continue
		end 'aMergeOfItsOwn'

		joined = joinedCapability(joined, second: settledArgumentCapability(project, funcNames: funcNames, facts: facts, func: func, argId: arm, memo: memo))
	end 'eachArm'

	return joined
end 'settledBesideParameterArms'

function refusalOfReturn(declared ResultCapability, capability ValueCapability, returnsAParameter bool) returns String throws AbsentError
	match declared 'declared'
		immutable then return try refusalOfReturnForImmutable(capability)
		mutable then return try refusalOfReturnForMutable(capability, returnsAParameter: returnsAParameter)
		unmarked or
		isolated then throw AbsentError.absent
	end 'declared'
end 'refusalOfReturn'

function refusalOfReturnForImmutable(capability ValueCapability) returns String throws AbsentError
	if not capabilityBreaksAFrozenNeed(capability) 'fits'
		throw AbsentError.absent
	end 'fits'

	let advice = freezeAdvice(capability, phrase: "; freeze it")
	return "a return does not fit the declared result: the returned value is {capabilityWord(capability)}, the result is immutable{advice}"
end 'refusalOfReturnForImmutable'

function refusalOfReturnForMutable(capability ValueCapability, returnsAParameter bool) returns String throws AbsentError
	if returnsAParameter 'aParametersData'
		return "a return does not fit the declared result: the returned value is a parameter's data, the result is mutable"
	end 'aParametersData'

	if capabilityIsReadOnly(capability) 'notWritable'
		return "a return does not fit the declared result: the returned value is {capabilityWord(capability)}, the result is mutable"
	end 'notWritable'

	throw AbsentError.absent
end 'refusalOfReturnForMutable'

function awaitedPromiseOf(op MaxonOp) returns ValueId throws AbsentError
	match op 'op'
		await (_, promise) then return promise
		tryAwait(_, _, promise) then return promise
		default throws AbsentError.absent
	end 'op'
end 'awaitedPromiseOf'

function repliedServiceOf(op MaxonOp) returns immutable ByteArray throws AbsentError
	match op 'op'
		serviceReplyCell(_, _, awaitedService) then return awaitedService
		default throws AbsentError.absent
	end 'op'
end 'repliedServiceOf'

function awaitDescription(project Project, module MaxonModule, func IrFunction, opIdx ElementIndex, promise ValueId) returns String
	let line = project.opRanges.get(opIdx).line

	if let origin = try opDefiningValue(module, func: func, value: promise) 'anOrigin'
		if let service = try repliedServiceOf(origin) 'aReply'
			return "it awaits a reply from '{String.from(service)}' at line {line}"
		end 'aReply'
	end 'anOrigin'

	return "it awaits a coroutine at line {line}"
end 'awaitDescription'

function directBlockingReason(project Project, module MaxonModule, func IrFunction, waits bool) returns String
	if bodyIsUnreadable(func) 'anOpaqueBody'
		return "its body cannot be read, so it is assumed to wait on another party" if waits else "its body cannot be read, so it is assumed to yield to another coroutine"
	end 'anOpaqueBody'

	for opIdx in module.liveOpIndices(func) 'eachOp'
		let promise = try awaitedPromiseOf(try module.ops.get(opIdx) otherwise panic("directBlockingReason: live op index not in module.ops")) otherwise continue
		return awaitDescription(project, module: module, func: func, opIdx: opIdx, promise: promise)
	end 'eachOp'

	return "it waits on another party" if waits else "it yields to another coroutine"
end 'directBlockingReason'

function blockingMarkOf(facts CapabilityFacts, index ElementIndex, waits bool) returns bool
	return facts.waits(index) if waits else facts.yields(index)
end 'blockingMarkOf'

function blockingPath(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, index ElementIndex, waits bool) returns (FuncIndexArray, CallEdgeKindArray) throws AbsentError
	let count = funcNames.functions.count()
	var seen = FixedBoolArray.create(count)
	var parents = FixedFuncIndexArray.create(count)
	parents.refill(index)
	var viaKinds = FixedCallEdgeKindArray.create(count)
	viaKinds.refill(CallEdgeKind.call)
	var queue = FuncIndexArray.create(0)
	queue.push(index)
	try seen.set(index, value: true) otherwise panic("blockingPath: seen.set OOB at {index}")
	var head = 0 as ElementIndex

	while head < queue.count() 'drain'
		let current = try queue.get(head) otherwise panic("blockingPath: queue.get OOB at {head}")
		head = head + 1
		let func = try funcNames.functions.get(current) otherwise panic("blockingPath: functions.get OOB at {current}")

		if blockingSeedOf(func, waits: waits, libraryFacts: project.libraryFacts) 'theCause'
			return blockingPathTo(current, index: index, parents: parents, viaKinds: viaKinds)
		end 'theCause'

		if bodyIsUnreadable(func) 'nothingToWalk'
			continue
		end 'nothingToWalk'

		for opIdx in module.liveOpIndices(func) 'eachOp'
			let edge = try callOrClosureEdgeOf(project, func: func, op: try module.ops.get(opIdx) otherwise panic("blockingPath: live op index not in module.ops")) otherwise continue
			let calleeIndex = try funcNames.byName.get(edge.0) otherwise continue

			if (try seen.get(calleeIndex) otherwise panic("blockingPath: seen.get OOB at {calleeIndex}")) or not edgeTransmits(edge.1, waits: waits) or not blockingMarkOf(facts, index: calleeIndex, waits: waits) 'notAnUnseenCause'
				continue
			end 'notAnUnseenCause'

			try seen.set(calleeIndex, value: true) otherwise panic("blockingPath: seen.set OOB at {calleeIndex}")
			try parents.set(calleeIndex, value: current) otherwise panic("blockingPath: parents.set OOB at {calleeIndex}")
			try viaKinds.set(calleeIndex, value: edge.1) otherwise panic("blockingPath: viaKinds.set OOB at {calleeIndex}")
			queue.push(calleeIndex)
		end 'eachOp'
	end 'drain'

	throw AbsentError.absent
end 'blockingPath'

function blockingPathTo(leaf ElementIndex, index ElementIndex, parents FixedFuncIndexArray, viaKinds FixedCallEdgeKindArray) returns (FuncIndexArray, CallEdgeKindArray)
	var backwards = FuncIndexArray.create(0)
	var backwardKinds = CallEdgeKindArray.create(0)
	var current = leaf
	backwards.push(current)
	backwardKinds.push(try viaKinds.get(current) otherwise panic("blockingPathTo: viaKinds.get OOB at {current}"))

	while current != index 'eachParent'
		current = try parents.get(current) otherwise panic("blockingPathTo: parents.get OOB at {current}")
		backwards.push(current)
		backwardKinds.push(try viaKinds.get(current) otherwise panic("blockingPathTo: viaKinds.get OOB at {current}"))
	end 'eachParent'

	var path = FuncIndexArray.create(backwards.count(), zeroed: false)
	var kinds = CallEdgeKindArray.create(backwards.count(), zeroed: false)

	for position in 0 upto backwards.count() 'eachStep'
		let reversed = backwards.count() - 1 - position
		path.push(try backwards.get(reversed) otherwise panic("blockingPathTo: backwards.get OOB at {reversed}"))
		kinds.push(try backwardKinds.get(reversed) otherwise panic("blockingPathTo: backwardKinds.get OOB at {reversed}"))
	end 'eachStep'

	return (path, kinds)
end 'blockingPathTo'

function edgeActionWord(kind CallEdgeKind) returns (String, String)
	return match kind 'kind'
		call gives ("call", "Call")
		async gives ("start", "Start")
		spawn gives ("spawn", "Spawn")
	end 'kind'
end 'edgeActionWord'

function hopPhrase(kind CallEdgeKind, callee String, first bool) returns String
	let verb = "{edgeActionWord(kind).0}s"

	return "it {verb} {callee}, which " if first else "{verb} {callee}, which "
end 'hopPhrase'

function blockingChain(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, index ElementIndex, waits bool) returns String
	let found = try blockingPath(project, module: module, funcNames: funcNames, facts: facts, index: index, waits: waits) otherwise panic("blockingChain: the facts mark '{String.from((try funcNames.functions.get(index) otherwise panic("blockingChain: functions.get OOB at {index}")).name)}' as blocking but no call, start or spawn path reaches a function that waits or yields itself")
	let path = found.0
	var text = ""

	for hop in 1 upto path.count() 'eachHop'
		let callee = try funcNames.functions.get(try path.get(hop) otherwise panic("blockingChain: path.get OOB at {hop}")) otherwise panic("blockingChain: functions.get OOB for the hop at {hop}")
		text.append(hopPhrase(try found.1.get(hop) otherwise panic("blockingChain: kinds.get OOB at {hop}"), callee: functionDisplay(project, func: callee).memberQuoted(), first: hop == 1))
	end 'eachHop'

	let leaf = try funcNames.functions.get(try path.get(path.count() - 1) otherwise panic("blockingChain: the path is never empty")) otherwise panic("blockingChain: functions.get OOB for the leaf")
	text.append(directBlockingReason(project, module: module, func: leaf, waits: waits))
	return text
end 'blockingChain'

function checkNoWaitInsideWindows(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, windowCallOps FuncIndexArray, windowCallLabels NameRoster)
	for position in 0 upto windowCallOps.count() 'eachWindowCall'
		let opIdx = try windowCallOps.get(position) otherwise panic("checkNoWaitInsideWindows: windowCallOps.get OOB at {position}")
		let label = try windowCallLabels.get(position) otherwise panic("checkNoWaitInsideWindows: windowCallLabels.get OOB at {position} — the two columns are parallel")
		let edge = try callOrClosureEdgeOf(project, func: func, op: try module.ops.get(opIdx) otherwise panic("checkNoWaitInsideWindows: opIdx {opIdx} not in module.ops")) otherwise continue
		let calleeIndex = try funcNames.byName.get(edge.0) otherwise continue

		let waits = facts.waits(calleeIndex) and edgeTransmits(edge.1, waits: true)

		if not waits and not (facts.yields(calleeIndex) and edgeTransmits(edge.1, waits: false)) 'theEdgeCarriesNeither'
			continue
		end 'theEdgeCarriesNeither'

		let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("checkNoWaitInsideWindows: functions.get OOB at {calleeIndex}")
		let reason = blockingChain(project, module: module, funcNames: funcNames, facts: facts, index: calleeIndex, waits: waits)
		let range = project.opRanges.get(opIdx)
		let verb = "wait" if waits else "yield"
		let action = edgeActionWord(edge.1)
		reportPositioned(project, code: ErrorCode.semanticWaitInsideWindow, message: "cannot {action.0} {functionDisplay(project, func: calleeFunc).memberQuoted()} inside '{String.from(label)}'; it may {verb} ({reason}). {action.1} it before or after the block", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
	end 'eachWindowCall'
end 'checkNoWaitInsideWindows'

function checkPausedOperandsAreNotWritten(project Project, module MaxonModule, signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction)
	let notes = func.capabilityNotes

	for slot in 0 upto notes.windowCallOps.count() 'eachWindowCall'
		let paused = try notes.windowCallPausedOperands.get(slot) otherwise panic("checkPausedOperandsAreNotWritten: windowCallPausedOperands.get OOB at {slot} — the window columns are parallel")

		if paused == NoParamPositions 'nothingPaused'
			continue
		end 'nothingPaused'

		let opIdx = try notes.windowCallOps.get(slot) otherwise panic("checkPausedOperandsAreNotWritten: windowCallOps.get OOB at {slot}")
		let op = try module.ops.get(opIdx) otherwise panic("checkPausedOperandsAreNotWritten: opIdx {opIdx} not in module.ops")
		let windowLabel = String.from(try notes.windowCallLabels.get(slot) otherwise panic("checkPausedOperandsAreNotWritten: windowCallLabels.get OOB at {slot}"))

		if checkPausedClosuresLeaveTheirCaptures(project, facts: facts, func: func, opIdx: opIdx, operands: windowCallOperandsOf(op), paused: paused, windowLabel: windowLabel) 'aClosureReachesItsCaptures'
			continue
		end 'aClosureReachesItsCaptures'

		match capabilityDoorOf(op) 'door'
			directCall then checkPausedDirectCall(project, funcNames: funcNames, facts: facts, func: func, opIdx: opIdx, op: op, paused: paused, windowLabel: windowLabel)
			witnessCall then checkPausedRequirementCall(project, signatures: signatures, witnessSlots: witnessSlots, func: func, opIdx: opIdx, op: op, paused: paused, windowLabel: windowLabel)
			functionValueCall then checkPausedFunctionValueCall(project, func: func, opIdx: opIdx, op: op, paused: paused, windowLabel: windowLabel)
			spawn then continue
			inert or
			returned then panic("checkPausedOperandsAreNotWritten: a window call note names an op that is not a call, a dispatch or an indirect call")
		end 'door'
	end 'eachWindowCall'
end 'checkPausedOperandsAreNotWritten'

function windowCallOperandsOf(op MaxonOp) returns ValueIdArray
	match capabilityDoorOf(op) 'door'
		directCall then return (try directCallPartsOf(op) otherwise panic("windowCallOperandsOf: handed a direct call door that is not a call")).1
		witnessCall then return (try witnessCallPartsOf(op) otherwise panic("windowCallOperandsOf: handed a witness door that is not a dispatch")).0
		functionValueCall then return indirectCallArgumentsOf(op)
		spawn then return ValueIdArray.create(0)
		inert or
		returned then panic("windowCallOperandsOf: a window call note names an op that is not a call, a dispatch or an indirect call")
	end 'door'
end 'windowCallOperandsOf'

function indirectCallArgumentsOf(op MaxonOp) returns ValueIdArray
	match op 'op'
		indirectCall(_, _, args, _) then return args
		default panic("indirectCallArgumentsOf: handed an op that is not an indirect call")
	end 'op'
end 'indirectCallArgumentsOf'

function closureCaptureReachOf(project Project, facts CapabilityFacts, func IrFunction, value ValueId) returns CaptureReach
	if valueTagOf(func, value: value) != ValueTypeTag.function 'notAFunctionValue'
		return CaptureReach.untouched
	end 'notAFunctionValue'

	let index = try facts.indexOf(functionValueOwnTypeName(project, func: func, value: value)) otherwise return CaptureReach.untouched

	return captureReachOf(facts, index: index, func: try facts.funcNames.functions.get(index) otherwise panic("closureCaptureReachOf: functions.get OOB at {index}"))
end 'closureCaptureReachOf'

function checkPausedClosuresLeaveTheirCaptures(project Project, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, operands ValueIdArray, paused ParamPositionMask, windowLabel String) returns bool
	for position in 0 upto operands.count() 'eachOperand'
		if not maskHasParam(paused, param: position as ParamCount) 'notPaused'
			continue
		end 'notPaused'

		let reach = closureCaptureReachOf(project, facts: facts, func: func, value: try operands.get(position) otherwise panic("checkPausedClosuresLeaveTheirCaptures: operands.get OOB at {position}"))

		if reach == CaptureReach.untouched 'leavesThemAlone'
			continue
		end 'leavesThemAlone'

		let spelled = try func.capabilityNotes.argumentNameAt(opIdx, position: position as ParamCount) otherwise EmptySourceText
		let subject = "'{String.from(spelled)}'" if not spelled.isEmpty() else "the function value"
		let range = project.opRanges.get(opIdx)
		reportPositioned(project, code: ErrorCode.semanticArgumentCapabilityRefused, message: "{subject} {captureReachPhrase(reach)}, and that data is read-only while '{windowLabel}' is open; {captureReachAdvice(reach)} or take the data as a parameter", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
		return true
	end 'eachOperand'

	return false
end 'checkPausedClosuresLeaveTheirCaptures'

let UnseenBuilderWanted = "a parameter it may build a record from, since the function behind it is not visible here"

function reportPausedOperandWrite(project Project, func IrFunction, opIdx ElementIndex, argIndex ParamCount, calleeName String, wanted String, windowLabel String, range SourceRange)
	let spelled = try func.capabilityNotes.argumentNameAt(opIdx, position: argIndex) otherwise EmptySourceText
	let subject = "'{String.from(spelled)}'" if not spelled.isEmpty() else "the argument"
	reportPositioned(project, code: ErrorCode.semanticArgumentCapabilityRefused, message: "{calleeName} needs {wanted}; {subject} is read-only while '{windowLabel}' is open", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
end 'reportPausedOperandWrite'

function checkPausedDirectCall(project Project, funcNames FunctionNameIndex, facts CapabilityFacts, func IrFunction, opIdx ElementIndex, op MaxonOp, paused ParamPositionMask, windowLabel String)
	let parts = try directCallPartsOf(op) otherwise panic("checkPausedDirectCall: handed an op that is not a direct call")
	let callee = parts.0
	let calleeIndex = try facts.indexOf(callee) otherwise return
	view sig = try project.funcSignatures.get(callee) otherwise return

	for argIndex in 0 upto parts.2.count() 'eachArg'
		if not maskHasParam(paused, param: argIndex as ParamCount) 'notPaused'
			continue
		end 'notPaused'

		let label = try parts.2.get(argIndex) otherwise panic("checkPausedDirectCall: argLabels.get OOB at {argIndex}")
		let position = try argSlotPosition(sig.paramNames, argIndex: argIndex as ParamCount, label: label) otherwise continue

		if facts.classAt(calleeIndex, position: position, declared: declaredCapabilityOf(sig, position: position)) != ParamClass.mutableOnly 'notWritten'
			continue
		end 'notWritten'

		let calleeFunc = try funcNames.functions.get(calleeIndex) otherwise panic("checkPausedDirectCall: functions.get OOB at {calleeIndex}")
		let wanted = "a writable receiver" if positionIsTheReceiver(sig, position: position) else "a writable parameter '{displayParamName(try sig.paramNames.get(position) otherwise panic("checkPausedDirectCall: paramNames.get OOB at {position}"))}'"
		let chain = needOriginText(project, funcNames: funcNames, facts: facts, index: calleeIndex, position: position, mutable: true)
		reportPausedOperandWrite(project, func: func, opIdx: opIdx, argIndex: argIndex as ParamCount, calleeName: functionDisplay(project, func: calleeFunc).memberQuoted(), wanted: "{wanted}{chain}", windowLabel: windowLabel, range: try parts.3.get(argIndex) otherwise panic("checkPausedDirectCall: argRanges.get OOB at {argIndex}"))
		return
	end 'eachArg'
end 'checkPausedDirectCall'

function checkPausedRequirementCall(project Project, signatures ProgramSignatures, witnessSlots WitnessSlotsByDeclIndex, func IrFunction, opIdx ElementIndex, op MaxonOp, paused ParamPositionMask, windowLabel String)
	let parts = try witnessCallPartsOf(op) otherwise panic("checkPausedRequirementCall: handed an op that is not a witness dispatch")
	let argCount = parts.0.count()
	let methodIndex = parts.2
	let interfaceDeclIndex = parts.3
	let slot = witnessSlotAt(signatures, interfaces: signatures.interfaceMap(), witnessSlots: witnessSlots, interfaceDeclIndex: interfaceDeclIndex, methodIndex: methodIndex)
	let first = requirementFirstPosition(slot.method)

	for position in 0 upto argCount 'eachArg'
		let declared = requirementCapabilityAt(slot.method, position: position as ParamCount, first: first)

		if not maskHasParam(paused, param: position as ParamCount) or (declared != ParamCapability.mutable and declared != ParamCapability.unmarked) 'notWritten'
			continue
		end 'notWritten'

		let wanted = "a writable receiver" if position < first and declared == ParamCapability.mutable else "a writable parameter '{displayParamName(try slot.method.paramNames.get((position - first) as ParamCount) otherwise panic("checkPausedRequirementCall: paramNames.get OOB at {position - first}"))}'" if declared == ParamCapability.mutable else UnseenBuilderWanted
		reportPausedOperandWrite(project, func: func, opIdx: opIdx, argIndex: position as ParamCount, calleeName: FunctionDisplay.named("{String.from(slot.sourceInterfaceName)}.{String.from(slot.method.name)}").quoted(), wanted: wanted, windowLabel: windowLabel, range: project.opRanges.get(opIdx))
		return
	end 'eachArg'
end 'checkPausedRequirementCall'

function checkPausedFunctionValueCall(project Project, func IrFunction, opIdx ElementIndex, op MaxonOp, paused ParamPositionMask, windowLabel String)
	let parts = match op 'op'
		indirectCall(_, callee, args, _) gives (callee, args)
		default panic("checkPausedFunctionValueCall: handed an op that is not an indirect call")
	end 'op'

	view shape = try functionTypeRegistryOf(project).aliasShapes.get(functionValueGoverningName(project, func: func, value: parts.0)) otherwise return
	let alias = aliasDisplayOf(project, name: functionValueGoverningName(project, func: func, value: parts.0))

	if shape.mutableFunction and maskHasParam(paused, param: userArityOfIndirectCall(parts.1)) and not capabilityIsReadOnly(argumentCapabilityOf(project, func: func, argId: parts.0)) 'aMutableFunctionPaused'
		let range = project.opRanges.get(opIdx)
		reportPositioned(project, code: ErrorCode.semanticMutableFunctionConversionRefused, message: "'{alias}' mutates captures and cannot be called through {capabilityWord(ValueCapability.paused)} data while '{windowLabel}' is open", line: range.line, column: range.column, filePath: authoredFileOf(project, func: func, opIndex: opIdx))
		return
	end 'aMutableFunctionPaused'

	for position in 0 upto userArityOfIndirectCall(parts.1) 'eachArg'
		let declared = declaredCapabilityAt(shape.paramCapabilities, position: position as ParamCount)

		if not maskHasParam(paused, param: position as ParamCount) or (declared != ParamCapability.mutable and declared != ParamCapability.unmarked) 'notWritten'
			continue
		end 'notWritten'

		reportPausedOperandWrite(project, func: func, opIdx: opIdx, argIndex: position as ParamCount, calleeName: FunctionDisplay.named(alias).quoted(), wanted: "a writable parameter" if declared == ParamCapability.mutable else UnseenBuilderWanted, windowLabel: windowLabel, range: project.opRanges.get(opIdx))
		return
	end 'eachArg'
end 'checkPausedFunctionValueCall'

enum CaptureReach
	untouched
	writes
	builds
end 'CaptureReach'

function captureReachOf(facts CapabilityFacts, index ElementIndex, func IrFunction) returns CaptureReach
	let written = try facts.mutableOnly.get(index) otherwise panic("captureReachOf: mutableOnly.get OOB at {index}")
	var reach = CaptureReach.untouched

	for position in func.paramCount upto MaxAbiArgs 'eachCapturedSlot'
		if maskHasParam(written, param: position) 'written'
			return CaptureReach.writes
		end 'written'

		if facts.buildsRecordAt(index, position: position) 'builtFrom'
			reach = CaptureReach.builds
		end 'builtFrom'
	end 'eachCapturedSlot'

	return reach
end 'captureReachOf'

function captureReachPhrase(reach CaptureReach) returns String
	match reach 'reach'
		writes then return "writes data it captured"
		builds then return "builds a record from data it captured"
		untouched then panic("captureReachPhrase: an untouched closure has nothing to say")
	end 'reach'
end 'captureReachPhrase'

function captureReachAdvice(reach CaptureReach) returns String
	match reach 'reach'
		writes then return "write it outside the closure"
		builds then return "build the record outside the closure"
		untouched then panic("captureReachAdvice: an untouched closure has nothing to advise")
	end 'reach'
end 'captureReachAdvice'

function reportConversionRefused(project Project, message String, line LineNumber, column ColumnNumber, filePath FilePath)
	reportPositioned(project, code: ErrorCode.semanticCapabilityConversionRefused, message: message, line: line, column: column, filePath: filePath)
end 'reportConversionRefused'

function blockingRefusal(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, index ElementIndex, subject String, noun String) returns String throws AbsentError
	if not facts.yields(index) 'neitherWaitsNorYields'
		throw AbsentError.absent
	end 'neitherWaitsNorYields'

	let waits = facts.waits(index)
	let reason = blockingChain(project, module: module, funcNames: funcNames, facts: facts, index: index, waits: waits)
	let verb = "wait" if waits else "yield"
	return "{subject} may {verb} ({reason}), but {noun} never waits or yields"
end 'blockingRefusal'

enum ConversionVerdict
	accepted
	writesWhereNotDeclaredMutable
	writesWhereDeclaredImmutable
	needsFrozenWhereNotDeclaredImmutable
	needsFrozenWhereDeclaredMutable
end 'ConversionVerdict'

function conversionVerdict(paramClass ParamClass, declared ParamCapability) returns ConversionVerdict
	match paramClass 'paramClass'
		mutableOnly then return mutableOnlyVerdict(declared)
		immutableOnly then return immutableOnlyVerdict(declared)
		anyCapability or
		both or
		isolatedParam then return ConversionVerdict.accepted
	end 'paramClass'
end 'conversionVerdict'

function mutableOnlyVerdict(declared ParamCapability) returns ConversionVerdict
	return match declared 'declared'
		unmarked gives ConversionVerdict.writesWhereNotDeclaredMutable
		immutable gives ConversionVerdict.writesWhereDeclaredImmutable
		mutable or
		isolated gives ConversionVerdict.accepted
	end 'declared'
end 'mutableOnlyVerdict'

function immutableOnlyVerdict(declared ParamCapability) returns ConversionVerdict
	return match declared 'declared'
		unmarked gives ConversionVerdict.needsFrozenWhereNotDeclaredImmutable
		mutable gives ConversionVerdict.needsFrozenWhereDeclaredMutable
		immutable or
		isolated gives ConversionVerdict.accepted
	end 'declared'
end 'immutableOnlyVerdict'

function conversionRefusalSentence(verdict ConversionVerdict, subject String, what String, boundary String, mutableWord String, frozenWord String) returns String throws AbsentError
	match verdict 'verdict'
		accepted then throw AbsentError.absent
		writesWhereNotDeclaredMutable then return "{subject} writes {what}, but '{boundary}' does not declare {mutableWord}"
		writesWhereDeclaredImmutable then return "{subject} writes {what}, but '{boundary}' declares {frozenWord}"
		needsFrozenWhereNotDeclaredImmutable then return "{subject} needs {what} frozen, but '{boundary}' does not declare {frozenWord}"
		needsFrozenWhereDeclaredMutable then return "{subject} needs {what} frozen, but '{boundary}' declares {mutableWord}"
	end 'verdict'
end 'conversionRefusalSentence'

function parameterRefusal(project Project, facts CapabilityFacts, gotIndex ElementIndex, gotFunc IrFunction, position ParamCount, declared ParamCapability, subject String, boundary String) returns String throws AbsentError
	view sig = try project.funcSignatures.get(gotFunc.name) otherwise panic("parameterRefusal: '{String.from(gotFunc.name)}' has no signature")
	let verdict = conversionVerdict(facts.classAt(gotIndex, position: position, declared: declaredCapabilityOf(sig, position: position)), declared: declared)
	let parameter = displayParamName(try sig.paramNames.get(position) otherwise panic("parameterRefusal: paramNames.get OOB at {position}"))

	return try conversionRefusalSentence(verdict, subject: subject, what: "its parameter '{parameter}'", boundary: boundary, mutableWord: "it `mutable`", frozenWord: "it `immutable`")
end 'parameterRefusal'

function parameterIsAnImmutableAggregate(project Project, func IrFunction, position ParamCount) returns bool
	let paramType = try func.maxonParamTypes.get(position) otherwise panic("parameterIsAnImmutableAggregate: maxonParamTypes.get OOB at {position} — a compared position names a parameter the function declares")

	return RecordKindWritability.of(programSignaturesIn(project, asker: "parameterIsAnImmutableAggregate")).namesAnImmutableAggregate(maxonTypeTag(paramType), nameId: typeNameIdOf(paramType), from: project.typeNames)
end 'parameterIsAnImmutableAggregate'

module function checkDoorMeetsBoundary(project Project, facts CapabilityFacts, declaredName ByteArray, gotName ByteArray, line LineNumber, column ColumnNumber, filePath FilePath) returns bool
	view declared = try functionTypeRegistryOf(project).aliasShapes.get(declaredName) otherwise return false
	let gotIndex = try facts.indexOf(gotName) otherwise return false
	let gotFunc = try facts.funcNames.functions.get(gotIndex) otherwise panic("checkDoorMeetsBoundary: functions.get OOB at {gotIndex}")

	if bodyIsUnreadable(gotFunc) 'nothingToJudge'
		return false
	end 'nothingToJudge'

	view gotSig = try project.funcSignatures.get(gotFunc.name) otherwise return false
	let boundary = aliasDisplayOf(project, name: declaredName)
	let subject = "function value for '{boundary}'"

	for position in 0 upto declared.paramTypes.count() 'eachParam'
		if not paramTagCarriesACapability(project, sig: gotSig, func: gotFunc, position: position as ParamCount) or parameterIsAnImmutableAggregate(project, func: gotFunc, position: position as ParamCount) 'aParameterNothingWrites'
			continue
		end 'aParameterNothingWrites'

		if let message = try parameterRefusal(project, facts: facts, gotIndex: gotIndex, gotFunc: gotFunc, position: position as ParamCount, declared: declared.paramCapabilityAt(position), subject: subject, boundary: boundary) 'refused'
			reportConversionRefused(project, message: message, line: line, column: column, filePath: filePath)
			return true
		end 'refused'
	end 'eachParam'

	let reach = captureReachOf(facts, index: gotIndex, func: gotFunc)

	if not declared.mutableFunction and reach != CaptureReach.untouched 'reachesItsCaptures'
		reportConversionRefused(project, message: "{subject} {captureReachPhrase(reach)}, but '{boundary}' does not declare `mutates captures`", line: line, column: column, filePath: filePath)
		return true
	end 'reachesItsCaptures'

	if let blocking = try blockingRefusal(project, module: facts.ir, funcNames: facts.funcNames, facts: facts, index: gotIndex, subject: subject, noun: "a function type") 'blocks'
		reportConversionRefused(project, message: blocking, line: line, column: column, filePath: filePath)
		return true
	end 'blocks'

	if let resultMessage = try resultRefusal(project, declared: declared, gotFunc: gotFunc, facts: facts, gotIndex: gotIndex, subject: subject, boundary: boundary) 'resultBreaksIt'
		reportConversionRefused(project, message: resultMessage, line: line, column: column, filePath: filePath)
		return true
	end 'resultBreaksIt'

	return false
end 'checkDoorMeetsBoundary'

function resultRefusal(project Project, declared FunctionShape, gotFunc IrFunction, facts CapabilityFacts, gotIndex ElementIndex, subject String, boundary String) returns String throws AbsentError
	view sig = try project.funcSignatures.get(gotFunc.name) otherwise panic("resultRefusal: '{String.from(gotFunc.name)}' has no signature")

	if (declared.returnCapability == ResultCapability.immutable or declared.returnCapability == ResultCapability.isolated) and sig.returnCapability != declared.returnCapability 'resultNotDeclared'
		return "{subject} does not declare `returns {declarationWordOf(paramCapabilityOfResult(declared.returnCapability))}`, but '{boundary}' does"
	end 'resultNotDeclared'

	if declared.returnCapability != ResultCapability.unmarked and declared.returnCapability != ResultCapability.mutable 'declaredResult'
		throw AbsentError.absent
	end 'declaredResult'

	for position in 0 upto gotFunc.paramCount 'eachParam'
		if not maskHasParam(gotFunc.resultFromParamMask, param: position) or facts.classAt(gotIndex, position: position, declared: declaredCapabilityOf(sig, position: position)) != ParamClass.anyCapability 'notReadOnlyData'
			continue
		end 'notReadOnlyData'

		return "{subject} returns data reached from its read-only parameter '{displayParamName(try sig.paramNames.get(position) otherwise panic("resultRefusal: paramNames.get OOB at {position}"))}', which '{boundary}' does not allow"
	end 'eachParam'

	throw AbsentError.absent
end 'resultRefusal'

function checkConformersMeetTheirRequirements(project Project, module MaxonModule, signatures ProgramSignatures, funcNames FunctionNameIndex, facts CapabilityFacts)
	for (_, iface) in signatures.interfaceMap().entries 'eachInterface'
		let conformers = signatures.witnessConformersOf(iface.name)

		for requirement in iface.methods 'eachRequirement'
			for conformer in conformers 'eachConformer'
				view implName = try project.witnessSlotImpls.get(witnessSlotImplKey(conformer, interfaceName: iface.name, methodName: requirement.name)) otherwise continue
				let implIndex = try funcNames.byName.get(implName) otherwise continue
				checkImplMeetsRequirement(project, module: module, funcNames: funcNames, facts: facts, impl: try funcNames.functions.get(implIndex) otherwise panic("checkConformersMeetTheirRequirements: functions.get OOB at {implIndex}"), implIndex: implIndex, iface: iface, requirement: requirement)
			end 'eachConformer'
		end 'eachRequirement'
	end 'eachInterface'
end 'checkConformersMeetTheirRequirements'

function checkImplMeetsRequirement(project Project, module MaxonModule, funcNames FunctionNameIndex, facts CapabilityFacts, impl IrFunction, implIndex ElementIndex, iface IrInterface, requirement InterfaceMethodSig)
	if bodyIsUnreadable(impl) 'nothingToJudge'
		return
	end 'nothingToJudge'

	view sig = try project.funcSignatures.get(impl.name) otherwise return
	let first = requirementFirstPosition(requirement)
	let boundary = "{String.from(iface.name)}.{String.from(requirement.name)}"
	let subject = functionDisplay(project, func: impl).quoted()

	for position in 0 upto impl.paramCount 'eachPosition'
		if position >= sig.paramCount() or not paramTagCarriesACapability(project, sig: sig, func: impl, position: position) 'notAComparedPosition'
			continue
		end 'notAComparedPosition'

		let declared = requirementCapabilityAt(requirement, position: position, first: first)

		if let message = try requirementParameterRefusal(facts, implIndex: implIndex, sig: sig, position: position, declared: declared, subject: subject, boundary: boundary, first: first) 'refused'
			reportAtFunctionName(project, func: impl, code: ErrorCode.semanticCapabilityConversionRefused, message: message)
			return
		end 'refused'
	end 'eachPosition'

	if let blocking = try blockingRefusal(project, module: module, funcNames: funcNames, facts: facts, index: implIndex, subject: subject, noun: "a requirement") 'blocks'
		reportAtFunctionName(project, func: impl, code: ErrorCode.semanticCapabilityConversionRefused, message: blocking)
	end 'blocks'
end 'checkImplMeetsRequirement'

function requirementPositionWords(sig FuncSignature, position ParamCount, first ParamCount) returns (String, String, String)
	let atTheReceiver = position < first
	let what = "its receiver" if atTheReceiver else "its parameter '{displayParamName(try sig.paramNames.get(position) otherwise panic("requirementPositionWords: paramNames.get OOB at {position}"))}'"
	let mutableWord = "`mutable self`" if atTheReceiver else "it `mutable`"
	let frozenWord = "`immutable self`" if atTheReceiver else "it `immutable`"

	return (what, mutableWord, frozenWord)
end 'requirementPositionWords'

function requirementParameterRefusal(facts CapabilityFacts, implIndex ElementIndex, sig FuncSignature, position ParamCount, declared ParamCapability, subject String, boundary String, first ParamCount) returns String throws AbsentError
	let verdict = conversionVerdict(facts.classAt(implIndex, position: position, declared: declaredCapabilityOf(sig, position: position)), declared: declared)
	let words = requirementPositionWords(sig, position: position, first: first)

	if declared == ParamCapability.isolated and declaredCapabilityOf(sig, position: position) != ParamCapability.isolated 'anOwnerTheCallerCannotFind'
		return "{subject} takes {words.0} without `isolated`, but '{boundary}' declares it `isolated`"
	end 'anOwnerTheCallerCannotFind'

	return try conversionRefusalSentence(verdict, subject: subject, what: words.0, boundary: boundary, mutableWord: words.1, frozenWord: words.2)
end 'requirementParameterRefusal'
