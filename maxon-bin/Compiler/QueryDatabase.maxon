// QueryDatabase — the incremental query system's storage: source inputs, the
// per-query memo caches, and the dependency graph.
//
// **Content-hash-keyed, NOT revision-counter-keyed**. Each memo
// stamps the hash of the input it was derived from (`keyHash`), and a memo is
// valid iff that stored hash still equals the input's current hash. This is
// **parallel-safe** — there is no shared mutable counter for concurrent
// per-file parse tasks to contend on; a file's cache key is a pure function of
// its own bytes.
//
// **THERE IS NO DEPENDENCY GRAPH, AND THAT IS THE DESIGN — NOT A GAP.** A memo names its own
// inputs in the ONE function that computes its key (`QueryEngine.parseMemoKey`), so validity is
// an equality test on a hash and never a graph walk. Dependencies are DERIVED from the input,
// not RECORDED as it is read; that is what makes the per-file caches trivially parallel-safe.
//
// A graph WAS recorded here — `depIndex` (a map from a query to the queries it read), fed by
// `recordDependency` off an `activeQueryStack`. **Nothing ever read a bucket.** It was kept
// against the day "a query genuinely depends on another file's DERIVED state, so the wiring is
// already there".
//
// **THAT DAY CAME, on 2026-07-14, AND THE WIRING WAS NOT USED.** `queryParseOps` came to depend
// on `queryProgramSignatures` — one file's parse against every other file's declarations, exactly
// the case — and the fix was to MIX THE INDEX'S HASH INTO THE PARSE MEMO'S KEY. Not
// one line consulted the graph. The commit did add an EDGE to it, under a comment explaining why
// the edge mattered to a consumer that did not exist.
//
// So it went, for the reason its own other half went one commit earlier: **written, never read,
// and therefore quietly wrong.** Unread, it had already rotted — `queryKeyString` advertised an
// "edge dedup" nothing performed — and a graph nothing validates is not wiring, it is a structure
// whose bugs are simply unpaid. It cost a `String` render plus two `Map` operations on every
// dependency edge, on a compiler's hot path, to answer no question. If a query ever does need a
// dynamic edge, add the index WITH its reader, in one commit, and let the two be reviewed
// together.

// Per-file memo: the tokenized form, stamped with the source hash it came from.
export type TokenMemo
	export var value as TokenArray
	export var keyHash as HashDigest

	export static function create(value TokenArray, keyHash HashDigest) returns TokenMemo
		return Self{value: value, keyHash: keyHash}
	end 'create'
end 'TokenMemo'

// Per-file memo: the parsed artifact (this file's IR fragment + registry
// contributions), stamped with the source hash it came from.
export type ParseMemo
	export var value as FileParseArtifact
	export var keyHash as HashDigest

	export static function create(value FileParseArtifact, keyHash HashDigest) returns ParseMemo
		return Self{value: value, keyHash: keyHash}
	end 'create'
end 'ParseMemo'

// Whole-program memo: the function signature index (SignatureIndex.maxon), stamped
// with the COMPOSITE hash folded over every source file's content hash — because the
// index is read off every file's tokens, so ANY file's edit can move it. `computed`
// marks emptiness for the same reason `ModuleMemo`'s does.
//
// Note the two hashes that meet on this memo and must not be confused: `keyHash` is
// what makes the INDEX valid (has any source changed?), while the index's own
// `ProgramSignatures.hash` is what makes a PARSE valid (have any DECLARATIONS
// changed?). Keying a parse on this one would re-parse the whole program whenever a
// single body was edited — see ProgramSignatures.hash.
export type SignatureMemo
	export var value as ProgramSignatures
	export var keyHash as HashDigest
	export var computed as bool

	export static function create(value ProgramSignatures, keyHash HashDigest, computed bool) returns SignatureMemo
		return Self{value: value, keyHash: keyHash, computed: computed}
	end 'create'

	// ⚠ **THE `Os` REACHES A SENTINEL'S INDEX, and it is threaded rather than defaulted on purpose.**
	// `ProgramSignatures` holds a `RangedAliasRegistry`, whose builtin `ExitCode` bound is the
	// compile TARGET's — and while `computed: false` means nothing ever reads THIS index, a site allowed to
	// invent a bound is exactly the shape the mirror exists to prevent. It costs one enum, and it means no
	// registry anywhere in the compiler is constructed without a target being named.
	export static function empty(os Os) returns SignatureMemo
		return Self{value: ProgramSignatures.create(os), keyHash: 0, computed: false}
	end 'empty'
end 'SignatureMemo'

// Whole-program memo: the merged Maxon module, stamped with the COMPOSITE hash
// folded over every source file's content hash in source-path order.
// `computed` is the sentinel — false means "never built" (a zero hash is a
// legitimate value, so a bool flag, not a hash sentinel, marks emptiness).
export type ModuleMemo
	export var value as MaxonModule
	export var keyHash as HashDigest
	export var computed as bool

	export static function create(value MaxonModule, keyHash HashDigest, computed bool) returns ModuleMemo
		return Self{value: value, keyHash: keyHash, computed: computed}
	end 'create'

	export static function empty() returns ModuleMemo
		return Self{value: MaxonModule.create(), keyHash: 0, computed: false}
	end 'empty'
end 'ModuleMemo'

// --- The memo that outlives a `Project` ---
//
// A `Project`-scoped memo may hold anything, because it dies with the ids and the module it was
// derived against. One shared across `Project`s (`CompileSession.fileMemos`) holds what carries no
// identity, and library parses that carry a footprint of every id they embed — see
// QueryEngine.maxon's section of the same name.
//
// The unit is the file's CONTENT HASH rather than its path: `tokenize` reads the bytes and nothing
// else, so two files with the same bytes have the same tokens whatever they are called, and an
// overlay stdlib staged at another path shares an entry exactly when it deserves to.

// Everything the `#if` filter reads — the build target AND the build flags a predicate can name — reduced
// to ONE integer, so a memo shared across `Project`s can key on it without a second spelling of
// `ConditionFacts`' identity. See `QueryEngine.buildKeyOf`.
export typealias BuildKey = bits(64)

// One build's view of one file, and it is per build because the `#if` filter is.
// `queryActiveTokens`' per-`Project` memo gets that for free from "a `Project` has exactly one
// target and one flag set for its whole life"; a memo shared across them does not. A shared stdlib
// entry that omitted the target would bake the build machine's OS into a cross-compiled binary's
// stdlib, and one that omitted `debugStream` would hand a traced build the untraced arm of every
// `#if debugstream(true)` — a spec worker compiles both kinds in one process. Both fields below are
// functions of (these bytes, this build key) and of nothing else.
export type SharedBuildView
	export let buildKey as BuildKey

	// The `#if`-resolved stream. Only a SUCCEEDING filter is ever published here — see
	// `Queries.queryActiveTokens`, whose per-`Project` memo may hold a failure (its diagnostic is
	// already on that compile's `project.diagnostics`) and whose shared one may not.
	export let activeTokens as TokenArray

	// `Parser.fileNamesProducerMask` over that stream — a bitmask, so a memo of it is one integer
	// and there is nothing to alias. Filled on FIRST DEMAND rather than beside the tokens, because
	// the two have different consumers: every token reader wants the stream, only the declaration
	// sweep wants the mask.
	export var producerMask as ProducerMask
	export var producerMaskComputed as bool
	export var persisted as bool

	export static function create(buildKey BuildKey, activeTokens TokenArray) returns SharedBuildView
		return Self{buildKey: buildKey, activeTokens: activeTokens, producerMask: 0, producerMaskComputed: false, persisted: false}
	end 'create'

	export static function restored(buildKey BuildKey, activeTokens TokenArray, producerMask ProducerMask, producerMaskComputed bool) returns SharedBuildView
		return Self{buildKey: buildKey, activeTokens: activeTokens, producerMask: producerMask, producerMaskComputed: producerMaskComputed, persisted: true}
	end 'restored'

	// ONE writer for the mask and the bit that says it is there, so a filled mask can never be
	// read as absent nor an absent one as zero — a producer mask of 0 is a legitimate answer (a
	// file that names none of the five producers), which is why the bit exists at all.
	export function rememberProducerMask(mask ProducerMask)
		self.producerMask = mask
		self.producerMaskComputed = true
		self.persisted = false
	end 'rememberProducerMask'

	export function markPersisted()
		self.persisted = true
	end 'markPersisted'
end 'SharedBuildView'

export typealias SharedBuildViewArray = Array with SharedBuildView

export typealias FootprintNameIdArray = Array with TypeNameId

// @generated library-cache begin
function cacheWriteFootprintNameIdArray(writer LibraryCacheWriter, value FootprintNameIdArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		writer.unsigned(item as CacheUnsigned)
	end 'eachItem'
end 'cacheWriteFootprintNameIdArray'

function cacheReadFootprintNameIdArray(reader LibraryCacheReader) returns FootprintNameIdArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = FootprintNameIdArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = (try reader.unsigned()) as TypeNameId
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadFootprintNameIdArray'

// @generated library-cache end

export typealias NameIdMap = Map with (TypeNameId, TypeNameId)

export type FootprintRow
	export let id as GenericInstanceId
	export let baseId as TypeNameId
	export let args as MaxonTypeArray
	export let fixedSize as InstanceSize
	export let speculative as bool
	export let compiledName as ByteArray

	export static function create(id GenericInstanceId, baseId TypeNameId, args MaxonTypeArray, fixedSize InstanceSize, speculative bool, compiledName ByteArray) returns FootprintRow
		return Self{id: id, baseId: baseId, args: args, fixedSize: fixedSize, speculative: speculative, compiledName: compiledName}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.id as CacheUnsigned)
		writer.unsigned(self.baseId as CacheUnsigned)
		cacheWriteMaxonTypeArray(writer, value: self.args)
		cacheWriteInstanceSize(writer, value: self.fixedSize)
		writer.flag(self.speculative)
		writer.bytes(self.compiledName)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FootprintRow throws LibraryCacheDamage
		let f_id = (try reader.unsigned()) as GenericInstanceId
		let f_baseId = (try reader.unsigned()) as TypeNameId
		let f_args = try cacheReadMaxonTypeArray(reader)
		let f_fixedSize = try cacheReadInstanceSize(reader)
		let f_speculative = try reader.flag()
		let f_compiledName = try reader.bytes()

		return Self{id: f_id, baseId: f_baseId, args: f_args, fixedSize: f_fixedSize, speculative: f_speculative, compiledName: f_compiledName}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize48
		return sizeof(FootprintRow) as CacheSize48
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FootprintRow'

export typealias FootprintRowArray = Array with FootprintRow

// @generated library-cache begin
function cacheWriteFootprintRowArray(writer LibraryCacheWriter, value FootprintRowArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteFootprintRowArray'

function cacheReadFootprintRowArray(reader LibraryCacheReader) returns FootprintRowArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = FootprintRowArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try FootprintRow.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadFootprintRowArray'

// @generated library-cache end

export type FootprintInterface
	export let declIndex as ElementIndex
	export let name as ByteArray

	export static function create(declIndex ElementIndex, name ByteArray) returns FootprintInterface
		return Self{declIndex: declIndex, name: name}
	end 'create'

	// @generated library-cache begin
	function cacheWrite(writer LibraryCacheWriter)
		writer.unsigned(self.declIndex as CacheUnsigned)
		writer.bytes(self.name)
	end 'cacheWrite'

	static function cacheRead(reader LibraryCacheReader) returns FootprintInterface throws LibraryCacheDamage
		let f_declIndex = (try reader.unsigned()) as ElementIndex
		let f_name = try reader.bytes()

		return Self{declIndex: f_declIndex, name: f_name}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize16
		return sizeof(FootprintInterface) as CacheSize16
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'FootprintInterface'

export typealias FootprintInterfaceArray = Array with FootprintInterface

// @generated library-cache begin
function cacheWriteFootprintInterfaceArray(writer LibraryCacheWriter, value FootprintInterfaceArray)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		item.cacheWrite(writer)
	end 'eachItem'
end 'cacheWriteFootprintInterfaceArray'

function cacheReadFootprintInterfaceArray(reader LibraryCacheReader) returns FootprintInterfaceArray throws LibraryCacheDamage
	let count = try reader.count()
	var result = FootprintInterfaceArray.create()
	result.reserve(count)

	for _ in 0 upto count 'eachItem'
		let item = try FootprintInterface.cacheRead(reader)
		result.push(item)
	end 'eachItem'

	return result
end 'cacheReadFootprintInterfaceArray'

// @generated library-cache end

export type ParseFootprint
	export var rows as FootprintRowArray
	export var nameIds as FootprintNameIdArray
	export var nameBytes as ByteArrayArray
	export var interfaces as FootprintInterfaceArray

	export static function create() returns ParseFootprint
		return Self{rows: FootprintRowArray.create(), nameIds: FootprintNameIdArray.create(), nameBytes: ByteArrayArray.create(), interfaces: FootprintInterfaceArray.create()}
	end 'create'

	// @generated library-cache begin
	module function cacheWrite(writer LibraryCacheWriter)
		cacheWriteFootprintRowArray(writer, value: self.rows)
		cacheWriteFootprintNameIdArray(writer, value: self.nameIds)
		cacheWriteByteArrayArray(writer, value: self.nameBytes)
		cacheWriteFootprintInterfaceArray(writer, value: self.interfaces)
	end 'cacheWrite'

	module static function cacheRead(reader LibraryCacheReader) returns ParseFootprint throws LibraryCacheDamage
		let f_rows = try cacheReadFootprintRowArray(reader)
		let f_nameIds = try cacheReadFootprintNameIdArray(reader)
		let f_nameBytes = try cacheReadByteArrayArray(reader)
		let f_interfaces = try cacheReadFootprintInterfaceArray(reader)

		return Self{rows: f_rows, nameIds: f_nameIds, nameBytes: f_nameBytes, interfaces: f_interfaces}
	end 'cacheRead'

	static function cacheLayoutBytes() returns CacheSize32
		return sizeof(ParseFootprint) as CacheSize32
	end 'cacheLayoutBytes'

	// @generated library-cache end
end 'ParseFootprint'

export type ParseRebase
	export let names as NameIdMap
	export let instances as GenericInstanceIdMap
	export let interfaces as InterfaceIndexMap
	export let nameBaseline as TypeNameId

	export static function create(names NameIdMap, instances GenericInstanceIdMap, interfaces InterfaceIndexMap, nameBaseline TypeNameId) returns ParseRebase
		return Self{names: names, instances: instances, interfaces: interfaces, nameBaseline: nameBaseline}
	end 'create'
end 'ParseRebase'

export type RebasedParse
	export let artifact as FileParseArtifact
	export let rebase as ParseRebase

	export static function create(artifact FileParseArtifact, rebase ParseRebase) returns RebasedParse
		return Self{artifact: artifact, rebase: rebase}
	end 'create'
end 'RebasedParse'

export type SharedLibraryParse
	let variant as HashDigest
	let key as HashDigest
	module let footprint as ParseFootprint
	module let artifact as FileParseArtifact

	export static function create(variant HashDigest, key HashDigest, footprint ParseFootprint, artifact FileParseArtifact) returns SharedLibraryParse
		return Self{variant: variant, key: key, footprint: footprint, artifact: artifact}
	end 'create'

	export function keyOf() returns HashDigest
		return self.key
	end 'keyOf'

	export function cloned() returns SharedLibraryParse
		return Self{variant: self.variant, key: self.key, footprint: self.footprint.clone(), artifact: self.artifact.clone()}
	end 'cloned'

	export function workingArtifact(consuming bool) returns FileParseArtifact
		if consuming 'handedOver'
			return self.artifact
		end 'handedOver'

		return self.artifact.clone()
	end 'workingArtifact'

	function rebasedOnto(signatures ProgramSignatures, overrides RowSetOverrideTable, consuming bool) returns RebasedParse throws SharedMemoMiss
		let rebase = try signatures.rebaseFor(self.footprint)

		if not self.toldAnswersHold(signatures, overrides: overrides) 'anAnswerMoved'
			throw SharedMemoMiss.footprintMoved
		end 'anAnswerMoved'

		var rebasedArtifact = self.workingArtifact(consuming)

		match rebasedArtifact.parseMints 'mints'
			none then break
			minted(mints) then rebasedArtifact.parseMints = ParseMints.minted(try signatures.rebasedMintsAbsentFromTheBaseline(mints, rebase: rebase))
		end 'mints'

		return RebasedParse.create(rebasedArtifact, rebase: rebase)
	end 'rebasedOnto'

	function toldAnswersHold(signatures ProgramSignatures, overrides RowSetOverrideTable) returns bool
		return match self.artifact.parseMints 'mints'
			none gives true
			minted(mints) gives signatures.toldAnswersHold(mints, overrides: overrides)
		end 'mints'
	end 'toldAnswersHold'

	function answers(wantedVariant HashDigest, wantedKey HashDigest) returns bool
		return self.variant == wantedVariant and self.key == wantedKey
	end 'answers'

	function isOfVariant(wantedVariant HashDigest) returns bool
		return self.variant == wantedVariant
	end 'isOfVariant'

	export function variantOf() returns HashDigest
		return self.variant
	end 'variantOf'
end 'SharedLibraryParse'

export typealias SharedLibraryParseArray = Array with SharedLibraryParse

export typealias PendingSharedParseMap = Map with (HashDigest, SharedLibraryParse)

export typealias StashedParsePackMap = Map with (HashDigest, LibraryPackBuilder)

export union SharedParsePlan
	unshared
	shareable(contentHash HashDigest, variant HashDigest, key HashDigest)
end 'SharedParsePlan'

export type ParseStamp
	export let keyHash as HashDigest
	export let sharing as SharedParsePlan

	export static function create(keyHash HashDigest, sharing SharedParsePlan) returns ParseStamp
		return Self{keyHash: keyHash, sharing: sharing}
	end 'create'
end 'ParseStamp'

export type RawStreamFacts
	export let declaredTypeNames as ByteArrayArray
	export let reservedSpellings as ByteArrayArray

	export static function create(declaredTypeNames ByteArrayArray, reservedSpellings ByteArrayArray) returns RawStreamFacts
		return Self{declaredTypeNames: declaredTypeNames, reservedSpellings: reservedSpellings}
	end 'create'

	export static function nothing() returns RawStreamFacts
		return Self{declaredTypeNames: ByteArrayArray.create(), reservedSpellings: ByteArrayArray.create()}
	end 'nothing'

	export static function of(tokens TokenArray) returns RawStreamFacts
		return Self{declaredTypeNames: declaredTypeNamesIn(tokens), reservedSpellings: reservedSpellingsIn(tokens)}
	end 'of'
end 'RawStreamFacts'

// What one file's BYTES lex to, plus one view per build key this process has been asked about.
//
// The views are an ARRAY walked linearly, not a map: a process compiles for ONE target in every
// driver that exists today (`build` and `spec-test` both take a single `--target`), and the only
// other key component is the `debugStream` flag, so the walk is over at most two elements and a
// `Map` would cost a hash to answer a question a compare answers.
export type SharedFileMemo
	var rawTokens as TokenArray
	var rawHeld as bool
	var facts as RawStreamFacts
	var factsKnown as bool
	export var views as SharedBuildViewArray
	var parses as SharedLibraryParseArray

	export function parseCount() returns ElementIndex
		return self.parses.count()
	end 'parseCount'

	export static function create(tokens TokenArray) returns SharedFileMemo
		return Self{rawTokens: tokens, rawHeld: true, facts: RawStreamFacts.of(tokens), factsKnown: true, views: SharedBuildViewArray.create(), parses: SharedLibraryParseArray.create()}
	end 'create'

	export static function holdingNothingYet() returns SharedFileMemo
		return Self{rawTokens: TokenArray.create(), rawHeld: false, facts: RawStreamFacts.nothing(), factsKnown: false, views: SharedBuildViewArray.create(), parses: SharedLibraryParseArray.create()}
	end 'holdingNothingYet'

	export function holdsRawTokens() returns bool
		return self.rawHeld
	end 'holdsRawTokens'

	export function rawTokensHeld() returns TokenArray throws SharedMemoMiss
		if not self.rawHeld 'notHere'
			throw SharedMemoMiss.notHeld
		end 'notHere'

		return self.rawTokens
	end 'rawTokensHeld'

	export function holdRawTokens(tokens TokenArray)
		self.rawTokens = tokens
		self.rawHeld = true

		if not self.factsKnown 'factsStillToLearn'
			self.facts = RawStreamFacts.of(tokens)
			self.factsKnown = true
		end 'factsStillToLearn'
	end 'holdRawTokens'

	export function rawStreamFactsHeld() returns RawStreamFacts throws SharedMemoMiss
		if not self.factsKnown 'notYetLearnt'
			throw SharedMemoMiss.notHeld
		end 'notYetLearnt'

		return self.facts
	end 'rawStreamFactsHeld'

	export function learnRawStreamFacts(learned RawStreamFacts)
		if self.factsKnown 'knownAlready'
			return
		end 'knownAlready'

		self.facts = learned
		self.factsKnown = true
	end 'learnRawStreamFacts'

	export function parseOf(variant HashDigest, key HashDigest, signatures ProgramSignatures, overrides RowSetOverrideTable, consuming bool) returns RebasedParse throws SharedMemoMiss
		let position = try self.positionAnswering(variant, key: key)
		let held = try self.parses.get(position) otherwise panic("SharedFileMemo.parseOf: parses.get OOB at {position}, the position just found")
		let rebased = try held.rebasedOnto(signatures, overrides: overrides, consuming: consuming)

		if consuming 'noLaterCompileWillAsk'
			_ = try self.parses.remove(position) otherwise panic("SharedFileMemo.parseOf: remove({position}) of {self.parses.count()} held parses")
		end 'noLaterCompileWillAsk'

		return rebased
	end 'parseOf'

	function positionAnswering(variant HashDigest, key HashDigest) returns ElementIndex throws SharedMemoMiss
		for (iter, held) in self.parses.withIterator() 'eachHeld'
			if held.answers(variant, wantedKey: key) 'thisParse'
				return iter.index()
			end 'thisParse'
		end 'eachHeld'

		throw SharedMemoMiss.notHeld
	end 'positionAnswering'

	export function holdsParseAnswering(variant HashDigest, key HashDigest) returns bool
		for held in self.parses 'eachHeld'
			if held.answers(variant, wantedKey: key) 'thisParse'
				return true
			end 'thisParse'
		end 'eachHeld'

		return false
	end 'holdsParseAnswering'

	export function holdParse(held SharedLibraryParse)
		for position in 0 upto self.parses.count() 'eachHeld'
			if (try self.parses.get(position) otherwise panic("SharedFileMemo.holdParse: parses.get OOB at {position} below count {self.parses.count()}")).isOfVariant(held.variantOf()) 'sameVariant'
				try self.parses.set(position, value: held) otherwise panic("SharedFileMemo.holdParse: parses.set OOB at {position} below count {self.parses.count()}")
				return
			end 'sameVariant'
		end 'eachHeld'

		self.parses.push(held)
	end 'holdParse'

	export function viewOf(buildKey BuildKey) returns SharedBuildView throws SharedMemoMiss
		for view in self.views 'eachView'
			if view.buildKey == buildKey 'thisBuild'
				return view
			end 'thisBuild'
		end 'eachView'

		throw SharedMemoMiss.notHeld
	end 'viewOf'

	export function addView(view SharedBuildView)
		self.views.push(view)
	end 'addView'
end 'SharedFileMemo'

// Raised when the shared memo is not holding what it was asked for. An ANSWER — "nothing sharing
// this store has lexed these bytes yet", or "not for this build" — never a compiler bug, exactly
// as `TypeNameInterner.idOf`'s `unknownName` is and unlike its `unknownId`.
export union SharedMemoMiss implements Error
	notHeld
	footprintMoved
end 'SharedMemoMiss'

export typealias SharedFileMemoEntryMap = Map with (HashDigest, SharedFileMemo)

export type SharedFileMemoMap
	export var entries as SharedFileMemoEntryMap
	export var library as LibraryCache

	static function over(library LibraryCache) returns SharedFileMemoMap
		return Self{entries: SharedFileMemoEntryMap.create(), library: library}
	end 'over'

	export static function create() returns SharedFileMemoMap
		return Self.over(LibraryCache.create())
	end 'create'

	export static function forOneCompile() returns SharedFileMemoMap
		return Self.over(LibraryCache.forOneCompile())
	end 'forOneCompile'

	export static function withoutLibraryCache() returns SharedFileMemoMap
		return Self.over(LibraryCache.withoutDiskTier())
	end 'withoutLibraryCache'
end 'SharedFileMemoMap'

// The byte-contents this compile is willing to hand to the shared memo — filled by
// `StdlibLoader.loadLibrarySources`, which is the one place that knows a file came out of an
// enumeration of `stdlib/`.
//
// ⚠ **IT IS AN ADMISSION LIST, NOT A CACHE, AND ITS ONLY JOB IS TO BOUND MEMORY.** A shared entry
// lives for the life of the WORKER, so admitting every file would grow the store by one entry per
// spec fragment — thousands of arrays nothing will ever read again. The stdlib's fifty-odd files
// are re-lexed by every compile, so they are exactly the set worth keeping.
export typealias HashDigestSet = Set with HashDigest

// @generated library-cache begin
module function cacheWriteHashDigestSet(writer LibraryCacheWriter, value HashDigestSet)
	writer.unsigned(value.count() as CacheUnsigned)

	for item in value 'eachItem'
		writer.unsigned(item as CacheUnsigned)
	end 'eachItem'
end 'cacheWriteHashDigestSet'

module function cacheReadHashDigestSet(reader LibraryCacheReader) returns HashDigestSet throws LibraryCacheDamage
	let count = try reader.count()
	var result = HashDigestSet.create()

	for _ in 0 upto count 'eachItem'
		let item = (try reader.unsigned()) as HashDigest
		result.insert(item)
	end 'eachItem'

	return result
end 'cacheReadHashDigestSet'

// @generated library-cache end

// A source file input: its content plus the content hash all per-file memos key
// against. The hash is computed once, at `fileChanged` time.
export type SourceFileEntry
	export var content as String
	export var contentHash as HashDigest

	export static function create(content String, contentHash HashDigest) returns SourceFileEntry
		return Self{content: content, contentHash: contentHash}
	end 'create'
end 'SourceFileEntry'

// Both provenance facts about one path, held for the compile; `Queries.fileProvenanceOf` is the one
// place that fills this. The roots are siblings, so no file is ever both.
export type FileProvenance
	export var isStdlibSource as bool
	export var isRuntimeSource as bool

	export static function create(isStdlibSource bool, isRuntimeSource bool) returns FileProvenance
		return Self{isStdlibSource: isStdlibSource, isRuntimeSource: isRuntimeSource}
	end 'create'
end 'FileProvenance'

export typealias FileProvenanceMemo = Map with (FilePath, FileProvenance)

module type SourceFileStamp
	module let size as FileSize
	module let modifiedTime as Timestamp
	module let observedAt as Timestamp

	module static function create(size FileSize, modifiedTime Timestamp, observedAt Timestamp) returns SourceFileStamp
		return Self{size: size, modifiedTime: modifiedTime, observedAt: observedAt}
	end 'create'

	// ⚠ `>=`, not `>`: `Timestamp` is whole seconds, so a write inside the second the read began in is
	// indistinguishable from one that preceded it and has to count as unseen. A stamp that fails this
	// describes nothing and forces a re-read.
	module function describes(info FileInfo) returns bool
		if self.modifiedTime >= self.observedAt 'writableWithinTheStampedSecond'
			return false
		end 'writableWithinTheStampedSecond'

		return self.size == info.size and self.modifiedTime == info.modifiedTime
	end 'describes'
end 'SourceFileStamp'

module typealias SourceFileStampMap = Map with (FilePath, SourceFileStamp)

export typealias SourceFileMap = Map with (FilePath, SourceFileEntry)
export typealias TokenCacheMap = Map with (FilePath, TokenMemo)
export typealias ParseCacheMap = Map with (FilePath, ParseMemo)

// Running count of cache hits/misses. Wide range: unbounded over a long-lived
// query session.
export typealias QueryCount = int(0 to u64.max)

// The paths `parseMisses` counted, in miss order.
export typealias ParseMissPathRoster = Array with String

typealias RowSetOverrideMap = Map with (FilePath, RowSetOverrideTable)

// The whole program's row-set answers each file is parsed with, and the sources of the program they were filed
// for. An answer describes rows every file's parse minted, so a table filed for other sources is dropped
// rather than handed to a parse of these: a warm fold starts from exactly what a cold fold of the same sources
// starts from.
export type RowSetOverrides
	var program as HashDigest
	var tables as RowSetOverrideMap

	export static function create() returns RowSetOverrides
		return Self{program: Hasher.empty(), tables: RowSetOverrideMap.create()}
	end 'create'

	// Keep the tables only if they were filed for `sources`.
	export function belongTo(sources HashDigest)
		if self.program == sources 'filedForTheseSources'
			return
		end 'filedForTheseSources'

		self.program = sources
		self.tables = RowSetOverrideMap.create()
	end 'belongTo'

	// The answers `path` is parsed with — none, until a fold files some.
	export function of(path FilePath) returns RowSetOverrideTable
		return try self.tables.get(path) otherwise RowSetOverrideTable.create()
	end 'of'

	export function file(path FilePath, table RowSetOverrideTable)
		self.tables.upsert(path, value: table)
	end 'file'

	export function forget(path FilePath)
		_ = self.tables.remove(path)
	end 'forget'
end 'RowSetOverrides'

// ⭐ **THE GENERIC TYPES A PARSE INSTANTIATED THAT NO DECLARATION DID.** Which methods carry a layout descriptor is
// settled before any body is parsed, and whether a type is instantiated at all decides some of it — so a type only
// an expression instantiates (`Box.create(5)`) is filed here after a fold and the signature index is settled again
// with it (`Queries.foldEveryFileInto`).
//
// ⚠ **KEPT ACROSS AN EDIT, AND RE-CHECKED BY THE FOLD RATHER THAN DROPPED WITH THE SOURCES.** The set is a key of the
// index every parse memo reads, so an edit that emptied it would rebuild the index without the type and re-parse
// every file — then file it again and re-parse every file once more. A fold instead drops a name no merged row
// instantiates or a declaration now does (`ProgramSignatures.typesFiledNeedlessly`), which leaves exactly the set a
// cold compile of the same sources files.
export type InstantiatedByAParse
	export var names as InstantiatedTypeNameSet

	// Folded by `xor`, so the order names arrive in cannot move it.
	export var digest as HashDigest

	export static function create() returns InstantiatedByAParse
		return Self{names: InstantiatedTypeNameSet.create(), digest: Hasher.empty()}
	end 'create'

	export function file(name ByteArray)
		if self.names.contains(name) 'filedAlready'
			panic("InstantiatedByAParse.file: '{String.from(name)}' is already filed — the index settled with it answers it instantiated, so no fold can find it newly so")
		end 'filedAlready'

		self.names.insert(name)
		self.digest = self.digest xor mixBytes(Hasher.empty(), bytes: name)
	end 'file'

	export function drop(name ByteArray)
		if not self.names.remove(name) 'neverFiled'
			panic("InstantiatedByAParse.drop: '{String.from(name)}' is not filed — only a filed name can be found needless")
		end 'neverFiled'

		self.digest = self.digest xor mixBytes(Hasher.empty(), bytes: name)
	end 'drop'
end 'InstantiatedByAParse'

export type QueryDatabase
	// Source inputs (path -> content + hash) and insertion-ordered path list.
	export var sourceFiles as SourceFileMap
	export var sourcePaths as FilePathArray

	module var sourceStamps as SourceFileStampMap

	// The composite whole-program source hash, memoized — every whole-program memo keys on it and it
	// is asked once per file, so re-folding it per ask is O(files²).
	export var compositeHash as HashDigest
	export var compositeHashValid as bool

	// ⭐ **WHICH LIBRARY ROOT, IF EITHER, EACH PATH BELONGS TO** — filled on first ask and never
	// invalidated: the answer is a function of the path's spelling and the two library roots, and a
	// compile moves none of the three. Deriving it resolves the path AND the project root against the
	// working directory and tests containment, which allocates a String per path component; it is asked
	// two to three times per file per compile, so the memo is what keeps that off the per-file path.
	export var fileProvenance as FileProvenanceMemo

	// The byte-contents `StdlibLoader` marked worth sharing across `Project`s (see `HashDigestSet`).
	// Per-`Project` because the answer is "did THIS compile load the file from `stdlib/`"; the store
	// it admits into is the session's (`CompileSession.fileMemos`).
	export var shareableTokenHashes as HashDigestSet

	// Per-file memo caches (absence = not cached; validity via keyHash compare).
	export var tokenCache as TokenCacheMap

	// The same file's tokens with `#if` resolved — see `queryActiveTokens`. A SECOND cache rather
	// than a filter folded into `tokenCache`, because the two answer different questions and only
	// one of them is target-dependent: `tokenCache` holds what the file SAYS, this holds what this
	// build READS. Keeping the raw stream memoized separately is also what lets the `lex` phase
	// probe keep bracketing `tokenize` alone (see `queryTokens`).
	export var activeTokenCache as TokenCacheMap
	export var parseCache as ParseCacheMap

	// ⭐⭐ **THE STDLIB FILES THIS COMPILE BUILDS FUNCTION BODIES FOR** — empty until `queryAllModule`'s
	// fixpoint has walked a module, and grown by it once per round (`growStdlibBodyDemand`).
	//
	// It lives on the DATABASE rather than on `Project` because it is the third half of a parse memo's KEY:
	// an artifact built when nothing reached this file is missing every body, and serving it to the round
	// that has just reached one is the stale-memo failure `parseMemoKey`'s header is about.
	export var demandedLibraryBodyFiles as MaxonSourcePathSet

	// The whole program's answers each file is parsed with — the fourth input of a parse memo's key, filed by the
	// fold that found a file's own answers disagreeing with the whole program's.
	export var rowSetOverrides as RowSetOverrides

	// The generic types a parse instantiated that no declaration did — an input of the signature index, and so of
	// its memo's key.
	export var instantiatedByAParse as InstantiatedByAParse

	export var genericInstances as RequestedGenericInstances

	export var liveDefaultKeys as LiveDefaultKeys = LiveDefaultKeys.create()

	// Whole-program signature-index memo. Sits BETWEEN tokens and parse in the chain:
	// every parse reads it, and a parse memo is keyed on it (QueryEngine.parseMemoKey).
	export var signatureCache as SignatureMemo

	// Whole-program merged-module memo.
	export var allModuleCache as ModuleMemo

	// Cache hit/miss counters. **These are what the warm-rebuild gate reads** — the property
	// "edit one file → only its queries re-run" is a statement about hits and misses, and it
	// was always these that proved it, never the dependency graph that claimed to be here for
	// it (see this file's header).
	export var tokenHits as QueryCount
	export var tokenMisses as QueryCount
	export var activeTokenHits as QueryCount
	export var activeTokenMisses as QueryCount
	export var parseHits as QueryCount
	export var parseMisses as QueryCount

	// WHICH files missed, beside HOW MANY: a warm-rebuild failure is located by the path of the stale
	// memo, and the counter alone cannot name it. Recorded only while `recordParseMissPaths` holds, which
	// `VerifyWarmRebuild` sets around each probe: a long-lived project (the LSP) misses on every edit for
	// ever, and an unconditional roster would grow with it.
	export var parseMissPaths as ParseMissPathRoster
	export var recordParseMissPaths as bool
	export var signatureHits as QueryCount
	export var signatureMisses as QueryCount
	export var allModuleHits as QueryCount
	export var allModuleMisses as QueryCount

	// ⭐ **WHAT THIS COMPILE TOOK OUT OF THE SHARED MEMO.** Counted separately from
	// `tokenHits`/`tokenMisses` and never folded into them, because the two answer different
	// questions and one of them is already gated: `tokenHits` is the WARM-REBUILD property
	// (`VerifyWarmRebuild` asserts exact deltas on it), and a shared hit is a per-`Project` MISS by
	// construction — it is the miss that the store answered instead of the lexer. Folding them
	// would move that gate's numbers while proving nothing about incrementality.
	export var sharedTokenHits as QueryCount
	export var sharedActiveTokenHits as QueryCount
	export var sharedProducerMaskHits as QueryCount
	export var sharedParseHits as QueryCount
	export var sharedParseMisses as QueryCount
	export var sharedParsePublishes as QueryCount
	export var sharedParseDrifts as QueryCount
	export var sharedParseReusedFiles as HashDigestSet
	export var pendingSharedParses as PendingSharedParseMap
	export var stashedParsePacks as StashedParsePackMap
	export var libraryTally as LibraryCacheTally
	export var libraryBaseline as LibraryBaselineState
	export var libraryStateKey as HashDigest
	export var libraryStateKeySources as HashDigest
	export var libraryStateKeyComputed as bool

	// `os` is the TARGET's, and it reaches only the empty signature sentinel below — see
	// `SignatureMemo.empty`. A database is filled for one target, exactly as the `Project` that owns it is
	// aimed at one (`Project.target`'s header), so taking it here states that rather than assuming it.
	export static function create(os Os) returns QueryDatabase
		return Self{
			sourceFiles: SourceFileMap.create(),
			sourcePaths: FilePathArray.create(),
			sourceStamps: SourceFileStampMap.create(),
			compositeHash: 0, compositeHashValid: false,
			fileProvenance: FileProvenanceMemo.create(),
			shareableTokenHashes: HashDigestSet.create(),
			tokenCache: TokenCacheMap.create(),
			activeTokenCache: TokenCacheMap.create(),
			parseCache: ParseCacheMap.create(),
			demandedLibraryBodyFiles: MaxonSourcePathSet.create(),
			rowSetOverrides: RowSetOverrides.create(),
			instantiatedByAParse: InstantiatedByAParse.create(),
			genericInstances: RequestedGenericInstances.create(),
			signatureCache: SignatureMemo.empty(os),
			allModuleCache: ModuleMemo.empty(),
			tokenHits: 0, tokenMisses: 0,
			sharedTokenHits: 0, sharedActiveTokenHits: 0, sharedProducerMaskHits: 0, sharedParseHits: 0, sharedParseMisses: 0, sharedParsePublishes: 0, sharedParseDrifts: 0, sharedParseReusedFiles: HashDigestSet.create(), pendingSharedParses: PendingSharedParseMap.create(), stashedParsePacks: StashedParsePackMap.create(), libraryTally: LibraryCacheTally.create(), libraryBaseline: LibraryBaselineState.unused, libraryStateKey: 0, libraryStateKeySources: 0, libraryStateKeyComputed: false,
			activeTokenHits: 0, activeTokenMisses: 0,
			parseHits: 0, parseMisses: 0, parseMissPaths: ParseMissPathRoster.create(), recordParseMissPaths: false,
			signatureHits: 0, signatureMisses: 0,
			allModuleHits: 0, allModuleMisses: 0
		}
	end 'create'

	export function releaseFrontEndCaches()
		self.tokenCache = TokenCacheMap.create()
		self.activeTokenCache = TokenCacheMap.create()
		self.parseCache = ParseCacheMap.create()
		self.rowSetOverrides = RowSetOverrides.create()
	end 'releaseFrontEndCaches'
end 'QueryDatabase'

function declaredTypeNamesIn(tokens TokenArray) returns ByteArrayArray
	var names = ByteArrayArray.create()

	for i in 0 upto tokens.count() 'eachToken'
		let token = try tokens.get(i) otherwise panic("declaredTypeNamesIn: tokens.get OOB at {i} below count {tokens.count()}")

		if not tokenKindDeclaresATypeName(token.kind) 'notADeclarationKeyword'
			continue
		end 'notADeclarationKeyword'

		let name = try tokens.get(i + 1) otherwise break

		if name.kind == TokenKind.identifier 'aDeclaredName'
			names.push(name.value)
		end 'aDeclaredName'
	end 'eachToken'

	return names
end 'declaredTypeNamesIn'

module function reservedSpellingsIn(tokens TokenArray) returns ByteArrayArray
	var spellings = ByteArrayArray.create()

	for token in tokens 'eachToken'
		if token.kind == TokenKind.identifier and isCompilerReservedName(token.value) 'aReservedSpelling'
			spellings.push(token.value)
		end 'aReservedSpelling'
	end 'eachToken'

	return spellings
end 'reservedSpellingsIn'

function tokenKindDeclaresATypeName(kind TokenKind) returns bool
	return kind == TokenKind.type or kind == TokenKind.enum or kind == TokenKind.union or kind == TokenKind.interface or kind == TokenKind.typealias
end 'tokenKindDeclaresATypeName'
