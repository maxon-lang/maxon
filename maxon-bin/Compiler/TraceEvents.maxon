module function logEvent(group CompilerLogGroup, level LogLevel, name TraceName, unit TraceUnit, arg0 TraceArg, arg1 TraceArg)
	if __DebugStream.enabled() 'attached'
		if compilerLogEnabled(group, level: level) 'enabled'
			__DebugStream.event(name, group.ordinal, ringLogLevelOf(level).rawValue, unit, arg0, arg1)
		end 'enabled'
	end 'attached'
end 'logEvent'
