// Testing/MxdbgSelfTest.maxon — round-trip the `.mxdbg` container through its own writer and reader.
//
// ⭐ **THE FORMAT IS A SHARED CONTRACT AND THIS IS THE HALF THAT NEEDS NO COMPILED PROGRAM.** The
// layout has to be right before any question about a real build's contents is worth asking.
// `tests/debug/sidecar-dump.test.maxon` asks the other half — whether a sidecar says something TRUE
// about the binary beside it — and it needs three spawned processes to do it. This one is pure and
// costs microseconds.
//
// ⚠ **THE ROWS GO IN ASCENDING ORDER.** This writer does not sort — it REFUSES an out-of-order row
// (`requireAscendingLineTable`), because its caller walks chunks in `.text` order — so ascending is the
// contract being exercised, not a convenience.

let AccountFileName = "account.maxon"
let IoFileName = "io.maxon"
let WithdrawName = "withdraw"
let ParseBatchName = "parseBatch"
let SelfTestTriple = "x64-windows"

// `withdraw` occupies [0, 100) and `parseBatch` [100, 200); 250 is the gap past both, which every lookup
// must answer nothing for rather than naming the nearest function.
let WithdrawStart = 0 as MxdbgCodeOffset
let WithdrawEnd = 100 as MxdbgCodeOffset
let ParseBatchStart = 100 as MxdbgCodeOffset
let ParseBatchEnd = 200 as MxdbgCodeOffset
let PastEverything = 250 as MxdbgCodeOffset

let WithdrawFrame = 64 as MxdbgIndex
let ParseBatchFrame = 32 as MxdbgIndex
let WithdrawParams = 1 as MxdbgIndex
let ParseBatchParams = 2 as MxdbgIndex

let AccountFileId = 0 as MxdbgIndex
let IoFileId = 1 as MxdbgIndex

// Two spliced bodies inside `withdraw`: `debit` over [20, 60), and `checkFunds` nested under it over
// [30, 40). 45 is in `debit` alone, 35 in both, 70 in neither.
let DebitName = "debit"
let CheckFundsName = "checkFunds"
let DebitSite = 0 as MxdbgIndex
let CheckFundsSite = 1 as MxdbgIndex
let DebitStart = 20 as MxdbgCodeOffset
let CheckFundsStart = 30 as MxdbgCodeOffset
let CheckFundsEnd = 40 as MxdbgCodeOffset
let DebitEnd = 60 as MxdbgCodeOffset
let InDebitOnly = 45 as MxdbgCodeOffset
let InBoth = 35 as MxdbgCodeOffset
let InNeither = 70 as MxdbgCodeOffset

let TotalName = "total"
let AmountName = "amount"
let TotalRegister = 3 as MxdbgLocValue
let AmountRegister = 5 as MxdbgLocValue
let TotalFirstRunEnd = 40 as MxdbgCodeOffset
let TotalSecondRunStart = 60 as MxdbgCodeOffset

let AmountTypeName = "Amount"
let AmountArrayTypeName = "Array_Amount"
let AmountTypeId = 0 as MxdbgIndex
let AmountArrayTypeId = 1 as MxdbgIndex
let LimitName = "limit"
let LimitConstant = 42 as MxdbgLocValue
let AmountTypeBytes = 8 as MxdbgIndex
let ParcelTypeName = "Parcel"
let ShipmentTypeName = "Shipment"
let ParcelTypeId = 2 as MxdbgIndex
let ShipmentTypeId = 3 as MxdbgIndex
let ParcelName = "parcel"
let ShipmentName = "shipment"
let ParcelWidth = 3 as MxdbgLocValue
let ParcelHeight = 4 as MxdbgLocValue
let ShipmentTag = 1 as MxdbgLocValue
let ShipmentPayload = 19 as MxdbgLocValue
let ParcelWordBase = 0 as MxdbgLocValue
let ShipmentWordBase = 2 as MxdbgLocValue
let AggregateBoxBytes = 16 as MxdbgIndex
let ArrayRecordBytes = 8 as MxdbgIndex

let SharedLine = 12 as MxdbgIndex
let SharedLineFirstOffset = 40 as MxdbgCodeOffset
let SharedLineSecondOffset = 140 as MxdbgCodeOffset
let UnvisitedLine = 99 as MxdbgIndex

let FirstCodeOffset = 0 as MxdbgCodeOffset

let BrokenRowIndent = "\n  "

export function requireMxdbgRoundTrip()
	var broken = StringArray.create()

	checkBuildIdIsAFunctionOfTheBytes(broken)
	checkTablesRoundTrip(broken)

	if broken.isEmpty() 'everyRowHeld'
		return
	end 'everyRowHeld'

	// ⚠ `panic` takes a STRING LITERAL, so the list is built as text and INTERPOLATED — the constraint
	// `SpecVerdictSelfTest` and `HarnessSelfTest` both document.
	let report = indentedList(broken, indent: BrokenRowIndent)
	panic("MxdbgSelfTest: {broken.count()} row(s) of the .mxdbg round trip no longer hold. The debugger and the profiler both read this container, so a layout that has drifted is a sidecar one of them silently misreads.{report}")
end 'requireMxdbgRoundTrip'

// The build-id is the plain FNV-1a fold of the code section and nothing else — deterministic over equal
// bytes, and different over bytes that differ by one character.
function checkBuildIdIsAFunctionOfTheBytes(broken StringArray)
	let hello = Hasher.combined(Hasher.empty(), bytes: b"hello")
	let again = Hasher.combined(Hasher.empty(), bytes: b"hello")
	let hellp = Hasher.combined(Hasher.empty(), bytes: b"hellp")

	if hello != again 'notDeterministic'
		broken.push("the build-id of one byte sequence differs between two folds")
	end 'notDeterministic'

	if hello == hellp 'doesNotDistinguish'
		broken.push("two different code sections fold to the same build-id, so a stale sidecar could never be refused")
	end 'doesNotDistinguish'
end 'checkBuildIdIsAFunctionOfTheBytes'

function checkTablesRoundTrip(broken StringArray)
	let buildId = Hasher.combined(Hasher.empty(), bytes: b"the text of a program")
	let reader = try MxdbgReader.parse(selfTestImage(buildId)) otherwise (e) 'unreadable'
		broken.push("the writer's own image does not parse: {e.displayReason()}")
		return
	end 'unreadable'

	checkHeader(broken, reader: reader, buildId: buildId)
	checkFunctionWindows(broken, reader: reader)
	checkLineLookups(broken, reader: reader)
	checkInlineLookups(broken, reader: reader)
	checkLocalRanges(broken, reader: reader)
	checkFoldedAndIndirect(broken, reader: reader)
	checkFoldedAggregates(broken, reader: reader)
	checkArrayElement(broken, reader: reader)
	checkTypeSignedness(broken, reader: reader)
	checkLineToOffsets(broken, reader: reader)
	checkCallSiteBias(broken)
end 'checkTablesRoundTrip'

function checkFoldedAggregates(broken StringArray, reader MxdbgReader)
	if reader.constantWordCount() != 4 'sectionLost'
		broken.push("the constant-word section reads back {reader.constantWordCount()} word(s) against the 4 written — an aggregate whose words are gone is a struct a debugger names and cannot open")
		return
	end 'sectionLost'

	requireAggregateReads(broken, reader: reader, name: ParcelName, typeId: ParcelTypeId, first: ParcelWordBase, expectedWords: 2, firstWord: ParcelWidth, lastWord: ParcelHeight)
	requireAggregateReads(broken, reader: reader, name: ShipmentName, typeId: ShipmentTypeId, first: ShipmentWordBase, expectedWords: MxdbgUnionAggregateWords, firstWord: ShipmentTag, lastWord: ShipmentPayload)
end 'checkFoldedAggregates'

function requireAggregateReads(broken StringArray, reader MxdbgReader, name String, typeId MxdbgIndex, first MxdbgLocValue, expectedWords MxdbgIndex, firstWord MxdbgLocValue, lastWord MxdbgLocValue)
	let withdraw = reader.functionRecord(0)
	var rows = 0

	for k in withdraw.localFirst upto withdraw.localFirst + withdraw.localCount 'eachLocal'
		let local = reader.localRecord(k as MxdbgIndex)

		if local.name != name 'anotherName'
			continue
		end 'anotherName'

		rows = rows + 1

		if not local.isAFoldedAggregate() or local.locValue != first or local.typeId != typeId 'rowLost'
			broken.push("'{name}' reads back as kind {local.locKind} over words from {local.locValue} of type {local.typeId}, against a folded aggregate from {first} of type {typeId}")
			return
		end 'rowLost'

		let described = reader.typeRecord(local.typeId)
		let words = mxdbgFoldedAggregateWordCount(described.kind, fieldCount: described.fieldCount)

		if words != expectedWords 'wordCountLost'
			broken.push("'{name}' is described as {mxdbgTypeKindName(described.kind)} with {described.fieldCount} field(s), which says its folded value is {words} word(s) against {expectedWords} — the COUNT is read off the type and nowhere else, so a reader and the writer that sized the window would disagree")
			return
		end 'wordCountLost'

		if reader.constantWord((first as MxdbgIndex)) != firstWord or reader.constantWord((first as MxdbgIndex) + words - 1) != lastWord 'wordsLost'
			broken.push("'{name}' reads back {reader.constantWord(first as MxdbgIndex)} and {reader.constantWord((first as MxdbgIndex) + words - 1)}, against {firstWord} and {lastWord}")
		end 'wordsLost'
	end 'eachLocal'

	if rows != 1 'notOneRow'
		broken.push("'{name}' has {rows} row(s) under '{WithdrawName}' against the 1 written")
	end 'notOneRow'
end 'requireAggregateReads'

function checkFoldedAndIndirect(broken StringArray, reader MxdbgReader)
	let withdraw = reader.functionRecord(0)
	var foldedRows = 0
	var pointerRows = 0

	for k in withdraw.localFirst upto withdraw.localFirst + withdraw.localCount 'eachLocal'
		let local = reader.localRecord(k as MxdbgIndex)

		if local.name == LimitName and local.isAConstant() and local.locValue == LimitConstant 'theFoldedOne'
			foldedRows = foldedRows + 1
		end 'theFoldedOne'

		if local.name == TotalName and local.holdsAPointer() 'theArrayOne'
			pointerRows = pointerRows + 1
		end 'theArrayOne'

		if local.name == AmountName and local.holdsAPointer() 'aScalarClaimingIndirection'
			broken.push("'{AmountName}' is a scalar in a register and reads back as holding a POINTER — a debugger would dereference the value itself")
		end 'aScalarClaimingIndirection'

		if local.isAConstant() and local.holdsAPointer() 'aConstantClaimingIndirection'
			broken.push("'{local.name}' reads back as a folded constant that also claims to hold a pointer; a folded immediate is the value and there is nothing to dereference")
		end 'aConstantClaimingIndirection'
	end 'eachLocal'

	if foldedRows != 1 'constantLost'
		broken.push("'{LimitName}' was written as the folded constant {LimitConstant} and {foldedRows} row(s) read back that way — a constant kind nothing round-trips is a name the debugger still cannot answer for")
	end 'constantLost'

	if pointerRows != 2 'indirectionLost'
		broken.push("{pointerRows} of '{TotalName}''s 2 rows read back as holding a POINTER — the driver would read the fused record out of the slot itself rather than out of the address in it")
	end 'indirectionLost'
end 'checkFoldedAndIndirect'

function checkLocalRanges(broken StringArray, reader MxdbgReader)
	let withdraw = reader.functionRecord(0)

	if withdraw.localCount != 6 'windowLost'
		broken.push("'{WithdrawName}' claims {withdraw.localCount} local row(s) against the 6 added under it")
		return
	end 'windowLost'

	var runs = MxdbgCodeOffsetArray.create()

	for k in withdraw.localFirst upto withdraw.localFirst + withdraw.localCount 'eachLocal'
		let local = reader.localRecord(k as MxdbgIndex)

		if local.name != TotalName 'anotherName'
			continue
		end 'anotherName'

		if local.locKind != MxdbgLocKindRegister or local.locValue != TotalRegister or local.typeId != AmountArrayTypeId 'rowLost'
			broken.push("a '{TotalName}' row reads back as kind {local.locKind} value {local.locValue} type {local.typeId}")
		end 'rowLost'

		runs.push(local.scopeStart)
		runs.push(local.scopeEnd)
	end 'eachLocal'

	if runs.count() != 4 'notTwoRuns'
		broken.push("'{TotalName}' reads back as {runs.count() / 2} live range(s) against the 2 it was written with — a name whose rows were merged is one a debugger reads at a PC it is not live at")
		return
	end 'notTwoRuns'

	if (try runs.get(0) otherwise 0) != WithdrawStart or (try runs.get(1) otherwise 0) != TotalFirstRunEnd or (try runs.get(2) otherwise 0) != TotalSecondRunStart or (try runs.get(3) otherwise 0) != WithdrawEnd 'boundsLost'
		broken.push("'{TotalName}' reads back over [0x{try runs.get(0) otherwise 0:x}, 0x{try runs.get(1) otherwise 0:x}) and [0x{try runs.get(2) otherwise 0:x}, 0x{try runs.get(3) otherwise 0:x})")
	end 'boundsLost'
end 'checkLocalRanges'

function checkArrayElement(broken StringArray, reader MxdbgReader)
	if reader.typeCount() != 4 'countsLost'
		broken.push("the type table reads back {reader.typeCount()} entries against 4")
		return
	end 'countsLost'

	let element = reader.typeRecord(AmountTypeId)

	if element.name != AmountTypeName or element.describesAnElement() 'elementRowLost'
		broken.push("type {AmountTypeId} reads back as '{element.name}' and claims an element of its own")
	end 'elementRowLost'

	let array = reader.typeRecord(AmountArrayTypeId)

	if array.name != AmountArrayTypeName or array.kind != MxdbgTypeKindArray 'arrayRowLost'
		broken.push("type {AmountArrayTypeId} reads back as '{array.name}' of kind {mxdbgTypeKindName(array.kind)} against '{AmountArrayTypeName}' of kind {mxdbgTypeKindName(MxdbgTypeKindArray)}")
	end 'arrayRowLost'

	if not array.describesAnElement() or array.elementTypeId != AmountTypeId 'elementLost'
		broken.push("'{AmountArrayTypeName}' names element type {array.elementTypeId} against {AmountTypeId} — an array whose element is unnamed says nothing about how far apart two of them are")
	end 'elementLost'
end 'checkArrayElement'

function checkTypeSignedness(broken StringArray, reader MxdbgReader)
	let ranged = reader.typeRecord(AmountTypeId)

	if not ranged.isSigned() 'signednessLost'
		broken.push("'{AmountTypeName}' reads back UNSIGNED — a signed local holding a negative value then renders as its unsigned bit pattern")
	end 'signednessLost'

	let aggregate = reader.typeRecord(ParcelTypeId)

	if aggregate.isSigned() 'signednessInvented'
		broken.push("'{ParcelTypeName}' reads back SIGNED against the unsigned flag word it was written with")
	end 'signednessInvented'
end 'checkTypeSignedness'

function checkLineToOffsets(broken StringArray, reader MxdbgReader)
	var accountFile = MxdbgIndexArray.create()
	accountFile.push(AccountFileId)
	let offsets = reader.lineToOffsets(accountFile, line: SharedLine)

	if offsets.count() != 2 'copiesLost'
		broken.push("{AccountFileName}:{SharedLine} resolves to {offsets.count()} offset(s) against the 2 rows that carry it — a line that lives at several addresses owes every one of them")
		return
	end 'copiesLost'

	if (try offsets.get(0) otherwise 0) != SharedLineFirstOffset or (try offsets.get(1) otherwise 0) != SharedLineSecondOffset 'orderLost'
		broken.push("{AccountFileName}:{SharedLine} resolves to 0x{try offsets.get(0) otherwise 0:x} and 0x{try offsets.get(1) otherwise 0:x}, against 0x{SharedLineFirstOffset:x} and 0x{SharedLineSecondOffset:x} ascending")
	end 'orderLost'

	if reader.lineToOffsets(accountFile, line: UnvisitedLine).count() != 0 'aLineWithNoCode'
		broken.push("{AccountFileName}:{UnvisitedLine} carries no row and resolved to an offset anyway")
	end 'aLineWithNoCode'
end 'checkLineToOffsets'

function checkCallSiteBias(broken StringArray)
	if MxdbgReader.callSiteLookup(FirstCodeOffset) != FirstCodeOffset 'wrappedPastTheStart'
		broken.push("the call-site bias moves offset 0 to 0x{MxdbgReader.callSiteLookup(FirstCodeOffset):x}, which is past the start of `.text`")
	end 'wrappedPastTheStart'

	if MxdbgReader.callSiteLookup(SharedLineFirstOffset) != SharedLineFirstOffset - 1 'notBiased'
		broken.push("the call-site bias leaves a return address at 0x{SharedLineFirstOffset:x} unbiased, which names the line AFTER the call")
	end 'notBiased'
end 'checkCallSiteBias'

function selfTestImage(buildId HashDigest) returns ByteArray
	var writer = MxdbgWriter.create()
	writer.addFile(AccountFileName)
	writer.addFile(IoFileName)
	writer.addType(AmountTypeName, kind: MxdbgTypeKindIntRanged, size: AmountTypeBytes, align: AmountTypeBytes, elementTypeId: MxdbgNoElementType, flags: MxdbgTypeFlagSigned)
	writer.addType(AmountArrayTypeName, kind: MxdbgTypeKindArray, size: ArrayRecordBytes, align: ArrayRecordBytes, elementTypeId: AmountTypeId, flags: 0)
	writer.addType(ParcelTypeName, kind: MxdbgTypeKindStruct, size: AggregateBoxBytes, align: AmountTypeBytes, elementTypeId: MxdbgNoElementType, flags: 0)
	writer.addField("width", offset: 0, typeId: AmountTypeId)
	writer.addField("height", offset: AmountTypeBytes, typeId: AmountTypeId)
	writer.addType(ShipmentTypeName, kind: MxdbgTypeKindUnion, size: AggregateBoxBytes, align: AmountTypeBytes, elementTypeId: MxdbgNoElementType, flags: 0)
	writer.addField("empty", offset: 0, typeId: AmountTypeId)
	writer.addField("carrying", offset: 1, typeId: AmountTypeId)
	_ = writer.addConstantWord(ParcelWidth)
	_ = writer.addConstantWord(ParcelHeight)
	_ = writer.addConstantWord(ShipmentTag)
	_ = writer.addConstantWord(ShipmentPayload)
	writer.addFunction(WithdrawName, codeStart: WithdrawStart, codeEnd: WithdrawEnd, frameSize: WithdrawFrame, paramCount: WithdrawParams)
	writer.addLocal(AmountName, locKind: MxdbgLocKindRegister, locValue: AmountRegister, typeId: AmountTypeId, scopeStart: WithdrawStart, scopeEnd: WithdrawEnd, flags: 0)
	writer.addLocal(LimitName, locKind: MxdbgLocKindConstant, locValue: LimitConstant, typeId: AmountTypeId, scopeStart: WithdrawStart, scopeEnd: WithdrawEnd, flags: 0)
	writer.addLocal(ParcelName, locKind: MxdbgLocKindFoldedAggregate, locValue: ParcelWordBase, typeId: ParcelTypeId, scopeStart: WithdrawStart, scopeEnd: WithdrawEnd, flags: 0)
	writer.addLocal(ShipmentName, locKind: MxdbgLocKindFoldedAggregate, locValue: ShipmentWordBase, typeId: ShipmentTypeId, scopeStart: WithdrawStart, scopeEnd: WithdrawEnd, flags: 0)
	writer.addLocal(TotalName, locKind: MxdbgLocKindRegister, locValue: TotalRegister, typeId: AmountArrayTypeId, scopeStart: WithdrawStart, scopeEnd: TotalFirstRunEnd, flags: MxdbgLocalFlagIndirect)
	writer.addLocal(TotalName, locKind: MxdbgLocKindRegister, locValue: TotalRegister, typeId: AmountArrayTypeId, scopeStart: TotalSecondRunStart, scopeEnd: WithdrawEnd, flags: MxdbgLocalFlagIndirect)
	writer.addFunction(ParseBatchName, codeStart: ParseBatchStart, codeEnd: ParseBatchEnd, frameSize: ParseBatchFrame, paramCount: ParseBatchParams)
	writer.addLine(0, fileId: AccountFileId, line: 10, column: 1, flags: MxdbgLineFlagStatement)
	writer.addLine(16, fileId: AccountFileId, line: 11, column: 5, flags: MxdbgLineFlagStatement)
	writer.addLine(SharedLineFirstOffset, fileId: AccountFileId, line: SharedLine, column: 5, flags: MxdbgLineFlagStatement)
	writer.addLine(100, fileId: IoFileId, line: 5, column: 1, flags: MxdbgLineFlagStatement)
	writer.addLine(120, fileId: IoFileId, line: 6, column: 9, flags: MxdbgLineFlagStatement)
	writer.addLine(SharedLineSecondOffset, fileId: AccountFileId, line: SharedLine, column: 5, flags: MxdbgLineFlagStatement)

	// The nested body's blocks carry the inner site, so `debit` is two ranges around `checkFunds`'s one.
	writer.addInlineSite(DebitName, parent: MxdbgNoParentSite)
	writer.addInlineSite(CheckFundsName, parent: DebitSite)
	writer.addInlineRange(DebitStart, codeEnd: CheckFundsStart, site: DebitSite)
	writer.addInlineRange(CheckFundsStart, codeEnd: CheckFundsEnd, site: CheckFundsSite)
	writer.addInlineRange(CheckFundsEnd, codeEnd: DebitEnd, site: DebitSite)

	return writer.build(buildId, targetTriple: SelfTestTriple)
end 'selfTestImage'

// ⭐ **THE INLINE-FRAME ANSWERS, INCLUDING THE NESTED ONE.** An offset inside the inner body names the
// inner site, whose parent is the outer; an offset in the outer body alone names the outer, whose parent
// is none; an offset under no range names nothing.
function checkInlineLookups(broken StringArray, reader MxdbgReader)
	if reader.inlineSiteCount() != 2 or reader.inlineRangeCount() != 3 'countsLost'
		broken.push("the inline tables read back as {reader.inlineSiteCount()} site(s) / {reader.inlineRangeCount()} range(s) against 2 / 3")
	end 'countsLost'

	match reader.inlineSiteContaining(InBoth) 'nested'
		none then broken.push("offset {InBoth} lies inside '{CheckFundsName}' and resolved to no site")
		site(index) then requireSiteChain(broken, reader: reader, index: index, name: CheckFundsName, parentName: DebitName)
	end 'nested'

	match reader.inlineSiteContaining(InDebitOnly) 'outer'
		none then broken.push("offset {InDebitOnly} lies inside '{DebitName}' and resolved to no site")
		site(index) then requireOutermostSite(broken, reader: reader, index: index, name: DebitName)
	end 'outer'

	match reader.inlineSiteContaining(InNeither) 'gap'
		none then break 'gap'
		site(index) then broken.push("offset {InNeither} is under no inline range and resolved to '{reader.inlineSite(index).name}'")
	end 'gap'
end 'checkInlineLookups'

function requireSiteChain(broken StringArray, reader MxdbgReader, index MxdbgIndex, name String, parentName String)
	let site = reader.inlineSite(index)

	if site.name != name 'wrongSite'
		broken.push("the nested offset resolves to '{site.name}' against '{name}'")
		return
	end 'wrongSite'

	match site.parent 'parent'
		none then broken.push("'{name}' reads back with no parent, against '{parentName}'")
		site(parentIndex) then requireOutermostSite(broken, reader: reader, index: parentIndex, name: parentName)
	end 'parent'
end 'requireSiteChain'

function requireOutermostSite(broken StringArray, reader MxdbgReader, index MxdbgIndex, name String)
	let site = reader.inlineSite(index)

	if site.name != name 'wrongSite'
		broken.push("the outer site reads back as '{site.name}' against '{name}'")
	end 'wrongSite'

	match site.parent 'parent'
		none then break 'parent'
		site(parentIndex) then broken.push("'{name}' is spliced into its function's own text but reads back nested under '{reader.inlineSite(parentIndex).name}'")
	end 'parent'
end 'requireOutermostSite'

function checkHeader(broken StringArray, reader MxdbgReader, buildId HashDigest)
	if reader.buildId != buildId 'buildIdLost'
		broken.push("the build-id does not survive the round trip")
	end 'buildIdLost'

	if reader.triple != SelfTestTriple 'tripleLost'
		broken.push("the target triple reads back as '{reader.triple}' rather than '{SelfTestTriple}'")
	end 'tripleLost'

	if reader.fileCount() != 2 or reader.functionCount() != 2 or reader.lineCount() != 6 'countsLost'
		broken.push("the table counts read back as {reader.fileCount()} files / {reader.functionCount()} functions / {reader.lineCount()} rows against 2 / 2 / 6")
	end 'countsLost'

	if reader.fileName(AccountFileId) != AccountFileName or reader.fileName(IoFileId) != IoFileName 'namesLost'
		broken.push("the file table reads back as '{reader.fileName(AccountFileId)}' / '{reader.fileName(IoFileId)}'")
	end 'namesLost'
end 'checkHeader'

// Each function's record, and the LINE WINDOW the writer computed for it — the one field nothing else
// would notice being wrong, because the rows themselves would still all be present and in order.
function checkFunctionWindows(broken StringArray, reader MxdbgReader)
	let withdraw = reader.functionRecord(0)

	if withdraw.name != WithdrawName or withdraw.codeStart != WithdrawStart or withdraw.codeEnd != WithdrawEnd or withdraw.frameSize != WithdrawFrame or withdraw.paramCount != WithdrawParams 'firstRecordLost'
		broken.push("function 0 reads back as '{withdraw.name}' [0x{withdraw.codeStart:x}, 0x{withdraw.codeEnd:x}) frame=0x{withdraw.frameSize:x} params={withdraw.paramCount}")
	end 'firstRecordLost'

	if withdraw.lineFirst != 0 or withdraw.lineCount != 3 'firstWindowWrong'
		broken.push("'{WithdrawName}' claims rows [{withdraw.lineFirst}, +{withdraw.lineCount}) against the 3 that lie inside its range")
	end 'firstWindowWrong'

	let parseBatch = reader.functionRecord(1)

	if parseBatch.lineFirst != 3 or parseBatch.lineCount != 3 'secondWindowWrong'
		broken.push("'{ParseBatchName}' claims rows [{parseBatch.lineFirst}, +{parseBatch.lineCount}) against the 3 that lie inside its range")
	end 'secondWindowWrong'

	if not functionAtIs(reader, offset: 150, name: ParseBatchName) 'containmentWrong'
		broken.push("offset 150 does not resolve to '{ParseBatchName}', whose range holds it")
	end 'containmentWrong'

	match reader.functionContaining(PastEverything) 'inTheGap'
		none then break 'inTheGap'
		found(fn) then broken.push("offset {PastEverything} is past every function and resolved to '{fn.name}'")
	end 'inTheGap'
end 'checkFunctionWindows'

// ⭐ **THE PC→LINE ANSWERS, INCLUDING THE THREE THAT ARE ONLY RIGHT BY THE `greatest row at or before`
// RULE**: between two rows, on a function's LAST byte, and on the first byte of the NEXT function — where
// a naive search lands on the previous function's last row and reports another file entirely.
function checkLineLookups(broken StringArray, reader MxdbgReader)
	requireLineAt(broken, reader: reader, offset: 0, file: AccountFileName, line: 10)
	requireLineAt(broken, reader: reader, offset: 8, file: AccountFileName, line: 10)
	requireLineAt(broken, reader: reader, offset: 16, file: AccountFileName, line: 11)
	requireLineAt(broken, reader: reader, offset: 50, file: AccountFileName, line: 12)
	requireLineAt(broken, reader: reader, offset: 99, file: AccountFileName, line: 12)
	requireLineAt(broken, reader: reader, offset: 100, file: IoFileName, line: 5)
	requireLineAt(broken, reader: reader, offset: 130, file: IoFileName, line: 6)

	match reader.pcToLine(PastEverything) 'inTheGap'
		none then break 'inTheGap'
		found(row) then broken.push("offset {PastEverything} is in no function and resolved to {row.file}:{row.line}")
	end 'inTheGap'
end 'checkLineLookups'

function requireLineAt(broken StringArray, reader MxdbgReader, offset MxdbgCodeOffset, file String, line MxdbgIndex)
	match reader.pcToLine(offset) 'row'
		none then broken.push("offset {offset} resolves to no line, against {file}:{line}")
		found(got) then noteLineMismatch(broken, offset: offset, got: got, file: file, line: line)
	end 'row'
end 'requireLineAt'

function noteLineMismatch(broken StringArray, offset MxdbgCodeOffset, got MxdbgLineInfo, file String, line MxdbgIndex)
	if got.file == file and got.line == line 'asExpected'
		return
	end 'asExpected'

	broken.push("offset {offset} resolves to {got.file}:{got.line}, against {file}:{line}")
end 'noteLineMismatch'

function functionAtIs(reader MxdbgReader, offset MxdbgCodeOffset, name String) returns bool
	return match reader.functionContaining(offset) 'fn'
		none gives false
		found(info) gives info.name == name
	end 'fn'
end 'functionAtIs'
