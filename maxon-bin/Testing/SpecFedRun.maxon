let FedRunPollMs = 5
let FedRunSurvivorDrainMs = 100
let FedRunLineEnd = "\n"

union FedRunProgress
	finished(status TerminationStatus)
	waiting
end 'FedRunProgress'

type FedRun
	var child as StreamingSubprocess
	var stdout = ""
	var stderr = ""
	var fed = false
	let anchor as String
	let feed as String

	static function begin(child StreamingSubprocess, anchor String, feed String) returns FedRun
		return Self{child: child, anchor: anchor, feed: feed}
	end 'begin'

	function conclude(timeoutMs DurationMs) returns ProcessCapture throws SubprocessError
		let status = try self.pump(timeoutMs) otherwise (e) 'unfinished'
			self.child.release()
			throw e
		end 'unfinished'

		self.child.release()

		return ProcessCapture.create(status.code() as ExitCodeValue, stdout: self.stdout, stderr: self.stderr)
	end 'conclude'

	function absorbAvailable() returns bool
		let outMoved = self.absorbStdoutLine()
		let errMoved = self.absorbStderrLine()

		return outMoved or errMoved
	end 'absorbAvailable'

	function absorbStdoutLine() returns bool
		match try self.child.tryReadStdoutLine() otherwise panic("the child's stdout is out with a StdoutReader") 'polled'
			none then return false
			line(text) then self.noteStdout(text)
		end 'polled'

		return true
	end 'absorbStdoutLine'

	function absorbStderrLine() returns bool
		match self.child.tryReadStderrLine() 'polled'
			none then return false
			line(text) then self.stderr.append("{text}{FedRunLineEnd}")
		end 'polled'

		return true
	end 'absorbStderrLine'

	function noteStdout(text String)
		self.stdout.append("{text}{FedRunLineEnd}")

		if self.fed or text != self.anchor 'notTheAnchor'
			return
		end 'notTheAnchor'

		// A child that exits without reading has already closed its end, which is the case's outcome to
		// judge rather than a harness error.
		try self.child.writeStdinLine(self.feed) otherwise ignore
		self.child.closeStdin()
		self.fed = true
	end 'noteStdout'

	function pump(timeoutMs DurationMs) returns TerminationStatus throws SubprocessError
		let start = Clock.nowMs()

		while true 'pump'
			try self.requireTimeLeft(start, timeoutMs: timeoutMs)

			if self.absorbAvailable() 'moved'
				continue
			end 'moved'

			match self.progress() 'progress'
				finished(status) then return status
				waiting then sleep(FedRunPollMs)
			end 'progress'
		end 'pump'

		panic("FedRun.pump: the pump loop leaves only by returning or throwing")
	end 'pump'

	function progress() returns FedRunProgress
		if not (self.child.streamHasEnded(StdioStream.stdout) and self.child.streamHasEnded(StdioStream.stderr)) 'stillOpen'
			return FedRunProgress.waiting
		end 'stillOpen'

		return match self.child.pollTermination() 'polled'
			ended(status) gives FedRunProgress.finished(status)
			running gives FedRunProgress.waiting
		end 'polled'
	end 'progress'

	function requireTimeLeft(start InstantMs, timeoutMs DurationMs) throws SubprocessError
		if Clock.elapsedMs(start) >= timeoutMs 'expired'
			throw self.endedByDeadline(Clock.elapsedMs(start))
		end 'expired'
	end 'requireTimeLeft'

	function endedByDeadline(elapsedMs DurationMs) returns SubprocessError
		return match self.child.endTree() 'tree'
			ended gives self.timeoutOf(elapsedMs)
			survived(osError) gives self.treeNotEndedOf(elapsedMs, osError: osError)

			// No kill was confirmed: reporting a timeout would claim the tree ended, which nothing confirmed.
			unconfirmed(reason) gives SubprocessError.ioFailed(reason)
		end 'tree'
	end 'endedByDeadline'

	function timeoutOf(elapsedMs DurationMs) returns SubprocessError
		self.absorbWithinSurvivorWindow()

		return SubprocessError.timeout(elapsedMs, stdout: self.stdout, stderr: self.stderr)
	end 'timeoutOf'

	// A survivor, or a process the child started outside its tree, may hold the pipes open forever, so
	// nothing waits for their end here. The
	// `FedRunSurvivorDrainMs` bound stops a descendant that writes continuously from keeping this loop
	// running and growing the captured output without limit.
	function absorbWithinSurvivorWindow()
		let start = Clock.nowMs()
		var moved = true

		while moved and Clock.elapsedMs(start) < FedRunSurvivorDrainMs 'available'
			moved = self.absorbAvailable()
		end 'available'
	end 'absorbWithinSurvivorWindow'

	function treeNotEndedOf(elapsedMs DurationMs, osError OsErrorCode) returns SubprocessError
		self.absorbWithinSurvivorWindow()

		return SubprocessError.treeNotEnded(elapsedMs, stdout: self.stdout, stderr: self.stderr, osError: osError)
	end 'treeNotEndedOf'
end 'FedRun'

export function runProcessFedAfter(exe Executable, argv StringArray, workingDirectory FilePath, timeoutMs DurationMs, environment Environment, anchor String, feed String) returns ProcessCapture throws SubprocessError
	let child = try StreamingSubprocess.spawnWithEnvironment(exe, arguments: argv, workingDirectory: workingDirectory, environment: environment)
	var run = FedRun.begin(child, anchor: anchor, feed: feed)

	return try run.conclude(timeoutMs)
end 'runProcessFedAfter'
