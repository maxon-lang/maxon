let FedRunSurvivorDrainMs = 100

function treeEndError(tree TreeEnd, report ChildRunReport) returns SubprocessError
	return match tree 'tree'
		ended gives SubprocessError.timeout(report.elapsedMs, stdout: report.stdout, stderr: report.stderr)
		survived(osError) gives SubprocessError.treeNotEnded(report.elapsedMs, stdout: report.stdout, stderr: report.stderr, osError: osError)
		unconfirmed(reason) gives SubprocessError.ioFailed(reason)
	end 'tree'
end 'treeEndError'

function deadlineError(report ChildRunReport) returns SubprocessError
	return match report.survivors 'survivors'
		noneHeld panic("deadlineError: a run that reached its deadline ended the child's tree, so it has a tree end to report")
		ended(tree) gives treeEndError(tree, report: report)
	end 'survivors'
end 'deadlineError'

function refusedWait(refusal WaitRefusal, report ChildRunReport) returns SubprocessError
	return match refusal 'which'
		treeNotEnded(osError) gives SubprocessError.treeNotEnded(report.elapsedMs, stdout: report.stdout, stderr: report.stderr, osError: osError)
		ioFailed(reason) gives SubprocessError.ioFailed(reason)
	end 'which'
end 'refusedWait'

function capturedAfter(report ChildRunReport) returns ProcessCapture throws SubprocessError
	match report.ending 'ending'
		exited(code) then return ProcessCapture.create(code as ExitCodeValue, stdout: report.stdout, stderr: report.stderr)
		reapedElsewhere then throw SubprocessError.statusLost(report.stdout, stderr: report.stderr)
		deadline then throw deadlineError(report)
		waitFailed(refusal) then throw refusedWait(refusal, report: report)
	end 'ending'
end 'capturedAfter'

export function runProcessFedAfter(exe Executable, argv StringArray, workingDirectory WorkingDirectory, timeoutMs DurationMs, environment Environment, anchor String, feed String) returns ProcessCapture throws SubprocessError
	let outcome = try runChildFedAfterLine(exe, argv: argv, workingDirectory: workingDirectory, environment: environment, deadlineMs: timeoutMs, endsWhen: RunEndsWhen.outputEnds, tailSilenceMs: FedRunSurvivorDrainMs, tailCapMs: FedRunSurvivorDrainMs, anchor: anchor, feed: feed)

	match outcome 'outcome'
		ran(report) then return try capturedAfter(report)
		outputBroken(stream, reason, _) then throw SubprocessError.ioFailed("reading the program's {stream.name} failed ({reason})")
	end 'outcome'
end 'runProcessFedAfter'
