// ScaleResultJson — `--result-json=<path>`: the whole run as a structured document.
//
// The MCP tool that drives this instrument must not SCRAPE the report. The report is a padded ASCII
// table whose columns exist to be read by a person, and the day a phase name outgrows its column a
// scrape would silently mis-parse rather than fail — which is exactly the failure mode the metrics
// TSV was introduced to avoid one level down (see MetricsEmit's header). A caller that wants data
// gets data.
//
// THERE IS NO `verdict` FIELD, and there is no `budget` and no `gated`. This suite renders no
// verdict: it reports numbers and their deltas from the last recorded run, and the caller — a person
// or a model — reads them. A field named `verdict` would invite exactly the reflex the whole redesign
// removed: look for the green light, and if it is not green, make it green.
//
// AND THERE IS NO WALL TIME, AND NO EXPONENT. Not `nanos`, not `ms`, not a fitted growth curve, not
// a residual, not a share. The ladder DOUBLES, so the ratio between two rungs IS the growth and a
// consumer can take it from the counts in this document with a division; and wall time counts every
// other process on the box, so any number derived from it would say more about what else the machine
// was doing than about the compiler. The metrics TSV carries a nanosecond column, the runner reads
// past it, and it does not reach this document.
//
// THERE IS A `cpuTicks`, AND IT IS NOT THE SAME KIND OF NUMBER AS THE OTHER THREE. It counts time
// consumed by the COMPILING THREAD alone — preemption and every other process are invisible to it —
// which is exactly what makes it trendable where wall time is not, and it is the only column here
// that can see a cost which allocates nothing. But it is NOT bit-reproducible the way allocs, frees
// and bytes are: it moves a few percent with turbo, thermal throttling and cache pressure from other
// cores, and a movement inside that band is not a datapoint. Its unit is platform-defined (TSC ticks
// on Windows, nanoseconds on POSIX) and there is no honest conversion between them, so a consumer
// compares RATIOS between rungs, which are unit-free, and absolutes only against runs from the same
// platform. The other three carry no such caveat, which is what makes differencing two of these
// documents on THEM mean anything at all.
//
// AND THAT ASYMMETRY IS WHY `repeat` IS HERE. Each rung is compiled `--repeat` times: the exact
// columns come from the first compile and are CROSS-CHECKED identical in every other, while
// `cpuTicks` is the MINIMUM across them — the least-disturbed sample, since noise can only ADD to a
// CPU reading. Nothing else in this document distinguishes a single undefended sample from a
// min-of-three, and that is the difference between a CPU number worth acting on and one that is not.
//
// AND `mintedAt` IS HERE FOR THE SAME REASON `repeat` IS: it says which numbers may be subtracted from
// which. TWO absolute paths reach the BYTE volume of every compile — the compiler's own (every stdlib
// source path is derived from it) and the working directory (every rung source path is resolved against
// it) — so a byte delta between two documents minted at different paths is a confident fiction.
// `mintedAt` is the pair, rendered by `mintedAtCell` so that what is written and what is compared are one
// string. `bytesDelta` is therefore ABSENT when the logged row this run was differenced against was
// minted elsewhere.
//
// ⚠ `allocsDelta` IS STILL ALWAYS PRESENT, AND IT IS NOT PATH-INDEPENDENT — this comment claimed it was
// until it was measured. That column carries a CONSTANT offset across two checkouts, where the byte term
// grows with the program. It stays present because a flat offset leaves the SHAPE intact — ratios between
// rungs, and any delta that grows per rung — and a consumer reading the CONSTANT term across a mismatched
// pair already has its signal in the same document: `previous.bytesComparable: false` is that pair, and it
// is one flag rather than two spellings of it.
//
// ⚠ THE NUMBERS BEHIND BOTH PARAGRAPHS ARE IN ScaleHistory's HEADER AND ARE NOT REPEATED HERE. This file
// used to carry its own copy of them, which is how it came to carry its own copy of the false conclusion
// drawn from them: the `path-independent` claim had to be hand-corrected in four files, and a reading
// quoted in four places is three chances to correct only three.
//
// Shape:
//   {
//     "repeat": 3,                                    // compiles per rung; ABSENT if not stated
//     "mintedAt": "<compiler path> (corpus <dir>)",   // what this run's bytes are comparable WITH
//     "rungs":  [ { rung, sourceBytes, codeBytes, allocs, frees, bytes, cpuTicks,
//                   allocsDelta?, bytesDelta?,        // vs the last logged run; ABSENT if there is none
//                                                     // bytesDelta also ABSENT across minting paths
//                   phases:   [ {name, allocs, frees, bytes, cpuTicks} ],
//                   regalloc: [ {name, allocs, frees, bytes, cpuTicks} ] } ],
//     "corpus": { grew, minGrowthPermille?, floorPermille, reason? },
//     "previous": { present, date?, mintedAt?, note?, bytesComparable?, bytesWithheld? }
//   }

// HOW MANY COMPILES each rung's numbers were folded from — the value of `--repeat`.
//
// A UNION, NOT A COUNT WITH A DEFAULT. This file cannot know what `--repeat` was given, and writing
// the usual answer because it is usual would put a number in a machine-readable document that no run
// produced. `unstated` omits the field entirely, which is the rule `allocsDelta` already follows:
// absence says "not known", and it is never spelled as a value a consumer could arithmetic on.
export union RepeatSampling
	stated(count RepeatCount)
	unstated
end 'RepeatSampling'

export function writeResultJson(path String, results RungResultArray, trend LoggedMemory, repeat RepeatSampling, mintedAt String, bytes ByteDelta) throws ScaleError
	let target = try FilePath.from(path) otherwise throw ScaleError.reason("'{path}' is not a valid --result-json path")

	var doc = JsonDoc.create()
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()

	addRepeatSampling(doc, keys: keys, children: children, repeat: repeat)

	pushJsonString(doc, keys: keys, children: children, key: "mintedAt", value: mintedAt)

	keys.push("rungs")
	children.push(rungsNode(doc, results: results, trend: trend, bytes: bytes))

	keys.push("corpus")
	children.push(corpusNode(doc, results: results))

	keys.push("previous")
	children.push(previousNode(doc, trend: trend, bytes: bytes))

	doc.root = doc.add(JsonNode.objectNode(keys, children: children))

	// A FAILURE HERE IS A BROKEN RUN, and it throws.
	//
	// It used to log and return, leaving the process to exit 0 — and the caller that asked for this
	// document is a MACHINE. The MCP tool deletes any stale result file before the run precisely so
	// that its absence is meaningful, then reports `error: scale-test wrote no result document` beside
	// an `exitCode` of 0: two halves of one envelope contradicting each other, with the exit code — the
	// half a script reads — saying everything was fine. A run that was asked for its measurements in a
	// file and could not put them there is a run that broke, exactly as a trend log it cannot write is.
	try File.writeText(target, content: Json.stringifyPrettyNode(doc, root: doc.root)) otherwise throw ScaleError.reason("could not write the result document to {path}")
end 'writeResultJson'

// FIRST FIELD IN THE DOCUMENT, because it qualifies every number after it: the CPU readings below
// are a minimum over this many compiles, and the exact ones were checked identical across them.
function addRepeatSampling(doc JsonDoc, keys StringArray, children JsonNodeIdArray, repeat RepeatSampling)
	match repeat 'r'
		unstated then return
		stated(count) then pushJsonNumber(doc, keys: keys, children: children, key: "repeat", value: count as JsonFloat)
	end 'r'
end 'addRepeatSampling'

// ===========================================================================================
// Rungs
// ===========================================================================================

function rungsNode(doc JsonDoc, results RungResultArray, trend LoggedMemory, bytes ByteDelta) returns JsonNodeId
	var items = JsonNodeIdArray.create()
	for i in 0 upto results.count() 'eachRung'
		let result = try results.get(i) otherwise panic("rungsNode: i < count but results.get({i}) failed")

		var keys = StringArray.create()
		var children = JsonNodeIdArray.create()

		pushJsonNumber(doc, keys: keys, children: children, key: "rung", value: result.rung as JsonFloat)
		pushJsonNumber(doc, keys: keys, children: children, key: "sourceBytes", value: result.sourceBytes as JsonFloat)
		pushJsonNumber(doc, keys: keys, children: children, key: "codeBytes", value: result.codeBytes as JsonFloat)
		addMetricFields(doc, keys: keys, children: children, metric: result.total)

		// The deltas the report prints, so a consumer never has to re-derive them from the log. ABSENT
		// rather than zero when there is nothing to compare against: a zero delta means "identical",
		// which is a strong claim, and it must not be what "no previous run" looks like.
		//
		// THERE IS NO `cpuTicksDelta`, and its absence is a decision rather than an omission. The
		// logged row it would subtract from may have been recorded on another machine, or on a
		// platform whose ticks are a different unit entirely — so the subtraction would be arithmetic
		// over two numbers that are not the same quantity, and it would produce a confident one. The
		// CPU column is compared as a RATIO between rungs of ONE run, which is unit-free and
		// machine-free; `LoggedMemory` carries allocs and bytes and nothing else for the same reason.
		addMemoryDeltas(doc, keys: keys, children: children, result: result, rung: i, trend: trend, bytes: bytes)

		// The per-phase breakdown, off the ONE phase enumeration the human table also walks
		// (ScaleTestRunner.scalePhaseSources) — so a phase added to `CompilePhase` appears in the report
		// and in this document together, or in neither.
		var phases = JsonNodeIdArray.create()
		var subs = JsonNodeIdArray.create()
		for source in scalePhaseSources() 'eachPhase'
			let node = metricNode(doc, name: phaseSourceName(source), metric: phaseMetricOf(source, result: result))
			match source 'src'
				compilePhase then phases.push(node)
				regAllocPhase then subs.push(node)
			end 'src'
		end 'eachPhase'

		keys.push("phases")
		children.push(doc.add(JsonNode.arrayNode(phases)))
		keys.push("regalloc")
		children.push(doc.add(JsonNode.arrayNode(subs)))

		items.push(doc.add(JsonNode.objectNode(keys, children: children)))
	end 'eachRung'
	return doc.add(JsonNode.arrayNode(items))
end 'rungsNode'

function addMemoryDeltas(doc JsonDoc, keys StringArray, children JsonNodeIdArray, result RungResult, rung LadderIndex, trend LoggedMemory, bytes ByteDelta)
	match trend 'm'
		absent then return
		present(_, _, _, allocs, loggedBytes) then addLoggedDeltas(doc, keys: keys, children: children, result: result, rung: rung, loggedAllocs: allocs, loggedBytes: loggedBytes, bytes: bytes)
	end 'm'
end 'addMemoryDeltas'

function addLoggedDeltas(doc JsonDoc, keys StringArray, children JsonNodeIdArray, result RungResult, rung LadderIndex, loggedAllocs AllocCountArray, loggedBytes ByteCountArray, bytes ByteDelta)
	let beforeAllocs = try loggedAllocs.get(rung) otherwise 'notLogged'
		// This run climbed further than the logged one. The extra rungs have no past, and saying so by
		// omission is exactly right.
		return
	end 'notLogged'
	let beforeBytes = try loggedBytes.get(rung) otherwise panic("addLoggedDeltas: the two logged columns are the same length — loadScaleTrend refuses a log where they are not")

	pushJsonNumber(doc, keys: keys, children: children, key: "allocsDelta", value: ((result.total.allocs - beforeAllocs) as JsonFloat))

	// OMITTED, never zero, when the logged row was minted at another path — the same rule `allocsDelta`
	// follows one line up when a rung has no past. A consumer that finds no `bytesDelta` knows the
	// subtraction was refused; one handed a number could not have known it was fiction.
	match bytes 'b'
		withheld then return
		comparable then pushJsonNumber(doc, keys: keys, children: children, key: "bytesDelta", value: ((result.total.bytes - beforeBytes) as JsonFloat))
	end 'b'
end 'addLoggedDeltas'

function metricNode(doc JsonDoc, name String, metric PhaseMetric) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	pushJsonString(doc, keys: keys, children: children, key: "name", value: name)
	addMetricFields(doc, keys: keys, children: children, metric: metric)
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'metricNode'

// The four numbers a PhaseMetric IS, written by ONE function — so the whole-rung object and the
// per-phase objects cannot drift into carrying different fields for the same measurement.
//
// `cpuTicks` is APPENDED after the three exact counters rather than interleaved among them, and the
// order is the TRUST order: everything before it is bit-reproducible and everything after it is not.
// A consumer reading these fields in order reads them in decreasing order of how much a small
// movement in one is worth — see the header for the band.
function addMetricFields(doc JsonDoc, keys StringArray, children JsonNodeIdArray, metric PhaseMetric)
	pushJsonNumber(doc, keys: keys, children: children, key: "allocs", value: metric.allocs as JsonFloat)
	pushJsonNumber(doc, keys: keys, children: children, key: "frees", value: metric.frees as JsonFloat)
	pushJsonNumber(doc, keys: keys, children: children, key: "bytes", value: metric.bytes as JsonFloat)
	pushJsonNumber(doc, keys: keys, children: children, key: "cpuTicks", value: metric.cpuTicks as JsonFloat)
end 'addMetricFields'

// ===========================================================================================
// The corpus self-check, and what this run is measured against
// ===========================================================================================

// Exposed so a consumer can see the NUMBER rather than trust a flag. `grew: false` is the one
// condition the runner exits non-zero for — the corpus folded away, so nothing was measured — and a
// consumer looking at a set of impossibly tidy numbers deserves to see why they are not to be
// believed.
//
// `minGrowthPermille` is the WEAKEST rung-over-rung growth of emitted code on the ladder, in
// thousandths: 2000 is x2.00, which is what a doubling ladder that really compiles produces. The
// weakest, and not the average, because one rung that folded is one rung that measured nothing, and an
// average would hide it behind five rungs that did not.
function corpusNode(doc JsonDoc, results RungResultArray) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	pushJsonNumber(doc, keys: keys, children: children, key: "floorPermille", value: (MinCodeGrowthRatio * PermillePerHundredth) as JsonFloat)

	match weakestCodeGrowth(results) 'g'
		noBaseline then addNoGrowthReading(doc, keys: keys, children: children)
		measured(ratio) then addCorpusGrowth(doc, keys: keys, children: children, ratio: ratio)
	end 'g'

	return doc.add(JsonNode.objectNode(keys, children: children))
end 'corpusNode'

// The document reports growth in THOUSANDTHS where ScaleRatio counts in hundredths. One conversion, in
// one place: a consumer that differences two documents wants the extra digit, and a human reading a
// table at a glance does not.
let PermillePerHundredth = 10

// The weakest rung-over-rung growth on the ladder — the rung most likely to have folded.
function weakestCodeGrowth(results RungResultArray) returns GrowthReading
	var weakest = GrowthReading.noBaseline

	for i in 1 upto results.count() 'eachRung'
		match codeGrowthAt(results, rung: i) 'h'
			noBaseline then continue
			measured(ratio) then weakest = weakerOf(weakest, ratio: ratio)
		end 'h'
	end 'eachRung'

	return weakest
end 'weakestCodeGrowth'

function weakerOf(current GrowthReading, ratio GrowthRatio) returns GrowthReading
	match current 'c'
		noBaseline then return GrowthReading.measured(ratio)
		measured(soFar) then return GrowthReading.measured(minRatio(soFar, other: ratio))
	end 'c'
end 'weakerOf'

function minRatio(one GrowthRatio, other GrowthRatio) returns GrowthRatio
	if other < one 'smaller'
		return other
	end 'smaller'

	return one
end 'minRatio'

// A one-rung ladder. NOTHING GREW, because nothing had anything to grow from — which is a different
// claim from "the corpus folded away", and the runner does not fail the run for it either: `--rungs=1`
// is a legal thing to ask for, and its counts are as exact as any other run's.
function addNoGrowthReading(doc JsonDoc, keys StringArray, children JsonNodeIdArray)
	pushJsonBool(doc, keys: keys, children: children, key: "grew", value: false)
	pushJsonString(doc, keys: keys, children: children, key: "reason", value: "a ladder of one rung has nothing below it to have grown from — a growth reading needs {MinRungsForGrowth} rungs")
end 'addNoGrowthReading'

function addCorpusGrowth(doc JsonDoc, keys StringArray, children JsonNodeIdArray, ratio GrowthRatio)
	pushJsonNumber(doc, keys: keys, children: children, key: "minGrowthPermille", value: (ratio * PermillePerHundredth) as JsonFloat)
	pushJsonBool(doc, keys: keys, children: children, key: "grew", value: ratio >= MinCodeGrowthRatio)
end 'addCorpusGrowth'

// Which recorded run every delta above is a delta FROM. Without it the deltas are unattributed, and a
// consumer comparing two result documents could not tell they had different reference points.
//
// It carries that row's OWN minting path beside this run's, because "was this comparison legitimate" is
// a question about the pair and a consumer holding only one half of it cannot answer.
function previousNode(doc JsonDoc, trend LoggedMemory, bytes ByteDelta) returns JsonNodeId
	match trend 'm'
		absent then return noPreviousNode(doc)
		present(date, mintedAt, note, _, _) then return previousRunNode(doc, date: date, mintedAt: mintedAt, note: note, bytes: bytes)
	end 'm'
end 'previousNode'

function noPreviousNode(doc JsonDoc) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	pushJsonBool(doc, keys: keys, children: children, key: "present", value: false)
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'noPreviousNode'

function previousRunNode(doc JsonDoc, date String, mintedAt MintedAt, note String, bytes ByteDelta) returns JsonNodeId
	var keys = StringArray.create()
	var children = JsonNodeIdArray.create()
	pushJsonBool(doc, keys: keys, children: children, key: "present", value: true)
	pushJsonString(doc, keys: keys, children: children, key: "date", value: date)

	// ABSENT when the row predates the column, rather than spelled as a string a consumer might compare
	// against a real path. `bytesComparable: false` is what says so, and `bytesWithheld` says why.
	match mintedAt 'p'
		unrecorded then break 'p'
		path(text) then pushJsonString(doc, keys: keys, children: children, key: "mintedAt", value: text)
	end 'p'

	addByteComparability(doc, keys: keys, children: children, bytes: bytes)

	pushJsonString(doc, keys: keys, children: children, key: "note", value: note)
	return doc.add(JsonNode.objectNode(keys, children: children))
end 'previousRunNode'

// WHETHER THE BYTE DELTAS ABOVE EXIST, stated rather than left to be inferred from their absence. A
// consumer can infer it — no `bytesDelta` on any rung means it was refused — but an inference from an
// absence is exactly how "not measured" gets read as "zero", and the reason is not inferable at all.
function addByteComparability(doc JsonDoc, keys StringArray, children JsonNodeIdArray, bytes ByteDelta)
	match bytes 'b'
		comparable then pushJsonBool(doc, keys: keys, children: children, key: "bytesComparable", value: true)
		withheld(why) then addWithheldBytes(doc, keys: keys, children: children, why: why)
	end 'b'
end 'addByteComparability'

function addWithheldBytes(doc JsonDoc, keys StringArray, children JsonNodeIdArray, why String)
	pushJsonBool(doc, keys: keys, children: children, key: "bytesComparable", value: false)
	pushJsonString(doc, keys: keys, children: children, key: "bytesWithheld", value: why)
end 'addWithheldBytes'
