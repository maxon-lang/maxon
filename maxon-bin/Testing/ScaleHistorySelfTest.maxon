// Testing/ScaleHistorySelfTest.maxon — the gate over `ScaleHistory`'S OWN REFUSALS.
//
// A refusal nothing runs is a claim, not a door. `ScaleHistory`'s throws describe how
// `docs/optimization-log.md` can be edited into a lie: a missing marker, a deleted separator, a renamed
// column, a ragged row, three tables that no longer describe one run. Its two decisions,
// `rowComparability` and `lastRowCheck`, and the row its writer renders are proven here too. Nothing
// else in the tree reaches them.
//
// ⚠ **AN ORDINARY SPEC CASE STRUCTURALLY CANNOT PIN THESE.** A spec case compiles a Maxon program; the
// trend log is read by `scale-test`, which no spec case runs, and there is no route from a `.md` in
// `specs/` to a damaged trend log. The refusals are therefore unreachable from the suite's normal
// vocabulary however many cases are written.
//
// These refusals are `throws ScaleError`, which is catchable, so each fixture is a document handed
// to the parser in process. `tests/specHarness` spawns a process per fixture only because the spec
// harness's refusals are panics, observable solely as a process dying.
//
// What is compared is a substring of the message that names the refusal and holds no file, line or
// stack frame: an expectation carrying a whole diagnostic goes red on every edit that moves a line
// above it.
//
// ⚠ **THE FIXTURES ARE NOT `docs/optimization-log.md`, AND NOTHING HERE WRITES A FILE.** The log is the
// project's trend record; a self-test that damaged it to prove a refusal would be worse than the silence
// it replaces. Every fixture is a literal document built in this file, and every seam takes TEXT or
// values and gives back a value — the file read and the file write stay in `loadScaleTrend` and
// `recordScaleRun`, where nothing under test reaches them.
//
// ⭐ **WHY THE FIXTURES SPELL THE FORMAT OUT INSTEAD OF BUILDING IT FROM `ScaleHistory`'S CONSTANTS.** A
// fixture assembled by the same constants the parser reads cannot detect a change in those constants —
// it would follow the parser wherever it went, which is a test that agrees with the code by
// construction. Spelling the format here means a marker rename makes these documents genuinely stale,
// and THE POSITIVE CONTROL is what turns that from many confusing reds into one clear one: the VALID
// document is parsed FIRST, and its row is read back cell by cell. Until that passes, a fixture that
// "fired" proves nothing about the refusal it names, so the control panics on its own terms and says so.

// The name a fixture goes under. It reaches the reader inside `ScaleHistory`'s own messages, which name
// the document they are about — so it must be obviously NOT a path, and obviously not the trend log.
let FixtureSource = "a ScaleHistorySelfTest fixture"

// The leading cells every valid fixture row carries, and the values the fixtures put in their place.
let FixtureDate = "2026-01-01"
let FixtureMintedAt = "/fixture/maxon (corpus /fixture/.scale-tmp)"
let FixtureCorpus = "0123456789abcdef"
let FixtureTree = "fedcba9876543210"
let OtherMintedAt = "/elsewhere/maxon (corpus /elsewhere/.scale-tmp)"
let OtherDigest = "00112233aabbccdd"
let UnrecordedCell = "*(unrecorded)*"
let MalformedDigest = "0123456789ABCDEF"
let NoteFixWording = "--note=<text>"

let RenderedDate = "2026-02-02"
let RenderedNote = "a row rendered by the writer and read back by the reader"
let RenderedTree = "aabbccddeeff0011"
let RenderedAllocsRungZero = 1500
let RenderedAllocsRungOne = 19261978
let RenderedBytesRungZero = 45000
let RenderedBytesRungOne = 912345678
let RenderedCpuTicks = 700

// ⭐ **A NOTE OF THE LENGTH THE LIVE COLUMN REALLY CARRIES** (the log's run from 2,205 to 3,753
// characters), so the `change` fixture exercises the TRUNCATION path rather than the whole-value one.
// The failure this file exists over was a long note differing in its LAST sentence, where the first
// eighty characters of the two are identical — a fixture with a short note would prove the field is
// named and never prove the reader can SEE the difference.
let FixtureNote = "BATCH9 fixture - a note of the length this column really carries, so that the excerpt rule is exercised by the fixture rather than merely written down. The live log's notes run from 2,205 to 3,753 characters and differ, when they differ, in their last sentence."

// What the hand-editor appended in the reproduction. It is BOTH the damage the
// `change` fixture applies and the text its message must show, which is the whole point: a message that
// named the field and then showed eighty characters the two rows agree on would have reproduced the
// original defect one layer down.
let HandEditedTail = "(hand-edited tail)"

let AllocationsCounts = "1,000 | 2,000"
let BytesCounts = "30,000 | 60,000"
let CpuCounts = "500 | 900"

// What a hand-edit leaves in a rung cell, and the column it is written into. The INDEX is spelled here
// rather than taken from `ScaleHistory.LeadingColumns` for this file's stated reason: a fixture built out
// of the reader's own constants follows the reader wherever it goes. `rung 0` is the first column after
// the leading ones in `ValidHeaderRow`, which is the document above, not a computation.
let NonNumericCount = "oops"
let FirstRungColumnIndex = 5

// How wide the fixture ladder is. Read back out of the parsed row by the positive control, and the width
// a `--note` has to match.
let FixtureRungCount = 2 as RungCount

// A ladder width the fixture document does NOT have, for the refusal that exists to stop a row of the
// wrong width being appended.
let WrongLadderRungCount = 3

// The document's own markers and headings, SPELLED OUT — see this file's header for why they are not
// read off `ScaleHistory`'s constants, and what catches them when they drift.
let AllocationsMarkerLine = "<!-- scale-history:allocations -->"
let BytesMarkerLine = "<!-- scale-history:bytes -->"
let CpuMarkerLine = "<!-- scale-history:cpu -->"

let AllocationsTitle = "Allocations"
let BytesTitle = "Bytes"
let CpuTitle = "CPU"

let ValidHeaderRow = "| date | minted at | corpus | tree | change | rung 0 | rung 1 |"
let ValidSeparatorRow = "| --- | --- | --- | --- | --- | ---: | ---: |"

// What a table closes with when the fixture is "someone deleted the marker". Deliberately a comment
// rather than nothing: an EMPTY closing line would be matched by the parser's own line scan (every blank
// line trims to the empty string), so the fixture would trip a refusal about the wrong line.
let DeletedMarkerStandIn = "<!-- this table's marker, deleted by hand -->"

// Called once, by the spec suite's parent process: this is a property of the tree rather than of
// any one test, so there is no test to fail. It names every fixture whose refusal did not fire,
// because one edit routinely breaks several.
function requireScaleHistoryRefusalsFire()
	let trend = validFixtureTrend()
	let fixtures = scaleHistoryFixtures(trend)

	// The fixture set is literal in this file, so it cannot go empty by accident the way a listed
	// directory can — but a gate that could report "all clear" over nothing at all is the silence this
	// file removes, and the guard costs one comparison.
	if fixtures.isEmpty() 'noFixtures'
		panic("ScaleHistorySelfTest: not one trend-log refusal was proven to fire — `scaleHistoryFixtures` returned nothing. A refusal nothing runs is a claim, not a door.")
	end 'noFixtures'

	let broken = StringArray.create(0)

	for fixture in fixtures 'eachFixture'
		match fixture.outcome 'outcome'
			accepted(what) then broken.push("'{fixture.what}' was ACCEPTED — {what}. The fixture is a deliberately damaged document, so either that refusal was removed, or this fixture no longer trips it.")
			refused(message) then recordWrongRefusal(broken, fixture: fixture, message: message)
		end 'outcome'
	end 'eachFixture'

	let decisions = comparabilityFixtures()

	for decision in decisions 'eachDecision'
		match decision.outcome 'outcome'
			unparsed(message) then broken.push("'{decision.what}' was never decided: its document was REFUSED — {message}")
			decided(comparability) then recordWrongDecision(broken, fixture: decision, comparability: comparability)
		end 'outcome'
	end 'eachDecision'

	let rowChecks = rowCheckFixtures()

	for rowCheck in rowChecks 'eachRowCheck'
		match rowCheck.outcome 'outcome'
			unparsed(message) then broken.push("'{rowCheck.what}' was never checked: its document was REFUSED — {message}")
			checked(check) then recordWrongRowCheck(broken, fixture: rowCheck, check: check)
		end 'outcome'
	end 'eachRowCheck'

	let readBacks = readBackFixtures()

	for readBack in readBacks 'eachReadBack'
		if not readBack.faults.isEmpty() 'readBackWrong'
			broken.push("'{readBack.what}' did not read back as it was written:{indentedList(readBack.faults, indent: MissingExpectationIndent)}")
		end 'readBackWrong'
	end 'eachReadBack'

	requireEveryRowHeld(broken, headline: "ScaleHistorySelfTest: {broken.count()} of {fixtures.count() + decisions.count() + rowChecks.count() + readBacks.count()} trend-log refusals, comparability decisions, row checks and read-backs did not come out as the document written for them requires. A refusal nothing runs is a claim, not a door.", indent: BrokenFixtureIndent)
end 'requireScaleHistoryRefusalsFire'

function recordWrongRowCheck(broken StringArray, fixture RowCheckFixture, check RowCheck)
	match check 'c'
		carried(line) then recordRowCheckVerdict(broken, fixture: fixture, carried: true, said: line)
		refused(message) then recordRowCheckVerdict(broken, fixture: fixture, carried: false, said: message)
	end 'c'
end 'recordWrongRowCheck'

function recordRowCheckVerdict(broken StringArray, fixture RowCheckFixture, carried bool, said String)
	if carried != fixture.carries 'wrongVerdict'
		broken.push("'{fixture.what}' was {verdictWord(carried)} where it must be {verdictWord(fixture.carries)} — {said}")
		return
	end 'wrongVerdict'

	let missing = expectationsMissingFrom(said, expected: fixture.expected)

	if missing.isEmpty() 'everyWordSaid'
		return
	end 'everyWordSaid'

	broken.push("'{fixture.what}' was {verdictWord(carried)}, but what it said is missing:{indentedList(missing, indent: MissingExpectationIndent)}\n    and it said: {said}")
end 'recordRowCheckVerdict'

function verdictWord(carried bool) returns String
	return "PASSED" if carried else "REFUSED"
end 'verdictWord'

function recordWrongDecision(broken StringArray, fixture DecisionFixture, comparability RowComparability)
	match fixture.expected 'expected'
		comparable then recordUnexpectedWithholding(broken, fixture: fixture, comparability: comparability)
		withheld(reasons) then recordWrongWithholding(broken, fixture: fixture, reasons: reasons, comparability: comparability)
	end 'expected'
end 'recordWrongDecision'

function recordUnexpectedWithholding(broken StringArray, fixture DecisionFixture, comparability RowComparability)
	match comparability 'c'
		comparable then return
		withheld(why) then broken.push("'{fixture.what}' was WITHHELD where it is comparable — {why}")
	end 'c'
end 'recordUnexpectedWithholding'

function recordWrongWithholding(broken StringArray, fixture DecisionFixture, reasons StringArray, comparability RowComparability)
	match comparability 'c'
		comparable then broken.push("'{fixture.what}' was COMPARABLE where every delta must be withheld")
		withheld(why) then recordMissingReasons(broken, what: fixture.what, reasons: reasons, why: why)
	end 'c'
end 'recordWrongWithholding'

function recordMissingReasons(broken StringArray, what String, reasons StringArray, why String)
	let missing = expectationsMissingFrom(why, expected: reasons)

	if missing.isEmpty() 'everyReasonNamed'
		return
	end 'everyReasonNamed'

	broken.push("'{what}' was withheld, but its reason is missing:{indentedList(missing, indent: MissingExpectationIndent)}\n    and it said: {why}")
end 'recordMissingReasons'

// A refusal fired — but was it THIS one? The message must carry the refusal's own words, because a
// throw alone proves only that something went wrong: a fixture damaged in a way that trips an EARLIER
// refusal would satisfy a bare "it threw" and prove nothing about the door it names.
function recordWrongRefusal(broken StringArray, fixture TrendFixture, message String)
	let missing = expectationsMissingFrom(message, expected: fixture.expected)

	if missing.isEmpty() 'firedAsWritten'
		return
	end 'firedAsWritten'

	let absentExpectations = indentedList(missing, indent: MissingExpectationIndent)
	broken.push("'{fixture.what}' was refused, but for the WRONG REASON — its message is missing:{absentExpectations}\n    and it said: {message}")
end 'recordWrongRefusal'

function expectationsMissingFrom(message String, expected StringArray) returns StringArray
	let missing = StringArray.create(0)

	for text in expected 'eachExpectation'
		if not message.contains(text) 'absent'
			missing.push(text)
		end 'absent'
	end 'eachExpectation'

	return missing
end 'expectationsMissingFrom'

// How deep each list sits under the sentence that introduces it: one fixture per line under the panic's
// headline, one missing expectation per line under the fixture that is missing it.
let BrokenFixtureIndent = "\n  "
let MissingExpectationIndent = "\n      "

// ============================================================================================
// The fixtures
// ============================================================================================

// What one fixture is: the refusal it is about, the words its message must carry, and what the seam
// actually did when it was handed the damaged document. The outcome is computed when the list is BUILT,
// so every fixture runs even when an earlier one has already failed and the report names all of them.
type TrendFixture
	export let what as String
	export let expected as StringArray
	export let outcome as TrendRefusalOutcome

	static function create(what String, expected StringArray, outcome TrendRefusalOutcome) returns TrendFixture
		return Self{what: what, expected: expected, outcome: outcome}
	end 'create'
end 'TrendFixture'

typealias TrendFixtureArray = Array with TrendFixture

// What a seam did with a fixture. A union rather than an empty-String message, so "it refused" carries
// no vestigial text and "it accepted" can say what it produced instead — which is the sentence a reader
// of a broken gate needs first.
union TrendRefusalOutcome
	refused(message String)
	accepted(what String)
end 'TrendRefusalOutcome'

type DecisionFixture
	let what as String
	let expected as ExpectedDecision
	let outcome as DecisionOutcome

	static function create(what String, expected ExpectedDecision, outcome DecisionOutcome) returns DecisionFixture
		return Self{what: what, expected: expected, outcome: outcome}
	end 'create'
end 'DecisionFixture'

typealias DecisionFixtureArray = Array with DecisionFixture

union ExpectedDecision
	comparable
	withheld(reasons StringArray)
end 'ExpectedDecision'

union DecisionOutcome
	unparsed(message String)
	decided(comparability RowComparability)
end 'DecisionOutcome'

type RowCheckFixture
	let what as String
	let carries as bool
	let expected as StringArray
	let outcome as RowCheckOutcome

	static function create(what String, carries bool, expected StringArray, outcome RowCheckOutcome) returns RowCheckFixture
		return Self{what: what, carries: carries, expected: expected, outcome: outcome}
	end 'create'
end 'RowCheckFixture'

typealias RowCheckFixtureArray = Array with RowCheckFixture

union RowCheckOutcome
	unparsed(message String)
	checked(check RowCheck)
end 'RowCheckOutcome'

type ReadBackFixture
	let what as String
	let faults as StringArray

	static function create(what String, faults StringArray) returns ReadBackFixture
		return Self{what: what, faults: faults}
	end 'create'
end 'ReadBackFixture'

typealias ReadBackFixtureArray = Array with ReadBackFixture

type ExpectedRow
	let date as String
	let provenance as RowProvenance
	let note as String
	let allocs as AllocCountArray
	let bytes as ByteCountArray

	static function create(date String, provenance RowProvenance, note String, allocs AllocCountArray, bytes ByteCountArray) returns ExpectedRow
		return Self{date: date, provenance: provenance, note: note, allocs: allocs, bytes: bytes}
	end 'create'
end 'ExpectedRow'

// EVERY refusal in `ScaleHistory` that a caller can reach, one fixture each, each differing from the
// VALID document by exactly one damaged cell, row, separator or marker.
//
// NOT COVERED, and each for a reason that is a fact about the refusal rather than a gap here:
//   - `loadScaleTrend`'s missing-file and unparseable-path throws, and `recordScaleRun`'s read and write
//     failures. All four are IO, reachable only by removing or locking the real log.
function scaleHistoryFixtures(trend LoggedMemory) returns TrendFixtureArray
	let fixtures = TrendFixtureArray.create(0)

	// ---- readTable: the document's shape -------------------------------------------------------
	fixtures.push(TrendFixture.create("the DELETED TABLE MARKER", expected: expecting("is missing the table marker"), outcome: parseOutcome(fixtureDocument(validAllocationsTable(), bytes: validBytesTable(), cpu: tableBlock(CpuTitle, lines: validTableLines(CpuCounts), marker: DeletedMarkerStandIn)))))

	fixtures.push(TrendFixture.create("the DELETED SEPARATOR, leaving a table of one line", expected: expecting("has no header row and separator"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: "{ValidHeaderRow}\n", marker: BytesMarkerLine)))))

	fixtures.push(TrendFixture.create("the RENAMED COLUMN", expected: expecting("is headed 'notes'"), outcome: parseOutcome(documentWithBytesHeader("| date | minted at | corpus | tree | notes | rung 0 | rung 1 |"))))

	fixtures.push(TrendFixture.create("the RENAMED `corpus` COLUMN", expected: expecting("column 2 of the table above `{BytesMarkerLine}` in {FixtureSource} is headed 'ladder'"), outcome: parseOutcome(documentWithBytesHeader("| date | minted at | ladder | tree | change | rung 0 | rung 1 |"))))

	fixtures.push(TrendFixture.create("the RENAMED `tree` COLUMN", expected: expecting("column 3 of the table above `{BytesMarkerLine}` in {FixtureSource} is headed 'commit'"), outcome: parseOutcome(documentWithBytesHeader("| date | minted at | corpus | commit | change | rung 0 | rung 1 |"))))

	fixtures.push(TrendFixture.create("the MISSING `corpus` COLUMN", expected: expecting("column 2 of the table above `{BytesMarkerLine}` in {FixtureSource} is headed 'tree'"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines("| date | minted at | tree | change | rung 0 | rung 1 |", separator: "| --- | --- | --- | --- | ---: | ---: |", rows: "| {FixtureDate} | {FixtureMintedAt} | {FixtureTree} | {FixtureNote} | {BytesCounts} |\n"), marker: BytesMarkerLine)))))

	fixtures.push(TrendFixture.create("the MISSING `tree` COLUMN", expected: expecting("column 3 of the table above `{BytesMarkerLine}` in {FixtureSource} is headed 'change'"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines("| date | minted at | corpus | change | rung 0 | rung 1 |", separator: "| --- | --- | --- | --- | ---: | ---: |", rows: "| {FixtureDate} | {FixtureMintedAt} | {FixtureCorpus} | {FixtureNote} | {BytesCounts} |\n"), marker: BytesMarkerLine)))))

	// `cellAt`, reached through `assertHeading`: a table narrower than the leading columns has no cell to
	// read the last heading out of, which is the one route to that throw from a whole document.
	fixtures.push(TrendFixture.create("the TABLE WITH THE `change` COLUMN DROPPED ENTIRELY", expected: expecting("cell(s); column 4 was expected"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines("| date | minted at | corpus | tree |", separator: "| --- | --- | --- | --- |", rows: "| {FixtureDate} | {FixtureMintedAt} | {FixtureCorpus} | {FixtureTree} |\n"), marker: BytesMarkerLine)))))

	fixtures.push(TrendFixture.create("the SEPARATOR OF THE WRONG WIDTH", expected: expecting("the separator under the header of the table above"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines(ValidHeaderRow, separator: "| --- | --- | --- | --- | --- | ---: |", rows: validRowLine(BytesCounts)), marker: BytesMarkerLine)))))

	fixtures.push(TrendFixture.create("the SECOND LINE THAT IS NOT A SEPARATOR", expected: expecting("is not a `| --- | ---: |` separator"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines(ValidHeaderRow, separator: "| --- | --- | --- | --- | --- | ---: | n/a |", rows: validRowLine(BytesCounts)), marker: BytesMarkerLine)))))

	fixtures.push(TrendFixture.create("the RAGGED LAST ROW", expected: expecting("the table is ragged"), outcome: parseOutcome(documentWithBytesRow("| {FixtureDate} | {FixtureMintedAt} | {FixtureCorpus} | {FixtureTree} | {FixtureNote} | 30,000 |\n"))))

	fixtures.push(TrendFixture.create("the TABLE WITH NO DATA ROWS beside two that have one", expected: expecting("has rows but the table above"), outcome: parseOutcome(documentWithBytesTable(emptyTable(BytesTitle, marker: BytesMarkerLine)))))

	// ---- assertSameRun: every leading cell, SEPARATELY -------------------------------------------
	fixtures.push(TrendFixture.create("the `date` CELL that no longer matches", expected: expecting("`date` differs"), outcome: parseOutcome(documentWithBytesRow(rowLine("2026-01-02", mintedAt: FixtureMintedAt, corpus: FixtureCorpus, tree: FixtureTree, note: FixtureNote, counts: BytesCounts)))))

	fixtures.push(TrendFixture.create("the `minted at` CELL that no longer matches", expected: expecting("`minted at` differs"), outcome: parseOutcome(documentWithBytesRow(rowLine(FixtureDate, mintedAt: OtherMintedAt, corpus: FixtureCorpus, tree: FixtureTree, note: FixtureNote, counts: BytesCounts)))))

	fixtures.push(TrendFixture.create("the `corpus` CELL that no longer matches", expected: expecting("`corpus` differs"), outcome: parseOutcome(documentWithBytesRow(rowLine(FixtureDate, mintedAt: FixtureMintedAt, corpus: OtherDigest, tree: FixtureTree, note: FixtureNote, counts: BytesCounts)))))

	fixtures.push(TrendFixture.create("the `tree` CELL that no longer matches", expected: expecting("`tree` differs"), outcome: parseOutcome(documentWithBytesRow(rowLine(FixtureDate, mintedAt: FixtureMintedAt, corpus: FixtureCorpus, tree: OtherDigest, note: FixtureNote, counts: BytesCounts)))))

	// ⭐ THE ROW THIS RUNG WAS OPENED BY. Two expectations, and the second is the one that matters: the
	// message must not merely NAME the note, it must show the text that moved — which for a long note
	// differing in its last sentence means the excerpt has to reach the end.
	let noteExpectations = expecting("`change` differs")
	noteExpectations.push(HandEditedTail)
	fixtures.push(TrendFixture.create("the `change` CELL that no longer matches — a long note, edited at its END", expected: noteExpectations, outcome: parseOutcome(documentWithBytesRow(rowLine(FixtureDate, mintedAt: FixtureMintedAt, corpus: FixtureCorpus, tree: FixtureTree, note: "{FixtureNote} {HandEditedTail}", counts: BytesCounts)))))

	// ---- the row itself -------------------------------------------------------------------------
	fixtures.push(TrendFixture.create("the TABLE MEASURING A DIFFERENT LADDER", expected: expecting("rung(s) — they measure one ladder"), outcome: parseOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines("| date | minted at | corpus | tree | change | rung 0 | rung 1 | rung 2 |", separator: "| --- | --- | --- | --- | --- | ---: | ---: | ---: |", rows: rowLine(FixtureDate, mintedAt: FixtureMintedAt, corpus: FixtureCorpus, tree: FixtureTree, note: FixtureNote, counts: "30,000 | 60,000 | 120,000")), marker: BytesMarkerLine)))))

	// ⭐ THE RUNG CELL THAT IS NOT A NUMBER. Damaged in the BYTES row rather than the allocations one
	// because `memoryRowFrom` parses the allocations columns FIRST — so this is the document that gets
	// past every earlier door and is stopped by the one being named. Two expectations: the refusal's own
	// words, and the COLUMN, which is the half that turns "a cell" into a cell a reader can go and find.
	let badCountExpectations = expecting("is not a count")
	badCountExpectations.push("column {FirstRungColumnIndex} of a row in {FixtureSource}")
	fixtures.push(TrendFixture.create("the RUNG CELL THAT IS NOT A NUMBER", expected: badCountExpectations, outcome: parseOutcome(documentWithBytesRow(rowLine(FixtureDate, mintedAt: FixtureMintedAt, corpus: FixtureCorpus, tree: FixtureTree, note: FixtureNote, counts: "{NonNumericCount} | 60,000")))))

	// The empty cell goes into ALL THREE rows, so the row reaches `recordedCellFrom` rather than being
	// stopped one refusal earlier by `assertSameRun`.
	fixtures.push(TrendFixture.create("the EMPTIED `minted at` CELL", expected: expecting("has an EMPTY `minted at` cell"), outcome: parseOutcome(documentWithLeadingCells("", corpus: FixtureCorpus, tree: FixtureTree))))

	fixtures.push(TrendFixture.create("the EMPTIED `corpus` CELL", expected: expecting("has an EMPTY `corpus` cell"), outcome: parseOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: "", tree: FixtureTree))))

	fixtures.push(TrendFixture.create("the EMPTIED `tree` CELL", expected: expecting("has an EMPTY `tree` cell"), outcome: parseOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: FixtureCorpus, tree: ""))))

	fixtures.push(TrendFixture.create("the `corpus` CELL THAT IS NOT A DIGEST", expected: expecting("has the `corpus` cell '{MalformedDigest}', which is neither"), outcome: parseOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: MalformedDigest, tree: FixtureTree))))

	fixtures.push(TrendFixture.create("the `tree` CELL THAT IS NOT A DIGEST", expected: expecting("has the `tree` cell '{MalformedDigest}', which is neither"), outcome: parseOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: FixtureCorpus, tree: MalformedDigest))))

	// ---- assertCellSafe, through the door that screens a --note ---------------------------------
	fixtures.push(TrendFixture.create("the --note carrying a `|`", expected: expecting("may not contain `|` or a newline"), outcome: recordableOutcome(trend, note: "a note with a | in it", rungs: FixtureRungCount)))

	fixtures.push(TrendFixture.create("the --note carrying a NEWLINE", expected: expecting("may not contain `|` or a newline"), outcome: recordableOutcome(trend, note: "a note with a\nnewline in it", rungs: FixtureRungCount)))

	fixtures.push(TrendFixture.create("the --note carrying a FORGED TABLE MARKER", expected: expecting("a forged marker would decide where the NEXT row landed"), outcome: recordableOutcome(trend, note: "a note carrying {AllocationsMarkerLine} inside it", rungs: FixtureRungCount)))

	fixtures.push(TrendFixture.create("the RUN THAT CLIMBED A DIFFERENT LADDER than the log records", expected: expecting("would make the tables RAGGED"), outcome: recordableOutcome(trend, note: "a perfectly ordinary note", rungs: WrongLadderRungCount)))

	fixtures.push(TrendFixture.create("the row whose `corpus` cell is NOT A DIGEST", expected: expecting("this run's `corpus` cell '{MalformedDigest}' is not"), outcome: writableRowOutcome(RowProvenance.create(FixtureMintedAt, corpus: MalformedDigest, tree: FixtureTree))))

	fixtures.push(TrendFixture.create("the row whose `tree` cell is NOT A DIGEST", expected: expecting("this run's `tree` cell '{MalformedDigest}' is not"), outcome: writableRowOutcome(RowProvenance.create(FixtureMintedAt, corpus: FixtureCorpus, tree: MalformedDigest))))

	fixtures.push(TrendFixture.create("the row whose `tree` cell is UNRECORDED", expected: expecting("this run's `tree` cell '{UnrecordedCell}' is not"), outcome: writableRowOutcome(RowProvenance.create(FixtureMintedAt, corpus: FixtureCorpus, tree: UnrecordedCell))))

	// ---- insertRowBefore: the write's own anchor -------------------------------------------------
	fixtures.push(TrendFixture.create("the MARKER APPEARING TWICE", expected: expecting("must appear exactly once"), outcome: insertOutcome("{validDocument()}\n{BytesMarkerLine}\n")))

	fixtures.push(TrendFixture.create("the MARKER APPEARING NOWHERE at write time", expected: expecting("must appear exactly once"), outcome: insertOutcome(documentWithBytesTable(tableBlock(BytesTitle, lines: validTableLines(BytesCounts), marker: DeletedMarkerStandIn)))))

	// ---- LoggedMemory ----------------------------------------------------------------------------
	fixtures.push(TrendFixture.create("the LADDER WIDTH ASKED OF A LOG WITH NO ROWS", expected: expecting("the log has no rows, so it pins no ladder length"), outcome: loggedRungCountOutcome(LoggedMemory.absent)))

	return fixtures
end 'scaleHistoryFixtures'

function comparabilityFixtures() returns DecisionFixtureArray
	let fixtures = DecisionFixtureArray.create(0)

	fixtures.push(DecisionFixture.create("the row whose corpus is UNRECORDED, minted at this run's place", expected: ExpectedDecision.withheld(expecting("before rows recorded the corpus")), outcome: decisionOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: UnrecordedCell, tree: FixtureTree), mintedAt: FixtureMintedAt, corpus: FixtureCorpus)))

	fixtures.push(DecisionFixture.create("the row of ANOTHER CORPUS, minted at this run's place", expected: ExpectedDecision.withheld(expecting("the corpus changed")), outcome: decisionOutcome(validDocument(), mintedAt: FixtureMintedAt, corpus: OtherDigest)))

	fixtures.push(DecisionFixture.create("the row of this run's corpus MINTED ELSEWHERE", expected: ExpectedDecision.withheld(expecting("minted elsewhere")), outcome: decisionOutcome(validDocument(), mintedAt: OtherMintedAt, corpus: FixtureCorpus)))

	let bothExpectations = expecting("the corpus changed")
	bothExpectations.push("minted elsewhere")
	fixtures.push(DecisionFixture.create("the row of ANOTHER CORPUS MINTED ELSEWHERE, which names both", expected: ExpectedDecision.withheld(bothExpectations), outcome: decisionOutcome(validDocument(), mintedAt: OtherMintedAt, corpus: OtherDigest)))

	fixtures.push(DecisionFixture.create("the row of this run's corpus and place", expected: ExpectedDecision.comparable, outcome: decisionOutcome(validDocument(), mintedAt: FixtureMintedAt, corpus: FixtureCorpus)))

	fixtures.push(DecisionFixture.create("the row of this run's corpus and place whose tree is UNRECORDED", expected: ExpectedDecision.comparable, outcome: decisionOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: FixtureCorpus, tree: UnrecordedCell), mintedAt: FixtureMintedAt, corpus: FixtureCorpus)))

	fixtures.push(DecisionFixture.create("the row of this run's corpus and place whose tree is ANOTHER TREE", expected: ExpectedDecision.comparable, outcome: decisionOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: FixtureCorpus, tree: OtherDigest), mintedAt: FixtureMintedAt, corpus: FixtureCorpus)))

	return fixtures
end 'comparabilityFixtures'

function rowCheckFixtures() returns RowCheckFixtureArray
	let fixtures = RowCheckFixtureArray.create(0)

	let carriedExpectations = expecting(FixtureDate)
	carriedExpectations.push(FixtureNote)
	carriedExpectations.push(FixtureTree)
	fixtures.push(RowCheckFixture.create("the last row carrying THIS TREE'S digest", carries: true, expected: carriedExpectations, outcome: rowCheckOutcome(validDocument(), treeDigest: FixtureTree)))

	let unrecordedExpectations = expecting("`tree` cell {UnrecordedCell}")
	unrecordedExpectations.push(OtherDigest)
	unrecordedExpectations.push(NoteFixWording)
	fixtures.push(RowCheckFixture.create("the last row whose tree is UNRECORDED", carries: false, expected: unrecordedExpectations, outcome: rowCheckOutcome(documentWithLeadingCells(FixtureMintedAt, corpus: FixtureCorpus, tree: UnrecordedCell), treeDigest: OtherDigest)))

	let anotherTreeExpectations = expecting(FixtureTree)
	anotherTreeExpectations.push(OtherDigest)
	anotherTreeExpectations.push("measured on another tree")
	anotherTreeExpectations.push(NoteFixWording)
	fixtures.push(RowCheckFixture.create("the last row recording ANOTHER TREE, which shows both digests", carries: false, expected: anotherTreeExpectations, outcome: rowCheckOutcome(validDocument(), treeDigest: OtherDigest)))

	let noRowExpectations = expecting("has no rows")
	noRowExpectations.push(NoteFixWording)
	fixtures.push(RowCheckFixture.create("the log with NO ROWS", carries: false, expected: noRowExpectations, outcome: rowCheckOutcome(fixtureDocument(emptyTable(AllocationsTitle, marker: AllocationsMarkerLine), bytes: emptyTable(BytesTitle, marker: BytesMarkerLine), cpu: emptyTable(CpuTitle, marker: CpuMarkerLine)), treeDigest: FixtureTree)))

	return fixtures
end 'rowCheckFixtures'

function readBackFixtures() returns ReadBackFixtureArray
	let fixtures = ReadBackFixtureArray.create(0)

	fixtures.push(ReadBackFixture.create("a row of each measure rendered by `renderMemoryRow` and inserted by `insertRowBefore`", faults: renderedRowFaults()))

	return fixtures
end 'readBackFixtures'

// One expectation. The `change` fixture needs two, and pushes its second onto what this returns.
function expecting(text String) returns StringArray
	let expected = StringArray.create(0)
	expected.push(text)
	return expected
end 'expecting'

// ============================================================================================
// The seams, and what they did
// ============================================================================================

function parseOutcome(text String) returns TrendRefusalOutcome
	let parsed = try parseScaleTrend(text, source: FixtureSource) otherwise (error) 'refused'
		return TrendRefusalOutcome.refused(scaleErrorText(error))
	end 'refused'

	return TrendRefusalOutcome.accepted("it parsed as {trendShape(parsed)}")
end 'parseOutcome'

// What a document parsed AS, for the report a broken gate prints. The rung count is the half that says
// whether the reader took the columns it was meant to.
function trendShape(parsed LoggedMemory) returns String
	return match parsed 'm'
		absent gives "a log with no rows at all"
		present(date, _, _, _, _, allocs, _) gives "the {date} row over {allocs.count()} rung(s)"
	end 'm'
end 'trendShape'

function decisionOutcome(text String, mintedAt String, corpus String) returns DecisionOutcome
	let parsed = try parseScaleTrend(text, source: FixtureSource) otherwise (error) 'refused'
		return DecisionOutcome.unparsed(scaleErrorText(error))
	end 'refused'

	return DecisionOutcome.decided(rowComparability(parsed, mintedAt: mintedAt, corpus: corpus))
end 'decisionOutcome'

function recordableOutcome(trend LoggedMemory, note String, rungs RungCount) returns TrendRefusalOutcome
	try assertRecordable(trend, note: note, mintedAt: FixtureMintedAt, rungs: rungs) otherwise (error) 'refused'
		return TrendRefusalOutcome.refused(scaleErrorText(error))
	end 'refused'

	return TrendRefusalOutcome.accepted("the note was accepted for recording")
end 'recordableOutcome'

function writableRowOutcome(provenance RowProvenance) returns TrendRefusalOutcome
	try assertRowCells(FixtureNote, provenance: provenance) otherwise (error) 'refused'
		return TrendRefusalOutcome.refused(scaleErrorText(error))
	end 'refused'

	return TrendRefusalOutcome.accepted("the row's cells were accepted for writing")
end 'writableRowOutcome'

function rowCheckOutcome(text String, treeDigest String) returns RowCheckOutcome
	let parsed = try parseScaleTrend(text, source: FixtureSource) otherwise (error) 'refused'
		return RowCheckOutcome.unparsed(scaleErrorText(error))
	end 'refused'

	return RowCheckOutcome.checked(lastRowCheck(parsed, treeDigest: treeDigest, source: FixtureSource))
end 'rowCheckOutcome'

function renderedRowFaults() returns StringArray
	let results = RungResultArray.create(0)
	results.push(renderedRung(0, allocs: RenderedAllocsRungZero, bytes: RenderedBytesRungZero))
	results.push(renderedRung(1, allocs: RenderedAllocsRungOne, bytes: RenderedBytesRungOne))

	let provenance = RowProvenance.create(OtherMintedAt, corpus: OtherDigest, tree: RenderedTree)
	var document = validDocument()
	document = insertRenderedRow(document, marker: AllocationsMarkerLine, results: results, provenance: provenance, measure: ScaleMeasure.allocations)
	document = insertRenderedRow(document, marker: BytesMarkerLine, results: results, provenance: provenance, measure: ScaleMeasure.bytes)
	document = insertRenderedRow(document, marker: CpuMarkerLine, results: results, provenance: provenance, measure: ScaleMeasure.cpuTicks)

	let parsed = try parseScaleTrend(document, source: FixtureSource) otherwise (error) 'refused'
		return expecting("the document was REFUSED — {scaleErrorText(error)}")
	end 'refused'

	let allocs = AllocCountArray.create(0)
	let bytes = ByteCountArray.create(0)

	for result in results 'eachRung'
		allocs.push(result.total.allocs)
		bytes.push(result.total.bytes)
	end 'eachRung'

	return rowReadBackFaults(parsed, expected: ExpectedRow.create(RenderedDate, provenance: provenance, note: RenderedNote, allocs: allocs, bytes: bytes))
end 'renderedRowFaults'

function renderedRung(rung RungIndex, allocs AllocCount, bytes HeapByteCount) returns RungResult
	let total = PhaseMetric.create(allocs, frees: allocs, bytes: bytes, cpuTicks: RenderedCpuTicks)
	return RungResult.create(rung, sourceBytes: 0, codeBytes: 0, total: total, phases: PhaseMetricArray.create(0), regAlloc: PhaseMetricArray.create(0), lint: PhaseMetricArray.create(0))
end 'renderedRung'

function insertRenderedRow(text String, marker String, results RungResultArray, provenance RowProvenance, measure ScaleMeasure) returns String
	let row = renderMemoryRow(results, note: RenderedNote, provenance: provenance, date: RenderedDate, measure: measure)
	return try insertRowBefore(text, marker: marker, row: row, source: FixtureSource) otherwise panic("ScaleHistorySelfTest: the VALID fixture document carries `{marker}` once, and a rendered row could not be inserted above it")
end 'insertRenderedRow'

function insertOutcome(text String) returns TrendRefusalOutcome
	let updated = try insertRowBefore(text, marker: BytesMarkerLine, row: validRowLine(BytesCounts), source: FixtureSource) otherwise (error) 'refused'
		return TrendRefusalOutcome.refused(scaleErrorText(error))
	end 'refused'

	return TrendRefusalOutcome.accepted("the row was inserted, giving a {updated.count()}-character document")
end 'insertOutcome'

function loggedRungCountOutcome(trend LoggedMemory) returns TrendRefusalOutcome
	let rungs = try trend.loggedRungCount() otherwise (error) 'refused'
		return TrendRefusalOutcome.refused(scaleErrorText(error))
	end 'refused'

	return TrendRefusalOutcome.accepted("it answered {rungs} rung(s)")
end 'loggedRungCountOutcome'

// ============================================================================================
// THE POSITIVE CONTROL — and the trend the `--note` fixtures are asked against
// ============================================================================================

// The VALID fixture document, parsed and read back cell by cell and count by count.
//
// ⭐ It runs BEFORE any fixture, and it panics rather than joining the report, because every fixture is
// this document with ONE thing damaged: if the undamaged one does not parse, a fixture that "fired"
// fired for a reason nobody has established and the whole gate is measuring the fixtures rather than the
// refusals. This is also what makes spelling the format out in this file safe — a marker or heading
// rename lands here, once, saying exactly that, instead of as a crowd of fixtures failing for reasons
// that look like missing refusals.
//
// READ BACK CELL BY CELL AND COUNT BY COUNT, not merely "it parsed": the parser takes the leading cells
// BY INDEX, so a document read one column out of true would still parse, and would still hand back a
// row — with a provenance cell where the note belongs. That is the failure `assertLeadingHeadings`
// exists to stop, and asking the round trip is how this file proves the stop works rather than
// assuming it.
function validFixtureTrend() returns LoggedMemory
	let parsed = try parseScaleTrend(validDocument(), source: FixtureSource) otherwise (error) 'refused'
		panic("ScaleHistorySelfTest: the VALID fixture document was REFUSED — '{scaleErrorText(error)}'. Every fixture in this file is that document with one cell damaged, so until it parses, a fixture that fired proves nothing about the refusal it names. The trend log's format has moved and these fixtures have not.")
	end 'refused'

	let faults = rowReadBackFaults(parsed, expected: validRow())

	if not faults.isEmpty() 'misread'
		panic("ScaleHistorySelfTest: the VALID fixture document did not read back as it is written:{indentedList(faults, indent: BrokenFixtureIndent)}\nEvery fixture in this file is that document with one cell damaged, so until it reads back, a fixture that fired proves nothing about the refusal it names.")
	end 'misread'

	return parsed
end 'validFixtureTrend'

function validRow() returns ExpectedRow
	return ExpectedRow.create(FixtureDate, provenance: RowProvenance.create(FixtureMintedAt, corpus: FixtureCorpus, tree: FixtureTree), note: FixtureNote, allocs: AllocCountArray from [1000, 2000], bytes: ByteCountArray from [30000, 60000])
end 'validRow'

function rowReadBackFaults(parsed LoggedMemory, expected ExpectedRow) returns StringArray
	let faults = StringArray.create(0)

	match parsed 'row'
		absent then faults.push("it parsed but yielded NO ROW, though each of its tables has a data row immediately above its marker")
		present(date, mintedAt, corpus, tree, note, allocs, bytes) then recordRowFaults(faults, date: date, mintedAt: mintedAt, corpus: corpus, tree: tree, note: note, allocs: allocs, bytes: bytes, expected: expected)
	end 'row'

	return faults
end 'rowReadBackFaults'

function recordRowFaults(faults StringArray, date String, mintedAt RecordedCell, corpus RecordedCell, tree RecordedCell, note String, allocs AllocCountArray, bytes ByteCountArray, expected ExpectedRow)
	recordCellFault(faults, heading: "date", read: date, expected: expected.date)
	recordCellFault(faults, heading: "minted at", read: cellReadBack(mintedAt), expected: expected.provenance.mintedAt)
	recordCellFault(faults, heading: "corpus", read: cellReadBack(corpus), expected: expected.provenance.corpus)
	recordCellFault(faults, heading: "tree", read: cellReadBack(tree), expected: expected.provenance.tree)
	recordCellFault(faults, heading: "change", read: note, expected: expected.note)

	if not allocs.equals(expected.allocs) 'wrongAllocations'
		faults.push("its allocation counts read back over {allocs.count()} rung(s) and differ from the {expected.allocs.count()} it carries. The rung columns are whatever follows the leading ones, so a miscounted leading column shows up as a ladder of the wrong width.")
	end 'wrongAllocations'

	if not bytes.equals(expected.bytes) 'wrongBytes'
		faults.push("its byte counts read back over {bytes.count()} rung(s) and differ from the {expected.bytes.count()} it carries. The rung columns are whatever follows the leading ones, so a miscounted leading column shows up as a ladder of the wrong width.")
	end 'wrongBytes'
end 'recordRowFaults'

function recordCellFault(faults StringArray, heading String, read String, expected String)
	if read == expected 'readAsWritten'
		return
	end 'readAsWritten'

	faults.push("its `{heading}` cell read back as '{read}' and it carries '{expected}'. The row is read by COLUMN INDEX, so a document being read one column out of true still parses — this is where that shows.")
end 'recordCellFault'

function cellReadBack(cell RecordedCell) returns String
	return match cell 'r'
		unrecorded gives UnrecordedCell
		recorded(text) gives text
	end 'r'
end 'cellReadBack'

// ============================================================================================
// Building a document
// ============================================================================================

// The whole document: three tables, with prose around and between them. The prose is not decoration —
// the parser finds a table by walking UP from its marker over contiguous `|` lines, so what stops that
// walk is a line that does not begin with a pipe, and a fixture with the tables jammed together would
// be one long table as far as the reader is concerned.
function fixtureDocument(allocations String, bytes String, cpu String) returns String
	return "# a scale-history fixture\n\nprose the reader must walk past.\n\n{allocations}\nprose between two tables.\n\n{bytes}\nmore prose between two tables.\n\n{cpu}\nprose after the last table.\n"
end 'fixtureDocument'

function validDocument() returns String
	return fixtureDocument(validAllocationsTable(), bytes: validBytesTable(), cpu: validCpuTable())
end 'validDocument'

// The document with only the BYTES table replaced. Every fixture that damages a table damages this one,
// so the other two are always the valid ones and any refusal is attributable to the one perturbation.
function documentWithBytesTable(bytes String) returns String
	return fixtureDocument(validAllocationsTable(), bytes: bytes, cpu: validCpuTable())
end 'documentWithBytesTable'

function documentWithBytesRow(row String) returns String
	return documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines(ValidHeaderRow, separator: ValidSeparatorRow, rows: row), marker: BytesMarkerLine))
end 'documentWithBytesRow'

function documentWithBytesHeader(header String) returns String
	return documentWithBytesTable(tableBlock(BytesTitle, lines: tableLines(header, separator: ValidSeparatorRow, rows: validRowLine(BytesCounts)), marker: BytesMarkerLine))
end 'documentWithBytesHeader'

// The document with these provenance cells in ALL THREE rows — the three tables still agree, which is
// what carries the row past `assertSameRun` and down to the cell's own check.
function documentWithLeadingCells(mintedAt String, corpus String, tree String) returns String
	return fixtureDocument(leadingCellsTable(AllocationsTitle, marker: AllocationsMarkerLine, mintedAt: mintedAt, corpus: corpus, tree: tree, counts: AllocationsCounts), bytes: leadingCellsTable(BytesTitle, marker: BytesMarkerLine, mintedAt: mintedAt, corpus: corpus, tree: tree, counts: BytesCounts), cpu: leadingCellsTable(CpuTitle, marker: CpuMarkerLine, mintedAt: mintedAt, corpus: corpus, tree: tree, counts: CpuCounts))
end 'documentWithLeadingCells'

function leadingCellsTable(title String, marker String, mintedAt String, corpus String, tree String, counts String) returns String
	return tableBlock(title, lines: tableLines(ValidHeaderRow, separator: ValidSeparatorRow, rows: rowLine(FixtureDate, mintedAt: mintedAt, corpus: corpus, tree: tree, note: FixtureNote, counts: counts)), marker: marker)
end 'leadingCellsTable'

function validAllocationsTable() returns String
	return tableBlock(AllocationsTitle, lines: validTableLines(AllocationsCounts), marker: AllocationsMarkerLine)
end 'validAllocationsTable'

function validBytesTable() returns String
	return tableBlock(BytesTitle, lines: validTableLines(BytesCounts), marker: BytesMarkerLine)
end 'validBytesTable'

function validCpuTable() returns String
	return tableBlock(CpuTitle, lines: validTableLines(CpuCounts), marker: CpuMarkerLine)
end 'validCpuTable'

// A markdown section closed by a marker. `lines` is the table verbatim, INCLUDING its trailing newline,
// because a fixture that damages the header, the separator or the row set has to be able to say that
// one of them is not there at all.
function tableBlock(title String, lines String, marker String) returns String
	return "## {title}\n\n{lines}{marker}\n"
end 'tableBlock'

function emptyTable(title String, marker String) returns String
	return tableBlock(title, lines: tableLines(ValidHeaderRow, separator: ValidSeparatorRow, rows: ""), marker: marker)
end 'emptyTable'

function tableLines(header String, separator String, rows String) returns String
	return "{header}\n{separator}\n{rows}"
end 'tableLines'

function validTableLines(counts String) returns String
	return tableLines(ValidHeaderRow, separator: ValidSeparatorRow, rows: validRowLine(counts))
end 'validTableLines'

function validRowLine(counts String) returns String
	return rowLine(FixtureDate, mintedAt: FixtureMintedAt, corpus: FixtureCorpus, tree: FixtureTree, note: FixtureNote, counts: counts)
end 'validRowLine'

function rowLine(date String, mintedAt String, corpus String, tree String, note String, counts String) returns String
	return "| {date} | {mintedAt} | {corpus} | {tree} | {note} | {counts} |\n"
end 'rowLine'
