// TestDispatcher — the Maxon source that RUNS a project's tests: one dispatcher per test file, plus the
// entry point that calls them, plus the staged tree the whole thing is compiled from.
//
// ⭐⭐ **THE PER-FILE DISPATCHER IS APPENDED TO ITS FILE'S OWN CONTENT, AND THAT IS NOT A CONVENIENCE — IT
// IS THE ONLY THING THAT COMPILES.** A `test` declaration is not exported: it takes the file tier unless
// the source wrote `export`, so `__test_<sanitized>` is reachable only from its own file and source
// anywhere else cannot call it. The same property is what lets a test use its file's PRIVATE helpers and
// fixtures without anything being `export`ed to accommodate the harness. Only the ROOT entry — which must
// reach across files, and so calls the exported per-file runners rather than the tests themselves — is a
// file of its own.
//
// ⛔ **THE APPEND HAPPENS IN A STAGED COPY OUTSIDE THE PROJECT, AND IS FORCED.** There is no
// in-memory source registration — `Compiler.compileToProduct` takes PATHS — so the generated text
// has to reach a filesystem. It may NOT reach
// the user's own tree, and `<project>/.maxon/` is not a hiding place: `Compiler.collectMaxonSources`
// prunes on `.maxonignore` and on nothing else, so a generated `.maxon` left there would be swept into the
// user's very next ordinary build. So the whole project, or the one file run alone, is COPIED into a
// staging root, with each test file's copy carrying its dispatcher, and the compile is rooted there.
//
// ⚠ **THE COPY PRESERVES EACH FILE'S PATH RELATIVE TO THE PROJECT ROOT, AND THAT IS LOAD-BEARING TWICE
// OVER.** A file's namespace is its directory relative to the root (`Queries.moduleDirectoryForFile`), and
// `__file__` — which is what an assertion's report names a failing line by — is that same relative path
// whole. Flatten the tree and both change; preserve it and a report reads exactly as it would from the
// user's own directory.
//
// ⚠ **THE APPEND IS AN APPEND, NEVER A PREPEND, AND EVERY LINE NUMBER A RUN PRINTS DEPENDS ON IT.**
// `Expect`'s `file`/`line` default to `__file__`/`__line__`, which expand at the CALL SITE, so a single
// generated line above a test body would move every one of them.

// ⭐ **THE ENTRY POINT THE TEST BINARY IS COMPILED WITH** — named rather than `main`, which is what lets a
// project's OWN `main` stay exactly where it is: it simply stops being reachable, and dead-function
// elimination drops it (`Project.entryFunctionName`). The `__` prefix marks it compiler-owned, as
// `__TestReport` is, and it is `export`ed because the per-file runners it calls live in other files.
export let MaxonTestEntrySymbol = "__maxon_test_main"

// The generated type carrying the run's shared helpers. ONE copy, in the entry file, called from every
// test file.
let MaxonTestHelperType = "__MaxonTestRun"

// The generated index typealias. `__`-prefixed for `MaxonTestEntrySymbol`'s reason and for one more: the
// prefix is what keeps the unused-export audit off it (`UnusedExportCheck.isSynthesizedName`), and this
// alias really is unread outside the file that declares it.
let MaxonTestIndexAlias = "__MaxonTestIndex"

// Prefix of the per-file dispatcher function. The FILE's ordinal is appended, which is what makes the name
// unique by construction: a sanitized path would not be, since two files in one directory whose names
// differ only outside `[A-Za-z0-9_]` share a namespace and sanitize alike.
let MaxonTestFileRunnerPrefix = "__maxon_test_file_"

let EveryTestPassedLocal = "maxonTestEverySelectedTestPassed"

// File name given to the synthesized root-entry source. It is deliberately NOT a `.maxtest` file —
// it holds no `test` declaration, and E2058 refuses one outside such a file — and it sits at the
// staged root so its `export`s are visible to every directory below. The name is never opened by a
// person, but it is what a compile error in generated source is reported against, so it says what
// it is.
let MaxonTestEntryFileName = "__maxon_test_entry.maxon"

// ⭐ **THE CEILING ON A RUN'S TEST COUNT, and the upper bound of the GENERATED index typealias.** Stated
// rather than left at `u64.max` because that alias appears in source a user cannot open, and a project with
// more tests than this has other problems. Refused by COUNT at the grouping, so the (absurd) overflow is a
// sentence naming the limit rather than a range violation inside generated text nobody wrote.
let MaxTestsPerRun = 1000000

// A discovered test paired with its position in the whole run. The pair rather than a bare index because
// the generated call needs the symbol and the generated guard needs the index, and splitting them across
// two parallel arrays is one fact stored twice.
export type IndexedTest
	export let index as ElementIndex
	export let test as DiscoveredTest

	export static function create(index ElementIndex, test DiscoveredTest) returns IndexedTest
		return Self{index: index, test: test}
	end 'create'
end 'IndexedTest'

export typealias IndexedTestArray = Array with IndexedTest

// ⭐ **ONE TEST FILE AND THE TESTS IN IT, IN DISCOVERY ORDER** — the unit both the compile and the run are
// organized around: a file is what a dispatcher is generated for, and what a report groups by.
export type TestFileGroup
	// The `.maxtest` file as the COMPILER recorded it — the user's own path, not the staged copy's. It
	// is what a report names and what the staging maps FROM, so it is identity.
	export let file as FilePath

	// The generated runner's own name, as declared inside that file and called from the entry.
	//
	// ⚠ **ONE NAME, WHERE THE BOOTSTRAP CARRIES TWO.** Its `TestFileGroup` holds a `RunnerName` and a
	// namespace-qualified `RunnerSymbol`, because that compiler qualifies every free function by its
	// directory. The compiler registers a free function under exactly the bytes it was declared with unless the bare
	// name is declared in two DIRECTORIES (`ProgramSignatures.contestedFreeFunctions`) — and this name
	// carries the file's run-wide ordinal, so no two of them are ever equal. The declared spelling is
	// therefore the callable spelling, from the entry file as from anywhere.
	export let runnerName as String
	export let tests as IndexedTestArray

	export static function create(file FilePath, runnerName String, tests IndexedTestArray) returns TestFileGroup
		return Self{file: file, runnerName: runnerName, tests: tests}
	end 'create'
end 'TestFileGroup'

export typealias TestFileGroupArray = Array with TestFileGroup

// Everything a staged test build hands its compile.
export type StagedTestBuild
	// ⭐ **EVERY STAGED SOURCE, NAMED, WITH THE STAGED ROOT LAST.** Naming each file is what makes the
	// `.maxtest` copies compile at all — a path the caller named escapes every walk exclusion
	// (`Compiler.loadSourceFiles`) — and the root rides along at the end to FIX the project root, exactly as
	// `SpecTestRunner.stageSourceFiles` does and for its reason: with one file named, `commonAncestorOf`
	// would answer that FILE, and every namespace and every `__file__` would be measured from it.
	export let buildTargets as MaxonSourcePathArray

	// The subset of those this compiler WROTE, each with the reserved names it minted there — handed to
	// `Compiler.compileToProduct` as `compilerWrittenSources`, which is what lets those names be DECLARED
	// and lets the generated code CALL `__` names at all. A `.maxtest` copy that got no dispatcher is
	// NOT in here: its bytes are the author's, unchanged.
	export let compilerWrittenSources as CompilerWrittenSourceArray

	// ⭐⭐ **WHICH OF THOSE ARE COPIES, AND OF WHOSE FILES** — handed to
	// `Compiler.compileToProduct` as `stagedSourceOrigins`, which is what makes a compile error name the
	// file the author can open rather than the copy this run is about to delete. EVERY copied source is
	// in here, not only the test files: an ordinary `helper.maxon` is copied too, and a diagnostic in it
	// would otherwise name the staging tree just as loudly.
	//
	// ⛔ The generated entry file is deliberately ABSENT. It is not a copy of anything, so there is no
	// author's file to name — a diagnostic there is a bug in what this compiler wrote, and the staged
	// path is the only spelling that lets a reader open the text that failed.
	export let stagedSourceOrigins as StagedSourceOriginArray

	// Where the staged tree is rooted — the test build's project root.
	export let root as FilePath

	// The groups, in discovery order — the run's numbering. A report reads them through
	// `reportFileOrder` instead, so what a transcript says does not depend on the filesystem.
	export let groups as TestFileGroupArray

	export static function create(buildTargets MaxonSourcePathArray, compilerWrittenSources CompilerWrittenSourceArray, stagedSourceOrigins StagedSourceOriginArray, root FilePath, groups TestFileGroupArray) returns StagedTestBuild
		return Self{buildTargets: buildTargets, compilerWrittenSources: compilerWrittenSources, stagedSourceOrigins: stagedSourceOrigins, root: root, groups: groups}
	end 'create'
end 'StagedTestBuild'

// Why a staging attempt could not produce a tree to compile. Every arm is an IO or path failure the caller
// reports and exits on: none of them is a fact about the tests, so none is a test result.
export union TestStagingError implements Error
	refused(reason String)
end 'TestStagingError'

export union TestSubject
	projectDirectory(dir FilePath)
	singleFile(path FilePath)
end 'TestSubject'

export function testSubjectPath(subject TestSubject) returns FilePath
	return match subject 'path'
		projectDirectory(dir) gives dir
		singleFile(path) gives path
	end 'path'
end 'testSubjectPath'

// Which group covers a file, if any. A union rather than a throw, because "this file declares no test" is
// the ordinary answer for most of a project's sources and not a failure of anything.
union TestFileGroupLookup
	found(group TestFileGroup)
	absent
end 'TestFileGroupLookup'

// Discovery order is preserved between files and within one: it is the run's numbering, a report's
// reading order, and what makes a redirected run byte-reproducible.
//
// Separate from the staging because `--list` without `--build` needs the grouping and nothing
// else: it compiles nothing, so it must not synthesize a dispatcher either.
//
// It does not assume the roster arrives grouped, though `ProgramSignatures.declaredTests` does
// arrive with each file's tests contiguous: that is a property of a caller two layers away, and a
// grouping that relied on it would silently drop a file's second run of tests the day anything
// interleaved. Contiguity buys the cost, never the answer: the fast path in `groupOrdinalFor` reads
// it, and the full scan behind that path is right either way.
//
// One pass, because a nested walk is a `FilePath.equals` per (file, test) pair, and on Windows each
// one case-folds both sides into fresh Strings. The residual is Θ(files²), one scan of the groups
// built so far per file transition. A map keyed on the path would remove it, but its key would
// restate `FilePath.equals`'s platform rule (exact bytes on POSIX, case-folded on Windows) outside
// the stdlib that owns it.
export function groupTestsByFile(tests DiscoveredTestArray) returns TestFileGroupArray throws TestStagingError
	// Refused here, by count, rather than left to fail inside generated source: every index there is typed
	// by the generated alias, so the overflow would otherwise surface as a range error in text nobody wrote.
	// `>` and not `>=`: indices run `0..count-1`, so exactly `MaxTestsPerRun` tests is the largest run whose
	// every index fits.
	if tests.count() > MaxTestsPerRun 'moreTestsThanTheRunIsNumberedFor'
		throw TestStagingError.refused("{tests.count()} tests exceeds the {MaxTestsPerRun} a single run is numbered for")
	end 'moreTestsThanTheRunIsNumberedFor'

	var groups = TestFileGroupArray.create()

	// The group the PREVIOUS test landed in. 0 before there is one, which names no group and so takes the
	// scan — see `groupHoldsFile`, which answers FALSE for an ordinal nothing occupies.
	var recent = 0 as ElementIndex

	for (testCursor, test) in tests.withIterator() 'eachTest'
		let ordinal = groupOrdinalFor(groups, file: test.file, recent: recent)
		recent = ordinal

		// MUTATED in place rather than assembled and then pushed, which is what makes this ONE pass: a
		// member is appended the moment it is read, in the order it was read.
		var group = try groups.get(ordinal) otherwise panic("groupTestsByFile: ordinal {ordinal} names no group — `groupOrdinalFor` either found one or appended one, so it cannot hand back a position nothing occupies")
		group.tests.push(IndexedTest.create(testCursor.index(), test: test))
	end 'eachTest'

	return groups
end 'groupTestsByFile'

// ⭐⭐ **WHICH GROUP `file` BELONGS TO, APPENDING ONE WHEN IT BELONGS TO NONE** — the single place a group
// is minted, so a group's ORDINAL and its position in the array are one fact rather than two that can
// disagree.
//
// ⚠ **`recent` BUYS THE COST AND NEVER THE ANSWER** (see the caller's header). A run of tests from one file
// answers here in one comparison; a file transition falls through to the scan, which is right whether or
// not the roster arrived grouped.
function groupOrdinalFor(groups TestFileGroupArray, file FilePath, recent ElementIndex) returns ElementIndex
	if groupHoldsFile(groups, ordinal: recent, file: file) 'theSameFileAsTheTestBefore'
		return recent
	end 'theSameFileAsTheTestBefore'

	for (groupCursor, group) in groups.withIterator() 'eachGroup'
		if group.file.equals(file) 'thisFile'
			return groupCursor.index()
		end 'thisFile'
	end 'eachGroup'

	// The ORDINAL is the group's position, which is what makes the runner name unique — see
	// `MaxonTestFileRunnerPrefix`.
	let ordinal = groups.count()
	groups.push(TestFileGroup.create(file, runnerName: "{MaxonTestFileRunnerPrefix}{ordinal}", tests: IndexedTestArray.create()))
	return ordinal
end 'groupOrdinalFor'

// Does the group at `ordinal` cover `file`? FALSE for an ordinal naming no group, which is what the FIRST
// test of a run asks — an absent group is "not this file" rather than an error, because the caller's next
// move is the scan either way.
function groupHoldsFile(groups TestFileGroupArray, ordinal ElementIndex, file FilePath) returns bool
	let group = try groups.get(ordinal) otherwise return false
	return group.file.equals(file)
end 'groupHoldsFile'

// The group covering `file`, for the staging — which asks about EVERY source in the project, most of which
// hold no test at all. Θ(sources × test files), and unlike `groupOrdinalFor` it has no run of same-file
// questions to exploit: the staging walks the PROJECT's sources rather than the roster, so consecutive
// questions are about unrelated files. The answers differ from `groupOrdinalFor`'s because the callers need
// different things, and a shared routine handing back an ordinal would put the `groups.get` (and its
// unreachable `otherwise`) at the caller instead of here.
function groupOfFile(groups TestFileGroupArray, file FilePath) returns TestFileGroupLookup
	for group in groups 'eachGroup'
		if group.file.equals(file) 'thisFile'
			return TestFileGroupLookup.found(group)
		end 'thisFile'
	end 'eachGroup'

	return TestFileGroupLookup.absent
end 'groupOfFile'

// ⭐⭐ **STAGE THE SUBJECT AND ITS GENERATED SOURCE INTO `stagingRoot`, AND HAND BACK WHAT TO COMPILE.**
//
// `subject` must be spelled exactly as it was for `TestDiscovery.discoverTests`: mapping a group's file
// onto its staged copy is a `FilePath.equals` rather than a re-derivation, so a source spelled
// differently is staged without its dispatcher. A project's walk here and discovery's both go through
// `Compiler.collectMaxonSources`, which is what makes their spellings equal.
//
// The staging root is RECONSTRUCTED, never inherited: a `.maxon` left behind by an earlier run with a
// different test set would join this build silently and change what it means. That is the failure
// `SpecTestRunner.stageSourceFiles` records having had twice.
export function stageTestBuild(stagingRoot FilePath, subject TestSubject, groups TestFileGroupArray) returns StagedTestBuild throws TestStagingError
	if groups.isEmpty() 'nothingToDispatch'
		// A caller-contract violation and not a user error: a run with no tests is reported and exited on
		// BEFORE anything is staged, because the generated entry would otherwise bind a `selection` no
		// runner reads — E3012, in source nobody wrote.
		panic("stageTestBuild: asked to stage a build with no test groups. A zero-test run is the command's to report and exit on; there is no dispatcher to generate for it.")
	end 'nothingToDispatch'

	var build = try GeneratedBuild.begin(stagingRoot)

	match subject 'sources'
		projectDirectory(projectRoot) then try stageProjectSources(build, projectRoot: projectRoot, groups: groups)
		singleFile(path) then try stageOneSource(build, source: path, stagedPath: build.root.join(path.filename()), groups: groups)
	end 'sources'

	try build.addSource(stagingRoot.join("{MaxonTestEntryFileName}"), content: entrySource(groups), mintedNames: mintedNamesForEntry())
	build.fixRoot()

	return StagedTestBuild.create(build.buildTargets, compilerWrittenSources: build.compilerWrittenSources, stagedSourceOrigins: build.stagedSourceOrigins, root: stagingRoot, groups: groups)
end 'stageTestBuild'

function stageProjectSources(build GeneratedBuild, projectRoot FilePath, groups TestFileGroupArray) throws TestStagingError
	var sources = MaxonSourcePathArray.create()

	// ⭐ **`productionAndTests`, WHICH IS THE ONE THING AN ORDINARY BUILD'S WALK ANSWERS DIFFERENTLY.** A
	// test body calls the very declarations its project makes, so the tests are compiled WITH the project
	// and not instead of it.
	_ = try collectMaxonSources(projectRoot, into: sources, selection: SourceSelection.productionAndTests) otherwise throw TestStagingError.refused("could not walk {projectRoot.toString()} for the project's sources")

	for source in sources 'eachSource'
		let relative = try source.relativeTo(projectRoot) otherwise throw TestStagingError.refused("{source.toString()} is not under the project root {projectRoot.toString()}, so it has no place in the staged tree")
		try stageOneSource(build, source: source, stagedPath: build.root.join(relative), groups: groups)
	end 'eachSource'
end 'stageProjectSources'

function stageOneSource(build GeneratedBuild, source FilePath, stagedPath FilePath, groups TestFileGroupArray) throws TestStagingError
	let content = try File.readText(source) otherwise throw TestStagingError.refused("could not read {source.toString()}")

	// Everything with no group — the project's ordinary sources, and any `.maxtest` file that declares
	// no `test` — is copied byte for byte. Its bytes stay the AUTHOR's, which is exactly what keeps it
	// out of `compilerWrittenSources` and so out of the reserved-name exemption.
	//
	// EMPTY minted names are the `absent` arm's answer and only ever that: a dispatcher DECLARES its
	// runner, so a group always mints exactly the one name.
	match groupOfFile(groups, file: source) 'holdsTests'
		found(group) then try build.addSource(stagedPath, content: "{content}{fileDispatcherSource(group)}", mintedNames: mintedNamesForDispatcher(group))
		absent then try build.addSource(stagedPath, content: content, mintedNames: ByteArrayArray.create())
	end 'holdsTests'

	build.recordOrigin(StagedSourceOrigin.create(stagedPath, reportedPath: source))
end 'stageOneSource'

// ⭐ **THE RESERVED NAMES THE APPENDED DISPATCHER DECLARES — read off the group rather than written out
// a second time.** One name: the per-file runner. It is spelled from `TestFileGroup.runnerName`, which is
// also what `fileDispatcherSource` declares and what `entrySource` calls, so the declaration door cannot
// come to admit a spelling the generator has stopped producing.
function mintedNamesForDispatcher(group TestFileGroup) returns ByteArrayArray
	var names = ByteArrayArray.create()
	names.push(group.runnerName.toByteArray())
	return names
end 'mintedNamesForDispatcher'

// ⭐ **THE RESERVED NAMES THE GENERATED ENTRY FILE DECLARES.** Three, each spelled from the very
// constant `entrySource` writes it with.
//
// ⚠ Its non-reserved members (`selection`, `selected`, `began`, `ended`) are deliberately absent: this
// list answers ONE question — which `__` names the declaration door must admit — and a name no rule refuses
// has nothing to be admitted from.
function mintedNamesForEntry() returns ByteArrayArray
	var names = ByteArrayArray.create()
	names.push(MaxonTestIndexAlias.toByteArray())
	names.push(MaxonTestHelperType.toByteArray())
	names.push(MaxonTestEntrySymbol.toByteArray())
	return names
end 'mintedNamesForEntry'

// The handler is the block form of `otherwise` setting a variable: control continues past it, so
// one report site serves pass and fail alike.
//
// A test throws exactly `TestFailure` (`Parser.emitUncaughtTestThrow` converts a foreign error), so
// the handler catches everything but a `panic`. That is why the begin marker precedes the body, and
// why a begin with no end is the crash signal.
//
// Every discovered test is generated in; selection happens at run time (`TestSelectOptionName`).
function fileDispatcherSource(group TestFileGroup) returns String
	var source = "\n// Generated by `maxon test` into a staged copy — the file in your tree is untouched. It lives\n"
	source.append("// in this file because a `test` is not exported, so nowhere else can call one. See TestDispatcher.\n")
	source.append("export function {group.runnerName}(selection String) returns bool\n")
	source.append("\tvar {EveryTestPassedLocal} = true\n")

	for member in group.tests 'eachTest'
		let index = member.index
		let guard = "maxonTestGuard{index}"
		let caught = "maxonTestCaught{index}"
		let symbol = String.from(member.test.symbol)

		source.append("\tif {MaxonTestHelperType}.selected(selection, index: {index}) '{guard}'\n")
		source.append("\t\t{MaxonTestHelperType}.began({index})\n")
		source.append("\t\tvar outcome{index} = \"{TestProtocolOutcomePass}\"\n")
		source.append("\t\tlet started{index} = Clock.nowNanos()\n")
		source.append("\t\ttry {symbol}() otherwise '{caught}'\n")
		source.append("\t\t\toutcome{index} = \"{TestProtocolOutcomeFail}\"\n")
		source.append("\t\t\t{EveryTestPassedLocal} = false\n")
		source.append("\t\tend '{caught}'\n")
		source.append("\t\t{MaxonTestHelperType}.ended({index}, outcome: outcome{index}, nanos: Clock.elapsedNanos(started{index}))\n")
		source.append("\tend '{guard}'\n")
	end 'eachTest'

	source.append("\n\treturn {EveryTestPassedLocal}\n")
	source.append("end '{group.runnerName}'\n")
	return source
end 'fileDispatcherSource'

// `useWireFormat` is called once, first, before anything can report: the contract
// `stdlib/Testing.maxon` states, and why the format is an argument rather than a stdlib constant.
function entrySource(groups TestFileGroupArray) returns String
	requireTestBinaryExitsAreItsOwn()

	let beganLine = wrapped("{TestProtocolBeganTag}{TestProtocolSeparatorInMaxonSource}\{index\}")
	let endedLine = wrapped("{TestProtocolEndedTag}{TestProtocolSeparatorInMaxonSource}\{index\}{TestProtocolSeparatorInMaxonSource}\{outcome\}{TestProtocolSeparatorInMaxonSource}\{nanos\}")

	var source = "// Generated by `maxon test` — this file exists only in the staging tree. See TestDispatcher.\n\n"
	source.append("export typealias {MaxonTestIndexAlias} = int(0 to {MaxTestsPerRun})\n\n")

	source.append("export type {MaxonTestHelperType}\n")
	source.append(selectionMembersSource(MaxonTestIndexAlias))

	source.append("\t// Written BEFORE the body runs, which is what makes a process death attributable: the last\n")
	source.append("\t// test to begin and never end is the one that killed it. `printError` writes straight to the\n")
	source.append("\t// handle with no buffer, so the marker has already left the process by the time the body can\n")
	source.append("\t// panic.\n")
	source.append("\texport static function began(index {MaxonTestIndexAlias})\n")
	source.append("\t\tprintError(\"{beganLine}\\n\")\n")
	source.append("\tend 'began'\n\n")

	source.append("\texport static function ended(index {MaxonTestIndexAlias}, outcome String, nanos DurationNanos)\n")
	source.append("\t\tprintError(\"{endedLine}\\n\")\n")
	source.append("\tend 'ended'\n")
	source.append("end '{MaxonTestHelperType}'\n\n")

	source.append("export function {MaxonTestEntrySymbol}() returns ExitCode\n")
	source.append("\t__TestReport.useWireFormat(\"{TestProtocolWrapper}\", separator: \"{TestProtocolSeparatorInMaxonSource}\")\n")
	source.append("\tlet selection = {MaxonTestHelperType}.selection()\n")
	source.append("\tvar {EveryTestPassedLocal} = true\n\n")

	for group in groups 'eachGroup'
		source.append("\t{EveryTestPassedLocal} = {group.runnerName}(selection) and {EveryTestPassedLocal}\n")
	end 'eachGroup'

	source.append("\n\treturn {TestBinaryEverySelectedTestPassedExit} if {EveryTestPassedLocal} else {TestBinarySomeSelectedTestFailedExit}\n")
	source.append("end '{MaxonTestEntrySymbol}'\n")
	return source
end 'entrySource'

// Bracket a report body the way the protocol requires. One speller, so a line that opens with the wrapper
// cannot close with something else.
function wrapped(body String) returns String
	return "{TestProtocolWrapper}{body}{TestProtocolWrapper}"
end 'wrapped'
