// A spec's batchable run cases (`placementOf`, `claimedPlacementOf`) compile into the fewest programs
// whose claims do not conflict (`BatchGroup.admits`): a nominal type name is whole-program
// (specs/type-name-collision.md), and an extension method declared in two files is E3006. The claims
// come from one front-end pass per case (`Compiler.claimsOfSources`); source text is read only to
// rewrite `main` and to find unused exports. Each case is staged in a directory of its own so
// its file-private names stay apart, its `main` becomes an exported `__spec_case_<n>`, and a
// generated entry runs the cases its `--select=` list names between BEGIN and END markers that
// carry each case's exit code, the live green-thread count `Scheduler.quiesce()` reports, and how many
// processes the case left running, which `Process.endDescendants()` ends and names on framed stderr
// lines (`StderrAudit`), so that case fails and its siblings keep their own verdicts.
//
// The entry quiesces after each case because a case's services and coroutines otherwise run on
// after its `main` returns and land their output past its END marker. A case left with live
// threads, and every case of a program that exited non-zero, reruns alone from the same binary,
// never recompiled. The default `Log` sink is a registry-owned service alive until exit, so a case
// that logs through it reads a count of 1 and reruns alone; that is why the count is a marker field
// and not an exit code.
//
// Batching recovers nothing silently. Output outside every marker fails every case of the program:
// some case ran code before `main` that the up-front checks missed, and the runner must be fixed to
// keep it out. A case the batch compile refuses but that compiles alone fails the same way. A batched
// FAIL is compiled alone only to diagnose it (`withBatchedFailuresDiagnosed`).
//
// A refused batch compile fails only the cases that break the program: those the diagnostics name
// are dropped, and a refusal that names none is bisected over the remaining candidates
// (`BatchSettling`, at most `MaxBatchIsolationTrials` builds). Every other case is judged by its own
// run. A failure that belongs to no case (`BatchBuild.unbuildable`: staging, a missing stdlib or
// runtime, a driver failure; or a spent trial budget) blames nobody: the cases run alone and one
// run-level `harness error:` line makes the suite exit non-zero.
module let MinBatchedCases = 2
let MaxBatchCompileAttempts = 4
let MaxBatchIsolationTrials = 24
let SplitInHalves = 2
let NameListSeparator = ", "
let HarnessErrorPrefix = "harness error: "
let BatchBreakNote = "This case also broke the batch program its siblings share: the batch compile refused it, so the other cases of this spec ran without it."

typealias TrialTally = int(0 to 4096)

let BatchProgramName = "__batch"
let BatchSourceDirSuffix = ".src"
let BatchCaseDirPrefix = "case"
let BatchCaseFileName = "main.maxon"
let BatchEntryFileName = "__spec_batch_entry.maxon"
let BatchEntrySymbol = "__spec_batch_main"
let BatchRunType = "__SpecBatchRun"
let BatchIndexAlias = "__SpecBatchIndex"
let BatchLeftAlias = "__SpecBatchLeft"
let BatchCaseRunnerPrefix = "__spec_case_"

let BatchBeginTag = ">"
let BatchEndTag = "<"
let BatchFieldEnd = ";"

let BatchSelectedExit = 0
let BatchCaseIndent = "\t\t"

let MainSignatureReturningExitCode = "function main() returns ExitCode"
let MainSignatureReturningNothing = "function main()"
let MainSignatureOpening = "function main("
let MainCallOpening = "main("
let MainEndLine = "end 'main'"
let ExportedSignaturePrefix = "export function "
let ExitCodeReturns = " returns ExitCode"
let SourceCarriageReturn = "\r"
let AsciiUpperA = 0x41
let AsciiUpperZ = 0x5A
let AsciiLowerA = 0x61
let AsciiLowerZ = 0x7A
let AsciiUnderscore = 0x5F
let MainSignatureQualifiers = ["export ", "module ", "public ", "async "]

let CommandLineReader = "CommandLine"
let ExecutablePathReader = "executablePath"
let DebugStreamReader = "__DebugStream"
let ProcessStateWriters = ["Log", "Logger", "LogSink", "TraceCapture", "enterBackgroundPriority", "pinToMachine", "unpinFromMachine", "MachinePin"]
let ProcessDrivers = ["SampledProcess"]
let DrivesOtherProcessesGap = "a batch program reaches another process, but placement keeps such a case out of every batch: add the name that reached it to ProcessDrivers"
let GreenThreadQuiesceCall = "Scheduler.quiesce()"
let BatchNothingOutstanding = 0
let BatchNoDescendants = 0
let FileMacro = "__file__"
let LineMacro = "__line__"
let SourceLineBreak = "\n"
let UnusedExportModifiers = ["export ", "module "]

module enum SoloReason
	compileError
	pinsStderr
	takesArgs

	// The batch program's argv carries its `--select=` list, and its executable is the batch's.
	readsCommandLine
	readsItsExecutable

	// The runtime counters a program reads (`RawSurface.runtimeStateReadingCalls`) are process-wide, and
	// earlier cases move them.
	readsRuntimeState

	// `Log`, `Logger`, `LogSink`, `TraceCapture`, the process priority and a machine pin set process-wide
	// state a later case would inherit.
	sharesProcessState

	// A program that takes another process's task port runs from an image `compileOneTest` re-signs,
	// and a batch image is not re-signed.
	drivesOtherProcesses

	// A multi-file program refuses an export nothing uses (E3092, E3094).
	exportsFromItsFile

	// `__DebugStream.` name ids are numbered across the whole program.
	numbersNamesProgramWide

	// The case declares a name the standard library also declares, so every other case's use of that
	// name would change meaning (`StringError`, `ByteArray`, `InitableFromStringLiteral`).
	shadowsALibraryName
	needsStdin
	pinsProcessors
	withdrawsPreemption
	usesNetwork
	needsItsOwnProcess

	// A top-level initializer runs program code before `main`, so its output would land outside every
	// case's markers (`Compiler.claimsOfSources`).
	initializesAtRunTime

	// The up-front initializer query could not stage or check the case; its own compile reports why.
	refusedByTheFrontEnd
	runsAlone
	capturesTrace
	tracesAsync
	buildsDebugInfo
	stagesOwnTiers
	compilesAsLibrary
	spansFiles
	readsItsPosition
	pinsEmittedCode
	unrecognisedMain
end 'SoloReason'

module enum MainShape
	returnsExitCode
	returnsNothing
end 'MainShape'

module union Placement
	together(shape MainShape)
	apart(reason SoloReason)
end 'Placement'

union MainShapeLookup
	found(shape MainShape)
	unrecognised
end 'MainShapeLookup'

// Read from the text because the rewrite to `__spec_case_<n>` is textual; any shape it does not
// recognise answers `unrecognised`, and the case runs alone.
function mainShapeOf(source String) returns MainShapeLookup
	var found = MainShapeLookup.unrecognised
	var mains = 0 as TestTally
	var ends = 0 as TestTally

	for rawLine in source.split(SourceLineBreak) 'eachLine'
		let line = rawLine.trimEnd(CharacterSet.newlines)

		if line.startsWith(MainSignatureOpening) 'opensMain'
			mains = mains + 1

			if line == MainSignatureReturningExitCode 'returnsCode'
				found = MainShapeLookup.found(MainShape.returnsExitCode)
			end 'returnsCode' else if line == MainSignatureReturningNothing 'returnsNothing'
				found = MainShapeLookup.found(MainShape.returnsNothing)
			end 'returnsNothing' else 'otherShape'
				return MainShapeLookup.unrecognised
			end 'otherShape'

			continue
		end 'opensMain'

		if line == MainEndLine 'closesMain'
			ends = ends + 1
			continue
		end 'closesMain'

		if namesMainElsewhere(line) 'namesMainElsewhere'
			return MainShapeLookup.unrecognised
		end 'namesMainElsewhere'
	end 'eachLine'

	if mains != 1 or ends != 1 'notExactlyOne'
		return MainShapeLookup.unrecognised
	end 'notExactlyOne'

	return found
end 'mainShapeOf'

function namesMainElsewhere(line String) returns bool
	for qualifier in MainSignatureQualifiers 'eachQualifier'
		if line.startsWith("{qualifier}{MainSignatureOpening}") 'qualifiedMain'
			return true
		end 'qualifiedMain'
	end 'eachQualifier'

	let pieces = line.split(MainCallOpening)

	for (iter, piece) in pieces.withIterator() 'eachPiece'
		if iter.index() + 1 == pieces.count() 'afterTheLastCall'
			break
		end 'afterTheLastCall'

		if not endsWithIdentifierCharacter(piece) 'aCallOfMain'
			return true
		end 'aCallOfMain'
	end 'eachPiece'

	return false
end 'namesMainElsewhere'

function endsWithIdentifierCharacter(piece String) returns bool
	let bytes = piece.toByteArray()

	if bytes.isEmpty() 'nothingBefore'
		return false
	end 'nothingBefore'

	let last = try bytes.get(bytes.count() - 1) otherwise panic("endsWithIdentifierCharacter: the last of {bytes.count()} bytes is in bounds")
	return isIdentifierByte(last)
end 'endsWithIdentifierCharacter'

function isIdentifierByte(value Byte) returns bool
	let isDigit = value >= AsciiDigitZero and value <= AsciiDigitNine
	let isUpper = value >= AsciiUpperA and value <= AsciiUpperZ
	let isLower = value >= AsciiLowerA and value <= AsciiLowerZ
	return isDigit or isUpper or isLower or value == AsciiUnderscore
end 'isIdentifierByte'

function pinsStderrOf(test SpecTest) returns bool
	return match test.expectation 'e'
		run(_, stderr, _, _) gives match stderr 'pin'
			pinned gives true
			unpinned gives false
		end 'pin'

		compilerError gives false
	end 'e'
end 'pinsStderrOf'

function pinsLinkedPayload(test SpecTest) returns bool
	return test.pinsLinkedSection() or not test.runtimeNames.isEmpty()
end 'pinsLinkedPayload'

function needsStdin(test SpecTest) returns bool
	return match test.stdin 'stdin'
		closed gives false
		held or
		after gives true
	end 'stdin'
end 'needsStdin'

function pinsProcessors(test SpecTest) returns bool
	return match test.procs 'procs'
		unset gives false
		pinned gives true
	end 'procs'
end 'pinsProcessors'

function withdrawsPreemption(test SpecTest) returns bool
	return match test.preempt 'preempt'
		unset gives false
		off gives true
	end 'preempt'
end 'withdrawsPreemption'

function usesNetwork(test SpecTest) returns bool
	return match test.network 'network'
		none gives false
		live gives true
	end 'network'
end 'usesNetwork'

// The reasons a case runs alone that its spec text states; `claimedPlacementOf` asks the rest of the
// front end's claims. Together they are the one list of `SoloReason`s.
module function placementOf(test SpecTest, irAction IrAction) returns Placement
	if test.expectation.expectsCompileError() 'compileError'
		return Placement.apart(SoloReason.compileError)
	end 'compileError'

	if pinsStderrOf(test) 'pinsStderr'
		return Placement.apart(SoloReason.pinsStderr)
	end 'pinsStderr'

	if not test.programArgs.isEmpty() 'takesArgs'
		return Placement.apart(SoloReason.takesArgs)
	end 'takesArgs'

	if declaresUnusedExports(test.source) 'exportsFromItsFile'
		return Placement.apart(SoloReason.exportsFromItsFile)
	end 'exportsFromItsFile'

	if needsStdin(test) 'needsStdin'
		return Placement.apart(SoloReason.needsStdin)
	end 'needsStdin'

	if pinsProcessors(test) 'pinsProcessors'
		return Placement.apart(SoloReason.pinsProcessors)
	end 'pinsProcessors'

	if withdrawsPreemption(test) 'withdrawsPreemption'
		return Placement.apart(SoloReason.withdrawsPreemption)
	end 'withdrawsPreemption'

	if usesNetwork(test) 'usesNetwork'
		return Placement.apart(SoloReason.usesNetwork)
	end 'usesNetwork'

	if test.process != SpecProcess.shared 'needsItsOwnProcess'
		return Placement.apart(SoloReason.needsItsOwnProcess)
	end 'needsItsOwnProcess'

	if test.runs != SpecRuns.shared 'runsAlone'
		return Placement.apart(SoloReason.runsAlone)
	end 'runsAlone'

	if traceCaptureMode(test) 'capturesTrace'
		return Placement.apart(SoloReason.capturesTrace)
	end 'capturesTrace'

	if test.asyncTrace 'tracesAsync'
		return Placement.apart(SoloReason.tracesAsync)
	end 'tracesAsync'

	if test.debugInfo 'buildsDebugInfo'
		return Placement.apart(SoloReason.buildsDebugInfo)
	end 'buildsDebugInfo'

	if not test.stdlibOverlays.isEmpty() or not test.runtimeFiles.isEmpty() 'stagesOwnTiers'
		return Placement.apart(SoloReason.stagesOwnTiers)
	end 'stagesOwnTiers'

	if test.compilesAsLibrary() 'compilesAsLibrary'
		return Placement.apart(SoloReason.compilesAsLibrary)
	end 'compilesAsLibrary'

	if test.isMultiFile() 'spansFiles'
		return Placement.apart(SoloReason.spansFiles)
	end 'spansFiles'

	if test.pinsTargetIr() or pinsLinkedPayload(test) or irAction.needsIr() 'pinsEmittedCode'
		return Placement.apart(SoloReason.pinsEmittedCode)
	end 'pinsEmittedCode'

	return match mainShapeOf(test.source) 'main'
		found(shape) gives Placement.together(shape)
		unrecognised gives Placement.apart(SoloReason.unrecognisedMain)
	end 'main'
end 'placementOf'

function declaresUnusedExports(source String) returns bool
	for rawLine in source.split(SourceLineBreak) 'eachLine'
		for modifier in UnusedExportModifiers 'eachModifier'
			if rawLine.startsWith(modifier) 'marked'
				return true
			end 'marked'
		end 'eachModifier'
	end 'eachLine'

	return false
end 'declaresUnusedExports'

module typealias ClaimedNameSet = Set with String

module type BatchClaim
	export let nominals as StringArray
	export let aliases as StringArray
	export let extensionKeys as StringArray
	export let mentioned as ClaimedNameSet
	export let libraryExtensionMethods as StringArray

	module static function of(claims SourceClaims) returns BatchClaim
		var mentioned = ClaimedNameSet.create()

		for name in claims.mentionedNames 'eachMention'
			mentioned.insert(name)
		end 'eachMention'

		return Self{nominals: claims.declaredNominals, aliases: claims.declaredAliases, extensionKeys: claims.extensionMethodKeys, mentioned: mentioned, libraryExtensionMethods: claims.libraryExtensionMethods}
	end 'of'

	module function declares(name String) returns bool
		return self.nominals.contains(name) or self.aliases.contains(name)
	end 'declares'

	// A declared nominal conflicts with any mention of it, since the name is whole-program. A declared
	// typealias conflicts only with a case that mentions the name without declaring it, which would
	// read this case's alias in place of the library's; two cases that both declare it may share.
	module function meansAnotherCasesName(other BatchClaim) returns bool
		for nominal in self.nominals 'eachNominal'
			if other.mentioned.contains(nominal) 'otherNamesIt'
				return true
			end 'otherNamesIt'
		end 'eachNominal'

		for alias in self.aliases 'eachAlias'
			if not other.declares(alias) and other.mentioned.contains(alias) 'otherMeansTheLibrarys'
				return true
			end 'otherMeansTheLibrarys'
		end 'eachAlias'

		return false
	end 'meansAnotherCasesName'

	module function sharesAnExtensionMethodWith(other BatchClaim) returns bool
		for key in self.extensionKeys 'eachKey'
			if other.extensionKeys.contains(key) 'sameKey'
				return true
			end 'sameKey'
		end 'eachKey'

		return false
	end 'sharesAnExtensionMethodWith'

	module function exposesItsTypesToExtensionCallsIn(other BatchClaim) returns bool
		for method in self.libraryExtensionMethods 'eachMethod'
			if other.mentioned.contains(method) 'otherCallsIt'
				return true
			end 'otherCallsIt'
		end 'eachMethod'

		return false
	end 'exposesItsTypesToExtensionCallsIn'
end 'BatchClaim'

typealias BatchClaimArray = Array with BatchClaim

module type ClaimedMember
	export let member as BatchMember
	export let claim as BatchClaim

	module static function create(member BatchMember, claim BatchClaim) returns ClaimedMember
		return Self{member: member, claim: claim}
	end 'create'
end 'ClaimedMember'

module typealias ClaimedMemberArray = Array with ClaimedMember

module type BatchGroup
	export var members as BatchMemberArray
	var claims as BatchClaimArray

	module static function create() returns BatchGroup
		return Self{members: BatchMemberArray.create(0), claims: BatchClaimArray.create(0)}
	end 'create'

	module function admits(claim BatchClaim) returns bool
		for held in self.claims 'eachHeld'
			if claim.sharesAnExtensionMethodWith(held) or claim.meansAnotherCasesName(held) or held.meansAnotherCasesName(claim) or claim.exposesItsTypesToExtensionCallsIn(held) or held.exposesItsTypesToExtensionCallsIn(claim) 'conflicts'
				return false
			end 'conflicts'
		end 'eachHeld'

		return true
	end 'admits'

	module function admit(claimed ClaimedMember)
		self.members.push(claimed.member)
		self.claims.push(claimed.claim)
	end 'admit'
end 'BatchGroup'

module typealias BatchGroupArray = Array with BatchGroup

module function partitionedByClaims(candidates ClaimedMemberArray) returns BatchGroupArray
	var groups = BatchGroupArray.create(0)

	for claimed in candidates 'eachMember'
		var placed = false

		for position in 0 upto groups.count() 'eachGroup'
			var group = try groups.get(position) otherwise panic("SpecBatch: group {position} is in bounds of the {groups.count()} groups")

			if group.admits(claimed.claim) 'free'
				group.admit(claimed)
				placed = true
				break
			end 'free'
		end 'eachGroup'

		if not placed 'needsAGroup'
			var group = BatchGroup.create()
			group.admit(claimed)
			groups.push(group)
		end 'needsAGroup'
	end 'eachMember'

	return groups
end 'partitionedByClaims'

module union ClaimAnswer
	answered(claims SourceClaims)
	refused
end 'ClaimAnswer'

module union ClaimedPlacement
	together(claimed ClaimedMember)
	apart(reason SoloReason)
end 'ClaimedPlacement'

module function claimedPlacementOf(member BatchMember, answer ClaimAnswer) returns ClaimedPlacement
	return match answer 'answer'
		answered(claims) gives claimedPlacementFor(member, claims: claims)
		refused gives ClaimedPlacement.apart(SoloReason.refusedByTheFrontEnd)
	end 'answer'
end 'claimedPlacementOf'

function claimedPlacementFor(member BatchMember, claims SourceClaims) returns ClaimedPlacement
	if claims.moduleInit == ModuleInitNeed.runsProgramCode 'initializesAtRunTime'
		return ClaimedPlacement.apart(SoloReason.initializesAtRunTime)
	end 'initializesAtRunTime'

	if not claims.shadowedLibraryNames.isEmpty() 'shadowsALibraryName'
		return ClaimedPlacement.apart(SoloReason.shadowsALibraryName)
	end 'shadowsALibraryName'

	if namesAny(claims, words: [CommandLineReader]) 'readsCommandLine'
		return ClaimedPlacement.apart(SoloReason.readsCommandLine)
	end 'readsCommandLine'

	if namesAny(claims, words: [ExecutablePathReader]) 'readsItsExecutable'
		return ClaimedPlacement.apart(SoloReason.readsItsExecutable)
	end 'readsItsExecutable'

	if namesAny(claims, words: runtimeStateReadingCalls()) 'readsRuntimeState'
		return ClaimedPlacement.apart(SoloReason.readsRuntimeState)
	end 'readsRuntimeState'

	if namesAny(claims, words: ProcessStateWriters) 'sharesProcessState'
		return ClaimedPlacement.apart(SoloReason.sharesProcessState)
	end 'sharesProcessState'

	if namesAny(claims, words: ProcessDrivers) 'drivesOtherProcesses'
		return ClaimedPlacement.apart(SoloReason.drivesOtherProcesses)
	end 'drivesOtherProcesses'

	if namesAny(claims, words: [DebugStreamReader]) 'numbersNamesProgramWide'
		return ClaimedPlacement.apart(SoloReason.numbersNamesProgramWide)
	end 'numbersNamesProgramWide'

	if namesAny(claims, words: [FileMacro, LineMacro]) 'readsItsPosition'
		return ClaimedPlacement.apart(SoloReason.readsItsPosition)
	end 'readsItsPosition'

	return ClaimedPlacement.together(ClaimedMember.create(member, claim: BatchClaim.of(claims)))
end 'claimedPlacementFor'

function namesAny(claims SourceClaims, words StringArray) returns bool
	for word in words 'eachWord'
		if claims.mentionedNames.contains(word) 'mentioned'
			return true
		end 'mentioned'
	end 'eachWord'

	return false
end 'namesAny'

module type BatchMember
	export let testIndex as ElementIndex
	export let shape as MainShape

	module static function create(testIndex ElementIndex, shape MainShape) returns BatchMember
		return Self{testIndex: testIndex, shape: shape}
	end 'create'
end 'BatchMember'

module typealias BatchMemberArray = Array with BatchMember

function batchCaseName(caseIndex ElementIndex) returns String
	return "{BatchCaseRunnerPrefix}{caseIndex}"
end 'batchCaseName'

function batchCaseSource(test SpecTest, caseIndex ElementIndex) returns String
	let name = batchCaseName(caseIndex)
	let rawLines = test.source.split(SourceLineBreak)
	var lines = StringArray.create(rawLines.count(), zeroed: false)

	for rawLine in rawLines 'eachLine'
		let line = rawLine.trimEnd(CharacterSet.newlines)
		let lineEnding = SourceCarriageReturn if rawLine.endsWith(SourceCarriageReturn) else ""

		if line == MainSignatureReturningExitCode 'exitCodeSignature'
			lines.push("{ExportedSignaturePrefix}{name}(){ExitCodeReturns}{lineEnding}")
		end 'exitCodeSignature' else if line == MainSignatureReturningNothing 'bareSignature'
			lines.push("{ExportedSignaturePrefix}{name}(){lineEnding}")
		end 'bareSignature' else if line == MainEndLine 'endLabel'
			lines.push("end '{name}'{lineEnding}")
		end 'endLabel' else 'untouched'
			lines.push(rawLine)
		end 'untouched'
	end 'eachLine'

	return "{joinedWith(lines, separator: SourceLineBreak)}{SourceLineBreak}"
end 'batchCaseSource'

// Asked of the target's facilities: without green threads the entry has nothing to quiesce
// (`gtQuiesce` would be E3104).
type EntryFacilities
	export let quiesces as bool
	export let audits as bool

	static function of(target Target) returns EntryFacilities
		return Self{quiesces: targetProvidesFacility(target, facility: HostFacility.greenThreads), audits: targetProvidesFacility(target, facility: HostFacility.processDescendants)}
	end 'of'
end 'EntryFacilities'

function endedCaseSource(index ElementIndex, codeText String, facilities EntryFacilities) returns String
	let outstanding = "{GreenThreadQuiesceCall} as {BatchLeftAlias}" if facilities.quiesces else "{BatchNothingOutstanding}"
	return "{BatchCaseIndent}{BatchRunType}.ended({index}, code: {codeText}, outstanding: {outstanding})\n"
end 'endedCaseSource'

function descendantAuditSource(facilities EntryFacilities) returns String
	if not facilities.audits 'noFacility'
		return "\t\tlet descendants = {BatchNoDescendants}\n"
	end 'noFacility'

	var source = "\t\tlet found = Process.endDescendants()\n\n"
	source.append("\t\tfor entry in found 'eachDescendant'\n")
	source.append("\t\t\t{descendantFramePrintSource()}\n")
	source.append("\t\tend 'eachDescendant'\n\n")
	source.append("\t\tlet descendants = found.count()\n")
	return source
end 'descendantAuditSource'

function batchEntrySource(members BatchMemberArray, facilities EntryFacilities) returns String
	let begun = "{SpecMarkerWrapper}{BatchBeginTag}\{index\}{BatchFieldEnd}"
	let ended = "{SpecMarkerWrapper}{BatchEndTag}\{index\}{BatchFieldEnd}\{code\}{BatchFieldEnd}\{outstanding\}{BatchFieldEnd}\{descendants\}{BatchFieldEnd}"

	var source = "// Generated by `maxon spec-test` — this file exists only in the staging tree. See SpecBatch.\n\n"
	source.append("export typealias {BatchIndexAlias} = int(0 to {members.count()})\n\n")

	source.append("export typealias {BatchLeftAlias} = int(i64.min to i64.max)\n\n")
	source.append("export type {BatchRunType}\n")
	source.append(selectionMembersSource(BatchIndexAlias))
	source.append("\texport static function began(index {BatchIndexAlias})\n")
	source.append("\t\tprint(\"{begun}\\n\")\n")
	source.append("\t\tprintError(\"{begun}\\n\")\n")
	source.append("\tend 'began'\n\n")
	source.append("\texport static function ended(index {BatchIndexAlias}, code ExitCode, outstanding {BatchLeftAlias})\n")
	source.append(descendantAuditSource(facilities))
	source.append("\t\tprint(\"{ended}\\n\")\n")
	source.append("\t\tprintError(\"{ended}\\n\")\n")
	source.append("\tend 'ended'\n")
	source.append("end '{BatchRunType}'\n\n")

	source.append("export function {BatchEntrySymbol}() returns ExitCode\n")

	source.append("\tlet selection = {BatchRunType}.selection()\n\n")

	for (iter, member) in members.withIterator() 'eachCase'
		let index = iter.index()

		source.append("\tif {BatchRunType}.selected(selection, index: {index}) 'case{index}'\n")
		source.append("{BatchCaseIndent}{BatchRunType}.began({index})\n")

		match member.shape 'shape'
			returnsExitCode then source.append("{BatchCaseIndent}let code{index} = {batchCaseName(index)}()\n{endedCaseSource(index, codeText: "code{index}", facilities: facilities)}")
			returnsNothing then source.append("{BatchCaseIndent}{batchCaseName(index)}()\n{endedCaseSource(index, codeText: "{BatchSelectedExit}", facilities: facilities)}")
		end 'shape'

		source.append("\tend 'case{index}'\n")
		source.append("\n")
	end 'eachCase'

	source.append("\treturn {BatchSelectedExit}\n")
	source.append("end '{BatchEntrySymbol}'\n")
	return source
end 'batchEntrySource'

function mintedNamesForBatchCase(caseIndex ElementIndex) returns immutable NameRoster
	var names = NameRoster.create(1, zeroed: false) as isolated NameRoster
	names.push(freeze batchCaseName(caseIndex).toByteArray())
	return freeze names
end 'mintedNamesForBatchCase'

function mintedNamesForBatchEntry() returns immutable NameRoster
	var names = NameRoster.create(4, zeroed: false) as isolated NameRoster
	names.push(freeze BatchIndexAlias.toByteArray())
	names.push(freeze BatchLeftAlias.toByteArray())
	names.push(freeze BatchRunType.toByteArray())
	names.push(freeze BatchEntrySymbol.toByteArray())
	return freeze names
end 'mintedNamesForBatchEntry'

module type BatchProgram
	export let exePath as FilePath
	export var members as BatchMemberArray
	export let stdlibDir as String
	export let runtimeDir as String
	export let writtenFiles as FilePathArray

	module static function create(exePath FilePath, members BatchMemberArray, stdlibDir String, runtimeDir String, writtenFiles FilePathArray) returns BatchProgram
		return Self{exePath: exePath, members: members, stdlibDir: stdlibDir, runtimeDir: runtimeDir, writtenFiles: writtenFiles}
	end 'create'

	module function allCases() returns TestRunIndexArray
		var cases = TestRunIndexArray.create(self.members.count(), zeroed: false)

		for index in 0 upto self.members.count() 'eachMember'
			cases.push(index)
		end 'eachMember'

		return cases
	end 'allCases'
end 'BatchProgram'

module union BatchBuild
	built(program BatchProgram, ticks CpuTicks)
	notBuilt(answer CompileAnswer, refused TestRunIndexArray)
	unbuildable(reason String)
end 'BatchBuild'

function batchProgramNameOf(ordinal ElementIndex) returns String
	return "{BatchProgramName}{ordinal}"
end 'batchProgramNameOf'

function batchSourceRoot(tempDir FilePath, ordinal ElementIndex) returns FilePath
	return tempDir.join("{batchProgramNameOf(ordinal)}{BatchSourceDirSuffix}")
end 'batchSourceRoot'

function batchExePath(tempDir FilePath, ordinal ElementIndex, exeExtension String) returns FilePath
	return try FilePath.from("{tempDir.join(batchProgramNameOf(ordinal)).toString()}{exeExtension}") otherwise panic("SpecBatch: the output path of batch program {ordinal} under {tempDir.toString()} is not a valid path")
end 'batchExePath'

function stageBatch(tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, members BatchMemberArray, facilities EntryFacilities) returns GeneratedBuild throws TestStagingError
	var build = try GeneratedBuild.begin(batchSourceRoot(tempDir, ordinal: ordinal))

	for (iter, member) in members.withIterator() 'eachMember'
		let test = try tests.get(member.testIndex) otherwise panic("SpecBatch: batch member {iter.index()} names test {member.testIndex}, past the {tests.count()} the spec selected")
		let caseIndex = iter.index()
		let path = build.root.join("{BatchCaseDirPrefix}{caseIndex}").join(BatchCaseFileName)
		try build.addSource(path, content: batchCaseSource(test, caseIndex: caseIndex), mintedNames: mintedNamesForBatchCase(caseIndex))
	end 'eachMember'

	try build.addSource(build.root.join(BatchEntryFileName), content: batchEntrySource(members, facilities: facilities), mintedNames: mintedNamesForBatchEntry())
	build.fixRoot()
	return build
end 'stageBatch'

module function batchBuildsWithFreedBoxPoison(tests SpecTestArray, members BatchMemberArray) returns bool
	var poisons = false

	for (iter, member) in members.withIterator() 'eachMember'
		let test = try tests.get(member.testIndex) otherwise panic("SpecBatch: batch member {iter.index()} names test {member.testIndex}, past the {tests.count()} the spec selected")
		let wanted = test.buildsWithFreedBoxPoison()

		if iter.index() == 0 'first'
			poisons = wanted
		end 'first' else if wanted != poisons 'disagrees'
			panic("SpecBatch: test '{test.name}' is built {"with" if wanted else "without"} the freed-box fill and the members before it {"with" if poisons else "without"}, yet one program carries one fill setting. Placement must keep cases that disagree apart")
		end 'disagrees'
	end 'eachMember'

	return poisons
end 'batchBuildsWithFreedBoxPoison'

function buildBatch(tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, members BatchMemberArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns BatchBuild
	let stdlibDir = try locateStdlibDir() otherwise return BatchBuild.unbuildable(missingStdlibReason())
	let runtimeDir = try runtimeDirBeside(stdlibDir) otherwise return BatchBuild.unbuildable(missingRuntimeReason())
	let facilities = EntryFacilities.of(effectiveTarget)
	let staged = try stageBatch(tempDir, ordinal: ordinal, tests: tests, members: members, facilities: facilities) otherwise (e) 'notStaged'
		return BatchBuild.unbuildable(stagingRefusalReason(e))
	end 'notStaged'

	let exePath = batchExePath(tempDir, ordinal: ordinal, exeExtension: exeExtension)

	var session = CompileSession.create(DiagnosticSink.capturing(), fileMemos: fileMemos, treeLock: LockHold.none())
	let product = try compileToProduct(staged.buildTargets, target: effectiveTarget, outputOverride: StatedText.stated(exePath.toString()), runtimeIrNames: RuntimeFunctionNameArray.create(0), poisonFreed: batchBuildsWithFreedBoxPoison(tests, members: members), stdlibDirOverride: StatedText.stated(stdlibDir.toString()), runtimeDirOverride: StatedText.stated(runtimeDir.toString()), scriptlib: ScriptlibLoad.omitted, entryFunction: freeze BatchEntrySymbol.toByteArray(), compilerWrittenSources: staged.compilerWrittenSources, session: session) otherwise (e) 'didNotCompile'
		reportCompileError(e, sink: session.diagnostics)
		return batchBuildAfterError(CompileAnswer.create(compileVerdictOf(e), diagnostics: session.diagnostics.text()), ordinal: ordinal, count: members.count())
	end 'didNotCompile'

	if product.drivesOtherProcesses 'aGapInPlacement'
		try File.delete(exePath) otherwise ignore

		return BatchBuild.notBuilt(CompileAnswer.create(CompileVerdict.driverFailed, diagnostics: DrivesOtherProcessesGap), refused: TestRunIndexArray.create(0))
	end 'aGapInPlacement'

	var written = FilePathArray.create(staged.buildTargets.count(), zeroed: false)

	for path in staged.buildTargets 'eachTarget'
		if not path.equals(staged.root) 'aStagedFile'
			written.push(path)
		end 'aStagedFile'
	end 'eachTarget'

	return BatchBuild.built(BatchProgram.create(exePath, members: members, stdlibDir: stdlibDir.toString(), runtimeDir: runtimeDir.toString(), writtenFiles: written), ticks: product.totalCpuTicks)
end 'buildBatch'

function batchBuildAfterError(answer CompileAnswer, ordinal ElementIndex, count ElementIndex) returns BatchBuild
	match answer.verdict 'verdict'
		driverFailed then return BatchBuild.unbuildable(answer.diagnostics.trim())
		reportedDiagnostics or
		sourceOrderUnplaceable then return BatchBuild.notBuilt(answer, refused: membersNamedIn(answer.diagnostics, ordinal: ordinal, count: count))
		built then panic("SpecBatch: a batch compile that raised an error reports a finished build")
	end 'verdict'
end 'batchBuildAfterError'

module type BatchRefusal
	export let diagnostics as String
	export let partners as StringArray

	module static function create(diagnostics String, partners StringArray) returns BatchRefusal
		return Self{diagnostics: diagnostics, partners: partners}
	end 'create'

	module function note() returns String
		if self.partners.isEmpty() 'noPartner'
			return BatchBreakNote
		end 'noPartner'

		return "{BatchBreakNote} It conflicted with {joinedWith(self.partners, separator: NameListSeparator)}, which stay in the shared program."
	end 'note'
end 'BatchRefusal'

module typealias BatchRefusalMap = Map with (ElementIndex, BatchRefusal)

module type BatchOutcome
	export let build as BatchBuild
	export let refusals as BatchRefusalMap
	export let harnessErrors as StringArray

	module static function create(build BatchBuild, refusals BatchRefusalMap, harnessErrors StringArray) returns BatchOutcome
		return Self{build: build, refusals: refusals, harnessErrors: harnessErrors}
	end 'create'
end 'BatchOutcome'

function diagnosticsNaming(diagnostics String, ordinal ElementIndex, positions TestRunIndexArray) returns String
	var named = StringArray.create(0)

	for line in diagnostics.split(SourceLineBreak) 'eachLine'
		for position in positions 'eachPosition'
			if namesCase(line, ordinal: ordinal, caseIndex: position) 'namesIt'
				named.push(line.trim())
				break
			end 'namesIt'
		end 'eachPosition'
	end 'eachLine'

	return joinedWith(named, separator: SourceLineBreak)
end 'diagnosticsNaming'

function diagnosticsInTestNames(diagnostics String, ordinal ElementIndex, members BatchMemberArray, tests SpecTestArray) returns String
	var translated = diagnostics

	for (iter, member) in members.withIterator() 'eachMember'
		let name = testNameFor(member, tests: tests)

		for separator in [PortablePathSeparator, WindowsPathSeparator] 'eachSeparator'
			translated = translated.replace("{batchProgramNameOf(ordinal)}{BatchSourceDirSuffix}{separator}{BatchCaseDirPrefix}{iter.index()}{separator}{BatchCaseFileName}", with: "<{name}>")
		end 'eachSeparator'

		translated = translated.replace("'{batchCaseName(iter.index())}'", with: "'{name}'")
	end 'eachMember'

	return translated
end 'diagnosticsInTestNames'

function testNameFor(member BatchMember, tests SpecTestArray) returns String
	let test = try tests.get(member.testIndex) otherwise panic("SpecBatch: batch member names test {member.testIndex}, past the {tests.count()} the spec selected")
	return test.name
end 'testNameFor'

function membersNamedIn(diagnostics String, ordinal ElementIndex, count ElementIndex) returns TestRunIndexArray
	var named = TestRunIndexArray.create(0)

	for index in 0 upto count 'eachMember'
		if namesCase(diagnostics, ordinal: ordinal, caseIndex: index) 'namesIt'
			named.push(index)
		end 'namesIt'
	end 'eachMember'

	return named
end 'membersNamedIn'

function namesCase(text String, ordinal ElementIndex, caseIndex ElementIndex) returns bool
	for separator in [PortablePathSeparator, WindowsPathSeparator] 'eachSeparator'
		if text.contains("{batchProgramNameOf(ordinal)}{BatchSourceDirSuffix}{separator}{BatchCaseDirPrefix}{caseIndex}{separator}") 'namesIt'
			return true
		end 'namesIt'
	end 'eachSeparator'

	return false
end 'namesCase'

function membersWithout(members BatchMemberArray, positions TestRunIndexArray) returns BatchMemberArray
	var kept = BatchMemberArray.create(members.count(), zeroed: false)

	for (iter, member) in members.withIterator() 'eachMember'
		if not positions.contains(iter.index()) 'stays'
			kept.push(member)
		end 'stays'
	end 'eachMember'

	return kept
end 'membersWithout'

function indexesOf(members BatchMemberArray) returns TestRunIndexArray
	var indexes = TestRunIndexArray.create(members.count(), zeroed: false)

	for member in members 'eachMember'
		indexes.push(member.testIndex)
	end 'eachMember'

	return indexes
end 'indexesOf'

function testNamesText(indexes TestRunIndexArray, tests SpecTestArray) returns String
	var names = StringArray.create(indexes.count(), zeroed: false)

	for index in indexes 'eachIndex'
		let test = try tests.get(index) otherwise panic("SpecBatch: test {index} is past the {tests.count()} the spec selected")
		names.push(test.name)
	end 'eachIndex'

	return joinedWith(names, separator: NameListSeparator)
end 'testNamesText'

function trialBudgetErrors(unsettled TestRunIndexArray, tests SpecTestArray) returns StringArray
	var errors = StringArray.create(0)

	if unsettled.isEmpty() 'allSettled'
		return errors
	end 'allSettled'

	errors.push("{HarnessErrorPrefix}a case among these breaks the batch program and the harness spent its {MaxBatchIsolationTrials} trial builds without isolating which. These {unsettled.count()} cases ran alone and their own results decide them: {testNamesText(unsettled, tests: tests)}")
	return errors
end 'trialBudgetErrors'

function environmentErrors(reason String, affected TestRunIndexArray, tests SpecTestArray) returns StringArray
	var errors = StringArray.create(0)

	if affected.isEmpty() 'nothingAffected'
		return errors
	end 'nothingAffected'

	errors.push("{HarnessErrorPrefix}the batch program could not be built ({reason}), and no case is blamed for it. These {affected.count()} cases ran alone and their own results decide them: {testNamesText(affected, tests: tests)}")
	return errors
end 'environmentErrors'

function discardBatchLeftovers(tempDir FilePath, ordinal ElementIndex, exeExtension String)
	emptyScratchDirectory(batchSourceRoot(tempDir, ordinal: ordinal))
	discardBuild(FilePathArray.create(0), exePath: batchExePath(tempDir, ordinal: ordinal, exeExtension: exeExtension))
end 'discardBatchLeftovers'

module function buildBatchDroppingRefused(tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, members BatchMemberArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns BatchOutcome
	var remaining = members.clone()
	var refusals = BatchRefusalMap.create()
	var last = BatchBuild.notBuilt(CompileAnswer.create(CompileVerdict.driverFailed, diagnostics: "no batch compile was attempted"), refused: TestRunIndexArray.create(0))

	for _ in 0 upto MaxBatchCompileAttempts 'eachAttempt'
		if remaining.isEmpty() 'noneLeft'
			break
		end 'noneLeft'

		last = buildBatch(tempDir, ordinal: ordinal, tests: tests, members: remaining, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)

		match last 'attempt'
			built then break 'eachAttempt'
			notBuilt(answer, refused) then remaining = noteRefused(refusals, answer: answer, ordinal: ordinal, refused: refused, remaining: remaining, tests: tests)
			unbuildable then break 'eachAttempt'
		end 'attempt'

		if attemptRefusedNothing(last) 'nothingToDrop'
			break
		end 'nothingToDrop'
	end 'eachAttempt'

	return outcomeAfterAttempts(last, remaining: remaining, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
end 'buildBatchDroppingRefused'

union BatchPrior
	fresh
	refused(answer CompileAnswer)
end 'BatchPrior'

function priorOf(last BatchBuild) returns BatchPrior
	return match last 'last'
		notBuilt(answer, refused) gives BatchPrior.refused(answer) if refused.isEmpty() else BatchPrior.fresh
		built or
		unbuildable gives BatchPrior.fresh
	end 'last'
end 'priorOf'

function outcomeAfterAttempts(last BatchBuild, remaining BatchMemberArray, refusals BatchRefusalMap, tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns BatchOutcome
	match last 'last'
		built then return BatchOutcome.create(last, refusals: refusals, harnessErrors: StringArray.create(0))
		notBuilt then return isolatedOutcome(last, prior: priorOf(last), remaining: remaining, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
		unbuildable(reason) then return unbuildableOutcome(last, reason: reason, affected: indexesOf(remaining), refusals: refusals, tempDir: tempDir, ordinal: ordinal, exeExtension: exeExtension, tests: tests)
	end 'last'
end 'outcomeAfterAttempts'

union SettledTail
	noTrial
	current(build BatchBuild)
	stale
	halted(reason String)
end 'SettledTail'

union HaltState
	running
	halted(reason String)
end 'HaltState'

function latestTail(earlier SettledTail, later SettledTail) returns SettledTail
	return match later 'later'
		noTrial gives earlier
		current or
		stale or
		halted gives later
	end 'later'
end 'latestTail'

function failureTail(accepted BatchMemberArray) returns SettledTail
	return SettledTail.noTrial if accepted.isEmpty() else SettledTail.stale
end 'failureTail'

function isolatedOutcome(last BatchBuild, prior BatchPrior, remaining BatchMemberArray, refusals BatchRefusalMap, tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns BatchOutcome
	var accepted = BatchMemberArray.create(0)
	var settling = BatchSettling.begin()
	let tail = settling.settleFrom(prior, accepted: accepted, candidates: remaining, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
	let unsettled = settling.unsettledIndexes()
	let affected = indexesJoined(indexesOf(accepted), following: unsettled)
	let spentErrors = trialBudgetErrors(unsettled, tests: tests)

	match tail 'tail'
		halted(reason) then return unbuildableOutcome(BatchBuild.unbuildable(reason), reason: reason, affected: affected, refusals: refusals, tempDir: tempDir, ordinal: ordinal, exeExtension: exeExtension, tests: tests)
		noTrial then return BatchOutcome.create(last, refusals: refusals, harnessErrors: spentErrors)
		current(build) then return BatchOutcome.create(build, refusals: refusals, harnessErrors: spentErrors)
		stale then return outcomeAfterRebuild(buildBatch(tempDir, ordinal: ordinal, tests: tests, members: accepted, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos), refusals: refusals, spentErrors: spentErrors, affected: affected, tempDir: tempDir, ordinal: ordinal, exeExtension: exeExtension, tests: tests)
	end 'tail'
end 'isolatedOutcome'

function indexesJoined(first TestRunIndexArray, following TestRunIndexArray) returns TestRunIndexArray
	var joined = first.clone()
	joined.append(following)
	return joined
end 'indexesJoined'

function unbuildableOutcome(build BatchBuild, reason String, affected TestRunIndexArray, refusals BatchRefusalMap, tempDir FilePath, ordinal ElementIndex, exeExtension String, tests SpecTestArray) returns BatchOutcome
	discardBatchLeftovers(tempDir, ordinal: ordinal, exeExtension: exeExtension)
	return BatchOutcome.create(build, refusals: refusals, harnessErrors: environmentErrors(reason, affected: affected, tests: tests))
end 'unbuildableOutcome'

function outcomeAfterRebuild(rebuilt BatchBuild, refusals BatchRefusalMap, spentErrors StringArray, affected TestRunIndexArray, tempDir FilePath, ordinal ElementIndex, exeExtension String, tests SpecTestArray) returns BatchOutcome
	match rebuilt 'rebuilt'
		built then return BatchOutcome.create(rebuilt, refusals: refusals, harnessErrors: spentErrors)
		unbuildable(reason) then return unbuildableOutcome(rebuilt, reason: reason, affected: affected, refusals: refusals, tempDir: tempDir, ordinal: ordinal, exeExtension: exeExtension, tests: tests)
		notBuilt(answer, _) then panic("SpecBatch: members that built together a moment ago were refused on a rebuild:\n{answer.diagnostics}")
	end 'rebuilt'
end 'outcomeAfterRebuild'

type BatchSettling
	var unsettled as BatchMemberArray
	var trialsLeft as TrialTally
	var halt as HaltState

	static function begin() returns BatchSettling
		return Self{unsettled: BatchMemberArray.create(0), trialsLeft: MaxBatchIsolationTrials, halt: HaltState.running}
	end 'begin'

	function unsettledIndexes() returns TestRunIndexArray
		return indexesOf(self.unsettled)
	end 'unsettledIndexes'

	function hasHalted() returns bool
		return match self.halt 'halt'
			running gives false
			halted gives true
		end 'halt'
	end 'hasHalted'

	function settleFrom(prior BatchPrior, accepted mutable BatchMemberArray, candidates BatchMemberArray, refusals BatchRefusalMap, tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns SettledTail
		return match prior 'prior'
			fresh gives self.settle(accepted, candidates: candidates, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
			refused(answer) gives self.refuse(accepted, candidates: candidates, answer: answer, refused: TestRunIndexArray.create(0), refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
		end 'prior'
	end 'settleFrom'

	function settle(accepted mutable BatchMemberArray, candidates BatchMemberArray, refusals BatchRefusalMap, tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns SettledTail
		if candidates.isEmpty() 'nothingToSettle'
			return SettledTail.noTrial
		end 'nothingToSettle'

		if self.hasHalted() or self.trialsLeft == 0 'noTrialsRemain'
			self.unsettled.append(candidates)
			return SettledTail.noTrial
		end 'noTrialsRemain'

		self.trialsLeft = self.trialsLeft - 1

		var trial = accepted.clone()
		trial.append(candidates)

		let attempt = buildBatch(tempDir, ordinal: ordinal, tests: tests, members: trial, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)

		match attempt 'attempt'
			built then return self.accepting(accepted, candidates: candidates, attempt: attempt)
			notBuilt(answer, refused) then return self.refuse(accepted, candidates: candidates, answer: answer, refused: refused, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
			unbuildable(reason) then return self.halting(candidates, reason: reason)
		end 'attempt'
	end 'settle'

	function accepting(accepted mutable BatchMemberArray, candidates BatchMemberArray, attempt BatchBuild) returns SettledTail
		accepted.append(candidates)
		return SettledTail.current(attempt)
	end 'accepting'

	function halting(candidates BatchMemberArray, reason String) returns SettledTail
		self.halt = HaltState.halted(reason)
		self.unsettled.append(candidates)
		return SettledTail.halted(reason)
	end 'halting'

	function refuse(accepted mutable BatchMemberArray, candidates BatchMemberArray, answer CompileAnswer, refused TestRunIndexArray, refusals BatchRefusalMap, tempDir FilePath, ordinal ElementIndex, tests SpecTestArray, exeExtension String, effectiveTarget Target, fileMemos SharedFileMemoMap) returns SettledTail
		let failure = failureTail(accepted)
		let partners = heldPartnersNamed(refused, held: accepted, tests: tests)
		let blamed = namedCandidatePositions(refused, heldCount: accepted.count())
		var trial = accepted.clone()
		trial.append(candidates)

		if not blamed.isEmpty() 'someNamed'
			let rest = fileNamedRefusals(refusals, blamed: blamed, partners: partners, candidates: candidates, trial: trial, answer: answer, heldCount: accepted.count(), ordinal: ordinal, tests: tests)
			return latestTail(failure, later: self.settle(accepted, candidates: rest, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos))
		end 'someNamed'

		if candidates.count() == 1 'theCulprit'
			let culprit = try candidates.get(0) otherwise panic("BatchSettling.refuse: one candidate has a position 0")
			noteRefusal(refusals, testIndex: culprit.testIndex, diagnostics: diagnosticsInTestNames(answer.diagnostics.trim(), ordinal: ordinal, members: trial, tests: tests), partners: partners)
			return failure
		end 'theCulprit'

		let half = (candidates.count() / SplitInHalves) as ElementIndex
		let front = try candidates.slice(0, endIndex: half) otherwise panic("BatchSettling.refuse: the front half ends at {half}, within the {candidates.count()} candidates")
		let back = try candidates.slice(half, endIndex: candidates.count()) otherwise panic("BatchSettling.refuse: the back half starts at {half}, within the {candidates.count()} candidates")
		let frontTail = self.settle(accepted, candidates: front, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)
		let backTail = self.settle(accepted, candidates: back, refusals: refusals, tempDir: tempDir, ordinal: ordinal, tests: tests, exeExtension: exeExtension, effectiveTarget: effectiveTarget, fileMemos: fileMemos)

		return latestTail(failure, later: latestTail(frontTail, later: backTail))
	end 'refuse'
end 'BatchSettling'

function namedCandidatePositions(refused TestRunIndexArray, heldCount ElementIndex) returns TestRunIndexArray
	var named = TestRunIndexArray.create(0)

	for position in refused 'eachNamed'
		if position >= heldCount 'aCandidate'
			named.push(position - heldCount)
		end 'aCandidate'
	end 'eachNamed'

	return named
end 'namedCandidatePositions'

function heldPartnersNamed(refused TestRunIndexArray, held BatchMemberArray, tests SpecTestArray) returns StringArray
	var partners = StringArray.create(0)

	for position in refused 'eachNamed'
		if position < held.count() 'aHeldMember'
			let partner = try held.get(position) otherwise panic("SpecBatch: the batch compile named case {position}, past the {held.count()} members held")
			partners.push(testNameFor(partner, tests: tests))
		end 'aHeldMember'
	end 'eachNamed'

	return partners
end 'heldPartnersNamed'

function fileNamedRefusals(refusals BatchRefusalMap, blamed TestRunIndexArray, partners StringArray, candidates BatchMemberArray, trial BatchMemberArray, answer CompileAnswer, heldCount ElementIndex, ordinal ElementIndex, tests SpecTestArray) returns BatchMemberArray
	for position in blamed 'eachBlamed'
		let culprit = try candidates.get(position) otherwise panic("SpecBatch: blamed candidate {position} is past the {candidates.count()} candidates")
		var named = TestRunIndexArray.create(1, zeroed: false)
		named.push(position + heldCount)

		noteRefusal(refusals, testIndex: culprit.testIndex, diagnostics: diagnosticsInTestNames(diagnosticsNaming(answer.diagnostics, ordinal: ordinal, positions: named), ordinal: ordinal, members: trial, tests: tests), partners: partners)
	end 'eachBlamed'

	return membersWithout(candidates, positions: blamed)
end 'fileNamedRefusals'

function noteRefused(refusals BatchRefusalMap, answer CompileAnswer, ordinal ElementIndex, refused TestRunIndexArray, remaining BatchMemberArray, tests SpecTestArray) returns BatchMemberArray
	for position in refused 'eachRefused'
		let member = try remaining.get(position) otherwise panic("SpecBatch: the batch compile named case {position}, past the {remaining.count()} it was built from")
		var named = TestRunIndexArray.create(1, zeroed: false)
		named.push(position)
		noteRefusal(refusals, testIndex: member.testIndex, diagnostics: diagnosticsInTestNames(diagnosticsNaming(answer.diagnostics, ordinal: ordinal, positions: named), ordinal: ordinal, members: remaining, tests: tests), partners: StringArray.create(0))
	end 'eachRefused'

	return membersWithout(remaining, positions: refused)
end 'noteRefused'

// A target refusal (E3104) is not filed: the target merely cannot express the case, and its own run
// reports that as a skip.
function noteRefusal(refusals BatchRefusalMap, testIndex ElementIndex, diagnostics String, partners StringArray)
	match targetRefusalIn(CompileAnswer.create(CompileVerdict.reportedDiagnostics, diagnostics: diagnostics)) 'refusal'
		refused then return
		notRefused then refusals.upsert(testIndex, value: BatchRefusal.create(diagnostics, partners: partners))
	end 'refusal'
end 'noteRefusal'

function attemptRefusedNothing(attempt BatchBuild) returns bool
	return match attempt 'attempt'
		built gives false
		notBuilt(_, refused) gives refused.isEmpty()
		unbuildable gives true
	end 'attempt'
end 'attemptRefusedNothing'

type MarkedRegion
	export let index as ElementIndex
	export var body as String
	export var ended as bool
	export var code as ExitCodeValue
	export var outstanding as TestTally
	export var descendants as TestTally

	static function create(index ElementIndex, body String) returns MarkedRegion
		return Self{index: index, body: body, ended: false, code: 0, outstanding: 0, descendants: 0}
	end 'create'
end 'MarkedRegion'

typealias MarkedRegionArray = Array with MarkedRegion
typealias RegionPositionMap = Map with (ElementIndex, ElementIndex)

type MarkedStream
	export var regions as MarkedRegionArray
	export var clean as bool
	var firstBegunAt as RegionPositionMap
	var firstEndedAt as RegionPositionMap

	static function create() returns MarkedStream
		return Self{regions: MarkedRegionArray.create(0), clean: true, firstBegunAt: RegionPositionMap.create(), firstEndedAt: RegionPositionMap.create()}
	end 'create'

	function open(region MarkedRegion)
		if not self.firstBegunAt.contains(region.index) 'theFirstBegin'
			self.firstBegunAt.upsert(region.index, value: self.regions.count())
		end 'theFirstBegin'

		self.regions.push(region)
	end 'open'

	function noteLastEnded(index ElementIndex)
		if not self.firstEndedAt.contains(index) 'theFirstEnd'
			self.firstEndedAt.upsert(index, value: self.regions.count() - 1)
		end 'theFirstEnd'
	end 'noteLastEnded'

	function begunRegionFor(index ElementIndex) returns RegionLookup
		return self.regionAt(try self.firstBegunAt.get(index) otherwise return RegionLookup.absent)
	end 'begunRegionFor'

	function endedRegionFor(index ElementIndex) returns RegionLookup
		return self.regionAt(try self.firstEndedAt.get(index) otherwise return RegionLookup.absent)
	end 'endedRegionFor'

	function regionAt(position ElementIndex) returns RegionLookup
		return RegionLookup.found(try self.regions.get(position) otherwise panic("MarkedStream.regionAt: position {position} is past the {self.regions.count()} region(s) its index was taken from"))
	end 'regionAt'
end 'MarkedStream'

union MarkerField
	read(text String, rest String)
	unterminated
end 'MarkerField'

function markerFieldIn(text String) returns MarkerField
	let end_ = try text.findFirst(BatchFieldEnd) otherwise return MarkerField.unterminated
	let after = try text.indexAfter(end_) otherwise return MarkerField.unterminated
	return MarkerField.read(text.slice(text.startIndex(), endIndex: end_), rest: text.slice(after, endIndex: text.endIndex()))
end 'markerFieldIn'

function parseMarkedStream(text String) returns MarkedStream
	var stream = MarkedStream.create()
	let pieces = text.split(SpecMarkerWrapper)

	for (iter, piece) in pieces.withIterator() 'eachPiece'
		if iter.index() == 0 'beforeTheFirstMarker'
			if not piece.trim().isEmpty() 'strayText'
				stream.clean = false
			end 'strayText'

			continue
		end 'beforeTheFirstMarker'

		if piece.startsWith(BatchBeginTag) 'aBegin'
			noteBegin(stream, piece: piece)
			continue
		end 'aBegin'

		if piece.startsWith(BatchEndTag) 'anEnd'
			noteEnd(stream, piece: piece)
			continue
		end 'anEnd'

		if piece.startsWith(DescendantsFrameTag) 'aDescendantFrame'
			noteDescendantFrame(stream, piece: piece)
			continue
		end 'aDescendantFrame'

		stream.clean = false
	end 'eachPiece'

	return stream
end 'parseMarkedStream'

function noteDescendantFrame(stream MarkedStream, piece String)
	var region = try stream.regions.get(stream.regions.count() - 1) otherwise 'noOpenRegion'
		stream.clean = false
		return
	end 'noOpenRegion'

	region.body = "{region.body}{SpecMarkerWrapper}{piece}"
end 'noteDescendantFrame'

function noteBegin(stream MarkedStream, piece String)
	match markerFieldIn(afterFirstCharacter(piece)) 'index'
		unterminated then stream.clean = false
		read(digits, rest) then openRegion(stream, digits: digits, rest: rest)
	end 'index'
end 'noteBegin'

function openRegion(stream MarkedStream, digits String, rest String)
	match markedIndexOf(digits) 'index'
		unreadable then stream.clean = false
		read(index) then stream.open(MarkedRegion.create(index, body: afterFirstCharacter(rest)))
	end 'index'
end 'openRegion'

function noteEnd(stream MarkedStream, piece String)
	match markerFieldIn(afterFirstCharacter(piece)) 'index'
		unterminated then stream.clean = false
		read(digits, rest) then noteEndIndex(stream, digits: digits, rest: rest)
	end 'index'
end 'noteEnd'

function noteEndIndex(stream MarkedStream, digits String, rest String)
	match markedIndexOf(digits) 'index'
		unreadable then stream.clean = false
		read(index) then noteEndCode(stream, index: index, rest: rest)
	end 'index'
end 'noteEndIndex'

function noteEndCode(stream MarkedStream, index ElementIndex, rest String)
	match markerFieldIn(rest) 'code'
		unterminated then stream.clean = false
		read(digits, tail) then noteOutstanding(stream, index: index, code: digits, rest: tail)
	end 'code'
end 'noteEndCode'

function noteOutstanding(stream MarkedStream, index ElementIndex, code String, rest String)
	match markerFieldIn(rest) 'outstanding'
		unterminated then stream.clean = false
		read(digits, tail) then noteDescendantCount(stream, index: index, code: code, outstanding: digits, rest: tail)
	end 'outstanding'
end 'noteOutstanding'

function noteDescendantCount(stream MarkedStream, index ElementIndex, code String, outstanding String, rest String)
	match markerFieldIn(rest) 'descendants'
		unterminated then stream.clean = false
		read(digits, tail) then closeRegion(stream, index: index, code: code, outstanding: outstanding, descendants: digits, tail: tail)
	end 'descendants'
end 'noteDescendantCount'

function closeRegion(stream MarkedStream, index ElementIndex, code String, outstanding String, descendants String, tail String)
	var region = try stream.regions.get(stream.regions.count() - 1) otherwise 'noOpenRegion'
		stream.clean = false
		return
	end 'noOpenRegion'

	let exitCode = try int.fromString(code) otherwise 'unreadableCode'
		stream.clean = false
		return
	end 'unreadableCode'

	let left = try int.fromString(outstanding) otherwise 'unreadableOutstanding'
		stream.clean = false
		return
	end 'unreadableOutstanding'

	let leaked = try int.fromString(descendants) otherwise 'unreadableDescendants'
		stream.clean = false
		return
	end 'unreadableDescendants'

	if region.index != index or region.ended or exitCode < 0 or exitCode > u32.max or left < 0 or leaked < 0 'mismatched'
		stream.clean = false
		return
	end 'mismatched'

	region.ended = true
	region.code = exitCode as ExitCodeValue
	region.outstanding = left as TestTally
	region.descendants = leaked as TestTally
	stream.noteLastEnded(index)

	if not tail.trim().isEmpty() 'strayText'
		stream.clean = false
	end 'strayText'
end 'closeRegion'

function afterFirstCharacter(text String) returns String
	let past = try text.indexAfter(text.startIndex()) otherwise return ""
	return text.slice(past, endIndex: text.endIndex())
end 'afterFirstCharacter'

union MarkedIndex
	read(index ElementIndex)
	unreadable
end 'MarkedIndex'

function markedIndexOf(digits String) returns MarkedIndex
	let parsed = try int.fromString(digits) otherwise return MarkedIndex.unreadable

	if parsed < 0 'negative'
		return MarkedIndex.unreadable
	end 'negative'

	return MarkedIndex.read(parsed as ElementIndex)
end 'markedIndexOf'

union RegionLookup
	found(region MarkedRegion)
	absent
end 'RegionLookup'

module union BatchReading
	observed(capture ProcessCapture)
	unobserved
	failed(reason String)

	module function needsRerun() returns bool
		return match self 'reading'
			unobserved gives true
			observed or
			failed gives false
		end 'reading'
	end 'needsRerun'
end 'BatchReading'

module typealias BatchReadingArray = Array with readonly BatchReading

let OutsideTheMarkers = "the batch program printed outside the case markers — a case runs code before main that the batching checks did not catch; the runner must keep it out of batches"

module function readBatch(batch ProcessCapture, caseCount ElementIndex) returns BatchReadingArray
	var readings = BatchReadingArray.create(caseCount, zeroed: false)
	let unreadable = BatchReading.unobserved
	let process = batchProcessTrusted(batch)
	var stdout = parseMarkedStream(batch.stdout)
	var stderr = parseMarkedStream(batch.stderr)

	for index in 0 upto caseCount 'eachCase'
		if not process 'untrusted'
			readings.push(unreadable)
			continue
		end 'untrusted'

		if not stdout.clean or not stderr.clean 'outputOutsideTheMarkers'
			readings.push(BatchReading.failed(OutsideTheMarkers))
			continue
		end 'outputOutsideTheMarkers'

		if leftWorkRunning(stdout, index: index) or leftWorkRunning(stderr, index: index) 'leftWork'
			readings.push(unreadable)
			continue
		end 'leftWork'

		let reading = readingOf(stdout, stderr: stderr, index: index)
		readings.push(unreadable if reading.needsRerun() else reading)
	end 'eachCase'

	return readings
end 'readBatch'

module function unreadBatch(caseCount ElementIndex) returns BatchReadingArray
	var readings = BatchReadingArray.create(caseCount, zeroed: false)
	readings.refill(caseCount, value: BatchReading.unobserved)
	return readings
end 'unreadBatch'

function leftWorkRunning(stream MarkedStream, index ElementIndex) returns bool
	return match stream.endedRegionFor(index) 'region'
		found(region) gives region.outstanding != 0
		absent gives false
	end 'region'
end 'leftWorkRunning'

function batchProcessTrusted(batch ProcessCapture) returns bool
	return batch.exitCode == BatchSelectedExit
end 'batchProcessTrusted'

function readingOf(stdout MarkedStream, stderr MarkedStream, index ElementIndex) returns BatchReading
	match stdout.endedRegionFor(index) 'out'
		absent then return BatchReading.unobserved
		found(outRegion) then return readingFrom(outRegion, errLookup: stderr.endedRegionFor(index))
	end 'out'
end 'readingOf'

function readingFrom(out MarkedRegion, errLookup RegionLookup) returns BatchReading
	match errLookup 'err'
		absent then return BatchReading.unobserved
		found(errRegion) then return agreeingReading(out, err: errRegion)
	end 'err'
end 'readingFrom'

function agreeingReading(out MarkedRegion, err MarkedRegion) returns BatchReading
	if out.code != err.code or out.descendants != err.descendants 'disagree'
		return BatchReading.unobserved
	end 'disagree'

	let named = StderrAudit.separating(err.body).leaked.count() as TestTally

	if named != err.descendants 'unnamed'
		return BatchReading.failed("the batch program counted {err.descendants} process(es) left running by this case, and its error output names {named}")
	end 'unnamed'

	return BatchReading.observed(ProcessCapture.create(out.code, stdout: out.body, stderr: err.body))
end 'agreeingReading'

module function readAlone(observation RunObservation, caseIndex ElementIndex) returns RunObservation
	return match observation 'observed'
		completed(capture) gives readAloneCapture(capture, caseIndex: caseIndex)
		failed or
		notRequired or
		notRunnableHere gives observation
	end 'observed'
end 'readAlone'

function readAloneCapture(capture ProcessCapture, caseIndex ElementIndex) returns RunObservation
	var stdout = parseMarkedStream(capture.stdout)
	var stderr = parseMarkedStream(capture.stderr)

	if not entryBegan(stdout, stderr: stderr, index: caseIndex) 'diedBeforeTheEntry'
		return RunObservation.failed("the batch program died before case {caseIndex} began — a case runs code before main that failed, and the batching checks did not catch it; the runner must keep it out of batches")
	end 'diedBeforeTheEntry'

	if capture.exitCode != BatchSelectedExit 'theProcessSaidItDied'
		return RunObservation.completed(ProcessCapture.create(capture.exitCode, stdout: bodyOrWhole(stdout, index: caseIndex, whole: capture.stdout), stderr: bodyOrWhole(stderr, index: caseIndex, whole: capture.stderr)))
	end 'theProcessSaidItDied'

	if not stdout.clean or not stderr.clean 'outputOutsideTheMarkers'
		return RunObservation.failed(OutsideTheMarkers)
	end 'outputOutsideTheMarkers'

	match readingOf(stdout, stderr: stderr, index: caseIndex) 'reading'
		observed(own) then return RunObservation.completed(own)
		unobserved then return RunObservation.failed("the batch program ran case {caseIndex} alone and exited {BatchSelectedExit}, but never said the case finished")
		failed(reason) then return RunObservation.failed(reason)
	end 'reading'
end 'readAloneCapture'

function entryBegan(stdout MarkedStream, stderr MarkedStream, index ElementIndex) returns bool
	return regionBegan(stdout, index: index) or regionBegan(stderr, index: index)
end 'entryBegan'

function regionBegan(stream MarkedStream, index ElementIndex) returns bool
	return match stream.begunRegionFor(index) 'region'
		found gives true
		absent gives false
	end 'region'
end 'regionBegan'

function bodyOrWhole(stream MarkedStream, index ElementIndex, whole String) returns String
	return match stream.begunRegionFor(index) 'region'
		found(region) gives region.body
		absent gives whole
	end 'region'
end 'bodyOrWhole'

export type BatchTally
	export let batched as TestTally
	export let programs as TestTally
	export let alone as TestTally

	export static function create(batched TestTally, programs TestTally, alone TestTally) returns BatchTally
		return Self{batched: batched, programs: programs, alone: alone}
	end 'create'

	export static function zero() returns BatchTally
		return Self{batched: 0, programs: 0, alone: 0}
	end 'zero'

	export function plus(other BatchTally) returns BatchTally
		return Self{batched: self.batched + other.batched, programs: self.programs + other.programs, alone: self.alone + other.alone}
	end 'plus'

	export function summaryLine() returns String
		return "{batched} run case(s) ran batched in {programs} program(s); {alone} ran alone"
	end 'summaryLine'
end 'BatchTally'
