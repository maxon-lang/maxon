// A list of run indices — what a `--select=` value is rendered from, and what one process launch is
// asked to run. Its own alias because the ORDER is the run's declaration order rather than an
// incidental one: it is what the report reads back, index for index.
export typealias TestRunIndexArray = Array with ElementIndex

// ⭐ **THE OPTION THE BINARY READS ITS SELECTION FROM. SELECTION IS A RUNTIME ARGUMENT, NEVER A
// COMPILE-TIME ONE:** every discovered test is compiled in every time, which is what lets a `--filter`
// change leave the build cache warm and keeps the thing being tested identical to the thing that was
// compiled.
let TestSelectOptionName = "select"

// The selection meaning "every test", used when the option is ABSENT — which is what a human running the
// binary by hand gets.
//
// ⚠ **IT IS A DISTINCT TOKEN RATHER THAN THE EMPTY STRING BECAUSE THE RUNNER MUST BE ABLE TO SELECT
// NOTHING.** With absence and emptiness collapsed, a shard whose filter matched none of its tests would
// run all of them.
let TestSelectAll = "*"

// Delimiter around each index in a selection, so a membership test is a plain substring search: `"|3|"`
// matches 3 and never 13 or 31. The generated dispatcher composes its needle from this constant directly,
// so the brackets it searches with are the brackets the runner writes.
let TestSelectIndexBracket = "|"

// ⭐ **THE SELECTION OPTION AS IT APPEARS IN argv.** Composed from `TestSelectOptionName` — the very
// name the generated binary passes to `CommandLine.getOptionValue` — so the flag the runner writes and
// the name the binary reads can never become two strings.
//
// A FUNCTION rather than a module `let`, because it INTERPOLATES: a top-level constant that allocates
// a String would run its initializer outside any test's ownership, which is why every other constant in
// this file is a literal (the shape `SpecTestRunner.wslProbeScript` already has).
export function testSelectFlag() returns String
	return "--{TestSelectOptionName}="
end 'testSelectFlag'

// ⭐⭐ **RENDER A SET OF RUN INDICES AS THE VALUE OF `--select=`** — the WRITER of the needle the
// generated dispatcher searches for, composed from the same `TestSelectIndexBracket` it brackets its
// search with. A selection that named test 3 and matched 13 would be exactly those two disagreeing.
//
// ⚠ **AN EMPTY LIST PRODUCES AN EMPTY VALUE, WHICH SELECTS NOTHING** — deliberately distinct from
// `TestSelectAll`. See that constant: with absence and emptiness collapsed, a shard whose filter
// matched none of its tests would run all of them.
export function formatTestSelection(indices TestRunIndexArray) returns String
	var value = ""

	for index in indices 'eachIndex'
		if value.isEmpty() 'openTheFirstBracket'
			value.append(TestSelectIndexBracket)
		end 'openTheFirstBracket'

		value.append("{index}{TestSelectIndexBracket}")
	end 'eachIndex'

	return value
end 'formatTestSelection'

module function soleIndex(index ElementIndex) returns TestRunIndexArray
	var only = TestRunIndexArray.create()
	only.push(index)
	return only
end 'soleIndex'

module function selectionMembersSource(indexAlias String) returns String
	let selectionNeedle = "{TestSelectIndexBracket}\{index\}{TestSelectIndexBracket}"

	var source = "\t// The run's selection, read once. ABSENT means every one — what a human running this\n"
	source.append("\t// binary by hand gets — and is a DIFFERENT setting from an EMPTY selection, which selects\n")
	source.append("\t// nothing.\n")
	source.append("\texport static function selection() returns String\n")
	source.append("\t\treturn try CommandLine.getOptionValue(\"{TestSelectOptionName}\") otherwise \"{TestSelectAll}\"\n")
	source.append("\tend 'selection'\n\n")

	source.append("\texport static function selected(selection String, index {indexAlias}) returns bool\n")
	source.append("\t\tif selection == \"{TestSelectAll}\" 'all'\n")
	source.append("\t\t\treturn true\n")
	source.append("\t\tend 'all'\n\n")
	source.append("\t\treturn selection.contains(\"{selectionNeedle}\")\n")
	source.append("\tend 'selected'\n\n")
	return source
end 'selectionMembersSource'

module union SelectedLaunch
	ran(exitCode ExitCodeValue, stdout String, stderr String)
	deadlineExpired(stdout String, stderr String)
	couldNotStart(reason String)
end 'SelectedLaunch'

module function launchSelected(exe Executable, leadingArguments StringArray, indices TestRunIndexArray, timeoutMs DurationMs, workingDirectory FilePath) returns SelectedLaunch
	var argv = leadingArguments.clone()
	argv.push("{testSelectFlag()}{formatTestSelection(indices)}")

	let run = try runProcess(exe, argv: argv, workingDirectory: workingDirectory, timeoutMs: timeoutMs) otherwise (e) 'didNotRun'
		return launchFailureOf(e)
	end 'didNotRun'

	return SelectedLaunch.ran(run.exitCode, stdout: run.stdout, stderr: run.stderr)
end 'launchSelected'

function launchFailureOf(error SubprocessError) returns SelectedLaunch
	return match error 'why'
		timeout(_, stdout, stderr) gives SelectedLaunch.deadlineExpired(stdout, stderr: stderr)
		executableNotFound or
			spawnFailed or
			ioFailed or
			inputTooLarge or
			endOfStream gives SelectedLaunch.couldNotStart(error.displayReason())
	end 'why'
end 'launchFailureOf'

module type GeneratedBuild
	export let root as FilePath
	export var buildTargets as MaxonSourcePathArray
	export var compilerWrittenSources as CompilerWrittenSourceArray
	export var stagedSourceOrigins as StagedSourceOriginArray

	module static function begin(stagingRoot FilePath) returns GeneratedBuild throws TestStagingError
		if not Directory.create(stagingRoot) 'noStagingRoot'
			throw TestStagingError.refused("could not create the staging directory {stagingRoot.toString()}")
		end 'noStagingRoot'

		purgeFilesIn(stagingRoot)
		return Self{root: stagingRoot, buildTargets: MaxonSourcePathArray.create(), compilerWrittenSources: CompilerWrittenSourceArray.create(), stagedSourceOrigins: StagedSourceOriginArray.create()}
	end 'begin'

	module function addSource(stagedPath FilePath, content String, mintedNames ByteArrayArray) throws TestStagingError
		try writeStagedFile(stagedPath, content: content)
		self.buildTargets.push(stagedPath)

		if not mintedNames.isEmpty() 'generated'
			self.compilerWrittenSources.push(CompilerWrittenSource.create(stagedPath, mintedNames: mintedNames))
		end 'generated'
	end 'addSource'

	module function recordOrigin(origin StagedSourceOrigin)
		self.stagedSourceOrigins.push(origin)
	end 'recordOrigin'

	// LAST, so every file is registered before the walk reaches it and the walk finds nothing new —
	// the directory is here to fix the project ROOT, not to contribute a unit.
	module function fixRoot()
		self.buildTargets.push(self.root)
	end 'fixRoot'
end 'GeneratedBuild'

// Both failures are refusals rather than panics: a staging root the process cannot write is an
// environment problem the caller reports.
function writeStagedFile(path FilePath, content String) throws TestStagingError
	let parent = try path.parent() otherwise throw TestStagingError.refused("could not derive a directory for {path.toString()}")

	if not Directory.create(parent) 'noSubdir'
		throw TestStagingError.refused("could not create the directory {parent.toString()}")
	end 'noSubdir'

	try File.writeText(path, content: content) otherwise throw TestStagingError.refused("could not write {path.toString()}")
end 'writeStagedFile'
