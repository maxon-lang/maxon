// Testing/IndentedReport.maxon — the ONE indented list every self-check's report is assembled from.
//
// ⚠ **`panic` TAKES A STRING LITERAL** — a `let`-bound String is rejected outright — so a gate that
// found SEVERAL problems cannot hand a builder to `panic`. It has to render the list as text and
// INTERPOLATE it into the literal, which is why every check in this directory that reports all its
// failures together ends the same way.
//
// ⭐ **AND EACH OF THEM HAD WRITTEN THE LOOP ITSELF.** `LadderIndex.nameListClause`,
// `HarnessSelfTest.brokenRefusalReport`, `ScaleHistory.cellDifferenceReport` and
// `ScaleHistorySelfTest`'s two lists were four copies of one four-line builder, in four files, each of
// them file-private, with nothing that would make them agree — this project's signature bug wearing the
// costume of a formatting detail. They agreed today; a change to how a list is rendered would have
// reached one of them and read as deliberate at the other three.
//
// THE INDENT STAYS THE CALLER'S, and that is not an escape hatch. How deep a list sits is a property of
// the SENTENCE that introduces it — a fixture under a headline, a missing expectation under the fixture
// that is missing it, a differing cell under the row it was read from — and folding those depths in here
// would be one constant standing for three different nestings.
export function indentedList(items StringArray, indent String) returns String
	var out = StringBuilder.create()
	for item in items 'eachItem'
		out.append("{indent}{item}")
	end 'eachItem'
	return out.build()
end 'indentedList'

// ============================================================================================
// THE PER-RESULT TRAILER — one note, one shape, every caller that has cases to name
// ============================================================================================
//
// ⭐ **SEVERAL TRAILERS SAY "HERE ARE THE N CASES THIS RUN HAS SOMETHING TO SAY ABOUT", AND THEY PRINT
// ONE UNDER THE OTHER IN THE SAME RUN** — the target skips, the network exclusions, the golden drift and
// the orphan census. They are not listed by name: a roster here is one more thing to keep true, and a
// caller that stopped using this would not remove itself from it. A reader takes
// the blocks as one column, so their entry shape and their nesting depth are ONE FACT — written here
// once, rather than as a bare `"  "` in one file against a named constant in another.

// How deep one CASE sits under the sentence that introduces it. Distinct from the depths a caller nests
// BELOW it (a compiler diagnostic under the case it refused, say) — those stay the caller's, for the
// reason `indentedList` states.
export let ResultNoteIndent = "  "

// One case's entry: its `<spec>/<test>` label, then whatever the caller has to say about it on the lines
// under it. `detail` is emitted VERBATIM, so a caller whose block does not already end in a newline
// appends one — this cannot add it for them without deciding for `indentedRefusals`, which does.
export function resultNoteEntry(specName String, testName String, detail String) returns String
	return "{ResultNoteIndent}{specName}/{testName}\n{detail}"
end 'resultNoteEntry'

// The note itself, on STDERR — stdout is the REPORT (the per-test verdicts and the `N passed, M failed`
// line) and must stay byte-identical across worker counts, while an indicator sits beside it.
//
// ⚠ **SILENT AT ZERO, AND THAT IS WHY IT TAKES THE HEADLINE ALREADY BUILT.** "No note" means none, at
// every call site rather than at whichever one remembered to write the guard — and every such headline
// states the COUNT, which cannot be known until the last result has been read. So the caller collects,
// then interpolates, then hands both here.
export function reportResultNote(entries StringArray, headline String)
	if entries.isEmpty() 'nothingToSay'
		return
	end 'nothingToSay'

	printError(headline)

	for entry in entries 'eachEntry'
		printError(entry)
	end 'eachEntry'
end 'reportResultNote'
