// TestCommand — the `maxon test` command: discover every `test` declaration in a project, or in one
// `.maxtest` file run alone, compile them into ONE binary with a generated entry point, run it, and
// report. `maxon lint --tests` compiles the same program here and stops before code generation.
//
// ⭐ **THIS FILE SEQUENCES; IT BUILDS NOTHING.** Discovery is `TestDiscovery`, generation and staging
// are `TestDispatcher`, execution is `TestExecutor`, and both faces of the report are `TestRender`. What
// lives here is the command line, where the staged tree goes, and the exit code.
//
// ⛔ A test run takes no tree lock, and that is a requirement. Under `Main.acquireBuildTreeLock`'s
// rule a project build with no `--output=`, inside a checkout with a `stdlib/` above it, locks the
// whole checkout, and every case under `tests/test-fixtures/` is such a build, spawned from a
// `test` that is itself running inside one (`tests/testCommand/`); each would come back as exit 2
// with an empty stdout. This command never goes through `runBuild`: it calls
// `Compiler.compileToProduct` directly, which locks nothing, and it names its own output.

// The command's own name — the word every message in this file uses for what failed, and the token
// `MaxonArgs.parse` matches. One spelling, so a renamed command cannot keep announcing the old one.
//
// ⚠ **`export`, AND THE READER IS THE REASON.** `Main.MaxonArgs.parse` matches this
// token, and `maxon-bin/` is this file's PARENT rather than its subtree — an unmarked `let` is readable in
// its declaring directory and below it and nowhere else (`specs/directory-scope.md`). Unmarked, this is
// refused with E2004 at the reader's line, so the only gate that sees it is the SELF-COMPILE.
export let TestCommandName = "test"

// ============================================================================================
// WHERE A TEST BUILD LIVES
// ============================================================================================
//
// ⭐⭐ **`<project>/.maxon/test/`, AND EVERY PART OF THAT IS A DECISION.** A file run alone builds in
// `<its directory>/.maxon/test/<file name>/`, so two files in one directory never purge each other's
// staged tree; they share the `.maxonignore` above it.
//
// · **Not `temp/`.** `temp/` is shared scratch that other runs clean out recursively, so a test binary
//   parked there can vanish underneath a run that is still spawning it.
// · **Not the project's source tree.** `Compiler.collectMaxonSources` prunes on `.maxonignore` and on
//   nothing else, so a generated `.maxon` anywhere under the project would be swept into the user's
//   very next ordinary build — and, worse, into the NEXT `maxon test` run's own discovery, which would
//   then report every test twice.
// · **`.maxon/` because that is where this tree already keeps build products** (it is gitignored by
//   `**/.maxon/`), and per-PROJECT because two projects sharing a staging root cannot run at once.
// · **With a `.maxonignore` at its root**, written before anything is staged, which is what makes the
//   second bullet false by construction rather than by hope.
// · **`maxon lint --tests` stages under `.maxon/lint/` instead**, so a lint never purges or rewrites
//   the tree a concurrent `maxon test` is compiling.
let TestBuildDirName = "test"
let LintBuildDirName = "lint"
let StagedTreeDirName = "staged"
let TestBinaryStem = "maxon-test"
let TestPositionalBudget = TestSubjectAfterTargetIndex + 1

enum StagingPurpose
	running
	linting

	function directoryName() returns String
		return match self 'purpose'
			running gives TestBuildDirName
			linting gives LintBuildDirName
		end 'purpose'
	end 'directoryName'

	function commandWords() returns String
		return match self 'purpose'
			running gives TestCommandName
			linting gives "{LintCommandName} {LintTestsFlag}"
		end 'purpose'
	end 'commandWords'

	function productClause() returns String
		return match self 'purpose'
			running gives ", plus the binary built from it"
			linting gives "; no binary is built from it"
		end 'purpose'
	end 'productClause'

	// ⚠ **THE MARKER IS A FLAG AND ITS CONTENTS ARE NEVER READ** (`Compiler.holdsIgnoreMarker` is a bare
	// `File.exists`), so this text is for the person who finds the directory and wonders what it is.
	function markerText() returns String
		return "Generated by `maxon {self.commandWords()}`. Everything under here is a COPY of the sources under test, a project or one test file, with a test dispatcher appended{self.productClause()}. Nothing here is yours to edit, and this marker is what keeps it out of your own builds.\n"
	end 'markerText'
end 'StagingPurpose'

// The usage line a refusal prints under itself.
function testUsageLine() returns String
	return "maxon {TestCommandName} [target] [<directory> | <file{TestSourceExtension}>] [{FilterFlagPrefix}PATTERN]... [{TestListFlag} [{TestBuildFlag}]] [--json] [options]"
end 'testUsageLine'

// ============================================================================================
// THE COMMAND
// ============================================================================================

export function runTest(args MaxonArgs) returns ExitCode
	if refusedPositionalBeyond(args, allowed: TestPositionalBudget, usage: testUsageLine()) 'tooManyPaths'
		return NothingRanExitCode
	end 'tooManyPaths'

	let voice = ManifestVoice.forCommandLine(TestCommandName, announce: false, logOverridden: args.logOverridden)

	let place = try testPlace(args, voice: voice) otherwise (e) 'badSubject'
		return refuseTestRun(subjectRefusalReason(e))
	end 'badSubject'

	if args.buildTestBinary and not args.listOnly 'buildWithoutAList'
		return refuseTestRun("{TestBuildFlag} builds the test binary for {TestListFlag} and runs nothing, so it is given with {TestListFlag}")
	end 'buildWithoutAList'

	let target = try commandLineTarget(args.targetSpec) otherwise return NothingRanExitCode

	let patterns = try filterPatterns(args.filterPatterns) otherwise (e) 'emptyFilterValue'
		return refuseTestRun(filterValueRefusalReason(e))
	end 'emptyFilterValue'

	let compiled = try testsToCompile(place, target: target, voice: voice, logOverridden: args.logOverridden) otherwise (e) 'notCompilable'
		return testRunRefusedBy(e, voice: voice)
	end 'notCompilable'

	let subject = compiled.subject
	let tests = compiled.tests
	let groups = compiled.groups
	let color = reportColorEnabled(args.colorMode)
	let filtered = selectionFor(groups, total: tests.count() as ReportedTestCount, patterns: patterns)
	let selected = filtered.selected

	if args.listOnly 'listOnly'
		return listSelectedTests(args, subject: subject, target: target, groups: groups, selected: selected, color: color)
	end 'listOnly'

	if tests.isEmpty() 'noTestsAtAll'
		return reportNothingToRun(noTestsFoundReason(subject), args: args, color: color)
	end 'noTestsAtAll'

	if filtered.unmatchedPatterns.count() > 0 'filterMatchedNothing'
		return reportNothingToRun("no test matched {quotedPatterns(filtered.unmatchedPatterns)}", args: args, color: color)
	end 'filterMatchedNothing'

	// Under `--json` stdout carries exactly one JSON document, so the report goes to stderr.
	if refusedByVersionRecord(subject, onto: ReportStream.standardError if args.jsonReport else ReportStream.standardOutput) 'refusedRecord'
		return NothingRanExitCode
	end 'refusedRecord'

	let exit = compileAndRunTests(args, subject: subject, target: target, groups: groups, selected: selected, color: color)

	if exitSucceeded(exit) 'allPassed'
		recordProjectRelease(subject)
	end 'allPassed'

	return exit
end 'runTest'

function refusedByVersionRecord(subject TestSubject, onto ReportStream) returns bool
	return match subject 'where'
		projectDirectory(dir, _) gives reportBreakingChanges(dir, onto: onto) == VersionRecordVerdict.refused
		singleFile gives false
	end 'where'
end 'refusedByVersionRecord'

function recordProjectRelease(subject TestSubject)
	match subject 'where'
		projectDirectory(dir, _) then recordCompilerRelease(dir)
		singleFile then return
	end 'where'
end 'recordProjectRelease'

export function lintedTests(args MaxonArgs, target Target, voice ManifestVoice) returns ExitCode
	if refusedPositionalBeyond(args, allowed: TestPositionalBudget, usage: lintUsageLine()) 'tooManyPaths'
		return OwnFailureExit
	end 'tooManyPaths'

	let place = try testPlace(args, voice: voice) otherwise (e) 'badSubject'
		return refusedLint(subjectRefusalReason(e))
	end 'badSubject'

	let compiled = try testsToCompile(place, target: target, voice: voice, logOverridden: args.logOverridden) otherwise (e) 'notCompilable'
		return lintRefusedBy(e, voice: voice)
	end 'notCompilable'

	if compiled.tests.isEmpty() 'noTestsAtAll'
		return refusedLint(noTestsFoundReason(compiled.subject))
	end 'noTestsAtAll'

	if refusedByVersionRecord(compiled.subject, onto: ReportStream.standardError) 'refusedRecord'
		return OwnFailureExit
	end 'refusedRecord'

	let prepared = try preparedTestBuild(compiled.subject, target: target, groups: compiled.groups, purpose: StagingPurpose.linting) otherwise (e) 'stagingRefused'
		return refusedLint(stagingRefusalReason(e))
	end 'stagingRefused'

	let session = DriverSession.printing()
	let request = stagedTestRequest(DriverWork.lint, staged: prepared.staged, target: target, session: session, outputOverride: StatedText.unstated, debugInfo: false, metrics: args.metrics)

	return lintedRequest(request, session: session, subjects: place.typedSubjects())
end 'lintedTests'

type TestsToCompile
	let subject as TestSubject
	let tests as DiscoveredTestArray
	let groups as TestFileGroupArray

	static function create(subject TestSubject, tests DiscoveredTestArray, groups TestFileGroupArray) returns TestsToCompile
		return Self{subject: subject, tests: tests, groups: groups}
	end 'create'
end 'TestsToCompile'

union TestsRefusal implements Error
	unresolved(cause SubjectNotResolved)
	undiscoverable(error CompileError)
	ungroupable(error TestStagingError)
end 'TestsRefusal'

function testsToCompile(place TestPlace, target Target, voice ManifestVoice, logOverridden bool) returns TestsToCompile throws TestsRefusal
	let subject = try subjectAt(place, voice: voice) otherwise (e) 'sourcesRefused'
		throw TestsRefusal.unresolved(e)
	end 'sourcesRefused'

	_ = quietTheBuildChatter(logOverridden)

	let tests = try discoverTests(testSubjectInputs(subject), target: target) otherwise (e) 'discoveryFailed'
		throw TestsRefusal.undiscoverable(e)
	end 'discoveryFailed'

	let groups = try groupTestsByFile(tests) otherwise (e) 'groupingRefused'
		throw TestsRefusal.ungroupable(e)
	end 'groupingRefused'

	return TestsToCompile.create(subject, tests: tests, groups: groups)
end 'testsToCompile'

function testRunRefusedBy(refusal TestsRefusal, voice ManifestVoice) returns ExitCode
	match refusal 'why'
		unresolved(cause) then reportedNotResolved(cause, voice: voice)
		undiscoverable(error) then reportCompileError(error)
		ungroupable(error) then return refuseTestRun(stagingRefusalReason(error))
	end 'why'

	return NothingRanExitCode
end 'testRunRefusedBy'

function lintRefusedBy(refusal TestsRefusal, voice ManifestVoice) returns ExitCode
	match refusal 'why'
		unresolved(cause) then return lintExitAfterReporting(cause, voice: voice)
		undiscoverable(error) then reportCompileError(error)
		ungroupable(error) then return refusedLint(stagingRefusalReason(error))
	end 'why'

	return OwnFailureExit
end 'lintRefusedBy'

function lintExitAfterReporting(cause SubjectNotResolved, voice ManifestVoice) returns ExitCode
	reportedNotResolved(cause, voice: voice)

	return match cause 'why'
		notResolved(code) gives code
		severalTargets gives OwnFailureExit
	end 'why'
end 'lintExitAfterReporting'

union TestSubjectRefusal implements Error
	notAPath(spelled String)
	missing(path FilePath)
	notATestFile(path FilePath)
	targetForAFile(word String, path FilePath)
	unreadTargets(word String)
end 'TestSubjectRefusal'

union TestLocation
	projectDirectory(dir FilePath)
	singleFile(path FilePath)
end 'TestLocation'

union SubjectNotResolved implements Error
	notResolved(code ExitCode)
	severalTargets(projectFile FilePath, targets TaskNameArray)
end 'SubjectNotResolved'

function reportedNotResolved(refusal SubjectNotResolved, voice ManifestVoice)
	match refusal 'why'
		notResolved then return
		severalTargets(projectFile, targets) then reportSeveralTargets(projectFile, targets: targets, voice: voice)
	end 'why'
end 'reportedNotResolved'

type TestPlace
	export let location as TestLocation
	export let target as StatedText
	let loneTarget as StatedText

	static function create(location TestLocation, target StatedText) returns TestPlace
		return Self{location: location, target: target, loneTarget: StatedText.unstated}
	end 'create'

	static function ofTargetHere(word String) returns TestPlace
		return Self{location: TestLocation.projectDirectory(Directory.currentPath()), target: StatedText.stated(word), loneTarget: StatedText.stated(word)}
	end 'ofTargetHere'

	function typedPath() returns FilePath
		return match self.location 'location'
			projectDirectory(dir) gives dir
			singleFile(path) gives path
		end 'location'
	end 'typedPath'

	function typedSubjects() returns String
		return match self.loneTarget 'loneTarget'
			stated(word) gives word
			unstated gives lintedSubjects(MaxonSourcePathArray from [self.typedPath()])
		end 'loneTarget'
	end 'typedSubjects'
end 'TestPlace'

function subjectAt(place TestPlace, voice ManifestVoice) returns TestSubject throws SubjectNotResolved
	match place.location 'location'
		projectDirectory(dir) then return try projectSubject(dir, target: place.target, voice: voice)
		singleFile(path) then return TestSubject.singleFile(path)
	end 'location'
end 'subjectAt'

function projectSubject(dir FilePath, target StatedText, voice ManifestVoice) returns TestSubject throws SubjectNotResolved
	match projectInputs(dir, word: target, severalTargets: SeveralTargets.refuse, voice: voice) 'inputs'
		walked then return TestSubject.projectDirectory(dir, sources: MaxonSourcePathArray from [dir])
		listed(paths, _) then return TestSubject.projectDirectory(dir, sources: paths)
		ambiguous(projectFile, targets) then throw SubjectNotResolved.severalTargets(projectFile, targets: targets)
		unbuilt then throw SubjectNotResolved.notResolved(OwnFailureExit)
		refused(code) then throw SubjectNotResolved.notResolved(code)
	end 'inputs'
end 'projectSubject'

let TestTargetWordIndex = 0
let TestSubjectAfterTargetIndex = 1

function testPlace(args MaxonArgs, voice ManifestVoice) returns TestPlace throws TestSubjectRefusal
	let place = try placeNamedBy(args, voice: voice)

	match place.location 'location'
		singleFile(path) then try requireNoTargetFor(path, target: place.target)
		projectDirectory then return place
	end 'location'

	return place
end 'testPlace'

function requireNoTargetFor(path FilePath, target StatedText) throws TestSubjectRefusal
	match target 'target'
		stated(word) then throw TestSubjectRefusal.targetForAFile(word, path: path)
		unstated then return
	end 'target'
end 'requireNoTargetFor'

function placeNamedBy(args MaxonArgs, voice ManifestVoice) returns TestPlace throws TestSubjectRefusal
	if args.paths.count() == TestPositionalBudget 'targetAndSubject'
		let word = try args.positionalAt(TestTargetWordIndex) otherwise panic("placeNamedBy: two positional words were counted")
		let spelled = try args.positionalAt(TestSubjectAfterTargetIndex) otherwise panic("placeNamedBy: two positional words were counted")

		return TestPlace.create(try testLocation(spelled), target: StatedText.stated(word))
	end 'targetAndSubject'

	let spelled = try args.positionalAt(SolePositionalIndex) otherwise return TestPlace.create(TestLocation.projectDirectory(Directory.currentPath()), target: StatedText.unstated)

	match readingOfWord(Directory.currentPath(), word: spelled, voice: voice) 'reading'
		aTarget then return TestPlace.ofTargetHere(spelled)
		aPath then return TestPlace.create(try testLocation(spelled), target: StatedText.unstated)
		refused then throw TestSubjectRefusal.unreadTargets(spelled)
	end 'reading'
end 'placeNamedBy'

function testLocation(spelled String) returns TestLocation throws TestSubjectRefusal
	let path = try FilePath.from(spelled) otherwise throw TestSubjectRefusal.notAPath(spelled)

	if Directory.isDirectory(path) 'aProject'
		return TestLocation.projectDirectory(path)
	end 'aProject'

	if not File.exists(path) 'nothingThere'
		throw TestSubjectRefusal.missing(path)
	end 'nothingThere'

	if not isTestSourceName(path.filename()) 'notATestFile'
		throw TestSubjectRefusal.notATestFile(path)
	end 'notATestFile'

	return TestLocation.singleFile(path)
end 'testLocation'

function subjectRefusalReason(error TestSubjectRefusal) returns String
	return match error 'reason'
		notAPath(spelled) gives "'{spelled}' is not a valid path"
		missing(path) gives "no such directory or `{TestSourceExtension}` file: {reportPathDisplay(path)}"
		notATestFile(path) gives "not a directory or a `{TestSourceExtension}` file: {reportPathDisplay(path)}"
		targetForAFile(word, path) gives "'{word}' names a target of a project, and {reportPathDisplay(path)} is a `{TestSourceExtension}` file, which no target holds"
		unreadTargets(word) gives "the targets of the `{ProjectFileExtension}` file here could not be read, so `{word}` could not be told apart from a path"
	end 'reason'
end 'subjectRefusalReason'

function noTestsFoundReason(subject TestSubject) returns String
	return match subject 'where'
		projectDirectory(dir, _) gives "no `test` declarations found under {reportPathDisplay(dir)}"
		singleFile(path) gives "no `test` declarations found in {reportPathDisplay(path)}"
	end 'where'
end 'noTestsFoundReason'

// The reason a staging refusal carries. A `match` rather than a field read because `TestStagingError` is
// a union, and a second arm added there must be answered here rather than silently rendered as the first.
function stagingRefusalReason(error TestStagingError) returns String
	return match error 'reason'
		refused(text) gives text
	end 'reason'
end 'stagingRefusalReason'

// ⭐ **A COMMAND-LINE REFUSAL SPEAKS IN THIS COMMAND'S VOICE AND EXITS 2.** 2 is "the run could not
// happen", which CI must be able to tell from 1 ("the code is broken") — see `Main.NothingRanExitCode`,
// where this driver's exit codes are decided.
function refuseTestRun(problem String) returns ExitCode
	printError("{TestCommandName}: {problem}\n")
	printError("Usage: {testUsageLine()}\n")
	return NothingRanExitCode
end 'refuseTestRun'

// ============================================================================================
// SELECTION
// ============================================================================================

// Separates the parts of a comma-separated filter, each of which is matched on its own.
let FilterPatternSeparator = ","

union FilterValueError implements Error
	namesNoPattern(value String)
end 'FilterValueError'

type FilteredSelection
	export let selected as TestSelection
	export let unmatchedPatterns as FilterPatternArray

	static function create(selected TestSelection, unmatchedPatterns FilterPatternArray) returns FilteredSelection
		return Self{selected: selected, unmatchedPatterns: unmatchedPatterns}
	end 'create'
end 'FilteredSelection'

// No pattern keeps every discovered test. A pattern matches a test when it is a substring of the test's
// name or of its file's displayed path, so `--filter=math` finds both a file called math and a test
// about maths. Patterns union, whether from repeated flags or commas. Matching is case-insensitive
// because these are prose names retyped off a report, and a refusal quotes the caller's own spelling.
//
// Selection is a runtime argument, never a compile-time one: every discovered test is compiled in and
// `--select=` picks which of them run, so a filter can change between runs without changing the thing
// being tested.
function selectionFor(groups TestFileGroupArray, total ReportedTestCount, patterns FilterPatternArray) returns FilteredSelection
	let keys = FilterPatternArray.create(patterns.count(), zeroed: false)

	for pattern in patterns 'eachPattern'
		keys.push(pattern.toLower())
	end 'eachPattern'

	let tally = FilterPatternTally.create(keys, spellings: patterns)

	// One slot per DISCOVERED test, indexed by run index — see `TestSelection`.
	let selected = TestSelection.create(total as ElementIndex)

	for group in groups 'eachFile'
		// Lowered ONCE per file: it is the same haystack for every test the file declares.
		let loweredPath = reportPathDisplay(group.file).toLower()

		for member in group.tests 'eachTest'
			if tally.filters() 'filtered'
				let loweredName = member.test.displayName.toLower()

				if not admitsTestNamed(tally, loweredName: loweredName, loweredPath: loweredPath) 'filteredOut'
					continue
				end 'filteredOut'

				tally.credit()
			end 'filtered'

			try selected.set(member.index, value: true) otherwise panic("selectionFor: run index {member.index} is outside the {total} slots minted for it — the slots are one per discovered test and the groups partition exactly those tests")
		end 'eachTest'
	end 'eachFile'

	return FilteredSelection.create(selected, unmatchedPatterns: tally.unmatched())
end 'selectionFor'

function admitsTestNamed(tally FilterPatternTally, loweredName String, loweredPath String) returns bool
	return tally.admits(function(pattern) gives loweredName.contains(pattern) or loweredPath.contains(pattern))
end 'admitsTestNamed'

// A value naming no pattern (`--filter=,`) is refused: it would otherwise add nothing to the union,
// and as the only value it would keep every test.
function filterPatterns(filterValues FilterPatternArray) returns FilterPatternArray throws FilterValueError
	let patterns = FilterPatternArray.create(0)

	for value in filterValues 'eachValue'
		var named = false

		for part in value.split(FilterPatternSeparator) 'eachPattern'
			let trimmed = part.trim()

			if trimmed.isEmpty() 'namesNothing'
				continue
			end 'namesNothing'

			patterns.push(trimmed)
			named = true
		end 'eachPattern'

		if not named 'noPatternInValue'
			throw FilterValueError.namesNoPattern(value)
		end 'noPatternInValue'
	end 'eachValue'

	return patterns
end 'filterPatterns'

function filterValueRefusalReason(error FilterValueError) returns String
	return match error 'reason'
		namesNoPattern(value) gives "`{FilterFlagPrefix}{value}` names no pattern"
	end 'reason'
end 'filterValueRefusalReason'

function quotedPatterns(patterns FilterPatternArray) returns String
	let quoted = StringArray.create(patterns.count(), zeroed: false)

	for pattern in patterns 'eachPattern'
		quoted.push("'{pattern}'")
	end 'eachPattern'

	return joinedWith(quoted, separator: ListSeparator)
end 'quotedPatterns'

function selectedCount(selected TestSelection) returns ReportedTestCount
	var chosen = 0 as ReportedTestCount

	for slot in selected 'eachSlot'
		if slot 'chosen'
			chosen = chosen + 1
		end 'chosen'
	end 'eachSlot'

	return chosen
end 'selectedCount'

// ============================================================================================
// --list
// ============================================================================================

function listSelectedTests(args MaxonArgs, subject TestSubject, target Target, groups TestFileGroupArray, selected TestSelection, color bool) returns ExitCode
	if not args.buildTestBinary or selectedCount(selected) == 0 'nothingToBuild'
		return printTestList(args, groups: groups, selected: selected, color: color, binary: TestBinaryListing.notBuilt)
	end 'nothingToBuild'

	match buildTestBinary(subject, target: target, groups: groups, debugInfo: args.debugInfo) 'build'
		failed(exitCode) then return exitCode
		built(_, binary) then return printTestList(args, groups: groups, selected: selected, color: color, binary: TestBinaryListing.built(binary.resolve(Directory.currentPath())))
	end 'build'
end 'listSelectedTests'

function printTestList(args MaxonArgs, groups TestFileGroupArray, selected TestSelection, color bool, binary TestBinaryListing) returns ExitCode
	if args.jsonReport 'machineReadable'
		let document = testListJson(groups, selected: selected, binary: binary)
		print("{document}\n")
	end 'machineReadable' else 'human'
		print(testListText(groups, selected: selected, color: color, binary: binary))
	end 'human'

	// A list that found nothing fails, as a run that found nothing does: a zero-test run that exits 0
	// lets a renamed directory or a broken filter read as a green suite.
	if selectedCount(selected) == 0 'listedNothing'
		return OwnFailureExit
	end 'listedNothing'

	return SucceededExit
end 'printTestList'

// A run that found nothing to do fails, and says why in the report's own voice rather than as an
// error, because nothing went wrong with the harness — there is simply nothing green to claim. It
// therefore goes to stdout, where the rest of the report goes.
function reportNothingToRun(reason String, args MaxonArgs, color bool) returns ExitCode
	if args.jsonReport 'machineReadable'
		let empty = TestRunReport.create(TestFileResultsArray.create(0), compileMs: 0, runMs: 0, bailed: false)
		let document = testRunJson(empty, showTiming: args.showTiming, emptiness: TestRunEmptiness.nothingRan(reason))
		print("{document}\n")
	end 'machineReadable' else 'human'
		print(testEmptyRunNote(reason, color: color))
	end 'human'

	return OwnFailureExit
end 'reportNothingToRun'

// ============================================================================================
// COMPILE AND RUN
// ============================================================================================

// ⭐ **EMIT EVERY FILE THAT HAS RUN AND HAS NO UNEMITTED FILE BEFORE IT IN REPORT ORDER.** The cursor
// is what makes that a PREFIX rather than a set: results still appear as they land, and where they
// land in the transcript does not depend on which file the walk handed back first.
//
// `ran` holds one entry per group in walk order, so a group's index into it is its position in the
// walk — which is what `ReportFile.index` names.
function emitReadyFiles(files TestFileResultsArray, ran TestFileResultsArray, order ReportFileArray, from ElementIndex, args MaxonArgs, color bool) returns ElementIndex
	var cursor = from

	while cursor < order.count() 'inReportOrder'
		let entry = try order.get(cursor) otherwise panic("emitReadyFiles: the cursor is inside the order by the loop's own guard")

		if entry.index >= ran.count() 'hasNotRunYet'
			break
		end 'hasNotRunYet'

		let fileResults = try ran.get(entry.index) otherwise panic("emitReadyFiles: every walk position below `ran.count()` has an entry")

		// A file the selection reached nothing in is absent from the report ENTIRELY — it heads no
		// section, and the footer's file count must not claim it.
		if not fileResults.results.isEmpty() 'selectedSomething'
			// STREAMED for a text run so results appear as they land; a `--json` run is one document and
			// cannot be emitted in pieces.
			if not args.jsonReport 'streamTheBlock'
				print(testFileBlock(fileResults, color: color, showTiming: args.showTiming))
			end 'streamTheBlock'

			files.push(fileResults)
		end 'selectedSomething'

		cursor = cursor + 1
	end 'inReportOrder'

	return cursor
end 'emitReadyFiles'

union TestBinaryBuild
	built(staged StagedTestBuild, binary FilePath)
	failed(exitCode ExitCode)
end 'TestBinaryBuild'

type PreparedTestBuild
	export let buildRoot as FilePath
	export let staged as StagedTestBuild

	static function create(buildRoot FilePath, staged StagedTestBuild) returns PreparedTestBuild
		return Self{buildRoot: buildRoot, staged: staged}
	end 'create'
end 'PreparedTestBuild'

function preparedTestBuild(subject TestSubject, target Target, groups TestFileGroupArray, purpose StagingPurpose) returns PreparedTestBuild throws TestStagingError
	let buildRoot = try prepareTestBuildRoot(subject, purpose: purpose)
	let staged = try stageTestBuild(buildRoot.join("{StagedTreeDirName}"), subject: subject, groups: groups, tracksDescendants: targetProvidesFacility(target, facility: HostFacility.processDescendants))

	return PreparedTestBuild.create(buildRoot, staged: staged)
end 'preparedTestBuild'

function stagedTestRequest(work DriverWork, staged StagedTestBuild, target Target, session DriverSession, outputOverride StatedText, debugInfo bool, metrics StatedText) returns immutable CompileRequest
	return freeze CompileRequest.create(work, origin: ProjectOrigin.sources, target: target, session: session, inputPaths: staged.buildTargets, outputOverride: outputOverride, metrics: metrics, debugInfo: debugInfo, scriptlib: ScriptlibLoad.omitted, entryFunction: freeze MaxonTestEntrySymbol.toByteArray(), retainedEntries: NameRoster from [MainFunctionName], compilerWrittenSources: staged.compilerWrittenSources, sourceSelection: SourceSelection.productionAndTests, stagedSourceOrigins: staged.stagedSourceOrigins).clone()
end 'stagedTestRequest'

function buildTestBinary(subject TestSubject, target Target, groups TestFileGroupArray, debugInfo bool) returns TestBinaryBuild
	let prepared = try preparedTestBuild(subject, target: target, groups: groups, purpose: StagingPurpose.running) otherwise (e) 'stagingRefused'
		return TestBinaryBuild.failed(refuseTestRun(stagingRefusalReason(e)))
	end 'stagingRefused'

	let staged = prepared.staged

	// A sibling of the staged tree, never inside it: the staged root is purged and rewritten on every
	// run, and a binary living in the tree that gets walked is a file the next run would have to reason
	// about.
	let exePath = prepared.buildRoot.join("{TestBinaryStem}{executableExtension(target.os)}")
	let session = DriverSession.printing()
	let request = stagedTestRequest(DriverWork.build(LintRules.skipped), staged: staged, target: target, session: session, outputOverride: StatedText.stated(exePath.toString()), debugInfo: debugInfo, metrics: StatedText.unstated)
	let product = try compileToProduct(freshCompileDriver(), request: request, session: session) otherwise 'didNotCompile'
		// Silent about the cause: the pipeline already emitted every diagnostic through the one sink,
		// and a sentence of our own here would be a second, vaguer report of the same failure.
		printError("{TestCommandName}: the tests did not compile — the diagnostics above say why\n")
		return TestBinaryBuild.failed(NothingRanExitCode)
	end 'didNotCompile'

	return TestBinaryBuild.built(staged, binary: product.outputPath)
end 'buildTestBinary'

function compileAndRunTests(args MaxonArgs, subject TestSubject, target Target, groups TestFileGroupArray, selected TestSelection, color bool) returns ExitCode
	let compileStarted = Clock.nowMs()

	match buildTestBinary(subject, target: target, groups: groups, debugInfo: args.debugInfo) 'build'
		failed(exitCode) then return exitCode
		built(staged, binary) then return runBuiltTests(args, staged: staged, binary: binary, compileMs: Clock.elapsedMs(compileStarted), selected: selected, color: color)
	end 'build'
end 'compileAndRunTests'

function runBuiltTests(args MaxonArgs, staged StagedTestBuild, binary FilePath, compileMs DurationMs, selected TestSelection, color bool) returns ExitCode
	let runStarted = Clock.nowMs()

	let plan = TestLaunchPlan.create(binary, timeoutMs: args.testTimeoutMs, tracksDescendants: staged.tracksDescendants)
	removeEndedRunsScratch(plan.buildDirectory())

	let progress = TestRunProgress.create()
	let reportOrder = reportFileOrder(staged.groups)
	let ran = TestFileResultsArray.create(staged.groups.count(), zeroed: false)
	let files = TestFileResultsArray.create(staged.groups.count(), zeroed: false)
	var emitted = 0 as ElementIndex

	// The RUN follows the walk, so an order dependence that changes a RESULT still surfaces; only the
	// REPORT is ordered, by `emitReadyFiles`.
	for group in staged.groups 'eachFile'
		let results = runFileTests(plan, group: group, selected: selected, isolate: args.isolate, bail: args.bail, progress: progress)
		ran.push(TestFileResults.create(group.file, results: results))
		emitted = emitReadyFiles(files, ran: ran, order: reportOrder, from: emitted, args: args, color: color)
	end 'eachFile'

	let report = TestRunReport.create(files, compileMs: compileMs, runMs: Clock.elapsedMs(runStarted), bailed: progress.bailed)

	if args.jsonReport 'machineReadable'
		let document = testRunJson(report, showTiming: args.showTiming, emptiness: TestRunEmptiness.hasResults)
		print("{document}\n")
	end 'machineReadable' else 'human'
		print(testRunSummary(report, color: color, showTiming: args.showTiming))
	end 'human'

	if tallyTestRun(report.files).failed > 0 'somethingIsNotGreen'
		return OwnFailureExit
	end 'somethingIsNotGreen'

	return SucceededExit
end 'runBuiltTests'

// ⭐⭐ **CREATE THE TEST BUILD DIRECTORY AND MARK `.maxon/<test|lint>/` AS NOT PART OF THE PROJECT.**
//
// ⛔ **THE MARKER IS WRITTEN BEFORE ANYTHING IS STAGED, AND THAT ORDER IS THE WHOLE POINT.**
// `stageTestBuild` walks the project for its sources, and the NEXT run's `discoverTests` walks it again;
// both go through `Compiler.collectMaxonSources`, which prunes a subtree carrying `.maxonignore` and
// prunes nothing else. Without the marker in place first, a second run would sweep the previous run's
// staged copies into the project — reporting every test twice — and an ordinary `maxon build` of the
// project would compile the generated entry point as one of its own units.
//
// It is rewritten every run rather than written once: `stageTestBuild` purges the staged tree beneath
// it, and a marker that only ever existed because some earlier run happened to leave it is a premise,
// not a fact.
function prepareTestBuildRoot(subject TestSubject, purpose StagingPurpose) returns FilePath throws TestStagingError
	let base = try directoryHolding(subject)

	let markedRoot = base.join("{ProjectProductsDirName}").join(purpose.directoryName())

	let buildRoot = match subject 'where'
		projectDirectory gives markedRoot
		singleFile(path) gives markedRoot.join(path.filename())
	end 'where'

	if not Directory.create(buildRoot) 'couldNotCreateIt'
		throw TestStagingError.refused("could not create the test build directory {reportPathDisplay(buildRoot)}")
	end 'couldNotCreateIt'

	let marker = markedRoot.join("{IgnoreMarkerName}")
	try File.writeText(marker, content: purpose.markerText()) otherwise throw TestStagingError.refused("could not write {reportPathDisplay(marker)}, which is what keeps this run's generated source out of your own build")

	return buildRoot
end 'prepareTestBuildRoot'

function directoryHolding(subject TestSubject) returns FilePath throws TestStagingError
	match subject 'where'
		projectDirectory(dir, _) then return dir
		singleFile(path) then return try directoryHoldingFile(path) otherwise throw TestStagingError.refused("could not derive the directory holding {reportPathDisplay(path)}")
	end 'where'
end 'directoryHolding'
