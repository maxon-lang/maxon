// Both files are checked before either is written: filling in only the half a directory was missing
// leaves a scaffold beside a file its author wrote, with nothing having said so.
export function runInit(args MaxonArgs) returns ExitCode
	if args.paths.count() > 1 'tooManyPaths'
		printError("Usage: maxon {InitCommandName} [<directory>]\n")
		printError("One directory at most: a project is initialized in one place.\n")
		return 1
	end 'tooManyPaths'

	let spelling = try args.paths.get(0) otherwise "."

	let stated = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return 1
	end 'badPath'

	let root = stated.anchoredAt(Directory.currentPath())
	let named = stated.resolve(Directory.currentPath()).filename()

	if named.isEmpty() 'unnameable'
		printError("error: `{spelling}` names no directory a project can be called after.\n")
		return 1
	end 'unnameable'

	let manifest = root.join("{named}{ProjectFileExtension}")
	let entry = root.join(MainSourceFileName)

	if Directory.isDirectory(root) 'anExistingDirectory'
		let existing = try driverFileIn(root, extension: ProjectFileExtension) otherwise (e) 'unreadableLayout'
			reportCompileError(e)
			return 1
		end 'unreadableLayout'

		match existing 'existing'
			found(projectFile) then return refuseExistingFile(projectFile)
			none then break 'existing'
		end 'existing'
	end 'anExistingDirectory'

	if File.exists(entry) 'entryIsThere'
		return refuseExistingFile(entry)
	end 'entryIsThere'

	try requireNoProjectEncloses(manifest) otherwise (e) 'nested'
		reportCompileError(e)
		return 1
	end 'nested'

	if not Directory.create(root) 'noDirectory'
		printError("error: {root.toString()} could not be created\n")
		return 1
	end 'noDirectory'

	try File.writeText(manifest, content: ManifestSource) otherwise 'manifestNotWritten'
		printError("error: {manifest.toString()} could not be written\n")
		return 1
	end 'manifestNotWritten'

	try File.writeText(entry, content: EntrySource) otherwise 'entryNotWritten'
		printError("error: {entry.toString()} could not be written\n")
		return 1
	end 'entryNotWritten'

	print("{manifest.toString()}\n")
	print("{entry.toString()}\n")
	print("\n")
	print("Build it with `maxon {BuildSubcommandName}` in {root.toString()}.\n")
	return 0
end 'runInit'

function refuseExistingFile(path FilePath) returns ExitCode
	printError("error: {path.toString()} is already there, so nothing was written.\n")
	return 1
end 'refuseExistingFile'

let ManifestSource = "export function build() returns ExitCode\n\tBuild.build(\".\")\n\treturn 0\nend 'build'\n"

let EntrySource = "function main() returns ExitCode\n\tprint(\"Hello, world!\\n\")\n\treturn 0\nend 'main'\n"
