// Both files are checked before either is written: filling in only the half a directory was missing
// leaves a scaffold beside a file its author wrote, with nothing having said so.
export function runInit(args MaxonArgs) returns ExitCode
	if args.paths.count() > 1 'tooManyPaths'
		printError("Usage: maxon {InitCommandName} [<directory>]\n")
		printError("One directory at most: a project is initialized in one place.\n")
		return 1
	end 'tooManyPaths'

	let spelling = try args.paths.get(0) otherwise "."

	let stated = try FilePath.from(spelling) otherwise 'badPath'
		printError("error: invalid path: {spelling}\n")
		return 1
	end 'badPath'

	let root = stated.resolve(Directory.currentPath()).normalize()
	let named = projectNameOf(root)

	if named.isEmpty() 'unnameable'
		printError("error: `{spelling}` names no directory a project can be called after.\n")
		return 1
	end 'unnameable'

	if not nameIsWritable(named) 'unwritableName'
		printError("error: `{named}` holds a character a {ProjectManifestFileName} cannot state: {UnwritableNameCharacters}\n")
		return 1
	end 'unwritableName'

	let manifest = root.join(ProjectManifestFileName)
	let entry = root.join(MainSourceFileName)

	if File.exists(manifest) 'manifestIsThere'
		return refuseExistingFile(manifest)
	end 'manifestIsThere'

	if File.exists(entry) 'entryIsThere'
		return refuseExistingFile(entry)
	end 'entryIsThere'

	if not Directory.create(root) 'noDirectory'
		printError("error: {root.toString()} could not be created\n")
		return 1
	end 'noDirectory'

	try File.writeText(manifest, content: manifestSourceFor(named)) otherwise 'manifestNotWritten'
		printError("error: {manifest.toString()} could not be written\n")
		return 1
	end 'manifestNotWritten'

	try File.writeText(entry, content: EntrySource) otherwise 'entryNotWritten'
		printError("error: {entry.toString()} could not be written\n")
		return 1
	end 'entryNotWritten'

	print("{manifest.toString()}\n")
	print("{entry.toString()}\n")
	print("\n")
	print("Build it with `maxon {BuildSubcommandName}` in {root.toString()}.\n")
	return 0
end 'runInit'

function refuseExistingFile(path FilePath) returns ExitCode
	printError("error: {path.toString()} is already there, so nothing was written.\n")
	return 1
end 'refuseExistingFile'

function projectNameOf(root FilePath) returns String
	return root.filename()
end 'projectNameOf'

// The name is interpolated into a Maxon string literal, so a `"` or a brace in it would scaffold a
// manifest that does not compile.
let UnwritableNameCharacters = "\" \{ \} \\ and a control character"

function nameIsWritable(named String) returns bool
	for b in named.bytes() 'eachByte'
		if b == DoubleQuoteByte or b == OpenBraceByte or b == CloseBraceByte or b == BackslashByte or b < SpaceByte 'unwritable'
			return false
		end 'unwritable'
	end 'eachByte'

	return true
end 'nameIsWritable'

let DoubleQuoteByte = 34 as Byte
let OpenBraceByte = 123 as Byte
let CloseBraceByte = 125 as Byte
let BackslashByte = 92 as Byte
let SpaceByte = 32 as Byte

function manifestSourceFor(named String) returns String
	return "export function build() returns ExitCode\n\tBuild.build(\".\", output: \".maxon/{named}\")\n\treturn 0\nend 'build'\n"
end 'manifestSourceFor'

let EntrySource = "function main() returns ExitCode\n\tprint(\"Hello, world!\\n\")\n\treturn 0\nend 'main'\n"
