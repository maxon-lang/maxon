// Profile/ProfileSampler.maxon — the tick, the suspended window and the frame walk: everything that turns a
// running process into the counted stacks `ProfileModel` aggregates.
//
// ⭐⭐ **THIS SAMPLES ANOTHER PROCESS AND NEVER RUNS ONE INSTRUCTION OF IT.** Two of the three rules a
// sampler is bound by therefore hold STRUCTURALLY rather than by discipline: it allocates nothing in the
// target and takes no lock the target could hold, because there is no path from here into the target's code
// at all. The third — IT ALWAYS RESUMES — is the one the structure does not give for free, and it is
// enforced at the single place a thread is ever suspended: `ProfileRuntime.buildProfileSample`, whose Std
// graph converges every failure edge on ONE resume block that dominates its only return.
//
// ⭐⭐ **WHY SAMPLING OS THREADS SEES GREEN THREADS.** `__gt_context_switch` restores RSP *and* RBP, so an OS
// worker executing a green thread has that green thread's own stack in its registers: the register capture
// below IS the green thread's and the frame-pointer walk IS its backtrace. Nothing has to enumerate green
// threads to see them — which matters, because the one mechanism that CAN enumerate them is answered
// exclusively by a PARKED target, and parking a program once per sample is a design this tree has refused.
//
// ⭐ **WHY THE ALLOCATION BASE IDENTIFIES A STACK.** Every green thread's stack is its own reservation and so
// is every OS thread's, so two CONCURRENTLY LIVE stacks can never share one. It is the ALLOCATION base
// rather than the region base because a stack reservation is split into committed, guard and reserved
// regions with different bases and one allocation base — the identity has to be what does not move as the
// stack grows into its guard page.
//
// ⛔ **THE LOOP RUNS ON THE THREAD THAT CALLED IT, NEVER ON A GREEN THREAD OF ITS OWN.** Its wait is a
// blocking OS wait a thousand times a second, and handing a processor back and forth at that rate is a
// scheduler interaction nothing in this tree has measured.
//
// The gate and every conjunct of its reason are `ProfileModel`'s.
#if os(Windows) and arch(x64)
	module typealias ProfileWordArray = Array with RegisterWord

	// How many frames a walk produced. A byte extent inside the copied window is an ordinary `RegisterWord`,
	// because that is what it is compared and added to on every step — a second alias of the same range
	// would only be a cast at each of them.
	typealias ProfileFrameCount = int(0 to 4096)

	// ⭐ **THE DEEPEST CHAIN ONE SAMPLE WALKS.** Generous, because a truncated PROFILE stack is worse than a
	// truncated backtrace: the walk runs leaf-to-ROOT, so losing the tail loses the ROOT, and a stack with no
	// root cannot be attributed to the call tree at all. Samples that reach this are COUNTED rather than
	// quietly rooted at the wrong place.
	let ProfileMaxWalkFrames = 256

	// ⭐ **A FRAME LINK IS TWO WORDS** — the saved frame pointer at `[fp]` and the return address at `[fp+8]`
	// — and the bound below must leave room for BOTH before either is read.
	let ProfileWordBytes = 8
	let ProfileFrameLinkBytes = 16

	// How often the target's thread list is re-enumerated, as opposed to how often it is SAMPLED. They are
	// different rates on purpose: the scheduler creates its workers LAZILY, so a one-shot enumeration at
	// attach misses exactly the threads a green-thread profile is about — while the answer barely changes
	// between ticks, and a thread that EXITS is noticed immediately without any enumeration, because its
	// handle starts refusing.
	let ProfileThreadRefreshNanos = 100000000

	let ProfileNanosPerSecond = 1000000000.0

	// The two names a PE image's own header answers with, and the flag that says its base is not a promise.
	let ProfileTextSectionName = ".text"
	let ProfileDynamicBaseFlag = 0x0040

	// The PE displacements this file reads. It walks the section table itself rather than reaching for
	// `readPeSectionData`, because what it needs is a section's PLACEMENT — the address the loader maps it
	// at — and that reader answers with the section's BYTES.
	let ProfilePeSignatureOffsetField = 0x3C
	let ProfileDosMagic = 0x5A4D
	let ProfilePeMagic = 0x00004550
	let ProfileCoffHeaderBytes = 20
	let ProfileCoffSectionCountOffset = 2
	let ProfileCoffOptionalHeaderSizeOffset = 16
	let ProfileOptionalImageBaseOffset = 24
	let ProfileOptionalDllCharacteristicsOffset = 70
	let ProfileSectionHeaderBytes = 40
	let ProfileSectionNameBytes = 8
	let ProfileSectionVirtualSizeOffset = 8
	let ProfileSectionVirtualAddressOffset = 12
	let ProfileSectionRawSizeOffset = 16
	let ProfileSectionRawPointerOffset = 20

	// ========================================================================================
	// THE TARGET'S IMAGE
	// ========================================================================================

	// Where the target's `.text` was mapped and what names the code inside it. Everything a sampled
	// instruction pointer is resolved through.
	export type ProfileImage
		export var textBase as RegisterWord
		export var textSize as RegisterWord
		export var sidecar as MxdbgReader
		export var modules as ProfileModuleMap

		static function create(textBase RegisterWord, textSize RegisterWord, sidecar MxdbgReader, modules ProfileModuleMap) returns ProfileImage
			return Self{textBase: textBase, textSize: textSize, sidecar: sidecar, modules: modules}
		end 'create'
	end 'ProfileImage'

	// Which loaded module owns an address outside the profiled binary's own `.text`.
	//
	// ⭐ Without it a sample that landed in a DLL reports as `[outside .text]`, which is a true statement a
	// reader can do nothing with. "52% was somewhere else" makes the whole instrument unusable where "52% was
	// in ntdll.dll" is a finding.
	//
	// It is a SNAPSHOT taken when sampling starts. A module loaded later is not in it and its addresses fall
	// back to the unattributed name — honest, and the alternative would put a process-wide query on the
	// sampling path to catch a case a Maxon program, which loads nothing at run time, does not produce.
	module type ProfileModuleMap
		var starts as ProfileWordArray
		var ends as ProfileWordArray
		var names as ProfileStringArray

		static function over(modules SampledModuleArray) returns ProfileModuleMap
			var starts = ProfileWordArray.create()
			var ends = ProfileWordArray.create()
			var names = ProfileStringArray.create()

			for loaded in modules 'eachModule'
				starts.push(loaded.base)
				ends.push(loaded.limit)
				names.push(loaded.name)
			end 'eachModule'

			return Self{starts: starts, ends: ends, names: names}
		end 'over'

		// The base the FIRST module was loaded at, which for a Toolhelp module walk is the executable itself.
		// Zero when nothing was enumerated.
		export function mainModuleBase() returns RegisterWord
			return try self.starts.get(0) otherwise 0
		end 'mainModuleBase'

		export function nameAt(address RegisterWord) returns String throws AbsentError
			for (iter, start) in self.starts.withIterator() 'eachModule'
				if address >= start and address < (try self.ends.get(iter.index()) otherwise start) 'inThisModule'
					return try self.names.get(iter.index()) otherwise panic("ProfileModuleMap.nameAt: module {iter.index()} has a start and no name — the three columns are pushed together")
				end 'inThisModule'
			end 'eachModule'

			throw AbsentError.absent
		end 'nameAt'
	end 'ProfileModuleMap'

	// Where a PE image says its `.text` will be mapped, and whether that promise is one the loader keeps.
	module type ProfilePlacement
		export var preferredTextBase as RegisterWord
		export var textRva as RegisterWord
		export var textSize as RegisterWord
		export var relocatable as bool
		export var codeBytes as ByteArray

		static function create(preferredTextBase RegisterWord, textRva RegisterWord, textSize RegisterWord, relocatable bool, codeBytes ByteArray) returns ProfilePlacement
			return Self{preferredTextBase: preferredTextBase, textRva: textRva, textSize: textSize, relocatable: relocatable, codeBytes: codeBytes}
		end 'create'
	end 'ProfilePlacement'

	module union ProfilePlacementRead
		found(placement ProfilePlacement)
		refused(reason String)
	end 'ProfilePlacementRead'

	// The image's own header is read, never the live process, because this compiler's PE writer clears
	// DYNAMIC_BASE: its binaries map where their header says, so `.text`'s address is arithmetic. A
	// binary that sets the flag is caught by `relocatable` and answered from the module map instead; a
	// wrong base would not fail, it would symbolize every sample to a wrong function.
	module function readProfilePlacement(binary FilePath) returns ProfilePlacementRead
		let image = try File.readBinary(binary) otherwise return ProfilePlacementRead.refused("cannot read {reportPathDisplay(binary)}")

		if imageReadU16(image, at: 0) != ProfileDosMagic 'notAnImage'
			return profileNotAPeImage(binary)
		end 'notAnImage'

		let peOffset = imageReadU32(image, at: ProfilePeSignatureOffsetField) as ByteOffset

		if not spanFitsWithin(peOffset, count: ProfileCoffHeaderBytes as BytePos, total: image.count() as BytePos) or imageReadU32(image, at: peOffset) != ProfilePeMagic 'notPe'
			return profileNotAPeImage(binary)
		end 'notPe'

		let coff = peOffset + 4
		let sectionCount = imageReadU16(image, at: coff + ProfileCoffSectionCountOffset)
		let optionalHeaderSize = imageReadU16(image, at: coff + ProfileCoffOptionalHeaderSizeOffset)
		let optional = coff + ProfileCoffHeaderBytes as ByteOffset
		let firstSection = optional + optionalHeaderSize as ByteOffset

		let preferredBase = imageReadU64(image, at: optional + ProfileOptionalImageBaseOffset) as RegisterWord
		let relocatable = (imageReadU16(image, at: optional + ProfileOptionalDllCharacteristicsOffset) and ProfileDynamicBaseFlag) != 0

		for index in 0 upto sectionCount 'eachSection'
			let header = firstSection + (index * ProfileSectionHeaderBytes) as ByteOffset

			if not spanFitsWithin(header, count: ProfileSectionHeaderBytes as BytePos, total: image.count() as BytePos) or not imageNameIs(image, at: header, maxBytes: ProfileSectionNameBytes, name: ProfileTextSectionName) 'notTheCode'
				continue
			end 'notTheCode'

			let virtualSize = imageReadU32(image, at: header + ProfileSectionVirtualSizeOffset) as RegisterWord
			let rawSize = imageReadU32(image, at: header + ProfileSectionRawSizeOffset) as BytePos
			let rawPointer = imageReadU32(image, at: header + ProfileSectionRawPointerOffset) as ByteOffset
			let stored = virtualSize as BytePos if (virtualSize as BytePos) < rawSize else rawSize

			if not spanFitsWithin(rawPointer, count: stored, total: image.count() as BytePos) 'runsPastTheEnd'
				return ProfilePlacementRead.refused("{reportPathDisplay(binary)} claims a {ProfileTextSectionName} section that runs past the end of the file")
			end 'runsPastTheEnd'

			return ProfilePlacementRead.found(ProfilePlacement.create(preferredBase, textRva: imageReadU32(image, at: header + ProfileSectionVirtualAddressOffset) as RegisterWord, textSize: virtualSize, relocatable: relocatable, codeBytes: imageSlice(image, start: rawPointer, count: stored)))
		end 'eachSection'

		return ProfilePlacementRead.refused("{reportPathDisplay(binary)} has no {ProfileTextSectionName} section, so there is no code for a profile to land in")
	end 'readProfilePlacement'

	function profileNotAPeImage(binary FilePath) returns ProfilePlacementRead
		return ProfilePlacementRead.refused("{reportPathDisplay(binary)} is not a PE image this build can sample")
	end 'profileNotAPeImage'

	// ========================================================================================
	// SYMBOLIZATION
	// ========================================================================================

	// ⭐ **AN ADDRESS BELOW `.text` IS OUTSIDE IT, AND THE TEST SAYS SO IN TWO HALVES BECAUSE THE ARITHMETIC
	// HERE IS SIGNED.** The reference subtracts unsigned and lets an underflow fail one upper bound; a signed
	// difference goes NEGATIVE instead, which passes that bound — so the lower half is stated outright.
	function profileAddressInText(image ProfileImage, address RegisterWord) returns bool
		return address >= image.textBase and address - image.textBase < image.textSize
	end 'profileAddressInText'

	// What the sidecar calls the code at a `.text` offset, or the placeholder for our own code it does not
	// name — a runtime helper the function table has no record for.
	function profileFunctionNameAt(image ProfileImage, offset MxdbgCodeOffset) returns String
		return match image.sidecar.functionContaining(offset) 'lookup'
			none gives ProfileUnnamedTextFrame
			found(info) gives ProfileUnnamedTextFrame if info.name.isEmpty() else info.name
		end 'lookup'
	end 'profileFunctionNameAt'

	// ⭐ **ONE PHYSICAL FRAME IS AS MANY PROFILE FRAMES AS THE CODE AT `offset` HAS CALLEES SPLICED INTO
	// IT.** A body the inliner spliced away has no frame of its own, so the chain alone would credit its
	// caller with its time and lose the level a report ranks by. The sidecar's inline tables name the
	// innermost spliced body first — where self time goes — then each body it nests under, then the
	// function whose frame this is, exactly as the panic runtime prints the same frame.
	function pushProfileFramesAt(frames ProfileStringArray, image ProfileImage, offset MxdbgCodeOffset)
		var site = image.sidecar.inlineSiteContaining(offset)

		while true 'eachSpliceOutwards'
			match site 's'
				none then break 'eachSpliceOutwards'
				site(index) then site = pushInlineSiteFrame(frames, image: image, index: index)
			end 's'
		end 'eachSpliceOutwards'

		frames.push(profileFunctionNameAt(image, offset: offset))
	end 'pushProfileFramesAt'

	// Push one spliced body's name and answer the site it nests under.
	function pushInlineSiteFrame(frames ProfileStringArray, image ProfileImage, index MxdbgIndex) returns MxdbgInlineSiteLookup
		let site = image.sidecar.inlineSite(index)
		frames.push(site.name)
		return site.parent
	end 'pushInlineSiteFrame'

	// ⭐ **ONLY THE LEAF EARNS A FOREIGN PLACEHOLDER.** Above the leaf, leaving `.text` is simply where our
	// code ends — the outermost Maxon frame returns into the C runtime or the thread starter — so stopping
	// there is what makes a stack's root its entry function rather than a symbol we cannot name. At the LEAF
	// it means the sample landed in a DLL or the kernel, and the chain above it cannot be trusted at all:
	// foreign code has no obligation to maintain a frame pointer, so following RBP out of it would produce a
	// return address that might well resolve to a real function of ours and attribute the sample to a caller
	// that never called it. One unnamed frame is the honest answer; a plausible wrong one is not.
	function profileForeignLeafFrame(image ProfileImage, address RegisterWord) returns String
		let name = try image.modules.nameAt(address) otherwise return ProfileOutsideTextFrame
		return "[{name}]"
	end 'profileForeignLeafFrame'

	// ========================================================================================
	// THE WALK
	// ========================================================================================

	// Follow the frame-pointer chain through the COPIED window, naming each frame as it goes. True when the
	// walk hit its depth bound, which means it lost the stack's outermost frames.
	//
	// Two things bound it, and they close different failures. The WINDOW bounds reads, so a frame pointer
	// into the target's heap or into another stack simply ends the walk. STRICT INCREASE bounds cycles: a
	// stack grows downwards, so a caller's frame is always at a higher address, and a chain that points
	// backwards or at itself would otherwise spin forever.
	//
	// ⛔⛔ **THE WINDOW BOUND IS A SUBTRACTION IN WINDOW COORDINATES AND NEVER `fp + FrameLinkBytes >
	// windowEnd`.** That form WRAPS, and the value that wraps it is not exotic: RBP is a frame pointer only by
	// CONVENTION, so a sample landing in foreign code using it as an ordinary callee-saved register holding
	// all-ones arrives here as the largest word there is, whose sum with 16 is 15 — which passes an upper
	// bound written that way and then indexes the window at a truncated offset. One stray register value is
	// enough to discard an entire run's profile.
	//
	// ⚠ What it cannot see, stated because it bounds the accuracy of every frame-pointer sampler: a sample
	// landing inside a prologue (after `push rbp`, before `mov rbp, rsp`) or an epilogue (after `pop rbp`)
	// reads the CALLER's frame pointer, so that one sample attributes the leaf correctly and misses its
	// immediate caller. It is a per-sample error of one frame over a window of one or two instructions per
	// call, and it does not accumulate.
	function walkProfileFrames(frames ProfileStringArray, image ProfileImage, leafPc RegisterWord, framePointer RegisterWord, stackPointer RegisterWord, window StackWindow) returns ProfileWalk
		frames.clear()

		if not profileAddressInText(image, address: leafPc) 'foreignLeaf'
			frames.push(profileForeignLeafFrame(image, address: leafPc))
			return ProfileWalk.of(false, rootFrame: 0)
		end 'foreignLeaf'

		pushProfileFramesAt(frames, image: image, offset: (leafPc - image.textBase) as MxdbgCodeOffset)

		let windowBytes = window.byteCount()

		if windowBytes < ProfileFrameLinkBytes 'nothingToWalk'
			return ProfileWalk.of(false, rootFrame: 0)
		end 'nothingToWalk'

		// The largest offset at which BOTH words of a frame link still fit, computed ONCE by SUBTRACTING the
		// link size from the bound rather than adding it to the pointer.
		let lastFrameLinkOffset = windowBytes - ProfileFrameLinkBytes
		var fp = framePointer
		var walked = 1 as ProfileFrameCount

		while walked < ProfileMaxWalkFrames 'eachFrame'
			if fp < stackPointer 'belowTheWindow'
				return ProfileWalk.of(false, rootFrame: 0)
			end 'belowTheWindow'

			let offset = fp - stackPointer

			if offset > lastFrameLinkOffset 'pastTheWindow'
				return ProfileWalk.of(false, rootFrame: 0)
			end 'pastTheWindow'

			let savedFp = try window.word(offset as StackWindowOffset) otherwise return ProfileWalk.of(false, rootFrame: 0)
			let returnAddress = try window.word((offset + ProfileWordBytes) as StackWindowOffset) otherwise return ProfileWalk.of(false, rootFrame: 0)

			if returnAddress == 0 or not profileAddressInText(image, address: returnAddress) 'endOfOurCode'
				return ProfileWalk.of(false, rootFrame: fp)
			end 'endOfOurCode'

			// ⭐ A frame above the leaf is a RETURN address, so it resolves through the ONE call-site bias
			// this tree states — without it, a call that is a function's last instruction names the function
			// AFTER it.
			pushProfileFramesAt(frames, image: image, offset: MxdbgReader.callSiteLookup((returnAddress - image.textBase) as MxdbgCodeOffset))
			walked = walked + 1

			if savedFp <= fp 'notGrowingOutwards'
				return ProfileWalk.of(false, rootFrame: fp)
			end 'notGrowingOutwards'

			fp = savedFp
		end 'eachFrame'

		return ProfileWalk.of(true, rootFrame: 0)
	end 'walkProfileFrames'

	// ========================================================================================
	// ONE TICK OF CPU
	// ========================================================================================

	// ⭐⭐ **ONE TICK'S WORTH OF CPU IN THE CYCLE COUNTER's UNIT, MEASURED RATHER THAN ASSUMED.**
	// `QueryThreadCycleTime` counts at the processor's reference rate, which no API reports and which is not the
	// nominal clock, so the sampler spins its own thread through a few windows timed by the performance counter
	// and divides. The cycle reads sit INSIDE the clock reads, so a window counts cycles over no more than the
	// time it divides by and can only read low — most of all when the OS descheduled the spinning thread — and
	// the FASTEST window is kept. Taken before the target starts, so no part of its run goes unsampled.
	let ProfileCalibrationWindows = 5
	let ProfileCalibrationWindowNanos = 2000000

	// One tick's worth of cycles — never zero, or no amount of CPU would ever be charged a sample.
	export typealias ProfileCyclesPerTick = int(1 to u64.max)

	// A calibration window's two measured spans — its cycles and its nanoseconds — as the division reads them,
	// and their quotient: cycle-counter units per nanosecond, a fraction near the reference clock in gigahertz
	// that an integer quotient would truncate.
	typealias ProfileCalibrationSpan = float(0.0 to f64.max)
	typealias ProfileCyclesPerNano = float(0.0 to f64.max)

	// What calibration found: a tick's worth of cycles, or a counter that did not move — a host (a VM or an
	// emulator) whose threads cannot be charged by CPU at all.
	module union ProfileCalibration
		measured(cyclesPerTick ProfileCyclesPerTick)
		counterStood
	end 'ProfileCalibration'

	module function measureProfileCyclesPerTick(rateHz ProfileRate) returns ProfileCalibration
		var fastest = 0.0 as ProfileCyclesPerNano

		for _ in 0 upto ProfileCalibrationWindows 'eachWindow'
			let started = Clock.nowNanos()
			let startCycles = Clock.threadCpuTicks()
			var spinning = Clock.elapsedNanos(started)

			while spinning < ProfileCalibrationWindowNanos 'spin'
				spinning = Clock.elapsedNanos(started)
			end 'spin'

			let spentCycles = Clock.threadCpuTicks() - startCycles
			let spun = Clock.elapsedNanos(started)
			let cyclesPerNano = try ((spentCycles as ProfileCalibrationSpan) / (spun as ProfileCalibrationSpan)) otherwise panic("measureProfileCyclesPerTick: the window ended only once {spun} ns had passed, which is not zero")
			fastest = max(fastest, cyclesPerNano as ProfileCyclesPerNano)
		end 'eachWindow'

		let cyclesPerTick = trunc(try ((fastest as FullRangeFloat) * ProfileNanosPerSecond / (rateHz as FullRangeFloat)) otherwise panic("measureProfileCyclesPerTick: `--rate` is refused unless it is at least one sample per CPU-second"))

		if cyclesPerTick < 1 'counterStood'
			return ProfileCalibration.counterStood
		end 'counterStood'

		return ProfileCalibration.measured(cyclesPerTick as ProfileCyclesPerTick)
	end 'measureProfileCyclesPerTick'

	// ========================================================================================
	// THE SESSION
	// ========================================================================================

	// The sampled process and thread table one profiling run holds. The thread table is three PARALLEL
	// arrays — the threads, their cycle baselines and their uncharged credit — rather than one array of
	// records, so the baseline and the credit written on every tick are plain word columns.
	export type ProfileSession
		var process as SampledProcess
		var cyclesPerTick as ProfileCyclesPerTick
		var threads as SampledThreadArray
		var threadCycles as ProfileWordArray
		var threadCredit as ProfileWordArray
		export var ticks as ProfileTally

		export static function create(process SampledProcess, cyclesPerTick ProfileCyclesPerTick) returns ProfileSession
			return Self{process: process, cyclesPerTick: cyclesPerTick, threads: SampledThreadArray.create(), threadCycles: ProfileWordArray.create(), threadCredit: ProfileWordArray.create(), ticks: 0}
		end 'create'

		function loadedModules() returns ProfileModuleMap throws SamplerError
			return ProfileModuleMap.over(try self.process.modules())
		end 'loadedModules'

		function cyclesOf(thread SampledThread) returns RegisterWord
			return (try self.process.cycles(thread) otherwise panic("ProfileSession.cyclesOf: every thread this session reads was handed out by its own process and is released only by this session")) as RegisterWord
		end 'cyclesOf'

		function tracks(id SampledThreadId) returns bool
			for tracked in self.threads 'eachTracked'
				if tracked.id == id 'thisOne'
					return true
				end 'thisOne'
			end 'eachTracked'

			return false
		end 'tracks'

		// ⭐ Re-enumerate the target's threads, keeping a handle for each NEW one.
		//
		// ⛔ A thread the walk no longer lists has exited and its handle is closed here. One that exits between
		// two refreshes is charged nothing meanwhile — its count reads zero, below its baseline — unless a charge
		// was already due, in which case the suspend that refuses drops it sooner.
		export function refreshThreads()
			var seen = ProfileThreadIdArray.create()

			for thread in self.process.threads() 'eachThread'
				seen.push(thread.id)

				if self.tracks(thread.id) 'alreadyTracked'
					self.process.release(thread)
					continue
				end 'alreadyTracked'

				self.threads.push(thread)

				// ⭐ The baseline is seeded the instant the thread is discovered: one left at zero would charge
				// the thread's whole prior CPU on the next tick, as a burst against whichever stack it is on.
				self.threadCycles.push(self.cyclesOf(thread))
				self.threadCredit.push(0)
			end 'eachThread'

			self.dropDepartedThreads(seen)
		end 'refreshThreads'

		function dropDepartedThreads(seen ProfileThreadIdArray)
			var index = self.threads.count()

			while index > 0 'eachTracked'
				index = index - 1

				if profileThreadIdsContain(seen, wanted: (try self.threads.get(index) otherwise panic("dropDepartedThreads: index {index} is below the table's count")).id) 'stillThere'
					continue
				end 'stillThere'

				self.forgetThread(index)
			end 'eachTracked'
		end 'dropDepartedThreads'

		function forgetThread(index ElementIndex)
			self.process.release(try self.threads.remove(index) otherwise panic("forgetThread: index {index} is outside the thread column"))
			_ = try self.threadCycles.remove(index) otherwise panic("forgetThread: index {index} is outside the baseline column")
			_ = try self.threadCredit.remove(index) otherwise panic("forgetThread: index {index} is outside the credit column")
		end 'forgetThread'

		// ⭐⭐ ONE TICK: every known thread is charged one sample per tick's worth of CPU it has CONSUMED. The COUNT
		// is Go's (`setThreadCPUProfiler`: one SIGPROF per period of a thread's own CPU); a thread that wakes for
		// microseconds owes a fraction of a sample, carried in its credit until the fractions add up to one, where
		// charging it a whole sample for any tick it merely woke in overcounts it by orders of magnitude. WHERE the
		// stack is captured is not Go's: SIGPROF interrupts the thread the instant its period expires, while this
		// captures once, at the tick the charge falls due, and that one capture carries every sample charged there.
		export function sampleOnce(accumulator ProfileAccumulator, image ProfileImage, frames ProfileStringArray)
			let tickOfCpu = self.cyclesPerTick as RegisterWord
			var index = self.threads.count()

			while index > 0 'eachThread'
				index = index - 1
				let thread = try self.threads.get(index) otherwise panic("sampleOnce: index {index} is below the thread column's count")
				let cycles = self.cyclesOf(thread)
				let baseline = try self.threadCycles.get(index) otherwise panic("sampleOnce: index {index} is outside the baseline column")
				var credit = (try self.threadCredit.get(index) otherwise panic("sampleOnce: index {index} is outside the credit column")) + cycles - baseline
				try self.threadCycles.set(index, value: cycles) otherwise panic("sampleOnce: index {index} is outside the baseline column")
				var charges = 0 as ProfileTally

				while credit >= tickOfCpu 'eachTickOfCpu'
					credit = credit - tickOfCpu
					charges = charges + 1
				end 'eachTickOfCpu'

				try self.threadCredit.set(index, value: credit) otherwise panic("sampleOnce: index {index} is outside the credit column")

				if charges == 0 'owesNoSample'
					continue
				end 'owesNoSample'

				match self.sampleThread(thread, charges: charges as ProfileCharges, accumulator: accumulator, image: image, frames: frames) 'sampled'
					gone then self.forgetThread(index)
					charged(suspendedCycles) then self.baselineAt(index, cycles: suspendedCycles)
				end 'sampled'
			end 'eachThread'

			self.ticks = self.ticks + 1
		end 'sampleOnce'

		// ⭐⭐ **THE BASELINE IS THE COUNT READ WHILE THE THREAD WAS SUSPENDED** (`__prof_sample`). Suspending
		// a thread costs it kernel cycles and the counter counts them, so a baseline read before the
		// suspend would charge a sampled thread for its own sampling; one read after the walk would drop
		// what the thread ran, resumed, while the sampler walked and aggregated its copied stack — most for
		// the busiest, deepest threads. Only the resume's own cost reaches the next charge.
		function baselineAt(index ElementIndex, cycles RegisterWord)
			try self.threadCycles.set(index, value: cycles) otherwise panic("sampleOnce: index {index} is outside the baseline column")
		end 'baselineAt'

		// One captured stack, carrying `charges` samples. `gone` means the thread has exited and should be dropped.
		function sampleThread(thread SampledThread, charges ProfileCharges, accumulator ProfileAccumulator, image ProfileImage, frames ProfileStringArray) returns ProfileThreadSample
			let capture = try self.process.capture(thread) otherwise panic("ProfileSession.sampleThread: every thread this session samples was handed out by its own process and is released only by this session")

			return match capture 'captured'
				threadGone gives ProfileThreadSample.gone
				unreadable(allocationBase, suspendedCycles) gives self.chargedWithNoRegisters(allocationBase, suspendedCycles: suspendedCycles, charges: charges, accumulator: accumulator, frames: frames)
				captured(stack) gives self.chargedWithStack(stack, charges: charges, accumulator: accumulator, image: image, frames: frames)
			end 'captured'
		end 'sampleThread'

		function chargedWithNoRegisters(allocationBase RegisterWord, suspendedCycles RegisterWord, charges ProfileCharges, accumulator ProfileAccumulator, frames ProfileStringArray) returns ProfileThreadSample
			frames.clear()
			frames.push(ProfileUnreadableStackFrame)
			accumulator.accept(frames, charged: charges, stackIdentity: allocationBase as ProfileStackBase, lostItsRoot: false, hadNoChain: true)

			return ProfileThreadSample.charged(suspendedCycles)
		end 'chargedWithNoRegisters'

		// Everything here runs with the thread ALREADY RESUMED, over the copy. Nothing about walking or
		// symbolizing needs the target held, and holding it would multiply the suspension by the stack's
		// depth.
		function chargedWithStack(stack SampledStack, charges ProfileCharges, accumulator ProfileAccumulator, image ProfileImage, frames ProfileStringArray) returns ProfileThreadSample
			let walk = walkProfileFrames(frames, image: image, leafPc: stack.programCounter, framePointer: stack.framePointer, stackPointer: stack.stackPointer, window: stack.window)
			let identity = walk.rootFrame if walk.rootFrame != 0 else stack.allocationBase
			accumulator.accept(frames, charged: charges, stackIdentity: identity as ProfileStackBase, lostItsRoot: walk.lostItsRoot, hadNoChain: stack.window.byteCount() == 0)

			return ProfileThreadSample.charged(stack.suspendedCycles)
		end 'chargedWithStack'

		export function release()
			self.threads.clear()
			self.threadCycles.clear()
			self.threadCredit.clear()
			self.process.close()
		end 'release'
	end 'ProfileSession'

	type ProfileWalk
		export let lostItsRoot as bool
		export let rootFrame as RegisterWord

		static function of(lostItsRoot bool, rootFrame RegisterWord) returns ProfileWalk
			return Self{lostItsRoot: lostItsRoot, rootFrame: rootFrame}
		end 'of'
	end 'ProfileWalk'

	union ProfileThreadSample
		gone
		charged(suspendedCycles RegisterWord)
	end 'ProfileThreadSample'

	typealias ProfileThreadIdArray = Array with SampledThreadId

	function profileThreadIdsContain(ids ProfileThreadIdArray, wanted SampledThreadId) returns bool
		for id in ids 'each'
			if id == wanted 'found'
				return true
			end 'found'
		end 'each'

		return false
	end 'profileThreadIdsContain'

	// The image a session symbolizes against: the sidecar it was handed, plus a module snapshot taken while
	// the target is certainly alive and before a single sample.
	module function profileImageFor(session ProfileSession, placement ProfilePlacement, sidecar MxdbgReader) returns ProfileImageLoad
		let modules = try session.loadedModules() otherwise 'unlisted'
			return profileImageWithoutModules(placement, sidecar: sidecar)
		end 'unlisted'

		// ⭐ A PINNED image is arithmetic on its own header; a RELOCATABLE one has to be asked where it
		// landed, and refusing beats symbolizing every sample to a function that is wrong by the slide.
		let mapped = modules.mainModuleBase()

		if placement.relocatable and mapped == 0 'slidByAnUnknownAmount'
			return ProfileImageLoad.refused(ProfileSlidImageReason)
		end 'slidByAnUnknownAmount'

		let base = placement.preferredTextBase if mapped == 0 else mapped

		return ProfileImageLoad.loaded(ProfileImage.create(base + placement.textRva, textSize: placement.textSize, sidecar: sidecar, modules: modules))
	end 'profileImageFor'

	let ProfileSlidImageReason = "this binary sets DYNAMIC_BASE, so where its code was mapped is not what its header says, and the module list could not be read to find out. Every sample would be attributed to the wrong function."

	function profileImageWithoutModules(placement ProfilePlacement, sidecar MxdbgReader) returns ProfileImageLoad
		if placement.relocatable 'slidByAnUnknownAmount'
			return ProfileImageLoad.refused(ProfileSlidImageReason)
		end 'slidByAnUnknownAmount'

		return ProfileImageLoad.loaded(ProfileImage.create(placement.preferredTextBase + placement.textRva, textSize: placement.textSize, sidecar: sidecar, modules: ProfileModuleMap.over(SampledModuleArray.create())))
	end 'profileImageWithoutModules'

	module union ProfileImageLoad
		loaded(image ProfileImage)
		refused(reason String)
	end 'ProfileImageLoad'

	// One tick's period, in nanoseconds: the unit `SampleTimer` is created in. Floored at one so a rate past the
	// timer's own granularity still steps the schedule forward rather than re-arming the same instant.
	module function profileIntervalNanos(rateHz ProfileRate) returns SampleIntervalNanos
		let nanos = trunc(try (ProfileNanosPerSecond / rateHz) otherwise panic("profileIntervalNanos: `--rate=` refuses a non-positive rate, so the divisor here cannot be zero"))

		return (nanos if nanos > 0 else 1) as SampleIntervalNanos
	end 'profileIntervalNanos'

	// How long the thread table has gone unrefreshed, in the units `Clock.nowNanos()` answers.
	module function profileThreadRefreshDue(sinceNanos DurationNanos) returns bool
		return sinceNanos >= ProfileThreadRefreshNanos
	end 'profileThreadRefreshDue'

	module function profileSecondsOf(nanos DurationNanos) returns ProfileSeconds
		return (nanos as ProfileSeconds) / ProfileNanosPerSecond
	end 'profileSecondsOf'
#endif
