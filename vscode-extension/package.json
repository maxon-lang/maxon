{
  "name": "maxon-lsp-client",
  "displayName": "Maxon",
  "description": "Language support for Maxon: diagnostics, completion, go-to-definition, rename and formatting.",
  "version": "2026.9.5",
  "publisher": "maxon-lang",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://maxon.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxon-lang/maxon"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/maxon-extension-icon.png",
  "activationEvents": [
    "workspaceContains:**/*.maxon",
    "workspaceContains:**/*.maxproj",
    "workspaceContains:**/*.maxtasks",
    "workspaceContains:**/*.maxtest",
    "workspaceContains:**/*.test",
    "workspaceContains:specs/*.md",
    "onDebugResolve:maxon",
    "onDebugDynamicConfigurations:maxon"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "maxon",
        "aliases": [
          "Maxon",
          "maxon"
        ],
        "extensions": [
          ".maxon",
          ".maxproj",
          ".maxtasks",
          ".maxtest",
          ".test"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./maxon-icon.svg",
          "dark": "./maxon-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "maxon",
        "scopeName": "source.maxon",
        "path": "./syntaxes/maxon.tmLanguage.json"
      }
    ],
    "icons": {
      "maxon-logo": {
        "description": "Maxon logo",
        "default": {
          "fontPath": "./icons/maxon-icons.woff",
          "fontCharacter": "\\E000"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "maxon",
          "title": "Maxon",
          "icon": "./activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "maxon": [
        {
          "type": "webview",
          "id": "maxon.compilerExplorerView",
          "name": "Compiler Explorer",
          "icon": "./activity-bar-icon.svg",
          "contextualTitle": "Maxon"
        }
      ]
    },
    "commands": [
      {
        "command": "maxon.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Maxon"
      },
      {
        "command": "maxon.showLanguageServerOutput",
        "title": "Show Language Server Output",
        "category": "Maxon"
      },
      {
        "command": "maxon.openCompilerExplorer",
        "title": "Open Compiler Explorer",
        "category": "Maxon"
      },
      {
        "command": "maxon.generateIR",
        "title": "Generate IR (internal)",
        "category": "Maxon"
      }
    ],
    "breakpoints": [
      {
        "language": "maxon"
      }
    ],
    "debuggers": [
      {
        "type": "maxon",
        "label": "Maxon",
        "languages": [
          "maxon"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The program to debug: a .maxon file, a project directory, or an executable built with debug info. A source is built for debugging first. Defaults to the .maxon file in the active editor, else the workspace folder when it holds a .maxproj file."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Command-line arguments passed to the program."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Environment variables added to the program's environment."
              },
              "cwd": {
                "type": "string",
                "description": "The program's working directory. Defaults to the workspace folder."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop at the program's entry before it runs any of its own code."
              },
              "maxProcs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295,
                "description": "How many processors the program's green-thread scheduler may use (MAXON_MAX_PROCS). Unset leaves the scheduler its default."
              },
              "trace": {
                "type": "boolean",
                "default": false,
                "description": "Create the DebugStream ring the Debug Console's trace command reads. A .maxon program is then built with --debugstream; a built executable must already have been."
              },
              "stopTimeoutSeconds": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 922337203685,
                "default": 10,
                "description": "Seconds to wait for a stop, and the budget for one step (default 10)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "maxon",
            "request": "launch",
            "name": "Debug the current file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Maxon: Debug the current file",
            "description": "Build the .maxon file in the active editor and debug it.",
            "body": {
              "type": "maxon",
              "request": "launch",
              "name": "Debug the current file",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Maxon: Debug a project",
            "description": "Build the project in the workspace folder and debug it.",
            "body": {
              "type": "maxon",
              "request": "launch",
              "name": "Debug the project",
              "program": "^\"\\${workspaceFolder}\"",
              "args": []
            }
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Maxon",
      "properties": {
        "maxon.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `maxon` compiler, which also provides the language server. Leave empty to search `PATH`, then `~/.maxon/bin` (or `$MAXON_INSTALL/bin`), then this workspace's own build."
        },
        "maxon.formatting.insertSpaces": {
          "type": "boolean",
          "default": false,
          "description": "Use spaces instead of tabs for indentation"
        },
        "maxon.formatting.tabSize": {
          "type": "number",
          "default": 2,
          "description": "Tab size (used when insertSpaces is true)"
        }
      }
    },
    "configurationDefaults": {
      "[maxon]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "entity.name.label.maxon",
            "settings": {
              "foreground": "#808080"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "build-icons": "node scripts/build-icon-font.js && node scripts/build-extension-icon.js",
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "watch": "npm run check-types && node esbuild.js --watch",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "pretest": "npm run clean && npm run bundle && npm run compile",
    "test": "npm run test:grammar && node ./out/test/runTest.js",
    "test:grammar": "vscode-tmgrammar-snap -s source.maxon -g syntaxes/maxon.tmLanguage.json test-fixtures/**/*.maxon",
    "test:grammar:update": "vscode-tmgrammar-snap -u -s source.maxon -g syntaxes/maxon.tmLanguage.json test-fixtures/**/*.maxon",
    "test:unit": "npm run clean && npm run compile && mocha --ui tdd \"out/test/unit/**/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/vscode": "^1.107.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.7",
    "mocha": "^11.7.5",
    "opentype.js": "^2.0.0",
    "sharp": "^0.34.5",
    "ttf2woff": "^3.0.0",
    "typescript": "^6.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
