union Label
	named(text immutable ByteArray, weight Count)
	shared(callee isolated Box)
end 'Label'

function keep(value mutable Count, data immutable ByteArray) returns immutable ByteArray
	let immutable = 42
	var mutable = data
	return data
end 'keep'

typealias Frozen = Array with immutable ByteArray

function other(immutable ByteArray, isolated Count)
end 'other'

type Holder
	var frozen as immutable ByteArray
end 'Holder'

typealias SettledIndex = immutable IndexBuilder
typealias Step = function(mutable Counter)

type Reader
	function peek(immutable self) returns Count
		return 0
	end 'peek'
end 'Reader'

function negatives(seed Box) returns Box
	if seed.ready 'ready'
		return mutable (seed)
	end 'ready'
	throw isolated (seed)
	let a = not immutable (seed)
	let b = try immutable otherwise 0
	let c = freeze mutable (seed)
	let d = spawn isolated (seed)
	let e = seed and mutable (seed)
	return seed
end 'negatives'
