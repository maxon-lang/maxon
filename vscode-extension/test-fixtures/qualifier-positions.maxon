type Foo
	var n as Count
end 'Foo'

function tupleParameter(p(immutable Foo, Bar)) returns Count
	return 0
end 'tupleParameter'

type Pocket
	var pair as (immutable Foo, Bar)
end 'Pocket'

function tupleResult(first Foo, second Bar) returns (immutable Foo, Bar)
	return (first, second)
end 'tupleResult'

typealias Visit = function(Foo)
typealias Look = function(a T, immutable U)
typealias Deep = function(a T, b U, immutable W)

function annotated(source Box)
	var x as Foo
	var y = source.make() as isolated Box
end 'annotated'

typealias Pair = immutable (X, Y)
typealias Plain = immutable int
typealias Frozen = immutable Box

function exchange(seed Box)
	swap seed with mutable(seed)
end 'exchange'

type Reader
	function peek(immutable self) returns Count
		return 0
	end 'peek'

	function grow(mutable self, by Count)
	end 'grow'
end 'Reader'

function stacked(box mutable isolated Box)
end 'stacked'

typealias Table = Map with (K, immutable V)
typealias Bare = Map with K, immutable V
typealias Shelf = Array with V

function closures()
	let a = function(box mutable Foo, by Count) gives by
	let b = function(immutable) gives 1
end 'closures'

type Cell uses T where T is isolated
end 'Cell'

function operands(seed Box) returns Box
	if seed.ready 'ready'
		return mutable(seed)
	end 'ready'

	throw isolated(seed)
	let a = not immutable(seed)
	let b = try immutable otherwise 0
	let c = freeze mutable(seed)
	let d = spawn isolated(seed)
	let e = seed and mutable(seed)
	let f = merge isolated(seed)
	let g = seed and ordinary(seed)
	let immutable = 1
	var mutable = 2
	let tail = seed
	isolated(tail)
	return seed
end 'operands'

function twice(mutable Count)
	return 0
end 'twice'

union Payload
	named(mutable Count)
	pair(first Count, box mutable Foo)

	function use(immutable self, seed Box)
		pass(seed, mutable (seed))
		pass(seed, into: mutable (seed))
	end 'use'

	function guarded(immutable self, seed Box)
		if seed.ready 'ready'
			pass(seed, mutable (seed))
			pass(seed, into: mutable (seed))
		end 'ready'
	end 'guarded'
end 'Payload'
