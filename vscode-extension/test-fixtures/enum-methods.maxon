enum Shade
	light = 1
	dark = 2
	mixed

	function rank(immutable self) returns int
		if self == Shade.light 'isLight'
			return 1
		end 'isLight'

		record(self, 2)
		return 0
	end 'rank'

	static function lightest() returns Self
		return Shade.light
	end 'lightest'

	function flag(immutable self) returns bool
		return true
	end 'flag'
end 'Shade'

union Shape
	circle(radius float)
	square(side int)
	empty

	function area(immutable self) returns float
		match self 'kind'
			circle(r) then return r * r
			square(s) then return 0.0
			empty then return 0.0
		end 'kind'
	end 'area'

	function render(immutable self, label cstring, small bool)
		draw(label, mutable (label))
		var total = 0
		for index in 0 upto 3 'each'
			emit(index, total)
		end 'each'
	end 'render'

	static function make(width int, tag byte) returns Self
		return Self.empty
	end 'make'
end 'Shape'

enum Mode
	fast
	slow

	function pick(immutable self) returns int
		return 0
	end 'pick'
end 'Mode'

function primitives(a int, b float, c bool, d cstring, e byte) returns int
	var count as int = 0
	let ratio as float = 1.0
	let limit = u8.max
	let low = i64.min
	let u8 = 3
	let wide = f64.max
	return count
end 'primitives'

typealias Small = int(0 to u16.max)
typealias Signed = int(i8.min to i8.max)
typealias Layout = bits(8)

type Counter
	var n as int

	function bump(mutable self, step int) returns Self
		return Self{n: self.n + step}
	end 'bump'

	function same(immutable self, other Self) returns bool
		return self.n == other.n
	end 'same'
end 'Counter'
