---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import MaxonCode from '../components/MaxonCode.astro';

// Real, compilable programs imported verbatim from the compiler repo's examples/
// directory (copied into src/examples). The ?raw import keeps them byte-accurate.
import hello from '../examples/hello.maxon?raw';
import maxgrep from '../examples/maxgrep.maxon?raw';
import spectralNorm from '../examples/spectral-norm.maxon?raw';
import nbody from '../examples/nbody.maxon?raw';
import fannkuch from '../examples/fannkuch-redux.maxon?raw';
import binaryTrees from '../examples/binary-trees.maxon?raw';

type Example = {
  file: string;
  title: string;
  blurb: string;
  code: string;
  tour?: string;
  tourLabel?: string;
};

const examples: Example[] = [
  {
    file: 'hello.maxon',
    title: 'Hello, world',
    blurb:
      'The smallest complete program. Shows the shape every Maxon program has: a main that returns an ExitCode, and a labeled end that names what it closes.',
    code: hello,
  },
  {
    file: 'maxgrep.maxon',
    title: 'maxgrep — a parallel grep',
    blurb:
      'A complete grep: recursive directory search, its own Pike-style regular-expression engine, and a pool of spawned services that search files in parallel while the output stays in order. Shows ranged and container aliases, raw-value enums, a union, an interface with two implementations, closures as values, async coroutines, spawn, and what ownership requires at a message boundary.',
    tour: '/docs/getting-started/tour/',
    tourLabel: 'Read the guided tour',
    code: maxgrep,
  },
  {
    file: 'spectral-norm.maxon',
    title: 'Spectral norm',
    blurb:
      "Computes the largest eigenvalue of an infinite matrix with the power method. Shows ranged type aliases, try … otherwise inside hot loops, and labeled nesting.",
    code: spectralNorm,
  },
  {
    file: 'nbody.maxon',
    title: 'N-body simulation',
    blurb:
      'A classic gravitational simulation of the outer solar system. Shows struct types with methods, static constructors, and named arguments.',
    code: nbody,
  },
  {
    file: 'fannkuch-redux.maxon',
    title: 'Fannkuch-redux',
    blurb:
      'Generates every permutation of an array and counts pancake flips. Shows array manipulation and integer-heavy control flow.',
    code: fannkuch,
  },
  {
    file: 'binary-trees.maxon',
    title: 'Binary trees',
    blurb:
      'Builds, checks and frees tens of thousands of trees to stress memory management. Shows a union whose cases carry data, an arena that names children by index, exhaustive match, and reading a command-line argument that may be malformed.',
    code: binaryTrees,
  },
];
---

<MarketingLayout
  title="Examples — Maxon"
  description="Real, compilable Maxon programs: a parallel grep with its own regex engine, a spectral-norm computation, an N-body simulation, and the fannkuch-redux and binary-trees benchmarks."
  path="/examples/"
>
  <section class="mx-auto max-w-4xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Examples</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-300">
      These are complete, compilable programs straight from the Maxon repository — the same
      files you can run with <code class="rounded bg-ink-800 px-1.5 py-0.5 font-mono text-sm text-brand-300">maxon run</code>.
      Each one leans on a different part of the language.
    </p>

    <div class="mt-12 space-y-16">
      {
        examples.map((ex) => (
          <article>
            <h2 class="text-xl font-bold text-white">{ex.title}</h2>
            <p class="mt-2 max-w-2xl text-slate-400">{ex.blurb}</p>
            {ex.tour && (
              <p class="mt-2">
                <a class="font-semibold text-brand-300 hover:text-brand" href={ex.tour}>
                  {ex.tourLabel} →
                </a>
              </p>
            )}
            <div class="mt-4">
              <MaxonCode code={ex.code} title={ex.file} />
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-16 rounded-xl border border-ink-700 bg-ink-950/60 p-6">
      <p class="text-slate-300">
        Want to walk through the language step by step instead?
        <a class="font-semibold text-brand-300 hover:text-brand" href="/docs/getting-started/first-program/">
          Start with your first program →
        </a>
      </p>
    </div>
  </section>
</MarketingLayout>
