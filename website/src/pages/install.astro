---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PlatformTabs from '../components/PlatformTabs.astro';
import Terminal from '../components/Terminal.astro';
import { INSTALL_POWERSHELL, INSTALL_POWERSHELL_ANY_SHELL, INSTALL_SCRIPT } from '../install';
import { RELEASE_VERSION } from '../version';

// Prebuilt downloads are published as GitHub Release assets on the compiler repo.
//
// ⚠ THE LINKS ARE VERSIONED, NOT `latest/download`. That shortcut resolves to the newest release but
// still needs the exact ASSET FILENAME, and ours carry the version (`maxon-0.1.0-x64-windows.zip`) —
// so a `latest/download` link would 404 the day the next release ships while looking perfectly correct here.
const RELEASES = 'https://github.com/maxon-lang/maxon/releases';

const version = RELEASE_VERSION;

const downloads = [
  {
    os: 'Windows',
    arch: 'x64',
    asset: `maxon-${version}-x64-windows.zip`,
    note: 'Windows 10/11, 64-bit',
  },
  {
    os: 'macOS',
    arch: 'arm64',
    asset: `maxon-${version}-arm64-macos.tar.gz`,
    note: 'Apple silicon',
  },
  {
    os: 'Linux',
    arch: 'x64',
    asset: `maxon-${version}-x64-linux.tar.gz`,
    note: 'Static, no libc needed',
  },
  {
    os: 'Linux',
    arch: 'arm64',
    asset: `maxon-${version}-arm64-linux.tar.gz`,
    note: 'Static, no libc needed',
  },
];

// ⚠ THE LABELS ARE SHARED WITH THE DOCS' <Tabs syncKey="os"> — see PlatformTabs.astro.
const unix = { id: 'unix', label: 'macOS & Linux', platforms: ['macos', 'linux'] };
const windows = { id: 'windows', label: 'Windows' };

const installCommands = [
  { ...unix, lines: [INSTALL_SCRIPT] },
  { ...windows, lines: [INSTALL_POWERSHELL] },
];

const pinnedCommands = [
  { ...unix, lines: [`${INSTALL_SCRIPT} -s -- --version ${version}`] },
  { ...windows, lines: [`& ([scriptblock]::Create((irm https://maxon.dev/install.ps1))) -Version ${version}`] },
];

const uninstallCommands = [
  { ...unix, lines: ['rm -rf ~/.maxon'] },
  { ...windows, lines: ['Remove-Item -Recurse -Force $HOME\\.maxon'] },
];

const assetUrl = (asset: string) => `${RELEASES}/download/v${version}/${asset}`;
const code = 'font-mono text-brand-300';
---

<MarketingLayout
  title="Install Maxon"
  description="Install Maxon with one command, keep it current, and set up the VS Code extension."
  path="/install/"
>
  <section class="mx-auto max-w-3xl px-5 py-16">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Install Maxon</h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-300">
      Maxon is one compiler and the standard library it reads — no runtime, no toolchain, no SDK.
      One command installs both.
    </p>

    <!-- Install -->
    <h2 class="mt-12 text-2xl font-bold text-white">Install</h2>

    <div class="mt-5">
      <PlatformTabs tabs={installCommands} ariaLabel="Choose your platform" />
    </div>

    <p class="mt-4 text-sm text-slate-400">
      The script downloads the release for your machine, checks it against the release's published
      SHA-256 checksums, and installs it into <code class={code}>~/.maxon</code> (<code class={code}
        >%USERPROFILE%\.maxon</code
      > on Windows): the compiler in <code class={code}>bin</code>, the standard library beside it.
      It adds <code class={code}>bin</code> to your <code class={code}>PATH</code>. It needs no
      administrator rights, and there is no Gatekeeper or SmartScreen prompt, because neither applies
      to a download made from a terminal. Read the scripts first if you like:{' '}
      <a class="text-brand-300 hover:text-brand" href="/install.sh">install.sh</a>,{' '}
      <a class="text-brand-300 hover:text-brand" href="/install.ps1">install.ps1</a>.
    </p>
    <p class="mt-3 text-sm text-slate-400">
      On macOS and Linux, open a new terminal, or run the <code class={code}>export</code> line the
      script prints, and <code class={code}>maxon</code> is ready. On Windows, run the command in
      PowerShell; from <code class={code}>cmd.exe</code>, use{' '}
      <code class={code}>{INSTALL_POWERSHELL_ANY_SHELL}</code> and open a new terminal afterwards.
    </p>

    <!-- Upgrade -->
    <h2 class="mt-12 text-2xl font-bold text-white">Upgrading</h2>
    <div class="mt-5">
      <Terminal><pre><span class="text-slate-500">$</span> maxon upgrade</pre></Terminal>
    </div>
    <p class="mt-4 text-sm text-slate-400">
      It runs the install script again, against the install it runs from, and says so when you already
      have the newest release. <code class={code}>maxon upgrade --dry-run</code> prints what it would run.
      A Homebrew install, the Docker image and a build from source each have their own way to update, and
      <code class={code}>maxon upgrade</code> names it rather than touching them.
    </p>

    <!-- Specific version -->
    <h2 class="mt-12 text-2xl font-bold text-white">Installing a specific version</h2>
    <div class="mt-5">
      <PlatformTabs tabs={pinnedCommands} ariaLabel="Choose your platform" />
    </div>
    <p class="mt-4 text-sm text-slate-400">
      Every release is listed on{' '}
      <a class="text-brand-300 hover:text-brand" href={RELEASES} target="_blank" rel="noopener">GitHub</a>.{' '}
      <code class={code}>--force</code> (<code class={code}>-Force</code>) reinstalls a release you
      already have, and <code class={code}>--no-modify-path</code> (<code class={code}>-NoPathUpdate</code>)
      leaves your <code class={code}>PATH</code> alone.
    </p>

    <!-- Environment -->
    <h2 class="mt-12 text-2xl font-bold text-white">Environment variables</h2>
    <dl class="mt-4 space-y-4 text-slate-300">
      <div>
        <dt><code class={code}>MAXON_INSTALL</code></dt>
        <dd class="mt-1 text-sm text-slate-400">
          Where Maxon is installed. Defaults to <code class={code}>~/.maxon</code>, or{' '}
          <code class={code}>%USERPROFILE%\.maxon</code> on Windows.
        </dd>
      </div>
      <div>
        <dt><code class={code}>MAXON_DOWNLOAD_BASE</code></dt>
        <dd class="mt-1 text-sm text-slate-400">
          A mirror of the release assets, laid out as{' '}
          <code class={code}>&lt;base&gt;/v&lt;version&gt;/&lt;asset&gt;</code>. A mirror has no
          "latest", so it needs a version.
        </dd>
      </div>
    </dl>

    <!-- Other ways -->
    <h2 class="mt-12 text-2xl font-bold text-white">Other ways to install</h2>

    <h3 class="mt-8 text-xl font-bold text-white">Homebrew, on macOS and Linux</h3>
    <div class="mt-4">
      <Terminal><pre><span class="text-slate-500">$</span> brew install maxon-lang/tap/maxon</pre></Terminal>
    </div>
    <p class="mt-4 text-sm text-slate-400">
      The tap prefix is required — a bare <code class={code}>brew install maxon</code> resolves to
      Maxon Computer's Cinema 4D installer, a different product that happens to share the name.{' '}
      <code class={code}>brew upgrade</code> keeps it current.
    </p>

    <h3 class="mt-8 text-xl font-bold text-white">Docker</h3>
    <div class="mt-4">
      <Terminal><pre><span class="text-slate-500">$</span> docker run --rm -v "$PWD:/app" ghcr.io/maxon-lang/maxon maxon run hello.maxon</pre></Terminal>
    </div>
    <p class="mt-4 text-sm text-slate-400">
      <code class={code}>ghcr.io/maxon-lang/maxon</code> is Debian slim with a shell, for CI jobs and
      devcontainers; <code class={code}>:distroless</code> is a few megabytes with no shell, running as an
      unprivileged user. Both are built for amd64 and arm64, and tagged by release —{' '}
      <code class={code}>:{version}</code>, <code class={code}>:{version}-distroless</code>. A newer image
      is how an image upgrades: <code class={code}>docker pull</code>.
    </p>

    <h3 class="mt-8 text-xl font-bold text-white">Download an archive</h3>
    <p class="mt-3 text-slate-300">
      Prebuilt archives for {version}. Unpack one and put the directory on your{' '}
      <code class={code}>PATH</code> — the compiler finds its standard library by walking up from its
      own executable, so keep <code class={code}>maxon</code> and <code class={code}>stdlib</code>{' '}
      together. On macOS, a browser download is quarantined: clear it once with{' '}
      <code class={code}>xattr -d com.apple.quarantine maxon</code>.
    </p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        downloads.map((d) => (
          <a
            href={assetUrl(d.asset)}
            class="group flex items-center justify-between rounded-xl border border-ink-700 bg-ink-950/50 p-5 transition-colors hover:border-brand/50"
          >
            <span>
              <span class="block font-semibold text-white">
                {d.os} <span class="text-slate-500">·</span>{' '}
                <span class="font-mono text-sm text-brand-300">{d.arch}</span>
              </span>
              <span class="mt-1 block text-xs text-slate-500">{d.note}</span>
            </span>
            <span class="ml-4 rounded-lg bg-brand px-4 py-2 text-sm font-semibold text-ink-950 transition-colors group-hover:bg-brand-400">
              Download
            </span>
          </a>
        ))
      }
    </div>

    <!-- Uninstall -->
    <h2 class="mt-12 text-2xl font-bold text-white">Uninstall</h2>
    <div class="mt-5">
      <PlatformTabs tabs={uninstallCommands} ariaLabel="Choose your platform" />
    </div>
    <p class="mt-4 text-sm text-slate-400">
      Then remove the directory from your <code class={code}>PATH</code>: on macOS and Linux, delete
      the line under <code class={code}># Added by the Maxon installer</code> in your shell profile; on
      Windows, remove <code class={code}>%USERPROFILE%\.maxon\bin</code> from your user{' '}
      <code class={code}>Path</code> in "Edit environment variables for your account". A Homebrew
      install is removed with <code class={code}>brew uninstall maxon-lang/tap/maxon</code>.
    </p>

    <!-- Build from source -->
    <h2 class="mt-12 text-2xl font-bold text-white">Build from source</h2>
    <p class="mt-3 text-slate-300">
      Maxon is written in Maxon, so building it needs a Maxon compiler — there is no second
      implementation to fall back on. Install a release first, then build the tree with it.
    </p>

    <!-- Prerequisites -->
    <h3 class="mt-8 text-xl font-bold text-white">1. Prerequisites</h3>

    <ul class="mt-4 space-y-2 text-slate-300">
      <li class="flex gap-3"><span class="text-brand">›</span> Git</li>
      <li class="flex gap-3"><span class="text-brand">›</span> An installed <code class={code}>maxon</code>, from above</li>
      <li class="flex gap-3"><span class="text-brand">›</span> Node.js 20+ <span class="text-slate-500">— only needed to build the VS Code extension</span></li>
    </ul>

    <!-- Clone & build -->
    <h3 class="mt-8 text-xl font-bold text-white">2. Clone and build</h3>
    <p class="mt-3 text-slate-300">
      Put your installed compiler in <code class={code}>.bootstrap/</code> as the
      seed. It builds the compiler, which then rebuilds itself so that its own runtime is this tree's.
    </p>
    <div class="mt-4">
      <Terminal><pre><span class="text-slate-500"># clone</span>
<span class="text-brand-300">git</span> clone https://github.com/maxon-lang/maxon.git
<span class="text-brand-300">cd</span> maxon

<span class="text-slate-500"># seed with the installed compiler — the BINARY alone</span>
<span class="text-brand-300">mkdir</span> -p .bootstrap &amp;&amp; <span class="text-brand-300">cp</span> "$(command -v maxon)" .bootstrap/

<span class="text-slate-500"># build the compiler with it, twice</span>
<span class="text-brand-300">scripts/build-from-seed.sh</span></pre></Terminal>
    </div>

    <p class="mt-4 text-sm text-slate-400">
      Copy the <strong class="text-slate-300">binary</strong> into{' '}
      <code class={code}>.bootstrap/</code>, not the unpacked archive: the compiler
      finds <code class={code}>stdlib/</code> by walking up from its own
      executable, so a released standard library left beside the seed would be compiled in place of
      the checkout's own — and the build would succeed. For the same reason, build this tree with the
      compiler inside it, never the <code class={code}>maxon</code> on your PATH.
    </p>

    <!-- Verify -->
    <h3 class="mt-8 text-xl font-bold text-white">3. Compile your first program</h3>
    <p class="mt-3 text-slate-300">
      Compile and run one of the bundled examples to confirm the build works:
    </p>
    <div class="mt-4">
      <Terminal><pre><span class="text-slate-500"># compile and run an example</span>
<span class="text-brand-300">maxon-bin/.maxon/maxon</span> build examples/spectral-norm.maxon

<span class="text-slate-500"># run the full spec-test suite</span>
<span class="text-brand-300">maxon-bin/.maxon/maxon</span> spec-test</pre></Terminal>
    </div>
    <p class="mt-4 text-sm text-slate-400">
      The compiler produces a native executable next to your source file
      (<code class={code}>.exe</code> on Windows). See the{' '}
      <a class="text-brand-300 hover:text-brand" href="/docs/cli/">CLI reference</a> for every
      command and flag.
    </p>

    <!-- Editor -->
    <h2 class="mt-12 text-2xl font-bold text-white">Set up your editor</h2>
    <p class="mt-3 text-slate-300">
      The <strong class="text-white">Maxon</strong> extension for VS Code brings syntax highlighting,
      real-time diagnostics, completion and hover. Install it from the{' '}
      <a
        class="text-brand-300 hover:text-brand"
        href="https://marketplace.visualstudio.com/items?itemName=maxon-lang.maxon-lsp-client"
        target="_blank"
        rel="noopener">Visual Studio Marketplace</a
      > or{' '}
      <a
        class="text-brand-300 hover:text-brand"
        href="https://open-vsx.org/extension/maxon-lang/maxon-lsp-client"
        target="_blank"
        rel="noopener">Open VSX</a
      >. It runs the language server from the compiler you installed.
    </p>

    <div class="mt-12 rounded-xl border border-ink-700 bg-ink-950/60 p-6">
      <p class="text-slate-300">
        Installed? Head to{' '}
        <a class="font-semibold text-brand-300 hover:text-brand" href="/docs/getting-started/first-program/">
          your first program →
        </a>
      </p>
    </div>
  </section>
</MarketingLayout>
