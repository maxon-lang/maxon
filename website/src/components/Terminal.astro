---
// A terminal-styled frame for commands that are the same on every platform. Per-platform commands
// belong in PlatformTabs instead.
//
// ⚠ THE CALLER WRITES THE <pre>. `compressHTML: 'jsx'` collapses the slot's line breaks in the
// caller's markup unless they are already inside a <pre> there, so the frame styles the caller's.
interface Props {
  title?: string;
}

const { title = 'terminal' } = Astro.props;
---

<div
  class="overflow-hidden rounded-xl border border-ink-700 bg-ink-950/80 [&>pre]:overflow-x-auto [&>pre]:p-4 [&>pre]:font-mono [&>pre]:text-sm [&>pre]:leading-relaxed [&>pre]:text-slate-300"
>
  <div class="flex items-center gap-2 border-b border-ink-700 px-4 py-2.5">
    <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
    <span class="ml-2 font-mono text-xs text-slate-500">{title}</span>
  </div>
  <slot />
</div>
