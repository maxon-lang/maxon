---
// Starlight's theme provider, starting a visitor who has never chosen a theme in dark mode to match the
// marketing pages, rather than in their system's scheme. The picker still offers light and auto.
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---

{/*
  Runs before Starlight's provider and picker read the stored theme. `null` is "never chose"; Starlight
  stores "auto" as an empty string, so that choice is kept.
*/}
<script is:inline>
  try {
    if (localStorage.getItem('starlight-theme') === null) localStorage.setItem('starlight-theme', 'dark');
  } catch (e) {
    // Storage is blocked, so there is no choice to seed.
  }
</script>
<Default />
