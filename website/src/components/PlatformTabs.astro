---
// A terminal-styled, per-platform command block with a tab strip; each panel has its own copy button.
//
// ⭐ EVERY PANEL IS RENDERED, so the block still says everything with JavaScript off — the panels
// simply stack, each under its own heading. The tab strip is revealed only once the script runs and
// the headings are hidden in the same breath, so there is never a moment showing both.
//
// ⚠ THE VISITOR'S PLATFORM IS A PRESELECTION, NEVER A FILTER. Someone on Linux reading about the
// Windows installer is a normal thing to be doing, and a detected platform that HID the others would
// make that impossible.
//
// 🔗 SHARES ITS SELECTION WITH STARLIGHT'S <Tabs syncKey="os">. Both read and write the same
// localStorage key, keyed by tab label, so picking Windows here leaves Windows picked in the docs and
// the other way round. Tab labels must therefore match the docs' TabItem labels exactly.
import CommandBlock from './CommandBlock.astro';

interface Tab {
  id: string;
  label: string;
  lines: string[];
  /** Detected platforms this tab is preselected for — `windows`, `macos`, `linux`. Defaults to its id. */
  platforms?: string[];
}

interface Props {
  tabs: Tab[];
  ariaLabel?: string;
  /** Printed after the commands, unprefixed — the output they produce. */
  trailing?: string;
}

const { tabs, ariaLabel = 'Choose your platform', trailing = '' } = Astro.props;
---

<div class="text-left" data-platform-tabs>
  <div class="overflow-hidden rounded-xl border border-ink-700 bg-ink-950/80 shadow-2xl shadow-black/40">
    <div class="flex items-center gap-2 border-b border-ink-700 px-4 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-600"></span>
      <div class="ml-1 flex gap-1" role="tablist" aria-label={ariaLabel} data-platform-tabs-strip hidden>
        {
          tabs.map((tab) => (
            <button
              type="button"
              role="tab"
              id={`pt-tab-${tab.id}`}
              aria-controls={`pt-panel-${tab.id}`}
              aria-selected="false"
              tabindex="-1"
              data-platform-tab={tab.id}
              class="rounded px-2 py-0.5 font-mono text-xs text-slate-500 transition-colors hover:text-slate-300 aria-selected:bg-ink-700/70 aria-selected:text-brand-300"
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>
    {
      tabs.map((tab) => (
        <div
          role="tabpanel"
          id={`pt-panel-${tab.id}`}
          aria-labelledby={`pt-tab-${tab.id}`}
          data-platform-panel={tab.id}
          data-platform-for={(tab.platforms ?? [tab.id]).join(' ')}
        >
          <div
            class="border-b border-ink-700/60 px-4 pt-3 font-mono text-xs text-slate-500"
            data-platform-heading
          >
            {tab.label}
          </div>
          <CommandBlock lines={tab.lines} trailing={trailing} />
        </div>
      ))
    }
  </div>
</div>

{/*
  ⚠ A PROCESSED SCRIPT, NOT `is:inline`. Astro bundles it once per page and runs it after the whole
  document is parsed, so it sees every instance. An inline copy runs where the FIRST instance is, before
  the later ones exist, and a once-per-page guard then leaves them never initialized.
*/}
<script>
  type Platform = 'windows' | 'macos' | 'linux';

  // Starlight persists its synced tabs as `starlight-synced-tabs__<syncKey>` holding the chosen tab's
  // LABEL. Reading and writing that key is the whole of the integration.
  const StorageKey = 'starlight-synced-tabs__os';

  function detect(): Platform | null {
    // userAgentData is the non-deprecated source, but it is Chromium-only and absent over plain HTTP,
    // so userAgent stays the fallback.
    const hints = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData;
    const hay = `${hints?.platform ?? ''} ${navigator.userAgent}`.toLowerCase();

    if (hay.includes('win')) return 'windows';
    // iOS/iPadOS get the macOS tab: closest shell, and neither can run the compiler anyway. Android is
    // asked before Linux because Android UAs say "Linux".
    if (hay.includes('android')) return 'linux';
    if (/mac|iphone|ipad|ipod/.test(hay)) return 'macos';
    if (hay.includes('linux') || hay.includes('x11')) return 'linux';
    return null;
  }

  function readStored(): string | null {
    try {
      return localStorage.getItem(StorageKey);
    } catch {
      // Storage can throw outright in a locked-down browser, not merely return null.
      return null;
    }
  }

  function writeStored(label: string) {
    try {
      localStorage.setItem(StorageKey, label);
    } catch {
      // A preference that cannot be persisted is not worth failing the page over.
    }
  }

  const labelOf = (tab: HTMLElement) => (tab.textContent ?? '').trim();

  interface Instance {
    tabs: HTMLElement[];
    select: (id: string) => void;
  }

  function initialize(root: HTMLElement): Instance {
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-platform-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-platform-panel]')];

    if (tabs.length === 0 || panels.length === 0) {
      throw new Error('PlatformTabs: an instance rendered with no tabs or no panels');
    }

    function select(id: string) {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.platformPanel !== id;
      });
      tabs.forEach((tab) => {
        const on = tab.dataset.platformTab === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
    }

    root.querySelectorAll<HTMLElement>('[data-platform-heading]').forEach((heading) => {
      heading.hidden = true;
    });
    root.querySelector<HTMLElement>('[data-platform-tabs-strip]')!.hidden = false;

    // A stored choice was made deliberately, so it outranks a sniffed platform.
    const stored = readStored();
    const storedTab = tabs.find((tab) => labelOf(tab) === stored);
    const detected = detect();
    const matched = panels.find((panel) => (panel.dataset.platformFor ?? '').split(' ').includes(detected ?? ''));
    select(storedTab?.dataset.platformTab ?? (matched ?? panels[0]).dataset.platformPanel!);

    return { tabs, select };
  }

  const instances = [...document.querySelectorAll<HTMLElement>('[data-platform-tabs]')].map(initialize);

  // A choice in one instance is made in every instance that has a tab of that label, and only an actual
  // choice is stored — never the detected default, which would freeze a guess as though it were made.
  function choose(label: string) {
    writeStored(label);
    instances.forEach(({ tabs, select }) => {
      const tab = tabs.find((candidate) => labelOf(candidate) === label);
      if (tab) select(tab.dataset.platformTab!);
    });
  }

  instances.forEach(({ tabs }) => {
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => choose(labelOf(tab)));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        choose(labelOf(next));
        next.focus();
      });
    });
  });
</script>
