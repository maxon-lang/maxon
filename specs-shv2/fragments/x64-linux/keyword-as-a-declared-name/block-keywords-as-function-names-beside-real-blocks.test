// Test: block-keywords-as-function-names-beside-real-blocks
typealias Integer = int(i64.min to i64.max)

enum Grade
	low
	high
end 'Grade'

type Ops
	export static function while(n Integer) returns Integer
		return n * 2
	end 'while'

	export static function for(n Integer) returns Integer
		return n + 3
	end 'for'

	export static function end(n Integer) returns Integer
		return n - 1
	end 'end'
end 'Ops'

function match(n Integer) returns Integer
	return n + 1
end 'match'

function if(n Integer) returns Integer
	if n > 4 'big'
		return 2
	end 'big'
	return 1
end 'if'

function grade(n Integer) returns Grade
	if n > 1 'high'
		return Grade.high
	end 'high'
	return Grade.low
end 'grade'

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'count'
		total = total + Ops.while(i)
		i = i + 1
	end 'count'

	for j in 0 upto 3 'walk'
		total = total + Ops.for(j)
	end 'walk'

	if total > 0 'positive'
		total = total + Ops.end(10)
	end 'positive' else 'negative'
		total = total - 1
	end 'negative'

	let bonus = match grade(if(5)) 'pick'
		low gives 5
		high gives 15
	end 'pick'

	return total + bonus
end 'main'
---
ExitCode: 42
---
func @Ops.while {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @Ops.for {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 3
    x64.popReg rbp
    x64.ret
}

func @Ops.end {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, -1
    x64.popReg rbp
    x64.ret
}

func @if {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 4
    x64.jcc greater, big
    x64.jmp ifcont
  big:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @grade {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 1
    x64.jcc greater, high
    x64.jmp ifcont
  high:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 3
    x64.jcc less, count
    x64.jmp whileexit
  count:
    x64.movRegReg rcx, r12
    x64.callDirect Ops.while
    x64.leaRegRegReg rbx, rbx, r8
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 r12, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r12, 3
    x64.jcc less, walk
    x64.jmp forexit
  walk:
    x64.movRegReg rcx, r12
    x64.callDirect Ops.for
    x64.leaRegRegReg rbx, rbx, r8
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc greater, positive
    x64.jmp ifelse
  positive:
    x64.movRegImm32 rcx, 10
    x64.callDirect Ops.end
    x64.leaRegRegReg rbx, rbx, r8
    x64.jmp ifcont
  ifelse:
    x64.leaRegRegImm32 rbx, rbx, -1
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 5
    x64.callDirect if
    x64.movRegReg rcx, r8
    x64.callDirect grade
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matcharm#11
    x64.jmp matchnext
  matcharm#11:
    x64.movRegImm32 rax, 5
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, matcharm#12
    x64.jmp matchdead
  matcharm#12:
    x64.movRegImm32 rax, 15
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegReg r8, rbx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
