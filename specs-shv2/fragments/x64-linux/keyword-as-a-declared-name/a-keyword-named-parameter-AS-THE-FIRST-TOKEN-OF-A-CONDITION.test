// Test: a-keyword-named-parameter-AS-THE-FIRST-TOKEN-OF-A-CONDITION
typealias Integer = int(i64.min to i64.max)

function twosComplementDistance(to Integer, from Integer) returns Integer
	if to >= from 'forward'
		return to - from
	end 'forward'

	return (from - to) * -1
end 'twosComplementDistance'

function span(to Integer, from Integer) returns Integer
	var acc = 0
	var k = from
	while to > k 'spin'
		acc = acc + 1
		k = k + 1
	end 'spin'

	return acc
end 'span'

function weight(to Integer) returns Integer
	return match to 'pick'
		1 gives 100
		2 gives 4
		default gives 0
	end 'pick'
end 'weight'

function main() returns ExitCode
	return (twosComplementDistance(50, from: 8) + span(4, from: 1) + weight(2)) as ExitCode
end 'main'
---
ExitCode: 49
---
func @twosComplementDistance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forward
    x64.jmp ifcont
  forward:
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rdx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.subRegReg rdx, rdx, rcx
    x64.imulRegRegImm32 r8, rdx, -1
    x64.popReg rbp
    x64.ret
}

func @span {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, spin
    x64.jmp whileexit
  spin:
    x64.leaRegRegImm32 r8, r8, 1
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
}

func @weight {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 100
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 50
    x64.movRegImm32 rdx, 8
    x64.callDirect twosComplementDistance
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 1
    x64.callDirect span
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect weight
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
