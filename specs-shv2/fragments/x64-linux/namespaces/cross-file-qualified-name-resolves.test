// Test: cross-file-qualified-name-resolves
// --- file: utils/helper.maxon
typealias Integer = int(i64.min to i64.max)

export function qualifiedHelper() returns Integer
	return 42
end 'qualifiedHelper'

// --- file: app/main.maxon
function main() returns ExitCode
	return utils.qualifiedHelper()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect qualifiedHelper
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @qualifiedHelper {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
