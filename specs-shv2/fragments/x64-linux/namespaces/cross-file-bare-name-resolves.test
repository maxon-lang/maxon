// Test: cross-file-bare-name-resolves
// --- file: utils/helper.maxon
typealias Integer = int(i64.min to i64.max)

export function bareHelper() returns Integer
	return 42
end 'bareHelper'

// --- file: app/main.maxon
function main() returns ExitCode
	return bareHelper()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect bareHelper
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @bareHelper {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
