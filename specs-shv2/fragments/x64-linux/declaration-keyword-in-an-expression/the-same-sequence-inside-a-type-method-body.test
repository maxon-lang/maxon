// Test: the-same-sequence-inside-a-type-method-body
typealias Idx = int(0 to 100)

enum Marker
	function
	other
end 'Marker'

type Holder
	export var base as Idx

	export static function create() returns Holder
		return Self{base: 20}
	end 'create'

	export function trips(m Marker, flag bool) returns Idx
		if m == Marker.function and (flag or not flag) 'both'
			return self.base
		end 'both'
		return 0
	end 'trips'
end 'Holder'

union Victim
	found(index Idx)
	absent
end 'Victim'

function pick(v Victim) returns Idx
	match v 'v'
		found(index) then return index
		absent then return 0
	end 'v'
end 'pick'

function main() returns ExitCode
	let h = Holder.create()
	return (h.trips(Marker.function, flag: true) + pick(Victim.found(22))) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.leaRegSlot rax, slot0
    x64.movRegImm32 rcx, 20
    x64.storeBaseDispReg.word64 [rax + 0], rcx
  andrhs:
    x64.movRegImm32 rcx, 1
  scmerge:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  both:
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.jmp __il_cont#5
  ifcont:
    x64.movRegImm32 rbx, 0
  __il_cont#5:
    x64.movRegImm32 r12, 22
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], r12
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#14:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.jmp __il_cont#4
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#15:
    x64.movRegImm32 rax, 0
  __il_cont#4:
    x64.leaRegRegReg rbx, rbx, rax
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at the-same-sequence-inside-a-type-method-body.test:38: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
