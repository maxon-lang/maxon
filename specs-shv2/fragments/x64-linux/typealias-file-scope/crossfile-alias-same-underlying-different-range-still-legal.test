// Test: crossfile-alias-same-underlying-different-range-still-legal
// --- file: a.maxon
typealias Span = int(0 to 20)

export function fromA() returns ExitCode
	return 20 as Span
end 'fromA'

// --- file: b.maxon
typealias Span = int(0 to 4000)

export function fromB() returns ExitCode
	return 22 as Span
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	return fromA() + fromB()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body#6
  __il_body#6:
    x64.movRegImm32 rax, 20
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.jmp __il_body#7
  __il_body#7:
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.leaRegRegImm32 r8, rax, 22
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
