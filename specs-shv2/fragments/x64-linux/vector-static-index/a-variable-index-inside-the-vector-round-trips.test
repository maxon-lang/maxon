// Test: a-variable-index-inside-the-vector-round-trips
typealias Int = int(i64.min to i64.max)
typealias Vec4 = Vector with 4 Int

function main() returns ExitCode
	var v = Vec4.create()
	var i = 0
	while i < 4 'fill'
		try v.set(i, value: i * 11) otherwise panic("test invariant: set OOB")
		i = i + 1
	end 'fill'
	var total = 0
	var r = 2
	while r < 3 'read'
		total = total + (try v.get(r) otherwise 0)
		r = r + 1
	end 'read'
	return total
end 'main'
---
ExitCode: 22
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rdx, 4
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr#1
  whilehdr#1:
    x64.cmpRegImm32 r12, 4
    x64.jcc less, fill
    x64.jmp whileexit#3
  fill:
    x64.imulRegRegImm32 rax, r12, 11
    x64.leaRegRdata r9, [rip + __layout_Vector_N4_Int]
    x64.movRegImm32 rsi, 4
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#4:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 2
    x64.jmp whilehdr#6
  whilehdr#6:
    x64.cmpRegImm32 r13, 3
    x64.jcc less, read
    x64.jmp whileexit#8
  read:
    x64.leaRegRdata rax, [rip + __layout_Vector_N4_Int]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#10
    x64.jmp tryok#9
  tryerr#10:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok#9:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg r12, r12, rax
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp whilehdr#6
  whileexit#8:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.count {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rdx
    x64.popReg rbp
    x64.ret
}

func @Vector.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.leaRegRegImm32 r10, rbx, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __retain_type_param
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.set {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg r14, r9
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, rsi
    x64.callDirect Vector.count
    x64.cmpRegReg r12, r8
    x64.jcc greaterEqual, pastTheFixedSize
    x64.jmp ifcont
  pastTheFixedSize:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r13
    x64.callDirect __drop_type_param
    x64.leaRegRegImm32 r10, rbx, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
