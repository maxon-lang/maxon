// Test: a-bit-packed-bool-vector-at-constant-indexes
typealias Bits16 = Vector with 16 bool

function main() returns ExitCode
	var v = Bits16.create()
	try v.set(0, value: true) otherwise panic("test invariant: set OOB")
	try v.set(7, value: true) otherwise panic("test invariant: set OOB")
	try v.set(8, value: true) otherwise panic("test invariant: set OOB")
	try v.set(15, value: true) otherwise panic("test invariant: set OOB")
	let b0 = try v.get(0) otherwise false
	let b7 = try v.get(7) otherwise false
	let b8 = try v.get(8) otherwise false
	let b15 = try v.get(15) otherwise false
	let b1 = try v.get(1) otherwise true
	var count = 0
	if b0 'zero'
		count = count + 1
	end 'zero'
	if b7 'seven'
		count = count + 2
	end 'seven'
	if b8 'eight'
		count = count + 4
	end 'eight'
	if b15 'fifteen'
		count = count + 8
	end 'fifteen'
	if b1 'one'
		count = count + 16
	end 'one'
	return count
end 'main'
---
ExitCode: 15
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Vector_N16_bool]
    x64.movRegImm32 rdx, 16
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N16_bool]
    x64.movRegImm32 rsi, 16
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 7
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N16_bool]
    x64.movRegImm32 rsi, 16
    x64.movRegReg rcx, rbx
