    x64.jcc equal, ifcont#25
  zero:
    x64.movRegImm32 rcx, 1
  ifcont#25:
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, ifcont#27
  seven:
    x64.leaRegRegImm32 rcx, rcx, 2
  ifcont#27:
    x64.cmpRegImm32 r14, 0
    x64.jcc equal, ifcont#29
  eight:
    x64.leaRegRegImm32 rcx, rcx, 4
  ifcont#29:
    x64.cmpRegImm32 r15, 0
    x64.jcc equal, ifcont#31
  fifteen:
    x64.leaRegRegImm32 rcx, rcx, 8
  ifcont#31:
