// Test: write-back-through-a-loop-carried-string-payload-is-the-same-answer
union Expr
	direct(s String)
	unresolved
end 'Expr'

function main() returns ExitCode
	var e = Expr.direct("the first payload, long enough to be a real heap allocation")
	var total = 0

	for i in 1 to 2 'round'
		total = total + i
		match e 'write'
			direct(s) then s = "a replacement, also a real heap allocation"
			unresolved then total = total + 1
		end 'write'
		e = Expr.direct("the next round's payload, a real heap allocation too")
	end 'round'

	return total
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 1
    x64.movRegReg rcx, r12
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot2, rcx
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rax, 2
    x64.jcc lessEqual, round
    x64.jmp forexit
  round:
    x64.leaRegRegReg rax, rbx, rax
    x64.storeSlotReg slot1, rax
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#5
    x64.jmp matchnext
  matcharm#5:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rcx + 8], rax
    x64.leaRegRdata rax, [rip + __str_rec_4]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [rax + 8], r14
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.loadRegSlot rbx, slot1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchdead
  matcharm#6:
    x64.loadRegSlot rax, slot1
    x64.leaRegRegImm32 rbx, rax, 1
    x64.jmp matchcont
  matchcont:
    x64.leaRegRdata r12, [rip + __str_rec_5]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.loadRegSlot rcx, slot2
    x64.callDirect __destruct_Expr
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg rcx, r13
    x64.jmp forhdr
  matchdead:
  forexit:
    x64.loadRegSlot rcx, slot2
    x64.callDirect __destruct_Expr
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
