// Test: borrowed-bind-then-the-owner-moves-it-out
typealias Integer = int(i64.min to i64.max)

type Body
	export var mass as Integer

	static function create(mass Integer) returns Self
		return Self{mass: mass}
	end 'create'
end 'Body'

union Shape
	empty
	solid(body Body)
end 'Shape'

function massOf(s Shape) returns Integer
	return match s 'check'
		empty gives 1
		solid(b) gives b.mass
	end 'check'
end 'massOf'

function main() returns ExitCode
	let s = Shape.solid(Body.create(3))
	let borrowed = massOf(s)
	let owned = match s 'own'
		empty gives 1
		solid(b) gives b.mass
	end 'own'
	return (borrowed + owned) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Body.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @massOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
  matchcont:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 3
    x64.callDirect Body.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.movRegReg rcx, r12
    x64.callDirect massOf
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.loadRegBaseDisp.word64 r13, [rcx + 0]
    x64.callDirect __mm_decref
    x64.movRegReg rax, r13
  matchcont:
    x64.leaRegRegReg rbx, rbx, rax
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Shape
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
