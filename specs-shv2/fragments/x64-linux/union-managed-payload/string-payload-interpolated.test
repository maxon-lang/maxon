// Test: string-payload-interpolated

union Message
	silent
	text(body String)
end 'Message'

function main() returns ExitCode
	let m = Message.text("v{41}")
	match m 'check'
		silent then return 0
		text(s) then print(s)
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
