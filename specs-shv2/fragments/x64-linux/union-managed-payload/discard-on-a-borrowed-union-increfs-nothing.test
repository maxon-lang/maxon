// Test: discard-on-a-borrowed-union-increfs-nothing
typealias Integer = int(i64.min to i64.max)

union Message
	silent
	text(body String, code Integer)
end 'Message'

function codeOf(m Message) returns Integer
	return match m 'k'
		silent gives 0
		text(_, tag) gives tag
	end 'k'
end 'codeOf'

function main() returns ExitCode
	let m = Message.text("a discarded payload string long enough to be a heap one", code: 4)
	let a = codeOf(m)
	let b = codeOf(m)
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 r12, 4
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.storeBaseDispReg.word64 [r13 + 16], r12
  __il_body#6:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#10
  matcharm#7:
    x64.movRegImm32 rax, 0
    x64.jmp __il_body#12
  matchnext#10:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#9
  matcharm#8:
    x64.loadRegBaseDisp.word64 rax, [r13 + 16]
  __il_body#12:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext#16
  matcharm#13:
    x64.movRegImm32 rcx, 0
    x64.jmp __il_cont
  matchnext#16:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead#15
  matcharm#14:
    x64.loadRegBaseDisp.word64 rcx, [r13 + 16]
  __il_cont:
    x64.leaRegRegReg rbx, rax, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Message
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#15:
  matchdead#9:
}
