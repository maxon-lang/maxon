// Test: borrowed-bind-two-levels-deep-then-the-owner-moves-it-out
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function inner(m M) returns Integer
	return match m 'k'
		silent gives 0
		text(s) gives 3
	end 'k'
end 'inner'

function outer(m M) returns Integer
	let first = match m 'k'
		silent gives 0
		text(s) gives 4
	end 'k'
	return first + inner(m)
end 'outer'

function main() returns ExitCode
	let m = M.text("a payload string handed down two borrow levels, heap-long")
	let a = outer(m)
	match m 'own'
		silent then return 0
		text(s) then print(s)
	end 'own'
	return a as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @inner {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
  matchcont:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @outer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegImm32 r13, 4
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegReg r12, r13
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect inner
    x64.leaRegRegReg r8, r12, r8
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegReg rcx, r12
    x64.callDirect outer
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegReg rcx, r13
    x64.callDirect print
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
  matchcont:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_M
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
