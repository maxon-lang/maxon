// Test: mod-simple
function main() returns ExitCode
	return 17 mod 5
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 17
    x64.movRegImm32 rcx, 5
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg r8, rdx
    x64.popReg rbp
    x64.ret
}
