// Test: div-mod-variables
function main() returns ExitCode
	let a = 100
	let b = 7
	let q = a / b
	let r = a mod b
	return q + r
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 100
    x64.movRegImm32 rsi, 7
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.movRegReg rdi, rax
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.leaRegRegReg r8, rdi, rdx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
