// Test: an-unsigned-remainder-at-u64-max-is-not-the-overflow-case
typealias NonZeroWord = int(1 to u64.max)
typealias Any64 = int(i64.min to i64.max)

function ident(v Any64) returns Any64
	return v
end 'ident'

function main() returns ExitCode
	let big = ident(0 - 1) as NonZeroWord
	print("r={5 mod big}\n")
	print("q={5 / big}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @ident {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -1
    x64.callDirect ident
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_ok
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 1
    x64.jcc less, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 rcx, r8, 0
    x64.storeSlotReg slot0, rcx
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.movRegReg r13, rdx
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot5, rax
    x64.leaRegRegReg rcx, r12, r13
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot7
    x64.loadRegSlot r12, slot5
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot3
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rdx, 0
    x64.loadRegSlot rcx, slot0
    x64.divReg rcx
    x64.movRegReg r13, rax
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.movRegReg r13, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot8, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot6, rax
    x64.leaRegRegReg rcx, r12, r13
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot8
    x64.loadRegSlot r12, slot6
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot4
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
