// Test: div-precedence
function main() returns ExitCode
	return 10 + 20 / 4
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 20
    x64.movRegImm32 rcx, 4
    x64.cqo
    x64.idivReg rcx
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}
