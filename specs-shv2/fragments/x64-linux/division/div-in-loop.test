// Test: div-in-loop
typealias Positive = int(1 to i64.max)

function main() returns ExitCode
	var sum = 0
	var i = 1
	while i <= 6 'loop'
		sum = sum + 100 / (i as Positive)
		i = i + 1
	end 'loop'
	return sum
end 'main'
---
ExitCode: 244
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rcx, 1
  whilehdr:
    x64.cmpRegImm32 rcx, 6
    x64.jcc greater, whileexit
  loop:
    x64.movRegImm32 rax, 100
    x64.cmpRegImm32 rcx, 1
    x64.jcc greaterEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.leaRegRegReg r8, r8, rax
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#7
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
