// Test: async-subprocess.the-bare-name-is-an-ordinary-declaration
function runProcess(exe int, argv int, workingDirectory int) returns int
	return exe + argv + workingDirectory
end 'runProcess'

function main() returns ExitCode
	let n = runProcess(1, argv: 2, workingDirectory: 4)
	return n as ExitCode
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.leaRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
