// Test: dispatch.dense-nonzero-enum
enum Priority
	p0 = 10
	p1 = 11
	p2 = 12
	p3 = 13
	p4 = 14
end 'Priority'

function rank(p Priority) returns ExitCode
	return match p 'm'
		p0 gives 1
		p1 gives 2
		p2 gives 3
		p3 gives 4
		p4 gives 5
	end 'm'
end 'rank'

function main() returns ExitCode
	var n = 0 as ExitCode
	if rank(Priority.p0) == 1 'a'
		n = n + 1
	end 'a'
	if rank(Priority.p1) == 2 'b'
		n = n + 1
	end 'b'
	if rank(Priority.p2) == 3 'c'
		n = n + 1
	end 'c'
	if rank(Priority.p3) == 4 'd'
		n = n + 1
	end 'd'
	if rank(Priority.p4) == 5 'e'
		n = n + 1
	end 'e'
	return n
end 'main'
---
ExitCode: 5
---
func @rank {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRegImm32 rax, rcx, -10
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_2
  matchdead:
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matcharm#4:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matcharm#5:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 10
    x64.callDirect rank
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit#14
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#14:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 11
    x64.callDirect rank
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, b
    x64.jmp critsplit#15
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#15:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 12
    x64.callDirect rank
