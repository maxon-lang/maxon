  ifcont#8:
    x64.movRegImm32 rcx, 14
    x64.callDirect rank
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, e
    x64.jmp critsplit#18
  e:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont#10
  critsplit#18:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#10
  ifcont#10:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
