// Test: dispatch.sparse-hits-misses
typealias N = int(i64.min to i64.max)

function sparse(x N) returns N
	return match x 'c'
		10 gives 1
		20 gives 2
		30 gives 3
		40 gives 4
		50 gives 5
		default gives 9
	end 'c'
end 'sparse'

function main() returns ExitCode
	var n = 0 as N
	if sparse(10) == 1 'h1'
		n = n + 1
	end 'h1'
	if sparse(30) == 3 'h3'
		n = n + 1
	end 'h3'
	if sparse(50) == 5 'h5'
		n = n + 1
	end 'h5'
	if sparse(25) == 9 'm1'
		n = n + 1
	end 'm1'
	if sparse(35) == 9 'm2'
		n = n + 1
	end 'm2'
	if sparse(9) == 9 'o1'
		n = n + 1
	end 'o1'
	if sparse(11) == 9 'o2'
		n = n + 1
	end 'o2'
	if sparse(51) == 9 'o3'
		n = n + 1
	end 'o3'
	return n as ExitCode
end 'main'
---
ExitCode: 8
---
func @sparse {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 30
    x64.jcc greaterEqual, matchhi
  matchlo:
    x64.cmpRegImm32 rcx, 10
    x64.jcc notEqual, matchnext#9
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#9:
    x64.cmpRegImm32 rcx, 20
    x64.jcc notEqual, matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rcx, 30
    x64.jcc notEqual, matchnext#10
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext#10:
    x64.cmpRegImm32 rcx, 40
    x64.jcc notEqual, matchnext#11
  matcharm#4:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext#11:
    x64.cmpRegImm32 rcx, 50
    x64.jcc notEqual, matchdefault
  matcharm#5:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 10
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, ifcont#2
  h1:
    x64.movRegImm32 rbx, 1
  ifcont#2:
    x64.movRegImm32 rcx, 30
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 3
    x64.jcc notEqual, ifcont#4
  h3:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#4:
    x64.movRegImm32 rcx, 50
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 5
    x64.jcc notEqual, ifcont#6
  h5:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#6:
    x64.movRegImm32 rcx, 25
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, ifcont#8
  m1:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#8:
    x64.movRegImm32 rcx, 35
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, ifcont#10
  m2:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#10:
    x64.movRegImm32 rcx, 9
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, ifcont#12
  o1:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#12:
    x64.movRegImm32 rcx, 11
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, ifcont#14
  o2:
    x64.leaRegRegImm32 rbx, rbx, 1
  ifcont#14:
    x64.movRegImm32 rcx, 51
    x64.callDirect sparse
    x64.cmpRegImm32 r8, 9
    x64.jcc notEqual, critsplit
  o3:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont#16
  critsplit:
    x64.movRegReg r8, rbx
  ifcont#16:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at dispatch.sparse-hits-misses.test:41: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
