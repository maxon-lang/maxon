// Test: dispatch.or-list-nonadjacent
typealias N = int(i64.min to i64.max)

function ored(x N) returns N
	return match x 'c'
		1 or 9 gives 1
		3 or 7 gives 2
		5 gives 3
		default gives 9
	end 'c'
end 'ored'

function main() returns ExitCode
	var n = 0 as N
	if ored(1) == 1 'a'
		n = n + 1
	end 'a'
	if ored(9) == 1 'b'
		n = n + 1
	end 'b'
	if ored(3) == 2 'c'
		n = n + 1
	end 'c'
	if ored(7) == 2 'd'
		n = n + 1
	end 'd'
	if ored(5) == 3 'e'
		n = n + 1
	end 'e'
	if ored(4) == 9 'f'
		n = n + 1
	end 'f'
	if ored(2) == 9 'g'
		n = n + 1
	end 'g'
	return n as ExitCode
end 'main'
---
ExitCode: 7
---
func @ored {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, -1
    x64.jumpTable rax, default=matchdefault [[0]=matcharm#1, [1]=matchdefault, [2]=matcharm#2, [3]=matchdefault, [4]=matcharm#3, [5]=matchdefault, [6]=matcharm#2, [7]=matchdefault, [8]=matcharm#1] @__jumptable_1
  matchdefault:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect ored
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit#18
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#18:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 9
    x64.callDirect ored
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, b
    x64.jmp critsplit#19
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#19:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 3
    x64.callDirect ored
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, c
    x64.jmp critsplit#20
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#6
  critsplit#20:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 rcx, 7
    x64.callDirect ored
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, d
    x64.jmp critsplit#21
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#8
  critsplit#21:
    x64.jmp ifcont#8
  ifcont#8:
    x64.movRegImm32 rcx, 5
    x64.callDirect ored
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, e
    x64.jmp critsplit#22
  e:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#10
  critsplit#22:
    x64.jmp ifcont#10
  ifcont#10:
    x64.movRegImm32 rcx, 4
    x64.callDirect ored
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, f
    x64.jmp critsplit#23
  f:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#12
  critsplit#23:
    x64.jmp ifcont#12
  ifcont#12:
    x64.movRegImm32 rcx, 2
    x64.callDirect ored
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, g
    x64.jmp critsplit#24
  g:
    x64.leaRegRegImm32 rax, rbx, 1
    x64.jmp ifcont#14
  critsplit#24:
    x64.movRegReg rax, rbx
    x64.jmp ifcont#14
  ifcont#14:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
