// Test: dispatch.dense-scalar-range-arm
function scalar(x int) returns int
	return match x 'm'
		0 gives 100
		1 gives 101
		2 to 4 gives 102
		5 gives 105
		7 gives 107
		default gives 999
	end 'm'
end 'scalar'

function main() returns ExitCode
	// A dense scalar table (span 8) whose `2 to 4` range arm fills THREE slots with one block; slot 6 is a
	// hole. Every covered value hits its arm; the hole, the two just-outside-span neighbours, a negative,
	// and a far value all fall to the default.
	var n = 0 as ExitCode
	if scalar(0) == 100 'a'
		n = n + 1
	end 'a'
	if scalar(3) == 102 'b'
		n = n + 1
	end 'b'
	if scalar(4) == 102 'c'
		n = n + 1
	end 'c'
	if scalar(5) == 105 'd'
		n = n + 1
	end 'd'
	if scalar(6) == 999 'e'
		n = n + 1
	end 'e'
	if scalar(7) == 107 'f'
		n = n + 1
	end 'f'
	if scalar(8) == 999 'g'
		n = n + 1
	end 'g'
	if scalar(-1) == 999 'h'
		n = n + 1
	end 'h'
	if scalar(100000) == 999 'i'
		n = n + 1
	end 'i'
	return n as ExitCode
end 'main'
---
ExitCode: 9
---
func @scalar {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jumpTable rcx, default=matchdefault [[0]=matcharm#1, [1]=matcharm#2, [2..4]=matcharm#3, [5]=matcharm#4, [6]=matchdefault, [7]=matcharm#5] @__jumptable_1
  matchdefault:
    x64.movRegImm32 r8, 999
    x64.jmp matchcont
  matcharm#1:
    x64.movRegImm32 r8, 100
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 r8, 101
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r8, 102
    x64.jmp matchcont
  matcharm#4:
    x64.movRegImm32 r8, 105
    x64.jmp matchcont
  matcharm#5:
    x64.movRegImm32 r8, 107
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 0
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 100
    x64.jcc equal, a
    x64.jmp critsplit#25
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#25:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 3
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 102
    x64.jcc equal, b
    x64.jmp critsplit#26
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#26:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 4
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 102
    x64.jcc equal, c
    x64.jmp critsplit#27
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#6
  critsplit#27:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 rcx, 5
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 105
    x64.jcc equal, d
    x64.jmp critsplit#28
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#8
  critsplit#28:
    x64.jmp ifcont#8
  ifcont#8:
    x64.movRegImm32 rcx, 6
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 999
    x64.jcc equal, e
    x64.jmp critsplit#29
  e:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#10
  critsplit#29:
    x64.jmp ifcont#10
  ifcont#10:
    x64.movRegImm32 rcx, 7
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 107
    x64.jcc equal, f
    x64.jmp critsplit#30
  f:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#12
  critsplit#30:
    x64.jmp ifcont#12
  ifcont#12:
    x64.movRegImm32 rcx, 8
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 999
    x64.jcc equal, g
    x64.jmp critsplit#31
  g:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#14
  critsplit#31:
    x64.jmp ifcont#14
  ifcont#14:
    x64.movRegImm rcx, 18446744073709551615
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 999
    x64.jcc equal, h
    x64.jmp critsplit#32
  h:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#16
  critsplit#32:
    x64.jmp ifcont#16
  ifcont#16:
    x64.movRegImm32 rcx, 100000
    x64.callDirect scalar
    x64.cmpRegImm32 r8, 999
    x64.jcc equal, i
    x64.jmp critsplit#33
  i:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont#18
  critsplit#33:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#18
  ifcont#18:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#20
    x64.jmp __rc_chk#21
  __rc_chk#21:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#20
    x64.jmp __rc_ok#19
  __rc_panic#20:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#19:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#23
