// Test: dispatch.exhaustive-enum-no-default
enum Color
	red
	green
	blue
	cyan
	magenta
	yellow
end 'Color'

function idx(c Color) returns ExitCode
	return match c 'm'
		red gives 1
		green gives 2
		blue gives 3
		cyan gives 4
		magenta gives 5
		yellow gives 6
	end 'm'
end 'idx'

function main() returns ExitCode
	var n = 0 as ExitCode
	if idx(Color.red) == 1 'a' n = n + 1 end 'a'
	if idx(Color.green) == 2 'b' n = n + 1 end 'b'
	if idx(Color.blue) == 3 'c' n = n + 1 end 'c'
	if idx(Color.cyan) == 4 'd' n = n + 1 end 'd'
	if idx(Color.magenta) == 5 'e' n = n + 1 end 'e'
	if idx(Color.yellow) == 6 'f' n = n + 1 end 'f'
	return n
end 'main'
---
ExitCode: 6
---
func @idx {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jumpTable rcx, default=matchdead [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm, [5]=matcharm] @__jumptable_0
  matchdead:
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 6
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 0
    x64.callDirect idx
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 1
    x64.callDirect idx
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 2
    x64.callDirect idx
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 3
    x64.callDirect idx
    x64.cmpRegImm32 r8, 4
    x64.jcc equal, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 4
    x64.callDirect idx
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, e
    x64.jmp critsplit
  e:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 5
    x64.callDirect idx
    x64.cmpRegImm32 r8, 6
    x64.jcc equal, f
    x64.jmp critsplit
  f:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
