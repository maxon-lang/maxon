    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext#6
  matcharm#5:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext#6:
    x64.leaRegRdata rdx, [rip + __str_rec_9]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext#8
  matcharm#7:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext#8:
    x64.leaRegRdata rdx, [rip + __str_rec_10]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matchnext#10
  matcharm#9:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchnext#10:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]
