// Test: dispatch.string-scrutinee-chain
function greet(name String) returns ExitCode
	return match name 'g'
		"alice" gives 1
		"bob" gives 2
		"carol" gives 3
		"dave" gives 4
		"erin" gives 5
		default gives 9
	end 'g'
end 'greet'

function main() returns ExitCode
	var n = 0 as ExitCode
	if greet("alice") == 1 'a'
		n = n + 1
	end 'a'
	if greet("carol") == 3 'b'
		n = n + 1
	end 'b'
	if greet("erin") == 5 'c'
		n = n + 1
	end 'c'
	if greet("zoe") == 9 'd'
		n = n + 1
	end 'd'
	return n
end 'main'
---
ExitCode: 4
---
