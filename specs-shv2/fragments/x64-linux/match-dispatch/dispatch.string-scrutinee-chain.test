// Test: dispatch.string-scrutinee-chain
function greet(name String) returns ExitCode
	return match name 'g'
		"alice" gives 1
		"bob" gives 2
		"carol" gives 3
		"dave" gives 4
		"erin" gives 5
		default gives 9
	end 'g'
end 'greet'

function main() returns ExitCode
	var n = 0 as ExitCode
	if greet("alice") == 1 'a' n = n + 1 end 'a'
	if greet("carol") == 3 'b' n = n + 1 end 'b'
	if greet("erin") == 5 'c' n = n + 1 end 'c'
	if greet("zoe") == 9 'd' n = n + 1 end 'd'
	return n
end 'main'
---
ExitCode: 4
---
func @greet {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rdx, [rip + __str_rec_1]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rdx, [rip + __str_rec_7]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext:
    x64.leaRegRdata rdx, [rip + __str_rec_9]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchnext:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matchcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect greet
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect greet
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.callDirect greet
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_rec_11]
    x64.callDirect greet
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
