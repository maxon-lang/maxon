// Test: dispatch.float-scrutinee-chain
function main() returns ExitCode
	let x = 2.5
	let r = match x 'c'
		0.0 to 1.0 gives 1
		1.0 to 2.0 gives 2
		2.0 to 3.0 gives 3
		3.0 to 4.0 gives 4
		default gives 9
	end 'c'
	return r
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.movsdRegRip xmm2, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg aboveEqual, rax
    x64.ucomisdRegReg xmm2, xmm0
    x64.setccReg aboveEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchnext#2
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#2:
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.movsdRegRip xmm2, [rip + __fconst_4]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg aboveEqual, rax
    x64.ucomisdRegReg xmm2, xmm0
    x64.setccReg aboveEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchnext#4
  matcharm#3:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchnext#4:
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.movsdRegRip xmm2, [rip + __fconst_5]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg aboveEqual, rax
    x64.ucomisdRegReg xmm2, xmm0
    x64.setccReg aboveEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchnext#6
  matcharm#5:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext#6:
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.movsdRegRip xmm2, [rip + __fconst_6]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg aboveEqual, rax
    x64.ucomisdRegReg xmm2, xmm0
    x64.setccReg aboveEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchnext#8
  matcharm#7:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchnext#8:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
