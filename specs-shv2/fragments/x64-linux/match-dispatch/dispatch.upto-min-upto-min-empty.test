// Test: dispatch.upto-min-upto-min-empty
function classify(x Integer) returns Integer
	return match x 'm'
		-9223372036854775808 upto -9223372036854775808 gives 1
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `min upto min` is also empty. The wrap bug turned it into `[i64.min, i64.max]`, matching every
	// value; that the ordinary values below still fall to default proves the arm is dead.
	var n = 0 as ExitCode
	if classify(5) == 0 'a'
		n = n + 1
	end 'a'
	if classify(0) == 0 'b'
		n = n + 1
	end 'b'
	if classify(-1) == 0 'c'
		n = n + 1
	end 'c'
	return n
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
  matchdefault#13:
    x64.movRegImm32 rcx, 0
  __il_cont#10:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchdefault#18
  a:
    x64.movRegImm32 rax, 1
  matchdefault#18:
    x64.movRegImm32 rcx, 0
  __il_cont#15:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchdefault#23
  b:
    x64.leaRegRegImm32 rax, rax, 1
  matchdefault#23:
    x64.movRegImm32 rcx, 0
  __il_cont#20:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, critsplit
  c:
    x64.leaRegRegImm32 r8, rax, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at dispatch.upto-min-upto-min-empty.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
