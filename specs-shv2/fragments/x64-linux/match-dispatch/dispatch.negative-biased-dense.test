// Test: dispatch.negative-biased-dense
function classify(x int) returns int
	return match x 'm'
		-3 gives 1
		-2 gives 2
		-1 gives 3
		0 gives 4
		1 gives 5
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// A dense span that CROSSES ZERO (min -3, span 5): the bias subtract is `x - (-3)` = `x + 3`, and the
	// UNSIGNED bounds check routes a below-min value (which wraps to a huge unsigned index) to the default.
	var n = 0 as ExitCode
	if classify(-3) == 1 'a' n = n + 1 end 'a'
	if classify(-1) == 3 'b' n = n + 1 end 'b'
	if classify(0) == 4 'c' n = n + 1 end 'c'
	if classify(1) == 5 'd' n = n + 1 end 'd'
	if classify(-4) == 0 'e' n = n + 1 end 'e'
	if classify(2) == 0 'f' n = n + 1 end 'f'
	return n as ExitCode
end 'main'
---
ExitCode: 6
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, 3
    x64.jumpTable rax, default=matchdefault [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm] @__jumptable_1
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm rcx, -3
    x64.callDirect classify
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm rcx, -1
    x64.callDirect classify
    x64.cmpRegImm32 r8, 3
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 0
    x64.callDirect classify
    x64.cmpRegImm32 r8, 4
    x64.jcc equal, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 1
    x64.callDirect classify
    x64.cmpRegImm32 r8, 5
    x64.jcc equal, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm rcx, -4
    x64.callDirect classify
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, e
    x64.jmp critsplit
  e:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 2
    x64.callDirect classify
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, f
    x64.jmp critsplit
  f:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
