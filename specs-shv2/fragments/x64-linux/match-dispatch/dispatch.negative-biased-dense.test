// Test: dispatch.negative-biased-dense
function classify(x Integer) returns Integer
	return match x 'm'
		-3 gives 1
		-2 gives 2
		-1 gives 3
		0 gives 4
		1 gives 5
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// A dense span that CROSSES ZERO (min -3, span 5): the bias subtract is `x - (-3)` = `x + 3`, and the
	// UNSIGNED bounds check routes a below-min value (which wraps to a huge unsigned index) to the default.
	var n = 0 as ExitCode
	if classify(-3) == 1 'a'
		n = n + 1
	end 'a'
	if classify(-1) == 3 'b'
		n = n + 1
	end 'b'
	if classify(0) == 4 'c'
		n = n + 1
	end 'c'
	if classify(1) == 5 'd'
		n = n + 1
	end 'd'
	if classify(-4) == 0 'e'
		n = n + 1
	end 'e'
	if classify(2) == 0 'f'
		n = n + 1
	end 'f'
	return n as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
