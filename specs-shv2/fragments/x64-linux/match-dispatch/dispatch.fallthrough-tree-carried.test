// Test: dispatch.fallthrough-tree-carried
typealias N = int(0 to 1000000)

function perms(role N) returns N
	var p = 0 as N
	match role 'auth'
		1 then p = p + 1 and fallthrough
		2 then p = p + 2 and fallthrough
		3 then p = p + 4 and fallthrough
		4 then p = p + 8 and fallthrough
		5 then p = p + 16
		default then p = 0
	end 'auth'
	return p
end 'perms'

function main() returns ExitCode
	var n = 0 as N
	if perms(1) == 31 'a' n = n + 1 end 'a'
	if perms(3) == 28 'b' n = n + 1 end 'b'
	if perms(5) == 16 'c' n = n + 1 end 'c'
	if perms(6) == 0 'd' n = n + 1 end 'd'
	return n as ExitCode
end 'main'
---
ExitCode: 4
---
func @perms {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.jumpTable rcx, default=matchdefault [[0]=matcharm, [1]=critsplit, [2]=critsplit, [3]=critsplit, [4]=critsplit] @__jumptable_2
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp matcharm
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 rax, rax, 2
    x64.jmp matcharm
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 rax, rax, 4
    x64.jmp matcharm
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 rax, rax, 8
    x64.jmp matcharm
  critsplit:
    x64.jmp matcharm
  matcharm:
    x64.leaRegRegImm32 r8, rax, 16
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 1000000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect perms
    x64.cmpRegImm32 r8, 31
    x64.jcc equal, a
    x64.jmp critsplit
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 3
    x64.callDirect perms
    x64.cmpRegImm32 r8, 28
    x64.jcc equal, b
    x64.jmp critsplit
  b:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 5
    x64.callDirect perms
    x64.cmpRegImm32 r8, 16
    x64.jcc equal, c
    x64.jmp critsplit
  c:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 6
    x64.callDirect perms
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, d
    x64.jmp critsplit
  d:
    x64.leaRegRegImm32 r8, rbx, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rbx
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
