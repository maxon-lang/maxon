// Test: dispatch.upto-exclusive-boundary
function classify(x int) returns int
	return match x 'm'
		10 upto 20 gives 1
		20 upto 30 gives 2
		30 gives 3
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `upto` excludes its upper: 10..20 covers 10..19, 20..30 covers 20..29, and 30 is its own arm.
	var n = 0 as ExitCode
	if classify(19) == 1 'a'
		n = n + 1
	end 'a'
	if classify(20) == 2 'b'
		n = n + 1
	end 'b'
	if classify(29) == 2 'c'
		n = n + 1
	end 'c'
	if classify(30) == 3 'd'
		n = n + 1
	end 'd'
	if classify(9) == 0 'e'
		n = n + 1
	end 'e'
	return n
end 'main'
