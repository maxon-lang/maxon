// Test: trunc.basic
function main() returns ExitCode
	let neg = -3.7
	let y = trunc(neg)
	return y + 10
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.cvttsd2siRegReg rax, xmm0
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}
