// Test: a-non-commutative-op-keeps-its-copy
typealias Word = int(i64.min to i64.max)

function difference(a Word, b Word) returns Word
	let scaled = b * 3
	let d = a - scaled
	return d + a
end 'difference'

function main() returns ExitCode
	var seen = 0
	for i in 0 upto 4 'feed'
		seen = seen + difference(i * 10, b: i)
	end 'feed'
	// a = 0,10,20,30; scaled = 0,3,6,9; d = 0,7,14,21; d+a = 0,17,34,51 -> 102
	// commuted, `d` would be scaled - a = 0,-7,-14,-21 and the sum 18
	if seen != 102 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  forhdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc greaterEqual, forexit
  feed:
    x64.imulRegRegImm32 rdx, rcx, 10
  __il_body:
    x64.imulRegRegImm32 rsi, rcx, 3
    x64.movRegReg rdi, rdx
    x64.subRegReg rdi, rdx, rsi
    x64.leaRegRegReg rdx, rdi, rdx
  __il_cont:
    x64.leaRegRegReg rax, rax, rdx
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rax, 102
    x64.jcc equal, ifcont
  sum:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
