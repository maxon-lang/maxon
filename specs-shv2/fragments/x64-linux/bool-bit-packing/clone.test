// Test: clone
typealias BoolArray = Array with bool

function main() returns ExitCode
	var arr = BoolArray.create()
	arr.push(true)
	arr.push(false)
	var copy = arr.clone()
	try copy.set(0, value: false) otherwise panic("test invariant: set OOB")
	let orig = try arr.get(0) otherwise false
	let cloned = try copy.get(0) otherwise true
	var sum = 0
	if orig 'o'
		sum = sum + 1
	end 'o'
	if cloned 'c'
		sum = sum + 10
	end 'c'
	return sum
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm rcx, 18446744073709551615
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRdata rdx, [rip + __layout_Array_bool]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.clone
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at clone.test:9: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r13, 0
    x64.jmp trycont#5
  tryok#3:
    x64.movRegReg r13, r8
  trycont#5:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#6
  tryerr#7:
    x64.movRegImm32 rax, 1
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg rax, r8
  trycont#8:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, ifcont#10
  o:
    x64.movRegImm32 rcx, 1
  ifcont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
  c:
    x64.leaRegRegImm32 r13, rcx, 10
    x64.jmp ifcont#12
  critsplit:
    x64.movRegReg r13, rcx
  ifcont#12:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at clone.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
