// Test: a-folded-value-inside-its-range-passes-the-check
typealias Word = int(i64.min to i64.max)
typealias Small = int(0 to 100)

function scale(a Word, b Word) returns Word
	return a * b
end 'scale'

function main() returns ExitCode
	let v = scale(25, b: 2) as Small
	if v != 50 'value'
		return 1
	end 'value'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 rax, 50
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rax, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-folded-value-inside-its-range-passes-the-check.test:10: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rax, 50
    x64.jcc equal, ifcont
  value:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
