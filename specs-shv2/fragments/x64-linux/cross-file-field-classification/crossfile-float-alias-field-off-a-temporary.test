// Test: crossfile-float-alias-field-off-a-temporary
// --- file: scale.maxon
typealias Weight = float(0.0 to 1000.0)

export type Scale
	export var w as Weight

	export static function make() returns Scale
		return Scale{w: 42.0}
	end 'make'
end 'Scale'

// --- file: main.maxon
function main() returns ExitCode
	return trunc(Scale.make().w)
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rax, slot0
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.storeBaseDispReg.word64 [rax + 0], xmm0
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
