// Test: two-extensions-in-one-file-are-one-overload-set
typealias Integer = int(i64.min to i64.max)

interface Tagged
	function tag() returns Integer
end 'Tagged'

extension Tagged
	export function pick(n Integer) returns Integer
		return tag() + n
	end 'pick'
end 'Tagged'

extension Tagged
	export function pick(flag bool) returns Integer
		return tag() + (100 if flag else 0)
	end 'pick'
end 'Tagged'

type Five implements Tagged
	export static function make() returns Self
		return Self{}
	end 'make'

	export function tag() returns Integer
		return 5
	end 'tag'
end 'Five'

function main() returns ExitCode
	let f = Five.make()
	return f.pick(2) + f.pick(true)
end 'main'
---
ExitCode: 112
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Five.pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.leaRegRegImm32 r8, rdx, 5
    x64.popReg rbp
    x64.ret
}

func @Five.pick#bool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rax, 100
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rax, 0
  matchcont:
    x64.leaRegRegImm32 r8, rax, 5
    x64.popReg rbp
    x64.ret
}

func @Five.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Five.make
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect Five.pick
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect Five.pick#bool
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at two-extensions-in-one-file-are-one-overload-set.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
