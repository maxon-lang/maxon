// Test: three-declarations-across-two-files-are-one-set
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

export interface Counted
	function base() returns Integer
end 'Counted'

export extension Counted
	export function score(n Integer) returns Integer
		return base() + n
	end 'score'

	export function score(flag bool) returns Integer
		return base() + (10 if flag else 0)
	end 'score'
end 'Counted'

export type Unit implements Counted
	export static function make() returns Self
		return Self{}
	end 'make'

	export function base() returns Integer
		return 1
	end 'base'
end 'Unit'

// --- file: b.maxon
typealias Amount = int(i64.min to i64.max)

public type Weight
	export var w as Amount

	export static function of(w Amount) returns Self
		return Self{w: w}
	end 'of'
end 'Weight'

export extension Counted
	export function score(x Weight) returns Amount
		return base() * x.w
	end 'score'
end 'Counted'

function main() returns ExitCode
	let u = Unit.make()
	return u.score(4) + u.score(true) + u.score(Weight.of(7))
end 'main'
---
ExitCode: 23
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Unit.score#Integer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.leaRegRegImm32 r8, rdx, 1
    x64.popReg rbp
    x64.ret
}

func @Unit.score#bool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rax, 10
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegImm32 r8, rax, 1
    x64.popReg rbp
    x64.ret
}

func @Unit.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Unit.score#Weight {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.loadRegBaseDisp.word64 r8, [rdx + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.callDirect Unit.make
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect Unit.score#Integer
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect Unit.score#bool
    x64.leaRegRegReg r12, r12, r8
    x64.movRegImm32 rax, 7
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect Unit.score#Weight
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
