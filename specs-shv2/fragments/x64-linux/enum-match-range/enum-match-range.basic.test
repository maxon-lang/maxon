// Test: enum-match-range.basic
typealias Integer = int(i64.min to i64.max)

union Action
	noop
	skip
	run(code Integer)
end 'Action'

function main() returns ExitCode
	let a = Action.skip
	let result = match a 'check'
		noop to skip gives 1
		run(code) gives code
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
