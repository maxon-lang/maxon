// Test: enum-match-range.endpoint-name-collision
// A range arm's endpoint case names (`lt`/`ge`) also exist on a DIFFERENT
// enum (`Cond`) at other ordinals — here `ge` precedes `lt`, both high, the
// way `Arm64CondCode` shadows `CmpPredicate` inside the compiler. The range
// endpoints must resolve against the SCRUTINEE's enum (`Pred`: lt=2..ge=5),
// not whichever enum a type-blind name search happens to reach first. Binding
// to `Cond` would yield the empty ordinal span [7,6], so the exhaustive match
// would match no arm for `Pred.gt` and fall through to a nil result.
union Cond
	eqc
	nec
	mi
	pl
	hic
	ls
	ge
	lt
	gtc
	lec
end 'Cond'

union Pred
	eq
	ne
	lt
	le
	gt
	ge
end 'Pred'

function classify(p Pred) returns String
	return match p 'm'
		eq gives "eq"
		ne gives "ne"
		lt to ge gives "ord"
	end 'm'
end 'classify'

function main() returns ExitCode
	let s = classify(Pred.gt)
	if s.isEmpty() 'empty'
		return 2
	end 'empty'
	return 0 if s == "ord" else 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.leaRegRdata rax, [rip + __str_rec_4]
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rcx, 2
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 5
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.jmp matchcont
  matchcont:
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 4
    x64.callDirect classify
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect String.isEmpty
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, empty
    x64.jmp ifcont
  empty:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 1
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.isEmpty {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect String.byteLength
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
