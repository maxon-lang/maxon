// Test: error.enum-match-range.not-exhaustive
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	div
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.mul
	match op 'check'
		add to sub then return 1
		div then return 2
		exec(code) then return code
	end 'check'
end 'main'
---
CompilerError:
error E2026: <fragment>:18:2: match on union 'Op' is not exhaustive, missing: mul
