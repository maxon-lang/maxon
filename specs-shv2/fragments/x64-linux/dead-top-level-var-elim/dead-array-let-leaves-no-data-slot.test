// Test: dead-array-let-leaves-no-data-slot
let deadArr = [1, 2, 3, 4, 5]
var live = 7

function main() returns ExitCode
	return live
end 'main'
---
ExitCode: 7
---
data {
  __data_live@0 = i64 7
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_live
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}
