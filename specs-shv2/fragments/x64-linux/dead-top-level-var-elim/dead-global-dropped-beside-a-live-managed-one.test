// Test: dead-global-dropped-beside-a-live-managed-one
let deadArr = [1, 2, 3]
let liveArr = [10, 20, 30]
var probe = 4

function main() returns ExitCode
	return ((try liveArr.get(1) otherwise 0) - probe) as ExitCode
end 'main'
---
ExitCode: 16
---
data {
  __data_liveArr@0 = i64 0
  __data_probe@8 = i64 4
  __slab_cursor@16 = i64 0
  __slab_end@24 = i64 0
  __mm_alloc_count@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_liveArr
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.leaRegGlobal rcx, __data_probe
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.movRegReg r8, rax
    x64.subRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
