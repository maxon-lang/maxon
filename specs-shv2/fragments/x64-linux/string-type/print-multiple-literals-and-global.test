// Test: print-multiple-literals-and-global
var total = 0

function bump(n int) returns int
	total = total + n
	return total
end 'bump'

function main() returns ExitCode
	print("foo")
	let a = bump(10)
	print("bar")
	let b = bump(5)
	print("baz")
	return b - a - 5
end 'main'
---
ExitCode: 0
---
data {
  __data_total@0 = i64 0
}

func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_total
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegGlobal rcx, __data_total
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_total
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
    x64.movRegImm32 rcx, 10
    x64.callDirect bump
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.movRegImm32 rcx, 5
    x64.callDirect bump
    x64.movRegReg r12, r8
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.subRegReg r12, r12, rbx
    x64.leaRegRegImm32 r8, r12, -5
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
