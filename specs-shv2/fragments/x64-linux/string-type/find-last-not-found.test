// Test: find-last-not-found
function main() returns ExitCode
	let s = "hello world"
	if let idx = try s.findLast("xyz") 'found'
		print("FOUND\n")
		return idx.charIndex() as ExitCode
	end 'found' else 'not_found'
		print("NOT_FOUND\n")
	end 'not_found'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.callDirect String.findLast
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, ifelse
  found:
    x64.leaRegRdata rcx, [rip + __str_rec_6]
    x64.callDirect print
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_23]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
