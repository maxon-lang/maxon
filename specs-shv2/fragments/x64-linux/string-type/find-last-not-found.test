// Test: find-last-not-found
function main() returns ExitCode
	let s = "hello world"
	if try s.findLast("xyz") 'found'
		print("FOUND\n")
	end 'found' else 'not_found'
		print("NOT_FOUND\n")
	end 'not_found'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect __strix_last
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, found
    x64.jmp ifelse
  found:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
