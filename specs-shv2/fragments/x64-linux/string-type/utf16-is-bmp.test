// Test: utf16-is-bmp
function main() returns ExitCode
	if utf16IsBmp(65) 'c10'
		print("1\n")       // ASCII
	end 'c10'
	if utf16IsBmp(945) 'c11'
		print("2\n")      // Greek α
	end 'c11'
	if utf16IsBmp(65535) 'c12'
		print("3\n")    // U+FFFF (last BMP)
	end 'c12'
	if utf16IsBmp(128512) 'c13'
		print("0\n")   // 😀 (not BMP)
	end 'c13'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 65
    x64.callDirect utf16IsBmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c10
    x64.jmp ifcont#2
  c10:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 945
    x64.callDirect utf16IsBmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c11
    x64.jmp ifcont#4
  c11:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 65535
    x64.callDirect utf16IsBmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c12
    x64.jmp ifcont#6
  c12:
    x64.leaRegRdata rcx, [rip + __str_rec_6]
    x64.callDirect print
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 rcx, 128512
    x64.callDirect utf16IsBmp
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c13
    x64.jmp ifcont#8
  c13:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect print
    x64.jmp ifcont#8
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @utf16IsBmp {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 1114111
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_8]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rcx, 0
    x64.movRegImm32 r8, 0
    x64.jcc greaterEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rcx, 65536
    x64.setccReg less, r8
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
