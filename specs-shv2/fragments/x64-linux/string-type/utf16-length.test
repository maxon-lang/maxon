    x64.popReg rbp
    x64.ret
}

func @UTF16View.count {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect String.byteLength
    x64.movRegReg r14, r8
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg r13, r14
    x64.jcc less, count_loop
    x64.jmp whileexit
  count_loop:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r13
    x64.callDirect utf8DecodeAt
    x64.movRegReg r15, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegReg rdx, r13
    x64.callDirect utf8ByteLengthAt
    x64.leaRegRegReg r13, r13, r8
    x64.cmpRegImm32 r15, 65536
    x64.jcc less, bmp
    x64.jmp ifelse
  bmp:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont
  ifelse:
    x64.leaRegRegImm32 rax, r12, 2
    x64.jmp ifcont
  ifcont:
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

