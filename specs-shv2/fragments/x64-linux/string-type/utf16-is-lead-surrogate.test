// Test: utf16-is-lead-surrogate
function main() returns ExitCode
	// 0xD83D = 55357 (high surrogate for 😀)
	if utf16IsLeadSurrogate(55357) 'c1'
		print("1\n")
	end 'c1'
	if utf16IsLeadSurrogate(56832) 'c2'
		print("0\n")
	end 'c2'
	if utf16IsLeadSurrogate(65) 'c3'
		print("0\n")
	end 'c3'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  andrhs#9:
    x64.movRegImm32 rax, 1
  __il_cont#7:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, andrhs#16
  c1:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect print
  andrhs#16:
    x64.movRegImm32 rax, 0
  __il_cont#14:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __rc_ok
  c2:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
  __rc_ok:
    x64.movRegImm32 rax, 0
  __il_cont#21:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  c3:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
