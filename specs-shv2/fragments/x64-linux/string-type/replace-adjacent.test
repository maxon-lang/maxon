// Test: replace-adjacent
function main() returns ExitCode
	let s = "aaaa"
	let result = s.replace("aa", with: "b")
	print(result)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "aaaa"
    x64.leaRegRdata rdx, [rip + __str_rec_4]  ; "aa"
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "b"
    x64.callDirect String.replace
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
