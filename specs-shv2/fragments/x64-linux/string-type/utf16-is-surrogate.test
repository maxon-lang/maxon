// Test: utf16-is-surrogate
function main() returns ExitCode
	if utf16IsSurrogate(55357) 'c7'
		print("1\n")
	end 'c7'
	if utf16IsSurrogate(56832) 'c8'
		print("2\n")
	end 'c8'
	if utf16IsSurrogate(65) 'c9'
		print("0\n")
	end 'c9'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 55357
    x64.callDirect utf16IsSurrogate
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c7
    x64.jmp ifcont#2
  c7:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 56832
    x64.callDirect utf16IsSurrogate
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c8
    x64.jmp ifcont#4
  c8:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 rcx, 65
    x64.callDirect utf16IsSurrogate
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c9
    x64.jmp ifcont#6
  c9:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @utf16IsSurrogate {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 65535
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rcx, 55296
    x64.movRegImm32 r8, 0
    x64.jcc greaterEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rcx, 57343
    x64.setccReg lessEqual, r8
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
