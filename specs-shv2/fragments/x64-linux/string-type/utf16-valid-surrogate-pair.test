func @utf16IsValidSurrogatePair {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#4
    x64.jmp __rc_chk#5
  __rc_chk#5:
    x64.cmpRegImm32 rcx, 65535
    x64.jcc greater, __rc_panic#4
