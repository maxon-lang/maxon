// Test: equality-with-logical-and
function main() returns ExitCode
	let s = "hello"
	let c = 'A'
	if s == "hello" and c == 'A' 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.leaRegRdata rdx, [rip + __str_rec_2]
    x64.callDirect __str_eq
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit
  andrhs:
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.jmp scmerge
  critsplit:
    x64.movRegReg r8, rax
  scmerge:
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
