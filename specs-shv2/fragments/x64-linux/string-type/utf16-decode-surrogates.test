// Test: utf16-decode-surrogates
function main() returns ExitCode
	// Decode surrogate pair back to codepoint
	let cp = utf16DecodeSurrogates(55357, low: 56832)
	print("{cp}\n")  // 128512 (U+1F600)
	return 0
end 'main'
---
ExitCode: 0
---
