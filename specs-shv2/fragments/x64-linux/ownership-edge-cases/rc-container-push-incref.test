// Test: rc-container-push-incref
typealias Integer = int(i64.min to i64.max)

type Node
	export var id as Integer

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Node'

typealias NodeArray = Array with Node

function main() returns ExitCode
	var arr = NodeArray.create()
	if true 'scope'
		let n = Node.create(10)
		arr.push(n)
	end 'scope'
	let got = try arr.get(0) otherwise Node.create(-1)
	return got.id
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Node.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, scope
    x64.jmp ifcont
  scope:
    x64.movRegImm32 rcx, 10
    x64.callDirect Node.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg lessEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#15
  __im_load#15:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, rdx, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rcx
    x64.cmpRegImm32 rax, 0
    x64.setccReg lessEqual, rax
    x64.orRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#16
  __im_load#16:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#18
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp critsplit#19
  critsplit#19:
    x64.movRegReg r12, rax
    x64.jmp __il_cont
  critsplit#18:
    x64.movRegReg r12, rax
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r10
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm rcx, 18446744073709551615
    x64.callDirect Node.create
    x64.movRegReg rcx, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.jmp trycont
  trycont:
    x64.loadRegBaseDisp.word64 r12, [rcx + 0]
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
