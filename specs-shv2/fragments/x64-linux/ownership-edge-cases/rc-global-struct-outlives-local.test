// Test: rc-global-struct-outlives-local
typealias Integer = int(i64.min to i64.max)

type Cfg
	export var level as Integer

	static function create(level Integer) returns Self
		return Self{level: level}
	end 'create'
end 'Cfg'

var globalCfg = Cfg.create(0)

function setup()
	globalCfg = Cfg.create(42)
end 'setup'

function main() returns ExitCode
	setup()
	return globalCfg.level
end 'main'
---
ExitCode: 42
---
data {
  __data_globalCfg@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Cfg.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @setup {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 42
    x64.callDirect Cfg.create
    x64.movRegReg rbx, r8
    x64.leaRegGlobal rax, __data_globalCfg
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_decref
    x64.leaRegGlobal rax, __data_globalCfg
    x64.storeBaseDispReg.word64 [rax + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect setup
    x64.leaRegGlobal rax, __data_globalCfg
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
