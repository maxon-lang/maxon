// Test: no-leak.enum-arg-conditional-use
typealias Integer = int(i64.min to i64.max)

union Op
	addOp(left Integer, right Integer)
	mulOp(left Integer, right Integer)
end 'Op'

function applyOp(useAdd bool, addArg Op, mulArg Op) returns Integer
	if useAdd 'branch'
		return match addArg 'matchAdd'
			addOp(left, right) gives left + right
			mulOp(left, right) gives left * right
		end 'matchAdd'
	end 'branch' else 'other'
		return match mulArg 'matchMul'
			addOp(left, right) gives left + right
			mulOp(left, right) gives left * right
		end 'matchMul'
	end 'other'
end 'applyOp'

function main() returns ExitCode
	let result = applyOp(true, addArg: Op.addOp(3, right: 4), mulArg: Op.mulOp(5, right: 6))
	print("{result}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @applyOp {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, branch
    x64.jmp ifelse
  branch:
    x64.loadRegBaseDisp.word64 rax, [rdx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#5
  matcharm#2:
    x64.loadRegBaseDisp.word64 rax, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rdx + 16]
    x64.leaRegRegReg r8, rax, rcx
    x64.jmp matchcont#6
  matchnext#5:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#3
    x64.jmp matchdead#4
  matcharm#3:
    x64.loadRegBaseDisp.word64 rax, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rdx + 16]
    x64.imulRegReg rax, rax, rcx
    x64.movRegReg r8, rax
    x64.jmp matchcont#6
  matchcont#6:
    x64.popReg rbp
    x64.ret
  matchdead#4:
  ifelse:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#8
    x64.jmp matchnext#11
  matcharm#8:
    x64.loadRegBaseDisp.word64 rcx, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 16]
    x64.leaRegRegReg r8, rcx, rax
    x64.jmp matchcont#12
  matchnext#11:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#9
    x64.jmp matchdead#10
  matcharm#9:
    x64.loadRegBaseDisp.word64 rcx, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 16]
    x64.imulRegReg rcx, rcx, rax
    x64.movRegReg r8, rcx
    x64.jmp matchcont#12
  matchcont#12:
    x64.popReg rbp
    x64.ret
  matchdead#10:
  ifcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 3
    x64.movRegImm32 r13, 4
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.storeBaseDispReg.word64 [r14 + 16], r13
    x64.movRegImm32 r12, 5
    x64.movRegImm32 r13, 6
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r15 + 0], rax
    x64.storeBaseDispReg.word64 [r15 + 8], r12
    x64.storeBaseDispReg.word64 [r15 + 16], r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r15
    x64.callDirect applyOp
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, rbx, r14
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
