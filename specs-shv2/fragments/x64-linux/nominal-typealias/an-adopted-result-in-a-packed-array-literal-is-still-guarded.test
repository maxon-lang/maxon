// Test: an-adopted-result-in-a-packed-array-literal-is-still-guarded
typealias Small = int(0 to 255)

function main() returns ExitCode
	let s = 255 as Small
	let xs = [s + 1, s + 2]
	let first = try xs.get(0) otherwise 99
	print("{first}")
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at an-adopted-result-in-a-packed-array-literal-is-still-guarded.test:6: Range check failed: value outside typealias 'Small'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
