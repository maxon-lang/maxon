// Test: an-int-alias-converts-at-a-float-alias-return
typealias Tally = int(0 to 100)
typealias Ratio = float(0.0 to 1000.0)

function toRatio(t Tally) returns Ratio
	return t
end 'toRatio'

function main() returns ExitCode
	print("{toRatio(7) / 2.0}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
