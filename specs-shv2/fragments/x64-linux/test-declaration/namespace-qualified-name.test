// Test: namespace-qualified-name
// --- file: suite/deep.test.maxon
test 'lives in a subdirectory'
	print("ran")
end 'lives in a subdirectory'

// --- file: main.maxon
function main() returns ExitCode
	return 0
end 'main'
---
ExitCode: 0
---
func @__test_lives_in_a_subdirectory {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
