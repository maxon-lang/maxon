// Test: fused-compare-is-highest-value
function main() returns ExitCode
	let a = 7
	let b = 3
	if a < b 'lt'
		return b
	end 'lt'
	return a
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
  ifcont:
    x64.popReg rbp
    x64.ret
}
