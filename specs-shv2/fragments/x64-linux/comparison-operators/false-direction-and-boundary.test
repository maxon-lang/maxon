// Test: false-direction-and-boundary
function main() returns ExitCode
	let x = 5
	var r = 0
	if x == 6 'eqFalse'
		r = r + 1
	end 'eqFalse'
	if x != 5 'neFalse'
		r = r + 2
	end 'neFalse'
	if x > 5 'gtBoundary'
		r = r + 4
	end 'gtBoundary'
	if x <= 5 'leBoundary'
		r = r + 8
	end 'leBoundary'
	if x >= 5 'geBoundary'
		r = r + 16
	end 'geBoundary'
	if x < 5 'ltFalse'
		r = r + 32
	end 'ltFalse'
	return r
end 'main'
---
ExitCode: 24
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 5
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 6
    x64.jcc equal, eqFalse
    x64.jmp critsplit#16
  eqFalse:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp ifcont#2
  critsplit#16:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegImm32 rax, 5
    x64.jcc notEqual, neFalse
    x64.jmp critsplit#17
  neFalse:
    x64.leaRegRegImm32 rcx, rcx, 2
    x64.jmp ifcont#4
  critsplit#17:
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 rax, 5
    x64.jcc greater, gtBoundary
    x64.jmp critsplit#18
  gtBoundary:
    x64.leaRegRegImm32 rcx, rcx, 4
    x64.jmp ifcont#6
  critsplit#18:
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 rax, 5
    x64.jcc lessEqual, leBoundary
    x64.jmp critsplit#19
  leBoundary:
    x64.leaRegRegImm32 rcx, rcx, 8
    x64.jmp ifcont#8
  critsplit#19:
    x64.jmp ifcont#8
  ifcont#8:
    x64.cmpRegImm32 rax, 5
    x64.jcc greaterEqual, geBoundary
    x64.jmp critsplit#20
  geBoundary:
    x64.leaRegRegImm32 rcx, rcx, 16
    x64.jmp ifcont#10
  critsplit#20:
    x64.jmp ifcont#10
  ifcont#10:
    x64.cmpRegImm32 rax, 5
    x64.jcc less, ltFalse
    x64.jmp critsplit#21
  ltFalse:
    x64.leaRegRegImm32 r8, rcx, 32
    x64.jmp ifcont#12
  critsplit#21:
    x64.movRegReg r8, rcx
    x64.jmp ifcont#12
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
