// Test: try-block-shadowed-binding.shadow-in-a-nested-handler-scope
typealias Score = int(0 to 100)

enum ErrA implements Error
    one
end 'ErrA'

enum ErrB implements Error
    two
end 'ErrB'

enum Other
    alpha
    beta
end 'Other'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.one
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.two
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(true)
        let b = callB(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        let e = Other.beta
        match e 'shadowed'
            alpha then sum = 7
            beta then sum = 9
        end 'shadowed'
    end 'h'
    return sum
end 'main'
---
ExitCode: 9
---
func @callA {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @callB {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 6
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect callA
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit#13
    x64.jmp tryblkok#2
  critsplit#13:
    x64.jmp tryblkerr
  tryblkok#2:
    x64.movRegImm32 rcx, 0
    x64.callDirect callB
    x64.leaRegRegImm32 rax, r10, 1
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit#14
    x64.jmp tryblkok#3
  critsplit#14:
    x64.jmp tryblkerr
  tryblkerr:
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#4
    x64.jmp matchnext
  matcharm#4:
    x64.movRegImm32 rax, 7
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#5
    x64.jmp matchdead
  matcharm#5:
    x64.movRegImm32 rax, 9
    x64.jmp matchcont
  matchcont:
    x64.movRegReg r8, rax
    x64.jmp tryblkcont
  matchdead:
  tryblkok#3:
    x64.leaRegRegReg r8, rbx, r8
    x64.jmp tryblkcont
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
