// Test: try-block-shadowed-binding.shadowed-binding-is-not-the-error-union
typealias Score = int(0 to 100)

enum ErrA implements Error
    bad
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

enum Inner
    bad
    splat
end 'Inner'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(true)
        let b = callB(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        if true 'shadowscope'
            let e = Inner.splat
            match e 'inner'
                bad then sum = 11
                splat then sum = 22
            end 'inner'
        end 'shadowscope'
    end 'h'
    return sum
end 'main'
---
ExitCode: 22
---
func @callA {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @callB {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 6
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect callA
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit#15
    x64.jmp tryblkok#2
  critsplit#15:
    x64.jmp tryblkerr
  tryblkok#2:
    x64.movRegImm32 rcx, 0
    x64.callDirect callB
    x64.leaRegRegImm32 rax, r10, 1
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit#17
    x64.jmp tryblkok#3
  critsplit#17:
    x64.jmp tryblkerr
  tryblkerr:
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, shadowscope
    x64.jmp critsplit#16
  shadowscope:
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#5
    x64.jmp matchnext
  matcharm#5:
    x64.movRegImm32 rax, 11
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchdead
  matcharm#6:
    x64.movRegImm32 rax, 22
    x64.jmp matchcont
  matchcont:
    x64.jmp ifcont
  matchdead:
  critsplit#16:
    x64.movRegReg rax, rbx
    x64.jmp ifcont
  ifcont:
    x64.movRegReg r8, rax
    x64.jmp tryblkcont
  tryblkok#3:
    x64.leaRegRegReg r8, r12, r8
    x64.jmp tryblkcont
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
