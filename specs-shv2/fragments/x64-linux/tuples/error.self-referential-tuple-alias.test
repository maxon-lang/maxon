// Test: error.self-referential-tuple-alias
typealias Int = int(i64.min to i64.max)
typealias P = (P, Int)

function make() returns P
	return ((1, 2), 3)
end 'make'

function main() returns ExitCode
	let t = make()
	return t.1 as ExitCode
end 'main'
