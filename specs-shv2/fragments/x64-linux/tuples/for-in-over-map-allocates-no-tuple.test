// Test: for-in-over-map-allocates-no-tuple
typealias Integer = int(i64.min to i64.max)
typealias IntMap = Map with (Integer, Integer)

function sum(m IntMap) returns Integer
	var total = 0
	for (_, v) in m 'loop'
		total = total + v
	end 'loop'
	return total
end 'sum'

function main() returns ExitCode
	let m = [1: 10, 2: 20, 3: 30]
	return sum(m)
end 'main'
---
ExitCode: 60
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @sum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 16
    x64.movRegImm32 r14, 8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __mm_decref]
    x64.callDirect __managed_create
    x64.movRegReg r15, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r13
    x64.movRegReg r9, r14
    x64.movRegImm32 rsi, 0
    x64.movRegImm32 rdi, 0
    x64.callDirect __map_entries
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr
  forhdr:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_count
    x64.cmpRegReg rbx, r8
    x64.jcc less, loop
    x64.jmp forexit
  loop:
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get_unchecked
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.leaRegRegReg r12, r12, rax
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r15
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 10
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.callDirect __map_create
    x64.movRegReg r13, r8
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __map_upsert
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 20
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect __map_upsert
    x64.movRegImm32 rdx, 3
    x64.movRegImm32 rax, 30
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect __map_upsert
    x64.movRegReg rcx, r13
    x64.callDirect sum
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __map_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @int.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rcx
    x64.andRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}

func @int.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, equal
    x64.jmp notEqual
  equal:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
