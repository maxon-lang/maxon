// Test: parenthesized-grouping-is-not-a-tuple
function main() returns ExitCode
	let x = (2 + 3) * 4
	return x + 22
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.leaRegRegImm32 rax, rax, 3
    x64.imulRegRegImm32 rax, rax, 4
    x64.leaRegRegImm32 r8, rax, 22
    x64.popReg rbp
    x64.ret
}
