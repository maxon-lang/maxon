// Test: cross-file-nested-match-result-scrutinee
// --- file: types.maxon
export typealias Dim = int(0 to 100)

export union MyType
	unresolved
	named(id Dim)
	other(x Dim)
end 'MyType'

export union Wrapper
	void
	value(inner MyType)
end 'Wrapper'

// --- file: main.maxon
function classify(ref Wrapper) returns Dim
	let raw = match ref 'unwrap'
		void gives MyType.unresolved
		value(inner) gives inner
	end 'unwrap'
	return match raw 'r'
		named(id) gives id
		other(x) gives x
		unresolved gives 0
	end 'r'
end 'classify'

function main() returns ExitCode
	return classify(Wrapper.value(MyType.named(7)))
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#4
  matcharm#1:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegReg rcx, r8
    x64.jmp matchcont#5
  matchnext#4:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead#3
  matcharm#2:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.jmp matchcont#5
  matchcont#5:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#8
    x64.jmp matchnext#10
  matcharm#8:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont#12
  matchnext#10:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchnext#11
  matcharm#6:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.jmp matchcont#12
  matchnext#11:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#7
    x64.jmp matchdead#9
  matcharm#7:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.jmp matchcont#12
  matchcont#12:
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#9:
  matchdead#3:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], r12
    x64.movRegReg rcx, rbx
    x64.callDirect classify
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Wrapper
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
