// Test: cross-file-keyword-case-and-range
// --- file: kind.maxon
export enum Kind
	boolean
	integer
	float
	named
	function
	unresolved
	other
end 'Kind'

// --- file: main.maxon
function isScalar(k Kind) returns bool
	return match k 'check'
		boolean to float gives true
		named to other gives false
	end 'check'
end 'isScalar'

function pickFloat() returns Kind
	return Kind.float
end 'pickFloat'

function pickBoolean() returns Kind
	return Kind.boolean
end 'pickBoolean'

function pickNamed() returns Kind
	return Kind.named
end 'pickNamed'

function main() returns ExitCode
	var score = 0
	if isScalar(pickFloat()) 'f'
		score = score + 1
	end 'f'
	if isScalar(pickBoolean()) 'b'
		score = score + 2
	end 'b'
	if isScalar(pickNamed()) 'n'
		score = score + 4
	end 'n'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
func @isScalar {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 2
    x64.setccReg lessEqual, rdx
    x64.andRegReg rax, rax, rdx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 3
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 6
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @pickFloat {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
}

func @pickBoolean {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @pickNamed {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect pickFloat
    x64.movRegReg rcx, r8
    x64.callDirect isScalar
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, f
    x64.jmp critsplit#10
  f:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#2
  critsplit#10:
    x64.jmp ifcont#2
  ifcont#2:
    x64.callDirect pickBoolean
    x64.movRegReg rcx, r8
    x64.callDirect isScalar
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, b
    x64.jmp critsplit#11
  b:
    x64.leaRegRegImm32 rbx, rbx, 2
    x64.jmp ifcont#4
  critsplit#11:
    x64.jmp ifcont#4
  ifcont#4:
    x64.callDirect pickNamed
    x64.movRegReg rcx, r8
    x64.callDirect isScalar
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, n
    x64.jmp critsplit#12
  n:
    x64.leaRegRegImm32 rax, rbx, 4
    x64.jmp ifcont#6
  critsplit#12:
    x64.movRegReg rax, rbx
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 40
