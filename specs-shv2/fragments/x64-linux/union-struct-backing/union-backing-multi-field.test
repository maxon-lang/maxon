// Test: union-backing-multi-field
typealias Flag = int(0 to 1)
typealias Latency = int(0 to 50)
typealias ID = int(i64.min to i64.max)

type DetailMeta
	export let latency as Latency
	export let isMemory as Flag

	static function create(latency Latency, isMemory Flag) returns Self
		return Self{latency: latency, isMemory: isMemory}
	end 'create'
end 'DetailMeta'

union MemOp
	load(dest ID, offset ID) = DetailMeta.create(4, isMemory: 1)
	store(src ID, offset ID) = DetailMeta.create(3, isMemory: 1)
	add(dest ID, src ID) = DetailMeta.create(1, isMemory: 0)
end 'MemOp'

function main() returns ExitCode
	let memFlag = MemOp.load.isMemory
	let aluFlag = MemOp.add.isMemory
	return memFlag + aluFlag
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, rax
    x64.imulRegRegImm32 rax, rax, 0
    x64.leaRegRegReg rax, rcx, rax
    x64.movRegImm32 rcx, 2
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rdx
    x64.cmpRegImm32 rcx, 1
    x64.setccReg equal, rsi
    x64.leaRegRegReg rdx, rdx, rsi
    x64.cmpRegImm32 rcx, 2
    x64.setccReg equal, rcx
    x64.imulRegRegImm32 rcx, rcx, 0
    x64.leaRegRegReg rcx, rdx, rcx
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
