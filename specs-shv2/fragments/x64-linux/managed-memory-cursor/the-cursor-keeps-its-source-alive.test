// Test: the-cursor-keeps-its-source-alive
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function makeBuffer() returns ByteArray
	var arr = ByteArray.create()
	arr.push(4)
	arr.push(9)
	return arr
end 'makeBuffer'

function main() returns ExitCode
	let cursor = try makeBuffer().managed.createCursor() otherwise return 99
	var churn = 0
	for _ in 0 upto 500 'churn'
		var scratch = ByteArray.create()
		scratch.push(200)
		churn = churn + scratch.count()
	end 'churn'
	return cursor.current() + (try cursor.peek(1) otherwise 0)
end 'main'
---
ExitCode: 13
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @makeBuffer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 9
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect makeBuffer
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_cursor_create
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r13, 500
    x64.jcc less, churn
    x64.jmp forexit
  churn:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r14, r8
    x64.movRegImm32 rdx, 200
    x64.movRegReg rcx, r14
    x64.callDirect __managed_push
    x64.movRegReg rcx, r14
    x64.callDirect __managed_count
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_cursor_current
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_cursor_peek
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok#7:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg rbx, rbx, rax
    x64.movRegReg rcx, r12
    x64.callDirect __managed_cursor_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
