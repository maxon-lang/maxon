// Test: iteration.large-list
typealias Integer = int(i64.min to i64.max)
typealias IntList = List with Integer

function main() returns ExitCode
	var list = IntList.create()
	for i in 1 to 100 'build'
		list.append(i)
	end 'build'
	var sum = 0
	for item in list 'loop'
		sum = sum + item
	end 'loop'
	return sum - 5050
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_List_Integer]
    x64.callDirect List.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 1
  forhdr#1:
    x64.cmpRegImm32 r12, 100
    x64.jcc greater, forexit#4
  build:
    x64.leaRegRdata rax, [rip + __layout_List_Integer]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect List.append
  forstep#3:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect List.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forempty
  forhdr#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, forexit#9
  loop:
    x64.leaRegRdata rdx, [rip + __layout_ListIterator_Integer]
    x64.movRegReg rcx, r13
    x64.callDirect ListIterator.current
    x64.leaRegRegReg r12, r12, r8
  forstep#8:
    x64.movRegReg rcx, r13
    x64.callDirect ListIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr#5
  forexit#9:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ListIterator_Integer
    x64.movRegReg rax, r12
    x64.jmp forjoin
  forempty:
    x64.movRegReg rax, r12
  forjoin:
    x64.leaRegRegImm32 r12, rax, -5050
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_List_Integer
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
