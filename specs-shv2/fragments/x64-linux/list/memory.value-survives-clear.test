// Test: memory.value-survives-clear
typealias StringList = List with String

function main() returns ExitCode
	var list = StringList.create()
	list.append("hello world!!!!!!!!!!!!!!")
	let val = try list.first() otherwise "none"
	list.clear()
	print("{val}\n")
	return 0
end 'main'
---
CompilerError:
error E3070: <fragment>:8:7: cannot mutate 'list' via 'clear' while it is borrowed by 'val' (borrowed at line 7)
