// Test: basic.creation
function main() returns ExitCode
	let list = List from [10, 20, 30]
	return list.count()
end 'main'
---
ExitCode: 3
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 10
    x64.leaRegRdata rcx, [rip + __layout_List_int]
    x64.callDirect List.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_List_int]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect List.append
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_List_int]
    x64.movRegReg rcx, r12
    x64.callDirect List.append
    x64.movRegImm32 rdx, 30
    x64.leaRegRdata rax, [rip + __layout_List_int]
    x64.movRegReg rcx, r12
    x64.callDirect List.append
    x64.movRegReg rcx, r12
    x64.callDirect List.count
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_List_int
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @List.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rcx, [rcx + 40]
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @List.count {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __list_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @List.append {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __list_append
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
