// Test: large-magnitudes-relate-correctly
function main() returns ExitCode
	var r = 0
	if 1.0e300 > 0.0 'positiveBig'
		r = r + 1
	end 'positiveBig'
	if 1.0e-300 > 0.0 'positiveSmall'
		r = r + 2
	end 'positiveSmall'
	if 1.0e150 * 1.0e150 > 1.0e300 / 2.0 'squareIsSameDecade'
		r = r + 4
	end 'squareIsSameDecade'
	if 1.0e300 * 1.0e-300 > 0.5 'reciprocalIsOne'
		r = r + 8
	end 'reciprocalIsOne'
	return r
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, positiveBig
    x64.jmp critsplit#12
  positiveBig:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#2
  critsplit#12:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movsdRegRip xmm0, [rip + __fconst_3]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, positiveSmall
    x64.jmp critsplit#13
  positiveSmall:
    x64.leaRegRegImm32 rax, rax, 2
    x64.jmp ifcont#4
  critsplit#13:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movsdRegRip xmm0, [rip + __fconst_4]
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.movsdRegRip xmm2, [rip + __fconst_5]
    x64.divsdRegReg xmm1, xmm1, xmm2
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, squareIsSameDecade
    x64.jmp critsplit#14
  squareIsSameDecade:
    x64.leaRegRegImm32 rax, rax, 4
    x64.jmp ifcont#6
  critsplit#14:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_6]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, reciprocalIsOne
    x64.jmp critsplit#15
  reciprocalIsOne:
    x64.leaRegRegImm32 r8, rax, 8
    x64.jmp ifcont#8
  critsplit#15:
    x64.movRegReg r8, rax
    x64.jmp ifcont#8
  ifcont#8:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
