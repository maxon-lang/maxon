// Test: tight-budget-768-digit-midpoint
function main() returns ExitCode
	var r = 0
	if 0. == 2.2250738585072004e-308 'tieRoundsToEven'
		r = r + 1
	end 'tieRoundsToEven'
	if 0. == 2.225073858507201e-308 'stickyBitRoundsUp'
		r = r + 2
	end 'stickyBitRoundsUp'
	return r
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont#2
  fordered#8:
    x64.jcc notEqual, ifcont#2
  tieRoundsToEven:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc noParity, fordered#9
  critsplit#11:
    x64.movRegReg r8, rax
    x64.jmp ifcont#4
  fordered#9:
    x64.jcc notEqual, critsplit#13
  stickyBitRoundsUp:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp ifcont#4
  critsplit#13:
    x64.movRegReg r8, rax
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
