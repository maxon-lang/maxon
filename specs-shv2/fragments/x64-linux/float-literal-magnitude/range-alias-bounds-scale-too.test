// Test: range-alias-bounds-scale-too
typealias Astronomical = float(1.0e-30 to 1.0e30)

function main() returns ExitCode
	let x = 1.0e20 as Astronomical
	let y = 1.0e19 as Astronomical
	return trunc(x / y)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.divsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
