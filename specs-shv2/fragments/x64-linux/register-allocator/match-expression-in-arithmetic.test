// Test: match-expression-in-arithmetic
function main() returns ExitCode
	let x = 2
	let doubled = match x 'eval'
		1 gives 10
		2 gives 20
		default gives 0
	end 'eval' * 2
	return doubled
end 'main'
---
ExitCode: 40
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 rax, 10
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 rax, 20
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchcont:
    x64.imulRegRegImm32 r8, rax, 2
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
