// Test: int-callee-saved-clobber

typealias Integer = int(i64.min to i64.max)

function useRegs(a Integer, b Integer, c Integer, d Integer) returns Integer
	let x = a + b
	let y = c + d
	let z = x + y
	return z
end 'useRegs'

function main() returns ExitCode
	let sentinel = 42
	let result = useRegs(1, b: 2, c: 3, d: 4)
	return sentinel + result
end 'main'
---
ExitCode: 52
---
func @useRegs {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegReg rcx, rcx, rdx
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 3
    x64.movRegImm32 r9, 4
    x64.callDirect useRegs
    x64.leaRegRegImm32 r8, r8, 42
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
