// Test: error-throw-in-match

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	invalidInput
	notFound
end 'MyError'

function lookup(key Integer) returns Integer throws MyError
	match key 'dispatch'
		1 then return 100
		2 then return 200
		default then throw MyError.notFound
	end 'dispatch'
end 'lookup'

function main() returns ExitCode
	let a = try lookup(2) otherwise 0
	let b = try lookup(99) otherwise 42
	return (a + b) and 125
end 'main'
---
ExitCode: 112
---
func @lookup {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 100
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 200
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 rax, 1
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 2
    x64.callDirect lookup
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rcx, 99
    x64.callDirect lookup
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 42
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
    x64.jmp trycont#6
  trycont#6:
    x64.leaRegRegReg r8, rbx, rax
    x64.andRegImm32 r8, r8, 125
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
