// Test: int-value-live-across-nested-control
function main() returns ExitCode
	let sentinel = 100
	var total = 0
	var i = 0
	while i < 3 'outer'
		var j = 0
		while j < 3 'inner'
			if i == j 'diag'
				total = total + 1
			end 'diag'
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return sentinel + total
end 'main'
---
ExitCode: 103
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  whilehdr#1:
    x64.cmpRegImm32 rcx, 3
    x64.jcc greaterEqual, whileexit#3
  outer:
    x64.movRegImm32 rdx, 0
  whilehdr#4:
    x64.cmpRegImm32 rdx, 3
    x64.jcc greaterEqual, whileexit#6
  inner:
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, ifcont
  diag:
    x64.leaRegRegImm32 rax, rax, 1
  ifcont:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp whilehdr#4
  whileexit#6:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.leaRegRegImm32 r8, rax, 100
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
