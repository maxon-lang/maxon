// Test: int-twenty-vars-heavy-spill
function main() returns ExitCode
	let a = 1
	let b = 2
	let c = 3
	let d = 4
	let e = 5
	let f = 6
	let g = 7
	let h = 8
	let i = 9
	let j = 10
	let k = 11
	let l = 12
	let m = 13
	let n = 14
	let o = 15
	let p = 16
	let q = 17
	let r = 18
	let s = 19
	let t = 20
	return (a + b + c + d + e + f + g + h + i + j + k + l + m + n + o + p + q + r + s + t) and 125
end 'main'
---
ExitCode: 80
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 80
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
