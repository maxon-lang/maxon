// Test: int-fibonacci
function main() returns ExitCode
	var a = 0
	var b = 1
	var i = 0
	while i < 13 'loop'
		let temp = a + b
		a = b
		b = temp
		i = i + 1
	end 'loop'
	return a and 125
end 'main'
---
ExitCode: 105
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
  whilehdr:
    x64.cmpRegImm32 rdx, 13
    x64.jcc greaterEqual, whileexit
  loop:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.xchgRegReg rax, rcx
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, rax
    x64.andRegImm32 r8, rax, 125
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
