// Test: int-nested-loops-with-outer-var
function main() returns ExitCode
	var total = 0
	var i = 1
	while i <= 5 'outer'
		var j = 1
		while j <= i 'inner'
			total = total + 1
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return total
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
  whilehdr#1:
    x64.cmpRegImm32 rax, 5
    x64.jcc greater, whileexit#3
  outer:
    x64.movRegImm32 rcx, 1
  whilehdr#4:
    x64.cmpRegReg rcx, rax
    x64.jcc greater, whileexit#6
  inner:
    x64.leaRegRegImm32 r8, r8, 1
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr#4
  whileexit#6:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at int-nested-loops-with-outer-var.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
