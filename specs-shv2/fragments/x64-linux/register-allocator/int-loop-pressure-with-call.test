// Test: int-loop-pressure-with-call

typealias Integer = int(i64.min to i64.max)

function identity(x Integer) returns Integer
	return x
end 'identity'

function main() returns ExitCode
	var a = 1
	let b = 2
	var c = 3
	let d = 4
	var e = 5
	let f = 6
	var i = 0
	while i < 3 'loop'
		a = a + identity(b)
		c = c + identity(d)
		e = e + identity(f)
		i = i + 1
	end 'loop'
	return (a + c + d + e + f) mod 256
end 'main'
---
ExitCode: 55
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 5
    x64.movRegImm32 rsi, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rsi, 3
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.jmp __il_body#10
  __il_body#10:
    x64.jmp __il_cont#9
  __il_cont#9:
    x64.leaRegRegImm32 rax, rax, 2
    x64.jmp __il_body#11
  __il_body#11:
    x64.jmp __il_cont#8
  __il_cont#8:
    x64.leaRegRegImm32 rcx, rcx, 4
    x64.jmp __il_body#12
  __il_body#12:
    x64.jmp __il_cont#7
  __il_cont#7:
    x64.leaRegRegImm32 rdx, rdx, 6
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 rax, rax, 4
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegImm32 rax, rax, 6
    x64.movRegImm32 rcx, 256
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rdx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
