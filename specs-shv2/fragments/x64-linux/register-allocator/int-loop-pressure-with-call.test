// Test: int-loop-pressure-with-call

typealias Integer = int(i64.min to i64.max)

function identity(x Integer) returns Integer
	return x
end 'identity'

function main() returns ExitCode
	var a = 1
	let b = 2
	var c = 3
	let d = 4
	var e = 5
	let f = 6
	var i = 0
	while i < 3 'loop'
		a = a + identity(b)
		c = c + identity(d)
		e = e + identity(f)
		i = i + 1
	end 'loop'
	return (a + c + d + e + f) mod 256
end 'main'
---
ExitCode: 55
---
func @identity {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 2
    x64.movRegImm32 r13, 3
    x64.movRegImm32 r14, 5
    x64.movRegImm32 r15, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r15, 3
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegReg rcx, r12
    x64.callDirect identity
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 4
    x64.callDirect identity
    x64.leaRegRegReg r13, r13, r8
    x64.movRegImm32 rcx, 6
    x64.callDirect identity
    x64.leaRegRegReg r14, r14, r8
    x64.leaRegRegImm32 r15, r15, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRegReg rax, rbx, r13
    x64.leaRegRegImm32 rax, rax, 4
    x64.leaRegRegReg rax, rax, r14
    x64.leaRegRegImm32 rax, rax, 6
    x64.movRegImm32 rcx, 256
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rdx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
