// Test: bare-call-with-args

typealias Integer = int(i64.min to i64.max)

type Adder
	export var base as Integer

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'

	function add(x Integer) returns Integer
		return base + x
	end 'add'

	function addTwice(x Integer) returns Integer
		return add(x) + add(x)
	end 'addTwice'
end 'Adder'

function main() returns ExitCode
	let a = Adder.create(1)
	return a.addTwice(3)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Adder.addTwice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body#3
  __il_body#3:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.jmp __il_cont#2
  __il_cont#2:
    x64.jmp __il_body#4
  __il_body#4:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg rcx, rcx, rdx
    x64.jmp __il_cont#1
  __il_cont#1:
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rdx, 3
    x64.callDirect Adder.addTwice
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
