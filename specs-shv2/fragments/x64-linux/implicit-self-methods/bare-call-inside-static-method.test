// Test: bare-call-inside-static-method

typealias Integer = int(i64.min to i64.max)

type Maker
	export var n as Integer

	static function mk() returns Integer
		return 7
	end 'mk'

	static function build() returns Integer
		return mk() + 1
	end 'build'
end 'Maker'

function main() returns ExitCode
	return Maker.build()
end 'main'
---
ExitCode: 8
---
func @Maker.build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 7
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Maker.build
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
