// Test: a-reload-inherits-its-victims-register-file
typealias Num = int(-1000000000 to 1000000000)

function bump(x Num) returns Num
	return x + 1
end 'bump'

function pressure(k Num) returns Num
	let a = 1.0
	let b = 2.0
	let c = 3.0
	let d = 4.0
	let e = 5.0
	let f = 6.0
	let g = 7.0
	let h = 8.0
	let i = 9.0
	let j = 10.0
	let l = 11.0
	let m = 12.0
	var acc = k
	acc = bump(acc)
	acc = acc + trunc(a) + trunc(b) + trunc(c) + trunc(d) + trunc(e) + trunc(f)
	acc = acc + trunc(g) + trunc(h) + trunc(i) + trunc(j) + trunc(l) + trunc(m)
	return acc
end 'pressure'

function main() returns ExitCode
	return pressure(0) as ExitCode
end 'main'
---
ExitCode: 79
---
func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, -1000000000
    x64.jcc less, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 1000000000
    x64.jcc greater, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.leaRegRegImm32 r8, rcx, 1
    x64.cmpRegImm32 r8, -1000000000
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 r8, 1000000000
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

