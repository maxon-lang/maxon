// Test: two-floats-multiplied-between-calls
function work(x Integer) returns Integer
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var s = 0.0
	var acc = 0
	acc = work(acc)
	s = s + a * b
	acc = work(acc)
	s = s + a * b
	return trunc(s) + acc
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 9
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_cont#5:
    x64.movsdRegRip xmm0, [rip + __fconst_3.75]
  __il_cont#4:
    x64.movsdRegRip xmm1, [rip + __fconst_3.75]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg rax, xmm0
    x64.leaRegRegImm32 r8, rax, 2
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at two-floats-multiplied-between-calls.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
