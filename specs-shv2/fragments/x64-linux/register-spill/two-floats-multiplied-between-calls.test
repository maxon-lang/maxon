// Test: two-floats-multiplied-between-calls
function work(x int) returns int
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var s = 0.0
	var acc = 0
	acc = work(acc)
	s = s + a * b
	acc = work(acc)
	s = s + a * b
	return trunc(s) + acc
end 'main'
---
ExitCode: 9
---
func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 64
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.storeSlotReg slot2, xmm8
    x64.movsdRegRip xmm6, [rip + __fconst_1]
    x64.movsdRegRip xmm7, [rip + __fconst_2]
    x64.movsdRegRip xmm8, [rip + __fconst_3]
    x64.movRegImm32 rcx, 0
    x64.callDirect work
    x64.movRegReg xmm0, xmm6
    x64.mulsdRegReg xmm0, xmm6, xmm7
    x64.addsdRegReg xmm8, xmm8, xmm0
    x64.movRegReg rcx, r8
    x64.callDirect work
    x64.mulsdRegReg xmm6, xmm6, xmm7
    x64.addsdRegReg xmm8, xmm8, xmm6
    x64.cvttsd2siRegReg rax, xmm8
    x64.leaRegRegReg r8, rax, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
}
