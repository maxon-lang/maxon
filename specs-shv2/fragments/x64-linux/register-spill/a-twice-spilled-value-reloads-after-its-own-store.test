// Test: a-twice-spilled-value-reloads-after-its-own-store
function main() returns ExitCode
	let b = [72]
	var one = ""
	for x in b 'eachOne'
		one = "{one}{x}"
	end 'eachOne'
	var two = ""
	for x in b 'eachTwo'
		two = "{two}{x}"
	end 'eachTwo'
	print("{one} {two}\n")
	return 0
end 'main'
