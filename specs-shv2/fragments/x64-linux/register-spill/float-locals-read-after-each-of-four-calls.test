// Test: float-locals-read-after-each-of-four-calls
function work(x Integer) returns Integer
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var acc = 0
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	return acc
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 16
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_1.5]
    x64.movsdRegRip xmm1, [rip + __fconst_2.5]
  __il_cont#7:
    x64.cvttsd2siRegReg rax, xmm0
    x64.leaRegRegImm32 rcx, rax, 1
    x64.cvttsd2siRegReg rdx, xmm1
    x64.leaRegRegReg rcx, rcx, rdx
  __il_body#9:
    x64.leaRegRegImm32 rcx, rcx, 1
  __il_cont#6:
    x64.leaRegRegReg rcx, rcx, rax
    x64.leaRegRegReg rcx, rcx, rdx
  __il_body#10:
    x64.leaRegRegImm32 rcx, rcx, 1
  __il_cont#5:
    x64.leaRegRegReg rcx, rcx, rax
    x64.leaRegRegReg rcx, rcx, rdx
  __il_body#11:
    x64.leaRegRegImm32 rcx, rcx, 1
  __il_cont#4:
    x64.leaRegRegReg rax, rcx, rax
    x64.leaRegRegReg r8, rax, rdx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-locals-read-after-each-of-four-calls.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
