// Test: float-locals-read-after-each-of-two-calls
function work(x int) returns int
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var acc = 0
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	acc = work(acc)
	acc = acc + trunc(a) + trunc(b)
	return acc
end 'main'
---
ExitCode: 8
---
func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movsdRegRip xmm6, [rip + __fconst_1]
    x64.movsdRegRip xmm7, [rip + __fconst_2]
    x64.movRegImm32 rcx, 0
    x64.callDirect work
    x64.cvttsd2siRegReg rax, xmm6
    x64.leaRegRegReg rax, r8, rax
    x64.cvttsd2siRegReg rcx, xmm7
    x64.leaRegRegReg rcx, rax, rcx
    x64.callDirect work
    x64.cvttsd2siRegReg rax, xmm6
    x64.leaRegRegReg rax, r8, rax
    x64.cvttsd2siRegReg rcx, xmm7
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
