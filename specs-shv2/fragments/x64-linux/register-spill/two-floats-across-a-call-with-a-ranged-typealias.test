// Test: two-floats-across-a-call-with-a-ranged-typealias
typealias Num = int(-1000000000 to 1000000000)

function work(x Num) returns Num
	return x + 1
end 'work'

function probe(k Num) returns Num
	let f0 = 1.5
	let f2 = 3.625
	var acc = k
	acc = work(acc)
	acc = acc + trunc(f2 * f0 * 64.0)
	return acc
end 'probe'

function main() returns ExitCode
	return (probe(1) - probe(0) + 41) as ExitCode
end 'main'
---
ExitCode: 42
---
func @work {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, -1000000000
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 1000000000
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at two-floats-across-a-call-with-a-ranged-typealias.test:4: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.leaRegRegImm32 r8, rcx, 1
    x64.cmpRegImm32 r8, -1000000000
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.cmpRegImm32 r8, 1000000000
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at two-floats-across-a-call-with-a-ranged-typealias.test:5: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

