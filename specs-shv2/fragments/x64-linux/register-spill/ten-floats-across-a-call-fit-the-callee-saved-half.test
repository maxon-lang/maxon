// Test: ten-floats-across-a-call-fit-the-callee-saved-half
function bump(x int) returns int
	return x + 1
end 'bump'

function pressure(k int) returns int
	let a = 1.0
	let b = 2.0
	let c = 3.0
	let d = 4.0
	let e = 5.0
	let f = 6.0
	let g = 7.0
	let h = 8.0
	let i = 9.0
	let j = 10.0
	var acc = k
	acc = bump(acc)
	acc = acc + trunc(a) + trunc(b) + trunc(c) + trunc(d) + trunc(e)
	acc = acc + trunc(f) + trunc(g) + trunc(h) + trunc(i) + trunc(j)
	return acc
end 'pressure'

function main() returns ExitCode
	return pressure(0) as ExitCode
end 'main'
---
ExitCode: 56
---
func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @pressure {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 112
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.storeSlotReg slot2, xmm8
    x64.storeSlotReg slot3, xmm9
    x64.storeSlotReg slot4, xmm10
    x64.storeSlotReg slot5, xmm11
    x64.storeSlotReg slot6, xmm12
    x64.storeSlotReg slot7, xmm13
    x64.storeSlotReg slot8, xmm14
    x64.storeSlotReg slot9, xmm15
    x64.movsdRegRip xmm6, [rip + __fconst_1]
    x64.movsdRegRip xmm7, [rip + __fconst_2]
    x64.movsdRegRip xmm8, [rip + __fconst_3]
    x64.movsdRegRip xmm9, [rip + __fconst_4]
    x64.movsdRegRip xmm10, [rip + __fconst_5]
    x64.movsdRegRip xmm11, [rip + __fconst_6]
    x64.movsdRegRip xmm12, [rip + __fconst_7]
    x64.movsdRegRip xmm13, [rip + __fconst_8]
    x64.movsdRegRip xmm14, [rip + __fconst_9]
    x64.movsdRegRip xmm15, [rip + __fconst_10]
    x64.callDirect bump
    x64.cvttsd2siRegReg rax, xmm6
    x64.leaRegRegReg rax, r8, rax
    x64.cvttsd2siRegReg rcx, xmm7
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm8
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm9
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm10
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm11
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm12
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm13
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm14
    x64.leaRegRegReg rax, rax, rcx
    x64.cvttsd2siRegReg rcx, xmm15
    x64.leaRegRegReg r8, rax, rcx
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.loadRegSlot xmm9, slot3
    x64.loadRegSlot xmm10, slot4
    x64.loadRegSlot xmm11, slot5
    x64.loadRegSlot xmm12, slot6
    x64.loadRegSlot xmm13, slot7
    x64.loadRegSlot xmm14, slot8
    x64.loadRegSlot xmm15, slot9
    x64.epilogue 112
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect pressure
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
