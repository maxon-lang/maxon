// Test: error.static-call-as-a-statement
typealias Num = int(0 to 1000)

type Gate
	export var n as Num

	export static function make(v Num) returns Gate
		return Self{n: v}
	end 'make'

	export function bad() returns Num
		Gate.make(1)
		return 1
	end 'bad'
end 'Gate'

function main() returns ExitCode
	return Gate.make(0).n
end 'main'
