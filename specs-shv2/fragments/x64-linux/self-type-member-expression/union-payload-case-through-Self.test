// Test: union-payload-case-through-Self
typealias Num = int(0 to 100)

union Res
	ok(v Num)
	none

	export function bump() returns Res
		return Self.ok(42)
	end 'bump'

	export function blank() returns Res
		return Self.none
	end 'blank'
end 'Res'

function main() returns ExitCode
	let r = Res.none
	let s = r.bump()
	let t = s.blank()
	return match t 'blanked'
		ok gives 1
		none gives match s 'bumped'
			ok(v) gives v
			none gives 2
		end 'bumped'
	end 'blanked'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 72
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.leaRegSlot rax, slot0
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.movRegImm32 rcx, 42
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.leaRegSlot rcx, slot2
    x64.movRegImm32 rdx, 1
    x64.storeBaseDispReg.word64 [rcx + 0], rdx
    x64.movRegImm32 rdx, 0
    x64.storeBaseDispReg.word64 [rcx + 8], rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#9
  matcharm#1:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont#10
  matchnext#9:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead#8
  matcharm#2:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#6
  matcharm#3:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.jmp matchcont#7
  matchnext#6:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#4
    x64.jmp matchdead#5
  matcharm#4:
    x64.movRegImm32 rax, 2
    x64.jmp matchcont#7
  matchcont#7:
    x64.movRegReg rbx, rax
    x64.jmp matchcont#10
  matchcont#10:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#5:
  matchdead#8:
}
