// Test: a-write-is-an-access-and-forces-the-initializer
typealias Count = int(0 to u64.max)

type Slot
	static var runs = 0
	static var value = Slot.build()
	export var n as Count

	static function build() returns Slot
		Slot.runs = Slot.runs + 1
		return Slot{n: 1}
	end 'build'

	static function of(n Count) returns Self
		return Self{n: n}
	end 'of'

	export static function set(s Slot)
		Slot.value = s
	end 'set'

	export static function get() returns Count
		return Slot.value.n
	end 'get'

	export static function runCount() returns Count
		return Slot.runs
	end 'runCount'
end 'Slot'

function main() returns ExitCode
	Slot.set(Slot.of(99))
	print("{Slot.get()} {Slot.runCount()}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Slot.runs@0 = i64 0
  __data_Slot.value@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @Slot.build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegGlobal rax, __data_Slot.runs
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_Slot.runs
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Slot.of {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Slot.set {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.callDirect __lazy_init#__data_Slot.value
    x64.leaRegGlobal rax, __data_Slot.value
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_decref
    x64.callDirect __lazy_init#__data_Slot.value
    x64.leaRegGlobal rax, __data_Slot.value
    x64.storeBaseDispReg.word64 [rax + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Slot.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __lazy_init#__data_Slot.value
    x64.leaRegGlobal rax, __data_Slot.value
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 99
    x64.callDirect Slot.of
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Slot.set
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.callDirect Slot.get
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot0, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __uint_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot4, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
  __il_body:
    x64.leaRegGlobal rax, __data_Slot.runs
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
  __il_cont:
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r15
    x64.callDirect __uint_to_string
    x64.storeSlotReg slot3, r8
    x64.leaRegRegReg rax, rbx, r13
    x64.leaRegRegReg rax, rax, r8
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r14, r8, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r14, rbx
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot4
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.loadRegSlot r12, slot3
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], r14
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
