// Test: character-ordering-of-two-owned-temporaries
function main() returns ExitCode
	let s = "üé"
	var seen = 0
	for c in s 'each'
		for d in s 'inner'
			if c < d 'lt'
				seen = seen + 1
			end 'lt'
		end 'inner'
	end 'each'
	print("{seen}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

