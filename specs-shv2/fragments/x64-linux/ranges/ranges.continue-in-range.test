// Test: ranges.continue-in-range
function main() returns ExitCode
		var sum = 0
		for i in 1 to 10 'loop'
				if i mod 2 == 0 'skip'
						continue
				end 'skip'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rcx, 1
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rcx, 10
    x64.jcc lessEqual, loop
    x64.jmp forexit
  loop:
    x64.movRegImm32 rsi, 2
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, skip
    x64.jmp ifcont
  skip:
    x64.jmp forstep
  ifcont:
    x64.leaRegRegReg rax, r8, rcx
    x64.movRegReg r8, rax
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.popReg rbp
    x64.ret
}
