// Test: ranges.ranged-alias-parameter-bound-stays-legal
typealias Row = int(0 to 63)

function sumTo(lastRow Row) returns Row
	var total = 0 as Row
	for r in 0 to lastRow 'l'
		total = total + r
	end 'l'
	return total
end 'sumTo'

function main() returns ExitCode
	var chars = 0
	for _ in 'a' to 'e' 'k'
		chars = chars + 1
	end 'k'
	return (sumTo(5) + chars) as ExitCode
end 'main'
---
ExitCode: 20
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @sumTo {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#6
    x64.jmp __rc_chk#7
  __rc_chk#7:
    x64.cmpRegImm32 rcx, 63
    x64.jcc greater, __rc_panic#6
    x64.jmp __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc lessEqual, l
    x64.jmp forexit
  l:
    x64.leaRegRegReg r8, r8, rax
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#9
    x64.jmp __rc_chk#10
  __rc_chk#10:
    x64.cmpRegImm32 r8, 63
    x64.jcc greater, __rc_panic#9
    x64.jmp __rc_ok#8
  __rc_panic#9:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#8:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 97
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r12, 101
    x64.jcc lessEqual, k
    x64.jmp forexit
  k:
    x64.movRegReg rcx, r12
    x64.callDirect __char_from_cp
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 rcx, 5
    x64.callDirect sumTo
    x64.leaRegRegReg r8, r8, rbx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
