// Test: ranges.character-range
function main() returns ExitCode
		var count = 0
		for _ in 'a' to 'z' 'loop'
				count = count + 1
		end 'loop'
		return count
end 'main'
---
ExitCode: 26
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 97
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 r12, 122
    x64.jcc lessEqual, loop
    x64.jmp forexit
  loop:
    x64.movRegReg rcx, r12
    x64.callDirect __char_from_cp
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
