// Test: try-block.array-get-success
typealias Score = int(0 to 100)
typealias ScoreArray = Array with Score

function main() returns ExitCode
    var arr = ScoreArray.create()
    arr.push(7)
    arr.push(11)

    var sum = 0
    try 'work'
        let a = arr.get(0)
        let b = arr.get(1)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            indexOutOfBounds then sum = 99
            emptySlot then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 18
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 11
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit#13
    x64.jmp tryblkok#2
  critsplit#13:
    x64.jmp tryblkerr
  tryblkok#2:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, critsplit#14
    x64.jmp tryblkok#3
  critsplit#14:
    x64.jmp tryblkerr
  tryblkerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#4
    x64.jmp matchnext
  matcharm#4:
    x64.movRegImm32 rax, 99
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#5
    x64.jmp matchdead
  matcharm#5:
    x64.movRegImm32 rax, 99
    x64.jmp matchcont
  matchcont:
    x64.movRegReg r12, rax
    x64.jmp tryblkcont
  matchdead:
  tryblkok#3:
    x64.leaRegRegReg r12, r12, r8
    x64.jmp tryblkcont
  tryblkcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
