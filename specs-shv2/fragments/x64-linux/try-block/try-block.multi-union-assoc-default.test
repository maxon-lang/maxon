// Test: try-block.multi-union-assoc-default
typealias Score = int(0 to 1000)

union ErrA implements Error
    bad(code Score)
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad(50)
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(true)
        let b = callB(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            ErrB.splat then sum = 99
            default panic("unhandled error variant")
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @callA {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  c:
    x64.movRegImm32 rbx, 50
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rax, r8
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.storeBaseDispReg.word64 [rax + 8], rbx
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @callB {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  c:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 6
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect callA
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#2
  tryblkthrow:
    x64.loadRegBaseDisp.word64 rax, [r10 + 0]
    x64.movRegReg rcx, r10
    x64.jmp tryblkerr
  tryblkok#2:
    x64.movRegImm32 rcx, 0
    x64.callDirect callB
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#4
  critsplit:
    x64.movRegReg rcx, r10
    x64.movRegReg rax, r10
  tryblkerr:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.movRegImm32 r8, 99
    x64.jmp tryblkcont
  matchdefault:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, errunionnext
  errunionclean:
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, errunionnext
  errunionfree:
    x64.callDirect __mm_decref
  errunionnext:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at try-block.multi-union-assoc-default.test:36: unhandled error variant\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryblkok#4:
    x64.leaRegRegReg r8, rbx, r8
  tryblkcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at try-block.multi-union-assoc-default.test:39: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
