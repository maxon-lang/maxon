// Test: try-block.nested
typealias Score = int(0 to 100)

enum ErrA implements Error
    kaboom
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.kaboom
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'outer'
        try 'inner'
            let a = callA(true)
            sum = sum + a
        end 'inner'
        otherwise (ie) 'ih'
            match ie 'ik'
                kaboom then sum = sum + 1
            end 'ik'
        end 'ih'
        let b = callB(true)
        sum = sum + b
    end 'outer'
    otherwise (e) 'h'
        match e 'k'
            splat then sum = sum + 40
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 41
---
func @callA {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  c:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @callB {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  c:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 6
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect callA
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#3
  tryblkerr#2:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead#5
  matcharm#4:
    x64.movRegImm32 rbx, 1
    x64.jmp tryblkcont#7
  matchdead#5:
  tryblkok#3:
    x64.movRegReg rbx, r8
  tryblkcont#7:
    x64.movRegImm32 rcx, 1
    x64.callDirect callB
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryblkok#8
  tryblkerr#1:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchdead#10
  matcharm#9:
    x64.leaRegRegImm32 r8, rbx, 40
    x64.jmp tryblkcont#12
  matchdead#10:
  tryblkok#8:
    x64.leaRegRegReg r8, rbx, r8
  tryblkcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
