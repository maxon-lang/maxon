    x64.movRegReg rbp, rsp
  __il_body#16:
    x64.movRegImm32 rax, 1
  __il_cont#15:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __il_body#18
  subnormalMin:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body#18:
    x64.movRegImm rax, 4503599627370495
  __il_cont#17:
    x64.movRegImm rcx, 4503599627370495
    x64.cmpRegReg rax, rcx
    x64.jcc equal, __il_body#20
  subnormalMax:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  __il_body#20:
    x64.movRegImm32 rax, 0
  __il_cont#19:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#22
  positiveZero:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  __il_body#22:
    x64.movRegImm rax, 4607182418800017408
  __il_cont#21:
    x64.movRegImm rcx, 4607182418800017408
    x64.cmpRegReg rax, rcx
    x64.jcc equal, ifcont#8
  one:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm rax, 9223372036854775808
  __il_body#24:
    x64.movRegImm rcx, 9223372036854775808
  __il_cont#23:
    x64.cmpRegReg rcx, rax
    x64.jcc equal, ifcont#14
  negativeZero:
