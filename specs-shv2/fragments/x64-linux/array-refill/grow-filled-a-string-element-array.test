    x64.jcc greaterEqual, forexit
  sum:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + r13*8 + 0]
  __im_cont#15:
    x64.leaRegRdata rdx, [rip + __str_rec_8]
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, critsplit#21
