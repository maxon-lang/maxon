// Test: grow-filled-a-string-element-array
typealias StringArray = Array with String

function main() returns ExitCode
	var arr = StringArray.create()
	arr.push("ab")
	arr.growFilled(4, value: "cde")
	var hits = 0
	for s in arr 'sum'
		if s == "cde" 'match'
			hits = hits + 1
		end 'match'
	end 'sum'
	let first = try arr.get(0) otherwise "??"
	if first == "ab" 'prefixKept'
		hits = hits + 10
	end 'prefixKept'
	return hits
end 'main'
---
ExitCode: 13
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

