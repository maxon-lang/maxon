// Test: valid.compatible-casts-still-compile
typealias Small = int(0 to 100)
typealias Big = int(0 to 1000)
typealias Ratio = float(f64.min to f64.max)

function isPositive(r Ratio) returns bool
	return r > 0.0
end 'isPositive'

function main() returns ExitCode
	let big = 42 as Big
	let small = big as Small
	let r = 42 as Ratio
	if isPositive(r) 'ok'
		return small
	end 'ok'
	return 0
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 42
    x64.movRegImm32 rax, 42
    x64.cvtsi2sdRegReg xmm0, rax
  __il_body:
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg above, rax
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  ok:
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
