// Test: byte-array-constant-identity
let A = b"hi"
let B = b"hi"
let C = b"ho"

function main() returns ExitCode
	var result = 0
	if A is A 'self'
		result = result + 1
	end 'self'
	if A is B 'sameBytes'
		result = result + 2
	end 'sameBytes'
	if A is not C 'otherBytes'
		result = result + 4
	end 'otherBytes'
	if A is not b"hi" 'inlineIsItsOwn'
		result = result + 8
	end 'inlineIsItsOwn'
	return result
end 'main'
---
ExitCode: 15
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.leaRegRdata rcx, [rip + __barr_rec_2]
    x64.leaRegRdata rdx, [rip + __barr_rec_2]
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, ifcont#2
  self:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.leaRegRdata rcx, [rip + __barr_rec_2]
    x64.leaRegRdata rdx, [rip + __barr_rec_2]
    x64.cmpRegReg rcx, rdx
    x64.jcc notEqual, ifcont#4
  sameBytes:
    x64.leaRegRegImm32 rax, rax, 2
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __barr_rec_2]
    x64.leaRegRdata rdx, [rip + __barr_rec_3]
    x64.cmpRegReg rcx, rdx
    x64.jcc equal, critsplit#14
  otherBytes:
    x64.leaRegRegImm32 rbx, rax, 4
    x64.jmp ifcont#6
  critsplit#14:
    x64.movRegReg rbx, rax
  ifcont#6:
    x64.leaRegRdata r12, [rip + __barr_rec_2]
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r8 + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [r8 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 24], rax
    x64.cmpRegReg r12, r8
    x64.setccReg notEqual, r12
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, critsplit#15
  inlineIsItsOwn:
    x64.leaRegRegImm32 r8, rbx, 8
    x64.jmp ifcont#8
  critsplit#15:
    x64.movRegReg r8, rbx
  ifcont#8:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at byte-array-constant-identity.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
