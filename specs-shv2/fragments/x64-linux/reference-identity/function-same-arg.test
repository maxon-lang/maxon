// Test: function-same-arg
typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Box'

function areSame(a Box, b Box) returns bool
	return a is b
end 'areSame'

function main() returns ExitCode
	let x = Box.create(42)
	let y = Box.create(42)
	var result = 0
	if areSame(x, b: x) 'same'
		result = result + 1
	end 'same'
	if areSame(x, b: y) 'diff'
		result = result + 10
	end 'diff'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @areSame {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 42
    x64.callDirect Box.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 42
    x64.callDirect Box.create
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, rbx
    x64.callDirect areSame
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, same
    x64.jmp critsplit#8
  same:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect areSame
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, diff
    x64.jmp critsplit#9
  diff:
    x64.leaRegRegImm32 r13, r13, 10
    x64.jmp ifcont#4
  critsplit#9:
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
