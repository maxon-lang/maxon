// Test: byte-string-literal.untouched-literal-drops-clean
function main() returns ExitCode
		var total = 0
		var i = 0
		while i < 3 'round'
				var a = b"hi"
				let v = try a.get(0) otherwise 0
				total = total + v
				i = i + 1
		end 'round'
		print("{total}")
		return 0
end 'main'
---
ExitCode: 0
---
