// Test: enum-method-export-same-file
enum Toggle
	on
	off

	export function isOn() returns bool
		return match self 'check'
			on gives true
			off gives false
		end 'check'
	end 'isOn'
end 'Toggle'

function main() returns ExitCode
	let t = Toggle.on
	if t.isOn() 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#5
    x64.jmp matchnext
  matcharm#5:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchdead
  matcharm#6:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchcont:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchdead:
}
