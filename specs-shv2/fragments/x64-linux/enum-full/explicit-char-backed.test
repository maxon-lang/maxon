// Test: explicit-char-backed
enum Direction
	North = 'n'
	South = 's'
	East = 'e'
end 'Direction'

function main() returns ExitCode
	let d = Direction.North
	let result = match d 'check'
		North gives 1
		South gives 0
		East gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 110
    x64.cmpRegImm32 rax, 101
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#5
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 110
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#6
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 115
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
