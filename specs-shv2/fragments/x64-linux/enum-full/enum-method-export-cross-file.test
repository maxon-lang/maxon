// Test: enum-method-export-cross-file
// --- file: signal.maxon
export enum Signal
	on
	off

	export function isOn() returns bool
		return match self 'check'
			on gives true
			off gives false
		end 'check'
	end 'isOn'
end 'Signal'

// --- file: main.maxon
function main() returns ExitCode
	let s = Signal.on
	if s.isOn() 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @Signal.isOn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect Signal.isOn
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
