// Test: a-static-reads-the-count
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Vec5 = Vector with 5 Int

var trips = 0

extension Vector
	export static function counted() returns Self
		var i = 0
		while i < countof(Self) 'each'
			trips = trips + 1
			i = i + 1
		end 'each'
		return Self{}
	end 'counted'

	export function rebuild() returns Int
		let fresh = Self.counted()
		var slots = 0
		for _ in fresh 'countTheRecordsSlots'
			slots = slots + 1
		end 'countTheRecordsSlots'
		if slots == countof(Self) 'theStaticsResultStatesTheReceiversCount'
			return 0
		end 'theStaticsResultStatesTheReceiversCount'
		panic("a `Self`-returning static builds the instance its call site holds")
	end 'rebuild'
end 'Vector'

function main() returns ExitCode
	var a = Vec3.create()
	var b = Vec5.create()
	return a.rebuild() + b.rebuild() + trips
end 'main'
---
ExitCode: 8
---
data {
  __data_trips@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Vector.counted {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 rax, 0
  whilehdr:
    x64.cmpRegReg rax, rbx
    x64.jcc greaterEqual, whileexit
  each:
    x64.leaRegGlobal rdx, __data_trips
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.leaRegGlobal rsi, __data_trips
    x64.storeBaseDispReg.word64 [rsi + 0], rdx
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.rebuild {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Vector.counted
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, r13
    x64.callDirect Vector.createIterator
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forempty
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, forexit
  countTheRecordsSlots:
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.callDirect ArrayIterator.current
    x64.leaRegRegImm32 r14, r14, 1
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __drop_type_param
  forstep:
    x64.movRegReg rcx, r15
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_ArrayIterator_T4b39db24a89d29c9
    x64.movRegReg rax, r14
    x64.jmp forjoin
  forempty:
    x64.movRegReg rax, r14
  forjoin:
    x64.cmpRegReg rax, r12
    x64.jcc notEqual, ifcont
  theStaticsResultStatesTheReceiversCount:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Vector_N3_Int]
    x64.movRegImm32 rdx, 3
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __layout_Vector_N5_Int]
    x64.movRegImm32 rdx, 5
    x64.callDirect Vector.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __layout_Vector_N3_Int]
    x64.movRegImm32 rax, 3
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.rebuild
    x64.movRegReg r13, r8
    x64.leaRegRdata rdx, [rip + __layout_Vector_N5_Int]
    x64.movRegImm32 rax, 5
    x64.movRegReg rcx, r12
    x64.callDirect Vector.rebuild
    x64.leaRegRegReg rax, r13, r8
    x64.leaRegGlobal rcx, __data_trips
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r13, rax, rcx
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
