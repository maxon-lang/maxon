// Test: one-shared-body-answers-each-instances-own-count
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Vec5 = Vector with 5 Int

extension Vector
	export function capacity() returns Int
		return countof(Self)
	end 'capacity'
end 'Vector'

function main() returns ExitCode
	var a = Vec3.create()
	var b = Vec5.create()
	return a.capacity() * 10 + b.capacity()
end 'main'
---
ExitCode: 35
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Vector_N3_Int]
    x64.movRegImm32 rdx, 3
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __layout_Vector_N5_Int]
    x64.movRegImm32 rdx, 5
    x64.callDirect Vector.create
    x64.movRegImm32 rax, 3
    x64.jmp __il_body#6
  __il_body#6:
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.imulRegRegImm32 rax, rax, 10
    x64.jmp __il_body#7
  __il_body#7:
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.leaRegRegImm32 r12, rax, 5
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Vector.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_resize
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
