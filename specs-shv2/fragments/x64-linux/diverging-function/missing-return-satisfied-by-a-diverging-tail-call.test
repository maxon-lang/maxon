    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.imulRegRegImm32 r8, r8, 7
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]  ; "panic at missing-return-satisfied-by-a-diverging-tail-call.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
