// Test: missing-return-satisfied-by-a-diverging-tail-call
function fatal(tag Integer)
	panic("fatal {tag}")
end 'fatal'

function pick(b bool) returns Integer
	if b 'y'
		return 6
	end 'y'
	fatal(9)
end 'pick'

function main() returns ExitCode
	return pick(true) * 7
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
