// Test: closer-case-member-and-the-declaration-sweep
enum Kw
	alpha
	end
	omega
end 'Kw'

var counter = 10

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function shadowing() returns Integer
	let a = tagOf(Kw.end)
	var counter = 100
	counter = counter + 1
	return a + counter
end 'shadowing'

function main() returns ExitCode
	return (shadowing() + counter) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 113
---
data {
  __data_counter@0 = i64 10
}

func @shadowing {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  matcharm:
    x64.movRegImm32 rax, 2
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 101
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect shadowing
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
