// Test: constructing-a-payload-carrying-keyword-case
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	end(a Num, b Num)
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		alpha(n) then return n
		end(a, b) then return a + b
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var acc = 0
	var i = 0
	while i < 2 'spin'
		if tagOf(Kw.end(20, b: 1)) == 21 'ok'
			acc = acc + 21
		end 'ok'
		i = i + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 1000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 2
    x64.jcc less, spin
    x64.jmp whileexit
  spin:
    x64.movRegImm32 r13, 20
    x64.movRegImm32 r14, 1
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r15 + 0], rax
    x64.storeBaseDispReg.word64 [r15 + 8], r13
    x64.storeBaseDispReg.word64 [r15 + 16], r14
    x64.jmp __il_body
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r15 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#11
    x64.jmp matchnext
  matcharm#11:
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.jmp __il_cont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#12
    x64.jmp matchdead
  matcharm#12:
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.loadRegBaseDisp.word64 rcx, [r15 + 16]
    x64.leaRegRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk#17
  __rc_chk#17:
    x64.cmpRegImm32 rax, 1000
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok#16
  __il_slow:
    x64.movRegReg rcx, r15
    x64.callDirect tagOf
    x64.movRegReg rax, r8
    x64.jmp __il_cont
  __rc_ok#16:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 21
    x64.setccReg equal, r13
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, ok
    x64.jmp critsplit
  ok:
    x64.leaRegRegImm32 rax, rbx, 21
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, rbx
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 r12, r12, 1
    x64.movRegReg rbx, rax
    x64.jmp whilehdr
  matchdead:
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk#8
  __rc_chk#8:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok#6
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchcont:
}
