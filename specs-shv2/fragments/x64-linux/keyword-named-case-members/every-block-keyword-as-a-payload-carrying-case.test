// Test: every-block-keyword-as-a-payload-carrying-case
typealias Num = int(0 to 1000)

union Kw
	if(a Num)
	else(b Num)
	end(c Num)
	while(d Num)
	match(e Num)
	for(f Num)
	otherwise(g Num)
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		if(a) then return a
		else(b) then return b
		end(c) then return c
		while(d) then return d
		match(e) then return e
		for(f) then return f
		otherwise(g) then return g
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 2 'spin'
		sum = sum + tagOf(Kw.if(1)) + tagOf(Kw.else(2)) + tagOf(Kw.end(4)) + tagOf(Kw.while(8))
		i = i + 1
	end 'spin'
	if sum == 30 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5, [5]=matcharm#6, [6]=matcharm#7] @__jumptable_0
  matchdead:
  matcharm#1:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matcharm#2:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matcharm#3:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matcharm#4:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matcharm#5:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matcharm#6:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matcharm#7:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rax, 2
    x64.jcc less, spin
    x64.jmp whileexit
  spin:
    x64.movRegImm32 r12, 1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r13
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 r12, 2
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 0], rax
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.movRegReg rcx, r14
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 r12, 4
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 2
    x64.storeBaseDispReg.word64 [r15 + 0], rax
    x64.storeBaseDispReg.word64 [r15 + 8], r12
    x64.movRegReg rcx, r15
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegReg rcx, r12
    x64.callDirect tagOf
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 30
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 42
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
