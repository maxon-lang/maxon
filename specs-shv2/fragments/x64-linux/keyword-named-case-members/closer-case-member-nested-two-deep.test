    x64.cmpRegReg rax, rcx
    x64.jcc less, outer
    x64.jmp whileexit
  outer:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_body#19
  __il_body#19:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#20
    x64.jmp matchnext#24
  matcharm#20:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_cont#18
  matchnext#24:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#21
    x64.jmp matchnext#25
  matcharm#21:
    x64.movRegImm32 rcx, 2
    x64.jmp __il_cont#18
  matchnext#25:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#22
    x64.jmp matchdead#23
  matcharm#22:
    x64.movRegImm32 rcx, 3
