// Test: closer-case-member-nested-two-deep
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < tagOf(Kw.end) 'outer'
		if tagOf(Kw.end) == 2 'inner'
			total = total + 21
		end 'inner'
		i = i + 1
	end 'outer'
	return total as ExitCode
end 'main'
---
ExitCode: 42
---
