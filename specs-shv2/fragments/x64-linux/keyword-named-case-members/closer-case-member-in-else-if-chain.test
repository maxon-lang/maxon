    x64.jmp matchdead#12
  matcharm#11:
    x64.movRegImm32 rax, 3
    x64.jmp __il_cont#7
  __il_cont#7:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, first
    x64.jmp ifelse#2
  first:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifelse#2:
    x64.movRegImm32 rax, 1
    x64.jmp __il_body#17
  __il_body#17:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#18
    x64.jmp matchnext#22
  matcharm#18:
    x64.movRegImm32 rax, 1
    x64.jmp __il_cont#16
  matchnext#22:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#19
    x64.jmp matchnext#23
  matcharm#19:
    x64.movRegImm32 rax, 2
    x64.jmp __il_cont#16
  matchnext#23:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#20
    x64.jmp matchdead#21
  matcharm#20:
    x64.movRegImm32 rax, 3
    x64.jmp __il_cont#16
  __il_cont#16:
