// Test: closer-case-member-in-match-arm-body
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function pick(n int) returns int
	match n 'p'
		0 then return tagOf(Kw.end) * 21
		default then return 9
	end 'p'
end 'pick'

function main() returns ExitCode
	return pick(0) as ExitCode
end 'main'
---
ExitCode: 42
---
func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 rcx, 1
    x64.callDirect tagOf
    x64.imulRegRegImm32 r8, r8, 21
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 9
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect pick
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
