// Test: closer-case-member-before-a-ternary-else
enum Kw
	alpha
	end
	omega
end 'Kw'

function main() returns ExitCode
	var acc = 0
	var i = 0
	while i < 2 'spin'
		let x = 1 if i == 0 or Kw.end == Kw.end else 2
		acc = acc + x
		i = i + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rcx, 2
    x64.jcc less, spin
    x64.jmp whileexit
  spin:
    x64.cmpRegImm32 rcx, 0
    x64.movRegImm32 rdx, 1
    x64.jcc equal, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.movRegImm32 rdx, 1
    x64.cmpRegImm32 rdx, 1
    x64.setccReg equal, rdx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rdx, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rdx, 2
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
