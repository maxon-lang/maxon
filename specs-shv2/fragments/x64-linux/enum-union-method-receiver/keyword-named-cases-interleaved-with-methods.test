// Test: keyword-named-cases-interleaved-with-methods
enum Weird
	alpha
	function

	export function mid() returns int
		var total = 0
		while total < 2 'spin'
			total = total + 1
		end 'spin'
		return total
	end 'mid'

	end
	export

	export function two() returns int
		return 20
	end 'two'

	export function three() returns int
		return 30
	end 'three'

	omega

	export function tag() returns int
		return match self 'w'
			alpha gives 1
			function gives 2
			end gives 3
			export gives 4
			omega gives 5
		end 'w'
	end 'tag'
end 'Weird'

function main() returns ExitCode
	let a = Weird.alpha
	let f = Weird.function
	let e = Weird.end
	let x = Weird.export
	let o = Weird.omega
	let acc = a.tag() + f.tag() * 10 + e.tag() * 100 + x.tag() * 1000 + o.tag() * 10000
	if acc != 54321 'bad'
		return 1
	end 'bad'
	if a.mid() != 2 'badMid'
		return 2
	end 'badMid'
	if a.two() + a.three() != 50 'badTwo'
		return 3
	end 'badTwo'
	return 7
end 'main'
---
ExitCode: 7
---
func @Weird.mid {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r8, 2
    x64.jcc less, spin
    x64.jmp whileexit
  spin:
    x64.leaRegRegImm32 r8, r8, 1
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
}

func @Weird.two {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
}

func @Weird.three {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 30
    x64.popReg rbp
    x64.ret
}

func @Weird.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jumpTable rcx, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_0
  matchdead:
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matcharm#4:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matcharm#5:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 2
    x64.movRegImm32 r13, 3
    x64.movRegImm32 r14, 4
    x64.callDirect Weird.tag
    x64.movRegReg r15, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Weird.tag
    x64.imulRegRegImm32 rax, r8, 10
    x64.leaRegRegReg rbx, r15, rax
    x64.movRegReg rcx, r12
    x64.callDirect Weird.tag
    x64.imulRegRegImm32 rax, r8, 100
    x64.leaRegRegReg rbx, rbx, rax
    x64.movRegReg rcx, r13
    x64.callDirect Weird.tag
    x64.imulRegRegImm32 rax, r8, 1000
    x64.leaRegRegReg rbx, rbx, rax
    x64.movRegReg rcx, r14
    x64.callDirect Weird.tag
    x64.imulRegRegImm32 rax, r8, 10000
    x64.leaRegRegReg rax, rbx, rax
    x64.cmpRegImm32 rax, 54321
    x64.jcc notEqual, bad
    x64.jmp ifcont#2
  bad:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rcx, 0
    x64.callDirect Weird.mid
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, badMid
    x64.jmp ifcont#4
  badMid:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rcx, 0
    x64.callDirect Weird.two
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 0
    x64.callDirect Weird.three
    x64.leaRegRegReg rax, rbx, r8
    x64.cmpRegImm32 rax, 50
    x64.jcc notEqual, badTwo
    x64.jmp ifcont#6
  badTwo:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 7
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
