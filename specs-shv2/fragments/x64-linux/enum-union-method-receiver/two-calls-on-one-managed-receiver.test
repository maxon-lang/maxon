// Test: two-calls-on-one-managed-receiver
union Outcome
	pass
	fail(reason String)

	export function isPass() returns bool
		return match self 'p'
			pass gives true
			fail gives false
		end 'p'
	end 'isPass'
end 'Outcome'

function main() returns ExitCode
	let o = Outcome.fail("another long heap allocated failure reason string here")
	let a = o.isPass()
	let b = o.isPass()
	if a or b 'y'
		return 1
	end 'y'
	return 7
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]  ; "another long heap allocated failure reason string here"
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#11
  matcharm#8:
    x64.movRegImm32 rax, 1
    x64.jmp __il_body#13
  matchnext#11:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#10
  matcharm#9:
    x64.movRegImm32 rax, 0
  __il_body#13:
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext#17
  matcharm#14:
    x64.movRegImm32 rcx, 1
    x64.jmp __il_cont
  matchnext#17:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead#16
  matcharm#15:
    x64.movRegImm32 rcx, 0
  __il_cont:
    x64.movRegImm32 rdx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  orrhs:
    x64.movRegReg rdx, rcx
  scmerge:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont
  y:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Outcome
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 7
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Outcome
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#16:
  matchdead#10:
}
