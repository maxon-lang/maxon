// Test: directives.top-level-nested
#if testing(false)
	#if testing(true)
		function pick() returns ExitCode
			return 98
		end 'pick'
	#else
		function pick() returns ExitCode
			return 22
		end 'pick'
	#endif
#else
	function pick() returns ExitCode
		return 97
	end 'pick'
#endif

function main() returns ExitCode
	return pick()
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 r8, 22
  __il_cont:
    x64.popReg rbp
    x64.ret
}
