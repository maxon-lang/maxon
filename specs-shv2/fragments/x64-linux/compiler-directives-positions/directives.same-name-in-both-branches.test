// Test: directives.same-name-in-both-branches
#if testing(false)
	let marker = 31
#else
	let marker = 91
#endif

function main() returns ExitCode
	return marker
end 'main'
---
ExitCode: 31
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 31
    x64.popReg rbp
    x64.ret
}
