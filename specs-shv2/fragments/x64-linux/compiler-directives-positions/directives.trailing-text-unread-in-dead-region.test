// Test: directives.trailing-text-unread-in-dead-region
#if os(Plan9)
	#if os(Windows) this is not a condition
	#endif
#endif

function main() returns ExitCode
	return 21
end 'main'
---
ExitCode: 21
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 21
    x64.popReg rbp
    x64.ret
}
