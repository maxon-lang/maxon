// Test: module-struct-nested-method-call
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

type State
		export var items as ByteArray

		static function create(items ByteArray) returns Self
			return Self{items: items}
		end 'create'
end 'State'

var state = State.create(ByteArray.create())

function main() returns ExitCode
		state.items.push(10)
		state.items.push(20)
		return state.items.count()
end 'main'
---
ExitCode: 2
---
data {
  __data_state@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @State.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_state
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 10
    x64.callDirect __arr_push
    x64.leaRegGlobal rax, __data_state
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 20
    x64.callDirect __arr_push
    x64.leaRegGlobal rax, __data_state
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
