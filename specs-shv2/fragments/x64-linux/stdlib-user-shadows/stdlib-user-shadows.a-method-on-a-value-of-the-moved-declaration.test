// Test: stdlib-user-shadows.a-method-on-a-value-of-the-moved-declaration
type FilePath
	export var tag as Integer

	static function make() returns FilePath
		return FilePath{tag: 4}
	end 'make'
end 'FilePath'

function main() returns ExitCode
	let child = Directory.currentPath().join("alpha.txt")
	return (FilePath.make().tag + child.filename().byteLength()) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 13
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __mrt_errno@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect Directory.currentPath
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __str_rec_17]  ; "alpha.txt"
    x64.movRegReg rcx, rbx
    x64.callDirect __FilePath.join
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct___FilePath
    x64.leaRegSlot rax, slot0
    x64.movRegImm32 rcx, 4
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __FilePath.filename
    x64.movRegReg r13, r8
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok#6
  __il_slow:
    x64.movRegReg rcx, r13
    x64.callDirect String.byteLength
    x64.jmp __il_cont
  __rc_ok#6:
    x64.movRegReg r8, rax
  __il_cont:
    x64.leaRegRegReg rbx, rbx, r8
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_89]  ; "panic at stdlib-user-shadows.a-method-on-a-value-of-the-moved-declaration.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct___FilePath
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
