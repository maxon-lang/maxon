// Test: interface-dispatch-throws-in-match

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	failed
end 'MyError'

interface Backend
	function compute(x Integer) returns Integer
end 'Backend'

enum Kind
	alpha
	beta
end 'Kind'

type AlphaBackend implements Backend
	export let tag as Integer

	function compute(x Integer) returns Integer
		return x + 1
	end 'compute'

	export static function create() returns Self
		return Self{tag: 0}
	end 'create'
end 'AlphaBackend'

type BetaBackend implements Backend
	export let tag as Integer

	function compute(x Integer) returns Integer
		return x + 2
	end 'compute'

	export static function create() returns Self
		return Self{tag: 0}
	end 'create'
end 'BetaBackend'

function helperThatThrows(value Integer, backend Backend) returns Integer throws MyError
	let result = backend.compute(value)
	if result < 0 'bad'
		throw MyError.failed
	end 'bad'
	return result
end 'helperThatThrows'

function dispatchWithReturnTry(kind Kind, value Integer) returns Integer throws MyError
	match kind 'dispatch'
		alpha then return try helperThatThrows(value, backend: AlphaBackend.create())
		beta then return try helperThatThrows(value, backend: BetaBackend.create())
	end 'dispatch'
end 'dispatchWithReturnTry'

function main() returns ExitCode
	let a = try dispatchWithReturnTry(Kind.alpha, value: 40) otherwise 0
	let b = try dispatchWithReturnTry(Kind.beta, value: 40) otherwise 0
	return a + b
end 'main'
---
ExitCode: 83
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @AlphaBackend.compute {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rdx, 1
    x64.popReg rbp
    x64.ret
}

func @AlphaBackend.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @BetaBackend.compute {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rdx, 2
    x64.popReg rbp
    x64.ret
}

func @BetaBackend.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @helperThatThrows {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rsi, rcx
    x64.movRegReg rbx, rax
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rsi
    x64.callMem [rbx + 24]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, bad
    x64.jmp ifcont
  bad:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @dispatchWithReturnTry {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.callDirect AlphaBackend.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __witness_AlphaBackend.Backend]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect helperThatThrows
    x64.movRegReg rbx, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, tryerr#3
    x64.jmp tryok#2
  tryerr#3:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#2:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#4
    x64.jmp matchdead
  matcharm#4:
    x64.callDirect BetaBackend.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __witness_BetaBackend.Backend]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect helperThatThrows
    x64.movRegReg rbx, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 40
    x64.callDirect dispatchWithReturnTry
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 40
    x64.callDirect dispatchWithReturnTry
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
    x64.jmp trycont#6
  trycont#6:
    x64.leaRegRegReg r8, rbx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
