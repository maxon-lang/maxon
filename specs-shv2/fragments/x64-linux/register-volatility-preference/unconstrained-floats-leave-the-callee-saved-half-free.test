// Test: unconstrained-floats-leave-the-callee-saved-half-free
function fsink(x Real) returns Real
	return x + 1.0
end 'fsink'

function main() returns ExitCode
	let n = fsink(3.0)
	let a0 = n + 1.0
	let a1 = n + 2.0
	let a2 = n + 3.0
	let a3 = n + 4.0
	let a4 = n + 5.0
	let a5 = n + 6.0
	let a6 = n + 7.0
	let a7 = n + 8.0
	let a8 = n + 9.0
	let a9 = n + 10.0
	let b0 = a0 * 2.0
	let b1 = a1 * 2.0
	let b2 = a2 * 2.0
	let b3 = a3 * 2.0
	let b4 = a4 * 2.0
	let b5 = a5 * 2.0
	let b6 = a6 * 2.0
	let b7 = a7 * 2.0
	let s = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9
	let c = fsink(s)
	let total = b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + c
	return 0 if total == 232.0 else 99
end 'main'
typealias Real = float(f64.min to f64.max)
