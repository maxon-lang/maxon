// Test: unconstrained-ints-leave-the-callee-saved-half-free
typealias Integer = int(i64.min to i64.max)

function sink(x Integer) returns Integer
	return x + 1
end 'sink'

function main() returns ExitCode
	let n = sink(3)
	let a0 = n + 1
	let a1 = n + 2
	let a2 = n + 3
	let a3 = n + 4
	let a4 = n + 5
	let a5 = n + 6
	let a6 = n + 7
	let a7 = n + 8
	let a8 = n + 9
	let a9 = n + 10
	let a10 = n + 11
	let a11 = n + 12
	let b0 = a0 * 3
	let b1 = a1 * 5
	let b2 = a2 * 7
	let b3 = a3 * 9
	let b4 = a4 * 11
	let b5 = a5 * 13
	let b6 = a6 * 15
	let b7 = a7 * 17
	let b8 = a8 * 19
	let b9 = a9 * 21
	let s = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
	let c = sink(s)
	let total = b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + c
	return 0 if total == 1432 else 99
end 'main'
---
ExitCode: 0
---
func @sink {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.movRegImm32 rcx, 3
    x64.callDirect sink
    x64.leaRegRegImm32 rax, r8, 1
    x64.leaRegRegImm32 rcx, r8, 2
    x64.leaRegRegImm32 rdx, r8, 3
    x64.leaRegRegImm32 rsi, r8, 4
    x64.leaRegRegImm32 rdi, r8, 5
    x64.leaRegRegImm32 r9, r8, 6
    x64.leaRegRegImm32 r10, r8, 7
    x64.leaRegRegImm32 r11, r8, 8
    x64.leaRegRegImm32 rbx, r8, 9
    x64.leaRegRegImm32 r12, r8, 10
    x64.leaRegRegImm32 r13, r8, 11
    x64.leaRegRegImm32 r8, r8, 12
    x64.imulRegRegImm32 r14, rax, 3
    x64.storeSlotReg slot0, r14
    x64.imulRegRegImm32 r14, rcx, 5
    x64.imulRegRegImm32 r15, rdx, 7
    x64.storeSlotReg slot1, r15
    x64.imulRegRegImm32 r15, rsi, 9
    x64.storeSlotReg slot2, r15
    x64.imulRegRegImm32 r15, rdi, 11
    x64.storeSlotReg slot3, r15
    x64.imulRegRegImm32 r15, r9, 13
    x64.storeSlotReg slot4, r15
    x64.imulRegRegImm32 r15, r10, 15
    x64.storeSlotReg slot5, r15
    x64.imulRegRegImm32 r15, r11, 17
    x64.storeSlotReg slot6, r15
    x64.imulRegRegImm32 r15, rbx, 19
    x64.storeSlotReg slot7, r15
    x64.imulRegRegImm32 r15, r12, 21
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg rax, rax, rsi
    x64.leaRegRegReg rax, rax, rdi
    x64.leaRegRegReg rax, rax, r9
    x64.leaRegRegReg rax, rax, r10
    x64.leaRegRegReg rax, rax, r11
    x64.leaRegRegReg rax, rax, rbx
    x64.leaRegRegReg rax, rax, r12
    x64.leaRegRegReg rax, rax, r13
    x64.leaRegRegReg rcx, rax, r8
    x64.callDirect sink
    x64.loadRegSlot rax, slot0
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegSlot rcx, slot1
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot2
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot3
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot4
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot5
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot6
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegSlot rcx, slot7
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg rax, rax, r15
    x64.leaRegRegReg rax, rax, r8
    x64.cmpRegImm32 rax, 1432
    x64.jcc equal, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 99
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
