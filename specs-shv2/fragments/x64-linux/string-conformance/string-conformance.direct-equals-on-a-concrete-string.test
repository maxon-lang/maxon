// Test: string-conformance.direct-equals-on-a-concrete-string
function main() returns ExitCode
	let a = "ab"
	if not a.equals("ab") 'same'
		return 1
	end 'same'
	if a.equals("ac") 'differentByte'
		return 2
	end 'differentByte'
	if a.equals("abc") 'differentLength'
		return 3
	end 'differentLength'
	if not "".equals("") 'bothEmpty'
		return 4
	end 'bothEmpty'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_4]
    x64.leaRegRdata rdx, [rip + __str_rec_4]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, same
    x64.jmp ifcont#2
  same:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, differentByte
    x64.jmp ifcont#4
  differentByte:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.leaRegRdata rdx, [rip + __str_rec_6]
    x64.movRegReg rcx, rbx
    x64.callDirect String.equals
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, differentLength
    x64.jmp ifcont#6
  differentLength:
    x64.movRegImm32 r8, 3
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.leaRegRdata rdx, [rip + __str_rec_7]
    x64.callDirect String.equals
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, bothEmpty
    x64.jmp ifcont#8
  bothEmpty:
    x64.movRegImm32 r8, 4
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.byteAt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r10, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_10]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect String.byteLength
    x64.cmpRegReg r13, r8
    x64.jcc notEqual, lenMismatch
    x64.jmp ifcont
  lenMismatch:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 r9, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r12
    x64.movRegReg rsi, r13
    x64.callDirect bytesEqual
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @bytesEqual {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.storeSlotReg slot2, rax
    x64.movRegReg r13, r9
    x64.movRegReg r14, rsi
    x64.movRegImm32 r15, 0
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot0, r15
    x64.cmpRegReg r15, r14
    x64.jcc less, compare_loop
    x64.jmp forexit
  compare_loop:
    x64.leaRegRegReg rdx, r12, r15
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteAt
    x64.storeSlotReg slot1, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_8]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.leaRegRegReg rdx, r13, r15
    x64.loadRegSlot rcx, slot2
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.leaRegRdata rcx, [rip + __str_blob_9]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.loadRegSlot rax, slot1
    x64.cmpRegReg rax, r8
    x64.jcc notEqual, byte_check
    x64.jmp ifcont
  byte_check:
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r15, rax
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
