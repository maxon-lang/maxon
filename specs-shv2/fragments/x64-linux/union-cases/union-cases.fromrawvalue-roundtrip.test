    x64.prologue 104
    x64.movRegImm32 rcx, 0
    x64.callDirect __enum_from_raw_Shape.unionCases
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
