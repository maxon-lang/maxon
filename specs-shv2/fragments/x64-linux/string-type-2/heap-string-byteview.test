// Test: heap-string-byteview
function main() returns ExitCode
	let s = "ABCDEFGHIJKLMNOPQR"  // 18 bytes, heap allocated
	var count = 0
	for b in s.bytes() 'loop'
		// Use b to avoid unused variable warning
		if b > 0 'use'
			count = count + 1
		end 'use'
	end 'loop'
	print("{count}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __str_to_bytes
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr
  forhdr:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_count
    x64.cmpRegReg rbx, r8
    x64.jcc less, loop
    x64.jmp forexit
  loop:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_get_unchecked
    x64.cmpRegImm32 r8, 0
    x64.jcc greater, use
    x64.jmp critsplit
  use:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, r12
    x64.jmp ifcont
  ifcont:
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.movRegReg r12, rax
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, r12, r14
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r15, r8, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __print_string
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
