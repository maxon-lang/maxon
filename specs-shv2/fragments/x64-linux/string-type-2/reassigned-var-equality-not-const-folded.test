// Test: reassigned-var-equality-not-const-folded
function pick(useUnderscore bool) returns String
	if useUnderscore 'u'
		return "_"
	end 'u'
	return "x"
end 'pick'

function main() returns ExitCode
	var v = ""
	v = pick(true)
	if v == "_" 'match'
		print("1\n")
	end 'match' else 'no'
		print("0\n")
	end 'no'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, u
    x64.jmp ifcont
  u:
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRdata rax, [rip + __str_rec_6]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __str_rec_7]
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.leaRegRdata rdx, [rip + __str_rec_5]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, match
    x64.jmp ifelse
  match:
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.callDirect print
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.callDirect print
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
