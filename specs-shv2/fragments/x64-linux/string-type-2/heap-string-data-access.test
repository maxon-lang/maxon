// Test: heap-string-data-access

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	// Verify heap-allocated string data is accessible via bytes()
	let s = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	// Read first byte ('A' = 65)
	var first_printed = false
	for b in s.bytes() 'read_first'
		if not first_printed 'print_first'
			print("{b}\n")
			first_printed = true
		end 'print_first'
	end 'read_first'
	// Read last byte ('Z' = 90)
	var last_byte = 0 as Byte
	for b in s.bytes() 'read_all'
		last_byte = b
	end 'read_all'
	print("{last_byte}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.storeSlotReg slot0, rbx
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __str_to_bytes
    x64.movRegImm32 rbx, 0
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot1, rbx
    x64.movRegReg rcx, r13
    x64.callDirect __arr_count
    x64.cmpRegReg rbx, r8
    x64.jcc less, read_first
    x64.jmp forexit
  read_first:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect __arr_get_unchecked
    x64.movRegReg rbx, r8
    x64.movRegReg rax, r12
    x64.xorRegImm32 rax, r12, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, print_first
    x64.jmp critsplit
  print_first:
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot2, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot8, rax
    x64.leaRegRegReg rax, rbx, rax
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot6, r8
    x64.leaRegRegImm32 r15, r8, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.loadRegSlot r12, slot8
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r12
    x64.loadRegSlot rbx, slot6
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot3
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot2
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __print_string
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 rax, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, r12
    x64.jmp ifcont
  ifcont:
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rcx, slot1
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __arr_decref
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.loadRegSlot rcx, slot0
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_count
    x64.cmpRegReg r13, r8
    x64.jcc less, read_all
    x64.jmp forexit
  read_all:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __arr_get_unchecked
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rbx, r8
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot4, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, rbx, r14
    x64.storeSlotReg slot5, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot7, r8
    x64.leaRegRegImm32 r15, r8, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rbx, slot7
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot5
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot4
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __print_string
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
