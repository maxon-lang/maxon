// Test: single-field

typealias Integer = int(i64.min to i64.max)

type Wrapper implements Equatable
	export var value as Integer

	function equals(other Wrapper) returns bool
		return value == other.value
	end 'equals'

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Wrapper'

function main() returns ExitCode
	let a = Wrapper.create(42)
	let b = Wrapper.create(42)
	let c = Wrapper.create(99)
	if a.equals(b) 'eq'
		if a.equals(c) 'neq'
			return 1
		end 'neq'
		return 0
	end 'eq'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rdx, slot1
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.movRegImm32 rax, 99
    x64.leaRegSlot rsi, slot2
    x64.storeBaseDispReg.word64 [rsi + 0], rax
    x64.jmp __il_body#6
  __il_body#6:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.cmpRegReg rax, rdx
    x64.setccReg equal, rax
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, eq
    x64.jmp ifcont#4
  eq:
    x64.jmp __il_body#8
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rsi + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rax
    x64.jmp __il_cont#7
  __il_cont#7:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, neq
    x64.jmp ifcont#3
  neq:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#3:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
