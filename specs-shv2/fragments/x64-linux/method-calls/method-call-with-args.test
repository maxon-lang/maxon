// Test: method-call-with-args

typealias Integer = int(i64.min to i64.max)

type Adder
	var total as Integer

	function add(n Integer)
		total = total + n
	end 'add'

	function get() returns Integer
		return total
	end 'get'

	static function create(total Integer) returns Self
		return Self{total: total}
	end 'create'
end 'Adder'

function main() returns ExitCode
	var a = Adder.create(0)
	a.add(10)
	a.add(20)
	a.add(12)
	return a.get()
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 0
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_body#8
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 10
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_cont#7
  __il_cont#7:
    x64.jmp __il_body#9
  __il_body#9:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 20
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_cont#6
  __il_cont#6:
    x64.jmp __il_body#10
  __il_body#10:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 12
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.jmp __il_body#11
  __il_body#11:
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
