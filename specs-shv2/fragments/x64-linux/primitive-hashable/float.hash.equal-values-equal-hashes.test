// Test: float.hash.equal-values-equal-hashes
function main() returns ExitCode
	let a = 1.5
	let b = 3.0 / 2.0
	if a.hash() != b.hash() 'differ'
		return 1
	end 'differ'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.storeSlotReg slot0, xmm6
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm6, [rip + __fconst_2]
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.divsdRegReg xmm6, xmm6, xmm1
    x64.callDirect float.hash
    x64.movRegReg rbx, r8
    x64.movRegReg xmm0, xmm6
    x64.callDirect float.hash
    x64.cmpRegReg rbx, r8
    x64.jcc notEqual, differ
    x64.jmp ifcont
  differ:
    x64.movRegImm32 r8, 1
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @float.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movqGprXmm r8, xmm0
    x64.movRegImm rax, -9223372036854775807
    x64.leaRegRegImm32 rax, rax, -1
    x64.cmpRegReg r8, rax
    x64.jcc equal, negzero
    x64.jmp ifcont
  negzero:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rax, 4294967295
    x64.andRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
