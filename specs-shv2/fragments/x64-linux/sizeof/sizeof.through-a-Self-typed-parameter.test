// Test: sizeof.through-a-Self-typed-parameter
typealias Int = int(i64.min to i64.max)
typealias IntBag = Bag with Int

type Bag uses Element
	typealias Items = Array with Element

	var items as Items

	export static function create() returns Self
		return Self{items: Items.create()}
	end 'create'

	export function slotSize() returns Int
		return sizeof(Element)
	end 'slotSize'

	export function pairWith(other Self) returns Int
		return other.slotSize()
	end 'pairWith'
end 'Bag'

function main() returns ExitCode
	var a = IntBag.create()
	var b = IntBag.create()
	return a.pairWith(b)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.pairWith {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.loadRegBaseDisp.word64 r8, [rax + 56]
  __il_cont:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __layout_Bag_Int]
    x64.callDirect Bag.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __layout_Bag_Int]
    x64.callDirect Bag.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_Bag_Int]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Bag.pairWith
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Bag_Int
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Bag_Int
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at sizeof.through-a-Self-typed-parameter.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
