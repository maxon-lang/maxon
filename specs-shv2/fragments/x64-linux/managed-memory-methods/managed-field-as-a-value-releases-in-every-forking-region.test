// Test: managed-field-as-a-value-releases-in-every-forking-region
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function bufLength(m __ManagedMemory) returns int
	return m.length()
end 'bufLength'

function main() returns ExitCode
	var a = ByteArray.create()
	a.push(1 as Byte)
	a.push(2 as Byte)
	var total = 0

	if bufLength(a.managed) > 1 'big'
		total = total + 1
	end 'big'

	while bufLength(a.managed) > total 'spin'
		total = total + 1
	end 'spin'

	for b in a.managed 'each'
		total = total + b
	end 'each'

	a = "xyz".toByteArray()
	total = total + bufLength(a.managed) + a.count()

	print("{total}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @bufLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect bufLength
    x64.cmpRegImm32 r8, 1
    x64.setccReg greater, r14
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, big
    x64.jmp critsplit#12
  big:
    x64.leaRegRegImm32 rax, r12, 1
    x64.jmp ifcont
  critsplit#12:
    x64.movRegReg rax, r12
    x64.jmp ifcont
  ifcont:
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whilehdr:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect bufLength
    x64.cmpRegReg r8, r12
    x64.setccReg greater, r14
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, spin
    x64.jmp whileexit
  spin:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.callDirect Array.createIterator
    x64.movRegReg r14, r8
    x64.movRegReg r15, r10
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r15, 0
    x64.jcc equal, critsplit#13
    x64.jmp forempty
  critsplit#13:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, each
    x64.jmp forexit
  each:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Byte]
    x64.movRegReg rcx, r14
    x64.callDirect ArrayIterator.current
    x64.leaRegRegReg r12, r12, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r14
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_ArrayIterator_Byte
    x64.jmp forjoin
  forempty:
    x64.jmp forjoin
  forjoin:
    x64.leaRegRdata rcx, [rip + __str_rec_1]
    x64.callDirect String.toByteArray
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect bufLength
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, r13
    x64.callDirect __managed_count
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r12
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r14
    x64.callDirect print
    x64.movRegReg rcx, r14
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect ArrayIterator.create
    x64.movRegReg r12, r8
    x64.movRegReg r13, r10
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __managed_cursor_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_cursor_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_cursor_current
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __retain_type_param
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @ArrayIterator.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_cursor_advance
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.toByteArray {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __str_bytes_view
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r8
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
