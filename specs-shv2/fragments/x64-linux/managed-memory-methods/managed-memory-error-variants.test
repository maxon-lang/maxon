    x64.callDirect __arr_mem_create
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 7
    x64.jcc equal, matcharm
