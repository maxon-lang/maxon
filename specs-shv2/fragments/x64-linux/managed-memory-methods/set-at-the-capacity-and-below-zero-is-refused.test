// Test: set-at-the-capacity-and-below-zero-is-refused
function main() returns ExitCode
	var seen = 0
	let mm = try __ManagedMemory.create(4, elementSize: 8) otherwise return 1
	let cap = mm.capacity()
	try mm.set(cap - 1, value: 7) otherwise return 2
	try mm.set(cap, value: 7) otherwise (e) 'atCapacity'
		match e 'k'
			indexOutOfBounds then seen = seen + 1
			default panic("set at the capacity must report indexOutOfBounds")
		end 'k'
	end 'atCapacity'
	try mm.set(cap + 1, value: 7) otherwise (e) 'pastCapacity'
		match e 'k'
			indexOutOfBounds then seen = seen + 1
			default panic("set past the capacity must report indexOutOfBounds")
		end 'k'
	end 'pastCapacity'
	try mm.set(-1, value: 7) otherwise (e) 'negativeIndex'
		match e 'k'
			indexOutOfBounds then seen = seen + 1
			default panic("set at a negative index must report indexOutOfBounds")
		end 'k'
	end 'negativeIndex'
	if seen == 3 'allThree'
		return 42
	end 'allThree'
	return 5
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 8
    x64.callDirect __managed_mem_create
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_capacity
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 rdx, r13, -1
    x64.movRegImm32 rax, 7
    x64.movRegReg rcx, r12
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  tryerr#4:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rax, 7
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#7
    x64.jmp matchdefault#8
  matcharm#7:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp matchcont#9
  matchcont#9:
    x64.jmp trycont#10
  matchdefault#8:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.jmp trycont#10
  trycont#10:
    x64.leaRegRegImm32 rdx, r13, 1
    x64.movRegImm32 rax, 7
    x64.movRegReg rcx, r12
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#12
    x64.jmp tryok#11
  tryerr#12:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#13
    x64.jmp matchdefault#14
  matcharm#13:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp matchcont#15
  matchcont#15:
    x64.jmp trycont#16
  matchdefault#14:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#11:
    x64.jmp trycont#16
  trycont#16:
    x64.movRegImm rdx, 18446744073709551615
    x64.movRegImm32 rax, 7
    x64.movRegReg rcx, r12
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#18
    x64.jmp tryok#17
  tryerr#18:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#19
    x64.jmp matchdefault#20
  matcharm#19:
    x64.leaRegRegImm32 rax, rbx, 1
    x64.jmp matchcont#21
  matchcont#21:
    x64.jmp trycont#22
  matchdefault#20:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#17:
    x64.movRegReg rax, rbx
    x64.jmp trycont#22
  trycont#22:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, allThree
    x64.jmp ifcont
  allThree:
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 5
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
