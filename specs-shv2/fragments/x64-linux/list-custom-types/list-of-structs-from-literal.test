// Test: list-of-structs-from-literal
typealias Integer = int(i64.min to i64.max)

type Vec2
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Vec2'

function main() returns ExitCode
	let list = List from [Vec2.create(1, y: 2), Vec2.create(3, y: 4), Vec2.create(5, y: 6)]
	for item in list 'loop'
		print("{item.x},{item.y}\n")
	end 'loop'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Vec2.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 152
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 2
    x64.callDirect Vec2.create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.leaRegRdata rcx, [rip + __layout_List_Vec2]
    x64.callDirect List.create
    x64.movRegReg r12, r8
    x64.storeSlotReg slot3, r12
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rax, [rip + __layout_List_Vec2]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect List.append
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 4
    x64.callDirect Vec2.create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot1, rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rax, [rip + __layout_List_Vec2]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect List.append
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 6
    x64.callDirect Vec2.create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot2, rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rax, [rip + __layout_List_Vec2]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect List.append
    x64.movRegReg rcx, r12
    x64.callDirect List.createIterator
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, loop
    x64.jmp forexit
  loop:
    x64.leaRegRdata rdx, [rip + __layout_ListIterator_Vec2]
    x64.movRegReg rcx, rbx
    x64.callDirect ListIterator.current
    x64.movRegReg r12, r8
    x64.storeSlotReg slot4, r12
    x64.loadRegBaseDisp.word64 r13, [r12 + 0]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.storeSlotReg slot5, r14
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __int_to_string
    x64.storeSlotReg slot12, r8
    x64.leaRegRdata rax, [rip + __str_rec_2]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot11, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.loadRegBaseDisp.word64 r12, [r12 + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.storeSlotReg slot10, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot9, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot8, rax
    x64.loadRegSlot r12, slot12
    x64.leaRegRegReg rcx, r12, r13
    x64.leaRegRegReg rcx, rcx, r8
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot6, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot7, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r12
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot11
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r13
    x64.movRegReg rcx, r12
    x64.loadRegSlot r13, slot13
    x64.movRegReg rdx, r13
    x64.loadRegSlot r14, slot10
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r14
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot9
    x64.loadRegSlot r14, slot8
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r14
    x64.loadRegSlot r12, slot7
    x64.storeBaseDispReg.word64 [r12 + 0], r15
    x64.loadRegSlot rax, slot6
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.loadRegSlot rcx, slot5
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot4
    x64.callDirect __mm_decref
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, rbx
    x64.callDirect ListIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_ListIterator_Vec2
    x64.jmp forjoin
  forempty:
    x64.jmp forjoin
  forjoin:
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot3
    x64.callDirect __destruct_List_Vec2
    x64.loadRegSlot rcx, slot2
    x64.callDirect __mm_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 152
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @List.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rcx, [rcx + 40]
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @List.append {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
