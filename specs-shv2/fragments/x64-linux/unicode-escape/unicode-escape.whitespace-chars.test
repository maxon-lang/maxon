// Test: unicode-escape.whitespace-chars
function main() returns ExitCode
	let ws = CharacterSet.whitespacesAndNewlines()
	let nbsp = '\u00A0'
	let enSpace = '\u2002'
	let ideoSpace = '\u3000'
	if ws.contains(nbsp) 'c1'
		print("nbsp ")
	end 'c1'
	if ws.contains(enSpace) 'c2'
		print("enSpace ")
	end 'c2'
	if ws.contains(ideoSpace) 'c3'
		print("ideoSpace")
	end 'c3'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect CharacterSet.whitespacesAndNewlines
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __str_rec_13]
    x64.leaRegRdata r12, [rip + __str_rec_14]
    x64.leaRegRdata r13, [rip + __str_rec_15]
    x64.movRegReg rcx, rbx
    x64.callDirect CharacterSet.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  c1:
    x64.leaRegRdata rcx, [rip + __str_rec_16]
    x64.callDirect print
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect CharacterSet.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  c2:
    x64.leaRegRdata rcx, [rip + __str_rec_17]
    x64.callDirect print
  ifcont#4:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect CharacterSet.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#6
  c3:
    x64.leaRegRdata rcx, [rip + __str_rec_18]
    x64.callDirect print
  ifcont#6:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_CharacterSet
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
