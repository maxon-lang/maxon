// Test: if-try-nested

enum MyError implements Error
	failed
end 'MyError'

function runStep(succeed bool) throws MyError
	if not succeed 'check'
		throw MyError.failed
	end 'check'
end 'runStep'

function main() returns ExitCode
	var result = 0
	if try runStep(true) 'outer'
		if try runStep(true) 'inner'
			result = 3
		end 'inner'
	end 'outer'
	return result
end 'main'
---
ExitCode: 3
---
func @runStep {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.xorRegImm32 rcx, rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 1
    x64.callDirect runStep
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, outer
    x64.jmp ifelse#5
  outer:
    x64.movRegImm32 rcx, 1
    x64.callDirect runStep
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, inner
    x64.jmp ifelse#3
  inner:
    x64.movRegImm32 rax, 3
    x64.jmp ifcont#4
  ifelse#3:
    x64.movRegReg rax, rbx
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegReg r8, rax
    x64.jmp ifcont#6
  ifelse#5:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#6
  ifcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
