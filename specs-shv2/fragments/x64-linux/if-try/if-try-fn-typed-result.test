// Test: if-try-fn-typed-result
typealias Score = int(i64.min to i64.max)
typealias Transform = function(Score) returns Score

enum PickError implements Error
	nope
end 'PickError'

function double(x Score) returns Score
	return x * 2
end 'double'

function pick(ok bool) returns Transform throws PickError
	if ok 'y'
		return double
	end 'y'
	throw PickError.nope
end 'pick'

function main() returns ExitCode
	let f = try pick(true) otherwise panic("pick(true) cannot fail")
	let a = f(3)

	if let g = try pick(true) 'ok'
		let b = g(4)
		return a + b
	end 'ok' else 'bad'
		return 1
	end 'bad'
end 'main'
---
ExitCode: 14
---
func @double {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, y
    x64.jmp ifcont
  y:
    x64.leaRegFunc r8, [rip + __fnref_double]
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, ok
    x64.jmp ifelse
  ok:
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 0
    x64.callReg r12
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
}
