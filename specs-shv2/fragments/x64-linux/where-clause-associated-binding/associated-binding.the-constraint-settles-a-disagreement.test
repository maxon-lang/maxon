// Test: associated-binding.the-constraint-settles-a-disagreement
typealias Integer = int(i64.min to i64.max)

interface Cursor uses Element
	function current() returns Element
end 'Cursor'

type IntCur implements Cursor with Integer
	var v as Integer

	export static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'

	export function current() returns Integer
		return self.v
	end 'current'
end 'IntCur'

type TextCur implements Cursor with String
	var v as String

	export static function create(v String) returns Self
		return Self{v: v}
	end 'create'

	export function current() returns String
		return self.v
	end 'current'
end 'TextCur'

type Wrap uses S, E where S is Cursor with E
	var s as S

	export static function create(s S) returns Self
		return Self{s: s}
	end 'create'

	export function only() returns E
		return self.s.current()
	end 'only'
end 'Wrap'

typealias IntWrap = Wrap with (IntCur, Integer)
typealias TextWrap = Wrap with (TextCur, String)

function main() returns ExitCode
	let a = IntWrap.create(IntCur.create(41))
	let b = TextWrap.create(TextCur.create("ok"))
	print("{a.only()}:{b.only()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @IntCur.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @IntCur.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @TextCur.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

