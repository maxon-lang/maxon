// Test: doc-comments.layout-not-a-statement
function main() returns ExitCode
	let a = 3
	/// a doc comment as the body's last line
	return a
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}
