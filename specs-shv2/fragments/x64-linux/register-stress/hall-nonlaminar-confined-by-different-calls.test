    x64.jmp __il_body#23
  __il_body#23:
    x64.jmp __il_cont#22
  __il_cont#22:
    x64.leaRegRegImm32 rax, rdi, 4
    x64.jmp ifcont#12
  ifelse#8:
    x64.cmpRegImm32 rcx, 5
    x64.jcc equal, b5
    x64.jmp ifelse#10
  b5:
    x64.jmp __il_body#25
  __il_body#25:
    x64.jmp __il_cont#24
  __il_cont#24:
    x64.leaRegRegImm32 rax, r8, 5
