// Test: hall-nonlaminar-confined-by-different-calls
function sink(x int) returns int
	return x
end 'sink'

function pick(k int) returns int
	let v1 = k + 11
	let v2 = k + 22
	let v3 = k + 33
	let v4 = k + 44
	let v5 = k + 55
	let v6 = k + 66
	var out = 0
	if k == 1 'b1'
		let t = sink(1)
		out = v1 + t
	end 'b1' else if k == 2 'b2'
		let t2 = sink(2)
		out = v2 + t2
	end 'b2' else if k == 3 'b3'
		let t3 = sink(3)
		out = v3 + t3
	end 'b3' else if k == 4 'b4'
		let t4 = sink(4)
		out = v4 + t4
	end 'b4' else if k == 5 'b5'
		let t5 = sink(5)
		out = v5 + t5
	end 'b5' else 'b6'
		let t6 = sink(6)
		out = v6 + t6
	end 'b6'
	return out
end 'pick'

function main() returns ExitCode
	let total = pick(1) + pick(2) + pick(3) + pick(4) + pick(5) + pick(6)
	if total == 273 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @sink {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.leaRegRegImm32 rbx, rcx, 11
    x64.leaRegRegImm32 r12, rcx, 22
    x64.leaRegRegImm32 r13, rcx, 33
    x64.leaRegRegImm32 r14, rcx, 44
    x64.leaRegRegImm32 r15, rcx, 55
    x64.leaRegRegImm32 rax, rcx, 66
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, b1
    x64.jmp ifelse#2
  b1:
    x64.movRegImm32 rcx, 1
    x64.callDirect sink
    x64.leaRegRegReg r8, rbx, r8
    x64.jmp ifcont#15
  ifelse#2:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, b2
    x64.jmp ifelse#4
  b2:
    x64.movRegImm32 rcx, 2
    x64.callDirect sink
    x64.leaRegRegReg rax, r12, r8
    x64.jmp ifcont#14
  ifelse#4:
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, b3
    x64.jmp ifelse#6
  b3:
    x64.movRegImm32 rcx, 3
    x64.callDirect sink
    x64.leaRegRegReg rax, r13, r8
    x64.jmp ifcont#13
  ifelse#6:
    x64.cmpRegImm32 rcx, 4
    x64.jcc equal, b4
    x64.jmp ifelse#8
  b4:
    x64.movRegImm32 rcx, 4
    x64.callDirect sink
    x64.leaRegRegReg rax, r14, r8
    x64.jmp ifcont#12
  ifelse#8:
    x64.cmpRegImm32 rcx, 5
    x64.jcc equal, b5
    x64.jmp ifelse#10
  b5:
    x64.movRegImm32 rcx, 5
    x64.callDirect sink
    x64.leaRegRegReg rax, r15, r8
    x64.jmp ifcont#11
  ifelse#10:
    x64.movRegImm32 rcx, 6
    x64.callDirect sink
    x64.loadRegSlot rax, slot0
    x64.leaRegRegReg rax, rax, r8
    x64.jmp ifcont#11
  ifcont#11:
    x64.jmp ifcont#12
  ifcont#12:
    x64.jmp ifcont#13
  ifcont#13:
    x64.jmp ifcont#14
  ifcont#14:
    x64.movRegReg r8, rax
    x64.jmp ifcont#15
  ifcont#15:
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 3
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 4
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 5
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 6
    x64.callDirect pick
    x64.leaRegRegReg rax, rbx, r8
    x64.cmpRegImm32 rax, 273
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
