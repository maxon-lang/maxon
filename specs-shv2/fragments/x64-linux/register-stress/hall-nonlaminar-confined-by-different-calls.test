  __il_body#19:
    x64.jmp __il_cont#18
  __il_cont#18:
    x64.leaRegRegImm32 rax, rdx, 2
    x64.jmp ifcont#14
  ifelse#4:
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, b3
    x64.jmp ifelse#6
  b3:
    x64.jmp __il_body#21
  __il_body#21:
    x64.jmp __il_cont#20
