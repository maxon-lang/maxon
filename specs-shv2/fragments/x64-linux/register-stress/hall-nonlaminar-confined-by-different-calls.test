func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 3
    x64.callDirect pick
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegImm32 rcx, 4
