    x64.leaRegRegImm32 r9, rcx, 66
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, b1
    x64.jmp ifelse#2
  b1:
    x64.jmp __il_body#17
  __il_body#17:
    x64.jmp __il_cont#16
  __il_cont#16:
    x64.leaRegRegImm32 r8, rax, 1
