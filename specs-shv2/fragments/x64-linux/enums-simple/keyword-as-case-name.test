// Test: keyword-as-case-name
enum TokenType
	function
	return
	end
	if
	else
	let
	var
	identifier
end 'TokenType'

function main() returns ExitCode
	let t = TokenType.function
	let result = match t 'check'
		function gives 1
		return gives 0
		end gives 0
		if gives 0
		else gives 0
		let gives 0
		var gives 0
		identifier gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.jumpTable rax, default=matchdead [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm, [5]=matcharm, [6]=matcharm, [7]=matcharm] @__jumptable_0
  matchdead:
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}
