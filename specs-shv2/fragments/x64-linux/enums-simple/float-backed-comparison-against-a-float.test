// Test: float-backed-comparison-against-a-float
enum Threshold
	low = 0.1
	high = 0.9
end 'Threshold'

function main() returns ExitCode
	let val = 0.5
	if val > Threshold.low and val < Threshold.high 'inRange'
		if Threshold.high == 0.9 'exact'
			return 1
		end 'exact'
	end 'inRange'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0.5]
    x64.movRegImm rax, 4591870180066957722
    x64.movqXmmGpr xmm1, rax
    x64.ucomisdRegReg xmm0, xmm1
    x64.movRegImm32 rax, 0
    x64.jcc belowEqual, scmerge
  andrhs:
    x64.movRegImm rax, 4606281698874543309
    x64.movqXmmGpr xmm1, rax
    x64.ucomisdRegReg xmm1, xmm0
    x64.setccReg above, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  inRange:
    x64.movRegImm rax, 4606281698874543309
    x64.movsdRegRip xmm0, [rip + __fconst_0.9]
    x64.movqXmmGpr xmm1, rax
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  exact:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
