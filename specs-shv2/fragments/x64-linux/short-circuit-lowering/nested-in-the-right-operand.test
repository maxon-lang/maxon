// Test: nested-in-the-right-operand
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if f() or (t() and t()) 'a'
		code = code + 1
	end 'a'
	if t() and (f() or t()) 'b'
		code = code + 2
	end 'b'
	if f() or (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 3
---
func @t {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @f {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#22
    x64.jmp orrhs#1
  critsplit#22:
    x64.jmp scmerge#4
  orrhs#1:
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#2
    x64.jmp critsplit#23
  andrhs#2:
    x64.callDirect t
    x64.jmp scmerge#3
  critsplit#23:
    x64.movRegReg r8, rax
    x64.jmp scmerge#3
  scmerge#3:
    x64.movRegReg rax, r8
    x64.jmp scmerge#4
  scmerge#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, a
    x64.jmp critsplit#24
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#6
  critsplit#24:
    x64.jmp ifcont#6
  ifcont#6:
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#7
    x64.jmp critsplit#25
  andrhs#7:
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#26
    x64.jmp orrhs#8
  critsplit#26:
    x64.jmp scmerge#9
  orrhs#8:
    x64.callDirect t
    x64.movRegReg rax, r8
    x64.jmp scmerge#9
  scmerge#9:
    x64.jmp scmerge#10
  critsplit#25:
    x64.jmp scmerge#10
  scmerge#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, b
    x64.jmp critsplit#27
  b:
    x64.leaRegRegImm32 rbx, rbx, 2
    x64.jmp ifcont#12
  critsplit#27:
    x64.jmp ifcont#12
  ifcont#12:
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#28
    x64.jmp orrhs#13
  critsplit#28:
    x64.jmp scmerge#16
  orrhs#13:
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#14
    x64.jmp critsplit#29
  andrhs#14:
    x64.callDirect f
    x64.jmp scmerge#15
  critsplit#29:
    x64.movRegReg r8, rax
    x64.jmp scmerge#15
  scmerge#15:
    x64.movRegReg rax, r8
    x64.jmp scmerge#16
  scmerge#16:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, c
    x64.jmp critsplit#30
  c:
    x64.leaRegRegImm32 r8, rbx, 4
    x64.jmp ifcont#18
  critsplit#30:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#18
  ifcont#18:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
