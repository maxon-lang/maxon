// Test: comparison-operands
function main() returns ExitCode
	let x = 4
	let y = 0
	var code = 0
	if x > 0 and y > 0 'both'
		code = code + 1
	end 'both'
	if x > 0 or y > 0 'either'
		code = code + 2
	end 'either'
	if x > 0 and y == 0 'mixed'
		code = code + 4
	end 'mixed'
	return code
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 4
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rsi, 0
    x64.jcc greater, andrhs#1
    x64.jmp critsplit#16
  andrhs#1:
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greater, rsi
    x64.jmp scmerge#2
  critsplit#16:
    x64.jmp scmerge#2
  scmerge#2:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, both
    x64.jmp critsplit#17
  both:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp ifcont#4
  critsplit#17:
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rsi, 1
    x64.jcc greater, critsplit#18
    x64.jmp orrhs
  critsplit#18:
    x64.jmp scmerge#6
  orrhs:
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greater, rsi
    x64.jmp scmerge#6
  scmerge#6:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, either
    x64.jmp critsplit#19
  either:
    x64.leaRegRegImm32 rdx, rdx, 2
    x64.jmp ifcont#8
  critsplit#19:
    x64.jmp ifcont#8
  ifcont#8:
    x64.cmpRegImm32 rax, 0
    x64.movRegImm32 rax, 0
    x64.jcc greater, andrhs#9
    x64.jmp critsplit#20
  andrhs#9:
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rax
    x64.jmp scmerge#10
  critsplit#20:
    x64.jmp scmerge#10
  scmerge#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, mixed
    x64.jmp critsplit#21
  mixed:
    x64.leaRegRegImm32 r8, rdx, 4
    x64.jmp ifcont#12
  critsplit#21:
    x64.movRegReg r8, rdx
    x64.jmp ifcont#12
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
