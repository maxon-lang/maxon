// Test: rhs-is-evaluated-when-lhs-does-not-decide
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if t() and f() 'a'
		code = code + 1
	end 'a'
	if t() and t() 'b'
		code = code + 2
	end 'b'
	if f() and t() 'c'
		code = code + 4
	end 'c'
	if f() or f() 'd'
		code = code + 8
	end 'd'
	if f() or t() 'e'
		code = code + 16
	end 'e'
	if t() or f() 'g'
		code = code + 32
	end 'g'
	return code
end 'main'
---
ExitCode: 50
---
func @t {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @f {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#1
    x64.jmp critsplit#28
  andrhs#1:
    x64.callDirect f
    x64.jmp scmerge#2
  critsplit#28:
    x64.movRegReg r8, rax
    x64.jmp scmerge#2
  scmerge#2:
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, a
    x64.jmp critsplit#29
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#29:
    x64.jmp ifcont#4
  ifcont#4:
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#5
    x64.jmp critsplit#30
  andrhs#5:
    x64.callDirect t
    x64.jmp scmerge#6
  critsplit#30:
    x64.movRegReg r8, rax
    x64.jmp scmerge#6
  scmerge#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, b
    x64.jmp critsplit#31
  b:
    x64.leaRegRegImm32 rbx, rbx, 2
    x64.jmp ifcont#8
  critsplit#31:
    x64.jmp ifcont#8
  ifcont#8:
    x64.callDirect f
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#9
    x64.jmp critsplit#32
  andrhs#9:
    x64.callDirect t
    x64.jmp scmerge#10
  critsplit#32:
    x64.movRegReg r8, rax
    x64.jmp scmerge#10
  scmerge#10:
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c
    x64.jmp critsplit#33
  c:
    x64.leaRegRegImm32 rbx, rbx, 4
    x64.jmp ifcont#12
  critsplit#33:
    x64.jmp ifcont#12
  ifcont#12:
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#34
    x64.jmp orrhs#13
  critsplit#34:
    x64.jmp scmerge#14
  orrhs#13:
    x64.callDirect f
    x64.movRegReg rax, r8
    x64.jmp scmerge#14
  scmerge#14:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, d
    x64.jmp critsplit#35
  d:
    x64.leaRegRegImm32 rbx, rbx, 8
    x64.jmp ifcont#16
  critsplit#35:
    x64.jmp ifcont#16
  ifcont#16:
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#36
    x64.jmp orrhs#17
  critsplit#36:
    x64.jmp scmerge#18
  orrhs#17:
    x64.callDirect t
    x64.movRegReg rax, r8
    x64.jmp scmerge#18
  scmerge#18:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, e
    x64.jmp critsplit#37
  e:
    x64.leaRegRegImm32 rbx, rbx, 16
    x64.jmp ifcont#20
  critsplit#37:
    x64.jmp ifcont#20
  ifcont#20:
    x64.callDirect t
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#38
    x64.jmp orrhs#21
  critsplit#38:
    x64.jmp scmerge#22
  orrhs#21:
    x64.callDirect f
    x64.movRegReg rax, r8
    x64.jmp scmerge#22
  scmerge#22:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, g
    x64.jmp critsplit#39
  g:
    x64.leaRegRegImm32 r8, rbx, 32
    x64.jmp ifcont#24
  critsplit#39:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#24
  ifcont#24:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
