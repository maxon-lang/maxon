// Test: in-a-call-argument
typealias Tag = int(0 to 100)

function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function consume(flag bool) returns Tag
	if flag 'isTrue'
		return 1
	end 'isTrue'
	return 0
end 'consume'

function main() returns ExitCode
	let a = consume(t() or f())
	let b = consume(t() and f())
	let c = consume(f() or t())
	return a * 4 + b * 2 + c
end 'main'
---
ExitCode: 5
---
func @t {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @f {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @consume {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, isTrue
    x64.jmp ifcont
  isTrue:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect t
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#10
    x64.jmp orrhs#1
  critsplit#10:
    x64.jmp scmerge#2
  orrhs#1:
    x64.callDirect f
    x64.movRegReg rcx, r8
    x64.jmp scmerge#2
  scmerge#2:
    x64.callDirect consume
    x64.movRegReg rbx, r8
    x64.callDirect t
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit#11
  andrhs:
    x64.callDirect f
    x64.movRegReg rcx, r8
    x64.jmp scmerge#4
  critsplit#11:
    x64.jmp scmerge#4
  scmerge#4:
    x64.callDirect consume
    x64.movRegReg r12, r8
    x64.callDirect f
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#12
    x64.jmp orrhs#5
  critsplit#12:
    x64.jmp scmerge#6
  orrhs#5:
    x64.callDirect t
    x64.movRegReg rcx, r8
    x64.jmp scmerge#6
  scmerge#6:
    x64.callDirect consume
    x64.imulRegRegImm32 rax, rbx, 4
    x64.imulRegRegImm32 rcx, r12, 2
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegReg r8, rax, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
