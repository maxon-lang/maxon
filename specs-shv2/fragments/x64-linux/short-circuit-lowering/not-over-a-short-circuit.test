// Test: not-over-a-short-circuit
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if not (f() or f()) 'a'
		code = code + 1
	end 'a'
	if not (t() and t()) 'b'
		code = code + 2
	end 'b'
	if not (t() and f()) 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 5
---
func @t {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @f {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#16
    x64.jmp orrhs
  critsplit#16:
    x64.jmp scmerge#2
  orrhs:
    x64.callDirect f
    x64.movRegReg rax, r8
    x64.jmp scmerge#2
  scmerge#2:
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, a
    x64.jmp critsplit#17
  a:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp ifcont#4
  critsplit#17:
    x64.jmp ifcont#4
  ifcont#4:
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#5
    x64.jmp critsplit#18
  andrhs#5:
    x64.callDirect t
    x64.jmp scmerge#6
  critsplit#18:
    x64.movRegReg r8, rax
    x64.jmp scmerge#6
  scmerge#6:
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, b
    x64.jmp critsplit#19
  b:
    x64.leaRegRegImm32 rbx, rbx, 2
    x64.jmp ifcont#8
  critsplit#19:
    x64.jmp ifcont#8
  ifcont#8:
    x64.callDirect t
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#9
    x64.jmp critsplit#20
  andrhs#9:
    x64.callDirect f
    x64.jmp scmerge#10
  critsplit#20:
    x64.movRegReg r8, rax
    x64.jmp scmerge#10
  scmerge#10:
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c
    x64.jmp critsplit#21
  c:
    x64.leaRegRegImm32 r8, rbx, 4
    x64.jmp ifcont#12
  critsplit#21:
    x64.movRegReg r8, rbx
    x64.jmp ifcont#12
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
