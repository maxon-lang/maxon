// Test: result-bound-to-a-let
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	let a = t() and t()
	let b = t() and f()
	let c = f() or t()
	var code = 0
	if a 'a'
		code = code + 1
	end 'a'
	if b 'b'
		code = code + 2
	end 'b'
	if c 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 5
---
func @t {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @f {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect t
    x64.movRegImm32 rbx, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#1
    x64.jmp critsplit#16
  andrhs#1:
    x64.callDirect t
    x64.movRegReg rbx, r8
    x64.jmp scmerge#2
  critsplit#16:
    x64.jmp scmerge#2
  scmerge#2:
    x64.callDirect t
    x64.movRegImm32 r12, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs#3
    x64.jmp critsplit#17
  andrhs#3:
    x64.callDirect f
    x64.movRegReg r12, r8
    x64.jmp scmerge#4
  critsplit#17:
    x64.jmp scmerge#4
  scmerge#4:
    x64.callDirect f
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#18
    x64.jmp orrhs
  critsplit#18:
    x64.jmp scmerge#6
  orrhs:
    x64.callDirect t
    x64.movRegReg rax, r8
    x64.jmp scmerge#6
  scmerge#6:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, a
    x64.jmp critsplit#19
  a:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp ifcont#8
  critsplit#19:
    x64.jmp ifcont#8
  ifcont#8:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, b
    x64.jmp critsplit#20
  b:
    x64.leaRegRegImm32 rcx, rcx, 2
    x64.jmp ifcont#10
  critsplit#20:
    x64.jmp ifcont#10
  ifcont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, c
    x64.jmp critsplit#21
  c:
    x64.leaRegRegImm32 r8, rcx, 4
    x64.jmp ifcont#12
  critsplit#21:
    x64.movRegReg r8, rcx
    x64.jmp ifcont#12
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
