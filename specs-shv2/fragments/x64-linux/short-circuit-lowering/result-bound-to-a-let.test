// Test: result-bound-to-a-let
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	let a = t() and t()
	let b = t() and f()
	let c = f() or t()
	var code = 0
	if a 'a'
		code = code + 1
	end 'a'
	if b 'b'
		code = code + 2
	end 'b'
	if c 'c'
		code = code + 4
	end 'c'
	return code
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body#19:
    x64.movRegImm32 rax, 1
  __il_body#23:
    x64.movRegImm32 rcx, 0
  __il_body#27:
    x64.movRegImm32 rdx, 1
  scmerge:
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit#28
  a:
    x64.movRegImm32 rax, 1
    x64.jmp ifcont#8
  critsplit#28:
    x64.movRegReg rax, rsi
  ifcont#8:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont#10
  b:
    x64.leaRegRegImm32 rax, rax, 2
  ifcont#10:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, critsplit#30
  c:
    x64.leaRegRegImm32 r8, rax, 4
    x64.jmp ifcont#12
  critsplit#30:
    x64.movRegReg r8, rax
  ifcont#12:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at result-bound-to-a-let.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
