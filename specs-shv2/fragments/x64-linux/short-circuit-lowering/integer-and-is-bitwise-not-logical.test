// Test: integer-and-is-bitwise-not-logical
function main() returns ExitCode
	let r = 12 and 3
	if r == 0 'bitwise'
		return 0
	end 'bitwise'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  bitwise:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
