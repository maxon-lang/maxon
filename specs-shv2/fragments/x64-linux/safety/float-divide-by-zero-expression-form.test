// Test: float-divide-by-zero-expression-form
typealias Float = float(f64.min to f64.max)

function opaque(x Float) returns Float
	return x
end 'opaque'

function main() returns ExitCode
	let zero = opaque(0.0)
	var result = 0
	try (100.0 / zero) otherwise (e) 'handle'
		match e 'kind'
			divisionByZero then result = 42
		end 'kind'
	end 'handle'
	return result as ExitCode
end 'main'
---
ExitCode: 42
---
func @opaque {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.callDirect opaque
    x64.movRegImm32 rax, 0
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.movsdRegRip xmm2, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm2
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rsi
    x64.divsdRegReg xmm1, xmm1, xmm0
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRegImm32 rax, rsi, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 rax, 42
    x64.jmp matchcont
  matchcont:
    x64.jmp trycont
  matchdead:
  tryok:
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
