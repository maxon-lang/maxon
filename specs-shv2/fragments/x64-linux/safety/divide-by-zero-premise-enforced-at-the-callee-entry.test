// Test: divide-by-zero-premise-enforced-at-the-callee-entry
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function ident(v Integer) returns Integer
	return v
end 'ident'

function divide(n Integer, d NonZero) returns Integer
	return n / d
end 'divide'

function main() returns ExitCode
	let z = ident(0)
	return divide(10, d: z)
end 'main'
---
ExitCode: 1
---
func @divide {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rsi, rdx
    x64.cmpRegImm32 rsi, 1
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:9: Range check failed: value outside typealias 'NonZero'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.movRegReg r8, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rdx, 0
  __il_cont:
    x64.movRegImm32 rcx, 10
    x64.callDirect divide
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at divide-by-zero-premise-enforced-at-the-callee-entry.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
