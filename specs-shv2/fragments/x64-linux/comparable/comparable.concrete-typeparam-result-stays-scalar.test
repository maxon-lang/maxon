// Test: comparable.concrete-typeparam-result-stays-scalar
typealias Integer = int(0 to u32.max)

type Box uses T
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function get() returns T
		return self.item
	end 'get'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	let b = IntBox.create(7)
	let v = b.get()
	if v < 9 'lt'
		return 1
	end 'lt'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 7
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegRdata rdx, [rip + __layout_Box_Integer]
    x64.callDirect Box.get
    x64.cmpRegImm32 r8, 9
    x64.jcc less, lt
    x64.jmp ifcont
  lt:
    x64.movRegImm32 r8, 1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
