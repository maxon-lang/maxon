    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at a-known-word-stride-write-keeps-every-other-guard.test:19: get: index out of range\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
