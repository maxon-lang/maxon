// Test: a-known-word-stride-write-keeps-every-other-guard
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function fill(a WordArray, n Word)
	for i in 0 upto n 'each'
		try a.set(i, value: i * 3 + 1) otherwise panic("set: index out of range")
	end 'each'
end 'fill'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 5 'seed'
		a.push(0)
	end 'seed'
	fill(a, n: 5)
	var seen = 0
	for i in 0 upto 5 'check'
		seen = seen + (try a.get(i) otherwise panic("get: index out of range"))
	end 'check'
	if seen != 35 'sum'
		return 1
	end 'sum'
	if (try a.get(4) otherwise panic("get: index out of range")) != 13 'last'
		return 2
	end 'last'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @fill {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 r13, 0
  forhdr:
    x64.cmpRegReg r13, r12
    x64.jcc greaterEqual, forexit
  each:
    x64.imulRegRegImm32 rax, r13, 3
    x64.leaRegRegImm32 rax, rax, 1
    x64.cmpRegImm32 r13, 0
    x64.jcc greaterEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at a-known-word-stride-write-keeps-every-other-guard.test:7: Range check failed: value outside typealias 'ElementIndex'\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow
  __im_owned:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __im_slow
  __im_bounds:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.cmpRegReg r13, rcx
    x64.jcc aboveEqual, __im_slow
  __im_buffer:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, __im_slow
  __im_viewed:
    x64.leaRegRegImm32 rdx, rcx, -24
    x64.loadRegBaseDisp.word64 rdx, [rdx + 16]
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, __im_store
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_set
    x64.jmp __im_cont
  __im_store:
    x64.storeBaseIndexScaleReg.word64 [rcx + r13*8 + 0], rax
    x64.movRegImm32 rax, 0
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, forstep
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-known-word-stride-write-keeps-every-other-guard.test:7: set: index out of range\x0a"
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

