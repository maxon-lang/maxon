// Test: for-in-iterable.an-infallible-factory-needs-no-entry-edge
typealias Integer = int(i64.min to i64.max)

type Countdown
	var n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'

	export function current() returns Integer
		return self.n
	end 'current'

	export function advance() throws IterationError
		if self.n <= 1 'done'
			throw IterationError.exhausted
		end 'done'
		self.n = self.n - 1
	end 'advance'
end 'Countdown'

type Countable
	var start as Integer

	export static function create(start Integer) returns Self
		return Self{start: start}
	end 'create'

	export function createIterator() returns Countdown
		return Countdown.create(self.start)
	end 'createIterator'
end 'Countable'

function main() returns ExitCode
	let c = Countable.create(4)
	var sum = 0
	for v in c 'each'
		sum = sum + v
	end 'each'
	return sum
end 'main'
---
ExitCode: 10
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Countdown.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Countdown.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Countdown.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, done
    x64.jmp ifcont
  done:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, -1
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @Countable.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect Countdown.create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rax, 4
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rbx, 0
    x64.callDirect Countable.createIterator
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, each
    x64.jmp forexit
  each:
    x64.movRegReg rcx, r12
    x64.callDirect Countdown.current
    x64.leaRegRegReg rbx, rbx, r8
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r12
    x64.callDirect Countdown.advance
    x64.movRegReg rcx, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.jmp forjoin
  forempty:
    x64.movRegReg r8, rbx
    x64.jmp forjoin
  forjoin:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
