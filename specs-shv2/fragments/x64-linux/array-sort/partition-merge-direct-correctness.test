  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body
  __il_body:
    x64.cmpRegReg rcx, rdx
    x64.jcc less, lt
    x64.jmp ifcont#4
  lt:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  ifcont#4:
    x64.cmpRegReg rcx, rdx
    x64.jcc greater, gt
    x64.jmp ifcont#6
  gt:
    x64.movRegImm32 r8, 2
    x64.jmp __il_cont
  ifcont#6:
    x64.movRegImm32 r8, 1
    x64.jmp __il_cont
  __il_cont:
    x64.popReg rbp
    x64.ret
}

