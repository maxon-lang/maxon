// Test: assignment
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	var d = Direction.north
	d = Direction.west
	if d == Direction.west 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
