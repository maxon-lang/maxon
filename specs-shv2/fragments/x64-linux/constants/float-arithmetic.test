// Test: float-arithmetic
enum Weight
	light = 0.5
	heavy = 2.0
end 'Weight'

function main() returns ExitCode
	let scale = 4.0
	let result = Weight.light * scale
	if result == 2.0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_4]
    x64.movRegImm rax, 4602678819172646912
    x64.movqXmmGpr xmm1, rax
    x64.mulsdRegReg xmm1, xmm1, xmm0
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
