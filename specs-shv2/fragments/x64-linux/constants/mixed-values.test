// Test: mixed-values
enum Priority
	low
	medium
	high = 10
	critical
end 'Priority'

function main() returns ExitCode
	let result = match Priority.critical 'check'
		low gives 0
		medium gives 1
		high gives 10
		critical gives 11
	end 'check'
	return result
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 11
    x64.cmpRegImm32 rax, 10
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#8
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext#8:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rax, 10
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#9
  matcharm#3:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matchnext#9:
    x64.cmpRegImm32 rax, 11
    x64.jcc equal, matcharm#4
    x64.jmp matchdead
  matcharm#4:
    x64.movRegImm32 r8, 11
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
