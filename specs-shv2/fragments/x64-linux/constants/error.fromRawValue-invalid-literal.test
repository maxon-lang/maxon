// Test: error.fromRawValue-invalid-literal
enum HttpStatus
	ok = 200
	notFound = 404
end 'HttpStatus'

function main() returns ExitCode
	_ = try HttpStatus.fromRawValue(999) otherwise HttpStatus.ok
	return 0
end 'main'
---
