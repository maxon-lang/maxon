// Test: simple-enum-rawvalue
enum Direction
	north
	south
	east
end 'Direction'

function main() returns ExitCode
	let d = Direction.south
	return d.rawValue
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
