// Test: var-global-string-to-appending-param-ok
typealias Integer = int(i64.min to i64.max)

var greeting = "hi"

function grow(s String) returns Integer
	s.append("XY")
	return s.byteLength()
end 'grow'

function main() returns ExitCode
	return grow(greeting) as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __data_greeting@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @grow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rdx, [rip + __str_rec_2]
    x64.movRegReg rcx, rbx
    x64.callDirect String.append
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_greeting
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect grow
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}

func @String.append {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, r12
    x64.callDirect __str_bytes_view
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_append
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.loadRegBaseDisp.byte rax, [r12 + 48]
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, clearFlag
    x64.jmp ifcont
  clearFlag:
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.byte [rbx + 48], rax
    x64.jmp ifcont
  ifcont:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
