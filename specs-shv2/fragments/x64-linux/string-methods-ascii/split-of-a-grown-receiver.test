// Test: split-of-a-grown-receiver
function main() returns ExitCode
	let a = "one"
	let b = "two"
	let t = "{a},{b},{a}"
	let parts = t.split(",")
	print("{parts.count()}\n")
	for p in parts 'loop'
		print("[{p}]")
	end 'loop'
	print("\n")
	var acc = ""
	acc.append("x,y")
	let grown = acc.split(",")
	print("{grown.count()}\n")
	return 0
end 'main'
