// Test: default-values.bool-default-omitted
typealias Integer = int(i64.min to i64.max)

function choose(flag bool = true, a Integer = 40, b Integer = 10) returns Integer
	if flag 'check'
		return a + 2
	end 'check' else 'other'
		return b
	end 'other'
end 'choose'

function main() returns ExitCode
	return choose()
end 'main'
---
ExitCode: 42
---
func @choose {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, check
    x64.jmp ifelse
  check:
    x64.leaRegRegImm32 r8, rdx, 2
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegReg r8, rax
    x64.popReg rbp
    x64.ret
  ifcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __paramDefault#choose#0
    x64.movRegReg rbx, r8
    x64.callDirect __paramDefault#choose#1
    x64.movRegReg r12, r8
    x64.callDirect __paramDefault#choose#2
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r8
    x64.callDirect choose
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @__paramDefault#choose#0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @__paramDefault#choose#1 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 40
    x64.popReg rbp
    x64.ret
}

func @__paramDefault#choose#2 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 10
    x64.popReg rbp
    x64.ret
}
