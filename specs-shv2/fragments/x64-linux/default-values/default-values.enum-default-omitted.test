// Test: default-values.enum-default-omitted
enum Color
	red
	green
	blue
end 'Color'

function paint(color Color = Color.blue) returns ExitCode
	return color.rawValue
end 'paint'

function main() returns ExitCode
	return paint()
end 'main'
---
ExitCode: 2
---
func @paint {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRegImm32 r8, rcx, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __paramDefault#paint#0
    x64.movRegReg rcx, r8
    x64.callDirect paint
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @__paramDefault#paint#0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
}
