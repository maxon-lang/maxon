func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Tbl_String]
    x64.leaRegRdata rdx, [rip + __witness_String.Hashable]
    x64.leaRegRdata rax, [rip + __witness_String.Equatable]
    x64.callDirect Tbl.create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __layout_Tbl_String]
    x64.leaRegRdata rax, [rip + __witness_String.Hashable]
    x64.leaRegRdata r9, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Tbl.grow
    x64.leaRegRdata rdx, [rip + __witness_String.Hashable]
    x64.leaRegRdata rax, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Tbl.slots
    x64.cmpRegImm32 r8, 16
    x64.jcc notEqual, wrongCapacity
    x64.jmp ifcont#2
