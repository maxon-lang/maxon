// Test: literal-in-range
typealias SmallInt = int(0 to 10)

function main() returns ExitCode
	let x = 7 as SmallInt
	return x
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 7
    x64.leaRegRegImm32 r8, rax, 0
    x64.popReg rbp
    x64.ret
}
