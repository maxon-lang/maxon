// Test: top-level-float-cast-in-range
typealias Pct = float(0.0 to 100.0)

let GOOD = 50.0 as Pct

function main() returns ExitCode
	return trunc(GOOD)
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
