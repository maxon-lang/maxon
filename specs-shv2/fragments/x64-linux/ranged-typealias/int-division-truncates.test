// Test: int-division-truncates
function main() returns ExitCode
	let a = 7
	let b = 2
	return a / b
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 7
    x64.movRegImm32 rcx, 2
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg r8, rax
    x64.popReg rbp
    x64.ret
}
