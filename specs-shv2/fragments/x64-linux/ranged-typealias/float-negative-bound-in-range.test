// Test: float-negative-bound-in-range
typealias Neg = float(-100.0 to -1.0)

function main() returns ExitCode
	let p = -50.0 as Neg
	return trunc(-p)
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 50
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
