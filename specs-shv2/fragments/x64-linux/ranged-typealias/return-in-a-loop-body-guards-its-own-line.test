    x64.setccReg greater, rsi
  whilehdr:
    x64.cmpRegImm32 rdx, 3
    x64.jcc greaterEqual, whileexit
  spin:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, ifcont
  big:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __rc_panic#10
  __rc_chk#11:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_7]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __rc_panic#13
  __rc_chk#14:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#12
  __rc_panic#13:
    x64.leaRegRdata rcx, [rip + __str_blob_8]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#12:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

