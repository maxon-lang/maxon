    x64.jcc less, __rc_panic#7
  __rc_chk#8:
    x64.cmpRegImm32 rcx, 100000
    x64.jcc lessEqual, __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.movRegImm32 rdx, 0
