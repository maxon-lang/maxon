// Test: float-straddling-zero-in-range
typealias Unit = float(-1.0 to 1.0)

function main() returns ExitCode
	let u = -0.5 as Unit
	return trunc(-u * 100.0)
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.subsdRegReg xmm1, xmm1, xmm0
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.mulsdRegReg xmm1, xmm1, xmm0
    x64.cvttsd2siRegReg r8, xmm1
    x64.popReg rbp
    x64.ret
}
