// Test: float-runtime-negative-bound-panic
typealias Neg = float(-100.0 to -1.0)
typealias Wide = float(f64.min to f64.max)

function scale(x Wide) returns Wide
	return x * 2.0
end 'scale'

function main() returns ExitCode
	let v = scale(-200.0)
	let n = v as Neg
	return trunc(-n)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.jmp __il_body
  __il_body:
    x64.movsdRegRip xmm1, [rip + __fconst_6]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.jmp __il_cont
  __il_cont:
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.subsdRegReg xmm1, xmm1, xmm0
    x64.cvttsd2siRegReg r8, xmm1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
