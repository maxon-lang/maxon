// Test: unsigned-max-upper-literal-in-range
typealias Big = int(5 to u64.max)

function main() returns ExitCode
	let x = u64.max as Big
	if x == u64.max 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ok:
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
