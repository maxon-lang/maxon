// Test: float-call-argument-in-range
typealias Pct = float(0.0 to 100.0)

function take(p Pct) returns Pct
	return p
end 'take'

function main() returns ExitCode
	return trunc(take(42.5))
end 'main'
---
ExitCode: 42
---
func @take {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic
  __rc_chk:
    x64.movsdRegRip xmm1, [rip + __fconst_100]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-call-argument-in-range.test:4: Range check failed: value outside typealias 'Pct'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
