// Test: range-id-arithmetic
function main() returns ExitCode
	let x = u8.max + 1
	return x - 206
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 255
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegRegImm32 r8, rax, -206
    x64.popReg rbp
    x64.ret
}
