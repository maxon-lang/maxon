// Test: loop-reads-a-global-it-writes
var acc = 0
var i = 0

function main() returns ExitCode
	while i < 5 'loop'
		acc = acc + i
		i = i + 1
	end 'loop'
	return acc
end 'main'
---
ExitCode: 10
---
data {
  __data_acc@0 = i64 0
  __data_i@8 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp whilehdr
  whilehdr:
    x64.leaRegGlobal rax, __data_i
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 5
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegGlobal rax, __data_acc
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegGlobal rcx, __data_i
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegGlobal rcx, __data_acc
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_i
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_i
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp whilehdr
  whileexit:
    x64.leaRegGlobal rax, __data_acc
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
