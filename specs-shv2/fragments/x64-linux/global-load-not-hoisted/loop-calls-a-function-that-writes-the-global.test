// Test: loop-calls-a-function-that-writes-the-global


var counter = 0

function bump()
	counter = counter + 1
end 'bump'

function main() returns ExitCode
	var seen = 0
	var n = 0
	while n < 5 'loop'
		bump()
		seen = seen + counter
		n = n + 1
	end 'loop'
	return seen
end 'main'
---
ExitCode: 15
---
data {
  __data_counter@0 = i64 0
}

func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_counter
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 5
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.callDirect bump
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegReg rbx, rbx, rax
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
