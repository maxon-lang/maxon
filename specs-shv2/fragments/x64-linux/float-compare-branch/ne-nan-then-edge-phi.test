// Test: ne-nan-then-edge-phi
var big = 1.0e308

function main() returns ExitCode
	var r = 7
	let inf = big * 10.0
	let nan = inf - inf
	if nan != nan 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 1
---
data {
  __data_big@0 = f64 9214871658872686752
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.leaRegGlobal rax, __data_big
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.subsdRegReg xmm0, xmm0, xmm0
    x64.ucomisdRegReg xmm0, xmm0
    x64.jcc parity, check
    x64.jmp fordered
  fordered:
    x64.jcc notEqual, check
    x64.jmp critsplit
  check:
    x64.movRegImm32 r8, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.popReg rbp
    x64.ret
}
