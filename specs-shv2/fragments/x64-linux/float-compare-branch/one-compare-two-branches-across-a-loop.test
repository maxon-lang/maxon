// Test: one-compare-two-branches-across-a-loop
typealias Num = int(i64.min to i64.max)

function classify(x Num, n Num) returns Num
	let small = x < 10
	var acc = 0
	if small 'first'
		acc = acc + 1
	end 'first'

	var i = 0
	while i < n 'loop'
		acc = acc + i
		i = i + 1
	end 'loop'

	if small 'second'
		acc = acc + 100
	end 'second'
	return acc
end 'classify'

function main() returns ExitCode
	return classify(3, n: 4)
end 'main'
---
ExitCode: 107
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  first:
    x64.movRegImm32 rax, 1
  ifcont:
    x64.movRegImm32 rcx, 0
  whilehdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc greaterEqual, second
  loop:
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  second:
    x64.leaRegRegImm32 r8, rax, 100
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
