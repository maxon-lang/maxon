// Test: one-compare-two-branches-across-a-loop
typealias Num = int(i64.min to i64.max)

function classify(x Num, n Num) returns Num
	let small = x < 10
	var acc = 0
	if small 'first'
		acc = acc + 1
	end 'first'

	var i = 0
	while i < n 'loop'
		acc = acc + i
		i = i + 1
	end 'loop'

	if small 'second'
		acc = acc + 100
	end 'second'
	return acc
end 'classify'

function main() returns ExitCode
	return classify(3, n: 4)
end 'main'
---
ExitCode: 107
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 10
    x64.setccReg less, rax
    x64.movRegImm32 rcx, 0
    x64.jcc less, first
    x64.jmp critsplit#8
  first:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rsi, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg rsi, rdx
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRegReg rcx, rcx, rsi
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, second
    x64.jmp critsplit#9
  second:
    x64.leaRegRegImm32 r8, rcx, 100
    x64.jmp ifcont#7
  critsplit#9:
    x64.movRegReg r8, rcx
    x64.jmp ifcont#7
  ifcont#7:
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 4
    x64.callDirect classify
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
