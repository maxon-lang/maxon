// Test: seven-float-parameters
function sumf7(a Real, b Real, c Real, d Real, e Real, f Real, g Real) returns Real
	return a + b + c + d + e + f + g
end 'sumf7'

function main() returns ExitCode
	let total = sumf7(1.0, b: 2.0, c: 4.0, d: 8.0, e: 16.0, f: 32.0, g: 64.0)
	if total == 127.0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
typealias Real = float(f64.min to f64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.storeSlotReg slot0, xmm6
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.movsdRegRip xmm2, [rip + __fconst_2]
    x64.movsdRegRip xmm3, [rip + __fconst_3]
    x64.movsdRegRip xmm4, [rip + __fconst_4]
    x64.movsdRegRip xmm5, [rip + __fconst_5]
    x64.movsdRegRip xmm6, [rip + __fconst_6]
  __il_body:
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.addsdRegReg xmm0, xmm0, xmm2
    x64.addsdRegReg xmm0, xmm0, xmm3
    x64.addsdRegReg xmm0, xmm0, xmm4
    x64.addsdRegReg xmm0, xmm0, xmm5
    x64.addsdRegReg xmm0, xmm0, xmm6
  __il_cont:
    x64.movsdRegRip xmm1, [rip + __fconst_7]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
