    x64.loadRegBaseDisp.word64 r15, [rbp + 104]
    x64.storeSlotReg slot0, r15
    x64.loadRegBaseDisp.word64 r15, [rbp + 112]
    x64.storeSlotReg slot1, r15
    x64.loadRegBaseDisp.word64 r15, [rbp + 120]
