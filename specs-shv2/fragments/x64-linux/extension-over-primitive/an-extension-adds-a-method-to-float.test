// Test: an-extension-adds-a-method-to-float
extension float
	export function tripled() returns Real
		return self * 3.0
	end 'tripled'
end 'float'

function main() returns ExitCode
	let x = 4.0
	return trunc(x.tripled()) as ExitCode
end 'main'
typealias Real = float(f64.min to f64.max)
---
ExitCode: 12
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_1]
  __il_body:
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
  __il_cont:
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
