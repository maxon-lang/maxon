// Test: byte-enum-comparison.enum-coerces-to-byte-array-element

typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function main() returns ExitCode
	var out = ByteArray.create()
	out.push(Ascii.space)
	out.push(Ascii.zero)
	let first = try out.get(0) otherwise 99
	let second = try out.get(1) otherwise 99
	if first == 32 and second == 48 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 32
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 48
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 99
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg r12, r8
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 99
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
    x64.jmp trycont#6
  trycont#6:
    x64.cmpRegImm32 r12, 32
    x64.movRegImm32 rcx, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rax, 48
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
