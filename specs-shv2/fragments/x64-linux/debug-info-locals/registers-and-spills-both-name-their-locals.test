    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegImm32 rsi, 1
    x64.movRegImm32 rdi, 0
    x64.movRegReg r8, rcx
  whilehdr:
    x64.cmpRegImm32 rdi, 3
    x64.jcc greaterEqual, whileexit
  mix:
    x64.leaRegRegReg rax, r8, rsi
    x64.movRegImm32 rcx, 97
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.leaRegRegReg rsi, rsi, rdi
    x64.leaRegRegImm32 rdi, rdi, 1
    x64.movRegReg r8, rdx
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#8
  __rc_chk#9:
    x64.cmpRegImm32 r8, 1000
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_5]  ; "panic at registers-and-spills-both-name-their-locals.test:14: Range check failed: value outside typealias 'Tick'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.epilogue 32
