func @probe {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 0
  forhdr:
    x64.cmpRegImm32 rbx, 20
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRdata rcx, [rip + __str_rec_19]  ; "noyield.txt"
    x64.callDirect FilePath.init
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect File.exists
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_FilePath
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 7
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

