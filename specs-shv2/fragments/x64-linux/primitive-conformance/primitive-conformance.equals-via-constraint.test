// Test: primitive-conformance.equals-via-constraint
typealias Integer = int(0 to u32.max)

type Box uses T where T is Equatable
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function sameAs(other T) returns bool
		return self.item.equals(other)
	end 'sameAs'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	let b = IntBox.create(5)
	if not b.sameAs(5) 'eq'
		return 1
	end 'eq'
	if b.sameAs(9) 'ne'
		return 2
	end 'ne'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.sameAs {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rax
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 5
    x64.leaRegRdata rcx, [rip + __witness_int.Equatable]
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rdx, 5
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Box.sameAs
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, eq
    x64.jmp ifcont#2
  eq:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 9
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Box.sameAs
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, ne
    x64.jmp ifcont#4
  ne:
    x64.movRegImm32 r8, 2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @int.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}
