// Test: narrow-ranged-float-byref-param-guards-the-pointee
typealias Ratio = float(0.0 to 10.0)

function scale(r Ratio) returns Ratio
	r = r * 2.0
	return r
end 'scale'

function main() returns ExitCode
	var v = 3.0
	let doubled = scale(v)
	if doubled == 6.0 'exact'
		return 6
	end 'exact'
	return 1
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @scale {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic#2
  __rc_chk#3:
    x64.movsdRegRip xmm1, [rip + __fconst_10]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at narrow-ranged-float-byref-param-guards-the-pointee.test:4: Range check failed: value outside typealias 'Ratio'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.storeBaseDispReg.word64 [rcx + 0], xmm0
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic#5
  __rc_chk#6:
    x64.movsdRegRip xmm1, [rip + __fconst_10]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at narrow-ranged-float-byref-param-guards-the-pointee.test:6: Range check failed: value outside typealias 'Ratio'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.movsdRegRip xmm6, [rip + __fconst_3]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.storeBaseDispReg.word64 [rbx + 0], xmm6
    x64.movRegReg rcx, rbx
    x64.callDirect scale
    x64.movsdRegRip xmm1, [rip + __fconst_6]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
  fordered:
    x64.jcc notEqual, ifcont
  exact:
    x64.movRegImm32 r12, 6
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
