    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 48
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegImm32 rbx, 42
    x64.leaRegFunc rcx, [rip + __str_decref]
    x64.movRegImm32 rdx, 0
    x64.callDirect __map_create
    x64.movRegReg r12, r8
    x64.leaRegRdata r9, [rip + __witness_String.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, rbx
    x64.callDirect __map_upsert
    x64.leaRegRdata rdx, [rip + __str_rec_1]
    x64.leaRegRdata rax, [rip + __witness_String.Hashable]
    x64.leaRegRdata r9, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect __map_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
    x64.jmp trycont
  trycont:
    x64.movRegReg rcx, r12
    x64.callDirect __map_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.movRegImm32 rdx, 5381
    x64.movRegImm32 rsi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rsi, rcx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rdx
    x64.andRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rdi, rax, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 1
    x64.leaRegRegReg rsi, rsi, rdi
    x64.jmp header
}

