// Test: string-keys-early-return
function main() returns ExitCode
	let m = ["test": 42]
	let v = try m.get("test") otherwise 0
	return v
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
