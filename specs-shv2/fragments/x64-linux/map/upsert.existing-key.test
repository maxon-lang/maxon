// Test: upsert.existing-key
function main() returns ExitCode
	var m = [1: 10, 2: 20]
	m.upsert(1, value: 100)
	let result = try m.get(1) otherwise 0
	return result
end 'main'
---
ExitCode: 100
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
