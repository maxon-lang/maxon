    x64.movRegImm32 r12, 10
    x64.leaRegRdata rcx, [rip + __layout_Map_int_int]
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.callDirect Map.create
    x64.movRegReg r13, r8
    x64.leaRegRdata r9, [rip + __layout_Map_int_int]
    x64.leaRegRdata rsi, [rip + __witness_int.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect Map.upsert
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 20
    x64.leaRegRdata r9, [rip + __layout_Map_int_int]
    x64.leaRegRdata rsi, [rip + __witness_int.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect Map.upsert
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 100
    x64.leaRegRdata r9, [rip + __layout_Map_int_int]
    x64.leaRegRdata rsi, [rip + __witness_int.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect Map.upsert
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __layout_Map_int_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect Map.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
  trycont:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Map_int_int
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_22]  ; "panic at upsert.existing-key.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
