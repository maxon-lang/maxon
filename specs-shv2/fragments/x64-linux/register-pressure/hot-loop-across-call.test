// Test: hot-loop-across-call
function sink(x int) returns int
	return x
end 'sink'

function hotCall(_ int) returns int
	var s1 = 1
	var s2 = 2
	var s3 = 3
	var s4 = 4
	var s5 = 5
	var i = 0
	while i < 5 'loop'
		let r = sink(i)
		s1 = s1 + r
		s2 = s2 + r
		s3 = s3 + r
		s4 = s4 + r
		s5 = s5 + r
		i = i + 1
	end 'loop'
	return s1 + s2 + s3 + s4 + s5
end 'hotCall'

function main() returns ExitCode
	return hotCall(0)
end 'main'
---
ExitCode: 65
---
func @sink {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @hotCall {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rbx, 1
    x64.movRegImm32 r12, 2
    x64.movRegImm32 r13, 3
    x64.movRegImm32 r14, 4
    x64.movRegImm32 r15, 5
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot0, rcx
    x64.cmpRegImm32 rcx, 5
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.callDirect sink
    x64.leaRegRegReg rbx, rbx, r8
    x64.leaRegRegReg r12, r12, r8
    x64.leaRegRegReg r13, r13, r8
    x64.leaRegRegReg r14, r14, r8
    x64.leaRegRegReg r15, r15, r8
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rcx, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRegReg rax, rbx, r12
    x64.leaRegRegReg rax, rax, r13
    x64.leaRegRegReg rax, rax, r14
    x64.leaRegRegReg r8, rax, r15
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect hotCall
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
