    x64.leaRegRegReg rdx, rdx, rbx
    x64.leaRegRegReg rdx, rdx, r12
    x64.leaRegRegReg rdx, rdx, r13
    x64.loadRegSlot r13, slot2
    x64.leaRegRegReg rdx, rdx, r13
    x64.leaRegRegReg rdx, rdx, r14
    x64.loadRegSlot r13, slot4
    x64.leaRegRegReg rdx, rdx, r13
    x64.loadRegSlot r13, slot5
    x64.leaRegRegReg rdx, rdx, r13
    x64.loadRegSlot r13, slot6
