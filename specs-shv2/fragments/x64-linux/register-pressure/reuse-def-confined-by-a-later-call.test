    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.storeSlotReg slot0, rax
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
    x64.jmp whilehdr#1
  whilehdr#1:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.cmpRegReg r14, r8
    x64.jcc less, shiftEach
    x64.jmp whileexit#3
  shiftEach:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#4:
    x64.movRegReg rax, r12
    x64.andRegImm32 rax, r12, -64
    x64.movRegReg rcx, rax
    x64.negReg rcx, rax
    x64.orRegReg rax, rax, rcx
    x64.sarRegImm8 rax, rax, 63
    x64.movRegReg rcx, r12
    x64.shlRegCl r8, r8
    x64.notReg rax, rax
    x64.andRegReg r8, r8, rax
    x64.movRegReg r15, r8
    x64.orRegReg r15, r8, r13
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg rsi, r15
    x64.andRegReg rsi, r15, rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.movRegReg rax, rsi
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#7
    x64.jmp tryok#6
  tryerr#7:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#6:
    x64.sarRegImm8 r15, r15, 32
    x64.leaRegRegImm32 r14, r14, 1
    x64.movRegReg r13, r15
    x64.jmp whilehdr#1
  whileexit#3:
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr#8
  whilehdr#8:
    x64.loadRegSlot rax, slot0
    x64.cmpRegReg r12, rax
    x64.jcc less, clear
    x64.jmp whileexit#10
  clear:
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#12
    x64.jmp tryok#11
  tryerr#12:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
