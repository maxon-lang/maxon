// Test: confined-reuse-defs-past-the-callee-saved-half
typealias Integer = int(i64.min to i64.max)

function sink(x Integer) returns Integer
	return x + 1
end 'sink'

function main() returns ExitCode
	let n = sink(3)
	let a0 = n + 1
	let a1 = n + 2
	let a2 = n + 3
