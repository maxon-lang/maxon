// Test: cycle-plus-leaf-moves
function cycleAndLeaf(p int) returns int
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var d = p
	var i = 0
	while i < 4 'loop'
		let t = a
		d = a
		a = b
		b = c
		c = t
		i = i + 1
	end 'loop'
	return a * 1000 + b * 100 + c * 10 + d
end 'cycleAndLeaf'

function main() returns ExitCode
	let r = cycleAndLeaf(0)
	if r == 2311 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @cycleAndLeaf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, 1
    x64.leaRegRegImm32 rdx, rcx, 2
    x64.leaRegRegImm32 rsi, rcx, 3
    x64.movRegImm32 rdi, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rdi, 4
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRegImm32 rdi, rdi, 1
    x64.movRegReg rcx, rax
    x64.xchgRegReg rax, rdx
    x64.xchgRegReg rdx, rsi
    x64.jmp whilehdr
  whileexit:
    x64.imulRegRegImm32 rax, rax, 1000
    x64.imulRegRegImm32 rdx, rdx, 100
    x64.leaRegRegReg rax, rax, rdx
    x64.imulRegRegImm32 rdx, rsi, 10
    x64.leaRegRegReg rax, rax, rdx
    x64.leaRegRegReg r8, rax, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect cycleAndLeaf
    x64.cmpRegImm32 r8, 2311
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
