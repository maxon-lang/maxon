// Test: min.second-smaller
function main() returns ExitCode
	let x = min(10.0, 2.0)
	return trunc(x)
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.minsd xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
