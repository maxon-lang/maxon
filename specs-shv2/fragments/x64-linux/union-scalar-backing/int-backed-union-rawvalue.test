// Test: int-backed-union-rawvalue
union ErrorCode
	lexerUnexpectedCharacter = 1001
	parserUnexpectedToken = 2001
	semanticTypeMismatch = 3001
end 'ErrorCode'

function main() returns ExitCode
	let code = ErrorCode.semanticTypeMismatch
	return (code.rawValue mod 100) as ExitCode
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 3001
    x64.movRegImm rax, 11805916207174113035
    x64.imulHighReg r8
    x64.leaRegRegImm32 rax, rdx, 3001
    x64.sarRegImm8 rax, rax, 6
    x64.movRegReg rcx, rax
    x64.shrRegImm8 rcx, rax, 63
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rax, rax, 100
    x64.subRegReg r8, r8, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
