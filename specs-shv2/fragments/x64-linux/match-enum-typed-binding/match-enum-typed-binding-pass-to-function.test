// Test: match-enum-typed-binding-pass-to-function
enum Direction
		north
		south
		east
		west
end 'Direction'

union Move
		walk(dir Direction)
		stay
end 'Move'

function directionValue(d Direction) returns ExitCode
		match d 'check'
				north then return 1
				south then return 2
				east then return 3
				west then return 4
		end 'check'
end 'directionValue'

function main() returns ExitCode
		let m = Move.walk(Direction.east)
		match m 'act'
				walk(dir) then return directionValue(dir)
				stay then return 0
		end 'act'
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 2
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.jmp __il_body
  __il_body:
    x64.jumpTable rax, default=matchdead#12 [[0]=matcharm#8, [1]=matcharm#9, [2]=matcharm#10, [3]=matcharm#11] @__jumptable_0
  matchdead#12:
  matcharm#8:
    x64.movRegImm32 rbx, 1
    x64.jmp __il_cont
  matcharm#9:
    x64.movRegImm32 rbx, 2
    x64.jmp __il_cont
  matcharm#10:
    x64.movRegImm32 rbx, 3
    x64.jmp __il_cont
  matcharm#11:
    x64.movRegImm32 rbx, 4
    x64.jmp __il_cont
  __il_cont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead#3
  matcharm#2:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#3:
  matchcont#5:
  matchcont#13:
}
