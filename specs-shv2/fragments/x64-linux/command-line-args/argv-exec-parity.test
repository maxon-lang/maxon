    x64.jmp trycont#15
  tryok#13:
    x64.movRegReg rcx, r8
  trycont#15:
    x64.leaRegRdata rdx, [rip + __str_rec_22]  ; "gamma"
    x64.callDirect __str_eq
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#17
  a3-check:
