// Test: where-clauses.constraint-interface-in-a-later-file
// --- file: a.maxon
typealias Code = int(0 to u32.max)
typealias Coord = int(0 to 1000)

type Point implements Digest
	export var x as Coord
	export var y as Coord
	export static function create(x Coord, y Coord) returns Self
		return Self{ x: x, y: y }
	end 'create'
	export function digest() returns Code
		return self.x * 31 + self.y
	end 'digest'
end 'Point'

type Box uses T where T is Digest
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function itemDigest() returns Code
		return self.item.digest()
	end 'itemDigest'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let p = Point.create(3, y: 4)
	let b = PointBox.create(p)
	if b.itemDigest() == 97 'ok'
		return 42
	end 'ok'
	return 1
end 'main'

// --- file: z.maxon
export interface Digest
	function digest() returns Code
end 'Digest'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Point.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc greater, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 r12, 1000
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Point.digest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegRegImm32 rax, rax, 31
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Box.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Box.itemDigest {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 4
    x64.callDirect Point.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_Point.Digest]
    x64.movRegReg rcx, rbx
    x64.callDirect Box.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __witness_Point.Digest]
    x64.movRegReg rcx, r12
    x64.callDirect Box.itemDigest
    x64.cmpRegImm32 r8, 97
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r13, 42
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Box_Point
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Box_Point
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
