// Test: float.clone
function main() returns ExitCode
	let x = 3.14
	let y = x.clone()
	if y == 3.14 'ok'
		return 1
	end 'ok'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.callDirect float.clone
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @float.clone {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.popReg rbp
    x64.ret
}
