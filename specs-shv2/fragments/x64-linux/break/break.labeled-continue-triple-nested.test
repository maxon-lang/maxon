// Test: break.labeled-continue-triple-nested
function main() returns ExitCode
	var count = 0
	var a = 0
	while a < 2 'outer'
		a = a + 1
		var b = 0
		while b < 3 'middle'
			b = b + 1
			var c = 0
			while c < 4 'inner'
				c = c + 1
				count = count + 1
				if c == 2 'check'
					continue 'middle'
				end 'check'
			end 'inner'
		end 'middle'
	end 'outer'
	return count
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  whilehdr#1:
    x64.cmpRegImm32 rax, 2
    x64.jcc greaterEqual, whileexit
  outer:
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegImm32 rcx, 0
  whilehdr#4:
    x64.cmpRegImm32 rcx, 3
    x64.jcc greaterEqual, whilehdr#1
  middle:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.movRegImm32 rdx, 0
  whilehdr#7:
    x64.cmpRegImm32 rdx, 4
    x64.jcc greaterEqual, whilehdr#4
  inner:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.leaRegRegImm32 r8, r8, 1
    x64.cmpRegImm32 rdx, 2
    x64.jcc equal, whilehdr#4
    x64.jmp whilehdr#7
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
