// Test: break.with-if
function main() returns ExitCode
	var x = 0
	while true 'loop'
		x = x + 1
		if x == 10 'check'
			break
		end 'check'
	end 'loop'
	return x
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, loop
    x64.jmp critsplit
  loop:
    x64.leaRegRegImm32 r8, rax, 1
    x64.cmpRegImm32 r8, 10
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.jmp whileexit
  ifcont:
    x64.movRegReg rax, r8
    x64.jmp whilehdr
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp whileexit
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
