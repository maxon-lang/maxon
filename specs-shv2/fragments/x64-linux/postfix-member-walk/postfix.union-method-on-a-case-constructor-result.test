// Test: postfix.union-method-on-a-case-constructor-result
typealias Wide = int(i64.min to i64.max)

union Shape
	dot
	box(w Wide)

	function area() returns Wide
		match self 'm'
			dot then return 1
			box(w) then return w
		end 'm'
	end 'area'
end 'Shape'

function main() returns ExitCode
	return Shape.box(21).area() + Shape.dot.area()
end 'main'
