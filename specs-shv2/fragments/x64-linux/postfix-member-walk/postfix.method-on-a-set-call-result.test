// Test: postfix.method-on-a-set-call-result
typealias Wide = int(i64.min to i64.max)
typealias WideSet = Set with Wide

function main() returns ExitCode
	return WideSet.create().count() + 11
end 'main'
---
ExitCode: 11
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect __set_create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __set_count
    x64.leaRegRegImm32 r12, r8, 11
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
