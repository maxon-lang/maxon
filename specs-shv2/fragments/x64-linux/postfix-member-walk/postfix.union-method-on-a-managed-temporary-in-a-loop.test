// Test: postfix.union-method-on-a-managed-temporary-in-a-loop
union Outcome
	pass
	fail(reason String)

	export function isPass() returns bool
		return match self 'p'
			pass gives true
			fail gives false
		end 'p'
	end 'isPass'
end 'Outcome'

function main() returns ExitCode
	var i = 0

	while i < 200 'loop'
		if Outcome.fail("a rather long failure reason to force a heap allocation").isPass() 'y'
			return 1
		end 'y'
		i = i + 1
	end 'loop'

	return 7
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Outcome.isPass {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rax, 200
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rbx + 8]
    x64.leaRegRegImm32 rcx, rbx, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r13
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, rbx
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], rbx
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.storeBaseDispReg.word64 [r12 + 8], r14
    x64.movRegReg rcx, r12
    x64.callDirect Outcome.isPass
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Outcome
    x64.cmpRegImm32 rbx, 0
    x64.jcc notEqual, y
    x64.jmp ifcont
  y:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 r8, 7
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
