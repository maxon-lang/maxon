// Test: neg-chain
function negs(p int) returns int
	let x = p + 7
	let n1 = -x
	let n2 = -n1
	let n3 = -n2
	return x * 100 - n3
end 'negs'

function main() returns ExitCode
	let r = negs(0)
	if r == 707 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.jmp __il_body
  __il_body:
    x64.leaRegRegImm32 rax, rax, 7
    x64.movRegReg rcx, rax
    x64.negReg rcx, rax
    x64.negReg rcx, rcx
    x64.negReg rcx, rcx
    x64.imulRegRegImm32 rax, rax, 100
    x64.subRegReg rax, rax, rcx
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 707
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
