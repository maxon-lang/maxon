// Test: neg-chain
function negs(p Integer) returns Integer
	let x = p + 7
	let n1 = -x
	let n2 = -n1
	let n3 = -n2
	return x * 100 - n3
end 'negs'

function main() returns ExitCode
	let r = negs(0)
	if r == 707 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_body:
    x64.movRegImm32 rax, 7
    x64.negReg rax, rax
    x64.negReg rax, rax
    x64.negReg rax, rax
    x64.movRegImm32 rcx, 700
    x64.subRegReg rcx, rcx, rax
  __il_cont:
    x64.cmpRegImm32 rcx, 707
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
