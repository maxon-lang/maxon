// Test: reuse-copy-outlives
function main() returns ExitCode
	var a = 20
	var b = 5
	var i = 0
	while i < 3 'loop'
		b = a - b
		i = i + 1
	end 'loop'
	return b
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 20
    x64.movRegImm32 r8, 5
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegReg rdx, rax
    x64.subRegReg rdx, rax, r8
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.movRegReg r8, rdx
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
}
