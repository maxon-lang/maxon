// Test: promoted-record-reads-back-every-field
typealias Integer = int(i64.min to i64.max)

type Quad
	export var a as Integer
	export var b as Integer
	export var c as Integer
	export var d as Integer

	static function create(a Integer, b Integer, c Integer, d Integer) returns Self
		return Self{a: a, b: b, c: c, d: d}
	end 'create'
end 'Quad'

function main() returns ExitCode
	let q = Quad.create(1, b: 2, c: 4, d: 8)
	return q.a + q.b + q.c + q.d
end 'main'
---
ExitCode: 15
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 64
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 4
    x64.movRegImm32 rsi, 8
    x64.leaRegSlot rdi, slot0
    x64.storeBaseDispReg.word64 [rdi + 0], rax
    x64.storeBaseDispReg.word64 [rdi + 8], rcx
    x64.storeBaseDispReg.word64 [rdi + 16], rdx
    x64.storeBaseDispReg.word64 [rdi + 24], rsi
    x64.loadRegBaseDisp.word64 rax, [rdi + 0]
    x64.loadRegBaseDisp.word64 rcx, [rdi + 8]
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rdi + 16]
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rdi + 24]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 64
    x64.popReg rbp
    x64.ret
}
