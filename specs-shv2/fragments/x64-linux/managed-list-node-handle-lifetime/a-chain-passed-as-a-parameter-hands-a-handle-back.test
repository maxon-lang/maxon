// Test: a-chain-passed-as-a-parameter-hands-a-handle-back
typealias Small = int(0 to 255)
typealias IntChain = __ManagedList with Small
typealias IntNode = __ManagedListNode with Small

function appendTo(chain IntChain, value Small) returns IntNode
	return chain.insertLast(value)
end 'appendTo'

function main() returns ExitCode
	var chain = IntChain.create()
	let node = appendTo(chain, value: 55)
	return node.value()
end 'main'
---
ExitCode: 55
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @appendTo {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.callDirect __list_append
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 0
    x64.callDirect __list_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 55
    x64.movRegReg rcx, rbx
    x64.callDirect appendTo
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __list_node_value
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __list_node_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __list_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
