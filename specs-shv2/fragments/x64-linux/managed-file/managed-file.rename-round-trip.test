    x64.leaRegRdata rbx, [rip + __str_rec_3]  ; "test_managed_rename_src.txt"
    x64.leaRegRdata r12, [rip + __str_rec_4]  ; "test_managed_rename_dst.txt"
    x64.movRegReg rcx, rbx
