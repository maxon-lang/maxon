// Test: a-managed-field-handed-to-the-method-that-reassigns-it
typealias Count = int(0 to 1000)

type Cell
	export var s as String

	export static function create() returns Cell
		return Cell{s: ""}
	end 'create'

	export function fill(n Count)
		var t = ""
		for _ in 0 upto n 'grow'
			t = "{t}x"
		end 'grow'
		self.s = t
	end 'fill'

	// The callee reassigns the very field its own argument was read out of.
	export function replace(other String) returns String
		self.s = "replaced"
		return "[{other}]"
	end 'replace'
end 'Cell'

function main() returns ExitCode
	var a = Cell.create()
	a.fill(10)
	print("{a.replace(a.s)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Cell.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_6]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Cell.fill {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.storeSlotReg slot0, rcx
    x64.movRegReg rbx, rdx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 1000
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_12]
    x64.callDirect mrt_panic
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRdata rax, [rip + __str_rec_6]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, r14
  forhdr:
    x64.storeSlotReg slot2, rcx
    x64.storeSlotReg slot1, rax
    x64.cmpRegReg rax, rbx
    x64.jcc greaterEqual, forexit
  grow:
    x64.loadRegBaseDisp.word64 r12, [rcx + 0]
    x64.loadRegBaseDisp.word64 r13, [rcx + 8]
    x64.leaRegRdata rax, [rip + __str_rec_7]
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot5, rax
    x64.leaRegRegReg rax, r13, rax
    x64.storeSlotReg slot3, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot4, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r15, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.loadRegSlot r13, slot5
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot rax, slot4
    x64.storeBaseDispReg.word64 [rax + 0], r15
    x64.loadRegSlot rcx, slot3
    x64.storeBaseDispReg.word64 [rax + 8], rcx
    x64.movRegImm rcx, 18446744073709551613
    x64.storeBaseDispReg.word64 [rax + 16], rcx
    x64.movRegImm32 rcx, 1
    x64.storeBaseDispReg.word64 [rax + 24], rcx
    x64.loadRegSlot rcx, slot2
    x64.callDirect __str_decref
  forstep:
    x64.loadRegSlot rax, slot1
    x64.leaRegRegImm32 rax, rax, 1
    x64.loadRegSlot rcx, slot4
    x64.jmp forhdr
  forexit:
    x64.loadRegSlot rbx, slot0
    x64.loadRegBaseDisp.word64 r12, [rbx + 0]
    x64.loadRegSlot r13, slot2
    x64.movRegReg rcx, r13
    x64.callDirect __str_retain
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.storeBaseDispReg.word64 [rbx + 0], r14
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

