// Test: method-writing-a-string-or-set-field-is-not-a-conflict
typealias Integer = int(i64.min to i64.max)
typealias StringArray = Array with String
typealias IntSet = Set with Integer

type Bag
	export var items as StringArray
	export var name as String
	export var seen as IntSet

	static function create() returns Self
		return Self{items: StringArray.create(), name: "tag", seen: IntSet.create()}
	end 'create'

	function mark()
		name.append("!")
	end 'mark'

	function note(v Integer)
		seen.insert(v)
	end 'note'

	function seenCount() returns Integer
		return seen.count()
	end 'seenCount'
end 'Bag'

function main() returns ExitCode
	var b = Bag.create()
	b.items.push("alpha string long enough for heap allocation")
	let s = try b.items.get(0) otherwise ""
	b.mark()
	b.note(7)
	print("{s.byteLength()} {b.name} {b.seenCount()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata r12, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 0
    x64.callDirect __set_create
    x64.storeSlotReg slot0, r8
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.loadRegBaseDisp.word64 rbx, [r12 + 0]
    x64.loadRegBaseDisp.word64 r12, [r12 + 8]
    x64.leaRegRegImm32 rcx, r12, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r12
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r12
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.storeBaseDispReg.word64 [r13 + 8], r14
    x64.loadRegSlot rax, slot0
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.mark {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect __str_append
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Bag.note {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.leaRegRdata rax, [rip + __witness_int.Hashable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.callDirect __set_insert
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Bag.seenCount {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.callDirect __set_count
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

