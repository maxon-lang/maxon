// Test: a-string-field-store-is-not-a-conflict
typealias StringArray = Array with String

type Bag
	export var items as StringArray
	export var name as String

	export static function create() returns Self
		return Self { items: StringArray.create(), name: "tag" }
	end 'create'

	export function retag()
		name = "another tag entirely"
	end 'retag'
end 'Bag'

function rename(b Bag)
	b.name = "a third tag entirely"
end 'rename'

function main() returns ExitCode
	var b = Bag.create()
	b.items.push("alpha string long enough for heap allocation")
	let s = try b.items.get(0) otherwise ""
	b.retag()
	rename(b)
	print("{s.byteLength()} {b.name}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata r12, [rip + __str_rec_7]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 8], r8
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.retag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.storeBaseDispReg.word64 [rbx + 8], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @rename {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.callDirect __str_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.storeBaseDispReg.word64 [rbx + 8], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

