// Test: error.binding-match-multi-case

typealias Integer = int(i64.min to i64.max)

// Test matching on error binding with multiple cases
enum MyError implements Error
	failed
	timeout
	notFound
end 'MyError'

var counter = 0 as Integer

function mayFail(code Integer) returns Integer throws MyError
	counter = counter + 1
	if code == 1 'c1'
		throw MyError.failed
	end 'c1'
	if code == 2 'c2'
		throw MyError.timeout
	end 'c2'
	throw MyError.notFound
end 'mayFail'

function main() returns ExitCode
	var result = 0
	try mayFail(2) otherwise (e) 'handler'
		match e 'check'
			failed then result = 10
			timeout then result = 20
			notFound then result = 30
		end 'check'
	end 'handler'
	return result
end 'main'
---
ExitCode: 20
---
data {
  __data_counter@0 = i64 0
}

func @mayFail {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rdx, __data_counter
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, ifcont#2
  c1:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegImm32 rcx, 2
    x64.jcc notEqual, ifcont#4
  c2:
    x64.movRegImm32 r10, 2
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r10, 3
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 2
    x64.callDirect mayFail
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRegImm32 rax, r10, -1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#7
  matcharm#3:
    x64.movRegImm32 rax, 10
    x64.jmp matchcont
  matchnext#7:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchnext#8
  matcharm#4:
    x64.movRegImm32 rax, 20
    x64.jmp matchcont
  matchnext#8:
    x64.cmpRegImm32 rax, 2
    x64.jcc notEqual, matchdead
  matcharm#5:
    x64.movRegImm32 rax, 30
  matchcont:
    x64.movRegReg r8, rax
    x64.jmp trycont
  matchdead:
  tryok:
    x64.movRegReg r8, rbx
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
