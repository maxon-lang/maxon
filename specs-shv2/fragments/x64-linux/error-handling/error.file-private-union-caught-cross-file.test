// Test: error.file-private-union-caught-cross-file
// --- file: liberr.maxon
typealias Code = int(i64.min to i64.max)

// File-private (no `export`/`module`) error union: the catch site in another
// file only ever learns of this type through `risky`'s `throws` clause, so it
// is never seeded into the consumer file's type registry during pre-scan.
union LibErr implements Error
	bad(code Code)
end 'LibErr'

export function risky(n Code) returns Code throws LibErr
	if n > 5 'big'
		throw LibErr.bad(42)
	end 'big'
	return n
end 'risky'

// --- file: main.maxon
function main() returns ExitCode
	var result = 0
	try risky(9) otherwise (e) 'handler'
		match e 'check'
			bad(code) then result = code
		end 'check'
	end 'handler'
	return result
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @risky {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 5
    x64.jcc greater, big
    x64.jmp ifcont
  big:
    x64.movRegImm32 rbx, 42
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rax, r8
    x64.movRegImm32 rcx, 0
    x64.storeBaseDispReg.word64 [rax + 0], rcx
    x64.storeBaseDispReg.word64 [rax + 8], rbx
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rcx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 9
    x64.callDirect risky
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.loadRegBaseDisp.word64 rax, [r10 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.loadRegBaseDisp.word64 rbx, [r10 + 8]
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, r10
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.jmp trycont
  matchdead:
  tryok:
    x64.movRegReg r8, rbx
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
