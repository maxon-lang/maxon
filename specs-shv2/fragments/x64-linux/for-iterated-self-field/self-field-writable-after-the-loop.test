// Test: self-field-writable-after-the-loop
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

type Bag
	export var items as IntArray

	static function create() returns Self
		var a = IntArray.create()
		a.push(5)
		a.push(7)
		return Self{items: a}
	end 'create'

	function sumThenClear() returns Int
		var total = 0
		for it in items 'scan'
			total = total + it
		end 'scan'
		items.clear()
		return total + items.count()
	end 'sumThenClear'
end 'Bag'

function main() returns ExitCode
	let b = Bag.create()
	return b.sumThenClear() as ExitCode
end 'main'
---
ExitCode: 12
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.sumThenClear {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
  forhdr:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forexit
  scan:
    x64.loadRegBaseIndexScale.word64 rsi, [rax + rcx*8 + 0]
  __im_cont:
    x64.leaRegRegReg r12, r12, rsi
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect Array.clear
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.leaRegRegReg r8, r12, rax
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Bag.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.sumThenClear
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Bag
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
