// Test: i8-range-uses-i32-arithmetic
typealias Tiny = int(0 to 100)

function main() returns ExitCode
	let a = 21 as Tiny
	let b = 3 as Tiny
	return a / b
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 21
    x64.movRegImm32 rcx, 3
    x64.movRegImm32 rdx, 0
    x64.divReg rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at i8-range-uses-i32-arithmetic.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rax
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
