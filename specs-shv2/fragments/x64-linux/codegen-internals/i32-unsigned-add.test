// Test: i32-unsigned-add
typealias SmallInt = int(0 to 1000)

function main() returns ExitCode
	let a = 10 as SmallInt
	let b = 3 as SmallInt
	return a + b
end 'main'
---
ExitCode: 13
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 13
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
