// Test: f32-arithmetic-uses-ss-instructions
typealias F = float(f32.min to f32.max)

function main() returns ExitCode
	let a = 10.0 as F
	let b = 3.0 as F
	return trunc(a + b)
end 'main'
---
ExitCode: 13
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 13
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
