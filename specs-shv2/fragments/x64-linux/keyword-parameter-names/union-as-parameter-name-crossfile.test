module typealias StdType = int(i64.min to i64.max)

// --- file: api/helper.maxon
export function asis(union StdType) returns StdType
	return union
end 'asis'

// --- file: app/main.maxon
function main() returns ExitCode
	return asis(3)
end 'main'
---
ExitCode: 3
