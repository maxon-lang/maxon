// Test: a-reallocating-grow-is-visible-through-every-adoption
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let mm = try __ManagedMemory.create(2, elementSize: 1) otherwise return 1
	var a = ByteArray.init(mm)
	var b = ByteArray.init(mm)
	var i = 0
	while i < 200 'fill'
		a.push(1)
		i = i + 1
	end 'fill'
	if b.count() != 200 'notShared'
		return 2
	end 'notShared'
	let last = try b.get(199) otherwise return 3
	return (last + mm.length() - 200) as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_mem_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r14, 200
    x64.jcc less, fill
    x64.jmp whileexit
  fill:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 200
    x64.jcc notEqual, notShared
    x64.jmp ifcont
  notShared:
    x64.movRegImm32 r14, 2
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 199
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#9
    x64.jmp tryok#8
  tryerr#9:
    x64.movRegImm32 r14, 3
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#8:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.leaRegRegReg rax, r14, r8
    x64.leaRegRegImm32 r14, rax, -200
    x64.cmpRegImm32 r14, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r14, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
