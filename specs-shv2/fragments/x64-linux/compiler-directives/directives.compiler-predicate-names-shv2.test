// Test: directives.compiler-predicate-names-shv2
function main() returns ExitCode
	#if compiler(shv2)
		return 31
	#else
		return 32
	#endif
end 'main'
---
ExitCode: 31
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 31
    x64.popReg rbp
    x64.ret
}
