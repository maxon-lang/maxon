// Test: directives.compiler-unknown-name-is-false
function main() returns ExitCode
	#if compiler(gcc)
		return 1
	#else
		return 33
	#endif
end 'main'
---
ExitCode: 33
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 33
    x64.popReg rbp
    x64.ret
}
