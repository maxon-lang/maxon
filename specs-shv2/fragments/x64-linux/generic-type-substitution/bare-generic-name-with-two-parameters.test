// Test: bare-generic-name-with-two-parameters
typealias Integer = int(i64.min to i64.max)

type Slot uses Key, Value
	export var k as Key
	export var v as Value
	export static function make(k Key, v Value) returns Self
		return Self{k: k, v: v}
	end 'make'
	export function value() returns Value
		return self.v
	end 'value'
end 'Slot'

type Table uses Key, Value
	export var one as Slot
	export static function create(one Slot) returns Self
		return Self{one: one}
	end 'create'
	export function only() returns Slot
		return self.one
	end 'only'
end 'Table'

typealias IntSlot = Slot with (Integer, Integer)
typealias IntTable = Table with (Integer, Integer)

function main() returns ExitCode
	let t = IntTable.create(IntSlot.make(1, v: 5))
	return t.only().value() as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Slot.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Slot.value {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.leaRegRegImm32 rcx, rdx, 72
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Table.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Table.only {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 5
    x64.callDirect Slot.make
    x64.movRegReg rcx, r8
    x64.callDirect Table.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Table.only
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __layout_Slot_Integer_Integer]
    x64.movRegReg rcx, r12
    x64.callDirect Slot.value
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Table_Integer_Integer
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
