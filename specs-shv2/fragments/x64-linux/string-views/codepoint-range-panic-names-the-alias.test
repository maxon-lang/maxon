// Test: codepoint-range-panic-names-the-alias
function main() returns ExitCode
	let cp = utf16DecodeSurrogates(0, low: 0)
	return 7 if cp < 0 else 9
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.callDirect utf16DecodeSurrogates
    x64.cmpRegImm32 r8, 0
    x64.jcc greaterEqual, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 7
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 9
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
