// Test: bool.compare.equal
function main() returns ExitCode
	let a = true
	let b = true
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 0
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 1
    x64.callDirect bool.compare
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @bool.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, s
    x64.jmp critsplit#9
  s:
    x64.movRegImm32 rax, 1
    x64.jmp ifcont#2
  critsplit#9:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, o
    x64.jmp critsplit#10
  o:
    x64.movRegImm32 rcx, 1
    x64.jmp ifcont#4
  critsplit#10:
    x64.movRegReg rcx, rsi
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegReg rax, rcx
    x64.jcc less, lt
    x64.jmp ifcont#6
  lt:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.cmpRegReg rax, rcx
    x64.jcc greater, gt
    x64.jmp ifcont#8
  gt:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
