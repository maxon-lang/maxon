// Test: float.compare.nan-nan-equal
function main() returns ExitCode
	// Two NaNs from overflow (inf - inf), not division — see nan-less-than-normal.
	let infA = 1.0e308 * 10.0
	let a = infA - infA
	let infB = 1.0e308 * 10.0
	let b = infB - infB
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 0
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.subsdRegReg xmm0, xmm0, xmm0
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.movsdRegRip xmm2, [rip + __fconst_1]
    x64.mulsdRegReg xmm1, xmm1, xmm2
    x64.subsdRegReg xmm1, xmm1, xmm1
    x64.callDirect float.compare
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#5:
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchnext#6:
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}

func @float.compare {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.ucomisdRegReg xmm0, xmm0
    x64.jcc parity, self_nan
    x64.jmp fordered#11
  fordered#11:
    x64.jcc notEqual, self_nan
    x64.jmp ifcont#4
  self_nan:
    x64.ucomisdRegReg xmm1, xmm1
    x64.jcc parity, both_nan
    x64.jmp fordered#12
  fordered#12:
    x64.jcc notEqual, both_nan
    x64.jmp ifcont#3
  both_nan:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#3:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.ucomisdRegReg xmm1, xmm1
    x64.jcc parity, other_nan
    x64.jmp fordered#13
  fordered#13:
    x64.jcc notEqual, other_nan
    x64.jmp ifcont#6
  other_nan:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, lt
    x64.jmp ifcont#8
  lt:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, gt
    x64.jmp ifcont#10
  gt:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
