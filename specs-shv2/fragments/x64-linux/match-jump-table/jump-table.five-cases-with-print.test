// Test: jump-table.five-cases-with-print
enum Suit
		hearts
		diamonds
		clubs
		spades
		joker
end 'Suit'

function main() returns ExitCode
		let s = Suit.clubs
		match s 'check'
				hearts then print("hearts")
				diamonds then print("diamonds")
				clubs then print("clubs")
				spades then print("spades")
				joker then print("joker")
		end 'check'
		return 0
end 'main'
---
ExitCode: unpinned
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.jumpTable rax, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_10
  matchdead:
  matcharm#1:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#2:
    x64.leaRegRdata rcx, [rip + __str_rec_6]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#3:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#4:
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.callDirect print
    x64.jmp matchcont
  matcharm#5:
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.callDirect print
  matchcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
