// Test: folded-and-unfolded-agree-on-stderr
// --- stdlib-overlay: Builtins.maxon
export typealias WrittenBytes = int(0 to u64.max)

export function errFolded(text String) returns WrittenBytes
	return __Builtins.writeStderr(text.addressableBytes())
end 'errFolded'

export function errThroughABinding(text String) returns WrittenBytes
	let bytes = text.addressableBytes()
	return __Builtins.writeStderr(bytes)
end 'errThroughABinding'
// --- file: main.maxon
function main() returns ExitCode
	let a = errFolded("xy\n")
	let b = errThroughABinding("z\n")
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect errFolded
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect errThroughABinding
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
