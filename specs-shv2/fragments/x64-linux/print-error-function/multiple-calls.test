// Test: multiple-calls
function main() returns ExitCode
	printError("a\n")
	printError("b\n")
	printError("c\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect printError
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect printError
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect printError
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
