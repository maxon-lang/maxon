// Test: a-throwing-overload-set-whose-bare-name-another-directory-declares
// --- file: alpha/x.maxon
typealias Num = int(-1000 to 1000)

enum Boom
	bad
end 'Boom'

export function want(actual Num) returns Num throws Boom
	if actual < 0 'neg'
		throw Boom.bad
	end 'neg'
	return 5
end 'want'

export function want(actual bool) returns Num throws Boom
	if actual 'yes'
		throw Boom.bad
	end 'yes'
	return 9
end 'want'

// --- file: beta/y.maxon
typealias Small = int(-1000 to 1000)

export function want(actual Small) returns Small
	return actual + 1
end 'want'

// --- file: app/main.maxon
function main() returns ExitCode
	let a = try alpha.want(1) otherwise 0
	let b = try alpha.want(false) otherwise 0
	return (a + b + beta.want(3)) as ExitCode
end 'main'
---
ExitCode: 18
---
func @alpha.want {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, -1000
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at x.maxon:7: Range check failed: value outside typealias 'Num'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rcx, 0
    x64.jcc greaterEqual, ifcont
  neg:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 5
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @alpha.want#bool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ifcont
  yes:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 9
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect alpha.want
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
  trycont#3:
    x64.movRegImm32 rcx, 0
    x64.callDirect alpha.want#bool
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
  trycont#6:
    x64.leaRegRegReg rax, rbx, rax
  __rc_ok#12:
    x64.movRegImm32 rcx, 4
  __il_cont:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok#7
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
