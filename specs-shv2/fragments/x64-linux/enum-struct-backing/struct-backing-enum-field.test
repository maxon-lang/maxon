// Test: struct-backing-enum-field
typealias Cost = int(0 to 100)

enum Priority
	low
	medium
	high
end 'Priority'

type TaskInfo
	export let priority as Priority
	export let cost as Cost
end 'TaskInfo'

enum Task
	quick = TaskInfo{priority: Priority.low, cost: 1}
	normal = TaskInfo{priority: Priority.medium, cost: 5}
	heavy = TaskInfo{priority: Priority.high, cost: 10}
end 'Task'

function main() returns ExitCode
	let t = Task.heavy
	return t.rawValue.priority.ordinal
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
    x64.imulRegRegImm32 rcx, rcx, 0
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, rax
    x64.imulRegRegImm32 rax, rax, 2
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
