// Test: error.struct-backing-unknown-field
typealias Wide = int(0 to 100)

type Meta
	export let value as Wide
end 'Meta'

enum Task
	quick = Meta{bogus: 1}
end 'Task'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E3018: <fragment>:9:2: type 'Meta' has no field named 'bogus'
