// Test: subtract-order
function sub(a Integer, b Integer) returns Integer
	return a - b
end 'sub'

function main() returns ExitCode
	return sub(20, b: 8)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 12
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 r8, 12
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at subtract-order.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
