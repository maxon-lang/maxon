// Test: call-result-in-expression
function add(a int, b int) returns int
	return a + b
end 'add'

function main() returns ExitCode
	return add(2, b: 3) + add(10, b: 20) * 2
end 'main'
---
ExitCode: 65
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.jmp __il_body#6
  __il_body#6:
    x64.leaRegRegImm32 rax, rax, 3
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.movRegImm32 rcx, 10
    x64.jmp __il_body#7
  __il_body#7:
    x64.leaRegRegImm32 rcx, rcx, 20
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.imulRegRegImm32 rcx, rcx, 2
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
