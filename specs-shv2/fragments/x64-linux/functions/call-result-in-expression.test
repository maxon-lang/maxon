// Test: call-result-in-expression
function add(a int, b int) returns int
	return a + b
end 'add'

function main() returns ExitCode
	return add(2, b: 3) + add(10, b: 20) * 2
end 'main'
---
ExitCode: 65
---
func @add {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegReg r8, rcx, rdx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 3
    x64.callDirect add
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 20
    x64.callDirect add
    x64.imulRegRegImm32 rax, r8, 2
    x64.leaRegRegReg r8, rbx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
