// Test: value-live-across-call
function add(a int, b int) returns int
	return a + b
end 'add'

function compute(n int) returns int
	let y = add(n, b: 100)
	return n + y
end 'compute'

function main() returns ExitCode
	return compute(5)
end 'main'
---
ExitCode: 110
---
func @compute {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.jmp __il_body
  __il_body:
    x64.leaRegRegImm32 rax, rcx, 100
    x64.jmp __il_cont
  __il_cont:
    x64.leaRegRegReg r8, rcx, rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.callDirect compute
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
