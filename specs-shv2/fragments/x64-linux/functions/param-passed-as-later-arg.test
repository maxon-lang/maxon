// Test: param-passed-as-later-arg
function diff(x int, y int) returns int
	return x - y
end 'diff'

function combine(a int, b int, c int) returns int
	let r = diff(b, y: a)
	return r + c
end 'combine'

function main() returns ExitCode
	return combine(10, b: 20, c: 30)
end 'main'
---
ExitCode: 40
---
func @diff {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.subRegReg r8, rcx, rdx
    x64.popReg rbp
    x64.ret
}

func @combine {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rsi, rcx
    x64.movRegReg rbx, rax
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rsi
    x64.callDirect diff
    x64.leaRegRegReg r8, r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 20
    x64.movRegImm32 rax, 30
    x64.callDirect combine
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
