// Test: caller-line-single-file
function markHere(tag String, at SourceLineNumber = __line__) returns SourceLineNumber
	print("{tag}@{at}\n")
	return at
end 'markHere'

function main() returns ExitCode
	let n = markHere("single")
	return (n - 1) as ExitCode
end 'main'
