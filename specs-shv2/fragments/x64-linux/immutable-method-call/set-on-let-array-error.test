// Test: set-on-let-array-error

typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	let arr = IntArray.create()
	try arr.set(0, value: 99) otherwise panic("test invariant: set OOB")
	return 0
end 'main'
---
CompilerError:
error E3019: <fragment>:8:10: cannot pass 'arr' to function that mutates parameter 'self' (in main)
