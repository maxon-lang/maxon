    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect String.byteLength
    x64.cmpRegReg r13, r8
    x64.jcc notEqual, lenMismatch
    x64.jmp ifcont
  lenMismatch:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 r9, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r12
    x64.movRegReg rsi, r13
    x64.callDirect bytesEqual
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @bytesEqual {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.storeSlotReg slot2, rax
    x64.movRegReg r13, r9
    x64.movRegReg r14, rsi
    x64.movRegImm32 r15, 0
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot0, r15
    x64.cmpRegReg r15, r14
    x64.jcc less, compare_loop
    x64.jmp forexit
  compare_loop:
    x64.leaRegRegReg rdx, r12, r15
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteAt
    x64.storeSlotReg slot1, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.leaRegRegReg rdx, r13, r15
    x64.loadRegSlot rcx, slot2
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.loadRegSlot rax, slot1
    x64.cmpRegReg rax, r8
    x64.jcc notEqual, byte_check
    x64.jmp ifcont
  byte_check:
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r15, rax
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
