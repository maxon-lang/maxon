// Test: a-trivial-instantiation-of-the-same-nested-shape-still-clones
typealias Idx = int(0 to u64.max)
typealias Small = int(0 to 100)

type Bag uses Element
	typealias Inner = Array with Element
	typealias Outer = Array with Inner
	var rows as Outer

	export function addRow(r Inner)
		rows.push(r)
	end 'addRow'

	export function copyRows() returns Outer
		return rows.clone()
	end 'copyRows'

	export function count() returns Idx
		return rows.count()
	end 'count'

	static function create() returns Self
		return Self{rows: Outer{}}
	end 'create'
end 'Bag'

typealias SmallBag = Bag with Small
typealias Smalls = Array with Small

function main() returns ExitCode
	var b = SmallBag.create()
	var r = Smalls.create()
	r.push(41)
	b.addRow(r)
	let c = b.copyRows()
	print("{c.count()}\n")
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Bag.addRow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 r12, [rcx + 0]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.copyRows {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRdata rdx, [rip + __layout_Array_Bag.Inner]
    x64.callDirect Array.clone
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 88
    x64.callDirect Bag.create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.storeSlotReg slot1, r12
    x64.movRegImm32 rdx, 41
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.leaRegRdata rax, [rip + __layout_Bag_Small]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect Bag.addRow
    x64.leaRegRdata rdx, [rip + __layout_Bag_Small]
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.copyRows
    x64.storeSlotReg slot2, r8
    x64.movRegReg rcx, r8
    x64.callDirect __managed_count
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeSlotReg slot3, r12
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRegReg rax, rbx, r14
    x64.storeSlotReg slot4, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot5, r8
    x64.leaRegRegImm32 r15, r8, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r15, rbx
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r14
    x64.loadRegSlot rbx, slot5
    x64.storeBaseDispReg.word64 [rbx + 0], r15
    x64.loadRegSlot rax, slot4
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot3
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot2
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __destruct_Bag_Small
    x64.movRegReg r8, rbx
    x64.epilogue 88
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.clone {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r13
    x64.movRegReg r9, r12
    x64.callDirect __managed_slice_opaque
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
