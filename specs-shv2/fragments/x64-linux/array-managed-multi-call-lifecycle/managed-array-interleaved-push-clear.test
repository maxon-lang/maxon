func @clearFor {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __destruct_Dep]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.callDirect Array.createIterator
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, scan
    x64.jmp forexit
  scan:
    x64.leaRegRdata rdx, [rip + __layout_ArrayIterator_Dep]
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.current
    x64.movRegReg r14, r8
    x64.loadRegBaseDisp.word64 rax, [r14 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#7
    x64.jmp matchnext
  matcharm#7:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __managed_push
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Dep
    x64.jmp forstep
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#6
    x64.jmp matchdead
  matcharm#6:
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Dep
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r13
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  matchdead:
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_ArrayIterator_Dep
    x64.jmp forjoin
  forempty:
    x64.jmp forjoin
  forjoin:
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

