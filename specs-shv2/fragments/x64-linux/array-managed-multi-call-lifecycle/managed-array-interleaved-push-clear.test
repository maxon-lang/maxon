// Test: managed-array-interleaved-push-clear
export union Key
		file(path String)
		module
end 'Key'

type Dep
		export var source as Key
		export var target as Key

		static function create(source Key, target Key) returns Self
			return Self{source: source, target: target}
		end 'create'
end 'Dep'

typealias DepArray = Array with Dep

type State
		export var deps as DepArray

		static function create(deps DepArray) returns Self
			return Self{deps: deps}
		end 'create'
end 'State'

function record(state State, dep Dep)
		state.deps.push(dep)
end 'record'

function clearFor(state State)
		var kept = DepArray.create()
		for dep in state.deps 'scan'
				match dep.source 'check'
						module then continue
						file then kept.push(dep)
				end 'check'
		end 'scan'
		state.deps = kept
end 'clearFor'

function main() returns ExitCode
		var state = State.create(DepArray.create())

		record(state, dep: Dep.create(Key.file("x.maxon long enough for heap"), target: Key.module))
		clearFor(state)

		record(state, dep: Dep.create(Key.module, target: Key.file("y.maxon long enough for heap")))
		clearFor(state)

		record(state, dep: Dep.create(Key.module, target: Key.file("z.maxon long enough for heap")))
		clearFor(state)

		return state.deps.count()
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Dep.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Key
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Key
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

