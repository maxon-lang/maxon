    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_QueryKey
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_QueryKey
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

