  tryerr#13:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont#14
  tryok#12:
    x64.movRegReg rbx, r8
    x64.jmp trycont#14
  trycont#14:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#16
    x64.jmp tryok#15
  tryerr#16:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#17
  tryok#15:
    x64.movRegReg rax, r8
    x64.jmp trycont#17
  trycont#17:
    x64.storeSlotReg slot6, rax
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#19
    x64.jmp tryok#18
  tryerr#19:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#20
  tryok#18:
    x64.movRegReg rax, r8
    x64.jmp trycont#20
  trycont#20:
    x64.cmpRegImm32 r15, 1
    x64.movRegImm32 rcx, 0
    x64.jcc equal, andrhs#21
    x64.jmp critsplit#37
  andrhs#21:
    x64.cmpRegImm32 r12, 3
    x64.setccReg equal, rcx
    x64.jmp scmerge#22
  critsplit#37:
    x64.jmp scmerge#22
  scmerge#22:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs#23
    x64.jmp critsplit#38
  andrhs#23:
    x64.cmpRegImm32 r13, 5
    x64.setccReg equal, rcx
    x64.jmp scmerge#24
  critsplit#38:
    x64.movRegReg rcx, rdx
    x64.jmp scmerge#24
  scmerge#24:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs#25
    x64.jmp critsplit#39
  andrhs#25:
    x64.cmpRegImm32 rbx, 1
    x64.setccReg equal, rcx
    x64.jmp scmerge#26
  critsplit#39:
    x64.movRegReg rcx, rdx
    x64.jmp scmerge#26
  scmerge#26:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs#27
    x64.jmp critsplit#40
  andrhs#27:
    x64.loadRegSlot rcx, slot6
    x64.cmpRegImm32 rcx, 15
    x64.setccReg equal, rcx
    x64.jmp scmerge#28
  critsplit#40:
    x64.movRegReg rcx, rdx
    x64.jmp scmerge#28
  scmerge#28:
    x64.movRegImm32 rdx, 0
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, andrhs#29
    x64.jmp critsplit#41
  andrhs#29:
    x64.cmpRegImm32 rax, 2
    x64.setccReg equal, rax
    x64.jmp scmerge#30
  critsplit#41:
    x64.movRegReg rax, rdx
    x64.jmp scmerge#30
  scmerge#30:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rbx, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont
  matchcont:
    x64.loadRegSlot rcx, slot5
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot4
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot3
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot2
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __managed_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
