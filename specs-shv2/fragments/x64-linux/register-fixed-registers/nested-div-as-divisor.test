// Test: nested-div-as-divisor
function main() returns ExitCode
	let a = 1000
	let b = 84
	let c = 4
	let inner = b / c
	let r = a / inner
	if r == 47 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rcx, 1000
    x64.movRegImm32 rax, 84
    x64.movRegImm32 rsi, 4
    x64.cqo
    x64.idivReg rsi
    x64.movRegReg rsi, rax
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.cmpRegImm32 rax, 47
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.popReg rbp
    x64.ret
}
