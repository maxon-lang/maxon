// Test: div-result-crosses-a-call
function twice(x int) returns int
	return x + x
end 'twice'

function main() returns ExitCode
	let n = 1000
	let d = 7
	let q = n / d
	let t = twice(q)
	let r = q + t
	if r == 426 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegReg r8, rcx, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 1000
    x64.movRegImm32 rcx, 7
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg rbx, rax
    x64.movRegReg rcx, rbx
    x64.callDirect twice
    x64.leaRegRegReg rax, rbx, r8
    x64.cmpRegImm32 rax, 426
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
