// Test: round.halfway
function main() returns ExitCode
	let x = 2.5
	let y = trunc(round(x))
	return y
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.roundsdRegReg.nearestTiesToEven xmm0, xmm0
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
