// Test: round.a-declaration-takes-the-name-back
typealias Tally = int(0 to 1000)

function round(n Tally) returns Tally
	return n + 1
end 'round'

function main() returns ExitCode
	return round(10)
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_ok#6:
    x64.movRegImm32 r8, 11
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at round.a-declaration-takes-the-name-back.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
