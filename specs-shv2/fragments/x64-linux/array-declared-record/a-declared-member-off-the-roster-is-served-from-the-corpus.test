// Test: a-declared-member-off-the-roster-is-served-from-the-corpus
typealias Num = int(0 to 1000)

type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'

	export function at(i Num) returns Element
		return try managed.get(i) otherwise panic("at: the caller checked the bound")
	end 'at'
end 'Array'

typealias NumArray = Array with Num

function main() returns ExitCode
	var a = NumArray.create()
	a.push(17 as Num)
	a.push(25 as Num)
	return (a.at(0) + a.at(1)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Array.at {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 1000
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegBaseDisp.word64 rax, [rcx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load#12:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + rdx*8 + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegReg rdx, rax
    x64.jcc aboveEqual, __im_slow
  __im_load#13:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, critsplit#15
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __im_slow
  critsplit#16:
    x64.movRegReg rdx, rax
    x64.jmp __im_cont
  critsplit#15:
    x64.movRegReg rdx, rax
    x64.jmp __im_cont
  __im_slow:
    x64.callDirect __managed_get
    x64.movRegReg rdx, r8
    x64.movRegReg rsi, r10
  __im_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __retain_type_param
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 17
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 25
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.leaRegRdata rax, [rip + __layout_Array_Num]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.at
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __layout_Array_Num]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.at
    x64.leaRegRegReg r12, r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
