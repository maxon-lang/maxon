// Test: cmp-not-a-shifted-imm12
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(65535)
	if not (x == 65535) 'eqWord'
		return 31
	end 'eqWord'
	if x > 65535 'gtWord'
		return 32
	end 'gtWord'
	if not (x < 65536) 'ltNext'
		return 33
	end 'ltNext'
	let y = base(16777215)
	if not (y == 16777215) 'eqPairMax'
		return 34
	end 'eqPairMax'
	if not (y > 65535) 'gtWordFromPair'
		return 35
	end 'gtWordFromPair'
	if y == 16777214 'eqOffByOne'
		return 36
	end 'eqOffByOne'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegReg r8, rcx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 65535
    x64.callDirect base
    x64.cmpRegImm32 r8, 65535
    x64.setccReg equal, rax
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, eqWord
    x64.jmp ifcont
  eqWord:
    x64.movRegImm32 r8, 31
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 r8, 65535
    x64.jcc greater, gtWord
    x64.jmp ifcont
  gtWord:
    x64.movRegImm32 r8, 32
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 r8, 65536
    x64.setccReg less, rax
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ltNext
    x64.jmp ifcont
  ltNext:
    x64.movRegImm32 r8, 33
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rcx, 16777215
    x64.callDirect base
    x64.cmpRegImm32 r8, 16777215
    x64.setccReg equal, rax
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, eqPairMax
    x64.jmp ifcont
  eqPairMax:
    x64.movRegImm32 r8, 34
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 r8, 65535
    x64.setccReg greater, rax
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, gtWordFromPair
    x64.jmp ifcont
  gtWordFromPair:
    x64.movRegImm32 r8, 35
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.cmpRegImm32 r8, 16777214
    x64.jcc equal, eqOffByOne
    x64.jmp ifcont
  eqOffByOne:
    x64.movRegImm32 r8, 36
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
