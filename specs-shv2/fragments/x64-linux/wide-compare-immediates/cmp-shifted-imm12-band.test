// Test: cmp-shifted-imm12-band
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(16773120)
	if not (x == 16773120) 'eqTop'
		return 21
	end 'eqTop'
	if x > 16773120 'gtTop'
		return 22
	end 'gtTop'
	if not (x < 16777216) 'ltPair'
		return 23
	end 'ltPair'
	if x == 16777216 'eqPair'
		return 24
	end 'eqPair'
	let y = base(16777216)
	if not (y == 16777216) 'eqPairSelf'
		return 25
	end 'eqPairSelf'
	if not (y > 16773120) 'gtTopFromPair'
		return 26
	end 'gtTopFromPair'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont#13:
    x64.movRegImm32 rax, 1
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#4
  eqTop:
    x64.movRegImm32 r8, 21
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rax, 1
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_cont#15
  ltPair:
    x64.movRegImm32 r8, 23
    x64.popReg rbp
    x64.ret
  __il_cont#15:
    x64.movRegImm32 rax, 1
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#10
  eqPairSelf:
    x64.movRegImm32 r8, 25
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 rax, 1
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont#12
  gtTopFromPair:
    x64.movRegImm32 r8, 26
    x64.popReg rbp
    x64.ret
  ifcont#12:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
