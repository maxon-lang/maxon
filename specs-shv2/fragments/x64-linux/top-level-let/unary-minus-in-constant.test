// Test: unary-minus-in-constant
let NEGATIVE = -42

function main() returns ExitCode
	return 0 - NEGATIVE
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r8, rax, 42
    x64.popReg rbp
    x64.ret
}
