// Test: unary-minus-in-constant
let NEGATIVE = -42

function main() returns ExitCode
	return -NEGATIVE
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm r8, 18446744073709551574
    x64.negReg r8, r8
    x64.popReg rbp
    x64.ret
}
