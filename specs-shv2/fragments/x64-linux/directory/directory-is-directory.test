// Test: directory-is-directory
function main() returns ExitCode
	if Directory.isDirectory(FilePath from "../bin") 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __mrt_errno@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_17]  ; "../bin"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Directory.isDirectory
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
