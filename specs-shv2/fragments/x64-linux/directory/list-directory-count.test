// Test: list-directory-count
function main() returns ExitCode
	let files = try Directory.list(FilePath from "../bin") otherwise 'err'
		return 99
	end 'err'
	// bin directory has at least maxon.exe
	if files.count() >= 1 'ok'
		return 42
	end 'ok'
	return files.count()
end 'main'
---
ExitCode: 42
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __mrt_errno@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_18]  ; "../bin"
    x64.callDirect FilePath.init
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Directory.list
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc less, ifcont
  ok:
    x64.movRegImm32 rbx, 42
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rbx, [r12 + 8]
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_88]  ; "panic at list-directory-count.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
