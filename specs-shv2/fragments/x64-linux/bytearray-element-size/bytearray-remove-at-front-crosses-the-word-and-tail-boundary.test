// Test: bytearray-remove-at-front-crosses-the-word-and-tail-boundary
function main() returns ExitCode
	var bytes = b"abcdefghijklmnopqrstu"
	let gone = try bytes.remove(0) otherwise panic("test invariant: index 0 is in bounds")
	if gone != 97 'first'
		return 1
	end 'first'
	if bytes.count() != 20 'cnt'
		return 2
	end 'cnt'
	return 0 if String.from(bytes) == "bcdefghijklmnopqrstu" else 3
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __mm_free_lists@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 21
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegImm32 rdx, 0
    x64.leaRegRdata rax, [rip + __layout_Array_Byte]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.remove
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 97
    x64.jcc notEqual, first
    x64.jmp ifcont#4
  first:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 20
    x64.jcc notEqual, cnt
    x64.jmp ifcont#6
  cnt:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegReg rcx, rbx
    x64.callDirect String.from
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.movRegReg rcx, r12
    x64.callDirect __str_eq
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 3
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.remove {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __managed_remove
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.leaRegRegImm32 r10, rbx, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.from {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect scanSingleByteGraphemes
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __str_of_buffer
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @scanSingleByteGraphemes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r13, r12
    x64.jcc less, scan
    x64.jmp forexit
  scan:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.movRegImm32 rax, 1
    x64.jcc greaterEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.cmpRegImm32 r8, 13
    x64.setccReg equal, rax
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, notSingleByte
    x64.jmp ifcont
  notSingleByte:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
