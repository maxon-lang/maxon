    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rax
    x64.jmp trycont
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @widen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
