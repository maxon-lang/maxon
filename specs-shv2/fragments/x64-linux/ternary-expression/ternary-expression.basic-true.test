// Test: ternary-expression.basic-true
function main() returns ExitCode
	let x = 10 if true else 20
	return x
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}
