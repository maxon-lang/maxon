// Test: ternary-expression.nested-in-loop-body
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'l'
		let x = 5 if i > 0 else 9
		total = total + x
		i = i + 1
	end 'l'
	return total
end 'main'
---
ExitCode: 19
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, l
    x64.jmp whileexit
  l:
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 5
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rcx, 9
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegReg r8, r8, rcx
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
