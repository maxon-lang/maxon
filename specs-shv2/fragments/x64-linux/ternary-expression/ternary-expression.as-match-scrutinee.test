// Test: ternary-expression.as-match-scrutinee
function main() returns ExitCode
	let c = true
	match (1 if c else 2) 'm'
		1 then return 11
		default then return 22
	end 'm'
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont#3
  ternaryfalse:
    x64.movRegImm32 rax, 2
    x64.jmp matchcont#3
  matchcont#3:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 11
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 22
    x64.popReg rbp
    x64.ret
  matchcont#6:
}
