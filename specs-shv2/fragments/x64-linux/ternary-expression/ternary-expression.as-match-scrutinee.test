// Test: ternary-expression.as-match-scrutinee
function main() returns ExitCode
	let c = true
	match (1 if c else 2) 'm'
		1 then return 11
		default then return 22
	end 'm'
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  ternarytrue:
    x64.movRegImm32 rax, 1
  matchcont:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.movRegImm32 r8, 11
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 22
    x64.popReg rbp
    x64.ret
}
