// Test: ternary-expression.mixed-int-float-promotes
function main() returns ExitCode
	let c = true
	let x = 1.0 if c else 2
	return trunc(x)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rax, 2
    x64.cvtsi2sdRegReg xmm0, rax
    x64.jmp matchcont
  matchcont:
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
