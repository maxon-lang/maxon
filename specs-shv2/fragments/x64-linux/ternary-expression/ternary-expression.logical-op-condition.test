// Test: ternary-expression.logical-op-condition
type Flags
	export let a as bool
	export let b as bool

	export static function make(a bool, b bool) returns Flags
		return Flags{a: a, b: b}
	end 'make'
end 'Flags'

function pick(f Flags) returns ExitCode
	let either = f.a or f.b
	let both = f.a and f.b
	let one = 4 if either else 0
	let two = 1 if both else 0
	return (one + two) as ExitCode
end 'pick'

function main() returns ExitCode
	return pick(Flags.make(true, b: false))
end 'main'
---
ExitCode: 4
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Flags.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.byte [r8 + 0], rbx
    x64.storeBaseDispReg.byte [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.byte rax, [rcx + 0]
    x64.movRegImm32 rdx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.loadRegBaseDisp.byte rax, [rcx + 8]
    x64.movRegReg rdx, rax
    x64.jmp scmerge
  scmerge:
    x64.loadRegBaseDisp.byte rax, [rcx + 0]
    x64.movRegImm32 rsi, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.loadRegBaseDisp.byte rax, [rcx + 8]
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rsi
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 4
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rcx, 0
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rax, 0
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegReg r8, rcx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect Flags.make
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect pick
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
