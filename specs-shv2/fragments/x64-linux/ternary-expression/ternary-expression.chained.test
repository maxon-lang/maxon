// Test: ternary-expression.chained
function main() returns ExitCode
	let a = false
	let b = true
	let x = 1 if a else 2 if b else 3
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue#1
    x64.jmp ternaryfalse#2
  ternarytrue#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont#6
  ternaryfalse#2:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ternarytrue#3
    x64.jmp ternaryfalse#4
  ternarytrue#3:
    x64.movRegImm32 rax, 2
    x64.jmp matchcont#5
  ternaryfalse#4:
    x64.movRegImm32 rax, 3
    x64.jmp matchcont#5
  matchcont#5:
    x64.movRegReg r8, rax
    x64.jmp matchcont#6
  matchcont#6:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
