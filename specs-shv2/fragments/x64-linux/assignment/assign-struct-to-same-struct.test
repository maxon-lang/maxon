// Test: assign-struct-to-same-struct

typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function makePoint(v Integer) returns Point
	return Point.create(v, y: v)
end 'makePoint'

function main() returns ExitCode
	var p = Point.create(1, y: 2)
	p = makePoint(7)
	p.x = 9
	let q = Point.create(5, y: 5)
	p = q
	return p.x as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Point.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @makePoint {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg rax, rcx
    x64.movRegReg rcx, rax
    x64.movRegReg rdx, rax
    x64.callDirect Point.create
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 56
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.movRegImm32 rcx, 7
    x64.callDirect makePoint
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 9
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 5
    x64.callDirect Point.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.loadRegBaseDisp.word64 rbx, [r13 + 0]
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at assign-struct-to-same-struct.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
