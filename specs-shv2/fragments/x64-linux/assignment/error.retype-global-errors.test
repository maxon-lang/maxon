// Test: error.retype-global-errors

typealias Integer = int(i64.min to i64.max)

var g = 0 as Integer

function main() returns ExitCode
	g = "hello"
	print("{g}")
	return 0 as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:8:2: cannot assign a value of type 'String' to global 'g', which holds 'int'
