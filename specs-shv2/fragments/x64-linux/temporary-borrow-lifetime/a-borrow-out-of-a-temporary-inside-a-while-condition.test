// Test: a-borrow-out-of-a-temporary-inside-a-while-condition
typealias Wide = int(i64.min to i64.max)
typealias Bytes = Array with ByteArray

function make() returns Bytes
	var outer = Bytes.create()
	var inner = ByteArray.create()
	inner.push(1)
	inner.push(2)
	inner.push(3)
	outer.push(inner)
	return outer
end 'make'

function main() returns ExitCode
	var n = 0 as Wide
	while n < (try make().get(0) otherwise ByteArray.create()).count() * 100 'loop'
		n = n + 1
	end 'loop'
	return n / 100
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_push
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
  whilehdr:
    x64.callDirect make
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r12 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#14
  __im_empty:
    x64.cmpRegImm32 r13, 0
    x64.jcc notEqual, critsplit#15
  __im_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.movRegReg r13, r8
    x64.jmp __im_cont
  critsplit#15:
    x64.movRegReg r10, rax
    x64.jmp __im_cont
  critsplit#14:
    x64.movRegReg r10, rax
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rcx, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r13
  trycont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.imulRegRegImm32 rax, rax, 100
    x64.cmpRegReg rbx, rax
    x64.setccReg less, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc equal, whileexit
  loop:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm rax, 11805916207174113035
    x64.imulHighReg rbx
    x64.leaRegRegReg rax, rdx, rbx
    x64.sarRegImm8 rax, rax, 6
    x64.movRegReg rcx, rax
    x64.shrRegImm8 rcx, rax, 63
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-borrow-out-of-a-temporary-inside-a-while-condition.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
