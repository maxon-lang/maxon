// Test: two-borrows-out-of-two-temporaries-in-one-statement
typealias Wide = int(i64.min to i64.max)
typealias Bytes = Array with ByteArray

function make(n Wide) returns Bytes
	var outer = Bytes.create()
	var inner = ByteArray.create()
	for _ in 0 upto n 'fill'
		inner.push(1)
	end 'fill'
	outer.push(inner)
	return outer
end 'make'

function main() returns ExitCode
	let a = try make(2).get(0) otherwise ByteArray.create()
	let b = try make(3).get(0) otherwise ByteArray.create()
	return a.count() + b.count()
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r14, rbx
    x64.jcc less, fill
    x64.jmp forexit
  fill:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 2
    x64.callDirect make
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rcx, 3
    x64.callDirect make
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r14, r8
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.jmp trycont#6
  trycont#6:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_count
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_count
    x64.leaRegRegReg r15, r15, r8
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r15, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r15, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r15
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
