// Test: two-borrows-out-of-two-temporaries-in-one-statement
typealias Wide = int(i64.min to i64.max)
typealias Bytes = Array with ByteArray

function make(n Wide) returns Bytes
	var outer = Bytes.create()
	var inner = ByteArray.create()
	for _ in 0 upto n 'fill'
		inner.push(1)
	end 'fill'
	outer.push(inner)
	return outer
end 'make'

function main() returns ExitCode
	let a = try make(2).get(0) otherwise ByteArray.create()
	let b = try make(3).get(0) otherwise ByteArray.create()
	return a.count() + b.count()
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __managed_decref]
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
  forhdr:
    x64.cmpRegReg r14, rbx
    x64.jcc greaterEqual, forexit
  fill:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __managed_push
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.callDirect make
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#11
  __im_load#12:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [rbx + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#18
  __im_empty#13:
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, critsplit#19
  __im_slow#11:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg r12, r8
    x64.jmp __im_cont#10
  critsplit#19:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#10
  critsplit#18:
    x64.movRegReg r10, rax
  __im_cont#10:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rcx, r12
    x64.callDirect __mm_incref
  trycont#3:
    x64.movRegImm32 rcx, 3
    x64.callDirect make
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow#15
  __im_load#16:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r13 + 40]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, critsplit#20
  __im_empty#17:
    x64.cmpRegImm32 r14, 0
    x64.jcc notEqual, critsplit#21
  __im_slow#15:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.movRegReg r14, r8
    x64.jmp __im_cont#14
  critsplit#21:
    x64.movRegReg r10, rax
    x64.jmp __im_cont#14
  critsplit#20:
    x64.movRegReg r10, rax
  __im_cont#14:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#4
  tryerr#5:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rcx, r8
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_incref
    x64.movRegReg rcx, r14
  trycont#6:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.leaRegRegReg r14, rax, rdx
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r14, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r14, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
