// Test: mutate-twice
typealias Integer = int(i64.min to i64.max)

union Cell
	empty
	holding(value Integer)
end 'Cell'

function main() returns ExitCode
	var c = Cell.holding(10)
	match c 'first'
		holding(value) then value = 20
		empty then return 0
	end 'first'
	match c 'second'
		holding(value) then value = value + 22
		empty then return 0
	end 'second'
	match c 'read'
		holding(value) then return value
		empty then return 0
	end 'read'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 10
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#4
  matcharm#2:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#4:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#3
  matcharm#1:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.movRegImm32 rax, 20
    x64.storeBaseDispReg.word64 [r8 + 8], rax
  matchcont#5:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#9
  matcharm#7:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#9:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#8
  matcharm#6:
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.leaRegRegImm32 rax, rax, 22
    x64.storeBaseDispReg.word64 [r8 + 8], rax
  matchcont#10:
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext#14
  matcharm#12:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext#14:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead#13
  matcharm#11:
    x64.loadRegBaseDisp.word64 rbx, [r8 + 8]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead#13:
  matchdead#8:
  matchdead#3:
  matchcont#15:
}
