// Test: a-sibling-arm-does-not-supply-the-value
typealias Word = int(i64.min to i64.max)

function branchy(x Word, y Word) returns Word
	var out = 0
	if y > 0 'positive'
		out = (x * 31 + y) * 2
	end 'positive' else 'negative'
		out = (x * 31 + y) * 3
	end 'negative'
	return out
end 'branchy'

function main() returns ExitCode
	var seed = 0
	for i in 0 upto 4 'feed'
		seed = seed + branchy(i, y: i - 2)
	end 'feed'
	if seed != 458 'wrongSum'
		return 1
	end 'wrongSum'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  forhdr:
    x64.cmpRegImm32 rcx, 4
    x64.jcc greaterEqual, forexit
  feed:
    x64.leaRegRegImm32 rdx, rcx, -2
  __il_body:
    x64.cmpRegImm32 rdx, 0
    x64.jcc lessEqual, ifelse
  positive:
    x64.imulRegRegImm32 rsi, rcx, 31
    x64.leaRegRegReg rdx, rsi, rdx
    x64.imulRegRegImm32 rdx, rdx, 2
    x64.jmp __il_cont
  ifelse:
    x64.imulRegRegImm32 rsi, rcx, 31
    x64.leaRegRegReg rdx, rsi, rdx
    x64.imulRegRegImm32 rdx, rdx, 3
  __il_cont:
    x64.leaRegRegReg rax, rax, rdx
  forstep:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rax, 458
    x64.jcc equal, ifcont
  wrongSum:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
