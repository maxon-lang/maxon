  __im_viewed#40:
    x64.leaRegRegImm32 rcx, rax, -24
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __im_slow#28
  __im_store#41:
