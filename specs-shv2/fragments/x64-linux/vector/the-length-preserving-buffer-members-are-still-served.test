  __im_slow#28:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r8
    x64.callDirect __managed_mem_set
    x64.movRegReg rax, r10
  __im_cont#27:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, trycont#17
  trycont#17:
    x64.loadRegBaseDisp.word64 r12, [rbx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_capacity
    x64.leaRegRegReg r8, r12, r8
    x64.epilogue 40
