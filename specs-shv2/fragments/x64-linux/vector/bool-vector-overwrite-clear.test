// Test: bool-vector-overwrite-clear
typealias Bits8 = Vector with 8 bool

function main() returns ExitCode
	var v = Bits8.create()
	try v.set(2, value: true) otherwise panic("test invariant: set OOB")
	try v.set(5, value: true) otherwise panic("test invariant: set OOB")
	try v.set(2, value: false) otherwise panic("test invariant: set OOB")
	let a = try v.get(2) otherwise true
	let b = try v.get(5) otherwise false
	var r = 0
	if not a 'cleared'
		r = r + 1
	end 'cleared'
	if b 'stillSet'
		r = r + 10
	end 'stillSet'
	return r
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rdx, 8
    x64.callDirect Vector.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at bool-vector-overwrite-clear.test:6: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 5
    x64.movRegImm32 rax, 1
    x64.leaRegRdata r9, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at bool-vector-overwrite-clear.test:7: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rdx, 2
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Vector_N8_bool]
    x64.movRegImm32 rsi, 8
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.set
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at bool-vector-overwrite-clear.test:8: test invariant: set OOB\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.movRegImm32 rdx, 2
    x64.leaRegRdata rax, [rip + __layout_Vector_N8_bool]
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#7
  tryerr#8:
    x64.movRegImm32 r12, 1
    x64.jmp trycont#9
  tryok#7:
    x64.movRegReg r12, r8
  trycont#9:
    x64.movRegImm32 rdx, 5
    x64.leaRegRdata rax, [rip + __layout_Vector_N8_bool]
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#10
  tryerr#11:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#12
  tryok#10:
    x64.movRegReg rax, r8
  trycont#12:
    x64.movRegImm32 rcx, 0
    x64.xorRegImm32 r12, r12, 1
    x64.cmpRegImm32 r12, 0
    x64.jcc equal, ifcont#14
  cleared:
    x64.movRegImm32 rcx, 1
  ifcont#14:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
  stillSet:
    x64.leaRegRegImm32 r12, rcx, 10
    x64.jmp ifcont#16
  critsplit:
    x64.movRegReg r12, rcx
  ifcont#16:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at bool-vector-overwrite-clear.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
