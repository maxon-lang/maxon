    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.createIterator
    x64.movRegReg r15, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, forjoin
  forhdr#1:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, forexit#5
  eachOwn:
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.callDirect ArrayIterator.current
    x64.movRegReg rax, r8
    x64.subRegReg rax, r8, r8
    x64.leaRegRegReg rax, r14, rax
    x64.leaRegRegImm32 r14, rax, 1
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __drop_type_param
  forstep#4:
    x64.movRegReg rcx, r15
    x64.callDirect ArrayIterator.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr#1
  forexit#5:
    x64.movRegReg rcx, r15
    x64.callDirect __destruct_ArrayIterator_T4b39db24a89d29c9
  forjoin:
    x64.movRegImm32 r15, 0
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r13
    x64.movRegReg r9, r12
    x64.callDirect __managed_slice_opaque
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at an-extension-still-walks-its-own-vector.test:13: slice\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r12, 0
  forhdr#9:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r12, rax
    x64.jcc greaterEqual, forexit#12
  eachSliced:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r12*8 + 0]
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r12
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
  __im_cont:
