// Test: a-default-on-the-static-half-of-a-same-name-pair
typealias Num = int(i64.min to i64.max)

type T
	export var v as Num

	export static function make(v Num) returns T
		return Self{v: v}
	end 'make'

	export function m(b Num) returns Num
		return self.v + b
	end 'm'

	export static function m(a Num = 7) returns Num
		return a
	end 'm'
end 'T'

function main() returns ExitCode
	let t = T.make(1)
	return (T.m() + t.m(2)) as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 1
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegImm32 rax, rax, 2
  __il_cont:
    x64.leaRegRegImm32 r8, rax, 7
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
