// Test: short-circuit-in-while-condition
var trace = 0

function check() returns bool
	trace = trace + 1
	return trace < 3
end 'check'

function alwaysFalse() returns bool
	trace = trace + 100
	return false
end 'alwaysFalse'

function main() returns ExitCode
	while check() and alwaysFalse() 'loop'
		return 99
	end 'loop'
	return trace
end 'main'
---
ExitCode: 101
---
data {
  __data_trace@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp whilehdr
  whilehdr:
    x64.jmp __il_body#10
  __il_body#10:
    x64.leaRegGlobal rax, __data_trace
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_trace
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_trace
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.cmpRegImm32 rax, 3
    x64.setccReg less, rax
    x64.jmp __il_cont#9
  __il_cont#9:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.jmp __il_body#12
  __il_body#12:
    x64.leaRegGlobal rax, __data_trace
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegGlobal rcx, __data_trace
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont#11
  __il_cont#11:
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, loop
    x64.jmp whileexit
  loop:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  whileexit:
    x64.leaRegGlobal rax, __data_trace
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
