// Test: nested-short-circuit
var calls = 0

function a() returns bool
	calls = calls + 1
	return true
end 'a'

function b() returns bool
	calls = calls + 10
	return false
end 'b'

function c() returns bool
	calls = calls + 100
	return true
end 'c'

function main() returns ExitCode
	let inner = b() or c()
	let result = a() and inner
	if result 'r'
		return calls as ExitCode
	end 'r'
	return 99
end 'main'
---
ExitCode: 111
---
data {
  __data_calls@0 = i64 0
}

func @a {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_calls
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @b {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 10
    x64.leaRegGlobal rcx, __data_calls
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @c {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 100
    x64.leaRegGlobal rcx, __data_calls
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect b
    x64.movRegImm32 rbx, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, critsplit#10
    x64.jmp orrhs
  critsplit#10:
    x64.jmp scmerge#2
  orrhs:
    x64.callDirect c
    x64.movRegReg rbx, r8
    x64.jmp scmerge#2
  scmerge#2:
    x64.callDirect a
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit#11
  andrhs:
    x64.movRegReg rax, rbx
    x64.jmp scmerge#4
  critsplit#11:
    x64.jmp scmerge#4
  scmerge#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, r
    x64.jmp ifcont
  r:
    x64.leaRegGlobal rax, __data_calls
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
