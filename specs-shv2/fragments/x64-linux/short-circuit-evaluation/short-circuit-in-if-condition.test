// Test: short-circuit-in-if-condition
typealias Integer = int(0 to u64.max)

var trace = 0 as Integer

function setFlag(bit Integer) returns bool
	trace = trace or bit
	return false
end 'setFlag'

function main() returns ExitCode
	if setFlag(1) and setFlag(2) 'never'
		return 99
	end 'never'
	return trace as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __data_trace@0 = i64 0
}

func @setFlag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_trace
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.orRegReg rax, rax, rcx
    x64.leaRegGlobal rcx, __data_trace
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect setFlag
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegImm32 rcx, 2
    x64.callDirect setFlag
    x64.jmp scmerge
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, never
    x64.jmp ifcont
  never:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegGlobal rax, __data_trace
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
