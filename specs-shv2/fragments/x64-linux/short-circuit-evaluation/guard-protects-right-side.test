// Test: guard-protects-right-side
typealias Index = int(0 to u64.max)

function main() returns ExitCode
	let arr = [10 as Index, 20 as Index, 30 as Index]
	let i = 5 as Index

	if i < arr.count() and (try arr.get(i) otherwise 0 as Index) > 0 'check'
		return 1
	end 'check'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 3
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegImm32 rdx, 5
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 5
    x64.movRegImm32 rax, 0
    x64.jcc lessEqual, scmerge
  __rc_ok:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 5
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 40
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#15
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#16
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#16:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont
  critsplit#15:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.cmpRegImm32 rax, 0
    x64.setccReg above, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 42
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
