// Test: and-chain-short-circuits-on-first-false
var sideEffectCount = 0

function trackAndReturn(result bool) returns bool
	sideEffectCount = sideEffectCount + 1
	return result
end 'trackAndReturn'

function main() returns ExitCode
	let result = trackAndReturn(true) and trackAndReturn(false) and trackAndReturn(true)
	if result 'r'
		return 99
	end 'r'
	return sideEffectCount
end 'main'
---
ExitCode: 2
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body#11:
    x64.leaRegGlobal rax, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rcx + 0], rax
  andrhs#1:
    x64.movRegImm32 rax, 0
  __il_body#13:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
  scmerge#2:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, critsplit
  andrhs#3:
    x64.movRegImm32 rax, 1
  __il_body#15:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.jmp scmerge#4
  critsplit:
    x64.movRegReg rax, rcx
  scmerge#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  r:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegGlobal rax, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
