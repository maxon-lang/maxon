// Test: duplicate-block-identifiers.different-blocks
function main() returns ExitCode
	var x = 0
	if true 'outer'
		x = 1
	end 'outer'
	
	if true 'inner'
		x = 2
	end 'inner'
	
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, outer
    x64.jmp critsplit
  outer:
    x64.movRegImm32 rax, 1
    x64.jmp ifcont
  critsplit:
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, inner
    x64.jmp critsplit
  inner:
    x64.movRegImm32 r8, 2
    x64.jmp ifcont
  critsplit:
    x64.movRegReg r8, rax
    x64.jmp ifcont
  ifcont:
    x64.popReg rbp
    x64.ret
}
