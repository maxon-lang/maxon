// Test: duplicate-block-identifiers.multiple-nested
function main() returns ExitCode
	var x = 0
	if true 'outer'
		x = 1
		while true 'inner'
			x = 2
			break
		end 'inner'
	end 'outer'
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, outer
    x64.jmp critsplit#9
  outer:
    x64.movRegImm32 rax, 1
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, inner
    x64.jmp critsplit#10
  inner:
    x64.movRegImm32 rax, 2
    x64.jmp whileexit
  critsplit#10:
    x64.jmp whileexit
  whileexit:
    x64.movRegReg r8, rax
    x64.jmp ifcont
  critsplit#9:
    x64.jmp ifcont
  ifcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
