// Test: boxed-union-field-throw-owned-local
typealias N = int(0 to i64.max)

union OuterErr implements Error
	unterminatedString(line N, column N)
	unexpectedEof(line N, column N)
end 'OuterErr'

type Holder
	export var pending as OuterErr

	static function create() returns Holder
		return Self{pending: OuterErr.unterminatedString(7, column: 13)}
	end 'create'
end 'Holder'

function process() returns N throws OuterErr
	var h = Holder.create()
	throw h.pending
end 'process'

function main() returns ExitCode
	let v = try process() otherwise (e) 'fail'
		match e 'kind'
			unterminatedString(line, column) then return (line + column)
			unexpectedEof(line, column) then return (line + column + 100)
		end 'kind'
	end 'fail'
	return (v + 200)
end 'main'
---
ExitCode: 20
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 7
    x64.movRegImm32 r12, 13
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.storeBaseDispReg.word64 [r13 + 16], r12
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @process {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect Holder.create
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_Holder
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect process
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.loadRegBaseDisp.word64 rax, [r10 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.loadRegBaseDisp.word64 rax, [r10 + 8]
    x64.loadRegBaseDisp.word64 rcx, [r10 + 16]
    x64.leaRegRegReg rbx, rax, rcx
    x64.movRegReg rcx, r10
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchdead
  matcharm:
    x64.loadRegBaseDisp.word64 rax, [r10 + 8]
    x64.loadRegBaseDisp.word64 rcx, [r10 + 16]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegRegImm32 rbx, rax, 100
    x64.movRegReg rcx, r10
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
  tryok:
    x64.leaRegRegImm32 r8, r8, 200
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchcont:
}
