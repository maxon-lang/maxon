// Test: enum-exhaustive.expression
enum Status
		pending
		approved
		rejected
end 'Status'

function main() returns ExitCode
	let s = Status.approved
	let code = match s 'eval'
		pending gives 0
		approved to rejected gives 1
	end 'eval'
	return code
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 2
    x64.setccReg lessEqual, rax
    x64.andRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
