// Test: enum-exhaustive.int-backed-range-excludes-outside-case
enum Level
	low = 10
	medium = 20
	high = 30
end 'Level'

function classify(l Level) returns ExitCode
	let r = match l 'm'
		low to medium gives 41
		high gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Level.high)
end 'main'
---
ExitCode: 42
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 10
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 20
    x64.setccReg lessEqual, rdx
    x64.andRegReg rax, rax, rdx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 41
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 30
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 42
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 30
    x64.callDirect classify
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
