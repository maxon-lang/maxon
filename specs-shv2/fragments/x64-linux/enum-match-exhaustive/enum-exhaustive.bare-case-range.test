// Test: enum-exhaustive.bare-case-range
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.high
	match p 'check'
		low to medium then return 1
		high to critical then return 2
	end 'check'
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.cmpRegImm32 rax, 0
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 1
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 3
    x64.setccReg lessEqual, rax
    x64.andRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matchdead:
  matchcont:
}
