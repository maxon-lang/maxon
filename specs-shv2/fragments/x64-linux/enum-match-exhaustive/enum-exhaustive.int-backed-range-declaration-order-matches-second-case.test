// Test: enum-exhaustive.int-backed-range-declaration-order-matches-second-case
enum Code
	ok = 500
	notFound = 200
	serverError = 404
end 'Code'

function classify(c Code) returns ExitCode
	let r = match c 'm'
		ok to notFound gives 41
		serverError gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Code.notFound)
end 'main'
---
ExitCode: 41
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 200
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#4
  matchnext#4:
    x64.cmpRegImm32 rcx, 404
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#5
  matcharm#2:
    x64.movRegImm32 r8, 42
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rcx, 500
    x64.jcc equal, matcharm#1
    x64.jmp matchdead
  matcharm#1:
    x64.movRegImm32 r8, 41
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 200
    x64.callDirect classify
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
