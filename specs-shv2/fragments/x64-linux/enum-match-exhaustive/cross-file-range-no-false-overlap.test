// Test: cross-file-range-no-false-overlap
// --- file: ops.maxon
export union WideOp
	call
	ret
	param
	extra
end 'WideOp'

export union NarrowOp
	ret
	call
	param
end 'NarrowOp'

// --- file: main.maxon
typealias Code = int(0 to 125)

function classify(op NarrowOp) returns Code
	return match op 'check'
		ret gives 1
		call to param gives 2
	end 'check'
end 'classify'

function describeWide(op WideOp) returns Code
	return match op 'check'
		call to extra gives 9
	end 'check'
end 'describeWide'

function main() returns ExitCode
	let narrow = classify(NarrowOp.call)
	let wide = describeWide(WideOp.ret)
	if wide == 9 'wideOk'
		return narrow
	end 'wideOk'
	return 99
end 'main'
---
ExitCode: 2
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 2
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 125
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @describeWide {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.setccReg greaterEqual, rax
    x64.cmpRegImm32 rcx, 3
    x64.setccReg lessEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matcharm
    x64.jmp matchdead
  matcharm:
    x64.movRegImm32 r8, 9
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 125
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect classify
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect describeWide
    x64.cmpRegImm32 r8, 9
    x64.jcc equal, wideOk
    x64.jmp ifcont
  wideOk:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 99
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
