// Test: contains-on-a-generic-conformer
typealias Int = int(i64.min to i64.max)

type BagIter uses Element implements Iterator with Element
	var slot as Element

	export static function create(v Element) returns Self
		return Self{slot: v}
	end 'create'

	export function current() returns Element
		return slot
	end 'current'

	export function advance() throws IterationError
		throw IterationError.exhausted
	end 'advance'
end 'BagIter'

type Bag uses Element implements Iterable with (Element, BagIter)
	var slot as Element

	export static function create(v Element) returns Self
		return Self{slot: v}
	end 'create'

	export function createIterator() returns BagIter throws IterationError
		return BagIter.create(slot)
	end 'createIterator'
end 'Bag'

typealias IntBag = Bag with Int

function isBig(n Int) returns bool
	return n > 10
end 'isBig'

function main() returns ExitCode
	var b = IntBag.create(30)
	if b.contains(isBig) 'yes'
		return 1
	end 'yes'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @BagIter.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @BagIter.current {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @BagIter.advance {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @Bag.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.createIterator {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect BagIter.create
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @isBig {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 10
    x64.setccReg greater, r8
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 30
    x64.callDirect Bag.create
    x64.movRegReg rbx, r8
    x64.leaRegFunc rdx, [rip + __fnref_isBig]
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Bag_Int]
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, yes
    x64.jmp ifcont
  yes:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Bag.contains {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.movRegReg r13, r9
    x64.movRegReg rdx, r13
    x64.callDirect Bag.createIterator
    x64.movRegReg r14, r8
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, critsplit
    x64.jmp forempty
  critsplit:
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, loop
    x64.jmp forexit
  loop:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r13
    x64.callDirect BagIter.current
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.callReg rbx
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, match
    x64.jmp ifcont
  match:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.callDirect __drop_type_param
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r15
    x64.callDirect __drop_type_param
    x64.jmp forstep
  forstep:
    x64.movRegReg rcx, r14
    x64.callDirect BagIter.advance
    x64.movRegReg rax, r10
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r14
    x64.callDirect __mm_decref
    x64.jmp forjoin
  forempty:
    x64.jmp forjoin
  forjoin:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
