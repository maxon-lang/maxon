// Test: nested-control
function main() returns ExitCode
	var result = 0
	var i = 0
	while i < 3 'outer'
		var j = 0
		while j < 3 'inner'
			if (i + j) mod 2 == 0 'even'
				result = result + 1
			end 'even'
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return result
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr#1
  whilehdr#1:
    x64.cmpRegImm32 rcx, 3
    x64.jcc less, outer
    x64.jmp whileexit#3
  outer:
    x64.movRegImm32 rsi, 0
    x64.jmp whilehdr#4
  whilehdr#4:
    x64.cmpRegImm32 rsi, 3
    x64.jcc less, inner
    x64.jmp whileexit#6
  inner:
    x64.leaRegRegReg rax, rcx, rsi
    x64.movRegImm32 rdi, 2
    x64.cqo
    x64.idivReg rdi
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, even
    x64.jmp critsplit
  even:
    x64.leaRegRegImm32 rax, r8, 1
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rax, r8
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 rsi, rsi, 1
    x64.movRegReg r8, rax
    x64.jmp whilehdr#4
  whileexit#6:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
