// Test: while-loops.loop-reads-a-var-it-never-assigns
function main() returns ExitCode
	var limit = 6
	var i = 0
	var acc = 0
	while i < limit 'l'
		acc = acc + limit
		i = i + 1
	end 'l'
	return acc
end 'main'
---
ExitCode: 36
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.movRegImm32 r8, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 6
    x64.jcc less, l
    x64.jmp whileexit
  l:
    x64.leaRegRegImm32 r8, r8, 6
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
}
