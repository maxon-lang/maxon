// Test: while-loops.loop-carried-var-narrower-than-its-update
function firstExit() returns ExitCode
	return 0
end 'firstExit'

function pick() returns ExitCode
	var r = firstExit()
	var i = 0
	while i < 3 'lp'
		r = i
		i = i + 1
	end 'lp'
	return r
end 'pick'

function main() returns ExitCode
	return pick()
end 'main'
---
ExitCode: 2
---
func @firstExit {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect firstExit
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, lp
    x64.jmp whileexit
  lp:
    x64.leaRegRegImm32 rcx, rax, 1
    x64.movRegReg r8, rax
    x64.movRegReg rax, rcx
    x64.jmp whilehdr
  whileexit:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect pick
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
