    x64.leaRegRegReg rcx, rcx, r8
    x64.loadRegSlot rdx, slot2
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp whilehdr#1
  whileexit#3:
    x64.leaRegRegImm32 rax, r12, 0
