// Test: a-push-of-the-containers-own-element-is-not-a-conflict
type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element
	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'

	export function copyFirst()
		let a = try managed.get(0) otherwise panic("oob")
		push(a)
	end 'copyFirst'
end 'Array'

typealias StrArray = Array with String

function main() returns ExitCode
	var a = StrArray.create()
	a.push("alpha value long enough for a heap record")
	a.copyFirst()
	print("{a.count()} {try a.get(1) otherwise "?"}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Array.copyFirst {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __retain_type_param
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 56
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __managed_push
    x64.leaRegRdata rdx, [rip + __layout_Array_String]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.copyFirst
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot1, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_6]
    x64.loadRegBaseDisp.word64 r14, [rax + 0]
    x64.loadRegBaseDisp.word64 r15, [rax + 8]
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rax, [rip + __str_rec_7]
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot6, rax
    x64.leaRegRdata rcx, [rip + __str_rec_8]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.storeSlotReg slot5, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.storeSlotReg slot4, rcx
    x64.leaRegRegReg rdx, r12, r15
    x64.leaRegRegReg rax, rdx, rax
    x64.leaRegRegReg rax, rax, rcx
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 rbx, r8, 56
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, rbx, r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r15
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r15
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot7
    x64.loadRegSlot r13, slot6
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r13
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot5
    x64.loadRegSlot r13, slot4
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot3
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot0
    x64.callDirect __managed_decref
    x64.movRegReg r8, rbx
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
