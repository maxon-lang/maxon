// Test: default-throws-no-match
enum Color
	red
	green
	blue
end 'Color'

enum MatchError
	unmatched
end 'MatchError'

function checkColor(c Color) returns ExitCode throws MatchError
	match c 'check'
		red then return 1
		green then return 2
		default throws MatchError.unmatched
	end 'check'
end 'checkColor'

function main() returns ExitCode
	let c = Color.blue
	let result = try checkColor(c) otherwise 99
	return result
end 'main'
---
ExitCode: 99
---
func @checkColor {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r10, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.callDirect checkColor
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont
  tryerr:
    x64.movRegImm32 r8, 99
  trycont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
