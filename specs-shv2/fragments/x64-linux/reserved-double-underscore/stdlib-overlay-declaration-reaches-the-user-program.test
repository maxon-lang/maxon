// Test: stdlib-overlay-declaration-reaches-the-user-program
// --- stdlib-overlay: Builtins.maxon
export enum __OverlayProbe
	first
	second
end '__OverlayProbe'
// --- file: main.maxon
function rank(e __OverlayProbe) returns ExitCode
	return match e 'which'
		first gives 1
		second gives 42
	end 'which'
end 'rank'

function main() returns ExitCode
	return rank(__OverlayProbe.second)
end 'main'
---
ExitCode: 42
---
func @rank {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.movRegImm32 r8, 42
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
  matcharm:
    x64.movRegImm32 rax, 42
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
  __rc_chk:
    x64.cmpRegImm32 rax, 255
    x64.jcc lessEqual, __rc_ok
  __il_slow:
    x64.callDirect rank
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rax
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
