// Test: cast-to-alias-declared-later
function main() returns ExitCode
	let n = 7 as Later
	return n as ExitCode
end 'main'

typealias Later = int(0 to 100)
---
ExitCode: 7
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}
