// Test: function-backing.multi-case-dispatch

typealias Integer = int(i64.min to i64.max)

function doubleFn(x Integer) returns Integer
	return x * 2
end 'doubleFn'

function tripleFn(x Integer) returns Integer
	return x * 3
end 'tripleFn'

enum Op
	doubleOp = doubleFn
	tripleOp = tripleFn
end 'Op'

function main() returns ExitCode
	let dFn = Op.doubleOp.rawValue
	let tFn = Op.tripleOp.rawValue
	return dFn(5) + tFn(10)
end 'main'
---
ExitCode: 40
---
func @doubleFn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @tripleFn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 3
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
    x64.leaRegFunc rdx, [rip + __fnref_doubleFn]
    x64.imulRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rax
    x64.leaRegFunc rdx, [rip + __fnref_tripleFn]
    x64.imulRegReg rax, rax, rdx
    x64.leaRegRegReg rbx, rcx, rax
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.setccReg equal, rcx
    x64.leaRegFunc rdx, [rip + __fnref_doubleFn]
    x64.imulRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rax, 1
    x64.setccReg equal, rax
    x64.leaRegFunc rdx, [rip + __fnref_tripleFn]
    x64.imulRegReg rax, rax, rdx
    x64.leaRegRegReg r12, rcx, rax
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 10
    x64.movRegImm32 rdx, 0
    x64.callReg r12
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
