// Test: match-statements.or-patterns-first
function main() returns ExitCode
	let x = 1
	match x 'check'
		1 or 2 then return 10
		3 or 4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.jumpTable rax, default=matchdefault [[0..1]=matcharm#1, [2..3]=matcharm#2] @__jumptable_0
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.popReg rbp
    x64.ret
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
}
