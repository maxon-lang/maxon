// Test: match-statements.try-otherwise-ignore
enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally)
	match kind 'k'
		1 then try leaf() otherwise ignore
		default panic("unreachable")
	end 'k'
end 'dispatch'

typealias Tally = int(0 to 100)

function main() returns ExitCode
	dispatch(1)
	return 0
end 'main'
---
ExitCode: 0
---
func @leaf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}

func @dispatch {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.callDirect leaf
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.jmp matchcont
  matchcont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.movRegImm32 rdi, 134
    x64.movReg32Reg32 rdi, rdi
    x64.x64Syscall 231
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect dispatch
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
