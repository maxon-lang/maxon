// Test: match-break.continue-in-for-reaches-step
function main() returns ExitCode
	var seen = 0
	var skipped = 0
	for i in 0 upto 6 'each'
		match i 'check'
			2 then continue
			4 then continue
			default then seen = seen + 1
		end 'check'
		skipped = skipped + 10
	end 'each'
	return seen + skipped
end 'main'
---
ExitCode: 44
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegImm32 rdx, 6
    x64.jcc less, each
    x64.jmp forexit
  each:
    x64.cmpRegImm32 rdx, 2
    x64.jcc equal, matcharm#5
    x64.jmp matchnext
  matcharm#5:
    x64.jmp forstep
  matchnext:
    x64.cmpRegImm32 rdx, 4
    x64.jcc equal, matcharm#6
    x64.jmp matchdefault
  matcharm#6:
    x64.jmp forstep
  matchdefault:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegImm32 rcx, rcx, 10
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp forhdr
  forexit:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
