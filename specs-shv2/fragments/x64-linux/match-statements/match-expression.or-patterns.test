// Test: match-expression.or-patterns
function main() returns ExitCode
	let x = 4
	let result = match x 'eval'
		1 or 2 gives 10
		3 or 4 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 4
    x64.leaRegRegImm32 rax, rax, -1
    x64.jumpTable rax, default=matchdefault [[0..1]=matcharm, [2..3]=matcharm] @__jumptable_0
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matcharm:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}
