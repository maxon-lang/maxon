// Test: match-break.otherwise-break-boxed-error
typealias Count = int(0 to 1000)

union Err
	bad(s String)
end 'Err'

function risky(k Count) returns Count throws Err
	if k == 1 'fail'
		throw Err.bad("boom")
	end 'fail'
	return 10
end 'risky'

function pick(k Count) returns Count
	var r = 0
	match k 'check'
		1 then r = try risky(k) otherwise break
		default then r = 50
	end 'check'
	return r + 1
end 'pick'

function main() returns ExitCode
	return pick(1) + pick(2)
end 'main'
---
ExitCode: 52
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @risky {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, fail
    x64.jmp ifcont
  fail:
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 8], r8
    x64.movRegImm32 r8, 0
    x64.movRegReg r10, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 10
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#8
    x64.jmp __rc_chk#9
  __rc_chk#9:
    x64.cmpRegImm32 rcx, 1000
    x64.jcc greater, __rc_panic#8
    x64.jmp __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_3]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.movRegImm32 rbx, 0
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.callDirect risky
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegReg rcx, r10
    x64.callDirect __destruct_Err
    x64.movRegReg rax, rbx
    x64.jmp matchcont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 rax, 50
    x64.jmp matchcont
  matchcont:
    x64.leaRegRegImm32 r8, rax, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#11
    x64.jmp __rc_chk#12
  __rc_chk#12:
    x64.cmpRegImm32 r8, 1000
    x64.jcc greater, __rc_panic#11
    x64.jmp __rc_ok#10
  __rc_panic#11:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#10:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  afterbreak:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.callDirect pick
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect pick
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
