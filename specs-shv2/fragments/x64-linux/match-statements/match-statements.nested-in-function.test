// Test: match-statements.nested-in-function

typealias Integer = int(i64.min to i64.max)

function categorize(n Integer) returns Integer
	match n 'cat'
		1 or 2 or 3 then return 1
		4 or 5 or 6 then return 2
		default then return 0
	end 'cat'
end 'categorize'

function main() returns ExitCode
	return categorize(5)
end 'main'
---
ExitCode: 2
---
func @categorize {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 rax, rcx, -1
    x64.jumpTable rax, default=matchdefault [[0..2]=matcharm, [3..5]=matcharm] @__jumptable_0
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matcharm:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.callDirect categorize
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
