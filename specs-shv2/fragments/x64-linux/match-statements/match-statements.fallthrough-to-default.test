// Test: match-statements.fallthrough-to-default
function main() returns ExitCode
	let x = 3
	var result = 0
	match x 'check'
		1 then result = 10
		2 then result = 20
		3 then result = result + 30 and fallthrough
		default then result = result + 90
	end 'check'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchnext#6:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, matcharm#3
    x64.jmp critsplit
  matcharm#3:
    x64.leaRegRegImm32 rax, rcx, 30
    x64.jmp matchdefault
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp matchdefault
  matchdefault:
    x64.leaRegRegImm32 r8, rax, 90
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
