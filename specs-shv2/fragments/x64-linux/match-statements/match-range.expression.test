// Test: match-range.expression
function main() returns ExitCode
	let temp = 22
	let category = match temp 'weather'
		min upto 0 gives 1
		0 upto 15 gives 2
		15 upto 25 gives 3
		25 to max gives 4
		default gives 0
	end 'weather'
	return category
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 22
    x64.cmpRegImm32 rax, 15
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rax, -1
    x64.jcc lessEqual, matcharm#1
    x64.jmp matchnext#8
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext#8:
    x64.cmpRegImm32 rax, 0
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 14
    x64.setccReg lessEqual, rax
    x64.andRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#2
    x64.jmp matchdefault
  matcharm#2:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchhi:
    x64.cmpRegImm32 rax, 15
    x64.setccReg greaterEqual, rcx
    x64.cmpRegImm32 rax, 24
    x64.setccReg lessEqual, rdx
    x64.andRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, matcharm#3
    x64.jmp matchnext#9
  matcharm#3:
    x64.movRegImm32 r8, 3
    x64.jmp matchcont
  matchnext#9:
    x64.cmpRegImm32 rax, 25
    x64.jcc greaterEqual, matcharm#4
    x64.jmp matchdefault
  matcharm#4:
    x64.movRegImm32 r8, 4
    x64.jmp matchcont
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
