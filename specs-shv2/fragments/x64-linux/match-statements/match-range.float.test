// Test: match-range.float
function main() returns ExitCode
	let x = 2.5
	match x 'check'
		0.0 to 5.0 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.movsdRegRip xmm2, [rip + __fconst_2]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg aboveEqual, rax
    x64.ucomisdRegReg xmm2, xmm0
    x64.setccReg aboveEqual, rcx
    x64.andRegReg rax, rax, rcx
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchnext:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
