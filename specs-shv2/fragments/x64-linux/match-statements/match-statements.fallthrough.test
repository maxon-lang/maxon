// Test: match-statements.fallthrough
function main() returns ExitCode
	let x = 1
	var result = 0
	match x 'check'
		1 then result = result + 10 and fallthrough
		2 then result = result + 20
		default then result = result + 100
	end 'check'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.leaRegRegImm32 rax, rcx, 10
    x64.jmp matcharm#2
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, critsplit
    x64.jmp matchdefault
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp matcharm#2
  matcharm#2:
    x64.leaRegRegImm32 r8, rax, 20
    x64.jmp matchcont
  matchdefault:
    x64.leaRegRegImm32 r8, rcx, 100
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
