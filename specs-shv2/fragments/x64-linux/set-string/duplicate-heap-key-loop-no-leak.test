// Test: duplicate-heap-key-loop-no-leak
typealias StrSet = Set with String
typealias Counter = int(0 to 1000)

function main() returns ExitCode
	var i = 0 as Counter
	var acc = 0 as Counter
	while i < 100 'loop'
		var s = StrSet.create()
		s.insert("dup")
		s.insert("dup")
		if s.count() == 1 'ok'
			acc = acc + 1
		end 'ok'
		i = i + 1
	end 'loop'
	if acc == 100 'all'
		return 0
	end 'all'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot1, rcx
    x64.storeSlotReg slot0, rax
    x64.cmpRegImm32 rax, 100
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.leaRegFunc rcx, [rip + __str_decref]
    x64.callDirect __set_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.leaRegRdata rax, [rip + __witness_String.Hashable]
    x64.leaRegRdata r9, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __set_insert
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.leaRegRegImm32 rcx, r13, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r14, r8
    x64.leaRegRegImm32 r15, r14, 48
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r15, r13
    x64.storeBaseDispReg.word64 [r14 + 0], r15
    x64.storeBaseDispReg.word64 [r14 + 8], r13
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r14 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r14 + 24], rax
    x64.leaRegRdata rax, [rip + __witness_String.Hashable]
    x64.leaRegRdata r9, [rip + __witness_String.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __set_insert
    x64.movRegReg rcx, rbx
    x64.callDirect __set_count
    x64.cmpRegImm32 r8, 1
    x64.jcc equal, ok
    x64.jmp critsplit
  ok:
    x64.loadRegSlot rax, slot1
    x64.leaRegRegImm32 r12, rax, 1
    x64.jmp ifcont
  critsplit:
    x64.loadRegSlot r12, slot1
    x64.jmp ifcont
  ifcont:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 r13, rax, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __set_decref
    x64.movRegReg rax, r13
    x64.movRegReg rcx, r12
    x64.jmp whilehdr
  whileexit:
    x64.loadRegSlot rax, slot1
    x64.cmpRegImm32 rax, 100
    x64.jcc equal, all
    x64.jmp ifcont
  all:
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.movRegImm32 rdx, 5381
    x64.movRegImm32 rsi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rsi, rcx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rdx
    x64.andRegReg r8, rdx, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rdi, rax, rsi
    x64.loadRegBaseDisp.byte rdi, [rdi + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rdx, rdx, r8
    x64.leaRegRegReg rdx, rdx, rdi
    x64.movRegImm32 rdi, 1
    x64.leaRegRegReg rsi, rsi, rdi
    x64.jmp header
}

func @String.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.movRegImm32 rdi, 0
    x64.cmpRegReg rax, rsi
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp header
  header:
    x64.cmpRegReg rdi, rax
    x64.jcc greaterEqual, allMatch
    x64.jmp body
  allMatch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rsi, rcx, rdi
    x64.loadRegBaseDisp.byte rsi, [rsi + 0]
    x64.leaRegRegReg r8, rdx, rdi
    x64.loadRegBaseDisp.byte r8, [r8 + 0]
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rdi, rdi, r9
    x64.cmpRegReg rsi, r8
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp header
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
