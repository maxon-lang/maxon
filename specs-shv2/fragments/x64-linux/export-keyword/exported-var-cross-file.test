// Test: exported-var-cross-file
// --- file: api/counter.maxon
export var counter = 10

// --- file: app/main.maxon
function main() returns ExitCode
		return counter
end 'main'
---
ExitCode: 10
---
data {
  __data_counter@0 = i64 10
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_counter
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.popReg rbp
    x64.ret
}
