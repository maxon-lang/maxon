// Test: cross-file-bool-short-circuits
// --- file: a.maxon

export function ready() returns bool
	return false
end 'ready'

function opaqueZero() returns Integer
	return 0
end 'opaqueZero'

export function enabled() returns bool
	let zero = opaqueZero()
	return (try (1 / zero) otherwise panic("`and` did not short-circuit: enabled() was evaluated")) == 0
end 'enabled'

typealias Integer = int(i64.min to i64.max)
// --- file: b.maxon
function main() returns ExitCode
	if not (ready() and enabled()) 'skipped'
		return 42
	end 'skipped'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  __il_cont:
    x64.movRegImm32 rax, 0
  scmerge:
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  skipped:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
