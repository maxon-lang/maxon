// Test: cross-file-int-call-still-compiles
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

export function crossFileInt() returns Integer
	return 41
end 'crossFileInt'

// --- file: b.maxon
function main() returns ExitCode
	return crossFileInt() + 1
end 'main'
---
ExitCode: 42
---
func @crossFileInt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 41
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect crossFileInt
    x64.leaRegRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
