    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movRegReg xmm6, xmm0
    x64.movsdRegRip xmm0, [rip + __fconst_3]
    x64.ucomisdRegReg xmm6, xmm0
    x64.jcc parity, ifcont#2
    x64.jmp fordered#9
  fordered#9:
    x64.jcc equal, zero
    x64.jmp ifcont#2
  zero:
    x64.movRegReg xmm0, xmm6
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegReg xmm0, xmm6
    x64.callDirect Math.sin
    x64.movRegReg xmm7, xmm0
    x64.movRegReg xmm0, xmm6
    x64.callDirect Math.cos
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont#6
    x64.jmp fordered#10
  fordered#10:
