// Test: tan.with-int-promotion
function main() returns ExitCode
	let x = 0  // int
	let result = Math.tan(x)  // x promoted to 0.0
	if result == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cvtsi2sdRegReg xmm0, rax
    x64.callDirect Math.tan
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Math.sin {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, zero
    x64.jmp ifcont
  zero:
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp __il_body
  __il_body:
    x64.jmp whilehdr#10
  whilehdr#10:
    x64.movsdRegRip xmm1, [rip + __fconst_7]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc above, reduce_pos
    x64.jmp whileexit#12
  reduce_pos:
    x64.movsdRegRip xmm1, [rip + __fconst_8]
    x64.subsdRegReg xmm0, xmm0, xmm1
    x64.jmp whilehdr#10
  whileexit#12:
    x64.jmp whilehdr#13
  whilehdr#13:
    x64.movsdRegRip xmm1, [rip + __fconst_7]
    x64.movsdRegRip xmm2, [rip + __fconst_3]
    x64.subsdRegReg xmm2, xmm2, xmm1
    x64.ucomisdRegReg xmm2, xmm0
    x64.jcc above, reduce_neg
    x64.jmp whileexit#15
  reduce_neg:
    x64.movsdRegRip xmm1, [rip + __fconst_8]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.jmp whilehdr#13
  whileexit#15:
    x64.jmp __il_cont
  __il_cont:
    x64.movRegReg xmm1, xmm0
    x64.mulsdRegReg xmm1, xmm0, xmm0
    x64.movsdRegRip xmm2, [rip + __fconst_5]
    x64.movsdRegRip xmm3, [rip + __fconst_6]
    x64.movRegReg xmm4, xmm2
    x64.movRegReg xmm2, xmm0
    x64.jmp whilehdr#3
  whilehdr#3:
    x64.ucomisdRegReg xmm3, xmm4
    x64.jcc above, series
    x64.jmp whileexit#5
  series:
    x64.movsdRegRip xmm5, [rip + __fconst_4]
    x64.mulsdRegReg xmm5, xmm5, xmm4
    x64.movsdRegRip xmm6, [rip + __fconst_3]
    x64.subsdRegReg xmm6, xmm6, xmm1
    x64.mulsdRegReg xmm0, xmm0, xmm6
    x64.movsdRegRip xmm6, [rip + __fconst_5]
    x64.movRegReg xmm7, xmm5
    x64.addsdRegReg xmm7, xmm5, xmm6
    x64.mulsdRegReg xmm5, xmm5, xmm7
    x64.movsdRegRip xmm6, [rip + __fconst_3]
    x64.ucomisdRegReg xmm5, xmm6
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rax
    x64.divsdRegReg xmm0, xmm0, xmm5
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_3]
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  tryok:
    x64.addsdRegReg xmm2, xmm2, xmm0
    x64.movsdRegRip xmm5, [rip + __fconst_5]
    x64.addsdRegReg xmm4, xmm4, xmm5
    x64.jmp whilehdr#3
  whileexit#5:
    x64.movRegReg xmm0, xmm2
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

