// Test: ranged-alias-type-arg-admitted
typealias Integer = int(i64.min to i64.max)
type Box uses T
	export var value as T
	export static function create(v T) returns Self
		return Self{value: v}
	end 'create'
	export function get() returns T
		return self.value
	end 'get'
end 'Box'
typealias IntBox = Box with Integer
typealias IntArray = Array with Integer
function main() returns ExitCode
	let b = IntBox.create(42)
	var a = IntArray.create()
	a.push(b.get())
	return (try a.get(0) otherwise 0) - 42
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rax, 42
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r12, r8
    x64.leaRegRdata rdx, [rip + __layout_Box_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Box.get
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [r12 + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#11
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#12
  __im_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.jmp __im_cont
  critsplit#12:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont
  critsplit#11:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.leaRegRegImm32 rbx, rax, -42
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ranged-alias-type-arg-admitted.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
