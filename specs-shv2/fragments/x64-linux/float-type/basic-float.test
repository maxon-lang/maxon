// Test: basic-float
function main() returns ExitCode
	let x = 3.14
	let y = 2.0
	let z = x + y
	let result = trunc(z)
	return result
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
