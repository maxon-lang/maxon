// Test: float-return-from-function
typealias Float = float(f64.min to f64.max)

function computePi() returns Float
	return 3.14
end 'computePi'

function main() returns ExitCode
	let x = computePi()
	let result = trunc(x)
	return result
end 'main'
---
ExitCode: 3
---
func @computePi {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect computePi
    x64.cvttsd2siRegReg r8, xmm0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
