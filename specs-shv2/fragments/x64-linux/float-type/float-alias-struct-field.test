// Test: float-alias-struct-field

typealias Weight = float(f64.min to f64.max)

type Particle
	export var mass as Weight
	export var velocity as Weight

	export static function make(mass Weight, velocity Weight) returns Self
		return Self{mass: mass, velocity: velocity}
	end 'make'

	export function momentum() returns Weight
		return self.mass * self.velocity
	end 'momentum'
end 'Particle'

function main() returns ExitCode
	var p = Particle.make(2.5, velocity: 4.0)
	p.velocity = 6.0
	return trunc(p.momentum())
end 'main'
---
ExitCode: 15
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.leaRegSlot rax, slot0
    x64.storeBaseDispReg.word64 [rax + 0], xmm0
    x64.storeBaseDispReg.word64 [rax + 8], xmm1
    x64.movsdRegRip xmm0, [rip + __fconst_3]
    x64.storeBaseDispReg.word64 [rax + 8], xmm0
    x64.jmp __il_body
  __il_body:
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.loadRegBaseDisp.word64 xmm1, [rax + 8]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.jmp __il_cont
  __il_cont:
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
