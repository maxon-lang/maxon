// Test: float-alias-struct-field

typealias Weight = float(f64.min to f64.max)

type Particle
	export var mass as Weight
	export var velocity as Weight

	export static function make(mass Weight, velocity Weight) returns Self
		return Self{mass: mass, velocity: velocity}
	end 'make'

	export function momentum() returns Weight
		return self.mass * self.velocity
	end 'momentum'
end 'Particle'

function main() returns ExitCode
	var p = Particle.make(2.5, velocity: 4.0)
	p.velocity = 6.0
	return trunc(p.momentum())
end 'main'
---
ExitCode: 15
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Particle.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movRegReg xmm6, xmm0
    x64.movRegReg xmm7, xmm1
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], xmm6
    x64.storeBaseDispReg.word64 [r8 + 8], xmm7
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @Particle.momentum {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 xmm0, [rcx + 0]
    x64.loadRegBaseDisp.word64 xmm1, [rcx + 8]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.callDirect Particle.make
    x64.movRegReg rbx, r8
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.storeBaseDispReg.word64 [rbx + 8], xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect Particle.momentum
    x64.cvttsd2siRegReg r12, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
