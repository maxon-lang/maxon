// Test: float-phi-loop-carried
function main() returns ExitCode
	var f = 0.0
	var i = 0
	while i < 4 'loop'
		f = f + 2.5
		i = i + 1
	end 'loop'
	return trunc(f)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movRegImm32 rax, 0
  whilehdr:
    x64.cmpRegImm32 rax, 4
    x64.jcc greaterEqual, whileexit
  loop:
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
