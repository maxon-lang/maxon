// Test: float-phi-both-arms
function work(a Integer) returns Integer
	var f = a + 0.0
	if a > 100 'big'
		f = f * 2.0
	end 'big' else 'small'
		f = f - 4.5
	end 'small'
	return trunc(f)
end 'work'

function main() returns ExitCode
	return work(19)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 19
  __il_body:
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.cvtsi2sdRegReg xmm1, rax
    x64.addsdRegReg xmm1, xmm1, xmm0
  ifelse:
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.subsdRegReg xmm1, xmm1, xmm0
  ifcont:
    x64.cvttsd2siRegReg r8, xmm1
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
