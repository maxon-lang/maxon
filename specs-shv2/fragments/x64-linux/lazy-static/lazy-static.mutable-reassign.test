// Test: lazy-static.mutable-reassign
typealias Count = int(0 to u64.max)

type State
	static var current = State.makeDefault()
	export var value as Count

	static function makeDefault() returns State
		return State{value: 0}
	end 'makeDefault'

	export static function get() returns State
		return State.current
	end 'get'

	export static function set(s State)
		State.current = s
	end 'set'

	static function create(value Count) returns Self
		return Self{value: value}
	end 'create'
end 'State'

function main() returns ExitCode
	let a = State.get()
	print("{a.value} ")
	State.set(State.create(99))
	let b = State.get()
	print("{b.value}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_State.current@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @State.makeDefault {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @State.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __lazy_init#__data_State.current
    x64.leaRegGlobal rax, __data_State.current
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @State.set {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.callDirect __lazy_init#__data_State.current
    x64.leaRegGlobal rax, __data_State.current
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.callDirect __mm_decref
    x64.callDirect __lazy_init#__data_State.current
    x64.leaRegGlobal rax, __data_State.current
    x64.storeBaseDispReg.word64 [rax + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @State.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
