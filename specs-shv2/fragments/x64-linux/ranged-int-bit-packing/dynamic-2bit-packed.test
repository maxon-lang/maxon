// Test: dynamic-2bit-packed
typealias Q = int(0 to 3)
typealias QArray = Array with Q

function main() returns ExitCode
	var a = QArray.create()
	a.push(0)
	a.push(1)
	a.push(2)
	a.push(3)
	a.push(2)
	if a.managed.elementSize() != -2 'notPacked'
		return 99
	end 'notPacked'
	var sum = 0
	var i = 0
	while i < 5 'read'
		sum = sum + (try a.get(i) otherwise 0)
		i = i + 1
	end 'read'
	return sum
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm rcx, 18446744073709551614
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_element_size
    x64.cmpRegImm32 r8, -2
    x64.jcc equal, ifcont
  notPacked:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  whilehdr:
    x64.cmpRegImm32 r13, 5
    x64.jcc greaterEqual, whileexit
  read:
    x64.cmpRegImm32 r13, 0
    x64.jcc greaterEqual, __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
  trycont:
    x64.leaRegRegReg r12, r12, rax
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#12
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok#11
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#11:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
