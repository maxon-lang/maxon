// Test: grow-stays-packed
typealias Q = int(0 to 3)
typealias QArray = Array with Q

function main() returns ExitCode
	var a = QArray.create()
	var i = 0
	while i < 40 'fill'
		a.push((i mod 4) as Q)
		i = i + 1
	end 'fill'
	if a.managed.elementSize() != -2 'notPacked'
		return 99
	end 'notPacked'
	return (try a.get(39) otherwise 0) + (try a.get(2) otherwise 0)
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm rcx, -2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r12, 40
    x64.jcc less, fill
    x64.jmp whileexit
  fill:
    x64.movRegImm32 rcx, 4
    x64.movRegReg rax, r12
    x64.cqo
    x64.idivReg rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#13
    x64.jmp __rc_chk#14
  __rc_chk#14:
    x64.cmpRegImm32 rdx, 3
    x64.jcc greater, __rc_panic#13
    x64.jmp __rc_ok#12
  __rc_panic#13:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#12:
    x64.leaRegRegImm32 rdx, rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_element_size
    x64.cmpRegImm32 r8, -2
    x64.jcc notEqual, notPacked
    x64.jmp ifcont
  notPacked:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rdx, 39
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#7
    x64.jmp tryok#6
  tryerr#7:
    x64.movRegImm32 r12, 0
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg r12, r8
    x64.jmp trycont#8
  trycont#8:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#10
    x64.jmp tryok#9
  tryerr#10:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#11
  tryok#9:
    x64.movRegReg rax, r8
    x64.jmp trycont#11
  trycont#11:
    x64.leaRegRegReg r12, r12, rax
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#16
    x64.jmp __rc_chk#17
  __rc_chk#17:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic#16
    x64.jmp __rc_ok#15
  __rc_panic#16:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#15:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
