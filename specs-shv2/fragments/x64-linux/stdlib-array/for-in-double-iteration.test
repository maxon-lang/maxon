// Test: for-in-double-iteration
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)

	var sum1 = 0
	for item in arr 'loop1'
		sum1 = sum1 + item
	end 'loop1'

	var sum2 = 0
	for item in arr 'loop2'
		sum2 = sum2 + item
	end 'loop2'

	if sum1 == 60 and sum2 == 60 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rdx, [rbx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rbx + 0]
  forhdr#1:
    x64.cmpRegReg rcx, rdx
    x64.jcc greaterEqual, forexit#4
  loop1:
    x64.loadRegBaseIndexScale.word64 rdi, [rsi + rcx*8 + 0]
  __im_cont#13:
    x64.leaRegRegReg rax, rax, rdi
  forstep#3:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 8]
    x64.loadRegBaseDisp.word64 rdi, [rbx + 0]
  forhdr#5:
    x64.cmpRegReg rdx, rsi
    x64.jcc greaterEqual, forexit#8
  loop2:
    x64.loadRegBaseIndexScale.word64 r8, [rdi + rdx*8 + 0]
  __im_cont#14:
    x64.leaRegRegReg rcx, rcx, r8
  forstep#7:
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.cmpRegImm32 rax, 60
    x64.movRegImm32 rax, 0
    x64.jcc notEqual, scmerge
  andrhs:
    x64.cmpRegImm32 rcx, 60
    x64.setccReg equal, rax
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
