// Test: get-all-elements
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)

	let v0 = try arr.get(0) otherwise -1
	if v0 != 10 'c0'
		return 1
	end 'c0'

	let v1 = try arr.get(1) otherwise -1
	if v1 != 20 'c1'
		return 2
	end 'c1'

	let v2 = try arr.get(2) otherwise -1
	if v2 != 30 'c2'
		return 3
	end 'c2'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rax, r8
    x64.jmp trycont#3
  trycont#3:
    x64.cmpRegImm32 rax, 10
    x64.jcc notEqual, c0
    x64.jmp ifcont#5
  c0:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#7
    x64.jmp tryok#6
  tryerr#7:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg rax, r8
    x64.jmp trycont#8
  trycont#8:
    x64.cmpRegImm32 rax, 20
    x64.jcc notEqual, c1
    x64.jmp ifcont#10
  c1:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#10:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#12
    x64.jmp tryok#11
  tryerr#12:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont#13
  tryok#11:
    x64.movRegReg rax, r8
    x64.jmp trycont#13
  trycont#13:
    x64.cmpRegImm32 rax, 30
    x64.jcc notEqual, c2
    x64.jmp ifcont#15
  c2:
    x64.movRegImm32 r12, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#15:
