// Test: int-format-enum-backing
enum ErrorCode
	ok = 0
	notFound = 404
end 'ErrorCode'

function main() returns ExitCode
	let code = ErrorCode.notFound
	print("[{code}]\n")
	print("[{code:08}]\n")
	print("[{code:x}]\n")
	print("[{code:6}]\n")
	return 0
end 'main'
