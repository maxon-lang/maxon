// Test: format-spec-on-a-text-rendering-enum-is-ignored
enum Plain
	red
	green
end 'Plain'

enum Text
	active = "Active"
	idle = "Idle"
end 'Text'

function main() returns ExitCode
	let p = Plain.green
	let t = Text.idle
	print("[{p}] [{p:6}] [{p:08}] [{p:x}]\n")
	print("[{t}] [{t:6}] [{t:08}] [{t:x}]\n")
	return 0
end 'main'
