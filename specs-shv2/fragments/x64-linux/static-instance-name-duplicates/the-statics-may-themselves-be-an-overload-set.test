// Test: the-statics-may-themselves-be-an-overload-set
typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer

	static function create(v Integer) returns Box
		return Box{value: v}
	end 'create'

	static function getValue() returns Integer
		return 9
	end 'getValue'

	static function getValue(bump Integer) returns Integer
		return 20 + bump
	end 'getValue'

	function getValue() returns Integer
		return value
	end 'getValue'
end 'Box'

function main() returns ExitCode
	let b = Box.create(3)
	return b.getValue() + Box.getValue() + Box.getValue(10)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.movRegImm32 rax, 3
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_body#7
  __il_body#7:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.jmp __il_cont#6
  __il_cont#6:
    x64.jmp __il_body#8
  __il_body#8:
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.leaRegRegImm32 rax, rax, 9
    x64.jmp __il_body#9
  __il_body#9:
    x64.movRegImm32 rcx, 20
    x64.leaRegRegImm32 rcx, rcx, 10
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
