// Test: int-literal-to-float-local
function main() returns ExitCode
	var scale = 0.0
	scale = 3
	if scale == 3.0 'exact'
		return trunc(scale * 14.0)
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  exact:
    x64.movRegImm32 r8, 42
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
