// Test: int-literal-to-float-self-field
type Reading
	export var value as float = 0.0

	export function bump() returns int
		value = 3
		return 0
	end 'bump'

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Reading'

function main() returns ExitCode
	var r = Reading.make()
	let done = r.bump()
	if r.value == 3.0 'exact'
		return trunc(r.value * 14.0) + done
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rax, slot0
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.storeBaseDispReg.word64 [rax + 0], xmm0
    x64.jmp __il_body
  __il_body:
    x64.movRegImm32 rcx, 3
    x64.cvtsi2sdRegReg xmm0, rcx
    x64.storeBaseDispReg.word64 [rax + 0], xmm0
    x64.jmp __il_cont
  __il_cont:
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, exact
    x64.jmp ifcont
  exact:
    x64.loadRegBaseDisp.word64 xmm0, [rax + 0]
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 7
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
