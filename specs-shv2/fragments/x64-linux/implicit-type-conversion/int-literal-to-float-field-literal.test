// Test: int-literal-to-float-field-literal
type Reading
	export var value as float

	export static function make() returns Self
		return Self{value: 3}
	end 'make'

	export function raw() returns float
		return self.value
	end 'raw'
end 'Reading'

function main() returns ExitCode
	let r = Reading.make()
	if r.raw() == 3.0 'exact'
		return trunc(r.raw() * 14.0)
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Reading.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.movRegImm32 rax, 3
    x64.cvtsi2sdRegReg xmm6, rax
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], xmm6
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect Reading.make
    x64.jmp __il_body#7
  __il_body#7:
    x64.loadRegBaseDisp.word64 xmm0, [r8 + 0]
    x64.jmp __il_cont#6
  __il_cont#6:
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, exact
    x64.jmp ifcont
  exact:
    x64.jmp __il_body#9
  __il_body#9:
    x64.loadRegBaseDisp.word64 xmm0, [r8 + 0]
    x64.jmp __il_cont#8
  __il_cont#8:
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.cvttsd2siRegReg rbx, xmm0
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 7
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
