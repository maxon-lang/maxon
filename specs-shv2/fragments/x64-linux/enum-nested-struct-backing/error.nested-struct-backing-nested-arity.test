// Test: error.nested-struct-backing-nested-arity
typealias Wide = int(0 to 100)

type Inner
	export let n as Wide

	static function create(n Wide) returns Self
		return Self{n: n}
	end 'create'
end 'Inner'

type Meta
	export let inner as Inner

	static function create(inner Inner) returns Self
		return Self{inner: inner}
	end 'create'
end 'Meta'

enum Task
	quick = Meta.create(Inner.create(1, 2, 3))
end 'Task'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:21:2: Unsupported: 3 argument(s) to the `Inner` constant, which declares 1 field(s) — a factory call in this position is read as the struct LITERAL its arguments fill, so an argument past the last field names nothing
