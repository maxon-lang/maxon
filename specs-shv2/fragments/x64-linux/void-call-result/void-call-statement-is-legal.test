// Test: void-call-statement-is-legal
function noop()
	return
end 'noop'

function main() returns ExitCode
	noop()
	return 42
end 'main'
---
ExitCode: 42
---
func @noop {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect noop
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
