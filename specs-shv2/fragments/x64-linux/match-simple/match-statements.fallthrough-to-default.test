// Test: match-statements.fallthrough-to-default
function main() returns ExitCode
	let x = 3
	var result = 0
	match x 'check'
		1 then result = 10
		2 then result = 20
		3 then result = result + 20 and fallthrough
		default then result = result + 100
	end 'check'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 10
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 20
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, matcharm
    x64.jmp critsplit
  matcharm:
    x64.leaRegRegImm32 rax, rcx, 20
    x64.jmp matchdefault
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp matchdefault
  matchdefault:
    x64.leaRegRegImm32 r8, rax, 100
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}
