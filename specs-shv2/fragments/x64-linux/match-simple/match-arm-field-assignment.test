// Test: match-arm-field-assignment
enum Op
	noop
	mark
	done
end 'Op'

type State
	export var flag = false

	export static function make() returns State
		return State{}
	end 'make'
end 'State'

function scan(op Op, state State)
	match op 'm'
		noop then break 'm'
		mark then state.flag = true
		done then break 'm'
	end 'm'
end 'scan'

function main() returns ExitCode
	var s = State.make()
	scan(Op.mark, state: s)
	return 1 if s.flag else 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @State.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.byte [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect State.make
  matcharm:
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.byte [r8 + 0], rax
  __il_cont:
    x64.loadRegBaseDisp.byte rax, [r8 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rbx, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rbx, 0
  matchcont:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
