// Test: range-check-panic.an-inclusive-counted-loop-past-the-unsigned-top-still-panics
typealias Integer = int(i64.min to i64.max)
typealias Big = int(0 to u64.max)
typealias Neg = int(-5 to -1)

function main() returns ExitCode
  var n = 0 as Integer
  var last = 0 as Integer
  for i in ((0 - 5) as Big) to u64.max 'wrap'
    let g = i as Neg
    last = g
    n = n + 1
    if n > 6 'enough'
      break
    end 'enough'
  end 'wrap'
  print("n={n} last={last}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
    x64.movRegImm rdx, 18446744073709551611
  forhdr:
    x64.cmpRegImm32 rdx, -1
    x64.jcc above, critsplit
  wrap:
    x64.cmpRegImm32 rdx, -5
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, -1
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 rbx, rax, 1
    x64.cmpRegImm32 rbx, 6
    x64.jcc lessEqual, forstep
  enough:
    x64.movRegReg r12, rdx
    x64.jmp forexit
  forstep:
    x64.leaRegRegImm32 rax, rdx, 1
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.movRegReg rax, rbx
    x64.jmp forhdr
  critsplit:
    x64.movRegReg rbx, rax
    x64.movRegReg r12, rcx
  forexit:
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 r13, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot6, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_4]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot5, rcx
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.callDirect __int_to_string
    x64.storeSlotReg slot4, r8
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot3, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot2, rax
    x64.leaRegRegReg rcx, r13, rbx
    x64.leaRegRegReg rcx, rcx, r14
    x64.leaRegRegReg rcx, rcx, r8
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot0, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot1, r8
    x64.leaRegRegImm32 r12, r8, 56
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot7
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r13, r12, r13
    x64.movRegReg rcx, r13
    x64.loadRegSlot rdx, slot6
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r13, rbx
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot5
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r14
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.loadRegSlot r13, slot4
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r13
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot3
    x64.loadRegSlot r13, slot2
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r13
    x64.loadRegSlot rbx, slot1
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.loadRegSlot rax, slot0
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot6
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
