// Test: range-check-panic.return-of-a-second-ranged-parameter-is-covered-by-its-entry-guard
typealias SmallInt = int(0 to 10)

function pick(_ SmallInt, b SmallInt) returns SmallInt
  return b
end 'pick'

function main() returns ExitCode
  return pick(1, b: 7)
end 'main'
---
ExitCode: 7
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greater, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 rdx, 10
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.movRegReg r8, rdx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 7
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk#4
  __rc_chk#4:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok#3
  __rc_ok#3:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 rdx, 10
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok#5
  __il_slow:
    x64.callDirect pick
    x64.jmp __il_cont
  __rc_ok#5:
    x64.movRegReg r8, rdx
    x64.jmp __il_cont
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
