// Test: range-check-panic.the-source-alias-keeps-its-own-guard
typealias Byte = int(0 to u8.max)
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function pick() returns Byte
  return opaque(300)
end 'pick'

function main() returns ExitCode
  return pick()
end 'main'
---
ExitCode: 1
---
func @pick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect pick
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
