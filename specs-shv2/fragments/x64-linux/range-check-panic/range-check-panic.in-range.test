// Test: range-check-panic.in-range
typealias SmallInt = int(0 to 10)

function check(x SmallInt) returns SmallInt
  return x
end 'check'

function main() returns ExitCode
  return check(5)
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 5
  __il_cont:
    x64.popReg rbp
    x64.ret
}
