// Test: range-check-panic.return-of-a-reassigned-shadow-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 10)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function check(x SmallInt) returns SmallInt
  var y = x
  y = opaque(99)
  return y
end 'check'

function main() returns ExitCode
  return check(5)
end 'main'
---
ExitCode: 1
---
func @check {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
    x64.jmp __rc_chk#3
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 10
    x64.jcc greater, __rc_panic#2
    x64.jmp __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.movRegImm32 r8, 99
    x64.jmp __il_body
  __il_body:
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 r8, 10
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.callDirect check
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
