// Test: range-check-panic.nested-call
typealias Score = int(0 to 100)

function validate(s Score) returns Score
  return s
end 'validate'

function process(x Score) returns Score
  return validate(x * 3)
end 'process'

function main() returns ExitCode
  return process(50)
end 'main'
---
ExitCode: 1
---
func @validate {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @process {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.imulRegRegImm32 rcx, rcx, 3
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk#7:
    x64.cmpRegImm32 rcx, 100
    x64.jcc lessEqual, __rc_ok#6
  __il_slow:
    x64.callDirect validate
    x64.jmp __il_cont
  __rc_ok#6:
    x64.movRegReg r8, rcx
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 50
    x64.callDirect process
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
