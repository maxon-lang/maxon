// Test: init-from-char-literal-at-module-scope
typealias Integer = int(i64.min to i64.max)

type CharWrapper implements InitableFromCharLiteral
	var value as Character

	static function init(value Character) returns CharWrapper
		return CharWrapper{value: value}
	end 'init'

	export function len() returns Integer
		return value.byteLength()
	end 'len'
end 'CharWrapper'

let euro = CharWrapper from '€'

function main() returns ExitCode
	let local = CharWrapper from 'A'
	print("{euro.len()} {local.len()}\n")
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __data_euro@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @CharWrapper.init {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r12 + 0], r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

