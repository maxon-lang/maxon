// Test: int-array-map-key
typealias Val = int(i64.min to i64.max)
typealias IntArr = Array with Val
typealias IntArrMap = Map with (IntArr, Val)

function main() returns ExitCode
	var m = IntArrMap.create()
	var key = IntArr.create()
	key.push(1)
	key.push(2)
	key.push(3)
	try m.insert(key, value: 42) otherwise ignore
	var lookup = IntArr.create()
	lookup.push(1)
	lookup.push(2)
	lookup.push(3)
	let val = try m.get(lookup) otherwise 'notFound'
		return 0
	end 'notFound'
	return val
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + __arr_decref]
    x64.movRegImm32 rdx, 0
    x64.callDirect __map_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __arr_push
    x64.movRegImm32 rax, 42
    x64.leaRegRdata r9, [rip + __witness_Array.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_Array.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __map_insert
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r12
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, r12
    x64.callDirect __arr_push
    x64.leaRegRdata rax, [rip + __witness_Array.Hashable]
    x64.leaRegRdata r9, [rip + __witness_Array.Equatable]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __map_get
    x64.movRegReg r13, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __map_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __map_decref
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rcx + 24]
    x64.movRegImm32 rcx, 63
    x64.movRegReg rdi, rsi
    x64.sarRegCl rdi, rsi
    x64.movRegImm r8, -1
    x64.movRegReg r9, rdi
    x64.xorRegReg r9, rdi, r8
    x64.movRegImm32 r8, 0
    x64.subRegReg r8, r8, rsi
    x64.movRegImm32 r10, 3
    x64.movRegReg rcx, r10
    x64.shlRegCl rsi, rsi
    x64.andRegReg r8, r8, rdi
    x64.andRegReg rsi, rsi, r9
    x64.orRegReg r8, r8, rsi
    x64.imulRegReg rdx, rdx, r8
    x64.movRegImm32 rsi, 7
    x64.leaRegRegReg rdx, rdx, rsi
    x64.movRegImm32 rsi, 3
    x64.movRegReg rcx, rsi
    x64.shrRegCl rdx, rdx
    x64.movRegImm32 rsi, 5381
    x64.movRegImm32 rdi, 0
    x64.jmp header
  header:
    x64.cmpRegReg rdi, rdx
    x64.jcc greaterEqual, done
    x64.jmp body
  done:
    x64.movRegImm32 rax, 4294967295
    x64.movRegReg r8, rsi
    x64.andRegReg r8, rsi, rax
    x64.popReg rbp
    x64.ret
  body:
    x64.leaRegRegReg rcx, rax, rdi
    x64.loadRegBaseDisp.byte rcx, [rcx + 0]
    x64.movRegImm32 r8, 33
    x64.imulRegReg rsi, rsi, r8
    x64.leaRegRegReg rsi, rsi, rcx
    x64.movRegImm32 rcx, 1
    x64.leaRegRegReg rdi, rdi, rcx
    x64.jmp header
}

func @Array.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 8]
    x64.cmpRegReg rax, rsi
    x64.jcc equal, lenMatch
    x64.jmp notEqual
  lenMatch:
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
    x64.loadRegBaseDisp.word64 rdx, [rdx + 0]
    x64.loadRegBaseDisp.word64 rdi, [rcx + 24]
    x64.movRegImm32 rcx, 63
    x64.movRegReg r8, rdi
    x64.sarRegCl r8, rdi
    x64.movRegImm r9, -1
    x64.movRegReg r10, r8
    x64.xorRegReg r10, r8, r9
    x64.movRegImm32 r9, 0
    x64.subRegReg r9, r9, rdi
    x64.movRegImm32 r11, 3
    x64.movRegReg rcx, r11
    x64.shlRegCl rdi, rdi
    x64.andRegReg r9, r9, r8
    x64.andRegReg rdi, rdi, r10
    x64.orRegReg r9, r9, rdi
    x64.imulRegReg rax, rax, r9
    x64.movRegImm32 rdi, 7
    x64.leaRegRegReg rax, rax, rdi
    x64.movRegImm32 rdi, 3
    x64.movRegReg rcx, rdi
    x64.shrRegCl rax, rax
    x64.movRegImm32 rdi, 0
    x64.jmp cmphdr
  cmphdr:
    x64.cmpRegReg rdi, rax
    x64.jcc greaterEqual, allMatch
    x64.jmp cmpbody
  allMatch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  cmpbody:
    x64.leaRegRegReg rcx, rsi, rdi
    x64.loadRegBaseDisp.byte rcx, [rcx + 0]
    x64.leaRegRegReg r8, rdx, rdi
    x64.loadRegBaseDisp.byte r8, [r8 + 0]
    x64.movRegImm32 r9, 1
    x64.leaRegRegReg rdi, rdi, r9
    x64.cmpRegReg rcx, r8
    x64.jcc equal, critsplit
    x64.jmp notEqual
  critsplit:
    x64.jmp cmphdr
  notEqual:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
