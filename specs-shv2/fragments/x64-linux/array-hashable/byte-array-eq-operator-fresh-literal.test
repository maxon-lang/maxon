// Test: byte-array-eq-operator-fresh-literal
function main() returns ExitCode
	let name = "set".toByteArray()
	let probe = "set".toByteArray()
	let other = "get".toByteArray()
	if name != probe 'shouldMatch'
		return 1
	end 'shouldMatch'
	if name == other 'shouldDiffer'
		return 2
	end 'shouldDiffer'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __str_to_bytes
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __str_to_bytes
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __arr_eq
    x64.xorRegImm32 r8, r8, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, shouldMatch
    x64.jmp ifcont
  shouldMatch:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r14
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r13
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r14
    x64.callDirect __arr_eq
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, shouldDiffer
    x64.jmp ifcont
  shouldDiffer:
    x64.movRegImm32 rbx, 2
    x64.movRegReg rcx, r14
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r13
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r14
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r13
    x64.callDirect __arr_decref
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
