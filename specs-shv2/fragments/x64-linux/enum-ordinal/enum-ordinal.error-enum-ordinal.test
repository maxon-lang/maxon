// Test: enum-ordinal.error-enum-ordinal
enum Shape
	circle
	square
end 'Shape'

function main() returns ExitCode
	let s = Shape.square
	return s.ordinal
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 1
  __rc_ok:
    x64.popReg rbp
    x64.ret
}
