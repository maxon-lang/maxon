// Test: a-throwing-tiny-function-is-not-inlined
typealias Integer = int(i64.min to i64.max)

enum HalveError
	odd
end 'HalveError'

function halve(n Integer) returns Integer throws HalveError
	if n < 0 'negative'
		throw HalveError.odd
	end 'negative'
	return n / 2
end 'halve'

function main() returns ExitCode
	let v = try halve(84) otherwise 0
	return v as ExitCode
end 'main'
---
ExitCode: 42
---
func @halve {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, negative
    x64.jmp ifcont
  negative:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rsi, 2
    x64.movRegReg rax, rcx
    x64.cqo
    x64.idivReg rsi
    x64.movRegImm32 r10, 0
    x64.movRegReg r8, rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 84
    x64.callDirect halve
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
