// Test: a-loop-whose-element-access-keeps-a-slow-arm-is-not-a-leaf
typealias Integer = int(i64.min to i64.max)
typealias Bytes = Array with Byte

function totalBytes(b Bytes) returns Integer
	var t = 0
	for v in b 'each'
		t = t + v
	end 'each'
	return t
end 'totalBytes'

function main() returns ExitCode
	var b = Bytes.create()
	b.push(20 as Byte)
	b.push(22 as Byte)
	return totalBytes(b) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @totalBytes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc greaterEqual, forexit
  each:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r13*8 + 0]
    x64.jmp __im_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r13
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_cont
  __im_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
  __im_cont:
    x64.leaRegRegReg r12, r12, rax
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 22
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect totalBytes
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at a-loop-whose-element-access-keeps-a-slow-arm-is-not-a-leaf.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
