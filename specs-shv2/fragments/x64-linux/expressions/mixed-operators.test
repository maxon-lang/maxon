// Test: mixed-operators
function main() returns ExitCode
	let a = 10
	let b = 3
	return a * 2 + b - 1
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 10
    x64.imulRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 rax, rax, 3
    x64.leaRegRegImm32 r8, rax, -1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
