// Test: mixed-operators
function main() returns ExitCode
	let a = 10
	let b = 3
	return a * 2 + b - 1
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 10
    x64.imulRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 rax, rax, 3
    x64.leaRegRegImm32 r8, rax, -1
    x64.popReg rbp
    x64.ret
}
