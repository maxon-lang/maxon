// Test: compound
function main() returns ExitCode
	return (2 + 3) * 5
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 2
    x64.leaRegRegImm32 rax, rax, 3
    x64.imulRegRegImm32 r8, rax, 5
    x64.popReg rbp
    x64.ret
}
