func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect A.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_A.B]
    x64.movRegReg rcx, rbx
    x64.callDirect HoldB.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.callDirect A.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_A.B_C]
    x64.movRegReg rcx, rbx
    x64.callDirect HoldBC.create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.callDirect A_B.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_A_B.C]
    x64.movRegReg rcx, rbx
    x64.callDirect HoldC.create
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.leaRegRdata rdx, [rip + __witness_A.B]
    x64.movRegReg rcx, r12
    x64.callDirect HoldB.go
    x64.imulRegRegImm32 rbx, r8, 100
    x64.leaRegRdata rdx, [rip + __witness_A.B_C]
    x64.movRegReg rcx, r13
    x64.callDirect HoldBC.go
    x64.imulRegRegImm32 rax, r8, 10
    x64.leaRegRegReg rbx, rbx, rax
    x64.leaRegRdata rdx, [rip + __witness_A_B.C]
    x64.movRegReg rcx, r14
    x64.callDirect HoldC.go
    x64.leaRegRegReg rbx, rbx, r8
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_HoldC_A_B
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_HoldBC_A
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_HoldB_A
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
