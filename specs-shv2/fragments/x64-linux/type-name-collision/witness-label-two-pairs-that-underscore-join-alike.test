// Test: witness-label-two-pairs-that-underscore-join-alike
typealias Integer = int(0 to u32.max)

interface C
	function idc() returns Integer
end 'C'

interface B_C
	function idb() returns Integer
end 'B_C'

type A_B implements C
	export var x as Integer
	export static function create() returns Self
		return Self{ x: 0 }
	end 'create'
	export function idc() returns Integer
		return 3
	end 'idc'
end 'A_B'

type A implements B_C
	export var x as Integer
	export static function create() returns Self
		return Self{ x: 0 }
	end 'create'
	export function idb() returns Integer
		return 4
	end 'idb'
end 'A'

type HoldC uses T where T is C
	export var v as T
	export static function create(v T) returns Self
		return Self{ v: v }
	end 'create'
	export function go() returns Integer
		return self.v.idc()
	end 'go'
end 'HoldC'

type HoldB uses T where T is B_C
	export var v as T
	export static function create(v T) returns Self
		return Self{ v: v }
	end 'create'
	export function go() returns Integer
		return self.v.idb()
	end 'go'
end 'HoldB'

typealias HC = HoldC with A_B
typealias HB = HoldB with A

function main() returns ExitCode
	let h1 = HC.create(A_B.create())
	let h2 = HB.create(A.create())
	return h1.go() + h2.go() * 10
end 'main'
---
ExitCode: 43
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @A_B.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @A_B.idc {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
}

func @A.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @A.idb {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
}

func @HoldC.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @HoldC.go {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @HoldB.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @HoldB.go {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect A_B.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_A_B.C]
    x64.movRegReg rcx, rbx
    x64.callDirect HoldC.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.callDirect A.create
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.leaRegRdata rdx, [rip + __witness_A.B_C]
    x64.movRegReg rcx, rbx
    x64.callDirect HoldB.create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.leaRegRdata rdx, [rip + __witness_A_B.C]
    x64.movRegReg rcx, r12
    x64.callDirect HoldC.go
    x64.movRegReg rbx, r8
    x64.leaRegRdata rdx, [rip + __witness_A.B_C]
    x64.movRegReg rcx, r13
    x64.callDirect HoldB.go
    x64.imulRegRegImm32 rax, r8, 10
    x64.leaRegRegReg rbx, rbx, rax
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_HoldB_A
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_HoldC_A_B
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
