// Test: static-let-cross-file
// --- file: api/limits.maxon
export type Config
	export static let MAX_SIZE = 40
	export static var used = 2
end 'Config'

// --- file: app/main.maxon
function main() returns ExitCode
	Config.used = Config.used + Config.MAX_SIZE
	return Config.used
end 'main'
---
ExitCode: 42
---
data {
  __data_Config.used@0 = i64 2
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_Config.used
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 40
    x64.leaRegGlobal rcx, __data_Config.used
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_Config.used
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
