// Test: a-boxed-unions-payload-free-case-is-a-constant
typealias Integer = int(i64.min to i64.max)

union Boxed
	plain
	withPayload(n Integer)
end 'Boxed'

let boxedCase = Boxed.plain

function main() returns ExitCode
	return match boxedCase 'k'
		plain gives 0
		withPayload(n) gives n as ExitCode
	end 'k'
end 'main'
---
ExitCode: 0
---
data {
  __data_boxedCase@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_boxedCase
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#7
    x64.jmp __rc_chk#8
  __rc_chk#8:
    x64.cmpRegImm32 rax, 255
    x64.jcc greater, __rc_panic#7
    x64.jmp __rc_ok#6
  __rc_panic#7:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#6:
    x64.leaRegRegImm32 r8, rax, 0
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#10
    x64.jmp __rc_chk#11
  __rc_chk#11:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic#10
    x64.jmp __rc_ok#9
  __rc_panic#10:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#9:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
