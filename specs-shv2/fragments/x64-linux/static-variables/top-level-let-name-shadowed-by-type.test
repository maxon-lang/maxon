// Test: top-level-let-name-shadowed-by-type
typealias Integer = int(i64.min to i64.max)

let Widget = "abcdefghij"

type Widget
	export var v as Integer

	export static function byteLength() returns Integer
		return 42
	end 'byteLength'
end 'Widget'

function main() returns ExitCode
	return Widget.byteLength() as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  __il_body:
    x64.movRegImm32 r8, 42
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
