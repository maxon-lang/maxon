// Test: top-level-var-multiple
var a = 1
var b = 2
var c = 3

function main() returns ExitCode
	a = a * 10
	b = b * 10
	c = c * 10
	return a + b + c
end 'main'
---
ExitCode: 60
---
data {
  __data_a@0 = i64 1
  __data_b@8 = i64 2
  __data_c@16 = i64 3
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegGlobal rax, __data_a
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegGlobal rcx, __data_a
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_b
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegGlobal rcx, __data_b
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_c
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.imulRegRegImm32 rax, rax, 10
    x64.leaRegGlobal rcx, __data_c
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.leaRegGlobal rax, __data_a
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegGlobal rcx, __data_b
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg rax, rax, rcx
    x64.leaRegGlobal rcx, __data_c
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
