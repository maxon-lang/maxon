// Test: top-level-let-array-literal
let NUMS = [10, 20, 30]

function main() returns ExitCode
	let a = try NUMS.get(0) otherwise 0
	let b = try NUMS.get(2) otherwise 0
	return a + b
end 'main'
---
ExitCode: 40
---
data {
  __data_NUMS@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegGlobal rax, __data_NUMS
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rbx, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rbx, r8
    x64.jmp trycont
  trycont:
    x64.leaRegGlobal rax, __data_NUMS
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.movRegImm32 rdx, 2
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg r8, rbx, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
