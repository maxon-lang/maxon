// Test: top-level-var-increment

typealias Integer = int(i64.min to i64.max)

var total = 10

function add(n Integer)
	total = total + n
end 'add'

function main() returns ExitCode
	add(5)
	add(27)
	return total
end 'main'
---
ExitCode: 42
---
data {
  __data_total@0 = i64 10
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.jmp __il_body#6
  __il_body#6:
    x64.leaRegGlobal rax, __data_total
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 5
    x64.leaRegGlobal rcx, __data_total
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.jmp __il_body#7
  __il_body#7:
    x64.leaRegGlobal rax, __data_total
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 27
    x64.leaRegGlobal rcx, __data_total
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp __il_cont#4
  __il_cont#4:
    x64.leaRegGlobal rax, __data_total
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
