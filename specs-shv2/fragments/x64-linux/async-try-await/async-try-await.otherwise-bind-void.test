// Test: async-try-await.otherwise-bind-void
enum TaskError implements Error
	timedOut
	crashed
end 'TaskError'

var flag = 0

function maySetFlag(succeed bool) throws TaskError
	Runtime.yield()
	if succeed 'ok'
		flag = 1
		return
	end 'ok'
	throw TaskError.crashed
end 'maySetFlag'

function main() returns ExitCode
	let p = async maySetFlag(false)
	try await p otherwise (e) 'failed'
		flag = match e 'which'
			timedOut gives 7
			crashed gives 9
		end 'which'
	end 'failed'
	return flag as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __data_flag@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
