// Test: slice-of-empty-array-then-push
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
	let empty = IntArray.create()
	var e = try empty.slice(0, endIndex: 0) otherwise return 1
	e.push(5)
	let v = try e.get(0) otherwise 0
	if v == 5 and e.count() == 1 and empty.count() == 0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_slice
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 rax, 5
    x64.movRegImm32 rax, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 1
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.cmpRegImm32 r8, 0
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
