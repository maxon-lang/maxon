// Test: slice-parent-grows-while-view-lives
function main() returns ExitCode
	var arr = [10, 20, 30]
	let sub = try arr.slice(0, endIndex: 3) otherwise return 1
	arr.push(40)
	arr.push(50)
	let s0 = try sub.get(0) otherwise 0
	let s2 = try sub.get(2) otherwise 0
	let a3 = try arr.get(3) otherwise 0
	if s0 == 10 and s2 == 30 and sub.count() == 3 and a3 == 40 and arr.count() == 5 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_slice
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 40
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 50
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r12
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r13, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r14, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r14, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r15, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r15, r8
    x64.jmp trycont
  trycont:
    x64.cmpRegImm32 r13, 10
    x64.movRegImm32 rax, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r14, 30
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegReg rcx, r12
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 3
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r15, 40
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 5
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
