// Test: appendMemory-copies-a-raw-buffers-elements
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var a = ByteArray.create()
	a.push(7)
	var piece = try __ManagedMemory.create(4, 1) otherwise return 9
	try piece.set(0, 20) otherwise return 8
	try piece.set(1, 30) otherwise return 8
	try piece.setLength(2) otherwise return 8
	a.appendMemory(piece)
	var sum = 0
	var i = 0
	while i < a.count() 'loop'
		sum = sum + (try a.get(i) otherwise 0)
		i = i + 1
	end 'loop'
	return sum as ExitCode
end 'main'
---
ExitCode: 57
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_mem_create
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 9
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 20
    x64.movRegReg rcx, r12
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  tryerr#4:
    x64.movRegImm32 r13, 8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 30
    x64.movRegReg rcx, r12
    x64.callDirect __managed_mem_set
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.movRegImm32 r13, 8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.movRegImm32 r13, 8
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_append
    x64.movRegImm32 r13, 0
    x64.movRegImm32 r14, 0
    x64.jmp whilehdr
  whilehdr:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_count
    x64.cmpRegReg r14, r8
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#13
    x64.jmp tryok#12
  tryerr#13:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok#12:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg r13, r13, rax
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r13, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r13, r13, 0
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
