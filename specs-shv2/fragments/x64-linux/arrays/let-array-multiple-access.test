// Test: let-array-multiple-access
function main() returns ExitCode
	let arr = [5, 10, 15, 20]
	let a = try arr.get(0) otherwise 0
	let b = try arr.get(3) otherwise 0
	return a + b
end 'main'
---
ExitCode: 25
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 10
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 15
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 20
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 rax, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg rax, r8
    x64.jmp trycont
  trycont:
    x64.leaRegRegReg r12, r12, rax
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
