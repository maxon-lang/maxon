// Test: an-array-literal-element-is-not-a-character
function main() returns ExitCode
	let a = ['é', 'ö']
	print("{a.count()}\n")
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:3:11: Unsupported: an array literal element of type 'Character' — a literal's elements are an integer, a float, a bool, a String, a struct, or a boxed union (a bare `[…]` infers the type from the first element)
