// Test: closure-capture.field-declared-after-a-closure-bearing-method

typealias Integer = int(i64.min to i64.max)

type Pair
	export var first as Integer

	static function make(seed Integer) returns Self
		let step = function(k Integer) gives k + 1
		return Self{first: step(seed), second: 2}
	end 'make'

	export var second as Integer
end 'Pair'

function main() returns ExitCode
	let p = Pair.make(39)
	return p.first * p.second
end 'main'
---
ExitCode: 80
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegFunc rbx, [rip + Pair.make$closure_0]
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 2
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pair.make$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 39
    x64.callDirect Pair.make
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.imulRegReg rbx, rbx, rax
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
