// Test: inner-alias-shadowing-another-type-wins-at-the-static-door
typealias ExitCode = int(0 to 125)

type Pair uses T
	export var a as T

	export static function create(a T) returns Self
		return Self{a: a}
	end 'create'
end 'Pair'

type Other
	export var b as ExitCode

	export static function create(v ExitCode) returns Self
		return Self{b: v}
	end 'create'
end 'Other'

type Plain
	typealias Other = Pair with ExitCode

	static function make() returns ExitCode
		let p = Other.create(9)
		return p.a
	end 'make'
end 'Plain'

function main() returns ExitCode
	return Plain.make()
end 'main'
---
ExitCode: 9
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Plain.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 9
    x64.callDirect Pair.create
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Plain.make
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
