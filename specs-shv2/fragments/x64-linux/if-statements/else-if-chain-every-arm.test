// Test: else-if-chain-every-arm
function classify(x int) returns int
	if x == 0 'zero'
		return 0
	end 'zero' else if x < 10 'small'
		return 1
	end 'small' else if x < 100 'medium'
		return 2
	end 'medium' else 'large'
		return 3
	end 'large'
end 'classify'

function main() returns ExitCode
	if classify(0) != 0 'zeroArm'
		return 1
	end 'zeroArm'

	if classify(5) != 1 'smallArm'
		return 2
	end 'smallArm'

	if classify(50) != 2 'mediumArm'
		return 3
	end 'mediumArm'

	if classify(200) != 3 'largeArm'
		return 4
	end 'largeArm'

	return 0
end 'main'
---
ExitCode: 0
---
func @classify {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, zero
    x64.jmp ifelse#2
  zero:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifelse#2:
    x64.cmpRegImm32 rcx, 10
    x64.jcc less, small
    x64.jmp ifelse#4
  small:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifelse#4:
    x64.cmpRegImm32 rcx, 100
    x64.jcc less, medium
    x64.jmp ifelse#6
  medium:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifelse#6:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#7:
  ifcont#8:
  ifcont#9:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 0
    x64.callDirect classify
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, zeroArm
    x64.jmp ifcont#2
  zeroArm:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rcx, 5
    x64.callDirect classify
    x64.cmpRegImm32 r8, 1
    x64.jcc notEqual, smallArm
    x64.jmp ifcont#4
  smallArm:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rcx, 50
    x64.callDirect classify
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, mediumArm
    x64.jmp ifcont#6
  mediumArm:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rcx, 200
    x64.callDirect classify
    x64.cmpRegImm32 r8, 3
    x64.jcc notEqual, largeArm
    x64.jmp ifcont#8
  largeArm:
    x64.movRegImm32 r8, 4
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
