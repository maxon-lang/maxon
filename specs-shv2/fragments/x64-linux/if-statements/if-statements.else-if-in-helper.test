// Test: if-statements.else-if-in-helper

typealias Integer = int(i64.min to i64.max)

function classify(x Integer) returns Integer
	if x == 0 'zero'
		return 0
	end 'zero' else if x < 10 'small'
		return 1
	end 'small' else if x < 100 'medium'
		return 2
	end 'medium' else 'large'
		return 3
	end 'large'
end 'classify'

function main() returns ExitCode
	let a = classify(0)
	let b = classify(5)
	let c = classify(50)
	let d = classify(200)
	return a + b * 3 + c * 9 + d * 27
end 'main'
---
ExitCode: 102
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  zero:
    x64.movRegImm32 rax, 0
  small:
    x64.movRegImm32 rcx, 1
  medium:
    x64.movRegImm32 rdx, 2
  ifelse:
    x64.movRegImm32 rsi, 3
  __il_cont:
    x64.imulRegRegImm32 rcx, rcx, 3
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rdx, 9
    x64.leaRegRegReg rax, rax, rcx
    x64.imulRegRegImm32 rcx, rsi, 27
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
