// Test: if-statements.nested-if-with-multiple-returns

typealias Integer = int(i64.min to i64.max)

function test(c Integer, next Integer) returns Integer
	if c == 0 'maybePrefix'
		if next == 1 'isHex'
			return 1
		end 'isHex'
		if next == 2 'isBinary'
			return 2
		end 'isBinary'
	end 'maybePrefix'
	return 42
end 'test'

function main() returns ExitCode
	return test(5, next: 0)
end 'main'
---
ExitCode: 42
---
func @test {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, maybePrefix
    x64.jmp ifcont#6
  maybePrefix:
    x64.cmpRegImm32 rdx, 1
    x64.jcc equal, isHex
    x64.jmp ifcont#3
  isHex:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#3:
    x64.cmpRegImm32 rdx, 2
    x64.jcc equal, isBinary
    x64.jmp ifcont#5
  isBinary:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#5:
    x64.jmp ifcont#6
  ifcont#6:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 0
    x64.callDirect test
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
