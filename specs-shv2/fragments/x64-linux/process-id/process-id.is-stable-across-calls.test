// Test: process-id.is-stable-across-calls
function main() returns ExitCode
	let first = __Builtins.currentProcessId()
	let second = __Builtins.currentProcessId()
	let third = __Builtins.currentProcessId()
	var score = 0
	if first == second 'firstPair'
		score = score + 1
	end 'firstPair'
	if second == third 'secondPair'
		score = score + 3
	end 'secondPair'
	return score as ExitCode
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __proc_pid
    x64.movRegReg rbx, r8
    x64.callDirect __proc_pid
    x64.movRegReg r12, r8
    x64.callDirect __proc_pid
    x64.movRegImm32 rax, 0
    x64.cmpRegReg rbx, r12
    x64.jcc notEqual, ifcont#2
  firstPair:
    x64.movRegImm32 rax, 1
  ifcont#2:
    x64.cmpRegReg r12, r8
    x64.jcc notEqual, critsplit
  secondPair:
    x64.leaRegRegImm32 r8, rax, 3
    x64.jmp ifcont#4
  critsplit:
    x64.movRegReg r8, rax
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at process-id.is-stable-across-calls.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
