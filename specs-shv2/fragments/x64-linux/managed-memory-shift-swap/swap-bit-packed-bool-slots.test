// Test: swap-bit-packed-bool-slots
typealias Flags = Array with bool

function main() returns ExitCode
	var flags = Flags.create()
	flags.push(true)
	flags.push(false)
	flags.push(false)
	try flags.managed.swap(0, j: 1) otherwise return 99
	let atZero = try flags.get(0) otherwise true
	let atOne = try flags.get(1) otherwise false
	var total = 0
	if atZero 'zero'
		total = total + 1
	end 'zero'
	if atOne 'one'
		total = total + 2
	end 'one'
	return total
end 'main'
---
ExitCode: 2
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm rcx, 18446744073709551615
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_mem_swap
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 r12, 99
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#4
    x64.jmp tryok#3
  tryerr#4:
    x64.movRegImm32 r12, 1
    x64.jmp trycont#5
  tryok#3:
    x64.movRegReg r12, r8
    x64.jmp trycont#5
  trycont#5:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#7
    x64.jmp tryok#6
  tryerr#7:
    x64.movRegImm32 rax, 0
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg rax, r8
    x64.jmp trycont#8
  trycont#8:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r12, 0
    x64.jcc notEqual, zero
    x64.jmp critsplit#16
  zero:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp ifcont#10
  critsplit#16:
    x64.jmp ifcont#10
  ifcont#10:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, one
    x64.jmp critsplit#17
  one:
    x64.leaRegRegImm32 r12, rcx, 2
    x64.jmp ifcont#12
  critsplit#17:
    x64.movRegReg r12, rcx
    x64.jmp ifcont#12
  ifcont#12:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
