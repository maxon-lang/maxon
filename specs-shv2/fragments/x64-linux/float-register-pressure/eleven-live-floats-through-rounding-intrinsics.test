// Test: eleven-live-floats-through-rounding-intrinsics
typealias Wide = float(f64.min to f64.max)

function scatter(a Wide) returns Wide
	let v0 = floor(a + 0.5)
	let v1 = ceil(a + 1.5)
	let v2 = round(a + 2.5)
	let v3 = sqrt(a + 3.0)
	let v4 = floor(a + 4.5)
	let v5 = ceil(a + 5.5)
	let v6 = round(a + 6.5)
	let v7 = sqrt(a + 7.0)
	let v8 = floor(a + 8.5)
	let v9 = ceil(a + 9.5)
	let v10 = round(a + 10.5)
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10
end 'scatter'

function main() returns ExitCode
	return trunc(scatter(1.0))
end 'main'
---
ExitCode: 64
---
func @scatter {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.storeSlotReg slot2, xmm8
    x64.storeSlotReg slot3, xmm9
    x64.storeSlotReg slot4, xmm10
    x64.storeSlotReg slot5, xmm11
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.movRegReg xmm2, xmm0
    x64.addsdRegReg xmm2, xmm0, xmm1
    x64.roundsdRegReg.towardNegative xmm1, xmm2
    x64.movsdRegRip xmm2, [rip + __fconst_2]
    x64.movRegReg xmm3, xmm0
    x64.addsdRegReg xmm3, xmm0, xmm2
    x64.roundsdRegReg.towardPositive xmm2, xmm3
    x64.movsdRegRip xmm3, [rip + __fconst_3]
    x64.movRegReg xmm4, xmm0
    x64.addsdRegReg xmm4, xmm0, xmm3
    x64.roundsdRegReg.nearestTiesToEven xmm3, xmm4
    x64.movsdRegRip xmm4, [rip + __fconst_4]
    x64.movRegReg xmm5, xmm0
    x64.addsdRegReg xmm5, xmm0, xmm4
    x64.sqrtsdRegReg xmm4, xmm5
    x64.movsdRegRip xmm5, [rip + __fconst_5]
    x64.movRegReg xmm6, xmm0
    x64.addsdRegReg xmm6, xmm0, xmm5
    x64.roundsdRegReg.towardNegative xmm5, xmm6
    x64.movsdRegRip xmm6, [rip + __fconst_6]
    x64.movRegReg xmm7, xmm0
    x64.addsdRegReg xmm7, xmm0, xmm6
    x64.roundsdRegReg.towardPositive xmm6, xmm7
    x64.movsdRegRip xmm7, [rip + __fconst_7]
    x64.movRegReg xmm8, xmm0
    x64.addsdRegReg xmm8, xmm0, xmm7
    x64.roundsdRegReg.nearestTiesToEven xmm7, xmm8
    x64.movsdRegRip xmm8, [rip + __fconst_8]
    x64.movRegReg xmm9, xmm0
    x64.addsdRegReg xmm9, xmm0, xmm8
    x64.sqrtsdRegReg xmm8, xmm9
    x64.movsdRegRip xmm9, [rip + __fconst_9]
    x64.movRegReg xmm10, xmm0
    x64.addsdRegReg xmm10, xmm0, xmm9
    x64.roundsdRegReg.towardNegative xmm9, xmm10
    x64.movsdRegRip xmm10, [rip + __fconst_10]
    x64.movRegReg xmm11, xmm0
    x64.addsdRegReg xmm11, xmm0, xmm10
    x64.roundsdRegReg.towardPositive xmm10, xmm11
    x64.movsdRegRip xmm11, [rip + __fconst_11]
    x64.addsdRegReg xmm0, xmm0, xmm11
    x64.roundsdRegReg.nearestTiesToEven xmm0, xmm0
    x64.addsdRegReg xmm1, xmm1, xmm2
    x64.addsdRegReg xmm1, xmm1, xmm3
    x64.addsdRegReg xmm1, xmm1, xmm4
    x64.addsdRegReg xmm1, xmm1, xmm5
    x64.addsdRegReg xmm1, xmm1, xmm6
    x64.addsdRegReg xmm1, xmm1, xmm7
    x64.addsdRegReg xmm1, xmm1, xmm8
    x64.addsdRegReg xmm1, xmm1, xmm9
    x64.addsdRegReg xmm1, xmm1, xmm10
    x64.addsdRegReg xmm1, xmm1, xmm0
    x64.movRegReg xmm0, xmm1
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.loadRegSlot xmm8, slot2
    x64.loadRegSlot xmm9, slot3
    x64.loadRegSlot xmm10, slot4
    x64.loadRegSlot xmm11, slot5
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm0, [rip + __fconst_12]
    x64.callDirect scatter
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
