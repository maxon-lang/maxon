// Test: first-class-function.function-value-as-arg-errors

typealias Integer = int(i64.min to i64.max)

function dbl(n Integer) returns Integer
	return n * 2
end 'dbl'

function takesInt(n Integer) returns Integer
	return n
end 'takesInt'

function main() returns ExitCode
	return takesInt(dbl) as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:14:9: cannot pass a value of type 'function' as argument 'n', which holds 'int': a function value is only usable where a function type declared with 'typealias' is expected
