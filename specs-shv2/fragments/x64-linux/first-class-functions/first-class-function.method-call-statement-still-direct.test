// Test: first-class-function.method-call-statement-still-direct
var sideEffect = 0

typealias Ticks = int(i64.min to i64.max)

type Counter
	export var n as Ticks

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function tick()
		sideEffect = sideEffect + 3
	end 'tick'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	c.tick()
	c.tick()
	return sideEffect as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __data_sideEffect@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @Counter.tick {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegGlobal rax, __data_sideEffect
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.leaRegRegImm32 rax, rax, 3
    x64.leaRegGlobal rcx, __data_sideEffect
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegSlot rbx, slot0
    x64.movRegImm32 rax, 0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect Counter.tick
    x64.movRegReg rcx, rbx
    x64.callDirect Counter.tick
    x64.leaRegGlobal rax, __data_sideEffect
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
