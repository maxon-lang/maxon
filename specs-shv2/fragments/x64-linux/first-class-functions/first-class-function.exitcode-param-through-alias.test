// Test: first-class-function.exitcode-param-through-alias
typealias Outcome = int(0 to u32.max)
typealias Bump = function(ExitCode) returns Outcome

function bump(c ExitCode) returns Outcome
	return c + 1
end 'bump'

function applyIt(f Bump, c ExitCode) returns Outcome
	return f(c)
end 'applyIt'

function main() returns ExitCode
	return applyIt(bump, c: 8)
end 'main'
---
ExitCode: 9
---
func @bump {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#2
  __rc_chk#3:
    x64.cmpRegImm32 rcx, 255
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.leaRegRegImm32 r8, rcx, 1
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#5
  __rc_chk#6:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @applyIt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callReg rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + __fnref_bump]
    x64.movRegImm32 rdx, 8
    x64.movRegImm32 rax, 0
    x64.callDirect applyIt
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_3]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
