// Test: first-class-function.bool-param-through-fnref-thunk
typealias Integer = int(i64.min to i64.max)
typealias BoolFn = function(bool) returns Integer

function takesBool(loud bool) returns Integer
	return 7 if loud else 3
end 'takesBool'

function apply(f BoolFn) returns Integer
	return f(true)
end 'apply'

function main() returns ExitCode
	return apply(takesBool) as ExitCode
end 'main'
---
ExitCode: 7
---
func @takesBool {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 7
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 3
  matchcont:
    x64.popReg rbp
    x64.ret
}

func @apply {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 1
    x64.callReg rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegFunc rcx, [rip + __fnref_takesBool]
    x64.movRegImm32 rdx, 0
    x64.callDirect apply
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
