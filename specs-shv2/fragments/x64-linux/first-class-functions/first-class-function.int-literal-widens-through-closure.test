// Test: first-class-function.int-literal-widens-through-closure

typealias Ratio = float(0.0 to 1000.0)

function main() returns ExitCode
	let f = function(x Ratio) gives x * 2.0
	return trunc(f(3)) as ExitCode
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rbx, [rip + main$closure_0]
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 0
    x64.cvtsi2sdRegReg xmm0, rax
    x64.callReg rbx
    x64.cvttsd2siRegReg r8, xmm0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at first-class-function.int-literal-widens-through-closure.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, __rc_panic
  __rc_chk:
    x64.movsdRegRip xmm1, [rip + __fconst_1000]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc belowEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at first-class-function.int-literal-widens-through-closure.test:6: Range check failed: value outside typealias 'Ratio'\x0a"
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movsdRegRip xmm1, [rip + __fconst_2]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
