func @findGraphemeEnd {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
    x64.cmpRegReg r12, r13
    x64.jcc greaterEqual, atEnd
    x64.jmp ifcont
  atEnd:
    x64.movRegReg r8, r12
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.jcc less, isAscii
    x64.jmp ifcont
  isAscii:
    x64.cmpRegImm32 r8, 13
    x64.jcc equal, isCR
    x64.jmp ifcont
  isCR:
    x64.leaRegRegImm32 rax, r12, 1
    x64.cmpRegReg rax, r13
    x64.jcc less, hasNext
    x64.jmp ifcont
  hasNext:
    x64.leaRegRegImm32 rdx, r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_7]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 10
    x64.jcc equal, isCRLF
    x64.jmp ifcont
  isCRLF:
    x64.leaRegRegImm32 r8, r12, 2
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 rax, r12, 1
    x64.cmpRegReg rax, r13
    x64.jcc less, hasNextByte
    x64.jmp ifelse
  hasNextByte:
    x64.leaRegRegImm32 rdx, r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_8]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.jcc greaterEqual, nextIsMultibyte
    x64.jmp ifelse
  nextIsMultibyte:
    x64.leaRegRegImm32 rdx, r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect utf8DecodeAt
    x64.movRegReg rcx, r8
    x64.callDirect graphemeBreakProperty
    x64.cmpRegImm32 r8, 4
    x64.movRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r8, 5
    x64.setccReg notEqual, rax
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r8, 8
    x64.setccReg notEqual, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, notCombining
    x64.jmp ifcont
  notCombining:
    x64.leaRegRegImm32 r8, r12, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.jmp ifcont
  ifcont:
    x64.jmp ifcont
  ifelse:
    x64.leaRegRegImm32 r8, r12, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.leaRegRegImm32 r8, r12, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect utf8DecodeAt
    x64.movRegReg r14, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect utf8ByteLengthAt
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, r14
    x64.callDirect graphemeBreakProperty
    x64.movRegReg r15, r8
    x64.callDirect graphemeStateInit
    x64.movRegReg rcx, r8
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r14
    x64.callDirect graphemeStateUpdate
    x64.movRegReg rdx, r12
    x64.jmp whilehdr
  whilehdr:
    x64.storeSlotReg slot1, r8
    x64.storeSlotReg slot0, rdx
    x64.cmpRegReg rdx, r13
    x64.jcc less, scan
    x64.jmp whileexit
  scan:
    x64.movRegReg rcx, rbx
    x64.callDirect utf8DecodeAt
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect graphemeBreakProperty
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r15
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.loadRegSlot r9, slot1
    x64.callDirect isGraphemeBreak
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, breakFound
    x64.jmp ifcont
  breakFound:
    x64.loadRegSlot r8, slot0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegSlot rcx, slot1
    x64.movRegReg rdx, r14
    x64.movRegReg rax, r12
    x64.callDirect graphemeStateUpdate
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.loadRegSlot r15, slot0
    x64.movRegReg rdx, r15
    x64.callDirect utf8ByteLengthAt
    x64.leaRegRegReg rdx, r15, r8
    x64.movRegReg r15, r14
    x64.movRegReg r8, r12
    x64.jmp whilehdr
  whileexit:
    x64.loadRegSlot r8, slot0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @countGraphemes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect String.hasSingleByteGraphemes
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, oneByteEach
    x64.jmp ifcont
  oneByteEach:
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 0
    x64.movRegImm32 rdx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegReg rdx, r12
    x64.jcc less, countLoop
    x64.jmp whileexit
  countLoop:
    x64.movRegReg rcx, rbx
    x64.callDirect findGraphemeEnd
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rdx, r8
    x64.jmp whilehdr
  whileexit:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @graphemeBreakProperty {
