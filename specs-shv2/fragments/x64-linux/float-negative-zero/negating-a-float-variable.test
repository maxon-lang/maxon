// Test: negating-a-float-variable
function main() returns ExitCode
	let f = 3.5
	let g = -f
	return trunc(g + 45.5)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.movsdRegRip xmm1, [rip + __fconst_1]
    x64.subsdRegReg xmm1, xmm1, xmm0
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.addsdRegReg xmm1, xmm1, xmm0
    x64.cvttsd2siRegReg r8, xmm1
    x64.popReg rbp
    x64.ret
}
