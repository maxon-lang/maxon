// Test: negative-zero-literal-keeps-its-sign
typealias Wide = float(f64.min to f64.max)

function reciprocal(x Wide) returns Wide
	return 1.0 / x
end 'reciprocal'

function main() returns ExitCode
	let negZero = -0.0
	let posZero = 0.0
	if reciprocal(negZero) < reciprocal(posZero) 'signed'
		return 42
	end 'signed'
	return 0
end 'main'
---
ExitCode: 42
---
func @reciprocal {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm1, [rip + __fconst_0]
    x64.divsdRegReg xmm1, xmm1, xmm0
    x64.movRegReg xmm0, xmm1
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.movsdRegRip xmm6, [rip + __fconst_2]
    x64.callDirect reciprocal
    x64.movRegReg xmm7, xmm0
    x64.movRegReg xmm0, xmm6
    x64.callDirect reciprocal
    x64.ucomisdRegReg xmm0, xmm7
    x64.jcc above, signed
    x64.jmp ifcont
  signed:
    x64.movRegImm32 r8, 42
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
