// Test: conformance-argument-in-parentheses-is-a-tuple-type

typealias Integer = int(i64.min to i64.max)
typealias Float = float(f64.min to f64.max)

interface One uses A
	function get() returns A
end 'One'

type Holder implements One with ((Integer, Float))
	let v as Integer
	let f as Float

	function get() returns (Integer, Float)
		return (v, f)
	end 'get'

	static function create(v Integer, f Float) returns Self
		return Self{v: v, f: f}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(42, f: 1.5)
	let t = h.get()
	return t.0
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.storeSlotReg slot0, xmm6
    x64.loadRegBaseDisp.word64 rbx, [rcx + 0]
    x64.loadRegBaseDisp.word64 xmm6, [rcx + 8]
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], xmm6
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 56
    x64.movRegImm32 rax, 42
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.storeBaseDispReg.word64 [rcx + 8], xmm0
    x64.callDirect Holder.get
    x64.loadRegBaseDisp.word64 rbx, [r8 + 0]
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
