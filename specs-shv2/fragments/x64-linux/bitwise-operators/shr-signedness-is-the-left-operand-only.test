// Test: shr-signedness-is-the-left-operand-only
typealias Num = int(i64.min to i64.max)
typealias ShiftBits = int(0 to 63)

function shiftRight(value Num, distance ShiftBits) returns Num
	return value shr distance
end 'shiftRight'

function main() returns ExitCode
	if shiftRight(0 - 8, distance: 60) != 0 - 1 'rangedDistance'
		return 1
	end 'rangedDistance'
	if shiftRight(0 - 1, distance: 63) != 0 - 1 'allSign'
		return 2
	end 'allSign'
	if shiftRight(8, distance: 2) != 2 'nonNegative'
		return 3
	end 'nonNegative'
	return 42
end 'main'
---
ExitCode: 42
---
func @shiftRight {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegReg r8, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rdx, 63
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rdx
    x64.sarRegCl r8, r8
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -8
    x64.movRegImm32 rdx, 60
    x64.jmp __il_body#8
  __il_body#8:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow#11
    x64.jmp __rc_chk#10
  __rc_chk#10:
    x64.cmpRegImm32 rdx, 63
    x64.jcc greater, __il_slow#11
    x64.jmp __rc_ok#9
  __il_slow#11:
    x64.callDirect shiftRight
    x64.jmp __il_cont#7
  __rc_ok#9:
    x64.sarRegImm8 rcx, rcx, 60
    x64.movRegReg r8, rcx
    x64.jmp __il_cont#7
  __il_cont#7:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -1
    x64.cmpRegReg r8, rax
    x64.jcc notEqual, rangedDistance
    x64.jmp ifcont#2
  rangedDistance:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rcx, rax, -1
    x64.movRegImm32 rdx, 63
    x64.jmp __il_body#13
  __il_body#13:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow#16
    x64.jmp __rc_chk#15
  __rc_chk#15:
    x64.cmpRegImm32 rdx, 63
    x64.jcc greater, __il_slow#16
    x64.jmp __rc_ok#14
  __il_slow#16:
    x64.callDirect shiftRight
    x64.jmp __il_cont#12
  __rc_ok#14:
    x64.sarRegImm8 rcx, rcx, 63
    x64.movRegReg r8, rcx
    x64.jmp __il_cont#12
  __il_cont#12:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -1
    x64.cmpRegReg r8, rax
    x64.jcc notEqual, allSign
    x64.jmp ifcont#4
  allSign:
    x64.movRegImm32 r8, 2
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 2
    x64.jmp __il_body#18
  __il_body#18:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow#21
    x64.jmp __rc_chk#20
  __rc_chk#20:
    x64.cmpRegImm32 rdx, 63
    x64.jcc greater, __il_slow#21
    x64.jmp __rc_ok#19
  __il_slow#21:
    x64.callDirect shiftRight
    x64.jmp __il_cont#17
  __rc_ok#19:
    x64.sarRegImm8 rcx, rcx, 2
    x64.movRegReg r8, rcx
    x64.jmp __il_cont#17
  __il_cont#17:
    x64.cmpRegImm32 r8, 2
    x64.jcc notEqual, nonNegative
    x64.jmp ifcont#6
  nonNegative:
    x64.movRegImm32 r8, 3
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r8, 42
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
