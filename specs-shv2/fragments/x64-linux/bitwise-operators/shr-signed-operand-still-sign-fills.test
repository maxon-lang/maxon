// Test: shr-signed-operand-still-sign-fills
typealias Num = int(i64.min to i64.max)

function shrConst(v Num) returns Num
	return v shr 60
end 'shrConst'

function shrDynamic(v Num, d Num) returns Num
	return v shr d
end 'shrDynamic'

function shrPastWidth(v Num) returns Num
	return v shr 100
end 'shrPastWidth'

function main() returns ExitCode
	if shrConst(0 - 8) != 0 - 1 'foldedCount'
		return 1
	end 'foldedCount'
	if shrDynamic(0 - 8, d: 60) != 0 - 1 'dynamicCount'
		return 2
	end 'dynamicCount'

	// A sign-filling shift saturates to the SIGN, not to 0: `x shr 63` already IS the sign.
	if shrPastWidth(0 - 8) != 0 - 1 'foldedPastWidth'
		return 3
	end 'foldedPastWidth'
	if shrDynamic(0 - 8, d: 100) != 0 - 1 'dynamicPastWidth'
		return 4
	end 'dynamicPastWidth'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -8
    x64.jmp __il_body#10
  __il_body#10:
    x64.sarRegImm8 rax, rax, 60
    x64.jmp __il_cont#9
  __il_cont#9:
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, foldedCount
    x64.jmp ifcont#2
  foldedCount:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -8
    x64.movRegImm32 rcx, 60
    x64.jmp __il_body#12
  __il_body#12:
    x64.andRegImm32 rcx, rcx, -64
    x64.movRegReg rdx, rcx
    x64.negReg rdx, rcx
    x64.orRegReg rcx, rcx, rdx
    x64.sarRegImm8 rcx, rcx, 63
    x64.orRegImm32 rcx, rcx, 60
    x64.sarRegCl rax, rax
    x64.jmp __il_cont#11
  __il_cont#11:
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, dynamicCount
    x64.jmp ifcont#4
  dynamicCount:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -8
    x64.jmp __il_body#14
  __il_body#14:
    x64.sarRegImm8 rax, rax, 63
    x64.jmp __il_cont#13
  __il_cont#13:
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, foldedPastWidth
    x64.jmp ifcont#6
  foldedPastWidth:
    x64.movRegImm32 r8, 3
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 rax, rax, -8
    x64.movRegImm32 rcx, 100
    x64.jmp __il_body#16
  __il_body#16:
    x64.andRegImm32 rcx, rcx, -64
    x64.movRegReg rdx, rcx
    x64.negReg rdx, rcx
    x64.orRegReg rcx, rcx, rdx
    x64.sarRegImm8 rcx, rcx, 63
    x64.orRegImm32 rcx, rcx, 100
    x64.sarRegCl rax, rax
    x64.jmp __il_cont#15
  __il_cont#15:
    x64.movRegImm32 rcx, 0
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.cmpRegReg rax, rcx
    x64.jcc notEqual, dynamicPastWidth
    x64.jmp ifcont#8
  dynamicPastWidth:
    x64.movRegImm32 r8, 4
    x64.popReg rbp
    x64.ret
  ifcont#8:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
