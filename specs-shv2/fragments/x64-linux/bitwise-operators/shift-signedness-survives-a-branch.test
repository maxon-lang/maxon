// Test: shift-signedness-survives-a-branch
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function afterBranch(v Wide, flag bool) returns Wide
	if flag 'taken'
		return v shr 60
	end 'taken'
	return 0
end 'afterBranch'

function insideLoop(v Wide, n Num) returns Wide
	var acc = 0
	var i = 0
	while i < n 'each'
		acc = v shr 60
		i = i + 1
	end 'each'
	return acc
end 'insideLoop'

function main() returns ExitCode
	if afterBranch(u64.max, flag: true) != 15 'branch'
		return 1
	end 'branch'
	if insideLoop(u64.max, n: 3) != 15 'loop'
		return 2
	end 'loop'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm rax, 18446744073709551615
    x64.movRegImm32 rcx, 1
    x64.jmp __il_body#6
  __il_body#6:
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, taken
    x64.jmp ifcont#8
  taken:
    x64.shrRegImm8 rax, rax, 60
    x64.jmp __il_cont#5
  ifcont#8:
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont#5
  __il_cont#5:
    x64.cmpRegImm32 rax, 15
    x64.jcc notEqual, branch
    x64.jmp ifcont#2
  branch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp __il_body#10
  __il_body#10:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rdx, 3
    x64.jcc less, each
    x64.jmp whileexit
  each:
    x64.movRegReg rcx, rax
    x64.shrRegImm8 rcx, rax, 60
    x64.leaRegRegImm32 rdx, rdx, 1
    x64.jmp whilehdr
  whileexit:
    x64.jmp __il_cont#9
  __il_cont#9:
    x64.cmpRegImm32 rcx, 15
    x64.jcc notEqual, loop
    x64.jmp ifcont#4
  loop:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
