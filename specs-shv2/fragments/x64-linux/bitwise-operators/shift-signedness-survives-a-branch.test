// Test: shift-signedness-survives-a-branch
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function afterBranch(v Wide, flag bool) returns Wide
	if flag 'taken'
		return v shr 60
	end 'taken'
	return 0
end 'afterBranch'

function insideLoop(v Wide, n Num) returns Wide
	var acc = 0
	var i = 0
	while i < n 'each'
		acc = v shr 60
		i = i + 1
	end 'each'
	return acc
end 'insideLoop'

function main() returns ExitCode
	if afterBranch(u64.max, flag: true) != 15 'branch'
		return 1
	end 'branch'
	if insideLoop(u64.max, n: 3) != 15 'loop'
		return 2
	end 'loop'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
  taken:
    x64.movRegImm32 rax, 15
  __il_cont#5:
    x64.cmpRegImm32 rax, 15
    x64.jcc equal, __il_body
  branch:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  __il_body:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 0
  whilehdr:
    x64.cmpRegImm32 rcx, 3
    x64.jcc greaterEqual, __il_cont#9
  each:
    x64.movRegImm32 rax, 15
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp whilehdr
  __il_cont#9:
    x64.cmpRegImm32 rax, 15
    x64.jcc equal, ifcont
  loop:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
}
