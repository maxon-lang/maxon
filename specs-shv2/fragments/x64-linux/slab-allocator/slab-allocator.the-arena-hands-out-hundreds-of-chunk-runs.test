// Test: slab-allocator.the-arena-hands-out-hundreds-of-chunk-runs
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Len = int(0 to 65536)

function build(n Len, seed Len) returns ByteArray
	var b = ByteArray.create()
	b.reserve(n)
	for i in 0 upto 16 'fill'
		b.push(((i + seed) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function main() returns ExitCode
	var bufs = Bufs.create()
	// Sixteen sizes spread across the ladder, forty spans' worth of each: the arena serves a run per
	// span, and the runs are of sixteen different lengths.
	for k in 0 upto 640 'alloc'
		let size = 1000 + (k mod 16) * 1800
		bufs.push(build(size as Len, seed: k as Len))
	end 'alloc'

	var bad = 0
	for k in 0 upto 640 'check'
		let b = try bufs.get(k) otherwise return 1
		for i in 0 upto 16 'bytes'
			let got = try b.get(i) otherwise return 2
			if got != ((i + k) mod 251) 'value'
				bad = bad + 1
			end 'value'
		end 'bytes'
	end 'check'

	if bad != 0 'corrupted'
		return 3
	end 'corrupted'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic#6
  __rc_chk#7:
    x64.cmpRegImm32 rbx, 65536
    x64.jcc lessEqual, __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#9
  __rc_chk#10:
    x64.cmpRegImm32 r12, 65536
    x64.jcc lessEqual, __rc_ok#8
  __rc_panic#9:
