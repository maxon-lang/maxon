    x64.ret
  __rc_ok#8:
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect Array.reserve
    x64.movRegImm32 rbx, 0
  forhdr:
    x64.cmpRegImm32 rbx, 16
    x64.jcc greaterEqual, forexit
  fill:
    x64.leaRegRegReg rsi, rbx, r12
    x64.movRegImm rax, 2351776136887273513
    x64.imulHighReg rsi
    x64.sarRegImm8 rdx, rdx, 5
    x64.movRegReg rax, rdx
    x64.shrRegImm8 rax, rdx, 63
    x64.leaRegRegReg rax, rdx, rax
    x64.imulRegRegImm32 rax, rax, 251
    x64.movRegReg rdx, rsi
    x64.subRegReg rdx, rsi, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#12
  __rc_chk#13:
    x64.cmpRegImm32 rdx, 255
    x64.jcc lessEqual, __rc_ok#11
  __rc_panic#12:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#11:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_push
  forstep:
    x64.leaRegRegImm32 rbx, rbx, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

