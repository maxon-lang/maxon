// Test: non-exported-same-name-different-range
// --- file: a.maxon
typealias Limit = int(0 to 500)

export function clampA(x Limit) returns Limit
	return x
end 'clampA'

// --- file: b.maxon
typealias Limit = int(0 to 2000)

export function clampB(x Limit) returns Limit
	return x
end 'clampB'

// --- file: main.maxon
function main() returns ExitCode
	let a = clampA(40)
	let b = clampB(60)
	return a + b
end 'main'
---
ExitCode: 100
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 40
  __il_cont#5:
    x64.movRegImm32 rcx, 60
  __il_cont#4:
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
