    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.leaRegFunc rcx, [rip + __gt_reply_release_Source.values]
    x64.callDirect __gt_cell_alloc
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r8 + 0], rax
    x64.storeBaseDispReg.word64 [r8 + 8], rbx
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.movRegReg rdx, r8
    x64.callDirect __mbox_send
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_try_await
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rcx, r8
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, r8
  trycont:
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rdx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rsi, [rcx + 0]
  forhdr:
    x64.cmpRegReg rax, rdx
    x64.jcc greaterEqual, forexit
  each:
    x64.loadRegBaseIndexScale.word64 rdi, [rsi + rax*8 + 0]
  __im_cont:
    x64.leaRegRegReg rbx, rbx, rdi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at deepmove.a-reply-carries-a-container-back.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mbox_handle_drop_box
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
