func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Source.create
    x64.leaRegFunc rcx, [rip + Source.__loop]
    x64.leaRegFunc rax, [rip + Source.__abandon]
    x64.movRegReg rdx, r8
