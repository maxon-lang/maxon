// Test: ceil.exact
function main() returns ExitCode
	let x = 5.0
	let y = trunc(ceil(x))
	return y
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.roundsdRegReg.towardPositive xmm0, xmm0
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
