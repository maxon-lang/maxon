  __im_load#18:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#31
  __im_empty#19:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, critsplit#32
  __im_slow#17:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.jmp __im_cont#16
  critsplit#32:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
    x64.jmp __im_cont#16
  critsplit#31:
    x64.movRegReg r8, rax
    x64.movRegReg r10, rcx
  __im_cont#16:
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rax, r8
  trycont#3:
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, ifcont#5
  zero:
    x64.movRegImm32 r12, 1
  ifcont#5:
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc belowEqual, __im_slow#21
  __im_load#22:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 8
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
