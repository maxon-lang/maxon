  tryerr#7:
    x64.movRegImm rax, 18446744073709551615
    x64.jmp trycont#8
  tryok#6:
    x64.movRegReg rax, r8
  trycont#8:
    x64.cmpRegImm32 rax, -1
    x64.jcc equal, ifcont#10
  one:
    x64.leaRegRegImm32 r12, r12, 1
  ifcont#10:
    x64.movRegImm rdx, 18446744073709551615
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, -1
    x64.jcc belowEqual, __im_slow#25
  __im_load#26:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, -8
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, critsplit#35
  __im_empty#27:
