// Test: character-set-dropped-unused
function main() returns ExitCode
	_ = CharacterSet.punctuation()
	_ = CharacterSet.whitespacesAndNewlines()
	print("ok")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __data_CharacterSet.cachedPunctuation@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect CharacterSet.punctuation
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_CharacterSet
    x64.callDirect CharacterSet.whitespacesAndNewlines
    x64.movRegReg rcx, r8
    x64.callDirect __destruct_CharacterSet
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "ok"
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
