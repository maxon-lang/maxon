// Test: stdlib-whitelist.the-other-member-of-the-contested-set-is-an-edge-too
function main() returns ExitCode
	let nums = [10, 20, 30, 40]
	if nums.contains(30) 'found'
		return 7
	end 'found'
	return 1
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 4
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.movRegImm32 rdx, 30
    x64.leaRegRdata rax, [rip + __layout_Array_int]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.contains#type parameter
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, found
    x64.jmp ifcont
  found:
    x64.movRegImm32 r12, 7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.contains#type parameter {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, r9
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r14, rax
    x64.jcc less, scan
    x64.jmp forexit
  scan:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.imulRegRegImm32 rcx, r14, 8
    x64.leaRegRegReg rax, rax, rcx
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegBaseDisp.byte rcx, [rax + 0]
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rcx, r8
    x64.jmp __il_cont
  __il_cont:
    x64.movRegReg rdx, r12
    x64.callMem [r13 + 24]
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, found
    x64.jmp ifcont
  found:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @int.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegReg rcx, rdx
    x64.setccReg equal, r8
    x64.popReg rbp
    x64.ret
}
