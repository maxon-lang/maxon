}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_11]  ; "abc"
    x64.callDirect report
    x64.leaRegRdata rcx, [rip + __str_rec_12]  ; ""
    x64.callDirect report
    x64.leaRegRdata rcx, [rip + __str_rec_13]  ; "h\xc3\xa9llo"
    x64.callDirect report
    x64.leaRegRdata rcx, [rip + __str_rec_14]  ; "\x0d\x0a"
    x64.callDirect report
    x64.leaRegRdata rcx, [rip + __str_rec_15]  ; "\xf0\x9f\x91\xa8\xe2\x80\x8d\xf0\x9f\x92\xbb"
    x64.callDirect report
    x64.leaRegRdata rcx, [rip + __str_rec_16]  ; "Hi\xf0\x9f\x8e\x89\xe4\xb8\xad"
    x64.callDirect report
    x64.leaRegRdata rcx, [rip + __str_rec_17]  ; "\xf0\x9f\x87\xba\xf0\x9f\x87\xb8"
    x64.callDirect report
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
