func @makeValue {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Runtime.yield
    x64.movRegImm32 r8, 21
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rcx, [rip + makeValue]
    x64.callDirect __gt_spawn
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_ready
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __gt_await
    x64.leaRegRegImm32 r8, r8, 2
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]  ; "panic at async-linearity.await-in-an-arm-that-returns.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
