// Test: straight-line-multiple-consume
typealias Integer = int(i64.min to i64.max)

interface Payload
	function tag() returns Integer
end 'Payload'

type Desc implements Payload
	export var v as Integer

	export static function create(x Integer) returns Desc
		return Self{v: x}
	end 'create'

	export function tag() returns Integer
		return self.v
	end 'tag'
end 'Desc'

type Holder
	export var p as Payload

	export static function create(p Payload) returns Holder
		return Holder{p: p}
	end 'create'

	export function run() returns Integer
		return self.p.tag()
	end 'run'
end 'Holder'

function twice(item Integer, p Payload) returns Integer
	var h1 = Holder.create(p)
	let a = h1.run()
	var h2 = Holder.create(p)
	let b = h2.run()
	return a + b + item
end 'twice'

function driver() returns Integer
	let p = Desc.create(9)
	return twice(4, p: p)
end 'driver'

function main() returns ExitCode
	return driver()
end 'main'
---
ExitCode: 22
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Desc.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Desc.tag {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __retain_existential
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect __drop_existential
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.run {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rax
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r12
    x64.callDirect __retain_existential
    x64.movRegReg rcx, r8
    x64.movRegReg rdx, r13
    x64.callDirect Holder.create
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r14
    x64.callDirect Holder.run
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r12
    x64.callDirect __retain_existential
    x64.movRegReg rcx, r8
    x64.movRegReg rdx, r13
    x64.callDirect Holder.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect Holder.run
    x64.leaRegRegReg rax, r15, r8
    x64.leaRegRegReg rbx, rax, rbx
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Holder
    x64.movRegReg rcx, r14
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @driver {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 9
    x64.callDirect Desc.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 4
    x64.leaRegRdata rax, [rip + __witness_Desc.Payload]
    x64.movRegReg rdx, rbx
    x64.callDirect twice
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect driver
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
