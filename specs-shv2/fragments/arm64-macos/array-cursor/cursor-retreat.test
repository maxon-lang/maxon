// Test: cursor-retreat
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var arr = ByteArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)

	let cursor = try arr.cursor() otherwise 'fail'
		return 99
	end 'fail'

	try cursor.advance() otherwise ignore
	let afterAdv = cursor.current()
	try cursor.retreat() otherwise ignore
	let afterRet = cursor.current()

	return afterAdv + afterRet
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl Array.cursor
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl ArrayIterator.advance
    arm64.cmp x9, 0
    arm64.b.ne trycont#5
  trycont#5:
    arm64.leaRdata x1, __layout_ArrayIterator_Byte
    arm64.movRegReg x0, x20
    arm64.bl ArrayIterator.current
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl ArrayIterator.retreat
    arm64.cmp x9, 0
    arm64.b.ne trycont#8
  trycont#8:
    arm64.leaRdata x1, __layout_ArrayIterator_Byte
    arm64.movRegReg x0, x20
    arm64.bl ArrayIterator.current
    arm64.add x21, x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_ArrayIterator_Byte
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at cursor-retreat.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
