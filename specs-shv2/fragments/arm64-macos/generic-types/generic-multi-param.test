// Test: generic-multi-param
typealias Integer = int(i64.min to i64.max)
type Pair uses A, B
	export var first as A
	export var second as B
	export static function create(a A, b B) returns Self
		return Self{first: a, second: b}
	end 'create'
	export function firstVal() returns A
		return self.first
	end 'firstVal'
	export function secondVal() returns B
		return self.second
	end 'secondVal'
end 'Pair'
typealias IntPair = Pair with (Integer, Integer)
function main() returns ExitCode
	let p = IntPair.create(3, b: 4)
	if p.firstVal() == 3 'c1'
		if p.secondVal() == 4 'c2'
			return 0
		end 'c2'
	end 'c1'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.firstVal {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @Pair.secondVal {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.add x0, x1, 72
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x1
    arm64.leaRdata x1, __layout_Pair_Integer_Integer
    arm64.movRegReg x0, x19
    arm64.bl Pair.firstVal
    arm64.cmp x0, 3
    arm64.b.ne ifcont
  c1:
    arm64.leaRdata x1, __layout_Pair_Integer_Integer
    arm64.movRegReg x0, x19
    arm64.bl Pair.secondVal
    arm64.cmp x0, 4
    arm64.b.ne ifcont
  c2:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot2
    arm64.epilogue 48
    arm64.ret
}
