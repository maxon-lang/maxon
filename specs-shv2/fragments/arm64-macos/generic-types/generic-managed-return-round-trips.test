// Test: generic-managed-return-round-trips
typealias Integer = int(i64.min to i64.max)
type Alpha
	export var a as Integer
	export static function create() returns Self
		return Self{a: 1}
	end 'create'
end 'Alpha'
type Box uses T
	export var tag as Integer
	export static function create() returns Self
		return Self{tag: 0}
	end 'create'
	export function echo(v T) returns T
		return v
	end 'echo'
end 'Box'
typealias AlphaBox = Box with Alpha
function main() returns ExitCode
	var bx = AlphaBox.create()
	let got = bx.echo(Alpha.create())
	let back = bx.echo(got)
	print("a={back.a}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Alpha.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.echo {
  entry:
    arm64.prologue 16
    arm64.movRegReg x0, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 112
    arm64.storeSlotReg slot11, x28
    arm64.storeSlotReg slot10, x27
    arm64.storeSlotReg slot9, x26
    arm64.storeSlotReg slot8, x25
    arm64.storeSlotReg slot7, x24
    arm64.storeSlotReg slot6, x23
    arm64.storeSlotReg slot5, x22
    arm64.storeSlotReg slot4, x21
    arm64.storeSlotReg slot3, x20
    arm64.storeSlotReg slot2, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.bl Alpha.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_Box_Alpha
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Box.echo
    arm64.movRegReg x21, x0
    arm64.storeSlotReg slot1, x21
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.leaRdata x2, __layout_Box_Alpha
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl Box.echo
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_2  ; "a="
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x22, [x19 + 0]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x23
    arm64.bl __int_to_string
    arm64.movRegReg x22, x0
    arm64.leaRdata x0, __str_rec_3  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x24, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x25, [x0 + 8]
    arm64.add x0, x21, x22
    arm64.add x26, x0, x25
    arm64.add x0, x26, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
    arm64.add x28, x27, 56
    arm64.movRegReg x0, x28
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x20, x28, x21
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x20, x20, x22
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x25
    arm64.bl __str_copy
    arm64.add x0, x20, x25
    arm64.storeBaseDispReg.word64 [x27 + 0], x28
    arm64.storeBaseDispReg.word64 [x27 + 8], x26
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x27 + 16], x0
