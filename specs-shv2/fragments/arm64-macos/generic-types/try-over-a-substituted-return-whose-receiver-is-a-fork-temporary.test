    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.byte [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Box.fetch {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.byte x2, [x0 + 8]
    arm64.cbnz x2, boom
    arm64.b ifcont
  boom:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
