// --- file: b_types.maxon
export type S0
	export var s as String
	export static function make(t String) returns Self
		return Self{s: t}
	end 'make'
end 'S0'
export type Box uses T
	export var value as T
	export static function create(v T) returns Self
		return Self{value: v}
	end 'create'
end 'Box'
export typealias N0 = Box with S0
