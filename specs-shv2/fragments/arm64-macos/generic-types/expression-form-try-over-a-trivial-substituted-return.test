    arm64.leaRdata x1, __layout_Box_Integer
    arm64.movRegReg x0, x19
    arm64.bl Box.fetch
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.leaRdata x0, __str_rec_2
