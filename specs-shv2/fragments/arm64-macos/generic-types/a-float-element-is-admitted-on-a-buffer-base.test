// Test: a-float-element-is-admitted-on-a-buffer-base
typealias Real = float(f64.min to f64.max)
typealias Reals = Array with Real
typealias Vec2 = Vector with 2 Real

function main() returns ExitCode
	var a = Reals.create()
	a.push(1.5)
	var v = Vec2.create()
	try v.set(0, value: 3.5) otherwise panic("test invariant: set OOB")
	return trunc((try a.get(0) otherwise 0.0) + (try v.get(0) otherwise 0.0))
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, d8
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.fpLoadRdata d0, [rdata + __fconst_2]
    arm64.fmov x1, d0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 2
    arm64.movRegReg x0, x20
    arm64.bl __arr_resize
    arm64.movImm x1, 0
    arm64.fpLoadRdata d0, [rdata + __fconst_3]
    arm64.fmov x2, d0
    arm64.movRegReg x0, x20
    arm64.bl __arr_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot d8, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.fmov d8, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.fpLoadRdata d8, [rdata + __fconst_4]
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.fmov d0, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.fpLoadRdata d0, [rdata + __fconst_4]
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.fadd d0, d8, d0
    arm64.fcvtzs x21, d0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x21, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot d8, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot d8, slot3
    arm64.epilogue 48
    arm64.ret
}
