// Test: closure-capture.capture-exitcode-wide-value
typealias IntThunk = function() returns ExitCode

function big() returns ExitCode
	return 100000
end 'big'

function useIt(t IntThunk) returns ExitCode
	let v = t()
	let f = function() gives v
	return f() - 99991
end 'useIt'

function main() returns ExitCode
	return useIt(big)
end 'main'
---
ExitCode: 9
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @big {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100000
    arm64.epilogue 16
    arm64.ret
}

func @useIt {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.blr x19
    arm64.movRegReg x19, x0
    arm64.leaFuncAddr x20, useIt$closure_0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x21
    arm64.blr x20
    arm64.sub x19, x0, 99991
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @useIt$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaFuncAddr x0, __fnref_big
    arm64.movImm x1, 0
    arm64.bl useIt
    arm64.epilogue 16
    arm64.ret
}
