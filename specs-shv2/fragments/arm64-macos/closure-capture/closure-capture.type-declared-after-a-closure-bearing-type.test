// Test: closure-capture.type-declared-after-a-closure-bearing-type

typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function bumped(n Integer) returns Integer
		let step = function(k Integer) gives k + 1
		return step(n)
	end 'bumped'
end 'Counter'

type Box
	export var v as Integer

	static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	let b = Box.create(40)
	return b.v + Counter.bumped(1)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.bumped {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, Counter.bumped$closure_0
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Counter.bumped$closure_0 {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 40
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.loadRegBaseDisp.word64 x19, [x1 + 0]
    arm64.movImm x0, 1
    arm64.bl Counter.bumped
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at closure-capture.type-declared-after-a-closure-bearing-type.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
}
