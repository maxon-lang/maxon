// Test: a-truncation-of-a-constant-folds-inside-the-i64-range
typealias Real = float(f64.min to f64.max)
typealias Word = int(i64.min to i64.max)

function truncF(a Real) returns Word
	return trunc(a)
end 'truncF'

function main() returns ExitCode
	if truncF(3.99) != 3 'towardZeroFromAbove'
		return 1
	end 'towardZeroFromAbove'
	if truncF(-3.99) != -3 'towardZeroFromBelow'
		return 2
	end 'towardZeroFromBelow'
	if truncF(-0.5) != 0 'andTheFractionBelowZero'
		return 3
	end 'andTheFractionBelowZero'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#8
  __il_body#8:
    arm64.movImm x0, 3
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cmp x0, 3
    arm64.cset x0, ne
    arm64.cbnz x0, towardZeroFromAbove
    arm64.b ifcont#2
  towardZeroFromAbove:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#10
  __il_body#10:
    arm64.movImm x0, 18446744073709551613
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.cmp x0, -3
    arm64.cset x0, ne
    arm64.cbnz x0, towardZeroFromBelow
    arm64.b ifcont#4
  towardZeroFromBelow:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.b __il_body#12
  __il_body#12:
    arm64.movImm x0, 0
    arm64.b __il_cont#11
  __il_cont#11:
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, andTheFractionBelowZero
    arm64.b ifcont#6
  andTheFractionBelowZero:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
