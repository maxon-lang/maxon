// Test: a-division-by-a-constant-zero-is-not-folded
typealias Word = int(i64.min to i64.max)

function pick(a Word) returns Word
	return a
end 'pick'

function main() returns ExitCode
	let ten = pick(10)
	let zero = pick(0)
	if (try (ten / zero) otherwise -77) != -77 'quotientByZeroStillThrows'
		return 1
	end 'quotientByZeroStillThrows'
	if (try (ten mod zero) otherwise -78) != -78 'remainderByZeroStillThrows'
		return 2
	end 'remainderByZeroStillThrows'
	if (try (ten / pick(3)) otherwise -79) != 3 'anOrdinaryDivisionStillDivides'
		return 3
	end 'anOrdinaryDivisionStillDivides'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
  __il_cont#17:
    arm64.movImm x1, 0
  __il_cont#16:
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.sdiv x3, x0, x2
    arm64.cmp x2, 0
    arm64.cset x4, ne
    arm64.b.eq trycont#3
  tryerr#2:
    arm64.movImm x3, 18446744073709551539
  trycont#3:
    arm64.cmp x3, -77
    arm64.b.eq ifcont#5
  quotientByZeroStillThrows:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#5:
    arm64.cmp x1, -1
    arm64.cset x1, eq
    arm64.add x1, x1, -1
    arm64.movImm x16, 10
    arm64.and x1, x1, x16
    arm64.sdiv x16, x1, x2
    arm64.msub x1, x16, x2, x1
    arm64.cbz x4, trycont#8
  tryerr#7:
    arm64.movImm x1, 18446744073709551538
  trycont#8:
    arm64.cmp x1, -78
    arm64.b.eq __il_cont#20
  remainderByZeroStillThrows:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  __il_cont#20:
    arm64.movImm x1, 6148914691236517206
    arm64.smulh x0, x1, x0
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
  trycont#13:
    arm64.cmp x0, 3
    arm64.b.eq ifcont#15
  anOrdinaryDivisionStillDivides:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#15:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
