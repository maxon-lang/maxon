    arm64.fpLoadRdata d2, [rdata + __fconst_-77]
    arm64.fcmp d1, d2
    arm64.cset x0, ne
    arm64.cbnz x0, positiveZeroStillThrows
    arm64.b ifcont#5
  positiveZeroStillThrows:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#5:
    arm64.fpLoadRdata d1, [rdata + __fconst_-0]
    arm64.b __il_body#21
