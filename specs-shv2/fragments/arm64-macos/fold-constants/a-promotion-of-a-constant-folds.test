    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont#2:
    arm64.b __il_body#10
  __il_body#10:
    arm64.fpLoadRdata d0, [rdata + __fconst_9007199254740992]
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.bl __float_toString
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
