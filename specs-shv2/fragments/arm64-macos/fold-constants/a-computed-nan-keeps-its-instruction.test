// Test: a-computed-nan-keeps-its-instruction
typealias Real = float(f64.min to f64.max)

function scaleF(a Real, b Real) returns Real
	return a * b
end 'scaleF'

function subF(a Real, b Real) returns Real
	return a - b
end 'subF'

function sqrtF(a Real) returns Real
	return sqrt(a)
end 'sqrtF'

function main() returns ExitCode
	let inf = scaleF(1.0e308, b: 10.0)
	let notANumber = subF(inf, b: inf)
	if notANumber == notANumber 'infinityMinusInfinityIsNan'
		return 1
	end 'infinityMinusInfinityIsNan'
	let root = sqrtF(-4.0)
	if root == root 'rootOfANegativeIsNan'
		return 2
	end 'rootOfANegativeIsNan'
	if "{notANumber}" != "nan" 'andItPrintsAsOne'
		return 3
	end 'andItPrintsAsOne'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
  __il_body#9:
    arm64.fpLoadRdata d0, [rdata + __fconst_0x7ff0000000000000]
  __il_body#10:
    arm64.fsub d0, d0, d0
  __il_cont#7:
    arm64.fcmp d0, d0
    arm64.b.ne ifcont#2
  infinityMinusInfinityIsNan:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont#2:
    arm64.fpLoadRdata d1, [rdata + __fconst_-4]
  __il_body#12:
    arm64.fsqrt d1, d1
  __il_cont#11:
    arm64.fcmp d1, d1
    arm64.b.ne ifcont#4
  rootOfANegativeIsNan:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont#4:
    arm64.bl __float_toString
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x1, __str_rec_93  ; "nan"
    arm64.movRegReg x0, x22
    arm64.bl __str_eq
    arm64.eor x20, x0, 1
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.cbz x20, ifcont#6
  andItPrintsAsOne:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
