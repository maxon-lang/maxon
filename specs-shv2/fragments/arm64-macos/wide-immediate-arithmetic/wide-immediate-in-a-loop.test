// Test: wide-immediate-in-a-loop
function base(p int) returns int
	return p
end 'base'

function main() returns ExitCode
	var acc = base(0)
	var i = 0
	while i < 3 'loop'
		acc = acc + 1000000007
		i = i + 1
	end 'loop'
	if acc != 3000000021 'acc'
		return 61
	end 'acc'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl base
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.movImm x16, 1000000007
    arm64.add x0, x0, x16
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 3000000021
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, acc
    arm64.b ifcont
  acc:
    arm64.movImm x0, 61
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
