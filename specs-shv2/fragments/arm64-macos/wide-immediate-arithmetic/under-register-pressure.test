// Test: under-register-pressure
function base(p int) returns int
	return p
end 'base'

function pressure(p int) returns int
	let k1 = p + 1
	let k2 = p + 2
	let k3 = p + 3
	let k4 = p + 4
	let k5 = p + 5
	let k6 = p + 6
	let k7 = p + 7
	let k8 = p + 8
	let k9 = p + 9
	let k10 = p + 10
	let w1 = p + 1000000007
	let w2 = p + 1000000009
	let w3 = p + 2000000011
	let w4 = p + 2000000013
	return k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + w1 + w2 + w3 + w4
end 'pressure'

function main() returns ExitCode
	let total = pressure(base(0))
	if total != 6000000095 'total'
		return 51
	end 'total'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @pressure {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x6, x0, 3
    arm64.add x7, x0, 4
    arm64.add x8, x0, 5
    arm64.add x9, x0, 6
    arm64.add x10, x0, 7
    arm64.add x11, x0, 8
    arm64.add x19, x0, 9
    arm64.add x20, x0, 10
    arm64.movImm x16, 1000000007
    arm64.add x21, x0, x16
    arm64.movImm x16, 1000000009
    arm64.add x3, x0, x16
    arm64.movImm x16, 2000000011
    arm64.add x4, x0, x16
    arm64.movImm x16, 2000000013
    arm64.add x0, x0, x16
    arm64.add x1, x1, x2
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
    arm64.add x1, x1, x9
    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x1, x1, x19
    arm64.add x1, x1, x20
    arm64.add x1, x1, x21
    arm64.add x1, x1, x3
    arm64.add x1, x1, x4
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl base
    arm64.bl pressure
    arm64.movImm x1, 6000000095
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, total
    arm64.b ifcont
  total:
    arm64.movImm x0, 51
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
