// Test: shifted-imm12-boundary
function base(p int) returns int
	return p
end 'base'

function main() returns ExitCode
	let x = base(1000)
	let addShifted = x + 16773120
	if addShifted != 16774120 'addShifted'
		return 21
	end 'addShifted'
	let subShifted = x - 16773120
	if subShifted != -16772120 'subShifted'
		return 22
	end 'subShifted'
	let addPair = x + 16777215
	if addPair != 16778215 'addPair'
		return 23
	end 'addPair'
	let subPair = x - 16777215
	if subPair != -16776215 'subPair'
		return 24
	end 'subPair'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1000
    arm64.bl base
    arm64.add x1, x0, 16773120
    arm64.cmp x1, 16774120
    arm64.cset x1, ne
    arm64.cbnz x1, addShifted
    arm64.b ifcont
  addShifted:
    arm64.movImm x0, 21
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x1, x0, 16773120
    arm64.cmp x1, -16772120
    arm64.cset x1, ne
    arm64.cbnz x1, subShifted
    arm64.b ifcont
  subShifted:
    arm64.movImm x0, 22
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.add x1, x0, 16777215
    arm64.cmp x1, 16778215
    arm64.cset x1, ne
    arm64.cbnz x1, addPair
    arm64.b ifcont
  addPair:
    arm64.movImm x0, 23
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x0, x0, 16777215
    arm64.cmp x0, -16776215
    arm64.cset x0, ne
    arm64.cbnz x0, subPair
    arm64.b ifcont
  subPair:
    arm64.movImm x0, 24
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
