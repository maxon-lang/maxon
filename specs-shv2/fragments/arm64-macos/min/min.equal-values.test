// Test: min.equal-values
function main() returns ExitCode
	let x = min(7.0, 7.0)
	return trunc(x)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.fcsel d0, d0, d1, mi
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
