// Test: sqrt.precision
function main() returns ExitCode
	let x = sqrt(2.0)
	// sqrt(2) * sqrt(2) should be approximately 2
	let check = x * x
	// Trunc to get integer 2
	return trunc(check)
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fsqrt d0, d0
    arm64.fmul d0, d0, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
