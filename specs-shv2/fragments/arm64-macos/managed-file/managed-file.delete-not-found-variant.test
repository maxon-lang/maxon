func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.leaRdata x0, __str_rec_1  ; "nonexistent_phaseB_delete_xyz.txt"
    arm64.bl String.toByteArray
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __mf_delete
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchdefault
  matcharm:
    arm64.movImm x19, 42
    arm64.b trycont
  matchdefault:
    arm64.leaRdata x0, __str_blob_2  ; "panic at managed-file.delete-not-found-variant.test:7: expected notFound\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  trycont:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
