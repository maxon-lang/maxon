// Test: file-exists
function main() returns ExitCode
	// Test File.exists on a nonexistent file (returns false)
	if File.exists(FilePath from "nonexistent_xyz_12345.txt") 'check'
		return 1
	end 'check'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_timer_count@40 = i64 0
  __gt_timer_heap_base@48 = i64 0
  __gt_timer_capacity@56 = i64 0
  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_live_count@96 = i64 0
  __sched_active_workers@104 = i64 1
  __sched_max_active_workers@112 = i64 1
  __sched_tls_index@120 = i64 0
  __sched_tls_teb_offset@128 = i64 0
  __sched_procs@136 = i64 0
  __sched_num_procs@144 = i64 0
  __sched_shutdown_flag@152 = i64 0
  __sched_lock@160 = i64 0
  __slab_arena_list@168 = i64 0
  __slab_arena_map_l1@176 = i64 0
  __slab_state@184 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_17  ; "nonexistent_xyz_12345.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl File.exists
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.cbnz x20, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
