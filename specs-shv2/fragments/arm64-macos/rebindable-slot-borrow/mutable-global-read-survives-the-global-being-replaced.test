    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 99
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.leaGlobal x0, __data_G
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __managed_decref
    arm64.leaGlobal x0, __data_G
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.movImm x21, 0
    arm64.movImm x22, 0
    arm64.loadRegBaseDisp.word64 x23, [x19 + 8]
  forhdr:
    arm64.cmp x22, x23
    arm64.b.ge forexit
  walk:
    arm64.cmp x22, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at mutable-global-read-survives-the-global-being-replaced.test:17: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.epilogue 96
    arm64.ret
  __rc_ok:
