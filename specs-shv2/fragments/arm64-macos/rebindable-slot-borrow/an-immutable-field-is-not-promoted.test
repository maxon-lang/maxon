    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x9, x1
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
