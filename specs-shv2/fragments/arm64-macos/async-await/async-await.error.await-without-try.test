// Test: async-await.error.await-without-try
typealias Integer = int(i64.min to i64.max)

union TaskError implements Error
		crashed(reason String)
end 'TaskError'

function mayFail() returns Integer throws TaskError
		_ = File.exists(FilePath from "noyield.txt")
		throw TaskError.crashed("boom")
end 'mayFail'

function main() returns ExitCode
		let p = async mayFail()
		let r = await p
		return r
end 'main'
---
CompilerError:
error E3057: <fragment>:15:11: throwing function requires try: 'await' on a promise from a function that throws 'TaskError' drops the error and leaks its payload — use 'try await'
