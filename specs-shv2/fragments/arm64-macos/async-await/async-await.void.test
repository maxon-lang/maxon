// Test: async-await.void
var flag = 0

function setFlag()
		_ = File.exists(FilePath from "noyield.txt")
		flag = 1
end 'setFlag'

function main() returns ExitCode
		let p = async setFlag()
		await p
		return flag
end 'main'
