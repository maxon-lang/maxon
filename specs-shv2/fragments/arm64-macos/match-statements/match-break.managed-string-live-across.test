// Test: match-break.managed-string-live-across
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'loop'
		let s = "abc"
		match i 'check'
			1 then break
			default then total = total + s.byteLength()
		end 'check'
		total = total + 1
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x20, 3
    arm64.b.ge whileexit
  loop:
    arm64.leaRdata x0, __str_rec_1  ; "abc"
    arm64.cmp x20, 1
    arm64.b.ne __il_body
  matcharm:
    arm64.movRegReg x0, x19
    arm64.b matchcont
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.b.ge __rc_ok#13
  __il_slow:
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok#13:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.add x0, x19, x0
  matchcont:
    arm64.add x0, x0, 1
    arm64.add x20, x20, 1
    arm64.movRegReg x19, x0
    arm64.b whilehdr
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok#8
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at match-break.managed-string-live-across.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#8:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
