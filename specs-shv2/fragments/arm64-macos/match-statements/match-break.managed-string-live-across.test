// Test: match-break.managed-string-live-across
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'loop'
		let s = "abc"
		match i 'check'
			1 then break
			default then total = total + s.byteLength()
		end 'check'
		total = total + 1
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.leaRdata x2, __str_rec_1
    arm64.cmp x1, 1
    arm64.cset x6, eq
    arm64.cbnz x6, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.b matchcont
  matchdefault:
    arm64.loadRegBaseDisp.word64 x2, [x2 + 8]
    arm64.add x0, x0, x2
    arm64.b matchcont
  matchcont:
    arm64.add x0, x0, 1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
  afterbreak:
}
