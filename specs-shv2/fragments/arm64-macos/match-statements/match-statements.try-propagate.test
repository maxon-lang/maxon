// Test: match-statements.try-propagate
typealias Tally = int(0 to 100)

enum Err implements Error
	bad
end 'Err'

function leaf() throws Err
	throw Err.bad
end 'leaf'

function dispatch(kind Tally) throws Err
	match kind 'k'
		1 then try leaf()
		default throws Err.bad
	end 'k'
end 'dispatch'

function main() returns ExitCode
	try dispatch(1) otherwise ignore
	return 0
end 'main'
---
ExitCode: 0
---
func @leaf {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @dispatch {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.bl leaf
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.b matchcont
  matchcont:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.movImm x0, 0
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl dispatch
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
