// Test: match-statements.default
function main() returns ExitCode
	let x = 99
	match x 'check'
		1 then return 10
		2 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  matchdefault:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
