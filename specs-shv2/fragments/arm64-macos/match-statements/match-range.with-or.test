// Test: match-range.with-or
function main() returns ExitCode
	let x = 95
	match x 'check'
		1 to 10 or 90 to 100 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
