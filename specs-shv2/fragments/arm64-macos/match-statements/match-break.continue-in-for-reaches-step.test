// Test: match-break.continue-in-for-reaches-step
function main() returns ExitCode
	var seen = 0
	var skipped = 0
	for i in 0 upto 6 'each'
		match i 'check'
			2 then continue
			4 then continue
			default then seen = seen + 1
		end 'check'
		skipped = skipped + 10
	end 'each'
	return seen + skipped
end 'main'
---
ExitCode: 44
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x2, 6
    arm64.cset x3, lt
    arm64.cbnz x3, each
    arm64.b forexit
  each:
    arm64.cmp x2, 2
    arm64.cset x3, eq
    arm64.cbnz x3, matcharm#5
    arm64.b matchnext
  matcharm#5:
    arm64.b forstep
  matchnext:
    arm64.cmp x2, 4
    arm64.cset x3, eq
    arm64.cbnz x3, matcharm#6
    arm64.b matchdefault
  matcharm#6:
    arm64.b forstep
  matchdefault:
    arm64.add x0, x0, 1
    arm64.b matchcont
  matchcont:
    arm64.add x1, x1, 10
    arm64.b forstep
  forstep:
    arm64.add x2, x2, 1
    arm64.b forhdr
  forexit:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-break.continue-in-for-reaches-step.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
