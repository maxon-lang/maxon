// Test: match-break.basic
function main() returns ExitCode
	var result = 0
	match 2 'check'
		1 then result = 10
		2 then break
		default then result = 99
	end 'check'
	return result
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 2
    arm64.cmp x1, 1
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 10
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 2
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.b matchcont
  matchdefault:
    arm64.movImm x0, 99
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  afterbreak:
}
