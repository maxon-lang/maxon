// Test: match-statements.first-case
function main() returns ExitCode
	let x = 1
	match x 'check'
		1 then return 10
		2 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 10
    arm64.epilogue 16
    arm64.ret
}
