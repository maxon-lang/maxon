// Test: match-range.exclusive-boundary
function main() returns ExitCode
	let x = 5
	match x 'check'
		1 upto 5 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.cmp x0, 1
    arm64.cset x1, ge
    arm64.cmp x0, 5
    arm64.cset x0, lt
    arm64.and x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchcont:
}
