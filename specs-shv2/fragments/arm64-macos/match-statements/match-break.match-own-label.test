// Test: match-break.match-own-label
function main() returns ExitCode
	var r = 0
	var i = 0
	while i < 3 'loop'
		match i 'check'
			1 then break 'check'
			default then r = r + 10
		end 'check'
		r = r + 1
		i = i + 1
	end 'loop'
	return r
end 'main'
---
ExitCode: 23
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.cmp x1, 1
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.b matchcont
  matchdefault:
    arm64.add x0, x0, 10
    arm64.b matchcont
  matchcont:
    arm64.add x0, x0, 1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-break.match-own-label.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  afterbreak:
}
