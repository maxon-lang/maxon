// Test: match-range.float
function main() returns ExitCode
	let x = 2.5
	match x 'check'
		0.0 to 5.0 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b matcharm
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
