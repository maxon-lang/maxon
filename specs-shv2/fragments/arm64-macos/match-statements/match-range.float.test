// Test: match-range.float
function main() returns ExitCode
	let x = 2.5
	match x 'check'
		0.0 to 5.0 then return 1
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fpLoadRdata d2, [rdata + __fconst_2]
    arm64.fcmp d0, d1
    arm64.cset x0, ge
    arm64.fcmp d0, d2
    arm64.cset x1, ls
    arm64.and x0, x0, x1
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchcont:
}
