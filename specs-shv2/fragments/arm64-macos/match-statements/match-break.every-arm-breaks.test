// Test: match-break.every-arm-breaks
typealias Count = int(0 to 1000)

function pick(k Count) returns Count
	let r = 7
	match k 'check'
		1 then break
		2 then break
		default then break
	end 'check'
	return r + 1
end 'pick'

function main() returns ExitCode
	return pick(1) + pick(2) + pick(5) - 16
end 'main'
---
ExitCode: 8
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 7
    arm64.cmp x0, 1
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.b matchcont
  matchdefault:
    arm64.b matchcont
  matchcont:
    arm64.add x0, x1, 1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  afterbreak:
  afterbreak:
  afterbreak:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.movImm x0, 2
    arm64.bl pick
    arm64.add x19, x19, x0
    arm64.movImm x0, 5
    arm64.bl pick
    arm64.add x0, x19, x0
    arm64.sub x0, x0, 16
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
