// Test: jump-table.default-panic
enum Color
		red
		green
		blue
		yellow
end 'Color'

function main() returns ExitCode
		let c = Color.blue
		match c 'check'
				red then print("red")
				green then print("green")
				blue then print("blue")
				yellow then print("yellow")
				default panic("unknown")
		end 'check'
		return 0
end 'main'
---
ExitCode: unpinned
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.jumpTable x0, default=matchdefault [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_9
  matchdefault:
    arm64.leaRdata x0, __str_blob_8  ; "panic at jump-table.default-panic.test:16: unknown\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matcharm#1:
    arm64.leaRdata x0, __str_rec_4  ; "red"
    arm64.bl print
    arm64.b matchcont
  matcharm#2:
    arm64.leaRdata x0, __str_rec_5  ; "green"
    arm64.bl print
    arm64.b matchcont
  matcharm#3:
    arm64.leaRdata x0, __str_rec_6  ; "blue"
    arm64.bl print
    arm64.b matchcont
  matcharm#4:
    arm64.leaRdata x0, __str_rec_7  ; "yellow"
    arm64.bl print
    arm64.b matchcont
  matchcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
