// Test: error.unknown-case-through-Self-on-an-enum
enum Toggle
	off
	on

	export function bad() returns Toggle
		return Self.nope
	end 'bad'
end 'Toggle'

function main() returns ExitCode
	let t = Toggle.off
	if t == Toggle.off 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
CompilerError:
error E3034: <fragment>:7:10: unknown enum case: 'nope'
