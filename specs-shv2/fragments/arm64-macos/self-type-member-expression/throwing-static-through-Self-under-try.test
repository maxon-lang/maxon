// Test: throwing-static-through-Self-under-try
typealias Num = int(0 to 1000)

enum Err
	bad
end 'Err'

type Gate
	export var n as Num

	export static function make(v Num) returns Gate
		return Self{n: v}
	end 'make'

	export static function check(v Num) returns Num throws Err
		if v == 0 'zero'
			throw Err.bad
		end 'zero'
		return v
	end 'check'

	export function twin() returns Num
		return try Self.check(self.n) otherwise 3
	end 'twin'
end 'Gate'

function main() returns ExitCode
	return Gate.make(42).twin()
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Gate.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at throwing-static-through-Self-under-try.test:11: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Gate.check {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at throwing-static-through-Self-under-try.test:15: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, zero
    arm64.b ifcont
  zero:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @Gate.twin {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl Gate.check
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 3
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 42
    arm64.bl Gate.make
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Gate.twin
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at throwing-static-through-Self-under-try.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
