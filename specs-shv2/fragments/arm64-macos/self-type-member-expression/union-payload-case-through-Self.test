// Test: union-payload-case-through-Self
typealias Num = int(0 to 100)

union Res
	ok(v Num)
	none

	export function bump() returns Res
		return Self.ok(42)
	end 'bump'

	export function blank() returns Res
		return Self.none
	end 'blank'
end 'Res'

function main() returns ExitCode
	let r = Res.none
	let s = r.bump()
	let t = s.blank()
	return match t 'blanked'
		ok gives 1
		none gives match s 'bumped'
			ok(v) gives v
			none gives 2
		end 'bumped'
	end 'blanked'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x19
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.leaRegSlot x1, slot0
    arm64.movImm x2, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x2
    arm64.movImm x2, 42
    arm64.storeBaseDispReg.word64 [x1 + 8], x2
    arm64.leaRegSlot x2, slot2
    arm64.movImm x3, 1
    arm64.storeBaseDispReg.word64 [x2 + 0], x3
    arm64.movImm x3, 0
    arm64.storeBaseDispReg.word64 [x2 + 8], x3
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.cmp x2, 0
    arm64.cset x3, eq
    arm64.cbnz x3, matcharm#1
    arm64.b matchnext#9
  matcharm#1:
    arm64.movImm x19, 1
    arm64.b matchcont#10
  matchnext#9:
    arm64.cmp x2, 1
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#2
    arm64.b matchdead#8
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x2, [x1 + 0]
    arm64.cmp x2, 0
    arm64.cset x3, eq
    arm64.cbnz x3, matcharm#3
    arm64.b matchnext#6
  matcharm#3:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.b matchcont#7
  matchnext#6:
    arm64.cmp x2, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#4
    arm64.b matchdead#5
  matcharm#4:
    arm64.movImm x1, 2
    arm64.b matchcont#7
  matchcont#7:
    arm64.movRegReg x19, x1
    arm64.b matchcont#10
  matchcont#10:
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at union-payload-case-through-Self.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot4
    arm64.epilogue 64
    arm64.ret
  matchdead#5:
  matchdead#8:
}
