// Test: dispatch.upto-min-upto-min-empty
function classify(x int) returns int
	return match x 'm'
		-9223372036854775808 upto -9223372036854775808 gives 1
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `min upto min` is also empty. The wrap bug turned it into `[i64.min, i64.max]`, matching every
	// value; that the ordinary values below still fall to default proves the arm is dead.
	var n = 0 as ExitCode
	if classify(5) == 0 'a' n = n + 1 end 'a'
	if classify(0) == 0 'b' n = n + 1 end 'b'
	if classify(-1) == 0 'c' n = n + 1 end 'c'
	return n
end 'main'
---
ExitCode: 3
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.b matchdefault
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 5
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, -1
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
