// Test: dispatch.upto-i64min-empty
function classify(x int) returns int
	return match x 'm'
		0 upto -9223372036854775808 gives 1
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `0 upto i64.min` is the empty range — nothing is below i64.min. A prior bug decremented
	// the exclusive upper to `i64.min - 1`, which wrapped to `i64.max` and matched every value >= 0.
	var n = 0 as ExitCode
	if classify(5) == 0 'a' n = n + 1 end 'a'
	if classify(0) == 0 'b' n = n + 1 end 'b'
	if classify(-1) == 0 'c' n = n + 1 end 'c'
	if classify(9223372036854775807) == 0 'd' n = n + 1 end 'd'
	return n
end 'main'
---
ExitCode: 4
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.b matchdefault
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 5
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, -1
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 9223372036854775807
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
