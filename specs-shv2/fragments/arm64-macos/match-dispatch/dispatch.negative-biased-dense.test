// Test: dispatch.negative-biased-dense
function classify(x int) returns int
	return match x 'm'
		-3 gives 1
		-2 gives 2
		-1 gives 3
		0 gives 4
		1 gives 5
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// A dense span that CROSSES ZERO (min -3, span 5): the bias subtract is `x - (-3)` = `x + 3`, and the
	// UNSIGNED bounds check routes a below-min value (which wraps to a huge unsigned index) to the default.
	var n = 0 as ExitCode
	if classify(-3) == 1 'a' n = n + 1 end 'a'
	if classify(-1) == 3 'b' n = n + 1 end 'b'
	if classify(0) == 4 'c' n = n + 1 end 'c'
	if classify(1) == 5 'd' n = n + 1 end 'd'
	if classify(-4) == 0 'e' n = n + 1 end 'e'
	if classify(2) == 0 'f' n = n + 1 end 'f'
	return n as ExitCode
end 'main'
---
ExitCode: 6
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.sub x0, x0, -3
    arm64.jumpTable x0, default=matchdefault [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm] @__jumptable_1
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 3
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 4
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, -3
    arm64.bl classify
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, -1
    arm64.bl classify
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.bl classify
    arm64.cmp x0, 4
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 1
    arm64.bl classify
    arm64.cmp x0, 5
    arm64.cset x0, eq
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, -4
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, e
    arm64.b critsplit
  e:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 2
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, f
    arm64.b critsplit
  f:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
