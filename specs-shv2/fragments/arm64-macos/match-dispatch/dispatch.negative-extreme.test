    arm64.cbnz x0, matcharm#5
    arm64.b matchdefault
  matcharm#5:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchdefault:
    arm64.movImm x0, 9
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

