    arm64.and x0, x1, x0
    arm64.cbnz x0, matcharm#2
    arm64.b matchdefault
  matcharm#2:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchhi:
    arm64.cmp x0, 0
