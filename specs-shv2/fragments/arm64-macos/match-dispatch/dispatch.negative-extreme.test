    arm64.cmp x0, 100
    arm64.cset x2, le
    arm64.and x1, x1, x2
    arm64.cbnz x1, matcharm#4
    arm64.b matchnext#11
  matcharm#4:
    arm64.movImm x0, 4
    arm64.b matchcont
  matchnext#11:
    arm64.cmp x0, 101
