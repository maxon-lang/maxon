// Test: dispatch.negative-extreme
typealias N = int(i64.min to i64.max)

function band(x N) returns N
	return match x 'c'
		min to -100 gives 1
		-99 to -1 gives 2
		0 gives 3
		1 to 100 gives 4
		101 to max gives 5
		default gives 9
	end 'c'
end 'band'

function main() returns ExitCode
	var n = 0 as N
	if band(0 - 5000) == 1 'a' n = n + 1 end 'a'
	if band(0 - 100) == 1 'b' n = n + 1 end 'b'
	if band(0 - 99) == 2 'c' n = n + 1 end 'c'
	if band(0 - 1) == 2 'd' n = n + 1 end 'd'
	if band(0) == 3 'e' n = n + 1 end 'e'
	if band(1) == 4 'f' n = n + 1 end 'f'
	if band(100) == 4 'g' n = n + 1 end 'g'
	if band(101) == 5 'h' n = n + 1 end 'h'
	if band(999999) == 5 'i' n = n + 1 end 'i'
	return n as ExitCode
end 'main'
---
ExitCode: 9
---
func @band {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, matchlo
    arm64.b matchhi
  matchlo:
    arm64.cmp x0, -100
    arm64.cset x1, le
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, -99
    arm64.cset x1, ge
    arm64.cmp x0, -1
    arm64.cset x0, le
    arm64.and x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchhi:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 3
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, ge
    arm64.cmp x0, 100
    arm64.cset x2, le
    arm64.and x1, x1, x2
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 4
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 101
    arm64.cset x0, ge
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchdefault:
    arm64.movImm x0, 9
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 0
    arm64.sub x0, x0, 5000
    arm64.bl band
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.sub x0, x0, 100
    arm64.bl band
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.sub x0, x0, 99
    arm64.bl band
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.sub x0, x0, 1
    arm64.bl band
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.bl band
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, e
    arm64.b critsplit
  e:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 1
    arm64.bl band
    arm64.cmp x0, 4
    arm64.cset x0, eq
    arm64.cbnz x0, f
    arm64.b critsplit
  f:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 100
    arm64.bl band
    arm64.cmp x0, 4
    arm64.cset x0, eq
    arm64.cbnz x0, g
    arm64.b critsplit
  g:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 101
    arm64.bl band
    arm64.cmp x0, 5
    arm64.cset x0, eq
    arm64.cbnz x0, h
    arm64.b critsplit
  h:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 999999
    arm64.bl band
    arm64.cmp x0, 5
    arm64.cset x0, eq
    arm64.cbnz x0, i
    arm64.b critsplit
  i:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
