// Test: dispatch.carried-var-merge-tree
typealias N = int(0 to 1000)

function pick(x N) returns N
	var r = 0 as N
	match x 'c'
		1 then r = 10
		2 then r = 20
		3 then r = 30
		4 then r = 40
		5 then r = 50
		default then r = 99
	end 'c'
	return r
end 'pick'

function main() returns ExitCode
	var n = 0 as N
	if pick(1) == 10 'a'
		n = n + 1
	end 'a'
	if pick(3) == 30 'b'
		n = n + 1
	end 'b'
	if pick(5) == 50 'c'
		n = n + 1
	end 'c'
	if pick(99) == 99 'd'
		n = n + 1
	end 'd'
	return n as ExitCode
end 'main'
