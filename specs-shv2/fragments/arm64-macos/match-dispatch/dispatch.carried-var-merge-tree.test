// Test: dispatch.carried-var-merge-tree
typealias N = int(0 to 1000)

function pick(x N) returns N
	var r = 0 as N
	match x 'c'
		1 then r = 10
		2 then r = 20
		3 then r = 30
		4 then r = 40
		5 then r = 50
		default then r = 99
	end 'c'
	return r
end 'pick'

function main() returns ExitCode
	var n = 0 as N
	if pick(1) == 10 'a' n = n + 1 end 'a'
	if pick(3) == 30 'b' n = n + 1 end 'b'
	if pick(5) == 50 'c' n = n + 1 end 'c'
	if pick(99) == 99 'd' n = n + 1 end 'd'
	return n as ExitCode
end 'main'
---
ExitCode: 4
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.sub x0, x0, 1
    arm64.jumpTable x0, default=matchdefault [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm] @__jumptable_2
  matchdefault:
    arm64.movImm x0, 99
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 10
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 20
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 30
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 40
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 50
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.cmp x0, 10
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 3
    arm64.bl pick
    arm64.cmp x0, 30
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 5
    arm64.bl pick
    arm64.cmp x0, 50
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 99
    arm64.bl pick
    arm64.cmp x0, 99
    arm64.cset x0, eq
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
