// Test: dispatch.dense-scalar-range-arm
function scalar(x int) returns int
	return match x 'm'
		0 gives 100
		1 gives 101
		2 to 4 gives 102
		5 gives 105
		7 gives 107
		default gives 999
	end 'm'
end 'scalar'

function main() returns ExitCode
	// A dense scalar table (span 8) whose `2 to 4` range arm fills THREE slots with one block; slot 6 is a
	// hole. Every covered value hits its arm; the hole, the two just-outside-span neighbours, a negative,
	// and a far value all fall to the default.
	var n = 0 as ExitCode
	if scalar(0) == 100 'a' n = n + 1 end 'a'
	if scalar(3) == 102 'b' n = n + 1 end 'b'
	if scalar(4) == 102 'c' n = n + 1 end 'c'
	if scalar(5) == 105 'd' n = n + 1 end 'd'
	if scalar(6) == 999 'e' n = n + 1 end 'e'
	if scalar(7) == 107 'f' n = n + 1 end 'f'
	if scalar(8) == 999 'g' n = n + 1 end 'g'
	if scalar(-1) == 999 'h' n = n + 1 end 'h'
	if scalar(100000) == 999 'i' n = n + 1 end 'i'
	return n as ExitCode
end 'main'
---
ExitCode: 9
---
func @scalar {
  entry:
    arm64.prologue 16
    arm64.jumpTable x0, default=matchdefault [[0]=matcharm, [1]=matcharm, [2..4]=matcharm, [5]=matcharm, [6]=matchdefault, [7]=matcharm] @__jumptable_1
  matchdefault:
    arm64.movImm x0, 999
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 100
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 101
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 102
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 105
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 107
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 0
    arm64.bl scalar
    arm64.cmp x0, 100
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 3
    arm64.bl scalar
    arm64.cmp x0, 102
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 4
    arm64.bl scalar
    arm64.cmp x0, 102
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 5
    arm64.bl scalar
    arm64.cmp x0, 105
    arm64.cset x0, eq
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 6
    arm64.bl scalar
    arm64.cmp x0, 999
    arm64.cset x0, eq
    arm64.cbnz x0, e
    arm64.b critsplit
  e:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 7
    arm64.bl scalar
    arm64.cmp x0, 107
    arm64.cset x0, eq
    arm64.cbnz x0, f
    arm64.b critsplit
  f:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 8
    arm64.bl scalar
    arm64.cmp x0, 999
    arm64.cset x0, eq
    arm64.cbnz x0, g
    arm64.b critsplit
  g:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, -1
    arm64.bl scalar
    arm64.cmp x0, 999
    arm64.cset x0, eq
    arm64.cbnz x0, h
    arm64.b critsplit
  h:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 100000
    arm64.bl scalar
    arm64.cmp x0, 999
    arm64.cset x0, eq
    arm64.cbnz x0, i
    arm64.b critsplit
  i:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
