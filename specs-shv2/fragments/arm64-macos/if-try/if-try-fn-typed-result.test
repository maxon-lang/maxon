// Test: if-try-fn-typed-result
typealias Score = int(i64.min to i64.max)
typealias Transform = function(Score) returns Score

enum PickError implements Error
	nope
end 'PickError'

function double(x Score) returns Score
	return x * 2
end 'double'

function pick(ok bool) returns Transform throws PickError
	if ok 'y'
		return double
	end 'y'
	throw PickError.nope
end 'pick'

function main() returns ExitCode
	let f = try pick(true) otherwise panic("pick(true) cannot fail")
	let a = f(3)

	if let g = try pick(true) 'ok'
		let b = g(4)
		return a + b
	end 'ok' else 'bad'
		return 1
	end 'bad'
end 'main'
---
ExitCode: 14
---
func @double {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, y
    arm64.b ifcont
  y:
    arm64.leaFuncAddr x0, __fnref_double
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at if-try-fn-typed-result.test:21: pick(true) cannot fail\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movImm x0, 3
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifelse
  ok:
    arm64.movImm x0, 4
    arm64.movImm x1, 0
    arm64.blr x20
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at if-try-fn-typed-result.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifelse:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
}
