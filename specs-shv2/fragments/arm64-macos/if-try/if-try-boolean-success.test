// Test: if-try-boolean-success

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	failed
end 'MyError'

function mayFail(succeed bool) returns Integer throws MyError
	if not succeed 'check'
		throw MyError.failed
	end 'check'
	return 42
end 'mayFail'

function main() returns ExitCode
	var result = 0
	if try mayFail(true) 'check'
		result = 1
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @mayFail {
  entry:
    arm64.prologue 16
    arm64.eor x0, x0, 1
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 0
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 1
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifelse
  check:
    arm64.movImm x0, 1
    arm64.b ifcont
  ifelse:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
