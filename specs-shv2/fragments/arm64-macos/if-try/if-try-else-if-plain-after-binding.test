// Test: if-try-else-if-plain-after-binding

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	failed
end 'MyError'

function mayFail() returns Integer throws MyError
	throw MyError.failed
end 'mayFail'

function main() returns ExitCode
	let x = 2
	var result = 0
	if let v = try mayFail() 'check'
		result = v
	end 'check' else if x == 2 'two'
		result = 22
	end 'two' else 'fallback'
		result = 99
	end 'fallback'
	return result
end 'main'
---
ExitCode: 22
---
func @mayFail {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 2
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.cset x1, eq
    arm64.cbnz x1, check
    arm64.b ifelse
  check:
    arm64.b ifcont
  ifelse:
    arm64.cmp x19, 2
    arm64.cset x0, eq
    arm64.cbnz x0, two
    arm64.b ifelse
  two:
    arm64.movImm x0, 22
    arm64.b ifcont
  ifelse:
    arm64.movImm x0, 99
    arm64.b ifcont
  ifcont:
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
