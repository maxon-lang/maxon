// Test: byte-array-eq-operator-fresh-literal
function main() returns ExitCode
	let name = "set".toByteArray()
	let probe = "set".toByteArray()
	let other = "get".toByteArray()
	if name != probe 'shouldMatch'
		return 1
	end 'shouldMatch'
	if name == other 'shouldDiffer'
		return 2
	end 'shouldDiffer'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_2
    arm64.bl String.toByteArray
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_2
    arm64.bl String.toByteArray
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __str_rec_3
    arm64.bl String.toByteArray
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_eq
    arm64.eor x0, x0, 1
    arm64.cbnz x0, shouldMatch
    arm64.b ifcont#2
  shouldMatch:
    arm64.movImm x22, 1
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#2:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_eq
    arm64.cbnz x0, shouldDiffer
    arm64.b ifcont#4
  shouldDiffer:
    arm64.movImm x22, 2
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#4:
    arm64.movImm x22, 0
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
