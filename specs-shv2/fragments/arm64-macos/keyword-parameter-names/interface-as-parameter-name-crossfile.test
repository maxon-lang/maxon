module typealias StdType = int(i64.min to i64.max)

// --- file: api/helper.maxon
export function passthrough(interface StdType) returns StdType
	return interface
end 'passthrough'

// --- file: app/main.maxon
function main() returns ExitCode
	return passthrough(5)
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
