// Test: terminator-ends-its-own-block
function classify(x ExitCode) returns ExitCode
	if x > 5 'big'
		return 1
	end 'big'
	var seen = 0
	var i = 0
	while i < 4 'scan'
		i = i + 1
		if i == 2 'hit'
			continue
		end 'hit'
		seen = seen + 1
	end 'scan'
	return seen
end 'classify'

function main() returns ExitCode
	if classify(9) != 1 'earlyReturnLost'
		return 8
	end 'earlyReturnLost'

	return classify(0)
end 'main'
---
ExitCode: 3
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#9
    arm64.b __rc_chk#10
  __rc_chk#10:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#9
    arm64.b __rc_ok#8
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_0  ; "panic at terminator-ends-its-own-block.test:2: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#8:
    arm64.cmp x0, 5
    arm64.cset x0, gt
    arm64.cbnz x0, big
    arm64.b ifcont#2
  big:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 4
    arm64.cset x2, lt
    arm64.cbnz x2, scan
    arm64.b whileexit
  scan:
    arm64.add x1, x1, 1
    arm64.cmp x1, 2
    arm64.cset x2, eq
    arm64.cbnz x2, hit
    arm64.b ifcont#7
  hit:
    arm64.b whilehdr
  ifcont#7:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#12
    arm64.b __rc_chk#13
  __rc_chk#13:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#12
    arm64.b __rc_ok#11
  __rc_panic#12:
    arm64.leaRdata x0, __str_blob_1  ; "panic at terminator-ends-its-own-block.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#11:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9
    arm64.bl classify
    arm64.cmp x0, 1
    arm64.cset x0, ne
    arm64.cbnz x0, earlyReturnLost
    arm64.b ifcont
  earlyReturnLost:
    arm64.movImm x0, 8
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.bl classify
    arm64.epilogue 16
    arm64.ret
}
