// Test: void-throwing-self-receiver
typealias Integer = int(i64.min to i64.max)

enum E implements Error
	bad
end 'E'

type Gate
	var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function bump(v Integer) throws E
		if v < 0 'neg'
			throw E.bad
		end 'neg'
		n = n + v
	end 'bump'

	function driveTwice() throws E
		try self.bump(2)
		try self.bump(3)
	end 'driveTwice'

	function driveBad() throws E
		try self.bump(-1)
	end 'driveBad'

	function total() returns Integer
		return n
	end 'total'
end 'Gate'

function main() returns ExitCode
	var g = Gate.create()
	try g.driveTwice() otherwise return 9
	try g.driveBad() otherwise return g.total()
	return 0
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Gate.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Gate.bump {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.cset x2, lt
    arm64.cbnz x2, neg
    arm64.b ifcont
  neg:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x1, x2, x1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @Gate.driveTwice {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl Gate.bump
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Gate.bump
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok#3:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Gate.driveBad {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 18446744073709551615
    arm64.bl Gate.bump
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Gate.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Gate.driveTwice
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x20, 9
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x19
    arm64.bl Gate.driveBad
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#3:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
