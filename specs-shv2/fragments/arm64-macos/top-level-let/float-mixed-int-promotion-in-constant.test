// Test: float-mixed-int-promotion-in-constant
let M = 1 + 2.0
let N = 5 * 1.5

function main() returns ExitCode
	return trunc(M) * 10 + trunc(N)
end 'main'
---
ExitCode: 37
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fcvtzs x0, d0
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.fcvtzs x1, d0
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
