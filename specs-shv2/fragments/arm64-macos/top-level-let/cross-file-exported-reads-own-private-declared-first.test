// Test: cross-file-exported-reads-own-private-declared-first
// --- file: api/base.maxon
let SECRET = 20
export let BASE = SECRET + 1

// --- file: app/main.maxon
let TOTAL = BASE * 2

function main() returns ExitCode
	return TOTAL
end 'main'
