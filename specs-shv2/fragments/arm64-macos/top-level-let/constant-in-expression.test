// Test: constant-in-expression
let OFFSET = 10

function main() returns ExitCode
	let x = 5
	return x + OFFSET
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 15
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
