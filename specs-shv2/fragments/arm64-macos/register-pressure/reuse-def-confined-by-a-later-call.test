// Test: reuse-def-confined-by-a-later-call
typealias Limb = int(i64.min to i64.max)
typealias Limbs = Array with Limb

function shift(limbs Limbs, s Limb, n Limb)
	var carry = 0
	var i = 0
	while i < limbs.count() 'shiftEach'
		let widened = ((try limbs.get(i) otherwise panic("get")) shl s) or carry
		try limbs.set(i, value: widened and 0xFFFFFFFF) otherwise panic("set")
		carry = widened shr 32
		i = i + 1
	end 'shiftEach'

	var v = 0
	while v < n 'clear'
		try limbs.set(v, value: 0) otherwise panic("clear")
		v = v + 1
	end 'clear'
end 'shift'

function main() returns ExitCode
	var limbs = Limbs.create()
	limbs.push(0xFFFFFFFF)
	limbs.push(1)
	shift(limbs, s: 4, n: 1)
	return try limbs.get(1) otherwise 99
end 'main'
---
ExitCode: 31
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @shift {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.movImm x22, 0
    arm64.movImm x23, 0
    arm64.b whilehdr
  whilehdr:
    arm64.movRegReg x0, x19
    arm64.bl __managed_count
    arm64.cmp x23, x0
    arm64.cset x0, lt
    arm64.cbnz x0, shiftEach
    arm64.b whileexit
  shiftEach:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  tryok:
    arm64.and x1, x20, -64
    arm64.neg x2, x1
    arm64.orr x1, x1, x2
    arm64.asr x1, x1, 63
    arm64.lslv x0, x0, x20
    arm64.mvn x1, x1
    arm64.and x0, x0, x1
    arm64.orr x22, x0, x22
    arm64.movImm x0, 4294967295
    arm64.and x2, x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  tryok:
    arm64.asr x22, x22, 32
    arm64.add x23, x23, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, x21
    arm64.cset x0, lt
    arm64.cbnz x0, clear
    arm64.b whileexit
  clear:
    arm64.movImm x2, 0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  tryok:
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4294967295
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 4
    arm64.movImm x2, 1
    arm64.movRegReg x0, x19
    arm64.bl shift
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 99
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
