    arm64.add x12, x0, 12
    arm64.add x13, x0, 13
    arm64.add x14, x0, 14
    arm64.add x15, x0, 15
    arm64.add x0, x0, 16
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 5
    arm64.cset x21, lt
    arm64.cbnz x21, loop
    arm64.b whileexit
  loop:
    arm64.add x19, x19, x20
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x1, x19, x1
    arm64.add x1, x1, x2
    arm64.add x1, x1, x3
    arm64.add x1, x1, x4
    arm64.add x1, x1, x5
