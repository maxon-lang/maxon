// Test: dead-def-inherits-only-its-own-register-file
function f(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int, a7 int, a8 int, a9 int, a10 int, a11 int, a12 int, a13 int, x float) returns int
	let unused = x as int
	return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13
end 'f'

function main() returns ExitCode
	return f(1, a1: 2, a2: 3, a3: 4, a4: 5, a5: 6, a6: 7, a7: 8, a8: 9, a9: 10, a10: 11, a11: 12, a12: 13, a13: 14, x: 1.5)
end 'main'
---
ExitCode: 105
---
func @f {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x8, x3
    arm64.movRegReg x9, x4
    arm64.movRegReg x10, x5
    arm64.loadRegBaseDisp.word64 x11, [x29 + 48]
    arm64.loadRegBaseDisp.word64 x19, [x29 + 56]
    arm64.loadRegBaseDisp.word64 x20, [x29 + 64]
    arm64.loadRegBaseDisp.word64 x21, [x29 + 72]
    arm64.loadRegBaseDisp.word64 x3, [x29 + 80]
    arm64.loadRegBaseDisp.word64 x4, [x29 + 88]
    arm64.fcvtzs x5, d0
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x8
    arm64.add x0, x0, x9
    arm64.add x0, x0, x10
    arm64.add x0, x0, x6
    arm64.add x0, x0, x7
    arm64.add x0, x0, x11
    arm64.add x0, x0, x19
    arm64.add x0, x0, x20
    arm64.add x0, x0, x21
    arm64.add x0, x0, x3
    arm64.add x0, x0, x4
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96 record@48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x6, 4
    arm64.movImm x7, 5
    arm64.movImm x8, 6
    arm64.movImm x9, 7
    arm64.movImm x10, 8
    arm64.movImm x11, 9
    arm64.movImm x19, 10
    arm64.movImm x20, 11
    arm64.movImm x21, 12
    arm64.movImm x3, 13
    arm64.movImm x4, 14
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.storeOutgoingArg [sp + arg0], x11
    arm64.storeOutgoingArg [sp + arg1], x19
    arm64.storeOutgoingArg [sp + arg2], x20
    arm64.storeOutgoingArg [sp + arg3], x21
    arm64.storeOutgoingArg [sp + arg4], x3
    arm64.storeOutgoingArg [sp + arg5], x4
    arm64.movRegReg x3, x6
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x8
    arm64.movRegReg x6, x9
    arm64.movRegReg x7, x10
    arm64.bl f
    arm64.loadRegSlot x19, slot0
