// Test: confined-reuse-defs-at-x64s-own-scale-float
function fsink(x Real) returns Real
	return x + 1.0
end 'fsink'

function main() returns ExitCode
	let n = fsink(3.0)
	let a0 = n + 1.0
	let a1 = n + 2.0
	let a2 = n + 3.0
	let a3 = n + 4.0
	let a4 = n + 5.0
	let a5 = n + 6.0
	let a6 = n + 7.0
	let a7 = n + 8.0
	let a8 = n + 9.0
	let a9 = n + 10.0
	let a10 = n + 11.0
	let a11 = n + 12.0
	let a12 = n + 13.0
	let a13 = n + 14.0
	let a14 = n + 15.0
	let a15 = n + 16.0
	let b0 = a0 * 2.0
	let b1 = a1 * 2.0
	let b2 = a2 * 2.0
	let b3 = a3 * 2.0
	let s = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15
	let c = fsink(s)
	let total = b0 + b1 + b2 + b3 + c
	return 0 if total == 253.0 else 99
end 'main'
typealias Real = float(f64.min to f64.max)
