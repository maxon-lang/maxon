// Test: back-edge-swap
function swapLoop(p int) returns int
	var a = p + 1
	var b = p + 2
	var i = 0
	while i < 3 'loop'
		var t = a
		a = b
		b = t
		i = i + 1
	end 'loop'
	return a * 10 + b
end 'swapLoop'

function main() returns ExitCode
	let r = swapLoop(0)
	if r == 21 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @swapLoop {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x0, x0, 2
    arm64.movImm x2, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x2, 3
    arm64.cset x6, lt
    arm64.cbnz x6, loop
    arm64.b whileexit
  loop:
    arm64.add x2, x2, 1
    arm64.xchgRegReg x1, x0
    arm64.b whilehdr
  whileexit:
    arm64.movImm x16, 10
    arm64.mul x1, x1, x16
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl swapLoop
    arm64.cmp x0, 21
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
