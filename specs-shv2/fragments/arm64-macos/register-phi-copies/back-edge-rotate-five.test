// Test: back-edge-rotate-five
function rotate5(p int) returns int
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var d = p + 4
	var e = p + 5
	var i = 0
	while i < 3 'loop'
		var t = a
		a = b
		b = c
		c = d
		d = e
		e = t
		i = i + 1
	end 'loop'
	return a * 10000 + b * 1000 + c * 100 + d * 10 + e
end 'rotate5'

function main() returns ExitCode
	let r = rotate5(0)
	if r == 45123 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @rotate5 {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x6, x0, 3
    arm64.add x7, x0, 4
    arm64.add x0, x0, 5
    arm64.movImm x8, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x8, 3
    arm64.cset x9, lt
    arm64.cbnz x9, loop
    arm64.b whileexit
  loop:
    arm64.add x8, x8, 1
    arm64.xchgRegReg x1, x2
    arm64.xchgRegReg x2, x6
    arm64.xchgRegReg x6, x7
    arm64.xchgRegReg x7, x0
    arm64.b whilehdr
  whileexit:
    arm64.movImm x16, 10000
    arm64.mul x1, x1, x16
    arm64.movImm x16, 1000
    arm64.mul x2, x2, x16
    arm64.add x1, x1, x2
    arm64.movImm x16, 100
    arm64.mul x2, x6, x16
    arm64.add x1, x1, x2
    arm64.movImm x16, 10
    arm64.mul x2, x7, x16
    arm64.add x1, x1, x2
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl rotate5
    arm64.cmp x0, 45123
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
