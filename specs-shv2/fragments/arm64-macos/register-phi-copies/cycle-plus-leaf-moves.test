// Test: cycle-plus-leaf-moves
function cycleAndLeaf(p int) returns int
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var d = p
	var i = 0
	while i < 4 'loop'
		var t = a
		d = a
		a = b
		b = c
		c = t
		i = i + 1
	end 'loop'
	return a * 1000 + b * 100 + c * 10 + d
end 'cycleAndLeaf'

function main() returns ExitCode
	let r = cycleAndLeaf(0)
	if r == 2311 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @cycleAndLeaf {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x6, x0, 3
    arm64.movImm x7, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x7, 4
    arm64.cset x8, lt
    arm64.cbnz x8, loop
    arm64.b whileexit
  loop:
    arm64.add x7, x7, 1
    arm64.movRegReg x0, x1
    arm64.xchgRegReg x1, x2
    arm64.xchgRegReg x2, x6
    arm64.b whilehdr
  whileexit:
    arm64.movImm x16, 1000
    arm64.mul x1, x1, x16
    arm64.movImm x16, 100
    arm64.mul x2, x2, x16
    arm64.add x1, x1, x2
    arm64.movImm x16, 10
    arm64.mul x2, x6, x16
    arm64.add x1, x1, x2
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl cycleAndLeaf
    arm64.cmp x0, 2311
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
