// Test: stdlib-overlay-print-string-alone-is-legal
// --- stdlib-overlay: Builtins.maxon
export function __print_string(value String)
	_ = value.byteLength()
end '__print_string'

export enum __UnprintedProbe
	answer
end '__UnprintedProbe'
// --- file: main.maxon
function main() returns ExitCode
	return match __UnprintedProbe.answer 'which'
		answer gives 42
	end 'which'
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 42
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x1, 42
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
