// Test: a-non-commutative-op-keeps-its-copy
typealias Word = int(i64.min to i64.max)

function difference(a Word, b Word) returns Word
	let scaled = b * 3
	let d = a - scaled
	return d + a
end 'difference'

function main() returns ExitCode
	var seen = 0
	for i in 0 upto 4 'feed'
		seen = seen + difference(i * 10, b: i)
	end 'feed'
	// a = 0,10,20,30; scaled = 0,3,6,9; d = 0,7,14,21; d+a = 0,17,34,51 -> 102
	// commuted, `d` would be scaled - a = 0,-7,-14,-21 and the sum 18
	if seen != 102 'sum'
		return 1
	end 'sum'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 4
    arm64.cset x2, lt
    arm64.cbnz x2, feed
    arm64.b forexit
  feed:
    arm64.movImm x16, 10
    arm64.mul x2, x1, x16
    arm64.b __il_body
  __il_body:
    arm64.movImm x16, 3
    arm64.mul x3, x1, x16
    arm64.sub x3, x2, x3
    arm64.add x2, x3, x2
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, x2
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 102
    arm64.cset x0, ne
    arm64.cbnz x0, sum
    arm64.b ifcont
  sum:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
