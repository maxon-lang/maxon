// Test: static-method-no-self

typealias Integer = int(i64.min to i64.max)

type Math
	var unused as Integer

	static function add(a Integer, b Integer) returns Integer
		return a + b
	end 'add'
end 'Math'

function main() returns ExitCode
	return Math.add(20, b: 22)
end 'main'
---
ExitCode: 42
---
func @Math.add {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 22
    arm64.bl Math.add
    arm64.epilogue 16
    arm64.ret
}
