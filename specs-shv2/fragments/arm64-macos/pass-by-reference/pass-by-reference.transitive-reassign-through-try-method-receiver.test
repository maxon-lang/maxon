    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Forwarder.reassign {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.movRegReg x20, x2
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __mm_decref
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @helper {
  entry:
    arm64.prologue 16
    arm64.movRegReg x3, x0
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x3
    arm64.bl Forwarder.reassign
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

