// Test: pass-by-reference.enum-float-backed-ref

enum Ratio
	half = 0.5
	quarter = 0.25
end 'Ratio'

function switchRatio(r Ratio)
	r = Ratio.quarter
end 'switchRatio'

function main() returns ExitCode
	var r = Ratio.half
	switchRatio(r)
	if r == Ratio.quarter 'changed'
		return 1
	end 'changed'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @switchRatio {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 4598175219545276416
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 4602678819172646912
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl switchRatio
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movImm x1, 4598175219545276416
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.cbnz x0, changed
    arm64.b ifcont
  changed:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
