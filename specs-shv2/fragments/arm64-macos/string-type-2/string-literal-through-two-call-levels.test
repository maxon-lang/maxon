// Test: string-literal-through-two-call-levels
function grow(s String)
	s.append("XY")
end 'grow'

function outer(t String)
	grow(t)
end 'outer'

function main() returns ExitCode
	outer("hello")
	print("hello\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @grow {
  entry:
    arm64.prologue 16
    arm64.leaRdata x1, __str_rec_3
    arm64.bl String.append
    arm64.epilogue 16
    arm64.ret
}

func @outer {
  entry:
    arm64.prologue 16
    arm64.bl grow
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_4
    arm64.bl __str_clone
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl outer
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.leaRdata x0, __str_rec_5
    arm64.bl print
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
