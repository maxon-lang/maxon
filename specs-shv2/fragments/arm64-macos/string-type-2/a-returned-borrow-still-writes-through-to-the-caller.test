// Test: a-returned-borrow-still-writes-through-to-the-caller
function relay(s String) returns String
	return s
end 'relay'

function main() returns ExitCode
	var v = "ab"
	var out = relay(v)
	out.append("XY")
	print("v={v} out={out}\n")
	return 0
end 'main'
---
ExitCode: 0
