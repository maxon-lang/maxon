// Test: basic-namespace

typealias Integer = int(i64.min to i64.max)

function add(a Integer, b Integer) returns Integer
	return a + b
end 'add'

function main() returns ExitCode
	return add(10, b: 20)
end 'main'
---
ExitCode: 30
---
func @add {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 20
    arm64.bl add
    arm64.epilogue 16
    arm64.ret
}
