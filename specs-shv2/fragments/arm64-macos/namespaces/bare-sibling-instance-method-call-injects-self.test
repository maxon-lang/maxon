// Test: bare-sibling-instance-method-call-injects-self
typealias Count = int(0 to 100)

type Counter
	var total as Count

	static function make() returns Counter
		return Counter{total: 0}
	end 'make'

	function bump(amount Count) returns Count
		self.total = self.total + amount
		return self.total
	end 'bump'

	export function bumpTwice(amount Count) returns Count
		let first = bump(amount)
		return bump(first)
	end 'bumpTwice'
end 'Counter'

function main() returns ExitCode
	var c = Counter.make()
	return c.bumpTwice(5)
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.bump {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
    arm64.cmp x1, 100
    arm64.b.le __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at bare-sibling-instance-method-call-injects-self.test:11: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x1, x2, x1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#5
  __rc_chk#6:
    arm64.cmp x1, 100
    arm64.b.le __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at bare-sibling-instance-method-call-injects-self.test:12: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Counter.bumpTwice {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at bare-sibling-instance-method-call-injects-self.test:16: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl Counter.bump
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl Counter.bump
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 5
    arm64.bl Counter.bumpTwice
    arm64.epilogue 32
    arm64.ret
}
