// Test: abs.float
function main() returns ExitCode
	let neg = -5.5
	let x = abs(neg)
	let y = trunc(x)
	return y
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fabs d0, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
