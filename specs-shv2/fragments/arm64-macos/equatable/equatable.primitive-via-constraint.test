// Test: equatable.primitive-via-constraint
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Equatable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function bothEqual() returns bool
		return self.a.equals(self.b)
	end 'bothEqual'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let same = IntPair.create(5, b: 5)
	let diff = IntPair.create(5, b: 9)
	if not same.bothEqual() 'shouldEq'
		return 1
	end 'shouldEq'
	if diff.bothEqual() 'shouldNe'
		return 2
	end 'shouldNe'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.bothEqual {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x3, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x3
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x19
    arm64.movImm x0, 5
    arm64.movImm x1, 5
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.movImm x0, 5
    arm64.movImm x1, 9
    arm64.leaRdata x3, __witness_int.Equatable
    arm64.leaRegSlot x19, slot2
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x1
    arm64.leaRdata x1, __witness_int.Equatable
    arm64.movRegReg x0, x2
    arm64.bl Pair.bothEqual
    arm64.eor x0, x0, 1
    arm64.cbnz x0, shouldEq
    arm64.b ifcont#2
  shouldEq:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont#2:
    arm64.leaRdata x1, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Pair.bothEqual
    arm64.cbnz x0, shouldNe
    arm64.b ifcont#4
  shouldNe:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot4
    arm64.epilogue 64
    arm64.ret
}
