// Test: equatable.primitive-via-constraint
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Equatable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function bothEqual() returns bool
		return self.a.equals(self.b)
	end 'bothEqual'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let same = IntPair.create(5, b: 5)
	let diff = IntPair.create(5, b: 9)
	if not same.bothEqual() 'shouldEq'
		return 1
	end 'shouldEq'
	if diff.bothEqual() 'shouldNe'
		return 2
	end 'shouldNe'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Pair.bothEqual {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.movImm x1, 5
    arm64.bl Pair.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 5
    arm64.movImm x1, 9
    arm64.bl Pair.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Pair.bothEqual
    arm64.eor x0, x0, 1
    arm64.cbnz x0, shouldEq
    arm64.b ifcont
  shouldEq:
    arm64.movImm x21, 1
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.leaRdata x1, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl Pair.bothEqual
    arm64.cbnz x0, shouldNe
    arm64.b ifcont
  shouldNe:
    arm64.movImm x21, 2
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @int.equals {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.cbnz x0, equal
    arm64.b notEqual
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
