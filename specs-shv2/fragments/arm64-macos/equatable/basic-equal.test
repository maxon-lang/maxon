// Test: basic-equal

typealias Integer = int(i64.min to i64.max)

type Point implements Equatable
	export var x as Integer
	export var y as Integer

	function equals(other Point) returns bool
		return x == other.x and y == other.y
	end 'equals'

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = Point.create(1, y: 2)
	if a.equals(b) 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.leaRegSlot x3, slot2
    arm64.storeBaseDispReg.word64 [x3 + 0], x0
    arm64.storeBaseDispReg.word64 [x3 + 8], x1
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x3 + 0]
    arm64.cmp x0, x1
    arm64.movImm x0, 0
    arm64.b.ne __il_cont
  andrhs:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x3 + 8]
    arm64.cmp x0, x1
    arm64.cset x0, eq
  __il_cont:
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 48
    arm64.ret
}
