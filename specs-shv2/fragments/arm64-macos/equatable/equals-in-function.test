// Test: equals-in-function

typealias Integer = int(i64.min to i64.max)

type Id implements Equatable
	export var n as Integer

	function equals(other Id) returns bool
		return n == other.n
	end 'equals'

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Id'

function areEqual(a Id, b Id) returns bool
	return a.equals(b)
end 'areEqual'

function main() returns ExitCode
	let x = Id.create(5)
	let y = Id.create(5)
	let z = Id.create(6)
	if areEqual(x, b: y) 'eq'
		if areEqual(x, b: z) 'neq'
			return 1
		end 'neq'
		return 0
	end 'eq'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Id.equals {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @Id.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @areEqual {
  entry:
    arm64.prologue 16
    arm64.bl Id.equals
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl Id.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 5
    arm64.bl Id.create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 6
    arm64.bl Id.create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl areEqual
    arm64.cbnz x0, eq
    arm64.b ifcont
  eq:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl areEqual
    arm64.cbnz x0, neq
    arm64.b ifcont
  neq:
    arm64.movImm x22, 1
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x22, 0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x22, 1
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
