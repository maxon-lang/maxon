// Test: an-out-of-range-constant-set-still-throws
typealias Int = int(i64.min to i64.max)
typealias Vec2 = Vector with 2 Int

function main() returns ExitCode
	var v = Vec2.create()
	try v.set(0, value: 5) otherwise panic("test invariant: set OOB")
	try v.set(9, value: 99) otherwise 'oob'
		return (try v.get(0) otherwise 0) + 60
	end 'oob'
	return 0
end 'main'
---
ExitCode: 65
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N2_Int
    arm64.movImm x1, 2
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movImm x2, 5
    arm64.leaRdata x3, __layout_Vector_N2_Int
    arm64.movImm x4, 2
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movImm x1, 9
    arm64.movImm x2, 99
    arm64.leaRdata x3, __layout_Vector_N2_Int
    arm64.movImm x4, 2
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_Vector_N2_Int
    arm64.movRegReg x0, x19
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#6
    arm64.b tryok#5
  tryerr#6:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok#5:
    arm64.b trycont
  trycont:
    arm64.add x20, x0, 60
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#3:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
