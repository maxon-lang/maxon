    arm64.orr x2, x19, x1
    arm64.sdiv x16, x0, x2
    arm64.msub x20, x16, x2, x0
    arm64.cmp x1, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 77
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.movImm x0, 0
