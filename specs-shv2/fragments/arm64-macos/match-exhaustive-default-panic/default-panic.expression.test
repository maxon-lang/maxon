// Test: default-panic.expression
function main() returns ExitCode
	let x = 3
	let result = match x 'eval'
		1 gives 10
		2 gives 20
		3 gives 30
		default panic("unexpected value")
	end 'eval'
	return result
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b matchnext#5
  matchnext#5:
    arm64.b matchnext#6
  matchnext#6:
    arm64.b matcharm
  matcharm:
    arm64.movImm x0, 30
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
