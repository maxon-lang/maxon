// Test: remove-on-let-set-error
typealias Integer = int(i64.min to i64.max)
typealias IntSet = Set with Integer

function main() returns ExitCode
	let s = IntSet.create()
	let gone = s.remove(1)
	if gone 'g'
		return 1
	end 'g'
	return s.count() as ExitCode
end 'main'
---
CompilerError:
error E3019: <fragment>:7:15: cannot pass 's' to function that mutates parameter 'self' (in main)
