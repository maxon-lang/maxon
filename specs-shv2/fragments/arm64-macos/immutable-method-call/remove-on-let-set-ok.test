// Test: remove-on-let-set-ok
typealias Integer = int(i64.min to i64.max)
typealias IntSet = Set with Integer

function main() returns ExitCode
	let s = IntSet.create()
	let gone = s.remove(1)
	if gone 'g'
		return 1
	end 'g'
	return s.count() as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Set_Integer
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Set.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Set_Integer
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Set.remove
    arm64.cbnz x0, g
    arm64.b ifcont
  g:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_Integer
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 24]
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_chk#9
  __rc_chk#9:
    arm64.movImm x0, 4611686018427387904
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_ok#8
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl Set.count
    arm64.movRegReg x20, x0
    arm64.b __il_cont
  __rc_ok#8:
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk#5
  __rc_chk#5:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#3
  __rc_panic:
    arm64.leaRdata x0, __str_blob_18  ; "panic at remove-on-let-set-ok.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#3:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_Integer
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
