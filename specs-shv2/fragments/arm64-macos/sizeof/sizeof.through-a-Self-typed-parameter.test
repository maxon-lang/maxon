// Test: sizeof.through-a-Self-typed-parameter
typealias Int = int(i64.min to i64.max)
typealias IntBag = Bag with Int

type Bag uses Element
	typealias Items = Array with Element

	var items as Items

	export static function create() returns Self
		return Self{items: Items.create()}
	end 'create'

	export function slotSize() returns Int
		return sizeof(Element)
	end 'slotSize'

	export function pairWith(other Self) returns Int
		return other.slotSize()
	end 'pairWith'
end 'Bag'

function main() returns ExitCode
	var a = IntBag.create()
	var b = IntBag.create()
	return a.pairWith(b)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.pairWith {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 56]
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Bag_Int
    arm64.bl Bag.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __layout_Bag_Int
    arm64.bl Bag.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_Bag_Int
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Bag.pairWith
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Bag_Int
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Int
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at sizeof.through-a-Self-typed-parameter.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
