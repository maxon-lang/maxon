// Test: sizeof.struct
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer
end 'Point'

function main() returns ExitCode
	return sizeof(Point)
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16
    arm64.epilogue 16
    arm64.ret
}
