// Test: sizeof.struct-three-fields
typealias Integer = int(i64.min to i64.max)

type Vec3
	export var x as Integer
	export var y as Integer
	export var z as Integer
end 'Vec3'

function main() returns ExitCode
	return sizeof(Vec3)
end 'main'
---
ExitCode: 24
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 24
    arm64.epilogue 16
    arm64.ret
}
