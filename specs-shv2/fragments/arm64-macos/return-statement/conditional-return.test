// Test: conditional-return
function firstOver(x Integer) returns Integer
	if x > 3 'check'
		return 1
	end 'check'
	return 0
end 'firstOver'

function main() returns ExitCode
	if firstOver(5) != 1 'branchTaken'
		return 2
	end 'branchTaken'

	if firstOver(1) != 0 'branchNotTaken'
		return 3
	end 'branchNotTaken'

	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 1
  __il_cont#5:
    arm64.cmp x0, 1
    arm64.b.eq ifcont#12
  branchTaken:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#12:
    arm64.movImm x0, 0
  __il_cont#9:
    arm64.cmp x0, 0
    arm64.b.eq ifcont#4
  branchNotTaken:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
