// Test: return-in-if-then-reachable
function classify(x ExitCode) returns ExitCode
	if x > 0 'positive'
		return 1
	end 'positive'
	return 0
end 'classify'

function main() returns ExitCode
	return classify(5)
end 'main'
---
ExitCode: 1
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x0, gt
    arm64.cbnz x0, positive
    arm64.b ifcont
  positive:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl classify
    arm64.epilogue 16
    arm64.ret
}
