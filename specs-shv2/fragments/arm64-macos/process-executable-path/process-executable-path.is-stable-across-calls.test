// Test: process-executable-path.is-stable-across-calls
function main() returns ExitCode
	let first = try Process.executablePath() otherwise return 2
	let second = try Process.executablePath() otherwise return 3
	if first.path == second.path 'agree'
		return 4
	end 'agree'
	return 1
end 'main'
---
ExitCode: 4
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Process.executablePath
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.bl Process.executablePath
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.bl __str_eq
    arm64.cbnz x0, agree
    arm64.b ifcont
  agree:
    arm64.movImm x21, 4
    arm64.movRegReg x0, x20
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x21, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
