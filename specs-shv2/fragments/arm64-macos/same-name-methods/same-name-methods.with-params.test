// Test: same-name-methods.with-params
typealias Integer = int(i64.min to i64.max)

type Calc
	export var base as Integer

	static function create(base Integer) returns Calc
		return Calc{base: base}
	end 'create'

	static function add(a Integer, b Integer) returns Integer
		return a + b
	end 'add'

	function add(x Integer) returns Integer
		return base + x
	end 'add'
end 'Calc'

function main() returns ExitCode
	let c = Calc.create(30)
	let instanceResult = c.add(10)
	let staticResult = Calc.add(1, b: 1)
	return instanceResult + staticResult
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 30
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 10
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x0, x0, 2
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
