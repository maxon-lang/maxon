// Test: ternary-expression.chained
function main() returns ExitCode
	let a = false
	let b = true
	let x = 1 if a else 2 if b else 3
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 1
    arm64.b matchcont
  ternaryfalse:
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 2
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 3
    arm64.b matchcont
  matchcont:
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
