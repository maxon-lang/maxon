// Test: ternary-expression.basic-true
function main() returns ExitCode
	let x = 10 if true else 20
	return x
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 10
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 20
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
