// Test: ternary-expression.complex-expressions
function main() returns ExitCode
	let a = 3
	let b = 2
	let cond = true
	let x = a + b if cond else a * b
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.movImm x1, 1
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.add x0, x0, 2
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
