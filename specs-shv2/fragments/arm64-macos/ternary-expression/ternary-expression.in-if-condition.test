// Test: ternary-expression.in-if-condition
function main() returns ExitCode
	let c = true
	if (5 if c else 3) > 4 'g'
		return 1
	end 'g'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  ternarytrue:
    arm64.movImm x0, 5
  matchcont:
    arm64.cmp x0, 4
    arm64.b.le ifcont
  g:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
