// Test: ternary-expression.in-while-condition
function main() returns ExitCode
	var i = 0
	let lim = true
	while i < (3 if lim else 1) 'l'
		i = i + 1
	end 'l'
	return i
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x2, 3
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x2, 1
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, x2
    arm64.cset x2, lt
    arm64.cbnz x2, l
    arm64.b whileexit
  l:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
