// Test: ternary-expression.elision.true-arm-not-evaluated
var sideEffectCount = 0

function track(result Integer) returns Integer
	sideEffectCount = sideEffectCount + 1
	return result
end 'track'

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let x = track(9) if false else 7
	if x != 7 'v'
		return 99
	end 'v'
	return sideEffectCount
end 'main'
---
ExitCode: 0
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @track {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 9
    arm64.bl track
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 7
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 7
    arm64.cset x0, ne
    arm64.cbnz x0, v
    arm64.b ifcont
  v:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
