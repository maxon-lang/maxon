// Test: ternary-expression.nested-in-if-body
function main() returns ExitCode
	var total = 0
	let c = true
	if c 'g'
		let x = 5 if c else 9
		total = total + x
	end 'g'
	return total
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.cbnz x1, g
    arm64.b critsplit
  g:
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 5
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 9
    arm64.b matchcont
  matchcont:
    arm64.add x0, x0, 0
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
