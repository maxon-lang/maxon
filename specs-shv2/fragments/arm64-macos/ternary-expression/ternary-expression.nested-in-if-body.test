// Test: ternary-expression.nested-in-if-body
function main() returns ExitCode
	var total = 0
	let c = true
	if c 'g'
		let x = 5 if c else 9
		total = total + x
	end 'g'
	return total
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.cbnz x1, g
    arm64.b critsplit
  g:
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 5
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 9
    arm64.b matchcont
  matchcont:
    arm64.add x0, x0, 0
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
