// Test: ternary-expression.logical-op-condition
type Flags
	export let a as bool
	export let b as bool

	export static function make(a bool, b bool) returns Flags
		return Flags{a: a, b: b}
	end 'make'
end 'Flags'

function pick(f Flags) returns ExitCode
	let either = f.a or f.b
	let both = f.a and f.b
	let one = 4 if either else 0
	let two = 1 if both else 0
	return (one + two) as ExitCode
end 'pick'

function main() returns ExitCode
	return pick(Flags.make(true, b: false))
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Flags.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.byte [x0 + 0], x19
    arm64.storeBaseDispReg.byte [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.byte x1, [x0 + 0]
    arm64.movImm x2, 1
    arm64.cbnz x1, critsplit#14
    arm64.b orrhs
  critsplit#14:
    arm64.b scmerge#2
  orrhs:
    arm64.loadRegBaseDisp.byte x1, [x0 + 8]
    arm64.movRegReg x2, x1
    arm64.b scmerge#2
  scmerge#2:
    arm64.loadRegBaseDisp.byte x1, [x0 + 0]
    arm64.movImm x3, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit#15
  andrhs:
    arm64.loadRegBaseDisp.byte x0, [x0 + 8]
    arm64.b scmerge#4
  critsplit#15:
    arm64.movRegReg x0, x3
    arm64.b scmerge#4
  scmerge#4:
    arm64.cbnz x2, ternarytrue#5
    arm64.b ternaryfalse#6
  ternarytrue#5:
    arm64.movImm x1, 4
    arm64.b matchcont#7
  ternaryfalse#6:
    arm64.movImm x1, 0
    arm64.b matchcont#7
  matchcont#7:
    arm64.cbnz x0, ternarytrue#8
    arm64.b ternaryfalse#9
  ternarytrue#8:
    arm64.movImm x0, 1
    arm64.b matchcont#10
  ternaryfalse#9:
    arm64.movImm x0, 0
    arm64.b matchcont#10
  matchcont#10:
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ternary-expression.logical-op-condition.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl Flags.make
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl pick
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
