// Test: error.associated-value-type-mismatch

typealias Integer = int(i64.min to i64.max)

union Container
	value(n Integer)
end 'Container'

function main() returns ExitCode
	let _c = Container.value("hello")
	return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:10:34: type mismatch: 'expected Integer, got String'
