// Test: enum-method-private-helper
enum Signal
	red
	green
	yellow

	function isStop() returns bool
		return match self 'check'
			red gives true
			green gives false
			yellow gives false
		end 'check'
	end 'isStop'

	export function action() returns bool
		return self.isStop()
	end 'action'
end 'Signal'

function main() returns ExitCode
	let s = Signal.red
	if s.action() 'isRed'
		return 1
	end 'isRed'
	return 0
end 'main'
---
ExitCode: 1
---
func @Signal.isStop {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @Signal.action {
  entry:
    arm64.prologue 16
    arm64.bl Signal.isStop
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl Signal.action
    arm64.cbnz x0, isRed
    arm64.b ifcont
  isRed:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
