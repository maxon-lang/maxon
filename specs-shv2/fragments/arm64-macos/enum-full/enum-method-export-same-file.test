// Test: enum-method-export-same-file
enum Toggle
	on
	off

	export function isOn() returns bool
		return match self 'check'
			on gives true
			off gives false
		end 'check'
	end 'isOn'
end 'Toggle'

function main() returns ExitCode
	let t = Toggle.on
	if t.isOn() 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @Toggle.isOn {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl Toggle.isOn
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
