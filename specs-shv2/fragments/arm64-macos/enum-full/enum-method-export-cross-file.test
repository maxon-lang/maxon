// Test: enum-method-export-cross-file
// --- file: signal.maxon
export enum Signal
	on
	off

	export function isOn() returns bool
		return match self 'check'
			on gives true
			off gives false
		end 'check'
	end 'isOn'
end 'Signal'

// --- file: main.maxon
function main() returns ExitCode
	let s = Signal.on
	if s.isOn() 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl Signal.isOn
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @Signal.isOn {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
