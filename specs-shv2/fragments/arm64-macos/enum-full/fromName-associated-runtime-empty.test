// Test: fromName-associated-runtime-empty

typealias Integer = int(i64.min to i64.max)

union Container
	empty
	value(n Integer)
end 'Container'

function getName() returns String
	return "empty"
end 'getName'

function main() returns ExitCode
	let name = getName()
	let c = try Container.fromName(name) otherwise Container.value(99)
	match c 'check'
		empty then return 1
		value then return 0
	end 'check'
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @getName {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "empty"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl getName
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __enum_from_name_Container
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 99
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#4
    arm64.b matchnext
  matcharm#4:
    arm64.movImm x20, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#5
    arm64.b matchdead
  matcharm#5:
    arm64.movImm x20, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
