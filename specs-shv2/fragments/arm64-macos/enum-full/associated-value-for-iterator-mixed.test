// Test: associated-value-for-iterator-mixed

typealias Integer = int(i64.min to i64.max)

union Slot
		none
		val(n Integer)
end 'Slot'

typealias SlotArray = Array with Slot

function main() returns ExitCode
		var slots = SlotArray.create()
		slots.push(Slot.val(5))
		slots.push(Slot.none)
		slots.push(Slot.val(3))
		var total = 0
		for e in slots 'loop'
				match e 'check'
						none then total = total + 100
						val(n) then total = total + n
				end 'check'
		end 'loop'
		return total
end 'main'
---
ExitCode: 108
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 5
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 8], x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x20, 3
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b forexit
  loop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __arr_get_unchecked
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.add x0, x20, 100
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x0, x20, x0
    arm64.b matchcont
  matchcont:
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.movRegReg x20, x0
    arm64.b forhdr
  matchdead:
  forexit:
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
