// Test: comparable.compare-via-witness
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function order() returns Integer
		let o = self.a.compare(self.b)
		let r = match o 'check'
			lessThan gives 1
			equalTo gives 2
			greaterThan gives 3
		end 'check'
		return r
	end 'order'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let less = IntPair.create(3, b: 9)
	let same = IntPair.create(7, b: 7)
	let more = IntPair.create(9, b: 3)

	return less.order() * 100 + same.order() * 10 + more.order()
end 'main'
---
ExitCode: 123
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Pair.order {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 3
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 9
    arm64.bl Pair.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 7
    arm64.movImm x1, 7
    arm64.bl Pair.create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 9
    arm64.movImm x1, 3
    arm64.bl Pair.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x19
    arm64.bl Pair.order
    arm64.movImm x16, 100
    arm64.mul x22, x0, x16
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x20
    arm64.bl Pair.order
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x22, x22, x0
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x21
    arm64.bl Pair.order
    arm64.add x22, x22, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @int.compare {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, less
    arm64.b notLess
  less:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  notLess:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, greater
    arm64.b equal
  greater:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
