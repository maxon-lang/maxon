// Test: comparable.compare-in-loop-no-leak
typealias Counter = int(0 to 1000)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function isLess() returns bool
		let o = self.a.compare(self.b)
		let r = match o 'check'
			lessThan gives true
			equalTo gives false
			greaterThan gives false
		end 'check'
		return r
	end 'isLess'
	export function opLess() returns bool
		return self.a < self.b
	end 'opLess'
end 'Pair'

typealias CountPair = Pair with Counter

function main() returns ExitCode
	var i = 0 as Counter
	var acc = 0 as Counter
	while i < 100 'loop'
		let p = CountPair.create(3, b: 9)
		if p.isLess() 'ok'
			acc = acc + 1
		end 'ok'
		if p.opLess() 'ok2'
			acc = acc + 1
		end 'ok2'
		i = i + 1
	end 'loop'
	if acc == 200 'all'
		return 0
	end 'all'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Pair.isLess {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @Pair.opLess {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x19, 100
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movImm x0, 3
    arm64.movImm x1, 9
    arm64.bl Pair.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x21
    arm64.bl Pair.isLess
    arm64.cbnz x0, ok
    arm64.b critsplit
  ok:
    arm64.add x20, x20, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x21
    arm64.bl Pair.opLess
    arm64.cbnz x0, ok2
    arm64.b critsplit
  ok2:
    arm64.add x20, x20, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.add x19, x19, 1
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.b whilehdr
  whileexit:
    arm64.cmp x20, 200
    arm64.cset x0, eq
    arm64.cbnz x0, all
    arm64.b ifcont
  all:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @int.compare {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, less
    arm64.b notLess
  less:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  notLess:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, greater
    arm64.b equal
  greater:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
