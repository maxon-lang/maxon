// Test: comparable.user-type-direct-compare
typealias Coord = int(0 to 1000)

type Point implements Comparable
	export var x as Coord
	export static function create(x Coord) returns Self
		return Self{ x: x }
	end 'create'
	export function compare(other Point) returns Ordering
		if self.x < other.x 'lt'
			return Ordering.lessThan
		end 'lt'
		if self.x > other.x 'gt'
			return Ordering.greaterThan
		end 'gt'
		return Ordering.equalTo
	end 'compare'
end 'Point'

function main() returns ExitCode
	let a = Point.create(3)
	let b = Point.create(9)
	let o = a.compare(b)
	let r = match o 'check'
		lessThan gives 1
		equalTo gives 2
		greaterThan gives 3
	end 'check'
	return r
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Point.compare {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x1 + 0]
    arm64.cmp x2, x6
    arm64.cset x2, lt
    arm64.cbnz x2, lt
    arm64.b ifcont
  lt:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, gt
    arm64.b ifcont
  gt:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 9
    arm64.bl Point.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Point.compare
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x21, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x21, 2
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x21, 3
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}
