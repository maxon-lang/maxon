// Test: comparable.ordering-reversed-operands
typealias Integer = int(0 to u32.max)

type Pair uses T where T is Comparable
	export var a as T
	export var b as T
	export static function create(a T, b T) returns Self
		return Self{ a: a, b: b }
	end 'create'
	export function forwardLess() returns bool
		return self.a < self.b
	end 'forwardLess'
	export function reverseLess() returns bool
		return self.b < self.a
	end 'reverseLess'
end 'Pair'

typealias IntPair = Pair with Integer

function main() returns ExitCode
	let p = IntPair.create(3, b: 9)
	var r = 0 as Integer
	if p.forwardLess() 'f'
		r = r + 1
	end 'f'
	if p.reverseLess() 'g'
		r = r + 10
	end 'g'
	return r
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Pair.forwardLess {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @Pair.reverseLess {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 9
    arm64.bl Pair.create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x19
    arm64.bl Pair.forwardLess
    arm64.cbnz x0, f
    arm64.b critsplit
  f:
    arm64.add x20, x20, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.movRegReg x0, x19
    arm64.bl Pair.reverseLess
    arm64.cbnz x0, g
    arm64.b critsplit
  g:
    arm64.add x20, x20, 10
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @int.compare {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, less
    arm64.b notLess
  less:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  notLess:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, greater
    arm64.b equal
  greater:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
