    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x0, 0
  forhdr:
    arm64.cmp x0, 0
    arm64.b.ne forexit
  loop:
    arm64.movRegReg x0, x19
    arm64.bl NotEqSeq.current
    arm64.add x20, x20, 1
    arm64.bl __mm_decref
  forstep:
    arm64.movRegReg x0, x19
    arm64.bl NotEqSeq.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

