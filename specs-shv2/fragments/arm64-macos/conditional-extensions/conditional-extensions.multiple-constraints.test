// Test: conditional-extensions.multiple-constraints

typealias Integer = int(i64.min to i64.max)

interface Bucket uses Element
	function current() returns Element
	function advance() throws IterationError
end 'Bucket'

extension Bucket where Element is Equatable and Hashable
	function lookup(target Element) returns bool
		for item in self 'loop'
			if item == target 'found'
				return true
			end 'found'
		end 'loop'
		return false
	end 'lookup'
end 'Bucket'

type HashItem implements Equatable, Hashable
	export var v as Integer

	function equals(other HashItem) returns bool
		return v == other.v
	end 'equals'

	function hash() returns HashValue
		return v
	end 'hash'

	static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'HashItem'

typealias HashItemArray = Array with HashItem

type HashBucket implements Bucket with HashItem
	let items as HashItemArray
	var idx as Integer

	function current() returns HashItem
		return try items.get(idx) otherwise panic("HashBucket.current: idx out of bounds")
	end 'current'

	function advance() throws IterationError
		if idx + 1 >= items.count() 'done'
			throw IterationError.exhausted
		end 'done'
		idx = idx + 1
	end 'advance'

	static function create(items HashItemArray) returns Self throws IterationError
		if items.count() == 0 'empty'
			throw IterationError.exhausted
		end 'empty'
		return Self{items: items, idx: 0}
	end 'create'
end 'HashBucket'

function main() returns ExitCode
	let b = try HashBucket.create([HashItem.create(1), HashItem.create(2), HashItem.create(3)]) otherwise return 2
	if b.lookup(HashItem.create(2)) 'found'
		return 1
	end 'found'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @HashBucket.lookup {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, loop
    arm64.b forexit
  loop:
    arm64.movRegReg x0, x19
    arm64.bl HashBucket.current
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x20 + 0]
    arm64.cmp x1, x2
    arm64.cset x1, eq
    arm64.b __il_cont
  __il_cont:
    arm64.cbnz x1, found
    arm64.b ifcont
  found:
    arm64.movImm x19, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.bl __mm_decref
    arm64.b forstep
  forstep:
    arm64.movRegReg x0, x19
    arm64.bl HashBucket.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @HashItem.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @HashBucket.current {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.cmp x2, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_load
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.arm64AddLsl x0, x0, x2, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x1 + 40]
    arm64.cmp x4, 0
    arm64.cset x4, ne
    arm64.cbnz x4, __im_empty
    arm64.b critsplit#9
  __im_empty:
    arm64.cmp x0, 0
    arm64.cset x4, eq
    arm64.cbnz x4, __im_slow
    arm64.b critsplit#10
  __im_slow:
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#10:
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  critsplit#9:
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @HashBucket.advance {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.add x1, x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 8]
    arm64.cmp x1, x2
    arm64.cset x1, ge
    arm64.cbnz x1, done
    arm64.b ifcont
  done:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.add x1, x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @HashBucket.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, empty
    arm64.b ifcont
  empty:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 1
    arm64.bl HashItem.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_push
    arm64.movImm x0, 2
    arm64.bl HashItem.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x0, 3
    arm64.bl HashItem.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl HashBucket.create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x0, 2
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl HashBucket.lookup
    arm64.cbnz x0, found
    arm64.b ifcont
  found:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_HashBucket
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_HashBucket
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
