// Test: cross-file-function-alias-is-a-swept-value-type
// --- file: alias.maxon
export typealias Int = int(i64.min to i64.max)
export typealias UnaryOp = function(Int) returns Int

// --- file: main.maxon
function twice(n Int) returns Int
	return n * 2
end 'twice'

type Holder
	export var op as UnaryOp

	export static function create() returns Holder
		return Self{op: twice}
	end 'create'
end 'Holder'

function pick() returns UnaryOp
	return twice
end 'pick'

function main() returns ExitCode
	let h = Holder.create()
	let f = pick()
	return (h.op(7) + f(14)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @twice {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, __fnref_twice
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Holder.create
    arm64.movRegReg x19, x0
  __il_body:
    arm64.leaFuncAddr x20, __fnref_twice
  __il_cont:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 0]
    arm64.movImm x0, 7
    arm64.movImm x1, 0
    arm64.blr x21
    arm64.movRegReg x21, x0
    arm64.movImm x0, 14
    arm64.movImm x1, 0
    arm64.blr x20
    arm64.add x20, x21, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at main.maxon:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
