// Test: cross-file-generic-alias-is-a-swept-value-type
// --- file: aaa-alias.maxon
export typealias Int = int(i64.min to i64.max)
export typealias IntArray = Array with Int

// --- file: zzz-main.maxon
type Holder
	export var nums as IntArray

	export static function create() returns Holder
		var a = IntArray.create()
		a.push(12)
		return Self{nums: a}
	end 'create'

	export function more() returns IntArray
		var a = IntArray.create()
		a.push(14)
		return a
	end 'more'
end 'Holder'

function make() returns IntArray
	var a = IntArray.create()
	a.push(16)
	return a
end 'make'

function main() returns ExitCode
	let h = Holder.create()
	let x = try h.nums.get(0) otherwise return 1
	let y = try h.more().get(0) otherwise return 1
	let z = try make().get(0) otherwise return 1
	return (x + y + z) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 12
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Holder.more {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 14
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 16
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Holder.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 0
    arm64.bl __arr_get
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
