// Test: cross-file-int-call-still-compiles
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

export function crossFileInt() returns Integer
	return 41
end 'crossFileInt'

// --- file: b.maxon
function main() returns ExitCode
	return crossFileInt() + 1
end 'main'
---
ExitCode: 42
---
func @crossFileInt {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 41
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl crossFileInt
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}
