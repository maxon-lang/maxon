// Test: used-in-nested-scope

function main() returns ExitCode
	let x = 42
	if x > 0 'check'
		return x
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.cmp x0, 0
    arm64.cset x1, gt
    arm64.cbnz x1, check
    arm64.b ifcont
  check:
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
