// Test: default-param-named

typealias Integer = int(i64.min to i64.max)

function repeat(value Integer, times Integer = 1) returns Integer
	return value * times
end 'repeat'

function main() returns ExitCode
	return repeat(7, times: 6)
end 'main'
---
ExitCode: 42
---
func @repeat {
  entry:
    arm64.prologue 16
    arm64.mul x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.movImm x1, 6
    arm64.bl repeat
    arm64.epilogue 16
    arm64.ret
}
