// Test: named-args-multiply

typealias Integer = int(i64.min to i64.max)

function multiply(x Integer, y Integer) returns Integer
	return x * y
end 'multiply'

function main() returns ExitCode
	return multiply(6, y: 7)
end 'main'
---
ExitCode: 42
---
func @multiply {
  entry:
    arm64.prologue 16
    arm64.mul x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 6
    arm64.movImm x1, 7
    arm64.bl multiply
    arm64.epilogue 16
    arm64.ret
}
