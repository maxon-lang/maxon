    arm64.leaRdata x20, __str_rec_3  ; "h\xc3\xa9llo w\xc3\xb6rld"
    arm64.movImm x21, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x21, x0
    arm64.b.ge forexit
  each:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl findGraphemeEnd
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __char_at
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __str_rec_4  ; "\xc3\xb6"
    arm64.movRegReg x0, x21
    arm64.bl isTarget
    arm64.cbz x0, ifcont
  match:
    arm64.add x19, x19, 1
  ifcont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
  forstep:
    arm64.movRegReg x21, x22
    arm64.b forhdr
  forexit:
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_5  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x23, x19, x22
    arm64.add x0, x23, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x19, x25, x19
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x19, x22
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
