// Test: character-parameter-and-equality
function isTarget(c Character, target Character) returns bool
	return c == target
end 'isTarget'

function main() returns ExitCode
	var hits = 0
	for c in "héllo wörld" 'each'
		if isTarget(c, target: 'ö') 'match'
			hits = hits + 1
		end 'match'
	end 'each'
	print("{hits}\n")
	return 0
end 'main'
---
ExitCode: 0
---
