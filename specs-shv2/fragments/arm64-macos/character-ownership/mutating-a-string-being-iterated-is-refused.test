// Test: mutating-a-string-being-iterated-is-refused
function main() returns ExitCode
	var s = "ab"
	let t = "c"
	var n = 0
	for c in s 'each'
		n = n + 1 if c == c else n
		s.append(t)
	end 'each'
	s = "done"
	print("{n} {s}\n")
	return 0
end 'main'
---
CompilerError:
error E3019: <fragment>:8:5: cannot pass 's' to function that mutates parameter 'self' (in main)
