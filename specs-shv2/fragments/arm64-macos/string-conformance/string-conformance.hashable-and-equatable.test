// Test: string-conformance.hashable-and-equatable
type Key uses T where T is Hashable and Equatable
	export var value as T
	export static function create(value T) returns Self
		return Self{ value: value }
	end 'create'
	export function digest() returns HashValue
		return self.value.hash()
	end 'digest'
	export function matches(other T) returns bool
		return self.value.equals(other)
	end 'matches'
end 'Key'

typealias StringKey = Key with String

function main() returns ExitCode
	let k = StringKey.create("hi")
	if k.digest() != 5863446 'h'
		return 1
	end 'h'
	if not k.matches("hi") 'e1'
		return 2
	end 'e1'
	if k.matches("no") 'e2'
		return 3
	end 'e2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Key.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Key.digest {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @Key.matches {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x6 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.add x0, x20, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.add x22, x21, 48
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x22, x20
    arm64.storeBaseDispReg.word64 [x21 + 0], x22
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 24], x0
    arm64.movRegReg x0, x21
    arm64.bl Key.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.leaRdata x2, __witness_String.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Key.digest
    arm64.cmp x0, 5863446
    arm64.cset x0, ne
    arm64.cbnz x0, h
    arm64.b ifcont
  h:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Key_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.leaRdata x1, __str_rec_1
    arm64.leaRdata x2, __witness_String.Hashable
    arm64.leaRdata x6, __witness_String.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x3, x6
    arm64.bl Key.matches
    arm64.eor x0, x0, 1
    arm64.cbnz x0, e1
    arm64.b ifcont
  e1:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Key_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.leaRdata x1, __str_rec_3
    arm64.leaRdata x2, __witness_String.Hashable
    arm64.leaRdata x6, __witness_String.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x3, x6
    arm64.bl Key.matches
    arm64.cbnz x0, e2
    arm64.b ifcont
  e2:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Key_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Key_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @String.hash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x2, 5381
    arm64.movImm x6, 0
    arm64.b header
  header:
    arm64.cmp x6, x0
    arm64.cset x7, ge
    arm64.cbnz x7, done
    arm64.b body
  done:
    arm64.movImm x0, 4294967295
    arm64.and x0, x2, x0
    arm64.epilogue 16
    arm64.ret
  body:
    arm64.add x7, x1, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.movImm x8, 33
    arm64.mul x2, x2, x8
    arm64.add x2, x2, x7
    arm64.movImm x7, 1
    arm64.add x6, x6, x7
    arm64.b header
}

func @String.equals {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x6, [x1 + 8]
    arm64.cmp x2, x6
    arm64.cset x6, eq
    arm64.cbnz x6, lenMatch
    arm64.b notEqual
  lenMatch:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.movImm x6, 0
    arm64.b cmphdr
  cmphdr:
    arm64.cmp x6, x2
    arm64.cset x7, ge
    arm64.cbnz x7, allMatch
    arm64.b cmpbody
  allMatch:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  cmpbody:
    arm64.add x7, x0, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.add x8, x1, x6
    arm64.loadRegBaseDisp.byte x8, [x8 + 0]
    arm64.movImm x9, 1
    arm64.add x6, x6, x9
    arm64.cmp x7, x8
    arm64.cset x7, eq
    arm64.cbnz x7, critsplit
    arm64.b notEqual
  critsplit:
    arm64.b cmphdr
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
