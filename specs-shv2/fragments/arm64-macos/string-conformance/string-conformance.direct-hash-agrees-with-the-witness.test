// Test: string-conformance.direct-hash-agrees-with-the-witness
type Box uses T where T is Hashable
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function itemHash() returns HashValue
		return self.item.hash()
	end 'itemHash'
end 'Box'

typealias StringBox = Box with String

function main() returns ExitCode
	let s = "abc"
	let b = StringBox.create("abc")
	if s.hash() != b.itemHash() 'agree'
		return 1
	end 'agree'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.itemHash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.leaRdata x0, __str_rec_1
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 48
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.movRegReg x0, x22
    arm64.bl Box.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl String.hash
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.movRegReg x0, x20
    arm64.bl Box.itemHash
    arm64.cmp x19, x0
    arm64.cset x0, ne
    arm64.cbnz x0, agree
    arm64.b ifcont
  agree:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Box_String
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Box_String
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @String.hash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x2, 5381
    arm64.movImm x6, 0
    arm64.b header
  header:
    arm64.cmp x6, x0
    arm64.cset x7, ge
    arm64.cbnz x7, done
    arm64.b body
  done:
    arm64.movImm x0, 4294967295
    arm64.and x0, x2, x0
    arm64.epilogue 16
    arm64.ret
  body:
    arm64.add x7, x1, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.movImm x8, 33
    arm64.mul x2, x2, x8
    arm64.add x2, x2, x7
    arm64.movImm x7, 1
    arm64.add x6, x6, x7
    arm64.b header
}
