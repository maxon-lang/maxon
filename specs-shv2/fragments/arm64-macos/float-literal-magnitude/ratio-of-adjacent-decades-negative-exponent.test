// Test: ratio-of-adjacent-decades-negative-exponent
function main() returns ExitCode
	let a = 1.0e-30
	let b = 1.0e-31
	return trunc(a / b)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fdiv d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
