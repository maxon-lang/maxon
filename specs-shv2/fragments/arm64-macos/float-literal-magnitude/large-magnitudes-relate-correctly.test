// Test: large-magnitudes-relate-correctly
function main() returns ExitCode
	var r = 0
	if 1.0e300 > 0.0 'positiveBig'
		r = r + 1
	end 'positiveBig'
	if 1.0e-300 > 0.0 'positiveSmall'
		r = r + 2
	end 'positiveSmall'
	if 1.0e150 * 1.0e150 > 1.0e300 / 2.0 'squareIsSameDecade'
		r = r + 4
	end 'squareIsSameDecade'
	if 1.0e300 * 1.0e-300 > 0.5 'reciprocalIsOne'
		r = r + 8
	end 'reciprocalIsOne'
	return r
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x1, gt
    arm64.cbnz x1, positiveBig
    arm64.b critsplit
  positiveBig:
    arm64.add x0, x0, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.fpLoadRdata d0, [rdata + __fconst_2]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x1, gt
    arm64.cbnz x1, positiveSmall
    arm64.b critsplit
  positiveSmall:
    arm64.add x0, x0, 2
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.fpLoadRdata d0, [rdata + __fconst_3]
    arm64.fpLoadRdata d1, [rdata + __fconst_3]
    arm64.fmul d0, d0, d1
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fpLoadRdata d2, [rdata + __fconst_4]
    arm64.fdiv d1, d1, d2
    arm64.fcmp d0, d1
    arm64.cset x1, gt
    arm64.cbnz x1, squareIsSameDecade
    arm64.b critsplit
  squareIsSameDecade:
    arm64.add x0, x0, 4
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fmul d0, d0, d1
    arm64.fpLoadRdata d1, [rdata + __fconst_5]
    arm64.fcmp d0, d1
    arm64.cset x1, gt
    arm64.cbnz x1, reciprocalIsOne
    arm64.b critsplit
  reciprocalIsOne:
    arm64.add x0, x0, 8
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
