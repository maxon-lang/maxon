// Test: underflow-to-zero-is-not-an-error
function main() returns ExitCode
	if 1.0e-400 == 0.0 'roundsToZero'
		return 1
	end 'roundsToZero'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  roundsToZero:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
