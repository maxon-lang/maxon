// Test: ratio-of-adjacent-decades-e20
function main() returns ExitCode
	let a = 1.0e20
	let b = 1.0e19
	return trunc(a / b)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fdiv d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
