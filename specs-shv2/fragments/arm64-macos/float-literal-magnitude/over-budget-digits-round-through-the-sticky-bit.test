// Test: over-budget-digits-round-through-the-sticky-bit
function main() returns ExitCode
	var r = 0
	if 9007199254740993. == 9007199254740992.0 'tieRoundsToEven'
		r = r + 1
	end 'tieRoundsToEven'
	if 9007199254740993. == 9007199254740994.0 'stickyBitRoundsUp'
		r = r + 2
	end 'stickyBitRoundsUp'
	return r
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x1, eq
    arm64.cbnz x1, tieRoundsToEven
    arm64.b critsplit
  tieRoundsToEven:
    arm64.add x0, x0, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.fpLoadRdata d0, [rdata + __fconst_2]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fcmp d0, d1
    arm64.cset x1, eq
    arm64.cbnz x1, stickyBitRoundsUp
    arm64.b critsplit
  stickyBitRoundsUp:
    arm64.add x0, x0, 2
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
