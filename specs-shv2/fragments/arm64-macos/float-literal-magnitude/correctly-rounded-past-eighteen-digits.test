// Test: correctly-rounded-past-eighteen-digits
function main() returns ExitCode
	var r = 0
	if 7.46658662666203984963311900685e13 == 74665866266620.4 'thirtyDigits'
		r = r + 1
	end 'thirtyDigits'
	if 2.3744998132743940991053240e-19 == 2.3744998132743943e-19 'twentyFiveDigits'
		r = r + 2
	end 'twentyFiveDigits'
	if 2.755371525302782724e-4 == 0.0002755371525302783 'nineteenDigits'
		r = r + 4
	end 'nineteenDigits'
	if 3.14159265358979323846 == 3.141592653589793 'piAsWrittenInTheTree'
		r = r + 8
	end 'piAsWrittenInTheTree'
	if 2.71828182845904523536 == 2.718281828459045 'eAsWrittenInTheTree'
		r = r + 16
	end 'eAsWrittenInTheTree'
	return r
end 'main'
---
ExitCode: 31
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b thirtyDigits
  thirtyDigits:
    arm64.movImm x0, 1
    arm64.b ifcont#2
  ifcont#2:
    arm64.b twentyFiveDigits
  twentyFiveDigits:
    arm64.add x0, x0, 2
    arm64.b ifcont#4
  ifcont#4:
    arm64.b nineteenDigits
  nineteenDigits:
    arm64.add x0, x0, 4
    arm64.b ifcont#6
  ifcont#6:
    arm64.b piAsWrittenInTheTree
  piAsWrittenInTheTree:
    arm64.add x0, x0, 8
    arm64.b ifcont#8
  ifcont#8:
    arm64.b eAsWrittenInTheTree
  eAsWrittenInTheTree:
    arm64.add x0, x0, 16
    arm64.b ifcont#10
  ifcont#10:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at correctly-rounded-past-eighteen-digits.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
