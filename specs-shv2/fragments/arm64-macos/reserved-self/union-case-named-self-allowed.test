// Test: union-case-named-self-allowed
typealias Tally = int(0 to 125)

union Node
	leaf(value Tally)
	self
end 'Node'

function pick(n Node) returns Tally
	return match n 'm'
		leaf(v) gives v
		self gives 7
	end 'm'
end 'pick'

function main() returns ExitCode
	return pick(Node.self)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#3
    arm64.b matchnext
  matcharm#3:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#4
    arm64.b matchdead
  matcharm#4:
    arm64.movImm x19, 7
    arm64.b matchcont
  matchcont:
    arm64.b __il_cont
  __il_cont:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
