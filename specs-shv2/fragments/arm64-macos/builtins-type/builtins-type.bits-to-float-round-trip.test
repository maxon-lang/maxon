  entry:
    arm64.prologue 16
    arm64.b __il_body#16
  __il_body#16:
    arm64.movImm x0, 1
    arm64.b __il_cont#15
  __il_cont#15:
    arm64.cmp x0, 1
    arm64.cset x0, ne
    arm64.cbnz x0, subnormalMin
    arm64.b ifcont#2
  subnormalMin:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#18
  __il_body#18:
    arm64.movImm x0, 4503599627370495
    arm64.b __il_cont#17
  __il_cont#17:
    arm64.movImm x1, 4503599627370495
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, subnormalMax
    arm64.b ifcont#4
  subnormalMax:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.b __il_body#20
  __il_body#20:
    arm64.movImm x0, 0
    arm64.b __il_cont#19
  __il_cont#19:
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, positiveZero
    arm64.b ifcont#6
  positiveZero:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.b __il_body#22
  __il_body#22:
    arm64.movImm x0, 4607182418800017408
    arm64.b __il_cont#21
  __il_cont#21:
    arm64.movImm x1, 4607182418800017408
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, one
    arm64.b ifcont#8
  one:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 9223372036854775808
    arm64.b __il_body#24
  __il_body#24:
    arm64.movImm x1, 9223372036854775808
    arm64.b __il_cont#23
  __il_cont#23:
    arm64.cmp x1, x0
    arm64.cset x0, ne
    arm64.cbnz x0, negativeZero
