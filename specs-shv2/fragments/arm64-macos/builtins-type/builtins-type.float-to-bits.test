// Test: builtins-type.float-to-bits
function main() returns ExitCode
	let bits = __Builtins.floatToBits(1.0)
	// IEEE 754: 1.0 = 0x3FF0000000000000 = 4607182418800017408
	if bits == 4607182418800017408 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fmov x0, d0
    arm64.movImm x1, 4607182418800017408
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
