// Test: builtins-type.bits-to-float
function main() returns ExitCode
	let value = __Builtins.bitsToFloat(4607182418800017408)
	// IEEE 754: 0x3FF0000000000000 = 4607182418800017408 is exactly 1.0.
	// A numeric conversion would instead yield ~4.6e18, so this distinguishes
	// a bitcast from a widening int-to-float conversion.
	if value == 1.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4607182418800017408
    arm64.fmov d0, x0
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
