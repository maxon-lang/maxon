// Test: a-trivial-element-refused-insert-is-the-control
typealias Integer = int(i64.min to i64.max)
typealias IntList = List with Integer

function main() returns ExitCode
	var list = IntList.create()
	list.append(10)
	try list.insert(5, value: 20) otherwise 'oob'
		print("rejected\n")
	end 'oob'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_List_Integer
    arm64.bl List.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.leaRdata x2, __layout_List_Integer
    arm64.movRegReg x0, x19
    arm64.bl List.append
    arm64.movImm x1, 5
    arm64.movImm x2, 20
    arm64.leaRdata x3, __layout_List_Integer
    arm64.movRegReg x0, x19
    arm64.bl List.insert
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.leaRdata x0, __str_rec_1  ; "rejected\x0a"
    arm64.bl print
  trycont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_List_Integer
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
