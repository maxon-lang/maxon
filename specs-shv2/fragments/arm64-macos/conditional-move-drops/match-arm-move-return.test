// Test: match-arm-move-return
typealias Integer = int(i64.min to i64.max)

enum Color
	red
	green
	blue
end 'Color'

union Wrap
	empty
	holds(s String)
end 'Wrap'

function build(x Integer) returns String
	return "built value {x} padded out long enough to heap allocate"
end 'build'

function pick(c Color) returns Wrap
	let a = build(1)
	match c 'm'
		red then return Wrap.holds(a)
		green then print("green arm leaves it live padded long")
		blue then print("blue arm leaves it live padded long")
	end 'm'
	return Wrap.empty
end 'pick'

function main() returns ExitCode
	let w = pick(Color.green)
	print("{w}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_6  ; "built value "
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_7  ; " padded out long enough to heap allocate"
    arm64.loadRegBaseDisp.word64 x23, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x24, [x0 + 8]
    arm64.add x0, x21, x19
    arm64.add x25, x0, x24
    arm64.add x0, x25, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
    arm64.add x27, x26, 56
    arm64.movRegReg x0, x27
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x20, x27, x21
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x19, x20, x19
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x24
    arm64.bl __str_copy
    arm64.add x0, x19, x24
    arm64.storeBaseDispReg.word64 [x26 + 0], x27
    arm64.storeBaseDispReg.word64 [x26 + 8], x25
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x26 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x26 + 24], x0
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x26
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.epilogue 96
    arm64.ret
}

func @pick {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl build
    arm64.movRegReg x20, x0
    arm64.cmp x19, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext#5:
    arm64.cmp x19, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.leaRdata x0, __str_rec_8  ; "green arm leaves it live padded long"
    arm64.bl print
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x19, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.leaRdata x0, __str_rec_9  ; "blue arm leaves it live padded long"
    arm64.bl print
    arm64.b matchcont
  matchcont:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.leaRdata x2, __str_rec_10  ; "empty"
    arm64.mul x1, x1, x2
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.leaRdata x2, __str_rec_11  ; "holds"
    arm64.mul x0, x0, x2
    arm64.add x0, x1, x0
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.movRegReg x0, x22
    arm64.bl print
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Wrap
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
