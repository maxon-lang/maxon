// Test: contested-free-function-pair-routes-each-qualifier-to-its-own
// --- file: alpha/a.maxon
typealias Integer = int(0 to 125)

export function pick() returns Integer
	return 3
end 'pick'

// --- file: beta/b.maxon
typealias Integer = int(0 to 125)

export function pick() returns Integer
	return 5
end 'pick'

// --- file: app/main.maxon
function main() returns ExitCode
	return (alpha.pick() * 10 + beta.pick()) as ExitCode
end 'main'
---
ExitCode: 35
---
func @beta.pick {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl alpha.pick
    arm64.movImm x16, 10
    arm64.mul x19, x0, x16
    arm64.bl beta.pick
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @alpha.pick {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
