// Test: a-bare-call-inside-the-type-body-reaches-a-method-an-extension-published
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer

	export static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'

	export function viaBare() returns Integer
		return tripled()
	end 'viaBare'

	export function viaSelf() returns Integer
		return self.tripled()
	end 'viaSelf'
end 'Box'

extension Box
	export function tripled() returns Integer
		return self.v * 3
	end 'tripled'
end 'Box'

function main() returns ExitCode
	let b = Box.of(5)
	return (b.viaBare() + b.viaSelf()) as ExitCode
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.viaBare {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 3
    arm64.mul x0, x0, x16
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @Box.viaSelf {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 3
    arm64.mul x0, x0, x16
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 5
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl Box.viaBare
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl Box.viaSelf
    arm64.add x0, x20, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
