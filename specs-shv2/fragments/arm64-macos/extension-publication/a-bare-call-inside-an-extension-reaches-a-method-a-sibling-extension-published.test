// Test: a-bare-call-inside-an-extension-reaches-a-method-a-sibling-extension-published
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer

	export static function of(v Integer) returns Self
		return Self{v: v}
	end 'of'
end 'Box'

extension Box
	export function tripled() returns Integer
		return self.v * 3
	end 'tripled'
end 'Box'

extension Box
	export function reported() returns Integer
		return tripled() + 1
	end 'reported'
end 'Box'

function main() returns ExitCode
	let b = Box.of(5)
	return b.reported() as ExitCode
end 'main'
---
ExitCode: 16
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.reported {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 3
    arm64.mul x0, x0, x16
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 5
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movRegReg x0, x1
    arm64.bl Box.reported
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
