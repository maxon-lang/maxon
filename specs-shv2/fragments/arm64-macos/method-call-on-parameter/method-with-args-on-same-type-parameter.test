// Test: method-with-args-on-same-type-parameter

typealias Integer = int(i64.min to i64.max)

type Adder
	var value as Integer
	
	function addTo(n Integer) returns Integer
		return value + n
	end 'addTo'
	
	function delegateAdd(other Adder, n Integer) returns Integer
		return other.addTo(n)
	end 'delegateAdd'

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Adder'

function main() returns ExitCode
	let a = Adder.create(100)
	let b = Adder.create(50)
	return a.delegateAdd(b, n: 7)
end 'main'
---
ExitCode: 57
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Adder.delegateAdd {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, x2
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 100
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 50
    arm64.leaRegSlot x2, slot1
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.movImm x3, 7
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x3
    arm64.bl Adder.delegateAdd
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at method-with-args-on-same-type-parameter.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
