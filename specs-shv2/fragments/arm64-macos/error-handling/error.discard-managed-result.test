// Test: error.discard-managed-result

typealias Integer = int(i64.min to i64.max)

// A managed String try-result whose value is DISCARDED (bare `try` propagate). On the ok edge the box
// must drop on the ok path (statement drain); on the error edge the result register is NULL and the
// propagate must not touch it.
enum MyError implements Error
	failed
end 'MyError'

function makeStr(flag bool) returns String throws MyError
	if flag 'c'
		throw MyError.failed
	end 'c'
	return "hi"
end 'makeStr'

function runIt(flag bool) returns Integer throws MyError
	try makeStr(flag)
	return 5
end 'runIt'

function main() returns ExitCode
	let good = try runIt(false) otherwise return 1
	let bad = try runIt(true) otherwise return good
	return bad
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeStr {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_1  ; "hi"
    arm64.bl __str_retain
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @runIt {
  entry:
    arm64.prologue 16
    arm64.bl makeStr
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.bl __str_decref
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl runIt
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movImm x0, 1
    arm64.bl runIt
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#6
    arm64.b __rc_chk#7
  __rc_chk#7:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#6
    arm64.b __rc_ok#5
  __rc_panic#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at error.discard-managed-result.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#5:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok#3:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#9
    arm64.b __rc_chk#10
  __rc_chk#10:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#9
    arm64.b __rc_ok#8
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_3  ; "panic at error.discard-managed-result.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#8:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
