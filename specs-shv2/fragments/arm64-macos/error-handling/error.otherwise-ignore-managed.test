// Test: error.otherwise-ignore-managed

typealias Integer = int(i64.min to i64.max)

// A managed String try-result discarded via `otherwise ignore` (the fell-through path). On the ok edge
// the box drops in the ok block before the merge; on the error edge nothing is owned. No leak, no NULL
// decref in the shared continuation.
enum MyError implements Error
	failed
end 'MyError'

function makeStr(flag bool) returns String throws MyError
	if flag 'c'
		throw MyError.failed
	end 'c'
	return "hi"
end 'makeStr'

function run(flag bool) returns Integer
	try makeStr(flag) otherwise ignore
	return 9
end 'run'

function main() returns ExitCode
	let a = run(false)
	let b = run(true)
	if a == 9 'x'
		if b == 9 'y'
			return 0
		end 'y'
	end 'x'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeStr {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_1  ; "hi"
    arm64.bl __str_retain
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @run {
  entry:
    arm64.prologue 16
    arm64.bl makeStr
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.b trycont
  tryok:
    arm64.bl __str_decref
    arm64.b trycont
  trycont:
    arm64.movImm x0, 9
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl run
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl run
    arm64.cmp x19, 9
    arm64.cset x1, eq
    arm64.cbnz x1, x
    arm64.b ifcont#4
  x:
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, y
    arm64.b ifcont#3
  y:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont#3:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
