// Test: error.throw-payload-expr-temp-decref

typealias Integer = int(i64.min to i64.max)

// A throw whose PAYLOAD expression builds an owned temporary it does NOT hand to the box: the
// interpolation `"val={x}"` is borrowed by `len` (which returns only its byte count), so the buffer
// belongs to this statement and must drop on the throw edge — exactly as a `return len("val={x}")`
// drops it. The throw and return exits share ONE hand-off cleanup for that reason; a throw that dropped
// its bindings but not this leftover temporary leaked the buffer (exit 101). A clean throw/catch of
// `"val=7".byteLength()` is 5.
union E implements Error
	problem(code Integer)
end 'E'

function len(s String) returns Integer
	return s.byteLength()
end 'len'

function mk(x Integer) returns Integer throws E
	throw E.problem(len("val={x}"))
end 'mk'

function main() returns ExitCode
	var n = 0 as ExitCode
	try mk(7) otherwise (e) 'h'
		match e 'm'
			problem(code) then n = code as ExitCode
		end 'm'
	end 'h'
	return n
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @len {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @mk {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1  ; "val="
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.add x23, x21, x19
    arm64.add x0, x23, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x20, x25, x21
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x20, x19
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
    arm64.storeBaseDispReg.word64 [x24 + 8], x23
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x24 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x24 + 24], x0
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x24
    arm64.bl len
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movRegReg x0, x24
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.epilogue 80
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 7
    arm64.bl mk
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x9 + 8]
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at error.throw-payload-expr-temp-decref.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b trycont
  matchdead:
  tryok:
    arm64.movRegReg x0, x19
    arm64.b trycont
  trycont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
