// Test: throw-matching-the-declared-clause-is-untouched
typealias Code = int(0 to u32.max)

enum ErrA implements Error
	aZero
	aOne
end 'ErrA'

enum ErrB implements Error
	bZero
	bOne
end 'ErrB'

function f(x Code) returns Code throws ErrB
	if x < 10 'small'
		throw ErrB.bOne
	end 'small'
	return x
end 'f'

function main() returns ExitCode
	return try f(3) otherwise (e) 'caught'
		match e 'which'
			bZero then return 1
			bOne then return 2
		end 'which'
	end 'caught'
end 'main'
---
ExitCode: 2
---
func @f {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at throw-matching-the-declared-clause-is-untouched.test:14: Range check failed: value outside typealias 'Code'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 10
    arm64.b.ge ifcont
  small:
    arm64.movImm x9, 2
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.bl f
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#3:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#4:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchdead:
  tryok:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at throw-matching-the-declared-clause-is-untouched.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
