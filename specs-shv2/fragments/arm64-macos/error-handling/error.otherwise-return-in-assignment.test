// Test: error.otherwise-return-in-assignment

typealias Integer = int(i64.min to i64.max)

// Single-statement otherwise: success path still yields a value
enum MyError implements Error
	failed
end 'MyError'

function maybeFail(flag bool) returns Integer throws MyError
	if flag 'check'
		throw MyError.failed
	end 'check'
	return 42
end 'maybeFail'

function runIt(flag bool) returns Integer
	let value = try maybeFail(flag) otherwise return -1
	return value
end 'runIt'

function main() returns ExitCode
	let good = runIt(false)
	if good == 42 'checkGood'
		let bad = runIt(true)
		if bad == -1 'checkBad'
			return 7
		end 'checkBad'
	end 'checkGood'
	return 0
end 'main'
---
ExitCode: 7
---
func @maybeFail {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @runIt {
  entry:
    arm64.prologue 16
    arm64.bl maybeFail
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 18446744073709551615
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl runIt
    arm64.cmp x0, 42
    arm64.b.ne ifcont
  checkGood:
    arm64.movImm x0, 1
    arm64.bl runIt
    arm64.cmp x0, -1
    arm64.b.ne ifcont
  checkBad:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
