// Test: straight-line-multiple-consume
typealias Integer = int(i64.min to i64.max)

interface Payload
	function tag() returns Integer
end 'Payload'

type Desc implements Payload
	export var v as Integer

	export static function create(x Integer) returns Desc
		return Self{v: x}
	end 'create'

	export function tag() returns Integer
		return self.v
	end 'tag'
end 'Desc'

type Holder
	export var p as Payload

	export static function create(p Payload) returns Holder
		return Holder{p: p}
	end 'create'

	export function run() returns Integer
		return self.p.tag()
	end 'run'
end 'Holder'

function twice(item Integer, p Payload) returns Integer
	var h1 = Holder.create(p)
	let a = h1.run()
	var h2 = Holder.create(p)
	let b = h2.run()
	return a + b + item
end 'twice'

function driver() returns Integer
	let p = Desc.create(9)
	return twice(4, p: p)
end 'driver'

function main() returns ExitCode
	return driver()
end 'main'
---
ExitCode: 22
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Desc.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Desc.tag {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Holder.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __retain_existential
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __drop_existential
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Holder.run {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @twice {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x20
    arm64.bl __retain_existential
    arm64.movRegReg x1, x21
    arm64.bl Holder.create
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x22
    arm64.bl Holder.run
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x20
    arm64.bl __retain_existential
    arm64.movRegReg x1, x21
    arm64.bl Holder.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl Holder.run
    arm64.add x0, x23, x0
    arm64.add x19, x0, x19
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @driver {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 9
    arm64.bl Desc.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 4
    arm64.leaRdata x2, __witness_Desc.Payload
    arm64.movRegReg x1, x19
    arm64.bl twice
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl driver
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at straight-line-multiple-consume.test:46: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
