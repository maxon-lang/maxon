// Test: find-last-not-found
function main() returns ExitCode
	let s = "hello world"
	if try s.findLast("xyz") 'found'
		print("FOUND\n")
	end 'found' else 'not_found'
		print("NOT_FOUND\n")
	end 'not_found'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.leaRdata x1, __str_rec_3
    arm64.bl __strix_last
    arm64.cmp x9, 0
    arm64.cset x1, eq
    arm64.cbnz x1, found
    arm64.b ifelse
  found:
    arm64.bl __mm_decref
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __print_string
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_7
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
