// Test: find-last-not-found
function main() returns ExitCode
	let s = "hello world"
	if let idx = try s.findLast("xyz") 'found'
		print("FOUND\n")
		return idx.charIndex() as ExitCode
	end 'found' else 'not_found'
		print("NOT_FOUND\n")
	end 'not_found'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_4  ; "hello world"
    arm64.leaRdata x1, __str_rec_5  ; "xyz"
    arm64.bl String.findLast
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne ifelse
  found:
    arm64.leaRdata x0, __str_rec_6  ; "FOUND\x0a"
    arm64.bl print
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_23  ; "panic at find-last-not-found.test:6: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifelse:
    arm64.leaRdata x0, __str_rec_7  ; "NOT_FOUND\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
