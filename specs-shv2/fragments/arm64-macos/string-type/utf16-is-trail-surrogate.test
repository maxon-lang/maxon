// Test: utf16-is-trail-surrogate
function main() returns ExitCode
	// 0xDE00 = 56832 (low surrogate for 😀)
	if utf16IsTrailSurrogate(56832) 'c4'
		print("1\n")
	end 'c4'
	if utf16IsTrailSurrogate(55357) 'c5'
		print("0\n")
	end 'c5'
	if utf16IsTrailSurrogate(65) 'c6'
		print("0\n")
	end 'c6'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 56832
    arm64.bl utf16IsTrailSurrogate
    arm64.cbnz x0, c4
    arm64.b ifcont
  c4:
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 55357
    arm64.bl utf16IsTrailSurrogate
    arm64.cbnz x0, c5
    arm64.b ifcont
  c5:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 65
    arm64.bl utf16IsTrailSurrogate
    arm64.cbnz x0, c6
    arm64.b ifcont
  c6:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @utf16IsTrailSurrogate {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 65535
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 56320
    arm64.cset x1, ge
    arm64.movImm x2, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x0, 57343
    arm64.cset x0, le
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}
