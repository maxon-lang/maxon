// Test: utf16-valid-surrogate-pair
function main() returns ExitCode
	if utf16IsValidSurrogatePair(55357, low: 56832) 'c14'
		print("1\n")  // valid pair
	end 'c14'
	if utf16IsValidSurrogatePair(56832, low: 55357) 'c15'
		print("0\n")  // reversed
	end 'c15'
	if utf16IsValidSurrogatePair(65, low: 66) 'c16'
		print("0\n")        // not surrogates
	end 'c16'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 55357
    arm64.movImm x1, 56832
    arm64.bl utf16IsValidSurrogatePair
    arm64.cbnz x0, c14
    arm64.b ifcont
  c14:
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 56832
    arm64.movImm x1, 55357
    arm64.bl utf16IsValidSurrogatePair
    arm64.cbnz x0, c15
    arm64.b ifcont
  c15:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 65
    arm64.movImm x1, 66
    arm64.bl utf16IsValidSurrogatePair
    arm64.cbnz x0, c16
    arm64.b ifcont
  c16:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @utf16IsLeadSurrogate {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 55296
    arm64.cset x1, ge
    arm64.movImm x2, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x0, 56319
    arm64.cset x0, le
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}

func @utf16IsTrailSurrogate {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 56320
    arm64.cset x1, ge
    arm64.movImm x2, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x0, 57343
    arm64.cset x0, le
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}

func @utf16IsValidSurrogatePair {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.bl utf16IsLeadSurrogate
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movRegReg x0, x19
    arm64.bl utf16IsTrailSurrogate
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
