// Test: utf16-is-lead-surrogate
function main() returns ExitCode
	// 0xD83D = 55357 (high surrogate for 😀)
	if utf16IsLeadSurrogate(55357) 'c1'
		print("1\n")
	end 'c1'
	if utf16IsLeadSurrogate(56832) 'c2'
		print("0\n")
	end 'c2'
	if utf16IsLeadSurrogate(65) 'c3'
		print("0\n")
	end 'c3'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#8
  __il_body#8:
    arm64.b __rc_chk#12
  __rc_chk#12:
    arm64.b __rc_ok#11
  __rc_ok#11:
    arm64.b andrhs#9
  andrhs#9:
    arm64.movImm x0, 1
    arm64.b scmerge#10
  scmerge#10:
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cbnz x0, c1
    arm64.b ifcont#2
  c1:
    arm64.leaRdata x0, __str_rec_2  ; "1\x0a"
    arm64.bl print
    arm64.b ifcont#2
  ifcont#2:
    arm64.b __il_body#15
  __il_body#15:
    arm64.b __rc_chk#19
  __rc_chk#19:
    arm64.b __rc_ok#18
  __rc_ok#18:
    arm64.b andrhs#16
  andrhs#16:
    arm64.movImm x0, 0
    arm64.b scmerge#17
  scmerge#17:
    arm64.b __il_cont#14
  __il_cont#14:
    arm64.cbnz x0, c2
    arm64.b ifcont#4
  c2:
    arm64.leaRdata x0, __str_rec_3  ; "0\x0a"
    arm64.bl print
    arm64.b ifcont#4
  ifcont#4:
    arm64.b __il_body#22
  __il_body#22:
    arm64.b __rc_chk#26
  __rc_chk#26:
    arm64.b __rc_ok#25
  __rc_ok#25:
    arm64.movImm x0, 0
    arm64.b scmerge#24
  scmerge#24:
    arm64.b __il_cont#21
  __il_cont#21:
    arm64.cbnz x0, c3
    arm64.b ifcont#6
  c3:
    arm64.leaRdata x0, __str_rec_3  ; "0\x0a"
    arm64.bl print
    arm64.b ifcont#6
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
