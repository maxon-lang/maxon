// Test: isEmpty-method
function main() returns ExitCode
	let empty = ""
	let nonempty = "hello"
	if empty.isEmpty() 'check1'
		print("1\n")
	end 'check1'
	if nonempty.isEmpty() 'check2'
		print("0\n")
	end 'check2' else 'not_empty'
		print("2\n")
	end 'not_empty'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_5  ; ""
    arm64.leaRdata x19, __str_rec_6  ; "hello"
    arm64.bl String.isEmpty
    arm64.cbnz x0, check1
    arm64.b ifcont#2
  check1:
    arm64.leaRdata x0, __str_rec_7  ; "1\x0a"
    arm64.bl print
    arm64.b ifcont#2
  ifcont#2:
    arm64.movRegReg x0, x19
    arm64.bl String.isEmpty
    arm64.cbnz x0, check2
    arm64.b ifelse
  check2:
    arm64.leaRdata x0, __str_rec_8  ; "0\x0a"
    arm64.bl print
    arm64.b ifcont#5
  ifelse:
    arm64.leaRdata x0, __str_rec_9  ; "2\x0a"
    arm64.bl print
    arm64.b ifcont#5
  ifcont#5:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
