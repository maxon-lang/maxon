// Test: isEmpty-method
function main() returns ExitCode
	let empty = ""
	let nonempty = "hello"
	if empty.isEmpty() 'check1'
		print("1\n")
	end 'check1'
	if nonempty.isEmpty() 'check2'
		print("0\n")
	end 'check2' else 'not_empty'
		print("2\n")
	end 'not_empty'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1
    arm64.leaRdata x19, __str_rec_3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, check1
    arm64.b ifcont
  check1:
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, check2
    arm64.b ifelse
  check2:
    arm64.leaRdata x0, __str_rec_7
    arm64.bl __print_string
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_9
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
