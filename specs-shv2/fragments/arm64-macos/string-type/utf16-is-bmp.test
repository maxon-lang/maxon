// Test: utf16-is-bmp
function main() returns ExitCode
	if utf16IsBmp(65) 'c10'
		print("1\n")       // ASCII
	end 'c10'
	if utf16IsBmp(945) 'c11'
		print("2\n")      // Greek α
	end 'c11'
	if utf16IsBmp(65535) 'c12'
		print("3\n")    // U+FFFF (last BMP)
	end 'c12'
	if utf16IsBmp(128512) 'c13'
		print("0\n")   // 😀 (not BMP)
	end 'c13'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  andrhs#11:
    arm64.movImm x0, 1
  __il_cont#9:
    arm64.cbz x0, andrhs#18
  c10:
    arm64.leaRdata x0, __str_rec_4  ; "1\x0a"
    arm64.bl print
  andrhs#18:
    arm64.movImm x0, 1
  __il_cont#16:
    arm64.cbz x0, andrhs#25
  c11:
    arm64.leaRdata x0, __str_rec_5  ; "2\x0a"
    arm64.bl print
  andrhs#25:
    arm64.movImm x0, 1
  __il_cont#23:
    arm64.cbz x0, andrhs#32
  c12:
    arm64.leaRdata x0, __str_rec_6  ; "3\x0a"
    arm64.bl print
  andrhs#32:
    arm64.movImm x0, 0
  __il_cont#30:
    arm64.cbz x0, ifcont
  c13:
    arm64.leaRdata x0, __str_rec_7  ; "0\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
