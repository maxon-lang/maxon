// Test: utf16-is-bmp
function main() returns ExitCode
	if utf16IsBmp(65) 'c10'
		print("1\n")       // ASCII
	end 'c10'
	if utf16IsBmp(945) 'c11'
		print("2\n")      // Greek α
	end 'c11'
	if utf16IsBmp(65535) 'c12'
		print("3\n")    // U+FFFF (last BMP)
	end 'c12'
	if utf16IsBmp(128512) 'c13'
		print("0\n")   // 😀 (not BMP)
	end 'c13'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 65
    arm64.bl utf16IsBmp
    arm64.cbnz x0, c10
    arm64.b ifcont
  c10:
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 945
    arm64.bl utf16IsBmp
    arm64.cbnz x0, c11
    arm64.b ifcont
  c11:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 65535
    arm64.bl utf16IsBmp
    arm64.cbnz x0, c12
    arm64.b ifcont
  c12:
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 128512
    arm64.bl utf16IsBmp
    arm64.cbnz x0, c13
    arm64.b ifcont
  c13:
    arm64.leaRdata x0, __str_rec_7
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @utf16IsBmp {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1114111
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 0
    arm64.cset x1, ge
    arm64.movImm x2, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x0, 65536
    arm64.cset x0, lt
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}
