// Test: long-string
function main() returns ExitCode
	let s = "this string is longer than fifteen bytes"
	if s == "this string is longer than fifteen bytes" 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "this string is longer than fifteen bytes"
    arm64.leaRdata x1, __str_rec_1  ; "this string is longer than fifteen bytes"
    arm64.bl __str_eq
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
