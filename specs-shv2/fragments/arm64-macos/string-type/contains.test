// Test: contains
function main() returns ExitCode
	let s = "hello world"
	if s.contains("lo wo") 'c1'
		print("1\n")
	end 'c1'
	if s.contains("xyz") 'c2'
		print("0\n")
	end 'c2'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x19
    arm64.bl __str_contains
    arm64.cbnz x0, c1
    arm64.b ifcont
  c1:
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __str_rec_7
    arm64.movRegReg x0, x19
    arm64.bl __str_contains
    arm64.cbnz x0, c2
    arm64.b ifcont
  c2:
    arm64.leaRdata x0, __str_rec_9
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
