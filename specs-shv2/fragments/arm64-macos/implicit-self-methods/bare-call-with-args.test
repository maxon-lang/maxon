// Test: bare-call-with-args

typealias Integer = int(i64.min to i64.max)

type Adder
	export var base as Integer

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'

	function add(x Integer) returns Integer
		return base + x
	end 'add'

	function addTwice(x Integer) returns Integer
		return add(x) + add(x)
	end 'addTwice'
end 'Adder'

function main() returns ExitCode
	let a = Adder.create(1)
	return a.addTwice(3)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Adder.addTwice {
  entry:
    arm64.prologue 16
    arm64.b __il_body#3
  __il_body#3:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, x1
    arm64.b __il_cont#2
  __il_cont#2:
    arm64.b __il_body#4
  __il_body#4:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, x1
    arm64.b __il_cont#1
  __il_cont#1:
    arm64.add x0, x2, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 1
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x2, 3
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl Adder.addTwice
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at bare-call-with-args.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
