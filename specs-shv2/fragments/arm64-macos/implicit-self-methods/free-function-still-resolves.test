// Test: free-function-still-resolves

typealias Integer = int(i64.min to i64.max)

function helper() returns Integer
	return 5
end 'helper'

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function get() returns Integer
		return helper() + 1
	end 'get'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.get()
end 'main'
---
ExitCode: 6
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @helper {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.get {
  entry:
    arm64.prologue 16
    arm64.bl helper
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Box.get
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
