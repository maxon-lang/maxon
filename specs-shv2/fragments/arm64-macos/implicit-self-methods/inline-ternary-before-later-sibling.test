// Test: inline-ternary-before-later-sibling

typealias Integer = int(i64.min to i64.max)

type Box
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function pick() returns Integer
		let r = 1 if n > 0 else 2
		return r + later()
	end 'pick'

	function later() returns Integer
		return 9
	end 'later'
end 'Box'

function main() returns ExitCode
	let b = Box.create()
	return b.pick()
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.pick {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x0, gt
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 1
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchcont:
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, 9
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.bl Box.pick
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at inline-ternary-before-later-sibling.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
