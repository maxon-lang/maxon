// Test: stdlib-map-on-set
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let s = Set from [10, 20, 30]
	let mapped = s.map(function(x Integer) gives x + 1)

	var sum = 0
	for n in mapped 'loop'
		sum = sum + n
	end 'loop'

	// 11 + 21 + 31 = 63 (order may vary but sum is same)
	return sum
end 'main'
---
ExitCode: 63
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 10
    arm64.leaRdata x0, __layout_Set_int
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Set.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_Set_int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl Set.insert
    arm64.movImm x1, 20
    arm64.leaRdata x2, __layout_Set_int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl Set.insert
    arm64.movImm x1, 30
    arm64.leaRdata x2, __layout_Set_int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl Set.insert
    arm64.leaFuncAddr x1, main$closure_0
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Set_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl Set.map
    arm64.movImm x19, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
  forhdr:
    arm64.cmp x1, x2
    arm64.b.ge forexit
  loop:
    arm64.loadRegBaseIndexScale.word64 x4, [x3 + x1*8 + 0]
  __im_cont:
    arm64.add x19, x19, x4
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Set_int
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_17  ; "panic at stdlib-map-on-set.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}
