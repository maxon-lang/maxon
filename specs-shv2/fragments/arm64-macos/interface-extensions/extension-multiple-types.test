// Test: extension-multiple-types

typealias Integer = int(i64.min to i64.max)

interface Valued
	function val() returns Integer
end 'Valued'

extension Valued
	function valPlusTen() returns Integer
		return self.val() + 10
	end 'valPlusTen'
end 'Valued'

type TypeA implements Valued
	let a as Integer
	function val() returns Integer
		return a
	end 'val'

	static function create(a Integer) returns Self
		return Self{a: a}
	end 'create'
end 'TypeA'

type TypeB implements Valued
	var b as Integer
	function val() returns Integer
		return b * 2
	end 'val'

	static function create(b Integer) returns Self
		return Self{b: b}
	end 'create'
end 'TypeB'

function main() returns ExitCode
	let ta = TypeA.create(5)
	let tb = TypeB.create(10)
	return ta.valPlusTen() + tb.valPlusTen()
end 'main'
---
ExitCode: 45
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @TypeA.valPlusTen {
  entry:
    arm64.prologue 16
    arm64.bl TypeA.val
    arm64.add x0, x0, 10
    arm64.epilogue 16
    arm64.ret
}

func @TypeB.valPlusTen {
  entry:
    arm64.prologue 16
    arm64.bl TypeB.val
    arm64.add x0, x0, 10
    arm64.epilogue 16
    arm64.ret
}

func @TypeA.val {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @TypeA.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @TypeB.val {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @TypeB.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl TypeA.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 10
    arm64.bl TypeB.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl TypeA.valPlusTen
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl TypeB.valPlusTen
    arm64.add x21, x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x21, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
