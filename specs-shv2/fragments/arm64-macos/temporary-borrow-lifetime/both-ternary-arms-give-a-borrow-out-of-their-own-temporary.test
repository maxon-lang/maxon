// Test: both-ternary-arms-give-a-borrow-out-of-their-own-temporary
typealias Wide = int(i64.min to i64.max)

type Holder
	export var name as String

	static function create(name String) returns Self
		return Self{name: name}
	end 'create'
end 'Holder'

function makeA() returns Holder
	return Holder.create("aaaaa")
end 'makeA'

function makeB() returns Holder
	return Holder.create("bb")
end 'makeB'

function pickLength(t bool) returns Wide
	let s = makeA().name if t else makeB().name
	return s.byteLength()
end 'pickLength'

function main() returns ExitCode
	return pickLength(true) * 10 + pickLength(false)
end 'main'
---
ExitCode: 52
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

