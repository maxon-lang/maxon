// Test: two-borrows-out-of-two-temporaries-in-one-statement
typealias Wide = int(i64.min to i64.max)
typealias Bytes = Array with ByteArray

function make(n Wide) returns Bytes
	var outer = Bytes.create()
	var inner = ByteArray.create()
	for i in 0 upto n 'fill'
		inner.push(1)
	end 'fill'
	outer.push(inner)
	return outer
end 'make'

function main() returns ExitCode
	let a = try make(2).get(0) otherwise ByteArray.create()
	let b = try make(3).get(0) otherwise ByteArray.create()
	return a.count() + b.count()
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @make {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x22, x19
    arm64.cset x0, lt
    arm64.cbnz x0, fill
    arm64.b forexit
  fill:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.b forstep
  forstep:
    arm64.add x22, x22, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 2
    arm64.bl make
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.b trycont
  trycont:
    arm64.movImm x0, 3
    arm64.bl make
    arm64.movRegReg x21, x0
    arm64.movImm x1, 0
    arm64.movRegReg x0, x21
    arm64.bl __managed_get
    arm64.movRegReg x22, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x22, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x20
    arm64.bl __managed_count
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.bl __managed_count
    arm64.add x23, x23, x0
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x23, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x23, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x23
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
