// Test: slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias Bufs = Array with ByteArray
typealias Len = int(0 to 65536)

let FirstLen = 32700
let LenStep = 4
let SweepCount = 26

function build(n Len) returns ByteArray
	var b = ByteArray.create()
	b.reserve(n)
	for i in 0 upto n 'fill'
		b.push(((i + n) mod 251) as Byte)
	end 'fill'
	return b
end 'build'

function sweep() returns Integer
	var bufs = Bufs.create()
	for k in 0 upto SweepCount 'alloc'
		bufs.push(build((FirstLen + k * LenStep) as Len))
	end 'alloc'

	var bad = 0
	for k in 0 upto SweepCount 'check'
		let n = FirstLen + k * LenStep
		let b = try bufs.get(k) otherwise return 1
		if b.count() != n 'length'
			bad = bad + 1
		end 'length'
		for i in 0 upto n 'bytes'
			let got = try b.get(i) otherwise return 1
			if got != ((i + n) mod 251) 'value'
				bad = bad + 1
			end 'value'
		end 'bytes'
	end 'check'
	return bad
end 'sweep'

function main() returns ExitCode
	if sweep() != 0 'firstRound'
		return 3
	end 'firstRound'

	// The first sweep's buffers are all dead by now, so this one re-asks for the same sizes with both
	// free routes already run — a span slot recycled, a mapping unmapped and re-mapped.
	if sweep() != 0 'secondRound'
		return 4
	end 'secondRound'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#6
  __rc_chk#7:
    arm64.cmp x19, 65536
    arm64.b.le __rc_ok#5
  __rc_panic#6:
    arm64.leaRdata x0, __str_blob_1  ; "panic at slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands.test:11: Range check failed: value outside typealias 'Len'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#5:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl Array.reserve
    arm64.movImm x21, 0
  forhdr:
    arm64.cmp x21, x19
    arm64.b.ge forexit
  fill:
    arm64.add x0, x21, x19
    arm64.movImm x1, 2351776136887273513
    arm64.smulh x1, x1, x0
    arm64.asr x1, x1, 5
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x16, 251
    arm64.mul x1, x1, x16
    arm64.sub x1, x0, x1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#9
  __rc_chk#10:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok#8
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_2  ; "panic at slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands.test:15: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#8:
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

