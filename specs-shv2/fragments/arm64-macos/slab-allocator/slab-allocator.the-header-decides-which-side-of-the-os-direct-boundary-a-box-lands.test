  __rc_panic#25:
    arm64.leaRdata x0, __str_blob_4  ; "panic at slab-allocator.the-header-decides-which-side-of-the-os-direct-boundary-a-box-lands.test:34: Range check failed: value outside typealias 'ElementIndex'\x0a"
