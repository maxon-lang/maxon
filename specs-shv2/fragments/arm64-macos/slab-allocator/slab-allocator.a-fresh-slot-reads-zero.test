// Test: slab-allocator.a-fresh-slot-reads-zero
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function dirty()
	let mm = try __ManagedMemory.create(4096, elementSize: 1) otherwise return
	try mm.setLength(4096) otherwise return
	var arr = ByteArray.init(mm)
	for i in 0 upto 4096 'fill'
		try arr.set(i, value: 255) otherwise return
	end 'fill'
end 'dirty'

function countNonZero() returns Integer
	let mm = try __ManagedMemory.create(4096, elementSize: 1) otherwise return 1
	try mm.setLength(4096) otherwise return 2
	let arr = ByteArray.init(mm)
	var seen = 0
	for i in 0 upto 4096 'scan'
		let got = try arr.get(i) otherwise return 3
		if got != 0 'nonZero'
			seen = seen + 1
		end 'nonZero'
	end 'scan'
	return seen
end 'countNonZero'

function main() returns ExitCode
	for _ in 0 upto 8 'rounds'
		dirty()
	end 'rounds'

	if countNonZero() != 0 'dirtySlot'
		return 3
	end 'dirtySlot'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @dirty {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4096
    arm64.movImm x1, 1
    arm64.bl __managed_mem_create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movImm x1, 4096
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
  forhdr:
    arm64.cmp x21, 4096
    arm64.b.ge forexit
  fill:
    arm64.movImm x2, 255
    arm64.loadRegBaseDisp.word64 x0, [x20 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 40]
    arm64.cmp x0, 0
    arm64.b.ne __im_slow
  __im_owned#16:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow
  __im_bounds#17:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x21, x0
    arm64.b.hs __im_slow
  __im_buffer#18:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  __im_viewed#19:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.b.ne __im_slow
  __im_store#20:
    arm64.storeBaseIndexScaleReg.word64 [x0 + x21*8 + 0], x2
    arm64.movImm x0, 0
    arm64.b __im_cont
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 40]
    arm64.cmp x0, 0
    arm64.b.ne __im_slow
  __im_owned#21:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow
  __im_bounds#22:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x21, x0
    arm64.b.hs __im_slow
  __im_buffer#23:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  __im_viewed#24:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.b.ne __im_slow
  __im_store#25:
    arm64.add x0, x0, x21
    arm64.storeBaseDispReg.byte [x0 + 0], x2
    arm64.movImm x0, 0
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __managed_set
    arm64.movRegReg x0, x9
  __im_cont:
    arm64.cmp x0, 0
    arm64.b.eq forstep
  tryerr#10:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @countNonZero {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4096
    arm64.movImm x1, 1
    arm64.bl __managed_mem_create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movImm x1, 4096
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.movImm x22, 0
  forhdr:
    arm64.cmp x22, 4096
    arm64.b.ge forexit
  scan:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x22, x0
    arm64.b.hs __im_slow
  __im_load#19:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x22*8 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x22, x0
    arm64.b.hs __im_slow
  __im_load#20:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.add x0, x0, x22
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
  __im_loaded:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x20 + 40]
    arm64.cmp x2, 0
    arm64.b.eq __im_cont
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne __im_cont
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.bl __managed_get
    arm64.movRegReg x1, x9
  __im_cont:
    arm64.cmp x1, 0
    arm64.b.eq tryok#9
  tryerr#10:
    arm64.movImm x21, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#9:
    arm64.cmp x0, 0
    arm64.b.eq critsplit
  nonZero:
    arm64.add x0, x21, 1
    arm64.b forstep
  critsplit:
    arm64.movRegReg x0, x21
  forstep:
    arm64.add x22, x22, 1
    arm64.movRegReg x21, x0
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  forhdr:
    arm64.cmp x19, 8
    arm64.b.ge forexit
  rounds:
    arm64.bl dirty
  forstep:
    arm64.add x19, x19, 1
    arm64.b forhdr
  forexit:
    arm64.bl countNonZero
    arm64.cmp x0, 0
    arm64.b.eq ifcont
  dirtySlot:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
