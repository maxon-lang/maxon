// Test: sixty-four-adoptions-of-one-buffer
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let mm = try __ManagedMemory.create(4, elementSize: 1) otherwise return 1
	try mm.setLength(3) otherwise return 2
	var i = 0
	var total = 0
	while i < 64 'spin'
		let a = ByteArray.init(mm)
		total = total + a.count()
		i = i + 1
	end 'spin'
	if total != 192 'badTotal'
		return 3
	end 'badTotal'
	return mm.length() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4
    arm64.movImm x1, 1
    arm64.bl __arr_mem_create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __arr_set_length
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 64
    arm64.cset x0, lt
    arm64.cbnz x0, spin
    arm64.b whileexit
  spin:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x22
    arm64.bl __arr_count
    arm64.add x21, x21, x0
    arm64.add x20, x20, 1
    arm64.movRegReg x0, x22
    arm64.bl __arr_decref
    arm64.b whilehdr
  whileexit:
    arm64.cmp x21, 192
    arm64.cset x0, ne
    arm64.cbnz x0, badTotal
    arm64.b ifcont
  badTotal:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
