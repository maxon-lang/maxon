// Test: slab-scavenger.an-os-direct-mapping-is-not-a-span
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var big = ByteArray.create()
	big.reserve(300000)
	for i in 0 upto 512 'fill'
		big.push((i mod 251) as Byte)
	end 'fill'

	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	var bad = 0
	for i in 0 upto 512 'check'
		let got = try big.get(i) otherwise return 1
		if got != (i mod 251) 'value'
			bad = bad + 1
		end 'value'
	end 'check'
	if bad != 0 'corrupted'
		return 2
	end 'corrupted'

	big = ByteArray.create()
	_ = __Builtins.scavengeMemory()
	_ = __Builtins.scavengeMemory()

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 300000
    arm64.movRegReg x0, x19
    arm64.bl Array.reserve
    arm64.movImm x20, 0
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x20, 512
    arm64.cset x0, lt
    arm64.cbnz x0, fill
    arm64.b forexit#4
  fill:
    arm64.movImm x0, 251
    arm64.sdiv x16, x20, x0
    arm64.msub x1, x16, x0, x20
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.b forstep#3
  forstep#3:
    arm64.add x20, x20, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.bl __slab_scavenge
    arm64.bl __slab_scavenge
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr#5
  forhdr#5:
    arm64.cmp x21, 512
    arm64.cset x0, lt
    arm64.cbnz x0, check
    arm64.b forexit#8
  check:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.cset x1, eq
    arm64.cbnz x1, __im_word
    arm64.b __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_load#24
  __im_load#24:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.arm64AddLsl x0, x0, x21, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, __im_byte
    arm64.b __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_load#25
  __im_load#25:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, x21
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b __im_loaded
  __im_loaded:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 40]
    arm64.cmp x2, 0
    arm64.cset x2, ne
    arm64.cbnz x2, __im_empty
    arm64.b critsplit#28
  __im_empty:
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.cbnz x2, __im_slow
    arm64.b critsplit#29
  critsplit#29:
    arm64.b __im_cont
  critsplit#28:
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get
    arm64.movRegReg x1, x9
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x1, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 251
    arm64.sdiv x16, x21, x1
    arm64.msub x1, x16, x1, x21
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, value
    arm64.b critsplit#27
  value:
    arm64.add x0, x20, 1
    arm64.b ifcont#12
  critsplit#27:
    arm64.movRegReg x0, x20
    arm64.b ifcont#12
  ifcont#12:
    arm64.b forstep#7
  forstep#7:
    arm64.add x21, x21, 1
    arm64.movRegReg x20, x0
    arm64.b forhdr#5
  forexit#8:
    arm64.cmp x20, 0
    arm64.cset x0, ne
    arm64.cbnz x0, corrupted
    arm64.b ifcont#14
  corrupted:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#14:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.bl __slab_scavenge
    arm64.bl __slab_scavenge
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
