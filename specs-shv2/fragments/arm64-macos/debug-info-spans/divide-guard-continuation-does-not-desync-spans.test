// Test: divide-guard-continuation-does-not-desync-spans
typealias Num = int(0 to 1000)

function pick(x Num) returns Num
	return x
end 'pick'

function main() returns ExitCode
	print("before\n")
	let n = pick(10)
	let d = pick(0)
	let q = try (n / d) otherwise 77
	print("after\n")
	return q as ExitCode
end 'main'
---
ExitCode: 77
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_2  ; "before\x0a"
    arm64.bl print
    arm64.movImm x0, 10
  __il_cont#8:
    arm64.movImm x1, 0
  __il_cont#7:
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.orr x1, x1, x2
    arm64.udiv x19, x0, x1
    arm64.cmp x2, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x19, 77
  trycont:
    arm64.leaRdata x0, __str_rec_3  ; "after\x0a"
    arm64.bl print
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at divide-guard-continuation-does-not-desync-spans.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
