// Test: member-typealias-cross-struct-field-assign
typealias Num = int(i64.min to i64.max)

type Blk
	typealias NumArray = Array with Num
	export var args as NumArray

	export static function create() returns Blk
		return Self{args: NumArray.create()}
	end 'create'
end 'Blk'

function main() returns ExitCode
	var i = 0

	while i < 3000 'l'
		var a = Blk.create()
		a.args.push(i)
		var b = Blk.create()
		b.args = a.args
		i = i + 1
	end 'l'

	print("done")
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Blk.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x19, 3000
    arm64.cset x0, lt
    arm64.cbnz x0, l
    arm64.b whileexit
  l:
    arm64.bl Blk.create
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movRegReg x1, x19
    arm64.bl __managed_push
    arm64.bl Blk.create
    arm64.movRegReg x21, x0
    arm64.loadRegBaseDisp.word64 x22, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x23, [x21 + 0]
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.movRegReg x0, x23
    arm64.bl __managed_decref
    arm64.storeBaseDispReg.word64 [x21 + 0], x22
    arm64.add x19, x19, 1
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Blk
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Blk
    arm64.b whilehdr
  whileexit:
    arm64.leaRdata x0, __str_rec_1  ; "done"
    arm64.bl print
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
