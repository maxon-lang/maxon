// Test: seven-scalar-parameters
typealias Integer = int(i64.min to i64.max)

function sum7(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer, g Integer) returns Integer
	return a + b + c + d + e + f + g
end 'sum7'

function main() returns ExitCode
	return sum7(1, b: 2, c: 4, d: 8, e: 16, f: 32, g: 64)
end 'main'
---
ExitCode: 127
---
func @sum7 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x7, x3
    arm64.movRegReg x8, x4
    arm64.movRegReg x9, x5
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x7
    arm64.add x0, x0, x8
    arm64.add x0, x0, x9
    arm64.add x0, x0, x6
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 4
    arm64.movImm x6, 8
    arm64.movImm x7, 16
    arm64.movImm x8, 32
    arm64.movImm x9, 64
    arm64.movRegReg x3, x6
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x8
    arm64.movRegReg x6, x9
    arm64.bl sum7
    arm64.epilogue 16
    arm64.ret
}
