// Test: managed-string-arguments-in-stack-slots
typealias ByteTotal = int(0 to 100000)

function joinLengths(a String, b String, c String, d String, e String, f String, g String, h String) returns ByteTotal
	return a.byteLength() + b.byteLength() + c.byteLength() + d.byteLength() + e.byteLength() + f.byteLength() + g.byteLength() + h.byteLength()
end 'joinLengths'

function main() returns ExitCode
	return joinLengths("a string long enough to be heap allocated, one", b: "bb", c: "ccc", d: "dddd", e: "eeeee", f: "ffffff", g: "another heap allocated string, seven", h: "hhhhhhhhhhhhhhhhhhhhhhhhh")
end 'main'
---
ExitCode: 127
---
func @joinLengths {
  entry:
    arm64.prologue 16
    arm64.movRegReg x8, x3
    arm64.movRegReg x9, x4
    arm64.movRegReg x10, x5
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x2 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x8 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x9 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x10 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x6 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x7 + 8]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 100000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_16
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.leaRdata x1, __str_rec_3
    arm64.leaRdata x2, __str_rec_5
    arm64.leaRdata x6, __str_rec_7
    arm64.leaRdata x7, __str_rec_9
    arm64.leaRdata x8, __str_rec_11
    arm64.leaRdata x9, __str_rec_13
    arm64.leaRdata x10, __str_rec_15
    arm64.movRegReg x3, x6
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x8
    arm64.movRegReg x6, x9
    arm64.movRegReg x7, x10
    arm64.bl joinLengths
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_17
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
