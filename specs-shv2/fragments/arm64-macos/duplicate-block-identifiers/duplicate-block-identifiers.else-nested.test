// Test: duplicate-block-identifiers.else-nested
function main() returns ExitCode
	var x = 0
	if false 'check'
		x = 1
	end 'check' else 'else_check'
		if true 'nested'
			x = 2
		end 'nested'
	end 'else_check'
	return x
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.cbnz x1, check
    arm64.b ifelse
  check:
    arm64.movImm x0, 1
    arm64.b ifcont
  ifelse:
    arm64.movImm x1, 1
    arm64.cbnz x1, nested
    arm64.b critsplit
  nested:
    arm64.movImm x0, 2
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
