// Test: method-named-args-reorder

typealias Integer = int(i64.min to i64.max)

type Calculator
	var result as Integer

	function compute(a Integer, b Integer, c Integer)
		result = a + b * c
	end 'compute'

	function get() returns Integer
		return result
	end 'get'

	static function create(result Integer) returns Self
		return Self{result: result}
	end 'create'
end 'Calculator'

function main() returns ExitCode
	var calc = Calculator.create(0)
	calc.compute(10, c: 4, b: 8)
	return calc.get()
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Calculator.compute {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.mul x2, x2, x6
    arm64.add x1, x1, x2
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @Calculator.get {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Calculator.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl Calculator.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movImm x6, 4
    arm64.movImm x2, 8
    arm64.movRegReg x0, x19
    arm64.movRegReg x3, x6
    arm64.bl Calculator.compute
    arm64.movRegReg x0, x19
    arm64.bl Calculator.get
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
