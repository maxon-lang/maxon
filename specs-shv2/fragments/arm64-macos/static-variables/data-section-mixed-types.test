// Test: data-section-mixed-types
var flag = true
var count = 10
var ratio = 2.5

function main() returns ExitCode
	if flag and (count == 10) and (ratio > 2.0) 'read'
		return 0
	end 'read'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_count@0 = i64 10
  __data_ratio@8 = f64 4612811918334230528
  __data_flag@16 = i1 1
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_flag
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.leaGlobal x0, __data_count
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 10
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.leaGlobal x0, __data_ratio
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.cset x0, gt
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, read
    arm64.b ifcont
  read:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
