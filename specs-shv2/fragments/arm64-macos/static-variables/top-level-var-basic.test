// Test: top-level-var-basic
var counter = 0

function main() returns ExitCode
	counter = 42
	return counter
end 'main'
---
ExitCode: 42
---
data {
  __data_counter@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.leaGlobal x1, __data_counter
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
