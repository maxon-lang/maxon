// Test: top-level-var-increment

typealias Integer = int(i64.min to i64.max)

var total = 10

function add(n Integer)
	total = total + n
end 'add'

function main() returns ExitCode
	add(5)
	add(27)
	return total
end 'main'
---
ExitCode: 42
---
data {
  __data_total@0 = i64 10
}

func @add {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_total
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x1, x0
    arm64.leaGlobal x1, __data_total
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl add
    arm64.movImm x0, 27
    arm64.bl add
    arm64.leaGlobal x0, __data_total
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
