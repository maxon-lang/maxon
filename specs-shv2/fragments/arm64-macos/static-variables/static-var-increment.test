// Test: static-var-increment
type Counter
	static var count = 0

	static function increment()
		Counter.count = Counter.count + 1
	end 'increment'
end 'Counter'

function main() returns ExitCode
	Counter.increment()
	Counter.increment()
	Counter.increment()
	return Counter.count
end 'main'
---
ExitCode: 3
---
data {
  __data_Counter.count@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#7
  __il_body#7:
    arm64.leaGlobal x0, __data_Counter.count
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_Counter.count
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#6
  __il_cont#6:
    arm64.b __il_body#8
  __il_body#8:
    arm64.leaGlobal x0, __data_Counter.count
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_Counter.count
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#9
  __il_body#9:
    arm64.leaGlobal x0, __data_Counter.count
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_Counter.count
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.leaGlobal x0, __data_Counter.count
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
