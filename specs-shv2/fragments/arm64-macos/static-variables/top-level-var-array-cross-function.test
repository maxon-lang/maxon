// Test: top-level-var-array-cross-function

typealias Integer = int(i64.min to i64.max)

var scores = [10, 20, 30]

function getTotal() returns Integer
	let a = try scores.get(0) otherwise 0
	let b = try scores.get(1) otherwise 0
	let c = try scores.get(2) otherwise 0
	return a + b + c
end 'getTotal'

function setScore(index Integer, value Integer)
	try scores.set(index, value: value) otherwise panic("test invariant: set OOB")
end 'setScore'

function main() returns ExitCode
	setScore(1, value: 12)
	return getTotal()
end 'main'
---
ExitCode: 52
---
data {
  __data_scores@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @getTotal {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_scores
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
    arm64.b trycont
  trycont:
    arm64.leaGlobal x0, __data_scores
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 1
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.leaGlobal x0, __data_scores
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 2
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.add x1, x19, x20
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @setScore {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x0
    arm64.movRegReg x6, x1
    arm64.leaGlobal x0, __data_scores
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x6
    arm64.bl __arr_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_rec_1
    arm64.movImm x0, 134
    arm64.importCall 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 12
    arm64.bl setScore
    arm64.bl getTotal
    arm64.epilogue 16
    arm64.ret
}
