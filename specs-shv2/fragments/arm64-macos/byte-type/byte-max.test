// Test: byte-max

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 255 as Byte
	if b == 255 'ok'
		return 0
	end 'ok' else 'fail'
		return 1
	end 'fail'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
