// Test: byte-from-hex

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 0xff as Byte
	if b == 255 'ok'
		return 0
	end 'ok' else 'fail'
		return 1
	end 'fail'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 255
    arm64.cmp x0, 255
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifelse
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
}
