// Test: method-call-wrong-self-type
typealias StringArray = Array with String

function main() returns ExitCode
	var arr = StringArray.create()
	arr.append("hello")
	return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:6:6: argument type mismatch for 'other': expected 'StringArray', got 'String'
