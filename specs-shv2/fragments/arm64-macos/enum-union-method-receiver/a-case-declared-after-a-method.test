// Test: a-case-declared-after-a-method
enum Order
	alpha

	export function bump() returns Integer
		return 1
	end 'bump'

	omega
end 'Order'

function tagOf(k Order) returns Integer
	return match k 'w'
		alpha gives 1
		omega gives 5
	end 'w'
end 'tagOf'

function main() returns ExitCode
	let e = Order.omega
	return tagOf(e) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b matchnext
  matchnext:
    arm64.b matcharm
  matcharm:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchcont:
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-case-declared-after-a-method.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
