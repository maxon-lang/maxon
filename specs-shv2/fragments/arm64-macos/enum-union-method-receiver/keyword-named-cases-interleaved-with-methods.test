// Test: keyword-named-cases-interleaved-with-methods
enum Weird
	alpha
	function

	export function mid() returns int
		var total = 0
		while total < 2 'spin'
			total = total + 1
		end 'spin'
		return total
	end 'mid'

	end
	export

	export function two() returns int
		return 20
	end 'two'

	export function three() returns int
		return 30
	end 'three'

	omega

	export function tag() returns int
		return match self 'w'
			alpha gives 1
			function gives 2
			end gives 3
			export gives 4
			omega gives 5
		end 'w'
	end 'tag'
end 'Weird'

function main() returns ExitCode
	let a = Weird.alpha
	let f = Weird.function
	let e = Weird.end
	let x = Weird.export
	let o = Weird.omega
	var acc = a.tag() + f.tag() * 10 + e.tag() * 100 + x.tag() * 1000 + o.tag() * 10000
	if acc != 54321 'bad'
		return 1
	end 'bad'
	if a.mid() != 2 'badMid'
		return 2
	end 'badMid'
	if a.two() + a.three() != 50 'badTwo'
		return 3
	end 'badTwo'
	return 7
end 'main'
---
ExitCode: 7
---
func @Weird.mid {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x0, 2
    arm64.cset x1, lt
    arm64.cbnz x1, spin
    arm64.b whileexit
  spin:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
}

func @Weird.two {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.epilogue 16
    arm64.ret
}

func @Weird.three {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 30
    arm64.epilogue 16
    arm64.ret
}

func @Weird.tag {
  entry:
    arm64.prologue 16
    arm64.jumpTable x0, default=matchdead [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm] @__jumptable_0
  matchdead:
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 3
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 4
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 1
    arm64.movImm x21, 2
    arm64.movImm x22, 3
    arm64.movImm x23, 4
    arm64.movRegReg x0, x19
    arm64.bl Weird.tag
    arm64.movRegReg x24, x0
    arm64.movRegReg x0, x20
    arm64.bl Weird.tag
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x20, x24, x0
    arm64.movRegReg x0, x21
    arm64.bl Weird.tag
    arm64.movImm x16, 100
    arm64.mul x0, x0, x16
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x22
    arm64.bl Weird.tag
    arm64.movImm x16, 1000
    arm64.mul x0, x0, x16
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x23
    arm64.bl Weird.tag
    arm64.movImm x16, 10000
    arm64.mul x0, x0, x16
    arm64.add x0, x20, x0
    arm64.cmp x0, 54321
    arm64.cset x0, ne
    arm64.cbnz x0, bad
    arm64.b ifcont
  bad:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movRegReg x0, x19
    arm64.bl Weird.mid
    arm64.cmp x0, 2
    arm64.cset x0, ne
    arm64.cbnz x0, badMid
    arm64.b ifcont
  badMid:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movRegReg x0, x19
    arm64.bl Weird.two
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl Weird.three
    arm64.add x0, x20, x0
    arm64.cmp x0, 50
    arm64.cset x0, ne
    arm64.cbnz x0, badTwo
    arm64.b ifcont
  badTwo:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x0, 7
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
