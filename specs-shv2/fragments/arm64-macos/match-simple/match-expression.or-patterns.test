// Test: match-expression.or-patterns
function main() returns ExitCode
	let x = 4
	let result = match x 'eval'
		1 or 2 gives 10
		3 or 4 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.jumpTable x0, default=matchdefault [[0..1]=matcharm#1, [2..3]=matcharm#2] @__jumptable_1
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm#1:
    arm64.movImm x0, 10
    arm64.b matchcont
  matcharm#2:
    arm64.movImm x0, 20
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-expression.or-patterns.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
