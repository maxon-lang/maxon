// Test: dispatch-arg-ranged-widening

typealias Integer = int(i64.min to i64.max)
typealias Small = int(0 to 10)

interface Runner
	function run(n Integer) returns Integer
end 'Runner'

type Direct implements Runner
	export var tag as Integer

	static function create() returns Direct
		return Self{tag: 0}
	end 'create'

	function run(n Integer) returns Integer
		return n
	end 'run'
end 'Direct'

function viaWitness(r Runner, s Small) returns Integer
	return r.run(s)
end 'viaWitness'

function main() returns ExitCode
	let d = Direct.create()
	let a = viaWitness(d, s: 5)
	let b = d.run(5)
	print("witness={a} direct={b}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Direct.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Direct.run {
  entry:
    arm64.prologue 16
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @viaWitness {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.cset x3, lt
    arm64.cbnz x3, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 10
    arm64.cset x3, gt
    arm64.cbnz x3, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

