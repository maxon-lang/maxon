// Test: dispatch-three-types

typealias Integer = int(i64.min to i64.max)

interface Valued
	function value() returns Integer
end 'Valued'

type One implements Valued
	function value() returns Integer
		return 1
	end 'value'

	static function create() returns Self
		return Self{}
	end 'create'
end 'One'

type Two implements Valued
	function value() returns Integer
		return 2
	end 'value'

	static function create() returns Self
		return Self{}
	end 'create'
end 'Two'

type Three implements Valued
	function value() returns Integer
		return 3
	end 'value'

	static function create() returns Self
		return Self{}
	end 'create'
end 'Three'

function getValue(v Valued) returns Integer
	return v.value()
end 'getValue'

function main() returns ExitCode
	let a = One.create()
	let b = Two.create()
	let c = Three.create()
	return getValue(a) + getValue(b) + getValue(c)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @One.value {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @One.create {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.epilogue 16
    arm64.ret
}

func @Two.value {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}

func @Two.create {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.epilogue 16
    arm64.ret
}

func @Three.value {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}

func @Three.create {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.epilogue 16
    arm64.ret
}

func @getValue {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl One.create
    arm64.movRegReg x19, x0
    arm64.bl Two.create
    arm64.movRegReg x20, x0
    arm64.bl Three.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __witness_One.Valued
    arm64.movRegReg x0, x19
    arm64.bl getValue
    arm64.movRegReg x22, x0
    arm64.leaRdata x1, __witness_Two.Valued
    arm64.movRegReg x0, x20
    arm64.bl getValue
    arm64.add x22, x22, x0
    arm64.leaRdata x1, __witness_Three.Valued
    arm64.movRegReg x0, x21
    arm64.bl getValue
    arm64.add x22, x22, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x22, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x22, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at dispatch-three-types.test:47: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
