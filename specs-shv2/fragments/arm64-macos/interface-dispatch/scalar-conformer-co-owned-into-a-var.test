// Test: scalar-conformer-co-owned-into-a-var
typealias Integer = int(i64.min to i64.max)

function use(h Comparable) returns Integer
	var v = h
	return 11 if true else 12
end 'use'

function main() returns ExitCode
	return use(7) as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @use {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x2, x0
    arm64.movRegReg x19, x1
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x2
    arm64.bl __retain_existential
    arm64.movRegReg x1, x0
    arm64.movImm x0, 1
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x20, 11
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x20, 12
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __drop_existential
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.leaRdata x1, __witness_int.Comparable
    arm64.bl use
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @int.compare {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, less
    arm64.b notLess
  less:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  notLess:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, greater
    arm64.b equal
  greater:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
