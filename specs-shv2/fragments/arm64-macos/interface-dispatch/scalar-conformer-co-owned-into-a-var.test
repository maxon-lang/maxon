// Test: scalar-conformer-co-owned-into-a-var
typealias Integer = int(i64.min to i64.max)

function use(h Comparable, replace bool) returns Integer
	var v = h
	if replace 'maybe'
		v = h
	end 'maybe'
	return 11 if true else 12
end 'use'

function main() returns ExitCode
	return use(7, replace: false) as ExitCode
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @use {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __retain_existential
    arm64.movRegReg x22, x0
    arm64.cbz x20, critsplit
  maybe:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl __retain_existential
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __drop_existential
    arm64.movRegReg x1, x19
    arm64.b ternarytrue
  critsplit:
    arm64.movRegReg x1, x22
  ternarytrue:
    arm64.movImm x19, 11
  matchcont:
    arm64.movRegReg x0, x21
    arm64.bl __drop_existential
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.movImm x1, 0
    arm64.leaRdata x2, __witness_int.Comparable
    arm64.bl use
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at scalar-conformer-co-owned-into-a-var.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
