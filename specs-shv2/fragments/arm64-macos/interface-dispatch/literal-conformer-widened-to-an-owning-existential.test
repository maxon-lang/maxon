// Test: literal-conformer-widened-to-an-owning-existential
function widen(h Hashable) returns Hashable
	return h
end 'widen'

function main() returns ExitCode
	print("A")
	_ = widen("abc")
	print("B")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @widen {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x2, x0
    arm64.movRegReg x19, x1
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x2
    arm64.bl __retain_existential
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __print_string
    arm64.leaRdata x0, __str_rec_3
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.bl widen
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.bl __drop_existential
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __print_string
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @String.hash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x2, 5381
    arm64.movImm x6, 0
    arm64.b header
  header:
    arm64.cmp x6, x0
    arm64.cset x7, ge
    arm64.cbnz x7, done
    arm64.b body
  done:
    arm64.movImm x0, 4294967295
    arm64.and x0, x2, x0
    arm64.epilogue 16
    arm64.ret
  body:
    arm64.add x7, x1, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.movImm x8, 33
    arm64.mul x2, x2, x8
    arm64.add x2, x2, x7
    arm64.movImm x7, 1
    arm64.add x6, x6, x7
    arm64.b header
}
