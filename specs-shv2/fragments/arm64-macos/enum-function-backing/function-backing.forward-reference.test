// Test: function-backing.forward-reference

typealias Integer = int(i64.min to i64.max)

enum Op
	doubleOp = doubleFn
	tripleOp = tripleFn
end 'Op'

function doubleFn(x Integer) returns Integer
	return x * 2
end 'doubleFn'

function tripleFn(x Integer) returns Integer
	return x * 3
end 'tripleFn'

function main() returns ExitCode
	let f = Op.doubleOp.rawValue
	return f(21)
end 'main'
---
ExitCode: 42
---
func @doubleFn {
  entry:
    arm64.prologue 16
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @tripleFn {
  entry:
    arm64.prologue 16
    arm64.arm64AddLsl x0, x0, x0, lsl #1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, __fnref_doubleFn
    arm64.leaFuncAddr x1, __fnref_tripleFn
    arm64.movImm x16, 0
    arm64.mul x1, x1, x16
    arm64.add x19, x0, x1
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at function-backing.forward-reference.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
