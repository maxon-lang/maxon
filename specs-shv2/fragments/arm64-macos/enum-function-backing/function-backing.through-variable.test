// Test: function-backing.through-variable

typealias Integer = int(i64.min to i64.max)

function doubleFn(x Integer) returns Integer
	return x * 2
end 'doubleFn'

function tripleFn(x Integer) returns Integer
	return x * 3
end 'tripleFn'

enum Op
	doubleOp = doubleFn
	tripleOp = tripleFn
end 'Op'

function apply(op Op, x Integer) returns Integer
	let f = op.rawValue
	return f(x)
end 'apply'

function main() returns ExitCode
	return apply(Op.tripleOp, x: 14)
end 'main'
---
ExitCode: 42
---
func @doubleFn {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @tripleFn {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 3
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @apply {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.leaFuncAddr x3, __fnref_doubleFn
    arm64.mul x2, x2, x3
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.leaFuncAddr x3, __fnref_tripleFn
    arm64.mul x0, x0, x3
    arm64.add x19, x2, x0
    arm64.movImm x2, 0
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 14
    arm64.bl apply
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at function-backing.through-variable.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
