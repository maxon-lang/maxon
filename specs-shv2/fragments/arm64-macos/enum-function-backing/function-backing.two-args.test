// Test: function-backing.two-args

typealias Integer = int(i64.min to i64.max)

function addFn(a Integer, b Integer) returns Integer
	return a + b
end 'addFn'

function subFn(a Integer, b Integer) returns Integer
	return a - b
end 'subFn'

enum BinOp
	add = addFn
	sub = subFn
end 'BinOp'

function main() returns ExitCode
	let addF = BinOp.add.rawValue
	let subF = BinOp.sub.rawValue
	return addF(30, 15) - subF(5, 2)
end 'main'
---
ExitCode: 42
---
func @addFn {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @subFn {
  entry:
    arm64.prologue 16
    arm64.sub x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, __fnref_addFn
    arm64.leaFuncAddr x1, __fnref_subFn
    arm64.movImm x16, 0
    arm64.mul x1, x1, x16
    arm64.add x19, x0, x1
    arm64.leaFuncAddr x0, __fnref_addFn
    arm64.movImm x16, 0
    arm64.mul x0, x0, x16
    arm64.leaFuncAddr x1, __fnref_subFn
    arm64.add x20, x0, x1
    arm64.movImm x0, 30
    arm64.movImm x1, 15
    arm64.movImm x2, 0
    arm64.blr x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 5
    arm64.movImm x1, 2
    arm64.movImm x2, 0
    arm64.blr x20
    arm64.sub x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
