// Test: float-backed-equality-is-the-tag-compare
enum SignedZero
	negz = -0.0
	posz = 0.0
end 'SignedZero'

function main() returns ExitCode
	let x = SignedZero.negz
	if x == SignedZero.posz 'floatEquality'
		return 9
	end 'floatEquality'
	return match x 'check'
		negz gives 4
		posz gives 7
	end 'check'
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, -9223372036854775808
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, floatEquality
    arm64.b ifcont
  floatEquality:
    arm64.movImm x0, 9
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x1, -9223372036854775808
    arm64.cmp x0, x1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 4
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 7
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
