// Test: float-backed-ordering-two-negative-cases
enum FloatSigned
	below = -2.2
	mid = -1.1
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	if f < FloatSigned.mid 'lt'
		print("lt")
	end 'lt' else 'ge'
		print("ge")
	end 'ge'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, -4611235658464650854
    arm64.movImm x1, -4615739258092021350
    arm64.fmov d0, x0
    arm64.fmov d1, x1
    arm64.fcmp d0, d1
    arm64.cset x0, mi
    arm64.cbnz x0, lt
    arm64.b ifelse
  lt:
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __print_string
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
