// Test: float-backed-ordering-two-negative-cases
enum FloatSigned
	below = -2.2
	mid = -1.1
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	if f < FloatSigned.mid 'lt'
		print("lt")
	end 'lt' else 'ge'
		print("ge")
	end 'ge'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b lt
  lt:
    arm64.leaRdata x0, __str_rec_2  ; "lt"
    arm64.bl print
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
