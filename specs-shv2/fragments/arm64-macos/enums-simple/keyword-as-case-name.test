// Test: keyword-as-case-name
enum TokenType
	function
	return
	end
	if
	else
	let
	var
	identifier
end 'TokenType'

function main() returns ExitCode
	let t = TokenType.function
	let result = match t 'check'
		function gives 1
		return gives 0
		end gives 0
		if gives 0
		else gives 0
		let gives 0
		var gives 0
		identifier gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.jumpTable x0, default=matchdead [[0]=matcharm, [1]=matcharm, [2]=matcharm, [3]=matcharm, [4]=matcharm, [5]=matcharm, [6]=matcharm, [7]=matcharm] @__jumptable_1
  matchdead:
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
