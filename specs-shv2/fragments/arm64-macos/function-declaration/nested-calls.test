// Test: nested-calls

typealias Integer = int(i64.min to i64.max)

function double(x Integer) returns Integer
	return x * 2
end 'double'

function quadruple(x Integer) returns Integer
	return double(double(x))
end 'quadruple'

function main() returns ExitCode
	return quadruple(3)
end 'main'
---
ExitCode: 12
---
func @double {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @quadruple {
  entry:
    arm64.prologue 16
    arm64.bl double
    arm64.bl double
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.bl quadruple
    arm64.epilogue 16
    arm64.ret
}
