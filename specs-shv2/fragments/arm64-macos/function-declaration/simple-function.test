// Test: simple-function

typealias Integer = int(i64.min to i64.max)

function add() returns Integer
	return 3 + 4
end 'add'

function main() returns ExitCode
	return add()
end 'main'
---
ExitCode: 7
---
func @add {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.add x0, x0, 4
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl add
    arm64.epilogue 16
    arm64.ret
}
