// Test: if-inside-a-try-handler
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var flag = 0 as Integer
	try [10, 20, 30].get(9) otherwise 'h'
		if [1, 2].count() == 2 'y'
			flag = 4
		end 'y'
	end 'h'
	return flag
end 'main'
