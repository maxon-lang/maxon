// Test: if-condition-temp-inside-a-loop
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var n = 0 as Integer
	var i = 0 as Integer
	while i < 500 'loop'
		if [1, 2, 3].count() == 3 'x'
			n = n + 1
		end 'x'
		i = i + 1
	end 'loop'
	return n / 100
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 500
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x21, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x21
    arm64.bl __arr_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x21
    arm64.bl __arr_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x21
    arm64.bl __arr_push
    arm64.movRegReg x0, x21
    arm64.bl __arr_count
    arm64.cmp x0, 3
    arm64.cset x22, eq
    arm64.movRegReg x0, x21
    arm64.bl __arr_decref
    arm64.cbnz x22, x
    arm64.b critsplit
  x:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.add x20, x20, 1
    arm64.movRegReg x19, x0
    arm64.b whilehdr
  whileexit:
    arm64.movImm x0, 100
    arm64.sdiv x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
