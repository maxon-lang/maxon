// Test: field-assign-struct-in-if-scope
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

export type Inner
		export var items as IntArray
		export var value as Integer

		static function create(items IntArray, value Integer) returns Self
			return Self{items: items, value: value}
		end 'create'
end 'Inner'

export type Outer
		export var inner as Inner
		export var initialized as bool

		static function create(inner Inner, initialized bool) returns Self
			return Self{inner: inner, initialized: initialized}
		end 'create'
end 'Outer'

function initOuter(o Outer)
		if not o.initialized 'init'
				o.inner = Inner.create(IntArray.create(), value: 42)
				o.initialized = true
		end 'init'
end 'initOuter'

function main() returns ExitCode
		var o = Outer.create(Inner.create(IntArray.create(), value: 0), initialized: false)
		initOuter(o)
		o.inner.items.push(1)
		o.inner.items.push(2)
		o.inner.items.push(3)
		return o.inner.items.count()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Inner.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Outer.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.byte [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Inner
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @initOuter {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.byte x0, [x19 + 8]
    arm64.eor x0, x0, 1
    arm64.cbnz x0, init
    arm64.b ifcont
  init:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movImm x1, 42
    arm64.bl Inner.create
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __destruct_Inner
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.byte [x19 + 8], x0
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movImm x1, 0
    arm64.bl Inner.create
    arm64.movImm x1, 0
    arm64.bl Outer.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl initOuter
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 1
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 2
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 3
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Outer
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
