// Test: memory.mutating-the-list-inside-for-in-ends-the-loop
typealias Int = int(i64.min to i64.max)
typealias IntList = List with Int

function main() returns ExitCode
	var l = IntList.create()
	l.append(1)
	l.append(2)
	l.append(3)
	for x in l 'each'
		print("[{x}]\n")
		l.clear()
	end 'each'
	print("count={l.count()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
