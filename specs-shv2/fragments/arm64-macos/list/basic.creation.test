// Test: basic.creation
function main() returns ExitCode
	let list = List from [10, 20, 30]
	return list.count()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 10
    arm64.leaRdata x0, __layout_List_int
    arm64.bl List.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl List.append
    arm64.movImm x1, 20
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.bl List.append
    arm64.movImm x1, 30
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.bl List.append
    arm64.movRegReg x0, x20
    arm64.bl List.count
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_List_int
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
