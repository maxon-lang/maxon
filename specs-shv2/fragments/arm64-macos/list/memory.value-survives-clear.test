// Test: memory.value-survives-clear
typealias StringList = List with String

function main() returns ExitCode
	var list = StringList.create()
	list.append("hello world!!!!!!!!!!!!!!")
	let val = try list.first() otherwise "none"
	list.clear()
	print("{val}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

