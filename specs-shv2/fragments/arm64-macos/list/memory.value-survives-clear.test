    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_List_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl List.append
    arm64.leaRdata x1, __layout_List_String
    arm64.movRegReg x0, x19
    arm64.bl List.first
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_rec_4
    arm64.bl __str_retain
    arm64.movRegReg x20, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl List.clear
    arm64.loadRegBaseDisp.word64 x21, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x20 + 8]
    arm64.leaRdata x0, __str_rec_5
    arm64.loadRegBaseDisp.word64 x23, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x24, [x0 + 8]
    arm64.add x25, x22, x24
    arm64.add x0, x25, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
    arm64.add x27, x26, 56
    arm64.movRegReg x0, x27
    arm64.movRegReg x1, x21
