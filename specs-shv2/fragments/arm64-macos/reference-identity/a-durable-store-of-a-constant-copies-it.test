// Test: a-durable-store-of-a-constant-copies-it
typealias Num = int(0 to 1000)
typealias NumArray = Array with Num
typealias Holder = Array with NumArray

let Anchor = NumArray.create()

function main() returns ExitCode
	var result = 0
	let bound = Anchor
	if bound is Anchor 'bindingBorrows'
		result = result + 1
	end 'bindingBorrows'

	var h = Holder.create()
	h.push(Anchor)
	let stored = try h.get(0) otherwise NumArray.create()
	if stored is not Anchor 'storeCopies'
		result = result + 2
	end 'storeCopies'

	return result
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.leaRdata x0, __barr_empty_2_trivial
    arm64.leaRdata x1, __barr_empty_2_trivial
    arm64.cmp x0, x1
    arm64.b.ne ifcont#2
  bindingBorrows:
    arm64.movImm x19, 1
  ifcont#2:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __barr_empty_2_trivial
    arm64.bl __managed_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x20 + 40]
    arm64.cmp x2, 0
    arm64.b.eq critsplit#17
  __im_empty:
    arm64.cmp x21, 0
    arm64.b.ne critsplit#18
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.movRegReg x21, x0
    arm64.b __im_cont
  critsplit#18:
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  critsplit#17:
    arm64.movRegReg x9, x0
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __managed_incref
    arm64.movRegReg x0, x21
  trycont:
    arm64.leaRdata x1, __barr_empty_2_trivial
    arm64.cmp x0, x1
    arm64.b.eq ifcont#7
  storeCopies:
    arm64.add x19, x19, 2
  ifcont#7:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-durable-store-of-a-constant-copies-it.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
