// Test: a-field-of-an-imaged-container-let-is-readable
typealias Ver = int(0 to 100)

type Bag uses T
	typealias Items = Array with T
	export var items as Items = Items.create()
	export var version as Ver = 7
	export static function create() returns Self
		return Self{}
	end 'create'
	export function size() returns ExitCode
		return self.items.count() as ExitCode
	end 'size'
end 'Bag'

typealias StrBag = Bag with String

let Shared = StrBag.create()

function main() returns ExitCode
	let viaMethod = Shared.size()
	let viaField = Shared.items.count() as ExitCode
	return ((Shared.version as ExitCode) * 10) + viaMethod + viaField
end 'main'
---
ExitCode: 70
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-field-of-an-imaged-container-let-is-readable.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __struct_rec_0
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.cmp x1, 0
    arm64.b.lt __il_slow
  __rc_chk#10:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok#9
  __il_slow:
    arm64.bl Bag.size
    arm64.b __il_cont
  __rc_ok#9:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.leaRdata x1, __struct_rec_0
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-field-of-an-imaged-container-let-is-readable.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.leaRdata x2, __struct_rec_0
    arm64.loadRegBaseDisp.word64 x2, [x2 + 8]
    arm64.movImm x16, 10
    arm64.mul x2, x2, x16
    arm64.add x0, x2, x0
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#5
  __rc_chk#6:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-field-of-an-imaged-container-let-is-readable.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.epilogue 16
    arm64.ret
}
