// Test: function-same-arg
typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Box'

function areSame(a Box, b Box) returns bool
	return a is b
end 'areSame'

function main() returns ExitCode
	let x = Box.create(42)
	let y = Box.create(42)
	var result = 0
	if areSame(x, b: x) 'same'
		result = result + 1
	end 'same'
	if areSame(x, b: y) 'diff'
		result = result + 10
	end 'diff'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 42
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 42
    arm64.bl Box.create
    arm64.movImm x1, 0
    arm64.b __il_body#9
  __il_body#9:
    arm64.cmp x19, x19
    arm64.cset x2, eq
    arm64.b __il_cont#8
  __il_cont#8:
    arm64.cbnz x2, same
    arm64.b critsplit#12
  same:
    arm64.movImm x1, 1
    arm64.b ifcont#2
  critsplit#12:
    arm64.b ifcont#2
  ifcont#2:
    arm64.b __il_body#11
  __il_body#11:
    arm64.cmp x19, x0
    arm64.cset x2, eq
    arm64.b __il_cont#10
  __il_cont#10:
    arm64.cbnz x2, diff
    arm64.b critsplit#13
  diff:
    arm64.add x20, x1, 10
    arm64.b ifcont#4
  critsplit#13:
    arm64.movRegReg x20, x1
    arm64.b ifcont#4
  ifcont#4:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at function-same-arg.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
