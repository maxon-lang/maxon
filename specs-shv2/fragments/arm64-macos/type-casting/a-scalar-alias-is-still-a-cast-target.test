// Test: a-scalar-alias-is-still-a-cast-target
typealias Wide = int(0 to u64.max)
typealias Narrow = int(0 to 63)

function main() returns ExitCode
	let w = 5 as Wide
	let n = w as Narrow
	print("n={n}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

