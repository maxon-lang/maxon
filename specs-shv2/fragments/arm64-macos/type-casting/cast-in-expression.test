// Test: cast-in-expression

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let b = 10 as Byte
	let result = b + 32
	return result
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.add x0, x0, 32
    arm64.epilogue 16
    arm64.ret
}
