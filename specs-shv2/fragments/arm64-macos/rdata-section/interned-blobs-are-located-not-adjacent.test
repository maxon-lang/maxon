// Test: interned-blobs-are-located-not-adjacent
function main() returns ExitCode
	let first = "region-one"
	let middle = "MIDDLE-PAYLOAD"
	let last = "region-two"
	return first.byteLength() + middle.byteLength() + last.byteLength()
end 'main'
---
ExitCode: 34
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_3
    arm64.leaRdata x19, __str_rec_4
    arm64.leaRdata x20, __str_rec_5
    arm64.b __il_body#7
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.cmp x21, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __il_slow#9
    arm64.b __rc_ok#8
  __il_slow#9:
    arm64.bl String.byteLength
    arm64.movRegReg x21, x0
    arm64.b __il_cont#6
  __rc_ok#8:
    arm64.b __il_cont#6
  __il_cont#6:
    arm64.b __il_body#10
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __il_slow#12
    arm64.b __rc_ok#11
  __il_slow#12:
    arm64.movRegReg x0, x19
    arm64.bl String.byteLength
    arm64.b __il_cont#5
  __rc_ok#11:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.add x19, x21, x0
    arm64.b __il_body#13
  __il_body#13:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __il_slow#15
    arm64.b __rc_ok#14
  __il_slow#15:
    arm64.movRegReg x0, x20
    arm64.bl String.byteLength
    arm64.b __il_cont#4
  __rc_ok#14:
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#1:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
