// Test: floor.with-ceil
function main() returns ExitCode
	let x = 3.7
	let a = trunc(floor(x))
	let b = trunc(ceil(x))
	return a + b
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.frintm d1, d0
    arm64.fcvtzs x0, d1
    arm64.frintp d0, d0
    arm64.fcvtzs x1, d0
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
