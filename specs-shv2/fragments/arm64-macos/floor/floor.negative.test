// Test: floor.negative
function main() returns ExitCode
	let neg = -3.2
	let y = trunc(floor(neg))
	return y + 10
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 6
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
