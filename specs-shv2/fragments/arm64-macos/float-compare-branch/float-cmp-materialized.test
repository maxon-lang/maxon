// Test: float-cmp-materialized
var big = 1.0e308

function main() returns ExitCode
	let inf = big * 10.0
	let nan = inf - inf
	let a = nan == nan
	let b = nan != nan
	var r = 0
	if a 'isEq'
		r = r + 1
	end 'isEq'
	if b 'isNe'
		r = r + 2
	end 'isNe'
	return r
end 'main'
---
ExitCode: 2
---
data {
  __data_big@0 = f64 9214871658872686752
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_big
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fmul d0, d0, d1
    arm64.fsub d0, d0, d0
    arm64.fcmp d0, d0
    arm64.cset x0, eq
    arm64.fcmp d0, d0
    arm64.cset x1, ne
    arm64.movImm x2, 0
    arm64.cbnz x0, isEq
    arm64.b critsplit
  isEq:
    arm64.add x0, x2, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b ifcont
  ifcont:
    arm64.cbnz x1, isNe
    arm64.b critsplit
  isNe:
    arm64.add x0, x0, 2
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
