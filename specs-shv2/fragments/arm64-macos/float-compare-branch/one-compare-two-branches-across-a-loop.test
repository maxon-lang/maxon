// Test: one-compare-two-branches-across-a-loop
typealias Num = int(i64.min to i64.max)

function classify(x Num, n Num) returns Num
	let small = x < 10
	var acc = 0
	if small 'first'
		acc = acc + 1
	end 'first'

	var i = 0
	while i < n 'loop'
		acc = acc + i
		i = i + 1
	end 'loop'

	if small 'second'
		acc = acc + 100
	end 'second'
	return acc
end 'classify'

function main() returns ExitCode
	return classify(3, n: 4)
end 'main'
---
ExitCode: 107
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 10
    arm64.cset x0, lt
    arm64.movImm x2, 0
    arm64.cbnz x0, first
    arm64.b critsplit
  first:
    arm64.add x2, x2, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x6, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x6, x1
    arm64.cset x7, lt
    arm64.cbnz x7, loop
    arm64.b whileexit
  loop:
    arm64.add x2, x2, x6
    arm64.add x6, x6, 1
    arm64.b whilehdr
  whileexit:
    arm64.cbnz x0, second
    arm64.b critsplit
  second:
    arm64.add x0, x2, 100
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.bl classify
    arm64.epilogue 16
    arm64.ret
}
