    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 9
    arm64.cset x0, lt
    arm64.cbnz x0, push
    arm64.b whileexit
  push:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 7
    arm64.movImm x2, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#5
    arm64.b tryok#4
  tryerr#5:
    arm64.leaRdata x0, __str_blob_0  ; "panic at cross-byte-boundary.test:11: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#4:
    arm64.movImm x1, 8
    arm64.movImm x2, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#7
    arm64.b tryok#6
  tryerr#7:
    arm64.leaRdata x0, __str_blob_1  ; "panic at cross-byte-boundary.test:12: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#6:
    arm64.movImm x1, 7
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#9
    arm64.b tryok#8
  tryerr#9:
    arm64.movImm x20, 0
    arm64.b trycont#10
  tryok#8:
    arm64.movRegReg x20, x0
    arm64.b trycont#10
  trycont#10:
    arm64.movImm x1, 8
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
