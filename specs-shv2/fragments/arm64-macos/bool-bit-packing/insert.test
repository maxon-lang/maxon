    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x21, 1
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.movImm x1, 0
    arm64.cbnz x20, c0
    arm64.b critsplit
  c0:
    arm64.add x1, x1, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.cbnz x21, c1
    arm64.b critsplit
  c1:
    arm64.add x1, x1, 10
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.cbnz x0, c2
    arm64.b critsplit
  c2:
    arm64.add x20, x1, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x20, x1
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
