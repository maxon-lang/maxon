// Test: conformance-arguments-in-parentheses-at-arity-two

typealias Integer = int(i64.min to i64.max)
typealias Float = float(f64.min to f64.max)

interface Two uses A, B
	function first() returns A
	function second() returns B
end 'Two'

type Pair implements Two with (Integer, Float)
	let a as Integer
	let b as Float

	function first() returns Integer
		return a
	end 'first'

	function second() returns Float
		return b
	end 'second'

	static function create(a Integer, b Float) returns Self
		return Self{a: a, b: b}
	end 'create'
end 'Pair'

function main() returns ExitCode
	let p = Pair.create(42, b: 1.5)
	return p.first()
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 42
    arm64.fpLoadRdata d0, [rdata + __fconst_1.5]
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], d0
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at conformance-arguments-in-parentheses-at-arity-two.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
