// Test: conformance-argument-unparenthesized-at-arity-one

typealias Integer = int(i64.min to i64.max)

interface One uses A
	function get() returns A
end 'One'

type Holder implements One with Integer
	let v as Integer

	function get() returns Integer
		return v
	end 'get'

	static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(42)
	return h.get()
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.get {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 42
    arm64.bl Holder.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Holder.get
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
