// Test: two-alias-spellings-of-one-generic-instance-conform

typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer
typealias AlsoIntArray = Array with Integer

interface Bag
	function take(xs IntArray) returns Integer
end 'Bag'

type Sack implements Bag
	let n as Integer

	function take(xs AlsoIntArray) returns Integer
		return n + xs.count()
	end 'take'

	static function create() returns Self
		return Self{n: 41}
	end 'create'
end 'Sack'

function main() returns ExitCode
	let s = Sack.create()
	var f = IntArray.create()
	f.push(7)
	return s.take(f)
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Sack.take {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.bl __arr_count
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Sack.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 41
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Sack.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 7
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Sack.take
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x21, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
