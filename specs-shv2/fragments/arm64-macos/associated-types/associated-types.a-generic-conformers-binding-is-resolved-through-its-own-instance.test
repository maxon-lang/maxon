// Test: associated-types.a-generic-conformers-binding-is-resolved-through-its-own-instance
typealias Integer = int(i64.min to i64.max)

interface Taker uses Element
	function take(e Element) returns Integer
	function label() returns Integer
end 'Taker'

type Holder uses E implements Taker with E
	let base as Integer
	let seed as E

	function take(e E) returns Integer
		return self.base
	end 'take'

	function label() returns Integer
		return self.base
	end 'label'

	static function create(base Integer, seed E) returns Self
		return Self{base: base, seed: seed}
	end 'create'
end 'Holder'

type Box uses T
	typealias TakerOfT = Taker with T

	let extra as Integer

	export function run(t TakerOfT) returns Integer
		return t.label() + self.extra
	end 'run'

	static function create(extra Integer) returns Self
		return Self{extra: extra}
	end 'create'
end 'Box'

typealias IntHolder = Holder with Integer
typealias IntBox = Box with Integer

function main() returns ExitCode
	return IntBox.create(11).run(IntHolder.create(20, seed: 0)) as ExitCode
end 'main'
---
ExitCode: 31
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.take {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Holder.label {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Box.run {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.loadRegBaseDisp.word64 x16, [x2 + 32]
    arm64.blr x16
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.add x0, x0, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 11
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl Holder.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __witness_Holder.Taker
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Box.run
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
