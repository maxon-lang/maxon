// Test: w61.expansion-descends-into-a-nested-instance-argument
typealias Num = int(0 to 1000)

interface Holder uses Element
	typealias Nested = Array with (Array with Element)
	function absorb(value Nested)
end 'Holder'

typealias NumStore = Array with Num
typealias NumStoreStore = Array with NumStore

type Crate implements Holder with Num
	var items as NumStoreStore = NumStoreStore.create()

	export static function create() returns Self
		return Self{}
	end 'create'

	export function absorb(value NumStoreStore)
		items = value.clone()
	end 'absorb'

	export function count() returns Num
		return items.count()
	end 'count'
end 'Crate'

function main() returns ExitCode
	var c = Crate.create()
	var outer = NumStoreStore.create()
	var inner = NumStore.create()
	inner.push(3)
	outer.push(inner)
	c.absorb(outer)
	print("{c.count()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Crate.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __fieldDefault#Crate#items
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Crate.absorb {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x2, __layout_Array_NumStore
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl Array.clone
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __managed_decref
    arm64.storeBaseDispReg.word64 [x19 + 0], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Crate.count {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at w61.expansion-descends-into-a-nested-instance-argument.test:24: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

