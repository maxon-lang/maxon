// Test: associated-types.two-conformers-disagree-but-every-dispatch-site-names-its-binding
typealias Integer = int(i64.min to i64.max)
typealias IntTaker = Taker with Integer
typealias TextTaker = Taker with String

interface Taker uses Element
	function take(e Element) returns Integer
end 'Taker'

type IntRunner implements Taker with Integer
	let base as Integer

	function take(e Integer) returns Integer
		return base + e
	end 'take'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'IntRunner'

type TextRunner implements Taker with String
	let base as Integer

	function take(e String) returns Integer
		return base + e.byteLength()
	end 'take'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'TextRunner'

function useInt(t IntTaker) returns Integer
	return t.take(20)
end 'useInt'

function useText(t TextTaker) returns Integer
	return t.take("abcdefghij")
end 'useText'

function main() returns ExitCode
	return (useInt(IntRunner.create(20)) + useText(TextRunner.create(11))) as ExitCode
end 'main'
---
ExitCode: 61
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @IntRunner.take {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @IntRunner.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @TextRunner.take {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.cmp x0, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.movRegReg x0, x1
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @TextRunner.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @useInt {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.movImm x1, 20
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @useText {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.leaRdata x1, __str_rec_1
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 20
    arm64.bl IntRunner.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_IntRunner.Taker
    arm64.movRegReg x0, x19
    arm64.bl useInt
    arm64.movRegReg x20, x0
    arm64.movImm x0, 11
    arm64.bl TextRunner.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __witness_TextRunner.Taker
    arm64.movRegReg x0, x21
    arm64.bl useText
    arm64.add x20, x20, x0
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
