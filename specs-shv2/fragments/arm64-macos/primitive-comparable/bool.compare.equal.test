// Test: bool.compare.equal
function main() returns ExitCode
	let a = true
	let b = true
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 0
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b s
  s:
    arm64.movImm x0, 1
    arm64.b ifcont#11
  ifcont#11:
    arm64.b o
  o:
    arm64.movImm x1, 1
    arm64.b ifcont#13
  ifcont#13:
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, lt
    arm64.b ifcont#15
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#15:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, gt
    arm64.b ifcont#17
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#17:
    arm64.movImm x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext#6:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
