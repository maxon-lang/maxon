    arm64.b ifcont#19
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#19:
    arm64.movImm x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
