// Test: bool.compare.false-true
function main() returns ExitCode
	let a = false
	let b = true
	let result = a.compare(b)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.bl bool.compare
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @bool.compare {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, less
    arm64.b notLess
  less:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  notLess:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, greater
    arm64.b equal
  greater:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
