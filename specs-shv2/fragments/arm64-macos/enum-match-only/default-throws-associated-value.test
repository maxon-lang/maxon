// Test: default-throws-associated-value

typealias Integer = int(i64.min to i64.max)

union Result
	success(value Integer)
	failure(code Integer)
	pending
end 'Result'

enum MatchError
	unmatched
end 'MatchError'

function getValue(r Result) returns ExitCode throws MatchError
	match r 'check'
		success(v) then return v
		failure(c) then return c
		default throws MatchError.unmatched
	end 'check'
end 'getValue'

function main() returns ExitCode
	let r = Result.success(42)
	let result = try getValue(r) otherwise 0
	return result
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @getValue {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.movImm x0, 0
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchcont:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 42
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movRegReg x0, x20
    arm64.bl getValue
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
