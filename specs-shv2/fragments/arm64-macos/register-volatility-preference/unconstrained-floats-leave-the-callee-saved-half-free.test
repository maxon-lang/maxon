    arm64.fpLoadRdata d0, [rdata + __fconst_2]
    arm64.bl fsink
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fadd d1, d0, d1
    arm64.fpLoadRdata d2, [rdata + __fconst_3]
    arm64.fadd d2, d0, d2
