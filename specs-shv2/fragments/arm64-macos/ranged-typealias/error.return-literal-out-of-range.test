// Test: error.return-literal-out-of-range
typealias SmallInt = int(0 to 10)

function getVal() returns SmallInt
	return 15
end 'getVal'

function main() returns ExitCode
	return getVal()
end 'main'
---
CompilerError:
error E3005: <fragment>:5:2: Value 15 is outside the range of 'SmallInt' (int(0 to 10))
