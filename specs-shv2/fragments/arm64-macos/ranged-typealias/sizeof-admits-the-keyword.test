// Test: sizeof-admits-the-keyword
function main() returns ExitCode
	return (sizeof(int) + sizeof(float)) as ExitCode
end 'main'
---
ExitCode: 16
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
