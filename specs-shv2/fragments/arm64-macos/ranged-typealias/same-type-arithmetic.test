// Test: same-type-arithmetic
typealias Score = int(0 to 100)

function main() returns ExitCode
	let a = 30 as Score
	let b = 12 as Score
	return a + b
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 30
    arm64.add x0, x0, 12
    arm64.epilogue 16
    arm64.ret
}
