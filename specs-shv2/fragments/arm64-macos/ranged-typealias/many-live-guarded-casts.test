// Test: many-live-guarded-casts
typealias Small = int(0 to 1000)
typealias Wide = int(0 to 100000)

function widen(n Wide) returns Wide
	return n + 1
end 'widen'

function main() returns ExitCode
	var acc = 0
	let w0 = widen(0)
	let w1 = widen(1)
	let w2 = widen(2)
	let w3 = widen(3)
	let w4 = widen(4)
