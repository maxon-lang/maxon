// Test: unsigned-max-upper-literal-in-range
typealias Big = int(5 to u64.max)

function main() returns ExitCode
	let x = -1 as Big
	if x == u64.max 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, -1
    arm64.add x0, x0, 0
    arm64.cmp x0, -1
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
