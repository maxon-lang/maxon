    arm64.b.le __rc_ok#7
  __rc_panic#8:
    arm64.leaRdata x0, __str_blob_12  ; "panic at guards-fire-at-their-own-site-in-source-order.test:18: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
