    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#4:
    arm64.leaRdata x0, __str_rec_6  ; "after-y\x0a"
    arm64.bl print
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic#8
  __rc_chk#9:
