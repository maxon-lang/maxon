// Test: type-parameter-argument-unranged-type-argument
typealias FullInt = int(i64.min to i64.max)

type Box uses T
	export var v as T

	static function create(seed T) returns Self
		return Self{v: seed}
	end 'create'

	export function put(value T)
		self.v = value
	end 'put'
end 'Box'

typealias IB = Box with FullInt

function main() returns ExitCode
	var b = IB.create(1)
	b.put(1000000)
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 1
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 1000000
    arm64.b __il_body
  __il_body:
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont
  __il_cont:
    arm64.movImm x0, 42
    arm64.epilogue 32
    arm64.ret
}
