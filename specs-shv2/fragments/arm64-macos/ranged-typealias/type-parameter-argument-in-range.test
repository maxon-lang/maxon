  __il_body#5:
    arm64.b __rc_chk#7
  __rc_chk#7:
    arm64.b __rc_ok#6
  __rc_ok#6:
    arm64.movImm x0, 55
    arm64.b __rc_chk#9
  __rc_chk#9:
    arm64.b __rc_ok#8
  __rc_ok#8:
    arm64.b __il_cont#4
