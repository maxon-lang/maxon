    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at type-parameter-argument-in-range.test:25: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
