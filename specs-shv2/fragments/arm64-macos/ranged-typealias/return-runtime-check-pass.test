// Test: return-runtime-check-pass
typealias Score = int(0 to 100)

function half(s Score) returns Score
	return s / 2
end 'half'

function main() returns ExitCode
	return half(84)
end 'main'
---
ExitCode: 42
---
func @half {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 2
    arm64.sdiv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 84
    arm64.bl half
    arm64.epilogue 16
    arm64.ret
}
