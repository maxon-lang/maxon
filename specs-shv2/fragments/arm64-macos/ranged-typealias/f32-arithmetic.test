// Test: f32-arithmetic
typealias F = float(f32.min to f32.max)

function main() returns ExitCode
	let a = 10.0 as F
	let b = 3.0 as F
	let sum = a + b
	let diff = a - b
	let prod = a * b
	let quot = a / b
	return trunc(sum + diff + prod + quot)
end 'main'
---
ExitCode: 53
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fadd d2, d0, d1
    arm64.fsub d3, d0, d1
    arm64.fmul d4, d0, d1
    arm64.fdiv d0, d0, d1
    arm64.fadd d1, d2, d3
    arm64.fadd d1, d1, d4
    arm64.fadd d0, d1, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
