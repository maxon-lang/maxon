// Test: unsigned-max-upper-call-argument
typealias Idx = int(0 to u64.max)

function identity(i Idx) returns Idx
	return i
end 'identity'

function main() returns ExitCode
	return identity(7)
end 'main'
---
ExitCode: 7
---
func @identity {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.bl identity
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
