// Test: return-float-range-check
typealias Float = float(f64.min to f64.max)
typealias Pct = float(0.0 to 100.0)

function clampedPct(x Float) returns Pct
	return x
end 'clampedPct'

function main() returns ExitCode
	return trunc(clampedPct(42.5))
end 'main'
---
ExitCode: 42
---
func @clampedPct {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x0, mi
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fcmp d0, d1
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_3]
    arm64.bl clampedPct
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
