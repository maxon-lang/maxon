// Test: cmp-not-a-shifted-imm12
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(65535)
	if not (x == 65535) 'eqWord'
		return 31
	end 'eqWord'
	if x > 65535 'gtWord'
		return 32
	end 'gtWord'
	if not (x < 65536) 'ltNext'
		return 33
	end 'ltNext'
	let y = base(16777215)
	if not (y == 16777215) 'eqPairMax'
		return 34
	end 'eqPairMax'
	if not (y > 65535) 'gtWordFromPair'
		return 35
	end 'gtWordFromPair'
	if y == 16777214 'eqOffByOne'
		return 36
	end 'eqOffByOne'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 65535
    arm64.bl base
    arm64.movImm x16, 65535
    arm64.cmp x0, x16
    arm64.cset x1, eq
    arm64.eor x1, x1, 1
    arm64.cbnz x1, eqWord
    arm64.b ifcont
  eqWord:
    arm64.movImm x0, 31
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 65535
    arm64.cmp x0, x16
    arm64.cset x1, gt
    arm64.cbnz x1, gtWord
    arm64.b ifcont
  gtWord:
    arm64.movImm x0, 32
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x0, 65536
    arm64.cset x0, lt
    arm64.eor x0, x0, 1
    arm64.cbnz x0, ltNext
    arm64.b ifcont
  ltNext:
    arm64.movImm x0, 33
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 16777215
    arm64.bl base
    arm64.movImm x16, 16777215
    arm64.cmp x0, x16
    arm64.cset x1, eq
    arm64.eor x1, x1, 1
    arm64.cbnz x1, eqPairMax
    arm64.b ifcont
  eqPairMax:
    arm64.movImm x0, 34
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 65535
    arm64.cmp x0, x16
    arm64.cset x1, gt
    arm64.eor x1, x1, 1
    arm64.cbnz x1, gtWordFromPair
    arm64.b ifcont
  gtWordFromPair:
    arm64.movImm x0, 35
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 16777214
    arm64.cmp x0, x16
    arm64.cset x0, eq
    arm64.cbnz x0, eqOffByOne
    arm64.b ifcont
  eqOffByOne:
    arm64.movImm x0, 36
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
