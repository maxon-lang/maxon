// Test: cmp-imm12-boundary
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(4096)
	if x == 4095 'eqLo'
		return 11
	end 'eqLo'
	if not (x > 4095) 'gtLo'
		return 12
	end 'gtLo'
	if not (x == 4096) 'eqHi'
		return 13
	end 'eqHi'
	if x > 4096 'gtHi'
		return 14
	end 'gtHi'
	if not (x < 4097) 'ltNext'
		return 15
	end 'ltNext'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4096
    arm64.bl base
    arm64.cmp x0, 4095
    arm64.cset x1, eq
    arm64.cbnz x1, eqLo
    arm64.b ifcont
  eqLo:
    arm64.movImm x0, 11
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x0, 4095
    arm64.cset x1, gt
    arm64.eor x1, x1, 1
    arm64.cbnz x1, gtLo
    arm64.b ifcont
  gtLo:
    arm64.movImm x0, 12
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x0, 4096
    arm64.cset x1, eq
    arm64.eor x1, x1, 1
    arm64.cbnz x1, eqHi
    arm64.b ifcont
  eqHi:
    arm64.movImm x0, 13
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x0, 4096
    arm64.cset x1, gt
    arm64.cbnz x1, gtHi
    arm64.b ifcont
  gtHi:
    arm64.movImm x0, 14
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 4097
    arm64.cmp x0, x16
    arm64.cset x0, lt
    arm64.eor x0, x0, 1
    arm64.cbnz x0, ltNext
    arm64.b ifcont
  ltNext:
    arm64.movImm x0, 15
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
