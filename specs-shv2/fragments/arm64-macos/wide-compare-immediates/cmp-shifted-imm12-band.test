// Test: cmp-shifted-imm12-band
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(16773120)
	if not (x == 16773120) 'eqTop'
		return 21
	end 'eqTop'
	if x > 16773120 'gtTop'
		return 22
	end 'gtTop'
	if not (x < 16777216) 'ltPair'
		return 23
	end 'ltPair'
	if x == 16777216 'eqPair'
		return 24
	end 'eqPair'
	let y = base(16777216)
	if not (y == 16777216) 'eqPairSelf'
		return 25
	end 'eqPairSelf'
	if not (y > 16773120) 'gtTopFromPair'
		return 26
	end 'gtTopFromPair'
	return 0
end 'main'
---
ExitCode: 0
---
func @base {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 16773120
    arm64.bl base
    arm64.cmp x0, 16773120
    arm64.cset x1, eq
    arm64.eor x1, x1, 1
    arm64.cbnz x1, eqTop
    arm64.b ifcont
  eqTop:
    arm64.movImm x0, 21
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x0, 16773120
    arm64.cset x1, gt
    arm64.cbnz x1, gtTop
    arm64.b ifcont
  gtTop:
    arm64.movImm x0, 22
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 16777216
    arm64.cmp x0, x16
    arm64.cset x1, lt
    arm64.eor x1, x1, 1
    arm64.cbnz x1, ltPair
    arm64.b ifcont
  ltPair:
    arm64.movImm x0, 23
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x16, 16777216
    arm64.cmp x0, x16
    arm64.cset x0, eq
    arm64.cbnz x0, eqPair
    arm64.b ifcont
  eqPair:
    arm64.movImm x0, 24
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 16777216
    arm64.bl base
    arm64.movImm x16, 16777216
    arm64.cmp x0, x16
    arm64.cset x1, eq
    arm64.eor x1, x1, 1
    arm64.cbnz x1, eqPairSelf
    arm64.b ifcont
  eqPairSelf:
    arm64.movImm x0, 25
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x0, 16773120
    arm64.cset x0, gt
    arm64.eor x0, x0, 1
    arm64.cbnz x0, gtTopFromPair
    arm64.b ifcont
  gtTopFromPair:
    arm64.movImm x0, 26
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
