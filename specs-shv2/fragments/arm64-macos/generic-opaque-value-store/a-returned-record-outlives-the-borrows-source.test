// Test: a-returned-record-outlives-the-borrows-source
typealias Integer = int(i64.min to i64.max)

type Box uses T
	let x as T
	let tag as Integer

	export function value() returns T
		return x
	end 'value'

	static function create(x T, tag Integer) returns Self
		return Self{x: x, tag: tag}
	end 'create'
end 'Box'

type Bag uses Element
	typealias EBox = Box with Element
	var seed as Integer

	export function wrap(x Element) returns EBox
		return EBox.create(x, tag: seed)
	end 'wrap'

	static function create() returns Self
		return Self{seed: 3}
	end 'create'
end 'Bag'

typealias StrBag = Bag with String
typealias StrBox = Box with String

function makeOne(b StrBag) returns StrBox
	var sb = StringBuilder.create()
	sb.append("a heap payload ")
	sb.append("long enough to allocate")
	let s = sb.build()
	return b.wrap(s)
end 'makeOne'

function main() returns ExitCode
	var b = StrBag.create()
	let boxed = makeOne(b)
	print("{boxed.value()}\n")
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.value {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Bag.wrap {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movRegReg x0, x2
    arm64.bl __retain_type_param
    arm64.movRegReg x1, x19
    arm64.bl Box.create
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @makeOne {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl StringBuilder.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x20
    arm64.bl StringBuilder.append
    arm64.leaRdata x1, __str_rec_4
    arm64.movRegReg x0, x20
    arm64.bl StringBuilder.append
    arm64.movRegReg x0, x20
    arm64.bl StringBuilder.build
    arm64.movRegReg x21, x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl Bag.wrap
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_StringBuilder
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x27
    arm64.storeSlotReg slot8, x26
    arm64.storeSlotReg slot7, x25
    arm64.storeSlotReg slot6, x24
    arm64.storeSlotReg slot5, x23
    arm64.storeSlotReg slot4, x22
    arm64.storeSlotReg slot3, x21
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 3
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.bl makeOne
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __layout_Box_String
    arm64.movRegReg x0, x19
    arm64.bl Box.value
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x21, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x20 + 8]
    arm64.leaRdata x0, __str_rec_5
    arm64.loadRegBaseDisp.word64 x23, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x24, [x0 + 8]
    arm64.add x25, x22, x24
    arm64.add x0, x25, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
    arm64.add x27, x26, 56
    arm64.movRegReg x0, x27
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x21, x27, x22
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x24
    arm64.bl __str_copy
    arm64.add x0, x21, x24
    arm64.storeBaseDispReg.word64 [x26 + 0], x27
    arm64.storeBaseDispReg.word64 [x26 + 8], x25
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x26 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x26 + 24], x0
    arm64.movRegReg x0, x26
    arm64.bl print
    arm64.movRegReg x0, x26
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Box_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.loadRegSlot x22, slot4
    arm64.loadRegSlot x23, slot5
    arm64.loadRegSlot x24, slot6
    arm64.loadRegSlot x25, slot7
    arm64.loadRegSlot x26, slot8
    arm64.loadRegSlot x27, slot9
    arm64.epilogue 96
    arm64.ret
}
