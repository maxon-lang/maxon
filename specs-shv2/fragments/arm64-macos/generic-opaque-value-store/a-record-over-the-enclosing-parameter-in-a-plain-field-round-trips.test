// Test: a-record-over-the-enclosing-parameter-in-a-plain-field-round-trips
typealias Integer = int(i64.min to i64.max)

type Box uses T
	export let x as T
	export let tag as Integer

	export function value() returns T
		return x
	end 'value'

	export static function create(x T, tag Integer) returns Self
		return Self{x: x, tag: tag}
	end 'create'
end 'Box'

type Bag uses Element
	typealias EBox = Box with Element
	let one as EBox

	export function first() returns Element
		return one.value()
	end 'first'

	static function create(x Element, tag Integer) returns Self
		return Self{one: EBox.create(x, tag: tag)}
	end 'create'
end 'Bag'

typealias StrBag = Bag with String

function fill() returns StrBag
	var sb = StringBuilder.create()
	sb.append("hello ")
	sb.append("heap world")
	let s = sb.build()
	return StrBag.create(s, tag: 7)
end 'fill'

function main() returns ExitCode
	let b = fill()
	print("{b.first()}\n")
	return 0 as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.value {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __retain_type_param
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Bag.first {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl Box.value
    arm64.epilogue 16
    arm64.ret
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x3, x0
    arm64.movRegReg x19, x1
    arm64.movRegReg x0, x2
    arm64.movRegReg x1, x3
    arm64.bl __retain_type_param
    arm64.movRegReg x1, x19
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @fill {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl StringBuilder.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x19
    arm64.bl StringBuilder.append
    arm64.leaRdata x1, __str_rec_4
    arm64.movRegReg x0, x19
    arm64.bl StringBuilder.append
    arm64.movRegReg x0, x19
    arm64.bl StringBuilder.build
    arm64.movRegReg x20, x0
    arm64.movImm x1, 7
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x20
    arm64.bl Bag.create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_StringBuilder
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
