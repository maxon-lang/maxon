    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x2, 1
    arm64.cset x2, eq
    arm64.cbnz x2, __im_byte
    arm64.b __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.cset x2, hs
    arm64.cbnz x2, __im_slow
    arm64.b __im_load#12
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, x1
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
    arm64.b __im_loaded
  __im_loaded:
    arm64.movImm x9, 0
    arm64.loadRegBaseDisp.word64 x3, [x0 + 40]
    arm64.cmp x3, 0
    arm64.cset x3, ne
    arm64.cbnz x3, __im_empty
    arm64.b critsplit#14
  __im_empty:
    arm64.cmp x2, 0
    arm64.cset x3, eq
    arm64.cbnz x3, __im_slow
    arm64.b critsplit#15
  critsplit#15:
    arm64.movRegReg x1, x2
