  __rc_ok:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.cset x3, eq
    arm64.cbnz x3, __im_word
    arm64.b __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.cset x2, hs
    arm64.cbnz x2, __im_slow
    arm64.b __im_load#11
  __im_load#11:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
