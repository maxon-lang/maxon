  tryerr:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __retain_type_param
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

