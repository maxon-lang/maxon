    arm64.storeSlotReg slot4, x21
    arm64.storeSlotReg slot3, x20
    arm64.storeSlotReg slot2, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 3
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __destruct_Box_String
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.storeSlotReg slot1, x21
    arm64.cmp x21, 100
