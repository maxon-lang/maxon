// Test: error.struct-to-string
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer

	export static function make() returns Self
		return Self{x: 1}
	end 'make'
end 'Point'

function main() returns ExitCode
	let p = Point.make()
	let bad = p as String
	return 0
end 'main'
---
CompilerError:
error E3009: <fragment>:14:14: Cannot cast from struct to String
