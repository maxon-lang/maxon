// Test: throwing-witness-managed-return-both-edges
typealias Payload = int(0 to u64.max)

type Chunk
	export var payload as Payload

	static function create(payload Payload) returns Chunk
		return Self{payload: payload}
	end 'create'
end 'Chunk'

// A boxed-union error (it carries a payload case) so the caught error is a heap
// box — exercising the `witnessTryCall` error-flag release.
union MakeError implements Error
	tooBig(limit Payload)
end 'MakeError'

interface ChunkMaker
	function makeChunk(seed Payload) returns Chunk throws MakeError
end 'ChunkMaker'

type Backend implements ChunkMaker
	export let cap as Payload

	static function create(cap Payload) returns Backend
		return Self{cap: cap}
	end 'create'

	function makeChunk(seed Payload) returns Chunk throws MakeError
		if seed > self.cap 'reject'
			throw MakeError.tooBig(self.cap)
		end 'reject'
		return Chunk.create(seed)
	end 'makeChunk'
end 'Backend'

// Returns the bare INTERFACE so `maker.makeChunk` dispatches through the witness
// table (a `witnessTryCall`, not a monomorphized direct call).
function obtainMaker(cap Payload) returns ChunkMaker
	return Backend.create(cap)
end 'obtainMaker'

function attempt(maker ChunkMaker, seed Payload, fallback Payload) returns Payload
	let chunk = try maker.makeChunk(seed) otherwise return fallback
	return chunk.payload
end 'attempt'

function main() returns ExitCode
	let maker = obtainMaker(100)
	print("{attempt(maker, seed: 42, fallback: 999)}\n")
	print("{attempt(maker, seed: 200, fallback: 7)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Chunk.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Backend.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Backend.makeChunk {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.cmp x1, x2
    arm64.cset x2, hi
    arm64.cbnz x2, reject
    arm64.b ifcont
  reject:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movRegReg x0, x1
    arm64.bl Chunk.create
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @obtainMaker {
  entry:
    arm64.prologue 16
    arm64.bl Backend.create
    arm64.leaRdata x9, __witness_Backend.ChunkMaker
    arm64.epilogue 16
    arm64.ret
}

func @attempt {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x2
    arm64.loadRegBaseDisp.word64 x16, [x3 + 24]
    arm64.blr x16
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 100
    arm64.bl obtainMaker
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x9
    arm64.movImm x1, 42
    arm64.movImm x2, 999
    arm64.movRegReg x0, x19
    arm64.movRegReg x3, x20
    arm64.bl attempt
    arm64.movRegReg x21, x0
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __uint_to_string
    arm64.movRegReg x21, x0
    arm64.leaRdata x0, __str_rec_1  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x23, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x24, [x0 + 8]
    arm64.add x25, x21, x24
    arm64.add x0, x25, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
