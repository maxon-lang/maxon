func @Character.hash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x2, 5381
    arm64.movImm x6, 0
    arm64.b header
  header:
    arm64.cmp x6, x0
    arm64.cset x7, ge
    arm64.cbnz x7, done
    arm64.b body
  done:
    arm64.movImm x0, 4294967295
    arm64.and x0, x2, x0
    arm64.epilogue 16
    arm64.ret
  body:
    arm64.add x7, x1, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.movImm x8, 33
    arm64.mul x2, x2, x8
    arm64.add x2, x2, x7
    arm64.movImm x7, 1
    arm64.add x6, x6, x7
    arm64.b header
}

func @Character.equals {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
