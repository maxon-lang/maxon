    arm64.loadRegBaseDisp.byte x8, [x8 + 0]
    arm64.movImm x9, 1
    arm64.add x6, x6, x9
    arm64.cmp x7, x8
    arm64.cset x7, eq
    arm64.cbnz x7, critsplit
    arm64.b notEqual
  critsplit:
    arm64.b cmphdr
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
