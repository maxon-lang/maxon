// Test: one-set-two-trims
function main() returns ExitCode
	let d = CharacterSet.decimalDigits()
	let mixed = "12a34"
	let head = mixed.trimStart(d)
	let tail = mixed.trimEnd(d)
	print("[{head}][{tail}]")
	return 0
end 'main'
