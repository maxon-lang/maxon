// Test: stdlib-user-shadows.user-enum-coexists-with-a-listed-modules-typealias
enum RepeatCount
	first = 1
	second = 7
end 'RepeatCount'

function main() returns ExitCode
	return RepeatCount.second.rawValue
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
