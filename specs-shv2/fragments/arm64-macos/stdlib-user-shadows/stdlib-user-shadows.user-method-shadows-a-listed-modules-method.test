// Test: stdlib-user-shadows.user-method-shadows-a-listed-modules-method
type Clock
	export var x as int

	export static function nowMs() returns ExitCode
		return 11
	end 'nowMs'
end 'Clock'

function main() returns ExitCode
	return Clock.nowMs()
end 'main'
---
ExitCode: 11
---
func @Clock.nowMs {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 11
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl Clock.nowMs
    arm64.epilogue 16
    arm64.ret
}
