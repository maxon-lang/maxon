// Test: reference-identity-is-never-promoted
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	let a = Point.create(1, y: 2)
	let b = Point.create(1, y: 2)
	let c = a
	var score = 0
	if a is b 'distinctRecordsAreNotIdentical'
		score = score + 1
	end 'distinctRecordsAreNotIdentical'
	if a is c 'anAliasIsIdentical'
		score = score + 40
	end 'anAliasIsIdentical'
	return score + 2
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl Point.create
    arm64.movImm x1, 0
    arm64.cmp x19, x0
    arm64.cset x2, eq
    arm64.cbnz x2, distinctRecordsAreNotIdentical
    arm64.b critsplit#8
  distinctRecordsAreNotIdentical:
    arm64.movImm x1, 1
    arm64.b ifcont#2
  critsplit#8:
    arm64.b ifcont#2
  ifcont#2:
    arm64.cmp x19, x19
    arm64.cset x2, eq
    arm64.cbnz x2, anAliasIsIdentical
    arm64.b critsplit#9
  anAliasIsIdentical:
    arm64.add x1, x1, 40
    arm64.b ifcont#4
  critsplit#9:
    arm64.b ifcont#4
  ifcont#4:
    arm64.add x20, x1, 2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
