// Test: promoted-record-in-a-loop-reuses-one-slot
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function main() returns ExitCode
	var total = 0
	for i in 0 upto 6 'each'
		let p = Point.create(i, y: i + 1)
		total = total + p.x + p.y
	end 'each'
	return total
end 'main'
---
ExitCode: 36
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 6
    arm64.cset x2, lt
    arm64.cbnz x2, each
    arm64.b forexit
  each:
    arm64.add x2, x1, 1
    arm64.leaRegSlot x3, slot0
    arm64.storeBaseDispReg.word64 [x3 + 0], x1
    arm64.storeBaseDispReg.word64 [x3 + 8], x2
    arm64.loadRegBaseDisp.word64 x2, [x3 + 0]
    arm64.add x0, x0, x2
    arm64.loadRegBaseDisp.word64 x2, [x3 + 8]
    arm64.add x0, x0, x2
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at promoted-record-in-a-loop-reuses-one-slot.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
