// Test: swap-bit-packed-bool-slots
typealias Flags = Array with bool

function main() returns ExitCode
	var flags = Flags.create()
	flags.push(true)
	flags.push(false)
	flags.push(false)
	try flags.managed.swap(0, j: 1) otherwise return 99
	let atZero = try flags.get(0) otherwise true
	let atOne = try flags.get(1) otherwise false
	var total = 0
	if atZero 'zero'
		total = total + 1
	end 'zero'
	if atOne 'one'
		total = total + 2
	end 'one'
	return total
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 18446744073709551615
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_mem_swap
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movImm x20, 1
    arm64.b trycont#5
  tryok#3:
    arm64.movRegReg x20, x0
    arm64.b trycont#5
  trycont#5:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#7
    arm64.b tryok#6
  tryerr#7:
    arm64.movImm x0, 0
    arm64.b trycont#8
  tryok#6:
    arm64.b trycont#8
  trycont#8:
    arm64.movImm x1, 0
    arm64.cbnz x20, zero
    arm64.b critsplit#16
  zero:
    arm64.movImm x1, 1
    arm64.b ifcont#10
  critsplit#16:
    arm64.b ifcont#10
  ifcont#10:
    arm64.cbnz x0, one
    arm64.b critsplit#17
  one:
    arm64.add x20, x1, 2
    arm64.b ifcont#12
  critsplit#17:
    arm64.movRegReg x20, x1
    arm64.b ifcont#12
  ifcont#12:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
