    arm64.movRegReg x19, x0
    arm64.movImm x1, 32
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 48
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride#15
  __im_word#13:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#12
  __im_load#17:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded#16
  __im_stride#15:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow#12
  __im_byte#14:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#12
  __im_load#18:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
  __im_loaded#16:
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq __im_cont#11
  __im_empty#19:
    arm64.cmp x0, 0
    arm64.b.ne __im_cont#11
  __im_slow#12:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x2, x9
  __im_cont#11:
    arm64.cmp x2, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.movImm x20, 99
    arm64.b trycont#3
  tryok:
    arm64.movRegReg x20, x0
  trycont#3:
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride#24
  __im_word#22:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow#21
  __im_load#26:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded#25
  __im_stride#24:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow#21
  __im_byte#23:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow#21
  __im_load#27:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 1
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
  __im_loaded#25:
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq __im_cont#20
  __im_empty#28:
    arm64.cmp x0, 0
    arm64.b.ne __im_cont#20
  __im_slow#21:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x2, x9
  __im_cont#20:
    arm64.cmp x2, 0
    arm64.b.eq trycont#6
  tryerr#5:
    arm64.movImm x0, 99
  trycont#6:
    arm64.cmp x20, 32
    arm64.movImm x1, 0
    arm64.b.ne critsplit
  andrhs:
    arm64.cmp x0, 48
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
