// Test: while-loops.sequential-loops-dead-phis
function work(x int) returns int
	return x + 1
end 'work'

function big(n int) returns int
	var total = 0
	var a0 = 1
	var a1 = 2
	var a2 = 3
	var a3 = 4
	var a4 = 5
	var a5 = 6
	var i0 = 0
	while i0 < n 'L0'
		let r = work(i0)
		a0 = a0 + r
		a1 = a1 + r
		a2 = a2 + r
		a3 = a3 + r
		a4 = a4 + r
		a5 = a5 + r
		i0 = i0 + 1
	end 'L0'
	total = total + a0 + a1 + a2 + a3 + a4 + a5
	var b0 = 1
	var b1 = 2
	var b2 = 3
	var b3 = 4
	var b4 = 5
	var b5 = 6
	var i1 = 0
	while i1 < n 'L1'
		let s = work(i1)
		b0 = b0 + s
		b1 = b1 + s
		b2 = b2 + s
		b3 = b3 + s
		b4 = b4 + s
		b5 = b5 + s
		i1 = i1 + 1
	end 'L1'
	total = total + b0 + b1 + b2 + b3 + b4 + b5
	return total
end 'big'

function main() returns ExitCode
	return big(3)
end 'main'
---
ExitCode: 114
---
func @work {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @big {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1
    arm64.movImm x21, 2
    arm64.movImm x22, 3
    arm64.movImm x23, 4
    arm64.movImm x24, 5
    arm64.movImm x25, 6
    arm64.movImm x26, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x26, x19
    arm64.cset x0, lt
    arm64.cbnz x0, L0
    arm64.b whileexit
  L0:
    arm64.movRegReg x0, x26
    arm64.bl work
    arm64.add x20, x20, x0
    arm64.add x21, x21, x0
    arm64.add x22, x22, x0
    arm64.add x23, x23, x0
    arm64.add x24, x24, x0
    arm64.add x25, x25, x0
    arm64.add x26, x26, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x20, 0
    arm64.add x0, x0, x21
    arm64.add x0, x0, x22
    arm64.add x0, x0, x23
    arm64.add x0, x0, x24
    arm64.add x20, x0, x25
    arm64.movImm x21, 1
    arm64.movImm x22, 2
    arm64.movImm x23, 3
    arm64.movImm x24, 4
    arm64.movImm x25, 5
    arm64.movImm x26, 6
    arm64.movImm x27, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x27, x19
    arm64.cset x0, lt
    arm64.cbnz x0, L1
    arm64.b whileexit
  L1:
    arm64.movRegReg x0, x27
    arm64.bl work
    arm64.add x21, x21, x0
    arm64.add x22, x22, x0
    arm64.add x23, x23, x0
    arm64.add x24, x24, x0
    arm64.add x25, x25, x0
    arm64.add x26, x26, x0
    arm64.add x27, x27, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x20, x21
    arm64.add x0, x0, x22
    arm64.add x0, x0, x23
    arm64.add x0, x0, x24
    arm64.add x0, x0, x25
    arm64.add x0, x0, x26
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.epilogue 96
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.bl big
    arm64.epilogue 16
    arm64.ret
}
