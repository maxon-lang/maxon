// Test: while-loops.loop-carried-var-narrower-than-its-update
function firstExit() returns ExitCode
	return 0
end 'firstExit'

function pick() returns ExitCode
	var r = firstExit()
	var i = 0
	while i < 3 'lp'
		r = i
		i = i + 1
	end 'lp'
	return r
end 'pick'

function main() returns ExitCode
	return pick()
end 'main'
---
ExitCode: 2
---
func @firstExit {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.bl firstExit
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, lp
    arm64.b whileexit
  lp:
    arm64.add x0, x1, 1
    arm64.xchgRegReg x0, x1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl pick
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
