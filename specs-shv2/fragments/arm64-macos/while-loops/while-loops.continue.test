// Test: while-loops.continue
function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 5 'loop'
		i = i + 1
		if i == 3 'skip'
			continue
		end 'skip'
		sum = sum + i
	end 'loop'
	return sum
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 5
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.add x1, x1, 1
    arm64.cmp x1, 3
    arm64.cset x2, eq
    arm64.cbnz x2, skip
    arm64.b ifcont
  skip:
    arm64.b whilehdr
  ifcont:
    arm64.add x0, x0, x1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
}
