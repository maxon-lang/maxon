// Test: while-loops.sequential-loops
function big(n int) returns int
	var i0 = 0
	while i0 < n 'L0'
		i0 = i0 + 1
	end 'L0'
	var i1 = 0
	while i1 < n 'L1'
		i1 = i1 + 1
	end 'L1'
	return i0 + i1
end 'big'

function main() returns ExitCode
	return big(3)
end 'main'
---
ExitCode: 6
---
func @big {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, x0
    arm64.cset x2, lt
    arm64.cbnz x2, L0
    arm64.b whileexit
  L0:
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x2, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x2, x0
    arm64.cset x6, lt
    arm64.cbnz x6, L1
    arm64.b whileexit
  L1:
    arm64.add x2, x2, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x1, x2
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.bl big
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
