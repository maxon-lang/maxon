// Test: list-of-structs-from-literal
typealias Integer = int(i64.min to i64.max)

type Vec2
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Vec2'

function main() returns ExitCode
	let list = List from [Vec2.create(1, y: 2), Vec2.create(3, y: 4), Vec2.create(5, y: 6)]
	for item in list 'loop'
		print("{item.x},{item.y}\n")
	end 'loop'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Vec2.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 128
    arm64.storeSlotReg slot13, x28
    arm64.storeSlotReg slot12, x27
    arm64.storeSlotReg slot11, x26
    arm64.storeSlotReg slot10, x25
    arm64.storeSlotReg slot9, x24
    arm64.storeSlotReg slot8, x23
    arm64.storeSlotReg slot7, x22
    arm64.storeSlotReg slot6, x21
    arm64.storeSlotReg slot5, x20
    arm64.storeSlotReg slot4, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl Vec2.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __managed_push
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.bl Vec2.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x0, 5
    arm64.movImm x1, 6
    arm64.bl Vec2.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __list_from
    arm64.movRegReg x19, x0
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __list_head
    arm64.b forhdr
  forhdr:
    arm64.storeSlotReg slot1, x0
    arm64.cmp x0, 0
    arm64.cset x1, ne
    arm64.cbnz x1, loop
    arm64.b forexit
  loop:
    arm64.bl __list_node_value
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeSlotReg slot2, x21
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __int_to_string
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __str_rec_1
    arm64.loadRegBaseDisp.word64 x22, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x23, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_3
    arm64.loadRegBaseDisp.word64 x25, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x26, [x0 + 8]
    arm64.add x0, x20, x23
    arm64.add x0, x0, x19
    arm64.add x0, x0, x26
    arm64.storeSlotReg slot3, x0
    arm64.add x0, x0, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
    arm64.add x28, x27, 48
    arm64.movRegReg x0, x28
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x20, x28, x20
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl __str_copy
    arm64.add x20, x20, x23
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x19, x20, x19
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x25
    arm64.movRegReg x2, x26
    arm64.bl __str_copy
    arm64.add x0, x19, x26
    arm64.storeBaseDispReg.word64 [x27 + 0], x28
    arm64.loadRegSlot x0, slot3
    arm64.storeBaseDispReg.word64 [x27 + 8], x0
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x27 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x27 + 24], x0
    arm64.loadRegSlot x0, slot2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x24
    arm64.bl __mm_decref
    arm64.movRegReg x0, x27
    arm64.bl __print_string
    arm64.movRegReg x0, x27
    arm64.bl __str_decref
    arm64.b forstep
  forstep:
    arm64.loadRegSlot x0, slot1
    arm64.bl __list_node_next
    arm64.b forhdr
  forexit:
    arm64.movImm x19, 0
    arm64.loadRegSlot x0, slot0
    arm64.bl __list_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot4
    arm64.loadRegSlot x20, slot5
    arm64.loadRegSlot x21, slot6
    arm64.loadRegSlot x22, slot7
    arm64.loadRegSlot x23, slot8
    arm64.loadRegSlot x24, slot9
    arm64.loadRegSlot x25, slot10
    arm64.loadRegSlot x26, slot11
    arm64.loadRegSlot x27, slot12
    arm64.loadRegSlot x28, slot13
    arm64.epilogue 128
    arm64.ret
}
