// Test: int-division-preserves-other-values
function main() returns ExitCode
	let x = 10
	let a = 84
	let b = 2
	let quotient = a / b
	return quotient - x
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 84
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, 84
    arm64.asr x0, x0, 1
    arm64.sub x0, x0, 10
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-division-preserves-other-values.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
