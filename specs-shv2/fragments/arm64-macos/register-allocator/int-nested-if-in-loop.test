// Test: int-nested-if-in-loop
function main() returns ExitCode
	var result = 0
	var i = 1
	while i <= 10 'loop'
		if i <= 5 'first'
			result = result + i
		end 'first' else 'second'
			result = result + i * 2
		end 'second'
		i = i + 1
	end 'loop'
	return result mod 256
end 'main'
---
ExitCode: 95
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 10
    arm64.cset x2, le
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.cmp x1, 5
    arm64.cset x2, le
    arm64.cbnz x2, first
    arm64.b ifelse
  first:
    arm64.add x0, x0, x1
    arm64.b ifcont
  ifelse:
    arm64.arm64AddLsl x0, x0, x1, lsl #1
    arm64.b ifcont
  ifcont:
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 256
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-nested-if-in-loop.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
