// Test: int-sequential-divisions
function main() returns ExitCode
	let a = 100
	let b = 5
	let c = 84
	let d = 4
	return a / b + c / d
end 'main'
---
ExitCode: 41
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 5
    arm64.movImm x2, 84
    arm64.movImm x3, 4
    arm64.sdiv x0, x0, x1
    arm64.sdiv x1, x2, x3
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
