// Test: int-sequential-divisions
function main() returns ExitCode
	let a = 100
	let b = 5
	let c = 84
	let d = 4
	return a / b + c / d
end 'main'
---
ExitCode: 41
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 84
    arm64.movImm x2, 7378697629483820647
    arm64.smulh x0, x2, x0
    arm64.asr x0, x0, 1
    arm64.lsr x2, x0, 63
    arm64.add x0, x0, x2
    arm64.asr x1, x1, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 84
    arm64.asr x1, x1, 2
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-sequential-divisions.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
