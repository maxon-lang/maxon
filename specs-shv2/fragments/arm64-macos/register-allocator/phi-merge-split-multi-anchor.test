// Test: phi-merge-split-multi-anchor
function main() returns ExitCode
	var a = 0
	var b = 0
	var c = 0
	var d = 0
	if 1 < 2 'g1'
		a = 1
		b = 2
		c = 3
		d = 4
	end 'g1' else 'g1e'
		a = 10
		b = 20
		c = 30
		d = 40
	end 'g1e'
	if a > 0 'g2'
		a = a + 100
		c = c + 100
	end 'g2' else 'g2e'
		b = b + 100
		d = d + 100
	end 'g2e'
	if b > 0 'g3'
		a = a + b
		c = c + d
	end 'g3' else 'g3e'
		b = a - 1
		d = c - 1
	end 'g3e'
	return (a + b + c + d) and 125
end 'main'
---
ExitCode: 88
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b g1
  g1:
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x3, 4
    arm64.b ifcont#3
  ifcont#3:
    arm64.cmp x0, 0
    arm64.cset x4, gt
    arm64.cbnz x4, g2
    arm64.b ifelse#5
  g2:
    arm64.add x0, x0, 100
    arm64.add x2, x2, 100
    arm64.b ifcont#6
  ifelse#5:
    arm64.add x1, x1, 100
    arm64.add x3, x3, 100
    arm64.b ifcont#6
  ifcont#6:
    arm64.cmp x1, 0
    arm64.cset x4, gt
    arm64.cbnz x4, g3
    arm64.b ifelse#8
  g3:
    arm64.add x0, x0, x1
    arm64.add x2, x2, x3
    arm64.b ifcont#9
  ifelse#8:
    arm64.sub x1, x0, 1
    arm64.sub x3, x2, 1
    arm64.b ifcont#9
  ifcont#9:
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x3
    arm64.movImm x16, 125
    arm64.and x0, x0, x16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at phi-merge-split-multi-anchor.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
