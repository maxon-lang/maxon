// Test: int-loop-pressure-with-call

typealias Integer = int(i64.min to i64.max)

function identity(x Integer) returns Integer
	return x
end 'identity'

function main() returns ExitCode
	var a = 1
	let b = 2
	var c = 3
	let d = 4
	var e = 5
	let f = 6
	var i = 0
	while i < 3 'loop'
		a = a + identity(b)
		c = c + identity(d)
		e = e + identity(f)
		i = i + 1
	end 'loop'
	return (a + c + d + e + f) mod 256
end 'main'
---
ExitCode: 55
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 3
    arm64.movImm x2, 5
    arm64.movImm x3, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x3, 3
    arm64.cset x4, lt
    arm64.cbnz x4, loop
    arm64.b whileexit
  loop:
    arm64.b __il_body#10
  __il_body#10:
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.add x0, x0, 2
    arm64.b __il_body#11
  __il_body#11:
    arm64.b __il_cont#8
  __il_cont#8:
    arm64.add x1, x1, 4
    arm64.b __il_body#12
  __il_body#12:
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.add x2, x2, 6
    arm64.add x3, x3, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x0, x1
    arm64.add x0, x0, 4
    arm64.add x0, x0, x2
    arm64.add x0, x0, 6
    arm64.movImm x1, 256
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
