// Test: int-loop-pressure-with-call

typealias Integer = int(i64.min to i64.max)

function identity(x Integer) returns Integer
	return x
end 'identity'

function main() returns ExitCode
	var a = 1
	let b = 2
	var c = 3
	let d = 4
	var e = 5
	let f = 6
	var i = 0
	while i < 3 'loop'
		a = a + identity(b)
		c = c + identity(d)
		e = e + identity(f)
		i = i + 1
	end 'loop'
	return (a + c + d + e + f) mod 256
end 'main'
---
ExitCode: 55
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 3
    arm64.movImm x2, 5
    arm64.movImm x3, 0
  whilehdr:
    arm64.cmp x3, 3
    arm64.b.ge whileexit
  __il_cont#9:
    arm64.add x0, x0, 2
  __il_cont#8:
    arm64.add x1, x1, 4
  __il_cont#7:
    arm64.add x2, x2, 6
    arm64.add x3, x3, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x0, x1
    arm64.add x0, x0, 4
    arm64.add x0, x0, x2
    arm64.add x0, x0, 6
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 56
    arm64.add x1, x0, x1
    arm64.asr x1, x1, 8
    arm64.lsl x1, x1, 8
    arm64.sub x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-loop-pressure-with-call.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
