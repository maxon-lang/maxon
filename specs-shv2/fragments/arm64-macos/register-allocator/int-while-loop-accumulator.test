// Test: int-while-loop-accumulator
function main() returns ExitCode
	var sum = 0
	var i = 0
	while i < 10 'loop'
		sum = sum + i
		i = i + 1
	end 'loop'
	return sum mod 256
end 'main'
---
ExitCode: 45
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 10
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.add x0, x0, x1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 256
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-while-loop-accumulator.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
