// Test: match-statement-or-patterns
function main() returns ExitCode
	let x = 3
	match x 'check'
		1 or 2 then return 10
		3 or 4 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.jumpTable x0, default=matchdefault [[0..1]=matcharm#1, [2..3]=matcharm#2] @__jumptable_0
  matchdefault:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matcharm#1:
    arm64.movImm x0, 10
    arm64.epilogue 16
    arm64.ret
  matcharm#2:
    arm64.movImm x0, 20
    arm64.epilogue 16
    arm64.ret
  matchcont:
}
