// Test: where-clauses.float-formal-among-int-formals
typealias Coord = int(0 to 1000)

interface Mixed
	function combine(a int, k float, b int) returns float
end 'Mixed'

type Point implements Mixed
	export var x as Coord
	export static function create(x Coord) returns Self
		return Self{ x: x }
	end 'create'
	export function combine(a int, k float, b int) returns float
		return k + (a as float) + (b as float)
	end 'combine'
end 'Point'

type Box uses T where T is Mixed
	export var item as T
	export static function create(item T) returns Self
		return Self{ item: item }
	end 'create'
	export function go() returns float
		return self.item.combine(1, k: 3, b: 5)
	end 'go'
end 'Box'

typealias PointBox = Box with Point

function main() returns ExitCode
	let b = PointBox.create(Point.create(7))
	if b.go() == 9.0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Point.combine {
  entry:
    arm64.prologue 16
    arm64.scvtf d1, x1
    arm64.fadd d0, d0, d1
    arm64.scvtf d1, x2
    arm64.fadd d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.go {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 1
    arm64.movImm x2, 3
    arm64.movImm x7, 5
    arm64.scvtf d0, x2
    arm64.movRegReg x2, x7
    arm64.loadRegBaseDisp.word64 x16, [x6 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 7
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.bl Box.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.leaRdata x1, __witness_Point.Mixed
    arm64.movRegReg x0, x20
    arm64.bl Box.go
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Box_Point
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Box_Point
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
