  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Adder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Adder.total {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.b forhdr
  forhdr:
    arm64.cmp x2, x3
    arm64.cset x4, lt
    arm64.cbnz x4, each
    arm64.b forexit
  each:
    arm64.arm64AddLsl x4, x1, x2, lsl #3
    arm64.loadRegBaseDisp.word64 x4, [x4 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.add x0, x0, x4
    arm64.b forstep
  forstep:
    arm64.add x2, x2, 1
    arm64.b forhdr
  forexit:
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.run {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
