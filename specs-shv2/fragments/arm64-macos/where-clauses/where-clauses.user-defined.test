// Test: where-clauses.user-defined

typealias Integer = int(i64.min to i64.max)

interface Valuable
		function value() returns Integer
end 'Valuable'

type Wrapper implements Valuable
		let n as Integer

		function value() returns Integer
				return self.n
		end 'value'

		static function create(n Integer) returns Self
			return Self{n: n}
		end 'create'
end 'Wrapper'

type Holder uses T where T is Valuable
		export var item as T

		static function create(item T) returns Self
			return Self{item: item}
		end 'create'
end 'Holder'

typealias WrapperHolder = Holder with Wrapper

function main() returns ExitCode
		let w = Wrapper.create(10)
		let h = WrapperHolder.create(w)
		return h.item.value()
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Wrapper.value {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Wrapper.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 10
    arm64.bl Wrapper.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.leaRdata x1, __witness_Wrapper.Valuable
    arm64.movRegReg x0, x19
    arm64.bl Holder.create
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x1 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.bl __destruct_Holder_Wrapper
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
