// Test: managed-string-heap-string-generates-cleanup
function main() returns ExitCode
	let s = "this is a heap allocated string!"
	return s.byteLength()
end 'main'
---
ExitCode: 32
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __il_slow
    arm64.b __rc_ok#6
  __il_slow:
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok#6:
    arm64.movRegReg x0, x1
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.epilogue 16
    arm64.ret
}
