// Test: i32-signed-div
typealias Temp = int(-100000 to 100000)

function main() returns ExitCode
	let a = 20 as Temp
	let b = 3 as Temp
	return a / b
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 3
    arm64.sdiv x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
