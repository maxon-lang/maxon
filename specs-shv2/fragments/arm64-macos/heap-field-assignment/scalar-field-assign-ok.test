// Test: scalar-field-assign-ok
typealias Tally = int(0 to u64.max)

type Counter
	var count as Tally

	export function increment()
		count = count + 1
	end 'increment'

	export function value() returns Tally
		return count
	end 'value'

	static function create(count Tally) returns Self
		return Self{count: count}
	end 'create'
end 'Counter'

function main() returns ExitCode
	var c = Counter.create(0)
	c.increment()
	c.increment()
	return c.value()
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 0
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_body#7
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#6
  __il_cont#6:
    arm64.b __il_body#8
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#9
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
