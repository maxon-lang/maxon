// Test: char-literal-ne-codepoint
function main() returns ExitCode
	let cp = 45
	if cp != '.' 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 45
    arm64.cmp x0, 46
    arm64.cset x0, ne
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
