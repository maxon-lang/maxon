// Test: mutating-callee-argument
typealias StringArray = Array with String

function grow(dest StringArray)
	dest.clear()
end 'grow'

function main() returns ExitCode
	var arr = ["hello world this is a long string for heap allocation"]
	let s = try arr.get(0) otherwise ""
	grow(arr)
	print("[{s}]\n")
	return 0
end 'main'
---
CompilerError:
error E3070: <fragment>:11:2: cannot mutate 'arr' via 'grow' while it is borrowed by 's' (borrowed at line 10)
