    arm64.add x1, x1, x25
    arm64.add x1, x1, x20
    arm64.add x0, x1, x0
    arm64.storeSlotReg slot1, x0
    arm64.add x0, x0, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeSlotReg slot2, x0
    arm64.add x28, x0, 48
    arm64.movRegReg x0, x28
