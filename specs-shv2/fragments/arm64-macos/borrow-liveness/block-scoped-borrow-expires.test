    arm64.loadRegBaseDisp.word64 x23, [x0 + 8]
    arm64.add x24, x19, x23
    arm64.add x0, x24, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x25, x0
