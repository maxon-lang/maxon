// Test: a-signed-power-of-two-truncates-toward-zero
typealias Word = int(i64.min to i64.max)

function main() returns ExitCode
	if -7 / 2 != -3 'minusSevenHalved'
		return 1
	end 'minusSevenHalved'
	if -1 / 2 != 0 'minusOneHalved'
		return 2
	end 'minusOneHalved'
	if -9 / 8 != -1 'minusNineEighthed'
		return 3
	end 'minusNineEighthed'
	if -7 mod 2 != -1 'remainderTakesTheDividendSign'
		return 4
	end 'remainderTakesTheDividendSign'
	let n = i64.min as Word
	if n / 2 != -4611686018427387904 'minHalved'
		return 5
	end 'minHalved'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 18446744073709551609
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, -7
    arm64.asr x0, x0, 1
    arm64.cmp x0, -3
    arm64.b.eq ifcont#2
  minusSevenHalved:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 18446744073709551615
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 63
    arm64.add x0, x0, -1
    arm64.asr x0, x0, 1
    arm64.cmp x0, 0
    arm64.b.eq ifcont#4
  minusOneHalved:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 18446744073709551607
    arm64.asr x0, x0, 63
    arm64.lsr x0, x0, 61
    arm64.add x0, x0, -9
    arm64.asr x0, x0, 3
    arm64.cmp x0, -1
    arm64.b.eq ifcont#6
  minusNineEighthed:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 18446744073709551609
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 63
    arm64.add x1, x1, -7
    arm64.asr x1, x1, 1
    arm64.movImm x16, 2
    arm64.mul x1, x1, x16
    arm64.sub x0, x0, x1
    arm64.cmp x0, -1
    arm64.b.eq ifcont#8
  remainderTakesTheDividendSign:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 9223372036854775808
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 63
    arm64.add x0, x0, x1
    arm64.asr x0, x0, 1
    arm64.movImm x1, 13835058055282163712
    arm64.cmp x0, x1
    arm64.b.eq ifcont#10
  minHalved:
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
  ifcont#10:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
