    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.movImm x0, 2
    arm64.udiv x22, x21, x0
    arm64.movImm x1, 2
    arm64.movRegReg x0, x21
