  ifcont#12:
    arm64.movImm x0, 10
    arm64.udiv x22, x21, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x21
    arm64.bl refUDiv
    arm64.cmp x22, x0
    arm64.cset x0, ne
    arm64.cbnz x0, divTenIsRefused
    arm64.b ifcont#14
  divTenIsRefused:
    arm64.movImm x20, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont#14:
    arm64.b forstep
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
