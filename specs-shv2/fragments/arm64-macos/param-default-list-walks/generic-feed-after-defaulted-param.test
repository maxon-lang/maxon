// Test: generic-feed-after-defaulted-param
typealias Integer = int(i64.min to i64.max)

type Box uses T
	export var item as T

	static function create(_ Integer = 1, item T) returns Self
		return Self{item: item}
	end 'create'
end 'Box'

typealias StrBox = Box with String

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 50 'loop'
		let s = "hello!"
		let b = StrBox.create(2, item: s)
		total = 6
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 6
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.movImm x19, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x19, 50
    arm64.cset x1, lt
    arm64.cbnz x1, loop
    arm64.b whileexit
  loop:
    arm64.leaRdata x0, __str_rec_1
    arm64.movImm x20, 2
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x0, x22, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 48
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x24, x22
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x22
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.bl Box.create
    arm64.movImm x20, 6
    arm64.add x19, x19, 1
    arm64.bl __destruct_Box_String
    arm64.movRegReg x0, x20
    arm64.b whilehdr
  whileexit:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
