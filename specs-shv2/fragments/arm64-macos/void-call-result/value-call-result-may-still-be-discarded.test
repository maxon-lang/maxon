// Test: value-call-result-may-still-be-discarded
typealias Integer = int(i64.min to i64.max)

function answer() returns Integer
	return 42
end 'answer'

function main() returns ExitCode
	answer()
	return 42
end 'main'
---
ExitCode: 42
---
func @answer {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl answer
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
