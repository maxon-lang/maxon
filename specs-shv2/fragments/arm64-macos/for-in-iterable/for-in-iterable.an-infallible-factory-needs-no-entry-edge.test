// Test: for-in-iterable.an-infallible-factory-needs-no-entry-edge
typealias Integer = int(i64.min to i64.max)

type Countdown
	var n as Integer

	export static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'

	export function current() returns Integer
		return self.n
	end 'current'

	export function advance() throws IterationError
		if self.n <= 1 'done'
			throw IterationError.exhausted
		end 'done'
		self.n = self.n - 1
	end 'advance'
end 'Countdown'

type Countable
	var start as Integer

	export static function create(start Integer) returns Self
		return Self{start: start}
	end 'create'

	export function createIterator() returns Countdown
		return Countdown.create(self.start)
	end 'createIterator'
end 'Countable'

function main() returns ExitCode
	let c = Countable.create(4)
	var sum = 0
	for v in c 'each'
		sum = sum + v
	end 'each'
	return sum
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Countdown.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Countdown.advance {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 1
    arm64.cset x1, le
    arm64.cbnz x1, done
    arm64.b ifcont
  done:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.sub x1, x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @Countable.createIterator {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl Countdown.create
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 4
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x19, 0
    arm64.movRegReg x0, x1
    arm64.bl Countable.createIterator
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, each
    arm64.b forexit
  each:
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.add x19, x19, x0
    arm64.b forstep
  forstep:
    arm64.movRegReg x0, x20
    arm64.bl Countdown.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b forjoin
  forjoin:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
