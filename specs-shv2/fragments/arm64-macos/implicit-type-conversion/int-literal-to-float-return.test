// Test: int-literal-to-float-return

typealias Float = float(f64.min to f64.max)

function widen() returns Float
	return 3
end 'widen'

function main() returns ExitCode
	return trunc(widen() * 14.0)
end 'main'
---
ExitCode: 42
---
func @widen {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.scvtf d0, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl widen
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fmul d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
