// Test: int-literal-to-float-field-write
type Reading
	export var value as float = 0.0

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Reading'

function main() returns ExitCode
	var r = Reading.make()
	r.value = 3
	if r.value == 3.0 'exact'
		return trunc(r.value * 14.0)
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Reading.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, d8
    arm64.fpLoadRdata d8, [rdata + __fconst_0]
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], d8
    arm64.loadRegSlot d8, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Reading.make
    arm64.movImm x1, 3
    arm64.scvtf d0, x1
    arm64.storeBaseDispReg.word64 [x0 + 0], d0
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x1, eq
    arm64.cbnz x1, exact
    arm64.b ifcont
  exact:
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fmul d0, d0, d1
    arm64.fcvtzs x19, d0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 7
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
