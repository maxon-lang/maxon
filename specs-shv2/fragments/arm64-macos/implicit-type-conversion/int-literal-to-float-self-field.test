// Test: int-literal-to-float-self-field
type Reading
	export var value as float = 0.0

	export function bump() returns int
		value = 3
		return 0
	end 'bump'

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Reading'

function main() returns ExitCode
	var r = Reading.make()
	let done = r.bump()
	if r.value == 3.0 'exact'
		return trunc(r.value * 14.0) + done
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Reading.bump {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 3
    arm64.scvtf d0, x1
    arm64.storeBaseDispReg.word64 [x0 + 0], d0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @Reading.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, d8
    arm64.fpLoadRdata d8, [rdata + __fconst_1]
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], d8
    arm64.loadRegSlot d8, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Reading.make
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Reading.bump
    arm64.loadRegBaseDisp.word64 d0, [x19 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fcmp d0, d1
    arm64.cset x1, eq
    arm64.cbnz x1, exact
    arm64.b ifcont
  exact:
    arm64.loadRegBaseDisp.word64 d0, [x19 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_3]
    arm64.fmul d0, d0, d1
    arm64.fcvtzs x1, d0
    arm64.add x20, x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 7
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
