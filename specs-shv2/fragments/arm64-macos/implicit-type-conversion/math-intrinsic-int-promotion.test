// Test: math-intrinsic-int-promotion
function main() returns ExitCode
	let result = sqrt(16)
	return trunc(result)
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
