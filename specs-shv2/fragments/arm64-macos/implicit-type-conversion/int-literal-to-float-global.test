// Test: int-literal-to-float-global
var scale = 0.0

function main() returns ExitCode
	scale = 3
	if scale == 3.0 'exact'
		return trunc(scale * 14.0)
	end 'exact'
	return 7
end 'main'
---
ExitCode: 42
---
data {
  __data_scale@0 = f64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.scvtf d0, x0
    arm64.leaGlobal x0, __data_scale
    arm64.storeBaseDispReg.word64 [x0 + 0], d0
    arm64.leaGlobal x0, __data_scale
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, exact
    arm64.b ifcont
  exact:
    arm64.leaGlobal x0, __data_scale
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fmul d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
