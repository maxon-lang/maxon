// Test: float-to-int-field-default-rejected
type Reading
	export var value as Integer = 3.7

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Reading'

function main() returns ExitCode
	let r = Reading.make()
	return r.value
end 'main'
typealias Integer = int(i64.min to i64.max)
