// Test: arm-throws.expression-not-hit
typealias Integer = int(i64.min to i64.max)

enum E
	bad
end 'E'

function pick(x Integer) returns ExitCode throws E
	let result = match x 'eval'
		1 throws E.bad
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'pick'

function main() returns ExitCode
	let r = try pick(2) otherwise 99
	return r
end 'main'
---
ExitCode: 20
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 2
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.movImm x0, 20
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdefault
  matcharm#3:
    arm64.movImm x0, 30
    arm64.b matchcont
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.movImm x9, 0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.bl pick
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 99
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}
