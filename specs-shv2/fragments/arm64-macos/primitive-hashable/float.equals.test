// Test: float.equals
function main() returns ExitCode
	let a = 3.14
	let b = 3.14
	if a.equals(b) 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.bl float.equals
    arm64.cbnz x0, eq
    arm64.b ifcont
  eq:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @float.equals {
  entry:
    arm64.prologue 16
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, equal
    arm64.b notEqual
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
