// Test: float.hash.zero-normalization
function main() returns ExitCode
	let pos = 0.0
	let neg = -0.0
	let h1 = pos.hash()
	let h2 = neg.hash()
	if h1 == h2 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, d8
    arm64.storeSlotReg slot0, x19
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d8, [rdata + __fconst_1]
    arm64.bl float.hash
    arm64.movRegReg x19, x0
    arm64.movRegReg d0, d8
    arm64.bl float.hash
    arm64.cmp x19, x0
    arm64.cset x0, eq
    arm64.cbnz x0, eq
    arm64.b ifcont
  eq:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.epilogue 32
    arm64.ret
}

func @float.hash {
  entry:
    arm64.prologue 16
    arm64.fmov x0, d0
    arm64.movImm x1, 4294967295
    arm64.and x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
