// Test: float.hash.zero-normalization
function main() returns ExitCode
	let pos = 0.0
	let neg = -0.0
	let h1 = pos.hash()
	let h2 = neg.hash()
	if h1 == h2 'eq'
		return 1
	end 'eq'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#5
  __il_body#5:
    arm64.b ifcont#7
  ifcont#7:
    arm64.movImm x0, 0
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.b __il_body#11
  __il_body#11:
    arm64.b negzero
  negzero:
    arm64.movImm x1, 0
    arm64.b __il_cont#3
  __il_cont#3:
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.cbnz x0, eq
    arm64.b ifcont#2
  eq:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
