// Test: int.hash
function main() returns ExitCode
	let i = 42
	let h = i.hash()
	return h
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.bl int.hash
    arm64.epilogue 16
    arm64.ret
}

func @int.hash {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 4294967295
    arm64.and x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
