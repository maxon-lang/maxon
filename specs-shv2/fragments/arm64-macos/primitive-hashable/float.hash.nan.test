// Test: float.hash.nan
function main() returns ExitCode
	let inf = 1.0e308 * 10.0
	let nan = inf - inf
	let h = nan.hash()
	if nan.equals(nan) 'ieeeEquals'
		return 1
	end 'ieeeEquals'
	if h != 0 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, d8
    arm64.storeSlotReg slot0, x19
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fmul d0, d0, d1
    arm64.fsub d8, d0, d0
    arm64.movRegReg d0, d8
    arm64.bl float.hash
    arm64.movRegReg x19, x0
    arm64.movRegReg d0, d8
    arm64.movRegReg d1, d8
    arm64.bl float.equals
    arm64.cbnz x0, ieeeEquals
    arm64.b ifcont
  ieeeEquals:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.cmp x19, 0
    arm64.cset x0, ne
    arm64.cbnz x0, pinned
    arm64.b ifcont
  pinned:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot d8, slot1
    arm64.epilogue 32
    arm64.ret
}

func @float.hash {
  entry:
    arm64.prologue 16
    arm64.fmov x0, d0
    arm64.movImm x1, 4294967295
    arm64.and x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @float.equals {
  entry:
    arm64.prologue 16
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, equal
    arm64.b notEqual
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
