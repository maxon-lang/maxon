// Test: stdlib-loading.ascii-classifiers-from-stdlib
function main() returns ExitCode
	if Ascii.isDigit('7') 'digit'
		print("digit\n")
	end 'digit'
	if Ascii.isAlpha('q') 'alpha'
		print("alpha\n")
	end 'alpha'
	if Ascii.isAlphanumeric('Z') 'alnum'
		print("alnum\n")
	end 'alnum'
	if Ascii.isWhitespace('\t') 'tab'
		print("tab\n")
	end 'tab'
	if Ascii.isUpper('K') 'upper'
		print("upper\n")
	end 'upper'
	if Ascii.isLower('k') 'lower'
		print("lower\n")
	end 'lower'
	if Ascii.isDigit('x') 'notDigit'
		print("UNREACHED-notDigit\n")
	end 'notDigit'
	if Ascii.isUpper('k') 'notUpper'
		print("UNREACHED-notUpper\n")
	end 'notUpper'
	if Ascii.isAlpha('é') 'notAscii'
		print("UNREACHED-notAscii\n")
	end 'notAscii'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_25  ; "7"
    arm64.bl Ascii.isDigit
    arm64.cbnz x0, digit
    arm64.b ifcont#2
  digit:
    arm64.leaRdata x0, __str_rec_26  ; "digit\x0a"
    arm64.bl print
    arm64.b ifcont#2
  ifcont#2:
    arm64.leaRdata x0, __str_rec_27  ; "q"
    arm64.bl Ascii.isAlpha
    arm64.cbnz x0, alpha
    arm64.b ifcont#4
  alpha:
    arm64.leaRdata x0, __str_rec_28  ; "alpha\x0a"
    arm64.bl print
    arm64.b ifcont#4
  ifcont#4:
    arm64.leaRdata x0, __str_rec_29  ; "Z"
    arm64.bl Ascii.isAlphanumeric
    arm64.cbnz x0, alnum
    arm64.b ifcont#6
  alnum:
    arm64.leaRdata x0, __str_rec_30  ; "alnum\x0a"
    arm64.bl print
    arm64.b ifcont#6
  ifcont#6:
    arm64.leaRdata x0, __str_rec_31  ; "\x09"
    arm64.bl Ascii.isWhitespace
    arm64.cbnz x0, tab
    arm64.b ifcont#8
  tab:
    arm64.leaRdata x0, __str_rec_32  ; "tab\x0a"
    arm64.bl print
    arm64.b ifcont#8
  ifcont#8:
    arm64.leaRdata x0, __str_rec_33  ; "K"
    arm64.bl Ascii.isUpper
    arm64.cbnz x0, upper
    arm64.b ifcont#10
  upper:
    arm64.leaRdata x0, __str_rec_34  ; "upper\x0a"
    arm64.bl print
    arm64.b ifcont#10
  ifcont#10:
    arm64.leaRdata x0, __str_rec_35  ; "k"
    arm64.bl Ascii.isLower
    arm64.cbnz x0, lower
    arm64.b ifcont#12
  lower:
    arm64.leaRdata x0, __str_rec_36  ; "lower\x0a"
    arm64.bl print
    arm64.b ifcont#12
  ifcont#12:
    arm64.leaRdata x0, __str_rec_37  ; "x"
    arm64.bl Ascii.isDigit
    arm64.cbnz x0, notDigit
    arm64.b ifcont#14
  notDigit:
    arm64.leaRdata x0, __str_rec_38  ; "UNREACHED-notDigit\x0a"
    arm64.bl print
    arm64.b ifcont#14
  ifcont#14:
    arm64.leaRdata x0, __str_rec_35  ; "k"
    arm64.bl Ascii.isUpper
    arm64.cbnz x0, notUpper
    arm64.b ifcont#16
  notUpper:
    arm64.leaRdata x0, __str_rec_39  ; "UNREACHED-notUpper\x0a"
    arm64.bl print
    arm64.b ifcont#16
  ifcont#16:
    arm64.leaRdata x0, __str_rec_40  ; "\xc3\xa9"
    arm64.bl Ascii.isAlpha
    arm64.cbnz x0, notAscii
    arm64.b ifcont#18
  notAscii:
    arm64.leaRdata x0, __str_rec_41  ; "UNREACHED-notAscii\x0a"
    arm64.bl print
    arm64.b ifcont#18
  ifcont#18:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
