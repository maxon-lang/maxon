// Test: stdlib-loading.a-stdlib-modules-literals-cannot-reach-the-rdata-image
function main() returns ExitCode
	var scale = 12.5
	let floor = 1.5
	var spins = 0
	while spins < 1 'spin'
		scale = scale + floor
		spins = spins + 1
	end 'spin'
	if scale > floor 'gt'
		return 8
	end 'gt'
	return 1
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_12.5]
    arm64.fpLoadRdata d1, [rdata + __fconst_1.5]
    arm64.movImm x0, 0
  whilehdr:
    arm64.cmp x0, 1
    arm64.b.ge whileexit
  spin:
    arm64.fadd d0, d0, d1
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.fcmp d0, d1
    arm64.b.le ifcont
  gt:
    arm64.movImm x0, 8
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
