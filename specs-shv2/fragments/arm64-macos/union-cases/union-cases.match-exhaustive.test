// Test: union-cases.match-exhaustive
typealias Integer = int(i64.min to i64.max)

union Shape
	circle(radius Integer)
	square(side Integer)
	point
end 'Shape'

function describe(k Shape.unionCases) returns Integer
	match k 'tag'
		circle then return 100
		square then return 200
		point then return 300
	end 'tag'
end 'describe'

function main() returns ExitCode
	let c = Shape.unionCases.circle
	let s = Shape.unionCases.square
	let p = Shape.unionCases.point
	let total = describe(c) + describe(s) + describe(p)
	if total == 600 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#6
  __il_body#6:
    arm64.b matcharm#7
  matcharm#7:
    arm64.movImm x0, 100
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#14
  __il_body#14:
    arm64.b matchnext#19
  matchnext#19:
    arm64.b matcharm#16
  matcharm#16:
    arm64.movImm x1, 200
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x0, x0, x1
    arm64.b __il_body#22
  __il_body#22:
    arm64.b matchnext#27
  matchnext#27:
    arm64.b matchnext#28
  matchnext#28:
    arm64.b matcharm#25
  matcharm#25:
    arm64.movImm x1, 300
    arm64.b __il_cont#3
  __il_cont#3:
    arm64.add x0, x0, x1
    arm64.cmp x0, 600
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
