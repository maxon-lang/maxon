// Test: union-payload.matching-payload-types
typealias Integer = int(i64.min to i64.max)

enum Shade
	dark
	light
end 'Shade'

type Color
	export var v as Integer

	export static function create(v Integer) returns Self
		return Self{v: v}
	end 'create'
end 'Color'

union Paint
	tint(c Color)
	wash(s Shade)
end 'Paint'

function readOne(p Paint) returns Integer
	match p 'go'
		tint(c) then return c.v
		wash(s) then return s.ordinal
	end 'go'
end 'readOne'

function main() returns ExitCode
	return readOne(Paint.tint(Color.create(4))) + readOne(Paint.wash(Shade.light))
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Color.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @readOne {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4
    arm64.bl Color.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movRegReg x0, x20
    arm64.bl readOne
    arm64.movRegReg x19, x0
    arm64.movImm x21, 1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movRegReg x0, x22
    arm64.bl readOne
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Paint
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Paint
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
