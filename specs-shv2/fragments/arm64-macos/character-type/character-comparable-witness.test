    arm64.leaRdata x0, __str_rec_4  ; "\xc3\xa9"
    arm64.leaRdata x19, __str_rec_5  ; "\xc3\xbc"
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
