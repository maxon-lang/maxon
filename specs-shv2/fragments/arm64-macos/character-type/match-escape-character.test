// Test: match-escape-character
function main() returns ExitCode
	let c = '\n'
	match c 'check'
		'\n' then return 0
		default then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.leaRdata x1, __str_rec_1
    arm64.bl __str_eq
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchcont:
}
