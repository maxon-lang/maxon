// Test: error.literal-past-the-upper-bound
function tooBig() returns ExitCode
  return 4294967296
end 'tooBig'

function main() returns ExitCode
  let v = tooBig()
  print("v={v}\n")
  return 0
end 'main'
---
CompilerError:
error E3005: <fragment>:3:3: Value 4294967296 is outside the range of 'ExitCode' (int(0 to 255))
