// Test: self-field-get
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type NumberList
		export var data as IntArray

		function add(value Integer)
				self.data.push(value)
		end 'add'

		function first() returns Integer
				return try self.data.get(0) otherwise -1
		end 'first'

		static function create(data IntArray) returns Self
			return Self{data: data}
		end 'create'
end 'NumberList'

function main() returns ExitCode
		var list = NumberList.create(IntArray.create())
		list.add(42)
		return list.first()
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @NumberList.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __arr_push
    arm64.epilogue 16
    arm64.ret
}

func @NumberList.first {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, -1
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @NumberList.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.bl NumberList.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 42
    arm64.movRegReg x0, x19
    arm64.bl NumberList.add
    arm64.movRegReg x0, x19
    arm64.bl NumberList.first
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_NumberList
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
