// Test: self-field-push
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Container
		export var items as IntArray

		function addItem(value Integer)
				self.items.push(value)
		end 'addItem'

		function getCount() returns Integer
				return self.items.count()
		end 'getCount'

		static function create(items IntArray) returns Self
			return Self{items: items}
		end 'create'
end 'Container'

function main() returns ExitCode
		var c = Container.create(IntArray.create())
		c.addItem(10)
		c.addItem(20)
		return c.getCount()
end 'main'
---
ExitCode: 2
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Container.addItem {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __arr_push
    arm64.epilogue 16
    arm64.ret
}

func @Container.getCount {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __arr_count
    arm64.epilogue 16
    arm64.ret
}

func @Container.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.bl Container.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl Container.addItem
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl Container.addItem
    arm64.movRegReg x0, x19
    arm64.bl Container.getCount
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Container
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
