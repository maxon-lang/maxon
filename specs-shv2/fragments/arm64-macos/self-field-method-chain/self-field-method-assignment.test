// Test: self-field-method-assignment
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Accumulator
		export var items as IntArray

		function addAndCount(value Integer) returns Integer
				self.items.push(value)
				return self.items.count()
		end 'addAndCount'

		static function create(items IntArray) returns Self
			return Self{items: items}
		end 'create'
end 'Accumulator'

function main() returns ExitCode
		var acc = Accumulator.create(IntArray.create())
		_ = acc.addAndCount(1)
		_ = acc.addAndCount(2)
		return acc.addAndCount(3)
end 'main'
---
ExitCode: 3
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Accumulator.addAndCount {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __arr_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __arr_count
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Accumulator.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.bl Accumulator.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl Accumulator.addAndCount
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl Accumulator.addAndCount
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Accumulator.addAndCount
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Accumulator
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
