// Test: builtins-clock.unix-seconds-is-a-calendar-time
function main() returns ExitCode
	let now = __Builtins.currentUnixTimeSeconds()
	var score = 0
	if now > 1735689600 'afterKnownPast'
		score = score + 1
	end 'afterKnownPast'
	if now < 4102444800 'beforeFarFuture'
		score = score + 1
	end 'beforeFarFuture'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.bl __clock_now_unix_s
    arm64.movImm x1, 0
    arm64.movImm x16, 1735689600
    arm64.cmp x0, x16
    arm64.cset x2, gt
    arm64.cbnz x2, afterKnownPast
    arm64.b critsplit#8
  afterKnownPast:
    arm64.movImm x1, 1
    arm64.b ifcont#2
  critsplit#8:
    arm64.b ifcont#2
  ifcont#2:
    arm64.movImm x2, 4102444800
    arm64.cmp x0, x2
    arm64.cset x0, lt
    arm64.cbnz x0, beforeFarFuture
    arm64.b critsplit#9
  beforeFarFuture:
    arm64.add x0, x1, 1
    arm64.b ifcont#4
  critsplit#9:
    arm64.movRegReg x0, x1
    arm64.b ifcont#4
  ifcont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
