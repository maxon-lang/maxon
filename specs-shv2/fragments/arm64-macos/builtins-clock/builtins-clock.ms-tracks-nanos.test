// Test: builtins-clock.ms-tracks-nanos
function main() returns ExitCode
	let ns = __Builtins.currentTimeNanos()
	let ms = __Builtins.currentTimeMs()
	let nsAsMs = ns / 1000000
	var score = 0
	if ms >= nsAsMs 'notBehind'
		score = score + 1
	end 'notBehind'
	if ms - nsAsMs < 50 'notAhead'
		score = score + 1
	end 'notAhead'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __slab_arena_list@160 = i64 0
  __slab_arena_map_l1@168 = i64 0
  __slab_state@176 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __gt_now_ns
    arm64.movRegReg x19, x0
    arm64.bl __gt_now_ns
    arm64.movImm x1, 1000000
    arm64.sdiv x0, x0, x1
    arm64.movImm x1, 1000000
    arm64.sdiv x1, x19, x1
    arm64.movImm x2, 0
    arm64.cmp x0, x1
    arm64.cset x3, ge
    arm64.cbnz x3, notBehind
    arm64.b critsplit#8
  notBehind:
    arm64.movImm x2, 1
    arm64.b ifcont#2
  critsplit#8:
    arm64.b ifcont#2
  ifcont#2:
    arm64.sub x0, x0, x1
    arm64.cmp x0, 50
    arm64.cset x0, lt
    arm64.cbnz x0, notAhead
    arm64.b critsplit#9
  notAhead:
    arm64.add x0, x2, 1
    arm64.b ifcont#4
  critsplit#9:
    arm64.movRegReg x0, x2
    arm64.b ifcont#4
  ifcont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at builtins-clock.ms-tracks-nanos.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
