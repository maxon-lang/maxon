  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x16, 1000000
    arm64.cmp x1, x16
    arm64.cset x0, hi
    arm64.cbnz x0, rec
    arm64.b ifcont
  rec:
    arm64.add x1, x1, 1
    arm64.movRegReg x0, x19
    arm64.bl Reader.consume
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#3
    arm64.b tryok#2
  tryerr#3:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#2:
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.leaRdata x1, __layout_ArrayIterator_Item
    arm64.bl ArrayIterator.current
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl ArrayIterator.advance
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#6
    arm64.b tryok#5
  tryerr#6:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Item
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#5:
    arm64.movImm x9, 0
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

