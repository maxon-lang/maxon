// Test: parsable.bool-fromstring-false
function main() returns ExitCode
	let b = try bool.fromString("false") otherwise true
	if b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __bool_fromString
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @__bool_fromString {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbnz x0, is_true
    arm64.b ifcont
  is_true:
    arm64.movImm x0, 1
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.leaRdata x1, __str_rec_1
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbnz x0, is_false
    arm64.b ifcont
  is_false:
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
