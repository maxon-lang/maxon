    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.cset x0, ls
    arm64.cbnz x0, __im_slow
    arm64.b __im_load
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.arm64AddLsl x0, x0, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movImm x21, 0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 40]
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, __im_empty
    arm64.b critsplit#11
  __im_empty:
    arm64.cmp x19, 0
    arm64.cset x0, eq
    arm64.cbnz x0, __im_slow
    arm64.b critsplit#12
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_get
    arm64.movRegReg x19, x0
    arm64.movRegReg x21, x9
    arm64.b __im_cont
  critsplit#12:
    arm64.b __im_cont
  critsplit#11:
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x21, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x21
    arm64.loadRegSlot x19, slot0
