// Test: parsable.otherwise-fallthrough

typealias Integer = int(i64.min to i64.max)

// otherwise blocks execute code when error occurs, then continue execution
enum ParseError implements Error
	Invalid = 1
end 'ParseError'

type Value implements Parsable
	export var n as Integer

	static function fromString(input String) returns Self throws ParseError
		if input.startsWith("x") 'check'
			throw ParseError.Invalid
		end 'check'
		return Value{n: input.byteLength()}
	end 'fromString'

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Value'

function main() returns ExitCode
	var result = 0

	// First call succeeds - handler not executed
	let v = try Value.fromString("hello") otherwise Value.create(0)
	result = result + v.n  // adds 5

	// Second call fails - use default value
	let v2 = try Value.fromString("xbad") otherwise Value.create(0)
	result = result + v2.n  // adds 0

	// Third call succeeds
	let v3 = try Value.fromString("world") otherwise Value.create(0)
	result = result + v3.n  // adds 5

	return result
end 'main'
---
ExitCode: 10
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Value.fromString {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __str_rec_1
    arm64.movRegReg x0, x19
    arm64.bl __str_starts_with
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.add x9, x0, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Value.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_3
    arm64.bl Value.fromString
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.bl Value.create
    arm64.movRegReg x19, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x20, x0, 0
    arm64.leaRdata x0, __str_rec_5
    arm64.bl Value.fromString
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.bl Value.create
    arm64.movRegReg x21, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.add x20, x20, x0
    arm64.leaRdata x0, __str_rec_7
    arm64.bl Value.fromString
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.bl Value.create
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x20, x20, x1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
