func @Svc.__loop {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
  serve:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x21, x0
    arm64.cmp x21, 0
    arm64.b.eq stopping
  dispatch:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.jumpTable x0, default=stopping [[0]=__shutdown, [1]=take] @__jumptable_6
  __shutdown:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.storeBaseDispReg.word64 [x20 + 56], x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
  stopping:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_close
  drain:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x1, x0
    arm64.cmp x1, 0
    arm64.b.ne abandon
  finished:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mbox_service_exit
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  abandon:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_abandon
    arm64.b drain
  take:
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Svc.take
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.b serve
}

func @Svc.__abandon {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
