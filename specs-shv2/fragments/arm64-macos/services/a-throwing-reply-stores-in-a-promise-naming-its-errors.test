    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Calc.divide {
  entry:
    arm64.prologue 16
    arm64.cmp x2, 0
    arm64.cset x0, eq
    arm64.cbnz x0, zero
    arm64.b ifcont
  zero:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.orr x2, x2, x0
    arm64.sdiv x1, x1, x2
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x1
    arm64.b trycont
  trycont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

