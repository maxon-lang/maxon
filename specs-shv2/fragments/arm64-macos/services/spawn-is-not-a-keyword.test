// Test: spawn-is-not-a-keyword
type Job
	var spawn as Integer

	static function spawn(n Integer) returns Self
		return Self{spawn: n}
	end 'spawn'

	function tally() returns Integer
		return self.spawn
	end 'tally'
end 'Job'

function run(spawn Integer) returns Integer
	return spawn + 1
end 'run'

function main() returns ExitCode
	let j = Job.spawn(3)
	let spawn = 4
	return (j.tally() + run(spawn) + spawn) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 12
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 3
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x0, x0, 5
    arm64.add x0, x0, 4
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
