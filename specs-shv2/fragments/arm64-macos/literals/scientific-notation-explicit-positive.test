// Test: scientific-notation-explicit-positive
function main() returns ExitCode
	let x = 2.5e+02
	return trunc(x) - 240
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
