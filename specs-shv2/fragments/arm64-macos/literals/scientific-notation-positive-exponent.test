// Test: scientific-notation-positive-exponent
function main() returns ExitCode
	let x = 1.5e2
	return trunc(x) - 140
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fcvtzs x0, d0
    arm64.sub x0, x0, 140
    arm64.epilogue 16
    arm64.ret
}
