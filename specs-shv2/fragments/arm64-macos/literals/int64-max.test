// Test: int64-max
// Test INT64_MAX (9223372036854775807)
function main() returns ExitCode
	let x = 9223372036854775807
	if x > 0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
