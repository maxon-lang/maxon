// Test: struct-array-get-multiple-reads
typealias Integer = int(i64.min to i64.max)

type Item
		export var id as Integer

		static function create(id Integer) returns Self
			return Self{id: id}
		end 'create'
end 'Item'

typealias ItemArray = Array with Item

function readTwice(items ItemArray) returns Integer
		let a = try items.get(0) otherwise Item.create(0)
		let b = try items.get(0) otherwise Item.create(0)
		return a.id + b.id
end 'readTwice'

function main() returns ExitCode
		var items = ItemArray.create()
		items.push(Item.create(21))
		let result = readTwice(items)
		let check = try items.get(0) otherwise Item.create(0)
		return check.id + result
end 'main'
---
ExitCode: 63
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Item.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @readTwice {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.bl Item.create
    arm64.movRegReg x20, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.b trycont
  trycont:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.bl Item.create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 21
    arm64.bl Item.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl readTwice
    arm64.movRegReg x20, x0
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x21, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.bl Item.create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.movRegReg x0, x21
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x20, x1, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
