// Test: struct-array-get-loop-function
typealias Integer = int(i64.min to i64.max)

type Pair
		export var a as Integer
		export var b as Integer

		static function create(a Integer, b Integer) returns Self
			return Self{a: a, b: b}
		end 'create'
end 'Pair'

typealias PairArray = Array with Pair

function sumAll(pairs PairArray) returns Integer
		var total = 0
		for pair in pairs 'loop'
				total = total + pair.a + pair.b
		end 'loop'
		return total
end 'sumAll'

function main() returns ExitCode
		var pairs = PairArray.create()
		pairs.push(Pair.create(1, b: 2))
		pairs.push(Pair.create(3, b: 4))
		pairs.push(Pair.create(5, b: 6))
		let sum = sumAll(pairs)
		// After sumAll, elements should still be valid
		let p1 = try pairs.get(1) otherwise Pair.create(0, b: 0)
		if sum == 21 'ok'
				return p1.a + p1.b
		end 'ok'
		return 0
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @sumAll {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b forexit
  loop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __arr_get_unchecked
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x1, x20, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x20, x1, x0
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl Pair.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.bl Pair.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 5
    arm64.movImm x1, 6
    arm64.bl Pair.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movRegReg x0, x19
    arm64.bl sumAll
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.movRegReg x21, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.bl Pair.create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.movRegReg x0, x21
    arm64.b trycont
  trycont:
    arm64.cmp x20, 21
    arm64.cset x1, eq
    arm64.cbnz x1, ok
    arm64.b ifcont
  ok:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.add x20, x1, x2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
