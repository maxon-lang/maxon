// Test: method-statement-after-continue-in-loop
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function build(n Integer) returns Integer
	var arr = IntArray.create()
	var i = 0
	while i < n 'loop'
		i = i + 1
		if i == 2 'skip'
			continue
		end 'skip'
		if n > 1 'grow'
			arr = IntArray.create()
		end 'grow'
		arr.reserve(4)
	end 'loop'
	return arr.count()
end 'build'

function main() returns ExitCode
	print("{build(5)}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @build {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movImm x1, 0
    arm64.movRegReg x20, x0
  whilehdr:
    arm64.cmp x1, x19
    arm64.b.ge whileexit
  loop:
    arm64.add x21, x1, 1
    arm64.cmp x21, 2
    arm64.b.ne ifcont#5
  skip:
    arm64.movRegReg x1, x21
    arm64.b whilehdr
  ifcont#5:
    arm64.cmp x19, 1
    arm64.b.le critsplit
  grow:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.b ifcont#7
  critsplit:
    arm64.movRegReg x22, x20
  ifcont#7:
    arm64.movImm x1, 4
    arm64.movRegReg x0, x22
    arm64.bl Array.reserve
    arm64.movRegReg x20, x22
    arm64.movRegReg x1, x21
    arm64.b whilehdr
  whileexit:
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl build
    arm64.movRegReg x19, x0
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.add x0, x19, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.add x22, x21, 56
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x22, x19
    arm64.storeBaseDispReg.word64 [x21 + 0], x22
    arm64.storeBaseDispReg.word64 [x21 + 8], x19
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.bl print
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
