// Test: assign-self-field-and-iterator

typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Counter
	export var total as Integer

	static function create() returns Self
		return Self{total: 0}
	end 'create'

	function addAll(values IntArray) returns Integer
		for v in values 'each'
			self.total = self.total + v
		end 'each'
		return self.total
	end 'addAll'
end 'Counter'

function main() returns ExitCode
	var c = Counter.create()
	let nums = [1, 2, 3]
	return c.addAll(nums) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 3
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x1, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.movImm x1, 8
    arm64.storeBaseDispReg.word64 [x0 + 24], x1
    arm64.b __il_body
  __il_body:
    arm64.movImm x1, 0
    arm64.b forhdr
  forhdr:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.cset x2, lt
    arm64.cbnz x2, each
    arm64.b forexit
  each:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.arm64AddLsl x2, x2, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.add x2, x3, x2
    arm64.storeBaseDispReg.word64 [x19 + 0], x2
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x19, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at assign-self-field-and-iterator.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
}
