// Test: recursion-factorial
function factorial(n int) returns int
	if n <= 1 'base'
		return 1
	end 'base'
	return n * factorial(n - 1)
end 'factorial'

function main() returns ExitCode
	return factorial(5)
end 'main'
---
ExitCode: 120
---
func @factorial {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 1
    arm64.cset x0, le
    arm64.cbnz x0, base
    arm64.b ifcont
  base:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.sub x0, x19, 1
    arm64.bl factorial
    arm64.mul x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl factorial
    arm64.epilogue 16
    arm64.ret
}
