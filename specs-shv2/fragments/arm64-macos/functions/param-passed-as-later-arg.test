// Test: param-passed-as-later-arg
function diff(x Integer, y Integer) returns Integer
	return x - y
end 'diff'

function combine(a Integer, b Integer, c Integer) returns Integer
	let r = diff(b, y: a)
	return r + c
end 'combine'

function main() returns ExitCode
	return combine(10, b: 20, c: 30)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 40
---
func @combine {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.sub x0, x1, x0
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, x2
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 20
    arm64.movImm x2, 30
    arm64.bl combine
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at param-passed-as-later-arg.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
