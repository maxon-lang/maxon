// Test: param-passed-as-later-arg
function diff(x int, y int) returns int
	return x - y
end 'diff'

function combine(a int, b int, c int) returns int
	let r = diff(b, y: a)
	return r + c
end 'combine'

function main() returns ExitCode
	return combine(10, b: 20, c: 30)
end 'main'
---
ExitCode: 40
---
func @diff {
  entry:
    arm64.prologue 16
    arm64.sub x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @combine {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x6, x0
    arm64.movRegReg x19, x2
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.bl diff
    arm64.add x0, x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 20
    arm64.movImm x2, 30
    arm64.bl combine
    arm64.epilogue 16
    arm64.ret
}
