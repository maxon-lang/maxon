// Test: zero-arg-call
function answer() returns int
	return 42
end 'answer'

function main() returns ExitCode
	return answer()
end 'main'
---
ExitCode: 42
---
func @answer {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl answer
    arm64.epilogue 16
    arm64.ret
}
