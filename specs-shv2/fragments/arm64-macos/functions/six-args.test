// Test: six-args
function sum6(a int, b int, c int, d int, e int, f int) returns int
	return a + b + c + d + e + f
end 'sum6'

function main() returns ExitCode
	return sum6(1, b: 2, c: 3, d: 4, e: 5, f: 6)
end 'main'
---
ExitCode: 21
---
func @sum6 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.movRegReg x7, x4
    arm64.movRegReg x8, x5
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x6
    arm64.add x0, x0, x7
    arm64.add x0, x0, x8
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x6, 4
    arm64.movImm x7, 5
    arm64.movImm x8, 6
    arm64.movRegReg x3, x6
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x8
    arm64.bl sum6
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
