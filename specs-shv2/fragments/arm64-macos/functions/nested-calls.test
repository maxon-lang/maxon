// Test: nested-calls
function zero() returns Integer
	return 7
end 'zero'

function inc(x Integer) returns Integer
	return x + 1
end 'inc'

function main() returns ExitCode
	return inc(inc(inc(zero())))
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 10
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at nested-calls.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
