// Test: nested-calls
function zero() returns int
	return 7
end 'zero'

function inc(x int) returns int
	return x + 1
end 'inc'

function main() returns ExitCode
	return inc(inc(inc(zero())))
end 'main'
---
ExitCode: 10
---
func @zero {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}

func @inc {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl zero
    arm64.bl inc
    arm64.bl inc
    arm64.bl inc
    arm64.epilogue 16
    arm64.ret
}
