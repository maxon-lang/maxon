// Test: subtract-order
function sub(a int, b int) returns int
	return a - b
end 'sub'

function main() returns ExitCode
	return sub(20, b: 8)
end 'main'
---
ExitCode: 12
---
func @sub {
  entry:
    arm64.prologue 16
    arm64.sub x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 8
    arm64.bl sub
    arm64.epilogue 16
    arm64.ret
}
