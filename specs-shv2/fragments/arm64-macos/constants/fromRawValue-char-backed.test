// Test: fromRawValue-char-backed
enum Grade
	excellent = 'A'
	good = 'B'
	average = 'C'
end 'Grade'

function main() returns ExitCode
	let g = try Grade.fromRawValue('B') otherwise Grade.average
	if g == Grade.good 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "B"
    arm64.bl __enum_from_raw_Grade
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 67
  trycont:
    arm64.cmp x0, 66
    arm64.b.ne ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
