// Test: simple-enum-rawvalue
enum Direction
	north
	south
	east
end 'Direction'

function main() returns ExitCode
	let d = Direction.south
	return d.rawValue
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
