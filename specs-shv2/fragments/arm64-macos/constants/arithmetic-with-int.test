// Test: arithmetic-with-int
enum Step
	first
	second
	third
end 'Step'

function main() returns ExitCode
	let stride = 10
	let offset = Step.second * stride
	return offset
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
