// Test: float-arithmetic
enum Weight
	light = 0.5
	heavy = 2.0
end 'Weight'

function main() returns ExitCode
	let scale = 4.0
	let result = Weight.light * scale
	if result == 2.0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.movImm x0, 4602678819172646912
    arm64.fmov d1, x0
    arm64.fmul d0, d1, d0
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
