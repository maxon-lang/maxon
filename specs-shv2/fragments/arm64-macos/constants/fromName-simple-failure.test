// Test: fromName-simple-failure
enum Direction
	north
	south
end 'Direction'

function getInvalidName() returns String
	return "invalid"
end 'getInvalidName'

function main() returns ExitCode
	let name = getInvalidName()
	let dir = try Direction.fromName(name) otherwise Direction.north
	if dir == Direction.north 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @getInvalidName {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "invalid"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl getInvalidName
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __enum_from_name_Direction
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 0
  trycont:
    arm64.cmp x0, 0
    arm64.b.ne ifcont
  check:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
