// Test: transitive-field-store-is-an-effect
typealias Count = int(i64.min to i64.max)

type Counter
	export var n as Count

	function bump() returns (Count, Count)
		n = n + 1
		return (n, n)
	end 'bump'

	static function create() returns Self
		return Self{n: 0}
	end 'create'
end 'Counter'

function oneHop(c Counter) returns (Count, Count)
	return c.bump()
end 'oneHop'

function twoHops(c Counter) returns (Count, Count)
	return oneHop(c)
end 'twoHops'

function main() returns ExitCode
	var c = Counter.create()
	(_, _) = twoHops(c)
	return c.n
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.bump {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x1, x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @oneHop {
  entry:
    arm64.prologue 16
    arm64.bl Counter.bump
    arm64.epilogue 16
    arm64.ret
}

func @twoHops {
  entry:
    arm64.prologue 16
    arm64.bl oneHop
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl twoHops
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
}
