// Test: rhs-is-evaluated-when-lhs-does-not-decide
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function main() returns ExitCode
	var code = 0
	if t() and f() 'a'
		code = code + 1
	end 'a'
	if t() and t() 'b'
		code = code + 2
	end 'b'
	if f() and t() 'c'
		code = code + 4
	end 'c'
	if f() or f() 'd'
		code = code + 8
	end 'd'
	if f() or t() 'e'
		code = code + 16
	end 'e'
	if t() or f() 'g'
		code = code + 32
	end 'g'
	return code
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  __il_body#31:
    arm64.movImm x1, 0
  scmerge#2:
    arm64.cbz x1, __il_body#35
  a:
    arm64.movImm x0, 1
  __il_body#35:
    arm64.movImm x1, 1
  scmerge#6:
    arm64.cbz x1, __il_cont#36
  b:
    arm64.add x0, x0, 2
  __il_cont#36:
    arm64.movImm x1, 0
  scmerge#10:
    arm64.cbz x1, __il_body#43
  c:
    arm64.add x0, x0, 4
  __il_body#43:
    arm64.movImm x1, 0
  scmerge#14:
    arm64.cbz x1, __il_body#47
  d:
    arm64.add x0, x0, 8
  __il_body#47:
    arm64.movImm x1, 1
  scmerge#18:
    arm64.cbz x1, __il_cont#48
  e:
    arm64.add x0, x0, 16
  __il_cont#48:
    arm64.movImm x1, 1
  scmerge#22:
    arm64.cbz x1, ifcont
  g:
    arm64.add x0, x0, 32
  ifcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rhs-is-evaluated-when-lhs-does-not-decide.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
