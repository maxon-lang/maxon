// Test: integer-and-is-bitwise-not-logical
function main() returns ExitCode
	let r = 12 and 3
	if r == 0 'bitwise'
		return 0
	end 'bitwise'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b bitwise
  bitwise:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
