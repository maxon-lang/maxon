// Test: in-a-return-value
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function bothTrue() returns bool
	return t() and t()
end 'bothTrue'

function eitherTrue() returns bool
	return f() or t()
end 'eitherTrue'

function main() returns ExitCode
	var code = 0
	if bothTrue() 'a'
		code = code + 1
	end 'a'
	if eitherTrue() 'b'
		code = code + 2
	end 'b'
	return code
end 'main'
---
ExitCode: 3
---
func @bothTrue {
  entry:
    arm64.prologue 16
    arm64.b __il_body#4
  __il_body#4:
    arm64.b __il_cont#3
  __il_cont#3:
    arm64.b andrhs
  andrhs:
    arm64.b __il_body#6
  __il_body#6:
    arm64.movImm x0, 1
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}

func @eitherTrue {
  entry:
    arm64.prologue 16
    arm64.b __il_body#4
  __il_body#4:
    arm64.b __il_cont#3
  __il_cont#3:
    arm64.b orrhs
  orrhs:
    arm64.b __il_body#6
  __il_body#6:
    arm64.movImm x0, 1
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.bl bothTrue
    arm64.cbnz x0, a
    arm64.b critsplit#8
  a:
    arm64.movImm x19, 1
    arm64.b ifcont#2
  critsplit#8:
    arm64.b ifcont#2
  ifcont#2:
    arm64.bl eitherTrue
    arm64.cbnz x0, b
    arm64.b critsplit#9
  b:
    arm64.add x0, x19, 2
    arm64.b ifcont#4
  critsplit#9:
    arm64.movRegReg x0, x19
    arm64.b ifcont#4
  ifcont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at in-a-return-value.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
