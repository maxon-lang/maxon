// Test: loop-carried-var-across-a-short-circuit-condition
function positive(v Integer) returns bool
	return v > 0
end 'positive'

function underLimit(v Integer) returns bool
	return v < 4
end 'underLimit'

function main() returns ExitCode
	var n = 1
	var steps = 0
	while positive(n) and underLimit(n) 'loop'
		n = n + 1
		steps = steps + 1
		if steps > 10 'runaway'
			break
		end 'runaway'
	end 'loop'
	return n * 10 + steps
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 43
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
  __il_body#12:
    arm64.cmp x0, 0
    arm64.cset x2, gt
  __il_cont:
    arm64.movImm x3, 0
    arm64.cbz x2, critsplit
  __il_body#14:
    arm64.cmp x0, 4
    arm64.cset x2, lt
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x2, x3
  scmerge:
    arm64.cbz x2, whileexit
  loop:
    arm64.add x0, x0, 1
    arm64.add x1, x1, 1
    arm64.cmp x1, 10
    arm64.b.le __il_body#12
  whileexit:
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at loop-carried-var-across-a-short-circuit-condition.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
