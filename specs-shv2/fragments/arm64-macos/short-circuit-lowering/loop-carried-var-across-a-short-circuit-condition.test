// Test: loop-carried-var-across-a-short-circuit-condition
function positive(v int) returns bool
	return v > 0
end 'positive'

function underLimit(v int) returns bool
	return v < 4
end 'underLimit'

function main() returns ExitCode
	var n = 1
	var steps = 0
	while positive(n) and underLimit(n) 'loop'
		n = n + 1
		steps = steps + 1
		if steps > 10 'runaway'
			break
		end 'runaway'
	end 'loop'
	return n * 10 + steps
end 'main'
---
ExitCode: 43
---
func @positive {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x0, gt
    arm64.epilogue 16
    arm64.ret
}

func @underLimit {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 4
    arm64.cset x0, lt
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.movRegReg x0, x19
    arm64.bl positive
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movRegReg x0, x19
    arm64.bl underLimit
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, loop
    arm64.b critsplit
  loop:
    arm64.add x0, x19, 1
    arm64.add x1, x20, 1
    arm64.cmp x1, 10
    arm64.cset x2, gt
    arm64.cbnz x2, runaway
    arm64.b ifcont
  runaway:
    arm64.b whileexit
  ifcont:
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.b whilehdr
  critsplit:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.b whileexit
  whileexit:
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
