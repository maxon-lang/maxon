// Test: a-substituted-container-field-is-word-strided-however-it-is-typed
typealias Byte = int(0 to 255)

type Bag uses Element
	typealias Items = Array with Element
	export var items as Items

	export static function create() returns Self
		return Self{items: Items.create()}
	end 'create'

	export function add(value Element)
		items.push(value)
	end 'add'
end 'Bag'

typealias ByteBag = Bag with Byte

function main() returns ExitCode
	var b = ByteBag.create()
	b.add(200)
	b.add(7)
	// The record was born in the shared body at the machine-word slot, whatever the field's type says.
	if b.items.managed.elementSize() != 8 'theRecordIsWordStrided'
		return 1
	end 'theRecordIsWordStrided'
	if (try b.items.get(0) otherwise return 2) != 200 'first'
		return 2
	end 'first'
	if (try b.items.get(1) otherwise return 3) != 7 'second'
		return 3
	end 'second'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __managed_push
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Bag_Byte
    arm64.bl Bag.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 200
    arm64.leaRdata x2, __layout_Bag_Byte
    arm64.movRegReg x0, x19
    arm64.bl Bag.add
    arm64.movImm x1, 7
    arm64.leaRdata x2, __layout_Bag_Byte
    arm64.movRegReg x0, x19
    arm64.bl Bag.add
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_element_size
    arm64.cmp x0, 8
    arm64.cset x21, ne
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.cbnz x21, theRecordIsWordStrided
    arm64.b ifcont#2
  theRecordIsWordStrided:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Byte
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#2:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.cset x3, eq
    arm64.cbnz x3, __im_word#13
    arm64.b __im_stride#15
  __im_word#13:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.cset x2, ls
    arm64.cbnz x2, __im_slow#12
    arm64.b __im_load#17
  __im_load#17:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_loaded#16
  __im_stride#15:
    arm64.cmp x2, 1
    arm64.cset x2, eq
    arm64.cbnz x2, __im_byte#14
    arm64.b __im_slow#12
  __im_byte#14:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.cset x2, ls
    arm64.cbnz x2, __im_slow#12
    arm64.b __im_load#18
  __im_load#18:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
    arm64.b __im_loaded#16
  __im_loaded#16:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.cset x4, ne
    arm64.cbnz x4, __im_empty#19
    arm64.b critsplit#29
  __im_empty#19:
    arm64.cmp x2, 0
    arm64.cset x4, eq
    arm64.cbnz x4, __im_slow#12
    arm64.b critsplit#30
  critsplit#30:
    arm64.b __im_cont#11
  critsplit#29:
    arm64.b __im_cont#11
  __im_slow#12:
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.movRegReg x3, x9
    arm64.b __im_cont#11
  __im_cont#11:
    arm64.cmp x3, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Byte
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.cmp x2, 200
    arm64.cset x0, ne
    arm64.cbnz x0, first
    arm64.b ifcont#6
  first:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Byte
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#6:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.cset x3, eq
    arm64.cbnz x3, __im_word#22
    arm64.b __im_stride#24
  __im_word#22:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 1
    arm64.cset x2, ls
    arm64.cbnz x2, __im_slow#21
    arm64.b __im_load#26
  __im_load#26:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 8
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_loaded#25
  __im_stride#24:
    arm64.cmp x2, 1
    arm64.cset x2, eq
    arm64.cbnz x2, __im_byte#23
    arm64.b __im_slow#21
  __im_byte#23:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 1
    arm64.cset x2, ls
    arm64.cbnz x2, __im_slow#21
    arm64.b __im_load#27
  __im_load#27:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 1
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
    arm64.b __im_loaded#25
  __im_loaded#25:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.cset x4, ne
    arm64.cbnz x4, __im_empty#28
    arm64.b critsplit#31
  __im_empty#28:
    arm64.cmp x2, 0
    arm64.cset x4, eq
    arm64.cbnz x4, __im_slow#21
    arm64.b critsplit#32
  critsplit#32:
    arm64.b __im_cont#20
  critsplit#31:
    arm64.b __im_cont#20
  __im_slow#21:
    arm64.bl __managed_get
    arm64.movRegReg x2, x0
    arm64.movRegReg x3, x9
    arm64.b __im_cont#20
  __im_cont#20:
    arm64.cmp x3, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#8
    arm64.b tryok#7
  tryerr#8:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Byte
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#7:
    arm64.cmp x2, 7
    arm64.cset x0, ne
    arm64.cbnz x0, second
    arm64.b ifcont#10
  second:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_Byte
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#10:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
