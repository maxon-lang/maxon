// Test: a-known-word-stride-reads-with-no-dispatch
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function total(a WordArray) returns Word
	var t = 0
	for v in a 'loop'
		t = t + v
	end 'loop'
	return t
end 'total'

function main() returns ExitCode
	var a = WordArray.create()
	for i in 0 upto 6 'seed'
		a.push(i * i)
	end 'seed'
	if total(a) != 55 'sum'
		return 1
	end 'sum'
	if a.count() != 6 'count'
		return 2
	end 'count'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x20, 6
    arm64.cset x0, lt
    arm64.cbnz x0, seed
    arm64.b forexit#4
  seed:
    arm64.mul x1, x20, x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.b forstep#3
  forstep#3:
    arm64.add x20, x20, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.b __il_body
  __il_body:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.b forhdr#11
  forhdr#11:
    arm64.cmp x1, x2
    arm64.cset x4, lt
    arm64.cbnz x4, loop
    arm64.b forexit#14
  loop:
    arm64.arm64AddLsl x4, x3, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x4, [x4 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.add x0, x0, x4
    arm64.b forstep#13
  forstep#13:
    arm64.add x1, x1, 1
    arm64.b forhdr#11
  forexit#14:
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 55
    arm64.cset x0, ne
    arm64.cbnz x0, sum
    arm64.b ifcont#6
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#6:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 6
    arm64.cset x0, ne
    arm64.cbnz x0, count
    arm64.b ifcont#8
  count:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#8:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
