    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at struct-equality-needs-no-conformance.test:7: Range check failed: value outside typealias 'Count'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl Box.make
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl Box.make
    arm64.movRegReg x20, x0
    arm64.movImm x0, 2
    arm64.bl Box.make
    arm64.movRegReg x21, x0
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.cbnz x0, eq
    arm64.b ifcont#2
  eq:
    arm64.leaRdata x0, __str_rec_2  ; "equal\x0a"
    arm64.bl print
    arm64.b ifcont#2
  ifcont#2:
    arm64.b __il_body#8
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.b __il_cont#7
  __il_cont#7:
