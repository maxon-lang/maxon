    arm64.bl Box.itemNameLength
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Box_Point
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Box_Point
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
