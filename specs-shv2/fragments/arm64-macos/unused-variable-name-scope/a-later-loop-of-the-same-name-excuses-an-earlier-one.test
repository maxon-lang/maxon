// Test: a-later-loop-of-the-same-name-excuses-an-earlier-one
function main() returns ExitCode
	var total = 0
	for i in 0 upto 3 'a'
		total = total + 1
	end 'a'
	for i in 0 upto 3 'b'
		total = total + i
	end 'b'
	return total
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, a
    arm64.b forexit#4
  a:
    arm64.add x0, x0, 1
    arm64.b forstep#3
  forstep#3:
    arm64.add x1, x1, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.movImm x1, 0
    arm64.b forhdr#5
  forhdr#5:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, b
    arm64.b forexit#8
  b:
    arm64.add x0, x0, x1
    arm64.b forstep#7
  forstep#7:
    arm64.add x1, x1, 1
    arm64.b forhdr#5
  forexit#8:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-later-loop-of-the-same-name-excuses-an-earlier-one.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
