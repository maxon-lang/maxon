  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @wideCount {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N8_Word32
    arm64.movImm x1, 8
    arm64.bl Vector.create
    arm64.movImm x19, 8
    arm64.b __il_body
  __il_body:
    arm64.b __rc_ok
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

