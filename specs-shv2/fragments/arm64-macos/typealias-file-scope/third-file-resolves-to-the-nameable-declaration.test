// Test: third-file-resolves-to-the-nameable-declaration
// --- file: alias.maxon
export typealias Codepoint = int(0 to 1114111)

// --- file: lib.maxon
export function widen(c Codepoint) returns int
	return c / 1000
end 'widen'

// --- file: main.maxon
typealias Codepoint = int(0 to 100)

function narrow(c Codepoint) returns int
	return c
end 'narrow'

function main() returns ExitCode
	return (widen(70000) - narrow(28)) as ExitCode
end 'main'
---
ExitCode: 42
---
func @narrow {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 100
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 70000
    arm64.bl widen
    arm64.movRegReg x19, x0
    arm64.movImm x0, 28
    arm64.bl narrow
    arm64.sub x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @widen {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1114111
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movImm x1, 1000
    arm64.sdiv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
