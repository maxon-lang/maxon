// Test: rc-managed-list-remove-decrefs
typealias Integer = int(i64.min to i64.max)

type Token
	export var id as Integer

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Token'

typealias TokenManagedList = __ManagedList with Token

function main() returns ExitCode
	var managedList = TokenManagedList.create()
	let node = managedList.insertFirst(Token.create(9))
	let removed = managedList.remove(node)
	return removed.id + managedList.count()
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Token.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, __mm_decref
    arm64.bl __list_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 9
    arm64.bl Token.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __list_prepend
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __list_remove_node
    arm64.movRegReg x21, x0
    arm64.loadRegBaseDisp.word64 x22, [x21 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __list_count
    arm64.add x22, x22, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __list_node_decref
    arm64.movRegReg x0, x19
    arm64.bl __list_decref
    arm64.cmp x22, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x22, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
