// Test: rc-custom-hashable-map-key-no-leak
typealias Integer = int(i64.min to i64.max)

type MyKey implements Hashable, Equatable
		var value as Integer

		function hash() returns HashValue
				return self.value * 31
		end 'hash'

		function equals(other MyKey) returns bool
				return self.value == other.value
		end 'equals'

		static function create(value Integer) returns Self
			return Self{value: value}
		end 'create'
end 'MyKey'

typealias MyKeyMap = Map with (MyKey, Integer)

function main() returns ExitCode
		var m = MyKeyMap.create()
		try m.insert(MyKey.create(1), value: 42) otherwise ignore
		return m.count()
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @MyKey.hash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 31
    arm64.mul x0, x0, x16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_22
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @MyKey.equals {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @MyKey.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Map_MyKey_Integer
    arm64.leaRdata x1, __witness_MyKey.Hashable
    arm64.leaRdata x2, __witness_MyKey.Equatable
    arm64.bl Map.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl MyKey.create
    arm64.movRegReg x20, x0
    arm64.movImm x21, 42
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.leaRdata x3, __layout_Map_MyKey_Integer
    arm64.leaRdata x4, __witness_MyKey.Hashable
    arm64.leaRdata x5, __witness_MyKey.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.leaRdata x1, __witness_MyKey.Hashable
    arm64.leaRdata x2, __witness_MyKey.Equatable
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 32]
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_chk#10
  __rc_chk#10:
    arm64.movImm x0, 4611686018427387904
    arm64.cmp x21, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_ok#9
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl Map.count
    arm64.movRegReg x21, x0
    arm64.b __il_cont
  __rc_ok#9:
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Map_MyKey_Integer
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#4
  __rc_panic:
    arm64.leaRdata x0, __str_blob_23
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#4:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
