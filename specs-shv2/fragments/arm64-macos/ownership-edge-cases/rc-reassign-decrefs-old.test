// Test: rc-reassign-decrefs-old
typealias Integer = int(i64.min to i64.max)

type Tag
	export var id as Integer

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Tag'

function main() returns ExitCode
	var t = Tag.create(1)
	t = Tag.create(2)
	t = Tag.create(3)
	return t.id
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 1
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 2
    arm64.leaRegSlot x1, slot1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 3
    arm64.leaRegSlot x1, slot2
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.epilogue 48
    arm64.ret
}
