    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow#11
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 40]
    arm64.cmp x2, 0
    arm64.b.eq critsplit#18
  __im_empty#13:
    arm64.cmp x20, 0
    arm64.b.ne critsplit#19
  __im_slow#11:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x20, x0
    arm64.b __im_cont#10
  critsplit#19:
    arm64.movRegReg x9, x0
    arm64.b __im_cont#10
  critsplit#18:
    arm64.movRegReg x9, x0
  __im_cont#10:
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x0, 99
    arm64.bl Fallback.create
    arm64.movRegReg x20, x0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
  trycont#3:
    arm64.movImm x1, 5
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 5
    arm64.b.ls __im_slow#15
  __im_load#16:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 40
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.movImm x0, 0
