// Test: rc-clone-survives-the-source-growing
function main() returns ExitCode
	var s = "0123456789abcdefghijABCDEFGHIJ"
	s.append("+")
	let c = s.clone()
	s.append("TAIL")
	print("clone={c}|{c.byteLength()}\n")
	print("source={s}|{s.byteLength()}\n")
	return 0
end 'main'
