// Test: cycle-mutual-recursion
type A
	export var b as B
end 'A'

type B
	export var a as A
end 'B'

function main() returns ExitCode
	return 0
end 'main'
---
CompilerError:
error E4014: <fragment>:2:6: type 'A' contains a reference cycle (via A → b: B → a: A); recursive type references are not allowed
