// Test: ceil.negative
function main() returns ExitCode
	let neg = -3.9
	let y = trunc(ceil(neg))
	return y + 10
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.frintp d0, d0
    arm64.fcvtzs x0, d0
    arm64.add x0, x0, 10
    arm64.epilogue 16
    arm64.ret
}
