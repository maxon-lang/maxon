// Test: atan2.positive-x-axis
function main() returns ExitCode
	let angle = Math.atan2(0.0, x: 1.0)
	if angle == 0.0 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_4]
    arm64.fpLoadRdata d1, [rdata + __fconst_5]
    arm64.bl Math.atan2
    arm64.fpLoadRdata d1, [rdata + __fconst_4]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @Math.hasNegativeSignBit {
  entry:
    arm64.prologue 16
    arm64.fmov x0, d0
    arm64.cmp x0, 0
    arm64.cset x0, lt
    arm64.epilogue 16
    arm64.ret
}

