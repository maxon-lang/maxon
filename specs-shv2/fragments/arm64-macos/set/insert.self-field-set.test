    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Set.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Reg.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x2, __layout_Set_Int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.bl Set.insert
    arm64.epilogue 16
    arm64.ret
}

func @Reg.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
  __il_body:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 24]
    arm64.cmp x3, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.movImm x4, 4611686018427387904
    arm64.cmp x3, x4
    arm64.b.le __rc_ok
  __il_slow:
    arm64.bl Set.count
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x3
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Reg.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Reg.add
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl Reg.add
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Reg.add
    arm64.movRegReg x0, x19
    arm64.bl Reg.size
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_17  ; "panic at insert.self-field-set.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
