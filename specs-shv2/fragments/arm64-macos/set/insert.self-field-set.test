// Test: insert.self-field-set
typealias Int = int(i64.min to i64.max)
typealias IntSet = Set with Int

type Reg
	export var seen as IntSet

	static function create() returns Reg
		return Self{seen: IntSet.create()}
	end 'create'

	export function add(v Int)
		seen.insert(v)
	end 'add'

	export function size() returns Int
		return seen.count()
	end 'size'
end 'Reg'

function main() returns ExitCode
	var r = Reg.create()
	r.add(3)
	r.add(4)
	r.add(3)
	return r.size() as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Reg.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl __set_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Reg.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x2, __witness_int.Hashable
    arm64.leaRdata x6, __witness_int.Equatable
    arm64.movRegReg x3, x6
    arm64.bl __set_insert
    arm64.epilogue 16
    arm64.ret
}

func @Reg.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __set_count
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Reg.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Reg.add
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl Reg.add
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl Reg.add
    arm64.movRegReg x0, x19
    arm64.bl Reg.size
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Reg
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @int.hash {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 4294967295
    arm64.and x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @int.equals {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.cbnz x0, equal
    arm64.b notEqual
  equal:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
