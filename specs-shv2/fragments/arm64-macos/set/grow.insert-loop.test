// Test: grow.insert-loop
typealias Int = int(i64.min to i64.max)
typealias IntSet = Set with Int

function main() returns ExitCode
	var s = IntSet.create()
	var i = 0
	while i < 20 'fill'
		s.insert(i)
		i = i + 1
	end 'fill'
	if s.count() != 20 'count'
		return 1
	end 'count'
	var j = 0
	while j < 20 'check'
		if not s.contains(j) 'missing'
			return 2
		end 'missing'
		j = j + 1
	end 'check'
	if s.contains(20) 'phantom'
		return 3
	end 'phantom'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Set_Int
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Set.create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  whilehdr#1:
    arm64.cmp x20, 20
    arm64.b.ge whileexit#3
  fill:
    arm64.leaRdata x2, __layout_Set_Int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Set.insert
    arm64.add x20, x20, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.movImm x3, 4611686018427387904
    arm64.cmp x0, x3
    arm64.b.le __il_cont
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl Set.count
  __il_cont:
    arm64.cmp x0, 20
    arm64.b.eq ifcont#5
  count:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_Int
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#5:
    arm64.movImm x20, 0
  whilehdr#6:
    arm64.cmp x20, 20
    arm64.b.ge whileexit#8
  check:
    arm64.leaRdata x2, __layout_Set_Int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Set.contains
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont#10
  missing:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_Int
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#10:
    arm64.add x20, x20, 1
    arm64.b whilehdr#6
  whileexit#8:
    arm64.movImm x1, 20
    arm64.leaRdata x2, __layout_Set_Int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Set.contains
    arm64.cbz x0, ifcont#12
  phantom:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_Int
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#12:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_Int
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
