// Test: insert.alias-typed-key
typealias Int = int(i64.min to i64.max)
typealias IntSet = Set with Int

function add(s IntSet, v Int)
	s.insert(v)
end 'add'

function main() returns ExitCode
	var s = IntSet.create()
	add(s, v: 3)
	add(s, v: 4)
	add(s, v: 3)
	return s.count() as ExitCode
end 'main'
