// Test: mixed-operators
function main() returns ExitCode
	let a = 10
	let b = 3
	return a * 2 + b - 1
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 22
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
