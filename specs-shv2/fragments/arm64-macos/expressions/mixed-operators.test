// Test: mixed-operators
function main() returns ExitCode
	let a = 10
	let b = 3
	return a * 2 + b - 1
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 3
    arm64.sub x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}
