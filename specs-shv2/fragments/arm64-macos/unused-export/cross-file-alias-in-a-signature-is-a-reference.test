// Test: cross-file-alias-in-a-signature-is-a-reference
// --- file: api/lib.maxon
export typealias Score = int(0 to 100)

// --- file: app/main.maxon
function scoreOf(s Score) returns Score
	return s
end 'scoreOf'

function main() returns ExitCode
	return scoreOf(5)
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
