// Test: public-var-not-flagged
// --- file: api/counter.maxon
typealias Integer = int(i64.min to i64.max)

public var unusedCounter = 99

export function readCounter() returns Integer
	return unusedCounter
end 'readCounter'

// --- file: app/main.maxon
function main() returns ExitCode
	return readCounter()
end 'main'
---
ExitCode: 99
---
data {
  __data_unusedCounter@0 = i64 99
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.leaGlobal x0, __data_unusedCounter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
