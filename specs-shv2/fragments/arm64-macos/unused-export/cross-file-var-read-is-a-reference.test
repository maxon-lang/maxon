// Test: cross-file-var-read-is-a-reference
// --- file: api/counter.maxon
export var usedCounter = 9

// --- file: app/main.maxon
function main() returns ExitCode
	return usedCounter
end 'main'
---
ExitCode: 9
---
data {
  __data_usedCounter@0 = i64 9
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_usedCounter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
