// Test: otherwise-throws.not-hit
typealias Integer = int(i64.min to i64.max)

enum ThrowsNotHitInner implements Error
	bad
end 'ThrowsNotHitInner'

enum ThrowsNotHitOuter implements Error
	failed
end 'ThrowsNotHitOuter'

function maybeFail(b bool) returns Integer throws ThrowsNotHitInner
	if b 'c'
		throw ThrowsNotHitInner.bad
	end 'c'
	return 5
end 'maybeFail'

function compute() returns Integer throws ThrowsNotHitOuter
	var total = 0
	try 'work'
		let a = maybeFail(false)
		total = a
	end 'work'
	otherwise throws ThrowsNotHitOuter.failed
	return total
end 'compute'

function main() returns ExitCode
	let r = try compute() otherwise 99
	return r
end 'main'
---
ExitCode: 5
---
func @maybeFail {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @compute {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryblkerr
    arm64.b tryblkok
  tryblkerr:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryblkok:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl compute
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 99
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at otherwise-throws.not-hit.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
