// Test: otherwise-panic.not-hit
typealias Integer = int(i64.min to i64.max)

enum PanicNotHitError implements Error
	bad
end 'PanicNotHitError'

function maybeFail(b bool) returns Integer throws PanicNotHitError
	if b 'c'
		throw PanicNotHitError.bad
	end 'c'
	return 7
end 'maybeFail'

function main() returns ExitCode
	var total = 0
	try 'work'
		let a = maybeFail(false)
		let b = maybeFail(false)
		total = a + b
	end 'work'
	otherwise panic("should not happen")
	return total
end 'main'
---
ExitCode: 14
---
func @maybeFail {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 7
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne tryblkerr
  tryblkok#2:
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.cmp x9, 0
    arm64.b.eq tryblkok#3
  tryblkerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at otherwise-panic.not-hit.test:22: should not happen\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryblkok#3:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at otherwise-panic.not-hit.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
