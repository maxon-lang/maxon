// Test: otherwise-panic.not-hit
typealias Integer = int(i64.min to i64.max)

enum PanicNotHitError implements Error
	bad
end 'PanicNotHitError'

function maybeFail(b bool) returns Integer throws PanicNotHitError
	if b 'c'
		throw PanicNotHitError.bad
	end 'c'
	return 7
end 'maybeFail'

function main() returns ExitCode
	var total = 0
	try 'work'
		let a = maybeFail(false)
		let b = maybeFail(false)
		total = a + b
	end 'work'
	otherwise panic("should not happen")
	return total
end 'main'
---
ExitCode: 14
---
func @maybeFail {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 7
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, critsplit#7
    arm64.b tryblkok#2
  critsplit#7:
    arm64.b tryblkerr
  tryblkok#2:
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, critsplit#8
    arm64.b tryblkok#3
  critsplit#8:
    arm64.b tryblkerr
  tryblkerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryblkok#3:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
