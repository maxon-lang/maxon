// Test: otherwise-panic.hit
typealias Integer = int(i64.min to i64.max)

enum PanicHitError implements Error
	bad
end 'PanicHitError'

function maybeFail(b bool) returns Integer throws PanicHitError
	if b 'c'
		throw PanicHitError.bad
	end 'c'
	return 7
end 'maybeFail'

function main() returns ExitCode
	var total = 0
	try 'work'
		let a = maybeFail(true)
		total = a
	end 'work'
	otherwise panic("call failed")
	return total
end 'main'
---
ExitCode: 1
---
func @maybeFail {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 7
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl maybeFail
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryblkerr
    arm64.b tryblkok
  tryblkerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryblkok:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
