// Test: range-check-panic.the-source-alias-keeps-its-own-guard
typealias Byte = int(0 to u8.max)
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function pick() returns Byte
  return opaque(300)
end 'pick'

function main() returns ExitCode
  return pick()
end 'main'
---
ExitCode: 1
---
func @pick {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.the-source-alias-keeps-its-own-guard.test:10: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl pick
    arm64.epilogue 16
    arm64.ret
}
