// Test: range-check-panic.full-range-argument-gains-no-guard
typealias Integer = int(i64.min to i64.max)

function passthrough(n Integer) returns Integer
  return n + 1
end 'passthrough'

function main() returns ExitCode
  return passthrough(6)
end 'main'
---
ExitCode: 7
---
func @passthrough {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 6
    arm64.bl passthrough
    arm64.epilogue 16
    arm64.ret
}
