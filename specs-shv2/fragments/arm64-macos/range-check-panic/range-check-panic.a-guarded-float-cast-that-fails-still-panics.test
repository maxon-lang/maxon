// Test: range-check-panic.a-guarded-float-cast-that-fails-still-panics
typealias Positive = float(2.2250738585072014e-308 to f64.max)

function main() returns ExitCode
  var d = 1.0
  d = d - 1.0
  let s = d as Positive
  print("q={8.0 / s}\n")
  return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __rc_panic:
    arm64.leaRdata x0, __str_blob_206  ; "panic at range-check-panic.a-guarded-float-cast-that-fails-still-panics.test:7: Range check failed: value outside typealias 'Positive'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
