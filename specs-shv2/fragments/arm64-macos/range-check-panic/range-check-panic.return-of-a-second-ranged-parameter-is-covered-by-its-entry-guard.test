// Test: range-check-panic.return-of-a-second-ranged-parameter-is-covered-by-its-entry-guard
typealias SmallInt = int(0 to 10)

function pick(a SmallInt, b SmallInt) returns SmallInt
  return b
end 'pick'

function main() returns ExitCode
  return pick(1, b: 7)
end 'main'
---
ExitCode: 7
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 10
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 10
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 7
    arm64.bl pick
    arm64.epilogue 16
    arm64.ret
}
