// Test: range-check-panic.a-guard-in-an-unselected-ternary-arm-does-not-fire
typealias Wide = int(0 to u64.max)
typealias Small = int(0 to 100)

function widen(n Wide) returns Wide
  return n * 100
end 'widen'

function pick(i Wide, flag bool) returns Small
  return (i as Small) if flag else 7
end 'pick'

function main() returns ExitCode
  return pick(widen(5), flag: false)
end 'main'
---
ExitCode: 7
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#5
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.cmp x0, 100
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#5
    arm64.b __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 7
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#8
    arm64.b __rc_chk#9
  __rc_chk#9:
    arm64.cmp x0, 100
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#8
    arm64.b __rc_ok#7
  __rc_panic#8:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#7:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#3
  __il_body#3:
    arm64.movImm x0, 500
    arm64.b __il_cont#2
  __il_cont#2:
    arm64.movImm x1, 0
    arm64.b __il_body#4
  __il_body#4:
    arm64.b ternaryfalse
  ternaryfalse:
    arm64.movImm x2, 7
    arm64.b matchcont
  matchcont:
    arm64.cmp x2, 0
    arm64.cset x3, lt
    arm64.cbnz x3, __il_slow
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x2, 100
    arm64.cset x3, gt
    arm64.cbnz x3, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.bl pick
    arm64.b __il_cont#1
  __rc_ok:
    arm64.movRegReg x0, x2
    arm64.b __il_cont#1
  __il_cont#1:
    arm64.epilogue 16
    arm64.ret
}
