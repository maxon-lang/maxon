// Test: range-check-panic.a-contained-return-emits-no-guard
typealias Byte = int(0 to u8.max)
typealias Integer = int(i64.min to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function pick() returns Byte
  return opaque(7)
end 'pick'

function main() returns ExitCode
  return pick()
end 'main'
---
ExitCode: 7
---
func @opaque {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.bl opaque
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl pick
    arm64.epilogue 16
    arm64.ret
}
