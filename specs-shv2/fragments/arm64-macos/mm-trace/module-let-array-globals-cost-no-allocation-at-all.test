// Test: module-let-array-globals-cost-no-allocation-at-all
typealias Num = int(0 to 1000)
typealias NumArray = Array with Num

let Literal = [7, 9, 11]
let Empty = NumArray.create()

function main() returns ExitCode
	let a = try Literal.get(0) otherwise 0
	let n = Empty.count()
	return 0 if a == 7 and n == 0 else 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __ds_base@32 = i64 0
  __ds_buf_size@40 = i64 0
  __ds_buf_mask@48 = i64 0
  __ds_start_ts@56 = i64 0
  __ds_lock@64 = i64 0
  __mm_alloc_id@72 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __barr_rec_2
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.b.eq critsplit#17
  __im_empty:
    arm64.cmp x2, 0
    arm64.b.ne critsplit#18
  __im_slow:
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#18:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  critsplit#17:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 0
  trycont:
    arm64.leaRdata x1, __barr_empty_2_trivial
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.cmp x0, 7
    arm64.movImm x0, 0
    arm64.b.ne scmerge
  andrhs:
    arm64.cmp x1, 0
    arm64.cset x0, eq
  scmerge:
    arm64.cbz x0, ternaryfalse
  ternarytrue:
    arm64.movImm x0, 0
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 1
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at module-let-array-globals-cost-no-allocation-at-all.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
