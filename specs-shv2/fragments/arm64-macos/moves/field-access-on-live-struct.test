// Test: field-access-on-live-struct
type Point
	export var x as int

	static function create(x int) returns Point
		return Self{x: x}
	end 'create'

	function getX() returns int
		return x
	end 'getX'
end 'Point'

function main() returns ExitCode
	var p = Point.create(4)
	p.x = 0
	return p.getX()
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Point.getX {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl Point.getX
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
