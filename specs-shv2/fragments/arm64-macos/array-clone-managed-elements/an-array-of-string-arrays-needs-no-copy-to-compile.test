// Test: an-array-of-string-arrays-needs-no-copy-to-compile
typealias StringArrayArray = Array with StringArray

function firstOf(candidates StringArrayArray) returns String
	for segments in candidates 'each'
		for s in segments 'inner'
			return s
		end 'inner'
	end 'each'
	return "none"
end 'firstOf'

function main() returns ExitCode
	var outer = StringArrayArray.create()
	var inner = StringArray.create()
	inner.push("a hit long enough to reach the heap")
	outer.push(inner)
	print("{firstOf(outer)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @firstOf {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x1, x2
    arm64.cset x3, lt
    arm64.cbnz x3, each
    arm64.b forexit#4
  each:
    arm64.arm64AddLsl x3, x0, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x3, [x3 + 0]
    arm64.b __im_cont#9
  __im_cont#9:
    arm64.movImm x4, 0
    arm64.b forhdr#5
  forhdr#5:
    arm64.loadRegBaseDisp.word64 x5, [x3 + 8]
    arm64.cmp x4, x5
    arm64.cset x5, lt
    arm64.cbnz x5, inner
    arm64.b forexit#8
  inner:
    arm64.loadRegBaseDisp.word64 x0, [x3 + 0]
    arm64.arm64AddLsl x0, x0, x4, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_cont#10
  __im_cont#10:
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
  forexit#8:
    arm64.b forstep#3
  forstep#3:
    arm64.add x1, x1, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
  forstep#7:
    arm64.add x4, x4, 1
    arm64.b forhdr#5
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
