// Test: seven-across-call-in-loop
function bump(x int) returns int
	return x + 1
end 'bump'

function sevenAcross(p int) returns int
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var a5 = p + 5
	var a6 = p + 6
	var a7 = p + 7
	var i = 0
	while i < 3 'loop'
		let d = bump(i)
		a1 = a1 + d
		a2 = a2 + d
		a3 = a3 + d
		a4 = a4 + d
		a5 = a5 + d
		a6 = a6 + d
		a7 = a7 + d
		i = i + 1
	end 'loop'
	return a1 + a2 + a3 + a4 + a5 + a6 + a7
end 'sevenAcross'

function main() returns ExitCode
	let r = sevenAcross(0)
	if r == 70 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @bump {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @sevenAcross {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x19, x0, 1
    arm64.add x20, x0, 2
    arm64.add x21, x0, 3
    arm64.add x22, x0, 4
    arm64.add x23, x0, 5
    arm64.add x24, x0, 6
    arm64.add x25, x0, 7
    arm64.movImm x26, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x26, 3
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movRegReg x0, x26
    arm64.bl bump
    arm64.add x19, x19, x0
    arm64.add x20, x20, x0
    arm64.add x21, x21, x0
    arm64.add x22, x22, x0
    arm64.add x23, x23, x0
    arm64.add x24, x24, x0
    arm64.add x25, x25, x0
    arm64.add x26, x26, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x19, x20
    arm64.add x0, x0, x21
    arm64.add x0, x0, x22
    arm64.add x0, x0, x23
    arm64.add x0, x0, x24
    arm64.add x0, x0, x25
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl sevenAcross
    arm64.cmp x0, 70
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
