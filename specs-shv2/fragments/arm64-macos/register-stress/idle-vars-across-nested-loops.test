// Test: idle-vars-across-nested-loops
function nestedIdle(p int) returns int
	var k1 = p + 1
	var k2 = p + 2
	var k3 = p + 3
	var k4 = p + 4
	var k5 = p + 5
	var k6 = p + 6
	var k7 = p + 7
	var k8 = p + 8
	var k9 = p + 9
	var k10 = p + 10
	var k11 = p + 11
	var k12 = p + 12
	var sum = 0
	var i = 0
	while i < 3 'outer'
		var j = 0
		while j < 2 'inner'
			sum = sum + j
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return sum + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + k12
end 'nestedIdle'

function main() returns ExitCode
	let r = nestedIdle(0)
	if r == 81 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @nestedIdle {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x6, x0, 3
    arm64.add x7, x0, 4
    arm64.add x8, x0, 5
    arm64.add x9, x0, 6
    arm64.add x10, x0, 7
    arm64.add x11, x0, 8
    arm64.add x19, x0, 9
    arm64.add x20, x0, 10
    arm64.add x21, x0, 11
    arm64.add x0, x0, 12
    arm64.movImm x3, 0
    arm64.movImm x4, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x4, 3
    arm64.cset x5, lt
    arm64.cbnz x5, outer
    arm64.b whileexit
  outer:
    arm64.movImm x5, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x5, 2
    arm64.cset x12, lt
    arm64.cbnz x12, inner
    arm64.b whileexit
  inner:
    arm64.add x3, x3, x5
    arm64.add x5, x5, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x4, x4, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x1, x3, x1
    arm64.add x1, x1, x2
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
    arm64.add x1, x1, x9
    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x1, x1, x19
    arm64.add x1, x1, x20
    arm64.add x1, x1, x21
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl nestedIdle
    arm64.cmp x0, 81
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
