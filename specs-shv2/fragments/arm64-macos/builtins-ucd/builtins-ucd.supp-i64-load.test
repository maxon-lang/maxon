// Test: builtins-ucd.supp-i64-load
function main() returns ExitCode
	let entry = __Builtins.ucdI64At("__ucd_supp", index: 0)
	let next = __Builtins.ucdI64At("__ucd_supp", index: 1)
	var score = 0
	if (entry and 2097151) == 65536 'rangeStart'
		score = score + 1
	end 'rangeStart'
	if ((entry shr 21) and 2097151) == 65547 'rangeEnd'
		score = score + 1
	end 'rangeEnd'
	if ((entry shr 42) and 31) == 5 'category'
		score = score + 1
	end 'category'
	if (next and 2097151) == 65549 'nextRangeStart'
		score = score + 1
	end 'nextRangeStart'
	if ((next shr 21) and 2097151) == 65574 'nextRangeEnd'
		score = score + 1
	end 'nextRangeEnd'
	if (next and 2097151) > ((entry shr 21) and 2097151) 'sortedAndDisjoint'
		score = score + 1
	end 'sortedAndDisjoint'
	return score as ExitCode
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl __ucd_supp_at
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl __ucd_supp_at
    arm64.movImm x1, 0
    arm64.and x2, x19, 2097151
    arm64.cmp x2, 65536
    arm64.b.ne ifcont#2
  rangeStart:
    arm64.movImm x1, 1
  ifcont#2:
    arm64.asr x2, x19, 21
    arm64.and x2, x2, 2097151
    arm64.movImm x16, 65547
    arm64.cmp x2, x16
    arm64.b.ne ifcont#4
  rangeEnd:
    arm64.add x1, x1, 1
  ifcont#4:
    arm64.asr x3, x19, 42
    arm64.and x3, x3, 31
    arm64.cmp x3, 5
    arm64.b.ne ifcont#6
  category:
    arm64.add x1, x1, 1
  ifcont#6:
    arm64.and x3, x0, 2097151
    arm64.movImm x16, 65549
    arm64.cmp x3, x16
    arm64.b.ne ifcont#8
  nextRangeStart:
    arm64.add x1, x1, 1
  ifcont#8:
    arm64.asr x0, x0, 21
    arm64.and x0, x0, 2097151
    arm64.movImm x16, 65574
    arm64.cmp x0, x16
    arm64.b.ne critsplit
  nextRangeEnd:
    arm64.add x0, x1, 1
    arm64.b ifcont#10
  critsplit:
    arm64.movRegReg x0, x1
  ifcont#10:
    arm64.cmp x3, x2
    arm64.b.le ifcont#12
  sortedAndDisjoint:
    arm64.add x0, x0, 1
  ifcont#12:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at builtins-ucd.supp-i64-load.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
