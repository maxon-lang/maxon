// Test: builtins-ucd.bmp-byte-load-is-zero-extended
function main() returns ExitCode
	var i = 0
	var negatives = 0
	while i < 65536 'scan'
		if __Builtins.ucdByteAt("__ucd_bmp", offset: i) < 0 'negative'
			negatives = negatives + 1
		end 'negative'
		i = i + 1
	end 'scan'
	if negatives == 0 'allUnsigned'
		return 5
	end 'allUnsigned'
	return 1
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x19, 65536
    arm64.b.ge whileexit
  scan:
    arm64.movRegReg x0, x19
    arm64.bl __ucd_bmp_at
    arm64.cmp x0, 0
    arm64.b.ge critsplit
  negative:
    arm64.add x0, x20, 1
    arm64.b ifcont#5
  critsplit:
    arm64.movRegReg x0, x20
  ifcont#5:
    arm64.add x19, x19, 1
    arm64.movRegReg x20, x0
    arm64.b whilehdr
  whileexit:
    arm64.cmp x20, 0
    arm64.b.ne ifcont#7
  allUnsigned:
    arm64.movImm x0, 5
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#7:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
