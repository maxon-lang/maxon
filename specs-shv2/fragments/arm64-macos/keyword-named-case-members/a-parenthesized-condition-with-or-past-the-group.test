// Test: a-parenthesized-condition-with-or-past-the-group
function main() returns ExitCode
	var i = 0
	var acc = 0
	while ((i < 2) or (i < 0)) or false 'spin'
		if ((i == 0) or (i == 1)) and true 'inner'
			acc = acc + 21
		end 'inner'
		i = i + 1
	end 'spin'
	if acc == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x0, 2
    arm64.cset x2, lt
    arm64.movImm x6, 1
    arm64.cbnz x2, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.cmp x0, 0
    arm64.cset x2, lt
    arm64.movRegReg x6, x2
    arm64.b scmerge
  scmerge:
    arm64.movImm x2, 1
    arm64.cbnz x6, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.movImm x2, 0
    arm64.b scmerge
  scmerge:
    arm64.cbnz x2, spin
    arm64.b whileexit
  spin:
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.movImm x6, 1
    arm64.cbnz x2, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.cmp x0, 1
    arm64.cset x2, eq
    arm64.movRegReg x6, x2
    arm64.b scmerge
  scmerge:
    arm64.movImm x2, 0
    arm64.cbnz x6, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movImm x2, 1
    arm64.b scmerge
  critsplit:
    arm64.b scmerge
  scmerge:
    arm64.cbnz x2, inner
    arm64.b critsplit
  inner:
    arm64.add x1, x1, 21
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x1, 42
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
