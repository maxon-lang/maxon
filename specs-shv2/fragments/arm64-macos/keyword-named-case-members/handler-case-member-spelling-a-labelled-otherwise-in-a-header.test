// Test: handler-case-member-spelling-a-labelled-otherwise-in-a-header
enum Kw
	otherwise
	alpha
end 'Kw'

function main() returns ExitCode
	var k = Kw.alpha
	var i = 0
	while k == Kw.otherwise 'loop'
		i = i + 1
	end 'loop'

	if k == Kw.otherwise 'chk'
		i = 9
	end 'chk'

	return (42 + i) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, chk
    arm64.b critsplit
  chk:
    arm64.movImm x0, 9
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b ifcont
  ifcont:
    arm64.add x0, x0, 42
    arm64.epilogue 16
    arm64.ret
}
