// Test: handler-case-member-spelling-a-labelled-otherwise-in-a-header
enum Kw
	otherwise
	alpha
end 'Kw'

function main() returns ExitCode
	let k = Kw.alpha
	var i = 0
	while k == Kw.otherwise 'loop'
		i = i + 1
	end 'loop'

	if k == Kw.otherwise 'chk'
		i = 9
	end 'chk'

	return (42 + i) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.b whilehdr
  whilehdr:
    arm64.b whileexit
  whileexit:
    arm64.b ifcont
  ifcont:
    arm64.add x0, x0, 42
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at handler-case-member-spelling-a-labelled-otherwise-in-a-header.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
