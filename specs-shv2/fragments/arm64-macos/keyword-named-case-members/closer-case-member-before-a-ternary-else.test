// Test: closer-case-member-before-a-ternary-else
enum Kw
	alpha
	end
	omega
end 'Kw'

function main() returns ExitCode
	var acc = 0
	var i = 0
	while i < 2 'spin'
		let x = 1 if i == 0 or Kw.end == Kw.end else 2
		acc = acc + x
		i = i + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  whilehdr:
    arm64.cmp x1, 2
    arm64.b.ge whileexit
  spin:
    arm64.cmp x1, 0
    arm64.movImm x2, 1
    arm64.b.eq scmerge
  orrhs:
    arm64.movImm x2, 1
  scmerge:
    arm64.cbz x2, ternaryfalse
  ternarytrue:
    arm64.movImm x2, 1
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x2, 2
  matchcont:
    arm64.add x0, x0, x2
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at closer-case-member-before-a-ternary-else.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
