// Test: constructing-a-payload-carrying-keyword-case
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	end(a Num, b Num)
end 'Kw'

function tagOf(k Kw) returns Num
	match k 'm'
		alpha(n) then return n
		end(a, b) then return a + b
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var acc = 0
	var i = 0
	while i < 2 'spin'
		if tagOf(Kw.end(20, b: 1)) == 21 'ok'
			acc = acc + 21
		end 'ok'
		i = i + 1
	end 'spin'
	return acc as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tagOf {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 16]
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at constructing-a-payload-carrying-keyword-case.test:12: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x20, 2
    arm64.b.ge whileexit
  spin:
    arm64.movImm x21, 20
    arm64.movImm x22, 1
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 0], x0
    arm64.storeBaseDispReg.word64 [x23 + 8], x21
    arm64.storeBaseDispReg.word64 [x23 + 16], x22
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x23 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#11:
    arm64.loadRegBaseDisp.word64 x0, [x23 + 8]
    arm64.b __il_cont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#12:
    arm64.loadRegBaseDisp.word64 x0, [x23 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x23 + 16]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __il_slow
  __rc_chk#17:
    arm64.cmp x0, 1000
    arm64.b.le __il_cont
  __il_slow:
    arm64.movRegReg x0, x23
    arm64.bl tagOf
  __il_cont:
    arm64.cmp x0, 21
    arm64.cset x21, eq
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.cbz x21, critsplit
  ok:
    arm64.add x0, x19, 21
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
  ifcont:
    arm64.add x20, x20, 1
    arm64.movRegReg x19, x0
    arm64.b whilehdr
  matchdead:
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk#8:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at constructing-a-payload-carrying-keyword-case.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
