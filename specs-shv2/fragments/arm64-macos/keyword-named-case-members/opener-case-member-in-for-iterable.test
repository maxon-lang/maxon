// Test: opener-case-member-in-for-iterable
enum Kw
	alpha
	for
	omega
end 'Kw'

function tagOf(k Kw) returns int
	match k 'm'
		alpha then return 1
		for then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var acc = 0
	for i in 0 upto tagOf(Kw.for) 'each'
		acc = acc + 10 + i
	end 'each'
	return acc as ExitCode
end 'main'
---
ExitCode: 21
---
func @tagOf {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.movImm x0, 1
    arm64.bl tagOf
    arm64.b forhdr
  forhdr:
    arm64.cmp x20, x0
    arm64.cset x1, lt
    arm64.cbnz x1, each
    arm64.b forexit
  each:
    arm64.add x1, x19, 10
    arm64.add x19, x1, x20
    arm64.b forstep
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
