// Test: closer-case-member-in-while-condition
enum Kw
	alpha
	end
	omega
end 'Kw'

function tagOf(k Kw) returns Integer
	match k 'm'
		alpha then return 1
		end then return 2
		omega then return 3
	end 'm'
end 'tagOf'

function main() returns ExitCode
	var n = 0
	var acc = 0
	while n < tagOf(Kw.end) 'spin'
		acc = acc + 10
		n = n + 1
	end 'spin'
	return acc as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.b __il_body
  __il_body:
    arm64.b matchnext
  matchnext:
    arm64.b matcharm
  matcharm:
    arm64.movImm x2, 2
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, x2
    arm64.cset x2, lt
    arm64.cbnz x2, spin
    arm64.b whileexit
  spin:
    arm64.add x1, x1, 10
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at closer-case-member-in-while-condition.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}
