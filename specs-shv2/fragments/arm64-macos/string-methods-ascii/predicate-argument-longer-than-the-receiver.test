// Test: predicate-argument-longer-than-the-receiver
function main() returns ExitCode
	let s = "hi"
	if s.startsWith("hello") 'a'
		print("badStart\n")
	end 'a'
	if s.endsWith("hello") 'b'
		print("badEnd\n")
	end 'b'
	if s.contains("hello") 'c'
		print("badContains\n")
	end 'c'
	if s.startsWith("") 'd'
		print("emptyPrefix\n")
	end 'd'
	if s.endsWith("") 'e'
		print("emptySuffix\n")
	end 'e'
	if s.contains("") 'f'
		print("emptyNeedle\n")
	end 'f'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x19
    arm64.bl __str_starts_with
    arm64.cbnz x0, a
    arm64.b ifcont
  a:
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x19
    arm64.bl __str_ends_with
    arm64.cbnz x0, b
    arm64.b ifcont
  b:
    arm64.leaRdata x0, __str_rec_7
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __str_rec_3
    arm64.movRegReg x0, x19
    arm64.bl __str_contains
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.leaRdata x0, __str_rec_9
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __str_rec_11
    arm64.movRegReg x0, x19
    arm64.bl __str_starts_with
    arm64.cbnz x0, d
    arm64.b ifcont
  d:
    arm64.leaRdata x0, __str_rec_13
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __str_rec_11
    arm64.movRegReg x0, x19
    arm64.bl __str_ends_with
    arm64.cbnz x0, e
    arm64.b ifcont
  e:
    arm64.leaRdata x0, __str_rec_15
    arm64.bl __print_string
    arm64.b ifcont
  ifcont:
    arm64.leaRdata x1, __str_rec_11
    arm64.movRegReg x0, x19
    arm64.bl __str_contains
    arm64.cbnz x0, f
    arm64.b ifcont
  f:
