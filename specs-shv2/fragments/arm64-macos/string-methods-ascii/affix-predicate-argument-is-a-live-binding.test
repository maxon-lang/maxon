// Test: affix-predicate-argument-is-a-live-binding
function main() returns ExitCode
	let s = "prefix-body-suffix"
	let p = "prefix"
	if s.startsWith(p) 'a'
		print("first\n")
	end 'a'
	if s.startsWith(p) 'b'
		print("second\n")
	end 'b'
	print("{p.byteLength()}\n")
	print("[{p}]\n")
	return 0
end 'main'
