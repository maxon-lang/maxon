// Test: opaque-append-managed
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Container uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray
	export var extra as ElementArray

	export static function create() returns Self
		return Self{ items: ElementArray.create(), extra: ElementArray.create() }
	end 'create'

	export function pushItem(item Element)
		self.items.push(item)
	end 'pushItem'

	export function pushExtra(item Element)
		self.extra.push(item)
	end 'pushExtra'

	export function count() returns Count
		return self.items.count()
	end 'count'

	export function mergeExtra()
		self.items.append(self.extra)
	end 'mergeExtra'
end 'Container'

typealias StringContainer = Container with String

function buildAppended() returns StringContainer
	var dest = StringContainer.create()
	dest.pushItem("dest string long enough to force a heap allocation")
	dest.pushExtra("extra one long enough to force a heap allocation")
	dest.pushExtra("extra two long enough to force a heap allocation")
	dest.mergeExtra()
	return dest
end 'buildAppended'

function main() returns ExitCode
	var appended = buildAppended()
	let c = appended.count()
	if c == 3 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Container.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.loadRegBaseDisp.word64 x1, [x19 + 40]
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 8
    arm64.loadRegBaseDisp.word64 x1, [x19 + 40]
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Container.pushItem {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __managed_push
    arm64.epilogue 16
    arm64.ret
}

func @Container.pushExtra {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __managed_push
    arm64.epilogue 16
    arm64.ret
}

func @Container.count {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __managed_count
    arm64.epilogue 16
    arm64.ret
}

func @Container.mergeExtra {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x6
    arm64.bl __managed_append_opaque
    arm64.epilogue 16
    arm64.ret
}

func @buildAppended {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Container_String
    arm64.bl Container.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 48
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Container.pushItem
    arm64.leaRdata x0, __str_rec_3
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 48
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Container.pushExtra
    arm64.leaRdata x0, __str_rec_5
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 48
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Container.pushExtra
    arm64.leaRdata x1, __layout_Container_String
    arm64.movRegReg x0, x19
    arm64.bl Container.mergeExtra
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl buildAppended
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Container.count
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Container_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Container_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
