// Test: pop-opaque-struct-element
typealias ExitCode = int(0 to 125)
typealias Integer = int(i64.min to i64.max)

type Pair
	export var name as String
	export var value as Integer

	static function create(name String, value Integer) returns Self
		return Self{name: name, value: value}
	end 'create'
end 'Pair'

type Container uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray

	export static function create() returns Self
		return Self{ items: ElementArray.create() }
	end 'create'

	export function push(item Element)
		self.items.push(item)
	end 'push'

	export function drainOne()
		_ = try self.items.pop() otherwise return
	end 'drainOne'
end 'Container'

typealias PairContainer = Container with Pair

function main() returns ExitCode
	var pc = PairContainer.create()
	pc.push(Pair.create("first pair string long enough for heap", value: 1))
	pc.push(Pair.create("second pair string long enough for heap", value: 2))
	pc.drainOne()
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Container.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Container.push {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __managed_push
    arm64.epilogue 16
    arm64.ret
}

func @Container.drainOne {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movRegReg x1, x19
    arm64.bl Array.pop
    arm64.movRegReg x1, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __drop_type_param
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Container_Pair
    arm64.bl Container.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_2  ; "first pair string long enough for heap"
    arm64.movImm x20, 1
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x0, x22, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 56
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x24, x22
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x22
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.bl Pair.create
    arm64.movRegReg x1, x0
    arm64.leaRdata x2, __layout_Container_Pair
    arm64.movRegReg x0, x19
    arm64.bl Container.push
    arm64.leaRdata x0, __str_rec_3  ; "second pair string long enough for heap"
    arm64.movImm x20, 2
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x0, x22, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 56
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x24, x22
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x22
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.bl Pair.create
    arm64.movRegReg x1, x0
    arm64.leaRdata x2, __layout_Container_Pair
    arm64.movRegReg x0, x19
    arm64.bl Container.push
    arm64.leaRdata x1, __layout_Container_Pair
    arm64.movRegReg x0, x19
    arm64.bl Container.drainOne
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Container_Pair
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
