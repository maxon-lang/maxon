// Test: a-fully-typed-transform-is-not-this-diagnostics-business
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let nums = [1, 2, 3]
	let out = nums.map(function(a Integer, b Integer) gives a + b)
	var sum = 0
	for n in out 'loop'
		sum = sum + n
	end 'loop'
	print("sum={sum}\n")
	return 0
end 'main'
