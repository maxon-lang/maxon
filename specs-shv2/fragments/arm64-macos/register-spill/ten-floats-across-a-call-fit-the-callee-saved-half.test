// Test: ten-floats-across-a-call-fit-the-callee-saved-half
function bump(x int) returns int
	return x + 1
end 'bump'

function pressure(k int) returns int
	let a = 1.0
	let b = 2.0
	let c = 3.0
	let d = 4.0
	let e = 5.0
	let f = 6.0
	let g = 7.0
	let h = 8.0
	let i = 9.0
	let j = 10.0
	var acc = k
	acc = bump(acc)
	acc = acc + trunc(a) + trunc(b) + trunc(c) + trunc(d) + trunc(e)
	acc = acc + trunc(f) + trunc(g) + trunc(h) + trunc(i) + trunc(j)
	return acc
end 'pressure'

function main() returns ExitCode
	return pressure(0) as ExitCode
end 'main'
---
ExitCode: 56
---
func @bump {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @pressure {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, d15
    arm64.storeSlotReg slot8, d14
    arm64.storeSlotReg slot7, d13
    arm64.storeSlotReg slot6, d12
    arm64.storeSlotReg slot5, d11
    arm64.storeSlotReg slot4, d10
    arm64.storeSlotReg slot3, d9
    arm64.storeSlotReg slot2, d8
    arm64.fpLoadRdata d8, [rdata + __fconst_0]
    arm64.fpLoadRdata d9, [rdata + __fconst_1]
    arm64.fpLoadRdata d10, [rdata + __fconst_2]
    arm64.fpLoadRdata d11, [rdata + __fconst_3]
    arm64.fpLoadRdata d12, [rdata + __fconst_4]
    arm64.fpLoadRdata d13, [rdata + __fconst_5]
    arm64.fpLoadRdata d14, [rdata + __fconst_6]
    arm64.fpLoadRdata d15, [rdata + __fconst_7]
    arm64.fpLoadRdata d0, [rdata + __fconst_8]
    arm64.storeSlotReg slot1, d0
    arm64.fpLoadRdata d0, [rdata + __fconst_9]
    arm64.storeSlotReg slot0, d0
    arm64.bl bump
    arm64.fcvtzs x1, d8
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d9
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d10
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d11
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d12
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d13
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d14
    arm64.add x0, x0, x1
    arm64.fcvtzs x1, d15
    arm64.add x0, x0, x1
    arm64.loadRegSlot d0, slot1
    arm64.fcvtzs x1, d0
    arm64.add x0, x0, x1
    arm64.loadRegSlot d0, slot0
    arm64.fcvtzs x1, d0
    arm64.add x0, x0, x1
    arm64.loadRegSlot d8, slot2
    arm64.loadRegSlot d9, slot3
    arm64.loadRegSlot d10, slot4
    arm64.loadRegSlot d11, slot5
    arm64.loadRegSlot d12, slot6
    arm64.loadRegSlot d13, slot7
    arm64.loadRegSlot d14, slot8
    arm64.loadRegSlot d15, slot9
    arm64.epilogue 96
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl pressure
    arm64.epilogue 16
    arm64.ret
}
