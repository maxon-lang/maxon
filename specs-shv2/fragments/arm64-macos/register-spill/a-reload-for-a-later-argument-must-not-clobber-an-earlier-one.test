    arm64.add x19, x0, 16
    arm64.add x20, x0, 17
    arm64.add x21, x0, 18
    arm64.add x22, x0, 19
    arm64.add x23, x0, 20
    arm64.add x24, x0, 21
    arm64.add x25, x0, 22
    arm64.add x26, x0, 23
    arm64.add x27, x0, 24
    arm64.add x28, x0, 25
    arm64.storeSlotReg slot1, x28
    arm64.add x28, x0, 26
    arm64.storeSlotReg slot2, x28
    arm64.add x28, x0, 27
    arm64.add x0, x0, 28
    arm64.add x3, x2, x3
    arm64.add x3, x3, x4
    arm64.add x3, x3, x5
    arm64.add x3, x3, x6
    arm64.add x3, x3, x7
    arm64.add x3, x3, x1
    arm64.add x3, x3, x8
    arm64.add x3, x3, x9
    arm64.add x3, x3, x10
    arm64.add x3, x3, x11
    arm64.add x3, x3, x12
    arm64.add x3, x3, x13
    arm64.add x3, x3, x14
    arm64.add x3, x3, x15
    arm64.add x3, x3, x19
    arm64.add x3, x3, x20
    arm64.add x3, x3, x21
    arm64.add x3, x3, x22
    arm64.add x3, x3, x23
    arm64.add x3, x3, x24
    arm64.add x3, x3, x25
    arm64.add x3, x3, x26
    arm64.add x3, x3, x27
    arm64.loadRegSlot x5, slot1
    arm64.add x3, x3, x5
    arm64.loadRegSlot x5, slot2
    arm64.add x3, x3, x5
    arm64.add x3, x3, x28
    arm64.add x0, x3, x0
  __il_body:
    arm64.movImm x16, 1000
    arm64.mul x2, x2, x16
    arm64.movImm x16, 100
    arm64.loadRegSlot x3, slot0
    arm64.mul x3, x3, x16
    arm64.add x2, x2, x3
    arm64.movImm x16, 10
    arm64.mul x3, x4, x16
    arm64.add x2, x2, x3
    arm64.add x1, x2, x1
  __il_cont:
    arm64.add x0, x0, x1
    arm64.loadRegSlot x19, slot3
    arm64.loadRegSlot x20, slot4
    arm64.loadRegSlot x21, slot5
    arm64.loadRegSlot x22, slot6
    arm64.loadRegSlot x23, slot7
    arm64.loadRegSlot x24, slot8
    arm64.loadRegSlot x25, slot9
    arm64.loadRegSlot x26, slot10
    arm64.loadRegSlot x27, slot11
    arm64.loadRegSlot x28, slot12
    arm64.epilogue 128
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl f
    arm64.cmp x0, 1643
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
