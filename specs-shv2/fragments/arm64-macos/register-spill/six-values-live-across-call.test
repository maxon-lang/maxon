// Test: six-values-live-across-call
function sink(x int) returns int
	return x
end 'sink'

function caller(p int) returns int
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let r = sink(p)
	return a1 + a2 + a3 + a4 + a5 + a6 + r
end 'caller'

function main() returns ExitCode
	return caller(0)
end 'main'
---
ExitCode: 21
---
func @sink {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @caller {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x19, x0, 1
    arm64.add x20, x0, 2
    arm64.add x21, x0, 3
    arm64.add x22, x0, 4
    arm64.add x23, x0, 5
    arm64.add x24, x0, 6
    arm64.bl sink
    arm64.add x1, x19, x20
    arm64.add x1, x1, x21
    arm64.add x1, x1, x22
    arm64.add x1, x1, x23
    arm64.add x1, x1, x24
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl caller
    arm64.epilogue 16
    arm64.ret
}
