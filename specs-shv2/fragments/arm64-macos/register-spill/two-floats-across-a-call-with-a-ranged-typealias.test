// Test: two-floats-across-a-call-with-a-ranged-typealias
typealias Num = int(-1000000000 to 1000000000)

function work(x Num) returns Num
	return x + 1
end 'work'

function probe(k Num) returns Num
	let f0 = 1.5
	let f2 = 3.625
	var acc = k
	acc = work(acc)
	acc = acc + trunc(f2 * f0 * 64.0)
	return acc
end 'probe'

function main() returns ExitCode
	return (probe(1) - probe(0) + 41) as ExitCode
end 'main'
---
ExitCode: 42
---
func @work {
  entry:
    arm64.prologue 16
    arm64.cmp x0, -1000000000
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000000000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.add x0, x0, 1
    arm64.cmp x0, -1000000000
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000000000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @probe {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, d9
    arm64.storeSlotReg slot0, d8
    arm64.cmp x0, -1000000000
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000000000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot d8, slot0
    arm64.loadRegSlot d9, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.fpLoadRdata d8, [rdata + __fconst_4]
    arm64.fpLoadRdata d9, [rdata + __fconst_5]
    arm64.bl work
    arm64.fmul d0, d9, d8
    arm64.fpLoadRdata d1, [rdata + __fconst_6]
    arm64.fmul d0, d0, d1
    arm64.fcvtzs x1, d0
    arm64.add x0, x0, x1
    arm64.cmp x0, -1000000000
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000000000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot d8, slot0
    arm64.loadRegSlot d9, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot d8, slot0
    arm64.loadRegSlot d9, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl probe
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.bl probe
    arm64.sub x0, x19, x0
    arm64.add x0, x0, 41
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
