func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl f
    arm64.cmp x0, 664
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
