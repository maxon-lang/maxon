// Test: two-floats-multiplied-between-calls
function work(x Integer) returns Integer
	return x + 1
end 'work'

function main() returns ExitCode
	let a = 1.5
	let b = 2.5
	var s = 0.0
	var acc = 0
	acc = work(acc)
	s = s + a * b
	acc = work(acc)
	s = s + a * b
	return trunc(s) + acc
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 9
---
