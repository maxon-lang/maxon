    arm64.fpLoadRdata d1, [rdata + __fconst_3.75]
    arm64.fadd d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.add x0, x0, 2
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
