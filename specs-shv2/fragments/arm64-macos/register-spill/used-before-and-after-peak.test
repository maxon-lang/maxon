// Test: used-before-and-after-peak
function usedBeforeAndAfter(p Integer) returns Integer
	let a1 = p + 1
	let w = a1 + p
	let b1 = p + 1
	let b2 = p + 2
	let b3 = p + 3
	let b4 = p + 4
	let b5 = p + 5
	let b6 = p + 6
	let b7 = p + 7
	let b8 = p + 8
	let b9 = p + 9
	let b10 = p + 10
	let b11 = p + 11
	let b12 = p + 12
	let b13 = p + 13
	let b14 = p + 14
	let b15 = p + 15
	let peak = b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + b13 + b14 + b15 + w
	let z = a1 + peak
	return z
end 'usedBeforeAndAfter'

function main() returns ExitCode
	return usedBeforeAndAfter(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 122
---
func @usedBeforeAndAfter {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x1, x0
    arm64.add x3, x0, 2
    arm64.add x4, x0, 3
    arm64.add x5, x0, 4
    arm64.add x6, x0, 5
    arm64.add x7, x0, 6
    arm64.add x8, x0, 7
    arm64.add x9, x0, 8
    arm64.add x10, x0, 9
    arm64.add x11, x0, 10
    arm64.add x12, x0, 11
    arm64.add x13, x0, 12
    arm64.add x14, x0, 13
    arm64.add x15, x0, 14
    arm64.add x0, x0, 15
    arm64.add x3, x1, x3
    arm64.add x3, x3, x4
    arm64.add x3, x3, x5
    arm64.add x3, x3, x6
    arm64.add x3, x3, x7
    arm64.add x3, x3, x8
    arm64.add x3, x3, x9
    arm64.add x3, x3, x10
    arm64.add x3, x3, x11
    arm64.add x3, x3, x12
    arm64.add x3, x3, x13
    arm64.add x3, x3, x14
    arm64.add x3, x3, x15
    arm64.add x0, x3, x0
    arm64.add x0, x0, x2
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl usedBeforeAndAfter
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at used-before-and-after-peak.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
