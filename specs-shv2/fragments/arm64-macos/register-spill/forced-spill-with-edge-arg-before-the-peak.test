// Test: forced-spill-with-edge-arg-before-the-peak
function leaf(x int) returns int
	return x + 1
end 'leaf'

function edgeAnchor(p int, q int) returns int
	let t = p + q
	var a1 = p + 1
	var a2 = p + 2
	var a3 = p + 3
	var a4 = p + 4
	var a5 = p + 5
	var a6 = p + 6
	var a7 = p + 7
	var a8 = p + 8
	var m = 0
	if p > 0 'br'
		m = t
	end 'br'
	let r = leaf(p)
	return a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + m + r + t
end 'edgeAnchor'

function main() returns ExitCode
	if edgeAnchor(1, q: 2) != 52 'taken'
		return 1
	end 'taken'
	if edgeAnchor(0, q: 2) != 39 'skipped'
		return 2
	end 'skipped'
	return 0
end 'main'
---
ExitCode: 0
---
func @leaf {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @edgeAnchor {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x19, x0, x1
    arm64.add x20, x0, 1
    arm64.add x21, x0, 2
    arm64.add x22, x0, 3
    arm64.add x23, x0, 4
    arm64.add x24, x0, 5
    arm64.add x25, x0, 6
    arm64.add x26, x0, 7
    arm64.add x27, x0, 8
    arm64.movImm x28, 0
    arm64.cmp x0, 0
    arm64.cset x1, gt
    arm64.cbnz x1, br
    arm64.b critsplit
  br:
    arm64.movRegReg x28, x19
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.bl leaf
    arm64.add x1, x20, x21
    arm64.add x1, x1, x22
    arm64.add x1, x1, x23
    arm64.add x1, x1, x24
    arm64.add x1, x1, x25
    arm64.add x1, x1, x26
    arm64.add x1, x1, x27
    arm64.add x1, x1, x28
    arm64.add x0, x1, x0
    arm64.add x0, x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.loadRegSlot x28, slot9
    arm64.epilogue 96
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl edgeAnchor
    arm64.cmp x0, 52
    arm64.cset x0, ne
    arm64.cbnz x0, taken
    arm64.b ifcont
  taken:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.movImm x1, 2
    arm64.bl edgeAnchor
    arm64.cmp x0, 39
    arm64.cset x0, ne
    arm64.cbnz x0, skipped
    arm64.b ifcont
  skipped:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
