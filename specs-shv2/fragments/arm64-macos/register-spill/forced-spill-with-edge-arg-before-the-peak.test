// Test: forced-spill-with-edge-arg-before-the-peak
function leaf(x Integer) returns Integer
	return x + 1
end 'leaf'

function edgeAnchor(p Integer, q Integer) returns Integer
	let t = p + q
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let a7 = p + 7
	let a8 = p + 8
	var m = 0
	if p > 0 'br'
		m = t
	end 'br'
	let r = leaf(p)
	return a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + m + r + t
end 'edgeAnchor'

function main() returns ExitCode
	if edgeAnchor(1, q: 2) != 52 'taken'
		return 1
	end 'taken'
	if edgeAnchor(0, q: 2) != 39 'skipped'
		return 2
	end 'skipped'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @edgeAnchor {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, x1
    arm64.add x2, x0, 1
    arm64.add x3, x0, 2
    arm64.add x4, x0, 3
    arm64.add x5, x0, 4
    arm64.add x6, x0, 5
    arm64.add x7, x0, 6
    arm64.add x8, x0, 7
    arm64.add x9, x0, 8
    arm64.movImm x10, 0
    arm64.cmp x0, 0
    arm64.cset x0, gt
    arm64.cbnz x0, br
    arm64.b critsplit
  br:
    arm64.movRegReg x0, x1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x10
    arm64.b ifcont
  ifcont:
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.add x3, x2, x3
    arm64.add x3, x3, x4
    arm64.add x3, x3, x5
    arm64.add x3, x3, x6
    arm64.add x3, x3, x7
    arm64.add x3, x3, x8
    arm64.add x3, x3, x9
    arm64.add x0, x3, x0
    arm64.add x0, x0, x2
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl edgeAnchor
    arm64.cmp x0, 52
    arm64.cset x0, ne
    arm64.cbnz x0, taken
    arm64.b ifcont#2
  taken:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.movImm x0, 0
    arm64.movImm x1, 2
    arm64.bl edgeAnchor
    arm64.cmp x0, 39
    arm64.cset x0, ne
    arm64.cbnz x0, skipped
    arm64.b ifcont#4
  skipped:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
