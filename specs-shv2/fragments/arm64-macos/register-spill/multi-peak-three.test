// Test: multi-peak-three
function f(p Integer) returns Integer
	let a = p + 100
	let b1 = p + 1
	let b2 = p + 2
	let b3 = p + 3
	let b4 = p + 4
	let b5 = p + 5
	let b6 = p + 6
	let b7 = p + 7
	let b8 = p + 8
	let b9 = p + 9
	let b10 = p + 10
	let b11 = p + 11
	let b12 = p + 12
	let b13 = p + 13
	let s1 = b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + b10 + b11 + b12 + b13
	let u1 = a + s1
	let c1 = p + 1
	let c2 = p + 2
	let c3 = p + 3
	let c4 = p + 4
	let c5 = p + 5
	let c6 = p + 6
	let c7 = p + 7
	let c8 = p + 8
	let c9 = p + 9
	let c10 = p + 10
	let c11 = p + 11
	let c12 = p + 12
	let c13 = p + 13
	let s2 = c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9 + c10 + c11 + c12 + c13
	let u2 = a + s2
	let d1 = p + 1
	let d2 = p + 2
	let d3 = p + 3
	let d4 = p + 4
	let d5 = p + 5
	let d6 = p + 6
	let d7 = p + 7
	let d8 = p + 8
	let d9 = p + 9
	let d10 = p + 10
	let d11 = p + 11
	let d12 = p + 12
	let d13 = p + 13
	let s3 = d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 + d9 + d10 + d11 + d12 + d13
	let u3 = a + s3
	return u1 + u2 + u3
end 'f'

function main() returns ExitCode
	let r = f(0)
	if r == 573 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @f {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 100
    arm64.add x2, x0, 1
    arm64.add x3, x0, 2
    arm64.add x4, x0, 3
    arm64.add x5, x0, 4
    arm64.add x6, x0, 5
    arm64.add x7, x0, 6
    arm64.add x8, x0, 7
    arm64.add x9, x0, 8
    arm64.add x10, x0, 9
    arm64.add x11, x0, 10
    arm64.add x12, x0, 11
    arm64.add x13, x0, 12
    arm64.add x0, x0, 13
    arm64.add x2, x2, x3
    arm64.add x2, x2, x4
    arm64.add x2, x2, x5
    arm64.add x2, x2, x6
    arm64.add x2, x2, x7
    arm64.add x2, x2, x8
    arm64.add x2, x2, x9
    arm64.add x2, x2, x10
    arm64.add x2, x2, x11
    arm64.add x2, x2, x12
    arm64.add x2, x2, x13
    arm64.add x0, x2, x0
    arm64.add x0, x1, x0
    arm64.add x1, x0, x0
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl f
    arm64.cmp x0, 573
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
