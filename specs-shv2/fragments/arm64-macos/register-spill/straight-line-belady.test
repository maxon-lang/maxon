// Test: straight-line-belady
function straightLine(p int) returns int
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let a7 = p + 7
	let a8 = p + 8
	let a9 = p + 9
	let a10 = p + 10
	let a11 = p + 11
	let a12 = p + 12
	let a13 = p + 13
	let a14 = p + 14
	let a15 = p + 15
	let a16 = p + 16
	let a17 = p + 17
	let a18 = p + 18
	return a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18
end 'straightLine'

function main() returns ExitCode
	return straightLine(0)
end 'main'
