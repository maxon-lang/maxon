// Test: loop-invariant-read-across-a-call-in-a-loop
function sink(x int) returns int
	return x
end 'sink'

function invariantsAcrossCall(p int) returns int
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	var acc = 0
	var i = 0
	while i < 3 'loop'
		let pre = acc + a1 + a2 + a3 + a4 + a5 + a6
		let r = sink(i)
		acc = pre + r + a1 + a2 + a3 + a4 + a5 + a6
		i = i + 1
	end 'loop'
	return acc
end 'invariantsAcrossCall'

function main() returns ExitCode
	return invariantsAcrossCall(0)
end 'main'
---
ExitCode: 129
---
func @sink {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @invariantsAcrossCall {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x19, x0, 1
    arm64.add x20, x0, 2
    arm64.add x21, x0, 3
    arm64.add x22, x0, 4
    arm64.add x23, x0, 5
    arm64.add x24, x0, 6
    arm64.movImm x0, 0
    arm64.movImm x25, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x25, 3
    arm64.cset x1, lt
    arm64.cbnz x1, loop
    arm64.b whileexit
  loop:
    arm64.add x0, x0, x19
    arm64.add x0, x0, x20
    arm64.add x0, x0, x21
    arm64.add x0, x0, x22
    arm64.add x0, x0, x23
    arm64.add x26, x0, x24
    arm64.movRegReg x0, x25
    arm64.bl sink
    arm64.add x0, x26, x0
    arm64.add x0, x0, x19
    arm64.add x0, x0, x20
    arm64.add x0, x0, x21
    arm64.add x0, x0, x22
    arm64.add x0, x0, x23
    arm64.add x0, x0, x24
    arm64.add x25, x25, 1
    arm64.b whilehdr
  whileexit:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl invariantsAcrossCall
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
