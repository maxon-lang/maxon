// Test: idle-across-loop
function idleAcrossLoop(p int) returns int
	let k1 = p + 1
	let k2 = p + 2
	let k3 = p + 3
	let k4 = p + 4
	let k5 = p + 5
	let k6 = p + 6
	let k7 = p + 7
	let k8 = p + 8
	let k9 = p + 9
	let k10 = p + 10
	let k11 = p + 11
	let k12 = p + 12
	let k13 = p + 13
	let k14 = p + 14
	let k15 = p + 15
	var sum = 0
	var i = 0
	while i < 4 'loop'
		sum = sum + i
		i = i + 1
	end 'loop'
	return sum + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + k12 + k13 + k14 + k15
end 'idleAcrossLoop'

function main() returns ExitCode
	return idleAcrossLoop(0)
end 'main'
---
ExitCode: 126
---
func @idleAcrossLoop {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x6, x0, 3
    arm64.add x7, x0, 4
    arm64.add x8, x0, 5
    arm64.add x9, x0, 6
    arm64.add x10, x0, 7
    arm64.add x11, x0, 8
    arm64.add x19, x0, 9
    arm64.add x20, x0, 10
    arm64.add x21, x0, 11
    arm64.add x22, x0, 12
    arm64.add x23, x0, 13
    arm64.add x24, x0, 14
    arm64.add x0, x0, 15
    arm64.movImm x25, 0
    arm64.movImm x26, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x26, 4
    arm64.cset x27, lt
    arm64.cbnz x27, loop
    arm64.b whileexit
  loop:
    arm64.add x25, x25, x26
    arm64.add x26, x26, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x1, x25, x1
    arm64.add x1, x1, x2
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
    arm64.add x1, x1, x9
    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x1, x1, x19
    arm64.add x1, x1, x20
    arm64.add x1, x1, x21
    arm64.add x1, x1, x22
    arm64.add x1, x1, x23
    arm64.add x1, x1, x24
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.epilogue 96
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl idleAcrossLoop
    arm64.epilogue 16
    arm64.ret
}
