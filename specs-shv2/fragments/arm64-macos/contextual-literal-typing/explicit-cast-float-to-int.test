// Test: explicit-cast-float-to-int
function main() returns ExitCode
	let x = 5
	let y = 5.0
	if x == trunc(y) 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b check
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
