// Test: byte-vs-byte

typealias Byte = int(0 to u8.max)

function main() returns ExitCode
	let a = 50 as Byte
	let b = 50 as Byte
	if a == b 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
