// Test: round.negative
function main() returns ExitCode
	let neg = -2.3
	let y = trunc(round(neg))
	return y + 10
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.frintn d0, d0
    arm64.fcvtzs x0, d0
    arm64.add x0, x0, 10
    arm64.epilogue 16
    arm64.ret
}
