// Test: round.halfway
function main() returns ExitCode
	let x = 2.5
	let y = trunc(round(x))
	return y
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.frintn d0, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
