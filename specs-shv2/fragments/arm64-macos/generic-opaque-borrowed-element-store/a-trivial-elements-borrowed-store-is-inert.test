// Test: a-trivial-elements-borrowed-store-is-inert
typealias Idx = int(0 to u64.max)
typealias Num = int(0 to 1000)
typealias Nums = Array with Num

type Bag uses Element
	typealias Items = Array with Element
	export var items as Items

	export static function create() returns Self
		return Self{items: Items.create()}
	end 'create'

	export function count() returns Idx
		return items.count()
	end 'count'

	export function copyFrom(other Items)
		let n = other.count()
		for i in 0 upto n 'copy'
			let value = try other.get(i) otherwise 'getErr'
				panic("Bag.copyFrom: get OOB — i < the count just read")
			end 'getErr'
			items.push(value)
		end 'copy'
	end 'copyFrom'

	export function at(i Idx) returns Element throws ArrayError
		return try items.get(i)
	end 'at'
end 'Bag'

typealias NumBag = Bag with Num

function main() returns ExitCode
	var b = NumBag.create()
	var source = Nums.create()
	source.push(4 as Num)
	source.push(7 as Num)
	b.copyFrom(source)
	let second = try b.at(1) otherwise return 1
	return second
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.copyFrom {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.loadRegBaseDisp.word64 x22, [x20 + 8]
    arm64.movImm x23, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x23, x22
    arm64.cset x0, lt
    arm64.cbnz x0, copy
    arm64.b forexit
  copy:
    arm64.cmp x23, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 24]
    arm64.cmp x0, 8
    arm64.cset x1, eq
    arm64.cbnz x1, __im_word
    arm64.b __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x23, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_load#15
  __im_load#15:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.arm64AddLsl x0, x0, x23, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, __im_byte
    arm64.b __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x23, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_load#16
  __im_load#16:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.add x0, x0, x23
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b __im_loaded
  __im_loaded:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x20 + 40]
    arm64.cmp x2, 0
    arm64.cset x2, ne
    arm64.cbnz x2, __im_empty
    arm64.b critsplit#18
  __im_empty:
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.cbnz x2, __im_slow
    arm64.b critsplit#19
  critsplit#19:
    arm64.xchgRegReg x1, x0
    arm64.b __im_cont
  critsplit#18:
    arm64.xchgRegReg x1, x0
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x24, [x19 + 0]
    arm64.movRegReg x0, x21
    arm64.bl __retain_type_param
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x24
    arm64.bl __managed_push
    arm64.b forstep
  forstep:
    arm64.add x23, x23, 1
    arm64.b forhdr
  forexit:
    arm64.loadRegSlot x19, slot0
