// Test: builtins-mm-counters.total-is-monotonic-and-moves
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let before = __Builtins.mmAllocTotal()
	var buf = ByteArray.create()
	buf.push(1)
	let after = __Builtins.mmAllocTotal()
	var score = 0
	if after >= before 'monotonic'
		score = score + 1
	end 'monotonic'
	if after > before 'moved'
		score = score + 2
	end 'moved'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __mm_alloc_total@8 = i64 0
  __mm_alloc_bytes@16 = i64 0
  __mm_raw_alloc_count@24 = i64 0
  __mm_raw_live_count@32 = i64 0
  __mm_raw_alloc_bytes@40 = i64 0
  __slab_arena_list@48 = i64 0
  __slab_arena_map_l1@56 = i64 0
  __slab_state@64 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl __mm_counter_alloc_total
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.bl __mm_counter_alloc_total
    arm64.movImm x1, 0
    arm64.cmp x0, x19
    arm64.b.lt ifcont#2
  monotonic:
    arm64.movImm x1, 1
  ifcont#2:
    arm64.cmp x0, x19
    arm64.b.le critsplit
  moved:
    arm64.add x19, x1, 2
    arm64.b ifcont#4
  critsplit:
    arm64.movRegReg x19, x1
  ifcont#4:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at builtins-mm-counters.total-is-monotonic-and-moves.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
