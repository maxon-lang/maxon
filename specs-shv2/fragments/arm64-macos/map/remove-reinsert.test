    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Map.upsert
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_Map_int_int
