// Test: insert.duplicate-throws
function main() returns ExitCode
	var m = [1: 10, 2: 20]
	try m.insert(1, value: 99) otherwise 'err'
		return 42
	end 'err'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 10
    arm64.leaRdata x0, __layout_Map_int_int
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Map.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl Map.upsert
    arm64.movImm x1, 2
    arm64.movImm x2, 20
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Map.upsert
    arm64.movImm x1, 1
    arm64.movImm x2, 99
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x19, 42
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Map_int_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Map_int_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
