// Test: local-declared-before-a-loop-drops-once-after-it
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function fill(sink ByteArray)
	var scratch = ByteArray.create()
	scratch.push('x')
	var i = 0
	while i < 3 'each'
		sink.push('y')
		i = i + 1
	end 'each'
end 'fill'

function main() returns ExitCode
	var sink = ByteArray.create()
	fill(sink)
	return sink.count()
end 'main'
---
ExitCode: 3
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @fill {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 120
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x21, 3
    arm64.cset x0, lt
    arm64.cbnz x0, each
    arm64.b whileexit
  each:
    arm64.movImm x1, 121
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.add x21, x21, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl fill
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
