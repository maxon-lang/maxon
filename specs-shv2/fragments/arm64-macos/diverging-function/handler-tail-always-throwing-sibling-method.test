func @Worker.drain {
  entry:
    arm64.prologue 16
    arm64.cbnz x1, broken
    arm64.b ifcont
  broken:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 41
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

