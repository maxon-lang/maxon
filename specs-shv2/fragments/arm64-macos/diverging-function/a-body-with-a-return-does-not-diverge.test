// Test: a-body-with-a-return-does-not-diverge
function maybeFatal(b bool) returns Integer
	if b 'y'
		return 5
	end 'y'
	panic("no")
end 'maybeFatal'

function main() returns ExitCode
	maybeFatal(true)
	print("back in main\n")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b y
  y:
    arm64.b __il_cont
  __il_cont:
    arm64.leaRdata x0, __str_rec_2
    arm64.bl print
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
