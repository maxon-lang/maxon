// Test: a-call-argument-evaluated-before-the-fork
typealias StrArray = Array with String
typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

function mayFail(n Integer) returns Integer throws Boom
	if n > 100 'big'
		throw Boom.bad
	end 'big'
	return n
end 'mayFail'

function take(argv StrArray, n Integer) returns Integer
	return argv.count() + n
end 'take'

function main() returns ExitCode
	let a = take(["x", "y"], n: try mayFail(900) otherwise 5)
	let b = take(["z"], n: try mayFail(2) otherwise 5)
	return a + b as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @mayFail {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 100
    arm64.cset x1, gt
    arm64.cbnz x1, big
    arm64.b ifcont
  big:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_3
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_4
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x0, 900
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x0, 5
    arm64.b trycont#3
  tryok#1:
    arm64.b trycont#3
  trycont#3:
    arm64.b __il_body#14
  __il_body#14:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.add x19, x1, x0
    arm64.b __il_cont#13
  __il_cont#13:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.leaRdata x20, __str_rec_5
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.movImm x0, 2
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#5
    arm64.b tryok#4
  tryerr#5:
    arm64.movImm x0, 5
    arm64.b trycont#6
  tryok#4:
    arm64.b trycont#6
  trycont#6:
    arm64.b __il_body#16
  __il_body#16:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.add x20, x1, x0
    arm64.b __il_cont#15
  __il_cont#15:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#8
    arm64.b __rc_chk#9
  __rc_chk#9:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#8
    arm64.b __rc_ok#7
  __rc_panic#8:
    arm64.leaRdata x0, __str_blob_6
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#7:
    arm64.add x0, x19, x20
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#11
    arm64.b __rc_chk#12
  __rc_chk#12:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#11
    arm64.b __rc_ok#10
  __rc_panic#11:
    arm64.leaRdata x0, __str_blob_6
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#10:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
