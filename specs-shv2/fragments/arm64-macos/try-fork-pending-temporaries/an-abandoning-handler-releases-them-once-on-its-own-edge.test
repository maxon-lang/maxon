// Test: an-abandoning-handler-releases-them-once-on-its-own-edge
typealias StrArray = Array with String
typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

function mayFail(n Integer) returns Integer throws Boom
	if n > 100 'big'
		throw Boom.bad
	end 'big'
	return n
end 'mayFail'

type Conf
	export var argv as StrArray
	export var n as Integer

	export static function create(n Integer) returns Conf throws Boom
		return Conf{argv: StrArray.create(), n: try mayFail(n) otherwise return Conf{argv: StrArray.create(), n: 0}}
	end 'create'
end 'Conf'

function main() returns ExitCode
	let c = try Conf.create(900) otherwise return 9
	return c.n + c.argv.count() as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @mayFail {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 100
    arm64.cset x1, gt
    arm64.cbnz x1, big
    arm64.b ifcont
  big:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @Conf.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl mayFail
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x21, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.storeBaseDispReg.word64 [x22 + 0], x19
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 900
    arm64.bl Conf.create
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 9
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x2 + 8]
    arm64.cmp x2, 0
    arm64.cset x3, lt
    arm64.cbnz x3, __rc_panic#4
    arm64.b __rc_chk#5
  __rc_chk#5:
    arm64.cmp x2, 255
    arm64.cset x3, gt
    arm64.cbnz x3, __rc_panic#4
    arm64.b __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-abandoning-handler-releases-them-once-on-its-own-edge.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#3:
    arm64.add x19, x1, x2
    arm64.bl __destruct_Conf
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#7
    arm64.b __rc_chk#8
  __rc_chk#8:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#7
    arm64.b __rc_ok#6
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-abandoning-handler-releases-them-once-on-its-own-edge.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#6:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
