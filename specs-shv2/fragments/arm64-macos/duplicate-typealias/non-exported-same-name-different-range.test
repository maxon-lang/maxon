// Test: non-exported-same-name-different-range
// --- file: a.maxon
typealias Limit = int(0 to 500)

export function clampA(x Limit) returns Limit
	return x
end 'clampA'

// --- file: b.maxon
typealias Limit = int(0 to 2000)

export function clampB(x Limit) returns Limit
	return x
end 'clampB'

// --- file: main.maxon
function main() returns ExitCode
	let a = clampA(40)
	let b = clampB(60)
	return a + b
end 'main'
---
ExitCode: 100
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 40
  __il_cont#5:
    arm64.movImm x1, 60
  __il_cont#4:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
