// Test: non-exported-same-name-different-range
// --- file: a.maxon
typealias Limit = int(0 to 500)

export function clampA(x Limit) returns Limit
	return x
end 'clampA'

// --- file: b.maxon
typealias Limit = int(0 to 2000)

export function clampB(x Limit) returns Limit
	return x
end 'clampB'

// --- file: main.maxon
function main() returns ExitCode
	let a = clampA(40)
	let b = clampB(60)
	return a + b
end 'main'
---
ExitCode: 100
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 40
    arm64.bl clampA
    arm64.movRegReg x19, x0
    arm64.movImm x0, 60
    arm64.bl clampB
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @clampA {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 500
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @clampB {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 2000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
