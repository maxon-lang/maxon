    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.leaRdata x0, __str_rec_17
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
    arm64.b trycont
