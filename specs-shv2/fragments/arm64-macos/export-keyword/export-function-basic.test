// Test: export-function-basic
// --- file: api/lib.maxon
typealias Integer = int(i64.min to i64.max)

export function helper() returns Integer
	return 21
end 'helper'

// --- file: app/main.maxon
function main() returns ExitCode
	return helper() + helper()
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl helper
    arm64.movRegReg x19, x0
    arm64.bl helper
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @helper {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 21
    arm64.epilogue 16
    arm64.ret
