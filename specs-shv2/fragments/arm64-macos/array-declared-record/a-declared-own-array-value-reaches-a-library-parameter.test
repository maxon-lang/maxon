// Test: a-declared-own-array-value-reaches-a-library-parameter
type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Array'

typealias MyBytes = Array with Byte

function main() returns ExitCode
	var mine = MyBytes.create()
	mine.push(72 as Byte)
	mine.push(105 as Byte)
	mine.push(33 as Byte)
	let s = String.from(mine)
	print(s)
	return s.byteLength() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 72
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 105
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 33
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl String.from
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl print
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_ok#6
  __il_slow:
    arm64.movRegReg x0, x20
    arm64.bl String.byteLength
    arm64.movRegReg x21, x0
    arm64.b __il_cont
  __rc_ok#6:
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#1:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
