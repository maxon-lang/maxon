// Test: a-declared-member-off-the-roster-is-served-from-the-corpus
typealias Num = int(0 to 1000)

type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'

	export function at(i Num) returns Element
		return try managed.get(i) otherwise panic("at: the caller checked the bound")
	end 'at'
end 'Array'

typealias NumArray = Array with Num

function main() returns ExitCode
	var a = NumArray.create()
	a.push(17 as Num)
	a.push(25 as Num)
	return (a.at(0) + a.at(1)) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Array.at {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x2
    arm64.cmp x1, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 1000
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.cset x3, eq
    arm64.cbnz x3, __im_word
    arm64.b __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.cset x2, hs
    arm64.cbnz x2, __im_slow
    arm64.b __im_load#12
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.arm64AddLsl x2, x2, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x2, 1
    arm64.cset x2, eq
    arm64.cbnz x2, __im_byte
    arm64.b __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.cset x2, hs
    arm64.cbnz x2, __im_slow
    arm64.b __im_load#13
  __im_load#13:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, x1
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
    arm64.b __im_loaded
  __im_loaded:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.cset x4, ne
    arm64.cbnz x4, __im_empty
    arm64.b critsplit#15
  __im_empty:
    arm64.cmp x2, 0
    arm64.cset x4, eq
    arm64.cbnz x4, __im_slow
    arm64.b critsplit#16
  critsplit#16:
    arm64.movRegReg x1, x2
    arm64.b __im_cont
  critsplit#15:
    arm64.movRegReg x1, x2
    arm64.b __im_cont
  __im_slow:
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.movRegReg x3, x9
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x3, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __retain_type_param
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 17
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 25
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_Array_Num
    arm64.movRegReg x0, x19
    arm64.bl Array.at
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Array_Num
    arm64.movRegReg x0, x19
    arm64.bl Array.at
    arm64.add x20, x20, x0
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
