// Test: a-bare-call-to-a-roster-member-takes-the-roster
typealias Num = int(0 to 1000)

type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'

	export function count() returns Num
		return 99 as Num
	end 'count'

	export function bareCount() returns Num
		return count()
	end 'bareCount'
end 'Array'

typealias NumArray = Array with Num

function main() returns ExitCode
	var a = NumArray.create()
	a.push(41 as Num)
	a.push(42 as Num)
	a.push(43 as Num)
	return a.bareCount()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Array.bareCount {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-bare-call-to-a-roster-member-takes-the-roster.test:22: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 41
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 42
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 43
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_chk#7
  __rc_chk#7:
    arm64.cmp x20, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_ok#6
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl Array.bareCount
    arm64.movRegReg x20, x0
    arm64.b __il_cont
  __rc_ok#6:
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk#3
  __rc_chk#3:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-bare-call-to-a-roster-member-takes-the-roster.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#1:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
