// Test: a-conformer-of-another-name-owns-its-managed-elements
type Bag uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Bag'

typealias StringBag = Bag with String

function main() returns ExitCode
	var b = StringBag.create()
	b.push("alpha")
	b.push("beta")
	let second = try b.get(1) otherwise panic("get: index 1 was just pushed")
	print(second)
	return (b.count() + second.byteLength()) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_2
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_3
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.cset x0, ls
    arm64.cbnz x0, __im_slow
    arm64.b __im_load
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 40]
    arm64.cmp x2, 0
    arm64.cset x2, ne
    arm64.cbnz x2, __im_empty
    arm64.b critsplit#14
  __im_empty:
    arm64.cmp x20, 0
    arm64.cset x2, eq
    arm64.cbnz x2, __im_slow
    arm64.b critsplit#15
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x20, x0
    arm64.b __im_cont
  critsplit#15:
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_4
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl print
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __il_slow
    arm64.b __rc_ok#12
  __il_slow:
    arm64.movRegReg x0, x20
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok#12:
    arm64.b __il_cont
  __il_cont:
    arm64.add x20, x21, x0
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#3
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#3:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
