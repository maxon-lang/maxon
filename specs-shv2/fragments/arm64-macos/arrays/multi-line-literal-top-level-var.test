// Test: multi-line-literal-top-level-var
var xs = [10,
	20]

function main() returns ExitCode
	let v = try xs.get(1) otherwise 0
	return v
end 'main'
---
ExitCode: 20
---
data {
  __data_xs@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_xs
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 1
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
