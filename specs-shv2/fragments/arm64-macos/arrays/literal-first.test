// Test: literal-first
function main() returns ExitCode
	return try [10, 20, 30].get(0) otherwise 0
end 'main'
---
ExitCode: 10
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.b trycont
  trycont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
