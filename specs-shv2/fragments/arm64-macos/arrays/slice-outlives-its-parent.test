// Test: slice-outlives-its-parent
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function makeParent() returns IntArray
	var a = IntArray.create()
	a.push(10)
	a.push(20)
	a.push(30)
	a.push(40)
	return a
end 'makeParent'

function tail(v IntArray) returns IntArray
	return try v.slice(1, endIndex: 4) otherwise IntArray.create()
end 'tail'

function main() returns ExitCode
	let sub = tail(makeParent())
	let a = try sub.get(0) otherwise 0
	let b = try sub.get(1) otherwise 0
	let c = try sub.get(2) otherwise 0
	return a + b + c
end 'main'
---
ExitCode: 90
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @makeParent {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 40
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @tail {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 1
    arm64.movImm x2, 4
    arm64.bl __arr_slice
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl makeParent
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl tail
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x21, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 2
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.add x1, x19, x21
    arm64.add x19, x1, x0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
