// Test: string-array-literal-top-level
var names = ["alice", "bob"]

function main() returns ExitCode
	var count = 0
	for _ in names 'loop'
		count = count + 1
	end 'loop'
	return count
end 'main'
---
ExitCode: 2
---
data {
  __data_names@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.leaGlobal x0, __data_names
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x20
    arm64.bl __arr_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b forexit
  loop:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __arr_get_unchecked
    arm64.add x19, x19, 1
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
