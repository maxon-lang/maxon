// Test: append-a-slice-of-self
function main() returns ExitCode
	var arr = [1, 2, 3]
	let sub = try arr.slice(0, endIndex: 2) otherwise return 1
	arr.append(sub)
	var sum = 0
	var i = 0
	while i < arr.count() 'loop'
		sum = sum + (try arr.get(i) otherwise 0)
		i = i + 1
	end 'loop'
	let s0 = try sub.get(0) otherwise 0
	if sum == 9 and arr.count() == 5 and s0 == 1 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.movRegReg x0, x19
    arm64.bl __arr_slice
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __arr_append
    arm64.movImm x21, 0
    arm64.movImm x22, 0
    arm64.b whilehdr
  whilehdr:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.cmp x22, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.add x21, x21, x0
    arm64.add x22, x22, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x22, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x22, x0
    arm64.b trycont
  trycont:
    arm64.cmp x21, 9
    arm64.cset x0, eq
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.cmp x0, 5
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x22, 1
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x21, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
