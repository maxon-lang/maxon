// Test: a-declared-float-element-array-crosses-a-call-boundary
typealias Real = float(f64.min to f64.max)
typealias Reals = Array with Real

type Samples
	export var values as Reals

	export static function create() returns Self
		var v = Reals.create()
		v.push(2.5)
		return Self{values: v}
	end 'create'
end 'Samples'

function total(xs Reals) returns Real
	var sum = 0.0
	for x in xs 'each'
		sum = sum + x
	end 'each'
	return sum
end 'total'

function main() returns ExitCode
	let s = Samples.create()
	return trunc(total(s.values) + 1.5)
end 'main'
---
ExitCode: 4
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Samples.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.fmov x1, d0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @total {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, d8
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.fpLoadRdata d8, [rdata + __fconst_2]
    arm64.movImm x20, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x19
    arm64.bl __managed_count
    arm64.cmp x20, x0
    arm64.cset x0, lt
    arm64.cbnz x0, each
    arm64.b forexit
  each:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_get_unchecked
    arm64.fmov d0, x0
    arm64.fadd d8, d8, d0
    arm64.b forstep
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg d0, d8
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot d8, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Samples.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl total
    arm64.fpLoadRdata d1, [rdata + __fconst_3]
    arm64.fadd d0, d0, d1
    arm64.fcvtzs x20, d0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Samples
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
