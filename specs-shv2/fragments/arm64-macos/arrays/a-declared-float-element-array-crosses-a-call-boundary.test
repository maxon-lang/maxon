    arm64.movRegReg x19, x0
    arm64.movImm x1, 4612811918334230528
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Samples.create
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.b __il_body
  __il_body:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x1 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.b forhdr
  forhdr:
    arm64.cmp x2, x3
    arm64.cset x4, lt
    arm64.cbnz x4, each
    arm64.b forexit
  each:
    arm64.arm64AddLsl x4, x1, x2, lsl #3
    arm64.loadRegBaseDisp.word64 x4, [x4 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.fmov d1, x4
    arm64.fadd d0, d0, d1
    arm64.b forstep
  forstep:
    arm64.add x2, x2, 1
    arm64.b forhdr
  forexit:
    arm64.b __il_cont
  __il_cont:
    arm64.fpLoadRdata d1, [rdata + __fconst_1.5]
    arm64.fadd d0, d0, d1
    arm64.fcvtzs x19, d0
    arm64.bl __destruct_Samples
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
