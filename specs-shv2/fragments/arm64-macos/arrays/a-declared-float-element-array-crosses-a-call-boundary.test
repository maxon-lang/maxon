    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-declared-float-element-array-crosses-a-call-boundary.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
