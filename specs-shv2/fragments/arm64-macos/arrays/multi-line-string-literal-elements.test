// Test: multi-line-string-literal-elements
function main() returns ExitCode
	let words = ["alpha",
		"beta",
		"gamma"]
	let w = try words.get(1) otherwise ""
	if w == "beta" 'middle'
		return words.count() as ExitCode
	end 'middle'
	return 99
end 'main'
