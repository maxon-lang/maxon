// Test: slice-of-byte-string-literal
function main() returns ExitCode
	let lit = b"hello"
	var mid = try lit.slice(1, endIndex: 4) otherwise return 1
	try mid.set(0, value: 88) otherwise panic("index 0 is in bounds")
	let m0 = try mid.get(0) otherwise 0
	let m1 = try mid.get(1) otherwise 0
	let l1 = try lit.get(1) otherwise 0
	if m0 == 88 and m1 == 108 and l1 == 101 and mid.count() == 3 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x0, 5
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, -2
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 24], x0
    arm64.movImm x1, 1
    arm64.movImm x2, 4
    arm64.movRegReg x0, x19
    arm64.bl __arr_slice
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 0
    arm64.movImm x2, 88
    arm64.movRegReg x0, x20
    arm64.bl __arr_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x21, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x22, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x22, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x21, 88
    arm64.cset x1, eq
    arm64.movImm x2, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x22, 108
    arm64.cset x1, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x1, x2
    arm64.b scmerge
  scmerge:
    arm64.movImm x2, 0
    arm64.cbnz x1, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x0, 101
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x2
    arm64.b scmerge
  scmerge:
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movRegReg x0, x20
    arm64.bl __arr_count
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x21, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
