// Test: string-array-literal-top-level-pass-to-function
var items = ["hello"]

function useString(s String) returns ExitCode
	if s == "hello" 'check'
		return 42
	end 'check'
	return 0
end 'useString'

function main() returns ExitCode
	for item in items 'loop'
		return useString(item)
	end 'loop'
	return 1
end 'main'
---
ExitCode: 42
---
data {
  __data_items@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @useString {
  entry:
    arm64.prologue 16
    arm64.leaRdata x1, __str_rec_1  ; "hello"
    arm64.bl __str_eq
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_items
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.ge forexit
  loop:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x1*8 + 0]
  __im_cont:
    arm64.bl useString
    arm64.epilogue 16
    arm64.ret
  forexit:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
