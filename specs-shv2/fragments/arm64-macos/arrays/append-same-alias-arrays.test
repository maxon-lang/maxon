// Test: append-same-alias-arrays
typealias Byte = int(0 to 100)
typealias Bytes = Array with Byte

function main() returns ExitCode
	var a = Bytes.create()
	a.push(7)
	var b = Bytes.create()
	b.push(9)
	a.append(b)
	let first = try a.get(0) otherwise 0
	let second = try a.get(1) otherwise 0
	return first + second
end 'main'
---
ExitCode: 16
