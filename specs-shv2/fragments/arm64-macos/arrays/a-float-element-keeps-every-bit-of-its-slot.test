// Test: a-float-element-keeps-every-bit-of-its-slot
function main() returns ExitCode
	var a = [0.1, 2.5]
	try a.set(1, value: -0.0) otherwise panic("test invariant: set OOB")
	a.push(1.7976931348623157e308)
	for x in a 'each'
		print("{x}\n")
	end 'each'
	return a.count() as ExitCode
end 'main'
