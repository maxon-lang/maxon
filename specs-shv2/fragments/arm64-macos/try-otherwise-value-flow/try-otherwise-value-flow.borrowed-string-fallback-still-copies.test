// Test: try-otherwise-value-flow.borrowed-string-fallback-still-copies
typealias Len = int(0 to 1000)

enum Fail
	nope
end 'Fail'

function risky(ok bool) returns String throws Fail
	if ok 'good'
		return "a freshly built heap string for the ok path"
	end 'good'
	throw Fail.nope
end 'risky'

function choose(base String, ok bool) returns Len
	let got = try risky(ok) otherwise base
	return got.count()
end 'choose'

function main() returns ExitCode
	let base = "twelve chars"
	return (choose(base, ok: false) + choose(base, ok: true)) as ExitCode
end 'main'
---
ExitCode: 55
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @risky {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  good:
    arm64.leaRdata x0, __str_rec_2  ; "a freshly built heap string for the ok path"
    arm64.bl __str_retain
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @choose {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.bl risky
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.movRegReg x19, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl String.count
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 1000
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_15  ; "panic at try-otherwise-value-flow.borrowed-string-fallback-still-copies.test:17: Range check failed: value outside typealias 'Len'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_3  ; "twelve chars"
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl choose
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl choose
    arm64.add x0, x20, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_16  ; "panic at try-otherwise-value-flow.borrowed-string-fallback-still-copies.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
