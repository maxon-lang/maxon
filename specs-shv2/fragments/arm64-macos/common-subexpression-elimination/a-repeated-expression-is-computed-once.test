// Test: a-repeated-expression-is-computed-once
typealias Word = int(i64.min to i64.max)

function work(x Word, y Word) returns Word
	let a = x * 31 + y
	let b = x * 31 + y
	let c = x * 31 + y
	return a + b + c
end 'work'

function main() returns ExitCode
	var seed = 0
	for i in 0 upto 4 'feed'
		seed = seed + work(i, y: i + 1)
	end 'feed'
	if seed != 588 'wrongSum'
		return 1
	end 'wrongSum'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 4
    arm64.cset x2, lt
    arm64.cbnz x2, feed
    arm64.b forexit
  feed:
    arm64.add x2, x1, 1
    arm64.b __il_body
  __il_body:
    arm64.movImm x16, 31
    arm64.mul x1, x1, x16
    arm64.add x1, x1, x2
    arm64.add x3, x1, x1
    arm64.add x1, x3, x1
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, x1
    arm64.b forstep
  forstep:
    arm64.movRegReg x1, x2
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 588
    arm64.cset x0, ne
    arm64.cbnz x0, wrongSum
    arm64.b ifcont
  wrongSum:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
