// Test: one-shared-body-answers-each-instances-own-count
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Vec5 = Vector with 5 Int

extension Vector
	export function capacity() returns Int
		return countof(Self)
	end 'capacity'
end 'Vector'

function main() returns ExitCode
	var a = Vec3.create()
	var b = Vec5.create()
	return a.capacity() * 10 + b.capacity()
end 'main'
---
ExitCode: 35
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __layout_Vector_N5_Int
    arm64.movImm x1, 5
    arm64.bl Vector.create
    arm64.b __il_body#6
  __il_body#6:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.movImm x1, 30
    arm64.b __il_body#7
  __il_body#7:
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x20, x1, 5
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
