func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1  ; "this.host.does.not.exist.invalid"
    arm64.movImm x1, 1
    arm64.bl TcpClient.connect
    arm64.cmp x9, 0
    arm64.b.ne ifelse
  ok:
    arm64.movImm x19, 1
    arm64.bl __destruct_TcpClient
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifelse:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchdefault
  matcharm:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_2  ; "panic at tcp-client.resolve-error.test:8: unreachable: TcpClient.connect reports only resolveFailed or connectFailed\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
