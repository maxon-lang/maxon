// Test: unrelated-global-reassign-keeps-borrow
typealias Int = int(0 to 1000000)

type Box
	export var n as Int

	static function create(v Int) returns Self
		return Self{n: v}
	end 'create'
end 'Box'

var ga = Box.create(3)
var gb = Box.create(9)

function main() returns ExitCode
	let a = ga
	gb = Box.create(2)
	return a.n
end 'main'
---
ExitCode: 3
---
data {
  __data_ga@0 = i64 0
  __data_gb@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x16, 1000000
    arm64.cmp x19, x16
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at unrelated-global-reassign-keeps-borrow.test:7: Range check failed: value outside typealias 'Int'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_ga
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.movRegReg x19, x0
    arm64.movImm x0, 2
    arm64.bl Box.create
    arm64.movRegReg x20, x0
    arm64.leaGlobal x0, __data_gb
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_decref
    arm64.leaGlobal x0, __data_gb
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at unrelated-global-reassign-keeps-borrow.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
