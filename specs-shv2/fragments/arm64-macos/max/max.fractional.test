// Test: max.fractional
function main() returns ExitCode
	let x = max(3.5, 5.2)
	// max of 3.5 and 5.2 is 5.2, trunc gives 5
	return trunc(x)
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
