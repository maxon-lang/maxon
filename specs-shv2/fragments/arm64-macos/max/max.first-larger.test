// Test: max.first-larger
function main() returns ExitCode
	let x = max(10.0, 2.0)
	return trunc(x)
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.fcsel d0, d0, d1, gt
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
