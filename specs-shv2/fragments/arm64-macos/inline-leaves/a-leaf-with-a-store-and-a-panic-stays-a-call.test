// Test: a-leaf-with-a-store-and-a-panic-stays-a-call
typealias Integer = int(i64.min to i64.max)
typealias Percent = int(0 to 100)

type Meter
	export var level as Integer

	export static function create() returns Self
		return Self{level: 0}
	end 'create'

	export function record(p Percent) returns Integer
		self.level = self.level + p
		return self.level
	end 'record'
end 'Meter'

function main() returns ExitCode
	var m = Meter.create()
	let first = m.record(40 as Percent)
	let second = m.record(2 as Percent)
	return (second - first + 40) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Meter.record {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 100
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-leaf-with-a-store-and-a-panic-stays-a-call.test:12: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x1, x2, x1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x1, 40
    arm64.movRegReg x0, x19
    arm64.bl Meter.record
    arm64.movRegReg x20, x0
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl Meter.record
    arm64.sub x0, x0, x20
    arm64.add x0, x0, 40
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-leaf-with-a-store-and-a-panic-stays-a-call.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
