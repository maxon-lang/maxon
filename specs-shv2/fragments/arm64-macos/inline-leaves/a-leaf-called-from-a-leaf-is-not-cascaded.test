// Test: a-leaf-called-from-a-leaf-is-not-cascaded
typealias Integer = int(i64.min to i64.max)

function inner(a Integer) returns Integer
	return a + 1
end 'inner'

function outer(a Integer) returns Integer
	return inner(a) * 2
end 'outer'

function main() returns ExitCode
	return outer(20) as ExitCode
end 'main'
---
ExitCode: 42
---
func @outer {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.add x0, x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.bl outer
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-leaf-called-from-a-leaf-is-not-cascaded.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
