// Test: a-void-leaf
typealias Integer = int(i64.min to i64.max)

var total = 0

function bump(n Integer)
	total = total + n
end 'bump'

function main() returns ExitCode
	bump(40)
	bump(2)
	return total as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __data_total@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#6
  __il_body#6:
    arm64.leaGlobal x0, __data_total
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 40
    arm64.leaGlobal x1, __data_total
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.leaGlobal x0, __data_total
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 2
    arm64.leaGlobal x1, __data_total
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.leaGlobal x0, __data_total
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
