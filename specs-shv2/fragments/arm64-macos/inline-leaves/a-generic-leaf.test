// Test: a-generic-leaf
typealias Integer = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)

type Box uses T
	export var value as T
	export var weight as Integer

	export static function create(v T, weight Integer) returns Self
		return Self{value: v, weight: weight}
	end 'create'

	export function weightOf() returns Integer
		return self.weight
	end 'weightOf'
end 'Box'

typealias IntBox = Box with Integer
typealias ByteBox = Box with Byte

function main() returns ExitCode
	let a = IntBox.create(7, weight: 40)
	let b = ByteBox.create(2 as Byte, weight: 2)
	return (a.weightOf() + b.weightOf()) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 7
    arm64.movImm x1, 40
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.movImm x0, 2
    arm64.movImm x1, 2
    arm64.leaRegSlot x3, slot2
    arm64.storeBaseDispReg.word64 [x3 + 0], x0
    arm64.storeBaseDispReg.word64 [x3 + 8], x1
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 8]
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x1, [x3 + 8]
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.epilogue 48
    arm64.ret
}
