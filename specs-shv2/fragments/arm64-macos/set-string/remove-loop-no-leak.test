// Test: remove-loop-no-leak
typealias StrSet = Set with String
typealias Counter = int(0 to 1000)

function main() returns ExitCode
	var i = 0 as Counter
	var acc = 0 as Counter
	while i < 100 'loop'
		var s = StrSet.create()
		s.insert("gone{i}")
		let removed = s.remove("gone{i}")
		if removed 'ok'
			if s.count() == 0 'empty'
				acc = acc + 1
			end 'empty'
		end 'ok'
		i = i + 1
	end 'loop'
	if acc == 100 'all'
		return 0
	end 'all'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x19, 100
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.leaFuncAddr x0, __str_decref
    arm64.bl __set_create
    arm64.movRegReg x21, x0
    arm64.leaRdata x0, __str_rec_1
    arm64.loadRegBaseDisp.word64 x22, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x23, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.bl __int_to_string
    arm64.movRegReg x25, x0
    arm64.add x26, x23, x25
    arm64.add x0, x26, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
    arm64.add x28, x27, 48
    arm64.movRegReg x0, x28
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl __str_copy
    arm64.add x22, x28, x23
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x25
    arm64.bl __str_copy
    arm64.add x0, x22, x25
    arm64.storeBaseDispReg.word64 [x27 + 0], x28
    arm64.storeBaseDispReg.word64 [x27 + 8], x26
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x27 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x27 + 24], x0
    arm64.movRegReg x0, x24
    arm64.bl __mm_decref
    arm64.leaRdata x2, __witness_String.Hashable
    arm64.leaRdata x6, __witness_String.Equatable
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x27
    arm64.movRegReg x3, x6
    arm64.bl __set_insert
    arm64.leaRdata x0, __str_rec_1
    arm64.loadRegBaseDisp.word64 x22, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x23, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.bl __int_to_string
    arm64.movRegReg x25, x0
    arm64.add x26, x23, x25
    arm64.add x0, x26, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
    arm64.add x28, x27, 48
    arm64.movRegReg x0, x28
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl __str_copy
    arm64.add x22, x28, x23
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x25
    arm64.bl __str_copy
    arm64.add x0, x22, x25
    arm64.storeBaseDispReg.word64 [x27 + 0], x28
    arm64.storeBaseDispReg.word64 [x27 + 8], x26
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x27 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x27 + 24], x0
    arm64.movRegReg x0, x24
    arm64.bl __mm_decref
    arm64.leaRdata x2, __witness_String.Hashable
    arm64.leaRdata x6, __witness_String.Equatable
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x27
    arm64.movRegReg x3, x6
    arm64.bl __set_remove
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x27
    arm64.bl __str_decref
    arm64.cbnz x22, ok
    arm64.b critsplit
  ok:
    arm64.movRegReg x0, x21
    arm64.bl __set_count
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, empty
    arm64.b critsplit
  empty:
    arm64.add x0, x20, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x20
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x20, x0
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.add x19, x19, 1
    arm64.movRegReg x0, x21
    arm64.bl __set_decref
    arm64.b whilehdr
  whileexit:
    arm64.cmp x20, 100
    arm64.cset x0, eq
    arm64.cbnz x0, all
    arm64.b ifcont
  all:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
