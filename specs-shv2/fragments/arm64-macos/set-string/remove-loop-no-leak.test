func @String.hash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.movImm x2, 5381
    arm64.movImm x6, 0
    arm64.b header
  header:
    arm64.cmp x6, x0
    arm64.cset x7, ge
    arm64.cbnz x7, done
    arm64.b body
  done:
    arm64.movImm x0, 4294967295
    arm64.and x0, x2, x0
    arm64.epilogue 16
    arm64.ret
  body:
    arm64.add x7, x1, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.movImm x8, 33
    arm64.mul x2, x2, x8
    arm64.add x2, x2, x7
    arm64.movImm x7, 1
    arm64.add x6, x6, x7
    arm64.b header
}

func @String.equals {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x6, [x1 + 8]
    arm64.cmp x2, x6
    arm64.cset x6, eq
    arm64.cbnz x6, lenMatch
    arm64.b notEqual
  lenMatch:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.movImm x6, 0
    arm64.b cmphdr
  cmphdr:
    arm64.cmp x6, x2
    arm64.cset x7, ge
    arm64.cbnz x7, allMatch
    arm64.b cmpbody
  allMatch:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  cmpbody:
    arm64.add x7, x0, x6
    arm64.loadRegBaseDisp.byte x7, [x7 + 0]
    arm64.add x8, x1, x6
    arm64.loadRegBaseDisp.byte x8, [x8 + 0]
    arm64.movImm x9, 1
    arm64.add x6, x6, x9
    arm64.cmp x7, x8
    arm64.cset x7, eq
    arm64.cbnz x7, critsplit
    arm64.b notEqual
  critsplit:
    arm64.b cmphdr
  notEqual:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
