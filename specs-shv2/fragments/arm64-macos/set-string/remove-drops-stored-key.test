    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __witness_String.Hashable
    arm64.leaRdata x6, __witness_String.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.movRegReg x3, x6
    arm64.bl __set_insert
    arm64.leaRdata x1, __str_rec_1
    arm64.leaRdata x2, __witness_String.Hashable
    arm64.leaRdata x6, __witness_String.Equatable
    arm64.movRegReg x0, x19
