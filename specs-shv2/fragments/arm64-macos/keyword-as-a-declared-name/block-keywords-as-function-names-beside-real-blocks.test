// Test: block-keywords-as-function-names-beside-real-blocks
typealias Integer = int(i64.min to i64.max)

enum Grade
	low
	high
end 'Grade'

type Ops
	export static function while(n Integer) returns Integer
		return n * 2
	end 'while'

	export static function for(n Integer) returns Integer
		return n + 3
	end 'for'

	export static function end(n Integer) returns Integer
		return n - 1
	end 'end'
end 'Ops'

function match(n Integer) returns Integer
	return n + 1
end 'match'

function if(n Integer) returns Integer
	if n > 4 'big'
		return 2
	end 'big'
	return 1
end 'if'

function grade(n Integer) returns Grade
	if n > 1 'high'
		return Grade.high
	end 'high'
	return Grade.low
end 'grade'

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'count'
		total = total + Ops.while(i)
		i = i + 1
	end 'count'

	for j in 0 upto 3 'walk'
		total = total + Ops.for(j)
	end 'walk'

	if total > 0 'positive'
		total = total + Ops.end(10)
	end 'positive' else 'negative'
		total = total - 1
	end 'negative'

	let bonus = match grade(if(5)) 'pick'
		low gives 5
		high gives 15
	end 'pick'

	return total + bonus
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, count
    arm64.b whileexit
  count:
    arm64.b __il_body#20
  __il_body#20:
    arm64.movImm x16, 2
    arm64.mul x2, x1, x16
    arm64.b __il_cont#19
  __il_cont#19:
    arm64.add x0, x0, x2
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, walk
    arm64.b forexit
  walk:
    arm64.b __il_body#22
  __il_body#22:
    arm64.add x2, x1, 3
    arm64.b __il_cont#21
  __il_cont#21:
    arm64.add x0, x0, x2
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 0
    arm64.cset x1, gt
    arm64.cbnz x1, positive
    arm64.b ifelse
  positive:
    arm64.b __il_body#24
  __il_body#24:
    arm64.b __il_cont#23
  __il_cont#23:
    arm64.add x0, x0, 9
    arm64.b ifcont#10
  ifelse:
    arm64.sub x0, x0, 1
    arm64.b ifcont#10
  ifcont#10:
    arm64.b __il_body#27
  __il_body#27:
    arm64.b big
  big:
    arm64.movImm x1, 2
    arm64.b __il_cont#26
  __il_cont#26:
    arm64.b __il_body#30
  __il_body#30:
    arm64.cmp x1, 1
    arm64.cset x1, gt
    arm64.cbnz x1, high
    arm64.b ifcont#32
  high:
    arm64.movImm x1, 1
    arm64.b __il_cont#25
  ifcont#32:
    arm64.movImm x1, 0
    arm64.b __il_cont#25
  __il_cont#25:
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#11
    arm64.b matchnext
  matcharm#11:
    arm64.movImm x1, 5
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#12
    arm64.b matchdead
  matcharm#12:
    arm64.movImm x1, 15
    arm64.b matchcont
  matchcont:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at block-keywords-as-function-names-beside-real-blocks.test:64: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
