// Test: block-keywords-as-function-names-beside-real-blocks
typealias Integer = int(i64.min to i64.max)

enum Grade
	low
	high
end 'Grade'

type Ops
	export static function while(n Integer) returns Integer
		return n * 2
	end 'while'

	export static function for(n Integer) returns Integer
		return n + 3
	end 'for'

	export static function end(n Integer) returns Integer
		return n - 1
	end 'end'
end 'Ops'

function match(n Integer) returns Integer
	return n + 1
end 'match'

function if(n Integer) returns Integer
	if n > 4 'big'
		return 2
	end 'big'
	return 1
end 'if'

function grade(n Integer) returns Grade
	if n > 1 'high'
		return Grade.high
	end 'high'
	return Grade.low
end 'grade'

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 3 'count'
		total = total + Ops.while(i)
		i = i + 1
	end 'count'

	for j in 0 upto 3 'walk'
		total = total + Ops.for(j)
	end 'walk'

	if total > 0 'positive'
		total = total + Ops.end(10)
	end 'positive' else 'negative'
		total = total - 1
	end 'negative'

	let bonus = match grade(if(5)) 'pick'
		low gives 5
		high gives 15
	end 'pick'

	return total + bonus
end 'main'
---
ExitCode: 42
---
func @Ops.while {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @Ops.for {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 3
    arm64.epilogue 16
    arm64.ret
}

func @Ops.end {
  entry:
    arm64.prologue 16
    arm64.sub x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @if {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 4
    arm64.cset x0, gt
    arm64.cbnz x0, big
    arm64.b ifcont
  big:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @grade {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 1
    arm64.cset x0, gt
    arm64.cbnz x0, high
    arm64.b ifcont
  high:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 3
    arm64.cset x0, lt
    arm64.cbnz x0, count
    arm64.b whileexit
  count:
    arm64.movRegReg x0, x20
    arm64.bl Ops.while
    arm64.add x19, x19, x0
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x20, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x20, 3
    arm64.cset x0, lt
    arm64.cbnz x0, walk
    arm64.b forexit
  walk:
    arm64.movRegReg x0, x20
    arm64.bl Ops.for
    arm64.add x19, x19, x0
    arm64.b forstep
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x19, 0
    arm64.cset x0, gt
    arm64.cbnz x0, positive
    arm64.b ifelse
  positive:
    arm64.movImm x0, 10
    arm64.bl Ops.end
    arm64.add x19, x19, x0
    arm64.b ifcont
  ifelse:
    arm64.sub x19, x19, 1
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 5
    arm64.bl if
    arm64.bl grade
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 15
    arm64.b matchcont
  matchcont:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
