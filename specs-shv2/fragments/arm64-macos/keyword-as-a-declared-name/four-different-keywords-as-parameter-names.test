// Test: four-different-keywords-as-parameter-names
typealias Integer = int(i64.min to i64.max)

function combine(type Integer, enum Integer, union Integer, interface Integer) returns Integer
	return type + enum + union + interface
end 'combine'

function main() returns ExitCode
	return combine(1, enum: 2, union: 4, interface: 35)
end 'main'
---
ExitCode: 42
---
func @combine {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x6
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 4
    arm64.movImm x6, 35
    arm64.movRegReg x3, x6
    arm64.bl combine
    arm64.epilogue 16
    arm64.ret
}
