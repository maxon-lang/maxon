// Test: a-keyword-case-arm-whose-value-is-a-PARENTHESIZED-match
typealias Integer = int(i64.min to i64.max)

enum Kw
	function
	alpha
end 'Kw'

enum Pick
	one
	two
end 'Pick'

function classify(k Kw, p Pick) returns Integer
	return match k 'outer'
		function gives (match p 'inner'
			one gives 40
			two gives 2
		end 'inner')
		alpha gives 0
	end 'outer'
end 'classify'

function main() returns ExitCode
	return classify(Kw.function, p: Pick.one) + classify(Kw.function, p: Pick.two) + classify(Kw.alpha, p: Pick.one)
end 'main'
---
ExitCode: 42
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.cmp x1, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 40
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchcont:
    arm64.b matchcont
  matchdead:
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.bl classify
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.bl classify
    arm64.add x19, x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl classify
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
