// Test: a-keyword-named-METHOD-CALL-ending-a-block-HEADER
typealias Integer = int(i64.min to i64.max)

type Ops
	export static function otherwise(n Integer) returns bool
		return n < 3
	end 'otherwise'
end 'Ops'

function main() returns ExitCode
	var i = 0
	while Ops.otherwise(i) 'loop'
		i = i + 1
	end 'loop'

	if Ops.otherwise(i) 'lbl'
		i = 99
	end 'lbl'

	return (i * 14) as ExitCode
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  __il_body:
    arm64.cmp x0, 3
    arm64.cset x1, lt
  __il_cont#9:
    arm64.cbz x1, __il_cont#11
  loop:
    arm64.add x0, x0, 1
    arm64.b __il_body
  __il_cont#11:
    arm64.cbz x1, ifcont
  lbl:
    arm64.movImm x0, 99
  ifcont:
    arm64.movImm x16, 14
    arm64.mul x0, x0, x16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-keyword-named-METHOD-CALL-ending-a-block-HEADER.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
