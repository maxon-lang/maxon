// Test: two-instantiations-of-one-chain-body-carry-their-own-stamps
typealias Count = int(0 to u64.max)
typealias Small = int(0 to 1000)

type Bag uses Element
	typealias EChain = __ManagedList with Element
	var chain as EChain

	export static function create() returns Self
		return Self{chain: EChain.create()}
	end 'create'

	export function add(v Element)
		self.chain.insertLast(v)
	end 'add'

	export function size() returns Count
		return self.chain.count()
	end 'size'
end 'Bag'

typealias StringBag = Bag with String
typealias SmallBag = Bag with Small

function main() returns ExitCode
	var s = StringBag.create()
	s.add("alpha")
	s.add("beta")

	var n = SmallBag.create()
	n.add(1)
	n.add(2)
	n.add(3)

	return (s.size() + n.size()) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x0, [x0 + 40]
    arm64.bl __list_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.add {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __list_append
    arm64.epilogue 16
    arm64.ret
}

func @Bag.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __list_count
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Bag_String
    arm64.bl Bag.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_2
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Bag.add
    arm64.leaRdata x0, __str_rec_3
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.add x0, x21, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x23, x21
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_Bag_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl Bag.add
    arm64.leaRdata x0, __layout_Bag_Small
    arm64.bl Bag.create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Bag_Small
    arm64.movRegReg x0, x20
    arm64.bl Bag.add
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_Bag_Small
    arm64.movRegReg x0, x20
    arm64.bl Bag.add
    arm64.movImm x1, 3
    arm64.leaRdata x2, __layout_Bag_Small
    arm64.movRegReg x0, x20
    arm64.bl Bag.add
    arm64.movRegReg x0, x19
    arm64.bl Bag.size
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl Bag.size
    arm64.add x21, x21, x0
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Bag_Small
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag_String
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
