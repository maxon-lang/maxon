  __sched_shutdown_flag@200 = i64 0
  __sched_lock@208 = i64 0
  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __slab_arena_list@232 = i64 0
  __slab_arena_map_l1@240 = i64 0
  __slab_state@248 = i64 0
}

func @work {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl Runtime.yield
    arm64.cbnz x19, fail
    arm64.b ifcont
  fail:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 3
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.leaFuncAddr x0, work
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 200], x19
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.b sep
  sep:
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x20
    arm64.bl __gt_try_await
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.b __rc_chk#13
  __rc_chk#13:
    arm64.b __rc_ok#11
  __rc_ok#11:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  tryok:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk#10
  __rc_chk#10:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok#8
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at async-try-await.otherwise-bind-cross-block.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#8:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
