// Test: or-evaluates-right-when-left-false
var sideEffectCount = 0

function trackAndReturn(result bool) returns bool
	sideEffectCount = sideEffectCount + 1
	return result
end 'trackAndReturn'

function main() returns ExitCode
	let result = trackAndReturn(false) or trackAndReturn(true)
	if not result 'r'
		return 99
	end 'r'
	return sideEffectCount
end 'main'
---
ExitCode: 2
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @trackAndReturn {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl trackAndReturn
    arm64.movImm x1, 1
    arm64.cbnz x0, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.movImm x0, 1
    arm64.bl trackAndReturn
    arm64.movRegReg x1, x0
    arm64.b scmerge
  scmerge:
    arm64.eor x0, x1, 1
    arm64.cbnz x0, r
    arm64.b ifcont
  r:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
