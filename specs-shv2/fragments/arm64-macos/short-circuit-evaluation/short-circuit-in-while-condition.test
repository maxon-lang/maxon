// Test: short-circuit-in-while-condition
var trace = 0

function check() returns bool
	trace = trace + 1
	return trace < 3
end 'check'

function alwaysFalse() returns bool
	trace = trace + 100
	return false
end 'alwaysFalse'

function main() returns ExitCode
	while check() and alwaysFalse() 'loop'
		return 99
	end 'loop'
	return trace
end 'main'
---
ExitCode: 101
---
data {
  __data_trace@0 = i64 0
}

func @check {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_trace
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_trace
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_trace
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 3
    arm64.cset x0, lt
    arm64.epilogue 16
    arm64.ret
}

func @alwaysFalse {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_trace
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 100
    arm64.leaGlobal x1, __data_trace
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b whilehdr
  whilehdr:
    arm64.bl check
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.bl alwaysFalse
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  whileexit:
    arm64.leaGlobal x0, __data_trace
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
