// Test: and-skips-right-when-left-false
var sideEffectCount = 0

function trackAndReturn(result bool) returns bool
	sideEffectCount = sideEffectCount + 1
	return result
end 'trackAndReturn'

function main() returns ExitCode
	let result = trackAndReturn(false) and trackAndReturn(true)
	if result 'r'
		return 99
	end 'r'
	return sideEffectCount
end 'main'
---
ExitCode: 1
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @trackAndReturn {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl trackAndReturn
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movImm x0, 1
    arm64.bl trackAndReturn
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, r
    arm64.b ifcont
  r:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
