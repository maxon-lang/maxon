// Test: not-over-bool-or-with-overloaded-callees
typealias Integer = int(i64.min to i64.max)

type Box
	export var v as Integer
	export static function make(v Integer) returns Box
		return Box{v: v}
	end 'make'
	function contains(x Integer) returns bool
		return self.v == x
	end 'contains'
end 'Box'

type Bag
	export var w as Integer
	export static function make(w Integer) returns Bag
		return Bag{w: w}
	end 'make'
	function contains(x Integer) returns bool
		return self.w == x
	end 'contains'
end 'Bag'

function main() returns ExitCode
	let b = Box.make(5)
	let g = Bag.make(9)
	var code = 0
	if not (b.contains(5) or g.contains(1)) 'a'
		code = code + 1
	end 'a'
	if not (b.contains(1) or g.contains(1)) 'c'
		code = code + 10
	end 'c'
	if not (b.contains(1) or g.contains(9)) 'd'
		code = code + 100
	end 'd'
	return code as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.contains {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @Bag.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Bag.contains {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl Box.make
    arm64.movRegReg x19, x0
    arm64.movImm x0, 9
    arm64.bl Bag.make
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl Box.contains
    arm64.movImm x1, 1
    arm64.cbnz x0, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl Bag.contains
    arm64.movRegReg x1, x0
    arm64.b scmerge
  scmerge:
    arm64.eor x0, x1, 1
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x21, x21, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl Box.contains
    arm64.movImm x1, 1
    arm64.cbnz x0, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl Bag.contains
    arm64.movRegReg x1, x0
    arm64.b scmerge
  scmerge:
    arm64.eor x0, x1, 1
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x21, x21, 10
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl Box.contains
    arm64.movImm x1, 1
    arm64.cbnz x0, critsplit
    arm64.b orrhs
  critsplit:
    arm64.b scmerge
  orrhs:
    arm64.movImm x1, 9
    arm64.movRegReg x0, x20
    arm64.bl Bag.contains
    arm64.movRegReg x1, x0
    arm64.b scmerge
  scmerge:
    arm64.eor x0, x1, 1
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x21, x21, 100
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
