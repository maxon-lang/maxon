// Test: and-evaluates-right-when-left-true
var sideEffectCount = 0

function trackAndReturn(result bool) returns bool
	sideEffectCount = sideEffectCount + 1
	return result
end 'trackAndReturn'

function main() returns ExitCode
	let result = trackAndReturn(true) and trackAndReturn(true)
	if not result 'r'
		return 99
	end 'r'
	return sideEffectCount
end 'main'
---
ExitCode: 2
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#9
  __il_body#9:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#8
  __il_cont#8:
    arm64.b andrhs
  andrhs:
    arm64.movImm x0, 1
    arm64.b __il_body#11
  __il_body#11:
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.b __il_cont#10
  __il_cont#10:
    arm64.b scmerge
  scmerge:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, r
    arm64.b ifcont
  r:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at and-evaluates-right-when-left-true.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
