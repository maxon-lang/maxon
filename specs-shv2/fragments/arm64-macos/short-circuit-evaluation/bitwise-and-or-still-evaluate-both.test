// Test: bitwise-and-or-still-evaluate-both
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let a = 12 as Integer
	let b = 10 as Integer
	let andResult = a and b
	let orResult = a or b
	return (andResult + orResult) as ExitCode
end 'main'
---
ExitCode: 22
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 22
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
