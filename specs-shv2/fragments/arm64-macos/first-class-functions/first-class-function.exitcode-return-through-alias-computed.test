// Test: first-class-function.exitcode-return-through-alias-computed
typealias Thunk = function() returns ExitCode

function four() returns ExitCode
	return 4
end 'four'

function twice(t Thunk) returns ExitCode
	let v = t()
	return v + v + 1
end 'twice'

function main() returns ExitCode
	return twice(four)
end 'main'
---
ExitCode: 9
---
func @four {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
}

func @twice {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.blr x19
    arm64.add x0, x0, x0
    arm64.add x0, x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaFuncAddr x0, __fnref_four
    arm64.movImm x1, 0
    arm64.bl twice
    arm64.epilogue 16
    arm64.ret
}
