// Test: first-class-function.matching-signature-cast-accepted

typealias Real = float(f64.min to f64.max)
typealias Scaler = function(v Real) returns Real

function twice(v Real) returns Real
	return v * 2.0
end 'twice'

function main() returns ExitCode
	let f = twice as Scaler
	return trunc(f(3.0)) as ExitCode
end 'main'
---
ExitCode: 6
---
func @twice {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, __fnref_twice
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.movImm x0, 0
    arm64.blr x19
    arm64.fcvtzs x0, d0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
