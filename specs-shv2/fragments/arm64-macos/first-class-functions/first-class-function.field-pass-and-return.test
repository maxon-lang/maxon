// Test: first-class-function.field-pass-and-return

typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

type Handler
	export var op as UnaryOp

	static function create(op UnaryOp) returns Self
		return Self{op: op}
	end 'create'
end 'Handler'

function double(x Integer) returns Integer
	return x * 2
end 'double'

function apply(f UnaryOp, x Integer) returns Integer
	return f(x)
end 'apply'

function pick(h Handler) returns UnaryOp
	return h.op
end 'pick'

function main() returns ExitCode
	let h = Handler.create(double)
	let viaArg = apply(h.op, x: 10)
	let returned = pick(h)
	return viaArg + returned(11)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @double {
  entry:
    arm64.prologue 16
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @apply {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaFuncAddr x0, __fnref_double
    arm64.movImm x1, 0
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 10
    arm64.movImm x2, 0
    arm64.bl apply
    arm64.movRegReg x20, x0
  __il_body:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
  __il_cont:
    arm64.movImm x0, 11
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.add x0, x20, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.field-pass-and-return.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
