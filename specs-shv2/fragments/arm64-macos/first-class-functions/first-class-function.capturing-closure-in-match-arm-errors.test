// Test: first-class-function.capturing-closure-in-match-arm-errors

typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

function dbl(n Integer) returns Integer
	return n * 2
end 'dbl'

function main() returns ExitCode
	let bump = 20
	let f = function(n Integer) gives n + bump
	let sel = 1 as Integer
	let h = match sel 'pick'
		1 gives f
		default gives dbl
	end 'pick'
	return h(22)
end 'main'
---
CompilerError:
error E3099: <fragment>:15:11: cannot use a closure that captures as a `gives` arm of a match expression: a merge joins its arms through a single slot that carries the function pointer but not the capture environment, so the closure would be called with no environment. Use a function reference, or a closure that captures nothing
