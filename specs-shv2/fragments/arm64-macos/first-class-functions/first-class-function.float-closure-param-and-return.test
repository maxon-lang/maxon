// Test: first-class-function.float-closure-param-and-return

typealias Ratio = float(0.0 to 1000.0)

function main() returns ExitCode
	let f = function(x Ratio) gives x * 2.0
	let r = f(10.5)
	return trunc(r) as ExitCode
end 'main'
---
ExitCode: 21
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, main$closure_0
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.movImm x0, 0
    arm64.blr x19
    arm64.fcvtzs x0, d0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}
