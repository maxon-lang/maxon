// Test: first-class-function.alias-over-a-type-parameter-bound-to-an-enum
enum Shade
	light
	dark
end 'Shade'

type Holder uses Element
	export var value as Element

	export static function create(v Element) returns Self
		return Self{value: v}
	end 'create'
end 'Holder'

export extension Holder
	typealias Transform = function(Element) returns Element

	export function apply(f Transform) returns Element
		return f(self.value)
	end 'apply'
end 'Holder'

typealias ShadeHolder = Holder with Shade

function invert(s Shade) returns Shade
	if s == Shade.light 'wasLight'
		return Shade.dark
	end 'wasLight'
	return Shade.light
end 'invert'

function main() returns ExitCode
	let h = ShadeHolder.create(Shade.light)
	let flipped = h.apply(invert)
	if flipped == Shade.dark 'ok'
		print("dark\n")
	end 'ok'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.apply {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movRegReg x1, x2
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @invert {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, wasLight
    arm64.b ifcont
  wasLight:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 0
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaFuncAddr x2, __fnref_invert
    arm64.movImm x3, 0
    arm64.leaRdata x4, __layout_Holder_Shade
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x3
    arm64.movRegReg x3, x4
    arm64.bl Holder.apply
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.leaRdata x0, __str_rec_1  ; "dark\x0a"
    arm64.bl print
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}
