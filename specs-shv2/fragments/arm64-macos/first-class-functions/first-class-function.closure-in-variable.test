// Test: first-class-function.closure-in-variable

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let f = function(x Integer) gives x * 5
	return f(8)
end 'main'
---
ExitCode: 40
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, main$closure_0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 5
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}
