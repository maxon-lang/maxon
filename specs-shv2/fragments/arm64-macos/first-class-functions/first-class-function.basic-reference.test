// Test: first-class-function.basic-reference

typealias Integer = int(i64.min to i64.max)

function double(x Integer) returns Integer
	return x * 2
end 'double'

function main() returns ExitCode
	let f = double
	return f(21)
end 'main'
---
ExitCode: 42
---
func @double {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, __fnref_double
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
