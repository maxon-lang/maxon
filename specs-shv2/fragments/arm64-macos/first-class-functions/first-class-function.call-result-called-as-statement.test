// Test: first-class-function.call-result-called-as-statement
var sideEffect = 0

typealias Task = function()

function bump()
	sideEffect = sideEffect + 6
end 'bump'

function pickBump() returns Task
	return bump
end 'pickBump'

function main() returns ExitCode
	pickBump()()
	pickBump()()
	return sideEffect as ExitCode
end 'main'
---
ExitCode: 12
---
data {
  __data_sideEffect@0 = i64 0
}

func @bump {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_sideEffect
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 6
    arm64.leaGlobal x1, __data_sideEffect
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.b __il_body#6
  __il_body#6:
    arm64.leaFuncAddr x19, __fnref_bump
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.movImm x0, 0
    arm64.blr x19
    arm64.b __il_body#7
  __il_body#7:
    arm64.leaFuncAddr x19, __fnref_bump
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.movImm x0, 0
    arm64.blr x19
    arm64.leaGlobal x0, __data_sideEffect
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.call-result-called-as-statement.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
