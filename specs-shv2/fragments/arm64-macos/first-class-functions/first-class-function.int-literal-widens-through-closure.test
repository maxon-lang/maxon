// Test: first-class-function.int-literal-widens-through-closure

typealias Ratio = float(0.0 to 1000.0)

function main() returns ExitCode
	let f = function(x Ratio) gives x * 2.0
	return trunc(f(3)) as ExitCode
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x19, main$closure_0
    arm64.movImm x0, 3
    arm64.movImm x1, 0
    arm64.scvtf d0, x0
    arm64.movRegReg x0, x1
    arm64.blr x19
    arm64.fcvtzs x0, d0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x0, mi
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.fpLoadRdata d1, [rdata + __fconst_3]
    arm64.fcmp d0, d1
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.importCall 0
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}
