// Test: first-class-function.exitcode-return-through-alias-high
typealias Thunk = function() returns ExitCode

function big() returns ExitCode
	return 4000000000
end 'big'

function viaAlias(t Thunk) returns ExitCode
	let v = t()
	print("alias={v}\n")
	return 0
end 'viaAlias'

function main() returns ExitCode
	print("direct={big()}\n")
	return viaAlias(big)
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @big {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4000000000
    arm64.epilogue 16
    arm64.ret
}

