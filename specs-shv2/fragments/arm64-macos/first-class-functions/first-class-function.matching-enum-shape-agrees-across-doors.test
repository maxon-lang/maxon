// Test: first-class-function.matching-enum-shape-agrees-across-doors

enum Color
	red
	green
	blue
end 'Color'

typealias ColorFn = function(Color) returns Color

union Holder
	held(f ColorFn)
	empty
end 'Holder'

function next(c Color) returns Color
	match c 'k'
		red then return Color.green
		green then return Color.blue
		blue then return Color.red
	end 'k'
end 'next'

function pick() returns ColorFn
	return next
end 'pick'

function callThrough(f ColorFn) returns Color
	return f(Color.red)
end 'callThrough'

function callPayload(h Holder) returns Color
	return match h 'm'
		held(f) gives f(Color.green)
		empty gives Color.red
	end 'm'
end 'callPayload'

function show(c Color)
	match c 'k'
		red then print("red\n")
		green then print("green\n")
		blue then print("blue\n")
	end 'k'
end 'show'

function main() returns ExitCode
	show(callThrough(next))
	show(callPayload(Holder.held(next)))
	show(pick()(Color.blue))
	return 0
end 'main'
---
ExitCode: unpinned
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @next {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchnext#6:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @callThrough {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @callPayload {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#2
    arm64.b matchdead
  matcharm#2:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @show {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.leaRdata x0, __str_rec_3  ; "red\x0a"
    arm64.bl print
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.leaRdata x0, __str_rec_4  ; "green\x0a"
    arm64.bl print
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.leaRdata x0, __str_rec_5  ; "blue\x0a"
    arm64.bl print
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, __fnref_next
    arm64.movImm x1, 0
    arm64.bl callThrough
    arm64.bl show
    arm64.leaFuncAddr x19, __fnref_next
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movRegReg x0, x20
    arm64.bl callPayload
    arm64.bl show
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.b __il_body
  __il_body:
    arm64.leaFuncAddr x19, __fnref_next
    arm64.b __il_cont
  __il_cont:
