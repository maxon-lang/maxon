// Test: first-class-function.non-throwing-function-as-value-still-works
typealias Num = int(0 to 200)
typealias Op = function(Num) returns Num

function double(a Num) returns Num
	return a * 2
end 'double'

function apply(f Op, x Num) returns Num
	return f(x)
end 'apply'

function main() returns ExitCode
	let f = double
	return apply(f, x: 21)
end 'main'
---
ExitCode: 42
---
func @double {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#2
    arm64.b __rc_chk#3
  __rc_chk#3:
    arm64.cmp x0, 200
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#2
    arm64.b __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.non-throwing-function-as-value-still-works.test:5: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#5
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.cmp x0, 200
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#5
    arm64.b __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at first-class-function.non-throwing-function-as-value-still-works.test:6: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.epilogue 16
    arm64.ret
}

func @apply {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 200
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at first-class-function.non-throwing-function-as-value-still-works.test:9: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaFuncAddr x0, __fnref_double
    arm64.movImm x1, 21
    arm64.movImm x2, 0
    arm64.bl apply
    arm64.epilogue 16
    arm64.ret
}
