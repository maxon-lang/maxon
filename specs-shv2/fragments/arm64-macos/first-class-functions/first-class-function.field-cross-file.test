    arm64.leaFuncAddr x0, __fnref_double
    arm64.movImm x1, 0
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movImm x0, 10
    arm64.movImm x1, 0
    arm64.blr x20
    arm64.movRegReg x20, x0
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl Handler.run
  __il_body:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
  __il_cont:
    arm64.add x20, x20, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.add x0, x20, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at main.maxon:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
