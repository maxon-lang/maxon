// Test: mul-loop
function main() returns ExitCode
	var product = 1
	var i = 5
	while i > 1 'loop'
		product = product * i
		i = i - 1
	end 'loop'
	return product
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 5
  whilehdr:
    arm64.cmp x1, 1
    arm64.b.le whileexit
  loop:
    arm64.mul x0, x0, x1
    arm64.sub x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at mul-loop.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
