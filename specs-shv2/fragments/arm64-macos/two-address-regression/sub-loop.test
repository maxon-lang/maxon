// Test: sub-loop
function main() returns ExitCode
	var acc = 100
	var i = 1
	while i < 5 'loop'
		acc = acc - i
		i = i + 1
	end 'loop'
	return acc
end 'main'
---
ExitCode: 90
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 5
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.sub x0, x0, x1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
}
