// Test: reuse-copy-outlives
function main() returns ExitCode
	var a = 20
	var b = 5
	var i = 0
	while i < 3 'loop'
		b = a - b
		i = i + 1
	end 'loop'
	return b
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 5
    arm64.movImm x2, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x2, 3
    arm64.cset x6, lt
    arm64.cbnz x6, loop
    arm64.b whileexit
  loop:
    arm64.sub x1, x0, x1
    arm64.add x2, x2, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}
