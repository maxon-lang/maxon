    arm64.ret
  tryok#3:
    arm64.movImm x0, 2
    arm64.bl dispatch
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#6
    arm64.b tryok#5
  tryerr#6:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
