// Test: try-block.bare-throw-routed
typealias Count = int(0 to 1000)

enum Kind
    alpha
    beta
    gamma
end 'Kind'

enum MyError implements Error
    fooErr
    barErr
end 'MyError'

function dispatch(k Kind) returns Count throws MyError
    var result = 0
    try 'd'
        match k 'm'
            alpha then result = 1
            beta then throw MyError.barErr
            default throws MyError.fooErr
        end 'm'
    end 'd' otherwise (e) 'h'
        match e 'he'
            fooErr then result = 40
            barErr then result = 80
        end 'he'
    end 'h'
    return result
end 'dispatch'

function main() returns ExitCode
    let a = try dispatch(Kind.alpha) otherwise panic("alpha escaped")
    let b = try dispatch(Kind.beta) otherwise panic("beta escaped")
    let c = try dispatch(Kind.gamma) otherwise panic("gamma escaped")
    return a + b + c
end 'main'
---
ExitCode: 121
---
func @dispatch {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#5
  matcharm#2:
    arm64.movImm x0, 1
    arm64.b matchcont#6
  matchcont#6:
    arm64.b tryblkcont
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdefault
  matcharm#3:
    arm64.movImm x0, 2
    arm64.b tryblkerr
  matchdefault:
    arm64.movImm x0, 1
    arm64.b tryblkerr
  tryblkerr:
    arm64.sub x0, x0, 1
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#7
    arm64.b matchnext#10
  matcharm#7:
    arm64.movImm x0, 40
    arm64.b matchcont#11
  matchnext#10:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#8
    arm64.b matchdead
  matcharm#8:
    arm64.movImm x0, 80
    arm64.b matchcont#11
  matchcont#11:
    arm64.b tryblkcont
  tryblkcont:
    arm64.movImm x9, 0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl dispatch
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
