// Test: try-block.single-enum-success-path
typealias Score = int(0 to 100)

enum MyError implements Error
    failed
end 'MyError'

function maybeFail(x bool) returns Score throws MyError
    if x 'check'
        throw MyError.failed
    end 'check'
    return 7
end 'maybeFail'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = maybeFail(false)
        let b = maybeFail(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            failed then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 14
---
func @maybeFail {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 7
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, critsplit#11
    arm64.b tryblkok#2
  critsplit#11:
    arm64.b tryblkerr
  tryblkok#2:
    arm64.movImm x0, 0
    arm64.bl maybeFail
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, critsplit#12
    arm64.b tryblkok#3
  critsplit#12:
    arm64.b tryblkerr
  tryblkerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 99
    arm64.b matchcont
  matchcont:
    arm64.b tryblkcont
  matchdead:
  tryblkok#3:
    arm64.add x0, x19, x0
    arm64.b tryblkcont
  tryblkcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at try-block.single-enum-success-path.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
