  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl callAB
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryblkok#2
  critsplit#22:
