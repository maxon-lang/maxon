  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 6
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

