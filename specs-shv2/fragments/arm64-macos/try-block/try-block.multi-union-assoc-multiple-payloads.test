// Test: try-block.multi-union-assoc-multiple-payloads
typealias Score = int(0 to 1000)
typealias Msg = int(0 to 100)

union ErrA implements Error
    bad(code Score, msg Msg)
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad(50, msg: 7)
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(true)
        let b = callB(false)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            ErrA.bad(code, msg) then sum = code + msg
            ErrB.splat then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 57
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @callA {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x19, 50
    arm64.movImm x20, 7
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.storeBaseDispReg.word64 [x1 + 16], x20
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @callB {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 6
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl callA
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryblkthrow
    arm64.b tryblkok#2
  tryblkthrow:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x9
    arm64.b tryblkerr
  tryblkok#2:
    arm64.movImm x0, 0
    arm64.bl callB
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, critsplit
    arm64.b tryblkok#4
  critsplit:
    arm64.movRegReg x0, x9
    arm64.movRegReg x1, x9
    arm64.b tryblkerr
  tryblkerr:
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#5
    arm64.b matchnext
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 16]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#6
    arm64.b matchdead
  matcharm#6:
    arm64.movImm x0, 99
    arm64.b matchcont
  matchcont:
    arm64.b tryblkcont
  matchdead:
  tryblkok#4:
    arm64.add x0, x19, x0
    arm64.b tryblkcont
  tryblkcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
