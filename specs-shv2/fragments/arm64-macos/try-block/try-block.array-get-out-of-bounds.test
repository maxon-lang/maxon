// Test: try-block.array-get-out-of-bounds
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
    var arr = IntArray.create()
    arr.push(7)
    arr.push(11)

    var sum = 0
    try 'work'
        let a = arr.get(0)
        let b = arr.get(99)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            indexOutOfBounds then sum = 42
            emptySlot then sum = 99
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

