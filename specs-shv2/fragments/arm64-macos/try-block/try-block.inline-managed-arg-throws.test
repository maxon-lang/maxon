// Test: try-block.inline-managed-arg-throws
typealias Idx = int(0 to u64.max)
typealias IntArray = Array with Idx

enum MyError implements Error
    failed
end 'MyError'

function workFunc(arr IntArray) throws MyError
    if arr.count() == 0 'empty'
        throw MyError.failed
    end 'empty'
    arr.push(1)
end 'workFunc'

function main() returns ExitCode
    var sum = 0
    try 'work'
        workFunc(IntArray.create())
    end 'work' otherwise (e) 'h'
        match e 'k'
            failed then sum = 42
        end 'k'
    end 'h'
    return sum as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @workFunc {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.cset x1, eq
    arm64.cbnz x1, empty
    arm64.b ifcont
  empty:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x1, 1
    arm64.bl __managed_push
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl workFunc
    arm64.movRegReg x21, x9
    arm64.cmp x21, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryblkthrow
    arm64.b tryblkok
  tryblkthrow:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.b tryblkerr
  tryblkerr:
    arm64.sub x0, x21, 1
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 42
    arm64.b matchcont
  matchcont:
    arm64.b tryblkcont
  matchdead:
  tryblkok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.b tryblkcont
  tryblkcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
