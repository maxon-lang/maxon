// Test: a-keyword-case-arm-with-a-parenthesized-value-keeps-the-next-top-level-binding
enum Marker
	function
	other
end 'Marker'

function classify(m Marker) returns Idx
	return match m 'm'
		function gives (1 + 1)
		other gives 3
	end 'm'
end 'classify'

let counter = 42

function main() returns ExitCode
	if classify(Marker.function) == 2 'ok'
		return counter as ExitCode
	end 'ok'
	return 1
end 'main'
typealias Idx = int(0 to 100)
---
ExitCode: 42
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x0, 3
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-keyword-case-arm-with-a-parenthesized-value-keeps-the-next-top-level-binding.test:8: Range check failed: value outside typealias 'Idx'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  matcharm:
    arm64.movImm x1, 2
  matchcont:
    arm64.cmp x1, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.cmp x1, 100
    arm64.b.le __rc_ok
  __il_slow:
    arm64.bl classify
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.cmp x0, 2
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
