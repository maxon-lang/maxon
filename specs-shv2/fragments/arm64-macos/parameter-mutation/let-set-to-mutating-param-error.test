// Test: let-set-to-mutating-param-error
typealias Integer = int(i64.min to i64.max)
typealias IntSet = Set with Integer

function add(s IntSet)
	s.insert(1)
end 'add'

function main() returns ExitCode
	let s = IntSet.create()
	add(s)
	return s.count() as ExitCode
end 'main'
---
CompilerError:
error E3019: <fragment>:11:2: cannot pass 's' to function that mutates parameter 's' (in main)
