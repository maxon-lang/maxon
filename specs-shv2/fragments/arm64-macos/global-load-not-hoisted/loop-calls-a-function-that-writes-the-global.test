// Test: loop-calls-a-function-that-writes-the-global


var counter = 0

function bump()
	counter = counter + 1
end 'bump'

function main() returns ExitCode
	var seen = 0
	var n = 0
	while n < 5 'loop'
		bump()
		seen = seen + counter
		n = n + 1
	end 'loop'
	return seen
end 'main'
---
ExitCode: 15
---
data {
  __data_counter@0 = i64 0
}

func @bump {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_counter
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 5
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.bl bump
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x19, x19, x0
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
