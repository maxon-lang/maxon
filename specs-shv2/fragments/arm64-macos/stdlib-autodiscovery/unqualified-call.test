// Test: unqualified-call
function main() returns ExitCode
	let result = sqrt(16.0)
	return trunc(result)
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fsqrt d0, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
