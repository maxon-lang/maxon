// Test: stdlib-generic-create-reached-as-a-factory-argument
typealias Count = int(0 to u64.max)
typealias StrMap = Map with (String, Count)

type Holder
	export var table as StrMap

	static function create(table StrMap) returns Self
		return Self{table: table}
	end 'create'
end 'Holder'

var h = Holder.create(StrMap.create())

function main() returns ExitCode
	h.table.upsert("a", value: 6)
	return h.table.count() as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __data_h@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Map_String_Count
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_h
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.leaRdata x20, __str_rec_1
    arm64.movImm x21, 6
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x22, x0
    arm64.loadRegBaseDisp.word64 x23, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x20 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x25, x20
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
    arm64.storeBaseDispReg.word64 [x24 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x24 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x24 + 24], x0
    arm64.leaRdata x3, __layout_Map_String_Count
    arm64.leaRdata x4, __witness_String.Hashable
    arm64.leaRdata x5, __witness_String.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x21
    arm64.bl Map.upsert
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Map_String_Count
    arm64.leaGlobal x0, __data_h
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.leaRdata x2, __witness_String.Equatable
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 32]
    arm64.cmp x3, 0
    arm64.cset x4, lt
    arm64.cbnz x4, __il_slow
    arm64.b __rc_chk#7
  __rc_chk#7:
    arm64.movImm x4, 4611686018427387904
    arm64.cmp x3, x4
    arm64.cset x4, gt
    arm64.cbnz x4, __il_slow
    arm64.b __rc_ok#6
  __il_slow:
