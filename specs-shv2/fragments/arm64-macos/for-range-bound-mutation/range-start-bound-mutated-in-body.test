// Test: range-start-bound-mutated-in-body
function main() returns ExitCode
	var n = 0
	var total = 0
	for i in n upto 3 'l'
		n = n + 1
		total = total + i
	end 'l'
	return total
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.movRegReg x2, x1
    arm64.movRegReg x1, x0
  forhdr:
    arm64.cmp x0, 3
    arm64.b.ge forexit
  l:
    arm64.add x1, x1, 1
    arm64.add x2, x2, x0
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x2, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x2, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-start-bound-mutated-in-body.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x2
    arm64.epilogue 16
    arm64.ret
}
