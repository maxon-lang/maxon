// Test: range-bound-write-takes-effect
function main() returns ExitCode
	var n = 1
	var total = 0
	for i in n upto 4 'l'
		n = n + 10
		total = total + i
	end 'l'
	return (total + n) as ExitCode
end 'main'
---
ExitCode: 37
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.movRegReg x2, x1
    arm64.movRegReg x1, x0
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, 4
    arm64.cset x6, lt
    arm64.cbnz x6, l
    arm64.b forexit
  l:
    arm64.add x1, x1, 10
    arm64.add x2, x2, x0
    arm64.b forstep
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  forexit:
    arm64.add x0, x2, x1
    arm64.epilogue 16
    arm64.ret
}
