// Test: threading-does-not-drop-an-edge-copy
var seed = 4

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < seed 'loop'
		var step = 0
		if i mod 2 == 0 'even'
			step = 1
		end 'even' else 'odd'
			step = 10
		end 'odd'
		total = total + step
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 22
---
data {
  __data_seed@0 = i64 4
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  whilehdr:
    arm64.leaGlobal x2, __data_seed
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.cmp x1, x2
    arm64.b.ge whileexit
  loop:
    arm64.asr x2, x1, 63
    arm64.lsr x2, x2, 63
    arm64.add x2, x1, x2
    arm64.asr x2, x2, 1
    arm64.lsl x2, x2, 1
    arm64.sub x2, x1, x2
    arm64.cmp x2, 0
    arm64.b.ne ifelse
  even:
    arm64.movImm x2, 1
    arm64.b ifcont
  ifelse:
    arm64.movImm x2, 10
  ifcont:
    arm64.add x0, x0, x2
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at threading-does-not-drop-an-edge-copy.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
