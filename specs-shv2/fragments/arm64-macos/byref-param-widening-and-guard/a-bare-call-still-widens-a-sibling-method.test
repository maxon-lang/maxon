// Test: a-bare-call-still-widens-a-sibling-method
typealias Integer = int(i64.min to i64.max)

type Runner
	export var seed as Integer

	static function create() returns Self
		return Self{seed: 0}
	end 'create'

	function inner(n Integer) returns Integer
		n = 42
		return n
	end 'inner'

	function outer(n Integer) returns Integer
		_ = inner(n)
		return n
	end 'outer'
end 'Runner'

function main() returns ExitCode
	var r = Runner.create()
	var start = 7
	return r.outer(start)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Runner.inner {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Runner.outer {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.movRegReg x1, x19
    arm64.bl Runner.inner
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x21
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaRegSlot x19, slot0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.movImm x20, 7
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x20
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl Runner.outer
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.loadRegSlot x21, slot3
    arm64.epilogue 48
    arm64.ret
}
