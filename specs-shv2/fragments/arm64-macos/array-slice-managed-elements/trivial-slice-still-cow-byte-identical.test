// Test: trivial-slice-still-cow-byte-identical
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function main() returns ExitCode
		var src = IntArray.create()
		src.push(10)
		src.push(20)
		src.push(30)

		let sub = try src.slice(1, endIndex: 3) otherwise return 98

		if sub.count() != 2 'badCount'
				return 99
		end 'badCount'

		return try sub.get(0) otherwise 97
end 'main'
---
ExitCode: 20
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movImm x2, 3
    arm64.movRegReg x0, x19
    arm64.bl __arr_slice
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 98
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __arr_count
    arm64.cmp x0, 2
    arm64.cset x0, ne
    arm64.cbnz x0, badCount
    arm64.b ifcont
  badCount:
    arm64.movImm x21, 99
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x21, 97
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
