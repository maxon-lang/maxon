// Test: slice-union-string-payload
typealias Integer = int(i64.min to i64.max)

union Node
		leaf(name String)
		branch(value Integer)
		empty
end 'Node'

typealias NodeArray = Array with Node

function checkLeaf(n String) returns ExitCode
		if n == "first leaf node name long enough for heap" 'correct'
				return 0
		end 'correct'
		return 1
end 'checkLeaf'

function makeSlice() returns NodeArray throws ArrayError
		var src = NodeArray.create()
		src.push(Node.leaf("first leaf node name long enough for heap"))
		src.push(Node.branch(42))
		src.push(Node.leaf("third leaf node name long enough for heap"))
		return try src.slice(0, endIndex: 2)
		// src is freed when this function returns
end 'makeSlice'

function main() returns ExitCode
		let sliced = try makeSlice() otherwise return 96

		if sliced.count() != 2 'badCount'
				return 99
		end 'badCount'

		let node = try sliced.get(0) otherwise Node.empty
		match node 'check'
				leaf(n) then return checkLeaf(n)
				branch then return 98
				empty then return 97
		end 'check'
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @checkLeaf {
  entry:
    arm64.prologue 16
    arm64.leaRdata x1, __str_rec_2  ; "first leaf node name long enough for heap"
    arm64.bl __str_eq
    arm64.cbnz x0, correct
    arm64.b ifcont
  correct:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @makeSlice {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __destruct_Node
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __str_rec_2  ; "first leaf node name long enough for heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
    arm64.movImm x20, 42
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaRdata x20, __str_rec_3  ; "third leaf node name long enough for heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.leaRdata x3, __layout_Array_Node
    arm64.movRegReg x0, x19
    arm64.bl Array.slice
    arm64.movRegReg x20, x0
    arm64.movRegReg x21, x9
    arm64.cmp x21, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
