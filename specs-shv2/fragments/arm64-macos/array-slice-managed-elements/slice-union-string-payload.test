    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 40]
    arm64.cmp x2, 0
    arm64.cset x2, ne
    arm64.cbnz x2, __im_empty
    arm64.b critsplit#19
  __im_empty:
    arm64.cmp x20, 0
    arm64.cset x2, eq
    arm64.cbnz x2, __im_slow
    arm64.b critsplit#20
  __im_slow:
    arm64.movRegReg x0, x19
