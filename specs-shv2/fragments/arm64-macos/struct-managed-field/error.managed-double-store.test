// Test: error.managed-double-store
typealias Integer = int(i64.min to i64.max)

type Pair
	export var a as String
	export var b as String

	static function create(v String) returns Self
		return Self{a: v, b: v}
	end 'create'
end 'Pair'

function main() returns ExitCode
	let p = Pair.create("{7}")
	return 0
end 'main'
