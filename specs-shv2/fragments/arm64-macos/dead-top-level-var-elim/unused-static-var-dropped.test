// Test: unused-static-var-dropped
var unused = 99
var used = 42

function main() returns ExitCode
	return used - 42
end 'main'
---
ExitCode: 0
---
data {
  __data_used@0 = i64 42
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_used
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.sub x0, x0, 42
    arm64.epilogue 16
    arm64.ret
}
