// Test: conformance-multiple-interfaces

typealias Integer = int(i64.min to i64.max)

interface Readable
	function read() returns Integer
end 'Readable'

interface Writable
	function write(value Integer)
end 'Writable'

type Buffer implements Readable, Writable
	var data as Integer

	function read() returns Integer
		return data
	end 'read'

	function write(value Integer)
		data = value
	end 'write'

	static function create(data Integer) returns Self
		return Self{data: data}
	end 'create'
end 'Buffer'

function main() returns ExitCode
	var buf = Buffer.create(0)
	buf.write(42)
	return buf.read()
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 0
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 42
    arm64.b __il_body#6
  __il_body#6:
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at conformance-multiple-interfaces.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
