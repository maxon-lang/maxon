// Test: multiple-mutable-fields
typealias Integer = int(i64.min to i64.max)

union Pair
	empty
	values(a Integer, b Integer)
end 'Pair'

function main() returns ExitCode
	var p = Pair.values(1, b: 2)
	match p 'update-a'
		values(a, _) then a = 10
		empty then return 0
	end 'update-a'
	match p 'update-b'
		values(_, b) then b = 32
		empty then return 0
	end 'update-b'
	match p 'read'
		values(a, b) then return a + b
		empty then return 0
	end 'read'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 2
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.storeBaseDispReg.word64 [x0 + 16], x20
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#2
    arm64.b matchnext#4
  matcharm#2:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext#4:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchdead#3
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.movImm x1, 10
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.b matchcont#5
  matchcont#5:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#7
    arm64.b matchnext#9
  matcharm#7:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext#9:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#6
    arm64.b matchdead#8
  matcharm#6:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 16]
    arm64.movImm x1, 32
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.b matchcont#10
  matchcont#10:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#12
    arm64.b matchnext#14
  matcharm#12:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext#14:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#11
    arm64.b matchdead#13
  matcharm#11:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 16]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead#13:
  matchdead#8:
  matchdead#3:
  matchcont#15:
}
