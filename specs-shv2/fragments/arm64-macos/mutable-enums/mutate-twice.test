// Test: mutate-twice
typealias Integer = int(i64.min to i64.max)

union Cell
	empty
	holding(value Integer)
end 'Cell'

function main() returns ExitCode
	var c = Cell.holding(10)
	match c 'first'
		holding(value) then value = 20
		empty then return 0
	end 'first'
	match c 'second'
		holding(value) then value = value + 22
		empty then return 0
	end 'second'
	match c 'read'
		holding(value) then return value
		empty then return 0
	end 'read'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
