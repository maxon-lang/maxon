// Test: array-of-structs-enum-for-in-loop
// Regression test: enum match works in for-in loop over struct array
enum Status
	pending
	active
	done
end 'Status'

type Task
	export var status as Status

	static function create(status Status) returns Self
		return Self{status: status}
	end 'create'
end 'Task'

typealias TaskArray = Array with Task

function main() returns ExitCode
	var tasks = TaskArray.create()
	tasks.push(Task.create(Status.pending))
	tasks.push(Task.create(Status.active))
	tasks.push(Task.create(Status.done))

	var activeCount = 0
	for task in tasks 'loop'
		match task.status 'check'
			active then activeCount = activeCount + 1
			pending then break
			done then break
		end 'check'
	end 'loop'

	return activeCount
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Task.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.bl Task.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 1
    arm64.bl Task.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x0, 2
    arm64.bl Task.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b forexit
  loop:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __arr_get_unchecked
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.add x0, x20, 1
    arm64.movRegReg x20, x0
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.b matchcont
  matchcont:
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  matchdead:
  forexit:
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  afterbreak:
  afterbreak:
}
