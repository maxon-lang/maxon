// Test: managed-field-as-a-value-releases-in-every-forking-region
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function bufLength(m __ManagedMemory) returns Integer
	return m.length()
end 'bufLength'

function main() returns ExitCode
	var a = ByteArray.create()
	a.push(1 as Byte)
	a.push(2 as Byte)
	var total = 0

	if bufLength(a.managed) > 1 'big'
		total = total + 1
	end 'big'

	while bufLength(a.managed) > total 'spin'
		total = total + 1
	end 'spin'

	for b in a.managed 'each'
		total = total + b
	end 'each'

	a = "xyz".toByteArray()
	total = total + bufLength(a.managed) + a.count()

	print("{total}")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
  __il_body#16:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#15:
    arm64.cmp x1, 1
    arm64.cset x21, gt
    arm64.bl __managed_decref
    arm64.cbz x21, critsplit
  big:
    arm64.movImm x0, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x20
  ifcont:
    arm64.movRegReg x20, x0
  whilehdr:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
  __il_body#18:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#17:
    arm64.cmp x1, x20
    arm64.cset x21, gt
    arm64.bl __managed_decref
    arm64.cbz x21, whileexit
  spin:
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.movImm x22, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x22, x0
    arm64.b.ge forexit
  each:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.arm64AddLsl x0, x0, x22, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_cont
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.add x0, x0, x22
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __managed_get_unchecked
  __im_cont:
    arm64.add x20, x20, x0
  forstep:
    arm64.add x22, x22, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.leaRdata x0, __str_rec_1  ; "xyz"
    arm64.bl String.toByteArray
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_retain
  __il_body#20:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
  __il_cont#19:
    arm64.add x1, x20, x1
    arm64.loadRegBaseDisp.word64 x2, [x21 + 8]
    arm64.add x19, x1, x2
    arm64.bl __managed_decref
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.add x0, x19, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x23, x19
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x19
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.bl print
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
