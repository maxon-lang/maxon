    arm64.b __im_cont
  critsplit#25:
    arm64.movRegReg x9, x1
    arm64.b __im_cont
  critsplit#24:
    arm64.movRegReg x9, x1
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr#12:
    arm64.leaRdata x0, __str_rec_6  ; ""
  trycont:
    arm64.bl String.count
    arm64.cmp x0, 0
    arm64.b.ne critsplit#23
  empty:
    arm64.add x0, x20, 1
    arm64.b forstep#9
  critsplit#23:
    arm64.movRegReg x0, x20
  forstep#9:
    arm64.add x21, x21, 1
    arm64.movRegReg x20, x0
    arm64.b forhdr#7
  forexit#10:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_18  ; "panic at clear-then-regrow-managed-no-double-free.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
