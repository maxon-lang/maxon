// Test: a-tuple-of-byte-arrays-still-serves-count
typealias Int = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function pair() returns (ByteArray, Int)
	return ("hello".toByteArray(), 7)
end 'pair'

function main() returns ExitCode
	let p = pair()
	return p.0.count() as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @pair {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __str_to_bytes
    arm64.movImm x19, 7
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl pair
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __arr_count
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct___Tuple2.Array_Byte.int
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
