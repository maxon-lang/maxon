// Test: empty-string-bytes-push
function main() returns ExitCode
	let s = ""
	var v = s.toByteArray()
	v.push(65)
	return v.count() as ExitCode
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __str_to_bytes
    arm64.movImm x1, 65
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movRegReg x0, x20
    arm64.bl __arr_count
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
