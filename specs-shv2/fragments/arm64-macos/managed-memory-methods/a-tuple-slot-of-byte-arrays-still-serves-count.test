// Test: a-tuple-slot-of-byte-arrays-still-serves-count
typealias Int = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte
typealias BufList = Array with ByteArray

function slotted(t (BufList, Int)) returns Int
	let m = try t.0.get(0) otherwise return 0
	return m.count()
end 'slotted'

function main() returns ExitCode
	var a = BufList.create()
	a.push("hello".toByteArray())
	return slotted((a, 7)) as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @slotted {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.bl __arr_count
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __arr_decref
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __str_rec_1
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __str_to_bytes
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __arr_push
    arm64.movImm x20, 7
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x21
    arm64.bl slotted
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __destruct___Tuple2.Array_ByteArray.int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
