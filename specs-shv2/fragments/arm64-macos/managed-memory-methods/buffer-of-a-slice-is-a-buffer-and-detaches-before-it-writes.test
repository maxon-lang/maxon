// Test: buffer-of-a-slice-is-a-buffer-and-detaches-before-it-writes
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(11)
	arr.push(22)
	arr.push(33)
	let sub = try arr.slice(0, endIndex: 2) otherwise panic("slice: 0..2 of a length-3 array")
	try sub.managed.setLength(1) otherwise panic("setLength: a detached view publishes its live length")
	try sub.managed.setByte(0, 99) otherwise panic("setByte: offset 0 of a detached 8-byte slot")
	let parent = try arr.get(0) otherwise panic("get: index 0 of a length-3 array")
	return (sub.managed.length() + parent) as ExitCode
end 'main'
---
ExitCode: 12
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 11
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 22
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 33
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.leaRdata x3, __layout_Array_Int
    arm64.movRegReg x0, x19
    arm64.bl Array.slice
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at buffer-of-a-slice-is-a-buffer-and-detaches-before-it-writes.test:10: slice: 0..2 of a length-3 array\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at buffer-of-a-slice-is-a-buffer-and-detaches-before-it-writes.test:11: setLength: a detached view publishes its live length\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movImm x1, 0
    arm64.movImm x2, 99
    arm64.movRegReg x0, x20
    arm64.bl __managed_set_byte
    arm64.cmp x9, 0
    arm64.b.eq tryok#5
  tryerr#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at buffer-of-a-slice-is-a-buffer-and-detaches-before-it-writes.test:12: setByte: offset 0 of a detached 8-byte slot\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#5:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#16
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#17
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#17:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#16:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok#7
  tryerr#8:
    arm64.leaRdata x0, __str_blob_3  ; "panic at buffer-of-a-slice-is-a-buffer-and-detaches-before-it-writes.test:13: get: index 0 of a length-3 array\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#7:
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.add x21, x1, x0
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at buffer-of-a-slice-is-a-buffer-and-detaches-before-it-writes.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
