// Test: declared-return-type-serves-the-roster
function makeBuf() returns __ManagedMemory
	return "hello".toByteArray()
end 'makeBuf'

function main() returns ExitCode
	let m = makeBuf()
	let part = try m.slice(1, 4) otherwise return 1
	return (m.length() + part.length()) as ExitCode
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeBuf {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "hello"
    arm64.bl String.toByteArray
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl makeBuf
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movImm x2, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_slice
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.add x20, x1, x2
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at declared-return-type-serves-the-roster.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
