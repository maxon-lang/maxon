// Test: self-passed-as-an-argument

typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer

	static function create(x Integer) returns Self
		return Self{x: x}
	end 'create'

	export function tally(p Point) returns Integer
		return self.x + p.x
	end 'tally'

	export function combineWith(other Point) returns Integer
		return other.tally(self)
	end 'combineWith'
end 'Point'

function pick(a Point, b Point) returns Point
	if a.x > b.x 'bigger'
		return a
	end 'bigger' else 'smaller'
		return b
	end 'smaller'
end 'pick'

function main() returns ExitCode
	let p = Point.create(11)
	let q = Point.create(31)
	let w = pick(p, b: q)
	return (p.combineWith(q) + w.x) as ExitCode
end 'main'
---
ExitCode: 73
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Point.combineWith {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x1, x0
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x3, [x1 + 0]
    arm64.cmp x2, x3
    arm64.b.le ifelse
  bigger:
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movRegReg x0, x1
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 11
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 31
    arm64.bl Point.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl pick
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Point.combineWith
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.add x22, x0, x1
    arm64.cmp x22, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x22, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at self-passed-as-an-argument.test:33: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
