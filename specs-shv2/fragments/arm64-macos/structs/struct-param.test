// Test: struct-param

typealias Integer = int(i64.min to i64.max)

type Vec2
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Vec2'

function dot(a Vec2, b Vec2) returns Integer
	return a.x * b.x + a.y * b.y
end 'dot'

function main() returns ExitCode
	let v1 = Vec2.create(3, y: 4)
	let v2 = Vec2.create(2, y: 1)
	return dot(v1, b: v2)
end 'main'
---
ExitCode: 10
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Vec2.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @dot {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x6, [x1 + 0]
    arm64.mul x2, x2, x6
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.mul x0, x0, x1
    arm64.add x0, x2, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.bl Vec2.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 2
    arm64.movImm x1, 1
    arm64.bl Vec2.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl dot
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
