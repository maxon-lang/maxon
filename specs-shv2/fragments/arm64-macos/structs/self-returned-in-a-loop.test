// Test: self-returned-in-a-loop

typealias Integer = int(i64.min to i64.max)

type Tally
	export var n as Integer
	export var label as String

	static function create(n Integer) returns Self
		return Self{n: n, label: "t"}
	end 'create'

	export function itself() returns Tally
		return self
	end 'itself'
end 'Tally'

function main() returns ExitCode
	let t = Tally.create(3)
	var sum = 0
	for _ in 0 upto 14 'trip'
		let handle = t.itself()
		sum = sum + handle.n + handle.label.count()
	end 'trip'
	return sum as ExitCode
end 'main'
---
ExitCode: 56
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Tally.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __str_rec_1  ; "t"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Tally.itself {
  entry:
    arm64.prologue 16
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.bl Tally.create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  forhdr:
    arm64.cmp x21, 14
    arm64.b.ge forexit
  trip:
    arm64.movRegReg x0, x19
    arm64.bl Tally.itself
    arm64.movRegReg x22, x0
    arm64.loadRegBaseDisp.word64 x0, [x22 + 0]
    arm64.add x20, x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x22 + 8]
    arm64.bl String.count
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Tally
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_13  ; "panic at self-returned-in-a-loop.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Tally
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
