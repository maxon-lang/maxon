// Test: order-sensitive-body-through-a-reversal
function mix6(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer) returns Integer
	return a - b * 2 + c * 3 - d * 4 + e * 5 - f * 6
end 'mix6'

function flip6(a Integer, b Integer, c Integer, d Integer, e Integer, f Integer) returns Integer
	return mix6(f, b: e, c: d, d: c, e: b, f: a)
end 'flip6'

function main() returns ExitCode
	let r = flip6(1, b: 20, c: 3, d: 30, e: 2, f: 40)
	if r == 208 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @flip6 {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x16, 2
    arm64.mul x4, x4, x16
    arm64.sub x4, x5, x4
    arm64.movImm x16, 3
    arm64.mul x3, x3, x16
    arm64.add x3, x4, x3
    arm64.movImm x16, 4
    arm64.mul x2, x2, x16
    arm64.sub x2, x3, x2
    arm64.movImm x16, 5
    arm64.mul x1, x1, x16
    arm64.add x1, x2, x1
    arm64.movImm x16, 6
    arm64.mul x0, x0, x16
    arm64.sub x0, x1, x0
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 20
    arm64.movImm x2, 3
    arm64.movImm x3, 30
    arm64.movImm x4, 2
    arm64.movImm x5, 40
    arm64.bl flip6
    arm64.cmp x0, 208
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
