// Test: recursive-permuting-six-params
function rot(p1 Integer, p2 Integer, p3 Integer, p4 Integer, p5 Integer, n Integer) returns Integer
	if n <= 0 'base'
		return p1 * 10000 + p2 * 1000 + p3 * 100 + p4 * 10 + p5
	end 'base'
	return rot(p2, p2: p3, p3: p4, p4: p5, p5: p1, n: n - 1)
end 'rot'

function main() returns ExitCode
	let r = rot(1, p2: 2, p3: 3, p4: 4, p5: 5, n: 3)
	if r == 45123 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @rot {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x0
    arm64.cmp x5, 0
    arm64.cset x0, le
    arm64.cbnz x0, base
    arm64.b ifcont
  base:
    arm64.movImm x16, 10000
    arm64.mul x0, x6, x16
    arm64.movImm x16, 1000
    arm64.mul x1, x1, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 100
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 10
    arm64.mul x1, x3, x16
    arm64.add x0, x0, x1
    arm64.add x0, x0, x4
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x5, x5, 1
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x3
    arm64.movRegReg x3, x4
    arm64.movRegReg x4, x6
    arm64.bl rot
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x3, 4
    arm64.movImm x4, 5
    arm64.movImm x5, 3
    arm64.bl rot
    arm64.movImm x16, 45123
    arm64.cmp x0, x16
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
