// Test: checked-divide-in-a-loop
function opaque(x int) returns int
	return x
end 'opaque'

function main() returns ExitCode
	var sum = 0
	var i = 1
	while i <= 6 'loop'
		sum = sum + (try (100 / opaque(i)) otherwise 0)
		i = i + 1
	end 'loop'
	return sum as ExitCode
end 'main'
---
ExitCode: 244
---
func @opaque {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 6
    arm64.cset x0, le
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movImm x21, 100
    arm64.movRegReg x0, x20
    arm64.bl opaque
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.orr x0, x0, x1
    arm64.sdiv x0, x21, x0
    arm64.cmp x1, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.add x19, x19, x0
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
