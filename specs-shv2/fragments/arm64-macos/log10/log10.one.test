    arm64.fdiv d0, d1, d0
    arm64.cmp x1, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.fpLoadRdata d0, [rdata + __fconst_4]
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.fmul d1, d0, d0
    arm64.movImm x1, 1
    arm64.movRegReg d2, d0
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, x0
    arm64.cset x2, lt
    arm64.cbnz x2, series
    arm64.b forexit
  series:
    arm64.fmul d0, d0, d1
    arm64.fpLoadRdata d3, [rdata + __fconst_5]
    arm64.scvtf d4, x1
    arm64.fmul d3, d3, d4
    arm64.fpLoadRdata d4, [rdata + __fconst_3]
    arm64.fadd d3, d3, d4
    arm64.fpLoadRdata d4, [rdata + __fconst_4]
    arm64.fcmp d3, d4
    arm64.cset x2, eq
    arm64.fdiv d3, d0, d3
    arm64.cmp x2, 0
    arm64.cset x2, ne
    arm64.cbnz x2, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_1
