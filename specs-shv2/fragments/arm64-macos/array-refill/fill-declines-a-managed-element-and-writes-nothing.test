// Test: fill-declines-a-managed-element-and-writes-nothing
typealias StringArray = Array with String

function main() returns ExitCode
	var arr = StringArray.create()
	arr.push("alpha")
	arr.push("beta")
	let applied = try arr.managed.fill(0, count: 2, value: "zeta") otherwise panic("fill: [0, 2) is exactly the live range")
	if applied 'aManagedElementMustDecline'
		return 1
	end 'aManagedElementMustDecline'
	let first = try arr.get(0) otherwise "??"
	if first == "alpha" 'theSlotIsUntouched'
		return 6
	end 'theSlotIsUntouched'
	return 2
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_4  ; "alpha"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_5  ; "beta"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.leaRdata x3, __str_rec_6  ; "zeta"
    arm64.movRegReg x0, x19
    arm64.bl __managed_fill
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#2:
    arm64.leaRdata x0, __str_blob_7  ; "panic at fill-declines-a-managed-element-and-writes-nothing.test:8: fill: [0, 2) is exactly the live range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.cbz x0, ifcont#4
  aManagedElementMustDecline:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#14
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#15
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#15:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x9, x2
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr#6:
    arm64.leaRdata x0, __str_rec_8  ; "??"
  trycont:
    arm64.leaRdata x1, __str_rec_4  ; "alpha"
    arm64.bl __str_eq
    arm64.cbz x0, ifcont#9
  theSlotIsUntouched:
    arm64.movImm x20, 6
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#9:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
