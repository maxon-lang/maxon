// Test: refill-packed-bool-to-false
typealias BoolArray = Array with bool

function main() returns ExitCode
	var arr = BoolArray.create()
	arr.refill(9, value: true)
	arr.refill(9, value: false)
	var lit = 0
	for b in arr 'count'
		if b 'set'
			lit = lit + 1
		end 'set'
	end 'count'
	return lit + arr.count()
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 18446744073709551615
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 9
    arm64.movImm x2, 1
    arm64.leaRdata x3, __layout_Array_bool
    arm64.movRegReg x0, x19
    arm64.bl Array.refill
    arm64.movImm x1, 9
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Array_bool
    arm64.movRegReg x0, x19
    arm64.bl Array.refill
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, count
    arm64.b forexit
  count:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
    arm64.cbnz x0, set
    arm64.b critsplit
  set:
    arm64.add x0, x20, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x20
    arm64.b ifcont
  ifcont:
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.movRegReg x20, x0
    arm64.b forhdr
  forexit:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_9
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
