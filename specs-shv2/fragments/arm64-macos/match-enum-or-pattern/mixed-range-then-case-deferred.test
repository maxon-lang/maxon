// Test: mixed-range-then-case-deferred
function classify(v E) returns ExitCode
	return match v 'm'
		c to d or a gives 1
		b gives 2
	end 'm'
end 'classify'

enum E
	a
	b
	c
	d
end 'E'

function main() returns ExitCode
	for x in E.allCases 'e'
		print("{x.name}={classify(x)}\n")
	end 'e'
	return 0
end 'main'
