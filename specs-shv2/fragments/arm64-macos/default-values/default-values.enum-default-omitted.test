// Test: default-values.enum-default-omitted
enum Color
	red
	green
	blue
end 'Color'

function paint(color Color = Color.blue) returns ExitCode
	return color.rawValue
end 'paint'

function main() returns ExitCode
	return paint()
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#3
  __il_body#3:
    arm64.b __il_cont#2
  __il_cont#2:
    arm64.b __il_body#4
  __il_body#4:
    arm64.movImm x0, 2
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.b __il_cont#1
  __il_cont#1:
    arm64.epilogue 16
    arm64.ret
}
