    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @pick#String {
  entry:
    arm64.prologue 16
    arm64.bl String.count
    arm64.add x0, x0, 33
    arm64.movImm x1, 44
    arm64.bl Bag.of
    arm64.epilogue 16
    arm64.ret
}

