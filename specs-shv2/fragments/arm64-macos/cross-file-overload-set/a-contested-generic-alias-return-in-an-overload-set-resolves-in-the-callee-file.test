// Test: a-contested-generic-alias-return-in-an-overload-set-resolves-in-the-callee-file
// --- file: adef.maxon
typealias Num = int(0 to 125)
typealias Bag = Array with Num

public function makeBag() returns Bag
	var b = Bag.create()
	b.push(4)
	b.push(9)
	return b
end 'makeBag'

public function makeBag(tag String) returns String
	return "t{tag}"
end 'makeBag'

// --- file: cmain.maxon
typealias Bag = Array with String

function main() returns ExitCode
	var mine = Bag.create()
	mine.push("x")
	var theirs = makeBag()
	return ((try theirs.get(1) otherwise 0) * 10 + mine.count()) as ExitCode
end 'main'
---
ExitCode: 91
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeBag {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 9
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

