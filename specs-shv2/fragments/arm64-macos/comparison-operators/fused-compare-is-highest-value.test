// Test: fused-compare-is-highest-value
function main() returns ExitCode
	let a = 7
	let b = 3
	if a < b 'lt'
		return b
	end 'lt'
	return a
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.movImm x1, 3
    arm64.cmp x0, 3
    arm64.cset x2, lt
    arm64.cbnz x2, lt
    arm64.b ifcont
  lt:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
