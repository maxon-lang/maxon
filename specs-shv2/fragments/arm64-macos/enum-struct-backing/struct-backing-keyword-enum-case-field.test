// Test: struct-backing-keyword-enum-case-field
enum Cat
	bool
	int
end 'Cat'

type Info
	export let cat as Cat
end 'Info'

enum Kind
	a = Info{cat: Cat.bool}
	b = Info{cat: Cat.int}
end 'Kind'

function classify(k Kind) returns ExitCode
	return match k 'm'
		a gives 4
		b gives 1
	end 'm'
end 'classify'

function main() returns ExitCode
	return classify(Kind.b)
end 'main'
---
ExitCode: 1
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext
  matcharm#1:
    arm64.movImm x0, 4
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#2
    arm64.b matchdead
  matcharm#2:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at struct-backing-keyword-enum-case-field.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.b __il_body
  __il_body:
    arm64.b matchnext
  matchnext:
    arm64.b matcharm
  matcharm:
    arm64.movImm x1, 1
    arm64.b matchcont
  matchcont:
    arm64.cmp x1, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __il_slow
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 255
    arm64.cset x2, gt
    arm64.cbnz x2, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.bl classify
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
