// Test: cast-preserves-source
typealias Integer = int(i64.min to i64.max)

type Wrapper uses T
	export typealias Idx = int(0 to u64.max)

	export var value as T
	export var tag as Idx

	export static function create(value T, tag Idx) returns Self
		return Self{value: value, tag: tag}
	end 'create'

	export function getTag() returns Idx
		return self.tag
	end 'getTag'

	export function setTag(t Idx)
		self.tag = t
	end 'setTag'
end 'Wrapper'

typealias WA = Wrapper with Integer
typealias WB = Wrapper with Integer

function main() returns ExitCode
	let a = WA.create(1, tag: 5)
	let aTag = a.getTag()
	let bTag = aTag as WB.Idx
	var a2 = WA.create(9, tag: 0)
	a2.setTag(aTag)
	let check = a2.getTag()
	if bTag == 5 'converted'
		if check == 5 'preserved'
			return 0
		end 'preserved'
	end 'converted'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 1
    arm64.movImm x1, 5
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.b __il_body#8
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 8]
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.movImm x1, 9
    arm64.movImm x2, 0
    arm64.leaRegSlot x3, slot2
    arm64.storeBaseDispReg.word64 [x3 + 0], x1
    arm64.storeBaseDispReg.word64 [x3 + 8], x2
    arm64.b __il_body#9
  __il_body#9:
    arm64.storeBaseDispReg.word64 [x3 + 8], x0
    arm64.b __il_cont#6
  __il_cont#6:
    arm64.b __il_body#10
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x1, [x3 + 8]
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.cmp x0, 5
    arm64.cset x0, eq
    arm64.cbnz x0, converted
    arm64.b ifcont#4
  converted:
    arm64.cmp x1, 5
    arm64.cset x0, eq
    arm64.cbnz x0, preserved
    arm64.b ifcont#3
  preserved:
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  ifcont#3:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x0, 1
    arm64.epilogue 48
    arm64.ret
}
