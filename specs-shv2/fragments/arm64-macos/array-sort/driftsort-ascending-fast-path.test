  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, lt
    arm64.b ifcont#4
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#4:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, gt
    arm64.b ifcont#6
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#6:
    arm64.movImm x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

