    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  whilehdr:
    arm64.cmp x21, 25
    arm64.b.ge whileexit
  blocks:
    arm64.add x1, x20, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x1, x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x1, x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x1, x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x20, x20, 10
    arm64.add x21, x21, 1
    arm64.b whilehdr
  whileexit:
    arm64.bl Log.startCapture
    arm64.leaFuncAddr x1, __fnref_ascending
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Array_Integer
    arm64.movRegReg x0, x19
    arm64.bl Array.sort#Array.SortComparator
    arm64.bl Log.stopCapture
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __str_rec_21  ; "driftsort.logicalRun"
    arm64.movRegReg x0, x20
