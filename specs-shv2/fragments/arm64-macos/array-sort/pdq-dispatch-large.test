// Test: pdq-dispatch-large
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function ascending(x Integer, y Integer) returns Ordering
	return x.compare(y)
end 'ascending'

function main() returns ExitCode
	var a = IntArray.create()
	for v in [50, 40, 30, 20, 10, 45, 35, 25, 15, 5, 48, 38, 28, 18, 8, 46, 36, 26, 16, 6, 44, 34, 24, 14, 4, 42, 32, 22, 12, 2, 49, 39, 29, 19, 9, 47, 37, 27, 17, 7] 'fill'
		a.push(v)
	end 'fill'
	Log.startCapture()
	a.sortUnstable(ascending)
	let keys = Log.stopCapture()
	if Log.fired(keys, key: "pdq.partition") 'p'
		print("partition ")
	end 'p'
	if Log.fired(keys, key: "pdq.medianOf3") 'm3'
		print("medianOf3 ")
	end 'm3'
	if not Log.fired(keys, key: "pdq.heapsortFallback") 'nf'
		print("no-heap-fallback")
	end 'nf'
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @ascending {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.cmp x0, x1
    arm64.cset x2, lt
    arm64.cbnz x2, lt
    arm64.b ifcont#4
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#4:
    arm64.cmp x0, x1
    arm64.cset x0, gt
    arm64.cbnz x0, gt
    arm64.b ifcont#6
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#6:
    arm64.movImm x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movImm x0, 40
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x20 + 16], x0
    arm64.movImm x0, 8
    arm64.storeBaseDispReg.word64 [x20 + 24], x0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, fill
    arm64.b forexit
  fill:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.arm64AddLsl x0, x0, x21, lsl #3
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.bl Log.startCapture
    arm64.leaFuncAddr x1, __fnref_ascending
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Array_Integer
    arm64.movRegReg x0, x19
    arm64.bl Array.sortUnstable#Array.SortComparator
    arm64.bl Log.stopCapture
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __str_rec_14  ; "pdq.partition"
    arm64.movRegReg x0, x20
    arm64.bl Log.fired
    arm64.cbnz x0, p
    arm64.b ifcont#6
  p:
    arm64.leaRdata x0, __str_rec_15  ; "partition "
    arm64.bl print
    arm64.b ifcont#6
  ifcont#6:
    arm64.leaRdata x1, __str_rec_16  ; "pdq.medianOf3"
    arm64.movRegReg x0, x20
    arm64.bl Log.fired
    arm64.cbnz x0, m3
    arm64.b ifcont#8
  m3:
    arm64.leaRdata x0, __str_rec_17  ; "medianOf3 "
    arm64.bl print
    arm64.b ifcont#8
  ifcont#8:
    arm64.leaRdata x1, __str_rec_18  ; "pdq.heapsortFallback"
    arm64.movRegReg x0, x20
    arm64.bl Log.fired
    arm64.eor x0, x0, 1
    arm64.cbnz x0, nf
    arm64.b ifcont#10
  nf:
    arm64.leaRdata x0, __str_rec_19  ; "no-heap-fallback"
    arm64.bl print
    arm64.b ifcont#10
  ifcont#10:
    arm64.leaRdata x0, __str_rec_20  ; "\x0a"
    arm64.bl print
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
