// Test: a-struct-owning-a-set-instance-clones
typealias Integer = int(i64.min to i64.max)
typealias StringSet = Set with String

type Bucket
	export var members as StringSet
	export var tag as Integer

	export static function create(tag Integer) returns Self
		return Self{members: StringSet.create(), tag: tag}
	end 'create'
end 'Bucket'

function detached() returns Bucket
	var b = Bucket.create(5)
	b.members.insert("a string long enough to force a heap allocation")
	b.members.insert("a second string long enough to force a heap allocation")
	return b.clone()
	// b, its Set, its three columns and both Strings are freed when this function returns
end 'detached'

function main() returns ExitCode
	let c = detached()

	if c.members.count() != 2 'badCount'
		return 91
	end 'badCount'
	if not c.members.contains("a second string long enough to force a heap allocation") 'lostAMember'
		return 92
	end 'lostAMember'

	return c.tag
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bucket.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __layout_Set_String
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.leaRdata x2, __witness_String.Equatable
    arm64.bl Set.create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @detached {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl Bucket.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.leaRdata x0, __str_rec_2
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x0, x22, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 56
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x24, x22
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x22
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.leaRdata x2, __layout_Set_String
    arm64.leaRdata x3, __witness_String.Hashable
    arm64.leaRdata x4, __witness_String.Equatable
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.bl Set.insert
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.leaRdata x0, __str_rec_3
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x0, x22, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 56
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x24, x22
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x22
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.leaRdata x2, __layout_Set_String
    arm64.leaRdata x3, __witness_String.Hashable
    arm64.leaRdata x4, __witness_String.Equatable
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.bl Set.insert
    arm64.movRegReg x0, x19
    arm64.bl __clone_Bucket
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bucket
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl detached
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.leaRdata x2, __witness_String.Equatable
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 24]
    arm64.cmp x3, 0
    arm64.cset x4, lt
    arm64.cbnz x4, __il_slow
    arm64.b __rc_chk#11
  __rc_chk#11:
    arm64.movImm x4, 4611686018427387904
    arm64.cmp x3, x4
    arm64.cset x4, gt
    arm64.cbnz x4, __il_slow
    arm64.b __rc_ok#10
  __il_slow:
    arm64.bl Set.count
    arm64.b __il_cont
  __rc_ok#10:
    arm64.movRegReg x0, x3
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 2
    arm64.cset x0, ne
    arm64.cbnz x0, badCount
    arm64.b ifcont#2
  badCount:
    arm64.movImm x20, 91
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bucket
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.leaRdata x1, __str_rec_3
    arm64.leaRdata x2, __layout_Set_String
    arm64.leaRdata x3, __witness_String.Hashable
    arm64.leaRdata x4, __witness_String.Equatable
    arm64.bl Set.contains
    arm64.eor x0, x0, 1
    arm64.cbnz x0, lostAMember
    arm64.b ifcont#4
  lostAMember:
    arm64.movImm x20, 92
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bucket
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bucket
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk#7
  __rc_chk#7:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#5
  __rc_panic:
    arm64.leaRdata x0, __str_blob_21
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#5:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
