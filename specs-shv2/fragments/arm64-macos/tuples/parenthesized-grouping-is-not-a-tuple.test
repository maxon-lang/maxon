// Test: parenthesized-grouping-is-not-a-tuple
function main() returns ExitCode
	let x = (2 + 3) * 4
	return x + 22
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.add x0, x0, 3
    arm64.movImm x16, 4
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 22
    arm64.epilogue 16
    arm64.ret
}
