// Test: ranged-alias-elements-are-one-tuple-type
typealias Num = int(0 to 1000)

function f(t (Num, Num)) returns Num
	return t.0 + t.1
end 'f'

function g(t (Integer, Integer)) returns Integer
	return t.0 + t.1
end 'g'

function main() returns ExitCode
	let t = (10, 32)
	return f(t) - g(t)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @f {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranged-alias-elements-are-one-tuple-type.test:5: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 10
    arm64.movImm x20, 32
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __il_slow
    arm64.b __rc_chk#8
  __rc_chk#8:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __il_slow
    arm64.b __rc_ok#7
  __il_slow:
    arm64.movRegReg x0, x21
    arm64.bl f
    arm64.b __il_cont#5
  __rc_ok#7:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#10
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x21 + 8]
    arm64.add x1, x1, x2
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.sub x19, x0, x1
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk#3
  __rc_chk#3:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at ranged-alias-elements-are-one-tuple-type.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#1:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
