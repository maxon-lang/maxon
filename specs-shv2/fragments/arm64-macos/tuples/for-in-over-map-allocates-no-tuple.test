// Test: for-in-over-map-allocates-no-tuple
typealias Integer = int(i64.min to i64.max)
typealias IntMap = Map with (Integer, Integer)

function sum(m IntMap) returns Integer
	var total = 0
	for (_, v) in m 'loop'
		total = total + v
	end 'loop'
	return total
end 'sum'

function main() returns ExitCode
	let m = [1: 10, 2: 20, 3: 30]
	return sum(m)
end 'main'
---
ExitCode: 60
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
  __ds_base@32 = i64 0
  __ds_buf_size@40 = i64 0
  __ds_buf_mask@48 = i64 0
  __ds_start_ts@56 = i64 0
  __ds_lock@64 = i64 0
  __mm_alloc_id@72 = i64 0
}

func @sum {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Map.createIterator
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.b.ne forempty
  forhdr:
    arm64.cmp x0, 0
    arm64.b.ne forexit
  loop:
    arm64.leaRdata x1, __layout_MapIterator_Integer_Integer
    arm64.leaRdata x2, __witness_int.Hashable
    arm64.leaRdata x3, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl MapIterator.current
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.add x19, x19, x1
    arm64.bl __mm_decref
  forstep:
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.movRegReg x0, x20
    arm64.bl MapIterator.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_MapIterator_Integer_Integer
    arm64.movRegReg x0, x19
    arm64.b forjoin
  forempty:
    arm64.movRegReg x0, x19
  forjoin:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 10
    arm64.leaRdata x0, __layout_Map_int_int
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Map.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl Map.upsert
    arm64.movImm x1, 2
    arm64.movImm x2, 20
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Map.upsert
    arm64.movImm x1, 3
    arm64.movImm x2, 30
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Map.upsert
    arm64.movRegReg x0, x21
    arm64.bl sum
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_21  ; "panic at for-in-over-map-allocates-no-tuple.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Map_int_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
