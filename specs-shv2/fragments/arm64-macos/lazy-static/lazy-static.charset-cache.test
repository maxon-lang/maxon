// Test: lazy-static.charset-cache
type WSCache
	static var ws = CharacterSet.whitespacesAndNewlines()

	export static function isWhitespace(c Character) returns bool
		return WSCache.ws.contains(c)
	end 'isWhitespace'
end 'WSCache'

function main() returns ExitCode
	if WSCache.isWhitespace(' ') 'c1'
		print("space ")
	end 'c1'
	if WSCache.isWhitespace('a') 'c2'
		print("FAIL")
	end 'c2'
	if WSCache.isWhitespace('\t') 'c3'
		print("tab")
	end 'c3'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_WSCache.ws@0 = i64 0
  __data_CharacterSet.cachedWhitespacesAndNewlines@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @WSCache.isWhitespace {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl __lazy_init#__data_WSCache.ws
    arm64.leaGlobal x0, __data_WSCache.ws
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.movRegReg x0, x20
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl CharacterSet.contains
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_CharacterSet
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_12
    arm64.bl WSCache.isWhitespace
    arm64.cbnz x0, c1
    arm64.b ifcont#2
  c1:
    arm64.leaRdata x0, __str_rec_13
    arm64.bl print
    arm64.b ifcont#2
  ifcont#2:
    arm64.leaRdata x0, __str_rec_14
    arm64.bl WSCache.isWhitespace
    arm64.cbnz x0, c2
    arm64.b ifcont#4
  c2:
    arm64.leaRdata x0, __str_rec_15
    arm64.bl print
    arm64.b ifcont#4
  ifcont#4:
    arm64.leaRdata x0, __str_rec_16
    arm64.bl WSCache.isWhitespace
    arm64.cbnz x0, c3
    arm64.b ifcont#6
  c3:
    arm64.leaRdata x0, __str_rec_17
    arm64.bl print
    arm64.b ifcont#6
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
