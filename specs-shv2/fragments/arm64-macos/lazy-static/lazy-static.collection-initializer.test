    arm64.leaGlobal x0, __data_Vowels.vowelSet
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x2, __layout_Set_Character
    arm64.leaRdata x3, __witness_Character.Hashable
    arm64.leaRdata x4, __witness_Character.Equatable
    arm64.movRegReg x1, x19
    arm64.bl Set.contains
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

