    arm64.storeSlotReg slot0, x19
    arm64.bl Holder.get
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 1
    arm64.cset x2, ls
    arm64.cbnz x2, __im_slow
    arm64.b __im_load
  __im_load:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 8
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.cset x4, ne
    arm64.cbnz x4, __im_empty
    arm64.b critsplit#8
  __im_empty:
    arm64.cmp x2, 0
    arm64.cset x4, eq
    arm64.cbnz x4, __im_slow
    arm64.b critsplit#9
  __im_slow:
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#9:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  critsplit#8:
    arm64.movRegReg x0, x2
    arm64.movRegReg x9, x3
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __uint_to_string
    arm64.movRegReg x20, x0
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 56
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x20
