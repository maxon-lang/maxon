// Test: lazy-static.struct-literal-array-field
typealias Count = int(0 to u64.max)
typealias CountArray = Array with Count

type Holder
	export var xs as CountArray

	static var seeded = Holder{xs: [1, 2, 3]}

	export static function get() returns Holder
		return Holder.seeded
	end 'get'
end 'Holder'

function main() returns ExitCode
	let h = Holder.get()
	print("{try h.xs.get(1) otherwise 0}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Holder.seeded@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Holder.get {
  entry:
    arm64.prologue 16
    arm64.bl __lazy_init#__data_Holder.seeded
    arm64.leaGlobal x0, __data_Holder.seeded
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
