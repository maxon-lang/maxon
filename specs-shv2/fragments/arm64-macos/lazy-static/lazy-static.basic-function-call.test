// Test: lazy-static.basic-function-call
typealias Count = int(0 to u64.max)

type Config
	static var value = Config.makeValue()
	export var n as Count

	static function makeValue() returns Config
		return Config{n: 42}
	end 'makeValue'

	export static function getValue() returns Config
		return Config.value
	end 'getValue'
end 'Config'

function main() returns ExitCode
	let c = Config.getValue()
	return c.n
end 'main'
---
ExitCode: 42
---
data {
  __data_Config.value@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Config.makeValue {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 42
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Config.getValue {
  entry:
    arm64.prologue 16
    arm64.bl __lazy_init#__data_Config.value
    arm64.leaGlobal x0, __data_Config.value
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Config.getValue
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
