    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.bl __lazy_init#__data_Pair.origin
    arm64.leaGlobal x0, __data_Pair.origin
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_decref
    arm64.bl __lazy_init#__data_Pair.origin
    arm64.leaGlobal x0, __data_Pair.origin
    arm64.storeBaseDispReg.word64 [x0 + 0], x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Pair.get {
  entry:
    arm64.prologue 16
    arm64.bl __lazy_init#__data_Pair.origin
    arm64.leaGlobal x0, __data_Pair.origin
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

