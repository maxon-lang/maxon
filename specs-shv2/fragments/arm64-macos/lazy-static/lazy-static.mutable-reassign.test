// Test: lazy-static.mutable-reassign
typealias Count = int(0 to u64.max)

type State
	static var current = State.makeDefault()
	export var value as Count

	static function makeDefault() returns State
		return State{value: 0}
	end 'makeDefault'

	export static function get() returns State
		return State.current
	end 'get'

	export static function set(s State)
		State.current = s
	end 'set'

	static function create(value Count) returns Self
		return Self{value: value}
	end 'create'
end 'State'

function main() returns ExitCode
	let a = State.get()
	print("{a.value} ")
	State.set(State.create(99))
	let b = State.get()
	print("{b.value}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_State.current@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @State.makeDefault {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @State.get {
  entry:
    arm64.prologue 16
    arm64.bl __lazy_init#__data_State.current
    arm64.leaGlobal x0, __data_State.current
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @State.set {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.bl __lazy_init#__data_State.current
    arm64.leaGlobal x0, __data_State.current
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_decref
    arm64.bl __lazy_init#__data_State.current
    arm64.leaGlobal x0, __data_State.current
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @State.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

