// Test: nested-div-both-sides
function main() returns ExitCode
	let a = 1000
	let b = 7
	let c = 60
	let d = 4
	let q1 = a / b
	let q2 = c / d
	let r = q1 / q2
	if r == 9 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1000
    arm64.movImm x1, 7
    arm64.movImm x2, 60
    arm64.movImm x3, 4
    arm64.sdiv x0, x0, x1
    arm64.sdiv x1, x2, x3
    arm64.sdiv x0, x0, x1
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
