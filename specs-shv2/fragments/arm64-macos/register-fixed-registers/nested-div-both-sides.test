// Test: nested-div-both-sides
function main() returns ExitCode
	let a = 1000
	let b = 7
	let c = 60
	let d = 4
	let q1 = a / b
	let q2 = c / d
	let r = q1 / q2
	if r == 9 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1000
    arm64.movImm x1, 60
    arm64.movImm x2, 5270498306774157605
    arm64.smulh x0, x2, x0
    arm64.asr x0, x0, 1
    arm64.lsr x2, x0, 63
    arm64.add x0, x0, x2
    arm64.asr x1, x1, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 60
    arm64.asr x1, x1, 2
    arm64.sdiv x0, x0, x1
    arm64.cmp x0, 9
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
