// Test: six-div-results-into-six-arg-slots
function digits6(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) returns int
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function main() returns ExitCode
	var n1 = 100
	var n2 = 45
	var n3 = 23
	var d1 = 12
	var d2 = 7
	var d3 = 9
	let r = digits6(n1 / d1, p2: n1 mod d1, p3: n2 / d2, p4: n2 mod d2, p5: n3 / d3, p6: n3 mod d3)
	if r == 846325 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @digits6 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.movRegReg x7, x4
    arm64.movRegReg x8, x5
    arm64.movImm x16, 100000
    arm64.mul x0, x0, x16
    arm64.movImm x16, 10000
    arm64.mul x1, x1, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 1000
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 100
    arm64.mul x1, x6, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 10
    arm64.mul x1, x7, x16
    arm64.add x0, x0, x1
    arm64.add x0, x0, x8
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 45
    arm64.movImm x2, 23
    arm64.movImm x6, 12
    arm64.movImm x7, 7
    arm64.movImm x8, 9
    arm64.sdiv x9, x0, x6
    arm64.sdiv x16, x0, x6
    arm64.msub x6, x16, x6, x0
    arm64.sdiv x10, x1, x7
    arm64.sdiv x16, x1, x7
    arm64.msub x7, x16, x7, x1
    arm64.sdiv x11, x2, x8
    arm64.sdiv x16, x2, x8
    arm64.msub x8, x16, x8, x2
    arm64.movRegReg x0, x9
    arm64.movRegReg x1, x6
    arm64.movRegReg x2, x10
    arm64.movRegReg x3, x7
    arm64.movRegReg x4, x11
    arm64.movRegReg x5, x8
    arm64.bl digits6
    arm64.cmp x0, 846325
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
