// Test: idiv-under-loop-pressure
typealias Positive = int(1 to i64.max)

function press(p int) returns int
	let k1 = p + 11
	let k2 = p + 12
	let k3 = p + 13
	let k4 = p + 14
	let k5 = p + 15
	let k6 = p + 16
	let k7 = p + 17
	let k8 = p + 18
	let k9 = p + 19
	var sum = 0
	var i = 1
	while i <= 5 'loop'
		var t = k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9
		sum = sum + t / (i as Positive)
		i = i + 1
	end 'loop'
	return sum
end 'press'

function main() returns ExitCode
	let r = press(0)
	if r == 307 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @press {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x1, x0, 11
    arm64.add x2, x0, 12
    arm64.add x6, x0, 13
    arm64.add x7, x0, 14
    arm64.add x8, x0, 15
    arm64.add x9, x0, 16
    arm64.add x10, x0, 17
    arm64.add x11, x0, 18
    arm64.add x0, x0, 19
    arm64.movImm x19, 0
    arm64.movImm x20, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 5
    arm64.cset x21, le
    arm64.cbnz x21, loop
    arm64.b whileexit
  loop:
    arm64.add x21, x1, x2
    arm64.add x21, x21, x6
    arm64.add x21, x21, x7
    arm64.add x21, x21, x8
    arm64.add x21, x21, x9
    arm64.add x21, x21, x10
    arm64.add x21, x21, x11
    arm64.add x21, x21, x0
    arm64.cmp x20, 1
    arm64.cset x3, lt
    arm64.cbnz x3, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.add x3, x20, 0
    arm64.sdiv x21, x21, x3
    arm64.add x19, x19, x21
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl press
    arm64.cmp x0, 307
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
