// Test: nested-div-as-divisor
function main() returns ExitCode
	let a = 1000
	let b = 84
	let c = 4
	let inner = b / c
	let r = a / inner
	if r == 47 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1000
    arm64.movImm x1, 84
    arm64.asr x1, x1, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 84
    arm64.asr x1, x1, 2
    arm64.sdiv x0, x0, x1
    arm64.cmp x0, 47
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
