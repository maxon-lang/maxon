// Test: if-statements.nested-if-with-scoped-string

typealias Integer = int(i64.min to i64.max)

function test(x Integer) returns Integer
	if x == 0 'outer'
		let inner = "hello"
		if inner == "hello" 'checkInner'
			return 1
		end 'checkInner'
	end 'outer'
	return 42
end 'test'

function main() returns ExitCode
	return test(5)
end 'main'
---
ExitCode: 42
---
func @test {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, outer
    arm64.b ifcont#4
  outer:
    arm64.leaRdata x0, __str_rec_1
    arm64.leaRdata x1, __str_rec_1
    arm64.bl __str_eq
    arm64.cbnz x0, checkInner
    arm64.b ifcont#3
  checkInner:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#3:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl test
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
