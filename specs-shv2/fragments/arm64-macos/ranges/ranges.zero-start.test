// Test: ranges.zero-start
function main() returns ExitCode
		var sum = 0
		for i in 0 to 3 'loop'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 3
    arm64.cset x2, le
    arm64.cbnz x2, loop
    arm64.b forexit
  loop:
    arm64.add x0, x0, x1
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.epilogue 16
    arm64.ret
}
