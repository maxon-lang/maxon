// Test: ranges.ranged-alias-parameter-bound-stays-legal
typealias Row = int(0 to 63)

function sumTo(lastRow Row) returns Row
	var total = 0 as Row
	for r in 0 to lastRow 'l'
		total = total + r
	end 'l'
	return total
end 'sumTo'

function main() returns ExitCode
	var chars = 0
	for c in 'a' to 'e' 'k'
		chars = chars + 1
	end 'k'
	return (sumTo(5) + chars) as ExitCode
end 'main'
---
ExitCode: 20
---
func @sumTo {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 63
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movImm x1, 0
    arm64.movImm x2, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x2, x0
    arm64.cset x6, le
    arm64.cbnz x6, l
    arm64.b forexit
  l:
    arm64.add x1, x1, x2
    arm64.b forstep
  forstep:
    arm64.add x2, x2, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 63
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 97
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, 101
    arm64.cset x1, le
    arm64.cbnz x1, k
    arm64.b forexit
  k:
    arm64.add x19, x19, 1
    arm64.b forstep
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  forexit:
    arm64.movImm x0, 5
    arm64.bl sumTo
    arm64.add x0, x0, x19
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
