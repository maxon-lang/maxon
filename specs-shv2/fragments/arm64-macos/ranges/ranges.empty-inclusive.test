// Test: ranges.empty-inclusive
function main() returns ExitCode
		var count = 0
		for _ in 5 to 3 'loop'
				count = count + 1
		end 'loop'
		return count
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 5
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 3
    arm64.cset x2, le
    arm64.cbnz x2, loop
    arm64.b forexit
  loop:
    arm64.add x0, x0, 1
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranges.empty-inclusive.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
