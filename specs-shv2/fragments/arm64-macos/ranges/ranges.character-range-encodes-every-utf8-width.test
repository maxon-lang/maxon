// Test: ranges.character-range-encodes-every-utf8-width

function main() returns ExitCode
	var two = ""
	for c in 'à' to 'å' 'twoByte'
		two.append("{c}")
	end 'twoByte'

	var three = ""
	for c in '一' to '五' 'threeByte'
		three.append("{c}")
	end 'threeByte'

	var four = ""
	for c in '😀' to '😃' 'fourByte'
		four.append("{c}")
	end 'fourByte'

	print("two={two}\nthree={three}\nfour={four}\n")
	return 0
end 'main'
