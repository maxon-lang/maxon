// Test: ranges.inclusive-create-iterator
function main() returns ExitCode
		let it = try (1 to 4).createIterator() otherwise return 99
		var sum = 0
		for v in it 'loop'
				sum = sum + v
		end 'loop'
		return sum
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 4
    arm64.bl Range.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Range.createIterator
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movImm x19, 0
    arm64.movImm x0, 0
  forhdr:
    arm64.cmp x0, 0
    arm64.b.ne forexit
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 16]
  __il_cont:
    arm64.add x19, x19, x0
  forstep:
    arm64.movRegReg x0, x20
    arm64.bl RangeIterator.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranges.inclusive-create-iterator.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
