// Test: unary-negate-expression
function main() returns ExitCode
	let x = 10
	let y = 5
	let z = -(x + y)
	return 57 + z
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.add x0, x0, 5
    arm64.neg x0, x0
    arm64.add x0, x0, 57
    arm64.epilogue 16
    arm64.ret
}
