// Test: enum-exhaustive.float-backed-range
enum Threshold
		low = 0.1
		medium = 0.5
		high = 0.9
end 'Threshold'

function main() returns ExitCode
	let t = Threshold.medium
	match t 'check'
		low to high then return 1
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4602678819172646912
    arm64.movImm x1, 4591870180066957722
    arm64.cmp x0, x1
    arm64.cset x1, ge
    arm64.movImm x2, 4606281698874543309
    arm64.cmp x0, x2
    arm64.cset x0, le
    arm64.and x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}
