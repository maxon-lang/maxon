// Test: enum-exhaustive.mix-explicit-and-range
enum Priority
		low
		medium
		high
		critical
end 'Priority'

function main() returns ExitCode
	let p = Priority.low
	match p 'check'
		low then return 1
		medium to critical then return 2
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x1, ge
    arm64.cmp x0, 3
    arm64.cset x0, le
    arm64.and x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchnext:
  matchcont:
}
