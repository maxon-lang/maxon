// Test: directives.top-level-nested
#if testing(false)
	#if testing(true)
		function pick() returns ExitCode
			return 98
		end 'pick'
	#else
		function pick() returns ExitCode
			return 22
		end 'pick'
	#endif
#else
	function pick() returns ExitCode
		return 97
	end 'pick'
#endif

function main() returns ExitCode
	return pick()
end 'main'
---
ExitCode: 22
---
func @pick {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 22
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl pick
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
