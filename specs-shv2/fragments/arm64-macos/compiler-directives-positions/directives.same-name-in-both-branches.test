// Test: directives.same-name-in-both-branches
#if testing(false)
	let marker = 31
#else
	let marker = 91
#endif

function main() returns ExitCode
	return marker
end 'main'
---
ExitCode: 31
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 31
    arm64.epilogue 16
    arm64.ret
}
