// Test: boxed-union-field-throw-out-of-a-sole-owned-literal
typealias N = int(0 to i64.max)

union OuterErr implements Error
	unterminatedString(line N, column N)
	unexpectedEof(line N, column N)
end 'OuterErr'

type Holder
	export var pending as OuterErr

	static function boom() returns N throws OuterErr
		let h = Self{pending: OuterErr.unexpectedEof(3, column: 4)}
		throw h.pending
	end 'boom'
end 'Holder'

function main() returns ExitCode
	let v = try Holder.boom() otherwise (e) 'fail'
		match e 'kind'
			unterminatedString(line, column) then return (line + column)
			unexpectedEof(line, column) then return (line + column + 100)
		end 'kind'
	end 'fail'
	return (v + 200)
end 'main'
---
ExitCode: 107
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.boom {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
    arm64.movImm x20, 4
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x19
    arm64.storeBaseDispReg.word64 [x21 + 16], x20
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x21
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.bl __destruct_Holder
    arm64.movImm x0, 0
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Holder.boom
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#3
    arm64.b matchnext
  matcharm#3:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x9 + 16]
    arm64.add x19, x0, x1
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#9
    arm64.b __rc_chk#10
  __rc_chk#10:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#9
    arm64.b __rc_ok#8
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#8:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#4
    arm64.b matchdead
  matcharm#4:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x9 + 16]
    arm64.add x0, x0, x1
    arm64.add x19, x0, 100
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#12
    arm64.b __rc_chk#13
  __rc_chk#13:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#12
    arm64.b __rc_ok#11
  __rc_panic#12:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#11:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
  tryok:
    arm64.add x0, x0, 200
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#15
    arm64.b __rc_chk#16
  __rc_chk#16:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#15
    arm64.b __rc_ok#14
  __rc_panic#15:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#14:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchcont:
}
