// Test: float-promotion
function main() returns ExitCode
	let x = 5
	let y = 2.0
	let result = x + y
	return trunc(result)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.scvtf d1, x0
    arm64.fadd d0, d1, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
