// Test: float-alias-struct-field

typealias Weight = float(f64.min to f64.max)

type Particle
	export var mass as Weight
	export var velocity as Weight

	export static function make(mass Weight, velocity Weight) returns Self
		return Self{mass: mass, velocity: velocity}
	end 'make'

	export function momentum() returns Weight
		return self.mass * self.velocity
	end 'momentum'
end 'Particle'

function main() returns ExitCode
	var p = Particle.make(2.5, velocity: 4.0)
	p.velocity = 6.0
	return trunc(p.momentum())
end 'main'
---
ExitCode: 15
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Particle.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, d9
    arm64.storeSlotReg slot0, d8
    arm64.movRegReg d8, d0
    arm64.movRegReg d9, d1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], d8
    arm64.storeBaseDispReg.word64 [x0 + 8], d9
    arm64.loadRegSlot d8, slot0
    arm64.loadRegSlot d9, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Particle.momentum {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 d1, [x0 + 8]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.bl Particle.make
    arm64.movRegReg x19, x0
    arm64.fpLoadRdata d0, [rdata + __fconst_3]
    arm64.storeBaseDispReg.word64 [x19 + 8], d0
    arm64.movRegReg x0, x19
    arm64.bl Particle.momentum
    arm64.fcvtzs x20, d0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
