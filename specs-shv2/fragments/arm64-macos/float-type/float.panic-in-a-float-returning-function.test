// Test: float.panic-in-a-float-returning-function
function scaled(x float) returns float
	if x < 0.0 'negative'
		panic("scaled: negative input")
	end 'negative'
	return x * 2.0
end 'scaled'

function main() returns ExitCode
	return trunc(scaled(21.0))
end 'main'
---
ExitCode: 42
---
func @scaled {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fcmp d0, d1
    arm64.cset x0, mi
    arm64.cbnz x0, negative
    arm64.b ifcont
  negative:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_3]
    arm64.bl scaled
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
