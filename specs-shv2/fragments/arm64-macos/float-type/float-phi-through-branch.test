// Test: float-phi-through-branch
function work(a int) returns int
	var f = a + 0.0
	if a > 5 'gt'
		f = f + 1.5
	end 'gt'
	return trunc(f)
end 'work'

function main() returns ExitCode
	return work(19)
end 'main'
---
ExitCode: 20
---
func @work {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.scvtf d1, x0
    arm64.fadd d0, d1, d0
    arm64.cmp x0, 5
    arm64.cset x0, gt
    arm64.cbnz x0, gt
    arm64.b critsplit
  gt:
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fadd d0, d0, d1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 19
    arm64.bl work
    arm64.epilogue 16
    arm64.ret
}
