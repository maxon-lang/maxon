// Test: trunc-division-optimizes
function main() returns ExitCode
	return 20 / 3             // int/int = truncating int, returns 6
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 3
    arm64.sdiv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}
