// Test: complex-expression
function main() returns ExitCode
	let a = 10
	let b = 3
	let result = (a + b) * 2 - a / b
	return result
end 'main'
---
ExitCode: 23
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 3
    arm64.add x2, x0, 3
    arm64.movImm x16, 2
    arm64.mul x2, x2, x16
    arm64.sdiv x0, x0, x1
    arm64.sub x0, x2, x0
    arm64.epilogue 16
    arm64.ret
}
