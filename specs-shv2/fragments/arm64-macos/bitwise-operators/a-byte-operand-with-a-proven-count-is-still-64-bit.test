// Test: a-byte-operand-with-a-proven-count-is-still-64-bit
typealias Num = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias Bits = int(0 to 63)

function shlLowByte(n Bits) returns Num
	let b = 200 as Byte
	return b shl n
end 'shlLowByte'

function shlTopByte(n Bits) returns Num
	let b = 255 as Byte
	return b shl n
end 'shlTopByte'

function shrLowByte(n Bits) returns Num
	let b = 200 as Byte
	return b shr n
end 'shrLowByte'

function bits(step Num) returns Bits
	return step as Bits
end 'bits'

function main() returns ExitCode
	if shlLowByte(bits(10)) != 204800 'tenBits'
		return 1
	end 'tenBits'
	if shlTopByte(bits(56)) != -72057594037927936 'topByte'
		return 2
	end 'topByte'
	if shrLowByte(bits(3)) != 25 'shrByte'
		return 3
	end 'shrByte'

	return 42
end 'main'
---
ExitCode: 42
---
func @shlLowByte {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 63
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-byte-operand-with-a-proven-count-is-still-64-bit.test:6: Range check failed: value outside typealias 'Bits'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movImm x1, 200
    arm64.lslv x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @shlTopByte {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 63
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-byte-operand-with-a-proven-count-is-still-64-bit.test:11: Range check failed: value outside typealias 'Bits'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movImm x1, 255
    arm64.lslv x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @shrLowByte {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 63
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-byte-operand-with-a-proven-count-is-still-64-bit.test:16: Range check failed: value outside typealias 'Bits'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movImm x1, 200
    arm64.lsrv x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
  __rc_ok#10:
    arm64.movImm x0, 10
  __il_body#13:
    arm64.cmp x0, 0
    arm64.b.lt __il_slow#16
  __rc_chk#15:
    arm64.cmp x0, 63
    arm64.b.le __rc_ok#14
  __il_slow#16:
    arm64.bl shlLowByte
    arm64.b __il_cont#7
  __rc_ok#14:
    arm64.movImm x1, 200
    arm64.lslv x0, x1, x0
  __il_cont#7:
    arm64.cmp x0, 204800
    arm64.b.eq __rc_ok#20
  tenBits:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  __rc_ok#20:
