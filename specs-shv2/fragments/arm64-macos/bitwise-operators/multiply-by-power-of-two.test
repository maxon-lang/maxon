// Test: multiply-by-power-of-two
function main() returns ExitCode
	// Multiply by 8 using shift
	let value = 13
	return value shl 3    // 104
end 'main'
---
ExitCode: 104
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 104
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
