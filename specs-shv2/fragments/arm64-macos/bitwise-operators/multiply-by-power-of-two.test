// Test: multiply-by-power-of-two
function main() returns ExitCode
	// Multiply by 8 using shift
	let value = 13
	return value shl 3    // 104
end 'main'
---
ExitCode: 104
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 13
    arm64.lsl x0, x0, 3
    arm64.epilogue 16
    arm64.ret
}
