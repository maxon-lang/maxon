// Test: shift-signedness-follows-the-cast-in-both-directions
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function sourceKeepsItsOwnType(p Num) returns Num
	let w = p as Wide
	return (w shr 60) - (p shr 60)
end 'sourceKeepsItsOwnType'

function castToSigned(v Wide) returns Num
	let n = v as Num
	return n shr 60
end 'castToSigned'

function main() returns ExitCode
	if sourceKeepsItsOwnType(u64.max) != 16 'sourceKeeps'
		return 1
	end 'sourceKeeps'
	if castToSigned(u64.max) != 0 - 1 'toSigned'
		return 2
	end 'toSigned'
	return 42
end 'main'
---
ExitCode: 42
---
func @sourceKeepsItsOwnType {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 0
    arm64.lsr x1, x1, 60
    arm64.asr x0, x0, 60
    arm64.sub x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @castToSigned {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 0
    arm64.asr x0, x0, 60
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, -1
    arm64.bl sourceKeepsItsOwnType
    arm64.cmp x0, 16
    arm64.cset x0, ne
    arm64.cbnz x0, sourceKeeps
    arm64.b ifcont
  sourceKeeps:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, -1
    arm64.bl castToSigned
    arm64.movImm x1, 0
    arm64.sub x1, x1, 1
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, toSigned
    arm64.b ifcont
  toSigned:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
