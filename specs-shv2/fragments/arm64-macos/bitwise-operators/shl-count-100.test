// Test: shl-count-100
function main() returns ExitCode
	let a = 1
	let SHIFT = 100
	if a shl SHIFT != 0 'namedWrong'
		return 1
	end 'namedWrong'
	if a shl 100 != 0 'literalWrong'
		return 2
	end 'literalWrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b ifcont#2
  ifcont#2:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
