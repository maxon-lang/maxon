// Test: bitwise-xor-precedence
function main() returns ExitCode
	// and has higher precedence than xor
	// 12 and 10 = 8, then 8 xor 3 = 11
	return 12 and 10 xor 3
end 'main'
---
ExitCode: 11
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 12
    arm64.movImm x16, 10
    arm64.and x0, x0, x16
    arm64.eor x0, x0, 3
    arm64.epilogue 16
    arm64.ret
}
