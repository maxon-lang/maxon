// Test: bitwise-and
function main() returns ExitCode
	let a = 12
	let b = 10
	return a and b
end 'main'
---
ExitCode: 8
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 12
    arm64.movImm x16, 10
    arm64.and x0, x0, x16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
