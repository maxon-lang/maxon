    arm64.cbnz x2, __rc_panic#5
    arm64.b __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.lslv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

