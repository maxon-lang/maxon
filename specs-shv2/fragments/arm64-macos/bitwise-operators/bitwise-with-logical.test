// Test: bitwise-with-logical
function main() returns ExitCode
	let a = 5 and 3        // 1
	if a > 0 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b check
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
