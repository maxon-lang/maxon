// Test: bitwise-not-masking
function main() returns ExitCode
	let value = 125    // 0x7D
	// Clear lower 4 bits: 125 and not 15 = 112
	return value and not 15
end 'main'
---
ExitCode: 112
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 15
    arm64.mvn x0, x0
    arm64.movImm x16, 125
    arm64.and x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}
