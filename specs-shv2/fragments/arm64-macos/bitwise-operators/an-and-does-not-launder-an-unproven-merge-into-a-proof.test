// Test: an-and-does-not-launder-an-unproven-merge-into-a-proof
typealias Num = int(i64.min to i64.max)
typealias Bits = int(0 to 63)

function main() returns ExitCode
	var n = 1 as Bits
	var i = 0 as Num
	while i < 7 'step'
		n = n + 10
		i = i + 1
	end 'step'

	// The premise, asserted before it is spent: the merge really does hold a value its alias cannot.
	if n != 71 'reached'
		return 1
	end 'reached'

	let m = n and 127
	if m != 71 'laundered'
		return 2
	end 'laundered'

	if 1 shl m != 0 'shl'
		return 3
	end 'shl'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
  whilehdr:
    arm64.cmp x1, 7
    arm64.b.ge whileexit
  step:
    arm64.add x0, x0, 10
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 71
    arm64.b.eq ifcont#5
  reached:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#5:
    arm64.and x0, x0, 127
    arm64.cmp x0, 71
    arm64.b.eq ifcont#7
  laundered:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#7:
    arm64.movImm x1, 1
    arm64.and x2, x0, -64
    arm64.neg x3, x2
    arm64.orr x2, x2, x3
    arm64.asr x2, x2, 63
    arm64.lslv x0, x1, x0
    arm64.mvn x1, x2
    arm64.and x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.eq ifcont#9
  shl:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#9:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
