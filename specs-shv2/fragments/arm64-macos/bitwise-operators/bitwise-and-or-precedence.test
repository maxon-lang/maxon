// Test: bitwise-and-or-precedence
function main() returns ExitCode
	// and has higher precedence than or
	// 12 and 10 = 8, then 8 or 1 = 9
	return 12 and 10 or 1
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
