  __rc_chk:
    arm64.cmp x1, 64
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.and x2, x1, -64
    arm64.neg x3, x2
    arm64.orr x2, x2, x3
    arm64.asr x2, x2, 63
    arm64.orr x1, x1, x2
    arm64.asrv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

