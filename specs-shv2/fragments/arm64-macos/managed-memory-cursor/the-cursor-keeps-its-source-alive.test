// Test: the-cursor-keeps-its-source-alive
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function makeBuffer() returns ByteArray
	var arr = ByteArray.create()
	arr.push(4)
	arr.push(9)
	return arr
end 'makeBuffer'

function main() returns ExitCode
	let cursor = try makeBuffer().managed.createCursor() otherwise return 99
	var churn = 0
	for _ in 0 upto 500 'churn'
		var scratch = ByteArray.create()
		scratch.push(200)
		churn = churn + scratch.count()
	end 'churn'
	return cursor.current() + (try cursor.peek(1) otherwise 0)
end 'main'
---
ExitCode: 13
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeBuffer {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 9
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl makeBuffer
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_cursor_create
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movImm x19, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x21, 500
    arm64.cset x0, lt
    arm64.cbnz x0, churn
    arm64.b forexit
  churn:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x22, x0
    arm64.movImm x1, 200
    arm64.movRegReg x0, x22
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x22 + 8]
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x22
    arm64.bl __managed_decref
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_current
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_peek
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#8
    arm64.b tryok#7
  tryerr#8:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok#7:
    arm64.b trycont
  trycont:
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
