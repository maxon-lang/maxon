// Test: advancing-past-the-last-element-throws-and-does-not-move
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	var arr = ByteArray.create()
	arr.push(10)
	arr.push(20)
	var cursor = try arr.managed.createCursor() otherwise return 99
	try cursor.advance() otherwise return 98
	try cursor.advance() otherwise 'atEnd'
		return cursor.index() + cursor.current()
	end 'atEnd'
	return 0
end 'main'
---
ExitCode: 21
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 10
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl __managed_cursor_create
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_advance
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movImm x21, 98
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_advance
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#6
    arm64.b tryok#5
  tryerr#6:
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_index
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_current
    arm64.add x21, x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_cursor_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at advancing-past-the-last-element-throws-and-does-not-move.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
