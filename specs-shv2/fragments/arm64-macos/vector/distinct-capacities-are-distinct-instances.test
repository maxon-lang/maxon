// Test: distinct-capacities-are-distinct-instances
typealias Int = int(i64.min to i64.max)

type Holder4 uses Element
	typealias Slot4 = Vector with 4 Element

	var quad as Slot4

	export static function create() returns Self
		return Self{quad: Slot4.create()}
	end 'create'

	export function size() returns Int
		return quad.count()
	end 'size'
end 'Holder4'

type Holder7 uses Element
	typealias Slot7 = Vector with 7 Element

	var septet as Slot7

	export static function create() returns Self
		return Self{septet: Slot7.create()}
	end 'create'

	export function size() returns Int
		return septet.count()
	end 'size'
end 'Holder7'

typealias IntHolder4 = Holder4 with Int
typealias IntHolder7 = Holder7 with Int

function main() returns ExitCode
	var a = IntHolder4.create()
	var b = IntHolder7.create()
	return a.size() * 10 + b.size()
end 'main'
---
ExitCode: 47
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder4.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 4
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Holder4.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x0, 4
    arm64.b __il_body
  __il_body:
    arm64.b __rc_ok
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @Holder7.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x1, 7
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Holder7.size {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x0, 7
    arm64.b __il_body
  __il_body:
    arm64.b __rc_ok
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Holder4_Int
    arm64.bl Holder4.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __layout_Holder7_Int
    arm64.bl Holder7.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl Holder4.size
    arm64.movImm x16, 10
    arm64.mul x21, x0, x16
    arm64.movRegReg x0, x20
    arm64.bl Holder7.size
    arm64.add x21, x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Holder7_Int
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder4_Int
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
