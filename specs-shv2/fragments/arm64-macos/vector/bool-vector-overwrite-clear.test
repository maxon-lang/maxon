// Test: bool-vector-overwrite-clear
typealias Bits8 = Vector with 8 bool

function main() returns ExitCode
	var v = Bits8.create()
	try v.set(2, value: true) otherwise panic("test invariant: set OOB")
	try v.set(5, value: true) otherwise panic("test invariant: set OOB")
	try v.set(2, value: false) otherwise panic("test invariant: set OOB")
	let a = try v.get(2) otherwise true
	let b = try v.get(5) otherwise false
	var r = 0
	if not a 'cleared'
		r = r + 1
	end 'cleared'
	if b 'stillSet'
		r = r + 10
	end 'stillSet'
	return r
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N8_bool
    arm64.movImm x1, 8
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 2
    arm64.movImm x2, 1
    arm64.leaRdata x3, __layout_Vector_N8_bool
    arm64.movImm x4, 8
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at bool-vector-overwrite-clear.test:6: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movImm x1, 5
    arm64.movImm x2, 1
    arm64.leaRdata x3, __layout_Vector_N8_bool
    arm64.movImm x4, 8
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at bool-vector-overwrite-clear.test:7: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#3:
    arm64.movImm x1, 2
    arm64.movImm x2, 0
    arm64.leaRdata x3, __layout_Vector_N8_bool
    arm64.movImm x4, 8
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.eq tryok#5
  tryerr#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at bool-vector-overwrite-clear.test:8: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#5:
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_Vector_N8_bool
    arm64.movRegReg x0, x19
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq tryok#7
  tryerr#8:
    arm64.movImm x20, 1
    arm64.b trycont#9
  tryok#7:
    arm64.movRegReg x20, x0
  trycont#9:
    arm64.movImm x1, 5
    arm64.leaRdata x2, __layout_Vector_N8_bool
    arm64.movRegReg x0, x19
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq trycont#12
  tryerr#11:
    arm64.movImm x0, 0
  trycont#12:
    arm64.movImm x1, 0
    arm64.eor x2, x20, 1
    arm64.cbz x2, ifcont#14
  cleared:
    arm64.movImm x1, 1
  ifcont#14:
    arm64.cbz x0, critsplit
  stillSet:
    arm64.add x20, x1, 10
    arm64.b ifcont#16
  critsplit:
    arm64.movRegReg x20, x1
  ifcont#16:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
