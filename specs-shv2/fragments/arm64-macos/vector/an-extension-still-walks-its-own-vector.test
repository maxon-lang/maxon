    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-extension-still-walks-its-own-vector.test:13: slice\x0a"
    arm64.bl mrt_panic
