// Test: bool-vector-from-literal
function main() returns ExitCode
	let v = Vector from [true, false, true, true, false, true, false, false, true]
	var count = 0
	for bit in v 'each'
		if bit 'isSet'
			count = count + 1
		end 'isSet'
	end 'each'
	return count
end 'main'
---
ExitCode: 5
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __arr_push
    arm64.movImm x19, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x20
    arm64.bl __arr_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, each
    arm64.b forexit
  each:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __arr_get_unchecked
    arm64.cbnz x0, isSet
    arm64.b critsplit
  isSet:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.movRegReg x19, x0
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
