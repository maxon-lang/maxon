// Test: same-size-aliases-are-one-type
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int
typealias Triple = Vector with 3 Int

function first(v Vec3) returns Int
	return try v.get(0) otherwise 0
end 'first'

function main() returns ExitCode
	var t = Triple.create()
	try t.set(0, value: 21) otherwise panic("test invariant: set OOB")
	return first(t) + t.count()
end 'main'
---
ExitCode: 24
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @first {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_Vector_N3_Int
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movImm x2, 21
    arm64.leaRdata x3, __layout_Vector_N3_Int
    arm64.movImm x4, 3
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at same-size-aliases-are-one-type.test:12: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x19
    arm64.bl first
    arm64.movImm x1, 3
    arm64.b __il_body
  __il_body:
    arm64.b __rc_ok#8
  __rc_ok#8:
    arm64.b __il_cont
  __il_cont:
    arm64.add x20, x0, x1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#3
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at same-size-aliases-are-one-type.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#3:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
