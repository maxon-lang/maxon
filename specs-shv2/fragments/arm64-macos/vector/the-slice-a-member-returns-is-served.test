// Test: the-slice-a-member-returns-is-served
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

extension Vector
	export function part() returns ElementMemory
		return try managed.slice(0, 2) otherwise panic("slice")
	end 'part'
end 'Vector'

function main() returns ExitCode
	var v = Vec3.create()
	var got = v.part()
	got.clear()
	return ((got.length() as Int) + (10 * v.count())) as ExitCode
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Vector.part {
  entry:
    arm64.prologue 16
    arm64.movRegReg x3, x1
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.bl __managed_slice_opaque
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __layout_Vector_N3_Int
    arm64.movRegReg x0, x19
    arm64.bl Vector.part
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __managed_clear
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.movImm x1, 3
    arm64.b __il_body
  __il_body:
    arm64.b __rc_ok#6
  __rc_ok#6:
    arm64.b __il_cont
  __il_cont:
    arm64.movImm x16, 10
    arm64.mul x1, x1, x16
    arm64.add x21, x0, x1
    arm64.cmp x21, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x21, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#1:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
