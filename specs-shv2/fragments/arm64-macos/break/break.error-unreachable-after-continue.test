// Test: break.error-unreachable-after-continue
function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 5 'loop'
		i = i + 1
		if i == 2 'skip'
			continue
			total = total + 100
		end 'skip'
		total = total + 1
	end 'loop'
	print("{total}\n")
	return 0
end 'main'
---
CompilerError:
error E3071: <fragment>:9:4: unreachable code after 'continue'
