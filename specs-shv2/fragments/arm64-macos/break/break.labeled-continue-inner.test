// Test: break.labeled-continue-inner
function main() returns ExitCode
	var sum = 0
	var x = 0
	while x < 3 'outer'
		x = x + 1
		var y = 0
		while y < 5 'inner'
			y = y + 1
			if y == 3 'check'
				continue
			end 'check'
			sum = sum + 1
		end 'inner'
	end 'outer'
	return sum
end 'main'
---
ExitCode: 12
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  whilehdr#1:
    arm64.cmp x1, 3
    arm64.b.ge whileexit
  outer:
    arm64.add x1, x1, 1
    arm64.movImm x2, 0
  whilehdr#4:
    arm64.cmp x2, 5
    arm64.b.ge whilehdr#1
  inner:
    arm64.add x2, x2, 1
    arm64.cmp x2, 3
    arm64.b.eq whilehdr#4
  ifcont:
    arm64.add x0, x0, 1
    arm64.b whilehdr#4
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at break.labeled-continue-inner.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
