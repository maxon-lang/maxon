// Test: break.labeled-break-outer
function main() returns ExitCode
	var x = 0
	while x < 10 'outer'
		x = x + 1
		while true 'inner'
			if x == 3 'check'
				break 'outer'
			end 'check'
			break
		end 'inner'
	end 'outer'
	return x
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.b whilehdr#1
  whilehdr#1:
    arm64.cmp x0, 10
    arm64.cset x1, lt
    arm64.cbnz x1, outer
    arm64.b critsplit
  outer:
    arm64.add x0, x0, 1
    arm64.b whilehdr#4
  whilehdr#4:
    arm64.b inner
  inner:
    arm64.cmp x0, 3
    arm64.cset x1, eq
    arm64.cbnz x1, check
    arm64.b ifcont
  check:
    arm64.b whileexit#3
  ifcont:
    arm64.b whileexit#6
  whileexit#6:
    arm64.b whilehdr#1
  critsplit:
    arm64.b whileexit#3
  whileexit#3:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at break.labeled-break-outer.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
