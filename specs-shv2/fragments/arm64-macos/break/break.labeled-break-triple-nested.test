// Test: break.labeled-break-triple-nested
function main() returns ExitCode
	var result = 0
	while true 'outer'
		while true 'middle'
			while true 'inner'
				result = result + 1
				if result == 5 'check'
					break 'outer'
				end 'check'
			end 'inner'
		end 'middle'
	end 'outer'
	return result
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.b whilehdr#1
  whilehdr#1:
    arm64.b outer
  outer:
    arm64.b whilehdr#4
  whilehdr#4:
    arm64.b middle
  middle:
    arm64.b whilehdr#7
  whilehdr#7:
    arm64.b inner
  inner:
    arm64.add x0, x0, 1
    arm64.cmp x0, 5
    arm64.cset x1, eq
    arm64.cbnz x1, check
    arm64.b ifcont
  check:
    arm64.b whileexit
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.b whilehdr#7
}
