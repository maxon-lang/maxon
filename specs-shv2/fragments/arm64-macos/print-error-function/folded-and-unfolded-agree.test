// Test: folded-and-unfolded-agree
// --- stdlib-overlay: Builtins.maxon
export typealias WrittenBytes = int(0 to u64.max)

export function writeFolded(text String) returns WrittenBytes
	return __Builtins.writeStdout(text.addressableBytes())
end 'writeFolded'

export function writeThroughABinding(text String) returns WrittenBytes
	let bytes = text.addressableBytes()
	return __Builtins.writeStdout(bytes)
end 'writeThroughABinding'
// --- file: main.maxon
function main() returns ExitCode
	let a = writeFolded("ab\n")
	let b = writeThroughABinding("cde\n")
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_2
    arm64.bl writeFolded
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_3
    arm64.bl writeThroughABinding
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
