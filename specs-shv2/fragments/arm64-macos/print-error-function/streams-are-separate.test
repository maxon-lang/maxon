// Test: streams-are-separate
function main() returns ExitCode
	print("out\n")
	printError("err\n")
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2
    arm64.bl print
    arm64.leaRdata x0, __str_rec_3
    arm64.bl printError
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
