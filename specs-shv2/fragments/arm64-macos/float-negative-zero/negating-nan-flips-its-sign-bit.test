// Test: negating-nan-flips-its-sign-bit
function main() returns ExitCode
	let quietNan = __Builtins.bitsToFloat(0x7FF8000000000000)
	if Math.hasNegativeSignBit(quietNan) 'arrivedNegative'
		return 1
	end 'arrivedNegative'
	let negated = -quietNan
	if not Math.hasNegativeSignBit(negated) 'signBitNotFlipped'
		return 2
	end 'signBitNotFlipped'
	if negated == negated 'notANan'
		return 3
	end 'notANan'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 9221120237041090560
    arm64.fmov d0, x0
    arm64.b __il_body#8
  __il_body#8:
    arm64.fmov x0, d0
    arm64.cmp x0, 0
    arm64.cset x0, lt
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cbnz x0, arrivedNegative
    arm64.b ifcont#2
  arrivedNegative:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.fneg d0, d0
    arm64.b __il_body#10
  __il_body#10:
    arm64.fmov x0, d0
    arm64.cmp x0, 0
    arm64.cset x0, lt
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, signBitNotFlipped
    arm64.b ifcont#4
  signBitNotFlipped:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.fcmp d0, d0
    arm64.cset x0, eq
    arm64.cbnz x0, notANan
    arm64.b ifcont#6
  notANan:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
