// Test: error.crossfile-type-and-typealias
// --- file: a.maxon
typealias Small = int(0 to 100)

export type Box
	export var v as Small
end 'Box'

// --- file: b.maxon
typealias Box = int(0 to 10)

export function useIt() returns ExitCode
	return 5 as Box
end 'useIt'

// --- file: main.maxon
function main() returns ExitCode
	return useIt()
end 'main'
