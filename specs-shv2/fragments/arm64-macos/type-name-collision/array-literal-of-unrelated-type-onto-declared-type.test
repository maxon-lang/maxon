// Test: array-literal-of-unrelated-type-onto-declared-type
typealias Num = int(0 to 100)

type Bar
	export var n as Num

	export static function create(v Num) returns Self
		return Self{n: v}
	end 'create'
end 'Bar'

type Foo
	export var n as Num

	export static function create(v Num) returns Self
		return Self{n: v}
	end 'create'
end 'Foo'

type Array_Foo
	export var tag as Num

	export static function create(v Num) returns Self
		return Self{tag: v}
	end 'create'
end 'Array_Foo'

function main() returns ExitCode
	let xs = [Bar.create(1), Bar.create(2)]
	let m = Array_Foo.create(7)

	return (xs.count() + m.tag) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Bar.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 100
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 100
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

