	return c
end 'useA'

// --- file: b.maxon
union Container
	empty
	holds(s String)
end 'Container'

export function fromB() returns ExitCode
	let c = Container.holds("hi")

	match c 'pick'
		empty then return 0
		holds(s) then return 3 if s.equals("hi") else 0
	end 'pick'
end 'fromB'

// --- file: main.maxon
function main() returns ExitCode
	return useA(2) + fromB()
end 'main'
