// Test: crossfile-boxed-union-temporary-is-discarded-by-a-stranger
// --- file: a.maxon
typealias Container = int(0 to 5)

export function fromA() returns ExitCode
	return 2 as Container
end 'fromA'

// --- file: b.maxon
export union Container
	empty
	holds(s String)
end 'Container'

export function fromB() returns Container
	return Container.holds("hi")
end 'fromB'

export function valueOf(c Container) returns ExitCode
	match c 'pick'
		empty then return 0
		holds(s) then return 3 if s.equals("hi") else 0
	end 'pick'
end 'valueOf'

// --- file: main.maxon
function relay(c Container) returns ExitCode
	return valueOf(c)
end 'relay'

function main() returns ExitCode
	_ = fromB()

	return 5 + fromA()
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @fromB {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "hi"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl fromB
    arm64.bl __destruct_Container
    arm64.movImm x0, 5
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, 2
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at main.maxon:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
