  __gt_proc_gts_base@136 = i64 0
  __gt_proc_wait_snapshot@144 = i64 0
  __gt_proc_poller@152 = i64 0
  __gt_live_count@160 = i64 0
  __sched_progress@168 = i64 0
  __sched_active_workers@176 = i64 1
  __sched_max_active_workers@184 = i64 1
  __sched_tls_index@192 = i64 0
  __sched_tls_teb_offset@200 = i64 0
  __sched_procs@208 = i64 0
  __sched_allm@216 = i64 0
  __sched_midle@224 = i64 0
  __sched_pidle@232 = i64 0
  __sched_num_procs@240 = i64 0
  __sched_shutdown_flag@248 = i64 0
  __sched_lock@256 = i64 0
  __sched_nmspinning@264 = i64 0
  __sched_parked_drivers@272 = i64 0
  __sched_sysmon_started@280 = i64 0
  __slab_arena_list@288 = i64 0
  __slab_arena_map_l1@296 = i64 0
  __slab_state@304 = i64 0
}

func @neverRuns {
  entry:
    arm64.prologue 16
    arm64.bl __parallel_boundary
    arm64.leaGlobal x0, __data_ran
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_ran
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  whilehdr:
    arm64.movImm x16, 5000
    arm64.cmp x19, x16
    arm64.b.ge whileexit
  loop:
    arm64.leaFuncAddr x0, neverRuns
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movRegReg x0, x20
    arm64.bl __gt_promise_drop
    arm64.add x19, x19, 1
    arm64.b whilehdr
  whileexit:
    arm64.bl __mm_counter_raw_alloc_live
    arm64.cmp x0, 100
    arm64.b.ge ifelse
  bounded:
    arm64.leaRdata x0, __str_rec_3  ; "ran="
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
