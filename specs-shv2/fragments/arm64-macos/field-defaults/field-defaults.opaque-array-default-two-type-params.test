// Test: field-defaults.opaque-array-default-two-type-params
typealias Count = int(0 to u64.max)

type Pairs uses Key, Value
	typealias KeyArray = Array with Key
	typealias ValueArray = Array with Value
	var keys as KeyArray = KeyArray.create()
	var values as ValueArray = ValueArray.create()
	var seen = 0

	export static function create() returns Self
		return Self{}
	end 'create'

	export function add(key Key, value Value)
		keys.push(key)
		values.push(value)
		seen = seen + 1
	end 'add'

	export function size() returns Count
		return seen
	end 'size'
end 'Pairs'

typealias Integer = int(i64.min to i64.max)
typealias IntPairs = Pairs with (Integer, Integer)

function main() returns ExitCode
	var p = IntPairs.create()
	p.add(1, value: 5)
	p.add(2, value: 6)
	p.add(3, value: 7)
	return p.size()
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pairs.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __fieldDefault#Pairs#keys
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __fieldDefault#Pairs#values
    arm64.movRegReg x19, x0
    arm64.movImm x21, 0
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.storeBaseDispReg.word64 [x0 + 16], x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Pairs.add {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x2
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.add x0, x0, 1
    arm64.storeBaseDispReg.word64 [x19 + 16], x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Pairs_Integer_Integer
    arm64.bl Pairs.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movImm x2, 5
    arm64.leaRdata x3, __layout_Pairs_Integer_Integer
    arm64.movRegReg x0, x19
    arm64.bl Pairs.add
    arm64.movImm x1, 2
    arm64.movImm x2, 6
    arm64.leaRdata x3, __layout_Pairs_Integer_Integer
    arm64.movRegReg x0, x19
    arm64.bl Pairs.add
    arm64.movImm x1, 3
    arm64.movImm x2, 7
    arm64.leaRdata x3, __layout_Pairs_Integer_Integer
    arm64.movRegReg x0, x19
    arm64.bl Pairs.add
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 16]
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Pairs_Integer_Integer
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at field-defaults.opaque-array-default-two-type-params.test:34: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @__fieldDefault#Pairs#keys {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 40]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.epilogue 16
    arm64.ret
}

func @__fieldDefault#Pairs#values {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 8
    arm64.loadRegBaseDisp.word64 x2, [x0 + 112]
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_create
    arm64.epilogue 16
    arm64.ret
}
