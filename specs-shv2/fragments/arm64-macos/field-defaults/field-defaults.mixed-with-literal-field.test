// Test: field-defaults.mixed-with-literal-field
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

type Bag
	export var items as IntArray = IntArray.create()
	export var total = 0

	export static function createWithTotal(t Integer) returns Self
		return Self{total: t}
	end 'createWithTotal'
end 'Bag'

function main() returns ExitCode
	var b = Bag.createWithTotal(5)
	b.items.push(10)
	return b.total + b.items.count()
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.createWithTotal {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl __fieldDefault#Bag#items
    arm64.movRegReg x20, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 5
    arm64.bl Bag.createWithTotal
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.movImm x1, 10
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.add x20, x0, x1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Bag
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @__fieldDefault#Bag#items {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.epilogue 16
    arm64.ret
}
