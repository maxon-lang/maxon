// Test: labeled-payload-args-two-scalar-fields
typealias Code = int(0 to 100)

union LexErr
	none
	pair(line Code, column Code)
end 'LexErr'

function main() returns ExitCode
	let e = LexErr.pair(7, column: 13)
	match e 'k'
		none then return 0
		pair(line, column) then return (line + column)
	end 'k'
end 'main'
---
ExitCode: 20
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
    arm64.movImm x20, 13
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.storeBaseDispReg.word64 [x0 + 16], x20
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x19, 0
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 16]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at labeled-payload-args-two-scalar-fields.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
