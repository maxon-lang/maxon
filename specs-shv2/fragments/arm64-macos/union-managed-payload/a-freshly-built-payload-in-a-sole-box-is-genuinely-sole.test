// Test: a-freshly-built-payload-in-a-sole-box-is-genuinely-sole
typealias Integer = int(i64.min to i64.max)

union Inner
	text(body String)
end 'Inner'

union Wrap
	held(i Inner)
end 'Wrap'

function probe() returns Integer
	let w = Wrap.held(Inner.text("a freshly built payload inside a sole box, heap-long"))
	return match w 'o'
		held(i) gives match i 'n'
			text(body) gives body.byteLength()
		end 'n'
	end 'o'
end 'probe'

function main() returns ExitCode
	print("n={probe()}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @probe {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "a freshly built payload inside a sole box, heap-long"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x20
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#1
    arm64.b matchdead#5
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#2
    arm64.b matchdead#3
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movRegReg x0, x21
    arm64.bl __mm_incref
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x22, [x21 + 8]
    arm64.cmp x22, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.movRegReg x0, x21
    arm64.bl String.byteLength
    arm64.movRegReg x22, x0
    arm64.b __il_cont
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.b matchcont#4
  matchcont#4:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Inner
    arm64.b matchcont#6
  matchcont#6:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Wrap
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  matchdead#3:
  matchdead#5:
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_3  ; "n="
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.bl probe
    arm64.movRegReg x21, x0
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __int_to_string
    arm64.movRegReg x21, x0
    arm64.add x23, x20, x21
    arm64.add x0, x23, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x19, x25, x20
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x19, x21
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
    arm64.storeBaseDispReg.word64 [x24 + 8], x23
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x24 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x24 + 24], x0
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x24
    arm64.bl print
    arm64.movRegReg x0, x24
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.epilogue 80
    arm64.ret
}
