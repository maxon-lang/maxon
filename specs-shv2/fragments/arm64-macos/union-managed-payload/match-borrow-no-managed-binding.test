// Test: match-borrow-no-managed-binding
typealias Integer = int(i64.min to i64.max)

type Body
	export var mass as Integer

	static function create(mass Integer) returns Self
		return Self{mass: mass}
	end 'create'
end 'Body'

union Shape
	empty
	solid(body Body)
end 'Shape'

function main() returns ExitCode
	let s = Shape.solid(Body.create(3))
	let code = match s 'check'
		empty gives 1
		solid gives 2
	end 'check'
	return code
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Body.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.bl Body.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x19, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x19, 2
  matchcont:
    arm64.bl __destruct_Shape
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-borrow-no-managed-binding.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
