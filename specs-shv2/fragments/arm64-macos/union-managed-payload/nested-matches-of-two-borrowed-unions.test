// Test: nested-matches-of-two-borrowed-unions
typealias Integer = int(i64.min to i64.max)

union Inner
	quiet
	loud(word String)
end 'Inner'

union Outer
	blank
	holds(label String)
end 'Outer'

function both(o Outer, i Inner) returns Integer
	return match o 'x'
		blank gives 0
		holds(label) gives match i 'y'
			quiet gives 1
			loud(word) gives 2
		end 'y'
	end 'x'
end 'both'

function main() returns ExitCode
	let o = Outer.holds("the outer label string, long enough to be a heap allocation")
	let i = Inner.loud("the inner word string, long enough to be a heap allocation")
	let a = both(o, i: i)
	let b = both(o, i: i)
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @both {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x19, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x21, 2
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x19, x21
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.b matchcont
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
  matchdead:
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.loadRegBaseDisp.word64 x21, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.add x0, x19, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 48
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x23, x19
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x19
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x22
    arm64.leaRdata x19, __str_rec_3
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.loadRegBaseDisp.word64 x22, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.add x0, x19, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 48
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x24, x19
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x19
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x23
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl both
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl both
    arm64.add x19, x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Inner
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outer
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
