// Test: repeated-borrowed-binds-in-a-loop-with-an-early-return
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 100)

union M
	silent
	text(body String)
end 'M'

function scan(m M) returns Integer
	var i = 0 as Round
	var seen = 0 as Integer
	while i < 5 'spin'
		let n = match m 'k'
			silent gives 0
			text(s) gives 1
		end 'k'
		if n == 0 'stop'
			return 0
		end 'stop'
		seen = seen + n
		i = i + 1
	end 'spin'
	return seen
end 'scan'

function main() returns ExitCode
	let m = M.text("a repeatedly scanned payload string, long enough for the heap")
	let a = scan(m)
	print("{a}")
	return a as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @scan {
  entry:
    arm64.prologue 64
