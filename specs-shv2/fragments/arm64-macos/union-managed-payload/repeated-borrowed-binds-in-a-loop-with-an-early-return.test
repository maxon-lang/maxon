    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 5
    arm64.cset x0, lt
    arm64.cbnz x0, spin
    arm64.b whileexit
  spin:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#4
    arm64.b matchnext
  matcharm#4:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#5
    arm64.b matchdead
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x22, [x19 + 8]
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.movImm x23, 1
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x23
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, stop
    arm64.b ifcont
  stop:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.add x21, x21, x0
    arm64.add x20, x20, 1
    arm64.b whilehdr
  matchdead:
  whileexit:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
