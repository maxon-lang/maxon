// Test: owned-move-out-and-borrowed-retain-in-one-function
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function mixed(borrowed M) returns Integer
	let owned = M.text("a locally built payload string long enough for the heap")
	let a = match owned 'o'
		silent gives 0
		text(s) gives 1
	end 'o'
	let b = match borrowed 'b'
		silent gives 0
		text(t) gives 2
	end 'b'
	return a + b
end 'mixed'

function main() returns ExitCode
	let m = M.text("the caller's payload string, long enough to be a real heap allocation")
	return mixed(m) as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @mixed {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __str_rec_2  ; "a locally built payload string long enough for the heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#4
  matcharm#1:
    arm64.movImm x20, 0
    arm64.b matchcont#5
  matchnext#4:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#3
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x21 + 8], x1
    arm64.movImm x20, 1
    arm64.bl __str_decref
  matchcont#5:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#9
  matcharm#6:
    arm64.movImm x0, 0
    arm64.b matchcont#10
  matchnext#9:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#8
  matcharm#7:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x22, 2
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x22
  matchcont#10:
    arm64.add x19, x20, x0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  matchdead#8:
  matchdead#3:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_3  ; "the caller's payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl mixed
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at owned-move-out-and-borrowed-retain-in-one-function.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
