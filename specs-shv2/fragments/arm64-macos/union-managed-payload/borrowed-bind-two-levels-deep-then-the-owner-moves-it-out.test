// Test: borrowed-bind-two-levels-deep-then-the-owner-moves-it-out
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function inner(m M) returns Integer
	return match m 'k'
		silent gives 0
		text(s) gives 3
	end 'k'
end 'inner'

function outer(m M) returns Integer
	let first = match m 'k'
		silent gives 0
		text(s) gives 4
	end 'k'
	return first + inner(m)
end 'outer'

function main() returns ExitCode
	let m = M.text("a payload string handed down two borrow levels, heap-long")
	let a = outer(m)
	match m 'own'
		silent then return 0
		text(s) then print(s)
	end 'own'
	return a as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @inner {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.b matchcont
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @outer {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x20, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movImm x21, 4
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x20, x21
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl inner
    arm64.add x0, x20, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.loadRegBaseDisp.word64 x21, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.add x0, x19, 49
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x23, x22, 48
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x23, x19
    arm64.storeBaseDispReg.word64 [x22 + 0], x23
    arm64.storeBaseDispReg.word64 [x22 + 8], x19
    arm64.movImm x0, -3
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x22
    arm64.movRegReg x0, x20
    arm64.bl outer
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x21
    arm64.bl __print_string
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.b matchcont
  matchcont:
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x19, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  matchdead:
}
