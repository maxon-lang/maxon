// Test: borrowed-bind-two-levels-deep-then-the-owner-moves-it-out
typealias Integer = int(i64.min to i64.max)

union M
	silent
	text(body String)
end 'M'

function inner(m M) returns Integer
	return match m 'k'
		silent gives 0
		text(s) gives 3
	end 'k'
end 'inner'

function outer(m M) returns Integer
	let first = match m 'k'
		silent gives 0
		text(s) gives 4
	end 'k'
	return first + inner(m)
end 'outer'

function main() returns ExitCode
	let m = M.text("a payload string handed down two borrow levels, heap-long")
	let a = outer(m)
	match m 'own'
		silent then return 0
		text(s) then print(s)
	end 'own'
	return a as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @inner {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @outer {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x20, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movImm x21, 4
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x20, x21
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl inner
    arm64.add x0, x20, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a payload string handed down two borrow levels, heap-long"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl outer
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x21
    arm64.bl print
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
  matchcont:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at borrowed-bind-two-levels-deep-then-the-owner-moves-it-out.test:31: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}
