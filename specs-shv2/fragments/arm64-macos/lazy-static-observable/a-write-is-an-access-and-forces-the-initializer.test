// Test: a-write-is-an-access-and-forces-the-initializer
typealias Count = int(0 to u64.max)

type Slot
	static var runs = 0
	static var value = Slot.build()
	export var n as Count

	static function build() returns Slot
		Slot.runs = Slot.runs + 1
		return Slot{n: 1}
	end 'build'

	static function of(n Count) returns Self
		return Self{n: n}
	end 'of'

	export static function set(s Slot)
		Slot.value = s
	end 'set'

	export static function get() returns Count
		return Slot.value.n
	end 'get'

	export static function runCount() returns Count
		return Slot.runs
	end 'runCount'
end 'Slot'

function main() returns ExitCode
	Slot.set(Slot.of(99))
	print("{Slot.get()} {Slot.runCount()}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Slot.runs@0 = i64 0
  __data_Slot.value@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @Slot.build {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_Slot.runs
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_Slot.runs
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x19, 1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Slot.of {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Slot.set {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.bl __lazy_init#__data_Slot.value
    arm64.leaGlobal x0, __data_Slot.value
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_decref
    arm64.bl __lazy_init#__data_Slot.value
    arm64.leaGlobal x0, __data_Slot.value
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Slot.get {
  entry:
    arm64.prologue 16
    arm64.bl __lazy_init#__data_Slot.value
    arm64.leaGlobal x0, __data_Slot.value
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 99
    arm64.bl Slot.of
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Slot.set
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.bl Slot.get
    arm64.movRegReg x19, x0
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __uint_to_string
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1  ; " "
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.b __il_body
  __il_body:
    arm64.leaGlobal x0, __data_Slot.runs
    arm64.loadRegBaseDisp.word64 x23, [x0 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.movImm x0, 20
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.movRegReg x0, x23
    arm64.movRegReg x1, x24
    arm64.bl __uint_to_string
    arm64.movRegReg x23, x0
    arm64.add x0, x19, x22
    arm64.add x25, x0, x23
    arm64.add x0, x25, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
    arm64.add x27, x26, 56
    arm64.movRegReg x0, x27
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x19, x27, x19
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x19, x19, x22
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x23
    arm64.bl __str_copy
    arm64.add x0, x19, x23
    arm64.storeBaseDispReg.word64 [x26 + 0], x27
    arm64.storeBaseDispReg.word64 [x26 + 8], x25
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x26 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x26 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x24
    arm64.bl __mm_decref
    arm64.movRegReg x0, x26
    arm64.bl print
    arm64.movRegReg x0, x26
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.epilogue 96
    arm64.ret
}
