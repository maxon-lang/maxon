// Test: for-in-nested
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function innerSum(arr IntArray) returns Int
	var total = 0
	for item in arr 'inner'
		total = total + item
	end 'inner'
	return total
end 'innerSum'

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(1)
	arr.push(2)
	arr.push(3)

	var outerTotal = 0
	for item in arr 'outer'
		outerTotal = outerTotal + item + innerSum(arr)
	end 'outer'

	// Each outer item: item + innerSum(arr) = item + 6
	// Outer loop: (1+6) + (2+6) + (3+6) = 7+8+9 = 24
	if outerTotal == 24 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @innerSum {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x19
    arm64.bl __managed_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, inner
    arm64.b forexit
  inner:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
    arm64.add x20, x20, x0
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.movRegReg x0, x19
    arm64.bl __managed_count
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, outer
    arm64.b forexit
  outer:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl innerSum
    arm64.add x20, x20, x0
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x20, 24
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
