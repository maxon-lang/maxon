// Test: sched-processor.many-green-threads-through-one-processor
function step(n Counted) returns Counted
	__Builtins.parallelBoundary()
	return n * 3
end 'step'

typealias Counted = int(i64.min to i64.max)
typealias CountedPromise = Promise with Counted
typealias CountedPromiseArray = Array with CountedPromise

function main() returns ExitCode
	var promises = CountedPromiseArray.create()

	for i in 0 upto 32 'spawn'
		promises.push(async step(i))
	end 'spawn'

	var total = 0

	for p in promises 'await'
		total = total + await p
	end 'await'

	if total == 1488 'expected'
		return 7
	end 'expected'
	return 1
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __slab_arena_list@160 = i64 0
  __slab_arena_map_l1@168 = i64 0
  __slab_state@176 = i64 0
}

func @step {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl __parallel_boundary
    arm64.movImm x16, 3
    arm64.mul x0, x19, x16
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x20, 32
    arm64.cset x0, lt
    arm64.cbnz x0, spawn
    arm64.b forexit#4
  spawn:
    arm64.leaFuncAddr x0, step
    arm64.bl __gt_spawn
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 200], x20
    arm64.movRegReg x0, x21
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_push
    arm64.b forstep#3
  forstep#3:
    arm64.add x20, x20, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr#5
  forhdr#5:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, await
    arm64.b forexit#8
  await:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.arm64AddLsl x0, x0, x21, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.bl __gt_await
    arm64.add x20, x20, x0
    arm64.b forstep#7
  forstep#7:
    arm64.add x21, x21, 1
    arm64.b forhdr#5
  forexit#8:
    arm64.cmp x20, 1488
    arm64.cset x0, eq
    arm64.cbnz x0, expected
    arm64.b ifcont
  expected:
    arm64.movImm x20, 7
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
