// Test: a-raw-byte-write-is-accepted-when-the-element-fills-its-two-byte-slot
typealias Byte = int(0 to u16.max)
typealias Bytes = Array with Byte

function main() returns ExitCode
	var a = Bytes.create()
	a.push(1)
	try a.managed.setByte(1, 223) otherwise return 3
	return 0 if (try a.get(0) otherwise 0) == 57089 else 4
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movImm x2, 223
    arm64.movRegReg x0, x19
    arm64.bl __arr_set_byte
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x0, 57089
    arm64.cset x0, eq
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x20, 0
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x20, 4
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
