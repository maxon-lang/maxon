// Test: a-wide-byte-still-materializes-a-byte-view
typealias Byte = int(0 to 1000)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	let first = try b.get(0) otherwise 0
	let second = try b.get(1) otherwise 0
	let third = try b.get(2) otherwise 0
	return 0 if b.count() == 3 and first == 97 and second == 98 and third == 99 else 1
end 'takes'

function main() returns ExitCode
	return takes("abc".toByteArray())
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @takes {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x21, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x22, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x22, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl __arr_count
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x20, 97
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x21, 98
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x22, 99
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 0
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1
    arm64.movImm x0, 2
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __str_to_bytes
    arm64.movRegReg x0, x20
    arm64.bl takes
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __arr_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
