// Test: a-buffer-field-strides-its-declaring-files-byte
// --- file: holder.maxon
export type Holder
	export var buf as __ManagedMemory

	export static function ofText(t String) returns Holder
		return Holder{buf: t.toByteArray()}
	end 'ofText'

	export function first() returns int
		return try self.buf.get(0) otherwise 0
	end 'first'
end 'Holder'

// --- file: main.maxon
typealias Byte = int(0 to 1000)

function widen(b Byte) returns int
	return b
end 'widen'

function main() returns ExitCode
	let h = Holder.ofText("ab")
	return (h.first() - widen(50)) as ExitCode
end 'main'
---
ExitCode: 47
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @widen {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1
    arm64.bl Holder.ofText
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Holder.first
    arm64.movRegReg x20, x0
    arm64.movImm x0, 50
    arm64.bl widen
    arm64.sub x20, x20, x0
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4294967295
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Holder.ofText {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
