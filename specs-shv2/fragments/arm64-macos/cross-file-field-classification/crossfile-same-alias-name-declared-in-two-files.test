    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#1:
    arm64.add x19, x0, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#5
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.cmp x19, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#5
    arm64.b __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at gate.maxon:7: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#4:
    arm64.movImm x0, 8
