export union Payloaded
	some(v String)
	none
end 'Payloaded'

export type Bag
	export var n as int
	export var u as Payloaded

	export static function make() returns Bag
		return Bag{n: 42, u: Payloaded.some("x")}
	end 'make'
end 'Bag'

// --- file: main.maxon
function main() returns ExitCode
	let b = Bag.make()
	return b.n
end 'main'
