// Test: ranged-codepoint-alias-stays-legal
typealias Codepoint = int(0 to 1114111)

function main() returns ExitCode
	let c = 128512 as Codepoint
	return c - 128512
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 128512
    arm64.sub x0, x0, 128512
    arm64.epilogue 16
    arm64.ret
}
