    arm64.movImm x0, 3
    arm64.movImm x1, 2
    arm64.scvtf d0, x0
    arm64.scvtf d1, x1
    arm64.bl Math.pow
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}

