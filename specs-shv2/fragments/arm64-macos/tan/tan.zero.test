    arm64.cbnz x0, reduce_pos
    arm64.b whileexit
  reduce_pos:
    arm64.fpLoadRdata d1, [rdata + __fconst_5]
    arm64.fsub d0, d0, d1
    arm64.b whilehdr
  whileexit:
    arm64.b whilehdr
  whilehdr:
    arm64.fpLoadRdata d1, [rdata + __fconst_4]
    arm64.fpLoadRdata d2, [rdata + __fconst_3]
    arm64.fsub d1, d2, d1
    arm64.fcmp d0, d1
    arm64.cset x0, mi
    arm64.cbnz x0, reduce_neg
    arm64.b whileexit
  reduce_neg:
    arm64.fpLoadRdata d1, [rdata + __fconst_5]
    arm64.fadd d0, d0, d1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
}

