// Test: self-literal-beside-an-inner-alias
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Holder
	typealias Nums = Array with ExitCode

	export var seed = 0

	export static function create() returns Self
		return Self{}
	end 'create'

	export function count() returns Count
		var n = Nums{}
		n.resize(self.seed)
		return n.count()
	end 'count'
end 'Holder'

function main() returns ExitCode
	var h = Holder.create()
	let c = h.count()
	if c == 0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.count {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at self-literal-beside-an-inner-alias.test:16: Range check failed: value outside typealias 'ElementCount'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __managed_resize
    arm64.loadRegBaseDisp.word64 x19, [x20 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.bl Holder.count
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 32
    arm64.ret
}
