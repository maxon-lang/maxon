// Test: managed-element-inner-array-alias
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Bag
	typealias Names = Array with String

	export var names as Names

	export static function create() returns Self
		var n = Names{}
		n.push("a string long enough to force a heap allocation")
		return Self{names: n}
	end 'create'

	export function count() returns Count
		return self.names.count()
	end 'count'
end 'Bag'

function main() returns ExitCode
	var b = Bag.create()
	let c = b.count()
	if c == 1 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Bag.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1  ; "a string long enough to force a heap allocation"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Bag.create
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, ok
    arm64.b ifcont
  ok:
    arm64.movImm x19, 0
    arm64.bl __destruct_Bag
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.bl __destruct_Bag
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
