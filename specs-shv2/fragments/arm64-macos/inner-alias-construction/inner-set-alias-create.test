// Test: inner-set-alias-create
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)

type Plain
	typealias Nums = Set with ExitCode

	static function make() returns Count
		var s = Nums.create()
		s.insert(3)
		s.insert(3)
		return s.count()
	end 'make'
end 'Plain'

function main() returns ExitCode
	let c = Plain.make()
	if c == 1 'ok'
		return 8
	end 'ok'
	return 1
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Plain.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Set_ExitCode$0_125
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Set.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.leaRdata x2, __layout_Set_ExitCode$0_125
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Set.insert
    arm64.movImm x1, 3
    arm64.leaRdata x2, __layout_Set_ExitCode$0_125
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Set.insert
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 24]
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x0, 4611686018427387904
    arm64.cmp x20, x0
    arm64.cset x0, gt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl Set.count
    arm64.movRegReg x20, x0
    arm64.b __il_cont
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Set_ExitCode$0_125
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl Plain.make
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 8
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
