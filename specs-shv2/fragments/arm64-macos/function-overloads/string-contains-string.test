// Test: string-contains-string
function main() returns ExitCode
	let text = "hello world"
	if text.contains("world") 'check'
		return 1
	end 'check' else 'other'
		return 0
	end 'other'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.leaRdata x1, __str_rec_3
    arm64.bl __str_contains
    arm64.cbnz x0, check
    arm64.b ifelse
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
}
