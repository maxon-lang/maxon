// Test: overloads-three-way-agree-on-the-error-they-throw
typealias Num = int(-1000 to 1000)

enum TestFailure
	mismatch
end 'TestFailure'

type Expect

	export static function equal(actual Num, expected Num) returns Num throws TestFailure
		if actual != expected 'differ'
			throw TestFailure.mismatch
		end 'differ'
		return 1
	end 'equal'

	export static function equal(actual String, expected String) returns Num throws TestFailure
		if actual.count() != expected.count() 'differ'
			throw TestFailure.mismatch
		end 'differ'
		return 2
	end 'equal'

	export static function equal(actual bool, expected bool) returns Num throws TestFailure
		if actual != expected 'differ'
			throw TestFailure.mismatch
		end 'differ'
		return 4
	end 'equal'

end 'Expect'

function main() returns ExitCode
	let a = try Expect.equal(1, expected: 1) otherwise 0
	let b = try Expect.equal("xy", expected: "ab") otherwise 0
	let c = try Expect.equal(true, expected: true) otherwise 0
	return (a + b + c) as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Expect.equal {
  entry:
    arm64.prologue 16
    arm64.cmp x0, -1000
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic#4
    arm64.b __rc_chk#5
  __rc_chk#5:
    arm64.cmp x0, 1000
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic#4
    arm64.b __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_15
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#3:
    arm64.cmp x1, -1000
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic#7
    arm64.b __rc_chk#8
  __rc_chk#8:
    arm64.cmp x1, 1000
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic#7
    arm64.b __rc_ok#6
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_15
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#6:
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, differ
    arm64.b ifcont
  differ:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @Expect.equal#String#String {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.bl String.count
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl String.count
    arm64.cmp x20, x0
    arm64.cset x0, ne
    arm64.cbnz x0, differ
    arm64.b ifcont
  differ:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 2
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Expect.equal#bool#bool {
  entry:
    arm64.prologue 16
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, differ
    arm64.b ifcont
  differ:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 4
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.movImm x1, 1
    arm64.bl Expect.equal
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x19, 0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x19, x0
    arm64.b trycont#3
  trycont#3:
    arm64.leaRdata x0, __str_rec_2
    arm64.leaRdata x1, __str_rec_3
    arm64.bl Expect.equal#String#String
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#5
    arm64.b tryok#4
  tryerr#5:
    arm64.movImm x20, 0
    arm64.b trycont#6
  tryok#4:
    arm64.movRegReg x20, x0
    arm64.b trycont#6
  trycont#6:
    arm64.movImm x0, 1
    arm64.movImm x1, 1
    arm64.bl Expect.equal#bool#bool
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#8
    arm64.b tryok#7
  tryerr#8:
    arm64.movImm x0, 0
    arm64.b trycont#9
  tryok#7:
    arm64.b trycont#9
  trycont#9:
    arm64.add x1, x19, x20
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_16
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
