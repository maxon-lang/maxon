// Test: error.ambiguous-same-signature
typealias Integer = int(i64.min to i64.max)

function create(name String) returns Integer
	return name.count()
end 'create'

function create(label String) returns Integer
	return label.count()
end 'create'

function main() returns ExitCode
	return create("hello")
end 'main'
---
CompilerError:
error E3007: <fragment>:13:9: Ambiguous overload for 'create': multiple overloads match. Candidates: (name String), (label String)
