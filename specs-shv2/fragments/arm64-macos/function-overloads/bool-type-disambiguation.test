// Test: bool-type-disambiguation
typealias Integer = int(i64.min to i64.max)

function check(value Integer) returns Integer
	return value
end 'check'

function check(value bool) returns Integer
	if value 'branch'
		return 1
	end 'branch' else 'other'
		return 0
	end 'other'
end 'check'

function main() returns ExitCode
	return check(true)
end 'main'
---
ExitCode: 1
---
func @check#bool {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, branch
    arm64.b ifelse
  branch:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.bl check#bool
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.movImm x1, 4294967295
    arm64.cmp x0, x1
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
