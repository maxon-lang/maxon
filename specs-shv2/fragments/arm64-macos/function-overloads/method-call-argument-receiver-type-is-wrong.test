// Test: method-call-argument-receiver-type-is-wrong
typealias Wide = int(i64.min to i64.max)

function over(x String) returns Wide
	return x.count() + 200
end 'over'

function over(x Wide) returns Wide
	return x + 100
end 'over'

function main() returns ExitCode
	let s = "hello"
	return over(s.count())
end 'main'
---
ExitCode: 105
---
func @over#Wide {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 100
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1
    arm64.bl __gr_count
    arm64.bl over#Wide
    arm64.epilogue 16
    arm64.ret
}
