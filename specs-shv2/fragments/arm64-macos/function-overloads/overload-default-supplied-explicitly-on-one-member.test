// Test: overload-default-supplied-explicitly-on-one-member
typealias Integer = int(i64.min to i64.max)

function width(value Integer, unit String = "mm") returns Integer
	return value + unit.count()
end 'width'

function width(value bool, unit String = "inches") returns Integer
	if value 'yes'
		return unit.count()
	end 'yes'
	return 0
end 'width'

function main() returns ExitCode
	return (width(3, unit: "centimetre") + width(true)) as ExitCode
end 'main'
---
ExitCode: 19
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @width {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x1
    arm64.bl String.count
    arm64.add x0, x19, x0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @width#bool#String {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, yes
    arm64.b ifcont
  yes:
    arm64.movRegReg x0, x1
    arm64.bl String.count
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.leaRdata x1, __str_rec_3
    arm64.bl width
    arm64.movRegReg x19, x0
    arm64.movImm x20, 1
    arm64.bl __paramDefault#width#bool#String#1
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl width#bool#String
    arm64.add x19, x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_17
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @__paramDefault#width#bool#String#1 {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_5
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}
