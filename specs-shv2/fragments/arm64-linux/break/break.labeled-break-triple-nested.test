// Test: break.labeled-break-triple-nested
function main() returns ExitCode
	var result = 0
	while true 'outer'
		while true 'middle'
			while true 'inner'
				result = result + 1
				if result == 5 'check'
					break 'outer'
				end 'check'
			end 'inner'
		end 'middle'
	end 'outer'
	return result
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
  inner:
    arm64.add x0, x0, 1
    arm64.cmp x0, 5
    arm64.b.ne inner
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at break.labeled-break-triple-nested.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
