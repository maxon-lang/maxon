// Test: union-backing-mixed-cases
typealias Cost = int(0 to 100)
typealias ID = int(i64.min to i64.max)

type CostMeta
	export let cost as Cost

	static function create(cost Cost) returns Self
		return Self{cost: cost}
	end 'create'
end 'CostMeta'

union Action
	load(dest ID) = CostMeta.create(4)
	store(src ID) = CostMeta.create(3)
	nop = CostMeta.create(0)
end 'Action'

function main() returns ExitCode
	let op = Action.nop
	match op 'handle'
		load(d) then return d
		store(s) then return s
		nop then return 1
	end 'handle'
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 2
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#9
  __rc_chk#10:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok#8
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_1  ; "panic at union-backing-mixed-cases.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#8:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchnext#5:
    arm64.cmp x1, 1
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#12
  __rc_chk#13:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok#11
  __rc_panic#12:
    arm64.leaRdata x0, __str_blob_2  ; "panic at union-backing-mixed-cases.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#11:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchnext#6:
    arm64.cmp x1, 2
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movImm x19, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
