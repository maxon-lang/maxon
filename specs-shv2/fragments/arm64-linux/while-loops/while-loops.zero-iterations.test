// Test: while-loops.zero-iterations
function main() returns ExitCode
	var x = 10
	while x < 5 'loop'
		x = x + 1
	end 'loop'
	return x
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x0, 5
    arm64.cset x1, lt
    arm64.cbnz x1, loop
    arm64.b whileexit
  loop:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
}
