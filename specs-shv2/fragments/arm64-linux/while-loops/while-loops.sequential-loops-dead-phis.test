// Test: while-loops.sequential-loops-dead-phis
function work(x Integer) returns Integer
	return x + 1
end 'work'

function big(n Integer) returns Integer
	var total = 0
	var a0 = 1
	var a1 = 2
	var a2 = 3
	var a3 = 4
	var a4 = 5
	var a5 = 6
	var i0 = 0
	while i0 < n 'L0'
		let r = work(i0)
		a0 = a0 + r
		a1 = a1 + r
		a2 = a2 + r
		a3 = a3 + r
		a4 = a4 + r
		a5 = a5 + r
		i0 = i0 + 1
	end 'L0'
	total = total + a0 + a1 + a2 + a3 + a4 + a5
	var b0 = 1
	var b1 = 2
	var b2 = 3
	var b3 = 4
	var b4 = 5
	var b5 = 6
	var i1 = 0
	while i1 < n 'L1'
		let s = work(i1)
		b0 = b0 + s
		b1 = b1 + s
		b2 = b2 + s
		b3 = b3 + s
		b4 = b4 + s
		b5 = b5 + s
		i1 = i1 + 1
	end 'L1'
	total = total + b0 + b1 + b2 + b3 + b4 + b5
	return total
end 'big'

function main() returns ExitCode
	return big(3)
end 'main'
typealias Integer = int(i64.min to i64.max)
