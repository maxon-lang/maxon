// Test: nested-control
function main() returns ExitCode
	var result = 0
	var i = 0
	while i < 3 'outer'
		var j = 0
		while j < 3 'inner'
			if (i + j) mod 2 == 0 'even'
				result = result + 1
			end 'even'
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return result
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  whilehdr#1:
    arm64.cmp x1, 3
    arm64.b.ge whileexit#3
  outer:
    arm64.movImm x2, 0
  whilehdr#4:
    arm64.cmp x2, 3
    arm64.b.ge whileexit#6
  inner:
    arm64.add x3, x1, x2
    arm64.asr x4, x3, 63
    arm64.lsr x4, x4, 63
    arm64.add x4, x3, x4
    arm64.asr x4, x4, 1
    arm64.movImm x16, 2
    arm64.mul x4, x4, x16
    arm64.sub x3, x3, x4
    arm64.cmp x3, 0
    arm64.b.ne ifcont
  even:
    arm64.add x0, x0, 1
  ifcont:
    arm64.add x2, x2, 1
    arm64.b whilehdr#4
  whileexit#6:
    arm64.add x1, x1, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at nested-control.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
