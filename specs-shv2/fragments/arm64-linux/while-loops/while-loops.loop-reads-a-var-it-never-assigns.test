// Test: while-loops.loop-reads-a-var-it-never-assigns
function main() returns ExitCode
	var limit = 0
	limit = 6
	var i = 0
	var acc = 0
	while i < limit 'l'
		acc = acc + limit
		i = i + 1
	end 'l'
	return acc
end 'main'
---
ExitCode: 36
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x0, 6
    arm64.cset x2, lt
    arm64.cbnz x2, l
    arm64.b whileexit
  l:
    arm64.add x1, x1, 6
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at while-loops.loop-reads-a-var-it-never-assigns.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}
