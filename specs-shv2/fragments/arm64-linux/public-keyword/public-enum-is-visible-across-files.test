// Test: public-enum-is-visible-across-files
// --- file: api/color.maxon
public enum Color
	red
	green
	blue
end 'Color'

// --- file: app/main.maxon
function main() returns ExitCode
	let c = Color.blue
	match c 'check'
		blue then return 7
		red then return 0
		green then return 0
	end 'check'
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
