// Test: int-expression-both-sides-complex
function main() returns ExitCode
	let a = 3
	let b = 5
	let c = 7
	let d = 2
	return (a + b) * (c - d)
end 'main'
---
ExitCode: 40
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 40
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
