// Test: error-multiple-try-calls

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	failed
end 'MyError'

function getA() returns Integer throws MyError
	return 10
end 'getA'

function getB() returns Integer throws MyError
	return 20
end 'getB'

function getC() returns Integer throws MyError
	throw MyError.failed
end 'getC'

function main() returns ExitCode
	let a = try getA() otherwise 0
	let b = try getB() otherwise 0
	let c = try getC() otherwise 12
	return a + b + c
end 'main'
---
ExitCode: 42
---
func @getA {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @getB {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @getC {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl getA
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x19, 0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x19, x0
    arm64.b trycont#3
  trycont#3:
    arm64.bl getB
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#5
    arm64.b tryok#4
  tryerr#5:
    arm64.movImm x20, 0
    arm64.b trycont#6
  tryok#4:
    arm64.movRegReg x20, x0
    arm64.b trycont#6
  trycont#6:
    arm64.bl getC
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#8
    arm64.b tryok#7
  tryerr#8:
    arm64.movImm x0, 12
    arm64.b trycont#9
  tryok#7:
    arm64.b trycont#9
  trycont#9:
    arm64.add x1, x19, x20
    arm64.add x0, x1, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at error-multiple-try-calls.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
