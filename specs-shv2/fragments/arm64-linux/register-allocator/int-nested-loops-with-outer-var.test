// Test: int-nested-loops-with-outer-var
function main() returns ExitCode
	var total = 0
	var i = 1
	while i <= 5 'outer'
		var j = 1
		while j <= i 'inner'
			total = total + 1
			j = j + 1
		end 'inner'
		i = i + 1
	end 'outer'
	return total
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.b whilehdr#1
  whilehdr#1:
    arm64.cmp x1, 5
    arm64.cset x2, le
    arm64.cbnz x2, outer
    arm64.b whileexit#3
  outer:
    arm64.movImm x2, 1
    arm64.b whilehdr#4
  whilehdr#4:
    arm64.cmp x2, x1
    arm64.cset x3, le
    arm64.cbnz x3, inner
    arm64.b whileexit#6
  inner:
    arm64.add x0, x0, 1
    arm64.add x2, x2, 1
    arm64.b whilehdr#4
  whileexit#6:
    arm64.add x1, x1, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-nested-loops-with-outer-var.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
