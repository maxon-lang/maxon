// Test: float-and-int-mixed-pressure
function main() returns ExitCode
	let x = 3.14
	let y = 2.86
	let sum_f = x + y
	let a = 10
	let b = 20
	let sum_i = a + b
	return trunc(sum_f) + sum_i
end 'main'
---
ExitCode: 36
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 36
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
