// Test: int-if-else-simple
function main() returns ExitCode
	let x = 10
	if x == 10 'check'
		return 42
	end 'check' else 'other'
		return 0
	end 'other'
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b check
  check:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
