// Test: scientific-notation-explicit-positive
function main() returns ExitCode
	let x = 2.5e+02
	return trunc(x) - 240
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fcvtzs x0, d0
    arm64.sub x0, x0, 240
    arm64.epilogue 16
    arm64.ret
}
