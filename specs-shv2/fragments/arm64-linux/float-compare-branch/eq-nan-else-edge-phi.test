// Test: eq-nan-else-edge-phi
var zeroA = 0.0
var zeroB = 0.0

function main() returns ExitCode
	var r = 7
	let nan = zeroA / zeroB
	if nan == nan 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 7
---
data {
  __data_zeroA@0 = f64 0
  __data_zeroB@8 = f64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.leaGlobal x1, __data_zeroA
    arm64.loadRegBaseDisp.word64 d0, [x1 + 0]
    arm64.leaGlobal x1, __data_zeroB
    arm64.loadRegBaseDisp.word64 d1, [x1 + 0]
    arm64.fdiv d0, d0, d1
    arm64.fcmp d0, d0
    arm64.cset x1, eq
    arm64.cbnz x1, check
    arm64.b critsplit
  check:
    arm64.movImm x0, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
