// Test: eq-nan-else-edge-phi
var big = 1.0e308

function main() returns ExitCode
	var r = 7
	let inf = big * 10.0
	let nan = inf - inf
	if nan == nan 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 7
---
data {
  __data_big@0 = f64 1E+308
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.leaGlobal x1, __data_big
    arm64.loadRegBaseDisp.word64 d0, [x1 + 0]
    arm64.fpLoadRdata d1, [rdata + __fconst_10]
    arm64.fmul d0, d0, d1
    arm64.fsub d0, d0, d0
    arm64.fcmp d0, d0
    arm64.b.ne ifcont
  check:
    arm64.movImm x0, 1
  ifcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at eq-nan-else-edge-phi.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
