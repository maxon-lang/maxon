// Test: one-compare-two-branches-across-a-loop
typealias Num = int(i64.min to i64.max)

function classify(x Num, n Num) returns Num
	let small = x < 10
	var acc = 0
	if small 'first'
		acc = acc + 1
	end 'first'

	var i = 0
	while i < n 'loop'
		acc = acc + i
		i = i + 1
	end 'loop'

	if small 'second'
		acc = acc + 100
	end 'second'
	return acc
end 'classify'

function main() returns ExitCode
	return classify(3, n: 4)
end 'main'
---
ExitCode: 107
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b first
  first:
    arm64.movImm x0, 1
    arm64.b ifcont#7
  ifcont#7:
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 4
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.add x0, x0, x1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.b second
  second:
    arm64.add x0, x0, 100
    arm64.b ifcont#12
  ifcont#12:
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at one-compare-two-branches-across-a-loop.test:24: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
