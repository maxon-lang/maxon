// Test: le-boundary-equal
function main() returns ExitCode
	var r = 7
	let x = 4.25
	let y = 4.25
	if x <= y 'check'
		r = 1
	end 'check'
	return r
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.cset x1, ls
    arm64.cbnz x1, check
    arm64.b critsplit
  check:
    arm64.movImm x0, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.epilogue 16
    arm64.ret
}
