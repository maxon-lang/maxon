// Test: from-literal-contains
function main() returns ExitCode
	let s = Set from ["apple", "banana", "cherry"]
	if not s.contains("banana") 'miss'
		return 1
	end 'miss'
	if s.contains("durian") 'phantom'
		return 2
	end 'phantom'
	return 0
end 'main'
