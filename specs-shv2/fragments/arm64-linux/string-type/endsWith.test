// Test: endsWith
function main() returns ExitCode
	let s = "hello world"
	if s.endsWith("world") 'c1'
		print("1\n")
	end 'c1'
	if s.endsWith("hello") 'c2'
		print("0\n")
	end 'c2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_5  ; "hello world"
    arm64.leaRdata x1, __str_rec_6  ; "world"
    arm64.movRegReg x0, x19
    arm64.bl String.endsWith
    arm64.cbz x0, ifcont#2
  c1:
    arm64.leaRdata x0, __str_rec_7  ; "1\x0a"
    arm64.bl print
  ifcont#2:
    arm64.leaRdata x1, __str_rec_8  ; "hello"
    arm64.movRegReg x0, x19
    arm64.bl String.endsWith
    arm64.cbz x0, ifcont#4
  c2:
    arm64.leaRdata x0, __str_rec_9  ; "0\x0a"
    arm64.bl print
  ifcont#4:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
