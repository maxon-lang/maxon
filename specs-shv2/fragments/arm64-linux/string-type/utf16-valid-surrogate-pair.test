// Test: utf16-valid-surrogate-pair
function main() returns ExitCode
	if utf16IsValidSurrogatePair(55357, low: 56832) 'c14'
		print("1\n")  // valid pair
	end 'c14'
	if utf16IsValidSurrogatePair(56832, low: 55357) 'c15'
		print("0\n")  // reversed
	end 'c15'
	if utf16IsValidSurrogatePair(65, low: 66) 'c16'
		print("0\n")        // not surrogates
	end 'c16'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 55357
    arm64.movImm x1, 56832
    arm64.bl utf16IsValidSurrogatePair
    arm64.cbz x0, ifcont#2
  c14:
    arm64.leaRdata x0, __str_rec_2  ; "1\x0a"
    arm64.bl print
  ifcont#2:
    arm64.movImm x0, 56832
    arm64.movImm x1, 55357
    arm64.bl utf16IsValidSurrogatePair
    arm64.cbz x0, ifcont#4
  c15:
    arm64.leaRdata x0, __str_rec_3  ; "0\x0a"
    arm64.bl print
  ifcont#4:
    arm64.movImm x0, 65
    arm64.movImm x1, 66
    arm64.bl utf16IsValidSurrogatePair
    arm64.cbz x0, ifcont#6
  c16:
    arm64.leaRdata x0, __str_rec_3  ; "0\x0a"
    arm64.bl print
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
