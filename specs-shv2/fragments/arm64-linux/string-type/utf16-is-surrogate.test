// Test: utf16-is-surrogate
function main() returns ExitCode
	if utf16IsSurrogate(55357) 'c7'
		print("1\n")
	end 'c7'
	if utf16IsSurrogate(56832) 'c8'
		print("2\n")
	end 'c8'
	if utf16IsSurrogate(65) 'c9'
		print("0\n")
	end 'c9'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#8
  __il_body#8:
    arm64.b __rc_chk#12
  __rc_chk#12:
    arm64.b __rc_ok#11
  __rc_ok#11:
    arm64.b andrhs#9
  andrhs#9:
    arm64.movImm x0, 1
    arm64.b scmerge#10
  scmerge#10:
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cbnz x0, c7
    arm64.b ifcont#2
  c7:
    arm64.leaRdata x0, __str_rec_3  ; "1\x0a"
    arm64.bl print
    arm64.b ifcont#2
  ifcont#2:
    arm64.b __il_body#15
  __il_body#15:
    arm64.b __rc_chk#19
  __rc_chk#19:
    arm64.b __rc_ok#18
  __rc_ok#18:
    arm64.b andrhs#16
  andrhs#16:
    arm64.movImm x0, 1
    arm64.b scmerge#17
  scmerge#17:
    arm64.b __il_cont#14
  __il_cont#14:
    arm64.cbnz x0, c8
    arm64.b ifcont#4
  c8:
    arm64.leaRdata x0, __str_rec_4  ; "2\x0a"
    arm64.bl print
    arm64.b ifcont#4
  ifcont#4:
    arm64.b __il_body#22
  __il_body#22:
    arm64.b __rc_chk#26
  __rc_chk#26:
    arm64.b __rc_ok#25
  __rc_ok#25:
    arm64.movImm x0, 0
    arm64.b scmerge#24
  scmerge#24:
    arm64.b __il_cont#21
  __il_cont#21:
    arm64.cbnz x0, c9
    arm64.b ifcont#6
  c9:
    arm64.leaRdata x0, __str_rec_5  ; "0\x0a"
    arm64.bl print
    arm64.b ifcont#6
  ifcont#6:
