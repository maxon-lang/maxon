// Test: dispatch.sparse-hits-misses
typealias N = int(i64.min to i64.max)

function sparse(x N) returns N
	return match x 'c'
		10 gives 1
		20 gives 2
		30 gives 3
		40 gives 4
		50 gives 5
		default gives 9
	end 'c'
end 'sparse'

function main() returns ExitCode
	var n = 0 as N
	if sparse(10) == 1 'h1' n = n + 1 end 'h1'
	if sparse(30) == 3 'h3' n = n + 1 end 'h3'
	if sparse(50) == 5 'h5' n = n + 1 end 'h5'
	if sparse(25) == 9 'm1' n = n + 1 end 'm1'
	if sparse(35) == 9 'm2' n = n + 1 end 'm2'
	if sparse(9) == 9 'o1' n = n + 1 end 'o1'
	if sparse(11) == 9 'o2' n = n + 1 end 'o2'
	if sparse(51) == 9 'o3' n = n + 1 end 'o3'
	return n as ExitCode
end 'main'
---
ExitCode: 8
---
func @sparse {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 30
    arm64.cset x1, lt
    arm64.cbnz x1, matchlo
    arm64.b matchhi
  matchlo:
    arm64.cmp x0, 10
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 20
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchhi:
    arm64.cmp x0, 30
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 3
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 40
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 4
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 50
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.movImm x0, 5
    arm64.b matchcont
  matchdefault:
    arm64.movImm x0, 9
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 10
    arm64.bl sparse
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, h1
    arm64.b critsplit
  h1:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 30
    arm64.bl sparse
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, h3
    arm64.b critsplit
  h3:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 50
    arm64.bl sparse
    arm64.cmp x0, 5
    arm64.cset x0, eq
    arm64.cbnz x0, h5
    arm64.b critsplit
  h5:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 25
    arm64.bl sparse
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, m1
    arm64.b critsplit
  m1:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 35
    arm64.bl sparse
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, m2
    arm64.b critsplit
  m2:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 9
    arm64.bl sparse
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, o1
    arm64.b critsplit
  o1:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 11
    arm64.bl sparse
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, o2
    arm64.b critsplit
  o2:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 51
    arm64.bl sparse
    arm64.cmp x0, 9
    arm64.cset x0, eq
    arm64.cbnz x0, o3
    arm64.b critsplit
  o3:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
