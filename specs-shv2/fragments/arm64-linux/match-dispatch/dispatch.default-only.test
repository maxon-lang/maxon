// Test: dispatch.default-only
typealias N = int(0 to 100)

function only(x N) returns N
	return match x 'c'
		default gives 7
	end 'c'
end 'only'

function main() returns ExitCode
	var n = 0 as N
	if only(5) == 7 'a'
		n = n + 1
	end 'a'
	if only(0) == 7 'b'
		n = n + 1
	end 'b'
	return n as ExitCode
end 'main'
---
ExitCode: 2
---
