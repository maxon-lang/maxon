// Test: dispatch.upto-exclusive-boundary
function classify(x int) returns int
	return match x 'm'
		10 upto 20 gives 1
		20 upto 30 gives 2
		30 gives 3
		default gives 0
	end 'm'
end 'classify'

function main() returns ExitCode
	// `upto` excludes its upper: 10..20 covers 10..19, 20..30 covers 20..29, and 30 is its own arm.
	var n = 0 as ExitCode
	if classify(19) == 1 'a' n = n + 1 end 'a'
	if classify(20) == 2 'b' n = n + 1 end 'b'
	if classify(29) == 2 'c' n = n + 1 end 'c'
	if classify(30) == 3 'd' n = n + 1 end 'd'
	if classify(9) == 0 'e' n = n + 1 end 'e'
	return n
end 'main'
---
ExitCode: 5
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 10
    arm64.cset x1, ge
    arm64.cmp x0, 19
    arm64.cset x2, le
    arm64.and x1, x1, x2
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 20
    arm64.cset x1, ge
    arm64.cmp x0, 29
    arm64.cset x2, le
    arm64.and x1, x1, x2
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 30
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.movImm x0, 3
    arm64.b matchcont
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 19
    arm64.bl classify
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 20
    arm64.bl classify
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 29
    arm64.bl classify
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, c
    arm64.b critsplit
  c:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 30
    arm64.bl classify
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, d
    arm64.b critsplit
  d:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 9
    arm64.bl classify
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, e
    arm64.b critsplit
  e:
    arm64.add x0, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
