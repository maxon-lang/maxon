// Test: ceil.positive
function main() returns ExitCode
	let x = 3.1
	let y = trunc(ceil(x))
	return y
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
