// Test: ceil.positive
function main() returns ExitCode
	let x = 3.1
	let y = trunc(ceil(x))
	return y
end 'main'
---
ExitCode: 4
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.frintp d0, d0
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
