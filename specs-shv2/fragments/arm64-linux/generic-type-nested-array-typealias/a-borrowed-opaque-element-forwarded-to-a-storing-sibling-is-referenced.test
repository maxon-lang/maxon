    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x2, __layout_GHolder_String
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl GHolder.seed
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x20, 100
    arm64.b.hs whileexit
  relayMany:
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_GHolder_String
    arm64.movRegReg x0, x19
    arm64.bl GHolder.relay
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.leaRdata x0, __str_rec_5  ; "spare "
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
