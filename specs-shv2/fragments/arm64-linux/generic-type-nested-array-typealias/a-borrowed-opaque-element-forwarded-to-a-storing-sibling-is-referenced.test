// Test: a-borrowed-opaque-element-forwarded-to-a-storing-sibling-is-referenced
typealias ExitCode = int(0 to 125)
typealias Idx = int(0 to u64.max)

type GHolder uses T
	typealias TArray = Array with T

	export var items as TArray
	export var spare as TArray

	export static function create() returns Self
		return Self{ items: TArray.create(), spare: TArray.create() }
	end 'create'

	export function seed(s T)
		items.push(s)
	end 'seed'

	function stash(v T)
		spare.push(v)
	end 'stash'

	export function relay(i Idx)
		stash(try items.get(i) otherwise panic("out of range"))
	end 'relay'

	export function spareCount() returns Idx
		return spare.count()
	end 'spareCount'
end 'GHolder'

typealias StringHolder = GHolder with String

function main() returns ExitCode
	var h = StringHolder.create()
	h.seed("a value long enough to force a heap allocation")
	var n = 0 as Idx
	while n < 100 'relayMany'
		h.relay(0)
		n = n + 1
	end 'relayMany'
	print("spare {h.spareCount()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @GHolder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.loadRegBaseDisp.word64 x1, [x19 + 40]
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 8
    arm64.loadRegBaseDisp.word64 x1, [x19 + 40]
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @GHolder.seed {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __managed_push
    arm64.epilogue 16
    arm64.ret
}

func @GHolder.stash {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl __managed_push
    arm64.epilogue 16
    arm64.ret
}

func @GHolder.relay {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x2
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x1, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_7  ; "panic at a-borrowed-opaque-element-forwarded-to-a-storing-sibling-is-referenced.test:24: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 24]
    arm64.cmp x2, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.hs __im_slow
  __im_load#11:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.arm64AddLsl x2, x2, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x2, [x2 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x2, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x1, x2
    arm64.b.hs __im_slow
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, x1
    arm64.loadRegBaseDisp.byte x2, [x2 + 0]
  __im_loaded:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x0 + 40]
    arm64.cmp x4, 0
    arm64.b.eq critsplit#14
  __im_empty:
    arm64.cmp x2, 0
    arm64.b.eq __im_slow
  critsplit#15:
    arm64.movRegReg x1, x2
    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x1, x2
    arm64.b __im_cont
  __im_slow:
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.movRegReg x3, x9
  __im_cont:
    arm64.cmp x3, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-borrowed-opaque-element-forwarded-to-a-storing-sibling-is-referenced.test:24: out of range\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __retain_type_param
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x2, x20
    arm64.bl GHolder.stash
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
