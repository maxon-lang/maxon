// Test: union-reassign-to-other-borrowed-param
typealias Integer = int(i64.min to i64.max)

union Num
	none
	val(v Integer)
end 'Num'

function pick(u Num, u2 Num, c Integer) returns Integer
	var q = u
	if c > 0 'b'
		q = u2
	end 'b'
	return match q 'm'
		none gives 0
		val(v) gives v
	end 'm'
end 'pick'

function main() returns ExitCode
	let a = Num.val(5)
	let b = Num.val(8)
	return pick(a, u2: b, c: 1) + pick(a, u2: b, c: 0)
end 'main'
---
ExitCode: 13
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pick {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.movRegReg x20, x2
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.cmp x20, 0
    arm64.cset x0, gt
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x21
    arm64.b ifcont
  ifcont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#3
    arm64.b matchnext
  matcharm#3:
    arm64.movImm x19, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#4
    arm64.b matchdead
  matcharm#4:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.b matchcont
  matchcont:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 5
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movImm x19, 8
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x19
    arm64.movImm x2, 1
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.movImm x2, 0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl pick
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at union-reassign-to-other-borrowed-param.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
