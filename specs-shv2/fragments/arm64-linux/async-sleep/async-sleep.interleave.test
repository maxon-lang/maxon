  __sched_midle@184 = i64 0
  __sched_pidle@192 = i64 0
  __sched_num_procs@200 = i64 0
  __sched_shutdown_flag@208 = i64 0
  __sched_lock@216 = i64 0
  __sched_nmspinning@224 = i64 0
  __sched_parked_drivers@232 = i64 0
  __sched_sysmon_started@240 = i64 0
  __mrt_errno@248 = i64 0
  __mrt_envp@256 = i64 0
  __mrt_tls_next_key@264 = i64 0
  __slab_arena_list@272 = i64 0
  __slab_arena_map_l1@280 = i64 0
  __slab_state@288 = i64 0
}

func @slow {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.bl sleep
    arm64.leaGlobal x0, __data_order
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_order
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @fast {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.bl sleep
    arm64.leaGlobal x0, __data_order
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 10
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 2
    arm64.leaGlobal x1, __data_order
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, slow
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.leaFuncAddr x0, fast
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl __gt_await
    arm64.movRegReg x0, x20
    arm64.bl __gt_await
    arm64.leaGlobal x0, __data_order
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at async-sleep.interleave.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
