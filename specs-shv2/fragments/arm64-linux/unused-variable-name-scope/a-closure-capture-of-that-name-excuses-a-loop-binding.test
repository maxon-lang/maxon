// Test: a-closure-capture-of-that-name-excuses-a-loop-binding
function main() returns ExitCode
	let i = 5
	let f = function() gives i + 1
	var total = f()
	for i in 0 upto 3 'a'
		total = total + 1
	end 'a'
	return total
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
