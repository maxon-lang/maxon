    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Cfg.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext#4
  matcharm#1:
    arm64.movImm x20, 0
    arm64.b matchcont#5
  matchnext#4:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchdead#3
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x21, [x20 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x20, x21
    arm64.b matchcont#5
  matchcont#5:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
