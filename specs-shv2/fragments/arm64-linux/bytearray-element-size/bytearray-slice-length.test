// Test: bytearray-slice-length
function main() returns ExitCode
	let src = "hello world"
	let bytes = src.toByteArray()
	var out = ByteArray.create()
	for b in bytes 'copy'
		out.push(b)
	end 'copy'
	let rebuilt = String.from(out)
	return 0 if rebuilt == "hello world" else 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1  ; "hello world"
    arm64.bl String.toByteArray
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.b.ge forexit
  copy:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.arm64AddLsl x0, x0, x21, lsl #3
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.b __im_cont
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, x21
    arm64.loadRegBaseDisp.byte x1, [x0 + 0]
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_get_unchecked
    arm64.movRegReg x1, x0
  __im_cont:
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.bl String.from
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __str_rec_1  ; "hello world"
    arm64.movRegReg x0, x21
    arm64.bl __str_eq
    arm64.cbz x0, ternaryfalse
  ternarytrue:
    arm64.movImm x22, 0
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x22, 1
  matchcont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x22, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x22, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at bytearray-slice-length.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
