// Test: range-check-panic.return-of-a-second-ranged-parameter-is-covered-by-its-entry-guard
typealias SmallInt = int(0 to 10)

function pick(_ SmallInt, b SmallInt) returns SmallInt
  return b
end 'pick'

function main() returns ExitCode
  return pick(1, b: 7)
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.b __il_body
  __il_body:
    arm64.b __rc_chk#4
  __rc_chk#4:
    arm64.b __rc_ok#3
  __rc_ok#3:
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.b __rc_ok#5
  __rc_ok#5:
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
