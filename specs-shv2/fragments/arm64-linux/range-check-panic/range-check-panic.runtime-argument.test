// Test: range-check-panic.runtime-argument
typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function divide(a Integer, by NonZero) returns Integer
  return a / by
end 'divide'

function main() returns ExitCode
  return divide(10, by: opaque(0))
end 'main'
---
ExitCode: 1
---
func @divide {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 1
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at range-check-panic.runtime-argument.test:9: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.sdiv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 0
  __il_cont:
    arm64.bl divide
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at range-check-panic.runtime-argument.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
