// Test: range-check-panic.an-uncontained-return-is-still-guarded
typealias Integer = int(i64.min to i64.max)
typealias Wide = int(0 to 1000)
typealias Narrow = int(0 to 100)

function opaque(n Integer) returns Integer
  return n
end 'opaque'

function widen() returns Wide
  return opaque(101)
end 'widen'

function narrow() returns Narrow
  return widen()
end 'narrow'

function main() returns ExitCode
  return narrow()
end 'main'
---
ExitCode: 1
---
func @widen {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 101
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @narrow {
  entry:
    arm64.prologue 16
    arm64.bl widen
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 100
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at range-check-panic.an-uncontained-return-is-still-guarded.test:15: Range check failed: value outside typealias 'Narrow'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl narrow
    arm64.epilogue 16
    arm64.ret
}
