// Test: extension-with-substitution-dependent-closure
typealias Integer = int(i64.min to i64.max)

interface Tagger
	function tag() returns Integer
end 'Tagger'

extension Tagger
	export function callTag() returns Integer
		let inner = function() gives tag() * 2
		return inner()
	end 'callTag'
end 'Tagger'

type Three implements Tagger
	export static function make() returns Self
		return Self{}
	end 'make'
	export function tag() returns Integer
		return 3
	end 'tag'
end 'Three'

type Seven implements Tagger
	export static function make() returns Self
		return Self{}
	end 'make'
	export function tag() returns Integer
		return 7
	end 'tag'
end 'Seven'

function main() returns ExitCode
	let a = Three.make()
	let b = Seven.make()
	let sum = a.callTag() + b.callTag()
	return sum
end 'main'
---
ExitCode: 20
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Three.callTag {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaFuncAddr x20, Three.callTag$closure_0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x21
    arm64.blr x20
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Three.callTag$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  __il_body:
    arm64.movImm x0, 3
  __il_cont:
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @Seven.callTag {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaFuncAddr x20, Seven.callTag$closure_0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x21
    arm64.blr x20
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Seven.callTag$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  __il_body:
    arm64.movImm x0, 7
  __il_cont:
    arm64.lsl x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @Three.make {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.epilogue 16
    arm64.ret
}

func @Seven.make {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Three.make
    arm64.movRegReg x19, x0
    arm64.bl Seven.make
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl Three.callTag
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl Seven.callTag
    arm64.add x21, x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at extension-with-substitution-dependent-closure.test:37: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
