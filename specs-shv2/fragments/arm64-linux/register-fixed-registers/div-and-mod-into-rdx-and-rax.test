// Test: div-and-mod-into-rdx-and-rax
function take3(p1 Integer, p2 Integer, p3 Integer) returns Integer
	return p1 * 10000 + p2 * 100 + p3
end 'take3'

function main() returns ExitCode
	let n = 97
	let d = 5
	let r = take3(1, p2: n / d, p3: n mod d)
	if r == 11902 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 97
    arm64.movImm x1, 7378697629483820647
    arm64.smulh x1, x1, x0
    arm64.asr x1, x1, 1
    arm64.lsr x2, x1, 63
    arm64.add x1, x1, x2
    arm64.movImm x2, 7378697629483820647
    arm64.smulh x2, x2, x0
    arm64.asr x2, x2, 1
    arm64.lsr x3, x2, 63
    arm64.add x2, x2, x3
    arm64.movImm x16, 5
    arm64.mul x2, x2, x16
    arm64.sub x0, x0, x2
  __il_body:
    arm64.movImm x16, 100
    arm64.mul x1, x1, x16
    arm64.add x1, x1, 10000
    arm64.add x0, x1, x0
  __il_cont:
    arm64.movImm x16, 11902
    arm64.cmp x0, x16
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
