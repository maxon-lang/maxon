// Test: six-div-results-into-six-arg-slots
function digits6(p1 Integer, p2 Integer, p3 Integer, p4 Integer, p5 Integer, p6 Integer) returns Integer
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function main() returns ExitCode
	let n1 = 100
	let n2 = 45
	let n3 = 23
	let d1 = 12
	let d2 = 7
	let d3 = 9
	let r = digits6(n1 / d1, p2: n1 mod d1, p3: n2 / d2, p4: n2 mod d2, p5: n3 / d3, p6: n3 mod d3)
	if r == 846325 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 45
    arm64.movImm x2, 23
    arm64.movImm x3, 3074457345618258603
    arm64.smulh x3, x3, x0
    arm64.asr x3, x3, 1
    arm64.lsr x4, x3, 63
    arm64.add x3, x3, x4
    arm64.movImm x4, 3074457345618258603
    arm64.smulh x4, x4, x0
    arm64.asr x4, x4, 1
    arm64.lsr x5, x4, 63
    arm64.add x4, x4, x5
    arm64.movImm x16, 12
    arm64.mul x4, x4, x16
    arm64.sub x0, x0, x4
    arm64.movImm x4, 5270498306774157605
    arm64.smulh x4, x4, x1
    arm64.asr x4, x4, 1
    arm64.lsr x5, x4, 63
    arm64.add x4, x4, x5
    arm64.movImm x5, 5270498306774157605
    arm64.smulh x5, x5, x1
    arm64.asr x5, x5, 1
    arm64.lsr x6, x5, 63
    arm64.add x5, x5, x6
    arm64.movImm x16, 7
    arm64.mul x5, x5, x16
    arm64.sub x1, x1, x5
    arm64.movImm x5, 2049638230412172402
    arm64.smulh x5, x5, x2
    arm64.lsr x6, x5, 63
    arm64.add x5, x5, x6
    arm64.movImm x6, 2049638230412172402
    arm64.smulh x6, x6, x2
    arm64.lsr x7, x6, 63
    arm64.add x6, x6, x7
    arm64.movImm x16, 9
    arm64.mul x6, x6, x16
    arm64.sub x2, x2, x6
  __il_body:
    arm64.movImm x16, 100000
    arm64.mul x3, x3, x16
    arm64.movImm x16, 10000
    arm64.mul x0, x0, x16
    arm64.add x0, x3, x0
    arm64.movImm x16, 1000
    arm64.mul x3, x4, x16
    arm64.add x0, x0, x3
    arm64.movImm x16, 100
    arm64.mul x1, x1, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 10
    arm64.mul x1, x5, x16
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
  __il_cont:
    arm64.movImm x16, 846325
    arm64.cmp x0, x16
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
