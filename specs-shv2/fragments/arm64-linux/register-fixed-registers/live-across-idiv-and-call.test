// Test: live-across-idiv-and-call
function sink(x Integer) returns Integer
	return x + 1
end 'sink'

function f(p Integer) returns Integer
	let a = p + 100
	let q = a / 7
	let s = sink(3)
	return a + q + s
end 'f'

function main() returns ExitCode
	let v = f(0)
	if v == 118 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @f {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 100
    arm64.movImm x1, 7
    arm64.sdiv x1, x0, x1
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, x1
    arm64.add x0, x0, 4
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl f
    arm64.cmp x0, 118
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
