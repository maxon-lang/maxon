// Test: divide-by-self
function main() returns ExitCode
	let x = 37
	let q = x / x
	let m = x mod x
	let r = x * 100 + q * 10 + m
	if r == 3710 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 37
    arm64.sdiv x1, x0, x0
    arm64.sdiv x16, x0, x0
    arm64.msub x0, x16, x0, x0
    arm64.movImm x16, 10
    arm64.mul x1, x1, x16
    arm64.add x1, x1, 3700
    arm64.add x0, x1, x0
    arm64.cmp x0, 3710
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
