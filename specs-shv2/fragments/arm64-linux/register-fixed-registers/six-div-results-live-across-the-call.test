// Test: six-div-results-live-across-the-call
typealias Positive = int(1 to i64.max)

function digits6(p1 Integer, p2 Integer, p3 Integer, p4 Integer, p5 Integer, p6 Integer) returns Integer
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function divsAcross(p Integer) returns Integer
	let n1 = p + 100
	let n2 = p + 45
	let n3 = p + 23
	let d1 = (p + 12) as Positive
	let d2 = (p + 7) as Positive
	let d3 = (p + 9) as Positive
	let q1 = n1 / d1
	let q2 = n1 mod d1
	let q3 = n2 / d2
	let q4 = n2 mod d2
	let q5 = n3 / d3
	let q6 = n3 mod d3
	let r = digits6(q1, p2: q2, p3: q3, p4: q4, p5: q5, p6: q6)
	return r + q1 * 100000 + q2 * 10000 + q3 * 1000 + q4 * 100 + q5 * 10 + q6
end 'divsAcross'

function main() returns ExitCode
	let v = divsAcross(0)
	if v == 1692650 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @divsAcross {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 100
    arm64.add x2, x0, 45
    arm64.add x3, x0, 23
    arm64.add x4, x0, 12
    arm64.cmp x4, 1
    arm64.b.ge __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at six-div-results-live-across-the-call.test:12: Range check failed: value outside typealias 'Positive'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.add x5, x0, 7
    arm64.cmp x5, 1
    arm64.b.ge __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at six-div-results-live-across-the-call.test:13: Range check failed: value outside typealias 'Positive'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#3:
    arm64.add x0, x0, 9
    arm64.cmp x0, 1
    arm64.b.ge __rc_ok#5
  __rc_panic#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at six-div-results-live-across-the-call.test:14: Range check failed: value outside typealias 'Positive'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#5:
    arm64.sdiv x6, x1, x4
    arm64.sdiv x16, x1, x4
    arm64.msub x1, x16, x4, x1
    arm64.sdiv x4, x2, x5
    arm64.sdiv x16, x2, x5
    arm64.msub x2, x16, x5, x2
    arm64.sdiv x5, x3, x0
    arm64.sdiv x16, x3, x0
    arm64.msub x0, x16, x0, x3
  __il_body:
    arm64.movImm x16, 100000
    arm64.mul x3, x6, x16
    arm64.movImm x16, 10000
    arm64.mul x1, x1, x16
    arm64.add x6, x3, x1
    arm64.movImm x16, 1000
    arm64.mul x4, x4, x16
    arm64.add x6, x6, x4
    arm64.movImm x16, 100
    arm64.mul x2, x2, x16
    arm64.add x6, x6, x2
    arm64.movImm x16, 10
    arm64.mul x5, x5, x16
    arm64.add x6, x6, x5
    arm64.add x6, x6, x0
  __il_cont:
    arm64.add x3, x6, x3
    arm64.add x1, x3, x1
    arm64.add x1, x1, x4
    arm64.add x1, x1, x2
    arm64.add x1, x1, x5
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl divsAcross
    arm64.movImm x16, 1692650
    arm64.cmp x0, x16
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
