// Test: assign-ranged-typealias

typealias Score = int(0 to 100)

function main() returns ExitCode
	var s = 0 as Score
	s = 5
	s = s + 20
	return s
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 25
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
