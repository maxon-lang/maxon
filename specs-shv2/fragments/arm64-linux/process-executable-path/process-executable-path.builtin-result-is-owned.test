// Test: process-executable-path.builtin-result-is-owned
function main() returns ExitCode
	var seen = 0
	var i = 0
	while i < 50 'reads'
		let mm = __Builtins.executablePath()
		if mm.length() > 0 'nonEmpty'
			seen = seen + 1
		end 'nonEmpty'
		i = i + 1
	end 'reads'
	if seen == 50 'allFifty'
		return 6
	end 'allFifty'
	return 1
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x20, 50
    arm64.b.ge whileexit
  reads:
    arm64.bl __proc_exe_path
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.b.le ifcont#5
  nonEmpty:
    arm64.add x19, x19, 1
  ifcont#5:
    arm64.add x20, x20, 1
    arm64.bl __managed_decref
    arm64.b whilehdr
  whileexit:
    arm64.cmp x19, 50
    arm64.b.ne ifcont#7
  allFifty:
    arm64.movImm x0, 6
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#7:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
