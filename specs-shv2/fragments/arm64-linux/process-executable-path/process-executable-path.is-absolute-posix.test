// Test: process-executable-path.is-absolute-posix
function main() returns ExitCode
	let exe = try Process.executablePath() otherwise return 2
	var score = 0
	if exe.path.byteLength() > 1 'longerThanTheRoot'
		score = score + 1
	end 'longerThanTheRoot'
	if exe.path.startsWith("/") 'rootQualified'
		score = score + 2
	end 'rootQualified'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Process.executablePath
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 2
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.movImm x20, 0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.b.ge __rc_ok#12
  __il_slow:
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok#12:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.cmp x0, 1
    arm64.b.le ifcont#4
  longerThanTheRoot:
    arm64.movImm x20, 1
  ifcont#4:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.leaRdata x1, __str_rec_16  ; "/"
    arm64.bl String.startsWith
    arm64.cbz x0, ifcont#6
  rootQualified:
    arm64.add x20, x20, 2
  ifcont#6:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok#7
  __rc_panic:
    arm64.leaRdata x0, __str_blob_84  ; "panic at process-executable-path.is-absolute-posix.test:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#7:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
