// Test: match-break.every-arm-breaks
typealias Count = int(0 to 1000)

function pick(k Count) returns Count
	let r = 7
	match k 'check'
		1 then break
		2 then break
		default then break
	end 'check'
	return r + 1
end 'pick'

function main() returns ExitCode
	return pick(1) + pick(2) + pick(5) - 16
end 'main'
---
ExitCode: 8
---
