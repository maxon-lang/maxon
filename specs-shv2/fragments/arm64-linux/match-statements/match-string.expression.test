// Test: match-string.expression
function main() returns ExitCode
	let name = "bob"
	let code = match name 'lookup'
		"alice" gives 60
		"bob" gives 120
		default gives 0
	end 'lookup'
	return code
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "bob"
    arm64.leaRdata x1, __str_rec_3  ; "alice"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbnz x0, matcharm#1
    arm64.b matchnext#2
  matcharm#1:
    arm64.movImm x0, 60
    arm64.b matchcont
  matchnext#2:
    arm64.leaRdata x1, __str_rec_2  ; "bob"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchnext#4
  matcharm#3:
    arm64.movImm x0, 120
    arm64.b matchcont
  matchnext#4:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at match-string.expression.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
