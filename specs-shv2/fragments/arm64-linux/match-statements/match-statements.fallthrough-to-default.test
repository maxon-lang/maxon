// Test: match-statements.fallthrough-to-default
function main() returns ExitCode
	let x = 3
	var result = 0
	match x 'check'
		1 then result = 10
		2 then result = 20
		3 then result = result + 30 and fallthrough
		default then result = result + 90
	end 'check'
	return result
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.movImm x1, 0
    arm64.cmp x0, 1
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 10
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 20
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 3
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b critsplit
  matcharm:
    arm64.add x0, x1, 30
    arm64.b matchnext
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b matchnext
  matchnext:
    arm64.add x0, x0, 90
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
