// Test: match-break.inside-loop
function main() returns ExitCode
	var result = 0
	var i = 0
	while i < 5 'loop'
		match i 'check'
			3 then break 'loop'
			default then result = result + 1
		end 'check'
		i = i + 1
	end 'loop'
	return result
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 5
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b critsplit
  loop:
    arm64.cmp x1, 3
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.b whileexit
  matchdefault:
    arm64.add x0, x0, 1
    arm64.b matchcont
  matchcont:
    arm64.add x1, x1, 1
    arm64.b whilehdr
  critsplit:
    arm64.b whileexit
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-break.inside-loop.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
