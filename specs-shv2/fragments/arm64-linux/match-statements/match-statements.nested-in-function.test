// Test: match-statements.nested-in-function

typealias Integer = int(i64.min to i64.max)

function categorize(n Integer) returns Integer
	match n 'cat'
		1 or 2 or 3 then return 1
		4 or 5 or 6 then return 2
		default then return 0
	end 'cat'
end 'categorize'

function main() returns ExitCode
	return categorize(5)
end 'main'
---
ExitCode: 2
---
func @categorize {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cmp x0, 2
    arm64.cset x2, eq
    arm64.orr x1, x1, x2
    arm64.cmp x0, 3
    arm64.cset x2, eq
    arm64.orr x1, x1, x2
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x0, 4
    arm64.cset x1, eq
    arm64.cmp x0, 5
    arm64.cset x2, eq
    arm64.orr x1, x1, x2
    arm64.cmp x0, 6
    arm64.cset x0, eq
    arm64.orr x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchcont:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl categorize
    arm64.epilogue 16
    arm64.ret
}
