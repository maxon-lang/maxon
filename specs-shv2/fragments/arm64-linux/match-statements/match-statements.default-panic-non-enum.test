// Test: match-statements.default-panic-non-enum
typealias Integer = int(0 to 100)

function classify(x Integer) returns Integer
	return match x 'check'
		1 gives 10
		2 gives 20
		default panic("unexpected value")
	end 'check'
end 'classify'

function main() returns ExitCode
	let result = classify(2)
	if result == 20 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#7
  __rc_chk#8:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#6
  __rc_panic#7:
    arm64.leaRdata x0, __str_blob_1  ; "panic at match-statements.default-panic-non-enum.test:4: Range check failed: value outside typealias 'Integer'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#6:
    arm64.cmp x0, 1
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 10
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 2
    arm64.b.ne matchdefault
  matcharm#2:
    arm64.movImm x0, 20
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#10
  __rc_chk#11:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#9
  __rc_panic#10:
    arm64.leaRdata x0, __str_blob_2  ; "panic at match-statements.default-panic-non-enum.test:5: Range check failed: value outside typealias 'Integer'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#9:
    arm64.epilogue 16
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-statements.default-panic-non-enum.test:8: unexpected value\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.bl classify
    arm64.cmp x0, 20
    arm64.b.ne ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
