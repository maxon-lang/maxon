// Test: builtins-clock.ms-resolves-sub-tick
function main() returns ExitCode
	var smallest = 0
	var prev = __Builtins.currentTimeMs()
	var i = 0
	while i < 200000 'sample'
		let now = __Builtins.currentTimeMs()
		let delta = now - prev
		if delta > 0 'advanced'
			if smallest == 0 or delta < smallest 'newMin'
				smallest = delta
			end 'newMin'
			prev = now
		end 'advanced'
		i = i + 1
	end 'sample'
	if smallest > 0 and smallest < 5 'subTick'
		return 9
	end 'subTick'
	return 1
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __mrt_envp@160 = i64 0
  __mrt_tls_next_key@168 = i64 0
  __slab_arena_list@176 = i64 0
  __slab_arena_map_l1@184 = i64 0
  __slab_state@192 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.bl __gt_now_ns
    arm64.movImm x1, 1000000
    arm64.sdiv x20, x0, x1
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.movImm x16, 200000
    arm64.cmp x21, x16
    arm64.cset x0, lt
    arm64.cbnz x0, sample
    arm64.b whileexit
  sample:
    arm64.bl __gt_now_ns
    arm64.movImm x1, 1000000
    arm64.sdiv x0, x0, x1
    arm64.sub x1, x0, x20
    arm64.cmp x1, 0
    arm64.cset x2, gt
    arm64.cbnz x2, advanced
    arm64.b critsplit#14
  advanced:
    arm64.cmp x19, 0
    arm64.cset x2, eq
    arm64.movImm x3, 1
    arm64.cbnz x2, critsplit#16
    arm64.b orrhs
  critsplit#16:
    arm64.b scmerge#6
  orrhs:
    arm64.cmp x1, x19
    arm64.cset x2, lt
    arm64.movRegReg x3, x2
    arm64.b scmerge#6
  scmerge#6:
    arm64.cbnz x3, newMin
    arm64.b critsplit#17
  newMin:
    arm64.b ifcont#8
  critsplit#17:
    arm64.movRegReg x1, x19
    arm64.b ifcont#8
  ifcont#8:
    arm64.b ifcont#9
  critsplit#14:
    arm64.movRegReg x1, x19
    arm64.movRegReg x0, x20
    arm64.b ifcont#9
  ifcont#9:
    arm64.add x21, x21, 1
    arm64.movRegReg x19, x1
    arm64.movRegReg x20, x0
    arm64.b whilehdr
  whileexit:
    arm64.cmp x19, 0
    arm64.cset x0, gt
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit#15
  andrhs:
    arm64.cmp x19, 5
    arm64.cset x0, lt
    arm64.b scmerge#11
  critsplit#15:
    arm64.movRegReg x0, x1
    arm64.b scmerge#11
  scmerge#11:
    arm64.cbnz x0, subTick
    arm64.b ifcont#13
  subTick:
    arm64.movImm x0, 9
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#13:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
