  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_proc_wait_snapshot@96 = i64 0
  __gt_proc_poller@104 = i64 0
  __gt_live_count@112 = i64 0
  __sched_progress@120 = i64 0
  __sched_active_workers@128 = i64 1
  __sched_max_active_workers@136 = i64 1
  __sched_tls_index@144 = i64 0
  __sched_tls_teb_offset@152 = i64 0
  __sched_procs@160 = i64 0
  __sched_allm@168 = i64 0
  __sched_midle@176 = i64 0
  __sched_pidle@184 = i64 0
  __sched_num_procs@192 = i64 0
  __sched_shutdown_flag@200 = i64 0
  __sched_lock@208 = i64 0
  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __mrt_errno@232 = i64 0
  __mrt_envp@240 = i64 0
  __mrt_tls_next_key@248 = i64 0
  __slab_arena_list@256 = i64 0
  __slab_arena_map_l1@264 = i64 0
  __slab_state@272 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl __gt_now_ns
    arm64.movRegReg x19, x0
    arm64.bl __gt_now_ns
    arm64.movRegReg x20, x0
    arm64.bl __gt_now_ns
    arm64.movImm x1, 0
    arm64.cmp x20, x19
    arm64.cset x2, ge
    arm64.cbnz x2, nondecreasing1
    arm64.b critsplit#8
  nondecreasing1:
    arm64.movImm x1, 1
    arm64.b ifcont#2
  critsplit#8:
    arm64.b ifcont#2
  ifcont#2:
    arm64.cmp x0, x20
    arm64.cset x0, ge
    arm64.cbnz x0, nondecreasing2
    arm64.b critsplit#9
  nondecreasing2:
    arm64.add x0, x1, 1
    arm64.b ifcont#4
  critsplit#9:
    arm64.movRegReg x0, x1
    arm64.b ifcont#4
  ifcont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at builtins-clock.nanos-monotonic.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
