// Test: builtins-clock.nanos-advances
function main() returns ExitCode
	let start = __Builtins.currentTimeNanos()
	var spins = 0
	while spins < 200000 'burn'
		spins = spins + 1
	end 'burn'
	let elapsed = __Builtins.currentTimeNanos() - start
	if elapsed > 0 'advanced'
		return 7
	end 'advanced'
	return 1
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __mrt_envp@160 = i64 0
  __mrt_tls_next_key@168 = i64 0
  __slab_arena_list@176 = i64 0
  __slab_arena_map_l1@184 = i64 0
  __slab_state@192 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl __gt_now_ns
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.b whilehdr
  whilehdr:
    arm64.movImm x16, 200000
    arm64.cmp x0, x16
    arm64.cset x1, lt
    arm64.cbnz x1, burn
    arm64.b whileexit
  burn:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.bl __gt_now_ns
    arm64.sub x0, x0, x19
    arm64.cmp x0, 0
    arm64.cset x0, gt
    arm64.cbnz x0, advanced
    arm64.b ifcont
  advanced:
    arm64.movImm x0, 7
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
