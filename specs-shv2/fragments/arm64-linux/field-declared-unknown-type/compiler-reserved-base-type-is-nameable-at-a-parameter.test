// Test: compiler-reserved-base-type-is-nameable-at-a-parameter

typealias HitCount = int(0 to u64.max)

function countIn(s String, chars CharacterSet) returns HitCount
	var seen = 0
	for c in s 'scan'
		if chars.contains(c) 'hit'
			seen = seen + 1
		end 'hit'
	end 'scan'
	return seen
end 'countIn'

function main() returns ExitCode
	return countIn("a b c", chars: CharacterSet.whitespaces()) as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __data_CharacterSet.cachedWhitespaces@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @countIn {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x21, 0
    arm64.movImm x22, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x22, x0
    arm64.b.ge forexit
  scan:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl findGraphemeEnd
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl __char_at
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x22
    arm64.bl CharacterSet.contains
    arm64.cbz x0, ifcont
  hit:
    arm64.add x21, x21, 1
  ifcont:
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
  forstep:
    arm64.movRegReg x22, x23
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "a b c"
    arm64.bl CharacterSet.whitespaces
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl countIn
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_37  ; "panic at compiler-reserved-base-type-is-nameable-at-a-parameter.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.bl __destruct_CharacterSet
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
