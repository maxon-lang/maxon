// Test: string-double-iteration
function main() returns ExitCode
	let s = "Hello"
	var count1 = 0
	for _ in s 'loop1'
		count1 = count1 + 1
	end 'loop1'
	var count2 = 0
	for _ in s 'loop2'
		count2 = count2 + 1
	end 'loop2'
	if count1 == 5 and count2 == 5 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "Hello"
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr#1
  forhdr#1:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop1
    arm64.b forexit#4
  loop1:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl findGraphemeEnd
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __char_at
    arm64.add x20, x20, 1
    arm64.bl __str_decref
    arm64.b forstep#3
  forstep#3:
    arm64.movRegReg x21, x22
    arm64.b forhdr#1
  forexit#4:
    arm64.movImm x21, 0
    arm64.movImm x22, 0
    arm64.b forhdr#5
  forhdr#5:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x22, x0
    arm64.cset x0, lt
    arm64.cbnz x0, loop2
    arm64.b forexit#8
  loop2:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl findGraphemeEnd
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl __char_at
    arm64.add x21, x21, 1
    arm64.bl __str_decref
    arm64.b forstep#7
  forstep#7:
    arm64.movRegReg x22, x23
    arm64.b forhdr#5
  forexit#8:
    arm64.cmp x20, 5
    arm64.cset x0, eq
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.cmp x21, 5
    arm64.cset x0, eq
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.epilogue 64
    arm64.ret
}
