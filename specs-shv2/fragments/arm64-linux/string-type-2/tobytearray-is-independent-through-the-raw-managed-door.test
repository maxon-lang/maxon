// Test: tobytearray-is-independent-through-the-raw-managed-door
function main() returns ExitCode
	let who = "ello"
	let s = "H{who}"
	let arr = s.toByteArray()
	try arr.managed.set(0, 74) otherwise panic("set")
	let b0 = try arr.get(0) otherwise panic("get")
	print("s={s} arr[0]={b0}")
	return 0
end 'main'
