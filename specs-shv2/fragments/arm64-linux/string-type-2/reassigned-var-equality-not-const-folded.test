// Test: reassigned-var-equality-not-const-folded
function pick(useUnderscore bool) returns String
	if useUnderscore 'u'
		return "_"
	end 'u'
	return "x"
end 'pick'

function main() returns ExitCode
	var v = ""
	v = pick(true)
	if v == "_" 'match'
		print("1\n")
	end 'match' else 'no'
		print("0\n")
	end 'no'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pick {
  entry:
    arm64.prologue 16
    arm64.cbz x0, ifcont
  u:
    arm64.leaRdata x0, __str_rec_5  ; "_"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_6  ; "x"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_7  ; ""
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.add x22, x21, 56
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x22, x20
    arm64.storeBaseDispReg.word64 [x21 + 0], x22
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x21 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 24], x0
    arm64.movImm x0, 1
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.leaRdata x1, __str_rec_5  ; "_"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbz x0, ifelse
  match:
    arm64.leaRdata x0, __str_rec_8  ; "1\x0a"
    arm64.bl print
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_9  ; "0\x0a"
    arm64.bl print
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
