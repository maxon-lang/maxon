// Test: hot-loop-across-call
function sink(x Integer) returns Integer
	return x
end 'sink'

function hotCall(_ Integer) returns Integer
	var s1 = 1
	var s2 = 2
	var s3 = 3
	var s4 = 4
	var s5 = 5
	var i = 0
	while i < 5 'loop'
		let r = sink(i)
		s1 = s1 + r
		s2 = s2 + r
		s3 = s3 + r
		s4 = s4 + r
		s5 = s5 + r
		i = i + 1
	end 'loop'
	return s1 + s2 + s3 + s4 + s5
end 'hotCall'

function main() returns ExitCode
	return hotCall(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 65
---
func @hotCall {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x3, 4
    arm64.movImm x4, 5
    arm64.movImm x5, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x5, 5
    arm64.cset x6, lt
    arm64.cbnz x6, loop
    arm64.b whileexit
  loop:
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, x5
    arm64.add x1, x1, x5
    arm64.add x2, x2, x5
    arm64.add x3, x3, x5
    arm64.add x4, x4, x5
    arm64.add x5, x5, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x3
    arm64.add x0, x0, x4
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl hotCall
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at hot-loop-across-call.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
