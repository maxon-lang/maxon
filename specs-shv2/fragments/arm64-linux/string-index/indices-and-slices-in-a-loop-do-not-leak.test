    arm64.b tryok
  tryerr:
    arm64.movRegReg x0, x21
    arm64.bl String.endIndex
    arm64.movRegReg x22, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x22, x0
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x0, [x22 + 0]
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x21
    arm64.bl String.startIndex
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x22
    arm64.bl String.slice
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __il_slow
    arm64.b __rc_ok
  __il_slow:
    arm64.movRegReg x0, x21
