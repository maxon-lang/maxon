// Test: an-index-inside-a-type-method
type Label
	var text as String

	export static function create(t String) returns Label
		return Label{text: t}
	end 'create'

	export function head() returns String
		return text.slice(text.startIndex(), length: 2)
	end 'head'

	export function width() returns Integer
		let last = text.endIndex()
		return last.charIndex()
	end 'width'

	export function upTo(needle String) returns String
		let hit = try text.findFirst(needle) otherwise text.endIndex()
		return text.slice(text.startIndex(), endIndex: hit)
	end 'upTo'
end 'Label'

function main() returns ExitCode
	var l = Label.create("aébcdé")
	let needle = "cd"
	print("{l.head()} {l.width()} {l.upTo(needle)}\n")
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Label.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Label.head {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl String.startIndex
    arm64.movRegReg x20, x0
    arm64.movImm x2, 2
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl String.slice#StringIndex#GraphemeCount
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Label.width {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
