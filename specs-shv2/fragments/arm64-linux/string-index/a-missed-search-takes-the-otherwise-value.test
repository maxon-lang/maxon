// Test: a-missed-search-takes-the-otherwise-value
function main() returns ExitCode
	let s = "hello world"
	let missed = try s.findFirst("zzz") otherwise s.endIndex()
	if missed == s.endIndex() 'threw'
		print("threw\n")
	end 'threw' else 'found'
		print("DID NOT throw\n")
	end 'found'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_4  ; "hello world"
    arm64.leaRdata x1, __str_rec_5  ; "zzz"
    arm64.movRegReg x0, x19
    arm64.bl String.findFirst
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movRegReg x0, x19
    arm64.bl String.endIndex
    arm64.movRegReg x20, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl String.endIndex
    arm64.loadRegBaseDisp.word64 x1, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.cmp x1, x2
    arm64.cset x19, eq
    arm64.bl __mm_decref
    arm64.cbnz x19, threw
    arm64.b ifelse
  threw:
    arm64.leaRdata x0, __str_rec_6  ; "threw\x0a"
    arm64.bl print
    arm64.b ifcont
  ifelse:
    arm64.leaRdata x0, __str_rec_7  ; "DID NOT throw\x0a"
    arm64.bl print
    arm64.b ifcont
  ifcont:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
