// Test: forin-over-module-storage
typealias Integer = int(i64.min to i64.max)

var g = ["hello world this is a long string for heap allocation"]

function main() returns ExitCode
	var total = 0 as Integer
	for it in g 'scan'
		g.clear()
		total = total + it.byteLength()
	end 'scan'
	print("{total}\n")
	return 0
end 'main'
---
CompilerError:
error E3070: <fragment>:9:5: cannot mutate 'g' via 'clear' while it is borrowed by 'it' (borrowed at line 8)
