    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 1
    arm64.bl Task.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 2
    arm64.bl Task.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x20, 0
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, x1
    arm64.cset x3, lt
    arm64.cbnz x3, loop
    arm64.b forexit
  loop:
    arm64.arm64AddLsl x3, x2, x0, lsl #3
    arm64.loadRegBaseDisp.word64 x3, [x3 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.loadRegBaseDisp.word64 x3, [x3 + 0]
    arm64.cmp x3, 0
