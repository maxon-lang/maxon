    arm64.add x1, x1, x24
    arm64.add x0, x1, x0
    arm64.cmp x0, 1432
    arm64.b.ne ternaryfalse
  ternarytrue:
    arm64.movImm x0, 0
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 99
  matchcont:
    arm64.cmp x0, 0
