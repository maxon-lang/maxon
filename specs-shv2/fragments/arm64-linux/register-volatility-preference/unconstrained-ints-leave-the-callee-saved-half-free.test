// Test: unconstrained-ints-leave-the-callee-saved-half-free
typealias Integer = int(i64.min to i64.max)

function sink(x Integer) returns Integer
	return x + 1
end 'sink'

function main() returns ExitCode
	let n = sink(3)
	let a0 = n + 1
	let a1 = n + 2
	let a2 = n + 3
	let a3 = n + 4
	let a4 = n + 5
	let a5 = n + 6
	let a6 = n + 7
	let a7 = n + 8
	let a8 = n + 9
	let a9 = n + 10
	let a10 = n + 11
	let a11 = n + 12
	let b0 = a0 * 3
	let b1 = a1 * 5
	let b2 = a2 * 7
	let b3 = a3 * 9
	let b4 = a4 * 11
	let b5 = a5 * 13
	let b6 = a6 * 15
	let b7 = a7 * 17
	let b8 = a8 * 19
	let b9 = a9 * 21
	let s = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
	let c = sink(s)
	let total = b0 + b1 + b2 + b3 + b4 + b5 + b6 + b7 + b8 + b9 + c
	return 0 if total == 1432 else 99
end 'main'
---
ExitCode: 0
---
