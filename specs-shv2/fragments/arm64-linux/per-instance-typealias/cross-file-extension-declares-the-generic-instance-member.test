    arm64.loadRegBaseDisp.word64 x0, [x1 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load#10:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
