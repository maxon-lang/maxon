// Test: string-contains-char
function main() returns ExitCode
	let text = "hello"
	if text.contains('e') 'check'
		return 1
	end 'check' else 'other'
		return 0
	end 'other'
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "hello"
    arm64.leaRdata x1, __str_rec_3  ; "e"
    arm64.bl String.contains#Character
    arm64.cbnz x0, check
    arm64.b ifelse
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
}
