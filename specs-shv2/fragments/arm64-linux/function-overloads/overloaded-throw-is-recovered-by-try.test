// Test: overloaded-throw-is-recovered-by-try
typealias Num = int(-1000 to 1000)

enum Boom implements Error
	fromNumber
	fromFlag
end 'Boom'

function check(value Num) returns Num throws Boom
	if value < 0 'low'
		throw Boom.fromNumber
	end 'low'
	return 1
end 'check'

function check(value bool) returns Num throws Boom
	if value 'yes'
		throw Boom.fromFlag
	end 'yes'
	return 2
end 'check'

function main() returns ExitCode
	var result = 0
	try check(-1) otherwise (e) 'fromTheNumberMember'
		match e 'which'
			fromNumber then result = result + 10
			fromFlag then result = result + 100
		end 'which'
	end 'fromTheNumberMember'
	try check(true) otherwise (e) 'fromTheFlagMember'
		match e 'which'
			fromNumber then result = result + 1000
			fromFlag then result = result + 3
		end 'which'
	end 'fromTheFlagMember'
	let last = try check(false) otherwise 0
	return (result + last) as ExitCode
end 'main'
---
ExitCode: 15
---
func @check {
  entry:
    arm64.prologue 16
    arm64.cmp x0, -1000
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at overloaded-throw-is-recovered-by-try.test:9: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 0
    arm64.cset x0, lt
    arm64.cbnz x0, low
    arm64.b ifcont
  low:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @check#bool {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, yes
    arm64.b ifcont
  yes:
    arm64.movImm x9, 2
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 2
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 18446744073709551615
    arm64.bl check
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#3
    arm64.b matchnext#6
  matcharm#3:
    arm64.movImm x0, 10
    arm64.b matchcont#7
  matchnext#6:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#4
    arm64.b matchdead#5
  matcharm#4:
    arm64.movImm x0, 100
    arm64.b matchcont#7
  matchcont#7:
    arm64.movRegReg x19, x0
    arm64.b trycont#8
