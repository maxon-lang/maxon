// Test: method-call-argument
typealias Wide = int(i64.min to i64.max)
typealias WideArray = Array with Wide

function over(x String) returns Wide
	return x.count() + 200
end 'over'

function over(x Wide) returns Wide
	return x + 100
end 'over'

function main() returns ExitCode
	var a = WideArray.create()
	a.push(7)
	return over(a.count())
end 'main'
---
ExitCode: 101
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

