// Test: managed-directory.auto-close
function main() returns ExitCode
	var i = 0
	while i < 200 'loop'
		var dir = try __ManagedDirectory.openSearch("./*".toByteArray().managed) otherwise return 1
		_ = try dir.next() otherwise return 2
		i = i + 1
	end 'loop'
	return 42
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __mrt_errno@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x19, 200
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.leaRdata x0, __str_rec_1  ; "./*"
    arm64.bl String.toByteArray
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl __md_open_search
    arm64.movRegReg x21, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#5
    arm64.b tryok#4
  tryerr#5:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#4:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.bl __md_next
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#7
    arm64.b tryok#6
  tryerr#7:
    arm64.movImm x19, 2
    arm64.movRegReg x0, x21
    arm64.bl __md_destruct
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#6:
    arm64.add x19, x19, 1
    arm64.movRegReg x0, x21
    arm64.bl __md_destruct
    arm64.b whilehdr
  whileexit:
    arm64.movImm x0, 42
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
