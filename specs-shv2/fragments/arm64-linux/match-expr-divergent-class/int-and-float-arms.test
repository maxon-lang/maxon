// Test: int-and-float-arms
function main() returns ExitCode
	let x = 1
	let r = match x 'a'
		1 gives 5
		default gives 7.5
	end 'a'
	return trunc(r)
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b matcharm
  matcharm:
    arm64.fpLoadRdata d0, [rdata + __fconst_5]
    arm64.b matchcont
  matchcont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at int-and-float-arms.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
