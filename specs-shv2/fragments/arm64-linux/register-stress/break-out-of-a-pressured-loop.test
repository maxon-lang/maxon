// Test: break-out-of-a-pressured-loop
function breakUnderPressure(p int) returns int
	let k1 = p + 1
	let k2 = p + 2
	let k3 = p + 3
	let k4 = p + 4
	let k5 = p + 5
	let k6 = p + 6
	let k7 = p + 7
	let k8 = p + 8
	let k9 = p + 9
	let k10 = p + 10
	let k11 = p + 11
	let k12 = p + 12
	var sum = 0
	var i = 0
	while i < 100 'loop'
		sum = sum + i
		i = i + 1
		if sum > 6 'stop'
			break
		end 'stop'
	end 'loop'
	return sum + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11 + k12
end 'breakUnderPressure'

function main() returns ExitCode
	let r = breakUnderPressure(0)
	if r == 88 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @breakUnderPressure {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x6, x0, 3
    arm64.add x7, x0, 4
    arm64.add x8, x0, 5
    arm64.add x9, x0, 6
    arm64.add x10, x0, 7
    arm64.add x11, x0, 8
    arm64.add x19, x0, 9
    arm64.add x20, x0, 10
    arm64.add x21, x0, 11
    arm64.add x0, x0, 12
    arm64.movImm x3, 0
    arm64.movImm x4, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x4, 100
    arm64.cset x5, lt
    arm64.cbnz x5, loop
    arm64.b critsplit
  loop:
    arm64.add x3, x3, x4
    arm64.add x4, x4, 1
    arm64.cmp x3, 6
    arm64.cset x5, gt
    arm64.cbnz x5, stop
    arm64.b ifcont
  stop:
    arm64.b whileexit
  ifcont:
    arm64.b whilehdr
  critsplit:
    arm64.b whileexit
  whileexit:
    arm64.add x1, x3, x1
    arm64.add x1, x1, x2
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
    arm64.add x1, x1, x9
    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x1, x1, x19
    arm64.add x1, x1, x20
    arm64.add x1, x1, x21
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl breakUnderPressure
    arm64.cmp x0, 88
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
