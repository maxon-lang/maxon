// Test: try-block-shadowed-binding.unshadowed-binding-is-still-the-error-union
typealias Score = int(0 to 100)

enum ErrA implements Error
    bad
end 'ErrA'

enum ErrB implements Error
    splat
end 'ErrB'

function callA(x bool) returns Score throws ErrA
    if x 'c'
        throw ErrA.bad
    end 'c'
    return 5
end 'callA'

function callB(x bool) returns Score throws ErrB
    if x 'c'
        throw ErrB.splat
    end 'c'
    return 6
end 'callB'

function main() returns ExitCode
    var sum = 0
    try 'work'
        let a = callA(false)
        let b = callB(true)
        sum = a + b
    end 'work'
    otherwise (e) 'h'
        match e 'k'
            ErrA.bad then sum = 11
            ErrB.splat then sum = 22
        end 'k'
    end 'h'
    return sum
end 'main'
---
ExitCode: 22
---
func @callA {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 5
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @callB {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 6
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl callA
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, critsplit#13
    arm64.b tryblkok#2
  critsplit#13:
    arm64.b tryblkerr
  tryblkok#2:
    arm64.movImm x0, 1
    arm64.bl callB
    arm64.add x1, x9, 1
    arm64.cmp x9, 0
    arm64.cset x2, ne
    arm64.cbnz x2, critsplit#14
    arm64.b tryblkok#3
  critsplit#14:
    arm64.movRegReg x9, x1
    arm64.b tryblkerr
  tryblkerr:
    arm64.cmp x9, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#4
    arm64.b matchnext
  matcharm#4:
    arm64.movImm x0, 11
    arm64.b matchcont
  matchnext:
    arm64.cmp x9, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#5
    arm64.b matchdead
  matcharm#5:
    arm64.movImm x0, 22
    arm64.b matchcont
  matchcont:
    arm64.b tryblkcont
  matchdead:
  tryblkok#3:
    arm64.add x0, x19, x0
    arm64.b tryblkcont
  tryblkcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at try-block-shadowed-binding.unshadowed-binding-is-still-the-error-union.test:39: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
