// Test: user-generic-inner-alias-create-carries-per-instance-identity
typealias ExitCode = int(0 to 125)

type Pair uses T
	typealias Idx = int(0 to 100)

	export var a as T

	export static function create(a T) returns Self
		return Self{a: a}
	end 'create'

	export function firstIndex() returns Idx
		return 3
	end 'firstIndex'

	export function offsetBy(i Idx) returns Idx
		return i + 1
	end 'offsetBy'
end 'Pair'

type Plain
	typealias IntPair = Pair with ExitCode

	static function make() returns ExitCode
		let p = IntPair.create(9)
		let i = p.firstIndex()
		return p.offsetBy(i)
	end 'make'
end 'Plain'

function main() returns ExitCode
	return Plain.make()
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Plain.make {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 9
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_body#6
  __il_body#6:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.movImm x0, 4
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 125
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at user-generic-inner-alias-create-carries-per-instance-identity.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl Plain.make
    arm64.epilogue 16
    arm64.ret
}
