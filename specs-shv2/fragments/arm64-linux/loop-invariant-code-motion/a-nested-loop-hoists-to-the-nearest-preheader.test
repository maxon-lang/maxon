// Test: a-nested-loop-hoists-to-the-nearest-preheader
typealias Word = int(i64.min to i64.max)
typealias WordArray = Array with Word

function grid(a WordArray, rows Word, k Word) returns Word
	var t = 0
	for _ in 0 upto rows 'outer'
		for v in a 'inner'
			t = t + v + k * 5
		end 'inner'
	end 'outer'
	return t
end 'grid'

function main() returns ExitCode
	var a = WordArray.create()
	a.push(2)
	a.push(3)
	a.push(5)

	// Each row adds (2 + 3 + 5) + 3 * (2 * 5) = 40; three rows = 120.
	if grid(a, rows: 3, k: 2) != 120 'nested'
		return 1
	end 'nested'
	if grid(a, rows: 0, k: 2) != 0 'noRows'
		return 2
	end 'noRows'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @grid {
  entry:
    arm64.prologue 16
    arm64.movImm x3, 0
    arm64.movImm x4, 0
    arm64.movImm x16, 5
    arm64.mul x2, x2, x16
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x4, x1
    arm64.cset x5, lt
    arm64.cbnz x5, outer
    arm64.b forexit#4
  outer:
    arm64.movImm x5, 0
    arm64.loadRegBaseDisp.word64 x6, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x7, [x0 + 0]
    arm64.b forhdr#5
  forhdr#5:
    arm64.cmp x5, x6
    arm64.cset x8, lt
    arm64.cbnz x8, inner
    arm64.b forexit#8
  inner:
    arm64.arm64AddLsl x8, x7, x5, lsl #3
    arm64.loadRegBaseDisp.word64 x8, [x8 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.add x3, x3, x8
    arm64.add x3, x3, x2
    arm64.b forstep#7
  forstep#7:
    arm64.add x5, x5, 1
    arm64.b forhdr#5
  forexit#8:
    arm64.b forstep#3
  forstep#3:
    arm64.add x4, x4, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.movRegReg x0, x3
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movImm x2, 2
    arm64.movRegReg x0, x19
    arm64.bl grid
    arm64.cmp x0, 120
    arm64.cset x0, ne
    arm64.cbnz x0, nested
    arm64.b ifcont#2
  nested:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x1, 0
    arm64.movImm x2, 2
    arm64.movRegReg x0, x19
    arm64.bl grid
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, noRows
    arm64.b ifcont#4
  noRows:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
