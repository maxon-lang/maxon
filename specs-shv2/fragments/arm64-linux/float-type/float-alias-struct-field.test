    arm64.storeBaseDispReg.word64 [x0 + 0], d0
    arm64.storeBaseDispReg.word64 [x0 + 8], d1
    arm64.fpLoadRdata d0, [rdata + __fconst_6]
    arm64.storeBaseDispReg.word64 [x0 + 8], d0
  __il_body:
    arm64.loadRegBaseDisp.word64 d0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 d1, [x0 + 8]
    arm64.fmul d0, d0, d1
  __il_cont:
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at float-alias-struct-field.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
