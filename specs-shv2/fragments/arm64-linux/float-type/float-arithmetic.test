// Test: float-arithmetic
function main() returns ExitCode
	let a = 10.0
	let b = 3.0
	let result = a / b
	return trunc(result)
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fdiv d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
