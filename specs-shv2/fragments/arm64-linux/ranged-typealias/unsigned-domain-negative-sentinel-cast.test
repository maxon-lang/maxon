// Test: unsigned-domain-negative-sentinel-cast
typealias Slot = int(0 to u64.max)

let NO_SLOT = (-1) as Slot

function isSentinel(s Slot) returns bool
	return s == NO_SLOT
end 'isSentinel'

function main() returns ExitCode
	if isSentinel(NO_SLOT) 'yes'
		return 7
	end 'yes'
	return 0
end 'main'
---
ExitCode: 7
---
func @isSentinel {
  entry:
    arm64.prologue 16
    arm64.cmp x0, -1
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, -1
    arm64.bl isSentinel
    arm64.cbnz x0, yes
    arm64.b ifcont
  yes:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
