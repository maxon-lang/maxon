// Test: field-store-runtime-panic
typealias Wide = int(0 to 1000)
typealias Percent = int(0 to 100)

type Box
	export var v as Percent

	static function create() returns Self
		return Self{v: 1}
	end 'create'
end 'Box'

function grow(n Wide) returns Wide
	return n * 101
end 'grow'

function main() returns ExitCode
	var b = Box.create()
	b.v = grow(5)
	return b.v
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
  __rc_ok#6:
    arm64.movImm x1, 505
  __il_cont:
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x1, 100
    arm64.b.le __rc_ok#1
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at field-store-runtime-panic.test:19: Range check failed: value outside typealias 'Percent'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#1:
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 32
    arm64.ret
}
