// Test: float-straddling-zero-in-range
typealias Unit = float(-1.0 to 1.0)

function main() returns ExitCode
	let u = -0.5 as Unit
	return trunc(-u * 100.0)
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 50
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
