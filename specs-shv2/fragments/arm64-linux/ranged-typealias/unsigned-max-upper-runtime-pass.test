// Test: unsigned-max-upper-runtime-pass
typealias Big = int(5 to u64.max)

function main() returns ExitCode
	let big = 1 shl 63
	let r = big as Big
	if r == 1 shl 63 'ok'
		return 7
	end 'ok'
	return 3
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.lsl x0, x0, 63
    arm64.add x1, x0, 0
    arm64.movImm x2, 1
    arm64.lsl x2, x2, 63
    arm64.cmp x1, x2
    arm64.cset x1, eq
    arm64.cmp x0, 0
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_ok
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 5
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.movImm x0, 1
    arm64.syscall 94
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cbnz x1, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
