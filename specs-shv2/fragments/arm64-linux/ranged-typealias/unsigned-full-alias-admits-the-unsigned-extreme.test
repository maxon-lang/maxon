// Test: unsigned-full-alias-admits-the-unsigned-extreme
typealias Slot = int(0 to u64.max)

let NO_SLOT = u64.max as Slot

function isSentinel(s Slot) returns bool
	return s == NO_SLOT
end 'isSentinel'

function main() returns ExitCode
	if isSentinel(NO_SLOT) 'yes'
		return 7
	end 'yes'
	return 0
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.b yes
  yes:
    arm64.movImm x0, 7
    arm64.epilogue 16
    arm64.ret
}
