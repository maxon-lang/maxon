// Test: error.field-store-out-of-range
typealias Percent = int(0 to 100)

type Box
	export var v as Percent

	static function create() returns Self
		return Self{v: 1}
	end 'create'
end 'Box'

function main() returns ExitCode
	var b = Box.create()
	b.v = 500
	return b.v
end 'main'
---
CompilerError:
error E3005: <fragment>:14:4: Value 500 is outside the range of 'Percent' (int(0 to 100))
