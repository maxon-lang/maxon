// Test: the-typealias-rhs-admits-the-keyword
typealias Small = int(0 to 100)
typealias IntOp = function(n int) returns int
typealias Pair = (int, int)

function dbl(n Small) returns Small
	return n + n
end 'dbl'

function apply(f IntOp, p Pair, flag bool) returns Small
	return f(p.0) + p.1 if flag else 0
end 'apply'

function main() returns ExitCode
	let p = (3, 4)
	return apply(dbl, p: p, flag: true)
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @dbl {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#2
  __rc_chk#3:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at the-typealias-rhs-admits-the-keyword.test:6: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.add x0, x0, x0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#5
  __rc_chk#6:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_1  ; "panic at the-typealias-rhs-admits-the-keyword.test:7: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.epilogue 16
    arm64.ret
}

func @apply {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.cbz x2, ternaryfalse
  ternarytrue:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.movRegReg x1, x3
    arm64.blr x19
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.add x0, x0, x1
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 0
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at the-typealias-rhs-admits-the-keyword.test:11: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 3
    arm64.movImm x20, 4
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.leaFuncAddr x0, __fnref_dbl
    arm64.movImm x2, 1
    arm64.movImm x3, 0
    arm64.movRegReg x1, x21
    arm64.bl apply
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
