// Test: function-param-return
typealias Score = int(0 to 100)

function double(s Score) returns Score
	return s * 2
end 'double'

function main() returns ExitCode
	return double(21)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b __rc_chk#4
  __rc_chk#4:
    arm64.b __rc_ok#3
  __rc_ok#3:
    arm64.movImm x0, 42
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.b __rc_ok#5
  __rc_ok#5:
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
