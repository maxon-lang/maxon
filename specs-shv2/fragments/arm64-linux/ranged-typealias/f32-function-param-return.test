// Test: f32-function-param-return
typealias F = float(f32.min to f32.max)

function double(x F) returns F
	return x * 2.0
end 'double'

function main() returns ExitCode
	return trunc(double(21.0))
end 'main'
---
ExitCode: 42
---
func @double {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fmul d0, d0, d1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.bl double
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
