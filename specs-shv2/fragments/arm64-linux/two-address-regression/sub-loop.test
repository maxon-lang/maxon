// Test: sub-loop
function main() returns ExitCode
	var acc = 100
	var i = 1
	while i < 5 'loop'
		acc = acc - i
		i = i + 1
	end 'loop'
	return acc
end 'main'
---
ExitCode: 90
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 100
    arm64.movImm x1, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 5
    arm64.cset x2, lt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.sub x0, x0, x1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at sub-loop.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
