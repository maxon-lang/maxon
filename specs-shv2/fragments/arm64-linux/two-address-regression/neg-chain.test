// Test: neg-chain
function negs(p int) returns int
	let x = p + 7
	let n1 = -x
	let n2 = -n1
	let n3 = -n2
	return x * 100 - n3
end 'negs'

function main() returns ExitCode
	let r = negs(0)
	if r == 707 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @negs {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 7
    arm64.neg x1, x0
    arm64.neg x1, x1
    arm64.neg x1, x1
    arm64.movImm x16, 100
    arm64.mul x0, x0, x16
    arm64.sub x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl negs
    arm64.cmp x0, 707
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
