// Test: loop-reuse-transient-overflow
function loopReuse(p Integer) returns Integer
	let k1 = p + 1
	let k2 = p + 2
	let k3 = p + 3
	let k4 = p + 4
	let k5 = p + 5
	let k6 = p + 6
	let k7 = p + 7
	let k8 = p + 8
	let k9 = p + 9
	let k10 = p + 10
	let k11 = p + 11
	let a = p + 20
	var b = p + 5
	var i = 0
	while i < 3 'loop'
		b = a - b
		i = i + 1
	end 'loop'
	return b + k1 + k2 + k3 + k4 + k5 + k6 + k7 + k8 + k9 + k10 + k11
end 'loopReuse'

function main() returns ExitCode
	let r = loopReuse(0)
	if r == 81 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @loopReuse {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x3, x0, 3
    arm64.add x4, x0, 4
    arm64.add x5, x0, 5
    arm64.add x6, x0, 6
    arm64.add x7, x0, 7
    arm64.add x8, x0, 8
    arm64.add x9, x0, 9
    arm64.add x10, x0, 10
    arm64.add x11, x0, 11
    arm64.add x0, x0, 20
    arm64.movImm x12, 0
    arm64.movRegReg x13, x12
    arm64.movRegReg x12, x5
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x13, 3
    arm64.cset x14, lt
    arm64.cbnz x14, loop
    arm64.b whileexit
  loop:
    arm64.sub x12, x0, x12
    arm64.add x13, x13, 1
    arm64.b whilehdr
  whileexit:
    arm64.add x0, x12, x1
    arm64.add x0, x0, x2
    arm64.add x0, x0, x3
    arm64.add x0, x0, x4
    arm64.add x0, x0, x5
    arm64.add x0, x0, x6
    arm64.add x0, x0, x7
    arm64.add x0, x0, x8
    arm64.add x0, x0, x9
    arm64.add x0, x0, x10
    arm64.add x0, x0, x11
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl loopReuse
    arm64.cmp x0, 81
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
