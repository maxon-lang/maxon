// Test: mul-loop
function main() returns ExitCode
	var product = 1
	var i = 5
	while i > 1 'loop'
		product = product * i
		i = i - 1
	end 'loop'
	return product
end 'main'
---
ExitCode: 120
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 5
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 1
    arm64.cset x2, gt
    arm64.cbnz x2, loop
    arm64.b whileexit
  loop:
    arm64.mul x0, x0, x1
    arm64.sub x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.epilogue 16
    arm64.ret
}
