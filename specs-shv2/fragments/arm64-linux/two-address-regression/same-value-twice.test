// Test: same-value-twice
function sameTwice(p int) returns int
	let x = p + 9
	let y = p + 7
	let sq = x * x
	let df = x - x
	let t = y * y
	return sq * 100 + df * 10 + x + t
end 'sameTwice'

function main() returns ExitCode
	let r = sameTwice(0)
	if r == 8158 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @sameTwice {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 9
    arm64.add x0, x0, 7
    arm64.mul x2, x1, x1
    arm64.sub x6, x1, x1
    arm64.mul x0, x0, x0
    arm64.movImm x16, 100
    arm64.mul x2, x2, x16
    arm64.movImm x16, 10
    arm64.mul x6, x6, x16
    arm64.add x2, x2, x6
    arm64.add x1, x2, x1
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl sameTwice
    arm64.cmp x0, 8158
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
