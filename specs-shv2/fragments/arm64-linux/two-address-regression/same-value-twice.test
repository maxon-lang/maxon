// Test: same-value-twice
function sameTwice(p Integer) returns Integer
	let x = p + 9
	let y = p + 7
	let sq = x * x
	let df = x - x
	let t = y * y
	return sq * 100 + df * 10 + x + t
end 'sameTwice'

function main() returns ExitCode
	let r = sameTwice(0)
	if r == 8158 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 8158
  __il_cont:
    arm64.movImm x16, 8158
    arm64.cmp x0, x16
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
