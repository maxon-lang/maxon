// Test: reuse-copy-outlives
function main() returns ExitCode
	let a = 20
	var b = 5
	var i = 0
	while i < 3 'loop'
		b = a - b
		i = i + 1
	end 'loop'
	return b
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.movImm x1, 5
    arm64.movImm x2, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x2, 3
    arm64.cset x3, lt
    arm64.cbnz x3, loop
    arm64.b whileexit
  loop:
    arm64.sub x1, x0, x1
    arm64.add x2, x2, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at reuse-copy-outlives.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x1
    arm64.epilogue 16
    arm64.ret
}
