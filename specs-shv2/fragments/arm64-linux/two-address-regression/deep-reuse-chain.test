// Test: deep-reuse-chain
function chain(p Integer) returns Integer
	let a = p + 100
	let b = p + 1
	let c = p + 2
	let d = p + 3
	let e = p + 4
	let f = p + 5
	let r1 = a - b
	let r2 = a - c
	let r3 = a - d
	let r4 = a - e
	let r5 = a - f
	return r1 + r2 + r3 + r4 + r5 + a
end 'chain'

function main() returns ExitCode
	let s = chain(0)
	if s == 585 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 585
  __il_cont:
    arm64.cmp x0, 585
    arm64.b.ne ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
