// Test: iteration.two-loops
function main() returns ExitCode
	let list = List from [1, 2, 3]
	var sum1 = 0
	for item in list 'loop1'
		sum1 = sum1 + item
	end 'loop1'
	var sum2 = 0
	for item in list 'loop2'
		sum2 = sum2 + item
	end 'loop2'
	if sum1 == sum2 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.leaRdata x0, __layout_List_int
    arm64.bl List.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl List.append
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.bl List.append
    arm64.movImm x1, 3
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.bl List.append
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl List.createIterator
    arm64.movRegReg x21, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.cset x1, eq
    arm64.cbnz x1, critsplit#15
    arm64.b forempty#2
  critsplit#15:
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, loop1
    arm64.b forexit#5
  loop1:
    arm64.leaRdata x1, __layout_ListIterator_int
    arm64.movRegReg x0, x21
    arm64.bl ListIterator.current
    arm64.add x19, x19, x0
    arm64.b forstep#4
  forstep#4:
    arm64.movRegReg x0, x21
    arm64.bl ListIterator.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr#1
  forexit#5:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_ListIterator_int
    arm64.b forjoin#6
  forempty#2:
    arm64.b forjoin#6
  forjoin#6:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl List.createIterator
    arm64.movRegReg x22, x0
    arm64.movImm x0, 0
    arm64.cmp x9, 0
    arm64.cset x1, eq
    arm64.cbnz x1, critsplit#16
    arm64.b forempty#8
  critsplit#16:
    arm64.b forhdr#7
  forhdr#7:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, loop2
    arm64.b forexit#11
  loop2:
    arm64.leaRdata x1, __layout_ListIterator_int
    arm64.movRegReg x0, x22
    arm64.bl ListIterator.current
    arm64.add x21, x21, x0
    arm64.b forstep#10
  forstep#10:
    arm64.movRegReg x0, x22
    arm64.bl ListIterator.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr#7
  forexit#11:
    arm64.movRegReg x0, x22
    arm64.bl __destruct_ListIterator_int
    arm64.movRegReg x0, x21
    arm64.b forjoin#12
  forempty#8:
    arm64.movRegReg x0, x21
    arm64.b forjoin#12
  forjoin#12:
    arm64.cmp x19, x0
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_List_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  ifcont:
