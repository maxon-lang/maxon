// Test: memory.get-in-loop-no-over-release
typealias N = int(0 to u64.max)
typealias NList = List with N

function walkSum(list NList, n N) returns N
	var sum = 0
	var i = 0
	while i < n 'loop'
		let v = try list.get(i) otherwise panic("oob")
		sum = sum + v
		i = i + 1
	end 'loop'
	return sum
end 'walkSum'

function main() returns ExitCode
	var list = NList.create()
	var k = 0
	while k < 12 'build'
		list.append(k * 10)
		k = k + 1
	end 'build'
	let s = walkSum(list, n: list.count())
	print("sum={s}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @walkSum {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x21, 0
    arm64.movImm x22, 0
  whilehdr:
    arm64.cmp x22, x20
    arm64.b.ge whileexit
  loop:
    arm64.leaRdata x2, __layout_List_N
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.bl List.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_2  ; "panic at memory.get-in-loop-no-over-release.test:9: oob\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.add x21, x21, x0
    arm64.add x22, x22, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
