    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __str_rec_4  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x24, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x25, [x0 + 8]
    arm64.add x0, x22, x20
