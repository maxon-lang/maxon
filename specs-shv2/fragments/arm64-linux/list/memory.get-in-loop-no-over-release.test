    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_List_N
    arm64.bl List.create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x20, 12
    arm64.b.ge whileexit
  build:
    arm64.movImm x16, 10
    arm64.mul x1, x20, x16
    arm64.leaRdata x2, __layout_List_N
    arm64.movRegReg x0, x19
    arm64.bl List.append
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x19
    arm64.bl List.count
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl walkSum
