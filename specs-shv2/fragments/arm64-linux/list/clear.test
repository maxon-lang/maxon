// Test: clear
function main() returns ExitCode
	var list = List from [1, 2, 3]
	list.clear()
	if list.isEmpty() 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.leaRdata x0, __layout_List_int
    arm64.bl List.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl List.append
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.bl List.append
    arm64.movImm x1, 3
    arm64.leaRdata x2, __layout_List_int
    arm64.movRegReg x0, x20
    arm64.bl List.append
    arm64.movRegReg x0, x20
    arm64.bl List.clear
    arm64.movRegReg x0, x20
    arm64.bl List.isEmpty
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_List_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_List_int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
