    arm64.b.lt __rc_panic#14
  __rc_chk#15:
    arm64.cmp x0, 1000
    arm64.b.le __rc_ok#13
  __rc_panic#14:
    arm64.leaRdata x0, __str_blob_1  ; "panic at try-block.routed-union-result-is-released.test:21: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
