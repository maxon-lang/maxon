    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 4
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 5
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x1, 6
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.add x0, x0, 150
    arm64.loadRegBaseDisp.word64 x1, [x20 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x21 + 8]
    arm64.add x22, x0, x1
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x22, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x22, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at managed-array-arguments-in-stack-slots.test:19: Range check failed: value outside typealias 'ExitCode'\x0a"
