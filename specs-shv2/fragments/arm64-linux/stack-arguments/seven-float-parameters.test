// Test: seven-float-parameters
function sumf7(a float, b float, c float, d float, e float, f float, g float) returns float
	return a + b + c + d + e + f + g
end 'sumf7'

function main() returns ExitCode
	let total = sumf7(1.0, b: 2.0, c: 4.0, d: 8.0, e: 16.0, f: 32.0, g: 64.0)
	if total == 127.0 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
func @sumf7 {
  entry:
    arm64.prologue 16
    arm64.fadd d0, d0, d1
    arm64.fadd d0, d0, d2
    arm64.fadd d0, d0, d3
    arm64.fadd d0, d0, d4
    arm64.fadd d0, d0, d5
    arm64.fadd d0, d0, d6
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fpLoadRdata d2, [rdata + __fconst_2]
    arm64.fpLoadRdata d3, [rdata + __fconst_3]
    arm64.fpLoadRdata d4, [rdata + __fconst_4]
    arm64.fpLoadRdata d5, [rdata + __fconst_5]
    arm64.fpLoadRdata d6, [rdata + __fconst_6]
    arm64.bl sumf7
    arm64.fpLoadRdata d1, [rdata + __fconst_7]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
