// Test: error.otherwise-return-string

// Regression: try returning String + otherwise return <string literal>.
// Mirrors the shape of the original maxonOpIdxToString segfault in the
// self-hosted compiler.
enum MyError implements Error
	failed
end 'MyError'

function tryIt(flag bool) returns String throws MyError
	if flag 'c'
		throw MyError.failed
	end 'c'
	return "ok"
end 'tryIt'

function wrap(flag bool) returns String
	let s = try tryIt(flag) otherwise return "??"
	return s
end 'wrap'

function main() returns ExitCode
	let a = wrap(false)
	let b = wrap(true)
	if a == "ok" 'x'
		if b == "??" 'y'
			return 0
		end 'y'
	end 'x'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tryIt {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, c
    arm64.b ifcont
  c:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_2  ; "ok"
    arm64.bl __str_retain
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @wrap {
  entry:
    arm64.prologue 16
    arm64.bl tryIt
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_rec_3  ; "??"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl wrap
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.bl wrap
    arm64.movRegReg x20, x0
    arm64.leaRdata x1, __str_rec_2  ; "ok"
    arm64.movRegReg x0, x19
    arm64.bl __str_eq
    arm64.cbnz x0, x
    arm64.b ifcont#4
  x:
    arm64.leaRdata x1, __str_rec_3  ; "??"
    arm64.movRegReg x0, x20
    arm64.bl __str_eq
    arm64.cbnz x0, y
    arm64.b ifcont#3
  y:
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont#3:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x21, 1
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
