// Test: error.file-private-union-caught-cross-file
// --- file: liberr.maxon
typealias Code = int(i64.min to i64.max)

// File-private (no `export`/`module`) error union: the catch site in another
// file only ever learns of this type through `risky`'s `throws` clause, so it
// is never seeded into the consumer file's type registry during pre-scan.
union LibErr implements Error
	bad(code Code)
end 'LibErr'

export function risky(n Code) returns Code throws LibErr
	if n > 5 'big'
		throw LibErr.bad(42)
	end 'big'
	return n
end 'risky'

// --- file: main.maxon
function main() returns ExitCode
	var result = 0
	try risky(9) otherwise (e) 'handler'
		match e 'check'
			bad(code) then result = code
		end 'check'
	end 'handler'
	return result
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @risky {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.cmp x0, 5
    arm64.cset x1, gt
    arm64.cbnz x1, big
    arm64.b ifcont
  big:
    arm64.movImm x19, 42
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 9
    arm64.bl risky
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x9 + 8]
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b trycont
  matchdead:
  tryok:
    arm64.movRegReg x0, x19
    arm64.b trycont
  trycont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at main.maxon:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
