// Test: throws-a-stdlib-error-has-a-user-declared-spelling
typealias Num = int(0 to 1000)

enum SearchFailed implements Error
	notFound
end 'SearchFailed'

function firstSpace(s String) returns Num throws SearchFailed
	let idx = try s.findFirst(" ") otherwise throw SearchFailed.notFound
	return idx.bytePos() as Num
end 'firstSpace'

function main() returns ExitCode
	return (try firstSpace("ab cd") otherwise 99)
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @firstSpace {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x1, __str_rec_2  ; " "
    arm64.bl String.findFirst
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.cmp x19, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_19  ; "panic at throws-a-stdlib-error-has-a-user-declared-spelling.test:10: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_3  ; "ab cd"
    arm64.bl firstSpace
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 99
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_20  ; "panic at throws-a-stdlib-error-has-a-user-declared-spelling.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
