// Test: error.otherwise-continue

typealias Integer = int(i64.min to i64.max)

// Single-statement otherwise: continue to next iteration on error
enum MyError implements Error
	failed
end 'MyError'

var counter = 0 as Integer

function mayFail() returns Integer throws MyError
	counter = counter + 1
	if counter == 2 'check'
		throw MyError.failed
	end 'check'
	return counter
end 'mayFail'

function main() returns ExitCode
	var total = 0
	var iter = 0
	while iter < 4 'loop'
		iter = iter + 1
		let v = try mayFail() otherwise continue
		total = total + v
	end 'loop'
	return total
end 'main'
---
ExitCode: 8
---
data {
  __data_counter@0 = i64 0
}

func @mayFail {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_counter
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 2
    arm64.b.ne ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 0
  whilehdr:
    arm64.cmp x0, 4
    arm64.b.ge whileexit
  loop:
    arm64.add x20, x0, 1
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movRegReg x0, x20
    arm64.b whilehdr
  tryok:
    arm64.add x19, x19, x0
    arm64.movRegReg x0, x20
    arm64.b whilehdr
  whileexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at error.otherwise-continue.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
