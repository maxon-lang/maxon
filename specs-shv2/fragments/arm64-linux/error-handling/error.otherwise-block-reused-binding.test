// Test: error.otherwise-block-reused-binding

typealias Integer = int(i64.min to i64.max)

// Regression: two sibling `try ... otherwise (e) 'label' ... end 'label'`
// blocks reusing the same binding name `e` but with different error types
// (one associated-value enum, one simple enum). Without per-block scoping,
// the first block's managed-type registration of `e` persists and the
// function epilogue incorrectly decrefs the second block's integer `e`.
union AssocError implements Error
	withCode(code Integer)
	plain
end 'AssocError'

enum SimpleError implements Error
	broken
end 'SimpleError'

function mayFailAssoc() returns Integer throws AssocError
	throw AssocError.withCode(7)
end 'mayFailAssoc'

function mayFailSimple() returns Integer throws SimpleError
	throw SimpleError.broken
end 'mayFailSimple'

function main() returns ExitCode
	var result = 0
	try mayFailAssoc() otherwise (e) 'handler1'
		match e 'check1'
			withCode(code) then result = result + code
			plain then result = result + 1
		end 'check1'
	end 'handler1'
	try mayFailSimple() otherwise (e) 'handler2'
		match e 'check2'
			broken then result = result + 35
		end 'check2'
	end 'handler2'
	return result
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @mayFailAssoc {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 7
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x19
    arm64.movImm x0, 0
    arm64.movRegReg x9, x1
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @mayFailSimple {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.bl mayFailAssoc
    arm64.cmp x9, 0
    arm64.b.eq trycont#8
  tryerr#2:
    arm64.loadRegBaseDisp.word64 x0, [x9 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#3:
    arm64.loadRegBaseDisp.word64 x19, [x9 + 8]
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead#5
  matcharm#4:
    arm64.movImm x19, 1
  matchcont:
    arm64.movRegReg x0, x9
    arm64.bl __mm_decref
    arm64.b trycont#8
  matchdead#5:
  tryok#1:
  trycont#8:
    arm64.bl mayFailSimple
    arm64.cmp x9, 0
    arm64.b.eq tryok#9
  tryerr#10:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.b.ne matchdead#12
  matcharm#11:
    arm64.add x0, x19, 35
    arm64.b trycont#14
  matchdead#12:
  tryok#9:
    arm64.movRegReg x0, x19
  trycont#14:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at error.otherwise-block-reused-binding.test:40: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
