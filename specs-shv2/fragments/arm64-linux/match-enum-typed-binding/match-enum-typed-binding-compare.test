// Test: match-enum-typed-binding-compare
enum Color
		red
		green
		blue
end 'Color'

union Pixel
		colored(c Color)
		transparent
end 'Pixel'

function isGreen(p Pixel) returns ExitCode
		match p 'check'
				colored(c) then return checkColor(c)
				transparent then return 0
		end 'check'
end 'isGreen'

function checkColor(c Color) returns ExitCode
		let result = match c 'g'
				green gives 1
				red gives 0
				blue gives 0
		end 'g'
		return result
end 'checkColor'

function main() returns ExitCode
		let p = Pixel.colored(Color.green)
		return isGreen(p)
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @isGreen {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.bl checkColor
    arm64.epilogue 16
    arm64.ret
  matchnext:
    arm64.cmp x1, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#2
    arm64.b matchdead
  matcharm#2:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}

func @checkColor {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#5
  matcharm#2:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#6
  matcharm#1:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-enum-typed-binding-compare.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.movRegReg x0, x20
    arm64.bl isGreen
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
