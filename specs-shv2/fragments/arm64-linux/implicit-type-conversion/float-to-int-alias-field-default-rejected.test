// Test: float-to-int-alias-field-default-rejected

typealias Count = int(i64.min to i64.max)

type Bag
	export var n as Count = 2.5

	export static function make() returns Self
		return Self{}
	end 'make'
end 'Bag'

function main() returns ExitCode
	let b = Bag.make()
	return b.n
end 'main'
