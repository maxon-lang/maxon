// Test: no-string-to-int

typealias Integer = int(i64.min to i64.max)

function takeInt(x Integer) returns Integer
	return x
end 'takeInt'

function main() returns ExitCode
	let s = "hello"
	return takeInt(s)
end 'main'
---
CompilerError:
error E3005: <fragment>:11:9: argument type mismatch for 'x': expected 'Integer', got 'String'
