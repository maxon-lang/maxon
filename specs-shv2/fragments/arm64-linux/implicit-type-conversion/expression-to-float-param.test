// Test: expression-to-float-param

typealias Integer = int(i64.min to i64.max)
typealias Float = float(f64.min to f64.max)

function takeFloat(x Float) returns Integer
	return trunc(x)
end 'takeFloat'

function main() returns ExitCode
	let a = 20
	let b = 22
	return takeFloat(a + b)
end 'main'
---
ExitCode: 42
---
func @takeFloat {
  entry:
    arm64.prologue 16
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 20
    arm64.add x0, x0, 22
    arm64.scvtf d0, x0
    arm64.bl takeFloat
    arm64.epilogue 16
    arm64.ret
}
