// Test: struct-enum-field-array-push
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

export union Op
		add(value Integer)
		sub(value Integer)
end 'Op'

export type Block
		export var id as Integer
		export var ops as IntArray
		export var terminator as Op

		static function create(id Integer, ops IntArray, terminator Op) returns Self
			return Self{id: id, ops: ops, terminator: terminator}
		end 'create'
end 'Block'

function main() returns ExitCode
		var b = Block.create(0, ops: IntArray.create(), terminator: Op.add(42))
		b.ops.push(1)
		b.ops.push(2)
		b.ops.push(3)
		return b.ops.count()
end 'main'
---
ExitCode: 3
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Block.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.storeBaseDispReg.word64 [x0 + 16], x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x20, x0
    arm64.movImm x21, 42
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x2, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x21
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Block.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 1
    arm64.bl __arr_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 2
    arm64.bl __arr_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 3
    arm64.bl __arr_push
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.bl __arr_count
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Block
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
