// Test: array-of-struct-with-enum-field
typealias Integer = int(i64.min to i64.max)

export union Tag
		number(n Integer)
		text(len Integer)
end 'Tag'

export type Entry
		export var id as Integer
		export var tag as Tag

		static function create(id Integer, tag Tag) returns Self
			return Self{id: id, tag: tag}
		end 'create'
end 'Entry'

typealias EntryArray = Array with Entry

function main() returns ExitCode
		var entries = EntryArray.create()
		var i = 0
		while i < 10 'fill'
				let e = Entry.create(i, tag: Tag.number(i * 10))
				entries.push(e)
				i = i + 1
		end 'fill'
		let last = try entries.get(9) otherwise Entry.create(0, tag: Tag.number(0))
		match last.tag 'check'
				number(n) then return n
				text then return 0
		end 'check'
end 'main'
---
ExitCode: 90
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Entry.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __destruct_Entry
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 10
    arm64.cset x0, lt
    arm64.cbnz x0, fill
    arm64.b whileexit
  fill:
    arm64.movImm x16, 10
    arm64.mul x21, x20, x16
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x21
    arm64.movRegReg x0, x20
    arm64.bl Entry.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x1, 9
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.storeBaseDispReg.word64 [x1 + 8], x21
    arm64.movRegReg x0, x20
    arm64.bl Entry.create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x20
    arm64.b trycont
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x1 + 0]
    arm64.cmp x2, 0
    arm64.cset x6, eq
    arm64.cbnz x6, matcharm
    arm64.b matchnext
  matcharm:
    arm64.loadRegBaseDisp.word64 x20, [x1 + 8]
    arm64.bl __destruct_Entry
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchnext:
    arm64.cmp x2, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x20, 0
    arm64.bl __destruct_Entry
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
  matchcont:
}
