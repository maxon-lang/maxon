// Test: file-info.read-only
function main() returns ExitCode
	let path = FilePath from "test_fi_rw.txt"
	try File.writeText(path, content: "rw test") otherwise 'w'
		return 1
	end 'w'
	let fi = try File.info(path) otherwise 'e'
		try File.delete(path) otherwise ignore
		return 2
	end 'e'
	try File.delete(path) otherwise ignore
	// A freshly written file should not be read-only
	if fi.isReadOnly 'ro'
		print("unexpected read-only")
		return 3
	end 'ro'
	print("not read-only")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __mrt_errno@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_20  ; "test_fi_rw.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __str_rec_21  ; "rw test"
    arm64.b __il_body
  __il_body:
    arm64.movImm x2, 0
    arm64.b __il_cont
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl File.writeText
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x19
    arm64.bl File.info
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movRegReg x0, x19
    arm64.bl File.delete
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#6
    arm64.b tryok#5
  tryerr#6:
    arm64.b trycont#7
  tryok#5:
    arm64.b trycont#7
  trycont#7:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movRegReg x0, x19
    arm64.bl File.delete
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#9
    arm64.b tryok#8
  tryerr#9:
    arm64.b trycont#10
  tryok#8:
    arm64.b trycont#10
  trycont#10:
    arm64.loadRegBaseDisp.byte x0, [x20 + 40]
    arm64.cbnz x0, ro
    arm64.b ifcont
  ro:
    arm64.leaRdata x0, __str_rec_22  ; "unexpected read-only"
    arm64.bl print
    arm64.movImm x21, 3
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_23  ; "not read-only"
    arm64.bl print
    arm64.movImm x21, 0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
