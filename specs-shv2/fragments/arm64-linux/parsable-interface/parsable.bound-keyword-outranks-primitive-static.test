// Test: parsable.bound-keyword-outranks-primitive-static
type Box
	export let n as Integer

	export static function create(n Integer) returns Box
		return Self{n: n}
	end 'create'

	export function fromString(_ String) returns Integer
		return self.n
	end 'fromString'
end 'Box'

function f(float Box) returns ExitCode
	return float.fromString("9")
end 'f'

function main() returns ExitCode
	return f(Box.create(7))
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @f {
  entry:
    arm64.prologue 16
    arm64.leaRdata x1, __str_rec_1  ; "9"
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at parsable.bound-keyword-outranks-primitive-static.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 7
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movRegReg x0, x1
    arm64.bl f
    arm64.epilogue 32
    arm64.ret
}
