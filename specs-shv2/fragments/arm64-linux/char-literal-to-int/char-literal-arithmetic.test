// Test: char-literal-arithmetic
function main() returns ExitCode
	let cp = 53
	let digit = cp - '0'
	return digit
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
