// Test: bool-from-comparison
function main() returns ExitCode
	let result = 5 > 3
	if result 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.cmp x0, 3
    arm64.cset x0, gt
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
