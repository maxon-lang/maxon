// Test: a-borrow-out-of-a-temporary-inside-a-loop-body
typealias Wide = int(i64.min to i64.max)
typealias Bytes = Array with ByteArray

function make() returns Bytes
	var outer = Bytes.create()
	var inner = ByteArray.create()
	inner.push(1)
	inner.push(2)
	inner.push(3)
	outer.push(inner)
	return outer
end 'make'

function main() returns ExitCode
	var total = 0 as Wide
	for _ in 0 upto 4 'each'
		let n = try make().get(0) otherwise ByteArray.create()
		total = total + n.count()
	end 'each'
	return total
end 'main'
---
ExitCode: 12
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __managed_push
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 4
    arm64.b.ge forexit
  each:
    arm64.bl make
    arm64.movRegReg x21, x0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x0, 0
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x21 + 40]
    arm64.cmp x2, 0
    arm64.b.eq critsplit#15
  __im_empty:
    arm64.cmp x22, 0
    arm64.b.ne critsplit#16
  __im_slow:
    arm64.movRegReg x0, x21
    arm64.bl __managed_get
    arm64.movRegReg x22, x0
    arm64.b __im_cont
  critsplit#16:
    arm64.movRegReg x9, x0
    arm64.b __im_cont
  critsplit#15:
    arm64.movRegReg x9, x0
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.b trycont
  tryok:
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
    arm64.movRegReg x0, x22
  trycont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.add x19, x19, x1
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-borrow-out-of-a-temporary-inside-a-loop-body.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
