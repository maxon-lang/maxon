// Test: a-load-across-a-store-is-not-reused
typealias Word = int(i64.min to i64.max)

type Cell
	export var slot as Word

	export static function create(slot Word) returns Cell
		return Self{slot: slot}
	end 'create'
end 'Cell'

function main() returns ExitCode
	var c = Cell.create(1)
	let before = c.slot
	c.slot = 2
	let after = c.slot
	if before + after != 3 'staleRead'
		return 1
	end 'staleRead'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 1
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.movImm x2, 2
    arm64.storeBaseDispReg.word64 [x1 + 0], x2
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.cmp x0, 3
    arm64.b.eq ifcont
  staleRead:
    arm64.movImm x0, 1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}
