// Test: checked-divide-keeps-the-idiv
function opaque(x Integer) returns Integer
	return x
end 'opaque'

function main() returns ExitCode
	let d = opaque(7)
	let q = try (100 / d) otherwise 99
	return q as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 14
---
func @main {
  entry:
    arm64.prologue 16
  __il_cont:
    arm64.movImm x0, 100
    arm64.movImm x1, 5270498306774157605
    arm64.smulh x0, x1, x0
    arm64.asr x0, x0, 1
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
  trycont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at checked-divide-keeps-the-idiv.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
