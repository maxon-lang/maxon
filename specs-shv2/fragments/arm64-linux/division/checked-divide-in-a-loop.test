// Test: checked-divide-in-a-loop
function opaque(x Integer) returns Integer
	return x
end 'opaque'

function main() returns ExitCode
	var sum = 0
	var i = 1
	while i <= 6 'loop'
		sum = sum + (try (100 / opaque(i)) otherwise 0)
		i = i + 1
	end 'loop'
	return sum as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 244
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
  whilehdr:
    arm64.cmp x1, 6
    arm64.b.gt whileexit
  loop:
    arm64.movImm x2, 100
  __il_cont:
    arm64.cmp x1, 0
    arm64.cset x3, eq
    arm64.orr x4, x1, x3
    arm64.sdiv x2, x2, x4
    arm64.cmp x3, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x2, 0
  trycont:
    arm64.add x0, x0, x2
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at checked-divide-in-a-loop.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
