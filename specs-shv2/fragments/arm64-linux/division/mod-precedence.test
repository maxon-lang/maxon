// Test: mod-precedence
function main() returns ExitCode
	return 2 * 6 mod 4
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.movImm x16, 6
    arm64.mul x0, x0, x16
    arm64.movImm x1, 4
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
    arm64.epilogue 16
    arm64.ret
}
