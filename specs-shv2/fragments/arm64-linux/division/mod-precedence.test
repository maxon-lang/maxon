// Test: mod-precedence
function main() returns ExitCode
	return 2 * 6 mod 4
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 12
    arm64.asr x1, x0, 63
    arm64.lsr x1, x1, 62
    arm64.add x1, x1, 12
    arm64.asr x1, x1, 2
    arm64.lsl x1, x1, 2
    arm64.sub x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at mod-precedence.test:3: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
