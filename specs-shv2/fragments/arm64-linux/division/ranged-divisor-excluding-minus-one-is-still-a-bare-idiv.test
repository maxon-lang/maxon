// Test: ranged-divisor-excluding-minus-one-is-still-a-bare-idiv
typealias BelowMinusOne = int(i64.min to -2)

function remainder(n Integer, d BelowMinusOne) returns Integer
	return n mod d
end 'remainder'

function main() returns ExitCode
	return (remainder(-13, d: -5) + 45) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 42
---
func @remainder {
  entry:
    arm64.prologue 16
    arm64.cmp x1, -2
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranged-divisor-excluding-minus-one-is-still-a-bare-idiv.test:4: Range check failed: value outside typealias 'BelowMinusOne'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.sdiv x16, x0, x1
    arm64.msub x0, x16, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 18446744073709551603
    arm64.movImm x1, 18446744073709551611
    arm64.bl remainder
    arm64.add x0, x0, 45
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at ranged-divisor-excluding-minus-one-is-still-a-bare-idiv.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
