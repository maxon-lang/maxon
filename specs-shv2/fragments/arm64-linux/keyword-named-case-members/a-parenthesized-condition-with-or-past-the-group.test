// Test: a-parenthesized-condition-with-or-past-the-group
function main() returns ExitCode
	var i = 0
	var acc = 0
	while ((i < 2) or (i < 0)) or false 'spin'
		if ((i == 0) or (i == 1)) and true 'inner'
			acc = acc + 21
		end 'inner'
		i = i + 1
	end 'spin'
	if acc == 42 'ok'
		return 42
	end 'ok'
	return 1
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 0
  whilehdr:
    arm64.cmp x0, 2
    arm64.movImm x2, 1
    arm64.b.lt scmerge#3
  orrhs#2:
    arm64.cmp x0, 0
    arm64.cset x2, lt
  scmerge#3:
    arm64.movImm x3, 1
    arm64.cbnz x2, scmerge#5
  orrhs#4:
    arm64.movImm x2, 0
    arm64.movRegReg x3, x2
  scmerge#5:
    arm64.cbz x3, whileexit
  spin:
    arm64.cmp x0, 0
    arm64.movImm x2, 1
    arm64.b.eq scmerge#9
  orrhs#8:
    arm64.cmp x0, 1
    arm64.cset x2, eq
  scmerge#9:
    arm64.movImm x3, 0
    arm64.cbz x2, critsplit
  andrhs:
    arm64.movImm x2, 1
    arm64.b scmerge#11
  critsplit:
    arm64.movRegReg x2, x3
  scmerge#11:
    arm64.cbz x2, ifcont#13
  inner:
    arm64.add x1, x1, 21
  ifcont#13:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x1, 42
    arm64.b.ne ifcont#15
  ok:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont#15:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
