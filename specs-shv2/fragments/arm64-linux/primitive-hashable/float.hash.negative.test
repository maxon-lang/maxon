// Test: float.hash.negative
function main() returns ExitCode
	let pos = 3.14
	let neg = -3.14
	if neg.hash() != pos.hash() 'signMasked'
		return 1
	end 'signMasked'
	if neg.hash() != 1374389535 'pinned'
		return 2
	end 'pinned'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  ifcont#9:
    arm64.movImm x0, 1374389535
  ifcont#15:
    arm64.movImm x1, 1374389535
  __il_cont#5:
    arm64.cmp x0, x1
    arm64.b.eq ifcont#22
  signMasked:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#22:
    arm64.movImm x0, 1374389535
  __il_cont#19:
    arm64.movImm x16, 1374389535
    arm64.cmp x0, x16
    arm64.b.eq ifcont#4
  pinned:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
