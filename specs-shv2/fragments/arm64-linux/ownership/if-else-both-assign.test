// Test: if-else-both-assign
typealias Integer = int(i64.min to i64.max)

type Box
	export var value as Integer

	static function create(value Integer) returns Self
		return Self{value: value}
	end 'create'
end 'Box'

function choose(flag bool) returns Integer
	var result = Box.create(0)
	if flag 'branch'
		result = Box.create(1)
	end 'branch'
	if flag == false 'branch2'
		result = Box.create(2)
	end 'branch2'
	return result.value
end 'choose'

function main() returns ExitCode
	print("{choose(true)}\n")
	print("{choose(false)}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @choose {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 0
    arm64.bl Box.create
    arm64.movRegReg x20, x0
    arm64.cbnz x19, branch
    arm64.b critsplit#5
  branch:
    arm64.movImm x0, 1
    arm64.bl Box.create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.b ifcont#2
  critsplit#5:
    arm64.movRegReg x21, x20
    arm64.b ifcont#2
  ifcont#2:
    arm64.cmp x19, 0
    arm64.cset x0, eq
    arm64.cbnz x0, branch2
    arm64.b critsplit#6
  branch2:
    arm64.movImm x0, 2
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.b ifcont#4
  critsplit#6:
    arm64.movRegReg x0, x21
    arm64.b ifcont#4
  ifcont#4:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

