module typealias StdType = int(i64.min to i64.max)

// --- file: api/helper.maxon
export function pickOne(enum StdType) returns StdType
	return enum
end 'pickOne'

// --- file: app/main.maxon
function main() returns ExitCode
	return pickOne(7)
end 'main'
---
ExitCode: 7
