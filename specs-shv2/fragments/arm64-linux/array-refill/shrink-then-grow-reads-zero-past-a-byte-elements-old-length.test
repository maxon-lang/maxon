    arm64.bl __managed_resize
    arm64.movImm x20, 0
    arm64.movImm x21, 2
  whilehdr#4:
    arm64.cmp x21, 5
    arm64.b.ge whileexit#6
  sum:
    arm64.cmp x21, 0
    arm64.b.ge __rc_ok#10
  __rc_panic#11:
