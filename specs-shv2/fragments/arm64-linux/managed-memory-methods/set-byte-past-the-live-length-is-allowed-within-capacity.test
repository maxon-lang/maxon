// Test: set-byte-past-the-live-length-is-allowed-within-capacity
function main() returns ExitCode
	let mm = try __ManagedMemory.create(4, elementSize: 1) otherwise return 1
	try mm.setLength(2) otherwise return 2
	try mm.setByte(3, value: 65) otherwise return 3
	try mm.setLength(4) otherwise return 4
	let v = try mm.byteAt(3) otherwise return 5
	return v as ExitCode
end 'main'
---
ExitCode: 65
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4
    arm64.movImm x1, 1
    arm64.bl __managed_mem_create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#1:
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#3:
    arm64.movImm x1, 3
    arm64.movImm x2, 65
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_byte
    arm64.cmp x9, 0
    arm64.b.eq tryok#5
  tryerr#6:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#5:
    arm64.movImm x1, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.b.eq tryok#7
  tryerr#8:
    arm64.movImm x20, 4
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#7:
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_byte_at
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#9
  tryerr#10:
    arm64.movImm x20, 5
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok#9:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at set-byte-past-the-live-length-is-allowed-within-capacity.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
