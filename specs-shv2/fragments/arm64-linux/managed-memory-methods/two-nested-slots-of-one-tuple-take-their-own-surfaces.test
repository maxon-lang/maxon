    arm64.movRegReg x22, x0
    arm64.storeBaseDispReg.word64 [x22 + 0], x19
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.movImm x19, 9
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x21
    arm64.storeBaseDispReg.word64 [x0 + 8], x22
    arm64.storeBaseDispReg.word64 [x0 + 16], x19
