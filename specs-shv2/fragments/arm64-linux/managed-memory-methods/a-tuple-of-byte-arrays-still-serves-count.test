// Test: a-tuple-of-byte-arrays-still-serves-count
typealias Int = int(i64.min to i64.max)
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function pair() returns (ByteArray, Int)
	return ("hello".toByteArray(), 7)
end 'pair'

function main() returns ExitCode
	let p = pair()
	return p.0.count() as ExitCode
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pair {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1  ; "hello"
    arm64.bl String.toByteArray
    arm64.movRegReg x19, x0
    arm64.movImm x20, 7
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl pair
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x19, [x1 + 8]
    arm64.cmp x19, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-tuple-of-byte-arrays-still-serves-count.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __destruct___Tuple2.Array_Byte.int
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
