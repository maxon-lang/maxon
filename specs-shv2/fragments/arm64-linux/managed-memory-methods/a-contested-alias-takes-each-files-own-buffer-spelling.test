// Test: a-contested-alias-takes-each-files-own-buffer-spelling
// --- file: buffer.maxon
typealias Byte = int(0 to u8.max)
typealias Int = int(i64.min to i64.max)
typealias B = __ManagedMemory with Byte

export function bufferWidth(m B) returns Int
	return m.length()
end 'bufferWidth'

// --- file: main.maxon
typealias Int2 = int(i64.min to i64.max)
typealias B = Array with Int2

function arrayWidth(xs B) returns Int2
	return xs.count()
end 'arrayWidth'

function main() returns ExitCode
	var xs = B.create()
	xs.push(7 as Int2)
	return (bufferWidth("hello".toByteArray()) + arrayWidth(xs)) as ExitCode
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 7
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_1  ; "hello"
    arm64.bl String.toByteArray
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x20, x1, x2
    arm64.cmp x20, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at main.maxon:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
