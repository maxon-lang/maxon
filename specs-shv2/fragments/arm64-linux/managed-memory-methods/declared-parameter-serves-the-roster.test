// Test: declared-parameter-serves-the-roster
function shown(m __ManagedMemory) returns Integer
	return m.length()
end 'shown'

function main() returns ExitCode
	let bytes = "hello".toByteArray()
	return shown(bytes) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_1  ; "hello"
    arm64.bl String.toByteArray
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x19, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at declared-parameter-serves-the-roster.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
