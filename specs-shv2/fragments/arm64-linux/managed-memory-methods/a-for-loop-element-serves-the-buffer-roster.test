// Test: a-for-loop-element-serves-the-buffer-roster
typealias BufArray = Array with __ManagedMemory

function main() returns ExitCode
	var a = BufArray.create()
	a.push("hello".toByteArray())
	a.push("ab".toByteArray())
	var total = 0
	for m in a 'each'
		total = total + m.length()
	end 'each'
	return total as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __managed_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_2  ; "hello"
    arm64.bl String.toByteArray
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_3  ; "ab"
    arm64.bl String.toByteArray
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x20, 0
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, x1
    arm64.cset x3, lt
    arm64.cbnz x3, each
    arm64.b forexit
  each:
    arm64.arm64AddLsl x3, x2, x0, lsl #3
    arm64.loadRegBaseDisp.word64 x3, [x3 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.loadRegBaseDisp.word64 x3, [x3 + 8]
    arm64.add x20, x20, x3
    arm64.b forstep
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_5  ; "panic at a-for-loop-element-serves-the-buffer-roster.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
