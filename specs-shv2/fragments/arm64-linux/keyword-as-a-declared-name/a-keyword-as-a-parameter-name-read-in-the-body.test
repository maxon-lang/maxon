// Test: a-keyword-as-a-parameter-name-read-in-the-body
typealias Integer = int(i64.min to i64.max)

function identity(type Integer) returns Integer
	return type
end 'identity'

function main() returns ExitCode
	return identity(42)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
