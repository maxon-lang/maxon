  __il_body#10:
    arm64.movImm x2, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 4
    arm64.cset x3, lt
    arm64.cbnz x3, spin
    arm64.b whileexit
  spin:
    arm64.add x2, x2, 1
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.add x0, x0, x2
    arm64.b __il_body#14
  __il_body#14:
    arm64.b matchnext
  matchnext:
    arm64.b matcharm
  matcharm:
    arm64.movImm x1, 4
    arm64.b matchcont
  matchcont:
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-keyword-named-parameter-AS-THE-FIRST-TOKEN-OF-A-CONDITION.test:32: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
