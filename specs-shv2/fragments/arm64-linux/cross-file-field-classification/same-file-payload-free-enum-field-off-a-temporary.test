// Test: same-file-payload-free-enum-field-off-a-temporary
enum Color
	red
	green
end 'Color'

type Gate
	export var c as Color

	export static function make() returns Gate
		return Gate{c: Color.green}
	end 'make'
end 'Gate'

function main() returns ExitCode
	let c = Gate.make().c
	match c 'which'
		red then return 1
		green then return 42
	end 'which'
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.leaRegSlot x0, slot0
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 1
    arm64.epilogue 32
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x0, 42
    arm64.epilogue 32
    arm64.ret
  matchdead:
  matchcont:
}
