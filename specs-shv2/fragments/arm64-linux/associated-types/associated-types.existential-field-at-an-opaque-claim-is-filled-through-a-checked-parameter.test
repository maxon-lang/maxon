// Test: associated-types.existential-field-at-an-opaque-claim-is-filled-through-a-checked-parameter
typealias Integer = int(i64.min to i64.max)

interface Taker uses Element
	function take(e Element) returns Integer
	function label() returns Integer
end 'Taker'

type Runner implements Taker with Integer
	let base as Integer

	function take(e Integer) returns Integer
		return base + e
	end 'take'

	function label() returns Integer
		return base
	end 'label'

	static function create(base Integer) returns Self
		return Self{base: base}
	end 'create'
end 'Runner'

type Box uses T
	typealias TakerOfT = Taker with T

	let t as TakerOfT

	export function run() returns Integer
		return self.t.label()
	end 'run'

	static function create(t TakerOfT) returns Self
		return Self{t: t}
	end 'create'
end 'Box'

typealias IntBox = Box with Integer

function main() returns ExitCode
	return IntBox.create(Runner.create(31)).run() as ExitCode
end 'main'
---
ExitCode: 31
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Runner.take {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @Runner.label {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Runner.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Box.run {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.loadRegBaseDisp.word64 x16, [x2 + 32]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __retain_existential
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __drop_existential
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 31
    arm64.bl Runner.create
    arm64.leaRdata x1, __witness_Runner.Taker
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Box.run
    arm64.movRegReg x20, x0
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at associated-types.existential-field-at-an-opaque-claim-is-filled-through-a-checked-parameter.test:42: Range check failed: value outside typealias 'ExitC"...
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Box_Integer
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
