// Test: float.compare.nan-nan-equal
function main() returns ExitCode
	// Two NaNs from overflow (inf - inf), not division — see nan-less-than-normal.
	let infA = 1.0e308 * 10.0
	let a = infA - infA
	let infB = 1.0e308 * 10.0
	let b = infB - infB
	let result = a.compare(b)
	match result 'check'
		lessThan then return 1
		equalTo then return 0
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0x7ff0000000000000]
    arm64.fsub d0, d0, d0
    arm64.fpLoadRdata d1, [rdata + __fconst_0x7ff0000000000000]
    arm64.fsub d1, d1, d1
    arm64.b __il_body
  __il_body:
    arm64.fcmp d0, d0
    arm64.cset x0, ne
    arm64.cbnz x0, self_nan
    arm64.b ifcont#13
  self_nan:
    arm64.fcmp d1, d1
    arm64.cset x0, ne
    arm64.cbnz x0, both_nan
    arm64.b ifcont#12
  both_nan:
    arm64.movImm x0, 1
    arm64.b __il_cont
  ifcont#12:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#13:
    arm64.fcmp d1, d1
    arm64.cset x0, ne
    arm64.cbnz x0, other_nan
    arm64.b ifcont#15
  other_nan:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#15:
    arm64.fcmp d0, d1
    arm64.cset x0, mi
    arm64.cbnz x0, lt
    arm64.b ifcont#17
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#17:
    arm64.fcmp d0, d1
    arm64.cset x0, gt
    arm64.cbnz x0, gt
    arm64.b ifcont#19
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#19:
    arm64.movImm x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext#6:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}
