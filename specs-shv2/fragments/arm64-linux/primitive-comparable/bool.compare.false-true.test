// Test: bool.compare.false-true
function main() returns ExitCode
	let a = false
	let b = true
	let result = a.compare(b)
	match result 'check'
		lessThan then return 0
		equalTo then return 1
		greaterThan then return 1
	end 'check'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 0
  o:
    arm64.movImm x1, 1
  ifcont#13:
    arm64.cmp x0, x1
    arm64.b.ge ifcont#15
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#15:
    arm64.cmp x0, x1
    arm64.b.le ifcont#17
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#17:
    arm64.movImm x0, 1
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.ne matchnext#5
  matcharm#1:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchnext#5:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#6
  matcharm#2:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchnext#6:
    arm64.cmp x0, 2
    arm64.b.ne matchdead
  matcharm#3:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
}
