// Test: f32-arithmetic-uses-ss-instructions
typealias F = float(f32.min to f32.max)

function main() returns ExitCode
	let a = 10.0 as F
	let b = 3.0 as F
	return trunc(a + b)
end 'main'
---
ExitCode: 13
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 13
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
