    arm64.movImm x1, 20
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 30
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 9
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 9
    arm64.cset x0, ls
    arm64.cbnz x0, __im_slow
    arm64.b __im_load
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 72
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.cset x3, ne
    arm64.cbnz x3, __im_empty
    arm64.b critsplit#11
  __im_empty:
    arm64.cmp x0, 0
    arm64.cset x3, eq
    arm64.cbnz x3, __im_slow
    arm64.b critsplit#12
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont
  critsplit#12:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  critsplit#11:
    arm64.movRegReg x9, x2
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.leaRdata x1, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 2
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movImm x1, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x0 + 16], x1
    arm64.movImm x1, 8
    arm64.storeBaseDispReg.word64 [x0 + 24], x1
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.bl __managed_decref
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
