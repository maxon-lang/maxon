// Test: nested-parentheses
function main() returns ExitCode
	return ((5 + 3) * 2) - 6
end 'main'
---
ExitCode: 10
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.add x0, x0, 3
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.sub x0, x0, 6
    arm64.epilogue 16
    arm64.ret
}
