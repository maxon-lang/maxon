// Test: console-stdin.repeat-reads-at-eof-are-idempotent
function main() returns ExitCode
	var stdin = Console.stdin()
	var thrown = 0
	var i = 0
	while i < 3 'again'
		let line = try stdin.readLine() otherwise 'atEof'
			thrown = thrown + 1
			i = i + 1
			continue
		end 'atEof'
		print(line)
		return 1
	end 'again'
	return thrown as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __mrt_errno@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Console.stdin
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x21, 3
    arm64.cset x0, lt
    arm64.cbnz x0, again
    arm64.b whileexit
  again:
    arm64.movRegReg x0, x19
    arm64.bl Stdin.readLine
    arm64.movRegReg x22, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.add x20, x20, 1
    arm64.add x21, x21, 1
    arm64.b whilehdr
  tryok:
    arm64.movRegReg x0, x22
    arm64.bl print
    arm64.movImm x20, 1
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  whileexit:
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_11  ; "panic at console-stdin.repeat-reads-at-eof-are-idempotent.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
