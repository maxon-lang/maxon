// Test: console-stdin.builtin-takes-a-ranged-count
typealias ByteBudget = int(0 to 65535)

function main() returns ExitCode
	let budget = 4096 as ByteBudget
	let mm = __Builtins.readStdin(budget)
	if mm.length() == 0 'eof'
		return 8
	end 'eof'
	return 1
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __mrt_errno@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4096
    arm64.bl __con_read_stdin
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.cset x1, eq
    arm64.cbnz x1, eof
    arm64.b ifcont
  eof:
    arm64.movImm x19, 8
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x19, 1
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
