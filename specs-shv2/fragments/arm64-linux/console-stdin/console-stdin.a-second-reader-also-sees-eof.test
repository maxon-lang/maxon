// Test: console-stdin.a-second-reader-also-sees-eof
function main() returns ExitCode
	var first = Console.stdin()
	let a = try first.readLine() otherwise 'firstAtEof'
		var second = Console.stdin()
		let b = try second.readLine() otherwise 'secondAtEof'
			return 3
		end 'secondAtEof'
		print(b)
		return 1
	end 'firstAtEof'
	print(a)
	return 2
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __mrt_errno@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Console.stdin
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Stdin.readLine
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.bl Console.stdin
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl Stdin.readLine
    arm64.movRegReg x21, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.movImm x21, 3
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movRegReg x0, x21
    arm64.bl print
    arm64.movImm x22, 1
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movRegReg x0, x20
    arm64.bl print
    arm64.movImm x21, 2
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Stdin
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
