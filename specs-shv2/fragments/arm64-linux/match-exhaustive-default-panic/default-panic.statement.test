// Test: default-panic.statement
function main() returns ExitCode
	let x = 2
	match x 'check'
		1 then return 10
		2 then return 20
		default panic("unexpected value")
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.movImm x0, 20
    arm64.epilogue 16
    arm64.ret
}
