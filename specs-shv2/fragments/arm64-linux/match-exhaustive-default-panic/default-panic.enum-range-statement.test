// Test: default-panic.enum-range-statement
typealias Integer = int(i64.min to i64.max)

union Op
	add
	sub
	mul
	exec(code Integer)
end 'Op'

function main() returns ExitCode
	let op = Op.sub
	match op 'check'
		add to mul then return 1
		default panic("unexpected op")
	end 'check'
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, ge
    arm64.cmp x1, 2
    arm64.cset x1, le
    arm64.and x1, x2, x1
    arm64.cbnz x1, matcharm
    arm64.b matchdefault
  matcharm:
    arm64.movImm x19, 1
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdefault:
    arm64.leaRdata x0, __str_blob_0  ; "panic at default-panic.enum-range-statement.test:15: unexpected op\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchcont:
}
