// Test: name-char-backed
enum CardSuit
	Hearts = 'H'
	Diamonds = 'D'
	Spades = 'S'
end 'CardSuit'

function main() returns ExitCode
	let s = CardSuit.Diamonds
	print("{s.name}\n")
	return 0
end 'main'
