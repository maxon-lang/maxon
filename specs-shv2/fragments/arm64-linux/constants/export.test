// Test: export
// --- file: defs.maxon
export enum Permission
	none = 0
	read = 1
	write = 2
end 'Permission'

// --- file: main.maxon
function main() returns ExitCode
	let p = Permission.read
	if p == Permission.read 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b check
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
