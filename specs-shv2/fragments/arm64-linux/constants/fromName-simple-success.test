// Test: fromName-simple-success
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	let dir = try Direction.fromName("south") otherwise Direction.north
	if dir == Direction.south 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "south"
    arm64.bl __enum_from_name_Direction
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
