// Test: string-rawvalue-dynamic-comparison
enum Planet
	earth = "Earth"
	mars = "Mars"
end 'Planet'

function getName() returns String
	return "Mars"
end 'getName'

function main() returns ExitCode
	let p = Planet.mars
	// Print the `.rawValue` and the dynamically-computed string; identical
	// output shows they match (comparing the accessor with `==` is E3097).
	let name = p.rawValue
	let expected = getName()
	print("{name}\n{expected}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @getName {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_3  ; "Mars"
    arm64.bl __str_retain
    arm64.epilogue 16
    arm64.ret
}

