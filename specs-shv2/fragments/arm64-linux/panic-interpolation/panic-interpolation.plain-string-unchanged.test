// Test: panic-interpolation.plain-string-unchanged
function main() returns ExitCode
		if true 'check'
				panic("simple message")
		end 'check'
		return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b check
  check:
    arm64.leaRdata x0, __str_blob_0  ; "panic at panic-interpolation.plain-string-unchanged.test:4: simple message\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
