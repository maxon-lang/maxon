// Test: map-type-in-field
typealias StrMap = Map with (String, String)

type Container
	export var data as StrMap

	static function create(data StrMap) returns Self
		return Self{data: data}
	end 'create'
end 'Container'

function main() returns ExitCode
	var m = StrMap.create()
	try m.insert("key", value: "val") otherwise ignore
	let c = Container.create(m)
	let result = try c.data.get("key") otherwise ""
	if result == "val" 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Container.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Map_String_String
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Map_String_String
    arm64.leaRdata x1, __witness_String.Hashable
    arm64.leaRdata x2, __witness_String.Equatable
    arm64.bl Map.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_3  ; "key"
    arm64.leaRdata x20, __str_rec_4  ; "val"
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x0, x22, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.add x24, x23, 56
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x24, x22
    arm64.storeBaseDispReg.word64 [x23 + 0], x24
    arm64.storeBaseDispReg.word64 [x23 + 8], x22
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x23 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 24], x0
    arm64.loadRegBaseDisp.word64 x21, [x20 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x20 + 8]
    arm64.add x0, x20, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.add x24, x22, 56
    arm64.movRegReg x0, x24
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x0, x24, x20
    arm64.storeBaseDispReg.word64 [x22 + 0], x24
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x22 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 24], x0
    arm64.leaRdata x3, __layout_Map_String_String
    arm64.leaRdata x4, __witness_String.Hashable
    arm64.leaRdata x5, __witness_String.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x22
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.b.ne trycont#3
  trycont#3:
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.bl Container.create
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.leaRdata x1, __str_rec_3  ; "key"
    arm64.leaRdata x2, __layout_Map_String_String
    arm64.leaRdata x3, __witness_String.Hashable
    arm64.leaRdata x4, __witness_String.Equatable
    arm64.bl Map.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_rec_5  ; ""
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
    arm64.b trycont#6
  tryok:
    arm64.movRegReg x21, x0
  trycont#6:
    arm64.leaRdata x1, __str_rec_4  ; "val"
    arm64.movRegReg x0, x21
    arm64.bl __str_eq
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x22, 42
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Container
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Map_String_String
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x22, 0
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Container
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Map_String_String
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}
