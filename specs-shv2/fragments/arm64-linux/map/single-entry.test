// Test: single-entry
function main() returns ExitCode
	let m = [42: 99]
	let result = try m.get(42) otherwise 0
	return result
end 'main'
---
ExitCode: 99
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 42
    arm64.movImm x20, 99
    arm64.leaRdata x0, __layout_Map_int_int
    arm64.leaRdata x1, __witness_int.Hashable
    arm64.leaRdata x2, __witness_int.Equatable
    arm64.bl Map.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x3, __layout_Map_int_int
    arm64.leaRdata x4, __witness_int.Hashable
    arm64.leaRdata x5, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl Map.upsert
    arm64.movImm x1, 42
    arm64.leaRdata x2, __layout_Map_int_int
    arm64.leaRdata x3, __witness_int.Hashable
    arm64.leaRdata x4, __witness_int.Equatable
    arm64.movRegReg x0, x21
    arm64.bl Map.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
  trycont:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Map_int_int
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_22  ; "panic at single-entry.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
