// Test: for-in-nested
typealias Int = int(i64.min to i64.max)
typealias IntArray = Array with Int

function innerSum(arr IntArray) returns Int
	var total = 0
	for item in arr 'inner'
		total = total + item
	end 'inner'
	return total
end 'innerSum'

function main() returns ExitCode
	var arr = IntArray.create()
	arr.push(1)
	arr.push(2)
	arr.push(3)

	var outerTotal = 0
	for item in arr 'outer'
		outerTotal = outerTotal + item + innerSum(arr)
	end 'outer'

	// Each outer item: item + innerSum(arr) = item + 6
	// Outer loop: (1+6) + (2+6) + (3+6) = 7+8+9 = 24
	if outerTotal == 24 'check'
		return 0
	end 'check'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x3, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x4, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x5, [x19 + 0]
    arm64.b forhdr#1
  forhdr#1:
    arm64.cmp x1, x2
    arm64.cset x6, lt
    arm64.cbnz x6, outer
    arm64.b forexit#4
  outer:
    arm64.arm64AddLsl x6, x3, x1, lsl #3
    arm64.loadRegBaseDisp.word64 x6, [x6 + 0]
    arm64.b __im_cont#7
  __im_cont#7:
    arm64.add x0, x0, x6
    arm64.b __il_body
  __il_body:
    arm64.movImm x6, 0
    arm64.movImm x7, 0
    arm64.b forhdr#10
  forhdr#10:
    arm64.cmp x7, x4
    arm64.cset x8, lt
    arm64.cbnz x8, inner
    arm64.b forexit#13
  inner:
    arm64.arm64AddLsl x8, x5, x7, lsl #3
    arm64.loadRegBaseDisp.word64 x8, [x8 + 0]
    arm64.b __im_cont#14
  __im_cont#14:
    arm64.add x6, x6, x8
    arm64.b forstep#12
  forstep#12:
    arm64.add x7, x7, 1
    arm64.b forhdr#10
  forexit#13:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, x6
    arm64.b forstep#3
  forstep#3:
    arm64.add x1, x1, 1
    arm64.b forhdr#1
  forexit#4:
    arm64.cmp x0, 24
    arm64.cset x0, eq
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
