// Test: filepath-is-absolute-unc
function main() returns ExitCode
	let p = FilePath from "\\\\server\\share"
	if p.isAbsolute() 'abs'
		print("absolute\n")
	end 'abs'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_18  ; "\\\\server\\share"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl FilePath.isAbsolute
    arm64.cbnz x0, abs
    arm64.b ifcont
  abs:
    arm64.leaRdata x0, __str_rec_19  ; "absolute\x0a"
    arm64.bl print
    arm64.b ifcont
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
