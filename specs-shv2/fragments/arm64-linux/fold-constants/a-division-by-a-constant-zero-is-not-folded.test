// Test: a-division-by-a-constant-zero-is-not-folded
typealias Word = int(i64.min to i64.max)

function pick(a Word) returns Word
	return a
end 'pick'

function main() returns ExitCode
	let ten = pick(10)
	let zero = pick(0)
	if (try (ten / zero) otherwise -77) != -77 'quotientByZeroStillThrows'
		return 1
	end 'quotientByZeroStillThrows'
	if (try (ten mod zero) otherwise -78) != -78 'remainderByZeroStillThrows'
		return 2
	end 'remainderByZeroStillThrows'
	if (try (ten / pick(3)) otherwise -79) != 3 'anOrdinaryDivisionStillDivides'
		return 3
	end 'anOrdinaryDivisionStillDivides'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.b __il_body#18
  __il_body#18:
    arm64.b __il_cont#17
  __il_cont#17:
    arm64.movImm x1, 0
    arm64.b __il_body#19
  __il_body#19:
    arm64.b __il_cont#16
  __il_cont#16:
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.sdiv x3, x0, x2
    arm64.cmp x2, 0
    arm64.cset x4, ne
    arm64.cbnz x4, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x3, 18446744073709551539
    arm64.b trycont#3
  tryok#1:
    arm64.b trycont#3
  trycont#3:
    arm64.cmp x3, -77
    arm64.cset x3, ne
    arm64.cbnz x3, quotientByZeroStillThrows
    arm64.b ifcont#5
  quotientByZeroStillThrows:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#5:
    arm64.cmp x1, -1
    arm64.cset x1, eq
    arm64.add x1, x1, -1
    arm64.movImm x16, 10
    arm64.and x1, x1, x16
    arm64.sdiv x16, x1, x2
    arm64.msub x1, x16, x2, x1
    arm64.cbnz x4, tryerr#7
    arm64.b tryok#6
  tryerr#7:
    arm64.movImm x1, 18446744073709551538
    arm64.b trycont#8
  tryok#6:
    arm64.b trycont#8
  trycont#8:
    arm64.cmp x1, -78
    arm64.cset x1, ne
    arm64.cbnz x1, remainderByZeroStillThrows
    arm64.b ifcont#10
  remainderByZeroStillThrows:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#10:
    arm64.b __il_body#21
  __il_body#21:
    arm64.b __il_cont#20
  __il_cont#20:
    arm64.movImm x1, 3
    arm64.sdiv x0, x0, x1
    arm64.b tryok#11
  tryok#11:
    arm64.b trycont#13
  trycont#13:
    arm64.cmp x0, 3
    arm64.cset x0, ne
    arm64.cbnz x0, anOrdinaryDivisionStillDivides
    arm64.b ifcont#15
  anOrdinaryDivisionStillDivides:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#15:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
