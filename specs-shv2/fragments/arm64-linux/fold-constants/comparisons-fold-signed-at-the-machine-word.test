// Test: comparisons-fold-signed-at-the-machine-word
typealias Word = int(i64.min to i64.max)

function less(a Word, b Word) returns bool
	return a < b
end 'less'

function equal(a Word, b Word) returns bool
	return a == b
end 'equal'

function main() returns ExitCode
	if not less(-1, b: 0) 'negativeIsLessThanZero'
		return 1
	end 'negativeIsLessThanZero'
	if less(0, b: -1) 'zeroIsNotLessThanNegative'
		return 2
	end 'zeroIsNotLessThanNegative'
	if not less(i64.min, b: i64.max) 'theWholeSpan'
		return 3
	end 'theWholeSpan'
	if not equal(-1, b: -1) 'equality'
		return 4
	end 'equality'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#10
  __il_body#10:
    arm64.movImm x0, 1
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, negativeIsLessThanZero
    arm64.b ifcont#2
  negativeIsLessThanZero:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#12
  __il_body#12:
    arm64.b __il_cont#11
  __il_cont#11:
    arm64.b ifcont#4
  ifcont#4:
    arm64.b __il_body#14
  __il_body#14:
    arm64.movImm x0, 1
    arm64.b __il_cont#13
  __il_cont#13:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, theWholeSpan
    arm64.b ifcont#6
  theWholeSpan:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.b __il_body#16
  __il_body#16:
    arm64.movImm x0, 1
    arm64.b __il_cont#15
  __il_cont#15:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, equality
    arm64.b ifcont#8
  equality:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
