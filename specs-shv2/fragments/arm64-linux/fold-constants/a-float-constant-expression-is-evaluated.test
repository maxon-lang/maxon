// Test: a-float-constant-expression-is-evaluated
typealias Real = float(f64.min to f64.max)

function scaleF(a Real, b Real) returns Real
	return a * b
end 'scaleF'

function addF(a Real, b Real) returns Real
	return a + b
end 'addF'

function main() returns ExitCode
	if scaleF(2.5, b: 4.0) != 10.0 'product'
		return 1
	end 'product'
	if addF(0.5, b: 0.25) != 0.75 'sum'
		return 2
	end 'sum'
	if scaleF(-1.5, b: 2.0) != -3.0 'negativeProduct'
		return 3
	end 'negativeProduct'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#8
  __il_body#8:
    arm64.fpLoadRdata d0, [rdata + __fconst_10]
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.fpLoadRdata d1, [rdata + __fconst_10]
    arm64.fcmp d0, d1
    arm64.cset x0, ne
    arm64.cbnz x0, product
    arm64.b ifcont#2
  product:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#10
  __il_body#10:
    arm64.fpLoadRdata d0, [rdata + __fconst_0.75]
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.fpLoadRdata d1, [rdata + __fconst_0.75]
    arm64.fcmp d0, d1
    arm64.cset x0, ne
    arm64.cbnz x0, sum
    arm64.b ifcont#4
  sum:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.b __il_body#12
  __il_body#12:
    arm64.fpLoadRdata d0, [rdata + __fconst_-3]
    arm64.b __il_cont#11
  __il_cont#11:
    arm64.fpLoadRdata d1, [rdata + __fconst_-3]
    arm64.fcmp d0, d1
    arm64.cset x0, ne
    arm64.cbnz x0, negativeProduct
    arm64.b ifcont#6
  negativeProduct:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
