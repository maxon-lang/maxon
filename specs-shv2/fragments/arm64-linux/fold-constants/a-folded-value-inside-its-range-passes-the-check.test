// Test: a-folded-value-inside-its-range-passes-the-check
typealias Word = int(i64.min to i64.max)
typealias Small = int(0 to 100)

function scale(a Word, b Word) returns Word
	return a * b
end 'scale'

function main() returns ExitCode
	let v = scale(25, b: 2) as Small
	if v != 50 'value'
		return 1
	end 'value'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 50
  __il_cont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-folded-value-inside-its-range-passes-the-check.test:10: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.cmp x0, 50
    arm64.b.eq ifcont
  value:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
