// Test: a-negation-of-a-constant-is-evaluated
typealias Word = int(i64.min to i64.max)

function negate(a Word) returns Word
	return -a
end 'negate'

function complement(a Word) returns Word
	return not a
end 'complement'

function main() returns ExitCode
	if negate(42) != -42 'negative'
		return 1
	end 'negative'
	if negate(-9223372036854775808) != -9223372036854775808 'wraps'
		return 2
	end 'wraps'
	if complement(0) != -1 'allOnes'
		return 3
	end 'allOnes'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#8
  __il_body#8:
    arm64.movImm x0, 18446744073709551574
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cmp x0, -42
    arm64.cset x0, ne
    arm64.cbnz x0, negative
    arm64.b ifcont#2
  negative:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#10
  __il_body#10:
    arm64.movImm x0, 9223372036854775808
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.movImm x1, 9223372036854775808
    arm64.cmp x0, x1
    arm64.cset x0, ne
    arm64.cbnz x0, wraps
    arm64.b ifcont#4
  wraps:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.b __il_body#12
  __il_body#12:
    arm64.movImm x0, 18446744073709551615
    arm64.b __il_cont#11
  __il_cont#11:
    arm64.cmp x0, -1
    arm64.cset x0, ne
    arm64.cbnz x0, allOnes
    arm64.b ifcont#6
  allOnes:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
