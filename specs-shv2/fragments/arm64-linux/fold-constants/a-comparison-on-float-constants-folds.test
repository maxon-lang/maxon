// Test: a-comparison-on-float-constants-folds
typealias Real = float(f64.min to f64.max)

function greater(a Real, b Real) returns bool
	return a > b
end 'greater'

function equal(a Real, b Real) returns bool
	return a == b
end 'equal'

function main() returns ExitCode
	if not greater(-1.0, b: -2.0) 'negativesOrderAsNumbers'
		return 1
	end 'negativesOrderAsNumbers'
	if greater(-2.0, b: -1.0) 'andNotBackwards'
		return 2
	end 'andNotBackwards'
	if not equal(-0.0, b: 0.0) 'theTwoZerosCompareEqual'
		return 3
	end 'theTwoZerosCompareEqual'

	var taken = 0
	if greater(2.5, b: 1.5) 'thenArm'
		taken = 7
	end 'thenArm' else 'elseArm'
		taken = 11
	end 'elseArm'
	if taken != 7 'thenArmRan'
		return 4
	end 'thenArmRan'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#13
  __il_body#13:
    arm64.movImm x0, 1
    arm64.b __il_cont#12
  __il_cont#12:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, negativesOrderAsNumbers
    arm64.b ifcont#2
  negativesOrderAsNumbers:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#15
  __il_body#15:
    arm64.b __il_cont#14
  __il_cont#14:
    arm64.b ifcont#4
  ifcont#4:
    arm64.b __il_body#17
  __il_body#17:
    arm64.movImm x0, 1
    arm64.b __il_cont#16
  __il_cont#16:
    arm64.eor x0, x0, 1
    arm64.cbnz x0, theTwoZerosCompareEqual
    arm64.b ifcont#6
  theTwoZerosCompareEqual:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.b __il_body#19
  __il_body#19:
    arm64.b __il_cont#18
  __il_cont#18:
    arm64.b thenArm
  thenArm:
    arm64.movImm x0, 7
    arm64.b ifcont#9
  ifcont#9:
    arm64.cmp x0, 7
    arm64.cset x0, ne
    arm64.cbnz x0, thenArmRan
    arm64.b ifcont#11
  thenArmRan:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#11:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
