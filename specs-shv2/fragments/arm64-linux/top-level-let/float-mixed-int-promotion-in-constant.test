// Test: float-mixed-int-promotion-in-constant
let M = 1 + 2.0
let N = 5 * 1.5

function main() returns ExitCode
	return trunc(M) * 10 + trunc(N)
end 'main'
---
ExitCode: 37
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 37
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
