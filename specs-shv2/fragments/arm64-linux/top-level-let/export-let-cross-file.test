// Test: export-let-cross-file
// --- file: api/constants.maxon
export let MAGIC = 42
export let OFFSET = -10

// --- file: app/main.maxon
function main() returns ExitCode
	return MAGIC + OFFSET
end 'main'
---
ExitCode: 32
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 32
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
