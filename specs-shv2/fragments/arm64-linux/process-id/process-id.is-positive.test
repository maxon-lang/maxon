// Test: process-id.is-positive
function main() returns ExitCode
	let pid = __Builtins.currentProcessId()
	if pid > 0 'positive'
		return 3
	end 'positive'
	return 1
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.bl __proc_pid
    arm64.cmp x0, 0
    arm64.b.le ifcont
  positive:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
