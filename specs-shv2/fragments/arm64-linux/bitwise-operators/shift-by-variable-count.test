// Test: shift-by-variable-count
function main() returns ExitCode
	let a = 7
	let count = 64
	if a shl count != 0 'wrong'
		return 1
	end 'wrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, wrong
    arm64.b ifcont
  wrong:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
