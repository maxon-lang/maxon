// Test: shift-count-arithmetic
function main() returns ExitCode
	let a = 1
	if a shl 63 + 1 != 0 'addWrong'
		return 1
	end 'addWrong'
	if a shl 2 * 32 != 0 'mulWrong'
		return 2
	end 'mulWrong'
	if a shl 128 / 2 != 0 'divWrong'
		return 3
	end 'divWrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 63
    arm64.add x0, x0, 1
    arm64.movImm x0, 0
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, addWrong
    arm64.b ifcont
  addWrong:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 2
    arm64.movImm x16, 32
    arm64.mul x0, x0, x16
    arm64.movImm x0, 0
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, mulWrong
    arm64.b ifcont
  mulWrong:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 128
    arm64.movImm x1, 2
    arm64.sdiv x0, x0, x1
    arm64.movImm x0, 0
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, divWrong
    arm64.b ifcont
  divWrong:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
