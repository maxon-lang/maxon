// Test: shift-count-arithmetic
function main() returns ExitCode
	let a = 1
	if a shl 63 + 1 != 0 'addWrong'
		return 1
	end 'addWrong'
	if a shl 2 * 32 != 0 'mulWrong'
		return 2
	end 'mulWrong'
	if a shl 128 / 2 != 0 'divWrong'
		return 3
	end 'divWrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b ifcont#2
  ifcont#2:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x0, 128
    arm64.movImm x1, 2
    arm64.sdiv x0, x0, x1
    arm64.b ifcont#6
  ifcont#6:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
