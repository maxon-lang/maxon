// Test: an-and-result-is-no-proof-of-a-low-bound-above-zero
typealias Small = int(1 to 100)
typealias Num = int(i64.min to i64.max)

function guarded(a Small, b Small) returns Num
	return try (100 / (a and b)) otherwise 7
end 'guarded'

function main() returns ExitCode
	if guarded(1, b: 2) != 7 'zeroIsCaught'
		return 1
	end 'zeroIsCaught'
	return 42
end 'main'
---
ExitCode: 42
---
func @guarded {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 1
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic#5
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.cmp x0, 100
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic#5
    arm64.b __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-and-result-is-no-proof-of-a-low-bound-above-zero.test:5: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#4:
    arm64.cmp x1, 1
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic#8
    arm64.b __rc_chk#9
  __rc_chk#9:
    arm64.cmp x1, 100
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic#8
    arm64.b __rc_ok#7
  __rc_panic#8:
    arm64.leaRdata x0, __str_blob_0  ; "panic at an-and-result-is-no-proof-of-a-low-bound-above-zero.test:5: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#7:
    arm64.movImm x2, 100
    arm64.and x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.orr x0, x0, x1
    arm64.sdiv x0, x2, x0
    arm64.cmp x1, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 7
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.bl guarded
    arm64.cmp x0, 7
    arm64.cset x0, ne
    arm64.cbnz x0, zeroIsCaught
    arm64.b ifcont
  zeroIsCaught:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
