// Test: shift-signedness-follows-the-cast-in-both-directions
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function sourceKeepsItsOwnType(p Num) returns Num
	let w = p as Wide
	return (w shr 60) - (p shr 60)
end 'sourceKeepsItsOwnType'

function castToSigned(v Wide) returns Num
	let n = v as Num
	return n shr 60
end 'castToSigned'

function main() returns ExitCode
	if sourceKeepsItsOwnType(u64.max) != 16 'sourceKeeps'
		return 1
	end 'sourceKeeps'
	if castToSigned(u64.max) != -1 'toSigned'
		return 2
	end 'toSigned'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#6
  __il_body#6:
    arm64.movImm x0, 16
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.cmp x0, 16
    arm64.cset x0, ne
    arm64.cbnz x0, sourceKeeps
    arm64.b ifcont#2
  sourceKeeps:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#8
  __il_body#8:
    arm64.movImm x0, 18446744073709551615
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cmp x0, -1
    arm64.cset x0, ne
    arm64.cbnz x0, toSigned
    arm64.b ifcont#4
  toSigned:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
