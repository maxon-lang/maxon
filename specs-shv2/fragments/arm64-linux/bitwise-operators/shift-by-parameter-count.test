// Test: shift-by-parameter-count
typealias Num = int(i64.min to i64.max)

function shiftLeft(value Num, count Num) returns Num
	return value shl count
end 'shiftLeft'

function shiftRight(value Num, count Num) returns Num
	return value shr count
end 'shiftRight'

function main() returns ExitCode
	if shiftLeft(7, count: 65) != 0 'shlPastWidth'
		return 1
	end 'shlPastWidth'
	if shiftLeft(7, count: 3) != 56 'shlInRange'
		return 2
	end 'shlInRange'
	if shiftRight(-1, count: 100) != -1 'shrNegPastWidth'
		return 3
	end 'shrNegPastWidth'
	if shiftRight(8, count: 100) != 0 'shrPosPastWidth'
		return 4
	end 'shrPosPastWidth'
	if shiftRight(-8, count: 1) != -4 'shrInRange'
		return 5
	end 'shrInRange'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 7
    arm64.movImm x1, 65
    arm64.b __il_body#12
  __il_body#12:
    arm64.lslv x0, x0, x1
    arm64.movImm x16, 0
    arm64.and x0, x0, x16
    arm64.b __il_cont#11
  __il_cont#11:
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, shlPastWidth
    arm64.b ifcont#2
  shlPastWidth:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#14
  __il_body#14:
    arm64.movImm x0, 56
    arm64.b __il_cont#13
  __il_cont#13:
    arm64.cmp x0, 56
    arm64.cset x0, ne
    arm64.cbnz x0, shlInRange
    arm64.b ifcont#4
  shlInRange:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 18446744073709551615
    arm64.b __il_body#16
  __il_body#16:
    arm64.movImm x1, 18446744073709551615
    arm64.asrv x0, x0, x1
    arm64.b __il_cont#15
  __il_cont#15:
    arm64.cmp x0, -1
    arm64.cset x0, ne
    arm64.cbnz x0, shrNegPastWidth
    arm64.b ifcont#6
  shrNegPastWidth:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 8
    arm64.b __il_body#18
  __il_body#18:
    arm64.movImm x1, 18446744073709551615
    arm64.asrv x0, x0, x1
    arm64.b __il_cont#17
  __il_cont#17:
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, shrPosPastWidth
    arm64.b ifcont#8
  shrPosPastWidth:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#8:
    arm64.b __il_body#20
  __il_body#20:
    arm64.movImm x0, 18446744073709551612
    arm64.b __il_cont#19
  __il_cont#19:
    arm64.cmp x0, -4
    arm64.cset x0, ne
    arm64.cbnz x0, shrInRange
    arm64.b ifcont#10
  shrInRange:
    arm64.movImm x0, 5
    arm64.epilogue 16
    arm64.ret
  ifcont#10:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
