    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 63
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at proven-count-at-the-boundary.test:6: Range check failed: value outside typealias 'Bits'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.lslv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

