// Test: a-merged-count-is-not-proven-around-a-loop
typealias Num = int(i64.min to i64.max)
typealias Word = int(0 to u64.max)
typealias Bits = int(0 to 63)

function main() returns ExitCode
	var n = 1 as Bits
	var i = 0 as Num
	while i < 7 'step'
		n = n + 10
		i = i + 1
	end 'step'

	// The premise, asserted before it is spent: the merge really does hold a value its alias cannot.
	if n != 71 'reached'
		return 1
	end 'reached'

	if 1 shl n != 0 'shl'
		return 2
	end 'shl'
	let negative = -4
	if negative shr n != -1 'shrSign'
		return 3
	end 'shrSign'

	let w = u64.max as Word
	if w shr n != 0 'shrZeroFill'
		return 4
	end 'shrZeroFill'

	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 0
  whilehdr:
    arm64.cmp x1, 7
    arm64.b.ge whileexit
  step:
    arm64.add x0, x0, 10
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.cmp x0, 71
    arm64.b.eq ifcont#5
  reached:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#5:
    arm64.movImm x1, 1
    arm64.and x2, x0, -64
    arm64.neg x3, x2
    arm64.orr x2, x2, x3
    arm64.asr x2, x2, 63
    arm64.lslv x1, x1, x0
    arm64.mvn x3, x2
    arm64.and x1, x1, x3
    arm64.cmp x1, 0
    arm64.b.eq ifcont#7
  shl:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#7:
    arm64.movImm x1, 18446744073709551612
    arm64.orr x2, x0, x2
    arm64.asrv x1, x1, x2
    arm64.cmp x1, -1
    arm64.b.eq ifcont#9
  shrSign:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#9:
    arm64.movImm x1, 18446744073709551615
    arm64.lsrv x0, x1, x0
    arm64.and x0, x0, x3
    arm64.cmp x0, 0
    arm64.b.eq ifcont#11
  shrZeroFill:
    arm64.movImm x0, 4
    arm64.epilogue 16
    arm64.ret
  ifcont#11:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
