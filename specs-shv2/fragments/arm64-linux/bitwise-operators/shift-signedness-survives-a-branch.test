// Test: shift-signedness-survives-a-branch
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function afterBranch(v Wide, flag bool) returns Wide
	if flag 'taken'
		return v shr 60
	end 'taken'
	return 0
end 'afterBranch'

function insideLoop(v Wide, n Num) returns Wide
	var acc = 0
	var i = 0
	while i < n 'each'
		acc = v shr 60
		i = i + 1
	end 'each'
	return acc
end 'insideLoop'

function main() returns ExitCode
	if afterBranch(u64.max, flag: true) != 15 'branch'
		return 1
	end 'branch'
	if insideLoop(u64.max, n: 3) != 15 'loop'
		return 2
	end 'loop'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#6
  __il_body#6:
    arm64.b taken
  taken:
    arm64.movImm x0, 15
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.cmp x0, 15
    arm64.cset x0, ne
    arm64.cbnz x0, branch
    arm64.b ifcont#2
  branch:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#10
  __il_body#10:
    arm64.movImm x0, 0
    arm64.movImm x1, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x1, 3
    arm64.cset x2, lt
    arm64.cbnz x2, each
    arm64.b whileexit
  each:
    arm64.movImm x0, 15
    arm64.add x1, x1, 1
    arm64.b whilehdr
  whileexit:
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.cmp x0, 15
    arm64.cset x0, ne
    arm64.cbnz x0, loop
    arm64.b ifcont#4
  loop:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
