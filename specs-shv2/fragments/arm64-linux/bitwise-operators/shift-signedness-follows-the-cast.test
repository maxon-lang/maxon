// Test: shift-signedness-follows-the-cast
typealias Wide = int(0 to u64.max)
typealias Num = int(i64.min to i64.max)

function viaCast(p Num) returns Wide
	let w = p as Wide
	return w shr 60
end 'viaCast'

function viaParam(w Wide) returns Wide
	return w shr 60
end 'viaParam'

function main() returns ExitCode
	if viaParam(u64.max) != 15 'declaredParam'
		return 1
	end 'declaredParam'
	if viaCast(u64.max) != 15 'castLocal'
		return 2
	end 'castLocal'
	if viaCast(u64.max) != viaParam(u64.max) 'twoRoutesOneType'
		return 3
	end 'twoRoutesOneType'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#8
  __il_body#8:
    arm64.movImm x0, 15
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.cmp x0, 15
    arm64.cset x0, ne
    arm64.cbnz x0, declaredParam
    arm64.b ifcont#2
  declaredParam:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#2:
    arm64.b __il_body#10
  __il_body#10:
    arm64.movImm x0, 15
    arm64.b __il_cont#9
  __il_cont#9:
    arm64.cmp x0, 15
    arm64.cset x0, ne
    arm64.cbnz x0, castLocal
    arm64.b ifcont#4
  castLocal:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.b __il_body#13
  __il_body#13:
    arm64.movImm x0, 15
    arm64.b __il_cont#12
  __il_cont#12:
    arm64.b __il_body#14
  __il_body#14:
    arm64.b __il_cont#11
  __il_cont#11:
    arm64.cmp x0, 15
    arm64.cset x0, ne
    arm64.cbnz x0, twoRoutesOneType
    arm64.b ifcont#6
  twoRoutesOneType:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
