// Test: bitwise-and-or-precedence
function main() returns ExitCode
	// and has higher precedence than or
	// 12 and 10 = 8, then 8 or 1 = 9
	return 12 and 10 or 1
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 12
    arm64.movImm x16, 10
    arm64.and x0, x0, x16
    arm64.orr x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}
