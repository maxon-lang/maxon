// Test: shr-is-arithmetic
function main() returns ExitCode
	let neg = -8
	if neg shr 60 != -1 'sixtyWrong'
		return 1
	end 'sixtyWrong'
	if neg shr 1 != -4 'oneWrong'
		return 2
	end 'oneWrong'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b ifcont#2
  ifcont#2:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
