// Test: a-count-whose-alias-reaches-below-zero-keeps-the-guard
typealias Num = int(i64.min to i64.max)
typealias Word = int(0 to u64.max)
typealias Small = int(-1 to 5)

function shlBy(value Num, n Small) returns Num
	return value shl n
end 'shlBy'

function shrBy(value Num, n Small) returns Num
	return value shr n
end 'shrBy'

function shrWordBy(value Word, n Small) returns Word
	return value shr n
end 'shrWordBy'

function below(step Num) returns Small
	return (-step) as Small
end 'below'

function main() returns ExitCode
	let negative = below(1)

	if shlBy(1, n: negative) != 0 'shl'
		return 1
	end 'shl'
	if shrBy(-4, n: negative) != -1 'shrSign'
		return 2
	end 'shrSign'
	if shrWordBy(u64.max, n: negative) != 0 'shrZeroFill'
		return 3
	end 'shrZeroFill'

	// The in-range end of the same alias, so the case cannot pass by refusing the whole type.
	if shlBy(1, n: below(-5)) != 32 'shlInRange'
		return 4
	end 'shlInRange'

	return 42
end 'main'
---
ExitCode: 42
---
func @shlBy {
  entry:
    arm64.prologue 16
    arm64.cmp x1, -1
    arm64.cset x2, lt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x1, 5
    arm64.cset x2, gt
    arm64.cbnz x2, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-count-whose-alias-reaches-below-zero-keeps-the-guard.test:6: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.and x2, x1, -64
    arm64.neg x3, x2
    arm64.orr x2, x2, x3
    arm64.asr x2, x2, 63
    arm64.lslv x0, x0, x1
    arm64.mvn x1, x2
    arm64.and x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

