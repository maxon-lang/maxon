// Test: string-char-not-found
function main() returns ExitCode
	let s = "hello world"
	if s.contains('z') 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_2  ; "hello world"
    arm64.leaRdata x1, __str_rec_3  ; "z"
    arm64.bl String.contains#Character
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
