// Test: add-labelled
function add(a int, b int) returns int
	return a + b
end 'add'

function main() returns ExitCode
	return add(2, b: 3)
end 'main'
---
ExitCode: 5
---
func @add {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.movImm x1, 3
    arm64.bl add
    arm64.epilogue 16
    arm64.ret
}
