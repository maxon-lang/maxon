// Test: call-in-loop
function dbl(x int) returns int
	return x + x
end 'dbl'

function main() returns ExitCode
	var sum = 0
	var i = 1
	while i <= 4 'loop'
		sum = sum + dbl(i)
		i = i + 1
	end 'loop'
	return sum
end 'main'
---
ExitCode: 20
---
func @dbl {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 1
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 4
    arm64.cset x0, le
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movRegReg x0, x20
    arm64.bl dbl
    arm64.add x19, x19, x0
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
