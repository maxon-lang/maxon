// Test: call-result-in-expression
function add(a Integer, b Integer) returns Integer
	return a + b
end 'add'

function main() returns ExitCode
	return add(2, b: 3) + add(10, b: 20) * 2
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 65
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#6
  __il_body#6:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#7
  __il_body#7:
    arm64.movImm x0, 30
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.add x0, x0, 5
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at call-result-in-expression.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
