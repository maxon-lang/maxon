// Test: negating-nan-flips-its-sign-bit
function main() returns ExitCode
	let quietNan = __Builtins.bitsToFloat(0x7FF8000000000000)
	if Math.hasNegativeSignBit(quietNan) 'arrivedNegative'
		return 1
	end 'arrivedNegative'
	let negated = -quietNan
	if not Math.hasNegativeSignBit(negated) 'signBitNotFlipped'
		return 2
	end 'signBitNotFlipped'
	if negated == negated 'notANan'
		return 3
	end 'notANan'
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0x7ff8000000000000]
  ifcont#2:
    arm64.fneg d0, d0
  __il_body:
    arm64.fmov x0, d0
    arm64.cmp x0, 0
    arm64.cset x0, lt
  __il_cont:
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont#4
  signBitNotFlipped:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.fcmp d0, d0
    arm64.b.ne ifcont#6
  notANan:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
