// Test: negating-a-float-variable
function main() returns ExitCode
	let f = 3.5
	let g = -f
	return trunc(g + 45.5)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fsub d0, d1, d0
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fadd d0, d0, d1
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
