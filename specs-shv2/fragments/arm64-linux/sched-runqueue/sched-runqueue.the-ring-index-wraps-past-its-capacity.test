// Test: sched-runqueue.the-ring-index-wraps-past-its-capacity
// Far above the one yield a healthy round spends — a lost wake is a wrong answer, not a hang.
let settleSpinLimit = 200000

var sum = 0

type Step
	var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	export function tick()
		sum = sum + 1
	end 'tick'
end 'Step'

function main() returns ExitCode
	let h = spawn Step.create()

	var i = 0
	while i < 6000 'rounds'
		h.tick()

		var spins = 0
		while sum <= i and spins < settleSpinLimit 'settle'
			Runtime.yield()
			spins = spins + 1
		end 'settle'

		i = i + 1
	end 'rounds'

	print("sum={sum}")
	return 0 as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __data_sum@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_timer_count@40 = i64 0
  __gt_timer_heap_base@48 = i64 0
  __gt_timer_capacity@56 = i64 0
  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_live_count@96 = i64 0
  __sched_active_workers@104 = i64 1
  __sched_max_active_workers@112 = i64 1
  __sched_tls_index@120 = i64 0
  __sched_tls_teb_offset@128 = i64 0
  __sched_procs@136 = i64 0
  __sched_num_procs@144 = i64 0
  __sched_shutdown_flag@152 = i64 0
  __sched_lock@160 = i64 0
  __mrt_envp@168 = i64 0
  __mrt_tls_next_key@176 = i64 0
  __slab_arena_list@184 = i64 0
  __slab_arena_map_l1@192 = i64 0
  __slab_state@200 = i64 0
}

func @Step.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Step.create
    arm64.movRegReg x1, x0
    arm64.leaFuncAddr x0, Step.__loop
    arm64.leaFuncAddr x2, Step.__abandon
    arm64.bl __svc_spawn
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movImm x19, 0
    arm64.b whilehdr#1
  whilehdr#1:
    arm64.movImm x16, 6000
    arm64.cmp x19, x16
    arm64.cset x0, lt
    arm64.cbnz x0, rounds
    arm64.b whileexit#3
  rounds:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x1, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x1 + 8], x0
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.bl __mbox_send
    arm64.movImm x21, 0
    arm64.b whilehdr#4
  whilehdr#4:
    arm64.leaGlobal x0, __data_sum
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, x19
    arm64.cset x0, le
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.movImm x16, 200000
    arm64.cmp x21, x16
    arm64.cset x0, lt
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, settle
    arm64.b whileexit#8
  settle:
    arm64.bl Runtime.yield
    arm64.add x21, x21, 1
    arm64.b whilehdr#4
  whileexit#8:
    arm64.add x19, x19, 1
    arm64.b whilehdr#1
  whileexit#3:
    arm64.leaRdata x0, __str_rec_1  ; "sum="
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.leaGlobal x0, __data_sum
    arm64.loadRegBaseDisp.word64 x22, [x0 + 0]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x23
    arm64.bl __int_to_string
    arm64.movRegReg x22, x0
    arm64.add x24, x21, x22
    arm64.add x0, x24, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x25, x0
    arm64.add x26, x25, 56
    arm64.movRegReg x0, x26
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x19, x26, x21
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x19, x22
    arm64.storeBaseDispReg.word64 [x25 + 0], x26
    arm64.storeBaseDispReg.word64 [x25 + 8], x24
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x25 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x25 + 24], x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x25
    arm64.bl print
    arm64.movRegReg x0, x25
    arm64.bl __str_decref
    arm64.movImm x19, 0
    arm64.movRegReg x0, x20
    arm64.bl __mbox_handle_drop_box
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
}

func @Step.__loop {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.b serve
  serve:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, stopping
    arm64.b dispatch
  dispatch:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.jumpTable x1, default=stopping [[0]=__shutdown, [1]=tick] @__jumptable_2
  __shutdown:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.storeBaseDispReg.word64 [x20 + 56], x1
    arm64.bl __mm_decref
    arm64.b stopping
  stopping:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_close
    arm64.b drain
  drain:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x1, x0
    arm64.cmp x1, 0
    arm64.cset x0, eq
    arm64.cbnz x0, finished
    arm64.b abandon
  finished:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mbox_service_exit
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  abandon:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_abandon
    arm64.b drain
  tick:
    arm64.b __il_body
  __il_body:
    arm64.leaGlobal x1, __data_sum
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_sum
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.b __il_cont
  __il_cont:
    arm64.bl __mm_decref
    arm64.b serve
}

func @Step.__abandon {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.jumpTable x0, default=abandondrop [[0]=__shutdown, [1]=tick] @__jumptable_3
  __shutdown:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.bl __gt_cell_complete
    arm64.b abandondrop
  tick:
    arm64.b abandondrop
  abandondrop:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
