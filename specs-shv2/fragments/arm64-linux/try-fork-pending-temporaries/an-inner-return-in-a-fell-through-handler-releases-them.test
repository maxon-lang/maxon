// Test: an-inner-return-in-a-fell-through-handler-releases-them
typealias StrArray = Array with String
typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

function consume(argv StrArray, n Integer) returns Integer throws Boom
	if n > 100 'big'
		throw Boom.bad
	end 'big'
	return argv.count() + n
end 'consume'

function run(n Integer) returns Integer
	try consume(["x", "y"], n: n) otherwise 'h'
		if n > 500 'deep'
			return 7
		end 'deep'
	end 'h'
	return 1
end 'run'

function main() returns ExitCode
	return run(900) + run(200) + run(1) as ExitCode
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @consume {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 100
    arm64.cset x2, gt
    arm64.cbnz x2, big
    arm64.b ifcont
  big:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.add x0, x0, x1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @run {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaRdata x20, __str_rec_2  ; "x"
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.leaRdata x0, __str_rec_3  ; "y"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.bl consume
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.cmp x19, 500
    arm64.cset x0, gt
    arm64.cbnz x0, deep
    arm64.b ifcont
  deep:
    arm64.movImm x19, 7
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 900
    arm64.bl run
    arm64.movRegReg x19, x0
    arm64.movImm x0, 200
    arm64.bl run
    arm64.add x19, x19, x0
    arm64.movImm x0, 1
    arm64.bl run
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#2
    arm64.b __rc_chk#3
  __rc_chk#3:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#2
    arm64.b __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_4  ; "panic at an-inner-return-in-a-fell-through-handler-releases-them.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#1:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic#5
    arm64.b __rc_chk#6
  __rc_chk#6:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic#5
    arm64.b __rc_ok#4
  __rc_panic#5:
    arm64.leaRdata x0, __str_blob_4  ; "panic at an-inner-return-in-a-fell-through-handler-releases-them.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok#4:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
