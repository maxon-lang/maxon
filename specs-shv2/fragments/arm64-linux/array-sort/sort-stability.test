  __data_captured@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
  __data_capturing@40 = i1 0
}

func @KeyTag.init {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @KeyTag.compare {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
  __il_body:
    arm64.cmp x0, x1
    arm64.b.ge ifcont#4
  lt:
    arm64.movImm x0, 0
    arm64.b __il_cont
  ifcont#4:
    arm64.cmp x0, x1
    arm64.b.le ifcont#6
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#6:
    arm64.movImm x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 144
    arm64.storeSlotReg slot14, x28
