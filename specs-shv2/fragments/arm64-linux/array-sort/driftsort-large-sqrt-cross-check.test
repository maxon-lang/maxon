    arm64.b __il_cont
  ifcont#4:
    arm64.cmp x0, x1
    arm64.b.le ifcont#6
  gt:
    arm64.movImm x0, 2
    arm64.b __il_cont
  ifcont#6:
    arm64.movImm x0, 1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

