// Test: struct-param

typealias Integer = int(i64.min to i64.max)

type Vec2
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Vec2'

function dot(a Vec2, b Vec2) returns Integer
	return a.x * b.x + a.y * b.y
end 'dot'

function main() returns ExitCode
	let v1 = Vec2.create(3, y: 4)
	let v2 = Vec2.create(2, y: 1)
	return dot(v1, b: v2)
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.leaRegSlot x2, slot0
    arm64.storeBaseDispReg.word64 [x2 + 0], x0
    arm64.storeBaseDispReg.word64 [x2 + 8], x1
    arm64.movImm x0, 2
    arm64.movImm x1, 1
    arm64.leaRegSlot x3, slot2
    arm64.storeBaseDispReg.word64 [x3 + 0], x0
    arm64.storeBaseDispReg.word64 [x3 + 8], x1
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x3 + 0]
    arm64.mul x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x2 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x3 + 8]
    arm64.mul x1, x1, x2
    arm64.add x0, x0, x1
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at struct-param.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.epilogue 48
    arm64.ret
}
