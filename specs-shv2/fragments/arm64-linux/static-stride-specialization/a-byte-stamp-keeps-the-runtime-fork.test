    arm64.movImm x0, 0
    arm64.b __im_cont#15
  __im_slow#16:
    arm64.movRegReg x0, x19
    arm64.bl __managed_set
    arm64.movRegReg x0, x9
  __im_cont#15:
    arm64.cmp x0, 0
    arm64.b.eq tryok#7
  tryerr#8:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-byte-stamp-keeps-the-runtime-fork.test:21: set: index out of range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
