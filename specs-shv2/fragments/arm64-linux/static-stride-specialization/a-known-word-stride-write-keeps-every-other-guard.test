    arm64.add x2, x0, 1
    arm64.cmp x21, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_3  ; "panic at a-known-word-stride-write-keeps-every-other-guard.test:7: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 40]
    arm64.cmp x0, 0
    arm64.b.ne __im_slow
  __im_owned:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 16]
    arm64.cmp x0, 0
    arm64.b.lt __im_slow
  __im_bounds:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.b.hs __im_slow
  __im_buffer:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  __im_viewed:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.b.eq __im_store
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl __managed_set
    arm64.b __im_cont
  __im_store:
    arm64.arm64AddLsl x0, x0, x21, lsl #3
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
    arm64.movImm x0, 0
    arm64.movRegReg x9, x0
  __im_cont:
    arm64.cmp x9, 0
    arm64.b.eq forstep
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-known-word-stride-write-keeps-every-other-guard.test:7: set: index out of range\x0a"
    arm64.bl mrt_panic
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

