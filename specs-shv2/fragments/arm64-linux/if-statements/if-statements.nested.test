// Test: if-statements.nested
function main() returns ExitCode
	let x = 3
	if x == 1 'outer'
		return 1
	end 'outer' else 'else_outer'
		if x == 2 'inner'
			return 2
		end 'inner' else 'else_inner'
			return 3
		end 'else_inner'
	end 'else_outer'
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b ifelse#2
  ifelse#2:
    arm64.b ifelse#4
  ifelse#4:
    arm64.movImm x0, 3
    arm64.epilogue 16
    arm64.ret
}
