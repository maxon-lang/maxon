// Test: if-statements.else-if-chain
function main() returns ExitCode
	let x = 2
	if x == 1 'case1'
		return 1
	end 'case1' else if x == 2 'case2'
		return 2
	end 'case2' else 'default'
		return 0
	end 'default'
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
  case2:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}
