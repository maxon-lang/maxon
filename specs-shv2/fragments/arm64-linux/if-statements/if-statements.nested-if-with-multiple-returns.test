// Test: if-statements.nested-if-with-multiple-returns

typealias Integer = int(i64.min to i64.max)

function test(c Integer, next Integer) returns Integer
	if c == 0 'maybePrefix'
		if next == 1 'isHex'
			return 1
		end 'isHex'
		if next == 2 'isBinary'
			return 2
		end 'isBinary'
	end 'maybePrefix'
	return 42
end 'test'

function main() returns ExitCode
	return test(5, next: 0)
end 'main'
---
ExitCode: 42
---
func @test {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, maybePrefix
    arm64.b ifcont
  maybePrefix:
    arm64.cmp x1, 1
    arm64.cset x0, eq
    arm64.cbnz x0, isHex
    arm64.b ifcont
  isHex:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.cmp x1, 2
    arm64.cset x0, eq
    arm64.cbnz x0, isBinary
    arm64.b ifcont
  isBinary:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.b ifcont
  ifcont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.movImm x1, 0
    arm64.bl test
    arm64.epilogue 16
    arm64.ret
}
