// Test: if-statements.else-if-in-helper

typealias Integer = int(i64.min to i64.max)

function classify(x Integer) returns Integer
	if x == 0 'zero'
		return 0
	end 'zero' else if x < 10 'small'
		return 1
	end 'small' else if x < 100 'medium'
		return 2
	end 'medium' else 'large'
		return 3
	end 'large'
end 'classify'

function main() returns ExitCode
	let a = classify(0)
	let b = classify(5)
	let c = classify(50)
	let d = classify(200)
	return a + b * 3 + c * 9 + d * 27
end 'main'
---
ExitCode: 102
---
func @main {
  entry:
    arm64.prologue 16
  zero:
    arm64.movImm x0, 0
  small:
    arm64.movImm x1, 1
  medium:
    arm64.movImm x2, 2
  ifelse:
    arm64.movImm x3, 3
  __il_cont:
    arm64.movImm x16, 3
    arm64.mul x1, x1, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 9
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 27
    arm64.mul x1, x3, x16
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at if-statements.else-if-in-helper.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
