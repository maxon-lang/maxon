// Test: if-statements.else-false
function main() returns ExitCode
	let x = 3
	if x > 5 'gt5'
		return 1
	end 'gt5' else 'not_gt5'
		return 0
	end 'not_gt5'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.cmp x0, 5
    arm64.cset x0, gt
    arm64.cbnz x0, gt5
    arm64.b ifelse
  gt5:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
}
