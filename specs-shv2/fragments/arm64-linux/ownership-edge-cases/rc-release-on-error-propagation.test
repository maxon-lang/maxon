// Test: rc-release-on-error-propagation
typealias Integer = int(i64.min to i64.max)

type Resource
	export var id as Integer

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Resource'

enum ResourceError
	case notFound
end 'ResourceError'

function loadResource() returns Resource throws ResourceError
	throw ResourceError.notFound
end 'loadResource'

function process() returns Integer throws ResourceError
	@heap let marker = Resource.create(42)
	let res = try loadResource()
	return res.id + marker.id
end 'process'

function main() returns ExitCode
	let result = try process() otherwise 'err'
		return 99
	end 'err'
	return result
end 'main'
---
ExitCode: 99
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @loadResource {
  entry:
    arm64.prologue 16
    arm64.movImm x9, 2
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @process {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x19
    arm64.movImm x0, 42
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.bl loadResource
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl process
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  tryok:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rc-release-on-error-propagation.test:30: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
