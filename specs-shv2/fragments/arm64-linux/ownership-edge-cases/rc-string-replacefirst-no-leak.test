// Test: rc-string-replacefirst-no-leak
function main() returns ExitCode
	let s = "hello world"
	let result = s.replaceFirst("o", with: "0")
	print(result)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_3  ; "hello world"
    arm64.leaRdata x1, __str_rec_4  ; "o"
    arm64.leaRdata x2, __str_rec_5  ; "0"
    arm64.bl String.replaceFirst
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl print
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
