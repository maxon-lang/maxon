  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_live_count@96 = i64 0
  __sched_active_workers@104 = i64 1
  __sched_max_active_workers@112 = i64 1
  __sched_tls_index@120 = i64 0
  __sched_tls_teb_offset@128 = i64 0
  __sched_procs@136 = i64 0
  __sched_num_procs@144 = i64 0
  __sched_shutdown_flag@152 = i64 0
  __sched_lock@160 = i64 0
  __mrt_envp@168 = i64 0
  __mrt_tls_next_key@176 = i64 0
  __slab_arena_list@184 = i64 0
  __slab_arena_map_l1@192 = i64 0
  __slab_state@200 = i64 0
}

func @maySetFlag {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.bl Runtime.yield
    arm64.cbnz x19, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 1
    arm64.leaGlobal x1, __data_flag
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 0
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x9, 2
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.leaFuncAddr x0, maySetFlag
    arm64.bl __gt_spawn
    arm64.movRegReg x20, x0
    arm64.storeBaseDispReg.word64 [x20 + 200], x19
    arm64.movRegReg x0, x20
    arm64.bl __gt_ready
    arm64.movRegReg x0, x20
    arm64.bl __gt_try_await
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.sub x0, x9, 1
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#3
    arm64.b matchnext
  matcharm#3:
    arm64.movImm x0, 7
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#4
    arm64.b matchdead
  matcharm#4:
    arm64.movImm x0, 9
    arm64.b matchcont
  matchcont:
    arm64.leaGlobal x1, __data_flag
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b trycont
  matchdead:
  tryok:
    arm64.b trycont
  trycont:
    arm64.leaGlobal x0, __data_flag
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at async-try-await.otherwise-bind-void.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
