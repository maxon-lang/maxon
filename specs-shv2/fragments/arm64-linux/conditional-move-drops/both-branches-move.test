// Test: both-branches-move
typealias Integer = int(i64.min to i64.max)

union Wrap
	empty
	holds(s String)
end 'Wrap'

function makeWrap(flag Integer) returns Wrap
	let s = "wrap payload {41} padded long enough to heap allocate"
	if flag > 0 'f'
		return Wrap.holds(s)
	end 'f' else 'g'
		return Wrap.holds(s)
	end 'g'
end 'makeWrap'

function main() returns ExitCode
	let w = makeWrap(0)
	return 0
end 'main'
---
ExitCode: 0
---
