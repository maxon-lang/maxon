// Test: void-call-statement-is-legal
function noop()
	return
end 'noop'

function main() returns ExitCode
	noop()
	return 42
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
