// Test: void-call-statement-is-legal
function noop()
	return
end 'noop'

function main() returns ExitCode
	noop()
	return 42
end 'main'
---
ExitCode: 42
---
func @noop {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl noop
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
}
