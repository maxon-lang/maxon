// Test: for-in-over-a-generic-instance
typealias Integer = int(i64.min to i64.max)

type Walker uses T
	typealias TArr = Array with T
	var items as TArr
	var at = 0

	export static function create(items TArr) returns Self
		return Self{items: items}
	end 'create'

	export function current() returns T
		return try items.get(at) otherwise panic("oob")
	end 'current'

	export function advance() throws IterationError
		at = at + 1
		if at >= items.count() 'done'
			throw IterationError.exhausted
		end 'done'
	end 'advance'
end 'Walker'

typealias IntArray = Array with Integer
typealias IntWalker = Walker with Integer

function main() returns ExitCode
	var a = IntArray.create()
	a.push(3)
	a.push(4)
	let w = IntWalker.create(a)
	var total = 0
	for x in w 'walk'
		total = total + x
	end 'walk'
	return total as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Walker.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Walker.current {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.cmp x2, 0
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at for-in-over-a-generic-instance.test:14: Range check failed: value outside typealias 'ElementIndex'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 24]
    arm64.cmp x0, 8
    arm64.b.ne __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.cmp x2, x0
    arm64.b.hs __im_slow
  __im_load#11:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.arm64AddLsl x0, x0, x2, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_loaded
  __im_stride:
    arm64.cmp x0, 1
    arm64.b.ne __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.cmp x2, x0
    arm64.b.hs __im_slow
  __im_load#12:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, x2
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
  __im_loaded:
    arm64.movImm x3, 0
    arm64.loadRegBaseDisp.word64 x4, [x1 + 40]
    arm64.cmp x4, 0
    arm64.b.eq critsplit#14
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.eq __im_slow
  critsplit#15:
    arm64.movRegReg x1, x0
    arm64.b __im_cont
  critsplit#14:
    arm64.movRegReg x1, x0
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl __managed_get
    arm64.movRegReg x1, x0
    arm64.movRegReg x3, x9
  __im_cont:
    arm64.cmp x3, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at for-in-over-a-generic-instance.test:14: oob\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
