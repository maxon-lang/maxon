// Test: ranges.continue-in-range
function main() returns ExitCode
		var sum = 0
		for i in 1 to 10 'loop'
				if i mod 2 == 0 'skip'
						continue
				end 'skip'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.movImm x1, 1
    arm64.b forhdr
  forhdr:
    arm64.cmp x1, 10
    arm64.cset x2, le
    arm64.cbnz x2, loop
    arm64.b forexit
  loop:
    arm64.movImm x2, 2
    arm64.sdiv x16, x1, x2
    arm64.msub x2, x16, x2, x1
    arm64.cmp x2, 0
    arm64.cset x2, eq
    arm64.cbnz x2, skip
    arm64.b ifcont
  skip:
    arm64.b forstep
  ifcont:
    arm64.add x0, x0, x1
    arm64.b forstep
  forstep:
    arm64.add x1, x1, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranges.continue-in-range.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
