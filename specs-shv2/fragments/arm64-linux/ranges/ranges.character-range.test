// Test: ranges.character-range
function main() returns ExitCode
		var count = 0
		for _ in 'a' to 'z' 'loop'
				count = count + 1
		end 'loop'
		return count
end 'main'
---
ExitCode: 26
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 97
  forhdr:
    arm64.cmp x20, 122
    arm64.b.gt forexit
  loop:
    arm64.movRegReg x0, x20
    arm64.bl __char_from_cp
    arm64.add x19, x19, 1
    arm64.bl __str_decref
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ranges.character-range.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
