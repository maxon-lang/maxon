// Test: dispatch-named-first-arg

typealias Integer = int(i64.min to i64.max)

// An interface (or type-parameter) method call may name its FIRST argument:
// the receiver dispatches through interface monomorphization, which is
// receiver-type-dependent and so cannot be ruled out syntactically at parse
// time. The C# bootstrap accepts this (it routes interface/type-param method
// calls through a path that silently consumes a first-arg label); the self-
// hosted parser defers the E2052 check to TypeResolution, which re-applies it
// only for concrete-struct / enum / builtin receivers. This is the regression
// guard for that split.
interface Combiner
	function combine(first Integer, second Integer) returns Integer
end 'Combiner'

type Summer implements Combiner
	let bias as Integer

	function combine(first Integer, second Integer) returns Integer
		return bias + first + second
	end 'combine'

	static function create(bias Integer) returns Self
		return Self{bias: bias}
	end 'create'
end 'Summer'

function combineVia(c Combiner) returns Integer
	return c.combine(first: 12, second: 30)
end 'combineVia'

function main() returns ExitCode
	let s = Summer.create(0)
	return combineVia(s)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Summer.combine {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, x1
    arm64.add x0, x0, x2
    arm64.epilogue 16
    arm64.ret
}

func @Summer.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @combineVia {
  entry:
    arm64.prologue 16
    arm64.movRegReg x3, x1
    arm64.movImm x1, 12
    arm64.movImm x2, 30
    arm64.loadRegBaseDisp.word64 x16, [x3 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl Summer.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_Summer.Combiner
    arm64.movRegReg x0, x19
    arm64.bl combineVia
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at dispatch-named-first-arg.test:35: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
