// Test: dispatch-throwing-arg-widening

typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

interface Risky
	function risk(n Integer) returns Integer throws Boom
end 'Risky'

type Safe implements Risky
	export var tag as Integer

	static function create() returns Safe
		return Self{tag: 0}
	end 'create'

	function risk(n Integer) returns Integer throws Boom
		return n + 1
	end 'risk'
end 'Safe'

function drive(r Risky) returns Integer
	return try r.risk(41) otherwise 0
end 'drive'

function main() returns ExitCode
	print("v={drive(Safe.create())}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Safe.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Safe.risk {
  entry:
    arm64.prologue 16
    arm64.add x0, x1, 1
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @drive {
  entry:
    arm64.prologue 16
    arm64.movRegReg x2, x1
    arm64.movImm x1, 41
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x9, 0
    arm64.b.eq trycont
  tryerr:
    arm64.movImm x0, 0
  trycont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
    arm64.storeSlotReg slot8, x27
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_2  ; "v="
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.bl Safe.create
    arm64.movRegReg x21, x0
    arm64.leaRdata x1, __witness_Safe.Risky
    arm64.movRegReg x0, x21
    arm64.bl drive
    arm64.movRegReg x22, x0
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x23
    arm64.bl __int_to_string
    arm64.movRegReg x22, x0
    arm64.leaRdata x0, __str_rec_3  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x24, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x25, [x0 + 8]
    arm64.add x0, x20, x22
    arm64.add x26, x0, x25
    arm64.add x0, x26, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
    arm64.add x28, x27, 56
    arm64.movRegReg x0, x28
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl __str_copy
    arm64.add x19, x28, x20
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x19, x19, x22
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x25
    arm64.bl __str_copy
    arm64.add x0, x19, x25
    arm64.storeBaseDispReg.word64 [x27 + 0], x28
    arm64.storeBaseDispReg.word64 [x27 + 8], x26
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x27 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x27 + 24], x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x27
    arm64.bl print
    arm64.movRegReg x0, x27
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.loadRegSlot x27, slot8
    arm64.loadRegSlot x28, slot9
    arm64.epilogue 96
    arm64.ret
}
