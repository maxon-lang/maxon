    arm64.bl Box.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.leaRdata x0, __witness_Point.Digest
    arm64.b __il_body
  __il_body:
