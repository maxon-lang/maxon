// Test: dispatch-named-args-out-of-order

typealias Integer = int(i64.min to i64.max)

interface Subtractor
	function subtract(minuend Integer, subtrahend Integer) returns Integer
end 'Subtractor'

type Difference implements Subtractor
	let bias as Integer

	function subtract(minuend Integer, subtrahend Integer) returns Integer
		return minuend - subtrahend + bias
	end 'subtract'

	static function create(bias Integer) returns Self
		return Self{bias: bias}
	end 'create'
end 'Difference'

function subtractVia(s Subtractor) returns Integer
	return s.subtract(subtrahend: 2, minuend: 10)
end 'subtractVia'

function main() returns ExitCode
	let d = Difference.create(0)
	return subtractVia(d)
end 'main'
---
ExitCode: 8
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Difference.subtract {
  entry:
    arm64.prologue 16
    arm64.sub x1, x1, x2
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @Difference.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @subtractVia {
  entry:
    arm64.prologue 16
    arm64.movRegReg x3, x1
    arm64.movImm x2, 2
    arm64.movImm x1, 10
    arm64.loadRegBaseDisp.word64 x16, [x3 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.bl Difference.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __witness_Difference.Subtractor
    arm64.movRegReg x0, x19
    arm64.bl subtractVia
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at dispatch-named-args-out-of-order.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
