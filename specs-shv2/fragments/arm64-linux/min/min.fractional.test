// Test: min.fractional
function main() returns ExitCode
	let x = min(3.5, 5.2)
	// min of 3.5 and 5.2 is 3.5, trunc gives 3
	return trunc(x)
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
