// Test: string-backed-enum-as-map-key
enum Planet
	earth = "Earth"
	mars = "Mars"
	venus = "Venus"
end 'Planet'

typealias Int = int(i64.min to i64.max)
typealias PlanetMap = Map with (Planet, Int)

function main() returns ExitCode
	var m = PlanetMap.create()
	try m.insert(Planet.earth, value: 1) otherwise ignore
	try m.insert(Planet.mars, value: 2) otherwise ignore
	try m.insert(Planet.venus, value: 3) otherwise ignore
	let result = try m.get(Planet.mars) otherwise 0
	return result
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Map_Planet_Int
    arm64.leaRdata x1, __witness_Planet.Hashable
    arm64.leaRdata x2, __witness_Planet.Equatable
    arm64.bl Map.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movImm x2, 1
    arm64.leaRdata x3, __layout_Map_Planet_Int
    arm64.leaRdata x4, __witness_Planet.Hashable
    arm64.leaRdata x5, __witness_Planet.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.b.ne trycont#3
  trycont#3:
    arm64.movImm x1, 1
    arm64.movImm x2, 2
    arm64.leaRdata x3, __layout_Map_Planet_Int
    arm64.leaRdata x4, __witness_Planet.Hashable
    arm64.leaRdata x5, __witness_Planet.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.b.ne trycont#6
  trycont#6:
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.leaRdata x3, __layout_Map_Planet_Int
    arm64.leaRdata x4, __witness_Planet.Hashable
    arm64.leaRdata x5, __witness_Planet.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.b.ne trycont#9
  trycont#9:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Map_Planet_Int
    arm64.leaRdata x3, __witness_Planet.Hashable
    arm64.leaRdata x4, __witness_Planet.Equatable
    arm64.movRegReg x0, x19
    arm64.bl Map.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont#12
  tryok:
    arm64.movRegReg x20, x0
  trycont#12:
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Map_Planet_Int
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_23  ; "panic at string-backed-enum-as-map-key.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
