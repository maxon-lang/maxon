    arm64.movRegReg x22, x0
    arm64.leaRdata x3, __layout_Map_LogCategory_LogLevel
    arm64.leaRdata x4, __witness_LogCategory.Hashable
    arm64.leaRdata x5, __witness_LogCategory.Equatable
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x19
    arm64.movRegReg x2, x20
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.movRegReg x0, x22
    arm64.bl __destruct_Map_LogCategory_LogLevel
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

