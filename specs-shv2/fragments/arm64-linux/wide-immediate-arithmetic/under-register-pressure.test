end 'pressure'

function main() returns ExitCode
	let cell = [0]
	let total = pressure(try cell.get(0) otherwise 0)
	if total != 6000000505 'total'
		return 51
	end 'total'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
