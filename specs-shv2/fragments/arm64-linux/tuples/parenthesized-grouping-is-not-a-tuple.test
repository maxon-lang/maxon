// Test: parenthesized-grouping-is-not-a-tuple
function main() returns ExitCode
	let x = (2 + 3) * 4
	return x + 22
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 42
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
