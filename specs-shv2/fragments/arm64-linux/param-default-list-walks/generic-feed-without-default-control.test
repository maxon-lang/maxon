// Test: generic-feed-without-default-control
typealias Integer = int(i64.min to i64.max)

type Box uses T
	export var item as T

	static function create(_ Integer, item T) returns Self
		return Self{item: item}
	end 'create'
end 'Box'

typealias StrBox = Box with String

function main() returns ExitCode
	var total = 0
	var i = 0
	while i < 50 'loop'
		let s = "hello!"
		let b = StrBox.create(2, item: s)
		print("{b.item}")
		total = 6
		i = i + 1
	end 'loop'
	return total
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

