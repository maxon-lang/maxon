// Test: clamped-exponent-cannot-be-cancelled-into-range
function main() returns ExitCode
	if .0e-999999999 == 0.0 'underflowsToZero'
		return 1
	end 'underflowsToZero'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fcmp d0, d1
    arm64.cset x0, eq
    arm64.cbnz x0, underflowsToZero
    arm64.b ifcont
  underflowsToZero:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
