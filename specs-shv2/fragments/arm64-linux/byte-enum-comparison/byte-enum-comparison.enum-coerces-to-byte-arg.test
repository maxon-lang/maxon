// Test: byte-enum-comparison.enum-coerces-to-byte-arg

typealias Byte = int(0 to u8.max)

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function takesByte(b Byte) returns Byte
	return b
end 'takesByte'

function main() returns ExitCode
	let r = takesByte(Ascii.underscore)
	if r == 95 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 95
    arm64.b __il_body
  __il_body:
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 95
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
