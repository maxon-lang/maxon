// Test: enum-method-private-helper
enum Signal
	red
	green
	yellow

	function isStop() returns bool
		return match self 'check'
			red gives true
			green gives false
			yellow gives false
		end 'check'
	end 'isStop'

	export function action() returns bool
		return self.isStop()
	end 'action'
end 'Signal'

function main() returns ExitCode
	let s = Signal.red
	if s.action() 'isRed'
		return 1
	end 'isRed'
	return 0
end 'main'
---
ExitCode: 1
---
func @Signal.action {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#3
    arm64.b matchnext#7
  matcharm#3:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext#7:
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#4
    arm64.b matchnext#8
  matcharm#4:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext#8:
    arm64.cmp x0, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#5
    arm64.b matchdead
  matcharm#5:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.b __il_cont
  __il_cont:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl Signal.action
    arm64.cbnz x0, isRed
    arm64.b ifcont
  isRed:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
