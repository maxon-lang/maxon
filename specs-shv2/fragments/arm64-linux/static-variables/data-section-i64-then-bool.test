// Test: data-section-i64-then-bool
var counter = 7
var flag = true

function main() returns ExitCode
	if flag 'read'
		return counter - 7
	end 'read'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __data_counter@0 = i64 7
  __data_flag@8 = i1 1
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_flag
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.cbnz x0, read
    arm64.b ifcont
  read:
    arm64.leaGlobal x0, __data_counter
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.sub x0, x0, 7
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
