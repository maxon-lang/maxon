// Test: static-var-bool
var initialized = false

function init()
	initialized = true
end 'init'

function main() returns ExitCode
	if initialized 'check1'
		return 1
	end 'check1'
	init()
	if initialized 'check2'
		return 42
	end 'check2'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __data_initialized@0 = i1 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_initialized
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.cbz x0, __il_body
  check1:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  __il_body:
    arm64.movImm x0, 1
    arm64.leaGlobal x1, __data_initialized
    arm64.storeBaseDispReg.byte [x1 + 0], x0
  __il_cont:
    arm64.leaGlobal x0, __data_initialized
    arm64.loadRegBaseDisp.byte x0, [x0 + 0]
    arm64.cbz x0, ifcont
  check2:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
