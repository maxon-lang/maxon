// Test: global-map-with-union-values
typealias Val = int(i64.min to i64.max)

union Op
	add(value Val)
	nop
end 'Op'

var opMap = [
	b"add": Op.add(5),
	b"nop": Op.nop
]

function main() returns ExitCode
	let op = try opMap.get(b"add") otherwise Op.nop
	return match op 'check'
		add(v) gives v
		nop gives 99
	end 'check'
end 'main'
---
ExitCode: 5
---
data {
  __data_opMap@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_opMap
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movImm x0, 48
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.leaRdata x0, __barr_blob_0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movImm x0, 3
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 18446744073709551614
    arm64.storeBaseDispReg.word64 [x20 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 24], x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x21, x0
    arm64.leaRdata x2, __layout_Map_Array_Byte_Op
    arm64.leaRdata x3, __witness_Array_Byte.Hashable
    arm64.leaRdata x4, __witness_Array_Byte.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Map.get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 8], x1
    arm64.movRegReg x19, x0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
  trycont:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Map_Array_Byte_Op
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#4:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#5:
    arm64.movImm x20, 99
  matchcont:
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_24  ; "panic at global-map-with-union-values.test:16: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
}
