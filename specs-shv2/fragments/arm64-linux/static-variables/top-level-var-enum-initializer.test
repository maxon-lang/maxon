// Test: top-level-var-enum-initializer
enum Color
		Red
		Green
		Blue
end 'Color'

var current = Color.Green

function main() returns ExitCode
	let isGreen = match current 'check'
		Green gives true
		Red gives false
		Blue gives false
	end 'check'
	if isGreen 'check'
		current = Color.Blue
		let isBlue = match current 'check2'
			Blue gives true
			Red gives false
			Green gives false
		end 'check2'
		if isBlue 'check2'
			return 42
		end 'check2'
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
data {
  __data_current@0 = i64 1
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_current
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#5
  matcharm#2:
    arm64.movImm x0, 0
    arm64.b matchcont#7
  matchnext#5:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#6
  matcharm#1:
    arm64.movImm x0, 1
    arm64.b matchcont#7
  matchnext#6:
    arm64.cmp x0, 2
    arm64.b.ne matchdead#4
  matcharm#3:
    arm64.movImm x0, 0
  matchcont#7:
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x0, 2
    arm64.leaGlobal x1, __data_current
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_current
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext#13
  matcharm#10:
    arm64.movImm x0, 0
    arm64.b matchcont#15
  matchnext#13:
    arm64.cmp x0, 1
    arm64.b.ne matchnext#14
  matcharm#11:
    arm64.movImm x0, 0
    arm64.b matchcont#15
  matchnext#14:
    arm64.cmp x0, 2
    arm64.b.ne matchdead#12
  matcharm#9:
    arm64.movImm x0, 1
  matchcont#15:
    arm64.cbz x0, ifcont
  check2:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  matchdead#12:
  ifcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matchdead#4:
}
