// Test: top-level-var-const-expr
let BASE = 20
var offset = BASE + 1

function main() returns ExitCode
	offset = offset * 2
	return offset
end 'main'
---
ExitCode: 42
---
data {
  __data_offset@0 = i64 21
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_offset
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.leaGlobal x1, __data_offset
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_offset
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
