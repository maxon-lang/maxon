// Test: error.an-array-literal-may-not-mix-two-enums
enum Reg
	rcx
	rdx
end 'Reg'

enum CharClass
	other
	tab
end 'CharClass'

let mixed = [Reg.rcx, CharClass.tab]

function main() returns ExitCode
	return mixed.count() as ExitCode
end 'main'
---
CompilerError:
error E2015: <fragment>:12:23: Unsupported: an array literal with mixed element types — every element must have the same type as the first
