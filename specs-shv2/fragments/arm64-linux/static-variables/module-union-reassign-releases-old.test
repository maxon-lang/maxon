// Test: module-union-reassign-releases-old
typealias Small = int(0 to 100)

union Hold
	unowned
	owned(v Small)
end 'Hold'

var hold = Hold.unowned

function main() returns ExitCode
	var i = 0
	while i < 10 'fill'
		hold = Hold.owned(i as Small)
		i = i + 1
	end 'fill'

	return match hold 'm'
		unowned gives 0
		owned(v) gives v
	end 'm'
end 'main'
---
ExitCode: 9
---
data {
  __data_hold@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
  whilehdr:
    arm64.cmp x19, 10
    arm64.b.ge whileexit
  fill:
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic#10
  __rc_chk#11:
    arm64.cmp x19, 100
    arm64.b.le __rc_ok#9
  __rc_panic#10:
    arm64.leaRdata x0, __str_blob_0  ; "panic at module-union-reassign-releases-old.test:14: Range check failed: value outside typealias 'Small'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#9:
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.storeBaseDispReg.word64 [x20 + 8], x19
    arm64.leaGlobal x0, __data_hold
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_decref
    arm64.leaGlobal x0, __data_hold
    arm64.storeBaseDispReg.word64 [x0 + 0], x20
    arm64.add x19, x19, 1
    arm64.b whilehdr
  whileexit:
    arm64.leaGlobal x0, __data_hold
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#4:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic#13
  __rc_chk#14:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok#12
  __rc_panic#13:
    arm64.leaRdata x0, __str_blob_1  ; "panic at module-union-reassign-releases-old.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#12:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
