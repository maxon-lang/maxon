// Test: top-level-var-with-let
let BASE = 40
var offset = 0

function main() returns ExitCode
	offset = 2
	return BASE + offset
end 'main'
---
ExitCode: 42
---
data {
  __data_offset@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.leaGlobal x1, __data_offset
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.leaGlobal x0, __data_offset
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 40
    arm64.epilogue 16
    arm64.ret
}
