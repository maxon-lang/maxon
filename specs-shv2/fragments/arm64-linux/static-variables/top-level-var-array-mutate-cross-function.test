// Test: top-level-var-array-mutate-cross-function

typealias Integer = int(i64.min to i64.max)

var counters = [0, 0, 0]

function increment(index Integer)
	let current = try counters.get(index) otherwise 0
	try counters.set(index, value: current + 1) otherwise panic("test invariant: set OOB")
end 'increment'

function total() returns Integer
	let a = try counters.get(0) otherwise 0
	let b = try counters.get(1) otherwise 0
	let c = try counters.get(2) otherwise 0
	return a + b + c
end 'total'

function main() returns ExitCode
	increment(0)
	increment(0)
	increment(1)
	increment(2)
	increment(2)
	increment(2)
	return total()
end 'main'
---
ExitCode: 6
---
data {
  __data_counters@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @increment {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.leaGlobal x0, __data_counters
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movRegReg x1, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.leaGlobal x1, __data_counters
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x2, x0, 1
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x19
    arm64.bl __managed_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_rec_1
    arm64.movImm x0, 134
    arm64.syscall 94
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @total {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaGlobal x0, __data_counters
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 0
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x19, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x19, x0
    arm64.b trycont
  trycont:
    arm64.leaGlobal x0, __data_counters
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 1
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.leaGlobal x0, __data_counters
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 2
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.add x1, x19, x20
    arm64.add x0, x1, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl increment
    arm64.movImm x0, 0
    arm64.bl increment
    arm64.movImm x0, 1
    arm64.bl increment
    arm64.movImm x0, 2
    arm64.bl increment
    arm64.movImm x0, 2
    arm64.bl increment
    arm64.movImm x0, 2
    arm64.bl increment
    arm64.bl total
    arm64.epilogue 16
    arm64.ret
}
