// Test: top-level-var-string-mutate-cross-function
var msg = "hi"

function bump()
	msg.append("!")
end 'bump'

function main() returns ExitCode
	bump()
	bump()
	print(msg)
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_msg@0 = i64 0
  __slab_cursor@8 = i64 0
  __slab_end@16 = i64 0
  __mm_alloc_count@24 = i64 0
}

func @bump {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_msg
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaRdata x1, __str_rec_1
    arm64.bl __str_append
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl bump
    arm64.bl bump
    arm64.leaGlobal x0, __data_msg
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __print_string
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
