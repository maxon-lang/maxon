// Test: arity-mismatch
function main() returns ExitCode
	let m = [1: 10, 2: 20]
	for (a, b, c) in m 'each'
		print("{a} {b} {c}")
	end 'each'
	return 0
end 'main'
---
CompilerError:
error E2015: <fragment>:4:2: Unsupported: a destructuring `for` pattern of 3 names against a tuple of 2 elements (every element must be named)
