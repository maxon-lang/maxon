// Test: cmp-not-a-shifted-imm12
typealias Val = int(i64.min to i64.max)

function base(p Val) returns Val
	return p
end 'base'

function main() returns ExitCode
	let x = base(65535)
	if not (x == 65535) 'eqWord'
		return 31
	end 'eqWord'
	if x > 65535 'gtWord'
		return 32
	end 'gtWord'
	if not (x < 65536) 'ltNext'
		return 33
	end 'ltNext'
	let y = base(16777215)
	if not (y == 16777215) 'eqPairMax'
		return 34
	end 'eqPairMax'
	if not (y > 65535) 'gtWordFromPair'
		return 35
	end 'gtWordFromPair'
	if y == 16777214 'eqOffByOne'
		return 36
	end 'eqOffByOne'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#14
  __il_body#14:
    arm64.b __il_cont#13
  __il_cont#13:
    arm64.b ifcont#2
  ifcont#2:
    arm64.b ifcont#4
  ifcont#4:
    arm64.b ifcont#6
  ifcont#6:
    arm64.b __il_body#16
  __il_body#16:
    arm64.b __il_cont#15
  __il_cont#15:
    arm64.b ifcont#8
  ifcont#8:
    arm64.b ifcont#10
  ifcont#10:
    arm64.b ifcont#12
  ifcont#12:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
