// Test: cross-file-declaration-order
// --- file: a-caller.maxon
function main() returns ExitCode
	if alwaysTrue() and alwaysTrue() 'both'
		return 42
	end 'both'
	return 1
end 'main'

// --- file: z-callee.maxon
export function alwaysTrue() returns bool
	return true
end 'alwaysTrue'
---
ExitCode: 42
---
func @alwaysTrue {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl alwaysTrue
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.bl alwaysTrue
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, both
    arm64.b ifcont
  both:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
