// Test: cross-file-declaration-order
// --- file: a-caller.maxon
function main() returns ExitCode
	if alwaysTrue() and alwaysTrue() 'both'
		return 42
	end 'both'
	return 1
end 'main'

// --- file: z-callee.maxon
export function alwaysTrue() returns bool
	return true
end 'alwaysTrue'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#6
  __il_body#6:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b andrhs
  andrhs:
    arm64.b __il_body#8
  __il_body#8:
    arm64.movImm x0, 1
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.b scmerge
  scmerge:
    arm64.cbnz x0, both
    arm64.b ifcont
  both:
    arm64.movImm x0, 42
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}
