// Test: crlf-iterates-once
function main() returns ExitCode
	let s = "\r\n"
	var n = 0
	for _ in s 'each'
		n = n + 1
	end 'each'
	print("{s.count()} {n}\n")
	let mid = "ab\r\ncd"
	var m = 0
	for _ in mid 'more'
		m = m + 1
	end 'more'
	print("{mid.count()} {m}\n")
	return 0
end 'main'
