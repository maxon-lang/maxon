func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a\xc3\xa9\xe4\xb8\xad!x\xc3\xa9y"
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x21, 200
    arm64.cset x0, lt
    arm64.cbnz x0, rep
    arm64.b whileexit
  rep:
    arm64.movRegReg x0, x19
    arm64.bl fallthroughTrips
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl continueTrips
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl breakTrips
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl returnFromLoop
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl discardTrips
    arm64.add x20, x20, x0
    arm64.add x21, x21, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x16, 5200
    arm64.cmp x20, x16
    arm64.cset x0, ne
    arm64.cbnz x0, wrongTotal
    arm64.b ifcont
  wrongTotal:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
