    arm64.b ternaryfalse
  ternarytrue:
    arm64.add x20, x20, 1
    arm64.b matchcont
  ternaryfalse:
    arm64.b matchcont
  matchcont:
    arm64.cmp x20, 0
    arm64.cset x0, gt
    arm64.cbnz x0, always
    arm64.b ifcont
  always:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.b forstep
  ifcont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.b forstep
  forstep:
    arm64.movRegReg x21, x22
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
