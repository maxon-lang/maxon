// Test: for-in-string-drops-every-cluster
function fallthroughTrips(s String) returns Integer
	var n = 0
	for c in s 'a'
		n = n + 1 if c == c else n
	end 'a'
	return n
end 'fallthroughTrips'

function continueTrips(s String) returns Integer
	var n = 0
	for c in s 'b'
		n = n + 1 if c == c else n
		if n > 0 'always'
			continue
		end 'always'
	end 'b'
	return n
end 'continueTrips'

function breakTrips(s String) returns Integer
	var n = 0
	for c in s 'd'
		n = n + 1 if c == c else n
		if n == 2 'stop'
			break
		end 'stop'
	end 'd'
	return n
end 'breakTrips'

function returnFromLoop(s String) returns Integer
	var n = 0
	for c in s 'e'
		n = n + 1 if c == c else n
		if n == 3 'out'
			return n
		end 'out'
	end 'e'
	return n
end 'returnFromLoop'

function discardTrips(s String) returns Integer
	var n = 0
	for _ in s 'f'
		n = n + 1
	end 'f'
	return n
end 'discardTrips'

function main() returns ExitCode
	let s = "aé中!xéy"
	var total = 0
	var i = 0
	while i < 200 'rep'
		total = total + fallthroughTrips(s) + continueTrips(s) + breakTrips(s) + returnFromLoop(s) + discardTrips(s)
		i = i + 1
	end 'rep'
	if total != 5200 'wrongTotal'
		return 1
	end 'wrongTotal'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @fallthroughTrips {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, lt
    arm64.cbnz x0, a
    arm64.b forexit
  a:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl findGraphemeEnd
    arm64.movRegReg x22, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __char_at
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x21
    arm64.bl __str_eq
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.add x20, x20, 1
    arm64.b matchcont
  ternaryfalse:
    arm64.b matchcont
  matchcont:
    arm64.movRegReg x0, x21
    arm64.bl __str_decref
    arm64.b forstep
  forstep:
    arm64.movRegReg x21, x22
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

