// Test: four-byte-cluster-at-end
function main() returns ExitCode
	let s = "ab🎉"
	var n = 0
	for _ in s 'each'
		n = n + 1
	end 'each'
	print("{s.count()} {n} {s.bytes().count()}\n")
	return 0
end 'main'
