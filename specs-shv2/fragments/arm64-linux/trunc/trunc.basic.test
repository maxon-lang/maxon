// Test: trunc.basic
function main() returns ExitCode
	let neg = -3.7
	let y = trunc(neg)
	return y + 10
end 'main'
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.fpLoadRdata d1, [rdata + __fconst_1]
    arm64.fsub d0, d1, d0
    arm64.fcvtzs x0, d0
    arm64.add x0, x0, 10
    arm64.epilogue 16
    arm64.ret
}
