// Test: two-methods-and-the-second-ones-return-type
union Outcome
	pass
	fail(reason String)

	export function isPass() returns bool
		return match self 'p'
			pass gives true
			fail gives false
		end 'p'
	end 'isPass'

	export function weight() returns Real
		return 2.5
	end 'weight'
end 'Outcome'

function main() returns ExitCode
	let o = Outcome.fail("a rather long failure reason to force a heap allocation")
	if o.isPass() 'y'
		return 1
	end 'y'
	if o.weight() > 2.0 'w'
		return 7
	end 'w'
	return 2
end 'main'
typealias Real = float(f64.min to f64.max)
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_1  ; "a rather long failure reason to force a heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.b __il_body#6
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#7
    arm64.b matchnext
  matcharm#7:
    arm64.movImm x0, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#8
    arm64.b matchdead
  matcharm#8:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.cbnz x0, y
    arm64.b ifcont#2
  y:
    arm64.movImm x19, 1
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outcome
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.b __il_body#13
  __il_body#13:
    arm64.fpLoadRdata d0, [rdata + __fconst_2.5]
    arm64.b __il_cont#12
  __il_cont#12:
    arm64.fpLoadRdata d1, [rdata + __fconst_2]
    arm64.fcmp d0, d1
    arm64.cset x0, gt
    arm64.cbnz x0, w
    arm64.b ifcont#4
  w:
    arm64.movImm x19, 7
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outcome
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#4:
    arm64.movImm x19, 2
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outcome
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
