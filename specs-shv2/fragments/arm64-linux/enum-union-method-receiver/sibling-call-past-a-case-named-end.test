// Test: sibling-call-past-a-case-named-end
enum Sib
	alpha
	end
	omega

	export function outer() returns Integer
		return inner() + 1
	end 'outer'

	export function inner() returns Integer
		return 6
	end 'inner'
end 'Sib'

function main() returns ExitCode
	let a = Sib.alpha
	return a.outer() as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
func @Sib.outer {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.movImm x0, 6
  __il_cont:
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl Sib.outer
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at sibling-call-past-a-case-named-end.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
