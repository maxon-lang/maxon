// Test: a-directive-selecting-between-two-methods
enum Plat
	alpha

#if testing(true)
	export function tag() returns Integer
		return 3
	end 'tag'
#else
	export function tag() returns Integer
		return 7
	end 'tag'
#endif

	omega
end 'Plat'

function main() returns ExitCode
	let p = Plat.omega
	match p 'k'
		alpha then return 1
		omega then return p.tag() as ExitCode
	end 'k'
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 7
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b matchnext
  matchnext:
    arm64.b matcharm
  matcharm:
    arm64.b __il_body
  __il_body:
    arm64.movImm x0, 7
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-directive-selecting-between-two-methods.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
