// Test: multi-div

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function multiDiv(a Integer, b NonZero, c Integer, d NonZero) returns Integer
	let r1 = a / b
	let r2 = c / d
	return trunc(r1 + r2)
end 'multiDiv'

function main() returns ExitCode
	return multiDiv(10, b: 2, c: 20, d: 4)
end 'main'
---
ExitCode: 10
---
func @multiDiv {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 1
    arm64.cset x4, lt
    arm64.cbnz x4, __rc_panic#2
    arm64.b __rc_ok#1
  __rc_panic#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at multi-div.test:6: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#1:
    arm64.cmp x3, 1
    arm64.cset x4, lt
    arm64.cbnz x4, __rc_panic#4
    arm64.b __rc_ok#3
  __rc_panic#4:
    arm64.leaRdata x0, __str_blob_0  ; "panic at multi-div.test:6: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok#3:
    arm64.sdiv x0, x0, x1
    arm64.sdiv x1, x2, x3
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 2
    arm64.movImm x2, 20
    arm64.movImm x3, 4
    arm64.bl multiDiv
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at multi-div.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
