// Test: div-with-call

typealias Integer = int(i64.min to i64.max)
typealias NonZero = int(1 to i64.max)

function helper(x Integer) returns Integer
	return x * 2
end 'helper'

function divCall(a Integer, b NonZero) returns Integer
	let temp = trunc(a / b)
	let result = helper(temp)
	return result + temp
end 'divCall'

function main() returns ExitCode
	return divCall(10, b: 2)
end 'main'
---
ExitCode: 15
---
func @divCall {
  entry:
    arm64.prologue 16
    arm64.cmp x1, 1
    arm64.b.ge __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at div-with-call.test:10: Range check failed: value outside typealias 'NonZero'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.sdiv x0, x0, x1
  __il_body:
    arm64.movImm x16, 2
    arm64.mul x1, x0, x16
  __il_cont:
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 10
    arm64.movImm x1, 2
    arm64.bl divCall
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at div-with-call.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
