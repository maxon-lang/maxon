// Test: equals-branching

typealias Integer = int(i64.min to i64.max)

type Token implements Equatable
	export var id as Integer

	function equals(other Token) returns bool
		return id == other.id
	end 'equals'

	static function create(id Integer) returns Self
		return Self{id: id}
	end 'create'
end 'Token'

function main() returns ExitCode
	let a = Token.create(10)
	let b = Token.create(10)
	let c = Token.create(20)
	var result = 0
	if a.equals(b) 'first'
		result = result + 1
	end 'first'
	if a.equals(c) 'second'
		result = result + 10
	end 'second'
	if b.equals(c) 'third'
		result = result + 100
	end 'third'
	return result
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Token.equals {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.cmp x0, x1
    arm64.cset x0, eq
    arm64.epilogue 16
    arm64.ret
}

func @Token.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 10
    arm64.bl Token.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 10
    arm64.bl Token.create
    arm64.movRegReg x20, x0
    arm64.movImm x0, 20
    arm64.bl Token.create
    arm64.movRegReg x21, x0
    arm64.movImm x22, 0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Token.equals
    arm64.cbnz x0, first
    arm64.b critsplit
  first:
    arm64.add x22, x22, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl Token.equals
    arm64.cbnz x0, second
    arm64.b critsplit
  second:
    arm64.add x22, x22, 10
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl Token.equals
    arm64.cbnz x0, third
    arm64.b critsplit
  third:
    arm64.add x22, x22, 100
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
