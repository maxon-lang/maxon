// Test: rematerialized-constant
function rematConstant(p Integer) returns Integer
	let c = 7
	let a1 = p + 1
	let a2 = p + 2
	let a3 = p + 3
	let a4 = p + 4
	let a5 = p + 5
	let a6 = p + 6
	let a7 = p + 7
	let a8 = p + 8
	let a9 = p + 9
	let a10 = p + 10
	let a11 = p + 11
	let a12 = p + 12
	let a13 = p + 13
	let a14 = p + 14
	let s = a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14
	return s / c
end 'rematConstant'

function main() returns ExitCode
	return rematConstant(0)
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 15
---
func @rematConstant {
  entry:
    arm64.prologue 16
    arm64.movImm x1, 7
    arm64.add x2, x0, 1
    arm64.add x3, x0, 2
    arm64.add x4, x0, 3
    arm64.add x5, x0, 4
    arm64.add x6, x0, 5
    arm64.add x7, x0, 6
    arm64.add x8, x0, 7
    arm64.add x9, x0, 8
    arm64.add x10, x0, 9
    arm64.add x11, x0, 10
    arm64.add x12, x0, 11
    arm64.add x13, x0, 12
    arm64.add x14, x0, 13
    arm64.add x0, x0, 14
    arm64.add x2, x2, x3
    arm64.add x2, x2, x4
    arm64.add x2, x2, x5
    arm64.add x2, x2, x6
    arm64.add x2, x2, x7
    arm64.add x2, x2, x8
    arm64.add x2, x2, x9
    arm64.add x2, x2, x10
    arm64.add x2, x2, x11
    arm64.add x2, x2, x12
    arm64.add x2, x2, x13
    arm64.add x2, x2, x14
    arm64.add x0, x2, x0
    arm64.sdiv x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl rematConstant
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rematerialized-constant.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
