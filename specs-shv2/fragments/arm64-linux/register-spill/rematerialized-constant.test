    arm64.add x11, x0, 11
    arm64.add x12, x0, 12
    arm64.add x13, x0, 13
    arm64.add x0, x0, 14
    arm64.add x1, x1, x2
    arm64.add x1, x1, x3
    arm64.add x1, x1, x4
    arm64.add x1, x1, x5
    arm64.add x1, x1, x6
    arm64.add x1, x1, x7
    arm64.add x1, x1, x8
