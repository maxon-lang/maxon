    arm64.add x1, x1, x10
    arm64.add x1, x1, x11
    arm64.add x1, x1, x12
    arm64.add x1, x1, x13
    arm64.add x0, x1, x0
    arm64.movImm x1, 5270498306774157605
    arm64.smulh x0, x1, x0
    arm64.asr x0, x0, 1
    arm64.lsr x1, x0, 63
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl rematConstant
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at rematerialized-constant.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
