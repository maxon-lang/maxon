// Test: ten-floats-across-a-call-fit-the-callee-saved-half
function bump(x Integer) returns Integer
	return x + 1
end 'bump'

function pressure(k Integer) returns Integer
	let a = 1.0
	let b = 2.0
	let c = 3.0
	let d = 4.0
	let e = 5.0
	let f = 6.0
	let g = 7.0
	let h = 8.0
	let i = 9.0
	let j = 10.0
	var acc = k
	acc = bump(acc)
	acc = acc + trunc(a) + trunc(b) + trunc(c) + trunc(d) + trunc(e)
	acc = acc + trunc(f) + trunc(g) + trunc(h) + trunc(i) + trunc(j)
	return acc
end 'pressure'

function main() returns ExitCode
	return pressure(0) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 56
---
func @pressure {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.add x0, x0, 1
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x0, 1
    arm64.add x0, x0, 2
    arm64.add x0, x0, 3
    arm64.add x0, x0, 4
    arm64.add x0, x0, 5
    arm64.add x0, x0, 6
    arm64.add x0, x0, 7
    arm64.add x0, x0, 8
    arm64.add x0, x0, 9
    arm64.add x0, x0, 10
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl pressure
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ten-floats-across-a-call-fit-the-callee-saved-half.test:25: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
