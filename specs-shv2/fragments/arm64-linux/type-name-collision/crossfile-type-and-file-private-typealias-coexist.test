    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.bl Box.create
  __il_cont:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.add x19, x1, 5
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at main.maxon:4: Range check failed: value outside typealias 'ExitCode'\x0a"
