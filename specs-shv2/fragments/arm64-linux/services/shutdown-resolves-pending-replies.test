func @Slow.__loop {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.b serve
  serve:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, stopping
    arm64.b dispatch
  dispatch:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.jumpTable x1, default=stopping [[0]=__shutdown, [1]=value] @__jumptable_1
  __shutdown:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.storeBaseDispReg.word64 [x20 + 56], x1
    arm64.bl __mm_decref
    arm64.b stopping
  stopping:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_close
    arm64.b drain
  drain:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_recv
    arm64.movRegReg x1, x0
    arm64.cmp x1, 0
    arm64.cset x0, eq
    arm64.cbnz x0, finished
    arm64.b abandon
  finished:
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mbox_service_exit
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  abandon:
    arm64.movRegReg x0, x20
    arm64.bl __mbox_abandon
    arm64.b drain
  value:
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x22, [x19 + 0]
    arm64.b __il_cont
  __il_cont:
    arm64.bl __mm_decref
    arm64.movImm x2, 0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x22
    arm64.bl __gt_cell_complete
    arm64.b serve
}

