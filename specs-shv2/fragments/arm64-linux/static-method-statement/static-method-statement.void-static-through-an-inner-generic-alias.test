// Test: static-method-statement.void-static-through-an-inner-generic-alias
type Pair uses T
	export var a as ExitCode

	export static function create(a ExitCode) returns Self
		return Self{a: a}
	end 'create'

	export static function shout()
		print("hi")
	end 'shout'
end 'Pair'

type Plain
	typealias IntPair = Pair with ExitCode

	export static function make() returns ExitCode
		IntPair.shout()
		let p = IntPair.create(0)
		return p.a
	end 'make'
end 'Plain'

function main() returns ExitCode
	return Plain.make()
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at static-method-statement.void-static-through-an-inner-generic-alias.test:5: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Pair.shout {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_1  ; "hi"
    arm64.bl print
    arm64.epilogue 16
    arm64.ret
}

func @Plain.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl Pair.shout
    arm64.movImm x0, 0
    arm64.bl Pair.create
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl Plain.make
    arm64.epilogue 16
    arm64.ret
}
