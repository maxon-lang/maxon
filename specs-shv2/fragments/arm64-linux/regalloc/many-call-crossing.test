  __il_body#24:
    arm64.b __il_cont#21
  __il_cont#21:
    arm64.add x3, x0, 3
    arm64.b __il_body#25
  __il_body#25:
    arm64.b __il_cont#20
  __il_cont#20:
    arm64.add x4, x0, 4
