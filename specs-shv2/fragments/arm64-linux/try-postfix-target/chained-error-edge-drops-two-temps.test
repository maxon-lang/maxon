    arm64.movImm x1, 9
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 9
    arm64.cset x0, ls
    arm64.cbnz x0, __im_slow
    arm64.b __im_load
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.add x0, x0, 72
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x2, [x20 + 40]
