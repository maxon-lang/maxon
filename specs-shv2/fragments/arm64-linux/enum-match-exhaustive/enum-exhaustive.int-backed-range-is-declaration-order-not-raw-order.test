// Test: enum-exhaustive.int-backed-range-is-declaration-order-not-raw-order
enum Code
	ok = 500
	notFound = 200
	serverError = 404
end 'Code'

function classify(c Code) returns ExitCode
	let r = match c 'm'
		ok to notFound gives 41
		serverError gives 42
	end 'm'
	return r
end 'classify'

function main() returns ExitCode
	return classify(Code.serverError)
end 'main'
---
ExitCode: 42
---
func @classify {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 200
    arm64.b.eq matcharm#1
  matchnext#4:
    arm64.cmp x0, 404
    arm64.b.ne matchnext#5
  matcharm#2:
    arm64.movImm x0, 42
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x0, 500
    arm64.b.ne matchdead
  matcharm#1:
    arm64.movImm x0, 41
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at enum-exhaustive.int-backed-range-is-declaration-order-not-raw-order.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 404
  matcharm:
    arm64.movImm x1, 42
  matchcont:
    arm64.cmp x1, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok
  __il_slow:
    arm64.bl classify
    arm64.b __il_cont
  __rc_ok:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}
