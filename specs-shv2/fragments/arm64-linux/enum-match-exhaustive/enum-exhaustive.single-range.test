// Test: enum-exhaustive.single-range
enum Color
		red
		green
		blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	match c 'check'
		red to blue then return 1
	end 'check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.cmp x0, 0
    arm64.cset x1, ge
    arm64.cmp x0, 2
    arm64.cset x0, le
    arm64.and x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchdead
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matchdead:
  matchcont:
}
