// Test: url.parse-basic
function main() returns ExitCode
	let url = try URL.parse("https://example.com") otherwise 'err'
		return 1
	end 'err'
	print("{url.scheme()}\n")
	print("{url.path()}\n")
	return 0
end 'main'
