// Test: in-a-return-value
function t() returns bool
	return true
end 't'

function f() returns bool
	return false
end 'f'

function bothTrue() returns bool
	return t() and t()
end 'bothTrue'

function eitherTrue() returns bool
	return f() or t()
end 'eitherTrue'

function main() returns ExitCode
	var code = 0
	if bothTrue() 'a'
		code = code + 1
	end 'a'
	if eitherTrue() 'b'
		code = code + 2
	end 'b'
	return code
end 'main'
---
ExitCode: 3
---
func @t {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @f {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @bothTrue {
  entry:
    arm64.prologue 16
    arm64.bl t
    arm64.movImm x1, 0
    arm64.cbnz x0, andrhs
    arm64.b critsplit
  andrhs:
    arm64.bl t
    arm64.b scmerge
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}

func @eitherTrue {
  entry:
    arm64.prologue 16
    arm64.bl f
    arm64.movImm x1, 1
    arm64.cbnz x0, critsplit
    arm64.b orrhs
  critsplit:
    arm64.movRegReg x0, x1
    arm64.b scmerge
  orrhs:
    arm64.bl t
    arm64.b scmerge
  scmerge:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.bl bothTrue
    arm64.cbnz x0, a
    arm64.b critsplit
  a:
    arm64.add x19, x19, 1
    arm64.b ifcont
  critsplit:
    arm64.b ifcont
  ifcont:
    arm64.bl eitherTrue
    arm64.cbnz x0, b
    arm64.b critsplit
  b:
    arm64.add x0, x19, 2
    arm64.b ifcont
  critsplit:
    arm64.movRegReg x0, x19
    arm64.b ifcont
  ifcont:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
