// Test: comparison-operands
function main() returns ExitCode
	let x = 4
	let y = 0
	var code = 0
	if x > 0 and y > 0 'both'
		code = code + 1
	end 'both'
	if x > 0 or y > 0 'either'
		code = code + 2
	end 'either'
	if x > 0 and y == 0 'mixed'
		code = code + 4
	end 'mixed'
	return code
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.b andrhs#1
  andrhs#1:
    arm64.movImm x1, 0
    arm64.b scmerge#2
  scmerge#2:
    arm64.cbnz x1, both
    arm64.b critsplit#16
  both:
    arm64.movImm x0, 1
    arm64.b ifcont#4
  critsplit#16:
    arm64.b ifcont#4
  ifcont#4:
    arm64.movImm x1, 1
    arm64.b scmerge#6
  scmerge#6:
    arm64.cbnz x1, either
    arm64.b critsplit#17
  either:
    arm64.add x0, x0, 2
    arm64.b ifcont#8
  critsplit#17:
    arm64.b ifcont#8
  ifcont#8:
    arm64.b andrhs#9
  andrhs#9:
    arm64.movImm x1, 1
    arm64.b scmerge#10
  scmerge#10:
    arm64.cbnz x1, mixed
    arm64.b critsplit#18
  mixed:
    arm64.add x0, x0, 4
    arm64.b ifcont#12
  critsplit#18:
    arm64.b ifcont#12
  ifcont#12:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at comparison-operands.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
