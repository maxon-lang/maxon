// Test: global-read-twice-around-a-write


var slot = 3

function main() returns ExitCode
	let before = slot
	slot = 40
	let after = slot
	return before + after - 1
end 'main'
---
ExitCode: 42
---
data {
  __data_slot@0 = i64 3
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_slot
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x1, 40
    arm64.leaGlobal x2, __data_slot
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.leaGlobal x1, __data_slot
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.sub x0, x0, 1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at global-read-twice-around-a-write.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
