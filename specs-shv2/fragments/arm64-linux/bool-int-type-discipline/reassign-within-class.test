// Test: reassign-within-class
function main() returns ExitCode
	var flag = true
	var n = 5

	if n > 0 'pos'
		flag = false
		n = n * 2
	end 'pos'

	if flag 'stillTrue'
		return 99
	end 'stillTrue'

	if n == 10 'doubled'
		return 1
	end 'doubled'
	return 0
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b pos
  pos:
    arm64.movImm x0, 0
    arm64.movImm x1, 10
    arm64.b ifcont#2
  ifcont#2:
    arm64.cbnz x0, stillTrue
    arm64.b ifcont#4
  stillTrue:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont#4:
    arm64.cmp x1, 10
    arm64.cset x0, eq
    arm64.cbnz x0, doubled
    arm64.b ifcont#6
  doubled:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  ifcont#6:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
