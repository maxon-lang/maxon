// Test: if-try-var-binding-managed-struct

enum MyError implements Error
	failed
end 'MyError'

function makeGreeting(succeed bool) returns String throws MyError
	if not succeed 'check'
		throw MyError.failed
	end 'check'
	return "hello"
end 'makeGreeting'

function main() returns ExitCode
	if var s = try makeGreeting(true) 'check'
		s.append(" world")
		return s.bytes().count()
	end 'check'
	return 0
end 'main'
---
ExitCode: 11
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @makeGreeting {
  entry:
    arm64.prologue 16
    arm64.eor x0, x0, 1
    arm64.cbz x0, ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaRdata x0, __str_rec_2  ; "hello"
    arm64.bl __str_retain
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.bl makeGreeting
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.b.ne ifcont
  check:
    arm64.leaRdata x1, __str_rec_3  ; " world"
    arm64.movRegReg x0, x19
    arm64.bl String.append
    arm64.movRegReg x0, x19
    arm64.bl String.bytes
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl ByteView.count
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_ByteView
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.cmp x21, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x21, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_6  ; "panic at if-try-var-binding-managed-struct.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
