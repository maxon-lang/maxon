// Test: if-try-binding-with-else

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	failed
end 'MyError'

function mayFail(succeed bool) returns Integer throws MyError
	if not succeed 'check'
		throw MyError.failed
	end 'check'
	return 42
end 'mayFail'

function main() returns ExitCode
	if let value = try mayFail(false) 'check'
		return value
	end 'check' else 'err'
		return 77
	end 'err'
end 'main'
---
ExitCode: 77
---
func @mayFail {
  entry:
    arm64.prologue 16
    arm64.eor x0, x0, 1
    arm64.cbnz x0, check
    arm64.b ifcont
  check:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 42
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl mayFail
    arm64.cmp x9, 0
    arm64.cset x1, eq
    arm64.cbnz x1, check
    arm64.b ifelse
  check:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at if-try-binding-with-else.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  ifelse:
    arm64.movImm x0, 77
    arm64.epilogue 16
    arm64.ret
  ifcont:
}
