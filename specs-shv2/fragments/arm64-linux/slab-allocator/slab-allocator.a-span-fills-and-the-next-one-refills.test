    arm64.cmp x19, 65536
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#6
    arm64.b __rc_ok#5
  __rc_panic#6:
    arm64.leaRdata x0, __str_blob_1  ; "panic at slab-allocator.a-span-fills-and-the-next-one-refills.test:7: Range check failed: value outside typealias 'Index'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok#5:
    arm64.movImm x0, 1
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x20, x0
    arm64.movImm x1, 24
    arm64.movRegReg x0, x20
    arm64.bl Array.reserve
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x21, 24
    arm64.cset x0, lt
