    arm64.b forexit
  fill:
    arm64.add x0, x19, x21
    arm64.movImm x1, 251
    arm64.sdiv x16, x0, x1
    arm64.msub x1, x16, x1, x0
    arm64.cmp x1, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic#9
    arm64.b __rc_chk#10
  __rc_chk#10:
    arm64.cmp x1, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic#9
    arm64.b __rc_ok#8
  __rc_panic#9:
    arm64.leaRdata x0, __str_blob_2  ; "panic at slab-allocator.a-span-fills-and-the-next-one-refills.test:11: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
