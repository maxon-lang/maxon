    arm64.movImm x16, 251
    arm64.mul x1, x1, x16
    arm64.sub x1, x0, x1
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#17
  __rc_chk#18:
    arm64.cmp x1, 255
    arm64.b.le __rc_ok#16
  __rc_panic#17:
    arm64.leaRdata x0, __str_blob_2  ; "panic at slab-allocator.an-os-direct-buffer-round-trips.test:10: Range check failed: value outside typealias 'Byte'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
