func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x20, 0
  forhdr:
    arm64.cmp x20, 64
    arm64.b.ge forexit
  rounds:
    arm64.movRegReg x0, x20
    arm64.bl roundTrip
    arm64.add x19, x19, x0
  forstep:
    arm64.add x20, x20, 1
    arm64.b forhdr
  forexit:
    arm64.cmp x19, 0
    arm64.b.eq ifcont
  corrupted:
