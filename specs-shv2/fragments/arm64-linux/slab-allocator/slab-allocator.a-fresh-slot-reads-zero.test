func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x19, 8
    arm64.cset x0, lt
    arm64.cbnz x0, rounds
    arm64.b forexit
  rounds:
    arm64.bl dirty
    arm64.b forstep
  forstep:
    arm64.add x19, x19, 1
    arm64.b forhdr
  forexit:
    arm64.bl countNonZero
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, dirtySlot
    arm64.b ifcont
  dirtySlot:
    arm64.movImm x0, 3
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
