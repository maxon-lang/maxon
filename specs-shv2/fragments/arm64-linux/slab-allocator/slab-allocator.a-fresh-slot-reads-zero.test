// Test: slab-allocator.a-fresh-slot-reads-zero
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function dirty()
	let mm = try __ManagedMemory.create(4096, elementSize: 1) otherwise return
	try mm.setLength(4096) otherwise return
	var arr = ByteArray.init(mm)
	for i in 0 upto 4096 'fill'
		try arr.set(i, value: 255) otherwise return
	end 'fill'
end 'dirty'

function countNonZero() returns Integer
	let mm = try __ManagedMemory.create(4096, elementSize: 1) otherwise return 1
	try mm.setLength(4096) otherwise return 2
	let arr = ByteArray.init(mm)
	var seen = 0
	for i in 0 upto 4096 'scan'
		let got = try arr.get(i) otherwise return 3
		if got != 0 'nonZero'
			seen = seen + 1
		end 'nonZero'
	end 'scan'
	return seen
end 'countNonZero'

function main() returns ExitCode
	for _ in 0 upto 8 'rounds'
		dirty()
	end 'rounds'

	if countNonZero() != 0 'dirtySlot'
		return 3
	end 'dirtySlot'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @dirty {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 4096
    arm64.movImm x1, 1
    arm64.bl __managed_mem_create
    arm64.movRegReg x19, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movImm x1, 4096
    arm64.movRegReg x0, x19
    arm64.bl __managed_set_length
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#4
    arm64.b tryok#3
  tryerr#4:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movRegReg x0, x19
    arm64.bl __mm_retain
    arm64.movRegReg x20, x0
    arm64.movImm x21, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x21, 4096
    arm64.cset x0, lt
    arm64.cbnz x0, fill
    arm64.b forexit
  fill:
    arm64.movImm x2, 255
    arm64.loadRegBaseDisp.word64 x0, [x20 + 24]
    arm64.cmp x0, 8
    arm64.cset x1, eq
    arm64.cbnz x1, __im_word
    arm64.b __im_stride
  __im_word:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 40]
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, __im_slow
    arm64.b __im_owned#16
  __im_owned#16:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 16]
    arm64.cmp x0, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __im_slow
    arm64.b __im_bounds#17
  __im_bounds#17:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_buffer#18
  __im_buffer#18:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, __im_slow
    arm64.b __im_viewed#19
  __im_viewed#19:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.cset x1, ne
    arm64.cbnz x1, __im_slow
    arm64.b __im_store#20
  __im_store#20:
    arm64.arm64AddLsl x0, x0, x21, lsl #3
    arm64.storeBaseDispReg.word64 [x0 + 0], x2
    arm64.movImm x0, 0
    arm64.b __im_cont
  __im_stride:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, __im_byte
    arm64.b __im_slow
  __im_byte:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 40]
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, __im_slow
    arm64.b __im_owned#21
  __im_owned#21:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 16]
    arm64.cmp x0, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __im_slow
    arm64.b __im_bounds#22
  __im_bounds#22:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x21, x0
    arm64.cset x0, hs
    arm64.cbnz x0, __im_slow
    arm64.b __im_buffer#23
  __im_buffer#23:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, __im_slow
    arm64.b __im_viewed#24
  __im_viewed#24:
    arm64.sub x1, x0, 24
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.cmp x1, 0
    arm64.cset x1, ne
    arm64.cbnz x1, __im_slow
    arm64.b __im_store#25
  __im_store#25:
    arm64.add x0, x0, x21
    arm64.storeBaseDispReg.byte [x0 + 0], x2
    arm64.movImm x0, 0
    arm64.b __im_cont
  __im_slow:
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl __managed_set
    arm64.movRegReg x0, x9
    arm64.b __im_cont
  __im_cont:
    arm64.cmp x0, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#10
    arm64.b tryok#9
  tryerr#10:
    arm64.movRegReg x0, x20
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#9:
    arm64.b forstep
  forstep:
