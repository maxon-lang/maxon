// Test: multiple-variables
function main() returns ExitCode
	let x = 42
	let y = 10
	let result = x + y
	return result
end 'main'
---
ExitCode: 52
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 52
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
