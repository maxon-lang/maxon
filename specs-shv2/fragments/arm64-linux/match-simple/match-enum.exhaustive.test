// Test: match-enum.exhaustive
enum Color
	red
	green
	blue
end 'Color'

function main() returns ExitCode
	let c = Color.green
	match c 'check'
		red then return 1
		green then return 2
		blue then return 3
	end 'check'
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b matchnext
  matchnext:
    arm64.b matcharm
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
}
