// Test: match-statements.nested-in-function

typealias Integer = int(i64.min to i64.max)

function categorize(n Integer) returns Integer
	match n 'cat'
		1 or 2 or 3 then return 1
		4 or 5 or 6 then return 2
		default then return 0
	end 'cat'
end 'categorize'

function main() returns ExitCode
	return categorize(5)
end 'main'
---
ExitCode: 2
---
func @categorize {
  entry:
    arm64.prologue 16
    arm64.sub x0, x0, 1
    arm64.jumpTable x0, default=matchdefault [[0..2]=matcharm, [3..5]=matcharm] @__jumptable_0
  matchdefault:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  matcharm:
    arm64.movImm x0, 1
    arm64.epilogue 16
    arm64.ret
  matcharm:
    arm64.movImm x0, 2
    arm64.epilogue 16
    arm64.ret
  matchcont:
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 5
    arm64.bl categorize
    arm64.epilogue 16
    arm64.ret
}
