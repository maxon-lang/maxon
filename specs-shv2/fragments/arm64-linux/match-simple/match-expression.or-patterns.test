// Test: match-expression.or-patterns
function main() returns ExitCode
	let x = 4
	let result = match x 'eval'
		1 or 2 gives 10
		3 or 4 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.sub x0, x0, 1
    arm64.jumpTable x0, default=matchdefault [[0..1]=matcharm, [2..3]=matcharm] @__jumptable_0
  matchdefault:
    arm64.movImm x0, 0
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 10
    arm64.b matchcont
  matcharm:
    arm64.movImm x0, 20
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
