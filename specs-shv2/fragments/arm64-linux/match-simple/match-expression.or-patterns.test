// Test: match-expression.or-patterns
function main() returns ExitCode
	let x = 4
	let result = match x 'eval'
		1 or 2 gives 10
		3 or 4 gives 20
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 4
    arm64.cmp x0, 1
    arm64.cset x1, eq
    arm64.cmp x0, 2
    arm64.cset x2, eq
    arm64.orr x1, x1, x2
    arm64.cbnz x1, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 10
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 3
    arm64.cset x1, eq
    arm64.cmp x0, 4
    arm64.cset x0, eq
    arm64.orr x0, x1, x0
    arm64.cbnz x0, matcharm
    arm64.b matchnext
  matcharm:
    arm64.movImm x0, 20
    arm64.b matchcont
  matchnext:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.epilogue 16
    arm64.ret
}
