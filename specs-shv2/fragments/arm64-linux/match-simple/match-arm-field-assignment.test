// Test: match-arm-field-assignment
enum Op
	noop
	mark
	done
end 'Op'

type State
	export var flag = false

	export static function make() returns State
		return State{}
	end 'make'
end 'State'

function scan(op Op, state State)
	match op 'm'
		noop then break 'm'
		mark then state.flag = true
		done then break 'm'
	end 'm'
end 'scan'

function main() returns ExitCode
	var s = State.make()
	scan(Op.mark, state: s)
	return 1 if s.flag else 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @State.make {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.byte [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.bl State.make
  matcharm:
    arm64.movImm x1, 1
    arm64.storeBaseDispReg.byte [x0 + 0], x1
  __il_cont:
    arm64.loadRegBaseDisp.byte x1, [x0 + 0]
    arm64.cbz x1, ternaryfalse
  ternarytrue:
    arm64.movImm x19, 1
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x19, 0
  matchcont:
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at match-arm-field-assignment.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
