func @c1 {
  entry:
    arm64.prologue 16
    arm64.leaRdata x0, __str_rec_3  ; "exit 1"
    arm64.bl __gt_process_run
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 99
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.epilogue 16
    arm64.ret
}

