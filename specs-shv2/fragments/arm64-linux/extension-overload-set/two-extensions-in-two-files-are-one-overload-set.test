// Test: two-extensions-in-two-files-are-one-overload-set
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

export interface Tagged
	function tag() returns Integer
end 'Tagged'

export extension Tagged
	export function pick(n Integer) returns Integer
		return tag() + n
	end 'pick'
end 'Tagged'

export type Five implements Tagged
	export static function make() returns Self
		return Self{}
	end 'make'

	export function tag() returns Integer
		return 5
	end 'tag'
end 'Five'

// --- file: b.maxon
typealias Count = int(i64.min to i64.max)

export extension Tagged
	export function pick(flag bool) returns Count
		return tag() + (100 if flag else 0)
	end 'pick'
end 'Tagged'

function main() returns ExitCode
	let f = Five.make()
	return f.pick(2) + f.pick(true)
end 'main'
---
ExitCode: 112
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Five.pick#Integer {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.add x0, x1, 5
    arm64.epilogue 16
    arm64.ret
}

func @Five.make {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.epilogue 16
    arm64.ret
}

func @Five.pick#bool {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.b __il_cont
  __il_cont:
    arm64.cbnz x1, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 100
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchcont:
    arm64.add x0, x0, 5
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Five.make
    arm64.movRegReg x19, x0
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl Five.pick#Integer
    arm64.movRegReg x20, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl Five.pick#bool
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at b.maxon:11: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
