  __rc_panic:
    arm64.leaRdata x0, __str_blob_2  ; "panic at a-correctly-typed-receiver-argument-still-runs.test:18: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
