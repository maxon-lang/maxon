// Test: a-correctly-typed-receiver-argument-still-runs
typealias Num = int(0 to 1000)

type Adder
	var value as Num

	static function create(v Num) returns Adder
		return Adder{value: v}
	end 'create'

	function bump() returns Num
		return self.value + 1
	end 'bump'
end 'Adder'

function main() returns ExitCode
	let a = Adder.create(41)
	return Adder.bump(a)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Adder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-correctly-typed-receiver-argument-still-runs.test:7: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Adder.bump {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 1000
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-correctly-typed-receiver-argument-still-runs.test:12: Range check failed: value outside typealias 'Num'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 41
    arm64.bl Adder.create
    arm64.movRegReg x19, x0
    arm64.b __il_body
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x20, x0, 1
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __il_slow
    arm64.b __rc_chk#7
  __rc_chk#7:
    arm64.cmp x20, 1000
    arm64.cset x0, gt
    arm64.cbnz x0, __il_slow
