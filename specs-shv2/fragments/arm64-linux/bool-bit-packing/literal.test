// Test: literal
function main() returns ExitCode
	let arr = [true, false, true, false]
	let v0 = try arr.get(0) otherwise false
	let v2 = try arr.get(2) otherwise false
	var sum = 0
	if v0 'c0'
		sum = sum + 1
	end 'c0'
	if v2 'c2'
		sum = sum + 1
	end 'c2'
	return sum
end 'main'
