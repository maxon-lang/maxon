// Test: two-preds-different-permutations
function twoPerms(p Integer) returns Integer
	var a = p + 1
	var b = p + 2
	var c = p + 3
	var i = 0
	while i < 4 'loop'
		if i mod 2 == 0 'even'
			let t = a
			a = b
			b = t
		end 'even' else 'odd'
			let u = b
			b = c
			c = u
		end 'odd'
		i = i + 1
	end 'loop'
	return a * 100 + b * 10 + c
end 'twoPerms'

function main() returns ExitCode
	let r = twoPerms(0)
	if r == 312 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
func @twoPerms {
  entry:
    arm64.prologue 16
    arm64.add x1, x0, 1
    arm64.add x2, x0, 2
    arm64.add x0, x0, 3
    arm64.movImm x3, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x3, 4
    arm64.cset x4, lt
    arm64.cbnz x4, loop
    arm64.b whileexit
  loop:
    arm64.movImm x4, 2
    arm64.sdiv x16, x3, x4
    arm64.msub x4, x16, x4, x3
    arm64.cmp x4, 0
    arm64.cset x4, eq
    arm64.cbnz x4, even
    arm64.b ifelse
  even:
    arm64.b ifcont
  ifelse:
    arm64.xchgRegReg x2, x1
    arm64.xchgRegReg x1, x0
    arm64.b ifcont
  ifcont:
    arm64.add x3, x3, 1
    arm64.xchgRegReg x1, x2
    arm64.b whilehdr
  whileexit:
    arm64.movImm x16, 100
    arm64.mul x1, x1, x16
    arm64.movImm x16, 10
    arm64.mul x2, x2, x16
    arm64.add x1, x1, x2
    arm64.add x0, x1, x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl twoPerms
    arm64.cmp x0, 312
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
