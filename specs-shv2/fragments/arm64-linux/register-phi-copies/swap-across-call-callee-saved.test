// Test: swap-across-call-callee-saved
function sink(x int) returns int
	return x
end 'sink'

function swapAcrossCall(p int) returns int
	var a = p + 1
	var b = p + 2
	var i = 0
	while i < 3 'loop'
		var t = a
		a = b
		b = t
		i = i + sink(1)
	end 'loop'
	return a * 10 + b
end 'swapAcrossCall'

function main() returns ExitCode
	let r = swapAcrossCall(0)
	if r == 21 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @sink {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @swapAcrossCall {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.add x19, x0, 1
    arm64.add x20, x0, 2
    arm64.movImm x21, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x21, 3
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.movImm x0, 1
    arm64.bl sink
    arm64.add x21, x21, x0
    arm64.xchgRegReg x19, x20
    arm64.b whilehdr
  whileexit:
    arm64.movImm x16, 10
    arm64.mul x0, x19, x16
    arm64.add x0, x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.bl swapAcrossCall
    arm64.cmp x0, 21
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
