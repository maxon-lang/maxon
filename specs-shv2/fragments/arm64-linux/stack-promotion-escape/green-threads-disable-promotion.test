  __mrt_envp@200 = i64 0
  __mrt_tls_next_key@208 = i64 0
  __slab_arena_list@216 = i64 0
  __slab_arena_map_l1@224 = i64 0
  __slab_state@232 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @deep {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.cset x1, le
    arm64.cbnz x1, bottom
    arm64.b ifcont
  bottom:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.sub x0, x0, 1
    arm64.bl deep
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @onTheGreenThread {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_17  ; "noyield.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl File.exists
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.movImm x0, 41
    arm64.movImm x1, 1
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 400
    arm64.bl deep
    arm64.loadRegBaseDisp.word64 x1, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 8]
    arm64.add x1, x1, x2
    arm64.sub x20, x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, onTheGreenThread
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl __gt_await
    arm64.add x0, x0, 400
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_86  ; "panic at green-threads-disable-promotion.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
