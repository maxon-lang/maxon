// Test: promoted-record-reads-back-every-field
typealias Integer = int(i64.min to i64.max)

type Quad
	export var a as Integer
	export var b as Integer
	export var c as Integer
	export var d as Integer

	static function create(a Integer, b Integer, c Integer, d Integer) returns Self
		return Self{a: a, b: b, c: c, d: d}
	end 'create'
end 'Quad'

function main() returns ExitCode
	let q = Quad.create(1, b: 2, c: 4, d: 8)
	return q.a + q.b + q.c + q.d
end 'main'
---
ExitCode: 15
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 4
    arm64.movImm x3, 8
    arm64.leaRegSlot x4, slot0
    arm64.storeBaseDispReg.word64 [x4 + 0], x0
    arm64.storeBaseDispReg.word64 [x4 + 8], x1
    arm64.storeBaseDispReg.word64 [x4 + 16], x2
    arm64.storeBaseDispReg.word64 [x4 + 24], x3
    arm64.loadRegBaseDisp.word64 x0, [x4 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x4 + 8]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x4 + 16]
    arm64.add x0, x0, x1
    arm64.loadRegBaseDisp.word64 x1, [x4 + 24]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at promoted-record-reads-back-every-field.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.epilogue 48
    arm64.ret
}
