// Test: escape-into-a-retaining-callee
typealias Integer = int(i64.min to i64.max)

type Point
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'Point'

function keep(p Point) returns Point
	return p
end 'keep'

function main() returns ExitCode
	let a = Point.create(3, y: 4)
	let b = Point.create(5, y: 6)
	let ka = keep(a)
	let kb = keep(b)
	return ka.x + ka.y + kb.x + kb.y
end 'main'
---
ExitCode: 18
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Point.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @keep {
  entry:
    arm64.prologue 16
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.bl Point.create
    arm64.movRegReg x19, x0
    arm64.movImm x0, 5
    arm64.movImm x1, 6
    arm64.bl Point.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl keep
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl keep
    arm64.loadRegBaseDisp.word64 x1, [x21 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x21 + 8]
    arm64.add x1, x1, x2
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x1, x1, x2
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.add x22, x1, x2
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.cmp x22, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x22, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at escape-into-a-retaining-callee.test:22: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
