// Test: closure-capture.captured-ranged-alias-binding

typealias Integer = int(i64.min to i64.max)
typealias Word = int(0 to u64.max)

function usesClosure(bump Integer, high Word) returns Integer
	let op = function(n Integer) gives n + bump + (high shr 62)
	return op(1)
end 'usesClosure'

function main() returns ExitCode
	return usesClosure(38, high: 0xC000000000000000) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @usesClosure {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.leaFuncAddr x21, usesClosure$closure_0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.storeBaseDispReg.word64 [x22 + 0], x19
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.movImm x0, 1
    arm64.movRegReg x1, x22
    arm64.blr x21
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @usesClosure$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x2, [x1 + 0]
    arm64.add x0, x0, x2
    arm64.loadRegBaseDisp.word64 x1, [x1 + 8]
    arm64.lsr x1, x1, 62
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 38
    arm64.movImm x1, 13835058055282163712
    arm64.bl usesClosure
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at closure-capture.captured-ranged-alias-binding.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
