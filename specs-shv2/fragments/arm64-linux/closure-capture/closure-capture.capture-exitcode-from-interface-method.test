// Test: closure-capture.capture-exitcode-from-interface-method
typealias Integer = int(0 to u64.max)

interface Coded
	function code() returns ExitCode
end 'Coded'

type Box implements Coded
	let n as Integer

	function code() returns ExitCode
		return n
	end 'code'

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'
end 'Box'

type Wrap uses T where T is Coded
	let item as T

	function run() returns ExitCode
		let v = self.item.code()
		let f = function() gives v
		return f()
	end 'run'

	static function create(item T) returns Self
		return Self{item: item}
	end 'create'
end 'Wrap'

typealias BoxWrap = Wrap with Box

function main() returns ExitCode
	let w = BoxWrap.create(Box.create(9))
	return w.run()
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.code {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at closure-capture.capture-exitcode-from-interface-method.test:12: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Wrap.run {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x16, [x1 + 24]
    arm64.blr x16
    arm64.movRegReg x19, x0
    arm64.leaFuncAddr x20, Wrap.run$closure_0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.storeBaseDispReg.word64 [x21 + 0], x19
    arm64.movRegReg x0, x21
    arm64.blr x20
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_1  ; "panic at closure-capture.capture-exitcode-from-interface-method.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Wrap.run$closure_0 {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Wrap.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 9
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.leaRdata x1, __witness_Box.Coded
    arm64.movRegReg x0, x19
    arm64.bl Wrap.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.leaRdata x1, __witness_Box.Coded
    arm64.movRegReg x0, x20
    arm64.bl Wrap.run
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Wrap_Box
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
