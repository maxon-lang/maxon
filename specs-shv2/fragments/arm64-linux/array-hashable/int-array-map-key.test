    arm64.bl __managed_push
    arm64.leaRdata x2, __layout_Map_IntArr_Val
    arm64.leaRdata x3, __witness_Array_Val.Hashable
    arm64.leaRdata x4, __witness_Array_Val.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.bl Map.get
    arm64.movRegReg x22, x0
