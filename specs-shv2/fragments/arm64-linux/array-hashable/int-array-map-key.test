    arm64.movRegReg x0, x20
    arm64.bl __managed_push
    arm64.movImm x21, 42
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.leaRdata x3, __layout_Map_IntArr_Val
    arm64.leaRdata x4, __witness_Array_Val.Hashable
    arm64.leaRdata x5, __witness_Array_Val.Equatable
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl Map.insert
    arm64.cmp x9, 0
    arm64.b.ne trycont
  trycont:
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.movImm x1, 2
