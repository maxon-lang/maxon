// Test: order-sensitive-body-through-a-reversal
function mix6(a int, b int, c int, d int, e int, f int) returns int
	return a - b * 2 + c * 3 - d * 4 + e * 5 - f * 6
end 'mix6'

function flip6(a int, b int, c int, d int, e int, f int) returns int
	return mix6(f, b: e, c: d, d: c, e: b, f: a)
end 'flip6'

function main() returns ExitCode
	let r = flip6(1, b: 20, c: 3, d: 30, e: 2, f: 40)
	if r == 208 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @mix6 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.movRegReg x7, x4
    arm64.movRegReg x8, x5
    arm64.movImm x16, 2
    arm64.mul x1, x1, x16
    arm64.sub x0, x0, x1
    arm64.movImm x16, 3
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 4
    arm64.mul x1, x6, x16
    arm64.sub x0, x0, x1
    arm64.movImm x16, 5
    arm64.mul x1, x7, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 6
    arm64.mul x1, x8, x16
    arm64.sub x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @flip6 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x0
    arm64.movRegReg x7, x1
    arm64.movRegReg x8, x2
    arm64.movRegReg x9, x3
    arm64.movRegReg x10, x4
    arm64.movRegReg x11, x5
    arm64.movRegReg x0, x11
    arm64.movRegReg x1, x10
    arm64.movRegReg x2, x9
    arm64.movRegReg x3, x8
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x6
    arm64.bl mix6
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 20
    arm64.movImm x2, 3
    arm64.movImm x6, 30
    arm64.movImm x7, 2
    arm64.movImm x8, 40
    arm64.movRegReg x3, x6
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x8
    arm64.bl flip6
    arm64.cmp x0, 208
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
