// Test: rotate-six-params
function digits6(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int) returns int
	return p1 * 100000 + p2 * 10000 + p3 * 1000 + p4 * 100 + p5 * 10 + p6
end 'digits6'

function rotate6(a int, b int, c int, d int, e int, f int) returns int
	return digits6(b, p2: c, p3: d, p4: e, p5: f, p6: a)
end 'rotate6'

function main() returns ExitCode
	let r = rotate6(1, b: 2, c: 3, d: 4, e: 5, f: 6)
	if r == 234561 'ok'
		return 0
	end 'ok'
	return 99
end 'main'
---
ExitCode: 0
---
func @digits6 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x3
    arm64.movRegReg x7, x4
    arm64.movRegReg x8, x5
    arm64.movImm x16, 100000
    arm64.mul x0, x0, x16
    arm64.movImm x16, 10000
    arm64.mul x1, x1, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 1000
    arm64.mul x1, x2, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 100
    arm64.mul x1, x6, x16
    arm64.add x0, x0, x1
    arm64.movImm x16, 10
    arm64.mul x1, x7, x16
    arm64.add x0, x0, x1
    arm64.add x0, x0, x8
    arm64.epilogue 16
    arm64.ret
}

func @rotate6 {
  entry:
    arm64.prologue 16
    arm64.movRegReg x6, x0
    arm64.movRegReg x7, x3
    arm64.movRegReg x8, x4
    arm64.movRegReg x9, x5
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x7
    arm64.movRegReg x3, x8
    arm64.movRegReg x4, x9
    arm64.movRegReg x5, x6
    arm64.bl digits6
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.movImm x1, 2
    arm64.movImm x2, 3
    arm64.movImm x6, 4
    arm64.movImm x7, 5
    arm64.movImm x8, 6
    arm64.movRegReg x3, x6
    arm64.movRegReg x4, x7
    arm64.movRegReg x5, x8
    arm64.bl rotate6
    arm64.cmp x0, 234561
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
