    arm64.fadd d3, d0, d3
    arm64.frintn d3, d3
    arm64.fpLoadRdata d4, [rdata + __fconst_3]
    arm64.fadd d4, d0, d4
    arm64.fsqrt d4, d4
    arm64.fpLoadRdata d5, [rdata + __fconst_4.5]
    arm64.fadd d5, d0, d5
    arm64.frintm d5, d5
    arm64.fpLoadRdata d6, [rdata + __fconst_5.5]
    arm64.fadd d6, d0, d6
    arm64.frintp d6, d6
    arm64.fpLoadRdata d7, [rdata + __fconst_6.5]
    arm64.fadd d7, d0, d7
    arm64.frintn d7, d7
    arm64.fpLoadRdata d16, [rdata + __fconst_7]
    arm64.fadd d16, d0, d16
    arm64.fsqrt d16, d16
    arm64.fpLoadRdata d17, [rdata + __fconst_8.5]
    arm64.fadd d17, d0, d17
    arm64.frintm d17, d17
    arm64.fpLoadRdata d18, [rdata + __fconst_9.5]
    arm64.fadd d18, d0, d18
    arm64.frintp d18, d18
    arm64.fpLoadRdata d19, [rdata + __fconst_10.5]
    arm64.fadd d0, d0, d19
    arm64.frintn d0, d0
    arm64.fadd d1, d1, d2
    arm64.fadd d1, d1, d3
    arm64.fadd d1, d1, d4
    arm64.fadd d1, d1, d5
    arm64.fadd d1, d1, d6
    arm64.fadd d1, d1, d7
    arm64.fadd d1, d1, d16
    arm64.fadd d1, d1, d17
    arm64.fadd d1, d1, d18
    arm64.fadd d0, d1, d0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.bl scatter
    arm64.fcvtzs x0, d0
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
