// Test: eleven-live-floats-through-rounding-intrinsics
typealias Wide = float(f64.min to f64.max)

function scatter(a Wide) returns Wide
	let v0 = floor(a + 0.5)
	let v1 = ceil(a + 1.5)
	let v2 = round(a + 2.5)
	let v3 = sqrt(a + 3.0)
	let v4 = floor(a + 4.5)
	let v5 = ceil(a + 5.5)
	let v6 = round(a + 6.5)
	let v7 = sqrt(a + 7.0)
	let v8 = floor(a + 8.5)
	let v9 = ceil(a + 9.5)
	let v10 = round(a + 10.5)
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10
end 'scatter'

function main() returns ExitCode
	return trunc(scatter(1.0))
end 'main'
---
ExitCode: 64
---
func @scatter {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, d11
    arm64.storeSlotReg slot2, d10
    arm64.storeSlotReg slot1, d9
    arm64.storeSlotReg slot0, d8
    arm64.fpLoadRdata d1, [rdata + __fconst_0]
    arm64.fadd d1, d0, d1
    arm64.frintm d1, d1
    arm64.fpLoadRdata d2, [rdata + __fconst_1]
    arm64.fadd d2, d0, d2
    arm64.frintp d2, d2
    arm64.fpLoadRdata d3, [rdata + __fconst_2]
    arm64.fadd d3, d0, d3
    arm64.frintn d3, d3
    arm64.fpLoadRdata d4, [rdata + __fconst_3]
    arm64.fadd d4, d0, d4
    arm64.fsqrt d4, d4
    arm64.fpLoadRdata d5, [rdata + __fconst_4]
    arm64.fadd d5, d0, d5
    arm64.frintm d5, d5
    arm64.fpLoadRdata d6, [rdata + __fconst_5]
    arm64.fadd d6, d0, d6
    arm64.frintp d6, d6
    arm64.fpLoadRdata d7, [rdata + __fconst_6]
    arm64.fadd d7, d0, d7
    arm64.frintn d7, d7
    arm64.fpLoadRdata d8, [rdata + __fconst_7]
    arm64.fadd d8, d0, d8
    arm64.fsqrt d8, d8
    arm64.fpLoadRdata d9, [rdata + __fconst_8]
    arm64.fadd d9, d0, d9
    arm64.frintm d9, d9
    arm64.fpLoadRdata d10, [rdata + __fconst_9]
    arm64.fadd d10, d0, d10
    arm64.frintp d10, d10
    arm64.fpLoadRdata d11, [rdata + __fconst_10]
    arm64.fadd d0, d0, d11
    arm64.frintn d0, d0
    arm64.fadd d1, d1, d2
    arm64.fadd d1, d1, d3
    arm64.fadd d1, d1, d4
    arm64.fadd d1, d1, d5
    arm64.fadd d1, d1, d6
    arm64.fadd d1, d1, d7
    arm64.fadd d1, d1, d8
    arm64.fadd d1, d1, d9
    arm64.fadd d1, d1, d10
    arm64.fadd d0, d1, d0
    arm64.loadRegSlot d8, slot0
    arm64.loadRegSlot d9, slot1
    arm64.loadRegSlot d10, slot2
    arm64.loadRegSlot d11, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.fpLoadRdata d0, [rdata + __fconst_11]
    arm64.bl scatter
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
