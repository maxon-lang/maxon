// Test: return-struct-with-computed-fields

typealias Integer = int(i64.min to i64.max)

type Result
	export var sum as Integer
	export var product as Integer

	static function create(sum Integer, product Integer) returns Self
		return Self{sum: sum, product: product}
	end 'create'
end 'Result'

function compute(a Integer, b Integer) returns Result
	return Result.create(a + b, product: a * b)
end 'compute'

function main() returns ExitCode
	let r = compute(3, b: 4)
	return r.sum + r.product
end 'main'
---
ExitCode: 19
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Result.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.storeBaseDispReg.word64 [x0 + 8], x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @compute {
  entry:
    arm64.prologue 16
    arm64.add x2, x0, x1
    arm64.mul x1, x0, x1
    arm64.movRegReg x0, x2
    arm64.bl Result.create
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 3
    arm64.movImm x1, 4
    arm64.bl compute
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.add x19, x1, x2
    arm64.bl __mm_decref
    arm64.cmp x19, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x19, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at return-struct-with-computed-fields.test:20: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
