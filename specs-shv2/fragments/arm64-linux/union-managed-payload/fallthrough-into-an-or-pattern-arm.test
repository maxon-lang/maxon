// Test: fallthrough-into-an-or-pattern-arm
typealias Code = int(0 to 255)

union U
	a(x Code)
	b
	c
end 'U'

function main() returns ExitCode
	let u = U.a(9)
	var t = 0 as Code
	match u 'k'
		a(n) then t = n and fallthrough
		b or c then t = t + 1
	end 'k'
	return t as ExitCode
end 'main'
---
ExitCode: 10
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 9
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movImm x1, 0
    arm64.storeBaseDispReg.word64 [x0 + 0], x1
    arm64.storeBaseDispReg.word64 [x0 + 8], x19
    arm64.movImm x1, 0
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.cmp x2, 0
    arm64.cset x3, eq
    arm64.cbnz x3, matcharm#1
    arm64.b matchnext#4
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.b matcharm#2
  matchnext#4:
    arm64.cmp x2, 1
    arm64.cset x3, eq
    arm64.cbnz x3, critsplit#10
    arm64.b matchnext#5
  critsplit#10:
    arm64.b matcharm#2
  matchnext#5:
    arm64.cmp x2, 2
    arm64.cset x2, eq
    arm64.cbnz x2, critsplit#11
    arm64.b matchdead
  critsplit#11:
    arm64.b matcharm#2
  matcharm#2:
    arm64.add x19, x1, 1
    arm64.b matchcont
  matchcont:
    arm64.cmp x19, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at fallthrough-into-an-or-pattern-arm.test:17: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  matchdead:
}
