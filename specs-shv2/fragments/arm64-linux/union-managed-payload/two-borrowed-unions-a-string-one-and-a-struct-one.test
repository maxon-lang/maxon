    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext#4
  matcharm#1:
    arm64.movImm x20, 0
    arm64.b matchcont#5
  matchnext#4:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchdead#3
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movImm x21, 5
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x20, x21
    arm64.b matchcont#5
  matchcont#5:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#6
    arm64.b matchnext#9
  matcharm#6:
    arm64.movImm x0, 0
    arm64.b matchcont#10
  matchnext#9:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#7
    arm64.b matchdead#8
  matcharm#7:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x21, [x19 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x21
    arm64.b matchcont#10
  matchcont#10:
    arm64.add x0, x20, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
