// Test: nested-matches-of-two-borrowed-unions
typealias Integer = int(i64.min to i64.max)

union Inner
	quiet
	loud(word String)
end 'Inner'

union Outer
	blank
	holds(label String)
end 'Outer'

function both(o Outer, i Inner) returns Integer
	return match o 'x'
		blank gives 0
		holds(label) gives match i 'y'
			quiet gives 1
			loud(word) gives 2
		end 'y'
	end 'x'
end 'both'

function main() returns ExitCode
	let o = Outer.holds("the outer label string, long enough to be a heap allocation")
	let i = Inner.loud("the inner word string, long enough to be a heap allocation")
	let a = both(o, i: i)
	let b = both(o, i: i)
	return (a + b) as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @both {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext#9
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont#10
  matchnext#9:
    arm64.cmp x1, 1
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#2
    arm64.b matchdead#8
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#3
    arm64.b matchnext#6
  matcharm#3:
    arm64.movImm x19, 1
    arm64.b matchcont#7
  matchnext#6:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#4
    arm64.b matchdead#5
  matcharm#4:
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x21, 2
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x19, x21
    arm64.b matchcont#7
  matchcont#7:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.movRegReg x0, x19
    arm64.b matchcont#10
  matchcont#10:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead#5:
  matchdead#8:
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "the outer label string, long enough to be a heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.leaRdata x19, __str_rec_3  ; "the inner word string, long enough to be a heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl both
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x21
    arm64.bl both
    arm64.add x19, x19, x0
    arm64.cmp x19, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x19, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at nested-matches-of-two-borrowed-unions.test:29: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Inner
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Outer
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
