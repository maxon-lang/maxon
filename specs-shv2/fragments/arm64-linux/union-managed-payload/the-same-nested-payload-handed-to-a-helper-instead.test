// Test: the-same-nested-payload-handed-to-a-helper-instead
typealias Integer = int(i64.min to i64.max)

union Ty
	concrete(name String)
	stringy
end 'Ty'

union Expr
	direct(ty Ty)
	unresolved
end 'Expr'

function tyLen(ty Ty) returns Integer
	return match ty 'l'
		concrete(name) gives name.byteLength()
		stringy gives 0
	end 'l'
end 'tyLen'

function steal(e Expr) returns Integer
	return match e 'i'
		direct(ty) gives tyLen(ty)
		unresolved gives 99
	end 'i'
end 'steal'

function main() returns ExitCode
	let e = Expr.direct(Ty.concrete("a nested payload string, long enough to be a real heap allocation"))
	let stolen = steal(e)
	let again = match e 'k'
		direct(ty) gives tyLen(ty)
		unresolved gives 99
	end 'k'
	print("stolen={stolen} again={again}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tyLen {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.cmp x20, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl String.byteLength
    arm64.movRegReg x20, x0
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x0, 0
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @steal {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.bl tyLen
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Ty
    arm64.movRegReg x0, x20
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x0, 99
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 112
    arm64.storeSlotReg slot11, x28
    arm64.storeSlotReg slot10, x27
    arm64.storeSlotReg slot9, x26
    arm64.storeSlotReg slot8, x25
    arm64.storeSlotReg slot7, x24
    arm64.storeSlotReg slot6, x23
    arm64.storeSlotReg slot5, x22
    arm64.storeSlotReg slot4, x21
    arm64.storeSlotReg slot3, x20
    arm64.storeSlotReg slot2, x19
    arm64.leaRdata x19, __str_rec_3  ; "a nested payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x19, x0
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x20
    arm64.movRegReg x0, x19
    arm64.bl steal
    arm64.movRegReg x20, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x21, [x19 + 8]
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x19 + 8], x0
    arm64.movRegReg x0, x21
    arm64.bl tyLen
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Ty
    arm64.b matchcont
  matchnext:
    arm64.cmp x0, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.movImm x19, 99
  matchcont:
    arm64.leaRdata x0, __str_rec_4  ; "stolen="
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
