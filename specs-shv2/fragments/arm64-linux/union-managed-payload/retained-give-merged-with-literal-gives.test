// Test: retained-give-merged-with-literal-gives
union M
	one(a String)
	two(b String)
	none
end 'M'

function pick(m M) returns String
	return match m 'k'
		one(a) gives a
		two(b) gives "a rebuilt literal give long enough to be a heap string"
		none gives "a third literal give also long enough to be a heap string"
	end 'k'
end 'pick'

function main() returns ExitCode
	let x = M.one("the retained give, long enough to be a real heap allocation")
	let y = M.two("the discarded payload, long enough to be a real heap allocation")
	print(pick(x))
	print(pick(y))
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @pick {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#1
    arm64.b matchnext#5
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.b matchcont
  matchnext#5:
    arm64.cmp x1, 1
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#2
    arm64.b matchnext#6
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.leaRdata x0, __str_rec_4  ; "a rebuilt literal give long enough to be a heap string"
    arm64.bl __str_retain
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x20
    arm64.b matchcont
  matchnext#6:
    arm64.cmp x1, 2
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead
  matcharm#3:
    arm64.leaRdata x0, __str_rec_5  ; "a third literal give also long enough to be a heap string"
    arm64.bl __str_retain
    arm64.b matchcont
  matchcont:
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_6  ; "the retained give, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.leaRdata x19, __str_rec_7  ; "the discarded payload, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x21 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl print
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
    arm64.bl pick
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl print
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
    arm64.movImm x19, 0
    arm64.movRegReg x0, x21
    arm64.bl __destruct_M
    arm64.movRegReg x0, x20
    arm64.bl __destruct_M
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
