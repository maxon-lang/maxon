// Test: a-caught-retained-error-box-is-not-moved-out-of
typealias Integer = int(i64.min to i64.max)

union Err
	bad(why String)
end 'Err'

type Holder
	export var e as Err

	static function create(e Err) returns Self
		return Self{e: e}
	end 'create'
end 'Holder'

function boom(h Holder) returns Integer throws Err
	throw h.e
end 'boom'

function whyLen(e Err) returns Integer
	return match e 'l'
		bad(why) gives why.byteLength()
	end 'l'
end 'whyLen'

function main() returns ExitCode
	let h = Holder.create(Err.bad("a caught retained payload, long enough for the heap"))
	var first = 0 as Integer
	try boom(h) otherwise (e) 'caught'
		first = match e 'm'
			bad(why) gives why.byteLength()
		end 'm'
	end 'caught'
	let second = whyLen(h.e)
	print("first={first} second={second}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Err
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @boom {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x19, [x0 + 0]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @whyLen {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x19, [x0 + 8]
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.cmp x20, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x19
    arm64.bl String.byteLength
    arm64.movRegReg x20, x0
  __il_cont:
    arm64.movRegReg x0, x19
    arm64.bl __str_decref
  matchcont:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  matchdead:
}

func @main {
  entry:
    arm64.prologue 112
    arm64.storeSlotReg slot11, x28
    arm64.storeSlotReg slot10, x27
    arm64.storeSlotReg slot9, x26
    arm64.storeSlotReg slot8, x25
    arm64.storeSlotReg slot7, x24
    arm64.storeSlotReg slot6, x23
    arm64.storeSlotReg slot5, x22
    arm64.storeSlotReg slot4, x21
    arm64.storeSlotReg slot3, x20
    arm64.storeSlotReg slot2, x19
    arm64.leaRdata x19, __str_rec_3  ; "a caught retained payload, long enough for the heap"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl Holder.create
    arm64.movRegReg x19, x0
    arm64.storeSlotReg slot0, x19
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl boom
    arm64.movRegReg x21, x9
    arm64.cmp x21, 0
    arm64.b.eq tryok
  tryerr:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.cmp x0, 0
    arm64.b.ne matchdead
  matcharm:
    arm64.loadRegBaseDisp.word64 x20, [x21 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x22, [x20 + 8]
    arm64.cmp x22, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x20
    arm64.bl String.byteLength
    arm64.movRegReg x22, x0
  __il_cont:
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
  matchcont:
    arm64.movRegReg x0, x21
    arm64.bl __destruct_Err
    arm64.b trycont
  matchdead:
  tryok:
    arm64.movRegReg x22, x20
  trycont:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl whyLen
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_4  ; "first="
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x21, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x22
    arm64.movRegReg x1, x23
    arm64.bl __int_to_string
    arm64.movRegReg x22, x0
    arm64.leaRdata x0, __str_rec_5  ; " second="
    arm64.loadRegBaseDisp.word64 x24, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x25, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x26, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x26
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.add x0, x21, x22
    arm64.add x0, x0, x25
    arm64.add x0, x0, x19
    arm64.storeSlotReg slot1, x0
    arm64.add x0, x0, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x27, x0
    arm64.add x28, x27, 56
    arm64.movRegReg x0, x28
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x20, x28, x21
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x20, x20, x22
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x24
    arm64.movRegReg x2, x25
    arm64.bl __str_copy
    arm64.add x20, x20, x25
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x26
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x0, x20, x19
    arm64.storeBaseDispReg.word64 [x27 + 0], x28
    arm64.loadRegSlot x0, slot1
    arm64.storeBaseDispReg.word64 [x27 + 8], x0
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x27 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x27 + 24], x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x26
    arm64.bl __mm_decref
    arm64.movRegReg x0, x27
    arm64.bl print
    arm64.movRegReg x0, x27
    arm64.bl __str_decref
    arm64.movImm x19, 0
    arm64.loadRegSlot x0, slot0
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot2
    arm64.loadRegSlot x20, slot3
    arm64.loadRegSlot x21, slot4
    arm64.loadRegSlot x22, slot5
    arm64.loadRegSlot x23, slot6
    arm64.loadRegSlot x24, slot7
    arm64.loadRegSlot x25, slot8
    arm64.loadRegSlot x26, slot9
    arm64.loadRegSlot x27, slot10
    arm64.loadRegSlot x28, slot11
    arm64.epilogue 112
    arm64.ret
}
