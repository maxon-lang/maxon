// Test: borrowed-bind-out-of-a-union-held-in-a-struct-field
typealias Integer = int(i64.min to i64.max)
typealias Round = int(0 to 1000)

union M
	silent
	text(body String)
end 'M'

type Holder
	export var m as M

	static function create(m M) returns Self
		return Self{m: m}
	end 'create'
end 'Holder'

function main() returns ExitCode
	let h = Holder.create(M.text("a field-held payload string, long enough to be a real heap allocation"))
	var i = 0 as Round
	var n = 0 as Integer
	while i < 200 'spin'
		match h.m 'k'
			silent then n = n + 1
			text(s) then n = n + s.byteLength()
		end 'k'
		i = i + 1
	end 'spin'
	print("n={n}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __destruct_M
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "a field-held payload string, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl Holder.create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
    arm64.movImm x21, 0
  whilehdr:
    arm64.cmp x20, 200
    arm64.b.ge whileexit
  spin:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#4:
    arm64.add x0, x21, 1
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#5:
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.movRegReg x0, x22
    arm64.bl __mm_incref
  __il_body:
    arm64.loadRegBaseDisp.word64 x0, [x22 + 8]
    arm64.cmp x0, 0
    arm64.b.ge __il_cont
  __il_slow:
    arm64.movRegReg x0, x22
    arm64.bl String.byteLength
  __il_cont:
    arm64.add x21, x21, x0
    arm64.movRegReg x0, x22
    arm64.bl __str_decref
    arm64.movRegReg x0, x21
  matchcont:
    arm64.add x20, x20, 1
    arm64.movRegReg x21, x0
    arm64.b whilehdr
  matchdead:
  whileexit:
    arm64.leaRdata x0, __str_rec_3  ; "n="
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x23
    arm64.bl __int_to_string
    arm64.movRegReg x21, x0
    arm64.add x24, x22, x21
    arm64.add x0, x24, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x25, x0
    arm64.add x26, x25, 56
    arm64.movRegReg x0, x26
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x20, x26, x22
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x20, x21
    arm64.storeBaseDispReg.word64 [x25 + 0], x26
    arm64.storeBaseDispReg.word64 [x25 + 8], x24
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x25 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x25 + 24], x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x25
    arm64.bl print
    arm64.movRegReg x0, x25
    arm64.bl __str_decref
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
}
