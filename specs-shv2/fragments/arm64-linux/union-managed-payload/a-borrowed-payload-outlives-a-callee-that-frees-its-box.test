// Test: a-borrowed-payload-outlives-a-callee-that-frees-its-box
typealias Integer = int(i64.min to i64.max)

union Slot
	filled(s String)
	empty(n Integer)
end 'Slot'

type Cell
	export var slot as Slot

	static function create(slot Slot) returns Self
		return Self{slot: slot}
	end 'create'

	// Frees the box its argument was borrowed out of, BEFORE reading the argument. The
	// `refill` allocation is what makes the freed record's reuse observable rather than benign.
	function replaceThenMeasure(borrowed String) returns Integer
		self.slot = Slot.empty(7)
		let refill = "a fresh allocation of its own, reusing the freed record"
		return (borrowed.byteLength() * 1000 + refill.byteLength()) as Integer
	end 'replaceThenMeasure'
end 'Cell'

function main() returns ExitCode
	let cell = Cell.create(Slot.filled("the borrowed payload, long enough to be a real heap allocation"))
	let measured = match cell.slot 'm'
		filled(s) gives cell.replaceThenMeasure(s)
		empty(n) gives n
	end 'm'
	print("measured={measured}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Cell.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_incref
    arm64.storeBaseDispReg.word64 [x20 + 0], x19
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Slot
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @Cell.replaceThenMeasure {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x21, 7
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x21
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.bl __destruct_Slot
    arm64.storeBaseDispReg.word64 [x19 + 0], x22
    arm64.leaRdata x19, __str_rec_3  ; "a fresh allocation of its own, reusing the freed record"
  __il_body#3:
    arm64.loadRegBaseDisp.word64 x0, [x20 + 8]
    arm64.cmp x0, 0
    arm64.b.ge __il_cont#2
  __il_slow#5:
    arm64.movRegReg x0, x20
    arm64.bl String.byteLength
  __il_cont#2:
    arm64.movImm x16, 1000
    arm64.mul x20, x0, x16
  __il_body#6:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.b.ge __il_cont#1
  __il_slow#8:
    arm64.movRegReg x0, x19
    arm64.bl String.byteLength
  __il_cont#1:
    arm64.add x0, x20, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot7, x26
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_4  ; "the borrowed payload, long enough to be a real heap allocation"
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 8], x0
    arm64.movRegReg x0, x20
    arm64.bl Cell.create
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x0, x20
    arm64.bl __mm_incref
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl Cell.replaceThenMeasure
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x20, [x0 + 8]
    arm64.movRegReg x21, x20
  matchcont:
    arm64.leaRdata x0, __str_rec_5  ; "measured="
    arm64.loadRegBaseDisp.word64 x20, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x23
    arm64.bl __int_to_string
    arm64.movRegReg x21, x0
    arm64.add x24, x22, x21
    arm64.add x0, x24, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x25, x0
    arm64.add x26, x25, 56
    arm64.movRegReg x0, x26
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x20, x26, x22
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x23
    arm64.movRegReg x2, x21
    arm64.bl __str_copy
    arm64.add x0, x20, x21
    arm64.storeBaseDispReg.word64 [x25 + 0], x26
    arm64.storeBaseDispReg.word64 [x25 + 8], x24
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x25 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x25 + 24], x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x25
    arm64.bl print
    arm64.movRegReg x0, x25
    arm64.bl __str_decref
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Cell
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.loadRegSlot x25, slot6
    arm64.loadRegSlot x26, slot7
    arm64.epilogue 80
    arm64.ret
  matchdead:
}
