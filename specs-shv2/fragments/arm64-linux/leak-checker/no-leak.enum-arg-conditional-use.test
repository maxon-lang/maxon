// Test: no-leak.enum-arg-conditional-use
typealias Integer = int(i64.min to i64.max)

union Op
	addOp(left Integer, right Integer)
	mulOp(left Integer, right Integer)
end 'Op'

function applyOp(useAdd bool, addArg Op, mulArg Op) returns Integer
	if useAdd 'branch'
		return match addArg 'matchAdd'
			addOp(left, right) gives left + right
			mulOp(left, right) gives left * right
		end 'matchAdd'
	end 'branch' else 'other'
		return match mulArg 'matchMul'
			addOp(left, right) gives left + right
			mulOp(left, right) gives left * right
		end 'matchMul'
	end 'other'
end 'applyOp'

function main() returns ExitCode
	let result = applyOp(true, addArg: Op.addOp(3, right: 4), mulArg: Op.mulOp(5, right: 6))
	print("{result}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @applyOp {
  entry:
    arm64.prologue 16
    arm64.cbnz x0, branch
    arm64.b ifelse
  branch:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.cmp x0, 0
    arm64.cset x2, eq
    arm64.cbnz x2, matcharm#2
    arm64.b matchnext#5
  matcharm#2:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.add x0, x0, x1
    arm64.b matchcont#6
  matchnext#5:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#3
    arm64.b matchdead#4
  matcharm#3:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x1 + 16]
    arm64.mul x0, x0, x1
    arm64.b matchcont#6
  matchcont#6:
    arm64.epilogue 16
    arm64.ret
  matchdead#4:
  ifelse:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#8
    arm64.b matchnext#11
  matcharm#8:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x2 + 16]
    arm64.add x0, x0, x1
    arm64.b matchcont#12
  matchnext#11:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#9
    arm64.b matchdead#10
  matcharm#9:
    arm64.loadRegBaseDisp.word64 x0, [x2 + 8]
    arm64.loadRegBaseDisp.word64 x1, [x2 + 16]
    arm64.mul x0, x0, x1
    arm64.b matchcont#12
  matchcont#12:
    arm64.epilogue 16
    arm64.ret
  matchdead#10:
  ifcont:
}

func @main {
  entry:
    arm64.prologue 80
    arm64.storeSlotReg slot6, x25
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 1
    arm64.movImm x20, 3
    arm64.movImm x21, 4
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x22, x0
    arm64.movImm x0, 0
    arm64.storeBaseDispReg.word64 [x22 + 0], x0
    arm64.storeBaseDispReg.word64 [x22 + 8], x20
    arm64.storeBaseDispReg.word64 [x22 + 16], x21
    arm64.movImm x20, 5
    arm64.movImm x21, 6
    arm64.movImm x0, 24
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x23, x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x23 + 0], x0
    arm64.storeBaseDispReg.word64 [x23 + 8], x20
    arm64.storeBaseDispReg.word64 [x23 + 16], x21
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x22
    arm64.movRegReg x2, x23
    arm64.bl applyOp
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x23
    arm64.bl __mm_decref
    arm64.movRegReg x0, x22
    arm64.bl __mm_decref
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl __int_to_string
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_1  ; "\x0a"
    arm64.loadRegBaseDisp.word64 x21, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x22, [x0 + 8]
    arm64.add x23, x19, x22
    arm64.add x0, x23, 57
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x24, x0
    arm64.add x25, x24, 56
    arm64.movRegReg x0, x25
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x19
    arm64.bl __str_copy
    arm64.add x19, x25, x19
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x21
    arm64.movRegReg x2, x22
    arm64.bl __str_copy
    arm64.add x0, x19, x22
    arm64.storeBaseDispReg.word64 [x24 + 0], x25
    arm64.storeBaseDispReg.word64 [x24 + 8], x23
    arm64.movImm x0, 18446744073709551613
    arm64.storeBaseDispReg.word64 [x24 + 16], x0
    arm64.movImm x0, 1
    arm64.storeBaseDispReg.word64 [x24 + 24], x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x24
    arm64.bl print
    arm64.movRegReg x0, x24
    arm64.bl __str_decref
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
