// Test: managed-self-field-write
type Box
	export var name as String

	export function setName(n String)
		name = n
	end 'setName'

	static function create() returns Self
		return Self{name: "aaa"}
	end 'create'
end 'Box'

function main() returns ExitCode
	var b = Box.create()
	b.setName("bb")
	if b.name == "bb" 'ok'
		return 2
	end 'ok'
	return 0
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.setName {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movRegReg x0, x1
    arm64.bl __str_retain
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.bl __str_decref
    arm64.storeBaseDispReg.word64 [x19 + 0], x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_2  ; "aaa"
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __str_retain
    arm64.storeBaseDispReg.word64 [x20 + 0], x0
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Box.create
    arm64.movRegReg x19, x0
    arm64.leaRdata x1, __str_rec_3  ; "bb"
    arm64.movRegReg x0, x19
    arm64.bl Box.setName
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.leaRdata x1, __str_rec_3  ; "bb"
    arm64.bl __str_eq
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Box
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_Box
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
