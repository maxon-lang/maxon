// Test: nested-short-circuit
var calls = 0

function a() returns bool
	calls = calls + 1
	return true
end 'a'

function b() returns bool
	calls = calls + 10
	return false
end 'b'

function c() returns bool
	calls = calls + 100
	return true
end 'c'

function main() returns ExitCode
	let inner = b() or c()
	let result = a() and inner
	if result 'r'
		return calls as ExitCode
	end 'r'
	return 99
end 'main'
---
ExitCode: 111
---
data {
  __data_calls@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body#11
  __il_body#11:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 10
    arm64.leaGlobal x1, __data_calls
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#10
  __il_cont#10:
    arm64.b orrhs
  orrhs:
    arm64.b __il_body#13
  __il_body#13:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 100
    arm64.leaGlobal x1, __data_calls
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 1
    arm64.b __il_cont#12
  __il_cont#12:
    arm64.b scmerge#2
  scmerge#2:
    arm64.b __il_body#15
  __il_body#15:
    arm64.leaGlobal x1, __data_calls
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_calls
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.b __il_cont#14
  __il_cont#14:
    arm64.b andrhs
  andrhs:
    arm64.b scmerge#4
  scmerge#4:
    arm64.cbnz x0, r
    arm64.b ifcont
  r:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at nested-short-circuit.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
