// Test: nested-short-circuit
var calls = 0

function a() returns bool
	calls = calls + 1
	return true
end 'a'

function b() returns bool
	calls = calls + 10
	return false
end 'b'

function c() returns bool
	calls = calls + 100
	return true
end 'c'

function main() returns ExitCode
	let inner = b() or c()
	let result = a() and inner
	if result 'r'
		return calls as ExitCode
	end 'r'
	return 99
end 'main'
---
ExitCode: 111
---
data {
  __data_calls@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
  __il_body#11:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 10
    arm64.leaGlobal x1, __data_calls
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
  __il_body#13:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 100
    arm64.leaGlobal x1, __data_calls
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x0, 1
  __il_body#15:
    arm64.leaGlobal x1, __data_calls
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_calls
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
  scmerge:
    arm64.cbz x0, ifcont
  r:
    arm64.leaGlobal x0, __data_calls
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at nested-short-circuit.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
}
