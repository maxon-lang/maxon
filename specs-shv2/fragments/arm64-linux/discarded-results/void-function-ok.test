// Test: void-function-ok

function doNothing()
end 'doNothing'

function main() returns ExitCode
	doNothing()
	return 0
end 'main'
---
ExitCode: 0
---
func @doNothing {
  entry:
    arm64.prologue 16
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.bl doNothing
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
