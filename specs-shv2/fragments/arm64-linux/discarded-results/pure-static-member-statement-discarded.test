// Test: pure-static-member-statement-discarded
typealias Integer = int(i64.min to i64.max)

type Clock
	static function now() returns Integer
		return 7
	end 'now'
end 'Clock'

function main() returns ExitCode
	Clock.now()
	return 0
end 'main'
