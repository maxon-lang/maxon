// Test: underscore-discard-of-a-bare-binding-is-the-e3012-acknowledgement
typealias Tally = int(0 to u64.max)

function main() returns ExitCode
	let seen = 3 as Tally
	_ = seen
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
