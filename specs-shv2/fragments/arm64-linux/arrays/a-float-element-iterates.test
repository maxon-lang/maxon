// Test: a-float-element-iterates
function main() returns ExitCode
	let a = [1.5, 2.5, 3.5]
	var sum = 0.0
	for e in a 'each'
		sum = sum + e
	end 'each'
	return trunc(sum)
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4609434218613702656
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 4612811918334230528
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 4615063718147915776
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
  forhdr:
    arm64.cmp x0, x1
    arm64.b.ge forexit
  each:
    arm64.loadRegBaseIndexScale.word64 x3, [x2 + x0*8 + 0]
  __im_cont:
    arm64.fmov d1, x3
    arm64.fadd d0, d0, d1
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  forexit:
    arm64.fcvtzs x20, d0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-float-element-iterates.test:8: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
