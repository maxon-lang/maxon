    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 50
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 1
    arm64.movImm x2, 4
    arm64.movRegReg x0, x19
    arm64.bl __arr_slice
    arm64.movRegReg x20, x0
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  tryok:
    arm64.movImm x1, 0
    arm64.movImm x2, 92
    arm64.movRegReg x0, x20
    arm64.bl __arr_set
    arm64.cmp x9, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr
    arm64.b tryok
  tryerr:
    arm64.leaRdata x0, __str_rec_1
    arm64.movImm x0, 134
