  andrhs#8:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.b scmerge#9
  critsplit#17:
    arm64.movRegReg x0, x1
    arm64.b scmerge#9
  scmerge#9:
    arm64.cbnz x0, ok
    arm64.b ifcont
  ok:
