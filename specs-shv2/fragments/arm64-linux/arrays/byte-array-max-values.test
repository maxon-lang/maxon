// Test: byte-array-max-values

typealias Byte = int(0 to u8.max)

typealias ByteArray = Array with Byte

function main() returns ExitCode
	var arr = ByteArray.create()
	arr.push(255 as Byte)
	arr.push(0 as Byte)
	arr.push(128 as Byte)

	let v0 = try arr.get(0) otherwise 0 as Byte
	let v1 = try arr.get(1) otherwise 99 as Byte
	let v2 = try arr.get(2) otherwise 0 as Byte

	if v0 != 255 'c0'
		return 1
	end 'c0'
	if v1 != 0 'c1'
		return 2
	end 'c1'
	if v2 != 128 'c2'
		return 3
	end 'c2'

	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __arr_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 255
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 128
    arm64.movRegReg x0, x19
    arm64.bl __arr_push
    arm64.movImm x1, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x20, 0
    arm64.b trycont
  tryok:
    arm64.movRegReg x20, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x21, 99
    arm64.b trycont
  tryok:
    arm64.movRegReg x21, x0
    arm64.b trycont
  trycont:
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __arr_get
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr
    arm64.b tryok
  tryerr:
    arm64.movImm x0, 0
    arm64.b trycont
  tryok:
    arm64.b trycont
  trycont:
    arm64.cmp x20, 255
    arm64.cset x1, ne
    arm64.cbnz x1, c0
    arm64.b ifcont
  c0:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.cmp x21, 0
    arm64.cset x1, ne
    arm64.cbnz x1, c1
    arm64.b ifcont
  c1:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.cmp x0, 128
    arm64.cset x0, ne
    arm64.cbnz x0, c2
    arm64.b ifcont
  c2:
    arm64.movImm x20, 3
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  ifcont:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __arr_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
