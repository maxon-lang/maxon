// Test: a-float-element-survives-a-clone
function main() returns ExitCode
	var a = [1.5, 2.5]
	a.push(3.5)
	let c = a.clone()
	return trunc((try c.get(2) otherwise 0.0) + (try c.get(0) otherwise 0.0))
end 'main'
