// Test: first-class-function.function-value-into-field-errors

typealias Integer = int(i64.min to i64.max)

type Box
	export var slot as Integer

	static function create() returns Self
		return Self{slot: 0}
	end 'create'
end 'Box'

function dbl(n Integer) returns Integer
	return n * 2
end 'dbl'

function main() returns ExitCode
	var b = Box.create()
	b.slot = dbl
	return b.slot as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:19:4: cannot assign a value of type 'function' to field 'slot', which holds 'int': a function value is only usable where a function type declared with 'typealias' is expected
