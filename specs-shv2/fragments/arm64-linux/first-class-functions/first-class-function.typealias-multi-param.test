// Test: first-class-function.typealias-multi-param

typealias Integer = int(i64.min to i64.max)
typealias BinaryOp = function(Integer, Integer) returns Integer

function add(x Integer, y Integer) returns Integer
	return x + y
end 'add'

function compute(f BinaryOp, a Integer, b Integer) returns Integer
	return f(a, b)
end 'compute'

function main() returns ExitCode
	return compute(add, a: 15, b: 27)
end 'main'
---
ExitCode: 42
---
func @add {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, x1
    arm64.epilogue 16
    arm64.ret
}

func @compute {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x6, x3
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.movRegReg x2, x6
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaFuncAddr x0, __fnref_add
    arm64.movImm x1, 15
    arm64.movImm x2, 27
    arm64.movImm x6, 0
    arm64.movRegReg x3, x6
    arm64.bl compute
    arm64.epilogue 16
    arm64.ret
}
