// Test: first-class-function.field-value-called-as-statement-discarded

typealias Integer = int(i64.min to i64.max)
typealias UnaryOp = function(Integer) returns Integer

type Handler
	export var op as UnaryOp

	static function create(op UnaryOp) returns Self
		return Self{op: op}
	end 'create'
end 'Handler'

function inc(n Integer) returns Integer
	return n + 1
end 'inc'

function main() returns ExitCode
	let h = Handler.create(inc)
	h.op(10)
	return h.op(41)
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @inc {
  entry:
    arm64.prologue 16
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x20
    arm64.storeSlotReg slot1, x19
    arm64.leaFuncAddr x0, __fnref_inc
    arm64.movImm x1, 0
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movImm x0, 10
    arm64.movImm x1, 0
    arm64.blr x20
    arm64.loadRegBaseDisp.word64 x19, [x19 + 0]
    arm64.movImm x0, 41
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.field-value-called-as-statement-discarded.test:21: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot1
    arm64.loadRegSlot x20, slot2
    arm64.epilogue 48
    arm64.ret
}
