// Test: first-class-function.generic-instance-parameter-through-alias-is-identified-by-type-not-by-intern-order

typealias Integer = int(i64.min to i64.max)
typealias Small = int(0 to 10)
typealias SmallArray = Array with Small

type Field
	export var v as Integer

	export static function create(v Integer) returns Field
		return Self{v: v}
	end 'create'
end 'Field'

typealias FieldArray = Array with Field
typealias FieldConsumer = function(FieldArray) returns Integer

function countFields(fields FieldArray) returns Integer
	return fields.count()
end 'countFields'

function apply(f FieldConsumer) returns Integer
	var fields = FieldArray.create()
	fields.push(Field.create(5))
	return f(fields)
end 'apply'

function main() returns ExitCode
	var s = SmallArray.create()
	s.push(3)
	return (apply(countFields) + s.count()) as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Field.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @countFields {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.epilogue 16
    arm64.ret
}

func @apply {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __mm_decref
    arm64.bl __managed_create
    arm64.movRegReg x21, x0
    arm64.movImm x0, 5
    arm64.bl Field.create
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_push
    arm64.movRegReg x0, x21
    arm64.movRegReg x1, x20
    arm64.blr x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 18446744073709551612
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.leaFuncAddr x0, __fnref_countFields
    arm64.movImm x1, 0
    arm64.bl apply
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.add x20, x0, x1
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.generic-instance-parameter-through-alias-is-identified-by-type-not-by-intern-order.test:31: Range check failed: value outside type"...
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
