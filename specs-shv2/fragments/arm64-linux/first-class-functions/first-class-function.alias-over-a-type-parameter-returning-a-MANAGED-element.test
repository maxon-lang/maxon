// Test: first-class-function.alias-over-a-type-parameter-returning-a-MANAGED-element
typealias Integer = int(i64.min to i64.max)

type Holder uses Element
	export var value as Element

	export static function create(v Element) returns Self
		return Self{value: v}
	end 'create'
end 'Holder'

export extension Holder
	typealias Transform = function(Element) returns Element

	export function apply(f Transform) returns Element
		return f(self.value)
	end 'apply'
end 'Holder'

typealias IntHolder = Holder with Integer
typealias TextHolder = Holder with String

function twice(n Integer) returns Integer
	return n * 2
end 'twice'

function shout(s String) returns String
	return "{s}!"
end 'shout'

function main() returns ExitCode
	let n = IntHolder.create(21)
	let t = TextHolder.create("hi")
	let doubled = n.apply(twice)
	let loud = t.apply(shout)
	print("{doubled} {loud}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Holder.apply {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movRegReg x1, x2
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @twice {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

