// Test: first-class-function.field-two-fields-called-as-statements
var effA = 0
var effB = 0

typealias Task = function()

type Pair
	export var first as Task
	export var second as Task

	static function create(first Task, second Task) returns Self
		return Self{first: first, second: second}
	end 'create'
end 'Pair'

function bumpA()
	effA = effA + 10
end 'bumpA'

function bumpB()
	effB = effB + 4
end 'bumpB'

function main() returns ExitCode
	let p = Pair.create(bumpA, second: bumpB)
	p.first()
	p.second()
	return (effA + effB) as ExitCode
end 'main'
---
ExitCode: 14
---
data {
  __data_effA@0 = i64 0
  __data_effB@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __slab_arena_list@24 = i64 0
  __slab_arena_map_l1@32 = i64 0
  __slab_state@40 = i64 0
}

func @bumpA {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_effA
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 10
    arm64.leaGlobal x1, __data_effA
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.epilogue 16
    arm64.ret
}

func @bumpB {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_effB
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 4
    arm64.leaGlobal x1, __data_effB
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x20
    arm64.storeSlotReg slot2, x19
    arm64.leaFuncAddr x0, __fnref_bumpA
    arm64.leaFuncAddr x1, __fnref_bumpB
    arm64.movImm x2, 0
    arm64.movImm x2, 0
    arm64.leaRegSlot x19, slot0
    arm64.storeBaseDispReg.word64 [x19 + 0], x0
    arm64.storeBaseDispReg.word64 [x19 + 8], x1
    arm64.loadRegBaseDisp.word64 x20, [x19 + 0]
    arm64.movImm x0, 0
    arm64.blr x20
    arm64.loadRegBaseDisp.word64 x19, [x19 + 8]
    arm64.movImm x0, 0
    arm64.blr x19
    arm64.leaGlobal x0, __data_effA
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.leaGlobal x1, __data_effB
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x0, x0, x1
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at first-class-function.field-two-fields-called-as-statements.test:28: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot2
    arm64.loadRegSlot x20, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot2
    arm64.loadRegSlot x20, slot3
    arm64.epilogue 48
    arm64.ret
}
