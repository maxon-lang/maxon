// Test: first-class-function.non-capturing-closure-through-ternary

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let c = 1
	let twice = function(n Integer) gives n * 2
	let thrice = function(n Integer) gives n * 3
	let h = twice if c > 0 else thrice
	return h(21)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 1
    arm64.leaFuncAddr x19, main$closure_0
    arm64.leaFuncAddr x20, main$closure_1
    arm64.cmp x0, 0
    arm64.cset x0, gt
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.b matchcont
  ternaryfalse:
    arm64.movRegReg x19, x20
    arm64.b matchcont
  matchcont:
    arm64.movImm x0, 21
    arm64.movImm x1, 0
    arm64.blr x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main$closure_0 {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 2
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}

func @main$closure_1 {
  entry:
    arm64.prologue 16
    arm64.movImm x16, 3
    arm64.mul x0, x0, x16
    arm64.epilogue 16
    arm64.ret
}
