// Test: a-float-element-reads-through-the-same-addressing-mode
typealias Real = float(f64.min to f64.max)
typealias RealArray = Array with Real

function total(a RealArray) returns Real
	var t = 0.0
	for v in a 'loop'
		t = t + v
	end 'loop'
	return t
end 'total'

function main() returns ExitCode
	var a = RealArray.create()
	a.push(1.5)
	a.push(2.25)
	a.push(4.0)
	if total(a) != 7.75 'sum'
		return 1
	end 'sum'
	if (try a.get(1) otherwise panic("get: index out of range")) != 2.25 'middle'
		return 2
	end 'middle'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 4609434218613702656
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 4612248968380809216
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 4616189618054758400
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
  __il_body:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.movImm x0, 0
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.loadRegBaseDisp.word64 x2, [x19 + 0]
  forhdr:
    arm64.cmp x0, x1
    arm64.b.ge __il_cont
  loop:
    arm64.arm64AddLsl x3, x2, x0, lsl #3
    arm64.loadRegBaseDisp.word64 x3, [x3 + 0]
  __im_cont#17:
    arm64.fmov d1, x3
    arm64.fadd d0, d0, d1
  forstep:
    arm64.add x0, x0, 1
    arm64.b forhdr
  __il_cont:
    arm64.fpLoadRdata d1, [rdata + __fconst_7.75]
    arm64.fcmp d0, d1
    arm64.b.eq ifcont#2
  sum:
    arm64.movImm x20, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#2:
    arm64.movImm x1, 1
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x0, 1
    arm64.b.ls __im_slow
  __im_load:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.add x0, x0, 8
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.movImm x2, 0
    arm64.loadRegBaseDisp.word64 x3, [x19 + 40]
    arm64.cmp x3, 0
    arm64.b.eq critsplit#18
  __im_empty:
    arm64.cmp x0, 0
    arm64.b.ne critsplit#19
  __im_slow:
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.b __im_cont#7
  critsplit#19:
    arm64.movRegReg x9, x2
    arm64.b __im_cont#7
  critsplit#18:
    arm64.movRegReg x9, x2
  __im_cont#7:
    arm64.fmov d0, x0
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_0  ; "panic at a-float-element-reads-through-the-same-addressing-mode.test:21: get: index out of range\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  tryok:
    arm64.fpLoadRdata d1, [rdata + __fconst_2.25]
    arm64.fcmp d0, d1
    arm64.b.eq ifcont#6
  middle:
    arm64.movImm x20, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont#6:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
