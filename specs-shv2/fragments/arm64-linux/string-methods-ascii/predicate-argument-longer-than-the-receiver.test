// Test: predicate-argument-longer-than-the-receiver
function main() returns ExitCode
	let s = "hi"
	if s.startsWith("hello") 'a'
		print("badStart\n")
	end 'a'
	if s.endsWith("hello") 'b'
		print("badEnd\n")
	end 'b'
	if s.contains("hello") 'c'
		print("badContains\n")
	end 'c'
	if s.startsWith("") 'd'
		print("emptyPrefix\n")
	end 'd'
	if s.endsWith("") 'e'
		print("emptySuffix\n")
	end 'e'
	if s.contains("") 'f'
		print("emptyNeedle\n")
	end 'f'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x19, __str_rec_9  ; "hi"
    arm64.leaRdata x1, __str_rec_10  ; "hello"
    arm64.movRegReg x0, x19
    arm64.bl String.startsWith
    arm64.cbz x0, ifcont#2
  a:
    arm64.leaRdata x0, __str_rec_11  ; "badStart\x0a"
    arm64.bl print
  ifcont#2:
    arm64.leaRdata x1, __str_rec_10  ; "hello"
    arm64.movRegReg x0, x19
    arm64.bl String.endsWith
    arm64.cbz x0, ifcont#4
  b:
    arm64.leaRdata x0, __str_rec_12  ; "badEnd\x0a"
    arm64.bl print
  ifcont#4:
    arm64.leaRdata x1, __str_rec_10  ; "hello"
    arm64.movRegReg x0, x19
    arm64.bl String.contains
    arm64.cbz x0, ifcont#6
  c:
    arm64.leaRdata x0, __str_rec_13  ; "badContains\x0a"
    arm64.bl print
  ifcont#6:
    arm64.leaRdata x1, __str_rec_14  ; ""
    arm64.movRegReg x0, x19
    arm64.bl String.startsWith
    arm64.cbz x0, ifcont#8
  d:
    arm64.leaRdata x0, __str_rec_15  ; "emptyPrefix\x0a"
    arm64.bl print
  ifcont#8:
    arm64.leaRdata x1, __str_rec_14  ; ""
    arm64.movRegReg x0, x19
    arm64.bl String.endsWith
    arm64.cbz x0, ifcont#10
  e:
    arm64.leaRdata x0, __str_rec_16  ; "emptySuffix\x0a"
    arm64.bl print
  ifcont#10:
    arm64.leaRdata x1, __str_rec_14  ; ""
    arm64.movRegReg x0, x19
    arm64.bl String.contains
    arm64.cbz x0, ifcont#12
  f:
    arm64.leaRdata x0, __str_rec_17  ; "emptyNeedle\x0a"
    arm64.bl print
  ifcont#12:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
