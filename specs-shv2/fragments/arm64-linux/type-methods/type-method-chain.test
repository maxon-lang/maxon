    arm64.b __il_body#8
  __il_body#8:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 10
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#7
  __il_cont#7:
    arm64.b __il_body#9
  __il_body#9:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 20
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#6
  __il_cont#6:
    arm64.b __il_body#10
  __il_body#10:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.add x0, x0, 12
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont#5
  __il_cont#5:
    arm64.b __il_body#11
  __il_body#11:
    arm64.loadRegBaseDisp.word64 x0, [x1 + 0]
    arm64.b __il_cont#4
  __il_cont#4:
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at type-method-chain.test:26: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
