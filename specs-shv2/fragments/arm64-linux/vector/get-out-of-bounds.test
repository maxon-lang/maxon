    arm64.cbnz x0, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_1  ; "panic at get-out-of-bounds.test:7: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
