// Test: set-all-elements
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

function main() returns ExitCode
	var v = Vec3.create()
	try v.set(0, value: 10) otherwise panic("test invariant: set OOB")
	try v.set(1, value: 20) otherwise panic("test invariant: set OOB")
	try v.set(2, value: 30) otherwise panic("test invariant: set OOB")
	let a = try v.get(0) otherwise 0
	let b = try v.get(1) otherwise 0
	let c = try v.get(2) otherwise 0
	return a + b + c
end 'main'
---
ExitCode: 60
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __layout_Vector_N3_Int
    arm64.movImm x1, 3
    arm64.bl Vector.create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 0
    arm64.movImm x2, 10
    arm64.leaRdata x3, __layout_Vector_N3_Int
    arm64.movImm x4, 3
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.eq tryok#1
  tryerr#2:
    arm64.leaRdata x0, __str_blob_0  ; "panic at set-all-elements.test:7: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#1:
    arm64.movImm x1, 1
    arm64.movImm x2, 20
    arm64.leaRdata x3, __layout_Vector_N3_Int
    arm64.movImm x4, 3
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.eq tryok#3
  tryerr#4:
    arm64.leaRdata x0, __str_blob_1  ; "panic at set-all-elements.test:8: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#3:
    arm64.movImm x1, 2
    arm64.movImm x2, 30
    arm64.leaRdata x3, __layout_Vector_N3_Int
    arm64.movImm x4, 3
    arm64.movRegReg x0, x19
    arm64.bl Vector.set
    arm64.cmp x9, 0
    arm64.b.eq tryok#5
  tryerr#6:
    arm64.leaRdata x0, __str_blob_2  ; "panic at set-all-elements.test:9: test invariant: set OOB\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#5:
    arm64.movImm x1, 0
    arm64.leaRdata x2, __layout_Vector_N3_Int
    arm64.movRegReg x0, x19
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq tryok#7
  tryerr#8:
    arm64.movImm x20, 0
    arm64.b trycont#9
  tryok#7:
    arm64.movRegReg x20, x0
  trycont#9:
    arm64.movImm x1, 1
    arm64.leaRdata x2, __layout_Vector_N3_Int
    arm64.movRegReg x0, x19
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq tryok#10
  tryerr#11:
    arm64.movImm x21, 0
    arm64.b trycont#12
  tryok#10:
    arm64.movRegReg x21, x0
  trycont#12:
    arm64.movImm x1, 2
    arm64.leaRdata x2, __layout_Vector_N3_Int
    arm64.movRegReg x0, x19
    arm64.bl Vector.get
    arm64.cmp x9, 0
    arm64.b.eq trycont#15
  tryerr#14:
    arm64.movImm x0, 0
  trycont#15:
    arm64.add x1, x20, x21
    arm64.add x20, x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at set-all-elements.test:13: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
