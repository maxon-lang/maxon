// Test: error.resize-is-refused-off-the-declaration
typealias Int = int(i64.min to i64.max)
typealias Vec3 = Vector with 3 Int

function main() returns ExitCode
	var v = Vec3.create()
	v.resize(9)
	return v.count()
end 'main'
