// Test: multiple-variables
function main() returns ExitCode
	let a = 10
	let b = 20
	return a + b
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 30
    arm64.b __rc_chk
  __rc_chk:
    arm64.b __rc_ok
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
