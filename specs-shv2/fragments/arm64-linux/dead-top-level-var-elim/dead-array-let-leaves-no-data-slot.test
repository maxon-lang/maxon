// Test: dead-array-let-leaves-no-data-slot
let deadArr = [1, 2, 3, 4, 5]
var live = 7

function main() returns ExitCode
	return live
end 'main'
---
ExitCode: 7
---
data {
  __data_live@0 = i64 7
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_live
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
