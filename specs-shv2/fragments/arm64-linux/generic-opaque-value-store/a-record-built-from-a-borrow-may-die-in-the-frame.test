  __im_cont:
    arm64.cmp x3, 0
    arm64.b.eq tryok
  tryerr:
    arm64.leaRdata x0, __str_blob_1  ; "panic at a-record-built-from-a-borrow-may-die-in-the-frame.test:28: oob\x0a"
