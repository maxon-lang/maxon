    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 0
    arm64.b forhdr
  forhdr:
    arm64.cmp x0, 0
    arm64.cset x0, eq
    arm64.cbnz x0, loop
    arm64.b forexit
  loop:
    arm64.movRegReg x0, x19
    arm64.bl IntList.current
    arm64.cmp x0, x20
    arm64.cset x0, eq
    arm64.cbnz x0, found
    arm64.b ifcont
  found:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.b forstep
  forstep:
    arm64.movRegReg x0, x19
    arm64.bl IntList.advance
    arm64.movRegReg x0, x9
    arm64.b forhdr
  forexit:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

