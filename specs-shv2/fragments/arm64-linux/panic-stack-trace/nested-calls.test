// Test: nested-calls
typealias Integer = int(i64.min to i64.max)
typealias SmallInt = int(0 to 100)

function validate(n Integer) returns SmallInt
	return n as SmallInt
end

function process(n Integer) returns SmallInt
	return validate(n)
end

function caller(n Integer) returns SmallInt
	return process(n)
end

function main() returns ExitCode
	return caller(999)
end
---
ExitCode: 1
---
func @validate {
  entry:
    arm64.prologue 16
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at nested-calls.test:6: Range check failed: value outside typealias 'SmallInt'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}

func @process {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.cmp x0, 0
    arm64.b.lt __il_slow
  __rc_chk:
    arm64.cmp x0, 100
    arm64.b.le __il_cont
  __il_slow:
    arm64.bl validate
  __il_cont:
    arm64.epilogue 16
    arm64.ret
}

func @caller {
  entry:
    arm64.prologue 16
    arm64.bl process
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 999
    arm64.bl caller
    arm64.epilogue 16
    arm64.ret
}
