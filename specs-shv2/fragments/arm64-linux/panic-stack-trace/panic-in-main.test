// Test: panic-in-main
typealias Integer = int(i64.min to i64.max)
typealias Bounded = int(10 to 20)

function getVal() returns Integer
	return 5
end

function main() returns ExitCode
	let b = getVal() as Bounded
	return b
end
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.movImm x0, 5
    arm64.b __il_cont
  __il_cont:
    arm64.cmp x0, 10
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 20
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at panic-in-main.test:10: Range check failed: value outside typealias 'Bounded'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
