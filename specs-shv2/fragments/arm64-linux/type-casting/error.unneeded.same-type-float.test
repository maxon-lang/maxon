// Test: error.unneeded.same-type-float

typealias Float = float(f64.min to f64.max)

function identity(x Float) returns Float
	return x
end 'identity'

function main() returns ExitCode
	let f = identity(42.0)
	let g = f as Float
	return trunc(g)
end 'main'
---
CompilerError:
error E3010: <fragment>:11:12: unneeded cast: 'Float' already fits in 'Float'
