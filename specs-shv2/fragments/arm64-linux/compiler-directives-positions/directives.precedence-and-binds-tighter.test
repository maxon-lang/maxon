// Test: directives.precedence-and-binds-tighter
function main() returns ExitCode
	#if testing(false) or testing(true) and testing(true)
		return 27
	#else
		return 95
	#endif
end 'main'
---
ExitCode: 27
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 27
    arm64.epilogue 16
    arm64.ret
}
