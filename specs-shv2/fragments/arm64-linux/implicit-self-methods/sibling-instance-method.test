// Test: sibling-instance-method

typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create() returns Self
		return Self{n: 0}
	end 'create'

	function bump() returns Integer
		return n + 1
	end 'bump'

	function twice() returns Integer
		return bump() + bump()
	end 'twice'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	return c.twice()
end 'main'
---
ExitCode: 2
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Counter.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Counter.bump {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.epilogue 16
    arm64.ret
}

func @Counter.twice {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Counter.bump
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl Counter.bump
    arm64.add x0, x20, x0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.bl Counter.create
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl Counter.twice
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __mm_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
