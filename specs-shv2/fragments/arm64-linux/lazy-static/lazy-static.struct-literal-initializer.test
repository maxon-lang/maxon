// Test: lazy-static.struct-literal-initializer
typealias Count = int(0 to u64.max)

type Pair
	export var a as Count
	export var b as Count

	static var origin = Pair{a: 1, b: 2}

	export static function get() returns Pair
		return Pair.origin
	end 'get'
end 'Pair'

function main() returns ExitCode
	let p = Pair.get()
	print("{p.a} {p.b}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Pair.origin@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @Pair.get {
  entry:
    arm64.prologue 16
    arm64.bl __lazy_init#__data_Pair.origin
    arm64.leaGlobal x0, __data_Pair.origin
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.bl __mm_retain
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 96
    arm64.storeSlotReg slot9, x28
