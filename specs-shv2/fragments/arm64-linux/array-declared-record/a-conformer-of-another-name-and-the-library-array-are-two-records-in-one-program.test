// Test: a-conformer-of-another-name-and-the-library-array-are-two-records-in-one-program
type Bag uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Bag'

typealias StringBag = Bag with String

function main() returns ExitCode
	var mine = StringBag.create()
	mine.push("xy")

	var total = mine.count()
	for part in "a,bb,ccc".split(",") 'librarysLoop'
		total = total + part.byteLength()
	end 'librarysLoop'

	return total as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.leaFuncAddr x1, __str_decref
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_3  ; "xy"
    arm64.bl __str_retain
    arm64.movRegReg x1, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.loadRegBaseDisp.word64 x20, [x19 + 8]
    arm64.leaRdata x0, __str_rec_4  ; "a,bb,ccc"
    arm64.leaRdata x1, __str_rec_5  ; ","
    arm64.bl String.split
    arm64.movRegReg x21, x0
    arm64.movImm x22, 0
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 8]
    arm64.cmp x22, x0
    arm64.b.ge forexit
  librarysLoop:
    arm64.loadRegBaseDisp.word64 x0, [x21 + 0]
    arm64.loadRegBaseIndexScale.word64 x0, [x0 + x22*8 + 0]
  __il_body:
    arm64.loadRegBaseDisp.word64 x1, [x0 + 8]
    arm64.cmp x1, 0
    arm64.b.ge __rc_ok#11
  __il_slow:
    arm64.bl String.byteLength
    arm64.b __il_cont
  __rc_ok#11:
    arm64.movRegReg x0, x1
  __il_cont:
    arm64.add x20, x20, x0
  forstep:
    arm64.add x22, x22, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x21
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x20, 255
    arm64.b.le __rc_ok#5
  __rc_panic:
    arm64.leaRdata x0, __str_blob_11  ; "panic at a-conformer-of-another-name-and-the-library-array-are-two-records-in-one-program.test:27: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
  __rc_ok#5:
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}
