    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x20, 0
  whilehdr:
    arm64.cmp x20, 40
    arm64.b.ge whileexit
  fill:
    arm64.asr x0, x20, 63
    arm64.lsr x0, x0, 62
    arm64.add x0, x20, x0
    arm64.asr x0, x0, 2
    arm64.movImm x16, 4
    arm64.mul x0, x0, x16
    arm64.sub x1, x20, x0
    arm64.cmp x1, 0
    arm64.b.lt __rc_panic#13
  __rc_chk#14:
    arm64.cmp x1, 3
    arm64.b.le __rc_ok#12
  __rc_panic#13:
    arm64.leaRdata x0, __str_blob_0  ; "panic at grow-stays-packed.test:9: Range check failed: value outside typealias 'Q'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok#12:
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.add x20, x20, 1
    arm64.b whilehdr
  whileexit:
    arm64.movRegReg x0, x19
    arm64.bl __managed_element_size
    arm64.cmp x0, -2
    arm64.b.eq ifcont
  notPacked:
    arm64.movImm x20, 99
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x1, 39
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq tryok
  tryerr#7:
    arm64.movImm x20, 0
    arm64.b trycont#8
  tryok:
    arm64.movRegReg x20, x0
  trycont#8:
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_get
    arm64.cmp x9, 0
    arm64.b.eq trycont#11
  tryerr#10:
    arm64.movImm x0, 0
  trycont#11:
    arm64.add x20, x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
