// Test: grow-stays-packed
typealias Q = int(0 to 3)
typealias QArray = Array with Q

function main() returns ExitCode
	var a = QArray.create()
	var i = 0
	while i < 40 'fill'
		a.push((i mod 4) as Q)
		i = i + 1
	end 'fill'
	if a.managed.elementSize() != -2 'notPacked'
		return 99
	end 'notPacked'
	return (try a.get(39) otherwise 0) + (try a.get(2) otherwise 0)
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

