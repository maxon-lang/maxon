// Test: arm-panic.expression-hit
function main() returns ExitCode
	let x = 1
	let result = match x 'eval'
		1 panic("got the bad one")
		2 gives 20
		3 gives 30
		default gives 0
	end 'eval'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
  matcharm:
    arm64.leaRdata x0, __str_blob_0  ; "panic at arm-panic.expression-hit.test:5: got the bad one\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
