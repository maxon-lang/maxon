// Test: pre-loop-borrow-then-loop-consume
typealias Integer = int(i64.min to i64.max)
typealias ItemArray = Array with Integer

interface Payload
	function tag() returns Integer
end 'Payload'

type Desc implements Payload
	export var v as Integer

	export static function create(x Integer) returns Desc
		return Self{v: x}
	end 'create'

	export function tag() returns Integer
		return self.v
	end 'tag'
end 'Desc'

// Consumes `p` by storing it; destroyed at scope end.
type Holder
	export var p as Payload

	export static function create(p Payload) returns Holder
		return Holder{p: p}
	end 'create'

	export function run() returns Integer
		return self.p.tag()
	end 'run'
end 'Holder'

// Non-inlined BORROW of `p` (mirrors collectFuncsNeedingRegalloc(regTarget)).
function borrowCount(p Payload, base Integer) returns Integer
	var acc = base
	for _ in 0 upto 2 'r'
		acc = acc + p.tag()
	end 'r'
	return acc
end 'borrowCount'

// Consumes `p` (mirrors allocateRegistersForFunc storing into FunctionRegAllocator).
function forFunc(item Integer, p Payload) returns Integer
	var h = Holder.create(p)
	return h.run() + item
end 'forFunc'

// Pre-loop borrow + early-return guard + per-item loop consume
// (mirrors allocateRegistersWithTarget).
function withTarget(items ItemArray, p Payload) returns Integer
	let n = borrowCount(p, base: items.count())
	if n == 0 'empty'
		return 0
	end 'empty'

	var total = 0
	for item in items 'each'
		total = total + forFunc(item, p: p)
	end 'each'
	return total + n
end 'withTarget'

function withX64(items ItemArray) returns Integer
	let p = Desc.create(5)
	return withTarget(items, p: p)
end 'withX64'

function main() returns ExitCode
	var items = ItemArray.create()
	items.push(1)
	items.push(2)
	items.push(3)
	return withX64(items)
end 'main'
---
ExitCode: 34
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Desc.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @Desc.tag {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}

func @Holder.create {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movImm x0, 16
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __retain_existential
    arm64.storeBaseDispReg.word64 [x21 + 0], x0
    arm64.storeBaseDispReg.word64 [x21 + 8], x20
    arm64.movRegReg x0, x20
    arm64.movRegReg x1, x19
    arm64.bl __drop_existential
    arm64.movRegReg x0, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}

func @Holder.run {
  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x2, [x0 + 8]
    arm64.movRegReg x0, x1
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.epilogue 16
    arm64.ret
}

func @borrowCount {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x2
    arm64.movImm x21, 0
    arm64.movRegReg x22, x1
    arm64.b forhdr
  forhdr:
    arm64.cmp x21, 2
    arm64.cset x0, lt
    arm64.cbnz x0, r
    arm64.b forexit
  r:
    arm64.movRegReg x0, x19
    arm64.loadRegBaseDisp.word64 x16, [x20 + 24]
    arm64.blr x16
    arm64.add x22, x22, x0
    arm64.b forstep
  forstep:
    arm64.add x21, x21, 1
    arm64.b forhdr
  forexit:
    arm64.movRegReg x0, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.epilogue 48
    arm64.ret
}

func @forFunc {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x2
    arm64.movRegReg x0, x20
    arm64.bl __retain_existential
    arm64.movRegReg x1, x20
    arm64.bl Holder.create
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl Holder.run
    arm64.add x19, x0, x19
    arm64.movRegReg x0, x20
    arm64.bl __destruct_Holder
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @withTarget {
  entry:
    arm64.prologue 64
    arm64.storeSlotReg slot5, x24
    arm64.storeSlotReg slot4, x23
    arm64.storeSlotReg slot3, x22
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movRegReg x20, x1
    arm64.movRegReg x21, x2
    arm64.loadRegBaseDisp.word64 x1, [x19 + 8]
    arm64.movRegReg x0, x20
    arm64.movRegReg x2, x21
    arm64.bl borrowCount
    arm64.movRegReg x22, x0
    arm64.cmp x22, 0
    arm64.cset x0, eq
    arm64.cbnz x0, empty
    arm64.b ifcont
  empty:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
  ifcont:
    arm64.movImm x23, 0
    arm64.movImm x24, 0
    arm64.b forhdr
  forhdr:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 8]
    arm64.cmp x24, x0
    arm64.cset x0, lt
    arm64.cbnz x0, each
    arm64.b forexit
  each:
    arm64.loadRegBaseDisp.word64 x0, [x19 + 0]
    arm64.arm64AddLsl x0, x0, x24, lsl #3
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b __im_cont
  __im_cont:
    arm64.movRegReg x1, x20
    arm64.movRegReg x2, x21
    arm64.bl forFunc
    arm64.add x23, x23, x0
    arm64.b forstep
  forstep:
    arm64.add x24, x24, 1
    arm64.b forhdr
  forexit:
    arm64.add x0, x23, x22
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.loadRegSlot x22, slot3
    arm64.loadRegSlot x23, slot4
    arm64.loadRegSlot x24, slot5
    arm64.epilogue 64
    arm64.ret
}

func @withX64 {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 5
    arm64.bl Desc.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __witness_Desc.Payload
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl withTarget
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __managed_create
    arm64.movRegReg x19, x0
    arm64.movImm x1, 1
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 2
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movImm x1, 3
    arm64.movRegReg x0, x19
    arm64.bl __managed_push
    arm64.movRegReg x0, x19
    arm64.bl withX64
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __managed_decref
    arm64.cmp x20, 0
    arm64.cset x0, lt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x20, 255
    arm64.cset x0, gt
    arm64.cbnz x0, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at pre-loop-borrow-then-loop-consume.test:74: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}
