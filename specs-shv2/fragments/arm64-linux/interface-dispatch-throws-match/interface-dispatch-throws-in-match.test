// Test: interface-dispatch-throws-in-match

typealias Integer = int(i64.min to i64.max)

enum MyError implements Error
	failed
end 'MyError'

interface Backend
	function compute(x Integer) returns Integer
end 'Backend'

enum Kind
	alpha
	beta
end 'Kind'

type AlphaBackend implements Backend
	export let tag as Integer

	function compute(x Integer) returns Integer
		return x + 1
	end 'compute'

	export static function create() returns Self
		return Self{tag: 0}
	end 'create'
end 'AlphaBackend'

type BetaBackend implements Backend
	export let tag as Integer

	function compute(x Integer) returns Integer
		return x + 2
	end 'compute'

	export static function create() returns Self
		return Self{tag: 0}
	end 'create'
end 'BetaBackend'

function helperThatThrows(value Integer, backend Backend) returns Integer throws MyError
	let result = backend.compute(value)
	if result < 0 'bad'
		throw MyError.failed
	end 'bad'
	return result
end 'helperThatThrows'

function dispatchWithReturnTry(kind Kind, value Integer) returns Integer throws MyError
	match kind 'dispatch'
		alpha then return try helperThatThrows(value, backend: AlphaBackend.create())
		beta then return try helperThatThrows(value, backend: BetaBackend.create())
	end 'dispatch'
end 'dispatchWithReturnTry'

function main() returns ExitCode
	let a = try dispatchWithReturnTry(Kind.alpha, value: 40) otherwise 0
	let b = try dispatchWithReturnTry(Kind.beta, value: 40) otherwise 0
	return a + b
end 'main'
---
ExitCode: 83
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @AlphaBackend.compute {
  entry:
    arm64.prologue 16
    arm64.add x0, x1, 1
    arm64.epilogue 16
    arm64.ret
}

func @AlphaBackend.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @BetaBackend.compute {
  entry:
    arm64.prologue 16
    arm64.add x0, x1, 2
    arm64.epilogue 16
    arm64.ret
}

func @BetaBackend.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @helperThatThrows {
  entry:
    arm64.prologue 16
    arm64.movRegReg x3, x0
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x3
    arm64.loadRegBaseDisp.word64 x16, [x2 + 24]
    arm64.blr x16
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, bad
    arm64.b ifcont
  bad:
    arm64.movImm x9, 1
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.movImm x9, 0
    arm64.epilogue 16
    arm64.ret
}

func @dispatchWithReturnTry {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x1
    arm64.cmp x0, 0
    arm64.cset x1, eq
    arm64.cbnz x1, matcharm#1
    arm64.b matchnext
  matcharm#1:
    arm64.bl AlphaBackend.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __witness_AlphaBackend.Backend
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl helperThatThrows
    arm64.movRegReg x19, x0
    arm64.movRegReg x21, x9
    arm64.cmp x21, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#3
    arm64.b tryok#2
  tryerr#3:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#2:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchnext:
    arm64.cmp x0, 1
    arm64.cset x0, eq
    arm64.cbnz x0, matcharm#4
    arm64.b matchdead
  matcharm#4:
    arm64.bl BetaBackend.create
    arm64.movRegReg x20, x0
    arm64.leaRdata x2, __witness_BetaBackend.Backend
    arm64.movRegReg x0, x19
    arm64.movRegReg x1, x20
    arm64.bl helperThatThrows
    arm64.movRegReg x19, x0
    arm64.movRegReg x21, x9
    arm64.cmp x21, 0
    arm64.cset x0, ne
    arm64.cbnz x0, tryerr#6
    arm64.b tryok#5
  tryerr#6:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movImm x0, 0
    arm64.movRegReg x9, x21
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  tryok#5:
    arm64.movRegReg x0, x20
    arm64.bl __mm_decref
    arm64.movImm x9, 0
    arm64.movRegReg x0, x19
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
  matchdead:
  matchcont:
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x0, 0
    arm64.movImm x1, 40
    arm64.bl dispatchWithReturnTry
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#2
    arm64.b tryok#1
  tryerr#2:
    arm64.movImm x19, 0
    arm64.b trycont#3
  tryok#1:
    arm64.movRegReg x19, x0
    arm64.b trycont#3
  trycont#3:
    arm64.movImm x0, 1
    arm64.movImm x1, 40
    arm64.bl dispatchWithReturnTry
    arm64.cmp x9, 0
    arm64.cset x1, ne
    arm64.cbnz x1, tryerr#5
    arm64.b tryok#4
  tryerr#5:
    arm64.movImm x0, 0
    arm64.b trycont#6
  tryok#4:
    arm64.b trycont#6
  trycont#6:
    arm64.add x0, x19, x0
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at interface-dispatch-throws-in-match.test:60: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
