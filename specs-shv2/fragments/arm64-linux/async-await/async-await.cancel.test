// Test: async-await.cancel
typealias Integer = int(i64.min to i64.max)

function yieldingTask() returns Integer
		if File.exists(FilePath from "nonexistent.txt") 'check'
				return 1
		end 'check'
		return 0
end 'yieldingTask'

function main() returns ExitCode
		let p = async yieldingTask()
		p.cancel()
		return 42
end 'main'
---
ExitCode: 42
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_timer_count@40 = i64 0
  __gt_timer_heap_base@48 = i64 0
  __gt_timer_capacity@56 = i64 0
  __gt_timer_seq@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_proc_count@80 = i64 0
  __gt_proc_handles_base@88 = i64 0
  __gt_proc_gts_base@96 = i64 0
  __gt_proc_wait_snapshot@104 = i64 0
  __gt_proc_poller@112 = i64 0
  __gt_live_count@120 = i64 0
  __sched_progress@128 = i64 0
  __sched_active_workers@136 = i64 1
  __sched_max_active_workers@144 = i64 1
  __sched_tls_index@152 = i64 0
  __sched_tls_teb_offset@160 = i64 0
  __sched_procs@168 = i64 0
  __sched_allm@176 = i64 0
  __sched_midle@184 = i64 0
  __sched_pidle@192 = i64 0
  __sched_num_procs@200 = i64 0
  __sched_shutdown_flag@208 = i64 0
  __sched_lock@216 = i64 0
  __sched_nmspinning@224 = i64 0
  __sched_parked_drivers@232 = i64 0
  __mrt_errno@240 = i64 0
  __mrt_envp@248 = i64 0
  __mrt_tls_next_key@256 = i64 0
  __slab_arena_list@264 = i64 0
  __slab_arena_map_l1@272 = i64 0
  __slab_state@280 = i64 0
}

func @yieldingTask {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaRdata x0, __str_rec_17  ; "nonexistent.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl File.exists
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x19
    arm64.bl __destruct_FilePath
    arm64.cbnz x20, check
    arm64.b ifcont
  check:
    arm64.movImm x0, 1
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
  ifcont:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, yieldingTask
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl __gt_promise_drop
    arm64.movImm x0, 42
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
