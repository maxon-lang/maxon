    arm64.movRegReg x19, x0
    arm64.leaRdata x0, __str_rec_17  ; "noyield.txt"
    arm64.bl FilePath.init
    arm64.movRegReg x20, x0
    arm64.movRegReg x0, x20
    arm64.bl File.exists
    arm64.movRegReg x0, x20
    arm64.bl __destruct_FilePath
    arm64.cmp x19, 0
    arm64.cset x0, eq
    arm64.cbnz x0, ok
    arm64.b ifcont#2
  ok:
    arm64.movImm x0, 1
    arm64.movImm x9, 0
    arm64.loadRegSlot x19, slot0
