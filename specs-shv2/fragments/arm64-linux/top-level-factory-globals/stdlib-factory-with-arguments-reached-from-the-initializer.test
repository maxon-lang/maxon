// Test: stdlib-factory-with-arguments-reached-from-the-initializer
typealias Sources = Array with String

var cfg = BuildConfig.create(name: "app", output: "app.exe", sources: Sources.create(), optimize: false, debug_info: false)

function main() returns ExitCode
	return cfg.sources.count() as ExitCode
end 'main'
---
ExitCode: 0
---
data {
  __data_cfg@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __slab_arena_list@16 = i64 0
  __slab_arena_map_l1@24 = i64 0
  __slab_state@32 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x0, __data_cfg
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 16]
    arm64.loadRegBaseDisp.word64 x0, [x0 + 8]
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_4  ; "panic at stdlib-factory-with-arguments-reached-from-the-initializer.test:7: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
