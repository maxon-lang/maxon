// Test: ternary-expression.false-path-strings
function main() returns ExitCode
	let flag = false
	let s = "yes" if flag else "no"
	print(s)
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.leaRdata x0, __str_rec_1
    arm64.b matchcont
  ternaryfalse:
    arm64.leaRdata x0, __str_rec_3
    arm64.b matchcont
  matchcont:
    arm64.bl __print_string
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
