// Test: ternary-expression.self-field-in-condition-and-arm-false-path
typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create(n Integer) returns Self
		return Self{n: n}
	end 'create'

	export function bump() returns Integer
		return self.n + 1
	end 'bump'

	export function pick(threshold Integer) returns Integer
		let base = self.bump()
		return n if n > threshold else base
	end 'pick'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create(5)
	return c.pick(99)
end 'main'
---
ExitCode: 6
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.pick {
  entry:
    arm64.prologue 16
  __il_body:
    arm64.loadRegBaseDisp.word64 x2, [x0 + 0]
    arm64.add x2, x2, 1
  __il_cont:
    arm64.loadRegBaseDisp.word64 x3, [x0 + 0]
    arm64.cmp x3, x1
    arm64.b.le ternaryfalse
  ternarytrue:
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.b matchcont
  ternaryfalse:
    arm64.movRegReg x0, x2
  matchcont:
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 5
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.movImm x2, 99
    arm64.movRegReg x0, x1
    arm64.movRegReg x1, x2
    arm64.bl Counter.pick
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ternary-expression.self-field-in-condition-and-arm-false-path.test:23: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
  __rc_ok:
    arm64.epilogue 32
    arm64.ret
}
