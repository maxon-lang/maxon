// Test: ternary-expression.elision.chained-evaluates-only-the-winner
var sideEffectCount = 0

function track(result Integer) returns Integer
	sideEffectCount = sideEffectCount + 1
	return result
end 'track'

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	// Right-associates: track(1) if false else (track(2) if true else track(3))
	let x = track(1) if false else track(2) if true else track(3)
	if x != 2 'v'
		return 99
	end 'v'
	return sideEffectCount
end 'main'
---
ExitCode: 1
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @track {
  entry:
    arm64.prologue 16
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x1, [x1 + 0]
    arm64.add x1, x1, 1
    arm64.leaGlobal x2, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x2 + 0], x1
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 0
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 1
    arm64.bl track
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 1
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.movImm x0, 2
    arm64.bl track
    arm64.b matchcont
  ternaryfalse:
    arm64.movImm x0, 3
    arm64.bl track
    arm64.b matchcont
  matchcont:
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 2
    arm64.cset x0, ne
    arm64.cbnz x0, v
    arm64.b ifcont
  v:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.epilogue 16
    arm64.ret
}
