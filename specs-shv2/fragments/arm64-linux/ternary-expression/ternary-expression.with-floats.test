// Test: ternary-expression.with-floats
function main() returns ExitCode
	let x = 1.5 if true else 2.5
	return trunc(x)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 1
    arm64.cbnz x0, ternarytrue
    arm64.b ternaryfalse
  ternarytrue:
    arm64.fpLoadRdata d0, [rdata + __fconst_0]
    arm64.b matchcont
  ternaryfalse:
    arm64.fpLoadRdata d0, [rdata + __fconst_1]
    arm64.b matchcont
  matchcont:
    arm64.fcvtzs x0, d0
    arm64.epilogue 16
    arm64.ret
}
