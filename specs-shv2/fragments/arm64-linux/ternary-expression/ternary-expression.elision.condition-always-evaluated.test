// Test: ternary-expression.elision.condition-always-evaluated
var sideEffectCount = 0

function pick() returns bool
	sideEffectCount = sideEffectCount + 1
	return false
end 'pick'

function main() returns ExitCode
	let x = 1 if pick() else 2
	if x != 2 'v'
		return 99
	end 'v'
	return sideEffectCount
end 'main'
---
ExitCode: 1
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    arm64.prologue 16
    arm64.b __il_body
  __il_body:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.add x0, x0, 1
    arm64.leaGlobal x1, __data_sideEffectCount
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b __il_cont
  __il_cont:
    arm64.b ternaryfalse
  ternaryfalse:
    arm64.movImm x0, 2
    arm64.b matchcont
  matchcont:
    arm64.cmp x0, 2
    arm64.cset x0, ne
    arm64.cbnz x0, v
    arm64.b ifcont
  v:
    arm64.movImm x0, 99
    arm64.epilogue 16
    arm64.ret
  ifcont:
    arm64.leaGlobal x0, __data_sideEffectCount
    arm64.loadRegBaseDisp.word64 x0, [x0 + 0]
    arm64.cmp x0, 0
    arm64.cset x1, lt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_chk
  __rc_chk:
    arm64.cmp x0, 255
    arm64.cset x1, gt
    arm64.cbnz x1, __rc_panic
    arm64.b __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ternary-expression.elision.condition-always-evaluated.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
