  entry:
    arm64.prologue 16
    arm64.loadRegBaseDisp.word64 x1, [x0 + 0]
    arm64.cmp x1, 0
    arm64.b.ne matchnext
  matcharm#1:
    arm64.movImm x0, 0
    arm64.b matchcont
  matchnext:
    arm64.cmp x1, 1
    arm64.b.ne matchdead
