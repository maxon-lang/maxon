// Test: ternary-expression.basic-false
function main() returns ExitCode
	let x = 10 if false else 20
	return x
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    arm64.prologue 16
  ternaryfalse:
    arm64.movImm x0, 20
  matchcont:
    arm64.cmp x0, 0
    arm64.b.lt __rc_panic
  __rc_chk:
    arm64.cmp x0, 255
    arm64.b.le __rc_ok
  __rc_panic:
    arm64.leaRdata x0, __str_blob_0  ; "panic at ternary-expression.basic-false.test:4: Range check failed: value outside typealias 'ExitCode'\x0a"
    arm64.bl mrt_panic
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
  __rc_ok:
    arm64.epilogue 16
    arm64.ret
}
