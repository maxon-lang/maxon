// Test: jump-table.four-cases-statement
enum Direction
		north
		south
		east
		west
end 'Direction'

function main() returns ExitCode
		let d = Direction.west
		match d 'dir'
				north then print("N")
				south then print("S")
				east then print("E")
				west then print("W")
		end 'dir'
		return 0
end 'main'
---
ExitCode: unpinned
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 3
    arm64.jumpTable x0, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4] @__jumptable_8
  matchdead:
  matcharm#1:
    arm64.leaRdata x0, __str_rec_4  ; "N"
    arm64.bl print
    arm64.b matchcont
  matcharm#2:
    arm64.leaRdata x0, __str_rec_5  ; "S"
    arm64.bl print
    arm64.b matchcont
  matcharm#3:
    arm64.leaRdata x0, __str_rec_6  ; "E"
    arm64.bl print
    arm64.b matchcont
  matcharm#4:
    arm64.leaRdata x0, __str_rec_7  ; "W"
    arm64.bl print
  matchcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
