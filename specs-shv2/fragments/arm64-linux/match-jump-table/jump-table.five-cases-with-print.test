// Test: jump-table.five-cases-with-print
enum Suit
		hearts
		diamonds
		clubs
		spades
		joker
end 'Suit'

function main() returns ExitCode
		let s = Suit.clubs
		match s 'check'
				hearts then print("hearts")
				diamonds then print("diamonds")
				clubs then print("clubs")
				spades then print("spades")
				joker then print("joker")
		end 'check'
		return 0
end 'main'
---
ExitCode: unpinned
---
func @main {
  entry:
    arm64.prologue 16
    arm64.movImm x0, 2
    arm64.jumpTable x0, default=matchdead [[0]=matcharm#1, [1]=matcharm#2, [2]=matcharm#3, [3]=matcharm#4, [4]=matcharm#5] @__jumptable_10
  matchdead:
  matcharm#1:
    arm64.leaRdata x0, __str_rec_5  ; "hearts"
    arm64.bl print
    arm64.b matchcont
  matcharm#2:
    arm64.leaRdata x0, __str_rec_6  ; "diamonds"
    arm64.bl print
    arm64.b matchcont
  matcharm#3:
    arm64.leaRdata x0, __str_rec_7  ; "clubs"
    arm64.bl print
    arm64.b matchcont
  matcharm#4:
    arm64.leaRdata x0, __str_rec_8  ; "spades"
    arm64.bl print
    arm64.b matchcont
  matcharm#5:
    arm64.leaRdata x0, __str_rec_9  ; "joker"
    arm64.bl print
  matchcont:
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}
