// Test: owned-struct-in-block
type Box
	var v as int

	static function create(v int) returns Box
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var i = 0
	while i < 3 'loop'
		if i < 2 'b'
			let q = Box.create(i)
		end 'b'
		i = i + 1
	end 'loop'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Box.create {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movRegReg x19, x0
    arm64.movImm x0, 8
    arm64.movImm x1, 0
    arm64.bl __mm_alloc
    arm64.storeBaseDispReg.word64 [x0 + 0], x19
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 32
    arm64.storeSlotReg slot0, x19
    arm64.movImm x19, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x19, 3
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.cmp x19, 2
    arm64.cset x0, lt
    arm64.cbnz x0, b
    arm64.b ifcont
  b:
    arm64.movRegReg x0, x19
    arm64.bl Box.create
    arm64.bl __mm_decref
    arm64.b ifcont
  ifcont:
    arm64.add x19, x19, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x0, 0
    arm64.loadRegSlot x19, slot0
    arm64.epilogue 32
    arm64.ret
}
