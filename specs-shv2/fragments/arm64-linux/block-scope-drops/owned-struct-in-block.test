// Test: owned-struct-in-block
type Box
	var v as Integer

	static function create(v Integer) returns Box
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var i = 0
	while i < 3 'loop'
		if i < 2 'b'
			_ = Box.create(i)
		end 'b'
		i = i + 1
	end 'loop'
	return 0
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    arm64.prologue 32
    arm64.movImm x0, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x0, 3
    arm64.cset x1, lt
    arm64.cbnz x1, loop
    arm64.b whileexit
  loop:
    arm64.cmp x0, 2
    arm64.cset x1, lt
    arm64.cbnz x1, b
    arm64.b ifcont
  b:
    arm64.leaRegSlot x1, slot0
    arm64.storeBaseDispReg.word64 [x1 + 0], x0
    arm64.b ifcont
  ifcont:
    arm64.add x0, x0, 1
    arm64.b whilehdr
  whileexit:
    arm64.movImm x0, 0
    arm64.epilogue 32
    arm64.ret
}
