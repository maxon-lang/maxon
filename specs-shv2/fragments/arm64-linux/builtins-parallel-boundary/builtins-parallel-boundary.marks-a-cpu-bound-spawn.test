// Test: builtins-parallel-boundary.marks-a-cpu-bound-spawn
function work(n ExitCode) returns ExitCode
	__Builtins.parallelBoundary()
	return n + 1
end 'work'

function main() returns ExitCode
	let p = async work(6)
	let got = await p
	print("{got}")
	return got
end 'main'
