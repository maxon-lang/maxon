// Test: async-promise-drop.rearm-var-across-loop
function trivial() returns Integer
	Runtime.yield()
	return 0
end 'trivial'

function main() returns ExitCode
	var p = async trivial()
	var i = 0
	while i < 8 'loop'
		p = async trivial()
		i = i + 1
	end 'loop'
	return 0 as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_timer_seq@56 = i64 0
  __gt_trace_counter@64 = i64 0
  __gt_proc_count@72 = i64 0
  __gt_proc_handles_base@80 = i64 0
  __gt_proc_gts_base@88 = i64 0
  __gt_proc_wait_snapshot@96 = i64 0
  __gt_proc_poller@104 = i64 0
  __gt_live_count@112 = i64 0
  __sched_progress@120 = i64 0
  __sched_active_workers@128 = i64 1
  __sched_max_active_workers@136 = i64 1
  __sched_tls_index@144 = i64 0
  __sched_tls_teb_offset@152 = i64 0
  __sched_procs@160 = i64 0
  __sched_allm@168 = i64 0
  __sched_midle@176 = i64 0
  __sched_pidle@184 = i64 0
  __sched_num_procs@192 = i64 0
  __sched_shutdown_flag@200 = i64 0
  __sched_lock@208 = i64 0
  __sched_nmspinning@216 = i64 0
  __sched_parked_drivers@224 = i64 0
  __mrt_errno@232 = i64 0
  __mrt_envp@240 = i64 0
  __mrt_tls_next_key@248 = i64 0
  __slab_arena_list@256 = i64 0
  __slab_arena_map_l1@264 = i64 0
  __slab_state@272 = i64 0
}

func @trivial {
  entry:
    arm64.prologue 16
    arm64.bl Runtime.yield
    arm64.movImm x0, 0
    arm64.epilogue 16
    arm64.ret
}

func @main {
  entry:
    arm64.prologue 48
    arm64.storeSlotReg slot2, x21
    arm64.storeSlotReg slot1, x20
    arm64.storeSlotReg slot0, x19
    arm64.leaFuncAddr x0, trivial
    arm64.bl __gt_spawn
    arm64.movRegReg x19, x0
    arm64.movRegReg x0, x19
    arm64.bl __gt_ready
    arm64.movImm x20, 0
    arm64.b whilehdr
  whilehdr:
    arm64.cmp x20, 8
    arm64.cset x0, lt
    arm64.cbnz x0, loop
    arm64.b whileexit
  loop:
    arm64.leaFuncAddr x0, trivial
    arm64.bl __gt_spawn
    arm64.movRegReg x21, x0
    arm64.movRegReg x0, x21
    arm64.bl __gt_ready
    arm64.movRegReg x0, x19
    arm64.bl __gt_promise_drop
    arm64.add x20, x20, 1
    arm64.movRegReg x19, x21
    arm64.b whilehdr
  whileexit:
    arm64.movImm x20, 0
    arm64.movRegReg x0, x19
    arm64.bl __gt_promise_drop
    arm64.movRegReg x0, x20
    arm64.loadRegSlot x19, slot0
    arm64.loadRegSlot x20, slot1
    arm64.loadRegSlot x21, slot2
    arm64.epilogue 48
    arm64.ret
}
