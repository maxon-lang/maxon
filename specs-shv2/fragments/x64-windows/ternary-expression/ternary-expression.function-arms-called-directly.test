// Test: ternary-expression.function-arms-called-directly
typealias Integer = int(i64.min to i64.max)

function dbl(n Integer) returns Integer
	return n * 2
end 'dbl'

function trp(n Integer) returns Integer
	return n * 3
end 'trp'

function main() returns ExitCode
	let c = 0
	return (dbl if c > 0 else trp)(14)
end 'main'
---
ExitCode: 42
---
func @trp {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 3
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
  ternaryfalse:
    x64.leaRegFunc rbx, [rip + __fnref_trp]
  matchcont:
    x64.movRegImm32 rcx, 14
    x64.movRegImm32 rdx, 0
    x64.callReg rbx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ternary-expression.function-arms-called-directly.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
