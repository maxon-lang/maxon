// Test: ternary-expression.elision.chained-evaluates-only-the-winner
var sideEffectCount = 0

function track(result Integer) returns Integer
	sideEffectCount = sideEffectCount + 1
	return result
end 'track'

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	// Right-associates: track(1) if false else (track(2) if true else track(3))
	let x = track(1) if false else track(2) if true else track(3)
	if x != 2 'v'
		return 99
	end 'v'
	return sideEffectCount
end 'main'
---
ExitCode: 1
---
data {
  __data_sideEffectCount@0 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse#2
  ternarytrue#1:
    x64.movRegImm32 rax, 1
  __il_body#13:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.jmp matchcont
  ternaryfalse#2:
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse#4
  ternarytrue#3:
    x64.movRegImm32 rax, 2
  __il_body#15:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
    x64.jmp matchcont
  ternaryfalse#4:
    x64.movRegImm32 rax, 3
  __il_body#17:
    x64.leaRegGlobal rcx, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.leaRegGlobal rdx, __data_sideEffectCount
    x64.storeBaseDispReg.word64 [rdx + 0], rcx
  matchcont:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, ifcont
  v:
    x64.movRegImm32 r8, 99
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegGlobal rax, __data_sideEffectCount
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
