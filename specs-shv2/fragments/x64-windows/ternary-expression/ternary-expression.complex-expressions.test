// Test: ternary-expression.complex-expressions
function main() returns ExitCode
	let a = 3
	let b = 2
	let cond = true
	let x = a + b if cond else a * b
	return x
end 'main'
---
ExitCode: 5
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 1
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.leaRegRegImm32 r8, rax, 2
    x64.jmp matchcont
  ternaryfalse:
    x64.imulRegRegImm32 r8, rax, 2
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
}
