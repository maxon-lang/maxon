// Test: ternary-expression.false-path-strings
function main() returns ExitCode
	let flag = false
	let s = "yes" if flag else "no"
	print(s)
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.jmp matchcont
  ternaryfalse:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
  matchcont:
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
