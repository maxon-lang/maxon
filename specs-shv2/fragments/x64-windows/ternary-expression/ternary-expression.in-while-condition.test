// Test: ternary-expression.in-while-condition
function main() returns ExitCode
	var i = 0
	let lim = true
	while i < (3 if lim else 1) 'l'
		i = i + 1
	end 'l'
	return i
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 3
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rcx, 1
    x64.jmp matchcont
  matchcont:
    x64.cmpRegReg r8, rcx
    x64.jcc less, l
    x64.jmp whileexit
  l:
    x64.leaRegRegImm32 r8, r8, 1
    x64.jmp whilehdr
  whileexit:
    x64.popReg rbp
    x64.ret
}
