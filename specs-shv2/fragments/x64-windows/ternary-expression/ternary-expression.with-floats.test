// Test: ternary-expression.with-floats
function main() returns ExitCode
	let x = 1.5 if true else 2.5
	return trunc(x)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.jmp matchcont
  ternaryfalse:
    x64.movsdRegRip xmm0, [rip + __fconst_1]
    x64.jmp matchcont
  matchcont:
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
