// Test: ternary-expression.elision.guard-actually-guards
typealias Integer = int(i64.min to i64.max)
typealias Small = int(0 to 10)

function clampOrGuard(useDefault bool, big Integer) returns Integer
	// `big as Small` range-check-panics for big > 10; it sits in the arm that
	// `useDefault` does NOT select, so it must never run.
	return 5 if useDefault else (big as Small)
end 'clampOrGuard'

function main() returns ExitCode
	let guarded = clampOrGuard(true, big: 1000) // the cast is in the arm NOT selected
	let direct = clampOrGuard(false, big: 7)
	return (guarded + direct) as ExitCode
end 'main'
---
ExitCode: 12
---
func @clampOrGuard {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 5
    x64.jmp matchcont
  ternaryfalse:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rdx, 10
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rdx
  matchcont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 1000
  __il_body#6:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse#8
  ternarytrue#7:
    x64.movRegImm32 rax, 5
    x64.jmp matchcont#9
  ternaryfalse#8:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow#12
  __rc_chk#11:
    x64.cmpRegImm32 rdx, 10
    x64.jcc lessEqual, __rc_ok#10
  __il_slow#12:
    x64.callDirect clampOrGuard
    x64.movRegReg rbx, r8
    x64.jmp __il_cont#5
  __rc_ok#10:
    x64.movRegReg rax, rdx
  matchcont#9:
    x64.movRegReg rbx, rax
  __il_cont#5:
    x64.movRegImm32 rcx, 0
    x64.movRegImm32 rdx, 7
  __il_body#13:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse#15
  ternarytrue#14:
    x64.movRegImm32 rax, 5
    x64.jmp matchcont#16
  ternaryfalse#15:
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __il_slow#19
  __rc_chk#18:
    x64.cmpRegImm32 rdx, 10
    x64.jcc lessEqual, __rc_ok#17
  __il_slow#19:
    x64.callDirect clampOrGuard
    x64.jmp __il_cont#4
  __rc_ok#17:
    x64.movRegReg rax, rdx
  matchcont#16:
    x64.movRegReg r8, rax
  __il_cont#4:
    x64.leaRegRegReg r8, rbx, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk#3:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok#1
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#1:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
