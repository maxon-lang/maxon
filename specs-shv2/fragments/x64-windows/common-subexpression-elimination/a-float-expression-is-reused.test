// Test: a-float-expression-is-reused
typealias Real = float(f64.min to f64.max)

function energy(m Real, v Real) returns Real
	return (m * v * v) + (m * v * v)
end 'energy'

function main() returns ExitCode
	print("{energy(2.0, v: 3.0)}\n")
	print("{energy(0.5, v: -4.0)}\n")
	return 0
end 'main'
