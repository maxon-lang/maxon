// Test: bool-parameter

typealias Integer = int(i64.min to i64.max)

function test_bool_param(flag bool) returns Integer
	if flag 'check'
		return 1
	end 'check' else 'else_check'
		return 0
	end 'else_check'
end 'test_bool_param'

function main() returns ExitCode
	return test_bool_param(true)
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, check
    x64.jmp ifelse
  check:
    x64.movRegImm32 r8, 1
    x64.jmp __il_cont
  ifelse:
    x64.movRegImm32 r8, 0
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
}
