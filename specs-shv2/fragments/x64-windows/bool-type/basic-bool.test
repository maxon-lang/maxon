// Test: basic-bool
function main() returns ExitCode
	let x = true

	if x 'check'
		return 1
	end 'check' else 'else_check'
		return 0
	end 'else_check'
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifelse
  check:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  ifelse:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
