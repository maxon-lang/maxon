// Test: bool-from-comparison
function main() returns ExitCode
	let result = 5 > 3
	if result 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 5
    x64.cmpRegImm32 rax, 3
    x64.jcc lessEqual, ifcont
  check:
    x64.movRegImm32 r8, 42
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
}
