// Test: bool-from-comparison
function main() returns ExitCode
	let result = 5 > 3
	if result 'check'
		return 42
	end 'check'
	return 0
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.movRegImm32 rax, 5
    x64.cmpRegImm32 rax, 3
    x64.jcc greater, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 42
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.ret
}
