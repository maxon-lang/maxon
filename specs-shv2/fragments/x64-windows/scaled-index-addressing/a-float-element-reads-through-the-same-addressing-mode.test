// Test: a-float-element-reads-through-the-same-addressing-mode
typealias Real = float(f64.min to f64.max)
typealias RealArray = Array with Real

function total(a RealArray) returns Real
	var t = 0.0
	for v in a 'loop'
		t = t + v
	end 'loop'
	return t
end 'total'

function main() returns ExitCode
	var a = RealArray.create()
	a.push(1.5)
	a.push(2.25)
	a.push(4.0)
	if total(a) != 7.75 'sum'
		return 1
	end 'sum'
	if (try a.get(1) otherwise panic("get: index out of range")) != 2.25 'middle'
		return 2
	end 'middle'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @total {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.movRegReg rbx, rcx
    x64.movsdRegRip xmm6, [rip + __fconst_1]
    x64.movRegImm32 r12, 0
  forhdr:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r12, rax
    x64.jcc greaterEqual, forexit
  loop:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r12*8 + 0]
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r12
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
  __il_cont:
    x64.movqXmmGpr xmm0, rax
    x64.addsdRegReg xmm6, xmm6, xmm0
  forstep:
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg xmm0, xmm6
    x64.loadRegSlot xmm6, slot0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movsdRegRip xmm0, [rip + __fconst_2]
    x64.movqGprXmm rdx, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movsdRegRip xmm0, [rip + __fconst_3]
    x64.movqGprXmm rdx, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movsdRegRip xmm0, [rip + __fconst_4]
    x64.movqGprXmm rdx, xmm0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegReg rcx, rbx
    x64.callDirect total
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, sum
  fordered#16:
    x64.jcc equal, ifcont#2
  sum:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, __il_slow
  __im_load#13:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 8
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, __il_slow
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [rbx + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __il_cont
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_cont
  __il_slow:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
  __il_cont:
    x64.movqXmmGpr xmm0, rax
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movsdRegRip xmm1, [rip + __fconst_3]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, middle
  fordered#17:
    x64.jcc equal, ifcont#6
  middle:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
