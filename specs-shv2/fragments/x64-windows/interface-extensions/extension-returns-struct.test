// Test: extension-returns-struct

typealias Integer = int(i64.min to i64.max)

interface Pointlike
	function getX() returns Integer
	function getY() returns Integer
end 'Pointlike'

type SimplePoint
	export var x as Integer
	export var y as Integer

	static function create(x Integer, y Integer) returns Self
		return Self{x: x, y: y}
	end 'create'
end 'SimplePoint'

extension Pointlike
	function asSimple() returns SimplePoint
		return SimplePoint.create(self.getX(), y: self.getY())
	end 'asSimple'
end 'Pointlike'

type Coord implements Pointlike
	let cx as Integer
	let cy as Integer

	function getX() returns Integer
		return cx
	end 'getX'

	function getY() returns Integer
		return cy
	end 'getY'

	static function create(cx Integer, cy Integer) returns Self
		return Self{cx: cx, cy: cy}
	end 'create'
end 'Coord'

function main() returns ExitCode
	let c = Coord.create(10, cy: 32)
	let p = c.asSimple()
	return p.x + p.y
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @SimplePoint.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Coord.asSimple {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rbx
    x64.callDirect Coord.getX
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Coord.getY
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect SimplePoint.create
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Coord.getX {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @Coord.getY {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 56
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 32
    x64.leaRegSlot rdx, slot0
    x64.storeBaseDispReg.word64 [rdx + 0], rax
    x64.storeBaseDispReg.word64 [rdx + 8], rcx
    x64.movRegReg rcx, rdx
    x64.callDirect Coord.asSimple
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
    x64.leaRegRegReg rbx, rax, rcx
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
