// Test: stdlib-map-on-array
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let nums = [1, 2, 3, 4, 5]
	let doubled = nums.map(function(x Integer) gives x * 2)

	var sum = 0
	for n in doubled 'loop'
		sum = sum + n
	end 'loop'

	// 2 + 4 + 6 + 8 + 10 = 30
	return sum
end 'main'
---
ExitCode: 30
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 48
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __barr_blob_0]
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.movRegImm32 rax, 5
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551614
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 8
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.leaRegFunc rdx, [rip + main$closure_0]
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Array_int]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.map
    x64.movRegImm32 r12, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  loop:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont:
    x64.leaRegRegReg r12, r12, rsi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
