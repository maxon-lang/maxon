// Test: stdlib-map-on-set
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let s = Set from [10, 20, 30]
	let mapped = s.map(function(x Integer) gives x + 1)

	var sum = 0
	for n in mapped 'loop'
		sum = sum + n
	end 'loop'

	// 11 + 21 + 31 = 63 (order may vary but sum is same)
	return sum
end 'main'
---
ExitCode: 63
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rbx, 10
    x64.leaRegRdata rcx, [rip + __layout_Set_int]
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.callDirect Set.create
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, rbx
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.insert
    x64.movRegImm32 rdx, 30
    x64.leaRegRdata rax, [rip + __layout_Set_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.insert
    x64.leaRegFunc rdx, [rip + main$closure_0]
    x64.movRegImm32 rax, 0
    x64.leaRegRdata r9, [rip + __layout_Set_int]
    x64.leaRegRdata rsi, [rip + __witness_int.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r12
    x64.callDirect Set.map
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.loadRegBaseDisp.word64 rcx, [r8 + 8]
    x64.loadRegBaseDisp.word64 rdx, [r8 + 0]
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  loop:
    x64.loadRegBaseIndexScale.word64 rsi, [rdx + rax*8 + 0]
  __im_cont:
    x64.leaRegRegReg rbx, rbx, rsi
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Set_int
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_17]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main$closure_0 {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.leaRegRegImm32 r8, rcx, 1
    x64.popReg rbp
    x64.ret
}
