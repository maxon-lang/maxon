// Test: stdlib-map-on-set
typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	let s = Set from [10, 20, 30]
	let mapped = s.map(function(x Integer) gives x + 1)

	var sum = 0
	for n in mapped 'loop'
		sum = sum + n
	end 'loop'

	// 11 + 21 + 31 = 63 (order may vary but sum is same)
	return sum
end 'main'
---
ExitCode: 63
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
