// Test: extension-multiple-types

typealias Integer = int(i64.min to i64.max)

interface Valued
	function val() returns Integer
end 'Valued'

extension Valued
	function valPlusTen() returns Integer
		return self.val() + 10
	end 'valPlusTen'
end 'Valued'

type TypeA implements Valued
	let a as Integer
	function val() returns Integer
		return a
	end 'val'

	static function create(a Integer) returns Self
		return Self{a: a}
	end 'create'
end 'TypeA'

type TypeB implements Valued
	var b as Integer
	function val() returns Integer
		return b * 2
	end 'val'

	static function create(b Integer) returns Self
		return Self{b: b}
	end 'create'
end 'TypeB'

function main() returns ExitCode
	let ta = TypeA.create(5)
	let tb = TypeB.create(10)
	return ta.valPlusTen() + tb.valPlusTen()
end 'main'
---
ExitCode: 45
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @TypeA.valPlusTen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect TypeA.val
    x64.leaRegRegImm32 r8, r8, 10
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @TypeB.valPlusTen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect TypeB.val
    x64.leaRegRegImm32 r8, r8, 10
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @TypeA.val {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @TypeB.val {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegRegImm32 r8, rax, 2
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.movRegImm32 rax, 5
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.movRegImm32 rax, 10
    x64.leaRegSlot rbx, slot1
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.callDirect TypeA.valPlusTen
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect TypeB.valPlusTen
    x64.leaRegRegReg r8, r12, r8
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
