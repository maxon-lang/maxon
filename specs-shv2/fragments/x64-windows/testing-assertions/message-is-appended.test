    x64.movRegImm32 rdx, 4
    x64.leaRegRdata rax, [rip + __str_rec_20]
    x64.leaRegRdata r9, [rip + __str_rec_21]
    x64.movRegImm32 rsi, 2
    x64.callDirect Expect.equal
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.jmp trycont#3
  tryok#1:
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 r12, 4
    x64.callDirect __paramDefault#Expect.equal#2
    x64.movRegReg r13, r8
    x64.leaRegRdata r9, [rip + __str_rec_21]
    x64.movRegImm32 rsi, 3
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r13
    x64.callDirect Expect.equal
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.jmp trycont#6
  tryok#4:
    x64.jmp trycont#6
  trycont#6:
    x64.movRegReg rcx, r13
    x64.callDirect __str_decref
    x64.movRegImm32 rcx, 0
    x64.leaRegRdata rdx, [rip + __str_rec_22]
    x64.leaRegRdata rax, [rip + __str_rec_21]
    x64.movRegImm32 r9, 4
    x64.callDirect Expect.isTrue
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.jmp trycont#9
  tryok#7:
    x64.jmp trycont#9
  trycont#9:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
