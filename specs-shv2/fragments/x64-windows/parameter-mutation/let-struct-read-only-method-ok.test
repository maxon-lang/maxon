// Test: let-struct-read-only-method-ok
typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create() returns Counter
		return Self{n: 7}
	end 'create'

	export function value() returns Integer
		return n
	end 'value'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	return c.value() as ExitCode
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Counter.value {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 0]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 48
    x64.leaRegSlot rcx, slot0
    x64.movRegImm32 rax, 7
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.callDirect Counter.value
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 48
    x64.popReg rbp
    x64.ret
}
