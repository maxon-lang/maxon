// Test: let-array-to-mutating-param-error
typealias Integer = int(i64.min to i64.max)
typealias IntArray = Array with Integer

function grow(dest IntArray)
	dest.push(9)
end 'grow'

function main() returns ExitCode
	let a = IntArray.create()
	grow(a)
	return try a.get(0) otherwise -1
end 'main'
---
CompilerError:
error E3019: <fragment>:11:2: cannot pass 'a' to function that mutates parameter 'dest' (in main)
