// Test: let-struct-to-transitive-self-mutating-method-error
typealias Integer = int(i64.min to i64.max)

type Counter
	export var n as Integer

	static function create() returns Counter
		return Self{n: 0}
	end 'create'

	export function bump()
		n = n + 1
	end 'bump'

	export function bumpTwice()
		bump()
		bump()
	end 'bumpTwice'
end 'Counter'

function main() returns ExitCode
	let c = Counter.create()
	c.bumpTwice()
	return c.n as ExitCode
end 'main'
---
CompilerError:
error E3019: <fragment>:23:2: cannot pass 'c' to function that mutates parameter 'self' (in main)
