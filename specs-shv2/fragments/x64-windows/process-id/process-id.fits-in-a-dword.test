// Test: process-id.fits-in-a-dword
function main() returns ExitCode
	let pid = __Builtins.currentProcessId()
	let dwordLimit = 4294967296
	var score = 0
	if pid > 0 'aboveZero'
		score = score + 1
	end 'aboveZero'
	if pid < dwordLimit 'belowTheDwordCeiling'
		score = score + 2
	end 'belowTheDwordCeiling'
	return score as ExitCode
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __proc_pid
    x64.movRegImm rax, 4294967296
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc greater, aboveZero
    x64.jmp critsplit#8
  aboveZero:
    x64.leaRegRegImm32 rcx, rcx, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegReg r8, rax
    x64.jcc less, belowTheDwordCeiling
    x64.jmp critsplit#9
  belowTheDwordCeiling:
    x64.leaRegRegImm32 rax, rcx, 2
    x64.jmp ifcont#4
  critsplit#9:
    x64.movRegReg rax, rcx
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rcx, 4294967295
    x64.cmpRegReg rax, rcx
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
