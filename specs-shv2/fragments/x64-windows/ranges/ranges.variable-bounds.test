// Test: ranges.variable-bounds
function main() returns ExitCode
		let start = 2
		let finish = 4
		var sum = 0
		for i in start to finish 'loop'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 9
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rax, 2
    x64.movRegImm32 r8, 0
  forhdr:
    x64.cmpRegImm32 rax, 4
    x64.jcc greater, forexit
  loop:
    x64.leaRegRegReg r8, r8, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ranges.variable-bounds.test:9: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
