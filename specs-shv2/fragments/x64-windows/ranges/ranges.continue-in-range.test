// Test: ranges.continue-in-range
function main() returns ExitCode
		var sum = 0
		for i in 1 to 10 'loop'
				if i mod 2 == 0 'skip'
						continue
				end 'skip'
				sum = sum + i
		end 'loop'
		return sum
end 'main'
---
ExitCode: 25
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 1
  forhdr:
    x64.cmpRegImm32 rax, 10
    x64.jcc greater, forexit
  loop:
    x64.movRegReg rcx, rax
    x64.sarRegImm8 rcx, rax, 63
    x64.shrRegImm8 rcx, rcx, 63
    x64.leaRegRegReg rcx, rax, rcx
    x64.sarRegImm8 rcx, rcx, 1
    x64.imulRegRegImm32 rcx, rcx, 2
    x64.movRegReg rdx, rax
    x64.subRegReg rdx, rax, rcx
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, forstep
  ifcont:
    x64.leaRegRegReg rcx, r8, rax
    x64.movRegReg r8, rcx
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at ranges.continue-in-range.test:10: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
