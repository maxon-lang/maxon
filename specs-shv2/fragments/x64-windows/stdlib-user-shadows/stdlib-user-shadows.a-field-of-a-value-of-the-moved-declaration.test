// Test: stdlib-user-shadows.a-field-of-a-value-of-the-moved-declaration
type FileInfo
	export var tag as Integer

	static function make() returns FileInfo
		return FileInfo{tag: 5}
	end 'make'
end 'FileInfo'

function main() returns ExitCode
	let info = try File.info(Directory.currentPath()) otherwise 'missing'
		return 90 as ExitCode
	end 'missing'
	return (FileInfo.make().tag + (1 if info.isDirectory else 0)) as ExitCode
end 'main'
typealias Integer = int(i64.min to i64.max)
---
ExitCode: 6
---
data {
  __data_CharacterSet.cachedWhitespacesAndNewlines@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_timer_count@40 = i64 0
  __gt_timer_heap_base@48 = i64 0
  __gt_timer_capacity@56 = i64 0
  __gt_timer_seq@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_proc_count@80 = i64 0
  __gt_proc_handles_base@88 = i64 0
  __gt_proc_gts_base@96 = i64 0
  __gt_proc_wait_snapshot@104 = i64 0
  __gt_proc_poller@112 = i64 0
  __gt_live_count@120 = i64 0
  __sched_progress@128 = i64 0
  __sched_active_workers@136 = i64 1
  __sched_max_active_workers@144 = i64 1
  __sched_tls_index@152 = i64 0
  __sched_tls_teb_offset@160 = i64 0
  __sched_procs@168 = i64 0
  __sched_allm@176 = i64 0
  __sched_midle@184 = i64 0
  __sched_pidle@192 = i64 0
  __sched_num_procs@200 = i64 0
  __sched_shutdown_flag@208 = i64 0
  __sched_lock@216 = i64 0
  __sched_nmspinning@224 = i64 0
  __sched_parked_drivers@232 = i64 0
  __sched_sysmon_started@240 = i64 0
  __slab_arena_list@248 = i64 0
  __slab_arena_map_l1@256 = i64 0
  __slab_state@264 = i64 0
}

func @FileInfo.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 5
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect Directory.currentPath
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect File.info
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r12, 90
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_FilePath
    x64.callDirect FileInfo.make
    x64.loadRegBaseDisp.word64 rax, [r8 + 0]
    x64.loadRegBaseDisp.byte rcx, [r12 + 32]
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, ternaryfalse
  ternarytrue:
    x64.movRegImm32 rcx, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 rcx, 0
  matchcont:
    x64.leaRegRegReg rbx, rax, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg rbx, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_87]  ; "panic at stdlib-user-shadows.a-field-of-a-value-of-the-moved-declaration.test:14: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r8
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
