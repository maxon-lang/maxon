// Test: valid-empty-function
function doNothing()
end 'doNothing'

function main() returns ExitCode
	doNothing()
	return 0
end 'main'
---
ExitCode: 0
---
func @doNothing {
  entry:
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.callDirect doNothing
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.ret
}
