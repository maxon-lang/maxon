// Test: the-adopted-array-moves-into-a-struct-field
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

type Holder
	export var bytes as ByteArray

	export static function create(bytes ByteArray) returns Self
		return Self{bytes: bytes}
	end 'create'
end 'Holder'

function build() returns Holder
	let mm = try __ManagedMemory.create(4, elementSize: 1) otherwise panic("create failed")
	try mm.setLength(2) otherwise panic("setLength failed")
	try mm.setByte(0, value: 30) otherwise panic("setByte failed")
	try mm.setByte(1, value: 12) otherwise panic("setByte failed")
	return Holder.create(ByteArray.init(mm))
end 'build'

function main() returns ExitCode
	let h = build()
	let v0 = try h.bytes.get(0) otherwise return 1
	let v1 = try h.bytes.get(1) otherwise return 1
	return (v0 + v1) as ExitCode
end 'main'
---
ExitCode: 42
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 1
    x64.callDirect __arr_mem_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 0
    x64.movRegImm32 rax, 30
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_set_byte
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 rdx, 1
    x64.movRegImm32 rax, 12
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_set_byte
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rax, [rip + __str_rec_5]
    x64.movRegImm32 rcx, 134
    x64.movReg32Reg32 rcx, rcx
    x64.iatCall 0
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg rcx, r8
    x64.callDirect Holder.create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect build
    x64.movRegReg rbx, r8
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_get
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.loadRegBaseDisp.word64 rcx, [rbx + 0]
    x64.movRegImm32 rdx, 1
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.leaRegRegReg r12, r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
