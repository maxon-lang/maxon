// Test: a-synthesized-byte-buffer-adopts
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let cwd = try __ManagedDirectory.currentPath() otherwise return 1
	let a = ByteArray.init(cwd)
	if a.count() > 0 'adopted'
		return 7
	end 'adopted'
	return 2
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect __md_current_path
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, r12
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 0
    x64.jcc greater, adopted
    x64.jmp ifcont
  adopted:
    x64.movRegImm32 r13, 7
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r13, 2
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
