// Test: a-synthesized-byte-buffer-adopts
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

function main() returns ExitCode
	let cwd = try __ManagedDirectory.currentPath() otherwise return 1
	let a = ByteArray.init(cwd)
	if a.count() > 0 'adopted'
		return 7
	end 'adopted'
	return 2
end 'main'
---
ExitCode: 7
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_current_gt@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_system_stack_top@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_trace_digits@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
  __gt_live_count@128 = i64 0
  __slab_arena_list@136 = i64 0
  __slab_arena_map_l1@144 = i64 0
  __slab_state@152 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __md_current_path
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.loadRegBaseDisp.word64 rax, [r8 + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greater, adopted
    x64.jmp ifcont
  adopted:
    x64.movRegImm32 r12, 7
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, r8
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
