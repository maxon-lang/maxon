// Test: an-unbound-adoption-is-dropped-when-the-callee-throws
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

enum Boom implements Error
	bad
end 'Boom'

function eat(xs ByteArray, fail bool) returns int throws Boom
	if fail 'boom'
		throw Boom.bad
	end 'boom'
	return xs.count()
end 'eat'

function main() returns ExitCode
	let mm = try __ManagedMemory.create(4, elementSize: 1) otherwise return 1
	try mm.setLength(2) otherwise return 2
	var total = 0
	var i = 0
	while i < 8 'spin'
		total = total + (try eat(ByteArray.init(mm), fail: true) otherwise 1)
		total = total + (try eat(ByteArray.init(mm), fail: false) otherwise 9)
		i = i + 1
	end 'spin'
	return (total * 10 + mm.length()) as ExitCode
end 'main'
---
ExitCode: 242
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @eat {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, ifcont
  boom:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 4
    x64.movRegImm32 rdx, 1
    x64.callDirect __managed_mem_create
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#1
  tryerr#2:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_set_length
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#3
  tryerr#4:
    x64.movRegImm32 r12, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#3:
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
  whilehdr:
    x64.cmpRegImm32 r13, 8
    x64.jcc greaterEqual, whileexit
  spin:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r14, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, r14
    x64.callDirect eat
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#8
  tryerr#9:
    x64.movRegImm32 rax, 1
    x64.jmp trycont#10
  tryok#8:
    x64.movRegReg rax, r8
  trycont#10:
    x64.leaRegRegReg r12, r12, rax
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r14, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r14
    x64.callDirect eat
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok#11
  tryerr#12:
    x64.movRegImm32 rax, 9
    x64.jmp trycont#13
  tryok#11:
    x64.movRegReg rax, r8
  trycont#13:
    x64.leaRegRegReg r12, r12, rax
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp whilehdr
  whileexit:
    x64.imulRegRegImm32 rax, r12, 10
    x64.loadRegBaseDisp.word64 rcx, [rbx + 8]
    x64.leaRegRegReg r12, rax, rcx
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
