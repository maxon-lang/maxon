// Test: multiple-variables
function main() returns ExitCode
	let a = 10
	let b = 20
	return a + b
end 'main'
---
ExitCode: 30
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
    x64.movRegReg rdx, rax
    x64.addRegReg rdx, rcx
    x64.movRegReg r8, rdx
    x64.ret
}
