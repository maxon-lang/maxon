// Test: the-transform-parameter-takes-the-container-element

function main() returns ExitCode
	let nums = [1, 2, 3]
	let out = nums.map(function(a) gives a * 10)
	var sum = 0
	for n in out 'loop'
		sum = sum + n
	end 'loop'
	print("sum={sum}\n")
	return 0
end 'main'
