// Test: extension-clause-superset-of-the-types-own
typealias Num = int(i64.min to i64.max)

type Pair uses A, B where A is Equatable, B is Equatable
	export var first as A
	export var second as B
	export static function create(a A, b B) returns Self
		return Self{first: a, second: b}
	end 'create'
	export function firstIs(x A) returns bool
		return self.first == x
	end 'firstIs'
end 'Pair'

extension Pair where A is Equatable and Comparable, B is Equatable
	export function firstIsVia(x A) returns bool
		return self.firstIs(x)
	end 'firstIsVia'
end 'Pair'

typealias NumPair = Pair with (Num, Num)

function main() returns ExitCode
	let p = NumPair.create(1, b: 2)
	if p.firstIs(1) 'a'
		print("a=true\n")
	end 'a'
	if p.firstIsVia(1) 'c'
		print("via=true\n")
	end 'c'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Pair.firstIs {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rax
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callMem [rbx + 24]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Pair.firstIsVia {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect Pair.firstIs
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 56
    x64.movRegImm32 rax, 1
    x64.movRegImm32 rcx, 2
    x64.leaRegRdata rdx, [rip + __witness_int.Equatable]
    x64.leaRegRdata rdx, [rip + __witness_int.Equatable]
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.storeBaseDispReg.word64 [rbx + 8], rcx
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, rbx
    x64.callDirect Pair.firstIs
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, a
    x64.jmp ifcont#2
  a:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.leaRegRdata r9, [rip + __witness_int.Equatable]
    x64.leaRegRdata rsi, [rip + __witness_int.Comparable]
    x64.movRegReg rcx, rbx
    x64.callDirect Pair.firstIsVia
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c
    x64.jmp ifcont#4
  c:
    x64.leaRegRdata rcx, [rip + __str_rec_4]
    x64.callDirect print
    x64.jmp ifcont#4
  ifcont#4:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
