// Test: opaque-copy-trivial-inert
typealias ExitCode = int(0 to 125)
typealias Count = int(0 to u64.max)
typealias SmallInt = int(0 to 100)

type Container uses Element
	typealias ElementArray = Array with Element

	export var items as ElementArray

	export static function create() returns Self
		return Self{ items: ElementArray.create() }
	end 'create'

	export function push(item Element)
		self.items.push(item)
	end 'push'

	export function count() returns Count
		return self.items.count()
	end 'count'

	export function duplicate() returns Self
		return Self{ items: self.items.clone() }
	end 'duplicate'
end 'Container'

typealias IntContainer = Container with SmallInt

function makeDuplicate() returns IntContainer
	var a = IntContainer.create()
	a.push(10)
	a.push(20)
	return a.duplicate()
end 'makeDuplicate'

function main() returns ExitCode
	var b = makeDuplicate()
	let c = b.count()
	if c == 2 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Container.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rax, 8
    x64.loadRegBaseDisp.word64 rdx, [rcx + 40]
    x64.movRegReg rcx, rax
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Container.push {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect __managed_push
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Container.count {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 8]
    x64.popReg rbp
    x64.ret
}

func @Container.duplicate {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.callDirect Array.clone
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @makeDuplicate {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Container_SmallInt]
    x64.callDirect Container.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 10
    x64.leaRegRdata rax, [rip + __layout_Container_SmallInt]
    x64.movRegReg rcx, rbx
    x64.callDirect Container.push
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_Container_SmallInt]
    x64.movRegReg rcx, rbx
    x64.callDirect Container.push
    x64.leaRegRdata rdx, [rip + __layout_Container_SmallInt]
    x64.movRegReg rcx, rbx
    x64.callDirect Container.duplicate
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Container_SmallInt
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect makeDuplicate
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect Container.count
    x64.cmpRegImm32 r8, 2
    x64.jcc equal, ok
    x64.jmp ifcont
  ok:
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Container_SmallInt
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Container_SmallInt
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Array.clone {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.movRegReg rax, r12
    x64.movRegReg r9, rbx
    x64.callDirect __managed_slice_opaque
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
