  __rc_ok:
    x64.loadRegSlot rcx, slot0
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot1
    x64.callDirect __destruct_Container_String
    x64.movRegReg r8, rbx
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
