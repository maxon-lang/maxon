    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.movRegReg xmm2, xmm0
    x64.subsdRegReg xmm2, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.addsdRegReg xmm0, xmm0, xmm1
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.ucomisdRegReg xmm0, xmm1
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rsi
    x64.divsdRegReg xmm2, xmm2, xmm0
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_5]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok#1:
    x64.movRegReg xmm0, xmm2
    x64.mulsdRegReg xmm0, xmm2, xmm2
    x64.movRegImm32 rsi, 1
    x64.movRegReg xmm1, xmm2
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg rsi, rax
    x64.jcc less, series
    x64.jmp forexit
  series:
    x64.mulsdRegReg xmm2, xmm2, xmm0
    x64.movsdRegRip xmm3, [rip + __fconst_6]
    x64.cvtsi2sdRegReg xmm4, rsi
    x64.mulsdRegReg xmm3, xmm3, xmm4
    x64.movsdRegRip xmm4, [rip + __fconst_4]
    x64.addsdRegReg xmm3, xmm3, xmm4
    x64.movsdRegRip xmm4, [rip + __fconst_5]
    x64.ucomisdRegReg xmm3, xmm4
    x64.setccReg notEqual, rcx
    x64.setccReg parity, rdx
    x64.leaRegRegReg rcx, rcx, rdx
    x64.cmpRegImm32 rcx, 0
    x64.setccReg equal, rdi
    x64.movRegReg xmm4, xmm2
    x64.divsdRegReg xmm4, xmm2, xmm3
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movsdRegRip xmm0, [rip + __fconst_5]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.addsdRegReg xmm1, xmm1, xmm4
