func @Math.nonPositiveLogResult {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont
    x64.jmp fordered
  fordered:
    x64.jcc equal, zero
    x64.jmp ifcont
  zero:
    x64.jmp __il_body#4
  __il_body#4:
    x64.movRegImm rax, 18442240474082181120
    x64.movqXmmGpr xmm0, rax
    x64.jmp __il_cont#3
  __il_cont#3:
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp __il_body#6
  __il_body#6:
