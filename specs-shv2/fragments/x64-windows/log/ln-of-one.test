}

func @Math.log {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movsdRegRip xmm1, [rip + __fconst_5]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc aboveEqual, nonPositive
    x64.jmp ifcont#2
  nonPositive:
    x64.callDirect Math.nonPositiveLogResult
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.jmp __il_body
  __il_body:
    x64.movqGprXmm rax, xmm0
    x64.movRegImm rcx, 9218868437227405312
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rax
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, positiveInfinity
    x64.jmp ifcont#4
  positiveInfinity:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc parity, ifcont#6
    x64.jmp fordered
  fordered:
    x64.jcc equal, one
    x64.jmp ifcont#6
  one:
    x64.movsdRegRip xmm0, [rip + __fconst_5]
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr#7
  whilehdr#7:
    x64.movsdRegRip xmm1, [rip + __fconst_4]
    x64.ucomisdRegReg xmm0, xmm1
    x64.jcc aboveEqual, normalize_down
    x64.jmp whileexit#9
  normalize_down:
    x64.movsdRegRip xmm1, [rip + __fconst_6]
    x64.divsdRegReg xmm0, xmm0, xmm1
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr#7
  whileexit#9:
    x64.movRegReg rbx, rax
    x64.jmp whilehdr#10
  whilehdr#10:
    x64.movsdRegRip xmm1, [rip + __fconst_7]
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, normalize_up
    x64.jmp whileexit#12
  normalize_up:
    x64.movsdRegRip xmm1, [rip + __fconst_6]
    x64.mulsdRegReg xmm0, xmm0, xmm1
    x64.leaRegRegImm32 rbx, rbx, -1
    x64.jmp whilehdr#10
  whileexit#12:
    x64.movRegImm32 rcx, 20
    x64.callDirect Math.lnBySeries
    x64.movsdRegRip xmm1, [rip + __fconst_8]
    x64.cvtsi2sdRegReg xmm2, rbx
    x64.mulsdRegReg xmm2, xmm2, xmm1
    x64.addsdRegReg xmm0, xmm0, xmm2
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
