    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r14, r13
    x64.jcc less, byteLoop
    x64.jmp forexit
  byteLoop:
    x64.movRegReg rcx, r12
