    x64.ret
  tryok:
    x64.cmpRegImm32 r8, 128
    x64.movRegImm32 rax, 1
    x64.jcc greaterEqual, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.cmpRegImm32 r8, 13
    x64.setccReg equal, rax
    x64.jmp scmerge
  scmerge:
