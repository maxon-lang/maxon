    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg rcx, rdx
    x64.callDirect String.toByteArray
    x64.movRegReg r12, r8
