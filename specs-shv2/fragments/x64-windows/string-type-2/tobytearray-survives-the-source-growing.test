// Test: tobytearray-survives-the-source-growing
function main() returns ExitCode
	let who = "ello"
	var s = "H{who}"
	let arr = s.toByteArray()
	s.append("!!!")
	let b0 = try arr.get(0) otherwise panic("get")
	print("s={s} arr.count={arr.count()} arr[0]={b0}")
	return 0
end 'main'
