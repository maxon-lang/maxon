// Test: string-literal-through-two-call-levels
function grow(s String)
	s.append("XY")
end 'grow'

function outer(t String)
	grow(t)
end 'outer'

function main() returns ExitCode
	outer("hello")
	print("hello\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @grow {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rdx, [rip + __str_rec_1]
    x64.callDirect __str_append
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @outer {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect grow
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect __str_clone
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect outer
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect print
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
