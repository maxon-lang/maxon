// Test: a-returned-borrow-still-writes-through-to-the-caller
function relay(s String) returns String
	return s
end 'relay'

function main() returns ExitCode
	var v = "ab"
	var out = relay(v)
	out.append("XY")
	print("v={v} out={out}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @relay {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 120
    x64.leaRegRdata rax, [rip + __str_rec_5]  ; "ab"
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot0, r13
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r13
    x64.callDirect relay
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot1, rbx
    x64.leaRegRdata rdx, [rip + __str_rec_6]  ; "XY"
    x64.movRegReg rcx, rbx
    x64.callDirect String.append
    x64.leaRegRdata rax, [rip + __str_rec_7]  ; "v="
    x64.loadRegBaseDisp.word64 r12, [rax + 0]
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.storeSlotReg slot9, rax
    x64.loadRegBaseDisp.word64 r13, [r13 + 8]
    x64.leaRegRdata rax, [rip + __str_rec_8]  ; " out="
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot8, rcx
    x64.loadRegBaseDisp.word64 r15, [rax + 8]
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.storeSlotReg slot7, rax
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.storeSlotReg slot6, rax
    x64.leaRegRdata rcx, [rip + __str_rec_9]  ; "\x0a"
    x64.loadRegBaseDisp.word64 rdx, [rcx + 0]
    x64.storeSlotReg slot5, rdx
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.storeSlotReg slot4, rcx
    x64.leaRegRegReg rdx, r14, r13
    x64.leaRegRegReg rdx, rdx, r15
    x64.leaRegRegReg rax, rdx, rax
    x64.leaRegRegReg rax, rax, rcx
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 rbx, r8, 56
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, rbx, r14
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot9
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r13
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot8
    x64.movRegReg rax, r15
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r15
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot7
    x64.loadRegSlot r13, slot6
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r13
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot5
    x64.loadRegSlot r13, slot4
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot3
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegImm32 rbx, 0
    x64.loadRegSlot rcx, slot1
    x64.callDirect __str_decref
    x64.loadRegSlot rcx, slot0
    x64.callDirect __str_decref
    x64.movRegReg r8, rbx
    x64.epilogue 120
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
