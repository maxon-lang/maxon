// Test: managed-aggregate-column-survives-rehash
typealias Count = int(i64.min to i64.max)

type Tagged
	var label as String
	var n as Count

	export static function create(label String, n Count) returns Self
		return Self{label: label, n: n}
	end 'create'

	export function score() returns Count
		return n + label.byteLength()
	end 'score'
end 'Tagged'

typealias TaggedMap = Map with (Count, Tagged)

function build(n Count) returns Count
	var m = TaggedMap.create()
	for i in 0 upto n 'fill'
		m.upsert(i, value: Tagged.create("tag {i}", n: i))
	end 'fill'
	var total = 0 as Count
	for i in 0 upto n 'read'
		let t = try m.get(i) otherwise panic("Map lost an entry across its rehash")
		total = total + t.score()
	end 'read'
	return total
end 'build'

function main() returns ExitCode
	print("total {build(200)}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Tagged.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __str_retain
    x64.storeBaseDispReg.word64 [r13 + 0], r8
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Tagged.score {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc greaterEqual, __rc_ok
  __il_slow:
    x64.callDirect String.byteLength
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rax
  __il_cont:
    x64.leaRegRegReg r8, rbx, r8
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

