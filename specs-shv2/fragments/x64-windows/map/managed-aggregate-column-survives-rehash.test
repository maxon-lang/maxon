    x64.callDirect String.byteLength
    x64.leaRegRegImm32 rax, r8, 0
    x64.leaRegRegReg r8, rbx, rax
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

