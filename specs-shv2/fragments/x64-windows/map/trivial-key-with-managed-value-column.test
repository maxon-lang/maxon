// Test: trivial-key-with-managed-value-column
typealias Val = int(i64.min to i64.max)

type Point implements Hashable, Equatable
	export var x as Val
	export var y as Val

	export static function create(x Val, y Val) returns Self
		return Self{x: x, y: y}
	end 'create'

	export function hash() returns HashValue
		return x * 31 + y
	end 'hash'

	export function equals(other Self) returns bool
		return x == other.x and y == other.y
	end 'equals'
end 'Point'

typealias PointStrMap = Map with (Point, String)

function main() returns ExitCode
	var m = PointStrMap.create()
	for i in 0 upto 40 'fill'
		m.upsert(Point.create(i, y: i * 3), value: "value number {i}, long enough to escape any small-string envelope")
	end 'fill'
	var seen = 0
	for i in 0 upto 40 'read'
		if (try m.get(Point.create(i, y: i * 3)) otherwise "").equals("value number {i}, long enough to escape any small-string envelope") 'hit'
			seen = seen + 1
		end 'hit'
	end 'read'
	print("hits {seen} count {m.count()}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Point.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.storeBaseDispReg.word64 [r8 + 8], r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Point.hash {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegRegImm32 rax, rax, 31
    x64.loadRegBaseDisp.word64 rcx, [rcx + 8]
    x64.leaRegRegReg r8, rax, rcx
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_19]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Point.equals {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rsi, [rdx + 0]
    x64.cmpRegReg rax, rsi
    x64.movRegImm32 r8, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rdx + 8]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, r8
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.popReg rbp
    x64.ret
}

