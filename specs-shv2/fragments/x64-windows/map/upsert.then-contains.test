// Test: upsert.then-contains
function main() returns ExitCode
	var m = [10: 1]
	m.upsert(20, value: 2)
	if m.contains(20) 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 10
    x64.movRegImm32 r12, 1
    x64.leaRegRdata rcx, [rip + __layout_Map_int_int]
    x64.leaRegRdata rdx, [rip + __witness_int.Hashable]
    x64.leaRegRdata rax, [rip + __witness_int.Equatable]
    x64.callDirect Map.create
    x64.movRegReg r13, r8
    x64.leaRegRdata r9, [rip + __layout_Map_int_int]
    x64.leaRegRdata rsi, [rip + __witness_int.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect Map.upsert
    x64.movRegImm32 rdx, 20
    x64.movRegImm32 rax, 2
    x64.leaRegRdata r9, [rip + __layout_Map_int_int]
    x64.leaRegRdata rsi, [rip + __witness_int.Hashable]
    x64.leaRegRdata rdi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect Map.upsert
    x64.movRegImm32 rdx, 20
    x64.leaRegRdata rax, [rip + __layout_Map_int_int]
    x64.leaRegRdata r9, [rip + __witness_int.Hashable]
    x64.leaRegRdata rsi, [rip + __witness_int.Equatable]
    x64.movRegReg rcx, r13
    x64.callDirect Map.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont
  check:
    x64.movRegImm32 rbx, 1
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Map_int_int
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __destruct_Map_int_int
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
