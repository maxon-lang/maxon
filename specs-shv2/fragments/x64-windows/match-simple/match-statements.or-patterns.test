// Test: match-statements.or-patterns
function main() returns ExitCode
	let x = 3
	match x 'check'
		1 or 2 then return 10
		3 or 4 or 5 then return 20
		default then return 0
	end 'check'
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.leaRegRegImm32 rax, rax, -1
    x64.jumpTable rax, default=matchdefault [[0..1]=matcharm#1, [2..4]=matcharm#2] @__jumptable_0
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matcharm#1:
    x64.movRegImm32 r8, 10
    x64.popReg rbp
    x64.ret
  matcharm#2:
    x64.movRegImm32 r8, 20
    x64.popReg rbp
    x64.ret
  matchcont:
}
