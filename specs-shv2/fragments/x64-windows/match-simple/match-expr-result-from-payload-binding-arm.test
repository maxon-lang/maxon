// Test: match-expr-result-from-payload-binding-arm
typealias Idx = int(0 to 100)

union Op
	none
	alloc(name ByteArray)
end 'Op'

function firstByte(b ByteArray) returns Idx
	return try b.get(0) otherwise 0 as Idx
end 'firstByte'

function nameOf(op Op) returns Idx
	let n = match op 'pick'
		alloc(name) gives name
		default panic("none")
	end 'pick'
	return firstByte(n)
end 'nameOf'

function main() returns ExitCode
	var b = ByteArray.create()
	b.push(65)
	return nameOf(Op.alloc(b))
end 'main'
---
ExitCode: 65
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @firstByte {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rdx, 0
    x64.loadRegBaseDisp.word64 rax, [rcx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load#13:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __im_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc belowEqual, __im_slow
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc equal, __im_cont
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __im_cont
  __im_slow:
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rsi, r10
  __im_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r8, rax
  trycont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @nameOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdefault
  matcharm:
    x64.loadRegBaseDisp.word64 rbx, [rcx + 8]
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect firstByte
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 65
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 0], rax
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 8], rbx
    x64.movRegReg rcx, r12
    x64.callDirect nameOf
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __destruct_Op
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
