// Test: match-arm-field-assignment
enum Op
	noop
	mark
	done
end 'Op'

type State
	export var flag = false

	export static function make() returns State
		return State{}
	end 'make'
end 'State'

function scan(op Op, state State)
	match op 'm'
		noop then break 'm'
		mark then state.flag = true
		done then break 'm'
	end 'm'
end 'scan'

function main() returns ExitCode
	var s = State.make()
	scan(Op.mark, state: s)
	return 1 if s.flag else 0
end 'main'
---
ExitCode: 1
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @State.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.byte [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @scan {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#7
  matcharm#1:
    x64.jmp matchcont
  matchnext#7:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#3
    x64.jmp matchnext#8
  matcharm#3:
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.byte [rdx + 0], rax
    x64.jmp matchcont
  matchnext#8:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm#4
    x64.jmp matchdead
  matcharm#4:
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchdead:
  afterbreak#2:
  afterbreak#5:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect State.make
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.movRegReg rdx, rbx
    x64.callDirect scan
    x64.loadRegBaseDisp.byte rax, [rbx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 r12, 1
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r12, 0
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
