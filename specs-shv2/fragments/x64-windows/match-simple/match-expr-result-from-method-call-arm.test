// Test: match-expr-result-from-method-call-arm
typealias Idx = int(0 to 100)

type Lookup
	var names as StringArray

	export static function make() returns Lookup
		var a = StringArray.create()
		a.push("alpha")
		return Lookup{names: a}
	end 'make'

	export function getName(i Idx) returns String
		return try self.names.get(i) otherwise "?"
	end 'getName'

	export function nameLen(t Idx) returns Idx
		let name = match t 'pick'
			0 gives self.getName(0)
			default panic("empty")
		end 'pick'
		return name.byteLength() as Idx
	end 'nameLen'
end 'Lookup'

function main() returns ExitCode
	var l = Lookup.make()
	return l.nameLen(0)
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Lookup.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect __str_retain
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Lookup.getName {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 rdx, 100
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.loadRegBaseDisp.word64 rcx, [rcx + 0]
    x64.loadRegBaseDisp.word64 rax, [rcx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word
    x64.jmp __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rsi
    x64.cmpRegReg rdx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rsi, rsi, rax
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#13
  __im_load#13:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.imulRegRegImm32 rsi, rdx, 8
    x64.leaRegRegReg rax, rax, rsi
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.cmpRegImm32 rdx, 0
    x64.setccReg less, rsi
    x64.cmpRegReg rdx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rsi, rsi, rax
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_load#14
  __im_load#14:
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.leaRegRegReg rax, rax, rdx
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __im_loaded
  __im_loaded:
    x64.movRegImm32 rsi, 0
    x64.loadRegBaseDisp.word64 rdi, [rcx + 40]
    x64.cmpRegImm32 rdi, 0
    x64.jcc notEqual, __im_empty
    x64.jmp critsplit#16
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp critsplit#17
  critsplit#17:
    x64.jmp __il_cont
  critsplit#16:
    x64.jmp __il_cont
  __il_slow:
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rsi, r10
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rsi, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.jmp trycont
  tryok:
    x64.movRegReg rcx, rax
    x64.jmp trycont
  trycont:
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Lookup.nameLen {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.cmpRegImm32 rdx, 0
    x64.jcc less, __rc_panic#5
    x64.jmp __rc_chk#6
  __rc_chk#6:
    x64.cmpRegImm32 rdx, 100
    x64.jcc greater, __rc_panic#5
    x64.jmp __rc_ok#4
  __rc_panic#5:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#4:
    x64.cmpRegImm32 rdx, 0
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 rdx, 0
    x64.callDirect Lookup.getName
    x64.movRegReg rbx, r8
    x64.jmp matchcont
  matchcont:
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic#8
    x64.jmp __rc_chk#9
  __rc_chk#9:
    x64.cmpRegImm32 r12, 100
    x64.jcc greater, __rc_panic#8
    x64.jmp __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_7]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
