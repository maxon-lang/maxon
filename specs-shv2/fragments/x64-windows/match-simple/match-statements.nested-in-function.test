// Test: match-statements.nested-in-function

typealias Integer = int(i64.min to i64.max)

function categorize(n Integer) returns Integer
	match n 'cat'
		1 or 2 or 3 then return 1
		4 or 5 or 6 then return 2
		default then return 0
	end 'cat'
end 'categorize'

function main() returns ExitCode
	return categorize(5)
end 'main'
---
ExitCode: 2
---
func @categorize {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rcx, 4
    x64.jcc less, matchlo
    x64.jmp matchhi
  matchlo:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matchnext:
    x64.cmpRegImm32 rcx, 2
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matchnext:
    x64.cmpRegImm32 rcx, 3
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
  matchhi:
    x64.cmpRegImm32 rcx, 4
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matchnext:
    x64.cmpRegImm32 rcx, 5
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matchnext:
    x64.cmpRegImm32 rcx, 6
    x64.jcc equal, matcharm
    x64.jmp matchdefault
  matcharm:
    x64.movRegImm32 r8, 2
    x64.popReg rbp
    x64.ret
  matchdefault:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  matchcont:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 5
    x64.callDirect categorize
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
