// Test: a-wide-byte-still-materializes-a-byte-view
typealias Byte = int(0 to 1000)
typealias Bytes = Array with Byte

function takes(b Bytes) returns ExitCode
	let first = try b.get(0) otherwise 0
	let second = try b.get(1) otherwise 0
	let third = try b.get(2) otherwise 0
	return 0 if b.count() == 3 and first == 97 and second == 98 and third == 99 else 1
end 'takes'

function main() returns ExitCode
	return takes("abc".toByteArray())
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @takes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r13, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r14, 0
    x64.jmp trycont
  tryok:
    x64.movRegReg r14, r8
    x64.jmp trycont
  trycont:
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_count
    x64.cmpRegImm32 r8, 3
    x64.movRegImm32 rax, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r12, 97
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r13, 98
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.movRegImm32 rcx, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 r14, 99
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit:
    x64.movRegReg rax, rcx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, ternarytrue
    x64.jmp ternaryfalse
  ternarytrue:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  ternaryfalse:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_2]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rbx, [rip + __str_rec_1]
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.callDirect __str_to_bytes
    x64.movRegReg rcx, r12
    x64.callDirect takes
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, r12
    x64.callDirect __arr_decref
    x64.movRegReg r8, rbx
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
