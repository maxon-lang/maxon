// Test: map-struct-with-bytearray-field
typealias SmallInt = int(0 to u8.max)
typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

type Entry
	export var data as ByteArray
	export var tag as SmallInt

	static function create(data ByteArray, tag SmallInt) returns Self
		return Self{data: data, tag: tag}
	end 'create'
end 'Entry'

typealias EntryMap = Map with (String, Entry)

function main() returns ExitCode
	var m = EntryMap.create()
	var arr = ByteArray.create()
	arr.push(10)
	arr.push(20)
	arr.push(30)
	let e = Entry.create(arr, tag: 42)
	try m.insert("hello", value: e) otherwise ignore
	let got = try m.get("hello") otherwise Entry.create(ByteArray.create(), tag: 0)
	print("{got.data.count()}\n")
	print("{got.tag}\n")
	let b = try got.data.get(1) otherwise 0
	print("{b}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Entry.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r12, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_39]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 16
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_incref
    x64.storeBaseDispReg.word64 [r13 + 0], rbx
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

