// Test: access-multiple-args
function main() returns ExitCode
	let args = CommandLine.args()
	let arg1 = try args.get(1) otherwise ""
	let arg2 = try args.get(2) otherwise ""
	let arg3 = try args.get(3) otherwise ""
	print(arg1)
	print("\n")
	print(arg2)
	print("\n")
	print(arg3)
	print("\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect CommandLine.args
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata r12, [rip + __str_rec_1]
    x64.jmp trycont
  tryok:
    x64.movRegReg r12, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 2
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata r13, [rip + __str_rec_1]
    x64.jmp trycont
  tryok:
    x64.movRegReg r13, r8
    x64.jmp trycont
  trycont:
    x64.movRegImm32 rdx, 3
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_get
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata r14, [rip + __str_rec_1]
    x64.jmp trycont
  tryok:
    x64.movRegReg r14, r8
    x64.jmp trycont
  trycont:
    x64.movRegReg rcx, r12
    x64.callDirect __print_string
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect __print_string
    x64.movRegReg rcx, r13
    x64.callDirect __print_string
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect __print_string
    x64.movRegReg rcx, r14
    x64.callDirect __print_string
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect __print_string
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @CommandLine.args {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.callDirect __cl_count
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __arr_create
    x64.movRegReg r12, r8
    x64.movRegImm32 r13, 0
    x64.jmp forhdr
  forhdr:
    x64.cmpRegReg r13, rbx
    x64.jcc less, loop
    x64.jmp forexit
  loop:
    x64.movRegReg rcx, r13
    x64.callDirect __cl_arg
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r14
    x64.callDirect __str_from_bytes
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r8
    x64.callDirect __arr_push
    x64.movRegReg rcx, r14
    x64.callDirect __arr_decref
    x64.jmp forstep
  forstep:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr
  forexit:
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
