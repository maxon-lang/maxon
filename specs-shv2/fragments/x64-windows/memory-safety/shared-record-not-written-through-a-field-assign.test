	var b = StringBuilder.create()
	let fromA = a.build()
	let fromB = b.build()
	a.append("AAA")
	print("a={a.byteLength()} b={b.byteLength()} fromA=[{fromA}] fromB=[{fromB}]")
	return 0
end 'main'
