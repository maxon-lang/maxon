// Test: predicate-argument-longer-than-the-receiver
function main() returns ExitCode
	let s = "hi"
	if s.startsWith("hello") 'a'
		print("badStart\n")
	end 'a'
	if s.endsWith("hello") 'b'
		print("badEnd\n")
	end 'b'
	if s.contains("hello") 'c'
		print("badContains\n")
	end 'c'
	if s.startsWith("") 'd'
		print("emptyPrefix\n")
	end 'd'
	if s.endsWith("") 'e'
		print("emptySuffix\n")
	end 'e'
	if s.contains("") 'f'
		print("emptyNeedle\n")
	end 'f'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
