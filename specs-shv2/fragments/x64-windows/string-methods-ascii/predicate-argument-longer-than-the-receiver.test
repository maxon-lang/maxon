    x64.jcc notEqual, b
    x64.jmp ifcont
  b:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c
    x64.jmp ifcont
  c:
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rdx, [rip + __str_rec_11]
    x64.movRegReg rcx, rbx
    x64.callDirect __str_starts_with
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, d
    x64.jmp ifcont
  d:
    x64.leaRegRdata rcx, [rip + __str_rec_13]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.leaRegRdata rdx, [rip + __str_rec_11]
    x64.movRegReg rcx, rbx
