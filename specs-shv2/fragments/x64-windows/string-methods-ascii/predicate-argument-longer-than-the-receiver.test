    x64.leaRegRdata rdx, [rip + __str_rec_10]
    x64.movRegReg rcx, rbx
    x64.callDirect String.startsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, a
    x64.jmp ifcont#2
  a:
    x64.leaRegRdata rcx, [rip + __str_rec_11]
    x64.callDirect print
    x64.jmp ifcont#2
  ifcont#2:
