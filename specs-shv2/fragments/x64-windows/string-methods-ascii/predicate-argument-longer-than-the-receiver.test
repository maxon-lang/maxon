    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, b
    x64.jmp ifcont#4
  b:
    x64.leaRegRdata rcx, [rip + __str_rec_12]
    x64.callDirect print
    x64.jmp ifcont#4
  ifcont#4:
    x64.leaRegRdata rdx, [rip + __str_rec_10]
    x64.movRegReg rcx, rbx
    x64.callDirect String.contains
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c
    x64.jmp ifcont#6
  c:
    x64.leaRegRdata rcx, [rip + __str_rec_13]
    x64.callDirect print
    x64.jmp ifcont#6
  ifcont#6:
