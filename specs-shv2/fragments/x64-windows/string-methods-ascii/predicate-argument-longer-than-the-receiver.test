    x64.movRegReg rcx, rbx
    x64.callDirect String.startsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, d
    x64.jmp ifcont#8
  d:
    x64.leaRegRdata rcx, [rip + __str_rec_15]
    x64.callDirect print
    x64.jmp ifcont#8
  ifcont#8:
