// Test: empty-receiver-for-every-byte-method
function main() returns ExitCode
	let e = ""
	if e.startsWith("x") 'a'
		print("bad1\n")
	end 'a'
	if e.endsWith("x") 'b'
		print("bad2\n")
	end 'b'
	if e.contains("x") 'c'
		print("bad3\n")
	end 'c'
	if e.startsWith("") 'd'
		print("ok1\n")
	end 'd'
	print("[{e.toLower()}][{e.toUpper()}][{e.replace("x", with: "y")}]\n")
	let parts = e.split("x")
	print("{parts.count()}\n")
	return 0
end 'main'
