// Test: an-inner-throw-in-a-fell-through-handler-releases-them
typealias StrArray = Array with String
typealias Integer = int(i64.min to i64.max)

enum Boom implements Error
	bad
end 'Boom'

function consume(argv StrArray, n Integer) returns Integer throws Boom
	if n > 100 'big'
		throw Boom.bad
	end 'big'
	return argv.count() + n
end 'consume'

function run(n Integer) returns Integer throws Boom
	try consume(["x", "y"], n: n) otherwise 'h'
		if n > 500 'deep'
			throw Boom.bad
		end 'deep'
	end 'h'
	return 1
end 'run'

function main() returns ExitCode
	let a = try run(900) otherwise 3
	let b = try run(200) otherwise 3
	return a + b as ExitCode
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @consume {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.cmpRegImm32 rdx, 100
    x64.jcc greater, big
    x64.jmp ifcont
  big:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.leaRegRegReg r8, rax, rdx
    x64.movRegImm32 r10, 0
    x64.popReg rbp
    x64.ret
}

func @run {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.leaRegRdata r12, [rip + __str_rec_2]
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.movRegReg rcx, r12
    x64.callDirect __str_retain
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect __str_retain
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, rbx
    x64.callDirect consume
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.cmpRegImm32 rbx, 500
    x64.jcc greater, deep
    x64.jmp ifcont
  deep:
    x64.movRegImm32 rbx, 0
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.leaRegRegImm32 r10, rbx, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp trycont
  tryok:
    x64.jmp trycont
  trycont:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegImm32 r8, 1
    x64.movRegImm32 r10, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegImm32 rcx, 900
    x64.callDirect run
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#2
    x64.jmp tryok#1
  tryerr#2:
    x64.movRegImm32 rbx, 3
    x64.jmp trycont#3
  tryok#1:
    x64.movRegReg rbx, r8
    x64.jmp trycont#3
  trycont#3:
    x64.movRegImm32 rcx, 200
    x64.callDirect run
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#5
    x64.jmp tryok#4
  tryerr#5:
    x64.movRegImm32 rax, 3
    x64.jmp trycont#6
  tryok#4:
    x64.movRegReg rax, r8
    x64.jmp trycont#6
  trycont#6:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic#8
    x64.jmp __rc_chk#9
  __rc_chk#9:
    x64.movRegImm32 rcx, 4294967295
    x64.cmpRegReg rax, rcx
    x64.jcc greater, __rc_panic#8
    x64.jmp __rc_ok#7
  __rc_panic#8:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#7:
    x64.leaRegRegReg r8, rbx, rax
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic#11
    x64.jmp __rc_chk#12
  __rc_chk#12:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic#11
    x64.jmp __rc_ok#10
  __rc_panic#11:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok#10:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
