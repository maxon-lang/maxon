// Test: in-range-join-is-guarded-and-passes
typealias Num = int(0 to 1000)

union Kw
	alpha(n Num)
	end(a Num, b Num)
end 'Kw'

function tagOf(k Kw) returns Num
	return match k 'm'
		alpha(n) gives n
		end(a, b) gives a + b
	end 'm'
end 'tagOf'

function main() returns ExitCode
	return tagOf(Kw.end(20, b: 22))
end 'main'
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @tagOf {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#1:
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#2:
    x64.loadRegBaseDisp.word64 rax, [rcx + 8]
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.leaRegRegReg r8, rax, rcx
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 r8, 1000
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 20
    x64.movRegImm32 r12, 22
    x64.movRegImm32 rcx, 24
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 0], rax
    x64.storeBaseDispReg.word64 [r13 + 8], rbx
    x64.storeBaseDispReg.word64 [r13 + 16], r12
  __il_body:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, matchnext
  matcharm#3:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, matchdead
  matcharm#4:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 16]
    x64.leaRegRegReg rax, rax, rcx
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
  __rc_chk:
    x64.cmpRegImm32 rax, 1000
    x64.jcc lessEqual, __rc_ok
  __il_slow:
    x64.movRegReg rcx, r13
    x64.callDirect tagOf
    x64.movRegReg rbx, r8
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg rbx, rax
  __il_cont:
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg r8, rbx
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  matchdead:
}
