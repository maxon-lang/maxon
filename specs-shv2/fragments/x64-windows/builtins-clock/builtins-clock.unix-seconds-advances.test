// Test: builtins-clock.unix-seconds-advances
function main() returns ExitCode
	let before = __Builtins.currentUnixTimeSeconds()
	sleep(1100)
	let after = __Builtins.currentUnixTimeSeconds()
	if after >= before + 1 'advanced'
		return 4
	end 'advanced'
	return 1
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_current_gt@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_system_stack_top@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_trace_digits@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
  __gt_live_count@128 = i64 0
  __clock_wall_ticks@136 = i64 0
  __slab_arena_list@144 = i64 0
  __slab_arena_map_l1@152 = i64 0
  __slab_state@160 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect __clock_now_unix_s
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1100
    x64.callDirect sleep
    x64.callDirect __clock_now_unix_s
    x64.leaRegRegImm32 rax, rbx, 1
    x64.cmpRegReg r8, rax
    x64.jcc greaterEqual, advanced
    x64.jmp ifcont
  advanced:
    x64.movRegImm32 r8, 4
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @sleep {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __gt_sleep
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
