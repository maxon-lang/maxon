// Test: builtins-clock.ms-resolves-sub-tick
function main() returns ExitCode
	var smallest = 0
	var prev = __Builtins.currentTimeMs()
	var i = 0
	while i < 200000 'sample'
		let now = __Builtins.currentTimeMs()
		let delta = now - prev
		if delta > 0 'advanced'
			if smallest == 0 or delta < smallest 'newMin'
				smallest = delta
			end 'newMin'
			prev = now
		end 'advanced'
		i = i + 1
	end 'sample'
	if smallest > 0 and smallest < 5 'subTick'
		return 9
	end 'subTick'
	return 1
end 'main'
---
ExitCode: 9
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_clock_ticks@80 = i64 0
  __gt_clock_freq@88 = i64 0
  __gt_proc_count@96 = i64 0
  __gt_proc_handles_base@104 = i64 0
  __gt_proc_gts_base@112 = i64 0
  __gt_free_list_head@120 = i64 0
  __gt_live_count@128 = i64 0
  __gt_startup_base@136 = i64 0
  __gt_procinfo_base@144 = i64 0
  __gt_exitcode_base@152 = i64 0
  __gt_cmdline_buf_base@160 = i64 0
  __gt_cmdline_buf_cap@168 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rcx, 1000000
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rcx
    x64.movRegImm32 r12, 0
    x64.movRegReg r13, r12
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r13, 200000
    x64.jcc less, sample
    x64.jmp whileexit
  sample:
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rcx, 1000000
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg rcx, rax
    x64.subRegReg rcx, rax, r12
    x64.cmpRegImm32 rcx, 0
    x64.jcc greater, advanced
    x64.jmp critsplit
  advanced:
    x64.cmpRegImm32 rbx, 0
    x64.movRegImm32 rdx, 1
    x64.jcc equal, critsplit
    x64.jmp orrhs
  critsplit:
    x64.jmp scmerge
  orrhs:
    x64.cmpRegReg rcx, rbx
    x64.setccReg less, rdx
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, newMin
    x64.jmp critsplit
  newMin:
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rcx, rbx
    x64.jmp ifcont
  ifcont:
    x64.jmp ifcont
  critsplit:
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r12
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.jcc greater, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rbx, 5
    x64.setccReg less, rax
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, subTick
    x64.jmp ifcont
  subTick:
    x64.movRegImm32 r8, 9
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
