// Test: builtins-clock.ms-resolves-sub-tick
function main() returns ExitCode
	var smallest = 0
	var prev = __Builtins.currentTimeMs()
	var i = 0
	while i < 200000 'sample'
		let now = __Builtins.currentTimeMs()
		let delta = now - prev
		if delta > 0 'advanced'
			if smallest == 0 or delta < smallest 'newMin'
				smallest = delta
			end 'newMin'
			prev = now
		end 'advanced'
		i = i + 1
	end 'sample'
	if smallest > 0 and smallest < 5 'subTick'
		return 9
	end 'subTick'
	return 1
end 'main'
---
ExitCode: 9
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_current_gt@8 = i64 0
  __gt_run_queue_head@16 = i64 0
  __gt_run_queue_tail@24 = i64 0
  __gt_init_done@32 = i64 0
  __gt_system_stack_top@40 = i64 0
  __gt_timer_count@48 = i64 0
  __gt_timer_heap_base@56 = i64 0
  __gt_timer_capacity@64 = i64 0
  __gt_trace_counter@72 = i64 0
  __gt_trace_digits@80 = i64 0
  __gt_clock_ticks@88 = i64 0
  __gt_clock_freq@96 = i64 0
  __gt_proc_count@104 = i64 0
  __gt_proc_handles_base@112 = i64 0
  __gt_proc_gts_base@120 = i64 0
  __gt_live_count@128 = i64 0
  __slab_arena_list@136 = i64 0
  __slab_arena_map_l1@144 = i64 0
  __slab_state@152 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rbx, 0
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rcx, 1000000
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rcx
    x64.movRegImm32 r12, 0
    x64.movRegReg r13, r12
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 r13, 200000
    x64.jcc less, sample
    x64.jmp whileexit
  sample:
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rcx, 1000000
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg rcx, rax
    x64.subRegReg rcx, rax, r12
    x64.cmpRegImm32 rcx, 0
    x64.jcc greater, advanced
    x64.jmp critsplit#14
  advanced:
    x64.cmpRegImm32 rbx, 0
    x64.movRegImm32 rdx, 1
    x64.jcc equal, critsplit#16
    x64.jmp orrhs
  critsplit#16:
    x64.jmp scmerge#6
  orrhs:
    x64.cmpRegReg rcx, rbx
    x64.setccReg less, rdx
    x64.jmp scmerge#6
  scmerge#6:
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, newMin
    x64.jmp critsplit#17
  newMin:
    x64.jmp ifcont#8
  critsplit#17:
    x64.movRegReg rcx, rbx
    x64.jmp ifcont#8
  ifcont#8:
    x64.jmp ifcont#9
  critsplit#14:
    x64.movRegReg rcx, rbx
    x64.movRegReg rax, r12
    x64.jmp ifcont#9
  ifcont#9:
    x64.leaRegRegImm32 r13, r13, 1
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rax
    x64.jmp whilehdr
  whileexit:
    x64.cmpRegImm32 rbx, 0
    x64.movRegImm32 rax, 0
    x64.jcc greater, andrhs
    x64.jmp critsplit#15
  andrhs:
    x64.cmpRegImm32 rbx, 5
    x64.setccReg less, rax
    x64.jmp scmerge#11
  critsplit#15:
    x64.jmp scmerge#11
  scmerge#11:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, subTick
    x64.jmp ifcont#13
  subTick:
    x64.movRegImm32 r8, 9
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#13:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
