// Test: builtins-clock.nanos-monotonic
function main() returns ExitCode
	let a = __Builtins.currentTimeNanos()
	let b = __Builtins.currentTimeNanos()
	let c = __Builtins.currentTimeNanos()
	var score = 0
	if b >= a 'nondecreasing1'
		score = score + 1
	end 'nondecreasing1'
	if c >= b 'nondecreasing2'
		score = score + 1
	end 'nondecreasing2'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_timer_capacity@80 = i64 0
  __gt_trace_counter@88 = i64 0
  __gt_trace_digits@96 = i64 0
  __gt_clock_ticks@104 = i64 0
  __gt_clock_freq@112 = i64 0
  __gt_proc_count@120 = i64 0
  __gt_proc_handles_base@128 = i64 0
  __gt_proc_gts_base@136 = i64 0
  __gt_free_list_head@144 = i64 0
  __gt_live_count@152 = i64 0
  __gt_startup_base@160 = i64 0
  __gt_procinfo_base@168 = i64 0
  __gt_exitcode_base@176 = i64 0
  __gt_cmdline_buf_base@184 = i64 0
  __gt_cmdline_buf_cap@192 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.callDirect __gt_now_ns
    x64.movRegReg rbx, r8
    x64.callDirect __gt_now_ns
    x64.movRegReg r12, r8
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rax, 0
    x64.cmpRegReg r12, rbx
    x64.jcc greaterEqual, nondecreasing1
    x64.jmp critsplit#8
  nondecreasing1:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.jmp ifcont#2
  ifcont#2:
    x64.cmpRegReg r8, r12
    x64.jcc greaterEqual, nondecreasing2
    x64.jmp critsplit#9
  nondecreasing2:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#4
  critsplit#9:
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rcx, 4294967295
    x64.cmpRegReg rax, rcx
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.leaRegRegImm32 r8, rax, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
