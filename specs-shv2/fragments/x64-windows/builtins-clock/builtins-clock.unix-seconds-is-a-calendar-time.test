// Test: builtins-clock.unix-seconds-is-a-calendar-time
function main() returns ExitCode
	let now = __Builtins.currentUnixTimeSeconds()
	var score = 0
	if now > 1735689600 'afterKnownPast'
		score = score + 1
	end 'afterKnownPast'
	if now < 4102444800 'beforeFarFuture'
		score = score + 1
	end 'beforeFarFuture'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __clock_now_unix_s
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 r8, 1735689600
    x64.jcc greater, afterKnownPast
    x64.jmp critsplit#8
  afterKnownPast:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp ifcont#2
  critsplit#8:
    x64.jmp ifcont#2
  ifcont#2:
    x64.movRegImm32 rcx, 4102444800
    x64.cmpRegReg r8, rcx
    x64.jcc less, beforeFarFuture
    x64.jmp critsplit#9
  beforeFarFuture:
    x64.leaRegRegImm32 r8, rax, 1
    x64.jmp ifcont#4
  critsplit#9:
    x64.movRegReg r8, rax
    x64.jmp ifcont#4
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
