// Test: builtins-clock.wall-clock-is-not-the-monotonic-clock
function main() returns ExitCode
	let uptimeSeconds = __Builtins.currentTimeNanos() / 1000000000
	let wallSeconds = __Builtins.currentUnixTimeSeconds()
	if wallSeconds > uptimeSeconds + 1000000000 'differentEpochs'
		return 5
	end 'differentEpochs'
	return 1
end 'main'
---
ExitCode: 5
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __slab_arena_list@160 = i64 0
  __slab_arena_map_l1@168 = i64 0
  __slab_state@176 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rcx, 1000000000
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg rbx, rax
    x64.callDirect __clock_now_unix_s
    x64.leaRegRegImm32 rax, rbx, 1000000000
    x64.cmpRegReg r8, rax
    x64.jcc greater, differentEpochs
    x64.jmp ifcont
  differentEpochs:
    x64.movRegImm32 r8, 5
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
