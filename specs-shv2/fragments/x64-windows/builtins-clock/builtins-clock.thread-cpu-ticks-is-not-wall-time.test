    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic#6
  __rc_chk:
    x64.cmpRegImm32 rcx, 100000000
    x64.jcc lessEqual, __rc_ok#5
  __rc_panic#6:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at builtins-clock.thread-cpu-ticks-is-not-wall-time.test:5: Range check failed: value outside typealias 'SpinCount'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok#5:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 rax, 0
  forhdr:
    x64.cmpRegReg rax, rcx
    x64.jcc greaterEqual, forexit
  each:
    x64.leaRegRegReg r8, r8, rax
  forstep:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp forhdr
  forexit:
    x64.cmpRegImm32 r8, 0
