// Test: builtins-clock.nanos-advances
function main() returns ExitCode
	let start = __Builtins.currentTimeNanos()
	var spins = 0
	while spins < 200000 'burn'
		spins = spins + 1
	end 'burn'
	let elapsed = __Builtins.currentTimeNanos() - start
	if elapsed > 0 'advanced'
		return 7
	end 'advanced'
	return 1
end 'main'
---
ExitCode: 7
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
  __gt_current_gt@24 = i64 0
  __gt_run_queue_head@32 = i64 0
  __gt_run_queue_tail@40 = i64 0
  __gt_init_done@48 = i64 0
  __gt_system_stack_top@56 = i64 0
  __gt_timer_count@64 = i64 0
  __gt_timer_heap_base@72 = i64 0
  __gt_timer_capacity@80 = i64 0
  __gt_trace_counter@88 = i64 0
  __gt_trace_digits@96 = i64 0
  __gt_clock_ticks@104 = i64 0
  __gt_clock_freq@112 = i64 0
  __gt_proc_count@120 = i64 0
  __gt_proc_handles_base@128 = i64 0
  __gt_proc_gts_base@136 = i64 0
  __gt_free_list_head@144 = i64 0
  __gt_live_count@152 = i64 0
  __gt_startup_base@160 = i64 0
  __gt_procinfo_base@168 = i64 0
  __gt_exitcode_base@176 = i64 0
  __gt_cmdline_buf_base@184 = i64 0
  __gt_cmdline_buf_cap@192 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect __gt_now_ns
    x64.movRegReg rbx, r8
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 200000
    x64.jcc less, burn
    x64.jmp whileexit
  burn:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.callDirect __gt_now_ns
    x64.subRegReg r8, r8, rbx
    x64.cmpRegImm32 r8, 0
    x64.jcc greater, advanced
    x64.jmp ifcont
  advanced:
    x64.movRegImm32 r8, 7
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
