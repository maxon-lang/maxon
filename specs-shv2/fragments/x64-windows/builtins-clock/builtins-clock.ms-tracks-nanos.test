// Test: builtins-clock.ms-tracks-nanos
function main() returns ExitCode
	let ns = __Builtins.currentTimeNanos()
	let ms = __Builtins.currentTimeMs()
	let nsAsMs = ns / 1000000
	var score = 0
	if ms >= nsAsMs 'notBehind'
		score = score + 1
	end 'notBehind'
	if ms - nsAsMs < 50 'notAhead'
		score = score + 1
	end 'notAhead'
	return score as ExitCode
end 'main'
---
ExitCode: 2
---
data {
  __mm_alloc_count@0 = i64 0
  __gt_run_queue_head@8 = i64 0
  __gt_run_queue_tail@16 = i64 0
  __gt_init_done@24 = i64 0
  __gt_timer_count@32 = i64 0
  __gt_timer_heap_base@40 = i64 0
  __gt_timer_capacity@48 = i64 0
  __gt_trace_counter@56 = i64 0
  __gt_proc_count@64 = i64 0
  __gt_proc_handles_base@72 = i64 0
  __gt_proc_gts_base@80 = i64 0
  __gt_live_count@88 = i64 0
  __sched_active_workers@96 = i64 1
  __sched_max_active_workers@104 = i64 1
  __sched_tls_index@112 = i64 0
  __sched_tls_teb_offset@120 = i64 0
  __sched_procs@128 = i64 0
  __sched_num_procs@136 = i64 0
  __sched_shutdown_flag@144 = i64 0
  __sched_lock@152 = i64 0
  __slab_arena_list@160 = i64 0
  __slab_arena_map_l1@168 = i64 0
  __slab_state@176 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.callDirect __gt_now_ns
    x64.movRegReg rbx, r8
    x64.callDirect __gt_now_ns
    x64.movRegImm32 rcx, 1000000
    x64.movRegReg rax, r8
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg rcx, rax
    x64.movRegImm32 rsi, 1000000
    x64.movRegReg rax, rbx
    x64.cqo
    x64.idivReg rsi
    x64.movRegImm32 rdx, 0
    x64.cmpRegReg rcx, rax
    x64.jcc less, ifcont#2
  notBehind:
    x64.leaRegRegImm32 rdx, rdx, 1
  ifcont#2:
    x64.subRegReg rcx, rcx, rax
    x64.cmpRegImm32 rcx, 50
    x64.jcc greaterEqual, critsplit
  notAhead:
    x64.leaRegRegImm32 r8, rdx, 1
    x64.jmp ifcont#4
  critsplit:
    x64.movRegReg r8, rdx
  ifcont#4:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
