// Test: complex-expression
function main() returns ExitCode
	return 10 + 5 * 2
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 5
    x64.imulRegRegImm32 rax, rax, 2
    x64.leaRegRegImm32 r8, rax, 10
    x64.popReg rbp
    x64.ret
}
