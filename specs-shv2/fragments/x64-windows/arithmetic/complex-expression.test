// Test: complex-expression
function main() returns ExitCode
	return 10 + 5 * 2
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 2
    x64.imulRegReg rcx, rdx
    x64.movRegReg r8, rax
    x64.addRegReg r8, rcx
    x64.ret
}
