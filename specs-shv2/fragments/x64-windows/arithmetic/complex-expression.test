// Test: complex-expression
function main() returns ExitCode
	return 10 + 5 * 2
end 'main'
---
ExitCode: 20
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 5
    x64.movRegImm32 rdx, 2
    x64.movRegReg r9, rcx
    x64.imulRegReg r9, rdx
    x64.movRegReg r10, rax
    x64.addRegReg r10, r9
    x64.movRegReg r8, r10
    x64.ret
}
