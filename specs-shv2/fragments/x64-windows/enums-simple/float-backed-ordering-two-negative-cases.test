// Test: float-backed-ordering-two-negative-cases
enum FloatSigned
	below = -2.2
	mid = -1.1
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	if f < FloatSigned.mid 'lt'
		print("lt")
	end 'lt' else 'ge'
		print("ge")
	end 'ge'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm rax, 13835508415244900762
    x64.movRegImm rcx, 13831004815617530266
    x64.movqXmmGpr xmm0, rax
    x64.movqXmmGpr xmm1, rcx
    x64.ucomisdRegReg xmm1, xmm0
    x64.jcc above, lt
    x64.jmp ifelse
  lt:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect print
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
