// Test: simple-enum
enum Direction
	north
	south
	east
	west
end 'Direction'

function main() returns ExitCode
	let dir = Direction.north
	let result = match dir 'check'
		north gives 1
		south gives 0
		east gives 0
		west gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 1
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 0
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rax, 3
    x64.jcc equal, matcharm
    x64.jmp matchnext
  matcharm:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.popReg rbp
    x64.ret
  matchnext:
}
