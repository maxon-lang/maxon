// Test: float-backed-negative
enum FloatSigned
	below = -2.2
	zero = 0.0
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	let result = match f 'check'
		below gives 2
		zero gives 0
		above gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm rax, 13835508415244900762
    x64.movRegImm rcx, 13835508415244900762
    x64.cmpRegReg rax, rcx
    x64.jcc equal, matcharm#1
    x64.jmp matchnext#5
  matcharm#1:
    x64.movRegImm32 r8, 2
    x64.jmp matchcont
  matchnext#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, matcharm#2
    x64.jmp matchnext#6
  matcharm#2:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchnext#6:
    x64.movRegImm rcx, 4607632778762754458
    x64.cmpRegReg rax, rcx
    x64.jcc equal, matcharm#3
    x64.jmp matchdead
  matcharm#3:
    x64.movRegImm32 r8, 0
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
