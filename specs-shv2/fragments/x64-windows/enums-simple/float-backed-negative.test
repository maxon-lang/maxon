// Test: float-backed-negative
enum FloatSigned
	below = -2.2
	zero = 0.0
	above = 1.1
end 'FloatSigned'

function main() returns ExitCode
	let f = FloatSigned.below
	let result = match f 'check'
		below gives 2
		zero gives 0
		above gives 0
	end 'check'
	return result
end 'main'
---
ExitCode: 2
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
  matcharm:
    x64.movRegImm32 r8, 2
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]  ; "panic at float-backed-negative.test:15: Range check failed: value outside typealias 'ExitCode'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
