// Test: byte-enum-comparison.enum-coerces-to-byte-array-element

typealias Byte = int(0 to u8.max)
typealias ByteArray = Array with Byte

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function main() returns ExitCode
	var out = ByteArray.create()
	out.push(Ascii.space)
	out.push(Ascii.zero)
	let first = try out.get(0) otherwise 99
	let second = try out.get(1) otherwise 99
	if first == 32 and second == 48 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
