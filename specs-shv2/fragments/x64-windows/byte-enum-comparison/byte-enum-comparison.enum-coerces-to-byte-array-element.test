  trycont#6:
    x64.cmpRegImm32 r12, 32
    x64.movRegImm32 rcx, 0
    x64.jcc equal, andrhs
    x64.jmp critsplit#29
  andrhs:
    x64.cmpRegImm32 rax, 48
    x64.setccReg equal, rax
    x64.jmp scmerge
  critsplit#29:
