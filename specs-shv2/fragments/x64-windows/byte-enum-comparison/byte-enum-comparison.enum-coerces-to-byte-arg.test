// Test: byte-enum-comparison.enum-coerces-to-byte-arg

typealias Byte = int(0 to u8.max)

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function takesByte(b Byte) returns Byte
	return b
end 'takesByte'

function main() returns ExitCode
	let r = takesByte(Ascii.underscore)
	if r == 95 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
func @takesByte {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rcx, 255
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, rcx
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 95
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc less, __il_slow
  __rc_chk:
    x64.cmpRegImm32 rcx, 255
    x64.jcc lessEqual, __rc_ok
  __il_slow:
    x64.callDirect takesByte
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rcx
  __il_cont:
    x64.cmpRegImm32 r8, 95
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
