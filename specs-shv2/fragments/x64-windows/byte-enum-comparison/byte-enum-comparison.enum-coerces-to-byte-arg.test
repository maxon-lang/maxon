// Test: byte-enum-comparison.enum-coerces-to-byte-arg

typealias Byte = int(0 to u8.max)

enum Ascii
	underscore = 95
	space = 32
	zero = 48
end 'Ascii'

function takesByte(b Byte) returns Byte
	return b
end 'takesByte'

function main() returns ExitCode
	let r = takesByte(Ascii.underscore)
	if r == 95 'ok'
		return 0
	end 'ok'
	return 1
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 95
  __il_cont:
    x64.cmpRegImm32 rax, 95
    x64.jcc notEqual, ifcont
  ok:
    x64.movRegImm32 r8, 0
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 1
    x64.popReg rbp
    x64.ret
}
