// Test: forced-on-a-green-thread-across-a-stack-grow
typealias Count = int(0 to u64.max)

type Cache
	static var value = Cache.build()
	export var n as Count

	static function build() returns Cache
		print("built ")
		return Cache{n: 21}
	end 'build'

	export static function get() returns Count
		return Cache.value.n
	end 'get'
end 'Cache'

function deepThenRead(n int) returns int
	if n == 0 'base'
		return Cache.get() as int
	end 'base'
	return deepThenRead(n - 1)
end 'deepThenRead'

function main() returns ExitCode
	let p = async deepThenRead(200)
	let r = await p
	let q = async deepThenRead(150)
	let s = await q
	print("{r} {s}")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __data_Cache.value@0 = i64 0
  __mm_alloc_count@8 = i64 0
  __gt_current_gt@16 = i64 0
  __gt_run_queue_head@24 = i64 0
  __gt_run_queue_tail@32 = i64 0
  __gt_init_done@40 = i64 0
  __gt_system_stack_top@48 = i64 0
  __gt_timer_count@56 = i64 0
  __gt_timer_heap_base@64 = i64 0
  __gt_timer_capacity@72 = i64 0
  __gt_trace_counter@80 = i64 0
  __gt_trace_digits@88 = i64 0
  __gt_clock_ticks@96 = i64 0
  __gt_clock_freq@104 = i64 0
  __gt_proc_count@112 = i64 0
  __gt_proc_handles_base@120 = i64 0
  __gt_proc_gts_base@128 = i64 0
  __gt_live_count@136 = i64 0
  __slab_arena_list@144 = i64 0
  __slab_arena_map_l1@152 = i64 0
  __slab_state@160 = i64 0
}

func @Cache.build {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect print
    x64.movRegImm32 rbx, 21
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Cache.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __lazy_init#__data_Cache.value
    x64.leaRegGlobal rax, __data_Cache.value
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.loadRegBaseDisp.word64 r8, [rax + 0]
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @deepThenRead {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, base
    x64.jmp ifcont
  base:
    x64.callDirect Cache.get
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.leaRegRegImm32 rcx, rcx, -1
    x64.callDirect deepThenRead
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rbx, 200
    x64.leaRegFunc rcx, [rip + deepThenRead]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 200], rbx
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 150
    x64.leaRegFunc rcx, [rip + deepThenRead]
    x64.callDirect __gt_spawn
    x64.storeBaseDispReg.word64 [r8 + 200], r12
    x64.movRegReg rcx, r8
    x64.callDirect __gt_await
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot0, r13
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg rbx, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot4, rcx
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.callDirect __int_to_string
    x64.storeSlotReg slot3, r8
    x64.leaRegRegReg rax, rbx, r14
    x64.leaRegRegReg rax, rax, r8
    x64.storeSlotReg slot1, rax
    x64.leaRegRegImm32 rcx, rax, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot2, r8
    x64.leaRegRegImm32 r12, r8, 56
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.movRegReg rax, rbx
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, r12, rbx
    x64.movRegReg rcx, rbx
    x64.loadRegSlot rdx, slot4
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg rbx, rbx, r14
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.loadRegSlot r13, slot3
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, rbx, r13
    x64.loadRegSlot rbx, slot2
    x64.storeBaseDispReg.word64 [rbx + 0], r12
    x64.loadRegSlot rax, slot1
    x64.storeBaseDispReg.word64 [rbx + 8], rax
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [rbx + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [rbx + 24], rax
    x64.loadRegSlot rcx, slot0
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect print
    x64.movRegReg rcx, rbx
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 72
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
