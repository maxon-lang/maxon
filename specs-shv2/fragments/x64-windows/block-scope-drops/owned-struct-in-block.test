// Test: owned-struct-in-block
type Box
	var v as int

	static function create(v int) returns Box
		return Self{v: v}
	end 'create'
end 'Box'

function main() returns ExitCode
	var i = 0
	while i < 3 'loop'
		if i < 2 'b'
			let q = Box.create(i)
		end 'b'
		i = i + 1
	end 'loop'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 16
    x64.movRegImm32 rax, 0
    x64.jmp whilehdr
  whilehdr:
    x64.cmpRegImm32 rax, 3
    x64.jcc less, loop
    x64.jmp whileexit
  loop:
    x64.cmpRegImm32 rax, 2
    x64.jcc less, b
    x64.jmp ifcont
  b:
    x64.leaRegSlot rcx, slot0
    x64.storeBaseDispReg.word64 [rcx + 0], rax
    x64.jmp ifcont
  ifcont:
    x64.leaRegRegImm32 rax, rax, 1
    x64.jmp whilehdr
  whileexit:
    x64.movRegImm32 r8, 0
    x64.epilogue 16
    x64.popReg rbp
    x64.ret
}
