// Test: assignment-in-loop
function main() returns ExitCode
	var sum = 0
	var i = 1
	while i <= 5 'loop'
		sum = sum + i
		i = i + 1
	end 'loop'
	return sum
end 'main'
---
ExitCode: 15
---
func @main {
  entry:
    x64.movRegImm32 rax, 0
    x64.movRegImm32 rcx, 1
    x64.movRegReg r8, rax
    x64.jmp whilehdr
  whilehdr:
    x64.movRegImm32 rax, 5
    x64.cmpRegReg rcx, rax
    x64.jcc lessEqual, loop
    x64.jmp whileexit
  loop:
    x64.addRegReg r8, rcx
    x64.movRegImm32 rax, 1
    x64.addRegReg rcx, rax
    x64.jmp whilehdr
  whileexit:
    x64.ret
}
