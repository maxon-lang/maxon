// Test: multiple-assignments
function main() returns ExitCode
	var x = 10
	var y = 20
	x = y
	y = 30
	return x + y
end 'main'
---
ExitCode: 50
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 20
    x64.movRegImm32 rdx, 30
    x64.movRegReg r9, rcx
    x64.addRegReg r9, rdx
    x64.movRegReg r8, r9
    x64.ret
}
