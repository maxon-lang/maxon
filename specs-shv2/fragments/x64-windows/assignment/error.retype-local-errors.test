// Test: error.retype-local-errors

typealias Integer = int(i64.min to i64.max)

function main() returns ExitCode
	var x = 0 as Integer
	x = "hello"
	print("{x}")
	return 0 as ExitCode
end 'main'
---
CompilerError:
error E3005: <fragment>:7:2: cannot assign a value of type 'String' to variable 'x', which holds 'int'
