// Test: error.retype-enum-to-other-enum-errors

enum Color
	red
	green
end 'Color'

enum Shade
	dark
	light
end 'Shade'

function main() returns ExitCode
	var c = Color.red
	c = Shade.light
	return c.ordinal
end 'main'
---
CompilerError:
error E3005: <fragment>:15:2: cannot assign a value of type 'Shade' to variable 'c', which holds 'Color'
