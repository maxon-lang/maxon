// Test: static-method-statement.error.value-returning-static-is-still-refused
type Point
	export var x as ExitCode

	export static function create() returns Point
		return Self{x: 1}
	end 'create'
end 'Point'

function main() returns ExitCode
	Point.create()
	return 0
end 'main'
