// Test: abs.negative-int-as-float
function main() returns ExitCode
	let neg = -42.0
	let x = abs(neg)
	return trunc(x)
end 'main'
---
ExitCode: 42
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movsdRegRip xmm0, [rip + __fconst_0]
    x64.absF64RegReg xmm0, xmm0
    x64.cvttsd2siRegReg r8, xmm0
    x64.popReg rbp
    x64.ret
}
