// Test: stdlib-overlay-declaration-reaches-the-user-program
// --- stdlib-overlay: Builtins.maxon
export enum __OverlayProbe
	first
	second
end '__OverlayProbe'
// --- file: main.maxon
function rank(e __OverlayProbe) returns ExitCode
	return match e 'which'
		first gives 1
		second gives 42
	end 'which'
end 'rank'

function main() returns ExitCode
	return rank(__OverlayProbe.second)
end 'main'
---
ExitCode: 42
---
func @rank {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#1
    x64.jmp matchnext
  matcharm#1:
    x64.movRegImm32 r8, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#2
    x64.jmp matchdead
  matcharm#2:
    x64.movRegImm32 r8, 42
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r8, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.jmp __il_body
  __il_body:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, matcharm#3
    x64.jmp matchnext
  matcharm#3:
    x64.movRegImm32 rax, 1
    x64.jmp matchcont
  matchnext:
    x64.cmpRegImm32 rcx, 1
    x64.jcc equal, matcharm#4
    x64.jmp matchdead
  matcharm#4:
    x64.movRegImm32 rax, 42
    x64.jmp matchcont
  matchcont:
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rdx, 4294967295
    x64.cmpRegReg rax, rdx
    x64.jcc greater, __il_slow
    x64.jmp __rc_ok
  __il_slow:
    x64.callDirect rank
    x64.jmp __il_cont
  __rc_ok:
    x64.movRegReg r8, rax
    x64.jmp __il_cont
  __il_cont:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  matchdead:
}
