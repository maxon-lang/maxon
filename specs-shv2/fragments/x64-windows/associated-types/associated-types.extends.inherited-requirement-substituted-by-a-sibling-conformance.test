  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 72
    x64.movRegImm32 rcx, 8
    x64.callDirect Walker.create
    x64.movRegReg rbx, r8
    x64.storeSlotReg slot0, rbx
    x64.movRegReg rcx, rbx
    x64.callDirect Walker.retreat
  __il_body:
    x64.loadRegBaseDisp.word64 rbx, [rbx + 0]
  __il_cont:
