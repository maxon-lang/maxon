// Test: complex-expression
function main() returns ExitCode
	let a = 10
	let b = 3
	let result = (a + b) * 2 - a / b
	return result
end 'main'
---
ExitCode: 23
---
func @main {
  entry:
    x64.movRegImm32 rax, 10
    x64.movRegImm32 rcx, 3
    x64.leaRegRegImm32 rdx, rax, 3
    x64.imulRegRegImm32 r8, rdx, 2
    x64.cqo
    x64.idivReg rcx
    x64.subRegReg r8, r8, rax
    x64.ret
}
