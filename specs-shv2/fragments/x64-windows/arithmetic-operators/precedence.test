// Test: precedence
function main() returns ExitCode
	return 2 + 3 * 4
end 'main'
---
ExitCode: 14
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 rax, 3
    x64.imulRegRegImm32 rax, rax, 4
    x64.leaRegRegImm32 r8, rax, 2
    x64.popReg rbp
    x64.ret
}
