// Test: trunc-division-optimizes
function main() returns ExitCode
	return 20 / 3             // int/int = truncating int, returns 6
end 'main'
---
ExitCode: 6
---
func @main {
  entry:
    x64.movRegImm32 rax, 20
    x64.movRegImm32 rcx, 3
    x64.cqo
    x64.idivReg rcx
    x64.movRegReg r8, rax
    x64.ret
}
