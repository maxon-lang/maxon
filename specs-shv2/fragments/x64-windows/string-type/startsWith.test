// Test: startsWith
function main() returns ExitCode
	let s = "hello world"
	if s.startsWith("hello") 'c1'
		print("1\n")
	end 'c1'
	if s.startsWith("world") 'c2'
		print("0\n")
	end 'c2'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rbx, [rip + __str_rec_5]
    x64.leaRegRdata rdx, [rip + __str_rec_6]
    x64.movRegReg rcx, rbx
    x64.callDirect String.startsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c1
    x64.jmp ifcont#2
  c1:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect print
    x64.jmp ifcont#2
  ifcont#2:
    x64.leaRegRdata rdx, [rip + __str_rec_8]
    x64.movRegReg rcx, rbx
    x64.callDirect String.startsWith
    x64.cmpRegImm32 r8, 0
    x64.jcc notEqual, c2
    x64.jmp ifcont#4
  c2:
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.callDirect print
    x64.jmp ifcont#4
  ifcont#4:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
