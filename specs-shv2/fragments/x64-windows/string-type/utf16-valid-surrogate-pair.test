// Test: utf16-valid-surrogate-pair
function main() returns ExitCode
	if utf16IsValidSurrogatePair(55357, low: 56832) 'c14'
		print("1\n")  // valid pair
	end 'c14'
	if utf16IsValidSurrogatePair(56832, low: 55357) 'c15'
		print("0\n")  // reversed
	end 'c15'
	if utf16IsValidSurrogatePair(65, low: 66) 'c16'
		print("0\n")        // not surrogates
	end 'c16'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.movRegImm32 rcx, 55357
    x64.movRegImm32 rdx, 56832
    x64.callDirect utf16IsValidSurrogatePair
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#2
  c14:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.callDirect print
  ifcont#2:
    x64.movRegImm32 rcx, 56832
    x64.movRegImm32 rdx, 55357
    x64.callDirect utf16IsValidSurrogatePair
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#4
  c15:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
  ifcont#4:
    x64.movRegImm32 rcx, 65
    x64.movRegImm32 rdx, 66
    x64.callDirect utf16IsValidSurrogatePair
    x64.cmpRegImm32 r8, 0
    x64.jcc equal, ifcont#6
  c16:
    x64.leaRegRdata rcx, [rip + __str_rec_3]
    x64.callDirect print
  ifcont#6:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
