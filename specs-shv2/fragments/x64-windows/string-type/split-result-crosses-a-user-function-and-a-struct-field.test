  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rdx, [rip + __str_rec_1]
    x64.callDirect String.split
    x64.epilogue 32
    x64.popReg rbp
