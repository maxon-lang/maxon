    x64.movRegImm32 r8, 0
    x64.jcc greaterEqual, andrhs
    x64.jmp critsplit
  andrhs:
    x64.cmpRegImm32 rcx, 56319
    x64.setccReg lessEqual, r8
    x64.jmp scmerge
  critsplit:
    x64.jmp scmerge
  scmerge:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

