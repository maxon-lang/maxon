// Test: isEmpty-method
function main() returns ExitCode
	let empty = ""
	let nonempty = "hello"
	if empty.isEmpty() 'check1'
		print("1\n")
	end 'check1'
	if nonempty.isEmpty() 'check2'
		print("0\n")
	end 'check2' else 'not_empty'
		print("2\n")
	end 'not_empty'
	return 0
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegRdata rax, [rip + __str_rec_1]
    x64.leaRegRdata rbx, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, check1
    x64.jmp ifcont
  check1:
    x64.leaRegRdata rcx, [rip + __str_rec_5]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, check2
    x64.jmp ifelse
  check2:
    x64.leaRegRdata rcx, [rip + __str_rec_7]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifelse:
    x64.leaRegRdata rcx, [rip + __str_rec_9]
    x64.callDirect __print_string
    x64.jmp ifcont
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
