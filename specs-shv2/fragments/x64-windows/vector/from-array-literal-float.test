// Test: from-array-literal-float
function main() returns ExitCode
	let v = Vector from [1.5, 2.5]
	let a = try v.get(0) otherwise 0.0
	let b = try v.get(1) otherwise 0.0
	return trunc(a + b)
end 'main'
---
ExitCode: 4
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 48
    x64.storeSlotReg slot0, xmm6
    x64.storeSlotReg slot1, xmm7
    x64.movsdRegRip xmm6, [rip + __fconst_2]
    x64.movsdRegRip xmm7, [rip + __fconst_3]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movqGprXmm rdx, xmm6
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movqGprXmm rdx, xmm7
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 0
    x64.leaRegRdata rax, [rip + __layout_Vector_N2_float]
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.get
    x64.movqXmmGpr xmm6, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont#3
  tryerr#2:
    x64.movsdRegRip xmm6, [rip + __fconst_4]
  trycont#3:
    x64.movRegImm32 rdx, 1
    x64.leaRegRdata rax, [rip + __layout_Vector_N2_float]
    x64.movRegReg rcx, rbx
    x64.callDirect Vector.get
    x64.movqXmmGpr xmm0, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, trycont#6
  tryerr#5:
    x64.movsdRegRip xmm0, [rip + __fconst_4]
  trycont#6:
    x64.addsdRegReg xmm6, xmm6, xmm0
    x64.cvttsd2siRegReg r12, xmm6
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg r8, r12
    x64.loadRegSlot xmm6, slot0
    x64.loadRegSlot xmm7, slot1
    x64.epilogue 48
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
