// Test: opaque-owned-return-dropped-by-the-caller-immediately
type Holder uses Element
	export var value as Element

	export static function create(v Element) returns Self
		return Self{value: v}
	end 'create'

	export function remade() returns Element
		return fresh()
	end 'remade'
end 'Holder'

typealias TextHolder = Holder with String

function fresh() returns String
	return "a fresh string long enough to force a heap allocation"
end 'fresh'

function main() returns ExitCode
	let t = TextHolder.create("a held string long enough to force a heap allocation")
	var i = 0
	while i < 100 'spin'
		t.remade()
		i = i + 1
	end 'spin'
	print("done\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @Holder.remade {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect fresh
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @fresh {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "a fresh string long enough to force a heap allocation"
    x64.callDirect __str_retain
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.leaRegRdata rax, [rip + __str_rec_4]  ; "a held string long enough to force a heap allocation"
    x64.loadRegBaseDisp.word64 rbx, [rax + 0]
    x64.loadRegBaseDisp.word64 r12, [rax + 8]
    x64.leaRegRegImm32 rcx, r12, 57
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.leaRegRegImm32 r14, r13, 56
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r14, r12
    x64.storeBaseDispReg.word64 [r13 + 0], r14
    x64.storeBaseDispReg.word64 [r13 + 8], r12
    x64.movRegImm rax, 18446744073709551613
    x64.storeBaseDispReg.word64 [r13 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r13 + 24], rax
    x64.movRegReg rcx, r13
    x64.callDirect Holder.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 r12, 0
  whilehdr:
    x64.cmpRegImm32 r12, 100
    x64.jcc greaterEqual, whileexit
  spin:
    x64.leaRegRdata rdx, [rip + __layout_Holder_String]
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.remade
    x64.movRegReg rcx, r8
    x64.callDirect __str_decref
    x64.leaRegRegImm32 r12, r12, 1
    x64.jmp whilehdr
  whileexit:
    x64.leaRegRdata rcx, [rip + __str_rec_5]  ; "done\x0a"
    x64.callDirect print
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Holder_String
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
