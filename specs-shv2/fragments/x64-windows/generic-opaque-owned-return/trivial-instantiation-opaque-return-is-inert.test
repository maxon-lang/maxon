// Test: trivial-instantiation-opaque-return-is-inert
typealias Integer = int(i64.min to i64.max)

type Holder uses Element
	export var value as Element

	export static function create(v Element) returns Self
		return Self{value: v}
	end 'create'

	export function get() returns Element
		return self.value
	end 'get'

	export function remade() returns Element
		return 7
	end 'remade'
end 'Holder'

typealias IntHolder = Holder with Integer

function main() returns ExitCode
	let t = IntHolder.create(5)
	print("{t.get()} {t.remade()}\n")
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @Holder.get {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.loadRegBaseDisp.word64 rax, [rcx + 0]
    x64.movRegReg rcx, rdx
    x64.movRegReg rdx, rax
    x64.callDirect __retain_type_param
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @Holder.remade {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.movRegImm32 r8, 7
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 104
    x64.movRegImm32 rax, 5
    x64.leaRegSlot rbx, slot0
    x64.storeBaseDispReg.word64 [rbx + 0], rax
    x64.leaRegRdata rdx, [rip + __layout_Holder_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.get
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r13, r8
    x64.storeSlotReg slot1, r13
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r13
    x64.callDirect __int_to_string
    x64.movRegReg r12, r8
    x64.leaRegRdata rax, [rip + __str_rec_2]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot7, rcx
    x64.loadRegBaseDisp.word64 r14, [rax + 8]
    x64.leaRegRdata rdx, [rip + __layout_Holder_Integer]
    x64.movRegReg rcx, rbx
    x64.callDirect Holder.remade
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 21
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.movRegReg r15, r8
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.callDirect __int_to_string
    x64.storeSlotReg slot6, r8
    x64.leaRegRdata rax, [rip + __str_rec_3]
    x64.loadRegBaseDisp.word64 rcx, [rax + 0]
    x64.storeSlotReg slot5, rcx
    x64.loadRegBaseDisp.word64 rax, [rax + 8]
    x64.storeSlotReg slot4, rax
    x64.leaRegRegReg rcx, r12, r14
    x64.leaRegRegReg rcx, rcx, r8
    x64.leaRegRegReg rax, rcx, rax
    x64.storeSlotReg slot2, rax
    x64.leaRegRegImm32 rcx, rax, 49
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeSlotReg slot3, r8
    x64.leaRegRegImm32 rbx, r8, 48
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.movRegReg rax, r12
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, rbx, r12
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot7
    x64.movRegReg rax, r14
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r14
    x64.movRegReg rcx, r12
    x64.movRegReg rdx, r15
    x64.loadRegSlot r13, slot6
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg r12, r12, r13
    x64.movRegReg rcx, r12
    x64.loadRegSlot rdx, slot5
    x64.loadRegSlot r13, slot4
    x64.movRegReg rax, r13
    x64.callDirect __str_copy
    x64.leaRegRegReg rax, r12, r13
    x64.loadRegSlot r12, slot3
    x64.storeBaseDispReg.word64 [r12 + 0], rbx
    x64.loadRegSlot rax, slot2
    x64.storeBaseDispReg.word64 [r12 + 8], rax
    x64.movRegImm rax, -3
    x64.storeBaseDispReg.word64 [r12 + 16], rax
    x64.movRegImm32 rax, 1
    x64.storeBaseDispReg.word64 [r12 + 24], rax
    x64.loadRegSlot rcx, slot1
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r15
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect print
    x64.movRegReg rcx, r12
    x64.callDirect __str_decref
    x64.movRegImm32 r8, 0
    x64.epilogue 104
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @print {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __write_stdout
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}
