// Test: if-statements.else-false
function main() returns ExitCode
	let x = 3
	if x > 5 'gt5'
		return 1
	end 'gt5' else 'not_gt5'
		return 0
	end 'not_gt5'
end 'main'
---
ExitCode: 0
---
func @main {
  entry:
    x64.movRegImm32 rax, 3
    x64.movRegImm32 rcx, 5
    x64.cmpRegReg rax, rcx
    x64.jcc greater, gt5
    x64.jmp ifelse
  gt5:
    x64.movRegImm32 r8, 1
    x64.ret
  ifelse:
    x64.movRegImm32 r8, 0
    x64.ret
  ifcont:
}
