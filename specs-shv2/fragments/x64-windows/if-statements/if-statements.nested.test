// Test: if-statements.nested
function main() returns ExitCode
	let x = 3
	if x == 1 'outer'
		return 1
	end 'outer' else 'else_outer'
		if x == 2 'inner'
			return 2
		end 'inner' else 'else_inner'
			return 3
		end 'else_inner'
	end 'else_outer'
end 'main'
---
ExitCode: 3
---
func @main {
  entry:
    x64.movRegImm32 rax, 3
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, outer
    x64.jmp ifelse
  outer:
    x64.movRegImm32 r8, 1
    x64.ret
  ifelse:
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, inner
    x64.jmp ifelse
  inner:
    x64.movRegImm32 r8, 2
    x64.ret
  ifelse:
    x64.movRegImm32 r8, 3
    x64.ret
  ifcont:
  ifcont:
}
