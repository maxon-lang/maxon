// Test: for-in-walks-both-arrays-in-one-program
typealias Num = int(0 to 1000)

type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Array'

typealias NumArray = Array with Num

function main() returns ExitCode
	var mine = NumArray.create()
	mine.push(4 as Num)
	mine.push(5 as Num)

	var total = 0
	for n in mine 'ownLoop'
		total = total + n
	end 'ownLoop'

	for part in "a,bb,ccc".split(",") 'librarysLoop'
		total = total + part.byteLength()
	end 'librarysLoop'

	return total as ExitCode
end 'main'
---
ExitCode: 15
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 5
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 r12, 0
    x64.movRegImm32 r13, 0
    x64.jmp forhdr#1
  forhdr#1:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegReg r13, rax
    x64.jcc less, ownLoop
    x64.jmp forexit#4
  ownLoop:
    x64.loadRegBaseDisp.word64 rax, [rbx + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word#14
    x64.jmp __im_stride#16
  __im_word#14:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseIndexScale.word64 rax, [rax + r13*8 + 0]
    x64.jmp __il_cont#12
  __im_stride#16:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte#15
    x64.jmp __il_slow#13
  __im_byte#15:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.leaRegRegReg rax, rax, r13
    x64.loadRegBaseDisp.byte rax, [rax + 0]
    x64.jmp __il_cont#12
  __il_slow#13:
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rax, r8
    x64.jmp __il_cont#12
  __il_cont#12:
    x64.leaRegRegReg r12, r12, rax
    x64.jmp forstep#3
  forstep#3:
    x64.leaRegRegImm32 r13, r13, 1
    x64.jmp forhdr#1
  forexit#4:
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect String.split
    x64.movRegReg r13, r8
    x64.movRegImm32 r14, 0
    x64.jmp forhdr#5
  forhdr#5:
    x64.loadRegBaseDisp.word64 rax, [r13 + 8]
    x64.cmpRegReg r14, rax
    x64.jcc less, librarysLoop
    x64.jmp forexit#8
  librarysLoop:
    x64.loadRegBaseDisp.word64 rax, [r13 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc equal, __im_word#19
    x64.jmp __im_stride#21
  __im_word#19:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.loadRegBaseIndexScale.word64 rcx, [rax + r14*8 + 0]
    x64.jmp __il_cont#17
  __im_stride#21:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte#20
    x64.jmp __il_slow#18
  __im_byte#20:
    x64.loadRegBaseDisp.word64 rax, [r13 + 0]
    x64.leaRegRegReg rax, rax, r14
    x64.loadRegBaseDisp.byte rcx, [rax + 0]
    x64.jmp __il_cont#17
  __il_slow#18:
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r14
    x64.callDirect __managed_get_unchecked
    x64.movRegReg rcx, r8
    x64.jmp __il_cont#17
  __il_cont#17:
    x64.callDirect String.byteLength
    x64.leaRegRegReg r12, r12, r8
    x64.jmp forstep#7
  forstep#7:
    x64.leaRegRegImm32 r14, r14, 1
    x64.jmp forhdr#5
  forexit#8:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_9]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
