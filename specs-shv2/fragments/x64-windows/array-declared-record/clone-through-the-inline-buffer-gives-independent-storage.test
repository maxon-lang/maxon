// Test: clone-through-the-inline-buffer-gives-independent-storage
typealias Num = int(0 to 1000)

type Array uses Element implements BuiltinArrayLiteral, Cloneable
	typealias ElementMemory = __ManagedMemory with Element
	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'

	export function clone() returns Self
		let len = managed.length()
		let copy = try managed.slice(0, len) otherwise panic("clone: 0..len is always in range")
		return Self{managed: copy}
	end 'clone'
end 'Array'

typealias NumArray = Array with Num

function main() returns ExitCode
	var a = NumArray.create()
	a.push(300 as Num)
	a.push(301 as Num)
	var b = a.clone()
	b.push(302 as Num)
	let borrowed = try b.get(1) otherwise return 1
	if borrowed != 301 'stride'
		return 2
	end 'stride'
	if a.count() != 2 'sourceGrew'
		return 3
	end 'sourceGrew'
	return b.count() as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Array.clone {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegReg rbx, rdx
    x64.loadRegBaseDisp.word64 r12, [rcx + 8]
    x64.callDirect __mm_retain
    x64.movRegReg r13, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r13
    x64.movRegReg rax, r12
    x64.movRegReg r9, rbx
    x64.callDirect __managed_slice_opaque
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r13
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_retain
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.movRegImm32 rcx, 2
    x64.movRegImm32 rdx, 0
    x64.callDirect __managed_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 300
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 301
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_push
    x64.leaRegRdata rdx, [rip + __layout_Array_Num]
    x64.movRegReg rcx, rbx
    x64.callDirect Array.clone
    x64.movRegReg r12, r8
    x64.movRegImm32 rdx, 302
    x64.movRegReg rcx, r12
    x64.callDirect __managed_push
    x64.movRegImm32 rdx, 1
    x64.loadRegBaseDisp.word64 rax, [r12 + 24]
    x64.cmpRegImm32 rax, 8
    x64.jcc notEqual, __im_stride
  __im_word:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, __il_slow
  __im_load#16:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegImm32 rax, rax, 8
    x64.loadRegBaseDisp.word64 rax, [rax + 0]
    x64.jmp __im_loaded
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc notEqual, __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r12 + 8]
    x64.cmpRegImm32 rax, 1
    x64.jcc lessEqual, __il_slow
  __im_load#17:
    x64.loadRegBaseDisp.word64 rax, [r12 + 0]
    x64.leaRegRegImm32 rax, rax, 1
    x64.loadRegBaseDisp.byte rax, [rax + 0]
  __im_loaded:
    x64.movRegImm32 rcx, 0
    x64.loadRegBaseDisp.word64 rsi, [r12 + 40]
    x64.cmpRegImm32 rsi, 0
    x64.jcc equal, __il_cont
  __im_empty:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_cont
  __il_slow:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_get
    x64.movRegReg rax, r8
    x64.movRegReg rcx, r10
  __il_cont:
    x64.cmpRegImm32 rcx, 0
    x64.jcc equal, tryok
  tryerr:
    x64.movRegImm32 r13, 1
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.cmpRegImm32 rax, 301
    x64.jcc equal, ifcont#4
  stride:
    x64.movRegImm32 r13, 2
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.loadRegBaseDisp.word64 rax, [rbx + 8]
    x64.cmpRegImm32 rax, 2
    x64.jcc equal, ifcont#6
  sourceGrew:
    x64.movRegImm32 r13, 3
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#6:
    x64.loadRegBaseDisp.word64 r13, [r12 + 8]
    x64.cmpRegImm32 r13, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r13, rax
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_1]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, r12
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r13
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
