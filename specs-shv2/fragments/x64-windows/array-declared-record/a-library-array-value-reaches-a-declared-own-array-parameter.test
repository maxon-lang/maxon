// Test: a-library-array-value-reaches-a-declared-own-array-parameter
type Array uses Element implements BuiltinArrayLiteral
	typealias ElementMemory = __ManagedMemory with Element

	export var managed as ElementMemory

	export static function init(managed ElementMemory) returns Self
		return Self{managed: managed}
	end 'init'

	export static function create() returns Self
		return Self{}
	end 'create'
end 'Array'

typealias MyStrings = Array with String

function takesMine(parts MyStrings) returns int
	return parts.count()
end 'takesMine'

function main() returns ExitCode
	let s = "a,b,c"
	return takesMine(s.split(",")) as ExitCode
end 'main'
---
ExitCode: 3
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @takesMine {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __str_rec_2]
    x64.leaRegRdata rdx, [rip + __str_rec_3]
    x64.callDirect String.split
    x64.movRegReg rbx, r8
    x64.movRegReg rcx, rbx
    x64.callDirect takesMine
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_9]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.clone {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegReg rbx, rcx
    x64.movRegImm32 r12, 0
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r12
    x64.movRegReg rax, r8
    x64.callDirect String.sliceBytes
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.byteLength {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.loadRegBaseDisp.word64 r8, [rcx + 8]
    x64.popReg rbp
    x64.ret
}

func @String.byteAt {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.prologue 32
    x64.callDirect __managed_byte_at
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegImm32 r10, 0
    x64.cmpRegImm32 r8, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.cmpRegImm32 r8, 255
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_10]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.epilogue 32
    x64.popReg rbp
    x64.ret
}

func @String.sliceBytes {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegReg rbx, rdx
    x64.movRegReg r12, rax
    x64.movRegReg r13, r9
    x64.callDirect __str_bytes_view
    x64.movRegReg r14, r8
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, rbx
    x64.movRegReg rax, r12
    x64.callDirect __managed_slice
    x64.movRegReg rbx, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_4]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
    x64.movRegReg rcx, r14
    x64.callDirect __managed_decref
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r13
    x64.callDirect __str_of_buffer
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __managed_decref
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @String.split {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegImm32 rcx, 8
    x64.leaRegFunc rdx, [rip + __str_decref]
    x64.callDirect __managed_create
    x64.movRegReg r13, r8
    x64.storeSlotReg slot0, r13
    x64.movRegReg rcx, r12
    x64.callDirect String.byteLength
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r14, 0
    x64.jcc equal, empty_delim
    x64.jmp ifcont#2
  empty_delim:
    x64.movRegReg rcx, rbx
    x64.callDirect String.clone
    x64.movRegReg rcx, r13
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg r8, r13
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteLength
    x64.movRegReg r13, r8
    x64.movRegImm32 r15, 0
    x64.jmp whilehdr
  whilehdr:
    x64.movRegReg rax, r13
    x64.subRegReg rax, r13, r14
    x64.cmpRegReg r15, rax
    x64.jcc lessEqual, search
    x64.jmp critsplit
  search:
    x64.movRegReg rax, r13
    x64.subRegReg rax, r13, r15
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg r9, r12
    x64.callDirect findIn
    x64.cmpRegImm32 r10, 0
    x64.jcc equal, try_find
    x64.jmp ifelse
  try_find:
    x64.leaRegRegReg rax, r15, r8
    x64.storeSlotReg slot1, rax
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.loadRegSlot r15, slot1
    x64.movRegReg rax, r15
    x64.callDirect String.sliceBytes
    x64.loadRegSlot rcx, slot0
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.leaRegRegReg r15, r15, r14
    x64.jmp ifcont#8
  ifcont#8:
    x64.jmp whilehdr
  ifelse:
    x64.jmp whileexit
  critsplit:
    x64.jmp whileexit
  whileexit:
    x64.loadRegBaseDisp.byte r9, [rbx + 48]
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r15
    x64.movRegReg rax, r13
    x64.callDirect String.sliceBytes
    x64.loadRegSlot rbx, slot0
    x64.movRegReg rcx, rbx
    x64.movRegReg rdx, r8
    x64.callDirect __managed_push
    x64.movRegReg r8, rbx
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @bytesEqual {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.storeSlotReg slot2, rax
    x64.movRegReg r13, r9
    x64.movRegReg r14, rsi
    x64.movRegImm32 r15, 0
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot0, r15
    x64.cmpRegReg r15, r14
    x64.jcc less, compare_loop
    x64.jmp forexit
  compare_loop:
    x64.leaRegRegReg rdx, r12, r15
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteAt
    x64.storeSlotReg slot1, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_5]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.leaRegRegReg rdx, r13, r15
    x64.loadRegSlot rcx, slot2
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#8
    x64.jmp tryok#7
  tryerr#8:
    x64.leaRegRdata rcx, [rip + __str_blob_6]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#7:
    x64.loadRegSlot rax, slot1
    x64.cmpRegReg rax, r8
    x64.jcc notEqual, byte_check
    x64.jmp ifcont
  byte_check:
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.jmp forstep
  forstep:
    x64.loadRegSlot rax, slot0
    x64.leaRegRegImm32 rax, rax, 1
    x64.movRegReg r15, rax
    x64.jmp forhdr
  forexit:
    x64.movRegImm32 r8, 1
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @findIn {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.pushReg r15
    x64.prologue 56
    x64.movRegReg rbx, rcx
    x64.movRegReg r12, rdx
    x64.movRegReg r13, rax
    x64.movRegReg r14, r9
    x64.storeSlotReg slot2, r14
    x64.movRegReg rcx, r14
    x64.callDirect String.byteLength
    x64.movRegReg r15, r8
    x64.storeSlotReg slot1, r15
    x64.cmpRegImm32 r15, 0
    x64.jcc equal, empty_needle
    x64.jmp ifcont#2
  empty_needle:
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#2:
    x64.cmpRegReg r15, r13
    x64.jcc greater, too_long
    x64.jmp ifcont#4
  too_long:
    x64.movRegImm32 rax, 0
    x64.leaRegRegImm32 r10, rax, 1
    x64.movRegImm32 r8, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont#4:
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, r14
    x64.callDirect String.byteAt
    x64.movRegReg r14, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#6
    x64.jmp tryok#5
  tryerr#6:
    x64.leaRegRdata rcx, [rip + __str_blob_7]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#5:
    x64.movRegImm32 rax, 0
    x64.subRegReg r13, r13, r15
    x64.movRegReg r15, rax
    x64.jmp forhdr
  forhdr:
    x64.storeSlotReg slot0, r15
    x64.cmpRegReg r15, r13
    x64.jcc lessEqual, search_loop
    x64.jmp forexit
  search_loop:
    x64.leaRegRegReg rdx, r12, r15
    x64.movRegReg rcx, rbx
    x64.callDirect String.byteAt
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr#12
    x64.jmp tryok#11
  tryerr#12:
    x64.leaRegRdata rcx, [rip + __str_blob_8]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.movRegImm32 r10, 0
    x64.epilogue 56
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok#11:
    x64.cmpRegReg r8, r14
    x64.jcc equal, firstByteMatch
    x64.jmp ifcont#16
  firstByteMatch:
    x64.leaRegRegReg rdx, r12, r15
    x64.movRegImm32 r9, 0
    x64.movRegReg rcx, rbx
