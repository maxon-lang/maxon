// Test: struct-equality-needs-no-conformance
typealias Count = int(0 to 100)

type Box
	export let n as Count

	export static function make(n Count) returns Box
		return Box{n: n}
	end 'make'

	export function equals(other Box) returns bool
		return n == other.n
	end 'equals'
end 'Box'

function main() returns ExitCode
	let a = Box.make(1)
	let b = Box.make(1)
	let c = Box.make(2)
	if a == b 'eq'
		print("equal\n")
	end 'eq'
	if a != c 'neq'
		print("not equal\n")
	end 'neq'
	return 0
end 'main'
---
ExitCode: 0
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @Box.make {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.movRegReg rbx, rcx
    x64.cmpRegImm32 rbx, 0
    x64.jcc less, __rc_panic
  __rc_chk:
    x64.cmpRegImm32 rbx, 100
    x64.jcc lessEqual, __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_4]  ; "panic at struct-equality-needs-no-conformance.test:7: Range check failed: value outside typealias 'Count'\x0a"
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.pushReg r14
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.callDirect Box.make
    x64.movRegReg rbx, r8
    x64.movRegImm32 rcx, 1
    x64.callDirect Box.make
    x64.movRegReg r12, r8
    x64.movRegImm32 rcx, 2
    x64.callDirect Box.make
    x64.movRegReg r13, r8
  __il_body#6:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [r12 + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rax
  __il_cont#5:
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_body#8
  eq:
    x64.leaRegRdata rcx, [rip + __str_rec_2]  ; "equal\x0a"
    x64.callDirect print
  __il_body#8:
    x64.loadRegBaseDisp.word64 rax, [rbx + 0]
    x64.loadRegBaseDisp.word64 rcx, [r13 + 0]
    x64.cmpRegReg rax, rcx
    x64.setccReg equal, rax
  __il_cont#7:
    x64.xorRegImm32 rax, rax, 1
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, ifcont
  neq:
    x64.leaRegRdata rcx, [rip + __str_rec_3]  ; "not equal\x0a"
    x64.callDirect print
  ifcont:
    x64.movRegImm32 r14, 0
    x64.movRegReg rcx, r13
    x64.callDirect __mm_decref
    x64.movRegReg rcx, r12
    x64.callDirect __mm_decref
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r14
    x64.epilogue 32
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
