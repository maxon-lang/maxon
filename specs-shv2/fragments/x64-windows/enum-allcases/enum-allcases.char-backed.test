// Test: enum-allcases.char-backed
enum Grade
	a = 'A'
	b = 'B'
	c = 'C'
end 'Grade'

function main() returns ExitCode
	for g in Grade.allCases 'loop'
		print("{g.rawValue}")
	end 'loop'
	return 0
end 'main'
---
ExitCode: 0
---
