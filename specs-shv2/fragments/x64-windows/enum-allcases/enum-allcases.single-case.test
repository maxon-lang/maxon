// Test: enum-allcases.single-case
enum Singleton
	only
end 'Singleton'

function main() returns ExitCode
	let count = Singleton.allCases.count()
	if count == 1 'check'
		return 1
	end 'check'
	return 0
end 'main'
---
ExitCode: 1
---
data {
  __slab_cursor@0 = i64 0
  __slab_end@8 = i64 0
  __mm_alloc_count@16 = i64 0
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.movRegImm32 rcx, 1
    x64.movRegImm32 rdx, 0
    x64.callDirect __arr_create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 0
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_push
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_count
    x64.movRegReg r12, r8
    x64.movRegReg rcx, rbx
    x64.callDirect __arr_decref
    x64.cmpRegImm32 r12, 1
    x64.jcc equal, check
    x64.jmp ifcont
  check:
    x64.movRegImm32 r8, 1
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  ifcont:
    x64.movRegImm32 r8, 0
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
