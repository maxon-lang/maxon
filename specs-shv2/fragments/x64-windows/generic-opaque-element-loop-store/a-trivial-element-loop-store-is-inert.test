  whileexit:
    x64.movRegReg rcx, r14
    x64.movRegReg rdx, r13
    x64.callDirect __drop_type_param
    x64.epilogue 40
    x64.popReg r15
    x64.popReg r14
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

