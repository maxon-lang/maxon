func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.prologue 32
    x64.leaRegRdata rcx, [rip + __layout_Bag_Num]
    x64.callDirect Bag.create
    x64.movRegReg rbx, r8
    x64.movRegImm32 rdx, 4
    x64.movRegImm32 rax, 9
    x64.leaRegRdata r9, [rip + __layout_Bag_Num]
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.fillTo
    x64.movRegImm32 rdx, 3
    x64.leaRegRdata rax, [rip + __layout_Bag_Num]
    x64.movRegReg rcx, rbx
    x64.callDirect Bag.at
    x64.movRegReg r12, r8
    x64.cmpRegImm32 r10, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.movRegImm32 r12, 1
    x64.movRegReg rcx, rbx
    x64.callDirect __destruct_Bag_Num
    x64.movRegReg r8, r12
    x64.epilogue 32
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  tryok:
