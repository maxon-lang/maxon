    x64.storeBaseDispReg.word64 [rax + 0], r8
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __im_stride:
    x64.cmpRegImm32 rax, 1
    x64.jcc equal, __im_byte
    x64.jmp __il_slow
  __im_byte:
    x64.loadRegBaseDisp.word64 rax, [r15 + 40]
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_bounds#16
  __im_bounds#16:
    x64.loadRegBaseDisp.word64 rax, [r15 + 8]
    x64.loadRegSlot rcx, slot0
    x64.cmpRegImm32 rcx, 0
    x64.setccReg less, rdx
    x64.cmpRegReg rcx, rax
    x64.setccReg greaterEqual, rax
    x64.orRegReg rdx, rdx, rax
    x64.cmpRegImm32 rdx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_owned#17
  __im_owned#17:
    x64.loadRegBaseDisp.word64 rax, [r15 + 16]
    x64.cmpRegImm32 rax, 0
    x64.jcc less, __il_slow
    x64.jmp __im_buffer#18
  __im_buffer#18:
    x64.loadRegBaseDisp.word64 rax, [r15 + 0]
    x64.cmpRegImm32 rax, 0
    x64.jcc equal, __il_slow
    x64.jmp __im_viewed#19
  __im_viewed#19:
    x64.leaRegRegImm32 rcx, rax, -24
    x64.loadRegBaseDisp.word64 rcx, [rcx + 16]
    x64.cmpRegImm32 rcx, 0
    x64.jcc notEqual, __il_slow
    x64.jmp __im_store#20
  __im_store#20:
    x64.loadRegSlot rcx, slot0
    x64.leaRegRegReg rax, rax, rcx
    x64.storeBaseDispReg.byte [rax + 0], r8
    x64.movRegImm32 rax, 0
    x64.jmp __il_cont
  __il_slow:
    x64.movRegReg rcx, r15
    x64.loadRegSlot rdx, slot0
    x64.movRegReg rax, r8
    x64.callDirect __managed_set
    x64.movRegReg rax, r10
    x64.jmp __il_cont
  __il_cont:
    x64.cmpRegImm32 rax, 0
    x64.jcc notEqual, tryerr
    x64.jmp tryok
  tryerr:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
