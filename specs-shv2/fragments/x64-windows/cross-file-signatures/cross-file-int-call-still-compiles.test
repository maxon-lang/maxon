// Test: cross-file-int-call-still-compiles
// --- file: a.maxon
typealias Integer = int(i64.min to i64.max)

export function crossFileInt() returns Integer
	return 41
end 'crossFileInt'

// --- file: b.maxon
function main() returns ExitCode
	return crossFileInt() + 1
end 'main'
---
ExitCode: 42
---
func @crossFileInt {
  entry:
    x64.movRegImm32 r8, 41
    x64.ret
}

func @main {
  entry:
    x64.prologue 40
    x64.callDirect crossFileInt
    x64.leaRegRegImm32 r8, r8, 1
    x64.epilogue 40
    x64.ret
}
