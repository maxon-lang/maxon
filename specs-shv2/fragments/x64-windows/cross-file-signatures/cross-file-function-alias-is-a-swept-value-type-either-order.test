// Test: cross-file-function-alias-is-a-swept-value-type-either-order
// --- file: main.maxon
function twice(n Int) returns Int
	return n * 2
end 'twice'

type Holder
	export var op as UnaryOp

	export static function create() returns Holder
		return Self{op: twice}
	end 'create'
end 'Holder'

function pick() returns UnaryOp
	return twice
end 'pick'

function main() returns ExitCode
	let h = Holder.create()
	let f = pick()
	return (h.op(7) + f(14)) as ExitCode
end 'main'

// --- file: alias.maxon
export typealias Int = int(i64.min to i64.max)
export typealias UnaryOp = function(Int) returns Int
---
ExitCode: 42
---
data {
  __mm_alloc_count@0 = i64 0
  __slab_arena_list@8 = i64 0
  __slab_arena_map_l1@16 = i64 0
  __slab_state@24 = i64 0
}

func @twice {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.imulRegRegImm32 r8, rcx, 2
    x64.popReg rbp
    x64.ret
}

func @Holder.create {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.prologue 40
    x64.leaRegFunc rbx, [rip + __fnref_twice]
    x64.movRegImm32 rcx, 8
    x64.movRegImm32 rdx, 0
    x64.callDirect __mm_alloc
    x64.storeBaseDispReg.word64 [r8 + 0], rbx
    x64.epilogue 40
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}

func @main {
  entry:
    x64.pushReg rbp
    x64.movRegReg rbp, rsp
    x64.pushReg rbx
    x64.pushReg r12
    x64.pushReg r13
    x64.prologue 40
    x64.callDirect Holder.create
    x64.movRegReg rbx, r8
    x64.jmp __il_body
  __il_body:
    x64.leaRegFunc r12, [rip + __fnref_twice]
    x64.jmp __il_cont
  __il_cont:
    x64.loadRegBaseDisp.word64 r13, [rbx + 0]
    x64.movRegImm32 rcx, 7
    x64.movRegImm32 rdx, 0
    x64.callReg r13
    x64.movRegReg r13, r8
    x64.movRegImm32 rcx, 14
    x64.movRegImm32 rdx, 0
    x64.callReg r12
    x64.leaRegRegReg r12, r13, r8
    x64.cmpRegImm32 r12, 0
    x64.jcc less, __rc_panic
    x64.jmp __rc_chk
  __rc_chk:
    x64.movRegImm32 rax, 4294967295
    x64.cmpRegReg r12, rax
    x64.jcc greater, __rc_panic
    x64.jmp __rc_ok
  __rc_panic:
    x64.leaRegRdata rcx, [rip + __str_blob_0]
    x64.callDirect mrt_panic
    x64.movRegImm32 r8, 0
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
  __rc_ok:
    x64.movRegReg rcx, rbx
    x64.callDirect __mm_decref
    x64.movRegReg r8, r12
    x64.epilogue 40
    x64.popReg r13
    x64.popReg r12
    x64.popReg rbx
    x64.popReg rbp
    x64.ret
}
